{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cn-language-spec/config/schema.json",
  "title": "cn-language-spec 配置模式（C++风格版v1.0）",
  "description": "验证 cn-language-spec 技能的 default.config.json 配置文件结构",
  "type": "object",
  "required": [
    "specRoot",
    "specVersion",
    "queryTemplates",
    "crossReferenceEnabled",
    "ebnfExtractionEnabled",
    "designDecisionTracing",
    "specDocumentIndex",
    "keywordMapping"
  ],
  "properties": {
    "specRoot": {
      "type": "string",
      "description": "规范文档根目录，相对本配置文件目录",
      "default": "specs/"
    },
    "specVersion": {
      "type": "string",
      "description": "规范版本标识，用于区分Rust风格旧版与C++风格新版",
      "enum": ["C++风格版v1.0"],
      "default": "C++风格版v1.0"
    },
    "queryTemplates": {
      "type": "object",
      "description": "查询输出模板路径",
      "required": ["query", "compare", "summary"],
      "properties": {
        "query": {
          "type": "string",
          "description": "规范查询结果模板路径",
          "default": "./templates/spec-query.md"
        },
        "compare": {
          "type": "string",
          "description": "语法对比报告模板路径",
          "default": "./templates/spec-compare.md"
        },
        "summary": {
          "type": "string",
          "description": "模块摘要模板路径",
          "default": "./templates/spec-summary.md"
        }
      },
      "additionalProperties": false
    },
    "crossReferenceEnabled": {
      "type": "boolean",
      "description": "是否启用跨文档引用链构建",
      "default": true
    },
    "ebnfExtractionEnabled": {
      "type": "boolean",
      "description": "是否启用EBNF定义提取",
      "default": true
    },
    "designDecisionTracing": {
      "type": "boolean",
      "description": "是否启用设计决策追溯",
      "default": true
    },
    "specDocumentIndex": {
      "type": "object",
      "description": "规范文档索引：编号 -> 文件名（相对specRoot）",
      "required": ["01a", "01b", "02", "03", "04", "05", "06", "07", "08"],
      "properties": {
        "01a": { "type": "string", "description": "词法结构-总览与关键字" },
        "01b": { "type": "string", "description": "词法结构-字面量与运算符" },
        "02": { "type": "string", "description": "类型系统" },
        "03": { "type": "string", "description": "语句与控制流" },
        "04": { "type": "string", "description": "函数与函数指针" },
        "05": { "type": "string", "description": "结构体与枚举" },
        "06": { "type": "string", "description": "OOP面向对象" },
        "07": { "type": "string", "description": "错误处理" },
        "08": { "type": "string", "description": "模块系统" }
      },
      "additionalProperties": false
    },
    "keywordMapping": {
      "type": "object",
      "description": "关键词到规范文档编号的映射，用于查询定位",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "enum": ["01a", "01b", "02", "03", "04", "05", "06", "07", "08"],
        "description": "目标文档编号"
      }
    }
  },
  "additionalProperties": false
}
