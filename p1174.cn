类 资源 {
公开:
    整32 号;
    函数 资源(整32 v) { 号 = v; 打印("C", 号, ";"); }
    不安全 函数 ~资源() { 打印("D", 号, ";"); }
}
函数 可能失败(整32 模式) -> 结果<整32, 整32> {
    资源 本 = 资源(模式);
    如果 (模式 == 0) {
        返回 错误(9);
    }
    返回 正常(3);
}
函数 主() -> 整32 {
    结果<整32, 整32> r = 可能失败(0);
    如果 (r.正常) {
        打印(r.值);
    } 否则 {
        打印("E", r.错误);
    }
    返回 0;
}
