// CN 自举编译器 v2：结构化词法器（自举重建 P2，2026-08-25）
// 性能最优架构（对标 rustc/LLVM）第一层：输出结构化 Token 数组，非字符串行。
// 设计：Token {类型码, 文本ID, 行}，文本经 驻留() 得 Symbol ID（O(1) 比较、内容只存一份），
//       单遍字节扫描，标识符/数字/字符串只切一次子串->驻留->ID，零字符串行分配。
导入 容器::向量

公开:

// ==================== Token 类型码（顶层常量） ====================
常量 令牌_文件结束 = 0
常量 令牌_标识符 = 1
常量 令牌_整数字面量 = 2
常量 令牌_浮点字面量 = 3
常量 令牌_字符串字面量 = 4
常量 令牌_字符字面量 = 5
常量 令牌_关键字 = 6
常量 令牌_运算符 = 7
常量 令牌_分隔符 = 8
常量 令牌_未知 = 9

// ==================== 结构化 Token ====================
结构体 Token {
    整32 类型   // 令牌_* 类型码（2026-08-30 复核：宿主整32字段结构体布局/按值传参/向量容器全链路
                //   已验证正确——原 3×整64 是历史规避，现改回标准 4 字节字段）
    整32 文本   // 字符串驻留 ID（Symbol；0=空）
    整32 行     // 源行号
}

// ==================== 字节/追加辅助 ====================
函数 字节值(字符串 源码, 整64 位置) -> 整64 {
    整64 值 = 整64(源码[位置])
    如果 (值 < 0) {
        返回 值 + 256
    }
    返回 值
}
函数 列表追加(向量<Token> 列表, Token 值) -> 空类型 {
    结果<空类型, 整32> 加 = 列表.追加(值)
    如果 (!加.正常) {
        运行时错误(4)
    }
}
函数 整32追加(向量<整32> 列表, 整32 值) -> 空类型 {
    结果<空类型, 整32> 加 = 列表.追加(值)
    如果 (!加.正常) {
        运行时错误(4)
    }
}

// ==================== 字节分类 ====================
// ==================== 类型布局自检（ABI 调试用） ====================
// 类型大小(结构体) 求得该结构体实例字节数（C++ 版 类型大小 内置）
函数 令牌字节大小() -> 整64 {
    返回 类型大小(Token)
}
函数 是数字字节(整64 字节) -> 布尔 {
    返回 字节 >= 48 && 字节 <= 57
}
函数 是字母字节(整64 字节) -> 布尔 {
    如果 (字节 >= 128) { 返回 真 }
    返回 (字节 >= 97 && 字节 <= 122) || (字节 >= 65 && 字节 <= 90) || 字节 == 95
}
函数 是十六进制字节(整64 字节) -> 布尔 {
    返回 是数字字节(字节) || (字节 >= 97 && 字节 <= 102) || (字节 >= 65 && 字节 <= 70)
}

// ==================== 关键字 ID 表（预驻留） ====================
函数 关键字ID表(向量<整32> 表) -> 空类型 {
    整32追加(表, 整32(驻留("如果")))
    整32追加(表, 整32(驻留("否则")))
    整32追加(表, 整32(驻留("当")))
    整32追加(表, 整32(驻留("循环")))
    整32追加(表, 整32(驻留("返回")))
    整32追加(表, 整32(驻留("中断")))
    整32追加(表, 整32(驻留("继续")))
    整32追加(表, 整32(驻留("选择")))
    整32追加(表, 整32(驻留("情况")))
    整32追加(表, 整32(驻留("默认")))
    整32追加(表, 整32(驻留("函数")))
    整32追加(表, 整32(驻留("变量")))
    整32追加(表, 整32(驻留("导入")))
    整32追加(表, 整32(驻留("公开")))
    整32追加(表, 整32(驻留("私有")))
    整32追加(表, 整32(驻留("静态")))
    整32追加(表, 整32(驻留("类")))
    整32追加(表, 整32(驻留("接口")))
    整32追加(表, 整32(驻留("结构体")))
    整32追加(表, 整32(驻留("枚举")))
    整32追加(表, 整32(驻留("联合体")))
    整32追加(表, 整32(驻留("真")))
    整32追加(表, 整32(驻留("假")))
    整32追加(表, 整32(驻留("无")))
    整32追加(表, 整32(驻留("常量")))   // P7a：顶层常量声明（规范 5.2）
}

// 关键字判断：预驻留表线性查（表很小 25 项）
函数 是关键字ID(整32 id, 向量<整32> 表) -> 布尔 {
    整64 i = 0
    当 (i < 表.大小()) {
        如果 (表.元素(i) == id) { 返回 真 }
        i++
    }
    返回 假
}

// ==================== 主扫描：分词 ====================
// 单遍扫描源码 -> 输出 向量<Token>；文本全部驻留为 ID，无字符串行分配
函数 分词(字符串 源码, 向量<Token> 输出) -> 空类型 {
    向量<整32> 关键字表 = 向量<整32>()
    关键字ID表(关键字表)
    整64 位置 = 0
    整64 行号 = 1
    整64 长度 = 字符串长度(源码)
    当 (位置 < 长度) {
        整64 字节 = 字节值(源码, 位置)
        // ---- 空白/换行 ----
        如果 (字节 == 10) { 位置++; 行号++; 继续 }
        如果 (字节 == 32 || 字节 == 9 || 字节 == 13) { 位置++; 继续 }
        // ---- 注释：// 与 /* */ ----
        如果 (字节 == 47 && 位置 + 1 < 长度 && 字节值(源码, 位置 + 1) == 47) {
            位置 += 2
            当 (位置 < 长度 && 字节值(源码, 位置) != 10) { 位置++ }
            继续
        }
        如果 (字节 == 47 && 位置 + 1 < 长度 && 字节值(源码, 位置 + 1) == 42) {
            位置 += 2
            当 (位置 + 1 < 长度 && !(字节值(源码, 位置) == 42 && 字节值(源码, 位置 + 1) == 47)) {
                如果 (字节值(源码, 位置) == 10) { 行号++ }
                位置++
            }
            如果 (位置 + 1 < 长度) { 位置 += 2 }
            继续
        }
        // ---- 字符串字面量 "..." ----
        如果 (字节 == 34) {
            整64 起点 = 位置
            位置++
            布尔 闭合 = 假
            当 (位置 < 长度 && 字节值(源码, 位置) != 10) {
                如果 (字节值(源码, 位置) == 34) { 位置++; 闭合 = 真; 中断 }
                如果 (字节值(源码, 位置) == 92 && 位置 + 1 < 长度) { 位置 += 2; 继续 }
                位置++
            }
            Token tk
            tk.类型 = 整32(令牌_字符串字面量)
            // P7b：剥两端引号（起点+1；长度含闭引号-1；未闭合防御不含）
            整64 内容长 = 位置 - 起点 - 1
            如果 (闭合) { 内容长 = 内容长 - 1 }
            tk.文本 = 整32(驻留(字符串子串(源码, 起点 + 1, 内容长)))
            tk.行 = 整32(行号)
            列表追加(输出, tk)
            继续
        }
        // ---- 字符字面量 ---
        如果 (字节 == 39) {
            整64 起点 = 位置
            位置++
            布尔 闭合 = 假
            当 (位置 < 长度 && 字节值(源码, 位置) != 10) {
                如果 (字节值(源码, 位置) == 39) { 位置++; 闭合 = 真; 中断 }
                如果 (字节值(源码, 位置) == 92 && 位置 + 1 < 长度) { 位置 += 2; 继续 }
                位置++
            }
            Token tk
            tk.类型 = 整32(令牌_字符字面量)
            // P7b：剥两端引号（同字符串字面量）
            整64 内容长c = 位置 - 起点 - 1
            如果 (闭合) { 内容长c = 内容长c - 1 }
            tk.文本 = 整32(驻留(字符串子串(源码, 起点 + 1, 内容长c)))
            tk.行 = 整32(行号)
            列表追加(输出, tk)
            继续
        }
        // ---- 数字字面量 ----
        如果 (是数字字节(字节)) {
            整64 起点 = 位置
            布尔 浮点 = 假
            如果 (字节 == 48 && 位置 + 1 < 长度) {
                整64 次 = 字节值(源码, 位置 + 1)
                如果 (次 == 120 || 次 == 88) { 位置 += 2; 当 (位置 < 长度 && 是十六进制字节(字节值(源码, 位置))) { 位置++ } }
                否则 如果 (次 == 98 || 次 == 66) { 位置 += 2; 当 (位置 < 长度 && (字节值(源码, 位置) == 48 || 字节值(源码, 位置) == 49)) { 位置++ } }
                否则 如果 (次 == 111 || 次 == 79) { 位置 += 2; 当 (位置 < 长度 && 字节值(源码, 位置) >= 48 && 字节值(源码, 位置) <= 55) { 位置++ } }
                否则 { 当 (位置 < 长度 && 是数字字节(字节值(源码, 位置))) { 位置++ } }
            } 否则 {
                当 (位置 < 长度 && 是数字字节(字节值(源码, 位置))) { 位置++ }
            }
            如果 (位置 + 1 < 长度 && 字节值(源码, 位置) == 46 && 是数字字节(字节值(源码, 位置 + 1))) {
                浮点 = 真
                位置 += 2
                当 (位置 < 长度 && 是数字字节(字节值(源码, 位置))) { 位置++ }
            }
            如果 (位置 < 长度 && (字节值(源码, 位置) == 101 || 字节值(源码, 位置) == 69)) {
                浮点 = 真
                位置++
                如果 (位置 < 长度 && (字节值(源码, 位置) == 43 || 字节值(源码, 位置) == 45)) { 位置++ }
                当 (位置 < 长度 && 是数字字节(字节值(源码, 位置))) { 位置++ }
            }
            当 (位置 < 长度) {
                整64 后缀 = 字节值(源码, 位置)
                如果 (后缀 == 76 || 后缀 == 108 || 后缀 == 85 || 后缀 == 117) { 位置++ } 否则 { 中断 }
            }
            Token tk
            tk.类型 = 整32(浮点 ? 令牌_浮点字面量 : 令牌_整数字面量)
            tk.文本 = 整32(驻留(字符串子串(源码, 起点, 位置 - 起点)))
            tk.行 = 整32(行号)
            列表追加(输出, tk)
            继续
        }
        // ---- 标识符 / 关键字 ----
        如果 (是字母字节(字节)) {
            整64 起点 = 位置
            位置++
            当 (位置 < 长度 && (是字母字节(字节值(源码, 位置)) || 是数字字节(字节值(源码, 位置)))) { 位置++ }
            整32 id = 整32(驻留(字符串子串(源码, 起点, 位置 - 起点)))
            Token tk
            tk.类型 = 整32(是关键字ID(id, 关键字表) ? 令牌_关键字 : 令牌_标识符)
            tk.文本 = id
            tk.行 = 整32(行号)
            列表追加(输出, tk)
            继续
        }
        // ---- 运算符/分隔符：最长匹配（P6b 控制流需要多字符运算符） ----
        // 双字符优先：== != <= >= && || ++ += -> ::（都在规范 01b 运算符表）
        // 单字符兜底：+ - * / % < > = ! & | ( ) { } [ ] , . : ;
        // 注释：字符 ':' 单独出现时（如 情况 1:）落单字符 ':'；
        //       '->'/'::' 双字符组合必须在 ':' 单字符判断之前匹配。
        整64 起点 = 位置
        整64 双字符长度 = 0
        如果 (位置 + 1 < 长度) {
            整64 次字节 = 字节值(源码, 位置 + 1)
            如果 (字节 == 61 && 次字节 == 61) { 双字符长度 = 2 }          // ==
            否则 如果 (字节 == 33 && 次字节 == 61) { 双字符长度 = 2 }     // !=
            否则 如果 (字节 == 60 && 次字节 == 61) { 双字符长度 = 2 }     // <=
            否则 如果 (字节 == 62 && 次字节 == 61) { 双字符长度 = 2 }     // >=
            否则 如果 (字节 == 38 && 次字节 == 38) { 双字符长度 = 2 }     // &&
            否则 如果 (字节 == 124 && 次字节 == 124) { 双字符长度 = 2 }   // ||
            否则 如果 (字节 == 43 && 次字节 == 43) { 双字符长度 = 2 }     // ++
            否则 如果 (字节 == 43 && 次字节 == 61) { 双字符长度 = 2 }     // +=
            否则 如果 (字节 == 45 && 次字节 == 62) { 双字符长度 = 2 }     // ->
            否则 如果 (字节 == 58 && 次字节 == 58) { 双字符长度 = 2 }     // ::
        }
        如果 (双字符长度 == 2) {
            位置 += 2
        } 否则 {
            位置++
        }
        Token tk
        tk.类型 = 整32(令牌_运算符)
        tk.文本 = 整32(驻留(字符串子串(源码, 起点, 双字符长度 == 2 ? 2 : 1)))
        tk.行 = 整32(行号)
        列表追加(输出, tk)
    }
    // 文件结束标记
    Token eof
    eof.类型 = 整32(令牌_文件结束)
    eof.文本 = 0
    eof.行 = 整32(行号)
    列表追加(输出, eof)
}