// 语法分析中（357 重构F2 自 语法分析.cn 纯机械搬移·函数体逐字保留·零逻辑变化）

导入 容器::向量;
导入 映射集合;
导入 词法;       // Token 结构（原 词法分析，阶段目录包名，2026-09-08）
导入 IR;         // 容器/结果 合成名判定 + 节点_*/键位移 常量（原 IR容器+IR常量 合并目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 IO;         // 349-a：解析诊断输出（打印到错误）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

函数 解析结构体字段(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表,
                  整64 结构体名ID, 整64 结构体键基, 整64 是联合, 整64 类型节点, 整64 本成员手动, 整64& 字段偏移,
                  整64& 最大对齐, 整64& 最大字段, 整64& 字段序, 整64 已知名ID) -> 整64 {
        如果 (当前类型(记号, 位置) == 令牌_标识符 || 已知名ID != 0) {
            // 040：字段名统一取值——已知名（fnptr 位）或当前 token
            整64 字段名ID480 = 整64(当前ID(记号, 位置));
            如果 (已知名ID != 0) { 字段名ID480 = 已知名ID; }
            整64 字段大小 = 8;
            整64 字段对齐 = 8;
            节点 类型节点值 = 池.元素(整32(类型节点));
            类型大小与对齐(驻留文本(整64(类型节点值.文本)), &字段大小, &字段对齐);
            // 860-a（058 挂账①全局口径·宿主 computeLayout 同构）：类字段=句柄
            //   8/8——字段槽运行时装 NewObject 堆对象指针，实宽布局与内容不
            //   一致（相邻字段覆写句柄高 4 字节·容器字段=指针槽模型同 8/8）。
            //   795 轮缩面（合成体前缀）起·793 销项后推广为全局（结果/可选
            //   合成体行为不变=其超集）。
            如果 (是用户类(驻留文本(整64(类型节点值.文本))) ||
                是容器类(驻留文本(整64(类型节点值.文本)))) {
                字段大小 = 8;
                字段对齐 = 8;
            }
            // T3（311-a=306-b 波次2 v2 侧·2026-09-17）：字段类型为「未登记结构体」
            //   时收集引用对（收尾 检查未登记引用 全量判定）——递归环（直接/间接）
            //   与「先声明后使用」违规唯一同源捕获；原行为=静默 8 字节兜底（无穷
            //   大小类型错值面）。标量/指针/容器/数组 不入收集（合法类型面）。
            整64 字段类型名 = 整64(类型节点值.文本);
            字符串 字段类型判定文本 = 字符串复制(驻留文本(字段类型名));
            // 排除清单=非结构体的合法类型全集：标量族/字符串（拥有型堆句柄·
            //   非标量）/用户类（引用语义·对齐宿主 T3 类豁免）/指针/容器/数组。
            //   指针字段 `甲*` 的类型节点=基名+附加=指针层（仅 字符*/指针数组
            //   并入合成名）——按 附加!=0 排除（指针/引用层均非值字段递归面）。
            如果 (类型节点值.附加 == 0 &&
                 !是标量类型文本(字段类型判定文本) &&
                 !字符串比较(字段类型判定文本, "字符串") &&
                 !是用户类(字段类型判定文本) &&
                 !是指针类型文本(字段类型判定文本) &&
                 !是容器类(字段类型判定文本) && !是数组类型文本(字段类型判定文本) &&
                 !是结果类型(字段类型判定文本) && !是可选类型(字段类型判定文本) &&  // 200
                 !是枚举名(驻留(字段类型判定文本)) &&  // 279 枚举=合法字段类型
                 // 040：函数指针文本（含 [N] 数组位）=指针族合法类型不入收集
                 !(字符串长度(字段类型判定文本) >= 16 &&
                   字符串比较(字符串子串(字段类型判定文本, 0, 13), "函数指针<"))) {
                如果 (查结构体大小(字段类型名) == 0) {
                    收集未登记引用(结构体名ID, 字段类型名);
                }
            }
            // 联合体：所有字段偏移恒 0（不推进不对齐——C 布局；字段偏移表/
            //   登记字段偏移 拿到的即 0，成员访问天然零偏移）
            如果 (是联合 == 0) {
                整64 余 = 字段偏移 % 字段对齐;
                如果 (余 != 0) { 字段偏移 = 字段偏移 + (字段对齐 - 余); }
            }
            // P6e：字段偏移按结构体分桶——键 = 键基ID*键位移+字段名ID，
            //   根治扁平 字段名->偏移 单映射的同名字段串偏移（点.x 与 矩形.x）；
            //   plans/018 键基域（跨模块同名结构体字段偏移独立）
            整64 分桶键 = 结构体键基 * 键位移 + 字段名ID480;
            结果<空类型, 整32> 加表 = 字段偏移表.设置(分桶键, 字段偏移);
            如果 (!加表.正常) { 运行时错误(4); }
            // 164-a：手动释放 标注登记（语义层成员类型限定豁免）
            如果 (本成员手动 == 1) {
                结果<空类型, 整32> 加手动 = 联合体手动标注键们.追加(分桶键);
                如果 (!加手动.正常) { 运行时错误(4); }
            }
            // B4 预置：字段类型登记（资源字段析构注入用；表在 IR容器——避免导入环）
            登记字段类型(分桶键, 字段类型星号规范化(类型节点值)); // 321 星号规范化（435-b 同构·表存真类型——原剥星→指针字段误判「结构体载荷」压地址·链表全断）
            // 217（027 波2a·001 §5.8a）：全字段表旁路登记（三元组：[键基, 字段名ID,
            //   原始类型ID]）——可搬运判定 数据源。布局表存剥星号基名（值语义）·
            //   此处按 指针层(类型节点值.附加) 重建原始星号形态（「空类型*」判定面）
            字符串 原始类型217 = 字符串复制(驻留文本(整64(类型节点值.文本)));
            整64 星层217 = 整64(类型节点值.附加);
            整64 星i217 = 0;
            当 (星i217 < 星层217 && 星层217 <= 255) {
                原始类型217 = 原始类型217 + "*";
                星i217++;
            }
            结果<空类型, 整32> 加217a = 结构体全字段表们.追加(结构体键基);
            如果 (!加217a.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加217b = 结构体全字段表们.追加(字段名ID480);
            如果 (!加217b.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加217c = 结构体全字段表们.追加(驻留(原始类型217));
            如果 (!加217c.正常) { 运行时错误(4); }
            // ②c B：容器字段登记（指针槽模型——RAII 级联析构/字段读 LoadPtr->this/
            //   方法对象类型推导 用；四元组：结构体键基/字段名/字段容器类型/偏移）
            字符串 字段类型文本 = 字符串复制(驻留文本(整64(类型节点值.文本)));
            // 79-a（2026-09-12 第七十九轮）：资源字段表扩容——容器字段（对象指针槽
            //   模型，DeleteObject）之外纳入**字符串字段**（拥有型串句柄，free+清槽）
            //   与含资源字段的嵌套结构体（递归释放）。联合体字段偏移恒 0（同槽多型
            //   激活）不登记（Conditional 释放不可判——宁漏勿错，诚实边界）。
            // 84-c：类别判定——容器(1) / 字符串(0)。
            //   注：**嵌套含资源字段结构体（类别 2）的登记经实测回退**——`资源字段数`
            //   被多处消费（释放分派「否则=容器路径」/局部登记判定「资源字段数-串字段数」），
            //   纳入嵌套结构体后引发回归（E2E 190 等缺 `类型$~类型` 符号）；嵌套结构体
            //   字段的串释放面登记为下一轮专项（诚实边界：泄漏方向，宁漏勿错）。
            整64 资源类别f = 解析资源字段类别(字段类型文本, 类型节点值);
            如果 (是联合 == 0 && 资源类别f >= 0) {
                登记资源字段(结构体键基, 字段名ID480, 整64(类型节点值.文本),
                             字段偏移, 资源类别f == 1, 资源类别f);
            }
            // ②b B5：字段偏移分桶登记（IR 层链式成员 池.元素(i).字段 偏移收口用——
            //   语法层 解析后缀链 对调用对象只能扁平回退，同名字段跨结构体必错）
            登记字段偏移(分桶键, 字段偏移);
            // 构造字面量穷举检查表（2026-09-09，键基域：键基*键位移+序 -> 字段名）
            //   联合体不登记=构造字面量豁免（C 单成员激活惯例，规范 05——
            //   字段数 miss=0 构造路径自然不进入；宿主 visitStructInitExpr 同语义）
            如果 (是联合 == 0) {
                登记构造字段(结构体键基, 字段序, 字段名ID480);
            }
            字段序++;
            如果 (字段对齐 > 最大对齐) { 最大对齐 = 字段对齐; }
            如果 (字段大小 > 最大字段) { 最大字段 = 字段大小; }
            如果 (是联合 == 0) { 字段偏移 = 字段偏移 + 字段大小; }
            池追加(池, 建节点(节点_参数, 整32(字段名ID480), 整64(类型节点), 0, 0));
            // 040：fnptr 位名字已在类型解析内消费（位置不前推）；既有形态推进过名
            如果 (已知名ID == 0) { 位置++; }
        }
    返回 位置;
}

// 205-a：族① 资源字段类别判定（79-a 扩容+84-c 类别：容器(1)/字符串(0)/99-a 字符串
//   数组(0)/100-a 数组元素含资源结构体(2)/84-e 嵌套结构体(2)；-1=非资源；
//   纯判定零副作用——类型节点值 原样传入零改写）。
函数 解析资源字段类别(字符串 字段类型文本, 节点 类型节点值) -> 整64 {
            整64 资源类别f = 0 - 1;
            如果 (是容器类(字段类型文本)) {
                资源类别f = 1;
            } 否则 如果 (字符串比较(字段类型文本, "字符串")) {
                资源类别f = 0;
            } 否则 如果 (是数组类型文本(字段类型文本) &&
                        字符串比较(数组元素文本(字段类型文本), "字符串")) {
                // 99-a（C11, 2026-09-13 第九十九轮）：**字符串数组字段**（
                //    `字符串[3] 名`）——与字符串同类（类别 0；释放点按类型文本
                //    分派逐元素）；97-a 字段数组读写 × 98-a 数组元素释放的合龙
                资源类别f = 0;
            } 否则 如果 (是数组类型文本(字段类型文本) &&
                        查结构体类型(驻留(数组元素文本(字段类型文本))) != 0 &&
                        资源字段数(查结构体类型(
                            驻留(数组元素文本(字段类型文本)))) > 0) {
                // 100-a（C12, 2026-09-13 第一百轮）：**数组元素=含资源字段结构体**
                //   （`行[2] 两行`，行 含字符串字段）——类别 2（嵌套结构体递归；
                //   释放点按类型文本分派逐元素递归其字段）。依赖先声明后使用
                //   （资源字段数 登记于元素结构体声明时）。
                资源类别f = 2;
            } 否则 如果 (查结构体类型(整64(类型节点值.文本)) != 0) {
                // 84-e：嵌套含资源字段结构体（类别 2）——释放递归/拷贝深拷 的分派依据；
                //   84-c 曾因「资源字段数 消费点未梳理」回退，本轮已逐点核对（生成声明
                //   局部登记判定 / 释放三处递归 / 可顺序释放判定）后重新收口。
                资源类别f = 2;
            }
    返回 资源类别f;
}



// plans/018 P6b：模块 声明挂载清单（模块 X; 的 X 名 ID，去重）——
//   扫描导入（预解析）与 解析程序（权威）双点登记；主.cn 加载器消费，
//   据此递归加载子模块（父挂子自动加载强语义，规范 08-二）
静态 向量<整32> 模块声明们;

// 登记模块声明名（去重幂等）
函数 模块声明登记(整32 名ID) -> 空类型 {
    整64 i = 0;
    当 (i < 模块声明们.大小()) {
        如果 (模块声明们.元素(i) == 名ID) { 返回; }
        i++;
    }
    结果<空类型, 整32> 加 = 模块声明们.追加(名ID);
    如果 (!加.正常) { 运行时错误(4); }
}

// 取走模块声明清单（消费后清空；主.cn 加载器在 扫描导入 后调用）
不安全 函数 取走模块声明们() -> 向量<整32> {
    向量<整32> 列表 = 模块声明们;
    模块声明们 = 向量<整32>();
    返回 列表;
}




// 登记导入模块名（去重；扫描导入 与 解析程序 顶层 均调用，幂等）
函数 模块登记(整32 模块名ID) -> 空类型 {
    整64 i = 0;
    当 (i < 导入模块们.大小()) {
        如果 (导入模块们.元素(i) == 模块名ID) { 返回; }
        i++;
    }
    结果<空类型, 整32> 加 = 导入模块们.追加(模块名ID);
    如果 (!加.正常) { 运行时错误(4); }
}

// ==================== 1011（46_module_tree·再导出转发登记） ====================
// 宿主 v2.0 决策7：`公开 导入 网络::传输控制::连接;`（公开: 标签下的导入）把
//   子模块公开符号提升为当前模块 API（网络::连接）。语法层在 解析程序 顶层
//   遇「公开标签下的 导入 语句」时登记转发表：键=模块成员键(本模块,尾段)·
//   值=源完整限定名 ID（全局静态跨文件累积——键含本模块路径天然隔离不清空）。
//   语义层 构建文件导入上下文 查成员 miss 时查此表，命中源实体则把
//   [本模块,尾段]=源键基+公开 提升登记进模块成员索引（后续导入/限定调用
//   两类查询自然命中·零逐点兜底）。
静态 映射<整64, 整64> 再导出转发们1011;

函数 登记再导出转发(整64 本模块ID, 整32 尾段ID, 整64 源限定名ID) -> 空类型 {
    结果<空类型, 整32> 设 = 再导出转发们1011.设置(
        模块成员键(本模块ID, 整64(尾段ID)), 源限定名ID);
    如果 (!设.正常) { 运行时错误(4); }
}

// 扫描一条 导入 语句的再导出登记（位置=「导入」关键字上·只读不推进）：
//   段贪婪收集 标识符(::标识符)* 全串=路径；尾段=符号（:: 后 { 逐项展开）。
//   通配 ::* 不转发（与导入登记同语义）。
函数 扫描公开导入再导出(向量<Token> 记号, 整64 位置) -> 空类型 {
    整64 p1011 = 位置 + 1;
    如果 (!(p1011 < 记号.大小() && 当前类型(记号, p1011) == 令牌_标识符)) { 返回; }
    字符串 路径全名 = 字符串复制(当前文本(记号, p1011));
    整32 尾段ID = 当前ID(记号, p1011);
    p1011++;
    当 (p1011 + 1 < 记号.大小() && 当前类型(记号, p1011) == 令牌_运算符 &&
         当前ID(记号, p1011) == 整32(驻留("::")) &&
         当前类型(记号, p1011 + 1) == 令牌_标识符) {
        路径全名 = 路径全名 + "::" + 当前文本(记号, p1011 + 1);
        尾段ID = 当前ID(记号, p1011 + 1);
        p1011 += 2;
    }
    整64 本模块ID1011 = 驻留(取当前模块路径());
    如果 (p1011 < 记号.大小() && 当前类型(记号, p1011) == 令牌_运算符 &&
         当前ID(记号, p1011) == 整32(驻留("::"))) {
        p1011++;
        如果 (p1011 < 记号.大小() && 当前类型(记号, p1011) == 令牌_运算符 &&
             当前ID(记号, p1011) == 整32(驻留("{"))) {
            p1011++;
            当 (p1011 < 记号.大小() &&
                 !(当前类型(记号, p1011) == 令牌_运算符 && 当前ID(记号, p1011) == 整32(驻留("}")))) {
                如果 (当前类型(记号, p1011) == 令牌_标识符) {
                    登记再导出转发(本模块ID1011, 当前ID(记号, p1011),
                                    驻留(路径全名 + "::" + 当前文本(记号, p1011)));
                    p1011++;
                    如果 (p1011 + 1 < 记号.大小() && 是词(记号, p1011, "作为")) { p1011 += 2; }
                    继续;
                }
                p1011++;
            }
        }
        // ::* 通配=不转发
    } 否则 {
        登记再导出转发(本模块ID1011, 尾段ID, 驻留(路径全名));
    }
}

// 取走本文件导入模块列表（消费后清空；主.cn 每解析完一个文件调用，
//   据此递归加载模块文件——依赖模块须先解析，结构体偏移推导才正确）
不安全 函数 取走导入模块们() -> 向量<整32> {
    向量<整32> 模块列表 = 导入模块们;
    导入模块们 = 向量<整32>();
    返回 模块列表;
}

// 簇②根治·B1：登记导入项们（项名 -> 限定名；路径::项 / ::{项列表} / 项 作为 别名
//   三形态；通配 * 不登记——见 导入项们 边界注释）。不清空（调用方负责）。
//   时序纪律：登记必须紧贴本文件 解析程序——加载器「依赖先解析」会穿插其他文件
//   的扫描+解析，若在 扫描导入 清空+登记，本文件项会被依赖文件的登记窗口抹掉
//   （IR签名 登记 打开文件 → 词法分析 递归清空 → 回到 IR签名 解析时已丢——
//   实测 4 错残留即此）。故 解析程序 入口 清空+重扫 为权威登记点。
函数 登记导入项们(向量<Token> 记号) -> 空类型 {
    整64 位置 = 0;
    当 (位置 < 记号.大小()) {
        如果 (当前类型(记号, 位置) == 令牌_关键字 && 当前ID(记号, 位置) == 整32(驻留("导入"))) {
            位置++;
            如果 (!(位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_标识符)) { 位置++; 继续; }
            // 1011（46_module_tree·多段导入路径）：段贪婪收集 标识符(::标识符)*
            //   ——完整串=限定名（语义层 拆限定名 尾段绑定拆「模块+符号」：
            //   网络::传输控制::发送 → 模块 网络::传输控制 + 符号 发送·宿主
            //   parseModulePath 全吞+尾段符号同构）。收集停止于 :: 后非标识符
            //   （{ / * / 作为 / ;——花括号/通配/别名/无尾四种形态）。原实现
            //   限定名=首段+::+次段——三段路径的尾符号被吞（导入 网络::传输
            //   控制::发送 登记成 网络::传输控制·绑定=传输控制=错位）。
            字符串 路径全名1011 = 字符串复制(当前文本(记号, 位置));
            整32 尾段ID1011 = 当前ID(记号, 位置);
            位置++;
            当 (位置 + 1 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == 整32(驻留("::")) &&
                 当前类型(记号, 位置 + 1) == 令牌_标识符) {
                路径全名1011 = 路径全名1011 + "::" + 当前文本(记号, 位置 + 1);
                尾段ID1011 = 当前ID(记号, 位置 + 1);
                位置 += 2;
            }
            字符串 模块名 = 路径全名1011;
            如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == 整32(驻留("::"))) {
                位置++;
                如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留("{"))) {
                    // 导入 路径::{项, 项}：逐项登记（限定名=路径+::+项名）
                    位置++;
                    当 (位置 < 记号.大小() &&
                         !(当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("}")))) {
                        如果 (当前类型(记号, 位置) == 令牌_标识符) {
                            字符串 限定名 = 模块名 + "::" + 当前文本(记号, 位置);
                            导入项登记(整64(当前ID(记号, 位置)), 驻留(限定名));
                            位置++;
                            // 项 作为 别名：别名也登记同限定名（P6b：作为 升格
                            //   关键字，判定走 是关键——原标识符类型判定失配）
                            如果 (位置 + 1 < 记号.大小() && 是词(记号, 位置, "作为")) {
                                位置++;
                                如果 (当前类型(记号, 位置) == 令牌_标识符) {
                                    导入项登记(整64(当前ID(记号, 位置)), 驻留(限定名));
                                    位置++;
                                }
                            }
                            继续;
                        }
                        位置++;
                    }
                } 否则 如果 (位置 < 记号.大小() &&
                           当前类型(记号, 位置) == 令牌_运算符 &&
                           当前ID(记号, 位置) == 整32(驻留("*"))) {
                    // 导入 路径::*：通配跳过（现状维持）
                    位置++;
                }
            } 否则 {
                // 尾段=导入符号（导入 路径::符号 形态——路径全串含符号段·
                //   绑定=末段 ID）。两段形态与原行为逐字节等价（模块名+::+符号）。
                导入项登记(整64(尾段ID1011), 驻留(路径全名1011));
                位置++;
                // 符号 作为 别名（P6b：作为 升格关键字，走 是关键）
                如果 (位置 + 1 < 记号.大小() && 是词(记号, 位置, "作为")) {
                    位置++;
                    如果 (当前类型(记号, 位置) == 令牌_标识符) {
                        导入项登记(整64(当前ID(记号, 位置)), 驻留(路径全名1011));
                        位置++;
                    }
                }
            }
            继续;
        }
        位置++;
    }
}

// P6h：轻量预扫描 Token 流中的 导入 语句（登记模块名，供加载器在解析前
//   得知依赖）。规范（08 模块系统）：导入 路径 [作为 标识符] / 导入 路径::{项}
//   / 导入 路径::*——路径首段为模块名（容器/文件/词法分析…），std 模块跳过加载。
//   簇②根治·B1：项登记在此顺带执行（幂等），但**权威登记点在 解析程序 入口**
//   （清空+重扫）——见 登记导入项们 时序纪律注释。
