        整64 头数v = 0;
        结果<整64, 整32> 查头插形态 = lambda捕获形态们.获取(名ID);
        如果 (查头插形态.正常) {   // 0/1/2/3 头插（计数 0 自然空转）
            结果<整64, 整32> 查头起 = lambda捕获起们.获取(名ID);
            结果<整64, 整32> 查头数 = lambda捕获计数们.获取(名ID);
            // 结果纪律：.值 只能肯定分支访问（补解析段首同款嵌套守卫）
            整64 头起v = 0;
            如果 (查头起.正常) {
                如果 (查头数.正常) {
                    头起v = 查头起.值;
                    头数v = 查头数.值;
                }
                否则 {
                }
            }
            否则 {
            }
            整64 头i = 头起v;
            当 (头i < 头起v + 头数v) {
                池追加(池, 建节点(节点_参数, 整32(lambda捕获名序们.元素(整32(头i))), 0, 0, 0));
                头i++;
            }
        }
        整64 参数起点 = 池.大小() - 头数v;
        如果 (当前类型(记号, p) == 令牌_运算符 &&
             当前ID(记号, p) == 整32(驻留("("))) {
            p++;
            如果 (!(当前类型(记号, p) == 令牌_运算符 &&
                   当前ID(记号, p) == 整32(驻留(")")))) {
                当 (真) {
                    p = 解析参数(记号, p, 池);
                    如果 (当前类型(记号, p) == 令牌_运算符 &&
                         当前ID(记号, p) == 整32(驻留(","))) { p++; 继续; }
                    中断;
                }
            }
            如果 (当前类型(记号, p) == 令牌_运算符 &&
                 当前ID(记号, p) == 整32(驻留(")"))) { p++; }
            否则 {
                // 1031（lambda 参数表收口）：')' 缺失——原实现连 EOF 拦截都无
                //   （`[](整32 x -> 整32 {` 被后续当 0 参 lambda 放行·L1/L2
                //   实录·宿主「预期 ')'」拒绝）。参数表可缺（`[]{ }` 双侧合法·
                //   X1 对照），仅在 '(' 已消费时收口。
                参数表收口诊断(记号, p, "lambda 参数表");
            }
        }
        // 返回类型（'->' 单 token·* 后缀并入）
        整64 返回类型ID = 0;
        如果 (当前类型(记号, p) == 令牌_运算符 &&
             当前ID(记号, p) == 整32(驻留("->"))) {
            p++;
            返回类型ID = 当前ID(记号, p);
