        如果 (查重放形态.正常) { 重放形态 = 查重放形态.值; } 否则 { }
        // #276 波2：形态3=[&] 放行——名单收集同 [=]（体标识符 token 级·语义层
        {
            如果 (重放形态 == 0 || 重放形态 == 1 || 重放形态 == 2 || 重放形态 == 3) {
                如果 (重放形态 == 0 || 重放形态 == 1 || 重放形态 == 3) {   // 0=[] 隐式·1=[=]·3=[&] 同收集（宿主语义：[] 隐式值捕获·[&] 全引用捕获）
                    // [=] 名单=体标识符 token 级收集（语法层无符号表·语义层按
                    //   变量符号过滤校验·宿主 collectLambdaCaptures 文本近似）：
                    //   排除集=参数区标识符（文本级预扫·类型名/默认值误入只影响
                    //   极端遮蔽场景=快照多份·语义等价）。
                    结果<空类型, 整32> 登起 = lambda捕获起们.设置(名ID, 整64(lambda捕获名序们.大小()));
                    如果 (!登起.正常) { 运行时错误(4); }
                    向量<整64> 排除集;
                    整64 预q = p;
                    当 (预q < 段止 &&
                        !(当前类型(记号, 预q) == 令牌_运算符 &&
                          当前ID(记号, 预q) == 整32(驻留("{")))) {
                        如果 (当前类型(记号, 预q) == 令牌_标识符) {
                            结果<空类型, 整32> 排 = 排除集.追加(整64(当前ID(记号, 预q)));
                            如果 (!排.正常) { 运行时错误(4); }
                        }
                        预q++;
                    }
                    整64 体q = 预q;
                    如果 (体q < 段止) { 体q++; }   // 消费 '{'
                    // #439：体内声明名预扫（两遍扫第一遍）——`整64 大 = …`/
                    //   `变量 x = …` 的声明名是体内局部变量非外层捕获项（宿主
                    //   collectLambdaCaptures 在 pushScope **前**调用·lookupVar
                    //   只命中外层已声明变量=体内变量声明位与引用位全不收）；
                    //   token 级近似=先收体内声明位名集，第二遍收集捕获时声明名
                    //   连同引用位全豁（`打印行(大)` 的 大 同豁）。极端遮蔽（体内
                    //   声明同名外层变量）=宿主快照多份·语义等价（428 同哲学）。
                    //   用户类名声明位（`触发者 对象`）=462 面勿扩线。
                    向量<整64> 体内声明名集;
                    整64 声明q = 体q;
                    当 (声明q < 段止) {
                        如果 (当前类型(记号, 声明q) == 令牌_标识符 && 声明q > 0) {
                            整64 是声明位 = 0;
                            如果 (当前类型(记号, 声明q - 1) == 令牌_关键字 &&
                                 当前ID(记号, 声明q - 1) == 整32(驻留("变量"))) {
                                是声明位 = 1;
                            } 否则 如果 (当前类型(记号, 声明q - 1) == 令牌_标识符 &&
                                 是lambda转换类型名(整64(当前ID(记号, 声明q - 1)))) {
                                是声明位 = 1;
                            }
                            如果 (是声明位 == 1) {
                                整64 声明名 = 整64(当前ID(记号, 声明q));
                                整64 已有 = 0;
                                整64 寻i = 0;
                                当 (寻i < 体内声明名集.大小()) {
