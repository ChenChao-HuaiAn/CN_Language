// 解析表达式尾（357 重构F2 自 解析表达式.cn 纯机械搬移·函数体逐字保留·零逻辑变化）

导入 容器::向量;
导入 映射集合;
导入 词法;       // Token 结构（原 导入 词法分析，目录包名）
导入 IR;         // 节点_*/键位移 常量（原 IR容器+IR常量 合并目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

函数 是泛型声明(向量<Token> 记号, 整64 位置) -> 布尔 {
    如果 (当前类型(记号, 位置) != 令牌_标识符) { 返回 假; }
    如果 (位置 + 1 >= 记号.大小()) { 返回 假; }
    可选<整64> 闭合查 = 泛型闭合位置(记号, 位置 + 1);
    如果 (!闭合查.有值) { 返回 假; }
    整64 闭合 = 闭合查.值;
    如果 (当前类型(记号, 闭合 + 1) == 令牌_标识符) { 返回 真; }
    // 884-a（070·G-N·537 前置）：**泛型实例 + 数组后缀**（`结果<整32, 整32>[2] 组;`
    //   ——合成体数组声明·537 A 段实锤 parse 缺口）——闭合后 `[` 数字 `]`（可多层）
    整64 闭合探884 = 闭合 + 1;
    当 (闭合探884 + 2 < 记号.大小() &&
         当前类型(记号, 闭合探884) == 令牌_运算符 &&
         当前ID(记号, 闭合探884) == 整32(驻留("[")) &&
         当前类型(记号, 闭合探884 + 1) == 令牌_整数字面量 &&
         当前类型(记号, 闭合探884 + 2) == 令牌_运算符 &&
         当前ID(记号, 闭合探884 + 2) == 整32(驻留("]"))) {
        闭合探884 = 闭合探884 + 3;
    }
    如果 (当前类型(记号, 闭合探884) == 令牌_标识符) { 返回 真; }
    // 1175（泛型实例指针三形态·根因 a）：泛型实例**指针后缀**——
    //   `节点<整32>* p` / `节点<整32>** pp`（星在闭合之后）。原判定闭合后只认
    //   标识符/数组后缀/'&' → `>` 后接 `*` 不匹配 → 声明落表达式路径 → 语义层
    //   报「未声明标识符 p」（g02c 实录；宿主 parser 同形态放行=零分叉缺口）。
    //   与 639 多星指针前瞻同口径：连续 '*' 后须标识符=变量名。
    整64 星探1175 = 闭合探884;
    当 (星探1175 < 记号.大小() &&
         当前类型(记号, 星探1175) == 令牌_运算符 &&
         当前ID(记号, 星探1175) == 整32(驻留("*"))) {
        星探1175++;
    }
    如果 (星探1175 > 闭合探884 &&
         星探1175 < 记号.大小() &&
         当前类型(记号, 星探1175) == 令牌_标识符) { 返回 真; }
    // 泛型引用声明：闭合后 '&' 且其后是标识符=变量名（解析类型 消费 '&' 置
    //   引用标记 附加=256）
    返回 当前类型(记号, 闭合探884) == 令牌_运算符 &&
           当前ID(记号, 闭合探884) == 整32(驻留("&")) &&
           闭合探884 + 1 < 记号.大小() &&
           当前类型(记号, 闭合探884 + 1) == 令牌_标识符;
}

// 031（#1075）：方法值类型声明前瞻——`方法值<类名, 返回类型(参数表)> 名`。
//   泛型闭合位置白名单不含签名段括号（遇到 '(' 即 -1）→ 方法值形态在
//   通用泛型声明前瞻落空；本专用扫描：括号平衡跳过签名段、尖括号深度定位
//   闭合，闭合后须为标识符（变量名）。宿主 parser_type.cpp methodValueDeclAhead
//   同一职责（宿主侧为独立探测·通用 isTemplateAngleOpen 不放宽防表达式误判）。
函数 是方法值声明前瞻1075(向量<Token> 记号, 整64 位置) -> 布尔 {
    如果 (当前类型(记号, 位置) != 令牌_标识符) { 返回 假; }
    如果 (!字符串比较(驻留文本(整64(当前ID(记号, 位置))), "方法值")) { 返回 假; }
    如果 (位置 + 1 >= 记号.大小()) { 返回 假; }
    如果 (!(当前类型(记号, 位置 + 1) == 令牌_运算符 &&
           当前ID(记号, 位置 + 1) == 整32(驻留("<")))) { 返回 假; }
    整64 深度 = 0;
    整64 括深 = 0;
    整64 i = 位置 + 1;
    当 (i < 记号.大小()) {
        整32 t = 当前类型(记号, i);
        整64 id = 整64(当前ID(记号, i));
        如果 (t == 令牌_运算符 && id == 整64(驻留("("))) { 括深++; i++; 继续; }
        如果 (t == 令牌_运算符 && id == 整64(驻留(")"))) {
            如果 (括深 > 0) { 括深--; }
            i++;
            继续;
        }
        如果 (括深 > 0) { i++; 继续; }   // 签名参数表内容（类型名/逗号/嵌套括号）
        如果 (t == 令牌_运算符 && id == 整64(驻留("<"))) { 深度++; i++; 继续; }
        如果 (t == 令牌_运算符 && id == 整64(驻留(">"))) {
            深度--;
            如果 (深度 <= 0) {
                返回 (i + 1 < 记号.大小() && 当前类型(记号, i + 1) == 令牌_标识符);
            }
            i++;
            继续;
        }
        如果 (t == 令牌_运算符 && id == 整64(驻留(">>"))) {
            深度 = 深度 - 2;
                        如果 (深度 <= 0) {
                返回 (i + 1 < 记号.大小() && 当前类型(记号, i + 1) == 令牌_标识符);
            }
            i++;
            继续;
        }
        如果 (t == 令牌_标识符) { i++; 继续; }
        如果 (t == 令牌_运算符 &&
            (id == 整64(驻留(",")) || id == 整64(驻留("*")) || id == 整64(驻留("&")))) {
            i++;
            继续;
        }
        返回 假;
    }
    返回 假;
}

// 是构造调用（P7b）：标识符 <类型实参> ( —— 如 向量<整64>()。
//   闭合后是 '(' 才认定（防 比较/移位误判）。
函数 是构造调用(向量<Token> 记号, 整64 位置) -> 布尔 {
    如果 (当前类型(记号, 位置) != 令牌_标识符) { 返回 假; }
    如果 (位置 + 1 >= 记号.大小()) { 返回 假; }
    可选<整64> 闭合查 = 泛型闭合位置(记号, 位置 + 1);
    如果 (!闭合查.有值) { 返回 假; }
    整64 闭合 = 闭合查.值;
    如果 (闭合 + 1 >= 记号.大小()) { 返回 假; }
    返回 当前类型(记号, 闭合 + 1) == 令牌_运算符 &&
           当前ID(记号, 闭合 + 1) == 整32(驻留("("));
}

// 解析类型：类型前置，支持 类型* 指针（P6c）/ 泛型实参（P7b）/ & 引用（P7b 登记）
// 节点_类型：文本=$合成类型名ID（向量$整64）或裸名ID；附加=指针层数 + 引用*256
函数 解析类型(向量<Token> 记号, 整64 位置, 向量<节点> 池) -> 整64 {
    // 402-a（D43/D45 破案）：入口兼容别名关键字（整数/小数）——词法关键字化后
    //   别名 token=令牌_关键字，原入口只认 令牌_标识符→别名类型声明不追加节点
    如果 (!(当前类型(记号, 位置) == 令牌_标识符 ||
           是别名关键字(记号, 位置))) {
        返回 位置;
    }
    {
        整64 类型位置 = 位置;
        字符串 合成名 = 解析类型文本(记号, &类型位置, 假);
        如果 (字符串长度(合成名) == 0) { 返回 位置; }
        位置 = 类型位置;
        整32 类型名ID = 整32(驻留(合成名));
        整64 指针层 = 0;
        整64 引用 = 0;
        当 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("*"))) {
            指针层++;
            位置++;
        }
        // 101-a（C1, 2026-09-13 第一百零一轮）：**字符* 借用视图类型化**——
        //   `字符*`（基类型 字符 + 单个 *）是**借用视图类型**（A2 已裁决语义：
        如果 (指针层 > 0 &&
            位置 + 2 < 记号.大小() &&
            当前类型(记号, 位置) == 令牌_运算符 &&
            当前ID(记号, 位置) == 整32(驻留("[")) &&
            当前类型(记号, 位置 + 1) == 令牌_整数字面量 &&
            当前类型(记号, 位置 + 2) == 令牌_运算符 &&
            当前ID(记号, 位置 + 2) == 整32(驻留("]"))) {
            字符串 指针后缀101 = "";
            整64 pz101 = 0;
            当 (pz101 < 指针层) {
                指针后缀101 = 指针后缀101 + "*";
                pz101++;
            }
            合成名 = 合成名 + 指针后缀101 + "[" +
                     驻留文本(整64(当前ID(记号, 位置 + 1))) + "]";
            类型名ID = 整32(驻留(合成名));
            指针层 = 0;
            位置 = 位置 + 3;
        }
        如果 (指针层 == 1 && 字符串比较(合成名, "字符") && 引用 == 0) {
            类型名ID = 整32(驻留("字符*"));
            指针层 = 0;
        }
        如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("&"))) {
            引用 = 1;
            位置++;
        }
        池追加(池, 建节点(节点_类型, 类型名ID, 指针层 + 引用 * 256, 0, 0));
        返回 位置;
    }
    返回 位置;
}

// T69（480-a 深度机）：函数指针声明形态前瞻——`返回类型(*名字)(参数类型列表)`。
//   规范 02 §139 / 04 章（宿主 parser.cpp parseFuncPtrType 同构）。纯读零副作用；
函数 是函数指针声明(向量<Token> 记号, 整64 位置) -> 布尔 {
    如果 (!是声明类型起始(记号, 位置)) { 返回 假; }
    如果 (位置 + 5 >= 记号.大小()) { 返回 假; }
    如果 (!(当前类型(记号, 位置 + 1) == 令牌_运算符 &&
           当前ID(记号, 位置 + 1) == 整32(驻留("(")))) { 返回 假; }
    如果 (!(当前类型(记号, 位置 + 2) == 令牌_运算符 &&
           当前ID(记号, 位置 + 2) == 整32(驻留("*")))) { 返回 假; }
    如果 (当前类型(记号, 位置 + 3) != 令牌_标识符) { 返回 假; }
    如果 (!(当前类型(记号, 位置 + 4) == 令牌_运算符 &&
           当前ID(记号, 位置 + 4) == 整32(驻留(")")))) { 返回 假; }
    返回 (当前类型(记号, 位置 + 5) == 令牌_运算符 &&
            当前ID(记号, 位置 + 5) == 整32(驻留("(")));
}

// 040（2026-10-05 甲案·001 §5.8）：数组元素位形态 `类型 ( * 名 [ N ] ) (`
//   （回调表·纯读零消费——宿主 funcPtrDeclAhead(allowArray) 同构）
函数 是函数指针声明数组(向量<Token> 记号, 整64 位置) -> 布尔 {
    如果 (!是声明类型起始(记号, 位置)) { 返回 假; }
    如果 (位置 + 8 >= 记号.大小()) { 返回 假; }
    如果 (!(当前类型(记号, 位置 + 1) == 令牌_运算符 &&
           当前ID(记号, 位置 + 1) == 整32(驻留("(")))) { 返回 假; }
    如果 (!(当前类型(记号, 位置 + 2) == 令牌_运算符 &&
           当前ID(记号, 位置 + 2) == 整32(驻留("*")))) { 返回 假; }
    如果 (当前类型(记号, 位置 + 3) != 令牌_标识符) { 返回 假; }
    如果 (!(当前类型(记号, 位置 + 4) == 令牌_运算符 &&
           当前ID(记号, 位置 + 4) == 整32(驻留("[")))) { 返回 假; }
    如果 (当前类型(记号, 位置 + 5) != 令牌_整数字面量) { 返回 假; }
    如果 (!(当前类型(记号, 位置 + 6) == 令牌_运算符 &&
           当前ID(记号, 位置 + 6) == 整32(驻留("]")))) { 返回 假; }
    如果 (!(当前类型(记号, 位置 + 7) == 令牌_运算符 &&
           当前ID(记号, 位置 + 7) == 整32(驻留(")")))) { 返回 假; }
    返回 (当前类型(记号, 位置 + 8) == 令牌_运算符 &&
            当前ID(记号, 位置 + 8) == 整32(驻留("(")));
}

// 040 甲案：匿名形态 `类型 ( * ) (`（返回类型位 `-> 整32(*)(整32)`·纯读零消费）
函数 是函数指针返回匿名(向量<Token> 记号, 整64 位置) -> 布尔 {
    如果 (!是声明类型起始(记号, 位置)) { 返回 假; }
    如果 (位置 + 4 >= 记号.大小()) { 返回 假; }
    如果 (!(当前类型(记号, 位置 + 1) == 令牌_运算符 &&
           当前ID(记号, 位置 + 1) == 整32(驻留("(")))) { 返回 假; }
    如果 (!(当前类型(记号, 位置 + 2) == 令牌_运算符 &&
           当前ID(记号, 位置 + 2) == 整32(驻留("*")))) { 返回 假; }
    如果 (!(当前类型(记号, 位置 + 3) == 令牌_运算符 &&
           当前ID(记号, 位置 + 3) == 整32(驻留(")")))) { 返回 假; }
    返回 (当前类型(记号, 位置 + 4) == 令牌_运算符 &&
            当前ID(记号, 位置 + 4) == 整32(驻留("(")));
}

// T69（480-a 深度机）：函数指针类型节点解析——位置[0] 入=形态起点（返回类型
//   起始 token），出=参数表右 ')' 之后；名字出参=`(*名字)` 内的声明名 ID（供
不安全 函数 解析函数指针类型节点(向量<Token> 记号, 整64* 位置, 向量<节点> 池,
                     整32* 名字出参) -> 整64 {
    整64 起始 = 位置[0];
    字符串 返回文本 = 解析类型文本(记号, 位置, 真);
    如果 (字符串长度(返回文本) == 0) { 位置[0] = 起始; 返回 0 - 1; }
    名字出参[0] = 0;
    // 040 顺序消费：'(' '*' [名] [ [ N ] ] ')' '('——名/数组长度均可选
    //   （三形态：命名标量/命名数组/匿名；长度错置=回退交既有诊断链）
    如果 (!(当前类型(记号, 位置[0]) == 令牌_运算符 &&
           当前ID(记号, 位置[0]) == 整32(驻留("(")) &&
           位置[0] + 1 < 记号.大小() &&
           当前类型(记号, 位置[0] + 1) == 令牌_运算符 &&
           当前ID(记号, 位置[0] + 1) == 整32(驻留("*")))) {
        位置[0] = 起始;
        返回 0 - 1;
    }
    位置[0] = 位置[0] + 2;   // 吃 '(' '*'
    如果 (当前类型(记号, 位置[0]) == 令牌_标识符) {
        名字出参[0] = 当前ID(记号, 位置[0]);
        位置[0] = 位置[0] + 1;
    }
    字符串 数组后缀fp480 = "";
    如果 (位置[0] + 2 < 记号.大小() &&
         当前类型(记号, 位置[0]) == 令牌_运算符 &&
         当前ID(记号, 位置[0]) == 整32(驻留("[")) &&
         当前类型(记号, 位置[0] + 1) == 令牌_整数字面量 &&
         当前类型(记号, 位置[0] + 2) == 令牌_运算符 &&
         当前ID(记号, 位置[0] + 2) == 整32(驻留("]"))) {
        数组后缀fp480 = "[" + 字符串复制(驻留文本(当前ID(记号, 位置[0] + 1))) + "]";
        位置[0] = 位置[0] + 3;
    }
    如果 (!(当前类型(记号, 位置[0]) == 令牌_运算符 &&
           当前ID(记号, 位置[0]) == 整32(驻留(")")) &&
           位置[0] + 1 < 记号.大小() &&
           当前类型(记号, 位置[0] + 1) == 令牌_运算符 &&
           当前ID(记号, 位置[0] + 1) == 整32(驻留("(")))) {
        位置[0] = 起始;
        返回 0 - 1;
    }
    位置[0] = 位置[0] + 2;   // 吃 ')' '('
    字符串 参数文本 = "";
    布尔 首参 = 真;
    布尔 完成 = 假;
    当 (位置[0] < 记号.大小()) {
        如果 (当前类型(记号, 位置[0]) == 令牌_运算符 &&
             当前ID(记号, 位置[0]) == 整32(驻留(")"))) {
            位置[0] = 位置[0] + 1;
            完成 = 真;
            中断;
        }
        字符串 参文本 = 解析类型文本(记号, 位置, 真);
        如果 (字符串长度(参文本) == 0) { 中断; }
        如果 (!首参) { 参数文本 = 参数文本 + ","; }
        参数文本 = 参数文本 + 参文本;
        首参 = 假;
        如果 (当前类型(记号, 位置[0]) == 令牌_运算符 &&
             当前ID(记号, 位置[0]) == 整32(驻留(","))) {
            位置[0] = 位置[0] + 1;
        }
    }
    如果 (!完成) { 位置[0] = 起始; 返回 0 - 1; }
    字符串 合成fp = "函数指针<" + 返回文本 + ">(" + 参数文本 + ")" + 数组后缀fp480;
    整64 下标fp = 池.大小();
    池追加(池, 建节点(节点_类型, 整32(驻留(合成fp)), 0, 0, 0));
    返回 下标fp;
}

// 1031 拆分（先拆再加·解析参数 原 121 行超百行红线）：函数指针形参 439-a 尾形态
//   `返回类型(*名)(参数类型列表)`（自 解析参数 纯机械搬移·逐字保留）。
//   返回 真=形态命中并已消费（调用方直接返回 位置[0]）；假=未命中（续走原路径）。
不安全 函数 解析参数函数指针尾439(向量<Token> 记号, 整64* 位置, 向量<节点> 池,
                          整64 类型节点) -> 布尔 {
    如果 (!(位置[0] + 2 < 记号.大小() &&
          当前类型(记号, 位置[0]) == 令牌_运算符 &&
          当前ID(记号, 位置[0]) == 整32(驻留("(")) &&
          当前类型(记号, 位置[0] + 1) == 令牌_运算符 &&
          当前ID(记号, 位置[0] + 1) == 整32(驻留("*")) &&
          当前类型(记号, 位置[0] + 2) == 令牌_标识符)) {
        返回 假;
    }
    节点 返回类型节点439 = 池.元素(整32(类型节点));
    字符串 合成439 = 字符串复制(驻留文本(整64(返回类型节点439.文本)));
    合成439 = 合成439 + "(*";
    位置[0] = 位置[0] + 2;
    整32 名ID439 = 当前ID(记号, 位置[0]);
    位置[0]++;
    合成439 = 合成439 + ")(";
    // 439-a：(*名) 的闭括号 `)` 消费（token 序：返回 ( * 名 ) ( 参数… )——
    //   此括号缺失曾致后续 `(` 消费判定错位·解析整体错乱）
    如果 (当前类型(记号, 位置[0]) == 令牌_运算符 &&
         当前ID(记号, 位置[0]) == 整32(驻留(")"))) { 位置[0]++; }
    // 439-a：消费参数列表的开 `(`（token 序：返回(*名) **(** 参数类型… )）
    如果 (当前类型(记号, 位置[0]) == 令牌_运算符 &&
         当前ID(记号, 位置[0]) == 整32(驻留("("))) { 位置[0]++; }
    如果 (!(当前类型(记号, 位置[0]) == 令牌_运算符 &&
            当前ID(记号, 位置[0]) == 整32(驻留(")")))) {
        当 (真) {
            整64 类型位置439 = 位置[0];
            字符串 参数类型439 = 解析类型文本(记号, &类型位置439, 假);
            如果 (字符串长度(参数类型439) == 0) {
                IO::打印到错误("[parse] 函数指针参数类型预期\n");
                语法错误加一();
                中断;
            }
            位置[0] = 类型位置439;
            当 (当前类型(记号, 位置[0]) == 令牌_运算符 &&
                 (当前ID(记号, 位置[0]) == 整32(驻留("*")) ||
                  当前ID(记号, 位置[0]) == 整32(驻留("&")))) {
                如果 (当前ID(记号, 位置[0]) == 整32(驻留("*"))) {
                    参数类型439 = 参数类型439 + "*";
                } 否则 {
                    参数类型439 = 参数类型439 + "&";
                }
                位置[0]++;
            }
            合成439 = 合成439 + 参数类型439;
            如果 (当前类型(记号, 位置[0]) == 令牌_运算符 &&
                 当前ID(记号, 位置[0]) == 整32(驻留(","))) {
                合成439 = 合成439 + ",";
                位置[0]++;
                继续;
            }
            中断;
        }
    }
    如果 (当前类型(记号, 位置[0]) == 令牌_运算符 &&
         当前ID(记号, 位置[0]) == 整32(驻留(")"))) { 位置[0]++; }
    合成439 = 合成439 + ")";
    // 回写返回类型节点：文本=规范化函数指针类型·附加=1（指针化）
    返回类型节点439.文本 = 整32(驻留(合成439));
    返回类型节点439.附加 = 1;
    结果<空类型, 整32> 设439 = 池.设置(整32(类型节点), 返回类型节点439);
    如果 (!设439.正常) { 运行时错误(4); }
    池追加(池, 建节点(节点_参数, 名ID439, 整64(类型节点), 0, 0));
    // 名与右括号均已在本块消费——位置已前进（原版「+1」系参数名未消费语义）
    返回 真;
}

// 解析参数：类型 名
函数 解析参数(向量<Token> 记号, 整64 位置, 向量<节点> 池) -> 整64 {
    // plans/019 阶段3（2026-09-10）：常量 只读引用参数前缀（常量 类型& 名）
    //   ——消费 常量 后解析类型；引用形态（类型节点附加=256）改标 257=
    //   常量引用（只读借用——赋值面语义检查用；宿主 isConstParam 对齐）
    布尔 是常量参数 = 假;
    如果 (是词(记号, 位置, "常量")) {
        是常量参数 = 真;
        位置++;
    }
    // T69（480-a 深度机）：函数指针形参 `返回类型(*名字)(参数类型列表)`——
    //   声明名嵌在 `(*名字)` 内（宿主 parser.cpp:316-328 parseParamDecl 同构）；
    //   类型节点由 解析函数指针类型节点 产出，结构与容器登记不适用（指针值）。
    如果 (是函数指针声明(记号, 位置)) {
        整32 参名fp = 0;
        整64 位置fp = 位置;
        整64 类型节点fp = 解析函数指针类型节点(记号, &位置fp, 池, &参名fp);
        如果 (类型节点fp >= 0 && 参名fp != 0) {
            池追加(池, 建节点(节点_参数, 参名fp, 整64(类型节点fp), 0, 0));
            返回 位置fp;
        }
    }
    整64 类型节点 = 池.大小();
    整64 类型起点1031 = 位置;   // 1031：解析类型前进判据（未前进=非类型起始 token）
    位置 = 解析类型(记号, 位置, 池);
    如果 (位置 == 类型起点1031 && 当前类型(记号, 位置) != 令牌_文件结束) {
        // 1031（定界符吞噬族·参数段起点非类型 token 收口）：原实现静默追加
        //   「无名无类型」参数节点吞掉该 token（`函数 f( -> 整32 {` 整段被后续
        //   结构当合法无参函数放行·P1/P3/P4/P5/P9 实录；宿主同形态
        //   「预期参数声明，实际为 'X'」拒绝）。文件结束豁免：保持 753 收口
        //   单一诊断面（参数表截断 + EOF 由调用方收口检查报「（文件结束）」）。
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                       ": 预期参数声明（实际为 '" + 当前文本(记号, 位置) + "'）\n");
        语法错误加一();
        返回 位置;
    }
    // 439-a（T69 阶段1·规范 02 §139/04）：函数指针形态 返回类型(*名)(参数类型列表)
    //   ——解析类型 已把返回类型入池（文本=合成名）；尾形态判定/消费已拆独立函数
    //   （1031 先拆再加：原内联块 65 行致本函数超百行红线）。
    如果 (解析参数函数指针尾439(记号, &位置, 池, 类型节点)) {
        返回 位置;
    }
    如果 (是常量参数) {
        节点 常量类型节点 = 池.元素(类型节点);
        如果 (常量类型节点.附加 == 256) {
            常量类型节点.附加 = 257;
            结果<空类型, 整32> 设常量标 = 池.设置(类型节点, 常量类型节点);
            如果 (!设常量标.正常) { 运行时错误(4); }
        }
    }
    如果 (当前类型(记号, 位置) == 令牌_标识符) {
        整32 参数名ID = 当前ID(记号, 位置);
        // P6e：参数若是结构体类型（值语义），登记 变量名ID -> 结构体名ID，
        //   成员访问（位置.x）据此推导对象所属结构体、查分桶字段偏移。
        节点 类型节点值 = 池.元素(类型节点);
        如果 (类型节点值.附加 <= 256) {
            // plans/018 类型分桶：登记值=键基（查结构体类型 三级——限定类型支持）
            整64 结构体键p = 查结构体类型(整64(类型节点值.文本));
            如果 (结构体键p != 0) {
                登记变量结构体(整64(参数名ID), 结构体键p);
            }
        }
        // P7b：容器/结果 参数登记 变量容器表（被调内成员调用预标注；引用参数同）
        字符串 参数类型文本 = 字符串复制(驻留文本(整64(类型节点值.文本)));
        如果 (是容器类(参数类型文本) || 是结果类型(参数类型文本)) {
            登记变量容器(整64(参数名ID), 整64(类型节点值.文本));
        }
        整32 参数节点索引d = 整32(池.大小());
        池追加(池, 建节点(节点_参数, 参数名ID, 整64(类型节点), 0, 0));
        位置 = 解析参数默认值(记号, 位置, 池, 参数节点索引d);
        返回 位置;
    }
    如果 (!(当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(":")))) {
        // 1031（无名参数族收口）：类型已解析出但参数名缺失（`(整32)`/`(整32,
        //   整32 b)`/`(,)`）——原实现静默追加无名参数节点放行（P11/P12/M5
        //   实录·宿主「预期参数名」拒绝）。冒号后置 `(x: 整32)` 豁免保持原路径
        //   （271_v2 负测锁定语义层诊断面·见 参数表收口诊断 注释）。
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                       ": 预期参数名（参数类型后缺名称）\n");
        语法错误加一();
    }
    池追加(池, 建节点(节点_参数, 0, 整64(类型节点), 0, 0));
    返回 位置;
}

// 吃分号（plans/015 方案B 强制分号，2026-09-04 用户裁决）：语句必须 ';' 终结——
//   缺失即 stderr 诊断+语法错误数 计数（错误即诊断，块截断静默家族整体消亡）；
函数 吃分号(向量<Token> 记号, 整64 位置) -> 整64 {
    如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
         当前ID(记号, 位置) == 整32(驻留(";"))) {
        返回 位置 + 1;
    }
    语法错误加一();
    整64 行号 = 0;
    如果 (记号.大小() > 0) {
        // 行号取前一 token（语句结尾 token）——对齐宿主 consumeSemicolon
        //   诊断位置纪律（缺陷③连带：原取下一语句起点行，偏 +1）
        整64 取行位置 = 位置 - 1;
        如果 (取行位置 < 0) { 取行位置 = 0; }
        如果 (取行位置 >= 记号.大小()) { 取行位置 = 记号.大小() - 1; }
        行号 = 整64(记号.元素(取行位置).行);
    }
    IO::打印到错误("[parse] 语句缺少分号 ';'（行=" + 整数转字符串(行号) + "）\n");
    返回 位置;
}
// ==================== 070 波B（1022 深度机·任务 #070）：lambda 表达式（匿名函数） ====================
// 规范 plans/001「lambda 表达式」：[捕获](参数) -> 返回 { 体 }；无返回标注由编译器
静态 向量<整64> lambda合成函数索引们;   // 合成函数池索引们（解析序·IR 生成消费）
静态 向量<整64> lambda合成模块们;       // 【#940】合成函数所属模块路径驻留 ID（与 索引们
                                        //   平行同序——同追加点同生命周期；IR 生成 lambda 体
                                        //   时作模块上下文，原恒取 模块路径们.元素(0)=首个
                                        //   加载文件（stdlib 核心）→跨模块 lambda 体内结构
                                        //   体布局键解析错模块=查结构体大小 miss→容器字段
                                        //   方法调用对象类型解析崩（#940 缺陷②））
静态 向量<整64> lambda延后名们;          // 延后段名ID 们（解析序·映射无遍历·向量驱动）
静态 映射<整64, 整64> lambda延后段起们;  // 名ID -> lambda token 段起（程序解析完统一补解析）
静态 映射<整64, 整64> lambda延后段止们;  // 名ID -> lambda token 段止（平衡跳过时登记）
静态 映射<整64, 整64> lambda捕获形态们;  // #276 波1：名ID -> 捕获形态（0=无·1=[=]值·2=[变量]显式·3=[&]引用波1 拒）
静态 向量<整64> lambda捕获名序们;          // #276 波1：捕获名ID 平铺（解析序·起们/计数们 定位区间·语义/IR 层消费）
静态 映射<整64, 整64> lambda捕获起们;      // #276 波1：名ID -> 名序区间起
静态 映射<整64, 整64> lambda捕获计数们;    // #276 波1：名ID -> 捕获个数
静态 整64 lambda计数1022 = 0;

// lambda 捕获起始判定（宿主 peekLambdaCapture 同位）：'[' 后跟 ']'/'='/'&'/标识符
//   =lambda 捕获形态；其余（表达式）=非 lambda（下标在原子后后缀位·原子位 '['
//   非捕获形态此前即非法·保持原失败路径）。
函数 是lambda捕获起始(向量<Token> 记号, 整64 位置) -> 布尔 {
    如果 (!(当前类型(记号, 位置) == 令牌_运算符 &&
           当前ID(记号, 位置) == 整32(驻留("[")))) { 返回 假; }
    整64 p = 位置 + 1;
    如果 (p >= 记号.大小()) { 返回 假; }
    整32 tp = 当前类型(记号, p);
    如果 (tp == 令牌_运算符 &&
        (当前ID(记号, p) == 整32(驻留("]")) ||
         当前ID(记号, p) == 整32(驻留("=")) ||
         当前ID(记号, p) == 整32(驻留("&")))) { 返回 真; }
    如果 (tp == 令牌_标识符) { 返回 真; }
    返回 假;
}

// #439：基础类型名判定（语义检查表达式 P6g 类型转换白名单同名单）——lambda
//   体内 类型名(表达式) 转换被调名不是变量，宿主 AST 级收集 lookupVar 只认
//   外层已声明变量=天然排除；v2 token 级收集=名单判定近似（428 成员名排除
//   同模式）。同名单服务两处：转换被调位（体q 本位）与声明类型位（体q-1）。
//   用户类名/容器合成名面=462 勿扩线。
函数 是lambda转换类型名(整64 名ID) -> 布尔 {
    字符串 名 = 字符串复制(驻留文本(名ID));
    如果 (字符串比较(名, "整8") || 字符串比较(名, "整16") ||
         字符串比较(名, "整32") || 字符串比较(名, "整64") ||
         字符串比较(名, "整128") || 字符串比较(名, "正8") ||
         字符串比较(名, "正16") || 字符串比较(名, "正32") ||
         字符串比较(名, "正64") || 字符串比较(名, "正128") ||
         字符串比较(名, "浮32") || 字符串比较(名, "浮64") ||
         字符串比较(名, "布尔") || 字符串比较(名, "字符") ||
         字符串比较(名, "字符串")) { 返回 真; }
    返回 假;
}

// #439：内置可调用名判定——IR 内置函数返回类型ID 表命中（打印/打印行/
//   字符串连接/运行时错误/内存::/时间::/线程::/解析:: 族）+ 语义层散名放行
//   名单同款（类型大小/转移/复制/正常/错误/某些）。体内调用它们的被调名
//   不是变量非捕获项（宿主 lookupVar 全不命中同语义）；极端遮蔽（用户变量
//   恰与内置同名）=428 同款 token 级近似哲学（快照多份·语义等价可容忍）。
函数 是lambda内置可调名(整64 名ID) -> 布尔 {
    如果 (内置函数返回类型ID(字符串复制(驻留文本(名ID))) != 0) { 返回 真; }
    字符串 名 = 字符串复制(驻留文本(名ID));
    如果 (字符串比较(名, "类型大小") || 字符串比较(名, "转移") ||
         字符串比较(名, "复制") || 字符串比较(名, "正常") ||
         字符串比较(名, "错误") || 字符串比较(名, "某些")) { 返回 真; }
    返回 假;
}

// lambda 解析：消费捕获段（第一版仅 [] 放行·捕获形态优雅拒绝）→ 参数表 →
//   可选 -> 返回 → 体（解析块）→ 池尾合成 节点_函数 + 表达式位标识符。
// 480（473 p9·001 §747 表第 8 行整族执法）：体内写顶层静态 lambda计数1022
//   （lambda 命名序号）须 不安全 函数——编译器内部全局状态写。
不安全 函数 解析lambda原子(向量<Token> 记号, 整64 位置, 向量<节点> 池,
                   映射<整64, 整64>& 字段偏移表) -> 整64 {
    // 延后解析方案（首两版实录：体/参数/合成函数节点在表达式区间内=净栈多压/
    // 推断区间污染——调用方以 池.大小() 差值算表达式区间，单一池无法避让）：
    lambda计数1022++;
    字符串 lambda名 = "?lambda" + 整数转字符串(lambda计数1022);
    整64 名ID = 驻留(lambda名);
    池追加(池, 建节点(节点_标识符, 整32(名ID), 0, 0, 0));
    // 段起登记（扫描前·'[' 位——补解析从 '[' 重放；首版实录=登记在扫描后
    //   段起==段止位·补解析从 lambda 之后的 token 乱解析）
    结果<空类型, 整32> 登段 = lambda延后段起们.设置(名ID, 位置);
    如果 (!登段.正常) { 运行时错误(4); }
    结果<空类型, 整32> 登名 = lambda延后名们.追加(名ID);
    如果 (!登名.正常) { 运行时错误(4); }
    // #276 波1：捕获段分类登记（001「lambda 表达式」四形态）——']'=无·
    //   '=]'=值·'&]'=引用（波1 拒·补解析报错）·标识符(,标识符)* ']'=显式。
    //   显式名单在此登记；[=] 名单=体标识符（补解析 token 级收集·语义层过滤）。
    整64 分类q = 位置 + 1;
    整64 捕获形态 = 0;
    如果 (分类q < 记号.大小() &&
        !(当前类型(记号, 分类q) == 令牌_运算符 &&
          当前ID(记号, 分类q) == 整32(驻留("]")))) {
        如果 (当前类型(记号, 分类q) == 令牌_运算符 &&
             当前ID(记号, 分类q) == 整32(驻留("="))) { 捕获形态 = 1; }
        否则 如果 (当前类型(记号, 分类q) == 令牌_运算符 &&
             当前ID(记号, 分类q) == 整32(驻留("&"))) { 捕获形态 = 3; }
        否则 { 捕获形态 = 2; }
    }
    结果<空类型, 整32> 登形态 = lambda捕获形态们.设置(名ID, 捕获形态);
    如果 (!登形态.正常) { 运行时错误(4); }
    如果 (捕获形态 == 2) {
        结果<空类型, 整32> 登起 = lambda捕获起们.设置(名ID, 整64(lambda捕获名序们.大小()));
        如果 (!登起.正常) { 运行时错误(4); }
        整64 显捕获数 = 0;
        整64 扫名q = 分类q;
        当 (扫名q < 记号.大小() &&
            !(当前类型(记号, 扫名q) == 令牌_运算符 &&
              当前ID(记号, 扫名q) == 整32(驻留("]")))) {
            如果 (当前类型(记号, 扫名q) == 令牌_标识符) {
                结果<空类型, 整32> 登捕获名 = lambda捕获名序们.追加(整64(当前ID(记号, 扫名q)));
                如果 (!登捕获名.正常) { 运行时错误(4); }
                显捕获数++;
            }
            扫名q++;
        }
        结果<空类型, 整32> 登计数 = lambda捕获计数们.设置(名ID, 显捕获数);
        如果 (!登计数.正常) { 运行时错误(4); }
    }
    // 整段跳过：[捕获] (参数) [-> 类型] { 体 }——两段式（首版整段深度扫描
    //   实录：[] 的 ']' 深度归零误判段止）。段1=扫到体 '{'（捕获/参数/返回
    //   区无 '{'）；段2='{' 平衡扫描到配对 '}'。'->' 单 token。
    当 (位置 < 记号.大小() &&
        !(当前类型(记号, 位置) == 令牌_运算符 &&
          当前ID(记号, 位置) == 整32(驻留("{")))) { 位置++; }
    如果 (位置 < 记号.大小() &&
         当前类型(记号, 位置) == 令牌_运算符 &&
         当前ID(记号, 位置) == 整32(驻留("{"))) {
        整64 深度 = 0;
        当 (位置 < 记号.大小()) {
            如果 (当前类型(记号, 位置) == 令牌_运算符) {
                整32 idv = 当前ID(记号, 位置);
                如果 (idv == 整32(驻留("{"))) { 深度++; }
                否则 如果 (idv == 整32(驻留("}"))) {
                    深度--;
                    如果 (深度 == 0) {
                        位置++;
                        中断;
                    }
                }
            }
            位置++;
        }
    }
    结果<空类型, 整32> 登止 = lambda延后段止们.设置(名ID, 位置);
    如果 (!登止.正常) { 运行时错误(4); }
    返回 位置;
}

// 程序解析完成后统一补解析（解析程序 尾·节点_程序 追加前挂）：对每个延后段
//   完整解析 参数/体/合成函数——此时入池恒在池尾=程序声明区间外（零区间污染）。
//   段表文件级清空（多文件逐文件解析·记号上下文=本文件）。
不安全 函数 解析lambda延后段们(向量<Token> 记号, 整64 位置, 向量<节点> 池,
                     映射<整64, 整64>& 字段偏移表) -> 整64 {
