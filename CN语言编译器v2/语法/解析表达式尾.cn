                    整64 花深 = 1;
                    整64 收数 = 0;
                    当 (体q < 段止 && 花深 > 0) {
                        如果 (当前类型(记号, 体q) == 令牌_运算符) {
                            整32 花id = 当前ID(记号, 体q);
                            如果 (花id == 整32(驻留("{"))) { 花深++; }
                            否则 如果 (花id == 整32(驻留("}"))) { 花深--; }
                        } 否则 {
                            如果 (当前类型(记号, 体q) == 令牌_标识符 && 花深 > 0) {
                                // #428：成员访问名排除——`对象.成员` 的成员名是
                                //   标识符 token 但非捕获变量（宿主 AST 级收集只认
                                //   变量引用；token 级近似=前一 token='.' 判定）。
                                //   719 首测实录：[=]+成员访问 成员名误收→语义
                                //   「捕获的变量 'x' 未声明」拒绝=与宿主分叉。
                                整64 是成员名 = 0;
                                如果 (体q > 0 && 当前类型(记号, 体q - 1) == 令牌_运算符 &&
                                     当前ID(记号, 体q - 1) == 整32(驻留("."))) {
                                    是成员名 = 1;
                                }
                                整64 候 = 0;
                                // #439：内置函数名/转换类型名排除——体内调用的
                                //   内置函数（打印行/类型大小/转移/复制/正常/错误/
                                //   某些 族）与类型转换被调名（整64(7) 的 整64）
                                //   不是变量，宿主 lookupVar 只认外层变量=天然排除；
                                //   token 级近似=名单判定（上两判定函数）。
                                //   440 i128 间接调用族 dual 化被此卡实录：lambda 体
                                //   打印行(整64(值)) →「捕获的变量 '打印行'/'整64'
                                //   未声明」整编译拒绝=与宿主分叉。
                                //   #439：体内声明名（两遍扫第二遍）——声明位与
                                //   引用位全豁（预扫名集见上）。
                                整64 是排除名 = 0;
                                如果 (是成员名 == 0) {
                                    候 = 整64(当前ID(记号, 体q));
                                    如果 (是lambda内置可调名(候)) { 是排除名 = 1; }
                                    否则 如果 (是lambda转换类型名(候)) { 是排除名 = 1; }
                                    整64 在声明 = 0;
                                    整64 声i = 0;
                                    当 (声i < 体内声明名集.大小()) {
                                        如果 (体内声明名集.元素(整32(声i)) == 候) { 在声明 = 1; 中断; }
                                        声i++;
                                    }
                                    如果 (在声明 == 1) { 是排除名 = 1; }
                                }
                                整64 在排除 = 0;
                                整64 排i = 0;
                                当 (排i < 排除集.大小()) {
                                    如果 (排除集.元素(整32(排i)) == 候) { 在排除 = 1; 中断; }
                                    排i++;
                                }
                                整64 在名单 = 0;
                                结果<整64, 整32> 查起0 = lambda捕获起们.获取(名ID);
                                如果 (查起0.正常) {
                                    整64 名i = 查起0.值;
                                    当 (名i < lambda捕获名序们.大小()) {
