// 解析语句尾（357 重构F2 自 解析语句.cn 纯机械搬移·函数体逐字保留·零逻辑变化）

导入 容器::向量;
导入 映射集合;
导入 词法;       // Token 结构（原 导入 词法分析，目录包名）
导入 IR;         // 节点_*/键位移 常量（原 IR容器+IR常量 合并目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

函数 解析变量声明语句(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    整64 类型节点 = 池.大小();
    // T69（480-a 深度机）：函数指针声明形态 `返回类型(*名字)(参数类型列表)`——
    //   类型节点合成（函数指针<返回>(参数表)）+ 声明名自 `(*名字)` 取出
    //   （宿主 parser.cpp parseFuncPtrType 同构）；非此形态走既有 解析类型。
    整32 名ID = 0;
    布尔 是函数指针声明480 = 假;
    // 040 甲案（082②·001 §5.8）：数组元素位 `整32(*表[2])(整32)` 同通道——
    //   合成文本=函数指针<...>[N]（是数组类型文本 命中 → 元素登记/下标通道复用）
    如果 (是函数指针声明(记号, 位置) || 是函数指针声明数组(记号, 位置)) {
        整64 位置fp480 = 位置;
        整64 节点fp480 = 解析函数指针类型节点(记号, &位置fp480, 池, &名ID);
        如果 (节点fp480 >= 0) {
            位置 = 位置fp480;
            是函数指针声明480 = 真;
        }
    }
    如果 (!是函数指针声明480) {
        位置 = 解析类型(记号, 位置, 池);
    }
    如果 (详细诊断开启()) {
        IO::打印到错误("[trace] 声明语句 类型节点=" + 整数转字符串(类型节点) +
                       " 池后=" + 整数转字符串(池.大小()) + "\n");
    }
    // T69（480-a）+818（064）合并：函数指针声明形态名自 (*名字) 取出；其余形态
    //   走 818 保留字拒绝后取标识符名
    如果 (!是函数指针声明480) {
        // 818（064）：声明名位保留字拒绝（宿主「模块解析失败」对齐）
        如果 (当前类型(记号, 位置) == 令牌_关键字) {
            IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                           ": 保留字不可作变量名（声明名位遇到关键字「" +
                           驻留文本(当前ID(记号, 位置)) + "」）\n");
            语法错误加一();
            返回 位置 + 1;
        }
        名ID = 当前ID(记号, 位置);
        // 865-a：同名普通局部声明 = 遮蔽静态（C 同款·后续引用回原名）
        如果 (当前在函数内86()) { 遮蔽局部静态名86(整64(名ID)); }
    }
    // P6e：局部变量若是结构体类型（值语义），登记 变量名ID -> 结构体名ID
    //   （引用形态 附加=256 同样登记——对齐参数位惯例：q.值 成员基址=槽内容；
    //   第17枚根治：指针形态 附加=1..255 同登记——p.字段 偏移标注同参数位）
    节点 类型节点值 = 池.元素(类型节点);
    如果 (类型节点值.附加 <= 256) {
        // plans/018 类型分桶：登记值=键基（查结构体类型 三级——限定类型支持）
        整64 结构体键v = 查结构体类型(整64(类型节点值.文本));
        如果 (结构体键v != 0) {
            登记变量结构体(整64(名ID), 结构体键v);
        }
    }
    // P7b：容器/结果 变量登记 变量容器表（成员预标注用；引用形态 附加=256 同样登记）
    字符串 声明类型文本 = 字符串复制(驻留文本(整64(类型节点值.文本)));
    如果 (是容器类(声明类型文本) || 是结果类型(声明类型文本)) {
        登记变量容器(整64(名ID), 整64(类型节点值.文本));
    }
    // 94-a（2026-09-13 第九十四轮）：数组声明——元素为结构体时登记
    //   数组元素结构体表（成员链 表[0].x 的字段偏移标注/IR 对象类型推导消费）
    如果 (是数组类型文本(声明类型文本)) {
        字符串 元素94 = 数组元素文本(声明类型文本);
        如果 (字符串长度(元素94) > 0) {
            整64 元素结构体键94 = 查结构体类型(驻留(元素94));
            如果 (元素结构体键94 != 0) {
                登记数组元素结构体94(整64(名ID), 元素结构体键94);
            }
        }
    }
    // T69（480-a）：函数指针声明位的名字已在 `(*名字)` 内消费——不再跳过名字 token
    如果 (!是函数指针声明480) { 位置++; }
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("="))) {
        位置++;
        // 结构体构造字面量（2026-09-09 用户裁决，宿主 parseStructInit 对齐 +
        //   Rust E0063 穷举纪律，规范 05 二）：类型名{ 字段 = 值, ... } 解析期
        如果 (当前类型(记号, 位置) == 令牌_标识符 &&
             整64(当前ID(记号, 位置)) == 整64(类型节点值.文本) &&
             位置 + 1 < 记号.大小() &&
             当前类型(记号, 位置 + 1) == 令牌_运算符 &&
             当前ID(记号, 位置 + 1) == 整32(驻留("{"))) {
            整64 构造行 = 整64(记号.元素(位置).行);
            // 裸声明节点先入池（B1 零初始化打底——穷举检查保证不缺字段）；
            //   字段循环+穷举检查第四十六轮起走 解析构造字段赋值们 单一助手
            //   （声明位/标识符赋值位/成员赋值位同源，诊断文本逐字一致）
            池追加(池, 建节点(节点_变量声明, 名ID, 整64(类型节点), 0, 0));
            向量<整64> 空链名们 = 向量<整64>();
            向量<整64> 空链偏移们 = 向量<整64>();
            位置 = 解析构造字段赋值们(记号, 位置 + 1, 池, 字段偏移表, 名ID,
                                  空链名们, 空链偏移们,
                                  查结构体类型(整64(类型节点值.文本)),
                                  整64(类型节点值.文本), 构造行);
        } 否则 如果 (是数组类型文本(声明类型文本) &&
                    当前类型(记号, 位置) == 令牌_运算符 &&
                    当前ID(记号, 位置) == 整32(驻留("{"))) {
            // 94-a（2026-09-13 第九十四轮）：数组初始化列表 { e1, e2, ... }
            //   （规格书 3.5 固定长度数组；宿主 parser 数组初始化列表分支对齐）。
            位置 = 解析数组初始化列表(记号, 位置, 池, 字段偏移表);
            整64 初始化节点 = 池.大小() - 1;   // 末位=刚追加的 节点_数组初始化
            池追加(池, 建节点(节点_变量声明, 名ID, 整64(类型节点),
                              整32(初始化节点), 整32(池.大小())));
        } 否则 {
            整64 值起点 = 池.大小();
            位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
            池追加(池, 建节点(节点_变量声明, 名ID, 整64(类型节点), 整32(值起点), 整32(池.大小())));
        }
    } 否则 {
        池追加(池, 建节点(节点_变量声明, 名ID, 整64(类型节点), 0, 0));
    }
    返回 吃分号(记号, 位置);
}

// 解析静态声明（②c C，2026-09-02，规范 03-一）：静态 类型 名 [= 表达式]。
//   容器静态裸声明（E2E 121 形状——入口 NewObject+构造）；标量静态初始值
函数 解析静态声明(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    如果 (是词(记号, 位置, "静态")) { 位置++; }
    整64 类型节点 = 池.大小();
    // 040 甲案（082⑥·001 §5.8）：函数指针静态槽 `静态 整32(*回调)(整32) = 函数名;`
    //   ——类型节点=规范化合成文本（数组位=函数指针<...>[N]），名字自 (*名) 取出
    整32 名ID = 0;
    布尔 是静态fp480 = 假;
    如果 (是函数指针声明(记号, 位置) || 是函数指针声明数组(记号, 位置)) {
        整64 位置fp480 = 位置;
        整64 节点fp480 = 解析函数指针类型节点(记号, &位置fp480, 池, &名ID);
        如果 (节点fp480 >= 0 && 名ID != 0) {
            类型节点 = 节点fp480;
            位置 = 位置fp480;
            是静态fp480 = 真;
        } 否则 {
            名ID = 0;
        }
    }
    如果 (!是静态fp480) {
        位置 = 解析类型(记号, 位置, 池);
        名ID = 当前ID(记号, 位置);
        位置++;
    }
    // 865-a（070·G-N 特性波）：函数内静态局部——合成名唯一化 + 映射登记
    //   （宿主 ?gstatic_$静态$函数$名 同精神·ir_stmt_decl.cpp:32）；顶层静态
    //   当前解析函数86=0 → 零改写（零回归）。
    如果 (当前在函数内86()) {
        整32 原名86 = 名ID;
        字符串 合成名86 = 字符串复制(驻留文本(整64(原名86)) + "$静态$" +
                                     驻留文本(当前解析函数值86()));
        名ID = 整32(驻留(合成名86));
        登记局部静态名86(整64(原名86), 整64(名ID));
    }
    节点 类型节点值 = 池.元素(类型节点);
    字符串 类型文本 = 字符串复制(驻留文本(整64(类型节点值.文本)));
    // 容器静态登记 变量容器表（方法调用对象类型解析：池.追加 ——跨函数可见）
    如果 (是容器类(类型文本) || 是结果类型(类型文本)) {
        登记变量容器(整64(名ID), 整64(类型节点值.文本));
    } 否则 {
        // 结构体静态登记 变量结构体表（值/指针/引用形态——第17枚根治同参数位：
        //   静态结构体指针 .字段 偏移标注同需分桶表）。plans/018 类型分桶：
        //   登记值=键基（查结构体类型 三级解析——限定/跨模块类型支持）
        如果 (类型节点值.附加 <= 256) {
            整64 结构体键s = 查结构体类型(整64(类型节点值.文本));
            如果 (结构体键s != 0) {
                登记变量结构体(整64(名ID), 结构体键s);
            }
        }
    }
    整64 值起点 = 池.大小();
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("="))) {
        位置++;
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
    }
    节点 静态节点86 = 建节点(节点_静态声明, 名ID, 整64(类型节点), 整32(值起点), 整32(池.大小()));
    // 865-a：函数内静态局部标记（修饰=1）——语义层 B10 免检（宿主 isGlobalStatic 口径）
    如果 (当前在函数内86()) { 静态节点86.修饰 = 1; }
    池追加(池, 静态节点86);
    返回 吃分号(记号, 位置);
}

// 解引用语句解析（R3 拆分）：*指针 = 表达式 / *p op= r 复合赋值（灰色点③根治）/
//   *表达式 表达式语句（缺陷②分诊根治：包 节点_表达式语句 根）。
函数 解析解引用语句(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    整64 左值起点 = 池.大小();
    整64 语句起点 = 位置;
    位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("="))) {
        // 左值区间 = [左值起点, 表达式末节点+1)；表达式末节点即 解引用/成员 根
        整64 左值终点 = 整64(池.大小());
        位置++;
        整64 右值起点 = 池.大小();
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        池追加(池, 建节点(节点_赋值, 0, 整64(左值起点), 整32(右值起点), 整32(池.大小())));
        返回 吃分号(记号, 位置);
    }
    // 灰色点③根治（2026-09-04 用户裁决立案·缺陷零容忍）：解引用复合赋值
    //   *p op= r（方案A 对齐兜底复合分支——L op= R ≡ L = L op R）。原本分支
    如果 (位置 > 语句起点 && 池.大小() > 左值起点 &&
         当前类型(记号, 位置) == 令牌_运算符 && 是复合赋值符(当前ID(记号, 位置))) {
        整32 复合符 = 当前ID(记号, 位置);
        整64 右值起点 = 池.大小();
        位置 = 语句起点;
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);   // 左值副本（右值首操作数）
        位置++;                                        // 复合符（重析后再到此处）
        整64 右操作数起点 = 池.大小();
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        池追加(池, 建节点(节点_二元运算, 复合二元符号(复合符),
                          右操作数起点, 整32(右值起点), 1));
        池追加(池, 建节点(节点_赋值, 0, 左值起点, 整32(右值起点), 整32(池.大小())));
        返回 吃分号(记号, 位置);
    }
    // 非赋值：*表达式 作为表达式语句——包 节点_表达式语句 根（缺陷②分诊根治：
    //   原裸节点无根——语义层靠块级裸派发兜底（双重处理根源），IR 语句派发
    //   对裸节点零分支静默跳过=死代码。根节点统一后语义/IR 各走语句根一次）
    池追加(池, 建节点(节点_表达式语句, 0, 0, 整32(左值起点), 整32(池.大小())));
    返回 吃分号(记号, 位置);
}

// 自增/自减语句解析（R3 拆分）：前缀 ++/-- 变量 或 后缀 变量 ++/--（簇③ C1
//   对称）。匹配返回新位置；不匹配返回 -1（主干继续走表达式兜底）。
函数 解析自增自减语句(向量<Token> 记号, 整64 位置, 向量<节点> 池) -> 整64 {
如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("++")) &&
     位置 + 1 < 记号.大小() && 当前类型(记号, 位置 + 1) == 令牌_标识符) {
    位置++;
    整32 自增名ID = 静态名归一86(当前ID(记号, 位置));
    位置++;
    池追加(池, 建节点(节点_自增, 自增名ID, 0, 0, 0));
    返回 吃分号(记号, 位置);
}
如果 (当前类型(记号, 位置) == 令牌_标识符 && 位置 + 1 < 记号.大小() &&
     当前类型(记号, 位置 + 1) == 令牌_运算符 && 当前ID(记号, 位置 + 1) == 整32(驻留("++"))) {
    整32 后缀名ID = 静态名归一86(当前ID(记号, 位置));
    位置 += 2;
    池追加(池, 建节点(节点_自增, 后缀名ID, 0, 0, 0));
    返回 吃分号(记号, 位置);
}
// 簇③根治·自减全链 C1（2026-09-04 用户裁决）：前缀 -- 变量 / 后缀 变量 --
//   ——与 节点_自增 分支完全对称（v2 仅语句级，前/后缀同语义）。词法补 --
//   后若无本分支，-- token 成孤儿触发块截断静默家族（lessons 复合赋值假绿同族）
如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("--")) &&
     位置 + 1 < 记号.大小() && 当前类型(记号, 位置 + 1) == 令牌_标识符) {
    位置++;
    整32 自减名ID = 静态名归一86(当前ID(记号, 位置));
    位置++;
    池追加(池, 建节点(节点_自减, 自减名ID, 0, 0, 0));
    返回 吃分号(记号, 位置);
}
如果 (当前类型(记号, 位置) == 令牌_标识符 && 位置 + 1 < 记号.大小() &&
     当前类型(记号, 位置 + 1) == 令牌_运算符 && 当前ID(记号, 位置 + 1) == 整32(驻留("--"))) {
    整32 后缀减名ID = 静态名归一86(当前ID(记号, 位置));
    位置 += 2;
    池追加(池, 建节点(节点_自减, 后缀减名ID, 0, 0, 0));
    返回 吃分号(记号, 位置);
}
返回 0 - 1;
}
// 413-a（D44 正体收口·宿主对齐）：选择语句解析——产出真 节点_选择语句+
//   节点_情况标签 序列（不再降糖 If 链/贯穿标志——376-a/406-a 模型三缺口：
函数 解析选择语句(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    位置++;   // 消费 选择
    如果 (当前类型(记号, 位置) != 令牌_运算符 ||
         当前ID(记号, 位置) != 整32(驻留("("))) {
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 选择 预期 '('\n");
        语法错误加一();
        返回 位置;
    }
    位置++;
    整64 值起点 = 池.大小();
    位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
    整64 值终点 = 池.大小();
    如果 (当前类型(记号, 位置) != 令牌_运算符 ||
         当前ID(记号, 位置) != 整32(驻留(")"))) {
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 选择 预期 ')'\n");
        语法错误加一();
        返回 位置;
    }
    位置++;
    如果 (当前类型(记号, 位置) != 令牌_运算符 ||
         当前ID(记号, 位置) != 整32(驻留("{"))) {
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 选择 预期 '{'\n");
        语法错误加一();
        返回 位置;
    }
    位置++;
    整64 第一情况索引 = 池.大小();   // 情况段起点（无情况时函数尾修正为自身位置）
    整64 情况计数 = 0;
    当 (真) {
        如果 (当前类型(记号, 位置) == 令牌_文件结束) { 中断; }
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留("}"))) { 位置++; 中断; }
        如果 (是关键(记号, 位置, "默认")) {
            位置 = 解析选择默认分支(记号, 位置, 池, 字段偏移表, &情况计数);
            继续;
        }
        如果 (是关键(记号, 位置, "情况")) {
            位置 = 解析选择情况分支(记号, 位置, 池, 字段偏移表, &情况计数);
            继续;
        }
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                       ": 选择 体预期 情况/默认\n");
        语法错误加一();
        位置++;
    }
    // 情况段终点=当前池大小（情况标签连续段末）；无情况时修正第一情况索引
    // （=选择节点自身位置·空区间 [自身,自身) 防悬空）
    如果 (情况计数 == 0) { 第一情况索引 = 池.大小(); }
    池追加(池, 建节点(节点_选择语句, 整32(值起点), 整32(值终点),
                  整32(第一情况索引), 整32(池.大小())));
    返回 位置;
}

不安全 函数 解析选择默认分支(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表, 整64* 情况计数) -> 整64 {
    // 默认=空值区间情况标签（[0,0)=默认标记·生成期挂判断链末）
            位置++;
            如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == 整32(驻留(":"))) { 位置++; }
            // 默认=空值区间情况标签（[0,0)=默认标记·生成期挂判断链末）
            整64 默认体起点 = 池.大小();
            当 (真) {
                如果 (当前类型(记号, 位置) == 令牌_文件结束) { 中断; }
                如果 (是关键(记号, 位置, "情况")) { 中断; }
                如果 (是关键(记号, 位置, "默认")) { 中断; }
                如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留("}"))) { 中断; }
                位置 = 带守卫解析语句(记号, 位置, 池, 字段偏移表);
            }
            整64 默认体终点 = 池.大小();
            池追加(池, 建节点(节点_块, 0, 0, 整32(默认体起点), 整32(默认体终点)));
            池追加(池, 建节点(节点_情况标签, 0, 0, 整32(池.大小() - 1), 0));
            情况计数[0] = 情况计数[0] + 1;
            返回 位置;
}

不安全 函数 解析选择情况分支(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表, 整64* 情况计数) -> 整64 {
            位置++;
            // 434-a（C-4 多值分组·规范 03 §270-271）：情况值, {",", 情况值}——
            //   前序值=空体标签（宿主 `case 1: case 2:` 同构·匹配落入下一判断）、
            向量<整64> 值起点们 = 向量<整64>();
            向量<整64> 值终点们 = 向量<整64>();
            整64 字符串值计数 = 0;
            当 (真) {
                整64 情况值起点 = 池.大小();
                位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
                整64 情况值终点 = 池.大小();
                如果 (情况值终点 > 情况值起点) {
                    结果<空类型, 整32> 加起 = 值起点们.追加(情况值起点);
                    如果 (!加起.正常) { 运行时错误(4); }
                    结果<空类型, 整32> 加终 = 值终点们.追加(情况值终点);
                    如果 (!加终.正常) { 运行时错误(4); }
                    如果 (池.元素(整32(情况值起点)).类型 == 节点_字符串字面量) {
                        字符串值计数++;
                    }
                } 否则 {
                    // 畸形输入（`情况 ,` / `情况 :`）：空值不入向量——不产生空区间
                    // 标签（生成层零风险）·诊断缺值
                    IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                                   ": 情况值缺失\n");
                    语法错误加一();
                }
                如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留(","))) {
                    位置++;
                    继续;
                }
                中断;
            }
            如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == 整32(驻留(":"))) { 位置++; }
            整64 体起点 = 池.大小();
            当 (真) {
                如果 (当前类型(记号, 位置) == 令牌_文件结束) { 中断; }
                如果 (是关键(记号, 位置, "情况")) { 中断; }
                如果 (是关键(记号, 位置, "默认")) { 中断; }
                如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留("}"))) { 中断; }
                位置 = 带守卫解析语句(记号, 位置, 池, 字段偏移表);
            }
            整64 体终点 = 池.大小();
            池追加(池, 建节点(节点_块, 0, 0, 整32(体起点), 整32(体终点)));
            // 字符串情况值：任一值为字符串字面量 → __cn_str_eq 路径（宿主 C-4 对齐；
            //   混合类型多值不单独诊断=诚实边界·生成按字符串比较路径）
            整64 字符串值 = 0;
            如果 (字符串值计数 > 0) { 字符串值 = 1; }
            整64 体块索引 = 池.大小() - 1;
            整64 值计数 = 值起点们.大小();
            整64 值i = 0;
            当 (值i < 值计数) {
                如果 (值i + 1 < 值计数) {
                    // 前序值=空体标签：空块 [x,x) + 标签指向它（体直落下一判断块）
                    池追加(池, 建节点(节点_块, 0, 0, 整32(池.大小()), 整32(池.大小())));
                    池追加(池, 建节点(节点_情况标签, 整32(值起点们.元素(整32(值i))),
                                  整32(值终点们.元素(整32(值i))),
                                  整32(池.大小() - 1), 整32(字符串值)));
                } 否则 {
                    池追加(池, 建节点(节点_情况标签, 整32(值起点们.元素(整32(值i))),
                                  整32(值终点们.元素(整32(值i))),
                                  整32(体块索引), 整32(字符串值)));
                }
                值i++;
            }
            情况计数[0] = 情况计数[0] + 值计数;
            返回 位置;
}

