// CN 自举编译器 v2 · 解析基础（千行拆分子模块+破环，2026-09-08 阶段目录包）
// 职责：语法层解析基础设施——节点池辅助（池追加/建节点/记号访问/是关键）+
//   语法错误计数 + 解析期登记表（变量结构体表/变量容器表/导入项们 及其
//   访问/清空函数）。被 解析表达式/解析语句/语法分析 三方依赖且零反向依赖
//   （包声明序首位——宿主逐文件流水检查，依赖先解析，破 主干↔表达式 循环）。
//   模块路径=解析基础（新键基，全部 公开:）。
导入 容器::向量;
导入 映射集合;
导入 词法;       // Token 结构（阶段目录包名）
导入 IR;         // 节点/键位移 常量（目录包名）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// P6e（2026-08-30）：字段偏移表按结构体分桶根治——扁平 字段名->偏移 单映射
//   在两个结构体同名字段（点.x 与 矩形.x）时串偏移（用户批评的正确性隐患）。
//   方案：键 = 结构体名ID * 键位移 + 字段名ID（单映射，无嵌套依赖）；
//   成员访问时经 变量结构体表（变量名ID -> 结构体名ID）推导对象所属结构体。
//   键位移常量值见 IR常量.cn（A2 单一归属）。
静态 映射<整64, 整64> 变量结构体表;

静态 整64 语法错误数 = 0;   // plans/015 方案B（2026-09-04）：语句终结分号缺失计数（主链 语义分析前检查中止）

// 构造字面量穷举检查表（2026-09-09 用户裁决，Rust E0063 同构，宿主 parseStructInit
//   对齐）：结构体声明解析期登记 字段清单（键基域：键=键基*键位移+序 -> 字段名ID，
//   数表：键=键基 -> 字段数），构造字面量解析期逐序比对——缺字段=语法错误
//   （stderr 诊断+语法错误数，中止通道与 缺分号 同款）。跨文件仅函数可见惯例。
静态 映射<整64, 整64> 构造字段名表;
静态 映射<整64, 整64> 构造字段数表;

// 结构体声明解析期登记：字段序 -> 字段名ID（键基域，与 字段偏移表 同域）
函数 登记构造字段(整64 键基, 整64 序, 整64 字段名ID) -> 空类型 {
    结果<空类型, 整32> 设名 = 构造字段名表.设置(键基 * 键位移 + 序, 字段名ID);
    如果 (!设名.正常) { 运行时错误(4); }
    结果<空类型, 整32> 设数 = 构造字段数表.设置(键基, 序 + 1);
    如果 (!设数.正常) { 运行时错误(4); }
}

// 构造字面量穷举比对：字段数（0=非结构体/未登记——非结构体类型无构造字面量）
函数 构造字段数(整64 键基) -> 整64 {
    结果<整64, 整32> 查 = 构造字段数表.获取(键基);
    如果 (查.正常) { 返回 查.值; }
    返回 0;
}

// 构造字面量穷举比对：序 -> 字段名ID（-1=未命中）
函数 构造字段名(整64 键基, 整64 序) -> 整64 {
    结果<整64, 整32> 查 = 构造字段名表.获取(键基 * 键位移 + 序);
    如果 (查.正常) { 返回 查.值; }
    返回 0 - 1;
}

// plans/018 P6b：语法错误计数 +1（主.cn 加载器挂载定位失败复用本中止通道——
//   跨文件经函数调用而非直接引用静态变量，与既有跨文件消费点同构）
函数 语法错误加一() -> 空类型 {
    语法错误数++;
}

// P7b（2026-09-01）：变量容器表——容器/结果 变量名ID -> $合成类型名ID。
//   成员解析时预标注到 节点_成员.子终点（对象类型ID）：方法调用（附加=-2）与
//   结果字段访问（.正常/.值）IR 层据此直接取对象类型——生成表达式 无需携带
//   类型表参数（宿主 nameMangle 符号长度限制 247：多一个映射参数即超限，
//   PROC 符号注册失败导致 bb 标签泄漏全局连锁 A2005——实测踩坑）。
//   跨文件保留（同 变量结构体表 模式），清空 由加载器任务开始前调用。
静态 映射<整64, 整64> 变量容器表;

函数 池追加(向量<节点> 池, 节点 n) -> 整32 {
    结果<空类型, 整32> 加 = 池.追加(n);
    如果 (!加.正常) { 运行时错误(4); }
    返回 整32(池.大小() - 1);
}

函数 建节点(整32 类型, 整32 文本, 整64 附加, 整32 子起点, 整32 子终点) -> 节点 {
    节点 n;
    n.类型 = 类型;
    n.文本 = 文本;
    n.附加 = 附加;
    n.子起点 = 子起点;
    n.子终点 = 子终点;
    n.行 = 0;   // 103-a（D2）：行号默认 0（语句根由 解析块 单点回填）
    返回 n;
}

// 103-a（D2）：当前 token 行号（0=越界防御）——语句行回填/诊断行来源
函数 当前行(向量<Token> 记号, 整64 位置) -> 整32 {
    如果 (位置 < 0 || 位置 >= 记号.大小()) { 返回 0; }
    返回 记号.元素(位置).行;
}

函数 当前类型(向量<Token> 记号, 整64 位置) -> 整32 {
    如果 (位置 >= 记号.大小()) { 返回 令牌_文件结束; }
    Token 当前 = 记号.元素(位置);
    返回 整32(当前.类型);
}

函数 当前ID(向量<Token> 记号, 整64 位置) -> 整32 {
    如果 (位置 >= 记号.大小()) { 返回 0; }
    Token 当前 = 记号.元素(位置);
    返回 整32(当前.文本);
}

// A2（2026-09-11 方案甲）：返回 字符串->字符*——驻留表指针=借用视图零拷贝
//   （调用方比较/拼接/查表即时消费；持有须 字符串复制(当前文本(...)) 落堆）。
函数 当前文本(向量<Token> 记号, 整64 位置) -> 字符* {
    返回 驻留文本(整64(当前ID(记号, 位置)));
}

函数 是关键(向量<Token> 记号, 整64 位置, 字符串 关键字) -> 布尔 {
    返回 当前类型(记号, 位置) == 令牌_关键字 && 当前ID(记号, 位置) == 整32(驻留(关键字));
}

// 取走本文件导入项表（项名 -> 限定名；消费后清空）——plans/018 第 3 层：
//   语义分桶后 ② 显式导入绑定需按文件对齐（此前仅解析期 B1 改写消费，
//   静态表在下一文件解析时被清空重登记——语义阶段拿不到），主.cn 每文件
//   解析后快照，语义层据此构建 三级解析 导入目标表（E0255 检查同源）。
函数 取走导入项们() -> 映射<整64, 整64> {
    映射<整64, 整64> 表 = 导入项们;
    导入项们 = 映射<整64, 整64>();
    返回 表;
}

// ==================== 导入扫描与模块登记（P6h 多源文件） ====================
// 簇②根治·B1（2026-09-04 用户裁决：导入项登记+裸名改写）：`导入 路径::项` 的
//   项名 -> 限定名 映射（打开文件 -> 文件::打开文件）。语义层此前对导入语句
//   零登记——裸名 打开文件(...) 调用查表失败（冒烟簇② 4 错：标识符+函数双报）。
//   调用形成时（解析后缀链 '(' 分支）池尾被调标识符命中本表 → 原地改写合成
//   限定名（第五波 IO::/文件:: 机制同构复用），语义白名单/IR 符号映射零改动。
//   文件作用域：扫描导入 入口清空（加载器每文件先 扫描导入 后 解析程序——
//   跨文件残留会让未导入文件裸调也被改写，违反规范 08 导入项绑定本文件）。
//   诚实边界：通配符 导入 路径::* 不登记（全项展开需 stdlib 符号清单，v2 组件
//   未用此形态）；同名项多来源先到先得（设置 不覆盖——首登记胜出）。
静态 映射<整64, 整64> 导入项们;

函数 导入项登记(整64 项名ID, 整64 限定名ID) -> 空类型 {
    结果<整64, 整32> 已有 = 导入项们.获取(项名ID);
    如果 (已有.正常) { 返回; }
    结果<空类型, 整32> 加项 = 导入项们.设置(项名ID, 限定名ID);
    如果 (!加项.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加平名 = 导入项平铺名们.追加(项名ID);
    如果 (!加平名.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加平限 = 导入项平铺限定们.追加(限定名ID);
    如果 (!加平限.正常) { 运行时错误(4); }
}

// P6h：多文件下 变量结构体表 跨文件保留（字段偏移推导须看到全部结构体声明），
//   清空 由加载器在每次编译任务开始前显式调用（原先 解析程序 内清空 已移除）
函数 清空变量结构体表() -> 空类型 {
    变量结构体表.清空();
}

// P7b：清空变量容器表（与 清空变量结构体表 同位调用——加载器任务开始前）
函数 清空变量容器表() -> 空类型 {
    变量容器表.清空();
}

// 94-a（2026-09-13 第九十四轮）：数组元素结构体表——数组变量名ID -> 元素结构体键基ID。
//   消费点：①语法层 解析成员后缀（成员链 `表[0].x` 对象=下标表达式的字段偏移标注）；
//   ②IR 层 解析成员链结构体ID（对象类型推导：偏移/宽度/类型码三元组）。
//   元素非结构体（标量/字符串/容器）不入表（查询 miss 返回 -1=维持既有兜底路径）。
//   与 变量结构体表/变量容器表 同层同纪律：解析期登记（数组声明点），多文件窗口
//   保留（清空 由加载器任务开始前调用——与既有两表同位）。
静态 映射<整64, 整64> 数组元素结构体表;

函数 登记数组元素结构体94(整64 名ID, 整64 结构体键) -> 空类型 {
    结果<空类型, 整32> 设94 = 数组元素结构体表.设置(名ID, 结构体键);
    如果 (!设94.正常) { 运行时错误(4); }
}

// 查数组元素结构体键（-1=未命中/非结构体元素）
函数 查数组元素结构体键94(整64 名ID) -> 整64 {
    结果<整64, 整32> 查94 = 数组元素结构体表.获取(名ID);
    如果 (查94.正常) { 返回 查94.值; }
    返回 0 - 1;
}

函数 清空数组元素结构体表94() -> 空类型 {
    数组元素结构体表.清空();
}

// P7b：查变量容器类型（IR 层成员访问/方法调用经此查对象类型；0=非容器/结果变量）
函数 查容器类型(整64 名ID) -> 整64 {
    结果<整64, 整32> 查 = 变量容器表.获取(名ID);
    如果 (查.正常) { 返回 查.值; }
    返回 0;
}

// ②b B5：查变量结构体类型（IR 层成员访问宽度解析用；0=非结构体变量。
//   值=1 是结构体名标记（解析结构体声明 登记），非对象类型——过滤）
// 查结构体类型（plans/018 类型分桶三级版）：类型文本ID -> 结构体键基ID（0=非结构体）。
//   ① 直查（幂等：已键基的变量映射值/主模块标记命中）＞ ② 本模块键基标记
//   （解析结构体声明 登记键=键基域）＞ ③ 限定文本（"甲::记录"）拆分直查。
//   消费点：变量/参数/静态声明的结构体登记（值域=键基）、IR 层 解析对象结构体ID。
函数 查结构体类型(整64 名ID) -> 整64 {
    结果<整64, 整32> 查 = 变量结构体表.获取(名ID);
    如果 (查.正常) {
        如果 (查.值 != 1) { 返回 查.值; }
    }
    整64 键基t = 键基合成(取当前模块路径(), 名ID);
    结果<整64, 整32> 查键 = 变量结构体表.获取(键基t);
    如果 (查键.正常) { 返回 键基t; }
    字符串 文本q = 字符串复制(驻留文本(名ID));
    字符串 模块q = "";
    字符串 符号q = "";
    如果 (拆限定名(文本q, 模块q, 符号q) == 1) {
        如果 (是标准库模块名(模块q)) { 返回 0; }
        整64 键基q = 键基合成(模块q, 驻留(符号q));
        结果<整64, 整32> 查限 = 变量结构体表.获取(键基q);
        如果 (查限.正常) { 返回 键基q; }
    }
    返回 0;
}

// ==================== 跨子模块访问函数（千行拆分，2026-09-08） ====================
//   解析表达式/解析语句/语义检查 子模块经下列函数访问解析期登记表
//   （静态表=文件级私有，跨文件仅函数可见；查询未命中返回 -1 哨兵）
函数 查导入项绑定(整64 项名ID) -> 整64 {
    结果<整64, 整32> 查 = 导入项们.获取(项名ID);
    如果 (查.正常) { 返回 查.值; }
    返回 0 - 1;
}

函数 登记变量结构体(整64 名ID, 整64 结构体键) -> 空类型 {
    结果<空类型, 整32> 设 = 变量结构体表.设置(名ID, 结构体键);
    如果 (!设.正常) { 运行时错误(4); }
}

函数 查变量结构体键(整64 名ID) -> 整64 {
    结果<整64, 整32> 查 = 变量结构体表.获取(名ID);
    如果 (查.正常) { 返回 查.值; }
    返回 0 - 1;
}

函数 登记变量容器(整64 名ID, 整64 合成名ID) -> 空类型 {
    结果<空类型, 整32> 设 = 变量容器表.设置(名ID, 合成名ID);
    如果 (!设.正常) { 运行时错误(4); }
}

函数 清空导入项们() -> 空类型 {
    导入项们.清空();
}

// 登记导入项（项名ID -> 限定名ID；首登记胜出，不覆盖）
// plans/018 第 3 层：同步平铺向量（语义层需按文件枚举导入项——映射无枚举
//   接口；平铺与映射同窗口登记/清空，权威登记点=解析程序 入口，时序纪律一致）
静态 向量<整64> 导入项平铺名们;
静态 向量<整64> 导入项平铺限定们;

// 取走本文件导入项平铺表（交替 [项名0, 限定名0, 项名1, ...]；消费后清空）
//   主.cn 每文件解析后快照，语义层据此构建 ② 显式导入目标表（E0255 同源）
函数 取走导入项平铺() -> 向量<整64> {
    向量<整64> 平铺 = 向量<整64>();
    整64 i = 0;
    当 (i < 导入项平铺名们.大小()) {
        结果<空类型, 整32> 加名 = 平铺.追加(导入项平铺名们.元素(i));
        如果 (!加名.正常) { 运行时错误(4); }
        结果<空类型, 整32> 加限 = 平铺.追加(导入项平铺限定们.元素(i));
        如果 (!加限.正常) { 运行时错误(4); }
        i++;
    }
    导入项平铺名们 = 向量<整64>();
    导入项平铺限定们 = 向量<整64>();
    返回 平铺;
}

函数 清空导入项平铺() -> 空类型 {
    导入项平铺名们 = 向量<整64>();
    导入项平铺限定们 = 向量<整64>();
}
