// CN 自举编译器 v2 · 接口声明解析（413·2026-10-11 接口语法族 v2 面补齐）
// 语法依据：cn-language-spec 06-六 接口定义与实现、plans/001 §接口。
// 职责：接口 声明的解析与接口表登记（接口名/方法签名/全局槽位）——自 解析类.cn
//   拆出（单一职责·解析类.cn 行数警戒线纪律）。类实现接口（解析类继承登记）
//   与接口区布局仍在 解析类.cn（类声明解析域）。
导入 容器::向量;
导入 词法;     // Token/当前ID 等
导入 IR;       // 节点_*/接口表登记族/语法错误
导入 协议常量;   // 335：协议常量独立包
导入 IO;       // 解析诊断输出

公开:

// ==================== 413：接口声明解析（2026-10-11 接口语法族） ====================
// 接口声明：接口 名 { [虚拟|重写] 函数 名(参数...) [-> 返回类型] ; }（规格书
//   06-六·接口只含虚函数签名无实现体·1870 起签名后分号强制——001 §5.9.6）。方法签名 token 级采集（**零池副作用**——
//   接口方法无节点形态，参数不建节点防池区间错位）；登记 接口表（接口名/方法
//   签名/全局槽位——解析期跨文件保留，与类布局登记同时机）。产出 节点_接口声明
//   （文本=接口名ID·无子区间——语义收集期注册类型符号消费）。
// 诚实边界：接口方法不支持默认参数/运算符/静态成员（形态命中即诊断——宿主
//   parseInterfaceDecl 宽松解析「虚拟 或 重写 前缀（允许裸 函数）」同构放行）。
// 采集一个参数的类型文本（含 * & 后缀——函数参数串 同格式；逗号/右括号止）。
//   返回空串=非类型形态（调用方诊断）。位置出参推进。
不安全 函数 采集接口参数类型文本(向量<Token> 记号, 整64* 位置) -> 字符串 {
    字符串 类型文本k = 解析类型文本(记号, 位置, 假);
    如果 (字符串长度(类型文本k) == 0) { 返回 ""; }
    当 (当前类型(记号, 位置[0]) == 令牌_运算符 &&
         当前ID(记号, 位置[0]) == ID_星号) {
        类型文本k = 类型文本k + "*";
        位置[0] = 位置[0] + 1;
    }
    如果 (当前类型(记号, 位置[0]) == 令牌_运算符 &&
         当前ID(记号, 位置[0]) == ID_与号) {
        类型文本k = 类型文本k + "&";
        位置[0] = 位置[0] + 1;
    }
    返回 类型文本k;
}

// 接口方法签名采集：[虚拟|重写] 函数 名(参数...) [-> 返回类型] ;——签名入
//   接口表+分配全局槽（1870 起签名尾分号强制·缺失=显式诊断）。返回推进后位置。
不安全 函数 解析接口方法签名(向量<Token> 记号, 整64 位置, 整64 接口IDk) -> 整64 {
    位置 += 2;   // 消费 函数 + 方法名（调用方已保证两 token 合法）
    整32 方法名IDk = 当前ID(记号, 位置 - 1);
    布尔 有左括号接口1031 = 假;
    如果 (当前类型(记号, 位置) == 令牌_运算符 &&
         当前ID(记号, 位置) == ID_左圆括号) { 位置++; 有左括号接口1031 = 真; }
    否则 {
        // 1031（参数表全缺形态·Z3 实录·对齐宿主明确化）：接口方法声明缺参数表
        //   '('——宿主「预期 '('，实际为 'X'」拒绝（原落下方采集空段碰巧拒·
        //   诊断面「接口方法参数预期类型」误导）。诊断=公共函数（三消费点共用）。
        参数表左括号缺失诊断(记号, 位置, "接口方法");
    }
    字符串 参数串k = "";
    如果 (!(当前类型(记号, 位置) == 令牌_运算符 &&
           当前ID(记号, 位置) == ID_右圆括号)) {
        当 (真) {
            字符串 段k = 采集接口参数类型文本(记号, &位置);
            如果 (字符串长度(段k) == 0) {
                IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                               ": 接口方法参数预期类型\n");
                语法错误加一();
                中断;
            }
            // 参数名（类型后标识符——签名面只留类型文本）
            如果 (当前类型(记号, 位置) == 令牌_标识符) { 位置++; }
            否则 {
                // 1031（无名参数族·接口面 Z1 实录）：类型后缺参数名——宿主
                //   「预期参数名」拒绝（原实现静默跳过名字消费放行）。
                IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                               ": 预期参数名（接口方法参数类型后缺名称）\n");
                语法错误加一();
            }
            如果 (字符串长度(参数串k) > 0) {
                参数串k = 参数串k + "," + 段k;
            } 否则 {
                参数串k = 字符串复制(段k);
            }
            如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == ID_逗号) {
                位置++;
                继续;
            }
            中断;
        }
    }
    如果 (当前类型(记号, 位置) == 令牌_运算符 &&
         当前ID(记号, 位置) == ID_右圆括号) { 位置++; }
    否则 如果 (有左括号接口1031) {
        // 1031（接口方法参数表收口·Z2 实录）：')' 缺失显式诊断（原实现静默漂走
        //   把 `函数 叫(整32 甲 -> 整32;` 当合法签名放行）。
        参数表收口诊断(记号, 位置, "接口方法参数表");
    }
    整64 返回类型IDk = 整64(ID_空类型);
    如果 (当前类型(记号, 位置) == 令牌_运算符 &&
         当前ID(记号, 位置) == ID_箭头) {
        位置++;
        整64 类型位置k = 位置;
        字符串 返回文本k = 解析类型文本(记号, &类型位置k, 假);
        如果 (字符串长度(返回文本k) > 0) {
            位置 = 类型位置k;
            当 (当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == ID_星号) {
                返回文本k = 返回文本k + "*";
                位置++;
            }
            如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == ID_与号) {
                返回文本k = 返回文本k + "&";
                位置++;
            }
        } 否则 {
            IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                           ": 接口方法返回类型预期类型名\n");
            语法错误加一();
        }
        返回类型IDk = 整64(驻留(返回文本k));
    }
    // 1870（1866 同族·001 §5.9.6 分号模型扩接口面·宿主 parseInterfaceDecl 同点
    //   同串）：方法签名后强制分号终结（原宽松消费=跨签名静默粘连缺口——
    //   `虚拟 函数 画() -> 空类型` 直撞下一 `函数 无关()` 被粘连解析成两个
    //   方法·词法层换行已丢 token 流不可区分缺分号粘连）。诊断后不消费当前
    //   记号（调用方循环头正常续解·一次解析报全量缺分号位置）。
    如果 (当前类型(记号, 位置) == 令牌_运算符 &&
         当前ID(记号, 位置) == ID_分号) { 位置++; }
    否则 {
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                       ": 接口方法签名缺少分号 ';'\n");
        语法错误加一();
    }
    登记接口方法(接口IDk, 整64(方法名IDk), 返回类型IDk, 参数串k);
    返回 位置;
}

// 接口声明解析（顶层 dispatch 接口分支消费）：接口 名 { 方法签名... }
不安全 函数 解析接口声明(向量<Token> 记号, 整64 位置, 向量<节点> 池) -> 整64 {
    位置++;   // 消费 接口
    如果 (当前类型(记号, 位置) != 令牌_标识符) {
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                       ": 接口声明缺少名称\n");
        语法错误加一();
        返回 位置;
    }
    整32 接口名IDk = 当前ID(记号, 位置);
    位置++;
    登记接口名(整64(接口名IDk));
    如果 (当前类型(记号, 位置) == 令牌_运算符 &&
         当前ID(记号, 位置) == ID_左花括号) { 位置++; }
    否则 {
        // 1031（定界符缺失族·V2 实录·对齐宿主）：接口声明体缺 '{'——宿主
        //   「预期 '{'，实际为 'X'」拒绝（原实现静默跳过·接口体从方法签名
        //   token 起错位解析整段吞掉·V2 实录放行）。
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                       ": 预期 '{'（接口声明须带成员体）\n");
        语法错误加一();
    }
    当 (真) {
        如果 (当前类型(记号, 位置) == 令牌_文件结束) { 中断; }
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == ID_右花括号) { 位置++; 中断; }
        // 成员形态：[虚拟|重写] 函数 签名（宿主宽松解析允许裸 函数 同构；
        //   分号宽松消费）
        整64 前位置k = 位置;
        如果 (是词(记号, 位置, "虚拟") || 是词(记号, 位置, "重写")) {
            位置++;
        }
        // 1750（001 §2.1a）：接口方法名位保留字占用——标识符型关键字（21 词）
        //   与词法关键字（25 词）同拒（宿主 parser_oop 接口方法名位同串诊断）。
        布尔 是接口名位k = 假;
        如果 (位置 + 1 < 记号.大小()) {
            是接口名位k = 当前类型(记号, 位置 + 1) == 令牌_标识符 ||
                          当前类型(记号, 位置 + 1) == 令牌_关键字;
        }
        如果 (是关键(记号, 位置, "函数") &&
             位置 + 1 < 记号.大小() && 是接口名位k) {
            拒名位保留字(记号, 位置 + 1, "接口方法名");
            位置 = 解析接口方法签名(记号, 位置, 整64(接口名IDk));
        } 否则 {
            IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                           ": 接口体预期方法签名（[虚拟] 函数 名(...) -> 类型）\n");
            语法错误加一();
            位置 = 跳过一个类成员(记号, 位置);
        }
        // 1870：此处分号消费仅服务非法形态分支（「接口体预期方法签名」→
        //   跳过一个类成员）的错误恢复——合法签名分号已在 解析接口方法签名
        //   内强制消费（缺分号=显式诊断·不消费当前记号）。
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == ID_分号) { 位置++; }
        如果 (位置 <= 前位置k) { 位置 = 前位置k + 1; }   // 保底推进（防死循环）
    }
    池追加(池, 建节点(节点_接口声明, 接口名IDk, 0, 0, 0));
    返回 位置;
}
