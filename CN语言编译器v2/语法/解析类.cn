// CN 自举编译器 v2 · 类声明解析（第七十八轮，2026-09-12）
// 语法依据：cn-language-spec 06 面向对象、plans/001 §类。节点形态见 IR常量.cn
//   「节点_类/节点_方法」区。
// 第一版范围（诚实边界，探针 D 缺口专项）：类声明（字段/方法/构造/析构）。
//   继承/虚函数/接口/泛型类/静态成员/常量成员/运算符重载/访问控制强制——
//   显式语法诊断（语法错误加一 = 中止通道；未覆盖形态显式拒绝，绝不静默降级）。
// 布局登记与结构体完全同族（登记结构体布局/字段类型/字段偏移/容器字段——字段
//   访问/对象大小/宽度/RAII 全链复用）；类名另登 IR类 类表（是用户类判定）。
// 类区间协议：节点_类.子区间 [子起点,子终点) = 类体（字段节点+方法节点+方法体
//   内部节点）；方法节点类归属经遍历上下文传入（与结构体字段同款）。
导入 容器::向量;
导入 映射集合;
导入 词法;     // Token/当前ID 等
导入 IR;       // 节点_*/键位移/布局登记族/类表/容器类判定
导入 IO;       // 349-a：解析诊断输出（打印到错误）

公开:

// 方法声明体解析：名(参数) [-> 返回类型] { 体 }（调用方已消费 函数/不安全 前缀
//   并取得方法名ID）。与 解析函数声明 同构（返回类型 类型文本/裸名 两形态 +
//   &/* 后缀复刻），产出 节点_方法（附加=返回类型ID；0=构造/析构，语义层归
//   空类型）。无 overload：同名方法唯一（第一版限制，采集层诊断）。
函数 解析方法体(向量<Token> 记号, 整64 位置, 向量<节点> 池,
                 映射<整64, 整64>& 字段偏移表, 整32 方法名ID,
                 整32 修饰) -> 整64 {
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("("))) { 位置++; }
    整64 参数起点 = 池.大小();
    如果 (!(当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(")")))) {
        当 (真) {
            位置 = 解析参数(记号, 位置, 池);
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(","))) { 位置++; 继续; }
            中断;
        }
    }
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(")"))) { 位置++; }
    整32 返回类型ID = 0;
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("->"))) {
        位置++;
        整64 类型位置 = 位置;
        字符串 返回类型名 = 解析类型文本(记号, &类型位置, 假);
        如果 (字符串长度(返回类型名) > 0) {
            位置 = 类型位置;
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("&"))) {
                返回类型名 = 返回类型名 + "&";
                位置++;
            }
            当 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("*"))) {
                返回类型名 = 返回类型名 + "*";
                位置++;
            }
            返回类型ID = 整32(驻留(返回类型名));
        } 否则 {
            返回类型ID = 当前ID(记号, 位置);
            位置++;
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("&"))) { 位置++; }
            当 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("*"))) {
                返回类型ID = 整32(驻留(驻留文本(整64(返回类型ID)) + "*"));
                位置++;
            }
        }
    }
    位置 = 解析块(记号, 位置, 池, 字段偏移表);
    整32 块索引 = 整32(池.大小()) - 1;
    节点 新方法 = 建节点(节点_方法, 方法名ID, 整64(返回类型ID), 整32(参数起点), 块索引);
    新方法.修饰 = 修饰;   // 156-a：类方法修饰回填（语义层 读取豁免）
    池追加(池, 新方法);
    返回 位置;
}

// 类字段声明解析：类型 名 [';']——布局登记与结构体字段完全同族（偏移推进/对齐/
//   字段类型/字段偏移分桶/容器字段 五登记）。字段节点复用 节点_参数（文本=字段名
//   ID，附加=类型节点索引）。返回位置=字段后（分号由调用方宽松消费）。
//   不安全：布局状态经 整64* 出参（偏移/对齐/最大字段）读写——与 类型大小与对齐
//   同款的裸指针写面（安全区边界观察期口径）。
不安全 函数 解析类字段(向量<Token> 记号, 整64 位置, 向量<节点> 池, 整64 类键基,
                 映射<整64, 整64>& 字段偏移表,
                 整64* 字段偏移, 整64* 最大对齐, 整64* 最大字段, 整64 段可见性) -> 整64 {
    整64 类型节点 = 池.大小();
    位置 = 解析类型(记号, 位置, 池);
    如果 (!(当前类型(记号, 位置) == 令牌_标识符)) {
        IO::打印到错误("[parse] 类字段声明缺少字段名（位置=" +
                       整数转字符串(位置) + "）\n");
        语法错误加一();
        返回 位置;
    }
    整64 字段大小 = 8;
    整64 字段对齐 = 8;
    节点 类型节点值 = 池.元素(整32(类型节点));
    类型大小与对齐(驻留文本(整64(类型节点值.文本)), &字段大小, &字段对齐);
    整64 余 = 字段偏移[0] % 字段对齐;
    如果 (余 != 0) { 字段偏移[0] = 字段偏移[0] + (字段对齐 - 余); }
    整64 分桶键 = 类键基 * 键位移 + 整64(当前ID(记号, 位置));
    结果<空类型, 整32> 加表 = 字段偏移表.设置(分桶键, 字段偏移[0]);
    如果 (!加表.正常) { 运行时错误(4); }
    登记字段类型(分桶键, 整64(类型节点值.文本));
    字符串 字段类型文本 = 字符串复制(驻留文本(整64(类型节点值.文本)));
    // 84-c：类别判定（容器 1 / 字符串 0）——嵌套结构体类别经实测回退（见语法分析.cn 注）
    整64 类资源类别f = 0 - 1;
    如果 (是容器类(字段类型文本)) {
        类资源类别f = 1;
    } 否则 如果 (字符串比较(字段类型文本, "字符串")) {
        类资源类别f = 0;
    }
    如果 (类资源类别f >= 0) {
        登记资源字段(类键基, 整64(当前ID(记号, 位置)), 整64(类型节点值.文本),
                    字段偏移[0], 类资源类别f == 1, 类资源类别f);
    }
    登记字段偏移(分桶键, 字段偏移[0]);
    如果 (字段对齐 > 最大对齐[0]) { 最大对齐[0] = 字段对齐; }
    如果 (字段大小 > 最大字段[0]) { 最大字段[0] = 字段大小; }
    字段偏移[0] = 字段偏移[0] + 字段大小;
    // 340-a（347）：子起点=段可见性（解析期空闲位回填·语义层可见性设防消费）
    池追加(池, 建节点(节点_类字段, 当前ID(记号, 位置), 整64(类型节点), 整32(段可见性), 0));
    返回 位置 + 1;
}

// 跳过一整个类成员（不支持形态诊断后的恢复）：到成员终结 ';' 或配对 '{...}'
//   之后；类体 '}' 保持未消费（交类体循环）。防诊断路径死循环/吞类尾。
函数 跳过一个类成员(向量<Token> 记号, 整64 位置) -> 整64 {
    当 (位置 < 记号.大小()) {
        如果 (当前类型(记号, 位置) == 令牌_文件结束) { 返回 位置; }
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留(";"))) { 返回 位置 + 1; }
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留("}"))) { 返回 位置; }
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留("{"))) {
            整64 深 = 1;
            位置++;
            当 (位置 < 记号.大小()) {
                如果 (当前类型(记号, 位置) == 令牌_文件结束) { 返回 位置; }
                如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留("{"))) { 深++; }
                如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留("}"))) {
                    深--;
                    整64 后 = 位置 + 1;
                    如果 (深 == 0) { 返回 后; }
                }
                位置++;
            }
            返回 位置;
        }
        位置++;
    }
    返回 位置;
}

// 当前 token 是否不支持的类成员修饰（第一版边界——诊断恢复用）
函数 是不支持类修饰(向量<Token> 记号, 整64 位置) -> 布尔 {
    如果 (是词(记号, 位置, "静态") || 是词(记号, 位置, "常量") ||
        是关键(记号, 位置, "虚拟") || 是关键(记号, 位置, "重写") ||
        是关键(记号, 位置, "抽象") || 是关键(记号, 位置, "友元") ||
        是关键(记号, 位置, "泛型") || 是关键(记号, 位置, "运算符")) {
        返回 真;
    }
    返回 假;
}

// 414-a（D42 甲案波 1）：泛型类声明解析——泛型 <类型 K[, 类型 V[: 约束]]...> 类 名 { 体 }
//   （规范 06-十三·stdlib 容器.cn/映射集合.cn 实际形态）。类型参数表解析消费+逐参
//   登记 泛型参数名们（驻留ID 平铺·语义层豁免消费）；类体经 解析类声明 照常解析
//   （节点_类·基名——实例化单态化=波2）。约束（: 接口名）解析消费不校验（波1 边界·
//   收工回填登记）。泛型 函数 声明=显式诊断不支持（后续轮——绝不静默吞）。
函数 解析泛型类声明(向量<Token> 记号, 整64 位置, 向量<节点> 池,
                  映射<整64, 整64>& 字段偏移表, 整64 是否公开) -> 整64 {
    位置++;   // 消费 泛型
    如果 (!(当前类型(记号, 位置) == 令牌_运算符 &&
           当前ID(记号, 位置) == 整32(驻留("<")))) {
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 泛型 预期 '<'\n");
        语法错误加一();
        返回 位置;
    }
    位置++;
    字符串 参数序串g = "";   // 416-a：基类参数名序（"T,U"·实例化替换序权威）
    当 (真) {
        如果 (当前类型(记号, 位置) == 令牌_文件结束) {
            IO::打印到错误("[parse] 泛型类型参数表未闭合（缺 '>'）\n");
            语法错误加一();
            返回 位置;
        }
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留(">"))) { 位置++; 中断; }
        如果 (!是词(记号, 位置, "类型")) {
            IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 泛型类型参数预期 '类型' 标记\n");
            语法错误加一();
            返回 位置;
        }
        位置++;
        如果 (当前类型(记号, 位置) != 令牌_标识符) {
            IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 泛型类型参数预期名称\n");
            语法错误加一();
            返回 位置;
        }
        登记泛型参数名(整64(当前ID(记号, 位置)));
        // 416-a（D42 波 2）：基类参数序串同步拼装（"T,U"——实例化注册 按序替换）
        如果 (字符串长度(参数序串g) > 0) {
            参数序串g = 字符串复制(参数序串g + "," + 当前文本(记号, 位置));
        } 否则 {
            参数序串g = 字符串复制(当前文本(记号, 位置));
        }
        位置++;
        // 接口约束：类型 T : 接口名（消费不校验——波1 边界）
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留(":"))) {
            位置++;
            如果 (当前类型(记号, 位置) == 令牌_标识符) { 位置++; }
        }
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留(","))) { 位置++; }
    }
    如果 (是关键(记号, 位置, "函数")) {
        // 417-a（D42 波 3）：泛型函数声明——泛型 <类型 T> 函数 名(参数...) {...}
        //   （stdlib 容器/映射集合 线性表辅助·规范 06-十三 函数分支）。函数节点
        //   照常产出（节点_函数·基名）；参数序登记共用 泛型基类参数序们（函数名
        //   ID 键·单态化=克隆器函数版）。实例化调用点=名<实参>(...)（417-a 调用侧）。
        位置++;
        // 函数名在 位置（消费 函数 后）——登记参数序须在函数体解析后（与类同序防御）
        整64 函名IDg = 0;
        如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_标识符) {
            函名IDg = 整64(当前ID(记号, 位置));
        }
        整64 结果位置f = 解析函数声明(记号, 位置, 池, 字段偏移表, 0);
        如果 (函名IDg != 0 && 字符串长度(参数序串g) > 0) {
            登记泛型基类参数序(函名IDg, 参数序串g);
        }
        返回 结果位置f;
    }
    如果 (!是关键(记号, 位置, "类")) {
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 泛型声明后预期 类 或 函数\n");
        语法错误加一();
        返回 位置;
    }
    // 416-a（D42 波 2）：基类参数序登记——次序在 解析类声明 后（其内部登记
    //   用户类基名·登记泛型基类参数序 有类表存在防御）。
    整64 基名IDg = 0;
    如果 (位置 + 1 < 记号.大小() && 当前类型(记号, 位置 + 1) == 令牌_标识符) {
        基名IDg = 整64(当前ID(记号, 位置 + 1));
    }
    整64 结果位置g = 解析类声明(记号, 位置, 池, 字段偏移表, 是否公开);
    如果 (基名IDg != 0 && 字符串长度(参数序串g) > 0) {
        登记泛型基类参数序(基名IDg, 参数序串g);
    }
    返回 结果位置g;
}

// 解析类声明：类 名 [ : 父类 ] { 类体 } —— 第一版无继承（显式诊断）。
// 后续兼容位（诚实边界）：访问标签 公开:/私有:/保护: 解析消费但不强制访问控制；
//   方法重载不支持（同名方法唯一——重复登记诊断）。
// 类体成员循环不推进时强制前进一 token（防诊断路径死循环）。
// 537-a（§2.115 方案实施·纯机械拆分零行为变更·2026-09-21）：解析类继承/接口
//   列表跳过——显式诊断（v2 暂不支持）+跳过到类体 {（绝不静默忽略）。
不安全 函数 解析类继承跳过(向量<Token> 记号, 整64 位置, 整64 类名ID) -> 整64 {
    // 继承/接口列表：第一版不支持——显式诊断 + 跳过到类体 '{'（绝不静默忽略）
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(":"))) {
        IO::打印到错误("[parse] v2 暂不支持类继承/接口实现（类 " +
                       驻留文本(整64(类名ID)) + "）\n");
        语法错误加一();
        当 (位置 < 记号.大小()) {
            如果 (当前类型(记号, 位置) == 令牌_文件结束) { 中断; }
            如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == 整32(驻留("{"))) { 中断; }
            位置++;
        }
    }
    返回 位置;
}

// 537-a（§2.115 方案实施·纯机械拆分零行为变更）：解析类布局收口——尾部对齐+
//   布局/变量/用户类三登记+425-a 探针（原块逐字迁移）。返回收口后的位置。
不安全 函数 解析类布局收口(向量<节点> 池, 整32 类名ID, 整64 类键基, 整64 类体起点,
                        整64 字段偏移, 整64 最大对齐, 整64 是否公开, 整64 位置) -> 整64 {
    // 布局收口：尾部对齐到 最大对齐（同结构体，对齐宿主 computeClassLayout
    //   无虚函数类口径：偏移自 0 起、自然对齐——有虚函数类宿主首 8 字节为
    //   虚表指针，第一版不支持虚函数=无 vtable 首槽）
    整64 尾余 = 字段偏移 % 最大对齐;
    如果 (尾余 != 0) { 字段偏移 = 字段偏移 + (最大对齐 - 尾余); }
    登记结构体布局(整64(类名ID), 字段偏移, 最大对齐, 是否公开);
    登记变量结构体(类键基, 1);
    登记用户类(整64(类名ID));
    // 425-a 探针：登记后立即查（表实例同一性·登记/查询同函数域应必真）
    如果 (!是用户类ID(整64(类名ID))) {
        IO::打印到错误("[探针] 登记后立即查失败（同域）: " + 驻留文本(整64(类名ID)) + "\n");
    }
    池追加(池, 建节点(节点_类, 类名ID, 0, 整32(类体起点), 整32(池.大小())));
    返回 位置;
}
函数 解析类声明(向量<Token> 记号, 整64 位置, 向量<节点> 池,
                 映射<整64, 整64>& 字段偏移表, 整64 是否公开) -> 整64 {
    如果 (是关键(记号, 位置, "类")) { 位置++; }
    整32 类名ID = 当前ID(记号, 位置);
    位置++;
    整64 类键基 = 键基合成(取当前模块路径(), 整64(类名ID));
    位置 = 解析类继承跳过(记号, 位置, 类名ID);
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("{"))) { 位置++; }
    整64 类体起点 = 池.大小() + 1;
    整64 字段偏移 = 0;
    整64 最大对齐 = 1;
    整64 最大字段 = 0;
    // 340-a（D38 批3b·347）：类体段可见性——显式 私有:/保护:=0、公开:=1；
    //   缺省 1=公开（维持存量语义·宿主类缺省私有的收紧随宿主对齐轮）
    整64 段可见性 = 1;
    当 (真) {
        如果 (当前类型(记号, 位置) == 令牌_文件结束) { 中断; }
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留("}"))) { 位置++; 中断; }
        整64 前位置 = 位置;
        // 访问标签段：公开: / 私有: / 保护:（第一版解析消费，不强制访问控制）
        如果 ((是词(记号, 位置, "公开") || 是词(记号, 位置, "私有") ||
              是关键(记号, 位置, "保护")) &&
             位置 + 1 < 记号.大小() &&
             当前类型(记号, 位置 + 1) == 令牌_运算符 &&
             当前ID(记号, 位置 + 1) == 整32(驻留(":"))) {
            // 340-a（347）：段标记记录（公开=1/私有=0/保护=0 同私有无继承独立语义）
            如果 (是词(记号, 位置, "公开")) { 段可见性 = 1; } 否则 { 段可见性 = 0; }
            位置 += 2;
        } 否则 如果 (是关键(记号, 位置, "不安全") && 位置 + 1 < 记号.大小() &&
                     是关键(记号, 位置 + 1, "函数")) {
            位置++;
            位置++;
            // 414-a（D42 波1·stdlib 前置）：不安全 析构器形态（不安全 函数 ~名()
            //   ——容器.cn 实际形态）——原实现直接取标识符，遇 ~ 运算符 token
            //   名 ID 取错+位置错位→方法体解析中断（probe6/容器.cn 实测）。
            //   合成名 "~名" 对齐 函数 分支内析构器路径（宿主 类$~名 同构）。
            //   〔349-a merge 合成：~ 为运算符记号须先于运算符重载检测判析构器〕
            如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == 整32(驻留("~"))) {
                位置++;
                如果 (当前类型(记号, 位置) == 令牌_标识符) {
                    字符串 析构名u = "~" + 当前文本(记号, 位置);
                    整32 名IDdu = 整32(驻留(析构名u));
                    位置++;
                    位置 = 解析方法体(记号, 位置, 池, 字段偏移表, 名IDdu, 1);
                } 否则 {
                    IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                                   ": 析构器声明缺少方法名\n");
                    语法错误加一();
                }
            } 否则 {
                整32 名IDu = 当前ID(记号, 位置);
                位置++;
                // 349-a（T35 ①类根治）：运算符重载声明 `函数 运算符X(...)`——「运算符」关键字后
                //   紧随运算符记号，组合为函数名（宿主解析器同款）。原实现只取「运算符」为名、
                //   不消费记号 → 参数表解析从运算符记号开始失败 → 后续走进后缀解析遇 `->`
                //   触发硬错误 302（无诊断崩溃·探针 a4 单声明即崩／a3 普通方法名对照正常）。
                //   组合后本处显式诊断 + 语法错误加一 → 走既有「语法错误 N 个，中止编译」
                //   优雅拒绝通道（v2 暂不支持运算符重载·Rust 对照：解析成功 + 明确诊断·非 ICE）。
                如果 (当前类型(记号, 位置) == 令牌_运算符) {
                    字符* 记号文本O = 当前文本(记号, 位置);
                    如果 (字符串比较(记号文本O, "(") == 假) {
                        名IDu = 整32(驻留(驻留文本(整64(名IDu)) + 记号文本O));
                        位置++;
                        IO::打印到错误("[parse] v2 暂不支持运算符重载声明（类 " +
                                       记号文本O + "）\n");
                        语法错误加一();
                    }
                }
                位置 = 解析方法体(记号, 位置, 池, 字段偏移表, 名IDu, 1);
            }
        } 否则 如果 (是词(记号, 位置, "常量") && 位置 + 1 < 记号.大小() &&
                   (是关键(记号, 位置 + 1, "函数") ||
                    是关键(记号, 位置 + 1, "不安全"))) {
            // 414-a（D42 波1·stdlib 前置）：常量 成员函数两形态——常量 函数 名()
            //   （容器.cn 等 17 处）与 常量 不安全 函数 名()（映射集合.cn 194）。
            //   解析消费+零语义（this 常量性检查=宿主面·诚实边界登记；对齐
            //   访问标签「解析消费不强制」先例）。须先于 是不支持类修饰 检查
            //   （裸 常量 字段仍走修饰诊断路径）。
            位置++;   // 消费 常量
            整32 修饰不安全c = 0;
            如果 (是关键(记号, 位置, "不安全")) { 修饰不安全c = 1; 位置++; }
            如果 (!是关键(记号, 位置, "函数")) {
                IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                               ": 常量 成员预期 '函数'\n");
                语法错误加一();
            } 否则 {
                位置++;   // 消费 函数
                整32 名IDc = 当前ID(记号, 位置);
                位置++;
                位置 = 解析方法体(记号, 位置, 池, 字段偏移表, 名IDc, 修饰不安全c);
            }
        } 否则 如果 (是关键(记号, 位置, "函数")) {
            位置++;
            // 析构器形态：函数 ~名() { 体 }（~ 是运算符 token——须在取名前识别；
            //   合成名 "~名"，宿主 类$~名 符号对齐）
            如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == 整32(驻留("~"))) {
                位置++;
                如果 (当前类型(记号, 位置) == 令牌_标识符) {
                    字符串 析构名 = "~" + 当前文本(记号, 位置);
                    整32 名IDd = 整32(驻留(析构名));
                    位置++;
                    位置 = 解析方法体(记号, 位置, 池, 字段偏移表, 名IDd, 0);
                } 否则 {
                    IO::打印到错误("[parse] 析构器声明缺少方法名（类 " +
                                   驻留文本(整64(类名ID)) + "）\n");
                    语法错误加一();
                }
            } 否则 {
                整32 名IDm = 当前ID(记号, 位置);
                位置++;
                // 349-a（T35 ①类根治）：运算符重载声明 `函数 运算符X(...)`——「运算符」关键字后
                //   紧随运算符记号，组合为函数名（宿主解析器同款）。原实现只取「运算符」为名、
                //   不消费记号 → 参数表解析从运算符记号开始失败 → 后续走进后缀解析遇 `->`
                //   触发硬错误 302（无诊断崩溃·探针 a4 单声明即崩／a3 普通方法名对照正常）。
                //   组合后本处显式诊断 + 语法错误加一 → 走既有「语法错误 N 个，中止编译」
                //   优雅拒绝通道（v2 暂不支持运算符重载·Rust 对照：解析成功 + 明确诊断·非 ICE）。
                如果 (当前类型(记号, 位置) == 令牌_运算符) {
                    字符* 记号文本O = 当前文本(记号, 位置);
                    如果 (字符串比较(记号文本O, "(") == 假) {
                        名IDm = 整32(驻留(驻留文本(整64(名IDm)) + 记号文本O));
                        位置++;
                        IO::打印到错误("[parse] v2 暂不支持运算符重载声明（类 " +
                                       记号文本O + "）\n");
                        语法错误加一();
                    }
                }
                位置 = 解析方法体(记号, 位置, 池, 字段偏移表, 名IDm, 0);
            }
        } 否则 如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留("~"))) {
            // 析构器：函数 ~名() { 体 }——合成名 "~名"（宿主 类$~名 符号对齐）
            位置++;
            如果 (当前类型(记号, 位置) == 令牌_标识符) {
                字符串 析构名 = "~" + 当前文本(记号, 位置);
                整32 名IDd = 整32(驻留(析构名));
                位置++;
                位置 = 解析方法体(记号, 位置, 池, 字段偏移表, 名IDd, 0);
            } 否则 {
                IO::打印到错误("[parse] 析构器声明缺少方法名（类 " +
                               驻留文本(整64(类名ID)) + "）\n");
                语法错误加一();
            }
        } 否则 如果 (是不支持类修饰(记号, 位置)) {
            IO::打印到错误("[parse] v2 第一版不支持该类成员修饰（类 " +
                           驻留文本(整64(类名ID)) + "，位置=" +
                           整数转字符串(位置) + "）\n");
            语法错误加一();
            位置 = 跳过一个类成员(记号, 位置);
        } 否则 {
            位置 = 解析类字段(记号, 位置, 池, 类键基, 字段偏移表, &字段偏移,
                              &最大对齐, &最大字段, 段可见性);
        }
        // 字段/方法间分号宽松消费（与结构体同款）
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留(";"))) { 位置++; }
        如果 (位置 <= 前位置) { 位置 = 前位置 + 1; }   // 保底推进（防死循环）
    }
    位置 = 解析类布局收口(池, 类名ID, 类键基, 类体起点, 字段偏移, 最大对齐, 是否公开, 位置);
    返回 位置;
}
