            如果 (是词(记号, 位置, "公开")) { 段可见性 = 1; }
            否则 如果 (是词(记号, 位置, "保护")) { 段可见性 = 2; }
            否则 如果 (是词(记号, 位置, "私有")) { 段可见性 = 0; }
            段位1029 = 段修饰位1029(段可见性);
