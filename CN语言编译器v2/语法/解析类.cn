            位置++;
            如果 (是关键(记号, 位置, "函数")) {
                位置++;
                整32 名IDy = 当前ID(记号, 位置);
                位置++;
                布尔 有左括号友1031 = 假;
                如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留("("))) { 位置++; 有左括号友1031 = 真; }
                整64 参数起点y = 池.大小();
                如果 (!(当前类型(记号, 位置) == 令牌_运算符 &&
                       当前ID(记号, 位置) == 整32(驻留(")")))) {
                    当 (真) {
                        位置 = 解析参数(记号, 位置, 池);
                        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                             当前ID(记号, 位置) == 整32(驻留(","))) { 位置++; 继续; }
                        中断;
                    }
                }
                如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留(")"))) { 位置++; }
                否则 如果 (有左括号友1031) {
                    // 1031（友元函数参数表收口·同族延伸）：')' 缺失显式诊断
                    //   （Y1 实录——原实现静默漂走把缺括号友元声明当合法放行）。
                    参数表收口诊断(记号, 位置, "友元函数参数表");
                }
                整64 返回类型IDy = 0;
                如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留("->"))) {
                    位置++;
                    整64 类型位置y = 位置;
                    字符串 返回类型名y = 解析类型文本(记号, &类型位置y, 假);
                    如果 (字符串长度(返回类型名y) > 0) {
                        位置 = 类型位置y;
                        返回类型IDy = 整32(驻留(返回类型名y));
                    }
                }
                // 空块原型（592-a 形态·修饰位4=友元 值16——语义/补登判定）
                节点 空块y = 建节点(节点_块, 0, 0, 整32(池.大小()), 整32(池.大小()));
                池追加(池, 空块y);
                整32 空块索引y = 整32(池.大小()) - 1;
                节点 友元原型 = 建节点(节点_函数, 名IDy, 返回类型IDy,
                                      整32(参数起点y), 空块索引y);
                友元原型.修饰 = 整32(16 + 段位1029);
                池追加(池, 友元原型);
                登记友元授权(整64(类名ID), 整64(名IDy));
                如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留(";"))) { 位置++; }
            } 否则 {
                IO::打印到错误("[parse] 友元 后预期 '函数'（类 " +
                               驻留文本(整64(类名ID)) + "）\n");
                语法错误加一();
                位置 = 跳过一个类成员(记号, 位置);
            }
        } 否则 如果 (是词(记号, 位置, "静态")) {
            // 070 波G（1026 深度机）：静态 成员——静态 函数=静态方法（修饰位3=8·
            //   生成方法 跳 this 槽·调用分派直调）；静态 类型 名 [= 字面量]=
            //   类静态字段（合成名「类$字段」注册顶层静态全链·不入对象布局——
            //   静态地址/加载/存储/数据段发射零改动复用·IR容器 登记类静态字段）
            位置++;
            如果 (是关键(记号, 位置, "函数")) {
                位置++;
                整32 名IDs = 当前ID(记号, 位置);
                位置++;
                位置 = 解析方法体(记号, 位置, 池, 字段偏移表, 名IDs, 整32(8 + 段位1029), 整64(类名ID));
                登记类静态方法(整64(类名ID), 整64(名IDs));
            } 否则 {
                整64 类型节点s = 池.大小();
                位置 = 解析类型(记号, 位置, 池);
                如果 (!(当前类型(记号, 位置) == 令牌_标识符)) {
                    IO::打印到错误("[parse] 静态字段声明缺少字段名（类 " +
                                   驻留文本(整64(类名ID)) + "）\n");
                    语法错误加一();
                    返回 位置;
                }
                整64 字段名IDs = 当前ID(记号, 位置);
                位置++;
                节点 类型节点值s = 池.元素(整32(类型节点s));
                字符串 初值文本s = "0";
                如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留("="))) {
                    位置++;
                    // 468（甲案·001 §静态成员）：初值折叠收窄——整数/布尔字面量
                    //   加载期直存（规范化文本入 初始值们·发射层直存面不变）；
                    //   浮点/字符/字符串/表达式=语法期拒绝（辅助内 语法错误加一）
                    //   1027（1074）：类/字段名随传——诊断句宿主同文全句
                    字符串 类型文本s = 字符串复制(驻留文本(整64(类型节点值s.文本)));
                    字符串 类名文本s = 字符串复制(驻留文本(整64(类名ID)));
                    字符串 字段名文本s = 字符串复制(驻留文本(整64(字段名IDs)));
                    位置 = 解析类静态字段初值(记号, 位置, 类型文本s,
                                             类名文本s, 字段名文本s, 初值文本s);
                }
                登记类静态字段(整64(类名ID), 整64(字段名IDs),
                              整64(类型节点值s.文本), 初值文本s);
                如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留(";"))) { 位置++; }
            }
        } 否则 如果 (是不支持类修饰(记号, 位置)) {
            IO::打印到错误("[parse] v2 第一版不支持该类成员修饰（类 " +
                           驻留文本(整64(类名ID)) + "，位置=" +
                           整数转字符串(位置) + "）\n");
            语法错误加一();
            位置 = 跳过一个类成员(记号, 位置);
        } 否则 {
            位置 = 解析类字段(记号, 位置, 池, 类键基, 字段偏移表, &字段偏移,
                              &最大对齐, &最大字段, 段可见性);
        }
        // 字段/方法间分号宽松消费（与结构体同款）
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留(";"))) { 位置++; }
        如果 (位置 <= 前位置) { 位置 = 前位置 + 1; }   // 保底推进（防死循环）
    }
    位置 = 解析类布局收口(池, 类名ID, 类键基, 类体起点, 字段偏移, 最大对齐, 是否公开, 位置, 基名IDj);
    返回 位置;
}

// ==================== 234：祖先层字段并入（857 机械搬移 → 解析类辅助.cn） ====================
// 超警戒线拆分（857·AGENTS 单一职责先拆再加）：并入基类字段 整函数逐字迁入
//   解析类辅助.cn（零行为变更·调用方经包内合并全局池解析同链）。

