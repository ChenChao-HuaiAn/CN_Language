    //   保护段=位5 编码见 段修饰位1029）
    整32 段位1029 = 0;
    当 (真) {
        如果 (当前类型(记号, 位置) == 令牌_文件结束) { 中断; }
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留("}"))) { 位置++; 中断; }
        整64 前位置 = 位置;
        // 访问标签段：公开: / 私有: / 保护:（1029：三态段编码 1/0/2——
