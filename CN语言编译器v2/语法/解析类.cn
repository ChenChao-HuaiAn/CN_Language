        如果 (!有父键j) {
            IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                           ": 基类 '" + 驻留文本(基名IDj) + "' 布局未登记（须先于派生类声明）\n");
            语法错误加一();
        } 否则 {
            基头j = 查类布局头(基名IDj);   // 基头=vptr+基接口区（全头字节数）
