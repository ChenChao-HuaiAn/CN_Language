                //   （732 探针宿主 亮@6=父尾 5 align 2 铁证）；原 父大小-父头
                //   含父尾 pad→派生字段整体后移=内部 ABI 分叉。未登记（父类
                //   早于本表窗口·防御）回退旧推导=旧行为。
                // 1360 批5：结果化——未登记=回退 查父大（整对象大小面·既有语义）
                祖先区j = 查父大.值 - 基头j;
                可选<整64> 父尾查raw463 = 查类字段区尾(基名IDj);
                如果 (父尾查raw463.有值) {
                    祖先区j = 父尾查raw463.值 - 基头j;
                }
                结果<整64, 整32> 查父齐 = 结构体对齐表.获取(父键基j);
                如果 (查父齐.正常 && 查父齐.值 > 最大对齐) { 最大对齐 = 查父齐.值; }
            }
            否则 {
            }
        }
