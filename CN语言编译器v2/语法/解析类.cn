// CN 自举编译器 v2 · 类声明解析（第七十八轮，2026-09-12）
// 语法依据：cn-language-spec 06 面向对象、plans/001 §类。节点形态见 IR常量.cn
//   「节点_类/节点_方法」区。
// 第一版范围（诚实边界，探针 D 缺口专项）：类声明（字段/方法/构造/析构）。
//   继承/虚函数/接口/泛型类/静态成员/常量成员/运算符重载/访问控制强制——
//   显式语法诊断（语法错误加一 = 中止通道；未覆盖形态显式拒绝，绝不静默降级）。
// 布局登记与结构体完全同族（登记结构体布局/字段类型/字段偏移/容器字段——字段
//   访问/对象大小/宽度/RAII 全链复用）；类名另登 IR类 类表（是用户类判定）。
// 类区间协议：节点_类.子区间 [子起点,子终点) = 类体（字段节点+方法节点+方法体
//   内部节点）；方法节点类归属经遍历上下文传入（与结构体字段同款）。
导入 容器::向量;
导入 映射集合;
导入 词法;     // Token/当前ID 等
导入 IR;       // 节点_*/键位移/布局登记族/类表/容器类判定
导入 协议常量;   // 335 重构B：协议常量独立包
导入 IO;       // 349-a：解析诊断输出（打印到错误）

公开:

// 414（#414 运算符重载 v2 补齐·宿主 parser_oop.cpp isOverloadableOperator 同构）：
//   可重载运算符符号集合（001 §4.6·304 收窄后）：X ∈ + - * / % == != < > <= >=
//   && || ! & | ^ ~ << >>（[] / () 已收窄移出·-> 已随成员访问统一废除）。
函数 是可重载运算符文本(字符* 文本O) -> 布尔 {
    返回 字符串比较(文本O, "+") || 字符串比较(文本O, "-") ||
          字符串比较(文本O, "*") || 字符串比较(文本O, "/") ||
          字符串比较(文本O, "%") || 字符串比较(文本O, "==") ||
          字符串比较(文本O, "!=") || 字符串比较(文本O, "<") ||
          字符串比较(文本O, ">") || 字符串比较(文本O, "<=") ||
          字符串比较(文本O, ">=") || 字符串比较(文本O, "&&") ||
          字符串比较(文本O, "||") || 字符串比较(文本O, "!") ||
          字符串比较(文本O, "&") || 字符串比较(文本O, "|") ||
          字符串比较(文本O, "^") || 字符串比较(文本O, "~") ||
          字符串比较(文本O, "<<") || 字符串比较(文本O, ">>");
}

// 414：类体运算符重载名组合（放行）与 304 收窄拒绝——宿主 parseFunctionMember
//   运算符分支同构。前提：调用方已消费 函数/不安全 函数 前缀与方法名。
//   方法名「运算符」（上下文关键字·非保留字 001 §4.6）后随可重载运算符记号 →
//   名ID 改写为组合名「运算符X」并消费该记号（放行——语义收集登记/决议/IR
//   降级链随后接手，宿主 349-a 注释「组合为函数名」同口径）；[ / ( → 304 显式
//   拒绝（不消费·语法错误中止通道）；其余记号不消费（「运算符」按普通方法名，
//   宿主 checkText else 分支同款）。返回新位置；名ID 经指针写回。
//   不安全：名ID 指针下标写面（解析类字段 同款惯例）。
不安全 函数 组合运算符重载名或拒绝(向量<Token> 记号, 整64 位置, 整32* 名IDp) -> 整64 {
    如果 (!(当前类型(记号, 位置) == 令牌_运算符)) { 返回 位置; }
    // 名须恰为「运算符」——其余方法名后随运算符记号=非法源码（参数表解析自然
    //   报错），不劫持（宿主 checkText("运算符") 同口径）
    如果 (!字符串比较(驻留文本(整64(名IDp[0])), "运算符")) { 返回 位置; }
    字符* 记号文本O = 当前文本(记号, 位置);
    // 304 收窄（2026-10-08 用户批「照办」·001 §4.6）：[] / () 移出可重载集合——
    //   显式拒绝（宿主同文案·functor 生态位由 lambda+函数指针覆盖）
    如果 (字符串比较(记号文本O, "(")) {
        IO::打印到错误("[parse] 运算符 \"()\" 不支持重载（001 §4.6 收窄——请改用 lambda 或函数指针）\n");
        语法错误加一();
        返回 位置;
    }
    如果 (字符串比较(记号文本O, "[")) {
        IO::打印到错误("[parse] 运算符 \"[]\" 不支持重载（001 §4.6 收窄——请改用 lambda 或函数指针）\n");
        语法错误加一();
        返回 位置;
    }
    如果 (!是可重载运算符文本(记号文本O)) { 返回 位置; }
    名IDp[0] = 整32(驻留(驻留文本(整64(名IDp[0])) + 记号文本O));
    返回 位置 + 1;
}

// 方法声明体解析：名(参数) [-> 返回类型] { 体 }（调用方已消费 函数/不安全 前缀
//   并取得方法名ID）。与 解析函数声明 同构（返回类型 类型文本/裸名 两形态 +
//   &/* 后缀复刻），产出 节点_方法（附加=返回类型ID；0=构造/析构，语义层归
//   空类型）。无 overload：同名方法唯一（第一版限制，采集层诊断）。
函数 解析方法体(向量<Token> 记号, 整64 位置, 向量<节点> 池,
                 映射<整64, 整64>& 字段偏移表, 整32 方法名ID,
                 整32 修饰, 整64 类名IDm) -> 整64 {
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("("))) { 位置++; }
    // 234：参数表先记——初始化列表判定须在参数消费后（构造 形参) : 基(实参)）
    整64 参数起点 = 池.大小();
    如果 (!(当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(")")))) {
        当 (真) {
            位置 = 解析参数(记号, 位置, 池);
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(","))) { 位置++; 继续; }
            中断;
        }
    }
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(")"))) { 位置++; }
    整32 返回类型ID = 0;
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("->"))) {
        位置++;
        整64 类型位置 = 位置;
        字符串 返回类型名 = 解析类型文本(记号, &类型位置, 假);
        如果 (字符串长度(返回类型名) > 0) {
            位置 = 类型位置;
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("&"))) {
                返回类型名 = 返回类型名 + "&";
                位置++;
            }
            当 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("*"))) {
                返回类型名 = 返回类型名 + "*";
                位置++;
            }
            返回类型ID = 整32(驻留(返回类型名));
        } 否则 {
            返回类型ID = 当前ID(记号, 位置);
            位置++;
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("&"))) { 位置++; }
            当 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("*"))) {
                返回类型ID = 整32(驻留(驻留文本(整64(返回类型ID)) + "*"));
                位置++;
            }
        }
    }
    // 234：构造初始化列表 `: 基名(实参...)`——实参表达式根入池+登记
    //   （生成层 构造序言 发射 父构造调用·this 同参·非新分配）
    如果 (当前类型(记号, 位置) == 令牌_运算符 &&
         当前ID(记号, 位置) == 整32(驻留(":")) &&
         整64(方法名ID) == 类名IDm) {
        位置++;
        如果 (!(当前类型(记号, 位置) == 令牌_标识符)) {
            IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                           ": 初始化列表预期基类名\n");
            语法错误加一();
        } 否则 {
            整64 基名c = 整64(当前ID(记号, 位置));
            位置++;
            如果 (基名c != 查类基名(类名IDm)) {
                IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                               ": 初始化列表基名与声明基类不符\n");
                语法错误加一();
            }
            如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == 整32(驻留("("))) { 位置++; }
            整64 根序c = 0;
            如果 (!(当前类型(记号, 位置) == 令牌_运算符 &&
                   当前ID(记号, 位置) == 整32(驻留(")")))) {
                当 (真) {
                    位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
                    登记基构造实参根(类名IDm, 整64(方法名ID), 根序c, 整64(池.大小()) - 1);
                    根序c++;
                    如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                         当前ID(记号, 位置) == 整32(驻留(","))) { 位置++; 继续; }
                    中断;
                }
            }
            如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == 整32(驻留(")"))) { 位置++; }
            登记基构造实参数(类名IDm, 整64(方法名ID), 根序c);
        }
    }
    位置 = 解析块(记号, 位置, 池, 字段偏移表);
    整32 块索引 = 整32(池.大小()) - 1;
    节点 新方法 = 建节点(节点_方法, 方法名ID, 整64(返回类型ID), 整32(参数起点), 块索引);
    新方法.修饰 = 修饰;   // 156-a：类方法修饰回填（语义层 读取豁免）
    池追加(池, 新方法);
    返回 位置;
}

// 类字段声明解析：类型 名 [';']——布局登记与结构体字段完全同族（偏移推进/对齐/
//   字段类型/字段偏移分桶/容器字段 五登记）。字段节点复用 节点_参数（文本=字段名
//   ID，附加=类型节点索引）。返回位置=字段后（分号由调用方宽松消费）。
//   不安全：布局状态经 整64* 出参（偏移/对齐/最大字段）读写——与 类型大小与对齐
//   同款的裸指针写面（安全区边界观察期口径）。
不安全 函数 解析类字段(向量<Token> 记号, 整64 位置, 向量<节点> 池, 整64 类键基,
                 映射<整64, 整64>& 字段偏移表,
                 整64* 字段偏移, 整64* 最大对齐, 整64* 最大字段, 整64 段可见性) -> 整64 {
    整64 类型节点 = 池.大小();
    位置 = 解析类型(记号, 位置, 池);
    如果 (!(当前类型(记号, 位置) == 令牌_标识符)) {
        IO::打印到错误("[parse] 类字段声明缺少字段名（位置=" +
                       整数转字符串(位置) + "）\n");
        语法错误加一();
        返回 位置;
    }
    整64 字段大小 = 8;
    整64 字段对齐 = 8;
    节点 类型节点值 = 池.元素(整32(类型节点));
    类型大小与对齐(驻留文本(整64(类型节点值.文本)), &字段大小, &字段对齐);
    // 860-a（058 挂账①全局口径·宿主 computeClassLayout 同构）：类字段=句柄
    //   8/8——字段槽运行时装 NewObject 堆对象指针，实宽布局被相邻字段覆写
    //   句柄高 4 字节（容器字段=指针槽模型同样 8/8，与宿主 isClassType 含
    //   容器口径一致）。
    如果 (是用户类(驻留文本(整64(类型节点值.文本))) ||
        是容器类(驻留文本(整64(类型节点值.文本)))) {
        字段大小 = 8;
        字段对齐 = 8;
    }
    整64 余 = 字段偏移[0] % 字段对齐;
    如果 (余 != 0) { 字段偏移[0] = 字段偏移[0] + (字段对齐 - 余); }
    整64 分桶键 = 类键基 * 键位移 + 整64(当前ID(记号, 位置));
    结果<空类型, 整32> 加表 = 字段偏移表.设置(分桶键, 字段偏移[0]);
    如果 (!加表.正常) { 运行时错误(4); }
    // 381 根治（2026-10-10·深度机）：字段类型表登记补星——与 语法分析中:76（321
    //   轮结构体字段侧·435-b 同构）口径归一：表存真类型（基名+附加星层），原
    //   `类型节点值.文本` 只存剥星基名 → 类指针字段「叶子*」失真为「叶子」→
    //   346-a 尝试成员对象整体写 的 381 声明类型判星排除段查表见无星 → 误走
    //   值类深拷（分配对象+拷贝构造「JSON树$JSON树_A_TJSON树」符号无定义链接
    //   失败·669 解析JSON 器.树=树 asm 铁证）；同类消费面（字段宽度码/资源
    //   类别/级联构造判定）对指针字段全部同步矫正至「句柄槽」口径。
    登记字段类型(分桶键, 字段类型星号规范化(类型节点值));
    // 217（027 波2a·001 §5.8a）：全字段表旁路登记（原始星号形态·同语法分析.cn）
    字符串 原始类型217 = 字符串复制(驻留文本(整64(类型节点值.文本)));
    整64 星层217 = 整64(类型节点值.附加);
    整64 星i217 = 0;
    当 (星i217 < 星层217 && 星层217 <= 255) {
        原始类型217 = 原始类型217 + "*";
        星i217++;
    }
    结果<空类型, 整32> 加217a = 结构体全字段表们.追加(类键基);
    如果 (!加217a.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加217b = 结构体全字段表们.追加(整64(当前ID(记号, 位置)));
    如果 (!加217b.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加217c = 结构体全字段表们.追加(驻留(原始类型217));
    如果 (!加217c.正常) { 运行时错误(4); }
    字符串 字段类型文本 = 字符串复制(驻留文本(整64(类型节点值.文本)));
    // 84-c：类别判定（容器 1 / 字符串 0）——嵌套结构体类别经实测回退（见语法分析.cn 注）
    整64 类资源类别f = 0 - 1;
    如果 (是容器类(字段类型文本)) {
        类资源类别f = 1;
    } 否则 如果 (字符串比较(字段类型文本, "字符串")) {
        类资源类别f = 0;
    }
    如果 (类资源类别f >= 0) {
        登记资源字段(类键基, 整64(当前ID(记号, 位置)), 整64(类型节点值.文本),
                    字段偏移[0], 类资源类别f == 1, 类资源类别f);
    }
    登记字段偏移(分桶键, 字段偏移[0]);
    如果 (字段对齐 > 最大对齐[0]) { 最大对齐[0] = 字段对齐; }
    如果 (字段大小 > 最大字段[0]) { 最大字段[0] = 字段大小; }
    字段偏移[0] = 字段偏移[0] + 字段大小;
    // 340-a（347）：子起点=段可见性（解析期空闲位回填·语义层可见性设防消费）
    池追加(池, 建节点(节点_类字段, 当前ID(记号, 位置), 整64(类型节点), 整32(段可见性), 0));
    返回 位置 + 1;
}

// 跳过一整个类成员（不支持形态诊断后的恢复）：到成员终结 ';' 或配对 '{...}'
//   之后；类体 '}' 保持未消费（交类体循环）。防诊断路径死循环/吞类尾。
函数 跳过一个类成员(向量<Token> 记号, 整64 位置) -> 整64 {
    当 (位置 < 记号.大小()) {
        如果 (当前类型(记号, 位置) == 令牌_文件结束) { 返回 位置; }
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留(";"))) { 返回 位置 + 1; }
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留("}"))) { 返回 位置; }
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留("{"))) {
            整64 深 = 1;
            位置++;
            当 (位置 < 记号.大小()) {
                如果 (当前类型(记号, 位置) == 令牌_文件结束) { 返回 位置; }
                如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留("{"))) { 深++; }
                如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留("}"))) {
                    深--;
                    整64 后 = 位置 + 1;
                    如果 (深 == 0) { 返回 后; }
                }
                位置++;
            }
            返回 位置;
        }
        位置++;
    }
    返回 位置;
}

// 当前 token 是否不支持的类成员修饰（第一版边界——诊断恢复用）
函数 是不支持类修饰(向量<Token> 记号, 整64 位置) -> 布尔 {
    如果 (是词(记号, 位置, "静态") || 是词(记号, 位置, "常量") ||
        是关键(记号, 位置, "抽象") || 是关键(记号, 位置, "友元") ||
        是关键(记号, 位置, "泛型") || 是关键(记号, 位置, "运算符")) {
        // 234：虚拟/重写 已移出（类体循环 虚拟/重写 分支支持——位 6/7 修饰）
        返回 真;
    }
    返回 假;
}

// 414-a（D42 甲案波 1）：泛型类声明解析——泛型 <类型 K[, 类型 V[: 约束]]...> 类 名 { 体 }
//   （规范 06-十三·stdlib 容器.cn/映射集合.cn 实际形态）。类型参数表解析消费+逐参
//   登记 泛型参数名们（驻留ID 平铺·语义层豁免消费）；类体经 解析类声明 照常解析
//   （节点_类·基名——实例化单态化=波2）。约束（: 接口名）解析消费不校验（波1 边界·
//   收工回填登记）。泛型 函数 声明=显式诊断不支持（后续轮——绝不静默吞）。
函数 解析泛型类声明(向量<Token> 记号, 整64 位置, 向量<节点> 池,
                  映射<整64, 整64>& 字段偏移表, 整64 是否公开) -> 整64 {
    位置++;   // 消费 泛型
    如果 (!(当前类型(记号, 位置) == 令牌_运算符 &&
           当前ID(记号, 位置) == 整32(驻留("<")))) {
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 泛型 预期 '<'\n");
        语法错误加一();
        返回 位置;
    }
    位置++;
    字符串 参数序串g = "";   // 416-a：基类参数名序（"T,U"·实例化替换序权威）
    当 (真) {
        如果 (当前类型(记号, 位置) == 令牌_文件结束) {
            IO::打印到错误("[parse] 泛型类型参数表未闭合（缺 '>'）\n");
            语法错误加一();
            返回 位置;
        }
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留(">"))) { 位置++; 中断; }
        如果 (!是词(记号, 位置, "类型")) {
            IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 泛型类型参数预期 '类型' 标记\n");
            语法错误加一();
            返回 位置;
        }
        位置++;
        如果 (当前类型(记号, 位置) != 令牌_标识符) {
            IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 泛型类型参数预期名称\n");
            语法错误加一();
            返回 位置;
        }
        登记泛型参数名(整64(当前ID(记号, 位置)));
        // 416-a（D42 波 2）：基类参数序串同步拼装（"T,U"——实例化注册 按序替换）
        如果 (字符串长度(参数序串g) > 0) {
            参数序串g = 字符串复制(参数序串g + "," + 当前文本(记号, 位置));
        } 否则 {
            参数序串g = 字符串复制(当前文本(记号, 位置));
        }
        位置++;
        // 接口约束：类型 T : 接口名（消费不校验——波1 边界）
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留(":"))) {
            位置++;
            如果 (当前类型(记号, 位置) == 令牌_标识符) { 位置++; }
        }
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留(","))) { 位置++; }
    }
    // 417（002 收口·205）：泛型声明后容忍「不安全」修饰词——stdlib 算法.cn
    //   「泛型 <类型 T> 不安全 函数 逆序(...)」形态（宿主 205 绿）。修饰语义
    //   经 解析函数声明 修饰 参数下传（顶层 dispatch 同口径：0=普通/1=不安全）；
    //   其余前导词仍走下方「预期 类 或 函数」诚实诊断。
    整32 泛型修饰g = 0;
    如果 (是关键(记号, 位置, "不安全")) { 泛型修饰g = 1; 位置++; }
    如果 (是关键(记号, 位置, "函数")) {
        // 417-a（D42 波 3）：泛型函数声明——泛型 <类型 T> 函数 名(参数...) {...}
        //   （stdlib 容器/映射集合 线性表辅助·规范 06-十三 函数分支）。函数节点
        //   照常产出（节点_函数·基名）；参数序登记共用 泛型基类参数序们（函数名
        //   ID 键·单态化=克隆器函数版）。实例化调用点=名<实参>(...)（417-a 调用侧）。
        位置++;
        // 函数名在 位置（消费 函数 后）——登记参数序须在函数体解析后（与类同序防御）
        整64 函名IDg = 0;
        如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_标识符) {
            函名IDg = 整64(当前ID(记号, 位置));
        }
        整64 结果位置f = 解析函数声明(记号, 位置, 池, 字段偏移表, 泛型修饰g);
        如果 (函名IDg != 0 && 字符串长度(参数序串g) > 0) {
            登记泛型基类参数序(函名IDg, 参数序串g);
        }
        返回 结果位置f;
    }
    如果 (!是关键(记号, 位置, "类")) {
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 泛型声明后预期 类 或 函数\n");
        语法错误加一();
        返回 位置;
    }
    // 416-a（D42 波 2）：基类参数序登记——次序在 解析类声明 后（其内部登记
    //   用户类基名·登记泛型基类参数序 有类表存在防御）。
    整64 基名IDg = 0;
    如果 (位置 + 1 < 记号.大小() && 当前类型(记号, 位置 + 1) == 令牌_标识符) {
        基名IDg = 整64(当前ID(记号, 位置 + 1));
    }
    整64 结果位置g = 解析类声明(记号, 位置, 池, 字段偏移表, 是否公开);
    如果 (基名IDg != 0 && 字符串长度(参数序串g) > 0) {
        登记泛型基类参数序(基名IDg, 参数序串g);
    }
    返回 结果位置g;
}

// 解析类声明：类 名 [ : 基类, 接口... ] { 类体 } —— 234（2026-10-06·91303）起
//   支持单类继承（`: 基类名`·基类须先于派生类声明）；413（2026-10-11）起支持
//   接口实现（`: 接口名[, 接口名...]`·接口须先于实现类声明——登记接口表双向
//   关系+分配对象接口区。宿主 parser_oop「冒号后父类或接口·逗号分隔」同构：
//   首名可为基类或接口〔首名为接口=无基类纯实现〕，逗号后续名均按接口解析）。
// 后续兼容位（诚实边界）：访问标签 公开:/私有:/保护: 解析消费但不强制访问控制；
//   方法重载不支持（同名方法唯一——重复登记诊断）。
// 类体成员循环不推进时强制前进一 token（防诊断路径死循环）。
// 413 原单名实现由 多名分派 取代（接口名走接口表登记·未知名显式诊断）。
不安全 函数 解析类继承登记(向量<Token> 记号, 整64 位置, 整64 类名ID, 整64* 基名ID出) -> 整64 {
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(":"))) {
        位置++;
        当 (真) {
            如果 (!(当前类型(记号, 位置) == 令牌_标识符)) {
                IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                               ": 继承冒号后预期基类名或接口名\n");
                语法错误加一();
                返回 位置;
            }
            整64 名j = 整64(当前ID(记号, 位置));
            位置++;
            // 分派：基类名（单继承——第二基类名诊断）/ 接口名（登记实现关系）/
            //   未知名（显式诊断——未声明即用=诚实边界，与基类「须先声明」同纪律）
            如果 (是接口名ID(名j)) {
                登记类实现接口(类名ID, 名j);
            } 否则 如果 (是用户类ID(名j)) {
                如果 (基名ID出[0] != 0) {
                    IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                                   ": v2 单继承——类 " + 驻留文本(整64(类名ID)) +
                                   " 已有基类 " + 驻留文本(基名ID出[0]) + "\n");
                    语法错误加一();
                } 否则 {
                    登记类基名(类名ID, 名j);
                    基名ID出[0] = 名j;
                }
            } 否则 {
                IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                               ": 未声明的基类或接口: " + 驻留文本(名j) +
                               "（类 " + 驻留文本(整64(类名ID)) + "）\n");
                语法错误加一();
            }
            如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == 整32(驻留(","))) {
                位置++;
                继续;
            }
            中断;
        }
    }
    返回 位置;
}

// 234：类体虚声明预扫（布局头时序——字段推进前须定 vtable 首槽有无）。
//   精确模式扫描：标识符「虚拟」/「重写」后随关键「函数」才算（上下文关键字·
//   方法体内标识符/字符串不误命中·嵌套 {} 计数到类体平衡）。
函数 类体有虚声明(向量<Token> 记号, 整64 位置) -> 布尔 {
    整64 深y = 1;
    当 (位置 < 记号.大小()) {
        如果 (当前类型(记号, 位置) == 令牌_文件结束) { 返回 假; }
        如果 (当前类型(记号, 位置) == 令牌_运算符) {
            如果 (当前ID(记号, 位置) == 整32(驻留("{"))) { 深y++; }
            如果 (当前ID(记号, 位置) == 整32(驻留("}"))) {
                深y--;
                如果 (深y == 0) { 返回 假; }
            }
        }
        如果 (当前类型(记号, 位置) == 令牌_标识符 && 位置 + 1 < 记号.大小() &&
             (字符串比较(当前文本(记号, 位置), "虚拟") ||
              字符串比较(当前文本(记号, 位置), "重写")) &&
             是关键(记号, 位置 + 1, "函数")) {
            返回 真;
        }
        位置++;
    }
    返回 假;
}

// 537-a（§2.115 方案实施·纯机械拆分零行为变更）：解析类布局收口——尾部对齐+
//   布局/变量/用户类三登记+425-a 探针（原块逐字迁移）。返回收口后的位置。
不安全 函数 解析类布局收口(向量<节点> 池, 整32 类名ID, 整64 类键基, 整64 类体起点,
                        整64 字段偏移, 整64 最大对齐, 整64 是否公开, 整64 位置) -> 整64 {
    // 布局收口：尾部对齐到 最大对齐（同结构体，对齐宿主 computeClassLayout
    //   无虚函数类口径：偏移自 0 起、自然对齐——有虚函数类宿主首 8 字节为
    //   虚表指针，第一版不支持虚函数=无 vtable 首槽）
    整64 尾余 = 字段偏移 % 最大对齐;
    如果 (尾余 != 0) { 字段偏移 = 字段偏移 + (最大对齐 - 尾余); }
    登记结构体布局(整64(类名ID), 字段偏移, 最大对齐, 是否公开);
    登记变量结构体(类键基, 1);
    登记用户类(整64(类名ID));
    // 425-a 探针：登记后立即查（表实例同一性·登记/查询同函数域应必真）
    如果 (!是用户类ID(整64(类名ID))) {
        IO::打印到错误("[探针] 登记后立即查失败（同域）: " + 驻留文本(整64(类名ID)) + "\n");
    }
    池追加(池, 建节点(节点_类, 类名ID, 0, 整32(类体起点), 整32(池.大小())));
    登记类池索引234(整64(类名ID), 整64(池.大小()) - 1);
    返回 位置;
}
函数 解析类声明(向量<Token> 记号, 整64 位置, 向量<节点> 池,
                 映射<整64, 整64>& 字段偏移表, 整64 是否公开) -> 整64 {
    如果 (是关键(记号, 位置, "类")) { 位置++; }
    整32 类名ID = 当前ID(记号, 位置);
    位置++;
    整64 类键基 = 键基合成(取当前模块路径(), 整64(类名ID));
    整64 基名IDj = 0;
    位置 = 解析类继承登记(记号, 位置, 类名ID, &基名IDj);
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("{"))) { 位置++; }
    // 234：布局头计算（宿主 computeClassLayout 同构——沿链有虚函数才含
    //   vtable 首槽·共享 vptr：祖先字段区=基大小-基头；无虚无继承=0=存量布局
    //   零变化·78/79_v2 固定点不受扰）。字段并入：祖先层字段登记偏移+平移量
    //   （本类头-该层头）复制到本类键下（资源字段/全字段表 同步——析构级联/
    //   深拷链复用）。
    整64 字段偏移 = 0;
    整64 最大对齐 = 1;
    整64 最大字段 = 0;
    // 234：布局计算（C++ 单 vptr 语义）——vptr头=沿链有虚则 8（子无自有虚
    //   但继承父虚也须 vptr：预扫+父头双判）；自身字段推进起点=vptr头+祖先
    //   字段区（父大小-父头）；祖先字段并入平移=vptr头-父头（同链全虚=0·
    //   父无虚子有虚=8 父字段让位 vptr 后）。无虚无继承=全 0=存量零变化
    //   （78/79_v2 固定点不受扰）。教训：平移误用「推进起点-父头」=宽/高
    //   写偏 8 字节（613 第 4 行 0 铁证）。
    整64 vptr头j = 0;
    如果 (类体有虚声明(记号, 位置)) { vptr头j = 8; }
    // 413（2026-10-11）：接口分派区（plans/006 P3-19 方案 C·宿主 ifaceDisp 同构）
    //   ——实现接口的类布局 = [vptr 8][接口区 槽数*8][字段区]；vptr 强制（宿主
    //   hasVtable=true 同口径：接口区统一置于对象首 8 字节后）。槽号=全局注册
    //   （接口先于实现类声明→槽位已冻结·合成类接口区槽数 沿链取最大）。
    整64 接口区槽j = 合成类接口区槽数(整64(类名ID));
    登记类接口区槽数(整64(类名ID), 接口区槽j);
    如果 (接口区槽j > 0) { vptr头j = 8; }
    整64 基头j = 0;
    整64 祖先区j = 0;
    如果 (基名IDj != 0) {
        整64 父键基j = 结构体布局键基(基名IDj);
        如果 (父键基j == 0) {
            IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                           ": 基类 '" + 驻留文本(基名IDj) + "' 布局未登记（须先于派生类声明）\n");
            语法错误加一();
        } 否则 {
            基头j = 查类布局头(基名IDj);   // 基头=vptr+基接口区（全头字节数）
            如果 (基头j >= 8) { vptr头j = 8; }   // 继承父虚/父接口区（子必共享 vptr）
            结果<整64, 整32> 查父大 = 结构体大小表.获取(父键基j);
            如果 (查父大.正常) {
                祖先区j = 查父大.值 - 基头j;
                结果<整64, 整32> 查父齐 = 结构体对齐表.获取(父键基j);
                如果 (查父齐.正常 && 查父齐.值 > 最大对齐) { 最大对齐 = 查父齐.值; }
            }
        }
    }
    字段偏移 = vptr头j + 接口区槽j * 8 + 祖先区j;
    如果 (vptr头j > 0) {
        // 布局头=vptr+接口区（派生字段并入平移与祖先区推导同源消费）
        登记类布局头(整64(类名ID), 8 + 接口区槽j * 8);
        如果 (最大对齐 < 8) { 最大对齐 = 8; }
    }
    // 278（021 任务 278·#263 遗留缺口·376/571 无虚有字段继承链 实测）：并入
    //   条件放宽=基名IDj!=0 且 **祖先区j>0**（父有字段区）——原包在 vptr头j>0
    //   内=无虚继承链不走并入→子类字段表无父字段→成员字段偏移未知（376/571
    //   实录）。首版全无条件使 365 无字段虚链 幼犬$自我介绍 克隆链回归（undefined
    //   ·祖先区=0 空转仍扰方法克隆链）→收紧为父有字段区才并入（365/375 无字段
    //   链回原行为·376/571 保留修复）。
    如果 (基名IDj != 0 && 祖先区j > 0) {
        // 413：平移=vptr头+本接口区-基头（父字段区新偏移=旧偏移+平移——本头与
        //   基头均含各自接口区，差值=祖先区让位后的净移位）
        并入基类字段(基名IDj, 类键基, vptr头j + 接口区槽j * 8 - 基头j, 字段偏移表, &最大对齐, &最大字段);
    }
    // 类体起点=类节点自身入池前的池大小（下一句 解析类布局收口 追加 节点_类 于该位置→
    //   子起点恰指向类节点自身+1；**562 热修**：537-a 曾误写 池.大小() + 1，致类区间
    //   首节点被跳过·泛型实例布局登记错位→类型大小查表 miss 返 0（456 红·rc=14）。
    整64 类体起点 = 池.大小();
    // 340-a（D38 批3b·347）：类体段可见性——显式 私有:/保护:=0、公开:=1；
    //   缺省 1=公开（维持存量语义·宿主类缺省私有的收紧随宿主对齐轮）
    整64 段可见性 = 1;
    当 (真) {
        如果 (当前类型(记号, 位置) == 令牌_文件结束) { 中断; }
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留("}"))) { 位置++; 中断; }
        整64 前位置 = 位置;
        // 访问标签段：公开: / 私有: / 保护:（第一版解析消费，不强制访问控制）
        // 293：保护 与 公开/私有 同为上下文关键词（plans/024 §十·2026-09-14
        //   裁决移出关键字表→词法产 令牌_标识符）——判定统一 是词（类别放宽）。
        //   原保护走 是关键（令牌_关键字 判）=上下文化后恒假→保护: 标签不消费
        //   落字段解析→「类字段声明缺少字段名」（23 实测 ×2）。
        如果 ((是词(记号, 位置, "公开") || 是词(记号, 位置, "私有") ||
              是词(记号, 位置, "保护")) &&
             位置 + 1 < 记号.大小() &&
             当前类型(记号, 位置 + 1) == 令牌_运算符 &&
             当前ID(记号, 位置 + 1) == 整32(驻留(":"))) {
            // 340-a（347）：段标记记录（公开=1/私有=0/保护=0 同私有无继承独立语义）
            如果 (是词(记号, 位置, "公开")) { 段可见性 = 1; } 否则 { 段可见性 = 0; }
            位置 += 2;
        } 否则 如果 (是关键(记号, 位置, "不安全") && 位置 + 1 < 记号.大小() &&
                     是关键(记号, 位置 + 1, "函数")) {
            位置++;
            位置++;
            // 414-a（D42 波1·stdlib 前置）：不安全 析构器形态（不安全 函数 ~名()
            //   ——容器.cn 实际形态）——原实现直接取标识符，遇 ~ 运算符 token
            //   名 ID 取错+位置错位→方法体解析中断（probe6/容器.cn 实测）。
            //   合成名 "~名" 对齐 函数 分支内析构器路径（宿主 类$~名 同构）。
            //   〔349-a merge 合成：~ 为运算符记号须先于运算符重载检测判析构器〕
            如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == 整32(驻留("~"))) {
                位置++;
                如果 (当前类型(记号, 位置) == 令牌_标识符) {
                    字符串 析构名u = "~" + 当前文本(记号, 位置);
                    整32 名IDdu = 整32(驻留(析构名u));
                    位置++;
                    位置 = 解析方法体(记号, 位置, 池, 字段偏移表, 名IDdu, 整32(1 + 段可见性 * 4), 整64(类名ID));
                } 否则 {
                    IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                                   ": 析构器声明缺少方法名\n");
                    语法错误加一();
                }
            } 否则 {
                整32 名IDu = 当前ID(记号, 位置);
                位置++;
                // 414（#414·宿主 parseFunctionMember 同构）：运算符重载声明
                //   `函数 运算符X(...)`——组合名「运算符X」正常放行（349-a 旧实现
                //   在此显式拒绝=「暂不支持」·#414 补齐全链后撤销）；304 收窄面
                //   （[] / ()）与集合外记号由 组合运算符重载名或拒绝 统一处理。
                位置 = 组合运算符重载名或拒绝(记号, 位置, &名IDu);
                位置 = 解析方法体(记号, 位置, 池, 字段偏移表, 名IDu, 整32(1 + 段可见性 * 4), 整64(类名ID));
            }
        } 否则 如果 (是词(记号, 位置, "常量") && 位置 + 1 < 记号.大小() &&
                   (是关键(记号, 位置 + 1, "函数") ||
                    是关键(记号, 位置 + 1, "不安全"))) {
            // 414-a（D42 波1·stdlib 前置）：常量 成员函数两形态——常量 函数 名()
            //   （容器.cn 等 17 处）与 常量 不安全 函数 名()（映射集合.cn 194）。
            //   解析消费+零语义（this 常量性检查=宿主面·诚实边界登记；对齐
            //   访问标签「解析消费不强制」先例）。须先于 是不支持类修饰 检查
            //   （裸 常量 字段仍走修饰诊断路径）。
            位置++;   // 消费 常量
            整32 修饰不安全c = 0;
            如果 (是关键(记号, 位置, "不安全")) { 修饰不安全c = 1; 位置++; }
            如果 (!是关键(记号, 位置, "函数")) {
                IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                               ": 常量 成员预期 '函数'\n");
                语法错误加一();
            } 否则 {
                位置++;   // 消费 函数
                整32 名IDc = 当前ID(记号, 位置);
                位置++;
                // 575-a（T100·299）：常量位编码——修饰 0=普通/1=不安全/2=常量/
                //   3=常量+不安全（位 0=不安全·位 1=常量；语义层 %2 判不安全、
                //   /2 判常量——既有 ==1 消费点同步改 %2）。
                位置 = 解析方法体(记号, 位置, 池, 字段偏移表, 名IDc, 整32(2 + 修饰不安全c + 段可见性 * 4), 整64(类名ID));
            }
        } 否则 如果 ((是词(记号, 位置, "虚拟") || 是词(记号, 位置, "重写")) &&
                   位置 + 1 < 记号.大小() && 是关键(记号, 位置 + 1, "函数")) {
            // 234（2026-10-06·91303）：虚拟/重写 方法——修饰位 6=虚拟(64)/位 7=重写(128)
            //   （位 0~4 存量占用不动）；登记类虚方法=槽沿链覆盖判定（重写命中父槽·
            //   新虚分配沿链最大槽）。
            布尔 是重写v = 是词(记号, 位置, "重写");
            位置 += 2;
            整32 名IDv = 当前ID(记号, 位置);
            位置++;
            整64 修饰v = 段可见性 * 4;
            如果 (是重写v) { 修饰v = 修饰v + 128; } 否则 { 修饰v = 修饰v + 64; }
            位置 = 解析方法体(记号, 位置, 池, 字段偏移表, 名IDv, 整32(修饰v), 整64(类名ID));
            登记类虚方法(整64(类名ID), 整64(名IDv));
        } 否则 如果 (是关键(记号, 位置, "函数")) {
            位置++;
            // 析构器形态：函数 ~名() { 体 }（~ 是运算符 token——须在取名前识别；
            //   合成名 "~名"，宿主 类$~名 符号对齐）
            如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == 整32(驻留("~"))) {
                位置++;
                如果 (当前类型(记号, 位置) == 令牌_标识符) {
                    字符串 析构名 = "~" + 当前文本(记号, 位置);
                    整32 名IDd = 整32(驻留(析构名));
                    位置++;
                    位置 = 解析方法体(记号, 位置, 池, 字段偏移表, 名IDd, 整32(段可见性 * 4), 整64(类名ID));
                } 否则 {
                    IO::打印到错误("[parse] 析构器声明缺少方法名（类 " +
                                   驻留文本(整64(类名ID)) + "）\n");
                    语法错误加一();
                }
            } 否则 {
                整32 名IDm = 当前ID(记号, 位置);
                位置++;
                // 414（#414·宿主 parseFunctionMember 同构）：运算符重载声明
                //   `函数 运算符X(...)`——组合名「运算符X」正常放行（349-a 旧实现
                //   在此显式拒绝=「暂不支持」·#414 补齐全链后撤销）；304 收窄面
                //   （[] / ()）与集合外记号由 组合运算符重载名或拒绝 统一处理。
                位置 = 组合运算符重载名或拒绝(记号, 位置, &名IDm);
                位置 = 解析方法体(记号, 位置, 池, 字段偏移表, 名IDm, 整32(段可见性 * 4), 整64(类名ID));
            }
        } 否则 如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留("~"))) {
            // 析构器：函数 ~名() { 体 }——合成名 "~名"（宿主 类$~名 符号对齐）
            位置++;
            如果 (当前类型(记号, 位置) == 令牌_标识符) {
                字符串 析构名 = "~" + 当前文本(记号, 位置);
                整32 名IDd = 整32(驻留(析构名));
                位置++;
                位置 = 解析方法体(记号, 位置, 池, 字段偏移表, 名IDd, 整32(段可见性 * 4), 整64(类名ID));
            } 否则 {
                IO::打印到错误("[parse] 析构器声明缺少方法名（类 " +
                               驻留文本(整64(类名ID)) + "）\n");
                语法错误加一();
            }
        } 否则 如果 (是词(记号, 位置, "友元")) {
            // 070 波H（1026 深度机）：友元 函数 声明——类内声明=授权该**全局函数**
            //   访问私有（宿主 friend 语义·友元非成员）——建无体原型节点（592-a
            //   形态·修饰位4=友元·收集函数签名补扫登记）+登记友元授权
            //   （语义层私有可见性检查豁免消费）
            位置++;
            如果 (是关键(记号, 位置, "函数")) {
                位置++;
                整32 名IDy = 当前ID(记号, 位置);
                位置++;
                如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留("("))) { 位置++; }
                整64 参数起点y = 池.大小();
                如果 (!(当前类型(记号, 位置) == 令牌_运算符 &&
                       当前ID(记号, 位置) == 整32(驻留(")")))) {
                    当 (真) {
                        位置 = 解析参数(记号, 位置, 池);
                        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                             当前ID(记号, 位置) == 整32(驻留(","))) { 位置++; 继续; }
                        中断;
                    }
                }
                如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留(")"))) { 位置++; }
                整64 返回类型IDy = 0;
                如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留("->"))) {
                    位置++;
                    整64 类型位置y = 位置;
                    字符串 返回类型名y = 解析类型文本(记号, &类型位置y, 假);
                    如果 (字符串长度(返回类型名y) > 0) {
                        位置 = 类型位置y;
                        返回类型IDy = 整32(驻留(返回类型名y));
                    }
                }
                // 空块原型（592-a 形态·修饰位4=友元 值16——语义/补登判定）
                节点 空块y = 建节点(节点_块, 0, 0, 整32(池.大小()), 整32(池.大小()));
                池追加(池, 空块y);
                整32 空块索引y = 整32(池.大小()) - 1;
                节点 友元原型 = 建节点(节点_函数, 名IDy, 返回类型IDy,
                                      整32(参数起点y), 空块索引y);
                友元原型.修饰 = 整32(16 + 段可见性 * 4);
                池追加(池, 友元原型);
                登记友元授权(整64(类名ID), 整64(名IDy));
                如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留(";"))) { 位置++; }
            } 否则 {
                IO::打印到错误("[parse] 友元 后预期 '函数'（类 " +
                               驻留文本(整64(类名ID)) + "）\n");
                语法错误加一();
                位置 = 跳过一个类成员(记号, 位置);
            }
        } 否则 如果 (是词(记号, 位置, "静态")) {
            // 070 波G（1026 深度机）：静态 成员——静态 函数=静态方法（修饰位3=8·
            //   生成方法 跳 this 槽·调用分派直调）；静态 类型 名 [= 字面量]=
            //   类静态字段（合成名「类$字段」注册顶层静态全链·不入对象布局——
            //   静态地址/加载/存储/数据段发射零改动复用·IR容器 登记类静态字段）
            位置++;
            如果 (是关键(记号, 位置, "函数")) {
                位置++;
                整32 名IDs = 当前ID(记号, 位置);
                位置++;
                位置 = 解析方法体(记号, 位置, 池, 字段偏移表, 名IDs, 整32(8 + 段可见性 * 4), 整64(类名ID));
                登记类静态方法(整64(类名ID), 整64(名IDs));
            } 否则 {
                整64 类型节点s = 池.大小();
                位置 = 解析类型(记号, 位置, 池);
                如果 (!(当前类型(记号, 位置) == 令牌_标识符)) {
                    IO::打印到错误("[parse] 静态字段声明缺少字段名（类 " +
                                   驻留文本(整64(类名ID)) + "）\n");
                    语法错误加一();
                    返回 位置;
                }
                整64 字段名IDs = 当前ID(记号, 位置);
                位置++;
                节点 类型节点值s = 池.元素(整32(类型节点s));
                字符串 初值文本s = "0";
                如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留("="))) {
                    位置++;
                    初值文本s = 字符串复制(当前文本(记号, 位置));
                    位置++;
                }
                登记类静态字段(整64(类名ID), 整64(字段名IDs),
                              整64(类型节点值s.文本), 初值文本s);
                如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留(";"))) { 位置++; }
            }
        } 否则 如果 (是不支持类修饰(记号, 位置)) {
            IO::打印到错误("[parse] v2 第一版不支持该类成员修饰（类 " +
                           驻留文本(整64(类名ID)) + "，位置=" +
                           整数转字符串(位置) + "）\n");
            语法错误加一();
            位置 = 跳过一个类成员(记号, 位置);
        } 否则 {
            位置 = 解析类字段(记号, 位置, 池, 类键基, 字段偏移表, &字段偏移,
                              &最大对齐, &最大字段, 段可见性);
        }
        // 字段/方法间分号宽松消费（与结构体同款）
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留(";"))) { 位置++; }
        如果 (位置 <= 前位置) { 位置 = 前位置 + 1; }   // 保底推进（防死循环）
    }
    位置 = 解析类布局收口(池, 类名ID, 类键基, 类体起点, 字段偏移, 最大对齐, 是否公开, 位置);
    返回 位置;
}

// ==================== 234：祖先层字段并入 ====================
// 递归最基类先（字段序=祖先在前·宿主 fieldOrder 同构）；层平移=本类头-层头
//   （共享 vptr：祖先字段新偏移=层登记偏移+平移）。资源字段（容器/字符串）/
//   全字段表三元组同步复制——析构级联/深拷/类型大小链零改动复用。
不安全 函数 并入基类字段(整64 层名ID, 整64 子类键基b, 整64 平移量b,
                     映射<整64, 整64>& 字段偏移表,
                     整64* 最大对齐b, 整64* 最大字段b) -> 空类型 {
    整64 上层b = 查类基名(层名ID);
    如果 (上层b != 0) {
        并入基类字段(上层b, 子类键基b, 平移量b, 字段偏移表, 最大对齐b, 最大字段b);
    }
    整64 层键基b = 键基合成(取当前模块路径(), 层名ID);
    整64 ib = 0;
    当 (ib + 2 < 结构体全字段表们.大小()) {
        如果 (结构体全字段表们.元素(ib) == 层键基b) {
            整64 字段名b = 结构体全字段表们.元素(ib + 1);
            整64 类型文本b = 结构体全字段表们.元素(ib + 2);
            整64 父分桶b = 层键基b * 键位移 + 字段名b;
            结果<整64, 整32> 查偏b = 字段偏移表.获取(父分桶b);
            如果 (查偏b.正常) {
                整64 新偏b = 查偏b.值 + 平移量b;
                整64 分桶键b = 子类键基b * 键位移 + 字段名b;
                结果<空类型, 整32> 加表b = 字段偏移表.设置(分桶键b, 新偏b);
                如果 (!加表b.正常) { 运行时错误(4); }
                登记字段类型(分桶键b, 类型文本b);
                登记字段偏移(分桶键b, 新偏b);
                字符串 类型串b = 字符串复制(驻留文本(类型文本b));
                整64 资源类别b = 0 - 1;
                如果 (是容器类(类型串b)) { 资源类别b = 1; } 否则 如果 (字符串比较(类型串b, "字符串")) { 资源类别b = 0; }
                如果 (资源类别b >= 0) {
                    登记资源字段(子类键基b, 字段名b, 类型文本b, 新偏b, 资源类别b == 1, 资源类别b);
                }
                结果<空类型, 整32> 加ab = 结构体全字段表们.追加(子类键基b);
                如果 (!加ab.正常) { 运行时错误(4); }
                结果<空类型, 整32> 加bb = 结构体全字段表们.追加(字段名b);
                如果 (!加bb.正常) { 运行时错误(4); }
                结果<空类型, 整32> 加cb = 结构体全字段表们.追加(类型文本b);
                如果 (!加cb.正常) { 运行时错误(4); }
                整64 字段大小b = 8;
                整64 字段对齐b = 8;
                类型大小与对齐(类型串b, &字段大小b, &字段对齐b);
                如果 (是用户类(类型串b) || 是容器类(类型串b)) {
                    字段大小b = 8;
                    字段对齐b = 8;
                }
                如果 (字段对齐b > 最大对齐b[0]) { 最大对齐b[0] = 字段对齐b; }
                如果 (字段大小b > 最大字段b[0]) { 最大字段b[0] = 字段大小b; }
            }
        }
        ib = ib + 3;
    }
}
