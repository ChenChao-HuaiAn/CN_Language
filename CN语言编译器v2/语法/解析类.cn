    //   零变化·78/79_v2 固定点不受扰）。字段并入：祖先层字段登记偏移+平移量
    //   （本类头-该层头）复制到本类键下（资源字段/全字段表 同步——析构级联/
    //   深拷链复用）。
    整64 字段偏移 = 0;
    整64 最大对齐 = 1;
    整64 最大字段 = 0;
    // 234：布局计算（C++ 单 vptr 语义）——vptr头=沿链有虚则 8（子无自有虚
    //   但继承父虚也须 vptr：预扫+父头双判）；自身字段推进起点=vptr头+祖先
    //   字段区（父大小-父头）；祖先字段并入平移=vptr头-父头（同链全虚=0·
    //   父无虚子有虚=8 父字段让位 vptr 后）。无虚无继承=全 0=存量零变化
    //   （78/79_v2 固定点不受扰）。教训：平移误用「推进起点-父头」=宽/高
    //   写偏 8 字节（613 第 4 行 0 铁证）。
    整64 vptr头j = 0;
    如果 (类体有虚声明(记号, 位置)) { vptr头j = 8; }
    // 413（2026-10-11）：接口分派区（plans/006 P3-19 方案 C·宿主 ifaceDisp 同构）
    //   ——实现接口的类布局 = [vptr 8][接口区 槽数*8][字段区]；vptr 强制（宿主
    //   hasVtable=true 同口径：接口区统一置于对象首 8 字节后）。槽号=全局注册
    //   （接口先于实现类声明→槽位已冻结·合成类接口区槽数 沿链取最大）。
    整64 接口区槽j = 合成类接口区槽数(整64(类名ID));
    登记类接口区槽数(整64(类名ID), 接口区槽j);
    如果 (接口区槽j > 0) { vptr头j = 8; }
    整64 基头j = 0;
    整64 祖先区j = 0;
    如果 (基名IDj != 0) {
