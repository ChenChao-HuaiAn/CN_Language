// CN 自举编译器 v2 · 类声明解析（第七十八轮，2026-09-12）
// 语法依据：cn-language-spec 06 面向对象、plans/001 §类。节点形态见 IR常量.cn
//   「节点_类/节点_方法」区。
// 第一版范围（诚实边界，探针 D 缺口专项）：类声明（字段/方法/构造/析构）。
//   继承/虚函数/接口/泛型类/静态成员/常量成员/运算符重载/访问控制强制——
//   显式语法诊断（语法错误加一 = 中止通道；未覆盖形态显式拒绝，绝不静默降级）。
// 布局登记与结构体完全同族（登记结构体布局/字段类型/字段偏移/容器字段——字段
//   访问/对象大小/宽度/RAII 全链复用）；类名另登 IR类 类表（是用户类判定）。
// 类区间协议：节点_类.子区间 [子起点,子终点) = 类体（字段节点+方法节点+方法体
//   内部节点）；方法节点类归属经遍历上下文传入（与结构体字段同款）。
导入 容器::向量;
导入 映射集合;
导入 词法;     // Token/当前ID 等
导入 IR;       // 节点_*/键位移/布局登记族/类表/容器类判定
导入 协议常量;   // 335 重构B：协议常量独立包
导入 IO;       // 349-a：解析诊断输出（打印到错误）

公开:

// 1029（1017 采样轮 p06 族·v2 访问控制零执法根治配套）：段可见性→方法修饰段位——
//   0 私有→0；1 公开→4（位2）；2 保护→32（位5）。
//   保护段不可用「段×4」直乘：位3（8）被静态方法修饰占用（生成类.cn 静态判定
//   /8%2·解析类.cn 静态方法分支 8+段位），2×4=8 静触静态位；位5（32）经全仓
//   清点空闲——本映射为该位唯一写点，语义层 方法段值1029（语义检查访问控制.cn）
//   为唯一读点。其余修饰位（不安全1/常量2/友元16/虚拟64/重写128/抽象256）与
//   4/32 无交集。
函数 段修饰位1029(整64 段可见性) -> 整32 {
    如果 (段可见性 == 1) { 返回 4; }
    如果 (段可见性 == 2) { 返回 32; }
    // 段值 0（私有）=段位 0（解析期段编码闭集 0/1/2·前两支已枚举 1/2）
    返回 0;
}

// 方法声明体解析：名(参数) [-> 返回类型] { 体 }（调用方已消费 函数/不安全 前缀
//   并取得方法名ID）。与 解析函数声明 同构（返回类型 类型文本/裸名 两形态 +
//   &/* 后缀复刻），产出 节点_方法（附加=返回类型ID；0=构造/析构，语义层归
//   空类型）。无 overload：同名方法唯一（第一版限制，采集层诊断）。
函数 解析方法体(向量<Token> 记号, 整64 位置, 向量<节点> 池,
                 映射<整64, 整64>& 字段偏移表, 整32 方法名ID,
                 整32 修饰, 整64 类名IDm) -> 整64 {
    布尔 有左括号方法1031 = 假;
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("("))) { 位置++; 有左括号方法1031 = 真; }
    否则 {
        // 1031（参数表全缺形态·N4 实录）：方法声明缺参数表 '('——宿主
        //   「预期 '('，实际为 'X'」拒绝（原实现静默跳过参数段将
        //   `函数 取 { 返回 7; }` 当无参方法放行）。诊断=公共函数（三消费点共用）。
        参数表左括号缺失诊断(记号, 位置, "方法");
    }
    // 234：参数表先记——初始化列表判定须在参数消费后（构造 形参) : 基(实参)）
    整64 参数起点 = 池.大小();
    如果 (!(当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(")")))) {
        当 (真) {
            位置 = 解析参数(记号, 位置, 池);
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(","))) { 位置++; 继续; }
            中断;
        }
    }
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(")"))) { 位置++; }
    否则 如果 (有左括号方法1031) {
        // 1031（方法参数表收口）：')' 缺失且非冒号形态显式诊断（M1/M2/M4 实录——
        //   原实现静默漂走把 `函数 取(整32 甲 -> 整32 {` 当合法方法整体放行）。
        参数表收口诊断(记号, 位置, "方法参数表");
    }
    整32 返回类型ID = 0;
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("->"))) {
        位置++;
        整64 类型位置 = 位置;
        字符串 返回类型名 = 解析类型文本(记号, &类型位置, 假);
        如果 (字符串长度(返回类型名) > 0) {
            位置 = 类型位置;
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("&"))) {
                返回类型名 = 返回类型名 + "&";
                位置++;
            }
            当 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("*"))) {
                返回类型名 = 返回类型名 + "*";
                位置++;
            }
            返回类型ID = 整32(驻留(返回类型名));
        } 否则 {
            返回类型ID = 当前ID(记号, 位置);
            位置++;
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("&"))) { 位置++; }
            当 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("*"))) {
                返回类型ID = 整32(驻留(驻留文本(整64(返回类型ID)) + "*"));
                位置++;
            }
        }
    }
    // 234；846：构造初始化列表 `: 基名(实参...)`——实参表达式根入池+登记
    //   （生成层 构造序言 发射 父构造调用·this 同参·非新分配）。846 起项序列
    //   解析与恢复整体落 解析类辅助.cn 解析构造初始化列表846（857 先例：新
    //   功能落辅助文件·控本文件 900 行警戒线）——逐项消费·首项与声明基类
    //   不符只报一次「初始化列表基名与声明基类不符」·畸形残留跳安全 token
    //   防雪崩（原内联段只处理第一项，`, 二(2)` 尾巴致连环误报实录）。
    如果 (当前类型(记号, 位置) == 令牌_运算符 &&
         当前ID(记号, 位置) == 整32(驻留(":")) &&
         整64(方法名ID) == 类名IDm) {
        位置++;
        位置 = 解析构造初始化列表846(记号, 位置, 池, 字段偏移表, 整64(类名IDm));
    }
    // 193（2026-10-13 任务193）：抽象成员（修饰位 8=256）无函数体——`-> 类型`
    //   之后非 `{` = 纯虚声明（宿主 parser parseFunctionMember「函数体（抽象
    //   方法/接口签名无实现体）」同构：函数体可缺）。建空块方法节点（592-a
    //   空体原型形态——语义签名登记照常、体检查/IR 生成按空块/抽象位跳过）；
    //   分号可选（宿主 plans/015「函数原型分号仍可选」同口径·80/858 两形态）。
    如果 (!((当前类型(记号, 位置) == 令牌_运算符 &&
            当前ID(记号, 位置) == 整32(驻留("{"))))) {
        如果 ((整64(修饰) / 256) % 2 == 1) {
            如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == 整32(驻留(";"))) { 位置++; }
            节点 空块原型a = 建节点(节点_块, 0, 0, 整32(池.大小()), 整32(池.大小()));
            池追加(池, 空块原型a);
            整32 空块索引a = 整32(池.大小()) - 1;
            节点 抽象方法 = 建节点(节点_方法, 方法名ID, 整64(返回类型ID), 整32(参数起点), 空块索引a);
            抽象方法.修饰 = 修饰;   // 156-a：类方法修饰回填（含 位8=256 抽象）
            池追加(池, 抽象方法);
            返回 位置;
        }
    }
    // 193修复（2026-10-13 审查 P1-1·零分叉）：「抽象+函数体」边角形态双侧显式
    //   拒绝——specs/06 §八 抽象成员=纯虚声明无实现体，带体即语法错误（宿主
    //   parseFunctionMember 同点同文案诊断）。原 v2 静默建体后收口拒实例化
    //   且生成层丢体/宿主放行=两向分叉，双侧关死。报错后照常解析块（错误
    //   恢复同步），语法错误数>0 主流程中止（plans/015 方案B），不会到生成层。
    如果 ((整64(修饰) / 256) % 2 == 1 &&
         当前类型(记号, 位置) == 令牌_运算符 &&
         当前ID(记号, 位置) == 整32(驻留("{"))) {
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                       ": 抽象方法不得带实现体\n");
        语法错误加一();
    }
    位置 = 解析块(记号, 位置, 池, 字段偏移表);
    整32 块索引 = 整32(池.大小()) - 1;
    节点 新方法 = 建节点(节点_方法, 方法名ID, 整64(返回类型ID), 整32(参数起点), 块索引);
    新方法.修饰 = 修饰;   // 156-a：类方法修饰回填（语义层 读取豁免）
    池追加(池, 新方法);
    返回 位置;
}

// 类字段声明解析：类型 名 [';']——布局登记与结构体字段完全同族（偏移推进/对齐/
//   字段类型/字段偏移分桶/容器字段 五登记）。字段节点复用 节点_参数（文本=字段名
//   ID，附加=类型节点索引）。返回位置=字段后（分号由调用方宽松消费）。
//   不安全：布局状态经 整64* 出参（偏移/对齐/最大字段）读写——与 类型大小与对齐
//   同款的裸指针写面（安全区边界观察期口径）。
不安全 函数 解析类字段(向量<Token> 记号, 整64 位置, 向量<节点> 池, 整64 类键基,
                 映射<整64, 整64>& 字段偏移表,
                 整64* 字段偏移, 整64* 最大对齐, 整64* 最大字段, 整64 段可见性) -> 整64 {
    整64 类型节点 = 池.大小();
    位置 = 解析类型(记号, 位置, 池);
    如果 (!(当前类型(记号, 位置) == 令牌_标识符)) {
        IO::打印到错误("[parse] 类字段声明缺少字段名（位置=" +
                       整数转字符串(位置) + "）\n");
        语法错误加一();
        返回 位置;
    }
    // 775（甲案·2026-10-15 用户裁决甲）：实例字段声明初始化器=构造期生效
    //   （构造调用前注入默认值·构造体显式赋值随后覆盖·C++ NSDMI 语义）。
    //   折叠=宿主 foldClassInstanceInit 逐字同口径（整数含±符号链/布尔字面量·
    //   128 字段原样文本·标量十进制/1·0·非标量字段类型拒绝），登记规范文本
    //   （发射侧 发射类字段默认值 无池依赖；键=分桶键同域）。
    整32 名ID775 = 当前ID(记号, 位置);
    整64 值后775 = 0 - 1;
    如果 (位置 + 1 < 记号.大小() &&
         当前类型(记号, 位置 + 1) == 令牌_运算符 &&
         当前ID(记号, 位置 + 1) == 整32(驻留("="))) {
        节点 类型根775 = 池.元素(整32(类型节点));
        字符串 字段类型文本775 = 字符串复制(驻留文本(整64(类型根775.文本)));
        位置 = 解析表达式(记号, 位置 + 2, 池, 字段偏移表);
        整64 值节点775 = 整64(池.大小() - 1);
        字符串 折叠错775 = "";
        字符串 默认文本775 = 折叠类字段默认值(池, 值节点775, 字段类型文本775,
                                              折叠错775);
        如果 (字符串长度(折叠错775) == 0) {
            登记字段默认值(类键基 * 键位移 + 整64(名ID775), 驻留(默认文本775));
            值后775 = 位置;
        } 否则 {
            // 拒绝面（宿主同句：非标量字段类型/浮点字符字符串表达式/起步面）——
            //   单条精确诊断+跳至分号（错误恢复：上游诊断已报·语法错误加一=
            //   中止通道，双编译对照负例锁面）。
            IO::打印到错误(
                "[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                ": " + 折叠错775 + "——请在构造函数中赋值\n");
            语法错误加一();
            当 (位置 < 记号.大小() &&
                  !(当前类型(记号, 位置) == 令牌_运算符 &&
                    当前ID(记号, 位置) == 整32(驻留(";")))) {
                位置 = 位置 + 1;
            }
        }
    }
    整64 字段大小 = 8;
    整64 字段对齐 = 8;
    节点 类型节点值 = 池.元素(整32(类型节点));
    // 463（413-c 保守态翻开·宿主 computeClassLayout 实宽 ABI 对齐）：布局回
    //   **实宽**（类型大小与对齐：整32=4/4·整8=1/1·整16=2/2），用户类/容器类
    //   字段保持句柄槽 8/8（860-a 原口径：字段槽运行时装 NewObject 堆对象
    //   指针）。413 的越界根因真身=**写侧三处恒 qword**（类内裸字段赋值/
    //   表达式位链式写/自增读写——恒 8 字节过写相邻槽），本轮写侧按字段类型
    //   码分派（mov dword/word/byte·生成语句赋值+生成表达式中+IR生成尾三处
    //   ·成员链写通道 取成员宽度码 186 轮已分派）→ 布局实宽+写宽≤实宽+
    //   读侧符号扩展（查字段宽度码 链既有）=读写同源对称，越界根除面保持
    //   （413 linux 堆越界根因随写宽≤实宽自然消解·413 接口族回归锚）；
    //   类尺寸/偏移与宿主一致=内部 ABI 分叉收口（v2 与宿主 asm 偏移表一致）。
    类型大小与对齐(驻留文本(整64(类型节点值.文本)), &字段大小, &字段对齐);
    // 857（813h 实锤·结构体面同款·IR布局.指针层宽对齐折算 单点）：指针字段
    //   （附加=指针层 1..255）——槽大小/对齐恒 8（指针槽存 8 字节地址；星层
    //   在附加位、基名文本无星：原按基名算大小 → 类内指针字段偏移/类尺寸与
    //   宿主 computeClassLayout（typeSizeOf 指针=8）分叉）。
    指针层宽对齐折算(类型节点值.附加, &字段大小, &字段对齐);
    如果 (是用户类(驻留文本(整64(类型节点值.文本))) ||
        是容器类(驻留文本(整64(类型节点值.文本)))) {
        字段大小 = 8;
        字段对齐 = 8;
    }
    整64 余 = 字段偏移[0] % 字段对齐;
    如果 (余 != 0) { 字段偏移[0] = 字段偏移[0] + (字段对齐 - 余); }
    整64 分桶键 = 类键基 * 键位移 + 整64(名ID775);
    结果<空类型, 整32> 加表 = 字段偏移表.设置(分桶键, 字段偏移[0]);
    如果 (!加表.正常) { 运行时错误(4); }
    // 381 根治（2026-10-10·深度机）：字段类型表登记补星——与 语法分析中:76（321
    //   轮结构体字段侧·435-b 同构）口径归一：表存真类型（基名+附加星层），原
    //   `类型节点值.文本` 只存剥星基名 → 类指针字段「叶子*」失真为「叶子」→
    //   346-a 尝试成员对象整体写 的 381 声明类型判星排除段查表见无星 → 误走
    //   值类深拷（分配对象+拷贝构造「JSON树$JSON树_A_TJSON树」符号无定义链接
    //   失败·669 解析JSON 器.树=树 asm 铁证）；同类消费面（字段宽度码/资源
    //   类别/级联构造判定）对指针字段全部同步矫正至「句柄槽」口径。
    登记字段类型(分桶键, 字段类型星号规范化(类型节点值));
    // 217（027 波2a·001 §5.8a）：全字段表旁路登记（原始星号形态·同语法分析.cn）
    字符串 原始类型217 = 字符串复制(驻留文本(整64(类型节点值.文本)));
    整64 星层217 = 整64(类型节点值.附加);
    整64 星i217 = 0;
    当 (星i217 < 星层217 && 星层217 <= 255) {
        原始类型217 = 原始类型217 + "*";
        星i217++;
    }
    结果<空类型, 整32> 加217a = 结构体全字段表们.追加(类键基);
    如果 (!加217a.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加217b = 结构体全字段表们.追加(整64(名ID775));
    如果 (!加217b.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加217c = 结构体全字段表们.追加(驻留(原始类型217));
    如果 (!加217c.正常) { 运行时错误(4); }
    字符串 字段类型文本 = 字符串复制(驻留文本(整64(类型节点值.文本)));
    // 84-c：类别判定（容器 1 / 字符串 0）——嵌套结构体类别经实测回退（见语法分析.cn 注）
    整64 类资源类别f = 0 - 1;
    如果 (是容器类(字段类型文本)) {
        类资源类别f = 1;
    } 否则 如果 (字符串比较(字段类型文本, "字符串")) {
        类资源类别f = 0;
    }
    如果 (类资源类别f >= 0) {
        登记资源字段(类键基, 整64(名ID775), 整64(类型节点值.文本),
                    字段偏移[0], 类资源类别f == 1, 类资源类别f);
    }
    登记字段偏移(分桶键, 字段偏移[0]);
    如果 (字段对齐 > 最大对齐[0]) { 最大对齐[0] = 字段对齐; }
    如果 (字段大小 > 最大字段[0]) { 最大字段[0] = 字段大小; }
    字段偏移[0] = 字段偏移[0] + 字段大小;
    // 340-a（347）：子起点=段可见性（解析期空闲位回填·语义层可见性设防消费）
    池追加(池, 建节点(节点_类字段, 名ID775, 整64(类型节点), 整32(段可见性), 0));
    // 775：有默认值时位置已推进至值后（不做 +1 名字跳过）；无默认值原样。
    如果 (值后775 >= 0) { 返回 值后775; }
    返回 位置 + 1;
}

// 跳过一整个类成员（不支持形态诊断后的恢复）：到成员终结 ';' 或配对 '{...}'
//   之后；类体 '}' 保持未消费（交类体循环）。防诊断路径死循环/吞类尾。
函数 跳过一个类成员(向量<Token> 记号, 整64 位置) -> 整64 {
    当 (位置 < 记号.大小()) {
        如果 (当前类型(记号, 位置) == 令牌_文件结束) { 返回 位置; }
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留(";"))) { 返回 位置 + 1; }
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留("}"))) { 返回 位置; }
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留("{"))) {
            整64 深 = 1;
            位置++;
            当 (位置 < 记号.大小()) {
                如果 (当前类型(记号, 位置) == 令牌_文件结束) { 返回 位置; }
                如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留("{"))) { 深++; }
                如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留("}"))) {
                    深--;
                    整64 后 = 位置 + 1;
                    如果 (深 == 0) { 返回 后; }
                }
                位置++;
            }
            返回 位置;
        }
        位置++;
    }
    返回 位置;
}

// 当前 token 是否不支持的类成员修饰（第一版边界——诊断恢复用）
函数 是不支持类修饰(向量<Token> 记号, 整64 位置) -> 布尔 {
    如果 (是词(记号, 位置, "静态") || 是词(记号, 位置, "常量") ||
        是关键(记号, 位置, "抽象") || 是关键(记号, 位置, "友元") ||
        是关键(记号, 位置, "泛型") || 是关键(记号, 位置, "运算符")) {
        // 234：虚拟/重写 已移出（类体循环 虚拟/重写 分支支持——位 6/7 修饰）
        返回 真;
    }
    返回 假;
}

// 414-a（D42 甲案波 1）：泛型类声明解析——泛型 <类型 K[, 类型 V[: 约束]]...> 类 名 { 体 }
//   （规范 06-十三·stdlib 容器.cn/映射集合.cn 实际形态）。类型参数表解析消费+逐参
//   登记 泛型参数名们（驻留ID 平铺·语义层豁免消费）；类体经 解析类声明 照常解析
//   （节点_类·基名——实例化单态化=波2）。约束（: 接口名）解析消费不校验（波1 边界·
//   收工回填登记）。泛型 函数 声明=显式诊断不支持（后续轮——绝不静默吞）。
函数 解析泛型类声明(向量<Token> 记号, 整64 位置, 向量<节点> 池,
                  映射<整64, 整64>& 字段偏移表, 整64 是否公开) -> 整64 {
    位置++;   // 消费 泛型
    如果 (!(当前类型(记号, 位置) == 令牌_运算符 &&
           当前ID(记号, 位置) == 整32(驻留("<")))) {
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 泛型 预期 '<'\n");
        语法错误加一();
        返回 位置;
    }
    位置++;
    字符串 参数序串g = "";   // 416-a：基类参数名序（"T,U"·实例化替换序权威）
    当 (真) {
        如果 (当前类型(记号, 位置) == 令牌_文件结束) {
            IO::打印到错误("[parse] 泛型类型参数表未闭合（缺 '>'）\n");
            语法错误加一();
            返回 位置;
        }
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留(">"))) { 位置++; 中断; }
        如果 (!是词(记号, 位置, "类型")) {
            IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 泛型类型参数预期 '类型' 标记\n");
            语法错误加一();
            返回 位置;
        }
        位置++;
        如果 (当前类型(记号, 位置) != 令牌_标识符) {
            IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 泛型类型参数预期名称\n");
            语法错误加一();
            返回 位置;
        }
        登记泛型参数名(整64(当前ID(记号, 位置)));
        // 416-a（D42 波 2）：基类参数序串同步拼装（"T,U"——实例化注册 按序替换）
        如果 (字符串长度(参数序串g) > 0) {
            参数序串g = 字符串复制(参数序串g + "," + 当前文本(记号, 位置));
        } 否则 {
            参数序串g = 字符串复制(当前文本(记号, 位置));
        }
        位置++;
        // 接口约束：类型 T : 接口名（消费不校验——波1 边界）
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留(":"))) {
            位置++;
            如果 (当前类型(记号, 位置) == 令牌_标识符) { 位置++; }
        }
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留(","))) { 位置++; }
    }
    // 417（002 收口·205）：泛型声明后容忍「不安全」修饰词——stdlib 算法.cn
    //   「泛型 <类型 T> 不安全 函数 逆序(...)」形态（宿主 205 绿）。修饰语义
    //   经 解析函数声明 修饰 参数下传（顶层 dispatch 同口径：0=普通/1=不安全）；
    //   其余前导词仍走下方「预期 类 或 函数」诚实诊断。
    整32 泛型修饰g = 0;
    如果 (是关键(记号, 位置, "不安全")) { 泛型修饰g = 1; 位置++; }
    如果 (是关键(记号, 位置, "函数")) {
        // 417-a（D42 波 3）：泛型函数声明——泛型 <类型 T> 函数 名(参数...) {...}
        //   （stdlib 容器/映射集合 线性表辅助·规范 06-十三 函数分支）。函数节点
        //   照常产出（节点_函数·基名）；参数序登记共用 泛型基类参数序们（函数名
        //   ID 键·单态化=克隆器函数版）。实例化调用点=名<实参>(...)（417-a 调用侧）。
        位置++;
        // 函数名在 位置（消费 函数 后）——登记参数序须在函数体解析后（与类同序防御）
        整64 函名IDg = 0;
        如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_标识符) {
            函名IDg = 整64(当前ID(记号, 位置));
        }
        整64 结果位置f = 解析函数声明(记号, 位置, 池, 字段偏移表, 泛型修饰g);
        如果 (函名IDg != 0 && 字符串长度(参数序串g) > 0) {
            登记泛型基类参数序(函名IDg, 参数序串g);
        }
        返回 结果位置f;
    }
    如果 (!是关键(记号, 位置, "类")) {
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 泛型声明后预期 类 或 函数\n");
        语法错误加一();
        返回 位置;
    }
    // 416-a（D42 波 2）：基类参数序登记——次序在 解析类声明 后（其内部登记
    //   用户类基名·登记泛型基类参数序 有类表存在防御）。
    整64 基名IDg = 0;
    如果 (位置 + 1 < 记号.大小() && 当前类型(记号, 位置 + 1) == 令牌_标识符) {
        基名IDg = 整64(当前ID(记号, 位置 + 1));
    }
    整64 结果位置g = 解析类声明(记号, 位置, 池, 字段偏移表, 是否公开);
    如果 (基名IDg != 0 && 字符串长度(参数序串g) > 0) {
        登记泛型基类参数序(基名IDg, 参数序串g);
    }
    返回 结果位置g;
}

// 解析类声明：类 名 [ : 基类, 接口... ] { 类体 } —— 234（2026-10-06·91303）起
//   支持单类继承（`: 基类名`·基类须先于派生类声明）；413（2026-10-11）起支持
//   接口实现（`: 接口名[, 接口名...]`·接口须先于实现类声明——登记接口表双向
//   关系+分配对象接口区。宿主 parser_oop「冒号后父类或接口·逗号分隔」同构：
//   首名可为基类或接口〔首名为接口=无基类纯实现〕，逗号后续名均按接口解析）。
// 后续兼容位（诚实边界）：访问标签 公开:/私有:/保护: 解析消费但不强制访问控制；
//   方法重载不支持（同名方法唯一——重复登记诊断）。
// 类体成员循环不推进时强制前进一 token（防诊断路径死循环）。
// 413 原单名实现由 多名分派 取代（接口名走接口表登记·未知名显式诊断）。
不安全 函数 解析类继承登记(向量<Token> 记号, 整64 位置, 整64 类名ID, 整64* 基名ID出) -> 整64 {
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(":"))) {
        位置++;
        当 (真) {
            如果 (!(当前类型(记号, 位置) == 令牌_标识符)) {
                IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                               ": 继承冒号后预期基类名或接口名\n");
                语法错误加一();
                返回 位置;
            }
            整64 名j = 整64(当前ID(记号, 位置));
            位置++;
            // 分派：基类名（单继承——第二基类名诊断）/ 接口名（登记实现关系）/
            //   未知名（显式诊断——未声明即用=诚实边界，与基类「须先声明」同纪律）
            如果 (是接口名ID(名j)) {
                登记类实现接口(类名ID, 名j);
            } 否则 如果 (是用户类ID(名j)) {
                如果 (基名ID出[0] != 0) {
                    IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                                   ": v2 单继承——类 " + 驻留文本(整64(类名ID)) +
                                   " 已有基类 " + 驻留文本(基名ID出[0]) + "\n");
                    语法错误加一();
                } 否则 {
                    登记类基名(类名ID, 名j);
                    // 413-b（审查 P0-1 根治）：基类沿链实现接口补登到本类——
                    //   接口实现类数 直登计数含继承并入（宿主 interfaceImplClasses
                    //   跨链收集同口径）：A:I → B:A 时 I 的实现集合={A,B}，经 I 的
                    //   调用走间接分派·接口槽按最近重写生效（多态保留）。原只显式
                    //   「: 接口名」+1 → 唯一实现误判 → B 对象经接口静态直调 A 实现
                    //   =多态被静态化（实测宿主 2/v2 1 分叉实录）。基类先于派生类
                    //   声明（与布局合成同时序前提）→ 此处基类接口已全登记。
                    //   宿主同判定排除抽象类（ci.isAbstract 不构成实现目标）——
                    //   193 任务193 起消费侧同步：生成类尾 直调判定以 是抽象类ID
                    //   排除抽象类（唯一实现为抽象类回退间接分派）。
                    整64 序b413 = 0;
                    当 (序b413 < 接口方法序数()) {
                        如果 (类实现接口沿链(名j, 接口槽取接口(序b413))) {
                            登记类实现接口(类名ID, 接口槽取接口(序b413));
                        }
                        序b413++;
                    }
                    基名ID出[0] = 名j;
                }
            } 否则 {
                IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                               ": 未声明的基类或接口: " + 驻留文本(名j) +
                               "（类 " + 驻留文本(整64(类名ID)) + "）\n");
                语法错误加一();
            }
            如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == 整32(驻留(","))) {
                位置++;
                继续;
            }
            中断;
        }
    }
    返回 位置;
}

// 234：类体虚声明预扫（布局头时序——字段推进前须定 vtable 首槽有无）。
//   精确模式扫描：标识符「虚拟」/「重写」后随关键「函数」才算（上下文关键字·
//   方法体内标识符/字符串不误命中·嵌套 {} 计数到类体平衡）。
函数 类体有虚声明(向量<Token> 记号, 整64 位置) -> 布尔 {
    整64 深y = 1;
    当 (位置 < 记号.大小()) {
        如果 (当前类型(记号, 位置) == 令牌_文件结束) { 返回 假; }
        如果 (当前类型(记号, 位置) == 令牌_运算符) {
            如果 (当前ID(记号, 位置) == 整32(驻留("{"))) { 深y++; }
            如果 (当前ID(记号, 位置) == 整32(驻留("}"))) {
                深y--;
                如果 (深y == 0) { 返回 假; }
            }
        }
        如果 (当前类型(记号, 位置) == 令牌_标识符 && 位置 + 1 < 记号.大小() &&
             (字符串比较(当前文本(记号, 位置), "虚拟") ||
              字符串比较(当前文本(记号, 位置), "重写")) &&
             是关键(记号, 位置 + 1, "函数")) {
            返回 真;
        }
        位置++;
    }
    返回 假;
}

// 537-a（§2.115 方案实施·纯机械拆分零行为变更）：解析类布局收口——尾部对齐+
//   布局/变量/用户类三登记+425-a 探针（原块逐字迁移）。返回收口后的位置。
不安全 函数 解析类布局收口(向量<节点> 池, 整32 类名ID, 整64 类键基, 整64 类体起点,
                        整64 字段偏移, 整64 最大对齐, 整64 是否公开, 整64 位置, 整64 基名IDj) -> 整64 {
    // 布局收口：尾部对齐到 最大对齐（同结构体，对齐宿主 computeClassLayout
    //   无虚函数类口径：偏移自 0 起、自然对齐——有虚函数类宿主首 8 字节为
    //   虚表指针，第一版不支持虚函数=无 vtable 首槽）
    // 463：尾对齐前登记**字段区尾 raw**（宿主沿链连续推进·派生字段起点=
    //   父尾 raw+头区——父尾 pad 不让位·732 探针宿主亮@6 铁证）
    登记类字段区尾(整64(类名ID), 字段偏移);
    整64 尾余 = 字段偏移 % 最大对齐;
    如果 (尾余 != 0) { 字段偏移 = 字段偏移 + (最大对齐 - 尾余); }
    登记结构体布局(整64(类名ID), 字段偏移, 最大对齐, 是否公开);
    登记变量结构体(类键基, 1);
    登记用户类(整64(类名ID));
    登记用户类键基(类键基);   // #1252：模块感知类集合（继承位歧义候选过滤）
    // 193（2026-10-13 任务193）：抽象类标志收口**不在解析期**——查类方法定义层
    //   消费的 类方法返回们 表登记于语义收集阶段（语义分析尾 收集类方法·
    //   859 正测误杀实录：解析期收口时方法表全 miss→重写不出集→具体类误判
    //   抽象）。收口挂在语义收集 收集类声明 内（收集类方法 后·父先子后逐类）。
    // 425-a 探针：登记后立即查（表实例同一性·登记/查询同函数域应必真）
    如果 (!是用户类ID(整64(类名ID))) {
        IO::打印到错误("[探针] 登记后立即查失败（同域）: " + 驻留文本(整64(类名ID)) + "\n");
    }
    // #1252：节点_类.附加=基名ID（0=无继承）——语义继承位歧义检查数据源（类节点消费点不读附加）
    池追加(池, 建节点(节点_类, 类名ID, 基名IDj, 整32(类体起点), 整32(池.大小())));
    登记类池索引234(整64(类名ID), 整64(池.大小()) - 1);
    返回 位置;
}
函数 解析类声明(向量<Token> 记号, 整64 位置, 向量<节点> 池,
                 映射<整64, 整64>& 字段偏移表, 整64 是否公开) -> 整64 {
    如果 (是关键(记号, 位置, "类")) { 位置++; }
    整32 类名ID = 当前ID(记号, 位置);
    位置++;
    整64 类键基 = 键基合成(取当前模块路径(), 整64(类名ID));
    整64 基名IDj = 0;
    位置 = 解析类继承登记(记号, 位置, 类名ID, &基名IDj);
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("{"))) { 位置++; }
    否则 {
        // 1031（定界符缺失族·W1 实录·对齐宿主）：类声明体缺 '{'——宿主
        //   「预期 '{'，实际为 'X'」拒绝（原实现静默跳过·类体从成员 token
        //   起错位解析整段吞掉·W1 实录放行）。先例=326 结构体/联合体同款
        //   前向声明拒绝诊断。
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
