// CN 自举编译器 v2 · 解析表达式（千行拆分子模块，2026-09-08 用户裁决阶段目录包）
// 职责：表达式族解析（原子/后缀链/二元层/复合赋值）+ 泛型类型支持（类型文本/
//   构造调用判定/解析类型/解析参数）——自 语法分析.cn 机械搬移（函数与静态
//   归属不变，跨文件经 公开: 函数访问）；模块路径=解析表达式（新键基）。
导入 容器::向量;
导入 映射集合;
导入 词法;       // Token 结构（原 导入 词法分析，目录包名）
导入 IR;         // 节点_*/键位移 常量（原 IR容器+IR常量 合并目录包名）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 解析原子表达式：字面量/标识符/括号。返回结束位置；节点入池。
函数 解析原子(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    整32 t = 当前类型(记号, 位置);
    如果 (t == 令牌_整数字面量) {
        池追加(池, 建节点(节点_整数字面量, 当前ID(记号, 位置), 0, 0, 0));
        返回 位置 + 1;
    }
    如果 (t == 令牌_浮点字面量) {
        池追加(池, 建节点(节点_浮点字面量, 当前ID(记号, 位置), 0, 0, 0));
        返回 位置 + 1;
    }
    如果 (t == 令牌_字符串字面量) {
        池追加(池, 建节点(节点_字符串字面量, 当前ID(记号, 位置), 0, 0, 0));
        返回 位置 + 1;
    }
    如果 (t == 令牌_标识符) {
        // P7b 构造调用：名<实参>( —— 合成 $ 实例名标识符（向量$整64）入池，
        //   后随 '()' 走既有 调用 节点（IR 层据标识符文本是容器实例名判定构造）
        如果 (是构造调用(记号, 位置)) {
            整64 名位置 = 位置;
            字符串 合成名 = 解析类型文本(记号, &名位置, 假);
            池追加(池, 建节点(节点_标识符, 整32(驻留(合成名)), 0, 0, 0));
            返回 名位置;
        }
        池追加(池, 建节点(节点_标识符, 当前ID(记号, 位置), 0, 0, 0));
        返回 位置 + 1;
    }
    // ③ 第五波（2026-09-03）：布尔/空指针字面量 真/假/无（规范 02——词法关键字表
    //   已有，解析层此前零分支=谓词含 真/假 的源码必截断）。
    // 灰色点①根治（2026-09-04）：真/假 独立 节点_布尔字面量（文本=1/0 值）——
    //   语义推导 布尔、IR 登记 T_布尔（打印/拼接分派自动 print_bool/from_bool，
    //   对齐宿主 __cn_print_bool 输出 真/假；原复用整数字面量输出 1/0 两侧分叉）。
    //   无 保持整数字面量 0（空指针语义，与 指针/字符串 的 == 比较走指针语义，
    //   宿主 字符串==无 判空同款；133 EOF 判空载体）。
    如果 (t == 令牌_关键字 && 当前ID(记号, 位置) == 整32(驻留("真"))) {
        池追加(池, 建节点(节点_布尔字面量, 整32(驻留("1")), 0, 0, 0));
        返回 位置 + 1;
    }
    如果 (t == 令牌_关键字 && 当前ID(记号, 位置) == 整32(驻留("假"))) {
        池追加(池, 建节点(节点_布尔字面量, 整32(驻留("0")), 0, 0, 0));
        返回 位置 + 1;
    }
    如果 (t == 令牌_关键字 && 当前ID(记号, 位置) == 整32(驻留("无"))) {
        池追加(池, 建节点(节点_整数字面量, 整32(驻留("0")), 0, 0, 0));
        返回 位置 + 1;
    }
    如果 (t == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("("))) {
        位置++;
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(")"))) { 位置++; }
        返回 位置;
    }
    返回 位置;
}

// 后缀节点类型（P3b）：节点_二元运算/节点_调用/节点_成员/节点_下标/成员方法标记
//   已于簇①A2 单一归属至 IR常量.cn（第二十八轮补全迁移，本文件经 导入 IR常量 消费）。

// ==================== 复合赋值五形态（③ 第二波，方案A 裁决 2026-09-03） ====================
// += -= *= /= %=（词法双字符 token）。原解析层无分支：+= 不消费 -> 解析块循环保护
//   静默中断 -> 块内后续语句丢弃（词法分析.cn 分词 被截断的假绿冒烟根因，探针实锤）。
函数 是复合赋值符(整32 符号ID) -> 布尔 {
    字符串 文本 = 驻留文本(整64(符号ID));
    返回 字符串比较(文本, "+=") || 字符串比较(文本, "-=") ||
           字符串比较(文本, "*=") || 字符串比较(文本, "/=") || 字符串比较(文本, "%=");
}

// 复合赋值符 -> 对应二元运算符（a op= r ≡ a = a op r 的 op）
函数 复合二元符号(整32 符号ID) -> 整32 {
    字符串 文本 = 驻留文本(整64(符号ID));
    如果 (字符串比较(文本, "+=")) { 返回 整32(驻留("+")); }
    如果 (字符串比较(文本, "-=")) { 返回 整32(驻留("-")); }
    如果 (字符串比较(文本, "*=")) { 返回 整32(驻留("*")); }
    如果 (字符串比较(文本, "/=")) { 返回 整32(驻留("/")); }
    返回 整32(驻留("%"));
}

// 表达式入口：一元前缀（! / -）+ 原子 + 后缀（调用/成员/下标）链
函数 解析表达式(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    // 表达式首节点起点（三元包装时作条件段起点回填）
    整64 起始 = 池.大小();
    // 一元前缀（!/-/&/*）只在此处（表达式首 token）判定；操作数紧绑定——层5
    //   （原子+后缀链，嵌套前缀递归同覆，对齐 C 一元优先级 12）。原「递归
    //   解析表达式」把后随 ? 与低层二元吞进操作数（!x ? a : b 变 !(x?a:b)、
    //   !x + 1 变 !(x+1)）——三元接入（优先级 1.5 低于一元）后该语义缺陷
    //   可见化，统一改紧绑定（③ 第六波）：二元/三元由尾段统一处理
    整32 前缀类型 = 0;
    如果 (当前类型(记号, 位置) == 令牌_运算符) {
        整64 查前缀符号 = 整64(当前ID(记号, 位置));
        如果 (查前缀符号 == 驻留("!")) { 前缀类型 = 节点_逻辑非; }
        否则 如果 (查前缀符号 == 驻留("-")) { 前缀类型 = 节点_负号; }
        否则 如果 (查前缀符号 == 驻留("&")) { 前缀类型 = 节点_取地址; }
        否则 如果 (查前缀符号 == 驻留("*")) { 前缀类型 = 节点_解引用; }
    }
    如果 (前缀类型 != 0) {
        位置++;
        位置 = 解析层_子(记号, 位置, 池, 5, 字段偏移表, 真);
        池追加(池, 建节点(前缀类型, 0, 0, 整32(起始), 整32(池.大小())));
    } 否则 {
        位置 = 解析原子(记号, 位置, 池, 字段偏移表);
        位置 = 解析后缀链(记号, 位置, 池, 字段偏移表);
    }
    // P6c：仅当当前位置是二元运算符才进二元链（避免误解析后续标识符为左操作数）
    如果 (当前类型(记号, 位置) == 令牌_运算符) {
        整64 符号 = 整64(当前ID(记号, 位置));
        如果 (符号 == 驻留("+") || 符号 == 驻留("-") || 符号 == 驻留("*") || 符号 == 驻留("/") ||
             符号 == 驻留("%") || 符号 == 驻留("==") || 符号 == 驻留("!=") || 符号 == 驻留("<") ||
             符号 == 驻留(">") || 符号 == 驻留("<=") || 符号 == 驻留(">=") || 符号 == 驻留("&&") ||
             符号 == 驻留("||")) {
            位置 = 解析二元链(记号, 位置, 池, 字段偏移表);
        }
    }
    // 三元条件包装（③ 第六波，规范 01b 5.8）：条件段 = [起始, 池.大小())（本
    //   表达式前段已解析的全部节点——含前缀/原子/后缀链/二元链）。真值/假值
    //   均为完整表达式（递归含嵌套三元——假值递归实现右结合：
    //   a?b:c?d:e = a?b:(c?d:e)）。':' 缺失不消费（防御惯例：上层块循环保护
    //   中断、stderr 可见化——B6）；v2 无后缀错误传播 '?'，'?' 一律三元
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("?"))) {
        位置++;
        整64 真值起点 = 池.大小();
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(":"))) {
            位置++;
        }
        整64 假值起点 = 池.大小();
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        池追加(池, 建节点(节点_三元运算, 整32(真值起点), 假值起点, 整32(起始), 整32(池.大小())));
    }
    返回 位置;
}

// 解析后缀链：连续消费 调用/成员/下标（P6c 提取，供 表达式/二元操作数 复用）
函数 解析后缀链(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    整64 延续 = 1;
    当 (延续 == 1) {
        延续 = 0;
        如果 (当前类型(记号, 位置) == 令牌_运算符) {
            整64 符号 = 整64(当前ID(记号, 位置));
            如果 (符号 == 驻留("(")) {
                位置 = 解析调用后缀(记号, 位置, 池, 字段偏移表);
                延续 = 1;
            } 否则 如果 (符号 == 驻留(".")) {
                位置 = 解析成员后缀(记号, 位置, 池, 字段偏移表);
                延续 = 1;
            } 否则 如果 (符号 == 驻留("->")) {
                // v2.1（2026-09-03 用户裁决）：-> 成员访问已废除（统一 .，指针自动
                //   解引用一级）——后缀位 -> 为硬错误（行为与宿主对齐：拒绝+非零退出；
                //   宿主侧承载富迁移提示「请改用 .」，v2 自举组件按行号码面包屑惯例）。
                //   注意：-> 记号仍用于函数返回类型箭头（上方声明位分支，与本处无关）。
                //   硬错误无法进程内自检（会终止 v2p 自身），拒绝能力由宿主 E2E 135
                //   锚定 + v2 全源码零 -> 用法（E2E 128 链）双覆盖。
                运行时错误(302);
                延续 = 0;
            } 否则 如果 (符号 == 驻留("::")) {
                整64 限定新位置 = 解析限定后缀(记号, 位置, 池, 字段偏移表);
                如果 (限定新位置 != 位置) {
                    位置 = 限定新位置;
                    延续 = 1;
                }
            } 否则 如果 (符号 == 驻留("[")) {
                // ③ 第二波：下标对象节点 = [ 前池末节点（后缀链对象先入池）；
                //   子区间 [子起点, 子终点) = 对象+下标表达式（不含本节点）——
                //   语义层据此检查对象形态（字符串白名单），IR 层弹对象+下标两值。
                //   （原建节点全 0 字段——子区间信息丢失，语义/IR 两层无从消费）
                整64 下标对象索引 = 整64(池.大小()) - 1;
                位置++;
                位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
                如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("]"))) { 位置++; }
                池追加(池, 建节点(节点_下标, 0, 0, 整32(下标对象索引), 整32(池.大小())));
                延续 = 1;
            }
        }
    }
    返回 位置;
}

// 调用后缀（R3 拆分，2026-09-08 自 解析后缀链 机械搬移）：实参表达式解析 +
//   裸名导入绑定原地改写（簇② B1）+ 节点_调用 追加（附加=实参数、
//   子起点=被调标识符节点索引——P6g 语义层类型转换/函数调用识别依据）。
函数 解析调用后缀(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
            整64 参数起点 = 池.大小();
            整64 实参数 = 0;
            位置++;
            如果 (!(当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(")")))) {
                当 (真) {
                    位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
                    实参数++;
                    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(","))) { 位置++; 继续; }
                    中断;
                }
            }
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(")"))) { 位置++; }
            // 簇②根治·B1（2026-09-04 用户裁决）：裸名调用命中 导入项们 →
            //   被调标识符（参数起点前一个节点——与 节点_调用.子起点 同位）
            //   原地改写合成限定名（导入 文件::打开文件 后裸调 打开文件(...)
            //   ≡ 文件::打开文件(...)——第五波限定名机制同构，局部副本+设置
            //   回写；语义白名单/IR 符号映射零改动即通）
            如果 (参数起点 > 0 && 参数起点 <= 池.大小()) {
                节点 被调对象 = 池.元素(参数起点 - 1);
                如果 (被调对象.类型 == 节点_标识符) {
                    整64 查项 = 查导入项绑定(整64(被调对象.文本));
                    如果 (查项 >= 0) {
                        被调对象.文本 = 整32(查项);
                        结果<空类型, 整32> 设被调 = 池.设置(参数起点 - 1, 被调对象);
                        如果 (!设被调.正常) { 运行时错误(4); }
                    }
                }
            }
            // 实参数 存 附加（后缀求值 弹实参数量用；子区间=实参表达式节点数≠实参数）
            // P6g（2026-08-30）：子起点=被调标识符节点索引（参数起点前一个节点——
            //   后缀链原子标识符先入池；语义层据此识别 类型转换/函数调用）
            池追加(池, 建节点(节点_调用, 0, 实参数, 整32(参数起点 - 1), 0));
    返回 位置;
}

// 成员后缀（R3 拆分）：字段偏移按结构体分桶（P6e——对象结构体键/旧扁平键回退）+
//   方法调用形态标记（P7b 成员名后随 "(" -> 成员方法标记）+ 节点_成员 追加
//   （子起点=对象节点索引；子终点恒 0——容器类型经 变量容器表 查询不占节点字段）。
函数 解析成员后缀(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
            整32 成员名 = 当前ID(记号, 位置 + 1);
            位置 += 2;
            // P6e（2026-08-30）：字段偏移按结构体分桶——先经 变量结构体表 推导
            //   对象所属结构体（对象若是标识符），再按 结构体名ID*键位移+字段名ID
            //   查偏移。根治扁平表同名字段串偏移。v2.1（2026-09-03 用户裁决）：
            //   -> 成员访问废除——成员访问统一 .（对象为指针即自动解引用一级，
            //   p.字段 ≡ (*p).字段，原 ./-> 本就同路径同语义，语义/IR 零改动）。
            整64 偏移 = -1;
            整64 对象结构体ID = 0;
            节点 对象节点 = 池.元素(整64(池.大小()) - 1);
            如果 (对象节点.类型 == 节点_标识符) {
                整64 查结构体 = 查变量结构体键(整64(对象节点.文本));
                如果 (查结构体 >= 0) {
                    // 值=结构体名ID（1=结构体名标记，非对象结构体）
                    如果 (查结构体 != 1) {
                        对象结构体ID = 查结构体;
                    }
                }
            }
            如果 (对象结构体ID != 0) {
                结果<整64, 整32> 偏移查 = 字段偏移表.获取(对象结构体ID * 键位移 + 整64(成员名));
                如果 (偏移查.正常) { 偏移 = 偏移查.值; }
            } 否则 {
                // 回退：对象非标识符/未登记——按旧扁平键查（兼容链式 成员.字段）
                结果<整64, 整32> 偏移查2 = 字段偏移表.获取(整64(成员名));
                如果 (偏移查2.正常) { 偏移 = 偏移查2.值; }
            }
            // P7b：方法调用形态（成员名后紧跟 '('，如 表.追加(x)）——附加记
            //   方法标记，IR 层走容器方法调用；否则保持字段偏移（含 -1=未知）
            整64 附加值 = 偏移;
            如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == 整32(驻留("("))) {
                附加值 = 成员方法标记;
            }
            // 子起点=对象节点索引（池中对象在成员前，池大小-1）；子终点恒 0——
            //   对象的容器/结果类型经 查容器类型（变量容器表）查询，不占节点字段
            //   （曾存 子终点=类型ID——语义层把 [子起点,子终点) 当子表达式区间
            //   跨节点提前检查未注册标识符 -> 误报「未声明」，实测踩坑）
            池追加(池, 建节点(节点_成员, 成员名, 附加值, 整32(池.大小()) - 1, 0));
    返回 位置;
}

// 限定名后缀（R3 拆分）：③ 第五波 限定名内置调用 IO::打印到错误(...)——「标识符::
//   标识符(」形态把池尾对象标识符原地改写为合成限定名（与容器构造合成名同构，
//   语义/IR 复用内置函数表）。命中返回新位置（+2）；非该形态返回原位置（上层
//   中断后缀链——静默丢弃家族防线）。
函数 解析限定后缀(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
            布尔 限定命中 = 假;
            如果 (池.大小() > 0) {
                节点 限定对象 = 池.元素(池.大小() - 1);
                如果 (限定对象.类型 == 节点_标识符 &&
                     当前类型(记号, 位置 + 1) == 令牌_标识符 &&
                     位置 + 2 < 记号.大小() &&
                     当前类型(记号, 位置 + 2) == 令牌_运算符 &&
                     当前ID(记号, 位置 + 2) == 整32(驻留("("))) {
                    字符串 限定名 = 驻留文本(整64(限定对象.文本)) + "::" +
                                  当前文本(记号, 位置 + 1);
                    // 局部副本改写 + 设置 回写（元素(i) 是值视图——链式字段写
                    //   非宿主支持形态，124/126 实证：读=返地址、写=设置）
                    限定对象.文本 = 整32(驻留(限定名));
                    结果<空类型, 整32> 设限定 = 池.设置(池.大小() - 1, 限定对象);
                    如果 (!设限定.正常) { 运行时错误(4); }
                    位置 += 2;
                    限定命中 = 真;
                }
            }
    返回 位置;
}


// 二元运算（P3b）：节点_二元运算 常量已单一归属 IR常量.cn（簇①A2）。

// 解析二元链：4 层优先级（P6b 扩展，对标规范 01b 优先级）
//   1=逻辑或 ||；2=逻辑与 &&；3=比较 == != < > <= >=；4=加减 + -；5=乘除 * / %
// 左结合；每层循环贪婪消费本层运算符。
函数 解析二元链(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    // 顶层链入口传 假：调用点（解析表达式 尾段）位置在二元运算符上——左操作数
    //   已由前段解析（空左操作数设计），不做一元前缀判定
    返回 解析二元层(记号, 位置, 池, 1, 字段偏移表, 假);
}

// 解析层_子：层5 -> 解析原子（操作数位含一元前缀）；其余 -> 下一层（操作数位贯通）。
//   操作数位=真：当前位置必为操作数起点（二元链右操作数——运算符已消费），
//   一元前缀（!/-/&/*）判定无二元歧义；=假：二元链入口（位置可能恰在运算符上
//   ——左操作数已由 解析表达式 前段解析的「空左操作数」设计），不做前缀判定
//   （消融实证：入口位判定把二元 -/* 误当前缀——减法/乘法全灭，123/129/130
//   回归实证：`0 - 28` 变 [0,负号(28)]、`f() * 10000` 变 解引用(10000)）。
//   前缀操作数紧绑定（本层递归=原子+后缀链，嵌套前缀同覆，对齐 C 一元优先级）；
//   表达式入口的全表达式贪婪语义保持不变（解析表达式 前缀段），两路径互不干扰。
函数 解析层_子(向量<Token> 记号, 整64 位置, 向量<节点> 池, 整64 层, 映射<整64, 整64>& 字段偏移表, 布尔 操作数位) -> 整64 {
    如果 (层 == 5) {
        如果 (操作数位 && 当前类型(记号, 位置) == 令牌_运算符) {
            整64 查前缀 = 整64(当前ID(记号, 位置));
            整32 前缀类型 = 0;
            如果 (查前缀 == 驻留("!")) { 前缀类型 = 节点_逻辑非; }
            否则 如果 (查前缀 == 驻留("-")) { 前缀类型 = 节点_负号; }
            否则 如果 (查前缀 == 驻留("&")) { 前缀类型 = 节点_取地址; }
            否则 如果 (查前缀 == 驻留("*")) { 前缀类型 = 节点_解引用; }
            如果 (前缀类型 != 0) {
                位置++;
                整64 操作数起点 = 池.大小();
                位置 = 解析层_子(记号, 位置, 池, 5, 字段偏移表, 真);
                池追加(池, 建节点(前缀类型, 0, 0, 整32(操作数起点), 整32(池.大小())));
                返回 位置;
            }
        }
        位置 = 解析原子(记号, 位置, 池, 字段偏移表);
        返回 解析后缀链(记号, 位置, 池, 字段偏移表);
    }
    返回 解析二元层(记号, 位置, 池, 层 + 1, 字段偏移表, 操作数位);
}

// 解析二元层：先子层，再循环本层运算符（左结合）
函数 解析二元层(向量<Token> 记号, 整64 位置, 向量<节点> 池, 整64 层, 映射<整64, 整64>& 字段偏移表, 布尔 操作数位) -> 整64 {
    // 短路层（1=|| 2=&&）记录左操作数首节点——操作数区间标注用（短路求值）。
    //   入口子调用传 假：二元链入口位置可能恰在运算符上（空左操作数设计——
    //   左操作数由 解析表达式 前段解析），此处不做一元前缀判定（防二元 -/* 误判）
    整64 左起点 = 池.大小();
    // 入口子调用贯通 操作数位：本层由 子(上层, 操作数位) 下降而来时入口即外层
    //   右操作数位（前缀该判）；顶层链入口（解析二元链）已显式传 假（运算符位）
    位置 = 解析层_子(记号, 位置, 池, 层, 字段偏移表, 操作数位);
    位置 = 解析二元循环(记号, 位置, 池, 层, 字段偏移表, 左起点);
    返回 位置;
}

// 本层循环：贪婪消费本层运算符（层匹配）
函数 解析二元循环(向量<Token> 记号, 整64 位置, 向量<节点> 池, 整64 层, 映射<整64, 整64>& 字段偏移表, 整64 左起点) -> 整64 {
    如果 (当前类型(记号, 位置) != 令牌_运算符) { 返回 位置; }
    整64 符号 = 整64(当前ID(记号, 位置));
    整64 层匹配 = 0;
    如果 (符号 == 驻留("||")) { 层匹配 = 1; }
    否则 如果 (符号 == 驻留("&&")) { 层匹配 = 2; }
    否则 如果 (符号 == 驻留("==") || 符号 == 驻留("!=") || 符号 == 驻留("<") ||
              符号 == 驻留(">") || 符号 == 驻留("<=") || 符号 == 驻留(">=")) { 层匹配 = 3; }
    否则 如果 (符号 == 驻留("+") || 符号 == 驻留("-")) { 层匹配 = 4; }
    否则 如果 (符号 == 驻留("*") || 符号 == 驻留("/") || 符号 == 驻留("%")) { 层匹配 = 5; }
    如果 (层匹配 == 0 || 层匹配 != 层) { 返回 位置; }
    整32 op符号 = 当前ID(记号, 位置);
    位置++;
    整64 右起点 = 池.大小();
    // ③ 第五波：右操作数子调用传 真（运算符已消费——当前位置必为操作数起点，
    //   一元前缀判定无二元歧义；`X || !f(...)`/`a * -b` 右操作数前缀由此支持）
    位置 = 解析层_子(记号, 位置, 池, 层, 字段偏移表, 真);
    如果 (层 <= 2) {
        // 短路运算符（||/&&）标注操作数后缀区间（缺陷B根治，2026-09-02）：
        //   [子起点, 子终点) = 左右操作数节点区间（不含本节点），附加 = 右操作数
        //   起点。IR 生成据此延迟求值右操作数（规范 930：短路求值语义）。
        池追加(池, 建节点(节点_二元运算, op符号, 右起点, 整32(左起点), 整32(池.大小())));
    } 否则 {
        // ③ 第二波（方案A）：普通二元同样标注 子起点=左起点/附加=右起点（子终点
        //   恒 0 与短路区分——预扫以 子终点!=0 且 op 名双条件识别短路）。IR 生成
        //   拼接左侧末端节点推导兜底据此定位左操作数末节点（右末端=位置-1 已有）。
        池追加(池, 建节点(节点_二元运算, op符号, 右起点, 整32(左起点), 0));
    }
    返回 解析二元循环(记号, 位置, 池, 层, 字段偏移表, 左起点);
}


// ==================== 泛型类型支持（P7b，2026-09-01） ====================
// 合成实例类型名（对标宿主 resolveGenericTypeName/instantiateGeneric）：
//   名<实参1,实参2> -> 名$实参1$实参2（嵌套实参先递归实例化再拼入——扁平 $ 连接，
//   宿主 generics.cpp:346 同款；映射<整64,整64> -> 映射$整64$整64）。
//   v2 全链路（语法/语义/IR/代码生成）统一使用 $ 合成名，生成表达式零转换。

// 泛型角括号约束扫描：从 位置（须为 '<'）平衡扫描找闭合 '>'；
//   尖括号内只允许 标识符/','/'*'/'&'/'<'/'>'（类型形态）——遇其他 token（如
//   比较表达式 a<b && c>d 的 '&&'）返回 -1（非泛型形态）。返回闭合 '>' 的位置。
函数 泛型闭合位置(向量<Token> 记号, 整64 位置) -> 整64 {
    如果 (!(位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
           当前ID(记号, 位置) == 整32(驻留("<")))) { 返回 -1; }
    整64 深度 = 0;
    整64 i = 位置;
    当 (i < 记号.大小()) {
        整32 t = 当前类型(记号, i);
        整64 id = 整64(当前ID(记号, i));
        如果 (t == 令牌_运算符 && id == 整64(驻留("<"))) {
            深度++;
        } 否则 如果 (t == 令牌_运算符 && id == 整64(驻留(">"))) {
            深度--;
            如果 (深度 == 0) { 返回 i; }
        } 否则 如果 (t == 令牌_标识符) {
            // 类型名/类型参数（Token 白名单）
        } 否则 如果 (t == 令牌_运算符 && (id == 整64(驻留(",")) ||
                   id == 整64(驻留("*")) || id == 整64(驻留("&")))) {
            // 逗号分隔 / 指针 / 引用后缀
        } 否则 {
            返回 -1;
        }
        i++;
    }
    返回 -1;
}

// 解析类型文本（P7b）：递归合成 $ 实例名；位置 出参推进。
//   非类型形态返回 空串（位置不动）。参数 是实参：真=泛型实参递归位——后缀
//   `*`/`&` 由本函数消费并入合成名（对齐宿主 canonical 保留尾 `*` 的约定）；
//   假=外层类型位——后缀留给 解析类型 的指针层/引用登记循环（797 区，抢吃会
//   使 整64* 指针层数归零、变量结构体表失配）。
//   簇④根治（2026-09-04，语法分析.cn 冒烟簇②再分诊揪出）：原递归实参只析出
//   裸名（空类型* 只取 空类型），星号留在 token 流使 `结果<空类型*, 整32> 名 = ...`
//   整条声明错位解析（`,` `整32` `>` 成孤儿 token 切成垃圾语句——赋值左值错位
//   报「可写左值」+ 声明名吞掉级联未声明；A/B 探针实证：无星号 0 错/星号 3 错）。
函数 解析类型文本(向量<Token> 记号, 整64* 位置, 布尔 是实参) -> 字符串 {
    如果 (当前类型(记号, 位置[0]) != 令牌_标识符) { 返回 ""; }
    字符串 名 = 驻留文本(整64(当前ID(记号, 位置[0])));
    位置[0] = 位置[0] + 1;
    // plans/018 限定类型语法（2026-09-08，宿主 A-2 对齐——E2E 56 甲::记录）：
    //   标识符 (:: 标识符)+ 合成 "甲::记录" 限定文本——语义层 拆限定名 直查
    //   成员索引；IR 层 布局/常量三级查询 拆分直查键基。多段 a::b::c 全段并入
    //   （宿主尾段绑定同构）；'::' 后非标识符即停（防御残缺形态）。
    当 (当前类型(记号, 位置[0]) == 令牌_运算符 &&
         当前ID(记号, 位置[0]) == 整32(驻留("::")) &&
         位置[0] + 1 < 记号.大小() &&
         当前类型(记号, 位置[0] + 1) == 令牌_标识符) {
        名 = 名 + "::" + 驻留文本(整64(当前ID(记号, 位置[0] + 1)));
        位置[0] = 位置[0] + 2;
    }
    // 泛型实参：类型位置 '<' 无比较歧义（泛型闭合位置 约束扫描防御）
    如果 (当前类型(记号, 位置[0]) == 令牌_运算符 &&
         当前ID(记号, 位置[0]) == 整32(驻留("<"))) {
        整64 闭合 = 泛型闭合位置(记号, 位置[0]);
        如果 (闭合 == -1) { 返回 名; }  // 非泛型形态：按裸名（防御，正常不达）
        位置[0] = 位置[0] + 1;  // 吃 '<'
        当 (真) {
            字符串 实参 = 解析类型文本(记号, 位置, 真);
            如果 (字符串长度(实参) > 0) { 名 = 名 + "$" + 实参; }
            如果 (当前类型(记号, 位置[0]) == 令牌_运算符 &&
                 当前ID(记号, 位置[0]) == 整32(驻留(","))) {
                位置[0] = 位置[0] + 1;
                继续;
            }
            中断;
        }
        如果 (当前类型(记号, 位置[0]) == 令牌_运算符 &&
             当前ID(记号, 位置[0]) == 整32(驻留(">"))) { 位置[0] = 位置[0] + 1; }
    }
    // 簇④根治：仅实参位消费后缀 `*`/`&` 并入合成名（空类型* -> 名 + "*"，可多层）
    如果 (是实参) {
        当 (当前类型(记号, 位置[0]) == 令牌_运算符 &&
             (当前ID(记号, 位置[0]) == 整32(驻留("*")) ||
              当前ID(记号, 位置[0]) == 整32(驻留("&")))) {
            名 = 名 + 驻留文本(整64(当前ID(记号, 位置[0])));
            位置[0] = 位置[0] + 1;
        }
    }
    返回 名;
}

// 是泛型声明（P7b）：标识符 <类型实参> 标识符 —— 局部变量/参数声明前瞻
//   （防 a<b 比较表达式误判：约束扫描 + 闭合后必须是标识符=变量名）。
//   IR生成.cn 冒烟 96 错根治（2026-09-04）：闭合后 '& 标识符' 同认——泛型
//   引用局部声明 `向量<IR指令>& 指令 = 函数信息.指令;`（引用后缀留给
//   解析类型 的引用登记循环，与指针层同机制）。裸类型引用（类型& 名）宿主
//   parser 亦不支持——双侧一致边界，不引入。
函数 是泛型声明(向量<Token> 记号, 整64 位置) -> 布尔 {
    如果 (当前类型(记号, 位置) != 令牌_标识符) { 返回 假; }
    如果 (位置 + 1 >= 记号.大小()) { 返回 假; }
    整64 闭合 = 泛型闭合位置(记号, 位置 + 1);
    如果 (闭合 == -1) { 返回 假; }
    如果 (当前类型(记号, 闭合 + 1) == 令牌_标识符) { 返回 真; }
    // 泛型引用声明：闭合后 '&' 且其后是标识符=变量名（解析类型 消费 '&' 置
    //   引用标记 附加=256）
    返回 当前类型(记号, 闭合 + 1) == 令牌_运算符 &&
           当前ID(记号, 闭合 + 1) == 整32(驻留("&")) &&
           闭合 + 2 < 记号.大小() &&
           当前类型(记号, 闭合 + 2) == 令牌_标识符;
}

// 是构造调用（P7b）：标识符 <类型实参> ( —— 如 向量<整64>()。
//   闭合后是 '(' 才认定（防 比较/移位误判）。
函数 是构造调用(向量<Token> 记号, 整64 位置) -> 布尔 {
    如果 (当前类型(记号, 位置) != 令牌_标识符) { 返回 假; }
    如果 (位置 + 1 >= 记号.大小()) { 返回 假; }
    整64 闭合 = 泛型闭合位置(记号, 位置 + 1);
    如果 (闭合 == -1) { 返回 假; }
    如果 (闭合 + 1 >= 记号.大小()) { 返回 假; }
    返回 当前类型(记号, 闭合 + 1) == 令牌_运算符 &&
           当前ID(记号, 闭合 + 1) == 整32(驻留("("));
}

// 解析类型：类型前置，支持 类型* 指针（P6c）/ 泛型实参（P7b）/ & 引用（P7b 登记）
// 节点_类型：文本=$合成类型名ID（向量$整64）或裸名ID；附加=指针层数 + 引用*256
函数 解析类型(向量<Token> 记号, 整64 位置, 向量<节点> 池) -> 整64 {
    如果 (当前类型(记号, 位置) == 令牌_标识符) {
        整64 类型位置 = 位置;
        字符串 合成名 = 解析类型文本(记号, &类型位置, 假);
        如果 (字符串长度(合成名) == 0) { 返回 位置; }
        位置 = 类型位置;
        整32 类型名ID = 整32(驻留(合成名));
        整64 指针层 = 0;
        整64 引用 = 0;
        当 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("*"))) {
            指针层++;
            位置++;
        }
        如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("&"))) {
            引用 = 1;
            位置++;
        }
        池追加(池, 建节点(节点_类型, 类型名ID, 指针层 + 引用 * 256, 0, 0));
        返回 位置;
    }
    返回 位置;
}

// 解析参数：类型 名
函数 解析参数(向量<Token> 记号, 整64 位置, 向量<节点> 池) -> 整64 {
    整64 类型节点 = 池.大小();
    位置 = 解析类型(记号, 位置, 池);
    如果 (当前类型(记号, 位置) == 令牌_标识符) {
        整32 参数名ID = 当前ID(记号, 位置);
        // P6e：参数若是结构体类型（值语义），登记 变量名ID -> 结构体名ID，
        //   成员访问（位置.x）据此推导对象所属结构体、查分桶字段偏移。
        //   ②c D：引用形态（附加=256）同样登记——b.编号 成员基址=槽内容（调用方
        //   结构体地址），IR 层按 引用参数槽们 单独处理基址来源。
        //   第17枚根治（2026-09-06，v2self 实参们槽高字节污染）：指针参数（附加=
        //   指针层 1..255）同样登记——成员访问 出.字段 语法层即标注真偏移（此前
        //   -1=未知直发 IR_字段地址.附加，叠加 IR 层对指针参数取槽地址少解引用 ->
        //   写穿相邻槽）。v2.1 用户裁决：成员访问统一 .，指针自动解引用一级。
        节点 类型节点值 = 池.元素(类型节点);
        如果 (类型节点值.附加 <= 256) {
            // plans/018 类型分桶：登记值=键基（查结构体类型 三级——限定类型支持）
            整64 结构体键p = 查结构体类型(整64(类型节点值.文本));
            如果 (结构体键p != 0) {
                登记变量结构体(整64(参数名ID), 结构体键p);
            }
        }
        // P7b：容器/结果 参数登记 变量容器表（被调内成员调用预标注；引用参数同）
        字符串 参数类型文本 = 驻留文本(整64(类型节点值.文本));
        如果 (是容器类(参数类型文本) || 是结果类型(参数类型文本)) {
            登记变量容器(整64(参数名ID), 整64(类型节点值.文本));
        }
        池追加(池, 建节点(节点_参数, 参数名ID, 整64(类型节点), 0, 0));
        返回 位置 + 1;
    }
    池追加(池, 建节点(节点_参数, 0, 整64(类型节点), 0, 0));
    返回 位置;
}

// 吃分号（plans/015 方案B 强制分号，2026-09-04 用户裁决）：语句必须 ';' 终结——
//   缺失即 stderr 诊断+语法错误数 计数（错误即诊断，块截断静默家族整体消亡）；
//   不推进位置（解析块 循环继续解析下条语句，一次编译报全量缺分号位置——
//   对齐宿主 consumeSemicolon 纪律）。行号取当前 token（下一语句起点）。
函数 吃分号(向量<Token> 记号, 整64 位置) -> 整64 {
    如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
         当前ID(记号, 位置) == 整32(驻留(";"))) {
        返回 位置 + 1;
    }
    语法错误加一();
    整64 行号 = 0;
    如果 (记号.大小() > 0) {
        // 行号取前一 token（语句结尾 token）——对齐宿主 consumeSemicolon
        //   诊断位置纪律（缺陷③连带：原取下一语句起点行，偏 +1）
        整64 取行位置 = 位置 - 1;
        如果 (取行位置 < 0) { 取行位置 = 0; }
        如果 (取行位置 >= 记号.大小()) { 取行位置 = 记号.大小() - 1; }
        行号 = 整64(记号.元素(取行位置).行);
    }
    IO::打印到错误("[parse] 语句缺少分号 ';'（行=" + 整数转字符串(行号) + "）\n");
    返回 位置;
}