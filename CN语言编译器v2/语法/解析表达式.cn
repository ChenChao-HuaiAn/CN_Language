// CN 自举编译器 v2 · 解析表达式（千行拆分子模块，2026-09-08 用户裁决阶段目录包）
// 职责：表达式族解析（原子/后缀链/二元层/复合赋值）+ 泛型类型支持（类型文本/
导入 容器::向量;
导入 映射集合;
导入 词法;       // Token 结构（原 导入 词法分析，目录包名）
导入 IR;         // 节点_*/键位移 常量（原 IR容器+IR常量 合并目录包名）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 解析原子表达式：字面量/标识符/括号。返回结束位置；节点入池。
函数 解析原子(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    整32 t = 当前类型(记号, 位置);
    // 070 波B（1022 深度机）：lambda 表达式（匿名函数）探测——宿主
    //   parser_expr.cpp:490 parsePrimary 同位（[ 捕获 ] ( 参数 ) [-> 返回] { 体 }）。
    如果 (是lambda捕获起始(记号, 位置)) {
        返回 解析lambda原子(记号, 位置, 池, 字段偏移表);
    }
    // 389-a（D43）：别名关键字不可作表达式原子（宿主「预期表达式，实际为
    //   '整数'」对齐——原 v2 静默吞「整32 整数 = 7」形态=分叉）
    // 657-a（024/D43 单一归属收口）：谓词收敛至 是别名关键字（解析基础.cn）
    如果 (是别名关键字(记号, 位置)) {
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                       ": 预期表达式，实际为 '" + 当前文本(记号, 位置) +
                       "'（内置类型别名不可作标识符）\n");
        语法错误加一();
        返回 位置;
    }
    如果 (t == 令牌_整数字面量) {
        池追加(池, 建节点(节点_整数字面量, 当前ID(记号, 位置), 0, 0, 0));
        返回 位置 + 1;
    }
    如果 (t == 令牌_浮点字面量) {
        池追加(池, 建节点(节点_浮点字面量, 当前ID(记号, 位置), 0, 0, 0));
        返回 位置 + 1;
    }
    如果 (t == 令牌_字符串字面量) {
        池追加(池, 建节点(节点_字符串字面量, 当前ID(记号, 位置), 0, 0, 0));
        返回 位置 + 1;
    }
    // 95-a（2026-09-13 第九十五轮）：字符字面量（规范 01b 三）——词法层已解码为
    //   Unicode 码点数字文本（'A'->"65"），本层建独立节点（类型=字符，供语义/
    //   打印分派区分整数字面量）；IR 层按 IR_常量整数 + T_字符 生成。
    如果 (t == 令牌_字符字面量) {
        池追加(池, 建节点(节点_字符字面量, 当前ID(记号, 位置), 0, 0, 0));
        返回 位置 + 1;
    }
    如果 (t == 令牌_标识符) {
        // 84-a（2026-09-12 第八十四轮）：**结构体字面量作实参**（`收(盒子{ 名 = "x", 号 = 6 })`）
        //   ——原 v2 的结构体字面量只是解析期脱糖（仅声明/赋值/成员赋值三位），
        整64 字面量位置 = -1;
        如果 (!条件位抑制哨兵177) {
            字面量位置 = 解析结构体字面量原子(记号, 位置, 池, 字段偏移表);
        }
        如果 (字面量位置 != -1) { 返回 字面量位置; }
        // P7b 构造调用：名<实参>( —— 合成 $ 实例名标识符（向量$整64）入池，
        //   后随 '()' 走既有 调用 节点（IR 层据标识符文本是容器实例名判定构造）
        如果 (是构造调用(记号, 位置)) {
            整64 名位置 = 位置;
            字符串 合成名 = 解析类型文本(记号, &名位置, 假);
            池追加(池, 建节点(节点_标识符, 整32(驻留(合成名)), 0, 0, 0));
            返回 名位置;
        }
        池追加(池, 建节点(节点_标识符, 静态名归一86(当前ID(记号, 位置)), 0, 0, 0));
        返回 位置 + 1;
    }
    // ③ 第五波（2026-09-03）：布尔/空指针字面量 真/假/无（规范 02——词法关键字表
    //   已有，解析层此前零分支=谓词含 真/假 的源码必截断）。
    如果 (t == 令牌_关键字 && 当前ID(记号, 位置) == 整32(驻留("真"))) {
        池追加(池, 建节点(节点_布尔字面量, 整32(驻留("1")), 0, 0, 0));
        返回 位置 + 1;
    }
    如果 (t == 令牌_关键字 && 当前ID(记号, 位置) == 整32(驻留("假"))) {
        池追加(池, 建节点(节点_布尔字面量, 整32(驻留("0")), 0, 0, 0));
        返回 位置 + 1;
    }
    如果 (t == 令牌_关键字 && 当前ID(记号, 位置) == 整32(驻留("无"))) {
        // 153-a（plans/023 B11）：**附加=1 标记「无」**（空指针字面量）——保持整数字面量 0 的既有语义
        //   （比较/133 判空载体）；语义层据 附加==1 识别常量空指针解引用（*无 → 硬错误·与宿主 B11 同构）。
        池追加(池, 建节点(节点_整数字面量, 整32(驻留("0")), 1, 0, 0));
        返回 位置 + 1;
    }
    // 271（用户批甲案·270 翻案根源）：自身 关键字化——表达式位 this 语义承接（文本判定层零改动）；名字位词法拒绝=宿主 Kw_Self 对齐
    如果 (t == 令牌_关键字 && 当前ID(记号, 位置) == 整32(驻留("自身"))) { 池追加(池, 建节点(节点_标识符, 整32(驻留("自身")), 0, 0, 0)); 返回 位置 + 1; }
    如果 (t == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("("))) {
        // 575-a（T100·417 对齐宿主 kMaxAstDepth=128·parser.hpp:70）：表达式嵌套深度上限——超限诊断+剪枝返回
        //   （防解析递归栈溢出；宿主 parser_expr.cpp AstDepthGuard 同款；语法错误已置=fail-fast）。
        表达式嵌套深度417++;
        如果 (表达式嵌套深度417 > 128) {
            表达式嵌套深度417--;
            IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                           ": 表达式嵌套过深（超过 128 层上限）\n");
            语法错误加一();
            返回 位置 + 1;
        }
        位置++;
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        表达式嵌套深度417--;
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(")"))) { 位置++; }
        返回 位置;
    }
    返回 位置;
}

// 575-a（T100·417）：表达式括号嵌套深度计数（解析原子 括号递归专用）
静态 整32 表达式嵌套深度417 = 0;

// 177（甲案·2026-10-05 用户裁决·001 §5.5 消歧条文）：条件位抑制哨兵——
//   如果/当 条件表达式解析期间禁 结构体字面量原子 探测（条件尾标识符+{ 的 {
静态 布尔 条件位抑制哨兵177 = 假;

不安全 函数 条件位抑制177开启() -> 空类型 {
    条件位抑制哨兵177 = 真;
}

不安全 函数 条件位抑制177恢复(布尔 旧值) -> 空类型 {
    条件位抑制哨兵177 = 旧值;
}

// 861-a（002 攻族 G-N）：数组初始化列表解析——`{ e1, e2, ... }` 形态（单一归属）。
//   规范 03 §262：数组初始化列表（C 风格 `{ ... }`）。调用方保证当前 token='{'；
函数 解析数组初始化列表(向量<Token> 记号, 整64 位置, 向量<节点> 池,
                        映射<整64, 整64>& 字段偏移表) -> 整64 {
    位置++;   // 吃 '{'
    整64 元素起点86 = 池.大小();
    当 (位置 < 记号.大小() &&
          !(当前类型(记号, 位置) == 令牌_运算符 &&
            当前ID(记号, 位置) == 整32(驻留("}")))) {
        整64 单个起86 = 池.大小();
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        整64 单个终86 = 池.大小();
        池追加(池, 建节点(节点_数组元素, 0, 0, 整32(单个起86), 整32(单个终86)));
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留(","))) {
            位置++;
        } 否则 { 中断; }
    }
    整64 元素终点86 = 池.大小();
    如果 (当前类型(记号, 位置) == 令牌_运算符 &&
         当前ID(记号, 位置) == 整32(驻留("}"))) {
        位置++;
    }
    池追加(池, 建节点(节点_数组初始化, 0, 0, 整32(元素起点86), 整32(元素终点86)));
    返回 位置;
}

// 208-a（2026-09-15 第两百零八轮，D1 行数整改）：结构体字面量原子（84-a 表达式值/
//   84-b 重复字段 E0062+穷举 E0063——整段迁入含守卫与类型判定；-1=非字面量形态）。
函数 解析结构体字面量原子(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
        如果 (当前类型(记号, 位置 + 1) == 令牌_运算符 &&
             当前ID(记号, 位置 + 1) == 整32(驻留("{"))) {
            整64 类型ID84 = 查结构体类型(整64(当前ID(记号, 位置)));
            如果 (类型ID84 > 0) {
                整64 位置84 = 位置 + 2;
                整64 起始84 = 池.大小();
                整64 字段数84 = 0;
                向量<整32> 已见84 = 向量<整32>();
                当 (真) {
                    如果 (当前类型(记号, 位置84) == 令牌_运算符 &&
                         当前ID(记号, 位置84) == 整32(驻留("}"))) { 位置84++; 中断; }
                    如果 (当前类型(记号, 位置84) == 令牌_文件结束) {
                        语法错误加一();
                        IO::打印到错误("[parse] 结构体构造字面量未闭合\n");
                        中断;
                    }
                    如果 (当前类型(记号, 位置84) != 令牌_标识符) {
                        语法错误加一();
                        IO::打印到错误("[parse] 结构体构造字面量: 字段名须为标识符\n");
                        中断;
                    }
                    整64 字段名84 = 整64(当前ID(记号, 位置84));
                    // 84-b：重复字段校验（Rust E0062 同构；与旧脱糖位 解析构造字段赋值们
                    //   同源文本——`解析语句.cn` 声明/赋值/成员三位）
                    布尔 已见f84 = 假;
                    整64 k84 = 0;
                    当 (k84 < 已见84.大小()) {
                        如果 (整64(已见84.元素(k84)) == 字段名84) { 已见f84 = 真; }
                        k84++;
                    }
                    如果 (已见f84) {
                        语法错误加一();
                        IO::打印到错误("[parse] 结构体初始化字段 '" +
                                      驻留文本(字段名84) + "' 重复（行=" +
                                      整数转字符串(整64(记号.元素(位置84).行)) + "）\n");
                    } 否则 {
                        结果<空类型, 整32> 加见84 = 已见84.追加(整32(字段名84));
                        如果 (!加见84.正常) { 运行时错误(4); }
                    }
                    位置84++;
                    如果 (当前类型(记号, 位置84) == 令牌_运算符 &&
                         当前ID(记号, 位置84) == 整32(驻留("="))) { 位置84++; }
                    整64 值起84 = 池.大小();
                    // 861-a（002 攻族 G-N）：数组类型字段的初始化列表 `{ e1, e2, ... }`
                    //   ——规范 03 §262 数组初始化列表的字段位形态（宿主同款：字段
                    布尔 数组字段84 = 假;
                    整64 字段t84 = 查字段类型ID(类型ID84, 字段名84);
                    如果 (字段t84 > 0) {
                        数组字段84 = 是数组类型文本(字符串复制(驻留文本(字段t84)));
                    }
                    如果 (数组字段84 &&
                        当前类型(记号, 位置84) == 令牌_运算符 &&
                        当前ID(记号, 位置84) == 整32(驻留("{"))) {
                        位置84 = 解析数组初始化列表(记号, 位置84, 池, 字段偏移表);
                    } 否则 {
                        位置84 = 解析表达式(记号, 位置84, 池, 字段偏移表);
                    }
                    整64 值止84 = 池.大小();
                    整64 偏移84 = 0 - 1;
                    结果<整64, 整32> 查偏84 = 字段偏移表.获取(类型ID84 * 键位移 + 字段名84);
                    如果 (查偏84.正常) { 偏移84 = 查偏84.值; }
                    池追加(池, 建节点(节点_字段初值, 整32(字段名84), 偏移84,
                                     整32(值起84), 整32(值止84)));
                    字段数84++;
                    如果 (当前类型(记号, 位置84) == 令牌_运算符 &&
                         当前ID(记号, 位置84) == 整32(驻留(","))) { 位置84++; }
                }
                // 84-b：穷举校验（Rust E0063 同构）——字段清单逐序比对，缺一即错
                //   （与旧脱糖位 解析构造字段赋值们 同源文本）
                整64 应有84 = 构造字段数(类型ID84);
                整64 序84 = 0;
                当 (序84 < 应有84) {
                    整64 字段n84 = 构造字段名(类型ID84, 序84);
                    布尔 找到84 = 假;
                    整64 k2_84 = 0;
                    当 (k2_84 < 已见84.大小()) {
                        如果 (整64(已见84.元素(k2_84)) == 字段n84) { 找到84 = 真; }
                        k2_84++;
                    }
                    如果 (!找到84) {
                        语法错误加一();
                        IO::打印到错误("[parse] 结构体 '" + 驻留文本(类型ID84) +
                                      "' 初始化缺少字段 '" + 驻留文本(字段n84) + "'（行=" +
                                      整数转字符串(整64(记号.元素(位置84 - 1).行)) + "）\n");
                    }
                    序84++;
                }
                整64 终84 = 池.大小();
                池追加(池, 建节点(节点_结构体构造, 整32(类型ID84), 字段数84,
                                 整32(起始84), 整32(终84)));
                返回 位置84;
        }
    }
    返回 -1;
}


// 后缀节点类型（P3b）：节点_二元运算/节点_调用/节点_成员/节点_下标/成员方法标记
//   已于簇①A2 单一归属至 IR常量.cn（第二十八轮补全迁移，本文件经 导入 IR常量 消费）。

// ==================== 复合赋值十形态（③ 第二波五算术 + 2026-09-09 位五形态） ====================
// += -= *= /= %= &= |= ^= <<= >>=（词法多字符 token）。原解析层无分支：+= 不消费 ->
函数 是复合赋值符(整32 符号ID) -> 布尔 {
    字符串 文本 = 字符串复制(驻留文本(整64(符号ID)));
    返回 字符串比较(文本, "+=") || 字符串比较(文本, "-=") ||
           字符串比较(文本, "*=") || 字符串比较(文本, "/=") || 字符串比较(文本, "%=") ||
           字符串比较(文本, "&=") || 字符串比较(文本, "|=") || 字符串比较(文本, "^=") ||
           字符串比较(文本, "<<=") || 字符串比较(文本, ">>=");
}

// 复合赋值符 -> 对应二元运算符（a op= r ≡ a = a op r 的 op）
函数 复合二元符号(整32 符号ID) -> 整32 {
    字符串 文本 = 字符串复制(驻留文本(整64(符号ID)));
    如果 (字符串比较(文本, "+=")) { 返回 整32(驻留("+")); }
    如果 (字符串比较(文本, "-=")) { 返回 整32(驻留("-")); }
    如果 (字符串比较(文本, "*=")) { 返回 整32(驻留("*")); }
    如果 (字符串比较(文本, "/=")) { 返回 整32(驻留("/")); }
    如果 (字符串比较(文本, "%=")) { 返回 整32(驻留("%")); }
    如果 (字符串比较(文本, "&=")) { 返回 整32(驻留("&")); }
    如果 (字符串比较(文本, "|=")) { 返回 整32(驻留("|")); }
    如果 (字符串比较(文本, "^=")) { 返回 整32(驻留("^")); }
    如果 (字符串比较(文本, "<<=")) { 返回 整32(驻留("<<")); }
    返回 整32(驻留(">>"));
}

// 894-a（070·G-N 特性波3·2026-09-29）：'?' 后同层 ':' 配对前瞻（宿主 297-a
//   B10 方案甲 Parser::ternaryColonAhead 逐行同构）——从 '?' 下一 token 起扫描：
函数 三元冒号前瞻(向量<Token> 记号, 整64 位置) -> 布尔 {
    整64 深度 = 0;
    整64 探 = 位置 + 1;
    当 (探 < 整64(记号.大小())) {
        如果 (当前类型(记号, 探) == 令牌_运算符) {
            整64 符号c = 整64(当前ID(记号, 探));
            如果 (符号c == 驻留("?") || 符号c == 驻留("(") ||
                 符号c == 驻留("[") || 符号c == 驻留("{")) {
                深度++;
            } 否则 如果 (符号c == 驻留(":")) {
                如果 (深度 == 0) { 返回 真; }
                深度--;
            } 否则 如果 (符号c == 驻留(")") || 符号c == 驻留("]") ||
                        符号c == 驻留("}")) {
                如果 (深度 == 0) { 返回 假; }
                深度--;
            } 否则 如果 (符号c == 驻留(";") || 符号c == 驻留(",")) {
                返回 假;
            }
        }
        探++;
    }
    返回 假;
}

// 表达式入口：一元前缀（! / - / ~ / & / *）+ 原子 + 后缀（调用/成员/下标）链
函数 解析表达式(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    // 表达式首节点起点（三元包装时作条件段起点回填）
    整64 起始 = 池.大小();
    // 一元前缀（!/-/~/&/*）只在此处（表达式首 token）判定；操作数紧绑定——层11
    //   （原子+后缀链，嵌套前缀递归同覆，对齐 C 一元优先级 12）。原「递归
    整32 前缀类型 = 0;
    如果 (当前类型(记号, 位置) == 令牌_运算符) {
        整64 查前缀符号 = 整64(当前ID(记号, 位置));
        如果 (查前缀符号 == 驻留("!")) { 前缀类型 = 节点_逻辑非; }
        否则 如果 (查前缀符号 == 驻留("-")) { 前缀类型 = 节点_负号; }
        否则 如果 (查前缀符号 == 驻留("&")) { 前缀类型 = 节点_取地址; }
        否则 如果 (查前缀符号 == 驻留("*")) { 前缀类型 = 节点_解引用; }
        否则 如果 (查前缀符号 == 驻留("~")) { 前缀类型 = 节点_位非; }
        否则 如果 (查前缀符号 == 驻留("++") || 查前缀符号 == 驻留("--")) {
            前缀类型 = 节点_自增表达式;   // 894-a：前缀 ++/-- 表达式位（值=新值）
        }
    }
    如果 (前缀类型 == 节点_自增表达式) {
        // 894-a：前缀 ++q（值=自增后新值·宿主 parsePrefix UnaryExpr Increment 同构）
        整32 前缀符894 = 当前ID(记号, 位置);
        位置++;
        位置 = 解析层_子(记号, 位置, 池, 11, 字段偏移表, 真, 整64(池.大小()));
        池追加(池, 建节点(节点_自增表达式, 前缀符894, 1, 整32(起始), 整32(池.大小())));
    } 否则 如果 (前缀类型 == 节点_位非) {
        位置++;
        位置 = 解析层_子(记号, 位置, 池, 11, 字段偏移表, 真, 整64(池.大小()));
        池追加(池, 建节点(节点_整数字面量, 整32(驻留("1")), 0, 0, 0));
        池追加(池, 建节点(节点_负号, 0, 0, 整32(整64(池.大小()) - 1), 整32(池.大小())));
        整64 负一索引 = 整64(池.大小()) - 1;
        池追加(池, 建节点(节点_二元运算, 整32(驻留("^")), 整32(负一索引), 整32(起始), 0));
    } 否则 如果 (前缀类型 != 0) {
        位置++;
        位置 = 解析层_子(记号, 位置, 池, 11, 字段偏移表, 真, 整64(池.大小()));
        池追加(池, 建节点(前缀类型, 0, 0, 整32(起始), 整32(池.大小())));
    } 否则 {
        位置 = 解析原子(记号, 位置, 池, 字段偏移表);
        位置 = 解析后缀链(记号, 位置, 池, 字段偏移表);
        // 894-a（070·G-N 特性波3）：后缀 ++/-- 表达式位（407——`j = i++` 值=旧值）
        //   ——后缀链产物区间=[起始,池.大小()) 整体为左值；语句位纯标识符形态
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             (当前ID(记号, 位置) == 整32(驻留("++")) ||
              当前ID(记号, 位置) == 整32(驻留("--")))) {
            整32 后缀符894 = 当前ID(记号, 位置);
            位置++;
            池追加(池, 建节点(节点_自增表达式, 后缀符894, 0,
                              整32(起始), 整32(池.大小())));
        }
    }
    // P6c：仅当当前位置是二元运算符才进二元链（避免误解析后续标识符为左操作数）
    如果 (当前类型(记号, 位置) == 令牌_运算符) {
        整64 符号 = 整64(当前ID(记号, 位置));
        如果 (符号 == 驻留("+") || 符号 == 驻留("-") || 符号 == 驻留("*") || 符号 == 驻留("/") ||
             符号 == 驻留("%") || 符号 == 驻留("==") || 符号 == 驻留("!=") || 符号 == 驻留("<") ||
             符号 == 驻留(">") || 符号 == 驻留("<=") || 符号 == 驻留(">=") || 符号 == 驻留("&&") ||
             符号 == 驻留("||") || 符号 == 驻留("&") || 符号 == 驻留("|") || 符号 == 驻留("^") ||
             符号 == 驻留("<<") || 符号 == 驻留(">>")) {
            // 88-a（2026-09-12）：左操作数起点=表达式起点（本表达式前段已解析内容的首节点）
            //   ——原实现 解析二元链 内部自记 池.大小()（=左操作数**之后**）见下
            位置 = 解析二元链(记号, 位置, 池, 字段偏移表, 起始);
        }
    }
    // 三元条件包装（③ 第六波，规范 01b 5.8）：条件段 = [起始, 池.大小())（本
    //   表达式前段已解析的全部节点——含前缀/原子/后缀链/二元链）。真值/假值
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("?")) &&
         !三元冒号前瞻(记号, 位置)) {
        位置++;
        池追加(池, 建节点(节点_错误传播, 0, 0, 整32(起始), 整32(池.大小())));
        // (x?) + 1 续接：传播节点后继续二元链（宿主「后缀位保证 表达式? + 1
        //   继续二元链」同语义）；之后仍可三元（(x?+1) ? a : b·右结合递归）
        如果 (当前类型(记号, 位置) == 令牌_运算符) {
            整64 符号p = 整64(当前ID(记号, 位置));
            如果 (符号p == 驻留("+") || 符号p == 驻留("-") || 符号p == 驻留("*") || 符号p == 驻留("/") ||
                 符号p == 驻留("%") || 符号p == 驻留("==") || 符号p == 驻留("!=") || 符号p == 驻留("<") ||
                 符号p == 驻留(">") || 符号p == 驻留("<=") || 符号p == 驻留(">=") || 符号p == 驻留("&&") ||
                 符号p == 驻留("||") || 符号p == 驻留("&") || 符号p == 驻留("|") || 符号p == 驻留("^") ||
                 符号p == 驻留("<<") || 符号p == 驻留(">>")) {
                位置 = 解析二元链(记号, 位置, 池, 字段偏移表, 起始);
            }
        }
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("?")) &&
             三元冒号前瞻(记号, 位置)) {
            位置++;
            整64 真值起点p = 池.大小();
            位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(":"))) {
                位置++;
            }
            整64 假值起点p = 池.大小();
            位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
            池追加(池, 建节点(节点_三元运算, 整32(真值起点p), 假值起点p, 整32(起始), 整32(池.大小())));
        }
        返回 位置;
    }
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("?"))) {
        位置++;
        整64 真值起点 = 池.大小();
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(":"))) {
            位置++;
        }
        整64 假值起点 = 池.大小();
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        池追加(池, 建节点(节点_三元运算, 整32(真值起点), 假值起点, 整32(起始), 整32(池.大小())));
    }
    // 894-a（070·G-N 特性波3）：赋值表达式位（287 链式赋值 `整32 y = x = 5;`）——
    //   赋值为最低优先级表达式（宿主 Parser::parseAssignment 同构：先三元、
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("="))) {
        整64 左值节点a = 池.大小() - 1;
        如果 (左值节点a >= 起始) {
            节点 左值根a = 池.元素(整32(左值节点a));
            如果 (左值根a.类型 == 节点_标识符) {
                位置++;   // 消费 '='
                整64 右值起a = 池.大小();
                位置 = 解析表达式(记号, 位置, 池, 字段偏移表);   // 右结合递归（a = b = c）
                池追加(池, 建节点(节点_赋值, 左值根a.文本, 0,
                                  整32(右值起a), 整32(池.大小())));
            }
        }
    }
    返回 位置;
}

// 解析后缀链：连续消费 调用/成员/下标（P6c 提取，供 表达式/二元操作数 复用）
函数 解析后缀链(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    整64 延续 = 1;
    当 (延续 == 1) {
        延续 = 0;
        如果 (当前类型(记号, 位置) == 令牌_运算符) {
            整64 符号 = 整64(当前ID(记号, 位置));
            如果 (符号 == 驻留("(")) {
                位置 = 解析调用后缀(记号, 位置, 池, 字段偏移表);
                延续 = 1;
            } 否则 如果 (符号 == 驻留(".")) {
                位置 = 解析成员后缀(记号, 位置, 池, 字段偏移表);
                延续 = 1;
            } 否则 如果 (符号 == 驻留("->")) {
                // v2.1（2026-09-03 用户裁决）：-> 成员访问已废除（统一 .，指针自动
                //   解引用一级）——后缀位 -> 为硬错误（行为与宿主对齐：拒绝+非零退出；
                IO::打印到错误("[parse] -> 成员访问已废除（统一 .，指针自动解引用一级）\n");
                语法错误加一();
                位置++;
                延续 = 0;
            } 否则 如果 (符号 == 驻留("::")) {
                整64 限定新位置 = 解析限定后缀(记号, 位置, 池, 字段偏移表);
                如果 (限定新位置 != 位置) {
                    位置 = 限定新位置;
                    延续 = 1;
                }
            } 否则 如果 (符号 == 驻留("[")) {
                // ③ 第二波：下标对象节点 = [ 前池末节点（后缀链对象先入池）；
                //   子区间 [子起点, 子终点) = 对象+下标表达式（不含本节点）——
                整64 下标对象索引 = 整64(池.大小()) - 1;
                位置++;
                位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
                如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("]"))) { 位置++; }
                池追加(池, 建节点(节点_下标, 0, 0, 整32(下标对象索引), 整32(池.大小())));
                延续 = 1;
            }
        }
    }
    返回 位置;
}

// 调用后缀（R3 拆分，2026-09-08 自 解析后缀链 机械搬移）：实参表达式解析 +
//   裸名导入绑定原地改写（簇② B1）+ 节点_调用 追加（附加=实参数、
静态 映射<整64, 整64> 调用实参末位们;

函数 查调用实参末位(整64 调用节点索引, 整64 实参序) -> 整64 {
    结果<整64, 整32> 查 = 调用实参末位们.获取(调用节点索引 * 键位移 + 实参序);
    如果 (查.正常) { 返回 查.值; }
    返回 -1;
}

函数 解析调用后缀(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
            整64 参数起点 = 池.大小();
            整64 实参数 = 0;
            向量<整64> 实参末位们局部 = 向量<整64>();
            位置++;
            如果 (!(当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(")")))) {
                当 (真) {
                    // 1017（171 转批·缺陷二根治·宿主同构）：类型大小 首实参=类型
                    //   语法——按 解析类型文本(是实参=真) 消费（簇④吃 '*'/'&'/
                    布尔 类型实参1017 = 假;
                    如果 (实参数 == 0 && 参数起点 > 0) {
                        节点 被调1017 = 池.元素(参数起点 - 1);
                        如果 (被调1017.类型 == 节点_标识符 &&
                             字符串比较(驻留文本(整64(被调1017.文本)), "类型大小")) {
                            类型实参1017 = 真;
                        }
                    }
                    如果 (类型实参1017) {
                        整64 类型位1017 = 位置;
                        字符串 类型文本1017 = 解析类型文本(记号, &类型位1017, 真);
                        如果 (字符串长度(类型文本1017) > 0) {
                            位置 = 类型位1017;
                            池追加(池, 建节点(节点_标识符, 整32(驻留(类型文本1017)), 0, 0, 0));
                            实参数++;
                            结果<空类型, 整32> 加末位1017 = 实参末位们局部.追加(池.大小() - 1);
                            如果 (!加末位1017.正常) { 运行时错误(4); }
                            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(","))) { 位置++; 继续; }
                            中断;
                        }
                        // 类型文本空=实参非类型形态（防御）——落回表达式路径
                    }
                    位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
                    实参数++;
                    // plans/019 阶段3b：记录本实参末节点索引（池当前末位）
                    结果<空类型, 整32> 加末位 = 实参末位们局部.追加(池.大小() - 1);
                    如果 (!加末位.正常) { 运行时错误(4); }
                    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(","))) { 位置++; 继续; }
                    中断;
                }
            }
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(")"))) { 位置++; }
            // 簇②根治·B1（2026-09-04 用户裁决）：裸名调用命中 导入项们 →
            //   被调标识符（参数起点前一个节点——与 节点_调用.子起点 同位）
            如果 (参数起点 > 0 && 参数起点 <= 池.大小()) {
                节点 被调对象 = 池.元素(参数起点 - 1);
                如果 (被调对象.类型 == 节点_标识符) {
                    整64 查项 = 查导入项绑定(整64(被调对象.文本));
                    如果 (查项 >= 0) {
                        被调对象.文本 = 整32(查项);
                        结果<空类型, 整32> 设被调 = 池.设置(参数起点 - 1, 被调对象);
                        如果 (!设被调.正常) { 运行时错误(4); }
                    }
                }
            }
            // 实参数 存 附加（后缀求值 弹实参数量用；子区间=实参表达式节点数≠实参数）
            // P6g（2026-08-30）：子起点=被调标识符节点索引（参数起点前一个节点——
            //   后缀链原子标识符先入池；语义层据此识别 类型转换/函数调用）
            整64 调用节点索引 = 池.大小();
            池追加(池, 建节点(节点_调用, 0, 实参数, 整32(参数起点 - 1), 0));
            // plans/019 阶段3b：实参末位入全局表（键=调用节点索引*键位移+序号）
            整64 记i = 0;
            当 (记i < 实参数 && 记i < 实参末位们局部.大小()) {
                结果<空类型, 整32> 设末位 = 调用实参末位们.设置(
                    调用节点索引 * 键位移 + 记i, 实参末位们局部.元素(记i));
                如果 (!设末位.正常) { 运行时错误(4); }
                记i++;
            }
    返回 位置;
}

// 成员后缀（R3 拆分）：字段偏移按结构体分桶（P6e——对象结构体键/旧扁平键回退）+
//   方法调用形态标记（P7b 成员名后随 "(" -> 成员方法标记）+ 节点_成员 追加
//   （子起点=对象节点索引；子终点恒 0——容器类型经 变量容器表 查询不占节点字段）。
函数 解析成员后缀(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
            整32 成员名 = 当前ID(记号, 位置 + 1);
            位置 += 2;
            // P6e（2026-08-30）：字段偏移按结构体分桶——先经 变量结构体表 推导
            //   对象所属结构体（对象若是标识符），再按 结构体名ID*键位移+字段名ID
            整64 偏移 = -1;
            整64 对象结构体ID = 0;
            整64 对象索引87 = 整64(池.大小()) - 1;
            节点 对象节点 = 池.元素(整32(对象索引87));
            // 871-a（070·G-N·870 修复·★核心）：对象=**解引用表达式**（`(*q).x`）——
            //   v2.1 语义明示 `q.x ≡ (*q).x`（指针自动解引用一级）→ 归一为「操作数
            如果 (对象节点.类型 == 节点_解引用 && 对象节点.子起点 >= 0 &&
                对象节点.子起点 < 池.大小()) {
                节点 操作数87 = 池.元素(整32(对象节点.子起点));
                如果 (操作数87.类型 == 节点_标识符) {
                    对象索引87 = 整64(对象节点.子起点);
                    节点 哨兵87 = 建节点(0, 0, 0, 0, 0);
                    结果<空类型, 整32> 设对象87 = 池.设置(整64(池.大小()) - 1, 哨兵87);
                    如果 (!设对象87.正常) { 运行时错误(4); }
                    对象节点 = 操作数87;
                }
            }
            如果 (对象节点.类型 == 节点_标识符) {
                整64 查结构体 = 查变量结构体键(整64(对象节点.文本));
                如果 (查结构体 >= 0) {
                    // 值=结构体名ID（1=结构体名标记，非对象结构体）
                    如果 (查结构体 != 1) {
                        对象结构体ID = 查结构体;
                    }
                }
            }
            // 94-a（2026-09-13 第九十四轮）：对象=下标表达式（结构体数组元素
            //   表[0].x）——下标对象标识符经 数组元素结构体表 推导元素结构体键
            //   （数组声明点登记；miss=元素非结构体/非数组，落既有扁平回退）
            如果 (对象结构体ID == 0 && 对象节点.类型 == 节点_下标 &&
                 对象节点.子起点 > 0) {
                节点 下标对象节点94 = 池.元素(整32(对象节点.子起点));
                如果 (下标对象节点94.类型 == 节点_标识符) {
                    整64 元素键94 = 查数组元素结构体键94(整64(下标对象节点94.文本));
                    如果 (元素键94 > 0) { 对象结构体ID = 元素键94; }
                }
            }
            // 871-a（070·G-N·870 配套·869 重做）：对象=**解引用表达式**
            //   （`(*q).x` 显式形态·与 `q.x` 自动解引用同源）——解引用操作数经
            如果 (对象结构体ID == 0 && 对象节点.类型 == 节点_解引用 &&
                 对象节点.子起点 >= 0 && 对象节点.子起点 < 池.大小()) {
                节点 解引用对象87 = 池.元素(整32(对象节点.子起点));
                如果 (解引用对象87.类型 == 节点_标识符) {
                    整64 查结构体87 = 查变量结构体键(整64(解引用对象87.文本));
                    如果 (查结构体87 >= 0 && 查结构体87 != 1) {
                        对象结构体ID = 查结构体87;
                    }
                }
            }
            如果 (对象结构体ID != 0) {
                结果<整64, 整32> 偏移查 = 字段偏移表.获取(对象结构体ID * 键位移 + 整64(成员名));
                如果 (偏移查.正常) { 偏移 = 偏移查.值; }
            } 否则 {
                // 回退：对象非标识符/未登记——按旧扁平键查（兼容链式 成员.字段）
                结果<整64, 整32> 偏移查2 = 字段偏移表.获取(整64(成员名));
                如果 (偏移查2.正常) { 偏移 = 偏移查2.值; }
            }
            // P7b：方法调用形态（成员名后紧跟 '('，如 表.追加(x)）——附加记
            //   方法标记，IR 层走容器方法调用；否则保持字段偏移（含 -1=未知）
            整64 附加值 = 偏移;
            如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == 整32(驻留("("))) {
                附加值 = 成员方法标记;
            }
            // 子起点=对象节点索引（池中对象在成员前，池大小-1）；子终点恒 0——
            //   对象的容器/结果类型经 查容器类型（变量容器表）查询，不占节点字段
            池追加(池, 建节点(节点_成员, 成员名, 附加值, 整32(对象索引87), 0));
    返回 位置;
}

// 限定名后缀（R3 拆分）：③ 第五波 限定名内置调用 IO::打印到错误(...)——「标识符::
//   标识符(」形态把池尾对象标识符原地改写为合成限定名（与容器构造合成名同构，
函数 解析限定后缀(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
            布尔 限定命中 = 假;
            如果 (池.大小() > 0) {
                节点 限定对象 = 池.元素(池.大小() - 1);
                如果 (限定对象.类型 == 节点_标识符) {
                    // 1011（46_module_tree·多段限定名）：路径段循环合成——池末
                    //   标识符 (:: 标识符)+ 尾接调用（网络::传输控制::发送()·
                    整64 扫描位1011 = 位置;
                    字符串 合成名1011 = 字符串复制(驻留文本(整64(限定对象.文本)));
                    当 (扫描位1011 + 2 < 记号.大小() &&
                         当前类型(记号, 扫描位1011) == 令牌_运算符 &&
                         当前ID(记号, 扫描位1011) == 整32(驻留("::")) &&
                         当前类型(记号, 扫描位1011 + 1) == 令牌_标识符) {
                        合成名1011 = 合成名1011 + "::" + 当前文本(记号, 扫描位1011 + 1);
                        扫描位1011 = 扫描位1011 + 2;
                        限定命中 = 真;
                        如果 (当前类型(记号, 扫描位1011) == 令牌_运算符 &&
                             当前ID(记号, 扫描位1011) == 整32(驻留("("))) { 中断; }
                    }
                    如果 (限定命中) {
                        限定对象.文本 = 整32(驻留(合成名1011));
                        结果<空类型, 整32> 设限定 = 池.设置(池.大小() - 1, 限定对象);
                        如果 (!设限定.正常) { 运行时错误(4); }
                        位置 = 扫描位1011;
                    }
                }
            }
    返回 位置;
}


// 二元运算（P3b）：节点_二元运算 常量已单一归属 IR常量.cn（簇①A2）。

// 解析二元链：9 层优先级（P6b 扩展，对标规范 01b§6 优先级）
//   1=逻辑或 ||；2=逻辑与 &&；3=按位或 |；4=按位异或 ^；5=按位与 &；6=相等
函数 解析二元链(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表,
               整64 表达式起点) -> 整64 {
    // 顶层链入口传 假：调用点（解析表达式 尾段）位置在二元运算符上——左操作数
    //   已由前段解析（空左操作数设计），不做一元前缀判定
    返回 解析二元层(记号, 位置, 池, 1, 字段偏移表, 假, 表达式起点);
}

// 解析层_子：层11 -> 解析原子（操作数位含一元前缀）；其余 -> 下一层（操作数位贯通）。
//   操作数位=真：当前位置必为操作数起点（二元链右操作数——运算符已消费），
函数 解析层_子(向量<Token> 记号, 整64 位置, 向量<节点> 池, 整64 层, 映射<整64, 整64>& 字段偏移表,
              布尔 操作数位, 整64 子层左起点) -> 整64 {
    // 88-a：子层左起点（子层左操作数首节点）由调用方显式给出——左操作数路径
    //   （解析二元层）传父层左起点（子层左操作数=父层左操作数的开始段）；右操作数
    //   路径（解析二元循环）传父层右起点。层11 原子层不使用该参数。
    如果 (层 == 11) {
        如果 (操作数位 && 当前类型(记号, 位置) == 令牌_运算符) {
            整64 查前缀 = 整64(当前ID(记号, 位置));
            整32 前缀类型 = 0;
            如果 (查前缀 == 驻留("!")) { 前缀类型 = 节点_逻辑非; }
            否则 如果 (查前缀 == 驻留("-")) { 前缀类型 = 节点_负号; }
            否则 如果 (查前缀 == 驻留("&")) { 前缀类型 = 节点_取地址; }
            否则 如果 (查前缀 == 驻留("*")) { 前缀类型 = 节点_解引用; }
            否则 如果 (查前缀 == 驻留("~")) { 前缀类型 = 节点_位非; }
            如果 (前缀类型 == 节点_位非) {
                // 位非解析期脱糖 ~x ≡ x ^ (0-1)（节点级：字面量1 + 负号 + 二元^；
                //  表达式入口同款，见 解析表达式 前缀段注释）
                位置++;
                整64 位非操作数起点 = 池.大小();
                位置 = 解析层_子(记号, 位置, 池, 11, 字段偏移表, 真, 整64(池.大小()));
                池追加(池, 建节点(节点_整数字面量, 整32(驻留("1")), 0, 0, 0));
                池追加(池, 建节点(节点_负号, 0, 0, 整32(整64(池.大小()) - 1), 整32(池.大小())));
                整64 位非负一索引 = 整64(池.大小()) - 1;
                池追加(池, 建节点(节点_二元运算, 整32(驻留("^")), 整32(位非负一索引), 整32(位非操作数起点), 0));
                返回 位置;
            }
            如果 (前缀类型 != 0) {
                位置++;
                整64 操作数起点 = 池.大小();
                位置 = 解析层_子(记号, 位置, 池, 11, 字段偏移表, 真, 整64(池.大小()));
                池追加(池, 建节点(前缀类型, 0, 0, 整32(操作数起点), 整32(池.大小())));
                返回 位置;
            }
        }
        位置 = 解析原子(记号, 位置, 池, 字段偏移表);
        返回 解析后缀链(记号, 位置, 池, 字段偏移表);
    }
    // 88-a：子层左起点语义分层——层1/层2（||/&& 短路）需要「**左操作数起点**」
    //   （IR 短路区间 [子起点, 附加) 的左端）；层3+（算术/比较/位运算）保持
    如果 (层 <= 1) {
        返回 解析二元层(记号, 位置, 池, 层 + 1, 字段偏移表, 操作数位, 子层左起点);
    }
    返回 解析二元层(记号, 位置, 池, 层 + 1, 字段偏移表, 操作数位, 整64(池.大小()));
}

// 解析二元层：先子层，再循环本层运算符（左结合）
// 88-a（2026-09-12）：左起点 改为**调用方显式传入**（本层左操作数首节点）——
函数 解析二元层(向量<Token> 记号, 整64 位置, 向量<节点> 池, 整64 层, 映射<整64, 整64>& 字段偏移表,
              布尔 操作数位, 整64 左起点) -> 整64 {
    // 入口子调用贯通 操作数位：本层由 子(上层, 操作数位) 下降而来时入口即外层
    //   右操作数位（前缀该判）；顶层链入口（解析二元链）已显式传 假（运算符位）
    位置 = 解析层_子(记号, 位置, 池, 层, 字段偏移表, 操作数位, 左起点);
    位置 = 解析二元循环(记号, 位置, 池, 层, 字段偏移表, 左起点);
    返回 位置;
}

// 本层循环：贪婪消费本层运算符（层匹配；层表 2026-09-09 重编号见 解析二元链 注）
函数 解析二元循环(向量<Token> 记号, 整64 位置, 向量<节点> 池, 整64 层, 映射<整64, 整64>& 字段偏移表, 整64 左起点) -> 整64 {
    如果 (当前类型(记号, 位置) != 令牌_运算符) { 返回 位置; }
    整64 符号 = 整64(当前ID(记号, 位置));
    整64 层匹配 = 0;
    如果 (符号 == 驻留("||")) { 层匹配 = 1; }
    否则 如果 (符号 == 驻留("&&")) { 层匹配 = 2; }
    否则 如果 (符号 == 驻留("|")) { 层匹配 = 3; }
    否则 如果 (符号 == 驻留("^")) { 层匹配 = 4; }
    否则 如果 (符号 == 驻留("&")) { 层匹配 = 5; }
    否则 如果 (符号 == 驻留("==") || 符号 == 驻留("!=")) { 层匹配 = 6; }
    否则 如果 (符号 == 驻留("<") || 符号 == 驻留(">") ||
              符号 == 驻留("<=") || 符号 == 驻留(">=")) { 层匹配 = 7; }
    否则 如果 (符号 == 驻留("<<") || 符号 == 驻留(">>")) { 层匹配 = 8; }
    否则 如果 (符号 == 驻留("+") || 符号 == 驻留("-")) { 层匹配 = 9; }
    否则 如果 (符号 == 驻留("*") || 符号 == 驻留("/") || 符号 == 驻留("%")) { 层匹配 = 10; }
    如果 (层匹配 == 0 || 层匹配 != 层) { 返回 位置; }
    整32 op符号 = 当前ID(记号, 位置);
    位置++;
    整64 右起点 = 池.大小();
    // ③ 第五波：右操作数子调用传 真（运算符已消费——当前位置必为操作数起点，
    //   一元前缀判定无二元歧义；`X || !f(...)`/`a * -b` 右操作数前缀由此支持）
    // 88-a：子层左起点=右起点（右操作数首节点——子层左操作数即本层右操作数开始段）
    位置 = 解析层_子(记号, 位置, 池, 层, 字段偏移表, 真, 右起点);
    如果 (层 <= 2) {
        // 短路运算符（||/&&）标注操作数后缀区间（缺陷B根治，2026-09-02）：
        //   [子起点, 子终点) = 左右操作数节点区间（不含本节点），附加 = 右操作数
        //   起点。IR 生成据此延迟求值右操作数（规范 930：短路求值语义）。
        池追加(池, 建节点(节点_二元运算, op符号, 右起点, 整32(左起点), 整32(池.大小())));
    } 否则 {
        // ③ 第二波（方案A）：普通二元同样标注 子起点=左起点/附加=右起点（子终点
        //   恒 0 与短路区分——预扫以 子终点!=0 且 op 名双条件识别短路）。IR 生成
        //   拼接左侧末端节点推导兜底据此定位左操作数末节点（右末端=位置-1 已有）。
        池追加(池, 建节点(节点_二元运算, op符号, 右起点, 整32(左起点), 0));
    }
    返回 解析二元循环(记号, 位置, 池, 层, 字段偏移表, 左起点);
}


// ==================== 泛型类型支持（P7b，2026-09-01） ====================
// 合成实例类型名（对标宿主 resolveGenericTypeName/instantiateGeneric）：

// 泛型角括号约束扫描：从 位置（须为 '<'）平衡扫描找闭合 '>'；
//   尖括号内只允许 标识符/','/'*'/'&'/'<'/'>'（类型形态）——遇其他 token（如
函数 泛型闭合位置(向量<Token> 记号, 整64 位置) -> 整64 {
    如果 (!(位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
           当前ID(记号, 位置) == 整32(驻留("<")))) { 返回 -1; }
    整64 深度 = 0;
    整64 i = 位置;
    当 (i < 记号.大小()) {
        整32 t = 当前类型(记号, i);
        整64 id = 整64(当前ID(记号, i));
        如果 (t == 令牌_运算符 && id == 整64(驻留("<"))) {
            深度++;
        } 否则 如果 (t == 令牌_运算符 && id == 整64(驻留(">"))) {
            深度--;
            如果 (深度 <= 0) { 返回 i; }
        } 否则 如果 (t == 令牌_运算符 && id == 整64(驻留(">>"))) {
            深度 = 深度 - 2;
            如果 (深度 <= 0) { 返回 i; }
        } 否则 如果 (t == 令牌_标识符) {
            // 类型名/类型参数（Token 白名单）
        } 否则 如果 (t == 令牌_运算符 && (id == 整64(驻留(",")) ||
                   id == 整64(驻留("*")) || id == 整64(驻留("&")))) {
            // 逗号分隔 / 指针 / 引用后缀
        } 否则 {
            返回 -1;
        }
        i++;
    }
    返回 -1;
}

// 解析类型文本（P7b）：递归合成 $ 实例名；位置 出参推进。
//   非类型形态返回 空串（位置不动）。参数 是实参：真=泛型实参递归位——后缀
函数 内置别名基名规范化(字符串 名) -> 字符* {
    如果 (字符串比较(名, "整数")) { 返回 "整32"; }
    如果 (字符串比较(名, "小数")) { 返回 "浮64"; }
    返回 名;
}

不安全 函数 解析类型文本(向量<Token> 记号, 整64* 位置, 布尔 是实参) -> 字符串 {
    // 389-a（D43）：类型起始词=标识符 或 别名关键字（整数/小数——词法关键字表
    //   389-a 起，基名读取须兼容关键字 token 否则类型位断裂）
    // 657-a（024/D43 单一归属收口）：谓词收敛至 是别名关键字（解析基础.cn）
    布尔 别名起始 = 是别名关键字(记号, 位置[0]);
    如果 (当前类型(记号, 位置[0]) != 令牌_标识符 && !别名起始) {
        如果 (详细诊断开启()) {
            IO::打印到错误("[trace] 类型文本 早退 当前类型=" + 整数转字符串(当前类型(记号, 位置[0])) +
                           " 是别名=" + 整数转字符串(整64(别名起始)) + "\n");
        }
        返回 "";
    }
    如果 (详细诊断开启()) {
        IO::打印到错误("[trace] 类型文本 通过 当前类型=" + 整数转字符串(当前类型(记号, 位置[0])) +
                       " 是别名=" + 整数转字符串(整64(别名起始)) + "\n");
    }
    字符串 名 = 字符串复制(驻留文本(整64(当前ID(记号, 位置[0]))));
    位置[0] = 位置[0] + 1;
    // 389-a（D43）初版内联两行·657-a（024/D43 单一归属收口）换接规范化函数——
    //   基名级映射使全部合成形态自动正确，下游语义/IR/布局/后端零感知
    名 = 字符串复制(内置别名基名规范化(名));
    // plans/018 限定类型语法（2026-09-08，宿主 A-2 对齐——E2E 56 甲::记录）：
    //   标识符 (:: 标识符)+ 合成 "甲::记录" 限定文本——语义层 拆限定名 直查
    当 (当前类型(记号, 位置[0]) == 令牌_运算符 &&
         当前ID(记号, 位置[0]) == 整32(驻留("::")) &&
         位置[0] + 1 < 记号.大小() &&
         当前类型(记号, 位置[0] + 1) == 令牌_标识符) {
        名 = 名 + "::" + 驻留文本(整64(当前ID(记号, 位置[0] + 1)));
        位置[0] = 位置[0] + 2;
    }
    // 泛型实参：类型位置 '<' 无比较歧义（泛型闭合位置 约束扫描防御）
    如果 (当前类型(记号, 位置[0]) == 令牌_运算符 &&
         当前ID(记号, 位置[0]) == 整32(驻留("<"))) {
        整64 闭合 = 泛型闭合位置(记号, 位置[0]);
        如果 (闭合 == -1) { 返回 名; }  // 非泛型形态：按裸名（防御，正常不达）
        位置[0] = 位置[0] + 1;  // 吃 '<'
        当 (真) {
            字符串 实参 = 解析类型文本(记号, 位置, 真);
            如果 (字符串长度(实参) > 0) { 名 = 名 + "$" + 实参; }
            如果 (当前类型(记号, 位置[0]) == 令牌_运算符 &&
                 当前ID(记号, 位置[0]) == 整32(驻留(","))) {
                位置[0] = 位置[0] + 1;
                继续;
            }
            中断;
        }
        // 闭合消费（位置化容错协议，2026-09-09 '>>' 词法合并）：本层闭合是 '>'
        //   吃 '>'；是 '>>' 吃整个 token（该 token 同时闭合外层——外层 464 位
        //   容错跳过，位置即正确；任意嵌套深度按位置对齐，宿主 H3 同构）
        如果 (当前类型(记号, 位置[0]) == 令牌_运算符 &&
             当前ID(记号, 位置[0]) == 整32(驻留(">"))) { 位置[0] = 位置[0] + 1; }
        否则 如果 (当前类型(记号, 位置[0]) == 令牌_运算符 &&
             当前ID(记号, 位置[0]) == 整32(驻留(">>"))) { 位置[0] = 位置[0] + 1; }
    }
    // 94-a（2026-09-13 第九十四轮）：数组类型后缀 `类型[长度]`（规格书 3.5
    //   复合类型；宿主 parseTypeNameEx 对齐）——合成为 "整32[5]" 文本（与宿主
    如果 (当前类型(记号, 位置[0]) == 令牌_运算符 &&
         当前ID(记号, 位置[0]) == 整32(驻留("["))) {
        字符串 长文本 = "";
        整64 深度b = 0;
        当 (位置[0] < 记号.大小()) {
            如果 (当前类型(记号, 位置[0]) == 令牌_运算符 &&
                 当前ID(记号, 位置[0]) == 整32(驻留("["))) {
                深度b++;
                如果 (深度b > 1) { 长文本 = 长文本 + "["; }
                位置[0] = 位置[0] + 1;
                继续;
            }
            如果 (当前类型(记号, 位置[0]) == 令牌_运算符 &&
                 当前ID(记号, 位置[0]) == 整32(驻留("]"))) {
                深度b--;
                如果 (深度b == 0) {
                    位置[0] = 位置[0] + 1;
                    中断;
                }
                长文本 = 长文本 + "]";
                位置[0] = 位置[0] + 1;
                继续;
            }
            长文本 = 长文本 + 字符串复制(驻留文本(整64(当前ID(记号, 位置[0]))));
            位置[0] = 位置[0] + 1;
        }
        如果 (深度b == 0 && 字符串长度(长文本) > 0) {
            名 = 名 + "[" + 长文本 + "]";
        }
    }
    // 簇④根治：仅实参位消费后缀 `*`/`&` 并入合成名（空类型* -> 名 + "*"，可多层）
    如果 (是实参) {
        当 (当前类型(记号, 位置[0]) == 令牌_运算符 &&
             (当前ID(记号, 位置[0]) == 整32(驻留("*")) ||
              当前ID(记号, 位置[0]) == 整32(驻留("&")))) {
            名 = 名 + 驻留文本(整64(当前ID(记号, 位置[0])));
            位置[0] = 位置[0] + 1;
        }
    }
    返回 名;
}

// 是泛型声明（P7b）：标识符 <类型实参> 标识符 —— 局部变量/参数声明前瞻
//   （防 a<b 比较表达式误判：约束扫描 + 闭合后必须是标识符=变量名）。
函数 是泛型声明(向量<Token> 记号, 整64 位置) -> 布尔 {
    如果 (当前类型(记号, 位置) != 令牌_标识符) { 返回 假; }
    如果 (位置 + 1 >= 记号.大小()) { 返回 假; }
    整64 闭合 = 泛型闭合位置(记号, 位置 + 1);
    如果 (闭合 == -1) { 返回 假; }
    如果 (当前类型(记号, 闭合 + 1) == 令牌_标识符) { 返回 真; }
    // 884-a（070·G-N·537 前置）：**泛型实例 + 数组后缀**（`结果<整32, 整32>[2] 组;`
    //   ——合成体数组声明·537 A 段实锤 parse 缺口）——闭合后 `[` 数字 `]`（可多层）
    整64 闭合探884 = 闭合 + 1;
    当 (闭合探884 + 2 < 记号.大小() &&
         当前类型(记号, 闭合探884) == 令牌_运算符 &&
         当前ID(记号, 闭合探884) == 整32(驻留("[")) &&
         当前类型(记号, 闭合探884 + 1) == 令牌_整数字面量 &&
         当前类型(记号, 闭合探884 + 2) == 令牌_运算符 &&
         当前ID(记号, 闭合探884 + 2) == 整32(驻留("]"))) {
        闭合探884 = 闭合探884 + 3;
    }
    如果 (当前类型(记号, 闭合探884) == 令牌_标识符) { 返回 真; }
    // 泛型引用声明：闭合后 '&' 且其后是标识符=变量名（解析类型 消费 '&' 置
    //   引用标记 附加=256）
    返回 当前类型(记号, 闭合探884) == 令牌_运算符 &&
           当前ID(记号, 闭合探884) == 整32(驻留("&")) &&
           闭合探884 + 1 < 记号.大小() &&
           当前类型(记号, 闭合探884 + 1) == 令牌_标识符;
}

// 是构造调用（P7b）：标识符 <类型实参> ( —— 如 向量<整64>()。
//   闭合后是 '(' 才认定（防 比较/移位误判）。
函数 是构造调用(向量<Token> 记号, 整64 位置) -> 布尔 {
    如果 (当前类型(记号, 位置) != 令牌_标识符) { 返回 假; }
    如果 (位置 + 1 >= 记号.大小()) { 返回 假; }
    整64 闭合 = 泛型闭合位置(记号, 位置 + 1);
    如果 (闭合 == -1) { 返回 假; }
    如果 (闭合 + 1 >= 记号.大小()) { 返回 假; }
    返回 当前类型(记号, 闭合 + 1) == 令牌_运算符 &&
           当前ID(记号, 闭合 + 1) == 整32(驻留("("));
}

// 解析类型：类型前置，支持 类型* 指针（P6c）/ 泛型实参（P7b）/ & 引用（P7b 登记）
// 节点_类型：文本=$合成类型名ID（向量$整64）或裸名ID；附加=指针层数 + 引用*256
函数 解析类型(向量<Token> 记号, 整64 位置, 向量<节点> 池) -> 整64 {
    // 402-a（D43/D45 破案）：入口兼容别名关键字（整数/小数）——词法关键字化后
    //   别名 token=令牌_关键字，原入口只认 令牌_标识符→别名类型声明不追加节点
    如果 (!(当前类型(记号, 位置) == 令牌_标识符 ||
           是别名关键字(记号, 位置))) {
        返回 位置;
    }
    {
        整64 类型位置 = 位置;
        字符串 合成名 = 解析类型文本(记号, &类型位置, 假);
        如果 (字符串长度(合成名) == 0) { 返回 位置; }
        位置 = 类型位置;
        整32 类型名ID = 整32(驻留(合成名));
        整64 指针层 = 0;
        整64 引用 = 0;
        当 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("*"))) {
            指针层++;
            位置++;
        }
        // 101-a（C1, 2026-09-13 第一百零一轮）：**字符* 借用视图类型化**——
        //   `字符*`（基类型 字符 + 单个 *）是**借用视图类型**（A2 已裁决语义：
        如果 (指针层 > 0 &&
            位置 + 2 < 记号.大小() &&
            当前类型(记号, 位置) == 令牌_运算符 &&
            当前ID(记号, 位置) == 整32(驻留("[")) &&
            当前类型(记号, 位置 + 1) == 令牌_整数字面量 &&
            当前类型(记号, 位置 + 2) == 令牌_运算符 &&
            当前ID(记号, 位置 + 2) == 整32(驻留("]"))) {
            字符串 指针后缀101 = "";
            整64 pz101 = 0;
            当 (pz101 < 指针层) {
                指针后缀101 = 指针后缀101 + "*";
                pz101++;
            }
            合成名 = 合成名 + 指针后缀101 + "[" +
                     驻留文本(整64(当前ID(记号, 位置 + 1))) + "]";
            类型名ID = 整32(驻留(合成名));
            指针层 = 0;
            位置 = 位置 + 3;
        }
        如果 (指针层 == 1 && 字符串比较(合成名, "字符") && 引用 == 0) {
            类型名ID = 整32(驻留("字符*"));
            指针层 = 0;
        }
        如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("&"))) {
            引用 = 1;
            位置++;
        }
        池追加(池, 建节点(节点_类型, 类型名ID, 指针层 + 引用 * 256, 0, 0));
        返回 位置;
    }
    返回 位置;
}

// T69（480-a 深度机）：函数指针声明形态前瞻——`返回类型(*名字)(参数类型列表)`。
//   规范 02 §139 / 04 章（宿主 parser.cpp parseFuncPtrType 同构）。纯读零副作用；
函数 是函数指针声明(向量<Token> 记号, 整64 位置) -> 布尔 {
    如果 (!是声明类型起始(记号, 位置)) { 返回 假; }
    如果 (位置 + 5 >= 记号.大小()) { 返回 假; }
    如果 (!(当前类型(记号, 位置 + 1) == 令牌_运算符 &&
           当前ID(记号, 位置 + 1) == 整32(驻留("(")))) { 返回 假; }
    如果 (!(当前类型(记号, 位置 + 2) == 令牌_运算符 &&
           当前ID(记号, 位置 + 2) == 整32(驻留("*")))) { 返回 假; }
    如果 (当前类型(记号, 位置 + 3) != 令牌_标识符) { 返回 假; }
    如果 (!(当前类型(记号, 位置 + 4) == 令牌_运算符 &&
           当前ID(记号, 位置 + 4) == 整32(驻留(")")))) { 返回 假; }
    返回 (当前类型(记号, 位置 + 5) == 令牌_运算符 &&
            当前ID(记号, 位置 + 5) == 整32(驻留("(")));
}

// 040（2026-10-05 甲案·001 §5.8）：数组元素位形态 `类型 ( * 名 [ N ] ) (`
//   （回调表·纯读零消费——宿主 funcPtrDeclAhead(allowArray) 同构）
函数 是函数指针声明数组(向量<Token> 记号, 整64 位置) -> 布尔 {
    如果 (!是声明类型起始(记号, 位置)) { 返回 假; }
    如果 (位置 + 8 >= 记号.大小()) { 返回 假; }
    如果 (!(当前类型(记号, 位置 + 1) == 令牌_运算符 &&
           当前ID(记号, 位置 + 1) == 整32(驻留("(")))) { 返回 假; }
    如果 (!(当前类型(记号, 位置 + 2) == 令牌_运算符 &&
           当前ID(记号, 位置 + 2) == 整32(驻留("*")))) { 返回 假; }
    如果 (当前类型(记号, 位置 + 3) != 令牌_标识符) { 返回 假; }
    如果 (!(当前类型(记号, 位置 + 4) == 令牌_运算符 &&
           当前ID(记号, 位置 + 4) == 整32(驻留("[")))) { 返回 假; }
    如果 (当前类型(记号, 位置 + 5) != 令牌_整数字面量) { 返回 假; }
    如果 (!(当前类型(记号, 位置 + 6) == 令牌_运算符 &&
           当前ID(记号, 位置 + 6) == 整32(驻留("]")))) { 返回 假; }
    如果 (!(当前类型(记号, 位置 + 7) == 令牌_运算符 &&
           当前ID(记号, 位置 + 7) == 整32(驻留(")")))) { 返回 假; }
    返回 (当前类型(记号, 位置 + 8) == 令牌_运算符 &&
            当前ID(记号, 位置 + 8) == 整32(驻留("(")));
}

// 040 甲案：匿名形态 `类型 ( * ) (`（返回类型位 `-> 整32(*)(整32)`·纯读零消费）
函数 是函数指针返回匿名(向量<Token> 记号, 整64 位置) -> 布尔 {
    如果 (!是声明类型起始(记号, 位置)) { 返回 假; }
    如果 (位置 + 4 >= 记号.大小()) { 返回 假; }
    如果 (!(当前类型(记号, 位置 + 1) == 令牌_运算符 &&
           当前ID(记号, 位置 + 1) == 整32(驻留("(")))) { 返回 假; }
    如果 (!(当前类型(记号, 位置 + 2) == 令牌_运算符 &&
           当前ID(记号, 位置 + 2) == 整32(驻留("*")))) { 返回 假; }
    如果 (!(当前类型(记号, 位置 + 3) == 令牌_运算符 &&
           当前ID(记号, 位置 + 3) == 整32(驻留(")")))) { 返回 假; }
    返回 (当前类型(记号, 位置 + 4) == 令牌_运算符 &&
            当前ID(记号, 位置 + 4) == 整32(驻留("(")));
}

// T69（480-a 深度机）：函数指针类型节点解析——位置[0] 入=形态起点（返回类型
//   起始 token），出=参数表右 ')' 之后；名字出参=`(*名字)` 内的声明名 ID（供
不安全 函数 解析函数指针类型节点(向量<Token> 记号, 整64* 位置, 向量<节点> 池,
                     整32* 名字出参) -> 整64 {
    整64 起始 = 位置[0];
    字符串 返回文本 = 解析类型文本(记号, 位置, 真);
    如果 (字符串长度(返回文本) == 0) { 位置[0] = 起始; 返回 0 - 1; }
    名字出参[0] = 0;
    // 040 顺序消费：'(' '*' [名] [ [ N ] ] ')' '('——名/数组长度均可选
    //   （三形态：命名标量/命名数组/匿名；长度错置=回退交既有诊断链）
    如果 (!(当前类型(记号, 位置[0]) == 令牌_运算符 &&
           当前ID(记号, 位置[0]) == 整32(驻留("(")) &&
           位置[0] + 1 < 记号.大小() &&
           当前类型(记号, 位置[0] + 1) == 令牌_运算符 &&
           当前ID(记号, 位置[0] + 1) == 整32(驻留("*")))) {
        位置[0] = 起始;
        返回 0 - 1;
    }
    位置[0] = 位置[0] + 2;   // 吃 '(' '*'
    如果 (当前类型(记号, 位置[0]) == 令牌_标识符) {
        名字出参[0] = 当前ID(记号, 位置[0]);
        位置[0] = 位置[0] + 1;
    }
    字符串 数组后缀fp480 = "";
    如果 (位置[0] + 2 < 记号.大小() &&
         当前类型(记号, 位置[0]) == 令牌_运算符 &&
         当前ID(记号, 位置[0]) == 整32(驻留("[")) &&
         当前类型(记号, 位置[0] + 1) == 令牌_整数字面量 &&
         当前类型(记号, 位置[0] + 2) == 令牌_运算符 &&
         当前ID(记号, 位置[0] + 2) == 整32(驻留("]"))) {
        数组后缀fp480 = "[" + 字符串复制(驻留文本(当前ID(记号, 位置[0] + 1))) + "]";
        位置[0] = 位置[0] + 3;
    }
    如果 (!(当前类型(记号, 位置[0]) == 令牌_运算符 &&
           当前ID(记号, 位置[0]) == 整32(驻留(")")) &&
           位置[0] + 1 < 记号.大小() &&
           当前类型(记号, 位置[0] + 1) == 令牌_运算符 &&
           当前ID(记号, 位置[0] + 1) == 整32(驻留("(")))) {
        位置[0] = 起始;
        返回 0 - 1;
    }
    位置[0] = 位置[0] + 2;   // 吃 ')' '('
    字符串 参数文本 = "";
    布尔 首参 = 真;
    布尔 完成 = 假;
    当 (位置[0] < 记号.大小()) {
        如果 (当前类型(记号, 位置[0]) == 令牌_运算符 &&
             当前ID(记号, 位置[0]) == 整32(驻留(")"))) {
            位置[0] = 位置[0] + 1;
            完成 = 真;
            中断;
        }
        字符串 参文本 = 解析类型文本(记号, 位置, 真);
        如果 (字符串长度(参文本) == 0) { 中断; }
        如果 (!首参) { 参数文本 = 参数文本 + ","; }
        参数文本 = 参数文本 + 参文本;
        首参 = 假;
        如果 (当前类型(记号, 位置[0]) == 令牌_运算符 &&
             当前ID(记号, 位置[0]) == 整32(驻留(","))) {
            位置[0] = 位置[0] + 1;
        }
    }
    如果 (!完成) { 位置[0] = 起始; 返回 0 - 1; }
    字符串 合成fp = "函数指针<" + 返回文本 + ">(" + 参数文本 + ")" + 数组后缀fp480;
    整64 下标fp = 池.大小();
    池追加(池, 建节点(节点_类型, 整32(驻留(合成fp)), 0, 0, 0));
    返回 下标fp;
}

// 解析参数：类型 名
函数 解析参数(向量<Token> 记号, 整64 位置, 向量<节点> 池) -> 整64 {
    // plans/019 阶段3（2026-09-10）：常量 只读引用参数前缀（常量 类型& 名）
    //   ——消费 常量 后解析类型；引用形态（类型节点附加=256）改标 257=
    //   常量引用（只读借用——赋值面语义检查用；宿主 isConstParam 对齐）
    布尔 是常量参数 = 假;
    如果 (是词(记号, 位置, "常量")) {
        是常量参数 = 真;
        位置++;
    }
    // T69（480-a 深度机）：函数指针形参 `返回类型(*名字)(参数类型列表)`——
    //   声明名嵌在 `(*名字)` 内（宿主 parser.cpp:316-328 parseParamDecl 同构）；
    //   类型节点由 解析函数指针类型节点 产出，结构与容器登记不适用（指针值）。
    如果 (是函数指针声明(记号, 位置)) {
        整32 参名fp = 0;
        整64 位置fp = 位置;
        整64 类型节点fp = 解析函数指针类型节点(记号, &位置fp, 池, &参名fp);
        如果 (类型节点fp >= 0 && 参名fp != 0) {
            池追加(池, 建节点(节点_参数, 参名fp, 整64(类型节点fp), 0, 0));
            返回 位置fp;
        }
    }
    整64 类型节点 = 池.大小();
    位置 = 解析类型(记号, 位置, 池);
    // 439-a（T69 阶段1·规范 02 §139/04）：函数指针形态 返回类型(*名)(参数类型列表)
    //   ——解析类型 已把返回类型入池（文本=合成名）；此处识别 "(*名)(…)" 尾形态：
    如果 (位置 + 2 < 记号.大小() &&
         当前类型(记号, 位置) == 令牌_运算符 &&
         当前ID(记号, 位置) == 整32(驻留("(")) &&
         当前类型(记号, 位置 + 1) == 令牌_运算符 &&
         当前ID(记号, 位置 + 1) == 整32(驻留("*")) &&
         当前类型(记号, 位置 + 2) == 令牌_标识符) {
        节点 返回类型节点439 = 池.元素(整32(类型节点));
        字符串 合成439 = 字符串复制(驻留文本(整64(返回类型节点439.文本)));
        合成439 = 合成439 + "(*";
        位置 += 2;
        整32 名ID439 = 当前ID(记号, 位置);
        位置++;
        合成439 = 合成439 + ")(";
        // 439-a：(*名) 的闭括号 `)` 消费（token 序：返回 ( * 名 ) ( 参数… )——
        //   此括号缺失曾致后续 `(` 消费判定错位·解析整体错乱）
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留(")"))) { 位置++; }
        // 439-a：消费参数列表的开 `(`（token 序：返回(*名) **(** 参数类型… )）
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留("("))) { 位置++; }
        如果 (!(当前类型(记号, 位置) == 令牌_运算符 &&
                当前ID(记号, 位置) == 整32(驻留(")")))) {
            当 (真) {
                整64 类型位置439 = 位置;
                字符串 参数类型439 = 解析类型文本(记号, &类型位置439, 假);
                如果 (字符串长度(参数类型439) == 0) {
                    IO::打印到错误("[parse] 函数指针参数类型预期\n");
                    语法错误加一();
                    中断;
                }
                位置 = 类型位置439;
                当 (当前类型(记号, 位置) == 令牌_运算符 &&
                     (当前ID(记号, 位置) == 整32(驻留("*")) ||
                      当前ID(记号, 位置) == 整32(驻留("&")))) {
                    如果 (当前ID(记号, 位置) == 整32(驻留("*"))) {
                        参数类型439 = 参数类型439 + "*";
                    } 否则 {
                        参数类型439 = 参数类型439 + "&";
                    }
                    位置++;
                }
                合成439 = 合成439 + 参数类型439;
                如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留(","))) {
                    合成439 = 合成439 + ",";
                    位置++;
                    继续;
                }
                中断;
            }
        }
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留(")"))) { 位置++; }
        合成439 = 合成439 + ")";
        // 回写返回类型节点：文本=规范化函数指针类型·附加=1（指针化）
        返回类型节点439.文本 = 整32(驻留(合成439));
        返回类型节点439.附加 = 1;
        结果<空类型, 整32> 设439 = 池.设置(整32(类型节点), 返回类型节点439);
        如果 (!设439.正常) { 运行时错误(4); }
        池追加(池, 建节点(节点_参数, 名ID439, 整64(类型节点), 0, 0));
        // 名与右括号均已在本块消费——返回当前位置（原版「+1」系参数名未消费语义）
        返回 位置;
    }
    如果 (是常量参数) {
        节点 常量类型节点 = 池.元素(类型节点);
        如果 (常量类型节点.附加 == 256) {
            常量类型节点.附加 = 257;
            结果<空类型, 整32> 设常量标 = 池.设置(类型节点, 常量类型节点);
            如果 (!设常量标.正常) { 运行时错误(4); }
        }
    }
    如果 (当前类型(记号, 位置) == 令牌_标识符) {
        整32 参数名ID = 当前ID(记号, 位置);
        // P6e：参数若是结构体类型（值语义），登记 变量名ID -> 结构体名ID，
        //   成员访问（位置.x）据此推导对象所属结构体、查分桶字段偏移。
        节点 类型节点值 = 池.元素(类型节点);
        如果 (类型节点值.附加 <= 256) {
            // plans/018 类型分桶：登记值=键基（查结构体类型 三级——限定类型支持）
            整64 结构体键p = 查结构体类型(整64(类型节点值.文本));
            如果 (结构体键p != 0) {
                登记变量结构体(整64(参数名ID), 结构体键p);
            }
        }
        // P7b：容器/结果 参数登记 变量容器表（被调内成员调用预标注；引用参数同）
        字符串 参数类型文本 = 字符串复制(驻留文本(整64(类型节点值.文本)));
        如果 (是容器类(参数类型文本) || 是结果类型(参数类型文本)) {
            登记变量容器(整64(参数名ID), 整64(类型节点值.文本));
        }
        整32 参数节点索引d = 整32(池.大小());
        池追加(池, 建节点(节点_参数, 参数名ID, 整64(类型节点), 0, 0));
        位置 = 解析参数默认值(记号, 位置, 池, 参数节点索引d);
        返回 位置;
    }
    池追加(池, 建节点(节点_参数, 0, 整64(类型节点), 0, 0));
    返回 位置;
}

// 吃分号（plans/015 方案B 强制分号，2026-09-04 用户裁决）：语句必须 ';' 终结——
//   缺失即 stderr 诊断+语法错误数 计数（错误即诊断，块截断静默家族整体消亡）；
函数 吃分号(向量<Token> 记号, 整64 位置) -> 整64 {
    如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
         当前ID(记号, 位置) == 整32(驻留(";"))) {
        返回 位置 + 1;
    }
    语法错误加一();
    整64 行号 = 0;
    如果 (记号.大小() > 0) {
        // 行号取前一 token（语句结尾 token）——对齐宿主 consumeSemicolon
        //   诊断位置纪律（缺陷③连带：原取下一语句起点行，偏 +1）
        整64 取行位置 = 位置 - 1;
        如果 (取行位置 < 0) { 取行位置 = 0; }
        如果 (取行位置 >= 记号.大小()) { 取行位置 = 记号.大小() - 1; }
        行号 = 整64(记号.元素(取行位置).行);
    }
    IO::打印到错误("[parse] 语句缺少分号 ';'（行=" + 整数转字符串(行号) + "）\n");
    返回 位置;
}
// ==================== 070 波B（1022 深度机·任务 #070）：lambda 表达式（匿名函数） ====================
// 规范 plans/001「lambda 表达式」：[捕获](参数) -> 返回 { 体 }；无返回标注由编译器
静态 向量<整64> lambda合成函数索引们;   // 合成函数池索引们（解析序·IR 生成消费）
静态 向量<整64> lambda延后名们;          // 延后段名ID 们（解析序·映射无遍历·向量驱动）
静态 映射<整64, 整64> lambda延后段起们;  // 名ID -> lambda token 段起（程序解析完统一补解析）
静态 映射<整64, 整64> lambda延后段止们;  // 名ID -> lambda token 段止（平衡跳过时登记）
静态 整64 lambda计数1022 = 0;

// lambda 捕获起始判定（宿主 peekLambdaCapture 同位）：'[' 后跟 ']'/'='/'&'/标识符
//   =lambda 捕获形态；其余（表达式）=非 lambda（下标在原子后后缀位·原子位 '['
//   非捕获形态此前即非法·保持原失败路径）。
函数 是lambda捕获起始(向量<Token> 记号, 整64 位置) -> 布尔 {
    如果 (!(当前类型(记号, 位置) == 令牌_运算符 &&
           当前ID(记号, 位置) == 整32(驻留("[")))) { 返回 假; }
    整64 p = 位置 + 1;
    如果 (p >= 记号.大小()) { 返回 假; }
    整32 tp = 当前类型(记号, p);
    如果 (tp == 令牌_运算符 &&
        (当前ID(记号, p) == 整32(驻留("]")) ||
         当前ID(记号, p) == 整32(驻留("=")) ||
         当前ID(记号, p) == 整32(驻留("&")))) { 返回 真; }
    如果 (tp == 令牌_标识符) { 返回 真; }
    返回 假;
}

// lambda 解析：消费捕获段（第一版仅 [] 放行·捕获形态优雅拒绝）→ 参数表 →
//   可选 -> 返回 → 体（解析块）→ 池尾合成 节点_函数 + 表达式位标识符。
函数 解析lambda原子(向量<Token> 记号, 整64 位置, 向量<节点> 池,
                   映射<整64, 整64>& 字段偏移表) -> 整64 {
    // 延后解析方案（首两版实录：体/参数/合成函数节点在表达式区间内=净栈多压/
    // 推断区间污染——调用方以 池.大小() 差值算表达式区间，单一池无法避让）：
    lambda计数1022++;
    字符串 lambda名 = "?lambda" + 整数转字符串(lambda计数1022);
    整64 名ID = 驻留(lambda名);
    池追加(池, 建节点(节点_标识符, 整32(名ID), 0, 0, 0));
    // 段起登记（扫描前·'[' 位——补解析从 '[' 重放；首版实录=登记在扫描后
    //   段起==段止位·补解析从 lambda 之后的 token 乱解析）
    结果<空类型, 整32> 登段 = lambda延后段起们.设置(名ID, 位置);
    如果 (!登段.正常) { 运行时错误(4); }
    结果<空类型, 整32> 登名 = lambda延后名们.追加(名ID);
    如果 (!登名.正常) { 运行时错误(4); }
    // 整段跳过：[捕获] (参数) [-> 类型] { 体 }——两段式（首版整段深度扫描
    //   实录：[] 的 ']' 深度归零误判段止）。段1=扫到体 '{'（捕获/参数/返回
    //   区无 '{'）；段2='{' 平衡扫描到配对 '}'。'->' 单 token。
    当 (位置 < 记号.大小() &&
        !(当前类型(记号, 位置) == 令牌_运算符 &&
          当前ID(记号, 位置) == 整32(驻留("{")))) { 位置++; }
    如果 (位置 < 记号.大小() &&
         当前类型(记号, 位置) == 令牌_运算符 &&
         当前ID(记号, 位置) == 整32(驻留("{"))) {
        整64 深度 = 0;
        当 (位置 < 记号.大小()) {
            如果 (当前类型(记号, 位置) == 令牌_运算符) {
                整32 idv = 当前ID(记号, 位置);
                如果 (idv == 整32(驻留("{"))) { 深度++; }
                否则 如果 (idv == 整32(驻留("}"))) {
                    深度--;
                    如果 (深度 == 0) {
                        位置++;
                        中断;
                    }
                }
            }
            位置++;
        }
    }
    结果<空类型, 整32> 登止 = lambda延后段止们.设置(名ID, 位置);
    如果 (!登止.正常) { 运行时错误(4); }
    返回 位置;
}

// 程序解析完成后统一补解析（解析程序 尾·节点_程序 追加前挂）：对每个延后段
//   完整解析 参数/体/合成函数——此时入池恒在池尾=程序声明区间外（零区间污染）。
//   段表文件级清空（多文件逐文件解析·记号上下文=本文件）。
函数 解析lambda延后段们(向量<Token> 记号, 整64 位置, 向量<节点> 池,
                     映射<整64, 整64>& 字段偏移表) -> 整64 {
    整64 段数 = lambda延后名们.大小();
    整64 si = 0;
    当 (si < 段数) {
        整64 名ID = lambda延后名们.元素(si);
        结果<整64, 整32> 查起 = lambda延后段起们.获取(名ID);
        结果<整64, 整32> 查止 = lambda延后段止们.获取(名ID);
        // 段表由 解析lambda原子 登记（内部不变量恒命中）——检查器要求
        //   结果.值 只能在肯定分支内访问（v2 结果纪律·否定检查不豁免）
        如果 (!查起.正常) { 运行时错误(4); }
        如果 (!查止.正常) { 运行时错误(4); }
        整64 p = 0;
        整64 段止 = 0;
        如果 (查起.正常) {
            如果 (查止.正常) {
                p = 查起.值;
                段止 = 查止.值;
            }
        }
        p++;   // 消费 '['
        // 捕获段（重放）——非空捕获=优雅拒绝（361 负测锚：捕获未声明变量
        //   宿主编译期拒绝·v2 捕获面欠账下同拒〔拒绝理由不同但拒绝行为一致〕；
        //   延后重构首版实录=此处只跳过不诊断=361 宽松放行云端红）
        如果 (!(当前类型(记号, p) == 令牌_运算符 &&
               当前ID(记号, p) == 整32(驻留("]")))) {
            当 (p < 段止 &&
                !(当前类型(记号, p) == 令牌_运算符 &&
                  当前ID(记号, p) == 整32(驻留("]")))) { p++; }
            如果 (p < 段止) { p++; }
            IO::打印到错误("[parse] v2 暂不支持 lambda 捕获（[] 无捕获先行·捕获实参展开面下一层登记）\n");
            语法错误加一();
        } 否则 {
            p++;
        }
        // 参数表
        整64 参数起点 = 池.大小();
        如果 (当前类型(记号, p) == 令牌_运算符 &&
             当前ID(记号, p) == 整32(驻留("("))) {
            p++;
            如果 (!(当前类型(记号, p) == 令牌_运算符 &&
                   当前ID(记号, p) == 整32(驻留(")")))) {
                当 (真) {
                    p = 解析参数(记号, p, 池);
                    如果 (当前类型(记号, p) == 令牌_运算符 &&
                         当前ID(记号, p) == 整32(驻留(","))) { p++; 继续; }
                    中断;
                }
            }
            如果 (当前类型(记号, p) == 令牌_运算符 &&
                 当前ID(记号, p) == 整32(驻留(")"))) { p++; }
        }
        // 返回类型（'->' 单 token·* 后缀并入）
        整64 返回类型ID = 0;
        如果 (当前类型(记号, p) == 令牌_运算符 &&
             当前ID(记号, p) == 整32(驻留("->"))) {
            p++;
            返回类型ID = 当前ID(记号, p);
            p++;
            当 (当前类型(记号, p) == 令牌_运算符 &&
                 当前ID(记号, p) == 整32(驻留("*"))) {
                返回类型ID = 整32(驻留(驻留文本(整64(返回类型ID)) + "*"));
                p++;
            }
        }
        // 体（解析块·块索引=池尾）
        p = 解析块(记号, p, 池, 字段偏移表);
        整32 块索引 = 整32(池.大小()) - 1;
        // 合成函数声明（池尾·lambda合成函数索引们 登记→IR 生成消费）
        节点 合成函数 = 建节点(节点_函数, 整32(名ID), 返回类型ID,
                              整32(参数起点), 块索引);
        池追加(池, 合成函数);
        结果<空类型, 整32> 加lambda = lambda合成函数索引们.追加(池.大小() - 1);
        如果 (!加lambda.正常) { 运行时错误(4); }
        si++;
    }
    // 段表文件级清空（多文件逐文件·记号上下文=本文件）
    整64 清n = lambda延后名们.大小();
    当 (清n > 0) {
        结果<空类型, 整32> 删名 = lambda延后名们.删除(清n - 1);
        如果 (!删名.正常) { 运行时错误(4); }
        清n--;
    }
    返回 位置;
}
