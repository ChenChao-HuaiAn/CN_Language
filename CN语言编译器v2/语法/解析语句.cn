// CN 自举编译器 v2 · 解析语句（千行拆分子模块，2026-09-08 用户裁决阶段目录包）
// 职责：语句解析与块解析（解析语句/解析块）——自 语法分析.cn 机械搬移
//   （函数与静态归属不变，跨文件经 公开: 函数访问）；模块路径=解析语句（新键基）。
导入 容器::向量;
导入 映射集合;
导入 词法;       // Token 结构（原 导入 词法分析，目录包名）
导入 IR;         // 节点_*/键位移 常量（原 IR容器+IR常量 合并目录包名）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 解析语句
// 201-a（2026-09-15 第两百零一轮，D1 行数整改）：语句类型守卫链留主函数，五分支体提取为
//   族方法（解析返回/当/常量/推断声明/赋值 语句），变量声明六形态前瞻守卫提取为谓词
//   是变量声明前瞻（纯读零副作用）——程序化切片+守卫块跨行扫描+双名单差集审计。
函数 解析语句(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    // ②b B4（2026-09-02）：裸块语句 { ... }（块级作用域——126 ④a RAII 载体）。
    //   旧版无此分支：解析块 遇 { 落入表达式兜底不消费 -> 循环保护中断，
    //   块内及后续全部语句静默丢失（实测 126 返回 0 丢失 -> 垃圾退出码 20）。
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("{"))) {
        返回 解析块(记号, 位置, 池, 字段偏移表);
    }
    如果 (是关键(记号, 位置, "返回")) {
        返回 解析返回语句(记号, 位置, 池, 字段偏移表);
    }
    如果 (是关键(记号, 位置, "如果")) {
        返回 解析如果语句(记号, 位置, 池, 字段偏移表);
    }
    如果 (是关键(记号, 位置, "当")) {
        返回 解析当语句(记号, 位置, 池, 字段偏移表);
    }
    如果 (是关键(记号, 位置, "中断")) { 位置++; 池追加(池, 建节点(节点_中断语句, 0, 0, 0, 0)); 返回 吃分号(记号, 位置); }
    如果 (是关键(记号, 位置, "继续")) { 位置++; 池追加(池, 建节点(节点_继续语句, 0, 0, 0, 0)); 返回 吃分号(记号, 位置); }
    // P7a 局部常量：常量 名 = 表达式——按 整64 局部变量处理（合成 节点_类型(整64)；
    //   v2 语义层不区分只读性，自举组件源码仅用顶层常量，此分支防新关键字停滞解析）
    如果 (是词(记号, 位置, "常量")) {
        返回 解析常量语句(记号, 位置, 池, 字段偏移表);
    }
    // 46-c 类型推断声明（2026-09-10 第四十九轮，规范 03 变量声明形式1；宿主
    //   parseVarDeclAfterKeyword Kw_Var 同构）：变量 标识符 = 表达式——类型由
    //   初值推断（语义层推导回填+登记推断声明类型表，IR 层查表分派）。
    //   类型节点文本=驻留("")（空串哨兵=推断标记，宿主 varType.empty 同构）；
    //   规范 EBNF 推断声明必须初始化——无 '=' 语法错误 fail fast（语法错误
    //   加一 中止通道）。顶层推断声明非规范形态（顶层用 常量/静态），解析程序
    //   顶层不识别「变量」=语法错误可见失败，行为一致。
    如果 (是关键(记号, 位置, "变量")) {
        返回 解析推断声明语句(记号, 位置, 池, 字段偏移表);
    }
    // 变量声明检测：标识符 标识符（值）或 标识符 * 标识符（指针类型，P6c）
    //   或 标识符 & 标识符 =（裸类型引用，2026-09-04 缺陷零容忍收口——宿主 parser
    //   形式6 typeRefVar 对齐；后随 '=' 前置消歧：引用声明必须初始化（语义层
    //   同款纪律），a & b 位与形态无 '=' 不误判——较宿主 a*b 同款惯例更严）
    //   或 标识符 <实参> 标识符（泛型类型，P7b——是泛型声明 前瞻防 a<b 比较误判）
    //   或 标识符 :: 标识符 标识符（限定类型声明，plans/018——甲::记录 r；
    //   第三标识符位消歧：限定类型后必须跟变量名，`甲::记录` 表达式形态不误入）
    如果 (是变量声明前瞻(记号, 位置)) {
        返回 解析变量声明语句(记号, 位置, 池, 字段偏移表);
    }
    // P6b 赋值语句：标识符 = 表达式（左值 -> 右值）——体含构造字面量赋值位形态
    如果 (当前类型(记号, 位置) == 令牌_标识符 && 位置 + 1 < 记号.大小() &&
         当前类型(记号, 位置 + 1) == 令牌_运算符 && 当前ID(记号, 位置 + 1) == 整32(驻留("="))) {
        返回 解析赋值语句(记号, 位置, 池, 字段偏移表);
    }
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("*"))) {
        返回 解析解引用语句(记号, 位置, 池, 字段偏移表);
    }
    整64 自增减位置 = 解析自增自减语句(记号, 位置, 池);
    如果 (自增减位置 >= 0) { 返回 自增减位置; }
    返回 解析表达式兜底语句(记号, 位置, 池, 字段偏移表);
}

// 201-a：返回语句解析（值可选+吃分号；灰色点②字符串内容判定注释随体）。
函数 解析返回语句(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
        位置++;
        整64 值起点 = 池.大小();
        // 灰色点②方案A（2026-09-04）：字符串 != 字面量 原按驻留地址比较（依赖
        //   驻留恒等的实现细节，宿主已显式拒绝）——改 字符串比较 内容判定
        如果 (当前类型(记号, 位置) != 令牌_运算符 || !字符串比较(当前文本(记号, 位置), "}")) {
            位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        }
        池追加(池, 建节点(节点_返回语句, 0, 0, 整32(值起点), 整32(池.大小())));
        返回 吃分号(记号, 位置);
}

// 201-a：当语句解析（条件+体块+P6b 节点字段布局注释随体）。
函数 解析当语句(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
        位置++;
        整64 条件起点 = 池.大小();
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        整64 条件终点 = 池.大小();
        位置 = 解析块(记号, 位置, 池, 字段偏移表);
        整64 体块索引 = 整64(池.大小()) - 1;   // 解析块 最后追加 块 节点
        // 节点字段（P6b）：文本=条件起点，附加=体块索引，子起点=条件终点
        池追加(池, 建节点(节点_当语句, 整32(条件起点), 整64(体块索引), 整32(条件终点), 0));
        返回 位置;
}

// 201-a：常量语句解析（P7a 局部常量按 整64 局部变量处理）。
函数 解析常量语句(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
        位置++;
        整64 类型节点 = 池.大小();
        池追加(池, 建节点(节点_类型, 整32(驻留("整64")), 0, 0, 0));
        整32 名ID = 当前ID(记号, 位置);
        位置++;
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("="))) {
            位置++;
            整64 值起点 = 池.大小();
            位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
            池追加(池, 建节点(节点_变量声明, 名ID, 整64(类型节点), 整32(值起点), 整32(池.大小())));
        } 否则 {
            池追加(池, 建节点(节点_变量声明, 名ID, 整64(类型节点), 0, 0));
        }
        返回 吃分号(记号, 位置);
}

// 201-a：推断声明语句解析（46-c 类型推断；无 '=' 语法错误 fail fast）。
函数 解析推断声明语句(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
        位置++;
        整32 推名ID = 当前ID(记号, 位置);
        位置++;
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("="))) {
            位置++;
            整64 推值起点 = 池.大小();
            位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
            整64 推类型节点 = 池.大小();
            池追加(池, 建节点(节点_类型, 整32(驻留("")), 0, 0, 0));
            // 子终点=推类型节点（表达式末尾）——区间只含初值表达式；类型节点
            //   与声明节点本体不入子区间（对齐常量分支：建节点参数求值时点）
            池追加(池, 建节点(节点_变量声明, 推名ID, 整64(推类型节点), 整32(推值起点), 整32(推类型节点)));
        } 否则 {
            语法错误加一();
            IO::打印到错误("[parse] 推断声明必须初始化（变量 名 = 表达式）: " +
                           驻留文本(整64(推名ID)) + "\n");
        }
        返回 吃分号(记号, 位置);
}

// 201-a：赋值语句解析（构造字面量赋值位形态+普通右值两路；守卫=标识符 =）。
函数 解析赋值语句(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
        整32 左值ID = 当前ID(记号, 位置);
        位置 += 2;
        // 构造字面量赋值位·标识符目标（第四十六轮观察项③，2026-09-09）：p = 点{...}——
        //   RHS 标识符为已登记结构体且后随 '{'，且目标为结构体变量（变量结构体表
        //   已登记——非结构体目标不进入=保持旧路径可见失败）。逐字段 成员左值
        //   赋值（声明位同构，零新节点/IR；穷举纪律单一助手同源）；Rust 同构：
        //   构造字面量=目标 place 逐字段初始化。
        如果 (当前类型(记号, 位置) == 令牌_标识符 && 位置 + 1 < 记号.大小() &&
             当前类型(记号, 位置 + 1) == 令牌_运算符 &&
             当前ID(记号, 位置 + 1) == 整32(驻留("{"))) {
            整64 结构体键a = 查结构体类型(整64(当前ID(记号, 位置)));
            整64 目标键a = 查变量结构体键(整64(左值ID));
            如果 (结构体键a > 0 && 目标键a > 0) {
                整64 构造名ID = 当前ID(记号, 位置);
                整64 构造行 = 整64(记号.元素(位置).行);
                向量<整64> 空链名们 = 向量<整64>();
                向量<整64> 空链偏移们 = 向量<整64>();
                位置 = 解析构造字段赋值们(记号, 位置 + 1, 池, 字段偏移表, 左值ID,
                                      空链名们, 空链偏移们, 目标键a, 构造名ID, 构造行);
                返回 吃分号(记号, 位置);
            }
        }
        整64 右值起点 = 池.大小();
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        池追加(池, 建节点(节点_赋值, 左值ID, 0, 整32(右值起点), 整32(池.大小())));
        返回 吃分号(记号, 位置);
}

// 201-a：变量声明六形态前瞻谓词（纯读零副作用）——普通/指针数组/数组/指针/引用/限定类型
//   + 泛型声明前瞻；原守卫条件逐字保留（首行「如果 ((」改「返回 ((」、尾行「)) {」改「));」）。
函数 是变量声明前瞻(向量<Token> 记号, 整64 位置) -> 布尔 {
    返回 ((当前类型(记号, 位置) == 令牌_标识符 && 位置 + 1 < 记号.大小() &&
         ((当前类型(记号, 位置 + 1) == 令牌_标识符) ||
          // 101-a（C1）：指针数组声明 类型*[长度] 变量名（宿主 canonical
          //   "整32*[3]" 同构；前瞻 '*' '[' 数字 ']' 标识符 五 token）
          (当前类型(记号, 位置 + 1) == 令牌_运算符 &&
           当前ID(记号, 位置 + 1) == 整32(驻留("*")) &&
           位置 + 5 < 记号.大小() &&
           当前类型(记号, 位置 + 2) == 令牌_运算符 &&
           当前ID(记号, 位置 + 2) == 整32(驻留("[")) &&
           当前类型(记号, 位置 + 3) == 令牌_整数字面量 &&
           当前类型(记号, 位置 + 4) == 令牌_运算符 &&
           当前ID(记号, 位置 + 4) == 整32(驻留("]")) &&
           当前类型(记号, 位置 + 5) == 令牌_标识符) ||
          // 94-a：数组类型声明 类型[长度] 变量名（规格书 3.5；前瞻 '[' 整数字面量
          //   ']' 标识符 四 token——与下标表达式形态（标识符 '[' ...）不冲突：
          //   声明位首 token 是类型名，此处要求第 5 token 为变量名标识符）
          (当前类型(记号, 位置 + 1) == 令牌_运算符 &&
           当前ID(记号, 位置 + 1) == 整32(驻留("[")) &&
           位置 + 4 < 记号.大小() &&
           当前类型(记号, 位置 + 2) == 令牌_整数字面量 &&
           当前类型(记号, 位置 + 3) == 令牌_运算符 &&
           当前ID(记号, 位置 + 3) == 整32(驻留("]")) &&
           当前类型(记号, 位置 + 4) == 令牌_标识符) ||
          (当前类型(记号, 位置 + 1) == 令牌_运算符 &&
           当前ID(记号, 位置 + 1) == 整32(驻留("*")) &&
           位置 + 2 < 记号.大小() && 当前类型(记号, 位置 + 2) == 令牌_标识符) ||
          (当前类型(记号, 位置 + 1) == 令牌_运算符 &&
           当前ID(记号, 位置 + 1) == 整32(驻留("&")) &&
           位置 + 2 < 记号.大小() && 当前类型(记号, 位置 + 2) == 令牌_标识符 &&
           位置 + 3 < 记号.大小() &&
           当前类型(记号, 位置 + 3) == 令牌_运算符 &&
           当前ID(记号, 位置 + 3) == 整32(驻留("="))) ||
          (当前类型(记号, 位置 + 1) == 令牌_运算符 &&
           当前ID(记号, 位置 + 1) == 整32(驻留("::")) &&
           位置 + 3 < 记号.大小() && 当前类型(记号, 位置 + 2) == 令牌_标识符 &&
           当前类型(记号, 位置 + 3) == 令牌_标识符))) ||
         是泛型声明(记号, 位置));
}


// 表达式兜底语句（R3 拆分，2026-09-08 自 解析语句 机械搬移）：解析表达式后三分支——
//   复合赋值 L op= R（③ 第二波方案A：回退重析合成 二元+赋值）/ 成员/解引用左值
//   赋值（P6c 表达式后遇 =）/ 纯表达式语句。
函数 解析表达式兜底语句(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    整64 值起点 = 池.大小();
    整64 语句起点 = 位置;
    位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
    // ③ 第二波（方案A 裁决）：复合赋值 L op= R ≡ L = L op R（标识符/成员/解引用
    //   左值统一）。回退重析左值作右值首操作数（成员偏移解析期重标注，两份独立
    //   正确），合成 二元(op) + 节点_赋值（左值区间=首份，右值区间=副本+R+二元）
    //   ——赋值/IR 两层零改动。
    如果 (位置 > 语句起点 && 池.大小() > 值起点 &&
         当前类型(记号, 位置) == 令牌_运算符 && 是复合赋值符(当前ID(记号, 位置))) {
        整32 复合符 = 当前ID(记号, 位置);
        整64 右值起点 = 池.大小();
        位置 = 语句起点;
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);   // 左值副本（右值首操作数）
        位置++;                                        // 复合符（重析后再到此处）
        整64 右操作数起点 = 池.大小();
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        // 子终点=1：复合赋值合成标记（与手写 名 = 名 + "乙" 可区分——语义层据此
        //   做非数值操作数拒绝；&&/|| 预扫按 子终点!=0+op 名双条件识别，不受影响）
        池追加(池, 建节点(节点_二元运算, 复合二元符号(复合符),
                          右操作数起点, 整32(右值起点), 1));
        池追加(池, 建节点(节点_赋值, 0, 值起点, 整32(右值起点), 整32(池.大小())));
        返回 吃分号(记号, 位置);
    }
    // P6c：成员/解引用左值赋值（位置.x = 7 / *指针 = 10）：表达式后遇 =
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("="))) {
        // 构造字面量赋值位·成员目标（第四十六轮观察项③，2026-09-09）：r.右下 = 点{...}——
        //   单跳成员目标（左值链恰为 标识符+成员 两节点且成员非方法调用）且字段
        //   类型为已登记结构体：全合成 对象.中间.字段 左值链模板（中间成员偏移
        //   复用解析成员后缀 的标注；字段类型经 查字段类型ID 推导）。多跳/下标/
        //   经指针目标不进入=保持旧路径可见失败（文档边界，随语法覆盖轮）。
        如果 (位置 + 2 < 记号.大小() &&
             当前类型(记号, 位置 + 1) == 令牌_标识符 &&
             当前类型(记号, 位置 + 2) == 令牌_运算符 &&
             当前ID(记号, 位置 + 2) == 整32(驻留("{")) &&
             池.大小() == 值起点 + 2 &&
             池.元素(值起点).类型 == 节点_标识符 &&
             池.元素(值起点 + 1).类型 == 节点_成员 &&
             整64(池.元素(值起点 + 1).附加) != 成员方法标记) {
            整32 对象名IDb = 池.元素(值起点).文本;
            节点 中间成员b = 池.元素(值起点 + 1);
            整64 结构体键b = 查结构体类型(整64(当前ID(记号, 位置 + 1)));
            整64 对象键b = 查变量结构体键(整64(对象名IDb));
            如果 (结构体键b > 0 && 对象键b > 0) {
                // 中间字段类型 -> 目标结构体键（字段类型表键基域，限定文本通吃）
                整64 字段类型IDb = 查字段类型ID(对象键b, 整64(中间成员b.文本));
                整64 目标键b = 查结构体类型(字段类型IDb);
                如果 (目标键b > 0) {
                    整64 构造名IDb = 当前ID(记号, 位置 + 1);
                    整64 构造行b = 整64(记号.元素(位置 + 1).行);
                    向量<整64> 链名们b = 向量<整64>();
                    向量<整64> 链偏移们b = 向量<整64>();
                    结果<空类型, 整32> 加名b = 链名们b.追加(整64(中间成员b.文本));
                    结果<空类型, 整32> 加偏b = 链偏移们b.追加(整64(中间成员b.附加));
                    如果 (!加名b.正常 || !加偏b.正常) { 运行时错误(4); }
                    位置 = 解析构造字段赋值们(记号, 位置 + 2, 池, 字段偏移表, 对象名IDb,
                                          链名们b, 链偏移们b, 目标键b, 构造名IDb, 构造行b);
                    返回 吃分号(记号, 位置);
                }
            }
        }
        位置++;
        整64 右值起点 = 池.大小();
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        池追加(池, 建节点(节点_赋值, 0, 整64(值起点), 整32(右值起点), 整32(池.大小())));
        返回 吃分号(记号, 位置);
    }
    池追加(池, 建节点(节点_表达式语句, 0, 0, 整32(值起点), 整32(池.大小())));
    返回 吃分号(记号, 位置);
}


// 解析代码块
函数 解析块(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("{"))) { 位置++; }
    整64 块起点 = 池.大小();
    整64 循环保护 = 0;
    当 (真) {
        如果 (当前类型(记号, 位置) == 令牌_文件结束) { 中断; }
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("}"))) { 位置++; 中断; }
        // plans/015 方案B 后此分支为裸分号防御（语句分号已由 吃分号 消费）
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(";"))) { 位置++; 继续; }
        整64 旧位置 = 位置;
        整32 语句前行 = 当前行(记号, 位置);   // 103-a（D2）：语句起始行
        整64 池前行 = 池.大小();
        位置 = 解析语句(记号, 位置, 池, 字段偏移表);
        // 103-a（D2）：语句根节点（最后入池者）回填行号——语义层 检查语句
        //   据此设诊断行（表诊断 输出「（行=N）」）。单点回填，其余节点行=0。
        如果 (池.大小() > 池前行) {
            节点 语句根103 = 池.元素(整32(池.大小()) - 1);
            语句根103.行 = 语句前行;
            结果<空类型, 整32> 设行103 = 池.设置(整32(池.大小()) - 1, 语句根103);
            如果 (!设行103.正常) { 运行时错误(4); }
        }
        循环保护++;
        如果 (位置 == 旧位置 || 循环保护 > 100000) {
            // 静默中断可见化（缺陷②分诊连带，B6/+= 语句级静默中断家族）：语句零
            //   消费=存在不可解析 token（如 *p += 1 的复合符、悬空运算符）——原静默
            //   中断吞掉块内后续全部语句（含 返回），产物行为不可预测。stderr 诊断
            //   使截断可见（E2E .expected 子串匹配不受额外行影响）
            IO::打印到错误("[parse] 语句解析中断于不可解析 token，块内后续语句被丢弃（位置=" +
                          整数转字符串(位置) + "）\n");
            中断;
        }
    }
    池追加(池, 建节点(节点_块, 0, 0, 整32(块起点), 整32(池.大小())));
    返回 位置;
}

// 如果语句解析（R3 拆分，2026-09-08 自 解析语句 机械搬移）：条件 + 真块 +
//   否则链（否则 如果 递归嵌套 / 否则 块）。节点字段：文本=条件起点，
//   子起点=条件终点，附加=真块索引，子终点=否则索引（0=无）。
函数 解析如果语句(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    位置++;
    整64 条件起点 = 池.大小();
    位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
    整64 条件终点 = 池.大小();
    位置 = 解析块(记号, 位置, 池, 字段偏移表);
    整64 真块索引 = 整64(池.大小()) - 1;   // 解析块 最后追加 块 节点
    // 否则链：否则 如果 ... / 否则 { ... }（P6b）
    整64 否则索引 = 0;
    如果 (是关键(记号, 位置, "否则")) {
        位置++;
        如果 (是关键(记号, 位置, "如果")) {
            // 否则 如果 -> 递归解析为 嵌套 如果语句，子区间含条件+块
            位置 = 解析语句(记号, 位置, 池, 字段偏移表);
            否则索引 = 整64(池.大小()) - 1;
        } 否则 {
            位置 = 解析块(记号, 位置, 池, 字段偏移表);
            否则索引 = 整64(池.大小()) - 1;
        }
    }
    // 节点字段（P6b）：文本=条件起点，子起点=条件终点，附加=真块索引，子终点=否则索引（0=无）
    池追加(池, 建节点(节点_如果语句, 整32(条件起点), 整64(真块索引), 整32(条件终点), 整32(否则索引)));
    返回 位置;
}

// 构造字面量赋值脱糖助手（第四十六轮观察项③，2026-09-09）：声明位/标识符赋值位/
//   成员赋值位单一助手同源（Rust 同构：构造字面量=目标 place 逐字段初始化，规范
//   05 二）。位置 须停在 '{'（类型名 token 由调用方判定消费，本函数消费 '{' 与
//   字段列表至 '}'）。左值链全合成（无重析死节点）：标识符(对象名ID) + 模板成员
//   链（链名们/链偏移们——声明位/标识符赋值位为空=一跳 对象.字段；成员赋值位为
//   一跳中间成员=两跳 对象.中间.字段）+ 字段成员（子起点=前一节点索引，与
//   解析成员后缀 同款；字段偏移=字段偏移表.获取(目标类型键*键位移+字段名ID)，
//   目标类型键<=0 恒 -1——与声明位原 对象结构体c>0 守卫逐点等价）。穷举/重复
//   纪律与诊断文本与第四十三轮声明位逐字一致（179/182 锚定）。
函数 解析构造字段赋值们(向量<Token> 记号, 整64 位置, 向量<节点> 池,
                    映射<整64, 整64>& 字段偏移表, 整32 对象名ID,
                    向量<整64>& 链名们, 向量<整64>& 链偏移们,
                    整64 目标类型键, 整64 结构体名ID, 整64 构造行) -> 整64 {
    如果 (!(当前类型(记号, 位置) == 令牌_运算符 &&
           当前ID(记号, 位置) == 整32(驻留("{")))) { 返回 位置; }
    位置++;
    向量<整32> 已见字段们 = 向量<整32>();
    当 (真) {
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留("}"))) { 位置++; 中断; }
        如果 (当前类型(记号, 位置) == 令牌_文件结束) {
            语法错误加一();
            IO::打印到错误("[parse] 结构体构造字面量未闭合（行=" +
                           整数转字符串(构造行) + "）\n");
            中断;
        }
        整64 左值起点 = 池.大小();
        池追加(池, 建节点(节点_标识符, 对象名ID, 0, 0, 0));
        整64 跳i = 0;
        当 (跳i < 链名们.大小()) {
            池追加(池, 建节点(节点_成员, 整32(链名们.元素(跳i)),
                              整64(链偏移们.元素(跳i)),
                              整32(整64(池.大小()) - 1), 0));
            跳i++;
        }
        整32 字段名f = 当前ID(记号, 位置);
        位置++;
        整64 偏移c = 0 - 1;
        如果 (目标类型键 > 0) {
            结果<整64, 整32> 偏移查c = 字段偏移表.获取(目标类型键 * 键位移 + 整64(字段名f));
            如果 (偏移查c.正常) { 偏移c = 偏移查c.值; }
        }
        池追加(池, 建节点(节点_成员, 字段名f, 偏移c, 整32(整64(池.大小()) - 1), 0));
        // 已见/重复登记（Rust E0062 同构：重复=编译错误）
        布尔 已见f = 假;
        整64 k = 0;
        当 (k < 已见字段们.大小()) {
            如果 (整64(已见字段们.元素(k)) == 整64(字段名f)) { 已见f = 真; }
            k++;
        }
        如果 (已见f) {
            语法错误加一();
            IO::打印到错误("[parse] 结构体初始化字段 '" + 驻留文本(整64(字段名f)) +
                           "' 重复（行=" + 整数转字符串(构造行) + "）\n");
        } 否则 {
            结果<空类型, 整32> 加见 = 已见字段们.追加(字段名f);
            如果 (!加见.正常) { 运行时错误(4); }
        }
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留("="))) { 位置++; }
        // 嵌套构造字面量（第四十六轮，186 踢出——宿主 emitStructInitTo 递归同构）：
        //   字段值本身是 类型{...} 且该类型=字段登记类型 → 以 链+本字段 递归下钻
        //   展平（Rust 嵌套字面量=链式字段投影；本层不发 赋值，递归层逐叶发射）。
        //   形态似而类型不合（应键n 落空/相异）不消费=落标量路径（可见失败保持）。
        布尔 已赋值n = 假;
        如果 (当前类型(记号, 位置) == 令牌_标识符 && 位置 + 1 < 记号.大小() &&
             当前类型(记号, 位置 + 1) == 令牌_运算符 &&
             当前ID(记号, 位置 + 1) == 整32(驻留("{"))) {
            整64 字段键n = 查结构体类型(整64(当前ID(记号, 位置)));
            整64 应键n = 0;
            如果 (目标类型键 > 0) {
                应键n = 查结构体类型(查字段类型ID(目标类型键, 整64(字段名f)));
            }
            如果 (字段键n > 0 && 字段键n == 应键n) {
                整64 构造名IDn = 当前ID(记号, 位置);
                结果<空类型, 整32> 加名n = 链名们.追加(整64(字段名f));
                结果<空类型, 整32> 加偏n = 链偏移们.追加(偏移c);
                如果 (!加名n.正常 || !加偏n.正常) { 运行时错误(4); }
                位置 = 解析构造字段赋值们(记号, 位置 + 1, 池, 字段偏移表, 对象名ID,
                                      链名们, 链偏移们, 字段键n, 构造名IDn, 构造行);
                // 链状态恢复（186 残链根治，2026-09-09）：递归层以 链+[本字段]
                //   为前缀合成叶赋值，返回后必须弹出本字段两元素——否则后续
                //   字段链带前层残段（双嵌套字段产物 r.左上.右下.x 形态）：
                //   地址偏移恰逢 前层偏移=0 数值巧合掩盖，宽度码按残链中间层
                //   查字段 miss 落 T_整64 -> 叶字段 8 字节越界写踩邻（186
                //   s1 被踩 rc=68 实锤；单嵌套字段探针 F 前层无后续字段不暴露）。
                结果<空类型, 整32> 删名n = 链名们.删除(链名们.大小() - 1);
                结果<空类型, 整32> 删偏n = 链偏移们.删除(链偏移们.大小() - 1);
                如果 (!删名n.正常 || !删偏n.正常) { 运行时错误(4); }
                如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留(","))) { 位置++; }
                已赋值n = 真;
            }
        }
        如果 (!已赋值n) {
            整64 右值起点 = 池.大小();
            位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
            池追加(池, 建节点(节点_赋值, 0, 整64(左值起点), 整32(右值起点), 整32(池.大小())));
            如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == 整32(驻留(","))) { 位置++; }
        }
    }
    // 穷举检查（Rust E0063 同构）：字段清单逐序比对，缺一即错
    整64 应有数 = 构造字段数(目标类型键);
    整64 序c = 0;
    当 (序c < 应有数) {
        整64 字段n = 构造字段名(目标类型键, 序c);
        布尔 找到f = 假;
        整64 k2 = 0;
        当 (k2 < 已见字段们.大小()) {
            如果 (整64(已见字段们.元素(k2)) == 字段n) { 找到f = 真; }
            k2++;
        }
        如果 (!找到f) {
            语法错误加一();
            IO::打印到错误("[parse] 结构体 '" + 驻留文本(结构体名ID) +
                           "' 初始化缺少字段 '" + 驻留文本(字段n) + "'（行=" +
                           整数转字符串(构造行) + "）\n");
        }
        序c++;
    }
    返回 位置;
}

// 变量声明语句解析（R3 拆分）：检测条件留 解析语句 主干（标识符 标识符 / 指针 /
//   引用带=前置消歧 / 限定类型 / 泛型六形态），本函数处理体：类型解析 + 结构体/
//   容器登记（P6e/P7b/第17枚）+ 初值表达式。
函数 解析变量声明语句(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    整64 类型节点 = 池.大小();
    位置 = 解析类型(记号, 位置, 池);
    整32 名ID = 当前ID(记号, 位置);
    // P6e：局部变量若是结构体类型（值语义），登记 变量名ID -> 结构体名ID
    //   （引用形态 附加=256 同样登记——对齐参数位惯例：q.值 成员基址=槽内容；
    //   第17枚根治：指针形态 附加=1..255 同登记——p.字段 偏移标注同参数位）
    节点 类型节点值 = 池.元素(类型节点);
    如果 (类型节点值.附加 <= 256) {
        // plans/018 类型分桶：登记值=键基（查结构体类型 三级——限定类型支持）
        整64 结构体键v = 查结构体类型(整64(类型节点值.文本));
        如果 (结构体键v != 0) {
            登记变量结构体(整64(名ID), 结构体键v);
        }
    }
    // P7b：容器/结果 变量登记 变量容器表（成员预标注用；引用形态 附加=256 同样登记）
    字符串 声明类型文本 = 字符串复制(驻留文本(整64(类型节点值.文本)));
    如果 (是容器类(声明类型文本) || 是结果类型(声明类型文本)) {
        登记变量容器(整64(名ID), 整64(类型节点值.文本));
    }
    // 94-a（2026-09-13 第九十四轮）：数组声明——元素为结构体时登记
    //   数组元素结构体表（成员链 表[0].x 的字段偏移标注/IR 对象类型推导消费）
    如果 (是数组类型文本(声明类型文本)) {
        字符串 元素94 = 数组元素文本(声明类型文本);
        如果 (字符串长度(元素94) > 0) {
            整64 元素结构体键94 = 查结构体类型(驻留(元素94));
            如果 (元素结构体键94 != 0) {
                登记数组元素结构体94(整64(名ID), 元素结构体键94);
            }
        }
    }
    位置++;
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("="))) {
        位置++;
        // 结构体构造字面量（2026-09-09 用户裁决，宿主 parseStructInit 对齐 +
        //   Rust E0063 穷举纪律，规范 05 二）：类型名{ 字段 = 值, ... } 解析期
        //   脱糖为 裸声明（B1 零初始化打底）+ 逐字段 成员左值赋值——复用既有
        //   成员偏移标注/赋值/IR 全链，零新节点/零新 IR。缺字段=编译错误
        //   （语法错误加一中止通道）；未知字段走 成员偏移 -1 既有语义诊断。
        //   判定：'=' 后 标识符==声明类型文本 且后随 '{'（表达式位 泛型构造
        //   向量$整64() 无 '{' 形态，无歧义）。
        如果 (当前类型(记号, 位置) == 令牌_标识符 &&
             整64(当前ID(记号, 位置)) == 整64(类型节点值.文本) &&
             位置 + 1 < 记号.大小() &&
             当前类型(记号, 位置 + 1) == 令牌_运算符 &&
             当前ID(记号, 位置 + 1) == 整32(驻留("{"))) {
            整64 构造行 = 整64(记号.元素(位置).行);
            // 裸声明节点先入池（B1 零初始化打底——穷举检查保证不缺字段）；
            //   字段循环+穷举检查第四十六轮起走 解析构造字段赋值们 单一助手
            //   （声明位/标识符赋值位/成员赋值位同源，诊断文本逐字一致）
            池追加(池, 建节点(节点_变量声明, 名ID, 整64(类型节点), 0, 0));
            向量<整64> 空链名们 = 向量<整64>();
            向量<整64> 空链偏移们 = 向量<整64>();
            位置 = 解析构造字段赋值们(记号, 位置 + 1, 池, 字段偏移表, 名ID,
                                  空链名们, 空链偏移们,
                                  查结构体类型(整64(类型节点值.文本)),
                                  整64(类型节点值.文本), 构造行);
        } 否则 如果 (是数组类型文本(声明类型文本) &&
                    当前类型(记号, 位置) == 令牌_运算符 &&
                    当前ID(记号, 位置) == 整32(驻留("{"))) {
            // 94-a（2026-09-13 第九十四轮）：数组初始化列表 { e1, e2, ... }
            //   （规格书 3.5 固定长度数组；宿主 parser 数组初始化列表分支对齐）。
            //   元素表达式逐个人池（区间遍历语义检查覆盖）；区间封入新节点
            //   节点_数组初始化（IR 层逐元素 store 到数组槽区，余下元素保零——
            //   宿主「部分初始化补零」同构）。元素数 > 长度=IR 层诊断拒绝。
            位置++;   // 吃 '{'
            整64 元素起点 = 池.大小();
            当 (位置 < 记号.大小() &&
                  !(当前类型(记号, 位置) == 令牌_运算符 &&
                    当前ID(记号, 位置) == 整32(驻留("}")))) {
                整64 单个起 = 池.大小();
                位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
                整64 单个终 = 池.大小();
                // 元素包装节点（94-a）：元素表达式长度任意（a+b/调用/字面量）——
                //   包装节点携带该元素区间，IR 层按包装节点逐元素生成=可靠切分
                池追加(池, 建节点(节点_数组元素, 0, 0, 整32(单个起), 整32(单个终)));
                如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留(","))) {
                    位置++;
                } 否则 { 中断; }
            }
            整64 元素终点 = 池.大小();
            如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == 整32(驻留("}"))) {
                位置++;
            }
            整64 初始化节点 = 池.大小();
            池追加(池, 建节点(节点_数组初始化, 0, 0, 整32(元素起点), 整32(元素终点)));
            池追加(池, 建节点(节点_变量声明, 名ID, 整64(类型节点),
                              整32(初始化节点), 整32(池.大小())));
        } 否则 {
            整64 值起点 = 池.大小();
            位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
            池追加(池, 建节点(节点_变量声明, 名ID, 整64(类型节点), 整32(值起点), 整32(池.大小())));
        }
    } 否则 {
        池追加(池, 建节点(节点_变量声明, 名ID, 整64(类型节点), 0, 0));
    }
    返回 吃分号(记号, 位置);
}

// 解引用语句解析（R3 拆分）：*指针 = 表达式 / *p op= r 复合赋值（灰色点③根治）/
//   *表达式 表达式语句（缺陷②分诊根治：包 节点_表达式语句 根）。
函数 解析解引用语句(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    整64 左值起点 = 池.大小();
    整64 语句起点 = 位置;
    位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("="))) {
        // 左值区间 = [左值起点, 表达式末节点+1)；表达式末节点即 解引用/成员 根
        整64 左值终点 = 整64(池.大小());
        位置++;
        整64 右值起点 = 池.大小();
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        池追加(池, 建节点(节点_赋值, 0, 整64(左值起点), 整32(右值起点), 整32(池.大小())));
        返回 吃分号(记号, 位置);
    }
    // 灰色点③根治（2026-09-04 用户裁决立案·缺陷零容忍）：解引用复合赋值
    //   *p op= r（方案A 对齐兜底复合分支——L op= R ≡ L = L op R）。原本分支
    //   只认 '='：*p += 1 走「非赋值」路径仅消费 *p，'+= 1' 成孤儿 token →
    //   下条语句零消费触发块循环保护中断 → 块内后续语句（含 返回）全部丢弃
    //   而 asm 仍生成=残缺产物（宿主分号语境支持 *p += 1，两侧行为分叉）。
    //   回退重析左值作右值首操作数，合成 二元(op)+赋值（子终点=1 合成标记，
    //   语义层据此做非数值操作数拒绝——与标识符/成员/下标形态完全同款）
    如果 (位置 > 语句起点 && 池.大小() > 左值起点 &&
         当前类型(记号, 位置) == 令牌_运算符 && 是复合赋值符(当前ID(记号, 位置))) {
        整32 复合符 = 当前ID(记号, 位置);
        整64 右值起点 = 池.大小();
        位置 = 语句起点;
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);   // 左值副本（右值首操作数）
        位置++;                                        // 复合符（重析后再到此处）
        整64 右操作数起点 = 池.大小();
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        池追加(池, 建节点(节点_二元运算, 复合二元符号(复合符),
                          右操作数起点, 整32(右值起点), 1));
        池追加(池, 建节点(节点_赋值, 0, 左值起点, 整32(右值起点), 整32(池.大小())));
        返回 吃分号(记号, 位置);
    }
    // 非赋值：*表达式 作为表达式语句——包 节点_表达式语句 根（缺陷②分诊根治：
    //   原裸节点无根——语义层靠块级裸派发兜底（双重处理根源），IR 语句派发
    //   对裸节点零分支静默跳过=死代码。根节点统一后语义/IR 各走语句根一次）
    池追加(池, 建节点(节点_表达式语句, 0, 0, 整32(左值起点), 整32(池.大小())));
    返回 吃分号(记号, 位置);
}

// 自增/自减语句解析（R3 拆分）：前缀 ++/-- 变量 或 后缀 变量 ++/--（簇③ C1
//   对称）。匹配返回新位置；不匹配返回 -1（主干继续走表达式兜底）。
函数 解析自增自减语句(向量<Token> 记号, 整64 位置, 向量<节点> 池) -> 整64 {
如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("++")) &&
     位置 + 1 < 记号.大小() && 当前类型(记号, 位置 + 1) == 令牌_标识符) {
    位置++;
    整32 自增名ID = 当前ID(记号, 位置);
    位置++;
    池追加(池, 建节点(节点_自增, 自增名ID, 0, 0, 0));
    返回 吃分号(记号, 位置);
}
如果 (当前类型(记号, 位置) == 令牌_标识符 && 位置 + 1 < 记号.大小() &&
     当前类型(记号, 位置 + 1) == 令牌_运算符 && 当前ID(记号, 位置 + 1) == 整32(驻留("++"))) {
    整32 后缀名ID = 当前ID(记号, 位置);
    位置 += 2;
    池追加(池, 建节点(节点_自增, 后缀名ID, 0, 0, 0));
    返回 吃分号(记号, 位置);
}
// 簇③根治·自减全链 C1（2026-09-04 用户裁决）：前缀 -- 变量 / 后缀 变量 --
//   ——与 节点_自增 分支完全对称（v2 仅语句级，前/后缀同语义）。词法补 --
//   后若无本分支，-- token 成孤儿触发块截断静默家族（lessons 复合赋值假绿同族）
如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("--")) &&
     位置 + 1 < 记号.大小() && 当前类型(记号, 位置 + 1) == 令牌_标识符) {
    位置++;
    整32 自减名ID = 当前ID(记号, 位置);
    位置++;
    池追加(池, 建节点(节点_自减, 自减名ID, 0, 0, 0));
    返回 吃分号(记号, 位置);
}
如果 (当前类型(记号, 位置) == 令牌_标识符 && 位置 + 1 < 记号.大小() &&
     当前类型(记号, 位置 + 1) == 令牌_运算符 && 当前ID(记号, 位置 + 1) == 整32(驻留("--"))) {
    整32 后缀减名ID = 当前ID(记号, 位置);
    位置 += 2;
    池追加(池, 建节点(节点_自减, 后缀减名ID, 0, 0, 0));
    返回 吃分号(记号, 位置);
}
返回 0 - 1;
}
