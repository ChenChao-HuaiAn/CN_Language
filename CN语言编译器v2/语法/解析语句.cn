// CN 自举编译器 v2 · 解析语句（千行拆分子模块，2026-09-08 用户裁决阶段目录包）
// 职责：语句解析与块解析（解析语句/解析块）——自 语法分析.cn 机械搬移
//   （函数与静态归属不变，跨文件经 公开: 函数访问）；模块路径=解析语句（新键基）。
导入 容器::向量;
导入 映射集合;
导入 词法;       // Token 结构（原 导入 词法分析，目录包名）
导入 IR;         // 节点_*/键位移 常量（原 IR容器+IR常量 合并目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 解析语句
// 201-a（2026-09-15 第两百零一轮，D1 行数整改）：语句类型守卫链留主函数，五分支体提取为
函数 带守卫解析语句(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    整64 新位置 = 解析语句(记号, 位置, 池, 字段偏移表);
    如果 (新位置 <= 位置) {
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                       ": 语句解析未前进（错误恢复强制前进）\n");
        语法错误加一();
        返回 位置 + 1;
    }
    返回 新位置;
}

函数 解析语句(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    // ②b B4（2026-09-02）：裸块语句 { ... }（块级作用域——126 ④a RAII 载体）。
    //   旧版无此分支：解析块 遇 { 落入表达式兜底不消费 -> 循环保护中断，
    //   块内及后续全部语句静默丢失（实测 126 返回 0 丢失 -> 垃圾退出码 20）。
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("{"))) {
        返回 解析块(记号, 位置, 池, 字段偏移表);
    }
    // 326-a（D38 批1·对齐宿主 295）：裸分号空语句拒绝（宿主诊断「预期表达式」）
    //   ——plans/015 语句必须分号终结后，`;` 只能作为语句终结符，独立成句非法
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(";"))) {
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                       ": 裸分号空语句——预期表达式\n");
        语法错误加一();
        位置++;
        返回 位置;
    }
    如果 (是关键(记号, 位置, "返回")) {
        返回 解析返回语句(记号, 位置, 池, 字段偏移表);
    }
    如果 (是关键(记号, 位置, "如果")) {
        返回 解析如果语句(记号, 位置, 池, 字段偏移表);
    }
    如果 (是关键(记号, 位置, "当")) {
        返回 解析当语句(记号, 位置, 池, 字段偏移表);
    }
    如果 (是关键(记号, 位置, "选择")) {
        返回 解析选择语句(记号, 位置, 池, 字段偏移表);
    }
    如果 (是关键(记号, 位置, "循环")) {
        返回 解析循环语句(记号, 位置, 池, 字段偏移表);
    }
    如果 (是关键(记号, 位置, "中断")) { 位置++; 池追加(池, 建节点(节点_中断语句, 0, 0, 0, 0)); 返回 吃分号(记号, 位置); }
    如果 (是关键(记号, 位置, "继续")) { 位置++; 池追加(池, 建节点(节点_继续语句, 0, 0, 0, 0)); 返回 吃分号(记号, 位置); }
    // P7a 局部常量：常量 名 = 表达式——按 整64 局部变量处理（合成 节点_类型(整64)；
    //   v2 语义层不区分只读性，自举组件源码仅用顶层常量，此分支防新关键字停滞解析）
    如果 (是词(记号, 位置, "常量")) {
        返回 解析常量语句(记号, 位置, 池, 字段偏移表);
    }
    // 865-a（070·G-N 特性波）：函数内静态局部声明（静态 类型 名 [= 初值];）——
    //   与顶层共用 解析静态声明（内部按 当前解析函数86 判定合成名改写·
    //   规范 03 T41/C 同款一次性初始化；宿主 320-a 对齐））
    如果 (是词(记号, 位置, "静态")) {
        返回 解析静态声明(记号, 位置, 池, 字段偏移表);
    }
    // 46-c 类型推断声明（2026-09-10 第四十九轮，规范 03 变量声明形式1；宿主
    //   parseVarDeclAfterKeyword Kw_Var 同构）：变量 标识符 = 表达式——类型由
    如果 (是关键(记号, 位置, "变量")) {
        返回 解析推断声明语句(记号, 位置, 池, 字段偏移表);
    }
    // 894-a（070·G-N 特性波3·61/97）：遍历...中每个 上下文关键字探测（标识符
    //   形态——**须先于变量声明探测**：`遍历 数据 中` 形态=标识符 标识符 会
    如果 (当前类型(记号, 位置) == 令牌_标识符 &&
         字符串比较(当前文本(记号, 位置), "遍历")) {
        布尔 遍历形态894 = 假;
        整64 探q894 = 位置 + 1;
        当 (探q894 < 整64(记号.大小())) {
            如果 (当前类型(记号, 探q894) == 令牌_标识符) {
                字符串 探文本894 = 字符串复制(当前文本(记号, 探q894));
                如果 (字符串比较(探文本894, "中") || 字符串比较(探文本894, "每个")) {
                    遍历形态894 = 真;
                    中断;
                }
            } 否则 如果 (当前类型(记号, 探q894) == 令牌_运算符) {
                整64 探符894 = 整64(当前ID(记号, 探q894));
                如果 (探符894 == 驻留(";") || 探符894 == 驻留("{")) { 中断; }
            }
            探q894++;
        }
        如果 (遍历形态894) {
            返回 解析遍历语句(记号, 位置, 池, 字段偏移表);
        }
    }
    // 变量声明检测：标识符 标识符（值）或 标识符 * 标识符（指针类型，P6c）
    //   或 标识符 & 标识符 =（裸类型引用，2026-09-04 缺陷零容忍收口——宿主 parser
    如果 (是变量声明前瞻(记号, 位置)) {
        返回 解析变量声明语句(记号, 位置, 池, 字段偏移表);
    }
    // P6b 赋值语句：标识符 = 表达式（左值 -> 右值）——体含构造字面量赋值位形态
    如果 (当前类型(记号, 位置) == 令牌_标识符 && 位置 + 1 < 记号.大小() &&
         当前类型(记号, 位置 + 1) == 令牌_运算符 && 当前ID(记号, 位置 + 1) == 整32(驻留("="))) {
        返回 解析赋值语句(记号, 位置, 池, 字段偏移表);
    }
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("*"))) {
        返回 解析解引用语句(记号, 位置, 池, 字段偏移表);
    }
    整64 自增减位置 = 解析自增自减语句(记号, 位置, 池);
    如果 (自增减位置 >= 0) { 返回 自增减位置; }
    // 408-a（D43·守卫移位）：别名关键字残留语句=错误（声明/赋值尝试之后）
    // 657-a（024/D43 单一归属收口）：谓词收敛至 是别名关键字（解析基础.cn）
    如果 (是别名关键字(记号, 位置)) {
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                       ": 内置类型别名 '" + 当前文本(记号, 位置) +
                       "' 不可作变量名或函数名\n");
        语法错误加一();
        位置++;
        返回 位置;
    }
    返回 解析表达式兜底语句(记号, 位置, 池, 字段偏移表);
}

// 201-a：返回语句解析（值可选+吃分号；灰色点②字符串内容判定注释随体）。
函数 解析返回语句(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
        位置++;
        整64 值起点 = 池.大小();
        // 灰色点②方案A（2026-09-04）：字符串 != 字面量 原按驻留地址比较（依赖
        //   驻留恒等的实现细节，宿主已显式拒绝）——改 字符串比较 内容判定
        如果 (当前类型(记号, 位置) != 令牌_运算符 || !字符串比较(当前文本(记号, 位置), "}")) {
            位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        }
        池追加(池, 建节点(节点_返回语句, 0, 0, 整32(值起点), 整32(池.大小())));
        返回 吃分号(记号, 位置);
}

// 201-a：当语句解析（条件+体块+P6b 节点字段布局注释随体）。
函数 解析当语句(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
        位置++;
        整64 条件起点 = 池.大小();
        // 177（甲案·消歧条文）：**仅无括号条件**解析期间置 条件位抑制哨兵177（{ 归
        //   条件后语句块·宿主 suppressStructInit_ 同构·写经不安全助手 B10 收口·
        //   带括号 () 无歧义不置位）
        布尔 抑制旧值当177 = 条件位抑制哨兵177;
        如果 (!(当前类型(记号, 位置) == 令牌_运算符 &&
                当前ID(记号, 位置) == 整32(驻留("(")))) {
            条件位抑制177开启();
        }
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        条件位抑制177恢复(抑制旧值当177);
        整64 条件终点 = 池.大小();
        // 326-a（D38 批1·对齐宿主 296）：当 体须为块——`当(...);` 直接分号形态
        //   宿主诊断「预期 '{'」拒绝（空体当循环既非 C 惯例亦不安全·显式拒绝）。
        //   原实现落 解析块：`;` 被裸分号防御跳过、后续语句被静默吞进当体。
        如果 (!(当前类型(记号, 位置) == 令牌_运算符 &&
                当前ID(记号, 位置) == 整32(驻留("{")))) {
            IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                           ": 当 体预期 '{'\n");
            语法错误加一();
        }
        位置 = 解析块(记号, 位置, 池, 字段偏移表);
        整64 体块索引 = 整64(池.大小()) - 1;   // 解析块 最后追加 块 节点
        // 节点字段（P6b）：文本=条件起点，附加=体块索引，子起点=条件终点
        池追加(池, 建节点(节点_当语句, 整32(条件起点), 整64(体块索引), 整32(条件终点), 0));
        返回 位置;
}

// 894-a（070·G-N 特性波3·61/97）：遍历 <迭代对象> 中 每个 <变量名> { 体 }
//   ——宿主 parseRangeForStmt 同构（宽容扫描·结构错误显式诊断）；迭代对象=
函数 解析遍历语句(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    位置++;   // 消费 遍历
    整64 迭代对象起 = 池.大小();
    位置 = 解析表达式(记号, 位置, 池, 字段偏移表);   // 迭代对象（名称式·止于「中」）
    整64 迭代对象终 = 池.大小();
    如果 (!(当前类型(记号, 位置) == 令牌_标识符 &&
            字符串比较(当前文本(记号, 位置), "中"))) {
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                       ": '遍历' 语句须为：遍历 容器 中 每个 变量名 { 循环体 }（预期 '中'）\n");
        语法错误加一();
    } 否则 {
        位置++;
    }
    如果 (!(当前类型(记号, 位置) == 令牌_标识符 &&
            字符串比较(当前文本(记号, 位置), "每个"))) {
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                       ": '遍历' 语句须为：遍历 容器 中 每个 变量名 { 循环体 }（预期 '每个'）\n");
        语法错误加一();
    } 否则 {
        位置++;
    }
    整32 变量名ID = 0;
    如果 (当前类型(记号, 位置) == 令牌_标识符) {
        变量名ID = 当前ID(记号, 位置);
        位置++;
    } 否则 {
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                       ": '遍历' 语句须为：遍历 容器 中 每个 变量名 { 循环体 }（预期变量名）\n");
        语法错误加一();
    }
    位置 = 解析块(记号, 位置, 池, 字段偏移表);
    整64 体块索引894 = 整64(池.大小()) - 1;
    // 布局=当/循环惯例（附加=体块索引·跳过区间=[遍历+1, 附加+1)）：
    //   文本=迭代对象区起、子起点=迭代对象区终、附加=体块索引、子终点=变量名ID
    池追加(池, 建节点(节点_遍历语句, 整32(迭代对象起), 整32(体块索引894),
                      整32(迭代对象终), 变量名ID));
    返回 位置;
}

// 357-a（D39 根治·规范 plans/001 §3 循环头分号=三段分隔符）：三段式循环
//   循环 (init; cond; step) { 体 }——池连续布局：init [I0,C0)、cond [C0,S0)、
函数 解析循环语句(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    位置++;
    如果 (!(当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("(")))) {
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 循环 预期 '('\n");
        语法错误加一();
        返回 位置;
    }
    位置++;
    // 深度感知探测：第一顶层分号（三段式判据）与右括号
    整64 深度 = 1;
    整64 探 = 位置;
    整64 第一分号 = -1;
    整64 右括号 = -1;
    当 (探 < 整64(记号.大小())) {
        如果 (当前类型(记号, 探) == 令牌_运算符) {
            整64 文 = 当前ID(记号, 探);
            如果 (文 == 驻留("(")) {
                深度++;
            } 否则 如果 (文 == 驻留(")")) {
                深度--;
                如果 (深度 == 0) { 右括号 = 探; 中断; }
            } 否则 如果 (文 == 驻留(";") && 深度 == 1 && 第一分号 < 0) {
                第一分号 = 探;
            }
        }
        探++;
    }
    如果 (右括号 < 0) {
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 循环 头未闭合\n");
        语法错误加一();
        返回 位置;
    }
    // 头内无顶层分号=当式形态（宿主按三段式解析报「预期 ';'」拒绝——
    //   规范「循环」仅三段式·当式用「当」）→ 走三段式解析自然诊断
    // init 段（解析语句 自吃分号；空段跳分号）
    整64 init起点 = 池.大小();
    如果 (位置 == 第一分号) {
        位置++;
    } 否则 {
        位置 = 带守卫解析语句(记号, 位置, 池, 字段偏移表);
    }
    // cond 段（解析表达式 到第二分号；空段跳分号）
    整64 cond起点 = 池.大小();
    如果 (!(当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(";")))) {
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
    }
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(";"))) {
        位置++;
    } 否则 {
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 循环 头预期 ';'\n");
        语法错误加一();
    }
    // step 段：自增/自减（++/-- 前/后缀·复用语句级形态但自实现——语句版尾部
    //   吃分号而 step 段末尾是 ')'）或赋值（=·解引用语句 同构左值/右值合成）
    //   或表达式；空段零区间。体块节点索引=S1（step 段直接后随体块）。
    整64 step起点 = 池.大小();
    如果 (!(当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(")")))) {
        布尔 step已解析 = 假;
        如果 (!step已解析 && 当前类型(记号, 位置) == 令牌_运算符 &&
             (当前ID(记号, 位置) == 整32(驻留("++")) || 当前ID(记号, 位置) == 整32(驻留("--"))) &&
             位置 + 1 < 记号.大小() && 当前类型(记号, 位置 + 1) == 令牌_标识符) {
            // 前缀 ++/--
            整32 前缀类型 = (当前ID(记号, 位置) == 整32(驻留("++"))) ? 节点_自增 : 节点_自减;
            整32 前缀名ID = 静态名归一86(当前ID(记号, 位置 + 1));
            位置 += 2;
            池追加(池, 建节点(前缀类型, 前缀名ID, 0, 0, 0));
            step已解析 = 真;
        }
        如果 (!step已解析 && 当前类型(记号, 位置) == 令牌_标识符 &&
             位置 + 1 < 记号.大小() && 当前类型(记号, 位置 + 1) == 令牌_运算符 &&
             (当前ID(记号, 位置 + 1) == 整32(驻留("++")) || 当前ID(记号, 位置 + 1) == 整32(驻留("--")))) {
            // 后缀 ++/--
            整32 后缀类型 = (当前ID(记号, 位置 + 1) == 整32(驻留("++"))) ? 节点_自增 : 节点_自减;
            整32 后缀名ID = 静态名归一86(当前ID(记号, 位置));
            位置 += 2;
            池追加(池, 建节点(后缀类型, 后缀名ID, 0, 0, 0));
            step已解析 = 真;
        }
            // 868-a（070·G-N）：step 段复合赋值（`轮 += 1`）——与 解析表达式兜底语句
            //   同款合成：L op= R ≡ L = L op R（左值 + 左值副本 + 右操作数 + 二元 + 赋值；
            如果 (!step已解析 && 当前类型(记号, 位置) == 令牌_标识符 &&
                位置 + 1 < 记号.大小() && 当前类型(记号, 位置 + 1) == 令牌_运算符 &&
                是复合赋值符(当前ID(记号, 位置 + 1))) {
                整32 复符86 = 当前ID(记号, 位置 + 1);
                整32 左值名86 = 静态名归一86(当前ID(记号, 位置));
                整64 值起86 = 池.大小();
                池追加(池, 建节点(节点_标识符, 左值名86, 0, 0, 0));
                整64 右值起86 = 池.大小();
                池追加(池, 建节点(节点_标识符, 左值名86, 0, 0, 0));
                位置 += 2;
                整64 右操作起86 = 池.大小();
                位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
                池追加(池, 建节点(节点_二元运算, 复合二元符号(复符86),
                                  右操作起86, 整32(右值起86), 1));
                // 868-a：纯标识符左值（step 段条件已限定）→ 「文本=名ID」形态
                //   （同 兜底语句·IR 走标识符赋值含静态槽分支）
                池追加(池, 建节点(节点_赋值, 左值名86, 0, 整32(右值起86),
                                  整32(池.大小())));
                step已解析 = 真;
            }
        如果 (!step已解析 && 当前类型(记号, 位置) == 令牌_标识符 &&
            位置 + 1 < 记号.大小() && 当前类型(记号, 位置 + 1) == 令牌_运算符 &&
            当前ID(记号, 位置 + 1) == 整32(驻留("="))) {
            // 赋值（标识符=表达式·解引用语句 同构节点合成）
            整32 左值名ID = 当前ID(记号, 位置);
            整64 左值节点 = 池.大小();
            池追加(池, 建节点(节点_标识符, 静态名归一86(左值名ID), 0, 0, 0));
            位置 += 2;
            整64 右值起点 = 池.大小();
            位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
            池追加(池, 建节点(节点_赋值, 0, 整64(左值节点), 整32(右值起点), 整32(池.大小())));
            step已解析 = 真;
        }
        如果 (!step已解析) {
            位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        }
    }
    整64 step终点 = 池.大小();
    如果 (!(当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(")")))) {
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 循环 头预期 ')\n");
        语法错误加一();
    }
    位置++;
    // 体块
    位置 = 解析块(记号, 位置, 池, 字段偏移表);
    整64 体块索引 = 整64(池.大小()) - 1;
    池追加(池, 建节点(节点_循环语句, 整32(init起点), 整64(体块索引), 整32(cond起点), 整32(step起点)));
    返回 位置;
}

// 201-a：常量语句解析（P7a 局部常量按 整64 局部变量处理）。
函数 解析常量语句(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
        位置++;
        整64 类型节点 = 池.大小();
        池追加(池, 建节点(节点_类型, 整32(驻留("整64")), 0, 0, 0));
        整32 名ID = 当前ID(记号, 位置);
        位置++;
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("="))) {
            位置++;
            整64 值起点 = 池.大小();
            位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
            池追加(池, 建节点(节点_变量声明, 名ID, 整64(类型节点), 整32(值起点), 整32(池.大小())));
        } 否则 {
            池追加(池, 建节点(节点_变量声明, 名ID, 整64(类型节点), 0, 0));
        }
        返回 吃分号(记号, 位置);
}

// 201-a：推断声明语句解析（46-c 类型推断；无 '=' 语法错误 fail fast）。
