// 语法分析尾（357 重构F2 自 语法分析.cn 纯机械搬移·函数体逐字保留·零逻辑变化）

导入 容器::向量;
导入 映射集合;
导入 词法;       // Token 结构（原 词法分析，阶段目录包名，2026-09-08）
导入 IR;         // 容器/结果 合成名判定 + 节点_*/键位移 常量（原 IR容器+IR常量 合并目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 IO;         // 349-a：解析诊断输出（打印到错误）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

函数 扫描导入(向量<Token> 记号) -> 空类型 {
    登记导入项们(记号);
    整64 位置 = 0;
    当 (位置 < 记号.大小()) {
        如果 (当前类型(记号, 位置) == 令牌_关键字 && 当前ID(记号, 位置) == ID_导入) {
            位置++;
            如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_标识符) {
                模块登记(当前ID(记号, 位置));
                位置++;
            }
            如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == ID_双冒号) {
                位置++;
                如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == ID_左花括号) {
                    // 导入 路径::{项}：跳到 } 之后
                    当 (位置 < 记号.大小() &&
                         !(当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == ID_右花括号)) {
                        位置++;
                    }
                } 否则 {
                    // 导入 路径::符号 或 导入 路径::*：跳过符号/通配符
                    位置++;
                }
            } 否则 如果 (位置 < 记号.大小() && 是词(记号, 位置, "作为")) {
                // 导入 路径 作为 别名：跳过别名（P6b：作为 升格关键字，走 是关键）
                位置 += 2;
            }
            继续;
        }
        // plans/018 P6b：模块 X; 顶层声明——预解析登记挂载名（加载器在解析前
        //   得知子模块，父挂子自动加载强语义；权威校验在 解析程序）
        如果 (是词(记号, 位置, "模块")) {
            位置++;
            如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_标识符) {
                模块声明登记(当前ID(记号, 位置));
                位置++;
                如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == ID_分号) {
                    位置++;
                }
            }
            继续;
        }
        位置++;
    }
}





// 解析常量声明（P7a，2026-09-01）：常量 名 = 表达式（类型推断，规范 5.2）。
//   节点字段：文本=名ID，子区间=初始化表达式（整数字面量 或 负号字面量——
//   负数经 解析表达式 一元前缀自然成 [字面量, 负号] 区间，IR 层折叠识别）。
//   显式类型形式（常量 整64 名 = 值）本轮不解析——v2 组件源码全部为推断式。
函数 解析常量声明(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表,
                  整64 是否公开) -> 整64 {
    如果 (是词(记号, 位置, "常量")) { 位置++; }
    整32 名ID = 当前ID(记号, 位置);
    位置++;
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == ID_等号) { 位置++; }
    整64 值起点 = 池.大小();
    位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
    // plans/018 常量分桶：附加=公开位（顶层可见性标签）——IR 层 收集常量 候选
    //   登记与语义层可见性判定同源（附加位原 0 空闲，首用）
    池追加(池, 建节点(节点_常量声明, 名ID, 是否公开, 整32(值起点), 整32(池.大小())));
    返回 吃分号(记号, 位置);
}

// 解析完整程序：顶层声明序列（函数/结构体/常量/导入——导入 由 扫描导入 先行登记）
//   簇②根治·B1：入口 清空+重扫 导入项们（权威登记点——紧贴本文件解析，
//   防依赖文件的扫描/解析窗口抹掉本文件登记，见 登记导入项们 时序纪律注释）
// 418-a（D40 细分）：枚举声明解析——枚举 名 { 成员 [= 值] [, 成员... ] }
//   （C 风格·stdlib 核心 错误码 同款形态）。成员常量值=显式整数字面量或
//   默认前值+1（首个默认 0）；登记 枚举表（存在们+成员值们——语义层成员链
//   放行+IR 生成层常量折叠消费）。产出 节点_枚举 声明节点（文本=枚举名ID·
//   子区间=成员节点·顶层可见性登记复用）。成员值表键=枚举名ID*键位移+成员名ID
//   （驻留 ID 全局唯一→跨模块导入 天然一致）。
函数 解析枚举声明(向量<Token> 记号, 整64 位置, 向量<节点> 池, 整64 是否公开) -> 整64 {
    位置++;   // 消费 枚举
    如果 (当前类型(记号, 位置) != 令牌_标识符) {
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 枚举声明缺少名称\n");
        语法错误加一();
        返回 位置;
    }
    整32 枚举名ID = 当前ID(记号, 位置);
    位置++;
    如果 (!(当前类型(记号, 位置) == 令牌_运算符 &&
           当前ID(记号, 位置) == ID_左花括号)) {
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 枚举 预期 '{'\n");
        语法错误加一();
        返回 位置;
    }
    位置++;
    登记枚举名(整64(枚举名ID));
    整64 成员起点 = 池.大小();
    整64 当前值 = 0;
    当 (真) {
        如果 (当前类型(记号, 位置) == 令牌_文件结束) {
            IO::打印到错误("[parse] 枚举体未闭合（缺 '}'}）\n");
            语法错误加一();
            返回 位置;
        }
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == ID_右花括号) { 位置++; 中断; }
        如果 (当前类型(记号, 位置) != 令牌_标识符) {
            IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 枚举成员预期名称\n");
            语法错误加一();
            返回 位置;
        }
        整32 成员名ID = 当前ID(记号, 位置);
        位置++;
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == ID_等号) {
            位置++;
            如果 (当前类型(记号, 位置) != 令牌_整数字面量 &&
                  !(当前类型(记号, 位置) == 令牌_运算符 &&
                   当前ID(记号, 位置) == ID_减号)) {
                IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 枚举成员值预期整数字面量\n");
                语法错误加一();
                返回 位置;
            }
            // 436-a（T66·规范 05 枚举负数）：可选一元负号前缀——`缺考 = -1` 形态
            //   （plans/001 §05「枚举（简单/赋值/负数）」）——负号经 位模式取负474
            //   入当前值（整64 中转·后续自动递增基于该值）。
            // 728u（583 扫描 R1a·519 同族根治·2026-10-17 #900 恢复）：773 集成版
            //   误回滚本修复（rebase 取旧侧）——「0 - 值」安全区减法在
            //   数字文本转数值 回绕得 MIN 位模式后二次溢出=错误码 8 自举自杀
            //   （合法输入 甲 = -9223372036854775808 即 v2p 中止·945 红线）。
            //   位模式取负474（协议常量·-2^63 补码不动点特判·与宿主两补码
            //   回绕同口径：MIN 取负=MIN、-MAX 取负=-MAX）。
            整64 成员值 = 0;
            如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == ID_减号) {
                位置++;
                如果 (当前类型(记号, 位置) != 令牌_整数字面量) {
                    IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 枚举成员值预期整数字面量\n");
                    语法错误加一();
                    返回 位置;
                }
                成员值 = 位模式取负474(数字文本转数值(字符串复制(驻留文本(整64(当前ID(记号, 位置))))));
            } 否则 {
                成员值 = 数字文本转数值(字符串复制(驻留文本(整64(当前ID(记号, 位置)))));
            }
            当前值 = 成员值;
            位置++;
        }
        登记枚举成员值(整64(枚举名ID), 整64(成员名ID), 当前值);
        池追加(池, 建节点(节点_枚举成员, 成员名ID, 当前值, 0, 0));
        // 728u（583 同族第二崩点·2026-10-17 #900 恢复）：前值=MAX 时安全区
        //   +1 溢出错误码 8（合法输入 乙 = 9223372036854775807 后自动递增）——
        //   改显式回绕加（回绕加64·MAX+1=MIN·与宿主两补码回绕同口径）。
        当前值 = 回绕加64(当前值, 1);
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == ID_逗号) { 位置++; }
    }
    池追加(池, 建节点(节点_枚举, 枚举名ID, 0, 整32(成员起点), 整32(池.大小())));
    返回 位置;
}

// 753（167 采样五形态）：顶层兜底漂过计数——落兜底（无法识别的顶层记号）原
//   静默跳过，现计数；判定延到语义通过后的收尾（主.cn 收尾守卫，跨文件直接读，
//   同 语法错误数 惯例）。语义层已拒绝的形态保持原诊断（271_v2 零分叉约束）。
静态 整64 顶层兜底漂过数753 = 0;

不安全 函数 清空顶层兜底漂过753() -> 空类型 {
    顶层兜底漂过数753 = 0;
}

// 480（473 p9·001 §747 表第 8 行整族执法）：体内写顶层静态 语法错误数
//   （顶层声明终结算子检查）须 不安全 函数——编译器内部全局错误计数写。
不安全 函数 解析程序(向量<Token> 记号, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    清空导入项们();
    // 平铺向量随映射同窗口清空（权威登记点紧贴本文件解析——预扫描登记被
    //   抹除重扫，平铺与映射内容保持一致）
    清空导入项平铺();
    登记导入项们(记号);
    // plans/018 第 3 层前置：可见性标签（公开:=1/私有:=0，标签块语义——
    //   标签后直到下一标签的顶层声明同属；缺省=0 默认私有，规格 08 5.9.3）
    整64 可见性标签 = 0;
    整64 公开导入前缀1011 = 0;   // #751 P2：内联 `公开 导入 路径`（无 公开: 块）
    整64 位置 = 0;
    整64 程序起点 = 池.大小();
    当 (位置 < 记号.大小()) {
        如果 (当前类型(记号, 位置) == 令牌_文件结束) { 中断; }
        如果 (是词(记号, 位置, "公开")) {
            // 公开: 标签（公开 + ':' 两记号）；#751 P2 内联 `公开 导入 路径`
            //   （无 公开: 块）前缀登记——两形态均无 else 业务块
            布尔 标签冒号1011 = 位置 + 1 < 记号.大小() &&
                当前类型(记号, 位置 + 1) == 令牌_运算符 &&
                当前ID(记号, 位置 + 1) == ID_冒号;
            如果 (标签冒号1011) {
                可见性标签 = 1;
                位置 += 2;
            }
            如果 (!标签冒号1011) {
                布尔 内联导入前缀1011 = 位置 + 1 < 记号.大小() &&
                    是关键(记号, 位置 + 1, "导入");
                如果 (内联导入前缀1011) { 公开导入前缀1011 = 1; }
                位置++;
            }
        } 否则 如果 (是词(记号, 位置, "私有")) {
            如果 (位置 + 1 < 记号.大小() && 当前类型(记号, 位置 + 1) == 令牌_运算符 &&
                 当前ID(记号, 位置 + 1) == ID_冒号) {
                可见性标签 = 0;
                位置 += 2;
            } 否则 {
                位置++;
            }
        } 否则 如果 (是关键(记号, 位置, "不安全") &&
                   位置 + 1 < 记号.大小() && 是关键(记号, 位置 + 1, "函数")) {
            // plans/019 阶段4 第二批：不安全 函数 修饰——v2 语法层放行（观察期
            //   v2 不查安全区边界，修饰零语义零 IR；自举树迁移后 v2 可解析自身）
            // 153-a（plans/023 §八 v2 挂点）：修饰**不再丢弃**——回填函数节点
            //   「修饰」字段（语义层据此维护「当前函数不安全」并豁免 9 类挂点）。
            位置++;
            位置 = 解析函数声明(记号, 位置, 池, 字段偏移表, 1);
            顶层可见性登记(池, 程序起点, 可见性标签);
        } 否则 如果 (是关键(记号, 位置, "函数")) {
            位置 = 解析函数声明(记号, 位置, 池, 字段偏移表, 0);
            顶层可见性登记(池, 程序起点, 可见性标签);
        } 否则 如果 (是词(记号, 位置, "外部")) {
            // 340-a（D38 批3b·363）：外部 函数 声明——原被顶层兜底分支静默吞
            //   （「外部」单跳后 函数 带体被当普通函数=该拒不拒不扩面修复）。
            //   外部+函数 连写=无体声明；带体=宿主措辞拒绝对齐。
            如果 (位置 + 1 < 记号.大小() && 是关键(记号, 位置 + 1, "函数")) {
                位置 = 解析外部函数声明(记号, 位置 + 2, 池);
            } 否则 {
                位置++;
            }
        } 否则 如果 (是关键(记号, 位置, "不安全") && 位置 + 2 < 记号.大小() &&
                   是词(记号, 位置 + 1, "可搬运") &&
                   (是关键(记号, 位置 + 2, "结构体") ||
                    是关键(记号, 位置 + 2, "联合体") ||
                    是关键(记号, 位置 + 2, "类"))) {
            // 217（027 波2a·001 §5.8a）：不安全 可搬运 结构体/联合体/类——
            //   便携豁免声明（对标 Rust unsafe impl Send·声明人自担责任）。
            //   「可搬运」为声明位上下文词非保留字（外部 函数 同款组合探测·
            //   关键字表零变更）；豁免键基登记 可搬运豁免键们。
            位置 += 2;  // 消费 不安全 + 可搬运
            整64 豁免名ID = 当前ID(记号, 位置 + 1);
            如果 (是关键(记号, 位置, "类")) {
                位置 = 解析类声明(记号, 位置, 池, 字段偏移表, 可见性标签);
                位置 = 拒绝声明体尾分号(记号, 位置, "类");       // 536：体后分号拒绝
            } 否则 如果 (是关键(记号, 位置, "联合体")) {
                位置 = 解析结构体声明(记号, 位置, 池, 字段偏移表, 可见性标签);
                位置 = 拒绝声明体尾分号(记号, 位置, "联合体");   // 536：体后分号拒绝
            } 否则 {
                位置 = 解析结构体声明(记号, 位置, 池, 字段偏移表, 可见性标签);
                位置 = 拒绝声明体尾分号(记号, 位置, "结构体");   // 536：体后分号拒绝
            }
            顶层可见性登记(池, 程序起点, 可见性标签);
            结果<空类型, 整32> 加豁免217 = 可搬运豁免键们.追加(键基合成(取当前模块路径(), 豁免名ID));
            如果 (!加豁免217.正常) { 运行时错误(4); }
        } 否则 如果 (是关键(记号, 位置, "结构体")) {
            位置 = 解析结构体声明(记号, 位置, 池, 字段偏移表, 可见性标签);
            位置 = 拒绝声明体尾分号(记号, 位置, "结构体");   // 536：体后分号拒绝
            顶层可见性登记(池, 程序起点, 可见性标签);
        } 否则 如果 (是关键(记号, 位置, "枚举")) {
            // 418-a（D40 细分）：枚举声明——枚举 名 { 成员 [= 值] [, ...] }
            //   （C 风格·stdlib 核心 错误码 同款）。成员常量登记 枚举表（语义
            //   放行+IR 常量折叠）+节点_枚举 产出（顶层可见性登记复用）。
            位置 = 解析枚举声明(记号, 位置, 池, 可见性标签);
            位置 = 拒绝声明体尾分号(记号, 位置, "枚举");   // 536：体后分号拒绝
            顶层可见性登记(池, 程序起点, 可见性标签);
        } 否则 如果 (是关键(记号, 位置, "联合体")) {
            // 46-e 联合体（2026-09-10 第四十九轮）：与结构体同入口——
            //   解析结构体声明 内部按关键字分派布局（偏移 0/大小 max）
            位置 = 解析结构体声明(记号, 位置, 池, 字段偏移表, 可见性标签);
            位置 = 拒绝声明体尾分号(记号, 位置, "联合体");   // 536：体后分号拒绝
            顶层可见性登记(池, 程序起点, 可见性标签);
        } 否则 如果 (是词(记号, 位置, "泛型")) {
            // 414-a（D42 甲案波 1）：泛型 类 声明（规范 06-十三·stdlib 实际形态）
            //   ——类型参数表解析+泛型参数名们 登记；泛型 函数=内显式诊断（后续轮）。
            //   是词 文本匹配（词法关键字表无「泛型」——IR签名 扫描器按文本匹配
            //   假设维持不动）。原先此形态由顶层兜底逐 token 跳过「侥幸」到达
            //   类 分支（类型参数零登记）——本分支为声明形态权威登记点。
            位置 = 解析泛型类声明(记号, 位置, 池, 字段偏移表, 可见性标签);
            位置 = 拒绝声明体尾分号(记号, 位置, "泛型类");   // 536：体后分号拒绝
            顶层可见性登记(池, 程序起点, 可见性标签);
        } 否则 如果 (是关键(记号, 位置, "类")) {
            // 第七十八轮（2026-09-12）：用户自定义类（类声明→类型登记→字段表→
            //   方法体检查全链；第一版范围/诚实边界见 解析类.cn 头部）
            位置 = 解析类声明(记号, 位置, 池, 字段偏移表, 可见性标签);
            位置 = 拒绝声明体尾分号(记号, 位置, "类");   // 536：体后分号拒绝
            顶层可见性登记(池, 程序起点, 可见性标签);
        } 否则 如果 (是关键(记号, 位置, "接口")) {
            // 413（2026-10-11）：接口 声明——接口 名 { 方法签名 }（解析接口声明：
            //   接口表登记+全局槽位分配；节点_接口声明 供语义收集期类型符号注册）。
            //   原无分支时落顶层兜底逐 token 跳过=接口声明静默吞（实现类随报
            //   「暂不支持接口实现」——413 缺口实录）。
            位置 = 解析接口声明(记号, 位置, 池);
            位置 = 拒绝声明体尾分号(记号, 位置, "接口");   // 536：体后分号拒绝
            顶层可见性登记(池, 程序起点, 可见性标签);
        } 否则 如果 (是词(记号, 位置, "常量")) {
            位置 = 解析常量声明(记号, 位置, 池, 字段偏移表, 可见性标签);
            顶层可见性登记(池, 程序起点, 可见性标签);
        } 否则 如果 (是词(记号, 位置, "静态")) {
            // ②c C：顶层静态声明（静态 向量<整64> 池——v2 组件遍布此形态，③ 前置）
            位置 = 解析静态声明(记号, 位置, 池, 字段偏移表);
            顶层可见性登记(池, 程序起点, 可见性标签);
        } 否则 如果 (是词(记号, 位置, "模块")) {
            // plans/018 P6b（规范 08-二）：模块 X; 顶层声明——登记挂载名
            //   （幂等，与 扫描导入 双点登记）+ 语法校验（模块 后须为标识符，
            //   语句以分号终结——plans/015 通道；非法位置[函数体内]由语句
            //   解析按未声明标识符诊断，此处只承担顶层形态）
            位置++;
            如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_标识符) {
                模块声明登记(当前ID(记号, 位置));
                位置++;
                如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == ID_分号) {
                    位置++;
                } 否则 {
                    语法错误数++;
                }
            } 否则 {
                语法错误数++;
            }
        } 否则 如果 (是关键(记号, 位置, "导入")) {
            // 1011（46·再导出）：公开: 标签下的 导入=再导出声明——登记转发表
            //   （语义层 成员索引 miss 时提升登记）。
            // 773（2026-10-15）根治：顶层导入语句**完整消费**（对齐宿主
            //   parseImportDecl 全形式·parser_oop.cpp：路径 / 作为 别名 /
            //   ::{项[作为 别名],...} / ::* 四形态 + ';' 终结）。原实现只消费
            //   「导入」关键字、残流 `路径::{项 作为 别名};` 交顶层兜底逐 token
            //   爬——569 裸全局 guard 对花括号项内重命名的 `项 作为` 误判为
            //   「类型 名」声明形态（162-a 收口后 作为=普通标识符，词法位与
            //   名位同）→ 解析静态声明 缺分号假错+语法错误中止（368_同包同名
            //   函数消歧边界/45_import_syntax 基线红实录·宿主同源绿=分叉缺陷）。
            //   完整消费后导入残流不再入 569 guard 视野=结构性根治。
            //   导入登记仍走 登记导入项们 预扫描（解析程序入口·权威登记点
            //   不变·本分支零池产出=登记制语义零变更，仅位置推进修正）。
            如果 (可见性标签 == 1 || 公开导入前缀1011 == 1) {
                扫描公开导入再导出(记号, 位置);
            }
            公开导入前缀1011 = 0;
            位置++;  // 消费「导入」
            // 路径：标识符 (:: 标识符)*（段贪婪收集·同 登记导入项们 口径）
            如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_标识符) {
                位置++;
                当 (位置 + 1 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == ID_双冒号 &&
                     当前类型(记号, 位置 + 1) == 令牌_标识符) {
                    位置 += 2;
                }
            }
            // 形式分支（按当前 token 判定·四形态全集对齐宿主 parseImportDecl）
            如果 (位置 < 记号.大小() && 是词(记号, 位置, "作为")) {
                // 整路径重命名：导入 路径 作为 别名
                位置++;
                如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_标识符) { 位置++; }
            } 否则 如果 (位置 + 1 < 记号.大小() &&
                       当前类型(记号, 位置) == 令牌_运算符 &&
                       当前ID(记号, 位置) == ID_双冒号 &&
                       当前类型(记号, 位置 + 1) == 令牌_运算符 &&
                       当前ID(记号, 位置 + 1) == ID_左花括号) {
                // 花括号导入：导入 路径 :: { 项1 [作为 别名], ... }
                位置 += 2;  // 消费 :: {
                当 (位置 < 记号.大小() && 当前类型(记号, 位置) != 令牌_文件结束 &&
                     !(当前类型(记号, 位置) == 令牌_运算符 &&
                       当前ID(记号, 位置) == ID_右花括号)) {
                    如果 (当前类型(记号, 位置) == 令牌_标识符) {
                        位置++;  // 项名
                        // 项内重命名：项 作为 别名（162-a：作为=标识符类别走 是词）
                        如果 (位置 < 记号.大小() && 是词(记号, 位置, "作为")) {
                            位置++;
                            如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_标识符) { 位置++; }
                        }
                    }
                    如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
                         当前ID(记号, 位置) == ID_逗号) { 位置++; 继续; }
                    中断;  // 右花括号或异常 token：退出（消费 } 交下方）
                }
                如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == ID_右花括号) { 位置++; }
            } 否则 如果 (位置 + 1 < 记号.大小() &&
                       当前类型(记号, 位置) == 令牌_运算符 &&
                       当前ID(记号, 位置) == ID_双冒号 &&
                       当前类型(记号, 位置 + 1) == 令牌_运算符 &&
                       当前ID(记号, 位置 + 1) == ID_星号) {
                // 通配符导入：导入 路径 :: *
                位置 += 2;
            }
            // plans/015：导入语句须 ';' 终结（缺失=吃分号 诊断+语法错误计数·
            // 对齐宿主 consumeSemicolon——真缺分号仍报，假错不再）
            位置 = 吃分号(记号, 位置);
        } 否则 如果 (是裸全局声明前瞻569(记号, 位置)) {
            // 569 甲案（2026-10-14 用户裁决·001 §5.2a）：顶层裸全局变量声明
            //   `整32 全局计数 = 5;` —— §5.1 文法「全局变量声明」实体形态。
            //   复用 解析静态声明（首行容忍无「静态」前缀·顶层路径 当前解析函数86=0
            //   零合成名改写）——语义登记/IR .data/.bss 发射/§747 第8条执法全链
            //   复用静态通道。此前该形态落顶层兜底逐 token 跳过=静默吞（569 侦察
            //   实证：rc=0 但 asm 无全局符号·初始化器静默丢失·违反「诊断即错误·
            //   杜绝静默」）。
            // 修饰=2=顶层裸全局标记（区别 顶层静态=0/函数内静态局部=1）·经
            //   顶层裸全局标记569 传入 解析静态声明 内设（865-a 同款标记机制·
            //   先改局部节点后入池）。下游消费面（569 全查证）：语义收集 修饰!=1
            //   入 全局静态名ID们（§747 第8条执法面正确复用）·语义检查中 664
            //   未初值拒仅 修饰==1（裸全局零初始化可读·不误伤）·IR 收集静态/
            //   生成不看修饰（发射复用零改动）·函数/方法节点 修饰%2 判不安全与
            //   静态声明节点无关。
            // ★位置契约（120 误拦实录）：本分支必须在 导入/模块 分支之后——
            //   guard 对「关键字 标识符」形态放行（内置类型关键字起点），若置于
            //   导入 前，`导入 常量库` 的 导入 词即被误判为「类型 名」形态
            //   （guard 关键字位不排除表——链序即排除表，位置=正确性契约）。
            设顶层裸全局标记569(真);
            位置 = 解析静态声明(记号, 位置, 池, 字段偏移表);
            设顶层裸全局标记569(假);
            顶层可见性登记(池, 程序起点, 可见性标签);
        } 否则 如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == ID_分号) {
            // 753 收口（03_function 实录）：函数定义后可选分号 `};`（C 风格·
            //   宿主宽容接受——03_function 函数.cn 末行即此形态）——顶层孤立
            //   分号原落兜底漂过计数（「真垃圾」判定窗口）误伤合法形态：显式
            //   消费（非垃圾·不计数）。
            位置++;
        } 否则 {
            // 753（167 采样五形态·「尾随非法字符/尾随残缺声明」）：无法识别的顶层
            //   记号原静默跳过（v2p rc=0 无诊断）。**不就地报错**——就地报错会打断
            //   「声明内部失衡吐回→语义层诊断」的既有合法路径（271_v2 冒号后置实录：
            //   语义层『未声明的类型: x』是对齐宿主的既有诊断，须保留）；改为**计数**，
            //   判定延到语义通过后的收尾（主.cn 收尾守卫）——语义层已拒绝的形态保持
            //   原诊断，语义全绿却仍有漂过=真垃圾（拒绝，不静默）。
            顶层兜底漂过数753++;
            位置++;
        }
    }
    // 753 总兜底：解析位置越界（声明内部静默接受 EOF 的上游残留）不复静默——
    //   任何「位置跑过 token 数组」都显式中止（防本批未覆盖的同类形态再静默）。
    如果 (位置 > 记号.大小()) {
        IO::打印到错误("[parse] 解析位置越界（" + 整数转字符串(位置) + " > " +
                       整数转字符串(记号.大小()) + "）——源码在声明中途结束\n");
        语法错误加一();
        位置 = 记号.大小();
    }
    // 070 波B（1022）：lambda 延后段补解析——在 节点_程序 追加**前**（收集
    //   契约=解析程序返回后池尾即 节点_程序·主.cn 收集文件快照 按池.大小()-1
    //   取索引）。合成函数节点因此落入程序声明区间→IR 主循环须跳过
    //   （是lambda合成索引·重复生成=符号重定义首版实录）。
    位置 = 解析lambda延后段们(记号, 位置, 池, 字段偏移表);
    池追加(池, 建节点(节点_程序, 0, 0, 整32(程序起点), 整32(池.大小())));
    返回 位置;
}

// 518（批丙·2026-10-13 用户裁决）：外部 函数 返回类型白名单判定——标量（整数族/
//   浮点，含 字符/布尔 整数族成员与 空类型 无值返回）/指针（尾 * 连缀后核心仍须
//   白名单）/字符串句柄放行；聚合（类/结构体）/引用（& 系）/数组（[N]）=假
//   （调用方声明位编译期拒绝——宿主 registerFunction 同款同文案=零分叉。
//   背景 110 实录：聚合返回曾双侧放行，宿主调用面 retbuf 不预插、类值当指针
//   判空解引用崩；Rust extern "C" 非 FFI-safe 边界同构。聚合 FFI 返回待 sret
//   跨语言约定立法后另行放行·001 §5.3 FFI 条文升级口）。
函数 外部函数返回类型合法518(字符串 类型文本) -> 布尔 {
    整64 长518 = 字符串长度(类型文本);
    整64 i518 = 0;
    // 引用（&）/数组（[）形态=白名单外（子串含即拒——引用别名/聚合连续存储面）
    当 (i518 < 长518) {
        如果 (字符串比较(字符串子串(类型文本, i518, 1), "&") ||
             字符串比较(字符串子串(类型文本, i518, 1), "[")) {
            返回 假;
        }
        i518++;
    }
    // 剥尾部指针后缀（连续 *）后按核心类型白名单判定（空类型*=void* 指针合法）
    整64 核尾518 = 长518;
    当 (核尾518 > 0 && 字符串比较(字符串子串(类型文本, 核尾518 - 1, 1), "*")) {
        核尾518--;
    }
    字符串 核518 = 字符串子串(类型文本, 0, 核尾518);
    返回 字符串比较(核518, "整8") || 字符串比较(核518, "整16") ||
          字符串比较(核518, "整32") || 字符串比较(核518, "整64") ||
          字符串比较(核518, "整128") || 字符串比较(核518, "正8") ||
          字符串比较(核518, "正16") || 字符串比较(核518, "正32") ||
          字符串比较(核518, "正64") || 字符串比较(核518, "正128") ||
          字符串比较(核518, "整数") || 字符串比较(核518, "浮32") ||
          字符串比较(核518, "浮64") || 字符串比较(核518, "小数") ||
          字符串比较(核518, "字符") || 字符串比较(核518, "布尔") ||
          字符串比较(核518, "字符串") || 字符串比较(核518, "空类型") ||
          字符串比较(核518, "指针");
}

// 536（诊断质量根治·双侧对齐）：顶层声明体尾随分号拒绝——001 §4.6 规则1/5
//   （「结构体/类/接口/枚举/联合体体后不加分号（`}` 即边界）」；规则4 裸分号
//   非法同旨）。原行为=顶层兜底「位置++」静默吞该分号——与宿主拒绝形成零分叉
//   违例（536 探针现场：结构体定义带 `};`（C++ 习惯）→ 宿主报错级联、v2
//   静默放行=一侧拒一侧放的分叉缺陷）。本函数报 stderr 诊断+语法错误计数
//   （主链中止通道与 缺分号 同款——主.cn 语法错误数>0 中止），消费分号防
//   再入兜底。宿主侧同款诊断（parser.cpp rejectBodyTrailingSemicolon）。
函数 拒绝声明体尾分号(向量<Token> 记号, 整64 位置, 字符串 类别) -> 整64 {
    如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
         当前ID(记号, 位置) == ID_分号) {
        IO::打印到错误("[parse] " + 类别 + "声明体以 '}' 自终结，其后不应有分号 ';'（行=" +
                        整数转字符串(当前行(记号, 位置)) + "）\n");
        语法错误加一();
        返回 位置 + 1;
    }
    返回 位置;
}

// 340-a（D38 批3b·363）：外部 函数 声明解析——外部+函数 已由调用方消费，本函数从
//   函数 名 起：函数 名(参数) -> 返回类型 ;（无体）。带体=语法错误（宿主「外部
//   函数 声明不能有函数体」措辞对齐·诊断行尾不写换行符以避反斜杠）+跳到体尾；
//   签名不登记（v2 单池合并·实现体由导入模块提供，登记即与实现重定义冲突）。
函数 解析外部函数声明(向量<Token> 记号, 整64 位置, 向量<节点> 池) -> 整64 {
    // 957（002·FFI 通道·用户裁决三件都修首件·规格书 5.3 对齐）：外部 函数
    //   声明=完整解析建**无体原型**（592-a 原型形态——语义签名登记/调用点
    //   解析/原型重复声明豁免〔362 同名同签名 C 语义〕全复用）+登记外部函数
    //   名集合（IR 决议纯名直发——链接符号=函数名本身无 mangling·C 库供给）
    如果 (当前类型(记号, 位置) != 令牌_标识符) {
        IO::打印到错误("[parse] 外部 函数 声明缺少函数名");
        语法错误加一();
        返回 位置;
    }
    整32 名IDf957 = 当前ID(记号, 位置);
    登记外部函数名957(整64(名IDf957));
    位置++;
    整64 参数起点957 = 池.大小();
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == ID_左圆括号) {
        位置++;
        如果 (!(当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == ID_右圆括号)) {
            当 (真) {
                位置 = 解析参数(记号, 位置, 池);
                如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == ID_逗号) { 位置++; 继续; }
                中断;
            }
        }
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == ID_右圆括号) { 位置++; }
        否则 {
            // 1031（外部函数参数表收口·同族延伸）：')' 缺失显式诊断（E2 实录——
            //   原实现静默漂走把 `外部 函数 辅(整32 甲 -> 整32;` 当合法声明放行）。
            参数表收口诊断(记号, 位置, "外部函数参数表");
        }
    }
    否则 {
        // 1031（参数表全缺形态·N5 实录）：外部 函数 声明缺参数表 '('——宿主
        //   「预期 '('，实际为 'X'」拒绝（原实现静默跳过参数段放行）。
        //   诊断=公共函数（三消费点共用）。
        参数表左括号缺失诊断(记号, 位置, "外部 函数");
    }
    整32 返回类型957 = 0;
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == ID_箭头) {
        位置++;
        如果 (当前类型(记号, 位置) == 令牌_标识符 || 当前类型(记号, 位置) == 令牌_关键字) {
            返回类型957 = 当前ID(记号, 位置);
            位置++;
            当 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == ID_星号) {
                返回类型957 = 整32(驻留(驻留文本(整64(返回类型957)) + "*"));
                位置++;
            }
            // 518（批丙）：引用/数组后缀连缀——`整64&`/`整32[3]` 完整入类型文本
            //   （此前 & 与 [N] 残留被顶层吞=声明面静默降级为按值返回），使下方
            //   白名单检查与宿主（类型文本含 &/[N]）同可达。
            当 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == ID_与号) {
                返回类型957 = 整32(驻留(驻留文本(整64(返回类型957)) + "&"));
                位置++;
            }
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == ID_左方括号) {
                整64 瞥517a = 位置 + 1;
                如果 (当前类型(记号, 瞥517a) == 令牌_整数字面量 &&
                     当前类型(记号, 瞥517a + 1) == 令牌_运算符 &&
                     当前ID(记号, 瞥517a + 1) == ID_右方括号) {
                    返回类型957 = 整32(驻留(驻留文本(整64(返回类型957)) + "[" +
                                        驻留文本(整64(当前ID(记号, 瞥517a))) + "]"));
                    位置 = 瞥517a + 2;
                }
            }
            // 518（批丙）声明位白名单检查——聚合/引用/数组返回编译期拒绝，
            //   诊断文案与宿主逐字一致（零分叉口径·810 负例双侧锁面）
            如果 (返回类型957 != 0 &&
                 !外部函数返回类型合法518(字符串复制(驻留文本(整64(返回类型957))))) {
                IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 外部 函数 返回类型 '" +
                             驻留文本(整64(返回类型957)) +
                             "' 不支持：仅限标量（整数族/浮点）/指针/字符串（聚合与引用返回待 sret 跨语言约定立法后放行）\n");
                语法错误加一();
            }
        }
    }
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == ID_左花括号) {
        // 957 补（363 负测）：外部 函数 声明不能有函数体（规格 5.3·旧实现
        //   判定随重写丢失·本处恢复——跳过体块消费后优雅拒绝）
        IO::打印到错误("[parse] 外部 函数 声明不能有函数体\n");
        语法错误加一();
        整64 深度体957 = 0;
        当 (位置 < 记号.大小()) {
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == ID_左花括号) { 深度体957++; }
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == ID_右花括号) {
                深度体957--;
                如果 (深度体957 == 0) { 位置++; 中断; }
            }
            位置++;
        }
        返回 位置;
    }
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == ID_分号) { 位置++; }
    节点 空块957 = 建节点(节点_块, 0, 0, 整32(池.大小()), 整32(池.大小()));
    池追加(池, 空块957);
    整32 空块索引957 = 整32(池.大小()) - 1;
    节点 原型957 = 建节点(节点_函数, 名IDf957, 整64(返回类型957), 整32(参数起点957), 空块索引957);
    池追加(池, 原型957);
    返回 位置;
}

函数 解析外部函数声明旧957(向量<Token> 记号, 整64 位置, 向量<节点> 池) -> 整64 {
    如果 (当前类型(记号, 位置) != 令牌_标识符) {
        IO::打印到错误("[parse] 外部 函数 声明缺少函数名");
        语法错误加一();
        返回 位置;
    }
    位置++;
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == ID_左圆括号) {
        整64 深度 = 1;
        位置++;
        当 (位置 < 记号.大小() && 深度 > 0) {
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == ID_左圆括号) { 深度++; }
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == ID_右圆括号) { 深度--; }
            位置++;
        }
    }
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == ID_箭头) {
        位置++;
        如果 (当前类型(记号, 位置) == 令牌_标识符 || 当前类型(记号, 位置) == 令牌_关键字) { 位置++; }
    }
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == ID_左花括号) {
        IO::打印到错误("[parse] 外部 函数 声明不能有函数体");
        语法错误加一();
        整64 深度体 = 0;
        当 (位置 < 记号.大小()) {
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == ID_左花括号) { 深度体++; }
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == ID_右花括号) {
                深度体--;
                如果 (深度体 == 0) { 位置++; 中断; }
            }
            位置++;
        }
        返回 位置;
    }
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == ID_分号) { 位置++; }
    返回 位置;
}
