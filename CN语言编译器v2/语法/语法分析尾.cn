// 语法分析尾（357 重构F2 自 语法分析.cn 纯机械搬移·函数体逐字保留·零逻辑变化）

导入 容器::向量;
导入 映射集合;
导入 词法;       // Token 结构（原 词法分析，阶段目录包名，2026-09-08）
导入 IR;         // 容器/结果 合成名判定 + 节点_*/键位移 常量（原 IR容器+IR常量 合并目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 IO;         // 349-a：解析诊断输出（打印到错误）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

函数 扫描导入(向量<Token> 记号) -> 空类型 {
    登记导入项们(记号);
    整64 位置 = 0;
    当 (位置 < 记号.大小()) {
        如果 (当前类型(记号, 位置) == 令牌_关键字 && 当前ID(记号, 位置) == 整32(驻留("导入"))) {
            位置++;
            如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_标识符) {
                模块登记(当前ID(记号, 位置));
                位置++;
            }
            如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == 整32(驻留("::"))) {
                位置++;
                如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留("{"))) {
                    // 导入 路径::{项}：跳到 } 之后
                    当 (位置 < 记号.大小() &&
                         !(当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("}")))) {
                        位置++;
                    }
                } 否则 {
                    // 导入 路径::符号 或 导入 路径::*：跳过符号/通配符
                    位置++;
                }
            } 否则 如果 (位置 < 记号.大小() && 是词(记号, 位置, "作为")) {
                // 导入 路径 作为 别名：跳过别名（P6b：作为 升格关键字，走 是关键）
                位置 += 2;
            }
            继续;
        }
        // plans/018 P6b：模块 X; 顶层声明——预解析登记挂载名（加载器在解析前
        //   得知子模块，父挂子自动加载强语义；权威校验在 解析程序）
        如果 (是词(记号, 位置, "模块")) {
            位置++;
            如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_标识符) {
                模块声明登记(当前ID(记号, 位置));
                位置++;
                如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留(";"))) {
                    位置++;
                }
            }
            继续;
        }
        位置++;
    }
}





// 解析常量声明（P7a，2026-09-01）：常量 名 = 表达式（类型推断，规范 5.2）。
//   节点字段：文本=名ID，子区间=初始化表达式（整数字面量 或 负号字面量——
//   负数经 解析表达式 一元前缀自然成 [字面量, 负号] 区间，IR 层折叠识别）。
//   显式类型形式（常量 整64 名 = 值）本轮不解析——v2 组件源码全部为推断式。
函数 解析常量声明(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表,
                  整64 是否公开) -> 整64 {
    如果 (是词(记号, 位置, "常量")) { 位置++; }
    整32 名ID = 当前ID(记号, 位置);
    位置++;
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("="))) { 位置++; }
    整64 值起点 = 池.大小();
    位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
    // plans/018 常量分桶：附加=公开位（顶层可见性标签）——IR 层 收集常量 候选
    //   登记与语义层可见性判定同源（附加位原 0 空闲，首用）
    池追加(池, 建节点(节点_常量声明, 名ID, 是否公开, 整32(值起点), 整32(池.大小())));
    返回 吃分号(记号, 位置);
}

// 解析完整程序：顶层声明序列（函数/结构体/常量/导入——导入 由 扫描导入 先行登记）
//   簇②根治·B1：入口 清空+重扫 导入项们（权威登记点——紧贴本文件解析，
//   防依赖文件的扫描/解析窗口抹掉本文件登记，见 登记导入项们 时序纪律注释）
// 418-a（D40 细分）：枚举声明解析——枚举 名 { 成员 [= 值] [, 成员... ] }
//   （C 风格·stdlib 核心 错误码 同款形态）。成员常量值=显式整数字面量或
//   默认前值+1（首个默认 0）；登记 枚举表（存在们+成员值们——语义层成员链
//   放行+IR 生成层常量折叠消费）。产出 节点_枚举 声明节点（文本=枚举名ID·
//   子区间=成员节点·顶层可见性登记复用）。成员值表键=枚举名ID*键位移+成员名ID
//   （驻留 ID 全局唯一→跨模块导入 天然一致）。
函数 解析枚举声明(向量<Token> 记号, 整64 位置, 向量<节点> 池, 整64 是否公开) -> 整64 {
    位置++;   // 消费 枚举
    如果 (当前类型(记号, 位置) != 令牌_标识符) {
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 枚举声明缺少名称\n");
        语法错误加一();
        返回 位置;
    }
    整32 枚举名ID = 当前ID(记号, 位置);
    位置++;
    如果 (!(当前类型(记号, 位置) == 令牌_运算符 &&
           当前ID(记号, 位置) == 整32(驻留("{")))) {
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 枚举 预期 '{'\n");
        语法错误加一();
        返回 位置;
    }
    位置++;
    登记枚举名(整64(枚举名ID));
    整64 成员起点 = 池.大小();
    整64 当前值 = 0;
    当 (真) {
        如果 (当前类型(记号, 位置) == 令牌_文件结束) {
            IO::打印到错误("[parse] 枚举体未闭合（缺 '}'}）\n");
            语法错误加一();
            返回 位置;
        }
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留("}"))) { 位置++; 中断; }
        如果 (当前类型(记号, 位置) != 令牌_标识符) {
            IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 枚举成员预期名称\n");
            语法错误加一();
            返回 位置;
        }
        整32 成员名ID = 当前ID(记号, 位置);
        位置++;
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留("="))) {
            位置++;
            如果 (当前类型(记号, 位置) != 令牌_整数字面量 &&
                  !(当前类型(记号, 位置) == 令牌_运算符 &&
                   当前ID(记号, 位置) == 整32(驻留("-")))) {
                IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 枚举成员值预期整数字面量\n");
                语法错误加一();
                返回 位置;
            }
            // 436-a（T66·规范 05 枚举负数）：可选一元负号前缀——`缺考 = -1` 形态
            //   （plans/001 §05「枚举（简单/赋值/负数）」）——负号经 0-值 取负入
            //   当前值（整64 中转·后续自动递增基于该值）·值域/畸形保底由下方诊断。
            整64 成员值 = 0;
            如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == 整32(驻留("-"))) {
                位置++;
                如果 (当前类型(记号, 位置) != 令牌_整数字面量) {
                    IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 枚举成员值预期整数字面量\n");
                    语法错误加一();
                    返回 位置;
                }
                成员值 = 0 - 数字文本转数值(字符串复制(驻留文本(整64(当前ID(记号, 位置)))));
            } 否则 {
                成员值 = 数字文本转数值(字符串复制(驻留文本(整64(当前ID(记号, 位置)))));
            }
            当前值 = 成员值;
            位置++;
        }
        登记枚举成员值(整64(枚举名ID), 整64(成员名ID), 当前值);
        池追加(池, 建节点(节点_枚举成员, 成员名ID, 当前值, 0, 0));
        当前值 = 当前值 + 1;
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留(","))) { 位置++; }
    }
    池追加(池, 建节点(节点_枚举, 枚举名ID, 0, 整32(成员起点), 整32(池.大小())));
    返回 位置;
}

函数 解析程序(向量<Token> 记号, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    清空导入项们();
    // 平铺向量随映射同窗口清空（权威登记点紧贴本文件解析——预扫描登记被
    //   抹除重扫，平铺与映射内容保持一致）
    清空导入项平铺();
    登记导入项们(记号);
    // plans/018 第 3 层前置：可见性标签（公开:=1/私有:=0，标签块语义——
    //   标签后直到下一标签的顶层声明同属；缺省=0 默认私有，规格 08 5.9.3）
    整64 可见性标签 = 0;
    整64 位置 = 0;
    整64 程序起点 = 池.大小();
    当 (位置 < 记号.大小()) {
        如果 (当前类型(记号, 位置) == 令牌_文件结束) { 中断; }
        如果 (是词(记号, 位置, "公开")) {
            // 公开: 标签（公开 + ':' 两记号；缺 ':' 按普通记号跳过不中止——
            //   既有行为兼容，标签语义只在合法形态生效）
            如果 (位置 + 1 < 记号.大小() && 当前类型(记号, 位置 + 1) == 令牌_运算符 &&
                 当前ID(记号, 位置 + 1) == 整32(驻留(":"))) {
                可见性标签 = 1;
                位置 += 2;
            } 否则 {
                位置++;
            }
        } 否则 如果 (是词(记号, 位置, "私有")) {
            如果 (位置 + 1 < 记号.大小() && 当前类型(记号, 位置 + 1) == 令牌_运算符 &&
                 当前ID(记号, 位置 + 1) == 整32(驻留(":"))) {
                可见性标签 = 0;
                位置 += 2;
            } 否则 {
                位置++;
            }
        } 否则 如果 (是关键(记号, 位置, "不安全") &&
                   位置 + 1 < 记号.大小() && 是关键(记号, 位置 + 1, "函数")) {
            // plans/019 阶段4 第二批：不安全 函数 修饰——v2 语法层放行（观察期
            //   v2 不查安全区边界，修饰零语义零 IR；自举树迁移后 v2 可解析自身）
            // 153-a（plans/023 §八 v2 挂点）：修饰**不再丢弃**——回填函数节点
            //   「修饰」字段（语义层据此维护「当前函数不安全」并豁免 9 类挂点）。
            位置++;
            位置 = 解析函数声明(记号, 位置, 池, 字段偏移表, 1);
            顶层可见性登记(池, 程序起点, 可见性标签);
        } 否则 如果 (是关键(记号, 位置, "函数")) {
            位置 = 解析函数声明(记号, 位置, 池, 字段偏移表, 0);
            顶层可见性登记(池, 程序起点, 可见性标签);
        } 否则 如果 (是词(记号, 位置, "外部")) {
            // 340-a（D38 批3b·363）：外部 函数 声明——原被顶层兜底分支静默吞
            //   （「外部」单跳后 函数 带体被当普通函数=该拒不拒不扩面修复）。
            //   外部+函数 连写=无体声明；带体=宿主措辞拒绝对齐。
            如果 (位置 + 1 < 记号.大小() && 是关键(记号, 位置 + 1, "函数")) {
                位置 = 解析外部函数声明(记号, 位置 + 2, 池);
            } 否则 {
                位置++;
            }
        } 否则 如果 (是关键(记号, 位置, "不安全") && 位置 + 2 < 记号.大小() &&
                   是词(记号, 位置 + 1, "可搬运") &&
                   (是关键(记号, 位置 + 2, "结构体") ||
                    是关键(记号, 位置 + 2, "联合体") ||
                    是关键(记号, 位置 + 2, "类"))) {
            // 217（027 波2a·001 §5.8a）：不安全 可搬运 结构体/联合体/类——
            //   便携豁免声明（对标 Rust unsafe impl Send·声明人自担责任）。
            //   「可搬运」为声明位上下文词非保留字（外部 函数 同款组合探测·
            //   关键字表零变更）；豁免键基登记 可搬运豁免键们。
            位置 += 2;  // 消费 不安全 + 可搬运
            整64 豁免名ID = 当前ID(记号, 位置 + 1);
            如果 (是关键(记号, 位置, "类")) {
                位置 = 解析类声明(记号, 位置, 池, 字段偏移表, 可见性标签);
            } 否则 {
                位置 = 解析结构体声明(记号, 位置, 池, 字段偏移表, 可见性标签);
            }
            顶层可见性登记(池, 程序起点, 可见性标签);
            结果<空类型, 整32> 加豁免217 = 可搬运豁免键们.追加(键基合成(取当前模块路径(), 豁免名ID));
            如果 (!加豁免217.正常) { 运行时错误(4); }
        } 否则 如果 (是关键(记号, 位置, "结构体")) {
            位置 = 解析结构体声明(记号, 位置, 池, 字段偏移表, 可见性标签);
            顶层可见性登记(池, 程序起点, 可见性标签);
        } 否则 如果 (是关键(记号, 位置, "枚举")) {
            // 418-a（D40 细分）：枚举声明——枚举 名 { 成员 [= 值] [, ...] }
            //   （C 风格·stdlib 核心 错误码 同款）。成员常量登记 枚举表（语义
            //   放行+IR 常量折叠）+节点_枚举 产出（顶层可见性登记复用）。
            位置 = 解析枚举声明(记号, 位置, 池, 可见性标签);
            顶层可见性登记(池, 程序起点, 可见性标签);
        } 否则 如果 (是关键(记号, 位置, "联合体")) {
            // 46-e 联合体（2026-09-10 第四十九轮）：与结构体同入口——
            //   解析结构体声明 内部按关键字分派布局（偏移 0/大小 max）
            位置 = 解析结构体声明(记号, 位置, 池, 字段偏移表, 可见性标签);
            顶层可见性登记(池, 程序起点, 可见性标签);
        } 否则 如果 (是词(记号, 位置, "泛型")) {
            // 414-a（D42 甲案波 1）：泛型 类 声明（规范 06-十三·stdlib 实际形态）
            //   ——类型参数表解析+泛型参数名们 登记；泛型 函数=内显式诊断（后续轮）。
            //   是词 文本匹配（词法关键字表无「泛型」——IR签名 扫描器按文本匹配
            //   假设维持不动）。原先此形态由顶层兜底逐 token 跳过「侥幸」到达
            //   类 分支（类型参数零登记）——本分支为声明形态权威登记点。
            位置 = 解析泛型类声明(记号, 位置, 池, 字段偏移表, 可见性标签);
            顶层可见性登记(池, 程序起点, 可见性标签);
        } 否则 如果 (是关键(记号, 位置, "类")) {
            // 第七十八轮（2026-09-12）：用户自定义类（类声明→类型登记→字段表→
            //   方法体检查全链；第一版范围/诚实边界见 解析类.cn 头部）
            位置 = 解析类声明(记号, 位置, 池, 字段偏移表, 可见性标签);
            顶层可见性登记(池, 程序起点, 可见性标签);
        } 否则 如果 (是词(记号, 位置, "常量")) {
            位置 = 解析常量声明(记号, 位置, 池, 字段偏移表, 可见性标签);
            顶层可见性登记(池, 程序起点, 可见性标签);
        } 否则 如果 (是词(记号, 位置, "静态")) {
            // ②c C：顶层静态声明（静态 向量<整64> 池——v2 组件遍布此形态，③ 前置）
            位置 = 解析静态声明(记号, 位置, 池, 字段偏移表);
            顶层可见性登记(池, 程序起点, 可见性标签);
        } 否则 如果 (是词(记号, 位置, "模块")) {
            // plans/018 P6b（规范 08-二）：模块 X; 顶层声明——登记挂载名
            //   （幂等，与 扫描导入 双点登记）+ 语法校验（模块 后须为标识符，
            //   语句以分号终结——plans/015 通道；非法位置[函数体内]由语句
            //   解析按未声明标识符诊断，此处只承担顶层形态）
            位置++;
            如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_标识符) {
                模块声明登记(当前ID(记号, 位置));
                位置++;
                如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留(";"))) {
                    位置++;
                } 否则 {
                    语法错误数++;
                }
            } 否则 {
                语法错误数++;
            }
        } 否则 如果 (是关键(记号, 位置, "导入")) {
            // 1011（46·再导出）：公开: 标签下的 导入=再导出声明——登记转发表
            //   （语义层 成员索引 miss 时提升登记）。位置推进维持顶层兜底漂过
            //   原状（本分支只读登记）。
            如果 (可见性标签 == 1) {
                扫描公开导入再导出(记号, 位置);
            }
            位置++;
        } 否则 {
            位置++;
        }
    }
    // 070 波B（1022）：lambda 延后段补解析——在 节点_程序 追加**前**（收集
    //   契约=解析程序返回后池尾即 节点_程序·主.cn 收集文件快照 按池.大小()-1
    //   取索引）。合成函数节点因此落入程序声明区间→IR 主循环须跳过
    //   （是lambda合成索引·重复生成=符号重定义首版实录）。
    位置 = 解析lambda延后段们(记号, 位置, 池, 字段偏移表);
    池追加(池, 建节点(节点_程序, 0, 0, 整32(程序起点), 整32(池.大小())));
    返回 位置;
}

// 340-a（D38 批3b·363）：外部 函数 声明解析——外部+函数 已由调用方消费，本函数从
//   函数 名 起：函数 名(参数) -> 返回类型 ;（无体）。带体=语法错误（宿主「外部
//   函数 声明不能有函数体」措辞对齐·诊断行尾不写换行符以避反斜杠）+跳到体尾；
//   签名不登记（v2 单池合并·实现体由导入模块提供，登记即与实现重定义冲突）。
函数 解析外部函数声明(向量<Token> 记号, 整64 位置, 向量<节点> 池) -> 整64 {
    // 957（002·FFI 通道·用户裁决三件都修首件·规格书 5.3 对齐）：外部 函数
    //   声明=完整解析建**无体原型**（592-a 原型形态——语义签名登记/调用点
    //   解析/原型重复声明豁免〔362 同名同签名 C 语义〕全复用）+登记外部函数
    //   名集合（IR 决议纯名直发——链接符号=函数名本身无 mangling·C 库供给）
    如果 (当前类型(记号, 位置) != 令牌_标识符) {
        IO::打印到错误("[parse] 外部 函数 声明缺少函数名");
        语法错误加一();
        返回 位置;
    }
    整32 名IDf957 = 当前ID(记号, 位置);
    登记外部函数名957(整64(名IDf957));
    位置++;
    整64 参数起点957 = 池.大小();
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("("))) {
        位置++;
        如果 (!(当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(")")))) {
            当 (真) {
                位置 = 解析参数(记号, 位置, 池);
                如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(","))) { 位置++; 继续; }
                中断;
            }
        }
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(")"))) { 位置++; }
    }
    整32 返回类型957 = 0;
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("->"))) {
        位置++;
        如果 (当前类型(记号, 位置) == 令牌_标识符 || 当前类型(记号, 位置) == 令牌_关键字) {
            返回类型957 = 当前ID(记号, 位置);
            位置++;
            当 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("*"))) {
                返回类型957 = 整32(驻留(驻留文本(整64(返回类型957)) + "*"));
                位置++;
            }
        }
    }
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("{"))) {
        // 957 补（363 负测）：外部 函数 声明不能有函数体（规格 5.3·旧实现
        //   判定随重写丢失·本处恢复——跳过体块消费后优雅拒绝）
        IO::打印到错误("[parse] 外部 函数 声明不能有函数体\n");
        语法错误加一();
        整64 深度体957 = 0;
        当 (位置 < 记号.大小()) {
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("{"))) { 深度体957++; }
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("}"))) {
                深度体957--;
                如果 (深度体957 == 0) { 位置++; 中断; }
            }
            位置++;
        }
        返回 位置;
    }
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(";"))) { 位置++; }
    节点 空块957 = 建节点(节点_块, 0, 0, 整32(池.大小()), 整32(池.大小()));
    池追加(池, 空块957);
    整32 空块索引957 = 整32(池.大小()) - 1;
    节点 原型957 = 建节点(节点_函数, 名IDf957, 整64(返回类型957), 整32(参数起点957), 空块索引957);
    池追加(池, 原型957);
    返回 位置;
}

函数 解析外部函数声明旧957(向量<Token> 记号, 整64 位置, 向量<节点> 池) -> 整64 {
    如果 (当前类型(记号, 位置) != 令牌_标识符) {
        IO::打印到错误("[parse] 外部 函数 声明缺少函数名");
        语法错误加一();
        返回 位置;
    }
    位置++;
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("("))) {
        整64 深度 = 1;
        位置++;
        当 (位置 < 记号.大小() && 深度 > 0) {
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("("))) { 深度++; }
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(")"))) { 深度--; }
            位置++;
        }
    }
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("->"))) {
        位置++;
        如果 (当前类型(记号, 位置) == 令牌_标识符 || 当前类型(记号, 位置) == 令牌_关键字) { 位置++; }
    }
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("{"))) {
        IO::打印到错误("[parse] 外部 函数 声明不能有函数体");
        语法错误加一();
        整64 深度体 = 0;
        当 (位置 < 记号.大小()) {
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("{"))) { 深度体++; }
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("}"))) {
                深度体--;
                如果 (深度体 == 0) { 位置++; 中断; }
            }
            位置++;
        }
        返回 位置;
    }
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(";"))) { 位置++; }
    返回 位置;
}
