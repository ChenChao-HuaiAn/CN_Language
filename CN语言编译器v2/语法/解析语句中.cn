// 解析语句中（357 重构F2 自 解析语句.cn 纯机械搬移·函数体逐字保留·零逻辑变化）

导入 容器::向量;
导入 映射集合;
导入 词法;       // Token 结构（原 导入 词法分析，目录包名）
导入 IR;         // 节点_*/键位移 常量（原 IR容器+IR常量 合并目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

函数 解析推断声明语句(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
        位置++;
        整32 推名ID = 当前ID(记号, 位置);
        // 865-a：同名普通局部声明 = 遮蔽静态（推断声明形态同款）
        如果 (当前在函数内86()) { 遮蔽局部静态名86(整64(推名ID)); }
        位置++;
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("="))) {
            位置++;
            整64 推值起点 = 池.大小();
            位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
            整64 推类型节点 = 池.大小();
            池追加(池, 建节点(节点_类型, 整32(驻留("")), 0, 0, 0));
            // 子终点=推类型节点（表达式末尾）——区间只含初值表达式；类型节点
            //   与声明节点本体不入子区间（对齐常量分支：建节点参数求值时点）
            池追加(池, 建节点(节点_变量声明, 推名ID, 整64(推类型节点), 整32(推值起点), 整32(推类型节点)));
        } 否则 {
            语法错误加一();
            IO::打印到错误("[parse] 推断声明必须初始化（变量 名 = 表达式）: " +
                           驻留文本(整64(推名ID)) + "\n");
        }
        返回 吃分号(记号, 位置);
}

// 201-a：赋值语句解析（构造字面量赋值位形态+普通右值两路；守卫=标识符 =）。
函数 解析赋值语句(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
        整32 左值ID = 静态名归一86(当前ID(记号, 位置));
        位置 += 2;
        // 构造字面量赋值位·标识符目标（第四十六轮观察项③，2026-09-09）：p = 点{...}——
        //   RHS 标识符为已登记结构体且后随 '{'，且目标为结构体变量（变量结构体表
        如果 (当前类型(记号, 位置) == 令牌_标识符 && 位置 + 1 < 记号.大小() &&
             当前类型(记号, 位置 + 1) == 令牌_运算符 &&
             当前ID(记号, 位置 + 1) == 整32(驻留("{"))) {
            整64 结构体键a = 查结构体类型(整64(当前ID(记号, 位置)));
            整64 目标键a = 查变量结构体键(整64(左值ID));
            如果 (结构体键a > 0 && 目标键a > 0) {
                整64 构造名ID = 当前ID(记号, 位置);
                整64 构造行 = 整64(记号.元素(位置).行);
                向量<整64> 空链名们 = 向量<整64>();
                向量<整64> 空链偏移们 = 向量<整64>();
                位置 = 解析构造字段赋值们(记号, 位置 + 1, 池, 字段偏移表, 左值ID,
                                      空链名们, 空链偏移们, 目标键a, 构造名ID, 构造行);
                返回 吃分号(记号, 位置);
            }
        }
        整64 右值起点 = 池.大小();
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        池追加(池, 建节点(节点_赋值, 左值ID, 0, 整32(右值起点), 整32(池.大小())));
        返回 吃分号(记号, 位置);
}

// 389-a（D43）：声明类型起始 token（标识符 或 别名关键字 整数/小数）——
//   词法关键字化后变量声明前瞻的类型位放行（宿主类型起始词集 parser.cpp:103 同构）。
// 657-a（024/D43 单一归属收口）：别名判定收敛至 是别名关键字（解析基础.cn）。
函数 是声明类型起始(向量<Token> 记号, 整64 位置) -> 布尔 {
    如果 (当前类型(记号, 位置) == 令牌_标识符) { 返回 真; }
    如果 (是别名关键字(记号, 位置)) { 返回 真; }
    // 408-a（D47 dump·临时）：断点定位——非标识符非别名的类型起始失败形态
    如果 (详细诊断开启()) {
        IO::打印到错误("[dump] 类型起始 假 当前类型=" + 整数转字符串(当前类型(记号, 位置)) +
                       " 当前ID=" + 整数转字符串(当前ID(记号, 位置)) +
                       " 驻留(整数)=" + 整数转字符串(整32(驻留("整数"))) + "\n");
    }
    返回 假;
}

// 201-a：变量声明六形态前瞻谓词（纯读零副作用）——普通/指针数组/数组/指针/引用/限定类型
//   + 泛型声明前瞻；原守卫条件逐字保留（首行「如果 ((」改「返回 ((」、尾行「)) {」改「));」）。
函数 是数组声明前瞻286(向量<Token> 记号, 整64 左括号位) -> 布尔 {
    整64 i = 左括号位;
    整64 深度 = 0;
    当 (i < 记号.大小()) {
        如果 (当前类型(记号, i) == 令牌_运算符 &&
             当前ID(记号, i) == 整32(驻留("["))) { 深度++; i++; 继续; }
        如果 (当前类型(记号, i) == 令牌_运算符 &&
             当前ID(记号, i) == 整32(驻留("]"))) {
            深度--;
            如果 (深度 == 0) {
                返回 (i + 1 < 记号.大小() &&
                      当前类型(记号, i + 1) == 令牌_标识符);
            }
            i++;
            继续;
        }
        i++;
    }
    返回 假;
}

//   仍须标识符=别名不作变量名·宿主对齐）。
函数 是变量声明前瞻(向量<Token> 记号, 整64 位置) -> 布尔 {
    返回 ((是声明类型起始(记号, 位置) && 位置 + 1 < 记号.大小() &&
         (// 818（064）：声明名位遇保留字（`正128 无 = …`）——纳入声明形态以走
          //   声明解析的名位诊断（原前瞻漏判 → 静默落表达式路径吞声明）
          (当前类型(记号, 位置 + 1) == 令牌_关键字 &&
           位置 + 2 < 记号.大小() &&
           当前类型(记号, 位置 + 2) == 令牌_运算符 &&
           当前ID(记号, 位置 + 2) == 整32(驻留("="))) ||
          (当前类型(记号, 位置 + 1) == 令牌_标识符) ||
          // 101-a（C1）：指针数组声明 类型*[长度] 变量名（宿主 canonical
          //   "整32*[3]" 同构；前瞻 '*' '[' 数字 ']' 标识符 五 token）
          (当前类型(记号, 位置 + 1) == 令牌_运算符 &&
           当前ID(记号, 位置 + 1) == 整32(驻留("*")) &&
           位置 + 5 < 记号.大小() &&
           当前类型(记号, 位置 + 2) == 令牌_运算符 &&
           当前ID(记号, 位置 + 2) == 整32(驻留("[")) &&
           当前类型(记号, 位置 + 3) == 令牌_整数字面量 &&
           当前类型(记号, 位置 + 4) == 令牌_运算符 &&
           当前ID(记号, 位置 + 4) == 整32(驻留("]")) &&
           当前类型(记号, 位置 + 5) == 令牌_标识符) ||
          // 94-a：数组类型声明 类型[长度] 变量名（规格书 3.5）——286（2026-10-08
          //   甲案）：长度位放宽为「'[' 起扫描到配对 ']'、']' 后须标识符」（原
          (当前类型(记号, 位置 + 1) == 令牌_运算符 &&
           当前ID(记号, 位置 + 1) == 整32(驻留("[")) &&
           是数组声明前瞻286(记号, 位置 + 1)) ||
          (当前类型(记号, 位置 + 1) == 令牌_运算符 &&
           当前ID(记号, 位置 + 1) == 整32(驻留("*")) &&
           位置 + 2 < 记号.大小() && 当前类型(记号, 位置 + 2) == 令牌_标识符) ||
          (当前类型(记号, 位置 + 1) == 令牌_运算符 &&
           当前ID(记号, 位置 + 1) == 整32(驻留("&")) &&
           位置 + 2 < 记号.大小() && 当前类型(记号, 位置 + 2) == 令牌_标识符 &&
           位置 + 3 < 记号.大小() &&
           当前类型(记号, 位置 + 3) == 令牌_运算符 &&
           当前ID(记号, 位置 + 3) == 整32(驻留("="))) ||
          (当前类型(记号, 位置 + 1) == 令牌_运算符 &&
           当前ID(记号, 位置 + 1) == 整32(驻留("::")) &&
           位置 + 3 < 记号.大小() && 当前类型(记号, 位置 + 2) == 令牌_标识符 &&
           当前类型(记号, 位置 + 3) == 令牌_标识符))) ||
         是泛型声明(记号, 位置) ||
         // T69（480-a 深度机）：函数指针声明形态 `返回类型(*名字)(参数类型列表)`
         //   （宿主 parser.cpp:650-669 parseTypePrefixVarDecl 同款前瞻）
         // 040 甲案：数组元素位 `类型(*名[N])(参数)` 同纳入（回调表）
         是函数指针声明(记号, 位置) ||
         是函数指针声明数组(记号, 位置));
}


// 表达式兜底语句（R3 拆分，2026-09-08 自 解析语句 机械搬移）：解析表达式后三分支——
//   复合赋值 L op= R（③ 第二波方案A：回退重析合成 二元+赋值）/ 成员/解引用左值
//   赋值（P6c 表达式后遇 =）/ 纯表达式语句。
函数 解析表达式兜底语句(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    整64 值起点 = 池.大小();
    整64 语句起点 = 位置;
    位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
    // ③ 第二波（方案A 裁决）：复合赋值 L op= R ≡ L = L op R（标识符/成员/解引用
    //   左值统一）。回退重析左值作右值首操作数（成员偏移解析期重标注，两份独立
    如果 (位置 > 语句起点 && 池.大小() > 值起点 &&
         当前类型(记号, 位置) == 令牌_运算符 && 是复合赋值符(当前ID(记号, 位置))) {
        整32 复合符 = 当前ID(记号, 位置);
        整64 右值起点 = 池.大小();
        位置 = 语句起点;
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);   // 左值副本（右值首操作数）
        位置++;                                        // 复合符（重析后再到此处）
        整64 右操作数起点 = 池.大小();
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        // 子终点=1：复合赋值合成标记（与手写 名 = 名 + "乙" 可区分——语义层据此
        //   做非数值操作数拒绝；&&/|| 预扫按 子终点!=0+op 名双条件识别，不受影响）
        池追加(池, 建节点(节点_二元运算, 复合二元符号(复合符),
                          右操作数起点, 整32(右值起点), 1));
        // 868-a（070·G-N·426 值差根因根治）：**纯标识符左值**（x op= R）→ 节点_赋值
        //   采用「文本=左值名ID」形态（与 解析赋值语句 普通赋值同款）——IR 层据此
        布尔 纯标识符87 = 假;
        整32 左名87 = 0;
        // 判据=**左值副本区间恰为单个标识符节点**（[右值起点, 右操作数起点)——副本
        //   由 语句起点 重析，与左值同文本同形态；成员/下标左值节点数 >1 天然排除）。
        如果 (右操作数起点 == 右值起点 + 1 &&
            池.元素(右值起点).类型 == 节点_标识符) {
            左名87 = 池.元素(右值起点).文本;
            纯标识符87 = 真;
        }
        如果 (纯标识符87) {
            池追加(池, 建节点(节点_赋值, 左名87, 0, 整32(右值起点), 整32(池.大小())));
        } 否则 {
            池追加(池, 建节点(节点_赋值, 0, 值起点, 整32(右值起点), 整32(池.大小())));
        }
        返回 吃分号(记号, 位置);
    }
    // 871-a（070·G-N·870 修复配套·869 重做）：**表达式左值的后缀自增/自减**
    //   （`q.x++`/`wq.内.y++`/`arr[i]++`）——纯标识符形态已由 解析自增自减语句
    如果 (位置 > 语句起点 && 池.大小() > 值起点 &&
         当前类型(记号, 位置) == 令牌_运算符 &&
         (当前ID(记号, 位置) == 整32(驻留("++")) || 当前ID(记号, 位置) == 整32(驻留("--")))) {
        整32 递符87 = 当前ID(记号, 位置);
        位置++;
        整64 右值起点87 = 池.大小();
        位置 = 语句起点;
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);   // 左值副本（右值首操作数）
        位置++;                                        // 递符（重析后再到此处）
        整64 常量起87 = 池.大小();
        池追加(池, 建节点(节点_整数字面量, 整32(驻留("1")), 0, 0, 0));
        整32 二符87 = (递符87 == 整32(驻留("++"))) ? 整32(驻留("+")) : 整32(驻留("-"));
        池追加(池, 建节点(节点_二元运算, 二符87, 常量起87, 整32(右值起点87), 1));
        池追加(池, 建节点(节点_赋值, 0, 值起点, 整32(右值起点87), 整32(池.大小())));
        返回 吃分号(记号, 位置);
    }
    // P6c：成员/解引用左值赋值（位置.x = 7 / *指针 = 10）：表达式后遇 =
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("="))) {
        // 构造字面量赋值位·成员目标（第四十六轮观察项③，2026-09-09）：r.右下 = 点{...}——
        //   单跳成员目标（左值链恰为 标识符+成员 两节点且成员非方法调用）且字段
        如果 (位置 + 2 < 记号.大小() &&
             当前类型(记号, 位置 + 1) == 令牌_标识符 &&
             当前类型(记号, 位置 + 2) == 令牌_运算符 &&
             当前ID(记号, 位置 + 2) == 整32(驻留("{")) &&
             池.大小() == 值起点 + 2 &&
             池.元素(值起点).类型 == 节点_标识符 &&
             池.元素(值起点 + 1).类型 == 节点_成员 &&
             整64(池.元素(值起点 + 1).附加) != 成员方法标记) {
            整32 对象名IDb = 池.元素(值起点).文本;
            节点 中间成员b = 池.元素(值起点 + 1);
            整64 结构体键b = 查结构体类型(整64(当前ID(记号, 位置 + 1)));
            整64 对象键b = 查变量结构体键(整64(对象名IDb));
            如果 (结构体键b > 0 && 对象键b > 0) {
                // 中间字段类型 -> 目标结构体键（字段类型表键基域，限定文本通吃）
                整64 字段类型IDb = 查字段类型ID(对象键b, 整64(中间成员b.文本));
                整64 目标键b = 查结构体类型(字段类型IDb);
                如果 (目标键b > 0) {
                    整64 构造名IDb = 当前ID(记号, 位置 + 1);
                    整64 构造行b = 整64(记号.元素(位置 + 1).行);
                    向量<整64> 链名们b = 向量<整64>();
                    向量<整64> 链偏移们b = 向量<整64>();
                    结果<空类型, 整32> 加名b = 链名们b.追加(整64(中间成员b.文本));
                    结果<空类型, 整32> 加偏b = 链偏移们b.追加(整64(中间成员b.附加));
                    如果 (!加名b.正常 || !加偏b.正常) { 运行时错误(4); }
                    位置 = 解析构造字段赋值们(记号, 位置 + 2, 池, 字段偏移表, 对象名IDb,
                                          链名们b, 链偏移们b, 目标键b, 构造名IDb, 构造行b);
                    返回 吃分号(记号, 位置);
                }
            }
        }
        位置++;
        整64 右值起点 = 池.大小();
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        池追加(池, 建节点(节点_赋值, 0, 整64(值起点), 整32(右值起点), 整32(池.大小())));
        返回 吃分号(记号, 位置);
    }
    池追加(池, 建节点(节点_表达式语句, 0, 0, 整32(值起点), 整32(池.大小())));
    返回 吃分号(记号, 位置);
}


// 解析代码块
函数 解析块(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("{"))) { 位置++; }
    整64 块起点 = 池.大小();
    整64 循环保护 = 0;
    当 (真) {
        如果 (当前类型(记号, 位置) == 令牌_文件结束) { 中断; }
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("}"))) { 位置++; 中断; }
        // 326-a（D38 批1·对齐宿主 295）：裸分号空语句拒绝——plans/015 后语句分号
        //   由 吃分号 消费，块内残留独立 `;` 即非法（宿主诊断「预期表达式」）。
        //   原实现静默跳过=295 负测在 v2p 编过（防线缺失）。
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(";"))) {
            IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                           ": 裸分号空语句——预期表达式\n");
            语法错误加一();
            位置++;
            继续;
        }
        整64 旧位置 = 位置;
        整32 语句前行 = 当前行(记号, 位置);   // 103-a（D2）：语句起始行
        整64 池前行 = 池.大小();
        如果 (详细诊断开启()) {
            IO::打印到错误("[trace] 解析块 pos=" + 整数转字符串(位置) + " 行=" +
                           整数转字符串(语句前行) + "\n");
        }
        位置 = 解析语句(记号, 位置, 池, 字段偏移表);
        // 103-a（D2）：语句根节点（最后入池者）回填行号——语义层 检查语句
        //   据此设诊断行（表诊断 输出「（行=N）」）。单点回填，其余节点行=0。
        如果 (池.大小() > 池前行) {
            节点 语句根103 = 池.元素(整32(池.大小()) - 1);
            语句根103.行 = 语句前行;
            结果<空类型, 整32> 设行103 = 池.设置(整32(池.大小()) - 1, 语句根103);
            如果 (!设行103.正常) { 运行时错误(4); }
        }
        循环保护++;
        如果 (位置 == 旧位置 || 循环保护 > 100000) {
            // 静默中断可见化（缺陷②分诊连带，B6/+= 语句级静默中断家族）：语句零
            //   消费=存在不可解析 token（如 *p += 1 的复合符、悬空运算符）——原静默
            IO::打印到错误("[parse] 语句解析中断于不可解析 token，块内后续语句被丢弃（位置=" +
                          整数转字符串(位置) + "）\n");
            中断;
        }
    }
    池追加(池, 建节点(节点_块, 0, 0, 整32(块起点), 整32(池.大小())));
    返回 位置;
}

// 如果语句解析（R3 拆分，2026-09-08 自 解析语句 机械搬移）：条件 + 真块 +
//   否则链（否则 如果 递归嵌套 / 否则 块）。节点字段：文本=条件起点，
//   子起点=条件终点，附加=真块索引，子终点=否则索引（0=无）。
函数 解析如果语句(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    位置++;
    整64 条件起点 = 池.大小();
    // 177（甲案·消歧条文）：**仅无括号条件**解析期间置 条件位抑制哨兵177（{ 归
    //   条件后语句块·宿主 suppressStructInit_ 同构·写经不安全助手 B10 收口）——
    //   带括号条件 () 已显式限界 { 无歧义，不置位（实参位字面量照常·存量 235 系）
    布尔 抑制旧值如果177 = 条件位抑制哨兵177;
    如果 (!(当前类型(记号, 位置) == 令牌_运算符 &&
            当前ID(记号, 位置) == 整32(驻留("(")))) {
        条件位抑制177开启();
    }
    位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
    条件位抑制177恢复(抑制旧值如果177);
    整64 条件终点 = 池.大小();
    位置 = 解析块(记号, 位置, 池, 字段偏移表);
    整64 真块索引 = 整64(池.大小()) - 1;   // 解析块 最后追加 块 节点
    // 否则链：否则 如果 ... / 否则 { ... }（P6b）
    整64 否则索引 = 0;
    如果 (是关键(记号, 位置, "否则")) {
        位置++;
        如果 (是关键(记号, 位置, "如果")) {
            // 否则 如果 -> 递归解析为 嵌套 如果语句，子区间含条件+块
            位置 = 带守卫解析语句(记号, 位置, 池, 字段偏移表);
            否则索引 = 整64(池.大小()) - 1;
        } 否则 {
            位置 = 解析块(记号, 位置, 池, 字段偏移表);
            否则索引 = 整64(池.大小()) - 1;
        }
    }
    // 节点字段（P6b）：文本=条件起点，子起点=条件终点，附加=真块索引，子终点=否则索引（0=无）
    池追加(池, 建节点(节点_如果语句, 整32(条件起点), 整64(真块索引), 整32(条件终点), 整32(否则索引)));
    返回 位置;
}

// 构造字面量赋值脱糖助手（第四十六轮观察项③，2026-09-09）：声明位/标识符赋值位/
//   成员赋值位单一助手同源（Rust 同构：构造字面量=目标 place 逐字段初始化，规范
函数 解析构造字段赋值们(向量<Token> 记号, 整64 位置, 向量<节点> 池,
                    映射<整64, 整64>& 字段偏移表, 整32 对象名ID,
                    向量<整64>& 链名们, 向量<整64>& 链偏移们,
                    整64 目标类型键, 整64 结构体名ID, 整64 构造行) -> 整64 {
    如果 (!(当前类型(记号, 位置) == 令牌_运算符 &&
           当前ID(记号, 位置) == 整32(驻留("{")))) { 返回 位置; }
    位置++;
    向量<整32> 已见字段们 = 向量<整32>();
    当 (真) {
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留("}"))) { 位置++; 中断; }
        如果 (当前类型(记号, 位置) == 令牌_文件结束) {
            语法错误加一();
            IO::打印到错误("[parse] 结构体构造字面量未闭合（行=" +
                           整数转字符串(构造行) + "）\n");
            中断;
        }
        整64 左值起点 = 池.大小();
        池追加(池, 建节点(节点_标识符, 静态名归一86(对象名ID), 0, 0, 0));
        整64 跳i = 0;
        当 (跳i < 链名们.大小()) {
            池追加(池, 建节点(节点_成员, 整32(链名们.元素(跳i)),
                              整64(链偏移们.元素(跳i)),
                              整32(整64(池.大小()) - 1), 0));
            跳i++;
        }
        整32 字段名f = 当前ID(记号, 位置);
        位置++;
        整64 偏移c = 0 - 1;
        如果 (目标类型键 > 0) {
            结果<整64, 整32> 偏移查c = 字段偏移表.获取(目标类型键 * 键位移 + 整64(字段名f));
            如果 (偏移查c.正常) { 偏移c = 偏移查c.值; }
        }
        池追加(池, 建节点(节点_成员, 字段名f, 偏移c, 整32(整64(池.大小()) - 1), 0));
        // 已见/重复登记（Rust E0062 同构：重复=编译错误）
        布尔 已见f = 假;
        整64 k = 0;
        当 (k < 已见字段们.大小()) {
            如果 (整64(已见字段们.元素(k)) == 整64(字段名f)) { 已见f = 真; }
            k++;
        }
        如果 (已见f) {
            语法错误加一();
            IO::打印到错误("[parse] 结构体初始化字段 '" + 驻留文本(整64(字段名f)) +
                           "' 重复（行=" + 整数转字符串(构造行) + "）\n");
        } 否则 {
            结果<空类型, 整32> 加见 = 已见字段们.追加(字段名f);
            如果 (!加见.正常) { 运行时错误(4); }
        }
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留("="))) { 位置++; }
        // 嵌套构造字面量（第四十六轮，186 踢出——宿主 emitStructInitTo 递归同构）：
        //   字段值本身是 类型{...} 且该类型=字段登记类型 → 以 链+本字段 递归下钻
        布尔 已赋值n = 假;
        如果 (当前类型(记号, 位置) == 令牌_标识符 && 位置 + 1 < 记号.大小() &&
             当前类型(记号, 位置 + 1) == 令牌_运算符 &&
             当前ID(记号, 位置 + 1) == 整32(驻留("{"))) {
            整64 字段键n = 查结构体类型(整64(当前ID(记号, 位置)));
            整64 应键n = 0;
            如果 (目标类型键 > 0) {
                应键n = 查结构体类型(查字段类型ID(目标类型键, 整64(字段名f)));
            }
            如果 (字段键n > 0 && 字段键n == 应键n) {
                整64 构造名IDn = 当前ID(记号, 位置);
                结果<空类型, 整32> 加名n = 链名们.追加(整64(字段名f));
                结果<空类型, 整32> 加偏n = 链偏移们.追加(偏移c);
                如果 (!加名n.正常 || !加偏n.正常) { 运行时错误(4); }
                位置 = 解析构造字段赋值们(记号, 位置 + 1, 池, 字段偏移表, 对象名ID,
                                      链名们, 链偏移们, 字段键n, 构造名IDn, 构造行);
                // 链状态恢复（186 残链根治，2026-09-09）：递归层以 链+[本字段]
                //   为前缀合成叶赋值，返回后必须弹出本字段两元素——否则后续
                结果<空类型, 整32> 删名n = 链名们.删除(链名们.大小() - 1);
                结果<空类型, 整32> 删偏n = 链偏移们.删除(链偏移们.大小() - 1);
                如果 (!删名n.正常 || !删偏n.正常) { 运行时错误(4); }
                如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留(","))) { 位置++; }
                已赋值n = 真;
            }
        }
        如果 (!已赋值n) {
            // 861-a（002 攻族 G-N）：数组类型字段的初始化列表 `{ e1, e2, ... }`——
            //   规范 03 §262 数组初始化列表的字段位形态（宿主同款）。脱糖为逐元素
            布尔 数组脱糖86 = 假;
            如果 (目标类型键 > 0 &&
                 当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == 整32(驻留("{"))) {
                整64 字段类型IDd86 = 查字段类型ID(目标类型键, 整64(字段名f));
                如果 (字段类型IDd86 > 0 &&
                    是数组类型文本(字符串复制(驻留文本(字段类型IDd86)))) {
                    数组脱糖86 = 真;
                }
            }
            如果 (数组脱糖86) {
                位置++;   // 吃 '{'
                整64 元素序86 = 0;
                当 (位置 < 记号.大小() &&
                      !(当前类型(记号, 位置) == 令牌_运算符 &&
                        当前ID(记号, 位置) == 整32(驻留("}")))) {
                    整64 下标左值起86 = 池.大小();
                    池追加(池, 建节点(节点_标识符, 静态名归一86(对象名ID), 0, 0, 0));
                    整64 跳j86 = 0;
                    当 (跳j86 < 链名们.大小()) {
                        池追加(池, 建节点(节点_成员, 整32(链名们.元素(跳j86)),
                                          整64(链偏移们.元素(跳j86)),
                                          整32(整64(池.大小()) - 1), 0));
                        跳j86++;
                    }
                    池追加(池, 建节点(节点_成员, 字段名f, 偏移c,
                                      整32(整64(池.大小()) - 1), 0));
                    整64 下标对象86 = 整64(池.大小()) - 1;   // 上一节点=本字段成员
                    池追加(池, 建节点(节点_整数字面量,
                                      整32(驻留(整数转字符串(元素序86))), 0, 0, 0));
                    池追加(池, 建节点(节点_下标, 0, 0, 整32(下标对象86),
                                      整32(池.大小())));
                    整64 右值起86 = 池.大小();
                    位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
                    池追加(池, 建节点(节点_赋值, 0, 整64(下标左值起86),
                                      整32(右值起86), 整32(池.大小())));
                    元素序86++;
                    如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                         当前ID(记号, 位置) == 整32(驻留(","))) {
                        位置++;
                    } 否则 { 中断; }
                }
                如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留("}"))) { 位置++; }
            } 否则 {
                整64 右值起点 = 池.大小();
                位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
                池追加(池, 建节点(节点_赋值, 0, 整64(左值起点), 整32(右值起点), 整32(池.大小())));
            }
            如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == 整32(驻留(","))) { 位置++; }
        }
    }
    // 穷举检查（Rust E0063 同构）：字段清单逐序比对，缺一即错
    整64 应有数 = 构造字段数(目标类型键);
    整64 序c = 0;
    当 (序c < 应有数) {
        整64 字段n = 构造字段名(目标类型键, 序c);
        布尔 找到f = 假;
        整64 k2 = 0;
        当 (k2 < 已见字段们.大小()) {
            如果 (整64(已见字段们.元素(k2)) == 字段n) { 找到f = 真; }
            k2++;
        }
        如果 (!找到f) {
            语法错误加一();
            IO::打印到错误("[parse] 结构体 '" + 驻留文本(结构体名ID) +
                           "' 初始化缺少字段 '" + 驻留文本(字段n) + "'（行=" +
                           整数转字符串(构造行) + "）\n");
        }
        序c++;
    }
    返回 位置;
}

// 变量声明语句解析（R3 拆分）：检测条件留 解析语句 主干（标识符 标识符 / 指针 /
//   引用带=前置消歧 / 限定类型 / 泛型六形态），本函数处理体：类型解析 + 结构体/
//   容器登记（P6e/P7b/第17枚）+ 初值表达式。
