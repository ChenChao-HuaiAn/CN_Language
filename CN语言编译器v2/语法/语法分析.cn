// CN 自举编译器 v2：结构化语法分析器（自举重建 P3，2026-08-25）
// 性能最优架构第二层：AST 用节点池（向量<节点>，arena 语义），节点间索引引用。
// 输入：P2 词法器 Token 数组；输出：节点池 AST。
// 规范依据：cn-language-spec 03/04/05。
导入 容器::向量;
导入 映射集合;
导入 词法;       // Token 结构（原 词法分析，阶段目录包名，2026-09-08）
导入 IR;         // 容器/结果 合成名判定 + 节点_*/键位移 常量（原 IR容器+IR常量 合并目录包名）
导入 IO;         // 349-a：解析诊断输出（打印到错误）

公开:


// P6h（2026-08-31）：多源文件支持——本文件 导入 语句登记的模块名列表。
//   加载器（主.cn）每解析完一个文件调用 取走导入模块们 消费并清空。
静态 向量<整32> 导入模块们;

// plans/018 P6b 工作流3 第 3 层前置（2026-09-07）：顶层声明可见性标签登记——
//   `公开:` / `私有:` 标签块语义（标签后直到下一标签的顶层声明同属该可见性；
//   无标签 = 默认私有，规格 08 5.9.3）。平铺向量 = 交替 [声明节点池索引, 1]。
//   文件作用域：解析程序 随 导入项们 同步取走（主.cn 每文件解析后快照拼接，
//   语义层 声明收集 据此设符号可见性——可见性强制的数据源）。
//   此前 公开:/私有: 记号被顶层循环 否则 分支静默跳过（13 组件头部的标签
//   能编译的原因）——语义从未消费；本表首次让标签产生语义。
//   平铺形态纪律：嵌套容器（向量<映射>/向量<向量>）构造非成熟路径
//   （lessons 含容器字段结构体同族）——跨组件快照传输一律标量平铺。
静态 向量<整64> 顶层公开平铺们;

// 164-a（A4·plans/023 §十二 方案A+D）：联合体设施（宿主语义层成员类型限定同构）——
//   ①联合体键基们：是联合 的 结构体键基集（语义层成员检查判定「哪些结构体是联合体」）；
//   ②联合体手动标注键们：成员「手动释放」标注（分桶键）——语义层豁免拥有型判定。
静态 向量<整64> 联合体键基们;
静态 向量<整64> 联合体手动标注键们;

// 164-a：键基是否联合体（语义分析 节点_结构体 分支调用）
函数 是联合体键基(整64 键基) -> 布尔 {
    整64 i = 0;
    当 (i < 联合体键基们.大小()) {
        如果 (联合体键基们.元素(i) == 键基) { 返回 真; }
        i++;
    }
    返回 假;
}

// 164-a：分桶键是否「手动释放」标注成员
函数 是手动释放成员(整64 分桶键) -> 布尔 {
    整64 i = 0;
    当 (i < 联合体手动标注键们.大小()) {
        如果 (联合体手动标注键们.元素(i) == 分桶键) { 返回 真; }
        i++;
    }
    返回 假;
}

// 顶层声明节点可见性登记（解析程序 声明分支后调用；仅声明类节点入表）
函数 顶层可见性登记(向量<节点> 池, 整64 程序起点, 整64 可见性标签) -> 空类型 {
    如果 (可见性标签 == 0) { 返回; }   // 私有/缺省不入表（只记公开）
    整64 尾 = 整64(池.大小()) - 1;
    如果 (尾 < 程序起点 || 尾 < 0) { 返回; }
    节点 声明节点 = 池.元素(整32(尾));
    如果 (声明节点.类型 == 节点_函数 || 声明节点.类型 == 节点_结构体 ||
         声明节点.类型 == 节点_常量声明 || 声明节点.类型 == 节点_静态声明 ||
         声明节点.类型 == 节点_类 || 声明节点.类型 == 节点_枚举) {
        结果<空类型, 整32> 加公 = 顶层公开平铺们.追加(尾);
        如果 (!加公.正常) { 运行时错误(4); }
        结果<空类型, 整32> 加标 = 顶层公开平铺们.追加(1);
        如果 (!加标.正常) { 运行时错误(4); }
    }
}

// 取走顶层公开平铺表（消费后清空；主.cn 每文件解析后快照拼接进总表，
//   交 语义分析多文件 构建公开映射——时序纪律同 取走导入模块们）
不安全 函数 取走顶层公开平铺() -> 向量<整64> {
    向量<整64> 平铺 = 顶层公开平铺们;
    顶层公开平铺们 = 向量<整64>();
    返回 平铺;
}



// 簇①根治·A2（2026-09-04）：节点_*/键位移 常量区整体下沉 IR常量.cn（跨组件
//   协议常量单一归属——IR容器 引用 语法分析 不可导=循环；原定义在本文件顶层，
//   冒烟 IR容器 入口 14 错）。常量值与逐项注释见 IR常量.cn「AST 节点类型」区。
// 第二十八轮（2026-09-07）：结构体 节点 布局定义一并下沉 IR常量.cn 同区——
//   IR容器 池遍历读 节点 字段（变量结构体表 布局登记源须在其导入链上；常量
//   可见而布局不可见=语义过、IR 层 64 错「成员字段偏移未知」——呈报①A 下沉模式）。




// 解析函数声明：函数 名(参数...) -> 返回类型 { 体 }
// 153-a：修饰 参数（0=普通；1=不安全——由 解析程序 顶层 dispatch 据前导关键字传入）
函数 解析函数声明(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表,
                   整32 修饰) -> 整64 {
    如果 (是关键(记号, 位置, "函数")) { 位置++; }
    整32 名ID = 当前ID(记号, 位置);
    位置++;
    // 349-a（T35 ①类根治）：运算符重载声明 `函数 运算符X(...)`——「运算符」关键字后
    //   紧随运算符记号，组合为函数名（宿主解析器同款）。原实现只取「运算符」为名、
    //   不消费记号 → 参数表解析从运算符记号开始失败 → 后续走进后缀解析遇 `->`
    //   触发硬错误 302（无诊断崩溃·探针 a4 单声明即崩／a3 普通方法名对照正常）。
    //   组合后本处显式诊断 + 语法错误加一 → 走既有「语法错误 N 个，中止编译」
    //   优雅拒绝通道（v2 暂不支持运算符重载·Rust 对照：解析成功 + 明确诊断·非 ICE）。
    如果 (当前类型(记号, 位置) == 令牌_运算符) {
        字符* 记号文本O = 当前文本(记号, 位置);
        如果 (字符串比较(记号文本O, "(") == 假) {
            名ID = 整32(驻留(驻留文本(整64(名ID)) + 记号文本O));
            位置++;
            IO::打印到错误("[parse] v2 暂不支持运算符重载声明（函数 " +
                           记号文本O + "）\n");
            语法错误加一();
        }
    }
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("("))) { 位置++; }
    整64 参数起点 = 池.大小();
    如果 (!(当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(")")))) {
        当 (真) {
            位置 = 解析参数(记号, 位置, 池);
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(","))) { 位置++; 继续; }
            中断;
        }
    }
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(")"))) { 位置++; }
    整32 返回类型ID = 0;
    // 返回类型箭头：词法 P6b 已合并为单 token "->"（兼容旧双 token 判断）
    //   P7b：泛型返回类型（如 -> 向量<整32>）经 解析类型文本 合成 $ 实例名
    //   2026-09-04 缺陷零容忍收口：返回类型引用后缀（-> 整64&，宿主 P3-18
    //   引用返回对齐）——解析类型文本 外层位不消费 &，此处显式并入类型名
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("->"))) {
        位置++;
        整64 类型位置 = 位置;
        字符串 返回类型名 = 解析类型文本(记号, &类型位置, 假);
        如果 (字符串长度(返回类型名) > 0) {
            位置 = 类型位置;
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("&"))) {
                返回类型名 = 返回类型名 + "&";
                位置++;
            }
            // 缺陷②（2026-09-10 第五十八轮 立案根治）：返回类型指针后缀
            //   （-> 整64*，宿主支持）——解析类型文本 外层位不消费 *，与 &
            //   并入同款显式并入类型名（修复前 [parse] 语句缺少分号）
            当 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("*"))) {
                返回类型名 = 返回类型名 + "*";
                位置++;
            }
            返回类型ID = 整32(驻留(返回类型名));
        } 否则 {
            返回类型ID = 当前ID(记号, 位置);
            位置++;
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("&"))) {
                位置++;
            }
            当 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("*"))) {
                返回类型ID = 整32(驻留(驻留文本(整64(返回类型ID)) + "*"));
                位置++;
            }
        }
    } 否则 如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("-")) && 位置 + 1 < 记号.大小() && 当前ID(记号, 位置 + 1) == 整32(驻留(">"))) {
        位置 += 2;
        返回类型ID = 当前ID(记号, 位置);
        位置++;
    }
    整64 块起点 = 池.大小();
    位置 = 解析块(记号, 位置, 池, 字段偏移表);
    整32 块索引 = 整32(池.大小()) - 1;
    节点 新函数 = 建节点(节点_函数, 名ID, 整64(返回类型ID), 整32(参数起点), 块索引);
    新函数.修饰 = 修饰;   // 153-a：修饰回填（语义层 检查函数 读取）
    池追加(池, 新函数);
    返回 位置;
}

// 解析结构体声明：结构体 名 { 类型 字段... } ｜ 联合体 名 { 类型 字段... }
// plans/018 类型分桶（2026-09-08）：是否公开 参数（解析程序 顶层可见性标签）——
//   布局登记公开位 + 常量/结构体声明节点附加位同源。全部布局表登记键升级键基
//   （键基合成(当前模块路径, 名ID)——主.cn 每文件解析前设值；分桶键恒在键基域，
//   跨模块同名结构体布局独立，探针实测修复前 主 4B 覆盖 甲 16B → sret ABI 错乱）。
// 46-e 联合体类型面（2026-09-10 第四十九轮，规范 02 复合类型；宿主 computeLayout
//   isUnion 同构）：联合体与结构体同构解析——字段偏移全 0、大小=最大字段大小
//   向上对齐（C 布局语义）；仍产 节点_结构体（语义登记/类型引用/成员访问/
//   整体赋值/实参传地址全链复用，零新节点零新 IR）。构造字段表不登记=构造
//   字面量穷举纪律豁免（C 单成员激活惯例，规范 05；字段数 miss=0 构造路径
//   自然不进入——与宿主 visitStructInitExpr 联合体豁免同语义）。
函数 解析结构体声明(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表,
                  整64 是否公开) -> 整64 {
    整64 是联合 = 0;
    如果 (是关键(记号, 位置, "结构体")) { 位置++; }
    否则 如果 (是关键(记号, 位置, "联合体")) { 是联合 = 1; 位置++; }
    整32 名ID = 当前ID(记号, 位置);
    位置++;
    // plans/018 类型分桶：本结构体的键基（布局表/字段分桶/容器字段/变量结构体表
    //   标记 全域统一——登记与查询同键基域）
    整64 结构体键基 = 键基合成(取当前模块路径(), 整64(名ID));
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("{"))) { 位置++; }
    整64 字段起点 = 池.大小();
    // ②b B1（2026-09-02）：字段按真实类型大小+自然对齐布局（对齐宿主 typeSizeOf——
    //   旧 8 字节平铺对 整32 字段错误）。结构体大小/对齐入静态表（元素步长/拷贝
    //   大小/结构体局部多槽/字段级析构注入 用）。
    整64 字段偏移 = 0;
    整64 最大对齐 = 1;
    整64 最大字段 = 0;
    整64 字段序 = 0;
    当 (真) {
        如果 (当前类型(记号, 位置) == 令牌_文件结束) { 中断; }
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("}"))) { 位置++; 中断; }
        整64 类型节点 = 池.大小();
        // 164-a（A4 方案D）：联合体成员「手动释放」前缀标注（上下文词——仅联合体
        //   成员起始位 + 后随类型起始（标识符/关键字）时识别；其余语境为普通标识符）
        整64 本成员手动 = 0;
        如果 (是联合 == 1 && 是词(记号, 位置, "手动释放") &&
             (当前类型(记号, 位置 + 1) == 令牌_标识符 ||
              当前类型(记号, 位置 + 1) == 令牌_关键字)) {
            本成员手动 = 1;
            位置++;
        }
        位置 = 解析类型(记号, 位置, 池);
        // 205-a（2026-09-15 第两百零五轮，D1 行数整改）：字段处理块提取为 解析结构体字段
        //   （守卫+登记全入族；位置回传；字段偏移/最大对齐/最大字段/字段序 引用输出）；
        //   资源字段类别判定链提取为 解析资源字段类别（纯判定·传 类型节点值 零改写）。
        位置 = 解析结构体字段(记号, 位置, 池, 字段偏移表, 整64(名ID), 结构体键基, 是联合, 类型节点,
                          本成员手动, 字段偏移, 最大对齐, 最大字段, 字段序);
        // plans/015（2026-09-04）：字段间分号宽松消费——全库迁移后结构体字段带
        //   分号，原循环不消费 ';' 会零消费死循环（127 用例 v2p 编译卡死实测）；
        //   声明体成员分隔保持宽松语义（不强制不诊断，与宿主 match 同款）
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(";"))) { 位置++; }
    }
    // 布局收口：结构体=尾部对齐到 最大对齐（自然对齐，对齐宿主 typeSizeOf）；
    //   联合体=最大字段大小向上对齐 最大对齐（C 布局，宿主 computeLayout 同构）
    如果 (是联合 == 1) {
        // 164-a：联合体键基登记（语义层成员类型限定用）
        结果<空类型, 整32> 加联合 = 联合体键基们.追加(结构体键基);
        如果 (!加联合.正常) { 运行时错误(4); }
        整64 尾余u = 最大字段 % 最大对齐;
        如果 (尾余u != 0) { 最大字段 = 最大字段 + (最大对齐 - 尾余u); }
        登记结构体布局(整64(名ID), 最大字段, 最大对齐, 是否公开);
    } 否则 {
        整64 尾余 = 字段偏移 % 最大对齐;
        如果 (尾余 != 0) { 字段偏移 = 字段偏移 + (最大对齐 - 尾余); }
        登记结构体布局(整64(名ID), 字段偏移, 最大对齐, 是否公开);
    }
    // P6e：登记结构体名标记（变量结构体表：键基ID -> 1），供变量声明/参数
    //   识别"类型是结构体"（查表命中即结构体类型，登记 变量名ID -> 键基ID）；
    //   plans/018 键基域（查询经 查结构体类型 三级解析）
    登记变量结构体(结构体键基, 1);
    池追加(池, 建节点(节点_结构体, 名ID, 是否公开, 整32(字段起点), 整32(池.大小())));
    返回 位置;
}

// 205-a：族② 结构体字段处理（守卫=字段名标识符；大小对齐/偏移分桶/手动释放标注/
//   字段类型与资源字段登记/构造字段表/布局累加——资源类别判定调 族①；位置回传；
//   字段偏移/最大对齐/最大字段/字段序 引用输出）。
函数 解析结构体字段(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表,
                  整64 结构体名ID, 整64 结构体键基, 整64 是联合, 整64 类型节点, 整64 本成员手动, 整64& 字段偏移,
                  整64& 最大对齐, 整64& 最大字段, 整64& 字段序) -> 整64 {
        如果 (当前类型(记号, 位置) == 令牌_标识符) {
            整64 字段大小 = 8;
            整64 字段对齐 = 8;
            节点 类型节点值 = 池.元素(整32(类型节点));
            类型大小与对齐(驻留文本(整64(类型节点值.文本)), &字段大小, &字段对齐);
            // T3（311-a=306-b 波次2 v2 侧·2026-09-17）：字段类型为「未登记结构体」
            //   时收集引用对（收尾 检查未登记引用 全量判定）——递归环（直接/间接）
            //   与「先声明后使用」违规唯一同源捕获；原行为=静默 8 字节兜底（无穷
            //   大小类型错值面）。标量/指针/容器/数组 不入收集（合法类型面）。
            整64 字段类型名 = 整64(类型节点值.文本);
            字符串 字段类型判定文本 = 字符串复制(驻留文本(字段类型名));
            // 排除清单=非结构体的合法类型全集：标量族/字符串（拥有型堆句柄·
            //   非标量）/用户类（引用语义·对齐宿主 T3 类豁免）/指针/容器/数组。
            //   指针字段 `甲*` 的类型节点=基名+附加=指针层（仅 字符*/指针数组
            //   并入合成名）——按 附加!=0 排除（指针/引用层均非值字段递归面）。
            如果 (类型节点值.附加 == 0 &&
                 !是标量类型文本(字段类型判定文本) &&
                 !字符串比较(字段类型判定文本, "字符串") &&
                 !是用户类(字段类型判定文本) &&
                 !是指针类型文本(字段类型判定文本) &&
                 !是容器类(字段类型判定文本) && !是数组类型文本(字段类型判定文本)) {
                如果 (查结构体大小(字段类型名) == 0) {
                    收集未登记引用(结构体名ID, 字段类型名);
                }
            }
            // 联合体：所有字段偏移恒 0（不推进不对齐——C 布局；字段偏移表/
            //   登记字段偏移 拿到的即 0，成员访问天然零偏移）
            如果 (是联合 == 0) {
                整64 余 = 字段偏移 % 字段对齐;
                如果 (余 != 0) { 字段偏移 = 字段偏移 + (字段对齐 - 余); }
            }
            // P6e：字段偏移按结构体分桶——键 = 键基ID*键位移+字段名ID，
            //   根治扁平 字段名->偏移 单映射的同名字段串偏移（点.x 与 矩形.x）；
            //   plans/018 键基域（跨模块同名结构体字段偏移独立）
            整64 分桶键 = 结构体键基 * 键位移 + 整64(当前ID(记号, 位置));
            结果<空类型, 整32> 加表 = 字段偏移表.设置(分桶键, 字段偏移);
            如果 (!加表.正常) { 运行时错误(4); }
            // 164-a：手动释放 标注登记（语义层成员类型限定豁免）
            如果 (本成员手动 == 1) {
                结果<空类型, 整32> 加手动 = 联合体手动标注键们.追加(分桶键);
                如果 (!加手动.正常) { 运行时错误(4); }
            }
            // B4 预置：字段类型登记（资源字段析构注入用；表在 IR容器——避免导入环）
            登记字段类型(分桶键, 整64(类型节点值.文本));
            // ②c B：容器字段登记（指针槽模型——RAII 级联析构/字段读 LoadPtr->this/
            //   方法对象类型推导 用；四元组：结构体键基/字段名/字段容器类型/偏移）
            字符串 字段类型文本 = 字符串复制(驻留文本(整64(类型节点值.文本)));
            // 79-a（2026-09-12 第七十九轮）：资源字段表扩容——容器字段（对象指针槽
            //   模型，DeleteObject）之外纳入**字符串字段**（拥有型串句柄，free+清槽）
            //   与含资源字段的嵌套结构体（递归释放）。联合体字段偏移恒 0（同槽多型
            //   激活）不登记（Conditional 释放不可判——宁漏勿错，诚实边界）。
            // 84-c：类别判定——容器(1) / 字符串(0)。
            //   注：**嵌套含资源字段结构体（类别 2）的登记经实测回退**——`资源字段数`
            //   被多处消费（释放分派「否则=容器路径」/局部登记判定「资源字段数-串字段数」），
            //   纳入嵌套结构体后引发回归（E2E 190 等缺 `类型$~类型` 符号）；嵌套结构体
            //   字段的串释放面登记为下一轮专项（诚实边界：泄漏方向，宁漏勿错）。
            整64 资源类别f = 解析资源字段类别(字段类型文本, 类型节点值);
            如果 (是联合 == 0 && 资源类别f >= 0) {
                登记资源字段(结构体键基, 整64(当前ID(记号, 位置)), 整64(类型节点值.文本),
                             字段偏移, 资源类别f == 1, 资源类别f);
            }
            // ②b B5：字段偏移分桶登记（IR 层链式成员 池.元素(i).字段 偏移收口用——
            //   语法层 解析后缀链 对调用对象只能扁平回退，同名字段跨结构体必错）
            登记字段偏移(分桶键, 字段偏移);
            // 构造字面量穷举检查表（2026-09-09，键基域：键基*键位移+序 -> 字段名）
            //   联合体不登记=构造字面量豁免（C 单成员激活惯例，规范 05——
            //   字段数 miss=0 构造路径自然不进入；宿主 visitStructInitExpr 同语义）
            如果 (是联合 == 0) {
                登记构造字段(结构体键基, 字段序, 整64(当前ID(记号, 位置)));
            }
            字段序++;
            如果 (字段对齐 > 最大对齐) { 最大对齐 = 字段对齐; }
            如果 (字段大小 > 最大字段) { 最大字段 = 字段大小; }
            如果 (是联合 == 0) { 字段偏移 = 字段偏移 + 字段大小; }
            池追加(池, 建节点(节点_参数, 当前ID(记号, 位置), 整64(类型节点), 0, 0));
            位置++;
        }
    返回 位置;
}

// 205-a：族① 资源字段类别判定（79-a 扩容+84-c 类别：容器(1)/字符串(0)/99-a 字符串
//   数组(0)/100-a 数组元素含资源结构体(2)/84-e 嵌套结构体(2)；-1=非资源；
//   纯判定零副作用——类型节点值 原样传入零改写）。
函数 解析资源字段类别(字符串 字段类型文本, 节点 类型节点值) -> 整64 {
            整64 资源类别f = 0 - 1;
            如果 (是容器类(字段类型文本)) {
                资源类别f = 1;
            } 否则 如果 (字符串比较(字段类型文本, "字符串")) {
                资源类别f = 0;
            } 否则 如果 (是数组类型文本(字段类型文本) &&
                        字符串比较(数组元素文本(字段类型文本), "字符串")) {
                // 99-a（C11, 2026-09-13 第九十九轮）：**字符串数组字段**（
                //    `字符串[3] 名`）——与字符串同类（类别 0；释放点按类型文本
                //    分派逐元素）；97-a 字段数组读写 × 98-a 数组元素释放的合龙
                资源类别f = 0;
            } 否则 如果 (是数组类型文本(字段类型文本) &&
                        查结构体类型(驻留(数组元素文本(字段类型文本))) != 0 &&
                        资源字段数(查结构体类型(
                            驻留(数组元素文本(字段类型文本)))) > 0) {
                // 100-a（C12, 2026-09-13 第一百轮）：**数组元素=含资源字段结构体**
                //   （`行[2] 两行`，行 含字符串字段）——类别 2（嵌套结构体递归；
                //   释放点按类型文本分派逐元素递归其字段）。依赖先声明后使用
                //   （资源字段数 登记于元素结构体声明时）。
                资源类别f = 2;
            } 否则 如果 (查结构体类型(整64(类型节点值.文本)) != 0) {
                // 84-e：嵌套含资源字段结构体（类别 2）——释放递归/拷贝深拷 的分派依据；
                //   84-c 曾因「资源字段数 消费点未梳理」回退，本轮已逐点核对（生成声明
                //   局部登记判定 / 释放三处递归 / 可顺序释放判定）后重新收口。
                资源类别f = 2;
            }
    返回 资源类别f;
}



// plans/018 P6b：模块 声明挂载清单（模块 X; 的 X 名 ID，去重）——
//   扫描导入（预解析）与 解析程序（权威）双点登记；主.cn 加载器消费，
//   据此递归加载子模块（父挂子自动加载强语义，规范 08-二）
静态 向量<整32> 模块声明们;

// 登记模块声明名（去重幂等）
函数 模块声明登记(整32 名ID) -> 空类型 {
    整64 i = 0;
    当 (i < 模块声明们.大小()) {
        如果 (模块声明们.元素(i) == 名ID) { 返回; }
        i++;
    }
    结果<空类型, 整32> 加 = 模块声明们.追加(名ID);
    如果 (!加.正常) { 运行时错误(4); }
}

// 取走模块声明清单（消费后清空；主.cn 加载器在 扫描导入 后调用）
不安全 函数 取走模块声明们() -> 向量<整32> {
    向量<整32> 列表 = 模块声明们;
    模块声明们 = 向量<整32>();
    返回 列表;
}




// 登记导入模块名（去重；扫描导入 与 解析程序 顶层 均调用，幂等）
函数 模块登记(整32 模块名ID) -> 空类型 {
    整64 i = 0;
    当 (i < 导入模块们.大小()) {
        如果 (导入模块们.元素(i) == 模块名ID) { 返回; }
        i++;
    }
    结果<空类型, 整32> 加 = 导入模块们.追加(模块名ID);
    如果 (!加.正常) { 运行时错误(4); }
}

// 取走本文件导入模块列表（消费后清空；主.cn 每解析完一个文件调用，
//   据此递归加载模块文件——依赖模块须先解析，结构体偏移推导才正确）
不安全 函数 取走导入模块们() -> 向量<整32> {
    向量<整32> 模块列表 = 导入模块们;
    导入模块们 = 向量<整32>();
    返回 模块列表;
}

// 簇②根治·B1：登记导入项们（项名 -> 限定名；路径::项 / ::{项列表} / 项 作为 别名
//   三形态；通配 * 不登记——见 导入项们 边界注释）。不清空（调用方负责）。
//   时序纪律：登记必须紧贴本文件 解析程序——加载器「依赖先解析」会穿插其他文件
//   的扫描+解析，若在 扫描导入 清空+登记，本文件项会被依赖文件的登记窗口抹掉
//   （IR签名 登记 打开文件 → 词法分析 递归清空 → 回到 IR签名 解析时已丢——
//   实测 4 错残留即此）。故 解析程序 入口 清空+重扫 为权威登记点。
函数 登记导入项们(向量<Token> 记号) -> 空类型 {
    整64 位置 = 0;
    当 (位置 < 记号.大小()) {
        如果 (当前类型(记号, 位置) == 令牌_关键字 && 当前ID(记号, 位置) == 整32(驻留("导入"))) {
            位置++;
            如果 (!(位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_标识符)) { 位置++; 继续; }
            // 显式保存路径首段（模块名）——限定名构造一律用它，不按位置偏移
            //   反查（花括号形态 位置-2 会取到 :: 而非模块名——E2E 143 首跑
            //   「::::文件存在」6 错实证）
            字符串 模块名 = 字符串复制(当前文本(记号, 位置));
            位置++;
            如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == 整32(驻留("::"))) {
                位置++;
                如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留("{"))) {
                    // 导入 路径::{项, 项}：逐项登记（限定名=模块名+::+项名）
                    位置++;
                    当 (位置 < 记号.大小() &&
                         !(当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("}")))) {
                        如果 (当前类型(记号, 位置) == 令牌_标识符) {
                            字符串 限定名 = 模块名 + "::" + 当前文本(记号, 位置);
                            导入项登记(整64(当前ID(记号, 位置)), 驻留(限定名));
                            位置++;
                            // 项 作为 别名：别名也登记同限定名（P6b：作为 升格
                            //   关键字，判定走 是关键——原标识符类型判定失配）
                            如果 (位置 + 1 < 记号.大小() && 是词(记号, 位置, "作为")) {
                                位置++;
                                如果 (当前类型(记号, 位置) == 令牌_标识符) {
                                    导入项登记(整64(当前ID(记号, 位置)), 驻留(限定名));
                                    位置++;
                                }
                            }
                            继续;
                        }
                        位置++;
                    }
                } 否则 {
                    // 导入 路径::符号 或 导入 路径::*：符号登记（通配跳过）
                    如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_标识符) {
                        字符串 限定名 = 模块名 + "::" + 当前文本(记号, 位置);
                        导入项登记(整64(当前ID(记号, 位置)), 驻留(限定名));
                        位置++;
                        // 符号 作为 别名（P6b：作为 升格关键字，走 是关键）
                        如果 (位置 + 1 < 记号.大小() && 是词(记号, 位置, "作为")) {
                            位置++;
                            如果 (当前类型(记号, 位置) == 令牌_标识符) {
                                导入项登记(整64(当前ID(记号, 位置)), 驻留(限定名));
                                位置++;
                            }
                        }
                    } 否则 {
                        位置++;
                    }
                }
            }
            继续;
        }
        位置++;
    }
}

// P6h：轻量预扫描 Token 流中的 导入 语句（登记模块名，供加载器在解析前
//   得知依赖）。规范（08 模块系统）：导入 路径 [作为 标识符] / 导入 路径::{项}
//   / 导入 路径::*——路径首段为模块名（容器/文件/词法分析…），std 模块跳过加载。
//   簇②根治·B1：项登记在此顺带执行（幂等），但**权威登记点在 解析程序 入口**
//   （清空+重扫）——见 登记导入项们 时序纪律注释。
函数 扫描导入(向量<Token> 记号) -> 空类型 {
    登记导入项们(记号);
    整64 位置 = 0;
    当 (位置 < 记号.大小()) {
        如果 (当前类型(记号, 位置) == 令牌_关键字 && 当前ID(记号, 位置) == 整32(驻留("导入"))) {
            位置++;
            如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_标识符) {
                模块登记(当前ID(记号, 位置));
                位置++;
            }
            如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == 整32(驻留("::"))) {
                位置++;
                如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留("{"))) {
                    // 导入 路径::{项}：跳到 } 之后
                    当 (位置 < 记号.大小() &&
                         !(当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("}")))) {
                        位置++;
                    }
                } 否则 {
                    // 导入 路径::符号 或 导入 路径::*：跳过符号/通配符
                    位置++;
                }
            } 否则 如果 (位置 < 记号.大小() && 是词(记号, 位置, "作为")) {
                // 导入 路径 作为 别名：跳过别名（P6b：作为 升格关键字，走 是关键）
                位置 += 2;
            }
            继续;
        }
        // plans/018 P6b：模块 X; 顶层声明——预解析登记挂载名（加载器在解析前
        //   得知子模块，父挂子自动加载强语义；权威校验在 解析程序）
        如果 (是词(记号, 位置, "模块")) {
            位置++;
            如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_标识符) {
                模块声明登记(当前ID(记号, 位置));
                位置++;
                如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留(";"))) {
                    位置++;
                }
            }
            继续;
        }
        位置++;
    }
}





// 解析常量声明（P7a，2026-09-01）：常量 名 = 表达式（类型推断，规范 5.2）。
//   节点字段：文本=名ID，子区间=初始化表达式（整数字面量 或 负号字面量——
//   负数经 解析表达式 一元前缀自然成 [字面量, 负号] 区间，IR 层折叠识别）。
//   显式类型形式（常量 整64 名 = 值）本轮不解析——v2 组件源码全部为推断式。
函数 解析常量声明(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表,
                  整64 是否公开) -> 整64 {
    如果 (是词(记号, 位置, "常量")) { 位置++; }
    整32 名ID = 当前ID(记号, 位置);
    位置++;
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("="))) { 位置++; }
    整64 值起点 = 池.大小();
    位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
    // plans/018 常量分桶：附加=公开位（顶层可见性标签）——IR 层 收集常量 候选
    //   登记与语义层可见性判定同源（附加位原 0 空闲，首用）
    池追加(池, 建节点(节点_常量声明, 名ID, 是否公开, 整32(值起点), 整32(池.大小())));
    返回 吃分号(记号, 位置);
}

// 解析静态声明（②c C，2026-09-02，规范 03-一）：静态 类型 名 [= 表达式]。
//   容器静态裸声明（E2E 121 形状——入口 NewObject+构造）；标量静态初始值
//   IR 层折叠直存 .data。容器/结构体静态在此登记 变量容器表/变量结构体表
//   （跨文件保留——成员/方法解析与局部变量同路）。
函数 解析静态声明(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    如果 (是词(记号, 位置, "静态")) { 位置++; }
    整64 类型节点 = 池.大小();
    位置 = 解析类型(记号, 位置, 池);
    整32 名ID = 当前ID(记号, 位置);
    位置++;
    节点 类型节点值 = 池.元素(类型节点);
    字符串 类型文本 = 字符串复制(驻留文本(整64(类型节点值.文本)));
    // 容器静态登记 变量容器表（方法调用对象类型解析：池.追加 ——跨函数可见）
    如果 (是容器类(类型文本) || 是结果类型(类型文本)) {
        登记变量容器(整64(名ID), 整64(类型节点值.文本));
    } 否则 {
        // 结构体静态登记 变量结构体表（值/指针/引用形态——第17枚根治同参数位：
        //   静态结构体指针 .字段 偏移标注同需分桶表）。plans/018 类型分桶：
        //   登记值=键基（查结构体类型 三级解析——限定/跨模块类型支持）
        如果 (类型节点值.附加 <= 256) {
            整64 结构体键s = 查结构体类型(整64(类型节点值.文本));
            如果 (结构体键s != 0) {
                登记变量结构体(整64(名ID), 结构体键s);
            }
        }
    }
    整64 值起点 = 池.大小();
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("="))) {
        位置++;
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
    }
    池追加(池, 建节点(节点_静态声明, 名ID, 整64(类型节点), 整32(值起点), 整32(池.大小())));
    返回 吃分号(记号, 位置);
}

// 解析完整程序：顶层声明序列（函数/结构体/常量/导入——导入 由 扫描导入 先行登记）
//   簇②根治·B1：入口 清空+重扫 导入项们（权威登记点——紧贴本文件解析，
//   防依赖文件的扫描/解析窗口抹掉本文件登记，见 登记导入项们 时序纪律注释）
// 418-a（D40 细分）：枚举声明解析——枚举 名 { 成员 [= 值] [, 成员... ] }
//   （C 风格·stdlib 核心 错误码 同款形态）。成员常量值=显式整数字面量或
//   默认前值+1（首个默认 0）；登记 枚举表（存在们+成员值们——语义层成员链
//   放行+IR 生成层常量折叠消费）。产出 节点_枚举 声明节点（文本=枚举名ID·
//   子区间=成员节点·顶层可见性登记复用）。成员值表键=枚举名ID*键位移+成员名ID
//   （驻留 ID 全局唯一→跨模块导入 天然一致）。
函数 解析枚举声明(向量<Token> 记号, 整64 位置, 向量<节点> 池, 整64 是否公开) -> 整64 {
    位置++;   // 消费 枚举
    如果 (当前类型(记号, 位置) != 令牌_标识符) {
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 枚举声明缺少名称\n");
        语法错误加一();
        返回 位置;
    }
    整32 枚举名ID = 当前ID(记号, 位置);
    位置++;
    如果 (!(当前类型(记号, 位置) == 令牌_运算符 &&
           当前ID(记号, 位置) == 整32(驻留("{")))) {
        IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 枚举 预期 '{'\n");
        语法错误加一();
        返回 位置;
    }
    位置++;
    登记枚举名(整64(枚举名ID));
    整64 成员起点 = 池.大小();
    整64 当前值 = 0;
    当 (真) {
        如果 (当前类型(记号, 位置) == 令牌_文件结束) {
            IO::打印到错误("[parse] 枚举体未闭合（缺 '}'}）\n");
            语法错误加一();
            返回 位置;
        }
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留("}"))) { 位置++; 中断; }
        如果 (当前类型(记号, 位置) != 令牌_标识符) {
            IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 枚举成员预期名称\n");
            语法错误加一();
            返回 位置;
        }
        整32 成员名ID = 当前ID(记号, 位置);
        位置++;
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留("="))) {
            位置++;
            如果 (当前类型(记号, 位置) != 令牌_整数字面量 &&
                  !(当前类型(记号, 位置) == 令牌_运算符 &&
                   当前ID(记号, 位置) == 整32(驻留("-")))) {
                IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 枚举成员值预期整数字面量\n");
                语法错误加一();
                返回 位置;
            }
            // 436-a（T66·规范 05 枚举负数）：可选一元负号前缀——`缺考 = -1` 形态
            //   （plans/001 §05「枚举（简单/赋值/负数）」）——负号经 0-值 取负入
            //   当前值（整64 中转·后续自动递增基于该值）·值域/畸形保底由下方诊断。
            整64 成员值 = 0;
            如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == 整32(驻留("-"))) {
                位置++;
                如果 (当前类型(记号, 位置) != 令牌_整数字面量) {
                    IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) + ": 枚举成员值预期整数字面量\n");
                    语法错误加一();
                    返回 位置;
                }
                成员值 = 0 - 数字文本转数值(字符串复制(驻留文本(整64(当前ID(记号, 位置)))));
            } 否则 {
                成员值 = 数字文本转数值(字符串复制(驻留文本(整64(当前ID(记号, 位置)))));
            }
            当前值 = 成员值;
            位置++;
        }
        登记枚举成员值(整64(枚举名ID), 整64(成员名ID), 当前值);
        池追加(池, 建节点(节点_枚举成员, 成员名ID, 当前值, 0, 0));
        当前值 = 当前值 + 1;
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留(","))) { 位置++; }
    }
    池追加(池, 建节点(节点_枚举, 枚举名ID, 0, 整32(成员起点), 整32(池.大小())));
    返回 位置;
}

函数 解析程序(向量<Token> 记号, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    清空导入项们();
    // 平铺向量随映射同窗口清空（权威登记点紧贴本文件解析——预扫描登记被
    //   抹除重扫，平铺与映射内容保持一致）
    清空导入项平铺();
    登记导入项们(记号);
    // plans/018 第 3 层前置：可见性标签（公开:=1/私有:=0，标签块语义——
    //   标签后直到下一标签的顶层声明同属；缺省=0 默认私有，规格 08 5.9.3）
    整64 可见性标签 = 0;
    整64 位置 = 0;
    整64 程序起点 = 池.大小();
    当 (位置 < 记号.大小()) {
        如果 (当前类型(记号, 位置) == 令牌_文件结束) { 中断; }
        如果 (是词(记号, 位置, "公开")) {
            // 公开: 标签（公开 + ':' 两记号；缺 ':' 按普通记号跳过不中止——
            //   既有行为兼容，标签语义只在合法形态生效）
            如果 (位置 + 1 < 记号.大小() && 当前类型(记号, 位置 + 1) == 令牌_运算符 &&
                 当前ID(记号, 位置 + 1) == 整32(驻留(":"))) {
                可见性标签 = 1;
                位置 += 2;
            } 否则 {
                位置++;
            }
        } 否则 如果 (是词(记号, 位置, "私有")) {
            如果 (位置 + 1 < 记号.大小() && 当前类型(记号, 位置 + 1) == 令牌_运算符 &&
                 当前ID(记号, 位置 + 1) == 整32(驻留(":"))) {
                可见性标签 = 0;
                位置 += 2;
            } 否则 {
                位置++;
            }
        } 否则 如果 (是关键(记号, 位置, "不安全") &&
                   位置 + 1 < 记号.大小() && 是关键(记号, 位置 + 1, "函数")) {
            // plans/019 阶段4 第二批：不安全 函数 修饰——v2 语法层放行（观察期
            //   v2 不查安全区边界，修饰零语义零 IR；自举树迁移后 v2 可解析自身）
            // 153-a（plans/023 §八 v2 挂点）：修饰**不再丢弃**——回填函数节点
            //   「修饰」字段（语义层据此维护「当前函数不安全」并豁免 9 类挂点）。
            位置++;
            位置 = 解析函数声明(记号, 位置, 池, 字段偏移表, 1);
            顶层可见性登记(池, 程序起点, 可见性标签);
        } 否则 如果 (是关键(记号, 位置, "函数")) {
            位置 = 解析函数声明(记号, 位置, 池, 字段偏移表, 0);
            顶层可见性登记(池, 程序起点, 可见性标签);
        } 否则 如果 (是词(记号, 位置, "外部")) {
            // 340-a（D38 批3b·363）：外部 函数 声明——原被顶层兜底分支静默吞
            //   （「外部」单跳后 函数 带体被当普通函数=该拒不拒不扩面修复）。
            //   外部+函数 连写=无体声明；带体=宿主措辞拒绝对齐。
            如果 (位置 + 1 < 记号.大小() && 是关键(记号, 位置 + 1, "函数")) {
                位置 = 解析外部函数声明(记号, 位置 + 2, 池);
            } 否则 {
                位置++;
            }
        } 否则 如果 (是关键(记号, 位置, "结构体")) {
            位置 = 解析结构体声明(记号, 位置, 池, 字段偏移表, 可见性标签);
            顶层可见性登记(池, 程序起点, 可见性标签);
        } 否则 如果 (是关键(记号, 位置, "枚举")) {
            // 418-a（D40 细分）：枚举声明——枚举 名 { 成员 [= 值] [, ...] }
            //   （C 风格·stdlib 核心 错误码 同款）。成员常量登记 枚举表（语义
            //   放行+IR 常量折叠）+节点_枚举 产出（顶层可见性登记复用）。
            位置 = 解析枚举声明(记号, 位置, 池, 可见性标签);
            顶层可见性登记(池, 程序起点, 可见性标签);
        } 否则 如果 (是关键(记号, 位置, "联合体")) {
            // 46-e 联合体（2026-09-10 第四十九轮）：与结构体同入口——
            //   解析结构体声明 内部按关键字分派布局（偏移 0/大小 max）
            位置 = 解析结构体声明(记号, 位置, 池, 字段偏移表, 可见性标签);
            顶层可见性登记(池, 程序起点, 可见性标签);
        } 否则 如果 (是词(记号, 位置, "泛型")) {
            // 414-a（D42 甲案波 1）：泛型 类 声明（规范 06-十三·stdlib 实际形态）
            //   ——类型参数表解析+泛型参数名们 登记；泛型 函数=内显式诊断（后续轮）。
            //   是词 文本匹配（词法关键字表无「泛型」——IR签名 扫描器按文本匹配
            //   假设维持不动）。原先此形态由顶层兜底逐 token 跳过「侥幸」到达
            //   类 分支（类型参数零登记）——本分支为声明形态权威登记点。
            位置 = 解析泛型类声明(记号, 位置, 池, 字段偏移表, 可见性标签);
            顶层可见性登记(池, 程序起点, 可见性标签);
        } 否则 如果 (是关键(记号, 位置, "类")) {
            // 第七十八轮（2026-09-12）：用户自定义类（类声明→类型登记→字段表→
            //   方法体检查全链；第一版范围/诚实边界见 解析类.cn 头部）
            位置 = 解析类声明(记号, 位置, 池, 字段偏移表, 可见性标签);
            顶层可见性登记(池, 程序起点, 可见性标签);
        } 否则 如果 (是词(记号, 位置, "常量")) {
            位置 = 解析常量声明(记号, 位置, 池, 字段偏移表, 可见性标签);
            顶层可见性登记(池, 程序起点, 可见性标签);
        } 否则 如果 (是词(记号, 位置, "静态")) {
            // ②c C：顶层静态声明（静态 向量<整64> 池——v2 组件遍布此形态，③ 前置）
            位置 = 解析静态声明(记号, 位置, 池, 字段偏移表);
            顶层可见性登记(池, 程序起点, 可见性标签);
        } 否则 如果 (是词(记号, 位置, "模块")) {
            // plans/018 P6b（规范 08-二）：模块 X; 顶层声明——登记挂载名
            //   （幂等，与 扫描导入 双点登记）+ 语法校验（模块 后须为标识符，
            //   语句以分号终结——plans/015 通道；非法位置[函数体内]由语句
            //   解析按未声明标识符诊断，此处只承担顶层形态）
            位置++;
            如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_标识符) {
                模块声明登记(当前ID(记号, 位置));
                位置++;
                如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留(";"))) {
                    位置++;
                } 否则 {
                    语法错误数++;
                }
            } 否则 {
                语法错误数++;
            }
        } 否则 {
            位置++;
        }
    }
    池追加(池, 建节点(节点_程序, 0, 0, 整32(程序起点), 整32(池.大小())));
    返回 位置;
}

// 340-a（D38 批3b·363）：外部 函数 声明解析——外部+函数 已由调用方消费，本函数从
//   函数 名 起：函数 名(参数) -> 返回类型 ;（无体）。带体=语法错误（宿主「外部
//   函数 声明不能有函数体」措辞对齐·诊断行尾不写换行符以避反斜杠）+跳到体尾；
//   签名不登记（v2 单池合并·实现体由导入模块提供，登记即与实现重定义冲突）。
函数 解析外部函数声明(向量<Token> 记号, 整64 位置, 向量<节点> 池) -> 整64 {
    如果 (当前类型(记号, 位置) != 令牌_标识符) {
        IO::打印到错误("[parse] 外部 函数 声明缺少函数名");
        语法错误加一();
        返回 位置;
    }
    位置++;
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("("))) {
        整64 深度 = 1;
        位置++;
        当 (位置 < 记号.大小() && 深度 > 0) {
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("("))) { 深度++; }
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(")"))) { 深度--; }
            位置++;
        }
    }
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("->"))) {
        位置++;
        如果 (当前类型(记号, 位置) == 令牌_标识符 || 当前类型(记号, 位置) == 令牌_关键字) { 位置++; }
    }
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("{"))) {
        IO::打印到错误("[parse] 外部 函数 声明不能有函数体");
        语法错误加一();
        整64 深度体 = 0;
        当 (位置 < 记号.大小()) {
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("{"))) { 深度体++; }
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("}"))) {
                深度体--;
                如果 (深度体 == 0) { 位置++; 中断; }
            }
            位置++;
        }
        返回 位置;
    }
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(";"))) { 位置++; }
    返回 位置;
}
