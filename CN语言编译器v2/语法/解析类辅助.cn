// CN 自举编译器 v2 · 类声明解析辅助（任务193 拆分·537-a 机械搬移先例）
// 职责：解析类.cn 超 1000 行冻结线（AGENTS 单一职责红线·先拆再加）——
//   运算符重载名辅助（414）与 类静态字段声明初始化器解析（468）两族
//   自 解析类.cn 逐字迁入（零行为变更·调用方经包内合并全局池解析同链）。
导入 容器::向量;
导入 映射集合;
导入 词法;     // Token/当前ID 等
导入 IR;       // 节点_*/驻留族
导入 协议常量;   // 335：协议常量独立包
导入 IO;       // 349-a：解析诊断输出（打印到错误）

公开:

// 414（#414 运算符重载 v2 补齐·宿主 parser_oop.cpp isOverloadableOperator 同构）：
//   可重载运算符符号集合（001 §4.6·304 收窄后）：X ∈ + - * / % == != < > <= >=
//   && || ! & | ^ ~ << >>（[] / () 已收窄移出·-> 已随成员访问统一废除）。
函数 是可重载运算符文本(字符* 文本O) -> 布尔 {
    返回 字符串比较(文本O, "+") || 字符串比较(文本O, "-") ||
          字符串比较(文本O, "*") || 字符串比较(文本O, "/") ||
          字符串比较(文本O, "%") || 字符串比较(文本O, "==") ||
          字符串比较(文本O, "!=") || 字符串比较(文本O, "<") ||
          字符串比较(文本O, ">") || 字符串比较(文本O, "<=") ||
          字符串比较(文本O, ">=") || 字符串比较(文本O, "&&") ||
          字符串比较(文本O, "||") || 字符串比较(文本O, "!") ||
          字符串比较(文本O, "&") || 字符串比较(文本O, "|") ||
          字符串比较(文本O, "^") || 字符串比较(文本O, "~") ||
          字符串比较(文本O, "<<") || 字符串比较(文本O, ">>");
}

// 414：类体运算符重载名组合（放行）与 304 收窄拒绝——宿主 parseFunctionMember
//   运算符分支同构。前提：调用方已消费 函数/不安全 函数 前缀与方法名。
//   方法名「运算符」（上下文关键字·非保留字 001 §4.6）后随可重载运算符记号 →
//   名ID 改写为组合名「运算符X」并消费该记号（放行——语义收集登记/决议/IR
//   降级链随后接手，宿主 349-a 注释「组合为函数名」同口径）；[ / ( → 304 显式
//   拒绝（不消费·语法错误中止通道）；其余记号不消费（「运算符」按普通方法名，
//   宿主 checkText else 分支同款）。返回新位置；名ID 经指针写回。
//   不安全：名ID 指针下标写面（解析类字段 同款惯例）。
不安全 函数 组合运算符重载名或拒绝(向量<Token> 记号, 整64 位置, 整32* 名IDp) -> 整64 {
    如果 (!(当前类型(记号, 位置) == 令牌_运算符)) { 返回 位置; }
    // 名须恰为「运算符」——其余方法名后随运算符记号=非法源码（参数表解析自然
    //   报错），不劫持（宿主 checkText("运算符") 同口径）
    如果 (!字符串比较(驻留文本(整64(名IDp[0])), "运算符")) { 返回 位置; }
    字符* 记号文本O = 当前文本(记号, 位置);
    // 304 收窄（2026-10-08 用户批「照办」·001 §4.6）：[] / () 移出可重载集合——
    //   显式拒绝（宿主同文案·functor 生态位由 lambda+函数指针覆盖）
    如果 (字符串比较(记号文本O, "(")) {
        IO::打印到错误("[parse] 运算符 \"()\" 不支持重载（001 §4.6 收窄——请改用 lambda 或函数指针）\n");
        语法错误加一();
        返回 位置;
    }
    如果 (字符串比较(记号文本O, "[")) {
        IO::打印到错误("[parse] 运算符 \"[]\" 不支持重载（001 §4.6 收窄——请改用 lambda 或函数指针）\n");
        语法错误加一();
        返回 位置;
    }
    如果 (!是可重载运算符文本(记号文本O)) { 返回 位置; }
    名IDp[0] = 整32(驻留(驻留文本(整64(名IDp[0])) + 记号文本O));
    返回 位置 + 1;
}

// ==================== 468：类静态字段声明初始化器（加载期生效·甲案） ====================
// 001 §静态成员：声明初值字面量直存 .data 静态槽，程序加载即生效——与顶层静态
//   变量（收集静态 整数文本直存通道）、函数内静态局部三形态一致。解析期折叠
//   支持面与宿主语义注册面 foldClassStaticInit 同口径：整数字面量（十进制/
//   0x/0b/0o·可带一元负号）与布尔字面量（真/假）；浮点（含 . / e 指数）/
//   字符/字符串/标识符/多 token 表达式=语法期拒绝（语法错误加一 中止通道）——
//   加载期直存不承载，指路构造函数/主入口赋值（运行期读写链全形态生效）。
//   64 位内整数=规范化十进制文本（发射层 `dq 文本` 全后端合法）；整128/正128
//   槽=符号×原样文本（发射层 解析128位初值文本 解析双 quad·T46 同款）。

// 整数字面量文本 → 整64（十进制/0x/0b/0o 前缀·L/l/U/u 后缀自断〔810 同规〕；
//   溢出=低 64 位环绕）。成功=真；非法文本/空=假。
//   728v（583 扫描②）：累加=474 高/低 32 位分治（协议常量 位模式累加474/
//   位模式合成474）·负号=位模式取负474——19 位十进制文本（2^63＝MIN 数值
//   部分）末步中间值超 INT64_MAX 原触发安全区溢出检查（错误码 8·v2p 自举
//   编译器自身中止·最小复现 `类 C { 静态 整64 值 = -9223372036854775808; }`）；
//   分治全程无溢出面，mod 2^64 位模式与旧累加逐位一致（零行为变更·与
//   折叠文本转值1029/解析常量文本 同构）。
函数 类静态初值解析整数64(字符串 文本, 整64& 值出) -> 布尔 {
    整64 长 = 字符串长度(文本);
    整64 位 = 0;
    布尔 负 = 假;
    如果 (长 > 0 && 静字节值(文本, 0) == 45) { 负 = 真; 位 = 1; }
    否则 如果 (长 > 0 && 静字节值(文本, 0) == 43) { 位 = 1; }
    如果 (位 >= 长) { 返回 假; }
    整64 进制 = 10;
    如果 (长 - 位 > 2 && 静字节值(文本, 位) == 48) {
        整64 次b = 静字节值(文本, 位 + 1);
        如果 (次b == 120 || 次b == 88) { 进制 = 16; 位 = 位 + 2; }
        否则 如果 (次b == 98 || 次b == 66) { 进制 = 2; 位 = 位 + 2; }
        否则 如果 (次b == 111 || 次b == 79) { 进制 = 8; 位 = 位 + 2; }
    }
    如果 (位 >= 长) { 返回 假; }
    整64 高 = 0;
    整64 低 = 0;
    当 (位 < 长) {
        整64 数v = 静字节值(文本, 位);
        如果 (数v >= 48 && 数v <= 57) { 数v = 数v - 48; }
        否则 如果 (数v >= 97 && 数v <= 102) { 数v = 数v - 87; }
        否则 如果 (数v >= 65 && 数v <= 70) { 数v = 数v - 55; }
        否则 如果 (数v == 76 || 数v == 108 || 数v == 85 || 数v == 117) { 中断; }
        否则 { 返回 假; }
        如果 (数v >= 进制) { 返回 假; }
        位模式累加474(进制, 数v, 高, 低);
        位++;
    }
    值出 = 位模式合成474(高, 低);
    如果 (负) { 值出 = 位模式取负474(值出); }
    返回 真;
}

// 1027（1074·919 邻接）：静态初值后「完整终结」判定——后位=初值 token 已
//   消费处：分号/`}`/跨行/文件结束=声明结束（561 族无分号宽松形态+同行闭合
//   类体维持·宿主 AST 层面与终止记号无关）；同行仍有其他 token=表达式/多余
//   token 形态（加载期直存不承载·宿主 BinaryExpr 落最后 errorOut 同判）。
函数 静态初值完整终结(向量<Token> 记号, 整64 后位, 整32 初值行) -> 布尔 {
    如果 (当前类型(记号, 后位) == 令牌_文件结束) { 返回 真; }
    如果 (当前行(记号, 后位) > 初值行) { 返回 真; }
    如果 (当前类型(记号, 后位) == 令牌_运算符 &&
         (当前ID(记号, 后位) == 整32(驻留(";")) ||
          当前ID(记号, 后位) == 整32(驻留("}")))) { 返回 真; }
    返回 假;
}

// 1027（1074）：错误恢复——跳过同行余下 token（至分号/`}`/跨行/文件结束）。
//   防「初值 token 残留→下轮按字段声明重解析→类字段声明缺少字段名」级联
//   误报（743 探针实录 v2 双噪声·919 探针 p14 实录四噪声的噪声源）。
函数 跳过静态初值行余下(向量<Token> 记号, 整64 位置, 整32 初值行) -> 整64 {
    当 (位置 < 记号.大小() && 当前行(记号, 位置) == 初值行 &&
         !(当前类型(记号, 位置) == 令牌_运算符 &&
           (当前ID(记号, 位置) == 整32(驻留(";")) ||
            当前ID(记号, 位置) == 整32(驻留("}"))))) {
        位置++;
    }
    返回 位置;
}

// 1027（1074）：类静态字段初始化器不支持诊断——宿主 semantic/class_resolver.cpp
//   foldClassStaticInit 调用点单点句逐字对齐（类/字段名全句+四档子因同文），
//   v2 侧仅保留 [parse] 通道前缀。
函数 报类静态初始化器不支持(字符串 类名文本, 字符串 字段名文本, 字符串 子因) -> 空类型 {
    IO::打印到错误("[parse] 类 '" + 类名文本 + "' 静态字段 '" + 字段名文本 +
                   "' 声明初始化器不支持：" + 子因 +
                   "（加载期直存面·001 §静态成员）——请在构造函数或主入口赋值（运行期读写链全形态生效）\n");
}

// 1027（1074·919 邻接）：类静态字段初值折叠：= 后调用（调用方已消费 =）。
//   支持=回填 初值出 并返回终止位；拒绝=语法错误加一（中止通道）并返回已
//   消费位（防级联）。
//   判定/文案=宿主 foldClassStaticInit 单点口径逐字对齐（1074 复核矩阵：
//   同拒形态旧 v2 为语法层多条+错误恢复噪声/宿主单条；判据面两处存量分叉
//   一并收口）：
//   ① 形态面：初值后非完整终结（表达式/多余 token）→子因「仅整数/布尔
//      字面量可加载期直存」（宿主 AST BinaryExpr 同句·原「初值后仅允许
//      分号或换行」独立文案退位）；
//   ② 槽面：布尔=标量槽承载（宿主 isStaticScalarInitType 含 128 槽实测
//      放行——原「128 位槽不承载布尔」误拒撤销）；整数=整数槽≤64/128 槽
//      承载，非标量槽（浮点等）子因「整数字面量初值不适用于字段类型 'T'
//      （浮点槽不承载加载期直存）」（原 字面量文本入域 对未知目标 miss
//      默认放行=静默分叉源头）；
//   ③ 值域面（535/640）：完整整数初值+标量槽判值域（超域拒·句补类/字段名）。
//   拒绝路径统一 跳过静态初值行余下（错误恢复·防级联噪声）。
函数 解析类静态字段初值(向量<Token> 记号, 整64 位置, 字符串 类型文本,
                      字符串 类名文本, 字符串 字段名文本,
                      字符串& 初值出) -> 整64 {
    字符串 词文 = 字符串复制(当前文本(记号, 位置));
    整32 初值行 = 当前行(记号, 位置);
    布尔 是128槽 = 字符串比较(类型文本, "整128") ||
                  字符串比较(类型文本, "正128");
    // ① 布尔字面量（真/假 → 1/0）
    如果 (字符串比较(词文, "真") || 字符串比较(词文, "假")) {
        如果 (!静态初值完整终结(记号, 位置 + 1, 初值行)) {
            报类静态初始化器不支持(类名文本, 字段名文本,
                                   "仅整数/布尔字面量可加载期直存");
            语法错误加一();
            返回 跳过静态初值行余下(记号, 位置, 初值行);
        }
        如果 (!是静态标量类型(类型文本)) {
            报类静态初始化器不支持(类名文本, 字段名文本,
                                   "布尔字面量初值不适用于字段类型 '" + 类型文本 + "'");
            语法错误加一();
            返回 位置 + 1;
        }
        初值出 = 字符串复制("0");
        如果 (字符串比较(词文, "真")) { 初值出 = 字符串复制("1"); }
        返回 位置 + 1;
    }
    // ② 一元负号（单个·与字面量同一代数实体）
    布尔 负号 = 假;
    如果 (当前类型(记号, 位置) == 令牌_运算符 &&
         当前ID(记号, 位置) == 整32(驻留("-"))) {
        负号 = 真;
        位置++;
        词文 = 字符串复制(当前文本(记号, 位置));
    }
    // ③ 整数字面量（64 位规范化十进制；128 位槽=符号×原样文本）
    整64 值468 = 0;
    如果 (类静态初值解析整数64(词文, 值468)) {
        如果 (!静态初值完整终结(记号, 位置 + 1, 初值行)) {
            报类静态初始化器不支持(类名文本, 字段名文本,
                                   "仅整数/布尔字面量可加载期直存");
            语法错误加一();
            返回 跳过静态初值行余下(记号, 位置, 初值行);
        }
        如果 (!是128槽 && !是静态标量类型(类型文本)) {
            // 宿主 fold 同段：整数初值仅整数槽/128 槽承载（浮点槽等按子因拒）
            报类静态初始化器不支持(类名文本, 字段名文本,
                                   "整数字面量初值不适用于字段类型 '" + 类型文本 +
                                   "'（浮点槽不承载加载期直存）");
            语法错误加一();
            返回 位置 + 1;
        }
        // 535 批乙（2026-10-14 用户裁决·001 §静态成员域限制补句·640 恢复）：
        //   类静态字段超域字面量直存语法期拒——域判定=IR 中立层 字面量文本入域
        //   （字面量域判定族单一真源·语法/语义双消费·535 下沉），语义与
        //   宿主 intLiteralFitsType（558 文本级+进制值级）同构；域内初值零
        //   行为变化（域外原按声明位宽静默截断 vs v2 64 位直读分叉·非法形态
        //   源头消灭）。128 槽与 ≤64 标量槽都判（128=文本域 2^127 界）。
        // 1016（五轮审查 P1-1）：负号 + 无符号后缀（U/u）非零值——类静态字段
        //   加载期直存面拒绝（宿主 class_resolver → intLiteralFitsType 同判据；
        //   本判据**不放共享 字面量文本入域**——常量/实例字段宿主放行现状保持）。
        布尔 负U468 = 负号 && 负无符号非零1016(词文, 真);
        布尔 入域468c = 负U468 == 假 && 字面量文本入域(词文, 类型文本, 负号);
        如果 (入域468c) {
            // 640（2026-10-16）：128 槽文本域叠加（535 原版对 128 目标恒真——
            //   超承载文本可超 2^127）。
            入域468c = 字面量文本入域128_640(词文, 类型文本, 负号);
        }
        如果 (!入域468c) {
            IO::打印到错误("[parse] 类 '" + 类名文本 + "' 静态字段 '" + 字段名文本 +
                           "' 的声明初值超出 '" + 类型文本 +
                           "' 值域——静态槽加载期直存须为值域内字面量（001 §静态成员·535）；如确需位模式截断请显式转换（如 " +
                           类型文本 + "(表达式)）\n");
            语法错误加一();
        }
        如果 (是128槽) {
            初值出 = 字符串复制(词文);
            如果 (负号) { 初值出 = 字符串复制("-") + 初值出; }
            返回 位置 + 1;
        }
        // 728v：负号回填经 位模式取负474（-2^63 补码不动点）——原 0-值
        //   取负在 MIN 文本（数值部分 2^63）处触发安全区溢出（错误码 8）
        如果 (负号) { 值468 = 位模式取负474(值468); }   // ② 消费的负号回填（词文无符号）
        初值出 = 整数转字符串(值468);
        返回 位置 + 1;
    }
    // ④ 浮点字面量（含符号链）——宿主 468 子因同文
    如果 (当前类型(记号, 位置) == 令牌_浮点字面量) {
        报类静态初始化器不支持(类名文本, 字段名文本,
                               "浮点初值不属于加载期直存形态");
        语法错误加一();
        返回 跳过静态初值行余下(记号, 位置, 初值行);
    }
    // ⑤ 其余形态（字符/字符串/标识符/负号后非整数）——宿主 468 子因同文
    报类静态初始化器不支持(类名文本, 字段名文本,
                           "仅整数/布尔字面量可加载期直存");
    语法错误加一();
    返回 跳过静态初值行余下(记号, 位置, 初值行);
}

// 775（甲案·2026-10-15 用户裁决甲）：静态标量类型白名单（宿主
//   isStaticScalarInitType 同构——intRankTable 整数族（整/正 8..128）∪
//   {字符, 布尔}；「整数」别名=canonical 整32 情形。128 位列在：布尔→128
//   字段宿主 foldClassInstanceInit 放行 "1"/"0"）。
函数 是静态标量类型(字符串 类型文本) -> 布尔 {
    返回 字符串比较(类型文本, "整8") || 字符串比较(类型文本, "整16") ||
          字符串比较(类型文本, "整32") || 字符串比较(类型文本, "整64") ||
          字符串比较(类型文本, "整128") || 字符串比较(类型文本, "正8") ||
          字符串比较(类型文本, "正16") || 字符串比较(类型文本, "正32") ||
          字符串比较(类型文本, "正64") || 字符串比较(类型文本, "正128") ||
          字符串比较(类型文本, "字符") || 字符串比较(类型文本, "布尔") ||
          字符串比较(类型文本, "整数");
}

// 775（甲案·2026-10-15 用户裁决甲）：实例字段声明初始化器值折叠——值节点
//   （整数含符号链/布尔字面量）→ 规范文本（宿主 foldClassInstanceInit 同构·
//   零分叉）：128 字段=符号×原样文本；标量字段=64 位规范化十进制（各进制/
//   后缀经 类静态初值解析整数64）/布尔 "1"·"0"；非标量字段类型=拒绝
//   （错误出非空=调用方诊断通道）。节点驱动（解析表达式产物）——与静态面
//   token 驱动的 解析类静态字段初值 接口不同（同族口径·非重复实现）。
不安全 函数 折叠类字段默认值(向量<节点> 池, 整64 值节点ID, 字符串 字段类型文本,
                        字符串& 错误出) -> 字符串 {
    错误出 = "";
    整64 节点IDf = 值节点ID;
    布尔 负f = 假;
    整64 守卫f = 0;
    当 (守卫f < 64) {
        如果 (节点IDf <= 0) { 中断; }
        节点 当f = 池.元素(整32(节点IDf));
        如果 (当f.类型 == 节点_负号) {
            负f = !负f;
            // 1016（五轮审查 P1-4 v2 对称）：后缀序操作数根=自身索引-1——
            //   原用 子起点 下钻，嵌套负号（-(-5)）的子起点=区间起点（最内层
            //   字面量）跳过内层负号 → 符号少翻一次（整64 值 -5 / 128 -(-5U)
            //   输出 -5 错值）。逐层 -1 下钻与 569 负号链同契约。
            节点IDf = 节点IDf - 1;
        } 否则 { 中断; }
        守卫f = 守卫f + 1;
    }
    节点 终f = 池.元素(整32(节点IDf));
    布尔 是128f = 字符串比较(字段类型文本, "整128") ||
                  字符串比较(字段类型文本, "正128");
    如果 (终f.类型 == 节点_整数字面量) {
        字符串 文f = 字符串复制(驻留文本(整64(终f.文本)));
        如果 (是128f) {
            // 1016（五轮审查 P1-4 v2 对称）：折叠形态 文f 可能已带 '-'（内层
            //   负号折叠产物 raw）——先剥号翻转符号，原 "--5U" 双重符号错值
            //   （宿主 class_resolver 同修 128 分支；类实例字段 -(-5U) 输出
            //   5 与宿主一致）。
            如果 (字符串长度(文f) > 0 && (整64(文f[0]) & 255) == 45) {
                文f = 字符串子串(文f, 1, 整32(字符串长度(文f) - 1));
                负f = !负f;
            }
            如果 (负f) { 文f = "-" + 文f; }
            返回 文f;
        }
        如果 (是静态标量类型(字段类型文本)) {
            整64 值f = 0;
            如果 (!类静态初值解析整数64(文f, 值f)) {
                错误出 = "整数字面量默认值不可解析（起步面）";
                返回 "";
            }
            如果 (负f) { 值f = 0 - 值f; }
            返回 整数转字符串(值f);
        }
        错误出 = "整数字面量默认值不适用于字段类型 '" + 字段类型文本 + "'";
        返回 "";
    }
    如果 (终f.类型 == 节点_布尔字面量) {
        如果 (是静态标量类型(字段类型文本)) {
            字符串 布文f = 字符串复制(驻留文本(整64(终f.文本)));
            如果 (字符串比较(布文f, "真") || 字符串比较(布文f, "1")) {
                返回 "1";
            }
            返回 "0";
        }
        错误出 = "布尔字面量默认值不适用于字段类型 '" + 字段类型文本 + "'";
        返回 "";
    }
    错误出 = "仅整数/布尔字面量可作实例字段默认值（起步面）";
    返回 "";
}

// ==================== 234：祖先层字段并入（857 自 解析类.cn 机械搬移·超警戒线拆分） ====================
// 递归最基类先（字段序=祖先在前·宿主 fieldOrder 同构）；层平移=本类头-层头
//   （共享 vptr：祖先字段新偏移=层登记偏移+平移）。资源字段（容器/字符串）/
//   全字段表三元组同步复制——析构级联/深拷/类型大小链零改动复用。
// 857 搬移说明：函数体逐字保留（零行为变更）——解析类.cn 触及 900 行警戒线，
//   按 AGENTS「先拆再加」将本函数族迁入辅助文件；调用点经包内合并全局池同链。
不安全 函数 并入基类字段(整64 层名ID, 整64 子类键基b, 整64 平移量b,
                     映射<整64, 整64>& 字段偏移表,
                     整64* 最大对齐b, 整64* 最大字段b) -> 空类型 {
    // 1541 B2：有值=有祖先层（原 !=0 判据）
    可选<整64> 上层查b = 查类基名(层名ID);
    如果 (上层查b.有值) {
        整64 上层b = 上层查b.值;
        并入基类字段(上层b, 子类键基b, 平移量b, 字段偏移表, 最大对齐b, 最大字段b);
    }
    整64 层键基b = 键基合成(取当前模块路径(), 层名ID);
    整64 ib = 0;
    当 (ib + 2 < 结构体全字段表们.大小()) {
        如果 (结构体全字段表们.元素(ib) == 层键基b) {
            整64 字段名b = 结构体全字段表们.元素(ib + 1);
            整64 类型文本b = 结构体全字段表们.元素(ib + 2);
            整64 父分桶b = 层键基b * 键位移 + 字段名b;
            结果<整64, 整32> 查偏b = 字段偏移表.获取(父分桶b);
            如果 (查偏b.正常) {
                整64 新偏b = 查偏b.值 + 平移量b;
                整64 分桶键b = 子类键基b * 键位移 + 字段名b;
                结果<空类型, 整32> 加表b = 字段偏移表.设置(分桶键b, 新偏b);
                如果 (!加表b.正常) { 运行时错误(4); }
                登记字段类型(分桶键b, 类型文本b);
                登记字段偏移(分桶键b, 新偏b);
                字符串 类型串b = 字符串复制(驻留文本(类型文本b));
                整64 资源类别b = 0 - 1;
                如果 (是容器类(类型串b)) { 资源类别b = 1; } 否则 如果 (字符串比较(类型串b, "字符串")) { 资源类别b = 0; }
                如果 (资源类别b >= 0 && 资源类别b <= 1) {
                    登记资源字段(子类键基b, 字段名b, 类型文本b, 新偏b, 资源类别b == 1, 资源类别b);
                }
                结果<空类型, 整32> 加ab = 结构体全字段表们.追加(子类键基b);
                如果 (!加ab.正常) { 运行时错误(4); }
                结果<空类型, 整32> 加bb = 结构体全字段表们.追加(字段名b);
                如果 (!加bb.正常) { 运行时错误(4); }
                结果<空类型, 整32> 加cb = 结构体全字段表们.追加(类型文本b);
                如果 (!加cb.正常) { 运行时错误(4); }
                // 775（甲案·2026-10-15 用户裁决）：字段默认值随字段并入——
                //   祖先层登记（层键基域）的默认值并入子类键基域（本层优先：
                //   遮蔽字段的本层默认值已登记不被覆盖；多级链经逐层复制自然
                //   传递——并入父层时源域已含更上层复制值）。发射侧
                //   发射类字段默认值（生成声明尾.cn）单层遍历即全链覆盖。
                结果<整64, 整32> 查默b = 字段默认值们.获取(层键基b * 键位移 + 字段名b);
                如果 (查默b.正常) {
                    结果<整64, 整32> 查本默b = 字段默认值们.获取(子类键基b * 键位移 + 字段名b);
                    如果 (!查本默b.正常) {
                        登记字段默认值(子类键基b * 键位移 + 字段名b, 查默b.值);
                    }
                }
                否则 {
                }
                // 463：并入侧同回实宽（与 解析类字段 实宽口径一致——沿链继承
                //   类窄字段偏移/尺寸与宿主逐字节同布局；类/容器字段仍句柄槽
                //   8/8。413-c 恒 8/8 随写宽分派轮一并翻开）。857：指针字段
                //   文本带星（全字段表存真类型）——类型大小与对齐 指针分支
                //   显式 8/8（不靠未知兜底）。
                整64 字段大小b = 8;
                整64 字段对齐b = 8;
                类型大小与对齐(类型串b, &字段大小b, &字段对齐b);
                如果 (是用户类(类型串b) || 是容器类(类型串b)) {
                    字段大小b = 8;
                    字段对齐b = 8;
                }
                如果 (字段对齐b > 最大对齐b[0]) { 最大对齐b[0] = 字段对齐b; }
                如果 (字段大小b > 最大字段b[0]) { 最大字段b[0] = 字段大小b; }
            }
            否则 {
            }
        }
        ib = ib + 3;
    }
}

// ==================== 846：构造初始化列表项序列（成员初始化列表形态） ====================
// 001 无立法形态的解析与恢复（C++ 成员初始化列表姊妹形态：`构造 名(...) : 名(实参),
//   名(实参) ...`）：原实现（解析类.cn 解析方法体 内联段）只处理第一项——`, 二(2)`
//   尾巴残交解析块 →「语句解析中断」+ 类体循环「类字段声明缺少字段名」连环误报
//   雪崩（p08 探针修前 13 条实录）。本函数（857 先例：新功能落辅助文件·控解析类.cn
//   900 行警戒线）：①逐项消费逗号分隔项序列；②项名与声明基类（查类基名）不符=
//   报「初始化列表基名与声明基类不符」一次（首处·逐字对齐宿主 parser_oop.cpp
//   parseFunctionMember 同句）；③非标识符项名=报「初始化列表预期基类名」并中断；
//   ④中断/畸形残留=同步跳到安全 token（`{` / `;` / `}`·括号深度 0 处）——后续
//   方法体/类体成员恢复正常解析（不雪崩）。登记面：仅首项实参登记 基构造实参根/
//   实参数（语义/生成消费面——后续项属未立法形态，登记会污染父构造实参数计数
//   致「无 N 参构造」误报）。方法名 ID 与类名 ID 恒等（调用方进入条件=构造形态）。
函数 解析构造初始化列表846(向量<Token> 记号, 整64 位置, 向量<节点> 池,
                          映射<整64, 整64>& 字段偏移表,
                          整64 类名IDm) -> 整64 {
    整32 已报不符846 = 0;
    布尔 中断846 = 假;
    布尔 首项846 = 真;
    当 (真) {
        如果 (!(当前类型(记号, 位置) == 令牌_标识符)) {
            IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                           ": 初始化列表预期基类名\n");
            语法错误加一();
            中断846 = 真;
            中断;
        }
        整64 基名c846 = 整64(当前ID(记号, 位置));
        位置++;
        // 1541 B2：有值=声明基类名ID（原 0=无声明基类→与项名必不符）
        可选<整64> 声明基查846 = 查类基名(类名IDm);
        布尔 基名相符846 = 假;
        如果 (声明基查846.有值) {
            如果 (基名c846 == 声明基查846.值) { 基名相符846 = 真; }
        }
        如果 (!基名相符846 && 已报不符846 == 0) {
            IO::打印到错误("[parse] 行 " + 整数转字符串(当前行(记号, 位置)) +
                           ": 初始化列表基名与声明基类不符\n");
            语法错误加一();
            已报不符846 = 1;
        }
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留("("))) { 位置++; }
        整64 根序c846 = 0;
        如果 (!(当前类型(记号, 位置) == 令牌_运算符 &&
               当前ID(记号, 位置) == 整32(驻留(")")))) {
            当 (真) {
                位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
                如果 (首项846) {
                    登记基构造实参根(类名IDm, 类名IDm, 根序c846,
                                     整64(池.大小()) - 1);
                }
                根序c846++;
                如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留(","))) { 位置++; 继续; }
                中断;
            }
        }
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留(")"))) { 位置++; }
        如果 (首项846) { 登记基构造实参数(类名IDm, 类名IDm, 根序c846); }
        首项846 = 假;
        如果 (当前类型(记号, 位置) == 令牌_运算符 &&
             当前ID(记号, 位置) == 整32(驻留(","))) { 位置++; 继续; }
        中断;
    }
    如果 (中断846) {
        整32 深846 = 0;
        当 (位置 < 记号.大小()) {
            如果 (当前类型(记号, 位置) == 令牌_文件结束) { 中断; }
            如果 (深846 == 0 && 当前类型(记号, 位置) == 令牌_运算符 &&
                (当前ID(记号, 位置) == 整32(驻留("{")) ||
                 当前ID(记号, 位置) == 整32(驻留(";")) ||
                 当前ID(记号, 位置) == 整32(驻留("}")))) { 中断; }
            如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                (当前ID(记号, 位置) == 整32(驻留("(")) ||
                 当前ID(记号, 位置) == 整32(驻留("[")))) { 深846++; }
            如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                (当前ID(记号, 位置) == 整32(驻留(")")) ||
                 当前ID(记号, 位置) == 整32(驻留("]")))) {
                如果 (深846 != 0) { 深846--; }
            }
            位置++;
        }
    }
    返回 位置;
}

