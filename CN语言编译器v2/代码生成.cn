// CN 自举编译器 v2：结构化代码生成器（自举重建 P6，2026-08-25）
// 性能最优架构最后一层：IR 指令数组 -> win-x64 MASM 汇编文本行。
// 设计（对标 C++ 编译器 x64_codegen，栈槽模型）：
//   - 虚拟寄存器 r -> [rbp-8*r-8] 栈槽（r=1 -> rbp-16）；
//   - 变量槽 s（参数+局部）-> [rbp-8*(最大寄存器+s)-8]（寄存器区之上，互不冲突）；
//   - 函数框架：PROC 名 PROC / push rbp / mov rbp,rsp / sub rsp,帧大小 /
//     指令 / mov rsp,rbp / pop rbp / ret / 名 ENDP；
//   - Win x64 参数装载：前 4 参数 rcx/rdx/r8/r9 -> 参数槽；标量返回 rax。
// 支持 IR 操作码（当前 P5 子集）：常量整数/加载/存储/算术(加减小除余)/
//   比较(相等..大于等于)/逻辑非/返回/分配。调用/内存/对象 后续阶段扩展。

导入 容器::向量
导入 IR生成

公开:

// ==================== 符号修饰（对标 C++ nameMangle） ====================
// 中文/非ASCII 符号 -> "?" + UTF-8 每字节 %02X + "@@Y"（MASM 可汇编 ASCII 符号）。
// 纯 ASCII 原样返回。
函数 十六进制位(整64 值) -> 字符串 {
    如果 (值 <= 9) { 返回 整数转字符串(值) }
    如果 (值 == 10) { 返回 "A" }
    如果 (值 == 11) { 返回 "B" }
    如果 (值 == 12) { 返回 "C" }
    如果 (值 == 13) { 返回 "D" }
    如果 (值 == 14) { 返回 "E" }
    返回 "F"
}
函数 字节十六进制(整64 字节) -> 字符串 {
    返回 十六进制位(字节 / 16) + 十六进制位(字节 % 16)
}
函数 符号修饰(字符串 名) -> 字符串 {
    布尔 非ASCII = 假
    整64 i = 0
    当 (i < 字符串长度(名)) {
        整64 字节 = 整64(名[i])
        如果 (字节 < 0) { 字节 = 字节 + 256 }
        如果 (字节 >= 128) { 非ASCII = 真; 中断 }
        i++
    }
    如果 (!非ASCII) { 返回 名 }
    字符串 修饰 = "?"
    整64 j = 0
    当 (j < 字符串长度(名)) {
        整64 字节 = 整64(名[j])
        如果 (字节 < 0) { 字节 = 字节 + 256 }
        修饰 = 修饰 + 字节十六进制(字节)
        j++
    }
    返回 修饰 + "@@Y"
}

// ==================== 栈槽地址文本 ====================
// 虚拟寄存器 r -> [rbp-8*r-8]
函数 寄存器槽(整64 寄存器) -> 字符串 {
    返回 "[rbp-" + 整数转字符串(8 * 寄存器 + 8) + "]"
}
// 变量槽 s（参数+局部）-> [rbp-8*(最大寄存器+s)-8]（寄存器区之上）
函数 变量槽(整64 槽, 整64 最大寄存器) -> 字符串 {
    返回 "[rbp-" + 整数转字符串(8 * (最大寄存器 + 槽) + 8) + "]"
}

// ==================== 帧扫描 ====================
// 统计函数最大寄存器 ID 与最大变量槽（prologue sub rsp 预留帧大小）。
函数 扫描函数(函数IR 函数信息, 整64* 最大寄存器, 整64* 最大槽) -> 空类型 {
    整64 i = 0
    当 (i < 函数信息.指令.大小()) {
        IR指令 指令 = 函数信息.指令.元素(i)
        如果 (指令.目标 > 最大寄存器[0]) { 最大寄存器[0] = 指令.目标 }
        // 常量指令的操作数1 是 Symbol ID（非寄存器），不参与统计
        如果 (指令.操作码 != IR_常量整数 && 指令.操作码 != IR_常量浮点 &&
             指令.操作码 != IR_常量字符串 && 指令.操作码 != IR_常量布尔) {
            如果 (指令.操作数1 > 最大寄存器[0]) { 最大寄存器[0] = 指令.操作数1 }
            如果 (指令.操作数2 > 最大寄存器[0]) { 最大寄存器[0] = 指令.操作数2 }
            如果 (指令.操作数3 > 最大寄存器[0]) { 最大寄存器[0] = 指令.操作数3 }
        }
        如果 (指令.操作码 == IR_分配) {
            // 变量槽登记：附加 = 槽索引
            如果 (指令.附加 > 最大槽[0]) { 最大槽[0] = 指令.附加 }
        }
        i++
    }
    // 参数槽：参数槽 表 大小
    整64 参数数 = 函数信息.参数槽.大小()
    如果 (参数数 > 最大槽[0]) { 最大槽[0] = 参数数 }
}

// ==================== 单指令生成 ====================
// 生成一条 IR 指令的 MASM 文本到 输出。
函数 生成指令(IR指令 指令, 整64 最大寄存器, 向量<字符串> 输出) -> 空类型 {
    结果<空类型, 整32> 加行 = 输出.追加("    ; op=" + 整数转字符串(指令.操作码))
    如果 (指令.操作码 == IR_常量整数) {
        // 常量整数：操作数1 = Symbol ID（文本），mov 目标槽, 值
        字符串 值 = 驻留文本(指令.操作数1)
        结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 值)
        结果<空类型, 整32> 加2 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax")
        返回
    }
    如果 (指令.操作码 == IR_加载) {
        // Load 变量槽 -> 寄存器
        结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 变量槽(指令.操作数1, 最大寄存器))
        结果<空类型, 整32> 加2 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax")
        返回
    }
    如果 (指令.操作码 == IR_存储) {
        // Store 寄存器 -> 变量槽（操作数1=值寄存器，附加=槽）
        结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1))
        结果<空类型, 整32> 加2 = 输出.追加("    mov " + 变量槽(指令.附加, 最大寄存器) + ", rax")
        返回
    }
    如果 (指令.操作码 == IR_加) {
        结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1))
        结果<空类型, 整32> 加2 = 输出.追加("    add rax, " + 寄存器槽(指令.操作数2))
        结果<空类型, 整32> 加3 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax")
        返回
    }
    如果 (指令.操作码 == IR_减) {
        结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1))
        结果<空类型, 整32> 加2 = 输出.追加("    sub rax, " + 寄存器槽(指令.操作数2))
        结果<空类型, 整32> 加3 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax")
        返回
    }
    如果 (指令.操作码 == IR_乘) {
        结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1))
        结果<空类型, 整32> 加2 = 输出.追加("    imul rax, " + 寄存器槽(指令.操作数2))
        结果<空类型, 整32> 加3 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax")
        返回
    }
    如果 (指令.操作码 == IR_除) {
        // 除：rdx:rax = 被除数；除数 rcx；idiv
        结果<空类型, 整32> 加1 = 输出.追加("    xor rdx, rdx")
        结果<空类型, 整32> 加2 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1))
        结果<空类型, 整32> 加3 = 输出.追加("    mov rcx, " + 寄存器槽(指令.操作数2))
        结果<空类型, 整32> 加4 = 输出.追加("    idiv rcx")
        结果<空类型, 整32> 加5 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax")
        返回
    }
    如果 (指令.操作码 == IR_取余) {
        // 取余：idiv 后 rdx 存余数
        结果<空类型, 整32> 加1 = 输出.追加("    xor rdx, rdx")
        结果<空类型, 整32> 加2 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1))
        结果<空类型, 整32> 加3 = 输出.追加("    mov rcx, " + 寄存器槽(指令.操作数2))
        结果<空类型, 整32> 加4 = 输出.追加("    idiv rcx")
        结果<空类型, 整32> 加5 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rdx")
        返回
    }
    如果 (指令.操作码 == IR_相等 || 指令.操作码 == IR_不等 ||
        指令.操作码 == IR_小于 || 指令.操作码 == IR_大于 ||
        指令.操作码 == IR_小于等于 || 指令.操作码 == IR_大于等于) {
        // 比较：cmp 左, 右；setcc al；movzx 目标
        字符串 设置指令 = "sete"
        如果 (指令.操作码 == IR_不等) { 设置指令 = "setne" }
        否则 如果 (指令.操作码 == IR_小于) { 设置指令 = "setl" }
        否则 如果 (指令.操作码 == IR_大于) { 设置指令 = "setg" }
        否则 如果 (指令.操作码 == IR_小于等于) { 设置指令 = "setle" }
        否则 如果 (指令.操作码 == IR_大于等于) { 设置指令 = "setge" }
        结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1))
        结果<空类型, 整32> 加2 = 输出.追加("    cmp rax, " + 寄存器槽(指令.操作数2))
        结果<空类型, 整32> 加3 = 输出.追加("    " + 设置指令 + " al")
        结果<空类型, 整32> 加4 = 输出.追加("    movzx eax, al")
        结果<空类型, 整32> 加5 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax")
        返回
    }
    如果 (指令.操作码 == IR_逻辑非) {
        // 逻辑非：cmp 操作数, 0；sete al；movzx
        结果<空类型, 整32> 加1 = 输出.追加("    cmp " + 寄存器槽(指令.操作数1) + ", 0")
        结果<空类型, 整32> 加2 = 输出.追加("    sete al")
        结果<空类型, 整32> 加3 = 输出.追加("    movzx eax, al")
        结果<空类型, 整32> 加4 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax")
        返回
    }
    如果 (指令.操作码 == IR_负) {
        // 一元负：neg 源
        结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1))
        结果<空类型, 整32> 加2 = 输出.追加("    neg rax")
        结果<空类型, 整32> 加3 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax")
        返回
    }
    如果 (指令.操作码 == IR_类型转换) {
        // P6g（2026-08-30）：类型转换 类型(expr)——目标类型码在 指令.类型，
        //   源值在 指令.操作数1 槽。整64 -> 整32：截断（mov eax 低32位 + movsxd 符号扩展）；
        //   整32 -> 整64：movsxd（符号扩展）；浮点转换暂按整64 透传（浮点运算后续）。
        字符串 源槽 = 寄存器槽(指令.操作数1)
        如果 (指令.类型 == T_整32) {
            结果<空类型, 整32> 加1 = 输出.追加("    mov eax, " + 源槽)
            结果<空类型, 整32> 加2 = 输出.追加("    movsxd rax, eax")
        } 否则 {
            // 整64/其他：movsxd 符号扩展（32 位源已由 IR 层按 整64 槽存）
            结果<空类型, 整32> 加3 = 输出.追加("    movsxd rax, " + 源槽)
        }
        结果<空类型, 整32> 加4 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax")
        返回
    }
    如果 (指令.操作码 == IR_调用) {
        // 函数调用：参数装载（前 3 参数寄存器 -> rcx/rdx/r8）+ 影子空间 + call + 返回
        如果 (指令.操作数1 != 0) {
            结果<空类型, 整32> 加1 = 输出.追加("    mov rcx, " + 寄存器槽(指令.操作数1))
        }
        如果 (指令.操作数2 != 0) {
            结果<空类型, 整32> 加1 = 输出.追加("    mov rdx, " + 寄存器槽(指令.操作数2))
        }
        如果 (指令.操作数3 != 0) {
            结果<空类型, 整32> 加1 = 输出.追加("    mov r8, " + 寄存器槽(指令.操作数3))
        }
        结果<空类型, 整32> 加2 = 输出.追加("    sub rsp, 32")
        字符串 被调名 = 符号修饰(驻留文本(指令.附加))
        结果<空类型, 整32> 加3 = 输出.追加("    call " + 被调名)
        结果<空类型, 整32> 加4 = 输出.追加("    add rsp, 32")
        结果<空类型, 整32> 加5 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax")
        返回
    }
    如果 (指令.操作码 == IR_返回) {
        // 返回：mov rax, 返回值寄存器（0=无返回值）
        如果 (指令.操作数1 != 0) {
            结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1))
        } 否则 {
            结果<空类型, 整32> 加1 = 输出.追加("    xor rax, rax")
        }
        返回
    }
    如果 (指令.操作码 == IR_取地址) {
        // 取地址：lea 目标, 变量槽（操作数1=槽）
        结果<空类型, 整32> 加1 = 输出.追加("    lea rax, " + 变量槽(指令.操作数1, 最大寄存器))
        结果<空类型, 整32> 加2 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax")
        返回
    }
    如果 (指令.操作码 == IR_指针加载) {
        // 经指针加载：mov rax, [rax]（操作数1=地址寄存器）
        结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1))
        结果<空类型, 整32> 加2 = 输出.追加("    mov rax, [rax]")
        结果<空类型, 整32> 加3 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax")
        返回
    }
    如果 (指令.操作码 == IR_指针存储) {
        // 经指针存储：mov [地址], 值（操作数1=地址寄存器，操作数2=值寄存器）
        结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1))
        结果<空类型, 整32> 加2 = 输出.追加("    mov rcx, " + 寄存器槽(指令.操作数2))
        结果<空类型, 整32> 加3 = 输出.追加("    mov [rax], rcx")
        返回
    }
    如果 (指令.操作码 == IR_字段地址) {
        // 字段地址：lea 目标, [基址+偏移]（操作数1=基址寄存器，附加=偏移字节）
        结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1))
        如果 (指令.附加 != 0) {
            结果<空类型, 整32> 加2 = 输出.追加("    add rax, " + 整数转字符串(指令.附加))
        }
        结果<空类型, 整32> 加3 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax")
        返回
    }
    如果 (指令.操作码 == IR_标签) {
        // 块标签：bbN:（P6b 控制流）
        结果<空类型, 整32> 加1 = 输出.追加("bb" + 整数转字符串(指令.附加) + ":")
        返回
    }
    如果 (指令.操作码 == IR_跳转) {
        // 无条件跳转
        结果<空类型, 整32> 加1 = 输出.追加("    jmp bb" + 整数转字符串(指令.附加))
        返回
    }
    如果 (指令.操作码 == IR_条件跳转) {
        // 条件跳转：mov eax, 条件寄存器；test eax,eax；jnz 真块；jmp 假块
        // 条件寄存器 = 操作数1
        结果<空类型, 整32> 加1 = 输出.追加("    mov eax, " + 寄存器槽(指令.操作数1))
        结果<空类型, 整32> 加2 = 输出.追加("    test eax, eax")
        结果<空类型, 整32> 加3 = 输出.追加("    jnz bb" + 整数转字符串(指令.操作数2))
        结果<空类型, 整32> 加4 = 输出.追加("    jmp bb" + 整数转字符串(指令.操作数3))
        返回
    }
    // IR_分配 等：prologue 预留帧，此处 no-op
}

// ==================== 函数生成 ====================
// 生成单函数的完整 asm：PROC / prologue / 参数装载 / 指令 / epilogue。
// 帧大小 = (最大寄存器 + 最大槽) * 8，对齐 16。
函数 生成函数(函数IR 函数信息, 向量<字符串> 输出) -> 空类型 {
    整64 最大寄存器 = 0
    整64 最大槽 = 0
    扫描函数(函数信息, &最大寄存器, &最大槽)
    整64 帧大小 = (最大寄存器 + 最大槽) * 8 + 8
    整64 对齐 = 帧大小 % 16
    如果 (对齐 != 0) { 帧大小 = 帧大小 + (16 - 对齐) }
    // PROC 头（中文符号经 nameMangle 修饰为 ASCII，MASM 可汇编）
    字符串 函数名 = 符号修饰(驻留文本(整64(函数信息.名字)))
    结果<空类型, 整32> 加1 = 输出.追加(函数名 + " PROC")
    结果<空类型, 整32> 加2 = 输出.追加("    push rbp")
    结果<空类型, 整32> 加3 = 输出.追加("    mov rbp, rsp")
    结果<空类型, 整32> 加4 = 输出.追加("    sub rsp, " + 整数转字符串(帧大小))
    // Win x64 参数装载：参数槽 1.. 从 rcx/rdx/r8/r9（槽 1 -> rcx 等）
    整64 参数槽位 = 1
    如果 (参数槽位 <= 函数信息.参数槽.大小()) {
        结果<空类型, 整32> 加5 = 输出.追加("    mov " + 变量槽(参数槽位, 最大寄存器) + ", rcx")
        参数槽位++
    }
    如果 (参数槽位 <= 函数信息.参数槽.大小()) {
        结果<空类型, 整32> 加5 = 输出.追加("    mov " + 变量槽(参数槽位, 最大寄存器) + ", rdx")
        参数槽位++
    }
    如果 (参数槽位 <= 函数信息.参数槽.大小()) {
        结果<空类型, 整32> 加5 = 输出.追加("    mov " + 变量槽(参数槽位, 最大寄存器) + ", r8")
        参数槽位++
    }
    如果 (参数槽位 <= 函数信息.参数槽.大小()) {
        结果<空类型, 整32> 加5 = 输出.追加("    mov " + 变量槽(参数槽位, 最大寄存器) + ", r9")
        参数槽位++
    }
    // 指令
    整64 i = 0
    当 (i < 函数信息.指令.大小()) {
        IR指令 指令 = 函数信息.指令.元素(i)
        生成指令(指令, 最大寄存器, 输出)
        i++
    }
    // epilogue：返回 指令 已 mov rax；此处统一 ret
    结果<空类型, 整32> 加6 = 输出.追加("    mov rsp, rbp")
    结果<空类型, 整32> 加7 = 输出.追加("    pop rbp")
    结果<空类型, 整32> 加8 = 输出.追加("    ret")
    结果<空类型, 整32> 加9 = 输出.追加(函数名 + " ENDP")
    结果<空类型, 整32> 加10 = 输出.追加("")
}

// ==================== 程序入口 ====================
// 程序IR -> asm 行列表（每个函数一个 PROC）。
函数 代码生成(程序IR 程序) -> 向量<字符串> {
    向量<字符串> 输出 = 向量<字符串>()
    结果<空类型, 整32> 头1 = 输出.追加("; 由 v2 代码生成（P6）生成")
    结果<空类型, 整32> 段 = 输出.追加(".code")
    整64 f = 0
    当 (f < 程序.函数们.大小()) {
        生成函数(程序.函数们.元素(f), 输出)
        f++
    }
    结果<空类型, 整32> 尾 = 输出.追加("END")
    返回 输出
}
