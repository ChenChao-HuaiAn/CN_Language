// 协议常量·格式化占位符共用设施（#1910·001 §10.6 编译期配对立法 2026-11-02）
// 职责：格式化 格式串的占位符扫描+配对判定+诊断文案组装——**中立层单点**
//   （跨层共性下沉：语义层执法〔语义检查格式化配对.cn〕与 IR 层 128 改写
//   〔生成表达式求值中.cn〕共用，禁两层各抄一份=重复归纳纪律）。
//   与宿主 scanFormatPlaceholders/argMatchesPlaceholder/pairingHint
//   （ir_call_builtin.cpp）逐字对齐。
导入 容器::向量;

公开:

// 占位符扫描（闭集穷举·001 §10.6）：与宿主 scanFormatPlaceholders 同构——
//   "%%"=字面 %（无坑原样保留）；%d128/%u128=128 位面（改写 %s·最长匹配先于
//   单符，"%d128" 恒解析为 d128=条文裁决语义）。返回 假=存在表外占位符
//   （坏占位符=占位符原文如 "%q" 或悬空 "%"）。
函数 扫描格式化占位符(字符串 格式串, 向量<字符串>& 种类们,
                    字符串& 改写串, 字符串& 坏占位符) -> 布尔 {
    整64 i = 0;
    整64 长 = 字符串长度(格式串);
    当 (i < 长) {
        整64 c = 整64(格式串[整32(i)]) & 255;
        如果 (c != 整64('%')) {
            改写串 = 字符串连接(改写串, 字符串子串(格式串, 整32(i), 1));
            i++;
            继续;
        }
        // 128/64 位面（最长匹配：d128/u128〔4 字符〕与 d64/u64〔3 字符〕先于单符 d/u）
        布尔 宽面命中 = 假;
        如果 (i + 5 <= 长) {
            字符串 四字 = 字符串子串(格式串, 整32(i + 1), 4);
            如果 (字符串比较(四字, "d128") || 字符串比较(四字, "u128")) {
                结果<空类型, 整32> 加种 = 种类们.追加(四字);
                如果 (!加种.正常) { 运行时错误(4); }
                改写串 = 字符串连接(改写串, "%s");
                i = i + 5;
                宽面命中 = 真;
            }
        }
        如果 (!宽面命中) {
            如果 (i + 4 <= 长) {
                字符串 三字 = 字符串子串(格式串, 整32(i + 1), 3);
                如果 (字符串比较(三字, "d64") || 字符串比较(三字, "u64")) {
                    结果<空类型, 整32> 加种64 = 种类们.追加(三字);
                    如果 (!加种64.正常) { 运行时错误(4); }
                    改写串 = 字符串连接(改写串, "%s");
                    i = i + 4;
                    宽面命中 = 真;
                }
            }
        }
        如果 (宽面命中) { 继续; }
        如果 (i + 1 < 长) {
            整64 下一 = 整64(格式串[整32(i + 1)]) & 255;
            如果 (下一 == 整64('%')) {   // 字面 %：无坑原样
                改写串 = 字符串连接(改写串, "%%");
                i = i + 2;
                继续;
            }
            // 单符面：支持 C 风格标志/宽度/精度前缀（%.2f、%5d——存量 212
            //   用例 %.2f 实证合法面·001 §10.6 条文同轮补列），配对按最终
            //   转换符判定；前缀段在改写串中原样保留（vsnprintf 消费）。
            整64 段起 = i;
            整64 扫 = i + 1;
            当 (扫 < 长) {   // 标志位 [-+ #0]（拦截分支形态·中断在 如果 内）
                整64 标 = 整64(格式串[整32(扫)]) & 255;
                如果 (!(标 == 整64('-') || 标 == 整64('+') || 标 == 整64(' ') ||
                        标 == 整64('#') || 标 == 整64('0'))) {
                    中断;
                }
                扫++;
            }
            当 (扫 < 长) {   // 宽度
                整64 宽 = 整64(格式串[整32(扫)]) & 255;
                如果 (!(宽 >= 整64('0') && 宽 <= 整64('9'))) { 中断; }
                扫++;
            }
            如果 (扫 < 长) {   // 精度
                整64 点 = 整64(格式串[整32(扫)]) & 255;
                如果 (点 == 整64('.')) {
                    扫++;
                    当 (扫 < 长) {
                        整64 精 = 整64(格式串[整32(扫)]) & 255;
                        如果 (!(精 >= 整64('0') && 精 <= 整64('9'))) { 中断; }
                        扫++;
                    }
                }
            }
            布尔 单符命中 = 假;
            如果 (扫 < 长) {
                整64 换 = 整64(格式串[整32(扫)]) & 255;
                如果 (换 == 整64('d') || 换 == 整64('u') || 换 == 整64('f') ||
                     换 == 整64('s') || 换 == 整64('c') || 换 == 整64('x') ||
                     换 == 整64('X') || 换 == 整64('o') || 换 == 整64('p')) {
                    结果<空类型, 整32> 加单 = 种类们.追加(
                        字符串子串(格式串, 整32(扫), 1));
                    如果 (!加单.正常) { 运行时错误(4); }
                    改写串 = 字符串连接(改写串, 字符串子串(
                        格式串, 整32(段起), 整32(扫 - 段起 + 1)));
                    i = 扫 + 1;
                    单符命中 = 真;
                }
            }
            如果 (单符命中) { 继续; }
            坏占位符 = 字符串子串(格式串, 整32(段起), 整32(长 - 段起));
            返回 假;
        }
        坏占位符 = "%";
        返回 假;
    }
    返回 真;
}

// 占位符种类 × 实参类型文本 合法配对表（闭集穷举·语义层口径——类型文本为
//   CN 名；%s/%p 指针族宽配=宿主 IR ptr 宽配同口径（类型文本含 '*' 即指针面）；
//   %c 宽配 整32=字符与整32 同 IR 型分辨率极限）。
函数 格式化占位符配实参合法(字符串 种类, 字符串 类型文本) -> 布尔 {
    如果 (字符串比较(种类, "d") || 字符串比较(种类, "x") ||
         字符串比较(种类, "X") || 字符串比较(种类, "o")) {
        返回 字符串比较(类型文本, "整8") || 字符串比较(类型文本, "整16") ||
              字符串比较(类型文本, "整32");
    }
    如果 (字符串比较(种类, "u")) {
        返回 字符串比较(类型文本, "正8") || 字符串比较(类型文本, "正16") ||
              字符串比较(类型文本, "正32");
    }
    如果 (字符串比较(种类, "f")) {
        返回 字符串比较(类型文本, "浮32") || 字符串比较(类型文本, "浮64");
    }
    如果 (字符串比较(种类, "s") || 字符串比较(种类, "p")) {
        返回 字符串比较(类型文本, "字符串") || 字符串比较(类型文本, "字符*") ||
              字符串包含(类型文本, "*");
    }
    如果 (字符串比较(种类, "c")) {
        返回 字符串比较(类型文本, "整32") || 字符串比较(类型文本, "字符");
    }
    如果 (字符串比较(种类, "d64")) { 返回 字符串比较(类型文本, "整64"); }
    如果 (字符串比较(种类, "u64")) { 返回 字符串比较(类型文本, "正64"); }
    如果 (字符串比较(种类, "d128")) { 返回 字符串比较(类型文本, "整128"); }
    如果 (字符串比较(种类, "u128")) { 返回 字符串比较(类型文本, "正128"); }
    返回 假;   // 种类表外=扫描已拒（不可达面）
}

// 实参类型显示文本（诊断文案用·与宿主 irTypeCnName 对齐：指针族归一「指针」，
//   其余 CN 类型名原样——两侧文案逐字一致）。
函数 格式化类型显示文本(字符串 类型文本) -> 字符串 {
    如果 (字符串包含(类型文本, "*")) { 返回 "指针"; }
    返回 字符串复制(类型文本);   // 拥有契约：参数=借用视图·落堆返回
}

// 配对指路文案（与宿主 pairingHint 逐字对齐·64/128 位面方案甲 2026-11-02）。
函数 格式化配对指路(字符串 种类, 字符串 类型文本) -> 字符串 {
    如果 (字符串比较(种类, "d") && 字符串比较(类型文本, "整128")) {
        返回 "（整128 请用 %d128）";
    }
    如果 (字符串比较(种类, "u") && 字符串比较(类型文本, "正128")) {
        返回 "（正128 请用 %u128）";
    }
    如果 (字符串比较(种类, "d") && 字符串比较(类型文本, "整64")) {
        返回 "（整64 请用 %d64）";
    }
    如果 (字符串比较(种类, "u") && 字符串比较(类型文本, "正64")) {
        返回 "（正64 请用 %u64）";
    }
    如果 (字符串比较(类型文本, "整64") || 字符串比较(类型文本, "正64")) {
        返回 "（整64/正64 请用 %d64/%u64）";
    }
    返回 "";
}
