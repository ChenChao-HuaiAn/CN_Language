// CN 自举编译器 v2 · 命令行解析辅助（1272 自主.cn 机械搬移，函数体逐字保留）
// 职责：-O 优化级别扫描（345-a D33 根治·宿主 cn_main -O 枚举同构）与目标平台
//   解析/校验（plans/017 T2）+ 第 3 参数 --verbose 诊断分级开关（R2）。
// 层位：协议常量包（中立纯函数，仅消费系统内置参数与同包 设详细诊断）。
// 1272 审查 P2 登记豁免：argv 解析职责暂置本中立包（主流程调用；迁驱动层会引入
//   驱动→协议常量/词法的跨层依赖，违背 334 冻结线；本文件零包依赖仅 stdlib）。
公开:

// 优化级别旗标扫描：扫全部命令行参数，识别 -O0/-O1/-O2/-O3；-O 形态但非法
//   （-O9/-Ox/单独 -O）=诊断+返回 -1（调用方退出 1——宿主对「多余参数」报错
//   同款拒绝语义）；非 -O 参数忽略（入口/平台/--verbose 各安其位）。
//   返回 0~3=级别；-1=非法形态（已诊断）。
函数 扫描优化级别() -> 整64 {
    整64 级别 = 0;
    整64 序 = 1;
    当 (序 < 系统::参数个数()) {
        字符* 参数文本 = 系统::参数(序);
        如果 (参数文本 != 无) {
            字符串 值 = 字符串复制(参数文本);   // 借用→显式复制（A2 收紧）
            如果 (字符串长度(值) >= 2 && 字符串长度(值) <= 4294967296) {
                字符串 前缀 = 字符串子串(值, 0, 2);
                如果 (字符串比较(前缀, "-O")) {
                    如果 (字符串长度(值) == 3) {
                        整64 级别字节 = 整64(值[2]) & 255;
                        如果 (级别字节 >= 48 && 级别字节 <= 51) {
                            级别 = 级别字节 - 48;   // '0'..'3'
                        } 否则 {
                            IO::打印到错误("错误: 非法优化级别旗标 " + 值 +
                                           "（支持 -O0/-O1/-O2/-O3）\n");
                            返回 -1;
                        }
                    } 否则 {
                        IO::打印到错误("错误: 非法优化级别旗标 " + 值 +
                                       "（支持 -O0/-O1/-O2/-O3）\n");
                        返回 -1;
                    }
                }
            }
        }
        序++;
    }
    返回 级别;
}

// 目标平台解析与校验（R3 拆分）：参数 2 平台 + 未知平台显式报错（plans/017 T2）
//   + 参数 3 --verbose 诊断分级开关（R2）。校验失败返回 空串（主干退出 1）。
函数 解析目标平台() -> 字符串 {
    字符串 目标平台 = "win-x64";
    如果 (系统::参数个数() >= 3 && 系统::参数个数() <= 2147483647) {
        // 70-a：系统::参数=字符* 借用——赋入 字符串 变量须显式 复制（A2 收紧）
        字符* 目标值 = 系统::参数(2);
        如果 (目标值 != 无) {
            目标平台 = 字符串复制(目标值);
        }
    }
    // 目标平台校验（plans/017 T2）：未知平台显式报错退出——防静默落 win 分支产错目标产物
    如果 (!字符串比较(目标平台, "linux-arm64") && !字符串比较(目标平台, "linux-x86_64") &&
        !字符串比较(目标平台, "win-x64")) {
        IO::打印到错误("[cga] 未知目标平台: " + 目标平台 +
                       "（应为 win-x64 / linux-arm64 / linux-x86_64），中止编译\n");
        返回 "";
    }
    // R2 诊断分级（2026-09-08）：第 3 参数 --verbose 开启内部进度诊断——默认
    //   静默（零输出税）；错误路径诊断不受开关（对外契约）
    如果 (系统::参数个数() >= 4 && 系统::参数个数() <= 2147483647) {
        // 70-a：系统::参数=字符* 借用（字符串比较 同码按字符串消费）
        字符* 诊断值 = 系统::参数(3);
        如果 (诊断值 != 无 && 字符串比较(诊断值, "--verbose")) {
            设详细诊断(真);
        }
    }
    返回 目标平台;
}
