// CN 自举编译器 v2：stdlib 泛型类签名扫描（自举重建 P7b 项1，2026-09-01）
// 用户裁决：解析 stdlib 建签名表，替代 IR容器 硬编码 if 链——stdlib 改签名/加方法
// v2 自动跟随（维护契约消除）。惰性加载：查方法签名 未命中时读
// stdlib/容器.cn + stdlib/映射集合.cn，token 级状态机提取泛型类方法签名
//（类头 类型参数序 / 方法 参数类型串 / 返回类型原文），查询时按实例实参
// 替换 T/K/V。本模块只提取签名不生成代码（泛型类完整解析仍属后续阶段）。
// 依赖：词法分析.分词（token 流）+ 文件 读取（主.cn 读源文件 同款模式）。
导入 容器::向量
导入 映射集合
导入 词法分析
导入 文件::打开文件
导入 文件::读取文件行
导入 文件::关闭文件

公开:

// ==================== 合成名分段辅助（$ 拆分） ====================
// 首 '$' 位置（无 $ 返回 -1）——'$' = 0x24 字节
函数 首分段位置(字符串 名) -> 整64 {
    整64 i = 0
    当 (i < 字符串长度(名)) {
        整64 字节 = 整64(名[i])
        如果 (字节 < 0) { 字节 = 字节 + 256 }
        如果 (字节 == 36) { 返回 i }
        i++
    }
    返回 -1
}

// 合成名基名：首个 $ 前（无 $ 返回全名）——向量$整64 -> 向量
函数 合成名基名(字符串 名) -> 字符串 {
    整64 位置 = 首分段位置(名)
    如果 (位置 < 0) { 返回 名 }
    返回 字符串子串(名, 0, 位置)
}

// 合成名首实参：首个 $ 后全部（嵌套实参整段，如 映射$整64$符号）
函数 合成名首实参(字符串 名) -> 字符串 {
    整64 位置 = 首分段位置(名)
    如果 (位置 < 0) { 返回 "" }
    返回 字符串子串(名, 位置 + 1, 字符串长度(名) - 位置 - 1)
}

// 段首：s 首个 $ 前；段余：首个 $ 后（映射 的 K / V）
函数 段首(字符串 名) -> 字符串 {
    整64 位置 = 首分段位置(名)
    如果 (位置 < 0) { 返回 名 }
    返回 字符串子串(名, 0, 位置)
}
函数 段余(字符串 名) -> 字符串 {
    整64 位置 = 首分段位置(名)
    如果 (位置 < 0) { 返回 "" }
    返回 字符串子串(名, 位置 + 1, 字符串长度(名) - 位置 - 1)
}

// ==================== 签名表（静态，任务级生命周期） ====================
静态 映射<整64, 整64> 签名参数串们    // 键ID(基名.方法名.参数个数) -> 参数串ID（原文）
静态 映射<整64, 整64> 签名返回们      // 键ID -> 返回类型文本ID（原文，含 <...>）
静态 映射<整64, 整64> 类类型参数们    // 基名ID -> 类型参数串ID（如 "T" / "K,V"）

// 读源文件全文（打开模式 1=读 + 读行拼接）
函数 签名读文件(字符串 路径) -> 字符串 {
    字符串 内容 = ""
    结果<空类型*, 整32> 打开 = 打开文件(路径, 1)
    如果 (打开.正常) {
        当 (真) {
            结果<字符串, 整32> 行 = 文件::读取文件行(打开.值)
            如果 (行.正常) {
                内容 = 内容 + 行.值 + "\n"
            } 否则 {
                中断
            }
        }
        关闭文件(打开.值)
    }
    返回 内容
}

// ==================== 扫描器（token 状态机） ====================
// 扫描一个文件的泛型类方法签名：泛型 <类型 参数...> 类 名 { 私有:/公开: 段内
//   函数|常量 函数|~ 名(参数) [-> 返回] {体跳过}；泛型自由函数整段跳过。
函数 扫描签名文件(字符串 路径) -> 空类型 {
    字符串 源码 = 签名读文件(路径)
    如果 (字符串长度(源码) == 0) {
        IO::打印到错误("[ir2] 签名扫描打开失败: " + 路径 + "\n")
        返回
    }
    向量<Token> 记号 = 向量<Token>()
    分词(源码, 记号)
    整64 i = 0
    整64 n = 记号.大小()
    当 (i < n) {
        Token 头 = 记号.元素(整32(i))
        // 注意：v2 词法关键字表无「泛型」——泛型/类/函数/常量 按文本匹配不限令牌类型
        //   （否则关键字表差异导致整文件跳过、表空，实测踩坑）
        如果 (头.文本 != 整32(驻留("泛型"))) {
            i++
            继续
        }
        i++
        // 类型参数序（< ... > 内标识符，逗号连接）
        字符串 参数序 = ""
        如果 (i < n && 记号.元素(整32(i)).类型 == 令牌_运算符 &&
             记号.元素(整32(i)).文本 == 整32(驻留("<"))) {
            i++
            当 (i < n) {
                Token tk = 记号.元素(整32(i))
                如果 (tk.类型 == 令牌_运算符 && tk.文本 == 整32(驻留(">"))) {
                    i++
                    中断
                }
                // 「类型」是参数声明引导词（泛型 <类型 T, 类型 K>）——跳过，
                //   只收类型参数名（否则参数序多一段、命中错位，实测踩坑）
                如果 (tk.类型 == 令牌_标识符 && tk.文本 != 整32(驻留("类型"))) {
                    如果 (字符串长度(参数序) > 0) { 参数序 = 参数序 + "," }
                    参数序 = 参数序 + 驻留文本(整64(tk.文本))
                }
                i++
            }
        }
        // 泛型类 / 泛型自由函数 分流
        如果 (!(i < n && 记号.元素(整32(i)).文本 == 整32(驻留("类")))) {
            // 泛型自由函数：跳签名行与体
            当 (i < n && !(记号.元素(整32(i)).类型 == 令牌_运算符 &&
                    (记号.元素(整32(i)).文本 == 整32(驻留(";")) ||
                     记号.元素(整32(i)).文本 == 整32(驻留("{"))))) {
                i++
            }
            如果 (i < n && 记号.元素(整32(i)).文本 == 整32(驻留("{"))) {
                i++
                整64 d = 1
                当 (i < n && d > 0) {
                    如果 (记号.元素(整32(i)).类型 == 令牌_运算符) {
                        整64 b2 = 整64(记号.元素(整32(i)).文本)
                        如果 (b2 == 驻留("{")) { d++ }
                        否则 如果 (b2 == 驻留("}")) { d-- }
                    }
                    i++
                }
            } 否则 如果 (i < n) {
                i++
            }
            继续
        }
        // ---- 泛型类 ----
        i++
        如果 (i >= n || 记号.元素(整32(i)).类型 != 令牌_标识符) { 返回 }
        整64 基名ID = 整64(记号.元素(整32(i)).文本)
        i++
        当 (i < n && !(记号.元素(整32(i)).类型 == 令牌_运算符 &&
                记号.元素(整32(i)).文本 == 整32(驻留("{")))) {
            i++
        }
        如果 (i >= n) { 返回 }
        i++
        结果<空类型, 整32> 加序 = 类类型参数们.设置(基名ID, 驻留(参数序))
        如果 (!加序.正常) { 运行时错误(4) }
        // 类体：方法签名提取
        整64 类深 = 1
        当 (i < n && 类深 > 0) {
            Token t1 = 记号.元素(整32(i))
            布尔 是方法 = 假
            字符串 方法名 = ""
            如果 (t1.文本 == 整32(驻留("常量")) &&
                 i + 1 < n && 记号.元素(整32(i + 1)).文本 == 整32(驻留("函数"))) {
                是方法 = 真
                i = i + 2
            } 否则 如果 (t1.文本 == 整32(驻留("函数"))) {
                是方法 = 真
                i++
            } 否则 如果 (t1.类型 == 令牌_运算符 && t1.文本 == 整32(驻留("~")) &&
                      i + 1 < n && 记号.元素(整32(i + 1)).类型 == 令牌_标识符) {
                是方法 = 真
                方法名 = "~" + 驻留文本(整64(记号.元素(整32(i + 1)).文本))
                i = i + 2
            }
            如果 (!是方法) {
                如果 (t1.类型 == 令牌_运算符) {
                    如果 (t1.文本 == 整32(驻留("{"))) { 类深++ }
                    否则 如果 (t1.文本 == 整32(驻留("}"))) { 类深-- }
                }
                i++
                继续
            }
            // 方法名（~ 分支已取）
            如果 (字符串长度(方法名) == 0) {
                如果 (i < n && 记号.元素(整32(i)).类型 == 令牌_标识符) {
                    方法名 = 驻留文本(整64(记号.元素(整32(i)).文本))
                    i++
                } 否则 {
                    i++
                    继续
                }
            }
            // 参数列表：类型[后缀] 名，逗号分隔；后缀含 & / * / <平衡>
            字符串 参数串 = ""
            整64 参数个数 = 0
            如果 (i < n && 记号.元素(整32(i)).类型 == 令牌_运算符 &&
                 记号.元素(整32(i)).文本 == 整32(驻留("("))) {
                i++
                当 (i < n) {
                    Token t2 = 记号.元素(整32(i))
                    如果 (t2.类型 == 令牌_运算符 && t2.文本 == 整32(驻留(")"))) {
                        i++
                        中断
                    }
                    如果 (t2.类型 != 令牌_标识符) {
                        i++
                        继续
                    }
                    字符串 类型文本 = 驻留文本(整64(t2.文本))
                    i++
                    布尔 后缀完 = 假
                    当 (i < n && !后缀完 && 记号.元素(整32(i)).类型 == 令牌_运算符) {
                        整64 后符号 = 整64(记号.元素(整32(i)).文本)
                        如果 (后符号 == 驻留("&")) {
                            类型文本 = 类型文本 + "&"
                            i++
                            后缀完 = 真
                        } 否则 如果 (后符号 == 驻留("*")) {
                            类型文本 = 类型文本 + "*"
                            i++
                            后缀完 = 真
                        } 否则 如果 (后符号 == 驻留("<")) {
                            整64 泛深 = 0
                            当 (i < n) {
                                Token g1 = 记号.元素(整32(i))
                                如果 (g1.类型 == 令牌_运算符 && 整64(g1.文本) == 驻留("<")) {
                                    泛深++
                                    类型文本 = 类型文本 + "<"
                                } 否则 如果 (g1.类型 == 令牌_运算符 && 整64(g1.文本) == 驻留(">")) {
                                    泛深--
                                    类型文本 = 类型文本 + ">"
                                    如果 (泛深 == 0) { i++; 中断 }
                                } 否则 如果 (g1.类型 == 令牌_标识符) {
                                    类型文本 = 类型文本 + 驻留文本(整64(g1.文本))
                                } 否则 如果 (g1.类型 == 令牌_运算符 && 整64(g1.文本) == 驻留(",")) {
                                    类型文本 = 类型文本 + ","
                                }
                                i++
                            }
                        } 否则 {
                            后缀完 = 真
                        }
                    }
                    // 参数名
                    如果 (i < n && 记号.元素(整32(i)).类型 == 令牌_标识符) { i++ }
                    如果 (参数个数 > 0) { 参数串 = 参数串 + "," }
                    参数串 = 参数串 + 类型文本
                    参数个数++
                }
            }
            // 返回类型：-> 类型[<平衡>]
            字符串 返回文本 = "空类型"
            如果 (i + 1 < n && 记号.元素(整32(i)).类型 == 令牌_运算符 &&
                 记号.元素(整32(i)).文本 == 整32(驻留("->"))) {
                i++
                如果 (i < n && 记号.元素(整32(i)).类型 == 令牌_标识符) {
                    返回文本 = 驻留文本(整64(记号.元素(整32(i)).文本))
                    i++
                    如果 (i < n && 记号.元素(整32(i)).类型 == 令牌_运算符 &&
                         记号.元素(整32(i)).文本 == 整32(驻留("<"))) {
                        整64 泛深2 = 0
                        当 (i < n) {
                            Token g2 = 记号.元素(整32(i))
                            如果 (g2.类型 == 令牌_运算符 && 整64(g2.文本) == 驻留("<")) {
                                泛深2++
                                返回文本 = 返回文本 + "<"
                            } 否则 如果 (g2.类型 == 令牌_运算符 && 整64(g2.文本) == 驻留(">")) {
                                泛深2--
                                返回文本 = 返回文本 + ">"
                                如果 (泛深2 == 0) { i++; 中断 }
                            } 否则 如果 (g2.类型 == 令牌_标识符) {
                                返回文本 = 返回文本 + 驻留文本(整64(g2.文本))
                            } 否则 如果 (g2.类型 == 令牌_运算符 && 整64(g2.文本) == 驻留(",")) {
                                返回文本 = 返回文本 + ","
                            }
                            i++
                        }
                    }
                }
            }
            整64 键ID = 驻留(驻留文本(基名ID) + "." + 方法名 + "." + 整数转字符串(参数个数))
            结果<空类型, 整32> 加参 = 签名参数串们.设置(键ID, 驻留(参数串))
            如果 (!加参.正常) { 运行时错误(4) }
            结果<空类型, 整32> 加返 = 签名返回们.设置(键ID, 驻留(返回文本))
            如果 (!加返.正常) { 运行时错误(4) }
            // 跳方法体（{ 平衡 }；中途遇 } 使 类深-- ——类体提前结束）
            当 (i < n && !(记号.元素(整32(i)).类型 == 令牌_运算符 &&
                    记号.元素(整32(i)).文本 == 整32(驻留("{")))) {
                如果 (记号.元素(整32(i)).类型 == 令牌_运算符 &&
                     记号.元素(整32(i)).文本 == 整32(驻留("}"))) {
                    类深--
                }
                i++
                如果 (i >= n) { 返回 }
            }
            如果 (i >= n) { 返回 }
            i++
            整64 体深 = 1
            当 (i < n && 体深 > 0) {
                如果 (记号.元素(整32(i)).类型 == 令牌_运算符) {
                    整64 b = 整64(记号.元素(整32(i)).文本)
                    如果 (b == 驻留("{")) { 体深++ }
                    否则 如果 (b == 驻留("}")) { 体深-- }
                }
                i++
            }
        }
    }
}

// 确保签名表已加载（幂等；含 链表/栈/队列/集合 后续 stdlib 文件在此追加）
函数 确保签名已加载() -> 空类型 {
    结果<整64, 整32> 查 = 签名参数串们.获取(驻留("已加载"))
    如果 (!查.正常) {
        扫描签名文件("stdlib/容器.cn")
        扫描签名文件("stdlib/映射集合.cn")
        结果<空类型, 整32> 标记 = 签名参数串们.设置(驻留("已加载"), 驻留("1"))
        如果 (!标记.正常) { 运行时错误(4) }
    }
}

// 结果类型名归一：扫描器收集的源码形态 结果<空类型,整32> -> 合成名 结果$空类型$整32
//   （v2 全链路是结果类型 判定基于 $ 合成名；< > , 一律换 $）
函数 归一结果名(字符串 名) -> 字符串 {
    字符串 出 = ""
    整64 i = 0
    当 (i < 字符串长度(名)) {
        整64 字节 = 整64(名[i])
        如果 (字节 < 0) { 字节 = 字节 + 256 }
        如果 (字节 == 60 || 字节 == 62 || 字节 == 44) {   // < > ,
            出 = 出 + "$"
        } 否则 {
            出 = 出 + 字符串子串(名, i, 1)
        }
        i++
    }
    返回 出
}

// ==================== 类型参数替换 ====================
// 文本中每个标识符词：等于类模板类型参数名（类头参数序的独立段）-> 换为实例
//   实参列表对应段（②c A：实参们 由 IR容器.取实例实参们 按基名元数切分——
//   嵌套实参整段还原，如 向量$映射$整64$整64 的 T -> 映射$整64$整64）；
//   & / * / <...> 后缀原样保留。
函数 替换类型参数带段们(字符串 文本, 字符串 序串, 向量<字符串> 实参们) -> 字符串 {
    字符串 出 = ""
    整64 i = 0
    整64 n = 字符串长度(文本)
    当 (i < n) {
        // 取当前位置标识符词
        整64 j = i
        字符串 词 = ""
        当 (j < n) {
            整64 字节 = 整64(文本[j])
            如果 (字节 < 0) { 字节 = 字节 + 256 }
            布尔 词字节 = 字节 >= 128 || (字节 >= 65 && 字节 <= 90) ||
                          (字节 >= 97 && 字节 <= 122) || 字节 == 95
            如果 (词字节) {
                词 = 词 + 字符串子串(文本, j, 1)
                j++
            } 否则 {
                中断
            }
        }
        如果 (字符串长度(词) == 0) {
            出 = 出 + 字符串子串(文本, i, 1)
            i++
            继续
        }
        // 词是否命中参数序第 k 段
        整64 命中序 = -1
        整64 段起 = 0
        整64 k = 0
        整64 实参序 = 0
        当 (k <= 字符串长度(序串)) {
            布尔 边 = k == 字符串长度(序串)
            如果 (!边) {
                整64 c = 整64(序串[k])
                如果 (c < 0) { c = c + 256 }
                如果 (c == 44) { 边 = 真 }
            }
            如果 (边) {
                字符串 段 = 字符串子串(序串, 段起, k - 段起)
                如果 (字符串比较(段, 词)) { 命中序 = 实参序 }
                段起 = k + 1
                实参序++
            }
            k++
        }
        布尔 已换 = 假
        如果 (命中序 >= 0 && 命中序 < 实参们.大小()) {
            出 = 出 + 实参们.元素(命中序)
            已换 = 真
        }
        如果 (!已换) { 出 = 出 + 词 }
        i = j
    }
    返回 出
}
