// CN 自举编译器 v2 · 生成语句（千行拆分子模块，2026-09-08 用户裁决阶段目录包）
// 职责：语句遍历（生成语句）+ 块遍历与控制流生成（生成块/生成如果/生成当）
//   ——自 IR生成.cn 机械搬移；寄存器/引用参数等权威表经 公开: 访问函数
//   （IR生成 主干）；模块路径=生成语句（新键基）。
导入 容器::向量;
导入 语法;       // Token/AST 节点池（原 导入 语法分析，目录包名）
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码（目录包名）
导入 IR生成;     // 控制流辅助/变量类型权威表（同包幂等）
导入 生成声明;    // 语句级变量声明分派（R3 拆分，同包）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）
// D1 行数整改 121-a：自 生成语句.cn 按族拆出——语句遍历辅助（取参数段 + 方法段名 + 是借出方法名85 + 方法类名85 + 是借用来源返回）（纯重构零行为变更）

// ==================== 语句遍历 ====================
// 取参数串第 段序 段（',' 分隔，0 起；越界返回 空串）——②b 结构体实参判定用
//   （局部实现避免 代码生成共用 导入环：共用层依赖本模块）
函数 取参数段(字符串 参数串, 整64 段序) -> 字符串 {
    // T69（480-a）：段边界=**深度 0 处的 ','**（'('(40) 入 / ')'(41) 出）——
    //   函数指针类型文本 `函数指针<返回>(参数1,参数2)` 内层逗号不切段；
    //   非括号参数串逐字节等价旧行为。
    //   ⚠ 实现纪律：**不得**经局部 向量<字符串> 中转取段——返回容器元素=返回
    //   局部向量的元素句柄（函数出口析构=悬垂），E2E 124 段错误实证（改回
    //   直接子串构造）。此函数为生成期热路径，零分配亦为性能要求。
    整64 起点480 = 0;
    整64 段480 = 0;
    整64 深度480 = 0;
    整64 i480 = 0;
    当 (i480 <= 字符串长度(参数串)) {
        布尔 边界480 = i480 == 字符串长度(参数串);
        如果 (!边界480) {
            整64 字节480 = 整64(参数串[i480]) & 255;
            如果 (字节480 == 40) { 深度480++; }
            否则 如果 (字节480 == 41) {
                如果 (深度480 > 0) { 深度480--; }
            } 否则 如果 (字节480 == 44) {
                如果 (深度480 == 0) { 边界480 = 真; }
            }
        }
        如果 (边界480) {
            如果 (段480 == 段序) {
                返回 字符串子串(参数串, 起点480, i480 - 起点480);
            }
            起点480 = i480 + 1;
            段480++;
        }
        i480++;
    }
    返回 "";
}

// 85-a：方法名的「方法段」提取（形如 向量$盒子$元素#整64 → 元素；非方法名原样返回）
//   ——借出视图方法豁免判定用（与宿主 ir_fields.cpp 的 last-segment 提取同口径）。
函数 方法段名(字符串 全名) -> 字符串 {
    整64 终 = 字符串长度(全名);
    整64 i = 0;
    当 (i < 字符串长度(全名)) {
        如果 (整64(全名[i]) == 35) { 终 = i; 中断; }   // 先截掉 #参数串
        i++;
    }
    整64 段起 = 0;
    整64 j = 0;
    当 (j < 终) {
        如果 (整64(全名[j]) == 36) { 段起 = j + 1; }   // 最后一个 $ 之后=方法段
        j++;
    }
    返回 字符串子串(全名, 段起, 终 - 段起);
}

// 85-a：借出视图方法名判定（**与 语义/借出检查.cn 是借出方法名 同清单**——IR 层
//   不得反向依赖 语义 层，故此处并列一份；清单变更须两处同步）。
//   容器元素读出接口：向量/链表=元素/读取/头部元素/读取头部/读取尾部；栈=栈顶；
//   队列=队首；映射=获取。
函数 是借出方法名85(字符串 名) -> 布尔 {
    返回 字符串比较(名, "元素") || 字符串比较(名, "读取") ||
           字符串比较(名, "栈顶") || 字符串比较(名, "队首") ||
           字符串比较(名, "头部元素") || 字符串比较(名, "读取头部") ||
           字符串比较(名, "读取尾部") || 字符串比较(名, "获取");
}

// 86-a（2026-09-12 复审缺陷③）：方法名的「类段」提取（形如 向量$盒子$元素#整64 →
//   向量$盒子；无 $ 的非方法名返回 ""）——豁免的**容器类型约束**用。
//   背景：P44 实证 用户顶层函数恰名 获取 + 返回 借用形参 → 纯名字匹配被误豁免
//   深拷 → 句柄共享悬垂乱码（两侧同现）。宿主侧同款约束（ir_fields.cpp：
//   isBorrowViewMethod + 所属类 ∈ 字符串元素容器/含串结构体元素容器/字符串值映射，
//   经 currentClass_ 判定）；v2 从函数名反解类段 + 是容器类 判定（等效：
//   调用点 资源字段数>0 前置使「元素不含串的容器」不进入豁免面）。
函数 方法类名85(字符串 全名) -> 字符串 {
    整64 终 = 字符串长度(全名);
    整64 i = 0;
    当 (i < 字符串长度(全名)) {
        如果 (整64(全名[i]) == 35) { 终 = i; 中断; }   // 先截掉 #参数串
        i++;
    }
    整64 末段 = -1;
    整64 j = 0;
    当 (j < 终) {
        如果 (整64(全名[j]) == 36) { 末段 = j; }   // 最后一个 $ 的位置
        j++;
    }
    如果 (末段 < 0) { 返回 ""; }
    返回 字符串子串(全名, 0, 末段);
}

// 85-a（2026-09-12 第八十五轮）：返回位「借用来源」判定（聚合返回位所有权保证）
//   ——与宿主 IRGenerator::isBorrowedAggregateSource 同口径：
//   · 成员/下标/解引用 = 借出（句柄归对象/数组元素/指针目标）；
//   · 标识符：在 参数槽（按值形参=调用方 place 的浅拷副本，借出视图）→ 借用；
//     在 局部槽（拥有局部）→ 拥有（所有权移出，零拷贝）；两者皆非
//     （全局/静态/类字段裸名）→ 借用；
//   · 其余（调用返回=拥有契约 / 结构体字面量 / 转换）= 拥有（零拷贝原路径）。
//   · **借出视图方法豁免**（77-a 清单）：容器元素读出接口设计上即返回借出视图
//     （调用方不登记释放，生命周期由 借出检查 保证）——Rust `Vec::get -> &T`
//     同款，返回值不得拥有化（拥有化=调用方“不释放”口径冲突 → 残留断言全失；
//     宿主侧 235/234/238/240 实测）。与语义层 A2 的「泛型单态化体内豁免」同理。
// 语义依据：Rust `-> T` 返回值必须有所有权——借用来源须 clone（CN 无显式聚合
//   复制语法，故编译期自动落堆；宿主同款）。
函数 是借用来源返回(向量<节点> 池, 函数IR& 函数信息, 节点 返回末, 映射<整64, 整64>& 参数槽,
                   映射<整64, 整64>& 局部槽) -> 布尔 {
    如果 (是借出方法名85(方法段名(驻留文本(整64(函数信息.名字)))) &&
        是容器类(方法类名85(驻留文本(整64(函数信息.名字))))) { 返回 假; }
    如果 (返回末.类型 == 节点_成员 || 返回末.类型 == 节点_下标 ||
        返回末.类型 == 节点_解引用) { 返回 真; }
    如果 (返回末.类型 == 节点_三元运算) {
        // 86-a（2026-09-12 复审缺陷①）：三元 = 借用来源的**透传包装**——两分支
        //   任一为借用来源即整体为借用（递归判定分支末节点）。主循环跳过构造值
        //   区间纪律（84-a）：分支区间 [文本, 附加) / [附加, 子终点)，末节点取值。
        //   原 default 判「非标识符 → 假」→ 按位 memcpy 直传 → 与选中 place 的
        //   句柄共享 → 悬垂（宿主侧乱码 / v2 侧 P41 段错误 rc=139 实证）。
        如果 (返回末.文本 < 返回末.附加) {
            节点 真末86 = 池.元素(整32(返回末.附加 - 1));
            如果 (是借用来源返回(池, 函数信息, 真末86, 参数槽, 局部槽)) { 返回 真; }
        }
        如果 (返回末.附加 < 返回末.子终点) {
            节点 假末86 = 池.元素(整32(返回末.子终点 - 1));
            如果 (是借用来源返回(池, 函数信息, 假末86, 参数槽, 局部槽)) { 返回 真; }
        }
        返回 假;
    }
    如果 (返回末.类型 != 节点_标识符) { 返回 假; }
    结果<整64, 整32> 查参85 = 参数槽.获取(整64(返回末.文本));
    如果 (查参85.正常) { 返回 真; }
    结果<整64, 整32> 查局85 = 局部槽.获取(整64(返回末.文本));
    如果 (查局85.正常) { 返回 假; }
    返回 真;   // 非局部绑定 = 全局/静态/类字段 → 借用
}

// 族③：返回公共尾段（原 322~362 段·194-a 族子方法；263① 轮自 生成语句.cn
//   机械搬移=纯搬运零行为变更·超标冻结文件腾行）——返回转移名ID 推导（P7b
//   RAII 跳过名）/A2 返回位字面量拥有化/容器析构/拥有串释放/数组串释放/返回
//   发射/跳尾块。值寄存器按值传入（A2 copy 落堆时换用 copy 寄存器——主流程
//   后续不再使用）。
不安全 函数 发射返回公共尾段(向量<节点> 池, 节点 n, 函数IR& 函数信息,
                  向量<IR指令>& 指令, 整64* 寄存器计数, 映射<整64, 整64>& 局部槽,
                  整64 值寄存器, 整64 返回类型码, 向量<整64>& 表达式栈) -> 空类型 {
    // P7b RAII：返回前析构本函数容器局部（DeleteObject 空安全——
    //   未执行声明路径槽=0 跳过；宿主 genClassDestructorCalls 同款语义）。
    //   2026-09-06 根治（T6 自举首踩）：返回结构体值时被返回变量跳过
    //   析构——所有权转移（值已浅拷入 retbuf 共享堆指针，析构局部=
    //   retbuf 悬垂，IR生成多文件 返回 程序IR 后 函数们.大小()=垃圾实测）
    //   2026-09-06 第二次根治（retown 探针）：返回**容器**（-> 映射<...>）
    //   同族——原仅 返回结构体值 设跳过名，返回容器标识符仍被析构=
    //   返回悬垂指针（接收方 .获取 崩）。泛化：末节点=标识符即设跳过名
    //   （非容器名不在 容器变量们，无副作用）
    整64 返回转移名ID = 0;
    如果 (n.子终点 > n.子起点) {
        节点 返回末转移 = 池.元素(n.子终点 - 1);
        如果 (返回末转移.类型 == 节点_标识符) {
            返回转移名ID = 整64(返回末转移.文本);
        }
    }
    // plans/019 阶段4' A2（2026-09-11 方案甲）：返回位字面量拥有化——返回类型
    //   字符串=拥有契约（调用方登记 RAII 释放），字面量驻只读段须 copy 落堆
    //   （否则调用方 free 只读段指针=崩溃）。拥有变量=槽值直传（移出）。
    如果 (n.子终点 > n.子起点 && 返回类型码 == T_字符串) {
        节点 返回末A2t = 池.元素(n.子终点 - 1);
        如果 (返回末A2t.类型 == 节点_字符串字面量) {
            整64 copy返回寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_调用实参, 值寄存器, 0, 0, 0, 0, 0));
            IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, copy返回寄存器, 0,
                                 驻留("__cn_str_copy")));
            值寄存器 = copy返回寄存器;
        }
    }
    发射容器析构(函数信息, 指令, 寄存器计数, 局部槽, 返回转移名ID);
    // plans/019 阶段4' 第二批：拥有型字符串 RAII（跳过名=返回标识符移出）
    发射字符串释放(函数信息, 指令, 寄存器计数, 局部槽, 返回转移名ID);
    // 98-a（C9）：字符串元素数组全量释放（普通返回路径；幂等：元素释放后清零，
    //   块出口已释放的槽空安全跳过）——首版只加在引用返回分支=普通返回漏网
    //   （mem6 探针「后=2」实证：造尾函数返回未释放）
    发射数组串释放全部(函数信息, 局部槽, 寄存器计数);
    IR追加(指令, 建IR指令(IR_返回, 值寄存器, 0, 0, 0, 返回类型码, 0));
    // 缺陷A根治：返回 后跳函数尾块（epilogue 唯一）——中途回退不再穿透
    发射跳转(函数信息, 函数信息.函数尾块);
}

// ==================== 类析构字段级联注入（277 轮自 生成类.cn 机械搬移=纯搬运零行为变更·超标冻结文件腾行；277 串字段类别分派随体·宿主 injectFieldCascadeDestroy 同构） ====================
// 析构字段级联注入（第七十八轮；宿主 ir_oop.cpp injectFieldCascadeDestroy 同款）：
//   ~类 体末尾按字段逆序对「有析构类型」字段（容器/结果类型、有析构用户类）发射
//   this 槽加载 → 字段地址(偏移) → 指针加载 → IR_删除对象（代码生成展开
//   call ~字段类型 + __cn_object_delete，空安全 test/je）。只对有析构类型注入
//   （无析构类/标量/字符串字段=不注入——对齐宿主 isClassType+hasDtor 判据）。
不安全 函数 注入析构字段级联(向量<节点> 池, 整32 类节点索引, 函数IR& 函数信息,
                    整64* 寄存器计数) -> 空类型 {
    节点 类节点 = 池.元素(类节点索引);
    整64 类名ID = 整64(类节点.文本);
    向量<整64> 偏移们c = 向量<整64>();
    向量<整64> 类型们c = 向量<整64>();
    向量<整64> 类别们c = 向量<整64>();   // 277：0=对象删除 1=串释放
    整64 位置 = 整64(类节点.子起点);
    当 (位置 < 整64(类节点.子终点)) {
        节点 成员 = 池.元素(整32(位置));
        如果 (成员.类型 == 节点_类字段) {
            整64 字段类型IDc = 0;
            如果 (成员.附加 >= 0 && 成员.附加 < 整64(池.大小())) {
                节点 类型节点c = 池.元素(整32(成员.附加));
                字段类型IDc = 整64(类型节点c.文本);
            }
                如果 (字段类型IDc != 0) {
                    字符串 字段类型文本c = 字符串复制(驻留文本(字段类型IDc));
                    布尔 有析构c = 假;
                    // 277（021 任务 277·#263 遗留缺口·577 实测 v2 串差 1）：
                    //   **字符串字段并入级联**（939 宿主修②「类析构尾串字段清理
                    //   注入」的 v2 镜像·79-a 三件套对类的不对称补齐）——发射处
                    //   按类别分派（串=LoadPtr+__cn_str_free+清槽幂等；其余=
                    //   IR_删除对象）。
                    整64 类别c = 0;   // 0=对象删除（容器/结果/有析构类）1=串释放
                    如果 (字符串比较(字段类型文本c, "字符串")) {
                        有析构c = 真;
                        类别c = 1;
                    } 否则 如果 (是容器类(字段类型文本c) || 是结果类型(字段类型文本c)) {
                        有析构c = 真;
                    } 否则 如果 (是用户类(字段类型文本c)) {
                        如果 (类有析构(字段类型IDc)) { 有析构c = 真; }
                    }
                    如果 (有析构c) {
                        整64 偏移c = 查字段偏移(类名ID, 整64(成员.文本));
                        如果 (偏移c >= 0) {
                            结果<空类型, 整32> 加偏 = 偏移们c.追加(偏移c);
                            如果 (!加偏.正常) { 运行时错误(4); }
                            结果<空类型, 整32> 加型 = 类型们c.追加(字段类型IDc);
                            如果 (!加型.正常) { 运行时错误(4); }
                            结果<空类型, 整32> 加别c = 类别们c.追加(类别c);
                            如果 (!加别c.正常) { 运行时错误(4); }
                        }
                    }
                }
        }
        位置++;
    }
    整64 kc = 偏移们c.大小();
    当 (kc > 0) {
        kc--;
        整64 地址c = 发射类字段地址(偏移们c.元素(kc), 函数信息.指令, 寄存器计数);
        如果 (类别们c.元素(kc) == 1) {
            // 277：串字段——LoadPtr → __cn_str_free → 清槽幂等（79-a 口径·
            //   多释放点共享槽安全；零寄存器未建时跳过清槽=宁漏勿错不崩）
            整64 串c = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_指针加载, 地址c, 0, 0, 串c, T_字符串, 0));
            IR追加(函数信息.指令, 建IR指令(IR_调用实参, 串c, 0, 0, 0, 0, 0));
            IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                 驻留("__cn_str_free")));
            如果 (函数信息.零寄存器 != 0) {
                IR追加(函数信息.指令, 建IR指令(IR_指针存储, 地址c,
                                     函数信息.零寄存器, 0, 0, T_整64, 0));
            }
            继续;
        }
        整64 对象c = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(函数信息.指令, 建IR指令(IR_指针加载, 地址c, 0, 0, 对象c, T_对象, 0));
        IR追加(函数信息.指令, 建IR指令(IR_删除对象, 对象c, 0, 0, 寄存器计数[0],
                             0, 类型们c.元素(kc)));
        寄存器计数[0] = 寄存器计数[0] + 1;
    }
}
// 278（021 任务 278·#263 遗留缺口·375 实测）：父析构级联——~派生 体末调
//   ~基类（C++ 析构序：派生体→成员析构→基类析构·注入析构字段级联 之后）。
//   无基类/基类无析构=返回（~符号不存在·宁漏勿错对齐 847 hasDtor 判据）。
不安全 函数 注入父析构调用(整64 类名IDd, 函数IR& 函数信息,
                   整64* 寄存器计数) -> 空类型 {
    整64 基名IDd = 查类基名(类名IDd);
    如果 (基名IDd == 0) { 返回; }
    如果 (!类有析构(基名IDd)) { 返回; }
    字符串 基文本d = 字符串复制(驻留文本(基名IDd));
    整64 this寄d = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(函数信息.指令, 建IR指令(IR_加载, 当前方法this槽, 0, 0, this寄d,
                         T_对象, 0));
    IR追加(函数信息.指令, 建IR指令(IR_调用实参, this寄d, 0, 0, 0, 0, 0));
    IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                         驻留(方法符号(基文本d, "~" + 剥实例基名(基文本d), ""))));
}

// 309（2026-10-09）：合成沿链析构体——「无用户析构·沿链有析构」派生类的
//   C++ 隐式析构同构（体=注入析构字段级联〔成员析构〕+注入父析构调用〔基
//   析构·278 级联〕）。壳字段全量显式构造（98-a 教训：函数IR 加字段须同步
//   全部构造点——生成方法 构造点照抄）；返回/块/尾块按 空类型返回形态手工
//   初始化（族② 消费方法声明节点·合成体无节点故不适用）。
不安全 函数 合成沿链析构体(向量<节点> 池, 整32 类节点索引s, 字符串 模块路径) -> 函数IR {
    函数IR 函数信息;
    函数信息.指令 = 向量<IR指令>();
    函数信息.局部槽 = 映射<整64, 整64>();
    函数信息.参数槽 = 映射<整64, 整64>();
    函数信息.变量类型 = 映射<整64, 整64>();
    函数信息.字符串变量们 = 向量<整64>();
    函数信息.字符串污染们 = 映射<整64, 整64>();
    函数信息.容器变量们 = 向量<整64>();
    函数信息.字符串数组变量们 = 向量<整64>();
    函数信息.循环数组串基线 = 0;
    函数信息.资源字段局部们 = 向量<整64>();
    函数信息.资源字段结构体们 = 向量<整64>();
    函数信息.参数槽序们 = 向量<整64>();
    函数信息.参数拷贝字节们 = 向量<整64>();
    函数信息.参数类型们 = 向量<整64>();
    函数信息.零寄存器 = 0;
    清空函数级槽表();
    清空当前函数变量类型();
    整64 类名IDs = 整64(池.元素(类节点索引s).文本);
    字符串 类名文本s = 字符串复制(驻留文本(类名IDs));
    函数信息.名字 = 整32(驻留(析构符号(类名文本s)));
    设置当前生成符号ID(整64(函数信息.名字));
    函数信息.返回类型 = 类型码(驻留("空类型"));
    函数信息.返回结果名ID = 0;
    函数信息.返回结构体ID = 0;
    函数信息.返回128位 = 0;
    函数信息.返回数组字节 = 0;
    函数信息.返回引用 = 0;
    设当前函数返回结果名ID(0);
    设当前方法名ID(驻留("~" + 剥实例基名(类名文本s)));
    函数信息.块计数 = 0;
    函数信息.当前块 = 0;
    函数信息.循环出口块 = 0;
    函数信息.循环继续块 = 0;
    函数信息.循环串基线 = 0;
    函数信息.循环容基线 = 0;
    函数信息.循环字段基线 = 0;
    函数信息.函数尾块 = 新块(函数信息);
    复位retbuf字节数();
    设当前模块路径(模块路径);
    整64 寄存器计数s = 1;
    整64 槽计数s = 1;
    整64 槽thiss = 槽计数s;
    槽计数s = 槽计数s + 1;
    结果<空类型, 整32> 设thiss = 函数信息.参数槽.设置(驻留("$自身"), 槽thiss);
    如果 (!设thiss.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加序s = 函数信息.参数槽序们.追加(槽thiss);
    如果 (!加序s.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加拷s = 函数信息.参数拷贝字节们.追加(0);
    如果 (!加拷s.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加类s = 函数信息.参数类型们.追加(T_对象);
    如果 (!加类s.正常) { 运行时错误(4); }
    当前方法类名ID = 类名IDs;
    当前方法this槽 = 槽thiss;
    结果<空类型, 整32> 设自s = 函数信息.变量类型.设置(驻留("自身"), 类名IDs);
    如果 (!设自s.正常) { 运行时错误(4); }
    登记当前函数变量类型(驻留("自身"), 类名IDs);
    登记类字段类型们(池, 类节点索引s, 函数信息);
    // 隐式析构体：成员析构→父析构（C++ 序·与用户析构生成注入面同序）
    注入析构字段级联(池, 类节点索引s, 函数信息, &寄存器计数s);
    注入父析构调用(类名IDs, 函数信息, &寄存器计数s);
    发射容器析构(函数信息, 函数信息.指令, &寄存器计数s, 函数信息.局部槽, 0);
    发射字符串释放(函数信息, 函数信息.指令, &寄存器计数s, 函数信息.局部槽, 0);
    发射跳转(函数信息, 函数信息.函数尾块);
    切换块(函数信息, 函数信息.函数尾块);
    发射块标签(函数信息, 函数信息.函数尾块);
    函数信息.retbuf字节数 = 取retbuf字节数();
    当前方法类名ID = 0;
    当前方法this槽 = 0;
    返回 函数信息;
}
// ==================== 281：串字段写入归一化（自 生成表达式求值.cn 抽出·超标
//   文件腾行；235 形⑦根治体·79-a 写入归一化对构造字面量补齐·87-a 分级同款） ====================
// 字符串字段且值来源非字面量（变量/表达式=借用句柄）→__cn_str_copy 落堆独立；
//   原句柄直存=字段与来源共享→字面量临时块尾串 free 穿来源（形⑦ 本地 被改实录）。
//   免拷白名单：字面量（驻留只读直存）/调用返回（字符串复制 已落堆·普通函数
//   返回串=85-a 归一化独立产物）——其余（标识符/成员/下标/二元=借用句柄）才 copy。
不安全 函数 串字段写入归一化281(向量<IR指令>& 指令, 整64* 寄存器计数,
                   向量<节点> 池, 整64 值止c, 整64 字段类型IDf,
                   布尔 值非零, 整64& 值regc) -> 空类型 {
    如果 (!字符串比较(驻留文本(字段类型IDf), "字符串") || !值非零) { 返回; }
    节点 末值281 = 池.元素(整32(值止c - 1));
    布尔 需拷281 = 末值281.类型 != 节点_字符串字面量 &&
                   末值281.类型 != 节点_调用;
    如果 (!需拷281) { 返回; }
    整64 独立c281 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_调用实参, 值regc, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 独立c281, 0,
                         驻留("__cn_str_copy")));
    值regc = 独立c281;
}
