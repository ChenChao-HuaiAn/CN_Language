// CN 自举编译器 v2 · 连接链融合（任务 749——728o 宿主侧 v2 同构收口）
// 职责：一次性字符串连接链 `甲 + 乙 + 丙 + …` 编译器识别整链、改写为
//   「新建缓冲 → 逐段追加 → 完成」构建器序列（复用 366 runtime __cn_strbuf_*·
//   001 §10.3）：朴素加号链原每「+」独立分配整串拷贝（k 段链 O(k²) 字节拷贝），
//   融合后一趟构建 O(L)。宿主 728o（ir_expr_concat.cpp genStringConcatChain）
//   语义等价铁律四项在 v2 的映射：
//     ①终串逐字节等值（复用同一 runtime 构建器）；
//     ②求值顺序/次数/内容读取时点逐点镜像原逐节左结合链——v2 段序列按
//       池后缀区间展平，发射序= new -> 段0求值 -> 段1求值 -> append0 -> append1
//        -> 段i(>=2)求值 -> append_i -> finish（与原 concat_i 的执行时点同点）；
//     ③拥有权同逐节连接（出串=finish 产物新拥有串·段拥有临时追加后结算·617 口径）；
//     ④链长<3/形态不确定一律回退原逐节路径（零行为变更）。
// 判据（宿主 chainStringOperand 的 v2 AST 版本）：
//   链端点「是字符串」= 二元 + 沿左递归下钻；其余形态走 推导末端拼接码
//   （字符串字面量/标识符/调用返回串/数组元素——字符数组元素返回 T_字符，
//   与宿主收窄口径一致：i32 非 ptr 不作链端点）。
// 实施位置：v2 表达式为后缀池布局，左右子已在主循环逐一生成压栈——链识别
//   必须在主循环【之前】预扫描（收集连接链区间），主循环命中区间起点时交由
//   本文件 生成连接链 整链递归生成（宿主 visitBinaryExpr 顶部接管的等价位）。
导入 容器::向量;
导入 IR;
导入 协议常量;
导入 IR生成;
导入 生成表达式;

公开:

// 链节点判定：二元 + 且非短路（普通二元 子终点=0）
函数 连接链是加节点(节点 nd) -> 布尔 {
    如果 (nd.类型 != 节点_二元运算) { 返回 假; }
    如果 (nd.子终点 != 0) { 返回 假; }
    返回 字符串比较(字符串复制(驻留文本(整64(nd.文本))), "+");
}

// 链端点「是字符串」判定（宿主 chainStringOperand 同构·保守面）：
//   二元 + -> 递归其左操作数（下钻到链最左叶）；非 + 二元 -> 假（与宿主
//   BinaryExpr 非 Add 返回 false 一致）；其余形态 -> 推导末端拼接码 == T_字符串
//   （未登记/数值/字符/指针一律假 = 不融合 -> 原路径，无错值面）。
函数 链端是字符串(向量<节点> 池, 整64 位置) -> 布尔 {
    布尔 范围合法 = (位置 >= 0 && 位置 < 整64(池.大小()));
    如果 (!范围合法) { 返回 假; }
    节点 端 = 池.元素(整32(位置));
    如果 (端.类型 == 节点_二元运算) {
        布尔 是加 = 连接链是加节点(端);
        如果 (!是加) { 返回 假; }
        整64 左根位 = 整64(端.附加) - 1;
        返回 链端是字符串(池, 左根位);
    }
    返回 链端是字符串判定码(池, 位置);
}

// 链端字符串判定码 = 推导末端拼接码 == T_字符串
函数 链端是字符串判定码(向量<节点> 池, 整64 位置) -> 布尔 {
    整64 码d = 推导末端拼接码(池, 整32(位置), 0);
    返回 码d == T_字符串;
}

// 左结合连接链段数（宿主 genStringConcatChain 展平判据同构）：
//   从 根位置 沿左 spine 下钻——左根是 + 且其左端点字符串则继续；段数 =
//   spine 节点数 + 1（首段）——可展次数 = spine 节点数 - 1，故 段数=可展数+2。
函数 连接链段数(向量<节点> 池, 整64 根位置) -> 整64 {
    整64 可展数 = 0;
    整64 当前 = 根位置;
    当 (真) {
        节点 cur = 池.元素(整32(当前));
        整64 左根位 = 整64(cur.附加) - 1;
        布尔 可展 = (左根位 >= 0 && 左根位 < 当前);
        如果 (可展) {
            节点 左根 = 池.元素(整32(左根位));
            可展 = 连接链是加节点(左根);
            如果 (可展) { 可展 = 链端是字符串(池, 左根位); }
        }
        如果 (!可展) { 返回 可展数 + 2; }
        可展数++;
        当前 = 左根位;
    }
    返回 2;
}

// 表达式子树起点（后缀池布局下的「本子树首节点」）：
//   二元节点 -> 左操作数子树（附加-1 左根）起点递归；
//   调用/成员/下标 -> 子起点（解析器写入的后缀链基名/对象索引）递归；
//   一元前缀/自增表达式 -> 子起点（操作数起点）递归；
//   三元/错误传播 -> 子起点；
//   其余（标识符/字面量/结构体构造）-> 自身位置。
//   注：二元节点的 子起点 对层3+ 由解析器写成「池.大小()」（原子之后·无消费
//   方），不可用作子树起点——本函数按结构化递归求真实起点（宿主 AST 边界等价物）。
函数 表达式子树起点(向量<节点> 池, 整64 根位置) -> 整64 {
    节点 nd = 池.元素(整32(根位置));
    如果 (nd.类型 == 节点_二元运算) {
        整64 左根位 = 整64(nd.附加) - 1;
        布尔 有左 = (左根位 >= 0 && 左根位 < 根位置);
        如果 (有左) { 返回 表达式子树起点(池, 左根位); }
        返回 根位置;
    }
    布尔 是后缀 = (nd.类型 == 节点_调用) || (nd.类型 == 节点_成员) ||
                    (nd.类型 == 节点_下标);
    如果 (是后缀) {
        整64 基位 = 整64(nd.子起点);
        布尔 有基 = (基位 >= 0 && 基位 < 根位置);
        如果 (有基) { 返回 表达式子树起点(池, 基位); }
        返回 根位置;
    }
    布尔 是一元 = (nd.类型 == 节点_负号) || (nd.类型 == 节点_逻辑非) ||
                    (nd.类型 == 节点_位非) || (nd.类型 == 节点_取地址) ||
                    (nd.类型 == 节点_解引用) || (nd.类型 == 节点_自增表达式);
    如果 (是一元) {
        整64 子位 = 整64(nd.子起点);
        布尔 有子 = (子位 >= 0 && 子位 < 根位置);
        如果 (有子) { 返回 表达式子树起点(池, 子位); }
        返回 根位置;
    }
    布尔 是分支 = (nd.类型 == 节点_三元运算) || (nd.类型 == 节点_错误传播);
    如果 (是分支) {
        整64 子位2 = 整64(nd.子起点);
        布尔 有子2 = (子位2 >= 0 && 子位2 <= 根位置);
        如果 (有子2) { 返回 子位2; }
        返回 根位置;
    }
    返回 根位置;
}

// 链最左起点（整链左端点池位）：沿 spine 走到最深链节点，首段=其左操作数子树
//   ——起点经 表达式子树起点 求真实首节点（二元 子起点 对算术层不可靠）。
函数 链最左起点(向量<节点> 池, 整64 根位置) -> 整64 {
    整64 当前 = 根位置;
    当 (真) {
        节点 cur = 池.元素(整32(当前));
        整64 左根位 = 整64(cur.附加) - 1;
        布尔 可展 = (左根位 >= 0 && 左根位 < 当前);
        如果 (可展) {
            节点 左根 = 池.元素(整32(左根位));
            可展 = 连接链是加节点(左根);
            如果 (可展) { 可展 = 链端是字符串(池, 左根位); }
        }
        如果 (!可展) {
            整64 首段根位 = 整64(cur.附加) - 1;
            布尔 有首段 = (首段根位 >= 0 && 首段根位 < 当前);
            如果 (有首段) { 返回 表达式子树起点(池, 首段根位); }
            返回 当前;
        }
        当前 = 左根位;
    }
    返回 0;
}

// 区间向量追加（错误=内部错误显形·与既有预扫描族同款）
不安全 函数 连接链压整(向量<整64>& 目标, 整64 值) -> 空类型 {
    结果<空类型, 整32> 加 = 目标.追加(值);
    如果 (!加.正常) { 运行时错误(4); }
}

// 同起点区间查位（返回区间起点元素下标，-1=未登记）——左结合链同起点候选
//   内层先登记，外层根位置更大：同起点时改写终点即为「保留最长链」。
函数 连接链同起点位(向量<整64>& 区间们, 整64 链起) -> 整64 {
    整64 i = 0;
    当 (i < 区间们.大小()) {
        如果 (区间们.元素(整32(i)) == 链起) { 返回 i; }
        i = i + 2;
    }
    返回 0 - 1;
}

// 预扫描连接链区间（主循环前调用·平铺 [起,终) 与 区间终点 判定对齐）：
//   候选=二元 + 节点且链段数 >= 3（宿主 kMinConcatChainSegs 同值）；同起点
//   区间改写为更大终点（外层链覆盖内层候选，防内层段被提前消费）。
函数 收集连接链区间(向量<节点> 池, 整32 起点, 整32 终点, 向量<整64>& 区间们) -> 空类型 {
    整32 预扫 = 起点;
    当 (预扫 < 终点) {
        节点 预节点 = 池.元素(预扫);
        布尔 是加 = 连接链是加节点(预节点);
        如果 (是加) {
            整64 段数 = 连接链段数(池, 整64(预扫));
            如果 (段数 >= 3) {
                整64 链起 = 链最左起点(池, 整64(预扫));
                整64 同起 = 连接链同起点位(区间们, 链起);
                如果 (同起 >= 0) {
                    结果<空类型, 整32> 改终 = 区间们.设置(整32(同起 + 1), 整64(预扫) + 1);
                    如果 (!改终.正常) { 运行时错误(4); }
                // 同起点 miss（-1）=尚无登记区间·压入新链（查找哨兵两态分流）
                } 否则 如果 (同起 < 0) {
                    连接链压整(区间们, 链起);
                    连接链压整(区间们, 整64(预扫) + 1);
                }
            }
        }
        预扫++;
    }
}

// 展平段区间：段序=左到右（段0=最左段；段 i>=1=链节点倒序右操作数区间）。
//   返回段数；段起们/段终们 逐段对应（半开区间）。
不安全 函数 连接链展平段区间(向量<节点> 池, 整64 根位置,
                           向量<整64>& 段起们, 向量<整64>& 段终们) -> 整64 {
    向量<整64> 链节点们 = 向量<整64>();
    整64 当前 = 根位置;
    当 (真) {
        连接链压整(链节点们, 当前);
        节点 cur = 池.元素(整32(当前));
        整64 左根位 = 整64(cur.附加) - 1;
        布尔 可展 = (左根位 >= 0 && 左根位 < 当前);
        如果 (可展) {
            节点 左根 = 池.元素(整32(左根位));
            可展 = 连接链是加节点(左根);
            如果 (可展) { 可展 = 链端是字符串(池, 左根位); }
        }
        如果 (!可展) { 中断; }
        当前 = 左根位;
    }
    整64 最深位 = 链节点们.元素(整32(链节点们.大小() - 1));
    节点 最深 = 池.元素(整32(最深位));
    整64 首段根位 = 整64(最深.附加) - 1;
    整64 首起 = 最深位;
    布尔 有首 = (首段根位 >= 0 && 首段根位 < 最深位);
    如果 (有首) { 首起 = 表达式子树起点(池, 首段根位); }
    连接链压整(段起们, 首起);
    连接链压整(段终们, 整64(最深.附加));
    整64 k = 链节点们.大小() - 1;
    当 (k >= 0) {
        整64 节点位 = 链节点们.元素(整32(k));
        节点 nd = 池.元素(整32(节点位));
        连接链压整(段起们, 整64(nd.附加));
        连接链压整(段终们, 节点位);
        k = k - 1;
    }
    返回 链节点们.大小() + 1;
}

// 单段求值（递归 生成表达式 + 归位表达式栈；净栈契约与 生成短路求值 同款）
不安全 函数 求值连接链段(向量<节点> 池, 整64 段起, 整64 段终,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) -> 整64 {
    整64 进入深度 = 表达式栈.大小();
    整64 寄存器 = 生成表达式(池, 整32(段起), 整32(段终), 局部槽, 参数槽,
                             指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    表达式栈弹到深度(表达式栈, 进入深度);
    返回 寄存器;
}

// 段值码推导：寄存器登记优先；复核（未登记 0 或 T_整64 字符归并面——复核拼接码
//   单点，与普通拼接判定同判据·T48）走末端推导；仍未登记按整64 兜底
//   （既有惯例面——发射字符串拼接「未登记类型按整数兜底」同口径·648 归档）。
函数 连接链段码(向量<节点> 池, 整64 段寄存器, 整64 段终) -> 整64 {
    // 1360 批5：未登记=类型未知（T_未知 兜底·既有业务语义：交复核拼接码/整64 口径）
    整64 码 = T_未知;
    可选<整64> 码查 = 查寄存器类型(段寄存器);
    如果 (码查.有值) { 码 = 码查.值; }
    码 = 复核拼接码(池, 段终 - 1, 码);
    如果 (码 == 0) { 码 = T_整64; }
    返回 码;
}

// 单段追加发射：__cn_strbuf_append(句柄, 段值)（append 内拷贝内容）
不安全 函数 发射连接链追加(整64 句柄, 整64 段寄存器, 向量<IR指令>& 指令) -> 空类型 {
    IR追加(指令, 建IR指令(IR_调用实参, 句柄, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用实参, 段寄存器, 0, 0, 0, 1, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                         驻留("__cn_strbuf_append")));
}

// 段拥有临时结算（追加完成后）：
//   数值段 -> 转换产物（from_*）即释；
//   三元段 -> 分支拥有性感知条件释放（662 设施）；
//   其余字符串段 -> 拥有串临时形态（调用返回串/连接子链产物）才释放；
//   字面量/标识符/下标借用视图不释放（617 判据）。
不安全 函数 结算连接链段(向量<节点> 池, 整64 段终, 整64 段寄存器, 布尔 数值段,
                  向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数) -> 空类型 {
    如果 (数值段) {
        发射寄存器串释放(段寄存器, 指令);
        返回;
    }
    节点 段根 = 池.元素(整32(段终 - 1));
    如果 (段根.类型 == 节点_三元运算) {
        发射串临时释放递归662(池, 段终 - 1, 段寄存器, 指令, 寄存器计数, 块计数);
        返回;
    }
    如果 (拥有串临时形态(池, 段根)) {
        发射串临时释放617(段寄存器, 指令, 寄存器计数);
    }
}

// 连接链融合入口（主循环链区间命中时整链生成·返回假=区间结构与预扫描不一致
//   （内部缺陷显形·主循环据此终止生成））。
不安全 函数 生成连接链(向量<节点> 池, 整32 链起, 整32 链终,
                映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数,
                向量<整64>& 表达式栈) -> 布尔 {
    向量<整64> 段起们 = 向量<整64>();
    向量<整64> 段终们 = 向量<整64>();
    整64 段数 = 连接链展平段区间(池, 整64(链终) - 1, 段起们, 段终们);
    布尔 段数合法 = (段数 >= 3 && 段数 <= 段起们.大小() && 段数 == 段终们.大小());
    如果 (!段数合法) { 返回 假; }
    // 句柄（整64 不透明·001 §10.3）；new 失败（nullptr）经 runtime append/
    //   完成 的空安全通道自然退化（不泄漏·不崩——366 弃置契约同源）
    整64 句柄 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_调用参数化, 0, 0, 0, 句柄, 0,
                         驻留("__cn_strbuf_new")));
    登记寄存器类型(句柄, T_整64);
    // 前两段先行求值（内容读取时点镜像：原 concat_1 于段 2 求值前执行）
    整64 段0起 = 段起们.元素(0);
    整64 段0终 = 段终们.元素(0);
    整64 段1起 = 段起们.元素(1);
    整64 段1终 = 段终们.元素(1);
    整64 值0 = 求值连接链段(池, 段0起, 段0终, 局部槽, 参数槽,
                            指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    整64 值1 = 求值连接链段(池, 段1起, 段1终, 局部槽, 参数槽,
                            指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    整64 码0 = 连接链段码(池, 值0, 段0终);
    整64 码1 = 连接链段码(池, 值1, 段1终);
    布尔 数0 = 码0 != T_字符串;
    布尔 数1 = 码1 != T_字符串;
    发射拼接数值转换(值0, 码0, 指令, 寄存器计数);
    发射拼接数值转换(值1, 码1, 指令, 寄存器计数);
    发射连接链追加(句柄, 值0, 指令);
    结算连接链段(池, 段0终, 值0, 数0, 指令, 寄存器计数, 块计数);
    发射连接链追加(句柄, 值1, 指令);
    结算连接链段(池, 段1终, 值1, 数1, 指令, 寄存器计数, 块计数);
    // 段 i>=2：求值 -> append -> 结算（内容读取时点=原第 i 次 concat 同点）
    整64 i = 2;
    当 (i < 段数) {
        整64 段i起 = 段起们.元素(整32(i));
        整64 段i终 = 段终们.元素(整32(i));
        整64 值i = 求值连接链段(池, 段i起, 段i终, 局部槽, 参数槽,
                               指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
        整64 码i = 连接链段码(池, 值i, 段i终);
        布尔 数i = 码i != T_字符串;
        发射拼接数值转换(值i, 码i, 指令, 寄存器计数);
        发射连接链追加(句柄, 值i, 指令);
        结算连接链段(池, 段i终, 值i, 数i, 指令, 寄存器计数, 块计数);
        i++;
    }
    // 完成：出串=新拥有串（cn_alloc_tracked·与 __cn_str_concat 同所有权契约）
    整64 结果寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_调用实参, 句柄, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 结果寄存器, 0,
                         驻留("__cn_strbuf_finish")));
    登记寄存器类型(结果寄存器, T_字符串);
    结果<空类型, 整32> 压 = 表达式栈.追加(结果寄存器);
    如果 (!压.正常) { 运行时错误(4); }
    返回 真;
}
