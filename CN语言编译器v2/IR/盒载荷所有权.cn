// #1884：盒载荷所有权表（结果/可选 盒「谁拥有类载荷」的编译期账·单点）
// 背景（#1466 遗留①甲案·跨函数甄别）：
//   · p8/p12：盒初值=调用返回（装盒()）、载荷 dtor-only（无拷贝构造）——盒亡
//     释放判据若只认「有拷贝构造 ∨ 正常/某些(类构造临时)」则调用返回盒不登记
//     → 每盒净漏 1；而一刀切「调用返回即拥有」又会把 p16（返回引用参数 p 的
//     借用盒）判成拥有 → 盒亡 delete 与源槽析构双删 C0000374。两侧差别的唯一
//     可靠来源=**被调方返回位载荷来源**（移交/借用），调用点无法从签名看出。
//   · 修法=被调方生成返回位 正常/某些(载荷) 时登记「函数名 → 载荷是否移交」
//     （登记盒返回拥有）；调用点装盒时查表（盒初值接收调用返回），miss=未知=
//     保守借用（不登记释放=只残留不崩·被调函数在调用点之后生成/跨翻译单元）。
//   · 标识符载荷的「拥有局部」判定复用「当前函数拥有类局部名们」表（生成声明
//     登记有析构类局部）——形参/类字段/全局静态不在册=借用（p16 引用参数实锚）。
// 行数整改：本族自 生成表达式装箱.cn 拆出（承载文件 1028 行超 1000 冻结线·
//   先拆再加），谓词原文保留（盒拥有载荷/初值移交临时=#1885 语义 +
//   #1884「初值=调用返回表判定」扩展）。
导入 容器::向量;
导入 映射集合;
导入 协议常量;
导入 IR生成;

公开:

// 盒返回主张表：函数源码名ID → 1=返回盒载荷移交（盒可拥有）/ 0=借用。
//   缺=未知（保守借用）。同函数多返回语句：任一借用则整体 0（登记盒返回拥有）。
静态 映射<整64, 整64> 盒返回拥有表;
// 当前函数的**有析构类局部**名ID（生成声明 登记·生成函数/类方法入口清空）——
//   返回位 正常(该局部) 的载荷=返回位移交面（宿主 ownedClassOrder_ 同构）。
静态 向量<整64> 当前函数拥有类局部名们;

// 任务级清空（函数生成入口调用·与 清空已装箱节点表 同生命周期）：
//   只清本函数类局部名（返回主张表=跨函数累积，必须保留）。
不安全 函数 清空盒返回主张任务级() -> 空类型 {
    当前函数拥有类局部名们.清空();
}

不安全 函数 登记当前函数拥有类局部(整64 名ID) -> 空类型 {
    结果<空类型, 整32> 加p = 当前函数拥有类局部名们.追加(名ID);
    如果 (!加p.正常) { 运行时错误(4); }
}

// 纯谓词：名ID 是否本函数有析构类局部（真假判定·非失败通道）。
函数 当前函数拥有类局部(整64 名ID) -> 布尔 {
    布尔 命中 = 假;
    整64 i = 0;
    当 (i < 当前函数拥有类局部名们.大小()) {
        如果 (当前函数拥有类局部名们.元素(整32(i)) == 名ID) { 命中 = 真; 中断; }
        i++;
    }
    返回 命中;
}

// 登记被调方返回主张（返回位 正常/某些 生成时）——任一借用则整体借用（保守）。
不安全 函数 登记盒返回拥有(整64 名ID, 布尔 拥有) -> 空类型 {
    结果<整64, 整32> 既查 = 盒返回拥有表.获取(名ID);
    整64 新值 = 0;
    如果 (既查.正常) {
        // 已登记：借用(0) 恒维持；拥有(1) 遇借用主张降为 0
        如果 (既查.值 != 0 && 拥有) { 新值 = 1; }
    }
    // 首次登记（无旧条）：拥有=1，借用=0（0 亦为默认态，显式写入保持表有键）
    如果 (!既查.正常 && 拥有) { 新值 = 1; }
    结果<空类型, 整32> 设r = 盒返回拥有表.设置(名ID, 新值);
    如果 (!设r.正常) { 运行时错误(4); }
}

// 纯谓词：名ID 的返回盒载荷是否移交（缺=未知=保守借用）。
函数 盒返回拥有(整64 名ID) -> 布尔 {
    结果<整64, 整32> 查r = 盒返回拥有表.获取(名ID);
    布尔 拥有 = 假;
    如果 (查r.正常) {
        如果 (查r.值 == 1) { 拥有 = 真; }
    }
    返回 拥有;
}

// 链接键 → 源码名 ID（统一链接键=键基[#参数串]·键基=主模块纯名/其余 模块$名）。
//   克隆实例（含 $、无 #）=原名返回（实例身份唯一）。无 '#'=原样返回。
//   纯函数（无副作用·驻留复用）。
函数 链接键源码名(整64 链接键ID) -> 整64 {
    字符串 文本 = 字符串复制(驻留文本(链接键ID));
    整64 长度 = 字符串长度(文本);
    整64 井位 = 长度;
    布尔 有井 = 假;
    整64 i = 0;
    当 (i < 长度) {
        如果 ((整64(文本[i]) & 255) == 35) { 井位 = i; 有井 = 真; 中断; }
        i++;
    }
    如果 (!有井) { 返回 链接键ID; }
    整64 起名 = 0;
    i = 0;
    当 (i < 井位) {
        如果 ((整64(文本[i]) & 255) == 36) { 起名 = i + 1; }
        i++;
    }
    整64 名长 = 井位 - 起名;
    如果 (名长 <= 0 || 名长 >= 长度) { 返回 链接键ID; }
    返回 驻留(字符串子串(文本, 整32(起名), 整32(名长)));
}

// 返回位「正常/某些(载荷)」载荷所有权判定（#1466 甲案·被调方侧）：
//   实参根=调用（非引用返回）=无左值槽临时/转移/复制 → 移交（盒可拥有）；
//   实参根=标识符且为**本函数有析构类局部**（返回位 move 转交已清零源槽）→
//   移交；形参（含引用参数）/类字段/全局静态/成员/下标/解引用/三元 → 借用。
//   纯谓词（真假判定·非失败通道）。
函数 盒返回载荷拥有(向量<节点> 池, 整64 根位置) -> 布尔 {
    布尔 拥有 = 假;
    如果 (根位置 >= 0 && 根位置 < 整64(池.大小())) {
        节点 根节点 = 池.元素(整32(根位置));
        如果 (根节点.类型 == 节点_调用) {
            拥有 = !是引用返回调用(池, 整32(根位置));
        } 否则 如果 (根节点.类型 == 节点_标识符) {
            拥有 = 当前函数拥有类局部(整64(根节点.文本));
        }
    }
    返回 拥有;
}

// 盒初值「正常/某些(类构造临时)」判定——盒 = 被移交临时的唯一拥有者
//   （宿主 boxInitMovesTempPayload 同构·〔基准=019〕第 1/4 句）。区间 [起, 终)
//   为声明初值表达式节点区间（v2 池布局=子树在前、外层调用节点在末）：
//   末节点=调用 且被调=正常/某些 且实参根（末-1）=调用且**非引用返回**
//   （引用返回调用=被引用对象借用 place，禁按移交）。纯谓词（真假判定）。
函数 初值移交临时(向量<节点> 池, 整64 起, 整64 终) -> 布尔 {
    如果 (起 >= 终 || 终 <= 0 || 终 > 整64(池.大小())) { 返回 假; }
    整64 末 = 终 - 1;
    节点 初根 = 池.元素(整32(末));
    布尔 已移交 = 假;
    // 外层调用节点且被调为池内合法标识符（双边界闭区间守卫）
    如果 (初根.类型 == 节点_调用 && 初根.子起点 >= 1 &&
        初根.子起点 < 整64(池.大小())) {
        节点 被调 = 池.元素(整32(初根.子起点));
        布尔 是装箱构造器 = 被调.类型 == 节点_标识符 &&
            (字符串比较(字符串复制(驻留文本(整64(被调.文本))), "正常") ||
             字符串比较(字符串复制(驻留文本(整64(被调.文本))), "某些"));
        如果 (是装箱构造器 && 末 > 起) {
            节点 实参根 = 池.元素(整32(末) - 1);
            如果 (实参根.类型 == 节点_调用) {
                已移交 = !是引用返回调用(池, 整32(末) - 1);
            }
        }
    }
    返回 已移交;
}

// #1884：盒初值=普通函数/方法调用（非引用返回）——**查被调方返回主张表**
//   （甲案跨函数甄别）：被调函数生成返回位 正常/某些(...) 时按载荷来源登记
//   （登记盒返回拥有），命中「移交」才判盒拥有。内置构造器不查表（拥有关系
//   取决于实参形态=初值移交临时）；方法调用面外（跨类解析另案）=保守借用；
//   表 miss（被调函数在调用点之后生成/跨翻译单元）=保守借用。纯谓词。
函数 盒初值接收调用返回(向量<节点> 池, 节点 声明) -> 布尔 {
    布尔 接收返回 = 假;
    整64 起 = 整64(声明.子起点);
    整64 终 = 整64(声明.子终点);
    如果 (起 < 终 && 终 > 0 && 终 <= 整64(池.大小())) {
        节点 末节点 = 池.元素(整32(终 - 1));
        如果 (末节点.类型 == 节点_调用 && 末节点.子起点 >= 1 &&
            末节点.子起点 < 整64(池.大小())) {
            节点 被调末 = 池.元素(整32(末节点.子起点));
            如果 (被调末.类型 == 节点_标识符) {
                字符串 被调名末 = 字符串复制(驻留文本(整64(被调末.文本)));
                布尔 是内置构造器 = 字符串比较(被调名末, "正常") ||
                    字符串比较(被调名末, "错误") ||
                    字符串比较(被调名末, "某些");
                如果 (!是内置构造器 && !是引用返回调用(池, 整32(终 - 1))) {
                    接收返回 = 盒返回拥有(整64(被调末.文本));
                }
            }
        }
    }
    返回 接收返回;
}

// #1885/#1884：盒载荷拥有判据（宿主 registerPendingBoxVar 同构·单点）——true=
//   盒亡须释放载荷。载荷=字符串/结构体（装箱深拷或 move 恒拥有）恒真；载荷=
//   用户类时=类有析构 ∧（有拷贝构造 ∨ 初值=正常/某些(类构造临时) ∨ #1884
//   初值=调用返回盒（被调方返回位移交·表判定））。借用盒（place 实参无拷贝构造/
//   返回引用参数的借用载荷）返回假——源槽拥有、盒不释放（原无条件登记=盒亡
//   delete 与源槽析构双删·p16 C0000374 实锚）。纯谓词（真假判定·非失败通道）。
函数 盒拥有载荷(向量<节点> 池, 节点 声明, 字符串 类型文本) -> 布尔 {
    字符串 盒载荷 = "";
    可选<字符串> 盒载荷查 = 结果载荷基型(归一结果名(类型文本));
    如果 (盒载荷查.有值) { 盒载荷 = 字符串复制(盒载荷查.值); }
    布尔 拥有 = 真;
    布尔 是类载荷 = 是用户类(盒载荷);
    如果 (是类载荷) {
        整64 盒载荷ID = 驻留(盒载荷);
        布尔 有拷贝构造 = 查类拷贝构造串(盒载荷ID).有值;
        布尔 初值移交 = 初值移交临时(池, 整64(声明.子起点), 整64(声明.子终点));
        布尔 初值调用返回 = 盒初值接收调用返回(池, 声明);
        拥有 = 类有析构(盒载荷ID) &&
               (有拷贝构造 || 初值移交 || 初值调用返回);
    }
    返回 拥有;
}
