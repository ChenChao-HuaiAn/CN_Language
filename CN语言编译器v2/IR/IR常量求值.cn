// CN 自举编译器 v2 · IR 组件·常量表达式文本级求值族（919·640 侦察副产品）
// 职责：超承载字面量参与表达式求值的双侧静默分叉根治——全字面量算术表达式
//   （+ - * / %·一元 ±负号链）经十进制文本大数四则求值出数学值（规范十进制
//   文本·大数安全·与宿主 decText*919/cnEvalConstIntExprText919 语义对偶），
//   供语义层值域判定消费（字面量文本入域/隐式转换合法/535 静态槽/638 推断面）。
//   存在意义：解析/折叠链（折叠文本转值1029 位模式累加474）对超 64 位承载
//   字面量静默回绕（`静态 整32 槽 = 99999999999999999999+0` v2 输出 1661992959
//   静默错值·宿主同形静默 5/1661992959 双侧错值分叉）；文本级四则为「表达式
//   常量数学值超目标类型域 → 编译期拒」判据提供大数安全数学值（与宿主 919
//   同判据同诊断）。
//   失败面=显式哨兵：求值器返回 假=非常量形态（消费方交既有链）；文本出 0=
//   超 u128 域（沿 910 空串口径——消费方按超一切整型域拒）。
//   依赖=协议常量（节点_*）+ IR（同包 字面量十进制文本/字符转字符串1029
//   单点复用·禁散写第二份进制数值化判据）。
导入 容器::向量;
导入 IR;
导入 协议常量;

公开:

// ==================== 十进制文本大数四则（规范形·超 u128 域空串哨兵） ====================
// 规范形约定（与宿主 normalizeIntLiteralToDecimal/decText*919 输出同形）：
//   可带 '-'·无前导零·"0" 表零。空串=超 u128 域显式哨兵（沿 910/normalize
//   空串口径——中间值或最终值任一超 2^128-1 即哨兵；消费方按超一切整型域拒）。

// 919：去前导零（保留至少一位·规范形数字段）
函数 规范919(字符串 数字) -> 字符串 {
    整64 长 = 字符串长度(数字);
    整64 起 = 0;
    当 (起 < 长 - 1 && (整64(数字[整32(起)]) & 255) == 48) { 起++; }
    返回 字符串子串(数字, 起, 长 - 起);
}

// 919：拆符号——真=负号；数字出=剥前导符号后原样（规范由调用方执行）
函数 拆符号919(字符串 文本, 字符串& 数字出) -> 布尔 {
    整64 长 = 字符串长度(文本);
    如果 (长 == 0) {
        数字出 = 字符串复制("");
        返回 假;
    }
    整64 首 = 整64(文本[整32(0)]) & 255;
    如果 (首 == 45) {
        数字出 = 字符串子串(文本, 1, 长 - 1);
        返回 真;
    }
    如果 (首 == 43) {
        数字出 = 字符串子串(文本, 1, 长 - 1);
        返回 假;
    }
    数字出 = 字符串复制(文本);
    返回 假;
}

// 919：规范带符号形（"-0" 归一 "0"·空串透传）
函数 规范带符919(字符串 文本) -> 字符串 {
    如果 (字符串长度(文本) == 0) { 返回 字符串复制(""); }
    字符串 数字 = "";
    布尔 负 = 拆符号919(文本, 数字);
    字符串 标 = 规范919(数字);
    如果 (字符串比较(标, "0")) { 返回 字符串复制("0"); }
    如果 (负) { 返回 字符串复制("-") + 标; }
    返回 标;
}

// 919：无符号数字串比较（规范形入参）：-1/0/1
// 1374 批5 豁免说明（保留三态返回·不结果化）：-1/0/1 为比较器业务值三态
//   （-1=a<b、0=相等、1=a>b），全部取值均为合法结果，-1 非 miss 哨兵——
//   调用方按三态消费，故不属 880 哨兵结果化面（不新增登记条）。
函数 无符比较919(字符串 a, 字符串 b) -> 整64 {
    整64 长a = 字符串长度(a);
    整64 长b = 字符串长度(b);
    如果 (长a != 长b) {
        如果 (长a < 长b) { 返回 0 - 1; }
        返回 1;
    }
    整64 i = 0;
    当 (i < 长a) {
        整64 字节a = 整64(a[整32(i)]) & 255;
        整64 字节b = 整64(b[整32(i)]) & 255;
        如果 (字节a != 字节b) {
            如果 (字节a < 字节b) { 返回 0 - 1; }
            返回 1;
        }
        i++;
    }
    返回 0;
}

// 919：无符号加（规范进规范）
函数 无符加919(字符串 a, 字符串 b) -> 字符串 {
    字符串 出 = "";
    整64 进 = 0;
    整64 i = 字符串长度(a) - 1;
    整64 j = 字符串长度(b) - 1;
    当 (i >= 0 || j >= 0 || 进 > 0) {
        整64 v = 进;
        如果 (i >= 0) {
            v = v + ((整64(a[整32(i)]) & 255) - 48);
            i--;
        }
        如果 (j >= 0) {
            v = v + ((整64(b[整32(j)]) & 255) - 48);
            j--;
        }
        出 = 字符转字符串1029(48 + (v % 10)) + 出;
        进 = v / 10;
    }
    返回 规范919(出);
}

// 919：无符号减（前提 a 数值 >= b）——规范进规范（结果可 "0"）
函数 无符减919(字符串 a, 字符串 b) -> 字符串 {
    字符串 出 = "";
    整64 借 = 0;
    整64 i = 字符串长度(a) - 1;
    整64 j = 字符串长度(b) - 1;
    当 (i >= 0) {
        整64 v = ((整64(a[整32(i)]) & 255) - 48) - 借;
        如果 (j >= 0) {
            v = v - ((整64(b[整32(j)]) & 255) - 48);
            j--;
        }
        // 借位单向赋值（修 919 初版缺陷：v<0 归一后必须保留下轮借位——原
        //   双 如果 顺序使 v+=10 后 借 被重置 0：10-1 得 19、90-3 得 97，
        //   试商回环 99→…→92→99 无限循环=编译器挂死实锚·p13e 探针）
        整64 借下 = 0;
        如果 (v < 0) {
            v = v + 10;
            借下 = 1;
        }
        借 = 借下;
        出 = 字符转字符串1029(48 + v) + 出;
        i--;
    }
    返回 规范919(出);
}

// 919：无符号数字串是否超 u128 域（39 位界 340282366920938463463374607431768211455）
函数 超u128域919(字符串 数字) -> 布尔 {
    整64 长 = 字符串长度(数字);
    如果 (长 > 39) { 返回 真; }
    如果 (长 < 39) { 返回 假; }
    返回 无符比较919(数字, "340282366920938463463374607431768211455") == 1;
}

// 919：无符号乘——规范进规范；超 u128 域=空串哨兵（位数预检先行：结果位数
//   至多 长a+长b-1·必超即免算）
函数 无符乘919(字符串 a, 字符串 b) -> 字符串 {
    字符串 数a = 规范919(a);
    字符串 数b = 规范919(b);
    如果 (字符串比较(数a, "0") || 字符串比较(数b, "0")) { 返回 字符串复制("0"); }
    整64 长a = 字符串长度(数a);
    整64 长b = 字符串长度(数b);
    // 乘法位数预检：结果位数下界=长a+长b-1，必超 u128 十进制 39 位界=免算直返空串哨兵
    如果 (长a + 长b - 1 > 39) {
        返回 字符串复制("");
    }
    向量<整64> 位 = 向量<整64>();
    整64 k = 0;
    当 (k < 长a + 长b) {
        结果<空类型, 整32> 加位 = 位.追加(0);
        如果 (!加位.正常) { 运行时错误(4); }
        k++;
    }
    整64 ia = 长a - 1;
    当 (ia >= 0) {
        整64 ib = 长b - 1;
        当 (ib >= 0) {
            整64 积 = ((整64(数a[整32(ia)]) & 255) - 48) *
                     ((整64(数b[整32(ib)]) & 255) - 48);
            整64 序 = (长a - 1 - ia) + (长b - 1 - ib);
            整64 旧 = 位.元素(整32(序));
            结果<空类型, 整32> 设积 = 位.设置(整32(序), 旧 + 积);
            如果 (!设积.正常) { 运行时错误(4); }
            ib--;
        }
        ia--;
    }
    整64 c = 0;
    当 (c < 整64(位.大小()) - 1) {
        整64 v = 位.元素(整32(c));
        结果<空类型, 整32> 设余 = 位.设置(整32(c), v % 10);
        如果 (!设余.正常) { 运行时错误(4); }
        整64 上 = 位.元素(整32(c + 1));
        结果<空类型, 整32> 设上 = 位.设置(整32(c + 1), 上 + v / 10);
        如果 (!设上.正常) { 运行时错误(4); }
        c++;
    }
    字符串 出 = "";
    整64 p = 整64(位.大小()) - 1;
    当 (p > 0) {
        如果 (位.元素(整32(p)) != 0) { 中断; }
        p--;
    }
    整64 q = p;
    当 (q >= 0) {
        出 = 出 + 字符转字符串1029(48 + 位.元素(整32(q)));
        q--;
    }
    出 = 规范919(出);
    如果 (超u128域919(出)) { 返回 字符串复制(""); }
    返回 出;
}

// 919：无符号长除——商/余数出参（规范）；商超 u128 域=假（空串哨兵交调用方）。
//   逐位试商：余数串追加一位后连续减除数——上轮余数 < 除数 ⇒ 本轮当前
//   余数 < 除数×10 ⇒ 每轮减次数 ≤9（数学穷举·无溢出循环面）。
函数 无符长除919(字符串 被除, 字符串 除数, 字符串& 商出, 字符串& 余出) -> 布尔 {
    字符串 余 = "0";
    字符串 商 = "";
    整64 i = 0;
    整64 长 = 字符串长度(被除);
    当 (i < 长) {
        字符串 新位 = 字符串子串(被除, i, 1);
        // 余数落位（修 919 初版缺陷：原双 如果 使余=="0"替换为一位后又重复
        //   追加该位——"0"→"9"→"99" 试商商位翻倍多算；本形=条件清零后单次拼接）
        字符串 前缀余 = 余;
        如果 (字符串比较(余, "0")) { 前缀余 = ""; }
        余 = 规范919(前缀余 + 新位);
        整64 商位 = 0;
        当 (无符比较919(余, 除数) >= 0) {
            余 = 无符减919(余, 除数);
            商位 = 商位 + 1;
        }
        商 = 商 + 字符转字符串1029(48 + 商位);
        i++;
    }
    商 = 规范919(商);
    如果 (超u128域919(商)) { 返回 假; }
    商出 = 商;
    余出 = 余;
    返回 真;
}

// 919：十进制文本取负（"0" 归一·空串哨兵透传）
函数 数文本取负919(字符串 文本) -> 字符串 {
    整64 长 = 字符串长度(文本);
    如果 (长 == 0) { 返回 字符串复制(""); }
    如果 (字符串比较(文本, "0")) { 返回 字符串复制("0"); }
    如果 ((整64(文本[整32(0)]) & 255) == 45) { 返回 字符串子串(文本, 1, 长 - 1); }
    如果 ((整64(文本[整32(0)]) & 255) == 43) { 返回 字符串子串(文本, 1, 长 - 1); }
    返回 字符串复制("-") + 文本;
}

// 919：有符号加（规范形进出·空串哨兵透传）
函数 数文本加919(字符串 a, 字符串 b) -> 字符串 {
    字符串 数a = "";
    字符串 数b = "";
    布尔 负a = 拆符号919(a, 数a);
    布尔 负b = 拆符号919(b, 数b);
    数a = 规范919(数a);
    数b = 规范919(数b);
    字符串 幅 = "";
    布尔 负 = 假;
    如果 (负a == 负b) {
        幅 = 无符加919(数a, 数b);
        负 = 负a;
    }
    如果 (负a != 负b) {
        整64 比 = 无符比较919(数a, 数b);
        如果 (比 == 0) { 返回 字符串复制("0"); }
        如果 (比 == 1) {
            幅 = 无符减919(数a, 数b);
            负 = 负a;
        }
        如果 (比 == 0 - 1) {
            幅 = 无符减919(数b, 数a);
            负 = 负b;
        }
    }
    如果 (超u128域919(幅)) { 返回 字符串复制(""); }
    如果 (字符串比较(幅, "0")) { 返回 字符串复制("0"); }
    如果 (负) { 返回 字符串复制("-") + 幅; }
    返回 幅;
}

// 919：有符号减（a-b ≡ a+(-b)）
函数 数文本减919(字符串 a, 字符串 b) -> 字符串 {
    返回 数文本加919(a, 数文本取负919(b));
}

// 919：有符号乘
函数 数文本乘919(字符串 a, 字符串 b) -> 字符串 {
    字符串 数a = "";
    字符串 数b = "";
    布尔 负a = 拆符号919(a, 数a);
    布尔 负b = 拆符号919(b, 数b);
    字符串 幅 = 无符乘919(数a, 数b);
    如果 (字符串长度(幅) == 0) { 返回 字符串复制(""); }
    如果 (字符串比较(幅, "0")) { 返回 字符串复制("0"); }
    如果 (负a != 负b) { 返回 字符串复制("-") + 幅; }
    返回 幅;
}

// 919：有符号除（截断；商超 u128 域=错误通道——#1313 结果化·原空串哨兵）
//   除零由求值器先行分流不达本族；错误(1)=超域（调用方按「不可折叠超域」处置）。
函数 数文本除919(字符串 a, 字符串 b) -> 结果<字符串, 整32> {
    字符串 数a = "";
    字符串 数b = "";
    布尔 负a = 拆符号919(a, 数a);
    布尔 负b = 拆符号919(b, 数b);
    字符串 商 = "";
    字符串 余 = "";
    如果 (!无符长除919(规范919(数a), 规范919(数b), 商, 余)) { 返回 错误(1); }
    如果 (字符串比较(商, "0")) { 返回 正常(字符串复制("0")); }
    如果 (负a != 负b) { 返回 正常(字符串复制("-") + 商); }
    返回 正常(商);
}

// 919：有符号取余（截断·符号随被除数——C/Rust 口径与宿主 decTextMod919 同；
//   #1313 结果化：原空串哨兵改错误通道·错误(1)=超域）
函数 数文本取余919(字符串 a, 字符串 b) -> 结果<字符串, 整32> {
    字符串 数a = "";
    字符串 数b = "";
    布尔 负a = 拆符号919(a, 数a);
    布尔 负b = 拆符号919(b, 数b);
    如果 (负b) { }
    字符串 商 = "";
    字符串 余 = "";
    如果 (!无符长除919(规范919(数a), 规范919(数b), 商, 余)) { 返回 错误(1); }
    如果 (字符串比较(余, "0")) { 返回 正常(字符串复制("0")); }
    如果 (负a) { 返回 正常(字符串复制("-") + 余); }
    返回 正常(余);
}

// ==================== 常量表达式末节点 → 十进制文本（919） ====================

// 919：常量整数表达式求值（末节点递归·后缀平铺序契约=450）——全字面量算术
//   表达式（+ - * / %·一元 ±负号链）→ 规范十进制文本。
//   返回 真=常量可折叠（文本出=规范十进制文本驻留 ID·0=超 u128 域哨兵）；
//   返回 假=非常量形态（标识符/调用/成员/移位/位运算/比较/除零——消费方交
//   既有链）；字面量数值化失败（词法已拒形态=上游已诊断）按超域哨兵处置。
//   递归结构（450 全构建形态统一契约：二元节点 附加=右操作数起点）：
//     单节点字面量=字面量十进制文本 归一；二元=[左末=附加-1, 右末=末-1]
//     递归后按运算符文本四则；负号节点=前邻末递归后取负。
不安全 函数 常量末至十进制919(向量<节点> 池, 整32 末索引, 整64& 文本出) -> 布尔 {
    如果 (末索引 < 0 || 末索引 >= 整32(池.大小())) { 返回 假; }
    节点 n = 池.元素(末索引);
    如果 (n.类型 == 节点_整数字面量) {
        可选<字符串> 规范查 = 字面量十进制文本(字符串复制(驻留文本(整64(n.文本))));
        // 919 轮字面量数值化失败=词法已拒非法字面量形态（上游已诊断）→ 可选无值·超域哨兵交消费方按域拒
        如果 (!规范查.有值) {
            文本出 = 0;
            返回 真;
        }
        字符串 值 = 规范带符919(字符串复制(规范查.值));
        如果 (超u128域919(值)) {
            文本出 = 0;
            返回 真;
        }
        文本出 = 驻留(值);
        返回 真;
    }
    如果 (n.类型 == 节点_负号) {
        整64 子出 = 0;
        如果 (!常量末至十进制919(池, 末索引 - 1, 子出)) { 返回 假; }
        // 负号链超域哨兵传播：子表达式已定性超 u128 域（0=超域哨兵）
        如果 (子出 == 0) {
            文本出 = 0;
            返回 真;
        }
        文本出 = 驻留(数文本取负919(字符串复制(驻留文本(子出))));
        返回 真;
    }
    如果 (n.类型 == 节点_二元运算) {
        字符串 op = 字符串复制(驻留文本(整64(n.文本)));
        布尔 算术 = 字符串比较(op, "+") || 字符串比较(op, "-") ||
                    字符串比较(op, "*") || 字符串比较(op, "/") ||
                    字符串比较(op, "%");
        如果 (!算术) { 返回 假; }
        整64 左末 = 整64(n.附加) - 1;
        整64 右末 = 整64(末索引) - 1;
        如果 (左末 < 0 || 右末 < 0) { 返回 假; }
        整64 左出 = 0;
        整64 右出 = 0;
        如果 (!常量末至十进制919(池, 整32(左末), 左出)) { 返回 假; }
        如果 (!常量末至十进制919(池, 整32(右末), 右出)) { 返回 假; }
        // 超域哨兵传播：子表达式已定性超 u128 域（0=超域哨兵）
        如果 (左出 == 0 || 右出 == 0) {
            文本出 = 0;
            返回 真;
        }
        字符串 左v = 字符串复制(驻留文本(左出));
        字符串 右v = 字符串复制(驻留文本(右出));
        如果 (字符串比较(op, "/") || 字符串比较(op, "%")) {
            如果 (字符串比较(规范带符919(右v), "0")) { 返回 假; }   // 除零：交既有编译期除零链
        }
        字符串 四则值 = "";
        如果 (字符串比较(op, "+")) { 四则值 = 数文本加919(左v, 右v); }
        如果 (字符串比较(op, "-")) { 四则值 = 数文本减919(左v, 右v); }
        如果 (字符串比较(op, "*")) { 四则值 = 数文本乘919(左v, 右v); }
        // #1313：除/余结果化——错误(超域)=保持空串（下方 空串→超域哨兵 统一处置）
        如果 (字符串比较(op, "/")) {
            结果<字符串, 整32> 商果1313 = 数文本除919(左v, 右v);
            如果 (商果1313.正常) { 四则值 = 字符串复制(商果1313.值); }
        }
        如果 (字符串比较(op, "%")) {
            结果<字符串, 整32> 余果1313 = 数文本取余919(左v, 右v);
            如果 (余果1313.正常) { 四则值 = 字符串复制(余果1313.值); }
        }
        // 四则结果超 u128 域=空串显式哨兵（消费方按超域拒·910 空串口径）
        如果 (字符串长度(四则值) == 0) {
            文本出 = 0;
            返回 真;
        }
        文本出 = 驻留(四则值);
        返回 真;
    }
    返回 假;
}

// 919-final（2026-10-18 用户裁决「字面量单点判域·Rust 口径」·四边界定案）：
//   表达式区间子树扫描——区间（后缀平铺序·与 常量末至十进制919 同回推
//   契约：附加=右操作数起点）内任一**超 64 位承载**整数字面量（数学值 >
//   2^63-1 / 负值 < -2^63·折叠回绕静默错值面）超目标类型域 → 真（消费方拒）。
//   与求值面（常量末至十进制919）差异=不求值、含变量形态同扫（正是本轮
//   扩展面·边界2：19 位超 i64 字面量+变量=拒）；字面量逐个独立判域（执行
//   顺序无关·结果域内不豁免·边界3：20位%7 亦拒）。承载内字面量（如 300 对
//   整8）不属本判据面——由既有链管辖（285/788③ 窄域拉窄=位模式拉窄定义
//   语义·862/1078 锁；T36 值域门槛/溢出预演同链）。
//   负号壳：后缀序 [字面量][负号] 紧邻形态按数学负值判域（-9223372036854775808=
//   整64::MIN 承载内合法·「|值| 恰 2^63」不超负界限）；更外层负号（[表达式]
//   [负号] 壳住含字面量子树）不传播符号——壳内字面量按正形态判（仅「|值|
//   恰等于负界限」时与外壳符号相关·该边界形态宿主扫描同款按正形态判=
//   双侧同口径）。
//   判定单点=字面量十进制文本（1029 任意形态数值化）+ 数文本不超上界（承载
//   门槛）+ 字面量文本入域/字面量文本入域128_640 叠加（535 同款组合·128 域
//   叠加面承担）——禁散写第二份进制/后缀数值化判据。
不安全 函数 区间含超域字面量919(向量<节点> 池, 整32 末索引,
                              字符串 目标文本) -> 布尔 {
    // 扫描索引守卫（越界=非扫描面判定·算法边界）
    如果 (末索引 < 0 || 末索引 >= 整32(池.大小())) {
        返回 假;
    }
    节点 n = 池.元素(末索引);
    如果 (n.类型 == 节点_整数字面量) {
        布尔 负壳 = 末索引 + 1 < 整32(池.大小()) &&
                    池.元素(末索引 + 1).类型 == 节点_负号;
        可选<字符串> 十进制查 = 字面量十进制文本(字符串复制(驻留文本(整64(n.文本))));
        // 919-final 字面量数值化失败（词法已拒形态·上游已诊断）→ 可选无值按超域哨兵拒（910 空串口径）
        如果 (!十进制查.有值) { 返回 真; }
        字符串 数 = 规范919(字符串复制(十进制查.值));
        // 919-final 承载门槛：承载内字面量（64 位装得下·如 300 对 整8）不属本
        //   判据面——由既有链管辖（285/788③ 窄域拉窄=位模式拉窄定义语义·
        //   862/1078 锁：`甲8+300`→44 合法；T36 值域门槛/溢出预演同链）。
        如果 (数文本不超上界(数, 负壳 ? "9223372036854775808" : "9223372036854775807")) {
            // 承载内字面量不属本判据面：交既有链管辖（判定语义）
            返回 假;
        }
        布尔 入域 = 字面量文本入域(数, 目标文本, 负壳);
        如果 (入域) { 入域 = 字面量文本入域128_640(数, 目标文本, 负壳); }
        返回 !入域;
    }
    如果 (n.类型 == 节点_负号) {
        如果 (末索引 <= 0) { 返回 假; }   // 无操作数负号=畸形面（扫描索引守卫·算法边界）
        返回 区间含超域字面量919(池, 末索引 - 1, 目标文本);
    }
    如果 (n.类型 == 节点_二元运算) {
        整64 左末 = 整64(n.附加) - 1;
        整64 右末 = 整64(末索引) - 1;
        如果 (左末 < 0 || 右末 < 0) { 返回 假; }   // 扫描操作数索引守卫（越界=算法边界）
        如果 (区间含超域字面量919(池, 整32(左末), 目标文本)) { 返回 真; }
        返回 区间含超域字面量919(池, 整32(右末), 目标文本);
    }
    如果 (n.类型 == 节点_三元运算) {
        // 三段连续（协议常量 33）：条件[子起点,文本)·真[文本,附加)·假[附加,子终点)
        如果 (整64(n.文本) > 整64(n.子起点) &&
            区间含超域字面量919(池, 整32(整64(n.文本) - 1), 目标文本)) { 返回 真; }
        如果 (整64(n.附加) > 整64(n.文本) &&
            区间含超域字面量919(池, 整32(整64(n.附加) - 1), 目标文本)) { 返回 真; }
        如果 (整64(n.子终点) > 整64(n.附加)) {
            返回 区间含超域字面量919(池, 整32(整64(n.子终点) - 1), 目标文本);
        }
        返回 假;
    }
    如果 (n.类型 == 节点_赋值) {
        // 赋值表达式（894-a 链式赋值·070 波3）：右值物理在赋值根前 → 末索引-1
        如果 (末索引 <= 0) { 返回 假; }   // 无右值=畸形面（扫描索引守卫·算法边界）
        返回 区间含超域字面量919(池, 末索引 - 1, 目标文本);
    }
    // 收尾闭集穷举：调用/标识符/下标/成员/显式转换=非本扫描面
    //   （各自通道独立判域或运行期值）
    返回 假;
}
