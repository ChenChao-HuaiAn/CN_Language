// 生成函数初始化（1946 轮先拆再加：自 生成函数.cn 机械搬移·函数体逐字保留零行为变更）
// 职责：函数IR 装配辅助两族——211-a 字段显式初始化集（初始化函数信息字段·消费=
//   生成函数/生成lambda蹦床432/生成方法值蹦床943）+ 初始化签名与返回字段
//   （返回类型/窄宽码/结果/结构体/sret 面登记·消费=生成函数/生成类中 双面）。
// 加载序：居 生成函数 前加载（同包合并全局池解析·消费方零改动；先例=生成声明辅助 #1880 拆分）。
导入 容器::向量;
导入 映射集合;
导入 IR;         // 函数IR 数据结构 + IR_*/T_* 操作码（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:

// 211-a（2026-09-15 第两百一十一轮，D1 行数整改）：函数IR 字段显式初始化集（裸声明
//   字段无默认构造——lessons 权重7：不初始化即空指针/垃圾，v2p 半成品构建即崩根因）。
函数 初始化函数信息字段(函数IR& 函数信息) -> 空类型 {
    // 结构体裸声明不调用字段默认构造——容器字段须显式初始化（否则 .追加/.设置 空指针/垃圾）
    函数信息.指令 = 向量<IR指令>();
    函数信息.局部槽 = 映射<整64, 整64>();
    函数信息.参数槽 = 映射<整64, 整64>();
    函数信息.变量类型 = 映射<整64, 整64>();
    函数信息.结果预扫基们 = 映射<整64, 整64>();
    // 1946：容器预扫槽表同点显式清空（身份键=池索引跨函数可撞·残留=假命中错槽）
    函数信息.容器预扫槽们 = 映射<整64, 整64>();
    // plans/019 阶段4' 第二批：拥有型字符串名单/污染名单（裸声明字段须显式
    //   初始化——否则 .追加/.获取 空指针/垃圾，v2p 半成品构建即崩的根因）
    函数信息.字符串变量们 = 向量<整64>();
    函数信息.字符串数组变量们 = 向量<整64>();   // 98-a（C9）：字符串元素数组名单
    // 750：循环累积提升上下文按函数复位（正常路径由 生成循环/生成当 出口块
    //   成对清空；本行防识别成功后生成中途中止的跨函数残留）。函数级别名逃逸
    //   /lambda 预扫描在 生成函数 主体（池/块索引可用处，P0-1/P0-3）。
    清空累积上下文750();
    函数信息.循环数组串基线 = 0;                 // 98-a：跳出释放基线（同 循环串基线）
    // 1415：选择体基线四枚（选择内中断 drop-on-jump·生成选择语句 保存/恢复）
    函数信息.选择串基线 = 0;
    函数信息.选择容基线 = 0;
    函数信息.选择字段基线 = 0;
    函数信息.选择数组串基线 = 0;
    函数信息.字符串污染们 = 映射<整64, 整64>();
    函数信息.容器变量们 = 向量<整64>();
    函数信息.资源字段局部们 = 向量<整64>();
    函数信息.资源字段结构体们 = 向量<整64>();
    函数信息.参数槽序们 = 向量<整64>();
    函数信息.参数拷贝字节们 = 向量<整64>();
    // 槽计数终值（帧覆盖兜底·出口回填实际值）：0=未回填哨兵（扫描侧负值不竞争）
    函数信息.槽计数终值 = 0;
    // 91-a：参数类型码表（序言装载寄存器类分派；裸声明字段须显式初始化）
    函数信息.参数类型们 = 向量<整64>();
    // 73-a（2026-09-11 方案A 用户裁决）：释放点清零寄存器（预扫回填；无资源
    //   声明保持 0=无清零）——裸声明字段无默认构造，须显式初始化（lessons 权重7）
    函数信息.零寄存器 = 0;
    // 1818（#1784）：返回类名ID 构造点初始化（lessons 权重7·加字段同步全部
    //   构造点——生成函数/生成蹦床/方法值蹦床943 走本函数；生成方法/
    //   合成沿链析构体 各自手工补）
    函数信息.返回类名ID = 0;
}

// 211-a：签名键名+返回相关字段初始化——签名键（plans/018 第 4 层链接键）/返回类型/
//   引用返回（尾 &）/结构体返回 retbuf 槽保留（E2E 148）/结果返回 retbuf ABI（71-a）。
函数 初始化签名与返回字段(向量<节点> 池, 节点 函数声明, 整32 函数节点, 字符串 模块路径, 函数IR& 函数信息) -> 空类型 {
    // 呈报③方案A（2026-09-06）：函数 IR 名=签名键 名#参数串——跨文件同名重载
    //   asm 符号消歧（三后端 符号修饰 已支持 '#' 参数串类型编码，P7b 容器方法
    //   同链路验证；无参=纯名，与宿主 signatureKey/附录C 一致）
    // plans/018 第 4 层（2026-09-07）：定义侧升级链接键（键基#参数串，键基=
    //   主模块纯名/其余 模块$名）——与调用侧 决议函数符号 产物同公式同源
    //   （宿主 functionLinkKey 唯一归属对齐），跨模块同名同签名 asm 符号
    //   天然隔离；主模块/单文件形态逐字节不变（v2self 对拍硬基准）
    // 943（工单Ⅰ）：定义侧链接键经 统一链接键（克隆实例=纯名·无重载不拼
    //   参数串——修前恒拼=「核心$交换$整32#串」vs 调用侧「交换$整32」分叉）
    函数信息.名字 = 整32(统一链接键(
        键基合成(模块路径, 整64(函数声明.文本)),
        整64(函数声明.文本), 函数参数串(池, 函数节点)));
    设置当前生成符号ID(整64(函数信息.名字));   // 422-a：诊断宿主定位临时代码（定位后删）
    设当前函数实例名ID(整64(函数声明.文本));   // 799：泛型实例装箱替换语境（克隆体文本=实例合成名·非实例无 '$' 替换块自然跳过）
    函数信息.返回类型 = 类型码(整64(函数声明.附加));
    函数信息.返回结果名ID = 0;   // 71-a：裸声明字段无默认构造——显式初始化（lessons 权重7）
    函数信息.返回128位 = 0;      // 810（053）：同上——显式初始化
    函数信息.返回窄宽码 = 0;     // 565 轮（T33 残余根治）：同上——显式初始化
    函数信息.返回数组字节 = 0;   // 087b：同上——显式初始化
    // 引用返回（2026-09-04 缺陷零容忍收口，宿主 P3-18 对齐）：返回类型名尾 '&'
    //   （-> 整64&，语法层已并入）——返回语句按左值地址发射
    字符串 返回类型名r = 字符串复制(驻留文本(整64(函数声明.附加)));
    // 565 轮（T33 残余根治）：窄宽返回码登记——类型码() 对窄宽归 T_整64 不可用，
    //   从返回类型文本独立登记（生成返回语句 标量返回按此规范化回绕）；指针
    //   返回类型文本带尾 '*' → 窄宽码 0 直通（194 正8* 教训）
    函数信息.返回窄宽码 = 窄宽码自文本(返回类型名r);
    如果 (字符串长度(返回类型名r) > 0 &&
         ((整64(返回类型名r[字符串长度(返回类型名r) - 1]) & 255) == 38)) {
        函数信息.返回引用 = 1;
    }
    // 用户函数返回结构体（2026-09-04，E2E 148）：被调方槽 1 保留（调用方传入的
    //   retbuf 指针——prologue 位0 rcx 存入；IR_分配 附加=1 占位使帧扫描计入）
    // 639-a（001-001 接手 628 波 1·与 IR容器.cn 调用方分类翻转配套）：容器实例
    //   返回亦走 sret 被调形态（值拷贝·628 波 1 值语义同向）——原 595-a「容器
    //   恒标量」排除致调用方/被调方/元素存储三方 ABI 错位（996 探针数组越界
    //   守卫拦截实证）。生产态容器名查表 miss=等价零变化。
    // 1818（#1784 丁案 R1·001 §5.3 2026-10-29 用户批丁）：非容器用户类返回
    //   **排除 sret**——类=句柄语义（宿主 isStructType 查结构体表·类在类表
    //   两表分立→类返回无 sret·rax=句柄直传·ir_decl 同判据）。v2 类布局曾
    //   登记进结构体大小表（本体尺寸=字段累计）→「是结构体大小非零(类)=真」
    //   误入 retbuf 本体通道：被调方按本体尺寸（盒<整32>=4B）拷 retbuf（8 字节
    //   句柄截断）+调用方同判据预插 retbuf/按本体尺寸物化=1784 三形态错值实录。
    //   丁案立法：`-> 类名`=值副本（借用来源返回位 NewObject 副本·生成返回语句
    //   分派）/`-> 类名&`=借用共享（返回引用面不触）/拥有局部=句柄移交零拷贝。
    //   容器类实例返回**维持 retbuf**（值语义本体存储·628 波 1·127_v2 护栏）。
    函数信息.返回类名ID = 0;
    如果 (是用户类_ID(整64(函数声明.附加)) &&
         !是容器类_ID(整64(函数声明.附加)) && 函数信息.返回引用 == 0) {
        函数信息.返回类名ID = 整64(函数声明.附加);
    }
    如果 (是结构体大小非零(整64(函数声明.附加)) && 函数信息.返回类名ID == 0) {
        函数信息.返回结构体ID = 整64(函数声明.附加);
        IR追加(函数信息.指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 1));
    }
    // 71-a（2026-09-11 方案A 用户裁决）：用户函数返回 结果/可选——与结构体返回
    //   同款 retbuf ABI（结构体表查不到结果合成名，独立字段判定）：槽 1=retbuf
    //   指针保留（IR_分配 附加=1 占位）、返回语句把装箱值/结果变量拷入 retbuf、
    //   rax=retbuf；调用方（发射普通函数调用）位 0 装载 retbuf（互操作面：
    //   宿主 stdlib 包装返回 结果<> 同 ABI——布局 正常@0+值@4/8 双侧一致）
    // #1682（2026-10-27）：**引用返回互斥**——返回类型尾 &（返回引用=1·地址
    //   语义·928 口径）与 retbuf ABI（值拷贝语义）互斥。合成体引用返回
    //   （`可选<整64>& 取参(...)`）是结果类型_ID 前缀判定「可选<」命中不剥
    //   & → 误设 返回结果名ID（retbuf 槽占位+返回语句走值拷贝分支）——调用/
    //   被调两侧 ABI 错位面。补互斥守卫（整32&/货架& 面天然不触·102/1012）。
    如果 (函数信息.返回引用 == 0 && 函数信息.返回结构体ID == 0 &&
         是结果类型_ID(整64(函数声明.附加))) {
        函数信息.返回结果名ID = 整64(函数声明.附加);
        IR追加(函数信息.指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 1));
    }
    // 810（053）：128 位标量返回（整128/正128）——retbuf ABI 第三形态（结构体/
    //   结果之后）：槽 1=retbuf 指针保留（IR_分配 附加=1 占位）、返回语句双半
    //   拷 16 字节进 retbuf、rax=retbuf；调用方 retbuf 16 字节+返回寄存器登记
    //   T_整128/T_正128（值=retbuf 地址·宿主 i128 sret ABI 对齐）。
    如果 (函数信息.返回结构体ID == 0 && 函数信息.返回结果名ID == 0) {
        如果 (字符串比较(返回类型名r, "整128")) {
            函数信息.返回128位 = 1;
            IR追加(函数信息.指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 1));
        } 否则 如果 (字符串比较(返回类型名r, "正128")) {
            函数信息.返回128位 = 2;
            IR追加(函数信息.指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 1));
        }
    }
    // 087b（#087 余量·宿主 82984e4bbe 同构）：数组返回——retbuf ABI 第四形态
    //   （结构体/结果/128 之后）：返回类型文本为数组（"整32[3]"）→ 槽 1=retbuf
    //   指针保留、返回语句按字节数整块拷、rax=retbuf（宿主 ir_decl sret 判定
    //   扩 isArray·structReturnSize=typeSizeOf 同面；字节源=类型名宽度 967
    //   数组折叠·元素步进×长度）。判定置后于 128（文本互斥·条件全互斥防重入）。
    如果 (函数信息.返回结构体ID == 0 && 函数信息.返回结果名ID == 0 &&
         函数信息.返回128位 == 0 &&
         是数组类型文本(返回类型名r)) {
        整64 数组字节087b = 类型名宽度(整64(函数声明.附加));
        如果 (数组字节087b > 0) {
            函数信息.返回数组字节 = 数组字节087b;
            IR追加(函数信息.指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 1));
        }
    }
    设当前函数返回结果名ID(函数信息.返回结果名ID);   // 430-b（族③）装箱语境（含 0 复位）
    设当前方法名ID(0);                               // 205：普通函数=无方法语境（复位）
}
