// CN 自举编译器 v2 · 生成表达式——运算符重载降级族（#414·宿主 ir_oop_call.cpp
//   handleOperatorOverload / handleUnaryOperatorOverload 同构）
// 职责：二元左操作数/一元操作数为用户类实例且类沿继承链有「运算符X」成员时，
//   降级为成员方法调用发射（宿主「this=左操作数指针，实参=右操作数」同款）——
//   发射复用 发射用户类方法调用 既有 ABI（聚合返回 retbuf/标量类型登记/引用
//   返回 lvalue-to-rvalue/虚槽分派全走既有路径）；未命中返回 假=调用方回退
//   内置运算指令（宿主 return false 同构——重载决议顺序③内置守卫兜底）。
// 方法名约定：类体解析层组合名「运算符X」（语义收集按普通方法登记类方法表）。
// 包依赖：IR 包自持符号集判定（334 单向依赖——IR 不可导入 语义 包；语义包
//   语义检查重载.cn 持对齐副本，两处集合须同步维护）。
导入 容器::向量;
导入 映射集合;
导入 IR;
导入 协议常量;
导入 IR生成;
导入 生成表达式求值;

公开:

// 二元重载决议拦截集（宿主 operatorSymText 映射面同款：算术五算子+比较六算子；
//   位运算五算子不在映射面=类位运算走内置守卫拒·与语义包 是二元重载符号 同步）
函数 重载二元符号414(字符串 op名) -> 布尔 {
    返回 字符串比较(op名, "+") || 字符串比较(op名, "-") ||
          字符串比较(op名, "*") || 字符串比较(op名, "/") ||
          字符串比较(op名, "%") || 字符串比较(op名, "==") ||
          字符串比较(op名, "!=") || 字符串比较(op名, "<") ||
          字符串比较(op名, ">") || 字符串比较(op名, "<=") ||
          字符串比较(op名, ">=");
}

// 重载感知末端类型推导：既有 解析节点类型ID（标识符/成员/调用/三元）miss(0)
//   时补二元/一元重载返回类型递归推导——链式 (甲+乙)+丙 的左末端=内层二元
//   节点，外层命中判定经本函数递归取内层重载产物类型（宿主 exprSrcType 对
//   BinaryExpr 读 resolvedType 写回的 v2 无节点写回替代形态）。
//   1541 B2 可选化：有值=重载产物类型 ID（恒 >0）；无值=不可推导。
函数 解析重载节点类型ID(向量<节点> 池, 整32 节点索引) -> 可选<整64> {
    节点 n = 池.元素(节点索引);
    可选<整64> 基查 = 解析节点类型ID(池, 节点索引);
    如果 (基查.有值) {
        整64 基ID = 0;
        如果 (基查.有值) { 基ID = 基查.值; }
        返回 某些(基ID);
    }
    如果 (n.类型 == 节点_二元运算) {
        字符串 op名 = 字符串复制(驻留文本(整64(n.文本)));
        如果 (!重载二元符号414(op名)) { 返回 无; }
        如果 (n.附加 <= 0 || n.附加 > 整32(池.大小())) { 返回 无; }
        可选<整64> 左查 = 解析重载节点类型ID(池, 整32(n.附加) - 1);
        如果 (!左查.有值) { 返回 无; }
        整64 左ID = 0;
        如果 (左查.有值) { 左ID = 左查.值; }
        如果 (!是用户类ID(左ID)) { 返回 无; }
        整64 方法名ID = 整64(驻留("运算符" + op名));
        // 1541 B2：无值=沿链无此方法（原 0 判据）
        可选<整64> 定义查 = 查类方法定义层(左ID, 方法名ID);
        如果 (!定义查.有值) { 返回 无; }
        整64 定义层 = 0;
        如果 (定义查.有值) { 定义层 = 定义查.值; }
        // 1541 B2：无值=方法表返回缺登记（原 0=不可推导承接）
        可选<整64> 二元返查 = 查类方法返回(定义层, 方法名ID);
        如果 (!二元返查.有值) { 返回 无; }
        整64 二元返 = 0;
        如果 (二元返查.有值) { 二元返 = 二元返查.值; }
        返回 某些(二元返);
    }
    如果 (n.类型 == 节点_负号 || n.类型 == 节点_逻辑非 || n.类型 == 节点_位非) {
        如果 (n.子终点 <= n.子起点 || n.子终点 > 整32(池.大小())) { 返回 无; }
        字符串 op名u = "";
        如果 (n.类型 == 节点_负号) { op名u = "-"; }
        否则 如果 (n.类型 == 节点_逻辑非) { op名u = "!"; }
        否则 { op名u = "~"; }
        可选<整64> 操作数查 = 解析重载节点类型ID(池, 整32(n.子终点) - 1);
        如果 (!操作数查.有值) { 返回 无; }
        整64 操作数ID = 0;
        如果 (操作数查.有值) { 操作数ID = 操作数查.值; }
        如果 (!是用户类ID(操作数ID)) { 返回 无; }
        整64 方法名IDu = 整64(驻留("运算符" + op名u));
        // 1541 B2：无值=沿链无此方法（原 0 判据）
        可选<整64> 定义查u = 查类方法定义层(操作数ID, 方法名IDu);
        如果 (!定义查u.有值) { 返回 无; }
        整64 定义层u = 0;
        如果 (定义查u.有值) { 定义层u = 定义查u.值; }
        // 1541 B2：无值=方法表返回缺登记（原 0=不可推导承接）
        可选<整64> 单目返查 = 查类方法返回(定义层u, 方法名IDu);
        如果 (!单目返查.有值) { 返回 无; }
        整64 单目返 = 0;
        如果 (单目返查.有值) { 单目返 = 单目返查.值; }
        返回 某些(单目返);
    }
    返回 无;
}

// 537（2026-10-13）：单目重载结果类型推导收口（507 判定扩面·三消费点单一
//   事实源）：节点为单目表达式形态（负号/逻辑非/位非 节点类型判定·非文本
//   特判）时经 解析重载节点类型ID 推导重载返回类型；非单目形态=0（调用方
//   行为不变）。消费点=①右值偏移兜底（507·生成表达式字段.cn）；②方法调用
//   接收者类型推导（537·解析方法对象类型扩展）；③成员左值写偏移兜底
//   （537·解析成员链结构体ID）——宿主 exprSrcType UnaryExpr 读 resolvedType
//   写回的多消费点同构面（465/507 零分叉基准）。
//   1541 B2：下游 解析重载节点类型ID 已可选化——本函数保持 0=不可推导契约
//   （三存量消费点按 >0/==0 判据分流），无值路径在此单点还原 0。
函数 解析单目重载结果类型ID(向量<节点> 池, 整32 节点索引) -> 整64 {
    节点 n537 = 池.元素(节点索引);
    如果 (n537.类型 != 节点_负号 && n537.类型 != 节点_逻辑非 &&
          n537.类型 != 节点_位非) {
        返回 0;
    }
    可选<整64> 重载查537 = 解析重载节点类型ID(池, 节点索引);
    如果 (!重载查537.有值) { 返回 0; }
    整64 重载ID537 = 0;
    如果 (重载查537.有值) { 重载ID537 = 重载查537.值; }
    返回 重载ID537;
}

// 二元运算符重载降级（生成二元运算主体 挂点·左右操作数已弹栈）：左末端
//   （附加-1·970 索引口径）类型为用户类且沿链命中「运算符X」→ 发射用户类
//   方法调用（this=左，实参=[右]·重载决议顺序②），产物由发射侧压栈。
//   返回 真=已处理（调用方直接返回）；假=未命中（调用方走内置运算指令）。
不安全 函数 发射运算符重载二元(向量<节点> 池, 节点 n, 字符串 op名,
                    整64 左, 整64 右, 向量<IR指令>& 指令,
                    整64* 寄存器计数, 整64* 槽计数, 向量<整64>& 表达式栈) -> 布尔 {
    如果 (!重载二元符号414(op名)) { 返回 假; }
    如果 (n.附加 <= 0 || n.附加 > 整32(池.大小())) { 返回 假; }
    可选<整64> 左查414 = 解析重载节点类型ID(池, 整32(n.附加) - 1);
    如果 (!左查414.有值) { 返回 假; }
        整64 左ID = 0;
        如果 (左查414.有值) { 左ID = 左查414.值; }
        布尔 左非类414 = !是用户类ID(左ID);
        如果 (左非类414) { 返回 假; }
    字符串 类名 = 字符串复制(驻留文本(左ID));
    字符串 方法名 = "运算符" + op名;
    // 1541 B2：无值=沿链无「运算符」重载（原 0 判据）
    可选<整64> 二元定义查414 = 查类方法定义层(左ID, 整64(驻留(方法名)));
    如果 (!二元定义查414.有值) { 返回 假; }
    向量<整64> 弹出们414 = 向量<整64>();
    结果<空类型, 整32> 加实414 = 弹出们414.追加(右);
    如果 (!加实414.正常) { 运行时错误(4); }
    // retbuf序号=1（生成表达式 P7b 单 retbuf 复用序号·同链惯例）
    发射用户类方法调用(类名, 方法名, 左, 弹出们414, 1, 指令,
                      寄存器计数, 槽计数, 表达式栈, 1, 假);
    返回 真;
}

// 一元运算符重载降级（生成一元运算 挂点·操作数已求值）：操作数末端
//   （子终点-1）类型为用户类且沿链命中「运算符- / 运算符! / 运算符~」（0 右参
//   单目·宿主 P2-14 同构）→ 发射用户类方法调用（this=操作数，无右实参）。
//   P0-3：位非不再解析期脱糖——命中「运算符~」由此发射（宿主 operatorSymText
//   Tilde 同款）；未命中由 生成一元运算 位非分支展开 x^(0-1)。
//   返回 真=已处理；假=未命中。
不安全 函数 发射运算符重载一元(向量<节点> 池, 节点 n, 整64 操作数,
                    向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数,
                    向量<整64>& 表达式栈) -> 布尔 {
    字符串 op名414 = "";
    如果 (n.类型 == 节点_负号) { op名414 = "-"; }
    否则 如果 (n.类型 == 节点_逻辑非) { op名414 = "!"; }
    否则 如果 (n.类型 == 节点_位非) { op名414 = "~"; }
    否则 { 返回 假; }
    如果 (n.子终点 <= n.子起点 || n.子终点 > 整32(池.大小())) { 返回 假; }
    可选<整64> 操作数查414 = 解析重载节点类型ID(池, 整32(n.子终点) - 1);
    如果 (!操作数查414.有值) { 返回 假; }
    整64 操作数ID = 0;
    如果 (操作数查414.有值) { 操作数ID = 操作数查414.值; }
    布尔 操作数非类414 = !是用户类ID(操作数ID);
    如果 (操作数非类414) { 返回 假; }
    字符串 类名 = 字符串复制(驻留文本(操作数ID));
    字符串 方法名 = "运算符" + op名414;
    // 1541 B2：无值=沿链无「运算符」重载（原 0 判据）
    可选<整64> 一元定义查414 = 查类方法定义层(操作数ID, 整64(驻留(方法名)));
    如果 (!一元定义查414.有值) { 返回 假; }
    向量<整64> 弹出们414 = 向量<整64>();
    发射用户类方法调用(类名, 方法名, 操作数, 弹出们414, 0, 指令,
                      寄存器计数, 槽计数, 表达式栈, 1, 假);
    返回 真;
}
