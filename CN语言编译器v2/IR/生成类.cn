// CN 自举编译器 v2 · 类 IR 生成（第七十八轮，2026-09-12）
// 职责：用户自定义类的 IR 生成三件套——①生成方法（this 上下文函数级生成单元，
//   与 生成函数 同构）；②类对象局部（分配+构造+RAII 登记）；③方法体字段访问与
//   类方法调用/构造调用的分派发射。
// 对象模型（对齐宿主 + v2 容器对象）：类对象=堆对象指针（__cn_object_new），
//   this=参数位0（SysV rdi / win rcx——prologue 按 参数槽序们 顺序装载）；
//   字段访问=this 槽加载 → IR_字段地址(偏移) → IR_指针加载/存储；
//   方法符号=类$方法[#参数串]、构造=类$类名[#参数串]、析构=类$~类名（宿主
//   classMethodSymbol 同公式——移植纪律 9 双编译对照锚定）。
// RAII（对齐宿主 ir_decl.cpp 口径）：有析构类的局部对象登记 容器变量们 名单
//   → 出口 IR_删除对象（代码生成展开 call ~类 + __cn_object_delete）；无析构类
//   不释放（宿主既有语义——浅共享保守，移植纪律 7 不变量）。
// 字段解析协议（与语义/生成分层对应）：方法体内字段裸名在 生成标识符加载/
//   生成赋值语句/生成左值地址 三处经 当前方法字段偏移 分派（局部/参数槽查询
//   之后——遮蔽语义=局部/参数优先）。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_* 常量
导入 IR;         // IR_*/T_* 操作码 + 类表/布局查询/符号合成
导入 IR生成;     // 程序IR 布局 + 类型码/权威表/控制流辅助

公开:

// 当前方法上下文（生成方法 设置/复位；0=非方法体——字段分派据此关闭）
静态 整64 当前方法类名ID = 0;
静态 整64 当前方法this槽 = 0;
// 430-b（族③ 收口）：当前函数返回 结果/可选 类型名ID（0=非结果返回）——
//   克隆体 正常()/错误() 装箱语境兜底（语义层标注发生在实例化前的基类体，
//   克隆节点子终点=0 未标注；返回位装箱=结果方法常态·宿主 handleResultCtor
//   语境推导同构）。生成方法/生成函数 每函数设置（含 0 复位防串味）。
静态 整64 当前函数返回结果名ID全局 = 0;

不安全 函数 设当前函数返回结果名ID(整64 类型ID) -> 空类型 {
    当前函数返回结果名ID全局 = 类型ID;
}

函数 取当前函数返回结果名ID() -> 整64 {
    返回 当前函数返回结果名ID全局;
}

// 名字是否当前方法所在类的字段（命中返回字段偏移；-1=非字段/非方法体）。
//   类维度经 查字段偏移 键基解析（本模块键基域——与解析期登记同域）。
函数 当前方法字段偏移(整64 名ID) -> 整64 {
    如果 (当前方法类名ID == 0) { 返回 0 - 1; }
    返回 查字段偏移(当前方法类名ID, 名ID);
}

// 字段地址发射（this 槽加载 → IR_字段地址）：返回字段地址寄存器。
//   读路径（调用方 指针加载）/写路径（调用方 指针存储）共用。
不安全 函数 发射类字段地址(整64 字段偏移量, 向量<IR指令>& 指令,
                   整64* 寄存器计数) -> 整64 {
    整64 基址寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 当前方法this槽, 0, 0, 基址寄存器, T_对象, 0));
    整64 地址寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 基址寄存器, 0, 0, 地址寄存器, T_整64,
                         字段偏移量));
    返回 地址寄存器;
}

// 方法体内字段读取（生成标识符加载 的字段分派出口）：压值到表达式栈。
//   宽度按字段类型（窄宽 movzx 族/正32 四字节零扩展——查字段宽度码）；
//   类型登记（打印分派/拼接转换/二元符号性消费）。
不安全 函数 发射类字段读取(整64 字段偏移量, 整64 字段名ID, 向量<IR指令>& 指令,
                   整64* 寄存器计数, 向量<整64>& 表达式栈) -> 空类型 {
    整64 地址寄存器 = 发射类字段地址(字段偏移量, 指令, 寄存器计数);
    // 435-b 根治：指针字段（类型文本尾 '*'）读取宽度恒 T_整64——字段值=8 字节
    //   指针；原按 字段宽度表（所指元素宽，整32→4）加载=指针截断→后续解引用
    //   SEGV（390 撤守卫 向量<整32> 实测 r10=堆指针低 32 位）
    整64 宽度码 = T_整64;
    整64 字段类型IDw = 查字段类型ID(当前方法类名ID, 字段名ID);
    如果 (字段类型IDw > 0) {
        字符串 字段文本w = 字符串复制(驻留文本(字段类型IDw));
        整64 长w = 字符串长度(字段文本w);
        如果 (长w > 0 && !字符串比较(字符串子串(字段文本w, 整32(长w - 1), 1), "*")) {
            整64 表宽w = 查字段宽度码(当前方法类名ID, 字段名ID);
            如果 (表宽w != T_未知) { 宽度码 = 表宽w; }
        }
    }
    整64 值寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 地址寄存器, 0, 0, 值寄存器, 宽度码, 0));
    整64 字段类型ID = 查字段类型ID(当前方法类名ID, 字段名ID);
    如果 (字段类型ID != 0) {
        整64 字段类型码 = 类型码(字段类型ID);
        如果 (字段类型码 != T_未知) {
            登记寄存器类型(值寄存器, 字段类型码);
        }
    }
    结果<空类型, 整32> 加 = 表达式栈.追加(值寄存器);
    如果 (!加.正常) { 运行时错误(4); }
}

// ==================== 方法生成 ====================
// 生成方法：类方法体的函数级 IR 生成单元（与 生成函数 同构，差异三点）——
//   ①名字=方法链接符号（构造=类$类名、析构=类$~类名、普通=类$方法[#参数串]）；
//   ②this 槽=参数位0（参数槽序们 首个——prologue 装载位0 到该槽）；
//   ③当前方法上下文（类名/this 槽）在体生成期间设置、结束复位。
//   返回类型附加=0（构造/析构）→ 空类型归一。
不安全 函数 生成方法(向量<节点> 池, 整32 方法节点索引, 整32 类节点索引,
                  字符串 模块路径) -> 函数IR {
    函数IR 函数信息;
    函数信息.指令 = 向量<IR指令>();
    函数信息.局部槽 = 映射<整64, 整64>();
    函数信息.参数槽 = 映射<整64, 整64>();
    函数信息.变量类型 = 映射<整64, 整64>();
    函数信息.字符串变量们 = 向量<整64>();
    函数信息.字符串污染们 = 映射<整64, 整64>();
    函数信息.容器变量们 = 向量<整64>();
    // 98-a（C9）：类方法函数IR 构造点同步新字段（lessons 67 坑：加字段须同步
    //   **全部**构造点——生成函数 + 生成类；首版漏此=类方法名单未初始化，
    //   编译 228 类用例时 v2p 自身空指针崩溃，全量 E2E 拦截）
    函数信息.字符串数组变量们 = 向量<整64>();
    函数信息.循环数组串基线 = 0;
    函数信息.资源字段局部们 = 向量<整64>();
    函数信息.资源字段结构体们 = 向量<整64>();
    函数信息.参数槽序们 = 向量<整64>();
    函数信息.参数拷贝字节们 = 向量<整64>();
    // 91-a：参数类型码表（序言装载寄存器类分派；this=首个 T_对象 整型类）
    函数信息.参数类型们 = 向量<整64>();
    函数信息.零寄存器 = 0;
    清空函数级槽表();
    清空当前函数变量类型();
    节点 方法声明 = 池.元素(方法节点索引);
    // 215-a（2026-09-16 第两百一十五轮，D1 行数整改）：链符号推导（构造/析构/普通
    //   三形态）迁 生成方法链符号；返回相关字段+块计数/尾块/模块路径迁
    //   初始化方法签名与返回字段。
    整64 类名ID = 整64(池.元素(类节点索引).文本);
    // 641-a（414-a 波 2 补全·单态化实例类型绑定）：实例名剥基名+实参、查泛型
    //   基类参数序（"K,V"）按位配对→设绑定（类型名宽度 对类型参数解析消费——
    //   映射.设置 类型大小(V) 折叠链·113/79_v2/524 同源面）。
    字符串 实例文本b = 字符串复制(驻留文本(类名ID));
    如果 (首分段位置(实例文本b) >= 0) {
        整64 基名IDb = 驻留(剥实例基名(实例文本b));
        整64 参数序IDb = 查泛型基类参数序(基名IDb);
        如果 (参数序IDb != 0) {
            字符串 参数序b = 字符串复制(驻留文本(参数序IDb));
            向量<整64> 绑定参数们b = 向量<整64>();
            向量<整64> 绑定实参们b = 向量<整64>();
            整64 ibb = 0;
            字符串 当前段b = 字符串复制("");
            整64 序长b = 字符串长度(参数序b);
            当 (ibb <= 序长b) {
                字符串 字符b = 字符串复制("");
                如果 (ibb < 序长b) { 字符b = 字符串子串(参数序b, 整32(ibb), 1); }
                如果 (ibb == 序长b || 字符串比较(字符b, ",")) {
                    如果 (字符串长度(当前段b) > 0) {
                        结果<空类型, 整32> 加pb = 绑定参数们b.追加(驻留(当前段b));
                        如果 (!加pb.正常) { 运行时错误(4); }
                        当前段b = 字符串复制("");
                    }
                } 否则 {
                    当前段b = 字符串复制(当前段b + 字符b);
                }
                ibb++;
            }
            剥实例参数段(实例文本b, 绑定实参们b);
            设实例类型绑定(绑定参数们b, 绑定实参们b);
        }
    }
    布尔 是析构器 = 假;
    函数信息.名字 = 生成方法链符号(池, 方法节点索引, 类节点索引, 是析构器);
    设置当前生成符号ID(整64(函数信息.名字));   // 422-a：类方法生成宿主标记（定位后删）
    初始化方法签名与返回字段(池, 方法声明, 模块路径, 函数信息);
    整64 寄存器计数 = 1;
    整64 槽计数 = 1;
    如果 (函数信息.返回结构体ID != 0 || 函数信息.返回结果名ID != 0) { 槽计数 = 2; }
    // this 槽（位0）：参数槽序们 首个 → prologue 装载第一个参数寄存器
    整64 槽this = 槽计数;
    槽计数 = 槽计数 + 1;
    结果<空类型, 整32> 设this = 函数信息.参数槽.设置(驻留("$自身"), 槽this);
    如果 (!设this.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加this序 = 函数信息.参数槽序们.追加(槽this);
    如果 (!加this序.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加this拷 = 函数信息.参数拷贝字节们.追加(0);
    如果 (!加this拷.正常) { 运行时错误(4); }
    // 91-a：this 参数类型码=T_对象（对象指针，整型寄存器类）
    结果<空类型, 整32> 加this类 = 函数信息.参数类型们.追加(T_对象);
    如果 (!加this类.正常) { 运行时错误(4); }
    当前方法类名ID = 类名ID;
    当前方法this槽 = 槽this;
    // 「自身」登记（方法体 this 引用——IR 层 生成标识符加载 特判出口；
    //   类型=类名 ID 供 自身.方法() 的对象类型解析）
    结果<空类型, 整32> 设自 = 函数信息.变量类型.设置(驻留("自身"), 类名ID);
    如果 (!设自.正常) { 运行时错误(4); }
    登记当前函数变量类型(驻留("自身"), 类名ID);
    // 字段变量类型登记（方法对象类型解析/字段容器方法调用——容器/结果/类对象
    //   字段入 函数信息.变量类型；结构体字段入权威表）
    登记类字段类型们(池, 类节点索引, 函数信息);
    // 参数（位1 起——this 已占位0）
    向量<整64> 表达式栈 = 向量<整64>();
    整64 参数起点 = 整64(方法声明.子起点);
    整32 块索引 = 方法声明.子终点;
    整64 参数终点 = 参数起点;
    如果 (块索引 < 池.大小()) {
        节点 块节点m = 池.元素(块索引);
        参数终点 = 整64(块节点m.子起点);
    }
    整64 参数位置 = 参数起点;
    当 (参数位置 < 参数终点) {
        节点 参数 = 池.元素(整32(参数位置));
        如果 (参数.类型 == 节点_参数) {
            登记参数槽(池, 参数, 函数信息, &槽计数);
            // 423-b（族②）：方法参数的函数级变量类型登记（对齐 生成函数 参数
            //   遍历 262-280——引用参数 其他（映射& 其他）的成员链解析数据源；
            //   缺失=解析对象结构体ID miss→字段偏移兜底 0·dbg 偏移 铁证）
            如果 (参数.附加 > 0 && 参数.附加 < 整64(池.大小())) {
                节点 参数类型节点m2 = 池.元素(整32(参数.附加));
                如果 (参数类型节点m2.类型 == 节点_类型) {
                    // 423-b（族② 根治）：方法参数的函数级变量类型登记——
                    //   **本类引用/值参数（类型文本=本类基名±&）→登记为本实例
                    //   合成名 ID**（dbg 偏移 铁证：基名登记→布局键 miss→
                    //   解析对象结构体ID=0→字段偏移兜底全 miss）。
                    //   对齐 生成函数 参数遍历 262-280 的权威表惯例。
                    字符串 类型文本m2 = 字符串复制(驻留文本(整64(参数类型节点m2.文本)));
                    整64 文本长m2 = 字符串长度(类型文本m2);
                    如果 (文本长m2 > 0 && 字符串比较(字符串子串(类型文本m2, 文本长m2 - 1, 1), "&")) {
                        类型文本m2 = 字符串复制(字符串子串(类型文本m2, 0, 文本长m2 - 1));
                    }
                    字符串 基名m2 = 剥实例基名(字符串复制(驻留文本(类名ID)));
                    如果 (字符串比较(类型文本m2, 基名m2)) {
                        登记当前函数变量类型(整64(参数.文本), 类名ID);
                        }
                    // 515-a（T70 B1 三层③·**对齐 生成函数 参数遍历（缺陷①根治）**）：
                    //   **全部**形参类型入函数级权威表（容器/结果另入 函数信息.变量类型
                    //   对象解析表）。原方法侧只登记「本类参数」→ 其余形参类型推导
                    //   **miss** → 类型名转换 `整64(键)` 落引用/对象分支**多一次
                    //   指针加载**（把标量形参当地址解引用）→ 产物散列=垃圾 → 桶索引
                    //   溢出 → 链查找 `mov (%r10),%r10` 段错误（127 撤守卫态铁证：
                    //   宿主版同函数=直取值无加载·v2 版多一跳）。
                    如果 (是容器类(类型文本m2) || 是结果类型(类型文本m2)) {
                        结果<空类型, 整32> 设参类m = 函数信息.变量类型.设置(
                            整64(参数.文本), 整64(参数类型节点m2.文本));
                        如果 (!设参类m.正常) { 运行时错误(4); }
                        登记当前函数变量类型(整64(参数.文本), 整64(参数类型节点m2.文本));
                    } 否则 {
                        登记当前函数变量类型(整64(参数.文本), 整64(参数类型节点m2.文本));
                    }
                }
            }
        }
        参数位置++;
    }
    如果 (块索引 < 池.大小()) {
        预扫容器声明(池, 块索引, 函数信息, &槽计数, &寄存器计数);
    }
    // 605-a（001-001·218 归因）：**映射值串释放注入**（宿主 ir_oop_container.cpp
    //   emitClassMethod 注入同构）——stdlib 映射 的 ~映射/清空/释放内部数组 源码
    //   本体只 free 四数组（值数组 free 不级联串），值串释放靠编译器注入：
    //   全量三方法体首注 __cn_map_free_strings(this,键偏,值偏,数偏,kStr,vStr)；
    //   析构键值/析构值 注 __cn_map_free_slot(this,键偏,值偏,索引,freeK,freeV)。
    //   撤守卫态 stdlib 源码级编译缺此注入=值串泄漏（218 ⑥⑦ 实锤）。
    //   时序：体首注入先于方法体任何调用发射（调用实参收集展开无错位）。
    字符串 方法名z = 字符串复制(驻留文本(整64(方法声明.文本)));
    字符串 类名z = 字符串复制(驻留文本(类名ID));
    如果 (字符串比较(合成名基名(类名z), "映射")) {
        // 605-a 勘误：是析构器 判定=「~」+全合成名 比较——克隆体源码名「~映射」
        //   恒不匹配 → 析构器注入漏（初版实测 释放内部数组 命中/~映射 漏）——
        //   改用 方法名 == "~" + 剥实例基名 直接判定。
        字符串 基z = 剥实例基名(类名z);
        布尔 全量z = 字符串比较(方法名z, "~" + 基z) ||
                     字符串比较(方法名z, "清空") ||
                     字符串比较(方法名z, "释放内部数组");
        布尔 单槽z = 字符串比较(方法名z, "析构键值") || 字符串比较(方法名z, "析构值");
        如果 (全量z || 单槽z) {
            字符串 首段z = 合成名首实参(类名z);
            布尔 k串z = 字符串比较(段首(首段z), "字符串");
