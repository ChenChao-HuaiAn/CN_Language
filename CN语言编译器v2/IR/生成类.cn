                                    索寄w = 寄存器计数;
                                    寄存器计数 = 寄存器计数 + 1;
                                    IR追加(函数信息.指令, 建IR指令(IR_加载, 找索w.值, 0, 0, 索寄w,
                                                         T_整64, 0));
                                    有索w = 真;
                                } 否则 {
                                    字符串 索名w = "头索引";
                                    如果 (字符串比较(方法名z, "删除尾部")) { 索名w = "尾索引"; }
                                    整64 索偏w = 当前方法字段偏移(驻留(索名w));
                                    如果 (索偏w >= 0) {
                                        整64 址寄w = 寄存器计数;
                                        寄存器计数 = 寄存器计数 + 1;
                                        IR追加(函数信息.指令, 建IR指令(IR_字段地址, this寄w, 0, 0, 址寄w,
                                                             T_整64, 索偏w));
                                        索寄w = 寄存器计数;
                                        寄存器计数 = 寄存器计数 + 1;
                                        IR追加(函数信息.指令, 建IR指令(IR_指针加载, 址寄w, 0, 0, 索寄w,
                                                             T_整64, 0));
                                        有索w = 真;
                                    }
                                }
                            }
                            // 每串字段路径一次调用（嵌套已展开为扁平内联偏移）——
                            //   三分支参数序独立发射（与运行时辅助 ABI 逐位对齐）：
                            整64 piw = 0;
                            当 (piw < 路径们w.大小()) {
                                整64 路偏w = 路径们w.元素(piw);
                                整64 位w = 0;
                                整64 辅名w = 0;
                                IR追加(函数信息.指令, 建IR指令(IR_调用实参, this寄w, 0, 0, 0, 位w, 0));
                                位w++;
                                整64 组寄w = 寄存器计数;
                                寄存器计数 = 寄存器计数 + 1;
                                IR追加(函数信息.指令, 建IR指令(IR_常量整数, 整64(驻留(整数转字符串(数组偏w))),
                                                     0, 0, 组寄w, T_整64, 0));
                                IR追加(函数信息.指令, 建IR指令(IR_调用实参, 组寄w, 0, 0, 0, 位w, 0));
                                位w++;
                                如果 (全量w) {
                                    如果 (链式w) {
                                        整64 下一偏w = 当前方法字段偏移(驻留("下一索引"));
                                        整64 头偏w = 当前方法字段偏移(驻留("头索引"));
                                        如果 (下一偏w < 0 || 头偏w < 0) {
                                            piw++;
                                            继续;
                                        }
                                        整64 邻寄w = 寄存器计数;
                                        寄存器计数 = 寄存器计数 + 1;
                                        IR追加(函数信息.指令, 建IR指令(IR_常量整数, 整64(驻留(整数转字符串(下一偏w))),
                                                             0, 0, 邻寄w, T_整64, 0));
                                        IR追加(函数信息.指令, 建IR指令(IR_调用实参, 邻寄w, 0, 0, 0, 位w, 0));
                                        位w++;
                                        整64 头寄w = 寄存器计数;
                                        寄存器计数 = 寄存器计数 + 1;
                                        IR追加(函数信息.指令, 建IR指令(IR_常量整数, 整64(驻留(整数转字符串(头偏w))),
                                                             0, 0, 头寄w, T_整64, 0));
                                        IR追加(函数信息.指令, 建IR指令(IR_调用实参, 头寄w, 0, 0, 0, 位w, 0));
                                        位w++;
                                        整64 数寄w = 寄存器计数;
                                        寄存器计数 = 寄存器计数 + 1;
                                        IR追加(函数信息.指令, 建IR指令(IR_常量整数, 整64(驻留(整数转字符串(数量偏w))),
                                                             0, 0, 数寄w, T_整64, 0));
                                        IR追加(函数信息.指令, 建IR指令(IR_调用实参, 数寄w, 0, 0, 0, 位w, 0));
                                        位w++;
                                        辅名w = 驻留("__cn_chain_free_field_strings");
                                    } 否则 {
                                        整64 数寄w = 寄存器计数;
                                        寄存器计数 = 寄存器计数 + 1;
                                        IR追加(函数信息.指令, 建IR指令(IR_常量整数, 整64(驻留(整数转字符串(数量偏w))),
                                                             0, 0, 数寄w, T_整64, 0));
                                        IR追加(函数信息.指令, 建IR指令(IR_调用实参, 数寄w, 0, 0, 0, 位w, 0));
                                        位w++;
                                        辅名w = 驻留("__cn_vector_free_field_strings");
                                    }
                                } 否则 {
                                    如果 (!有索w) {
                                        piw++;
                                        继续;
                                    }
                                    IR追加(函数信息.指令, 建IR指令(IR_调用实参, 索寄w, 0, 0, 0, 位w, 0));
                                    位w++;
                                    辅名w = 驻留("__cn_seq_free_field_slot");
                                }
                                整64 步寄w = 寄存器计数;
                                寄存器计数 = 寄存器计数 + 1;
                                IR追加(函数信息.指令, 建IR指令(IR_常量整数, 整64(驻留(整数转字符串(步长w))),
                                                     0, 0, 步寄w, T_整64, 0));
                                IR追加(函数信息.指令, 建IR指令(IR_调用实参, 步寄w, 0, 0, 0, 位w, 0));
                                位w++;
                                整64 路寄w = 寄存器计数;
                                寄存器计数 = 寄存器计数 + 1;
                                IR追加(函数信息.指令, 建IR指令(IR_常量整数, 整64(驻留(整数转字符串(路偏w))),
                                                     0, 0, 路寄w, T_整64, 0));
                                IR追加(函数信息.指令, 建IR指令(IR_调用实参, 路寄w, 0, 0, 0, 位w, 0));
                                位w++;
                                IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 位w, 0, 0, 0, 0, 辅名w));
                                piw++;
                            }
                        }
                    }
                }
            }
        }
    }
    // 702-a（051 主线·697-b 析构链缺口）：容器 **元素析构链注入**——stdlib
    //   ~向量 源码只 释放(数据)，元素 T 的析构无人调；宿主在 ~容器 方法体**前**
    节点 本方法析构w = 池.元素(方法节点索引);
    字符串 本方法名w = 字符串复制(驻留文本(整64(本方法析构w.文本)));
    // 115 同构扩（070 攻族·2026-10-05）：清空() 与 ~容器 同为全量析构挂点（宿主
    //   isFull = ~类名 || 清空 同语义）——v2 原只认 ~ 前缀，清空 路径元素析构全缺
    //   （115 实测 清空后 析构计数少 2）。
    如果 ((字符串长度(本方法名w) > 1 && ((整64(本方法名w[0]) & 255) == 126)) ||
         字符串比较(本方法名w, "清空")) {
        注入元素析构链(池, 类节点索引, 函数信息, &寄存器计数, &槽计数);
    }
    // 860-a（058 挂账②·H7 字段版 v2 同构）：构造函数序言类字段级联构造——
    //   构造判定=方法名==剥实例基名（生成方法链符号 构造形态同款）；拷贝构造
    {
        字符串 基名g = 剥实例基名(类名z);
        布尔 是构造g = 字符串比较(方法名z, 基名g);
        布尔 是拷贝g = 假;
        如果 (是构造g) {
            整64 参数数g = 0;
            字符串 首参类型g = 字符串复制("");
            整64 参数起点g = 整64(方法声明.子起点);
            整32 块索引g = 方法声明.子终点;
            整64 参数终点g = 参数起点g;
            如果 (块索引g < 整64(池.大小())) {
                参数终点g = 整64(池.元素(块索引g).子起点);
            }
            整64 参数位置g = 参数起点g;
            当 (参数位置g < 参数终点g) {
                节点 参数g = 池.元素(整32(参数位置g));
                如果 (参数g.类型 == 节点_参数) {
                    参数数g++;
                    如果 (参数数g == 1 && 参数g.附加 >= 0 &&
                         参数g.附加 < 整64(池.大小())) {
                        节点 参数类型节点g = 池.元素(整32(参数g.附加));
                        首参类型g = 字符串复制(驻留文本(整64(参数类型节点g.文本)));
                        整64 首长g = 字符串长度(首参类型g);
                        当 (首长g > 1 &&
                            ((整64(首参类型g[整32(首长g - 1)]) & 255) == 38)) {
                            首参类型g = 字符串复制(
                                字符串子串(首参类型g, 0, 整32(首长g - 1)));
                            首长g--;
                        }
                    }
                }
                参数位置g++;
            }
            // 860-a 甄别修正（218 红灯二分实锤）：比较用**全实例名**（类名z）——
            //   泛型实例拷贝构造首参=「向量$映射$整64$字符串&」剥 & 后=全实例名，
            是拷贝g = (参数数g == 1 && 字符串比较(首参类型g, 类名z));
        }
        如果 (是构造g && !是拷贝g) {
            // 234：父构造调用先于字段级联（C++ 序：基类→成员→体）
            注入父构造调用(池, 类名ID, 整64(方法声明.文本), 函数信息, &寄存器计数, &槽计数,
                           表达式栈, 函数信息.局部槽, 函数信息.参数槽);
            注入构造字段级联(池, 类节点索引, 函数信息, &寄存器计数);
        }
    }
    布尔 体终止m = 假;
    如果 (块索引 < 池.大小()) {
        体终止m = 生成块(池, 块索引, 函数信息.局部槽, 函数信息.参数槽, 函数信息,
                         &寄存器计数, &槽计数, 表达式栈, 函数信息.返回类型);
    }
    如果 (!体终止m) {
        // 析构器：字段级联析构注入（宿主 injectFieldCascadeDestroy 同款——
        //   体末尾、默认返回前按字段逆序释放「有析构类型」字段；体尾提前 返回
        //   不覆盖 = C++ 成员析构同语义边界）
        如果 (是析构器) {
            注入析构字段级联(池, 类节点索引, 函数信息, &寄存器计数);
            // 278（021 任务 278·#263 遗留缺口·375 实测）：**父析构级联**——
            //   ~派生 体末自动调 ~基类（C++ 成员析构后基类析构同序·构造级联
            //   注入父构造调用 对称面·原缺失=继承链析构序错 375 实录）。
            注入父析构调用(类名ID, 函数信息, &寄存器计数);
        }
        发射容器析构(函数信息, 函数信息.指令, &寄存器计数, 函数信息.局部槽, 0);
        发射字符串释放(函数信息, 函数信息.指令, &寄存器计数, 函数信息.局部槽, 0);
    }
    // 514-a（T70 B1 三层②）：容器**元素钩子注入**——「移动元素」stdlib 契约=
    //   空体 + 编译器按元素类型注入（宿主 injectMoveElemDestroy 同构·81-a）。
    如果 (方法名是本元素钩子(方法声明, "移动元素")) {
        注入元素移动体(池, 类节点索引, 函数信息, &寄存器计数, &槽计数);
    }
    // 115 同构扩（070 攻族·2026-10-05）：「析构元素(索引)」钩子=移位循环单点
    //   释放（stdlib 删除/插入 移位前调·宿主 emitSingleElemRelease 同构）——
    //   v2 原零注入=被删/被移槽资源无人释放（115 实测 删除后析构 0 应 1）。
    如果 (方法名是本元素钩子(方法声明, "析构元素")) {
        注入元素单析构(池, 类节点索引, 函数信息, &寄存器计数, &槽计数);
    }
    发射跳转(函数信息, 函数信息.函数尾块);
    切换块(函数信息, 函数信息.函数尾块);
    发射块标签(函数信息, 函数信息.函数尾块);
    函数信息.retbuf字节数 = 取retbuf字节数();
    当前方法类名ID = 0;
    当前方法this槽 = 0;
    返回 函数信息;
}


