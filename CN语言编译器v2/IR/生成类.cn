// CN 自举编译器 v2 · 类 IR 生成（第七十八轮，2026-09-12）
// 职责：用户自定义类的 IR 生成三件套——①生成方法（this 上下文函数级生成单元，
//   与 生成函数 同构）；②类对象局部（分配+构造+RAII 登记）；③方法体字段访问与
//   类方法调用/构造调用的分派发射。
// 对象模型（对齐宿主 + v2 容器对象）：类对象=堆对象指针（__cn_object_new），
//   this=参数位0（SysV rdi / win rcx——prologue 按 参数槽序们 顺序装载）；
//   字段访问=this 槽加载 → IR_字段地址(偏移) → IR_指针加载/存储；
//   方法符号=类$方法[#参数串]、构造=类$类名[#参数串]、析构=类$~类名（宿主
//   classMethodSymbol 同公式——移植纪律 9 双编译对照锚定）。
// RAII（对齐宿主 ir_decl.cpp 口径）：有析构类的局部对象登记 容器变量们 名单
//   → 出口 IR_删除对象（代码生成展开 call ~类 + __cn_object_delete）；无析构类
//   不释放（宿主既有语义——浅共享保守，移植纪律 7 不变量）。
// 字段解析协议（与语义/生成分层对应）：方法体内字段裸名在 生成标识符加载/
//   生成赋值语句/生成左值地址 三处经 当前方法字段偏移 分派（局部/参数槽查询
//   之后——遮蔽语义=局部/参数优先）。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_* 常量
导入 IR;         // IR_*/T_* 操作码 + 类表/布局查询/符号合成
导入 IR生成;     // 程序IR 布局 + 类型码/权威表/控制流辅助

公开:

// 当前方法上下文（生成方法 设置/复位；0=非方法体——字段分派据此关闭）
静态 整64 当前方法类名ID = 0;
静态 整64 当前方法this槽 = 0;
// 430-b（族③ 收口）：当前函数返回 结果/可选 类型名ID（0=非结果返回）——
//   克隆体 正常()/错误() 装箱语境兜底（语义层标注发生在实例化前的基类体，
//   克隆节点子终点=0 未标注；返回位装箱=结果方法常态·宿主 handleResultCtor
//   语境推导同构）。生成方法/生成函数 每函数设置（含 0 复位防串味）。
静态 整64 当前函数返回结果名ID全局 = 0;

不安全 函数 设当前函数返回结果名ID(整64 类型ID) -> 空类型 {
    当前函数返回结果名ID全局 = 类型ID;
}

函数 取当前函数返回结果名ID() -> 整64 {
    返回 当前函数返回结果名ID全局;
}

// 名字是否当前方法所在类的字段（命中返回字段偏移；-1=非字段/非方法体）。
//   类维度经 查字段偏移 键基解析（本模块键基域——与解析期登记同域）。
函数 当前方法字段偏移(整64 名ID) -> 整64 {
    如果 (当前方法类名ID == 0) { 返回 0 - 1; }
    返回 查字段偏移(当前方法类名ID, 名ID);
}

// 字段地址发射（this 槽加载 → IR_字段地址）：返回字段地址寄存器。
//   读路径（调用方 指针加载）/写路径（调用方 指针存储）共用。
不安全 函数 发射类字段地址(整64 字段偏移量, 向量<IR指令>& 指令,
                   整64* 寄存器计数) -> 整64 {
    整64 基址寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 当前方法this槽, 0, 0, 基址寄存器, T_对象, 0));
    整64 地址寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 基址寄存器, 0, 0, 地址寄存器, T_整64,
                         字段偏移量));
    返回 地址寄存器;
}

// 方法体内字段读取（生成标识符加载 的字段分派出口）：压值到表达式栈。
//   宽度按字段类型（窄宽 movzx 族/正32 四字节零扩展——查字段宽度码）；
//   类型登记（打印分派/拼接转换/二元符号性消费）。
不安全 函数 发射类字段读取(整64 字段偏移量, 整64 字段名ID, 向量<IR指令>& 指令,
                   整64* 寄存器计数, 向量<整64>& 表达式栈) -> 空类型 {
    整64 地址寄存器 = 发射类字段地址(字段偏移量, 指令, 寄存器计数);
    整64 宽度码 = 查字段宽度码(当前方法类名ID, 字段名ID);
    整64 值寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 地址寄存器, 0, 0, 值寄存器, 宽度码, 0));
    整64 字段类型ID = 查字段类型ID(当前方法类名ID, 字段名ID);
    如果 (字段类型ID != 0) {
        整64 字段类型码 = 类型码(字段类型ID);
        如果 (字段类型码 != T_未知) {
            登记寄存器类型(值寄存器, 字段类型码);
        }
    }
    结果<空类型, 整32> 加 = 表达式栈.追加(值寄存器);
    如果 (!加.正常) { 运行时错误(4); }
}

// ==================== 方法生成 ====================
// 生成方法：类方法体的函数级 IR 生成单元（与 生成函数 同构，差异三点）——
//   ①名字=方法链接符号（构造=类$类名、析构=类$~类名、普通=类$方法[#参数串]）；
//   ②this 槽=参数位0（参数槽序们 首个——prologue 装载位0 到该槽）；
//   ③当前方法上下文（类名/this 槽）在体生成期间设置、结束复位。
//   返回类型附加=0（构造/析构）→ 空类型归一。
不安全 函数 生成方法(向量<节点> 池, 整32 方法节点索引, 整32 类节点索引,
                  字符串 模块路径) -> 函数IR {
    函数IR 函数信息;
    函数信息.指令 = 向量<IR指令>();
    函数信息.局部槽 = 映射<整64, 整64>();
    函数信息.参数槽 = 映射<整64, 整64>();
    函数信息.变量类型 = 映射<整64, 整64>();
    函数信息.字符串变量们 = 向量<整64>();
    函数信息.字符串污染们 = 映射<整64, 整64>();
    函数信息.容器变量们 = 向量<整64>();
    // 98-a（C9）：类方法函数IR 构造点同步新字段（lessons 67 坑：加字段须同步
    //   **全部**构造点——生成函数 + 生成类；首版漏此=类方法名单未初始化，
    //   编译 228 类用例时 v2p 自身空指针崩溃，全量 E2E 拦截）
    函数信息.字符串数组变量们 = 向量<整64>();
    函数信息.循环数组串基线 = 0;
    函数信息.资源字段局部们 = 向量<整64>();
    函数信息.资源字段结构体们 = 向量<整64>();
    函数信息.参数槽序们 = 向量<整64>();
    函数信息.参数拷贝字节们 = 向量<整64>();
    // 91-a：参数类型码表（序言装载寄存器类分派；this=首个 T_对象 整型类）
    函数信息.参数类型们 = 向量<整64>();
    函数信息.零寄存器 = 0;
    清空函数级槽表();
    清空当前函数变量类型();
    节点 方法声明 = 池.元素(方法节点索引);
    // 215-a（2026-09-16 第两百一十五轮，D1 行数整改）：链符号推导（构造/析构/普通
    //   三形态）迁 生成方法链符号；返回相关字段+块计数/尾块/模块路径迁
    //   初始化方法签名与返回字段。
    整64 类名ID = 整64(池.元素(类节点索引).文本);
    布尔 是析构器 = 假;
    函数信息.名字 = 生成方法链符号(池, 方法节点索引, 类节点索引, 是析构器);
    设置当前生成符号ID(整64(函数信息.名字));   // 422-a：类方法生成宿主标记（定位后删）
    初始化方法签名与返回字段(池, 方法声明, 模块路径, 函数信息);
    整64 寄存器计数 = 1;
    整64 槽计数 = 1;
    如果 (函数信息.返回结构体ID != 0 || 函数信息.返回结果名ID != 0) { 槽计数 = 2; }
    // this 槽（位0）：参数槽序们 首个 → prologue 装载第一个参数寄存器
    整64 槽this = 槽计数;
    槽计数 = 槽计数 + 1;
    结果<空类型, 整32> 设this = 函数信息.参数槽.设置(驻留("$自身"), 槽this);
    如果 (!设this.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加this序 = 函数信息.参数槽序们.追加(槽this);
    如果 (!加this序.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加this拷 = 函数信息.参数拷贝字节们.追加(0);
    如果 (!加this拷.正常) { 运行时错误(4); }
    // 91-a：this 参数类型码=T_对象（对象指针，整型寄存器类）
    结果<空类型, 整32> 加this类 = 函数信息.参数类型们.追加(T_对象);
    如果 (!加this类.正常) { 运行时错误(4); }
    当前方法类名ID = 类名ID;
    当前方法this槽 = 槽this;
    // 「自身」登记（方法体 this 引用——IR 层 生成标识符加载 特判出口；
    //   类型=类名 ID 供 自身.方法() 的对象类型解析）
    结果<空类型, 整32> 设自 = 函数信息.变量类型.设置(驻留("自身"), 类名ID);
    如果 (!设自.正常) { 运行时错误(4); }
    登记当前函数变量类型(驻留("自身"), 类名ID);
    // 字段变量类型登记（方法对象类型解析/字段容器方法调用——容器/结果/类对象
    //   字段入 函数信息.变量类型；结构体字段入权威表）
    登记类字段类型们(池, 类节点索引, 函数信息);
    // 参数（位1 起——this 已占位0）
    向量<整64> 表达式栈 = 向量<整64>();
    整64 参数起点 = 整64(方法声明.子起点);
    整32 块索引 = 方法声明.子终点;
    整64 参数终点 = 参数起点;
    如果 (块索引 < 池.大小()) {
        节点 块节点m = 池.元素(块索引);
        参数终点 = 整64(块节点m.子起点);
    }
    整64 参数位置 = 参数起点;
    当 (参数位置 < 参数终点) {
        节点 参数 = 池.元素(整32(参数位置));
        如果 (参数.类型 == 节点_参数) {
            登记参数槽(池, 参数, 函数信息, &槽计数);
            // 423-b（族②）：方法参数的函数级变量类型登记（对齐 生成函数 参数
            //   遍历 262-280——引用参数 其他（映射& 其他）的成员链解析数据源；
            //   缺失=解析对象结构体ID miss→字段偏移兜底 0·dbg 偏移 铁证）
            如果 (参数.附加 > 0 && 参数.附加 < 整64(池.大小())) {
                节点 参数类型节点m2 = 池.元素(整32(参数.附加));
                如果 (参数类型节点m2.类型 == 节点_类型) {
                    // 423-b（族② 根治）：方法参数的函数级变量类型登记——
                    //   **本类引用/值参数（类型文本=本类基名±&）→登记为本实例
                    //   合成名 ID**（dbg 偏移 铁证：基名登记→布局键 miss→
                    //   解析对象结构体ID=0→字段偏移兜底全 miss）。
                    //   对齐 生成函数 参数遍历 262-280 的权威表惯例。
                    字符串 类型文本m2 = 字符串复制(驻留文本(整64(参数类型节点m2.文本)));
                    整64 文本长m2 = 字符串长度(类型文本m2);
                    如果 (文本长m2 > 0 && 字符串比较(字符串子串(类型文本m2, 文本长m2 - 1, 1), "&")) {
                        类型文本m2 = 字符串复制(字符串子串(类型文本m2, 0, 文本长m2 - 1));
                    }
                    字符串 基名m2 = 剥实例基名(字符串复制(驻留文本(类名ID)));
                    如果 (字符串比较(类型文本m2, 基名m2)) {
                        登记当前函数变量类型(整64(参数.文本), 类名ID);
                        }
                }
            }
        }
        参数位置++;
    }
    如果 (块索引 < 池.大小()) {
        预扫容器声明(池, 块索引, 函数信息, &槽计数, &寄存器计数);
    }
    布尔 体终止m = 假;
    如果 (块索引 < 池.大小()) {
        体终止m = 生成块(池, 块索引, 函数信息.局部槽, 函数信息.参数槽, 函数信息,
                         &寄存器计数, &槽计数, 表达式栈, 函数信息.返回类型);
    }
    如果 (!体终止m) {
        // 析构器：字段级联析构注入（宿主 injectFieldCascadeDestroy 同款——
        //   体末尾、默认返回前按字段逆序释放「有析构类型」字段；体尾提前 返回
        //   不覆盖 = C++ 成员析构同语义边界）
        如果 (是析构器) {
            注入析构字段级联(池, 类节点索引, 函数信息, &寄存器计数);
        }
        发射容器析构(函数信息, 函数信息.指令, &寄存器计数, 函数信息.局部槽, 0);
        发射字符串释放(函数信息, 函数信息.指令, &寄存器计数, 函数信息.局部槽, 0);
    }
    发射跳转(函数信息, 函数信息.函数尾块);
    切换块(函数信息, 函数信息.函数尾块);
    发射块标签(函数信息, 函数信息.函数尾块);
    函数信息.retbuf字节数 = 取retbuf字节数();
    当前方法类名ID = 0;
    当前方法this槽 = 0;
    返回 函数信息;
}


// 215-a：族① 方法链接符号推导——构造=类$类名、析构=类$~类名（方法名ID==类名ID///   方法名文本 == "~"+类名文本 判定）、普通=类$方法[#参数串]。
不安全 函数 生成方法链符号(向量<节点> 池, 整32 方法节点索引, 整32 类节点索引, 布尔& 是析构器) -> 整32 {
    节点 方法声明 = 池.元素(方法节点索引);
    整64 类名ID = 整64(池.元素(类节点索引).文本);
    字符串 类名文本 = 字符串复制(驻留文本(类名ID));
    整64 方法名ID = 整64(方法声明.文本);
    字符串 方法名文本 = 字符串复制(驻留文本(方法名ID));
    字符串 参数串 = 函数参数串(池, 方法节点索引);
    字符串 链符号 = 方法符号(类名文本, 方法名文本, 参数串);
    如果 (方法名ID == 类名ID) {
        链符号 = 方法符号(类名文本, 类名文本, 参数串);   // 构造：类$类名[#参数串]
    } 否则 如果 (字符串比较(方法名文本, "~" + 类名文本)) {
        链符号 = 析构符号(类名文本);                     // 析构：类$~类名
        是析构器 = 真;                     // 析构：类$~类名
    }
    返回 整32(驻留(链符号));
}

// 215-a：族② 方法签名与返回字段初始化——返回类型附加=0 归一空类型/返回结构体 retbuf/
//   结果返回 retbuf（71-a）/块计数/循环基线三枚/函数尾块（缺陷A）/retbuf 回填复位/
//   模块路径窗口。
不安全 函数 初始化方法签名与返回字段(向量<节点> 池, 节点 方法声明, 字符串 模块路径, 函数IR& 函数信息) -> 空类型 {
    整64 返回类型ID = 整64(方法声明.附加);
    如果 (返回类型ID == 0) { 返回类型ID = 驻留("空类型"); }
    函数信息.返回类型 = 类型码(返回类型ID);
    函数信息.返回结果名ID = 0;
    函数信息.返回结构体ID = 0;
    如果 (查结构体大小(返回类型ID) != 0) {
        函数信息.返回结构体ID = 返回类型ID;
        IR追加(函数信息.指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 1));
    } 否则 如果 (是结果类型(字符串复制(驻留文本(返回类型ID)))) {
        函数信息.返回结果名ID = 返回类型ID;
        IR追加(函数信息.指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 1));
    }
    设当前函数返回结果名ID(函数信息.返回结果名ID);   // 430-b（族③）装箱语境
    函数信息.块计数 = 0;
    函数信息.当前块 = 0;
    函数信息.循环出口块 = 0;
    函数信息.循环继续块 = 0;
    函数信息.循环串基线 = 0;
    函数信息.循环容基线 = 0;
    函数信息.循环字段基线 = 0;
    函数信息.函数尾块 = 新块(函数信息);
    复位retbuf字节数();
    设当前模块路径(模块路径);
}


// 类字段类型登记（生成方法 调用）：遍历类区间 节点_类字段 —— 容器/结果/类对象
//   字段入 函数信息.变量类型（方法对象类型解析数据源）+ 全部字段入函数级权威表
//   （打印分派/拼接转换/字段读类型码消费）。
函数 登记类字段类型们(向量<节点> 池, 整32 类节点索引, 函数IR& 函数信息) -> 空类型 {
    节点 类节点 = 池.元素(类节点索引);
    整64 位置 = 整64(类节点.子起点);
    当 (位置 < 整64(类节点.子终点)) {
        节点 候选 = 池.元素(整32(位置));
        如果 (候选.类型 == 节点_类字段) {
            如果 (候选.附加 >= 0 && 候选.附加 < 整64(池.大小())) {
                节点 类型节点f = 池.元素(整32(候选.附加));
                整64 字段类型ID = 整64(类型节点f.文本);
                字符串 字段类型文本 = 字符串复制(驻留文本(字段类型ID));
                // 432-b 根治：指针字段类型文本补 '*' 规范化——类型节点附加=
                //   指针层 1..255（文本本身无星），原登记丢层→下标读推导
                //   miss→字符串回退（123 桶数组[i] __cn_str_len SEGV 实测）。
                //   逐层补星（最多 255 防御上限）。
                整64 指针层f = 类型节点f.附加;
                如果 (指针层f >= 1 && 指针层f <= 255) {
                    字符串 星串f = "";
                    整64 星i = 0;
                    当 (星i < 指针层f) {
                        星串f = 字符串复制(星串f + "*");
                        星i++;
                    }
                    字段类型文本 = 字符串复制(字段类型文本 + 星串f);
                    字段类型ID = 整64(驻留(字段类型文本));
                }
                如果 (是容器类(字段类型文本) || 是结果类型(字段类型文本) ||
                     是用户类(字段类型文本)) {
                    结果<空类型, 整32> 设类f = 函数信息.变量类型.设置(
                        整64(候选.文本), 字段类型ID);
                    如果 (!设类f.正常) { 运行时错误(4); }
                }
                登记当前函数变量类型(整64(候选.文本), 字段类型ID);
            }
        }
        位置++;
    }
}

// 析构字段级联注入（第七十八轮；宿主 ir_oop.cpp injectFieldCascadeDestroy 同款）：
//   ~类 体末尾按字段逆序对「有析构类型」字段（容器/结果类型、有析构用户类）发射
//   this 槽加载 → 字段地址(偏移) → 指针加载 → IR_删除对象（代码生成展开
//   call ~字段类型 + __cn_object_delete，空安全 test/je）。只对有析构类型注入
//   （无析构类/标量/字符串字段=不注入——对齐宿主 isClassType+hasDtor 判据）。
不安全 函数 注入析构字段级联(向量<节点> 池, 整32 类节点索引, 函数IR& 函数信息,
                    整64* 寄存器计数) -> 空类型 {
    节点 类节点 = 池.元素(类节点索引);
    整64 类名ID = 整64(类节点.文本);
    向量<整64> 偏移们c = 向量<整64>();
    向量<整64> 类型们c = 向量<整64>();
    整64 位置 = 整64(类节点.子起点);
    当 (位置 < 整64(类节点.子终点)) {
        节点 成员 = 池.元素(整32(位置));
        如果 (成员.类型 == 节点_类字段) {
            整64 字段类型IDc = 0;
            如果 (成员.附加 >= 0 && 成员.附加 < 整64(池.大小())) {
                节点 类型节点c = 池.元素(整32(成员.附加));
                字段类型IDc = 整64(类型节点c.文本);
            }
            如果 (字段类型IDc != 0) {
                字符串 字段类型文本c = 字符串复制(驻留文本(字段类型IDc));
                布尔 有析构c = 假;
                如果 (是容器类(字段类型文本c) || 是结果类型(字段类型文本c)) {
                    有析构c = 真;
                } 否则 如果 (是用户类(字段类型文本c)) {
                    如果 (类有析构(字段类型IDc)) { 有析构c = 真; }
                }
                如果 (有析构c) {
                    整64 偏移c = 查字段偏移(类名ID, 整64(成员.文本));
                    如果 (偏移c >= 0) {
                        结果<空类型, 整32> 加偏 = 偏移们c.追加(偏移c);
                        如果 (!加偏.正常) { 运行时错误(4); }
                        结果<空类型, 整32> 加型 = 类型们c.追加(字段类型IDc);
                        如果 (!加型.正常) { 运行时错误(4); }
                    }
                }
            }
        }
        位置++;
    }
    整64 kc = 偏移们c.大小();
    当 (kc > 0) {
        kc--;
        整64 地址c = 发射类字段地址(偏移们c.元素(kc), 函数信息.指令, 寄存器计数);
        整64 对象c = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(函数信息.指令, 建IR指令(IR_指针加载, 地址c, 0, 0, 对象c, T_对象, 0));
        IR追加(函数信息.指令, 建IR指令(IR_删除对象, 对象c, 0, 0, 寄存器计数[0],
                             0, 类型们c.元素(kc)));
        寄存器计数[0] = 寄存器计数[0] + 1;
    }
}

// ==================== 类对象局部与调用发射 ====================
// 生成类对象局部（生成变量声明 的类对象分派出口）：
//   槽分配 + 零初始化 + 类型登记 + RAII 登记（有析构类） + 初始化三形态——
//   构造调用（分配+构造+存槽）/ 无初始化（分配+无参构造）；标识符拷贝=显式
//   拒绝（第一版边界：类对象拷贝构造符号不存在——不静默降级）。
不安全 函数 生成类对象局部(向量<节点> 池, 节点 n, 节点 类型节点,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    字符串 类型文本 = 字符串复制(驻留文本(整64(类型节点.文本)));
    整64 类名ID = 整64(类型节点.文本);
    整64 槽c = 槽计数[0];
    槽计数[0] = 槽计数[0] + 1;
    结果<空类型, 整32> 设槽 = 局部槽.设置(整64(n.文本), 槽c);
    如果 (!设槽.正常) { 运行时错误(4); }
    整64 零reg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零reg, T_整64, 0));
    IR追加(指令, 建IR指令(IR_存储, 零reg, 0, 0, 0, 0, 槽c));
    结果<空类型, 整32> 设类v = 函数信息.变量类型.设置(整64(n.文本), 类名ID);
    如果 (!设类v.正常) { 运行时错误(4); }
    登记当前函数变量类型(整64(n.文本), 类名ID);
    如果 (类有析构(类名ID)) {
        名单追加去重(函数信息.容器变量们, 整64(n.文本));
    }
    布尔 是构造初值 = 假;
    如果 (n.子起点 < n.子终点) {
        节点 初末 = 池.元素(n.子终点 - 1);
        如果 (初末.类型 == 节点_调用 && 初末.子起点 >= 0) {
            节点 初被调 = 池.元素(整32(初末.子起点));
            如果 (初被调.类型 == 节点_标识符 &&
                 字符串比较(驻留文本(整64(初被调.文本)), 类型文本)) {
                是构造初值 = 真;
            } 否则 如果 (初被调.类型 == 节点_标识符) {
                // 276-a（D28 根治·2026-09-17）：导入类裸名经解析期 B1 改写为
                //   「模块::类」限定形态，callee 文本≠声明位类型文本→合法构造
                //   初始化被误拒（「类对象初始化仅支持构造调用」·随机数生成器
                //   冒烟实锤）。判定补限定名拆基名比对——拆限定名 :: 取尾段
                //   ==类型文本 同判构造初值（plans/021 §3-D D28 挂点方案）。
                字符串 被调文本 = 字符串复制(驻留文本(整64(初被调.文本)));
                字符串 改写模块 = "";
                字符串 改写符号 = "";
                如果 (拆限定名(被调文本, 改写模块, 改写符号) == 1 &&
                     字符串比较(改写符号, 类型文本)) {
                    是构造初值 = 真;
                }
            }
        }
    }
    如果 (n.子起点 < n.子终点 && !是构造初值) {
        IR层诊断("类对象初始化仅支持构造调用（类 " + 类型文本 +
                      "；拷贝/其它形态随后续轮次）");
        运行时错误(6);
    }
    如果 (是构造初值) {
        整64 obj寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                     指令, 寄存器计数, &函数信息.块计数, 槽计数,
                                     表达式栈);
        如果 (obj寄存器 != 0) {
            IR追加(指令, 建IR指令(IR_存储, obj寄存器, 0, 0, 0, 0, 槽c));
        }
        当 (表达式栈.大小() > 0) {
            结果<空类型, 整32> 删栈g = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈g.正常) { 运行时错误(4); }
        }
        返回;
    }
    // 无初始化：分配 + 无参构造（宿主 ir_decl.cpp「无初始化表达式：NewObject +
    //   无参构造（this=新对象）」同款）
    整64 obj寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, obj寄存器,
                         查结构体大小(类名ID), 类名ID));
    IR追加(指令, 建IR指令(IR_调用实参, obj寄存器, 0, 0, 0, 0, 0));
    // 416-a（D42 波 2）：构造方法名=基名（剥实例基名·非泛型类原文返回）——
    //   泛型实例符号=实例$基名（对齐定义侧链符号 克隆体普通方法 类$方法）
    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                         驻留(方法符号(类型文本, 剥实例基名(类型文本), ""))));
    IR追加(指令, 建IR指令(IR_存储, obj寄存器, 0, 0, 0, 0, 槽c));
}

// 用户类构造调用发射（生成转换或构造调用 的用户类分派出口）：
//   分配对象 → this=位0 + 实参位1.. → 类$类名[#参数串] → 对象指针压栈。
//   参数串取定义侧登记值（第一版无构造重载——实参数不匹配=IR 层诊断）。
不安全 函数 发射用户类构造(字符串 类名, 向量<整64>& 弹出们, 整64 实参数,
                   向量<IR指令>& 指令, 整64* 寄存器计数,
                   向量<整64>& 表达式栈) -> 空类型 {
    整64 类名ID = 驻留(类名);
    整64 构造串ID = 查类构造参数串(类名ID, 实参数);   // 432-b：按实参数选重载
    如果 (构造串ID == 0) {
        IR层诊断("用户类无构造器（v2 第一版要求类提供构造器）: " + 类名);
        运行时错误(6);
    }
    字符串 参数串 = 字符串复制(驻留文本(构造串ID));
    如果 (参数段个数(参数串) != 实参数) {
        IR层诊断("构造调用实参数不匹配（类 " + 类名 + "：期望 " +
                     整数转字符串(参数段个数(参数串)) + " 个）");
        运行时错误(6);
    }
    整64 obj寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, obj寄存器,
                         查结构体大小(类名ID), 类名ID));
    IR追加(指令, 建IR指令(IR_调用实参, obj寄存器, 0, 0, 0, 0, 0));
    发射调用实参们(弹出们, 1, 指令, 实参类型码们(弹出们));
    IR追加(指令, 建IR指令(IR_调用参数化, 实参数 + 1, 0, 0, 0, 0,
                         驻留(方法符号(类名, 剥实例基名(类名), 参数串))));
    结果<空类型, 整32> 加构 = 表达式栈.追加(obj寄存器);
    如果 (!加构.正常) { 运行时错误(4); }
}

// 用户类方法调用发射（生成方法调用 的用户类分派出口）：this=位0 + 实参位1..
//   → 类$方法[#参数串] → 标量/字符串/指针/空类型返回按标量通道；
//   结构体/容器/结果返回=第一版边界（显式拒绝，不静默降级）。
不安全 函数 发射用户类方法调用(字符串 类名, 字符串 方法名文本, 整64 this寄存器,
                    向量<整64>& 弹出们, 整64 实参数, 向量<IR指令>& 指令,
                    整64* 寄存器计数, 向量<整64>& 表达式栈) -> 空类型 {
    整64 类名ID = 驻留(类名);
    整64 方法名ID = 驻留(方法名文本);
    如果 (!有类方法(类名ID, 方法名ID)) {
        IR层诊断("用户类无此方法: " + 类名 + "." + 方法名文本);
        运行时错误(6);
    }
    整64 返回类型ID = 查类方法返回(类名ID, 方法名ID);
    整64 参数串ID = 查类方法参数串(类名ID, 方法名ID);
    字符串 参数串 = "";
    如果 (参数串ID != 0) { 参数串 = 字符串复制(驻留文本(参数串ID)); }
    如果 (参数段个数(参数串) != 实参数) {
        IR层诊断("方法调用实参数不匹配（" + 类名 + "." + 方法名文本 +
                      "：期望 " + 整数转字符串(参数段个数(参数串)) + " 个）");
        运行时错误(6);
    }
    字符串 返回文本 = 字符串复制(驻留文本(返回类型ID));
    如果 (查结构体大小(返回类型ID) != 0 || 是容器类(返回文本) ||
         是结果类型(返回文本)) {
        IR层诊断("用户类方法返回结构体/容器/结果暂不支持（" + 类名 + "." +
                     方法名文本 + " -> " + 返回文本 + "）");
        运行时错误(6);
    }
    整64 返回类型码u = 类型码(返回类型ID);
    // 432-b 根治：用户类方法调用的 引用/结构体实参 回扫取地址（与自由函数
    //   路径 回扫结构体与引用实参 同款表驱动；收集实例方法实参引用 按同公式
    //   键登记）——缺失=引用形参传值→被调方解引用写崩（123 链查找 前驱 实测）
    整64 方法符号IDu = 整64(驻留(方法符号(类名, 方法名文本, 参数串)));
    回扫结构体与引用实参(弹出们, 方法符号IDu, 指令, 寄存器计数);
    IR追加(指令, 建IR指令(IR_调用实参, this寄存器, 0, 0, 0, 0, 0));
    发射调用实参们(弹出们, 1, 指令, 实参类型码们(弹出们));
    整64 目标寄存器u = 0;
    如果 (返回类型码u != T_空类型 && 返回类型码u != T_未知) {
        目标寄存器u = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
    }
    IR追加(指令, 建IR指令(IR_调用参数化, 实参数 + 1, 返回类型码u, 0,
                         目标寄存器u, 0, 方法符号IDu));
    如果 (目标寄存器u != 0) {
        登记寄存器类型(目标寄存器u, 返回类型码u);
        结果<空类型, 整32> 加方 = 表达式栈.追加(目标寄存器u);
        如果 (!加方.正常) { 运行时错误(4); }
    }
}

// 参数段个数（0=无参；逗号数+1）——构造/方法调用实参数匹配校验用（对齐
//   v2 用户函数重载决议的 参数个数 口径）
函数 参数段个数(字符串 参数串) -> 整64 {
    如果 (字符串长度(参数串) == 0) { 返回 0; }
    整64 个数 = 1;
    整64 i = 0;
    当 (i < 字符串长度(参数串)) {
        整64 字节 = 整64(参数串[i]) & 255;
        如果 (字节 == 44) { 个数++; }
        i++;
    }
    返回 个数;
}

// 生成类方法们（节点_类 遍历点——IR生成多文件 类分支调用）：逐 节点_方法
//   生成方法 IR 并追加程序。
不安全 函数 生成类方法们(向量<节点> 池, 整32 类节点索引, 字符串 模块路径,
                    程序IR& 程序) -> 空类型 {
    节点 类节点 = 池.元素(类节点索引);
    整64 类名ID = 整64(类节点.文本);
    // 416-a（D42 波 2）：泛型基类——方法体经实例克隆体生成（单态化·符号自动含
    //   实例参数）；基类本体不生成（T 字段布局不真实）。克隆类节点由 实例化注册
    //   建好（池尾·生成主循环之前）。
    如果 (查泛型基类参数序(类名ID) != 0) {
        // 430-b 根治：克隆注册表自遍历——原按 泛型实例们（收集表）下标直配
        //   泛型实例类节点们（注册表），但 实例化注册 有双跳过路径（参数序
        //   缺失/基类不在本编译单元——只 `继续` 不追加注册表），两表长度可
        //   分叉 → 按收集表下标索引注册表 = 数组越界（gdb 栈实证：.元素 OOB
        //   崩溃于撤守卫 123 生成期）。改为注册表自遍历：每项必为已注册克隆，
        //   基类匹配经克隆类节点自身实例名（文本=实例ID）剥基名判定。
        整64 nd = 泛型实例类节点们.大小();
        整64 id = 0;
        当 (id < nd) {
            节点 克隆类d = 池.元素(整32(泛型实例类节点们.元素(id)));
            字符串 实例文本d = 字符串复制(驻留文本(整64(克隆类d.文本)));
            如果 (字符串比较(剥实例基名(实例文本d), 字符串复制(驻留文本(类名ID)))) {
                生成类方法们(池, 整32(泛型实例类节点们.元素(id)), 模块路径, 程序);
            }
            id++;
        }
        返回;
    }
    整64 位置 = 整64(类节点.子起点);
    当 (位置 < 整64(类节点.子终点)) {
        节点 成员 = 池.元素(整32(位置));
        如果 (成员.类型 == 节点_方法) {
            函数IR 函数信息 = 生成方法(池, 整32(位置), 类节点索引, 模块路径);
            结果<空类型, 整32> 加 = 程序.函数们.追加(函数信息);
            如果 (!加.正常) { 运行时错误(4); }
        }
        位置++;
    }
}
