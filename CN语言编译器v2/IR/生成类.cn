                            整64 this寄w = 寄存器计数;
                            寄存器计数 = 寄存器计数 + 1;
                            IR追加(函数信息.指令, 建IR指令(IR_加载, 当前方法this槽, 0, 0, this寄w,
                                                 T_对象, 0));
                            // 索引寄存器（单槽面）：参单槽=参数 索引；字段单槽=头/尾索引 字段旧值
                            整64 索寄w = 0;
                            布尔 有索w = 假;
                            如果 (参单槽w || 字段单槽w) {
                                结果<整64, 整32> 找索w = 函数信息.参数槽.获取(驻留("索引"));
                                如果 (找索w.正常) {
                                    索寄w = 寄存器计数;
                                    寄存器计数 = 寄存器计数 + 1;
                                    IR追加(函数信息.指令, 建IR指令(IR_加载, 找索w.值, 0, 0, 索寄w,
                                                         T_整64, 0));
                                    有索w = 真;
                                } 否则 {
                                    字符串 索名w = "头索引";
                                    如果 (字符串比较(方法名z, "删除尾部")) { 索名w = "尾索引"; }
                                    整64 索偏w = 当前方法字段偏移(驻留(索名w));
                                    如果 (索偏w >= 0) {
                                        整64 址寄w = 寄存器计数;
                                        寄存器计数 = 寄存器计数 + 1;
                                        IR追加(函数信息.指令, 建IR指令(IR_字段地址, this寄w, 0, 0, 址寄w,
                                                             T_整64, 索偏w));
                                        索寄w = 寄存器计数;
                                        寄存器计数 = 寄存器计数 + 1;
                                        IR追加(函数信息.指令, 建IR指令(IR_指针加载, 址寄w, 0, 0, 索寄w,
                                                             T_整64, 0));
                                        有索w = 真;
                                    }
                                }
                            }
                            // 每串字段路径一次调用（嵌套已展开为扁平内联偏移）——
                            //   三分支参数序独立发射（与运行时辅助 ABI 逐位对齐）：
                            //   平铺全量=(this,数组偏,数量偏,步长,路偏)5 参；
                            //   链式全量=(this,数组偏,下一偏,头偏,数量偏,步长,路偏)7 参；
                            //   单槽=(this,数组偏,索引,步长,路偏)5 参。
                            整64 piw = 0;
                            当 (piw < 路径们w.大小()) {
                                整64 路偏w = 路径们w.元素(piw);
                                整64 位w = 0;
                                整64 辅名w = 0;
                                IR追加(函数信息.指令, 建IR指令(IR_调用实参, this寄w, 0, 0, 0, 位w, 0));
                                位w++;
                                整64 组寄w = 寄存器计数;
                                寄存器计数 = 寄存器计数 + 1;
                                IR追加(函数信息.指令, 建IR指令(IR_常量整数, 整64(驻留(整数转字符串(数组偏w))),
                                                     0, 0, 组寄w, T_整64, 0));
                                IR追加(函数信息.指令, 建IR指令(IR_调用实参, 组寄w, 0, 0, 0, 位w, 0));
                                位w++;
                                如果 (全量w) {
                                    如果 (链式w) {
                                        整64 下一偏w = 当前方法字段偏移(驻留("下一索引"));
                                        整64 头偏w = 当前方法字段偏移(驻留("头索引"));
                                        如果 (下一偏w < 0 || 头偏w < 0) {
                                            piw++;
                                            继续;
                                        }
                                        整64 邻寄w = 寄存器计数;
                                        寄存器计数 = 寄存器计数 + 1;
                                        IR追加(函数信息.指令, 建IR指令(IR_常量整数, 整64(驻留(整数转字符串(下一偏w))),
                                                             0, 0, 邻寄w, T_整64, 0));
                                        IR追加(函数信息.指令, 建IR指令(IR_调用实参, 邻寄w, 0, 0, 0, 位w, 0));
                                        位w++;
                                        整64 头寄w = 寄存器计数;
                                        寄存器计数 = 寄存器计数 + 1;
                                        IR追加(函数信息.指令, 建IR指令(IR_常量整数, 整64(驻留(整数转字符串(头偏w))),
                                                             0, 0, 头寄w, T_整64, 0));
                                        IR追加(函数信息.指令, 建IR指令(IR_调用实参, 头寄w, 0, 0, 0, 位w, 0));
                                        位w++;
                                        整64 数寄w = 寄存器计数;
                                        寄存器计数 = 寄存器计数 + 1;
                                        IR追加(函数信息.指令, 建IR指令(IR_常量整数, 整64(驻留(整数转字符串(数量偏w))),
                                                             0, 0, 数寄w, T_整64, 0));
                                        IR追加(函数信息.指令, 建IR指令(IR_调用实参, 数寄w, 0, 0, 0, 位w, 0));
                                        位w++;
                                        辅名w = 驻留("__cn_chain_free_field_strings");
                                    } 否则 {
                                        整64 数寄w = 寄存器计数;
                                        寄存器计数 = 寄存器计数 + 1;
                                        IR追加(函数信息.指令, 建IR指令(IR_常量整数, 整64(驻留(整数转字符串(数量偏w))),
                                                             0, 0, 数寄w, T_整64, 0));
                                        IR追加(函数信息.指令, 建IR指令(IR_调用实参, 数寄w, 0, 0, 0, 位w, 0));
                                        位w++;
                                        辅名w = 驻留("__cn_vector_free_field_strings");
                                    }
                                } 否则 {
                                    如果 (!有索w) {
                                        piw++;
                                        继续;
                                    }
                                    IR追加(函数信息.指令, 建IR指令(IR_调用实参, 索寄w, 0, 0, 0, 位w, 0));
                                    位w++;
                                    辅名w = 驻留("__cn_seq_free_field_slot");
                                }
                                整64 步寄w = 寄存器计数;
                                寄存器计数 = 寄存器计数 + 1;
                                IR追加(函数信息.指令, 建IR指令(IR_常量整数, 整64(驻留(整数转字符串(步长w))),
                                                     0, 0, 步寄w, T_整64, 0));
                                IR追加(函数信息.指令, 建IR指令(IR_调用实参, 步寄w, 0, 0, 0, 位w, 0));
                                位w++;
                                整64 路寄w = 寄存器计数;
                                寄存器计数 = 寄存器计数 + 1;
                                IR追加(函数信息.指令, 建IR指令(IR_常量整数, 整64(驻留(整数转字符串(路偏w))),
                                                     0, 0, 路寄w, T_整64, 0));
                                IR追加(函数信息.指令, 建IR指令(IR_调用实参, 路寄w, 0, 0, 0, 位w, 0));
                                位w++;
                                IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 位w, 0, 0, 0, 0, 辅名w));
                                piw++;
                            }
                        }
                    }
                }
            }
        }
    }
    布尔 体终止m = 假;
    如果 (块索引 < 池.大小()) {
        体终止m = 生成块(池, 块索引, 函数信息.局部槽, 函数信息.参数槽, 函数信息,
                         &寄存器计数, &槽计数, 表达式栈, 函数信息.返回类型);
    }
    如果 (!体终止m) {
        // 析构器：字段级联析构注入（宿主 injectFieldCascadeDestroy 同款——
        //   体末尾、默认返回前按字段逆序释放「有析构类型」字段；体尾提前 返回
        //   不覆盖 = C++ 成员析构同语义边界）
        如果 (是析构器) {
            注入析构字段级联(池, 类节点索引, 函数信息, &寄存器计数);
        }
        发射容器析构(函数信息, 函数信息.指令, &寄存器计数, 函数信息.局部槽, 0);
        发射字符串释放(函数信息, 函数信息.指令, &寄存器计数, 函数信息.局部槽, 0);
    }
    // 514-a（T70 B1 三层②）：容器**元素钩子注入**——「移动元素」stdlib 契约=
    //   空体 + 编译器按元素类型注入（宿主 injectMoveElemDestroy 同构·81-a）。
    //   注入位置=体生成后、尾块跳转前（与析构级联注入同段·空体时 体终止m=假
    //   亦走此处——放体外保证恒注入）。
    如果 (方法名是本元素钩子(方法声明, "移动元素")) {
        注入元素移动体(池, 类节点索引, 函数信息, &寄存器计数, &槽计数);
    }
    发射跳转(函数信息, 函数信息.函数尾块);
    切换块(函数信息, 函数信息.函数尾块);
    发射块标签(函数信息, 函数信息.函数尾块);
    函数信息.retbuf字节数 = 取retbuf字节数();
    当前方法类名ID = 0;
    当前方法this槽 = 0;
    返回 函数信息;
}


// 215-a：族① 方法链接符号推导——构造=类$类名、析构=类$~类名（方法名ID==类名ID///   方法名文本 == "~"+类名文本 判定）、普通=类$方法[#参数串]。
不安全 函数 生成方法链符号(向量<节点> 池, 整32 方法节点索引, 整32 类节点索引, 布尔& 是析构器) -> 整32 {
    节点 方法声明 = 池.元素(方法节点索引);
    整64 类名ID = 整64(池.元素(类节点索引).文本);
    字符串 类名文本 = 字符串复制(驻留文本(类名ID));
    整64 方法名ID = 整64(方法声明.文本);
    字符串 方法名文本 = 字符串复制(驻留文本(方法名ID));
    字符串 参数串 = 函数参数串(池, 方法节点索引);
    字符串 链符号 = 方法符号(类名文本, 方法名文本, 参数串);
    如果 (方法名ID == 类名ID) {
        链符号 = 方法符号(类名文本, 类名文本, 参数串);   // 构造：类$类名[#参数串]
    } 否则 如果 (字符串比较(方法名文本, "~" + 类名文本)) {
        链符号 = 析构符号(类名文本);                     // 析构：类$~类名
        是析构器 = 真;                     // 析构：类$~类名
    }
    返回 整32(驻留(链符号));
}

// 215-a：族② 方法签名与返回字段初始化——返回类型附加=0 归一空类型/返回结构体 retbuf/
//   结果返回 retbuf（71-a）/块计数/循环基线三枚/函数尾块（缺陷A）/retbuf 回填复位/
//   模块路径窗口。
不安全 函数 初始化方法签名与返回字段(向量<节点> 池, 节点 方法声明, 字符串 模块路径, 函数IR& 函数信息) -> 空类型 {
    整64 返回类型ID = 整64(方法声明.附加);
    如果 (返回类型ID == 0) { 返回类型ID = 驻留("空类型"); }
    函数信息.返回类型 = 类型码(返回类型ID);
    函数信息.返回结果名ID = 0;
    函数信息.返回结构体ID = 0;
    // 639-a（001-001 接手 628 波 1·与 IR容器.cn 调用方/生成函数.cn 被调方翻转
    //   配套）：容器实例方法返回亦走 sret（值拷贝·628 波 1 值语义同向）——
    //   原 595-a「容器恒标量」排除致调用方/被调方/元素存储三方 ABI 错位
    //   （996 探针数组越界守卫拦截实证）。生产态查表 miss=等价零变化。
    如果 (查结构体大小(返回类型ID) != 0) {
        函数信息.返回结构体ID = 返回类型ID;
        IR追加(函数信息.指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 1));
    } 否则 如果 (是结果类型(字符串复制(驻留文本(返回类型ID)))) {
        函数信息.返回结果名ID = 返回类型ID;
        IR追加(函数信息.指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 1));
    }
    设当前函数返回结果名ID(函数信息.返回结果名ID);   // 430-b（族③）装箱语境
    函数信息.块计数 = 0;
    函数信息.当前块 = 0;
    函数信息.循环出口块 = 0;
    函数信息.循环继续块 = 0;
    函数信息.循环串基线 = 0;
    函数信息.循环容基线 = 0;
    函数信息.循环字段基线 = 0;
    函数信息.函数尾块 = 新块(函数信息);
    复位retbuf字节数();
    设当前模块路径(模块路径);
}


// 类字段类型登记（生成方法 调用）：遍历类区间 节点_类字段 —— 容器/结果/类对象
//   字段入 函数信息.变量类型（方法对象类型解析数据源）+ 全部字段入函数级权威表
//   （打印分派/拼接转换/字段读类型码消费）。
函数 登记类字段类型们(向量<节点> 池, 整32 类节点索引, 函数IR& 函数信息) -> 空类型 {
    节点 类节点 = 池.元素(类节点索引);
    整64 位置 = 整64(类节点.子起点);
    当 (位置 < 整64(类节点.子终点)) {
        节点 候选 = 池.元素(整32(位置));
        如果 (候选.类型 == 节点_类字段) {
            如果 (候选.附加 >= 0 && 候选.附加 < 整64(池.大小())) {
                节点 类型节点f = 池.元素(整32(候选.附加));
                整64 字段类型ID = 整64(类型节点f.文本);
                字符串 字段类型文本 = 字符串复制(驻留文本(字段类型ID));
                // 432-b 根治：指针字段类型文本补 '*' 规范化——类型节点附加=
                //   指针层 1..255（文本本身无星），原登记丢层→下标读推导
                //   miss→字符串回退（123 桶数组[i] __cn_str_len SEGV 实测）。
                //   逐层补星（最多 255 防御上限）。
                整64 指针层f = 类型节点f.附加;
                如果 (指针层f >= 1 && 指针层f <= 255) {
                    字符串 星串f = "";
                    整64 星i = 0;
                    当 (星i < 指针层f) {
                        星串f = 字符串复制(星串f + "*");
                        星i++;
                    }
                    字段类型文本 = 字符串复制(字段类型文本 + 星串f);
                    字段类型ID = 整64(驻留(字段类型文本));
                }
                如果 (是容器类(字段类型文本) || 是结果类型(字段类型文本) ||
                     是用户类(字段类型文本)) {
                    结果<空类型, 整32> 设类f = 函数信息.变量类型.设置(
                        整64(候选.文本), 字段类型ID);
                    如果 (!设类f.正常) { 运行时错误(4); }
                }
                登记当前函数变量类型(整64(候选.文本), 字段类型ID);
            }
        }
        位置++;
    }
}

// 析构字段级联注入（第七十八轮；宿主 ir_oop.cpp injectFieldCascadeDestroy 同款）：
//   ~类 体末尾按字段逆序对「有析构类型」字段（容器/结果类型、有析构用户类）发射
//   this 槽加载 → 字段地址(偏移) → 指针加载 → IR_删除对象（代码生成展开
//   call ~字段类型 + __cn_object_delete，空安全 test/je）。只对有析构类型注入
//   （无析构类/标量/字符串字段=不注入——对齐宿主 isClassType+hasDtor 判据）。
不安全 函数 注入析构字段级联(向量<节点> 池, 整32 类节点索引, 函数IR& 函数信息,
                    整64* 寄存器计数) -> 空类型 {
    节点 类节点 = 池.元素(类节点索引);
    整64 类名ID = 整64(类节点.文本);
    向量<整64> 偏移们c = 向量<整64>();
    向量<整64> 类型们c = 向量<整64>();
    整64 位置 = 整64(类节点.子起点);
    当 (位置 < 整64(类节点.子终点)) {
        节点 成员 = 池.元素(整32(位置));
        如果 (成员.类型 == 节点_类字段) {
            整64 字段类型IDc = 0;
            如果 (成员.附加 >= 0 && 成员.附加 < 整64(池.大小())) {
                节点 类型节点c = 池.元素(整32(成员.附加));
                字段类型IDc = 整64(类型节点c.文本);
            }
            如果 (字段类型IDc != 0) {
                字符串 字段类型文本c = 字符串复制(驻留文本(字段类型IDc));
                布尔 有析构c = 假;
                如果 (是容器类(字段类型文本c) || 是结果类型(字段类型文本c)) {
                    有析构c = 真;
                } 否则 如果 (是用户类(字段类型文本c)) {
                    如果 (类有析构(字段类型IDc)) { 有析构c = 真; }
                }
                如果 (有析构c) {
                    整64 偏移c = 查字段偏移(类名ID, 整64(成员.文本));
                    如果 (偏移c >= 0) {
                        结果<空类型, 整32> 加偏 = 偏移们c.追加(偏移c);
                        如果 (!加偏.正常) { 运行时错误(4); }
                        结果<空类型, 整32> 加型 = 类型们c.追加(字段类型IDc);
                        如果 (!加型.正常) { 运行时错误(4); }
                    }
                }
            }
        }
        位置++;
    }
    整64 kc = 偏移们c.大小();
    当 (kc > 0) {
        kc--;
        整64 地址c = 发射类字段地址(偏移们c.元素(kc), 函数信息.指令, 寄存器计数);
        整64 对象c = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(函数信息.指令, 建IR指令(IR_指针加载, 地址c, 0, 0, 对象c, T_对象, 0));
        IR追加(函数信息.指令, 建IR指令(IR_删除对象, 对象c, 0, 0, 寄存器计数[0],
                             0, 类型们c.元素(kc)));
        寄存器计数[0] = 寄存器计数[0] + 1;
    }
}

// ==================== 类对象局部与调用发射 ====================
// 生成类对象局部（生成变量声明 的类对象分派出口）：
//   槽分配 + 零初始化 + 类型登记 + RAII 登记（有析构类） + 初始化三形态——
//   构造调用（分配+构造+存槽）/ 无初始化（分配+无参构造）；标识符拷贝=显式
//   拒绝（第一版边界：类对象拷贝构造符号不存在——不静默降级）。
不安全 函数 生成类对象局部(向量<节点> 池, 节点 n, 节点 类型节点,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    字符串 类型文本 = 字符串复制(驻留文本(整64(类型节点.文本)));
    整64 类名ID = 整64(类型节点.文本);
    整64 槽c = 槽计数[0];
    槽计数[0] = 槽计数[0] + 1;
    // 585-a（撤守卫收口·帧预留缺失根治）：类对象槽必须发 IR_分配——扫描函数 以
    //   IR_分配 声明性指令计入 最大槽（帧预留）；缺发=槽不进帧 → 后续 retbuf 区
    //   （槽基数+槽数）与本槽重叠，被调 sret 写覆盖句柄（441 A3「新表」句柄被
    //   retbuf 清零→拷贝构造读空·探针 rc=139 实测；生产态同类声明同缺=潜伏缺陷，
    //   容器=内置局部路径走 生成容器局部 有 IR_分配 故未暴露）
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽c));

    结果<空类型, 整32> 设槽 = 局部槽.设置(整64(n.文本), 槽c);
    如果 (!设槽.正常) { 运行时错误(4); }
    整64 零reg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零reg, T_整64, 0));
    IR追加(指令, 建IR指令(IR_存储, 零reg, 0, 0, 0, 0, 槽c));
    结果<空类型, 整32> 设类v = 函数信息.变量类型.设置(整64(n.文本), 类名ID);
    如果 (!设类v.正常) { 运行时错误(4); }
    登记当前函数变量类型(整64(n.文本), 类名ID);
    如果 (类有析构(类名ID)) {
        名单追加去重(函数信息.容器变量们, 整64(n.文本));
    }
    布尔 是构造初值 = 假;
    如果 (n.子起点 < n.子终点) {
        节点 初末 = 池.元素(n.子终点 - 1);
        如果 (初末.类型 == 节点_调用 && 初末.子起点 >= 0) {
            节点 初被调 = 池.元素(整32(初末.子起点));
            如果 (初被调.类型 == 节点_标识符 &&
                 字符串比较(驻留文本(整64(初被调.文本)), 类型文本)) {
                是构造初值 = 真;
            } 否则 如果 (初被调.类型 == 节点_标识符) {
                // 276-a（D28 根治·2026-09-17）：导入类裸名经解析期 B1 改写为
                //   「模块::类」限定形态，callee 文本≠声明位类型文本→合法构造
                //   初始化被误拒（「类对象初始化仅支持构造调用」·随机数生成器
                //   冒烟实锤）。判定补限定名拆基名比对——拆限定名 :: 取尾段
                //   ==类型文本 同判构造初值（plans/021 §3-D D28 挂点方案）。
                字符串 被调文本 = 字符串复制(驻留文本(整64(初被调.文本)));
                字符串 改写模块 = "";
                字符串 改写符号 = "";
                如果 (拆限定名(被调文本, 改写模块, 改写符号) == 1 &&
                     字符串比较(改写符号, 类型文本)) {
                    是构造初值 = 真;
                }
            }
        }
    }
    如果 (n.子起点 < n.子终点 && !是构造初值) {
        发射类拷贝构造初始化(池, n, 类型文本, 类名ID, 槽c, 局部槽, 参数槽,
                              函数信息, 寄存器计数, 槽计数, 表达式栈);
        返回;
    }
    如果 (是构造初值) {
        整64 obj寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                     指令, 寄存器计数, &函数信息.块计数, 槽计数,
                                     表达式栈);
        如果 (obj寄存器 != 0) {
            IR追加(指令, 建IR指令(IR_存储, obj寄存器, 0, 0, 0, 0, 槽c));
        }
        当 (表达式栈.大小() > 0) {
            结果<空类型, 整32> 删栈g = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈g.正常) { 运行时错误(4); }
        }
        返回;
    }
    // 无初始化：分配 + 无参构造（宿主 ir_decl.cpp「无初始化表达式：NewObject +
    //   无参构造（this=新对象）」同款）
    整64 obj寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, obj寄存器,
                         查结构体大小(类名ID), 类名ID));
    IR追加(指令, 建IR指令(IR_调用实参, obj寄存器, 0, 0, 0, 0, 0));
    // 416-a（D42 波 2）：构造方法名=基名（剥实例基名·非泛型类原文返回）——
    //   泛型实例符号=实例$基名（对齐定义侧链符号 克隆体普通方法 类$方法）
    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                         驻留(方法符号(类型文本, 剥实例基名(类型文本), ""))));
    IR追加(指令, 建IR指令(IR_存储, obj寄存器, 0, 0, 0, 0, 槽c));
}

// 用户类构造调用发射（生成转换或构造调用 的用户类分派出口）：
//   分配对象 → this=位0 + 实参位1.. → 类$类名[#参数串] → 对象指针压栈。
//   参数串取定义侧登记值（第一版无构造重载——实参数不匹配=IR 层诊断）。
不安全 函数 发射用户类构造(字符串 类名, 向量<整64>& 弹出们, 整64 实参数,
                   向量<IR指令>& 指令, 整64* 寄存器计数,
                   向量<整64>& 表达式栈) -> 空类型 {
    整64 类名ID = 驻留(类名);
    整64 构造串ID = 查类构造参数串(类名ID, 实参数);   // 432-b：按实参数选重载
    如果 (构造串ID == 0) {
        IR层诊断("用户类无构造器（v2 第一版要求类提供构造器）: " + 类名);
        运行时错误(6);
    }
    字符串 参数串 = 字符串复制(驻留文本(构造串ID));
    如果 (参数段个数(参数串) != 实参数) {
        IR层诊断("构造调用实参数不匹配（类 " + 类名 + "：期望 " +
                     整数转字符串(参数段个数(参数串)) + " 个）");
        运行时错误(6);
    }
    整64 obj寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, obj寄存器,
                         查结构体大小(类名ID), 类名ID));
    IR追加(指令, 建IR指令(IR_调用实参, obj寄存器, 0, 0, 0, 0, 0));
    发射调用实参们(弹出们, 1, 指令, 实参类型码们(弹出们));
    IR追加(指令, 建IR指令(IR_调用参数化, 实参数 + 1, 0, 0, 0, 0,
                         驻留(方法符号(类名, 剥实例基名(类名), 参数串))));
    结果<空类型, 整32> 加构 = 表达式栈.追加(obj寄存器);
    如果 (!加构.正常) { 运行时错误(4); }
}

// 用户类方法调用发射（生成方法调用 的用户类分派出口）：this=位0 + 实参位1..
//   → 类$方法[#参数串] → 标量/字符串/指针/空类型返回按标量通道；
//   结构体/容器/结果返回=第一版边界（显式拒绝，不静默降级）。
不安全 函数 发射用户类方法调用(字符串 类名, 字符串 方法名文本, 整64 this寄存器,
                    向量<整64>& 弹出们, 整64 实参数, 向量<IR指令>& 指令,
                    整64* 寄存器计数, 向量<整64>& 表达式栈,
                    整64 retbuf序号) -> 空类型 {
    整64 类名ID = 驻留(类名);
    整64 方法名ID = 驻留(方法名文本);
    如果 (!有类方法(类名ID, 方法名ID)) {
        IR层诊断("用户类无此方法: " + 类名 + "." + 方法名文本);
        运行时错误(6);
    }
    整64 返回类型ID = 查类方法返回(类名ID, 方法名ID);
    整64 参数串ID = 查类方法参数串(类名ID, 方法名ID);
    字符串 参数串 = "";
    如果 (参数串ID != 0) { 参数串 = 字符串复制(驻留文本(参数串ID)); }
    如果 (参数段个数(参数串) != 实参数) {
        IR层诊断("方法调用实参数不匹配（" + 类名 + "." + 方法名文本 +
                      "：期望 " + 整数转字符串(参数段个数(参数串)) + " 个）");
        运行时错误(6);
    }
    字符串 返回文本 = 字符串复制(驻留文本(返回类型ID));
    // T87（489-b）：聚合返回（结构体/结果/容器）走 retbuf 隐藏指针——与被调方
    //   生成方法 的「返回结构体ID/结果名ID!=0 → 槽计数=2（位0=retbuf/位1=this）」
    //   ABI 配对（生成语句.cn Return 聚合写 retbuf 已实现）；原第一版显式拒绝
    //   （58 泛型类方法 返回 结果 →call 前运行时错误(6) 实弹）。
    //   发射模式=容器方法发射同款（生成表达式求值.cn）：retbuf=帧尾槽（retbuf序号·
    //   B6 累计定尺寸）+实参起始位=2+目标寄存器=retbuf 地址压栈（.正常/.值
    //   成员偏移路径自理·不标量登记）。
    布尔 聚合返回 = (查结构体大小(返回类型ID) != 0 || 是容器类(返回文本) ||
                     是结果类型(返回文本));
    整64 返回类型码u = 类型码(返回类型ID);
    整64 起始位u = 1;
    整64 retbuf槽u = 0;
    整64 目标寄存器u = 0;
    如果 (聚合返回) {
        // 585-a（撤守卫收口·与 签名返回字节数 同族）：结果/可选 返回的 retbuf
        //   尺寸=结果大小——查结构体大小 对结果类型=0 → 旧码累计 0=帧无预留，
        //   sret 写踩相邻变量槽（268-a 口径：结果 值面 16B 起）
        整64 返回字节u = 查结构体大小(返回类型ID);
        如果 (返回字节u == 0 && 是结果类型(返回文本)) {
            返回字节u = 结果大小(返回文本);
        }
        累计retbuf字节数(返回字节u);
        retbuf槽u = retbuf序号;
        起始位u = 2;
        目标寄存器u = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
    }
    // 432-b 根治：用户类方法调用的 引用/结构体实参 回扫取地址（与自由函数
    //   路径 回扫结构体与引用实参 同款表驱动；收集实例方法实参引用 按同公式
    //   键登记）——缺失=引用形参传值→被调方解引用写崩（123 链查找 前驱 实测）
    整64 方法符号IDu = 整64(驻留(方法符号(类名, 方法名文本, 参数串)));
    回扫结构体与引用实参(弹出们, 方法符号IDu, 指令, 寄存器计数);
    IR追加(指令, 建IR指令(IR_调用实参, this寄存器, 0, 0, 0, 起始位u - 1, 0));
    发射调用实参们(弹出们, 起始位u, 指令, 实参类型码们(弹出们));
    如果 (!聚合返回 && 返回类型码u != T_空类型 && 返回类型码u != T_未知) {
        目标寄存器u = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
    }
    IR追加(指令, 建IR指令(IR_调用参数化, 起始位u + 实参数, 返回类型码u, 0,
                         目标寄存器u, retbuf槽u, 方法符号IDu));
    如果 (聚合返回) {
        // retbuf 地址压栈（.正常/.值 成员偏移消费——容器 结果返回 同款不标量登记）
        结果<空类型, 整32> 加聚 = 表达式栈.追加(目标寄存器u);
        如果 (!加聚.正常) { 运行时错误(4); }
        返回;
    }
    如果 (目标寄存器u != 0) {
        登记寄存器类型(目标寄存器u, 返回类型码u);
        结果<空类型, 整32> 加方 = 表达式栈.追加(目标寄存器u);
        如果 (!加方.正常) { 运行时错误(4); }
    }
}

// 参数段个数（0=无参；逗号数+1）——构造/方法调用实参数匹配校验用（对齐
//   v2 用户函数重载决议的 参数个数 口径）
函数 参数段个数(字符串 参数串) -> 整64 {
    如果 (字符串长度(参数串) == 0) { 返回 0; }
    整64 个数 = 1;
    整64 i = 0;
    当 (i < 字符串长度(参数串)) {
        整64 字节 = 整64(参数串[i]) & 255;
        如果 (字节 == 44) { 个数++; }
        i++;
    }
    返回 个数;
}

// 生成类方法们（节点_类 遍历点——IR生成多文件 类分支调用）：逐 节点_方法
//   生成方法 IR 并追加程序。
不安全 函数 生成类方法们(向量<节点> 池, 整32 类节点索引, 字符串 模块路径,
                    程序IR& 程序) -> 空类型 {
    节点 类节点 = 池.元素(类节点索引);
    整64 类名ID = 整64(类节点.文本);
    // 416-a（D42 波 2）：泛型基类——方法体经实例克隆体生成（单态化·符号自动含
    //   实例参数）；基类本体不生成（T 字段布局不真实）。克隆类节点由 实例化注册
    //   建好（池尾·生成主循环之前）。
    如果 (查泛型基类参数序(类名ID) != 0) {
        // 430-b 根治：克隆注册表自遍历——原按 泛型实例们（收集表）下标直配
        //   泛型实例类节点们（注册表），但 实例化注册 有双跳过路径（参数序
        //   缺失/基类不在本编译单元——只 `继续` 不追加注册表），两表长度可
        //   分叉 → 按收集表下标索引注册表 = 数组越界（gdb 栈实证：.元素 OOB
        //   崩溃于撤守卫 123 生成期）。改为注册表自遍历：每项必为已注册克隆，
        //   基类匹配经克隆类节点自身实例名（文本=实例ID）剥基名判定。
        整64 nd = 泛型实例类节点们.大小();
        整64 id = 0;
        当 (id < nd) {
            节点 克隆类d = 池.元素(整32(泛型实例类节点们.元素(id)));
            字符串 实例文本d = 字符串复制(驻留文本(整64(克隆类d.文本)));
            如果 (字符串比较(剥实例基名(实例文本d), 字符串复制(驻留文本(类名ID)))) {
                // 462-a（T70 面①根治）：克隆体生成窗口=实例化点模块（"主"）——
                //   原传 基类文件段模块路径（撤守卫态=stdlib 容器模块）→克隆体内
                //   类型查询（类型大小/字段布局分桶键）按容器模块域解析→主模块
                //   私有结构体（240 外盒）键域 miss=「类型大小: 未知类型」。语义=
                //   合并单模块（C4 核验口径）·与泛型函数实例生成传 "主"（398）
                //   同构；实例化点类型可见性按主模块判定。
                生成类方法们(池, 整32(泛型实例类节点们.元素(id)), "主", 程序);
            }
            id++;
        }
        返回;
    }
    整64 位置 = 整64(类节点.子起点);
    当 (位置 < 整64(类节点.子终点)) {
        节点 成员 = 池.元素(整32(位置));
        如果 (成员.类型 == 节点_方法) {
            函数IR 函数信息 = 生成方法(池, 整32(位置), 类节点索引, 模块路径);
            结果<空类型, 整32> 加 = 程序.函数们.追加(函数信息);
            如果 (!加.正常) { 运行时错误(4); }
        }
        位置++;
    }
}

// ==================== 607-a（001-001 续）：串字段路径收集（81-a 面） ====================
// 收集结构体类型的拥有串字段**内联偏移路径**（宿主 ownedStrFieldsOf 的运行时
//   辅助对照收集）——直串字段=自身偏移；嵌套含资源结构体字段=内联偏移叠加
//   递归展开（外.内.名 → off(内)+off(名)）；深度守卫 ≤4 防自引用环。
//   容器字段（类别 1）不收集（其释放由析构级联/IR_删除对象负责——与宿主
//   ClassObj 分支的容器元素释放面同理，v2 侧本轮诚实边界）；
//   结果/可选 联合体条件释放面（宿主 condOffset/viaUnion）=v2 诚实边界同册。
不安全 函数 收集串字段路径(整64 结构体ID, 整64 基偏移, 向量<整64>& 出, 整64 深度) -> 空类型 {
    如果 (深度 > 4) { 返回; }
    向量<整64> 三元组w = 向量<整64>();
    取资源字段们(结构体ID, 三元组w);
    整64 iw = 0;
    当 (iw + 2 < 三元组w.大小()) {
        整64 字段类型IDw = 三元组w.元素(iw + 1);
        整64 合成偏w = 基偏移 + 三元组w.元素(iw + 2);
        如果 (字段类型IDw == 驻留("字符串")) {
            结果<空类型, 整32> 加w = 出.追加(合成偏w);
            如果 (!加w.正常) { 运行时错误(4); }
        } 否则 {
            整64 嵌套键w = 结构体布局键基(字段类型IDw);
            如果 (嵌套键w != 0 && 资源字段数(嵌套键w) > 0) {
                收集串字段路径(嵌套键w, 合成偏w, 出, 深度 + 1);
            }
        }
        iw += 3;
    }
}

// ==================== 514-a（T70 B1 三层②）：容器元素钩子注入 ====================
// 背景：stdlib 容器（容器.cn）的 移动元素/析构元素/析构被移除 三个钩子方法是
//   **空体 + 编译器注入**契约（源码注释明写「编译器按元素类型注入」）——宿主在
//   src/cn_compiler/ir/ir_oop_container.cpp 全量实现，v2 侧原**零注入** → 撤守卫态
//   （stdlib 源码级加载）容器删除/移位全部失效（126 断言 213：删除后元素未移位·
//   载撤销守卫收敛）。
// 本版范围（诚实边界）：**移动元素**（移位循环单点·标量/纯标量结构体元素=纯
//   memcpy 零行为差异）；含资源字段元素的**源槽清零**与 析构元素/析构被移除
//   两钩子（释放面）=下一层登记（依赖容器元素释放设施，与宿主 emitContainerElemFreeFor
//   / emitOwnedStrFieldFreesAt 同族）。
函数 方法名是本元素钩子(节点 方法声明, 字符串 钩子名) -> 布尔 {
    返回 字符串比较(字符串复制(驻留文本(整64(方法声明.文本))), 钩子名);
}

不安全 函数 注入元素移动体(向量<节点> 池, 整32 类节点索引, 函数IR& 函数信息,
                   整64* 寄存器计数, 整64* 槽计数) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    // 元素类型文本：实例名（`向量$T`）剥**首个 `$` 前缀**；无 `$`（普通类）→ 不注入
    字符串 类文本 = 字符串复制(驻留文本(整64(池.元素(类节点索引).文本)));
    整64 类长 = 字符串长度(类文本);
    整64 刀位 = -1;
    整64 ci = 0;
    当 (ci < 类长) {
        如果 ((整64(类文本[ci]) & 255) == 36) { 刀位 = ci; 中断; }
        ci++;
    }
    如果 (刀位 < 0) { 返回; }
    字符串 元素文本 = 字符串子串(类文本, 整32(刀位 + 1), 类长 - 刀位 - 1);
    // 元素步长（类型大小表；标量/指针类兜底 8 字节——与宿主 types::typeSizeOf 口径对齐）
    整64 元素大小 = 0;
    整64 元素对齐 = 0;
    类型大小与对齐(元素文本, &元素大小, &元素对齐);
    如果 (元素大小 <= 0) { 元素大小 = 8; }
    // 数据 字段偏移（实例布局键；栈/队列/映射 字段名各异 → 查不到即不注入=让位后续层）
    整64 类ID = 结构体布局键基(整64(池.元素(类节点索引).文本));
    如果 (类ID == 0) { 类ID = 整64(池.元素(类节点索引).文本); }
    整64 数据偏移 = 查字段偏移(类ID, 驻留("数据"));
    如果 (数据偏移 < 0) { 返回; }
    // 形参槽（移动元素(整64 目标, 整64 源)）
    整64 目标槽 = 0;
    整64 源槽 = 0;
    结果<整64, 整32> 找目标 = 函数信息.参数槽.获取(驻留("目标"));
    如果 (找目标.正常) { 目标槽 = 找目标.值; }
    结果<整64, 整32> 找源 = 函数信息.参数槽.获取(驻留("源"));
    如果 (找源.正常) { 源槽 = 找源.值; }
    如果 (目标槽 == 0 || 源槽 == 0) { 返回; }
    // this → 数据字段地址 → 数据值（元素数组基指针）
    整64 基址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 当前方法this槽, 0, 0, 基址r, T_对象, 0));
    整64 数据地址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 基址r, 0, 0, 数据地址r, T_整64, 数据偏移));
    整64 数据值r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 数据地址r, 0, 0, 数据值r, T_整64, 0));
    // 目标/源 下标值
    整64 目标值r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 目标值r, T_整64, 0));
    整64 源值r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 源槽, 0, 0, 源值r, T_整64, 0));
    // 步长常量槽
    整64 步长r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(元素大小)), 0, 0,
                         步长r, T_整64, 0));
    // 目标地址 = 数据值 + 目标*步长；源地址 = 数据值 + 源*步长
    整64 目标偏r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_乘, 目标值r, 步长r, 0, 目标偏r, T_整64, 0));
    整64 目标址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加, 数据值r, 目标偏r, 0, 目标址r, T_整64, 0));
    整64 源偏r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_乘, 源值r, 步长r, 0, 源偏r, T_整64, 0));
    整64 源址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加, 数据值r, 源偏r, 0, 源址r, T_整64, 0));
    // 整体搬运（结构体拷贝：源地址/目标地址/字节数=步长·对齐宿主 memcpy 语义）
    IR追加(指令, 建IR指令(IR_结构体拷贝, 源址r, 目标址r, 0, 0, 元素大小, 0));
}
不安全 函数 发射类拷贝构造初始化(向量<节点> 池, 节点 n, 字符串 类型文本, 整64 类名ID, 整64 槽c,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
        // 438-b 根①：类对象拷贝初始化 b = a——分配新对象 + 拷贝构造(this=新，
        //   其他=源)（Rust Clone::clone 同构；与 发射用户类构造 同 ABI）。拷贝
        //   构造缺失→维持既有拒绝诊断（克隆契约：无拷贝构造不可独立拥有）。
        整64 拷贝串ID = 查类构造参数串(类名ID, 1);
        如果 (拷贝串ID == 0) {
            IR层诊断("类对象初始化仅支持构造调用（类 " + 类型文本 +
                          "；拷贝/其它形态随后续轮次）");
            运行时错误(6);
        }
        字符串 拷贝串 = 字符串复制(驻留文本(拷贝串ID));
        整64 新obj = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新obj,
                             查结构体大小(类名ID), 类名ID));
        // 448-b 根治（44#2 多余解引用·撤守卫态 111 SEGV·D42 波 3 收口）：
        //   拷贝构造 T& 形参侧=引用槽模型（发射引用参数读 容器& 双解：Load 槽
        //   =源左值地址 → LoadPtr=对象指针）——实参位1 必须传**源左值地址**
        //   （宿主 ABI 同款：传 &源槽）。原实现直传 生成表达式 结果（对象
        //   指针）→形参侧多解一跳（读得 数据 字段值）→下标基址=元素值→SEGV
        //   （r10=0xa gdb 实证·asm 链 Load→LoadPtr→字段地址→LoadPtr 四层）。
        //   源装载三分支（生成容器拷贝构造 同款单一归属）：标识符=引用槽
        //   Load/静态 静态地址/普通槽 取地址；非标识符右值=hold 槽物化+取地址
        //   （③ 容器拷贝构造分支 同构·指针地址化零对象拷贝）。
        整64 源地址reg = 0;
        节点 源末448b = 池.元素(n.子终点 - 1);
        如果 (源末448b.类型 == 节点_标识符) {
            整64 源槽448b = 0;
            结果<整64, 整32> 找源局448b = 局部槽.获取(整64(源末448b.文本));
            如果 (找源局448b.正常) { 源槽448b = 找源局448b.值; }
            如果 (源槽448b == 0) {
                结果<整64, 整32> 找源参448b = 参数槽.获取(整64(源末448b.文本));
                如果 (找源参448b.正常) { 源槽448b = 找源参448b.值; }
            }
            如果 (源槽448b != 0) {
                源地址reg = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                如果 (槽是引用(源槽448b)) {
                    IR追加(指令, 建IR指令(IR_加载, 源槽448b, 0, 0, 源地址reg, T_对象, 0));
                } 否则 {
                    IR追加(指令, 建IR指令(IR_取地址, 源槽448b, 0, 0, 源地址reg, T_整64, 0));
                }
            } 否则 {
                整64 找源静448b = 查静态序号(整64(源末448b.文本));
                如果 (找源静448b >= 0) {
                    源地址reg = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 源地址reg,
                                         T_对象, 找源静448b));
                }
            }
        }
        如果 (源地址reg == 0) {
            整64 源值448b = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                         指令, 寄存器计数, &函数信息.块计数, 槽计数,
                                         表达式栈);
            整64 hold槽448b = 槽计数[0];
            槽计数[0] = 槽计数[0] + 1;
            IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, hold槽448b));
            IR追加(指令, 建IR指令(IR_存储, 源值448b, 0, 0, 0, 0, hold槽448b));
            源地址reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_取地址, hold槽448b, 0, 0, 源地址reg, T_整64, 0));
            当 (表达式栈.大小() > 0) {
                结果<空类型, 整32> 删源448b = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删源448b.正常) { 运行时错误(4); }
            }
        }
        IR追加(指令, 建IR指令(IR_调用实参, 新obj, 0, 0, 0, 0, 0));
        IR追加(指令, 建IR指令(IR_调用实参, 源地址reg, 0, 0, 0, 1, 0));
        IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                             驻留(方法符号(类型文本, 剥实例基名(类型文本), 拷贝串))));
        IR追加(指令, 建IR指令(IR_存储, 新obj, 0, 0, 0, 0, 槽c));
        当 (表达式栈.大小() > 0) {
            结果<空类型, 整32> 删栈k = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈k.正常) { 运行时错误(4); }
        }
        返回;
}

