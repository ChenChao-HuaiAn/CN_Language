// CN 自举编译器 v2 · IR 组件·字面量域判定族（535 下沉·2026-10-14）
// 职责：字面量文本值域判定（十进制文本级判域+进制前缀值级判域+整数后缀
//   剥离）——558 设施（原 语义检查字面量域.cn·506甲 族）跨层共享下沉中立层：
//   535 轮消费方=语义层（隐式转换合法三通道/推断面/535 静态槽检查）与
//   语法层（解析类静态字段初值 域检查）双侧——语法→语义直接依赖违 334
//   层序（零分叉红线下的判定单一真源），IR 中立层=语法/语义双白名单可依赖
//   （「跨层共性需求优先下沉中立层」纪律）。纯搬运零逻辑改写（自 语义检查
//   字面量域.cn 机械搬移·函数体逐字保留）+ 字面量文本入域 新公开入口
//   （原 整字面量入域 文本核心抽出·供语法层 Token 文本直消费）。
//   依赖=字符串/字节值 内建（字节值 词法包·合并全局池解析·558 同款零 import）。
导入 容器::向量;
导入 协议常量;

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 558（506甲）：十进制数字文本归一（去前导零·保留至少一位）——文本级判域
//   前置（超 int64 承载的 19~20 位文本不受整64 解析限制·宿主
//   intLiteralFitsType 文本级判定同构）
函数 数文本去前导零(字符串 数字文本) -> 字符串 {
    整64 长z = 字符串长度(数字文本);
    整64 起z = 0;
    当 (起z < 长z - 1 && 字节值(数字文本, 起z) == 48) { 起z++; }
    返回 字符串子串(数字文本, 起z, 长z - 起z);
}

// 558（506甲）：无符号十进制数字文本 ≤ 上界文本（长度优先·等长逐字节比·
//   大数安全——整64 解析承载面彻底退出判域路径）
函数 数文本不超上界(字符串 数字文本, 字符串 上界文本) -> 布尔 {
    字符串 值t = 数文本去前导零(数字文本);
    字符串 界t = 数文本去前导零(上界文本);
    整64 长值 = 字符串长度(值t);
    整64 长界 = 字符串长度(界t);
    如果 (长值 != 长界) { 返回 长值 < 长界; }
    整64 k = 0;
    当 (k < 长值) {
        整64 字节值a = 字节值(值t, k);
        整64 字节值b = 字节值(界t, k);
        如果 (字节值a != 字节值b) { 返回 字节值a < 字节值b; }
        k++;
    }
    返回 真;
}

// 558 修复（审查 P1-1·零分叉）：进制前缀字面量值级判域——宿主
//   intLiteralFitsType 十进制文本拦截后回退值级 fits 路径同构：进制文本解析
//   为整64 值（stoll 同款：超 int64 正上界=溢出回 0），再按目标域判定。
//   承载内十六进制超域（`整32 甲=0x1FFFFFFFF`）宿主拒·v2 修复前「见 x 放行」
//   =分叉，此处补齐；超承载十六进制（stoll 抛异常回 0→域内放行）双侧同放行
//   维持一致（诚实边界·其 IR 物化 0 面随 #547 收口，此处不为它扩拦）。
//   负号形态按数学负值判（宿主值级 fits lambda 同构）；正N 目标按无符号域
//   解释（宿主 fitsU 同款·负号恒拒）。
函数 进制字面量值级入域(字符串 文本h, 字符串 目标文本, 布尔 负号) -> 布尔 {
    // 前缀定进制（宿主 parseIntValue 同款：0x/0X/0b/0B/0o/0O·调用方已拦·防御复判）
    整64 进位h = 10;
    整64 起h = 0;
    如果 (字符串长度(文本h) > 2 && 字节值(文本h, 0) == 48) {
        整64 次h = 字节值(文本h, 1);
        如果 (次h == 120 || 次h == 88) { 进位h = 16; 起h = 2; }
        否则 如果 (次h == 98 || 次h == 66) { 进位h = 2; 起h = 2; }
        否则 如果 (次h == 111 || 次h == 79) { 进位h = 8; 起h = 2; }
    }
    整64 累h = 0;
    整64 ih = 起h;
    当 (ih < 字符串长度(文本h)) {
        整64 数h = 字节值(文本h, ih);
        如果 (数h >= 48 && 数h <= 57) { 数h = 数h - 48; }
        否则 如果 (数h >= 97 && 数h <= 102) { 数h = 数h - 87; }
        否则 如果 (数h >= 65 && 数h <= 70) { 数h = 数h - 55; }
        否则 如果 (数h == 76 || 数h == 108 || 数h == 85 || 数h == 117) { 中断; }   // L/U 后缀自断
        否则 { 返回 真; }   // 非法字符=检不出放行（防御·词法不可达面）
        如果 (数h >= 进位h) { 返回 真; }   // 进制外数字=检不出放行（防御）
        如果 (累h > (9223372036854775807 - 数h) / 进位h) {
            累h = 0;   // 超 int64 正上界=stoll 抛异常回 0 同款（超承载=域内放行·#547 面）
            中断;
        }
        累h = 累h * 进位h + 数h;
        ih++;
    }
    如果 (负号) { 累h = 0 - 累h; }
    // 值级域表（宿主 fits/fitsU 同款·与文本级受检矩阵一一对应）
    如果 (字符串比较(目标文本, "整8")) { 返回 累h >= -128 && 累h <= 127; }
    如果 (字符串比较(目标文本, "正8")) { 返回 !负号 && 累h <= 255; }
    如果 (字符串比较(目标文本, "整16")) { 返回 累h >= -32768 && 累h <= 32767; }
    如果 (字符串比较(目标文本, "正16")) { 返回 !负号 && 累h <= 65535; }
    如果 (字符串比较(目标文本, "整32")) { 返回 累h >= -2147483648 && 累h <= 2147483647; }
    如果 (字符串比较(目标文本, "正32")) { 返回 !负号 && 累h <= 4294967295; }
    如果 (字符串比较(目标文本, "整64")) {
        返回 累h >= -9223372036854775807 - 1 && 累h <= 9223372036854775807;
    }
    如果 (字符串比较(目标文本, "正64")) {
        // 值已回 0 承载（≤2^63-1）恒 ≤ 2^64-1·宿主 fitsU(2^64-1) 同构——仅负号面拒
        返回 !负号;
    }
    返回 真;   // 整128/正128/未知目标：域宽于字面量承载，恒适
}

// 558（506甲）→ 535 入口抽取：字面量文本值域判定（原 整字面量入域 文本
//   核心逐字搬移）——受检矩阵与值域（文本级判定·宿主 intLiteralFitsType
//   十进制文本路径一致）：整8 [-128,127]／正8 [0,255]／整16 [-32768,32767]／
//   正16 [0,65535]／正32 [0,4294967295]／整32 [-2147483648,2147483647]／
//   整64 [-2^63,2^63-1]／正64 [0,2^64-1]。负号+字面量形态按数学负值判
//   （-2147483648=整32::MIN 域内合法·存量零翻转）。进制前缀→值级判域；
//   整数后缀剥离→文本级判域（宿主 decimalDigitsOf 同款剥法）。非纯十进制
//   残形=检不出放行（防御·词法不可达面）。
函数 字面量文本入域(字符串 文本l入, 字符串 目标文本, 布尔 负号) -> 布尔 {
    字符串 文本l = 字符串复制(文本l入);
    整64 长l = 字符串长度(文本l);
    如果 (长l == 0) { 返回 真; }
    // 558 修复：进制前缀面（0x/0X/0b/0B/0o/0O·宿主 decimalDigitsOf 前缀拦截
    //   同款 size>2 门槛）→ 值级判域（承载内十六进制超域拒·超承载同放行维持）
    如果 (长l > 2 && 字节值(文本l, 0) == 48) {
        整64 次l = 字节值(文本l, 1);
        如果 (次l == 120 || 次l == 88 || 次l == 98 || 次l == 66 ||
             次l == 111 || 次l == 79) {
            返回 进制字面量值级入域(文本l, 目标文本, 负号);
        }
    }
    // 558 修复：整数后缀剥离（宿主 decimalDigitsOf 同款自尾剥 L/l/U/u/F/f·
    //   非前缀面 F/f 可剥）——带后缀十进制超域（99999999999999999999L→整64）
    //   宿主拒·v2 修复前「见 L 放行」=分叉；v2 词法整数形态仅消费 L/U（f/F
    //   浮点形态专属·不可达面），防御同剥与宿主同构。剥空=词法不可达退化形态
    //   →后续全数字扫描零通过按「检不出放行」对齐宿主回退值级 0 放行。
    当 (长l > 0) {
        整64 尾l = 字节值(文本l, 长l - 1);
        如果 (尾l == 76 || 尾l == 108 || 尾l == 85 || 尾l == 117 ||
             尾l == 70 || 尾l == 102) {
            长l--;
        } 否则 { 中断; }
    }
    文本l = 字符串子串(文本l, 0, 长l);
    整64 扫i = 0;
    当 (扫i < 长l) {
        整64 字节s = 字节值(文本l, 扫i);
        如果 (字节s < 48 || 字节s > 57) { 返回 真; }   // 非纯十进制=检不出放行
        扫i++;
    }
    如果 (字符串比较(目标文本, "整8")) {
        布尔 入域a558 = 数文本不超上界(文本l, "127");
        如果 (负号) { 入域a558 = 数文本不超上界(文本l, "128"); }
        返回 入域a558;
    }
    如果 (字符串比较(目标文本, "正8")) { 返回 !负号 && 数文本不超上界(文本l, "255"); }
    如果 (字符串比较(目标文本, "整16")) {
        布尔 入域b558 = 数文本不超上界(文本l, "32767");
        如果 (负号) { 入域b558 = 数文本不超上界(文本l, "32768"); }
        返回 入域b558;
    }
    如果 (字符串比较(目标文本, "正16")) { 返回 !负号 && 数文本不超上界(文本l, "65535"); }
    如果 (字符串比较(目标文本, "正32")) { 返回 !负号 && 数文本不超上界(文本l, "4294967295"); }
    如果 (字符串比较(目标文本, "整32")) {
        布尔 入域c558 = 数文本不超上界(文本l, "2147483647");
        如果 (负号) { 入域c558 = 数文本不超上界(文本l, "2147483648"); }
        返回 入域c558;
    }
    如果 (字符串比较(目标文本, "整64")) {
        布尔 入域d558 = 数文本不超上界(文本l, "9223372036854775807");
        如果 (负号) { 入域d558 = 数文本不超上界(文本l, "9223372036854775808"); }
        返回 入域d558;
    }
    如果 (字符串比较(目标文本, "正64")) { 返回 !负号 && 数文本不超上界(文本l, "18446744073709551615"); }
    返回 真;   // 整128/正128：域宽于任何整64 承载内文本，恒适
}

// 640（2026-10-16）：128 槽十进制文本域判定（整128 合法域 [-2^127, 2^127-1]／
//   正128 [0, 2^128-1]）——供**静态槽三形态**挂点（535 挂点补充消费）；
//   535 原版 字面量文本入域 对 128 目标「域宽于任何 int64 承载内文本恒适」
//   仅对 ≤int64 文本成立——超承载文本可超 2^127（2^128-1 39 位实锚
//   m642c/d 探针：宿主拒/v2 放行错值=双侧分叉）。本判定只供静态槽面
//   （不扩通用转换面——局部形态 [ir2] 诊断链 540/664 既有面不动）。口径=
//   IR容器尾 字面量超128域（宿主 i128TextInRange 同构）：进制前缀/非纯
//   十进制=检不出放行（十六进制超承载面随 #547）。返回=在域内。
函数 字面量文本入域128_640(字符串 文本l入, 字符串 目标文本, 布尔 负号) -> 布尔 {
    如果 (!字符串比较(目标文本, "整128") && !字符串比较(目标文本, "正128")) { 返回 真; }
    字符串 文本l = 字符串复制(文本l入);
    整64 长l = 字符串长度(文本l);
    如果 (长l == 0) { 返回 真; }
    // 进制前缀=检不出放行（与 字面量文本入域 同口径·#547 面）
    如果 (长l > 2 && 字节值(文本l, 0) == 48) {
        整64 次l = 字节值(文本l, 1);
        如果 (次l == 120 || 次l == 88 || 次l == 98 || 次l == 66 ||
             次l == 111 || 次l == 79) { 返回 真; }
    }
    // 整数后缀剥离（宿主 decimalDigitsOf 同款自尾剥 L/l/U/u/F/f）
    当 (长l > 0) {
        整64 尾l = 字节值(文本l, 长l - 1);
        如果 (尾l == 76 || 尾l == 108 || 尾l == 85 || 尾l == 117 ||
            尾l == 70 || 尾l == 102) {
            长l--;
        } 否则 { 中断; }
    }
    文本l = 字符串子串(文本l, 0, 长l);
    整64 扫i = 0;
    当 (扫i < 长l) {
        整64 字节s = 字节值(文本l, 扫i);
        如果 (字节s < 48 || 字节s > 57) { 返回 真; }   // 非纯十进制=检不出放行
        扫i++;
    }
    如果 (字符串比较(目标文本, "整128")) {
        布尔 入域e640 = 数文本不超上界(文本l, "170141183460469231731687303715884105727");
        如果 (负号) { 入域e640 = 数文本不超上界(文本l, "170141183460469231731687303715884105728"); }
        返回 入域e640;
    }
    返回 (!负号) && 数文本不超上界(文本l, "340282366920938463463374607431768211455");
}
