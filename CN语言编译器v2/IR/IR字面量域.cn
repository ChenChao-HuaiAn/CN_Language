// CN 自举编译器 v2 · IR 组件·字面量域判定族（535 下沉·2026-10-14）
// 职责：字面量文本值域判定（十进制文本级判域+进制前缀值级判域+整数后缀
//   剥离）——558 设施（原 语义检查字面量域.cn·506甲 族）跨层共享下沉中立层：
//   535 轮消费方=语义层（隐式转换合法三通道/推断面/535 静态槽检查）与
//   语法层（解析类静态字段初值 域检查）双侧——语法→语义直接依赖违 334
//   层序（零分叉红线下的判定单一真源），IR 中立层=语法/语义双白名单可依赖
//   （「跨层共性需求优先下沉中立层」纪律）。纯搬运零逻辑改写（自 语义检查
//   字面量域.cn 机械搬移·函数体逐字保留）+ 字面量文本入域 新公开入口
//   （原 整字面量入域 文本核心抽出·供语法层 Token 文本直消费）。
//   依赖=字符串/字节值 内建（字节值 词法包·合并全局池解析·558 同款零 import）。
导入 容器::向量;
导入 协议常量;

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 558（506甲）：十进制数字文本归一（去前导零·保留至少一位）——文本级判域
//   前置（超 int64 承载的 19~20 位文本不受整64 解析限制·宿主
//   intLiteralFitsType 文本级判定同构）
函数 数文本去前导零(字符串 数字文本) -> 字符串 {
    整64 长z = 字符串长度(数字文本);
    整64 起z = 0;
    当 (起z < 长z - 1 && 字节值(数字文本, 起z) == 48) { 起z++; }
    返回 字符串子串(数字文本, 起z, 长z - 起z);
}

// 1016（五轮审查 P1-1·自 语义检查字面量域 下沉）：负号 + 无符号后缀（U/u）+
//   非零值判定——语法层（类静态字段初值 解析类辅助）与语义层（表达式分析/
//   535 初值面）双消费，归属=IR 中立层（334 层序）。负号可由 负号 参数或
//   文本前导 '-'（折叠形态）承载；-0U 等归一化零放行；后缀白名单仅
//   U/UL/ULL（宿主 literalTypeOf 口径）。**不进入共享判域函数**
//   （字面量文本入域/128_640）——避免误拒常量/实例字段（宿主放行现状）。
// 1194 合流：本函数=分支同名下沉副本与 develop 版的单一真源收口（两版
//   函数体逐字同义，删重复定义保留本条；1194 表达式点判拒复用此处判据）。
函数 负无符号非零1016(字符串 数字文本, 布尔 负号) -> 布尔 {
    整64 长q = 字符串长度(数字文本);
    如果 (长q == 0) { 返回 假; }
    整64 起q = 0;
    如果 (字节值(数字文本, 0) == 45) { 负号 = 真; 起q = 1; }
    // 非负号形态不在本判据面（1016 只判「负号+无符号后缀+非零」形态）：谓词否定回答
    如果 (!负号) { 返回 假; }
    整64 尾q = 长q;
    字符串 后缀q = "";
    当 (尾q > 起q) {
        整64 字节q = 字节值(数字文本, 尾q - 1);
        布尔 是后缀q = 字节q == 76 || 字节q == 108 ||
                      字节q == 85 || 字节q == 117;
        如果 (!是后缀q) { 中断; }
        如果 (字节q == 76 || 字节q == 108) { 后缀q = 字符串复制("L" + 后缀q); }
        如果 (字节q == 85 || 字节q == 117) { 后缀q = 字符串复制("U" + 后缀q); }
        尾q--;
    }
    // 1016（三轮审查 P2①）：宿主 literalTypeOf 白名单——仅 U/UL/ULL（大小写
    //   不敏感）定级无符号；LU/LLU 等非法顺序宿主回退整32=不属本判据面。
    布尔 合法无符号q = 字符串比较(后缀q, "U") ||
                       字符串比较(后缀q, "UL") ||
                       字符串比较(后缀q, "ULL");
    // 后缀非 U/UL/ULL 白名单（宿主 literalTypeOf 口径）：形态否定回答判假
    如果 (!合法无符号q) { 返回 假; }
    // 进制前缀跳（0x/0b/0o）后逐位非零判定（'0'=48 闭集）
    整64 i = 起q;
    如果 (尾q - i > 2 && 字节值(数字文本, i) == 48) {
        整64 次q = 字节值(数字文本, i + 1);
        如果 (次q == 120 || 次q == 88 || 次q == 98 || 次q == 66 ||
            次q == 111 || 次q == 79) { i = i + 2; }
    }
    当 (i < 尾q) {
        如果 (字节值(数字文本, i) != 48) { 返回 真; }
        i++;
    }
    返回 假;
}

// 558（506甲）：无符号十进制数字文本 ≤ 上界文本（长度优先·等长逐字节比·
//   大数安全——整64 解析承载面彻底退出判域路径）
函数 数文本不超上界(字符串 数字文本, 字符串 上界文本) -> 布尔 {
    字符串 值t = 数文本去前导零(数字文本);
    字符串 界t = 数文本去前导零(上界文本);
    整64 长值 = 字符串长度(值t);
    整64 长界 = 字符串长度(界t);
    如果 (长值 != 长界) { 返回 长值 < 长界; }
    整64 k = 0;
    当 (k < 长值) {
        整64 字节值a = 字节值(值t, k);
        整64 字节值b = 字节值(界t, k);
        如果 (字节值a != 字节值b) { 返回 字节值a < 字节值b; }
        k++;
    }
    返回 真;
}

// 558 修复（审查 P1-1·零分叉）→ 910（超64域口径收口·759 探针实锚）：进制
//   前缀字面量值级判域——重写为「有效位数分档 + 值级判定」，与宿主
//   types::normalizeIntLiteralToDecimal + decTextFits* 文本域判定语义对齐
//   （判定单一真源·双侧同口径）。
//   原实现「超 int64 正上界=溢出回 0→域内放行（诚实边界·#547 收口）」废止：
//   `整64 x = 0x8000000000000000;` 原 v2 放行位模式 MIN vs 宿主巨额立即数
//   汇编失败（A2022）——双侧分叉实锚；910 起超域双侧同拒、域内双侧同放行。
//   分档（k=去前导零后的有效数字位数；数值按无符号位解析，负号先剥离）：
//     A 档（值 ≤ 2^63-1）= hex k≤15 或（k==16 且首字符 ≤'7'）；oct k≤21；
//       bin k≤63 → 逐位累加（整64 承载内不溢出）+ 值级域表（下方原样）。
//     B 档（值 ∈ [2^63, 2^64-1]）= hex k==16 首字符 ≥'8'；oct k==22 首字符
//       '1'；bin k==64（去零后首位恒 '1'）→ 无符号语义：整128 放行／正128
//       按符号性；≤64 目标仅「无负号+正64」与「负号+整64 且 值恰 2^63
//      （=-2^63=整64 最小界）」两态放行，其余拒。
//     C 档（值 ≥ 2^64）= 其余位数超限 → 128 目标放行（超 128 域由物化侧
//       字面量超128域 拦·818/064 分工不变）；≤64 目标全拒。
//   负号形态按数学负值判（宿主值级 fits 同构·-0 域内）；非法字符/进制外数字
//   =检不出放行（词法不可达面·防御）。
不安全 函数 进制字面量值级入域(字符串 文本h, 字符串 目标文本, 布尔 负号) -> 布尔 {
    // 前缀定进制（宿主 parseIntValue 同款：0x/0X/0b/0B/0o/0O·调用方已拦·防御复判）
    整64 进位h = 10;
    整64 起h = 0;
    如果 (字符串长度(文本h) > 2 && 字节值(文本h, 0) == 48) {
        整64 次h = 字节值(文本h, 1);
        如果 (次h == 120 || 次h == 88) { 进位h = 16; 起h = 2; }
        否则 如果 (次h == 98 || 次h == 66) { 进位h = 2; 起h = 2; }
        否则 如果 (次h == 111 || 次h == 79) { 进位h = 8; 起h = 2; }
    }
    // 910：L/U 后缀剥离（hex 面 F 是数字不剥·与宿主 literalTypeOf 守卫同构；
    //   调用点进制面按原样文本传入·后缀定级由后缀类型ID 通道另行承担）
    整64 终h = 字符串长度(文本h);
    当 (终h > 起h) {
        整64 尾b = 字节值(文本h, 终h - 1);
        如果 (尾b == 76 || 尾b == 108 || 尾b == 85 || 尾b == 117) { 终h--; } 否则 { 中断; }
    }
    // 去前导零得有效数字区间 [首h, 终h)
    整64 首h = 起h;
    当 (首h < 终h && 字节值(文本h, 首h) == 48) { 首h++; }
    如果 (首h >= 终h) {
        返回 真;   // 全零：值 0 一切整型域内（-0 亦域内）
    }
    // 有效位字符扫描（进制外字符=检不出放行·词法不可达面防御）
    整64 扫h = 首h;
    当 (扫h < 终h) {
        整64 数h = 字节值(文本h, 扫h);
        如果 (数h >= 48 && 数h <= 57) { 扫h++; }
        否则 如果 (数h >= 97 && 数h <= 102) { 扫h++; }
        否则 如果 (数h >= 65 && 数h <= 70) { 扫h++; }
        // 静默豁免业务值: 910 轮全零数字串值 0 一切整型域内放行（-0 同）
        否则 { 返回 真; }
    }
    整64 kh = 终h - 首h;
    整64 首c = 字节值(文本h, 首h);
    // 910：A/B 档判定（C 档=两档皆假）
    布尔 档Ah = 假;
    布尔 档Bh = 假;
    如果 (进位h == 16) {
        如果 (kh <= 15) { 档Ah = 真; }
        否则 如果 (kh == 16) {
            如果 (首c <= 55) { 档Ah = 真; }   // '7'=55：0x7FFF…=2^63-1
            否则 { 档Bh = 真; }               // '8'..'f'：∈[2^63,2^64-1]
        }
    } 否则 如果 (进位h == 2) {
        如果 (kh <= 63) { 档Ah = 真; }
        否则 如果 (kh == 64) { 档Bh = 真; }
    } 否则 如果 (进位h == 8) {
        如果 (kh <= 21) { 档Ah = 真; }        // 8^21-1 = 2^63-1
        否则 如果 (kh == 22 && 首c == 49) { 档Bh = 真; }   // '1'：0o1…=∈[2^63,2^64-1]
    } 否则 {
        档Ah = 真;   // 十进制不达本函数（调用方分流）——防御按 A 档值级
    }
    如果 (!档Ah) {
        // 910：B/C/D 档（值 ≥ 2^63）——128 目标按界判定（整128 正域
        //   2^127-1／负域 2^127·正128 2^128-1；超 2^128 亦拒），其余目标
        //   按 B/C 档 ≤64 判定（C/D 档超 u64 → 全拒）
        如果 (字符串比较(目标文本, "整128")) {
            如果 (!负号) { 返回 进制值不超界910(文本h, 首h, 终h, 进位h, 0); }
            返回 进制值不超界910(文本h, 首h, 终h, 进位h, 1);
        }
        如果 (字符串比较(目标文本, "正128")) {
            如果 (负号) { 返回 假; }
            返回 进制值不超界910(文本h, 首h, 终h, 进位h, 2);
        }
        // C/D 档（值≥2^64）：≤64 目标全拒
        如果 (!档Bh) { 返回 假; }             // C/D 档（≥2^64）：≤64 目标全拒
        如果 (负号) {
        // B 档负号形态：值∈[2^63,2^64-1] 仅「恰 -2^63=整64 最小界」可入整64，其余目标超域拒
        如果 (!字符串比较(目标文本, "整64")) { 返回 假; }
            返回 值恰2的63次幂(文本h, 首h, 终h, 进位h);
        }
        返回 字符串比较(目标文本, "正64");     // B 档正形：仅正64 域内
    }
    // A 档（值 ≤ 2^63-1）：逐位累加（分档保证不溢出整64）+ 值级域表
    整64 累h = 0;
    整64 ih = 首h;
    当 (ih < 终h) {
        整64 数h = 字节值(文本h, ih);
        如果 (数h >= 48 && 数h <= 57) { 数h = 数h - 48; }
        否则 如果 (数h >= 97 && 数h <= 102) { 数h = 数h - 87; }
        // 'A'-'F'（65-70）→ 10-15：进制字符换算（值-55·扫描面已限定 0-9/a-f/A-F 闭集）
        否则 { 数h = 数h - 55; }
        累h = 累h * 进位h + 数h;
        ih++;
    }
    如果 (负号) { 累h = 0 - 累h; }
    // 值级域表（宿主 fits/fitsU 同款·与文本级受检矩阵一一对应）
    如果 (字符串比较(目标文本, "整8")) { 返回 累h >= -128 && 累h <= 127; }
    如果 (字符串比较(目标文本, "正8")) { 返回 !负号 && 累h <= 255; }
    如果 (字符串比较(目标文本, "整16")) { 返回 累h >= -32768 && 累h <= 32767; }
    如果 (字符串比较(目标文本, "正16")) { 返回 !负号 && 累h <= 65535; }
    如果 (字符串比较(目标文本, "整32")) { 返回 累h >= -2147483648 && 累h <= 2147483647; }
    // 1160 审查修复 P0-1：字符=整32 有符号存储域（甲案·进制前缀初值面；
    //   B/C/D 档（值≥2^63）在上方 ≤64 目标分支已拒——本档值 ≤2^63-1）
    如果 (字符串比较(目标文本, "字符")) { 返回 累h >= -2147483648 && 累h <= 2147483647; }
    如果 (字符串比较(目标文本, "正32")) { 返回 !负号 && 累h <= 4294967295; }
    如果 (字符串比较(目标文本, "整64")) {
        返回 累h >= -9223372036854775807 - 1 && 累h <= 9223372036854775807;
    }
    如果 (字符串比较(目标文本, "正64")) {
        返回 !负号;
    }
    // 910：128 目标（A 档值 ≤2^63-1 恒在 128 正负域内）——正128 负号拒
    //   （对齐宿主 intLiteralFitsType decTextFitsUnsignedRange 负号面）
    如果 (字符串比较(目标文本, "正128")) { 返回 !负号; }
    返回 真;   // 整128/未知目标：A 档值域宽裕，恒适
}

// 910：进制有效数字余位全 '0' 判定（首字符之后 [首h+1, 终h) 全零）——
//   值恰为「首位权」形态判定共用件（2^63/2^127 等精确点）。
不安全 函数 余位全零910(字符串 文本h, 整64 首h, 整64 终h) -> 布尔 {
    整64 i = 首h + 1;
    当 (i < 终h) {
        如果 (字节值(文本h, i) != 48) { 返回 假; }                // '0'=48
        i++;
    }
    返回 真;
}

// 910：进制文本值 ≤ 界限判定（界k：0=2^127-1／1=2^127／2=2^128-1）——位数
//   分档（调用前提=已去前导零；k 不足上限恒在界内）：
//     hex：32 位档首字符 ≤'7'（≤2^127-1）恒入 0/1/2；=='8' 恰 2^127 入 1/2；
//       ≥'9' 仅入 2；33 位+ 超（≥2^128）。
//     oct：43 位档 ≤'1' 恒入；=='2' 恰 2^127 入 1/2；≤'3' 入 2；44 位+ 超。
//     bin：128 位档全零尾恰 2^127 入 1/2；非全零尾仅入 2（<2^128）；129 位+ 超。
//   ——与宿主 decTextFits* 界文本比较语义同构（双侧判定单一真源）。
不安全 函数 进制值不超界910(字符串 文本h, 整64 首h, 整64 终h, 整64 进位h, 整64 界k) -> 布尔 {
    整64 kh = 终h - 首h;
    整64 首c = 字节值(文本h, 首h);
    如果 (进位h == 16) {
        如果 (kh < 32) { 返回 真; }
        如果 (kh > 32) { 返回 假; }           // ≥2^128
        如果 (首c <= 55) { 返回 真; }         // ≤'7'：≤2^127-1
        如果 (界k == 2) { 返回 真; }          // 32 位 hex ≤2^128-1 恒真
        如果 (界k == 1) { 返回 (首c == 56) && 余位全零910(文本h, 首h, 终h); }
        返回 假;
    }
    如果 (进位h == 8) {
        如果 (kh < 43) { 返回 真; }
        如果 (kh > 43) { 返回 假; }           // ≥2^128（43 位档上限 2^129-1 细判在档内）
        如果 (界k == 2) { 返回 首c <= 51; }   // ≤'3'：≤2^128-1
        如果 (首c <= 49) { 返回 真; }         // ≤'1'：≤2^127-1
        如果 (界k == 1) { 返回 (首c == 50) && 余位全零910(文本h, 首h, 终h); }
        返回 假;
    }
    // bin
    如果 (kh < 128) { 返回 真; }
    如果 (kh > 128) { 返回 假; }              // ≥2^128
    如果 (界k == 0) { 返回 假; }              // 128 位 bin ≥2^127
    如果 (界k == 2) { 返回 真; }
    返回 余位全零910(文本h, 首h, 终h);        // 恰 2^127 入界 1
}

// 910：进制文本值恰为 2^63 判定（-2^63=整64 最小界·B 档负号形态唯一域内点）
//   ——调用前提=B 档（有效位数恰为 hex16/oct22/bin64 由分档保证），故只需
//   「首值位匹配 2^63 的进制表示 + 余位全 '0'」：hex '8'／oct '1'／bin '1'。
不安全 函数 值恰2的63次幂(字符串 文本h, 整64 首h, 整64 终h, 整64 进位h) -> 布尔 {
    整64 首c = 字节值(文本h, 首h);
    布尔 首对 = 假;
    如果 (进位h == 16) { 首对 = 首c == 56; }                      // '8'=56
    否则 如果 (进位h == 8 || 进位h == 2) { 首对 = 首c == 49; }    // '1'=49
    如果 (!首对) { 返回 假; }
    返回 余位全零910(文本h, 首h, 终h);
}

// 558（506甲）→ 535 入口抽取：字面量文本值域判定（原 整字面量入域 文本
//   核心逐字搬移）——受检矩阵与值域（文本级判定·宿主 intLiteralFitsType
//   十进制文本路径一致）：整8 [-128,127]／正8 [0,255]／整16 [-32768,32767]／
//   正16 [0,65535]／正32 [0,4294967295]／整32 [-2147483648,2147483647]／
//   整64 [-2^63,2^63-1]／正64 [0,2^64-1]。负号+字面量形态按数学负值判
//   （-2147483648=整32::MIN 域内合法·存量零翻转）。进制前缀→值级判域；
//   整数后缀剥离→文本级判域（宿主 decimalDigitsOf 同款剥法）。非纯十进制
//   残形=检不出放行（防御·词法不可达面）。
函数 字面量文本入域(字符串 文本l入, 字符串 目标文本, 布尔 负号) -> 布尔 {
    字符串 文本l = 字符串复制(文本l入);
    整64 长l = 字符串长度(文本l);
    如果 (长l == 0) { 返回 真; }
    // 558 修复：进制前缀面（0x/0X/0b/0B/0o/0O·宿主 decimalDigitsOf 前缀拦截
    //   同款 size>2 门槛）→ 910：委托 进制字面量值级入域（位数分档判定·
    //   超64域口径收口——原「超承载同放行」面已收）
    如果 (长l > 2 && 字节值(文本l, 0) == 48) {
        整64 次l = 字节值(文本l, 1);
        如果 (次l == 120 || 次l == 88 || 次l == 98 || 次l == 66 ||
             次l == 111 || 次l == 79) {
            返回 进制字面量值级入域(文本l, 目标文本, 负号);
        }
    }
    // 558 修复：整数后缀剥离（宿主 decimalDigitsOf 同款自尾剥 L/l/U/u/F/f·
    //   非前缀面 F/f 可剥）——带后缀十进制超域（99999999999999999999L→整64）
    //   宿主拒·v2 修复前「见 L 放行」=分叉；v2 词法整数形态仅消费 L/U（f/F
    //   浮点形态专属·不可达面），防御同剥与宿主同构。剥空=词法不可达退化形态
    //   →后续全数字扫描零通过按「检不出放行」对齐宿主回退值级 0 放行。
    当 (长l > 0) {
        整64 尾l = 字节值(文本l, 长l - 1);
        如果 (尾l == 76 || 尾l == 108 || 尾l == 85 || 尾l == 117 ||
             尾l == 70 || 尾l == 102) {
            长l--;
        } 否则 { 中断; }
    }
    文本l = 字符串子串(文本l, 0, 长l);
    整64 扫i = 0;
    当 (扫i < 长l) {
        整64 字节s = 字节值(文本l, 扫i);
        如果 (字节s < 48 || 字节s > 57) { 返回 真; }   // 非纯十进制=检不出放行
        扫i++;
    }
    如果 (字符串比较(目标文本, "整8")) {
        布尔 入域a558 = 数文本不超上界(文本l, "127");
        如果 (负号) { 入域a558 = 数文本不超上界(文本l, "128"); }
        返回 入域a558;
    }
    如果 (字符串比较(目标文本, "正8")) { 返回 !负号 && 数文本不超上界(文本l, "255"); }
    如果 (字符串比较(目标文本, "整16")) {
        布尔 入域b558 = 数文本不超上界(文本l, "32767");
        如果 (负号) { 入域b558 = 数文本不超上界(文本l, "32768"); }
        返回 入域b558;
    }
    如果 (字符串比较(目标文本, "正16")) { 返回 !负号 && 数文本不超上界(文本l, "65535"); }
    如果 (字符串比较(目标文本, "正32")) { 返回 !负号 && 数文本不超上界(文本l, "4294967295"); }
    如果 (字符串比较(目标文本, "整32")) {
        布尔 入域c558 = 数文本不超上界(文本l, "2147483647");
        如果 (负号) { 入域c558 = 数文本不超上界(文本l, "2147483648"); }
        返回 入域c558;
    }
    // 1160 审查修复 P0-1：字符=整32 存储域（甲案·001 §3.7/§3.7b 整源→字符
    //   位模式互通；1137 最后一轮 P0-3 同口径）——初值 1114112/-2147483648
    //   放行、2147483648/-2147483649 拒；四通道（局部/函数内静态/顶层静态/
    //   类静态）共用本表单点。
    如果 (字符串比较(目标文本, "字符")) {
        布尔 入域z558 = 数文本不超上界(文本l, "2147483647");
        如果 (负号) { 入域z558 = 数文本不超上界(文本l, "2147483648"); }
        返回 入域z558;
    }
    如果 (字符串比较(目标文本, "整64")) {
        布尔 入域d558 = 数文本不超上界(文本l, "9223372036854775807");
        如果 (负号) { 入域d558 = 数文本不超上界(文本l, "9223372036854775808"); }
        返回 入域d558;
    }
    如果 (字符串比较(目标文本, "正64")) { 返回 !负号 && 数文本不超上界(文本l, "18446744073709551615"); }
    // 910：128 目标补负号面（正128 负字面量=超域·对齐宿主 intLiteralFitsType
    //   decTextFitsUnsignedRange 负号恒拒）；整128 负号域内维持恒真（超域界由
    //   物化侧 字面量超128域 / 静态面 字面量文本入域128_640 承接）
    如果 (字符串比较(目标文本, "正128")) { 返回 !负号; }
    返回 真;   // 整128：域宽于任何整64 承载内文本，恒适
}

// 640（2026-10-16）→ 910（超64域口径收口）：128 槽文本域判定（整128 合法域
//   [-2^127, 2^127-1]／正128 [0, 2^128-1]）——供**静态槽三形态**挂点
//  （535 挂点补充消费）；535 原版 字面量文本入域 对 128 目标「域宽于任何
//   int64 承载内文本恒适」仅对 ≤int64 文本成立——超承载文本可超 2^127
//  （2^128-1 39 位实锚 m642c/d 探针：宿主拒/v2 放行错值=双侧分叉）。本判定
//   只供静态槽面（不扩通用转换面——局部形态 [ir2] 诊断链 540/664 既有面
//   不动）。口径=IR容器尾 字面量超128域（宿主 intLiteralFitsType 128 界
//   同构）：910 起进制面前缀**收口**（原「检不出放行·#547 面」→委托
//   进制字面量值级入域 位数分档 128 界判定——物化侧 解析128位初值文本 对
//   超 128 位值的静默 mod 2^128 截断风险源从入域面拦截）。返回=在域内。
函数 字面量文本入域128_640(字符串 文本l入, 字符串 目标文本, 布尔 负号) -> 布尔 {
    如果 (!字符串比较(目标文本, "整128") && !字符串比较(目标文本, "正128")) { 返回 真; }
    字符串 文本l = 字符串复制(文本l入);
    整64 长l = 字符串长度(文本l);
    如果 (长l == 0) { 返回 真; }
    // 910：进制前缀面委托统一判定（位数分档 128 界·与转换面/物化面单一真源）
    如果 (长l > 2 && 字节值(文本l, 0) == 48) {
        整64 次l = 字节值(文本l, 1);
        如果 (次l == 120 || 次l == 88 || 次l == 98 || 次l == 66 ||
             次l == 111 || 次l == 79) {
            返回 进制字面量值级入域(文本l, 目标文本, 负号);
        }
    }
    // 整数后缀剥离（宿主 decimalDigitsOf 同款自尾剥 L/l/U/u/F/f）
    当 (长l > 0) {
        整64 尾l = 字节值(文本l, 长l - 1);
        如果 (尾l == 76 || 尾l == 108 || 尾l == 85 || 尾l == 117 ||
            尾l == 70 || 尾l == 102) {
            长l--;
        } 否则 { 中断; }
    }
    文本l = 字符串子串(文本l, 0, 长l);
    整64 扫i = 0;
    当 (扫i < 长l) {
        整64 字节s = 字节值(文本l, 扫i);
        如果 (字节s < 48 || 字节s > 57) { 返回 真; }   // 非纯十进制=检不出放行
        扫i++;
    }
    如果 (字符串比较(目标文本, "整128")) {
        布尔 入域e640 = 数文本不超上界(文本l, "170141183460469231731687303715884105727");
        如果 (负号) { 入域e640 = 数文本不超上界(文本l, "170141183460469231731687303715884105728"); }
        返回 入域e640;
    }
    返回 (!负号) && 数文本不超上界(文本l, "340282366920938463463374607431768211455");
}

// ==================== 1160：整数字面量后缀定级（自 语义检查字面量域.cn 下沉 IR） ====================
// 1160 审查 P2①（IR→语义层倒挂根治）：原定义在 语义/语义检查字面量域.cn，
//   被 IR/IR情况标签.cn（承载族判定）反向依赖 = 层序倒挂（334）。本函数=纯
//   文本变换无语义依赖，下沉 IR 中立层（语法/语义/IR 三方白名单可依赖）；
//   v2 侧语义检查字面量域 的 字面量整型类型ID 经合并全局池解析本定义，
//   消费面无改动。
// 728s 原注：后缀定级单点（宿主 literalTypeOf 精确同构）——L→整64／LL→整128／
//   U→正32／UL→正64／ULL→正128；大小写不敏感·保序前插大写化；返回类型名ID
//   （0=无后缀/非法组合·调用方维持既有契约）。0x/0b/0o 前缀无碍（F 不属后缀
//   字符集·收集即断；0xFUL 的 UL 正常收集）。
函数 字面量后缀类型ID(字符串 字面文本) -> 整64 {
    字符串 后缀 = "";
    整64 尾 = 字符串长度(字面文本);
    当 (尾 > 0) {
        整64 字节 = 整64(字面文本[尾 - 1]) & 255;
        如果 (字节 == 76 || 字节 == 108) {          // 'L'/'l'
            后缀 = 字符串复制("L" + 后缀);
        } 否则 如果 (字节 == 85 || 字节 == 117) {   // 'U'/'u'
            后缀 = 字符串复制("U" + 后缀);
        } 否则 {
            中断;
        }
        尾 = 尾 - 1;
    }
    如果 (字符串比较(后缀, "L")) { 返回 驻留("整64"); }
    如果 (字符串比较(后缀, "LL")) { 返回 驻留("整128"); }
    如果 (字符串比较(后缀, "U")) { 返回 驻留("正32"); }
    如果 (字符串比较(后缀, "UL")) { 返回 驻留("正64"); }
    如果 (字符串比较(后缀, "ULL")) { 返回 驻留("正128"); }
    返回 0;   // 无后缀（整32 恒定级契约）与非法组合（宿主回退整32 同口径）
}

// ==================== 1161：浮点字面量承载域判定（910 家族浮点面） ====================
// 1161（P1·1137 审查派生·#1076「字面量超目标类型表示范围=编译期拒」对齐）：
//   浮点字面量超 double/float 表示域原无编译期诊断——宿主发射层解析失败回 0
//   位模式静默错值（`浮64 a=1e999` 运行 a=0.000000、`-1e999` IR 乘 -1.0 得
//   -0.000000）；v2 REAL8 文本直通 ml64 A2048 汇编失败（双侧基线探针实锚）。
//   本族=文本级判域（宿主 types::floatLiteralFitsTypeDomain 逐字同构·零分叉）：
//   归一 尾数数字串S×10^E 与目标类型上界（浮64=DBL_MAX≈1.7976931348623157e308
//   =17976931348623157×10^292 ／ 浮32=FLT_MAX≈3.4028234663852886e38
//   =34028234663852886×10^22）比较——科学计数归一指数 m=S长+E-1（d.ddd×10^m）
//   与上界指数 U（308/38）比大小，m==U 时 S 与上界串右补零至等长字典序
//   （数文本不超上界 复用·补零后同指数即数学值比较）。下溢 subnormal（1e-320）
//   域内放行（宿主现状 subnormal 位模式保真·基线实锚）。E 数量级先钳定
//   （|E|>10000 必超/必域内·数学上等价）防 整64 回绕毒化。
//   边界锚：1e308 域内／1e309 拒／DBL_MAX 文本域内／比 DBL_MAX 大 1ulp 文本拒
//   ／1e999f（浮32 定级）拒／1e-320 域内。

// 1161 辅助：十进制数字串→整64（剥零后 ≤18 位·调用方钳定前置承载安全）
函数 浮点指数段转值1161(字符串 数字文本) -> 整64 {
    整64 值e = 0;
    整64 长e = 字符串长度(数字文本);
    整64 k = 0;
    当 (k < 长e) {
        值e = 值e * 10 + ((整64(数字文本[整32(k)]) & 255) - 48);
        k = k + 1;
    }
    返回 值e;
}

// 1161 辅助：找字节首现位置（返回 长度=未命中哨兵·调用方以 等长 判定）
函数 浮点字节首现1161(字符串 文本f, 整64 目标字节) -> 整64 {
    整64 长f = 字符串长度(文本f);
    整64 k = 0;
    当 (k < 长f) {
        如果 ((整64(文本f[整32(k)]) & 255) == 目标字节) { 返回 k; }
        k = k + 1;
    }
    返回 长f;
}

// 1161：浮点字面量承载域文本级判定——真=域内放行；假=超域（调用方编译期拒）。
//   算法与宿主 floatLiteralFitsTypeDomain 逐字同构（注释互镜·禁散写第二判据）。
函数 浮点字面量文本入域(字符串 文本k, 字符串 目标文本) -> 布尔 {
    // 静默豁免闭集穷举: 目标闭集守卫（调用方 f/F 定级仅产 浮32/浮64·非浮点目标不入本判域恒真·非 miss 默认）
    如果 (!字符串比较(目标文本, "浮64") && !字符串比较(目标文本, "浮32")) {
        返回 真;
    }
    字符串 t1161 = 字符串复制(文本k);
    整64 长t = 字符串长度(t1161);
    // 剥 f/F 后缀（词法允许单后缀·102='f' 70='F'；!=0=尾字节存在守卫·词法浮点 token 恒非空）
    如果 (长t != 0 && ((整64(t1161[整32(长t - 1)]) & 255) == 102 ||
                      (整64(t1161[整32(长t - 1)]) & 255) == 70)) {
        t1161 = 字符串子串(t1161, 0, 长t - 1);
    }
    // 剥正负号（|值| 域判定·符号不影响；43='+' 45='-'）
    如果 (字符串长度(t1161) != 0 && (((整64(t1161[整32(0)]) & 255) == 43) ||
                                    ((整64(t1161[整32(0)]) & 255) == 45))) {
        t1161 = 字符串子串(t1161, 1, 字符串长度(t1161) - 1);
    }
    整64 指数 = 0;
    字符串 主体k = 字符串复制(t1161);
    // 拆 e/E 指数段（词法保证指数段外无 e/E·101='e' 69='E'）
    整64 位置e = 浮点字节首现1161(t1161, 101);
    整64 位置大e = 浮点字节首现1161(t1161, 69);
    如果 (位置大e < 位置e) { 位置e = 位置大e; }
    如果 (位置e < 字符串长度(t1161)) {
        主体k = 字符串子串(t1161, 0, 位置e);
        字符串 指数段 = 字符串子串(t1161, 位置e + 1,
                                  字符串长度(t1161) - 位置e - 1);
        布尔 指负 = 假;
        如果 (字符串长度(指数段) != 0 && (((整64(指数段[整32(0)]) & 255) == 43) ||
                                        ((整64(指数段[整32(0)]) & 255) == 45))) {
            指负 = (整64(指数段[整32(0)]) & 255) == 45;
            指数段 = 字符串子串(指数段, 1, 字符串长度(指数段) - 1);
        }
        指数段 = 数文本去前导零(指数段);
        // 三区间显式枚举（else 新规·无兜底 else 块）：空段=指数 0／
        //   [1,18] 位=承载内正常解析／19 位以上=巨指数量级钳定
        如果 (字符串长度(指数段) == 0) {
            指数 = 0;   // 1e+ 词法退化形态（符号后空段）=指数 0
        }
        如果 (字符串长度(指数段) >= 1 && 字符串长度(指数段) <= 18) {
            指数 = 浮点指数段转值1161(指数段);
            如果 (指负) { 指数 = 0 - 指数; }
        }
        如果 (字符串长度(指数段) > 18) {   // 静默豁免业务值: 巨指数（剥零后 19 位以上=10^±10^18 级）按数量级直接定域·数学上恒真恒假·防整64承载回绕毒化·非 miss 默认
            如果 (指负) { 返回 真; }
            返回 假;
        }
    }
    // 主体拆 整数段.小数段（词法形态 digits[.digits]·46='.'）
    整64 位置点 = 浮点字节首现1161(主体k, 46);
    整64 小数长 = 0;
    如果 (位置点 < 字符串长度(主体k)) {
        小数长 = 字符串长度(主体k) - 位置点 - 1;
        // 数字串=整数段+小数段（删点即拼接）
        字符串 整段k = 字符串子串(主体k, 0, 位置点);
        字符串 小段k = 字符串子串(主体k, 位置点 + 1,
                                  字符串长度(主体k) - 位置点 - 1);
        主体k = 整段k + 小段k;
    }
    字符串 数字串 = 数文本去前导零(主体k);
    如果 (字符串比较(数字串, "0")) { 返回 真; }   // 值 0（0.0/000e5 等）域内
    // 有效指数 E = e指数 - 小数位数；数量级钳定防下方 S长+E-1 回绕
    整64 有效指数 = 指数 - 小数长;
    如果 (有效指数 > 10000) { 返回 假; }   // 静默豁免业务值: 10^10000 必超一切浮点域（数学上恒真·非 miss 默认）
    如果 (有效指数 < 0 - 10000) { 返回 真; }   // 静默豁免业务值: 10^-10000 必 subnormal 下溢方向=域内放行（宿主现状·非 miss 默认）
    整64 归一指数 = 字符串长度(数字串) + 有效指数 - 1;
    // 上界显式闭集枚举（调用方定级仅产 浮32/浮64）
    整64 上界指数 = 308;
    字符串 上界串 = 字符串复制("17976931348623157");
    如果 (字符串比较(目标文本, "浮32")) {
        上界指数 = 38;
        上界串 = 字符串复制("34028234663852886");
    }
    如果 (归一指数 > 上界指数) { 返回 假; }
    如果 (归一指数 < 上界指数) { 返回 真; }
    // m == U：有效数字右补零至等长字典序（数文本不超上界 长度+逐位比较复用）
    整64 宽k = 字符串长度(数字串);
    如果 (字符串长度(上界串) > 宽k) { 宽k = 字符串长度(上界串); }
    当 (字符串长度(数字串) < 宽k) { 数字串 = 数字串 + "0"; }
    当 (字符串长度(上界串) < 宽k) { 上界串 = 上界串 + "0"; }
    返回 数文本不超上界(数字串, 上界串);
}
