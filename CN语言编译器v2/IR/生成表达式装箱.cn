// 生成表达式装箱（356 重构F1 自 生成表达式求值.cn 纯机械搬移·函数体逐字保留·零逻辑变化）
导入 容器::向量;
导入 映射集合;
导入 语法;       // Token/AST 节点池（目录包名）
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码 + IR常量 键位移（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 IR生成;     // 函数级变量类型权威表/重载决议/控制流辅助（同包幂等）

公开:

// 71-a（2026-09-11 方案A 用户裁决）：内置构造器 正常()/错误()/某些() 装箱发射
// 067-003：已装箱节点表（嵌套预求值去重——键=节点索引）
静态 映射<整64, 整64> 已装箱节点们;
// 067-003：已装箱节点表任务级生命周期清空（IR生成/IR生成多文件 入口调用——
//   键=池位置索引：跨任务残留会误跳过装箱，与 清空引用参数表 同纪律）。
函数 清空已装箱节点表() -> 空类型 {
    已装箱节点们.清空();
}
//   （宿主 handleResultCtor/ir_error_ctor 同构，Rust Ok/Err/Some 零成本抽象）：
//   合成布局 正常@0(4字节)+值@4(整32/正32)/@8(其余)（结果值偏移，与宿主
//   typeSizeOf/接收侧 生成结果局部 布局双侧一致）；槽组=结果槽位数 个 8 字节槽、
//   基槽=最大槽号低地址。标志/值经 基址+IR_字段地址+IR_指针存储 按宽度写入
//   （整32 值与标志同槽不覆盖）。压栈产物=临时基址（返回位由 生成返回语句 拷入
//   retbuf；声明位由 生成结果局部 IR_结构体拷贝 接收）。
//   move 语义（正常/某些(拥有标识符)）：实参单标识符形态登记 已装箱名——出口
//   释放（发射字符串释放/发射容器析构/块出口析构）跳过=所有权转交装箱值（Rust
//   Ok(s) move 同款零拷贝；宿主 70-a 源槽清零同效，v2 跳过模型双装箱退化借用）。
//   表达式实参（拼接/调用产物）=临时值无源槽，不登记（出口本就不释放）。
// 067-003 内层装箱名推导（嵌套安全·543/546 fault=5 根治）：原兜底走
//   解析节点类型ID → 调用分支经 解析调用返回结构体 **按被调名查函数返回表**
//   ——内外层同名构造器（某些/正常/错误）拿到同一类型 → 内层某些被推成外层
//   类型（可选$可选$盒子）→ 载荷判成结果类型 → CopyStruct 16B（asm 铁证
//   `rep movsb rcx=16 rsi=对象句柄`；应 8B 句柄直存）。
//   修正=内置构造器按**语义 + 实参类型**推导：某些(x)→可选$typeof(x)；
//   正常(x)→结果$typeof(x)$E；错误(x)→结果$T$typeof(x)（T/E 未知按 整32 兜底
//   ——8 字节族槽位/偏移同构，宽类型场景登记边界）。实参自身是构造器时递归。
函数 推导构造器装箱类型(向量<节点> 池, 节点 n, 整32 位置) -> 整64 {
    如果 (n.子起点 <= 0) { 返回 0; }
    // 067-003（24_error_handling 回归防护）：**无实参构造器**（`正常()`·
    //   结果<空类型,E> 形态）——「位置-1」会指向无关节点（非实参）→ 推错类型
    //   （24「空配置错误码 5→垃圾」实证）。无实参=类型由上下文/标注决定，
    //   本函数不推导（回退原标注路径）。
    如果 (n.附加 < 1) { 返回 0; }
    整64 被调位 = 整64(n.子起点);
    如果 (被调位 >= 整64(池.大小())) { 返回 0; }
    字符串 名 = 字符串复制(驻留文本(整64(池.元素(整32(被调位)).文本)));
    // 067-003（AST 后缀式实证·dbgA 铁证）：实参子树落地点=**紧邻调用节点之前**
    //   （外层某些 位=63 → 位-1=62=内层某些调用节点）。原「被调位+1」取到实参
    //   子树的**首节点**（标识符/字面量·类型 10/11）→ 判定失败 → 内层未装箱。
    整64 实参位 = 整64(位置) - 1;
    如果 (实参位 <= 0 || 实参位 >= 整64(池.大小())) { 返回 0; }
    节点 实参n = 池.元素(整32(实参位));
    整64 实参型ID = 0;
    如果 (实参n.类型 == 节点_调用 && 整64(实参n.子起点) > 0) {
        字符串 内被调 = 字符串复制(驻留文本(整64(池.元素(整32(实参n.子起点)).文本)));
        如果 (字符串比较(内被调, "正常") || 字符串比较(内被调, "错误") ||
             字符串比较(内被调, "某些")) {
            实参型ID = 推导构造器装箱类型(池, 实参n, 整32(实参位));
        }
    }
    如果 (实参型ID <= 0) {
        // 067-003（构造调用实参类型·dbg dump 实证）：实参=类构造调用 `盒子(...)`
        //   时 解析节点类型ID 经 解析调用返回结构体 **按被调名查函数返回表**
        //   miss（构造器无普通函数返回登记）→ 类型 0 → 推导失败回退外层标注 ✗。
        //   修正=被调标识符命中 结构体大小表/用户类表 → 该名即类型（构造表达式
        //   类型=类自身）。
        如果 (实参n.类型 == 节点_调用 && 整64(实参n.子起点) > 0) {
            节点 被调a = 池.元素(整32(实参n.子起点));
            如果 (被调a.类型 == 节点_标识符) {
                字符串 名a = 字符串复制(驻留文本(整64(被调a.文本)));
                如果 (查结构体大小(驻留(名a)) != 0 || 是用户类(名a)) {
                    实参型ID = 驻留(名a);
                }
            }
        }
    }
    如果 (实参型ID <= 0) {
        // 067-003（字面量实参·dbg 实证）：解析节点类型ID 无字面量分支 → 0 →
        //   推导失败回退外层标注（三层标量 `某些(某些(某些(7)))` 全推成外层名
        //   实证）。按字面量类别给基础类型。
        如果 (实参n.类型 == 节点_整数字面量) { 实参型ID = 驻留("整32"); }
        否则 如果 (实参n.类型 == 节点_浮点字面量) { 实参型ID = 驻留("浮64"); }
        否则 如果 (实参n.类型 == 节点_字符串字面量) { 实参型ID = 驻留("字符串"); }
    }
    如果 (实参型ID <= 0) { 实参型ID = 解析节点类型ID(池, 整32(实参位)); }
    如果 (实参型ID <= 0) { 返回 0; }
    字符串 实参型 = 字符串复制(驻留文本(实参型ID));
    如果 (字符串比较(名, "某些")) { 返回 驻留("可选$" + 实参型); }
    // 067-003（24_error_handling 回归防护）：正常/错误 的**缺失 E/T 从外层标注取**
    //   （标注=结果$T$E 形态·段切）——原硬编码「整32」在外层 T/E 非整32 时推错
    //   类型（24「空配置错误码」读 8 字节垃圾实证）。标注不可用=不做推导（回退原
    //   标注路径·零风险）。
    字符串 标注Tn = "";
    字符串 标注En = "";
    整64 标IDn = 整64(n.子终点);
    如果 (标IDn > 0) {
        字符串 标名n = 字符串复制(驻留文本(标IDn));
        如果 (是结果类型(标名n)) {
            标注Tn = 段首(合成名首实参(标名n));
            标注En = 段余(合成名首实参(标名n));
        }
    }
    如果 (字符串比较(名, "正常")) {
        如果 (字符串长度(标注En) == 0) { 返回 0; }
        返回 驻留("结果$" + 实参型 + "$" + 标注En);
    }
    如果 (字符串比较(名, "错误")) {
        如果 (字符串长度(标注Tn) == 0) { 返回 0; }
        返回 驻留("结果$" + 标注Tn + "$" + 实参型);
    }
    返回 0;
}

不安全 函数 生成装箱构造(向量<节点> 池, 节点 n, 整32 位置,
                         向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数,
                         向量<整64>& 表达式栈) -> 整32 {
    整64 装箱类型ID = 整64(n.子终点);
    // 826（067-003 治本收口）：**不再「恒用推导」**——根因已由**语义层递归下推
    //   修复**（`检查构造器调用` 给嵌套内层标注自身类型·211_v2/543 双满足）；
    //   此处改为「标注优先 + 未标注时推导兜底」（见下方 装箱类型ID <= 0 分支）。
    //   原「恒用推导」会**覆盖**语义层的正确标注（211_v2 ④ `可选<整64> 选 =
    //   可选包装()`〔返回 某些(42)〕：推导硬编码字面量整32 → 覆盖标注 整64 →
    //   校验位 +8 丢失实证）。
    // 067-003 去重（嵌套预求值后内层会被后续遍历再次装箱——第二次重跑破坏
    //   栈/寄存器一致性·544 新崩点 fault=0 实证）：被递归预求值的节点已装箱，
    //   遍历再达时直接跳过（产物已在栈上=该位置的求值结果）。
    结果<整64, 整32> 查已箱 = 已装箱节点们.获取(整64(位置));
    如果 (查已箱.正常) { 返回 1; }
    如果 (装箱类型ID <= 0) {
        // 067-003（543/546 fault=5 根治）：内置构造器**按语义+实参类型**推导优先
        //   ——避免 解析节点类型ID 的「按被调名查函数返回表」把内层同名构造器
        //   推成外层类型（详见 推导构造器装箱类型 注释）。仅当该推导失败时回退
        //   原路径（语义层已推导表达式类型）。
        装箱类型ID = 推导构造器装箱类型(池, n, 位置);
        如果 (装箱类型ID <= 0) {
            装箱类型ID = 解析节点类型ID(池, 位置);
        }
    }
    如果 (装箱类型ID <= 0) {
        // 430-b（族③ 收口）：克隆体装箱语境兜底——语义层标注发生在实例化前
        //   的基类体（克隆节点子终点=0）；返回位装箱=结果方法常态，取当前
        //   函数返回 结果/可选 类型名ID（生成方法/生成函数 每函数设置）。
        //   已标注节点（语义层可判·局部声明位）不受影响（子终点>0 直通）。
        装箱类型ID = 取当前函数返回结果名ID();
    }
    如果 (装箱类型ID <= 0) {
        IR层诊断("构造器装箱类型语境未知（语义层未标注）: " +
                  驻留文本(整64(池.元素(整32(n.子起点)).文本)));
        返回 0;
    }
    字符串 装箱名 = 字符串复制(驻留文本(装箱类型ID));
    字符串 被调名71 = 字符串复制(驻留文本(整64(池.元素(整32(n.子起点)).文本)));
    // 值字段类型：错误(码) 存 E（第二实参段），正常/某些 存 T（首实参段）——
    //   可选$T 单实参同 T 路径（宿主 handleResultCtor valueType 分派同构）
    字符串 实参段71 = 合成名首实参(装箱名);
    // 067-003 第 8 面（值类型完整载荷·$ 形态双层砍根治）：原 段首(实参段71)
    //   对「可选$可选$盒子」砍成「可选」（基名）→ 宽度/类型码全失。可选 单参
    //   恒载荷全串（正常/某些 存 T）；结果 的 T/E 切分（段余·T 含 $ 歧义）
    //   另案（t4 面）。
    字符串 值类型71 = 实参段71;
    如果 (字符串比较(被调名71, "错误")) {
        值类型71 = 段余(实参段71);
    }
    // 194 修③（114 写侧实锤·067-003 注记「结果 的 T/E 切分另案 t4 面」兑现）：
    //   结果$T$E 形态的 正常/某些 值类型=未切分「符号$整32」→ 类型名宽度 查表
    //   miss → 载荷写入落 8B 直存（正常(s) 只拷 s.名ID 8 字节·24B 载荷 16B 未
    //   拷·asm 对位 [盒+8]=5 实锤）→ 读侧 查.值.类型ID 读到盒外相邻槽。
    //   切分同族：结果 的 正常/某些=段首（T）、错误=段余（E·上行既有）、
    //   可选 单参全串不动（嵌套合成体保整段·067-003 第 8 面同规）。
    // 194 修③ [r26 单变量撤除实验：79_v2 自举红定位——验后恢复]
    如果 (字符串比较(合成名基名(装箱名), "结果")) {
        如果 (!字符串比较(被调名71, "错误")) {
            值类型71 = 段首(实参段71);
        }
    }
    // 194 修⑪（r3 重放·r2 误删的修⑦b 机制恢复+双语境实证补全）：**stdlib 泛型
    //   克隆体**的装箱标注沿基类体语义层（「结果$T$整32」·T 未替换——与主
    //   模块直调语境的「结果$资源$整32」已替换不同·box194 插桩双语境实证）
    //   → 修③ 切分得「T」→ 类型名宽度 miss → 8B 直存半拷（fix_p.asm 获取体
    //   asm 对位：正常(数据[键]) 载荷只写 8B·32B 符号未拷）→ 语义分析经
    //   符号表.获取 拿半截结构体 → 表注册/链式查找 崩（79_v2 自举红·崩链
    //   链式查找+0x2f7←获取+0x83←表注册+0x10c←收集函数声明）。兜底=克隆
    //   体语境（当前方法类名ID=实例合成名·生成类 199）把装箱名按实例实参
    //   词级替换（取实例实参们+查类类型参数+替换类型参数带段们·IR签名/
    //   IR容器 既有设施）——「结果$T$整32」→「结果$符号$整32」→ 修③ 切分
    //   得「符号」→ 值宽 32 → CopyStruct 整块拷（修⑩ 回扫供元素槽源址）。
    如果 (当前方法类名ID != 0) {
        字符串 实例名b = 字符串复制(驻留文本(当前方法类名ID));
        如果 (首分段位置(实例名b) >= 0) {
            整64 序串IDb = 查类类型参数(驻留(合成名基名(实例名b)));
            如果 (序串IDb > 0) {
                向量<字符串> 实参们b = 取实例实参们(实例名b);
                字符串 替换b = 替换类型参数带段们(装箱名,
                                     字符串复制(驻留文本(序串IDb)), 实参们b);
                如果 (!字符串比较(替换b, 装箱名)) {
                    装箱名 = 替换b;
                    装箱类型ID = 驻留(替换b);
                    // 修③ 补跑（装箱名 替换后 重切）：本段在 修③ 之后——
                    //   替换改变了 切分基面，重走 切分与错误 分流。
                    字符串 实参段71r = 合成名首实参(装箱名);
                    值类型71 = 实参段71r;
                    如果 (字符串比较(被调名71, "错误")) {
                        值类型71 = 段余(实参段71r);
                    } 否则 {
                        值类型71 = 段首(实参段71r);
                    }
                }
            }
        }
    }
    // 194 修⑨（79_v2 自举红根治·崩链 RVA 对位 cn_self 类型分析$表查找类型ID）：
    //   修③ 段首切分对「T=容器实例」砍出**裸基名**（结果$映射$整64$符号$整32
    //   →段首「映射」·$ 切分对容器实参 T 含 $ 的歧义=067-003 老账）→ 是容器类
    //   对无 $ 裸名 miss → 落结构体分支 值宽=查结构体大小(映射)=56·载荷须深拷
    //   → CopyStruct 56B（源=句柄值当地址）写穿盒槽 → cn_self 编 stdlib 时写坏
    //   堆 → 语义分析阶段延迟崩（基线未切分「X$Y…」查表 miss 恰好 8B 直存=
    //   自洽）。补全=克隆体语境取**实例首类型实参**（容器数据元素=T 实参·
    //   修⑧b 同款放宽到全部装箱）→ 是容器类 命中完整实例名 → 句柄 8B 直存
    //   原路（001 §5.3 容器按值=句柄拷贝）。
    如果 (字符串比较(合成名基名(装箱名), "结果") &&
         首分段位置(值类型71) < 0 && 是容器基名(值类型71) &&
         当前方法类名ID != 0) {
        字符串 实例名n9 = 字符串复制(驻留文本(当前方法类名ID));
        如果 (首分段位置(实例名n9) >= 0) {
            向量<字符串> 实参们n9 = 取实例实参们(实例名n9);
            如果 (实参们n9.大小() >= 1) {
                值类型71 = 字符串复制(实参们n9.元素(0));
            }
        }
    }
    // 79-a 缺陷根治（既有，基线复现）：联合体偏移 = 较宽成员（T/E）——写入侧
    //   原按当前载荷单侧定偏移（结果<字符串,整32>.错误 写偏移 4），读取侧按
    //   联合体实际偏移（8）=读写不一致（探针 P11 实证：错误码读垃圾）。
    整64 值偏移71 = 结果值偏移(段首(实参段71));   // 联合体偏移基准 = T 的偏移档
    如果 (字符串比较(合成名基名(装箱名), "结果")) {
        整64 错偏移71 = 结果值偏移(段首(段余(实参段71)));   // E 的偏移档
        如果 (错偏移71 > 值偏移71) { 值偏移71 = 错偏移71; }
    }
    // 弹栈：线性求值序=被调兜底负符号先压、实参值后压（转移 特判同款弹法）
    // 067-003 治本（嵌套构造实参时序·Rust 参照=按节点求值不依赖隐式栈序）：
    //   池先序遍历下外层（位置小）先入本函数——弹栈原假设「实参已求值在栈」
    //   对「实参=嵌套构造器调用」不成立（内层尚未遍历）→ 弹到字面量残留
    //   （544 双层 VEH 实证：CopyStruct 源=7）。对嵌套构造实参显式递归先
    //   求值其装箱，产物寄存器即实参值（首版接受内层后续遍历的重复求值，
