                        // IR_指针加载（目标=句柄值·操作数1=元素槽地址寄存器）
                        // ——元素槽**本身就是存句柄的槽**，其地址即拷贝构造
                        // T& 源契约（「存句柄的槽的地址」）——直接取 操作数1
                        // 为源地址（无额外发射·零开销）。
                        整64 回b107 = 指令.大小();
                        当 (回b107 > 0) {
                            IR指令 回扫b107 = 指令.元素(回b107 - 1);
                            如果 (回扫b107.操作码 == IR_指针加载 &&
                                 回扫b107.目标 == 实参值71) {
                                源地址107 = 回扫b107.操作数1;
                                中断;
                            }
                            回b107--;
                        }
                    }
                }
                如果 (源地址107 != 0) {
                    整64 新obj107 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新obj107,
                                         查结构体大小(载荷ID107), 载荷ID107));
                    // this=位0、源=位1（拷贝构造 T& 按引用位传·样板=617-a 调用点）
                    IR追加(指令, 建IR指令(IR_调用实参, 新obj107, 0, 0, 0, 0, 0));
                    IR追加(指令, 建IR指令(IR_调用实参, 源地址107, 0, 0, 0, 1, 0));
                    IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                                         驻留(方法符号(驻留文本(载荷ID107),
                                               剥实例基名(驻留文本(载荷ID107)),
                                               字符串复制(驻留文本(拷贝串107))))));
                    实参值71 = 新obj107;
                    类深拷107 = 真;
                }
                // 源地址未解析（静态源等形态·存量零）：退回句柄直存+登记 move
                //   原路（=71-a 现状行为·零回归）
            }
        } 否则 如果 (是容器类(值类型71)) {
            // 容器载荷=句柄 8B 直存（堆对象指针·与类同款）
            值宽71 = 8;
        } 否则 如果 (是结果类型(值类型71)) {
            值宽71 = 结果大小(值类型71);
            载荷须深拷 = 真;
        } 否则 {
            整64 结体大小71 = 查结构体大小(驻留(值类型71));
            如果 (结体大小71 != 0) {
                值宽71 = 结体大小71;
                载荷须深拷 = 真;
            }
        }
        如果 (载荷须深拷) {
            // 081 同构守卫（2026-09-29·880 轮·宿主 ir_error_ctor 嵌套守卫同轮）：
            //   实参=局部/参数聚合**标识符**时 生成标识符加载 产物=IR_加载 值读
            //   （数组/128 位有地址语义分支、局部合成体/结构体落默认值读）——深拷
            //   源必须是左值地址（结构体读=地址语义·宿主同款），把该 IR_加载 的源
            //   槽补发 IR_取地址（IR生成.cn 回扫实参取地址 B3/B8 同款判定与引用
            //   分流）。误伤面=零：寄存器 SSA 目标唯一，字面量构造（临时基址）/
            //   字段地址/调用返回/取地址形态均 miss 原样直通；三元地址化形态
            //   （86-a 登记 T_对象）不进回扫。
            如果 (查寄存器类型(实参值71) != T_对象) {
                整64 回扫源槽81 = 0;
                整64 回81 = 指令.大小();
                当 (回81 > 0) {
                    IR指令 回扫81 = 指令.元素(回81 - 1);
                    如果 (回扫81.操作码 == IR_加载 && 回扫81.目标 == 实参值71) {
                        回扫源槽81 = 回扫81.操作数1;
                        中断;
                    }
                    回81--;
                }
                如果 (回扫源槽81 != 0) {
                    整64 地址reg81 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    如果 (槽是引用(回扫源槽81)) {
                        IR追加(指令, 建IR指令(IR_加载, 回扫源槽81, 0, 0,
                                             地址reg81, T_整64, 0));
                    } 否则 {
                        IR追加(指令, 建IR指令(IR_取地址, 回扫源槽81, 0, 0,
                                             地址reg81, T_整64, 0));
                    }
                    实参值71 = 地址reg81;
                }
            }
            IR追加(指令, 建IR指令(IR_结构体拷贝, 实参值71, 值地址71, 0, 0,
                                 值宽71, 0));
            // 205：载荷在位深拷+弹出/出队 源槽收回（承载 IR容器判定·详 coverage_map）。
            装箱结构体载荷深拷与弹出槽收回205(指令, 寄存器计数, 值地址71,
                                            实参值71, 值类型71, 池, 整64(位置));
        } 否则 {
            IR追加(指令, 建IR指令(IR_指针存储, 值地址71, 实参值71, 0, 0,
                                 类型码(驻留(值类型71)), 0));
        }
        // move 登记：实参单标识符（末位==首节点紧邻被调）形态——拥有源转交。
        //   107：类深拷路径跳过登记（源保留照常析构·宿主 889 同构——019 第 1 句
        //   未显式 转移() 不自动 move）；字符串/容器载荷维持 71-a move 面（宿主
        //   70-a 源槽清零同效·两侧行为一致非分叉）。
        整64 末位71 = 查调用实参末位(整64(位置), 0);
        如果 (末位71 == 整64(n.子起点) + 1) {
            节点 实参n71 = 池.元素(整32(末位71));
            如果 (实参n71.类型 == 节点_标识符 && !类深拷107) {
                登记已装箱名(整64(实参n71.文本));
            }
        }
    }
    // 894-a（070·G-N 特性波3）：**实参位语境**压「对象前 8 字节」而非基址——
    //   v2 合成体传参 ABI=前 8 字节寄存器传值（标识符实参求值同款·t7 双端
    //   一致实证；被调方按槽区读 [@0 标志/@+4 值]）。原恒压基址 → 调用方把
    //   「临时地址」入 rcx/rdx、被调方当「对象前 8 字节」存槽 → 槽+4=未初始
    //   化栈=非确定垃圾（408 u6/t3/t6 探针族实锤）。判据=紧邻后继为调用根
    //   （末实参根=调用节点-1 池惯例·与语义层 实参位期望类型894 回取同款）；
    //   非实参位（声明/返回/嵌套载荷消费）维持基址——543 系列零回归。
    //   宽度=8（前 8 字节=标志+值低半/指针载荷；>16B 载荷场景合成体整体传
    //   参本 ABI 不承载——同标识符实参边界）。
    整64 装箱压栈值894 = 基址71;
    如果 (整64(位置) + 1 < 整64(池.大小())) {
        节点 后继894 = 池.元素(位置 + 1);
        // 后继=**构造器**调用（正常/错误/某些）=嵌套构造载荷语境——外层以
        //   内层**基址**为深拷源（IR_结构体拷贝·543/546 族）·保持基址；
        //   后继=普通函数/方法调用=真传参语境→前 8 字节。
        布尔 后继是构造器894 = 假;
        如果 (后继894.类型 == 节点_调用 && 后继894.子起点 > 0) {
            节点 后继被调894 = 池.元素(整32(后继894.子起点));
            如果 (后继被调894.类型 == 节点_标识符) {
                字符串 后继被调名894 = 字符串复制(驻留文本(整64(后继被调894.文本)));
                如果 (字符串比较(后继被调名894, "正常") ||
                     字符串比较(后继被调名894, "错误") ||
                     字符串比较(后继被调名894, "某些")) {
                    后继是构造器894 = 真;
                }
            }
        }
        // 真·传参语境=**普通函数直调**（被调=标识符·前 8 字节 ABI）——
        //   成员方法调用（表.追加(正常(31))·被调=节点_成员）实参=**基址**
        //   （容器元素追加深拷源·537 D 段 890 链）·构造器后继=嵌套载荷语境
        //   （深拷源）·两者均不转。
        布尔 普通直调实参位894 = 假;
        如果 (后继894.类型 == 节点_调用 && 后继894.子起点 > 0 &&
             后继894.附加 >= 1 && !后继是构造器894) {
            节点 后继被调普通894 = 池.元素(整32(后继894.子起点));
            如果 (后继被调普通894.类型 == 节点_标识符) {
                普通直调实参位894 = 真;
            }
        }
        如果 (普通直调实参位894) {
            // 1011（408/551·合成体传参 ABI 宽度分档）：前 8 字节值传仅适用
            //   **总宽 ≤8** 的合成体（可选<整32>=8·t7 双端一致）；总宽 >8
            //   （结果<整32,整32>=16）=基址传引用（被调方 prologue rep movsb
            //   按源地址拷全宽——MS x64 非 1/2/4/8 结构体传引用 ABI 同构）。
            //   原恒前 8 字节：16 字节合成体 rdx=打包值、被调 rep movsb 解引用
            //   [打包值] → C0000005（fault=0x2900000001=正常(41) 打包·408/551
            //   同 RVA=10c3 实锤）。
            整64 装箱总宽1011 = 结果大小(装箱名);
            如果 (装箱总宽1011 <= 8) {
                整64 实参值894 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_指针加载, 基址71, 0, 0, 实参值894, T_整64, 0));
                装箱压栈值894 = 实参值894;
            }
            // >8：装箱压栈值894 维持 基址71（传引用——被调 prologue 拷贝对齐）
        }
    }
    结果<空类型, 整32> 加箱71 = 表达式栈.追加(装箱压栈值894);
    如果 (!加箱71.正常) { 运行时错误(4); }
    // 067-003（嵌套去重·dbgZ 实证）：装箱完成**登记自身位置**——原仅预求值处
    //   登记「实参位置」→ 节点自身先被遍历装箱（池序 内层在前）时不登记 →
    //   外层预求值递归再装箱一次 → 产物双份/栈错位（t1=1 读标志位实证）。
    //   登记后递归命中即返回 1（复用栈上已有产物）。
    结果<空类型, 整32> 登自71 = 已装箱节点们.设置(整64(位置), 1);
    如果 (!登自71.正常) { 运行时错误(4); }
    返回 1;
}

