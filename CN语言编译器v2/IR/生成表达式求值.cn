    如果 (实参值71 != 0) {
        整64 值地址71 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_字段地址, 基址71, 0, 0, 值地址71, T_整64,
