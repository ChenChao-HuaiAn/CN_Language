// CN 自举编译器 v2 · IR 生成表达式求值子形态（R3 千行拆分，2026-09-08）
// 职责：自 生成表达式.cn 提取的调用族+下标族六函数——类型大小折叠/方法调用/
//   打印族与内置/类型转换与构造/普通函数调用发射/下标访问。单向依赖：本模块
//   不调 生成表达式（递归调者 留原文件如 生成短路求值/生成下标左值地址），
//   故无循环导入。模块路径=原组件名逐字节不变（键基/mangling 零变化）。
导入 容器::向量;
导入 语法;       // Token/AST 节点池（目录包名）
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码 + IR常量 键位移（目录包名）
导入 IR生成;     // 函数级变量类型权威表/重载决议/控制流辅助（同包幂等）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 调用生成（R3 提取，2026-09-08）：类型大小折叠/弹参/方法与函数分派主体。
//   返回 消费 token 数（恒 1）；0=整个表达式求值须返回 0（类型大小未知/决议失败）。
不安全 函数 生成调用(向量<节点> 池, 节点 n, 整32 位置, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
              向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数,
              向量<整64>& 表达式栈, 整64 retbuf序号) -> 整32 {
        // ---- 71-a（2026-09-11 方案A 用户裁决）：内置构造器 正常()/错误()/某些()
        //      装箱特判（语义层已推导类型写入 n.子终点）——先于转移/普通调用。
        //      被调标识符兜底负符号与实参值由 生成装箱构造 统一弹收。
        如果 (n.子起点 > 0 && n.附加 <= 1) {
            节点 被调71 = 池.元素(整32(n.子起点));
            如果 (被调71.类型 == 节点_标识符) {
                字符串 被调名71 = 字符串复制(驻留文本(整64(被调71.文本)));
                如果 (字符串比较(被调名71, "正常") || 字符串比较(被调名71, "错误") ||
                     字符串比较(被调名71, "某些")) {
                    返回 生成装箱构造(池, n, 位置, 指令, 寄存器计数, 槽计数, 表达式栈);
                }
            }
        }
        // ---- plans/019 阶段1（2026-09-10）：显式转移 转移(变量) 展开——
        //      语义层已放行（指针/字符串值交接）。栈顶=实参寄存器值（标识符
        //      求值产物），其下=被调「转移」函数名兜底负符号：弹掉被调残留、
        //      实参值留在栈顶=转移调用的求值结果（零运行时指令，纯编译期）。
        //      位置紧邻 类型大小 折叠（单标识符实参内置调用同族形态）。
    // 212-a（2026-09-15 第两百一十二轮，D1 行数整改）：转移展开/类型大小折叠两特判
    //   迁独立族（-1=未处理哨兵，主函数继续原链——终结性装箱特判留主函数）。
    如果 (生成转移展开(池, n, 表达式栈)) { 返回 1; }
    // 206-c：复制(表达式) 泛型克隆内置展开（字符串=符号改写返回假，主链内置
    //   路径完成；标量/容器/结构体=终结发射返回真）
    如果 (生成复制展开(池, n, 位置, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈)) { 返回 1; }
    整32 折叠r = 0;
    如果 (生成类型大小折叠(池, n, 指令, 寄存器计数, 表达式栈, 折叠r)) { 返回 折叠r; }
    // 函数/方法调用（2026-09-01 用户裁决项3 参数区改造）：弹实参（倒序）入
    //   弹出们，逐个发射 IR_调用实参(64)（位号声明性标注），IR_调用参数化(63)
    //   收尾——任意实参数（7 组件源码 8 参函数）；普通调用与方法调用统一路径。
        // 函数/方法调用（2026-09-01 用户裁决项3 参数区改造）：弹实参（倒序）入
        //   弹出们，逐个发射 IR_调用实参(64)（位号声明性标注），IR_调用参数化(63)
        //   收尾——任意实参数（7 组件源码 8 参函数）；普通调用与方法调用统一路径。
        整64 实参数 = n.附加;
        向量<整64> 弹出们 = 向量<整64>();
        整64 弹i = 0;
        当 (弹i < 实参数 && 表达式栈.大小() > 0) {
            结果<空类型, 整32> 加弹 = 弹出们.追加(表达式栈.元素(表达式栈.大小() - 1));
            如果 (!加弹.正常) { 运行时错误(4); }
            结果<空类型, 整32> 删弹 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删弹.正常) { 运行时错误(4); }
            弹i++;
        }
        整64 被调 = 0;
        如果 (表达式栈.大小() > 0) {
            被调 = 表达式栈.元素(表达式栈.大小() - 1);
            结果<空类型, 整32> 删被调 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删被调.正常) { 运行时错误(4); }
        }
        // ---- 方法调用：被调是方法标记（-(10^6+方法名ID)），标记下压着 this ----
    // ---- 方法调用：被调是方法标记（-(10^6+方法名ID)），标记下压着 this ----
    如果 (被调 <= -1000000) {
        生成方法调用(池, n, 位置, 被调, 弹出们, n.附加, 局部槽, 参数槽, 指令, 寄存器计数,
                    槽计数, 表达式栈, retbuf序号);
        // 81-a-v2：实参位置返回物化槽的串字段释放（调用发射后；含「外层调用返回值
        //   覆盖 retbuf」场景的独立副本所有权收口）
        清理调用实参临时(弹出们, 指令, 寄存器计数);
        返回 1;
    }
        如果 (被调 >= 0) {
            // 非函数名/方法标记（弹到寄存器值）——非法调用形态
            IR层诊断("调用被调对象非函数名/方法");
            运行时错误(6);
        }
        整64 函数符号 = 0 - 被调;
    // 打印族/内置函数（R3 提取）：命中即处理返回 1
    如果 (生成打印与内置调用(池, 函数符号, 弹出们, n.附加, 指令, 寄存器计数, 表达式栈) == 1) {
        返回 1;
    }
    // ---- 呈报③方案A：用户函数重载决议（2026-09-06）——决议歧义/失败
    //      已在决议内 IR层诊断（fail fast），0=中止
    函数符号 = 决议函数符号(池, 函数符号, 整32(位置));
    如果 (函数符号 == 0) { 返回 0; }
    // 类型转换/构造调用（R3 提取）：命中即处理返回 1
    如果 (生成转换或构造调用(函数符号, 弹出们, n.附加, 指令, 寄存器计数, 表达式栈) == 1) {
        返回 1;
    }
    // 普通函数调用（R3 提取）
    发射普通函数调用(弹出们, 函数符号, n.附加, 指令, 寄存器计数, 槽计数,
                     表达式栈, retbuf序号);
    // 81-a-v2：实参位置返回物化槽的串字段释放（调用发射后）
    清理调用实参临时(弹出们, 指令, 寄存器计数);
    返回 1;
}


// 212-a：族① 显式转移 转移(变量) 展开（plans/019 阶段1）——弹 2 个压栈残留
//   （实参值+被调负符号）、实参值压回=转移调用求值结果（纯编译期零指令）。
//   返回 1=已处理；-1=非转移形态（主函数继续原链）。
不安全 函数 生成转移展开(向量<节点> 池, 节点 n, 向量<整64>& 表达式栈) -> 布尔 {
        如果 (n.子起点 > 0 && n.附加 == 1) {
            节点 转被调 = 池.元素(整32(n.子起点));
            节点 转实参节点 = 池.元素(整32(n.子起点) + 1);
            如果 (转被调.类型 == 节点_标识符 && 转实参节点.类型 == 节点_标识符 &&
                 字符串比较(驻留文本(整64(转被调.文本)), "转移")) {
                // 弹 2 个压栈残留（实参值+被调负符号，类型大小折叠同款），
                // 实参值压回栈=转移调用求值结果（线性求值序：被调先压、
                // 实参后压——栈顶=实参值、其下=被调符号）
                如果 (表达式栈.大小() >= 2) {
                    整64 转实参值 = 表达式栈.元素(表达式栈.大小() - 1);
                    整64 删转i = 0;
                    当 (删转i < 2) {
                        结果<空类型, 整32> 删转 = 表达式栈.删除(表达式栈.大小() - 1);
                        如果 (!删转.正常) { 运行时错误(4); }
                        删转i++;
                    }
                    结果<空类型, 整32> 加转 = 表达式栈.追加(转实参值);
                    如果 (!加转.正常) { 运行时错误(4); }
                }
                返回 真;
            }
        }


    返回 假;
}

// 206-c（波 4·plans/020 第七十二节 §二）：族③ 复制(表达式) 泛型克隆内置展开
//   （n.子终点=语义层 检查复制调用 写入的实参类型 ID；与 转移(x) 显式
//   「复制/移动」双内置，Rust Clone::clone 同构）。按类型分派（栈顶=实参值、
//   其下=被调负符号——与 转移展开 同线性求值序）：
//     ①标量/指针（可平凡复制）=直通（弹被调残留，实参值留栈顶=求值结果，
//       零运行时指令——转移展开同款）；
//     ②字符串=被调符号改写为「字符串复制」（主链弹参+内置路径照常发射
//       __cn_str_copy 落堆独立拥有；返回 假=本次不终结）；
//     ③容器/类=栈顶对象指针入 hold 槽 → NewObject + 拷贝构造(2 实参，源=T&
//       左值地址——宿主 genCopyBuiltin 调用返回形态同款 hold 槽取地址) → 新
//       对象指针压栈（调用方按调用返回接管，独立拥有，零共享）；
//     ④结构体（含结果/可选合成）=栈顶源地址 → 新槽（按结构体大小逐槽分配）→
//       整体拷贝 + 串字段深拷（递归，全局资源字段表设施）→ 槽地址压栈。
//   返回 真=已处理（终结）；假=非复制形态或字符串改写（主链继续）。
// 532-a（D1 行数滚动·纯机械拆分零行为变更·2026-09-21）：生成复制展开 175 行 →
//   主函数（前置可信判定+四路分派）+四路子函数——逻辑逐字迁移注释逐字保留
//   （行号切片+边界断言）；等价红线=新旧 v2p 编译同一改前输入 asm md5 逐字节一致。
//   四路类型互斥（字符串/可平凡标量/容器类/结构体）·② 命中返回 假=主链继续·①③④ 终结。
不安全 函数 生成复制展开字符串改写(向量<整64>& 表达式栈) -> 布尔 {
    结果<空类型, 整32> 改写 = 表达式栈.设置(表达式栈.大小() - 2,
                                             0 - 驻留("字符串复制"));
    如果 (!改写.正常) { 运行时错误(4); }
    返回 假;
}
不安全 函数 生成复制展开标量直通(向量<整64>& 表达式栈) -> 布尔 {
    整64 复值 = 表达式栈.元素(表达式栈.大小() - 1);
    整64 删i = 0;
    当 (删i < 2) {
        结果<空类型, 整32> 删 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删.正常) { 运行时错误(4); }
        删i++;
    }
    结果<空类型, 整32> 加v = 表达式栈.追加(复值);
    如果 (!加v.正常) { 运行时错误(4); }
    返回 真;
}
不安全 函数 生成复制展开容器类(向量<IR指令>& 指令, 整64* 寄存器计数,
                              整64* 槽计数, 向量<整64>& 表达式栈, 字符串 复类型文本) -> 布尔 {
    整64 复obj = 表达式栈.元素(表达式栈.大小() - 1);
    整64 删c = 0;
    当 (删c < 2) {
        结果<空类型, 整32> 删c2 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删c2.正常) { 运行时错误(4); }
        删c++;
    }
    整64 hold槽 = 槽计数[0];
    槽计数[0] = 槽计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, hold槽));
    IR追加(指令, 建IR指令(IR_存储, 复obj, 0, 0, 0, 0, hold槽));
    整64 hold地址 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_取地址, hold槽, 0, 0, hold地址, T_整64, 0));
    整64 新对象 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新对象,
                         容器对象大小(复类型文本), 驻留(复类型文本)));
    IR追加(指令, 建IR指令(IR_调用实参, 新对象, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用实参, hold地址, 0, 0, 0, 1, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                         驻留(方法符号(复类型文本, 合成名基名(复类型文本),
                                复类型文本 + "&"))));
    // 762-a（001 波·值差单环修复）：③ 产物（新对象句柄）补登记 结构体返回
    //   临时们（对齐 ④ 结构体物化的 462-a 登记单一归属）——下标左值写通道
    //   （348-a/761 续回退）按登记尺寸整体写 32B（值 数组[值索引] = 复制(...)
    //   的元素槽=完整符号值；未登记则 8B 句柄直写·值[0].类型 ID=0 实锤）。
    结果<空类型, 整32> 设临762 = 结构体返回临时们.设置(新对象,
                                                     驻留(复类型文本));
    如果 (!设临762.正常) { 运行时错误(4); }
    IO::打印到错误("[d762]③登记 键(16)=" + 整数转字符串(新对象) + "\n");
    结果<空类型, 整32> 加o = 表达式栈.追加(新对象);
    如果 (!加o.正常) { 运行时错误(4); }
    返回 真;
}
不安全 函数 生成复制展开结构体物化(向量<节点> 池, 节点 n, 整32 位置,
                              映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                              向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数,
                              整64* 槽计数, 向量<整64>& 表达式栈, 字符串 复类型文本) -> 布尔 {
    整64 删s = 0;
    当 (删s < 2) {
    结果<空类型, 整32> 删s2 = 表达式栈.删除(表达式栈.大小() - 1);
    如果 (!删s2.正常) { 运行时错误(4); }
    删s++;
    }
    整64 复结构ID = 查结构体类型(驻留(复类型文本));
    如果 (复结构ID == 0) {
    // 466-a（T70 面⑥·双表不对称根治）：查结构体类型（语法层表·无候选
    //   回退）miss 时用 结构体布局键基（IR 层三级：本模块键基＞直查＞
    //   候选唯一公开）——与 可信判定 查结构体大小 同源（跨模块私有外
    //   泄面=公开强制，语义层已设防）；键基 ID 即布局/字段分桶键。
    复结构ID = 结构体布局键基(驻留(复类型文本));
    }
    如果 (复结构ID == 0) {
    // 未知结构体（合成类型未登记等）——退回常量 0 占位（防御：不产坏 IR）
    结果<空类型, 整32> 加s = 表达式栈.追加(0);
    如果 (!加s.正常) { 运行时错误(4); }
    返回 真;
    }
    整64 复源地址 = 生成左值地址(池, 整32(n.子起点) + 1, 位置, 局部槽, 参数槽,
                            指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    整64 复结构大小 = 查结构体大小(复结构ID);
    整64 复槽数 = (复结构大小 + 7) / 8;
    如果 (复槽数 <= 0) { 复槽数 = 1; }
    整64 复槽起 = 槽计数[0];
    槽计数[0] = 槽计数[0] + 复槽数;
    整64 复z = 0;
    当 (复z < 复槽数) {
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 复槽起 + 复z));
    复z++;
    }
    整64 复新基址 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_取地址, 复槽起 + 复槽数 - 1, 0, 0, 复新基址, T_整64, 0));
    发射复制结构体深拷(指令, 寄存器计数, 复新基址, 复源地址, 复结构ID, 0);
    // 462-a（T70 面②根治）：④ 分支物化基址补登记 结构体返回临时们——与 生成调用
    //   返回结构体物化登记（1152·82-a/85-a 链）同款单一归属；漏登记后果=348-a
    //   D11 整体写通道（下标/成员/赋值位）查源 miss→「右值（调用返回）非结构体
    //   返回值」误诊断（撤守卫态容器克隆体 `数据[i] = 复制(...)` 实证）。
    结果<空类型, 整32> 设临r = 结构体返回临时们.设置(复新基址, 复结构ID);
    如果 (!设临r.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加s2 = 表达式栈.追加(复新基址);
    如果 (!加s2.正常) { 运行时错误(4); }
    返回 真;
}

不安全 函数 生成复制展开(向量<节点> 池, 节点 n, 整32 位置, 映射<整64, 整64>& 局部槽,
                 映射<整64, 整64>& 参数槽, 向量<IR指令>& 指令, 整64* 寄存器计数,
                 整64* 块计数, 整64* 槽计数,
                 向量<整64>& 表达式栈) -> 布尔 {
    如果 (!(n.子起点 > 0 && n.附加 == 1)) { 返回 假; }
    节点 复被调 = 池.元素(整32(n.子起点));
    如果 (复被调.类型 != 节点_标识符) { 返回 假; }
    如果 (!字符串比较(驻留文本(整64(复被调.文本)), "复制")) { 返回 假; }    如果 (表达式栈.大小() < 2) { 返回 假; }
    // 432-b：子终点=0（语义回填失败置零）不再 early-return——落入下方实参推导兜底
    字符串 复类型文本 = "";
    如果 (n.子终点 > 0) {
        复类型文本 = 字符串复制(驻留文本(整64(n.子终点)));
    }
    // 432-b 根治：子终点 语义标注**仅在成功时回填类型文本 ID**；未成功（基类
    //   泛型实参 K/V/T 不可解析）保持 调用节点原值=参数段末**池索引**——读出
    //   驻留文本=无关垃圾。判据改为「类型可信」：文本须命中任一分派族
    //   （标量/字符串/容器/结构体），否则一律走实参推导兜底。
    布尔 复类型可信d = 假;
    如果 (字符串长度(复类型文本) > 0) {
        复类型可信d = 可平凡复制v2(复类型文本) || 字符串比较(复类型文本, "字符串") ||
                    是容器类(复类型文本) ||
                    查结构体大小(整64(驻留(复类型文本))) != 0;
    }
    // 466-a（T70 面⑥·窄域剥层·前移至可信判定前）：标注/推导文本引用尾 '&'
    //   （方法形参类型标注形态）——不剥则 可信判定 查结构体大小 对 "货舱依赖&"
    //   形态 miss→误走推导；④ 查结构体类型 同 miss→防御 0 无物化登记→
    //   348-a 查源=0 误诊（fix_p 货舱依赖/符号 克隆体实证）。仅本函数局部。
    {
        整64 复长466 = 字符串长度(复类型文本);
        当 (复长466 > 1 && 字符串比较(字符串子串(复类型文本, 整32(复长466 - 1), 1), "&")) {
            复类型文本 = 字符串子串(复类型文本, 0, 整32(复长466 - 1));
            复长466--;
        }
    }
    如果 (!复类型可信d) {
        复类型文本 = "";
        // 432-b（撤守卫·克隆体）：语义标注发生在实例化前的基类体（泛型实参
        //   K/V 不可解析→子终点=0 未标注）——实参表达式类型推导兜底：
        //   下标实参（其他.键数组[i]）先推导成员链父类型再剥指针层；其余直推。
        节点 复实参 = 池.元素(整32(n.子起点) + 1);
        整64 复类型推导 = 0;
        如果 (复实参.类型 == 节点_下标 && 复实参.子起点 > 0) {
            // 462-a（T70 面②深化）：下标实参元素类型统一走 97-a 推导下标元素
            //   类型ID（数组/指针变量/成员链指针对象三形态+432-b 剥 * 兜底）——
            //   原对整段做成员链推导漏下标剥层（容器克隆体 `复制(其他.数据[i])`
            //   实证：推导得容器类型 向量$外盒 ≠ 元素 外盒→③ 容器分支错入）。
            复类型推导 = 推导下标元素类型ID(池, 整32(复实参.子起点));
            字符串 父文本d = 字符串复制(驻留文本(复类型推导));
            整64 父长d = 字符串长度(父文本d);
            如果 (父长d > 0 && 字符串比较(字符串子串(父文本d, 整32(父长d - 1), 1), "*")) {
                复类型推导 = 整64(驻留(字符串子串(父文本d, 0, 整32(父长d - 1))));
            }
        } 否则 {
            // 462-a（T70 面②深化②）：实参=顺序链（根+后缀连续节点）——类型推导
            //   须传**链尾**（递归出口=全链类型）；原传段根（n.子起点+1）只推得
            //   根类型（克隆体 `复制(其他.数据[i])` 实证：根=形参 向量$外盒 ≠
            //   元素 外盒→③ 容器分支错入）。防御：子终点 双语义（未标注=段末
            //   池索引；已标注=类型文本 ID）——段末须在 (子起点, 池大小) 域内，
            //   越域回退链根（保守=原行为零回归）。
            // 466-a（T70 面⑥·锚修正）：链尾=位置-1（调用节点池索引恒可靠）
            //   ——原 n.子终点-1 在语义标注态=类型文本 ID-1（池内无关位置·
            //   推导出容器根类型实证）；实参链=[子起点+1, 位置) 恒成立。
            整64 段末d = 位置 - 1;
            如果 (段末d > n.子起点 && 段末d < 整64(池.大小())) {
                复类型推导 = 推导成员链类型ID(池, 整32(段末d));
            } 否则 {
                复类型推导 = 推导成员链类型ID(池, 整32(n.子起点) + 1);
            }
        }
        如果 (复类型推导 > 0) {
            复类型文本 = 字符串复制(驻留文本(复类型推导));
        }
    }
    如果 (字符串长度(复类型文本) == 0) {        返回 假;
    }
    // ② 字符串：被调符号改写为 字符串复制（主链弹参+内置路径完成 __cn_str_copy）
    // ② 字符串：被调符号改写为 字符串复制（主链弹参+内置路径完成 __cn_str_copy）
    如果 (字符串比较(复类型文本, "字符串")) { 返回 生成复制展开字符串改写(表达式栈); }
    // ① 标量/指针：直通（值语义天然，零运行时指令）
    // 496-a（T70 B1·可平凡结构体不走直通）：① 直通的 复值=下标读值（非元素
    //   地址）——结构体形态（查结构体大小≠0）登记值当地址=整体拷贝读垃圾
    //   （124 首版产物 rc=102 实证）→结构体排除出直通、落 ④ 物化+登记（与
    //   Token 同路径·复制语义完整·基类型直通零影响）。
    如果 (可平凡复制v2(复类型文本) && 查结构体大小(驻留(复类型文本)) == 0) { 返回 生成复制展开标量直通(表达式栈); }
    // ③ 容器/类：栈顶对象指针 → hold 槽取地址 → NewObject + 拷贝构造
    如果 (是容器类(复类型文本)) { 返回 生成复制展开容器类(指令, 寄存器计数, 槽计数, 表达式栈, 复类型文本); }
    // ④ 结构体（含结果/可选合成）：实参左值地址 → 新槽 → 整体拷贝+串字段深拷。
    //   ★实参地址重新求值（v2 表达式位结构体标识符求值压首槽值=既有第一版
    //   边界；左值地址设施 生成左值地址 按实参区间 [子起点+1, 调用位置) 发射
    //   ——stdlib 拷贝构造切换全需求=place 形态标识符/成员/下标）。
    返回 生成复制展开结构体物化(池, n, 位置, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈, 复类型文本);
}

// 206-c：结构体深拷发射（复制 分派④/字段递归共用）——整体拷贝(memcpy) +
//   资源字段逐个深拷：字符串字段=__cn_str_copy 落堆独立（源保持拥有）；
//   嵌套含资源字段结构体（值语义内联）=递归；容器字段=NewObject+拷贝构造
//   （独立对象）；纯标量字段=memcpy 已覆盖。深度上限 4 防环（与 IR容器释放
//   资源字段设施同款）。全局资源字段表设施（取资源字段们）——不依赖函数IR。
不安全 函数 发射复制结构体深拷(向量<IR指令>& 指令, 整64* 寄存器计数,
                     整64 目标基址, 整64 源基址, 整64 结构体ID, 整64 深度) -> 空类型 {
    如果 (深度 > 4) { 返回; }
    IR追加(指令, 建IR指令(IR_结构体拷贝, 源基址, 目标基址, 0, 0,
                         查结构体大小(结构体ID), 0));
    向量<整64> 字段们 = 向量<整64>();
    取资源字段们(结构体ID, 字段们);
    整64 f = 字段们.大小();
    当 (f > 0) {
        f -= 3;
        整64 字段类型ID = 字段们.元素(f + 1);
        整64 偏移 = 字段们.元素(f + 2);
        字符串 字段类型文本 = 字符串复制(驻留文本(字段类型ID));
        如果 (字符串比较(字段类型文本, "字符串")) {
            整64 源地址c = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_字段地址, 源基址, 0, 0, 源地址c, T_整64, 偏移));
            整64 源串 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 源地址c, 0, 0, 源串, T_字符串, 0));
            整64 新串 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_调用实参, 源串, 0, 0, 0, 0, 0));
            IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 新串, 0,
                                 驻留("__cn_str_copy")));
            整64 目标地址c = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_字段地址, 目标基址, 0, 0, 目标地址c, T_整64, 偏移));
            IR追加(指令, 建IR指令(IR_指针存储, 目标地址c, 新串, 0, 0, T_整64, 0));
        } 否则 如果 (资源字段数(字段类型ID) > 0) {
            整64 源地址n = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_字段地址, 源基址, 0, 0, 源地址n, T_整64, 偏移));
            整64 目标地址n = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_字段地址, 目标基址, 0, 0, 目标地址n, T_整64, 偏移));
            发射复制结构体深拷(指令, 寄存器计数, 目标地址n, 源地址n,
                            字段类型ID, 深度 + 1);
        } 否则 如果 (是容器类(字段类型文本)) {
            整64 源地址k = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_字段地址, 源基址, 0, 0, 源地址k, T_整64, 偏移));
            整64 源obj = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 源地址k, 0, 0, 源obj, T_对象, 0));
            整64 新对象k = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新对象k,
                                 容器对象大小(字段类型文本), 字段类型ID));
            IR追加(指令, 建IR指令(IR_调用实参, 新对象k, 0, 0, 0, 0, 0));
            IR追加(指令, 建IR指令(IR_调用实参, 源地址k, 0, 0, 0, 1, 0));
            IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                                 驻留(方法符号(字段类型文本, 合成名基名(字段类型文本),
                                        字段类型文本 + "&"))));
            整64 目标地址k = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_字段地址, 目标基址, 0, 0, 目标地址k, T_整64, 偏移));
            IR追加(指令, 建IR指令(IR_指针存储, 目标地址k, 新对象k, 0, 0, T_整64, 0));
        }
    }
}

// 212-a：族② 类型大小(类型名) 编译期折叠（规格 02-六B，宿主 A-3 SizeofExpr 同义）——
//   弹 2 个压栈残留（根治栈底残留）+常量压栈。返回 1=已处理；0=未知类型中止；
//   -1=非折叠形态（主函数继续原链）。
不安全 函数 生成类型大小折叠(向量<节点> 池, 节点 n, 向量<IR指令>& 指令, 整64* 寄存器计数,
                     向量<整64>& 表达式栈, 整32& 结果r) -> 布尔 {
        如果 (n.子起点 > 0 && n.附加 == 1) {
            节点 折叠被调 = 池.元素(整32(n.子起点));
            节点 折叠实参 = 池.元素(整32(n.子起点) + 1);
            如果 (折叠被调.类型 == 节点_标识符 && 折叠实参.类型 == 节点_标识符 &&
                 字符串比较(驻留文本(整64(折叠被调.文本)), "类型大小")) {
                整64 宽度 = 类型名宽度(整64(折叠实参.文本));
                IO::打印到错误("[650w] 类型=" + 驻留文本(整64(折叠实参.文本)) + " 宽度=" + 整数转字符串(宽度) + "\n");
                如果 (宽度 == 0) {                    IR层诊断("类型大小: 未知类型 " +
                                  驻留文本(整64(折叠实参.文本)) +
                                  " 节点类型=" + 整数转字符串(整64(折叠实参.类型)) +
                                  " [宿主=" + 驻留文本(取当前生成符号ID()) + "]");
                    结果r = 0;   // IR 层错误即中止纪律：诊断计数后继续收集，主.cn 统一中止
                返回 真;
                }
                整64 折叠i = 0;
                // 弹 2 个压栈残留：实参（类型名负符号）+ 被调（类型大小 负符号）
                //   ——根治栈底残留（原只弹 1 个，靠相对栈顶侥幸无害）
                当 (折叠i < 2 && 表达式栈.大小() > 0) {
                    结果<空类型, 整32> 删折 = 表达式栈.删除(表达式栈.大小() - 1);
                    如果 (!删折.正常) { 运行时错误(4); }
                    折叠i++;
                }
                整64 常量寄存器 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                // IR_常量整数 操作数1=值文本驻留ID（P7a 语义：代码生成经
                //   驻留文本 还原立即数）——宽度须先转文本再驻留
                IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(宽度)), 0, 0,
                                     常量寄存器, T_整64, 0));
                结果<空类型, 整32> 加折 = 表达式栈.追加(常量寄存器);
                如果 (!加折.正常) { 运行时错误(4); }
                结果r = 1;
                返回 真;
            }
        }



    返回 假;
}

// 方法调用发射（被调=方法标记，标记下压着 this）：容器类签名命中→retbuf/标量
//   分派+结构体按值实参回扫取地址（B3/B8）+类型登记；未收录/对象未知=诊断终止。
不安全 函数 生成方法调用(向量<节点> 池, 节点 n, 整32 位置, 整64 被调, 向量<整64>& 弹出们,
                 整64 实参数, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                 向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数,
                 向量<整64>& 表达式栈,
                 整64 retbuf序号) -> 空类型 {
            整64 方法名ID = 0 - 被调 - 1000000;
            整64 this寄存器 = 0;
            如果 (表达式栈.大小() >= 1) {
                this寄存器 = 表达式栈.元素(表达式栈.大小() - 1);
                结果<空类型, 整32> 删this = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删this.正常) { 运行时错误(4); }
            }
            字符串 方法名文本 = 字符串复制(驻留文本(方法名ID));
            字符串 类名 = "";
            // ②c A/B：对象类型统一解析（标识符：容器变量/结构体容器字段；
            //   调用：返回容器/返回结构体的容器字段——元素(0).设置/b.表.追加）
            整64 对象类ID2 = 解析方法对象类型扩展(池, 位置);
            如果 (对象类ID2 != 0) {
                类名 = 字符串复制(驻留文本(对象类ID2));
            }
            如果 (是容器类(类名)) {
                方法签名 签;
                如果 (查方法签名(类名, 方法名文本, 实参数, &签)) {
                    // ②b B6：retbuf 按真实返回字节数定帧——累计本函数最大值
                    整64 retbuf字节 = 签名返回字节数(&签);
                    累计retbuf字节数(retbuf字节);
                    整64 符号ID = 驻留(方法符号(类名, 方法名文本, 签.参数串));
                    整64 retbuf = 0;
                    整64 目标寄存器 = 0;
                    整64 实参起始位 = 1;
                    如果 (签.返回形态 == 容器返回_结果空 || 签.返回形态 == 容器返回_结果值 ||
                         签.返回形态 == 容器返回_结构体) {
                        retbuf = retbuf序号;
                        实参起始位 = 2;   // 位0=retbuf、位1=this、实参从位2
                        目标寄存器 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                    } 否则 如果 (签.返回形态 == 容器返回_标量) {
                        目标寄存器 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                    }
                    // 74-a（2026-09-11 第七十四轮）：入容器位所有权归一化——
                    //   容器析构会释放元素串（容器拥有元素所有权），故入容器必须
                    //   由编译器接管所有权（宿主 buildCallArgsForMethod 同款）。
                    //   **时序**：须在 this 的 IR_调用实参 之前发射——代码生成的调用
                    //   展开是「收集 IR_调用实参，遇 IR_调用参数化 统一展开」，若
                    //   在 this/实参声明之后插入独立调用，其 IR_调用参数化 会把
                    //   已收集实参一并展开（位数错乱）。
                    // 81-a（2026-09-12 第八十一轮）：79-a 的
                    //   标记入容器结构体污染 整链删除——元素槽字段串由 stdlib
                    //   容器方法体的 `数据[n] = 值` 结构体写入深拷独立拥有，源结构体
                    //   照常拥有并释放（该标记原使源字段串跳过释放=每元素泄漏 2，
                    //   实测 P2/P3 实证；容器消亡/移除路径的释放面由宿主编译 stdlib
                    //   时注入的 ~容器/清空/删除 方法体承担）。
                    归一化入容器实参(池, n, 位置, 类名, 方法名文本, 弹出们,
                                     局部槽, 参数槽, 指令, 寄存器计数);
                    IR追加(指令, 建IR指令(IR_调用实参, this寄存器, 0, 0, 0, 实参起始位 - 1, 0));
                    // ②b B3（2026-09-02）：结构体按值实参 -> 传地址（宿主 ABI：
                    //   调用方传指针、被调方拷贝入参/元素存储）。裸标识符实参的
                    //   值装载（IR_加载）回扫取槽改发 IR_取地址（B8 抽出共用辅助）。
                    整64 实i = 0;
                    当 (实i < 弹出们.大小()) {
                        字符串 段文本 = 取参数段(签.参数串, 实i);
                        // 595-a 立案（001-001 残余·容器方法第三回扫源）：此处
                        //   按 签.参数串 段 查结构体大小 判取地址——撤守卫态容器
                        //   实参段命中 → 取地址传栈槽、被调方 fix5 单槽当句柄 →
                        //   元素槽伪对象。直改（!是容器类 排除）触发 v2p 自身
                        //   编译期运行时错误 1024（机制待独立定性）——本点撤守卫
                        //   态容器方法容器实参面=下轮主攻面。
                        如果 (!是容器类(段文本) && 查结构体大小(驻留(段文本)) != 0) {
                            回扫实参取地址(指令, 弹出们, 实i, 寄存器计数);
                        } 否则 如果 (字符串长度(段文本) > 0 && 字符串比较(
                                     字符串子串(段文本, 整32(字符串长度(段文本) - 1), 1), "&")) {
                            // 432-b 根治：& 引用实参 → 传左值地址（原缺=引用形参
                            //   传值→被调方把值当地址解引用写崩；123 链查找 前驱
                            //   实测 SIGSEGV r10=-1=前驱初值）
                            回扫实参取地址(指令, 弹出们, 实i, 寄存器计数);
                        }
                        实i++;
                    }
                    发射调用实参们(弹出们, 实参起始位, 指令,
                                  容器实参类型码们(签.参数串, 弹出们));
                    // 91-a：返回类型码（容器返回_标量 按替换后返回类型解析——
                    //   浮点元素返回走 xmm0；retbuf 形态=地址标 0 整型类）
                    整64 容器返回码 = 0;
                    如果 (签.返回形态 == 容器返回_标量) {
                        容器返回码 = 类型码(驻留(签.返回文本));
                    }
                    IR追加(指令, 建IR指令(IR_调用参数化, 实参起始位 + 实参数, 容器返回码, 0,
                                         目标寄存器, retbuf, 符号ID));
                    如果 (目标寄存器 != 0) {
                        // ③ 第二波（方案A）：容器方法标量返回类型登记——签.返回文本
                        //   =替换后返回类型（向量<字符串>.元素(i) -> "字符串"）；
                        //   结果/结构体返回=retbuf 地址不做标量登记（.值/.字段 路径自理）
                        如果 (签.返回形态 == 容器返回_标量) {
                            整64 方法返回码 = 类型码(驻留(签.返回文本));
                            如果 (方法返回码 != T_未知) {
                                登记寄存器类型(目标寄存器, 方法返回码);
                            }
                        }
                        // 617-a 波2（001-001·元素读取归一化）：返回 T=**有拷贝构造
                        //   类实例** → 调用点立即拷贝构造副本（分配对象+call 拷贝
                        //   构造·句柄唯一持有者·宿主按值返回拷贝对照）——原句柄
                        //   直传=调用方与容器共享元素→调用方 释放内部数组/写 作用
                        //   别名→双释放/堆损坏（113 弹出 铁证）。纯标量结构体
                        //   （无拷贝构造）不触发=零开销；字符串元素=驻留/串释放
                        //   面自理（②③ 域）不进本分支。
                        如果 (签.返回形态 == 容器返回_标量) {
                            整64 返回实例IDk = 驻留(签.返回文本);
                            整64 拷贝串IDk = 查类构造参数串(返回实例IDk, 1);
                            如果 (拷贝串IDk != 0) {
                                整64 新objk = 寄存器计数[0];
                                寄存器计数[0] = 寄存器计数[0] + 1;
                                IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新objk,
                                     查结构体大小(返回实例IDk), 返回实例IDk));
                                IR追加(指令, 建IR指令(IR_调用实参, 新objk, 0, 0, 0, 0, 0));
                                IR追加(指令, 建IR指令(IR_调用实参, 目标寄存器, 0, 0, 0, 1, 0));
                                IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                                     驻留(方法符号(签.返回文本,
                                           剥实例基名(签.返回文本),
                                           字符串复制(驻留文本(拷贝串IDk))))));
                                目标寄存器 = 新objk;
                            }
                        }
                        整64 压栈reg = 目标寄存器;
                        // 81-a-v2（甲案）：容器方法返回**真结构体** → 同理物化到独立槽
                        如果 (签.返回形态 == 容器返回_结构体) {
                            整64 方法返回结构ID = 驻留(签.返回文本);
                            如果 (查结构体大小(方法返回结构ID) != 0) {
                                整64 物化regm = 物化返回值到独立槽(指令, 寄存器计数, 槽计数,
                                                                  目标寄存器, 方法返回结构ID);
                                如果 (物化regm != 0) { 压栈reg = 物化regm; }
                                // 650-a 波 A〔基准=019〕：容器实例返回→物化后追加**拷贝构造**
                                //   （深拷·无别名值语义=019 安全区默认）——原 sret 物化=元素槽
                                //   浅拷字节→接收方 设置 扩容 realloc·原元素字段悬垂
                                //   （643 语义级互斥）→深拷后接收方独立·扩容自洽。
                                如果 (是容器类(签.返回文本)) {
                                    整64 拷贝串IDm = 查类构造参数串(方法返回结构ID, 1);
                                    如果 (拷贝串IDm != 0) {
                                        整64 新objm = 寄存器计数[0];
                                        寄存器计数[0] = 寄存器计数[0] + 1;
                                        IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新objm,
                                             查结构体大小(方法返回结构ID), 方法返回结构ID));
                                        IR追加(指令, 建IR指令(IR_调用实参, 新objm, 0, 0, 0, 0, 0));
                                        // 698-a 修复〔基准=019〕：拷贝构造源实参=T& 句柄槽
                                        //   （槽首 8B=壳指针）——原传 物化regm（物化壳地址本身）
                                        //   =被调方 [源] 再解一层拿到壳首 8B（字段0 值）当壳用
                                        //   →空映射 桶数量=0→READ [0+0x20] 段错误（113 注册/
                                        //   查找/弹出 三链同崩·宿主拷贝构造 asm 权威对照：
                                        //   src=句柄两跳 [源槽]→壳）。装配：句柄槽 ← 壳地址，
                                        //   源=&句柄槽（对照 生成容器拷贝构造 非引用分支
                                        //   IR_取地址(源槽) 同款契约）。
                                        整64 源句柄槽m = 槽计数[0];
                                        槽计数[0] = 槽计数[0] + 1;
                                        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 源句柄槽m));
                                        IR追加(指令, 建IR指令(IR_存储, 物化regm, 0, 0, 0, 0, 源句柄槽m));
                                        整64 源地址regm = 寄存器计数[0];
                                        寄存器计数[0] = 寄存器计数[0] + 1;
                                        IR追加(指令, 建IR指令(IR_取地址, 源句柄槽m, 0, 0, 源地址regm, T_整64, 0));
                                        IR追加(指令, 建IR指令(IR_调用实参, 源地址regm, 0, 0, 0, 1, 0));
                                        IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                                             驻留(方法符号(签.返回文本,
                                                   剥实例基名(签.返回文本),
                                                   字符串复制(驻留文本(拷贝串IDm))))));
                                        物化regm = 新objm;
                                        压栈reg = 新objm;
                                    }
                                }
                            }
                        }
                        结果<空类型, 整32> 加法 = 表达式栈.追加(压栈reg);
                        如果 (!加法.正常) { 运行时错误(4); }
                    }
                    返回;
                }
                IR层诊断("容器方法未收录: " + 类名 + "." + 方法名文本);
                运行时错误(6);
            }
            // 第七十八轮（2026-09-12）：用户类方法调用——this 位0 + 实参位1..，
            //   符号=类$方法[#参数串]（方法表来自 IR类 类表——语义层声明收集登记）
            如果 (是用户类(类名)) {
                // T87（489-b）：retbuf序号 透传（聚合返回走帧尾 retbuf·与容器
                //   方法发射同源槽区）
                发射用户类方法调用(类名, 方法名文本, this寄存器, 弹出们, 实参数,
                                    指令, 寄存器计数, 表达式栈, retbuf序号);
                返回;
            }
            // 466-a（T70 面⑥·模块根成员内置直调）：stdlib 源码级模块内部实现
            //   调内置成员（IO.cn 行 44 `IO.打印到错误(消息)`——根=内置模块名·
            //   sem5 已放行模块名根）→ 改写 模块::方法 限定内置直调（内置表
            //   同表命中·宿主「内置走限定名直调」同语义；生产态 stdlib 源码
            //   不编译=零触发）。this 已弹弃置（内置无 this 位）。
            字符串 根名466 = 类名;
            如果 (字符串长度(根名466) == 0 && 位置 >= 1) {
                // 对象类型解析 miss（根=内置模块名不在容器/类表）——自调用节点
                //   前邻回溯成员节点取链根（池布局=[根,成员,实参...,调用]·
                //   方法调用节点在实参之后·探针 32938~32942 实证）
                整64 找b = 位置 - 1;
                当 (找b >= 0 && 找b >= 位置 - 4) {
                    节点 成员n466 = 池.元素(整32(找b));
                    如果 (成员n466.类型 == 节点_成员 && 成员n466.子起点 > 0) {
                        节点 根n466 = 池.元素(整32(成员n466.子起点));
                        根名466 = 字符串复制(驻留文本(整64(根n466.文本)));
                        中断;
                    }
                    找b--;
                }
            }
            如果 (是标准库模块名(根名466)) {
                字符串 限定名466 = 根名466 + "::" + 方法名文本;
                如果 (字符串长度(内置函数符号(限定名466)) != 0) {
                    生成打印与内置调用(池, 驻留(限定名466), 弹出们, 实参数,
                                       指令, 寄存器计数, 表达式栈);
                    返回;
                }
            }
}

// 打印族（逐参类型分派 __cn_print_*+换行）与内置函数（__cn_ 直调）。
//   返回 1=本形态已处理（消费 1 个位置）；0=非此两族（调用方继续分派）。
不安全 函数 生成打印与内置调用(向量<节点> 池, 整64 函数符号, 向量<整64>& 弹出们, 整64 实参数,
                       向量<IR指令>& 指令, 整64* 寄存器计数, 向量<整64>& 表达式栈) -> 整32 {
        // ---- ③ 第一波：打印/打印行（复合内置，宿主 ir_call 对齐语义）——逐参按
        //      类型独立调用 __cn_print_str（字符串寄存器集合判定）/__cn_print_int，
        //      打印 尾随 __cn_print_newline（打印行 不加）；void 不压栈。
        //      注意 函数符号 恒为正（标识符兜底压栈 0-ID，此处再取反还原）；
        //      限定名内置（IO::/文件::）经语法层合成限定标识符走本路径。
        字符串 打印名 = 字符串复制(驻留文本(函数符号));
        布尔 是打印换行 = 字符串比较(打印名, "打印");
        如果 (是打印换行 || 字符串比较(打印名, "打印行")) {
            // 弹出们 为倒序弹（栈顶=右参先弹）——正序打印：从尾向头遍历
            整64 打i = 弹出们.大小();
            当 (打i > 0) {
                整64 打参 = 弹出们.元素(打i - 1);
                // ③ 缺陷①根治：类型登记表分派（字符串变量/字面量 str、浮点 float、
                //   布尔 bool（输出 真/假）、未登记/整数 int）
                整64 打参码 = 查寄存器类型(打参);
                // 91-a：浮32 实参 -> 浮64 提升（runtime __cn_print_float(double)
                //   按 SysV 双精度读 xmm0；宿主 ir_call f32 实参提升同款）
                如果 (打参码 == T_浮32) {
                    打参 = 插入值转换(打参, T_浮64, 指令, 寄存器计数);
                    打参码 = T_浮64;
                }
                字符串 打印符号 = "__cn_print_int";
                如果 (打参码 == T_字符串) {
                    打印符号 = "__cn_print_str";
                } 否则 如果 (打参码 == T_浮32 || 打参码 == T_浮64) {
                    打印符号 = "__cn_print_float";
                } 否则 如果 (打参码 == T_布尔) {
                    打印符号 = "__cn_print_bool";
                }
                整64 标记128v = 查地址128标记(打参);
                如果 (标记128v == 1) {
                    打印符号 = "__cn_print_i128";
                } 否则 如果 (标记128v == 2) {
                    打印符号 = "__cn_print_u128";
                }
                IR追加(指令, 建IR指令(IR_调用实参, 打参, 打参码, 0, 0, 0, 0));
                IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0, 驻留(打印符号)));
                打i--;
            }
            如果 (是打印换行) {
                IR追加(指令, 建IR指令(IR_调用参数化, 0, 0, 0, 0, 0,
                                     驻留("__cn_print_newline")));
            }
            返回 1;
        }
        // ---- ③ 第一波：内置函数（驻留/字符串族/运行时错误）——裸 ASCII 运行时
        //      符号直调（宿主 ABI 权威：v2p_linux.s 实查 bl __cn_intern）；
        //      代码生成 __cn_ 前缀直通不修饰。返回标量/指针单槽。
        //      ③ 第五波：限定名内置（IO::/文件::）同表命中——语法层 :: 已合成
        //      限定标识符，此处与纯名内置统一走本路径。
        字符串 内置符号名 = 内置函数符号(打印名);
        如果 (字符串长度(内置符号名) != 0) {
            整64 返回寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            // 91-a：返回类型码先算（IR_调用参数化.操作数2——浮点返回走 xmm0）；
            //   实参类型码按实参表达式登记类型（内置表无参数类型信息）
            整64 内置返回码 = 类型码(内置函数返回类型ID(打印名));
            // 91-a：浮32 实参 -> 浮64 提升（内置浮点 runtime 函数形参全为 double）
            整64 提升i = 0;
            当 (提升i < 弹出们.大小()) {
                如果 (查寄存器类型(弹出们.元素(提升i)) == T_浮32) {
                    整64 升reg = 插入值转换(弹出们.元素(提升i), T_浮64,
                                             指令, 寄存器计数);
                    结果<空类型, 整32> 设升 = 弹出们.设置(提升i, 升reg);
                    如果 (!设升.正常) { 运行时错误(4); }
                }
                提升i++;
            }
            发射调用实参们(弹出们, 0, 指令, 实参类型码们(弹出们));
            IR追加(指令, 建IR指令(IR_调用参数化, 实参数, 内置返回码, 0, 返回寄存器, 0,
                                 驻留(内置符号名)));
            // 返回类型登记（字符串/布尔/整64——打印分派与拼接判定消费；
            //   空类型跳过=void 无值语义，对齐用户函数 T_空类型 同款）
            如果 (内置返回码 != T_未知 && 内置返回码 != T_空类型) {
                登记寄存器类型(返回寄存器, 内置返回码);
            }
            结果<空类型, 整32> 加内 = 表达式栈.追加(返回寄存器);
            如果 (!加内.正常) { 运行时错误(4); }
            返回 1;
        }
    返回 0;
}

// 类型转换 类型(expr)（灰色点④窄宽特判）与容器构造调用（合成名无实参）。
//   返回 1=已处理；0=继续分派。
不安全 函数 生成转换或构造调用(整64 函数符号, 向量<整64>& 弹出们, 整64 实参数,
                       向量<IR指令>& 指令, 整64* 寄存器计数, 向量<整64>& 表达式栈) -> 整32 {
        // ---- 类型转换 类型(expr)（被调符号是类型名且单实参）——不走调用 ----
        整64 目标类型 = 类型码(函数符号);
        // 灰色点④根治（2026-09-04）：窄宽强转目标码特判——类型码() 将
        //   整8/整16 归 T_整64（v2 槽模型 8 字节、正8 无符号语义缺位），
        //   但强转须按目标宽度截断（win mov al/movsx、ARM64 sxtb/sxth），
        //   此处改码为窄宽标注；其余类型走 类型码() 原路径零变化
        字符串 强转名 = 字符串复制(驻留文本(函数符号));
        如果 (字符串比较(强转名, "整8")) {
            目标类型 = T_整8;
        } 否则 如果 (字符串比较(强转名, "整16")) {
            目标类型 = T_整16;
        } 否则 如果 (字符串比较(强转名, "正8")) {
            // 2026-09-04 缺陷零容忍收口：无符号窄宽（零扩展 movzx/uxtb——
            //   正8(200)=200；与 整8 符号扩展对称）
            目标类型 = T_正8;
        } 否则 如果 (字符串比较(强转名, "正16")) {
            目标类型 = T_正16;
        }
        如果 (目标类型 != T_未知 && 实参数 == 1) {
            整64 转换寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            // 方案甲（2026-09-10 第五十一轮 用户裁决，Rust as 语义对齐）：发射层
            //   读取扩展方式须按源操作数符号性选择（原只看目标码——正32→整64 落
            //   movsxd 符号扩展兜底 4000000000 出负、正64→整64 低32截断 2^63 出 0，
            //   宿主 emitCast 按源分派双侧分叉=193_v2 立案）。目标 64 位码时按
            //   源寄存器登记类型改标指令类型字段（发射层按该字段选读法）：源
            //   正32→T_正32（零扩展读，值保序）；源 整64/正64→T_正64（64 位直拷
            //   =同宽位模式重解释）；源 整32/未登记→维持目标码（movsxd 既有兜底）。
            //   原目标码另存供产物登记（改标仅编码发射读法，不改转换目标语义）。
            //   正8/正16 源（2026-09-10 第五十五轮标注）：经 类型码() 归一登记
            //   T_整64（窄宽无独立码）→同落 T_正64 64 位直拷——正确性=正8/正16
            //   槽是 64 位槽且全部写入路径（字面量装载/标识符拷贝/字段读回零扩展）
            //   保证高位干净，直拷=零扩展语义；结构体字段层经 类型宽度码()
            //   T_整8/T_整16 窄宽读回（1/2 字节+movzx）独立正确。E2E 194 双侧锚定
            //   （变量显式转换 rc=31/字段+指针解引用 rc=15，宿主 movzx 对称）。
            整64 原目标码 = 目标类型;
            整64 源登记码t = 查寄存器类型(弹出们.元素(0));
            如果 (目标类型 == T_整64 || 目标类型 == T_正64) {
                如果 (源登记码t == T_正32) {
                    目标类型 = T_正32;
                } 否则 如果 (源登记码t == T_整64 || 源登记码t == T_正64) {
                    目标类型 = T_正64;
                }
            }
            // 91-a（2026-09-13 第九十一轮）：操作数2 = 源类型码——发射层按
            //   (源码, 目标码) 组合分派浮点转换（整->浮 cvtsi2sd/scvtf、浮->整
            //   cvttsd2si/fcvtzs 截断、浮32<->浮64 cvtss2sd/cvtsd2ss/fcvt）；
            //   源码 0（未登记）按整型兜底（原整数路径行为零变化）。
            IR追加(指令, 建IR指令(IR_类型转换, 弹出们.元素(0), 源登记码t, 0, 转换寄存器, 目标类型, 函数符号));
            // 方案甲顺带（发射方向对齐宿主）：转换产物登记目标类型码——原未登记
            //   查 0 兜底 T_整64，正32(x) 产物参与二元时无符号性在发射点丢失
            登记寄存器类型(转换寄存器, 原目标码);
            结果<空类型, 整32> 加转 = 表达式栈.追加(转换寄存器);
            如果 (!加转.正常) { 运行时错误(4); }
            返回 1;
        }
        // ---- 第七十八轮（2026-09-12）：用户类构造调用（被调符号=类名ID）——
        //      分配对象 + this 位0 + 实参位1.. + 类$类名[#参数串]；对象指针压栈。
        //      判定先于容器分支（类名与容器合成名无交集——防御性顺序）
        字符串 被调名u = 字符串复制(驻留文本(函数符号));
        // 276-a（D28 根治·2026-09-17）：导入类裸名经解析期 B1 改写为「模块::类」
        //   限定形态，用户类登记为裸名——直接查表不命中→落普通调用=链接期
        //   undefined（随机数生成器 冒烟实锤）。拆基名后同判构造分派：
        //   发射符号=类$类名 与定义侧一致（plans/021 §3-D D28）。
        如果 (!是用户类(被调名u)) {
            字符串 限定模块 = "";
            字符串 限定符号 = "";
            如果 (拆限定名(被调名u, 限定模块, 限定符号) == 1 &&
                 是用户类(限定符号)) {
                被调名u = 限定符号;
            }
        }
        如果 (是用户类(被调名u)) {
            发射用户类构造(被调名u, 弹出们, 实参数, 指令, 寄存器计数, 表达式栈);
            返回 1;
        }
        // ---- 构造调用：被调符号是容器类合成名（向量$整64）且无实参 ----
        字符串 被调名 = 字符串复制(驻留文本(函数符号));
        如果 (是容器类(被调名) && 实参数 == 0) {
            整64 obj寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, obj寄存器,
                                 容器对象大小(被调名), 函数符号));
            IR追加(指令, 建IR指令(IR_调用实参, obj寄存器, 0, 0, 0, 0, 0));
            IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                 驻留(构造符号(被调名))));
            结果<空类型, 整32> 加构 = 表达式栈.追加(obj寄存器);
            如果 (!加构.正常) { 运行时错误(4); }
            返回 1;
        }
    返回 0;
}

// 71-a（2026-09-11 方案A 用户裁决）：内置构造器 正常()/错误()/某些() 装箱发射
//   （宿主 handleResultCtor/ir_error_ctor 同构，Rust Ok/Err/Some 零成本抽象）：
//   合成布局 正常@0(4字节)+值@4(整32/正32)/@8(其余)（结果值偏移，与宿主
//   typeSizeOf/接收侧 生成结果局部 布局双侧一致）；槽组=结果槽位数 个 8 字节槽、
//   基槽=最大槽号低地址。标志/值经 基址+IR_字段地址+IR_指针存储 按宽度写入
//   （整32 值与标志同槽不覆盖）。压栈产物=临时基址（返回位由 生成返回语句 拷入
//   retbuf；声明位由 生成结果局部 IR_结构体拷贝 接收）。
//   move 语义（正常/某些(拥有标识符)）：实参单标识符形态登记 已装箱名——出口
//   释放（发射字符串释放/发射容器析构/块出口析构）跳过=所有权转交装箱值（Rust
//   Ok(s) move 同款零拷贝；宿主 70-a 源槽清零同效，v2 跳过模型双装箱退化借用）。
//   表达式实参（拼接/调用产物）=临时值无源槽，不登记（出口本就不释放）。
不安全 函数 生成装箱构造(向量<节点> 池, 节点 n, 整32 位置,
                         向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数,
                         向量<整64>& 表达式栈) -> 整32 {
    整64 装箱类型ID = 整64(n.子终点);
    如果 (装箱类型ID <= 0) {
        // 430-b（族③ 收口）：克隆体装箱语境兜底——语义层标注发生在实例化前
        //   的基类体（克隆节点子终点=0）；返回位装箱=结果方法常态，取当前
        //   函数返回 结果/可选 类型名ID（生成方法/生成函数 每函数设置）。
        //   已标注节点（语义层可判·局部声明位）不受影响（子终点>0 直通）。
        装箱类型ID = 取当前函数返回结果名ID();
    }
    如果 (装箱类型ID <= 0) {
        IR层诊断("构造器装箱类型语境未知（语义层未标注）: " +
                  驻留文本(整64(池.元素(整32(n.子起点)).文本)));
        返回 0;
    }
    字符串 装箱名 = 字符串复制(驻留文本(装箱类型ID));
    字符串 被调名71 = 字符串复制(驻留文本(整64(池.元素(整32(n.子起点)).文本)));
    // 值字段类型：错误(码) 存 E（第二实参段），正常/某些 存 T（首实参段）——
    //   可选$T 单实参同 T 路径（宿主 handleResultCtor valueType 分派同构）
    字符串 实参段71 = 合成名首实参(装箱名);
    字符串 值类型71 = 段首(实参段71);
    如果 (字符串比较(被调名71, "错误")) {
        值类型71 = 段余(实参段71);
    }
    // 79-a 缺陷根治（既有，基线复现）：联合体偏移 = 较宽成员（T/E）——写入侧
    //   原按当前载荷单侧定偏移（结果<字符串,整32>.错误 写偏移 4），读取侧按
    //   联合体实际偏移（8）=读写不一致（探针 P11 实证：错误码读垃圾）。
    整64 值偏移71 = 结果值偏移(段首(实参段71));   // 联合体偏移基准 = T 的偏移档
    如果 (字符串比较(合成名基名(装箱名), "结果")) {
        整64 错偏移71 = 结果值偏移(段首(段余(实参段71)));   // E 的偏移档
        如果 (错偏移71 > 值偏移71) { 值偏移71 = 错偏移71; }
    }
    // 弹栈：线性求值序=被调兜底负符号先压、实参值后压（转移 特判同款弹法）
    整64 实参值71 = 0;
    如果 (n.附加 == 1 && 表达式栈.大小() >= 2) {
        实参值71 = 表达式栈.元素(表达式栈.大小() - 1);
        整64 弹i71 = 0;
        当 (弹i71 < 2) {
            结果<空类型, 整32> 删弹71 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删弹71.正常) { 运行时错误(4); }
            弹i71++;
        }
    } 否则 {
        如果 (表达式栈.大小() >= 1) {
            结果<空类型, 整32> 删被调71 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删被调71.正常) { 运行时错误(4); }
        }
    }
    // 槽组分配（逐槽 IR_分配 计入帧——生成结果局部 同构；不零初始化：未写区
    //   =联合 padding，接收方仅在 .正常 时读 .值，垃圾不读=零开销）
    整64 槽r71 = 槽计数[0];
    整64 槽数71 = 结果槽位数(装箱名);
    槽计数[0] = 槽计数[0] + 槽数71;
    整64 槽i71 = 0;
    当 (槽i71 < 槽数71) {
        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽r71 + 槽i71));
        槽i71++;
    }
    整64 基槽71 = 槽r71 + 槽数71 - 1;
    整64 基址71 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_取地址, 基槽71, 0, 0, 基址71, T_整64, 0));
    // 写标志（正常/某些=1、错误=0；T_整32 4 字节——x86 小端低字节即 .正常 布尔读值）
    整64 标志reg71 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    如果 (字符串比较(被调名71, "错误")) {
        IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 标志reg71, T_整64, 0));
    } 否则 {
        IR追加(指令, 建IR指令(IR_常量整数, 驻留("1"), 0, 0, 标志reg71, T_整64, 0));
    }
    IR追加(指令, 建IR指令(IR_指针存储, 基址71, 标志reg71, 0, 0, T_整32, 0));
    // 写值（有实参时）：基址+值偏移 按值类型宽度写
    如果 (实参值71 != 0) {
        整64 值地址71 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_字段地址, 基址71, 0, 0, 值地址71, T_整64,
                             值偏移71));
        // 673（051 主线·装箱构造结构体载荷降级写根治）：值类型宽度 >8（结构体/
        //   定长数组载荷）时，实参求值产物是**地址**（结构体读=地址语义·sret 同
        //   宿主「元素=元素地址」），载荷写入必须 IR_结构体拷贝 **内容深拷**——
        //   原 IR_指针存储 单槽 8B 把地址当值存（`返回 正常(值数组[位置])` 实证：
        //   载荷=数组元素地址 8B → 获取 返回的 结果.值 全垃圾·M2 探针 31/155
        //   根因底层）。宽度 ≤8 或宽度未知=标量值直存原路（零回归）。
        整64 值宽71 = 类型名宽度(驻留(值类型71));
        如果 (值宽71 > 8) {
            IR追加(指令, 建IR指令(IR_结构体拷贝, 实参值71, 值地址71, 0, 0,
                                 值宽71, 0));
        } 否则 {
            IR追加(指令, 建IR指令(IR_指针存储, 值地址71, 实参值71, 0, 0,
                                 类型码(驻留(值类型71)), 0));
        }
        // move 登记：实参单标识符（末位==首节点紧邻被调）形态——拥有源转交
        整64 末位71 = 查调用实参末位(整64(位置), 0);
        如果 (末位71 == 整64(n.子起点) + 1) {
            节点 实参n71 = 池.元素(整32(末位71));
            如果 (实参n71.类型 == 节点_标识符) {
                登记已装箱名(整64(实参n71.文本));
            }
        }
    }
    结果<空类型, 整32> 加箱71 = 表达式栈.追加(基址71);
    如果 (!加箱71.正常) { 运行时错误(4); }
    返回 1;
}

// 91-a（2026-09-13 第九十一轮）：容器方法实参类型码（与 弹出们 同序——
//   弹出们[i] = 声明序第 n-1-i 个实参；段名经 取参数段 解析、类型码 归一）。
//   浮点段（T=浮64/浮32 实例化替换后）走 xmm/d 寄存器类；未知段兜底 0（整型类）。
函数 容器实参类型码们(字符串 参数串, 向量<整64> 弹出们) -> 向量<整64> {
    向量<整64> 码们 = 向量<整64>();
    整64 n = 弹出们.大小();
    整64 i = 0;
    当 (i < n) {
        字符串 段名 = 取参数段(参数串, n - 1 - i);
        整64 段码 = 类型码(驻留(段名));
        结果<空类型, 整32> 加码 = 码们.追加(段码);
        如果 (!加码.正常) { 运行时错误(4); }
        i++;
    }
    返回 码们;
}

// 普通函数调用发射：结构体按值实参/& 引用实参 回扫取地址（B8/②c D 表驱动）+
//   返回结构体 retbuf（148）+引用返回解引用读值（P3-18）+返回值类型登记。
不安全 函数 发射普通函数调用(向量<整64>& 弹出们, 整64 函数符号, 整64 实参数,
                     向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数,
                     向量<整64>& 表达式栈,
                     整64 retbuf序号) -> 空类型 {
    // 224-a（2026-09-16 第两百二十四轮，D1 行数整改）：实参回扫迁 回扫结构体与引用实参；
    //   81-a-v2 物化迁 物化结构体返回值（真=已压栈已返回）；引用返回段迁 发射引用返回加载。
    回扫结构体与引用实参(弹出们, 函数符号, 指令, 寄存器计数);
    整64 返回寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
        寄存器计数[0] = 寄存器计数[0] + 1;
        // 用户函数返回结构体（2026-09-04，E2E 148）：帧尾共享 retbuf（容器
        //   方法同款 B6 设施）+ 位 0 装载 + 实参起始位 1；rax=结构体地址
        //   （初始化拷贝/链式成员基址/按值实参直用）。retbuf 帧尺寸累计。
        整64 retbuf序号v = 0;
        整64 实参起始位v = 0;
        整64 结构体返回IDv = 0 - 1;   // 81-a-v2：真结构体返回 → 调用后物化（>=0 生效）
        整64 查返回s = 查函数返回类型(函数符号);
        如果 (查返回s >= 0) {
            整64 返回结构大小 = 查结构体大小(查返回s);
            如果 (返回结构大小 == 0) {
                // 71-a：结果/可选 返回同款 retbuf ABI（被调方 返回结果名ID 配对；
                //   rax=retbuf=结果基址——接收侧 生成结果局部 IR_结构体拷贝 直用）
                字符串 返回名71 = 字符串复制(驻留文本(查返回s));
                如果 (是结果类型(返回名71)) {
                    返回结构大小 = 结果大小(返回名71);
                }
            }
            如果 (返回结构大小 != 0) {
                累计retbuf字节数(返回结构大小);
                retbuf序号v = retbuf序号;
                实参起始位v = 1;
                如果 (查结构体大小(查返回s) != 0) {
                    // 82-a：跨模块限定（同名结构体布局按模块分桶独立——E2E 172）
                    结构体返回IDv = 限定返回类型ID(函数符号, 查返回s);
                }
            }
        }
        发射调用实参们(弹出们, 实参起始位v, 指令, 实参类型码们(弹出们));
        // 91-a：返回类型码（IR_调用参数化.操作数2——浮点值返回走 xmm0 装载；
        //   retbuf 形态（结构体/结果）与引用返回=地址，标 0 整型类）
        整64 返回码v = 0;
        如果 (查返回s >= 0 && 结构体返回IDv < 0) {
            字符串 返回名pre = 字符串复制(驻留文本(查返回s));
            布尔 引用pre = 假;
            如果 (字符串长度(返回名pre) > 0 &&
                 字符串比较(字符串子串(返回名pre, 字符串长度(返回名pre) - 1, 1), "&")) {
                引用pre = 真;
            }
            如果 (!引用pre && 查结构体大小(查返回s) == 0) {
                返回码v = 类型码(查返回s);
            }
        }
        IR追加(指令, 建IR指令(IR_调用参数化, 实参起始位v + 实参数, 返回码v, 0,
                             返回寄存器, retbuf序号v, 函数符号));
    如果 (物化结构体返回值(指令, 寄存器计数, 槽计数, 返回寄存器, 结构体返回IDv, 表达式栈)) {
        返回;
    }
        // 引用返回（2026-09-04 缺陷零容忍收口，宿主 P3-18 对齐）：返回寄存器
        //   =被引用左值地址——默认按右值读解引用（IR_指针加载 值）；赋值目标/
        //   复合赋值/引用初始化场景经 生成左值地址 调用分支回扫取地址
        布尔 是引用返回v = 假;
        字符串 返回名v = "";
        如果 (查返回s >= 0) {
            返回名v = 字符串复制(驻留文本(查返回s));
            如果 (字符串长度(返回名v) > 0 &&
                 字符串比较(字符串子串(返回名v, 字符串长度(返回名v) - 1, 1), "&")) {
                是引用返回v = 真;
            }
        }
        如果 (是引用返回v) {
            发射引用返回加载(指令, 寄存器计数, 返回寄存器, 返回名v, 表达式栈);
            返回;
        }
        // ③ 第二波（方案A）：用户函数返回值类型登记（打印分派/拼接判定消费；
        //   缺陷②同族根治：字符串返回未登记 -> from_int(指针) 静默错误代码，
        //   asm 探针实锤——代码生成共用.cn:30/104 拼接实际在用）
        整64 查返回 = 查函数返回类型(函数符号);
        如果 (查返回 >= 0) {
            整64 返回码 = 类型码(查返回);
            如果 (返回码 != T_未知 && 返回码 != T_空类型) {
                登记寄存器类型(返回寄存器, 返回码);
            }
            // 701-a 波H 定论：128 位返回值**不设**地址标记（试验证=标记随编号复用
            //   泄漏致 500 崩）；返回值面待双槽值语义（053 主体）解决。
        }
        结果<空类型, 整32> 加普 = 表达式栈.追加(返回寄存器);
        如果 (!加普.正常) { 运行时错误(4); }
}

// 224-a：族① 实参回扫取地址——②b B8 结构体按值实参（函数实参结构们 表驱动）+
//   ②c D & 引用实参（函数实参引用们 同款回扫）。
不安全 函数 回扫结构体与引用实参(向量<整64>& 弹出们, 整64 函数符号, 向量<IR指令>& 指令, 整64* 寄存器计数) -> 空类型 {
        // ---- 普通函数调用：实参从位 0 起，全部经 64+63（任意参数数） ----
        // ②b B8：结构体按值实参 -> 传地址（函数实参结构们 表驱动——与 B3 容器
        //   方法路径同款回扫；v2 自身 IR追加(指令, 建IR指令(...)) ③ 自举必需）
        // ②c D：& 引用实参 -> 传左值地址（函数实参引用们 表驱动同款回扫）
        整64 实i2 = 0;
        当 (实i2 < 弹出们.大小()) {
            整64 查结构实参 = 查函数实参结构(函数符号 * 键位移 + 实i2);
            如果 (查结构实参 >= 0) {
                回扫实参取地址(指令, 弹出们, 实i2, 寄存器计数);
            } 否则 {
                布尔 查引用实参 = 是函数实参引用(函数符号 * 键位移 + 实i2);
                如果 (查引用实参) {
                    回扫实参取地址(指令, 弹出们, 实i2, 寄存器计数);
                }
            }
            实i2++;
        }
}

// 224-a：族② 81-a-v2（甲案）真结构体返回物化——调用发射后立即物化到独立槽并改压栈
//   寄存器（帧尾共享 retbuf 会被后续返回调用覆盖）。返回 真=已物化已压栈（调用方即返回）。
不安全 函数 物化结构体返回值(向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数,
                     整64 返回寄存器, 整64 结构体返回IDv, 向量<整64>& 表达式栈) -> 布尔 {
    如果 (结构体返回IDv >= 0) {
            整64 物化reg = 物化返回值到独立槽(指令, 寄存器计数, 槽计数,
                                              返回寄存器, 结构体返回IDv);
            如果 (物化reg != 0) {
                整64 物化码 = 类型码(结构体返回IDv);
                如果 (物化码 != T_未知 && 物化码 != T_空类型) {
                    登记寄存器类型(物化reg, 物化码);
                }
                结果<空类型, 整32> 加物 = 表达式栈.追加(物化reg);
                如果 (!加物.正常) { 运行时错误(4); }
                返回 真;
            }
    }
    返回 假;
}

// 224-a：族③ 引用返回加载——返回寄存器=被引用左值地址，默认按右值读解引用
//   （IR_指针加载）；值类型登记剥尾 & 后的类型码（打印分派/拼接消费）。
不安全 函数 发射引用返回加载(向量<IR指令>& 指令, 整64* 寄存器计数, 整64 返回寄存器,
                     字符串 返回名v, 向量<整64>& 表达式栈) -> 空类型 {
    整64 引用值reg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 返回寄存器, 0, 0, 引用值reg, T_整64, 0));
            // 值类型登记：剥尾 & 后的类型码（打印分派/拼接消费）
            字符串 基类型名 = 字符串子串(返回名v, 0, 字符串长度(返回名v) - 1);
            整64 引用返回码 = 类型码(驻留(基类型名));
            如果 (引用返回码 != T_未知 && 引用返回码 != T_空类型) {
                登记寄存器类型(引用值reg, 引用返回码);
            }
            结果<空类型, 整32> 加引 = 表达式栈.追加(引用值reg);
            如果 (!加引.正常) { 运行时错误(4); }
            返回;
}


// 下标访问：字符串[i] 逐字节（T_字节 符号扩展）/指针对象 p[i] 元素宽度步进
//   （③ 第三波）。弹 下标与对象值，地址=对象+缩放步进，加载宽度按元素码登记。
不安全 函数 生成下标访问(向量<节点> 池, 节点 n, 向量<IR指令>& 指令,
                  整64* 寄存器计数, 整64* 块计数,
                  向量<整64>& 表达式栈) -> 空类型 {
        // ③ 第二波：字符串[i] 逐字节 O(1) 访问（宿主 A-1 对齐，plans/004）：
        //   UTF-8 字节视图步进 1，LoadPtr i8 有符号扩展（双后端 movsx/ldrsb——
        //   与 C 的 s[i] 一致，65 用例 字节和=-376 实证），越界由调用方按
        //   字符串长度 约束；结果类型 字符（符号扩展字节值按整数消费）。
        //   弹 下标（栈顶）与 对象（字符串指针值——标识符/成员/调用产物均可），
        //   地址 = 对象 + 下标（IR_加 步进 1），IR_指针加载 T_字节（1 字节符号
        //   扩展——独立宽度码，B5 字段 T_字符 零扩展模型互不影响）。
        // ③ 第三波：指针对象 p[i] ≡ *(p + i)（宿主 ir_expr.cpp:1555 对齐）——
        //   步进=所指元素宽度（类型名宽度；步进1 免乘），加载宽度=元素宽度码，
        //   结果登记元素类型码（打印分派/拼接消费）。对象须为指针变量（语义层
        //   白名单保证；未命中走字符串路径——两白名单互斥不误伤）。
        // 94-a/97-a：对象元素类型 + 数组长度统一经推导 helper（标识符数组变量 /
        //   指针变量 / **结构体字段数组**（成员对象，97-a C8）三形态同源）
        整64 所指ID = 0;
        整64 数组长度下 = 0;
        如果 (n.子起点 > 0) {
            所指ID = 推导下标元素类型ID(池, 整32(n.子起点));
            数组长度下 = 推导下标数组长度(池, 整32(n.子起点));
        }
        整64 下标值 = 0;
        如果 (表达式栈.大小() >= 1) {
            下标值 = 表达式栈.元素(表达式栈.大小() - 1);
            结果<空类型, 整32> 删下 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删下.正常) { 运行时错误(4); }
        }
        整64 对象值 = 0;
        如果 (表达式栈.大小() >= 1) {
            对象值 = 表达式栈.元素(表达式栈.大小() - 1);
            结果<空类型, 整32> 删对 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删对.正常) { 运行时错误(4); }
        }
        如果 (所指ID != 0) {
            // 94-a：数组下标越界检查（宿主 ir.cpp 同构：下标 >= 长度 → 运行时
            //   错误(1)）——数组对象有静态长度（数组长度下 > 0 才发射；指针
            //   对象无长度信息=既有边界）。安全性：越界读/写挡在运行期入口。
            如果 (数组长度下 > 0) {
                发射数组越界检查(下标值, 数组长度下, 指令, 寄存器计数, 块计数);
            }
            整64 步进 = 类型名宽度(所指ID);
            整64 缩放值 = 下标值;
            如果 (步进 != 1) {
                整64 步进常量 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留(整数转字符串(步进))), 0, 0,
                                     步进常量, T_整64, 0));
                整64 缩放寄存器 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_乘, 下标值, 步进常量, 0, 缩放寄存器, T_整64, 0));
                缩放值 = 缩放寄存器;
            }
            整64 元素地址 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加, 对象值, 缩放值, 0, 元素地址, T_整64, 0));
            // 94-a（2026-09-13 第九十四轮）：元素为**结构体**（查结构体大小 != 0）
            //   ——表达式值 = **元素地址**（不加载）：与 87-a 静态结构体/结构体局部/
            //   86-a 三元聚合同款「结构体表达式值=地址」约定；成员访问（表[0].x）
            //   基址侧复用栈顶、整体拷贝、作实参全链零拷贝消费。
            如果 (查结构体大小(所指ID) != 0) {
                登记寄存器类型(元素地址, T_对象);
                结果<空类型, 整32> 加元地 = 表达式栈.追加(元素地址);
                如果 (!加元地.正常) { 运行时错误(4); }
                返回;
            }
            整64 元素值寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 元素地址, 0, 0, 元素值寄存器,
                                 类型宽度码(驻留文本(所指ID)), 0));
            登记寄存器类型(元素值寄存器, 类型码(所指ID));
            结果<空类型, 整32> 加元素 = 表达式栈.追加(元素值寄存器);
            如果 (!加元素.正常) { 运行时错误(4); }
            返回;
        }
        // T4（311-a=306-b 波次2 v2 侧·2026-09-17）：字符串下标越界检查（运行时
        //   长度版——对齐宿主 emitStrBoundsCheck/__cn_str_len；错误码 2 与 94-a
        //   数组防线对称）。原「越界由调用方按字符串长度约束」=防线不对称（数组
        //   有检查而字符串无=越界读 UB）。字符* 指针视图走 所指ID!=0 指针路径
        //   （无长度信息·既有边界）=天然不误伤（与宿主三读路径插桩同覆盖：
        //   对象值=标识符/成员/调用产物均可）。
        发射字符串越界检查(下标值, 对象值, 指令, 寄存器计数, 块计数);
        整64 下标地址 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_加, 对象值, 下标值, 0, 下标地址, T_整64, 0));
        整64 字节值寄存器 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_指针加载, 下标地址, 0, 0, 字节值寄存器, T_字节, 0));
        登记寄存器类型(字节值寄存器, T_整64);
        结果<空类型, 整32> 加字 = 表达式栈.追加(字节值寄存器);
        如果 (!加字.正常) { 运行时错误(4); }
}

// ==================== 84-a：结构体字面量作实参（生成） ====================
// 机制主体 = 临时槽（生成期槽计数递增 + 逐槽 IR_分配 + 基址槽=槽起+槽数-1，82-a 槽分配
//   纪律四条）+ 零初始化 + 逐字段写（值区间 生成表达式 求值 → 字段地址 + 指针存储
//   （宽度=查字段宽度码））；槽地址压栈 + 登记 结构体返回临时们（**实参位置**由 82-a
//   清理调用实参临时 在外层调用发射后释放串字段——零新清理机制）。
// 依赖不变量 = ①基址槽=最大槽号=最低地址（②b B1）；②逐槽 IR_分配（扫描函数 帧尺寸）
//   ③零初始化先于字段写（未赋值字段=0 空安全；字符串字段缺值不悬垂）。
不安全 函数 生成结构体构造(向量<节点> 池, 节点 n, 映射<整64, 整64>& 局部槽,
                    映射<整64, 整64>& 参数槽, 向量<IR指令>& 指令, 整64* 寄存器计数,
                    整64* 块计数, 整64* 槽计数, 向量<整64>& 表达式栈) -> 空类型 {
    整64 结构体IDc = 整64(n.文本);
    整64 大小c = 查结构体大小(结构体IDc);
    如果 (大小c <= 0) {
        IR层诊断("结构体构造字面量: 类型未知 " + 驻留文本(结构体IDc));
        返回;
    }
    整64 槽数c = (大小c + 7) / 8;
    整64 槽起c = 槽计数[0];
    槽计数[0] = 槽计数[0] + 槽数c;
    整64 zc = 0;
    当 (zc < 槽数c) {
        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽起c + zc));
        zc++;
    }
    整64 基槽c = 槽起c + 槽数c - 1;
    整64 基址regc = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_取地址, 基槽c, 0, 0, 基址regc, T_整64, 0));
    整64 零regc = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零regc, T_整64, 0));
    整64 清c = 0;
    当 (清c < 大小c) {
        整64 清地址 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_字段地址, 基址regc, 0, 0, 清地址, T_整64, 清c));
        IR追加(指令, 建IR指令(IR_指针存储, 清地址, 零regc, 0, 0, T_整64, 0));
        清c = 清c + 8;
    }
    // 84-c：**跳过嵌套构造区间**——嵌套字面量（`外盒{ 内 = 内盒{ 名 = 串 }, v = 5 }`）
    //   的内层字段初值节点也落在本构造的 [子起点, 子终点) 内（其后缀序：内层字段初值
    //   在内层构造节点之前）；若不跳过，外层字段循环会把内层字段初值**误当自己的字段**：
    //   ① 字段名查不到偏移 → 按默认宽度写到本槽（覆盖/杂写）② 内层字段值被**二次求值**
    //   （多一次 __cn_str_copy，其一被后续结构体拷贝覆盖而泄漏——探针 P26/P27 实证
    //   残留 1；诊断 dump 实证外层区间含内层字段初值 44 达两处）。
    //   嵌套区间的整段由「对应字段的值区间求值」处理（`生成表达式` 递归 → 内层构造）。
    向量<整64> 嵌套区间们 = 向量<整64>();
    收集构造区间(池, 整32(n.子起点), 整32(n.子终点), 嵌套区间们);
    整64 fi = 整64(n.子起点);
    当 (fi < 整64(n.子终点)) {
        整64 跳终84 = 区间终点(嵌套区间们, 整32(fi), 2);
        如果 (跳终84 >= 0) {
            如果 (跳终84 > fi) { fi = 跳终84; } 否则 { fi++; }
            继续;
        }
        节点 字段节点 = 池.元素(整32(fi));
        如果 (字段节点.类型 == 节点_字段初值) {
            整64 值起c = 整64(字段节点.子起点);
            整64 值止c = 整64(字段节点.子终点);
            如果 (值止c > 值起c) {
                生成表达式(池, 整32(值起c), 整32(值止c), 局部槽, 参数槽, 指令,
                          寄存器计数, 块计数, 槽计数, 表达式栈);
            }
            整64 值regc = 零regc;
            如果 (表达式栈.大小() > 0) {
                值regc = 表达式栈.元素(表达式栈.大小() - 1);
                结果<空类型, 整32> 删值c = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删值c.正常) { 运行时错误(4); }
            }
            整64 字段地址c = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_字段地址, 基址regc, 0, 0, 字段地址c, T_整64,
                                 整64(字段节点.附加)));
            // 84-c：字段类型分派——**值语义结构体字段**（如 `外层{ 内 = 内层{ v = 7 } }`）
            //   须**整体拷贝**（内联值语义：源=嵌套构造槽地址/结构体返回地址 → 目标=字段内联
            //   区）；按「宽度存储」只会写入地址指针（8 字节）→ 读取按内联偏移=垃圾
            //   （探针 P24① 实证：宿主 10 / v2 140735369840171）。其余类型（标量/字符串/
            //   指针）按宽度存储（窄宽字段越界教训：整32 字段写 8 字节踩相邻字段）。
            整64 字段类型IDf = 查字段类型ID(结构体IDc, 整64(字段节点.文本));
            整64 字段大小f = 0;
            如果 (字段类型IDf != 0) { 字段大小f = 查结构体大小(字段类型IDf); }
            如果 (字段大小f > 0) {
                // 结构体字段=值语义内联 → memcpy 整体拷贝（与宿主 emitStructInitTo 内联一致）
                IR追加(指令, 建IR指令(IR_结构体拷贝, 值regc, 字段地址c, 0, 0,
                                     字段大小f, 0));
            } 否则 {
                整64 宽度c = 查字段宽度码(结构体IDc, 整64(字段节点.文本));
                IR追加(指令, 建IR指令(IR_指针存储, 字段地址c, 值regc, 0, 0, 宽度c, 0));
            }
        }
        fi++;
    }
    结果<空类型, 整32> 设临c = 结构体返回临时们.设置(基址regc, 结构体IDc);
    如果 (!设临c.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加栈c = 表达式栈.追加(基址regc);
    如果 (!加栈c.正常) { 运行时错误(4); }
}

// 94-a（2026-09-13 第九十四轮）：数组下标越界检查发射（宿主 ir.cpp 同构：下标
//   >= 长度 → 运行时错误(1)；上界有符号比较——数组长度为正常量，负数下标
//   属宿主同款既有边界）。形态：长度常量 + IR_大于等于 + 条件跳转（越界块调
//   __cn_runtime_error，不返回）+ 继续块标签；非数组（长度 0）调用方不发射。
不安全 函数 发射数组越界检查(整64 下标值, 整64 数组长度, 向量<IR指令>& 指令,
                          整64* 寄存器计数, 整64* 块计数) -> 空类型 {
    如果 (数组长度 <= 0) { 返回; }
    整64 长度常量x = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留(整数转字符串(数组长度))), 0, 0,
                          长度常量x, T_整64, 0));
    整64 越界布尔x = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_大于等于, 下标值, 长度常量x, 0, 越界布尔x, T_布尔, 0));
    登记寄存器类型(越界布尔x, T_布尔);
    整64 越界块x = 块计数[0] + 1;
    整64 继续块x = 块计数[0] + 2;
    块计数[0] = 块计数[0] + 2;
    IR追加(指令, 建IR指令(IR_条件跳转, 越界布尔x, 越界块x, 继续块x, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 越界块x));
    整64 错误码x = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    // 错误码 2=数组越界（runtime 契约表：1=除零 2=数组越界——
    //   src/runtime/runtime.cpp 同源；宿主 ir.cpp 越界检查同码）
    IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("2")), 0, 0, 错误码x, T_整64, 0));
    IR追加(指令, 建IR指令(IR_调用实参, 错误码x, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                         驻留(内置函数符号("运行时错误"))));
    IR追加(指令, 建IR指令(IR_跳转, 0, 0, 0, 0, 0, 继续块x));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 继续块x));
}

// T4（311-a=306-b 波次2 v2 侧·2026-09-17）：字符串下标越界检查发射（运行时
//   长度版——对齐宿主 306-a emitStrBoundsCheck：调 __cn_str_len(对象) 得运行时
//   长度，下标 >= 长度 → 运行时错误(2)（错误码与数组防线对称·不返回）；上界
//   有符号比较——负数下标与数组版同属既有边界）。对象=字符串指针值（字符串
//   路径专属——字符* 指针视图走 所指ID!=0 指针路径不经此=不误伤）。
不安全 函数 发射字符串越界检查(整64 下标值, 整64 对象值, 向量<IR指令>& 指令,
                            整64* 寄存器计数, 整64* 块计数) -> 空类型 {
    // ① 运行时长度：__cn_str_len(对象) ——实参=对象（字符串指针值）
    IR追加(指令, 建IR指令(IR_调用实参, 对象值, T_对象, 0, 0, 0, 0));
    整64 长度寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_调用参数化, 1, T_整64, 0, 长度寄存器, 0,
                         驻留(内置函数符号("字符串长度"))));
    登记寄存器类型(长度寄存器, T_整64);
    // ② 下标 >= 长度 → 越界块（错误码 2 ·与 94-a 数组版同码）
    整64 越界布尔s = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_大于等于, 下标值, 长度寄存器, 0, 越界布尔s, T_布尔, 0));
    登记寄存器类型(越界布尔s, T_布尔);
    整64 越界块s = 块计数[0] + 1;
    整64 继续块s = 块计数[0] + 2;
    块计数[0] = 块计数[0] + 2;
    IR追加(指令, 建IR指令(IR_条件跳转, 越界布尔s, 越界块s, 继续块s, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 越界块s));
    整64 错误码s = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("2")), 0, 0, 错误码s, T_整64, 0));
    IR追加(指令, 建IR指令(IR_调用实参, 错误码s, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                         驻留(内置函数符号("运行时错误"))));
    IR追加(指令, 建IR指令(IR_跳转, 0, 0, 0, 0, 0, 继续块s));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 继续块s));
}
