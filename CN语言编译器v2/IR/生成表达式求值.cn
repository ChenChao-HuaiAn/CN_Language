// CN 自举编译器 v2 · IR 生成表达式求值子形态（R3 千行拆分，2026-09-08）
// 职责：自 生成表达式.cn 提取的调用族+下标族六函数——类型大小折叠/方法调用/
//   打印族与内置/类型转换与构造/普通函数调用发射/下标访问。单向依赖：本模块
//   不调 生成表达式（递归调者 留原文件如 生成短路求值/生成下标左值地址），
//   故无循环导入。模块路径=原组件名逐字节不变（键基/mangling 零变化）。
导入 容器::向量;
导入 映射集合;
导入 语法;       // Token/AST 节点池（目录包名）
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码 + IR常量 键位移（目录包名）
导入 IR生成;     // 函数级变量类型权威表/重载决议/控制流辅助（同包幂等）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 调用生成（R3 提取，2026-09-08）：类型大小折叠/弹参/方法与函数分派主体。
//   返回 消费 token 数（恒 1）；0=整个表达式求值须返回 0（类型大小未知/决议失败）。
不安全 函数 生成调用(向量<节点> 池, 节点 n, 整32 位置, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
              向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数,
              向量<整64>& 表达式栈, 整64 retbuf序号) -> 整32 {
        // ---- 71-a（2026-09-11 方案A 用户裁决）：内置构造器 正常()/错误()/某些()
        //      装箱特判（语义层已推导类型写入 n.子终点）——先于转移/普通调用。
        //      被调标识符兜底负符号与实参值由 生成装箱构造 统一弹收。
        如果 (n.子起点 > 0 && n.附加 <= 1) {
            节点 被调71 = 池.元素(整32(n.子起点));
            如果 (被调71.类型 == 节点_标识符) {
                字符串 被调名71 = 字符串复制(驻留文本(整64(被调71.文本)));
                如果 (字符串比较(被调名71, "正常") || 字符串比较(被调名71, "错误") ||
                     字符串比较(被调名71, "某些")) {
                    返回 生成装箱构造(池, n, 位置, 指令, 寄存器计数, 槽计数, 表达式栈);
                }
            }
        }
        // ---- plans/019 阶段1（2026-09-10）：显式转移 转移(变量) 展开——
        //      语义层已放行（指针/字符串值交接）。栈顶=实参寄存器值（标识符
        //      求值产物），其下=被调「转移」函数名兜底负符号：弹掉被调残留、
        //      实参值留在栈顶=转移调用的求值结果（零运行时指令，纯编译期）。
        //      位置紧邻 类型大小 折叠（单标识符实参内置调用同族形态）。
    // 212-a（2026-09-15 第两百一十二轮，D1 行数整改）：转移展开/类型大小折叠两特判
    //   迁独立族（-1=未处理哨兵，主函数继续原链——终结性装箱特判留主函数）。
    如果 (生成转移展开(池, n, 位置, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈)) { 返回 1; }
    // 206-c：复制(表达式) 泛型克隆内置展开（字符串=符号改写返回假，主链内置
    //   路径完成；标量/容器/结构体=终结发射返回真）
    如果 (生成复制展开(池, n, 位置, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈)) { 返回 1; }
    整32 折叠r = 0;
    如果 (生成类型大小折叠(池, n, 位置, 指令, 寄存器计数, 表达式栈, 折叠r)) { 返回 折叠r; }
    // 函数/方法调用（2026-09-01 用户裁决项3 参数区改造）：弹实参（倒序）入
    //   弹出们，逐个发射 IR_调用实参(64)（位号声明性标注），IR_调用参数化(63)
    //   收尾——任意实参数（7 组件源码 8 参函数）；普通调用与方法调用统一路径。
        // 函数/方法调用（2026-09-01 用户裁决项3 参数区改造）：弹实参（倒序）入
        //   弹出们，逐个发射 IR_调用实参(64)（位号声明性标注），IR_调用参数化(63)
        //   收尾——任意实参数（7 组件源码 8 参函数）；普通调用与方法调用统一路径。
        整64 实参数 = n.附加;
        向量<整64> 弹出们 = 向量<整64>();
        整64 弹i = 0;
        当 (弹i < 实参数 && 表达式栈.大小() > 0) {
            结果<空类型, 整32> 加弹 = 弹出们.追加(表达式栈.元素(表达式栈.大小() - 1));
            如果 (!加弹.正常) { 运行时错误(4); }
            结果<空类型, 整32> 删弹 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删弹.正常) { 运行时错误(4); }
            弹i++;
        }
        整64 被调 = 0;
        如果 (表达式栈.大小() > 0) {
            被调 = 表达式栈.元素(表达式栈.大小() - 1);
            结果<空类型, 整32> 删被调 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删被调.正常) { 运行时错误(4); }
        }
        // T69（480-a 深度机）：实参位函数名收口（负占位=函数名作实参 → IR_函数地址
        //   寄存器；宿主 checkFunctionNameValue 同义）——普通调用/方法调用两路共用
        实参负占位收口480(指令, 寄存器计数, 弹出们);
        // ---- 方法调用：被调是方法标记（-(10^6+方法名ID)），标记下压着 this ----
    // ---- 方法调用：被调是方法标记（-(10^6+方法名ID)），标记下压着 this ----
    如果 (被调 <= -1000000) {
        生成方法调用(池, n, 位置, 被调, 弹出们, n.附加, 局部槽, 参数槽, 指令, 寄存器计数,
                    槽计数, 表达式栈, retbuf序号);
        // 81-a-v2：实参位置返回物化槽的串字段释放（调用发射后；含「外层调用返回值
        //   覆盖 retbuf」场景的独立副本所有权收口）
        清理调用实参临时(弹出们, 指令, 寄存器计数);
        返回 1;
    }
        如果 (被调 >= 0) {
            // 104/440（070 波C）：方法引用闭包调用展开——被调变量在 闭包绑定表
            //   → 直调方法符号（this=对象槽+用户实参·宿主 ir_call.cpp 闭包展开
            //   同构）；miss 走 T69 间接调用。
            如果 (方法引用闭包调用展开(池, n, 弹出们, 局部槽, 参数槽, 指令,
                                   寄存器计数, 槽计数, 表达式栈) == 1) {
                清理调用实参临时(弹出们, 指令, 寄存器计数);
                返回 1;
            }
            // T69（480-a 深度机）：函数指针间接调用——被调弹到寄存器值（函数
            //   指针槽装载产物/函数地址寄存器）= 经指针调用（宿主 ir_call.cpp
            //   CallIndirect 同构）；三后端按 附加 装载指针到临时寄存器后
            //   call reg（装载晚于实参，防覆盖）。
            发射间接调用480(池, n, 被调, 弹出们, 指令, 寄存器计数, 槽计数,
                          表达式栈);
            清理调用实参临时(弹出们, 指令, 寄存器计数);
            返回 1;
        }
        整64 函数符号 = 0 - 被调;
    // 打印族/内置函数（R3 提取）：命中即处理返回 1
    如果 (生成打印与内置调用(池, 函数符号, 弹出们, n.附加, 指令, 寄存器计数, 表达式栈) == 1) {
        返回 1;
    }
    // ---- 呈报③方案A：用户函数重载决议（2026-09-06）——决议歧义/失败
    //      已在决议内 IR层诊断（fail fast），0=中止
    函数符号 = 决议函数符号(池, 函数符号, 整32(位置));
    如果 (函数符号 == 0) { 返回 0; }
    // 类型转换/构造调用（R3 提取）：命中即处理返回 1
    如果 (生成转换或构造调用(函数符号, 弹出们, n.附加, 指令, 寄存器计数, 槽计数,
                             表达式栈) == 1) {
        返回 1;
    }
    // 普通函数调用（R3 提取）
    发射普通函数调用(弹出们, 函数符号, n.附加, 指令, 寄存器计数, 槽计数,
                     表达式栈, retbuf序号);
    // 81-a-v2：实参位置返回物化槽的串字段释放（调用发射后）
    清理调用实参临时(弹出们, 指令, 寄存器计数);
    返回 1;
}


// 212-a：族① 显式转移 转移(变量) 展开（plans/019 阶段1）——弹 2 个压栈残留
//   （实参值+被调负符号）、实参值压回=转移调用求值结果（纯编译期零指令）。
//   返回 1=已处理；-1=非转移形态（主函数继续原链）。
// 977（008 总攻·576 实参位转移·对齐宿主 096/plans/022 波4）：升级为**真槽位
//   交接**——弹 2 压 1 句柄直拷之外，源槽清零（moved-from 旧名禁用·后继使用
//   读空句柄=空安全跳过/确定性失败）。两路分派（源类型经 解析标识符类型ID）：
//     ①用户类/容器/字符串/指针（单值句柄槽）=直拷+单槽清零；
//     ②内联结构体（查结构体大小>0 且非类/容器——类布局陷阱守卫·972 深水一
//       同款排除）=**先物化副本再清零源**（新槽组+IR_结构体拷贝+源槽组清零+
//       压副本基址）——清零早于回扫取地址会拷到全零（时序铁律·宿主 096 同款
//       tmp 物化模型）。
//   声明位（生成声明 浅交接）/赋值位（963 特判）不走本函数=不受影响。
//   返回 1=已处理；-1=非转移形态（主函数继续原链）。
不安全 函数 生成转移展开(向量<节点> 池, 节点 n, 整32 位置, 映射<整64, 整64>& 局部槽,
                        映射<整64, 整64>& 参数槽, 向量<IR指令>& 指令,
                        整64* 寄存器计数, 整64* 块计数, 整64* 槽计数,
                        向量<整64>& 表达式栈) -> 布尔 {
        如果 (n.子起点 > 0 && n.附加 == 1) {
            节点 转被调 = 池.元素(整32(n.子起点));
            节点 转实参节点 = 池.元素(整32(n.子起点) + 1);
            // 1011（585·池布局修正）：成员链实参的池布局=[转移, h, 桶, 调用]
            //   ——n.子起点+1=h（标识符）非成员末节点；实参末节点经语义层
            //   实参末位表取（查调用实参末位·894 同款）——桶 成员节点。
            整64 末位585 = 查调用实参末位(整64(位置), 0);
            节点 转实参末585 = 转实参节点;
            如果 (末位585 > 0 && 末位585 < 整64(池.大小())) {
                转实参末585 = 池.元素(整32(末位585));
            }
            如果 (转被调.类型 == 节点_标识符 &&
                 字符串比较(驻留文本(整64(转被调.文本)), "转移") &&
                 转实参末585.类型 == 节点_成员) {
                // 1011（585·转移成员源）：977 真槽位交接的成员链扩展——
                //   转移(h.桶) 形态原整个 miss（只认 节点_标识符）→主链
                //   兜底旧路径=句柄交接无清零（h.桶 悬垂·字符串长度(h.桶)
                //   读已释放→fault=0/垃圾）。修：栈顶成员读值（字符串句柄）
                //   直通交接+源=成员左值地址写字符串 0（空句柄=旧名禁用+
                //   空安全语义·977 ① 同款单值句柄清零）。
                如果 (表达式栈.大小() >= 2) {
                    整64 成员值585 = 表达式栈.元素(表达式栈.大小() - 1);
                    整64 删转i585 = 0;
                    当 (删转i585 < 2) {
                        结果<空类型, 整32> 删转585 = 表达式栈.删除(
                            表达式栈.大小() - 1);
                        如果 (!删转585.正常) { 运行时错误(4); }
                        删转i585++;
                    }
                    // 成员左值地址（链区间=[成员.子起点, 末位节点+1)——基名到成员）
                    整64 成员地址585 = 生成左值地址(
                        池, 整32(转实参末585.子起点), 整32(末位585) + 1,
                        局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数,
                        表达式栈);
                    整64 零585 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0,
                                         零585, T_整64, 0));
                    IR追加(指令, 建IR指令(IR_指针存储, 成员地址585, 零585,
                                         0, 0, T_字符串, 0));
                    结果<空类型, 整32> 加成员585 = 表达式栈.追加(成员值585);
                    如果 (!加成员585.正常) { 运行时错误(4); }
                }
                返回 真;
            }
            如果 (转被调.类型 == 节点_标识符 && 转实参节点.类型 == 节点_标识符 &&
                 字符串比较(驻留文本(整64(转被调.文本)), "转移")) {
                如果 (表达式栈.大小() >= 2) {
                    整64 转实参值 = 表达式栈.元素(表达式栈.大小() - 1);
                    整64 删转i = 0;
                    当 (删转i < 2) {
                        结果<空类型, 整32> 删转 = 表达式栈.删除(表达式栈.大小() - 1);
                        如果 (!删转.正常) { 运行时错误(4); }
                        删转i++;
                    }
                    // 977：源槽清零（真槽位交接）——源槽解析（局部→参数）
                    整64 源名977 = 整64(转实参节点.文本);
                    整64 源槽977 = 0;
                    结果<整64, 整32> 找局977 = 局部槽.获取(源名977);
                    如果 (找局977.正常) { 源槽977 = 找局977.值; }
                    如果 (源槽977 == 0) {
                        结果<整64, 整32> 找参977 = 参数槽.获取(源名977);
                        如果 (找参977.正常) { 源槽977 = 找参977.值; }
                    }
                    整64 源类型977 = 解析标识符类型ID(源名977);
                    字符串 源类型文本977 = 字符串复制(驻留文本(源类型977));
                    布尔 内联结构977 = 查结构体大小(源类型977) > 0 &&
                                       !是用户类(源类型文本977) &&
                                       !是容器类(源类型文本977);
                    如果 (源槽977 > 0 && 内联结构977) {
                        // ②内联结构体=先物化副本再清零源（096 模型）
                        整64 大小977 = 查结构体大小(源类型977);
                        整64 槽数977 = (大小977 + 7) / 8;
                        整64 副槽起977 = 槽计数[0];
                        槽计数[0] = 槽计数[0] + 槽数977;
                        整64 a977 = 0;
                        当 (a977 < 槽数977) {
                            IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0,
                                                 副槽起977 + a977));
                            a977++;
                        }
                        整64 副基址977 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_取地址, 副槽起977 + 槽数977 - 1,
                                             0, 0, 副基址977, T_整64, 0));
                        整64 源基址977 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_取地址, 源槽977, 0, 0,
                                             源基址977, T_整64, 0));
                        IR追加(指令, 建IR指令(IR_结构体拷贝, 源基址977,
                                             副基址977, 0, 0, 大小977, 0));
                        // 源槽组清零（基槽=最大槽号）
                        整64 零977 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0,
                                             零977, T_整64, 0));
                        整64 z977 = 0;
                        当 (z977 < 槽数977) {
                            IR追加(指令, 建IR指令(IR_存储, 零977, 0, 0, 0, 0,
                                                 源槽977 - 槽数977 + 1 + z977));
                            z977++;
                        }
                        结果<空类型, 整32> 加副977 = 表达式栈.追加(副基址977);
                        如果 (!加副977.正常) { 运行时错误(4); }
                        返回 真;
                    }
                    如果 (源槽977 > 0) {
                        // ①单值句柄槽=直拷+单槽清零
                        整64 零977b = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0,
                                             零977b, T_整64, 0));
                        IR追加(指令, 建IR指令(IR_存储, 零977b, 0, 0, 0, 0,
                                             源槽977));
                    }
                    结果<空类型, 整32> 加转 = 表达式栈.追加(转实参值);
                    如果 (!加转.正常) { 运行时错误(4); }
                }
                返回 真;
            }
        }


    返回 假;
}

// 206-c（波 4·plans/020 第七十二节 §二）：族③ 复制(表达式) 泛型克隆内置展开
//   （n.子终点=语义层 检查复制调用 写入的实参类型 ID；与 转移(x) 显式
//   「复制/移动」双内置，Rust Clone::clone 同构）。按类型分派（栈顶=实参值、
//   其下=被调负符号——与 转移展开 同线性求值序）：
//     ①标量/指针（可平凡复制）=直通（弹被调残留，实参值留栈顶=求值结果，
//       零运行时指令——转移展开同款）；
//     ②字符串=被调符号改写为「字符串复制」（主链弹参+内置路径照常发射
//       __cn_str_copy 落堆独立拥有；返回 假=本次不终结）；
//     ③容器/类=栈顶对象指针入 hold 槽 → NewObject + 拷贝构造(2 实参，源=T&
//       左值地址——宿主 genCopyBuiltin 调用返回形态同款 hold 槽取地址) → 新
//       对象指针压栈（调用方按调用返回接管，独立拥有，零共享）；
//     ④结构体（含结果/可选合成）=栈顶源地址 → 新槽（按结构体大小逐槽分配）→
//       整体拷贝 + 串字段深拷（递归，全局资源字段表设施）→ 槽地址压栈。
//   返回 真=已处理（终结）；假=非复制形态或字符串改写（主链继续）。
// 532-a（D1 行数滚动·纯机械拆分零行为变更·2026-09-21）：生成复制展开 175 行 →
//   主函数（前置可信判定+四路分派）+四路子函数——逻辑逐字迁移注释逐字保留
//   （行号切片+边界断言）；等价红线=新旧 v2p 编译同一改前输入 asm md5 逐字节一致。
//   四路类型互斥（字符串/可平凡标量/容器类/结构体）·② 命中返回 假=主链继续·①③④ 终结。
不安全 函数 生成复制展开字符串改写(向量<整64>& 表达式栈) -> 布尔 {
    结果<空类型, 整32> 改写 = 表达式栈.设置(表达式栈.大小() - 2,
                                             0 - 驻留("字符串复制"));
    如果 (!改写.正常) { 运行时错误(4); }
    返回 假;
}
不安全 函数 生成复制展开标量直通(向量<整64>& 表达式栈) -> 布尔 {
    整64 复值 = 表达式栈.元素(表达式栈.大小() - 1);
    整64 删i = 0;
    当 (删i < 2) {
        结果<空类型, 整32> 删 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删.正常) { 运行时错误(4); }
        删i++;
    }
    结果<空类型, 整32> 加v = 表达式栈.追加(复值);
    如果 (!加v.正常) { 运行时错误(4); }
    返回 真;
}
不安全 函数 生成复制展开容器类(向量<IR指令>& 指令, 整64* 寄存器计数,
                              整64* 槽计数, 向量<整64>& 表达式栈, 字符串 复类型文本) -> 布尔 {
    整64 复obj = 表达式栈.元素(表达式栈.大小() - 1);
    整64 删c = 0;
    当 (删c < 2) {
        结果<空类型, 整32> 删c2 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删c2.正常) { 运行时错误(4); }
        删c++;
    }
    整64 hold槽 = 槽计数[0];
    槽计数[0] = 槽计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, hold槽));
    IR追加(指令, 建IR指令(IR_存储, 复obj, 0, 0, 0, 0, hold槽));
    整64 hold地址 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_取地址, hold槽, 0, 0, hold地址, T_整64, 0));
    整64 新对象 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新对象,
                         容器对象大小(复类型文本), 驻留(复类型文本)));
    IR追加(指令, 建IR指令(IR_调用实参, 新对象, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用实参, hold地址, 0, 0, 0, 1, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                         驻留(方法符号(复类型文本, 合成名基名(复类型文本),
                                复类型文本 + "&"))));
    // 762-a（001 波·值差单环修复）：③ 产物（新对象句柄）补登记 结构体返回
    //   临时们（对齐 ④ 结构体物化的 462-a 登记单一归属）——下标左值写通道
    //   （348-a/761 续回退）按登记尺寸整体写 32B（值 数组[值索引] = 复制(...)
    //   的元素槽=完整符号值；未登记则 8B 句柄直写·值[0].类型 ID=0 实锤）。
    结果<空类型, 整32> 加o = 表达式栈.追加(新对象);
    如果 (!加o.正常) { 运行时错误(4); }
    返回 真;
}
不安全 函数 生成复制展开结构体物化(向量<节点> 池, 节点 n, 整32 位置,
                              映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                              向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数,
                              整64* 槽计数, 向量<整64>& 表达式栈, 字符串 复类型文本) -> 布尔 {
    整64 删s = 0;
    当 (删s < 2) {
    结果<空类型, 整32> 删s2 = 表达式栈.删除(表达式栈.大小() - 1);
    如果 (!删s2.正常) { 运行时错误(4); }
    删s++;
    }
    整64 复结构ID = 查结构体类型(驻留(复类型文本));
    如果 (复结构ID == 0) {
    // 466-a（T70 面⑥·双表不对称根治）：查结构体类型（语法层表·无候选
    //   回退）miss 时用 结构体布局键基（IR 层三级：本模块键基＞直查＞
    //   候选唯一公开）——与 可信判定 查结构体大小 同源（跨模块私有外
    //   泄面=公开强制，语义层已设防）；键基 ID 即布局/字段分桶键。
    复结构ID = 结构体布局键基(驻留(复类型文本));
    }
    如果 (复结构ID == 0) {
    // 未知结构体（合成类型未登记等）——退回常量 0 占位（防御：不产坏 IR）
    结果<空类型, 整32> 加s = 表达式栈.追加(0);
    如果 (!加s.正常) { 运行时错误(4); }
    返回 真;
    }
    整64 复源地址 = 生成左值地址(池, 整32(n.子起点) + 1, 位置, 局部槽, 参数槽,
                            指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    整64 复结构大小 = 查结构体大小(复结构ID);
    整64 复槽数 = (复结构大小 + 7) / 8;
    如果 (复槽数 <= 0) { 复槽数 = 1; }
    整64 复槽起 = 槽计数[0];
    槽计数[0] = 槽计数[0] + 复槽数;
    整64 复z = 0;
    当 (复z < 复槽数) {
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 复槽起 + 复z));
    复z++;
    }
    整64 复新基址 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_取地址, 复槽起 + 复槽数 - 1, 0, 0, 复新基址, T_整64, 0));
    发射复制结构体深拷(指令, 寄存器计数, 复新基址, 复源地址, 复结构ID, 0);
    // 462-a（T70 面②根治）：④ 分支物化基址补登记 结构体返回临时们——与 生成调用
    //   返回结构体物化登记（1152·82-a/85-a 链）同款单一归属；漏登记后果=348-a
    //   D11 整体写通道（下标/成员/赋值位）查源 miss→「右值（调用返回）非结构体
    //   返回值」误诊断（撤守卫态容器克隆体 `数据[i] = 复制(...)` 实证）。
    结果<空类型, 整32> 设临r = 结构体返回临时们.设置(复新基址, 复结构ID);
    如果 (!设临r.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加s2 = 表达式栈.追加(复新基址);
    如果 (!加s2.正常) { 运行时错误(4); }
    返回 真;
}

不安全 函数 生成复制展开(向量<节点> 池, 节点 n, 整32 位置, 映射<整64, 整64>& 局部槽,
                 映射<整64, 整64>& 参数槽, 向量<IR指令>& 指令, 整64* 寄存器计数,
                 整64* 块计数, 整64* 槽计数,
                 向量<整64>& 表达式栈) -> 布尔 {
    如果 (!(n.子起点 > 0 && n.附加 == 1)) { 返回 假; }
    节点 复被调 = 池.元素(整32(n.子起点));
    如果 (复被调.类型 != 节点_标识符) { 返回 假; }
    如果 (!字符串比较(驻留文本(整64(复被调.文本)), "复制")) { 返回 假; }    如果 (表达式栈.大小() < 2) { 返回 假; }
    // 432-b：子终点=0（语义回填失败置零）不再 early-return——落入下方实参推导兜底
    字符串 复类型文本 = "";
    如果 (n.子终点 > 0) {
        复类型文本 = 字符串复制(驻留文本(整64(n.子终点)));
    }
    // 432-b 根治：子终点 语义标注**仅在成功时回填类型文本 ID**；未成功（基类
    //   泛型实参 K/V/T 不可解析）保持 调用节点原值=参数段末**池索引**——读出
    //   驻留文本=无关垃圾。判据改为「类型可信」：文本须命中任一分派族
    //   （标量/字符串/容器/结构体），否则一律走实参推导兜底。
    布尔 复类型可信d = 假;
    如果 (字符串长度(复类型文本) > 0) {
        复类型可信d = 可平凡复制v2(复类型文本) || 字符串比较(复类型文本, "字符串") ||
                    是容器类(复类型文本) ||
                    查结构体大小(整64(驻留(复类型文本))) != 0;
    }
    // 466-a（T70 面⑥·窄域剥层·前移至可信判定前）：标注/推导文本引用尾 '&'
    //   （方法形参类型标注形态）——不剥则 可信判定 查结构体大小 对 "货舱依赖&"
    //   形态 miss→误走推导；④ 查结构体类型 同 miss→防御 0 无物化登记→
    //   348-a 查源=0 误诊（fix_p 货舱依赖/符号 克隆体实证）。仅本函数局部。
    {
        整64 复长466 = 字符串长度(复类型文本);
        当 (复长466 > 1 && ((整64(复类型文本[整32(复长466 - 1)]) & 255) == 38)) {
            复类型文本 = 字符串子串(复类型文本, 0, 整32(复长466 - 1));
            复长466--;
        }
    }
    如果 (!复类型可信d) {
        复类型文本 = "";
        // 432-b（撤守卫·克隆体）：语义标注发生在实例化前的基类体（泛型实参
        //   K/V 不可解析→子终点=0 未标注）——实参表达式类型推导兜底：
        //   下标实参（其他.键数组[i]）先推导成员链父类型再剥指针层；其余直推。
        节点 复实参 = 池.元素(整32(n.子起点) + 1);
        整64 复类型推导 = 0;
        如果 (复实参.类型 == 节点_下标 && 复实参.子起点 > 0) {
            // 462-a（T70 面②深化）：下标实参元素类型统一走 97-a 推导下标元素
            //   类型ID（数组/指针变量/成员链指针对象三形态+432-b 剥 * 兜底）——
            //   原对整段做成员链推导漏下标剥层（容器克隆体 `复制(其他.数据[i])`
            //   实证：推导得容器类型 向量$外盒 ≠ 元素 外盒→③ 容器分支错入）。
            复类型推导 = 推导下标元素类型ID(池, 整32(复实参.子起点));
            字符串 父文本d = 字符串复制(驻留文本(复类型推导));
            整64 父长d = 字符串长度(父文本d);
            如果 (父长d > 0 && ((整64(父文本d[整32(父长d - 1)]) & 255) == 42)) {
                复类型推导 = 整64(驻留(字符串子串(父文本d, 0, 整32(父长d - 1))));
            }
        } 否则 {
            // 462-a（T70 面②深化②）：实参=顺序链（根+后缀连续节点）——类型推导
            //   须传**链尾**（递归出口=全链类型）；原传段根（n.子起点+1）只推得
            //   根类型（克隆体 `复制(其他.数据[i])` 实证：根=形参 向量$外盒 ≠
            //   元素 外盒→③ 容器分支错入）。防御：子终点 双语义（未标注=段末
            //   池索引；已标注=类型文本 ID）——段末须在 (子起点, 池大小) 域内，
            //   越域回退链根（保守=原行为零回归）。
            // 466-a（T70 面⑥·锚修正）：链尾=位置-1（调用节点池索引恒可靠）
            //   ——原 n.子终点-1 在语义标注态=类型文本 ID-1（池内无关位置·
            //   推导出容器根类型实证）；实参链=[子起点+1, 位置) 恒成立。
            整64 段末d = 位置 - 1;
            如果 (段末d > n.子起点 && 段末d < 整64(池.大小())) {
                复类型推导 = 推导成员链类型ID(池, 整32(段末d));
            } 否则 {
                复类型推导 = 推导成员链类型ID(池, 整32(n.子起点) + 1);
            }
        }
        如果 (复类型推导 > 0) {
            复类型文本 = 字符串复制(驻留文本(复类型推导));
        }
    }
    如果 (字符串长度(复类型文本) == 0) {        返回 假;
    }
    // ② 字符串：被调符号改写为 字符串复制（主链弹参+内置路径完成 __cn_str_copy）
    // 854 LUE（任务 054 波1·〔基准=019〕第四句 (a)）：语义层判定标记（实参节点
    //   .修饰=1=纯局部标识符+后向无读点）→ move 发射：源槽句柄直取压栈+源槽
    //   清零——族②③④的深拷全部跳过（析构归新持有者·值语义无观察差异）。
    //   槽不可解析（静态等）时该函数返回假保守回退主链（深拷照旧）。
    节点 复LUE实参 = 池.元素(整32(n.子起点) + 1);
    // 857 限面 → 078（934·008 总攻第二轮）解除：字符串/容器=单句柄搬迁
    //   （生成复制展开LUEmove）；结构体（族④·多槽内嵌对象）=整块搬迁+源槽
    //   全清零（生成复制展开结构体LUEmove·含拥有字段句柄直移=所有权交接）。
    //   结构体 ID 解析 miss（含 466-a 键基回退）返回假=保守回退 ④ 深拷。
    如果 (复LUE实参.类型 == 节点_标识符 && 复LUE实参.修饰 == 1 &&
          (字符串比较(复类型文本, "字符串") || 是容器类(复类型文本))) {
        返回 生成复制展开LUEmove(池, n, 位置, 局部槽, 参数槽, 指令, 寄存器计数,
                              块计数, 槽计数, 表达式栈);
    }
    如果 (复LUE实参.类型 == 节点_标识符 && 复LUE实参.修饰 == 1 &&
          查结构体大小(驻留(复类型文本)) != 0) {
        返回 生成复制展开结构体LUEmove(池, n, 位置, 局部槽, 参数槽, 指令,
                                   寄存器计数, 块计数, 槽计数, 表达式栈,
                                   复类型文本);
    }
    // ② 字符串：被调符号改写为 字符串复制（主链弹参+内置路径完成 __cn_str_copy）
    如果 (字符串比较(复类型文本, "字符串")) { 返回 生成复制展开字符串改写(表达式栈); }
    // ① 标量/指针：直通（值语义天然，零运行时指令）
    // 496-a（T70 B1·可平凡结构体不走直通）：① 直通的 复值=下标读值（非元素
    //   地址）——结构体形态（查结构体大小≠0）登记值当地址=整体拷贝读垃圾
    //   （124 首版产物 rc=102 实证）→结构体排除出直通、落 ④ 物化+登记（与
    //   Token 同路径·复制语义完整·基类型直通零影响）。
    如果 (可平凡复制v2(复类型文本) && 查结构体大小(驻留(复类型文本)) == 0) { 返回 生成复制展开标量直通(表达式栈); }
    // ③ 容器/类：栈顶对象指针 → hold 槽取地址 → NewObject + 拷贝构造
    如果 (是容器类(复类型文本)) { 返回 生成复制展开容器类(指令, 寄存器计数, 槽计数, 表达式栈, 复类型文本); }
    // ④ 结构体（含结果/可选合成）：实参左值地址 → 新槽 → 整体拷贝+串字段深拷。
    //   ★实参地址重新求值（v2 表达式位结构体标识符求值压首槽值=既有第一版
    //   边界；左值地址设施 生成左值地址 按实参区间 [子起点+1, 调用位置) 发射
    //   ——stdlib 拷贝构造切换全需求=place 形态标识符/成员/下标）。
    返回 生成复制展开结构体物化(池, n, 位置, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈, 复类型文本);
}

// 854 LUE move 发射（任务 054 波1·〔基准=019〕第四句 (a)）：x=纯局部标识符
//   （语义层已判定「池后向无读点」=最后使用）——句柄直取（源槽值压栈）+
//   源槽清零（move 语义：析构归新持有者·源槽空→出口析构跳过·NRVO 同构）。
//   槽解析序=局部槽→参数槽（与 生成左值地址 标识符分支同序）；解析不到
//   （静态 .data 等无槽形态）返回假=保守回退主链深拷（不消除）。
不安全 函数 生成复制展开LUEmove(向量<节点> 池, 节点 n, 整32 位置,
                        映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                        向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数,
                        整64* 槽计数, 向量<整64>& 表达式栈) -> 布尔 {
    节点 转被调节点986 = 池.元素(整32(n.子起点));
    节点 转实参986 = 池.元素(整32(n.子起点) + 1);
    // 986 成员源（008 挂账②·宿主 959 同款三指令语义）：成员值已由表达式
    //   求值 Load 压栈（=转移值）——补**成员槽清零**（所有权交接·接收方
    //   出口对零句柄空安全跳过幂等模型）；地址=生成左值地址 重生成（多一次
    //   Load 无害·正确性优先）。编译期成员旧名拦截=诚实边界随 LUE 精确化。
    布尔 成员源g987 = 假;
    如果 (转被调节点986.类型 == 节点_标识符 &&
         字符串比较(驻留文本(整64(转被调节点986.文本)), "转移")) {
        如果 (转实参986.类型 == 节点_成员) {
            成员源g987 = 真;
        } 否则 如果 (转实参986.类型 == 节点_标识符 &&
                    整32(n.子起点) + 2 < 整32(池.大小())) {
            节点 后继g987 = 池.元素(整32(n.子起点) + 2);
            如果 (后继g987.类型 == 节点_成员 && 后继g987.子起点 == 整32(n.子起点) + 1) {
                成员源g987 = 真;
            }
        }
    }
    如果 (成员源g987) {
        整64 成员地址986 = 生成左值地址(池, 整32(n.子起点) + 1,
            整32(n.子起点) + 3, 局部槽, 参数槽, 指令, 寄存器计数,
            块计数, 槽计数, 表达式栈);
        整64 零986 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零986, T_整64, 0));
        IR追加(指令, 建IR指令(IR_指针存储, 成员地址986, 零986, 0, 0, T_整64, 0));
        整64 删m986 = 0;
        当 (删m986 < 2) {
            结果<空类型, 整32> 删栈986 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈986.正常) { 运行时错误(4); }
            删m986++;
        }
        返回 真;
    }
    节点 x节点 = 池.元素(整32(n.子起点) + 1);
    整64 xID = 整64(x节点.文本);
    整64 源槽 = 0;
    结果<整64, 整32> 查局L = 局部槽.获取(xID);
    如果 (查局L.正常) {
        源槽 = 查局L.值;
    } 否则 {
        结果<整64, 整32> 查参L = 参数槽.获取(xID);
        如果 (查参L.正常) {
            源槽 = 查参L.值;
        } 否则 {
            返回 假;
        }
    }
    整64 move值 = 表达式栈.元素(表达式栈.大小() - 1);
    // 净栈契约对齐族③：弹 2（被调残留+实参值）再压 1（move 结果）
    整64 删m = 0;
    当 (删m < 2) {
        结果<空类型, 整32> 删m2 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删m2.正常) { 运行时错误(4); }
        删m++;
    }
    // 854 修正（asm 实证）：IR_存储 操作数1=0 会被代码生成当「槽 0」读
    //   （`mov rax,[rbp-8]`·未初始化垃圾→出口析构 free(垃圾)=0xC0000374）——
    //   清零须走 IR_常量整数（Symbol "0"→立即数）+ IR_存储 寄存器。
    整64 零寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零寄存器, T_整64, 0));
    IR追加(指令, 建IR指令(IR_存储, 零寄存器, 0, 0, 0, 0, 源槽));
    结果<空类型, 整32> 加m = 表达式栈.追加(move值);
    如果 (!加m.正常) { 运行时错误(4); }
    返回 真;
}

// 078（934·008 总攻第二轮·857 限面解除）：结构体 LUE move——整块搬迁零拷贝：
//   复槽分配 + IR_结构体拷贝 整块位拷（拥有字段句柄直移=所有权交接·跳过
//   字段级深拷——LUE 前提=源在拷贝后不再使用·无别名无需深拷）+ 源槽全清零
//   （逐槽 IR_常量整数 0 → IR_存储——854 修正口径：操作数直接 0 会被代码
//   生成当「槽 0」读）+ 压栈复槽基址（净栈契约 弹 2 压 1·462-a 结构体返回
//   临时们 登记同 ④ 物化）。源槽地址=源槽起+槽数-1（82-a 基址槽纪律）。
//   槽不可解析（静态等）/结构体 ID miss（含 466-a 键基回退）返回假=保守
//   回退 ④ 深拷路径（不消除）。
不安全 函数 生成复制展开结构体LUEmove(向量<节点> 池, 节点 n, 整32 位置,
                        映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                        向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数,
                        整64* 槽计数, 向量<整64>& 表达式栈, 字符串 复类型文本) -> 布尔 {
    节点 x节点 = 池.元素(整32(n.子起点) + 1);
    整64 xID = 整64(x节点.文本);
    整64 源槽 = 0;
    结果<整64, 整32> 查局78 = 局部槽.获取(xID);
    如果 (查局78.正常) {
        源槽 = 查局78.值;
    } 否则 {
        结果<整64, 整32> 查参78 = 参数槽.获取(xID);
        如果 (查参78.正常) {
            源槽 = 查参78.值;
        } 否则 {
            返回 假;
        }
    }
    整64 结构ID78 = 查结构体类型(驻留(复类型文本));
    如果 (结构ID78 == 0) {
        结构ID78 = 结构体布局键基(驻留(复类型文本));
    }
    如果 (结构ID78 == 0) { 返回 假; }
    整64 结构大小78 = 查结构体大小(结构ID78);
    如果 (结构大小78 <= 0) { 返回 假; }
    整64 复槽数78 = (结构大小78 + 7) / 8;
    整64 复槽起78 = 槽计数[0];
    槽计数[0] = 槽计数[0] + 复槽数78;
    整64 复a78 = 0;
    当 (复a78 < 复槽数78) {
        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 复槽起78 + 复a78));
        复a78++;
    }
    整64 复新基址78 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_取地址, 复槽起78 + 复槽数78 - 1, 0, 0, 复新基址78, T_整64, 0));
    // 源基址：局部槽/参数槽 登记的是**基槽=最大槽号（低地址）**（913-a 口径：
    //   「局部槽.设置(名, 槽起+槽数-1)」）——基槽即结构体首字节，直接取地址；
    //   槽组区间=[基槽-槽数+1, 基槽]。
    整64 源基址78 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_取地址, 源槽, 0, 0, 源基址78, T_整64, 0));
    // 整块位拷贝（源读在清零前——防自拷中间态）
    IR追加(指令, 建IR指令(IR_结构体拷贝, 源基址78, 复新基址78, 0, 0, 结构大小78, 0));
    // 源槽全清零（854 修正口径）
    整64 零寄78 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零寄78, T_整64, 0));
    整64 清z78 = 0;
    当 (清z78 < 复槽数78) {
        IR追加(指令, 建IR指令(IR_存储, 零寄78, 0, 0, 0, 0, 源槽 - 复槽数78 + 1 + 清z78));
        清z78++;
    }
    // 净栈契约：弹 2（被调残留+实参值）再压 1（复新基址）
    整64 删s78 = 0;
    当 (删s78 < 2) {
        结果<空类型, 整32> 删s782 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删s782.正常) { 运行时错误(4); }
        删s78++;
    }
    结果<空类型, 整32> 设临78 = 结构体返回临时们.设置(复新基址78, 结构ID78);
    如果 (!设临78.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加基78 = 表达式栈.追加(复新基址78);
    如果 (!加基78.正常) { 运行时错误(4); }
    返回 真;
}

// 206-c：结构体深拷发射（复制 分派④/字段递归共用）——整体拷贝(memcpy) +
//   资源字段逐个深拷：字符串字段=__cn_str_copy 落堆独立（源保持拥有）；
//   嵌套含资源字段结构体（值语义内联）=递归；容器字段=NewObject+拷贝构造
//   （独立对象）；纯标量字段=memcpy 已覆盖。深度上限 4 防环（与 IR容器释放
//   资源字段设施同款）。全局资源字段表设施（取资源字段们）——不依赖函数IR。
不安全 函数 发射复制结构体深拷(向量<IR指令>& 指令, 整64* 寄存器计数,
                     整64 目标基址, 整64 源基址, 整64 结构体ID, 整64 深度) -> 空类型 {
    如果 (深度 > 4) { 返回; }
    IR追加(指令, 建IR指令(IR_结构体拷贝, 源基址, 目标基址, 0, 0,
                         查结构体大小(结构体ID), 0));
    向量<整64> 字段们 = 向量<整64>();
    取资源字段们(结构体ID, 字段们);
    整64 f = 字段们.大小();
    当 (f > 0) {
        f -= 3;
        整64 字段类型ID = 字段们.元素(f + 1);
        整64 偏移 = 字段们.元素(f + 2);
        字符串 字段类型文本 = 字符串复制(驻留文本(字段类型ID));
        如果 (字符串比较(字段类型文本, "字符串")) {
            整64 源地址c = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_字段地址, 源基址, 0, 0, 源地址c, T_整64, 偏移));
            整64 源串 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 源地址c, 0, 0, 源串, T_字符串, 0));
            整64 新串 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_调用实参, 源串, 0, 0, 0, 0, 0));
            IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 新串, 0,
                                 驻留("__cn_str_copy")));
            整64 目标地址c = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_字段地址, 目标基址, 0, 0, 目标地址c, T_整64, 偏移));
            IR追加(指令, 建IR指令(IR_指针存储, 目标地址c, 新串, 0, 0, T_整64, 0));
        } 否则 如果 (资源字段数(字段类型ID) > 0) {
            整64 源地址n = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_字段地址, 源基址, 0, 0, 源地址n, T_整64, 偏移));
            整64 目标地址n = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_字段地址, 目标基址, 0, 0, 目标地址n, T_整64, 偏移));
            发射复制结构体深拷(指令, 寄存器计数, 目标地址n, 源地址n,
                            字段类型ID, 深度 + 1);
        } 否则 如果 (是容器类(字段类型文本)) {
            整64 源地址k = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_字段地址, 源基址, 0, 0, 源地址k, T_整64, 偏移));
            整64 源obj = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 源地址k, 0, 0, 源obj, T_对象, 0));
            整64 新对象k = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新对象k,
                                 容器对象大小(字段类型文本), 字段类型ID));
            IR追加(指令, 建IR指令(IR_调用实参, 新对象k, 0, 0, 0, 0, 0));
            IR追加(指令, 建IR指令(IR_调用实参, 源地址k, 0, 0, 0, 1, 0));
            IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                                 驻留(方法符号(字段类型文本, 合成名基名(字段类型文本),
                                        字段类型文本 + "&"))));
            整64 目标地址k = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_字段地址, 目标基址, 0, 0, 目标地址k, T_整64, 偏移));
            IR追加(指令, 建IR指令(IR_指针存储, 目标地址k, 新对象k, 0, 0, T_整64, 0));
        }
    }
}

// 212-a：族② 类型大小(类型名) 编译期折叠（规格 02-六B，宿主 A-3 SizeofExpr 同义）——
//   弹 2 个压栈残留（根治栈底残留）+常量压栈。返回 1=已处理；0=未知类型中止；
//   -1=非折叠形态（主函数继续原链）。
不安全 函数 生成类型大小折叠(向量<节点> 池, 节点 n, 整32 位置, 向量<IR指令>& 指令, 整64* 寄存器计数,
                     向量<整64>& 表达式栈, 整32& 结果r) -> 布尔 {
        如果 (n.子起点 > 0 && n.附加 == 1) {
            节点 折叠被调 = 池.元素(整32(n.子起点));
            节点 折叠实参 = 池.元素(整32(n.子起点) + 1);
            // 967（002·57 转批）：数组类型名实参（类型大小(整64[5])）——AST=
            //   下标节点（区间后缀序=[类型名标识符, 长度字面量]·下标节点自身
            //   在区间后）：宽度=类型名宽度(基名)×长度（对齐宿主编译期求值；
            //   原只认标识符形态→下标通道运行期越界 错误码2）。指针类型名实参
            //   （类型大小(整32*)）= 标识符+剥尾 '*' 文本（解析层实参位类型
            //   记号保留星号）→ 8。
            如果 (折叠被调.类型 == 节点_标识符 && 折叠实参.类型 == 节点_标识符 &&
                 字符串比较(驻留文本(整64(折叠被调.文本)), "类型大小")) {
                // 967：宽度=类型名宽度（数组文本「整64[5]」经数组分支=元素宽×
                //   长度；语义层已把下标形实参改写为标识符文本）
                整64 宽度 = 类型名宽度(整64(折叠实参.文本));
                如果 (宽度 == 0) {                    IR层诊断("类型大小: 未知类型 " +
                                  驻留文本(整64(折叠实参.文本)) +
                                  " 节点类型=" + 整数转字符串(整64(折叠实参.类型)) +
                                  " [宿主=" + 驻留文本(取当前生成符号ID()) + "]");
                    结果r = 0;   // IR 层错误即中止纪律：诊断计数后继续收集，主.cn 统一中止
                返回 真;
                }
                整64 折叠i = 0;
                // 弹 2 个压栈残留：实参（类型名负符号）+ 被调（类型大小 负符号）
                //   ——根治栈底残留（原只弹 1 个，靠相对栈顶侥幸无害）
                当 (折叠i < 2 && 表达式栈.大小() > 0) {
                    结果<空类型, 整32> 删折 = 表达式栈.删除(表达式栈.大小() - 1);
                    如果 (!删折.正常) { 运行时错误(4); }
                    折叠i++;
                }
                整64 常量寄存器 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                // IR_常量整数 操作数1=值文本驻留ID（P7a 语义：代码生成经
                //   驻留文本 还原立即数）——宽度须先转文本再驻留
                IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(宽度)), 0, 0,
                                     常量寄存器, T_整64, 0));
                结果<空类型, 整32> 加折 = 表达式栈.追加(常量寄存器);
                如果 (!加折.正常) { 运行时错误(4); }
                结果r = 1;
                返回 真;
            }
        }



    返回 假;
}

// 方法调用发射（被调=方法标记，标记下压着 this）：容器类签名命中→retbuf/标量
//   分派+结构体按值实参回扫取地址（B3/B8）+类型登记；未收录/对象未知=诊断终止。
不安全 函数 生成方法调用(向量<节点> 池, 节点 n, 整32 位置, 整64 被调, 向量<整64>& 弹出们,
                 整64 实参数, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                 向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数,
                 向量<整64>& 表达式栈,
                 整64 retbuf序号) -> 空类型 {
            整64 方法名ID = 0 - 被调 - 1000000;
            整64 this寄存器 = 0;
            如果 (表达式栈.大小() >= 1) {
                this寄存器 = 表达式栈.元素(表达式栈.大小() - 1);
                结果<空类型, 整32> 删this = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删this.正常) { 运行时错误(4); }
            }
            字符串 方法名文本 = 字符串复制(驻留文本(方法名ID));
            // 070 波G（1026）：类名.静态方法() 调用——对象=用户类名（非变量遮
            //   蔽）+类静态方法表命中 → 直调（无 this·实参位0 起·符号=类$方法
            //   [#参数串]·宿主 P3-23 静态形态 ABI）；对象求值的负占位丢弃。
            {
                节点 成员st = 池.元素(整32(n.子起点));
                如果 (成员st.类型 == 节点_成员 && 成员st.子起点 > 0) {
                    节点 对象st = 池.元素(整32(成员st.子起点));
                    如果 (对象st.类型 == 节点_标识符 && 是用户类_ID(整64(对象st.文本)) &&
                         是类静态方法(整64(对象st.文本), 方法名ID)) {
                        整64 参数串IDst = 查类方法参数串(整64(对象st.文本), 方法名ID);
                        字符串 参数串st = "";
                        如果 (参数串IDst != 0) { 参数串st = 字符串复制(驻留文本(参数串IDst)); }
                        字符串 方法符号st = 方法符号(字符串复制(驻留文本(整64(对象st.文本))),
                                                  方法名文本, 参数串st);
                        如果 (表达式栈.大小() >= 1) {
                            结果<空类型, 整32> 删负st = 表达式栈.删除(表达式栈.大小() - 1);
                            如果 (!删负st.正常) { 运行时错误(4); }
                        }
                        发射调用实参们(弹出们, 0, 指令, 实参类型码们(弹出们));
                        整64 返回寄存器st = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        整64 返回码st = 0;
                        整64 返回类型IDst = 查类方法返回(整64(对象st.文本), 方法名ID);
                        如果 (返回类型IDst > 0) { 返回码st = 类型码(返回类型IDst); }
                        IR追加(指令, 建IR指令(IR_调用参数化, 弹出们.大小(), 返回码st, 0,
                                             返回寄存器st, retbuf序号, 驻留(方法符号st)));
                        如果 (返回码st != T_未知 && 返回码st != T_空类型) {
                            登记寄存器类型(返回寄存器st, 返回码st);
                        }
                        结果<空类型, 整32> 加st = 表达式栈.追加(返回寄存器st);
                        如果 (!加st.正常) { 运行时错误(4); }
                        返回;
                    }
                }
            }
            字符串 类名 = "";
            // ②c A/B：对象类型统一解析（标识符：容器变量/结构体容器字段；
            //   调用：返回容器/返回结构体的容器字段——元素(0).设置/b.表.追加）
            整64 对象类ID2 = 解析方法对象类型扩展(池, 位置);
            如果 (对象类ID2 != 0) {
                类名 = 字符串复制(驻留文本(对象类ID2));
            }
            如果 (是容器类(类名)) {
                方法签名 签;
                如果 (查方法签名(类名, 方法名文本, 实参数, &签)) {
                    // 790-a（052 甲波2/3·元素可变方法写穿〔基准=019〕·127_v2 断言
                    //   206 根治）：「容器.元素(i)」链式作**可变方法**接收者
                    //   （层表.元素(0).设置(k,v)）——元素 求值的 retbuf 物化+深拷
                    //   副本（650-a 读侧值语义）使 设置 写在副本上丢弃=静默丢失
                    //   （127_v2 获取(2) 未命中 rc=206 实锤）。前瞻池序列（后缀链
                    //   布局：本调用(位置)→[+1]=成员(子起点==位置·方法形态标记)
                    //   →[+2]=调用(子起点==位置+1)）且成员名∈可变方法清单 →
                    //   元素 走**地址直通**：不发射 元素 调用，直接产元素槽地址
                    //   （数据基址+下标×元素字节·内联元素模型与 stdlib 数据[i]
                    //   步进同源）→可变方法写穿原容器（Swift 下标 set 同构·
                    //   零拷贝·与 056 甲 COW/in-out 同向）。前瞻未命中=读场景
                    //   保持 650-a 副本语义（字节级不变）。
                    如果 (字符串比较(方法名文本, "元素") && 实参数 == 1 && 位置 + 2 < 整32(池.大小())) {
                        节点 后成员n790 = 池.元素(位置 + 1);
                        // 790-a 池布局=[根,成员,实参...,调用]（466-a 同源）——
                        //   调用节点在实参之后：从 位置+2 扫描首个 节点_调用 且
                        //   子起点==位置+1（被调=该成员·462 参数起点-1 同位）。
                        节点 后调用n790 = 后成员n790;
                        布尔 可变后继790 = 假;
                        如果 (后成员n790.类型 == 节点_成员) {
                            如果 (后成员n790.附加 == 成员方法标记) {
                                如果 (后成员n790.子起点 == 位置) {
                                    整32 扫描k790 = 位置 + 2;
                                    当 (扫描k790 < 整32(池.大小()) && 扫描k790 <= 位置 + 12) {
                                        节点 扫描n790 = 池.元素(扫描k790);
                                        如果 (扫描n790.类型 == 节点_调用) {
                                            如果 (扫描n790.子起点 == 位置 + 1) {
                                                后调用n790 = 扫描n790;
                                                可变后继790 = 真;
                                            }
                                            中断;
                                        }
                                        扫描k790++;
                                    }
                                }
                            }
                        }
                        如果 (可变后继790) {
                            字符串 后方法名790 = 字符串复制(驻留文本(整64(后成员n790.文本)));
                            布尔 是可变790 = 字符串比较(后方法名790, "设置") ||
                                字符串比较(后方法名790, "删除") ||
                                字符串比较(后方法名790, "清空") ||
                                字符串比较(后方法名790, "插入") ||
                                字符串比较(后方法名790, "弹出");
                            如果 (是可变790) {
                                整64 返回结构ID790 = 驻留(签.返回文本);
                                整64 元素字节790 = 查结构体大小(返回结构ID790);
                                如果 (元素字节790 > 0) {
                                    整64 下标值790 = 弹出们.元素(0);
                                    整64 数据槽790 = 寄存器计数[0];
                                    寄存器计数[0] = 寄存器计数[0] + 1;
                                    IR追加(指令, 建IR指令(IR_字段地址, this寄存器, 0, 0,
                                                         数据槽790, T_整64, 0));
                                    整64 数据基址790 = 寄存器计数[0];
                                    寄存器计数[0] = 寄存器计数[0] + 1;
                                    IR追加(指令, 建IR指令(IR_指针加载, 数据槽790, 0, 0,
                                                         数据基址790, T_整64, 0));
                                    整64 元素槽790 = 数据基址790;
                                    如果 (元素字节790 != 1) {
                                        整64 步进常量790 = 寄存器计数[0];
                                        寄存器计数[0] = 寄存器计数[0] + 1;
                                        IR追加(指令, 建IR指令(IR_常量整数,
                                             整64(驻留(整数转字符串(元素字节790))), 0, 0,
                                             步进常量790, T_整64, 0));
                                        整64 缩放790 = 寄存器计数[0];
                                        寄存器计数[0] = 寄存器计数[0] + 1;
                                        IR追加(指令, 建IR指令(IR_乘, 下标值790, 步进常量790,
                                                             0, 缩放790, T_整64, 0));
                                        整64 加法790 = 寄存器计数[0];
                                        寄存器计数[0] = 寄存器计数[0] + 1;
                                        IR追加(指令, 建IR指令(IR_加, 数据基址790, 缩放790,
                                                             0, 加法790, T_整64, 0));
                                        元素槽790 = 加法790;
                                    }
                                    登记寄存器类型(元素槽790, T_对象);
                                    结果<空类型, 整32> 加槽790 = 表达式栈.追加(元素槽790);
                                    如果 (!加槽790.正常) { 运行时错误(4); }
                                    返回;
                                }
                            }
                        }
                    }
                    // ②b B6：retbuf 按真实返回字节数定帧——累计本函数最大值
                    整64 retbuf字节 = 签名返回字节数(&签);
                    累计retbuf字节数(retbuf字节);
                    整64 符号ID = 驻留(方法符号(类名, 方法名文本, 签.参数串));
                    整64 retbuf = 0;
                    整64 目标寄存器 = 0;
                    整64 实参起始位 = 1;
                    如果 (签.返回形态 == 容器返回_结果空 || 签.返回形态 == 容器返回_结果值 ||
                         签.返回形态 == 容器返回_结构体) {
                        retbuf = retbuf序号;
                        实参起始位 = 2;   // 位0=retbuf、位1=this、实参从位2
                        目标寄存器 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                    } 否则 如果 (签.返回形态 == 容器返回_标量) {
                        目标寄存器 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                    }
                    // 74-a（2026-09-11 第七十四轮）：入容器位所有权归一化——
                    //   容器析构会释放元素串（容器拥有元素所有权），故入容器必须
                    //   由编译器接管所有权（宿主 buildCallArgsForMethod 同款）。
                    //   **时序**：须在 this 的 IR_调用实参 之前发射——代码生成的调用
                    //   展开是「收集 IR_调用实参，遇 IR_调用参数化 统一展开」，若
                    //   在 this/实参声明之后插入独立调用，其 IR_调用参数化 会把
                    //   已收集实参一并展开（位数错乱）。
                    // 81-a（2026-09-12 第八十一轮）：79-a 的
                    //   标记入容器结构体污染 整链删除——元素槽字段串由 stdlib
                    //   容器方法体的 `数据[n] = 值` 结构体写入深拷独立拥有，源结构体
                    //   照常拥有并释放（该标记原使源字段串跳过释放=每元素泄漏 2，
                    //   实测 P2/P3 实证；容器消亡/移除路径的释放面由宿主编译 stdlib
                    //   时注入的 ~容器/清空/删除 方法体承担）。
                    归一化入容器实参(池, n, 位置, 类名, 方法名文本, 弹出们,
                                     局部槽, 参数槽, 指令, 寄存器计数);
                    IR追加(指令, 建IR指令(IR_调用实参, this寄存器, 0, 0, 0, 实参起始位 - 1, 0));
                    // ②b B3（2026-09-02）：结构体按值实参 -> 传地址（宿主 ABI：
                    //   调用方传指针、被调方拷贝入参/元素存储）。裸标识符实参的
                    //   值装载（IR_加载）回扫取槽改发 IR_取地址（B8 抽出共用辅助）。
                    整64 实i = 0;
                    当 (实i < 弹出们.大小()) {
                        字符串 段文本 = 取参数段(签.参数串, 实i);
                        // 595-a 立案（001-001 残余·容器方法第三回扫源）：此处
                        //   按 签.参数串 段 查结构体大小 判取地址——撤守卫态容器
                        //   实参段命中 → 取地址传栈槽、被调方 fix5 单槽当句柄 →
                        //   元素槽伪对象。直改（!是容器类 排除）触发 v2p 自身
                        //   编译期运行时错误 1024（机制待独立定性）——本点撤守卫
                        //   态容器方法容器实参面=下轮主攻面。
                        // 983（002·57 转批①同族·实参形态）：非结构体大标量
                        //   （整128/正128=16 字节）实参→取地址传——宿主 MSVC ABI
                        //   对 >8 字节 POD 实参一律按引用传（v2p.obj 被调方
                        //   追加$整128 收隐藏指针），v2 旧按值装载→写坏元素槽/
                        //   元素数量丢失（第二次追加丢+首元素错值实证）。
                        如果 (!是容器类(段文本) &&
                             (查结构体大小(驻留(段文本)) != 0 ||
                              类型名宽度(驻留(段文本)) > 8)) {
                            回扫实参取地址(指令, 弹出们, 实i, 寄存器计数, 槽计数);
                        } 否则 如果 (字符串长度(段文本) > 0 &&
                                     ((整64(段文本[整32(字符串长度(段文本) - 1)]) & 255) == 38)) {
                            // 432-b 根治：& 引用实参 → 传左值地址（原缺=引用形参
                            //   传值→被调方把值当地址解引用写崩；123 链查找 前驱
                            //   实测 SIGSEGV r10=-1=前驱初值）
                            回扫实参取地址(指令, 弹出们, 实i, 寄存器计数, 槽计数);
                        }
                        实i++;
                    }
                    发射调用实参们(弹出们, 实参起始位, 指令,
                                  容器实参类型码们(签.参数串, 弹出们));
                    // 91-a：返回类型码（容器返回_标量 按替换后返回类型解析——
                    //   浮点元素返回走 xmm0；retbuf 形态=地址标 0 整型类）
                    整64 容器返回码 = 0;
                    如果 (签.返回形态 == 容器返回_标量) {
                        容器返回码 = 类型码(驻留(签.返回文本));
                    }
                    IR追加(指令, 建IR指令(IR_调用参数化, 实参起始位 + 实参数, 容器返回码, 0,
                                         目标寄存器, retbuf, 符号ID));
                    如果 (目标寄存器 != 0) {
                        // ③ 第二波（方案A）：容器方法标量返回类型登记——签.返回文本
                        //   =替换后返回类型（向量<字符串>.元素(i) -> "字符串"）；
                        //   结果/结构体返回=retbuf 地址不做标量登记（.值/.字段 路径自理）
                        如果 (签.返回形态 == 容器返回_标量) {
                            整64 方法返回码 = 类型码(驻留(签.返回文本));
                            如果 (方法返回码 != T_未知) {
                                登记寄存器类型(目标寄存器, 方法返回码);
                            }
                        } 否则 如果 (签.返回形态 == 容器返回_结构体) {
                            // 983（002·57 转批①登记侧）：大标量值类型（整128/正128）
                            //   走 retbuf 形态后须登记 T_整128/T_正128——值=retbuf
                            //   地址（810「128 位表达式统一形态：右值=地址句柄」同源·
                            //   打印分派 __cn_print_i128 传址消费）；原不登记→查类型
                            //   miss→打印落 __cn_print_int 打出 retbuf 栈地址
                            //   （0x8000160C00 实证）。
                            整64 大标量码983 = 类型码(驻留(签.返回文本));
                            如果 (大标量码983 == T_整128 || 大标量码983 == T_正128) {
                                登记寄存器类型(目标寄存器, 大标量码983);
                            }
                        }
                        // 617-a 波2（001-001·元素读取归一化）：返回 T=**有拷贝构造
                        //   类实例** → 调用点立即拷贝构造副本（分配对象+call 拷贝
                        //   构造·句柄唯一持有者·宿主按值返回拷贝对照）——原句柄
                        //   直传=调用方与容器共享元素→调用方 释放内部数组/写 作用
                        //   别名→双释放/堆损坏（113 弹出 铁证）。纯标量结构体
                        //   （无拷贝构造）不触发=零开销；字符串元素=驻留/串释放
                        //   面自理（②③ 域）不进本分支。
                        如果 (签.返回形态 == 容器返回_标量) {
                            整64 返回实例IDk = 驻留(签.返回文本);
                            整64 拷贝串IDk = 查类拷贝构造串(返回实例IDk);
                            如果 (拷贝串IDk != 0) {
                                整64 新objk = 寄存器计数[0];
                                寄存器计数[0] = 寄存器计数[0] + 1;
                                IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新objk,
                                     查结构体大小(返回实例IDk), 返回实例IDk));
                                IR追加(指令, 建IR指令(IR_调用实参, 新objk, 0, 0, 0, 0, 0));
                                IR追加(指令, 建IR指令(IR_调用实参, 目标寄存器, 0, 0, 0, 1, 0));
                                IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                                     驻留(方法符号(签.返回文本,
                                           剥实例基名(签.返回文本),
                                           字符串复制(驻留文本(拷贝串IDk))))));
                                目标寄存器 = 新objk;
                            }
                        }
                        // 118（929·任务 118）：引用返回方法读值默认 lvalue-to-rvalue
                        //   （签.返回文本 尾 '&'——IR签名 829 起保留后缀）。标量元素
                        //   须 IR_指针加载 读值（原 rax=槽地址直传=地址当值静默错值）；
                        //   聚合 T（容器/结构体内联实宽存储·元素地址即对象本体）直传
                        //   不解引用（宿主 refReturnAggInline 分叉同构——v2p 双重解引用
                        //   崩溃实证映射$..& 步进 56）。写链（赋值目标/绑定）经 生成左值
                        //   地址 的「回扫 IR_指针加载 取操作数1」回取地址=函数路径同构。
                        如果 (签.返回形态 == 容器返回_标量 &&
                             字符串长度(签.返回文本) > 1 &&
                             ((整64(签.返回文本[整32(字符串长度(签.返回文本) - 1)]) & 255) == 38)) {
                            字符串 引用基名z = 字符串子串(签.返回文本, 0,
                                                        字符串长度(签.返回文本) - 1);
                            布尔 聚合直传z = 是容器类(引用基名z) ||
                                查结构体大小(驻留(引用基名z)) != 0;
                            如果 (!聚合直传z) {
                                整64 解引用regz = 寄存器计数[0];
                                寄存器计数[0] = 寄存器计数[0] + 1;
                                // 宽度=元素类型码（整32 元素读 4 字节——原 T_整64
                                //   恒 8 字节跨元素读=高位并相邻元素·v2read1 探针
                                //   元素(0)读 0x200000001 实证）；未知类型回退 8 字节
                                整64 引返回码z = 类型码(驻留(引用基名z));
                                如果 (引返回码z == T_未知 || 引返回码z == T_空类型) {
                                    引返回码z = T_整64;
                                }
                                IR追加(指令, 建IR指令(IR_指针加载, 目标寄存器, 0, 0,
                                                     解引用regz, 引返回码z, 0));
                                登记寄存器类型(解引用regz, 引返回码z);
                                目标寄存器 = 解引用regz;
                            }
                        }
                        整64 压栈reg = 目标寄存器;
                        // 81-a-v2（甲案）：容器方法返回**真结构体** → 同理物化到独立槽
                        如果 (签.返回形态 == 容器返回_结构体) {
                            整64 方法返回结构ID = 驻留(签.返回文本);
                            如果 (查结构体大小(方法返回结构ID) != 0) {
                                整64 物化regm = 物化返回值到独立槽(指令, 寄存器计数, 槽计数,
                                                                  目标寄存器, 方法返回结构ID);
                                如果 (物化regm != 0) {
                                    压栈reg = 物化regm;
                                    // 1013 批八（79_v2 根治·〔基准=019〕第一句「值语义深拷
                                    //   天然无别名」）：容器方法返回**含资源字段结构体**的物化
                                    //   在位拷后原地逐资源字段深拷（读壳内共享句柄→NewObject+
                                    //   拷贝构造→写回槽）＝物化临时独立拥有——调用后 975 实参
                                    //   清理（发射串字段释放顺序→IR_删除对象）释放独立副本。原
                                    //   浅壳与容器元素共享底层（元素() 读侧借用·容器拥有），
                                    //   清理释放共享句柄=**毁源**（t1 复现：op62 delete 容器元素
                                    //   v 对象；79_v2 fix_s 数据段 2 定义/1347 EXTERN·发射循环
                                    //   2484 次毁尽全树函数 IR）。仅挂本调用点（容器方法返回）：
                                    //   普通函数返回（物化结构体返回值 路径）由 85-a 返回侧深拷
                                    //   管辖，此处再深拷=双重深拷（230/234/236/240/242/243/244
                                    //   校验位面回归实录）。原地（目标=源=物化槽基址）读写同槽
                                    //   时序安全。上游缺口（立后续专项）：是容器类 对尖括号形态
                                    //   （"向量<整64>"）判假→语法层资源字段登记 miss→85-a 在容器
                                    //   方法体（泛型 T）失效——登记链根治后本补丁可回收。
                                    如果 (资源字段数(方法返回结构ID) > 0) {
                                        发射串字段深拷(指令, 寄存器计数, 物化regm, 物化regm,
                                                        方法返回结构ID, 0);
                                    }
                                }
                                // 650-a 波 A〔基准=019〕：容器实例返回→物化后追加**拷贝构造**
                                //   （深拷·无别名值语义=019 安全区默认）——原 sret 物化=元素槽
                                //   浅拷字节→接收方 设置 扩容 realloc·原元素字段悬垂
                                //   （643 语义级互斥）→深拷后接收方独立·扩容自洽。
                                如果 (是容器类(签.返回文本)) {
                                    整64 拷贝串IDm = 查类拷贝构造串(方法返回结构ID);
                                    如果 (拷贝串IDm != 0) {
                                        整64 新objm = 寄存器计数[0];
                                        寄存器计数[0] = 寄存器计数[0] + 1;
                                        IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新objm,
                                             查结构体大小(方法返回结构ID), 方法返回结构ID));
                                        IR追加(指令, 建IR指令(IR_调用实参, 新objm, 0, 0, 0, 0, 0));
                                        // 698-a 修复〔基准=019〕：拷贝构造源实参=T& 句柄槽
                                        //   （槽首 8B=壳指针）——原传 物化regm（物化壳地址本身）
                                        //   =被调方 [源] 再解一层拿到壳首 8B（字段0 值）当壳用
                                        //   →空映射 桶数量=0→READ [0+0x20] 段错误（113 注册/
                                        //   查找/弹出 三链同崩·宿主拷贝构造 asm 权威对照：
                                        //   src=句柄两跳 [源槽]→壳）。装配：句柄槽 ← 壳地址，
                                        //   源=&句柄槽（对照 生成容器拷贝构造 非引用分支
                                        //   IR_取地址(源槽) 同款契约）。
                                        整64 源句柄槽m = 槽计数[0];
                                        槽计数[0] = 槽计数[0] + 1;
                                        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 源句柄槽m));
                                        IR追加(指令, 建IR指令(IR_存储, 物化regm, 0, 0, 0, 0, 源句柄槽m));
                                        整64 源地址regm = 寄存器计数[0];
                                        寄存器计数[0] = 寄存器计数[0] + 1;
                                        IR追加(指令, 建IR指令(IR_取地址, 源句柄槽m, 0, 0, 源地址regm, T_整64, 0));
                                        IR追加(指令, 建IR指令(IR_调用实参, 源地址regm, 0, 0, 0, 1, 0));
                                        IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                                             驻留(方法符号(签.返回文本,
                                                   剥实例基名(签.返回文本),
                                                   字符串复制(驻留文本(拷贝串IDm))))));
                                        物化regm = 新objm;
                                        压栈reg = 新objm;
                                    }
                                }
                            }
                        }
                        结果<空类型, 整32> 加法 = 表达式栈.追加(压栈reg);
                        如果 (!加法.正常) { 运行时错误(4); }
                    }
                    返回;
                }
                IR层诊断("容器方法未收录: " + 类名 + "." + 方法名文本);
                运行时错误(6);
            }
            // 第七十八轮（2026-09-12）：用户类方法调用——this 位0 + 实参位1..，
            //   符号=类$方法[#参数串]（方法表来自 IR类 类表——语义层声明收集登记）
            如果 (是用户类(类名)) {
                // T87（489-b）：retbuf序号 透传（聚合返回走帧尾 retbuf·与容器
                //   方法发射同源槽区）
                发射用户类方法调用(类名, 方法名文本, this寄存器, 弹出们, 实参数,
                                    指令, 寄存器计数, 槽计数, 表达式栈, retbuf序号);
                返回;
            }
            // 466-a（T70 面⑥·模块根成员内置直调）：stdlib 源码级模块内部实现
            //   调内置成员（IO.cn 行 44 `IO.打印到错误(消息)`——根=内置模块名·
            //   sem5 已放行模块名根）→ 改写 模块::方法 限定内置直调（内置表
            //   同表命中·宿主「内置走限定名直调」同语义；生产态 stdlib 源码
            //   不编译=零触发）。this 已弹弃置（内置无 this 位）。
            字符串 根名466 = 类名;
            如果 (字符串长度(根名466) == 0 && 位置 >= 1) {
                // 对象类型解析 miss（根=内置模块名不在容器/类表）——自调用节点
                //   前邻回溯成员节点取链根（池布局=[根,成员,实参...,调用]·
                //   方法调用节点在实参之后·探针 32938~32942 实证）
                整64 找b = 位置 - 1;
                当 (找b >= 0 && 找b >= 位置 - 4) {
                    节点 成员n466 = 池.元素(整32(找b));
                    如果 (成员n466.类型 == 节点_成员 && 成员n466.子起点 > 0) {
                        节点 根n466 = 池.元素(整32(成员n466.子起点));
                        根名466 = 字符串复制(驻留文本(整64(根n466.文本)));
                        中断;
                    }
                    找b--;
                }
            }
            如果 (是标准库模块名(根名466)) {
                字符串 限定名466 = 根名466 + "::" + 方法名文本;
                如果 (字符串长度(内置函数符号(限定名466)) != 0) {
                    生成打印与内置调用(池, 驻留(限定名466), 弹出们, 实参数,
                                       指令, 寄存器计数, 表达式栈);
                    返回;
                }
            }
}

// 打印族（逐参类型分派 __cn_print_*+换行）与内置函数（__cn_ 直调）。
//   返回 1=本形态已处理（消费 1 个位置）；0=非此两族（调用方继续分派）。
// 862（任务 215）：单参发射辅助自打印段循环体机械提取——862 批式/流式两路径
//   共用单一事实源（提取为逐字节等价变换：类型分派/浮32提升/IR 形态零变化）。
函数 发射单参打印(整64 打参, 向量<IR指令>& 指令, 整64* 寄存器计数) -> 空类型 {
    // ③ 缺陷①根治：类型登记表分派（字符串变量/字面量 str、浮点 float、
    //   布尔 bool（输出 真/假）、未登记/整数 int）
    整64 打参码 = 查寄存器类型(打参);
    // 91-a：浮32 实参 -> 浮64 提升（runtime __cn_print_float(double)
    //   按 SysV 双精度读 xmm0；宿主 ir_call f32 实参提升同款）
    如果 (打参码 == T_浮32) {
        打参 = 插入值转换(打参, T_浮64, 指令, 寄存器计数);
        打参码 = T_浮64;
    }
    字符串 打印符号 = "__cn_print_int";
    如果 (打参码 == T_字符串) {
        打印符号 = "__cn_print_str";
    } 否则 如果 (打参码 == T_浮32 || 打参码 == T_浮64) {
        打印符号 = "__cn_print_float";
    } 否则 如果 (打参码 == T_布尔) {
        打印符号 = "__cn_print_bool";
    // 810 轮（053）：128 位打印——寄存器值=16 字节槽地址（值=地址
    //   语义·静态/局部/形参/返回接收统一），传址调运行时打印。替换
    //   波H「查地址128标记」按寄存器号的泄漏形态（类型即生命周期）。
    } 否则 如果 (打参码 == T_整128) {
        打印符号 = "__cn_print_i128";
    } 否则 如果 (打参码 == T_正128) {
        打印符号 = "__cn_print_u128";
    }
    IR追加(指令, 建IR指令(IR_调用实参, 打参, 打参码, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0, 驻留(打印符号)));
}

不安全 函数 生成打印与内置调用(向量<节点> 池, 整64 函数符号, 向量<整64>& 弹出们, 整64 实参数,
                       向量<IR指令>& 指令, 整64* 寄存器计数, 向量<整64>& 表达式栈) -> 整32 {
        // ---- ③ 第一波：打印/打印行（复合内置，宿主 ir_call 对齐语义）——逐参按
        //      类型独立调用 __cn_print_str（字符串寄存器集合判定）/__cn_print_int，
        //      打印 尾随 __cn_print_newline（打印行 不加）；void 不压栈。
        //      注意 函数符号 恒为正（标识符兜底压栈 0-ID，此处再取反还原）；
        //      限定名内置（IO::/文件::）经语法层合成限定标识符走本路径。
        // 828-a：打印族判定用归一基名（IO::打印 → 打印·打印族=纯名复合内置面）；
        //   通用内置查询用**原名**直查（内置函数符号 自带两级兜底——IO::读取行
        //   等限定注册名直查命中；若误用归一名则破坏限定注册面）
        字符串 内置原名 = 字符串复制(驻留文本(函数符号));
        // 954（红灯治理·27 族真修·入口拦截）：限定名内置（数学::平方根 等）
        //   本地模块定义同名函数时**用户优先**（宿主 27 实证=调用户函数返回
        //   入参 16；修前内置 __cn_sqrt 抢占得 4）——查签名表 模块$名 命中
        //   则返回 0（不按内置处理→决议走用户函数通道）；打印族豁免（纯名
        //   复合内置无本地同名语义）；本地 miss 才走内置（v2 自举 IO:: 族）
        字符串 护模954 = "";
        字符串 护符954 = "";
        如果 (拆限定名(内置原名, 护模954, 护符954) == 1) {
            如果 (是用户模块名954(护模954) &&
                 查函数签名个数(键基合成(护模954, 驻留(护符954))) > 0) {
                返回 0;
            }
        }
        字符串 打印名 = 内置归一基名(内置原名);
        布尔 是打印换行 = 字符串比较(打印名, "打印");
        如果 (是打印换行 || 字符串比较(打印名, "打印行")) {
            // 弹出们 为倒序弹（栈顶=右参先弹）——正序打印：从尾向头遍历
            // 862（任务 215）：逐参发射提炼为 发射单参打印（与流式分派共用单一
            //   事实源——类型分派/浮32提升/IR 形态零变化）
            整64 打i = 弹出们.大小();
            当 (打i > 0) {
                发射单参打印(弹出们.元素(打i - 1), 指令, 寄存器计数);
                打i--;
            }
            如果 (是打印换行) {
                IR追加(指令, 建IR指令(IR_调用参数化, 0, 0, 0, 0, 0,
                                     驻留("__cn_print_newline")));
            }
            返回 1;
        }
        // ---- ③ 第一波：内置函数（驻留/字符串族/运行时错误）——裸 ASCII 运行时
        //      符号直调（宿主 ABI 权威：v2p_linux.s 实查 bl __cn_intern）；
        //      代码生成 __cn_ 前缀直通不修饰。返回标量/指针单槽。
        //      ③ 第五波：限定名内置（IO::/文件::）同表命中——语法层 :: 已合成
        //      限定标识符，此处与纯名内置统一走本路径。
        字符串 内置符号名 = 内置函数符号(内置原名);
        如果 (字符串长度(内置符号名) != 0) {
            整64 返回寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            // 91-a：返回类型码先算（IR_调用参数化.操作数2——浮点返回走 xmm0）；
            //   实参类型码按实参表达式登记类型（内置表无参数类型信息）
            整64 内置返回码 = 类型码(内置函数返回类型ID(内置原名));   // 828-a：原名（自带兜底）——浮点返回码须正确（xmm0 装载）
            // 91-a：浮32 实参 -> 浮64 提升（内置浮点 runtime 函数形参全为 double）
            整64 提升i = 0;
            当 (提升i < 弹出们.大小()) {
                如果 (查寄存器类型(弹出们.元素(提升i)) == T_浮32) {
                    整64 升reg = 插入值转换(弹出们.元素(提升i), T_浮64,
                                             指令, 寄存器计数);
                    结果<空类型, 整32> 设升 = 弹出们.设置(提升i, 升reg);
                    如果 (!设升.正常) { 运行时错误(4); }
                }
                提升i++;
            }
            发射调用实参们(弹出们, 0, 指令, 实参类型码们(弹出们));
            IR追加(指令, 建IR指令(IR_调用参数化, 实参数, 内置返回码, 0, 返回寄存器, 0,
                                 驻留(内置符号名)));
            // 返回类型登记（字符串/布尔/整64——打印分派与拼接判定消费；
            //   空类型跳过=void 无值语义，对齐用户函数 T_空类型 同款）
            如果 (内置返回码 != T_未知 && 内置返回码 != T_空类型) {
                登记寄存器类型(返回寄存器, 内置返回码);
            }
            结果<空类型, 整32> 加内 = 表达式栈.追加(返回寄存器);
            如果 (!加内.正常) { 运行时错误(4); }
            返回 1;
        }
    返回 0;
}

// 类型转换 类型(expr)（灰色点④窄宽特判）与容器构造调用（合成名无实参）。
//   返回 1=已处理；0=继续分派。
不安全 函数 生成转换或构造调用(整64 函数符号, 向量<整64>& 弹出们, 整64 实参数,
                       向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数,
                       向量<整64>& 表达式栈) -> 整32 {
        // ---- 类型转换 类型(expr)（被调符号是类型名且单实参）——不走调用 ----
        整64 目标类型 = 类型码(函数符号);
        // 灰色点④根治（2026-09-04）：窄宽强转目标码特判——类型码() 将
        //   整8/整16 归 T_整64（v2 槽模型 8 字节、正8 无符号语义缺位），
        //   但强转须按目标宽度截断（win mov al/movsx、ARM64 sxtb/sxth），
        //   此处改码为窄宽标注；其余类型走 类型码() 原路径零变化
        字符串 强转名 = 字符串复制(驻留文本(函数符号));
        如果 (字符串比较(强转名, "整8")) {
            目标类型 = T_整8;
        } 否则 如果 (字符串比较(强转名, "整16")) {
            目标类型 = T_整16;
        } 否则 如果 (字符串比较(强转名, "正8")) {
            // 2026-09-04 缺陷零容忍收口：无符号窄宽（零扩展 movzx/uxtb——
            //   正8(200)=200；与 整8 符号扩展对称）
            目标类型 = T_正8;
        } 否则 如果 (字符串比较(强转名, "正16")) {
            目标类型 = T_正16;
        }
        如果 (目标类型 != T_未知 && 实参数 == 1) {
            // 810（053）：128 位转换分派（先于通用路径）——
            //   ·128→128 恒等（值=句柄直通·登记产物）
            //   ·128→64/窄宽/整32：双半装载低半（句柄地址 [0]·截断由目标发射
            //     层既有路径承接）——420-② 取低(999999) 垃圾实证（句柄直转）
            //   ·64/窄宽→128：物化 2 槽（符号性分派）传句柄
            整64 源码c128 = 查寄存器类型(弹出们.元素(0));
            如果 (源码c128 == T_整128 || 源码c128 == T_正128) {
                如果 (目标类型 == T_整128 || 目标类型 == T_正128) {
                    结果<空类型, 整32> 加恒128 = 表达式栈.追加(弹出们.元素(0));
                    如果 (!加恒128.正常) { 运行时错误(4); }
                    返回 1;
                }
                整64 低半c128 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_指针加载, 弹出们.元素(0), 0, 0,
                                     低半c128, T_整64, 0));
                结果<空类型, 整32> 设c128 = 弹出们.设置(0, 低半c128);
                如果 (!设c128.正常) { 运行时错误(4); }
            } 否则 如果 (目标类型 == T_整128 || 目标类型 == T_正128) {
                整64 句柄c128 = 物化128位操作数(弹出们.元素(0), 源码c128,
                    源码c128 == T_正32 || 源码c128 == T_正64 ? 0 : 1,
                    指令, 寄存器计数, 槽计数);
                结果<空类型, 整32> 设物c128 = 弹出们.设置(0, 句柄c128);
                如果 (!设物c128.正常) { 运行时错误(4); }
                结果<空类型, 整32> 加物c128 = 表达式栈.追加(句柄c128);
                如果 (!加物c128.正常) { 运行时错误(4); }
                返回 1;
            }
            整64 转换寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            // 方案甲（2026-09-10 第五十一轮 用户裁决，Rust as 语义对齐）：发射层
            //   读取扩展方式须按源操作数符号性选择（原只看目标码——正32→整64 落
            //   movsxd 符号扩展兜底 4000000000 出负、正64→整64 低32截断 2^63 出 0，
            //   宿主 emitCast 按源分派双侧分叉=193_v2 立案）。目标 64 位码时按
            //   源寄存器登记类型改标指令类型字段（发射层按该字段选读法）：源
            //   正32→T_正32（零扩展读，值保序）；源 整64/正64→T_正64（64 位直拷
            //   =同宽位模式重解释）；源 整32/未登记→维持目标码（movsxd 既有兜底）。
            //   原目标码另存供产物登记（改标仅编码发射读法，不改转换目标语义）。
            //   正8/正16 源（2026-09-10 第五十五轮标注）：经 类型码() 归一登记
            //   T_整64（窄宽无独立码）→同落 T_正64 64 位直拷——正确性=正8/正16
            //   槽是 64 位槽且全部写入路径（字面量装载/标识符拷贝/字段读回零扩展）
            //   保证高位干净，直拷=零扩展语义；结构体字段层经 类型宽度码()
            //   T_整8/T_整16 窄宽读回（1/2 字节+movzx）独立正确。E2E 194 双侧锚定
            //   （变量显式转换 rc=31/字段+指针解引用 rc=15，宿主 movzx 对称）。
            整64 原目标码 = 目标类型;
            整64 源登记码t = 查寄存器类型(弹出们.元素(0));
            IO::打印到错误("[dbg1022y] 转换 弹出数=" + 整数转字符串(弹出们.大小()) +
                           " 弹0=" + 整数转字符串(弹出们.元素(0)) +
                           " 弹1=" + 整数转字符串(弹出们.大小() > 1 ? 弹出们.元素(1) : 0 - 1) +
                           " 查表0=" + 整数转字符串(源登记码t) + "\n");
            如果 (目标类型 == T_整64 || 目标类型 == T_正64) {
                如果 (源登记码t == T_正32) {
                    目标类型 = T_正32;
                } 否则 如果 (源登记码t == T_整64 || 源登记码t == T_正64) {
                    目标类型 = T_正64;
                }
            }
            // 91-a（2026-09-13 第九十一轮）：操作数2 = 源类型码——发射层按
            //   (源码, 目标码) 组合分派浮点转换（整->浮 cvtsi2sd/scvtf、浮->整
            //   cvttsd2si/fcvtzs 截断、浮32<->浮64 cvtss2sd/cvtsd2ss/fcvt）；
            //   源码 0（未登记）按整型兜底（原整数路径行为零变化）。
            IR追加(指令, 建IR指令(IR_类型转换, 弹出们.元素(0), 源登记码t, 0, 转换寄存器, 目标类型, 函数符号));
            // 方案甲顺带（发射方向对齐宿主）：转换产物登记目标类型码——原未登记
            //   查 0 兜底 T_整64，正32(x) 产物参与二元时无符号性在发射点丢失
            登记寄存器类型(转换寄存器, 原目标码);
            结果<空类型, 整32> 加转 = 表达式栈.追加(转换寄存器);
            如果 (!加转.正常) { 运行时错误(4); }
            返回 1;
        }
        // ---- 第七十八轮（2026-09-12）：用户类构造调用（被调符号=类名ID）——
        //      分配对象 + this 位0 + 实参位1.. + 类$类名[#参数串]；对象指针压栈。
        //      判定先于容器分支（类名与容器合成名无交集——防御性顺序）
        字符串 被调名u = 字符串复制(驻留文本(函数符号));
        // 276-a（D28 根治·2026-09-17）：导入类裸名经解析期 B1 改写为「模块::类」
        //   限定形态，用户类登记为裸名——直接查表不命中→落普通调用=链接期
        //   undefined（随机数生成器 冒烟实锤）。拆基名后同判构造分派：
        //   发射符号=类$类名 与定义侧一致（plans/021 §3-D D28）。
        如果 (!是用户类(被调名u)) {
            字符串 限定模块 = "";
            字符串 限定符号 = "";
            如果 (拆限定名(被调名u, 限定模块, 限定符号) == 1 &&
                 是用户类(限定符号)) {
                被调名u = 限定符号;
            }
        }
        如果 (是用户类(被调名u)) {
            发射用户类构造(被调名u, 弹出们, 实参数, 指令, 寄存器计数, 槽计数,
                          表达式栈);
            返回 1;
        }
        // ---- 构造调用：被调符号是容器类合成名（向量$整64）且无实参 ----
        字符串 被调名 = 字符串复制(驻留文本(函数符号));
        如果 (是容器类(被调名) && 实参数 == 0) {
            整64 obj寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, obj寄存器,
                                 容器对象大小(被调名), 函数符号));
            IR追加(指令, 建IR指令(IR_调用实参, obj寄存器, 0, 0, 0, 0, 0));
            IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                 驻留(构造符号(被调名))));
            结果<空类型, 整32> 加构 = 表达式栈.追加(obj寄存器);
            如果 (!加构.正常) { 运行时错误(4); }
            返回 1;
        }
    返回 0;
}

// 71-a（2026-09-11 方案A 用户裁决）：内置构造器 正常()/错误()/某些() 装箱发射
// 067-003：已装箱节点表（嵌套预求值去重——键=节点索引）
静态 映射<整64, 整64> 已装箱节点们;
// 067-003：已装箱节点表任务级生命周期清空（IR生成/IR生成多文件 入口调用——
//   键=池位置索引：跨任务残留会误跳过装箱，与 清空引用参数表 同纪律）。
函数 清空已装箱节点表() -> 空类型 {
    已装箱节点们.清空();
}
//   （宿主 handleResultCtor/ir_error_ctor 同构，Rust Ok/Err/Some 零成本抽象）：
//   合成布局 正常@0(4字节)+值@4(整32/正32)/@8(其余)（结果值偏移，与宿主
//   typeSizeOf/接收侧 生成结果局部 布局双侧一致）；槽组=结果槽位数 个 8 字节槽、
//   基槽=最大槽号低地址。标志/值经 基址+IR_字段地址+IR_指针存储 按宽度写入
//   （整32 值与标志同槽不覆盖）。压栈产物=临时基址（返回位由 生成返回语句 拷入
//   retbuf；声明位由 生成结果局部 IR_结构体拷贝 接收）。
//   move 语义（正常/某些(拥有标识符)）：实参单标识符形态登记 已装箱名——出口
//   释放（发射字符串释放/发射容器析构/块出口析构）跳过=所有权转交装箱值（Rust
//   Ok(s) move 同款零拷贝；宿主 70-a 源槽清零同效，v2 跳过模型双装箱退化借用）。
//   表达式实参（拼接/调用产物）=临时值无源槽，不登记（出口本就不释放）。
// 067-003 内层装箱名推导（嵌套安全·543/546 fault=5 根治）：原兜底走
//   解析节点类型ID → 调用分支经 解析调用返回结构体 **按被调名查函数返回表**
//   ——内外层同名构造器（某些/正常/错误）拿到同一类型 → 内层某些被推成外层
//   类型（可选$可选$盒子）→ 载荷判成结果类型 → CopyStruct 16B（asm 铁证
//   `rep movsb rcx=16 rsi=对象句柄`；应 8B 句柄直存）。
//   修正=内置构造器按**语义 + 实参类型**推导：某些(x)→可选$typeof(x)；
//   正常(x)→结果$typeof(x)$E；错误(x)→结果$T$typeof(x)（T/E 未知按 整32 兜底
//   ——8 字节族槽位/偏移同构，宽类型场景登记边界）。实参自身是构造器时递归。
函数 推导构造器装箱类型(向量<节点> 池, 节点 n, 整32 位置) -> 整64 {
    如果 (n.子起点 <= 0) { 返回 0; }
    // 067-003（24_error_handling 回归防护）：**无实参构造器**（`正常()`·
    //   结果<空类型,E> 形态）——「位置-1」会指向无关节点（非实参）→ 推错类型
    //   （24「空配置错误码 5→垃圾」实证）。无实参=类型由上下文/标注决定，
    //   本函数不推导（回退原标注路径）。
    如果 (n.附加 < 1) { 返回 0; }
    整64 被调位 = 整64(n.子起点);
    如果 (被调位 >= 整64(池.大小())) { 返回 0; }
    字符串 名 = 字符串复制(驻留文本(整64(池.元素(整32(被调位)).文本)));
    // 067-003（AST 后缀式实证·dbgA 铁证）：实参子树落地点=**紧邻调用节点之前**
    //   （外层某些 位=63 → 位-1=62=内层某些调用节点）。原「被调位+1」取到实参
    //   子树的**首节点**（标识符/字面量·类型 10/11）→ 判定失败 → 内层未装箱。
    整64 实参位 = 整64(位置) - 1;
    如果 (实参位 <= 0 || 实参位 >= 整64(池.大小())) { 返回 0; }
    节点 实参n = 池.元素(整32(实参位));
    整64 实参型ID = 0;
    如果 (实参n.类型 == 节点_调用 && 整64(实参n.子起点) > 0) {
        字符串 内被调 = 字符串复制(驻留文本(整64(池.元素(整32(实参n.子起点)).文本)));
        如果 (字符串比较(内被调, "正常") || 字符串比较(内被调, "错误") ||
             字符串比较(内被调, "某些")) {
            实参型ID = 推导构造器装箱类型(池, 实参n, 整32(实参位));
        }
    }
    如果 (实参型ID <= 0) {
        // 067-003（构造调用实参类型·dbg dump 实证）：实参=类构造调用 `盒子(...)`
        //   时 解析节点类型ID 经 解析调用返回结构体 **按被调名查函数返回表**
        //   miss（构造器无普通函数返回登记）→ 类型 0 → 推导失败回退外层标注 ✗。
        //   修正=被调标识符命中 结构体大小表/用户类表 → 该名即类型（构造表达式
        //   类型=类自身）。
        如果 (实参n.类型 == 节点_调用 && 整64(实参n.子起点) > 0) {
            节点 被调a = 池.元素(整32(实参n.子起点));
            如果 (被调a.类型 == 节点_标识符) {
                字符串 名a = 字符串复制(驻留文本(整64(被调a.文本)));
                如果 (查结构体大小(驻留(名a)) != 0 || 是用户类(名a)) {
                    实参型ID = 驻留(名a);
                }
            }
        }
    }
    如果 (实参型ID <= 0) {
        // 067-003（字面量实参·dbg 实证）：解析节点类型ID 无字面量分支 → 0 →
        //   推导失败回退外层标注（三层标量 `某些(某些(某些(7)))` 全推成外层名
        //   实证）。按字面量类别给基础类型。
        如果 (实参n.类型 == 节点_整数字面量) { 实参型ID = 驻留("整32"); }
        否则 如果 (实参n.类型 == 节点_浮点字面量) { 实参型ID = 驻留("浮64"); }
        否则 如果 (实参n.类型 == 节点_字符串字面量) { 实参型ID = 驻留("字符串"); }
    }
    如果 (实参型ID <= 0) { 实参型ID = 解析节点类型ID(池, 整32(实参位)); }
    如果 (实参型ID <= 0) { 返回 0; }
    字符串 实参型 = 字符串复制(驻留文本(实参型ID));
    如果 (字符串比较(名, "某些")) { 返回 驻留("可选$" + 实参型); }
    // 067-003（24_error_handling 回归防护）：正常/错误 的**缺失 E/T 从外层标注取**
    //   （标注=结果$T$E 形态·段切）——原硬编码「整32」在外层 T/E 非整32 时推错
    //   类型（24「空配置错误码」读 8 字节垃圾实证）。标注不可用=不做推导（回退原
    //   标注路径·零风险）。
    字符串 标注Tn = "";
    字符串 标注En = "";
    整64 标IDn = 整64(n.子终点);
    如果 (标IDn > 0) {
        字符串 标名n = 字符串复制(驻留文本(标IDn));
        如果 (是结果类型(标名n)) {
            标注Tn = 段首(合成名首实参(标名n));
            标注En = 段余(合成名首实参(标名n));
        }
    }
    如果 (字符串比较(名, "正常")) {
        如果 (字符串长度(标注En) == 0) { 返回 0; }
        返回 驻留("结果$" + 实参型 + "$" + 标注En);
    }
    如果 (字符串比较(名, "错误")) {
        如果 (字符串长度(标注Tn) == 0) { 返回 0; }
        返回 驻留("结果$" + 标注Tn + "$" + 实参型);
    }
    返回 0;
}

不安全 函数 生成装箱构造(向量<节点> 池, 节点 n, 整32 位置,
                         向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数,
                         向量<整64>& 表达式栈) -> 整32 {
    整64 装箱类型ID = 整64(n.子终点);
    // 826（067-003 治本收口）：**不再「恒用推导」**——根因已由**语义层递归下推
    //   修复**（`检查构造器调用` 给嵌套内层标注自身类型·211_v2/543 双满足）；
    //   此处改为「标注优先 + 未标注时推导兜底」（见下方 装箱类型ID <= 0 分支）。
    //   原「恒用推导」会**覆盖**语义层的正确标注（211_v2 ④ `可选<整64> 选 =
    //   可选包装()`〔返回 某些(42)〕：推导硬编码字面量整32 → 覆盖标注 整64 →
    //   校验位 +8 丢失实证）。
    // 067-003 去重（嵌套预求值后内层会被后续遍历再次装箱——第二次重跑破坏
    //   栈/寄存器一致性·544 新崩点 fault=0 实证）：被递归预求值的节点已装箱，
    //   遍历再达时直接跳过（产物已在栈上=该位置的求值结果）。
    结果<整64, 整32> 查已箱 = 已装箱节点们.获取(整64(位置));
    如果 (查已箱.正常) { 返回 1; }
    如果 (装箱类型ID <= 0) {
        // 067-003（543/546 fault=5 根治）：内置构造器**按语义+实参类型**推导优先
        //   ——避免 解析节点类型ID 的「按被调名查函数返回表」把内层同名构造器
        //   推成外层类型（详见 推导构造器装箱类型 注释）。仅当该推导失败时回退
        //   原路径（语义层已推导表达式类型）。
        装箱类型ID = 推导构造器装箱类型(池, n, 位置);
        如果 (装箱类型ID <= 0) {
            装箱类型ID = 解析节点类型ID(池, 位置);
        }
    }
    如果 (装箱类型ID <= 0) {
        // 430-b（族③ 收口）：克隆体装箱语境兜底——语义层标注发生在实例化前
        //   的基类体（克隆节点子终点=0）；返回位装箱=结果方法常态，取当前
        //   函数返回 结果/可选 类型名ID（生成方法/生成函数 每函数设置）。
        //   已标注节点（语义层可判·局部声明位）不受影响（子终点>0 直通）。
        装箱类型ID = 取当前函数返回结果名ID();
    }
    如果 (装箱类型ID <= 0) {
        IR层诊断("构造器装箱类型语境未知（语义层未标注）: " +
                  驻留文本(整64(池.元素(整32(n.子起点)).文本)));
        返回 0;
    }
    字符串 装箱名 = 字符串复制(驻留文本(装箱类型ID));
    字符串 被调名71 = 字符串复制(驻留文本(整64(池.元素(整32(n.子起点)).文本)));
    // 值字段类型：错误(码) 存 E（第二实参段），正常/某些 存 T（首实参段）——
    //   可选$T 单实参同 T 路径（宿主 handleResultCtor valueType 分派同构）
    字符串 实参段71 = 合成名首实参(装箱名);
    // 067-003 第 8 面（值类型完整载荷·$ 形态双层砍根治）：原 段首(实参段71)
    //   对「可选$可选$盒子」砍成「可选」（基名）→ 宽度/类型码全失。可选 单参
    //   恒载荷全串（正常/某些 存 T）；结果 的 T/E 切分（段余·T 含 $ 歧义）
    //   另案（t4 面）。
    字符串 值类型71 = 实参段71;
    如果 (字符串比较(被调名71, "错误")) {
        值类型71 = 段余(实参段71);
    }
    // 194 修③（114 写侧实锤·067-003 注记「结果 的 T/E 切分另案 t4 面」兑现）：
    //   结果$T$E 形态的 正常/某些 值类型=未切分「符号$整32」→ 类型名宽度 查表
    //   miss → 载荷写入落 8B 直存（正常(s) 只拷 s.名ID 8 字节·24B 载荷 16B 未
    //   拷·asm 对位 [盒+8]=5 实锤）→ 读侧 查.值.类型ID 读到盒外相邻槽。
    //   切分同族：结果 的 正常/某些=段首（T）、错误=段余（E·上行既有）、
    //   可选 单参全串不动（嵌套合成体保整段·067-003 第 8 面同规）。
    // 194 修③ [r26 单变量撤除实验：79_v2 自举红定位——验后恢复]
    如果 (字符串比较(合成名基名(装箱名), "结果")) {
        如果 (!字符串比较(被调名71, "错误")) {
            值类型71 = 段首(实参段71);
        }
    }
    // 194 修⑪（r3 重放·r2 误删的修⑦b 机制恢复+双语境实证补全）：**stdlib 泛型
    //   克隆体**的装箱标注沿基类体语义层（「结果$T$整32」·T 未替换——与主
    //   模块直调语境的「结果$资源$整32」已替换不同·box194 插桩双语境实证）
    //   → 修③ 切分得「T」→ 类型名宽度 miss → 8B 直存半拷（fix_p.asm 获取体
    //   asm 对位：正常(数据[键]) 载荷只写 8B·32B 符号未拷）→ 语义分析经
    //   符号表.获取 拿半截结构体 → 表注册/链式查找 崩（79_v2 自举红·崩链
    //   链式查找+0x2f7←获取+0x83←表注册+0x10c←收集函数声明）。兜底=克隆
    //   体语境（当前方法类名ID=实例合成名·生成类 199）把装箱名按实例实参
    //   词级替换（取实例实参们+查类类型参数+替换类型参数带段们·IR签名/
    //   IR容器 既有设施）——「结果$T$整32」→「结果$符号$整32」→ 修③ 切分
    //   得「符号」→ 值宽 32 → CopyStruct 整块拷（修⑩ 回扫供元素槽源址）。
    如果 (当前方法类名ID != 0) {
        字符串 实例名b = 字符串复制(驻留文本(当前方法类名ID));
        如果 (首分段位置(实例名b) >= 0) {
            整64 序串IDb = 查类类型参数(驻留(合成名基名(实例名b)));
            如果 (序串IDb > 0) {
                向量<字符串> 实参们b = 取实例实参们(实例名b);
                字符串 替换b = 替换类型参数带段们(装箱名,
                                     字符串复制(驻留文本(序串IDb)), 实参们b);
                如果 (!字符串比较(替换b, 装箱名)) {
                    装箱名 = 替换b;
                    装箱类型ID = 驻留(替换b);
                    // 修③ 补跑（装箱名 替换后 重切）：本段在 修③ 之后——
                    //   替换改变了 切分基面，重走 切分与错误 分流。
                    字符串 实参段71r = 合成名首实参(装箱名);
                    值类型71 = 实参段71r;
                    如果 (字符串比较(被调名71, "错误")) {
                        值类型71 = 段余(实参段71r);
                    } 否则 {
                        值类型71 = 段首(实参段71r);
                    }
                }
            }
        }
    }
    // 194 修⑨（79_v2 自举红根治·崩链 RVA 对位 cn_self 类型分析$表查找类型ID）：
    //   修③ 段首切分对「T=容器实例」砍出**裸基名**（结果$映射$整64$符号$整32
    //   →段首「映射」·$ 切分对容器实参 T 含 $ 的歧义=067-003 老账）→ 是容器类
    //   对无 $ 裸名 miss → 落结构体分支 值宽=查结构体大小(映射)=56·载荷须深拷
    //   → CopyStruct 56B（源=句柄值当地址）写穿盒槽 → cn_self 编 stdlib 时写坏
    //   堆 → 语义分析阶段延迟崩（基线未切分「X$Y…」查表 miss 恰好 8B 直存=
    //   自洽）。补全=克隆体语境取**实例首类型实参**（容器数据元素=T 实参·
    //   修⑧b 同款放宽到全部装箱）→ 是容器类 命中完整实例名 → 句柄 8B 直存
    //   原路（001 §5.3 容器按值=句柄拷贝）。
    如果 (字符串比较(合成名基名(装箱名), "结果") &&
         首分段位置(值类型71) < 0 && 是容器基名(值类型71) &&
         当前方法类名ID != 0) {
        字符串 实例名n9 = 字符串复制(驻留文本(当前方法类名ID));
        如果 (首分段位置(实例名n9) >= 0) {
            向量<字符串> 实参们n9 = 取实例实参们(实例名n9);
            如果 (实参们n9.大小() >= 1) {
                值类型71 = 字符串复制(实参们n9.元素(0));
            }
        }
    }
    // 79-a 缺陷根治（既有，基线复现）：联合体偏移 = 较宽成员（T/E）——写入侧
    //   原按当前载荷单侧定偏移（结果<字符串,整32>.错误 写偏移 4），读取侧按
    //   联合体实际偏移（8）=读写不一致（探针 P11 实证：错误码读垃圾）。
    整64 值偏移71 = 结果值偏移(段首(实参段71));   // 联合体偏移基准 = T 的偏移档
    如果 (字符串比较(合成名基名(装箱名), "结果")) {
        整64 错偏移71 = 结果值偏移(段首(段余(实参段71)));   // E 的偏移档
        如果 (错偏移71 > 值偏移71) { 值偏移71 = 错偏移71; }
    }
    // 弹栈：线性求值序=被调兜底负符号先压、实参值后压（转移 特判同款弹法）
    // 067-003 治本（嵌套构造实参时序·Rust 参照=按节点求值不依赖隐式栈序）：
    //   池先序遍历下外层（位置小）先入本函数——弹栈原假设「实参已求值在栈」
    //   对「实参=嵌套构造器调用」不成立（内层尚未遍历）→ 弹到字面量残留
    //   （544 双层 VEH 实证：CopyStruct 源=7）。对嵌套构造实参显式递归先
    //   求值其装箱，产物寄存器即实参值（首版接受内层后续遍历的重复求值，
    //   验证时序假设后再做去重优化）。
    整64 实参值71 = 0;
    // 067-003 治本（嵌套构造实参时序·池全景实证 池[5 外层调用]→池[6 内层调用]）：
    //   实参节点=本节点索引+1（先序：被调→调用节点→实参子树）。对「实参=嵌套
    //   构造器调用」显式先递归求值其装箱（内层尚未被遍历——原弹栈假设失效，
    //   544 双层 VEH 实证 CopyStruct 源=字面量残留）。产物寄存器即实参值。
    布尔 嵌套已求值 = 假;
    // 067-003（543 t1/t3 治本·嵌套构造实参时序）：实参节点=本节点索引+1
    //   （AST 先序：被调→调用节点→实参子树）。对「实参=嵌套构造器调用」
    //   显式递归先求值其装箱——原弹栈假设「实参已求值在栈顶」对嵌套不成立
    //   （内层尚未被遍历→弹到字面量残留；反证实测：撤本块→544 双层崩溃
    //   0xC0000005）。递归产物寄存器即实参值，节点登 已装箱节点们 去重
    //   （后续遍历再达时跳过——生成装箱构造 入口查表返回）。
    如果 (n.附加 == 1 && 整64(位置) > 1) {
        节点 实参n0 = 池.元素(位置 - 1);
        如果 (实参n0.类型 == 节点_调用 && 整64(实参n0.子起点) > 0) {
            字符串 实参被调0 = 字符串复制(驻留文本(整64(池.元素(整32(实参n0.子起点)).文本)));
            如果 (字符串比较(实参被调0, "正常") || 字符串比较(实参被调0, "错误") ||
                 字符串比较(实参被调0, "某些")) {
                如果 (生成装箱构造(池, 实参n0, 位置 - 1, 指令,
                                  寄存器计数, 槽计数, 表达式栈) != 0) {
                    嵌套已求值 = 真;
                    结果<空类型, 整32> 登已箱 = 已装箱节点们.设置(整64(位置) - 1, 1);
                    如果 (!登已箱.正常) { 运行时错误(4); }
                }
            }
        }
    }
    如果 (嵌套已求值) {
        如果 (表达式栈.大小() > 0) {
            实参值71 = 表达式栈.元素(表达式栈.大小() - 1);
            结果<空类型, 整32> 删子71 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删子71.正常) { 运行时错误(4); }
        }
        // 净压补弹（IR 净栈校验实证 增量=2→应为 1）：嵌套路径下「外层被调
        //   符号」未被原 2 弹消费——补弹 1 项。
        如果 (表达式栈.大小() > 0) {
            结果<空类型, 整32> 删调补 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删调补.正常) { 运行时错误(4); }
        }
    } 否则 如果 (n.附加 == 1 && 表达式栈.大小() >= 2) {
        实参值71 = 表达式栈.元素(表达式栈.大小() - 1);
        整64 弹i71 = 0;
        当 (弹i71 < 2) {
            结果<空类型, 整32> 删弹71 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删弹71.正常) { 运行时错误(4); }
            弹i71++;
        }
    } 否则 {
        如果 (表达式栈.大小() >= 1) {
            结果<空类型, 整32> 删被调71 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删被调71.正常) { 运行时错误(4); }
        }
    }
    // 槽组分配（逐槽 IR_分配 计入帧——生成结果局部 同构；不零初始化：未写区
    //   =联合 padding，接收方仅在 .正常 时读 .值，垃圾不读=零开销）
    整64 槽r71 = 槽计数[0];
    整64 槽数71 = 结果槽位数(装箱名);
    槽计数[0] = 槽计数[0] + 槽数71;
    整64 槽i71 = 0;
    当 (槽i71 < 槽数71) {
        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽r71 + 槽i71));
        槽i71++;
    }
    整64 基槽71 = 槽r71 + 槽数71 - 1;
    整64 基址71 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_取地址, 基槽71, 0, 0, 基址71, T_整64, 0));
    // 写标志（正常/某些=1、错误=0；T_整32 4 字节——x86 小端低字节即 .正常 布尔读值）
    整64 标志reg71 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    如果 (字符串比较(被调名71, "错误")) {
        IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 标志reg71, T_整64, 0));
    } 否则 {
        IR追加(指令, 建IR指令(IR_常量整数, 驻留("1"), 0, 0, 标志reg71, T_整64, 0));
    }
    IR追加(指令, 建IR指令(IR_指针存储, 基址71, 标志reg71, 0, 0, T_整32, 0));
