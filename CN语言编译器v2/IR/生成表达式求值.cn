        //   是用户类 miss（551 正(g) 实证：某些(s) 命中深拷而 正常(g) 漏网）。
        //   补实参语义类型 fallback：标识符实参查 查当前函数变量类型（语义层
        //   登记表·单点事实源）。错误(类值) 同构覆盖（E 形态同理未切分）。
        //   实参节点同时供 LUE 分派（下方 修饰==1 判定·语义层 107 标记）。
        整64 载荷ID107 = 0;
        整64 末位c107 = 查调用实参末位(整64(位置), 0);
        节点 实参c107 = 池.元素(0);
        布尔 有标识符实参107 = 假;
        如果 (末位c107 == 整64(n.子起点) + 1) {
            实参c107 = 池.元素(整32(末位c107));
            如果 (实参c107.类型 == 节点_标识符) { 有标识符实参107 = 真; }
        }
        // 194 修⑧前置（探针 118i 实锤·修⑤×修⑦ 交互）：**借用来源判定前置**——
        //   末位表对泛型克隆体键失配（d194c 实锤 -1）→ AST 先序局部判定
        //   （实参末节点=紧邻调用节点之前·067-003 同款）——下标/成员形态=
        //   容器元素借用（001 正交边界：读取=副本快照语义·不分容器/用户类）。
        布尔 借用来源107 = 假;
        如果 (末位c107 == 整64(n.子起点) + 1) {
            如果 (实参c107.类型 == 节点_下标 || 实参c107.类型 == 节点_成员) {
                借用来源107 = 真;
            }
        }
        整64 实参位b107 = 整64(位置) - 1;
        如果 (实参位b107 > 0 && 实参位b107 < 整64(池.大小())) {
            节点 实参b107 = 池.元素(整32(实参位b107));
            如果 (实参b107.类型 == 节点_下标 || 实参b107.类型 == 节点_成员) {
                借用来源107 = 真;
            }
