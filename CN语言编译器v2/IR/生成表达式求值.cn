            字符串 实例名e = 字符串复制(驻留文本(当前方法类名ID));
            如果 (首分段位置(实例名e) >= 0) {
                向量<字符串> 实参们e = 取实例实参们(实例名e);
                如果 (实参们e.大小() >= 1) {
                    值类型71 = 字符串复制(实参们e.元素(0));
                }
            }
