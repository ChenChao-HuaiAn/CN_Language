// CN 自举编译器 v2 · IR 生成表达式求值子形态（R3 千行拆分，2026-09-08）
// 职责：自 生成表达式.cn 提取的调用族+下标族六函数——类型大小折叠/方法调用/
//   打印族与内置/类型转换与构造/普通函数调用发射/下标访问。单向依赖：本模块
//   不调 生成表达式（递归调者 留原文件如 生成短路求值/生成下标左值地址），
//   故无循环导入。模块路径=原组件名逐字节不变（键基/mangling 零变化）。
// 356 重构F1：本文件 生成表达式求值中、生成表达式装箱、生成表达式求值尾 已拆出至同目录新模块（函数体逐字搬移·零逻辑变化·声明见 包.cn）。
导入 容器::向量;
导入 映射集合;
导入 语法;       // Token/AST 节点池（目录包名）
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码 + IR常量 键位移（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 IR生成;     // 函数级变量类型权威表/重载决议/控制流辅助（同包幂等）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 调用生成（R3 提取，2026-09-08）：类型大小折叠/弹参/方法与函数分派主体。
//   返回 消费 token 数（恒 1）；0=整个表达式求值须返回 0（类型大小未知/决议失败）。
不安全 函数 生成调用(向量<节点> 池, 节点 n, 整32 位置, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
              向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数,
              向量<整64>& 表达式栈, 整64 retbuf序号) -> 整32 {
        // ---- 71-a（2026-09-11 方案A 用户裁决）：内置构造器 正常()/错误()/某些()
        //      装箱特判（语义层已推导类型写入 n.子终点）——先于转移/普通调用。
        //      被调标识符兜底负符号与实参值由 生成装箱构造 统一弹收。
        如果 (n.子起点 > 0 && n.附加 <= 1) {
            节点 被调71 = 池.元素(整32(n.子起点));
            如果 (被调71.类型 == 节点_标识符) {
                字符串 被调名71 = 字符串复制(驻留文本(整64(被调71.文本)));
                如果 (字符串比较(被调名71, "正常") || 字符串比较(被调名71, "错误") ||
                     字符串比较(被调名71, "某些")) {
                    返回 生成装箱构造(池, n, 位置, 指令, 寄存器计数, 槽计数, 表达式栈);
                }
            }
        }
        // ---- plans/019 阶段1（2026-09-10）：显式转移 转移(变量) 展开——
        //      语义层已放行（指针/字符串值交接）。栈顶=实参寄存器值（标识符
        //      求值产物），其下=被调「转移」函数名兜底负符号：弹掉被调残留、
        //      实参值留在栈顶=转移调用的求值结果（零运行时指令，纯编译期）。
        //      位置紧邻 类型大小 折叠（单标识符实参内置调用同族形态）。
    // 212-a（2026-09-15 第两百一十二轮，D1 行数整改）：转移展开/类型大小折叠两特判
    //   迁独立族（-1=未处理哨兵，主函数继续原链——终结性装箱特判留主函数）。
    如果 (生成转移展开(池, n, 位置, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈)) { 返回 1; }
    // 206-c：复制(表达式) 泛型克隆内置展开（字符串=符号改写返回假，主链内置
    //   路径完成；标量/容器/结构体=终结发射返回真）
    如果 (生成复制展开(池, n, 位置, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈)) { 返回 1; }
    整32 折叠r = 0;
    如果 (生成类型大小折叠(池, n, 位置, 指令, 寄存器计数, 表达式栈, 折叠r)) { 返回 折叠r; }
    // 函数/方法调用（2026-09-01 用户裁决项3 参数区改造）：弹实参（倒序）入
    //   弹出们，逐个发射 IR_调用实参(64)（位号声明性标注），IR_调用参数化(63)
    //   收尾——任意实参数（7 组件源码 8 参函数）；普通调用与方法调用统一路径。
        // 函数/方法调用（2026-09-01 用户裁决项3 参数区改造）：弹实参（倒序）入
        //   弹出们，逐个发射 IR_调用实参(64)（位号声明性标注），IR_调用参数化(63)
        //   收尾——任意实参数（7 组件源码 8 参函数）；普通调用与方法调用统一路径。
        整64 实参数 = n.附加;
        向量<整64> 弹出们 = 向量<整64>();
        整64 弹i = 0;
        当 (弹i < 实参数 && 表达式栈.大小() > 0) {
            结果<空类型, 整32> 加弹 = 弹出们.追加(表达式栈.元素(表达式栈.大小() - 1));
            如果 (!加弹.正常) { 运行时错误(4); }
            结果<空类型, 整32> 删弹 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删弹.正常) { 运行时错误(4); }
            弹i++;
        }
        整64 被调 = 0;
        如果 (表达式栈.大小() > 0) {
            被调 = 表达式栈.元素(表达式栈.大小() - 1);
            结果<空类型, 整32> 删被调 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删被调.正常) { 运行时错误(4); }
        }
        // T69（480-a 深度机）：实参位函数名收口（负占位=函数名作实参 → IR_函数地址
        //   寄存器；宿主 checkFunctionNameValue 同义）——普通调用/方法调用两路共用
        实参负占位收口480(指令, 寄存器计数, 弹出们);
        // ---- 方法调用：被调是方法标记（-(10^6+方法名ID)），标记下压着 this ----
    // ---- 方法调用：被调是方法标记（-(10^6+方法名ID)），标记下压着 this ----
    如果 (被调 <= -1000000) {
        生成方法调用(池, n, 位置, 被调, 弹出们, n.附加, 局部槽, 参数槽, 指令, 寄存器计数,
                    槽计数, 表达式栈, retbuf序号);
        // 81-a-v2：实参位置返回物化槽的串字段释放（调用发射后；含「外层调用返回值
        //   覆盖 retbuf」场景的独立副本所有权收口）
        清理调用实参临时(弹出们, 指令, 寄存器计数);
        返回 1;
    }
        如果 (被调 >= 0) {
            // 104/440（070 波C）：方法引用闭包调用展开——被调变量在 闭包绑定表
            //   → 直调方法符号（this=对象槽+用户实参·宿主 ir_call.cpp 闭包展开
            //   同构）；miss 走 T69 间接调用。
            如果 (方法引用闭包调用展开(池, n, 弹出们, 局部槽, 参数槽, 指令,
                                   寄存器计数, 槽计数, 表达式栈) == 1) {
                清理调用实参临时(弹出们, 指令, 寄存器计数);
                返回 1;
            }
            // T69（480-a 深度机）：函数指针间接调用——被调弹到寄存器值（函数
            //   指针槽装载产物/函数地址寄存器）= 经指针调用（宿主 ir_call.cpp
            //   CallIndirect 同构）；三后端按 附加 装载指针到临时寄存器后
            //   call reg（装载晚于实参，防覆盖）。
            发射间接调用480(池, n, 被调, 弹出们, 指令, 寄存器计数, 槽计数,
                          表达式栈);
            清理调用实参临时(弹出们, 指令, 寄存器计数);
            返回 1;
        }
        整64 函数符号 = 0 - 被调;
    // 打印族/内置函数（R3 提取）：命中即处理返回 1
    如果 (生成打印与内置调用(池, 函数符号, 弹出们, n.附加, 指令, 寄存器计数, 表达式栈) == 1) {
        返回 1;
    }
    // ---- 呈报③方案A：用户函数重载决议（2026-09-06）——决议歧义/失败
    //      已在决议内 IR层诊断（fail fast），0=中止
    整64 键基c = 0; 整64 键串c = 0; 整64 段数c = 0;
    函数符号 = 决议函数符号(池, 函数符号, 整32(位置), 键基c, 键串c, 段数c);
    如果 (函数符号 == 0) { 返回 0; }
    补默认参数实参(池, n, 弹出们, 键基c, 键串c, 段数c, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    // 309：类构造默认参数补缺（377/568·宿主 D23 同构·本体在 生成函数.cn）
    补类构造默认实参(池, n, 弹出们, 函数符号, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    // 类型转换/构造调用（R3 提取·实参数=弹出们.大小()：补缺后含补段·修前 n.附加 脱节）
    如果 (生成转换或构造调用(函数符号, 弹出们, 弹出们.大小(), 指令, 寄存器计数, 槽计数,
                             表达式栈) == 1) {
        返回 1;
    }
    // 普通函数调用（R3 提取）
    发射普通函数调用(弹出们, 函数符号, 弹出们.大小(), 指令, 寄存器计数, 槽计数,
                     表达式栈, retbuf序号);
    // 81-a-v2：实参位置返回物化槽的串字段释放（调用发射后）
    清理调用实参临时(弹出们, 指令, 寄存器计数);
    返回 1;
}

// 212-a：族① 显式转移 转移(变量) 展开（plans/019 阶段1）——弹 2 个压栈残留
//   （实参值+被调负符号）、实参值压回=转移调用求值结果（纯编译期零指令）。
//   返回 1=已处理；-1=非转移形态（主函数继续原链）。
// 977（008 总攻·576·对齐宿主 096）：升级真槽位交接——弹 2 压 1 之外源槽清零
//   （moved-from 旧名禁用·后继读空句柄=空安全）。两路分派（解析标识符类型ID）：
//   ①类/容器/字符串/指针=直拷+单槽清零；②内联结构体=先物化副本再清零源（新
//   槽组+IR_结构体拷贝+源槽组清零+压副本基址——清零早于回扫取地址会拷全零·
//   时序铁律·宿主 096 tmp 物化同款）。
//   声明位（生成声明 浅交接）/赋值位（963 特判）不走本函数=不受影响。
//   返回 1=已处理；-1=非转移形态（主函数继续原链）。
不安全 函数 生成转移展开(向量<节点> 池, 节点 n, 整32 位置, 映射<整64, 整64>& 局部槽,
                        映射<整64, 整64>& 参数槽, 向量<IR指令>& 指令,
                        整64* 寄存器计数, 整64* 块计数, 整64* 槽计数,
                        向量<整64>& 表达式栈) -> 布尔 {
        如果 (n.子起点 > 0 && n.附加 == 1) {
            节点 转被调 = 池.元素(整32(n.子起点));
            节点 转实参节点 = 池.元素(整32(n.子起点) + 1);
            // 1011（585·池布局修正）：成员链实参的池布局=[转移, h, 桶, 调用]
            //   ——n.子起点+1=h（标识符）非成员末节点；实参末节点经语义层
            //   实参末位表取（查调用实参末位·894 同款）——桶 成员节点。
            整64 末位585 = 查调用实参末位(整64(位置), 0);
            节点 转实参末585 = 转实参节点;
            如果 (末位585 > 0 && 末位585 < 整64(池.大小())) {
                转实参末585 = 池.元素(整32(末位585));
            }
            如果 (转被调.类型 == 节点_标识符 &&
                 字符串比较(驻留文本(整64(转被调.文本)), "转移") &&
                 转实参末585.类型 == 节点_成员) {
                // 1011（585·转移成员源）：977 真槽位交接的成员链扩展——
                //   转移(h.桶) 形态原整个 miss（只认 节点_标识符）→主链
                //   兜底旧路径=句柄交接无清零（h.桶 悬垂·字符串长度(h.桶)
                //   读已释放→fault=0/垃圾）。修：栈顶成员读值（字符串句柄）
                //   直通交接+源=成员左值地址写字符串 0（空句柄=旧名禁用+
                //   空安全语义·977 ① 同款单值句柄清零）。
                如果 (表达式栈.大小() >= 2) {
                    整64 成员值585 = 表达式栈.元素(表达式栈.大小() - 1);
                    整64 删转i585 = 0;
                    当 (删转i585 < 2) {
                        结果<空类型, 整32> 删转585 = 表达式栈.删除(
                            表达式栈.大小() - 1);
                        如果 (!删转585.正常) { 运行时错误(4); }
                        删转i585++;
                    }
                    // 成员左值地址（链区间=[成员.子起点, 末位节点+1)——基名到成员）
                    整64 成员地址585 = 生成左值地址(
                        池, 整32(转实参末585.子起点), 整32(末位585) + 1,
                        局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数,
                        表达式栈);
                    整64 零585 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0,
                                         零585, T_整64, 0));
                    IR追加(指令, 建IR指令(IR_指针存储, 成员地址585, 零585,
                                         0, 0, T_字符串, 0));
                    结果<空类型, 整32> 加成员585 = 表达式栈.追加(成员值585);
                    如果 (!加成员585.正常) { 运行时错误(4); }
                }
                返回 真;
            }
            如果 (转被调.类型 == 节点_标识符 && 转实参节点.类型 == 节点_标识符 &&
                 字符串比较(驻留文本(整64(转被调.文本)), "转移")) {
                如果 (表达式栈.大小() >= 2) {
                    整64 转实参值 = 表达式栈.元素(表达式栈.大小() - 1);
                    整64 删转i = 0;
                    当 (删转i < 2) {
                        结果<空类型, 整32> 删转 = 表达式栈.删除(表达式栈.大小() - 1);
                        如果 (!删转.正常) { 运行时错误(4); }
                        删转i++;
                    }
                    // 977：源槽清零（真槽位交接）——源槽解析（局部→参数）
                    整64 源名977 = 整64(转实参节点.文本);
                    整64 源槽977 = 0;
                    结果<整64, 整32> 找局977 = 局部槽.获取(源名977);
                    如果 (找局977.正常) { 源槽977 = 找局977.值; }
                    如果 (源槽977 == 0) {
                        结果<整64, 整32> 找参977 = 参数槽.获取(源名977);
                        如果 (找参977.正常) { 源槽977 = 找参977.值; }
                    }
                    整64 源类型977 = 解析标识符类型ID(源名977);
                    字符串 源类型文本977 = 字符串复制(驻留文本(源类型977));
                    布尔 内联结构977 = 查结构体大小(源类型977) > 0 &&
                                       !是用户类(源类型文本977) &&
                                       !是容器类(源类型文本977);
                    如果 (源槽977 > 0 && 内联结构977) {
                        // ②内联结构体=先物化副本再清零源（096 模型）
                        整64 大小977 = 查结构体大小(源类型977);
                        整64 槽数977 = (大小977 + 7) / 8;
                        整64 副槽起977 = 槽计数[0];
                        槽计数[0] = 槽计数[0] + 槽数977;
                        整64 a977 = 0;
                        当 (a977 < 槽数977) {
                            IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0,
                                                 副槽起977 + a977));
                            a977++;
                        }
                        整64 副基址977 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_取地址, 副槽起977 + 槽数977 - 1,
                                             0, 0, 副基址977, T_整64, 0));
                        整64 源基址977 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_取地址, 源槽977, 0, 0,
                                             源基址977, T_整64, 0));
                        IR追加(指令, 建IR指令(IR_结构体拷贝, 源基址977,
                                             副基址977, 0, 0, 大小977, 0));
                        // 源槽组清零（基槽=最大槽号）
                        整64 零977 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0,
                                             零977, T_整64, 0));
                        整64 z977 = 0;
                        当 (z977 < 槽数977) {
                            IR追加(指令, 建IR指令(IR_存储, 零977, 0, 0, 0, 0,
                                                 源槽977 - 槽数977 + 1 + z977));
                            z977++;
                        }
                        结果<空类型, 整32> 加副977 = 表达式栈.追加(副基址977);
                        如果 (!加副977.正常) { 运行时错误(4); }
                        返回 真;
                    }
                    如果 (源槽977 > 0) {
                        // ①单值句柄槽=直拷+单槽清零
                        整64 零977b = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0,
                                             零977b, T_整64, 0));
                        IR追加(指令, 建IR指令(IR_存储, 零977b, 0, 0, 0, 0,
                                             源槽977));
                    }
                    结果<空类型, 整32> 加转 = 表达式栈.追加(转实参值);
                    如果 (!加转.正常) { 运行时错误(4); }
                }
                返回 真;
            }
        }

    返回 假;
}

// 206-c（波 4·plans/020 第七十二节 §二）：族③ 复制(表达式) 泛型克隆内置展开
//   （n.子终点=语义层 检查复制调用 写入的实参类型 ID；与 转移(x) 显式
//   「复制/移动」双内置，Rust Clone::clone 同构）。按类型分派（栈顶=实参值、
//   其下=被调负符号——与 转移展开 同线性求值序）：
//     ①标量/指针（可平凡复制）=直通（弹被调残留，实参值留栈顶=求值结果，
//       零运行时指令——转移展开同款）；
//     ②字符串=被调符号改写为「字符串复制」（主链弹参+内置路径照常发射
//       __cn_str_copy 落堆独立拥有；返回 假=本次不终结）；
//     ③容器/类=栈顶对象指针入 hold 槽 → NewObject + 拷贝构造(2 实参，源=T&
//       左值地址——宿主 genCopyBuiltin 调用返回形态同款 hold 槽取地址) → 新
//       对象指针压栈（调用方按调用返回接管，独立拥有，零共享）；
//     ④结构体（含结果/可选合成）=栈顶源地址 → 新槽（按结构体大小逐槽分配）→
//       整体拷贝 + 串字段深拷（递归，全局资源字段表设施）→ 槽地址压栈。
//   返回 真=已处理（终结）；假=非复制形态或字符串改写（主链继续）。
// 532-a（D1 滚动·机械拆分零行为变更）：生成复制展开 175 行→主函数+四路子函数
//   （逐字迁移·等价红线=新旧 v2p 编译同输入 asm md5 一致）·四路互斥·② 命中
//   返回 假=主链继续·①③④ 终结。
不安全 函数 生成复制展开字符串改写(向量<整64>& 表达式栈) -> 布尔 {
    结果<空类型, 整32> 改写 = 表达式栈.设置(表达式栈.大小() - 2,
                                             0 - 驻留("字符串复制"));
    如果 (!改写.正常) { 运行时错误(4); }
    返回 假;
}
不安全 函数 生成复制展开标量直通(向量<整64>& 表达式栈) -> 布尔 {
    整64 复值 = 表达式栈.元素(表达式栈.大小() - 1);
    整64 删i = 0;
    当 (删i < 2) {
        结果<空类型, 整32> 删 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删.正常) { 运行时错误(4); }
        删i++;
    }
    结果<空类型, 整32> 加v = 表达式栈.追加(复值);
    如果 (!加v.正常) { 运行时错误(4); }
    返回 真;
}
不安全 函数 生成复制展开容器类(向量<IR指令>& 指令, 整64* 寄存器计数,
                              整64* 槽计数, 向量<整64>& 表达式栈, 字符串 复类型文本) -> 布尔 {
    整64 复obj = 表达式栈.元素(表达式栈.大小() - 1);
    整64 删c = 0;
    当 (删c < 2) {
        结果<空类型, 整32> 删c2 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删c2.正常) { 运行时错误(4); }
        删c++;
    }
    整64 hold槽 = 槽计数[0];
    槽计数[0] = 槽计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, hold槽));
    IR追加(指令, 建IR指令(IR_存储, 复obj, 0, 0, 0, 0, hold槽));
    整64 hold地址 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_取地址, hold槽, 0, 0, hold地址, T_整64, 0));
    整64 新对象 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新对象,
                         容器对象大小(复类型文本), 驻留(复类型文本)));
    IR追加(指令, 建IR指令(IR_调用实参, 新对象, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用实参, hold地址, 0, 0, 0, 1, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                         驻留(方法符号(复类型文本, 合成名基名(复类型文本),
                                复类型文本 + "&"))));
    // 762-a（001 波·值差单环修复）：③ 产物（新对象句柄）补登记 结构体返回
    //   临时们（对齐 ④ 结构体物化的 462-a 登记单一归属）——下标左值写通道
    //   （348-a/761 续回退）按登记尺寸整体写 32B（值 数组[值索引] = 复制(...)
    //   的元素槽=完整符号值；未登记则 8B 句柄直写·值[0].类型 ID=0 实锤）。
    结果<空类型, 整32> 加o = 表达式栈.追加(新对象);
    如果 (!加o.正常) { 运行时错误(4); }
    返回 真;
}
不安全 函数 生成复制展开结构体物化(向量<节点> 池, 节点 n, 整32 位置,
                              映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                              向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数,
                              整64* 槽计数, 向量<整64>& 表达式栈, 字符串 复类型文本) -> 布尔 {
    整64 删s = 0;
    当 (删s < 2) {
    结果<空类型, 整32> 删s2 = 表达式栈.删除(表达式栈.大小() - 1);
    如果 (!删s2.正常) { 运行时错误(4); }
    删s++;
    }
    整64 复结构ID = 查结构体类型(驻留(复类型文本));
    如果 (复结构ID == 0) {
    // 466-a（T70 面⑥·双表不对称根治）：查结构体类型（语法层表·无候选
    //   回退）miss 时用 结构体布局键基（IR 层三级：本模块键基＞直查＞
    //   候选唯一公开）——与 可信判定 查结构体大小 同源（跨模块私有外
    //   泄面=公开强制，语义层已设防）；键基 ID 即布局/字段分桶键。
    复结构ID = 结构体布局键基(驻留(复类型文本));
    }
    如果 (复结构ID == 0) {
    // 未知结构体（合成类型未登记等）——退回常量 0 占位（防御：不产坏 IR）
    结果<空类型, 整32> 加s = 表达式栈.追加(0);
    如果 (!加s.正常) { 运行时错误(4); }
    返回 真;
    }
    整64 复源地址 = 生成左值地址(池, 整32(n.子起点) + 1, 位置, 局部槽, 参数槽,
                            指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    整64 复结构大小 = 查结构体大小(复结构ID);
    整64 复槽数 = (复结构大小 + 7) / 8;
    如果 (复槽数 <= 0) { 复槽数 = 1; }
    整64 复槽起 = 槽计数[0];
    槽计数[0] = 槽计数[0] + 复槽数;
    整64 复z = 0;
    当 (复z < 复槽数) {
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 复槽起 + 复z));
    复z++;
    }
    整64 复新基址 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_取地址, 复槽起 + 复槽数 - 1, 0, 0, 复新基址, T_整64, 0));
    发射复制结构体深拷(指令, 寄存器计数, 复新基址, 复源地址, 复结构ID, 0);
    // 462-a（T70 面②根治）：④ 分支物化基址补登记 结构体返回临时们——与 生成调用
    //   返回结构体物化登记（1152·82-a/85-a 链）同款单一归属；漏登记后果=348-a
    //   D11 整体写通道（下标/成员/赋值位）查源 miss→「右值（调用返回）非结构体
    //   返回值」误诊断（撤守卫态容器克隆体 `数据[i] = 复制(...)` 实证）。
    结果<空类型, 整32> 设临r = 结构体返回临时们.设置(复新基址, 复结构ID);
    如果 (!设临r.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加s2 = 表达式栈.追加(复新基址);
    如果 (!加s2.正常) { 运行时错误(4); }
    返回 真;
}

不安全 函数 生成复制展开(向量<节点> 池, 节点 n, 整32 位置, 映射<整64, 整64>& 局部槽,
                 映射<整64, 整64>& 参数槽, 向量<IR指令>& 指令, 整64* 寄存器计数,
                 整64* 块计数, 整64* 槽计数,
                 向量<整64>& 表达式栈) -> 布尔 {
    如果 (!(n.子起点 > 0 && n.附加 == 1)) { 返回 假; }
    节点 复被调 = 池.元素(整32(n.子起点));
    如果 (复被调.类型 != 节点_标识符) { 返回 假; }
    如果 (!字符串比较(驻留文本(整64(复被调.文本)), "复制")) { 返回 假; }    如果 (表达式栈.大小() < 2) { 返回 假; }
    // 432-b：子终点=0（语义回填失败置零）不再 early-return——落入下方实参推导兜底
    字符串 复类型文本 = "";
    如果 (n.子终点 > 0) {
        复类型文本 = 字符串复制(驻留文本(整64(n.子终点)));
    }
    // 432-b 根治：子终点 语义标注**仅在成功时回填类型文本 ID**；未成功（基类
    //   泛型实参 K/V/T 不可解析）保持 调用节点原值=参数段末**池索引**——读出
    //   驻留文本=无关垃圾。判据改为「类型可信」：文本须命中任一分派族
    //   （标量/字符串/容器/结构体），否则一律走实参推导兜底。
    布尔 复类型可信d = 假;
    如果 (字符串长度(复类型文本) > 0) {
        复类型可信d = 可平凡复制v2(复类型文本) || 字符串比较(复类型文本, "字符串") ||
                    是容器类(复类型文本) ||
                    查结构体大小(整64(驻留(复类型文本))) != 0;
    }
    // 466-a（T70 面⑥·窄域剥层·前移至可信判定前）：标注/推导文本引用尾 '&'
    //   （方法形参类型标注形态）——不剥则 可信判定 查结构体大小 对 "货舱依赖&"
    //   形态 miss→误走推导；④ 查结构体类型 同 miss→防御 0 无物化登记→
    //   348-a 查源=0 误诊（fix_p 货舱依赖/符号 克隆体实证）。仅本函数局部。
    {
        整64 复长466 = 字符串长度(复类型文本);
        当 (复长466 > 1 && ((整64(复类型文本[整32(复长466 - 1)]) & 255) == 38)) {
            复类型文本 = 字符串子串(复类型文本, 0, 整32(复长466 - 1));
            复长466--;
        }
    }
    如果 (!复类型可信d) {
        复类型文本 = "";
        // 432-b（撤守卫·克隆体）：语义标注发生在实例化前的基类体（泛型实参
        //   K/V 不可解析→子终点=0 未标注）——实参表达式类型推导兜底：
        //   下标实参（其他.键数组[i]）先推导成员链父类型再剥指针层；其余直推。
        节点 复实参 = 池.元素(整32(n.子起点) + 1);
        整64 复类型推导 = 0;
        如果 (复实参.类型 == 节点_下标 && 复实参.子起点 > 0) {
            // 462-a（T70 面②深化）：下标实参元素类型统一走 97-a 推导下标元素
            //   类型ID（数组/指针变量/成员链指针对象三形态+432-b 剥 * 兜底）——
            //   原对整段做成员链推导漏下标剥层（容器克隆体 `复制(其他.数据[i])`
            //   实证：推导得容器类型 向量$外盒 ≠ 元素 外盒→③ 容器分支错入）。
            复类型推导 = 推导下标元素类型ID(池, 整32(复实参.子起点));
            字符串 父文本d = 字符串复制(驻留文本(复类型推导));
            整64 父长d = 字符串长度(父文本d);
            如果 (父长d > 0 && ((整64(父文本d[整32(父长d - 1)]) & 255) == 42)) {
                复类型推导 = 整64(驻留(字符串子串(父文本d, 0, 整32(父长d - 1))));
            }
        } 否则 {
            // 462-a（T70 面②）：实参=顺序链——类型推导须传链尾（递归出口=全
            //   链类型）；原传段根只推得根类型（复制(其他.数据[i]) 实证·③ 容器
            //   分支错入）。防御：子终点双语义（未标注=段末池索引/已标注=类型
            //   文本 ID）——段末越域回退链根（保守零回归）。
            // 466-a（T70 面⑥·锚修正）：链尾=位置-1（调用节点池索引恒可靠）
            //   ——原 n.子终点-1 在语义标注态=类型文本 ID-1（池内无关位置·
            //   推导出容器根类型实证）；实参链=[子起点+1, 位置) 恒成立。
            整64 段末d = 位置 - 1;
            如果 (段末d > n.子起点 && 段末d < 整64(池.大小())) {
                复类型推导 = 推导成员链类型ID(池, 整32(段末d));
            } 否则 {
                复类型推导 = 推导成员链类型ID(池, 整32(n.子起点) + 1);
            }
        }
        如果 (复类型推导 > 0) {
            复类型文本 = 字符串复制(驻留文本(复类型推导));
        }
    }
    如果 (字符串长度(复类型文本) == 0) {        返回 假;
    }
    // ② 字符串：被调符号改写为 字符串复制（主链弹参+内置路径完成 __cn_str_copy）
    // 854 LUE（任务 054 波1·〔基准=019〕第四句 (a)）：语义层判定标记（实参节点
    //   .修饰=1=纯局部标识符+后向无读点）→ move 发射：源槽句柄直取压栈+源槽
    //   清零——族②③④的深拷全部跳过（析构归新持有者·值语义无观察差异）。
    //   槽不可解析（静态等）时该函数返回假保守回退主链（深拷照旧）。
    节点 复LUE实参 = 池.元素(整32(n.子起点) + 1);
    // 857 限面 → 078（934·008 总攻第二轮）解除：字符串/容器=单句柄搬迁
    //   （生成复制展开LUEmove）；结构体（族④·多槽内嵌对象）=整块搬迁+源槽
    //   全清零（生成复制展开结构体LUEmove·含拥有字段句柄直移=所有权交接）。
    //   结构体 ID 解析 miss（含 466-a 键基回退）返回假=保守回退 ④ 深拷。
    如果 (复LUE实参.类型 == 节点_标识符 && 复LUE实参.修饰 == 1 &&
          (字符串比较(复类型文本, "字符串") || 是容器类(复类型文本))) {
        返回 生成复制展开LUEmove(池, n, 位置, 局部槽, 参数槽, 指令, 寄存器计数,
                              块计数, 槽计数, 表达式栈);
    }
    如果 (复LUE实参.类型 == 节点_标识符 && 复LUE实参.修饰 == 1 &&
          查结构体大小(驻留(复类型文本)) != 0) {
        返回 生成复制展开结构体LUEmove(池, n, 位置, 局部槽, 参数槽, 指令,
                                   寄存器计数, 块计数, 槽计数, 表达式栈,
                                   复类型文本);
    }
    // ② 字符串：被调符号改写为 字符串复制（主链弹参+内置路径完成 __cn_str_copy）
    如果 (字符串比较(复类型文本, "字符串")) { 返回 生成复制展开字符串改写(表达式栈); }
    // ① 标量/指针：直通（值语义天然，零运行时指令）
    // 496-a（T70 B1·可平凡结构体不走直通）：① 直通的 复值=下标读值（非元素
    //   地址）——结构体形态（查结构体大小≠0）登记值当地址=整体拷贝读垃圾
    //   （124 首版产物 rc=102 实证）→结构体排除出直通、落 ④ 物化+登记（与
    //   Token 同路径·复制语义完整·基类型直通零影响）。
    如果 (可平凡复制v2(复类型文本) && 查结构体大小(驻留(复类型文本)) == 0) { 返回 生成复制展开标量直通(表达式栈); }
    // ③ 容器/类：栈顶对象指针 → hold 槽取地址 → NewObject + 拷贝构造
    如果 (是容器类(复类型文本)) { 返回 生成复制展开容器类(指令, 寄存器计数, 槽计数, 表达式栈, 复类型文本); }
    // ④ 结构体（含结果/可选合成）：实参左值地址 → 新槽 → 整体拷贝+串字段深拷。
    //   ★实参地址重新求值（v2 表达式位结构体标识符求值压首槽值=既有第一版
    //   边界；左值地址设施 生成左值地址 按实参区间 [子起点+1, 调用位置) 发射
    //   ——stdlib 拷贝构造切换全需求=place 形态标识符/成员/下标）。
    返回 生成复制展开结构体物化(池, n, 位置, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈, 复类型文本);
}

// 854 LUE move 发射（任务 054 波1·〔基准=019〕第四句 (a)）：x=纯局部标识符
//   （语义层已判定「池后向无读点」=最后使用）——句柄直取（源槽值压栈）+
//   源槽清零（move 语义：析构归新持有者·源槽空→出口析构跳过·NRVO 同构）。
//   槽解析序=局部槽→参数槽（与 生成左值地址 标识符分支同序）；解析不到
//   （静态 .data 等无槽形态）返回假=保守回退主链深拷（不消除）。
不安全 函数 生成复制展开LUEmove(向量<节点> 池, 节点 n, 整32 位置,
                        映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                        向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数,
                        整64* 槽计数, 向量<整64>& 表达式栈) -> 布尔 {
    节点 转被调节点986 = 池.元素(整32(n.子起点));
    节点 转实参986 = 池.元素(整32(n.子起点) + 1);
    // 986 成员源（008 挂账②·宿主 959 同款三指令语义）：成员值已由表达式
    //   求值 Load 压栈（=转移值）——补**成员槽清零**（所有权交接·接收方
    //   出口对零句柄空安全跳过幂等模型）；地址=生成左值地址 重生成（多一次
    //   Load 无害·正确性优先）。编译期成员旧名拦截=诚实边界随 LUE 精确化。
    布尔 成员源g987 = 假;
    如果 (转被调节点986.类型 == 节点_标识符 &&
         字符串比较(驻留文本(整64(转被调节点986.文本)), "转移")) {
        如果 (转实参986.类型 == 节点_成员) {
            成员源g987 = 真;
        } 否则 如果 (转实参986.类型 == 节点_标识符 &&
                    整32(n.子起点) + 2 < 整32(池.大小())) {
            节点 后继g987 = 池.元素(整32(n.子起点) + 2);
            如果 (后继g987.类型 == 节点_成员 && 后继g987.子起点 == 整32(n.子起点) + 1) {
                成员源g987 = 真;
            }
        }
    }
    如果 (成员源g987) {
        整64 成员地址986 = 生成左值地址(池, 整32(n.子起点) + 1,
            整32(n.子起点) + 3, 局部槽, 参数槽, 指令, 寄存器计数,
            块计数, 槽计数, 表达式栈);
        整64 零986 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零986, T_整64, 0));
        IR追加(指令, 建IR指令(IR_指针存储, 成员地址986, 零986, 0, 0, T_整64, 0));
        整64 删m986 = 0;
        当 (删m986 < 2) {
            结果<空类型, 整32> 删栈986 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈986.正常) { 运行时错误(4); }
            删m986++;
        }
        返回 真;
    }
    节点 x节点 = 池.元素(整32(n.子起点) + 1);
    整64 xID = 整64(x节点.文本);
    整64 源槽 = 0;
    结果<整64, 整32> 查局L = 局部槽.获取(xID);
    如果 (查局L.正常) {
        源槽 = 查局L.值;
    } 否则 {
        结果<整64, 整32> 查参L = 参数槽.获取(xID);
        如果 (查参L.正常) {
            源槽 = 查参L.值;
        } 否则 {
            返回 假;
        }
    }
    整64 move值 = 表达式栈.元素(表达式栈.大小() - 1);
    // 净栈契约对齐族③：弹 2（被调残留+实参值）再压 1（move 结果）
    整64 删m = 0;
    当 (删m < 2) {
        结果<空类型, 整32> 删m2 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删m2.正常) { 运行时错误(4); }
        删m++;
    }
    // 854 修正（asm 实证）：IR_存储 操作数1=0 会被代码生成当「槽 0」读
    //   （`mov rax,[rbp-8]`·未初始化垃圾→出口析构 free(垃圾)=0xC0000374）——
    //   清零须走 IR_常量整数（Symbol "0"→立即数）+ IR_存储 寄存器。
    整64 零寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零寄存器, T_整64, 0));
    IR追加(指令, 建IR指令(IR_存储, 零寄存器, 0, 0, 0, 0, 源槽));
    结果<空类型, 整32> 加m = 表达式栈.追加(move值);
    如果 (!加m.正常) { 运行时错误(4); }
    返回 真;
}

// 078（934·008 第二轮·857 限面解除）：结构体 LUE move——整块搬迁零拷贝：复槽
//   分配+IR_结构体拷贝 位拷（句柄直移=所有权交接·跳过字段深拷——LUE 前提=源
//   不再用·无别名）+源槽全清零（逐槽 常量0→存储——854 口径：操作数直接 0 会被
//   当「槽 0」读）+压栈复槽基址（弹 2 压 1）。源槽地址=起+槽数-1（82-a 纪律）。
//   槽不可解析/结构体 ID miss 返回假=保守回退 ④ 深拷。
不安全 函数 生成复制展开结构体LUEmove(向量<节点> 池, 节点 n, 整32 位置,
                        映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                        向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数,
                        整64* 槽计数, 向量<整64>& 表达式栈, 字符串 复类型文本) -> 布尔 {
    节点 x节点 = 池.元素(整32(n.子起点) + 1);
    整64 xID = 整64(x节点.文本);
    整64 源槽 = 0;
    结果<整64, 整32> 查局78 = 局部槽.获取(xID);
    如果 (查局78.正常) {
        源槽 = 查局78.值;
    } 否则 {
        结果<整64, 整32> 查参78 = 参数槽.获取(xID);
        如果 (查参78.正常) {
            源槽 = 查参78.值;
        } 否则 {
            返回 假;
        }
    }
    整64 结构ID78 = 查结构体类型(驻留(复类型文本));
    如果 (结构ID78 == 0) {
        结构ID78 = 结构体布局键基(驻留(复类型文本));
    }
    如果 (结构ID78 == 0) { 返回 假; }
    整64 结构大小78 = 查结构体大小(结构ID78);
    如果 (结构大小78 <= 0) { 返回 假; }
    整64 复槽数78 = (结构大小78 + 7) / 8;
    整64 复槽起78 = 槽计数[0];
    槽计数[0] = 槽计数[0] + 复槽数78;
    整64 复a78 = 0;
    当 (复a78 < 复槽数78) {
        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 复槽起78 + 复a78));
        复a78++;
    }
    整64 复新基址78 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_取地址, 复槽起78 + 复槽数78 - 1, 0, 0, 复新基址78, T_整64, 0));
    // 源基址：局部槽/参数槽 登记的是**基槽=最大槽号（低地址）**（913-a 口径：
    //   「局部槽.设置(名, 槽起+槽数-1)」）——基槽即结构体首字节，直接取地址；
    //   槽组区间=[基槽-槽数+1, 基槽]。
    整64 源基址78 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_取地址, 源槽, 0, 0, 源基址78, T_整64, 0));
    // 整块位拷贝（源读在清零前——防自拷中间态）
    IR追加(指令, 建IR指令(IR_结构体拷贝, 源基址78, 复新基址78, 0, 0, 结构大小78, 0));
    // 源槽全清零（854 修正口径）
    整64 零寄78 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零寄78, T_整64, 0));
    整64 清z78 = 0;
    当 (清z78 < 复槽数78) {
        IR追加(指令, 建IR指令(IR_存储, 零寄78, 0, 0, 0, 0, 源槽 - 复槽数78 + 1 + 清z78));
        清z78++;
    }
    // 净栈契约：弹 2（被调残留+实参值）再压 1（复新基址）
    整64 删s78 = 0;
    当 (删s78 < 2) {
        结果<空类型, 整32> 删s782 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删s782.正常) { 运行时错误(4); }
        删s78++;
    }
    结果<空类型, 整32> 设临78 = 结构体返回临时们.设置(复新基址78, 结构ID78);
    如果 (!设临78.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加基78 = 表达式栈.追加(复新基址78);
    如果 (!加基78.正常) { 运行时错误(4); }
    返回 真;
}

// 206-c：结构体深拷发射（复制 分派④/字段递归共用）——整体拷贝(memcpy) +
//   资源字段逐个深拷：字符串字段=__cn_str_copy 落堆独立（源保持拥有）；
//   嵌套含资源字段结构体（值语义内联）=递归；容器字段=NewObject+拷贝构造
//   （独立对象）；纯标量字段=memcpy 已覆盖。深度上限 4 防环（与 IR容器释放
//   资源字段设施同款）。全局资源字段表设施（取资源字段们）——不依赖函数IR。
不安全 函数 发射复制结构体深拷(向量<IR指令>& 指令, 整64* 寄存器计数,
                     整64 目标基址, 整64 源基址, 整64 结构体ID, 整64 深度) -> 空类型 {
    如果 (深度 > 4) { 返回; }
    IR追加(指令, 建IR指令(IR_结构体拷贝, 源基址, 目标基址, 0, 0,
                         查结构体大小(结构体ID), 0));
    向量<整64> 字段们 = 向量<整64>();
    取资源字段们(结构体ID, 字段们);
    整64 f = 字段们.大小();
    当 (f > 0) {
        f -= 3;
        整64 字段类型ID = 字段们.元素(f + 1);
        整64 偏移 = 字段们.元素(f + 2);
        字符串 字段类型文本 = 字符串复制(驻留文本(字段类型ID));
        如果 (字符串比较(字段类型文本, "字符串")) {
            整64 源地址c = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_字段地址, 源基址, 0, 0, 源地址c, T_整64, 偏移));
            整64 源串 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 源地址c, 0, 0, 源串, T_字符串, 0));
            整64 新串 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_调用实参, 源串, 0, 0, 0, 0, 0));
            IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 新串, 0,
                                 驻留("__cn_str_copy")));
            整64 目标地址c = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_字段地址, 目标基址, 0, 0, 目标地址c, T_整64, 偏移));
            IR追加(指令, 建IR指令(IR_指针存储, 目标地址c, 新串, 0, 0, T_整64, 0));
        } 否则 如果 (资源字段数(字段类型ID) > 0) {
            整64 源地址n = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_字段地址, 源基址, 0, 0, 源地址n, T_整64, 偏移));
            整64 目标地址n = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_字段地址, 目标基址, 0, 0, 目标地址n, T_整64, 偏移));
            发射复制结构体深拷(指令, 寄存器计数, 目标地址n, 源地址n,
                            字段类型ID, 深度 + 1);
        } 否则 如果 (是容器类(字段类型文本)) {
            整64 源地址k = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_字段地址, 源基址, 0, 0, 源地址k, T_整64, 偏移));
            整64 源obj = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 源地址k, 0, 0, 源obj, T_对象, 0));
            整64 新对象k = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新对象k,
                                 容器对象大小(字段类型文本), 字段类型ID));
            IR追加(指令, 建IR指令(IR_调用实参, 新对象k, 0, 0, 0, 0, 0));
            IR追加(指令, 建IR指令(IR_调用实参, 源地址k, 0, 0, 0, 1, 0));
            IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                                 驻留(方法符号(字段类型文本, 合成名基名(字段类型文本),
                                        字段类型文本 + "&"))));
            整64 目标地址k = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_字段地址, 目标基址, 0, 0, 目标地址k, T_整64, 偏移));
            IR追加(指令, 建IR指令(IR_指针存储, 目标地址k, 新对象k, 0, 0, T_整64, 0));
        }
    }
}

// 212-a：族② 类型大小(类型名) 编译期折叠（规格 02-六B，宿主 A-3 SizeofExpr 同义）——
//   弹 2 个压栈残留（根治栈底残留）+常量压栈。返回 1=已处理；0=未知类型中止；
//   -1=非折叠形态（主函数继续原链）。
不安全 函数 生成类型大小折叠(向量<节点> 池, 节点 n, 整32 位置, 向量<IR指令>& 指令, 整64* 寄存器计数,
                     向量<整64>& 表达式栈, 整32& 结果r) -> 布尔 {
        如果 (n.子起点 > 0 && n.附加 == 1) {
            节点 折叠被调 = 池.元素(整32(n.子起点));
            节点 折叠实参 = 池.元素(整32(n.子起点) + 1);
            // 967（002·57 转批）：数组类型名实参（类型大小(整64[5])）——AST=
            //   下标节点（区间后缀序=[类型名标识符, 长度字面量]·下标节点自身
            //   在区间后）：宽度=类型名宽度(基名)×长度（对齐宿主编译期求值；
            //   原只认标识符形态→下标通道运行期越界 错误码2）。指针类型名实参
            //   （类型大小(整32*)）= 标识符+剥尾 '*' 文本（解析层实参位类型
            //   记号保留星号）→ 8。
            如果 (折叠被调.类型 == 节点_标识符 && 折叠实参.类型 == 节点_标识符 &&
                 字符串比较(驻留文本(整64(折叠被调.文本)), "类型大小")) {
                // 967：宽度=类型名宽度（数组文本「整64[5]」经数组分支=元素宽×
                //   长度；语义层已把下标形实参改写为标识符文本）
                整64 宽度 = 类型名宽度(整64(折叠实参.文本));
                // 309（305 同构补齐·零分叉红线·家机 285 集成代修）：类型大小收
                //   变量——实参=局部/参数变量名时经函数级变量类型权威表按声明类
                //   型求宽（宿主 305 visitSizeofExpr 变量形态同构·sizeof(表达式)
                //   对照）；查无变量（-1）保持原诊断（IR 层中止纪律不变）。
                如果 (宽度 == 0) {
                    整64 变量类型 = 查当前函数变量类型(整64(折叠实参.文本));
                    如果 (变量类型 > 0) { 宽度 = 类型名宽度(变量类型); }
                }
                如果 (宽度 == 0) {                    IR层诊断("类型大小: 未知类型 " +
                                  驻留文本(整64(折叠实参.文本)) +
                                  " 节点类型=" + 整数转字符串(整64(折叠实参.类型)) +
                                  " [宿主=" + 驻留文本(取当前生成符号ID()) + "]");
                    结果r = 0;   // IR 层错误即中止纪律：诊断计数后继续收集，主.cn 统一中止
                返回 真;
                }
                整64 折叠i = 0;
                // 弹 2 个压栈残留：实参（类型名负符号）+ 被调（类型大小 负符号）
                //   ——根治栈底残留（原只弹 1 个，靠相对栈顶侥幸无害）
                当 (折叠i < 2 && 表达式栈.大小() > 0) {
                    结果<空类型, 整32> 删折 = 表达式栈.删除(表达式栈.大小() - 1);
                    如果 (!删折.正常) { 运行时错误(4); }
                    折叠i++;
                }
                整64 常量寄存器 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                // IR_常量整数 操作数1=值文本驻留ID（P7a 语义：代码生成经
                //   驻留文本 还原立即数）——宽度须先转文本再驻留
                IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(宽度)), 0, 0,
                                     常量寄存器, T_整64, 0));
                结果<空类型, 整32> 加折 = 表达式栈.追加(常量寄存器);
                如果 (!加折.正常) { 运行时错误(4); }
                结果r = 1;
                返回 真;
            }
        }

    返回 假;
}

