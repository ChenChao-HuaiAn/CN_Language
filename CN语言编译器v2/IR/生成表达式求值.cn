        // 194 修⑤（118 转 dual 链接 LNK2019 实锤）：容器基名排除——stdlib
        //   泛型体（向量$映射$整64$整64$读取）的 正常(T 值) 装箱，T 实例
        //   （映射$整64$整64）经类型解析面可能落**裸基名「映射」**→ 是用户类
        //   命中（0595-a 实例化注册）→ 107 误入深拷 → 发射 裸名拷贝构造符号
        //   `映射$映射$T映射&`（无定义侧·链接 miss）。容器实例（含裸名回退）
        //   =**句柄语义**（001 §5.3·宿主 ir 容器载荷同构）——非借用=8B 直存
        //   承接；**借用来源例外**（修⑧·探针 118i 实锤）：容器实例读取=副本
        //   语义同样须克隆（否则盒亡 delete 容器对象·双 free）——此时载荷
        //   ID=完整实例名（拷贝构造有定义侧·修⑤ 的链接 miss 系裸名形态）。
        如果 (是用户类(值类型71) &&
             (!是容器基名(合成名基名(值类型71)) || 借用来源107)) {
            载荷ID107 = 驻留(值类型71);
        } 否则 如果 (有标识符实参107) {
            整64 实型c107 = 查当前函数变量类型(整64(实参c107.文本));
            如果 (实型c107 > 0 && 是用户类(驻留文本(实型c107)) &&
                 (!是容器基名(合成名基名(驻留文本(实型c107))) || 借用来源107)) {
                载荷ID107 = 实型c107;
            }
        }
        如果 (载荷ID107 > 0) {
            // 类载荷=句柄 8B 直存（NewObject 指针·宿主 058-ⅡA 同构）——
            //   原 类型名宽度(类)>8 会走拷贝分支把「对象指针」当 16B 源地址深拷
            //   （rsi=对象指针 rep movsb 16B——读垃圾/踩栈·543 t1 VEH 崩实证）
            值宽71 = 8;
            // 107（任务 107·〔基准=019〕第 1 句+第 4 句双形态）：
            //   ①LUE 命中（语义层 107 标记·实参.修饰==1：纯局部类标识符+装箱点
            //   后向无同名出现+874 回边健全性同构）→ **句柄零拷移交**：盒=原对象
            //   唯一主人（8B 直存原路）+源槽清零（70-a 同款·防悬垂误读）+登记
            //   已装箱名（出口析构跳过）——宿主 551 s 形态（某些(s) 后不读）输出
            //   对齐（s 不打印）且**零拷贝零泄漏**（宿主现行「深拷+清零并存」=
            //   拷贝白花+原对象无主泄漏·1018 轮呈报立项不复刻）。
            //   ②LUE miss/返回位 → **深拷**（有析构∧有拷贝构造类：NewObject+
            //   拷贝构造·盒内独立副本+源照常可用照常析构=宿主 889/551 g 形态
            //   对齐）。原句柄直存+登记已装箱名（71-a move·源转交跳析构）与宿主
            //   深拷分叉（551 实测：v2 析构 3 次 vs 宿主 4 次·零分叉红线=以
            //   001/019 规范裁决：未显式 转移() 不自动 move·源照常可用）。
            //   无析构/无拷贝构造类（LUE miss 时）=不纳管（宿主同条件·句柄
            //   直存原路零回归）。存量扫描（795-a 纪律·1018 轮）：v2 树自身
            //   类值装箱=0·stdlib 泛型体标量/字符串载荷=0 受影响·tests 仅 551
            //   （本轮转批目标）——114 结构体/118 无析构类/211 字符串面不受影响。
            // 107→182（1019 裁决）：LUE 句柄移交撤除（asm 对位证伪·见语义层
            //   同款注释）——类值载荷恒走深拷（下方 有析构∧有拷贝构造 分派·
            //   宿主 889 同构），源照常可用照常析构。
            整64 拷贝串107 = 查类拷贝构造串(载荷ID107);
            // 194 修⑦（118 探针 N/E 家族实锤·CR374 双 free）：**借用来源载荷
            //   恒深拷**——容器元素读取位（下标 数据[位置]/成员链）的句柄=
            //   **容器拥有**（不分用户类/容器实例·修⑧ 前置判定），借用直存盒 →
            //   接收盒 946 盒亡 delete 容器对象 + ~容器 析构再 delete = 双 free
            //   （001 正交边界条文「容器元素读取返回副本（快照语义）」·宿主
            //   118 PASS=副本铁证）。门=有析构类（889 原路）∨ 借用来源，且
            //   有拷贝构造；无拷贝构造类仍不可克隆=退回直存（诚实边界维持）。
            如果 ((类有析构(载荷ID107) || 借用来源107) && 拷贝串107 != 0) {
                // 源=T& 句柄槽地址（拷贝构造被调方 [源] 解引用取句柄·698-a
                //   契约·生成容器拷贝构造 同款）：①标识符实参=回扫 IR_加载 取
                //   源槽→IR_取地址（081 守卫同款回扫+引用分流）；②表达式临时
                //   源（调用产物·617-a 调用点已拷贝构造=唯一持有·T_对象 登记）
                //   =句柄直移交零拷贝（临时无析构面·盒=唯一拥有者·宿主 889
                //   非标识符形态 lvalueAddress 对照）。成员/下标源形态回扫 miss
                //   退回句柄直存原路（诚实边界·宿主 898 同域 096 承载·存量零）。
                整64 源地址107 = 0;
                如果 (查寄存器类型(实参值71) == T_对象) {
                    源地址107 = 实参值71;
                } 否则 {
                    整64 回源槽107 = 0;
                    整64 回107 = 指令.大小();
                    当 (回107 > 0) {
                        IR指令 回扫107 = 指令.元素(回107 - 1);
                        如果 (回扫107.操作码 == IR_加载 && 回扫107.目标 == 实参值71) {
                            回源槽107 = 回扫107.操作数1;
                            中断;
                        }
                        回107--;
                    }
                    如果 (回源槽107 != 0) {
                        整64 地址reg107 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        如果 (槽是引用(回源槽107)) {
                            IR追加(指令, 建IR指令(IR_加载, 回源槽107, 0, 0,
                                                 地址reg107, T_整64, 0));
                        } 否则 {
                            IR追加(指令, 建IR指令(IR_取地址, 回源槽107, 0, 0,
                                                 地址reg107, T_整64, 0));
                        }
                        源地址107 = 地址reg107;
                    } 否则 {
                        // 194 修⑦（下标借用源回扫）：数据[位置] 的求值产物=
                        // IR_指针加载（目标=句柄值·操作数1=元素槽地址寄存器）
                        // ——元素槽**本身就是存句柄的槽**，其地址即拷贝构造
                        // T& 源契约（「存句柄的槽的地址」）——直接取 操作数1
                        // 为源地址（无额外发射·零开销）。
                        整64 回b107 = 指令.大小();
                        当 (回b107 > 0) {
                            IR指令 回扫b107 = 指令.元素(回b107 - 1);
                            如果 (回扫b107.操作码 == IR_指针加载 &&
                                 回扫b107.目标 == 实参值71) {
                                源地址107 = 回扫b107.操作数1;
                                中断;
                            }
                            回b107--;
                        }
                    }
                }
                如果 (源地址107 != 0) {
                    整64 新obj107 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新obj107,
                                         查结构体大小(载荷ID107), 载荷ID107));
                    // this=位0、源=位1（拷贝构造 T& 按引用位传·样板=617-a 调用点）
                    IR追加(指令, 建IR指令(IR_调用实参, 新obj107, 0, 0, 0, 0, 0));
                    IR追加(指令, 建IR指令(IR_调用实参, 源地址107, 0, 0, 0, 1, 0));
                    IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                                         驻留(方法符号(驻留文本(载荷ID107),
                                               剥实例基名(驻留文本(载荷ID107)),
                                               字符串复制(驻留文本(拷贝串107))))));
                    实参值71 = 新obj107;
                    类深拷107 = 真;
                }
                // 源地址未解析（静态源等形态·存量零）：退回句柄直存+登记 move
                //   原路（=71-a 现状行为·零回归）
            }
        } 否则 如果 (是容器类(值类型71)) {
            // 容器载荷=句柄 8B 直存（堆对象指针·与类同款）
            值宽71 = 8;
        } 否则 如果 (是结果类型(值类型71)) {
            值宽71 = 结果大小(值类型71);
            载荷须深拷 = 真;
        } 否则 {
            整64 结体大小71 = 查结构体大小(驻留(值类型71));
            如果 (结体大小71 != 0) {
                值宽71 = 结体大小71;
                载荷须深拷 = 真;
            }
        }
        如果 (载荷须深拷) {
            // 081 同构守卫（2026-09-29·880 轮·宿主 ir_error_ctor 嵌套守卫同轮）：
            //   实参=局部/参数聚合**标识符**时 生成标识符加载 产物=IR_加载 值读
            //   （数组/128 位有地址语义分支、局部合成体/结构体落默认值读）——深拷
            //   源必须是左值地址（结构体读=地址语义·宿主同款），把该 IR_加载 的源
            //   槽补发 IR_取地址（IR生成.cn 回扫实参取地址 B3/B8 同款判定与引用
            //   分流）。误伤面=零：寄存器 SSA 目标唯一，字面量构造（临时基址）/
            //   字段地址/调用返回/取地址形态均 miss 原样直通；三元地址化形态
            //   （86-a 登记 T_对象）不进回扫。
            如果 (查寄存器类型(实参值71) != T_对象) {
                整64 回扫源槽81 = 0;
                整64 回81 = 指令.大小();
                当 (回81 > 0) {
                    IR指令 回扫81 = 指令.元素(回81 - 1);
                    如果 (回扫81.操作码 == IR_加载 && 回扫81.目标 == 实参值71) {
                        回扫源槽81 = 回扫81.操作数1;
                        中断;
                    }
                    回81--;
                }
                如果 (回扫源槽81 != 0) {
                    整64 地址reg81 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    如果 (槽是引用(回扫源槽81)) {
                        IR追加(指令, 建IR指令(IR_加载, 回扫源槽81, 0, 0,
                                             地址reg81, T_整64, 0));
                    } 否则 {
                        IR追加(指令, 建IR指令(IR_取地址, 回扫源槽81, 0, 0,
                                             地址reg81, T_整64, 0));
                    }
                    实参值71 = 地址reg81;
                }
            }
            IR追加(指令, 建IR指令(IR_结构体拷贝, 实参值71, 值地址71, 0, 0,
                                 值宽71, 0));
        } 否则 {
            IR追加(指令, 建IR指令(IR_指针存储, 值地址71, 实参值71, 0, 0,
                                 类型码(驻留(值类型71)), 0));
        }
        // move 登记：实参单标识符（末位==首节点紧邻被调）形态——拥有源转交。
        //   107：类深拷路径跳过登记（源保留照常析构·宿主 889「源照常可用」同构
        //   ——019 第 1 句 未显式 转移() 不自动 move）；字符串/容器载荷维持
        //   71-a move 面（宿主 70-a 源槽清零同效·两侧行为一致非分叉）。
        整64 末位71 = 查调用实参末位(整64(位置), 0);
        如果 (末位71 == 整64(n.子起点) + 1) {
            节点 实参n71 = 池.元素(整32(末位71));
            如果 (实参n71.类型 == 节点_标识符 && !类深拷107) {
                登记已装箱名(整64(实参n71.文本));
            }
        }
    }
    // 894-a（070·G-N 特性波3）：**实参位语境**压「对象前 8 字节」而非基址——
    //   v2 合成体传参 ABI=前 8 字节寄存器传值（标识符实参求值同款·t7 双端
    //   一致实证；被调方按槽区读 [@0 标志/@+4 值]）。原恒压基址 → 调用方把
    //   「临时地址」入 rcx/rdx、被调方当「对象前 8 字节」存槽 → 槽+4=未初始
    //   化栈=非确定垃圾（408 u6/t3/t6 探针族实锤）。判据=紧邻后继为调用根
    //   （末实参根=调用节点-1 池惯例·与语义层 实参位期望类型894 回取同款）；
    //   非实参位（声明/返回/嵌套载荷消费）维持基址——543 系列零回归。
    //   宽度=8（前 8 字节=标志+值低半/指针载荷；>16B 载荷场景合成体整体传
    //   参本 ABI 不承载——同标识符实参边界）。
    整64 装箱压栈值894 = 基址71;
    如果 (整64(位置) + 1 < 整64(池.大小())) {
        节点 后继894 = 池.元素(位置 + 1);
        // 后继=**构造器**调用（正常/错误/某些）=嵌套构造载荷语境——外层以
        //   内层**基址**为深拷源（IR_结构体拷贝·543/546 族）·保持基址；
        //   后继=普通函数/方法调用=真传参语境→前 8 字节。
        布尔 后继是构造器894 = 假;
        如果 (后继894.类型 == 节点_调用 && 后继894.子起点 > 0) {
            节点 后继被调894 = 池.元素(整32(后继894.子起点));
            如果 (后继被调894.类型 == 节点_标识符) {
                字符串 后继被调名894 = 字符串复制(驻留文本(整64(后继被调894.文本)));
                如果 (字符串比较(后继被调名894, "正常") ||
                     字符串比较(后继被调名894, "错误") ||
                     字符串比较(后继被调名894, "某些")) {
                    后继是构造器894 = 真;
                }
            }
        }
        // 真·传参语境=**普通函数直调**（被调=标识符·前 8 字节 ABI）——
        //   成员方法调用（表.追加(正常(31))·被调=节点_成员）实参=**基址**
        //   （容器元素追加深拷源·537 D 段 890 链）·构造器后继=嵌套载荷语境
        //   （深拷源）·两者均不转。
        布尔 普通直调实参位894 = 假;
        如果 (后继894.类型 == 节点_调用 && 后继894.子起点 > 0 &&
             后继894.附加 >= 1 && !后继是构造器894) {
            节点 后继被调普通894 = 池.元素(整32(后继894.子起点));
            如果 (后继被调普通894.类型 == 节点_标识符) {
                普通直调实参位894 = 真;
            }
        }
        如果 (普通直调实参位894) {
            // 1011（408/551·合成体传参 ABI 宽度分档）：前 8 字节值传仅适用
            //   **总宽 ≤8** 的合成体（可选<整32>=8·t7 双端一致）；总宽 >8
            //   （结果<整32,整32>=16）=基址传引用（被调方 prologue rep movsb
            //   按源地址拷全宽——MS x64 非 1/2/4/8 结构体传引用 ABI 同构）。
            //   原恒前 8 字节：16 字节合成体 rdx=打包值、被调 rep movsb 解引用
            //   [打包值] → C0000005（fault=0x2900000001=正常(41) 打包·408/551
            //   同 RVA=10c3 实锤）。
            整64 装箱总宽1011 = 结果大小(装箱名);
            如果 (装箱总宽1011 <= 8) {
                整64 实参值894 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_指针加载, 基址71, 0, 0, 实参值894, T_整64, 0));
                装箱压栈值894 = 实参值894;
            }
            // >8：装箱压栈值894 维持 基址71（传引用——被调 prologue 拷贝对齐）
        }
    }
    结果<空类型, 整32> 加箱71 = 表达式栈.追加(装箱压栈值894);
    如果 (!加箱71.正常) { 运行时错误(4); }
    // 067-003（嵌套去重·dbgZ 实证）：装箱完成**登记自身位置**——原仅预求值处
    //   登记「实参位置」→ 节点自身先被遍历装箱（池序 内层在前）时不登记 →
    //   外层预求值递归再装箱一次 → 产物双份/栈错位（t1=1 读标志位实证）。
    //   登记后递归命中即返回 1（复用栈上已有产物）。
    结果<空类型, 整32> 登自71 = 已装箱节点们.设置(整64(位置), 1);
    如果 (!登自71.正常) { 运行时错误(4); }
    返回 1;
}

// 91-a（2026-09-13 第九十一轮）：容器方法实参类型码（与 弹出们 同序——
//   弹出们[i] = 声明序第 n-1-i 个实参；段名经 取参数段 解析、类型码 归一）。
//   浮点段（T=浮64/浮32 实例化替换后）走 xmm/d 寄存器类；未知段兜底 0（整型类）。
函数 容器实参类型码们(字符串 参数串, 向量<整64> 弹出们) -> 向量<整64> {
    向量<整64> 码们 = 向量<整64>();
    整64 n = 弹出们.大小();
    整64 i = 0;
    当 (i < n) {
        字符串 段名 = 取参数段(参数串, n - 1 - i);
        整64 段码 = 类型码(驻留(段名));
        结果<空类型, 整32> 加码 = 码们.追加(段码);
        如果 (!加码.正常) { 运行时错误(4); }
        i++;
    }
    返回 码们;
}

// 普通函数调用发射：结构体按值实参/& 引用实参 回扫取地址（B8/②c D 表驱动）+
//   返回结构体 retbuf（148）+引用返回解引用读值（P3-18）+返回值类型登记。
不安全 函数 发射普通函数调用(向量<整64>& 弹出们, 整64 函数符号, 整64 实参数,
                     向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数,
                     向量<整64>& 表达式栈,
                     整64 retbuf序号) -> 空类型 {
    // 224-a（2026-09-16 第两百二十四轮，D1 行数整改）：实参回扫迁 回扫结构体与引用实参；
    //   81-a-v2 物化迁 物化结构体返回值（真=已压栈已返回）；引用返回段迁 发射引用返回加载。
    回扫结构体与引用实参(弹出们, 函数符号, 指令, 寄存器计数, 槽计数);
    整64 返回寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
        寄存器计数[0] = 寄存器计数[0] + 1;
        // 用户函数返回结构体（2026-09-04，E2E 148）：帧尾共享 retbuf（容器
        //   方法同款 B6 设施）+ 位 0 装载 + 实参起始位 1；rax=结构体地址
        //   （初始化拷贝/链式成员基址/按值实参直用）。retbuf 帧尺寸累计。
        整64 retbuf序号v = 0;
        整64 实参起始位v = 0;
        整64 结构体返回IDv = 0 - 1;   // 81-a-v2：真结构体返回 → 调用后物化（>=0 生效）
        整64 查返回s = 查函数返回类型(函数符号);
        如果 (查返回s >= 0) {
            整64 返回结构大小 = 查结构体大小(查返回s);
            如果 (返回结构大小 == 0) {
                // 71-a：结果/可选 返回同款 retbuf ABI（被调方 返回结果名ID 配对；
                //   rax=retbuf=结果基址——接收侧 生成结果局部 IR_结构体拷贝 直用）
                字符串 返回名71 = 字符串复制(驻留文本(查返回s));
                如果 (是结果类型(返回名71)) {
                    返回结构大小 = 结果大小(返回名71);
                }
                // 810（053）：128 位标量返回=retbuf 16 字节（被调方 返回128位
                //   配对·rax=retbuf 地址——返回寄存器登记 T_整128/T_正128 后
                //   按「值=地址」消费：打印传址/赋值双半拷）
                否则 如果 (字符串比较(返回名71, "整128") ||
                     字符串比较(返回名71, "正128")) {
                    返回结构大小 = 16;
                }
                // 087b（#087 余量·宿主 82984e4bbe 同构）：数组返回=retbuf
                //   字节=类型名宽度 967 折叠（被调方 返回数组字节 配对·rax=
                //   retbuf 地址——值=数组基址，接收侧声明整块拷/下标直用）
                否则 如果 (是数组类型文本(返回名71)) {
                    返回结构大小 = 类型名宽度(查返回s);
                }
            }
            如果 (返回结构大小 != 0) {
                累计retbuf字节数(返回结构大小);
                retbuf序号v = retbuf序号;
                实参起始位v = 1;
                如果 (查结构体大小(查返回s) != 0) {
                    // 82-a：跨模块限定（同名结构体布局按模块分桶独立——E2E 172）
                    结构体返回IDv = 限定返回类型ID(函数符号, 查返回s);
                }
            }
        }
        发射调用实参们(弹出们, 实参起始位v, 指令, 实参类型码们(弹出们));
        // 91-a：返回类型码（IR_调用参数化.操作数2——浮点值返回走 xmm0 装载；
        //   retbuf 形态（结构体/结果）与引用返回=地址，标 0 整型类）
        // 087b：数组返回同属 retbuf 形态——返回寄存器=retbuf 地址（64 位），
        //   不得按 类型码(数组文本) 装载（误折 T_整32 → movsxd eax 32 位截断
        //   retbuf 指针→接收整块拷解引用崩·596 v2 面 RVA=1528 铁证）
        整64 返回码v = 0;
        如果 (查返回s >= 0 && 结构体返回IDv < 0) {
            字符串 返回名pre = 字符串复制(驻留文本(查返回s));
            布尔 引用pre = 假;
            如果 (字符串长度(返回名pre) > 0 &&
                 ((整64(返回名pre[字符串长度(返回名pre) - 1]) & 255) == 38)) {
                引用pre = 真;
            }
            如果 (!引用pre && 查结构体大小(查返回s) == 0 &&
                 !是数组类型文本(返回名pre)) {
                返回码v = 类型码(查返回s);
            }
        }
        IR追加(指令, 建IR指令(IR_调用参数化, 实参起始位v + 实参数, 返回码v, 0,
                             返回寄存器, retbuf序号v, 函数符号));
    如果 (物化结构体返回值(指令, 寄存器计数, 槽计数, 返回寄存器, 结构体返回IDv, 表达式栈)) {
        返回;
    }
        // 引用返回（2026-09-04 缺陷零容忍收口，宿主 P3-18 对齐）：返回寄存器
        //   =被引用左值地址——默认按右值读解引用（IR_指针加载 值）；赋值目标/
        //   复合赋值/引用初始化场景经 生成左值地址 调用分支回扫取地址
        布尔 是引用返回v = 假;
        字符串 返回名v = "";
        如果 (查返回s >= 0) {
            返回名v = 字符串复制(驻留文本(查返回s));
            如果 (字符串长度(返回名v) > 0 &&
                 ((整64(返回名v[字符串长度(返回名v) - 1]) & 255) == 38)) {
                是引用返回v = 真;
            }
        }
        如果 (是引用返回v) {
            发射引用返回加载(指令, 寄存器计数, 返回寄存器, 返回名v, 表达式栈);
            返回;
        }
        // ③ 第二波（方案A）：用户函数返回值类型登记（打印分派/拼接判定消费；
        //   缺陷②同族根治：字符串返回未登记 -> from_int(指针) 静默错误代码，
        //   asm 探针实锤——代码生成共用.cn:30/104 拼接实际在用）
        整64 查返回 = 查函数返回类型(函数符号);
        如果 (查返回 >= 0) {
            整64 返回码 = 类型码(查返回);
            如果 (返回码 != T_未知 && 返回码 != T_空类型) {
                登记寄存器类型(返回寄存器, 返回码);
            }
            // 701-a 波H 定论：128 位返回值**不设**地址标记（试验证=标记随编号复用
            //   泄漏致 500 崩）；返回值面待双槽值语义（053 主体）解决。
        }
        结果<空类型, 整32> 加普 = 表达式栈.追加(返回寄存器);
        如果 (!加普.正常) { 运行时错误(4); }
}

// ==================== T69（480-a 深度机）函数指针间接调用发射 ====================
// 被调签名解析：被调节点（调用节点.子起点）为标识符且其声明类型是函数指针时
//   返回该签名文本（`函数指针<返回>(参数表)`）；其余形态/未登记=空串
//   （返回类型退 T_未知=整数类，ABI 仍按整型寄存器装载——不失正确性，
//   仅浮点返回需签名才能走 xmm 装载）。
函数 查被调函数指针签名480(向量<节点> 池, 节点 n) -> 字符串 {
    如果 (n.子起点 <= 0) { 返回 ""; }
    如果 (整32(n.子起点) >= 整32(池.大小())) { 返回 ""; }
    节点 被调480 = 池.元素(整32(n.子起点));
    如果 (被调480.类型 != 节点_标识符) { 返回 ""; }
    整64 类型ID480 = 解析标识符类型ID(整64(被调480.文本));
    如果 (类型ID480 == 0) { 返回 ""; }
    字符串 文本480 = 字符串复制(驻留文本(类型ID480));
    如果 (!是函数指针类型文本(文本480)) { 返回 ""; }
    返回 文本480;
}

// 间接调用发射：实参按声明序装载（起始位 0=无 retbuf/this）+ IR_间接调用 收尾；
//   返回寄存器新建并登记类型码（打印/拼接/嵌套调用分派用）。实参负占位
//   （函数名作实参）= 值位收口 还原函数地址（T69 值位）。
不安全 函数 发射间接调用480(向量<节点> 池, 节点 n, 整64 被调寄存器,
                       向量<整64>& 弹出们, 向量<IR指令>& 指令, 整64* 寄存器计数,
                       整64* 槽计数, 向量<整64>& 表达式栈) -> 空类型 {
    字符串 签名480 = 查被调函数指针签名480(池, n);
    整64 返回码480 = 0;
    如果 (字符串长度(签名480) > 0) {
        字符串 返回文本480 = 函数指针返回文本(签名480);
        如果 (字符串长度(返回文本480) > 0) { 返回码480 = 类型码(驻留(返回文本480)); }
    }
    实参负占位收口480(指令, 寄存器计数, 弹出们);
    整64 返回寄存器480 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    发射调用实参们(弹出们, 0, 指令, 实参类型码们(弹出们));
    IR追加(指令, 建IR指令(IR_间接调用, 弹出们.大小(), 返回码480, 0,
                         返回寄存器480, 0, 被调寄存器));
    如果 (返回码480 != T_未知 && 返回码480 != T_空类型) {
        登记寄存器类型(返回寄存器480, 返回码480);
    }
    结果<空类型, 整32> 加间480 = 表达式栈.追加(返回寄存器480);
    如果 (!加间480.正常) { 运行时错误(4); }
}

// 104/440（070 波C·1022）：方法引用闭包调用展开——被调=闭包绑定变量
//   （生成声明 消费登记·方法引用符号们）→ 直接调用方法符号：
//   实参位0=this（对象变量槽 Load 对象指针·引用捕获语义=改态后读最新，
//   104 断言「改态后: 205」）+实参位1..=用户实参（弹出们 已按声明序）。
//   返回码=方法引用返回码们（方法返回类型·打印分派/嵌套消费）。
//   返回 1=已展开；0=非闭包变量（调用方走 T69 间接调用）。
不安全 函数 方法引用闭包调用展开(向量<节点> 池, 节点 n, 向量<整64>& 弹出们,
                       映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                       向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数,
                       向量<整64>& 表达式栈) -> 整32 {
    如果 (n.子起点 <= 0 || 整32(n.子起点) >= 整32(池.大小())) { 返回 0; }
    节点 被调c = 池.元素(整32(n.子起点));
    如果 (被调c.类型 != 节点_标识符) { 返回 0; }
    结果<整64, 整32> 查符号c = 方法引用符号们.获取(整64(被调c.文本));
    如果 (!查符号c.正常) { 返回 0; }
    结果<整64, 整32> 查对象c = 方法引用对象们.获取(整64(被调c.文本));
    结果<整64, 整32> 查码c = 方法引用返回码们.获取(整64(被调c.文本));
    // v2 结果纪律：结果.值 只能肯定分支内访问——固化局部变量
    整64 方法符号IDc = 0;
    整64 对象名IDc = 0;
    整64 返回码预c = 0;
    如果 (查符号c.正常) {
        如果 (查对象c.正常) {
            如果 (查码c.正常) {
                方法符号IDc = 查符号c.值;
                对象名IDc = 查对象c.值;
                返回码预c = 查码c.值;
            }
        }
    }
    如果 (方法符号IDc == 0) { 返回 0; }
    // this 装载：对象变量槽（局部/参数）→ IR_加载(T_对象)=对象指针
    整64 对象槽c = 0;
    结果<整64, 整32> 找局c = 局部槽.获取(对象名IDc);
    如果 (找局c.正常) { 对象槽c = 找局c.值; }
    如果 (对象槽c == 0) {
        结果<整64, 整32> 找参c = 参数槽.获取(对象名IDc);
        如果 (找参c.正常) { 对象槽c = 找参c.值; }
    }
    如果 (对象槽c == 0) { 返回 0; }
    整64 this寄存器c = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 对象槽c, 0, 0, this寄存器c, T_对象, 0));
    IR追加(指令, 建IR指令(IR_调用实参, this寄存器c, 0, 0, 0, 0, 0));
    发射调用实参们(弹出们, 1, 指令, 实参类型码们(弹出们));
    整64 返回寄存器c = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    整64 返回码c = 0;
    如果 (查码c.正常) { 返回码c = 查码c.值; }
    IR追加(指令, 建IR指令(IR_调用参数化, 1 + 弹出们.大小(), 返回码c, 0,
                         返回寄存器c, 0, 方法符号IDc));
    如果 (返回码c != T_未知 && 返回码c != T_空类型) {
        登记寄存器类型(返回寄存器c, 返回码c);
    }
    结果<空类型, 整32> 加闭包c = 表达式栈.追加(返回寄存器c);
    如果 (!加闭包c.正常) { 运行时错误(4); }
    返回 1;
}

// 224-a：族① 实参回扫取地址——②b B8 结构体按值实参（函数实参结构们 表驱动）+
//   ②c D & 引用实参（函数实参引用们 同款回扫）。
不安全 函数 回扫结构体与引用实参(向量<整64>& 弹出们, 整64 函数符号, 向量<IR指令>& 指令,
                     整64* 寄存器计数, 整64* 槽计数) -> 空类型 {
        // ---- 普通函数调用：实参从位 0 起，全部经 64+63（任意参数数） ----
        // ②b B8：结构体按值实参 -> 传地址（函数实参结构们 表驱动——与 B3 容器
        //   方法路径同款回扫；v2 自身 IR追加(指令, 建IR指令(...)) ③ 自举必需）
        // ②c D：& 引用实参 -> 传左值地址（函数实参引用们 表驱动同款回扫）
        整64 实i2 = 0;
        当 (实i2 < 弹出们.大小()) {
            整64 查结构实参 = 查函数实参结构(函数符号 * 键位移 + 实i2);
            如果 (查结构实参 >= 0) {
                回扫实参取地址(指令, 弹出们, 实i2, 寄存器计数, 槽计数);
            } 否则 如果 (是函数实参128位(函数符号 * 键位移 + 实i2)) {
                // 810（053）：128 位形参位——实参寄存器登记 T_整128/正128（地址
                //   句柄·变量/静态/调用返回/算术产物）直传；64 位值形态（字面量/
                //   窄表达式/64 位调用返回）物化 2 槽为句柄后改弹出项（prologue
                //   收地址双半拷 16 字节——值直传=当地址解引用段错误·420-①实证）。
                整64 实reg128 = 弹出们.元素(弹出们.大小() - 1 - 实i2);
                整64 实码128 = 查寄存器类型(实reg128);
                如果 (实码128 != T_整128 && 实码128 != T_正128) {
                    整64 句柄128 = 物化128位操作数(实reg128, 实码128,
                        实码128 == T_正32 || 实码128 == T_正64 ? 0 : 1,
                        指令, 寄存器计数, 槽计数);
                    结果<空类型, 整32> 改实128 = 弹出们.设置(
                        弹出们.大小() - 1 - 实i2, 句柄128);
                    如果 (!改实128.正常) { 运行时错误(4); }
                }
            } 否则 {
                布尔 查引用实参 = 是函数实参引用(函数符号 * 键位移 + 实i2);
                如果 (查引用实参) {
                    回扫实参取地址(指令, 弹出们, 实i2, 寄存器计数, 槽计数);
                }
            }
            实i2++;
        }
}

// 224-a：族② 81-a-v2（甲案）真结构体返回物化——调用发射后立即物化到独立槽并改压栈
//   寄存器（帧尾共享 retbuf 会被后续返回调用覆盖）。返回 真=已物化已压栈（调用方即返回）。
不安全 函数 物化结构体返回值(向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数,
                     整64 返回寄存器, 整64 结构体返回IDv, 向量<整64>& 表达式栈) -> 布尔 {
    如果 (结构体返回IDv >= 0) {
            整64 物化reg = 物化返回值到独立槽(指令, 寄存器计数, 槽计数,
                                              返回寄存器, 结构体返回IDv);
            如果 (物化reg != 0) {
                整64 物化码 = 类型码(结构体返回IDv);
                如果 (物化码 != T_未知 && 物化码 != T_空类型) {
                    登记寄存器类型(物化reg, 物化码);
                }
                结果<空类型, 整32> 加物 = 表达式栈.追加(物化reg);
                如果 (!加物.正常) { 运行时错误(4); }
                返回 真;
            }
    }
    返回 假;
}

// 224-a：族③ 引用返回加载——返回寄存器=被引用左值地址，默认按右值读解引用
//   （IR_指针加载）；值类型登记剥尾 & 后的类型码（打印分派/拼接消费）。
不安全 函数 发射引用返回加载(向量<IR指令>& 指令, 整64* 寄存器计数, 整64 返回寄存器,
                     字符串 返回名v, 向量<整64>& 表达式栈) -> 空类型 {
    整64 引用值reg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 返回寄存器, 0, 0, 引用值reg, T_整64, 0));
            // 值类型登记：剥尾 & 后的类型码（打印分派/拼接消费）
            字符串 基类型名 = 字符串子串(返回名v, 0, 字符串长度(返回名v) - 1);
            整64 引用返回码 = 类型码(驻留(基类型名));
            如果 (引用返回码 != T_未知 && 引用返回码 != T_空类型) {
                登记寄存器类型(引用值reg, 引用返回码);
            }
            结果<空类型, 整32> 加引 = 表达式栈.追加(引用值reg);
            如果 (!加引.正常) { 运行时错误(4); }
            返回;
}


// 下标访问：字符串[i] 逐字节（T_字节 符号扩展）/指针对象 p[i] 元素宽度步进
//   （③ 第三波）。弹 下标与对象值，地址=对象+缩放步进，加载宽度按元素码登记。
不安全 函数 生成下标访问(向量<节点> 池, 节点 n, 向量<IR指令>& 指令,
                  整64* 寄存器计数, 整64* 块计数,
                  向量<整64>& 表达式栈) -> 空类型 {
        // ③ 第二波：字符串[i] 逐字节 O(1) 访问（宿主 A-1 对齐，plans/004）：
        //   UTF-8 字节视图步进 1，LoadPtr i8 有符号扩展（双后端 movsx/ldrsb——
        //   与 C 的 s[i] 一致，65 用例 字节和=-376 实证），越界由调用方按
        //   字符串长度 约束；结果类型 字符（符号扩展字节值按整数消费）。
        //   弹 下标（栈顶）与 对象（字符串指针值——标识符/成员/调用产物均可），
        //   地址 = 对象 + 下标（IR_加 步进 1），IR_指针加载 T_字节（1 字节符号
        //   扩展——独立宽度码，B5 字段 T_字符 零扩展模型互不影响）。
        // ③ 第三波：指针对象 p[i] ≡ *(p + i)（宿主 ir_expr.cpp:1555 对齐）——
        //   步进=所指元素宽度（类型名宽度；步进1 免乘），加载宽度=元素宽度码，
        //   结果登记元素类型码（打印分派/拼接消费）。对象须为指针变量（语义层
        //   白名单保证；未命中走字符串路径——两白名单互斥不误伤）。
        // 94-a/97-a：对象元素类型 + 数组长度统一经推导 helper（标识符数组变量 /
        //   指针变量 / **结构体字段数组**（成员对象，97-a C8）三形态同源）
        整64 所指ID = 0;
        整64 数组长度下 = 0;
        如果 (n.子起点 > 0) {
            所指ID = 推导下标元素类型ID(池, 整32(n.子起点));
            数组长度下 = 推导下标数组长度(池, 整32(n.子起点));
        }
        整64 下标值 = 0;
        如果 (表达式栈.大小() >= 1) {
            下标值 = 表达式栈.元素(表达式栈.大小() - 1);
            结果<空类型, 整32> 删下 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删下.正常) { 运行时错误(4); }
        }
        整64 对象值 = 0;
        如果 (表达式栈.大小() >= 1) {
            对象值 = 表达式栈.元素(表达式栈.大小() - 1);
            结果<空类型, 整32> 删对 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删对.正常) { 运行时错误(4); }
        }
        如果 (所指ID != 0) {
            // 94-a：数组下标越界检查（宿主 ir.cpp 同构：下标 >= 长度 → 运行时
            //   错误(1)）——数组对象有静态长度（数组长度下 > 0 才发射；指针
            //   对象无长度信息=既有边界）。安全性：越界读/写挡在运行期入口。
            如果 (数组长度下 > 0) {
                发射数组越界检查(下标值, 数组长度下, 指令, 寄存器计数, 块计数);
            }
            整64 步进 = 类型名宽度(所指ID);
            整64 缩放值 = 下标值;
            如果 (步进 != 1) {
                整64 步进常量 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留(整数转字符串(步进))), 0, 0,
                                     步进常量, T_整64, 0));
                整64 缩放寄存器 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_乘, 下标值, 步进常量, 0, 缩放寄存器, T_整64, 0));
                缩放值 = 缩放寄存器;
            }
            整64 元素地址 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加, 对象值, 缩放值, 0, 元素地址, T_整64, 0));
            // 94-a（2026-09-13 第九十四轮）：元素为**结构体**（查结构体大小 != 0）
            //   ——表达式值 = **元素地址**（不加载）：与 87-a 静态结构体/结构体局部/
            //   86-a 三元聚合同款「结构体表达式值=地址」约定；成员访问（表[0].x）
            //   基址侧复用栈顶、整体拷贝、作实参全链零拷贝消费。
            // 1011（537·合成体元素读侧对齐）：结果/可选类合成体元素同款地址语义
            //   ——写侧（下标整体写 结果大小=16）与读侧（地址+整体拷）对称；原落
            //   IR_指针加载 8 字节=把「标志+值打包」当地址/句柄解引用（fault=
            //   0x0500000001=正常(5) 打包值被解引用·537 A 段实锤）。
            如果 (查结构体大小(所指ID) != 0 || 是结果类型_ID(所指ID)) {
                登记寄存器类型(元素地址, T_对象);
                结果<空类型, 整32> 加元地 = 表达式栈.追加(元素地址);
                如果 (!加元地.正常) { 运行时错误(4); }
                返回;
            }
            整64 元素值寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 元素地址, 0, 0, 元素值寄存器,
                                 类型宽度码(驻留文本(所指ID)), 0));
            登记寄存器类型(元素值寄存器, 类型码(所指ID));
            结果<空类型, 整32> 加元素 = 表达式栈.追加(元素值寄存器);
            如果 (!加元素.正常) { 运行时错误(4); }
            返回;
        }
        // T4（311-a=306-b 波次2 v2 侧·2026-09-17）：字符串下标越界检查（运行时
        //   长度版——对齐宿主 emitStrBoundsCheck/__cn_str_len；错误码 2 与 94-a
        //   数组防线对称）。原「越界由调用方按字符串长度约束」=防线不对称（数组
        //   有检查而字符串无=越界读 UB）。字符* 指针视图走 所指ID!=0 指针路径
        //   （无长度信息·既有边界）=天然不误伤（与宿主三读路径插桩同覆盖：
        //   对象值=标识符/成员/调用产物均可）。
        发射字符串越界检查(下标值, 对象值, 指令, 寄存器计数, 块计数);
        整64 下标地址 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_加, 对象值, 下标值, 0, 下标地址, T_整64, 0));
        整64 字节值寄存器 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_指针加载, 下标地址, 0, 0, 字节值寄存器, T_字节, 0));
        登记寄存器类型(字节值寄存器, T_整64);
        结果<空类型, 整32> 加字 = 表达式栈.追加(字节值寄存器);
        如果 (!加字.正常) { 运行时错误(4); }
}

// ==================== 84-a：结构体字面量作实参（生成） ====================
// 机制主体 = 临时槽（生成期槽计数递增 + 逐槽 IR_分配 + 基址槽=槽起+槽数-1，82-a 槽分配
//   纪律四条）+ 零初始化 + 逐字段写（值区间 生成表达式 求值 → 字段地址 + 指针存储
//   （宽度=查字段宽度码））；槽地址压栈 + 登记 结构体返回临时们（**实参位置**由 82-a
//   清理调用实参临时 在外层调用发射后释放串字段——零新清理机制）。
// 依赖不变量 = ①基址槽=最大槽号=最低地址（②b B1）；②逐槽 IR_分配（扫描函数 帧尺寸）
//   ③零初始化先于字段写（未赋值字段=0 空安全；字符串字段缺值不悬垂）。
不安全 函数 生成结构体构造(向量<节点> 池, 节点 n, 映射<整64, 整64>& 局部槽,
                    映射<整64, 整64>& 参数槽, 向量<IR指令>& 指令, 整64* 寄存器计数,
                    整64* 块计数, 整64* 槽计数, 向量<整64>& 表达式栈) -> 空类型 {
    整64 结构体IDc = 整64(n.文本);
    整64 大小c = 查结构体大小(结构体IDc);
    如果 (大小c <= 0) {
        IR层诊断("结构体构造字面量: 类型未知 " + 驻留文本(结构体IDc));
        返回;
    }
    整64 槽数c = (大小c + 7) / 8;
    整64 槽起c = 槽计数[0];
    槽计数[0] = 槽计数[0] + 槽数c;
    整64 zc = 0;
    当 (zc < 槽数c) {
        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽起c + zc));
        zc++;
    }
    整64 基槽c = 槽起c + 槽数c - 1;
    整64 基址regc = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_取地址, 基槽c, 0, 0, 基址regc, T_整64, 0));
    整64 零regc = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零regc, T_整64, 0));
    整64 清c = 0;
    当 (清c < 大小c) {
        整64 清地址 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_字段地址, 基址regc, 0, 0, 清地址, T_整64, 清c));
        IR追加(指令, 建IR指令(IR_指针存储, 清地址, 零regc, 0, 0, T_整64, 0));
        清c = 清c + 8;
    }
    // 84-c：**跳过嵌套构造区间**——嵌套字面量（`外盒{ 内 = 内盒{ 名 = 串 }, v = 5 }`）
    //   的内层字段初值节点也落在本构造的 [子起点, 子终点) 内（其后缀序：内层字段初值
    //   在内层构造节点之前）；若不跳过，外层字段循环会把内层字段初值**误当自己的字段**：
    //   ① 字段名查不到偏移 → 按默认宽度写到本槽（覆盖/杂写）② 内层字段值被**二次求值**
    //   （多一次 __cn_str_copy，其一被后续结构体拷贝覆盖而泄漏——探针 P26/P27 实证
    //   残留 1；诊断 dump 实证外层区间含内层字段初值 44 达两处）。
    //   嵌套区间的整段由「对应字段的值区间求值」处理（`生成表达式` 递归 → 内层构造）。
    向量<整64> 嵌套区间们 = 向量<整64>();
    收集构造区间(池, 整32(n.子起点), 整32(n.子终点), 嵌套区间们);
    整64 fi = 整64(n.子起点);
    当 (fi < 整64(n.子终点)) {
        整64 跳终84 = 区间终点(嵌套区间们, 整32(fi), 2);
        如果 (跳终84 >= 0) {
            如果 (跳终84 > fi) { fi = 跳终84; } 否则 { fi++; }
            继续;
        }
        节点 字段节点 = 池.元素(整32(fi));
        如果 (字段节点.类型 == 节点_字段初值) {
            整64 值起c = 整64(字段节点.子起点);
            整64 值止c = 整64(字段节点.子终点);
            整64 字段类型IDf = 查字段类型ID(结构体IDc, 整64(字段节点.文本));
            整64 字段大小f = 0;
            如果 (字段类型IDf != 0) { 字段大小f = 查结构体大小(字段类型IDf); }
            // 861-a（002 攻族 G-N）：数组类型字段的初始化列表——字段值区间末位=
            //   节点_数组初始化（解析数组初始化列表 封口）且字段类型为数组 → 走
            //   逐元素写分支（对齐 生成声明.cn 94-a 语句位：元素序×步进偏移+
            //   按元素宽度指针存储；对象零填先行→余元素保零）。非此形态仍走
            //   表达式求值（标量/字符串/结构体/嵌套构造零变化）。
            布尔 数组初值c = 假;
            如果 (值止c > 值起c && 字段类型IDf != 0) {
                节点 末值c = 池.元素(整32(值止c - 1));
                如果 (末值c.类型 == 节点_数组初始化 &&
                    是数组类型文本(字符串复制(驻留文本(字段类型IDf)))) {
                    数组初值c = 真;
                }
            }
            如果 (值止c > 值起c && !数组初值c) {
                生成表达式(池, 整32(值起c), 整32(值止c), 局部槽, 参数槽, 指令,
                          寄存器计数, 块计数, 槽计数, 表达式栈);
            }
            整64 值regc = 零regc;
            如果 (!数组初值c && 表达式栈.大小() > 0) {
                值regc = 表达式栈.元素(表达式栈.大小() - 1);
                结果<空类型, 整32> 删值c = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删值c.正常) { 运行时错误(4); }
            }
            整64 字段地址c = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_字段地址, 基址regc, 0, 0, 字段地址c, T_整64,
                                 整64(字段节点.附加)));
            // 84-c：字段类型分派——**值语义结构体字段**（如 `外层{ 内 = 内层{ v = 7 } }`）
            //   须**整体拷贝**（内联值语义：源=嵌套构造槽地址/结构体返回地址 → 目标=字段内联
            //   区）；按「宽度存储」只会写入地址指针（8 字节）→ 读取按内联偏移=垃圾
            //   （探针 P24① 实证：宿主 10 / v2 140735369840171）。其余类型（标量/字符串/
            //   指针）按宽度存储（窄宽字段越界教训：整32 字段写 8 字节踩相邻字段）。
            如果 (数组初值c) {
                字符串 字段类型文本86 = 字符串复制(驻留文本(字段类型IDf));
                整64 元素步进86 = 数组元素步进(字段类型文本86);
                整64 长度86 = 数组长度文本(字段类型文本86);
                整64 元素宽86 = 类型宽度码(数组元素文本(字段类型文本86));
                节点 初始化节点86 = 池.元素(整32(值止c - 1));
                // 897-a（070-001 波4）：顶层包装倒序收集（元素=构造字面量时
                //   区间物理含内层包装——声明位 897 同病同修·判据=区间覆盖）
                向量<整64> 顶层们86 = 向量<整64>();
                整64 最小起86 = 整64(初始化节点86.子终点);
                整64 倒扫86 = 整64(初始化节点86.子终点) - 1;
                当 (倒扫86 >= 整64(初始化节点86.子起点)) {
                    节点 扫w86 = 池.元素(整32(倒扫86));
                    如果 (扫w86.类型 == 节点_数组元素 &&
                         整64(扫w86.子起点) < 最小起86) {
                        结果<空类型, 整32> 加顶86 = 顶层们86.追加(倒扫86);
                        如果 (!加顶86.正常) { 运行时错误(4); }
                        最小起86 = 整64(扫w86.子起点);
                    }
                    倒扫86--;
                }
                整64 元素序86 = 0;
                整64 顶游86 = 顶层们86.大小();
                当 (顶游86 > 0) {
                    顶游86--;
                    节点 包装86 = 池.元素(整32(顶层们86.元素(顶游86)));
                    {
                        如果 (元素序86 >= 长度86) {
                            IR层诊断("数组初始化元素数超出长度: " + 字段类型文本86);
                            中断;
                        }
                        整64 元素前深度86 = 表达式栈.大小();
                        整64 元素寄存器86 = 生成表达式(池, 整32(包装86.子起点),
                                                整32(包装86.子终点), 局部槽, 参数槽,
                                                指令, 寄存器计数, 块计数, 槽计数,
                                                表达式栈);
                        表达式栈弹到深度(表达式栈, 元素前深度86);
                        如果 (元素寄存器86 != 0) {
                            整64 元素地址86 = 字段地址c;
                            如果 (元素序86 > 0) {
                                整64 偏移常量86 = 寄存器计数[0];
                                寄存器计数[0] = 寄存器计数[0] + 1;
                                IR追加(指令, 建IR指令(IR_常量整数,
                                        整64(驻留(整数转字符串(元素序86 * 元素步进86))),
                                        0, 0, 偏移常量86, T_整64, 0));
                                整64 元素地址新86 = 寄存器计数[0];
                                寄存器计数[0] = 寄存器计数[0] + 1;
                                IR追加(指令, 建IR指令(IR_加, 字段地址c, 偏移常量86,
                                        0, 元素地址新86, T_整64, 0));
                                元素地址86 = 元素地址新86;
                            }
                            IR追加(指令, 建IR指令(IR_指针存储, 元素地址86,
                                    元素寄存器86, 0, 0, 元素宽86, 0));
                        }
                        元素序86++;
                    }
                }
            } 否则 如果 (字段大小f > 0) {
                // 结构体字段=值语义内联 → memcpy 整体拷贝（与宿主 emitStructInitTo 内联一致）
                IR追加(指令, 建IR指令(IR_结构体拷贝, 值regc, 字段地址c, 0, 0,
                                     字段大小f, 0));
            } 否则 {
                整64 宽度c = 查字段宽度码(结构体IDc, 整64(字段节点.文本));
                如果 (宽度c == T_整128 || 宽度c == T_正128) {
                    // 545（070 波D-二·1022）：128 位字段窄源写——单指针存储只写
                    //   低半 8 字节=高半垃圾（打印 18446744073709551607 实录）——
                    //   窄源按符号性物化双半槽对+双半拷贝入字段（宿主 emitCast
                    //   普通→128 同语义·与 声明位修复 同族）
                    整64 值码c128 = 查寄存器类型(值regc);
                    整64 物化码c = 值码c128;
                    整64 有符号c = 1;
                    如果 (物化码c == T_未知) { 物化码c = T_整64; }
                    如果 (物化码c == T_正32 || 物化码c == T_正64) { 有符号c = 0; }
                    整64 句柄c128 = 物化128位操作数(值regc, 物化码c, 有符号c,
                                              指令, 寄存器计数, 槽计数);
                    整64 低c = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_指针加载, 句柄c128, 0, 0, 低c, T_整64, 0));
                    IR追加(指令, 建IR指令(IR_指针存储, 字段地址c, 低c, 0, 0, T_整64, 0));
                    整64 高址c = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_字段地址, 字段地址c, 0, 0, 高址c, T_整64, 8));
                    整64 高c = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_字段地址, 句柄c128, 0, 0, 高c, T_整64, 8));
                    整64 高值c = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_指针加载, 高c, 0, 0, 高值c, T_整64, 0));
                    IR追加(指令, 建IR指令(IR_指针存储, 高址c, 高值c, 0, 0, T_整64, 0));
                } 否则 {
                    IR追加(指令, 建IR指令(IR_指针存储, 字段地址c, 值regc, 0, 0, 宽度c, 0));
                }
            }
        }
        fi++;
    }
    结果<空类型, 整32> 设临c = 结构体返回临时们.设置(基址regc, 结构体IDc);
    如果 (!设临c.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加栈c = 表达式栈.追加(基址regc);
    如果 (!加栈c.正常) { 运行时错误(4); }
}

// 94-a（2026-09-13 第九十四轮）：数组下标越界检查发射（宿主 ir.cpp 同构：下标
//   >= 长度 → 运行时错误(1)；上界有符号比较——数组长度为正常量，负数下标
//   属宿主同款既有边界）。形态：长度常量 + IR_大于等于 + 条件跳转（越界块调
//   __cn_runtime_error，不返回）+ 继续块标签；非数组（长度 0）调用方不发射。
不安全 函数 发射数组越界检查(整64 下标值, 整64 数组长度, 向量<IR指令>& 指令,
                          整64* 寄存器计数, 整64* 块计数) -> 空类型 {
    如果 (数组长度 <= 0) { 返回; }
    整64 长度常量x = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留(整数转字符串(数组长度))), 0, 0,
                          长度常量x, T_整64, 0));
    整64 越界布尔x = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_大于等于, 下标值, 长度常量x, 0, 越界布尔x, T_布尔, 0));
    登记寄存器类型(越界布尔x, T_布尔);
    整64 越界块x = 块计数[0] + 1;
    整64 继续块x = 块计数[0] + 2;
    块计数[0] = 块计数[0] + 2;
    IR追加(指令, 建IR指令(IR_条件跳转, 越界布尔x, 越界块x, 继续块x, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 越界块x));
    整64 错误码x = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    // 错误码 2=数组越界（runtime 契约表：1=除零 2=数组越界——
    //   src/runtime/runtime.cpp 同源；宿主 ir.cpp 越界检查同码）
    IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("2")), 0, 0, 错误码x, T_整64, 0));
    IR追加(指令, 建IR指令(IR_调用实参, 错误码x, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                         驻留(内置函数符号("运行时错误"))));
    IR追加(指令, 建IR指令(IR_跳转, 0, 0, 0, 0, 0, 继续块x));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 继续块x));
}

// T4（311-a=306-b 波次2 v2 侧·2026-09-17）：字符串下标越界检查发射（运行时
//   长度版——对齐宿主 306-a emitStrBoundsCheck：调 __cn_str_len(对象) 得运行时
//   长度，下标 >= 长度 → 运行时错误(2)（错误码与数组防线对称·不返回）；上界
//   有符号比较——负数下标与数组版同属既有边界）。对象=字符串指针值（字符串
//   路径专属——字符* 指针视图走 所指ID!=0 指针路径不经此=不误伤）。
不安全 函数 发射字符串越界检查(整64 下标值, 整64 对象值, 向量<IR指令>& 指令,
                            整64* 寄存器计数, 整64* 块计数) -> 空类型 {
    // ① 运行时长度：__cn_str_len(对象) ——实参=对象（字符串指针值）
    IR追加(指令, 建IR指令(IR_调用实参, 对象值, T_对象, 0, 0, 0, 0));
    整64 长度寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_调用参数化, 1, T_整64, 0, 长度寄存器, 0,
                         驻留(内置函数符号("字符串长度"))));
    登记寄存器类型(长度寄存器, T_整64);
    // ② 下标 >= 长度 → 越界块（错误码 2 ·与 94-a 数组版同码）
    整64 越界布尔s = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_大于等于, 下标值, 长度寄存器, 0, 越界布尔s, T_布尔, 0));
    登记寄存器类型(越界布尔s, T_布尔);
    整64 越界块s = 块计数[0] + 1;
    整64 继续块s = 块计数[0] + 2;
    块计数[0] = 块计数[0] + 2;
    IR追加(指令, 建IR指令(IR_条件跳转, 越界布尔s, 越界块s, 继续块s, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 越界块s));
    整64 错误码s = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("2")), 0, 0, 错误码s, T_整64, 0));
    IR追加(指令, 建IR指令(IR_调用实参, 错误码s, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                         驻留(内置函数符号("运行时错误"))));
    IR追加(指令, 建IR指令(IR_跳转, 0, 0, 0, 0, 0, 继续块s));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 继续块s));
}
