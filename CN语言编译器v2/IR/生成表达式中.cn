// 生成表达式中（356 重构F1 自 生成表达式.cn 纯机械搬移·函数体逐字保留·零逻辑变化）

导入 容器::向量;
导入 映射集合;
导入 IR;         // IR指令/签名辅助/节点_* 常量（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）


函数 净栈契约出口校验(向量<整64>& 表达式栈, 整64 进入深度, 整32 起点, 整32 终点) -> 整64 {
    整64 出口深度 = 表达式栈.大小();
    整64 净栈增量 = 出口深度 - 进入深度;
    如果 (净栈增量 > 1) {
        IR层诊断("表达式净栈契约违反(多压): 增量=" + 整数转字符串(净栈增量) +
                       " 区间=[" + 整数转字符串(整64(起点)) + "," +
                       整数转字符串(整64(终点)) + ") 进入深度=" +
                       整数转字符串(进入深度));
    }
    如果 (净栈增量 < 0) {
        IR层诊断("表达式净栈契约违反(吞外层): 增量=" + 整数转字符串(净栈增量) +
                       " 区间=[" + 整数转字符串(整64(起点)) + "," +
                       整数转字符串(整64(终点)) + ") 进入深度=" +
                       整数转字符串(进入深度));
    }
    返回 出口深度;
}
// 894-a（070·G-N 特性波3）：自增/自减**表达式位**发射（407）——读-算-写回，
//   表达式值=旧值（后缀）/新值（前缀）——宿主 T24（297-a）`lastExpr = postfix ?
//   cur : res` 同构、Rust 对照=`x_old = x; x += 1; x_old`（无原生自增表达式·
//   CN 对齐 C 语义）。左值两路：标识符=槽模型（局部/参数/静态/字段/引用·
//   发射自增自减 语句位同款分支+浮点 delta/指针步进/窄宽回绕）；
//   成员/下标=地址模型（生成左值地址 + 指针读写对·宽度=字段三元组推导）。
不安全 函数 生成自增表达式(向量<节点> 池, 节点 n,
                           映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                           向量<IR指令>& 指令, 整64* 寄存器计数,
                           整64* 块计数, 整64* 槽计数, 向量<整64>& 表达式栈) -> 布尔 {
    布尔 是自减 = 整64(n.文本) == 驻留("--");
    布尔 是前缀 = n.附加 == 1;
    整64 运算码 = IR_加;
    如果 (是自减) { 运算码 = IR_减; }
    节点 左末 = 池.元素(整32(n.子终点 - 1));
    整64 旧值reg = 0;
    整64 新值reg = 0;
    如果 (左末.类型 == 节点_标识符) {
        整64 名ID = 整64(左末.文本);
        // 类型码/步进宽（发射自增自减 同款：浮点 delta 同精度·指针步进=元素宽）
        整64 目标类型码 = T_整64;
        整64 自增类型名ID = 查当前函数变量类型(名ID);
        如果 (自增类型名ID >= 0) {
            整64 自增码 = 类型码(自增类型名ID);
            如果 (自增码 == T_浮32 || 自增码 == T_浮64) { 目标类型码 = 自增码; }
        }
        整64 自增量宽 = 1;
        整64 自增指针所指 = 查指针变量类型(名ID);
        如果 (自增指针所指 > 0) {
            目标类型码 = T_整64;
            自增量宽 = 类型名宽度(自增指针所指);
        }
        整64 常量1 = 发射自增增量宽(指令, 目标类型码, 寄存器计数, 自增量宽);
        整64 目标槽 = 0;
        结果<整64, 整32> 找槽 = 局部槽.获取(名ID);
        // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
        如果 (找槽.正常) { 目标槽 = 找槽.值; } 否则 { }
        如果 (目标槽 == 0) {
            结果<整64, 整32> 找参 = 参数槽.获取(名ID);
            // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
            如果 (找参.正常) { 目标槽 = 找参.值; } 否则 { }
        }
        如果 (目标槽 != 0) {
            // 474：自增/自减表达式位溢出检查码（变量类型名→全整型族码；
            //   指针/浮点=0 直通，语句位 发射自增自减 同口径）
            整64 检查码474 = 溢出检查码474(检查码自类型名ID(自增类型名ID));
            如果 (槽是引用(目标槽)) {
                // 引用参数：Load 槽得调用方地址 → 指针读写对
                整64 地址reg = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 地址reg, T_整64, 0));
                旧值reg = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_指针加载, 地址reg, 0, 0, 旧值reg, 目标类型码, 0));
                新值reg = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(运算码, 旧值reg, 常量1, 0, 新值reg, 目标类型码, 检查码474));
                IR追加(指令, 建IR指令(IR_指针存储, 地址reg, 新值reg, 0, 0, 目标类型码, 0));
            } 否则 {
                旧值reg = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 旧值reg, 目标类型码, 0));
                新值reg = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(运算码, 旧值reg, 常量1, 0, 新值reg, 目标类型码, 检查码474));
                // 窄型回绕（422 归纳：判据内联改七消费点单一归属 自增写回窄域回绕）
                新值reg = 自增写回窄域回绕(自增类型名ID, 名ID, 新值reg, 指令, 寄存器计数);
                IR追加(指令, 建IR指令(IR_存储, 新值reg, 0, 0, 0, 0, 目标槽));
            }
        } 否则 {
            整64 找静 = 查静态序号含类(名ID);
            如果 (找静 < 0 && 当前方法类名ID != 0) {
                // 070 波G：类内静态字段裸名（复合赋值 同 自增 口径）
                结果<整64, 整32> 合成内3 = 查类静态字段合成名(当前方法类名ID, 名ID);
                如果 (合成内3.正常) { 找静 = 查静态序号含类(合成内3.值); }
            }
            如果 (找静 < 0) {
                // 434（类名::静态字段 限定读写·#284 ::矩阵第五态）：自增/自减
                //   表达式位（读-算-写回）限定复合名回退——查限定名静态序号
                //   单点分派（语句位 发射自增自减 同源·宿主 ++ 左值通道同语义）
                找静 = 查限定名静态序号(名ID);
            }
            如果 (找静 >= 0) {
                旧值reg = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_静态加载, 0, 0, 0, 旧值reg, 目标类型码, 找静));
                新值reg = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                // 474：静态槽溢出检查（静态不在局部类型表·取静态类型 同 422 判据）
                IR追加(指令, 建IR指令(运算码, 旧值reg, 常量1, 0, 新值reg, 目标类型码,
                                     溢出检查码474(检查码自类型名ID(取静态类型(找静)))));
                // 422:表达式位静态槽窄域回绕（静态不在局部类型表·显式传 取静态类型）
                新值reg = 自增写回窄域回绕(取静态类型(找静), 名ID, 新值reg, 指令, 寄存器计数);
                IR追加(指令, 建IR指令(IR_静态存储, 新值reg, 0, 0, 0, 目标类型码, 找静));
            } 否则 {
                整64 字段偏移 = 当前方法字段偏移(名ID);
                如果 (字段偏移 >= 0) {
                    // 463：字段自增读写宽按字段类型码（布局实宽下恒 qword 读写
                    //   踩相邻窄字段——加载与存储同码对称，宿主 ++ 左值通道同
                    //   语义；浮点局部变量面已有覆盖不扰）
                    目标类型码 = 查字段宽度码(当前方法类名ID, 名ID);
                    整64 字段地址 = 发射类字段地址(字段偏移, 指令, 寄存器计数);
                    旧值reg = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_指针加载, 字段地址, 0, 0, 旧值reg, 目标类型码, 0));
                    新值reg = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    // 474：类字段溢出检查（查字段类型ID 同 422 判据）
                    IR追加(指令, 建IR指令(运算码, 旧值reg, 常量1, 0, 新值reg, 目标类型码,
                                         溢出检查码474(检查码自类型名ID(
                                             查字段类型ID(当前方法类名ID, 名ID)))));
                    // 422:表达式位类字段窄域回绕（字段不在局部类型表·显式传 查字段类型ID）
                    新值reg = 自增写回窄域回绕(查字段类型ID(当前方法类名ID, 名ID), 名ID,
                                          新值reg, 指令, 寄存器计数);
                    IR追加(指令, 建IR指令(IR_指针存储, 字段地址, 新值reg, 0, 0, 目标类型码, 0));
                } 否则 {
                    IR层诊断("自增表达式目标未解析（局部/参数/静态/字段）: " +
                             驻留文本(名ID));
                    返回 假;
                }
            }
        }
    } 否则 如果 (左末.类型 == 节点_成员 || 左末.类型 == 节点_下标) {
        // 467（#434 相邻面·类静态字段点号限定自减表达式位）：链对象=类名标识符
        //   且字段=该类静态字段——点号形态同落 434 「类$字段」静态槽读-算-
        //   写回（查限定名静态序号 拆「类名::字段」复合文本的同构路径：点号形态
        //   对象/字段两 ID 已分离·查类静态字段合成名+查静态序号 同表同源）。
        //   宿主 parser . / :: 同通道折叠 MemberExpr=零分叉锚；原成员左值地址路
        //   把类名当对象基址（槽 miss→「成员左值字段偏移未知」红·探针实证）。
        //   真=已接管；假=穿透既有地址路（实例 对象.字段 零行为变化·宁严勿松）。
        如果 (左末.类型 == 节点_成员) {
            布尔 静态接管467 = 生成静态点号限定自增(池, 左末, 运算码, 是前缀,
                                                    指令, 寄存器计数, 表达式栈);
            如果 (静态接管467) { 返回 真; }
        }
        // 地址模型：生成左值地址（区间取址·无副作用）+ 指针读写对（宽度=字段
        //   三元组推导〔成员〕/默认 8〔下标·v2 值槽模型〕）
        整64 地址 = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
        如果 (地址 == 0) {
            IR层诊断("自增表达式左值地址生成失败");
            返回 假;
        }
        整64 宽度码 = T_整64;
        整64 自增量宽813 = 1;
        如果 (左末.类型 == 节点_成员 && 左末.子起点 > 0) {
            节点 对象节点w = 池.元素(整32(左末.子起点));
            整64 偏移w = 0;
            整64 加载类型w = 0;
            整64 对象类型w = 0;
            整64 值码w = 0;
            解析字段三元组(池, 左末, 对象节点w, 偏移w, 加载类型w, 对象类型w, 值码w);
            如果 (加载类型w != 0) { 宽度码 = 加载类型w; }
            // 813（2026-10-16）：指针字段自增步进=所指元素宽度（宿主 ptrElemStride
            //   同构·标识符分支 查指针变量类型 同口径）——修前恒 +1·整32* 成员链
            //   自增地址错位（探针 813e 实锤步进 1 字节=读位漂移 0x08000000）。
            //   非指针字段=标量 +1 合法形态（b.计数++）；字段类型查不到=真 miss
            //   显形（648·兜底步进 1 保留=中止前路径控制流零变更）。
            整64 字段真类型813 = 解析成员链字段类型813(池, 整32(n.子终点 - 1));
            如果 (字段真类型813 != 0) {
                字符串 字段文本813 = 字符串复制(驻留文本(字段真类型813));
                整64 文本长813 = 字符串长度(字段文本813);
                如果 (文本长813 > 1 &&
                     (整64(字段文本813[整32(文本长813 - 1)]) & 255) == 42) {
                    整64 所指宽813 = 类型名宽度(剥尾星基名(字段真类型813));
                    如果 (所指宽813 > 0) {
                        自增量宽813 = 所指宽813;
                    } 否则 {
                        登记内部未登记("指针字段步进宽度", 字段文本813, 0);
                    }
                }
            } 否则 {
                登记内部未登记("自增成员链字段类型",
                               字符串复制(驻留文本(整64(左末.文本))), 0);
            }
        }
        旧值reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_指针加载, 地址, 0, 0, 旧值reg, 宽度码, 0));
        整64 常量1w = 发射自增增量宽(指令, 宽度码, 寄存器计数, 自增量宽813);
        新值reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        // 474：地址模型（成员/下标）溢出检查——宽度码=字段/元素窄宽码或整32
        //   时检查（指针域恒 T_整64 不区分，理论边界面=指针成员自增近 2^63
        //   误报·64 位用户态地址空间不可达，备案）；检查码经 不安全豁免判。
        IR追加(指令, 建IR指令(运算码, 旧值reg, 常量1w, 0, 新值reg, 宽度码,
                             溢出检查码474(溢出检查码自码474(宽度码))));
        IR追加(指令, 建IR指令(IR_指针存储, 地址, 新值reg, 0, 0, 宽度码, 0));
    } 否则 如果 (左末.类型 == 节点_解引用 && 左末.子终点 > 左末.子起点) {
        // 813（2026-10-16）：解引用位自增——(*p)++ ≡ *p = *p + 1（值自增非地址
        //   步进·宿主 visitUnaryExpr Deref 左值通道同语义·992 锁面「解引用自增:
        //   6」）。地址=操作数区间求值（指针值·弹清表达式栈）→ 指针读写对
        //   （宽度=解引用所指宽度码813 单点·miss 显形+T_整64 兜底）。
        整64 求值前深度813 = 表达式栈.大小();
        整64 地址813 = 生成表达式(池, 左末.子起点, 左末.子终点, 局部槽, 参数槽,
                               指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
        当 (表达式栈.大小() > 求值前深度813) {
            结果<空类型, 整32> 删栈813 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈813.正常) { 运行时错误(4); }
        }
        如果 (地址813 == 0) {
            IR层诊断("自增表达式左值地址生成失败");
            返回 假;
        }
        整64 宽度码813 = 解引用所指宽度码813(池, 左末);
        旧值reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_指针加载, 地址813, 0, 0, 旧值reg, 宽度码813, 0));
        整64 常量1d813 = 发射自增增量(指令, 宽度码813, 寄存器计数);
        新值reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(运算码, 旧值reg, 常量1d813, 0, 新值reg, 宽度码813,
                             溢出检查码474(溢出检查码自码474(宽度码813))));
        IR追加(指令, 建IR指令(IR_指针存储, 地址813, 新值reg, 0, 0, 宽度码813, 0));
    } 否则 {
        IR层诊断("自增表达式左值形态暂限标识符/成员/下标/解引用（其余形态待登记）");
        返回 假;
    }
    // 表达式值：后缀=旧值 / 前缀=新值（宿主 T24 同构）
    整64 值压回 = 是前缀 ? 新值reg : 旧值reg;
    结果<空类型, 整32> 压回z = 表达式栈.追加(值压回);
    如果 (!压回z.正常) { 运行时错误(4); }
    返回 真;
}

// 467（#434 相邻面·类静态字段点号限定自减表达式位）：成员链「类名.字段」且字段=
//   该类静态字段时接管发射——读-算-写回（434 表达式位静态通道同款发射序列：
//   IR_静态加载/运算/422 窄域回绕〔取静态类型 显式传入〕/IR_静态存储）+值压回
//   （后缀=旧值/前缀=新值·894-a 同构）。判定 miss（链非两节点/对象非标识符/
//   非用户类/非静态字段/序号未登记）一律返回 假 穿透既有成员左值地址路——
//   零新通道：与 查限定名静态序号（:: 复合文本形态）同落「类$字段」静态槽，
//   与 :: 形态宿主同语义零分叉（714/467 探针锁面）。
不安全 函数 生成静态点号限定自增(向量<节点> 池, 节点 左末, 整64 运算码, 布尔 是前缀,
                              向量<IR指令>& 指令, 整64* 寄存器计数,
                              向量<整64>& 表达式栈) -> 布尔 {
    // 成员节点子结构（解析成员后缀 约定）：子起点=对象节点索引、子终点恒 0
    //   （容器/结果变量时预标注对象类型 ID·解析基础 P7b）——对象单节点取法与
    //   生成自增表达式 成员宽度推导 解析字段三元组 同款（145 行）
    如果 (左末.子起点 <= 0) { 返回 假; }
    节点 对象节点467 = 池.元素(整32(左末.子起点));
    如果 (对象节点467.类型 != 节点_标识符) { 返回 假; }
    整64 类ID467 = 整64(对象节点467.文本);
    如果 (!是用户类_ID(类ID467)) { 返回 假; }
    结果<整64, 整32> 合成467 = 查类静态字段合成名(类ID467, 整64(左末.文本));
    如果 (!合成467.正常) { 返回 假; }
    整64 找静467 = 查静态序号(合成467.值);
    如果 (找静467 < 0) { 返回 假; }
    // 读-算-写回（434 表达式位静态通道同款：静态字段非局部指针·类型码 T_整64
    //   口径与 :: 形态一致，窄域回绕经 取静态类型 显式规范化）
    整64 目标类型码 = T_整64;
    整64 旧值reg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_静态加载, 0, 0, 0, 旧值reg, 目标类型码, 找静467));
    整64 常量1 = 发射自增增量宽(指令, 目标类型码, 寄存器计数, 1);
    整64 新值reg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(运算码, 旧值reg, 常量1, 0, 新值reg, 目标类型码, 0));
    新值reg = 自增写回窄域回绕(取静态类型(找静467), 合成467.值, 新值reg, 指令, 寄存器计数);
    IR追加(指令, 建IR指令(IR_静态存储, 新值reg, 0, 0, 0, 目标类型码, 找静467));
    // 表达式值：后缀=旧值 / 前缀=新值（宿主 T24 同构）
    整64 值压回467 = 是前缀 ? 新值reg : 旧值reg;
    结果<空类型, 整32> 压回467 = 表达式栈.追加(值压回467);
    如果 (!压回467.正常) { 运行时错误(4); }
    返回 真;
}

// 894-a（070·G-N 特性波3）：赋值表达式位轻量发射（287 链式赋值）——主循环
//   已逐节点求值右值子区间（[子起点,子终点) 物理在赋值根之前）→栈顶即右值
//   值寄存器；弹栈→按左值形态存储→值寄存器压回（表达式值=所赋值·C 语义）。
//   Rust 对照：Rust 赋值表达式值=()（赋值非值表达式）；CN 规范对齐 C++（值=
//   所赋值·宿主 AssignmentExpr 同构）——寄存器型 IR 天然零拷贝（右值寄存器
//   直通表达式值，无写后回读；对齐双目标「性能超 C++」的零额外指令路径）。
//   守卫（宁严勿松）：结构体/容器/用户类/字符串左值（整体值/句柄类——轻量
//   通道无深拷/拥有串设施〔生成赋值语句 家族职责〕，浅存=双释放/泄漏面）
//   与非标识符左值（成员/下标/解引用）→ IR 层诊断拒绝（宿主全支持·诚实边界
//   登记 002 后续波「链式赋值全形态」）。128 位=地址句柄双半拷贝（生成标识符
//   赋值 810 分支同款）。
不安全 函数 生成赋值表达式(向量<节点> 池, 节点 n,
                            映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                            向量<IR指令>& 指令, 整64* 寄存器计数,
                            整64* 槽计数, 向量<整64>& 表达式栈) -> 布尔 {
    如果 (n.文本 == 0) {
        IR层诊断("链式赋值表达式左值暂限标识符（成员/下标/解引用位登记 002 后续波）");
        返回 假;
    }
    整64 左类型ID = 查当前函数变量类型(整64(n.文本));
    字符串 左类型文本 = 左类型ID > 0 ? 字符串复制(驻留文本(左类型ID)) : 字符串复制("");
    如果 (左类型ID > 0 && (查结构体大小(左类型ID) != 0 || 是容器类(左类型文本) ||
                          是用户类(左类型文本) ||
                          字符串比较(左类型文本, "字符串"))) {
        IR层诊断("链式赋值表达式左值类型暂限标量/指针（整体值类登记 002 后续波）: " + 左类型文本);
        返回 假;
    }
    // 弹右值前先弹**左值标识符求值残留**（主循环线性求值把左值 x 也压了栈
    //   ——赋值消费它·净贡献=左值(+1)+右值(+1)+本节点(弹2压1)=+1·净栈契约
    //   实测增量=2 违规的根因）；标识符左值=恰 1 压（本轮限定面）
    如果 (表达式栈.大小() < 2) { 返回 假; }
    整64 值寄存器 = 表达式栈.元素(表达式栈.大小() - 1);
    结果<空类型, 整32> 弹栈a = 表达式栈.删除(表达式栈.大小() - 1);
    如果 (!弹栈a.正常) { 运行时错误(4); }
    结果<空类型, 整32> 弹左残 = 表达式栈.删除(表达式栈.大小() - 1);
    如果 (!弹左残.正常) { 运行时错误(4); }
    // 128 位：值寄存器=地址句柄→目标槽对双半拷贝（局部/参数）/静态区 16 字节
    如果 (字符串比较(左类型文本, "整128") || 字符串比较(左类型文本, "正128")) {
        整64 源码128 = 查寄存器类型(值寄存器);
        整64 目标槽128 = 0;
        结果<整64, 整32> 找槽128 = 局部槽.获取(整64(n.文本));
        // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
        如果 (找槽128.正常) { 目标槽128 = 找槽128.值; } 否则 { }
        如果 (目标槽128 == 0) {
            结果<整64, 整32> 找参128 = 参数槽.获取(整64(n.文本));
            // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
            如果 (找参128.正常) { 目标槽128 = 找参128.值; } 否则 { }
        }
        如果 (目标槽128 != 0 && (源码128 == T_整128 || 源码128 == T_正128)) {
            发射128位双半拷贝(值寄存器, 目标槽128, 目标槽128 - 1, 指令, 寄存器计数);
        } 否则 {
            整64 找静128 = 查静态序号含类(整64(n.文本));
            如果 (找静128 >= 0) {
                整64 静地址128 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静地址128, T_整64, 找静128));
                IR追加(指令, 建IR指令(IR_结构体拷贝, 值寄存器, 静地址128, 0, 0, 16, 0));
            } 否则 {
                IR层诊断("128 位链式赋值目标未解析（局部/参数/静态外登记后续）: " +
                         驻留文本(整64(n.文本)));
                返回 假;
            }
        }
        结果<空类型, 整32> 压回128 = 表达式栈.追加(值寄存器);
        如果 (!压回128.正常) { 运行时错误(4); }
        返回 真;
    }
    // 目标槽解析：局部 → 参数 → 静态 → 方法体字段
    整64 目标槽 = 0;
    结果<整64, 整32> 找槽 = 局部槽.获取(整64(n.文本));
    // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
    如果 (找槽.正常) { 目标槽 = 找槽.值; } 否则 { }
    如果 (目标槽 == 0) {
        结果<整64, 整32> 找参 = 参数槽.获取(整64(n.文本));
        // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
        如果 (找参.正常) { 目标槽 = 找参.值; } 否则 { }
    }
    如果 (目标槽 != 0) {
        如果 (槽是引用(目标槽)) {
            // 引用参数：Load 槽得调用方左值地址 → 指针写回（主路径同款）
            // 425：宽度码按登记引用类型（同 生成语句赋值 主路径·窄整族防过写）
            // 919：128 值（超承载字面量表达式句柄）先落 64 位域（引用槽防地址碎片）
            值寄存器 = 隐式窄化到64(值寄存器, 指令, 寄存器计数);
            整64 地址reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 地址reg, T_整64, 0));
            IR追加(指令, 建IR指令(IR_指针存储, 地址reg, 值寄存器, 0, 0,
                                  引用参数存储码(目标槽), 0));
        } 否则 如果 (!槽是引用(目标槽)) {
            // 窄宽值规范化（指针跳过）+ 浮点宽化 + 隐式窄化（主路径同款三连）
            // 919（超承载字面量参与表达式·赋值链序收口）：128 值须先落 64 位域
            //   再进窄宽规范化——原序对句柄地址直接发 IR_类型转换＝窄槽读地址
            //   碎片（与 生成语句赋值/生成声明 919 同修·主路径同款链序）。
            值寄存器 = 隐式窄化到64(值寄存器, 指令, 寄存器计数);
            如果 (查指针变量类型(整64(n.文本)) < 0) {
                值寄存器 = 窄宽值规范化(窄宽码自文本(左类型文本), 值寄存器,
                                        指令, 寄存器计数);
            }
            值寄存器 = 浮点宽化存储(左类型文本, 值寄存器, 指令, 寄存器计数);
            IR追加(指令, 建IR指令(IR_存储, 值寄存器, 0, 0, 0, 0, 目标槽));
        }
    } 否则 {
        整64 找静 = 查静态序号含类(整64(n.文本));
        如果 (找静 < 0 && 当前方法类名ID != 0) {
            // 070 波G：类内静态字段裸名写（合成名静态槽）
            结果<整64, 整32> 合成裸写 = 查类静态字段合成名(当前方法类名ID, 整64(n.文本));
            如果 (合成裸写.正常) { 找静 = 查静态序号含类(合成裸写.值); }
        }
        如果 (找静 < 0) {
            // 434（类名::静态字段 限定写·#284 ::矩阵第五态）：限定复合名回退——
            //   查限定名静态序号 单点分派（读位 生成表达式 同源），命中即落
            //   下方 IR_静态存储 既有发射（宿主 AssignmentExpr :: 左值同语义）
            找静 = 查限定名静态序号(整64(n.文本));
        }
        如果 (找静 < 0 && n.子终点 > n.子起点) {
            // 070 波G：类名.静态字段写（赋值节点 文本=字段名·左值区间=对象.字段·
            //   对象=用户类名+静态字段表命中 → 静态槽写——原落字段偏移=静态不入
            //   对象布局「成员左值字段偏移未知」拒绝）
            节点 左末w2 = 池.元素(整32(n.子终点 - 1));
            如果 (左末w2.类型 == 节点_成员 && 左末w2.子起点 > 0) {
                节点 对象w2 = 池.元素(整32(左末w2.子起点));
                如果 (对象w2.类型 == 节点_标识符 && 是用户类_ID(整64(对象w2.文本))) {
                    结果<整64, 整32> 合成w2 = 查类静态字段合成名(整64(对象w2.文本), 整64(左末w2.文本));
                    如果 (合成w2.正常) { 找静 = 查静态序号含类(合成w2.值); }
                }
            }
        }
        如果 (找静 >= 0) {
            IR追加(指令, 建IR指令(IR_静态存储, 值寄存器, 0, 0, 0, T_整64, 找静));
        } 否则 {
            整64 字段偏移 = 当前方法字段偏移(整64(n.文本));
            如果 (字段偏移 >= 0) {
                整64 字段地址 = 发射类字段地址(字段偏移, 指令, 寄存器计数);
                // 463：裸字段写宽度分派按字段类型码（与 生成语句赋值 存宽z 同源
                //   同判据——布局实宽下恒 qword 写穿相邻窄字段·未登记防御 T_整64）
                整64 存宽f = 查字段宽度码(当前方法类名ID, 整64(n.文本));
                IR追加(指令, 建IR指令(IR_指针存储, 字段地址, 值寄存器, 0, 0, 存宽f, 0));
            } 否则 {
                IR层诊断("链式赋值目标未解析（局部/参数/静态/字段）: " +
                         驻留文本(整64(n.文本)));
                返回 假;
            }
        }
    }
    // 表达式值=所赋值（压回栈顶——右值寄存器直通·零拷贝）
    结果<空类型, 整32> 压回 = 表达式栈.追加(值寄存器);
    如果 (!压回.正常) { 运行时错误(4); }
    返回 真;
}

函数 生成表达式(向量<节点> 池, 整32 起点, 整32 终点,
                 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                 向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数,
                 向量<整64>& 表达式栈) -> 整64 {
    // 净栈契约出口校验（88-b）：进入深度——须在任何栈操作之前记录
    整64 净栈进入深度 = 表达式栈.大小();
    // P7b：结果返回 retbuf 共享序号（帧尾 16 字节区）——发射顺序=使用顺序，
    //   每次调用后立即消费（接收 CopyStruct / 丢弃），单 retbuf 复用安全
    常量 retbuf序号 = 1;
    // P6c：预扫描（提取为 收集取址区间/收集短路区间/收集三元区间，R3）。
    向量<整64> 取址区间们 = 向量<整64>();
    收集取址区间(池, 起点, 终点, 取址区间们);
    // 894-a：自增表达式位左值区间（跳过+自增根统一读写）
    向量<整64> 自增区间们 = 向量<整64>();
    收集自增区间(池, 起点, 终点, 自增区间们);
    向量<整64> 逻辑区间们 = 向量<整64>();
    收集短路区间(池, 起点, 终点, 逻辑区间们);
    向量<整64> 三元区间们 = 向量<整64>();
    收集三元区间(池, 起点, 终点, 三元区间们);
    向量<整64> 传播区间们 = 向量<整64>();
    收集错误传播区间(池, 起点, 终点, 传播区间们);
    向量<整64> 构造区间们 = 向量<整64>();
    收集构造区间(池, 起点, 终点, 构造区间们);
    // 862（任务 215 甲裁决实施）：打印族调用实参区间——主遍历跳过，调用节点处
    //   流式分派＝逐参求值→打印调用交替（宿主流式同款·批式对照=849-a「右→左」
    //   观测源）。末位表缺失形态不登记＝兜底走 生成调用 原路径。
    向量<整64> 打印区间们 = 向量<整64>();
    收集打印调用区间(池, 起点, 终点, 打印区间们);
    // 749：连接链区间（一次性字符串连接链整链融合）——后缀池布局下左右子
    //   已在主循环逐一生成，链识别必须在主循环前预扫描；主循环命中区间起点
    //   时交由 生成连接链 整链递归生成（宿主 728o visitBinaryExpr 顶部接管等价位）。
    向量<整64> 连接链区间们 = 向量<整64>();
    收集连接链区间(池, 起点, 终点, 连接链区间们);
    整32 位置 = 起点;
    当 (位置 < 终点) {
        // 862：打印族实参区间跳过（判定置于其他区间之前——内层短路/三元/取址
        //   结构由流式分派递归 生成表达式 重新预扫描，树结构保证区间要么嵌套
        //   要么不相交）
        整64 打终 = 区间终点(打印区间们, 位置, 2);
        如果 (打终 >= 0) { 位置 = 整32(打终); 继续; }
        // 749：连接链区间——须置于取址/自增/短路/三元等区间判定之前：链起点
        //   可能就是这些区间的起点（如 `(甲||乙) + "x" + "y"`），若先被它们
        //   跳过则链根处左右操作数缺失（后序弹栈=错值）。打印区间居前安全
        //   （流式分派对每个实参递归 生成表达式，内层重新预扫描后链融合生效）。
        整64 链终749 = 区间终点(连接链区间们, 位置, 2);
        // 静默豁免业务值: 哨兵判定（-1=未命中/>=0=命中·闭集由解析器产出），非业务数值区间
        如果 (链终749 >= 0) {
            布尔 链成749 = 生成连接链(池, 位置, 整32(链终749), 局部槽, 参数槽,
                                    指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
            // 静默豁免业务值: 解析/判定未命中返回布尔哨兵——调用方按未命中分流（原样保留/跳过），非查表默认值
            如果 (!链成749) { 返回 0; }
            位置 = 整32(链终749);
            继续;
        }
        // 跳过 取地址 子区间 / 短路操作数区间 / 三元三段区间（R3：区间终点 统一判定）
        整64 取终 = 区间终点(取址区间们, 位置, 2);
        如果 (取终 >= 0) { 位置 = 整32(取终); 继续; }
        // 894-a：自增左值区间跳过（左值由自增根统一处理）
        整64 增终 = 区间终点(自增区间们, 位置, 2);
        如果 (增终 >= 0) { 位置 = 整32(增终); 继续; }
        整64 逻终 = 区间终点(逻辑区间们, 位置, 3);
        如果 (逻终 >= 0) { 位置 = 整32(逻终); 继续; }
        整64 三终 = 区间终点(三元区间们, 位置, 2);
        如果 (三终 >= 0) { 位置 = 整32(三终); 继续; }
        整64 传终 = 区间终点(传播区间们, 位置, 2);
        如果 (传终 >= 0) { 位置 = 整32(传终); 继续; }
        // 84-a：结构体字面量构造的值区间跳过（终点=构造节点位置——由该节点统一求值，
        //   避免值表达式被主循环重复求值）
        整64 构终84 = 区间终点(构造区间们, 位置, 2);
        如果 (构终84 >= 0) { 位置 = 整32(构终84); 继续; }
        节点 n = 池.元素(位置);
        // 84-a：结构体字面量作实参（临时槽 + 逐字段写；槽地址压栈 + 登记实参清理）
        如果 (n.类型 == 节点_结构体构造) {
            生成结构体构造(池, n, 局部槽, 参数槽, 指令, 寄存器计数, 块计数,
                          槽计数, 表达式栈);
            位置++;
            继续;
        }
    如果 (n.类型 == 节点_整数字面量 || n.类型 == 节点_布尔字面量 ||
         n.类型 == 节点_字符串字面量 || n.类型 == 节点_浮点字面量 ||
         n.类型 == 节点_字符字面量) {
        生成字面量(n, 指令, 寄存器计数, 槽计数, 表达式栈);
    } 否则 如果 (n.类型 == 节点_标识符) {
            // 418-a（D40 细分）：枚举名裸标识符不压栈——仅作成员链基名
            //   （颜色.绿 由 生成枚举成员常量 折叠压值·裸枚举名无值语义）
            如果 (是枚举名(整64(n.文本))) {
                位置++;
                继续;
            }
            生成标识符加载(n, 局部槽, 参数槽, 指令, 寄存器计数, 槽计数, 表达式栈);
            位置++;
            继续;
        } 否则 如果 (n.类型 == 节点_二元运算) {
            字符串 op名 = 字符串复制(驻留文本(整64(n.文本)));
            // CN 字符串 == 是指针比较（非内容）——须用 字符串比较
            // 短路（&&/||）惰性求值与普通二元（拼接/算术/比较）分流（R3 提取）
            如果 (字符串比较(op名, "&&") || 字符串比较(op名, "||")) {
                生成短路求值(池, n, op名, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
            } 否则 {
                生成二元运算主体(池, n, op名, 位置, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
            }
            位置++;
            继续;
        } 否则 如果 (n.类型 == 节点_三元运算) {
            生成三元运算(池, n, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈,
                        整64(位置));
        } 否则 如果 (n.类型 == 节点_错误传播) {
            // 296-a（D35 波B）：后缀错误传播 表达式?——操作数求值+条件分块，
            //   err 块构造错误结果沿 retbuf 直接返回（宿主 Operator::Propagate 同构）
            生成错误传播(池, n, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
            位置++;
            继续;
        } 否则 如果 (n.类型 == 节点_逻辑非 || n.类型 == 节点_负号 ||
             n.类型 == 节点_位非 ||
             n.类型 == 节点_取地址 || n.类型 == 节点_解引用) {
            生成一元运算(池, n, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
        } 否则 如果 (n.类型 == 节点_成员) {
            // 418-a（D40 细分）：枚举成员链（错误码.内存）——基名=枚举名→
            //   编译期常量折叠（不安全 辅助函数·指针下标安全区挂点隔离）
            如果 (n.子起点 > 0) {
                节点 基名节点e = 池.元素(整32(n.子起点));
                如果 (基名节点e.类型 == 节点_标识符 && 是枚举名(整64(基名节点e.文本))) {
                    生成枚举成员常量(池, n, 指令, 寄存器计数, 表达式栈);
                    位置++;
                    继续;
                }
            }
            // 对象.字段 / 对象->字段：方法接收者 或 字段访问（R3 提取两形态）
            如果 (n.附加 == 成员方法标记) {
                生成方法接收者(池, n, 局部槽, 参数槽, 指令, 寄存器计数, 表达式栈);
            } 否则 {
                // 615：尾传 位置=成员节点池索引（链层级公式 k 计数用）
                生成字段访问(池, n, 局部槽, 参数槽, 指令, 寄存器计数, 表达式栈,
                             整64(位置));
            }
            位置++;
            继续;
        } 否则 如果 (n.类型 == 节点_调用) {
            // 862：打印族流式分派（逐参求值→打印调用交替·宿主流式同款）——
            //   0=非打印族/末位表缺失→兜底走 生成调用 原路径（批式行为不变·
            //   未动指令栈可安全兜底）；-1=流式生成中途失败（半成品指令已发射·
            //   不可兜底）→按生成失败终止
            整64 结果码 = 生成打印流式调用(池, n, 位置, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
            如果 (结果码 == 0) {
                结果码 = 生成调用(池, n, 位置, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈, retbuf序号);
            }
            如果 (结果码 <= 0) { 返回 0; }
            位置++;
            继续;
        } 否则 如果 (n.类型 == 节点_下标) {
            生成下标访问(池, n, 指令, 寄存器计数, 块计数, 表达式栈);
            位置++;
            继续;
        } 否则 如果 (n.类型 == 节点_自增表达式) {
            // 894-a：自增/自减表达式位（407）——读-算-写回+值=旧值(后缀)/新值(前缀)
            布尔 自增式成 = 生成自增表达式(池, n, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
            如果 (!自增式成) { 返回 0; }
            位置++;
            继续;
        } 否则 如果 (n.类型 == 节点_赋值) {
            // 894-a（070·G-N 特性波3）：链式赋值表达式位（287）——右值子区间
            //   [子起点,子终点) 物理在赋值根之前、已被主循环逐节点求值→栈顶
            //   即右值寄存器；存储后压回=表达式值（C 语义「值=所赋值」）。
            布尔 赋值式成 = 生成赋值表达式(池, n, 局部槽, 参数槽, 指令, 寄存器计数, 槽计数, 表达式栈);
            如果 (!赋值式成) { 返回 0; }
            位置++;
            继续;
        }
        位置++;
    }
    // 净栈契约出口校验（88-b）：多压/吞外层当场诊断——契约/性能/Rust 对照详见
    //   净栈契约出口校验 定义处注释（单一事实源）
    整64 出口深度 = 净栈契约出口校验(表达式栈, 净栈进入深度, 起点, 终点);
    如果 (出口深度 == 0) { 返回 0; }
    返回 表达式栈.元素(出口深度 - 1);
}

// ==================== 打印族流式分派（862·任务 215 甲裁决实施） ====================
// 逐参「求值→打印调用」交替——宿主 ir_call 流式同款。215 实测定性：v2 批式
//   （全部实参求值完→逐参发射打印·`生成打印与内置调用` 原路径）观测等效
//   849-a 呈报的「右→左」（实参副作用先于前参输出）；宿主流式＝前参输出先于
//   后参求值副作用。本函数与 收集打印调用区间/打印族实参终点们 构成跳过+分派
//   单一事实源链；返回 0=非打印族/末位表缺失（调用方兜底走 生成调用 原路径）。
