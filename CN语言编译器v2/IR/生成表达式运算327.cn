// CN 自举编译器 v2 · IR 组件·327 判定族（1100-P1·2026-10-19·file_length 冻结线
//   拆分：自 生成表达式运算.cn 按族拆出——327 LL/ULL 双字面量直乘判定 +
//   1100 移位左操作数「逻辑 128 族」判定。纯搬移零行为变更（同包多文件合并
//   全局可见；与 120-a D1 行数整改同款先例）。

导入 容器::向量;
导入 IR;
导入 协议常量;

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 327（2026-10-16）：LL/ULL 后缀字面量末端判定——末端为整数字面量、或
//   负号外壳作用于字面量（子起点取操作数·与 字面量源码类型377 同惯例；
//   负号形态的数学值由物化路径按文本拆半/符号扩展承载）；后缀经
//   字面量后缀类型名ID 定级（无后缀/非法组合=0 不判）。消费=128 分派
//   补物化前的「双侧 128 族」判定的字面量源分支（值域内 LL/ULL 不物化
//   856 纪律下，寄存器码为 64 位侧时按源后缀识别 128 语义）。
函数 是128族字面量末端327(向量<节点> 池, 节点 末端) -> 布尔 {
    整64 名ID327 = 0;
    如果 (末端.类型 == 节点_整数字面量) { 名ID327 = 整64(末端.文本); }
    否则 如果 (末端.类型 == 节点_负号 && 末端.子起点 > 0 &&
              末端.子起点 < 整32(池.大小()) &&
              池.元素(整32(末端.子起点)).类型 == 节点_整数字面量) {
        名ID327 = 整64(池.元素(整32(末端.子起点)).文本);
    }
    如果 (名ID327 == 0) { 返回 假; }
    整64 后缀名327 = 字面量后缀类型名ID(驻留文本(名ID327));
    返回 后缀名327 == 驻留("整128") || 后缀名327 == 驻留("正128");
}

// 327：补物化的有符号性——LL（整128）=1 符号扩展（sar 63 高半）；ULL
//   （正128）=0 零扩展；非 128 族字面量/无后缀形态按寄存器码既有符号性
//   （T_正32/T_正64=无符号=0·其余=1），与 发射128位二元运算 内
//   物化128位操作数 调用同款判据（双点同步纪律）。
函数 是128族有符号327(向量<节点> 池, 节点 末端, 整64 寄存器码) -> 整64 {
    整64 名ID327s = 0;
    如果 (末端.类型 == 节点_整数字面量) { 名ID327s = 整64(末端.文本); }
    否则 如果 (末端.类型 == 节点_负号 && 末端.子起点 > 0 &&
              末端.子起点 < 整32(池.大小()) &&
              池.元素(整32(末端.子起点)).类型 == 节点_整数字面量) {
        名ID327s = 整64(池.元素(整32(末端.子起点)).文本);
    }
    如果 (名ID327s != 0) {
        整64 后缀名327s = 字面量后缀类型名ID(驻留文本(名ID327s));
        如果 (后缀名327s == 驻留("整128")) { 返回 1; }
        如果 (后缀名327s == 驻留("正128")) { 返回 0; }
    }
    返回 (寄存器码 == T_正32 || 寄存器码 == T_正64) ? 0 : 1;
}

// 1100-P1（2026-10-19·审查补漏·按根回溯版）：左操作数「逻辑 128 族」判定——
//   移位左为表达式产物（如 (1LL + 1)、(2LL * 2)、(0 - 1LL)）时，856 不物化
//   纪律下 IR 寄存器码为 64 位、末端节点=二元/一元运算节点而非字面量，
//   是128族字面量末端327 的末节点直判 miss → 移位回落 64 位通道（x86 掩码
//   域丢失：实锚 (1LL+1)<<100 出 2^37 应 2^101、(0-1LL)<<64 出 -1 应 -2^64）。
//   本判定镜像宿主 usual arithmetic conversion 最小面：任一子项为 128 域
//   （LL/ULL 后缀字面量源、128 类型标识符/成员/调用返回/下标元素/三元分支、
//   解引用所指、递归二元两侧与一元负号/位非操作数）→ 结果 128 域。
//   仅 1100 移位专属段消费（非移位面维持 327 原 O(1) 末节点判定=存量零变化）。
//   布局（解析层后序·池后缀布局末端节点=表达式根）：二元节点=区间末，右子根
//   末端=本节点位-1、左子根末端=附加-1（327/617 同款索引惯例）；一元（负号/
//   位非）操作数根末端=子终点-1；逻辑非/取地址产物非 128 域不递归（布尔/指针
//   64 面）。单参「末端位置」设计——**不用 n.子起点**（普通二元构造存右起点
//   快照，非左起点，P1 诊断实测 子起==附加 证伪）。
函数 末端128族327(向量<节点> 池, 整32 末位) -> 布尔 {
    // 静默豁免闭集穷举: 谓词索引边界守卫——假=「非128族」的合法闭集答案
    //   （类型判定谓词·移位分派消费；非查表默认值继续编译）
    如果 (末位 < 0 || 末位 >= 整32(池.大小())) { 返回 假; }
    节点 末 = 池.元素(末位);
    如果 (末.类型 == 节点_整数字面量 ||
        (末.类型 == 节点_负号 && 末.子起点 > 0 &&
         末.子起点 < 整32(池.大小()) &&
         池.元素(整32(末.子起点)).类型 == 节点_整数字面量)) {
        返回 是128族字面量末端327(池, 末);
    }
    如果 (末.类型 == 节点_二元运算) {
        // 后序：右子根=本节点前一位；左子根=附加-1（附加=右子区间起点）
        如果 (末位 >= 1 && 末位 <= 整32(池.大小()) &&
            末端128族327(池, 末位 - 1)) { 返回 真; }
        如果 (末.附加 >= 1 && 末.附加 <= 整64(池.大小())) {
            返回 末端128族327(池, 整32(末.附加) - 1);
        }
        返回 假;
    }
    如果 (末.类型 == 节点_负号 || 末.类型 == 节点_位非) {
        // 一元后序：操作数根末端=子终点-1（子终点=本节点位置）
        如果 (末.子终点 >= 1 && 末.子终点 <= 整32(池.大小())) {
            返回 末端128族327(池, 整32(末.子终点) - 1);
        }
        返回 假;
    }
    如果 (末.类型 == 节点_解引用) {
        整64 所指码327d = 解引用所指宽度码813(池, 末);
        返回 所指码327d == T_整128 || 所指码327d == T_正128;
    }
    整64 名ID327r = 解析节点类型ID(池, 末位);
    如果 (名ID327r == 0) { 返回 假; }
    字符串 名327r = 字符串复制(驻留文本(名ID327r));
    返回 字符串比较(名327r, "整128") || 字符串比较(名327r, "正128");
}
