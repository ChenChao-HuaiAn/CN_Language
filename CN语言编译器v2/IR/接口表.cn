// CN 自举编译器 v2 · 接口元数据表（413·2026-10-11 接口语法族 v2 面补齐）
// 职责：接口单一归属——接口名表（是接口判定）/接口方法签名表（返回类型文本ID+
//   参数串ID）/接口方法全局槽位（B1 分派·宿主 semantic interfaceSlot_ 同构）/
//   类实现接口关系（双向）/类接口分派区槽数。对应 plans/006 P3-19 方案 C
//   「全局接口槽位 + 对象附加虚表区」：每个 (接口,方法) 编译期分配全局唯一槽；
//   实现类对象布局 = [vptr 8][接口分派区 槽数*8][字段区]；接口变量=同一对象地址
//   （A1 零指针调整）；接口调用 = LoadPtr(对象.接口区 + 槽*8) + 间接调用。
// 登记点：语法层 解析接口声明（接口名/方法签名/槽位·解析期跨文件保留——与
//   类布局登记同时机）；解析类继承登记（类实现接口双向关系）。
//   查询点：语义检查（类型引用/齐全性校验）、IR 生成（接口调用分派/去虚拟化）、
//   代码生成（分配对象 接口区填充/vptr 强制）。
// 位置理由：语法层（语法组件 导入 IR 包）与 IR/代码生成（同包）双可达；本文件
//   仅依赖 映射集合+协议常量，无反向依赖（与 IR类 类表同层同纪律）。
导入 映射集合;
导入 协议常量;   // 键位移（335：协议常量独立包）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

静态 映射<整64, 整64> 接口名们;         // 接口名ID -> 1（是接口判定）
静态 映射<整64, 整64> 接口方法槽们;     // 接口ID*键位移+方法ID -> 全局槽
静态 映射<整64, 整64> 接口方法返回们;   // 接口ID*键位移+方法ID -> 返回类型文本ID
静态 映射<整64, 整64> 接口方法参数串们; // 接口ID*键位移+方法ID -> 参数串ID
静态 向量<整64> 接口方法序们;           // 平铺（接口ID, 方法ID）序对——槽号=序对索引/2；
                                        //   接口区填充/实现遍历枚举域（登记序=声明序·稳定）
静态 向量<整64> 类实现接口序们;         // 平铺（类ID, 接口ID）序对（解析序·声明侧关系）
静态 映射<整64, 整64> 类接口区槽数们;   // 类ID -> 接口分派区槽总数（0=无接口区）
静态 映射<整64, 整64> 接口实现类数们;   // 接口ID -> 实现类计数（去虚拟化唯一实现判定）

// 任务级生命周期清空（主.cn 与 清空类表 同步调用；多文件窗口重置）
不安全 函数 清空接口表() -> 空类型 {
    接口名们.清空();
    接口方法槽们.清空();
    接口方法返回们.清空();
    接口方法参数串们.清空();
    接口方法序们.清空();
    类实现接口序们.清空();
    类接口区槽数们.清空();
    接口实现类数们.清空();
}

// 登记接口名（解析接口声明 调用；幂等）
不安全 函数 登记接口名(整64 接口ID) -> 空类型 {
    结果<空类型, 整32> 设 = 接口名们.设置(接口ID, 1);
    如果 (!设.正常) { 运行时错误(4); }
}

函数 是接口名ID(整64 名ID) -> 布尔 {
    如果 (名ID <= 0) { 返回 假; }
    结果<整64, 整32> 查 = 接口名们.获取(名ID);
    返回 查.正常;
}

// 字符串形态判定（IR/代码生成深处拿到类型文本——容器类判定同款消费面）
函数 是接口名(字符串 名) -> 布尔 {
    结果<整64, 整32> 查 = 接口名们.获取(驻留(名));
    返回 查.正常;
}

// 登记接口方法（解析接口声明 调用）：返回类型文本ID + 参数串ID；槽位分配幂等
//   （重复声明同方法保留首槽——与 登记类方法 防御口径一致）
不安全 函数 登记接口方法(整64 接口ID, 整64 方法ID, 整64 返回类型ID, 字符串 参数串) -> 空类型 {
    结果<整64, 整32> 查有 = 接口方法槽们.获取(接口ID * 键位移 + 方法ID);
    如果 (!查有.正常) {
        // B1 全局槽位：新 (接口,方法) 分配全局递增槽（序对索引/2——登记序=槽号）
        整64 新槽 = 整64(接口方法序们.大小() / 2);
        结果<空类型, 整32> 设槽 = 接口方法槽们.设置(接口ID * 键位移 + 方法ID, 新槽);
        如果 (!设槽.正常) { 运行时错误(4); }
        结果<空类型, 整32> 加序a = 接口方法序们.追加(接口ID);
        如果 (!加序a.正常) { 运行时错误(4); }
        结果<空类型, 整32> 加序b = 接口方法序们.追加(方法ID);
        如果 (!加序b.正常) { 运行时错误(4); }
    }
    结果<空类型, 整32> 设返 = 接口方法返回们.设置(接口ID * 键位移 + 方法ID, 返回类型ID);
    如果 (!设返.正常) { 运行时错误(4); }
    结果<空类型, 整32> 设串 = 接口方法参数串们.设置(接口ID * 键位移 + 方法ID,
                                                  驻留(参数串));
    如果 (!设串.正常) { 运行时错误(4); }
}

// 查接口方法全局槽位（-1=非接口方法——调用分派判定入口）
函数 查接口方法槽(整64 接口ID, 整64 方法ID) -> 整64 {
    结果<整64, 整32> 查 = 接口方法槽们.获取(接口ID * 键位移 + 方法ID);
// 静默豁免业务值: 查表 miss 显式哨兵·否则块承接错误分支（1241 显式化）
    如果 (查.正常) { 返回 查.值; } 否则 { 返回 0 - 1; }
}

// 查接口方法返回类型文本ID（0=无此方法）
函数 查接口方法返回(整64 接口ID, 整64 方法ID) -> 整64 {
    结果<整64, 整32> 查 = 接口方法返回们.获取(接口ID * 键位移 + 方法ID);
    // 静默豁免业务值: 查表 miss=键不存在·显式 0 哨兵（1241 批量显式化·否则块承载错误分支）
    如果 (查.正常) { 返回 查.值; } 否则 { 返回 0; }
}

// 查接口方法参数串ID（0=无此方法）
函数 查接口方法参数串(整64 接口ID, 整64 方法ID) -> 整64 {
    结果<整64, 整32> 查 = 接口方法参数串们.获取(接口ID * 键位移 + 方法ID);
    // 静默豁免业务值: 查表 miss=键不存在·显式 0 哨兵（1241 批量显式化·否则块承载错误分支）
    如果 (查.正常) { 返回 查.值; } 否则 { 返回 0; }
}

// 接口方法序枚举（槽号=序；接口区填充遍历/齐全性校验域）
函数 接口方法序数() -> 整64 {
    返回 接口方法序们.大小() / 2;
}

// 取槽号对应的（接口ID, 方法ID）——越界返回 0（防御）
函数 接口槽取接口(整64 槽) -> 整64 {
    如果 (槽 < 0 || 槽 * 2 + 1 >= 接口方法序们.大小()) { 返回 0; }
    返回 接口方法序们.元素(槽 * 2);
}

函数 接口槽取方法(整64 槽) -> 整64 {
    如果 (槽 < 0 || 槽 * 2 + 1 >= 接口方法序们.大小()) { 返回 0; }
    返回 接口方法序们.元素(槽 * 2 + 1);
}

// 登记类实现接口（解析类继承登记 调用）：声明侧+反向计数双登记（幂等——
//   同类同接口重复声明只计一次）
不安全 函数 登记类实现接口(整64 类ID, 整64 接口ID) -> 空类型 {
    // 去重查声明侧
    整64 i = 0;
    当 (i + 1 < 类实现接口序们.大小()) {
        如果 (类实现接口序们.元素(i) == 类ID &&
             类实现接口序们.元素(i + 1) == 接口ID) {
            返回;
        }
        i = i + 2;
    }
    结果<空类型, 整32> 加a = 类实现接口序们.追加(类ID);
    如果 (!加a.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加b = 类实现接口序们.追加(接口ID);
    如果 (!加b.正常) { 运行时错误(4); }
    // 反向实现计数（去虚拟化：恰 1 → 编译期直调·宿主 interfaceImplClasses 同判）
    结果<整64, 整32> 查数 = 接口实现类数们.获取(接口ID);
    整64 旧数 = 0;
    如果 (查数.正常) { 旧数 = 查数.值; }
    结果<空类型, 整32> 设数 = 接口实现类数们.设置(接口ID, 旧数 + 1);
    如果 (!设数.正常) { 运行时错误(4); }
}

// 类实现接口判定（本类声明侧直查）
函数 类实现接口(整64 类ID, 整64 接口ID) -> 布尔 {
    整64 i = 0;
    当 (i + 1 < 类实现接口序们.大小()) {
        如果 (类实现接口序们.元素(i) == 类ID &&
             类实现接口序们.元素(i + 1) == 接口ID) {
            返回 真;
        }
        i = i + 2;
    }
    返回 假;
}

// 类实现接口沿基类链判定（继承并入——子类沿用父接口实现·宿主跨链收集同语义；
//   守卫 64 防继承环——与 查类方法返回 沿链守卫同口径）
函数 类实现接口沿链(整64 类ID, 整64 接口ID) -> 布尔 {
    整64 当前c = 类ID;
    整64 守卫g = 0;
    当 (当前c != 0 && 守卫g < 64) {
        如果 (类实现接口(当前c, 接口ID)) { 返回 真; }
        当前c = 查类基名(当前c);
        守卫g++;
    }
    返回 假;
}

// 接口实现类计数（直登·声明侧；去虚拟化唯一实现判定）
函数 接口实现类数(整64 接口ID) -> 整64 {
    结果<整64, 整32> 查 = 接口实现类数们.获取(接口ID);
    // 静默豁免业务值: 查表 miss=键不存在·显式 0 哨兵（1241 批量显式化·否则块承载错误分支）
    如果 (查.正常) { 返回 查.值; } 否则 { 返回 0; }
}

// 接口唯一实现类（0=多实现或零实现——调用方据 实现类数==1 先行判定；
//   直登计数恰 1 时线性取该类ID）
函数 接口唯一实现(整64 接口ID) -> 整64 {
    如果 (接口实现类数(接口ID) != 1) { 返回 0; }
    整64 i = 0;
    当 (i + 1 < 类实现接口序们.大小()) {
        如果 (类实现接口序们.元素(i + 1) == 接口ID) {
            返回 类实现接口序们.元素(i);
        }
        i = i + 2;
    }
    返回 0;
}

// 登记类接口区槽数（解析类布局收口 调用）：接口分派区槽总数（0=无接口区）
不安全 函数 登记类接口区槽数(整64 类ID, 整64 槽数) -> 空类型 {
    结果<空类型, 整32> 设 = 类接口区槽数们.设置(类ID, 槽数);
    如果 (!设.正常) { 运行时错误(4); }
}

// 查类接口区槽数（0=无接口区——布局/vptr 强制/接口区填充三消费同基）
函数 查类接口区槽数(整64 类ID) -> 整64 {
    结果<整64, 整32> 查 = 类接口区槽数们.获取(类ID);
    // 静默豁免业务值: 查表 miss=键不存在·显式 0 哨兵（1241 批量显式化·否则块承载错误分支）
    如果 (查.正常) { 返回 查.值; } 否则 { 返回 0; }
}

// 合成类接口区槽数（解析期·布局计算消费）：沿基类链实现接口的方法全局槽最大值
//   +1（0=该类无接口区）。接口先于实现类声明（与基类「须先声明」同纪律）→
//   本函数调用时接口方法序已冻结，槽号稳定。
函数 合成类接口区槽数(整64 类ID) -> 整64 {
    整64 最大槽 = 0 - 1;
    整64 序s = 0;
    当 (序s < 接口方法序数()) {
        如果 (类实现接口沿链(类ID, 接口槽取接口(序s))) {
            如果 (序s > 最大槽) { 最大槽 = 序s; }
        }
        序s++;
    }
    返回 最大槽 + 1;
}
