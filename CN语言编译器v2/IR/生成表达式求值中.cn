// 生成表达式求值中（356 重构F1 自 生成表达式求值.cn 纯机械搬移·函数体逐字保留·零逻辑变化）
导入 容器::向量;
导入 映射集合;
导入 语法;       // Token/AST 节点池（目录包名）
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码 + IR常量 键位移（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 IR生成;     // 函数级变量类型权威表/重载决议/控制流辅助（同包幂等）

公开:

// 方法调用发射（被调=方法标记，标记下压着 this）：容器类签名命中→retbuf/标量
//   分派+结构体按值实参回扫取地址（B3/B8）+类型登记；未收录/对象未知=诊断终止。
不安全 函数 生成方法调用(向量<节点> 池, 节点 n, 整32 位置, 整64 被调, 向量<整64>& 弹出们,
                 整64 实参数, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                 向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数,
                 向量<整64>& 表达式栈,
                 整64 retbuf序号) -> 空类型 {
            整64 方法名ID = 0 - 被调 - 1000000;
            整64 this寄存器 = 0;
            如果 (表达式栈.大小() >= 1) {
                this寄存器 = 表达式栈.元素(表达式栈.大小() - 1);
                结果<空类型, 整32> 删this = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删this.正常) { 运行时错误(4); }
            }
            字符串 方法名文本 = 字符串复制(驻留文本(方法名ID));
            // 070 波G（1026）：类名.静态方法() 调用——对象=用户类名（非变量遮
            //   蔽）+类静态方法表命中 → 直调（无 this·实参位0 起·符号=类$方法
            //   [#参数串]·宿主 P3-23 静态形态 ABI）；对象求值的负占位丢弃。
            {
                节点 成员st = 池.元素(整32(n.子起点));
                如果 (成员st.类型 == 节点_成员 && 成员st.子起点 > 0) {
                    节点 对象st = 池.元素(整32(成员st.子起点));
                    如果 (对象st.类型 == 节点_标识符 && 是用户类_ID(整64(对象st.文本)) &&
                         是类静态方法(整64(对象st.文本), 方法名ID)) {
                        整64 参数串IDst = 查类方法参数串(整64(对象st.文本), 方法名ID);
                        字符串 参数串st = "";
                        如果 (参数串IDst != 0) { 参数串st = 字符串复制(驻留文本(参数串IDst)); }
                        字符串 方法符号st = 方法符号(字符串复制(驻留文本(整64(对象st.文本))),
                                                  方法名文本, 参数串st);
                        如果 (表达式栈.大小() >= 1) {
                            结果<空类型, 整32> 删负st = 表达式栈.删除(表达式栈.大小() - 1);
                            如果 (!删负st.正常) { 运行时错误(4); }
                        }
                        发射调用实参们(弹出们, 0, 指令, 实参类型码们(弹出们));
                        整64 返回寄存器st = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        整64 返回码st = 0;
                        整64 返回类型IDst = 查类方法返回(整64(对象st.文本), 方法名ID);
                        如果 (返回类型IDst > 0) { 返回码st = 类型码(返回类型IDst); }
                        IR追加(指令, 建IR指令(IR_调用参数化, 弹出们.大小(), 返回码st, 0,
                                             返回寄存器st, retbuf序号, 驻留(方法符号st)));
                        如果 (返回码st != T_未知 && 返回码st != T_空类型) {
                            登记寄存器类型(返回寄存器st, 返回码st);
                        }
                        结果<空类型, 整32> 加st = 表达式栈.追加(返回寄存器st);
                        如果 (!加st.正常) { 运行时错误(4); }
                        返回;
                    }
                }
            }
            字符串 类名 = "";
            // ②c A/B：对象类型统一解析（标识符：容器变量/结构体容器字段；
            //   调用：返回容器/返回结构体的容器字段——元素(0).设置/b.表.追加）
            整64 对象类ID2 = 解析方法对象类型扩展(池, 位置);
            如果 (对象类ID2 != 0) {
                类名 = 字符串复制(驻留文本(对象类ID2));
            }
            如果 (是容器类(类名)) {
                方法签名 签;
                如果 (查方法签名(类名, 方法名文本, 实参数, &签)) {
                    // 790-a（052 甲波2/3·元素可变方法写穿〔基准=019〕·127_v2 断言
                    //   206 根治）：「容器.元素(i)」链式作**可变方法**接收者
                    //   （层表.元素(0).设置(k,v)）——元素 求值的 retbuf 物化+深拷
                    //   副本（650-a 读侧值语义）使 设置 写在副本上丢弃=静默丢失
                    //   （127_v2 获取(2) 未命中 rc=206 实锤）。前瞻池序列（后缀链
                    //   布局：本调用(位置)→[+1]=成员(子起点==位置·方法形态标记)
                    //   →[+2]=调用(子起点==位置+1)）且成员名∈可变方法清单 →
                    //   元素 走**地址直通**：不发射 元素 调用，直接产元素槽地址
                    //   （数据基址+下标×元素字节·内联元素模型与 stdlib 数据[i]
                    //   步进同源）→可变方法写穿原容器（Swift 下标 set 同构·
                    //   零拷贝·与 056 甲 COW/in-out 同向）。前瞻未命中=读场景
                    //   保持 650-a 副本语义（字节级不变）。
                    如果 (字符串比较(方法名文本, "元素") && 实参数 == 1 && 位置 + 2 < 整32(池.大小())) {
                        节点 后成员n790 = 池.元素(位置 + 1);
                        // 790-a 池布局=[根,成员,实参...,调用]（466-a 同源）——
                        //   调用节点在实参之后：从 位置+2 扫描首个 节点_调用 且
                        //   子起点==位置+1（被调=该成员·462 参数起点-1 同位）。
                        节点 后调用n790 = 后成员n790;
                        布尔 可变后继790 = 假;
                        如果 (后成员n790.类型 == 节点_成员) {
                            如果 (后成员n790.附加 == 成员方法标记) {
                                如果 (后成员n790.子起点 == 位置) {
                                    整32 扫描k790 = 位置 + 2;
                                    当 (扫描k790 < 整32(池.大小()) && 扫描k790 <= 位置 + 12) {
                                        节点 扫描n790 = 池.元素(扫描k790);
                                        如果 (扫描n790.类型 == 节点_调用) {
                                            如果 (扫描n790.子起点 == 位置 + 1) {
                                                后调用n790 = 扫描n790;
                                                可变后继790 = 真;
                                            }
                                            中断;
                                        }
                                        扫描k790++;
                                    }
                                }
                            }
                        }
                        如果 (可变后继790) {
                            字符串 后方法名790 = 字符串复制(驻留文本(整64(后成员n790.文本)));
                            布尔 是可变790 = 字符串比较(后方法名790, "设置") ||
                                字符串比较(后方法名790, "删除") ||
                                字符串比较(后方法名790, "清空") ||
                                字符串比较(后方法名790, "插入") ||
                                字符串比较(后方法名790, "弹出");
                            如果 (是可变790) {
                                整64 返回结构ID790 = 驻留(签.返回文本);
                                整64 元素字节790 = 查结构体大小(返回结构ID790);
                                如果 (元素字节790 > 0) {
                                    整64 下标值790 = 弹出们.元素(0);
                                    整64 数据槽790 = 寄存器计数[0];
                                    寄存器计数[0] = 寄存器计数[0] + 1;
                                    IR追加(指令, 建IR指令(IR_字段地址, this寄存器, 0, 0,
                                                         数据槽790, T_整64, 0));
                                    整64 数据基址790 = 寄存器计数[0];
                                    寄存器计数[0] = 寄存器计数[0] + 1;
                                    IR追加(指令, 建IR指令(IR_指针加载, 数据槽790, 0, 0,
                                                         数据基址790, T_整64, 0));
                                    整64 元素槽790 = 数据基址790;
                                    如果 (元素字节790 != 1) {
                                        整64 步进常量790 = 寄存器计数[0];
                                        寄存器计数[0] = 寄存器计数[0] + 1;
                                        IR追加(指令, 建IR指令(IR_常量整数,
                                             整64(驻留(整数转字符串(元素字节790))), 0, 0,
                                             步进常量790, T_整64, 0));
                                        整64 缩放790 = 寄存器计数[0];
                                        寄存器计数[0] = 寄存器计数[0] + 1;
                                        IR追加(指令, 建IR指令(IR_乘, 下标值790, 步进常量790,
                                                             0, 缩放790, T_整64, 0));
                                        整64 加法790 = 寄存器计数[0];
                                        寄存器计数[0] = 寄存器计数[0] + 1;
                                        IR追加(指令, 建IR指令(IR_加, 数据基址790, 缩放790,
                                                             0, 加法790, T_整64, 0));
                                        元素槽790 = 加法790;
                                    }
                                    登记寄存器类型(元素槽790, T_对象);
                                    结果<空类型, 整32> 加槽790 = 表达式栈.追加(元素槽790);
                                    如果 (!加槽790.正常) { 运行时错误(4); }
                                    返回;
                                }
                            }
                        }
                    }
                    // ②b B6：retbuf 按真实返回字节数定帧——累计本函数最大值
                    整64 retbuf字节 = 签名返回字节数(&签);
                    累计retbuf字节数(retbuf字节);
                    整64 符号ID = 驻留(方法符号(类名, 方法名文本, 签.参数串));
                    整64 retbuf = 0;
                    整64 目标寄存器 = 0;
                    整64 实参起始位 = 1;
                    如果 (签.返回形态 == 容器返回_结果空 || 签.返回形态 == 容器返回_结果值 ||
                         签.返回形态 == 容器返回_结构体) {
                        retbuf = retbuf序号;
                        实参起始位 = 2;   // 位0=retbuf、位1=this、实参从位2
                        目标寄存器 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                    } 否则 如果 (签.返回形态 == 容器返回_标量) {
                        目标寄存器 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                    }
                    // 74-a（2026-09-11 第七十四轮）：入容器位所有权归一化——
                    //   容器析构会释放元素串（容器拥有元素所有权），故入容器必须
                    //   由编译器接管所有权（宿主 buildCallArgsForMethod 同款）。
                    //   **时序**：须在 this 的 IR_调用实参 之前发射——代码生成的调用
                    //   展开是「收集 IR_调用实参，遇 IR_调用参数化 统一展开」，若
                    //   在 this/实参声明之后插入独立调用，其 IR_调用参数化 会把
                    //   已收集实参一并展开（位数错乱）。
                    // 81-a（2026-09-12 第八十一轮）：79-a 的
                    //   标记入容器结构体污染 整链删除——元素槽字段串由 stdlib
                    //   容器方法体的 `数据[n] = 值` 结构体写入深拷独立拥有，源结构体
                    //   照常拥有并释放（该标记原使源字段串跳过释放=每元素泄漏 2，
                    //   实测 P2/P3 实证；容器消亡/移除路径的释放面由宿主编译 stdlib
                    //   时注入的 ~容器/清空/删除 方法体承担）。
                    归一化入容器实参(池, n, 位置, 类名, 方法名文本, 弹出们,
                                     局部槽, 参数槽, 指令, 寄存器计数);
                    IR追加(指令, 建IR指令(IR_调用实参, this寄存器, 0, 0, 0, 实参起始位 - 1, 0));
                    // ②b B3（2026-09-02）：结构体按值实参 -> 传地址（宿主 ABI：
                    //   调用方传指针、被调方拷贝入参/元素存储）。裸标识符实参的
                    //   值装载（IR_加载）回扫取槽改发 IR_取地址（B8 抽出共用辅助）。
                    整64 实i = 0;
                    当 (实i < 弹出们.大小()) {
                        字符串 段文本 = 取参数段(签.参数串, 实i);
                        // 595-a 立案（001-001 残余·容器方法第三回扫源）：此处
                        //   按 签.参数串 段 查结构体大小 判取地址——撤守卫态容器
                        //   实参段命中 → 取地址传栈槽、被调方 fix5 单槽当句柄 →
                        //   元素槽伪对象。直改（!是容器类 排除）触发 v2p 自身
                        //   编译期运行时错误 1024（机制待独立定性）——本点撤守卫
                        //   态容器方法容器实参面=下轮主攻面。
                        // 983（002·57 转批①同族·实参形态）：非结构体大标量
                        //   （整128/正128=16 字节）实参→取地址传——宿主 MSVC ABI
                        //   对 >8 字节 POD 实参一律按引用传（v2p.obj 被调方
                        //   追加$整128 收隐藏指针），v2 旧按值装载→写坏元素槽/
                        //   元素数量丢失（第二次追加丢+首元素错值实证）。
                        如果 (!是容器类(段文本) &&
                             (查结构体大小(驻留(段文本)) != 0 ||
                              类型名宽度(驻留(段文本)) > 8)) {
                            回扫实参取地址(指令, 弹出们, 实i, 寄存器计数, 槽计数);
                        } 否则 如果 (字符串长度(段文本) > 0 &&
                                     ((整64(段文本[整32(字符串长度(段文本) - 1)]) & 255) == 38)) {
                            // 432-b 根治：& 引用实参 → 传左值地址（原缺=引用形参
                            //   传值→被调方把值当地址解引用写崩；123 链查找 前驱
                            //   实测 SIGSEGV r10=-1=前驱初值）
                            回扫实参取地址(指令, 弹出们, 实i, 寄存器计数, 槽计数);
                        }
                        实i++;
                    }
                    发射调用实参们(弹出们, 实参起始位, 指令,
                                  容器实参类型码们(签.参数串, 弹出们));
                    // 91-a：返回类型码（容器返回_标量 按替换后返回类型解析——
                    //   浮点元素返回走 xmm0；retbuf 形态=地址标 0 整型类）
                    整64 容器返回码 = 0;
                    如果 (签.返回形态 == 容器返回_标量) {
                        容器返回码 = 类型码(驻留(签.返回文本));
                    }
                    IR追加(指令, 建IR指令(IR_调用参数化, 实参起始位 + 实参数, 容器返回码, 0,
                                         目标寄存器, retbuf, 符号ID));
                    如果 (目标寄存器 != 0) {
                        // ③ 第二波（方案A）：容器方法标量返回类型登记——签.返回文本
                        //   =替换后返回类型（向量<字符串>.元素(i) -> "字符串"）；
                        //   结果/结构体返回=retbuf 地址不做标量登记（.值/.字段 路径自理）
                        如果 (签.返回形态 == 容器返回_标量) {
                            整64 方法返回码 = 类型码(驻留(签.返回文本));
                            如果 (方法返回码 != T_未知) {
                                登记寄存器类型(目标寄存器, 方法返回码);
                            }
                        } 否则 如果 (签.返回形态 == 容器返回_结构体) {
                            // 983（002·57 转批①登记侧）：大标量值类型（整128/正128）
                            //   走 retbuf 形态后须登记 T_整128/T_正128——值=retbuf
                            //   地址（810「128 位表达式统一形态：右值=地址句柄」同源·
                            //   打印分派 __cn_print_i128 传址消费）；原不登记→查类型
                            //   miss→打印落 __cn_print_int 打出 retbuf 栈地址
                            //   （0x8000160C00 实证）。
                            整64 大标量码983 = 类型码(驻留(签.返回文本));
                            如果 (大标量码983 == T_整128 || 大标量码983 == T_正128) {
                                登记寄存器类型(目标寄存器, 大标量码983);
                            }
                        }
                        // 617-a 波2（001-001·元素读取归一化）：返回 T=**有拷贝构造
                        //   类实例** → 调用点立即拷贝构造副本（分配对象+call 拷贝
                        //   构造·句柄唯一持有者·宿主按值返回拷贝对照）——原句柄
                        //   直传=调用方与容器共享元素→调用方 释放内部数组/写 作用
                        //   别名→双释放/堆损坏（113 弹出 铁证）。纯标量结构体
                        //   （无拷贝构造）不触发=零开销；字符串元素=驻留/串释放
                        //   面自理（②③ 域）不进本分支。
                        如果 (签.返回形态 == 容器返回_标量) {
                            整64 返回实例IDk = 驻留(签.返回文本);
                            整64 拷贝串IDk = 查类拷贝构造串(返回实例IDk);
                            如果 (拷贝串IDk != 0) {
                                整64 新objk = 寄存器计数[0];
                                寄存器计数[0] = 寄存器计数[0] + 1;
                                IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新objk,
                                     查结构体大小(返回实例IDk), 返回实例IDk));
                                IR追加(指令, 建IR指令(IR_调用实参, 新objk, 0, 0, 0, 0, 0));
                                IR追加(指令, 建IR指令(IR_调用实参, 目标寄存器, 0, 0, 0, 1, 0));
                                IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                                     驻留(方法符号(签.返回文本,
                                           剥实例基名(签.返回文本),
                                           字符串复制(驻留文本(拷贝串IDk))))));
                                目标寄存器 = 新objk;
                            }
                        }
                        // 118（929·任务 118）：引用返回方法读值默认 lvalue-to-rvalue
                        //   （签.返回文本 尾 '&'——IR签名 829 起保留后缀）。标量元素
                        //   须 IR_指针加载 读值（原 rax=槽地址直传=地址当值静默错值）；
                        //   聚合 T（容器/结构体内联实宽存储·元素地址即对象本体）直传
                        //   不解引用（宿主 refReturnAggInline 分叉同构——v2p 双重解引用
                        //   崩溃实证映射$..& 步进 56）。写链（赋值目标/绑定）经 生成左值
                        //   地址 的「回扫 IR_指针加载 取操作数1」回取地址=函数路径同构。
                        如果 (签.返回形态 == 容器返回_标量 &&
                             字符串长度(签.返回文本) > 1 &&
                             ((整64(签.返回文本[整32(字符串长度(签.返回文本) - 1)]) & 255) == 38)) {
                            字符串 引用基名z = 字符串子串(签.返回文本, 0,
                                                        字符串长度(签.返回文本) - 1);
                            布尔 聚合直传z = 是容器类(引用基名z) ||
                                查结构体大小(驻留(引用基名z)) != 0;
                            如果 (!聚合直传z) {
                                整64 解引用regz = 寄存器计数[0];
                                寄存器计数[0] = 寄存器计数[0] + 1;
                                // 宽度=元素类型码（整32 元素读 4 字节——原 T_整64
                                //   恒 8 字节跨元素读=高位并相邻元素·v2read1 探针
                                //   元素(0)读 0x200000001 实证）；未知类型回退 8 字节
                                整64 引返回码z = 类型码(驻留(引用基名z));
                                如果 (引返回码z == T_未知 || 引返回码z == T_空类型) {
                                    引返回码z = T_整64;
                                }
                                IR追加(指令, 建IR指令(IR_指针加载, 目标寄存器, 0, 0,
                                                     解引用regz, 引返回码z, 0));
                                登记寄存器类型(解引用regz, 引返回码z);
                                目标寄存器 = 解引用regz;
                            }
                        }
                        整64 压栈reg = 目标寄存器;
                        // 81-a-v2（甲案）：容器方法返回**真结构体** → 同理物化到独立槽
                        如果 (签.返回形态 == 容器返回_结构体) {
                            整64 方法返回结构ID = 驻留(签.返回文本);
                            如果 (查结构体大小(方法返回结构ID) != 0) {
                                整64 物化regm = 物化返回值到独立槽(指令, 寄存器计数, 槽计数,
                                                                  目标寄存器, 方法返回结构ID);
                                如果 (物化regm != 0) {
                                    压栈reg = 物化regm;
                                    // 1013 批八（79_v2 根治·〔基准=019〕第一句「值语义深拷
                                    //   天然无别名」）：容器方法返回**含资源字段结构体**的物化
                                    //   在位拷后原地逐资源字段深拷（读壳内共享句柄→NewObject+
                                    //   拷贝构造→写回槽）＝物化临时独立拥有——调用后 975 实参
                                    //   清理（发射串字段释放顺序→IR_删除对象）释放独立副本。原
                                    //   浅壳与容器元素共享底层（元素() 读侧借用·容器拥有），
                                    //   清理释放共享句柄=**毁源**（t1 复现：op62 delete 容器元素
                                    //   v 对象；79_v2 fix_s 数据段 2 定义/1347 EXTERN·发射循环
                                    //   2484 次毁尽全树函数 IR）。仅挂本调用点（容器方法返回）：
                                    //   普通函数返回（物化结构体返回值 路径）由 85-a 返回侧深拷
                                    //   管辖，此处再深拷=双重深拷（230/234/236/240/242/243/244
                                    //   校验位面回归实录）。原地（目标=源=物化槽基址）读写同槽
                                    //   时序安全。上游缺口（立后续专项）：是容器类 对尖括号形态
                                    //   （"向量<整64>"）判假→语法层资源字段登记 miss→85-a 在容器
                                    //   方法体（泛型 T）失效——登记链根治后本补丁可回收。
                                    如果 (资源字段数(方法返回结构ID) > 0) {
                                        发射串字段深拷(指令, 寄存器计数, 物化regm, 物化regm,
                                                        方法返回结构ID, 0);
                                    }
                                }
                                // 650-a 波 A〔基准=019〕：容器实例返回→物化后追加**拷贝构造**
                                //   （深拷·无别名值语义=019 安全区默认）——原 sret 物化=元素槽
                                //   浅拷字节→接收方 设置 扩容 realloc·原元素字段悬垂
                                //   （643 语义级互斥）→深拷后接收方独立·扩容自洽。
                                如果 (是容器类(签.返回文本)) {
                                    整64 拷贝串IDm = 查类拷贝构造串(方法返回结构ID);
                                    如果 (拷贝串IDm != 0) {
                                        整64 新objm = 寄存器计数[0];
                                        寄存器计数[0] = 寄存器计数[0] + 1;
                                        IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新objm,
                                             查结构体大小(方法返回结构ID), 方法返回结构ID));
                                        IR追加(指令, 建IR指令(IR_调用实参, 新objm, 0, 0, 0, 0, 0));
                                        // 698-a 修复〔基准=019〕：拷贝构造源实参=T& 句柄槽
                                        //   （槽首 8B=壳指针）——原传 物化regm（物化壳地址本身）
                                        //   =被调方 [源] 再解一层拿到壳首 8B（字段0 值）当壳用
                                        //   →空映射 桶数量=0→READ [0+0x20] 段错误（113 注册/
                                        //   查找/弹出 三链同崩·宿主拷贝构造 asm 权威对照：
                                        //   src=句柄两跳 [源槽]→壳）。装配：句柄槽 ← 壳地址，
                                        //   源=&句柄槽（对照 生成容器拷贝构造 非引用分支
                                        //   IR_取地址(源槽) 同款契约）。
                                        整64 源句柄槽m = 槽计数[0];
                                        槽计数[0] = 槽计数[0] + 1;
                                        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 源句柄槽m));
                                        IR追加(指令, 建IR指令(IR_存储, 物化regm, 0, 0, 0, 0, 源句柄槽m));
                                        整64 源地址regm = 寄存器计数[0];
                                        寄存器计数[0] = 寄存器计数[0] + 1;
                                        IR追加(指令, 建IR指令(IR_取地址, 源句柄槽m, 0, 0, 源地址regm, T_整64, 0));
                                        IR追加(指令, 建IR指令(IR_调用实参, 源地址regm, 0, 0, 0, 1, 0));
                                        IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                                             驻留(方法符号(签.返回文本,
                                                   剥实例基名(签.返回文本),
                                                   字符串复制(驻留文本(拷贝串IDm))))));
                                        物化regm = 新objm;
                                        压栈reg = 新objm;
                                    }
                                }
                            }
                        }
                        结果<空类型, 整32> 加法 = 表达式栈.追加(压栈reg);
                        如果 (!加法.正常) { 运行时错误(4); }
                    }
                    返回;
                }
                IR层诊断("容器方法未收录: " + 类名 + "." + 方法名文本);
                运行时错误(6);
            }
            // 第七十八轮（2026-09-12）：用户类方法调用——this 位0 + 实参位1..，
            //   符号=类$方法[#参数串]（方法表来自 IR类 类表——语义层声明收集登记）
            如果 (是用户类(类名)) {
                // 328：父类限定判定（对象位=「父类」·方法体上下文）→发射侧虚槽
                //   强制静态（C++ Base::method 非虚分派·判定本体在 生成类.cn）
                发射用户类方法调用(类名, 方法名文本, this寄存器, 弹出们, 实参数, 指令, 寄存器计数, 槽计数, 表达式栈, retbuf序号, 父类限定判定328(池, n));
                返回;
            }
            // 466-a（T70 面⑥·模块根成员内置直调）：stdlib 源码级模块内部实现
            //   调内置成员（IO.cn 行 44 `IO.打印到错误(消息)`——根=内置模块名·
            //   sem5 已放行模块名根）→ 改写 模块::方法 限定内置直调（内置表
            //   同表命中·宿主「内置走限定名直调」同语义；生产态 stdlib 源码
            //   不编译=零触发）。this 已弹弃置（内置无 this 位）。
            字符串 根名466 = 类名;
            如果 (字符串长度(根名466) == 0 && 位置 >= 1) {
                // 对象类型解析 miss（根=内置模块名不在容器/类表）——自调用节点
                //   前邻回溯成员节点取链根（池布局=[根,成员,实参...,调用]·
                //   方法调用节点在实参之后·探针 32938~32942 实证）
                整64 找b = 位置 - 1;
                当 (找b >= 0 && 找b >= 位置 - 4) {
                    节点 成员n466 = 池.元素(整32(找b));
                    如果 (成员n466.类型 == 节点_成员 && 成员n466.子起点 > 0) {
                        节点 根n466 = 池.元素(整32(成员n466.子起点));
                        根名466 = 字符串复制(驻留文本(整64(根n466.文本)));
                        中断;
                    }
                    找b--;
                }
            }
            如果 (是标准库模块名(根名466)) {
                字符串 限定名466 = 根名466 + "::" + 方法名文本;
                如果 (字符串长度(内置函数符号(限定名466)) != 0) {
                    生成打印与内置调用(池, 驻留(限定名466), 弹出们, 实参数,
                                       指令, 寄存器计数, 表达式栈);
                    返回;
                }
            }
}

// 打印族（逐参类型分派 __cn_print_*+换行）与内置函数（__cn_ 直调）。
//   返回 1=本形态已处理（消费 1 个位置）；0=非此两族（调用方继续分派）。
// 862（任务 215）：单参发射辅助自打印段循环体机械提取——862 批式/流式两路径
//   共用单一事实源（提取为逐字节等价变换：类型分派/浮32提升/IR 形态零变化）。
函数 发射单参打印(整64 打参, 向量<IR指令>& 指令, 整64* 寄存器计数) -> 空类型 {
    // ③ 缺陷①根治：类型登记表分派（字符串变量/字面量 str、浮点 float、
    //   布尔 bool（输出 真/假）、未登记/整数 int）
    整64 打参码 = 查寄存器类型(打参);
    // 91-a：浮32 实参 -> 浮64 提升（runtime __cn_print_float(double)
    //   按 SysV 双精度读 xmm0；宿主 ir_call f32 实参提升同款）
    如果 (打参码 == T_浮32) {
        打参 = 插入值转换(打参, T_浮64, 指令, 寄存器计数);
        打参码 = T_浮64;
    }
    字符串 打印符号 = "__cn_print_int";
    如果 (打参码 == T_字符串) {
        打印符号 = "__cn_print_str";
    } 否则 如果 (打参码 == T_浮32 || 打参码 == T_浮64) {
        打印符号 = "__cn_print_float";
    } 否则 如果 (打参码 == T_布尔) {
        打印符号 = "__cn_print_bool";
    // 810 轮（053）：128 位打印——寄存器值=16 字节槽地址（值=地址
    //   语义·静态/局部/形参/返回接收统一），传址调运行时打印。替换
    //   波H「查地址128标记」按寄存器号的泄漏形态（类型即生命周期）。
    } 否则 如果 (打参码 == T_正64) { 打印符号 = "__cn_print_uint"; } 否则 如果 (打参码 == T_整128) {
        打印符号 = "__cn_print_i128";
    } 否则 如果 (打参码 == T_正128) {
        打印符号 = "__cn_print_u128";
    }
    IR追加(指令, 建IR指令(IR_调用实参, 打参, 打参码, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0, 驻留(打印符号)));
}

不安全 函数 生成打印与内置调用(向量<节点> 池, 整64 函数符号, 向量<整64>& 弹出们, 整64 实参数,
                       向量<IR指令>& 指令, 整64* 寄存器计数, 向量<整64>& 表达式栈) -> 整32 {
        // ---- ③ 第一波：打印/打印行（复合内置，宿主 ir_call 对齐语义）——逐参按
        //      类型独立调用 __cn_print_str（字符串寄存器集合判定）/__cn_print_int，
        //      打印 尾随 __cn_print_newline（打印行 不加）；void 不压栈。
        //      注意 函数符号 恒为正（标识符兜底压栈 0-ID，此处再取反还原）；
        //      限定名内置（IO::/文件::）经语法层合成限定标识符走本路径。
        // 828-a：打印族判定用归一基名（IO::打印 → 打印·打印族=纯名复合内置面）；
        //   通用内置查询用**原名**直查（内置函数符号 自带两级兜底——IO::读取行
        //   等限定注册名直查命中；若误用归一名则破坏限定注册面）
        字符串 内置原名 = 字符串复制(驻留文本(函数符号));
        // 954（红灯治理·27 族真修·入口拦截）：限定名内置（数学::平方根 等）
        //   本地模块定义同名函数时**用户优先**（宿主 27 实证=调用户函数返回
        //   入参 16；修前内置 __cn_sqrt 抢占得 4）——查签名表 模块$名 命中
        //   则返回 0（不按内置处理→决议走用户函数通道）；打印族豁免（纯名
        //   复合内置无本地同名语义）；本地 miss 才走内置（v2 自举 IO:: 族）
        字符串 护模954 = "";
        字符串 护符954 = "";
        如果 (拆限定名(内置原名, 护模954, 护符954) == 1) {
            如果 (是用户模块名954(护模954) &&
                 查函数签名个数(键基合成(护模954, 驻留(护符954))) > 0) {
                返回 0;
            }
        }
        字符串 打印名 = 内置归一基名(内置原名);
        布尔 是打印换行 = 字符串比较(打印名, "打印");
        如果 (是打印换行 || 字符串比较(打印名, "打印行")) {
            // 弹出们 为倒序弹（栈顶=右参先弹）——正序打印：从尾向头遍历
            // 862（任务 215）：逐参发射提炼为 发射单参打印（与流式分派共用单一
            //   事实源——类型分派/浮32提升/IR 形态零变化）
            整64 打i = 弹出们.大小();
            当 (打i > 0) {
                发射单参打印(弹出们.元素(打i - 1), 指令, 寄存器计数);
                打i--;
            }
            如果 (是打印换行) {
                IR追加(指令, 建IR指令(IR_调用参数化, 0, 0, 0, 0, 0,
                                     驻留("__cn_print_newline")));
            }
            返回 1;
        }
        // ---- ③ 第一波：内置函数（驻留/字符串族/运行时错误）——裸 ASCII 运行时
        //      符号直调（宿主 ABI 权威：v2p_linux.s 实查 bl __cn_intern）；
        //      代码生成 __cn_ 前缀直通不修饰。返回标量/指针单槽。
        //      ③ 第五波：限定名内置（IO::/文件::）同表命中——语法层 :: 已合成
        //      限定标识符，此处与纯名内置统一走本路径。
        字符串 内置符号名 = 内置函数符号(内置原名);
        如果 (字符串长度(内置符号名) != 0) {
            整64 返回寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            // 91-a：返回类型码先算（IR_调用参数化.操作数2——浮点返回走 xmm0）；
            //   实参类型码按实参表达式登记类型（内置表无参数类型信息）
            整64 内置返回码 = 类型码(内置函数返回类型ID(内置原名));   // 828-a：原名（自带兜底）——浮点返回码须正确（xmm0 装载）
            // 91-a：浮32 实参 -> 浮64 提升（内置浮点 runtime 函数形参全为 double）
            整64 提升i = 0;
            当 (提升i < 弹出们.大小()) {
                如果 (查寄存器类型(弹出们.元素(提升i)) == T_浮32) {
                    整64 升reg = 插入值转换(弹出们.元素(提升i), T_浮64,
                                             指令, 寄存器计数);
                    结果<空类型, 整32> 设升 = 弹出们.设置(提升i, 升reg);
                    如果 (!设升.正常) { 运行时错误(4); }
                }
                提升i++;
            }
            发射调用实参们(弹出们, 0, 指令, 实参类型码们(弹出们));
            IR追加(指令, 建IR指令(IR_调用参数化, 实参数, 内置返回码, 0, 返回寄存器, 0,
                                 驻留(内置符号名)));
            // 返回类型登记（字符串/布尔/整64——打印分派与拼接判定消费；
            //   空类型跳过=void 无值语义，对齐用户函数 T_空类型 同款）
            如果 (内置返回码 != T_未知 && 内置返回码 != T_空类型) {
                登记寄存器类型(返回寄存器, 内置返回码);
            }
            结果<空类型, 整32> 加内 = 表达式栈.追加(返回寄存器);
            如果 (!加内.正常) { 运行时错误(4); }
            返回 1;
        }
    返回 0;
}

// 类型转换 类型(expr)（灰色点④窄宽特判）与容器构造调用（合成名无实参）。
//   返回 1=已处理；0=继续分派。
不安全 函数 生成转换或构造调用(整64 函数符号, 向量<整64>& 弹出们, 整64 实参数,
                       向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数,
                       向量<整64>& 表达式栈) -> 整32 {
        // ---- 类型转换 类型(expr)（被调符号是类型名且单实参）——不走调用 ----
        整64 目标类型 = 类型码(函数符号);
        // 灰色点④根治（2026-09-04）：窄宽强转目标码特判——类型码() 将
        //   整8/整16 归 T_整64（v2 槽模型 8 字节、正8 无符号语义缺位），
        //   但强转须按目标宽度截断（win mov al/movsx、ARM64 sxtb/sxth），
        //   此处改码为窄宽标注；其余类型走 类型码() 原路径零变化
        字符串 强转名 = 字符串复制(驻留文本(函数符号));
        如果 (字符串比较(强转名, "整8")) {
            目标类型 = T_整8;
        } 否则 如果 (字符串比较(强转名, "整16")) {
            目标类型 = T_整16;
        } 否则 如果 (字符串比较(强转名, "正8")) {
            // 2026-09-04 缺陷零容忍收口：无符号窄宽（零扩展 movzx/uxtb——
            //   正8(200)=200；与 整8 符号扩展对称）
            目标类型 = T_正8;
        } 否则 如果 (字符串比较(强转名, "正16")) {
            目标类型 = T_正16;
        }
        如果 (目标类型 != T_未知 && 实参数 == 1) {
            // 810（053）：128 位转换分派（先于通用路径）——
            //   ·128→128 恒等（值=句柄直通·登记产物）
            //   ·128→64/窄宽/整32：双半装载低半（句柄地址 [0]·截断由目标发射
            //     层既有路径承接）——420-② 取低(999999) 垃圾实证（句柄直转）
            //   ·64/窄宽→128：物化 2 槽（符号性分派）传句柄
            整64 源码c128 = 查寄存器类型(弹出们.元素(0));
            如果 (源码c128 == T_整128 || 源码c128 == T_正128) {
                如果 (目标类型 == T_整128 || 目标类型 == T_正128) {
                    结果<空类型, 整32> 加恒128 = 表达式栈.追加(弹出们.元素(0));
                    如果 (!加恒128.正常) { 运行时错误(4); }
                    返回 1;
                }
                整64 低半c128 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_指针加载, 弹出们.元素(0), 0, 0,
                                     低半c128, T_整64, 0));
                结果<空类型, 整32> 设c128 = 弹出们.设置(0, 低半c128);
                如果 (!设c128.正常) { 运行时错误(4); }
            } 否则 如果 (目标类型 == T_整128 || 目标类型 == T_正128) {
                整64 句柄c128 = 物化128位操作数(弹出们.元素(0), 源码c128,
                    源码c128 == T_正32 || 源码c128 == T_正64 ? 0 : 1,
                    指令, 寄存器计数, 槽计数);
                结果<空类型, 整32> 设物c128 = 弹出们.设置(0, 句柄c128);
                如果 (!设物c128.正常) { 运行时错误(4); }
                结果<空类型, 整32> 加物c128 = 表达式栈.追加(句柄c128);
                如果 (!加物c128.正常) { 运行时错误(4); }
                返回 1;
            }
            整64 转换寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            // 方案甲（2026-09-10 第五十一轮 用户裁决，Rust as 语义对齐）：发射层
            //   读取扩展方式须按源操作数符号性选择（原只看目标码——正32→整64 落
            //   movsxd 符号扩展兜底 4000000000 出负、正64→整64 低32截断 2^63 出 0，
            //   宿主 emitCast 按源分派双侧分叉=193_v2 立案）。目标 64 位码时按
            //   源寄存器登记类型改标指令类型字段（发射层按该字段选读法）：源
            //   正32→T_正32（零扩展读，值保序）；源 整64/正64→T_正64（64 位直拷
            //   =同宽位模式重解释）；源 整32/未登记→维持目标码（movsxd 既有兜底）。
            //   原目标码另存供产物登记（改标仅编码发射读法，不改转换目标语义）。
            //   正8/正16 源（2026-09-10 第五十五轮标注）：经 类型码() 归一登记
            //   T_整64（窄宽无独立码）→同落 T_正64 64 位直拷——正确性=正8/正16
            //   槽是 64 位槽且全部写入路径（字面量装载/标识符拷贝/字段读回零扩展）
            //   保证高位干净，直拷=零扩展语义；结构体字段层经 类型宽度码()
            //   T_整8/T_整16 窄宽读回（1/2 字节+movzx）独立正确。E2E 194 双侧锚定
            //   （变量显式转换 rc=31/字段+指针解引用 rc=15，宿主 movzx 对称）。
            整64 原目标码 = 目标类型;
            整64 源登记码t = 查寄存器类型(弹出们.元素(0));
            如果 (目标类型 == T_整64 || 目标类型 == T_正64) {
                如果 (源登记码t == T_正32) {
                    目标类型 = T_正32;
                } 否则 如果 (源登记码t == T_整64 || 源登记码t == T_正64) {
                    目标类型 = T_正64;
                }
            }
            // 91-a（2026-09-13 第九十一轮）：操作数2 = 源类型码——发射层按
            //   (源码, 目标码) 组合分派浮点转换（整->浮 cvtsi2sd/scvtf、浮->整
            //   cvttsd2si/fcvtzs 截断、浮32<->浮64 cvtss2sd/cvtsd2ss/fcvt）；
            //   源码 0（未登记）按整型兜底（原整数路径行为零变化）。
            IR追加(指令, 建IR指令(IR_类型转换, 弹出们.元素(0), 源登记码t, 0, 转换寄存器, 目标类型, 函数符号));
            // 方案甲顺带（发射方向对齐宿主）：转换产物登记目标类型码——原未登记
            //   查 0 兜底 T_整64，正32(x) 产物参与二元时无符号性在发射点丢失
            登记寄存器类型(转换寄存器, 原目标码);
            结果<空类型, 整32> 加转 = 表达式栈.追加(转换寄存器);
            如果 (!加转.正常) { 运行时错误(4); }
            返回 1;
        }
        // ---- 第七十八轮（2026-09-12）：用户类构造调用（被调符号=类名ID）——
        //      分配对象 + this 位0 + 实参位1.. + 类$类名[#参数串]；对象指针压栈。
        //      判定先于容器分支（类名与容器合成名无交集——防御性顺序）
        字符串 被调名u = 字符串复制(驻留文本(函数符号));
        // 276-a（D28 根治·2026-09-17）：导入类裸名经解析期 B1 改写为「模块::类」
        //   限定形态，用户类登记为裸名——直接查表不命中→落普通调用=链接期
        //   undefined（随机数生成器 冒烟实锤）。拆基名后同判构造分派：
        //   发射符号=类$类名 与定义侧一致（plans/021 §3-D D28）。
        如果 (!是用户类(被调名u)) {
            字符串 限定模块 = "";
            字符串 限定符号 = "";
            如果 (拆限定名(被调名u, 限定模块, 限定符号) == 1 &&
                 是用户类(限定符号)) {
                被调名u = 限定符号;
            }
        }
        如果 (是用户类(被调名u)) {
            发射用户类构造(被调名u, 弹出们, 实参数, 指令, 寄存器计数, 槽计数,
                          表达式栈);
            返回 1;
        }
        // ---- 构造调用：被调符号是容器类合成名（向量$整64）且无实参 ----
        字符串 被调名 = 字符串复制(驻留文本(函数符号));
        如果 (是容器类(被调名) && 实参数 == 0) {
            整64 obj寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, obj寄存器,
                                 容器对象大小(被调名), 函数符号));
            IR追加(指令, 建IR指令(IR_调用实参, obj寄存器, 0, 0, 0, 0, 0));
            IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                 驻留(构造符号(被调名))));
            结果<空类型, 整32> 加构 = 表达式栈.追加(obj寄存器);
            如果 (!加构.正常) { 运行时错误(4); }
            返回 1;
        }
    返回 0;
}

