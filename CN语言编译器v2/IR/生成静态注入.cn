// CN 自举编译器 v2 · 生成静态注入（728c 拆分子模块·自 生成函数.cn 机械搬移·单一职责）
// 职责：入口函数（主）静态初始化注入——顶层静态/裸全局槽的运行期初始化 IR 发射。
//   728c（2026-10-14）：新增 结果/可选 静态合成体专用分支——指针槽模型（t7/t11
//   探针矩阵实证：无初值槽 0=空句柄·首成员访问判空 runtime_error(3)·宿主
//   .data 内联零值 rc=7 绿=双侧分叉）；带初值=求值+句柄直存（原通道行为逐字
//   等价·537-C 锁面不动）。
// 拆分缘由：生成函数.cn 1000 行触硬红线·先拆再加（AGENTS 纪律三）。
导入 容器::向量;
导入 映射集合;
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 IR生成;     // 静态表（取静态数/取静态类型/取静态初值*）同包
导入 生成表达式; // 表达式后缀求值（同包）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 入口函数（主）静态初始化注入（R3 拆分；87-a 扩展结构体面）：
//   ① 容器/类静态：NewObject+构造+IR_静态存储 存指针进 .data 槽（P3-8 指针槽）；
//   ② 标量静态：初始值已在 .data 直存，跳过（零运行期开销）；
//   ③ 87-a（2026-09-12 第八十七轮）结构体静态：有初值区间 → 生成表达式物化
//      （结构体字面量=临时槽逐字段构造/字段串归一化；表达式=求值）→ 目标
//      = .data 符号地址（IR_静态地址）+ 整体拷贝（深拷=真：源为栈临时，
//      字段串独立落堆；先释放=假：首次初始化 .data 槽零值无旧句柄）。
//      无初值 → 跳过（.data 零 = 结构体零值，语义正确）。
不安全 函数 注入主函数静态初始化(向量<节点> 池, 函数IR& 函数信息, 整64* 寄存器计数,
                        整64* 槽计数, 向量<整64>& 表达式栈) -> 空类型 {
    整64 s序 = 0;
    当 (s序 < 取静态数()) {
        // 852：函数内静态守卫面（守卫标记=1）不进主函数入口注入——其初值
        //   已由声明所在函数的语句流守卫块承担（生成静态声明守卫852）。
        //   原路径在主函数上下文求值初值：引用同函数局部名=查无此名→按
        //   未知名发射 _名 全局符号=链接失败（1006-D3 实录）。
        可选<整64> 守卫标记s = 取静态守卫标记(s序);
        如果 (守卫标记s.有值 && 守卫标记s.值 == 1) {
            s序++;
            继续;
        }
        整64 静态类型ID = 取静态类型(s序);
        字符串 静态类型文本 = 字符串复制(驻留文本(静态类型ID));
        如果 (是容器类(静态类型文本)) {
            整64 obj寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_分配对象, 0, 0, 0, obj寄存器,
                                                 容器对象大小(静态类型文本), 静态类型ID));
            IR追加(函数信息.指令, 建IR指令(IR_调用实参, obj寄存器, 0, 0, 0, 0, 0));
            IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                                 驻留(构造符号(静态类型文本))));
            IR追加(函数信息.指令, 建IR指令(IR_静态存储, obj寄存器, 0, 0, 0, 0, s序));
        } 否则 如果 (是结果类型(静态类型文本)) {
            // 728c（2026-10-14·t7/t11 探针矩阵实证）：静态合成体（结果/可选）
            //   专用分支——v2 合成体静态=**指针槽**（890-a 访问面：槽内容即对象
            //   基址·t10/537-C 带初值绿面同模型）。原无初值落空：槽 0=空句柄，
            //   首成员访问判空 runtime_error(3)（宿主 .data 内联零值语义 rc=7
            //   绿=双侧分叉）。有初值=生成表达式求值 + IR_静态存储（直存·与原
            //   通道有初值行为逐字节等价·537-C 锁面不动）；无初值=零值对象注入
            //   （**与 989 同构**·IR_分配对象 calloc 壳不计数零泄漏）→ 堆全零
            //   对象 → .正常=[句柄+0]=0=假·与宿主 .data 内联零值语义一致。
            可选<整64> 初值起r = 取静态初值起点(s序);
            可选<整64> 初值止r = 取静态初值终点(s序);
            布尔 有区间r = 假;
            如果 (初值起r.有值) {
                如果 (初值止r.有值) {
                    如果 (初值止r.值 > 初值起r.值) {
                        有区间r = 真;
                生成表达式(池, 整32(初值起r.值), 整32(初值止r.值), 函数信息.局部槽,
                          函数信息.参数槽, 函数信息.指令, 寄存器计数,
                          &函数信息.块计数, 槽计数, 表达式栈);
                如果 (表达式栈.大小() > 0) {
                    整64 句柄r = 表达式栈.元素(表达式栈.大小() - 1);
                    结果<空类型, 整32> 删r = 表达式栈.删除(表达式栈.大小() - 1);
                    如果 (!删r.正常) { 运行时错误(4); }
                    IR追加(函数信息.指令, 建IR指令(IR_静态存储, 句柄r, 0, 0, 0,
                                                         0, s序));
                }
                    }
                }
            }
            如果 (!有区间r) {
                整64 obj寄存器r = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(函数信息.指令, 建IR指令(IR_分配对象, 0, 0, 0, obj寄存器r,
                                                     结果大小(静态类型文本), 静态类型ID));
                IR追加(函数信息.指令, 建IR指令(IR_静态存储, obj寄存器r, 0, 0, 0,
                                                     0, s序));
            }
        } 否则 如果 (是用户类(静态类型文本)) {
            // 972（008 总攻·深水一根治）：**用户类静态=指针槽**（与容器①同构）
            //   ——初值表达式求值得对象句柄 → IR_静态存储 写槽（句柄移交=所有
            //   权移交；对象内部字段已由构造器归一化，无字段级深拷义务）。
            //   原落入下方②结构体通道（类布局 查结构体大小>0 先命中）：
            //   IR_结构体拷贝 8B（[槽]=句柄——指针槽下「恰好」对）+ 发射串字段
            //   深拷 把「槽地址+0=槽本身」当目标字段位（目标基址=IR_静态地址
            //   =槽地址·类字段须 [槽内容句柄+偏移]）→ __cn_str_copy 副本指针
            //   **覆盖槽**（m574e 崩因本体：print_str rdi=「静旧」UTF-8 内容
            //   字节=[串缓冲+0]·asm op=45 写槽/op=61 拷句柄双段铁证）。
            //   无初值 → 跳过（槽 0=空句柄·读取判空 错误码3 确定性失败·与
            //   ②结构体通道无初值同构）。
            可选<整64> 初值起u = 取静态初值起点(s序);
            可选<整64> 初值止u = 取静态初值终点(s序);
                布尔 有初值u989 = 假;
                整64 起值u989 = 0;
                整64 止值u989 = 0;
                如果 (初值起u.有值) {
                    如果 (初值止u.有值) {
                        如果 (初值止u.值 > 初值起u.值) {
                            有初值u989 = 真;
                            起值u989 = 初值起u.值;
                            止值u989 = 初值止u.值;
                        }
                    }
                }
                如果 (有初值u989) {
                    生成表达式(池, 整32(起值u989), 整32(止值u989), 函数信息.局部槽,
                              函数信息.参数槽, 函数信息.指令, 寄存器计数,
                              &函数信息.块计数, 槽计数, 表达式栈);
                    如果 (表达式栈.大小() > 0) {
                        整64 句柄u = 表达式栈.元素(表达式栈.大小() - 1);
                        结果<空类型, 整32> 删u = 表达式栈.删除(表达式栈.大小() - 1);
                        如果 (!删u.正常) { 运行时错误(4); }
                        IR追加(函数信息.指令, 建IR指令(IR_静态存储, 句柄u, 0, 0, 0,
                                                             0, s序));
                    }
                }
                如果 (!有初值u989) {
                    // 989 零值对象注入（定性反转·对齐宿主 LazyLock 两步·921 扩展
                    //   无参构造调用）——独立如果形态（嵌套 否则 链的 fix_p 自身
                    //   编译异常绕行·172/111 同域观察项）
                    注入用户类静态零值(静态类型ID, 静态类型文本, s序, 函数信息, 寄存器计数);
                }
        } 否则 如果 (查结构体大小(静态类型ID) > 0) {
            // 87-a：结构体静态初值注入
            //   1009（云端红治理）：989 零值注入轮编辑事故残留过一个条件全同的
            //   空分支截胡本分支——结构体静态（静态 盒 甲 等）初值注入永不可达
            //   →全零槽（246 ②⑦ 失败根因·E2E 246/236 族）；残行已删。
            可选<整64> 初值起i = 取静态初值起点(s序);
            可选<整64> 初值止i = 取静态初值终点(s序);
            如果 (初值起i.有值) {
                如果 (初值止i.有值) {
                    如果 (初值止i.值 > 初值起i.值) {
                生成表达式(池, 整32(初值起i.值), 整32(初值止i.值), 函数信息.局部槽,
                          函数信息.参数槽, 函数信息.指令, 寄存器计数,
                          &函数信息.块计数, 槽计数, 表达式栈);
                整64 源地址i = 0;
                如果 (表达式栈.大小() > 0) {
                    源地址i = 表达式栈.元素(表达式栈.大小() - 1);
                    结果<空类型, 整32> 删源i = 表达式栈.删除(表达式栈.大小() - 1);
                    如果 (!删源i.正常) { 运行时错误(4); }
                }
                整64 目标地址i = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(函数信息.指令, 建IR指令(IR_静态地址, 0, 0, 0, 目标地址i,
                                                     T_整64, s序));
                发射结构体整体拷贝(函数信息, 寄存器计数, 目标地址i, 源地址i,
                                  静态类型ID, 真, 假);
                    }
                }
            }
        } 否则 如果 (取静态需注入(s序)) {
            // 87-a（2026-09-12 第八十七轮）：初值物化注入（8 字节值语义）——
            //   覆盖 ①字符串（字面量=驻留常量地址零分配；表达式=求值）；
            //   ②折叠失败的标量（布尔/浮点/字符字面量——折叠常量值 只认整数
            //   文本，原实现静默落 .data 0=初值丢失：探针实证 布尔=假/浮=0）。
            //   .data 槽保持 0，入口求值后 IR_静态存储 写回。
            可选<整64> 初值起s = 取静态初值起点(s序);
            可选<整64> 初值止s = 取静态初值终点(s序);
            如果 (初值起s.有值) {
                如果 (初值止s.有值) {
                    如果 (初值止s.值 > 初值起s.值) {
                生成表达式(池, 整32(初值起s.值), 整32(初值止s.值), 函数信息.局部槽,
                          函数信息.参数槽, 函数信息.指令, 寄存器计数,
                          &函数信息.块计数, 槽计数, 表达式栈);
                整64 串值reg = 0;
                布尔 串有值 = 假;
                如果 (表达式栈.大小() > 0) {
                    串值reg = 表达式栈.元素(表达式栈.大小() - 1);
                    串有值 = 真;
                    结果<空类型, 整32> 删串s = 表达式栈.删除(表达式栈.大小() - 1);
                    如果 (!删串s.正常) { 运行时错误(4); }
                }
                如果 (串有值) {
                    // 040（001 §5.8 甲案）：静态初值函数名收口——`静态 整32(*f)(整32) = 加一;`
                    //   初值=函数名（负占位）→ IR_函数地址（生成语句赋值 :151 同款·
                    //   原缺=负占位 -26 直存 IR_静态存储·992 守卫中止实证）
                    串值reg = 值位函数名收口480(串值reg, 函数信息.指令, 寄存器计数);
                    // 919（超承载字面量参与表达式·静态初值求值链收口）/1073 复核：
                    //   静态槽按声明类型宽度物化——原恒 IR_静态存储(T_字符串·8 字节)：
                    //   ①≤64 位槽收 128 值（超承载字面量表达式经 638 甲案提升链
                    //   物化为地址句柄）→ 句柄地址直存槽＝地址碎片（探针实录：
                    //   `静态 整64 甲 = 99999999999999999999 + 变;` 输出每次不同
                    //   的栈地址，应 7766279631452241920=低 64 位截断；1073 复核
                    //   `20位+变` 同形态）；②128 槽收 128 值 → 半槽写只落低 8 字节
                    //   （`静态 整128 甲 = 超承载表达式` 打印丢高半；1073 复核
                    //   `静态 整128 甲 = 20位+1`）。修法=与赋值/声明/返回/实参四
                    //   挂点同设施：≤64 槽 隐式窄化到64（低半·宿主 emitCast 隐式
                    //   截断同款）；128 槽 静态地址+结构体拷贝 16 字节（生成语句
                    //   赋值 静态 128 分支同构——64 值源先拆半物化符号扩展）。
                    字符串 静型919 = 字符串复制(驻留文本(静态类型ID));
                    布尔 静槽128位919 = 字符串比较(静型919, "整128") ||
                                        字符串比较(静型919, "正128");
                    如果 (静槽128位919) {
                        // 1360 批5：未登记=类型未知（T_未知 兜底·既有业务语义：非 128 源）
                        整64 值码919 = 查寄存器类型或未知(串值reg);
                        如果 (值码919 != T_整128 && 值码919 != T_正128) {
                            串值reg = 物化128位操作数(串值reg, 值码919,
                                字符串比较(静型919, "整128") ? 1 : 0,
                                函数信息.指令, 寄存器计数, 槽计数);
                        }
                        整64 槽址919 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(函数信息.指令, 建IR指令(IR_静态地址, 0, 0, 0,
                                                          槽址919, T_整64, s序));
                        IR追加(函数信息.指令, 建IR指令(IR_结构体拷贝, 串值reg,
                                                          槽址919, 0, 0, 16, 0));
                    } 否则 如果 (!静槽128位919) {
                        串值reg = 隐式窄化到64(串值reg, 函数信息.指令, 寄存器计数);
                        IR追加(函数信息.指令, 建IR指令(IR_静态存储, 串值reg, 0, 0, 0,
                                                             T_字符串, s序));
                    }
                }
                    }
                }
            }
        }
        s序++;
    }
}

// 921（2026-10-17·629 矩阵 p629j0 实锤）：无初值用户类静态注入——分配零值
//   对象 + 无参构造调用（当类有显式 0 参构造）。宿主 ir_decl.cpp 顶层静态无
//   初值通道「NewObject + 无参构造（paramTypes.empty 命中则 Call）」同款；
//   与 生成类中.cn 生成类对象局部「无初始化：分配 + 无参构造」段同构（第 2
//   处·事不过三标记：第 3 处出现前提炼公共函数）。
//   缺陷实录：原 989 零值注入只分配对象不调构造——构造体初始化的字段（容器
//   字段句柄等）留 0 → 字段链调用空指针（错误码 3：静态 货架 全局架·
//   全局架.记录.追加 实证；宿主正常=构造调用把 记录 初始化为有效向量句柄）。
//   查类构造参数串(静态类型ID, 0)!=0 = 显式 0 参构造登记命中（带参/带默认
//   参数/拷贝构造 miss → 不调构造，对齐宿主 paramTypes.empty 判定）。
不安全 函数 注入用户类静态零值(整64 静态类型ID, 字符串 静态类型文本, 整64 静态序,
                           函数IR& 函数信息, 整64* 寄存器计数) -> 空类型 {
    整64 obj寄存器921 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(函数信息.指令, 建IR指令(IR_分配对象, 0, 0, 0, obj寄存器921,
                                         查结构体大小(静态类型ID), 静态类型ID));
    // 1541 B2：有值=显式 0 参构造登记命中（原 !=0 判据）
    可选<整64> 静态构造查921 = 查类构造参数串(静态类型ID, 0);
    如果 (静态构造查921.有值) {
        IR追加(函数信息.指令, 建IR指令(IR_调用实参, obj寄存器921, 0, 0, 0, 0, 0));
        // 416-a（D42 波 2）：构造方法名=基名（剥实例基名·非泛型类原文返回——
        //   泛型实例符号=实例$基名·与局部通道同款公式）
        IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                             驻留(方法符号(静态类型文本, 剥实例基名(静态类型文本), ""))));
    }
    IR追加(函数信息.指令, 建IR指令(IR_静态存储, obj寄存器921, 0, 0, 0,
                                         0, 静态序));
}


