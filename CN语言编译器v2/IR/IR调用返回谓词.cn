// IR调用返回谓词（先拆再加·自 IR生成类型辅助.cn 机械搬移 933 引用返回字符串
//   判定族——该文件 971 行触 900 警戒线·函数体逐字保留零行为变更）+ A2 方法
//   调用串拥有性三态谓词（宿主 semantic_call_member.cpp retOwnedString /
//   retBorrowedString 写回与 ir_stmt.cpp visitReturnStmt 返回位深拷消费同构）：
//   ① 拥有=用户类方法值返回「字符串」（方法返回位已保证独立堆串——接收位
//     拥有直存+RAII 释放安全）；
//   ② 借用=容器成员方法返回串（容器内部槽句柄·宿主 retBorrowedString 同口径）
//     与引用返回调用（933 既有面）——返回位须深拷落堆（直传=把借用句柄交给
//     按拥有结算的调用方，free 毁容器槽·859 JSON 文本() 实录乱码）；
//   ③ 其余形态（miss/静态方法/容器方法表外）=否定回答（形态判定出口·非失败
//     通道——调用方保守分流：不登记不释放=泄漏方向安全·禁反向=悬垂）。
// 依赖：查调用返回类型登记（IR调用返回登记·#1962 单一事实源）/登记内部未
//   登记（IR布局·648 收集表）/是容器类（IR容器判定）/解析方法对象类型扩展/
//   解析标识符类型ID（IR生成类型辅助）/查类方法定义层/查类方法返回（IR类）
//   ——经包内合并全局池解析。#1962 起 取调用返回文=纯查表（语义层登记面），
//   原两源 walk（查函数返回回退/解析方法对象类型扩展+查类方法返回）废除。
导入 容器::向量;
导入 IR;         // IR常量 键位移（目录包名）

公开:


// ==================== 933：引用返回字符串调用判定（值接收/赋值位/返回位
//   深拷落堆共用单点·任务 933 双侧零分叉） ====================
// 判定=调用节点被调者返回类型**尾 '&'**（引用返回）且剥 '&' 后=「字符串」。
//   来源分派：被调=标识符（自由函数，键基回退 查函数返回回退——72-a 跨模块
//   契约同款）；被调=成员（用户类方法，对象类型经 解析方法对象类型扩展 +
//   定义类 walk-up（279）后 查类方法返回）。
//   诚实边界（不静默面声明）：容器内置方法（元素引用 等——无池节点方法表，
//   签名表在语义层）与其他形态=返回假（不经本通道→保持既有污染/借用路径，
//   非静默默认值：判据语义=「是否触达 933 深拷面」的形态判定，miss=不适用
//   本通道，与 632/948 形态判定同族）；静态方法面（类名.静态方法）同理。
// #1885：**调用节点被调者返回类型文本**——#1962 执法三收口（十二条款八单一
//   实现）：原两源白名单 walk（标识符被调 查函数返回回退/成员被调 解析方法
//   对象类型扩展+定义类 walk-up 查类方法返回·与语义层三源互异=条款八违例面
//   ·不认容器内置方法/静态方法/链式对象=IR 侧 933/装箱 miss 悬垂伤害源）废
//   除，改查 调用返回类型登记 表（语义层 检查调用表达式并登记 收口登记的单
//   一事实源·主分派+1960 终态面全量覆盖）。933 与 是引用返回调用 共用取文
//   本单点（重复归纳·两谓词只差「尾 '&' 基类型限定」）。返回 假=形态不可判
//   （非调用形态/池索引越界）或登记查无（648：miss 不可静默——能进生成期的
//   调用节点必然经语义检查面登记，查无=内部不一致 → 登记内部未登记 显形
//   〔登记处出诊断行·主收尾统一中止〕，中止前占位返回假=消费点保守分流；
//   出参版本（字符串&）而非空串哨兵：#1239 哨兵禁令（空串与合法值域重叠）。
函数 取调用返回文(向量<节点> 池, 整32 调用索引, 字符串& 出) -> 布尔 {
    布尔 形态可判 = 调用索引 >= 0 && 调用索引 < 整32(池.大小());
    布尔 节点可判 = 假;
    如果 (形态可判) {
        节点 调用节点 = 池.元素(调用索引);
        节点可判 = 调用节点.类型 == 节点_调用 && 调用节点.子起点 >= 1 &&
                   调用节点.子起点 < 整64(池.大小());
        如果 (节点可判) {
            // #1962：单一事实源查表（语义层登记面·覆盖面=主分派+终态七源）
            可选<整64> 登记查返回 = 查调用返回类型登记(整64(调用索引));
            如果 (登记查返回.有值) {
                出 = 字符串复制(驻留文本(登记查返回.值));
                返回 真;
            }
            // 648：miss 不可静默——登记显形（收尾统一中止·不产 asm），中止前
            //   占位返回假（消费点按假保守分流=悬垂方向·不得据此续编产 asm）。
            //   形态名=被调文本（标识符/成员被调名·其余形态占位 <调用>）；行号
            //   =0（v2 节点池无行号字段·现场不可得哨兵·648 惯例）。
            节点 被调未登记 = 池.元素(整32(调用节点.子起点));
            字符串 形态名未登记 = "<调用>";
            如果 (被调未登记.类型 == 节点_标识符 || 被调未登记.类型 == 节点_成员) {
                形态名未登记 = 字符串复制(驻留文本(整64(被调未登记.文本)));
            }
            登记内部未登记("调用返回类型登记", 形态名未登记, 0);
        }
    }
    返回 假;
}

// 933：引用返回字符串调用判定（值接收/赋值位/返回位深拷落堆共用单点·
//   任务 933 双侧零分叉）——判定=调用节点被调者返回类型**尾 '&'**（引用
//   返回）且剥 '&' 后=「字符串」。取文本单点=取调用返回文。
函数 是引用返回字符串调用(向量<节点> 池, 整32 调用索引) -> 布尔 {
    字符串 返回文本 = "";
    布尔 有返回文 = 取调用返回文(池, 调用索引, 返回文本);
    布尔 命中串 = 假;
    如果 (有返回文 &&
        ((整64(返回文本[字符串长度(返回文本) - 1]) & 255) == 38)) {
        命中串 = 字符串比较(字符串子串(返回文本, 0,
                                       字符串长度(返回文本) - 1), "字符串");
    }
    返回 命中串;
}

// #1885：调用形态**引用返回**判定（任意基类型）——与 是引用返回字符串调用
//   同源判定（共用 调用返回文 取文本单点·重复归纳），只是不限定基类型。
//   消费点=装箱「实参=调用临时」判定（生成表达式装箱 类载荷）——引用返回调用=
//   被引用对象的**借用 place**（不是无主临时），禁按移交接管（宿主
//   builtinCtorArgIsRvalueTemp 的 !isRefReturnCall 同款排除面）。
//   内置函数（转移/复制/正常/某些 等无池方法表）与其余形态=假（非引用返回）。
//   纯谓词（真假语义判定·非失败通道·#1360 谓词免除结果化）。
函数 是引用返回调用(向量<节点> 池, 整32 调用索引) -> 布尔 {
    字符串 返回文本 = "";
    布尔 有文本 = 取调用返回文(池, 调用索引, 返回文本);
    布尔 是引用返回 = 假;
    如果 (有文本) {
        是引用返回 = ((整64(返回文本[字符串长度(返回文本) - 1]) & 255) == 38);
    }
    返回 是引用返回;
}

// ==================== A2 方法调用串拥有性三态（宿主 retOwnedString /
//   retBorrowedString 写回同构·预扫窗口与生成窗口共用判定核心） ====================
// 拥有契约判定（对象类型ID 注入版·两窗口对象类型解析源不同：预扫=预扫局部
//   类型序〔生成期函数变量类型表未建〕，生成=解析方法对象类型扩展）：
//   非容器对象（泛型容器成员返回串=容器槽借用句柄·宿主 retBorrowedString
//   同口径不入拥有面）且定义类 walk-up（279）后 查类方法返回=纯「字符串」
//   （登记原文含尾 '&' 的引用返回=比较不等=假·933 深拷通道管辖）=A2 拥有
//   契约（方法返回位已保证独立堆串·接收位拥有直存+RAII 释放安全）。
//   对象类型ID=0/无池方法表容器方法（签名表在语义层·查类方法返回 恒 miss）/
//   静态方法与形参对象等形态=假（诚实边界·否定回答=不适用本通道，非静默
//   默认值——调用方保持既有借用路径·与 取调用返回文 形态判定出口同族声明）。
//   纯谓词（真假语义判定·非失败通道·#1360 谓词免除结果化）。
函数 是拥有串方法契约(整64 对象类型ID, 整64 方法名ID) -> 布尔 {
    如果 (对象类型ID == 0) { 返回 假; }
    如果 (是容器类(驻留文本(对象类型ID))) { 返回 假; }
    整64 定义类w = 对象类型ID;
    可选<整64> 层查w = 查类方法定义层(对象类型ID, 方法名ID);
    如果 (层查w.有值) { 定义类w = 层查w.值; }
    可选<整64> 返查w = 查类方法返回(定义类w, 方法名ID);
    如果 (!返查w.有值) { 返回 假; }
    返回 字符串比较(驻留文本(返查w.值), "字符串");
}

// 容器借用串方法调用判定（返回位深拷判据·宿主 ir_stmt.cpp visitReturnStmt
//   retBorrowedString 消费同构·#1571 三态②）：被调=成员方法（附加=成员方法
//   标记）+对象=容器类+容器方法返回基名（剥尾 '&'·语义签名表单态化文本）=
//   「字符串」——结果=容器内部槽借用句柄（向量$字符串.元素 等），`-> 字符串`
//   返回位=拥有契约 → 须深拷落堆（直传=把借用句柄交给按拥有结算的调用方，
//   free 毁容器槽·859 JSON 文本() 实录乱码）。用户类方法不在本面（其返回
//   表达式经本文件 是拥有串方法契约 面=拥有直传，或 933 引用返回面=既有
//   深拷）。解析 miss/非容器对象=假（诚实边界·否定回答非静默默认值）。
//   纯谓词（真假语义判定·非失败通道·#1360 谓词免除结果化）。
函数 是容器借用串方法调用(向量<节点> 池, 整32 调用索引) -> 布尔 {
    布尔 形态c = 调用索引 >= 0 && 调用索引 < 整32(池.大小());
    布尔 命中c = 假;
    如果 (形态c) {
        节点 调用c = 池.元素(调用索引);
        布尔 节点可判c = 调用c.类型 == 节点_调用 && 调用c.子起点 > 0 &&
                        调用c.子起点 < 整64(池.大小());
        如果 (节点可判c) {
            节点 被调c = 池.元素(整32(调用c.子起点));
            如果 (被调c.类型 == 节点_成员 && 被调c.附加 == 成员方法标记) {
                // 对象位=实例变量形态守卫（类名.静态方法形态=对象位是类名标识符·
                //   不在函数变量类型表〔解析标识符类型ID 四级表 miss=0〕——内建
                //   静态返回串=A2 拥有契约（宿主 retOwnedString 面·字符串构建器::
                //   完成 出串归调用方）非容器槽借用句柄·误纳=返回位多深拷且原串
                //   无人释放（942 云端红实录·生成文本 返回位得=3 望=1 分叉）——
                //   与 方法调用串返回判定（生成表达式运算辅助·617 面）变量表守卫
                //   同口径；形参在 生成函数 prologue 已登记=实例形态过守卫）。
                节点 对象守卫c = 池.元素(整32(被调c.子起点));
                如果 (对象守卫c.类型 == 节点_标识符) {
                    如果 (解析标识符类型ID(整64(对象守卫c.文本)) == 0) { 返回 假; }
                }
                可选<整64> 对象查c = 解析方法对象类型扩展(池, 调用索引);
                如果 (对象查c.有值) {
                    如果 (是容器类(驻留文本(对象查c.值))) {
                        可选<整64> 返基查c = 解析调用返回类型ID(池, 调用索引);
                        如果 (返基查c.有值) {
                            命中c = 字符串比较(驻留文本(返基查c.值), "字符串");
                        }
                    }
                }
            }
        }
    }
    返回 命中c;
}

// ==================== #1922 件2：方法值变量调用返回串拥有判定 ====================
// 现象（#1922·alloc6/alloc8 探针）：绑定方法值变量调用 `cb()` 返回 `字符串` 时
//   声明位（`字符串 r = cb();`）/实参位（`打印(cb())`）百轮各净泄 1——宿主与 v2
//   同步。判定链断裂点：方法值调用被调=**标识符变量**，声明位/实参位拥有判定
//   原只认 函数返回类型表（函数返回名查表/决议函数符号）——变量名恒 miss →
//   按非拥有（污染）处理，返回堆串无人接管。
// 判定（与宿主 checkMethodValueCall retOwnedString 写回同构·#1578 函数指针
//   变量面同律）：被调=标识符且其类型登记为 `方法值<...>`（本判定只收方法值
//   变量面，自由函数/内置仍走既有 函数返回名查表 通道零变化）+ 方法值类型
//   内嵌函数指针返回段**精确**等于「字符串」=A2 拥有契约（方法返回位已保证
//   独立堆串）；"字符串&"（引用返回借用视图）含尾 '&' 比较不等=不拥有
//   （933 深拷通道管辖）。
// miss 处置（miss 不可静默·#1922 用户令）：类型文本前缀=方法值< 而已确认时，
//   内嵌签名段/返回段解析失败=编译器内部串残缺（makeMethodValueType 单点构造
//   不成立）——登记内部错误显形（收尾统一中止，不产 asm），中止前返回 假
//   （消费点保守分流=不释放方向·不得据假续编正确产物）。
//   纯谓词（真假语义判定·非失败通道·#1360 谓词免除结果化）。
// 判定源=**方法值类型文本内嵌返回段**（`方法值<定义类,函数指针<返回>(参数)>`）
//   ——不依赖调用返回类型登记表/函数返回类型表：预扫窗口（函数变量类型表未建）
//   与生成窗口共用类型ID 注入版；返回段精确「字符串」=A2 拥有契约，"字符串&"
//   （引用返回借用视图）含尾 '&' 比较不等=不拥有（933 深拷通道管辖）。
函数 是方法值类型拥有串返回(整64 类型ID, 整64 名ID) -> 布尔 {
    布尔 类型有效 = 类型ID > 0;
    // 静默豁免业务值: 类型ID 非正=非方法值形态的谓词否定回答（非失败通道·
    //   调用方按假分流=不拥有方向·#1360 谓词除外）
    如果 (!类型有效) { 返回 假; }
    字符串 型文 = 字符串复制(驻留文本(类型ID));
    布尔 方法值变量 = 是方法值类型文本(型文);
    // 静默豁免业务值: 非「方法值<」前缀=非本判据形态的谓词否定回答（自由函数/
    //   内置面走既有 函数返回名查表 通道零变化·#1360 谓词除外）
    如果 (!方法值变量) { 返回 假; }
    可选<字符串> 签查 = 方法值签名文本(型文);
    // 静默豁免上游已诊断: 签名段残缺=就地登记内部错误显形（收尾中止·不产
    //   asm），此处判假=中止前谓词否定回答（失败通道已显形·非静默默认值）。
    如果 (!签查.有值) {
        登记内部未登记("方法值类型串签名段残缺",
                       字符串复制(驻留文本(名ID)), 0);
        返回 假;
    }
    可选<字符串> 返查 = 函数指针返回文本(字符串复制(签查.值));
    // 静默豁免上游已诊断: 返回段残缺=就地登记内部错误显形（同上）。
    如果 (!返查.有值) {
        登记内部未登记("方法值类型串返回段残缺",
                       字符串复制(驻留文本(名ID)), 0);
        返回 假;
    }
    字符串 返文 = 字符串复制(返查.值);
    布尔 返文有效 = 字符串长度(返文) > 0;
    // 静默豁免上游已诊断: 空返回段=就地登记内部错误显形（同上）。
    如果 (!返文有效) {
        登记内部未登记("方法值类型串返回段为空",
                       字符串复制(驻留文本(名ID)), 0);
        返回 假;
    }
    返回 字符串比较(返文, "字符串");
}

// 生成窗口入口：类型来源=当前函数变量类型表（被调=标识符变量名）。
函数 是方法值变量拥有串返回(整64 名ID) -> 布尔 {
    可选<整64> 变量型查 = 查当前函数变量类型(名ID);
    // 静默豁免业务值: 非当前函数变量（自由函数/内置/全局方法名）=谓词否定
    //   回答（非失败通道·#1360 谓词除外）——显式早退，不取默认类型 ID。
    如果 (!变量型查.有值) { 返回 假; }
    返回 是方法值类型拥有串返回(变量型查.值, 名ID);
}
