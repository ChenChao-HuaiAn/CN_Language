// CN 自举编译器 v2：IR 默认参数登记/查询族（1737 任务轮冻结线拆分·自
//   IR生成类型.cn〔函数默认参数表 233/262/309 面〕与 IR生成类型辅助.cn
//   〔类构造默认参数表 309 面〕机械搬移·纯搬运零行为变更——两承载文件
//   均破 900 警戒线（993/992），1737 新增区起登记面顶破 1000 红线（先拆
//   再加纪律）→ 默认参数同族聚合独立承载·消费点经包内合并全局池解析
//   零改动（1615/655 拆分同款先例））。
// 职责：①顶层函数默认参数表（登记=登记函数签名K 尾段·补缺=补默认参数实参
//   生成函数.cn）；②类构造默认参数表（登记=语义收集面 收集类方法 构造分支·
//   补缺=补类构造默认实参 本族同文件·生成类中.cn 发射用户类构造消费）。
// 1737 面：根表旁增区间起点表（子终点=表达式区起·解析参数默认值 登记语义）
//   ——多节点默认表达式补缺全区间求值（原 [根,根+1) 单节点=子树不求值·
//   1596 探针 [992守卫] 槽号 0 实录）。

导入 容器::向量;
导入 IR;         // IR常量 键位移（目录包名）
导入 协议常量;   // 节点_参数（中立归属·335）

公开:

// 233：函数默认参数表（登记=登记函数签名K 尾段委托 IR容器·承载冻结线迁移）
静态 映射<整64, 整64> 函数签名默认数们;   // 键基ID*键位移+参数串ID -> 默认参数个数（尾连续·0=无）
静态 映射<整64, 整64> 函数默认参数根们;   // 键基ID*键位移+参数串ID*4096+参数序 -> 默认值根节点池索引
静态 映射<整64, 整64> 函数默认参数区起们; // 1737：同根键 -> 默认值表达式区间起点（参数节点.子终点·补缺全区间求值面）

// ==================== 309（2026-10-09）：类构造默认参数登记/放宽查询 ====================
// 病理（377/568 实测）：类构造走 类构造参数串们（键=类名ID*键位移+参数段个数）
//   精确匹配通道——构造带默认参数时 0/少参调用 miss：发射用户类构造 掉 278
//   （构造器）；注入父构造调用 报 234（568「空参列表靠父默认参」形态·宿主 D23
//   已支持）。宿主同构=语义层 funcDefaultArgs_+emitCtorInvoke 按选中构造补全。
// 键公式（段数≤63·序<64·积<4096 不撞键位移段）：类名ID*键位移+段数*64+参数序。
静态 映射<整64, 整64> 类构造默认数们;   // 类名ID*键位移+构造段数 -> 默认参数数（尾连续）
静态 映射<整64, 整64> 类构造默认根们;   // 类名ID*键位移+构造段数*64+参数序 -> 默认值根节点池索引
静态 映射<整64, 整64> 类构造默认区起们; // 1737：同根键 -> 默认值表达式区间起点（参数节点.子终点·补缺全区间求值面）

// 登记类构造默认参数（语义收集面 收集类方法 构造分支调用·方法节点与函数节点
//   同构：子起点=参数区间·块节点子起点修正式同 登记函数默认参数）。参数序=
//   声明序。宿主同构=语义层 funcDefaultArgs_+emitCtorInvoke 按选中构造补全。
不安全 函数 登记类构造默认参数(向量<节点> 池, 整32 方法节点, 整64 类名IDc, 整64 构造段数c) -> 空类型 {
    节点 方法声明c = 池.元素(方法节点);
    整64 参数终点c = 整64(方法声明c.子终点);
    如果 (参数终点c < 整64(池.大小())) {
        节点 体块c = 池.元素(整32(参数终点c));
        参数终点c = 整64(体块c.子起点);
    }
    整64 默认数c = 0;
    整64 参数序c = 0;
    整64 ic = 整64(方法声明c.子起点);
    当 (ic < 参数终点c && 参数序c < 构造段数c) {
        节点 参数c = 池.元素(整32(ic));
        如果 (参数c.类型 == 节点_参数) {
            如果 (参数c.子起点 != 0) {
                整64 设数键c = 类名IDc * 键位移 + 构造段数c;
                结果<空类型, 整32> 设数c = 类构造默认数们.设置(设数键c, 默认数c + 1);
                如果 (!设数c.正常) { 运行时错误(4); }
                整64 设根键c = 类名IDc * 键位移 + 构造段数c * 64 + 参数序c;
                结果<空类型, 整32> 设根c = 类构造默认根们.设置(设根键c, 参数c.子起点);
                如果 (!设根c.正常) { 运行时错误(4); }
                // 1737（任务 1737）：区间起点随根同键登记——多节点默认表达式
                //   补缺全区间求值面（语法层 子终点=区起·解析参数默认值）。
                结果<空类型, 整32> 设区c = 类构造默认区起们.设置(设根键c, 参数c.子终点);
                如果 (!设区c.正常) { 运行时错误(4); }
                默认数c++;
            }
            参数序c++;
        }
        ic++;
    }
}

// 查类构造默认参数个数（0=无默认·放宽匹配消费）
函数 查类构造默认数(整64 类名IDc, 整64 构造段数c) -> 整64 {
    结果<整64, 整32> 查 = 类构造默认数们.获取(类名IDc * 键位移 + 构造段数c);
    // 静默豁免业务值: 返回 0=「无默认参数」是本查询接口的合法业务语义（233 契约·
    //   非失败通道——查类构造放宽 默m 消费面按 0=不可补全分流·309 键公式约定）
    如果 (查.正常) { 返回 查.值; } 否则 { 返回 0; }
}

// 查类构造默认参数根（1541 B2 可选化：有值=根节点池索引（登记值恒非 0）；
//   无值=未登记）
函数 查类构造默认根(整64 类名IDc, 整64 构造段数c, 整64 参数序c) -> 可选<整64> {
    结果<整64, 整32> 查 = 类构造默认根们.获取(
        类名IDc * 键位移 + 构造段数c * 64 + 参数序c);
    如果 (查.正常) { 返回 某些(查.值); }
    返回 无;
}

// 1737（任务 1737·2026-10-27）：查类构造默认参数表达式区间起点（语法层
//   参数节点子终点·与根同键登记）——补缺求值 [区起, 根+1) 全区间（原
//   [根, 根+1) 单节点=多节点表达式子树不求值·与 函数默认参数面同病同修）。
//   miss 返回无值——补缺侧退回单节点区间（等价旧行为）。
函数 查类构造默认区起(整64 类名IDc, 整64 构造段数c, 整64 参数序c) -> 可选<整64> {
    结果<整64, 整32> 查区 = 类构造默认区起们.获取(
        类名IDc * 键位移 + 构造段数c * 64 + 参数序c);
    如果 (查区.正常) { 返回 某些(查区.值); }
    返回 无;
}

// 233：默认参数登记（尾连续 子起点!=0·键=键基ID*位移+键串ID*4096+参数序）——
//   参数序=声明序（尾连续时 缺段序==参数序·补缺直查）；中间默认后随无默认
//   =非法形态 默认数清零（宿主尾连续同语义）。调用=登记函数签名K 尾段。
不安全 函数 登记函数默认参数(向量<节点> 池, 整32 函数节点, 整64 键基ID, 整64 键串ID) -> 空类型 {
    节点 函数声明d = 池.元素(函数节点);
    整64 参数终点d = 整64(函数声明d.子终点);
    如果 (参数终点d < 整64(池.大小())) {
        节点 块节点d = 池.元素(整32(参数终点d));
        参数终点d = 整64(块节点d.子起点);
    }
    整64 默认数d = 0;
    布尔 见无默认d = 假;
    整64 参数序d = 0;
    整64 id = 整64(函数声明d.子起点);
    当 (id < 参数终点d) {
        节点 参数d = 池.元素(整32(id));
            如果 (参数d.类型 == 节点_参数) {
                如果 (参数d.子起点 != 0) {
                    如果 (见无默认d) { 默认数d = 0; 中断; }
                    默认数d++;
                    结果<空类型, 整32> 设根d = 函数默认参数根们.设置(
                        键基ID * 键位移 + 键串ID * 4096 + 参数序d, 参数d.子起点);
                    如果 (!设根d.正常) { 运行时错误(4); }
                    // 1737（任务 1737）：区间起点随根同键登记——多节点默认表达式
                    //   补缺全区间求值面（语法层 子终点=区起·解析参数默认值）。
                    结果<空类型, 整32> 设区d = 函数默认参数区起们.设置(
                        键基ID * 键位移 + 键串ID * 4096 + 参数序d, 参数d.子终点);
                    如果 (!设区d.正常) { 运行时错误(4); }
                } 否则 {   // 静默豁免闭集穷举: 否则=「无默认参数」合法区间显式枚举（扫描器状态机标志位·非业务兜底——默认形参尾连续契约 233 对偶面·024 搬移存量原样）
                如果 (默认数d > 0) { 见无默认d = 真; }   // 静默豁免闭集穷举: 默认数d>0 计数判定=计数域无业务上界（单边开区间禁令计数器豁免同类）
            }
            // 309（233 机制级补）：参数序=声明序——逐参数递增（无默认同样占序）。
            //   修前仅 id++ 无 参数序d++：全部默认段以序0 登记（映射后者覆盖前者）
            //   →多默认/中缺形态 查根(序≥1) 恒 miss（291 计算(1)/568/377 实证·
            //   单默认形态〔问候〕侥幸正确掩盖）。对齐宿主 defaultArgValues_
            //   按声明序追加同语义。
            参数序d++;
        }
        id++;
    }
    // 262（300-DN 双测负测·宿主 checkDefaultParams 同构·零分叉）：默认形参须
    //   从右向左连续声明——反向扫描，遇无默认形参后其左侧再现有默认者=编译期
    //   拒绝（宿主 semantic_builtins 同文案锚·全文案 T63 统一后案）。233 前向
    //   走查的「默认数清零」只保调用补缺安全，f(a=1,b) 形态仍静默登记默认数=1
    //   （=300-DN 红机制位），本检查补齐拒绝面。顶层函数两登记面（语义收集/
    //   IR 生成）经 登记函数签名K 汇聚于此·签名去重保单发；方法面宿主本就
    //   未查（检查挂 registerFunction 顶层函数趟）=同构不扩面。
    布尔 右侧见无默认262 = 假;
    整64 游262 = 参数终点d - 1;
    当 (游262 >= 整64(函数声明d.子起点)) {
        节点 参262 = 池.元素(整32(游262));
        如果 (参262.类型 == 节点_参数) {
            如果 (参262.子起点 != 0) {
                如果 (右侧见无默认262) {
                    IR层诊断("默认参数必须从右向左连续声明（参数 '" +
                             驻留文本(整64(参262.文本)) +
                             "' 左侧不能出现无默认值参数）");
                }
            } 否则 {   // 静默豁免闭集穷举: 否则=「无默认形参」合法区间显式枚举（262 反向扫描状态机标志位·非业务兜底·024 搬移存量原样）
                右侧见无默认262 = 真;
            }
        }
        游262 = 游262 - 1;
    }
    如果 (默认数d > 0) {   // 静默豁免闭集穷举: 计数判定=计数域无业务上界（单边开区间禁令计数器豁免同类·024 搬移存量原样——0=全无默认零登记）
        结果<空类型, 整32> 设默d = 函数签名默认数们.设置(
            键基ID * 键位移 + 键串ID, 默认数d);
        如果 (!设默d.正常) { 运行时错误(4); }
    }
}

// 233：查默认参数根节点池索引（1541 B2 可选化：有值=根节点池索引（登记值
//   恒 >0·登记侧 子起点!=0 守卫）；无值=未登记——原 0 哨兵）
函数 查默认参数根(整64 键基ID, 整64 参数串ID, 整64 参数序) -> 可选<整64> {
    如果 (参数串ID <= 0) { 返回 无; }
    结果<整64, 整32> 查 = 函数默认参数根们.获取(
        键基ID * 键位移 + 参数串ID * 4096 + 参数序);
    如果 (查.正常) { 返回 某些(查.值); }
    返回 无;
}

// 1737（任务 1737·2026-10-27）：查默认参数表达式区间起点（语法层 参数节点
//   子终点·与根同键登记）——补缺求值 [区起, 根+1) 全区间（原 [根, 根+1)
//   单节点=多节点表达式子树不求值·1596 探针实录）。miss（旧缓存/未登记）
//   返回无值——补缺侧退回单节点区间（等价旧行为·单节点默认值两键同值）。
函数 查默认参数区起(整64 键基ID, 整64 参数串ID, 整64 参数序) -> 可选<整64> {
    如果 (参数串ID <= 0) { 返回 无; }
    结果<整64, 整32> 查区 = 函数默认参数区起们.获取(
        键基ID * 键位移 + 参数串ID * 4096 + 参数序);
    如果 (查区.正常) { 返回 某些(查区.值); }
    返回 无;
}
