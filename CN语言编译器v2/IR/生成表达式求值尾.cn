// 生成表达式求值尾（356 重构F1 自 生成表达式求值.cn 纯机械搬移·函数体逐字保留·零逻辑变化）
导入 容器::向量;
导入 映射集合;
导入 语法;       // Token/AST 节点池（目录包名）
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码 + IR常量 键位移（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 IR生成;     // 函数级变量类型权威表/重载决议/控制流辅助（同包幂等）

公开:

// 91-a（2026-09-13 第九十一轮）：容器方法实参类型码（与 弹出们 同序——
//   弹出们[i] = 声明序第 n-1-i 个实参；段名经 取参数段 解析、类型码 归一）。
//   浮点段（T=浮64/浮32 实例化替换后）走 xmm/d 寄存器类；未知段兜底 0（整型类）。
// 648 归档：段名 miss（取参数段 空）经 类型码("")=T_未知——显形已由 类型码
//   源头登记单点覆盖（本函数不重复登记，防一行报 N 条）。
函数 容器实参类型码们(字符串 参数串, 向量<整64> 弹出们) -> 向量<整64> {
    向量<整64> 码们 = 向量<整64>();
    整64 n = 弹出们.大小();
    整64 i = 0;
    当 (i < n) {
        字符串 段名 = 取参数段(参数串, n - 1 - i);
        整64 段码 = 类型码(驻留(段名));
        结果<空类型, 整32> 加码 = 码们.追加(段码);
        如果 (!加码.正常) { 运行时错误(4); }
        i++;
    }
    返回 码们;
}

// 普通函数调用发射：结构体按值实参/& 引用实参 回扫取地址（B8/②c D 表驱动）+
//   返回结构体 retbuf（148）+引用返回解引用读值（P3-18）+返回值类型登记。


不安全 函数 发射普通函数调用(向量<整64>& 弹出们, 整64 函数符号, 整64 实参数,
                     向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数,
                     向量<整64>& 表达式栈,
                     整64 retbuf序号, 整64 返回类型覆盖) -> 空类型 {
    // #1589（miss 不可静默·#648 同纪律·2026-10-25）：内置构造器名 正常/错误/某些
    //   **绝不**允许走普通函数调用发射——三名字为编译器预置（语义层声明收集已拒
    //   重定义），到达此发射点=调用形态/表达式栈错位（#1589 实录：枚举名撞同名
    //   值绑定致弹栈错位，构造器 错误 被当普通函数发 EXTERN ?错误@@Y → LNK2019）。
    //   显形为 [ir2] 内部错误（计数>0 → 主 于代码生成前中止：不产 asm/EXTERN）；
    //   原发射路径保留为诊断后的合法值兜底（#648「中止前路径合法值」纪律）。
    如果 (函数符号 == 驻留("正常") || 函数符号 == 驻留("错误") ||
         函数符号 == 驻留("某些")) {
        IR层诊断("内部错误：内置构造器 " + 驻留文本(函数符号) +
                 " 未进入装箱特判（语义层标注缺失/表达式栈错位）——不得按普通函数调用发射");
    }
    // 224-a（2026-09-16 第两百二十四轮，D1 行数整改）：实参回扫迁 回扫结构体与引用实参；
    //   81-a-v2 物化迁 物化结构体返回值（真=已压栈已返回）；引用返回段迁 发射引用返回加载。
    回扫结构体与引用实参(弹出们, 函数符号, 指令, 寄存器计数, 槽计数);
    // 1887（#1396 ③宽化通道配套）：浮点实参按被调形参码数值宽化（浮码表驱动
    //   ·弹栈序/键契约与 回扫结构体与引用实参 同源）——决议层已按 实参段匹配级
    //   浮32→浮64=级1 选中宽化候选，本步补齐发射侧数值转换（修前 352 面浮32
    //   位模式直传浮64 形参槽·win 面 movsd 全宽读垃圾≈0·1654 第4行实锚）。
    发射浮点实参宽化(弹出们, 函数符号, 指令, 寄存器计数);
    整64 返回寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
        寄存器计数[0] = 寄存器计数[0] + 1;
        // 用户函数返回结构体（2026-09-04，E2E 148）：帧尾共享 retbuf（容器
        //   方法同款 B6 设施）+ 位 0 装载 + 实参起始位 1；rax=结构体地址
        //   （初始化拷贝/链式成员基址/按值实参直用）。retbuf 帧尺寸累计。
        整64 retbuf序号v = 0;
        整64 实参起始位v = 0;
        整64 结构体返回IDv = 0 - 1;   // 81-a-v2：真结构体返回 → 调用后物化（>=0 生效）
        整64 查返回s = 返回类型覆盖;
        // 912-b（1027 运行位实锚）：返回类型来源参数化——静态方法直调（生成方法
        //   调用 070 波G 分支）传 查类方法返回（方法表）覆盖；普通调用传 -1 =
        //   查函数返回类型 表（原行为逐字不变）。下游 retbuf 判定/返回码/返回
        //   值类型登记 三面同源此值。
        如果 (查返回s == 0 - 1) {
            可选<整64> 覆盖查s = 查函数返回类型(函数符号);
            如果 (覆盖查s.有值) { 查返回s = 覆盖查s.值; }
        }
        // 1818（#1784 丁案 R1·与 生成函数.cn 被调方同规）：非容器用户类返回=
        //   句柄 ABI（被调方 rax=句柄直传·无 sret）——排除 retbuf 分派，返回码
        //   T_对象（1737 方法面同款指针类装载·下方返回码段/物化段/登记段 同
        //   函数三消费点同源此谓词）。
        //   容器类实例返回维持 retbuf（值语义本体存储·628 波 1·127_v2）。
        布尔 类句柄返回s = (查返回s >= 0 && 是用户类_ID(查返回s) &&
                          !是容器类_ID(查返回s));
        如果 (查返回s >= 0) {
            整64 返回结构大小 = 0;
            可选<整64> 返回结构大小查 = 查结构体大小(查返回s);
            如果 (!类句柄返回s && 返回结构大小查.有值) {
                返回结构大小 = 返回结构大小查.值;
            }
            如果 (返回结构大小 == 0) {
                // 71-a：结果/可选 返回同款 retbuf ABI（被调方 返回结果名ID 配对；
                //   rax=retbuf=结果基址——接收侧 生成结果局部 IR_结构体拷贝 直用）
                // #1682（2026-10-27）：**引用返回排除**——返回类型尾 & =地址语义
                //   （928 口径·被调方 生成返回引用分支 rax=被引用左值地址·非
                //   retbuf），须整体跳过 retbuf 分派。合成体引用返回（`可选<整64>&
                //   取参(...)`）是结果类型 前缀判定「可选<」命中不剥 & → 误入
                //   retbuf 形态（调用方 rdi=retbuf·被调方按非 retbuf 生成 rdi=
                //   引用形参 → ABI 错位·别名槽=悬垂 retbuf 地址 fault=0x1）。
                //   整32&/货架& 标量/结构体面 是结果类型=假 天然不触（102/1012）。
                字符串 返回名71 = 字符串复制(驻留文本(查返回s));
                布尔 引用返回名71 = 字符串长度(返回名71) > 0 &&
                    ((整64(返回名71[字符串长度(返回名71) - 1]) & 255) == 38);
                如果 (!引用返回名71 && 是结果类型(返回名71)) {
                    返回结构大小 = 结果大小(返回名71);
                }
                // 810（053）：128 位标量返回=retbuf 16 字节（被调方 返回128位
                //   配对·rax=retbuf 地址——返回寄存器登记 T_整128/T_正128 后
                //   按「值=地址」消费：打印传址/赋值双半拷）
                否则 如果 (字符串比较(返回名71, "整128") ||
                     字符串比较(返回名71, "正128")) {
                    返回结构大小 = 16;
                }
                // 087b（#087 余量·宿主 82984e4bbe 同构）：数组返回=retbuf
                //   字节=类型名宽度 967 折叠（被调方 返回数组字节 配对·rax=
                //   retbuf 地址——值=数组基址，接收侧声明整块拷/下标直用）
                否则 如果 (是数组类型文本(返回名71)) {
                    返回结构大小 = 类型名宽度(查返回s);
                }
            }
            如果 (返回结构大小 != 0) {
                累计retbuf字节数(返回结构大小);
                retbuf序号v = retbuf序号;
                实参起始位v = 1;
                如果 (是结构体大小非零(查返回s)) {
                    // 82-a：跨模块限定（同名结构体布局按模块分桶独立——E2E 172）
                    结构体返回IDv = 限定返回类型ID(函数符号, 查返回s);
                }
            }
        }
        发射调用实参们(弹出们, 实参起始位v, 指令, 实参类型码们(弹出们));
        // 91-a：返回类型码（IR_调用参数化.操作数2——浮点值返回走 xmm0 装载；
        //   retbuf 形态（结构体/结果）与引用返回=地址，标 0 整型类）
        // 087b：数组返回同属 retbuf 形态——返回寄存器=retbuf 地址（64 位），
        //   不得按 类型码(数组文本) 装载（误折 T_整32 → movsxd eax 32 位截断
        //   retbuf 指针→接收整块拷解引用崩·596 v2 面 RVA=1528 铁证）
        整64 返回码v = 0;
        如果 (查返回s >= 0 && 结构体返回IDv < 0) {
            字符串 返回名pre = 字符串复制(驻留文本(查返回s));
            布尔 引用pre = 假;
            如果 (字符串长度(返回名pre) > 0 &&
                 ((整64(返回名pre[字符串长度(返回名pre) - 1]) & 255) == 38)) {
                引用pre = 真;
            }
            // 1818（#1784）：用户类返回=句柄 T_对象 装载（类型码查表域无类名
            //   =T_未知 会跳目标寄存器分配+压栈·1737 方法面同坑同治）——
            //   结构体/数组面维持排除（retbuf 形态=地址标 0 整型类）。
            如果 (是用户类_ID(查返回s) && !是容器类_ID(查返回s) && !引用pre) {
                返回码v = T_对象;
            } 否则 如果 (!引用pre && !是结构体大小非零(查返回s) &&
                        !是数组类型文本(返回名pre)) {
                返回码v = 类型码(查返回s);
            }
        }
        IR追加(指令, 建IR指令(IR_调用参数化, 实参起始位v + 实参数, 返回码v, 0,
                             返回寄存器, retbuf序号v, 函数符号));
    如果 (物化结构体返回值(指令, 寄存器计数, 槽计数, 返回寄存器, 结构体返回IDv, 表达式栈)) {
        // 1538（2026-10-25）：类返回物化「拥有」标记（用户类返回·构造调用/
        //   662 自由函数候选/方法面候选=拥有）——975 实参位释放通道与 1538
        //   语句位析构的单一甄别源：85-a 门槛对齐后借用来源句柄直传（调用方
        //   对象别名），无标记释放=误删调用方对象（直通探针 free invalid
        //   pointer 实录·宿主 1479 同根教训）。非用户类返回（结构体/结果/
        //   容器·物化栈槽形态）不标记=各通道既有语义不变。
        如果 (结构体返回IDv >= 0 && 结构体返回IDv < 键位移 &&
             是用户类_ID(结构体返回IDv) &&
             函数返回拥有甄别(函数符号)) {
            物化拥有登记1538(表达式栈.元素(表达式栈.大小() - 1));
        }
        返回;
    }
        // 引用返回（2026-09-04 缺陷零容忍收口，宿主 P3-18 对齐）：返回寄存器
        //   =被引用左值地址——默认按右值读解引用（IR_指针加载 值）；赋值目标/
        //   复合赋值/引用初始化场景经 生成左值地址 调用分支回扫取地址
        布尔 是引用返回v = 假;
        字符串 返回名v = "";
        如果 (查返回s >= 0) {
            返回名v = 字符串复制(驻留文本(查返回s));
            如果 (字符串长度(返回名v) > 0 &&
                 ((整64(返回名v[字符串长度(返回名v) - 1]) & 255) == 38)) {
                是引用返回v = 真;
            }
        }
        如果 (是引用返回v) {
            发射引用返回加载(指令, 寄存器计数, 返回寄存器, 返回名v, 表达式栈);
            返回;
        }
        // ③ 第二波（方案A）：用户函数返回值类型登记（打印分派/拼接判定消费；
        //   缺陷②同族根治：字符串返回未登记 -> from_int(指针) 静默错误代码，
        //   asm 探针实锤——代码生成共用.cn:30/104 拼接实际在用）
        // 912-b：复用 查返回s（含 返回类型覆盖 参数化——与 retbuf 判定同源）
        整64 查返回 = 查返回s;
        如果 (查返回 >= 0) {
            整64 返回码 = 类型码(查返回);
            如果 (返回码 != T_未知 && 返回码 != T_空类型) {
                登记寄存器类型(返回寄存器, 返回码);
            }
            // 701-a 波H 定论：128 位返回值**不设**地址标记（试验证=标记随编号复用
            //   泄漏致 500 崩）；返回值面待双槽值语义（053 主体）解决。
            // 1818（丁案 R1）：类返回句柄临时登记（拥有甄别通过=副本/移交壳·
            //   实参位/语句位终结析构面数据源；借用/保守面不登记=宁漏勿错——
            //   与 1538 物化拥有标记同一甄别源）。类句柄谓词=函数级 类句柄返回s
            //   （已含 查返回s 域判定）。
            如果 (类句柄返回s && 函数返回拥有甄别(函数符号)) {
                类返回句柄登记(返回寄存器, 查返回);
            }
        }
        结果<空类型, 整32> 加普 = 表达式栈.追加(返回寄存器);
        如果 (!加普.正常) { 运行时错误(4); }
}

// ==================== T69（480-a 深度机）函数指针间接调用发射 ====================
// 被调签名解析：被调节点（调用节点.子起点）为标识符且其声明类型是函数指针时
//   返回该签名文本（`函数指针<返回>(参数表)`）；其余形态/未登记=空串
//   （返回类型退 T_未知=整数类，ABI 仍按整型寄存器装载——不失正确性，
//   仅浮点返回需签名才能走 xmm 装载）。
// 491：成员被调（对象.字段——结构体函数指针字段，001 §5.8 甲案声明位全集④）
//   扩展——对象为标识符（局部/参数经 解析对象结构体ID；静态结构体经 静态
//   序号→静态类型，probe491_p_n）或调用返回（造包裹().fn(...)，经 解析调用
//   返回结构体，probe491_p_m）时按布局键基 + 查字段类型ID 取字段类型文本
//   （「函数指针<...>」形态即签名）返回。与宿主 ir_call.cpp funcPtrTypeOfCallee
//   树形态覆盖对齐；缺此=聚合返回无 retbuf 预插（probe491_p_c 结构体返回经
//   字段间接调用 C0000005/错误码守卫实录）。对象为成员链/下标等更深形态维持
//   miss 空串=零行为变化。
// （1240 结果化·无签名/不可判 → 可选无值）
函数 查被调函数指针签名480(向量<节点> 池, 节点 n) -> 可选<字符串> {
    // 索引域守卫：子起点哨兵 0/越界=无被调节点（可选无值·消费点 .有值 分流）
    如果 (n.子起点 <= 0) { 返回 无; }
    如果 (整32(n.子起点) >= 整32(池.大小())) { 返回 无; }
    节点 被调480 = 池.元素(整32(n.子起点));
    // 927（复合被调 造句柄()(3,4)·001 §5.8 间接调用被调=任意 fnptr 表达式）：被调=
    //   调用表达式结果——解析内层调用返回类型（标识符形态经 查函数返回回退 两级
    //   查询），为函数指针类型文本（函数指针<...> 合成形态）即为签名；原缺=签名
    //   miss → 返回码 T_未知 → ABI 按整型装载（浮点/聚合返回错值面潜伏）。宿主
    //   ir.cpp funcPtrTypeOfCallee 调用节点分支同构；更深内层被调形态=诚实边界。
    如果 (被调480.类型 == 节点_调用) {
        // 927 内层被调索引守卫（哨兵 0=无·池界）：比较式归入命名布尔
        //   （882 门禁「单边比较」面：非阈值语义——索引域守卫，双向条件同述）
        整32 内被调起927 = 被调480.子起点;
        布尔 内被调位有效927 = 内被调起927 != 0 &&
                              内被调起927 < 整32(池.大小());
        // 内层被调索引哨兵/池界无效=无间接调用签名（无值·调用方按无签名处理）
        如果 (!内被调位有效927) { 返回 无; }
        节点 内被调927 = 池.元素(内被调起927);
        如果 (内被调927.类型 != 节点_标识符) { 返回 无; }
        可选<整64> 返ID927查 = 查函数返回回退(整64(内被调927.文本));
        // 1541 B2：无值=返回类型未知（原 <=0 判据等价）
        如果 (!返ID927查.有值) { 返回 无; }
        整64 返ID927 = 0;
        如果 (返ID927查.有值) { 返ID927 = 返ID927查.值; }
        字符串 返文本927 = 字符串复制(驻留文本(返ID927));
        // 非函数指针文本=无间接调用签名（上界诚实边界——调用方按无签名处理·宿主 ir.cpp 同构）
        如果 (!是函数指针类型文本(返文本927)) { 返回 无; }
        返回 某些(返文本927);
    }
    如果 (被调480.类型 == 节点_成员) {
        // 索引域守卫：子起点哨兵 0/越界=无对象节点（可选无值）
        如果 (被调480.子起点 <= 0) { 返回 无; }
        如果 (整32(被调480.子起点) >= 整32(池.大小())) { 返回 无; }
        节点 对象480 = 池.元素(整32(被调480.子起点));
        整64 结构体ID480 = 0;
        如果 (对象480.类型 == 节点_标识符) {
            // 1541 B2：无值=对象非结构体（原 0 哨兵等价·下方静态结构体回退同判据）
            可选<整64> 对象结构查480 = 解析对象结构体ID(对象480);
            如果 (对象结构查480.有值) { 结构体ID480 = 对象结构查480.值; }
            如果 (结构体ID480 == 0) {
                // 491：静态结构体对象（与 生成方法接收者 040 三路同源）
                结果<整64, 整32> 静态查480 = 查静态序号含类(整64(对象480.文本));
                如果 (静态查480.正常) {
                    // 1637：可选显式分流——无值=静态类型非结构体（结构体ID480
                    //   保持 0·下方 ==0 早退判据契约不变）
                    可选<整64> 静键查 = 查结构体类型(取静态类型(静态查480.值));
                    如果 (静键查.有值) { 结构体ID480 = 静键查.值; }
                }
            }
        } 否则 如果 (对象480.类型 == 节点_调用) {
            // 491：调用返回对象（造包裹().fn(...)——被调链=对象调用返回结构体）
            可选<整64> 结构查480 = 解析调用返回结构体(池, 整32(被调480.子起点));
            如果 (结构查480.有值) { 结构体ID480 = 结构查480.值; }
        }
        如果 (结构体ID480 == 0) { 返回 无; }
        可选<整64> 字段类型查480 = 查字段类型ID(结构体ID480, 整64(被调480.文本));
        如果 (!字段类型查480.有值) { 返回 无; }
        整64 字段类型ID480 = 字段类型查480.值;
        字符串 字段文本480 = 字符串复制(驻留文本(字段类型ID480));
        如果 (!是函数指针类型文本(字段文本480)) { 返回 无; }
        返回 某些(字段文本480);
    }
    如果 (被调480.类型 != 节点_标识符) { 返回 无; }
    整64 类型ID480 = 解析标识符类型ID(整64(被调480.文本));
    如果 (类型ID480 == 0) { 返回 无; }
    字符串 文本480 = 字符串复制(驻留文本(类型ID480));
    如果 (!是函数指针类型文本(文本480)) { 返回 无; }
    返回 某些(文本480);
}

// 间接调用发射：实参按声明序装载（起始位 0=无 retbuf/this）+ IR_间接调用 收尾；
//   返回寄存器新建并登记类型码（打印/拼接/嵌套调用分派用）。实参负占位
//   （函数名作实参）= 值位收口 还原函数地址（T69 值位）。
不安全 函数 发射间接调用480(向量<节点> 池, 节点 n, 整64 被调寄存器,
                       向量<整64>& 弹出们, 向量<IR指令>& 指令, 整64* 寄存器计数,
                       整64* 槽计数, 向量<整64>& 表达式栈, 整64 retbuf序号) -> 空类型 {
    可选<字符串> 签名查480 = 查被调函数指针签名480(池, n);
    字符串 签名480 = "";
    如果 (签名查480.有值) { 签名480 = 字符串复制(签名查480.值); }
    整64 返回码480 = 0;
    // 490（#485 742d 拆面 v2 侧·宿主 ir_call.cpp 间接调用结构体形态A 同构）：
    //   聚合返回（结构体/结果/数组）fnptr 的 retbuf 形态——原 返回码480=类型码(
    //   结构体文本)=T_未知=0 且 类型位=0：三后端判无 retbuf → rcx 装首实参，
    //   被调方 sret 协议把首实参当隐藏返回指针写=814 面1 fault=3 C0000005
    //   实锤（首实参值当地址）。修后=类型位=retbuf 槽（413-b 接口聚合间接
    //   分派同形态）：位0=retbuf（后端 lea rcx 帧尾共享区）、实参自位1、
    //   返回装载 mov 目标,rax=MS/SysV ABI 隐藏指针（帧尾 retbuf 区尺寸累计）。
    //   判定源=签名返回文本（结构体大小表/结果/数组文本——与 发射普通函数
    //   调用 查返回s 同口径；128 位返回不在此列=操作数2=128 返回码通道既有）。
    整64 返回类型ID480 = 0;
    如果 (字符串长度(签名480) > 0) {
        可选<字符串> 返回文查480 = 函数指针返回文本(签名480);
        字符串 返回文本480 = "";
        如果 (返回文查480.有值) { 返回文本480 = 字符串复制(返回文查480.值); }
        如果 (字符串长度(返回文本480) > 0) {
            返回类型ID480 = 驻留(返回文本480);
            返回码480 = 类型码(返回类型ID480);
        }
    }
    布尔 聚合返回480 = 假;
    整64 返回字节480 = 0;
    如果 (返回类型ID480 != 0) {
        字符串 聚合名480 = 字符串复制(驻留文本(返回类型ID480));
        如果 (是结构体大小非零(返回类型ID480) && !是容器类(聚合名480) &&
             !是用户类_ID(返回类型ID480)) {
            聚合返回480 = 真;
            可选<整64> 返回字节480查 = 查结构体大小(返回类型ID480);
            如果 (返回字节480查.有值) { 返回字节480 = 返回字节480查.值; }
        } 否则 如果 (是结果类型(聚合名480)) {
            聚合返回480 = 真;
            返回字节480 = 结果大小(聚合名480);
        } 否则 如果 (是数组类型文本(聚合名480)) {
            聚合返回480 = 真;
            返回字节480 = 类型名宽度(返回类型ID480);
        }
    }
    整64 retbuf槽480 = 0;
    整64 实参起始位480 = 0;
    如果 (聚合返回480) {
        累计retbuf字节数(返回字节480);
        retbuf槽480 = retbuf序号;
        实参起始位480 = 1;   // 位0=retbuf（后端 lea rcx·实参自 rdx 起）
        返回码480 = 0;       // 返回=retbuf 地址（64 位装载·数组防元素码截断）
    }
    实参负占位收口480(指令, 寄存器计数, 弹出们);
    // 421（070·wt421）：128 位形参宽化——签名参数表逐段判定（编译期可得），
    //   实参寄存器非 T_整128/正128（64 位值形态：字面量/窄表达式）物化 2 槽
    //   句柄后改弹出项（被调 prologue 按双槽地址 rep movsb 16 字节——原窄值
    //   直传=被调当地址解引用 SIGSEGV·探针 E2/E3 fault=字面量值本身 实锤；
    //   普通函数路径 回扫结构体与引用实参 810 分支同构）。
    如果 (字符串长度(签名480) > 0) {
        整64 段i480 = 0;
        当 (段i480 < 函数指针参数个数(签名480) && 段i480 < 弹出们.大小()) {
            可选<字符串> 参表查480 = 函数指针参数文本(签名480);
            字符串 参表480 = "";
            如果 (参表查480.有值) { 参表480 = 字符串复制(参表查480.值); }
            整64 段名480 = 函数指针参数段文本(参表480, 段i480);
            整64 段码480 = 类型码(段名480);
            如果 (段码480 == T_整128 || 段码480 == T_正128) {
                整64 实regw480 = 弹出们.元素(弹出们.大小() - 1 - 段i480);
                // 1360 批5：未登记=类型未知（T_未知 兜底·既有业务语义：非 128 源）
                整64 实码w480 = 查寄存器类型或未知(实regw480);
                如果 (实码w480 != T_整128 && 实码w480 != T_正128) {
                    整64 句柄w480 = 物化128位操作数(实regw480, 实码w480,
                        实码w480 == T_正32 || 实码w480 == T_正64 ? 0 : 1,
                        指令, 寄存器计数, 槽计数);
                    结果<空类型, 整32> 改实w480 = 弹出们.设置(
                        弹出们.大小() - 1 - 段i480, 句柄w480);
                    如果 (!改实w480.正常) { 运行时错误(4); }
                }
            }
            段i480++;
        }
    }
    整64 返回寄存器480 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    发射调用实参们(弹出们, 实参起始位480, 指令, 实参类型码们(弹出们));
    // 类型位=retbuf槽（聚合形态·三后端 retbuf 前导位；标量=0 维持既有 ABI）
    IR追加(指令, 建IR指令(IR_间接调用, 实参起始位480 + 弹出们.大小(), 返回码480, 0,
                         返回寄存器480, retbuf槽480, 被调寄存器));
    如果 (返回码480 != T_未知 && 返回码480 != T_空类型) {
        登记寄存器类型(返回寄存器480, 返回码480);
    }
    // 聚合返回：目标=rax=被调返回的 retbuf 地址（返回码=0 走 64 位装载）——
    //   压栈供成员消费/CopyStruct（与 发射普通函数调用 聚合形态同链）
    结果<空类型, 整32> 加间480 = 表达式栈.追加(返回寄存器480);
    如果 (!加间480.正常) { 运行时错误(4); }
}

// 104/440（070 波C·1022）：方法引用闭包调用展开——被调=闭包绑定变量
//   （生成声明 消费登记·方法引用符号们）→ 直接调用方法符号：
//   实参位0=this（对象变量槽 Load 对象指针·引用捕获语义=改态后读最新，
//   104 断言「改态后: 205」）+实参位1..=用户实参（弹出们 已按声明序）。
//   返回码=方法引用返回码们（方法返回类型·打印分派/嵌套消费）。
//   返回 1=已展开；0=非闭包变量（调用方走 T69 间接调用）。
不安全 函数 方法引用闭包调用展开(向量<节点> 池, 节点 n, 向量<整64>& 弹出们,
                       映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                       向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数,
                       向量<整64>& 表达式栈) -> 整32 {
    如果 (n.子起点 <= 0 || 整32(n.子起点) >= 整32(池.大小())) { 返回 0; }
    节点 被调c = 池.元素(整32(n.子起点));
    如果 (被调c.类型 != 节点_标识符) { 返回 0; }
    结果<整64, 整32> 查符号c = 方法引用符号们.获取(整64(被调c.文本));
    如果 (!查符号c.正常) { 返回 0; }
    结果<整64, 整32> 查对象c = 方法引用对象们.获取(整64(被调c.文本));
    结果<整64, 整32> 查码c = 方法引用返回码们.获取(整64(被调c.文本));
    // v2 结果纪律：结果.值 只能肯定分支内访问——固化局部变量
    整64 方法符号IDc = 0;
    整64 对象名IDc = 0;
    整64 返回码预c = 0;
    如果 (查符号c.正常) {
        如果 (查对象c.正常) {
            如果 (查码c.正常) {
                方法符号IDc = 查符号c.值;
                对象名IDc = 查对象c.值;
                返回码预c = 查码c.值;
            }
            否则 {
            }
        }
        否则 {
        }
    }
    否则 {
    }
    如果 (方法符号IDc == 0) { 返回 0; }
    // this 装载：对象变量槽（局部/参数）→ IR_加载(T_对象)=对象指针
    整64 对象槽c = 0;
    结果<整64, 整32> 找局c = 局部槽.获取(对象名IDc);
    如果 (找局c.正常) { 对象槽c = 找局c.值; } 否则 { }
    如果 (对象槽c == 0) {
        结果<整64, 整32> 找参c = 参数槽.获取(对象名IDc);
        如果 (找参c.正常) { 对象槽c = 找参c.值; } 否则 { }
    }
    如果 (对象槽c == 0) { 返回 0; }
    整64 this寄存器c = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 对象槽c, 0, 0, this寄存器c, T_对象, 0));
    // 421（070·wt421）：闭包展开实参回扫——直调方法符号 表驱动（与 发射用户
    //   类方法调用 同款：128 位形参宽化+结构体/引用取地址）。原缺=回调(字面量)
    //   窄值直传、被调 prologue 按双槽地址 rep movsb 解引用 SIGSEGV（探针 J2
    //   变量 回调 = 对象.装填; 回调(200000000000) fault=字面量值本身 实锤）。
    //   非结构体/非 128 形参=表 miss 零操作（104 存量断言面零回归）。
    回扫结构体与引用实参(弹出们, 方法符号IDc, 指令, 寄存器计数, 槽计数);
    IR追加(指令, 建IR指令(IR_调用实参, this寄存器c, 0, 0, 0, 0, 0));
    发射调用实参们(弹出们, 1, 指令, 实参类型码们(弹出们));
    整64 返回寄存器c = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    整64 返回码c = 0;
    如果 (查码c.正常) { 返回码c = 查码c.值; } 否则 { }
    IR追加(指令, 建IR指令(IR_调用参数化, 1 + 弹出们.大小(), 返回码c, 0,
                         返回寄存器c, 0, 方法符号IDc));
    如果 (返回码c != T_未知 && 返回码c != T_空类型) {
        登记寄存器类型(返回寄存器c, 返回码c);
    }
    结果<空类型, 整32> 加闭包c = 表达式栈.追加(返回寄存器c);
    如果 (!加闭包c.正常) { 运行时错误(4); }
    返回 1;
}
// #276 波1：lambda 值捕获闭包调用展开——被调变量在 闭包绑定表 → 间接调用
//   +捕获快照实参前置（位0..N-1·宿主 ir_call.cpp captureArgs 展开同构——
//   快照槽=定义处固化·调用点只 Load：变量槽存函数地址（T69 通道）被调寄存器
//   原样用，捕获实参不进 弹出们（用户实参回扫逻辑原样）。返回 1=已展开；
//   0=非闭包变量（调用方走 T69 间接调用原路）。
不安全 函数 lambda闭包调用展开(向量<节点> 池, 节点 n, 整64 被调寄存器L,
                       向量<整64>& 弹出们, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                       向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数,
                       向量<整64>& 表达式栈) -> 整32 {
    如果 (n.子起点 <= 0 || 整32(n.子起点) >= 整32(池.大小())) { 返回 0; }
    节点 被调L = 池.元素(整32(n.子起点));
    如果 (被调L.类型 != 节点_标识符) { 返回 0; }
    结果<整64, 整32> 查闭包L = lambda闭包变量们.获取(整64(被调L.文本));
    如果 (!查闭包L.正常) { 返回 0; }
    整64 lambda名L = 0;
    如果 (查闭包L.正常) { lambda名L = 查闭包L.值; } 否则 { }
    // 432（#276 波3·蹦床归一）：可蹦床形态走 T69 间接调用原路——变量槽已装
    //   蹦床地址（生成标识符加载 表达式位收口·捕获快照还原内聚蹦床体内），
    //   本展开的捕获实参前置对蹦床形态会挤位（蹦床参数=用户参数）。结构体/
    //   128 捕获旧轨（局部槽快照+展开直调·#428/#418 面）保持下方原路。
    如果 (lambda可蹦床432(lambda名L)) {
        // 482（#482 多实例独立快照）：载体式登记——调用前把载体槽内容写回共享
        //   静态槽（蹦床还原读到的=该实例快照·多实例互不影响）；无登记/无槽=
        //   零动作（现状直路·共享槽=最近实例）。
        发射载体到共享482(池, 整64(被调L.文本), lambda名L, 局部槽, 参数槽,
                       指令, 寄存器计数, 槽计数);
        返回 0;
    }
    整64 形态L = 0;
    结果<整64, 整32> 查形L = lambda捕获形态们.获取(lambda名L);
    // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
    如果 (查形L.正常) { 形态L = 查形L.值; } 否则 { }
    // 0/1/2/3 全展开（计数 0 早退走 T69 原路·3=[&] 波2）
    结果<整64, 整32> 查起L = lambda捕获起们.获取(lambda名L);
    结果<整64, 整32> 查数L = lambda捕获计数们.获取(lambda名L);
    整64 起L = 0;
    整64 数L = 0;
    如果 (查起L.正常) {
        如果 (查数L.正常) {
            起L = 查起L.值;
            数L = 查数L.值;
        }
        否则 {
        }
    }
    否则 {
    }
    如果 (数L == 0) { 返回 0; }
    // 合成函数节点（捕获参数区间=类型载体）
    节点 合成L;
    整64 找到L = 0;
    整64 liL = lambda合成函数索引们.大小() - 1;
    当 (liL >= 0) {
        节点 candL = 池.元素(整32(lambda合成函数索引们.元素(整32(liL))));
        如果 (整64(candL.文本) == lambda名L) {
            合成L = candL;
            找到L = 1;
            中断;
        }
        liL--;
    }
    如果 (找到L == 0) { 返回 0; }
    字符串 变量文本L = 字符串复制(驻留文本(整64(被调L.文本)));
    // 捕获快照实参前置（位 j=第 j 参数·倒序栈序=IR_调用实参 位域直写）
    //   457：捕获名哨兵（语义回填噪声名剔除·名序位=0）跳过且**位号不占**
    //   （被调形参序=合成参数区间按 节点_参数 扫·哨兵不在=后续位压缩）
    整64 capjL = 0;
    当 (capjL < 数L) {
        整64 捕名L2 = lambda捕获名序们.元素(整32(起L + capjL));
        如果 (捕名L2 == 0) { capjL++; 继续; }   // 457：哨兵=剔除位不占参号
        字符串 快照名L = 变量文本L + "$cap$" + 驻留文本(捕名L2);
        整64 快照槽L = 0;
        结果<整64, 整32> 查槽L = 局部槽.获取(驻留(快照名L));
        如果 (查槽L.正常) { 快照槽L = 查槽L.值; } 否则 { }
        如果 (快照槽L == 0) {
            结果<整64, 整32> 查槽参L = 参数槽.获取(驻留(快照名L));
            如果 (查槽参L.正常) { 快照槽L = 查槽参L.值; } 否则 { }
        }
        如果 (快照槽L == 0) {
            返回 0;
        }
        节点 捕获参数L = 池.元素(整32(整64(合成L.子起点) + capjL));
        结果<整64, 整32> 捕查L = 查lambda捕获参数类型(lambda名L, 捕名L2);
        结果<整64, 整32> 捕附查L = 查lambda捕获参数附加(lambda名L, 捕名L2);
        整64 捕型L = 0;
        整64 捕附加L = 0;
        布尔 捕有L = 假;
        如果 (捕查L.正常) { 捕型L = 捕查L.值; 捕有L = 真; } 否则 {
        }
        如果 (捕附查L.正常) { 捕附加L = 捕附查L.值; } 否则 {
        }
        // 457（462-②）：附加平行表恢复（指针层/引用标记）——回退路径读池
        //   类型节点文本+附加（语义回填后同函数可见时有效）
        如果 (!捕有L && 整64(捕获参数L.附加) > 0 &&
             整64(捕获参数L.附加) < 整64(池.大小())) {
            节点 类型节点L = 池.元素(整32(捕获参数L.附加));
            捕型L = 整64(类型节点L.文本);
            捕附加L = 整64(类型节点L.附加);
        }
        // 433（701）：结构体值捕获——合成函数形参=结构体按值（prologue 从
        //   入参**指针**拷贝·②b B8 ABI）→ 实参须传**快照槽地址**（结构体
        //   实参地址语义·87-a 同款；原 IR_加载 值装载=快照位模式当地址·
        //   prologue 解引用拷贝炸）。标量/指针捕获=值装载零变化。
        //   457（457/460/461 本任务点名面）：判定补**形态3 排除+指针层排除**
        //   ——[&] 快照槽存**源地址**（非结构体本体·431 快照装载码分派
        //   T_整64 地址透传=读最新/写穿载体），再取地址=把「存源地址的槽
        //   地址」传给按值形参→prologue 把地址位模式当结构体数据；指针捕获
        //   （附加>=1）快照=单槽指针值，误判结构体同样取槽地址炸。485 起本
        //   展开通道被蹦床恒真早退遮蔽（防御性修正·通道复活不炸）。
        布尔 捕是结构体L = 形态L != 3 && 捕附加L == 0 && 捕型L > 0 &&
                          是结构体大小非零(捕型L) &&
                          !是容器类(驻留文本(捕型L)) && !是用户类_ID(捕型L);
        // 418（002 收口杂项正测族）：128 位捕获并入传址分支——快照=2 槽 16 字节
        //   （生成声明 捕获段同批改），合成函数形参 i128=双槽结构体式 ABI
        //   （prologue 入参指针拷贝）→ 实参须传快照基址。原值装载路径
        //   IR_加载(捕码=T_整128) 只读 8 字节低半当地址传 → prologue 解引用
        //   垃圾地址 C0000005（18_缺陷修复 i128 值捕获快照实录）。
        字符串 捕型文本L = 捕型L > 0 ? 字符串复制(驻留文本(捕型L)) : 字符串复制("");
        布尔 捕是128L = 字符串比较(捕型文本L, "整128") ||
                        字符串比较(捕型文本L, "正128");
        如果 (捕是结构体L || 捕是128L) {
            整64 址寄存器L = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_取地址, 快照槽L, 0, 0, 址寄存器L, T_整64, 0));
            IR追加(指令, 建IR指令(IR_调用实参, 址寄存器L, T_整64, 0, 0, capjL, 0));
            capjL++;
            继续;
        }
        整64 捕码L = 类型码(捕型L);
        如果 (形态L == 3) { 捕码L = T_整64; }   // [&] 快照=地址·整64 装载
        // 457（462-②）：指针捕获快照=单槽 64 位指针值——捕码按基名（T_整32）
        //   装载=截断指针→还原后解引用 SEGV（801c 实录）·按附加位恢复整64。
        否则 如果 (捕附加L >= 1 && 捕附加L < 256) { 捕码L = T_整64; }
        整64 读寄存器L = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_加载, 快照槽L, 0, 0, 读寄存器L, 捕码L, 0));
        IR追加(指令, 建IR指令(IR_调用实参, 读寄存器L, 捕码L, 0, 0, capjL, 0));
        capjL++;
    }
    // 用户实参（位 捕获数..·T69 原样）+间接调用收尾
    可选<字符串> 签名查L = 查被调函数指针签名480(池, n);
    字符串 签名L = "";
    如果 (签名查L.有值) { 签名L = 字符串复制(签名查L.值); }
    整64 返回码L = 0;
    如果 (字符串长度(签名L) > 0) {
        可选<字符串> 返回文查L = 函数指针返回文本(签名L);
        字符串 返回文本L = "";
        如果 (返回文查L.有值) { 返回文本L = 字符串复制(返回文查L.值); }
        如果 (字符串长度(返回文本L) > 0) { 返回码L = 类型码(驻留(返回文本L)); }
    }
    // 421：128 位形参宽化（lambda/闭包展开路径——与 发射间接调用480 同构；
    //   签名L 编译期可得时按参数表逐段判定·64 位值形态物化句柄改弹出项）
    如果 (字符串长度(签名L) > 0) {
        整64 段iL = 0;
        当 (段iL < 函数指针参数个数(签名L) && 段iL < 弹出们.大小()) {
            可选<字符串> 参表查L = 函数指针参数文本(签名L);
            字符串 参表L = "";
            如果 (参表查L.有值) { 参表L = 字符串复制(参表查L.值); }
            整64 段名L = 函数指针参数段文本(参表L, 段iL);
            整64 段码L = 类型码(段名L);
            如果 (段码L == T_整128 || 段码L == T_正128) {
                整64 实regwL = 弹出们.元素(弹出们.大小() - 1 - 段iL);
                // 1360 批5：未登记=类型未知（T_未知 兜底·既有业务语义：非 128 源）
                整64 实码wL = 查寄存器类型或未知(实regwL);
                如果 (实码wL != T_整128 && 实码wL != T_正128) {
                    整64 句柄wL = 物化128位操作数(实regwL, 实码wL,
                        实码wL == T_正32 || 实码wL == T_正64 ? 0 : 1,
                        指令, 寄存器计数, 槽计数);
                    结果<空类型, 整32> 改实wL = 弹出们.设置(
                        弹出们.大小() - 1 - 段iL, 句柄wL);
                    如果 (!改实wL.正常) { 运行时错误(4); }
                }
            }
            段iL++;
        }
    }
    发射调用实参们(弹出们, 数L, 指令, 实参类型码们(弹出们));
    整64 返回寄存器L = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_间接调用, 数L + 弹出们.大小(), 返回码L, 0,
                         返回寄存器L, 0, 被调寄存器L));
    如果 (返回码L != T_未知 && 返回码L != T_空类型) {
        登记寄存器类型(返回寄存器L, 返回码L);
    }
    结果<空类型, 整32> 加间L = 表达式栈.追加(返回寄存器L);
    如果 (!加间L.正常) { 运行时错误(4); }
    返回 1;
}

// 1887（#1396 ③宽化通道配套·2026-10-31）：浮点实参按被调形参码数值宽化——
//   决议层（实参段匹配级 浮32→浮64=级1）与发射层（352 面按字面量后缀发
//   浮32 位模式）脱节的发射侧收口：形参 浮64（查函数实参浮码 表驱动·键=
//   被调链接键*键位移+参数序）且实参寄存器登记 T_浮32 → 插入值转换
//   （cvtss2sd 数值宽化·与内置面 91-a 浮32→浮64 提升同款机制）改弹出项。
//   修前 movss 4 字节位模式直传浮64 形参槽（win 面 movsd 全宽读位模式=
//   垃圾≈0·1654 第4行 仅f64:0.000000 实锚；linux 面 X64L 转换不回写槽·
//   call 前不重载·xmm0 残留高位恰好拼出 1.500000=巧合绿·数值本身已错）。
//   浮32 变量实参同病同治（探针实锚：变量形态语义层放行·同缺转换）。
//   对称面 浮64→浮32 窄化语义层已拒（v2 sem5 与宿主双侧同拒·探针备案）
//   不登记不转换。弹出们 序契约同 回扫结构体与引用实参：i=声明序·
//   元素=大小()-1-i；引用/指针浮点形参（附加≠0）不入浮码表=地址直传免转换。
不安全 函数 发射浮点实参宽化(向量<整64>& 弹出们, 整64 函数符号,
                     向量<IR指令>& 指令, 整64* 寄存器计数) -> 空类型 {
    整64 实参序浮 = 0;
    当 (实参序浮 < 弹出们.大小()) {
        可选<整64> 形参码浮查 = 查函数实参浮码(函数符号 * 键位移 + 实参序浮);
        如果 (形参码浮查.有值 && 形参码浮查.值 == T_浮64) {
            整64 实参reg浮 = 弹出们.元素(弹出们.大小() - 1 - 实参序浮);
            可选<整64> 实参码浮查 = 查寄存器类型(实参reg浮);
            如果 (实参码浮查.有值 && 实参码浮查.值 == T_浮32) {
                整64 宽化reg浮 = 插入值转换(实参reg浮, T_浮64, 指令, 寄存器计数);
                结果<空类型, 整32> 改宽化浮 = 弹出们.设置(
                    弹出们.大小() - 1 - 实参序浮, 宽化reg浮);
                如果 (!改宽化浮.正常) { 运行时错误(4); }
            }
        }
        实参序浮++;
    }
}

// 224-a：族① 实参回扫取地址——②b B8 结构体按值实参（函数实参结构们 表驱动）+
//   ②c D & 引用实参（函数实参引用们 同款回扫）。
不安全 函数 回扫结构体与引用实参(向量<整64>& 弹出们, 整64 函数符号, 向量<IR指令>& 指令,
                     整64* 寄存器计数, 整64* 槽计数) -> 空类型 {
        // ---- 普通函数调用：实参从位 0 起，全部经 64+63（任意参数数） ----
        // ②b B8：结构体按值实参 -> 传地址（函数实参结构们 表驱动——与 B3 容器
        //   方法路径同款回扫；v2 自身 IR追加(指令, 建IR指令(...)) ③ 自举必需）
        // ②c D：& 引用实参 -> 传左值地址（函数实参引用们 表驱动同款回扫）
        整64 实i2 = 0;
        当 (实i2 < 弹出们.大小()) {
            可选<整64> 结构查实参 = 查函数实参结构(函数符号 * 键位移 + 实i2);
            如果 (结构查实参.有值) {
                回扫实参取地址(指令, 弹出们, 实i2, 寄存器计数, 槽计数);
            } 否则 如果 (是函数实参128位(函数符号 * 键位移 + 实i2)) {
                // 810（053）：128 位形参位——实参寄存器登记 T_整128/正128（地址
                //   句柄·变量/静态/调用返回/算术产物）直传；64 位值形态（字面量/
                //   窄表达式/64 位调用返回）物化 2 槽为句柄后改弹出项（prologue
                //   收地址双半拷 16 字节——值直传=当地址解引用段错误·420-①实证）。
                整64 实reg128 = 弹出们.元素(弹出们.大小() - 1 - 实i2);
                // 1360 批5：未登记=类型未知（T_未知 兜底·既有业务语义：非 128 源）
                整64 实码128 = 查寄存器类型或未知(实reg128);
                如果 (实码128 != T_整128 && 实码128 != T_正128) {
                    整64 句柄128 = 物化128位操作数(实reg128, 实码128,
                        实码128 == T_正32 || 实码128 == T_正64 ? 0 : 1,
                        指令, 寄存器计数, 槽计数);
                    结果<空类型, 整32> 改实128 = 弹出们.设置(
                        弹出们.大小() - 1 - 实i2, 句柄128);
                    如果 (!改实128.正常) { 运行时错误(4); }
                }
            } 否则 如果 (!是函数实参128位(函数符号 * 键位移 + 实i2)) {
                布尔 查引用实参 = 是函数实参引用(函数符号 * 键位移 + 实i2);
                如果 (查引用实参) {
                    // #1813：容器类/用户类引用位 + 实参为内联对象本体地址（地址
                    //   计算形态：下标元素/内联字段）→ 物化槽再传槽地址（被调方
                    //   解一层得本体地址=对象指针）；未物化走标识符/静态等既有
                    //   「指针存放处地址」路径
                    布尔 已物化引用 = 假;
                    如果 (引用位需物化槽(函数符号 * 键位移 + 实i2)) {
                        已物化引用 = 物化引用实参槽(指令, 弹出们, 实i2,
                                                     寄存器计数, 槽计数);
                    }
                    如果 (!已物化引用) {
                        回扫实参取地址(指令, 弹出们, 实i2, 寄存器计数, 槽计数);
                    }
                } 否则 如果 (!查引用实参) {
                    // 919（超承载字面量参与表达式·实参求值链收口）：非 128 形参
                    //   位收 128 值（超承载字面量表达式经 638 甲案提升链物化为
                    //   地址句柄）→ 隐式窄化低半（与声明初值/赋值/返回挂点同设施
                    //   ·宿主 genArgValueWithCleanup i128 截断为 i64 同款）。原
                    //   句柄地址直传 64 位形参＝被调收到栈地址碎片（探针：收
                    //   (99999999999999999999 + 0) 输出每次不同的地址，应
                    //   7766279631452241919＝低 64 位截断）。
                    整64 实reg919 = 弹出们.元素(弹出们.大小() - 1 - 实i2);
                    可选<整64> 实码919查 = 查寄存器类型(实reg919);
                    如果 (实码919查.有值 &&
                        (实码919查.值 == T_整128 || 实码919查.值 == T_正128)) {
                        整64 低半919 = 隐式窄化到64(实reg919, 指令, 寄存器计数);
                        结果<空类型, 整32> 改实919 = 弹出们.设置(
                            弹出们.大小() - 1 - 实i2, 低半919);
                        如果 (!改实919.正常) { 运行时错误(4); }
                    }
                }
            }
            实i2++;
        }
}

// 224-a：族② 81-a-v2（甲案）真结构体返回物化——调用发射后立即物化到独立槽并改压栈
//   寄存器（帧尾共享 retbuf 会被后续返回调用覆盖）。返回 真=已物化已压栈（调用方即返回）。
不安全 函数 物化结构体返回值(向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数,
                     整64 返回寄存器, 整64 结构体返回IDv, 向量<整64>& 表达式栈) -> 布尔 {
    如果 (结构体返回IDv >= 0) {
            整64 物化reg = 物化返回值到独立槽(指令, 寄存器计数, 槽计数,
                                              返回寄存器, 结构体返回IDv);
            如果 (物化reg != 0) {
                整64 物化码 = 类型码(结构体返回IDv);
                如果 (物化码 != T_未知 && 物化码 != T_空类型) {
                    登记寄存器类型(物化reg, 物化码);
                }
                结果<空类型, 整32> 加物 = 表达式栈.追加(物化reg);
                如果 (!加物.正常) { 运行时错误(4); }
                返回 真;
            }
    }
    返回 假;
}

// 224-a：族③ 引用返回加载——返回寄存器=被引用左值地址，默认按右值读解引用
//   （IR_指针加载）；值类型登记剥尾 & 后的类型码（打印分派/拼接消费）。
// 1036（引用返回读宽根治）：解引用读宽=被引用类型**精确值码**（静态值码641）
//   ——原固定 T_整64=恒 8 字节宽读：被引用左值为窄槽（结构体窄字段/整8/16/
//   布尔/字符/浮32）时越读相邻字段（探针：全局盒.值 整32@0 读出
//   0x00000006_00000005=25769803781 vs 宿主 5）＝v2 单侧分叉。
不安全 函数 发射引用返回加载(向量<IR指令>& 指令, 整64* 寄存器计数, 整64 返回寄存器,
                     字符串 返回名v, 向量<整64>& 表达式栈) -> 空类型 {
    整64 引用值reg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
            // 值类型登记：剥尾 & 后的类型码（打印分派/拼接消费）
            字符串 基类型名 = 字符串子串(返回名v, 0, 字符串长度(返回名v) - 1);
            整64 基类型ID1036 = 驻留(基类型名);
            整64 引用返回码 = 类型码(基类型ID1036);
            // 1274（1428 链式读锚回补·宿主 1260 emitRefReturnDeref 同位）：
            //   结构体/数组 pointee=聚合——豁免解引用，产物=被引用左值地址直通
            //   （成员链 .x 从地址+offset 消费）。原无条件 LoadPtr 把聚合首 8 字节
            //   （x|y 拼合值）当值读入·后续成员访问把该值当地址解引用
            //   fault=0xA00000058（99 探针 rc=-11 实录）。标量/字符串 pointee
            //   照旧解引用读值（打印/算术消费·1036 精确码不动）。
            // 宿主豁免集=纯结构体（isStructType）∪数组——类/字符串=读句柄维持
            //   LoadPtr（1260 注释原文「标量=读值、字符串/类=读句柄」）——类
            //   豁免会劫持 633 深拷/接管通道（1012 位①③ double free 实录）。
            可选<整64> 聚合大小查引返 = 查结构体大小(驻留(基类型名));
            如果 ((聚合大小查引返.有值 && !是用户类(基类型名)) ||
                 是数组类型文本(基类型名)) {
                结果<空类型, 整32> 加地址引返 = 表达式栈.追加(返回寄存器);
                如果 (!加地址引返.正常) { 运行时错误(4); }
                返回;
            }
            // 1036：宽读修精确——静态值码641＝值语义精确码（整8/正8/整16/
            //   正16/字符/浮32 窄读·其余名=类型码直通：整32/正32/整64/
            //   正64/浮64/字符串/对象 各自精确）——后端按码发射窄读+
            //   符号/零扩展（代码生成 IR_指针加载 分派），对齐宿主
            //   emitRefReturnDeref mapType(剥&类型) 同款读宽。
            IR追加(指令, 建IR指令(IR_指针加载, 返回寄存器, 0, 0, 引用值reg,
                                静态值码641(基类型ID1036), 0));
            如果 (引用返回码 != T_未知 && 引用返回码 != T_空类型) {
                登记寄存器类型(引用值reg, 引用返回码);
            }
            结果<空类型, 整32> 加引 = 表达式栈.追加(引用值reg);
            如果 (!加引.正常) { 运行时错误(4); }
            返回;
}

