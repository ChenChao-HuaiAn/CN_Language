// CN 自举编译器 v2 · 生成语句（千行拆分子模块，2026-09-08 用户裁决阶段目录包）
// 职责：语句遍历（生成语句）+ 块遍历与控制流生成（生成块/生成如果/生成当）
//   ——自 IR生成.cn 机械搬移；寄存器/引用参数等权威表经 公开: 访问函数
//   （IR生成 主干）；模块路径=生成语句（新键基）。
导入 容器::向量;
导入 语法;       // Token/AST 节点池（原 导入 语法分析，目录包名）
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码（目录包名）
导入 IR生成;     // 控制流辅助/变量类型权威表（同包幂等）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// ==================== 语句遍历 ====================
// 取参数串第 段序 段（',' 分隔，0 起；越界返回 空串）——②b 结构体实参判定用
//   （局部实现避免 代码生成共用 导入环：共用层依赖本模块）
函数 取参数段(字符串 参数串, 整64 段序) -> 字符串 {
    整64 起点 = 0;
    整64 段 = 0;
    整64 i = 0;
    当 (i <= 字符串长度(参数串)) {
        布尔 边界 = i == 字符串长度(参数串);
        如果 (!边界) {
            整64 字节 = 整64(参数串[i]);
            如果 (字节 < 0) { 字节 = 字节 + 256; }
            如果 (字节 == 44) { 边界 = 真; }
        }
        如果 (边界) {
            如果 (段 == 段序) {
                返回 字符串子串(参数串, 起点, i - 起点);
            }
            起点 = i + 1;
            段++;
        }
        i++;
    }
    返回 "";
}

// 生成 池[块起点, 块终点) 内语句的 IR。本阶段语句级支持 变量声明/返回/表达式语句/
//   赋值/自增/如果/当/中断/继续（P6b 控制流）。
// 缺陷A根治（2026-09-02）：返回 布尔=本块是否已终止（返回/中断/继续 后跳过
//   剩余语句——不可达代码不再发射，避免后续 返回 覆盖返回值/析构重复发射）。
函数 生成语句(向量<节点> 池, 整32 起点, 整32 终点,
              映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
              函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
              向量<整64>& 表达式栈, 整64 返回类型码) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    // 预扫描：收集本块内 控制流语句（如果/当）的体块节点索引——
    //   体语句节点在池中位于控制流语句节点之前（顺序追加），会被本块区间
    //   直接包含；若直接生成会造成「体语句在外层重复生成」。收集后遍历时跳过。
    向量<整64> 体块们 = 向量<整64>();
    // ②b B4：裸块语句（直接子语句的 节点_块）——内部语句同样先于块节点入池，
    //   须跳过其区间（块节点处经 生成块 递归，作用域基线/块出口析构在内处理）
    向量<整64> 裸块们 = 向量<整64>();
    整32 扫 = 起点;
    当 (扫 < 终点) {
        节点 扫节点 = 池.元素(扫);
        如果 (扫节点.类型 == 节点_如果语句) {
            // 节点字段：附加=真块索引，子终点=否则索引
            结果<空类型, 整32> 加真 = 体块们.追加(整64(扫节点.附加));
            如果 (!加真.正常) { 运行时错误(4); }
            // 根治（2026-09-06，呈报① gdb/dbg 五层下钻闭环）：否则链须整链收集——
            //   原实现仅收集首层体块，「否则如果」的嵌套如果根未被跳过：主遍历
            //   遇内层根先整链生成一遍、外层 生成如果 递归再生成一遍=双重生成
            //   （chain 探针 4 层链实测 7 次生成如果而非 4 次、块重复执行——
            //   v2 IR 自源头坏、历史冒烟「exit=0+语义 0 错」假绿的真相）
            整64 链游 = 扫节点.子终点;
            当 (链游 != 0) {
                节点 链节 = 池.元素(整32(链游));
                如果 (链节.类型 == 节点_如果语句) {
                    结果<空类型, 整32> 加根 = 体块们.追加(链游);
                    如果 (!加根.正常) { 运行时错误(4); }
                    结果<空类型, 整32> 加体 = 体块们.追加(整64(链节.附加));
                    如果 (!加体.正常) { 运行时错误(4); }
                    链游 = 链节.子终点;
                } 否则 {
                    如果 (链节.类型 == 节点_块) {
                        结果<空类型, 整32> 加尾块 = 体块们.追加(链游);
                        如果 (!加尾块.正常) { 运行时错误(4); }
                    }
                    链游 = 0;
                }
            }
        } 否则 如果 (扫节点.类型 == 节点_当语句) {
            结果<空类型, 整32> 加当 = 体块们.追加(整64(扫节点.附加));
            如果 (!加当.正常) { 运行时错误(4); }
        } 否则 如果 (扫节点.类型 == 节点_块) {
            // 排除 如果/当/否则 的体块（体块们 已收集，生成如果/生成当 递归处理
            //   ——体块节点位置晚于控制流语句节点，此刻必已登记）
            布尔 是体块 = 假;
            整64 tb = 0;
            当 (tb < 体块们.大小()) {
                如果 (体块们.元素(tb) == 整64(扫)) { 是体块 = 真; }
                tb++;
            }
            如果 (!是体块) {
                结果<空类型, 整32> 加裸 = 裸块们.追加(整64(扫));
                如果 (!加裸.正常) { 运行时错误(4); }
            }
        }
        扫++;
    }
    整32 位置 = 起点;
    当 (位置 < 终点) {
        // 跳过控制流语句的体块（体语句节点在控制流语句节点之前，已被预扫描收集）
        布尔 跳过 = 假;
        整64 跳块 = 0;
        整64 b = 0;
        当 (b < 体块们.大小()) {
            整64 体块索引 = 体块们.元素(b);
            如果 (整64(位置) == 体块索引) {
                跳过 = 真;
                跳块 = 体块索引;
            } 否则 {
                节点 体块节点 = 池.元素(整32(体块索引));
                如果 (整64(位置) >= 整64(体块节点.子起点) && 整64(位置) < 体块索引) {
                    跳过 = 真;
                    跳块 = 体块索引;
                }
            }
            b++;
        }
        如果 (跳过) {
            位置 = 整32(跳块 + 1);
            继续;
        }
        // ②b B4：跳过裸块内部语句（先于块节点入池；块节点处经 生成块 递归生成）
        布尔 在裸块内 = 假;
        整64 nb = 0;
        当 (nb < 裸块们.大小()) {
            整64 裸块索引 = 裸块们.元素(nb);
            节点 裸块节点 = 池.元素(整32(裸块索引));
            如果 (整64(位置) >= 裸块节点.子起点 && 整64(位置) < 裸块索引) {
                在裸块内 = 真;
            }
            nb++;
        }
        如果 (在裸块内) {
            位置++;
            继续;
        }
        节点 n = 池.元素(位置);
        如果 (n.类型 == 节点_变量声明) {
            节点 类型节点 = 池.元素(整32(n.附加));
            字符串 类型文本 = 驻留文本(整64(类型节点.文本));
            // ③ 第三波：指针局部登记（附加=指针层数 1..255，同参数约定——
            //   整32* p = &t.甲 形态，下标读写步进按所指元素宽度）
            如果 (类型节点.附加 >= 1 && 类型节点.附加 < 256) {
                登记指针变量类型(整64(n.文本), 整64(类型节点.文本));
            }
            // 引用局部（泛型引用绑定，2026-09-04 IR生成.cn 冒烟 96 错根治）：
            //   单槽存绑定对象左值地址——与引用参数槽完全同构（读取分流/成员
            //   基址/赋值写回/再传引用实参数据流复用 引用参数槽们/类型们 全套
            //   机制）。绑定=初始化区间按 生成左值地址（成员/标识符——不走
            //   生成表达式，避免成员取值）。不入 RAII 名单：引用不拥有对象
            //   （绑定字段归宿主结构体所有，出口析构=双重释放必错）。
            //   语义层已拒无初始化/非左值形态（防御双保险，此处再守一道）。
            如果 (类型节点.附加 == 256) {
                如果 (n.子起点 >= n.子终点) {
                    IR层诊断("引用声明必须初始化: " + 类型文本);
                }
                整64 槽y = 槽计数[0];
                槽计数[0] = 槽计数[0] + 1;
                结果<空类型, 整32> 设槽y = 局部槽.设置(整64(n.文本), 槽y);
                如果 (!设槽y.正常) { 运行时错误(4); }
                // 容器/结果类型入双表（方法调用对象类型解析——与容器参数同款）
                如果 (是容器类(类型文本) || 是结果类型(类型文本)) {
                    结果<空类型, 整32> 设类y = 函数信息.变量类型.设置(整64(n.文本),
                                                            整64(类型节点.文本));
                    如果 (!设类y.正常) { 运行时错误(4); }
                }
                登记当前函数变量类型(整64(n.文本), 整64(类型节点.文本));
                IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽y));
                登记引用参数槽(槽y);
                登记引用参数类型(槽y, 整64(类型节点.文本));
                如果 (n.子起点 < n.子终点) {
                    整64 绑定地址 = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                                 指令, 寄存器计数, &函数信息.块计数,
                                                 槽计数, 表达式栈);
                    如果 (绑定地址 != 0) {
                        IR追加(指令, 建IR指令(IR_存储, 绑定地址, 0, 0, 0, 0, 槽y));
                    }
                }
                位置++;
                继续;
            }
            // P7b 容器变量：槽已由预扫分配（入口零初始化）；此处 NewObject +
            //   无参构造 + Store（H7 同款：无初始化器也默认构造）；
            //   初值三形态（2026-09-04，IR生成.cn 冒烟 [ir2] 收口）：
            //   ①构造调用（= 向量$T()）——NewObject+构造；
            //   ②函数调用返回（= 取实例实参们(x)）——接收转移：不 NewObject，
            //     被调方构造对象所有权移交本槽（RAII 出口析构恰一次）；
            //   ③标识符拷贝（静态/局部源）——浅共享指针（对齐宿主「按值传 向量
            //     共享数据指针」语义；取走转移惯用法——语法分析.cn 取走导入模块们）
            如果 (是容器类(类型文本)) {
                布尔 是构造调用 = 假;
                布尔 是返回接收 = 假;
                布尔 是标识符拷贝 = 假;
                如果 (n.子起点 < n.子终点) {
                    节点 首节点 = 池.元素(n.子起点);
                    节点 末节点c = 池.元素(n.子终点 - 1);
                    如果 (首节点.类型 == 节点_标识符 && 首节点.文本 == 类型节点.文本 &&
                         末节点c.类型 == 节点_调用) {
                        是构造调用 = 真;
                    } 否则 如果 (末节点c.类型 == 节点_调用) {
                        是返回接收 = 真;
                    } 否则 如果 (末节点c.类型 == 节点_标识符) {
                        是标识符拷贝 = 真;
                    } 否则 {
                        IR层诊断("容器初始化仅支持构造/调用返回/标识符拷贝: " +
                                      类型文本);
                    }
                }
                整64 槽c = 0;
                结果<整64, 整32> 找槽c = 局部槽.获取(整64(n.文本));
                如果 (找槽c.正常) { 槽c = 找槽c.值; }
                如果 (是返回接收) {
                    // 接收转移：调用返回（rax=对象指针）直接入槽
                    整64 返回值reg = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                                 指令, 寄存器计数, &函数信息.块计数,
                                                 槽计数, 表达式栈);
                    如果 (返回值reg != 0 && 槽c != 0) {
                        IR追加(指令, 建IR指令(IR_存储, 返回值reg, 0, 0, 0, 0, 槽c));
                    }
                    当 (表达式栈.大小() > 0) {
                        结果<空类型, 整32> 删栈c = 表达式栈.删除(表达式栈.大小() - 1);
                        如果 (!删栈c.正常) { 运行时错误(4); }
                    }
                    位置++;
                    继续;
                }
                如果 (是标识符拷贝) {
                    // 2026-09-06 根治（宿主对齐·深拷贝构造）：宿主实证（alias 探针
                    //   asm）`映射 B = A` 发射 NewObject+拷贝构造（符号 类$基名#类型，
                    //   独立对象出口析构）；原浅共享 IR_存储 与宿主分叉——源局部+
                    //   接收双析构=double free、写穿共享与宿主深拷贝语义矛盾。
                    //   源指针装载：局部/参数槽 IR_加载、静态 IR_静态加载。
                    节点 源节点 = 池.元素(n.子终点 - 1);
                    整64 源槽c = 0;
                    结果<整64, 整32> 找源局 = 局部槽.获取(整64(源节点.文本));
                    如果 (找源局.正常) { 源槽c = 找源局.值; }
                    如果 (源槽c == 0) {
                        结果<整64, 整32> 找源参 = 参数槽.获取(整64(源节点.文本));
                        如果 (找源参.正常) { 源槽c = 找源参.值; }
                    }
                    整64 源指针reg = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    布尔 源已解析 = 真;
                    如果 (源槽c != 0) {
                        // 拷贝构造源=T&（引用位传左值地址——宿主 ABI 实证：被调方
                        //   (%rsi) 解引用取对象指针）；槽是引用（绑定对象）则槽内容
                        //   即左值地址直接加载（回扫实参取地址 引用分支同款）
                        如果 (槽是引用(源槽c)) {
                            IR追加(指令, 建IR指令(IR_加载, 源槽c, 0, 0, 源指针reg, T_对象, 0));
                        } 否则 {
                            IR追加(指令, 建IR指令(IR_取地址, 源槽c, 0, 0, 源指针reg, T_整64, 0));
                        }
                    } 否则 {
                        整64 找源静 = 查静态序号(整64(源节点.文本));
                        如果 (找源静 >= 0) {
                            // 静态容器源（取走惯用法：向量 模块列表 = 导入模块们）：
                            //   拷贝构造 T& 传静态槽左值地址（lea .data 槽）
                            IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 源指针reg,
                                                 T_对象, 找源静));
                        } 否则 {
                            源已解析 = 假;
                            IR层诊断("容器拷贝源未解析: " +
                                          驻留文本(整64(源节点.文本)));
                        }
                    }
                    如果 (源已解析) {
                        整64 拷贝objreg = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 拷贝objreg,
                                             容器对象大小(类型文本),
                                             整64(类型节点.文本)));
                        // this=位0、源=位1（拷贝构造 T& 按引用位传对象指针）
                        IR追加(指令, 建IR指令(IR_调用实参, 拷贝objreg, 0, 0, 0, 0, 0));
                        IR追加(指令, 建IR指令(IR_调用实参, 源指针reg, 0, 0, 0, 1, 0));
                        // 拷贝构造签名=构造(T&)——参数串带 &（asm 符号 _A+类型编码，
                        //   alias.o 宿主实例 _...映射_A_T... 实证对齐）
                        IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                                             驻留(方法符号(类型文本,
                                                    合成名基名(类型文本),
                                                    类型文本 + "&"))));
                        如果 (槽c != 0) {
                            IR追加(指令, 建IR指令(IR_存储, 拷贝objreg, 0, 0, 0, 0, 槽c));
                        }
                    }
                    位置++;
                    继续;
                }
                整64 obj寄存器 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, obj寄存器,
                                     容器对象大小(类型文本), 整64(类型节点.文本)));
                // 参数区模式（项3）：this 经 IR_调用实参(64) 声明装载，63 只存总位数
                IR追加(指令, 建IR指令(IR_调用实参, obj寄存器, 0, 0, 0, 0, 0));
                IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                     驻留(构造符号(类型文本))));
                如果 (槽c != 0) {
                    IR追加(指令, 建IR指令(IR_存储, obj寄存器, 0, 0, 0, 0, 槽c));
                }
                位置++;
                继续;
            }
            // P7b 结果/可选 变量：2 槽内联布局（12/16 字节）+ 变量类型登记；
            //   初值 = 容器方法调用（retbuf 地址）-> IR_结构体拷贝 到本变量槽
            如果 (是结果类型(类型文本)) {
                // 多槽变量数据基址=低地址槽（高槽号）：槽号越大地址越低（8*(R+s)+8），
                //   结果字节从基址向上写——若取低槽号（高地址），写入越界覆盖
                //   槽号更小的相邻变量（表对象指针被污染 -> SIGSEGV，实测踩坑）。
                //   2026-09-06 根治（freg 探针/v2self 表注册 崩溃）：T=结构体时
                //   结果>16 字节（结果<符号>=24/40）——原硬编码 2 槽+基槽 槽r+1，
                //   24 字节拷贝自基槽向上覆盖相邻变量槽（顶层容器槽被清零 ->
                //   后续方法调用 this=null 判空 fail）。按 结果槽位数 逐槽分配，
                //   基槽=最大槽号（低地址）。
                整64 槽r = 槽计数[0];
                整64 结果槽数 = 结果槽位数(类型文本);
                槽计数[0] = 槽计数[0] + 结果槽数;
                结果<空类型, 整32> 设r = 局部槽.设置(整64(n.文本), 槽r + 结果槽数 - 1);
                如果 (!设r.正常) { 运行时错误(4); }
                结果<空类型, 整32> 设类r = 函数信息.变量类型.设置(整64(n.文本), 整64(类型节点.文本));
                如果 (!设类r.正常) { 运行时错误(4); }
                登记当前函数变量类型(整64(n.文本), 整64(类型节点.文本));
                整64 槽i = 0;
                当 (槽i < 结果槽数) {
                    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽r + 槽i));
                    槽i++;
                }
                如果 (n.子起点 < n.子终点) {
                    // 限定名内置直调初值（2026-09-06 根治，T6 自举首踩）：文件::/IO::
                    //   限定名内置返回裸指针（char*/FILE*，null=EOF/失败）——旧实现
                    //   把返回寄存器当「16 字节结果结构体地址」IR_结构体拷贝（读字符串
                    //   内容当结构体，v2 编译 v2 自身 读源文件 段错误实证）。改合成构造：
                    //   判空 -> 正常@0、指针 -> 值@8（对齐 结果 ABI 防御布局）
                    布尔 限定内置 = 假;
                    节点 首节点 = 池.元素(整32(n.子起点));
                    // 池顺序：调用表达式的被调标识符先入池（P6f 调用节点.子起点=被调
                    //   索引的镜像约定）——变量声明.子起点 即被调标识符（限定名内置
                    //   形态=「标识符(」无成员/后缀前缀）
                    如果 (首节点.类型 == 节点_标识符) {
                        字符串 被调名v = 驻留文本(整64(首节点.文本));
                        // 限定名判定（含 ':'，IO::/文件::）——字节位置 在 代码生成共用.cn
                        //   （IR生成 不导入=依赖环），此处内联首冒号扫描
                        布尔 含冒号 = 假;
                        整64 ci = 0;
                        当 (ci < 字符串长度(被调名v)) {
                            整64 cb = 整64(被调名v[ci]);
                            如果 (cb < 0) { cb = cb + 256; }
                            如果 (cb == 58) { 含冒号 = 真; 中断; }
                            ci++;
                        }
                        如果 (字符串长度(内置函数符号(被调名v)) != 0 && 含冒号) {
                            限定内置 = 真;
                        }
                    }
                    如果 (限定内置) {
                        整64 指针reg = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                                   指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
                        如果 (指针reg != 0) {
                            // 零初始化两槽（值@8=槽r、正常@0=槽r+1——基址槽=大槽号低地址）
                            整64 零reg = 寄存器计数[0];
                            寄存器计数[0] = 寄存器计数[0] + 1;
                            IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("0")), 0, 0, 零reg, T_整64, 0));
                            IR追加(指令, 建IR指令(IR_存储, 零reg, 0, 0, 0, 0, 槽r));
                            IR追加(指令, 建IR指令(IR_存储, 零reg, 0, 0, 0, 0, 槽r + 结果槽数 - 1));
                            // 值槽 = 裸指针
                            IR追加(指令, 建IR指令(IR_存储, 指针reg, 0, 0, 0, 0, 槽r));
                            // 正常槽 = 指针 != 0
                            整64 正常reg = 寄存器计数[0];
                            寄存器计数[0] = 寄存器计数[0] + 1;
                            IR追加(指令, 建IR指令(IR_不等, 指针reg, 零reg, 0, 正常reg, T_布尔, 0));
                            IR追加(指令, 建IR指令(IR_存储, 正常reg, 0, 0, 0, 0, 槽r + 结果槽数 - 1));
                        }
                    } 否则 {
                        整64 源地址 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                                 指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
                        如果 (源地址 != 0) {
                            整64 目标地址 = 寄存器计数[0];
                            寄存器计数[0] = 寄存器计数[0] + 1;
                            IR追加(指令, 建IR指令(IR_取地址, 槽r + 结果槽数 - 1, 0, 0, 目标地址, T_整64, 0));
                            IR追加(指令, 建IR指令(IR_结构体拷贝, 源地址, 目标地址, 0, 0,
                                                 结果大小(类型文本), 0));
                        }
                    }
                    当 (表达式栈.大小() > 0) {
                        结果<空类型, 整32> 删栈r = 表达式栈.删除(表达式栈.大小() - 1);
                        如果 (!删栈r.正常) { 运行时错误(4); }
                    }
                }
                位置++;
                继续;
            }
            // ②b B1（2026-09-02）：结构体局部变量——多槽布局（槽数=ceil(大小/8)，
            //   基址槽=最大槽号=最低地址，多槽向上写不越界）+ 零初始化（安全：
            //   字符串字段垃圾指针析构即崩——对齐宿主类局部入口零初始化防御）。
            //   整体初始化（= 表达式）暂不支持（诊断）；字段赋值走成员路径。
            如果 (查结构体大小(整64(类型节点.文本)) != 0) {
                整64 结构大小 = 查结构体大小(整64(类型节点.文本));
                整64 槽数 = (结构大小 + 7) / 8;
                整64 槽起 = 槽计数[0];
                槽计数[0] = 槽计数[0] + 槽数;
                结果<空类型, 整32> 设槽s = 局部槽.设置(整64(n.文本), 槽起 + 槽数 - 1);
                如果 (!设槽s.正常) { 运行时错误(4); }
                // ②c D：结构体局部入函数级变量类型权威表（成员偏移/宽度/方法对象解析）
                登记当前函数变量类型(整64(n.文本), 整64(类型节点.文本));
                整64 z = 0;
                当 (z < 槽数) {
                    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽起 + z));
                    z++;
                }
                // 零初始化：常量 0 -> 各槽
                整64 零寄存器 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("0")), 0, 0, 零寄存器, T_整64, 0));
                z = 0;
                当 (z < 槽数) {
                    IR追加(指令, 建IR指令(IR_存储, 零寄存器, 0, 0, 0, 0, 槽起 + z));
                    z++;
                }
                // ②c B：含容器字段的结构体局部——登记 RAII 跟踪（块出口/返回按字段
                //   逆序级联析构：字段地址->指针加载->DeleteObject，空安全）
                //   第 15 枚豁免（2026-09-06，v2self 第 8 层）：初值末节点=调用
                //   （非构造——结构体无构造调用）-> 不登记——sret 浅拷贝自调用方
                //   容器元素（收集字符串常量 实证：函数IR 扫函数 = 程序.函数们.
                //   元素(f) 出口级联析构=free 调用方 程序.函数们[f].指令 数据 ->
                //   后续迭代读/再析构已释放内存 -> invalid free SIGABRT）；宿主
                //   语义=调用返回接收不析构（泄漏对齐现状），与第 9 枚「容器变量
                //   调用返回初值不入 RAII」同款豁免。
                布尔 结构体返回接收 = 假;
                如果 (n.子起点 < n.子终点) {
                    节点 首节点s = 池.元素(n.子起点);
                    节点 末节点s = 池.元素(n.子终点 - 1);
                    如果 (末节点s.类型 == 节点_调用 &&
                        !(首节点s.类型 == 节点_标识符 && 首节点s.文本 == 类型节点.文本)) {
                        结构体返回接收 = 真;
                    }
                }
                如果 (容器字段数(整64(类型节点.文本)) > 0 && !结构体返回接收) {
                    结果<空类型, 整32> 加字段局部 = 函数信息.容器字段局部们.追加(整64(n.文本));
                    如果 (!加字段局部.正常) { 运行时错误(4); }
                    结果<空类型, 整32> 加字段结构体 = 函数信息.容器字段结构体们.追加(整64(类型节点.文本));
                    如果 (!加字段结构体.正常) { 运行时错误(4); }
                }
                如果 (n.子起点 < n.子终点) {
                    // 结构体初始化三形态（2026-09-04 E2E 148 两形态 + 呈报①A 冒烟
                    //   暴露第三形态 2026-09-05——v2 自举刚需）：
                    //   ①调用返回（IR指令 项 = 建IR指令(...)）：rax=结构体地址
                    //     （被调 retbuf）-> IR_结构体拷贝 入本变量基槽；
                    //   ②标识符拷贝（节点 参数类型节点 = 参数——生成函数 参数循环
                    //     实测形态）：源=标识符左值地址（局部/参数基槽）-> 拷贝；
                    //   ③成员字段（符号 找到 = 查.值——结果<T>.值 整体接收，语义分析.cn
                    //     冒烟踩出）：生成表达式 成员分支压字段地址（结果值字段=结构体
                    //     值语义不 LoadPtr）-> 拷贝。字面量等其他形态保持诊断（诚实边界）。
                    节点 初始化末s = 池.元素(n.子终点 - 1);
                    如果 (初始化末s.类型 == 节点_调用 || 初始化末s.类型 == 节点_标识符 ||
                         初始化末s.类型 == 节点_成员) {
                        整64 源地址 = 0;
                        如果 (初始化末s.类型 == 节点_调用 || 初始化末s.类型 == 节点_成员) {
                            源地址 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                                 指令, 寄存器计数, &函数信息.块计数,
                                                 槽计数, 表达式栈);
                        } 否则 {
                            源地址 = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                                   指令, 寄存器计数, &函数信息.块计数,
                                                   槽计数, 表达式栈);
                        }
                        如果 (源地址 != 0) {
                            整64 目标地址 = 寄存器计数[0];
                            寄存器计数[0] = 寄存器计数[0] + 1;
                            IR追加(指令, 建IR指令(IR_取地址, 槽起 + 槽数 - 1, 0, 0,
                                                 目标地址, T_整64, 0));
                            IR追加(指令, 建IR指令(IR_结构体拷贝, 源地址, 目标地址, 0, 0,
                                                 结构大小, 0));
                        }
                        当 (表达式栈.大小() > 0) {
                            结果<空类型, 整32> 删栈s = 表达式栈.删除(表达式栈.大小() - 1);
                            如果 (!删栈s.正常) { 运行时错误(4); }
                        }
                    } 否则 {
                        IR层诊断("结构体整体初始化暂不支持（字段赋值可用）");
                    }
                }
                位置++;
                继续;
            }
            // 变量声明：分配槽；若有初值（子起点<子终点），生成初值表达式 + 存储。
            整64 槽 = 槽计数[0];
            槽计数[0] = 槽计数[0] + 1;
            结果<空类型, 整32> 设槽 = 局部槽.设置(整64(n.文本), 槽);
            如果 (!设槽.正常) { 运行时错误(4); }
            // ③ 缺陷①根治：标量局部（字符串/浮点/布尔/整数）入函数级变量类型
            //   权威表（打印分派/拼接转换经 寄存器类型登记 消费——与容器/结果/
            //   结构体局部同表，权威表自此完整覆盖本函数全部局部）
            登记当前函数变量类型(整64(n.文本), 整64(类型节点.文本));
            IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽));
            如果 (n.子起点 < n.子终点) {
                整64 值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                             指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
                如果 (值寄存器 != 0) {
                    IR追加(指令, 建IR指令(IR_存储, 值寄存器, 0, 0, 0, 0, 槽));
                }
            }
        } 否则 如果 (n.类型 == 节点_返回语句) {
            整64 值寄存器 = 0;
            布尔 返回结构体值 = 函数信息.返回结构体ID != 0 && n.子起点 < n.子终点;
            // 引用返回（2026-09-04 缺陷零容忍收口，宿主 P3-18 对齐）：返回语句
            //   发射被引用左值地址（rax=左值地址——调用方指针加载读/指针存储写/
            //   引用初始化直接绑定）；非左值形态 IR 层诊断（语义层已白名单，
            //   防御双保险）
            如果 (函数信息.返回引用 == 1 && n.子起点 < n.子终点) {
                值寄存器 = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                         指令, 寄存器计数, &函数信息.块计数,
                                         槽计数, 表达式栈);
                如果 (值寄存器 == 0) {
                    IR层诊断("引用返回须返回左值（变量/成员/下标/解引用）: " +
                              驻留文本(整64(函数信息.名字)));
                }
                当 (表达式栈.大小() > 0) {
                    结果<空类型, 整32> 删栈rv = 表达式栈.删除(表达式栈.大小() - 1);
                    如果 (!删栈rv.正常) { 运行时错误(4); }
                }
                发射容器析构(函数信息, 指令, 寄存器计数, 局部槽, 0);
                IR追加(指令, 建IR指令(IR_返回, 值寄存器, 0, 0, 0, 返回类型码, 0));
                发射跳转(函数信息, 函数信息.函数尾块);
                返回 真;
            }
            如果 (返回结构体值) {
                // 用户函数返回结构体（2026-09-04，E2E 148）：宿主 ABI——值拷入
                //   调用方传入的 retbuf（槽 1 指针）、rax=retbuf。源地址两形态：
                //   末节点=标识符/成员/解引用 -> 生成左值地址（本函数局部基槽）；
                //   末节点=调用 -> 生成表达式（被调 retbuf 地址即结构体地址）
                节点 返回末 = 池.元素(n.子终点 - 1);
                如果 (返回末.类型 == 节点_标识符 || 返回末.类型 == 节点_成员 ||
                     返回末.类型 == 节点_解引用) {
                    值寄存器 = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                             指令, 寄存器计数, &函数信息.块计数,
                                             槽计数, 表达式栈);
                } 否则 {
                    值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                           指令, 寄存器计数, &函数信息.块计数,
                                           槽计数, 表达式栈);
                }
                整64 ret指针 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_加载, 1, 0, 0, ret指针, T_整64, 0));
                IR追加(指令, 建IR指令(IR_结构体拷贝, 值寄存器, ret指针, 0, 0,
                                     查结构体大小(函数信息.返回结构体ID), 0));
                值寄存器 = ret指针;
                当 (表达式栈.大小() > 0) {
                    结果<空类型, 整32> 删栈r = 表达式栈.删除(表达式栈.大小() - 1);
                    如果 (!删栈r.正常) { 运行时错误(4); }
                }
            } 否则 如果 (n.子起点 < n.子终点) {
                值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                       指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
            }
            // P7b RAII：返回前析构本函数容器局部（DeleteObject 空安全——
            //   未执行声明路径槽=0 跳过；宿主 genClassDestructorCalls 同款语义）。
            //   2026-09-06 根治（T6 自举首踩）：返回结构体值时被返回变量跳过
            //   析构——所有权转移（值已浅拷入 retbuf 共享堆指针，析构局部=
            //   retbuf 悬垂，IR生成多文件 返回 程序IR 后 函数们.大小()=垃圾实测）
            //   2026-09-06 第二次根治（retown 探针）：返回**容器**（-> 映射<...>）
            //   同族——原仅 返回结构体值 设跳过名，返回容器标识符仍被析构=
            //   返回悬垂指针（接收方 .获取 崩）。泛化：末节点=标识符即设跳过名
            //   （非容器名不在 容器变量们，无副作用）
            整64 返回转移名ID = 0;
            如果 (n.子终点 > n.子起点) {
                节点 返回末转移 = 池.元素(n.子终点 - 1);
                如果 (返回末转移.类型 == 节点_标识符) {
                    返回转移名ID = 整64(返回末转移.文本);
                }
            }
            发射容器析构(函数信息, 指令, 寄存器计数, 局部槽, 返回转移名ID);
            IR追加(指令, 建IR指令(IR_返回, 值寄存器, 0, 0, 0, 返回类型码, 0));
            // 缺陷A根治：返回 后跳函数尾块（epilogue 唯一）——中途回退不再穿透
            发射跳转(函数信息, 函数信息.函数尾块);
            返回 真;
        } 否则 如果 (n.类型 == 节点_表达式语句) {
            // 表达式语句：求值（结果丢弃）。子区间为表达式节点。
            如果 (n.子起点 < n.子终点) {
                生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                            指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
            }
        } 否则 如果 (n.类型 == 节点_赋值) {
            // 赋值：文本=左值名（标识符）；文本=0 时 附加=左值表达式起点（解引用/成员左值）
            如果 (n.文本 != 0) {
                // 标识符左值：槽 <- 右值寄存器
                整64 目标槽 = 0;
                结果<整64, 整32> 找槽 = 局部槽.获取(整64(n.文本));
                如果 (找槽.正常) { 目标槽 = 找槽.值; }
                如果 (目标槽 == 0) {
                    结果<整64, 整32> 找参 = 参数槽.获取(整64(n.文本));
                    如果 (找参.正常) { 目标槽 = 找参.值; }
                }
                // 第18枚根治（2026-09-06，v2self 引用参数槽们 登记全 miss 根因）：
                //   结构体变量整体赋值 甲 = 乙——旧实现无条件走 生成表达式
                //   IR_加载/IR_存储 单槽 8 字节浅拷（24B 节点只拷 类型+文本 首
                //   槽，附加 等后续字段原值残留——宿主为整结构体字节拷贝，编译器
                //   分叉实锤）。对齐宿主/Rust POD Copy 语义：IR_结构体拷贝 整体
                //   拷贝（源/目标地址按 引用槽→装载槽内容（绑定对象地址）、其余
                //   →取槽地址 分流，与 生成左值地址 同约定）；非同型变量标识符
                //   形态 fail fast 诊断拒绝（绝不静默浅拷=错误产物）。
                整64 左类型ID = 解析标识符类型ID(整64(n.文本));
                如果 (查结构体大小(左类型ID) != 0) {
                    节点 右末 = 池.元素(整32(n.子终点 - 1));
                    如果 (右末.类型 != 节点_标识符) {
                        IR层诊断("结构体赋值右值须为同型变量标识符: " +
                                  驻留文本(整64(n.文本)));
                    } 否则 {
                        整64 右类型ID = 解析标识符类型ID(整64(右末.文本));
                        如果 (查结构体大小(右类型ID) != 查结构体大小(左类型ID)) {
                            IR层诊断("结构体赋值左右类型不同/右值非结构体: " +
                                      驻留文本(整64(n.文本)));
                        } 否则 {
                            整64 右槽 = 0;
                            结果<整64, 整32> 找右局部 = 局部槽.获取(整64(右末.文本));
                            如果 (找右局部.正常) { 右槽 = 找右局部.值; }
                            如果 (右槽 == 0) {
                                结果<整64, 整32> 找右参 = 参数槽.获取(整64(右末.文本));
                                如果 (找右参.正常) { 右槽 = 找右参.值; }
                            }
                            如果 (右槽 == 0) {
                                IR层诊断("结构体赋值右值未找到变量槽: " +
                                          驻留文本(整64(右末.文本)));
                            } 否则 {
                                整64 源地址 = 寄存器计数[0];
                                寄存器计数[0] = 寄存器计数[0] + 1;
                                如果 (槽是引用(右槽)) {
                                    IR追加(指令, 建IR指令(IR_加载, 右槽, 0, 0,
                                                         源地址, T_整64, 0));
                                } 否则 {
                                    IR追加(指令, 建IR指令(IR_取地址, 右槽, 0, 0,
                                                         源地址, T_整64, 0));
                                }
                                整64 目标地址 = 寄存器计数[0];
                                寄存器计数[0] = 寄存器计数[0] + 1;
                                如果 (槽是引用(目标槽)) {
                                    IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0,
                                                         目标地址, T_整64, 0));
                                } 否则 {
                                    IR追加(指令, 建IR指令(IR_取地址, 目标槽, 0, 0,
                                                         目标地址, T_整64, 0));
                                }
                                IR追加(指令, 建IR指令(IR_结构体拷贝, 源地址, 目标地址,
                                                     0, 0, 查结构体大小(左类型ID), 0));
                            }
                        }
                    }
                    // 清空表达式栈（结构体赋值不走 生成表达式——保持与分支出口
                    //   同构防御）
                    当 (表达式栈.大小() > 0) {
                        结果<空类型, 整32> 删栈构 = 表达式栈.删除(表达式栈.大小() - 1);
                        如果 (!删栈构.正常) { 运行时错误(4); }
                    }
                    位置++;
                    继续;
                }
                整64 值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                            指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
                // 静态槽赋值（2026-09-06 根治，缺陷零容忍）：目标非局部/参数时查
                //   静态序号表——命中则 IR_静态存储 写回 .data 槽。原实现此处仅认
                //   局部/参数槽，静态目标「目标槽==0」静默丢存储（探针 计数器 =
                //   计数器 + 阶乘(5) 打印恒 0 实证）——防御分支静默降级家族成员，
                //   与 发射自增自减 的静态读写对（②c C）同款设施补齐
                如果 (目标槽 == 0 && 值寄存器 != 0) {
                    整64 找静赋 = 查静态序号(整64(n.文本));
                    如果 (找静赋 >= 0) {
                        IR追加(指令, 建IR指令(IR_静态存储, 值寄存器, 0, 0, 0, T_整64, 找静赋));
                    }
                }
                如果 (值寄存器 != 0 && 目标槽 != 0) {                    如果 (槽是引用(目标槽)) {
                        // ②c D：引用参数赋值——Load 槽得调用方左值地址，指针写回
                        整64 地址reg = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 地址reg, T_整64, 0));
                        IR追加(指令, 建IR指令(IR_指针存储, 地址reg, 值寄存器, 0, 0, T_整64, 0));
                    } 否则 {
                        IR追加(指令, 建IR指令(IR_存储, 值寄存器, 0, 0, 0, 0, 目标槽));
                    }
                }
                // 清空表达式栈（右值 残留）
                当 (表达式栈.大小() > 0) {
                    结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1);
                    如果 (!删栈.正常) { 运行时错误(4); }
                }
            } 否则 {
                // 成员/解引用左值：手动生成左值地址（不走 生成表达式，避免成员取值）
                // ②b B5：成员左值按字段宽度存储（类型码入 指令.类型——旧固定 8 字节
                //   写越界清零相邻槽，126 段① OOM 根因；解引用左值保持默认 8 字节）
                整64 存储宽度 = T_整64;
                节点 左末 = 池.元素(n.子起点 - 1);
                如果 (左末.类型 == 节点_成员) {
                    存储宽度 = 取成员宽度码(池, n.子起点 - 1);
                } 否则 如果 (左末.类型 == 节点_下标) {
                    // ③ 第三波：下标左值写宽度=所指元素宽度（整32* p[0]=v 写 4 字节，
                    //   8 字节写越界踩相邻元素——同 B5 成员窄宽教训）
                    存储宽度 = 取下标元素宽度码(池, n.子起点 - 1);
                }
                整64 地址寄存器 = 生成左值地址(池, 整32(n.附加), n.子起点, 局部槽, 参数槽,
                                            指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
                整64 值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                           指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
                如果 (地址寄存器 != 0 && 值寄存器 != 0) {
                    IR追加(指令, 建IR指令(IR_指针存储, 地址寄存器, 值寄存器, 0, 0, 存储宽度, 0));
                }
                // 清空表达式栈（右值 残留）
                当 (表达式栈.大小() > 0) {
                    结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1);
                    如果 (!删栈.正常) { 运行时错误(4); }
                }
            }
        } 否则 如果 (n.类型 == 节点_自增) {
            // 自增：Load 槽 +1 -> Store（P6b 语句级）；②c D：引用参数经指针读写回；
            //   ③ 第六波：静态槽读写对——分支体抽入 发射自增自减（C1 自减对称共用）
            发射自增自减(指令, 整64(n.文本), 假, 局部槽, 参数槽, 寄存器计数);
        } 否则 如果 (n.类型 == 节点_自减) {
            // 簇③根治·自减全链 C1（2026-09-04 用户裁决）：与自增对称（IR_减 1）
            发射自增自减(指令, 整64(n.文本), 真, 局部槽, 参数槽, 寄存器计数);
        } 否则 如果 (n.类型 == 节点_块) {
            // ②b B4：裸块语句——递归生成（作用域基线/块出口析构 由 生成块 统一处理，
            //   块内容器/资源结构体局部 块结束即释放）
            生成块(池, 位置, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
        } 否则 如果 (n.类型 == 节点_如果语句) {
            布尔 如果终止 = 生成如果(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
            如果 (如果终止) { 返回 真; }
        } 否则 如果 (n.类型 == 节点_当语句) {
            布尔 当终止 = 生成当(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
            如果 (当终止) { 返回 真; }
        } 否则 如果 (n.类型 == 节点_中断语句) {
            // 中断：跳转到最近循环出口块（函数信息.循环出口块）
            如果 (函数信息.循环出口块 != 0) {
                发射跳转(函数信息, 函数信息.循环出口块);
                返回 真;   // 块终止：跳过本块剩余语句（不可达）
            }
        } 否则 如果 (n.类型 == 节点_继续语句) {
            // 继续：跳转到最近循环继续块
            如果 (函数信息.循环继续块 != 0) {
                发射跳转(函数信息, 函数信息.循环继续块);
                返回 真;   // 块终止：跳过本块剩余语句（不可达）
            }
        }
        位置++;
    }
    返回 假;
}

// ==================== 块遍历 ====================
// 生成一个块的语句 IR。返回 布尔=块是否已终止（缺陷A：终止感知）。
函数 生成块(向量<节点> 池, 整32 块节点,
            映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
            函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
            向量<整64>& 表达式栈, 整64 返回类型码) -> 布尔 {
    节点 块 = 池.元素(块节点);
    // 块级作用域析构（用户裁决项2）：入口记录 容器变量们 基线，出口对本块
    //   新增容器发 RAII 析构并截断列表——块结束即释放（安全目标：及时、
    //   作用域精确）；返回语句仍析构全部（跨块跳出兜底，晚析构无害）。
    //   嵌套块同名容器由语义层拒绝（预扫同名合槽，遮蔽会泄漏/双释——P7c 前不支持）。
    //   ②c B：含容器字段结构体局部同款（字段基线 截断）。
    整64 作用域基线 = 函数信息.容器变量们.大小();
    整64 字段作用域基线 = 函数信息.容器字段局部们.大小();
    布尔 已终止 = 生成语句(池, 块.子起点, 块.子终点, 局部槽, 参数槽, 函数信息,
                          寄存器计数, 槽计数, 表达式栈, 返回类型码);
    // 出口：析构本块新增容器（逆序——后声明先析构），并从列表截断。
    //   已终止（返回/中断/继续 已跳出）时不发射——控制流不可达，且 返回 已析构全部。
    如果 (!已终止) {
        块出口析构(函数信息, 局部槽, 寄存器计数, 作用域基线, 字段作用域基线);
    }
    返回 已终止;
}

// ==================== 控制流生成（P6b） ====================
// 生成 如果语句：条件寄存器 + 真块/假块 + 汇合块（标签随建随取）。
// 返回 布尔=两分支是否都已终止（缺陷A：终止分支不发汇合跳转——不可达）。
函数 生成如果(向量<节点> 池, 节点 如果节点,
              映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
              函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
              向量<整64>& 表达式栈, 整64 返回类型码) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    // 节点字段：文本=条件起点，子起点=条件终点，附加=真块索引，子终点=否则索引
    整64 条件寄存器 = 生成表达式(池, 整32(如果节点.文本), 整32(如果节点.子起点),
                                 局部槽, 参数槽, 指令, 寄存器计数, &函数信息.块计数,
                                 槽计数, 表达式栈);
    整64 真块 = 新块(函数信息);
    整64 假块 = 新块(函数信息);
    整64 汇合块 = 新块(函数信息);
    发射条件跳转(函数信息, 条件寄存器, 真块, 假块);
    // 真块
    切换块(函数信息, 真块);
    发射块标签(函数信息, 真块);
    布尔 真终止 = 生成块(池, 整32(如果节点.附加), 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
    如果 (!真终止) {
        发射跳转(函数信息, 汇合块);
    }
    // 假块（否则链）
    切换块(函数信息, 假块);
    发射块标签(函数信息, 假块);
    布尔 假终止 = 假;
    整64 否则索引 = 如果节点.子终点;
    如果 (否则索引 != 0) {
        节点 否则节点 = 池.元素(整32(否则索引));
        如果 (否则节点.类型 == 节点_如果语句) {
            // 否则 如果：递归生成（不额外发射跳转到汇合——递归内已处理）
            假终止 = 生成如果(池, 否则节点, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
        } 否则 {
            假终止 = 生成块(池, 整32(否则索引), 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
        }
    }
    如果 (!假终止) {
        发射跳转(函数信息, 汇合块);
    }
    // 汇合块
    切换块(函数信息, 汇合块);
    发射块标签(函数信息, 汇合块);
    返回 真终止 && 假终止;
}

// 生成 当语句：jmp 条件块 -> 条件表达式 -> 条件跳转 体/出口 -> 体 -> jmp 条件块
// 返回 布尔=假（循环出口恒可达——条件假路径；体终止只省略回边）
函数 生成当(向量<节点> 池, 节点 当节点,
            映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
            函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
            向量<整64>& 表达式栈, 整64 返回类型码) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    整64 条件块 = 新块(函数信息);
    整64 体块 = 新块(函数信息);
    整64 出口块 = 新块(函数信息);
    // 无条件跳入条件块
    发射跳转(函数信息, 条件块);
    // 条件块
    切换块(函数信息, 条件块);
    发射块标签(函数信息, 条件块);
    // 节点字段：文本=条件起点，附加=体块索引，子起点=条件终点
    整64 条件寄存器 = 生成表达式(池, 整32(当节点.文本), 整32(当节点.子起点),
                                 局部槽, 参数槽, 指令, 寄存器计数, &函数信息.块计数,
                                 槽计数, 表达式栈);
    发射条件跳转(函数信息, 条件寄存器, 体块, 出口块);
    // 体块：记录循环上下文（继续->条件块，中断->出口块）
    整64 旧出口 = 函数信息.循环出口块;
    整64 旧继续 = 函数信息.循环继续块;
    函数信息.循环出口块 = 出口块;
    函数信息.循环继续块 = 条件块;
    切换块(函数信息, 体块);
    发射块标签(函数信息, 体块);
    布尔 体终止 = 生成块(池, 整32(当节点.附加), 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
    函数信息.循环出口块 = 旧出口;
    函数信息.循环继续块 = 旧继续;
    如果 (!体终止) {
        发射跳转(函数信息, 条件块);
    }
    // 出口块
    切换块(函数信息, 出口块);
    发射块标签(函数信息, 出口块);
    返回 假;
}
