// CN 自举编译器 v2 · 生成语句（千行拆分子模块，2026-09-08 用户裁决阶段目录包）
// 职责：语句遍历（生成语句）+ 块遍历与控制流生成（生成块/生成如果/生成当）
//   ——自 IR生成.cn 机械搬移；寄存器/引用参数等权威表经 公开: 访问函数
//   （IR生成 主干）；模块路径=生成语句（新键基）。
导入 容器::向量;
导入 语法;       // Token/AST 节点池（原 导入 语法分析，目录包名）
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 IR生成;     // 控制流辅助/变量类型权威表（同包幂等）
导入 生成声明;    // 语句级变量声明分派（R3 拆分，同包）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）


// 生成 池[块起点, 块终点) 内语句的 IR。本阶段语句级支持 变量声明/返回/表达式语句/
//   赋值/自增/如果/当/中断/继续（P6b 控制流）。
// 缺陷A根治（2026-09-02）：返回 布尔=本块是否已终止（返回/中断/继续 后跳过
//   剩余语句——不可达代码不再发射，避免后续 返回 覆盖返回值/析构重复发射）。
函数 生成语句(向量<节点> 池, 整32 起点, 整32 终点,
              映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
              函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
              向量<整64>& 表达式栈, 整64 返回类型码) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    // 预扫描：收集本块内 控制流语句（如果/当）的体块节点索引——
    //   体语句节点在池中位于控制流语句节点之前（顺序追加），会被本块区间
    //   直接包含；若直接生成会造成「体语句在外层重复生成」。收集后遍历时跳过。
    向量<整64> 体块们 = 向量<整64>();
    // ②b B4：裸块语句（直接子语句的 节点_块）——内部语句同样先于块节点入池，
    //   须跳过其区间（块节点处经 生成块 递归，作用域基线/块出口析构在内处理）
    向量<整64> 裸块们 = 向量<整64>();
    扫描控制流体块(池, 起点, 终点, 体块们, 裸块们);
    // 357-a（D39）：三段式循环节点收集——前置段（init/cond/step/step包装，
    //   物理位置在循环节点之后）与体块由 生成循环 统一生成，主遍历跳过
    向量<整64> 循环节点们 = 向量<整64>();
    整32 扫循 = 起点;
    当 (扫循 < 终点) {
        如果 (池.元素(扫循).类型 == 节点_循环语句) {
            结果<空类型, 整32> 加循 = 循环节点们.追加(整64(扫循));
            如果 (!加循.正常) { 运行时错误(4); }
        }
        扫循++;
    }
    // 894-a（070·G-N 特性波3·61/97）：遍历语句节点收集——迭代对象区+体块均
    //   在遍历节点之前（解析层布局·循环语句同款），由 生成遍历 统一生成
    向量<整64> 遍历节点们 = 向量<整64>();
    整32 扫遍894 = 起点;
    当 (扫遍894 < 终点) {
        如果 (池.元素(扫遍894).类型 == 节点_遍历语句) {
            结果<空类型, 整32> 加遍 = 遍历节点们.追加(整64(扫遍894));
            如果 (!加遍.正常) { 运行时错误(4); }
        }
        扫遍894++;
    }
    整32 位置 = 起点;
    当 (位置 < 终点) {
        // 203（021 任务 203·宿主 IRGenerator::flushPendingArgCleanups 同构）：
        //   语句求值前快照表达式物化临时基线（帧局部）——语句收口按基线区间
        //   回缩释放。物化临时=容器方法返回值读出（元素() 返回 T 值语义）被
        //   字段链中间跳消费（表.元素(0).名）的独立槽副本：串字段副本不进任何
        //   调用实参弹出们（975 清理扫不到）·块出口名单视形态漏收——宿主语义
        //   =表达式尾确定性释放，语句粒度为其安全上界（赋值位接收不经登记
        //   路径·82-b 浅拷接管语义不受影响；跨语句引用中间物化不存在）。
        整64 语句物化基线203 = 表达式物化临时们.大小();
        // 跳过控制流语句的体块与裸块内部语句（预扫描已收集）
        整32 跳到 = 语句块跳过位置(池, 体块们, 位置);
        如果 (跳到 >= 0) {
            位置 = 跳到;
            继续;
        }
        如果 (在裸块区间(池, 裸块们, 位置)) {
            位置++;
            继续;
        }
        // 357-a：循环前置段跳过——前置段（init/cond/step·池连续布局）在
        //   循环节点**之前**（区间 [循环节点.文本, 循环索引)），由 生成循环
        //   统一生成；嵌套时取**最近前驱**循环节点（最后一个命中=最内层）；
        //   体块节点（位置==附加）同样跳过（生成块 由 生成循环 递归）
        如果 (循环节点们.大小() > 0) {
            整64 循i = 0;
            整64 跳目标 = -1;
            当 (循i < 循环节点们.大小()) {
                整64 循环索引 = 循环节点们.元素(循i);
                节点 循环节点 = 池.元素(整32(循环索引));
                如果 (整64(位置) >= 循环节点.文本 && 整64(位置) < 循环索引) {
                    跳目标 = 循环索引;   // 前置段 → 跳到循环节点（升序遍历=最后命中为最内层）
                }
                // 「位置==附加（体块节点）」已由上一判定天然覆盖（附加∈
                //   [文本, 循环索引)·含全空段场景 448 ⑤实证）——不得另跳
                //   循环索引+1（会跳过循环节点=生成循环不被派发）
                循i++;
            }
            如果 (跳目标 >= 0) {
                位置 = 整32(跳目标);
                继续;
            }
        }
        // 894-a：遍历前置区跳过（迭代对象区+体块 在遍历节点之前·最近前驱·
        //   循环跳过同款）
        如果 (遍历节点们.大小() > 0) {
            整64 遍i = 0;
            整64 遍跳目标 = -1;
            当 (遍i < 遍历节点们.大小()) {
                整64 遍历索引 = 遍历节点们.元素(遍i);
                节点 遍历节点q = 池.元素(整32(遍历索引));
                如果 (整64(位置) >= 整64(遍历节点q.文本) && 整64(位置) < 遍历索引) {
                    遍跳目标 = 遍历索引;
                }
                遍i++;
            }
            如果 (遍跳目标 >= 0) {
                位置 = 整32(遍跳目标);
                继续;
            }
        }
        节点 n = 池.元素(位置);
        如果 (n.类型 == 节点_变量声明) {
            生成变量声明(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈);
        } 否则 如果 (n.类型 == 节点_返回语句) {
            如果 (生成返回语句(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数,
                               表达式栈, 返回类型码)) {
                返回 真;
            }
        } 否则 如果 (n.类型 == 节点_表达式语句) {
            // 表达式语句：求值（结果丢弃）。子区间为表达式节点。
            如果 (n.子起点 < n.子终点) {
                生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                            指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
            }
        } 否则 如果 (n.类型 == 节点_赋值) {
            生成赋值语句(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈);
        } 否则 如果 (n.类型 == 节点_自增) {
            // 自增：Load 槽 +1 -> Store（P6b 语句级）；②c D：引用参数经指针读写回；
            //   ③ 第六波：静态槽读写对——分支体抽入 发射自增自减（C1 自减对称共用）
            发射自增自减(指令, 整64(n.文本), 假, 局部槽, 参数槽, 寄存器计数);
        } 否则 如果 (n.类型 == 节点_自减) {
            // 簇③根治·自减全链 C1（2026-09-04 用户裁决）：与自增对称（IR_减 1）
            发射自增自减(指令, 整64(n.文本), 真, 局部槽, 参数槽, 寄存器计数);
        } 否则 如果 (n.类型 == 节点_块) {
            // ②b B4：裸块语句——递归生成（作用域基线/块出口析构 由 生成块 统一处理，
            //   块内容器/资源结构体局部 块结束即释放）
            生成块(池, 位置, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
        } 否则 如果 (n.类型 == 节点_如果语句) {
            布尔 如果终止 = 生成如果(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
            如果 (如果终止) { 返回 真; }
        } 否则 如果 (n.类型 == 节点_当语句) {
            布尔 当终止 = 生成当(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
            如果 (当终止) { 返回 真; }
        } 否则 如果 (n.类型 == 节点_遍历语句) {
            生成遍历894(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
        } 否则 如果 (n.类型 == 节点_循环语句) {
            生成循环(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
        } 否则 如果 (n.类型 == 节点_选择语句) {
            // 413-a（D44 正体收口）：真选择语句（宿主 genSwitch 判断链同构）——
            //   出口块恒可达=不终止，无需返回值
            生成选择语句(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
        } 否则 如果 (n.类型 == 节点_中断语句) {
            // 376-a（D40）：**选择内 中断 优先**——跳出选择出口（C break 同款；
            //   选择体资源经 case 体块的块出口析构既有链处理）·循环出口其次
            如果 (函数信息.选择出口块 != 0) {
                发射跳转(函数信息, 函数信息.选择出口块);
                返回 真;
            }
            // 中断：跳出前 drop-on-jump（释放本轮循环体已声明资源），再跳最近
            //   循环出口块（73-a 方案A：宿主 72-a genJumpDestructFrom 同构）
            如果 (函数信息.循环出口块 != 0) {
                循环跳出析构(函数信息, 局部槽, 寄存器计数);
                发射跳转(函数信息, 函数信息.循环出口块);
                返回 真;   // 块终止：跳过本块剩余语句（不可达）
            }
        } 否则 如果 (n.类型 == 节点_继续语句) {
            // 继续：跳出前 drop-on-jump，再跳最近循环继续块（条件块）
            如果 (函数信息.循环继续块 != 0) {
                循环跳出析构(函数信息, 局部槽, 寄存器计数);
                发射跳转(函数信息, 函数信息.循环继续块);
                返回 真;   // 块终止：跳过本块剩余语句（不可达）
            }
        }
        // 203：语句收口——本语句表达式树登记的物化临时（字段链中间跳消费的
        //   容器方法返回独立槽副本）在此释放（free+槽清零幂等·见循环头注释）
        清理表达式物化临时(语句物化基线203, 指令, 寄存器计数);
        位置++;
    }
    返回 假;
}

// ==================== 语句分支辅助（R3 拆分，2026-09-08 自 生成语句 机械搬移） ====================

// 预扫描：收集本块内 控制流语句（如果/当）的体块节点索引——
//   体语句节点在池中位于控制流语句节点之前（顺序追加），会被本块区间
//   直接包含；若直接生成会造成「体语句在外层重复生成」。收集后遍历时跳过。
//   ②b B4：裸块语句（直接子语句的 节点_块）同收集（排除 如果/当/否则 的体块）。
函数 扫描控制流体块(向量<节点> 池, 整32 起点, 整32 终点,
                    向量<整64>& 体块们, 向量<整64>& 裸块们) {
    整32 扫 = 起点;
    当 (扫 < 终点) {
        节点 扫节点 = 池.元素(扫);
        如果 (扫节点.类型 == 节点_如果语句) {
            // 节点字段：附加=真块索引，子终点=否则索引
            结果<空类型, 整32> 加真 = 体块们.追加(整64(扫节点.附加));
            如果 (!加真.正常) { 运行时错误(4); }
            // 根治（2026-09-06，呈报① gdb/dbg 五层下钻闭环）：否则链须整链收集——
            //   原实现仅收集首层体块，「否则如果」的嵌套如果根未被跳过：主遍历
            //   遇内层根先整链生成一遍、外层 生成如果 递归再生成一遍=双重生成
            //   （chain 探针 4 层链实测 7 次生成如果而非 4 次、块重复执行——
            //   v2 IR 自源头坏、历史冒烟「exit=0+语义 0 错」假绿的真相）
            整64 链游 = 扫节点.子终点;
            当 (链游 != 0) {
                节点 链节 = 池.元素(整32(链游));
                如果 (链节.类型 == 节点_如果语句) {
                    结果<空类型, 整32> 加根 = 体块们.追加(链游);
                    如果 (!加根.正常) { 运行时错误(4); }
                    结果<空类型, 整32> 加体 = 体块们.追加(整64(链节.附加));
                    如果 (!加体.正常) { 运行时错误(4); }
                    链游 = 链节.子终点;
                } 否则 {
                    如果 (链节.类型 == 节点_块) {
                        结果<空类型, 整32> 加尾块 = 体块们.追加(链游);
                        如果 (!加尾块.正常) { 运行时错误(4); }
                    }
                    链游 = 0;
                }
            }
        } 否则 如果 (扫节点.类型 == 节点_当语句) {
            结果<空类型, 整32> 加当 = 体块们.追加(整64(扫节点.附加));
            如果 (!加当.正常) { 运行时错误(4); }
        } 否则 如果 (扫节点.类型 == 节点_选择语句) {
            // 413-a（D44 正体收口）：选择的情况体块同样纳入跳过集——体语句
            //   （含情况值表达式节点）位于情况标签之前、被本块区间直接包含，
            //   不跳过则在外层重复生成（case 体在入口块先行执行的实测乱象）。
            //   **类型过滤=节点_情况标签**（情况段含值表达式/体语句节点·同上）
            整64 况扫 = 整64(扫节点.子起点);
            当 (况扫 < 整64(扫节点.子终点)) {
                节点 况节点 = 池.元素(整32(况扫));
                如果 (况节点.类型 == 节点_情况标签) {
                    结果<空类型, 整32> 加况体 = 体块们.追加(整64(况节点.子起点));
                    如果 (!加况体.正常) { 运行时错误(4); }
                }
                况扫++;
            }
        } 否则 如果 (扫节点.类型 == 节点_块) {
            // 排除 如果/当/否则 的体块（体块们 已收集，生成如果/生成当 递归处理
            //   ——体块节点位置晚于控制流语句节点，此刻必已登记）
            布尔 是体块 = 假;
            整64 tb = 0;
            当 (tb < 体块们.大小()) {
                如果 (体块们.元素(tb) == 整64(扫)) { 是体块 = 真; }
                tb++;
            }
            如果 (!是体块) {
                结果<空类型, 整32> 加裸 = 裸块们.追加(整64(扫));
                如果 (!加裸.正常) { 运行时错误(4); }
            }
        }
        扫++;
    }
}

// 主循环体块跳过判定：位置落在某控制流体块（含 否则链根/体）→ 返回 跳块+1；
//   不跳 → 返回 -1（体块索引可为 0，故用 -1 哨兵）。
函数 语句块跳过位置(向量<节点> 池, 向量<整64> 体块们, 整32 位置) -> 整32 {
    整64 跳块 = -1;
    整64 b = 0;
    当 (b < 体块们.大小()) {
        整64 体块索引 = 体块们.元素(b);
        如果 (整64(位置) == 体块索引) {
            跳块 = 体块索引;
        } 否则 {
            节点 体块节点 = 池.元素(整32(体块索引));
            如果 (整64(位置) >= 整64(体块节点.子起点) && 整64(位置) < 体块索引) {
                跳块 = 体块索引;
            }
        }
        b++;
    }
    如果 (跳块 >= 0) {
        返回 整32(跳块 + 1);
    }
    返回 -1;
}

// ②b B4：位置是否落在某裸块内部（裸块内部语句先于块节点入池；
//   块节点处经 生成块 递归生成，此处跳过避免双生成）。
函数 在裸块区间(向量<节点> 池, 向量<整64> 裸块们, 整32 位置) -> 布尔 {
    整64 nb = 0;
    当 (nb < 裸块们.大小()) {
        整64 裸块索引 = 裸块们.元素(nb);
        节点 裸块节点 = 池.元素(整32(裸块索引));
        如果 (整64(位置) >= 裸块节点.子起点 && 整64(位置) < 裸块索引) {
            返回 真;
        }
        nb++;
    }
    返回 假;
}

// 返回语句 IR 生成。返回 真=块已终止（发射跳函数尾块——缺陷A 终止感知）。
不安全 函数 生成返回语句(向量<节点> 池, 节点 n,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈, 整64 返回类型码) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    整64 值寄存器 = 0;
    // 263①（021 任务 263·2026-10-07 深度机·探针 9263tmp_c 实证）：返回语句
    //   物化基线——主循环 203 语句收口对 返回语句 不达（生成语句 主循环
    //   返回语句分支直接 返回 真 早退），本语句表达式树登记的物化临时
    //   （如 返回 表.元素(0).号 的元素() 独立槽副本·整盒含串）无人回收=
    //   每调用泄漏 1 串堆分配（9263tmp_c 1000 轮活动分配数不回平实锤·
    //   宿主 85-a/flushPendingArgCleanups 返回位同形态绿）。快照=函数入口
    //   基线（前序语句已各自收口·此刻表只含本返回语句登记·见下方清理点注释）。
    整64 返回物化基线263 = 表达式物化临时们.大小();
    // 295-a（T32 对账轮·2026-09-17）：「主 返回 结果」退出码 wrapper 特判
    //   （宿主 246-a D17 同构）：源地址→联合载荷读 T_整32→IR_返回 T_整32。
    如果 (函数信息.名字 == 驻留("主") && 函数信息.返回结果名ID != 0 &&
         n.子起点 < n.子终点) {
        节点 返回末w = 池.元素(n.子终点 - 1);
        整64 源地址w = 0;
        整64 调用前深度w = 表达式栈.大小();
        如果 (返回末w.类型 == 节点_标识符 || 返回末w.类型 == 节点_成员 ||
             返回末w.类型 == 节点_解引用) {
            源地址w = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                    指令, 寄存器计数, &函数信息.块计数,
                                    槽计数, 表达式栈);
        } 否则 {
            源地址w = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                  指令, 寄存器计数, &函数信息.块计数,
                                  槽计数, 表达式栈);
            如果 (表达式栈.大小() > 调用前深度w) {
                源地址w = 表达式栈.元素(表达式栈.大小() - 1);
            }
            当 (表达式栈.大小() > 调用前深度w) {
                结果<空类型, 整32> 删栈w = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删栈w.正常) { 运行时错误(4); }
            }
        }
        字符串 结果名w = 字符串复制(驻留文本(函数信息.返回结果名ID));
        字符串 实参段w = 合成名首实参(结果名w);
        整64 值偏移w = 结果值偏移(段首(实参段w));
        整64 错偏移w = 结果值偏移(段首(段余(实参段w)));
        如果 (错偏移w > 值偏移w) { 值偏移w = 错偏移w; }
        整64 载荷地址w = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_字段地址, 源地址w, 0, 0, 载荷地址w, T_整64,
                             值偏移w));
        整64 出码w = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_指针加载, 载荷地址w, 0, 0, 出码w, T_整32, 0));
        IR追加(指令, 建IR指令(IR_返回, 出码w, 0, 0, 0, T_整32, 0));
        发射跳转(函数信息, 函数信息.函数尾块);
        返回 真;
    }
    // 71-a：结果/可选 返回与结构体返回同款 retbuf 路径（拷贝字节数分流）
    // 810（053）：128 位标量返回（返回128位!=0）同款 retbuf——16 字节双半拷
    // 087b：数组返回（返回数组字节!=0）同款 retbuf——按数组字节整块拷
    //   （宿主 ir_stmt structReturn&&isArray 跳窄化 Cast 同面——源=数组基址）
    布尔 返回结构体值 = (函数信息.返回结构体ID != 0 ||
                          函数信息.返回结果名ID != 0 ||
                          函数信息.返回128位 != 0 ||
                          函数信息.返回数组字节 != 0) && n.子起点 < n.子终点;
    // 194-a：本函数 171 行按「返回形态」提取为 3 个族子方法（纯搬运零行为
    //   变更——多重集核验先行于构建）：引用返回分支/结构体值分支/公共尾段。
    // 引用返回（2026-09-04 缺陷零容忍收口，宿主 P3-18 对齐）：返回语句
    //   发射被引用左值地址；非左值形态 IR 层诊断（语义层已白名单，防御双保险）
    如果 (函数信息.返回引用 == 1 && n.子起点 < n.子终点) {
        生成返回引用分支(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数,
                         槽计数, 表达式栈, 返回类型码);
    }
    如果 (返回结构体值) {
        生成返回结构体值分支(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数,
                             槽计数, 表达式栈, 值寄存器);
    } 否则 如果 (n.子起点 < n.子终点) {
        值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                               指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
        // 040（001 §5.8 甲案）：返回位函数名收口——工厂函数 `返回 加二;`
        //   （返回类型=函数指针·生成标识符赋值 :151 同款·原缺=负占位 -26
        //   直入 IR_返回·992 守卫中止实证）
        值寄存器 = 值位函数名收口480(值寄存器, 指令, 寄存器计数);
    }
    // 565 轮（T33 残余根治）：窄宽标量返回规范化——返回位 ABI 传 64 位值、调用
    //   方 8 字节直读（b2 探针：->整16 返回 60000 宿主 -5536/v2 60000）——按
    //   返回窄宽码（初始化签名与返回字段 从返回类型文本登记）规范化；0=非窄宽
    //   直通。结构体/结果/引用返回各分支不触（retbuf/地址语义另路）。
    如果 (函数信息.返回窄宽码 != 0) {
        值寄存器 = 窄宽值规范化(函数信息.返回窄宽码, 值寄存器, 指令, 寄存器计数);
    }
    // 263①：返回路径物化临时收口（快照=函数入口·见上方基线注释）——释放=
    //   free+槽清零幂等（与 975/203 双清安全）；物化临时=独立副本（1013 批八
    //   「物化临时独立拥有」）串字段释放不毁源；标量值已定格 值寄存器（窄宽
    //   规范化完毕）·结构体值已拷入 retbuf（返回结构体值分支完成后才达此处）。
    //   引用返回分支已自发射 IR_返回 跳尾块（本段对其=静态死代码·零运行时影响）。
    清理表达式物化临时(返回物化基线263, 指令, 寄存器计数);
    // 公共尾段：转移名ID/A2 字面量拥有化/容器析构/串释放/数组串释放/返回/跳尾块
    发射返回公共尾段(池, n, 函数信息, 指令, 寄存器计数, 局部槽,
                     值寄存器, 返回类型码, 表达式栈);
    返回 真;
    返回 假;   // 不可达防御（原函数尾部形态保留）
}

// ==================== 194-a 族子方法（原 生成返回语句 207~362 段） ====================

// 族①：引用返回分支（原 207~232 段）——发射被引用左值地址（rax=左值地址）+
//   析构/串释放/数组串释放 + 返回发射 + 跳函数尾块。
不安全 函数 生成返回引用分支(向量<节点> 池, 节点 n,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈, 整64 返回类型码) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    整64 值寄存器 = 0;
        值寄存器 = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                 指令, 寄存器计数, &函数信息.块计数,
                                 槽计数, 表达式栈);
        如果 (值寄存器 == 0) {
            IR层诊断("引用返回须返回左值（变量/成员/下标/解引用）: " +
                      驻留文本(整64(函数信息.名字)));
        }
        当 (表达式栈.大小() > 0) {
            结果<空类型, 整32> 删栈rv = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈rv.正常) { 运行时错误(4); }
        }
        发射容器析构(函数信息, 指令, 寄存器计数, 局部槽, 0);
        // plans/019 阶段4' 第二批：引用返回路径同样释放字符串（引用左值非拥有
        //   移出——跳过名 0=全释放）。71-b（2026-09-11）：恢复第六十七轮被
        //   二分禁用（注释残留）的调用——引用返回函数的拥有串局部出口释放，
        //   grep false&& 复审查不到注释式禁用（第七十轮清零行动漏网形态）
        发射字符串释放(函数信息, 指令, 寄存器计数, 局部槽, 0);
        // 98-a（C9）：字符串元素数组全量释放（返回路径；幂等：元素释放后清零，
        //   块出口已释放的槽空安全跳过）
        发射数组串释放全部(函数信息, 局部槽, 寄存器计数);

        IR追加(指令, 建IR指令(IR_返回, 值寄存器, 0, 0, 0, 返回类型码, 0));
        发射跳转(函数信息, 函数信息.函数尾块);
    返回;
}

// 族②：返回结构体值分支（原 234~317 段）——H6 裸「无」零初始化栈临时/
//   左值地址/表达式三形态 + retbuf 拷贝（85-a 借用来源深拷）+ 尾清栈。

不安全 函数 生成赋值语句(向量<节点> 池, 节点 n,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) {
    如果 (n.文本 != 0) {
        生成标识符赋值(池, n, 局部槽, 参数槽, 函数信息,
                       寄存器计数, 槽计数, 表达式栈);
        返回;
    }
    生成成员解引用赋值(池, n, 局部槽, 参数槽, 函数信息,
                       寄存器计数, 槽计数, 表达式栈);
}
