// CN 自举编译器 v2 · 生成语句（千行拆分子模块，2026-09-08 用户裁决阶段目录包）
// 职责：语句遍历（生成语句）+ 块遍历与控制流生成（生成块/生成如果/生成当）
//   ——自 IR生成.cn 机械搬移；寄存器/引用参数等权威表经 公开: 访问函数
//   （IR生成 主干）；模块路径=生成语句（新键基）。
导入 容器::向量;
导入 语法;       // Token/AST 节点池（原 导入 语法分析，目录包名）
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码（目录包名）
导入 IR生成;     // 控制流辅助/变量类型权威表（同包幂等）
导入 生成声明;    // 语句级变量声明分派（R3 拆分，同包）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）


// 生成 池[块起点, 块终点) 内语句的 IR。本阶段语句级支持 变量声明/返回/表达式语句/
//   赋值/自增/如果/当/中断/继续（P6b 控制流）。
// 缺陷A根治（2026-09-02）：返回 布尔=本块是否已终止（返回/中断/继续 后跳过
//   剩余语句——不可达代码不再发射，避免后续 返回 覆盖返回值/析构重复发射）。
函数 生成语句(向量<节点> 池, 整32 起点, 整32 终点,
              映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
              函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
              向量<整64>& 表达式栈, 整64 返回类型码) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    // 预扫描：收集本块内 控制流语句（如果/当）的体块节点索引——
    //   体语句节点在池中位于控制流语句节点之前（顺序追加），会被本块区间
    //   直接包含；若直接生成会造成「体语句在外层重复生成」。收集后遍历时跳过。
    向量<整64> 体块们 = 向量<整64>();
    // ②b B4：裸块语句（直接子语句的 节点_块）——内部语句同样先于块节点入池，
    //   须跳过其区间（块节点处经 生成块 递归，作用域基线/块出口析构在内处理）
    向量<整64> 裸块们 = 向量<整64>();
    扫描控制流体块(池, 起点, 终点, 体块们, 裸块们);
    // 357-a（D39）：三段式循环节点收集——前置段（init/cond/step/step包装，
    //   物理位置在循环节点之后）与体块由 生成循环 统一生成，主遍历跳过
    向量<整64> 循环节点们 = 向量<整64>();
    整32 扫循 = 起点;
    当 (扫循 < 终点) {
        如果 (池.元素(扫循).类型 == 节点_循环语句) {
            结果<空类型, 整32> 加循 = 循环节点们.追加(整64(扫循));
            如果 (!加循.正常) { 运行时错误(4); }
        }
        扫循++;
    }
    整32 位置 = 起点;
    当 (位置 < 终点) {
        // 跳过控制流语句的体块与裸块内部语句（预扫描已收集）
        整32 跳到 = 语句块跳过位置(池, 体块们, 位置);
        如果 (跳到 >= 0) {
            位置 = 跳到;
            继续;
        }
        如果 (在裸块区间(池, 裸块们, 位置)) {
            位置++;
            继续;
        }
        // 357-a：循环前置段跳过——前置段（init/cond/step·池连续布局）在
        //   循环节点**之前**（区间 [循环节点.文本, 循环索引)），由 生成循环
        //   统一生成；嵌套时取**最近前驱**循环节点（最后一个命中=最内层）；
        //   体块节点（位置==附加）同样跳过（生成块 由 生成循环 递归）
        如果 (循环节点们.大小() > 0) {
            整64 循i = 0;
            整64 跳目标 = -1;
            当 (循i < 循环节点们.大小()) {
                整64 循环索引 = 循环节点们.元素(循i);
                节点 循环节点 = 池.元素(整32(循环索引));
                如果 (整64(位置) >= 循环节点.文本 && 整64(位置) < 循环索引) {
                    跳目标 = 循环索引;   // 前置段 → 跳到循环节点（升序遍历=最后命中为最内层）
                }
                // 「位置==附加（体块节点）」已由上一判定天然覆盖（附加∈
                //   [文本, 循环索引)·含全空段场景 448 ⑤实证）——不得另跳
                //   循环索引+1（会跳过循环节点=生成循环不被派发）
                循i++;
            }
            如果 (跳目标 >= 0) {
                位置 = 整32(跳目标);
                继续;
            }
        }
        节点 n = 池.元素(位置);
        如果 (n.类型 == 节点_变量声明) {
            生成变量声明(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈);
        } 否则 如果 (n.类型 == 节点_返回语句) {
            如果 (生成返回语句(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数,
                               表达式栈, 返回类型码)) {
                返回 真;
            }
        } 否则 如果 (n.类型 == 节点_表达式语句) {
            // 表达式语句：求值（结果丢弃）。子区间为表达式节点。
            如果 (n.子起点 < n.子终点) {
                生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                            指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
            }
        } 否则 如果 (n.类型 == 节点_赋值) {
            生成赋值语句(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈);
        } 否则 如果 (n.类型 == 节点_自增) {
            // 自增：Load 槽 +1 -> Store（P6b 语句级）；②c D：引用参数经指针读写回；
            //   ③ 第六波：静态槽读写对——分支体抽入 发射自增自减（C1 自减对称共用）
            发射自增自减(指令, 整64(n.文本), 假, 局部槽, 参数槽, 寄存器计数);
        } 否则 如果 (n.类型 == 节点_自减) {
            // 簇③根治·自减全链 C1（2026-09-04 用户裁决）：与自增对称（IR_减 1）
            发射自增自减(指令, 整64(n.文本), 真, 局部槽, 参数槽, 寄存器计数);
        } 否则 如果 (n.类型 == 节点_块) {
            // ②b B4：裸块语句——递归生成（作用域基线/块出口析构 由 生成块 统一处理，
            //   块内容器/资源结构体局部 块结束即释放）
            生成块(池, 位置, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
        } 否则 如果 (n.类型 == 节点_如果语句) {
            布尔 如果终止 = 生成如果(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
            如果 (如果终止) { 返回 真; }
        } 否则 如果 (n.类型 == 节点_当语句) {
            布尔 当终止 = 生成当(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
            如果 (当终止) { 返回 真; }
        } 否则 如果 (n.类型 == 节点_循环语句) {
            生成循环(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
        } 否则 如果 (n.类型 == 节点_选择语句) {
            // 413-a（D44 正体收口）：真选择语句（宿主 genSwitch 判断链同构）——
            //   出口块恒可达=不终止，无需返回值
            生成选择语句(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
        } 否则 如果 (n.类型 == 节点_中断语句) {
            // 376-a（D40）：**选择内 中断 优先**——跳出选择出口（C break 同款；
            //   选择体资源经 case 体块的块出口析构既有链处理）·循环出口其次
            如果 (函数信息.选择出口块 != 0) {
                发射跳转(函数信息, 函数信息.选择出口块);
                返回 真;
            }
            // 中断：跳出前 drop-on-jump（释放本轮循环体已声明资源），再跳最近
            //   循环出口块（73-a 方案A：宿主 72-a genJumpDestructFrom 同构）
            如果 (函数信息.循环出口块 != 0) {
                循环跳出析构(函数信息, 局部槽, 寄存器计数);
                发射跳转(函数信息, 函数信息.循环出口块);
                返回 真;   // 块终止：跳过本块剩余语句（不可达）
            }
        } 否则 如果 (n.类型 == 节点_继续语句) {
            // 继续：跳出前 drop-on-jump，再跳最近循环继续块（条件块）
            如果 (函数信息.循环继续块 != 0) {
                循环跳出析构(函数信息, 局部槽, 寄存器计数);
                发射跳转(函数信息, 函数信息.循环继续块);
                返回 真;   // 块终止：跳过本块剩余语句（不可达）
            }
        }
        位置++;
    }
    返回 假;
}

// ==================== 语句分支辅助（R3 拆分，2026-09-08 自 生成语句 机械搬移） ====================

// 预扫描：收集本块内 控制流语句（如果/当）的体块节点索引——
//   体语句节点在池中位于控制流语句节点之前（顺序追加），会被本块区间
//   直接包含；若直接生成会造成「体语句在外层重复生成」。收集后遍历时跳过。
//   ②b B4：裸块语句（直接子语句的 节点_块）同收集（排除 如果/当/否则 的体块）。
函数 扫描控制流体块(向量<节点> 池, 整32 起点, 整32 终点,
                    向量<整64>& 体块们, 向量<整64>& 裸块们) {
    整32 扫 = 起点;
    当 (扫 < 终点) {
        节点 扫节点 = 池.元素(扫);
        如果 (扫节点.类型 == 节点_如果语句) {
            // 节点字段：附加=真块索引，子终点=否则索引
            结果<空类型, 整32> 加真 = 体块们.追加(整64(扫节点.附加));
            如果 (!加真.正常) { 运行时错误(4); }
            // 根治（2026-09-06，呈报① gdb/dbg 五层下钻闭环）：否则链须整链收集——
            //   原实现仅收集首层体块，「否则如果」的嵌套如果根未被跳过：主遍历
            //   遇内层根先整链生成一遍、外层 生成如果 递归再生成一遍=双重生成
            //   （chain 探针 4 层链实测 7 次生成如果而非 4 次、块重复执行——
            //   v2 IR 自源头坏、历史冒烟「exit=0+语义 0 错」假绿的真相）
            整64 链游 = 扫节点.子终点;
            当 (链游 != 0) {
                节点 链节 = 池.元素(整32(链游));
                如果 (链节.类型 == 节点_如果语句) {
                    结果<空类型, 整32> 加根 = 体块们.追加(链游);
                    如果 (!加根.正常) { 运行时错误(4); }
                    结果<空类型, 整32> 加体 = 体块们.追加(整64(链节.附加));
                    如果 (!加体.正常) { 运行时错误(4); }
                    链游 = 链节.子终点;
                } 否则 {
                    如果 (链节.类型 == 节点_块) {
                        结果<空类型, 整32> 加尾块 = 体块们.追加(链游);
                        如果 (!加尾块.正常) { 运行时错误(4); }
                    }
                    链游 = 0;
                }
            }
        } 否则 如果 (扫节点.类型 == 节点_当语句) {
            结果<空类型, 整32> 加当 = 体块们.追加(整64(扫节点.附加));
            如果 (!加当.正常) { 运行时错误(4); }
        } 否则 如果 (扫节点.类型 == 节点_选择语句) {
            // 413-a（D44 正体收口）：选择的情况体块同样纳入跳过集——体语句
            //   （含情况值表达式节点）位于情况标签之前、被本块区间直接包含，
            //   不跳过则在外层重复生成（case 体在入口块先行执行的实测乱象）。
            //   **类型过滤=节点_情况标签**（情况段含值表达式/体语句节点·同上）
            整64 况扫 = 整64(扫节点.子起点);
            当 (况扫 < 整64(扫节点.子终点)) {
                节点 况节点 = 池.元素(整32(况扫));
                如果 (况节点.类型 == 节点_情况标签) {
                    结果<空类型, 整32> 加况体 = 体块们.追加(整64(况节点.子起点));
                    如果 (!加况体.正常) { 运行时错误(4); }
                }
                况扫++;
            }
        } 否则 如果 (扫节点.类型 == 节点_块) {
            // 排除 如果/当/否则 的体块（体块们 已收集，生成如果/生成当 递归处理
            //   ——体块节点位置晚于控制流语句节点，此刻必已登记）
            布尔 是体块 = 假;
            整64 tb = 0;
            当 (tb < 体块们.大小()) {
                如果 (体块们.元素(tb) == 整64(扫)) { 是体块 = 真; }
                tb++;
            }
            如果 (!是体块) {
                结果<空类型, 整32> 加裸 = 裸块们.追加(整64(扫));
                如果 (!加裸.正常) { 运行时错误(4); }
            }
        }
        扫++;
    }
}

// 主循环体块跳过判定：位置落在某控制流体块（含 否则链根/体）→ 返回 跳块+1；
//   不跳 → 返回 -1（体块索引可为 0，故用 -1 哨兵）。
函数 语句块跳过位置(向量<节点> 池, 向量<整64> 体块们, 整32 位置) -> 整32 {
    整64 跳块 = -1;
    整64 b = 0;
    当 (b < 体块们.大小()) {
        整64 体块索引 = 体块们.元素(b);
        如果 (整64(位置) == 体块索引) {
            跳块 = 体块索引;
        } 否则 {
            节点 体块节点 = 池.元素(整32(体块索引));
            如果 (整64(位置) >= 整64(体块节点.子起点) && 整64(位置) < 体块索引) {
                跳块 = 体块索引;
            }
        }
        b++;
    }
    如果 (跳块 >= 0) {
        返回 整32(跳块 + 1);
    }
    返回 -1;
}

// ②b B4：位置是否落在某裸块内部（裸块内部语句先于块节点入池；
//   块节点处经 生成块 递归生成，此处跳过避免双生成）。
函数 在裸块区间(向量<节点> 池, 向量<整64> 裸块们, 整32 位置) -> 布尔 {
    整64 nb = 0;
    当 (nb < 裸块们.大小()) {
        整64 裸块索引 = 裸块们.元素(nb);
        节点 裸块节点 = 池.元素(整32(裸块索引));
        如果 (整64(位置) >= 裸块节点.子起点 && 整64(位置) < 裸块索引) {
            返回 真;
        }
        nb++;
    }
    返回 假;
}

// 返回语句 IR 生成。返回 真=块已终止（发射跳函数尾块——缺陷A 终止感知）。
不安全 函数 生成返回语句(向量<节点> 池, 节点 n,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈, 整64 返回类型码) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    整64 值寄存器 = 0;
    // 295-a（T32 对账轮·2026-09-17）：「主 返回 结果」退出码 wrapper 特判
    //   （宿主 246-a D17 同构）：源地址→联合载荷读 T_整32→IR_返回 T_整32。
    如果 (函数信息.名字 == 驻留("主") && 函数信息.返回结果名ID != 0 &&
         n.子起点 < n.子终点) {
        节点 返回末w = 池.元素(n.子终点 - 1);
        整64 源地址w = 0;
        整64 调用前深度w = 表达式栈.大小();
        如果 (返回末w.类型 == 节点_标识符 || 返回末w.类型 == 节点_成员 ||
             返回末w.类型 == 节点_解引用) {
            源地址w = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                    指令, 寄存器计数, &函数信息.块计数,
                                    槽计数, 表达式栈);
        } 否则 {
            源地址w = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                  指令, 寄存器计数, &函数信息.块计数,
                                  槽计数, 表达式栈);
            如果 (表达式栈.大小() > 调用前深度w) {
                源地址w = 表达式栈.元素(表达式栈.大小() - 1);
            }
            当 (表达式栈.大小() > 调用前深度w) {
                结果<空类型, 整32> 删栈w = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删栈w.正常) { 运行时错误(4); }
            }
        }
        字符串 结果名w = 字符串复制(驻留文本(函数信息.返回结果名ID));
        字符串 实参段w = 合成名首实参(结果名w);
        整64 值偏移w = 结果值偏移(段首(实参段w));
        整64 错偏移w = 结果值偏移(段首(段余(实参段w)));
        如果 (错偏移w > 值偏移w) { 值偏移w = 错偏移w; }
        整64 载荷地址w = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_字段地址, 源地址w, 0, 0, 载荷地址w, T_整64,
                             值偏移w));
        整64 出码w = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_指针加载, 载荷地址w, 0, 0, 出码w, T_整32, 0));
        IR追加(指令, 建IR指令(IR_返回, 出码w, 0, 0, 0, T_整32, 0));
        发射跳转(函数信息, 函数信息.函数尾块);
        返回 真;
    }
    // 71-a：结果/可选 返回与结构体返回同款 retbuf 路径（拷贝字节数分流）
    布尔 返回结构体值 = (函数信息.返回结构体ID != 0 ||
                          函数信息.返回结果名ID != 0) && n.子起点 < n.子终点;
    // 194-a：本函数 171 行按「返回形态」提取为 3 个族子方法（纯搬运零行为
    //   变更——多重集核验先行于构建）：引用返回分支/结构体值分支/公共尾段。
    // 引用返回（2026-09-04 缺陷零容忍收口，宿主 P3-18 对齐）：返回语句
    //   发射被引用左值地址；非左值形态 IR 层诊断（语义层已白名单，防御双保险）
    如果 (函数信息.返回引用 == 1 && n.子起点 < n.子终点) {
        生成返回引用分支(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数,
                         槽计数, 表达式栈, 返回类型码);
    }
    如果 (返回结构体值) {
        生成返回结构体值分支(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数,
                             槽计数, 表达式栈, 值寄存器);
    } 否则 如果 (n.子起点 < n.子终点) {
        值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                               指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
    }
    // 565 轮（T33 残余根治）：窄宽标量返回规范化——返回位 ABI 传 64 位值、调用
    //   方 8 字节直读（b2 探针：->整16 返回 60000 宿主 -5536/v2 60000）——按
    //   返回窄宽码（初始化签名与返回字段 从返回类型文本登记）规范化；0=非窄宽
    //   直通。结构体/结果/引用返回各分支不触（retbuf/地址语义另路）。
    如果 (函数信息.返回窄宽码 != 0) {
        值寄存器 = 窄宽值规范化(函数信息.返回窄宽码, 值寄存器, 指令, 寄存器计数);
    }
    // 公共尾段：转移名ID/A2 字面量拥有化/容器析构/串释放/数组串释放/返回/跳尾块
    发射返回公共尾段(池, n, 函数信息, 指令, 寄存器计数, 局部槽,
                     值寄存器, 返回类型码, 表达式栈);
    返回 真;
    返回 假;   // 不可达防御（原函数尾部形态保留）
}

// ==================== 194-a 族子方法（原 生成返回语句 207~362 段） ====================

// 族①：引用返回分支（原 207~232 段）——发射被引用左值地址（rax=左值地址）+
//   析构/串释放/数组串释放 + 返回发射 + 跳函数尾块。
不安全 函数 生成返回引用分支(向量<节点> 池, 节点 n,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈, 整64 返回类型码) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    整64 值寄存器 = 0;
        值寄存器 = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                 指令, 寄存器计数, &函数信息.块计数,
                                 槽计数, 表达式栈);
        如果 (值寄存器 == 0) {
            IR层诊断("引用返回须返回左值（变量/成员/下标/解引用）: " +
                      驻留文本(整64(函数信息.名字)));
        }
        当 (表达式栈.大小() > 0) {
            结果<空类型, 整32> 删栈rv = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈rv.正常) { 运行时错误(4); }
        }
        发射容器析构(函数信息, 指令, 寄存器计数, 局部槽, 0);
        // plans/019 阶段4' 第二批：引用返回路径同样释放字符串（引用左值非拥有
        //   移出——跳过名 0=全释放）。71-b（2026-09-11）：恢复第六十七轮被
        //   二分禁用（注释残留）的调用——引用返回函数的拥有串局部出口释放，
        //   grep false&& 复审查不到注释式禁用（第七十轮清零行动漏网形态）
        发射字符串释放(函数信息, 指令, 寄存器计数, 局部槽, 0);
        // 98-a（C9）：字符串元素数组全量释放（返回路径；幂等：元素释放后清零，
        //   块出口已释放的槽空安全跳过）
        发射数组串释放全部(函数信息, 局部槽, 寄存器计数);

        IR追加(指令, 建IR指令(IR_返回, 值寄存器, 0, 0, 0, 返回类型码, 0));
        发射跳转(函数信息, 函数信息.函数尾块);
    返回;
}

// 族②：返回结构体值分支（原 234~317 段）——H6 裸「无」零初始化栈临时/
//   左值地址/表达式三形态 + retbuf 拷贝（85-a 借用来源深拷）+ 尾清栈。
不安全 函数 生成返回结构体值分支(向量<节点> 池, 节点 n,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈, 整64& 值寄存器) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
        // 用户函数返回结构体（2026-09-04，E2E 148）：宿主 ABI——值拷入
        //   调用方传入的 retbuf（槽 1 指针）、rax=retbuf。源地址两形态：
        //   末节点=标识符/成员/解引用 -> 生成左值地址（本函数局部基槽）；
        //   末节点=调用 -> 生成表达式（被调 retbuf 地址即结构体地址）
        节点 返回末 = 池.元素(n.子终点 - 1);
        // 107-a（2026-09-13 第一百零七轮，H6 根治）：返回位裸「无」——语法层把
        //   关键字「无」解析为 节点_整数字面量（值 0），原走下方「生成表达式」
        //   路径把 0 当结构体地址 -> IR_结构体拷贝 自 NULL 读 16 字节 -> 段错误
        //   （探针 d5f/d5j 双侧分叉：宿主 ✓ / v2 rc=139；最小复现 d5f_min）。
        //   宿主语义=结果/可选 空值零值结构体物化 -> 零初始化栈临时 + 公共尾段
        //   拷入 retbuf（复用数组局部零初始化设施）。无歧义实证：合法源码中
        //   结果/可选 返回位不出现裸整数（宿主对 `返回 0` 报「无法隐式转换」）。
        如果 (返回末.类型 == 节点_整数字面量) {
            整64 拷贝字节H6 = 查结构体大小(函数信息.返回结构体ID);
            如果 (函数信息.返回结果名ID != 0) {
                拷贝字节H6 = 结果大小(字符串复制(
                    驻留文本(函数信息.返回结果名ID)));
            }
            整64 槽数H6 = (拷贝字节H6 + 7) / 8;
            整64 槽起H6 = 槽计数[0];
            槽计数[0] = 槽计数[0] + 槽数H6;
            整64 zH6 = 0;
            当 (zH6 < 槽数H6) {
                IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽起H6 + zH6));
                zH6++;
            }
            整64 零寄存器H6 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("0")), 0, 0,
                                 零寄存器H6, T_整64, 0));
            zH6 = 0;
            当 (zH6 < 槽数H6) {
                IR追加(指令, 建IR指令(IR_存储, 零寄存器H6, 0, 0, 0, 0,
                                     槽起H6 + zH6));
                zH6++;
            }
            值寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_取地址, 槽起H6 + 槽数H6 - 1, 0, 0,
                                 值寄存器, T_整64, 0));
        } 否则 如果 (返回末.类型 == 节点_标识符 || 返回末.类型 == 节点_成员 ||
             返回末.类型 == 节点_解引用) {
            值寄存器 = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                     指令, 寄存器计数, &函数信息.块计数,
                                     槽计数, 表达式栈);
        } 否则 {
            值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                   指令, 寄存器计数, &函数信息.块计数,
                                   槽计数, 表达式栈);
        }
        整64 ret指针 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_加载, 1, 0, 0, ret指针, T_整64, 0));
        // 71-a：返回拷贝字节数分流——结果/可选 返回用 结果大小（结构体表查不到
        //   合成名=0，防拷 0 字节假返回）
        整64 返回拷贝字节71 = 查结构体大小(函数信息.返回结构体ID);
        如果 (函数信息.返回结果名ID != 0) {
            返回拷贝字节71 = 结果大小(字符串复制(
                驻留文本(函数信息.返回结果名ID)));
        }
        // 85-a（2026-09-12 第八十五轮）：聚合返回位所有权保证——**借用来源**返回
        //   （按值形参=调用方 place 的浅拷副本 / 全局静态 / 成员 / 下标 / 解引用）
        //   时按位 memcpy 会把**别人的句柄**交给调用方（调用方各接收位一律按 owned
        //   处理：声明/赋值=浅拷接管、入容器=元素槽独立）→ 调用方释放其持有者后
        //   返回值字段悬垂（探针 P38/P40 两侧同现，打印乱码；数据正确性/安全级）。
        //   Rust 对照：`-> T` 必须有所有权，借用来源须 clone。修法=返回位深拷落堆
        //   （写入调用方 retbuf 后逐字段 __cn_str_copy——sret 就地构造，零额外
        //   memcpy）；拥有局部（移出）/调用返回/字面量保持原路径（零拷贝）。
        //   面：结果/可选 返回（返回结果名ID）不在面内——v2 结果/可选 值字段未登记
        //   资源字段（84-e 诚实边界：释放需联合体条件分支），故此处分派跳过。
        布尔 借用返回85 = 是借用来源返回(池, 函数信息, 返回末, 参数槽, 局部槽);
        // 748-a（T94 阶段二·055 波2a 的 v2 树镜像·052 甲副本语义）：容器.元素
        //   方法返回类实例（借用来源）时，浅拷 retbuf=与池共享内部数组指针——
        //   调用方「取回-设置-写回」场景 self 覆盖即毁源（740-a 实测段错误）。
        //   改=NewObject+拷贝构造 独立堆副本（Rust 返回 T 值语义·宿主波2a 同款
        //   ir_stmt.cpp visitReturnStmt）。
        // 754-a（001 波1·753-a 三重铁证定音 025 §2.146）：原「函数信息.名字 ==
        //   驻留("元素")」对单态化克隆体（名字=向量$映射$整64$符号$元素_J 全名）
        //   恒不命中＝分支自 748 集成起从未生效（asm 实证：元素 方法=rep movsb
        //   56B 浅拷 85-a 路径）。改=基名含「$元素」或全名「元素」判定。
        //   且命中时返回写收敛=**retbuf[0]=句柄**（8B·替代 56B 值物化——两代
        //   统一「类返回 retbuf[0]=句柄」ABI·753-a 波1 定稿；调用方容器接收按
        //   句柄消费＝749「retbuf 栈临时直存毁」根除·拷贝构造 T& 两跳契约成立）。
        字符串 名文本e = 字符串复制(驻留文本(函数信息.名字));
        布尔 是元素方法e = 字符串比较(名文本e, "元素");
        如果 (!是元素方法e) {
            整64 长e = 字符串长度(名文本e);
            整64 i542 = 0;
            当 (i542 + 7 <= 长e && !是元素方法e) {
                如果 (字符串比较(字符串子串(名文本e, 整32(i542), 7), "$元素")) {
                    是元素方法e = 真;
                }
                i542++;
            }
        }
        布尔 句柄返回748 = 假;
        如果 (是元素方法e && 函数信息.返回结构体ID != 0 &&
            查结构体大小(函数信息.返回结构体ID) > 0) {
            整64 对象字节e = 查结构体大小(函数信息.返回结构体ID);
            字符串 返回类名e = 字符串复制(驻留文本(函数信息.返回结构体ID));
            整64 新对象reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新对象reg, 对象字节e,
                                 函数信息.返回结构体ID));
            // this=位0（新对象）、源=位1（T& 按引用位传句柄=池内元素地址）
            IR追加(指令, 建IR指令(IR_调用实参, 新对象reg, 0, 0, 0, 0, 0));
            IR追加(指令, 建IR指令(IR_调用实参, 值寄存器, 0, 0, 0, 1, 0));
            IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                                 驻留(方法符号(返回类名e,
                                     合成名基名(返回类名e),
                                     返回类名e + "&"))));
            // retbuf[0]=新对象句柄（8B）——调用方按「源槽→壳→壳+off」两跳消费
            IR追加(指令, 建IR指令(IR_指针存储, ret指针, 新对象reg, 0, 0, T_整64, 0));
            值寄存器 = 新对象reg;
            句柄返回748 = 真;
        }
        如果 (句柄返回748) {
            // 返回值保持调用约定 rax=retbuf（sret 不变）——retbuf[0] 已承载句柄
            值寄存器 = ret指针;
        } 否则 如果 (借用返回85 && 函数信息.返回结构体ID != 0 &&
            资源字段数(函数信息.返回结构体ID) > 0) {
            发射结构体整体拷贝(函数信息, 寄存器计数, ret指针, 值寄存器,
                              函数信息.返回结构体ID, 真, 假);
        } 否则 {
            IR追加(指令, 建IR指令(IR_结构体拷贝, 值寄存器, ret指针, 0, 0,
                                 返回拷贝字节71, 0));
        }
        值寄存器 = ret指针;
        当 (表达式栈.大小() > 0) {
            结果<空类型, 整32> 删栈r = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈r.正常) { 运行时错误(4); }
        }
}

// 族③：返回公共尾段（原 322~362 段）——返回转移名ID 推导（P7b RAII 跳过名）/
//   A2 返回位字面量拥有化/容器析构/拥有串释放/数组串释放/返回发射/跳尾块。
//   值寄存器按值传入（A2 copy 落堆时换用 copy 寄存器——主流程后续不再使用）。
不安全 函数 发射返回公共尾段(向量<节点> 池, 节点 n, 函数IR& 函数信息,
                  向量<IR指令>& 指令, 整64* 寄存器计数, 映射<整64, 整64>& 局部槽,
                  整64 值寄存器, 整64 返回类型码, 向量<整64>& 表达式栈) -> 空类型 {
    // P7b RAII：返回前析构本函数容器局部（DeleteObject 空安全——
    //   未执行声明路径槽=0 跳过；宿主 genClassDestructorCalls 同款语义）。
    //   2026-09-06 根治（T6 自举首踩）：返回结构体值时被返回变量跳过
    //   析构——所有权转移（值已浅拷入 retbuf 共享堆指针，析构局部=
    //   retbuf 悬垂，IR生成多文件 返回 程序IR 后 函数们.大小()=垃圾实测）
    //   2026-09-06 第二次根治（retown 探针）：返回**容器**（-> 映射<...>）
    //   同族——原仅 返回结构体值 设跳过名，返回容器标识符仍被析构=
    //   返回悬垂指针（接收方 .获取 崩）。泛化：末节点=标识符即设跳过名
    //   （非容器名不在 容器变量们，无副作用）
    整64 返回转移名ID = 0;
    如果 (n.子终点 > n.子起点) {
        节点 返回末转移 = 池.元素(n.子终点 - 1);
        如果 (返回末转移.类型 == 节点_标识符) {
            返回转移名ID = 整64(返回末转移.文本);
        }
    }
    // plans/019 阶段4' A2（2026-09-11 方案甲）：返回位字面量拥有化——返回类型
    //   字符串=拥有契约（调用方登记 RAII 释放），字面量驻只读段须 copy 落堆
    //   （否则调用方 free 只读段指针=崩溃）。拥有变量=槽值直传（移出）。
    如果 (n.子终点 > n.子起点 && 返回类型码 == T_字符串) {
        节点 返回末A2t = 池.元素(n.子终点 - 1);
        如果 (返回末A2t.类型 == 节点_字符串字面量) {
            整64 copy返回寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_调用实参, 值寄存器, 0, 0, 0, 0, 0));
            IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, copy返回寄存器, 0,
                                 驻留("__cn_str_copy")));
            值寄存器 = copy返回寄存器;
        }
    }
    发射容器析构(函数信息, 指令, 寄存器计数, 局部槽, 返回转移名ID);
    // plans/019 阶段4' 第二批：拥有型字符串 RAII（跳过名=返回标识符移出）
    发射字符串释放(函数信息, 指令, 寄存器计数, 局部槽, 返回转移名ID);
    // 98-a（C9）：字符串元素数组全量释放（普通返回路径；幂等：元素释放后清零，
    //   块出口已释放的槽空安全跳过）——首版只加在引用返回分支=普通返回漏网
    //   （mem6 探针「后=2」实证：造尾函数返回未释放）
    发射数组串释放全部(函数信息, 局部槽, 寄存器计数);
    IR追加(指令, 建IR指令(IR_返回, 值寄存器, 0, 0, 0, 返回类型码, 0));
    // 缺陷A根治：返回 后跳函数尾块（epilogue 唯一）——中途回退不再穿透
    发射跳转(函数信息, 函数信息.函数尾块);
}

// 87-a（2026-09-12 第八十七轮）：静态字符串赋值归一化（drop 旧 + 来源分级复制）。
//   与 79-a 成员字符串字段位同款分级：字面量=驻留直存（零分配）；白名单八函数/
//   返回字符串契约调用=拥有接管（零拷贝）；其余（标识符/成员/二元/借用返回）
//   =__cn_str_copy 落堆（字段独立副本，源保持拥有照常释放）。顺序：先复制后
//   drop（自赋值 s = s 安全——新值先独立于旧值内存）。
//   静态槽长期存活**恒拥有**（局部按块出口 drop；静态无出口）——赋值必须当场
//   drop 旧值，否则每次赋值泄漏（原实现直存句柄：泄漏 + 借用来源共享悬垂）。
不安全 函数 归一化静态串赋值(向量<节点> 池, 节点 n, 整64 值寄存器, 整64 静序,
                       函数IR& 函数信息, 整64* 寄存器计数) -> 整64 {
    向量<IR指令>& 指令 = 函数信息.指令;
    节点 右末z = 池.元素(整32(n.子终点 - 1));
    布尔 需复制z = 真;
    如果 (右末z.类型 == 节点_字符串字面量) { 需复制z = 假; }
    否则 如果 (右末z.类型 == 节点_调用 && 右末z.子起点 > 0) {
        节点 被调z = 池.元素(整32(右末z.子起点));
        如果 (被调z.类型 == 节点_标识符) {
            整64 被调名z = 整64(被调z.文本);
            布尔 白名单z = 被调名z == 驻留("字符串复制") ||
                          被调名z == 驻留("字符串连接") ||
                          被调名z == 驻留("字符串拼接") ||
                          被调名z == 驻留("字符串子串") ||
                          被调名z == 驻留("字符串大写") ||
                          被调名z == 驻留("字符串小写") ||
                          被调名z == 驻留("字符串修剪") ||
                          被调名z == 驻留("字符串反转");
            如果 (!白名单z && 查函数返回回退(被调名z) == 驻留("字符串")) {
                白名单z = 真;   // A2 契约：签名即契约
            }
            需复制z = !白名单z;
        }
    }
    整64 新值z = 值寄存器;
    如果 (需复制z) { 新值z = 发射字符串复制调用(指令, 寄存器计数, 值寄存器); }
    // drop 旧值（读取旧句柄 → __cn_str_free；空句柄/驻留常量空安全跳过）
    整64 旧regz = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_静态加载, 0, 0, 0, 旧regz, T_字符串, 静序));
    IR追加(指令, 建IR指令(IR_调用实参, 旧regz, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0, 驻留("__cn_str_free")));
    // 写新值
    IR追加(指令, 建IR指令(IR_静态存储, 新值z, 0, 0, 0, T_字符串, 静序));
    返回 新值z;
}

// 赋值语句：文本=左值名（标识符槽/静态槽）；文本=0 时 附加=左值表达式起点
//   （解引用/成员/下标左值，按字段宽度存储）。结构体整体赋值经
//   生成结构体整体赋值（第18枚 POD Copy 语义）先行拦截。
// D1 行数整改 172-a：本体按族拆入 生成语句赋值.cn（生成标识符赋值 /
//   生成成员解引用赋值 + 三发射面族）——本函数收缩为分派骨架（纯重构零
//   行为变更）。
不安全 函数 生成赋值语句(向量<节点> 池, 节点 n,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) {
    如果 (n.文本 != 0) {
        生成标识符赋值(池, n, 局部槽, 参数槽, 函数信息,
                       寄存器计数, 槽计数, 表达式栈);
        返回;
    }
    生成成员解引用赋值(池, n, 局部槽, 参数槽, 函数信息,
                       寄存器计数, 槽计数, 表达式栈);
}



// ==================== 块遍历 ====================
// 生成一个块的语句 IR。返回 布尔=块是否已终止（缺陷A：终止感知）。
函数 生成块(向量<节点> 池, 整32 块节点,
            映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
            函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
            向量<整64>& 表达式栈, 整64 返回类型码) -> 布尔 {
    节点 块 = 池.元素(块节点);
    // 块级作用域析构（用户裁决项2）：入口记录 容器变量们 基线，出口对本块
    //   新增容器发 RAII 析构并截断列表——块结束即释放（安全目标：及时、
    //   作用域精确）；返回语句仍析构全部（跨块跳出兜底，晚析构无害）。
    //   嵌套块同名容器由语义层拒绝（预扫同名合槽，遮蔽会泄漏/双释——P7c 前不支持）。
    //   ②c B：含容器字段结构体局部同款（字段基线 截断）。
    整64 作用域基线 = 函数信息.容器变量们.大小();
    整64 字段作用域基线 = 函数信息.资源字段局部们.大小();
    整64 字符串基线 = 函数信息.字符串变量们.大小();
    整64 数组串基线 = 函数信息.字符串数组变量们.大小();   // 98-a（C9）同款基线
    // 396-a（D36）：块新名清单入栈（352-b 设计）——分配点登记本块新名，
    //   出口（析构后）弹栈逐名删除局部槽绑定=出块恢复外层绑定（遮蔽语义）
    块清单入栈();
    布尔 已终止 = 生成语句(池, 块.子起点, 块.子终点, 局部槽, 参数槽, 函数信息,
                          寄存器计数, 槽计数, 表达式栈, 返回类型码);
    // 出口：析构本块新增容器（逆序——后声明先析构），并从列表截断。
    //   已终止（返回/中断/继续 已跳出）时不发射——控制流不可达，且 返回 已析构全部。
    //   396-a：清单出栈恢复在析构之后（析构用槽）——已终止时也恢复（栈平衡）。
    如果 (!已终止) {
        块出口析构(函数信息, 局部槽, 寄存器计数, 作用域基线, 字段作用域基线,
                  字符串基线, 数组串基线, 真);
    }
    块清单出栈恢复(局部槽);
    返回 已终止;
}

// ==================== 控制流生成（P6b） ====================
// 生成 如果语句：条件寄存器 + 真块/假块 + 汇合块（标签随建随取）。
// 返回 布尔=两分支是否都已终止（缺陷A：终止分支不发汇合跳转——不可达）。
函数 生成如果(向量<节点> 池, 节点 如果节点,
              映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
              函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
              向量<整64>& 表达式栈, 整64 返回类型码) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;    // 节点字段：文本=条件起点，子起点=条件终点，附加=真块索引，子终点=否则索引
    整64 条件寄存器 = 生成表达式(池, 整32(如果节点.文本), 整32(如果节点.子起点),
                                 局部槽, 参数槽, 指令, 寄存器计数, &函数信息.块计数,
                                 槽计数, 表达式栈);
    整64 真块 = 新块(函数信息);
    整64 假块 = 新块(函数信息);
    整64 汇合块 = 新块(函数信息);
    发射条件跳转(函数信息, 条件寄存器, 真块, 假块);
    // 真块
    切换块(函数信息, 真块);
    发射块标签(函数信息, 真块);
    布尔 真终止 = 生成块(池, 整32(如果节点.附加), 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
    如果 (!真终止) {
        发射跳转(函数信息, 汇合块);
    }
    // 假块（否则链）
    切换块(函数信息, 假块);
    发射块标签(函数信息, 假块);
    布尔 假终止 = 假;
    整64 否则索引 = 如果节点.子终点;
    如果 (否则索引 != 0) {
        节点 否则节点 = 池.元素(整32(否则索引));
        如果 (否则节点.类型 == 节点_如果语句) {
            // 否则 如果：递归生成（不额外发射跳转到汇合——递归内已处理）
            假终止 = 生成如果(池, 否则节点, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
        } 否则 {
            假终止 = 生成块(池, 整32(否则索引), 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
        }
    }
    如果 (!假终止) {
        发射跳转(函数信息, 汇合块);
    }
    // 汇合块
    切换块(函数信息, 汇合块);
    发射块标签(函数信息, 汇合块);
    返回 真终止 && 假终止;
}

// 生成 当语句：jmp 条件块 -> 条件表达式 -> 条件跳转 体/出口 -> 体 -> jmp 条件块
// 返回 布尔=假（循环出口恒可达——条件假路径；体终止只省略回边）
函数 生成当(向量<节点> 池, 节点 当节点,
            映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
            函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
            向量<整64>& 表达式栈, 整64 返回类型码) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    整64 条件块 = 新块(函数信息);
    整64 体块 = 新块(函数信息);
    整64 出口块 = 新块(函数信息);
    // 无条件跳入条件块
    发射跳转(函数信息, 条件块);
    // 条件块
    切换块(函数信息, 条件块);
    发射块标签(函数信息, 条件块);    // 节点字段：文本=条件起点，附加=体块索引，子起点=条件终点
    整64 条件寄存器 = 生成表达式(池, 整32(当节点.文本), 整32(当节点.子起点),
                                 局部槽, 参数槽, 指令, 寄存器计数, &函数信息.块计数,
                                 槽计数, 表达式栈);
    发射条件跳转(函数信息, 条件寄存器, 体块, 出口块);
    // 体块：记录循环上下文（继续->条件块，中断->出口块）
    整64 旧出口 = 函数信息.循环出口块;
    整64 旧继续 = 函数信息.循环继续块;
    函数信息.循环出口块 = 出口块;
    函数信息.循环继续块 = 条件块;
    // 413-a（D44）：循环内中断绑定**最近**的选择或循环——暂存清 0 选择出口
    //   （恢复在体块生成后）=当体内 中断 跳循环出口（外层选择不被误跳）
    整64 旧选择出口D = 函数信息.选择出口块;
    函数信息.选择出口块 = 0;
    // 73-a（2026-09-11 方案A 用户裁决）：循环体基线三枚——中断/继续
    //   drop-on-jump 的释放范围起点（进入体前名单大小；嵌套循环保存/恢复，
    //   内层跳出只释放内层已声明资源）
    整64 旧串基线 = 函数信息.循环串基线;
    整64 旧容基线 = 函数信息.循环容基线;
    整64 旧字基线 = 函数信息.循环字段基线;
    整64 旧数组串基线 = 函数信息.循环数组串基线;   // 98-a（C9）
    函数信息.循环串基线 = 函数信息.字符串变量们.大小();
    函数信息.循环容基线 = 函数信息.容器变量们.大小();
    函数信息.循环字段基线 = 函数信息.资源字段局部们.大小();
    函数信息.循环数组串基线 = 函数信息.字符串数组变量们.大小();
    切换块(函数信息, 体块);
    发射块标签(函数信息, 体块);
    布尔 体终止 = 生成块(池, 整32(当节点.附加), 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
    函数信息.循环出口块 = 旧出口;
    函数信息.循环继续块 = 旧继续;
    函数信息.选择出口块 = 旧选择出口D;
    函数信息.循环串基线 = 旧串基线;
    函数信息.循环容基线 = 旧容基线;
    函数信息.循环字段基线 = 旧字基线;
    函数信息.循环数组串基线 = 旧数组串基线;   // 98-a（C9）
    如果 (!体终止) {
        发射跳转(函数信息, 条件块);
    }
    // 出口块
    切换块(函数信息, 出口块);
    发射块标签(函数信息, 出口块);
    返回 假;
}

// 413-a（D44 正体收口）：选择语句生成——宿主 genSwitch 判断链模型同构
//   （ir_stmt.cpp:332：选择值求值一次槽化 → 每 case 判断块 cmp+条件跳转 →
//   体块未终止直落 下一体块/默认/出口=真 C fall-through 语义，**无贯穿标志**）。
//   中断绑定：函数信息.选择出口块=出口块（生成语句 中断分派既有优先级生效；
//   进入循环时暂存清 0=最近绑定，见 生成当/生成循环 暂存对）。
//   恒不终止（判断链/默认/直落三路均有出口块可达路径）→ 空类型 返回（生成语句
//   主循环按语句处理，不取终止性——选择出口恒可达）。
不安全 函数 生成选择语句(向量<节点> 池, 节点 选择节点,
              映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
              函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
              向量<整64>& 表达式栈, 整64 返回类型码) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    // ① 选择值：求值一次+槽化（判断链跨块——虚拟寄存器跨块不保，88-a 短路
    //   临时槽同款；类型码取登记值·0=整64 兜底）
    整64 值寄存器 = 生成表达式(池, 整32(选择节点.文本), 整32(选择节点.附加),
                                 局部槽, 参数槽, 指令, 寄存器计数, &函数信息.块计数,
                                 槽计数, 表达式栈);
    整64 值码 = 查寄存器类型(值寄存器);
    如果 (值码 == 0) { 值码 = T_整64; }
    整64 值槽 = 槽计数[0];
    槽计数[0] = 槽计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 值槽));
    IR追加(指令, 建IR指令(IR_存储, 值寄存器, 0, 0, 0, 0, 值槽));
    // ② 收集情况：非默认（值区间非空）顺序入列；默认（[0,0)）单独记。
    //   **类型过滤=节点_情况标签**——情况段 [子起点,子终点) 含情况值表达式与
    //   体语句节点（先于标签入池），不过滤会把它们的 子起点 误当体块索引。
    向量<整64> 情况索引们 = 向量<整64>();
    整64 默认索引 = 0;
    整64 况i = 整64(选择节点.子起点);
    当 (况i < 整64(选择节点.子终点)) {
        节点 情况节点 = 池.元素(整32(况i));
        如果 (情况节点.类型 == 节点_情况标签) {
            如果 (情况节点.文本 == 0 && 情况节点.附加 == 0) {
                默认索引 = 况i;
            } 否则 {
                结果<空类型, 整32> 加况 = 情况索引们.追加(况i);
                如果 (!加况.正常) { 运行时错误(4); }
            }
        }
        况i++;
    }
    整64 情况数 = 情况索引们.大小();
    // ③ 块预分配（宿主同款：判断块+体块 每情况一对·默认块·出口块）
    向量<整64> 判断块们 = 向量<整64>();
    向量<整64> 体块们 = 向量<整64>();
    整64 预i = 0;
    当 (预i < 情况数) {
        结果<空类型, 整32> 加判 = 判断块们.追加(新块(函数信息));
        如果 (!加判.正常) { 运行时错误(4); }
        结果<空类型, 整32> 加体 = 体块们.追加(新块(函数信息));
        如果 (!加体.正常) { 运行时错误(4); }
        预i++;
    }
    整64 默认块 = 0;
    如果 (默认索引 != 0) { 默认块 = 新块(函数信息); }
    整64 出口块 = 新块(函数信息);
    // ④ 中断绑定（最近绑定的「选择」半边——恢复点=出口块切换前）
    整64 旧选择出口 = 函数信息.选择出口块;
    函数信息.选择出口块 = 出口块;
    // ⑤ 入口跳转：无情况（含纯默认）直接落 默认/出口
    如果 (情况数 > 0) {
        发射跳转(函数信息, 判断块们.元素(0));
    } 否则 {
        如果 (默认块 != 0) { 发射跳转(函数信息, 默认块); }
        否则 { 发射跳转(函数信息, 出口块); }
    }
    // ⑥ 判断链：值==情况值（字符串情况 __cn_str_eq）→ 匹配体块/不匹配下一判断
    整64 链尾目标 = 出口块;
    如果 (默认块 != 0) { 链尾目标 = 默认块; }
    整64 链i = 0;
    当 (链i < 情况数) {
        整64 判断块 = 判断块们.元素(链i);
        切换块(函数信息, 判断块);
        发射块标签(函数信息, 判断块);
        节点 情况节点 = 池.元素(整32(情况索引们.元素(链i)));
        整64 情况值寄存器 = 生成表达式(池, 整32(情况节点.文本), 整32(情况节点.附加),
                                     局部槽, 参数槽, 指令, 寄存器计数, &函数信息.块计数,
                                     槽计数, 表达式栈);
        整64 值载入 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_加载, 值槽, 0, 0, 值载入, 值码, 0));
        登记寄存器类型(值载入, 值码);
        整64 比较寄存器 = 0;
        如果 (情况节点.子终点 == 1) {
            // 字符串情况：__cn_str_eq(选择值, 情况字面量)（宿主 C-4 同款）
            整64 串等寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_调用实参, 值载入, 0, 0, 0, 0, 0));
            IR追加(指令, 建IR指令(IR_调用实参, 情况值寄存器, 0, 0, 0, 1, 0));
            IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 串等寄存器, 0,
                                 驻留("__cn_str_eq")));
            登记寄存器类型(串等寄存器, T_布尔);
            比较寄存器 = 串等寄存器;
        } 否则 {
            整64 相等寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            整64 二元码 = 公共整型提升(值码, 查寄存器类型(情况值寄存器));
            IR追加(指令, 建IR指令(IR_相等, 值载入, 情况值寄存器, 0, 相等寄存器, 二元码, 0));
            登记寄存器类型(相等寄存器, T_布尔);
            比较寄存器 = 相等寄存器;
        }
        // 不匹配目标：下一判断块/链尾（默认/出口）
        整64 不匹配目标 = 链尾目标;
        如果 (链i + 1 < 情况数) { 不匹配目标 = 判断块们.元素(链i + 1); }
        发射条件跳转(函数信息, 比较寄存器, 体块们.元素(链i), 不匹配目标);
        // ⑦ 体块：未终止直落 下一体块/默认/出口（跳过中间判断=真 C fall-through）
        整64 体块 = 体块们.元素(链i);
        切换块(函数信息, 体块);
        发射块标签(函数信息, 体块);
        布尔 体终止 = 生成块(池, 整32(情况节点.子起点), 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
        如果 (!体终止) {
            整64 直落目标 = 出口块;
            如果 (链i + 1 < 情况数) {
                直落目标 = 体块们.元素(链i + 1);
            } 否则 {
                如果 (默认块 != 0) { 直落目标 = 默认块; }
            }
            发射跳转(函数信息, 直落目标);
        }
        链i++;
    }
    // ⑧ 默认块
    如果 (默认块 != 0) {
        切换块(函数信息, 默认块);
        发射块标签(函数信息, 默认块);
        节点 默认情况 = 池.元素(整32(默认索引));
        布尔 默认终止 = 生成块(池, 整32(默认情况.子起点), 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
        如果 (!默认终止) { 发射跳转(函数信息, 出口块); }
    }
    // ⑨ 出口块+恢复中断绑定
    函数信息.选择出口块 = 旧选择出口;
    切换块(函数信息, 出口块);
    发射块标签(函数信息, 出口块);
}

// 357-a（D39 根治）：三段式循环生成——原生四块序（init 语句段内联发射 →
//   条件块〔cond 空=常量真〕→ 体块〔循环继续块=**步进块**·继续→step 语义
//   C for 同款；中断→出口；73-a 基线五枚保存恢复〕→ 步进块（step 段+回跳
//   条件）→ 出口块）。节点字段：文本=init 起点、子起点=cond 起点、
//   子终点=step 起点、附加=体块索引（step 段=[子终点, 附加-1)、
//   step 包装节点=附加-1）。
不安全 函数 生成循环(向量<节点> 池, 节点 循环节点,
            映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
            函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
            向量<整64>& 表达式栈, 整64 返回类型码) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    整64 init起点 = 整64(循环节点.文本);
    整64 cond起点 = 整64(循环节点.子起点);
    整64 step起点 = 整64(循环节点.子终点);
    整64 体块索引 = 循环节点.附加;
    // step 段=[子终点, 体块节点.子起点)——解析块 的块节点在体子语句**之后**追加
    //   （体子语句 [S1, 块节点)·块节点@附加），故 step 终点须读块节点字段
    节点 体块节点 = 池.元素(整32(体块索引));
    整64 step终点 = 整64(体块节点.子起点);
    // ① init 段（语句区间·内联发射——循环外执行一次）
    如果 (init起点 < cond起点) {
        布尔 init终止 = 生成语句(池, 整32(init起点), 整32(cond起点), 局部槽, 参数槽,
                                  函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
        如果 (init终止) { 返回; }
    }
    // 块序
    整64 条件块 = 新块(函数信息);
    整64 体块 = 新块(函数信息);
    整64 步进块 = 新块(函数信息);
    整64 出口块 = 新块(函数信息);
    发射跳转(函数信息, 条件块);
    // ② 条件块（cond 空=常量真）
    切换块(函数信息, 条件块);
    发射块标签(函数信息, 条件块);
    整64 条件寄存器 = 0;
    如果 (cond起点 < step起点) {
        条件寄存器 = 生成表达式(池, 整32(cond起点), 整32(step起点), 局部槽, 参数槽,
                                 指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
    } 否则 {
        条件寄存器 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("1")), 0, 0, 条件寄存器, T_整64, 0));
    }
    发射条件跳转(函数信息, 条件寄存器, 体块, 出口块);
    // 循环上下文（继续→步进块·中断→出口块·73-a 基线五枚）
    整64 旧出口 = 函数信息.循环出口块;
    整64 旧继续 = 函数信息.循环继续块;
    函数信息.循环出口块 = 出口块;
    函数信息.循环继续块 = 步进块;
    // 413-a（D44）：循环内中断绑定**最近**的选择或循环——循环体内在选择之后
    //   进入时暂存清 0 选择出口（恢复在体块生成后）=中断跳循环出口（C 语义）
    整64 旧选择出口L = 函数信息.选择出口块;
    函数信息.选择出口块 = 0;
    整64 旧串基线 = 函数信息.循环串基线;
    整64 旧容基线 = 函数信息.循环容基线;
    整64 旧字基线 = 函数信息.循环字段基线;
    整64 旧数组串基线 = 函数信息.循环数组串基线;
    函数信息.循环串基线 = 函数信息.字符串变量们.大小();
    函数信息.循环容基线 = 函数信息.容器变量们.大小();
    函数信息.循环字段基线 = 函数信息.资源字段局部们.大小();
    函数信息.循环数组串基线 = 函数信息.字符串数组变量们.大小();
    // ③ 体块
    切换块(函数信息, 体块);
    发射块标签(函数信息, 体块);
    布尔 体终止 = 生成块(池, 整32(体块索引), 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
    函数信息.循环出口块 = 旧出口;
    函数信息.循环继续块 = 旧继续;
    函数信息.选择出口块 = 旧选择出口L;
    函数信息.循环串基线 = 旧串基线;
    函数信息.循环容基线 = 旧容基线;
    函数信息.循环字段基线 = 旧字基线;
    函数信息.循环数组串基线 = 旧数组串基线;
    如果 (!体终止) {
        发射跳转(函数信息, 步进块);
    }
    // ④ 步进块（step 段执行后回条件——继续 语义目标=此处）
    切换块(函数信息, 步进块);
    发射块标签(函数信息, 步进块);
    如果 (step起点 < step终点) {
        生成语句(池, 整32(step起点), 整32(step终点), 局部槽, 参数槽,
                 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
    }
    发射跳转(函数信息, 条件块);
    // ⑤ 出口块
    切换块(函数信息, 出口块);
    发射块标签(函数信息, 出口块);
}
