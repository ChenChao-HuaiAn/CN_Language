// CN 自举编译器 v2 · 生成语句（千行拆分子模块，2026-09-08 用户裁决阶段目录包）
// 职责：语句遍历（生成语句）+ 块遍历与控制流生成（生成块/生成如果/生成当）
//   ——自 IR生成.cn 机械搬移；寄存器/引用参数等权威表经 公开: 访问函数
//   （IR生成 主干）；模块路径=生成语句（新键基）。
导入 容器::向量;
导入 语法;       // Token/AST 节点池（原 导入 语法分析，目录包名）
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码（目录包名）
导入 IR生成;     // 控制流辅助/变量类型权威表（同包幂等）
导入 生成声明;    // 语句级变量声明分派（R3 拆分，同包）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// ==================== 语句遍历 ====================
// 取参数串第 段序 段（',' 分隔，0 起；越界返回 空串）——②b 结构体实参判定用
//   （局部实现避免 代码生成共用 导入环：共用层依赖本模块）
函数 取参数段(字符串 参数串, 整64 段序) -> 字符串 {
    整64 起点 = 0;
    整64 段 = 0;
    整64 i = 0;
    当 (i <= 字符串长度(参数串)) {
        布尔 边界 = i == 字符串长度(参数串);
        如果 (!边界) {
            整64 字节 = 整64(参数串[i]) & 255;
            如果 (字节 == 44) { 边界 = 真; }
        }
        如果 (边界) {
            如果 (段 == 段序) {
                返回 字符串子串(参数串, 起点, i - 起点);
            }
            起点 = i + 1;
            段++;
        }
        i++;
    }
    返回 "";
}

// 生成 池[块起点, 块终点) 内语句的 IR。本阶段语句级支持 变量声明/返回/表达式语句/
//   赋值/自增/如果/当/中断/继续（P6b 控制流）。
// 缺陷A根治（2026-09-02）：返回 布尔=本块是否已终止（返回/中断/继续 后跳过
//   剩余语句——不可达代码不再发射，避免后续 返回 覆盖返回值/析构重复发射）。
函数 生成语句(向量<节点> 池, 整32 起点, 整32 终点,
              映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
              函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
              向量<整64>& 表达式栈, 整64 返回类型码) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    // 预扫描：收集本块内 控制流语句（如果/当）的体块节点索引——
    //   体语句节点在池中位于控制流语句节点之前（顺序追加），会被本块区间
    //   直接包含；若直接生成会造成「体语句在外层重复生成」。收集后遍历时跳过。
    向量<整64> 体块们 = 向量<整64>();
    // ②b B4：裸块语句（直接子语句的 节点_块）——内部语句同样先于块节点入池，
    //   须跳过其区间（块节点处经 生成块 递归，作用域基线/块出口析构在内处理）
    向量<整64> 裸块们 = 向量<整64>();
    扫描控制流体块(池, 起点, 终点, 体块们, 裸块们);
    整32 位置 = 起点;
    当 (位置 < 终点) {
        // 跳过控制流语句的体块与裸块内部语句（预扫描已收集）
        整32 跳到 = 语句块跳过位置(池, 体块们, 位置);
        如果 (跳到 >= 0) {
            位置 = 跳到;
            继续;
        }
        如果 (在裸块区间(池, 裸块们, 位置)) {
            位置++;
            继续;
        }
        节点 n = 池.元素(位置);
        如果 (n.类型 == 节点_变量声明) {
            生成变量声明(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈);
        } 否则 如果 (n.类型 == 节点_返回语句) {
            如果 (生成返回语句(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数,
                               表达式栈, 返回类型码)) {
                返回 真;
            }
        } 否则 如果 (n.类型 == 节点_表达式语句) {
            // 表达式语句：求值（结果丢弃）。子区间为表达式节点。
            如果 (n.子起点 < n.子终点) {
                生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                            指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
            }
        } 否则 如果 (n.类型 == 节点_赋值) {
            生成赋值语句(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈);
        } 否则 如果 (n.类型 == 节点_自增) {
            // 自增：Load 槽 +1 -> Store（P6b 语句级）；②c D：引用参数经指针读写回；
            //   ③ 第六波：静态槽读写对——分支体抽入 发射自增自减（C1 自减对称共用）
            发射自增自减(指令, 整64(n.文本), 假, 局部槽, 参数槽, 寄存器计数);
        } 否则 如果 (n.类型 == 节点_自减) {
            // 簇③根治·自减全链 C1（2026-09-04 用户裁决）：与自增对称（IR_减 1）
            发射自增自减(指令, 整64(n.文本), 真, 局部槽, 参数槽, 寄存器计数);
        } 否则 如果 (n.类型 == 节点_块) {
            // ②b B4：裸块语句——递归生成（作用域基线/块出口析构 由 生成块 统一处理，
            //   块内容器/资源结构体局部 块结束即释放）
            生成块(池, 位置, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
        } 否则 如果 (n.类型 == 节点_如果语句) {
            布尔 如果终止 = 生成如果(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
            如果 (如果终止) { 返回 真; }
        } 否则 如果 (n.类型 == 节点_当语句) {
            布尔 当终止 = 生成当(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
            如果 (当终止) { 返回 真; }
        } 否则 如果 (n.类型 == 节点_中断语句) {
            // 中断：跳出前 drop-on-jump（释放本轮循环体已声明资源），再跳最近
            //   循环出口块（73-a 方案A：宿主 72-a genJumpDestructFrom 同构）
            如果 (函数信息.循环出口块 != 0) {
                循环跳出析构(函数信息, 局部槽, 寄存器计数);
                发射跳转(函数信息, 函数信息.循环出口块);
                返回 真;   // 块终止：跳过本块剩余语句（不可达）
            }
        } 否则 如果 (n.类型 == 节点_继续语句) {
            // 继续：跳出前 drop-on-jump，再跳最近循环继续块（条件块）
            如果 (函数信息.循环继续块 != 0) {
                循环跳出析构(函数信息, 局部槽, 寄存器计数);
                发射跳转(函数信息, 函数信息.循环继续块);
                返回 真;   // 块终止：跳过本块剩余语句（不可达）
            }
        }
        位置++;
    }
    返回 假;
}

// ==================== 语句分支辅助（R3 拆分，2026-09-08 自 生成语句 机械搬移） ====================

// 预扫描：收集本块内 控制流语句（如果/当）的体块节点索引——
//   体语句节点在池中位于控制流语句节点之前（顺序追加），会被本块区间
//   直接包含；若直接生成会造成「体语句在外层重复生成」。收集后遍历时跳过。
//   ②b B4：裸块语句（直接子语句的 节点_块）同收集（排除 如果/当/否则 的体块）。
函数 扫描控制流体块(向量<节点> 池, 整32 起点, 整32 终点,
                    向量<整64>& 体块们, 向量<整64>& 裸块们) {
    整32 扫 = 起点;
    当 (扫 < 终点) {
        节点 扫节点 = 池.元素(扫);
        如果 (扫节点.类型 == 节点_如果语句) {
            // 节点字段：附加=真块索引，子终点=否则索引
            结果<空类型, 整32> 加真 = 体块们.追加(整64(扫节点.附加));
            如果 (!加真.正常) { 运行时错误(4); }
            // 根治（2026-09-06，呈报① gdb/dbg 五层下钻闭环）：否则链须整链收集——
            //   原实现仅收集首层体块，「否则如果」的嵌套如果根未被跳过：主遍历
            //   遇内层根先整链生成一遍、外层 生成如果 递归再生成一遍=双重生成
            //   （chain 探针 4 层链实测 7 次生成如果而非 4 次、块重复执行——
            //   v2 IR 自源头坏、历史冒烟「exit=0+语义 0 错」假绿的真相）
            整64 链游 = 扫节点.子终点;
            当 (链游 != 0) {
                节点 链节 = 池.元素(整32(链游));
                如果 (链节.类型 == 节点_如果语句) {
                    结果<空类型, 整32> 加根 = 体块们.追加(链游);
                    如果 (!加根.正常) { 运行时错误(4); }
                    结果<空类型, 整32> 加体 = 体块们.追加(整64(链节.附加));
                    如果 (!加体.正常) { 运行时错误(4); }
                    链游 = 链节.子终点;
                } 否则 {
                    如果 (链节.类型 == 节点_块) {
                        结果<空类型, 整32> 加尾块 = 体块们.追加(链游);
                        如果 (!加尾块.正常) { 运行时错误(4); }
                    }
                    链游 = 0;
                }
            }
        } 否则 如果 (扫节点.类型 == 节点_当语句) {
            结果<空类型, 整32> 加当 = 体块们.追加(整64(扫节点.附加));
            如果 (!加当.正常) { 运行时错误(4); }
        } 否则 如果 (扫节点.类型 == 节点_块) {
            // 排除 如果/当/否则 的体块（体块们 已收集，生成如果/生成当 递归处理
            //   ——体块节点位置晚于控制流语句节点，此刻必已登记）
            布尔 是体块 = 假;
            整64 tb = 0;
            当 (tb < 体块们.大小()) {
                如果 (体块们.元素(tb) == 整64(扫)) { 是体块 = 真; }
                tb++;
            }
            如果 (!是体块) {
                结果<空类型, 整32> 加裸 = 裸块们.追加(整64(扫));
                如果 (!加裸.正常) { 运行时错误(4); }
            }
        }
        扫++;
    }
}

// 主循环体块跳过判定：位置落在某控制流体块（含 否则链根/体）→ 返回 跳块+1；
//   不跳 → 返回 -1（体块索引可为 0，故用 -1 哨兵）。
函数 语句块跳过位置(向量<节点> 池, 向量<整64> 体块们, 整32 位置) -> 整32 {
    整64 跳块 = -1;
    整64 b = 0;
    当 (b < 体块们.大小()) {
        整64 体块索引 = 体块们.元素(b);
        如果 (整64(位置) == 体块索引) {
            跳块 = 体块索引;
        } 否则 {
            节点 体块节点 = 池.元素(整32(体块索引));
            如果 (整64(位置) >= 整64(体块节点.子起点) && 整64(位置) < 体块索引) {
                跳块 = 体块索引;
            }
        }
        b++;
    }
    如果 (跳块 >= 0) {
        返回 整32(跳块 + 1);
    }
    返回 -1;
}

// ②b B4：位置是否落在某裸块内部（裸块内部语句先于块节点入池；
//   块节点处经 生成块 递归生成，此处跳过避免双生成）。
函数 在裸块区间(向量<节点> 池, 向量<整64> 裸块们, 整32 位置) -> 布尔 {
    整64 nb = 0;
    当 (nb < 裸块们.大小()) {
        整64 裸块索引 = 裸块们.元素(nb);
        节点 裸块节点 = 池.元素(整32(裸块索引));
        如果 (整64(位置) >= 裸块节点.子起点 && 整64(位置) < 裸块索引) {
            返回 真;
        }
        nb++;
    }
    返回 假;
}

// 返回语句 IR 生成。返回 真=块已终止（发射跳函数尾块——缺陷A 终止感知）。
不安全 函数 生成返回语句(向量<节点> 池, 节点 n,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈, 整64 返回类型码) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    整64 值寄存器 = 0;
    // 71-a：结果/可选 返回与结构体返回同款 retbuf 路径（拷贝字节数分流）
    布尔 返回结构体值 = (函数信息.返回结构体ID != 0 ||
                          函数信息.返回结果名ID != 0) && n.子起点 < n.子终点;
    // 引用返回（2026-09-04 缺陷零容忍收口，宿主 P3-18 对齐）：返回语句
    //   发射被引用左值地址（rax=左值地址——调用方指针加载读/指针存储写/
    //   引用初始化直接绑定）；非左值形态 IR 层诊断（语义层已白名单，
    //   防御双保险）
    如果 (函数信息.返回引用 == 1 && n.子起点 < n.子终点) {
        值寄存器 = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                 指令, 寄存器计数, &函数信息.块计数,
                                 槽计数, 表达式栈);
        如果 (值寄存器 == 0) {
            IR层诊断("引用返回须返回左值（变量/成员/下标/解引用）: " +
                      驻留文本(整64(函数信息.名字)));
        }
        当 (表达式栈.大小() > 0) {
            结果<空类型, 整32> 删栈rv = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈rv.正常) { 运行时错误(4); }
        }
        发射容器析构(函数信息, 指令, 寄存器计数, 局部槽, 0);
        // plans/019 阶段4' 第二批：引用返回路径同样释放字符串（引用左值非拥有
        //   移出——跳过名 0=全释放）。71-b（2026-09-11）：恢复第六十七轮被
        //   二分禁用（注释残留）的调用——引用返回函数的拥有串局部出口释放，
        //   grep false&& 复审查不到注释式禁用（第七十轮清零行动漏网形态）
        发射字符串释放(函数信息, 指令, 寄存器计数, 局部槽, 0);

        IR追加(指令, 建IR指令(IR_返回, 值寄存器, 0, 0, 0, 返回类型码, 0));
        发射跳转(函数信息, 函数信息.函数尾块);
        返回 真;
    }
    如果 (返回结构体值) {
        // 用户函数返回结构体（2026-09-04，E2E 148）：宿主 ABI——值拷入
        //   调用方传入的 retbuf（槽 1 指针）、rax=retbuf。源地址两形态：
        //   末节点=标识符/成员/解引用 -> 生成左值地址（本函数局部基槽）；
        //   末节点=调用 -> 生成表达式（被调 retbuf 地址即结构体地址）
        节点 返回末 = 池.元素(n.子终点 - 1);
        如果 (返回末.类型 == 节点_标识符 || 返回末.类型 == 节点_成员 ||
             返回末.类型 == 节点_解引用) {
            值寄存器 = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                     指令, 寄存器计数, &函数信息.块计数,
                                     槽计数, 表达式栈);
        } 否则 {
            值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                   指令, 寄存器计数, &函数信息.块计数,
                                   槽计数, 表达式栈);
        }
        整64 ret指针 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_加载, 1, 0, 0, ret指针, T_整64, 0));
        // 71-a：返回拷贝字节数分流——结果/可选 返回用 结果大小（结构体表查不到
        //   合成名=0，防拷 0 字节假返回）
        整64 返回拷贝字节71 = 查结构体大小(函数信息.返回结构体ID);
        如果 (函数信息.返回结果名ID != 0) {
            返回拷贝字节71 = 结果大小(字符串复制(
                驻留文本(函数信息.返回结果名ID)));
        }
        IR追加(指令, 建IR指令(IR_结构体拷贝, 值寄存器, ret指针, 0, 0,
                             返回拷贝字节71, 0));
        值寄存器 = ret指针;
        当 (表达式栈.大小() > 0) {
            结果<空类型, 整32> 删栈r = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈r.正常) { 运行时错误(4); }
        }
    } 否则 如果 (n.子起点 < n.子终点) {
        值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                               指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
    }
    // P7b RAII：返回前析构本函数容器局部（DeleteObject 空安全——
    //   未执行声明路径槽=0 跳过；宿主 genClassDestructorCalls 同款语义）。
    //   2026-09-06 根治（T6 自举首踩）：返回结构体值时被返回变量跳过
    //   析构——所有权转移（值已浅拷入 retbuf 共享堆指针，析构局部=
    //   retbuf 悬垂，IR生成多文件 返回 程序IR 后 函数们.大小()=垃圾实测）
    //   2026-09-06 第二次根治（retown 探针）：返回**容器**（-> 映射<...>）
    //   同族——原仅 返回结构体值 设跳过名，返回容器标识符仍被析构=
    //   返回悬垂指针（接收方 .获取 崩）。泛化：末节点=标识符即设跳过名
    //   （非容器名不在 容器变量们，无副作用）
    整64 返回转移名ID = 0;
    如果 (n.子终点 > n.子起点) {
        节点 返回末转移 = 池.元素(n.子终点 - 1);
        如果 (返回末转移.类型 == 节点_标识符) {
            返回转移名ID = 整64(返回末转移.文本);
        }
    }
    // plans/019 阶段4' A2（2026-09-11 方案甲）：返回位字面量拥有化——返回类型
    //   字符串=拥有契约（调用方登记 RAII 释放），字面量驻只读段须 copy 落堆
    //   （否则调用方 free 只读段指针=崩溃）。拥有变量=槽值直传（移出）。
    如果 (n.子终点 > n.子起点 && 返回类型码 == T_字符串) {
        节点 返回末A2t = 池.元素(n.子终点 - 1);
        如果 (返回末A2t.类型 == 节点_字符串字面量) {
            整64 copy返回寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_调用实参, 值寄存器, 0, 0, 0, 0, 0));
            IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, copy返回寄存器, 0,
                                 驻留("__cn_str_copy")));
            值寄存器 = copy返回寄存器;
        }
    }
    发射容器析构(函数信息, 指令, 寄存器计数, 局部槽, 返回转移名ID);
    // plans/019 阶段4' 第二批：拥有型字符串 RAII（跳过名=返回标识符移出）
    发射字符串释放(函数信息, 指令, 寄存器计数, 局部槽, 返回转移名ID);
    IR追加(指令, 建IR指令(IR_返回, 值寄存器, 0, 0, 0, 返回类型码, 0));
    // 缺陷A根治：返回 后跳函数尾块（epilogue 唯一）——中途回退不再穿透
    发射跳转(函数信息, 函数信息.函数尾块);
    返回 真;
    返回 假;
}

// 赋值语句：文本=左值名（标识符槽/静态槽）；文本=0 时 附加=左值表达式起点
//   （解引用/成员/下标左值，按字段宽度存储）。结构体整体赋值经
//   生成结构体整体赋值（第18枚 POD Copy 语义）先行拦截。
不安全 函数 生成赋值语句(向量<节点> 池, 节点 n,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) {
    向量<IR指令>& 指令 = 函数信息.指令;
    如果 (n.文本 != 0) {
    // 标识符左值：槽 <- 右值寄存器
    整64 目标槽 = 0;
    结果<整64, 整32> 找槽 = 局部槽.获取(整64(n.文本));
    如果 (找槽.正常) { 目标槽 = 找槽.值; }
    如果 (目标槽 == 0) {
        结果<整64, 整32> 找参 = 参数槽.获取(整64(n.文本));
        如果 (找参.正常) { 目标槽 = 找参.值; }
    }
        如果 (生成结构体整体赋值(池, n, 目标槽, 局部槽, 参数槽, 函数信息,
                                 寄存器计数, 槽计数, 表达式栈)) {
            返回;
        }
    整64 值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
    // 第七十八轮（2026-09-12）：方法体字段左值赋值（字段名裸标识符——局部/参数
    //   未命中；this 槽加载 + 字段地址 + 指针存储）。结构体类型字段整体赋值=
    //   第一版边界（显式拒绝——8 字节指针存储会静默截断 >8 字节结构体）
    如果 (目标槽 == 0 && 值寄存器 != 0) {
        整64 字段偏移z = 当前方法字段偏移(整64(n.文本));
        如果 (字段偏移z >= 0) {
            整64 字段类型z = 查字段类型ID(当前方法类名ID, 整64(n.文本));
            如果 (字段类型z != 0 && 查结构体大小(字段类型z) != 0) {
                IR层诊断("类字段（结构体类型）整体赋值暂不支持: " +
                             驻留文本(整64(n.文本)));
                运行时错误(6);
            }
            整64 地址z = 发射类字段地址(字段偏移z, 指令, 寄存器计数);
            IR追加(指令, 建IR指令(IR_指针存储, 地址z, 值寄存器, 0, 0, T_整64, 0));
            当 (表达式栈.大小() > 0) {
                结果<空类型, 整32> 删栈z = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删栈z.正常) { 运行时错误(4); }
            }
            返回;
        }
    }
    // 静态槽赋值（2026-09-06 根治，缺陷零容忍）：目标非局部/参数时查
    //   静态序号表——命中则 IR_静态存储 写回 .data 槽。原实现此处仅认
    //   局部/参数槽，静态目标「目标槽==0」静默丢存储（探针 计数器 =
    //   计数器 + 阶段(5) 打印恒 0 实证）——防御分支静默降级家族成员，
    //   与 发射自增自减 的静态读写对（②c C）同款设施补齐
    如果 (目标槽 == 0 && 值寄存器 != 0) {
        整64 找静赋 = 查静态序号(整64(n.文本));
        如果 (找静赋 >= 0) {
            IR追加(指令, 建IR指令(IR_静态存储, 值寄存器, 0, 0, 0, T_整64, 找静赋));
        }
    }
    // plans/019 阶段4' 第二批（2026-09-11 方案A）：拥有型字符串赋值——宿主
    //   第一批复核同构 + Rust 赋值语义（先 drop 旧再 move 新）：目标=字符串
    //   且在拥有名单且未污染时：①右值=字面量/标识符 → free 旧 + __cn_str_copy
    //   落堆（变量恒拥有堆串）；②右值=白名单八函数调用/二元拼接（+ 产物恒
    //   堆，复合赋值 += 语法层已重析为二元）→ free 旧 + 直存；③其余形态
    //   （非白名单调用/下标/成员等借用源）→ free 旧（旧值必为拥有——拥有链
    //   维护，drop 后零泄漏，优于宿主保守面）+ 污染退出 RAII + 直存。
    //   free 旧空安全（未赋值路径槽=0——预扫入口零初始化）。
    如果 (值寄存器 != 0 && 目标槽 != 0) {
        整64 赋目标类型2 = 查当前函数变量类型(整64(n.文本));
        如果 (赋目标类型2 == 驻留("字符串")) {
            布尔 在名单 = 假;
            整64 名i = 0;
            当 (名i < 函数信息.字符串变量们.大小()) {
                如果 (函数信息.字符串变量们.元素(名i) == 整64(n.文本)) {
                    在名单 = 真;
                    中断;
                }
                名i++;
            }
            结果<整64, 整32> 查污赋 = 函数信息.字符串污染们.获取(整64(n.文本));
            如果 (在名单 && !查污赋.正常) {
                节点 赋末 = 池.元素(n.子终点 - 1);
                布尔 右值拥有 = 赋末.类型 == 节点_字符串字面量 ||
                                赋末.类型 == 节点_标识符 ||
                                赋末.类型 == 节点_二元运算;
                如果 (赋末.类型 == 节点_调用) {
                    节点 被调赋 = 池.元素(整32(赋末.子起点));
                    如果 (被调赋.类型 == 节点_标识符) {
                        整64 被调名赋 = 整64(被调赋.文本);
                        右值拥有 = 被调名赋 == 驻留("字符串复制") ||
                                  被调名赋 == 驻留("字符串连接") ||
                                  被调名赋 == 驻留("字符串拼接") ||
                                  被调名赋 == 驻留("字符串子串") ||
                                  被调名赋 == 驻留("字符串大写") ||
                                  被调名赋 == 驻留("字符串小写") ||
                                  被调名赋 == 驻留("字符串修剪") ||
                                  被调名赋 == 驻留("字符串反转");
                        // A2（方案甲）：返回类型契约——被调者返回 字符串 即拥有
                        //   （72-a：键基回退版——纯名查跨模块 miss=契约失效）
                        如果 (!右值拥有 &&
                             查函数返回回退(被调名赋) == 驻留("字符串")) {
                            右值拥有 = 真;
                        }
                    }
                }
                // 字面量/标识符：先 copy 落堆再 free 旧（自赋值 s = s 安全——
                //   copy 产物独立于旧值内存后才能释放旧值）
                如果 (右值拥有 && (赋末.类型 == 节点_字符串字面量 ||
                                赋末.类型 == 节点_标识符)) {
                    整64 copy赋寄存器 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_调用实参, 值寄存器, 0, 0, 0, 0, 0));
                    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, copy赋寄存器, 0,
                                         驻留("__cn_str_copy")));
                    登记寄存器类型(copy赋寄存器, T_字符串);
                    值寄存器 = copy赋寄存器;
                }
                // free 旧值（drop——拥有链维护下旧值必为堆串；空安全；二元/调用
                //   右值求值时已消费旧值内容产新堆——free 后不再引用）
                整64 旧ptr = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 旧ptr, T_字符串, 0));
                IR追加(指令, 建IR指令(IR_调用实参, 旧ptr, 0, 0, 0, 0, 0));
                IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                     驻留("__cn_str_free")));
                如果 (!右值拥有) {
                    // 借用源——污染退出（此后不再 free/拥有化）
                    登记串污染(函数信息, 整64(n.文本));   // 75-a：唯一入口
                }
            }
        }
    }
    如果 (值寄存器 != 0 && 目标槽 != 0) {                    如果 (槽是引用(目标槽)) {
            // ②c D：引用参数赋值——Load 槽得调用方左值地址，指针写回
            整64 地址reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 地址reg, T_整64, 0));
            IR追加(指令, 建IR指令(IR_指针存储, 地址reg, 值寄存器, 0, 0, T_整64, 0));
        } 否则 {
            // 46-f 第五十轮：正32 目标存储前截断（wrapping mod 2^32，助手
            //   单一事实源在 生成声明——非正32 目标零开销直通）
            整64 赋目标类型 = 查当前函数变量类型(整64(n.文本));
            值寄存器 = 正32存储截断(驻留文本(赋目标类型), 值寄存器, 指令, 寄存器计数);
            IR追加(指令, 建IR指令(IR_存储, 值寄存器, 0, 0, 0, 0, 目标槽));
        }
    }
    // 清空表达式栈（右值 残留）
    当 (表达式栈.大小() > 0) {
        结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈.正常) { 运行时错误(4); }
    }
    } 否则 {
    // 成员/解引用左值：手动生成左值地址（不走 生成表达式，避免成员取值）
    // ②b B5：成员左值按字段宽度存储（类型码入 指令.类型——旧固定 8 字节
    //   写越界清零相邻槽，126 段① OOM 根因；解引用左值保持默认 8 字节）
    节点 左末 = 池.元素(n.子起点 - 1);
    // 46-a 根治（2026-09-09 第四十八轮）：成员结构体作值写（r.左上 = a /
    //   r.右下 = r.左上，含 >8 字节结构体）——左字段类型是结构体且右值为
    //   标识符/成员链（结构体值形态）时，两侧 生成左值地址 + IR_结构体拷贝
    //   整体写（Rust place 拷贝语义，与 生成结构体整体赋值 同构）。原标量
    //   宽度通道对 8 字节结构体恰好覆盖、>8 字节静默截断（数据损坏家族）；
    //   右值经 成员载荷是结构体 根治后压地址，此通道统一地址语义。
    //   构造字面量右值（节点_构造展开，186 通道）不在此拦截。
    如果 (左末.类型 == 节点_成员 && n.子起点 < n.子终点) {
        // 父链类型=解析成员链结构体ID(左末.子起点)（范本=取成员宽度码：
        //   成员节点 子起点=对象节点索引——传左末自身索引得的是左末字段
        //   自身类型，再查一层字段类型必 miss——首版误写实证）
        整64 父链ID48 = 解析成员链结构体ID(池, 整32(左末.子起点));
        如果 (父链ID48 != 0) {
            整64 字段结构体ID48 = 查结构体类型(
                查字段类型ID(父链ID48, 整64(左末.文本)));
            如果 (字段结构体ID48 != 0) {
                节点 右末48 = 池.元素(n.子终点 - 1);
                如果 (右末48.类型 == 节点_标识符 || 右末48.类型 == 节点_成员) {
                    整64 目标地址48 = 生成左值地址(池, 整32(n.附加), n.子起点,
                                                   局部槽, 参数槽, 指令,
                                                   寄存器计数, &函数信息.块计数,
                                                   槽计数, 表达式栈);
                    整64 源地址48 = 生成左值地址(池, n.子起点, n.子终点,
                                                 局部槽, 参数槽, 指令,
                                                 寄存器计数, &函数信息.块计数,
                                                 槽计数, 表达式栈);
                    如果 (目标地址48 != 0 && 源地址48 != 0) {
                        // 79-a：串字段深拷（目标为成员字段——非拥有槽，不 preFree）
                        发射结构体整体拷贝(函数信息, 寄存器计数, 目标地址48,
                                         源地址48, 字段结构体ID48, 真, 假);
                    }
                    当 (表达式栈.大小() > 0) {
                        结果<空类型, 整32> 删栈48 = 表达式栈.删除(表达式栈.大小() - 1);
                        如果 (!删栈48.正常) { 运行时错误(4); }
                    }
                    返回;
                }
            }
        }
    }
    整64 存储宽度 = T_整64;
    如果 (左末.类型 == 节点_成员) {
        存储宽度 = 取成员宽度码(池, n.子起点 - 1);
    } 否则 如果 (左末.类型 == 节点_下标) {
        // ③ 第三波：下标左值写宽度=所指元素宽度（整32* p[0]=v 写 4 字节，
        //   8 字节写越界踩相邻元素——同 B5 成员窄宽教训）
        存储宽度 = 取下标元素宽度码(池, n.子起点 - 1);
    }
    整64 地址寄存器 = 生成左值地址(池, 整32(n.附加), n.子起点, 局部槽, 参数槽,
                                指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
    整64 值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                               指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
    // plans/019 阶段4' 第二批：下标目标为字符串元素（字符串* 指针元素——
    //   查指针变量类型 直判所指类型，宽度码对字符串归并 T_整64 不可用）且
    //   右值为字符串变量标识符 -> 值被外部槽持有（指针逃逸模型，宿主 38_tool
    //   姓名[]=$副本 同款）-> 右值变量污染退出 RAII（出口 free=悬垂源头）
    如果 (左末.类型 == 节点_下标 && 左末.子起点 > 0 &&
         n.子起点 < n.子终点) {
        节点 借对象 = 池.元素(整32(左末.子起点));
        如果 (借对象.类型 == 节点_标识符 &&
             查指针变量类型(整64(借对象.文本)) == 驻留("字符串")) {
            节点 右末借 = 池.元素(n.子终点 - 1);
            如果 (右末借.类型 == 节点_标识符 &&
                 查当前函数变量类型(整64(右末借.文本)) == 驻留("字符串")) {
                登记串污染(函数信息, 整64(右末借.文本));   // 75-a：唯一入口
            }
        }
    }
    // 79-a（2026-09-12 第七十九轮）：成员字符串字段写入归一化——字段独立拥有
    //   （与宿主 79-a 同款分级）：字面量=驻留直存；裸函数调用（白名单族/返回
    //   字符串契约）=接管零拷贝；其余（标识符/成员/下标/二元/方法调用借用返回）
    //   =__cn_str_copy 落堆（字段独立副本，源保持拥有照常释放）。顺序=先求值+
    //   复制、后 free 旧值（自赋值 甲.名 = 甲.名 安全：新值先独立于旧值内存）。
    //   preFree 仅对「直连标识符父对象且父在资源字段名单」（拥有槽）发射——其余
    //   形态保守不释放旧值（宁漏勿错）。
    如果 (地址寄存器 != 0 && 值寄存器 != 0 && 左末.类型 == 节点_成员) {
        整64 父链IDw = 解析成员链结构体ID(池, 整32(左末.子起点));
        如果 (父链IDw != 0) {
            整64 字段类型IDw = 查字段类型ID(父链IDw, 整64(左末.文本));
            如果 (字段类型IDw != 0 && 字符串比较(驻留文本(字段类型IDw), "字符串")) {
                节点 右末w = 池.元素(n.子终点 - 1);
                布尔 需复制 = 真;
                如果 (右末w.类型 == 节点_字符串字面量) { 需复制 = 假; }
                否则 如果 (右末w.类型 == 节点_调用 && 右末w.子起点 > 0) {
                    节点 被调w = 池.元素(整32(右末w.子起点));
                    如果 (被调w.类型 == 节点_标识符) {
                        整64 被调名w = 整64(被调w.文本);
                        布尔 白名单w = 被调名w == 驻留("字符串复制") ||
                                      被调名w == 驻留("字符串连接") ||
                                      被调名w == 驻留("字符串拼接") ||
                                      被调名w == 驻留("字符串子串") ||
                                      被调名w == 驻留("字符串大写") ||
                                      被调名w == 驻留("字符串小写") ||
                                      被调名w == 驻留("字符串修剪") ||
                                      被调名w == 驻留("字符串反转");
                        如果 (!白名单w && 查函数返回回退(被调名w) == 驻留("字符串")) {
                            白名单w = 真;   // A2 契约：签名即契约
                        }
                        需复制 = !白名单w;
                    }
                }
                如果 (需复制) {
                    值寄存器 = 发射字符串复制调用(指令, 寄存器计数, 值寄存器);
                }
                如果 (左末.子起点 > 0) {
                    节点 对象w = 池.元素(整32(左末.子起点));
                    如果 (对象w.类型 == 节点_标识符 &&
                        在资源字段名单(函数信息, 整64(对象w.文本))) {
                        整64 旧regw = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_指针加载, 地址寄存器, 0, 0, 旧regw, T_字符串, 0));
                        IR追加(指令, 建IR指令(IR_调用实参, 旧regw, 0, 0, 0, 0, 0));
                        IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                             驻留("__cn_str_free")));
                        如果 (函数信息.零寄存器 != 0) {
                            IR追加(指令, 建IR指令(IR_指针存储, 地址寄存器,
                                         函数信息.零寄存器, 0, 0, T_整64, 0));
                        }
                    }
                }
            }
        }
    }
    如果 (地址寄存器 != 0 && 值寄存器 != 0) {
        IR追加(指令, 建IR指令(IR_指针存储, 地址寄存器, 值寄存器, 0, 0, 存储宽度, 0));
    }
    // 清空表达式栈（右值 残留）
    当 (表达式栈.大小() > 0) {
        结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈.正常) { 运行时错误(4); }
    }
    }
}

        // 第18枚根治（2026-09-06，v2self 引用参数槽们 登记全 miss 根因）：
        //   结构体变量整体赋值 甲 = 乙——旧实现无条件走 生成表达式
        //   IR_加载/IR_存储 单槽 8 字节浅拷（24B 节点只拷 类型+文本 首
        //   槽，附加 等后续字段原值残留——宿主为整结构体字节拷贝，编译器
        //   分叉实锤）。对齐宿主/Rust POD Copy 语义：IR_结构体拷贝 整体
        //   拷贝（源/目标地址按 引用槽→装载槽内容（绑定对象地址）、其余
        //   →取槽地址 分流，与 生成左值地址 同约定）；非同型变量标识符
        //   形态 fail fast 诊断拒绝（绝不静默浅拷=错误产物）。
不安全 函数 生成结构体整体赋值(向量<节点> 池, 节点 n, 整64 目标槽,
                        映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                        函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                        向量<整64>& 表达式栈) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
                整64 左类型ID = 解析标识符类型ID(整64(n.文本));
    如果 (查结构体大小(左类型ID) == 0) {
        返回 假;
    }
        节点 右末 = 池.元素(整32(n.子终点 - 1));
        // 79-a：自赋值（甲 = 甲）no-op——preFree 会先释放目标串字段，memcpy 把
        //   已释放句柄拷回、深拷再复制已释放内存（UAF）；值语义自赋值恒无副作用。
        如果 (右末.类型 == 节点_标识符 && 整64(右末.文本) == 整64(n.文本)) {
            返回 真;
        }
        如果 (右末.类型 != 节点_标识符 && 右末.类型 != 节点_成员) {
            IR层诊断("结构体赋值右值须为同型变量标识符: " +
                      驻留文本(整64(n.文本)));
        } 否则 如果 (右末.类型 == 节点_成员) {
            // 46-a 根治（2026-09-09 第四十八轮）：成员链右值（u = r.左上）——
            //   原右值限定标识符可见失败。右类型ID=右末节点自身类型经
            //   解析成员链结构体ID（递归解父链 r→矩形→左上→点），源地址=
            //   生成左值地址（顺序链，不 LoadPtr——结构体右值地址语义）；
            //   同型校验后 IR_结构体拷贝。
            整64 右类型IDm = 解析成员链结构体ID(池, 整32(n.子终点 - 1));
            如果 (查结构体大小(右类型IDm) != 查结构体大小(左类型ID)) {
                IR层诊断("结构体赋值左右类型不同/右值非结构体: " +
                          驻留文本(整64(n.文本)));
            } 否则 {
                整64 源地址m = 生成左值地址(池, n.子起点, n.子终点, 局部槽,
                                             参数槽, 指令, 寄存器计数,
                                             &函数信息.块计数, 槽计数,
                                             表达式栈);
                整64 目标地址m = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                如果 (槽是引用(目标槽)) {
                    IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0,
                                         目标地址m, T_整64, 0));
                } 否则 {
                    IR追加(指令, 建IR指令(IR_取地址, 目标槽, 0, 0,
                                         目标地址m, T_整64, 0));
                }
                // 79-a：串字段深拷（成员源=值语义拷贝：源保持拥有，目标独立副本；
                //   目标为字段/元素——非拥有槽，不做 preFree（宁漏勿错））
                发射结构体整体拷贝(函数信息, 寄存器计数, 目标地址m, 源地址m,
                                 左类型ID, 真, 假);
            }
        } 否则 {
            整64 右类型ID = 解析标识符类型ID(整64(右末.文本));
            如果 (查结构体大小(右类型ID) != 查结构体大小(左类型ID)) {
                IR层诊断("结构体赋值左右类型不同/右值非结构体: " +
                          驻留文本(整64(n.文本)));
            } 否则 {
                整64 右槽 = 0;
                结果<整64, 整32> 找右局部 = 局部槽.获取(整64(右末.文本));
                如果 (找右局部.正常) { 右槽 = 找右局部.值; }
                如果 (右槽 == 0) {
                    结果<整64, 整32> 找右参 = 参数槽.获取(整64(右末.文本));
                    如果 (找右参.正常) { 右槽 = 找右参.值; }
                }
                如果 (右槽 == 0) {
                    IR层诊断("结构体赋值右值未找到变量槽: " +
                              驻留文本(整64(右末.文本)));
                } 否则 {
                    整64 源地址 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    如果 (槽是引用(右槽)) {
                        IR追加(指令, 建IR指令(IR_加载, 右槽, 0, 0,
                                             源地址, T_整64, 0));
                    } 否则 {
                        IR追加(指令, 建IR指令(IR_取地址, 右槽, 0, 0,
                                             源地址, T_整64, 0));
                    }
                    整64 目标地址 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    如果 (槽是引用(目标槽)) {
                        IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0,
                                             目标地址, T_整64, 0));
                    } 否则 {
                        IR追加(指令, 建IR指令(IR_取地址, 目标槽, 0, 0,
                                             目标地址, T_整64, 0));
                    }
                    // 79-a：串字段深拷 + 目标拥有槽 preFree（旧字段串先释放，
                    //   幂等清槽——目标为函数局部且登记在资源字段名单时）
                    发射结构体整体拷贝(函数信息, 寄存器计数, 目标地址, 源地址,
                                     左类型ID, 真, 在资源字段名单(函数信息, 整64(n.文本)));
                }
            }
        }
        // 清空表达式栈（结构体赋值不走 生成表达式——保持与分支出口
        //   同构防御）
        当 (表达式栈.大小() > 0) {
            结果<空类型, 整32> 删栈构 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈构.正常) { 运行时错误(4); }
        }
    返回 真;
}


// ==================== 块遍历 ====================
// 生成一个块的语句 IR。返回 布尔=块是否已终止（缺陷A：终止感知）。
函数 生成块(向量<节点> 池, 整32 块节点,
            映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
            函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
            向量<整64>& 表达式栈, 整64 返回类型码) -> 布尔 {
    节点 块 = 池.元素(块节点);
    // 块级作用域析构（用户裁决项2）：入口记录 容器变量们 基线，出口对本块
    //   新增容器发 RAII 析构并截断列表——块结束即释放（安全目标：及时、
    //   作用域精确）；返回语句仍析构全部（跨块跳出兜底，晚析构无害）。
    //   嵌套块同名容器由语义层拒绝（预扫同名合槽，遮蔽会泄漏/双释——P7c 前不支持）。
    //   ②c B：含容器字段结构体局部同款（字段基线 截断）。
    整64 作用域基线 = 函数信息.容器变量们.大小();
    整64 字段作用域基线 = 函数信息.资源字段局部们.大小();
    整64 字符串基线 = 函数信息.字符串变量们.大小();
    布尔 已终止 = 生成语句(池, 块.子起点, 块.子终点, 局部槽, 参数槽, 函数信息,
                          寄存器计数, 槽计数, 表达式栈, 返回类型码);
    // 出口：析构本块新增容器（逆序——后声明先析构），并从列表截断。
    //   已终止（返回/中断/继续 已跳出）时不发射——控制流不可达，且 返回 已析构全部。
    如果 (!已终止) {
        块出口析构(函数信息, 局部槽, 寄存器计数, 作用域基线, 字段作用域基线, 字符串基线, 真);
    }
    返回 已终止;
}

// ==================== 控制流生成（P6b） ====================
// 生成 如果语句：条件寄存器 + 真块/假块 + 汇合块（标签随建随取）。
// 返回 布尔=两分支是否都已终止（缺陷A：终止分支不发汇合跳转——不可达）。
函数 生成如果(向量<节点> 池, 节点 如果节点,
              映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
              函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
              向量<整64>& 表达式栈, 整64 返回类型码) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    // 节点字段：文本=条件起点，子起点=条件终点，附加=真块索引，子终点=否则索引
    整64 条件寄存器 = 生成表达式(池, 整32(如果节点.文本), 整32(如果节点.子起点),
                                 局部槽, 参数槽, 指令, 寄存器计数, &函数信息.块计数,
                                 槽计数, 表达式栈);
    整64 真块 = 新块(函数信息);
    整64 假块 = 新块(函数信息);
    整64 汇合块 = 新块(函数信息);
    发射条件跳转(函数信息, 条件寄存器, 真块, 假块);
    // 真块
    切换块(函数信息, 真块);
    发射块标签(函数信息, 真块);
    布尔 真终止 = 生成块(池, 整32(如果节点.附加), 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
    如果 (!真终止) {
        发射跳转(函数信息, 汇合块);
    }
    // 假块（否则链）
    切换块(函数信息, 假块);
    发射块标签(函数信息, 假块);
    布尔 假终止 = 假;
    整64 否则索引 = 如果节点.子终点;
    如果 (否则索引 != 0) {
        节点 否则节点 = 池.元素(整32(否则索引));
        如果 (否则节点.类型 == 节点_如果语句) {
            // 否则 如果：递归生成（不额外发射跳转到汇合——递归内已处理）
            假终止 = 生成如果(池, 否则节点, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
        } 否则 {
            假终止 = 生成块(池, 整32(否则索引), 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
        }
    }
    如果 (!假终止) {
        发射跳转(函数信息, 汇合块);
    }
    // 汇合块
    切换块(函数信息, 汇合块);
    发射块标签(函数信息, 汇合块);
    返回 真终止 && 假终止;
}

// 生成 当语句：jmp 条件块 -> 条件表达式 -> 条件跳转 体/出口 -> 体 -> jmp 条件块
// 返回 布尔=假（循环出口恒可达——条件假路径；体终止只省略回边）
函数 生成当(向量<节点> 池, 节点 当节点,
            映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
            函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
            向量<整64>& 表达式栈, 整64 返回类型码) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    整64 条件块 = 新块(函数信息);
    整64 体块 = 新块(函数信息);
    整64 出口块 = 新块(函数信息);
    // 无条件跳入条件块
    发射跳转(函数信息, 条件块);
    // 条件块
    切换块(函数信息, 条件块);
    发射块标签(函数信息, 条件块);
    // 节点字段：文本=条件起点，附加=体块索引，子起点=条件终点
    整64 条件寄存器 = 生成表达式(池, 整32(当节点.文本), 整32(当节点.子起点),
                                 局部槽, 参数槽, 指令, 寄存器计数, &函数信息.块计数,
                                 槽计数, 表达式栈);
    发射条件跳转(函数信息, 条件寄存器, 体块, 出口块);
    // 体块：记录循环上下文（继续->条件块，中断->出口块）
    整64 旧出口 = 函数信息.循环出口块;
    整64 旧继续 = 函数信息.循环继续块;
    函数信息.循环出口块 = 出口块;
    函数信息.循环继续块 = 条件块;
    // 73-a（2026-09-11 方案A 用户裁决）：循环体基线三枚——中断/继续
    //   drop-on-jump 的释放范围起点（进入体前名单大小；嵌套循环保存/恢复，
    //   内层跳出只释放内层已声明资源）
    整64 旧串基线 = 函数信息.循环串基线;
    整64 旧容基线 = 函数信息.循环容基线;
    整64 旧字基线 = 函数信息.循环字段基线;
    函数信息.循环串基线 = 函数信息.字符串变量们.大小();
    函数信息.循环容基线 = 函数信息.容器变量们.大小();
    函数信息.循环字段基线 = 函数信息.资源字段局部们.大小();
    切换块(函数信息, 体块);
    发射块标签(函数信息, 体块);
    布尔 体终止 = 生成块(池, 整32(当节点.附加), 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
    函数信息.循环出口块 = 旧出口;
    函数信息.循环继续块 = 旧继续;
    函数信息.循环串基线 = 旧串基线;
    函数信息.循环容基线 = 旧容基线;
    函数信息.循环字段基线 = 旧字基线;
    如果 (!体终止) {
        发射跳转(函数信息, 条件块);
    }
    // 出口块
    切换块(函数信息, 出口块);
    发射块标签(函数信息, 出口块);
    返回 假;
}
