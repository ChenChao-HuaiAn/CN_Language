// CN IR · 结果/可选 值字段条件释放族（1396 轮拆分·先拆再加）
// 来源：IR生成类型辅助.cn 202-a 族① 机械搬移（逐字节保真·纯重构零行为变更）——
//   该文件 955 行触 900 警戒线，本文件新增浮点字面量定级面前先拆；族史=
//   IR容器释放.cn(277)→IR容器判定.cn(M6)→IR生成类型辅助.cn（两轮冻结线腾行），
//   消费方=IR容器释放/生成语句赋值尾 经包内合并全局池解析零改动。

导入 IR;         // IR_* 操作码/T_* 类型码（目录包名·函数IR/寄存器发射设施同包）

公开:   // 全文件公开（发射结果可选值字段释放于地址 供 IR容器释放/生成语句赋值尾/生成语句辅助 跨文件消费）
// ==================== 202-a 族①（M6 轮自 IR容器判定.cn 再迁·冻结线腾行）：
//   结果/可选 值字段条件释放——277 轮自 IR容器释放.cn 首迁、本轮随 205 谓词
//   rebase 合并（1604 E 面结构保留+1615 切分单点）后 IR容器判定.cn 触 242
//   冻结线（1010 行），同包 IR 内再迁本辅助文件（纯机械搬移零行为变更·
//   同包合并全局池互见·消费方=IR容器释放/生成语句赋值尾 不变）。
// ==================== 202-a 族①：结果/可选 值字段条件释放（277 轮自 IR容器释放.cn 机械搬移=纯搬运零行为变更·超标冻结文件腾行·205/277 谓词与类载荷分支随体） ====================
// 202-a：族① 结果/可选 特例（类型文本r 体内自算，整块迁入含守卫与返回）。
    // 79-a 特例：结果/可选（内置合成布局，非用户结构体）——值字段为字符串时
    //   条件释放：值/错误 共用联合体偏移（值@4/8，错误同槽），非「正常/有值」
    //   分支下值位是错误码整数（free 整数指针=崩）——与宿主 emitFieldStringFreeIf
    //   同构（IR 条件分支，零运行时辅助）。
// 79-a 特例：结果/可选（内置合成布局，非用户结构体）——值字段为字符串时
//   条件释放：值/错误 共用联合体偏移（值@4/8，错误同槽），非「正常/有值」
//   分支下值位是错误码整数（free 整数指针=崩）——与宿主 emitFieldStringFreeIf
//   同构（IR 条件分支，零运行时辅助）。
不安全 函数 发射结果可选值字段释放于地址(函数IR& 函数信息, 整64* 寄存器计数,
                                  整64 结构体ID, 整64 基址reg) -> 空类型 {
    字符串 类型文本r = 字符串复制(驻留文本(结构体ID));
    如果 (是结果类型(类型文本r)) {
        // #1609：同上（深度感知切分·T 可含 $）
        // #1615：元数感知单点（同 205·用户泛型类模板基名 374 宽度判据砍错实测）
        字符串 值类型r = "";
        可选<字符串> 值类型r查 = 结果载荷基型(类型文本r);
        如果 (值类型r查.有值) { 值类型r = 字符串复制(值类型r查.值); }
        // 205（021 任务 205）：值载荷=结构体且含资源字段——同走条件在位释放
        //   （79-a 条件守卫同款：错误码分支值位=整数·free 即崩）；载荷释放走
        //   发射串字段释放顺序（串/嵌套递归全覆盖·free+槽清零幂等）。安全性
        //   依据=205 装箱构造 在位串字段深拷（弹 载荷=独立副本·唯一持有者；
        //   203 轮首版回滚根因=当时浅拷共享已由源头改独占）。
        布尔 载荷为结构体 = 是结构体大小非零(驻留(值类型r)) &&
                             资源字段数(驻留(值类型r)) > 0;
        // 277（021 任务 277·#263 遗留缺口·577 实测）：用户类载荷分支——盒值
        //   字段=句柄槽（889 装箱深拷副本·NewObject 堆对象）→ 释放=LoadPtr 取
        //   句柄 → IR_删除对象（发射层展开=判空+call 类型$~T+free·零寄存器
        //   清槽幂等）。条件守卫复用下方 正常/有值 位检查（错误分支值位=整数
        //   ·LoadPtr 当句柄删除=崩·79-a 条件守卫同款）。无析构类不进（~T
        //   符号不存在=链接失败·对齐 847 hasDtor 判据）。
        布尔 载荷为类 = 是用户类(值类型r) && 类有析构(驻留(值类型r));
        如果 (字符串比较(值类型r, "字符串") || 载荷为结构体 || 载荷为类) {
            整64 值偏移r = 结果值偏移(值类型r);
            整64 条件地址 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_字段地址, 基址reg, 0, 0, 条件地址, T_整64, 0));
            整64 条件reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_指针加载, 条件地址, 0, 0, 条件reg, T_整32, 0));
            整64 释放块 = 新块(函数信息);
            整64 汇合块 = 新块(函数信息);
            发射条件跳转(函数信息, 条件reg, 释放块, 汇合块);
            切换块(函数信息, 释放块);
            发射块标签(函数信息, 释放块);
            整64 值地址r = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_字段地址, 基址reg, 0, 0, 值地址r, T_整64, 值偏移r));
            如果 (载荷为类) {
                // 277：类载荷=句柄槽——LoadPtr + IR_删除对象（判空+~T+free）+清槽
                整64 类载荷句柄 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(函数信息.指令, 建IR指令(IR_指针加载, 值地址r, 0, 0, 类载荷句柄, T_对象, 0));
                IR追加(函数信息.指令, 建IR指令(IR_删除对象, 类载荷句柄, 0, 0,
                                     寄存器计数[0], 0, 驻留(值类型r)));
                寄存器计数[0] = 寄存器计数[0] + 1;
            } 否则 如果 (载荷为结构体) {
                发射串字段释放顺序(函数信息.指令, 寄存器计数, 值地址r,
                                  驻留(值类型r));
            } 否则 如果 (字符串比较(值类型r, "字符串")) {
                // else 新规显式化（M6 轮搬移触新增面判定·零行为变更）：三分派
                //   合法区间显式枚举（类277/结构体205/字符串）——尾分支改显式
                //   条件（分派守卫已保证进入者必为字符串·谓词冗余=双保险）。
                整64 值regr = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(函数信息.指令, 建IR指令(IR_指针加载, 值地址r, 0, 0, 值regr, T_字符串, 0));
                IR追加(函数信息.指令, 建IR指令(IR_调用实参, 值regr, 0, 0, 0, 0, 0));
                IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                     驻留("__cn_str_free")));
            }
            如果 (函数信息.零寄存器 != 0) {
                IR追加(函数信息.指令, 建IR指令(IR_指针存储, 值地址r,
                                     函数信息.零寄存器, 0, 0, T_整64, 0));
            }
            发射跳转(函数信息, 汇合块);
            切换块(函数信息, 汇合块);
            发射块标签(函数信息, 汇合块);
        }
        // 1604（1592 审计·E=字符串 错误载荷条件释放·宿主 collectOwnedStrFields
        //   E 面同构）：结果<T,E> 的 E 载荷与 值 共用联合体槽——错误态（tag=0）
        //   槽内=E 拥有句柄，须条件释放（正常态槽=T 数值载荷，摘句柄=UB）。
        //   原 E 面漏收=错误字符串泄漏。E=类载荷不做（宿主 E 面 isClassType
        //   同边界·宁漏勿错对称）。
        // #1615：E 载荷切分同换单点（374 宽度判据对用户泛型类模板基名同病；
        //   E=T/E 次段·装箱载荷段 序=1 整分校验·无值=整分失败不登记）
        字符串 错误载荷类型 = "";
        可选<字符串> 错误载荷类型查 = 装箱载荷段(合成名首实参(类型文本r), 1);
        如果 (错误载荷类型查.有值) { 错误载荷类型 = 字符串复制(错误载荷类型查.值); }
        布尔 错误载荷为串 = 字符串比较(错误载荷类型, "字符串");
        布尔 错误载荷为结构体 = 是结构体大小非零(驻留(错误载荷类型)) &&
                             资源字段数(驻留(错误载荷类型)) > 0;
        如果 (错误载荷为串 || 错误载荷为结构体) {
            整64 条件地址e = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_字段地址, 基址reg, 0, 0, 条件地址e, T_整64, 0));
            整64 条件rege = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_指针加载, 条件地址e, 0, 0, 条件rege, T_整32, 0));
            整64 错误释放块 = 新块(函数信息);
            整64 汇合块e = 新块(函数信息);
            // tag 真（正常态）→ 汇合跳过；tag 假（错误态）→ 错误块释放
            发射条件跳转(函数信息, 条件rege, 汇合块e, 错误释放块);
            切换块(函数信息, 错误释放块);
            发射块标签(函数信息, 错误释放块);
            整64 错误槽地址 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_字段地址, 基址reg, 0, 0, 错误槽地址,
                                 T_整64, 结果值偏移(错误载荷类型)));
            如果 (错误载荷为串) {
                整64 错误串句柄 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(函数信息.指令, 建IR指令(IR_指针加载, 错误槽地址, 0, 0,
                                     错误串句柄, T_字符串, 0));
                IR追加(函数信息.指令, 建IR指令(IR_调用实参, 错误串句柄, 0, 0, 0, 0, 0));
                IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                     驻留("__cn_str_free")));
            }
            如果 (错误载荷为结构体) {
                发射串字段释放顺序(函数信息.指令, 寄存器计数, 错误槽地址,
                                  驻留(错误载荷类型));
            }
            如果 (函数信息.零寄存器 != 0) {
                IR追加(函数信息.指令, 建IR指令(IR_指针存储, 错误槽地址,
                                     函数信息.零寄存器, 0, 0, T_整64, 0));
            }
            发射跳转(函数信息, 汇合块e);
            切换块(函数信息, 汇合块e);
            发射块标签(函数信息, 汇合块e);
        }
        返回;
    }
}
