导入 容器::向量;
导入 语法;
导入 IR;
导入 协议常量;   // 335 重构B：协议常量独立包

导入 IR生成;
导入 生成表达式求值;

公开:   // 全文件公开（子模块符号供包内兄弟模块 经合并全局池解析）

// ==================== 296-a（D35 波B·2026-09-17）：后缀错误传播 表达式? ====================
// C-1（规范 07，宿主 ir_expr_unary.cpp Operator::Propagate 同构）：操作数为
//   结果<T,E>/可选<T>——正常取 .值 继续；失败构造 错误结果 沿 retbuf 直接返回
//   （Rust ? 语义）。布局协议（生成装箱构造 同源）：标志@0(T_整32 写)+联合载荷
//   @max(结果值偏移(T),结果值偏移(E))；被调 retbuf=槽1 指针（返回 结果/可选 时
//   生成函数保留），err 块就地写 retbuf {标志=0, 错误=E} 后 IR_返回+跳尾块
//   （生成返回语句 同款块终结惯例）；ok 块读值压栈（净 +1——三元汇合同款）。
//   宽错误码传播：读按操作数 E 宽度、写按返回 E' 宽度、IR_类型转换 桥接
//   （宿主 2026-08-25 根治同构）。语义标注：n.附加=操作数类型合成名ID、
//   n.文本=函数返回类型合成名ID（检查错误传播表达式 回填·装箱构造 子终点
//   标注同款），缺失=IR层诊断 fail fast。
不安全 函数 生成错误传播(向量<节点> 池, 节点 n, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                 向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数,
                 向量<整64>& 表达式栈) -> 空类型 {
    整64 传前深度 = 表达式栈.大小();
    整64 操作数类型ID = 整64(n.附加);
    整64 返回类型ID = 整64(n.文本);
    如果 (操作数类型ID <= 0 || 返回类型ID <= 0) {
        IR层诊断("错误传播 ? 缺语义标注（操作数/函数返回类型——语义层未回填）");
    }
    字符串 操作数名 = 字符串复制(驻留文本(操作数类型ID));
    字符串 返回名 = 字符串复制(驻留文本(返回类型ID));
    布尔 操作可选 = 字符串比较(合成名基名(操作数名), "可选");
    布尔 返回可选 = 字符串比较(合成名基名(返回名), "可选");
    字符串 操作实参段 = 合成名首实参(操作数名);
    字符串 返回实参段 = 合成名首实参(返回名);
    // 读偏移（操作数侧联合载荷）：max(结果值偏移(T), 结果值偏移(E))——装箱
    //   构造写侧同款公式；可选单实参无联合取宽歧义（值即唯一载荷）
    整64 读偏移 = 结果值偏移(段首(操作实参段));
    如果 (!操作可选) {
        整64 读错偏 = 结果值偏移(段首(段余(操作实参段)));
        如果 (读错偏 > 读偏移) { 读偏移 = 读错偏; }
    }
    // 写偏移（返回侧 retbuf 联合载荷）：同款 max 公式
    整64 写偏移 = 结果值偏移(段首(返回实参段));
    如果 (!返回可选) {
        整64 写错偏 = 结果值偏移(段首(段余(返回实参段)));
        如果 (写错偏 > 写偏移) { 写偏移 = 写错偏; }
    }
    // 操作数段求值 [子起点, 子终点)（子终点=本节点自身索引·三元同款惯例）：
    //   末节点=标识符/成员/解引用（变量形态·栈顶是 Load 值非地址）走
    //   生成左值地址（生成返回结构体值分支 两形态分流同款）；调用/装箱
    //   构造=栈顶即地址（retbuf/临时槽基址）
    整64 操作数地址 = 0;
    如果 (n.子终点 > n.子起点) {
        节点 末节点p = 池.元素(整32(n.子终点 - 1));
        如果 (末节点p.类型 == 节点_标识符 || 末节点p.类型 == 节点_成员 ||
             末节点p.类型 == 节点_解引用) {
            操作数地址 = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                    指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
        } 否则 {
            操作数地址 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                  指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
        }
    } 否则 {
        IR层诊断("错误传播 ? 缺操作数");
    }
    当 (表达式栈.大小() > 传前深度) {
        结果<空类型, 整32> 删传 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删传.正常) { 运行时错误(4); }
    }
    // 标志读：@0 T_整32（装箱构造写侧同宽）
    整64 标志地址 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 操作数地址, 0, 0, 标志地址, T_整64, 0));
    整64 标志寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 标志地址, 0, 0, 标志寄存器, T_整32, 0));
    // 载荷地址（读侧联合偏移）
    整64 载荷地址 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 操作数地址, 0, 0, 载荷地址, T_整64, 读偏移));
    // 分块：真(正常)→ok 块；假(失败)→err 块（endBranch(flag, ok, err) 同序）
    整64 ok块 = 块计数[0] + 1;
    整64 err块 = 块计数[0] + 2;
    块计数[0] = 块计数[0] + 2;
    IR追加(指令, 建IR指令(IR_条件跳转, 标志寄存器, ok块, err块, 0, 0, 0));
    // ---- err 块：构造 错误结果 入 retbuf 并直接返回 ----
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, err块));
    整64 ret指针e = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 1, 0, 0, ret指针e, T_整64, 0));
    整64 零e = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("0")), 0, 0, 零e, T_整64, 0));
    // 标志@0 = 0（错误）
    IR追加(指令, 建IR指令(IR_指针存储, ret指针e, 零e, 0, 0, T_整32, 0));
    // 错误值：读操作数 E 宽 → 写返回 E' 宽（宽错误码传播 IR_类型转换 桥接）；
    //   可选无错误字段=只写标志（无值语义）
    如果 (!返回可选) {
        整64 读码e = 类型码(驻留(段首(段余(操作实参段))));
        整64 写码e = 类型码(驻留(段首(段余(返回实参段))));
        整64 err值 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_指针加载, 载荷地址, 0, 0, err值, 读码e, 0));
        如果 (读码e != 写码e) {
            整64 cast值e = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_类型转换, err值, 0, 0, cast值e, 写码e, 0));
            err值 = cast值e;
        }
        整64 err槽地址 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_字段地址, ret指针e, 0, 0, err槽地址, T_整64, 写偏移));
        IR追加(指令, 建IR指令(IR_指针存储, err槽地址, err值, 0, 0, 写码e, 0));
    }
    // rax=retbuf 返回 + 跳尾块（生成返回语句 结构体值分支同款块终结）
    IR追加(指令, 建IR指令(IR_返回, ret指针e, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_跳转, 0, 0, 0, 0, 0, 取当前函数尾块ID()));
    // ---- ok 块：取 .值 继续（值类型=操作数 T·宿主 valSrc 直读同构）----
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, ok块));
    整64 值码o = 类型码(驻留(段首(操作实参段)));
    整64 值寄存器o = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 载荷地址, 0, 0, 值寄存器o, 值码o, 0));
    如果 (值码o != T_整64) {
        登记寄存器类型(值寄存器o, 值码o);
    }
    结果<空类型, 整32> 加传值 = 表达式栈.追加(值寄存器o);
    如果 (!加传值.正常) { 运行时错误(4); }
}
