// 生成类中（356 重构F1 自 生成类.cn 纯机械搬移·函数体逐字保留·零逻辑变化）
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_* 常量
导入 IR;         // IR_*/T_* 操作码 + 类表/布局查询/符号合成
导入 协议常量;   // 335 重构B：协议常量独立包
导入 IR生成;     // 程序IR 布局 + 类型码/权威表/控制流辅助

公开:

// 215-a：族① 方法链接符号推导——构造=类$类名、析构=类$~类名（方法名ID==类名ID///   方法名文本 == "~"+类名文本 判定）、普通=类$方法[#参数串]。
不安全 函数 生成方法链符号(向量<节点> 池, 整32 方法节点索引, 整32 类节点索引, 布尔& 是析构器) -> 整32 {
    节点 方法声明 = 池.元素(方法节点索引);
    整64 类名ID = 整64(池.元素(类节点索引).文本);
    字符串 类名文本 = 字符串复制(驻留文本(类名ID));
    整64 方法名ID = 整64(方法声明.文本);
    字符串 方法名文本 = 字符串复制(驻留文本(方法名ID));
    字符串 参数串 = 函数参数串(池, 方法节点索引);
    字符串 链符号 = 方法符号(类名文本, 方法名文本, 参数串);
    如果 (方法名ID == 类名ID) {
        链符号 = 方法符号(类名文本, 类名文本, 参数串);   // 构造：类$类名[#参数串]
    } 否则 如果 (字符串比较(方法名文本, "~" + 类名文本)) {
        链符号 = 析构符号(类名文本);                     // 析构：类$~类名
        是析构器 = 真;                     // 析构：类$~类名
    }
    返回 整32(驻留(链符号));
}

// 215-a：族② 方法签名与返回字段初始化——返回类型附加=0 归一空类型/返回结构体 retbuf/
//   结果返回 retbuf（71-a）/块计数/循环基线三枚/函数尾块（缺陷A）/retbuf 回填复位/
//   模块路径窗口。
不安全 函数 初始化方法签名与返回字段(向量<节点> 池, 节点 方法声明, 字符串 模块路径, 函数IR& 函数信息) -> 空类型 {
    整64 返回类型ID = 整64(方法声明.附加);
    如果 (返回类型ID == 0) { 返回类型ID = 驻留("空类型"); }
    函数信息.返回类型 = 类型码(返回类型ID);
    函数信息.返回结果名ID = 0;
    函数信息.返回结构体ID = 0;
    函数信息.返回128位 = 0;   // 810（053）：裸声明字段显式初始化（lessons 权重7）
    函数信息.返回数组字节 = 0;   // 087b：同上——显式初始化
    // 118（929·任务 118）：类方法引用返回（-> T&·解析层 类型文本分支已并入
    //   尾 '&'·实例化克隆 尾缀原样并入）——与自由函数 初始化签名与返回字段
    函数信息.返回引用 = 0;   // lessons 权重7：构造点显式初始化（CN 结构字段无默认值）
    {
        字符串 方法返回名q = 字符串复制(驻留文本(返回类型ID));
        如果 (字符串长度(方法返回名q) > 0 &&
             ((整64(方法返回名q[整32(字符串长度(方法返回名q) - 1)]) & 255) == 38)) {
            函数信息.返回引用 = 1;
        }
    }
    // 639-a（001-001 接手 628 波 1·与 IR容器.cn 调用方/生成函数.cn 被调方翻转
    //   配套）：容器实例方法返回亦走 sret（值拷贝·628 波 1 值语义同向）——
    // 1818（#1784 丁案 R1·001 §5.3·与 生成函数.cn 自由函数面同规）：非容器
    //   用户类方法返回**排除 sret**——类=句柄语义（宿主 isStructType 类/结构体
    //   两表分立→rax=句柄直传·ir_oop 同判据）。容器方法克隆体（元素() 返回
    //   用户类 T）同面：丁案后元素返回=rax 句柄（被调方返回位副本·630 立法
    //   域值语义）；容器类实例返回**维持 retbuf**（628 波 1·127_v2 护栏）。
    //   泛型实例克隆体名带 '$'（向量$货架$...$元素_J）——判定按方法声明节点
    //   附加（替换后返回类型 ID），与名字文本无关。
    函数信息.返回类名ID = 0;
    如果 (是用户类_ID(返回类型ID) && !是容器类_ID(返回类型ID) &&
         函数信息.返回引用 == 0) {
        函数信息.返回类名ID = 返回类型ID;
    }
    如果 (是结构体大小非零(返回类型ID) && 函数信息.返回类名ID == 0) {
        函数信息.返回结构体ID = 返回类型ID;
        IR追加(函数信息.指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 1));
    } 否则 如果 (函数信息.返回类名ID == 0 && 是结果类型_ID(返回类型ID)) {
        函数信息.返回结果名ID = 返回类型ID;
        IR追加(函数信息.指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 1));
    }
    // 810（053）：类方法 128 位标量返回同款 retbuf ABI（与 生成函数.cn 对齐）
    // 087b（#087 余量·宿主 ir_decl/ir_oop 同构）：类方法数组返回——sret 第四
    如果 (函数信息.返回结构体ID == 0 && 函数信息.返回结果名ID == 0) {
        字符串 方法返回名128 = 字符串复制(驻留文本(返回类型ID));
        如果 (字符串比较(方法返回名128, "整128")) {
            函数信息.返回128位 = 1;
            IR追加(函数信息.指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 1));
        } 否则 如果 (字符串比较(方法返回名128, "正128")) {
            函数信息.返回128位 = 2;
            IR追加(函数信息.指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 1));
        } 否则 如果 (是数组类型文本(方法返回名128)) {
            整64 方法数组字节087b = 类型名宽度(返回类型ID);
            如果 (方法数组字节087b > 0) {
                函数信息.返回数组字节 = 方法数组字节087b;
                IR追加(函数信息.指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 1));
            }
        }
    }
    设当前函数返回结果名ID(函数信息.返回结果名ID);   // 430-b（族③）装箱语境
    设当前方法名ID(整64(方法声明.文本));             // 205：弹出/出队 槽收回语境
    函数信息.块计数 = 0;
    函数信息.当前块 = 0;
    函数信息.循环出口块 = 0;
    函数信息.循环继续块 = 0;
    函数信息.循环串基线 = 0;
    函数信息.循环容基线 = 0;
    函数信息.循环字段基线 = 0;
    函数信息.函数尾块 = 新块(函数信息);
    复位retbuf字节数();
    设当前模块路径(模块路径);
}


// 类字段类型登记（生成方法 调用）：遍历类区间 节点_类字段 —— 容器/结果/类对象
//   字段入 函数信息.变量类型（方法对象类型解析数据源）+ 全部字段入函数级权威表
//   （打印分派/拼接转换/字段读类型码消费）。
函数 登记类字段类型们(向量<节点> 池, 整32 类节点索引, 函数IR& 函数信息) -> 空类型 {
    节点 类节点 = 池.元素(类节点索引);
    整64 位置 = 整64(类节点.子起点);
    当 (位置 < 整64(类节点.子终点)) {
        节点 候选 = 池.元素(整32(位置));
        如果 (候选.类型 == 节点_类字段) {
            如果 (候选.附加 >= 0 && 候选.附加 < 整64(池.大小())) {
                节点 类型节点f = 池.元素(整32(候选.附加));
                整64 字段类型ID = 整64(类型节点f.文本);
                字符串 字段类型文本 = 字符串复制(驻留文本(字段类型ID));
                // 432-b 根治：指针字段类型文本补 '*' 规范化——类型节点附加=
                //   指针层 1..255（文本本身无星），原登记丢层→下标读推导
                整64 指针层f = 类型节点f.附加;
                如果 (指针层f >= 1 && 指针层f <= 255) {
                    字符串 星串f = "";
                    整64 星i = 0;
                    当 (星i < 指针层f) {
                        星串f = 字符串复制(星串f + "*");
                        星i++;
                    }
                    字段类型文本 = 字符串复制(字段类型文本 + 星串f);
                    字段类型ID = 整64(驻留(字段类型文本));
                }
                如果 (是容器类(字段类型文本) || 是结果类型(字段类型文本) ||
                     是用户类(字段类型文本)) {
                    结果<空类型, 整32> 设类f = 函数信息.变量类型.设置(
                        整64(候选.文本), 字段类型ID);
                    如果 (!设类f.正常) { 运行时错误(4); }
                }
                登记当前函数变量类型(整64(候选.文本), 字段类型ID);
            }
        }
        位置++;
    }
}

// 860-a（058 挂账②·H7 字段版 v2 同构·宿主 ir_oop.cpp injectFieldCascadeConstruct
//   对应）：构造函数序言类字段级联构造——对本类「有默认构造的用户类字段」与
不安全 函数 注入父构造调用(向量<节点> 池, 整64 类名IDf, 整64 方法名IDf,
                     函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                     向量<整64>& 表达式栈,
                     映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽) -> 空类型 {
    // 1541 B2：无值=无继承（原 0 判据）
    整64 基名IDf = 0;
    可选<整64> 基查f = 查类基名(类名IDf);
    如果 (基查f.有值) { 基名IDf = 基查f.值; }
    如果 (!基查f.有值) { 返回; }
    // 309（2026-10-09）：walk-up 上溯（568 形态⑦ 叶→茎→根 实测·C++ 隐式默认
    //   构造链同构）——直接基无任何用户构造器时，沿链找最近「有 0 参构造」的
    //   祖先补调（中间无构造层=隐式构造逐级上溯·单继承同地址语义 A1）；全链
    //   无构造器=隐式分配即完整（234 原义·跳过）。基构造带默认参数形态挂账
    //   （缺段求值上下文同 278 注）。
    如果 (!类有构造器(基名IDf)) {
        整64 祖链f = 0;
        可选<整64> 祖链查f = 查类基名(基名IDf);
        如果 (祖链查f.有值) { 祖链f = 祖链查f.值; }
        整64 守卫祖f = 0;
        整64 命中祖f = 0;
        当 (祖链f != 0 && 守卫祖f < 64) {
            可选<整64> 祖构造查f = 查类构造参数串(祖链f, 0);
            如果 (类有构造器(祖链f) && 祖构造查f.有值) {
                命中祖f = 祖链f;
                中断;
            }
            // 1541 B2：无值=链到此为止（原 0 终止循环·中断同效）
            可选<整64> 祖上查f = 查类基名(祖链f);
            如果 (!祖上查f.有值) { 中断; }
            如果 (祖上查f.有值) { 祖链f = 祖上查f.值; }
            守卫祖f++;
        }
        如果 (命中祖f == 0) { 返回; }
        整64 this寄w = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(函数信息.指令, 建IR指令(IR_加载, 当前方法this槽, 0, 0, this寄w,
                             T_对象, 0));
        IR追加(函数信息.指令, 建IR指令(IR_调用实参, this寄w, 0, 0, 0, 0, 0));
        IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                             整64(驻留(方法符号(驻留文本(命中祖f),
                                                  剥实例基名(驻留文本(命中祖f)),
                                                  "")))));
        返回;
    }
    字符串 基文本f = 字符串复制(驻留文本(基名IDf));
    整64 实参数f = 查基构造实参数(类名IDf, 方法名IDf);
    向量<整64> 实参记f = 向量<整64>();
    整64 根序f = 0;
    当 (根序f < 实参数f) {
        // 1541 B2：无值=根未登记（实参数与根同点登记故不可达）→ 内部错误显形
        可选<整64> 根查f = 查基构造实参根(类名IDf, 方法名IDf, 根序f);
        如果 (!根查f.有值) {
            IR层诊断("基构造实参根未登记（内部错误）: " +
                     字符串复制(驻留文本(类名IDf)));
            运行时错误(6);
        }
        整64 根f = 0;
        如果 (根查f.有值) { 根f = 根查f.值; }
        生成表达式(池, 整32(根f), 整32(根f + 1), 局部槽, 参数槽, 函数信息.指令,
                   寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
        整64 值寄f = 表达式栈.元素(表达式栈.大小() - 1);
        结果<空类型, 整32> 加记f = 实参记f.追加(值寄f);
        如果 (!加记f.正常) { 运行时错误(4); }
        结果<空类型, 整32> 删栈f = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈f.正常) { 运行时错误(4); }
        根序f++;
    }
    // 1541 B2：无值=该实参数无构造（原 0 判据）
    整64 父构造串IDf = 0;
    可选<整64> 父构造查f = 查类构造参数串(基名IDf, 实参数f);
    如果 (父构造查f.有值) { 父构造串IDf = 父构造查f.值; }
    如果 (!父构造查f.有值) {
        // 309（2026-10-09）：父构造默认参数放宽（568 形态③④「空参列表靠父
        //   默认参」·宿主 D23 同构）——基类构造带默认参数时 初始化列表 0/少参
        //   调用按「可补全」放宽选中，缺段根在本构造体内求值后按声明序追加
        //   实参记f（**声明序表**——发射调用实参们 内部倒序发射·与主链 弹出们
        //   倒序表相反，此处勿倒序头插）。
        整64 放宽段f = 0;
        可选<整64> 放宽查f = 查类构造放宽(基名IDf, 实参数f, 放宽段f);
        如果 (放宽查f.有值) {
            整64 of = 实参数f;
            当 (of < 放宽段f) {
                可选<整64> 根查f2 = 查类构造默认根(基名IDf, 放宽段f, of);
                如果 (!根查f2.有值) { 中断; }
                整64 根f2 = 0;
                如果 (根查f2.有值) { 根f2 = 根查f2.值; }
                生成表达式(池, 整32(根f2), 整32(根f2 + 1), 局部槽, 参数槽,
                           函数信息.指令, 寄存器计数, &函数信息.块计数,
                           槽计数, 表达式栈);
                结果<空类型, 整32> 加缺f = 实参记f.追加(表达式栈.元素(表达式栈.大小() - 1));
                如果 (!加缺f.正常) { 运行时错误(4); }
                结果<空类型, 整32> 删缺f = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删缺f.正常) { 运行时错误(4); }
                of++;
            }
            如果 (of == 放宽段f) {
                实参数f = 放宽段f;
                可选<整64> 放宽构造查f = 查类构造参数串(基名IDf, 放宽段f);
                如果 (放宽构造查f.有值) { 父构造串IDf = 放宽构造查f.值; }
            }
        }
    }
    如果 (父构造串IDf == 0) {
        IR层诊断("基类 '" + 基文本f + "' 无 " + 整数转字符串(实参数f) +
                 " 参构造（基类无默认构造且未显式初始化列表·234）");
        运行时错误(6);
    }
    字符串 父串f = 字符串复制(驻留文本(父构造串IDf));
    整64 this槽f = 0;
    结果<整64, 整32> 查thisf = 参数槽.获取(驻留("$自身"));
    如果 (查thisf.正常) { this槽f = 查thisf.值; } 否则 { 运行时错误(6); }
    整64 this寄f = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(函数信息.指令, 建IR指令(IR_加载, this槽f, 0, 0, this寄f, T_对象, 0));
    IR追加(函数信息.指令, 建IR指令(IR_调用实参, this寄f, 0, 0, 0, 0, 0));
    // 332：实参记f 改倒序表（发射调用实参们 契约=倒序取——修前声明序直发=
    //   多参列表 ABI 错序·单参侥幸绿掩盖·求值仍声明序·314「勿倒序」注释勘误）
    向量<整64> 倒记f332; 整64 倒i332 = 实参记f.大小();
    当 (倒i332 > 0) {
        倒i332--; 结果<空类型, 整32> 加倒f = 倒记f332.追加(实参记f.元素(倒i332)); 如果 (!加倒f.正常) { 运行时错误(4); }
    }
    实参记f = 倒记f332;
    发射调用实参们(实参记f, 1, 函数信息.指令, 实参类型码们(实参记f));
    IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 实参数f + 1, 0, 0, 0, 0,
                         整64(驻留(方法符号(基文本f, 基文本f, 父串f)))));
}

不安全 函数 注入构造字段级联(向量<节点> 池, 整32 类节点索引, 函数IR& 函数信息,
                   整64* 寄存器计数) -> 空类型 {
    节点 类节点 = 池.元素(类节点索引);
    整64 类名ID = 整64(类节点.文本);
    整64 位置 = 整64(类节点.子起点);
    当 (位置 < 整64(类节点.子终点)) {
        节点 成员 = 池.元素(整32(位置));
        如果 (成员.类型 == 节点_类字段) {
            如果 (成员.附加 >= 0 && 成员.附加 < 整64(池.大小())) {
                节点 类型节点g = 池.元素(整32(成员.附加));
                // 860-a 甄别修正（218 红灯二分实锤）：指针/引用层字段（附加!=0·
                //   泛型实例克隆体 T* 数据 的类型节点文本=T 替换后基名）不级联——
                如果 (类型节点g.附加 == 0) {
                整64 字段类型IDg = 整64(类型节点g.文本);
                字符串 字段类型文本g = 字符串复制(驻留文本(字段类型IDg));
                可选<整64> 偏移g查 = 查字段偏移(类名ID, 整64(成员.文本));
                如果 (偏移g查.有值) {
                    整64 偏移g = 偏移g查.值;
                    如果 (是用户类(字段类型文本g)) {
                        // 用户类字段：须有默认构造（无参构造登记·查类构造参数串
                        //   按 0 实参查——与 发射用户类构造 432-b 同表）
                        // 1541 B2：有值=无参构造已登记（原 !=0 判据）
                        可选<整64> 构造查g = 查类构造参数串(字段类型IDg, 0);
                        如果 (构造查g.有值) {
                            整64 地址g = 发射类字段地址(偏移g, 函数信息.指令, 寄存器计数);
                            整64 对象g = 寄存器计数[0];
                            寄存器计数[0] = 寄存器计数[0] + 1;
                            整64 字段大小g = 0;
                            可选<整64> 字段大小g查 = 查结构体大小(字段类型IDg);
                            如果 (字段大小g查.有值) { 字段大小g = 字段大小g查.值; }
                            IR追加(函数信息.指令, 建IR指令(IR_分配对象, 0, 0, 0, 对象g,
                                                 字段大小g, 字段类型IDg));
                            IR追加(函数信息.指令, 建IR指令(IR_调用实参, 对象g, 0, 0, 0, 0, 0));
                            IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                                 整64(驻留(方法符号(字段类型文本g,
                                                                      剥实例基名(字段类型文本g),
                                                                      字符串复制(驻留文本(构造查g.值)))))));
                            IR追加(函数信息.指令, 建IR指令(IR_指针存储, 地址g, 对象g, 0, 0, T_对象, 0));
                        }
                    } 否则 如果 (是容器类(字段类型文本g)) {
                        // 容器字段：指针槽模型级联（对齐 生成转换或构造调用 容器
                        //   构造分支——分配对象+无参容器构造）
                        整64 地址g = 发射类字段地址(偏移g, 函数信息.指令, 寄存器计数);
                        整64 对象g = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(函数信息.指令, 建IR指令(IR_分配对象, 0, 0, 0, 对象g,
                                             容器对象大小(字段类型文本g), 字段类型IDg));
                        IR追加(函数信息.指令, 建IR指令(IR_调用实参, 对象g, 0, 0, 0, 0, 0));
                        IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                             整64(驻留(构造符号(字段类型文本g)))));
                        IR追加(函数信息.指令, 建IR指令(IR_指针存储, 地址g, 对象g, 0, 0, T_对象, 0));
                    }
                }
                }
            }
        }
        位置++;
    }
}


// ==================== 类对象局部与调用发射 ====================
// 生成类对象局部（生成变量声明 的类对象分派出口）：
不安全 函数 生成类对象局部(向量<节点> 池, 节点 n, 节点 类型节点,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    字符串 类型文本 = 字符串复制(驻留文本(整64(类型节点.文本)));
    整64 类名ID = 整64(类型节点.文本);
    整64 槽c = 槽计数[0];
    槽计数[0] = 槽计数[0] + 1;
    // 585-a（撤守卫收口·帧预留缺失根治）：类对象槽必须发 IR_分配——扫描函数 以
    //   IR_分配 声明性指令计入 最大槽（帧预留）；缺发=槽不进帧 → 后续 retbuf 区
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽c));

    // 1415：块级绑定恢复登记（须先于 局部槽/类型表 写入）
    登记块级绑定1415(整64(n.文本), 局部槽, 函数信息);
    结果<空类型, 整32> 设槽 = 局部槽.设置(整64(n.文本), 槽c);
    如果 (!设槽.正常) { 运行时错误(4); }
    整64 零reg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零reg, T_整64, 0));
    IR追加(指令, 建IR指令(IR_存储, 零reg, 0, 0, 0, 0, 槽c));
    结果<空类型, 整32> 设类v = 函数信息.变量类型.设置(整64(n.文本), 类名ID);
    如果 (!设类v.正常) { 运行时错误(4); }
    登记当前函数变量类型(整64(n.文本), 类名ID);
    // 658②（2026-10-14·#658）：**用户类局部一律入 RAII 名单**——原 类有析构
    //   判定使无析构类局部出口不发 IR_删除对象（字段+对象本体全泄漏·宿主同病
    //   差=1 实证）；配套 生成类尾 合成沿链析构体条件同步放开（~符号恒存在=
    //   链接闭合）。C++ 隐式析构同语义：无用户析构器≠不析构。
    // 543（459 批甲临时合流计数实证）：本面独立复现同族（无析构类局部块出口/
    //   返回路径全不删·pv2p 工丁 探针壳残 1）——收口随 658② 本名单全量化，
    //   释放语义由合成沿链析构体承载（不再走「后端按 类有析构 分派」方案）。
    名单追加去重(函数信息.容器变量们, 整64(n.文本));
    镜像容器追加1174(整64(n.文本));   // 1174：错误出口名单增量镜像
    结果<空类型, 整32> 镜槽1174 = 镜像容器槽1174.设置(整64(n.文本), 槽c);
    如果 (!镜槽1174.正常) { 运行时错误(4); }
    结果<空类型, 整32> 镜型1174 = 镜像容器类型1174.设置(整64(n.文本), 类名ID);
    如果 (!镜型1174.正常) { 运行时错误(4); }
    布尔 是构造初值 = 假;
    如果 (n.子起点 < n.子终点) {
        节点 初末 = 池.元素(n.子终点 - 1);
        如果 (初末.类型 == 节点_调用 && 初末.子起点 >= 0) {
            节点 初被调 = 池.元素(整32(初末.子起点));
            如果 (初被调.类型 == 节点_标识符 &&
                 字符串比较(驻留文本(整64(初被调.文本)), 类型文本)) {
                是构造初值 = 真;
            } 否则 如果 (初被调.类型 == 节点_标识符) {
                // 276-a（D28 根治·2026-09-17）：导入类裸名经解析期 B1 改写为
                //   「模块::类」限定形态，callee 文本≠声明位类型文本→合法构造
                字符串 被调文本 = 字符串复制(驻留文本(整64(初被调.文本)));
                字符串 改写模块 = "";
                字符串 改写符号 = "";
                如果 (拆限定名(被调文本, 改写模块, 改写符号) == 1 &&
                     字符串比较(改写符号, 类型文本)) {
                    是构造初值 = 真;
                }
            }
        }
    }
    如果 (n.子起点 < n.子终点 && !是构造初值) {
        // 630（544 呈报·容器接收面·声明位形态）：右值末=「容器元素类返回调用」
        //   （容器方法返回用户类元素）——产物=拷贝构造副本堆句柄（生成表达式
        //   求值中 容器分支 630 副本生成；对齐宿主「元素() 返回副本」值语义）→
        //   直存声明槽（副本独立拥有·本类型 类有析构 已在册=块出口释放）；
        //   落 发射类拷贝构造初始化 主路径=对堆副本再拷贝构造=双重深拷+首副本孤儿。
        节点 初末630 = 池.元素(n.子终点 - 1);
        如果 (初末630.类型 == 节点_调用 &&
            是容器元素类返回630(池, 整64(n.子终点 - 1), 类名ID)) {
            整64 副本reg630 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                         指令, 寄存器计数, &函数信息.块计数, 槽计数,
                                         表达式栈);
            如果 (副本reg630 != 0) {
                IR追加(指令, 建IR指令(IR_存储, 副本reg630, 0, 0, 0, 0, 槽c));
            }
            当 (表达式栈.大小() > 0) {
                结果<空类型, 整32> 删栈630 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删栈630.正常) { 运行时错误(4); }
            }
            返回;
        }
        // 414（#414·宿主「重载返回类对象赋值」语义对齐）：初值末端=运算符重载
        //   表达式（二元/一元命中·产物类型=声明类）。聚合返回=被调方 sret 把
        //   对象拷入调用方帧内 retbuf（栈临时·单 retbuf 复用）——直接存槽=
        //   下次聚合调用覆写毁值（340 实测 C0000005/错值双面）→ 依 091 堆物化
        //   先例：NewObject + 结构体拷贝（源=retbuf）→ 堆句柄入槽（尾析构登记
        //   释放合法·声明面已有 类有析构 名单追加）。
        //   1818（丁案 R1 后）：重载函数返回类=句柄 ABI（被调方返回位已副本/
        //   移交·rax=唯一拥有句柄）——本通道退化句柄接管直存（接收位零甄别）；
        //   旧位拷物化随 retbuf 本体通道退役（对句柄再位拷=双重拷贝+孤儿）。
        节点 初末414 = 池.元素(n.子终点 - 1);
        布尔 初末形态414 = (初末414.类型 == 节点_二元运算 || 初末414.类型 == 节点_负号 ||
                            初末414.类型 == 节点_逻辑非 || 初末414.类型 == 节点_位非);
        布尔 初末重载414 = 假;
        如果 (初末形态414) {
            可选<整64> 重载查414m = 解析重载节点类型ID(池, n.子终点 - 1);
            如果 (重载查414m.有值) {
                整64 重载ID414m = 0;
                如果 (重载查414m.有值) { 重载ID414m = 重载查414m.值; }
                初末重载414 = 重载ID414m == 类名ID;
            }
        }
        如果 (初末形态414 && 初末重载414) {
            整64 返回值reg414 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                         指令, 寄存器计数, &函数信息.块计数, 槽计数,
                                         表达式栈);
            如果 (返回值reg414 != 0) {
                IR追加(指令, 建IR指令(IR_存储, 返回值reg414, 0, 0, 0, 0, 槽c));
            }
            当 (表达式栈.大小() > 0) {
                结果<空类型, 整32> 删栈414 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删栈414.正常) { 运行时错误(4); }
            }
            返回;
        }
        // 631（544 呈报·声明位形态）：右值=转移(标识符)——拥有交接直存
        //   （真 move·族实现=生成类返回接管.cn·与 630/414 接管族同址）——
        //   原落下方深拷通道：转移源壳孤儿泄漏（631 探针 v2 残留 +2 宿主 0=分叉）
        如果 (转移接收类对象631(池, n, 类名ID, 槽c, 局部槽, 参数槽, 函数信息,
                              寄存器计数, 槽计数, 表达式栈)) { 返回; }
        // 879 退役（1818·丁案 R1）：「-> 类名」恒值副本（001 §5.3）——被调方
        //   返回位对借用来源已 NewObject 副本（生成语句 类返回位分派），产物=
        //   唯一拥有句柄，本通道的「别名直存+RAII 名单移除」前提（借用接收
        //   写穿可见）消失；别名直存会**跳过被调方副本**=与丁案副本语义冲突
        //   （写穿面）+RAII 移除=副本壳无人析构泄漏。接收位由 458 句柄直存
        //   接管（接收位零甄别·宿主 9a36199f8 注②同案）。
        发射类拷贝构造初始化(池, n, 类型文本, 类名ID, 槽c, 局部槽, 参数槽,
                              函数信息, 寄存器计数, 槽计数, 表达式栈);
        返回;
    }
    如果 (是构造初值) {
        整64 obj寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                     指令, 寄存器计数, &函数信息.块计数, 槽计数,
                                     表达式栈);
        如果 (obj寄存器 != 0) {
            IR追加(指令, 建IR指令(IR_存储, obj寄存器, 0, 0, 0, 0, 槽c));
        }
        当 (表达式栈.大小() > 0) {
            结果<空类型, 整32> 删栈g = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈g.正常) { 运行时错误(4); }
        }
        返回;
    }
    // 无初始化：分配 + 无参构造（宿主 ir_decl.cpp「无初始化表达式：NewObject +
    //   无参构造（this=新对象）」同款）。
    整64 obj寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    整64 类大小464 = 0;
    可选<整64> 类大小464查 = 查结构体大小(类名ID);
    如果 (类大小464查.有值) { 类大小464 = 类大小464查.值; }
    IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, obj寄存器,
                         类大小464, 类名ID));
    // 775（甲案·2026-10-15 用户裁决）：实例字段默认值注入——构造调用前
    //   （构造体显式赋值随后覆盖·C++ NSDMI 语义·宿主 genClassDefaultConstruct
    //   全链注入 同构；单调用点即全链覆盖——发射函数数据源全字段表含并入
    //   祖先层）。
    发射类字段默认值(类名ID, obj寄存器, 指令, 寄存器计数);
    // 1541 B2：有值=无参构造已登记（原 !=0 判据）
    可选<整64> 无参构造查 = 查类构造参数串(类名ID, 0);
    如果 (无参构造查.有值) {
        IR追加(指令, 建IR指令(IR_调用实参, obj寄存器, 0, 0, 0, 0, 0));
        // 416-a（D42 波 2）：构造方法名=基名（剥实例基名·非泛型类原文返回）——
        //   泛型实例符号=实例$基名（对齐定义侧链符号 克隆体普通方法 类$方法）
        IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                             驻留(方法符号(类型文本, 剥实例基名(类型文本), ""))));
    }
    IR追加(指令, 建IR指令(IR_存储, obj寄存器, 0, 0, 0, 0, 槽c));
}

// 用户类构造调用发射（生成转换或构造调用 的用户类分派出口）：
//   分配对象 → this=位0 + 实参位1.. → 类$类名[#参数串] → 对象指针压栈。
//   参数串取定义侧登记值（第一版无构造重载——实参数不匹配=IR 层诊断）。
不安全 函数 发射用户类构造(字符串 类名, 向量<整64>& 弹出们, 整64 实参数,
                   向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数,
                   向量<整64>& 表达式栈) -> 空类型 {
    整64 类名ID = 驻留(类名);
    // 1701（构造器重载按实参类型决议）：类型码→类型名拼实参类型串（形态与
    //   函数参数串 同「,」分隔·序=弹出序=发射序与 登记类构造 同源）——按类型
    //   串查类型串键表，命中=按实参类型选中构造（盒(5) 选整32 版·修前按参数
    //   段个数单键覆盖恒走整64 版输出 100 应 5）；未命中=回落实参数既有路径。
    字符串 实参类型串构 = "";
    整64 拼序构 = 0;
    当 (拼序构 < 实参数) {
        整64 码序构 = 查寄存器类型或未知(弹出们.元素(拼序构));
        字符串 类型名序构 = "整32";
        如果 (码序构 == T_整64) { 类型名序构 = "整64"; }
        如果 (码序构 == T_整8) { 类型名序构 = "整8"; }
        如果 (码序构 == T_整16) { 类型名序构 = "整16"; }
        如果 (码序构 == T_正8) { 类型名序构 = "正8"; }
        如果 (码序构 == T_正16) { 类型名序构 = "正16"; }
        如果 (码序构 == T_正32) { 类型名序构 = "正32"; }
        如果 (码序构 == T_正64) { 类型名序构 = "正64"; }
        如果 (码序构 == T_正128) { 类型名序构 = "正128"; }
        如果 (码序构 == T_整128) { 类型名序构 = "整128"; }
        如果 (码序构 == T_浮32) { 类型名序构 = "浮32"; }
        如果 (码序构 == T_浮64) { 类型名序构 = "浮64"; }
        如果 (码序构 == T_布尔) { 类型名序构 = "布尔"; }
        如果 (码序构 == T_字符串) { 类型名序构 = "字符串"; }
        如果 (字符串长度(实参类型串构) != 0) {
            实参类型串构 = 实参类型串构 + ",";
        }
        实参类型串构 = 实参类型串构 + 类型名序构;
        拼序构++;
    }
    可选<整64> 按型查构 = 查类构造参数串按类型串(类名ID, 驻留(实参类型串构));
    // 1541 B2：无值=按实参数无构造（原 0 判据）；有值=构造参数串 ID
    可选<整64> 构造查ID = 查类构造参数串(类名ID, 实参数);   // 432-b：按实参数选重载
    如果 (按型查构.有值) { 构造查ID = 按型查构; }
    如果 (!构造查ID.有值 && 实参数 == 0 && !类有构造器(类名ID)) {
        // 278（021 任务 278·#263 遗留缺口·365/375/377/568 实测）：**隐式默认
        //   构造**——显式 类名() 对无构造器类=仅分配（宿主 H7「无构造函数」
        //   309 守卫收窄：原只判「0 参 miss」=有构造器但带默认参数的类
        //   （377 乙(整32 n=9)）也被误判仅分配→字段全 0 静默错值——带默认
        //   构造形态已由主链 补类构造默认实参 补满实参后此处段数精确命中；
        //   剩此分支者=真无构造器类（278 本义）或有构造器但实参不可匹配
        //   （后者走下方 miss 诊断=宿主编译期拒绝同构·不再静默）。
        整64 obj寄存器d = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        整64 类大小502 = 0;
        可选<整64> 类大小502查 = 查结构体大小(类名ID);
        如果 (类大小502查.有值) { 类大小502 = 类大小502查.值; }
        IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, obj寄存器d,
                             类大小502, 类名ID));
        // 775（甲案·2026-10-15 用户裁决）：实例字段默认值注入——构造行为前
        //   （隐式默认构造=分配+基链补构造+字段级联；默认值写最先·与显式
        //   构造覆盖语义一致·宿主 genClassDefaultConstruct 全链注入 同构）。
        发射类字段默认值(类名ID, obj寄存器d, 指令, 寄存器计数);
        // 283 甲案（2026-10-08 用户批·001 §3.9 类类型字段级联默认构造）：
        //   无构造类实例化点=「仅分配」自此对类类型字段级联默认构造（与
        注入实例化字段级联(类名ID, obj寄存器d, 指令, 寄存器计数);
        // 309（2026-10-09）：隐式子类实例化补链（568 形态⑥ 猫 实测·宿主
        //   「实例化点补链」同构）——无构造派生类的 类名() 调用须沿基类链找
        //   最近「有 0 参构造」的基类补调其默认构造（C++ 隐式默认构造=分配+
        //   基默认构造+字段级联）；沿链无 0 参构造形态（基构造带默认参数须
        //   缺段求值·发射用户类构造 签名无求值上下文）=挂账待红例扩签名。
        整64 基链d = 0;
        可选<整64> 基链查d = 查类基名(类名ID);
        如果 (基链查d.有值) { 基链d = 基链查d.值; }
        整64 守卫链d = 0;
        当 (基链d != 0 && 守卫链d < 64) {
            可选<整64> 基构造查d = 查类构造参数串(基链d, 0);
            如果 (类有构造器(基链d) && 基构造查d.有值) {
                IR追加(指令, 建IR指令(IR_调用实参, obj寄存器d, 0, 0, 0, 0, 0));
                IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                     整64(驻留(方法符号(驻留文本(基链d),
                                                          剥实例基名(驻留文本(基链d)),
                                                          "")))));
                中断;
            }
            // 1541 B2：无值=链到此为止（原 0 终止循环·中断同效）
            可选<整64> 链上查d = 查类基名(基链d);
            如果 (!链上查d.有值) { 中断; }
            如果 (链上查d.有值) { 基链d = 链上查d.值; }
            守卫链d++;
        }
        结果<空类型, 整32> 加构d = 表达式栈.追加(obj寄存器d);
        如果 (!加构d.正常) { 运行时错误(4); }
        返回;
    }
    如果 (!构造查ID.有值) {
        IR层诊断("用户类无构造器（v2 第一版要求类提供构造器）: " + 类名);
        运行时错误(6);
    }
    // 上行无值已中止；此处 0 仅占位（不可达·既有未命中语义）
    整64 构造串ID = 0;
    如果 (构造查ID.有值) { 构造串ID = 构造查ID.值; }
    字符串 参数串 = 字符串复制(驻留文本(构造串ID));
    如果 (参数段个数(参数串) != 实参数) {
        IR层诊断("构造调用实参数不匹配（类 " + 类名 + "：期望 " +
                     整数转字符串(参数段个数(参数串)) + " 个）");
        运行时错误(6);
    }
    整64 obj寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    整64 类大小555 = 0;
    可选<整64> 类大小555查 = 查结构体大小(类名ID);
    如果 (类大小555查.有值) { 类大小555 = 类大小555查.值; }
    IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, obj寄存器,
                         类大小555, 类名ID));
    // 775（甲案·2026-10-15 用户裁决）：实例字段默认值注入——构造调用前
    //   （this 装载/实参/构造体执行随后覆盖·C++ NSDMI 语义·宿主 emitCtorInvoke
    //   本类层+emitBaseCtorChain 逐层 的等价单点：全字段表含并入祖先层）。
    发射类字段默认值(类名ID, obj寄存器, 指令, 寄存器计数);
    IR追加(指令, 建IR指令(IR_调用实参, obj寄存器, 0, 0, 0, 0, 0));
    // 810（053）：构造实参回扫（引用/结构体传地址+128 位实参物化）——键公式
    //   与 收集单类方法实参表 同源（构造器=方法名==类名的 节点_方法·已收集）；
    回扫结构体与引用实参(弹出们, 整64(驻留(方法符号(类名, 剥实例基名(类名),
                                                      参数串))),
                         指令, 寄存器计数, 槽计数);
    发射调用实参们(弹出们, 1, 指令, 实参类型码们(弹出们));
    IR追加(指令, 建IR指令(IR_调用参数化, 实参数 + 1, 0, 0, 0, 0,
                         驻留(方法符号(类名, 剥实例基名(类名), 参数串))));
    结果<空类型, 整32> 加构 = 表达式栈.追加(obj寄存器);
    如果 (!加构.正常) { 运行时错误(4); }
}

// 283 甲案（2026-10-08）：无构造类实例化点的类类型字段默认构造级联——
//   数据源=结构体全字段表们（三元组 [键基, 字段名ID, 字段类型ID]·IR 布局表
不安全 函数 注入实例化字段级联(整64 类名ID, 整64 obj寄存器, 向量<IR指令>& 指令,
                   整64* 寄存器计数) -> 空类型 {
    可选<整64> 键基c查 = 结构体布局键基(类名ID);
    // 1541 B2：无值=类未登记（原 ==0 判据等价）
    如果 (!键基c查.有值) { 返回; }
    整64 键基c = 0;
    如果 (键基c查.有值) { 键基c = 键基c查.值; }
    整64 i = 0;
    当 (i + 2 <= 结构体全字段表们.大小()) {
        如果 (结构体全字段表们.元素(i) == 键基c) {
            整64 字段名IDc = 结构体全字段表们.元素(i + 1);
            整64 字段类型IDc = 结构体全字段表们.元素(i + 2);
            字符串 字段类型文本c = 字符串复制(驻留文本(字段类型IDc));
            整64 偏移c = 0 - 1;   // 无值=字段未登记（原 -1 哨兵·下游 >=0 判据保持）
            可选<整64> 偏移c查 = 查字段偏移(类名ID, 字段名IDc);
            如果 (偏移c查.有值) { 偏移c = 偏移c查.值; }
            如果 (偏移c >= 0 && 字符串长度(字段类型文本c) > 0) {
                整64 尾字节c = 整64(字段类型文本c[整32(字符串长度(字段类型文本c) - 1)]) & 255;
                整64 地址c = 0 - 1;
                如果 (尾字节c != 42) {
                    地址c = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_字段地址, obj寄存器, 0, 0, 地址c, T_整64,
                                         偏移c));
                }
                如果 (地址c >= 0 && 是用户类(字段类型文本c)) {
                    可选<整64> 构造查c = 查类构造参数串(字段类型IDc, 0);
                    如果 (构造查c.有值) {
                        整64 对象c = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        整64 字段大小c = 0;
                        可选<整64> 字段大小c查 = 查结构体大小(字段类型IDc);
                        如果 (字段大小c查.有值) { 字段大小c = 字段大小c查.值; }
                        IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 对象c,
                                             字段大小c, 字段类型IDc));
                        IR追加(指令, 建IR指令(IR_调用实参, 对象c, 0, 0, 0, 0, 0));
                        IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                             整64(驻留(方法符号(字段类型文本c,
                                                                  剥实例基名(字段类型文本c),
                                                                  字符串复制(驻留文本(构造查c.值)))))));
                        IR追加(指令, 建IR指令(IR_指针存储, 地址c, 对象c, 0, 0, T_对象, 0));
                    }
                } 否则 如果 (地址c >= 0 && 是容器类(字段类型文本c)) {
                    整64 对象c2 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 对象c2,
                                         容器对象大小(字段类型文本c), 字段类型IDc));
                    IR追加(指令, 建IR指令(IR_调用实参, 对象c2, 0, 0, 0, 0, 0));
                    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                         整64(驻留(构造符号(字段类型文本c)))));
                    IR追加(指令, 建IR指令(IR_指针存储, 地址c, 对象c2, 0, 0, T_对象, 0));
                }
            }
        }
        i = i + 3;
    }
}

// 用户类方法调用发射（生成方法调用 的用户类分派出口）：this=位0 + 实参位1..
//   → 类$方法[#参数串] → 标量/字符串/指针/空类型返回按标量通道；
//   结构体/容器/结果返回=第一版边界（显式拒绝，不静默降级）。
// 328（2026-10-09·002·21）：父类限定判定——调用节点对象位=标识符「父类」且
//   方法体上下文（C++ Base::method 同款）→发射侧 虚槽强制静态（非虚分派）
函数 父类限定判定328(向量<节点> 池, 节点 n) -> 布尔 {
    如果 (当前方法类名ID == 0 || n.子起点 <= 0) { 返回 假; }
    节点 成员p = 池.元素(整32(n.子起点));
    如果 (成员p.类型 != 节点_成员 || 成员p.子起点 <= 0) { 返回 假; }
    节点 对象p = 池.元素(整32(成员p.子起点));
    // 1541 B2：有值=有基类（原 !=0 判据·无基类类不劫持「父类」同名标识符）
    可选<整64> 基限查328 = 查类基名(当前方法类名ID);
    返回 对象p.类型 == 节点_标识符 &&
          字符串比较(驻留文本(整64(对象p.文本)), "父类") &&
          基限查328.有值;
}

不安全 函数 发射用户类方法调用(字符串 类名, 字符串 方法名文本, 整64 this寄存器,
                    向量<整64>& 弹出们, 整64 实参数, 向量<IR指令>& 指令,
                    整64* 寄存器计数, 整64* 槽计数, 向量<整64>& 表达式栈,
                    整64 retbuf序号, 布尔 父类限定328) -> 空类型 {
    整64 类名ID = 驻留(类名);
    整64 方法名ID = 驻留(方法名文本);
    // 279（021 任务 279·#263 遗留缺口·365 实测 幼犬$自我介绍 undefined）：继承
    //   方法 **walk-up**——静态类型方法表 miss 时沿基类链找定义类，直调符号按
    //   **定义类**修饰（动物$自我介绍·零克隆零膨胀·Rust trait 静态分派同款）；
    //   this=子类对象布局前缀同构（父字段偏移已并入〔278〕=基类方法对子类对象
    //   安全）。虚方法不在此路（查虚方法槽 按静态类型分派走虚表）。
    // 1541 B2：无值=沿基链无此方法（原 0 判据）
    整64 定义类ID279 = 0;
    可选<整64> 定义层查279 = 查类方法定义层(类名ID, 方法名ID);
    如果 (定义层查279.有值) { 定义类ID279 = 定义层查279.值; }
    如果 (!定义层查279.有值) {
        IR层诊断("用户类无此方法（含基类链）: " + 类名 + "." + 方法名文本);
        运行时错误(6);
    }
    // 1541 B2：定义层已确认方法存在——两查询无值为不可达防御（原 0 承接）
    整64 返回类型ID = 0;
    可选<整64> 返回类型查279 = 查类方法返回(定义类ID279, 方法名ID);
    如果 (返回类型查279.有值) { 返回类型ID = 返回类型查279.值; }
    字符串 定义类名279 = 字符串复制(驻留文本(定义类ID279));
    字符串 参数串 = "";
    可选<整64> 参数串查279 = 查类方法参数串(定义类ID279, 方法名ID);
    如果 (参数串查279.有值) { 参数串 = 字符串复制(驻留文本(参数串查279.值)); }
    如果 (参数段个数(参数串) != 实参数) {
        IR层诊断("方法调用实参数不匹配（" + 类名 + "." + 方法名文本 +
                      "：期望 " + 整数转字符串(参数段个数(参数串)) + " 个）");
        运行时错误(6);
    }
    字符串 返回文本 = 字符串复制(驻留文本(返回类型ID));
    // T87（489-b）：聚合返回（结构体/结果/容器）走 retbuf 隐藏指针——与被调方
    //   生成方法 的「返回结构体ID/结果名ID!=0 → 槽计数=2（位0=retbuf/位1=this）」
    // 421（070·wt421）：128 位标量返回并入 retbuf ABI——被调方 生成方法
    //   返回128位!=0 已按「槽1=retbuf/槽2=this」布局（171 根治同步·B2 取值
    //   asm 实证），调用点判据漏 整128/正128 → retbuf 位缺位：调用点 rcx=this
    //   与被调方 rcx=retbuf 错配、rdx 残留垃圾被当 retbuf（B2 三重巧合假绿
    //   实录——rdx 恰为上一调用实参物化槽+内容恰同值+返回 this 恰作句柄）。
    布尔 返回128b = (字符串比较(返回文本, "整128") ||
                     字符串比较(返回文本, "正128"));
    // 1818（#1784 丁案 R1·与 生成类中 初始化方法签名同规）：非容器用户类方法
    //   返回=句柄 ABI（被调方 rax=句柄直传·无 sret）——排除聚合 retbuf 分派；
    //   返回类型排除面与被调方登记判据（是用户类_ID && !是容器类_ID）同源。
    //   1737 句柄分支（下方 !聚合返回 && 是用户类_ID→T_对象）自动落位。
    //   容器类实例返回维持聚合（是容器类 独立项·628 波 1·127_v2 护栏）。
    布尔 类句柄返回u = (是用户类_ID(返回类型ID) && !是容器类_ID(返回类型ID));
    布尔 聚合返回 = ((是结构体大小非零(返回类型ID) && !类句柄返回u) ||
                     是容器类(返回文本) ||
                     是结果类型(返回文本) || 是数组类型文本(返回文本) ||
                     返回128b);
    整64 返回类型码u = 类型码(返回类型ID);
    // 633（#633 残面②·v2 发射侧）：引用返回方法（返回文本尾 &）——rax=被引用
    //   对象地址（指针类·宿主 resultType="ptr" 对齐）；类型码(「货架&」)=T_未知
    //   → 下方「!聚合返回 && 类型码!=空/未知」目标寄存器分配被跳过（占位 0）
    //   → 下游消费 0 寄存器（992 守卫中止·探针 p2 实录）。显式排除聚合 retbuf
    //   并按指针类装载（T_对象）。
    // 933（任务 933·双侧零分叉）：引用返回标志——右值读值默认解引用在尾段
    //   （见「目标寄存器u != 0」处 933 注）。
    布尔 引用返回u933 = 假;
    如果 (字符串长度(返回文本) > 0 &&
        ((整64(返回文本[字符串长度(返回文本) - 1]) & 255) == 38)) {
        聚合返回 = 假;
        返回类型码u = T_对象;
        引用返回u933 = 真;
    }
    // 1737（任务 1737·2026-10-27）：用户类句柄返回（-> 类名·非引用非聚合）——
    //   类型码 查表域无用户类名=T_未知（IR容器签名.cn 648 归档：域外返回
    //   T_未知 是合法哨兵接口）→ 下方「!聚合返回 && 返回类型码u != T_空类型
    //   && != T_未知」目标寄存器分配被跳过（占位 0）+ 尾段「目标寄存器u != 0」
    //   压栈段同跳 → 返回值不物化不压栈 → 表达式栈残留 → 链式下一跳方法调用
    //   弹 this=栈残留垃圾槽（1596 探针 [992守卫] 槽号 -79=外层函数名负占位/
    //   栈空初始 0 实录·宿主同源码编译运行绿=零分叉红线）。类句柄=T_对象
    //   8 字节指针（被调方 生成方法 IR_返回(rax=句柄) 标量返回·1596 IR dump
    //   实证·宿主 emitCall 指针返回同构）——933 引用返回同款指针类装载。
    //   聚合面（泛型实例类已入结构体大小表·如入）不动：retbuf 形态既有语义
    //   零介入。引用返回（-> 类名&）带 & 文本非用户类 ID·933 已设不重入。
    如果 (!聚合返回 && 是用户类_ID(返回类型ID)) {
        返回类型码u = T_对象;
    }
    整64 起始位u = 1;
    整64 retbuf槽u = 0;
    整64 目标寄存器u = 0;
    如果 (聚合返回) {
        // 087b：聚合返回（含数组）装载码清零——retbuf 形态=地址标 0 整型类；
        //   数组文本 类型码 误折 T_整32 → movsxd 截断 retbuf 指针（596/597 同病）
        返回类型码u = 0;
        // 585-a（撤守卫收口·与 签名返回字节数 同族）：结果/可选 返回的 retbuf
        //   尺寸=结果大小——查结构体大小 对结果类型=0 → 旧码累计 0=帧无预留，
        //   sret 写踩相邻变量槽（268-a 口径：结果 值面 16B 起）
        整64 返回字节u = 0;
        可选<整64> 返回字节u查 = 查结构体大小(返回类型ID);
        如果 (返回字节u查.有值) { 返回字节u = 返回字节u查.值; }
        如果 (返回字节u == 0 && 是结果类型(返回文本)) {
            返回字节u = 结果大小(返回文本);
        }
        // 087b：数组返回字节=类型名宽度 967 折叠（结构体表 miss=0）
        如果 (返回字节u == 0 && 是数组类型文本(返回文本)) {
            返回字节u = 类型名宽度(返回类型ID);
        }
        // 421：128 位标量返回 retbuf=16 字节双槽（被调方 返回128位 双半拷配对）
        如果 (返回字节u == 0 && 返回128b) {
            返回字节u = 16;
        }
        累计retbuf字节数(返回字节u);
        retbuf槽u = retbuf序号;
        起始位u = 2;
        目标寄存器u = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
    }
    // 432-b 根治：用户类方法调用的 引用/结构体实参 回扫取地址（与自由函数
    //   路径 回扫结构体与引用实参 同款表驱动；收集实例方法实参引用 按同公式
    //   键登记）——缺失=引用形参传值→被调方解引用写崩（123 链查找 前驱 实测）
    // 279：直调符号按定义类修饰（walk-up·静态类型与定义类一致时同值零变化）
    整64 方法符号IDu = 整64(驻留(方法符号(定义类名279, 方法名文本, 参数串)));
    // 234（2026-10-06·91303）：虚方法动态分派——查虚方法槽 ≥0=虚（沿链继承+
    //   重写覆盖合成）·附加负编码=-槽-1（后端 63 展开分支：call [vptr+槽*8]）；
    //   聚合返回+虚=诚实挂账（宿主 431 聚合虚调用同域·后续轮同构）。
    //   328：父类限定**强制静态**（C++ Base::method 同款·非虚分派）——
    //   父类.虚方法() 若走虚表=动态分派到重写实现（递归/错派·21 实测形态），
    //   槽强制 -1=直调 基类$方法 符号（类名 已被上游重写为基类）。
    可选<整64> 虚槽查u = 查虚方法槽(类名ID, 方法名ID);
    // 1360 批5：结果化——有值=虚（沿链继承+重写覆盖合成）；
    //   328 父类限定强制静态（非虚分派）在此显式撤销结果位。
    整64 虚槽u = 0;   // 非虚时不被消费（是虚u=假；占位不可达）
    如果 (虚槽查u.有值) { 虚槽u = 虚槽查u.值; }
    布尔 是虚u = 虚槽查u.有值;
    如果 (父类限定328) { 是虚u = 假; }
    如果 (是虚u && 聚合返回) {
        IR层诊断("虚方法聚合返回暂不支持（234 挂账·宿主 431 同域）: " + 类名 + "." + 方法名文本);
        运行时错误(6);
    }
    回扫结构体与引用实参(弹出们, 方法符号IDu, 指令, 寄存器计数, 槽计数);
    IR追加(指令, 建IR指令(IR_调用实参, this寄存器, 0, 0, 0, 起始位u - 1, 0));
    发射调用实参们(弹出们, 起始位u, 指令, 实参类型码们(弹出们));
    如果 (!聚合返回 && 返回类型码u != T_空类型 && 返回类型码u != T_未知) {
        目标寄存器u = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
    }
    整64 附加u = 方法符号IDu;
    如果 (是虚u) { 附加u = 0 - 虚槽u - 1; }
    IR追加(指令, 建IR指令(IR_调用参数化, 起始位u + 实参数, 返回类型码u, 0,
                         目标寄存器u, retbuf槽u, 附加u));
    如果 (聚合返回) {
        // 421：128 位标量返回的 retbuf 句柄登记——打印传址/赋值双半拷/实参
        //   物化分派依赖寄存器类型表（与 发射普通函数调用 返回登记同型；
        //   结构体/结果消费按 retbuf 基址偏移不需要故仅在 128 位面登记）
        如果 (返回128b) {
            登记寄存器类型(目标寄存器u, 类型码(返回类型ID));
        }
        // 936（#936 同族·方法调用聚合返回物化单点对齐 81-a-v2）：真结构体返回
        //   （查结构体大小 != 0；结果/容器/数组/128 排除——它们按 retbuf 基址
        //   偏移消费，路径不变）——原直接压帧尾共享 retbuf 地址：赋值位消费
        //   依赖 结构体返回临时们 登记 → miss 拒「结构体赋值右值（调用返回）
        //   非结构体返回值」（v2a 探针 甲 = k.造(); 实录）；资源处置 1013
        //   亦 miss。物化后=独立槽+登记（与 发射普通函数调用 全链单点同构，
        //   叠加 物化结构体返回值 真=已压栈已返回 直接收口）。
        如果 (!返回128b && 是结构体大小非零(返回类型ID)) {
            如果 (物化结构体返回值(指令, 寄存器计数, 槽计数, 目标寄存器u,
                                    返回类型ID, 表达式栈)) {
                // 1538（2026-10-25）：方法面物化「拥有」标记——与 普通函数调用
                //   物化点（生成表达式求值尾）单一甄别源同构（函数符号拥有甄别
                //   1538：剥 # 后按 类$方法 键查 662 双表）。虚调用（附加u<0=
                //   动态分派·定义类方法体不可静态确认）不标记=保守不释放。
                如果 (是用户类_ID(返回类型ID) && 附加u >= 1 && 附加u < 键位移 &&
                     函数返回拥有甄别(附加u)) {
                    物化拥有登记1538(表达式栈.元素(表达式栈.大小() - 1));
                }
                返回;
            }
        }
        // retbuf 地址压栈（.正常/.值 成员偏移消费——容器 结果返回 同款不标量登记）
        结果<空类型, 整32> 加聚 = 表达式栈.追加(目标寄存器u);
        如果 (!加聚.正常) { 运行时错误(4); }
        返回;
    }
    如果 (目标寄存器u != 0) {
        // 933（任务 933·双侧零分叉·对齐宿主 118/986 与函数调用「发射引用返回
        //   加载」同面）：引用返回方法（-> T&）——rax=被引用左值地址，**右值
        //   读值默认解引用**（IR_指针加载·读宽=剥&类型精确码）。修复前 rax
        //   地址直压栈=「地址当句柄/值」静默坏值：字符串值接收（字符串 副 =
        //   b.读名();）副≠源内容、字符串长度/拼接读地址处字节垃圾（933 探针
        //   实录）。地址语义消费点（赋值目标/复合赋值/引用绑定/深拷源）经
        //   生成左值地址 回扫「IR_指针加载.操作数1」取回调用原址（rax）——
        //   与函数调用解引用后回扫逐字同款（632/118/生成左值地址 三处兼容）。
        如果 (引用返回u933) {
            发射引用返回加载(指令, 寄存器计数, 目标寄存器u, 返回文本, 表达式栈);
            返回;
        }
        登记寄存器类型(目标寄存器u, 返回类型码u);
        // 1818（丁案 R1）：类返回句柄临时登记（方法面·与 普通函数调用登记点
        //   同一甄别源 函数返回拥有甄别——虚调用（附加u<0）不登记=宁漏勿错）。
        如果 (类句柄返回u && 附加u >= 1 && 附加u < 键位移 &&
             函数返回拥有甄别(附加u)) {
            类返回句柄登记(目标寄存器u, 返回类型ID);
        }
        结果<空类型, 整32> 加方 = 表达式栈.追加(目标寄存器u);
        如果 (!加方.正常) { 运行时错误(4); }
    }
}

// 参数段个数（0=无参；深度 0 处逗号数+1）——构造/方法调用实参数匹配校验用
//   （对齐 v2 用户函数重载决议的 参数个数 口径）
// 031（#1075）：升级括号深度感知——原只数逗号：函数指针多参形参
//   整32(*f)(整32,整32) 参数串内层逗号被多算（既有计数缺陷）；方法值形参
//   方法值<类>(函数指针<返回>(参数表)) 内部逗号同受保护。与 取参数段/
//   参数串段数 同口径（三层切分器单点统一）。
函数 参数段个数(字符串 参数串) -> 整64 {
    如果 (字符串长度(参数串) == 0) { 返回 0; }
    整64 个数 = 1;
    整64 深度 = 0;
    整64 i = 0;
    当 (i < 字符串长度(参数串)) {
        整64 字节 = 整64(参数串[i]) & 255;
        如果 (字节 == 40) { 深度++; }
        否则 如果 (字节 == 41) {
            如果 (深度 > 0) { 深度--; }
        } 否则 如果 (字节 == 44) {
            如果 (深度 == 0) { 个数++; }
        }
        i++;
    }
    返回 个数;
}

