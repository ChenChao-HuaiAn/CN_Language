// CN 自举编译器 v2：结构化 IR 生成器（自举重建 P5，2026-08-25）
// 性能最优架构第三层：AST 节点池（后缀表达式栈）-> 三地址码 IR 指令数组。
// 设计（对标 rustc/LLVM）：
//   - 指令为结构化结构体（操作码/操作数/结果寄存器/类型码/附加），非字符串行。
//   - 寄存器 = 整数 ID（虚拟寄存器，代码生成阶段映射到栈槽）。
//   - 表达式按后缀栈求值：遍历节点池区间，字面量/标识符压栈（生成加载指令），
//     二元/后缀操作符弹栈生成运算指令，结果压栈。
//   - 语句按 子起点/子终点 区间遍历；变量声明分配槽（映射 名ID -> 槽索引）。
// 依赖：P2 词法（Token）/ P3 语法（节点池）/ P4 语义（类型检查）。
// 说明：本组件只生成 IR 指令（不含汇编输出——汇编在 P6 代码生成组件）。

导入 容器::向量;
导入 语法;       // Token/AST 节点池（原 语法分析，阶段目录包名）
导入 IR;         // 容器判定/符号合成 + IR_*/T_* 操作码（原 IR容器+IR常量 合并目录包名）
               //   单一归属 IR常量.cn（原定义在本文件顶层，IR容器 引用不可导=循环）

公开:
// D1 行数整改 123-a：自 IR生成.cn 按族拆出——类型解析/推导族（解析调用返回结构体 + 解析成员链结构体ID + 推导下标元素类型ID + 推导成员链类型ID + 推导下标数组长度 + 取成员宽度码 ｜ 实参类型码们 + 转换符号 + 解析标识符类型ID + 解析节点类型ID + 推导实参类型文本 + 实参段匹配 + 决议函数符号 + 解析方法对象类型 + 解析方法对象类型扩展；纯重构零行为变更；族内不直接访问文件级静态）

函数 解析调用返回结构体(向量<节点> 池, 整32 调用索引) -> 整64 {
    节点 调用节点 = 池.元素(调用索引);
    如果 (调用节点.类型 != 节点_调用 || 调用节点.子起点 <= 0) { 返回 0; }
    节点 被调成员 = 池.元素(整32(调用节点.子起点));
    如果 (被调成员.类型 == 节点_标识符) {
        整64 返回类型f = 查函数返回回退(整64(被调成员.文本));
        如果 (查结构体大小(返回类型f) != 0) {
            返回 返回类型f;
        }
        返回 0;
    }
    如果 (被调成员.类型 != 节点_成员 || 被调成员.附加 != 成员方法标记) { 返回 0; }
    整64 对象类型ID = 解析节点类型ID(池, 整32(被调成员.子起点));
    如果 (对象类型ID == 0) { 返回 0; }
    字符串 类名 = 字符串复制(驻留文本(对象类型ID));
    如果 (!是容器类(类名)) { 返回 0; }
    方法签名 签;
    如果 (!查方法签名(类名, 驻留文本(整64(被调成员.文本)), 调用节点.附加, &签)) { 返回 0; }
    如果 (字符串长度(签.返回文本) == 0) { 返回 0; }
    返回 驻留(签.返回文本);
}

// 解析成员链对象的结构体ID（186 根治，2026-09-09）：取成员宽度码 的对象解析
//   统一入口——原实现只认 标识符/调用 两形态，对象=节点_成员（链式，如构造
//   字面量脱糖产物 中间.右下 以 成员节点 r.左上 为对象）无分支回退 T_整64
//   -> 叶字段按 8 字节存储越界踩邻字段（E2E 186 s1=0 实锤：p = 点{7,9}
//   的写入被踩成 {0,9}）。递归解父链：
//   标识符 -> 解析对象结构体ID（函数级权威表优先，行为不变）；
//   成员   -> 父链结构体ID 递归 + 查字段类型ID（字段类型表第四十三轮已全字段
//             登记，键基域幂等）+ 查结构体类型 归一键基；
//   调用   -> 解析调用返回结构体（查结构体大小!=0 守卫保持）。
//   0=非结构体对象（宽度码落 T_整64=旧行为）。
函数 解析成员链结构体ID(向量<节点> 池, 整32 对象索引) -> 整64 {
    节点 对象节点 = 池.元素(对象索引);
    如果 (对象节点.类型 == 节点_标识符) { 返回 解析对象结构体ID(对象节点); }
    如果 (对象节点.类型 == 节点_成员) {
        整64 父结构体ID = 解析成员链结构体ID(池, 整32(对象节点.子起点));
        如果 (父结构体ID == 0) { 返回 0; }
        整64 字段类型ID = 查字段类型ID(父结构体ID, 整64(对象节点.文本));
        如果 (字段类型ID == 0) { 返回 0; }
        // 97-a（2026-09-13 第九十七轮 C8）：字段类型是**数组**（结构体字段数组
        //   `行[2] 两行`）——元素结构体（嵌套链 t.两行[1].分数 的结构体键推导：
        //   数组字段 -> 元素类型 -> 结构体表）。原实现直接 查结构体类型(字段类型ID)
        //   对数组文本返回 0 -> 链上后续成员偏移推导失败（fld5 探针实证）
        字符串 字段文本97c = 字符串复制(驻留文本(字段类型ID));
        如果 (是数组类型文本(字段文本97c)) {
            字符串 元素文本97c = 数组元素文本(字段文本97c);
            如果 (字符串长度(元素文本97c) > 0) {
                返回 查结构体类型(驻留(元素文本97c));
            }
        }
        返回 查结构体类型(字段类型ID);
    }
    如果 (对象节点.类型 == 节点_调用) {
        整64 返回结构体ID = 解析调用返回结构体(池, 对象索引);
        如果 (返回结构体ID != 0 && 查结构体大小(返回结构体ID) != 0) {
            返回 返回结构体ID;
        }
    }
    // 94-a（2026-09-13 第九十四轮）：对象=下标表达式（结构体数组元素 `表[0].x` /
    //   `表[i].x`）——下标对象标识符经 数组元素结构体表（语法层数组声明登记）
    //   推导元素结构体键（消费点：生成字段访问右值 / 顺序链成员地址左值的
    //   偏移-宽度-类型码三元组）
    如果 (对象节点.类型 == 节点_下标 && 对象节点.子起点 > 0) {
        节点 下标对象94 = 池.元素(整32(对象节点.子起点));
        如果 (下标对象94.类型 == 节点_标识符) {
            整64 元素键i94 = 查数组元素结构体键94(整64(下标对象94.文本));
            如果 (元素键i94 > 0) { 返回 元素键i94; }
        }
        // 97-a（2026-09-13 第九十七轮 C8）：下标对象=成员（**结构体字段数组**
        //   元素 t.两行[1]）——元素结构体直接经 解析成员链结构体ID(成员) 取得
        //   （成员分支已对数组字段返回元素结构体：总表.两行="行[2]" -> 行）。
        //   注：首版误在上层再做一次「字段查询（行.两行）」，恒 miss -> 返回 0
        //   （fld7 探针实证：字段类型=0）；修正=删除多余字段查询层。
        如果 (下标对象94.类型 == 节点_成员) {
            整64 元素键97f = 解析成员链结构体ID(池, 整32(对象节点.子起点));
            如果 (元素键97f > 0) { 返回 元素键97f; }
        }
    }
    返回 0;
}

// 97-a（2026-09-13 第九十七轮 C8）：下标对象**元素类型**推导——返回元素类型名ID
//   （0=非数组/未知）。形态：①对象=标识符（数组变量：当前函数变量类型文本是数组
//   -> 元素文本；否则指针变量表 -> 所指类型即元素）；②对象=成员（结构体字段数组：
//   解析成员链结构体ID 取字段类型 -> 数组 -> 元素文本）。
//   消费点：生成下标访问（步进/宽度/越界长度）+ 顺序链下标地址（左值链步进）。
不安全 函数 推导下标元素类型ID(向量<节点> 池, 整32 对象索引) -> 整64 {
    // 97-a：对象类型统一经 推导成员链类型ID（标识符/成员/下标 通用类型级推导——
    //   嵌套链 t.两行[1].分数 的字段类型=整32[3] 由此取得；原实现各形态手写，
    //   对"成员链中间含下标"（字段数组元素）无路径）
    整64 类型IDq = 推导成员链类型ID(池, 对象索引);
    如果 (类型IDq > 0) {
        字符串 文本q = 字符串复制(驻留文本(类型IDq));
        如果 (是数组类型文本(文本q)) {
            字符串 元素q = 数组元素文本(文本q);
            如果 (字符串长度(元素q) > 0) { 返回 驻留(元素q); }
        }
    }
    // 指针变量对象（下标对象=指针）：所指类型即元素
    节点 对象q = 池.元素(对象索引);
    如果 (对象q.类型 == 节点_标识符) {
        整64 查指针q = 查指针变量类型(整64(对象q.文本));
        如果 (查指针q >= 0) { 返回 查指针q; }
    }
    // 432-b（撤守卫·克隆体）：裸字段/成员链指针对象（K* 键数组[i]、其他.数据[j]）
    //   ——对象类型（函数级权威表/字段类型表）带 * 尾→剥指针层返回所指元素
    //   类型；原 miss=所指ID 0→字符串下标回退（__cn_str_len(字段值) SEGV 实测）
    整64 对象类型q2 = 推导成员链类型ID(池, 对象索引);    如果 (对象类型q2 > 0) {
        字符串 对象文本q2 = 字符串复制(驻留文本(对象类型q2));
        整64 长q2 = 字符串长度(对象文本q2);
        如果 (长q2 > 1 && 字符串比较(字符串子串(对象文本q2, 整32(长q2 - 1), 1), "*")) {
            返回 整64(驻留(字符串子串(对象文本q2, 0, 整32(长q2 - 1))));
        }
    }
    返回 0;
}

// 97-a：成员链**类型级**推导（IR）——返回节点表达式的类型名ID（0=不可推导）。
//   形态递归：标识符（当前函数变量类型）＞ 成员（父类型归一为结构体 -> 字段类型；
//   父类型是数组则先取元素）＞ 下标（父类型是数组则取元素；指针对象经调用方兜底）。
//   与 解析成员链结构体ID（结构体**键**级，字段偏移消费）互补：本函数回答"这个
//   表达式是什么类型"，是类型/宽度/元素推导的通用入口。
不安全 函数 推导成员链类型ID(向量<节点> 池, 整32 节点索引) -> 整64 {
    节点 n97 = 池.元素(节点索引);
    如果 (n97.类型 == 节点_标识符) {
        整64 类型ID97 = 查当前函数变量类型(整64(n97.文本));
        如果 (类型ID97 >= 0) { 返回 类型ID97; }
        返回 0;
    }
    如果 (n97.类型 == 节点_成员 && n97.子起点 > 0) {
        整64 父类型97 = 推导成员链类型ID(池, 整32(n97.子起点));
        如果 (父类型97 == 0) { 返回 0; }
        字符串 父文本97 = 字符串复制(驻留文本(父类型97));
        如果 (是数组类型文本(父文本97)) {
            字符串 父元素97 = 数组元素文本(父文本97);
            如果 (字符串长度(父元素97) > 0) { 父类型97 = 驻留(父元素97); }
        }
        整64 结构体97d = 查结构体类型(父类型97);
        如果 (结构体97d == 0) { 返回 0; }
        返回 查字段类型ID(结构体97d, 整64(n97.文本));
    }
    如果 (n97.类型 == 节点_下标 && n97.子起点 > 0) {
        整64 父类型97e = 推导成员链类型ID(池, 整32(n97.子起点));
        如果 (父类型97e == 0) { 返回 0; }
        字符串 父文本97e = 字符串复制(驻留文本(父类型97e));
        如果 (是数组类型文本(父文本97e)) {
            字符串 父元素97e = 数组元素文本(父文本97e);
            如果 (字符串长度(父元素97e) > 0) { 返回 驻留(父元素97e); }
        }
        返回 0;
    }
    返回 0;
}

// 97-a：下标对象**数组长度**（越界检查用；0=非数组对象/未知）——与
//   推导下标元素类型ID 同判定路径（标识符变量类型文本 / 成员字段类型文本）。
不安全 函数 推导下标数组长度(向量<节点> 池, 整32 对象索引) -> 整64 {
    // 97-a：与 推导下标元素类型ID 同源（对象类型经 推导成员链类型ID 通用推导）
    整64 类型IDq = 推导成员链类型ID(池, 对象索引);
    如果 (类型IDq > 0) {
        字符串 文本q = 字符串复制(驻留文本(类型IDq));
        如果 (是数组类型文本(文本q)) { 返回 数组长度文本(文本q); }
    }
    返回 0;
}

// 取成员节点访问的宽度类型码（186 根治后：对象解析统一走 解析成员链结构体ID
//   ——标识符/成员链/调用 三形态；未登记防御默认 T_整64 与旧行为一致。
//   消费点唯一：生成语句.cn 赋值左值存储宽度——读路径 成员链 走生成字段访问
//   的「成员字段偏移未知」可见失败（观察项已立案，与本修复面无交叠））
函数 取成员宽度码(向量<节点> 池, 整32 成员索引) -> 整64 {
    节点 m = 池.元素(成员索引);
    如果 (m.类型 != 节点_成员) { 返回 T_整64; }
    整64 结构体ID = 解析成员链结构体ID(池, 整32(m.子起点));
    如果 (结构体ID != 0) { 返回 查字段宽度码(结构体ID, 整64(m.文本)); }
    返回 T_整64;
}
// 91-a（2026-09-13 第九十一轮）：实参寄存器列表 -> 类型码向量（与 弹出们 同序）
//   ——发射调用实参们 前置（IR_调用实参.操作数2 编码；调用点寄存器类分派）。
函数 实参类型码们(向量<整64> 弹出们) -> 向量<整64> {
    向量<整64> 码们 = 向量<整64>();
    整64 i = 0;
    当 (i < 弹出们.大小()) {
        结果<空类型, 整32> 加码 = 码们.追加(查寄存器类型(弹出们.元素(i)));
        如果 (!加码.正常) { 运行时错误(4); }
        i++;
    }
    返回 码们;
}

// 数值/布尔 -> 字符串 转换符号（拼接隐式转换用；宿主 ir_call 对齐。
//   未登记/整数一律 from_int；浮32 场景 v2 浮点面未开（③ 后续），先归 float）
函数 转换符号(整64 码) -> 字符串 {
    如果 (码 == T_浮32 || 码 == T_浮64) { 返回 "__cn_str_from_float"; }
    如果 (码 == T_布尔) { 返回 "__cn_str_from_bool"; }
    返回 "__cn_str_from_int";
}

// 标识符类型解析（函数级权威 -> 解析期容器表 -> 顶层静态表 -> 解析期结构体表）；
//   返回类型名ID（容器合成名/结构体名/结果名）；0=未知
函数 解析标识符类型ID(整64 名ID) -> 整64 {
    整64 查本函数 = 查当前函数变量类型(名ID);
    如果 (查本函数 >= 0) { 返回 查本函数; }
    整64 容器ID = 查容器类型(名ID);
    如果 (容器ID != 0) { 返回 容器ID; }
    // 87-a（2026-09-12 第八十七轮）：顶层静态变量——静态表类型（结构体静态的
    //   类型解析入口：整体赋值/成员链/实参位移轴）。原缺此级 → 静态结构体的
    //   整体赋值 查结构体大小==0 提前返回假（静态槽静默零写，探针 P50b 实证）。
    整64 找静类 = 查静态序号(名ID);
    如果 (找静类 >= 0) { 返回 取静态类型(找静类); }
    返回 查结构体类型(名ID);
}

// ==================== 方法调用对象类型统一解析（②c A/B，2026-09-02） ====================
// 后缀链任意节点的类型推导（递归）：标识符（容器变量/结构体变量）、成员
//（基类型为结构体 -> 字段类型）、调用（返回容器/返回结构体）。返回类型名ID；0=未知。
函数 解析节点类型ID(向量<节点> 池, 整32 节点索引) -> 整64 {
    节点 n = 池.元素(节点索引);
    如果 (n.类型 == 节点_标识符) {
        返回 解析标识符类型ID(整64(n.文本));
    }
    如果 (n.类型 == 节点_成员) {
        // 对象.字段：基类型为结构体 -> 分桶字段类型（b.表 -> 向量$整64）
        整64 基类型ID = 解析节点类型ID(池, n.子起点);
        如果 (基类型ID != 0 && 查结构体大小(基类型ID) != 0) {
            返回 查字段类型ID(基类型ID, 整64(n.文本));
        }
        返回 0;
    }
    如果 (n.类型 == 节点_调用) {
        整64 容器返回ID = 解析调用返回容器(池, 节点索引);
        如果 (容器返回ID != 0) { 返回 容器返回ID; }
        返回 解析调用返回结构体(池, 节点索引);
    }
    如果 (n.类型 == 节点_三元运算) {
        // 86-a（2026-09-12 复审缺陷①）：三元结果类型=两分支类型（语义层保证
        //   统一）——递归真/假分支末节点（真分支空时取假分支，与宿主
        //   exprSrcType 的 TernaryExpr 分支同款）。原缺此分支 → 类型推导 0 →
        //   赋值/声明位同型校验失败（P46 v2「左右类型不同」诊断实证）。
        如果 (n.文本 < n.附加) {
            整64 真类型IDt = 解析节点类型ID(池, 整32(n.附加 - 1));
            如果 (真类型IDt != 0) { 返回 真类型IDt; }
        }
        如果 (n.附加 < n.子终点) {
            返回 解析节点类型ID(池, 整32(n.子终点 - 1));
        }
        返回 0;
    }
    返回 0;
}

// ==================== 函数重载决议（呈报③方案A，2026-09-06） =====================
// 规格书 §函数重载（plans/001:358）：同名按参数类型与个数区分。决议序（宿主
//   resolveOverload 简化对齐——v2 无模块系统=无模块过滤；隐式转换面=字面量
//   宽匹配，变量窄宽转换不做=不扩权）：
//   a. 签名表候选 0 -> 返回纯名（内置/打印/运行时——不进签名表，路径不变）
//   b. 个数过滤后精确匹配（实参段==参数段逐字节）
//   c. 字面量宽匹配（整数字面量段 通配整族/浮族；浮字面量 通配浮族；推导
//      失败空段=通配——安全网）
//   d. 精确命中唯一 -> 该签名键；宽命中唯一 -> 该签名键；多命中 -> IR层诊断
//      歧义（fail fast，绝不静默选）
//   e. 类型层 0 命中但个数匹配候选唯一 -> 该候选（宽容层：类型推导不全不误伤）
//   f. 其余 -> IR层诊断决议失败（同名多候选且类型不可辨=必须显式，与 C++
//      二义性一致）
// 返回 决议后函数符号ID（签名键/纯名）；诊断后返回 0（IR 层错误即中止纪律）。

// 实参类型文本推导（静态单节点）：字面量按语义层口径（整数字面量=整32）、
//   标识符走 解析标识符类型ID（权威表含标量/结构体/容器/参数）、成员/调用走
//   解析节点类型ID。未知形态返回 空串（决议时按通配处理）。
// A2（2026-09-11 方案甲）：返回 字符串->字符*——字面量分支只读段借用+驻留分支
//   驻留表借用，全分支借用视图零拷贝（调用方持有须 字符串复制 落堆）。
函数 推导实参类型文本(向量<节点> 池, 整32 节点索引) -> 字符* {
    节点 n = 池.元素(节点索引);
    如果 (n.类型 == 节点_整数字面量) { 返回 "整32"; }
    如果 (n.类型 == 节点_浮点字面量) { 返回 "浮64"; }
    如果 (n.类型 == 节点_布尔字面量) { 返回 "布尔"; }
    如果 (n.类型 == 节点_字符串字面量) { 返回 "字符串"; }
    如果 (n.类型 == 节点_标识符) {
        整64 类型ID = 解析标识符类型ID(整64(n.文本));
        如果 (类型ID != 0) { 返回 驻留文本(类型ID); }
        返回 "";
    }
    如果 (n.类型 == 节点_成员 || n.类型 == 节点_调用) {
        整64 类型ID = 解析节点类型ID(池, 节点索引);
        如果 (类型ID != 0) { 返回 驻留文本(类型ID); }
        返回 "";
    }
    返回 "";
}

// 段匹配：实参段 vs 参数段——精确相等，或字面量宽匹配/空段通配
函数 实参段匹配(字符串 实段, 字符串 参段) -> 布尔 {
    如果 (字符串长度(实段) == 0) { 返回 真; }
    如果 (字符串比较(实段, 参段)) { 返回 真; }
    // 整数字面量（语义层口径 整32）通配整族/浮族（字面量无溢出场景按调用方
    //   意图匹配——宿主 canConvertType 字面量宽转换对齐）
    如果 (字符串比较(实段, "整32")) {
        如果 (字符串比较(参段, "整64") || 字符串比较(参段, "整8") ||
             字符串比较(参段, "整16") || 字符串比较(参段, "正8") ||
             字符串比较(参段, "正16") || 字符串比较(参段, "正32") ||
             字符串比较(参段, "正64") || 字符串比较(参段, "浮32") ||
             字符串比较(参段, "浮64") || 字符串比较(参段, "字符")) { 返回 真; }
    }
    如果 (字符串比较(实段, "浮64") &&
          (字符串比较(参段, "浮32") || 字符串比较(参段, "浮64"))) { 返回 真; }
    返回 假;
}

// 重载决议主入口：名ID+调用节点（实参区间 [子起点, 子起点+附加)）-> 函数符号ID
函数 决议函数符号(向量<节点> 池, 整64 名ID, 整32 调用索引) -> 整64 {
    // plans/018 第 4 层（2026-09-07）：键基 = 语义层三级决议产物（调用决议键基们
    //   ——语义驱动 IR，宿主 resolvedSignature=注册键 同构）。未登记（内置/
    //   类型转换/构造调用）= 纯名路径（行为不变）；用户函数在键基的候选集内
    //   重载决议，选中产物=链接键（键基 或 键基#参数串——定义侧同公式，跨模块
    //   同名 asm 符号天然隔离）。
    整64 键基d = 调用决议查询(整64(调用索引));
    如果 (键基d < 0) { 键基d = 名ID; }
    整64 候选数 = 0;
    整64 查数 = 查函数签名个数(键基d);
    如果 (查数 >= 0) { 候选数 = 查数; }
    如果 (候选数 == 0) { 返回 键基d; }   // 内置/打印/运行时——纯名路径不变
    节点 调用节点 = 池.元素(调用索引);
    整64 实参数 = 整64(调用节点.附加);
    // 实参类型段们（推导失败=空段，按通配处理）
    向量<字符串> 实段们 = 向量<字符串>();
    整64 i = 0;
    当 (i < 实参数) {
        // 实参节点区间 [子起点+1, 子起点+1+附加)：[子起点]=被调标识符
        //   （类型大小 折叠分支同款——[d18] 插桩实证：实参索引偏 1 时首实参
        //   读到被调节点（类型10）推导失败、尾实参越界，字面量重载全落宽匹配
        //   →假歧义）
        结果<空类型, 整32> 加段 = 实段们.追加(
            推导实参类型文本(池, 整32(调用节点.子起点) + 1 + 整32(i)));
        如果 (!加段.正常) { 运行时错误(4); }
        i++;
    }
    // 遍历候选：个数匹配 -> 精确/宽匹配
    整64 个数匹配序 = 0 - 1;    // 最后一个个数匹配候选序（-1=无）
    整64 个数匹配数 = 0;
    整64 精确序 = 0 - 1;
    整64 精确数 = 0;
    整64 宽序 = 0 - 1;
    整64 宽数 = 0;
    整64 k = 0;
    当 (k < 候选数) {
        结果<整64, 整32> 查串 = 函数签名参数串们.获取(键基d * 键位移 + k);
        如果 (查串.正常) {
            // 参数段经 取参数段 逐段取（越界返回 空串）；参数个数=逗号数+1
            //   （真数——初版误用实参数初始化被 fail fast 当场拦住：2/3 参重载
            //   全被判个数匹配→决议失败诊断；无参候选=0，不分割）
            字符串 参数串文本 = 字符串复制(驻留文本(查串.值));
            整64 参数个数 = 0;
            如果 (字符串长度(参数串文本) > 0) {
                参数个数 = 1;
                整64 ci = 0;
                当 (ci < 字符串长度(参数串文本)) {
                    整64 cb = 整64(参数串文本[ci]) & 255;
                    如果 (cb == 44) { 参数个数++; }
                    ci++;
                }
            }
            如果 (参数个数 == 实参数) {
                个数匹配序 = k;
                个数匹配数++;
                整64 段i = 0;
                布尔 全精确 = 真;
                布尔 全匹配 = 真;
                当 (段i < 实参数) {
                    字符串 参段 = 取参数段(参数串文本, 段i);
                    如果 (!字符串比较(实段们.元素(段i), 参段)) { 全精确 = 假; }
                    如果 (!实参段匹配(实段们.元素(段i), 参段)) { 全匹配 = 假; }
                    段i++;
                }
                如果 (全精确) { 精确序 = k; 精确数++; }
                否则 如果 (全匹配) { 宽序 = k; 宽数++; }
            }
        }
        k++;
    }
    整64 选中序 = 0 - 1;
    如果 (精确数 == 1) { 选中序 = 精确序; }
    否则 如果 (精确数 > 1) {
        IR层诊断("函数重载决议歧义: " + 驻留文本(名ID) + "（" +
                      整数转字符串(精确数) + " 个精确匹配候选）");
        返回 0;
    } 否则 如果 (宽数 == 1) { 选中序 = 宽序; }
    否则 如果 (宽数 > 1) {
        IR层诊断("函数重载决议歧义: " + 驻留文本(名ID) + "（" +
                      整数转字符串(宽数) + " 个宽匹配候选）");
        返回 0;
    } 否则 如果 (个数匹配数 == 1) { 选中序 = 个数匹配序; }
    否则 如果 (个数匹配数 > 1) {
        IR层诊断("函数重载决议失败: " + 驻留文本(名ID) + "（实参类型不可辨，" +
                      整数转字符串(个数匹配数) + " 个同参量候选）");
        返回 0;
    } 否则 {
        IR层诊断("函数重载决议失败: " + 驻留文本(名ID) + "（无 " +
                      整数转字符串(实参数) + " 参候选）");
        返回 0;
    }
    结果<整64, 整32> 查选中 = 函数签名参数串们.获取(键基d * 键位移 + 选中序);
    如果 (查选中.正常) {
        返回 函数签名键(键基d, 驻留文本(查选中.值));
    }
    返回 键基d;   // 防御：表态异常回落键基（未登记=纯名）
}

// 方法调用对象类型解析（表.追加 / b.表.追加 / 元素(0).设置 / 词池.元素(0).表.大小）：
//   经 解析节点类型ID 推导对象类型——容器直用；结构体则查方法名对应字段的容器类型。
// 返回容器合成类名ID；0=未知。
函数 解析方法对象类型(向量<节点> 池, 整32 调用索引) -> 整64 {
    节点 调用节点 = 池.元素(调用索引);
    如果 (调用节点.类型 != 节点_调用 || 调用节点.子起点 <= 0) { 返回 0; }
    节点 被调成员 = 池.元素(整32(调用节点.子起点));
    如果 (被调成员.类型 != 节点_成员) { 返回 0; }
    整64 对象类型ID = 解析节点类型ID(池, 整32(被调成员.子起点));
    如果 (对象类型ID != 0) {
        如果 (是容器类(驻留文本(对象类型ID))) { 返回 对象类型ID; }
        如果 (查结构体大小(对象类型ID) != 0) {
            整64 字段类型ID = 查字段类型ID(对象类型ID, 整64(被调成员.文本));
            如果 (字段类型ID != 0 && 是容器类(驻留文本(字段类型ID))) { 返回 字段类型ID; }
        }
    }
    返回 0;
}

// 方法调用对象类型解析·扩展版（第七十八轮，2026-09-12）：与 解析方法对象类型
//   同构，但对象类型不限于容器类——用户类对象同样返回（生成方法调用 的用户类
//   分派依据）。容器消费点（解析调用返回容器 等）保持用容器专版，行为不变。
函数 解析方法对象类型扩展(向量<节点> 池, 整32 调用索引) -> 整64 {
    节点 调用节点 = 池.元素(调用索引);
    如果 (调用节点.类型 != 节点_调用 || 调用节点.子起点 <= 0) { 返回 0; }
    节点 被调成员 = 池.元素(整32(调用节点.子起点));
    如果 (被调成员.类型 != 节点_成员) { 返回 0; }
    整64 对象类型ID = 解析节点类型ID(池, 整32(被调成员.子起点));
    如果 (对象类型ID != 0) {
        字符串 对象文本x = 字符串复制(驻留文本(对象类型ID));
        如果 (是容器类(对象文本x) || 是用户类(对象文本x)) { 返回 对象类型ID; }
        如果 (查结构体大小(对象类型ID) != 0) {
            整64 字段类型IDx = 查字段类型ID(对象类型ID, 整64(被调成员.文本));
            如果 (字段类型IDx != 0) {
                字符串 字段文本x = 字符串复制(驻留文本(字段类型IDx));
                如果 (是容器类(字段文本x) || 是用户类(字段文本x)) {
                    返回 字段类型IDx;
                }
            }
        }
    }
    返回 0;
}
