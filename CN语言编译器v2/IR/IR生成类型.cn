// CN 自举编译器 v2：结构化 IR 生成器（自举重建 P5，2026-08-25）
// 性能最优架构第三层：AST 节点池（后缀表达式栈）-> 三地址码 IR 指令数组。
// 设计（对标 rustc/LLVM）：
//   - 指令为结构化结构体（操作码/操作数/结果寄存器/类型码/附加），非字符串行。
//   - 寄存器 = 整数 ID（虚拟寄存器，代码生成阶段映射到栈槽）。
//   - 表达式按后缀栈求值：遍历节点池区间，字面量/标识符压栈（生成加载指令），
//     二元/后缀操作符弹栈生成运算指令，结果压栈。
//   - 语句按 子起点/子终点 区间遍历；变量声明分配槽（映射 名ID -> 槽索引）。
// 依赖：P2 词法（Token）/ P3 语法（节点池）/ P4 语义（类型检查）。
// 说明：本组件只生成 IR 指令（不含汇编输出——汇编在 P6 代码生成组件）。

导入 容器::向量;
导入 语法;       // Token/AST 节点池（原 语法分析，阶段目录包名）
导入 IR;         // 容器判定/符号合成 + IR_*/T_* 操作码（原 IR容器+IR常量 合并目录包名）
               //   单一归属 IR常量.cn（原定义在本文件顶层，IR容器 引用不可导=循环）

公开:

// 233：函数默认参数表（登记=登记函数签名K 尾段委托 IR容器·承载冻结线迁移）
静态 映射<整64, 整64> 函数签名默认数们;   // 键基ID*键位移+参数串ID -> 默认参数个数（尾连续·0=无）
静态 映射<整64, 整64> 函数默认参数根们;   // 键基ID*键位移+参数串ID*4096+参数序 -> 默认值根节点池索引

函数 决议函数符号(向量<节点> 池, 整64 名ID, 整32 调用索引,
                  整64& 键基出, 整64& 键串出, 整64& 段数出) -> 整64 {
    键基出 = 0;
    键串出 = 0;
    段数出 = 0;
    // plans/018 第 4 层（2026-09-07）：键基 = 语义层三级决议产物（调用决议键基们
    //   ——语义驱动 IR，宿主 resolvedSignature=注册键 同构）。未登记（内置/
    //   类型转换/构造调用）= 纯名路径（行为不变）；用户函数在键基的候选集内
    //   重载决议，选中产物=链接键（键基 或 键基#参数串——定义侧同公式，跨模块
    //   同名 asm 符号天然隔离）。
    // 957（FFI）：外部函数声明——链接符号=函数名本身（无 mangling·C 库
    //   供给·规格 5.3）——纯名直发不经统一链接键（键基#参数串 会造出 C 库
    //   不存在的符号）
    如果 (是外部函数名957(名ID)) {
        返回 名ID;
    }
    整64 键基d = 调用决议查询(整64(调用索引));
    布尔 决议命中1011 = 键基d >= 0;   // 1011（46·再导出）：语义已决议（限键基=
    //   实体键基——含再导出转发源）时 943 拆分不再覆盖（原无条件覆盖把
    //   网络::连接 的源键基 网络::传输控制$连接 改写成 网络$连接 →链接
    //   undefined；943 场景=语义登记 miss 域的回退，命中时零介入）。
    如果 (键基d < 0) { 键基d = 名ID; }
    // 943（工单Ⅰ 补）：限定名形态（B1 改写「模块::符号」）——语义登记 miss 域
    //   回退名ID=限定名整体→键基错位（引用 数学::平方根 ≠定义 数学$平方根·27
    //   实证）——非内置限定名拆分→键基合成；内置名豁免（宿主 ir_call 限定名
    //   内置直查优先于源码加载包——v2 树自举 IO:: 族源码包装签名与内置不同参）
    字符串 名d943 = 字符串复制(驻留文本(名ID));
    字符串 模943b = "";
    字符串 符943b = "";
    布尔 限定形态943 = 拆限定名(名d943, 模943b, 符943b) == 1;
    // 954（红灯治理·27 族真修）：限定名调用优先级=**本地用户符号 > 内置 >
    //   限定名整体**——本地模块定义同名函数（数学.cn 平方根）时用户优先
    //   （宿主 27 实证：期望 16=用户函数返回入参；943 转批验证被 v2p 缓存
    //   假绿骗过·内置豁免实际让 __cn_sqrt 抢占）；本地无定义（签名表 miss）
    //   才豁免走内置（v2 自举 IO:: 族）；用户类名豁免（50/394 族·954）
    布尔 本地有943 = 假;
    如果 (限定形态943) {
        本地有943 = 查函数签名个数(键基合成(模943b, 驻留(符943b))) > 0;
    }
    如果 (!决议命中1011 && 限定形态943 &&
         是用户类ID(驻留(符943b)) == 假 &&
         (字符串长度(内置函数符号(名d943)) == 0 || 本地有943)) {
        // 954（红灯治理·50/394 族）：用户类名豁免——B1 改写的跨文件类构造
        //   （工具::计数器→计数器()）拆成 模块$类名 后调用引用「工具$计数器」
        //   ≠ 定义侧类构造符号「计数器$计数器」（类$方法无模块前缀）→链接
        //   undefined（云端 50 实锤·951 构造分支×本拆分的组合缺陷）；类构造
        //   保持名ID 纯名→951 分支登记→类构造调用通道
        键基d = 键基合成(模943b, 驻留(符943b));
    }
    整64 候选数 = 0;
    整64 查数 = 查函数签名个数(键基d);
    如果 (查数 >= 0) { 候选数 = 查数; }
    如果 (候选数 == 0) { 返回 键基d; }   // 内置/打印/运行时——纯名路径不变
    节点 调用节点 = 池.元素(调用索引);
    整64 实参数 = 整64(调用节点.附加);
    // 实参类型段们（推导失败=空段，按通配处理）
    向量<字符串> 实段们 = 向量<字符串>();
    整64 i = 0;
    当 (i < 实参数) {
        // 实参节点区间 [子起点+1, 子起点+1+附加)：[子起点]=被调标识符
        //   （类型大小 折叠分支同款——[d18] 插桩实证：实参索引偏 1 时首实参
        //   读到被调节点（类型10）推导失败、尾实参越界，字面量重载全落宽匹配
        //   →假歧义）
        结果<空类型, 整32> 加段 = 实段们.追加(
            推导实参类型文本(池, 整32(调用节点.子起点) + 1 + 整32(i)));
        如果 (!加段.正常) { 运行时错误(4); }
        i++;
    }
    // 遍历候选：个数匹配 -> 精确/宽匹配
    整64 个数匹配序 = 0 - 1;    // 最后一个个数匹配候选序（-1=无）
    整64 个数匹配数 = 0;
    整64 精确序 = 0 - 1;
    整64 精确数 = 0;
    整64 宽序 = 0 - 1;
    整64 宽数 = 0;
    整64 宽级 = 99;
    整64 k = 0;
    当 (k < 候选数) {
        结果<整64, 整32> 查串 = 函数签名参数串们.获取(键基d * 键位移 + k);
        如果 (查串.正常) {
            // 参数段经 取参数段 逐段取（越界返回 空串）；参数个数=逗号数+1
            //   （真数——初版误用实参数初始化被 fail fast 当场拦住：2/3 参重载
            //   全被判个数匹配→决议失败诊断；无参候选=0，不分割）
            字符串 参数串文本 = 字符串复制(驻留文本(查串.值));
            // T69（480-a）：参数个数=参数串段数（深度感知单一归属——函数指针
            //   类型文本顶层含逗号，简单数逗号会把 1 参数误判为 2）
            整64 参数个数 = 参数串段数(参数串文本);
            // 233：默认参数放宽——实参数 ∈ [参数个数-默认数, 参数个数] 皆命中
            //   （默认数=尾连续·缺段序==参数序·补缺直查）
            整64 默认数k = 查函数签名默认数(键基d, 查串.值);
            IO::打印到错误("[dbg233] 候选k=" + 整数转字符串(k) + " 参段=" + 整数转字符串(参数个数) + " 实参=" + 整数转字符串(实参数) + " 默认=" + 整数转字符串(默认数k) + "\n");
            如果 (参数个数 == 实参数 ||
                 (默认数k > 0 && 实参数 < 参数个数 &&
                  实参数 >= 参数个数 - 默认数k)) {
                个数匹配序 = k;
                个数匹配数++;
                整64 段i = 0;
                整64 候选级 = 0;
                布尔 全匹配 = 真;
                当 (段i < 实参数) {
                    字符串 参段 = 取参数段(参数串文本, 段i);
                    整64 段级 = 实参段匹配级(实段们.元素(段i), 参段);
                    如果 (段级 >= 99) { 全匹配 = 假; }
                    否则 如果 (段级 > 候选级) { 候选级 = 段级; }
                    段i++;
                }
                如果 (全匹配 && 候选级 == 0) { 精确序 = k; 精确数++; }
                否则 如果 (全匹配) {
                    // 231：跨级择优——级小者胜（同级>1 仍歧义·宿主同语义）
                    如果 (宽数 == 0 || 候选级 < 宽级) { 宽序 = k; 宽级 = 候选级; 宽数 = 1; }
                    否则 如果 (候选级 == 宽级) { 宽数++; }
                }
            }
        }
        k++;
    }
    整64 选中序 = 0 - 1;
    如果 (精确数 == 1) { 选中序 = 精确序; }
    否则 如果 (精确数 > 1) {
        IR层诊断("函数重载决议歧义: " + 驻留文本(名ID) + "（" +
                      整数转字符串(精确数) + " 个精确匹配候选）");
        返回 0;
    } 否则 如果 (宽数 >= 1) {
        // 231：级小者已单点胜出（宽级 单点·同级>1 才歧义·宿主 total 最小同构）
        如果 (宽数 == 1) { 选中序 = 宽序; }
        否则 {
            IR层诊断("函数重载决议歧义: " + 驻留文本(名ID) + "（" +
                          整数转字符串(宽数) + " 个宽匹配候选）");
            返回 0;
        }
    } 否则 如果 (个数匹配数 == 1) { 选中序 = 个数匹配序; }
    否则 如果 (个数匹配数 > 1) {
        IR层诊断("函数重载决议失败: " + 驻留文本(名ID) + "（实参类型不可辨，" +
                      整数转字符串(个数匹配数) + " 个同参量候选）");
        返回 0;
    } 否则 {
        IR层诊断("函数重载决议失败: " + 驻留文本(名ID) + "（无 " +
                      整数转字符串(实参数) + " 参候选）");
        返回 0;
    }
    结果<整64, 整32> 查选中 = 函数签名参数串们.获取(键基d * 键位移 + 选中序);
    // 233：选中候选出参回填（默认数/键基/参数串 ID——生成补缺消费）
    如果 (查选中.正常) {
        键基出 = 键基d;
        键串出 = 查选中.值;
        段数出 = 参数串段数(字符串复制(驻留文本(查选中.值)));
        返回 统一链接键(键基d, 名ID, 驻留文本(查选中.值));
    }
    返回 统一链接键(键基d, 名ID, "");   // 防御：无选中串（未登记=键基/克隆名）
}

// 方法调用对象类型解析（表.追加 / b.表.追加 / 元素(0).设置 / 词池.元素(0).表.大小）：
//   经 解析节点类型ID 推导对象类型——容器直用；结构体则查方法名对应字段的容器类型。
// 返回容器合成类名ID；0=未知。
函数 解析方法对象类型(向量<节点> 池, 整32 调用索引) -> 整64 {
    节点 调用节点 = 池.元素(调用索引);
    如果 (调用节点.类型 != 节点_调用 || 调用节点.子起点 <= 0) { 返回 0; }
    节点 被调成员 = 池.元素(整32(调用节点.子起点));
    如果 (被调成员.类型 != 节点_成员) { 返回 0; }
    整64 对象类型ID = 解析节点类型ID(池, 整32(被调成员.子起点));
    如果 (对象类型ID != 0) {
        如果 (是容器类(驻留文本(对象类型ID))) { 返回 对象类型ID; }
        如果 (查结构体大小(对象类型ID) != 0) {
            整64 字段类型ID = 查字段类型ID(对象类型ID, 整64(被调成员.文本));
            如果 (字段类型ID != 0 && 是容器类(驻留文本(字段类型ID))) { 返回 字段类型ID; }
        }
    }
    返回 0;
}

// 方法调用对象类型解析·扩展版（第七十八轮，2026-09-12）：与 解析方法对象类型
//   同构，但对象类型不限于容器类——用户类对象同样返回（生成方法调用 的用户类
//   分派依据）。容器消费点（解析调用返回容器 等）保持用容器专版，行为不变。
函数 解析方法对象类型扩展(向量<节点> 池, 整32 调用索引) -> 整64 {
    节点 调用节点 = 池.元素(调用索引);
    如果 (调用节点.类型 != 节点_调用 || 调用节点.子起点 <= 0) { 返回 0; }
    节点 被调成员 = 池.元素(整32(调用节点.子起点));
    如果 (被调成员.类型 != 节点_成员) { 返回 0; }
    整64 对象类型ID = 解析节点类型ID(池, 整32(被调成员.子起点));
    如果 (对象类型ID != 0) {
        字符串 对象文本x = 字符串复制(驻留文本(对象类型ID));
        如果 (是容器类(对象文本x) || 是用户类(对象文本x)) { 返回 对象类型ID; }
        如果 (查结构体大小(对象类型ID) != 0) {
            整64 字段类型IDx = 查字段类型ID(对象类型ID, 整64(被调成员.文本));
            如果 (字段类型IDx != 0) {
                字符串 字段文本x = 字符串复制(驻留文本(字段类型IDx));
                如果 (是容器类(字段文本x) || 是用户类(字段文本x)) {
                    返回 字段类型IDx;
                }
            }
        }
    }
    返回 0;
}

// 233：查函数签名默认参数个数（0=无默认·决议参数个数匹配放宽消费）
函数 查函数签名默认数(整64 键基ID, 整64 参数串ID) -> 整64 {
    如果 (参数串ID <= 0) { 返回 0; }
    结果<整64, 整32> 查 = 函数签名默认数们.获取(键基ID * 键位移 + 参数串ID);
    如果 (查.正常) { 返回 查.值; }
    返回 0;
}
// D1 行数整改 123-a：自 IR生成.cn 按族拆出——类型解析/推导族（解析调用返回结构体 + 解析成员链结构体ID + 推导下标元素类型ID + 推导成员链类型ID + 推导下标数组长度 + 取成员宽度码 ｜ 实参类型码们 + 转换符号 + 解析标识符类型ID + 解析节点类型ID + 推导实参类型文本 + 实参段匹配 + 决议函数符号 + 解析方法对象类型 + 解析方法对象类型扩展；纯重构零行为变更；族内不直接访问文件级静态）

函数 解析调用返回结构体(向量<节点> 池, 整32 调用索引) -> 整64 {
    节点 调用节点 = 池.元素(调用索引);
    如果 (调用节点.类型 != 节点_调用 || 调用节点.子起点 <= 0) { 返回 0; }
    节点 被调成员 = 池.元素(整32(调用节点.子起点));
    如果 (被调成员.类型 == 节点_标识符) {
        整64 返回类型f = 查函数返回回退(整64(被调成员.文本));
        如果 (查结构体大小(返回类型f) != 0) {
            返回 返回类型f;
        }
        返回 0;
    }
    如果 (被调成员.类型 != 节点_成员 || 被调成员.附加 != 成员方法标记) { 返回 0; }
    整64 对象类型ID = 解析节点类型ID(池, 整32(被调成员.子起点));
    如果 (对象类型ID == 0) { 返回 0; }
    字符串 类名 = 字符串复制(驻留文本(对象类型ID));
    如果 (!是容器类(类名)) { 返回 0; }
    方法签名 签;
    如果 (!查方法签名(类名, 驻留文本(整64(被调成员.文本)), 调用节点.附加, &签)) { 返回 0; }
    如果 (字符串长度(签.返回文本) == 0) { 返回 0; }
    // 118（929·任务 118）：引用返回方法（元素引用 -> T&·签名表 829 起保留
    //   尾 '&'）——剥尾 & 取基础结构体（带 & 名查字段偏移恒 miss → 链式
    //   字段写 表.元素引用(0).x = 9 「成员左值字段偏移未知」拒绝）。
    字符串 返回基名e = 字符串复制(签.返回文本);
    如果 (字符串长度(返回基名e) > 1 &&
         ((整64(返回基名e[整32(字符串长度(返回基名e) - 1)]) & 255) == 38)) {
        返回基名e = 字符串子串(返回基名e, 0, 字符串长度(返回基名e) - 1);
    }
    返回 驻留(返回基名e);
}

// 1014（链式访问根治）：调用返回类型 ID——**无 查结构体大小 守卫**版。
//   结果/可选 合成体不走结构体布局桶（解析调用返回结构体 的守卫恒挡→返回 0）
//   →族① 调用分支拿不到类型 →族② 解析结果可选兜底 前提（成员对象类型ID!=0）
//   不成立而跳过 →族③ 解析右值偏移兜底 只认标识符/成员/三元 →
//   [ir2] 成员字段偏移未知（映射.获取(k).正常 / 取结果(x).正常 实证）。
//   本函数只解析类型 ID（标识符被调=查函数返回回退；方法被调=查方法签名
//   返回文本·剥尾 & 同 118），偏移/宽度仍由族①桶查与族②合成布局负责。
函数 解析调用返回类型ID(向量<节点> 池, 整32 调用索引) -> 整64 {
    节点 调用节点 = 池.元素(调用索引);
    如果 (调用节点.类型 != 节点_调用 || 调用节点.子起点 <= 0) { 返回 0; }
    节点 被调成员 = 池.元素(整32(调用节点.子起点));
    如果 (被调成员.类型 == 节点_标识符) {
        返回 查函数返回回退(整64(被调成员.文本));
    }
    如果 (被调成员.类型 != 节点_成员 || 被调成员.附加 != 成员方法标记) { 返回 0; }
    整64 对象类型IDc = 解析节点类型ID(池, 整32(被调成员.子起点));
    如果 (对象类型IDc == 0) { 返回 0; }
    字符串 类名c = 字符串复制(驻留文本(对象类型IDc));
    如果 (!是容器类(类名c)) { 返回 0; }
    方法签名 签c;
    如果 (!查方法签名(类名c, 驻留文本(整64(被调成员.文本)), 调用节点.附加, &签c)) { 返回 0; }
    如果 (字符串长度(签c.返回文本) == 0) { 返回 0; }
    字符串 返回基名c = 字符串复制(签c.返回文本);
    如果 (字符串长度(返回基名c) > 1 &&
         ((整64(返回基名c[整32(字符串长度(返回基名c) - 1)]) & 255) == 38)) {
        返回基名c = 字符串子串(返回基名c, 0, 字符串长度(返回基名c) - 1);
    }
    返回 驻留(返回基名c);
}

// 解析成员链对象的结构体ID（186 根治，2026-09-09）：取成员宽度码 的对象解析
//   统一入口——原实现只认 标识符/调用 两形态，对象=节点_成员（链式，如构造
//   字面量脱糖产物 中间.右下 以 成员节点 r.左上 为对象）无分支回退 T_整64
//   -> 叶字段按 8 字节存储越界踩邻字段（E2E 186 s1=0 实锤：p = 点{7,9}
//   的写入被踩成 {0,9}）。递归解父链：
//   标识符 -> 解析对象结构体ID（函数级权威表优先，行为不变）；
//   成员   -> 父链结构体ID 递归 + 查字段类型ID（字段类型表第四十三轮已全字段
//             登记，键基域幂等）+ 查结构体类型 归一键基；
//   调用   -> 解析调用返回结构体（查结构体大小!=0 守卫保持）。
//   0=非结构体对象（宽度码落 T_整64=旧行为）。
函数 解析成员链结构体ID(向量<节点> 池, 整32 对象索引) -> 整64 {
    节点 对象节点 = 池.元素(对象索引);
    如果 (对象节点.类型 == 节点_标识符) { 返回 解析对象结构体ID(对象节点); }
    如果 (对象节点.类型 == 节点_成员) {
        整64 父结构体ID = 解析成员链结构体ID(池, 整32(对象节点.子起点));
        如果 (父结构体ID == 0) { 返回 0; }
        // 107（945·收窄）：合成体载荷成员（值/错误）——布局桶无合成体字段表
        //   →桶查恒 miss→链式 r.值.x 报偏移未知（v107/m 实证）。仅对载荷
        //   成员名触发（防 v2 自举面泛化回归——上轮全宽版 13 红实录）。
        {
            字符串 成员名107 = 字符串复制(驻留文本(整64(对象节点.文本)));
            如果 (字符串比较(成员名107, "值") || 字符串比较(成员名107, "错误")) {
                字符串 父文本107 = 字符串复制(驻留文本(父结构体ID));
                如果 (是结果类型(父文本107)) {
                    字符串 载荷107 = 合成名首实参(父文本107);
                    如果 (字符串比较(成员名107, "错误")) {
                        载荷107 = 段余(载荷107);
                    } 否则 {
                        载荷107 = 段首(载荷107);
                    }
                    整64 载荷ID107 = 驻留(载荷107);
                    如果 (载荷ID107 != 0 && 查结构体大小(载荷ID107) != 0) {
                        返回 载荷ID107;
                    }
                    返回 0;
                }
            }
        }
        整64 字段类型ID = 查字段类型ID(父结构体ID, 整64(对象节点.文本));
        如果 (字段类型ID == 0) { 返回 0; }
        // 97-a（2026-09-13 第九十七轮 C8）：字段类型是**数组**（结构体字段数组
        //   `行[2] 两行`）——元素结构体（嵌套链 t.两行[1].分数 的结构体键推导：
        //   数组字段 -> 元素类型 -> 结构体表）。原实现直接 查结构体类型(字段类型ID)
        //   对数组文本返回 0 -> 链上后续成员偏移推导失败（fld5 探针实证）
        字符串 字段文本97c = 字符串复制(驻留文本(字段类型ID));
        如果 (是数组类型文本(字段文本97c)) {
            字符串 元素文本97c = 数组元素文本(字段文本97c);
            如果 (字符串长度(元素文本97c) > 0) {
                返回 查结构体类型(驻留(元素文本97c));
            }
        }
        返回 查结构体类型(字段类型ID);
    }
    如果 (对象节点.类型 == 节点_调用) {
        整64 返回结构体ID = 解析调用返回结构体(池, 对象索引);
        如果 (返回结构体ID != 0 && 查结构体大小(返回结构体ID) != 0) {
            返回 返回结构体ID;
        }
    }
    // 94-a（2026-09-13 第九十四轮）：对象=下标表达式（结构体数组元素 `表[0].x` /
    //   `表[i].x`）——下标对象标识符经 数组元素结构体表（语法层数组声明登记）
    //   推导元素结构体键（消费点：生成字段访问右值 / 顺序链成员地址左值的
    //   偏移-宽度-类型码三元组）
    如果 (对象节点.类型 == 节点_下标 && 对象节点.子起点 > 0) {
        节点 下标对象94 = 池.元素(整32(对象节点.子起点));
        如果 (下标对象94.类型 == 节点_标识符) {
            整64 元素键i94 = 查数组元素结构体键94(整64(下标对象94.文本));
            如果 (元素键i94 > 0) { 返回 元素键i94; }
            // 279（021 任务 279·#263 遗留缺口·09 实测）：**指针下标链** p[i].字段
            //   ——下标对象=指针变量（数组元素表 miss）：查指针变量表得所指类型
            //   （所指=结构体→即链上后续成员的字段归属结构体；宿主 p[i].分数
            //   放行同款。内联实现——推导下标元素类型ID 定义在本函数之后
            //   前向引用不可达）。
            整64 所指279 = 查指针变量类型(整64(下标对象94.文本));
            如果 (所指279 > 0) {
                // 双轨坑 B：类型节点文本=剥星基名（星层在 附加 位）——所指文本
                //   直接查结构体表（无需剥星）
                整64 键279 = 查结构体类型(所指279);
                如果 (键279 != 0 && 查结构体大小(键279) != 0) { 返回 键279; }
            }
        }
        // 97-a（2026-09-13 第九十七轮 C8）：下标对象=成员（**结构体字段数组**
        //   元素 t.两行[1]）——元素结构体直接经 解析成员链结构体ID(成员) 取得
        //   （成员分支已对数组字段返回元素结构体：总表.两行="行[2]" -> 行）。
        //   注：首版误在上层再做一次「字段查询（行.两行）」，恒 miss -> 返回 0
        //   （fld7 探针实证：字段类型=0）；修正=删除多余字段查询层。
        如果 (下标对象94.类型 == 节点_成员) {
            整64 元素键97f = 解析成员链结构体ID(池, 整32(对象节点.子起点));
            如果 (元素键97f > 0) { 返回 元素键97f; }
        }
    }
    返回 0;
}

// 97-a（2026-09-13 第九十七轮 C8）：下标对象**元素类型**推导——返回元素类型名ID
//   （0=非数组/未知）。形态：①对象=标识符（数组变量：当前函数变量类型文本是数组
//   -> 元素文本；否则指针变量表 -> 所指类型即元素）；②对象=成员（结构体字段数组：
//   解析成员链结构体ID 取字段类型 -> 数组 -> 元素文本）。
//   消费点：生成下标访问（步进/宽度/越界长度）+ 顺序链下标地址（左值链步进）。
不安全 函数 推导下标元素类型ID(向量<节点> 池, 整32 对象索引) -> 整64 {
    // 97-a：对象类型统一经 推导成员链类型ID（标识符/成员/下标 通用类型级推导——
    //   嵌套链 t.两行[1].分数 的字段类型=整32[3] 由此取得；原实现各形态手写，
    //   对"成员链中间含下标"（字段数组元素）无路径）
    // 1011（537D·克隆体模板态绑定替换）：出口统一查实例类型绑定（641-a 设施·
    //   生成类 生成实例方法体时已设置 T→实参）——克隆体内 数据[i] 的元素类型
    //   推导返回模板参数名「T」（字段类型登记 T*·克隆只改节点文本不重登类型表）
    //   →下标读写两侧判定 是结果类型_ID(T)=假 →值读/窄写——复制(其他.数据[i])
    //   把元素值当地址解引用（fault=0x1F00000001=正常(31) 打包·537D 实锤）。
    整64 结果1011 = 0;
    整64 类型IDq = 推导成员链类型ID(池, 对象索引);
    IO::打印到错误("[dbg200b] 推导成员链 类型ID=" + 整数转字符串(类型IDq) + " 文本=" + 驻留文本(类型IDq) + " 是数组=" + 整数转字符串(整64(是数组类型文本(驻留文本(类型IDq)))) + "\n");
    如果 (类型IDq > 0) {
        字符串 文本q = 字符串复制(驻留文本(类型IDq));
        如果 (是数组类型文本(文本q)) {
            字符串 元素q = 数组元素文本(文本q);
            IO::打印到错误("[dbg200b] 元素=[" + 元素q + "]\\n");
            如果 (字符串长度(元素q) > 0) { 结果1011 = 驻留(元素q); }
        }
    }
    // 指针变量对象（下标对象=指针）：所指类型即元素
    如果 (结果1011 == 0) {
        节点 对象q = 池.元素(对象索引);
        如果 (对象q.类型 == 节点_标识符) {
            整64 查指针q = 查指针变量类型(整64(对象q.文本));
            如果 (查指针q >= 0) { 结果1011 = 查指针q; }
        }
    }
    // 432-b（撤守卫·克隆体）：裸字段/成员链指针对象（K* 键数组[i]、其他.数据[j]）
    //   ——对象类型（函数级权威表/字段类型表）带 * 尾→剥指针层返回所指元素
    //   类型；原 miss=所指ID 0→字符串下标回退（__cn_str_len(字段值) SEGV 实测）
    如果 (结果1011 == 0) {
        整64 对象类型q2 = 推导成员链类型ID(池, 对象索引);
        如果 (对象类型q2 > 0) {
            字符串 对象文本q2 = 字符串复制(驻留文本(对象类型q2));
            整64 长q2 = 字符串长度(对象文本q2);
            如果 (长q2 > 1 && ((整64(对象文本q2[整32(长q2 - 1)]) & 255) == 42)) {
                结果1011 = 整64(驻留(字符串子串(对象文本q2, 0, 整32(长q2 - 1))));
            }
        }
    }
    如果 (结果1011 > 0) {
        整64 绑定实参1011 = 查实例绑定实参(结果1011);
        如果 (绑定实参1011 > 0) { 返回 绑定实参1011; }
    }
    返回 结果1011;
}

// 97-a：成员链**类型级**推导（IR）——返回节点表达式的类型名ID（0=不可推导）。
//   形态递归：标识符（当前函数变量类型）＞ 成员（父类型归一为结构体 -> 字段类型；
//   父类型是数组则先取元素）＞ 下标（父类型是数组则取元素；指针对象经调用方兜底）。
//   与 解析成员链结构体ID（结构体**键**级，字段偏移消费）互补：本函数回答"这个
//   表达式是什么类型"，是类型/宽度/元素推导的通用入口。
不安全 函数 推导成员链类型ID(向量<节点> 池, 整32 节点索引) -> 整64 {
    节点 n97 = 池.元素(节点索引);
    如果 (n97.类型 == 节点_标识符) {
        整64 类型ID97 = 查当前函数变量类型(整64(n97.文本));
        如果 (类型ID97 >= 0) { 返回 类型ID97; }
        // 259（2026-10-07·#259 静态数组）：顶层静态**数组**名——返回静态类型
        //   （数组文本），下标读/写经 推导下标元素类型ID 取元素步进与长度。
        //   非数组静态不经过（容器=指针槽语义·缩窄纪律与宿主 lookupSrcType
        //   兜底同款——全局面行为零变化）。
        整64 找静97 = 查静态序号含类(整64(n97.文本));
        如果 (找静97 >= 0) {
            整64 静类型ID97 = 取静态类型(找静97);
            如果 (是数组类型文本(驻留文本(静类型ID97))) { 返回 静类型ID97; }
        }
        返回 0;
    }
    如果 (n97.类型 == 节点_成员 && n97.子起点 > 0) {
        整64 父类型97 = 推导成员链类型ID(池, 整32(n97.子起点));
        如果 (父类型97 == 0) { 返回 0; }
        字符串 父文本97 = 字符串复制(驻留文本(父类型97));
        如果 (是数组类型文本(父文本97)) {
            字符串 父元素97 = 数组元素文本(父文本97);
            如果 (字符串长度(父元素97) > 0) { 父类型97 = 驻留(父元素97); }
        }
        // 438-b：父层为指针（尾'*'·如 其他=引用参数 其 数据 字段）→ 过指针取
        //   字段（所指类型的结构体表）
        // 466-a（T70 面⑥·窄域）：父层为引用（尾'&'·函数级变量类型登记带 &
        //   尾·如 向量$Token&）——引用即别名（Rust auto-deref 同语义），剥后
        //   取被引类型字段；不剥则克隆体 成员链推导 miss→复制 展开退普通调用
        //   无物化登记→348-a 查源=0 误诊（fix_p 向量$Token 克隆体实证）。
        整64 长p97 = 字符串长度(父文本97);
        当 (长p97 > 1 && (((整64(父文本97[整32(长p97 - 1)]) & 255) == 42) ||
                          ((整64(父文本97[整32(长p97 - 1)]) & 255) == 38))) {
            父文本97 = 字符串复制(字符串子串(父文本97, 0, 整32(长p97 - 1)));
            父类型97 = 整64(驻留(父文本97));
            长p97--;
        }
        // 438-b：结构体键改用 实例感知的 解析成员链结构体ID（查结构体类型 表
        //   不含实例合成名→成员链在实例克隆体内 miss→下标读落字符串回退·111/68
        //   拷贝构造 SEGV 根因）
        整64 结构体97d = 解析成员链结构体ID(池, 整32(n97.子起点));
        如果 (结构体97d == 0) { 结构体97d = 查结构体类型(父类型97); }
        如果 (结构体97d == 0) { 返回 0; }
        返回 查字段类型ID(结构体97d, 整64(n97.文本));
    }
    如果 (n97.类型 == 节点_下标 && n97.子起点 > 0) {
        整64 父类型97e = 推导成员链类型ID(池, 整32(n97.子起点));
        如果 (父类型97e == 0) { 返回 0; }
        字符串 父文本97e = 字符串复制(驻留文本(父类型97e));
        如果 (是数组类型文本(父文本97e)) {
            字符串 父元素97e = 数组元素文本(父文本97e);
            如果 (字符串长度(父元素97e) > 0) { 返回 驻留(父元素97e); }
        }
        // 438-b：父层为指针（尾'*'·如 其他.数据[i] 的 数据="整64*"）→ 剥层取
        //   所指元素类型（原 miss=下标读落字符串回退·111/68 拷贝构造 SEGV 根因）
        // 466-a（T70 面⑥·窄域）：引用尾 '&' 同剥（语义=别名·与 * 同构）。
        整64 长e = 字符串长度(父文本97e);
        当 (长e > 1 && (((整64(父文本97e[整32(长e - 1)]) & 255) == 42) ||
                        ((整64(父文本97e[整32(长e - 1)]) & 255) == 38))) {
            父文本97e = 字符串子串(父文本97e, 0, 整32(长e - 1));
            长e--;
        }
        如果 (长e != 字符串长度(驻留文本(父类型97e))) {
            返回 整64(驻留(父文本97e));
        }
        返回 0;
    }
    返回 0;
}

// 97-a：下标对象**数组长度**（越界检查用；0=非数组对象/未知）——与
//   推导下标元素类型ID 同判定路径（标识符变量类型文本 / 成员字段类型文本）。
不安全 函数 推导下标数组长度(向量<节点> 池, 整32 对象索引) -> 整64 {
    // 97-a：与 推导下标元素类型ID 同源（对象类型经 推导成员链类型ID 通用推导）
    整64 类型IDq = 推导成员链类型ID(池, 对象索引);
    如果 (类型IDq > 0) {
        字符串 文本q = 字符串复制(驻留文本(类型IDq));
        如果 (是数组类型文本(文本q)) { 返回 数组长度文本(文本q); }
    }
    返回 0;
}

// 取成员节点访问的宽度类型码（186 根治后：对象解析统一走 解析成员链结构体ID
//   ——标识符/成员链/调用 三形态；未登记防御默认 T_整64 与旧行为一致。
//   消费点唯一：生成语句.cn 赋值左值存储宽度——读路径 成员链 走生成字段访问
//   的「成员字段偏移未知」可见失败（观察项已立案，与本修复面无交叠））
函数 取成员宽度码(向量<节点> 池, 整32 成员索引) -> 整64 {
    节点 m = 池.元素(成员索引);
    如果 (m.类型 != 节点_成员) { 返回 T_整64; }
    整64 结构体ID = 解析成员链结构体ID(池, 整32(m.子起点));
    如果 (结构体ID != 0) { 返回 查字段宽度码(结构体ID, 整64(m.文本)); }
    返回 T_整64;
}
// 91-a（2026-09-13 第九十一轮）：实参寄存器列表 -> 类型码向量（与 弹出们 同序）
//   ——发射调用实参们 前置（IR_调用实参.操作数2 编码；调用点寄存器类分派）。
函数 实参类型码们(向量<整64> 弹出们) -> 向量<整64> {
    向量<整64> 码们 = 向量<整64>();
    整64 i = 0;
    当 (i < 弹出们.大小()) {
        结果<空类型, 整32> 加码 = 码们.追加(查寄存器类型(弹出们.元素(i)));
        如果 (!加码.正常) { 运行时错误(4); }
        i++;
    }
    返回 码们;
}

// 数值/布尔/字符 -> 字符串 转换符号（拼接隐式转换用；宿主 ir_call 对齐。
//   未登记/整数一律 from_int；浮32 场景 v2 浮点面未开（③ 后续），先归 float）
//   T48 轮顺带根治（505 双编译对照捕获·机制级）：字符拼接原落 from_int 打
//   码点十进制（22909），违反规范 02「字符拼接等价 字符转字符串」——补 T_字符
//   分支走 __cn_str_from_char（码点 UTF-8 编码·宿主 320-a T40 同源）
函数 转换符号(整64 码) -> 字符串 {
    如果 (码 == T_浮32 || 码 == T_浮64) { 返回 "__cn_str_from_float"; }
    如果 (码 == T_布尔) { 返回 "__cn_str_from_bool"; }
    如果 (码 == T_字符) { 返回 "__cn_str_from_char"; }
    // 232（91311 同族）：正64 拼接走无符号转换（from_int 有符号=2^63 以上印负）
    如果 (码 == T_正64) { 返回 "__cn_str_from_uint"; }
    返回 "__cn_str_from_int";
}

// 标识符类型解析（函数级权威 -> 解析期容器表 -> 顶层静态表 -> 解析期结构体表）；
//   返回类型名ID（容器合成名/结构体名/结果名）；0=未知
函数 解析标识符类型ID(整64 名ID) -> 整64 {
    整64 查本函数 = 查当前函数变量类型(名ID);
    如果 (查本函数 >= 0) { 返回 查本函数; }
    整64 容器ID = 查容器类型(名ID);
    如果 (容器ID != 0) { 返回 容器ID; }
    // 87-a（2026-09-12 第八十七轮）：顶层静态变量——静态表类型（结构体静态的
    //   类型解析入口：整体赋值/成员链/实参位移轴）。原缺此级 → 静态结构体的
    //   整体赋值 查结构体大小==0 提前返回假（静态槽静默零写，探针 P50b 实证）。
    整64 找静类 = 查静态序号含类(名ID);
    如果 (找静类 >= 0) { 返回 取静态类型(找静类); }
    返回 查结构体类型(名ID);
}

// ==================== 方法调用对象类型统一解析（②c A/B，2026-09-02） ====================
// 后缀链任意节点的类型推导（递归）：标识符（容器变量/结构体变量）、成员
//（基类型为结构体 -> 字段类型）、调用（返回容器/返回结构体）。返回类型名ID；0=未知。
函数 解析节点类型ID(向量<节点> 池, 整32 节点索引) -> 整64 {
    节点 n = 池.元素(节点索引);
    如果 (n.类型 == 节点_标识符) {
        返回 解析标识符类型ID(整64(n.文本));
    }
    如果 (n.类型 == 节点_成员) {
        // 对象.字段：基类型为结构体 -> 分桶字段类型（b.表 -> 向量$整64）
        整64 基类型ID = 解析节点类型ID(池, n.子起点);
        // 107（945·收窄）：合成体载荷成员（值/错误）——直接取载荷（与①同源）
        如果 (基类型ID != 0) {
            字符串 成员名107b = 字符串复制(驻留文本(整64(n.文本)));
            如果 (字符串比较(成员名107b, "值") || 字符串比较(成员名107b, "错误")) {
                字符串 基文本107b = 字符串复制(驻留文本(基类型ID));
                如果 (是结果类型(基文本107b)) {
                    字符串 载荷107b = 合成名首实参(基文本107b);
                    如果 (字符串比较(成员名107b, "错误")) {
                        载荷107b = 段余(载荷107b);
                    } 否则 {
                        载荷107b = 段首(载荷107b);
                    }
                    返回 驻留(载荷107b);
                }
            }
        }
        如果 (基类型ID != 0 && 查结构体大小(基类型ID) != 0) {
            返回 查字段类型ID(基类型ID, 整64(n.文本));
        }
        返回 0;
    }
    如果 (n.类型 == 节点_调用) {
        整64 容器返回ID = 解析调用返回容器(池, 节点索引);
        如果 (容器返回ID != 0) { 返回 容器返回ID; }
        返回 解析调用返回结构体(池, 节点索引);
    }
    如果 (n.类型 == 节点_三元运算) {
        // 86-a（2026-09-12 复审缺陷①）：三元结果类型=两分支类型（语义层保证
        //   统一）——递归真/假分支末节点（真分支空时取假分支，与宿主
        //   exprSrcType 的 TernaryExpr 分支同款）。原缺此分支 → 类型推导 0 →
        //   赋值/声明位同型校验失败（P46 v2「左右类型不同」诊断实证）。
        如果 (n.文本 < n.附加) {
            整64 真类型IDt = 解析节点类型ID(池, 整32(n.附加 - 1));
            如果 (真类型IDt != 0) { 返回 真类型IDt; }
        }
        如果 (n.附加 < n.子终点) {
            返回 解析节点类型ID(池, 整32(n.子终点 - 1));
        }
        返回 0;
    }
    返回 0;
}

// ==================== 函数重载决议（呈报③方案A，2026-09-06） =====================
// 规格书 §函数重载（plans/001:358）：同名按参数类型与个数区分。决议序（宿主
//   resolveOverload 简化对齐——v2 无模块系统=无模块过滤；隐式转换面=字面量
//   宽匹配，变量窄宽转换不做=不扩权）：
//   a. 签名表候选 0 -> 返回纯名（内置/打印/运行时——不进签名表，路径不变）
//   b. 个数过滤后精确匹配（实参段==参数段逐字节）
//   c. 字面量宽匹配（整数字面量段 通配整族/浮族；浮字面量 通配浮族；推导
//      失败空段=通配——安全网）
//   d. 精确命中唯一 -> 该签名键；宽命中唯一 -> 该签名键；多命中 -> IR层诊断
//      歧义（fail fast，绝不静默选）
//   e. 类型层 0 命中但个数匹配候选唯一 -> 该候选（宽容层：类型推导不全不误伤）
//   f. 其余 -> IR层诊断决议失败（同名多候选且类型不可辨=必须显式，与 C++
//      二义性一致）
// 返回 决议后函数符号ID（签名键/纯名）；诊断后返回 0（IR 层错误即中止纪律）。

// 实参类型文本推导（静态单节点）：字面量按语义层口径（整数字面量=整32）、
//   标识符走 解析标识符类型ID（权威表含标量/结构体/容器/参数）、成员/调用走
//   解析节点类型ID。未知形态返回 空串（决议时按通配处理）。
// A2（2026-09-11 方案甲）：返回 字符串->字符*——字面量分支只读段借用+驻留分支
//   驻留表借用，全分支借用视图零拷贝（调用方持有须 字符串复制 落堆）。
// 231（2026-10-06·91313）：无后缀十进制整数字面量值域判定——超 整32 正域
//   （2147483647）按 整64 参与重载决议（值保真·Rust 字面量推断惯例·宿主
//   adjustLiteralArgTypes 同构）。非纯十进制（0x/L/U 后缀形态）不判=维持
//   整32（挂账：带后缀超域字面量重载决议面）。
函数 无后缀十进制超i32域(字符串 rawz) -> 布尔 {
    整64 长z = 字符串长度(rawz);
    如果 (长z == 0) { 返回 假; }
    整64 iz = 0;
    当 (iz < 长z) {
        整64 cz = 整64(rawz[iz]) & 255;
        如果 (cz < 48 || cz > 57) { 返回 假; }
        iz++;
    }
    如果 (长z > 10) { 返回 真; }
    如果 (长z < 10) { 返回 假; }
    字符串 上界z = "2147483647";
    整64 bz = 0;
    当 (bz < 10) {
        整64 crz = 整64(rawz[bz]) & 255;
        整64 cbz = 整64(上界z[bz]) & 255;
        如果 (crz > cbz) { 返回 真; }
        如果 (crz < cbz) { 返回 假; }
        bz++;
    }
    返回 假;
}

函数 推导实参类型文本(向量<节点> 池, 整32 节点索引) -> 字符* {
    节点 n = 池.元素(节点索引);
    // 231 甄别实录：本函数返回 字符*——字面量直返（返回 "浮64"）跨函数后
    //   指向失效临时（调用方实段=空→通配→假歧义·dbg 三段铁证）——改驻留
    //   稳定文本（驻留文本(驻留(...))）。
    如果 (n.类型 == 节点_整数字面量) {
        如果 (无后缀十进制超i32域(驻留文本(整64(n.文本)))) { 返回 驻留文本(驻留("整64")); }
        返回 驻留文本(驻留("整32"));
    }
    如果 (n.类型 == 节点_浮点字面量) { 返回 驻留文本(驻留("浮64")); }
    如果 (n.类型 == 节点_布尔字面量) { 返回 驻留文本(驻留("布尔")); }
    如果 (n.类型 == 节点_字符串字面量) { 返回 驻留文本(驻留("字符串")); }
    如果 (n.类型 == 节点_标识符) {
        整64 类型ID = 解析标识符类型ID(整64(n.文本));
        如果 (类型ID != 0) { 返回 驻留文本(类型ID); }
        返回 "";
    }
    如果 (n.类型 == 节点_成员 || n.类型 == 节点_调用) {
        整64 类型ID = 解析节点类型ID(池, 节点索引);
        如果 (类型ID != 0) { 返回 驻留文本(类型ID); }
        返回 "";
    }
    返回 "";
}

// 段匹配级（231·2026-10-06·91323 歧义实锤）：返回转换级距供决议择优——
//   0=精确相等 1=整字面量→整族宽化 2=隐式跨族（整→浮）99=不匹配；
//   空段（推导失败）=1 保守通配。原布尔版把「整字面量→整族」与「整字面量→浮族」
//   记同级宽匹配→印(7) 对 印(整64)/印(浮64) 双宽=假歧义（宿主 conversionLevel
//   级距 1 vs 2 择优同构）。
函数 实参段匹配级(字符串 实段, 字符串 参段) -> 整64 {
    如果 (字符串长度(实段) == 0) { 返回 1; }
    如果 (字符串比较(实段, 参段)) { 返回 0; }
    如果 (字符串比较(实段, "整32")) {
        如果 (字符串比较(参段, "整64") || 字符串比较(参段, "整8") ||
             字符串比较(参段, "整16") || 字符串比较(参段, "正8") ||
             字符串比较(参段, "正16") || 字符串比较(参段, "正32") ||
             字符串比较(参段, "正64")) { 返回 1; }
        如果 (字符串比较(参段, "浮32") || 字符串比较(参段, "浮64") ||
             字符串比较(参段, "字符")) { 返回 2; }
    }
    如果 (字符串比较(实段, "浮64") && 字符串比较(参段, "浮32")) { 返回 2; }
    返回 99;
}

// 兼容入口（布尔·存量消费点=级<99）
函数 实参段匹配(字符串 实段, 字符串 参段) -> 布尔 {
    返回 实参段匹配级(实段, 参段) < 99;
}

// 重载决议主入口：名ID+调用节点（实参区间 [子起点, 子起点+附加)）-> 函数符号ID
// 233：出参 键基/参数串ID/参数段数（默认参数补缺·调用实参不足段查根求值）

// 233：默认参数登记（尾连续 子起点!=0·键=键基ID*位移+键串ID*4096+参数序）——
//   参数序=声明序（尾连续时 缺段序==参数序·补缺直查）；中间默认后随无默认
//   =非法形态 默认数清零（宿主尾连续同语义）。调用=登记函数签名K 尾段。
函数 登记函数默认参数(向量<节点> 池, 整32 函数节点, 整64 键基ID, 整64 键串ID) -> 空类型 {
    节点 函数声明d = 池.元素(函数节点);
    整64 参数终点d = 整64(函数声明d.子终点);
    如果 (参数终点d < 整64(池.大小())) {
        节点 块节点d = 池.元素(整32(参数终点d));
        参数终点d = 整64(块节点d.子起点);
    }
    整64 默认数d = 0;
    布尔 见无默认d = 假;
    整64 参数序d = 0;
    整64 id = 整64(函数声明d.子起点);
    当 (id < 参数终点d) {
        节点 参数d = 池.元素(整32(id));
        如果 (参数d.类型 == 节点_参数) {
            如果 (参数d.子起点 != 0) {
                如果 (见无默认d) { 默认数d = 0; 中断; }
                默认数d++;
                结果<空类型, 整32> 设根d = 函数默认参数根们.设置(
                    键基ID * 键位移 + 键串ID * 4096 + 参数序d, 参数d.子起点);
                如果 (!设根d.正常) { 运行时错误(4); }
            } 否则 {
                如果 (默认数d > 0) { 见无默认d = 真; }
            }
        }
        id++;
    }
    // 262（300-DN 双测负测·宿主 checkDefaultParams 同构·零分叉）：默认形参须
    //   从右向左连续声明——反向扫描，遇无默认形参后其左侧再现有默认者=编译期
    //   拒绝（宿主 semantic_builtins 同文案锚·全文案 T63 统一后案）。233 前向
    //   走查的「默认数清零」只保调用补缺安全，f(a=1,b) 形态仍静默登记默认数=1
    //   （=300-DN 红机制位），本检查补齐拒绝面。顶层函数两登记面（语义收集/
    //   IR 生成）经 登记函数签名K 汇聚于此·签名去重保单发；方法面宿主本就
    //   未查（检查挂 registerFunction 顶层函数趟）=同构不扩面。
    布尔 右侧见无默认262 = 假;
    整64 游262 = 参数终点d - 1;
    当 (游262 >= 整64(函数声明d.子起点)) {
        节点 参262 = 池.元素(整32(游262));
        如果 (参262.类型 == 节点_参数) {
            如果 (参262.子起点 != 0) {
                如果 (右侧见无默认262) {
                    IR层诊断("默认参数必须从右向左连续声明（参数 '" +
                             驻留文本(整64(参262.文本)) +
                             "' 左侧不能出现无默认值参数）");
                }
            } 否则 {
                右侧见无默认262 = 真;
            }
        }
        游262 = 游262 - 1;
    }
    如果 (默认数d > 0) {
        结果<空类型, 整32> 设默d = 函数签名默认数们.设置(
            键基ID * 键位移 + 键串ID, 默认数d);
        如果 (!设默d.正常) { 运行时错误(4); }
    }
}

// 233：查默认参数根节点池索引（键基ID+参数串ID+参数序·0=未登记）
函数 查默认参数根(整64 键基ID, 整64 参数串ID, 整64 参数序) -> 整64 {
    如果 (参数串ID <= 0) { 返回 0; }
    结果<整64, 整32> 查 = 函数默认参数根们.获取(
        键基ID * 键位移 + 参数串ID * 4096 + 参数序);
    如果 (查.正常) { 返回 查.值; }
    返回 0;
}

// ==================== 类型宽度码（263④ 轮自 IR布局.cn 机械搬移·纯搬运零行为
//   变更——超标冻结文件腾行·263① 生成语句辅助 同款） ====================
// 按字段类型文本返回 指针加载/存储 宽度标注（T_* 码）。窄宽码 T_整8/T_整16/
//   T_字符 由 IR生成 定义（纯名引用——合并后全局可见，同 IR追加 先例）；
//   其余（整64/字符串/指针/嵌套结构体）默认 8 字节。
// 46-f（2026-09-10 第五十轮）：正32 独立码 T_正32——字段 4 字节读回零扩展
//   （movzx/ldr w32）而非符号扩展（movsxd）：4000000000 位模式读回须=原值。
函数 类型宽度码(字符串 类型文本) -> 整64 {
    // 94-a：数组类型——读/写宽度按**元素类型**（宿主 mapType(数组)=mapType(元素)
    //   同构；数组元素 p[i] 的加载/存储宽度即元素宽度）
    如果 (是数组类型文本(类型文本)) {
        字符串 元素w = 数组元素文本(类型文本);
        如果 (字符串长度(元素w) > 0) { 返回 类型宽度码(元素w); }
    }
    如果 (字符串比较(类型文本, "布尔")) { 返回 T_布尔; }
    如果 (字符串比较(类型文本, "字符")) { 返回 T_字符; }
    // 347-a（T33 残余根治·同族旁路穷尽）：原「整8/正8 归并 T_整8」「整16/正16
    //   归并 T_整16」**丢失符号性** → 结构体字段/数组元素/指针解引用路径的无符号
    //   窄类型被当有符号读（探针 p24：正8 字段 200 读回 -56；正16 60000 读回 -5536）；
    //   反向：整8/整16 负值被零扩展（p23：-426 读回 65110）。拆分为独立码——
    //   三后端已完整支持 T_正8/T_正16 零扩展语义（2026-09-04 收口设施·
    //   转换/装载面分派齐备），指针加载/存储分派本轮补齐。
    如果 (字符串比较(类型文本, "整8")) { 返回 T_整8; }
    如果 (字符串比较(类型文本, "正8")) { 返回 T_正8; }
    如果 (字符串比较(类型文本, "整16")) { 返回 T_整16; }
    如果 (字符串比较(类型文本, "正16")) { 返回 T_正16; }
    如果 (字符串比较(类型文本, "正32")) { 返回 T_正32; }
    如果 (字符串比较(类型文本, "整32")) { 返回 T_整32; }
    // 263④（021 任务 263·探针 646 实证）：128 位标量宽度码——成员字段写
    //   （生成语句赋值 存储宽度 命中 545 双半写通道·自带拆半零发射层依赖）与
    //   下标/解引用宽度分派消费。读侧字段 128 由 生成表达式字段 810 地址语义
    //   通道（成员值码 拦截）先行返回不经本码装载。
    如果 (字符串比较(类型文本, "整128")) { 返回 T_整128; }
    如果 (字符串比较(类型文本, "正128")) { 返回 T_正128; }
    // 279：枚举类型字段/元素=T_整32（4 字节读写·布局 4/4 配套——C 枚举=int）
    如果 (是枚举名(驻留(类型文本))) { 返回 T_整32; }
    // 990（008 挂账·094 空安全语义）：字符串字段 加载类型=T_字符串——codegen
    //   对 T_字符串 的指针加载**跳过判空**（0 句柄=空串·运行时串函数已容错
    //   __cn_str_len(0)=0/__cn_str_eq 容错——宽度仍 8 字节句柄·与 T_整64 等宽
    //   零行为差异面=仅判空豁免）
    如果 (字符串比较(类型文本, "字符串")) { 返回 T_字符串; }
    返回 T_整64;
}

// ==================== 279：方法定义层（自 IR类.cn 机械搬移·纯搬运） ====================
// 279：方法定义层解析——沿基名链返回首个命中层（定义类·最近重写优先）；0=无。
//   调用侧直调符号按定义层修饰（零克隆·this 布局前缀同构·字段已并入〔278〕）。
函数 查类方法定义层(整64 类名ID, 整64 方法名ID) -> 整64 {
    整64 当前c = 类名ID;
    整64 守卫h = 0;
    当 (当前c != 0 && 守卫h < 64) {
        结果<整64, 整32> 查 = 类方法返回们.获取(当前c * 键位移 + 方法名ID);
        如果 (查.正常) { 返回 当前c; }
        当前c = 查类基名(当前c);
        守卫h++;
    }
    返回 0;
}

