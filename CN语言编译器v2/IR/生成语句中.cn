// 生成语句中（357 重构F2 自 生成语句.cn 纯机械搬移·函数体逐字保留·零逻辑变化）

导入 容器::向量;
导入 语法;       // Token/AST 节点池（原 导入 语法分析，目录包名）
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 IR生成;     // 控制流辅助/变量类型权威表（同包幂等）
导入 生成声明;    // 语句级变量声明分派（R3 拆分，同包）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

不安全 函数 生成返回结构体值分支(向量<节点> 池, 节点 n,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈, 整64& 值寄存器) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
        // 用户函数返回结构体（2026-09-04，E2E 148）：宿主 ABI——值拷入
        //   调用方传入的 retbuf（槽 1 指针）、rax=retbuf。源地址两形态：
        //   末节点=标识符/成员/解引用 -> 生成左值地址（本函数局部基槽）；
        //   末节点=调用 -> 生成表达式（被调 retbuf 地址即结构体地址）
        节点 返回末 = 池.元素(n.子终点 - 1);
        // 107-a（2026-09-13 第一百零七轮，H6 根治）：返回位裸「无」——语法层把
        //   关键字「无」解析为 节点_整数字面量（值 0），原走下方「生成表达式」
        //   路径把 0 当结构体地址 -> IR_结构体拷贝 自 NULL 读 16 字节 -> 段错误
        //   （探针 d5f/d5j 双侧分叉：宿主 ✓ / v2 rc=139；最小复现 d5f_min）。
        //   宿主语义=结果/可选 空值零值结构体物化 -> 零初始化栈临时 + 公共尾段
        //   拷入 retbuf（复用数组局部零初始化设施）。无歧义实证：合法源码中
        //   结果/可选 返回位不出现裸整数（宿主对 `返回 0` 报「无法隐式转换」）。
        如果 (返回末.类型 == 节点_整数字面量) {
            整64 拷贝字节H6 = 查结构体大小(函数信息.返回结构体ID);
            如果 (函数信息.返回结果名ID != 0) {
                拷贝字节H6 = 结果大小(字符串复制(
                    驻留文本(函数信息.返回结果名ID)));
            }
            整64 槽数H6 = (拷贝字节H6 + 7) / 8;
            整64 槽起H6 = 槽计数[0];
            槽计数[0] = 槽计数[0] + 槽数H6;
            整64 zH6 = 0;
            当 (zH6 < 槽数H6) {
                IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽起H6 + zH6));
                zH6++;
            }
            整64 零寄存器H6 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("0")), 0, 0,
                                 零寄存器H6, T_整64, 0));
            zH6 = 0;
            当 (zH6 < 槽数H6) {
                IR追加(指令, 建IR指令(IR_存储, 零寄存器H6, 0, 0, 0, 0,
                                     槽起H6 + zH6));
                zH6++;
            }
            值寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_取地址, 槽起H6 + 槽数H6 - 1, 0, 0,
                                 值寄存器, T_整64, 0));
        } 否则 如果 (返回末.类型 == 节点_标识符 || 返回末.类型 == 节点_成员 ||
             返回末.类型 == 节点_解引用 || 返回末.类型 == 节点_下标) {
            // 759-a（按甲）：下标末节点（返回 数据[位置]）→生成左值地址＝元素槽
            //   地址（56B 值物化源＝池元素本体）——原落 else 生成表达式＝右值句柄
            //   被当地址起拷 56B（两代分叉·顶层=垃圾物化→获取=0 值差实锤）。
            值寄存器 = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                     指令, 寄存器计数, &函数信息.块计数,
                                     槽计数, 表达式栈);
        } 否则 {
            值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                   指令, 寄存器计数, &函数信息.块计数,
                                   槽计数, 表达式栈);
        }
        整64 ret指针 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_加载, 1, 0, 0, ret指针, T_整64, 0));
        // 71-a：返回拷贝字节数分流——结果/可选 返回用 结果大小（结构体表查不到
        //   合成名=0，防拷 0 字节假返回）
        整64 返回拷贝字节71 = 查结构体大小(函数信息.返回结构体ID);
        如果 (函数信息.返回结果名ID != 0) {
            返回拷贝字节71 = 结果大小(字符串复制(
                驻留文本(函数信息.返回结果名ID)));
        }
        // 810（053）：128 位标量返回=双半拷 16 字节（T96c emitCopy 双半模式）
        如果 (函数信息.返回128位 != 0) {
            返回拷贝字节71 = 16;
        }
        // 087b（#087 余量·宿主 82984e4bbe 同构）：数组返回=按数组字节整块拷
        //   （源=返回末节点左值地址（局部数组名→IR_取地址(基槽)=基址）；字节
        //   源=生成函数 sret 判定登记的 返回数组字节）
        如果 (函数信息.返回数组字节 != 0) {
            返回拷贝字节71 = 函数信息.返回数组字节;
        }
        // 85-a（2026-09-12 第八十五轮）：聚合返回位所有权保证——**借用来源**返回
        //   （按值形参=调用方 place 的浅拷副本 / 全局静态 / 成员 / 下标 / 解引用）
        //   时按位 memcpy 会把**别人的句柄**交给调用方（调用方各接收位一律按 owned
        //   处理：声明/赋值=浅拷接管、入容器=元素槽独立）→ 调用方释放其持有者后
        //   返回值字段悬垂（探针 P38/P40 两侧同现，打印乱码；数据正确性/安全级）。
        //   Rust 对照：`-> T` 必须有所有权，借用来源须 clone。修法=返回位深拷落堆
        //   （写入调用方 retbuf 后逐字段 __cn_str_copy——sret 就地构造，零额外
        //   memcpy）；拥有局部（移出）/调用返回/字面量保持原路径（零拷贝）。
        //   面：结果/可选 返回（返回结果名ID）不在面内——v2 结果/可选 值字段未登记
        //   资源字段（84-e 诚实边界：释放需联合体条件分支），故此处分派跳过。
        布尔 借用返回85 = 是借用来源返回(池, 函数信息, 返回末, 参数槽, 局部槽);
        // 748-a（T94 阶段二·055 波2a 的 v2 树镜像·052 甲副本语义）：容器.元素
        //   方法返回类实例（借用来源）时，浅拷 retbuf=与池共享内部数组指针——
        //   调用方「取回-设置-写回」场景 self 覆盖即毁源（740-a 实测段错误）。
        //   改=NewObject+拷贝构造 独立堆副本（Rust 返回 T 值语义·宿主波2a 同款
        //   ir_stmt.cpp visitReturnStmt）。
        // 754-a（001 波1·753-a 三重铁证定音 025 §2.146）：原「函数信息.名字 ==
        //   驻留("元素")」对单态化克隆体（名字=向量$映射$整64$符号$元素_J 全名）
        //   恒不命中＝分支自 748 集成起从未生效（asm 实证：元素 方法=rep movsb
        //   56B 浅拷 85-a 路径）。改=基名含「$元素」或全名「元素」判定。
        //   且命中时返回写收敛=**retbuf[0]=句柄**（8B·替代 56B 值物化——两代
        //   统一「类返回 retbuf[0]=句柄」ABI·753-a 波1 定稿；调用方容器接收按
        //   句柄消费＝749「retbuf 栈临时直存毁」根除·拷贝构造 T& 两跳契约成立）。
        // 759-a（按甲·用户令「自举零风险」）：748-a 句柄返回段**整体停用**——
        //   757-a 实测守卫+物化态 main 早期崩＝命中面波及 v2p 自举容器（是容器类
        //   守卫不足：自举的 向量$映射$..$元素 也命中·其内部调用方按 56B 值消费
        //   retbuf）。甲=「元素 方法」返回还原 56B 物化（85-a 借用路径原样）·
        //   **仅「生成声明 接收」侧适配**（读 retbuf[0] 句柄+物化+NewObject+拷贝
        //   构造·源=物化槽地址——生成声明.cn 754 修②段同轮）。改回恒假，段留档
        //   （git 可考：754~758 分支 任务/深度机-754-返回ABI统一）。
        // 768 续（001 波·242 系回归根治）：759-a 停用 748 段时把 **85-a 借用
        //   返回深拷分派**一并包进恒假块删除＝「返回借用来源」（形参/成员链/
        //   下标/解引用）退化为普通 56B 浅物化→242/243/244/246 八形态校验位
        //   ①~⑤⑦ 全丢（rc=160/51/135/223·E2E 实测）——85-a 段恢复原样
        //   （与 759-a 下标末节点扩面协同：返回 数据[i]→生成左值地址→借用
        //   判定命中→深拷归一化）；748 段保持停用（自举零风险）。
        如果 (借用返回85 && 函数信息.返回结构体ID != 0 &&
            资源字段数(函数信息.返回结构体ID) > 0) {
            发射结构体整体拷贝(函数信息, 寄存器计数, ret指针, 值寄存器,
                              函数信息.返回结构体ID, 真, 假);
        } 否则 {
            IR追加(指令, 建IR指令(IR_结构体拷贝, 值寄存器, ret指针, 0, 0,
                                 返回拷贝字节71, 0));
        }
        值寄存器 = ret指针;
        当 (表达式栈.大小() > 0) {
            结果<空类型, 整32> 删栈r = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈r.正常) { 运行时错误(4); }
        }
}

// 87-a（2026-09-12 第八十七轮）：静态字符串赋值归一化（drop 旧 + 来源分级复制）。
//   与 79-a 成员字符串字段位同款分级：字面量=驻留直存（零分配）；白名单八函数/
//   返回字符串契约调用=拥有接管（零拷贝）；其余（标识符/成员/二元/借用返回）
//   =__cn_str_copy 落堆（字段独立副本，源保持拥有照常释放）。顺序：先复制后
//   drop（自赋值 s = s 安全——新值先独立于旧值内存）。
//   静态槽长期存活**恒拥有**（局部按块出口 drop；静态无出口）——赋值必须当场
//   drop 旧值，否则每次赋值泄漏（原实现直存句柄：泄漏 + 借用来源共享悬垂）。
不安全 函数 归一化静态串赋值(向量<节点> 池, 节点 n, 整64 值寄存器, 整64 静序,
                       函数IR& 函数信息, 整64* 寄存器计数) -> 整64 {
    向量<IR指令>& 指令 = 函数信息.指令;
    节点 右末z = 池.元素(整32(n.子终点 - 1));
    布尔 需复制z = 真;
    如果 (右末z.类型 == 节点_字符串字面量) { 需复制z = 假; }
    否则 如果 (右末z.类型 == 节点_调用 && 右末z.子起点 > 0) {
        节点 被调z = 池.元素(整32(右末z.子起点));
        如果 (被调z.类型 == 节点_标识符) {
            整64 被调名z = 整64(被调z.文本);
            布尔 白名单z = 被调名z == 驻留("字符串复制") ||
                          被调名z == 驻留("字符串连接") ||
                          被调名z == 驻留("字符串拼接") ||
                          被调名z == 驻留("字符串子串") ||
                          被调名z == 驻留("字符串大写") ||
                          被调名z == 驻留("字符串小写") ||
                          被调名z == 驻留("字符串修剪") ||
                          被调名z == 驻留("字符串反转");
            如果 (!白名单z && 查函数返回回退(被调名z) == 驻留("字符串")) {
                白名单z = 真;   // A2 契约：签名即契约
            }
            需复制z = !白名单z;
        }
    }
    整64 新值z = 值寄存器;
    如果 (需复制z) { 新值z = 发射字符串复制调用(指令, 寄存器计数, 值寄存器); }
    // drop 旧值（读取旧句柄 → __cn_str_free；空句柄/驻留常量空安全跳过）
    整64 旧regz = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_静态加载, 0, 0, 0, 旧regz, T_字符串, 静序));
    IR追加(指令, 建IR指令(IR_调用实参, 旧regz, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0, 驻留("__cn_str_free")));
    // 写新值
    IR追加(指令, 建IR指令(IR_静态存储, 新值z, 0, 0, 0, T_字符串, 静序));
    返回 新值z;
}

// 赋值语句：文本=左值名（标识符槽/静态槽）；文本=0 时 附加=左值表达式起点
//   （解引用/成员/下标左值，按字段宽度存储）。结构体整体赋值经
//   生成结构体整体赋值（第18枚 POD Copy 语义）先行拦截。
// D1 行数整改 172-a：本体按族拆入 生成语句赋值.cn（生成标识符赋值 /
//   生成成员解引用赋值 + 三发射面族）——本函数收缩为分派骨架（纯重构零
//   行为变更）。




// ==================== 块遍历 ====================
// 生成一个块的语句 IR。返回 布尔=块是否已终止（缺陷A：终止感知）。
函数 生成块(向量<节点> 池, 整32 块节点,
            映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
            函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
            向量<整64>& 表达式栈, 整64 返回类型码) -> 布尔 {
    节点 块 = 池.元素(块节点);
    // 块级作用域析构（用户裁决项2）：入口记录 容器变量们 基线，出口对本块
    //   新增容器发 RAII 析构并截断列表——块结束即释放（安全目标：及时、
    //   作用域精确）；返回语句仍析构全部（跨块跳出兜底，晚析构无害）。
    //   嵌套块同名容器由语义层拒绝（预扫同名合槽，遮蔽会泄漏/双释——P7c 前不支持）。
    //   ②c B：含容器字段结构体局部同款（字段基线 截断）。
    整64 作用域基线 = 函数信息.容器变量们.大小();
    整64 字段作用域基线 = 函数信息.资源字段局部们.大小();
    整64 字符串基线 = 函数信息.字符串变量们.大小();
    整64 数组串基线 = 函数信息.字符串数组变量们.大小();   // 98-a（C9）同款基线
    // 396-a（D36）：块新名清单入栈（352-b 设计）——分配点登记本块新名，
    //   出口（析构后）弹栈逐名删除局部槽绑定=出块恢复外层绑定（遮蔽语义）
    块清单入栈();
    布尔 已终止 = 生成语句(池, 块.子起点, 块.子终点, 局部槽, 参数槽, 函数信息,
                          寄存器计数, 槽计数, 表达式栈, 返回类型码);
    // 出口：析构本块新增容器（逆序——后声明先析构），并从列表截断。
    //   已终止（返回/中断/继续 已跳出）时不发射——控制流不可达，且 返回 已析构全部。
    //   396-a：清单出栈恢复在析构之后（析构用槽）——已终止时也恢复（栈平衡）。
    如果 (!已终止) {
        块出口析构(函数信息, 局部槽, 寄存器计数, 作用域基线, 字段作用域基线,
                  字符串基线, 数组串基线, 真);
    }
    块清单出栈恢复(局部槽);
    返回 已终止;
}

// ==================== 控制流生成（P6b） ====================
// 生成 如果语句：条件寄存器 + 真块/假块 + 汇合块（标签随建随取）。
// 返回 布尔=两分支是否都已终止（缺陷A：终止分支不发汇合跳转——不可达）。
函数 生成如果(向量<节点> 池, 节点 如果节点,
              映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
              函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
              向量<整64>& 表达式栈, 整64 返回类型码) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;    // 节点字段：文本=条件起点，子起点=条件终点，附加=真块索引，子终点=否则索引
    整64 条件寄存器 = 生成表达式(池, 整32(如果节点.文本), 整32(如果节点.子起点),
                                 局部槽, 参数槽, 指令, 寄存器计数, &函数信息.块计数,
                                 槽计数, 表达式栈);
    整64 真块 = 新块(函数信息);
    整64 假块 = 新块(函数信息);
    整64 汇合块 = 新块(函数信息);
    发射条件跳转(函数信息, 条件寄存器, 真块, 假块);
    // 真块
    切换块(函数信息, 真块);
    发射块标签(函数信息, 真块);
    布尔 真终止 = 生成块(池, 整32(如果节点.附加), 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
    如果 (!真终止) {
        发射跳转(函数信息, 汇合块);
    }
    // 假块（否则链）
    切换块(函数信息, 假块);
    发射块标签(函数信息, 假块);
    布尔 假终止 = 假;
    整64 否则索引 = 如果节点.子终点;
    如果 (否则索引 != 0) {
        节点 否则节点 = 池.元素(整32(否则索引));
        如果 (否则节点.类型 == 节点_如果语句) {
            // 否则 如果：递归生成（不额外发射跳转到汇合——递归内已处理）
            假终止 = 生成如果(池, 否则节点, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
        } 否则 {
            假终止 = 生成块(池, 整32(否则索引), 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
        }
    }
    如果 (!假终止) {
        发射跳转(函数信息, 汇合块);
    }
    // 汇合块
    切换块(函数信息, 汇合块);
    发射块标签(函数信息, 汇合块);
    返回 真终止 && 假终止;
}

// 生成 当语句：jmp 条件块 -> 条件表达式 -> 条件跳转 体/出口 -> 体 -> jmp 条件块
// 返回 布尔=假（循环出口恒可达——条件假路径；体终止只省略回边）
函数 生成当(向量<节点> 池, 节点 当节点,
            映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
            函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
            向量<整64>& 表达式栈, 整64 返回类型码) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    整64 条件块 = 新块(函数信息);
    整64 体块 = 新块(函数信息);
    整64 出口块 = 新块(函数信息);
    // 无条件跳入条件块
    发射跳转(函数信息, 条件块);
    // 条件块
    切换块(函数信息, 条件块);
    发射块标签(函数信息, 条件块);    // 节点字段：文本=条件起点，附加=体块索引，子起点=条件终点
    整64 条件寄存器 = 生成表达式(池, 整32(当节点.文本), 整32(当节点.子起点),
                                 局部槽, 参数槽, 指令, 寄存器计数, &函数信息.块计数,
                                 槽计数, 表达式栈);
    发射条件跳转(函数信息, 条件寄存器, 体块, 出口块);
    // 体块：记录循环上下文（继续->条件块，中断->出口块）
    整64 旧出口 = 函数信息.循环出口块;
    整64 旧继续 = 函数信息.循环继续块;
    函数信息.循环出口块 = 出口块;
    函数信息.循环继续块 = 条件块;
    // 413-a（D44）：循环内中断绑定**最近**的选择或循环——暂存清 0 选择出口
    //   （恢复在体块生成后）=当体内 中断 跳循环出口（外层选择不被误跳）
    整64 旧选择出口D = 函数信息.选择出口块;
    函数信息.选择出口块 = 0;
    // 73-a（2026-09-11 方案A 用户裁决）：循环体基线三枚——中断/继续
    //   drop-on-jump 的释放范围起点（进入体前名单大小；嵌套循环保存/恢复，
    //   内层跳出只释放内层已声明资源）
    整64 旧串基线 = 函数信息.循环串基线;
    整64 旧容基线 = 函数信息.循环容基线;
    整64 旧字基线 = 函数信息.循环字段基线;
    整64 旧数组串基线 = 函数信息.循环数组串基线;   // 98-a（C9）
    函数信息.循环串基线 = 函数信息.字符串变量们.大小();
    函数信息.循环容基线 = 函数信息.容器变量们.大小();
    函数信息.循环字段基线 = 函数信息.资源字段局部们.大小();
    函数信息.循环数组串基线 = 函数信息.字符串数组变量们.大小();
    切换块(函数信息, 体块);
    发射块标签(函数信息, 体块);
    布尔 体终止 = 生成块(池, 整32(当节点.附加), 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
    函数信息.循环出口块 = 旧出口;
    函数信息.循环继续块 = 旧继续;
    函数信息.选择出口块 = 旧选择出口D;
    函数信息.循环串基线 = 旧串基线;
    函数信息.循环容基线 = 旧容基线;
    函数信息.循环字段基线 = 旧字基线;
    函数信息.循环数组串基线 = 旧数组串基线;   // 98-a（C9）
    如果 (!体终止) {
        发射跳转(函数信息, 条件块);
    }
    // 出口块
    切换块(函数信息, 出口块);
    发射块标签(函数信息, 出口块);
    返回 假;
}

// 413-a（D44 正体收口）：选择语句生成——宿主 genSwitch 判断链模型同构
//   （ir_stmt.cpp:332：选择值求值一次槽化 → 每 case 判断块 cmp+条件跳转 →
//   体块未终止直落 下一体块/默认/出口=真 C fall-through 语义，**无贯穿标志**）。
//   中断绑定：函数信息.选择出口块=出口块（生成语句 中断分派既有优先级生效；
//   进入循环时暂存清 0=最近绑定，见 生成当/生成循环 暂存对）。
//   恒不终止（判断链/默认/直落三路均有出口块可达路径）→ 空类型 返回（生成语句
//   主循环按语句处理，不取终止性——选择出口恒可达）。
不安全 函数 生成选择语句(向量<节点> 池, 节点 选择节点,
              映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
              函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
              向量<整64>& 表达式栈, 整64 返回类型码) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    // ① 选择值：求值一次+槽化（判断链跨块——虚拟寄存器跨块不保，88-a 短路
    //   临时槽同款；类型码取登记值·0=整64 兜底）
    整64 值寄存器 = 生成表达式(池, 整32(选择节点.文本), 整32(选择节点.附加),
                                 局部槽, 参数槽, 指令, 寄存器计数, &函数信息.块计数,
                                 槽计数, 表达式栈);
    整64 值码 = 查寄存器类型(值寄存器);
    如果 (值码 == 0) { 值码 = T_整64; }
    整64 值槽 = 槽计数[0];
    槽计数[0] = 槽计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 值槽));
    IR追加(指令, 建IR指令(IR_存储, 值寄存器, 0, 0, 0, 0, 值槽));
    // ② 收集情况：非默认（值区间非空）顺序入列；默认（[0,0)）单独记。
    //   **类型过滤=节点_情况标签**——情况段 [子起点,子终点) 含情况值表达式与
    //   体语句节点（先于标签入池），不过滤会把它们的 子起点 误当体块索引。
    向量<整64> 情况索引们 = 向量<整64>();
    整64 默认索引 = 0;
    整64 况i = 整64(选择节点.子起点);
    当 (况i < 整64(选择节点.子终点)) {
        节点 情况节点 = 池.元素(整32(况i));
        如果 (情况节点.类型 == 节点_情况标签) {
            如果 (情况节点.文本 == 0 && 情况节点.附加 == 0) {
                默认索引 = 况i;
            } 否则 {
                结果<空类型, 整32> 加况 = 情况索引们.追加(况i);
                如果 (!加况.正常) { 运行时错误(4); }
            }
        }
        况i++;
    }
    整64 情况数 = 情况索引们.大小();
    // ③ 块预分配（宿主同款：判断块+体块 每情况一对·默认块·出口块）
    向量<整64> 判断块们 = 向量<整64>();
    向量<整64> 体块们 = 向量<整64>();
    整64 预i = 0;
    当 (预i < 情况数) {
        结果<空类型, 整32> 加判 = 判断块们.追加(新块(函数信息));
        如果 (!加判.正常) { 运行时错误(4); }
        结果<空类型, 整32> 加体 = 体块们.追加(新块(函数信息));
        如果 (!加体.正常) { 运行时错误(4); }
        预i++;
    }
    整64 默认块 = 0;
    如果 (默认索引 != 0) { 默认块 = 新块(函数信息); }
    整64 出口块 = 新块(函数信息);
    // ④ 中断绑定（最近绑定的「选择」半边——恢复点=出口块切换前）
    整64 旧选择出口 = 函数信息.选择出口块;
    函数信息.选择出口块 = 出口块;
    // ⑤ 入口跳转：无情况（含纯默认）直接落 默认/出口
    如果 (情况数 > 0) {
        发射跳转(函数信息, 判断块们.元素(0));
    } 否则 {
        如果 (默认块 != 0) { 发射跳转(函数信息, 默认块); }
        否则 { 发射跳转(函数信息, 出口块); }
    }
    // ⑥ 判断链：值==情况值（字符串情况 __cn_str_eq）→ 匹配体块/不匹配下一判断
    整64 链尾目标 = 出口块;
    如果 (默认块 != 0) { 链尾目标 = 默认块; }
    整64 链i = 0;
    当 (链i < 情况数) {
        整64 判断块 = 判断块们.元素(链i);
        切换块(函数信息, 判断块);
        发射块标签(函数信息, 判断块);
        节点 情况节点 = 池.元素(整32(情况索引们.元素(链i)));
        整64 情况值寄存器 = 0;
        // 958（63/66 族）：情况位裸枚举成员→直接常量（宿主 C-4 定向解析对照·
        //   v2 裸名直查枚举成员值表）
        布尔 裸枚举常量958 = 假;
        如果 (情况节点.附加 - 情况节点.文本 == 1) {
            节点 况首958 = 池.元素(整32(情况节点.文本));
            如果 (况首958.类型 == 节点_标识符) {
                整64 裸值958 = 查枚举成员裸名值958(整64(况首958.文本));
                如果 (裸值958 >= 0) {
                    情况值寄存器 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(裸值958)), 0, 0, 情况值寄存器, T_整64, 0));
                    登记寄存器类型(情况值寄存器, T_整64);
                    裸枚举常量958 = 真;
                }
            }
        }
        如果 (!裸枚举常量958) {
            情况值寄存器 = 生成表达式(池, 整32(情况节点.文本), 整32(情况节点.附加),
                                     局部槽, 参数槽, 指令, 寄存器计数, &函数信息.块计数,
                                     槽计数, 表达式栈);
        }
        整64 值载入 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_加载, 值槽, 0, 0, 值载入, 值码, 0));
        登记寄存器类型(值载入, 值码);
        整64 比较寄存器 = 0;
        如果 (情况节点.子终点 == 1) {
            // 字符串情况：__cn_str_eq(选择值, 情况字面量)（宿主 C-4 同款）
            整64 串等寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_调用实参, 值载入, 0, 0, 0, 0, 0));
            IR追加(指令, 建IR指令(IR_调用实参, 情况值寄存器, 0, 0, 0, 1, 0));
            IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 串等寄存器, 0,
                                 驻留("__cn_str_eq")));
            登记寄存器类型(串等寄存器, T_布尔);
            比较寄存器 = 串等寄存器;
        } 否则 {
            整64 相等寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            整64 二元码 = 公共整型提升(值码, 查寄存器类型(情况值寄存器));
            IR追加(指令, 建IR指令(IR_相等, 值载入, 情况值寄存器, 0, 相等寄存器, 二元码, 0));
            登记寄存器类型(相等寄存器, T_布尔);
            比较寄存器 = 相等寄存器;
        }
        // 不匹配目标：下一判断块/链尾（默认/出口）
        整64 不匹配目标 = 链尾目标;
        如果 (链i + 1 < 情况数) { 不匹配目标 = 判断块们.元素(链i + 1); }
        发射条件跳转(函数信息, 比较寄存器, 体块们.元素(链i), 不匹配目标);
        // ⑦ 体块：未终止直落 下一体块/默认/出口（跳过中间判断=真 C fall-through）
        整64 体块 = 体块们.元素(链i);
        切换块(函数信息, 体块);
        发射块标签(函数信息, 体块);
        布尔 体终止 = 生成块(池, 整32(情况节点.子起点), 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
        如果 (!体终止) {
            整64 直落目标 = 出口块;
            如果 (链i + 1 < 情况数) {
                直落目标 = 体块们.元素(链i + 1);
            } 否则 {
                如果 (默认块 != 0) { 直落目标 = 默认块; }
            }
            发射跳转(函数信息, 直落目标);
        }
        链i++;
    }
    // ⑧ 默认块
    如果 (默认块 != 0) {
        切换块(函数信息, 默认块);
        发射块标签(函数信息, 默认块);
        节点 默认情况 = 池.元素(整32(默认索引));
        布尔 默认终止 = 生成块(池, 整32(默认情况.子起点), 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
        如果 (!默认终止) { 发射跳转(函数信息, 出口块); }
    }
    // ⑨ 出口块+恢复中断绑定
    函数信息.选择出口块 = 旧选择出口;
    切换块(函数信息, 出口块);
    发射块标签(函数信息, 出口块);
}

// 357-a（D39 根治）：三段式循环生成——原生四块序（init 语句段内联发射 →
//   条件块〔cond 空=常量真〕→ 体块〔循环继续块=**步进块**·继续→step 语义
//   C for 同款；中断→出口；73-a 基线五枚保存恢复〕→ 步进块（step 段+回跳
//   条件）→ 出口块）。节点字段：文本=init 起点、子起点=cond 起点、
//   子终点=step 起点、附加=体块索引（step 段=[子终点, 附加-1)、
//   step 包装节点=附加-1）。
// 894-a（070·G-N 特性波3·61/97）：遍历语句生成——数组形态（基址+索引x宽
//   直读·推导下标元素类型ID/推导下标数组长度 复用〔标识符数组/指针/结构体
//   字段数组三形态同源〕）；块结构=生成循环 同款（条件/体/步进/出口四块+
//   循环上下文四基线）；每轮=元素读（IR_指针加载 按元素宽度码）→迭代变量
//   槽存储→体块递归。迭代变量登记 局部槽/当前函数变量类型（体内消费走常规
//   通道）。容器形态（大小()/元素(i) 合成调用）登记诚实边界（002 后续波）。
//   宿主语义层降级为 循环 的生成层等价（v2 池不可变·语义层无改写通道）。
