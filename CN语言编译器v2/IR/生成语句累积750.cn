// CN 自举编译器 v2 · 循环累积拼接提升（任务 750——宿主 ir_string_accum.cpp 的 v2 同构）
// 职责：`s = s + x`（或 `s += x`·语法层脱糖为同形态）在**循环内每轮整串拷贝**
//   （O(k²) 字节·001 §10.3 用法警示 #728i/b1 基准 8192 轮≈1GB）——编译器识别
//   该跨迭代累积，改写为「循环前 新建构建器+追加初值 → 循环内逐段追加 →
//   循环出口 完成+回写 s」（复用 366 runtime __cn_strbuf_*·Rust push_str 模型）。
//   同一表达式内 a+b+c 链融合=728o/749（另一层），本文件=跨迭代层。
//
// 识别判据（保守且可证明·任一不满足=不优化·原路径零变更；miss 方向恒安全）：
//   ① 目标 s = 本函数**拥有型字符串局部**：查当前函数变量类型==字符串（局部槽
//      命中）+ 字符串变量们 名单（拥有）+ 非污染 + 非引用槽——参数借用/静态/
//      引用参数一律排除（free 旧值的前提）；
//   ② 循环体内**恰好一处**语句位赋值 `s = s + x`（右值根=二元 +、左根=同一
//      标识符 s；复合赋值合成二元 子终点=1 同认·普通二元 子终点=0）；
//   ③ s 在循环体内**除右值左根外零出现**（打印/传参/取地址/字段/下标/容器暂存
//      /其它读写都计入标识符出现）；赋值节点目标为 s 的赋值数恰好 1——循环内
//      不读 s ⇒ 段追加不遗漏旧值内容；
//   ④ 循环体无 返回（提前离开不经出口块 ⇒ 构建器泄漏+s 不落地）；中断/继续
//      允许（中断跳出口块、继续跳下一轮，构建器生命周期天然覆盖）；
//   ⑤ 循环体无嵌套循环/遍历（内层生成时独立判定；外层拒绝=保守）、无同名局部
//      声明（遮蔽后名字指向内层槽）；
//   ⑥ 循环头（for 的 init/cond/步进、当 的条件）零出现 s；
//   ⑦ 候选赋值必须是**语句位**（生成语句 主遍历会派发它的位置）——表达式位
//      赋值（`返回 s = s + x` / 实参位）不优化（其值被消费，语义不同）。
//   判据 miss 一律走原路径（业务优化判定·非语义默认值）。
//
// 发射序列（语义等价铁律同宿主）：
//   循环前：句柄=__cn_strbuf_new(); __cn_strbuf_append(句柄, *s 初值)
//   循环内：命中累积赋值 → 段 x 求值 → 数值转换/追加/拥有临时结算（复用 749
//           连接链段辅助=同一判据单点）
//   出口块：结果=__cn_strbuf_finish(句柄); __cn_str_free(*s 旧值); *s=结果
//   ①终串逐字节=初值+各轮 x 顺序拼接；②x 求值顺序/次数/时点与原路径逐点镜像；
//   ③拥有权：finish 产物新拥有串（与 __cn_str_concat 同契约）；④分配失败=
//   new 空句柄空安全退化/扩容失败 #983 错误码 4 终止（构建器契约保留）。
导入 容器::向量;
导入 IR;         // 节点结构（IR常量区段·未定义导入 语法=避免新增跨层依赖）
导入 协议常量;   // 节点_*/T_* 常量 + 变量类型权威表
导入 IR生成;     // 寄存器计数/类型登记权威表
导入 生成表达式; // 生成表达式（段求值）
导入 生成表达式连接;   // 749：连接链段辅助（段码/追加/结算单点）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 累积提升上下文（三值成对：宿主 StringAccumCtx 的 v2 同构）。
//   累积赋值节点=池索引（0-1=无上下文）；目标名ID/槽/句柄=改写与收尾依据。
静态 整64 累积赋值节点750 = 0 - 1;
静态 整64 累积目标ID750 = 0;
静态 整64 累积目标槽750 = 0;
静态 整64 累积句柄750 = 0;
// 750 复审返工（P0-1/P0-2/P0-3）：函数级别名逃逸表（名ID -> 1）与 lambda 存在
//   标志——引用声明 `字符串& r = s` / 取地址 `&s` / lambda 捕获的读取会绕过
//   构建器期间不更新的 s 槽（原语义读最新累积值=错值/死循环）。函数入口
//   准备累积上下文750 扫描函数体块填充，判据①命中即拒绝整循环（含头段）。
静态 映射<整64, 整64> 累积逃逸名们750;
静态 布尔 累积函数含lambda750 = 假;
// P0-1 扩展：函数内引用声明/字符串指针或视图局部（别名目标经调用返回间接指向
//   累积目标时静态不可追踪）→ 抑制整函数累积提升。
静态 布尔 累积函数有别名750 = 假;
// 生成语句 主循环派发当前 节点_赋值 时写入的池索引（语句位判定事实源——
//   生成赋值语句 只经该主循环调用，表达式位赋值经 生成表达式 不经此处）
静态 整64 当前语句节点索引750 = 0 - 1;

// 语句位事实源写入（生成语句 非 不安全 函数——静态写经本访问函数单点）
不安全 函数 设当前语句节点750(整64 索引) -> 空类型 {
    当前语句节点索引750 = 索引;
}

// 函数级上下文复位（生成函数/生成方法 入口调用·防识别成功后生成中途中止的
//   跨函数残留）
不安全 函数 清空累积上下文750() -> 空类型 {
    累积赋值节点750 = 0 - 1;
    累积目标ID750 = 0;
    累积目标槽750 = 0;
    累积句柄750 = 0;
    累积逃逸名们750.清空();
    累积函数含lambda750 = 假;
    累积函数有别名750 = 假;
}

// 逃逸名登记（函数级扫描输出）
不安全 函数 标记逃逸750(整64 名ID) -> 空类型 {
    结果<空类型, 整32> 设 = 累积逃逸名们750.设置(名ID, 1);
    如果 (!设.正常) { 运行时错误(4); }
}

// 调用引用实参隐式取址逃逸（P0-2·750 复审）：宿主语义层 wrapRefArgs 已把
//   `f(s)`（形参 T&）改写为 `f(&s)`——AST 扫描天然覆盖；v2 取地址在 IR 回扫
//   （语义检查实参 623），池扫描不可见 → 语义层 借用位扫描202 已按「引用位 ×
//   实参根标识符」登记到中立表（引用实参根名们），此处查表登记逃逸（单一事实
//   源·无重复决议/无生成期状态依赖）。方法/构造/接口调用同表覆盖（202 全形态）。
不安全 函数 扫描调用引用逃逸750(向量<节点> 池, 整64 调用位) -> 空类型 {
    节点 nd = 池.元素(整32(调用位));
    布尔 已扫描 = 引用实参已扫描(调用位);
    如果 (已扫描) {
        布尔 未登记 = 引用实参未登记(调用位);
        如果 (未登记) {
            // P1-3（750 复审4 fail-closed 子缺口）：引用位实参根非标识符
            //   （f(obj.field)/f(arr[i])/f(*(&s))）——根名不可追踪=别名逃逸
            //   嫌疑，整函数拒绝（原「已扫描→逐位 miss→静默放行」缺口）。
            累积函数有别名750 = 真;
        } 否则 如果 (!未登记) {
            // 已扫描且全可追踪：查根名表逐位登记
            整64 实对数 = 整64(nd.附加);
            整64 实i = 0;
            当 (实i < 实对数) {
                可选<整64> 根名 = 查引用实参根(调用位, 实i);
                如果 (根名.有值) { 标记逃逸750(根名.值); } 否则 { }
                实i++;
            }
        } 否则 { }
    } 否则 如果 (!已扫描) {
        // P0-A-1 安全网（fail-closed）：未扫描调用——若实参区间含标识符（可能
        //   被引用形参隐式取址/未知形态持有），整函数拒绝优化（未知形态降级为
        //   少优化，绝不降级为错值）。实参区间=[子起点+1, 调用位)；内置函数
        //   （打印族/转换族等·无引用形参）不参与。
        节点 被调 = 池.元素(整32(nd.子起点));
        布尔 是内置 = 假;
        如果 (被调.类型 == 节点_标识符) {
            // 内置族（打印/打印行 变参 + 内置符号直查表·含限定名归一）无引用
            //   形参=不持局部地址 → 安全网放行（否则 打印(s) 等会误拒整函数）
            字符串 调名 = 字符串复制(驻留文本(整64(被调.文本)));
            // 750 复审4/5/6：930 守卫=「模块函数存在时内置让位」（模块函数优先930
            //   自带模块/自模块豁免判定），打印族与内置族同受其约束；归一基名仅
            //   在含 "::" 时调用（非限定名省一次字符串复制）。
            布尔 用户优先 = 模块函数优先930(调名);
            字符串 归一调名 = 调名;
            布尔 有模块限 = 字符串查找(调名, "::") >= 0;
            如果 (有模块限) { 归一调名 = 内置归一基名(调名); } 否则 { }
            布尔 是打印 = !用户优先 &&
                          (字符串比较(调名, "打印") || 字符串比较(调名, "打印行") ||
                           字符串比较(归一调名, "打印") || 字符串比较(归一调名, "打印行"));
            布尔 是内置名 = 假;
            如果 (!用户优先) {
                可选<字符串> 内置查 = 内置函数符号(调名);
                如果 (内置查.有值) { 是内置名 = 真; } 否则 { }
            } 否则 { }
            是内置 = 是打印 || 是内置名;
        } 否则 { }
        // 静默豁免业务值: 未扫描调用实参区间无标识符（字面量/纯算术）=无别名可逃逸（fail-closed 仅对标识符实参）
        如果 (!是内置) {
            整64 q = 整64(nd.子起点) + 1;
            当 (q < 调用位) {
                节点 实节 = 池.元素(整32(q));
                如果 (实节.类型 == 节点_标识符) { 累积函数有别名750 = 真; } 否则 { }
                q++;
            }
        } 否则 { }
    }
}

// 函数级逃逸扫描（宿主 beginAccumScope 的 v2 同构·P0-1/P0-2/P0-3/P1-4）：
//   体块区间内 ①节点_取地址 根=标识符 → 该名逃逸（指针/引用可读写）；
//   ②节点_变量声明 类型节点附加>=256（引用形态）且初始化根=标识符 → 该名逃逸；
//   ③节点_标识符 文本前缀 "?"（lambda 占位）→ 函数含 lambda（其捕获读取时点
//   与构建器期间 s 槽不更新不可证明等价——保守拒绝整函数提升）；
//   ④节点_调用 → 引用实参位实参根标识符登记逃逸（P0-2 见上）；
//   ⑤字符串指针/视图局部（含 `字符*` 单星合成名与 `字符*[N]` 视图数组）→ 函数
//   级抑制（别名目标静态不可追踪）。
不安全 函数 准备累积上下文750(向量<节点> 池, 整64 体块索引) -> 空类型 {
    清空累积上下文750();
    布尔 索引合法 = 体块索引 > 0 && 体块索引 < 整64(池.大小());
    布尔 是块 = 假;
    如果 (索引合法) {
        是块 = 池.元素(整32(体块索引)).类型 == 节点_块;
    } 否则 { }
    如果 (索引合法 && !是块) {
        // #648 内部错误显形：体块索引指向非 节点_块=编译器状态机缺陷（原静默
        //   跳过=累积提升静默失效，用户可观测为性能退化无诊断）
        IR层诊断("内部错误: 循环累积提升体块索引非 节点_块（索引=" +
                 整数转字符串(体块索引) + "）");
    } 否则 { }
    如果 (索引合法 && 是块) {
        节点 体块节点 = 池.元素(整32(体块索引));
        整64 起 = 整64(体块节点.子起点);
        整64 终 = 整64(体块节点.子终点);
        整64 p = 起;
        当 (p < 终) {
            节点 nd = 池.元素(整32(p));
            布尔 是标识符 = nd.类型 == 节点_标识符;
            如果 (是标识符) {
                // 借用直判（不复制：自举规模下每节点一次 字符串复制=可观分配）
                布尔 是lambda占位 = 文本前缀217(驻留文本(整64(nd.文本)), "?");
                如果 (是lambda占位) { 累积函数含lambda750 = 真; }
            } 否则 { }
            如果 (nd.类型 == 节点_调用) {
                扫描调用引用逃逸750(池, p);
            } 否则 { }
            如果 (nd.类型 == 节点_取地址) {
                布尔 有操作数 = 整64(nd.子起点) < p;
                如果 (有操作数) {
                    节点 根 = 池.元素(整32(p - 1));
                    布尔 根是标识符 = 根.类型 == 节点_标识符;
                    如果 (根是标识符) { 标记逃逸750(整64(根.文本)); } 否则 如果 (!根是标识符) {
                        // P1-1（750 复审5 零分叉）：取地址操作数非标识符
                        //   （&槽.数/&表[i]/&*p）——别名目标静态不可追踪，
                        //   整函数抑制（与宿主 ir_string_accum hasAlias 同口径）
                        累积函数有别名750 = 真;
                    } 否则 { }
                } 否则 { }
            } 否则 { }
            如果 (nd.类型 == 节点_变量声明) {
                整64 类型位 = 整64(nd.附加);
                布尔 类型位合法 = 类型位 > 0 && 类型位 < 整64(池.大小());
                如果 (类型位合法) {
                    节点 类型节点 = 池.元素(整32(类型位));
                    布尔 是类型节点 = 类型节点.类型 == 节点_类型;
                    整64 类型附加 = 类型节点.附加;
                    布尔 是引用类型 = 是类型节点 && 类型附加 >= 256;
                    // 指针层>0 且基名=字符串/字符 → 字符串指针/视图局部（别名面）
                    字符串 类型文本q = 是类型节点 ?
                        字符串复制(驻留文本(整64(类型节点.文本))) : 字符串复制("");
                    // P1-4（750 复审）：`字符*` 单星在解析层合成为类型名「字符*」
                    //   且指针层=0（解析表达式尾.cn 字符* 合成），原「文本==字符 且
                    //   附加%256>0」永不命中 → 视图局部漏检。补 文本=="字符*"
                    //   （含 `字符*[N]` 视图数组前缀）+ 原 字符串/字符 指针形态。
                    布尔 基名串 = 是类型节点 &&
                                   (字符串比较(类型文本q, "字符串") ||
                                    字符串比较(类型文本q, "字符"));
                    布尔 是字符星视图 = 是类型节点 &&
                                         文本前缀217(类型文本q, "字符*");
                    布尔 是串指针 = 是类型节点 &&
                                    ((类型附加 % 256 > 0 && 基名串) || 是字符星视图);
                    如果 (是引用类型 || 是串指针) {
                        累积函数有别名750 = 真;
                    } 否则 { }
                    整64 右起 = 整64(nd.子起点);
                    整64 右终 = 整64(nd.子终点);
                    布尔 有初值 = 右起 < 右终;
                    如果 (是引用类型 && 有初值) {
                        节点 根 = 池.元素(整32(右终 - 1));
                        布尔 根是标识符 = 根.类型 == 节点_标识符;
                        如果 (根是标识符) { 标记逃逸750(整64(根.文本)); } 否则 { }
                    } 否则 { }
                } 否则 { }
            } 否则 { }
            p++;
        }
    } 否则 { }
}

// 区间向量追加（错误=内部错误显形·与既有预扫描族同款）
不安全 函数 累积压整750(向量<整64>& 目标, 整64 值) -> 空类型 {
    结果<空类型, 整32> 加 = 目标.追加(值);
    如果 (!加.正常) { 运行时错误(4); }
}

// 目标是否拥有型字符串局部（判据①·宿主 isOwnedStringSlot 同构）：
//   类型权威表==字符串（本函数局部）+ 局部槽命中 + 字符串变量们 名单 + 非污染
//   + 非引用槽。参数在 参数槽（不查）⇒ 借用形参天然排除；静态/顶层变量不在
//   局部槽 ⇒ 排除。单出口布尔（判据 miss=不满足·无默认值分流）。
函数 累积目标可提升750(整64 名ID, 映射<整64, 整64>& 局部槽,
               函数IR& 函数信息) -> 布尔 {
    布尔 名有效 = 名ID != 0;
    可选<整64> 类型ID查 = 查当前函数变量类型(名ID);
    整64 类型ID = 0;   // 1360 结果化：miss=无值→0（下方 类型有效=类型ID>0 判定同源）
    如果 (类型ID查.有值) { 类型ID = 类型ID查.值; }
    布尔 类型有效 = 类型ID > 0;
    布尔 是字符串 = 类型有效 && 字符串比较(驻留文本(类型ID), "字符串");
    结果<整64, 整32> 查槽 = 局部槽.获取(名ID);
    布尔 非引用 = 假;
    如果 (查槽.正常) {
        布尔 是引用槽 = 槽是引用(查槽.值);
        如果 (!是引用槽) { 非引用 = 真; } 否则 { }
    } 否则 { }
    布尔 在名单 = 假;
    整64 i = 0;
    当 (i < 函数信息.字符串变量们.大小()) {
        如果 (函数信息.字符串变量们.元素(整32(i)) == 名ID) { 在名单 = 真; 中断; }
        i++;
    }
    结果<整64, 整32> 查污 = 函数信息.字符串污染们.获取(名ID);
    布尔 未污染 = !查污.正常;
    结果<整64, 整32> 查逃逸 = 累积逃逸名们750.获取(名ID);
    布尔 未逃逸 = !查逃逸.正常;
    布尔 无lambda = !累积函数含lambda750;
    布尔 无别名 = !累积函数有别名750;
    返回 名有效 && 是字符串 && 非引用 && 在名单 && 未污染 && 未逃逸 &&
           无lambda && 无别名;
}

// 区间扫描（判据③④⑤）：收集目标名标识符出现位/目标赋值节点位，标记危险面。
不安全 函数 扫描累积区间750(向量<节点> 池, 整64 起, 整64 终, 整64 名ID,
                  向量<整64>& 标识符位们, 向量<整64>& 赋值位们,
                  布尔& 有返回, 布尔& 有嵌套循环, 布尔& 同名声明,
                  布尔& 有lambda) -> 空类型 {
    整64 p = 起;
    当 (p < 终) {
        节点 nd = 池.元素(整32(p));
        如果 (nd.类型 == 节点_标识符 && 整64(nd.文本) == 名ID) {
            累积压整750(标识符位们, p);
        } 否则 如果 (nd.类型 == 节点_标识符) {
            // P0-3：循环体内 lambda 字面量（?lambdaN 占位）→ 拒绝（捕获读取
            //   时点与构建器期间 s 槽不更新不等价；函数级标志同源双保险）。
            //   借用直判（不复制·自举规模分配）。
            布尔 是lambda占位 = 文本前缀217(驻留文本(整64(nd.文本)), "?");
            如果 (是lambda占位) { 有lambda = 真; } 否则 { }
        } 否则 如果 (nd.类型 == 节点_赋值 && 整64(nd.文本) == 名ID) {
            累积压整750(赋值位们, p);
        } 否则 如果 (nd.类型 == 节点_变量声明 && 整64(nd.文本) == 名ID) {
            同名声明 = 真;
        } 否则 如果 (nd.类型 == 节点_返回语句) {
            有返回 = 真;
        } 否则 如果 (nd.类型 == 节点_错误传播) {
            // P0-3（750 复审）：`表达式?` 的 err 块直接返回（不经循环出口块）——
            //   构建器槽未 finish=泄漏（262144 槽上限后错误码 4）。早退判据同
            //   返回面拒绝。
            有返回 = 真;
        } 否则 如果 (nd.类型 == 节点_循环语句 || nd.类型 == 节点_当语句 ||
                      nd.类型 == 节点_遍历语句) {
            有嵌套循环 = 真;
        }
        p++;
    }
}

// 头段干净判定（判据⑥）：区间内零出现 s（标识符/赋值目标/同名声明）。
函数 累积头段干净750(向量<节点> 池, 整64 起, 整64 终, 整64 名ID) -> 布尔 {
    布尔 干净 = 真;
    整64 p = 起;
    当 (p < 终) {
        节点 nd = 池.元素(整32(p));
        如果 (nd.类型 == 节点_标识符 && 整64(nd.文本) == 名ID) { 干净 = 假; }
        如果 (nd.类型 == 节点_赋值 && 整64(nd.文本) == 名ID) { 干净 = 假; }
        如果 (nd.类型 == 节点_变量声明 && 整64(nd.文本) == 名ID) { 干净 = 假; }
        // P0-3（750 复审）：头段 `?` 传播=早退（条件/步进求值期 err 块返回，
        //   构建器槽未收尾）→ 头段不干净（拒绝整循环）
        如果 (nd.类型 == 节点_错误传播) { 干净 = 假; }
        p++;
    }
    返回 干净;
}

// 表达式区间覆盖判定（P1-5·750 复审）：主遍历对任意位置 节点_赋值 派发是既有
//   性能观察点：O(m×n)（每候选×体区间全扫）——v2 全树候选数百/体数千，实测
//   自举编译时间占比可忽略；若后续体量增长可改预收集区间表+二分，本轮不动。
//   缺陷（#1517 另案全量修复）；750 侧不以「位置可达」判语句位——先排除「任何
//   语句节点携带的表达式区间」内的候选（表达式位赋值=值被消费，不优化）。
//   区间来源=语句节点的表达式字段（表达式语句/返回/声明初值/赋值右值/如果与
//   当的条件/循环 init+cond+step/遍历迭代对象/选择值/情况值）。
函数 累积在表达式区间内750(向量<节点> 池, 整64 起, 整64 终, 整64 候选) -> 布尔 {
    布尔 命中 = 假;
    整64 p = 起;
    当 (p < 终) {
        节点 nd = 池.元素(整32(p));
        整64 区起 = 0;
        整64 区终 = 0;
        布尔 有区间 = 假;
        如果 (nd.类型 == 节点_表达式语句 || nd.类型 == 节点_返回语句 ||
             nd.类型 == 节点_变量声明 || nd.类型 == 节点_常量声明 ||
             nd.类型 == 节点_静态声明 || nd.类型 == 节点_赋值) {
            区起 = 整64(nd.子起点);
            区终 = 整64(nd.子终点);
            有区间 = 真;
        } 否则 如果 (nd.类型 == 节点_如果语句 || nd.类型 == 节点_当语句 ||
                      nd.类型 == 节点_遍历语句) {
            区起 = 整64(nd.文本);
            区终 = 整64(nd.子起点);
            有区间 = 真;
        } 否则 如果 (nd.类型 == 节点_循环语句) {
            区起 = 整64(nd.文本);
            区终 = 整64(nd.子终点);
            整64 体块索引 = 整64(nd.附加);
            布尔 体块合法 = 体块索引 > 0 && 体块索引 < 整64(池.大小());
            如果 (体块合法) {
                节点 体块 = 池.元素(整32(体块索引));
                区终 = 整64(体块.子起点);
            } 否则 { }
            有区间 = 真;
        } 否则 如果 (nd.类型 == 节点_选择语句 || nd.类型 == 节点_情况标签) {
            区起 = 整64(nd.文本);
            区终 = 整64(nd.附加);
            有区间 = 真;
        } 否则 { }
        如果 (有区间 && 候选 >= 区起 && 候选 < 区终) { 命中 = 真; 中断; } 否则 { }
        p++;
    }
    返回 命中;
}

// 语句位判定（判据⑦）：模拟 生成语句 主遍历的跳过规则，判断候选池索引是否
//   被派发为语句（与 生成语句 跳过逻辑同源：控制流体块/裸块/循环前置段/
//   遍历前置区；被跳过的控制流体块/裸块/选择情况体**递归**进入其语句区间——
//   同 生成如果/生成选择语句/生成块 的递归派发口径）。表达式位赋值不在此集合
//   （其值被消费·不优化）。
//   不可达段等价性声明：模拟不建模「返回/中断/继续 后的语句不可达」（主遍历
//   遇这些语句即终止本块）——影响面仅为候选落在这些语句之后的死代码里：
//   ①有 返回 → 判据④整循环拒绝（不达本判定）；②中断/继续 之后的赋值虽被判
//   语句位并可能改写为 append，但执行流不可达=append 不执行，s 不变，与原
//   死代码语义逐字节一致（无错值面）。
函数 累积语句位750(向量<节点> 池, 整64 起, 整64 终, 整64 候选) -> 布尔 {
    布尔 在表达式内 = 累积在表达式区间内750(池, 起, 终, 候选);
    布尔 在区间 = !在表达式内 && 候选 >= 起 && 候选 < 终;
    布尔 命中 = 假;
    如果 (在区间) {
        向量<整64> 体块们 = 向量<整64>();
        向量<整64> 裸块们 = 向量<整64>();
        扫描控制流体块(池, 整32(起), 整32(终), 体块们, 裸块们);
        向量<整64> 循环节点们 = 向量<整64>();
        向量<整64> 遍历节点们 = 向量<整64>();
        整64 预扫 = 起;
        当 (预扫 < 终) {
            节点 预节点 = 池.元素(整32(预扫));
            如果 (预节点.类型 == 节点_循环语句) { 累积压整750(循环节点们, 预扫); } 否则 { }
            如果 (预节点.类型 == 节点_遍历语句) { 累积压整750(遍历节点们, 预扫); } 否则 { }
            预扫++;
        }
        整64 位置 = 起;
        当 (位置 < 终) {
            可选<整32> 跳块查 = 语句块跳过位置(池, 体块们, 整32(位置));
            整32 跳块 = 0 - 1;   // 1360 结果化：无值→-1（有跳块判定同源）
            如果 (跳块查.有值) { 跳块 = 跳块查.值; }
            布尔 有跳块 = 跳块 >= 0;
            如果 (有跳块) {
                // P1-1（复审返工）：递归进入被跳过的控制流体块/选择情况体——
                //   其内语句由 生成如果/生成选择语句/生成块 递归派发，候选同样
                //   是语句位（原实现整块跳过=if/else/裸块内候选误判非语句位，
                //   与宿主递归口径分叉：2048 轮分配 65537 vs 67143680）。
                //   注意 语句块跳过位置 返回**块索引+1**（跳转目标），块索引=返回值-1。
                整64 块索引 = 整64(跳块) - 1;
                节点 跳块节点 = 池.元素(整32(块索引));
                布尔 块命中 = 累积语句位750(池, 整64(跳块节点.子起点),
                                            整64(跳块节点.子终点), 候选);
                如果 (块命中) { 命中 = 真; 中断; } 否则 { }
                位置 = 整64(跳块);
                继续;
            } 否则 { }
            布尔 在裸块 = 在裸块区间(池, 裸块们, 整32(位置));
            如果 (在裸块) { 位置++; 继续; } 否则 { }
            布尔 有循环节点 = 循环节点们.大小() > 0;
            整64 循跳 = 0 - 1;
            如果 (有循环节点) {
                整64 循i = 0;
                当 (循i < 循环节点们.大小()) {
                    整64 循环索引 = 循环节点们.元素(整32(循i));
                    节点 循环节点 = 池.元素(整32(循环索引));
                    布尔 在前置段 = 位置 >= 整64(循环节点.文本) && 位置 < 循环索引;
                    如果 (在前置段) { 循跳 = 循环索引; } 否则 { }
                    循i++;
                }
            } 否则 { }
            布尔 有循跳 = 循跳 >= 0;
            如果 (有循跳) { 位置 = 循跳; 继续; } 否则 { }
            布尔 有遍历节点 = 遍历节点们.大小() > 0;
            整64 遍跳 = 0 - 1;
            如果 (有遍历节点) {
                整64 遍i = 0;
                当 (遍i < 遍历节点们.大小()) {
                    整64 遍历索引 = 遍历节点们.元素(整32(遍i));
                    节点 遍历节点q = 池.元素(整32(遍历索引));
                    布尔 在前置区 = 位置 >= 整64(遍历节点q.文本) && 位置 < 遍历索引;
                    如果 (在前置区) { 遍跳 = 遍历索引; } 否则 { }
                    遍i++;
                }
            } 否则 { }
            布尔 有遍跳 = 遍跳 >= 0;
            如果 (有遍跳) { 位置 = 遍跳; 继续; } 否则 { }
            布尔 是候选 = 位置 == 候选;
            如果 (是候选) { 命中 = 真; 中断; } 否则 { }
            // 裸块节点本身（位置==裸块索引）= 节点_块 —— 主遍历 生成块 递归其
            //   内部语句区间；模拟同口径递归（在裸块区间 只覆盖 < 块索引 的内部节点）。
            节点 当前节点 = 池.元素(整32(位置));
            布尔 是块节点 = 当前节点.类型 == 节点_块;
            如果 (是块节点) {
                布尔 块命中2 = 累积语句位750(池, 整64(当前节点.子起点),
                                             整64(当前节点.子终点), 候选);
                如果 (块命中2) { 命中 = 真; 中断; } 否则 { }
            } 否则 { }
            位置++;
        }
    } 否则 { }
    返回 命中;
}

// 候选扫描（判据②形态面·首个合格候选）：区间内 节点_赋值 目标标识符中
//   首个「右值根=二元加、左根=同一标识符、目标=拥有串局部」的赋值节点池索引。
//   0-1=无候选（判定 miss=不优化原路径·语义零变更）；输出目标名ID/左根位供
//   深扫描与改写比对复用。多变量同时累积=保守取首个（其余走原路径）。
函数 累积候选扫描750(向量<节点> 池, 整64 体起, 整64 体终,
             映射<整64, 整64>& 局部槽, 函数IR& 函数信息,
             整64& 候选名ID, 整64& 候选左根) -> 整64 {
    候选名ID = 0;
    候选左根 = 0 - 1;
    整64 候选 = 0 - 1;
    整64 p = 体起;
    当 (p < 体终) {
        节点 nd = 池.元素(整32(p));
        布尔 是赋值 = nd.类型 == 节点_赋值 && nd.文本 != 0;
        如果 (是赋值) {
            整64 名ID = 整64(nd.文本);
            整64 右起 = 整64(nd.子起点);
            整64 右终 = 整64(nd.子终点);
            布尔 右值非空 = 右起 < 右终;
            如果 (右值非空) {
                节点 右根 = 池.元素(整32(右终 - 1));
                布尔 是二元加 = 右根.类型 == 节点_二元运算 &&
                                字符串比较(驻留文本(整64(右根.文本)), "+");
                布尔 普通形态 = 右根.子终点 == 0 || 右根.子终点 == 1;
                整64 左根位 = 整64(右根.附加) - 1;
                布尔 左根在区间 = 左根位 >= 右起 && 左根位 < 右终 - 1;
                布尔 左根是目标 = 假;
                如果 (左根在区间) {
                    节点 左根 = 池.元素(整32(左根位));
                    左根是目标 = 左根.类型 == 节点_标识符 &&
                                 整64(左根.文本) == 名ID;
                } 否则 { }
                布尔 形态吻合 = 是二元加 && 普通形态 && 左根是目标;
                布尔 可提升 = 形态吻合 &&
                               累积目标可提升750(名ID, 局部槽, 函数信息);
                如果 (可提升) {
                    候选 = p;
                    候选名ID = 名ID;
                    候选左根 = 左根位;
                    中断;
                } 否则 { }
            } 否则 { }
        } 否则 { }
        p++;
    }
    返回 候选;
}

// 累积提升识别 + 前置发射（循环体生成前调用·三段头区间为空时起>=终 自然跳过）。
//   成功：已发射 new+append(初值) 并置上下文，返回 真（调用方在出口块调用
//   收尾累积750）；失败：零发射（未写任何 IR），调用方走原路径。
//   结构=单一出口布尔（各判据用布尔累积，无提前返回——判据 miss 方向安全：
//   不优化=原路径，语义零变更；无静默默认值语义面）。
不安全 函数 尝试累积提升750(向量<节点> 池, 整64 体块索引,
                     整64 头起, 整64 头终, 整64 条件起, 整64 条件终,
                     整64 步进起, 整64 步进终,
                     映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                     函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                     向量<整64>& 表达式栈) -> 布尔 {
    布尔 上下文空闲 = 累积赋值节点750 < 0;
    布尔 索引合法 = 体块索引 > 0 && 体块索引 < 整64(池.大小());
    布尔 成功 = 假;
    如果 (上下文空闲 && 索引合法) {
        节点 体块节点 = 池.元素(整32(体块索引));
        布尔 是块 = 体块节点.类型 == 节点_块;
        如果 (是块) {
            整64 体起q = 整64(体块节点.子起点);
            整64 体终q = 整64(体块节点.子终点);
            如果 (体起q < 体终q) {
                // P2（复审返工）：多候选与宿主同口径——某候选判据不满足即试下一
                //   候选（原 v2 只取首个=宿主尝试后续造成双编译覆盖面分叉）。
                整64 搜索起点 = 体起q;
                当 (搜索起点 < 体终q) {
                    整64 候选名ID = 0;
                    整64 候选左根 = 0 - 1;
                    整64 候选 = 累积候选扫描750(池, 搜索起点, 体终q, 局部槽,
                                               函数信息, 候选名ID, 候选左根);
                    布尔 有候选 = 候选 >= 0;
                    如果 (有候选) {
                        向量<整64> 标识符位们 = 向量<整64>();
                        向量<整64> 赋值位们 = 向量<整64>();
                        布尔 有返回 = 假;
                        布尔 有嵌套循环 = 假;
                        布尔 同名声明 = 假;
                        布尔 有lambda = 假;
                        扫描累积区间750(池, 体起q, 体终q, 候选名ID, 标识符位们,
                                        赋值位们, 有返回, 有嵌套循环, 同名声明,
                                        有lambda);
                        布尔 干净 = !有返回 && !有嵌套循环 && !同名声明 && !有lambda;
                        布尔 单赋值 = 赋值位们.大小() == 1 && 赋值位们.元素(0) == 候选;
                        布尔 单出现 = 标识符位们.大小() == 1 &&
                                      标识符位们.元素(0) == 候选左根;
                        布尔 语句位 = 累积语句位750(池, 体起q, 体终q, 候选);
                        布尔 头干净 = 累积头段干净750(池, 头起, 头终, 候选名ID) &&
                                      累积头段干净750(池, 条件起, 条件终, 候选名ID) &&
                                      累积头段干净750(池, 步进起, 步进终, 候选名ID);
                        布尔 全判据 = 干净 && 单赋值 && 单出现 && 语句位 && 头干净;
                        如果 (全判据) {
                            结果<整64, 整32> 查槽q = 局部槽.获取(候选名ID);
                            如果 (查槽q.正常) {
                                // ---- 通过：循环前 新建构建器 -> 追加初值 ----
                                整64 目标槽 = 查槽q.值;
                                向量<IR指令>& 指令 = 函数信息.指令;
                                整64 句柄 = 寄存器计数[0];
                                寄存器计数[0] = 寄存器计数[0] + 1;
                                IR追加(指令, 建IR指令(IR_调用参数化, 0, 0, 0, 句柄,
                                                     0, 驻留("__cn_strbuf_new")));
                                登记寄存器类型(句柄, T_整64);
                                整64 初值 = 寄存器计数[0];
                                寄存器计数[0] = 寄存器计数[0] + 1;
                                IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 初值,
                                                     T_字符串, 0));
                                发射连接链追加(句柄, 初值, 指令);
                                累积赋值节点750 = 候选;
                                累积目标ID750 = 候选名ID;
                                累积目标槽750 = 目标槽;
                                累积句柄750 = 句柄;
                                成功 = 真;
                            } 否则 { }
                        } 否则 { }
                        如果 (成功) { 搜索起点 = 体终q; } 否则 如果 (!成功) {
                            搜索起点 = 候选 + 1;
                        }
                    } 否则 如果 (!有候选) {
                        搜索起点 = 体终q;
                    }
                }
            } 否则 { }
        } 否则 { }
    } 否则 { }
    返回 成功;
}

// 累积赋值改写为段追加（生成赋值语句 入口调用·宿主 emitStringAccumAssign 同构）：
//   右值根=二元加 → 右操作数区间求值 → 数值转换 → append → 拥有临时结算
//   （749 连接链段辅助=同一判据单点）。
不安全 函数 累积追加发射750(向量<节点> 池, 节点 n,
                   映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                   函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                   向量<整64>& 表达式栈) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    // P2（复审返工·@1075 对称性）：右值生成前清 最近方法引用* 三枚（原路径
    //   生成标识符赋值 同点清零；累积路径绕过该入口须同口径，防上一语句残留
    //   被 1075 绑定方法值通道误消费）。
    最近方法引用符号 = 0;
    最近方法引用对象 = 0;
    最近方法引用返回码 = 0;
    整64 右终 = 整64(n.子终点) - 1;          // 二元节点池索引（右区间终点）
    节点 二元 = 池.元素(整32(右终));
    // 二元节点布局：附加=右操作数区间起点、子起点=左操作数区间起点（解析表达式中
    //   建节点 字段序〔文本, 附加, 子起点, 子终点〕）——右区间 = [附加, 二元索引)
    整64 右起 = 整64(二元.附加);
    整64 进入深度 = 表达式栈.大小();
    整64 段值 = 生成表达式(池, 整32(右起), 整32(右终), 局部槽, 参数槽,
                          指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
    表达式栈弹到深度(表达式栈, 进入深度);
    整64 段码 = 连接链段码(池, 段值, 右终);
    布尔 数值段 = 段码 != T_字符串;
    发射拼接数值转换(段值, 段码, 指令, 寄存器计数);
    发射连接链追加(累积句柄750, 段值, 指令);
    结算连接链段(池, 右终, 段值, 数值段, 指令, 寄存器计数, &函数信息.块计数);
}

// 循环出口块收尾（与 尝试累积提升750 成对）：finish 出串 -> free 旧值 -> 回写 s。
不安全 函数 收尾累积750(函数IR& 函数信息, 整64* 寄存器计数) -> 空类型 {
    布尔 有上下文 = 累积赋值节点750 >= 0;
    如果 (!有上下文) {
        // #648 内部错误显形（对齐宿主 finishStringAccum）：收尾仅在
        //   尝试累积提升750 成功后调用（生成循环/生成当 以布尔成对控制）——
        //   空上下文=编译期状态机缺陷，显形报告（IR 层错误计数中止产物）。
        IR层诊断("内部错误: 循环累积提升收尾时上下文为空（尝试/收尾不成对）");
    } 否则 { }
    如果 (有上下文) {
        向量<IR指令>& 指令 = 函数信息.指令;
        整64 出串 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_调用实参, 累积句柄750, 0, 0, 0, 0, 0));
        IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 出串, 0,
                             驻留("__cn_strbuf_finish")));
        登记寄存器类型(出串, T_字符串);
        整64 旧值 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_加载, 累积目标槽750, 0, 0, 旧值, T_字符串, 0));
        发射寄存器串释放(旧值, 指令);
        IR追加(指令, 建IR指令(IR_存储, 出串, 0, 0, 0, 0, 累积目标槽750));
        累积赋值节点750 = 0 - 1;
        累积目标ID750 = 0;
        累积目标槽750 = 0;
        累积句柄750 = 0;
    } 否则 { }
}
