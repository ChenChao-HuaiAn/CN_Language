// CN 自举编译器 v2 · IR 登记调用实参临时644（#1696 轮自 生成表达式求值.cn
//   机械搬移·该文件触 1000 冻结线「先拆再加」；纯搬移+方法调用分支零语义变化）
// 职责：644（2026-10-14·P1）实参位「返回字符串的调用」=无主拥有串临时——登记
//   结构体返回临时们 哨兵（值=-1），外层调用发射后 清理调用实参临时 收下句柄
//   （__cn_str_free 空安全幂等）。662 三元面/905 内置串返/644-d 容器元素/
//   1502 转移壳/1479 类面各分支随体。#1696 新增：方法调用（被调=节点_成员）
//   分支——判定单点=生成表达式运算辅助.方法调用串返617。
// 依赖经合并全局池（同包兄弟：查调用实参末位/决议函数符号/查函数返回类型/
//   解析标识符类型ID/拥有串临时形态/三元实参登记662/转移壳类名登记）；
//   显式导入仅限跨包模块。
导入 容器::向量;
导入 映射集合;
导入 协议常量;   // 节点_*/查调用实参末位 + 驻留/驻留文本（中立层）
导入 IR生成;     // 签名表/类表查询（同包幂等）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 实参位拥有临时登记（644/662/905/1479/1502 五族判定·生成调用 主链单点调用）。
不安全 函数 登记调用实参临时644(向量<节点> 池, 节点 n, 整32 位置,
                            向量<整64>& 弹出们, 整64 实参数,
                            整64 被调符号) -> 空类型 {
    // 644（2026-10-14·P1·宿主 genArgValueWithCleanup 同构）：实参位「返回
    //   字符串的调用」=无主拥有串临时——登记 结构体返回临时们 哨兵（值=-1），
    //   外层调用发射后 清理调用实参临时 收下句柄（__cn_str_free 空安全）。
    //   此前 81-a-v2 登记表只收结构体物化槽，纯串临时每调用净泄 1（探针⑩
    //   实锤双侧同漏·宿主同轮同修）。判定面=实参末节点是 节点_调用 且被调
    //   返回类型=字符串（决议函数符号 复用：调用索引=实参调用节点池索引，
    //   重载由语义决议同一套处理——宿主「resolvedSignature/裸名」两路回退
    //   同构）。与 102 甲案互洽：消耗形参已被调方入口深拷独立副本；非消耗
    //   形参=只读借用（临时生命周期至完整表达式尾，C++ full-expression 同规；
    //   被调方外存借用句柄=借用违约，非本释放面义务）。
    整64 实i644 = 0;
    当 (实i644 < 实参数) {
        整64 末位644 = 0;
        可选<整64> 末位644查 = 查调用实参末位(整64(位置), 实i644);
        // miss（原 -1 哨兵）与 0 同假——下方原 >0 判定逐字保留
        如果 (末位644查.有值) { 末位644 = 末位644查.值; }
        如果 (末位644 > 0 && 末位644 < 整64(池.大小())) {
            节点 末节点644 = 池.元素(整32(末位644));
            布尔 被调段合法x644 = 末节点644.类型 == 节点_调用 &&
                末节点644.子起点 > 0 &&
                整32(末节点644.子起点) < 整32(池.大小());
            如果 (被调段合法x644) {
                节点 被调644 = 池.元素(整32(末节点644.子起点));
                如果 (被调644.类型 == 节点_标识符) {
                    // 644-c（2026-10-16·821 云端红根治·宿主对齐）：登记判定
                    //   提取+补内置字符串族白名单——原实现只查用户签名表
                    //   （决议函数符号），内置 字符串复制/连接/拼接/子串/
                    //   大写/小写/修剪/反转 产物同=无主拥有串临时但 miss
                    //   不登记；644-b 构造器内 字段 = 形参 改深拷后（字段
                    //   独立副本）该临时成孤儿=每次类构造净泄 1（821 形态
                    //   分配数判据全灭铁证·宿主 genArgValueWithCleanup
                    //   resolvedType=字符串 对内置同登记=零分叉面）。白名单
                    //   与 发射成员串字段写入 同款（A2 契约同构）。
                    布尔 串返644 = 假;
                    整64 键基644 = 0; 整64 键串644 = 0; 整64 段数644 = 0;
                    整64 符号644 = 决议函数符号(池, 整64(被调644.文本),
                        整32(末位644), 键基644, 键串644, 段数644);
                    如果 (符号644 > 0 && 符号644 < 9007199254740992) {
                        可选<整64> 返型查644 = 查函数返回类型(符号644);
                        如果 (返型查644.有值) {
                            字符串 返名644 = 字符串复制(驻留文本(返型查644.值));
                            如果 (字符串比较(返名644, "字符串")) {
                                串返644 = 真;
                            }
                        }
                    }
                    如果 (!串返644) {
                        // 905（2026-10-18·644-c 判定面同族根治·宿主
                        //   genArgValueWithCleanup resolvedType=字符串 同构）：
                        //   内置返回字符串判定=权威表 内置函数返回类型ID（828-a
                        //   两级直查+归一基名·对齐宿主 semantic_builtins regXxxFn）
                        //   ——原 8 项硬编码漏 X转字符串族/格式化/构建器::完成/
                        //   IO::读取行/文件::读取文件行/时间::格式化时间
                        //   （905 探针：盒(0,整数转字符串(42)) v2 残留 1 vs 宿主 0）。
                        可选<整64> 内置返查644 = 内置函数返回类型ID(
                            字符串复制(驻留文本(整64(被调644.文本))));
                        布尔 内置返串644 = 假;
                        如果 (内置返查644.有值) {
                            内置返串644 = 内置返查644.值 == 驻留("字符串");
                        }
                        串返644 = 内置返串644;
                    }
                    // 644-d（2026-10-16·容器元素所有权族 11 例云端红根治·宿主
                    //   buildCallArgsForMethod 模型对齐）：**方法调用入容器位
                    //   实参排除登记**——被调=方法标记（负数）且本实参位=
                    //   入容器值位（追加/插入/设置/压入/入队/头部追加/添加·
                    //   入容器值实参下标）时，该串临时已被 74-a 入容器位归一化
                    //   **接管直存**（白名单拥有返回=容器收下句柄零拷贝·所有权
                    //   归容器）——哨兵登记会让 清理调用实参临时 在调用后
                    //   __cn_str_free 释放容器正持有的句柄=元素悬空/双释放
                    //   （探针 p11 铁证：追加(字符串复制) 后 元素(0) 读空）。
                    //   宿主同模型：入容器位走 normalizeContainerInsertArg
                    //   （不走 genArgValueWithCleanup 不登记不 flush）。
                    布尔 入容器位644 = 假;
                    如果 (串返644 && 被调符号 <= 0 - 1000000) {
                        整64 方法名ID644 = 0 - 被调符号 - 1000000;
                        字符串 方法名644 = 字符串复制(驻留文本(方法名ID644));
                        可选<整64> 值位查644 = 入容器值实参下标(方法名644);
                        如果 (值位查644.有值 && 值位查644.值 == 实i644) {
                            入容器位644 = 真;
                        }
                    }
                    如果 (串返644 && !入容器位644) {
                        整64 槽序644 = 实参数 - 1 - 实i644;
                        如果 (槽序644 >= 0 && 槽序644 < 弹出们.大小()) {
                            整64 寄存器644 = 弹出们.元素(槽序644);
                            结果<空类型, 整32> 设644 = 结构体返回临时们.设置(
                                寄存器644, 0 - 1);
                            如果 (!设644.正常) { 运行时错误(4); }
                        }
                    }
                    // 1502（966 姊妹·v2 面·宿主 genTransferClassArgWithCleanup966
                    //   同构）：转移(类源) 入容器位——源壳释放登记（句柄寄存
                    //   器→类名 ID·转移壳临时们）——追加调用发射后 清理调用
                    //   实参临时 消费（IR_删除对象 整壳析构·空安全）。转移展
                    //   开已清源槽（459-a 句柄交接）+容器元素=深拷独立拥有
                    //   （630）→深拷后源壳无人持有必须释放（v2 转移形态 泄
                    //   2/调用 vs 拷贝对照·1496 dual 返回 7 实录）。串返判定
                    //   对 转移 被调=决议 miss 不登记（零串扰·本分支平行）。
                    如果 (!串返644 && 整64(驻留("转移")) == 整64(被调644.文本)) {
                        整64 源位1502 = 整32(末节点644.子起点 + 1);
                        如果 (源位1502 < 整32(池.大小())) {
                            节点 转移源1502 = 池.元素(源位1502);
                            如果 (转移源1502.类型 == 节点_标识符) {
                                结果<整64, 整32> 查类1502 = 类变量类名查(
                                    整64(转移源1502.文本));
                                如果 (查类1502.正常) {
                                    整64 槽序1502 = 实参数 - 1 - 实i644;
                                    如果 (槽序1502 >= 0 && 槽序1502 < 弹出们.大小()) {
                                        转移壳类名登记(弹出们.元素(槽序1502),
                                                       查类1502.值);
                                    }
                                }
                            }
                        }
                    }
                }
            } 否则 如果 (池界内m644(末节点644.子起点, 池) &&
                         池.元素(整32(末节点644.子起点)).类型 == 节点_成员) {
                // #1696：方法调用串临时登记（判定+宿主 methodFace 修同构·
                //   判定单点=生成表达式运算辅助.方法调用串返617）
                如果 (方法调用串返617(池, 池.元素(整32(末节点644.子起点)))) {
                    整64 槽序m644 = 实参数 - 1 - 实i644;
                    如果 (槽序m644 >= 0 && 槽序m644 < 整64(弹出们.大小())) {
                        结果<空类型, 整32> 设m644 = 结构体返回临时们.设置(
                            弹出们.元素(槽序m644), 0 - 1);
                        如果 (!设m644.正常) { 运行时错误(4); }
                    }
                }
            } 否则 如果 (末节点644.类型 == 节点_三元运算) {
                // 662（617 三元面补全·644 传参位扩展·宿主 genArgValueWithCleanup
                //   662 分支同构）：三元实参「潜在拥有」——登记（寄存器+池位
                //   配对），外层调用发射后 清理调用实参临时 按寄存器倒序查、
                //   条件释放（选中字面量/标识符借用分支不得无条件 free）。
                //   两分支皆借用=不登记（无堆产物无需结算）。
                如果 (拥有串临时形态(池, 末节点644)) {
                    整64 槽序t644 = 实参数 - 1 - 实i644;
                    如果 (槽序t644 >= 0 && 槽序t644 < 弹出们.大小()) {
                        三元实参登记662(弹出们.元素(槽序t644), 末位644);
                    }
                }
            }
        }
        实i644++;
    }

}

// #1700 守卫辅助（闭集边界单点·分支词面收纳）——池索引双边界闭区间
函数 池界内m644(整32 索引, 向量<节点> 池) -> 布尔 {
    返回 索引 > 0 && 索引 < 整32(池.大小());
}
