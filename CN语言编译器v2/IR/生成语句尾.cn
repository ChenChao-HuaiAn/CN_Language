    登记当前函数变量类型(变量名ID, 所指ID);
    // 块结构（生成循环 同款）
    整64 条件块 = 新块(函数信息);
    整64 体块 = 新块(函数信息);
    整64 步进块 = 新块(函数信息);
    整64 出口块 = 新块(函数信息);
    发射跳转(函数信息, 条件块);
    // 条件块：i < N
    切换块(函数信息, 条件块);
    发射块标签(函数信息, 条件块);
    整64 索引读 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 索引槽, 0, 0, 索引读, T_整64, 0));
    整64 长度reg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数,
                         整64(驻留(整数转字符串(数组长))), 0, 0, 长度reg, T_整64, 0));
    整64 条件寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_小于, 索引读, 长度reg, 0, 条件寄存器, T_整64, 0));
    发射条件跳转(函数信息, 条件寄存器, 体块, 出口块);
    // 循环上下文（生成循环 同款：继续→步进/中断→出口+四基线+选择出口清 0）
    整64 旧出口 = 函数信息.循环出口块;
    整64 旧继续 = 函数信息.循环继续块;
    整64 旧选择出口L = 函数信息.选择出口块;
    整64 旧串基线 = 函数信息.循环串基线;
    整64 旧容基线 = 函数信息.循环容基线;
    整64 旧字基线 = 函数信息.循环字段基线;
    整64 旧数组串基线 = 函数信息.循环数组串基线;
    函数信息.循环出口块 = 出口块;
    函数信息.循环继续块 = 步进块;
    函数信息.选择出口块 = 0;
    函数信息.循环串基线 = 函数信息.字符串变量们.大小();
    函数信息.循环容基线 = 函数信息.容器变量们.大小();
    函数信息.循环字段基线 = 函数信息.资源字段局部们.大小();
    函数信息.循环数组串基线 = 函数信息.字符串数组变量们.大小();
    // 体块：元素读（对象+索引x宽 -> 指针加载 按宽码）-> 迭代变量槽 -> 生成块
    切换块(函数信息, 体块);
    发射块标签(函数信息, 体块);
    整64 索引读体 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 索引槽, 0, 0, 索引读体, T_整64, 0));
    整64 缩放值894 = 索引读体;
    如果 (元素宽 != 1) {
        整64 步进常量894 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_常量整数,
                             整64(驻留(整数转字符串(元素宽))), 0, 0,
                             步进常量894, T_整64, 0));
        整64 缩放寄存器894 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_乘, 索引读体, 步进常量894, 0,
                             缩放寄存器894, T_整64, 0));
        缩放值894 = 缩放寄存器894;
    }
    整64 元素地址894 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加, 对象值894, 缩放值894, 0, 元素地址894, T_整64, 0));
    如果 (元素结构体字节 > 0) {
        // 结构体元素：迭代变量槽组基址 + IR_结构体拷贝（元素地址 -> 槽组）
        // 913-a：取地址用基槽（登记槽913=最大槽号低地址·数据自基槽向上写
        //   落在槽组内——原首槽地址越组写穿相邻槽）
        整64 变量基址894 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_取地址, 登记槽913, 0, 0, 变量基址894, T_整64, 0));
        IR追加(指令, 建IR指令(IR_结构体拷贝, 元素地址894, 变量基址894, 0, 0,
                             元素结构体字节, 0));
    } 否则 {
        整64 元素值894 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_指针加载, 元素地址894, 0, 0, 元素值894, 元素宽码, 0));
        IR追加(指令, 建IR指令(IR_存储, 元素值894, 0, 0, 0, 0, 迭代变量槽));
    }
    布尔 体终止894 = 生成块(池, 整32(体块索引), 局部槽, 参数槽, 函数信息,
                           寄存器计数, 槽计数, 表达式栈, 返回类型码);
    函数信息.循环出口块 = 旧出口;
    函数信息.循环继续块 = 旧继续;
    函数信息.选择出口块 = 旧选择出口L;
    函数信息.循环串基线 = 旧串基线;
    函数信息.循环容基线 = 旧容基线;
    函数信息.循环字段基线 = 旧字基线;
    函数信息.循环数组串基线 = 旧数组串基线;
    如果 (!体终止894) {
        发射跳转(函数信息, 步进块);
    }
    // 步进块：i++（读+加 1+存回）-> 回条件
    切换块(函数信息, 步进块);
    发射块标签(函数信息, 步进块);
    整64 索引读步 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 索引槽, 0, 0, 索引读步, T_整64, 0));
    整64 常量一步 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("1")), 0, 0, 常量一步, T_整64, 0));
    整64 索引下一步 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加, 索引读步, 常量一步, 0, 索引下一步, T_整64, 0));
    IR追加(指令, 建IR指令(IR_存储, 索引下一步, 0, 0, 0, 0, 索引槽));
    发射跳转(函数信息, 条件块);
    // 出口块
    切换块(函数信息, 出口块);
    发射块标签(函数信息, 出口块);
    块清单出栈恢复(局部槽);   // 916-a：迭代变量作用域出栈（体块生成后）
}

不安全 函数 生成循环(向量<节点> 池, 节点 循环节点,
            映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
            函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
            向量<整64>& 表达式栈, 整64 返回类型码) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    整64 init起点 = 整64(循环节点.文本);
    整64 cond起点 = 整64(循环节点.子起点);
    整64 step起点 = 整64(循环节点.子终点);
    整64 体块索引 = 循环节点.附加;
    // step 段=[子终点, 体块节点.子起点)——解析块 的块节点在体子语句**之后**追加
    //   （体子语句 [S1, 块节点)·块节点@附加），故 step 终点须读块节点字段
    节点 体块节点 = 池.元素(整32(体块索引));
    整64 step终点 = 整64(体块节点.子起点);
    // 916-a（任务 085）：循环头声明作用域=整条循环语句（C++ for-init 同款）——
    //   init 段边界入栈，出口块生成后出栈恢复（原内联发射无边界：循环头同名
    //   声明遮蔽外层且循环退出后不恢复——外层 x=10 实跑=2·085 铁证）
    块清单入栈();
    // ① init 段（语句区间·内联发射——循环外执行一次）
    如果 (init起点 < cond起点) {
        布尔 init终止 = 生成语句(池, 整32(init起点), 整32(cond起点), 局部槽, 参数槽,
                                  函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
        如果 (init终止) {
            块清单出栈恢复(局部槽);
            返回;
        }
    }
    // 块序
    整64 条件块 = 新块(函数信息);
    整64 体块 = 新块(函数信息);
    整64 步进块 = 新块(函数信息);
    整64 出口块 = 新块(函数信息);
    发射跳转(函数信息, 条件块);
    // ② 条件块（cond 空=常量真）
    切换块(函数信息, 条件块);
    发射块标签(函数信息, 条件块);
    整64 条件寄存器 = 0;
    如果 (cond起点 < step起点) {
        条件寄存器 = 生成表达式(池, 整32(cond起点), 整32(step起点), 局部槽, 参数槽,
                                 指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
    } 否则 {
        条件寄存器 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("1")), 0, 0, 条件寄存器, T_整64, 0));
    }
    发射条件跳转(函数信息, 条件寄存器, 体块, 出口块);
    // 循环上下文（继续→步进块·中断→出口块·73-a 基线五枚）
    整64 旧出口 = 函数信息.循环出口块;
    整64 旧继续 = 函数信息.循环继续块;
    函数信息.循环出口块 = 出口块;
    函数信息.循环继续块 = 步进块;
    // 413-a（D44）：循环内中断绑定**最近**的选择或循环——循环体内在选择之后
    //   进入时暂存清 0 选择出口（恢复在体块生成后）=中断跳循环出口（C 语义）
    整64 旧选择出口L = 函数信息.选择出口块;
    函数信息.选择出口块 = 0;
    整64 旧串基线 = 函数信息.循环串基线;
    整64 旧容基线 = 函数信息.循环容基线;
    整64 旧字基线 = 函数信息.循环字段基线;
    整64 旧数组串基线 = 函数信息.循环数组串基线;
    函数信息.循环串基线 = 函数信息.字符串变量们.大小();
    函数信息.循环容基线 = 函数信息.容器变量们.大小();
    函数信息.循环字段基线 = 函数信息.资源字段局部们.大小();
    函数信息.循环数组串基线 = 函数信息.字符串数组变量们.大小();
    // ③ 体块
    切换块(函数信息, 体块);
    发射块标签(函数信息, 体块);
    布尔 体终止 = 生成块(池, 整32(体块索引), 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
    函数信息.循环出口块 = 旧出口;
    函数信息.循环继续块 = 旧继续;
    函数信息.选择出口块 = 旧选择出口L;
    函数信息.循环串基线 = 旧串基线;
    函数信息.循环容基线 = 旧容基线;
    函数信息.循环字段基线 = 旧字基线;
    函数信息.循环数组串基线 = 旧数组串基线;
    如果 (!体终止) {
        发射跳转(函数信息, 步进块);
    }
    // ④ 步进块（step 段执行后回条件——继续 语义目标=此处）
    切换块(函数信息, 步进块);
    发射块标签(函数信息, 步进块);
    如果 (step起点 < step终点) {
        生成语句(池, 整32(step起点), 整32(step终点), 局部槽, 参数槽,
                 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
    }
    发射跳转(函数信息, 条件块);
    // ⑤ 出口块
    切换块(函数信息, 出口块);
    发射块标签(函数信息, 出口块);
    // 916-a：循环头声明作用域出栈（出口块生成后——循环语句结束）
    块清单出栈恢复(局部槽);
}
