// CN 自举编译器 v2 · 方法值蹦床合成（943·绑定方法值赋值位合法化·
//   宿主 ir_lambda.cpp buildClosureTrampoline943 / ensureMethodValueTrap943 对称）
// 职责：为「对象.实例方法」作值合成蹦床函数（?mvtrap943_N$trap）——签名=方法
//   用户形参（无 this）；体=绑定对象指针静态槽 IR_静态加载（成员表达式位固化）
//   + IR_函数地址 方法符号 + IR_间接调用（位0=this·位1..=用户实参）+ 返回透传。
// 修复面（#943·用户质询收口）：方法值原发放裸方法符号（签名含隐藏 this 参数）
//   ——赋 fnptr 变量后经函数参数转发调用=丢绑定段错误 rc139（p82d 探针实录）；
//   蹦床自带绑定（对象指针随值经静态槽走），转发/拷贝/跨函数安全。与 lambda
//   蹦床通道（生成蹦床.cn 432）结构同构——宿主 buildLambdaTrampoline 单点化同款。
// 一等公民终态=plans/031（两槽方法值）——本文件为过渡期蹦床实现，届时退位。
// 加载序：居 生成蹦床 之后（复用 初始化函数信息字段/类型码/结构体大小族）。
导入 容器::向量;
导入 映射集合;
导入 IR;
导入 协议常量;
导入 IR生成;
导入 生成蹦床;
导入 生成函数;

公开:

// 943：待追加蹦床（成员表达式位登记 → IR生成/IR生成多文件 收尾统一追加
//   程序.函数们——静态槽回填与 .data 发射须见全量函数）。
向量<函数IR> 方法值蹦床们943;
静态 整64 方法值蹦床序号943 = 0;

// 943：静态槽键（写侧=成员表达式位固化·读侧=蹦床体内还原——单一归属）。
函数 方法值对象槽键943(整64 蹦床名ID) -> 字符串 {
    返回 "cap$" + 驻留文本(蹦床名ID) + "$绑定对象";
}

// 943：新蹦床名ID（?mvtrap943_<序号>·跨站点唯一）。
不安全 函数 新方法值蹦床名943() -> 整64 {
    字符串 名943 = "?mvtrap943_" + 整数转字符串(方法值蹦床序号943);
    方法值蹦床序号943 = 方法值蹦床序号943 + 1;
    返回 驻留(名943);
}

// 943：蹦床函数IR 合成（追加入 方法值蹦床们943；返回 名字 ID=IR_函数地址 附加键）。
//   参数串=方法形参类型串（查类方法参数串 同源）；返回类型ID=查类方法返回；
//   方法符号串=方法符号(类名,方法名,参数串)（链接键形·生成器符号修饰直通）；
//   对象槽序=站点静态槽序号（成员表达式位已 StorePtr 固化对象指针）。
不安全 函数 合成方法值蹦床943(字符串 参数串, 整64 返回类型ID, 字符串 方法符号串,
                             整64 蹦床名ID, 整64 对象槽序) -> 整64 {
    函数IR trap943;
    初始化函数信息字段(trap943);
    trap943.块计数 = 0;
    trap943.当前块 = 0;
    字符串 trap名943 = 字符串复制(驻留文本(蹦床名ID)) + "$trap";
    整64 trap名键943 = 驻留(trap名943);
    trap943.名字 = 整32(trap名键943);
    trap943.返回类型 = 类型码(返回类型ID);
    // sret 四形态判定（结构体/结果/128 位/数组——生成lambda蹦床432 逐条同构：
    //   蹦床自建被调 sret 面=槽 1 retbuf 指针保留+参数自槽 2 起+转发 retbuf）
    整64 返回字节943 = 0;
    字符串 返回名943 = 字符串复制(驻留文本(返回类型ID));
    如果 (查结构体大小(返回类型ID) != 0 && !是容器类(返回名943) &&
         !是用户类_ID(返回类型ID)) {
        返回字节943 = 查结构体大小(返回类型ID);
        trap943.返回结构体ID = 返回类型ID;
    } 否则 如果 (是结果类型(返回名943)) {
        返回字节943 = 结果大小(返回名943);
        trap943.返回结果名ID = 返回类型ID;
    } 否则 如果 (字符串比较(返回名943, "整128")) {
        返回字节943 = 16;
        trap943.返回128位 = 1;
    } 否则 如果 (字符串比较(返回名943, "正128")) {
        返回字节943 = 16;
        trap943.返回128位 = 2;
    } 否则 如果 (是数组类型文本(返回名943)) {
        返回字节943 = 类型名宽度(返回类型ID);
        trap943.返回数组字节 = 返回字节943;
    }
    整64 槽序943 = 1;
    如果 (返回字节943 != 0) {
        trap943.retbuf字节数 = 返回字节943;
        // retbuf 区起点占位（sret rcx 存槽=槽 1——生成函数 各 sret 形态同协议）
        IR追加(trap943.指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 1));
        槽序943 = 2;
    }
    // 形参段：参数串逐段登记（标量单槽直存；128 位双槽 16 字节传址；
    //   结构体按值多槽传址——生成lambda蹦床432 参数段逐条同构）
    整64 段数943 = 参数串段数(参数串);
    整64 段943 = 0;
    当 (段943 < 段数943) {
        字符串 段文本943 = 取参数段(参数串, 段943);
        整64 参名ID943 = 驻留(段文本943);
        整64 参码943 = 类型码(参名ID943);
        整64 参槽数943 = 1;
        整64 参拷贝943 = 0;
        如果 (参码943 == T_整128 || 参码943 == T_正128) {
            参槽数943 = 2;
            参拷贝943 = 16;
        } 否则 如果 (查结构体大小(参名ID943) != 0 && !是容器类(段文本943) &&
                     !是用户类_ID(参名ID943)) {
            参拷贝943 = 查结构体大小(参名ID943);
            参槽数943 = (参拷贝943 + 7) / 8;
            参码943 = T_整64;
        }
        整64 基槽943 = 槽序943 + 参槽数943 - 1;
        结果<空类型, 整32> 加槽序943 = trap943.参数槽序们.追加(基槽943);
        如果 (!加槽序943.正常) { 运行时错误(4); }
        结果<空类型, 整32> 加拷贝943 = trap943.参数拷贝字节们.追加(参拷贝943);
        如果 (!加拷贝943.正常) { 运行时错误(4); }
        结果<空类型, 整32> 加类型943 = trap943.参数类型们.追加(参码943);
        如果 (!加类型943.正常) { 运行时错误(4); }
        槽序943 = 槽序943 + 参槽数943;
        段943++;
    }
    // 指令体：this（位=位偏）→ 用户实参（位=位偏+1..）
    整64 位偏943 = 0;
    如果 (返回字节943 != 0) { 位偏943 = 1; }
    整64 寄存器943 = 1;
    整64 this寄存器943 = 寄存器943;
    寄存器943++;
    IR追加(trap943.指令, 建IR指令(IR_静态加载, 0, 0, 0, this寄存器943, T_整64,
                                  对象槽序));
    IR追加(trap943.指令, 建IR指令(IR_调用实参, this寄存器943, T_整64, 0, 0,
                                  位偏943, 0));
    段943 = 0;
    当 (段943 < 段数943) {
        整64 码b943 = trap943.参数类型们.元素(整32(段943));
        整64 拷b943 = trap943.参数拷贝字节们.元素(整32(段943));
        整64 槽b943 = trap943.参数槽序们.元素(整32(段943));
        整64 读943 = 寄存器943;
        寄存器943++;
        如果 (拷b943 != 0) {
            IR追加(trap943.指令, 建IR指令(IR_取地址, 槽b943, 0, 0, 读943, T_整64, 0));
            IR追加(trap943.指令, 建IR指令(IR_调用实参, 读943, T_整64, 0, 0,
                                          位偏943 + 1 + 段943, 0));
        }
        如果 (拷b943 == 0) {
            IR追加(trap943.指令, 建IR指令(IR_加载, 槽b943, 0, 0, 读943, 码b943, 0));
            IR追加(trap943.指令, 建IR指令(IR_调用实参, 读943, 码b943, 0, 0,
                                          位偏943 + 1 + 段943, 0));
        }
        段943++;
    }
    整64 被调943 = 寄存器943;
    寄存器943++;
    IR追加(trap943.指令, 建IR指令(IR_函数地址, 0, 0, 0, 被调943, T_整64,
                                  驻留(方法符号串)));
    整64 返回寄存器943 = 寄存器943;
    寄存器943++;
    整64 参数总数943 = 位偏943 + 1 + 段数943;
    如果 (返回字节943 != 0) {
        IR追加(trap943.指令, 建IR指令(IR_间接调用, 参数总数943, 0, 0,
                                      返回寄存器943, 1, 被调943));
        整64 调方buf943 = 寄存器943;
        寄存器943++;
        IR追加(trap943.指令, 建IR指令(IR_加载, 1, 0, 0, 调方buf943, T_整64, 0));
        IR追加(trap943.指令, 建IR指令(IR_结构体拷贝, 返回寄存器943, 调方buf943,
                                      0, 0, 返回字节943, 0));
        IR追加(trap943.指令, 建IR指令(IR_返回, 调方buf943, 0, 0, 0, 0, 0));
    }
    如果 (返回字节943 == 0) {
        IR追加(trap943.指令, 建IR指令(IR_间接调用, 参数总数943, trap943.返回类型,
                                      0, 返回寄存器943, 0, 被调943));
        如果 (trap943.返回类型 != T_未知 && trap943.返回类型 != T_空类型) {
            登记寄存器类型(返回寄存器943, trap943.返回类型);
            IR追加(trap943.指令, 建IR指令(IR_返回, 返回寄存器943, 0, 0, 0, 0, 0));
        }
        如果 (trap943.返回类型 == T_未知 || trap943.返回类型 == T_空类型) {
            IR追加(trap943.指令, 建IR指令(IR_返回, 0, 0, 0, 0, 0, 0));
        }
    }
    结果<空类型, 整32> 加待943 = 方法值蹦床们943.追加(trap943);
    如果 (!加待943.正常) { 运行时错误(4); }
    返回 trap名键943;
}

// 943：待追加蹦床统一入列（IR生成/IR生成多文件 收尾调用——静态数回填前）。
不安全 函数 追加方法值蹦床们943(向量<函数IR>& 函数们) -> 空类型 {
    整64 i943 = 0;
    当 (i943 < 方法值蹦床们943.大小()) {
        函数IR trap挤943 = 方法值蹦床们943.元素(整32(i943));
        如果 (trap挤943.名字 != 0) {
            结果<空类型, 整32> 加入943 = 函数们.追加(trap挤943);
            如果 (!加入943.正常) { 运行时错误(4); }
        }
        i943++;
    }
}
