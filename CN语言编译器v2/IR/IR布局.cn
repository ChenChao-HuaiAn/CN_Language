// CN 自举编译器 v2 · IR 布局（千行拆分子模块，2026-09-08 用户裁决阶段目录包）
// 职责：结构体布局表族（大小/对齐/字段类型/字段偏移/三级布局查询）+ 容器
导入 容器::向量;
导入 映射集合;
导入 IR;         // IR指令/签名辅助/节点_* 常量（原 IR签名+IR常量，目录包名）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// ==================== 键基合成（plans/018 第 3/4 层链接符号公式） ====================
// 宿主 SemanticAnalyzer::functionLinkKey（semantic.cpp:564）CN 侧同源实现：
函数 是主模块路径(字符串 模块路径) -> 布尔 {
    返回 字符串长度(模块路径) == 0 || 字符串比较(模块路径, "主");
}

函数 键基合成(字符串 模块路径, 整64 名ID) -> 整64 {
    如果 (是主模块路径(模块路径)) { 返回 名ID; }
    返回 驻留(模块路径 + "$" + 驻留文本(名ID));
}

// 标准库模块名判定（主.cn 是标准库模块/语义分析 同源三副本——stdlib 符号不在
//   v2 加载树/成员索引：三级解析天然 miss、② 绑定不登记（语法层 B1 已改写
//   限定名走内置表）、③ 不参与歧义。三处副本须同步维护）
静态 映射<整64, 整32> 外部函数名们957;

函数 登记外部函数名957(整64 名ID) -> 空类型 {
    结果<空类型, 整32> 设957 = 外部函数名们957.设置(名ID, 1);
    如果 (!设957.正常) { 运行时错误(4); }
}

函数 是外部函数名957(整64 名ID) -> 布尔 {
    结果<整32, 整32> 查957 = 外部函数名们957.获取(名ID);
    返回 查957.正常;
}

函数 清空外部函数名们957() -> 空类型 {
    外部函数名们957.清空();
}

静态 映射<整64, 整32> 用户模块名们954;

函数 登记用户模块名954(字符串 名) -> 空类型 {
    结果<空类型, 整32> 设954 = 用户模块名们954.设置(驻留(名), 1);
    如果 (!设954.正常) { 运行时错误(4); }
}

函数 是用户模块名954(字符串 名) -> 布尔 {
    结果<整32, 整32> 查954 = 用户模块名们954.获取(驻留(名));
    返回 查954.正常;
}

函数 清空用户模块名们954() -> 空类型 {
    用户模块名们954.清空();
}

函数 是标准库模块名(字符串 名) -> 布尔 {
    返回 字符串比较(名, "容器") || 字符串比较(名, "映射集合") ||
          字符串比较(名, "文件") || 字符串比较(名, "IO") ||
          字符串比较(名, "字符串扩展") || 字符串比较(名, "核心") ||
          字符串比较(名, "数学") || 字符串比较(名, "时间") ||
          字符串比较(名, "算法") || 字符串比较(名, "系统") ||
          字符串比较(名, "字符串构建器") ||   // 872（074 波2）
          字符串比较(名, "线程");   // 1011（996 线程库·586）：线程:: 限定名
}

// 828-a（002 攻族轮·G-F+G-G 内置族）：stdlib 限定名归一化单一归属——裸名改写
//   产物（`导入 IO::打印;` → 裸名 打印 被改写为 "IO::打印"·解析基础.cn B1 登记/
函数 内置归一基名(字符串 名) -> 字符串 {
    字符串 归模s = "";
    字符串 归符s = "";
    如果 (拆限定名(名, 归模s, 归符s) == 1 && 是标准库模块名(归模s)) {
        返回 归符s;
    }
    返回 字符串复制(名);   // 019 拥有契约：返回参数须显式落堆
}

// ==================== 当前模块路径（plans/018 类型/常量布局分桶，2026-09-08） ====================
// 布局/常量登记与查询的模块窗口状态（文件粒度）：语法解析期由 主.cn 编译文件
静态 字符串 当前模块路径 = "主";

不安全 函数 设当前模块路径(字符串 路径) -> 空类型 {
    当前模块路径 = 路径;
}

函数 取当前模块路径() -> 字符串 {
    返回 字符串复制(当前模块路径);
}

// 拆限定名："m::x" -> 模块路径 m + 符号名 x（多段 a::b::c -> a::b + c，宿主
//   尾段绑定语义）；无 "::" 返回 0（出参不动），有返回 1。
函数 拆限定名(字符串 限定名, 字符串& 模块路径, 字符串& 符号名) -> 整64 {
    整64 长 = 字符串长度(限定名);
    整64 尾 = -1;
    整64 i = 0;
    当 (i + 1 < 长) {
        如果 (字符串比较(字符串子串(限定名, 整32(i), 2), "::")) { 尾 = i; }
        i++;
    }
    如果 (尾 < 0) { 返回 0; }
    模块路径 = 字符串子串(限定名, 0, 整32(尾));
    符号名 = 字符串子串(限定名, 整32(尾 + 2), 整32(长 - 尾 - 2));
    返回 1;
}

// ==================== 结构体布局表（②b B1，2026-09-02） ====================
// 语法分析 解析结构体声明 登记（字段按真实大小+自然对齐，对齐宿主 typeSizeOf）；
静态 映射<整64, 整64> 结构体大小表;
静态 映射<整64, 整64> 结构体对齐表;
静态 映射<整64, 整64> 字段类型表;

// 类型大小/对齐（对齐宿主 typeSizeOf；容器 $ 合成名按对象大小表——②c A/B：
//   嵌套容器与容器字段布局精确化，消灭 8/8 兜底；结构体递归查表——须先声明后
//   使用，多文件依赖先解析保证；未知类型防御 8/8）
不安全 函数 类型大小与对齐(字符串 类型文本, 整64* 大小, 整64* 对齐) -> 空类型 {
    大小[0] = 8;
    对齐[0] = 8;
    // 94-a：数组类型——总大小=元素大小×长度（宿主 typeSizeOf 数组分支同构，
    //   规格 02-五「类型[长度]」C 布局语义），对齐=元素对齐（宿主 typeAlignOf
    //   数组=元素对齐）；元素可为结构体/容器/用户类（递归经本函数单点求大小）
    如果 (是数组类型文本(类型文本)) {
        整64 长度a = 数组长度文本(类型文本);
        字符串 元素文本a = 数组元素文本(类型文本);
        如果 (长度a > 0 && 字符串长度(元素文本a) > 0) {
            整64 元素大小a = 0;
            整64 元素对齐a = 0;
            类型大小与对齐(元素文本a, &元素大小a, &元素对齐a);
            大小[0] = 元素大小a * 长度a;
            对齐[0] = 元素对齐a;
        }
        返回;
    }
    如果 (字符串比较(类型文本, "布尔") ||
        字符串比较(类型文本, "整8") || 字符串比较(类型文本, "正8")) {
        大小[0] = 1;
        对齐[0] = 1;
        返回;
    }
    如果 (字符串比较(类型文本, "整16") || 字符串比较(类型文本, "正16")) {
        大小[0] = 2;
        对齐[0] = 2;
        返回;
    }
    // 979（002·306·95-a 立法）：字符=4 字节/4 对齐（001 类型表·宿主
    //   typeSizeOf/typeAlignOf 同档）——结构体字段偏移/数组步进/容器元素
    //   布局随本表；字符串 UTF-8 字节口径访问走 T_字节(13) 通道不受影响。
    如果 (字符串比较(类型文本, "整32") || 字符串比较(类型文本, "正32") ||
        字符串比较(类型文本, "字符")) {
        大小[0] = 4;
        对齐[0] = 4;
        返回;
    }
    // 263④（021 任务 263·2026-10-07 深度机·探针 646 实证）：128 位标量=16 字节/
    //   16 对齐（宿主 typeSizeOf(int128)=16/alignof=16 同档·〔基准=019〕128 位
    如果 (字符串比较(类型文本, "整128") || 字符串比较(类型文本, "正128")) {
        大小[0] = 16;
        对齐[0] = 16;
        返回;
    }
    // ②c B：容器 $ 合成名——字段区按容器对象大小保留（指针槽模型：首 8 字节存
    //   堆对象指针，与宿主 typeSizeOf(容器) 布局对齐）
    如果 (是容器类(类型文本)) {
        大小[0] = 容器对象大小(类型文本);
        对齐[0] = 8;
        返回;
    }
    // 1011（537·合成体宽度单点）：结果/可选类合成名——大小=结果大小（可选<
    //   整32>=8·结果<整32,整32>=16），原落兜底 8：下标整体写 `组[0] = 正常(5)`
    如果 (是结果类型(类型文本)) {
        大小[0] = 结果大小(类型文本);
        对齐[0] = 8;
        返回;
    }
    // 279（021 任务 279·#263 遗留缺口·09 实测）：枚举类型=4/4（宿主
    //   enum=int 同款·C 枚举布局）——原落兜底 8/8 与 T3 拒绝面双重分叉。
    如果 (是枚举名(驻留(类型文本))) {
        大小[0] = 4;
        对齐[0] = 4;
        返回;
    }
    // 整64/正64/字符串/指针：8/8；结构体递归查表（plans/018 类型分桶：三级
    //   解析——解析期字段类型推导的当前模块路径=本模块，键基/限定文本/纯名通吃）
    整64 键基s = 结构体布局键基(驻留(类型文本));
    如果 (键基s != 0) {
        结果<整64, 整32> 查大小 = 结构体大小表.获取(键基s);
        如果 (查大小.正常) {
            大小[0] = 查大小.值;
            结果<整64, 整32> 查对齐 = 结构体对齐表.获取(键基s);
            如果 (查对齐.正常) { 对齐[0] = 查对齐.值; }
        }
    }
}

// 登记结构体布局（大小/对齐）——语法分析 解析结构体声明 尾部调用。
// plans/018 类型分桶（2026-09-08）：键由纯名升级为键基（键基合成(当前模块路径,
静态 映射<整64, 整64> 结构体候选键基们;   // 名ID*键位移+序 -> 键基ID
静态 映射<整64, 整64> 结构体候选公开们;   // 名ID*键位移+序 -> 0/1
静态 映射<整64, 整64> 结构体候选数们;     // 名ID -> 候选数

函数 登记结构体布局(整64 结构体名ID, 整64 大小, 整64 对齐, 整64 是否公开) -> 空类型 {
    整64 键基 = 键基合成(取当前模块路径(), 结构体名ID);
    结果<空类型, 整32> 加大小 = 结构体大小表.设置(键基, 大小);
    如果 (!加大小.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加对齐 = 结构体对齐表.设置(键基, 对齐);
    如果 (!加对齐.正常) { 运行时错误(4); }
    整64 序 = 0;
    结果<整64, 整32> 查数 = 结构体候选数们.获取(结构体名ID);
    如果 (查数.正常) { 序 = 查数.值; }
    结果<空类型, 整32> 加键 = 结构体候选键基们.设置(结构体名ID * 键位移 + 序, 键基);
    如果 (!加键.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加公开 = 结构体候选公开们.设置(结构体名ID * 键位移 + 序, 是否公开);
    如果 (!加公开.正常) { 运行时错误(4); }
    结果<空类型, 整32> 设数 = 结构体候选数们.设置(结构体名ID, 序 + 1);
    如果 (!设数.正常) { 运行时错误(4); }
}

// 结构体布局键基三级解析（类型分桶查询统一入口——plans/018 第 4 层收口）：
//   限定文本（"甲::记录"）拆分直查；纯名 ① 本模块键基（当前模块路径 合成，
函数 结构体布局键基(整64 类型名ID) -> 整64 {
    字符串 文本t = 字符串复制(驻留文本(类型名ID));
    字符串 模块t = "";
    字符串 符号t = "";
    如果 (拆限定名(文本t, 模块t, 符号t) == 1) {
        如果 (是标准库模块名(模块t)) { 返回 0; }
        整64 键基x = 键基合成(模块t, 驻留(符号t));
        结果<整64, 整32> 查x = 结构体大小表.获取(键基x);
        如果 (查x.正常) { 返回 键基x; }
        返回 0;
    }
    整64 键基1 = 键基合成(取当前模块路径(), 类型名ID);
    结果<整64, 整32> 查1 = 结构体大小表.获取(键基1);
    如果 (查1.正常) { 返回 键基1; }
    结果<整64, 整32> 查2 = 结构体大小表.获取(类型名ID);
    如果 (查2.正常) {
    }
    如果 (查2.正常) {
        如果 (是主模块路径(取当前模块路径())) { 返回 类型名ID; }
        // 候选名域判定：键基形态的ID（幂等直查）不在候选表——直通；纯名形态
        //   （主模块成员跨模块引用）公开设防——主模块私有成员不可见，落 ③
        整64 数m = 0;
        结果<整64, 整32> 查数m = 结构体候选数们.获取(类型名ID);
        如果 (查数m.正常) { 数m = 查数m.值; }
        如果 (数m == 0) { 返回 类型名ID; }
        结果<整64, 整32> 查公 = 结构体候选公开们.获取(类型名ID * 键位移 + 0);
        如果 (查公.正常) {
            如果 (查公.值 == 1) { 返回 类型名ID; }
        }
    }
    整64 数n = 0;
    结果<整64, 整32> 查数n = 结构体候选数们.获取(类型名ID);
    如果 (查数n.正常) { 数n = 查数n.值; }
    整64 首公开 = 0;
    整64 i = 0;
    当 (i < 数n) {
        整64 候选键 = 类型名ID * 键位移 + i;
        结果<整64, 整32> 查键c = 结构体候选键基们.获取(候选键);
        如果 (查键c.正常) {
            结果<整64, 整32> 查公c = 结构体候选公开们.获取(候选键);
            如果 (查公c.正常) {
                如果 (查公c.值 == 1) {
                    如果 (首公开 == 0) { 首公开 = 查键c.值; }
                }
            }
        }
        i++;
    }
    返回 首公开;
}

// 321（v16 a1/b2/w4 asm 铁证·2026-10-09）：字段类型星号规范化——类型节点
//   附加=指针层 1..255 时文本补 '*'（435-b 类字段同构）——字段类型表存真
//   类型（原剥星→46a 载荷判定/成员值码/解析成员链 下游看到所指结构体 →
//   指针字段被误判「结构体载荷」压地址不取值 → p = p.下一个 存地址非存
//   值·链表 v2 全断）。非指针层（附加 0）原样。
函数 字段类型星号规范化(节点 类型节点值) -> 整64 {
    如果 (类型节点值.附加 >= 1 && 类型节点值.附加 <= 255) {
        字符串 星串321 = "";
        整64 星i321 = 0;
        当 (星i321 < 类型节点值.附加) {
            星串321 = 字符串复制(星串321 + "*");
            星i321 = 星i321 + 1;
        }
        返回 整64(驻留(字符串复制(驻留文本(整64(类型节点值.文本))) + 星串321));
    }
    返回 整64(类型节点值.文本);
}

// 登记字段类型（分桶键=结构体名ID*键位移+字段名ID，由语法分析计算）——B4 用
函数 登记字段类型(整64 分桶键, 整64 字段类型名ID) -> 空类型 {
    结果<空类型, 整32> 加 = 字段类型表.设置(分桶键, 字段类型名ID);
    如果 (!加.正常) { 运行时错误(4); }

}

// ==================== T3 结构体字段引用未登记收集（311-a=306-b 波次2 v2 侧·2026-09-17） ====================
// 「先声明后使用」违规与值字段递归环（直接 甲{甲} / 间接 甲↔乙 / 三元环）的
静态 向量<整64> 未登记引用引用者们;   // 引用者结构体名ID
静态 向量<整64> 未登记引用被引们;     // 被引用字段类型名ID

不安全 函数 收集未登记引用(整64 引用者名ID, 整64 被引用类型名ID) -> 空类型 {
    结果<空类型, 整32> 加a = 未登记引用引用者们.追加(引用者名ID);
    如果 (!加a.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加b = 未登记引用被引们.追加(被引用类型名ID);
    如果 (!加b.正常) { 运行时错误(4); }
}

函数 未登记引用数() -> 整64 {
    返回 未登记引用引用者们.大小();
}

// T3 收尾判定（主.cn 全解析后调用）：返回诊断行数（>0=须中止）。
//   被引用名收尾时查结构体大小 ≠0 =「先声明后使用」违规（含递归环——环成员
//   必登记）；==0 =未知类型（原静默 8 兜底错值面顺带根治）。
不安全 函数 检查未登记引用() -> 整64 {
    整64 n = 未登记引用引用者们.大小();
    整64 i = 0;
    整64 诊断数 = 0;
    当 (i < n) {
        整64 引用者名 = 未登记引用引用者们.元素(整32(i));
        整64 被引名 = 未登记引用被引们.元素(整32(i));
        整64 被引大小 = 查结构体大小(被引名);
        如果 (被引大小 != 0) {
            // 前向引用：递归环或声明序违规——对齐宿主 T3 拒绝语义
            IO::打印到错误("[布局] 结构体 '" + 字符串复制(驻留文本(引用者名)) +
                "' 的字段引用了后声明的结构体 '" + 字符串复制(驻留文本(被引名)) +
                "'（先声明后使用违规或值字段递归=无穷大小类型）——请调整声明顺序，" +
                "或将递归字段改为指针（T3）");
            诊断数++;
        } 否则 {
            IO::打印到错误("[布局] 结构体 '" + 字符串复制(驻留文本(引用者名)) +
                "' 的字段类型 '" + 字符串复制(驻留文本(被引名)) +
                "' 未知（未声明的类型）——原静默 8 字节兜底已废除（T3）");
            诊断数++;
        }
        i++;
    }
    返回 诊断数;
}

不安全 函数 清空未登记引用() -> 空类型 {
    未登记引用引用者们.清空();
    未登记引用被引们.清空();
}


