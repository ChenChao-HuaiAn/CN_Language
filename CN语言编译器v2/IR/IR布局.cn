// CN 自举编译器 v2 · IR 布局（千行拆分子模块，2026-09-08 用户裁决阶段目录包）
// 职责：结构体布局表族（大小/对齐/字段类型/字段偏移/三级布局查询）+ 容器
//   字段表 + 顶层常量收集与三级查询——自 IR容器.cn 机械搬移；链接键基础
//   （键基合成/拆限定名/当前模块路径）经 公开: 函数访问 IR容器 主干；
//   模块路径=IR布局（新键基）。
导入 容器::向量;
导入 映射集合;
导入 IR;         // IR指令/签名辅助/节点_* 常量（原 IR签名+IR常量，目录包名）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// ==================== 键基合成（plans/018 第 3/4 层链接符号公式） ====================
// 宿主 SemanticAnalyzer::functionLinkKey（semantic.cpp:564）CN 侧同源实现：
//   键基(模块路径, 名) = (模块路径 为 主/空) ? 名 : 模块路径 + "$" + 名。
//   链接键 = 函数签名键(键基, 参数串) = 键基 或 键基#参数串——定义侧
//   （生成函数 函数IR.名字）与调用侧（决议函数符号 产物）共用本公式，
//   公式唯一归属（宿主 A′ 裁决同构：注册/定义/调用三处同源，无顺序依赖）。
// 主模块判定：模块路径 空串 或 "主"（入口文件；宿主同款豁免两形态）。
函数 是主模块路径(字符串 模块路径) -> 布尔 {
    返回 字符串长度(模块路径) == 0 || 字符串比较(模块路径, "主");
}

函数 键基合成(字符串 模块路径, 整64 名ID) -> 整64 {
    如果 (是主模块路径(模块路径)) { 返回 名ID; }
    返回 驻留(模块路径 + "$" + 驻留文本(名ID));
}

// 标准库模块名判定（主.cn 是标准库模块/语义分析 同源三副本——stdlib 符号不在
//   v2 加载树/成员索引：三级解析天然 miss、② 绑定不登记（语法层 B1 已改写
//   限定名走内置表）、③ 不参与歧义。三处副本须同步维护）
函数 是标准库模块名(字符串 名) -> 布尔 {
    返回 字符串比较(名, "容器") || 字符串比较(名, "映射集合") ||
          字符串比较(名, "文件") || 字符串比较(名, "IO") ||
          字符串比较(名, "字符串扩展") || 字符串比较(名, "核心") ||
          字符串比较(名, "数学") || 字符串比较(名, "时间") ||
          字符串比较(名, "算法") || 字符串比较(名, "系统");
}

// ==================== 当前模块路径（plans/018 类型/常量布局分桶，2026-09-08） ====================
// 布局/常量登记与查询的模块窗口状态（文件粒度）：语法解析期由 主.cn 编译文件
//   每文件 解析程序 前设置（依赖先解析=递归返回后父文件重设，无窗口交错）；
//   IR 生成期由 生成函数 开头设置（原 IR生成 本地静态 当前IR模块路径 统一归入
//   本处——单一归属，防双静态漂移）；自检/回退链复位 "主"（单文件形态）。
//   布局表键=键基（模块$名）的登记与三级查询全链读本状态。
静态 字符串 当前模块路径 = "主";

不安全 函数 设当前模块路径(字符串 路径) -> 空类型 {
    当前模块路径 = 路径;
}

函数 取当前模块路径() -> 字符串 {
    返回 字符串复制(当前模块路径);
}

// 拆限定名："m::x" -> 模块路径 m + 符号名 x（多段 a::b::c -> a::b + c，宿主
//   尾段绑定语义）；无 "::" 返回 0（出参不动），有返回 1。
函数 拆限定名(字符串 限定名, 字符串& 模块路径, 字符串& 符号名) -> 整64 {
    整64 长 = 字符串长度(限定名);
    整64 尾 = -1;
    整64 i = 0;
    当 (i + 1 < 长) {
        如果 (字符串比较(字符串子串(限定名, 整32(i), 2), "::")) { 尾 = i; }
        i++;
    }
    如果 (尾 < 0) { 返回 0; }
    模块路径 = 字符串子串(限定名, 0, 整32(尾));
    符号名 = 字符串子串(限定名, 整32(尾 + 2), 整32(长 - 尾 - 2));
    返回 1;
}

// ==================== 结构体布局表（②b B1，2026-09-02） ====================
// 语法分析 解析结构体声明 登记（字段按真实大小+自然对齐，对齐宿主 typeSizeOf）；
//   表置 IR容器 避免 语法分析->IR容器->语法分析 导入环。IR生成 查询：结构体局部
//   多槽/元素步长/拷贝大小/实参传地址判定/返回形态分类。
静态 映射<整64, 整64> 结构体大小表;
静态 映射<整64, 整64> 结构体对齐表;
静态 映射<整64, 整64> 字段类型表;

// 类型大小/对齐（对齐宿主 typeSizeOf；容器 $ 合成名按对象大小表——②c A/B：
//   嵌套容器与容器字段布局精确化，消灭 8/8 兜底；结构体递归查表——须先声明后
//   使用，多文件依赖先解析保证；未知类型防御 8/8）
不安全 函数 类型大小与对齐(字符串 类型文本, 整64* 大小, 整64* 对齐) -> 空类型 {
    大小[0] = 8;
    对齐[0] = 8;
    // 94-a：数组类型——总大小=元素大小×长度（宿主 typeSizeOf 数组分支同构，
    //   规格 02-五「类型[长度]」C 布局语义），对齐=元素对齐（宿主 typeAlignOf
    //   数组=元素对齐）；元素可为结构体/容器/用户类（递归经本函数单点求大小）
    如果 (是数组类型文本(类型文本)) {
        整64 长度a = 数组长度文本(类型文本);
        字符串 元素文本a = 数组元素文本(类型文本);
        如果 (长度a > 0 && 字符串长度(元素文本a) > 0) {
            整64 元素大小a = 0;
            整64 元素对齐a = 0;
            类型大小与对齐(元素文本a, &元素大小a, &元素对齐a);
            大小[0] = 元素大小a * 长度a;
            对齐[0] = 元素对齐a;
        }
        返回;
    }
    如果 (字符串比较(类型文本, "布尔") || 字符串比较(类型文本, "字符") ||
        字符串比较(类型文本, "整8") || 字符串比较(类型文本, "正8")) {
        大小[0] = 1;
        对齐[0] = 1;
        返回;
    }
    如果 (字符串比较(类型文本, "整16") || 字符串比较(类型文本, "正16")) {
        大小[0] = 2;
        对齐[0] = 2;
        返回;
    }
    如果 (字符串比较(类型文本, "整32") || 字符串比较(类型文本, "正32")) {
        大小[0] = 4;
        对齐[0] = 4;
        返回;
    }
    // ②c B：容器 $ 合成名——字段区按容器对象大小保留（指针槽模型：首 8 字节存
    //   堆对象指针，与宿主 typeSizeOf(容器) 布局对齐）
    如果 (是容器类(类型文本)) {
        大小[0] = 容器对象大小(类型文本);
        对齐[0] = 8;
        返回;
    }
    // 整64/正64/字符串/指针：8/8；结构体递归查表（plans/018 类型分桶：三级
    //   解析——解析期字段类型推导的当前模块路径=本模块，键基/限定文本/纯名通吃）
    整64 键基s = 结构体布局键基(驻留(类型文本));
    如果 (键基s != 0) {
        结果<整64, 整32> 查大小 = 结构体大小表.获取(键基s);
        如果 (查大小.正常) {
            大小[0] = 查大小.值;
            结果<整64, 整32> 查对齐 = 结构体对齐表.获取(键基s);
            如果 (查对齐.正常) { 对齐[0] = 查对齐.值; }
        }
    }
}

// 登记结构体布局（大小/对齐）——语法分析 解析结构体声明 尾部调用。
// plans/018 类型分桶（2026-09-08）：键由纯名升级为键基（键基合成(当前模块路径,
//   名)——主模块=纯名行为不变）；同步登记 纯名候选平铺（③ 合并全局三级解析
//   数据源：键=名ID*键位移+序 -> 键基/公开位平行 + 计数表）。公开位由语法层
//   顶层可见性标签传入（节点附加位同源）。
静态 映射<整64, 整64> 结构体候选键基们;   // 名ID*键位移+序 -> 键基ID
静态 映射<整64, 整64> 结构体候选公开们;   // 名ID*键位移+序 -> 0/1
静态 映射<整64, 整64> 结构体候选数们;     // 名ID -> 候选数

函数 登记结构体布局(整64 结构体名ID, 整64 大小, 整64 对齐, 整64 是否公开) -> 空类型 {
    整64 键基 = 键基合成(取当前模块路径(), 结构体名ID);
    结果<空类型, 整32> 加大小 = 结构体大小表.设置(键基, 大小);
    如果 (!加大小.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加对齐 = 结构体对齐表.设置(键基, 对齐);
    如果 (!加对齐.正常) { 运行时错误(4); }
    整64 序 = 0;
    结果<整64, 整32> 查数 = 结构体候选数们.获取(结构体名ID);
    如果 (查数.正常) { 序 = 查数.值; }
    结果<空类型, 整32> 加键 = 结构体候选键基们.设置(结构体名ID * 键位移 + 序, 键基);
    如果 (!加键.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加公开 = 结构体候选公开们.设置(结构体名ID * 键位移 + 序, 是否公开);
    如果 (!加公开.正常) { 运行时错误(4); }
    结果<空类型, 整32> 设数 = 结构体候选数们.设置(结构体名ID, 序 + 1);
    如果 (!设数.正常) { 运行时错误(4); }
}

// 结构体布局键基三级解析（类型分桶查询统一入口——plans/018 第 4 层收口）：
//   限定文本（"甲::记录"）拆分直查；纯名 ① 本模块键基（当前模块路径 合成，
//   遮蔽语义=本模块赢）＞ ② 直查（主模块键基=纯名，公开位设防——主模块成员
//   跨模块可见须公开；同键形态兼作键基幂等直查：已键基的ID在此命中）＞
//   ③ 纯名候选唯一公开命中（glob 合并可见；多公开候选=歧义，语义层诊断
//   fail fast，本层防御取首公开候选）。0=非结构体/未知（既有兜底语义）。
//   容器 $ 合成名（向量$整64）不含登记键天然 miss（是容器类 分支在其上游）。
函数 结构体布局键基(整64 类型名ID) -> 整64 {
    字符串 文本t = 字符串复制(驻留文本(类型名ID));
    字符串 模块t = "";
    字符串 符号t = "";
    如果 (拆限定名(文本t, 模块t, 符号t) == 1) {
        如果 (是标准库模块名(模块t)) { 返回 0; }
        整64 键基x = 键基合成(模块t, 驻留(符号t));
        结果<整64, 整32> 查x = 结构体大小表.获取(键基x);
        如果 (查x.正常) { 返回 键基x; }
        返回 0;
    }
    整64 键基1 = 键基合成(取当前模块路径(), 类型名ID);
    结果<整64, 整32> 查1 = 结构体大小表.获取(键基1);
    如果 (查1.正常) { 返回 键基1; }
    结果<整64, 整32> 查2 = 结构体大小表.获取(类型名ID);
    如果 (查2.正常) {
    }
    如果 (查2.正常) {
        如果 (是主模块路径(取当前模块路径())) { 返回 类型名ID; }
        // 候选名域判定：键基形态的ID（幂等直查）不在候选表——直通；纯名形态
        //   （主模块成员跨模块引用）公开设防——主模块私有成员不可见，落 ③
        整64 数m = 0;
        结果<整64, 整32> 查数m = 结构体候选数们.获取(类型名ID);
        如果 (查数m.正常) { 数m = 查数m.值; }
        如果 (数m == 0) { 返回 类型名ID; }
        结果<整64, 整32> 查公 = 结构体候选公开们.获取(类型名ID * 键位移 + 0);
        如果 (查公.正常) {
            如果 (查公.值 == 1) { 返回 类型名ID; }
        }
    }
    整64 数n = 0;
    结果<整64, 整32> 查数n = 结构体候选数们.获取(类型名ID);
    如果 (查数n.正常) { 数n = 查数n.值; }
    整64 首公开 = 0;
    整64 i = 0;
    当 (i < 数n) {
        整64 候选键 = 类型名ID * 键位移 + i;
        结果<整64, 整32> 查键c = 结构体候选键基们.获取(候选键);
        如果 (查键c.正常) {
            结果<整64, 整32> 查公c = 结构体候选公开们.获取(候选键);
            如果 (查公c.正常) {
                如果 (查公c.值 == 1) {
                    如果 (首公开 == 0) { 首公开 = 查键c.值; }
                }
            }
        }
        i++;
    }
    返回 首公开;
}

// 登记字段类型（分桶键=结构体名ID*键位移+字段名ID，由语法分析计算）——B4 用
函数 登记字段类型(整64 分桶键, 整64 字段类型名ID) -> 空类型 {
    结果<空类型, 整32> 加 = 字段类型表.设置(分桶键, 字段类型名ID);
    如果 (!加.正常) { 运行时错误(4); }
}

// ==================== T3 结构体字段引用未登记收集（311-a=306-b 波次2 v2 侧·2026-09-17） ====================
// 「先声明后使用」违规与值字段递归环（直接 甲{甲} / 间接 甲↔乙 / 三元环）的
//   唯一同源捕获点：任何环按声明序最早成员的字段引用必 miss（被引用结构体
//   未登记——登记在各自声明尾部）且环成员最终必登记——收尾 检查未登记引用
//   诊断中止；合法程序（先声明后使用满足）零 miss=零误报。原行为=miss 静默
//   8 字节兜底（无穷大小类型静默变 8 字节·值语义越界写面——对齐宿主 T3 立案
//   同因；宿主 306-a 修法=computeLayout visiting 栈，v2 解析期登记模型下
//   等价完备解=本收集+收尾全量判定）。
静态 向量<整64> 未登记引用引用者们;   // 引用者结构体名ID
静态 向量<整64> 未登记引用被引们;     // 被引用字段类型名ID

不安全 函数 收集未登记引用(整64 引用者名ID, 整64 被引用类型名ID) -> 空类型 {
    结果<空类型, 整32> 加a = 未登记引用引用者们.追加(引用者名ID);
    如果 (!加a.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加b = 未登记引用被引们.追加(被引用类型名ID);
    如果 (!加b.正常) { 运行时错误(4); }
}

函数 未登记引用数() -> 整64 {
    返回 未登记引用引用者们.大小();
}

// T3 收尾判定（主.cn 全解析后调用）：返回诊断行数（>0=须中止）。
//   被引用名收尾时查结构体大小 ≠0 =「先声明后使用」违规（含递归环——环成员
//   必登记）；==0 =未知类型（原静默 8 兜底错值面顺带根治）。
不安全 函数 检查未登记引用() -> 整64 {
    整64 n = 未登记引用引用者们.大小();
    整64 i = 0;
    整64 诊断数 = 0;
    当 (i < n) {
        整64 引用者名 = 未登记引用引用者们.元素(整32(i));
        整64 被引名 = 未登记引用被引们.元素(整32(i));
        整64 被引大小 = 查结构体大小(被引名);
        如果 (被引大小 != 0) {
            // 前向引用：递归环或声明序违规——对齐宿主 T3 拒绝语义
            IO::打印到错误("[布局] 结构体 '" + 字符串复制(驻留文本(引用者名)) +
                "' 的字段引用了后声明的结构体 '" + 字符串复制(驻留文本(被引名)) +
                "'（先声明后使用违规或值字段递归=无穷大小类型）——请调整声明顺序，" +
                "或将递归字段改为指针（T3）");
            诊断数++;
        } 否则 {
            IO::打印到错误("[布局] 结构体 '" + 字符串复制(驻留文本(引用者名)) +
                "' 的字段类型 '" + 字符串复制(驻留文本(被引名)) +
                "' 未知（未声明的类型）——原静默 8 字节兜底已废除（T3）");
            诊断数++;
        }
        i++;
    }
    返回 诊断数;
}

不安全 函数 清空未登记引用() -> 空类型 {
    未登记引用引用者们.清空();
    未登记引用被引们.清空();
}


// 查结构体大小（0=非结构体/未登记——结构体性判定依据）。
// plans/018 类型分桶：键经 结构体布局键基 三级解析（本模块＞主模块公开/键基
//   幂等直查＞合并全局公开候选）——消费点传入纯名/键基/限定文本均可。
函数 查结构体大小(整64 类型名ID) -> 整64 {
    整64 键基q = 结构体布局键基(类型名ID);
    如果 (键基q == 0) { 返回 0; }
    结果<整64, 整32> 查 = 结构体大小表.获取(键基q);
    如果 (查.正常) { 返回 查.值; }
    返回 0;
}

// 查字段类型名ID（0=未登记；B4 资源字段析构注入用）。
// plans/018 类型分桶：结构体维度先 结构体布局键基 幂等解析（消费点传纯名/
//   键基均可——分桶键恒在键基域，与 登记字段类型 同键）。
函数 查字段类型ID(整64 结构体ID, 整64 字段名ID) -> 整64 {
    整64 键基f = 结构体布局键基(结构体ID);
    如果 (键基f == 0) { 返回 0; }
    结果<整64, 整32> 查 = 字段类型表.获取(键基f * 键位移 + 字段名ID);
    如果 (查.正常) { 返回 查.值; }
    返回 0;
}

// ==================== 推断声明类型表（46-c，2026-09-10 第四十九轮） ====================
// 变量 标识符 = 表达式（规范 03 形式1）推断声明：语义层推导初值类型后登记
//   （变量名ID -> 类型名ID），IR 层 生成变量声明 对推断标记（类型节点文本=
//   空串哨兵）查表回填布局分派。跨层静态表模式与 变量结构体表 同款（主.cn
//   层间池按值传递，语义层回填对 IR 层不可见——本表是唯一通道）。纯名键域，
//   跨文件保留（多文件声明收集/逐文件检查/IR 生成 与 变量结构体表 同时序）。
静态 映射<整64, 整64> 推断声明类型表;

函数 登记推断声明类型(整64 变量名ID, 整64 类型名ID) -> 空类型 {
    结果<空类型, 整32> 加 = 推断声明类型表.设置(变量名ID, 类型名ID);
    如果 (!加.正常) { 运行时错误(4); }
}

// 查推断声明类型（0=未登记/非推断声明）
函数 查推断声明类型(整64 变量名ID) -> 整64 {
    结果<整64, 整32> 查 = 推断声明类型表.获取(变量名ID);
    如果 (查.正常) { 返回 查.值; }
    返回 0;
}

// 清空推断声明类型表（任务级生命周期——与 变量结构体表/结构体布局表 同位调用）
函数 清空推断声明类型表() -> 空类型 {
    推断声明类型表.清空();
}

// ==================== 字段偏移/宽度（②b B5，2026-09-02） ====================
// 分桶偏移表（键 = 结构体名ID*键位移+字段名ID——与 字段类型表 同键）：
//   语法层 解析后缀链 对调用对象（池.元素(i).字段）只能扁平回退查偏移（仅按
//   字段名——同名字段跨结构体必错，③ 自举必踩）；IR 层经方法签名返回类型
//   分桶收口，本表供查询。键位移 由语法分析定义（纯名引用——合并后全局可见）。
静态 映射<整64, 整64> 字段偏移表们;

// 登记字段偏移（解析结构体声明 每字段调用——与 登记字段类型 同键同点）
函数 登记字段偏移(整64 分桶键, 整64 偏移) -> 空类型 {
    结果<空类型, 整32> 加 = 字段偏移表们.设置(分桶键, 偏移);
    如果 (!加.正常) { 运行时错误(4); }
}

// 查字段偏移（-1=未登记）。plans/018 类型分桶：签名改两参（结构体维度+字段名），
//   内部 结构体布局键基 幂等解析——原单参分桶键形态由调用方键域不一（纯名/键基
//   混传）串桶，收口到本函数（与 登记字段偏移 键基域同键）。
函数 查字段偏移(整64 结构体ID, 整64 字段名ID) -> 整64 {
    整64 键基o = 结构体布局键基(结构体ID);
    如果 (键基o == 0) { 返回 -1; }
    结果<整64, 整32> 查 = 字段偏移表们.获取(键基o * 键位移 + 字段名ID);
    如果 (查.正常) { 返回 查.值; }
    返回 -1;
}

// 类型宽度类型码：按字段类型文本返回 指针加载/存储 宽度标注（T_* 码）。
//   窄宽码 T_整8/T_整16/T_字符 由 IR生成 定义（纯名引用——合并后全局可见，
//   同 IR追加 先例）；其余（整64/字符串/指针/嵌套结构体）默认 8 字节。
// 46-f（2026-09-10 第五十轮）：正32 独立码 T_正32——字段 4 字节读回零扩展
//   （movzx/ldr w32）而非符号扩展（movsxd）：4000000000 位模式读回须=原值。
函数 类型宽度码(字符串 类型文本) -> 整64 {
    // 94-a：数组类型——读/写宽度按**元素类型**（宿主 mapType(数组)=mapType(元素)
    //   同构；数组元素 p[i] 的加载/存储宽度即元素宽度）
    如果 (是数组类型文本(类型文本)) {
        字符串 元素w = 数组元素文本(类型文本);
        如果 (字符串长度(元素w) > 0) { 返回 类型宽度码(元素w); }
    }
    如果 (字符串比较(类型文本, "布尔")) { 返回 T_布尔; }
    如果 (字符串比较(类型文本, "字符")) { 返回 T_字符; }
    // 347-a（T33 残余根治·同族旁路穷尽）：原「整8/正8 归并 T_整8」「整16/正16
    //   归并 T_整16」**丢失符号性** → 结构体字段/数组元素/指针解引用路径的无符号
    //   窄类型被当有符号读（探针 p24：正8 字段 200 读回 -56；正16 60000 读回 -5536）；
    //   反向：整8/整16 负值被零扩展（p23：-426 读回 65110）。拆分为独立码——
    //   三后端已完整支持 T_正8/T_正16 零扩展语义（2026-09-04 收口设施·
    //   转换/装载面分派齐备），指针加载/存储分派本轮补齐。
    如果 (字符串比较(类型文本, "整8")) { 返回 T_整8; }
    如果 (字符串比较(类型文本, "正8")) { 返回 T_正8; }
    如果 (字符串比较(类型文本, "整16")) { 返回 T_整16; }
    如果 (字符串比较(类型文本, "正16")) { 返回 T_正16; }
    如果 (字符串比较(类型文本, "正32")) { 返回 T_正32; }
    如果 (字符串比较(类型文本, "整32")) { 返回 T_整32; }
    返回 T_整64;
}

// 查字段宽度码（结构体维度+字段名分桶；未登记返回 T_整64——防御默认 8 字节，
//   与旧行为一致）。根治：字段按统一 8 字节读/写——末字段越界清零相邻槽（126
//   段① i 槽被 子终点 8 字节写击穿 -> 当循环死循环 -> 堆 OOM SIGKILL，实测）。
// plans/018 类型分桶：结构体维度 结构体布局键基 幂等解析（同 查字段类型ID）。
函数 查字段宽度码(整64 结构体ID, 整64 字段名ID) -> 整64 {
    整64 键基w = 结构体布局键基(结构体ID);
    如果 (键基w == 0) { 返回 T_整64; }
    整64 字段类型ID = 查字段类型ID(键基w, 字段名ID);
    如果 (字段类型ID == 0) { 返回 T_整64; }
    返回 类型宽度码(驻留文本(字段类型ID));
}

// 多文件任务级生命周期：清空结构体布局表（主.cn 与 变量结构体表 同步调用）；
//   当前模块路径 复位 "主"（自检/回退链窗口——多文件主链每文件解析前重设）
不安全 函数 清空结构体布局表() -> 空类型 {
    结构体大小表.清空();
    结构体对齐表.清空();
    字段类型表.清空();
    字段偏移表们.清空();
    资源字段表们 = 向量<整64>();
    结构体资源字段数.清空();
    结构体串字段数.清空();
    结构体候选键基们.清空();
    结构体候选公开们.清空();
    结构体候选数们.清空();
    设当前模块路径("主");
}


// ==================== 结构体容器字段表（②c B，2026-09-02） ====================
// 指针槽模型：字段区按 容器对象大小 保留、首 8 字节存堆对象指针。语法层
//   解析结构体声明 登记（四元组：结构体ID/字段名ID/字段容器类型ID/字段偏移），
//   IR 层据此发射：字段构造赋值后读（LoadPtr->this）/块出口与返回的字段级联析构。
静态 向量<整64> 资源字段表们;        // 四元组平铺：[结构体ID, 字段名ID, 字段类型ID, 偏移]
静态 映射<整64, 整64> 结构体资源字段数;  // 结构体ID -> 该结构体资源字段个数（登记时累计）
// 79-a：细分计数——容器字段（对象指针槽模型，返回接收豁免）与 字符串字段
//   （拥有串句柄，返回接收=被调方返回移出 + 调用方接管，登记安全）
静态 映射<整64, 整64> 结构体串字段数;

// 登记一个资源字段（解析结构体声明 内调用；是容器=容器字段/否则字符串字段）
//  84-c（2026-09-12）：参数扩容 `整64 类别`——0=字符串字段 / 1=容器字段 /
//   2=**嵌套含资源字段结构体字段**（原实现「只收字符串/容器」与「含资源字段的嵌套
//   结构体（递归释放）」注释不符=既有缺口：`外盒{ 内 = 内盒{ 名 = 串 } }` 的
//   内.名 无释放面，探针 P25 实证 v2 残留 3 / 宿主 0）；类别仅影响 串字段数 计数
//   （=0 才计——`串字段数` 是「全串字段」语义：返回接收接管/是纯串字段结构体 判据）。
函数 登记资源字段(整64 结构体名ID, 整64 字段名ID, 整64 字段类型ID, 整64 偏移,
             布尔 是容器, 整64 类别) -> 空类型 {
    结果<空类型, 整32> 加1 = 资源字段表们.追加(结构体名ID);
    如果 (!加1.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加2 = 资源字段表们.追加(字段名ID);
    如果 (!加2.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加3 = 资源字段表们.追加(字段类型ID);
    如果 (!加3.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加4 = 资源字段表们.追加(偏移);
    如果 (!加4.正常) { 运行时错误(4); }
    整64 已有 = 0;
    结果<整64, 整32> 查数 = 结构体资源字段数.获取(结构体名ID);
    如果 (查数.正常) { 已有 = 查数.值; }
    结果<空类型, 整32> 设数 = 结构体资源字段数.设置(结构体名ID, 已有 + 1);
    如果 (!设数.正常) { 运行时错误(4); }
    如果 (类别 == 0) {
        整64 已有s = 0;
        结果<整64, 整32> 查数s = 结构体串字段数.获取(结构体名ID);
        如果 (查数s.正常) { 已有s = 查数s.值; }
        结果<空类型, 整32> 设数s = 结构体串字段数.设置(结构体名ID, 已有s + 1);
        如果 (!设数s.正常) { 运行时错误(4); }
    }
}

// 结构体直接字符串字段个数（0=无；>0=个数——79-a 返回接收接管的登记依据）
//   plans/018 类型分桶：结构体维度 结构体布局键基 幂等解析
函数 串字段数(整64 结构体名ID) -> 整64 {
    整64 键基s = 结构体布局键基(结构体名ID);
    如果 (键基s == 0) { 返回 0; }
    结果<整64, 整32> 查s = 结构体串字段数.获取(键基s);
    如果 (查s.正常) { 返回 查s.值; }
    返回 0;
}

// 结构体是否含容器字段（0=无；>0=个数——RAII 跟踪与析构注入依据）。
// plans/018 类型分桶：结构体维度 结构体布局键基 幂等解析（调用点传纯名文本ID）。
函数 资源字段数(整64 结构体名ID) -> 整64 {
    整64 键基c = 结构体布局键基(结构体名ID);
    如果 (键基c == 0) { 返回 0; }
    结果<整64, 整32> 查 = 结构体资源字段数.获取(键基c);
    如果 (查.正常) { 返回 查.值; }
    返回 0;
}

// 164-a（A4 方案A·plans/023 §十二）：标量类型文本判定（可平凡复制基础面；
//   含别名 整数/小数——v2 类型文本为源码原样，不做别名规范化）
函数 是标量类型文本(字符串 文本) -> 布尔 {
    返回 (字符串比较(文本, "整数") || 字符串比较(文本, "小数") ||
            字符串比较(文本, "整8") || 字符串比较(文本, "整16") ||
            字符串比较(文本, "整32") || 字符串比较(文本, "整64") ||
            字符串比较(文本, "整128") ||
            字符串比较(文本, "正8") || 字符串比较(文本, "正16") ||
            字符串比较(文本, "正32") || 字符串比较(文本, "正64") ||
            字符串比较(文本, "正128") ||
            字符串比较(文本, "浮32") || 字符串比较(文本, "浮64") ||
            字符串比较(文本, "布尔") || 字符串比较(文本, "字符") ||
            字符串比较(文本, "空类型"));
}

// 164-a：指针类型文本判定（末字符 '*'——含 字符* 借用视图；可平凡复制）
函数 是指针类型文本(字符串 文本) -> 布尔 {
    整64 长p = 字符串长度(文本);
    如果 (长p == 0) { 返回 假; }
    返回 字符串比较(字符串子串(文本, 整32(长p - 1), 1), "*");
}

// 164-a（A4 方案A·plans/023 §十二）：可平凡复制判定（宿主 isTriviallyCopyable 同构）——
//   联合体成员类型限定的判定核心。标量/指针/数组（递归元素）/结构体（资源字段数与
//   串字段数均 0——含嵌套含资源结构体 类别 2 已计入资源字段数）；拥有型（字符串/
//   容器类/含资源聚合）→ 假。联合体（内层）资源字段不登记（v2 联合体字段不入资源
//   表）→ 按 0 放行——其成员合规性由该联合体自身的检查负责（递归链闭环）。
//   未识别类型（结果/可选等合成类型）→ 默认拒绝（方案A 方向；结果/可选的联合体
//   成员面为 v2 诚实边界，宿主放行-v2 拒绝的差异登记另轮）。
函数 可平凡复制v2(字符串 类型文本) -> 布尔 {
    如果 (是标量类型文本(类型文本)) { 返回 真; }
    如果 (是指针类型文本(类型文本)) { 返回 真; }
    如果 (字符串比较(类型文本, "字符串")) { 返回 假; }
    如果 (是容器类(类型文本)) { 返回 假; }
    如果 (是数组类型文本(类型文本)) {
        返回 可平凡复制v2(数组元素文本(类型文本));
    }
    如果 (查结构体类型(驻留(类型文本)) != 0) {
        如果 (资源字段数(驻留(类型文本)) > 0) { 返回 假; }
        如果 (串字段数(驻留(类型文本)) > 0) { 返回 假; }
        返回 真;
    }
    返回 假;
}

// 取结构体全部容器字段四元组（写入出参向量：[字段名ID, 字段类型ID, 偏移] 三元组平铺）
函数 取资源字段们(整64 结构体名ID, 向量<整64>& 出) -> 空类型 {
    整64 键基r = 结构体布局键基(结构体名ID);
    如果 (键基r == 0) { 返回; }
    整64 i = 0;
    当 (i + 3 <= 资源字段表们.大小()) {
        如果 (资源字段表们.元素(i) == 键基r) {
            结果<空类型, 整32> 加名 = 出.追加(资源字段表们.元素(i + 1));
            如果 (!加名.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加类 = 出.追加(资源字段表们.元素(i + 2));
            如果 (!加类.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加偏 = 出.追加(资源字段表们.元素(i + 3));
            如果 (!加偏.正常) { 运行时错误(4); }
        }
        i += 4;
    }
}

// ==================== 顶层常量收集（P7a，2026-09-01） ====================
// 常量表：键基ID -> 值文本ID（十进制文本）。代码生成 IR_常量整数 直接经
//   驻留文本(操作数1) 还原为立即数（负值为 "-N" 文本，mov rax, -N 合法），
//   故折叠全程零数值解析——正值复用字面量 Symbol ID，负值拼接后驻留一次。
//   收集在 IR生成/IR生成多文件 入口进行（先清空，幂等；多文件全部 程序 节点
//   依次收集，跨文件常量引用天然可见）。
// plans/018 常量分桶（2026-09-08）：键由常量名纯名升级为键基（键基合成(模块
//   路径, 名)——主模块=纯名行为不变），同名常量跨模块独立（探针实测修复前
//   后收集覆盖：甲 版本=100 被主 版本=200 覆盖 → 甲模块函数读错值）。
//   查询经 查常量值 三级解析（同 结构体布局键基 公式）。
静态 映射<整64, 整64> 常量表;
静态 映射<整64, 整64> 常量候选键基们;   // 名ID*键位移+序 -> 键基ID
静态 映射<整64, 整64> 常量候选数们;     // 名ID -> 候选数

// 折叠常量初始化区间 [起点, 终点)：整数字面量，或 [字面量, 负号]（负数）。
//   返回值文本ID；不可折叠（非字面量形态）返回 0。
函数 折叠常量值(向量<节点> 池, 整32 起点, 整32 终点) -> 整64 {
    如果 (终点 - 起点 == 1) {
        节点 值节点 = 池.元素(起点);
        如果 (值节点.类型 == 节点_整数字面量) {
            返回 整64(值节点.文本);
        }
    }
    如果 (终点 - 起点 == 2) {
        节点 值节点2 = 池.元素(起点);
        节点 负号节点 = 池.元素(起点 + 1);
        如果 (值节点2.类型 == 节点_整数字面量 && 负号节点.类型 == 节点_负号) {
            返回 驻留("-" + 驻留文本(整64(值节点2.文本)));
        }
    }
    返回 0;
}

// 收集一个 程序 节点顶层区间的全部常量声明（登记进 常量表）。
//   非字面量初始化（如 常量 X = 1+2）：打印诊断且不登记——引用处将落入
//   函数名兜底路径（自举组件源码 84 处全部为整数字面量，不触发）。
// plans/018 常量分桶：模块路径 参数（IR生成多文件 按文件传入；单文件="主"），
//   登记键=键基 + 纯名候选平铺（查常量值 ③ 数据源）；公开位读节点附加位
//   （语法层 可见性标签 写入——与 顶层公开平铺们 同源双通道）。
函数 收集常量(向量<节点> 池, 整32 程序节点, 字符串 模块路径) -> 空类型 {
    节点 程序 = 池.元素(程序节点);
    整64 i = 整64(程序.子起点);
    当 (i < 整64(程序.子终点)) {
        节点 声明 = 池.元素(整32(i));
        如果 (声明.类型 == 节点_常量声明) {
            整64 值文本 = 折叠常量值(池, 声明.子起点, 声明.子终点);
            如果 (值文本 != 0) {
                整64 键基v = 键基合成(模块路径, 整64(声明.文本));
                结果<空类型, 整32> 设常 = 常量表.设置(键基v, 值文本);
                如果 (!设常.正常) { 运行时错误(4); }
                整64 序c = 0;
                结果<整64, 整32> 查数c = 常量候选数们.获取(整64(声明.文本));
                如果 (查数c.正常) { 序c = 查数c.值; }
                结果<空类型, 整32> 加键c = 常量候选键基们.设置(
                    整64(声明.文本) * 键位移 + 序c, 键基v);
                如果 (!加键c.正常) { 运行时错误(4); }
                结果<空类型, 整32> 设数c = 常量候选数们.设置(整64(声明.文本), 序c + 1);
                如果 (!设数c.正常) { 运行时错误(4); }
            } 否则 {
                IR层诊断("常量初始化须为整数字面量: " +
                              驻留文本(整64(声明.文本)));
            }
        }
        i++;
    }
}

// 查常量值（值文本ID；0=未命中）。三级解析（结构体布局键基 同构公式）：
//   限定文本拆分直查 ＞ ① 本模块键基 ＞ ② 纯名直查（主模块键基=纯名；公开位
//   不设防——公开性/歧义由语义层 fail fast 诊断，IR 层数据面防御取先）＞
//   ③ 纯名候选首个（glob 合并可见）。
函数 查常量值(整64 常量名ID) -> 整64 {
    字符串 文本v = 字符串复制(驻留文本(常量名ID));
    字符串 模块v = "";
    字符串 符号v = "";
    如果 (拆限定名(文本v, 模块v, 符号v) == 1) {
        如果 (是标准库模块名(模块v)) { 返回 0; }
        结果<整64, 整32> 查x = 常量表.获取(键基合成(模块v, 驻留(符号v)));
        如果 (查x.正常) { 返回 查x.值; }
        返回 0;
    }
    结果<整64, 整32> 查1 = 常量表.获取(键基合成(取当前模块路径(), 常量名ID));
    如果 (查1.正常) { 返回 查1.值; }
    结果<整64, 整32> 查2 = 常量表.获取(常量名ID);
    如果 (查2.正常) { 返回 查2.值; }
    整64 数v = 0;
    结果<整64, 整32> 查数v = 常量候选数们.获取(常量名ID);
    如果 (查数v.正常) { 数v = 查数v.值; }
    如果 (数v > 0) {
        结果<整64, 整32> 查c = 常量候选键基们.获取(常量名ID * 键位移 + 0);
        如果 (查c.正常) {
            结果<整64, 整32> 查f = 常量表.获取(查c.值);
            如果 (查f.正常) { 返回 查f.值; }
        }
    }
    返回 0;
}

// ==================== 内置函数表（③ 自举第一波，2026-09-03） ====================
// 宿主 ir_call.cpp 名称映射对齐；ABI 权威=宿主 asm 实证（内置函数为裸 ASCII 符号
// 直调：bl __cn_intern，v2p_linux.s 实查）。覆盖面=v2 组件自身用面（9 组件统计：
// 驻留209/运行时错误143/字符串比较134/驻留文本69/整数转字符串63/字符串长度52/
// 字符串子串36/类型大小7）+ 字符串连接（拼接 + 的展开目标，亦可独立调用）。
// 表驱动扩表：后续组件踩到新内置（IO::/文件:: 限定名等）按行追加即可。
函数 内置函数符号(字符串 名) -> 字符串 {
    如果 (字符串比较(名, "驻留")) { 返回 "__cn_intern"; }
    如果 (字符串比较(名, "驻留文本")) { 返回 "__cn_intern_text"; }
    如果 (字符串比较(名, "驻留计数")) { 返回 "__cn_intern_count"; }
    如果 (字符串比较(名, "字符串长度")) { 返回 "__cn_str_len"; }
    如果 (字符串比较(名, "字符串比较")) { 返回 "__cn_str_eq"; }
    如果 (字符串比较(名, "字符串子串")) { 返回 "__cn_str_sub"; }
    如果 (字符串比较(名, "字符串连接")) { 返回 "__cn_str_concat"; }
    // A2（2026-09-11 方案甲）：字符串复制——借用→拥有显式落堆（v2 树迁移后
    //   全树在用——v2 自举链必需；Rust &str.to_string() 同款）
    如果 (字符串比较(名, "字符串复制")) { 返回 "__cn_str_copy"; }
    // 96-a（2026-09-13 第九十六轮 C10）：字符转字符串（单字节 0-255 -> 1 字节串，
    //   宿主 ir_call.cpp:210 `__cn_str_from_char` 对齐）——v2 词法 `\u{XXXX}` 解码
    //   的 UTF-8 逐字节构造载体（runtime string_api.cpp:267 同源）。
    如果 (字符串比较(名, "字符转字符串")) { 返回 "__cn_str_from_char"; }
    如果 (字符串比较(名, "整数转字符串")) { 返回 "__cn_str_from_int"; }
    如果 (字符串比较(名, "运行时错误")) { 返回 "__cn_runtime_error"; }
    // 432-b（撤守卫·stdlib 源码级加载）：内存管理内置（io_api.cpp 符号映射注释
    //   权威：分配→cn_alloc、释放→cn_free、重新分配→cn_realloc、复制内存→
    //   cn_memcpy、置零内存→cn_memset）——容器.cn/映射集合.cn 源码级编译的
    //   分配/释放 调用原 lowering 目标；v2 树自身不用（容器=v2p 预编译供给）
    //   故此前缺行。
    如果 (字符串比较(名, "分配")) { 返回 "cn_alloc"; }
    如果 (字符串比较(名, "释放")) { 返回 "cn_free"; }
    如果 (字符串比较(名, "重新分配")) { 返回 "cn_realloc"; }
    如果 (字符串比较(名, "复制内存")) { 返回 "cn_memcpy"; }
    如果 (字符串比较(名, "置零内存")) { 返回 "cn_memset"; }
    // ③ 第五波（2026-09-03）：限定名内置（宿主 ir_call.cpp:217~235 对齐——限定名
    //   全局注册无需导入，IR 映射裸 ASCII 运行时符号直调）。IO::=stderr 诊断通道
    //   （v2 组件 全量在用）；文件::=v2 驱动器 源码读/asm 写 命脉（file_api.cpp）。
    如果 (字符串比较(名, "IO::读取行")) { 返回 "__cn_read_line"; }
    如果 (字符串比较(名, "IO::读取整数")) { 返回 "__cn_read_int"; }
    如果 (字符串比较(名, "IO::读取浮点")) { 返回 "__cn_read_float"; }
    如果 (字符串比较(名, "IO::打印到错误")) { 返回 "__cn_print_err"; }
    如果 (字符串比较(名, "文件::打开文件")) { 返回 "__cn_file_open"; }
    如果 (字符串比较(名, "文件::读取文件")) { 返回 "__cn_file_read"; }
    如果 (字符串比较(名, "文件::写入文件")) { 返回 "__cn_file_write"; }
    如果 (字符串比较(名, "文件::读取文件行")) { 返回 "__cn_file_read_line"; }
    如果 (字符串比较(名, "文件::文件大小")) { 返回 "__cn_file_size"; }
    如果 (字符串比较(名, "文件::关闭文件")) { 返回 "__cn_file_close"; }
    如果 (字符串比较(名, "文件::文件存在")) { 返回 "__cn_file_exists"; }
    // ④ v2@16（2026-09-05）：系统:: 限定名（主.cn 命令行参数命脉；宿主
    //   ir_call.cpp:251~252 对齐——argc/argv 裸符号直调 system_api.cpp）。
    如果 (字符串比较(名, "系统::参数个数")) { 返回 "__cn_argc"; }
    如果 (字符串比较(名, "系统::参数")) { 返回 "__cn_argv"; }
    // 73-a（2026-09-11 方案A 用户裁决）：内存::活动分配数（宿主 ir_call.cpp:266
    //   对齐）——E2E 216_v2 块级 RAII 回归防线的泄漏断言口径：调用前后差值恒 0
    //   （宿主 E2E 213 同款；无此内置则 v2 侧只能用退出码间接锚定）。
    //   纯名与 :: 两写法均映射（宿主两写法同款；调用点语法层合成限定名）。
    如果 (字符串比较(名, "内存::活动分配数") ||
        字符串比较(名, "内存.活动分配数")) { 返回 "__cn_alloc_live"; }
    // 276-a（D29②·2026-09-17）：时间:: 限定名（宿主 ir_call.cpp:283 对齐——
    //   time_api.cpp 运行时符号直调）。stdlib/时间.cn 包装层的内置依赖面：
    //   包装函数内部 时间::xxx 限定名直调（全局注册无需导入），本表注册后
    //   v2p 的 stdlib/时间.cn 纯名包装才可编译。
    如果 (字符串比较(名, "时间::当前时间戳")) { 返回 "__cn_time"; }
    如果 (字符串比较(名, "时间::单调时钟毫秒")) { 返回 "__cn_clock_ms"; }
    如果 (字符串比较(名, "时间::格式化时间")) { 返回 "__cn_time_format"; }
    返回 "";
}

// 内置函数返回类型ID（语义层白名单 / IR 表达式类型推导共用）；0=非内置。
//   返回形态全为标量（整64/布尔）或指针（字符串）——单槽，无 sret/retbuf 复杂度。
//   限定名返回形态对齐宿主 semantic.cpp regIoFn/regFileFn（1226~1257 行）；
//   空类型* 按指针单槽记 整64（v2 无裸指针类型码——T_整64 载体）。
函数 内置函数返回类型ID(字符串 名) -> 整64 {
    // A2（2026-09-11 方案甲）：驻留文本 返回 字符*——驻留表指针=借用视图
    //   （调用方持有须 字符串复制 落堆；原 字符串 返回在拥有契约下会被
    //   登记 free=释放驻留表条目）。
    如果 (字符串比较(名, "驻留文本")) { 返回 驻留("字符*"); }
    如果 (字符串比较(名, "字符串子串") || 字符串比较(名, "字符串连接") ||
         字符串比较(名, "字符串复制") || 字符串比较(名, "整数转字符串") ||
         字符串比较(名, "字符转字符串")) {
        返回 驻留("字符串");
    }
    如果 (字符串比较(名, "字符串比较")) { 返回 驻留("布尔"); }
    // 432-b：内存管理内置返回类型（分配/重新分配/复制内存/置零内存→空类型*
    //   指针单槽·按注释口径记整64 载体；释放→空类型）
    如果 (字符串比较(名, "分配") || 字符串比较(名, "重新分配") ||
         字符串比较(名, "复制内存") || 字符串比较(名, "置零内存")) {
        返回 驻留("空类型*");
    }
    如果 (字符串比较(名, "释放")) { 返回 驻留("空类型"); }
    如果 (字符串比较(名, "驻留") || 字符串比较(名, "驻留计数") ||
         字符串比较(名, "字符串长度") || 字符串比较(名, "运行时错误") ||
         字符串比较(名, "打印") || 字符串比较(名, "打印行")) {
        返回 驻留("整64");
    }
    // 限定名内置：字符串/布尔/浮点/整64/空类型（打印分派与拼接判定消费）
    如果 (字符串比较(名, "IO::读取行") || 字符串比较(名, "文件::读取文件行")) {
        返回 驻留("字符串");
    }
    如果 (字符串比较(名, "文件::文件存在")) { 返回 驻留("布尔"); }
    如果 (字符串比较(名, "IO::读取浮点")) { 返回 驻留("浮64"); }
    如果 (字符串比较(名, "IO::打印到错误") || 字符串比较(名, "文件::关闭文件")) {
        返回 驻留("空类型");
    }
    如果 (字符串比较(名, "IO::读取整数") || 字符串比较(名, "文件::打开文件") ||
         字符串比较(名, "文件::读取文件") || 字符串比较(名, "文件::写入文件") ||
         字符串比较(名, "文件::文件大小")) {
        返回 驻留("整64");
    }
    // ④ v2@16：系统:: 返回形态（宿主 semantic.cpp regSysFn 对齐——
    //   参数个数=整64 无参、参数=字符* 指针单槽带整64 参）
    //   70-a（2026-09-11 方案A 补完）：argv=CRT 持有借用——字符串（A2 拥有
    //   契约下调用方 free=悬垂）改 字符*（驻留文本 同款 C 类改法）
    如果 (字符串比较(名, "系统::参数个数")) { 返回 驻留("整64"); }
    如果 (字符串比较(名, "系统::参数")) { 返回 驻留("字符*"); }
    // 73-a：内存::活动分配数 -> 整64（宿主 semantic.cpp 同款；E2E 216_v2 断言用）
    如果 (字符串比较(名, "内存::活动分配数") ||
        字符串比较(名, "内存.活动分配数")) { 返回 驻留("整64"); }
    // 276-a（D29②）：时间:: 返回形态（宿主 semantic.cpp regTimeFn 对齐——
    //   当前时间戳/单调时钟毫秒=整64；格式化时间=字符串（拥有，调用方 RAII
    //   释放；失败 nullptr 面=空串语义））
    如果 (字符串比较(名, "时间::当前时间戳") ||
        字符串比较(名, "时间::单调时钟毫秒")) { 返回 驻留("整64"); }
    如果 (字符串比较(名, "时间::格式化时间")) { 返回 驻留("字符串"); }
    返回 0;
}

// 类型名宽度（类型大小(类型) 编译期折叠，规格 02-六B）：原始类型宽度表 +
//   结构体布局表（②b B1）；0=未知类型。对齐宿主 typeSizeOf（字符串=8 指针）。
函数 类型名宽度(整64 类型名ID) -> 整64 {
    字符串 名 = 字符串复制(驻留文本(类型名ID));
    如果 (字符串比较(名, "整8") || 字符串比较(名, "正8") ||
         字符串比较(名, "布尔") || 字符串比较(名, "字符")) { 返回 1; }
    如果 (字符串比较(名, "整16") || 字符串比较(名, "正16")) { 返回 2; }
    如果 (字符串比较(名, "整32") || 字符串比较(名, "正32") ||
         字符串比较(名, "浮32")) { 返回 4; }
    如果 (字符串比较(名, "整64") || 字符串比较(名, "正64") ||
         字符串比较(名, "浮64") || 字符串比较(名, "字符串")) { 返回 8; }
    如果 (字符串比较(名, "整128") || 字符串比较(名, "正128")) { 返回 16; }
    返回 查结构体大小(类型名ID);
}

// ==================== 94-a：数组类型工具（v2 栈数组全链） ====================
// 数组类型文本格式（与宿主 canonical 同构，规格 3.5 复合类型）：元素文本 + "[" + 长度 + "]"
//   例 "整32[5]" / "字符串[3]" / "点[2]"；元素可为基本类型/字符串/结构体/容器/用户类。
// v2 类型=驻留文本模型（无独立类型对象）——判定/拆分全走文本扫描（宿主 types::isArray
//   同构语义；消费点：声明分派/槽数/元素步进/下标/实参退化）。

// 是数组类型文本（含 '[' 且以 ']' 结尾；宿主 types::isArray 同构判定）
函数 是数组类型文本(字符串 文本) -> 布尔 {
    整64 长 = 字符串长度(文本);
    如果 (长 < 3) { 返回 假; }
    如果 (!字符串比较(字符串子串(文本, 整32(长 - 1), 1), "]")) { 返回 假; }
    整64 i = 0;
    当 (i < 长) {
        如果 (字符串比较(字符串子串(文本, 整32(i), 1), "[")) { 返回 真; }
        i++;
    }
    返回 假;
}

// 数组元素类型文本（"整32[5]" -> "整32"；非数组/首字符即 '[' 返回空串）
函数 数组元素文本(字符串 文本) -> 字符串 {
    整64 长 = 字符串长度(文本);
    整64 左 = 0 - 1;
    整64 i = 0;
    当 (i < 长) {
        如果 (字符串比较(字符串子串(文本, 整32(i), 1), "[")) {
            如果 (左 < 0) { 左 = i; }
        }
        i++;
    }
    如果 (左 <= 0) { 返回 ""; }
    返回 字符串子串(文本, 0, 整32(左));
}

// 数组长度（"整32[5]" -> 5；非数组/非纯数字返回 0）
函数 数组长度文本(字符串 文本) -> 整64 {
    整64 长 = 字符串长度(文本);
    整64 左 = 0 - 1;
    整64 i = 0;
    当 (i < 长) {
        如果 (字符串比较(字符串子串(文本, 整32(i), 1), "[")) {
            如果 (左 < 0) { 左 = i; }
        }
        i++;
    }
    如果 (左 <= 0 || 左 + 2 >= 长) { 返回 0; }
    字符串 数字 = 字符串子串(文本, 整32(左 + 1), 整32(长 - 左 - 2));
    整64 值 = 0;
    整64 j = 0;
    当 (j < 字符串长度(数字)) {
        整64 字节 = 整64(数字[j]) & 255;
        如果 (字节 < 48 || 字节 > 57) { 返回 0; }
        值 = 值 * 10 + (字节 - 48);
        j++;
    }
    返回 值;
}

// 数组元素步进（元素类型真实大小；容器/结构体/基本类型全走 类型大小与对齐
//   单点——对齐宿主 typeSizeOf(元素)；0=未知）
不安全 函数 数组元素步进(字符串 文本) -> 整64 {
    字符串 元素 = 数组元素文本(文本);
    如果 (字符串长度(元素) == 0) { 返回 0; }
    整64 大小 = 0;
    整64 对齐 = 0;
    类型大小与对齐(元素, &大小, &对齐);
    返回 大小;
}


// ==================== 跨子模块访问函数（千行拆分，2026-09-08） ====================
//   生成函数 子模块（IR生成/IR生成多文件 入口清空）经此访问常量表族
函数 清空常量表() -> 空类型 {
    常量表.清空();
    常量候选键基们.清空();
    常量候选数们.清空();
}

// ==================== 418-a（D40 细分）：枚举表 ====================
// 职责：枚举（规范 枚举 声明）的编译期常量表——C 风格枚举（成员=整32 常量·
//   显式值或默认前值+1）。键口径=枚举名ID*键位移+成员名ID（驻留 ID 全局唯一
//   →跨模块天然一致·导入 核心::错误码 后 错误码.内存 直查）。消费点：
//   ①语义层 成员链基名=枚举名→放行（整32 族）；②IR 生成层 成员链→常量折叠。
//   声明登记点=解析枚举声明（语法层·与结构体布局登记同时机）。

静态 映射<整64, 整64> 枚举存在们;   // 枚举名ID -> 1
静态 映射<整64, 整64> 枚举成员值们; // 枚举名ID*键位移+成员名ID -> 常量值

// 任务级生命周期清空（主.cn 与 清空结构体布局表 同位）
函数 清空枚举表() -> 空类型 {
    枚举存在们.清空();
    枚举成员值们.清空();
}

// 登记枚举名（幂等）
函数 登记枚举名(整64 枚举名ID) -> 空类型 {
    结果<空类型, 整32> 设e = 枚举存在们.设置(枚举名ID, 1);
    如果 (!设e.正常) { 运行时错误(4); }
}

// 登记枚举成员常量值
函数 登记枚举成员值(整64 枚举名ID, 整64 成员名ID, 整64 值) -> 空类型 {
    结果<空类型, 整32> 设v = 枚举成员值们.设置(枚举名ID * 键位移 + 成员名ID, 值);
    如果 (!设v.正常) { 运行时错误(4); }
}

// 查是否枚举名（类型位/成员链基名判定）
函数 是枚举名(整64 名ID) -> 布尔 {
    结果<整64, 整32> 查e = 枚举存在们.获取(名ID);
    返回 查e.正常;
}

// 查枚举成员常量值（-1=未命中——枚举值域从 1 起·核心 错误码 实测口径）
函数 查枚举成员值(整64 枚举名ID, 整64 成员名ID) -> 整64 {
    结果<整64, 整32> 查v = 枚举成员值们.获取(枚举名ID * 键位移 + 成员名ID);
    如果 (查v.正常) { 返回 查v.值; }
    返回 0 - 1;
}

// 418-a：数字文本→数值（枚举默认值递增用·十进制无符号——字面量数值历来由
//   汇编器处理，此处为枚举默认递增的编译期特例·全库首例编译期转数）
不安全 函数 数字文本转数值(字符串 文本s) -> 整64 {   // 字符串下标读=安全区边界挂点
    整64 值s = 0;
    整64 i = 0;
    当 (i < 字符串长度(文本s)) {
        整64 字节s = 整64(文本s[i]) & 255;
        如果 (字节s >= 48 && 字节s <= 57) {
            值s = 值s * 10 + (字节s - 48);
        }
        i++;
    }
    返回 值s;
}
