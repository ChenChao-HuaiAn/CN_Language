// 生成语句赋值尾（356 重构F1 自 生成语句赋值.cn 纯机械搬移·函数体逐字保留·零逻辑变化）

导入 容器::向量;
导入 映射集合;
导入 IR;         // IR指令/签名辅助/节点_* 常量（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）


不安全 函数 尝试成员结构体整体写(向量<节点> 池, 节点 n, 节点 左末,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    如果 (左末.类型 == 节点_成员 && n.子起点 < n.子终点) {
        // 父链类型=解析成员链结构体ID(左末.子起点)（范本=取成员宽度码：
        //   成员节点 子起点=对象节点索引——传左末自身索引得的是左末字段
        //   自身类型，再查一层字段类型必 miss——首版误写实证）
        整64 父链ID48 = 解析成员链结构体ID(池, 整32(左末.子起点));
        如果 (父链ID48 != 0) {
            整64 字段结构体ID48 = 查结构体类型(
                查字段类型ID(父链ID48, 整64(左末.文本)));
            如果 (字段结构体ID48 != 0) {
                // 506-a（T70 B1 三层·466-a 同款）：**容器/用户类字段排除**——撤守卫态
                //   容器实例布局登记（423-b 裸键直设）使 查结构体类型≠0 → 本通道误抢
                //   容器成员赋值（`b.表 = <容器调用/容器变量>`），其调用路径查 结构体
                //   返回临时们 miss → 误诊断「非结构体返回值」（127 撤守卫态实证：
                //   字段=表 ×3·修复前同态）；若无调用路径则更深拷贝语义被浅拷覆盖。
                //   生产态容器字段无结构体登记=天然 0·零回归。让位既有容器深拷/接管
                //   通道（生成容器对象整体赋值·T57/346-a）。
                字符串 字段文本48 = 字符串复制(驻留文本(查字段类型ID(父链ID48, 整64(左末.文本))));
                如果 (是容器类(字段文本48) || 是用户类(字段文本48)) { 返回 假; }
                节点 右末48 = 池.元素(n.子终点 - 1);
                // 86-a（2026-09-12 复审缺陷①）：三元右值（乙箱.内盒 = (条?甲:乙)）——
                //   源地址经 生成表达式（三元聚合分支地址化=选中 place 地址），
                //   与标识符/成员（生成左值地址）分流。原白名单不含三元 → 落标量
                //   Store 通道 8 字节写 → 字段静默损坏（P47-v2 形六 t6 实证乱码）。
                // 348-a（D11 甲方案·源优先序·双侧同构）：右值=**一般结构体返回调用**
                //   → ①先求值源（生成表达式·可能含条件块〔正常/错误构造器 返回分支〕）
                //   ②再算目标地址（生成左值地址·纯地址计算无块）③整体拷贝（源=一次性
                //   物化槽 → 浅拷接管〔深拷=假〕+ 目标 preFree）。
                //   原序（目标地址先发射）使源调用的块插在地址发射之后 → 234-a
                //   「全量 v2 树编译 285 失败」根因 → 白名单被迫收窄 → 该形态落标量
                //   宽度通道 8 字节（D11·探针 p29：`甲.内 = 造点(20)` 首字段=返回值
                //   地址、余字段 0 静默错值）。对齐 生成结构体赋值调用分支（标识符
                //   目标·已是源优先序）。
                如果 (右末48.类型 == 节点_调用) {
                    // 栈纪律（346-a/88-a 净栈契约同源）：记录进入深度，源求值后
                    //   **弹到进入深度**（生成表达式可能压多个残留）——否则残留元素
                    //   会污染随后 生成左值地址 的下标/解引用分支（v2p 自身空指针
                    //   解引用错误码 3 实证）。
                    整64 前深度48 = 表达式栈.大小();
                    整64 消费48 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                           指令, 寄存器计数, &函数信息.块计数,
                                           槽计数, 表达式栈);
                    整64 源寄存器48 = 0;
                    如果 (表达式栈.大小() > 前深度48) {
                        源寄存器48 = 表达式栈.元素(表达式栈.大小() - 1);
                    }
                    当 (表达式栈.大小() > 前深度48) {
                        结果<空类型, 整32> 删源48 = 表达式栈.删除(表达式栈.大小() - 1);
                        如果 (!删源48.正常) { 运行时错误(4); }
                    }
                    结果<整64, 整32> 查源48 = 结构体返回临时们.获取(源寄存器48);
                    如果 (消费48 == 0 || 源寄存器48 == 0 || !查源48.正常) {
                        IR层诊断("结构体成员赋值右值（调用返回）非结构体返回值: 字段=" +
                                     驻留文本(整64(左末.文本)) + " 消费=" +
                                     整数转字符串(消费48) + " 源寄存器=" +
                                     整数转字符串(源寄存器48) + " 查源=" +
                                     整数转字符串(整64(查源48.正常)) + " 目标=" +
                                     驻留文本(整64(n.文本)));
                    } 否则 {
                        整64 目标地址48c = 生成左值地址(池, 整32(n.附加), n.子起点,
                                                       局部槽, 参数槽, 指令,
                                                       寄存器计数, &函数信息.块计数,
                                                       槽计数, 表达式栈);
                        如果 (目标地址48c != 0) {
                            发射结构体整体拷贝(函数信息, 寄存器计数, 目标地址48c,
                                             源寄存器48, 字段结构体ID48, 真, 假);
                        }
                    }
                    当 (表达式栈.大小() > 前深度48) {
                        结果<空类型, 整32> 删栈48c = 表达式栈.删除(表达式栈.大小() - 1);
                        如果 (!删栈48c.正常) { 运行时错误(4); }
                    }
                    返回 真;
                }
                如果 (右末48.类型 == 节点_标识符 || 右末48.类型 == 节点_成员 ||
                    右末48.类型 == 节点_三元运算) {
                    整64 目标地址48 = 生成左值地址(池, 整32(n.附加), n.子起点,
                                                   局部槽, 参数槽, 指令,
                                                   寄存器计数, &函数信息.块计数,
                                                   槽计数, 表达式栈);
                    整64 源地址48 = 0;
                    如果 (右末48.类型 == 节点_三元运算) {
                        源地址48 = 生成表达式(池, n.子起点, n.子终点,
                                             局部槽, 参数槽, 指令,
                                             寄存器计数, &函数信息.块计数,
                                             槽计数, 表达式栈);
                    } 否则 {
                        源地址48 = 生成左值地址(池, n.子起点, n.子终点,
                                               局部槽, 参数槽, 指令,
                                               寄存器计数, &函数信息.块计数,
                                               槽计数, 表达式栈);
                    }
                    如果 (目标地址48 != 0 && 源地址48 != 0) {
                        // 79-a：串字段深拷。86-a：preFree 修正为真——目标字段旧串
                        //   是「值语义拥有」（前次整体赋值/深拷的副本），覆盖前必须
                        //   释放（原「非拥有槽不 preFree」保守口径在此泄漏：E243 形五
                        //   v2 残留=1 实证）。未初始化槽的垃圾句柄经 cn_free_tracked
                        //   仅在册释放，空安全（84-f 核验结论）——宁漏勿错不再适用。
                        发射结构体整体拷贝(函数信息, 寄存器计数, 目标地址48,
                                         源地址48, 字段结构体ID48, 真, 真);
                    }
                    当 (表达式栈.大小() > 0) {
                        结果<空类型, 整32> 删栈48 = 表达式栈.删除(表达式栈.大小() - 1);
                        如果 (!删栈48.正常) { 运行时错误(4); }
                    }
                    返回 真;
                }
            }
        }
    }
    返回 假;
}

// 348-a（D11 甲方案·下标左值形态·对齐宿主 indexStructElemAssign）：数组元素 =
//   结构体返回调用 → 源优先序整体写（①先求值源〔可能含条件块〕②再算目标地址
//   〔生成左值地址·纯地址计算〕③整体拷贝〔源=一次性物化槽 → 浅拷接管·深拷=假〕）。
//   原实现落「下标左值写宽度」标量通道（取下标元素宽度码 → 8 字节/2 字节写）——
//   结构体元素只写首字段（探针 p29：`表[1] = 造点(30)` 首字段=返回值地址、余 0）。
//   守卫：左末=下标 ∧ 右值=调用 ∧ 元素类型=**结构体**（类走既有深拷通道）。
不安全 函数 尝试下标结构体整体写(向量<节点> 池, 节点 n, 节点 左末,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    如果 (左末.类型 != 节点_下标 || 左末.子起点 <= 0) {
        返回 假;
    }
    如果 (n.子起点 >= n.子终点) {
        返回 假;
    }
    节点 右末x = 池.元素(整32(n.子终点 - 1));
    // 505-a（T70 B1 二层·右值形态扩全）：原守卫只认 调用 右值——标识符/成员链/
    //   三元/结构体字面量右值全落「下标左值写宽度」标量通道（8 字节 StorePtr）：
    //   ①标识符 `表[0] = p` 只写首 8 字节（y 丢·探针 7/0）②成员链/三元/字面量
    //   更把**源地址当元素值**写入（探针 140733637143672/… 静默错值）——生产态
    //   即暴露（非撤守卫态专属；宿主 emitStructWholeAssign 全形态统一整体写=
    //   参考实现）。扩面后本通道覆盖 生成结构体整体赋值 的右值全集。
    // 768 续（001 波·113 值差单环根治）：**下标链右值形态补全**——「下标左值 =
    //   结构体下标链」（拷贝构造 `值 数组[i] = 其他.值 数组[i]`·泛型 V=符号
    //   32B）原形态表漏 节点_下标 → 本通道 return 假 → 落 8B 宽通道把**源元素
    //   槽地址当值写入**（bb24_18 铁证：写入值=步进 0x20 的地址序列·类型ID
    //   读=0·113 第 11 行值差）。宿主同形态=源/目标 place 地址 4×8B 展开整体
    //   拷（emitStructWholeAssign 32B 展开·hostout.s bb30 实测）——右是地点x
    //   扩 下标链（place 形态）走下方 生成左值地址(源)→IR_结构体拷贝 路径，
    //   Rust `values[i] = other[j]`（V: Copy）memcpy 同构〔基准=019 第 1/4 句〕。
    布尔 右是调用x = 右末x.类型 == 节点_调用;
    布尔 右是地点x = 右末x.类型 == 节点_标识符 || 右末x.类型 == 节点_成员
                  || 右末x.类型 == 节点_下标;
    布尔 右是三元x = 右末x.类型 == 节点_三元运算;
    布尔 右是构造x = 右末x.类型 == 节点_结构体构造;
    如果 (!右是调用x && !右是地点x && !右是三元x && !右是构造x) { 返回 假; }
    整64 元素类型IDx = 推导下标元素类型ID(池, 整32(左末.子起点));
    如果 (元素类型IDx == 0) { 返回 假; }
    字符串 元素文本x = 字符串复制(驻留文本(元素类型IDx));
    // 466-a（T70 面⑥·窄域剥层·仅本通道判定）：元素类型引用后缀 '&'（容器方法
    //   克隆体实参标注形态）——不剥则容器元素误进本通道且查源 miss 误诊；
    //   剥后容器/类元素=返回 假 走下标写宽度通道（复制 展开产物=一次性对象
    //   →指针浅写=接管语义）。
    整64 元素长x = 字符串长度(元素文本x);
    当 (元素长x > 1 && ((整64(元素文本x[整32(元素长x - 1)]) & 255) == 38)) {
        元素文本x = 字符串子串(元素文本x, 0, 整32(元素长x - 1));
        元素长x--;
        元素类型IDx = 驻留(元素文本x);
    }
    // 517-a（甲·对齐宿主）：**类/容器元素放行本通道**——向量内按「内联整对象」
    //   存储（尺寸=类型大小与对齐(元素)=类布局大小·与元素步长同口径）。原排除
    //   （466-a）在「元素步长=类布局大小」实例化下口径不符：元素槽只写 8 字节
    //   句柄、其余 48 字节为相邻零内存 → 消费方读到「伪对象」→ 桶数量=0 →
    //   索引未掩码 → 段错误（/tmp/p517 探针·127 撤守卫态实证）。
    布尔 元素是类x = 是容器类(元素文本x) || 是用户类(元素文本x);
    // 595-a（001-001 双模收敛·根因8）：类/容器元素+调用右值改入本通道——
    //   复制 展开③产物=新堆对象句柄（宿主 genCopyBuiltin ③ 同构·ir_fields
    //   .cpp:668 NewObject+拷贝构造），句柄即对象地址 → 从堆体 IR_结构体拷贝
    //   整块拷入内联元素槽（宿主 emitStructWholeAssign 234-a 分支同语义：
    //   srcAddr=genExpr(复制调用)→CopyStruct 全内容·H8「类元素落 StorePtr
    //   只写 8 字节→元素数据破坏」同型）。原 466-a 排除令本形态落回 8B 通道
    //   浅写句柄进 56B 元素槽=伪对象（stdlib 克隆体 数据[索引]=复制(...) 核心语
    //   句全灭·237/238/240 校验位差实红）。
    // 768 续（001 波·键段 SEGV 根治）：**标量元素排除前置**——「下标左值 =
    //   复制(标量下标链)」（键段 K=整64）的 复制 展开①直通产物=**元素值**
    //   （非地址）→ 8B 宽通道值写=正确语义（宿主 Load/Store 同构）。原标量
    //   排除在调用分支**之后**：统一段整体拷贝把「Load 值」当地址→rep movsb
    //   rsi=1 SEGV（gdb 实证·拷贝构造键段循环 bb24_15）。
    // 768 续（001 波·键段 SEGV 根治）：**标量元素排除前置**——「下标左值 =
    //   复制(标量下标链)」（键段 K=整64）的 复制 展开①直通产物=**元素值**
    //   （非地址）→ 8B 宽通道值写=正确语义（宿主 Load/Store 同构）。原标量
    //   排除在调用分支**之后**：统一段整体拷贝把「Load 值」当地址→rep movsb
    //   rsi=1 SEGV（gdb 实证·拷贝构造键段循环 bb24_15）。
    // 983：非结构体大标量（整128/正128=16 字节）元素也入本通道整体写——
    //   原 `!元素是类x && 查结构体大小==0` 排除令其落 8B StorePtr 宽通道
    //   只写 lo 半（向量<整128> 追加 元素槽 hi 半=垃圾实证）。
    如果 (!元素是类x && 查结构体大小(元素类型IDx) == 0 &&
         类型名宽度(元素类型IDx) <= 8) { 返回 假; }
    如果 (右是调用x) {
        // 760-a：统一「下标左值 = 调用右值」整体写通道——原条件「元素是类x」
        //   在泛型实例克隆体（映射$整64$符号$映射 的值段）因 推导下标元素类型ID
        //   返回未实例化参数文本「V」（元素是类x=假）而 miss→落 8B 标量写
        //   （值数组[0]=地址值·类型ID=0 实锤）→统一按调用右值整体写·尺寸回退
        //   结构体返回临时们（462-a 登记）·标量尺寸=原宽度等价。
        整64 前深度k = 表达式栈.大小();
        整64 源句柄k = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                  指令, 寄存器计数, &函数信息.块计数,
                                  槽计数, 表达式栈);
        当 (表达式栈.大小() > 前深度k) {
            结果<空类型, 整32> 删栈k = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈k.正常) { 运行时错误(4); }
        }
        整64 目标地址k = 生成左值地址(池, 整32(n.附加), n.子起点, 局部槽, 参数槽,
                                      指令, 寄存器计数, &函数信息.块计数,
                                      槽计数, 表达式栈);
        整64 尺寸k = 0;
        整64 对齐k = 0;
        类型大小与对齐(元素文本x, &尺寸k, &对齐k);
        如果 (尺寸k <= 0) {
            结果<整64, 整32> 查临k = 结构体返回临时们.获取(源句柄k);
            如果 (查临k.正常) { 尺寸k = 查结构体大小(查临k.值); }
        }
        如果 (目标地址k != 0 && 源句柄k != 0 && 尺寸k > 0) {
            IR追加(指令, 建IR指令(IR_结构体拷贝, 源句柄k, 目标地址k,
                                 0, 0, 尺寸k, 0));
        }
        返回 真;
    }
    // ===== 505-a：非调用右值（标识符/成员链/下标链/三元/结构体字面量）=====
    //   源地址三形态（对齐 尝试成员结构体整体写 86-a 口径与宿主
    //   emitStructWholeAssign 右值三形态）：
    //     · 标识符/成员链 → 生成左值地址（place 地址·顺序链）
    //     · 三元 → 生成表达式（聚合三元地址透传=选中 place 地址·86-a）
    //     · 结构体字面量 → 生成表达式（84-a 物化临时槽 → 槽地址）
    //   目标地址 = 生成左值地址（与 ① 调用路径同款）；整体拷贝深拷=真
    //   （源保持拥有·元素槽取独立副本）+ 目标元素槽 preFree=真（86-a：槽内旧串
    //   为前次整体赋值/深拷副本=值语义拥有，覆盖前须释放；未初始化槽垃圾句柄
    //   经 cn_free_tracked 仅在册释放=空安全·84-f 核验结论）。
    如果 (!右是调用x) {
        整64 目标地址n = 生成左值地址(池, 整32(n.附加), n.子起点, 局部槽, 参数槽,
                                     指令, 寄存器计数, &函数信息.块计数,
                                     槽计数, 表达式栈);
        整64 源地址x = 0;
        如果 (右是三元x || 右是构造x) {
            源地址x = 生成表达式(池, 整32(n.子起点), 整32(n.子终点),
                                局部槽, 参数槽, 指令, 寄存器计数,
                                &函数信息.块计数, 槽计数, 表达式栈);
        } 否则 如果 (元素是类x) {
            // 595-a（001-001 双模收敛·fix9 根因3 写侧）：类/容器元素+类源
            //   标识符/成员链——源地址=表达式产物句柄（=堆对象地址·宿主
            //   emitStructWholeAssign 类源 Load 槽同款），非 生成左值地址 的
            //   **句柄槽地址**。原取槽地址→IR_结构体拷贝 拷出「句柄+相邻槽
            //   垃圾」56B 伪对象进元素槽（stdlib 追加/设置 克隆体
            //    数据[元素数量] = 值 核心语句全灭·113/221/234/238/240/283
            //   段错误与校验位差实锤）。
            源地址x = 生成表达式(池, 整32(n.子起点), 整32(n.子终点),
                                局部槽, 参数槽, 指令, 寄存器计数,
                                &函数信息.块计数, 槽计数, 表达式栈);
        } 否则 {
            源地址x = 生成左值地址(池, 整32(n.子起点), 整32(n.子终点),
                                  局部槽, 参数槽, 指令, 寄存器计数,
                                  &函数信息.块计数, 槽计数, 表达式栈);
        }
        如果 (目标地址n != 0 && 源地址x != 0) {
            如果 (元素是类x) {
                整64 尺寸x = 0;
                整64 对齐x = 0;
                类型大小与对齐(元素文本x, &尺寸x, &对齐x);
                如果 (尺寸x > 0) {
                    // 194 修②终形态（探针 118k 双向实证收敛）：类/容器元素**统一
                    //   拷贝构造深拷**（NewObject+拷贝构造·元素=独立拥有克隆）——
                    //   容器实例元素句柄直存（②b 尝试）被 118k 出口析构证伪：
                    //   浅拷句柄 → ~容器 析构元素 delete + 源变量析构 delete =
                    //   double free（C0000374·宿主 74-a 元素写入深拷化同构——
                    //   宿主对容器实例元素同样深拷·探针 K 宿主 PASS 铁证）。
                    //   ②初版（容器深拷）链接 miss 是 107 裸名面（修⑤已治），
                    //   1333 面用完整元素类型 ID 无缺符号。
                    //   无拷贝构造类回退 IR_结构体拷贝（698-b 原路）。
                    如果 (!发射类元素拷贝构造写(指令, 寄存器计数, 槽计数, 源地址x,
                                          目标地址n, 元素类型IDx)) {
                        IR追加(指令, 建IR指令(IR_结构体拷贝, 源地址x, 目标地址n,
                                             0, 0, 尺寸x, 0));
                    }
                }
            } 否则 如果 (查结构体大小(元素类型IDx) == 0) {
                // 983（002·57 转批①同族·下标元素槽写）：非结构体大标量
                //   （整128/正128=16 字节）→ IR_结构体拷贝 16 字节整体写
                //   （810 双半语义同构·源=128 位 place 槽地址；发射结构体
                //   整体拷贝 尺寸源=查结构体大小=0 会零拷贝故直发）——原落
                //   8B 宽通道 StorePtr 只写 lo 半（元素 hi 半=相邻槽垃圾·
                //   向量<整128> 追加 实证）。
                IR追加(指令, 建IR指令(IR_结构体拷贝, 源地址x, 目标地址n,
                                     0, 0, 类型名宽度(元素类型IDx), 0));
            } 否则 {
                发射结构体整体拷贝(函数信息, 寄存器计数, 目标地址n, 源地址x,
                                 元素类型IDx, 真, 真);
            }
        }
        当 (表达式栈.大小() > 0) {
            结果<空类型, 整32> 删栈n = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈n.正常) { 运行时错误(4); }
        }
        返回 真;
    }
    // ① 源（可能含块——须在目标地址发射之前）+ 栈纪律（弹到进入深度）
    整64 前深度x = 表达式栈.大小();
    整64 消费x = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽, 指令,
                           寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
    整64 源寄存器x = 0;
    如果 (表达式栈.大小() > 前深度x) {
        源寄存器x = 表达式栈.元素(表达式栈.大小() - 1);
    }
    当 (表达式栈.大小() > 前深度x) {
        结果<空类型, 整32> 删源x = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删源x.正常) { 运行时错误(4); }
    }
    结果<整64, 整32> 查源x = 结构体返回临时们.获取(源寄存器x);
    如果 (消费x == 0 || 源寄存器x == 0 || !查源x.正常) {
        IR层诊断("下标元素赋值右值（调用返回）非结构体返回值: " +
                     驻留文本(整64(n.文本)) + " [宿主=" + 驻留文本(取当前生成符号ID()) +
                     "] 元素=" + 元素文本x + " 查源=" + 整数转字符串(整64(查源x.正常)));
        返回 真;
    }
    // ② 目标地址（纯地址计算）
    整64 目标地址x = 生成左值地址(池, 整32(n.附加), n.子起点, 局部槽, 参数槽, 指令,
                                寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
    如果 (目标地址x != 0) {
        // ③ 整体拷贝（源=一次性物化槽 → 浅拷接管；目标字段串 preFree）
        发射结构体整体拷贝(函数信息, 寄存器计数, 目标地址x, 源寄存器x,
                         元素类型IDx, 真, 假);
    }
    当 (表达式栈.大小() > 前深度x) {
        结果<空类型, 整32> 删栈x = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈x.正常) { 运行时错误(4); }
    }
    返回 真;
}

// 208 病面④（2026-10-06 家机·615 实证·对齐宿主 indexStructElemAssign 守卫放宽）：
//   解引用左值 = 结构体/类/大标量值 → IR_结构体拷贝整体写（`*三字指针 = 三字值`
//   12 字节逐段拷贝·Rust place 拷贝语义〔基准=019〕）——原守卫只认下标左值，
//   解引用左值落标量宽度通道 8 字节只写前半（甲乙 覆盖对·丙 残留旧值·样本
//   p1005_01c）。元素类型=指针变量所指类型（查指针变量类型·266-a 读侧同源
//   判据）；右值四形态=调用/地点（标识符/成员/下标）/三元/结构体构造（505-a
//   口径同款）；类元素=统一拷贝构造深拷（194 修②终形态同款）；大标量
//   （整128/正128=16B）入通道（983 同款）。返回 真=已处理。
不安全 函数 尝试解引用结构体整体写(向量<节点> 池, 节点 n, 节点 左末,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    如果 (左末.类型 != 节点_解引用 || 左末.子起点 <= 0) {
        返回 假;
    }
    如果 (n.子起点 >= n.子终点) {
        返回 假;
    }
    节点 解操作数d = 池.元素(整32(左末.子起点));
    如果 (解操作数d.类型 != 节点_标识符) {
        返回 假;    // 复杂操作数兜底标量通道（与读侧 266-a 对称·存量零分叉面）
    }
    整64 所指型d = 查指针变量类型(整64(解操作数d.文本));
    如果 (所指型d <= 0) {
        返回 假;
    }
    字符串 元素文本d = 字符串复制(驻留文本(所指型d));
    节点 右末d = 池.元素(整32(n.子终点 - 1));
    布尔 右是调用d = 右末d.类型 == 节点_调用;
    布尔 右是地点d = 右末d.类型 == 节点_标识符 || 右末d.类型 == 节点_成员
                  || 右末d.类型 == 节点_下标;
    布尔 右是三元d = 右末d.类型 == 节点_三元运算;
    布尔 右是构造d = 右末d.类型 == 节点_结构体构造;
    如果 (!右是调用d && !右是地点d && !右是三元d && !右是构造d) { 返回 假; }
    布尔 元素是类d = 是容器类(元素文本d) || 是用户类(元素文本d);
    // 标量窄宽排除（<=8B 落存储宽度分派通道·病面① 甲刀处理）
    如果 (!元素是类d && 查结构体大小(所指型d) == 0 &&
         类型名宽度(所指型d) <= 8) { 返回 假; }
    如果 (右是调用d) {
        // 调用右值（对齐 760-a 统一段）：源=生成表达式（retbuf/物化槽）+
        //   尺寸回退 结构体返回临时们 → 整体拷贝
        整64 前深度d = 表达式栈.大小();
        整64 源句柄d = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                  指令, 寄存器计数, &函数信息.块计数,
                                  槽计数, 表达式栈);
        当 (表达式栈.大小() > 前深度d) {
            结果<空类型, 整32> 删栈d = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈d.正常) { 运行时错误(4); }
        }
        整64 目标地址d = 生成左值地址(池, 整32(n.附加), n.子起点, 局部槽, 参数槽,
                                      指令, 寄存器计数, &函数信息.块计数,
                                      槽计数, 表达式栈);
        整64 尺寸d = 0;
        整64 对齐d = 0;
        类型大小与对齐(元素文本d, &尺寸d, &对齐d);
        如果 (尺寸d <= 0) {
            结果<整64, 整32> 查临d = 结构体返回临时们.获取(源句柄d);
            如果 (查临d.正常) { 尺寸d = 查结构体大小(查临d.值); }
        }
        如果 (目标地址d != 0 && 源句柄d != 0 && 尺寸d > 0) {
            IR追加(指令, 建IR指令(IR_结构体拷贝, 源句柄d, 目标地址d,
                                 0, 0, 尺寸d, 0));
        }
        返回 真;
    }
    // 非调用右值（标识符/成员链/下标链/三元/结构体字面量·505-a 源地址三形态）：
    //   三元/构造=生成表达式（物化槽地址）；类元素地点=生成表达式（句柄=对象
    //   地址·595-a 同款）；其余地点=生成左值地址（place 地址）
    整64 目标地址n2 = 生成左值地址(池, 整32(n.附加), n.子起点, 局部槽, 参数槽,
                                 指令, 寄存器计数, &函数信息.块计数,
                                 槽计数, 表达式栈);
    整64 源地址d = 0;
    如果 (右是三元d || 右是构造d) {
        源地址d = 生成表达式(池, 整32(n.子起点), 整32(n.子终点),
                            局部槽, 参数槽, 指令, 寄存器计数,
                            &函数信息.块计数, 槽计数, 表达式栈);
    } 否则 如果 (元素是类d) {
        源地址d = 生成表达式(池, 整32(n.子起点), 整32(n.子终点),
                            局部槽, 参数槽, 指令, 寄存器计数,
                            &函数信息.块计数, 槽计数, 表达式栈);
    } 否则 {
        源地址d = 生成左值地址(池, 整32(n.子起点), 整32(n.子终点),
                              局部槽, 参数槽, 指令, 寄存器计数,
                              &函数信息.块计数, 槽计数, 表达式栈);
    }
    如果 (目标地址n2 != 0 && 源地址d != 0) {
        如果 (元素是类d) {
            整64 尺寸x2 = 0;
            整64 对齐x2 = 0;
            类型大小与对齐(元素文本d, &尺寸x2, &对齐x2);
            如果 (尺寸x2 > 0) {
                // 类元素统一拷贝构造深拷（194 修②终形态·对齐下标通道）——
                //   浅拷句柄=出口双 free（118k 实证域）；无拷贝构造类回退
                //   IR_结构体拷贝（698-b 原路）
                如果 (!发射类元素拷贝构造写(指令, 寄存器计数, 槽计数, 源地址d,
                                      目标地址n2, 所指型d)) {
                    IR追加(指令, 建IR指令(IR_结构体拷贝, 源地址d, 目标地址n2,
                                         0, 0, 尺寸x2, 0));
                }
            }
        } 否则 如果 (查结构体大小(所指型d) == 0) {
            // 983 同款：非结构体大标量（整128/正128=16 字节）整体写
            IR追加(指令, 建IR指令(IR_结构体拷贝, 源地址d, 目标地址n2,
                                 0, 0, 类型名宽度(所指型d), 0));
        } 否则 {
            发射结构体整体拷贝(函数信息, 寄存器计数, 目标地址n2, 源地址d,
                             所指型d, 真, 真);
        }
    }
    当 (表达式栈.大小() > 0) {
        结果<空类型, 整32> 删栈n3 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈n3.正常) { 运行时错误(4); }
    }
    返回 真;
}

// 成员字符串字段写入归一化发射面（172-a 自 生成成员解引用赋值 机械搬移；
//   172-a 前为 生成赋值语句 662~723 段；79-a/87-a 族）——返回写回后的值
//   寄存器（借用来源经 __cn_str_copy 落堆时换用 copy 寄存器）。
不安全 函数 发射成员串字段写入(向量<节点> 池, 节点 n, 节点 左末, 整64 地址寄存器,
                  整64 值寄存器, 函数IR& 函数信息, 向量<IR指令>& 指令,
                  整64* 寄存器计数) -> 整64 {
    如果 (地址寄存器 != 0 && 值寄存器 != 0 && 左末.类型 == 节点_成员) {
        整64 父链IDw = 解析成员链结构体ID(池, 整32(左末.子起点));
        如果 (父链IDw != 0) {
            整64 字段类型IDw = 查字段类型ID(父链IDw, 整64(左末.文本));
            如果 (字段类型IDw != 0 && 字符串比较(驻留文本(字段类型IDw), "字符串")) {
                节点 右末w = 池.元素(n.子终点 - 1);
                布尔 需复制 = 真;
                如果 (右末w.类型 == 节点_字符串字面量) { 需复制 = 假; }
                否则 如果 (右末w.类型 == 节点_调用 && 右末w.子起点 > 0) {
                    节点 被调w = 池.元素(整32(右末w.子起点));
                    如果 (被调w.类型 == 节点_标识符) {
                        整64 被调名w = 整64(被调w.文本);
                        布尔 白名单w = 被调名w == 驻留("字符串复制") ||
                                      被调名w == 驻留("字符串连接") ||
                                      被调名w == 驻留("字符串拼接") ||
                                      被调名w == 驻留("字符串子串") ||
                                      被调名w == 驻留("字符串大写") ||
                                      被调名w == 驻留("字符串小写") ||
                                      被调名w == 驻留("字符串修剪") ||
                                      被调名w == 驻留("字符串反转");
                        如果 (!白名单w && 查函数返回回退(被调名w) == 驻留("字符串")) {
                            白名单w = 真;   // A2 契约：签名即契约
                        }
                        需复制 = !白名单w;
                    }
                }
                如果 (需复制) {
                    值寄存器 = 发射字符串复制调用(指令, 寄存器计数, 值寄存器);
                }
                如果 (左末.子起点 > 0) {
                    节点 对象w = 池.元素(整32(左末.子起点));
                    布尔 是拥有字段槽w = 假;
                    如果 (对象w.类型 == 节点_标识符) {
                        是拥有字段槽w = 在资源字段名单(函数信息, 整64(对象w.文本));
                        // 87-a（2026-09-12 第八十七轮）：顶层静态结构体的字段槽
                        //   ——槽长期存活**恒拥有**（局部按块出口 drop；静态无出口，
                        //   重复赋值必须当场 drop 旧串，否则每次赋值泄漏）。原判据
                        //   仅「父∈资源字段名单」——静态名不在名单 → 不释放（探针
                        //   s9-v2 实证：循环 300 次赋值残留 +600）。
                        如果 (!是拥有字段槽w) {
                            整64 找静w = 查静态序号含类(整64(对象w.文本));
                            如果 (找静w >= 0 && 查结构体大小(取静态类型(找静w)) > 0) {
                                是拥有字段槽w = 真;
                            }
                        }
                    }
                    如果 (是拥有字段槽w) {
                        整64 旧regw = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_指针加载, 地址寄存器, 0, 0, 旧regw, T_字符串, 0));
                        IR追加(指令, 建IR指令(IR_调用实参, 旧regw, 0, 0, 0, 0, 0));
                        IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                             驻留("__cn_str_free")));
                        如果 (函数信息.零寄存器 != 0) {
                            IR追加(指令, 建IR指令(IR_指针存储, 地址寄存器,
                                         函数信息.零寄存器, 0, 0, T_整64, 0));
                        }
                    }
                }
            }
        }
    }
    返回 值寄存器;
}

// 698-b〔基准=019〕：类/容器元素槽写入=**拷贝构造深拷**（宿主 emitStructWholeAssign
//   类源 NewObject+拷贝构造/追加 asm rcx=元素槽 rdx=&值 call 拷贝构造·7178 实证同款）
//   ——原 IR_结构体拷贝 56B 浅字节拷共享指针字段（桶数组/键数组/链数组）→源 RAII
//   析构后元素槽悬垂（698-a 铁证：压入 的 层 析构 free 桶数组→元素0 桶数组=悬垂块
//   →拷贝构造读 BAADF00D→链查找 READ at -1 段错误）。装配：句柄槽 ← 源壳地址·
//   拷贝构造(自身=元素槽·其他=&句柄槽)——自身=内联接收一跳写、其他=T& 句柄两跳
//   （698-a 定案契约）。元素类无拷贝构造（查类构造参数串 miss=纯数据类）→返回 假
//   调用方回退 IR_结构体拷贝（POD 浅拷语义安全）。
//   边界（诚实边界）：覆盖写场景元素槽旧值无 preFree（追加 末尾写=新槽无旧值·
//   覆盖写场景由 86-a 串 preFree 通道自理）——旧容器元素泄漏面登记 025 §1.9。
不安全 函数 发射类元素拷贝构造写(向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数,
                              整64 源地址reg, 整64 目标地址reg, 整64 元素类型IDx) -> 布尔 {
    整64 拷贝串IDw = 查类拷贝构造串(元素类型IDx);
    如果 (拷贝串IDw == 0) { 返回 假; }
    // 194 修②终形态注记：容器实例元素**同样深拷**（118k 出口析构 double free
    //   实证句柄直存不可行·宿主 74-a 同构）——早期「容器排除」收窄已撤（当时
    //   链接 miss 系 107 裸名面·修⑤治于 生成表达式求值，与本函数无关）。
    字符串 元素文本w = 字符串复制(驻留文本(元素类型IDx));
    // 221 r32 修⑱【容器实例=内联深拷·模型对齐裁决】：宿主 asm 对拍（hostv5
    //   ~向量$映射 步进 56+this=槽地址）+001 §5.3「容器按元素真实大小分配」
    //   立法=容器实例元素**内联存储**——拷贝构造**直接构造进槽**（this=目标
    //   槽地址·调用方已按元素宽度步进），零 NewObject=少一次堆分配（性能优·
    //   Rust Vec<T> 内联同构）。修② 句柄三步（NewObject+句柄入槽）与析构链
    //   注入（生成类.cn·步长=类型大小与对齐=实宽+this=槽地址）存储模型混一=
    //   v5/118/j2/79_v2 堆破坏真刀口（~映射(this=句柄槽地址)→free([槽])=free
    //   句柄值→对象块早free→出口 delete=double free·C374）。修⑰ 同轮回滚
    //   （容器实例宽度=容器对象大小）。修② 当时「宿主 74-a 同构」系误读：
    //   宿主深拷=内联内容进槽（拷构造 this=槽地址），非 NewObject 句柄。
    //   用户类元素=句柄三步保留（下方·宿主 058-ⅡA 同款分型·修⑮ 口径）。
    // 194 修⑯（221 r11）：用户类元素=堆对象句柄——值表槽=8B 句柄槽（类型名
    //   宽度 用户类=8·修⑮ 配套·宿主同款）→ 深拷三步（NewObject+句柄入槽+
    //   拷构造 this=新·其他=&源句柄槽）。元素类无拷贝构造→回退 IR_结构体拷贝。
    如果 (是容器类(元素文本w)) {
        整64 源句柄槽n = 槽计数[0];
        槽计数[0] = 槽计数[0] + 1;
        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 源句柄槽n));
        IR追加(指令, 建IR指令(IR_存储, 源地址reg, 0, 0, 0, 0, 源句柄槽n));
        整64 源地址regn = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_取地址, 源句柄槽n, 0, 0, 源地址regn, T_整64, 0));
        IR追加(指令, 建IR指令(IR_调用实参, 目标地址reg, 0, 0, 0, 0, 0));
        IR追加(指令, 建IR指令(IR_调用实参, 源地址regn, 0, 0, 0, 1, 0));
        IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                             驻留(方法符号(元素文本w, 合成名基名(元素文本w),
                                    元素文本w + "&"))));
        返回 真;
    }
    整64 新objw = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新objw,
                         查结构体大小(元素类型IDx), 元素类型IDx));
    IR追加(指令, 建IR指令(IR_指针存储, 目标地址reg, 新objw, 0, 0, T_整64, 0));
    整64 源句柄槽w = 槽计数[0];
    槽计数[0] = 槽计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 源句柄槽w));
    IR追加(指令, 建IR指令(IR_存储, 源地址reg, 0, 0, 0, 0, 源句柄槽w));
    整64 源地址regw = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_取地址, 源句柄槽w, 0, 0, 源地址regw, T_整64, 0));
    IR追加(指令, 建IR指令(IR_调用实参, 新objw, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用实参, 源地址regw, 0, 0, 0, 1, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                         驻留(方法符号(元素文本w, 合成名基名(元素文本w),
                                元素文本w + "&"))));
    返回 真;
}
