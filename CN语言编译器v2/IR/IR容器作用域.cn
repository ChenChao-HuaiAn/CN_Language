// IR容器作用域（1415 拆分·自 IR容器释放.cn 机械搬移 + 终止块名单截断新增）
// 1415（#1415 P1·先拆再加）：IR容器释放.cn 已 993 行（近 1000 硬线），本文件
//   按「作用域析构族」拆出——块出口析构（594-700）/循环跳出析构（702-711）/
//   发射数组串释放全部（713-723）/预扫容器声明与容器字符串两族（737-900）
//   函数体逐字保留；新增 块出口名单截断（终止块出口只截断释放名单不发射代码
//   ——1415 根修，见函数头注）。**搬移随带两处等价收紧**（非逐字，如实登记）：
//   ① 块出口析构 字符串槽 miss 分支原 `否则 { 串槽 = 0; }` 删除（串槽入口已
//   初始化为 0，等价）；② 预扫字符串槽判定 初末s.子起点 判定加池索引上界
//   （单边开区间禁令·`起s64 >= 0 && 起s64 < 池.大小()` 双边界，语义等价：
//   子起点是池索引必在界内）。
// 依赖：发射资源字段析构/发射数组串元素释放/发射盒类值载荷摘删/发射容器元素释放
//   仍居 IR容器释放.cn（本模块之后于包声明中加载=依赖先解析）；函数级类型权威表/
//   名单访问经 协议常量 与 IR 生成符号全局池解析。
导入 容器::向量;
导入 映射集合;
导入 IR;         // 签名辅助 + 节点_*/T_*/IR_*/键位移/当前函数变量类型（原 IR签名+IR常量 合并目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:

不安全 函数 块出口析构(函数IR& 函数信息, 映射<整64, 整64>& 局部槽, 整64* 寄存器计数,
                整64 作用域基线, 整64 字段基线, 整64 字符串基线,
                整64 数组串基线, 布尔 截断) -> 空类型 {
    整64 串i = 函数信息.字符串变量们.大小();
    当 (串i > 字符串基线) {
        串i--;
        整64 串名ID = 函数信息.字符串变量们.元素(串i);
        结果<整64, 整32> 查污出 = 函数信息.字符串污染们.获取(串名ID);
        如果 (!查污出.正常 && !是已装箱名(串名ID)) {   // 71-a：装箱=move 转交跳过
            整64 串槽 = 0;
            结果<整64, 整32> 找串槽 = 局部槽.获取(串名ID);
            如果 (找串槽.正常) { 串槽 = 找串槽.值; } 否则 { }   // miss=保持入口 0（空安全）
            如果 (串槽 != 0) {
                整64 串ptr = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(函数信息.指令, 建IR指令(IR_加载, 串槽, 0, 0, 串ptr, T_字符串, 0));
                IR追加(函数信息.指令, 建IR指令(IR_调用实参, 串ptr, 0, 0, 0, 0, 0));
                IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                     驻留("__cn_str_free")));
                // 73-a（幂等模型，宿主 72-a 同款）：释放后槽清零——块出口/跳出/
                //   函数级兜底多路径共享槽，清零后 __cn_str_free(nullptr) 空安全，
                //   重复经过的释放点不再二次释放（探针：容器跳出形态未清零时
                //   跳出释放 + 函数级兜底 = double free SIGSEGV 实证）
                如果 (函数信息.零寄存器 != 0) {
                    IR追加(函数信息.指令, 建IR指令(IR_存储, 函数信息.零寄存器, 0, 0,
                                         0, 0, 串槽));
                }
            }
        }
        如果 (截断) {
            结果<空类型, 整32> 删串 = 函数信息.字符串变量们.删除(
                函数信息.字符串变量们.大小() - 1);
            如果 (!删串.正常) { 运行时错误(4); }
        }
    }
    整64 容i = 函数信息.容器变量们.大小();
    当 (容i > 作用域基线) {
        容i--;
        整64 名ID = 函数信息.容器变量们.元素(容i);
        整64 槽 = 0;
        结果<整64, 整32> 找槽 = 局部槽.获取(名ID);
        如果 (找槽.正常) { 槽 = 找槽.值; } 否则 { }
        如果 (槽 != 0 && !是已装箱名(名ID)) {   // 71-a：装箱=move 转交跳过
            结果<整64, 整32> 查类型 = 函数信息.变量类型.获取(名ID);
            如果 (查类型.正常) {
                // 956（红治理·543 族根因）：盒命中只跳过正常路径——名单删除
                //   由循环尾「截断删容」统一执行（原双删：命中分支删末位+循环
                //   尾再删=删(-1) 越界→.正常=假→运行时错误(4)·m543b 定音）。
                如果 (!发射盒类值载荷摘删(函数信息, 寄存器计数, 槽, 查类型.值)) {
                整64 ptr寄存器 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(函数信息.指令, 建IR指令(IR_加载, 槽, 0, 0, ptr寄存器, T_对象, 0));
                // 74-a（2026-09-11 第七十四轮）：容器元素串释放——容器拥有元素
                //   所有权（入容器位编译器接管），析构前逐元素释放（宿主
                //   emitContainerElemFreeFor 同款；原 v2 无此机制=容器元素串
                //   永不释放，探针 74-G 实证残留 2）。释放后元素槽清零在运行时
                //   辅助内完成（幂等不变量，与宿主共享同一运行时）。顺序=先元素
                //   后对象（宿主同序：元素数组先释放，再 DeleteObject 释放容器）。
                发射容器元素释放(函数信息, 寄存器计数, ptr寄存器, 查类型.值);
                IR追加(函数信息.指令, 建IR指令(IR_删除对象, ptr寄存器, 0, 0,
                                                     寄存器计数[0], 0, 查类型.值));
                寄存器计数[0] = 寄存器计数[0] + 1;
                // 73-a（幂等模型）：释放后槽清零（IR_删除对象 空安全——
                //   代码生成 test/je 跳过；多释放点共享槽不再二次释放）
                如果 (函数信息.零寄存器 != 0) {
                    IR追加(函数信息.指令, 建IR指令(IR_存储, 函数信息.零寄存器, 0, 0,
                                         0, 0, 槽));
                }
                }   // 956：否则闭合
            } 否则 { }   // 查类型 miss=跳过该元素（无类型信息，交给既有兜底）
        }
        如果 (截断) {
            结果<空类型, 整32> 删容 = 函数信息.容器变量们.删除(
                函数信息.容器变量们.大小() - 1);
            如果 (!删容.正常) { 运行时错误(4); }
        }
    }
    // 98-a（C9）：字符串元素数组——逐元素释放（逆序，与容器/字符串名单同序纪律）
    如果 (函数信息.字符串数组变量们.大小() > 数组串基线) {
        整64 数组i98 = 函数信息.字符串数组变量们.大小();
        当 (数组i98 > 数组串基线) {
            数组i98--;
            发射数组串元素释放(函数信息, 局部槽, 寄存器计数,
                              函数信息.字符串数组变量们.元素(数组i98));
            如果 (截断) {
                结果<空类型, 整32> 删数组98 = 函数信息.字符串数组变量们.删除(
                    函数信息.字符串数组变量们.大小() - 1);
                如果 (!删数组98.正常) { 运行时错误(4); }
            }
        }
    }
    如果 (函数信息.资源字段局部们.大小() > 字段基线) {
        发射资源字段析构(函数信息, 局部槽, 寄存器计数, 字段基线,
                          函数信息.资源字段局部们.大小(), 0);
        // 截断两条跟踪列表至基线（跳出模式不截断——同块其他路径仍须发射释放）
        如果 (截断) {
            当 (函数信息.资源字段局部们.大小() > 字段基线) {
                结果<空类型, 整32> 删局 = 函数信息.资源字段局部们.删除(
                    函数信息.资源字段局部们.大小() - 1);
                如果 (!删局.正常) { 运行时错误(4); }
                结果<空类型, 整32> 删构 = 函数信息.资源字段结构体们.删除(
                    函数信息.资源字段结构体们.大小() - 1);
                如果 (!删构.正常) { 运行时错误(4); }
            }
        }
    }
}

// 1415（#1415 P1·用户令「终止块出口只截断释放名单（不发射代码）」的系统性修法）：
//   **终止块出口名单截断**——块以 返回/中断/继续 终止时，控制流已跳出本块，
//   出口析构代码不可达（生成块 旧行为跳过释放且**不截断名单**）。名单是编译期
//   状态、跨块共享：残留条目会把「本块声明（可能未执行/已在本块返回路径释放）」
//   带入外层/后续返回路径的资源析构（容器变量们/字符串变量们/数组串名单/
//   资源字段局部们），运行期读到栈残值即 释放垃圾/堆损坏（t_class 实测
//   C0000374/退出码 127：条件块内类对象局部声明、块以返回终止，另一路径返回
//   按名单再次析构）。终止语句自身已发射**全量**析构（返回=发射容器析构+串释放+
//   数组串全量+资源字段全量；中断/继续=循环跳出析构覆盖循环基线至当前名单），
//   故此处只需把名单截断回块基线的编译期状态，**不发射任何指令**——一刀覆盖
//   结构体/类/数组/结果族，零运行期税（对比「任意聚合局部入口零初始化」需
//   逐局部/逐槽发射代码，且仍保留名单残留的类型错配面）。
//   截断序与 块出口析构 的循环尾逆序删除同规（字符串→容器→数组串→资源字段
//   两表成对）；不发射故无槽访问，未执行声明路径的残值自此无人触碰（安全）。
不安全 函数 块出口名单截断(函数IR& 函数信息, 整64 作用域基线, 整64 字段基线,
                    整64 字符串基线, 整64 数组串基线) -> 空类型 {
    当 (函数信息.字符串变量们.大小() > 字符串基线) {
        结果<空类型, 整32> 删串 = 函数信息.字符串变量们.删除(
            函数信息.字符串变量们.大小() - 1);
        如果 (!删串.正常) { 运行时错误(4); }
    }
    当 (函数信息.容器变量们.大小() > 作用域基线) {
        结果<空类型, 整32> 删容 = 函数信息.容器变量们.删除(
            函数信息.容器变量们.大小() - 1);
        如果 (!删容.正常) { 运行时错误(4); }
    }
    当 (函数信息.字符串数组变量们.大小() > 数组串基线) {
        结果<空类型, 整32> 删数组 = 函数信息.字符串数组变量们.删除(
            函数信息.字符串数组变量们.大小() - 1);
        如果 (!删数组.正常) { 运行时错误(4); }
    }
    当 (函数信息.资源字段局部们.大小() > 字段基线) {
        结果<空类型, 整32> 删局 = 函数信息.资源字段局部们.删除(
            函数信息.资源字段局部们.大小() - 1);
        如果 (!删局.正常) { 运行时错误(4); }
        结果<空类型, 整32> 删构 = 函数信息.资源字段结构体们.删除(
            函数信息.资源字段结构体们.大小() - 1);
        如果 (!删构.正常) { 运行时错误(4); }
    }
}

// 73-a（2026-09-11 方案A 用户裁决）：循环跳出（中断/继续）drop-on-jump——
//   按最近循环体的三个基线（生成当 进入体块前记录）释放本轮已声明资源，
//   编译期名单**不截断**。与宿主 72-a genJumpDestructFrom(stringBase, classBase)
//   同构（Rust：break/continue 前 drop 当前作用域内已初始化值）。
不安全 函数 循环跳出析构(函数IR& 函数信息, 映射<整64, 整64>& 局部槽,
                  整64* 寄存器计数) -> 空类型 {
    块出口析构(函数信息, 局部槽, 寄存器计数,
               函数信息.循环容基线, 函数信息.循环字段基线, 函数信息.循环串基线,
               函数信息.循环数组串基线, 假);
}

// 98-a（C9）：字符串元素数组**全量**释放（函数返回路径——与 发射字符串释放
//   名 0=全释放 同款纪律：遍历全部名单逆序逐元素释放）
不安全 函数 发射数组串释放全部(函数IR& 函数信息, 映射<整64, 整64>& 局部槽,
                        整64* 寄存器计数) -> 空类型 {
    整64 序98 = 函数信息.字符串数组变量们.大小();
    当 (序98 > 0) {
        序98--;
        发射数组串元素释放(函数信息, 局部槽, 寄存器计数,
                          函数信息.字符串数组变量们.元素(序98));
    }
}

// 预扫容器声明：函数体块区间一次线性扫描（嵌套块/条件体语句节点均含于函数体块
//   子区间——节点池顺序追加，体块节点最后入池），为全部容器变量：分配槽 +
//   入口零初始化（未执行声明路径的槽=确定性空指针，DeleteObject 空安全跳过）+
//   登记 变量类型/容器变量们。注：同名变量（不同块）合并同槽（v2 局部槽为
//   函数级映射——精确块级作用域析构留 P7c）。
不安全 函数 预扫容器声明(向量<节点> 池, 整32 块节点, 函数IR& 函数信息,
                  整64* 槽计数, 整64* 寄存器计数) -> 空类型 {
    整64 零寄存器 = 0;
    节点 块 = 池.元素(块节点);
    整64 i = 整64(块.子起点);
    当 (i < 整64(块.子终点)) {
        节点 声明 = 池.元素(整32(i));
        如果 (声明.类型 == 节点_变量声明) {
            节点 类型节点 = 池.元素(整32(声明.附加));
            字符串 类型文本 = 字符串复制(驻留文本(整64(类型节点.文本)));
            // 1181（P0）：推断声明（类型文本=空串哨兵·46-c 通道）预扫回填——查
            //   推断声明类型表取推导类型后再判容器。原缺=是容器类("")=假→槽不预
            //   分配→句柄不入槽→消费位 this 加载落 0-名ID→992 守卫中止（c1181
            //   探针实录）。回填仅本预扫窗口生效（类型节点=池.元素 值拷贝）；生成
            //   期 生成容器局部 自己再查表回填（272 遮蔽覆盖序·既有通道不变）。
            如果 (字符串长度(类型文本) == 0) {
                结果<整64, 整32> 推断查1181 = 查推断声明类型(整64(声明.文本));
                如果 (推断查1181.正常) {
                    整64 推断ID1181 = 推断查1181.值;
                    类型文本 = 字符串复制(驻留文本(推断ID1181));
                    类型节点.文本 = 整32(推断ID1181);
                }
            }
            // 引用局部（2026-09-04 IR生成.cn 冒烟根治）：绑定不拥有——槽分配/
            //   绑定存储/引用槽登记由 生成语句 引用分支自管；此处若入 RAII 名单
            //   =返回前对绑定对象（字段地址当 this）双重析构（E2E 147 探针
            //   0xC0000374 堆损坏实证）。
            // 213-a（2026-09-15 第两百一十三轮，D1 行数整改）：容器/字符串两分支
            //   槽预分配+入口零初始化 迁 预扫容器槽分配/预扫字符串槽判定与分配——
            //   零寄存器 跨分支共享（整64& 引用输出·首个分配者发射常量）。
            预扫容器槽分配(声明, 类型节点, 类型文本, 函数信息, 槽计数, 寄存器计数, 零寄存器);
            预扫字符串槽判定与分配(池, 声明, 类型节点, 函数信息, 槽计数, 寄存器计数, 零寄存器);
            预扫结果槽判定与分配(声明, 类型节点, 类型文本, 函数信息, 槽计数, 寄存器计数, 零寄存器);
        }
        i++;
    }
    // 73-a：零寄存器回填——释放点清零槽复用（指令已在函数入口发射，运行期
    //   任何释放点路径均已执行过它）；无资源声明时保持 0（无释放点，无需清零）
    函数信息.零寄存器 = 零寄存器;
}


// 213-a：族① 容器槽预分配——槽分配+入口零初始化（共享零寄存器）+类型登记
//   （引用局部附加==256 不入——绑定不拥有，E2E 147 双重析构根治）；73-a 名单登记
//   移至生成期（预扫登记会使块出口基线机制失效）。
不安全 函数 预扫容器槽分配(节点 声明, 节点 类型节点, 字符串 类型文本, 函数IR& 函数信息,
                    整64* 槽计数, 整64* 寄存器计数, 整64& 零寄存器) -> 空类型 {
    // 416（002 收口·579）：容器数组（向量$整32[3]·是容器类 基名判定不剥 [N]
    //   后缀误真）不入容器预扫——落 数组局部 通道（94-a 指针表登记+下标全链；
    //   与 生成声明.cn 容器分支 !是数组类型文本 守卫同族配对）
    如果 (是容器类(类型文本) && !是数组类型文本(类型文本) && 类型节点.附加 != 256) {
                结果<整64, 整32> 已有 = 函数信息.局部槽.获取(整64(声明.文本));
                如果 (!已有.正常) {
                    整64 槽 = 槽计数[0];
                    槽计数[0] = 槽计数[0] + 1;
                    结果<空类型, 整32> 设槽 = 函数信息.局部槽.设置(整64(声明.文本), 槽);
                    如果 (!设槽.正常) { 运行时错误(4); }
                    IR追加(函数信息.指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽));
                    // 入口零初始化（共享一个零寄存器）
                    如果 (零寄存器 == 0) {
                        零寄存器 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(函数信息.指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0,
                                             零寄存器, T_整64, 0));
                    }
                    IR追加(函数信息.指令, 建IR指令(IR_存储, 零寄存器, 0, 0, 0, 0, 槽));
                    结果<空类型, 整32> 设类型 = 函数信息.变量类型.设置(整64(声明.文本),
                                                              整64(类型节点.文本));
                    如果 (!设类型.正常) { 运行时错误(4); }
                    // ②c D：函数级变量类型权威表（跨函数同名异型根治）
                    登记当前函数变量类型(整64(声明.文本), 整64(类型节点.文本));
                    // 2026-09-06 根治（宿主对齐·视图语义）：初值末节点=调用且非构造
                    //   调用（返回接收）→ 不入 RAII 名单。宿主实证（vieww/retown 探针
                    //   asm）：接收 rax 直用——元素(i) 返回向量内联元素地址（视图共享
                    //   写可见）、函数返回新对象（转移）——接收方一律不析构；原「接收
                    //   转移=本槽拥有」假设对元素(i) 形态=对向量内部元素 DeleteObject
                    //   →double free/堆坏（vcopy 探针 SIGSEGV 实证=v2self 符号表崩溃
                    //   同根因）。槽保留（读取/传参用，出口零值空安全）。
                    // 73-a（2026-09-11 方案A 用户裁决）：**名单登记移至生成期**——
                    //   预扫是函数级一次性扫描、先于函数体生成，若在预扫登记则 生成块
                    //   入口取基线时名单已含本块变量、基线恒等于名单大小，块出口析构
                    //   永远无新增项可释放=v2 块级 RAII 从未生效（探针 89：20 万轮
                    //   循环体拥有串残留 199999 实证）。预扫职责自此收敛为槽分配 +
                    //   入口零初始化 + 类型登记；释放名单随生成顺序追加（生成容器
                    //   局部 非返回接收分支），基线机制方能生效（Rust 作用域 drop）。
                }
            }
}

// 213-a：族② 拥有型字符串局部槽判定与预分配——白名单八函数∪返回类型契约（A2）
//   判定拥有初值；下标/成员/解引用=借用不登记（保守宁漏勿错）；引用形态不入；
//   槽预分配+入口零初始化（未执行声明路径槽=确定性 0，__cn_str_free 空安全）。
//   748（2026-10-14·零分叉）：内建裸名返回拥有串（整数转字符串/浮点转字符串/
//   字符转字符串 等）经 查函数返回回退 内置兜底命中「返回 字符串」——初始化位
//   拥有初值判定自此覆盖内建裸名族（原 miss=借用=每处净漏 1）。
不安全 函数 预扫字符串槽判定与分配(向量<节点> 池, 节点 声明, 节点 类型节点, 函数IR& 函数信息,
                          整64* 槽计数, 整64* 寄存器计数, 整64& 零寄存器) -> 空类型 {
    如果 (整64(类型节点.文本) == 驻留("字符串") && 类型节点.附加 != 256) {
                结果<整64, 整32> 已有串 = 函数信息.局部槽.获取(整64(声明.文本));
                如果 (!已有串.正常) {
                    布尔 拥有初值 = 真;
                    如果 (声明.子起点 < 声明.子终点) {
                        节点 初末s = 池.元素(声明.子终点 - 1);
                        如果 (初末s.类型 == 节点_调用) {
                            // 调用初值：白名单八函数 ∪ 返回类型契约（A2 2026-09-11
                            //   方案甲）：被调者返回 字符串=拥有（内置表/签名表按纯名
                            //   查——重载族返回异型为诚实边界，对齐宿主首候选口径）；
                            //   驻留文本 已改 字符* 返回=借用不登记。
                            布尔 是白名单 = 假;
                            整64 起s64 = 整64(初末s.子起点);
                            如果 (起s64 >= 0 && 起s64 < 整64(池.大小())) {
                                节点 被调s = 池.元素(整32(初末s.子起点));
                                如果 (被调s.类型 == 节点_标识符) {
                                    整64 被调名s = 整64(被调s.文本);
                                    是白名单 = 被调名s == 驻留("字符串复制") ||
                                         被调名s == 驻留("字符串连接") ||
                                         被调名s == 驻留("字符串拼接") ||
                                         被调名s == 驻留("字符串子串") ||
                                         被调名s == 驻留("字符串大写") ||
                                         被调名s == 驻留("字符串小写") ||
                                         被调名s == 驻留("字符串修剪") ||
                                         被调名s == 驻留("字符串反转");
                                            如果 (!是白名单) {
                                        // 72-a（2026-09-11 第七十二轮）：键基回退版
                                        //   （纯名查跨模块 miss=契约失效，宿主同族根治）
                                        可选<整64> 查返s查 = 查函数返回回退(被调名s);
                                        如果 (查返s查.有值) {
                                            整64 查返s值 = 查返s查.值;
                                            如果 (查返s值 == 驻留("字符串")) { 是白名单 = 真; }
                                        }
                                    }
                                }
                            }
                            拥有初值 = 是白名单;
                        } 否则 如果 (初末s.类型 == 节点_下标 ||
                                    初末s.类型 == 节点_成员 ||
                                    初末s.类型 == 节点_解引用) {
                            // 下标/成员/解引用初值=借用（元素借出/字段视图/指针指向）
                            //   ——宿主初始化位此形态未污染（潜在缺口，v2 侧保守不登记）
                            拥有初值 = 假;
                        }
                    }
                    如果 (拥有初值) {
                        整64 槽s = 槽计数[0];
                        槽计数[0] = 槽计数[0] + 1;
                        结果<空类型, 整32> 设槽s = 函数信息.局部槽.设置(整64(声明.文本), 槽s);
                        如果 (!设槽s.正常) { 运行时错误(4); }
                        IR追加(函数信息.指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽s));
                        // 入口零初始化（与容器共用 零寄存器）
                        如果 (零寄存器 == 0) {
                            零寄存器 = 寄存器计数[0];
                            寄存器计数[0] = 寄存器计数[0] + 1;
                            IR追加(函数信息.指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0,
                                                 零寄存器, T_整64, 0));
                        }
                        IR追加(函数信息.指令, 建IR指令(IR_存储, 零寄存器, 0, 0, 0, 0, 槽s));
                        // 73-a（2026-09-11 方案A 用户裁决）：名单登记移至生成期
                        //   （生成变量声明 拥有化初始化后）——预扫登记会使 生成块
                        //   基线机制失效（详见 预扫容器声明 头部说明）
                    }
                }
            }
}
