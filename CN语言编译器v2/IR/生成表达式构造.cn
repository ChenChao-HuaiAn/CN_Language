// CN 自举编译器 v2 · IR 生成表达式构造——结构体字面量构造族（84-a 机制主体）
//   （1036 拆分：自 生成表达式求值尾.cn 机械搬移——原文件贴 1000 冻结线，
//   先拆再加纪律；纯重构零行为变更，函数体逐字保留）。消费方：生成表达式中.cn
//   结构体字面量形态——同包经合并全局池解析。声明序：包.cn 置于 生成表达式
//   求值尾 之后、生成表达式 之前（消费方其后加载）。

导入 容器::向量;
导入 映射集合;
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码 + IR常量 键位移（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 IR生成;     // 函数级变量类型权威表/重载决议/控制流辅助（同包幂等）

公开:

// ==================== 84-a：结构体字面量作实参（生成） ====================
// 机制主体 = 临时槽（生成期槽计数递增 + 逐槽 IR_分配 + 基址槽=槽起+槽数-1，82-a 槽分配
//   纪律四条）+ 零初始化 + 逐字段写（值区间 生成表达式 求值 → 字段地址 + 指针存储
//   （宽度=查字段宽度码））；槽地址压栈 + 登记 结构体返回临时们（**实参位置**由 82-a
//   清理调用实参临时 在外层调用发射后释放串字段——零新清理机制）。
// 依赖不变量 = ①基址槽=最大槽号=最低地址（②b B1）；②逐槽 IR_分配（扫描函数 帧尺寸）
//   ③零初始化先于字段写（未赋值字段=0 空安全；字符串字段缺值不悬垂）。
不安全 函数 生成结构体构造(向量<节点> 池, 节点 n, 映射<整64, 整64>& 局部槽,
                    映射<整64, 整64>& 参数槽, 向量<IR指令>& 指令, 整64* 寄存器计数,
                    整64* 块计数, 整64* 槽计数, 向量<整64>& 表达式栈) -> 空类型 {
    整64 结构体IDc = 整64(n.文本);
    整64 大小c = 查结构体大小(结构体IDc);
    如果 (大小c <= 0) {
        IR层诊断("结构体构造字面量: 类型未知 " + 驻留文本(结构体IDc));
        返回;
    }
    整64 槽数c = (大小c + 7) / 8;
    整64 槽起c = 槽计数[0];
    槽计数[0] = 槽计数[0] + 槽数c;
    整64 zc = 0;
    当 (zc < 槽数c) {
        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽起c + zc));
        zc++;
    }
    整64 基槽c = 槽起c + 槽数c - 1;
    整64 基址regc = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_取地址, 基槽c, 0, 0, 基址regc, T_整64, 0));
    整64 零regc = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零regc, T_整64, 0));
    整64 清c = 0;
    当 (清c < 大小c) {
        整64 清地址 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_字段地址, 基址regc, 0, 0, 清地址, T_整64, 清c));
        IR追加(指令, 建IR指令(IR_指针存储, 清地址, 零regc, 0, 0, T_整64, 0));
        清c = 清c + 8;
    }
    // 84-c：**跳过嵌套构造区间**——嵌套字面量（`外盒{ 内 = 内盒{ 名 = 串 }, v = 5 }`）
    //   的内层字段初值节点也落在本构造的 [子起点, 子终点) 内（其后缀序：内层字段初值
    //   在内层构造节点之前）；若不跳过，外层字段循环会把内层字段初值**误当自己的字段**：
    //   ① 字段名查不到偏移 → 按默认宽度写到本槽（覆盖/杂写）② 内层字段值被**二次求值**
    //   （多一次 __cn_str_copy，其一被后续结构体拷贝覆盖而泄漏——探针 P26/P27 实证
    //   残留 1；诊断 dump 实证外层区间含内层字段初值 44 达两处）。
    //   嵌套区间的整段由「对应字段的值区间求值」处理（`生成表达式` 递归 → 内层构造）。
    向量<整64> 嵌套区间们 = 向量<整64>();
    收集构造区间(池, 整32(n.子起点), 整32(n.子终点), 嵌套区间们);
    整64 fi = 整64(n.子起点);
    当 (fi < 整64(n.子终点)) {
        整64 跳终84 = 区间终点(嵌套区间们, 整32(fi), 2);
        如果 (跳终84 >= 0) {
            如果 (跳终84 > fi) { fi = 跳终84; } 否则 { fi++; }
            继续;
        }
        节点 字段节点 = 池.元素(整32(fi));
        如果 (字段节点.类型 == 节点_字段初值) {
            整64 值起c = 整64(字段节点.子起点);
            整64 值止c = 整64(字段节点.子终点);
            整64 字段类型IDf = 查字段类型ID(结构体IDc, 整64(字段节点.文本));
            整64 字段大小f = 0;
            如果 (字段类型IDf != 0) { 字段大小f = 查结构体大小(字段类型IDf); }
            // 861-a（002 攻族 G-N）：数组类型字段的初始化列表——字段值区间末位=
            //   节点_数组初始化（解析数组初始化列表 封口）且字段类型为数组 → 走
            //   逐元素写分支（对齐 生成声明.cn 94-a 语句位：元素序×步进偏移+
            //   按元素宽度指针存储；对象零填先行→余元素保零）。非此形态仍走
            //   表达式求值（标量/字符串/结构体/嵌套构造零变化）。
            布尔 数组初值c = 假;
            如果 (值止c > 值起c && 字段类型IDf != 0) {
                节点 末值c = 池.元素(整32(值止c - 1));
                如果 (末值c.类型 == 节点_数组初始化 &&
                    是数组类型文本(字符串复制(驻留文本(字段类型IDf)))) {
                    数组初值c = 真;
                }
            }
            如果 (值止c > 值起c && !数组初值c) {
                生成表达式(池, 整32(值起c), 整32(值止c), 局部槽, 参数槽, 指令,
                          寄存器计数, 块计数, 槽计数, 表达式栈);
            }
            整64 值regc = 零regc;
            如果 (!数组初值c && 表达式栈.大小() > 0) {
                值regc = 表达式栈.元素(表达式栈.大小() - 1);
                结果<空类型, 整32> 删值c = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删值c.正常) { 运行时错误(4); }
            }
            // 491（816 三元同族·字段初值位漏点）：值位函数名收口——字段初值
            //   是函数名（生成标识符加载 兜底负占位 0-名ID）时还原为函数地址
            //   IR_函数地址。负占位直入下方 IR_指针存储 被后端当寄存器号：win
            //   992 守卫「非法寄存器槽号 -36（0-名ID）」中止（probe491_s1
            //   实录——结构体函数指针字段初始化 包裹{ fn = 加一 }）。零regc
            //   （数组初值/空值区间）为非负寄存器号=收口原值直通，判断面零变化。
            值regc = 值位函数名收口480(值regc, 指令, 寄存器计数);
            串字段写入归一化281(指令, 寄存器计数, 池, 值止c, 字段类型IDf, 值regc != 零regc, 值regc);  // 281 归一化
            整64 字段地址c = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_字段地址, 基址regc, 0, 0, 字段地址c, T_整64,
                                 整64(字段节点.附加)));
            // 84-c：字段类型分派——**值语义结构体字段**须**整体拷贝**（内联值语义：
            //   源=嵌套构造槽/返回地址→目标=字段内联区）；「宽度存储」只写地址指针
            //   8 字节→内联读=垃圾（P24① 实证）。其余类型（标量/字符串/指针）按宽
            //   指针）按宽度存储（窄宽字段越界教训：整32 字段写 8 字节踩相邻字段）。
            如果 (数组初值c) {
                字符串 字段类型文本86 = 字符串复制(驻留文本(字段类型IDf));
                结果<整64, 整32> 步进查86 = 数组元素步进(字段类型文本86);
                整64 元素步进86 = 0;
                如果 (步进查86.正常) { 元素步进86 = 步进查86.值; }
                整64 长度86 = 数组长度文本(字段类型文本86);
                整64 元素宽86 = 类型宽度码(数组元素文本(字段类型文本86));
                节点 初始化节点86 = 池.元素(整32(值止c - 1));
                // 897-a（070-001 波4）：顶层包装倒序收集（元素=构造字面量时
                //   区间物理含内层包装——声明位 897 同病同修·判据=区间覆盖）
                向量<整64> 顶层们86 = 向量<整64>();
                整64 最小起86 = 整64(初始化节点86.子终点);
                整64 倒扫86 = 整64(初始化节点86.子终点) - 1;
                当 (倒扫86 >= 整64(初始化节点86.子起点)) {
                    节点 扫w86 = 池.元素(整32(倒扫86));
                    如果 (扫w86.类型 == 节点_数组元素 &&
                         整64(扫w86.子起点) < 最小起86) {
                        结果<空类型, 整32> 加顶86 = 顶层们86.追加(倒扫86);
                        如果 (!加顶86.正常) { 运行时错误(4); }
                        最小起86 = 整64(扫w86.子起点);
                    }
                    倒扫86--;
                }
                整64 元素序86 = 0;
                整64 顶游86 = 顶层们86.大小();
                当 (顶游86 > 0) {
                    顶游86--;
                    节点 包装86 = 池.元素(整32(顶层们86.元素(顶游86)));
                    {
                        如果 (元素序86 >= 长度86) {
                            IR层诊断("数组初始化元素数超出长度: " + 字段类型文本86);
                            中断;
                        }
                        整64 元素前深度86 = 表达式栈.大小();
                        整64 元素寄存器86 = 生成表达式(池, 整32(包装86.子起点),
                                                整32(包装86.子终点), 局部槽, 参数槽,
                                                指令, 寄存器计数, 块计数, 槽计数,
                                                表达式栈);
                        表达式栈弹到深度(表达式栈, 元素前深度86);
                        如果 (元素寄存器86 != 0) {
                            整64 元素地址86 = 字段地址c;
                            如果 (元素序86 > 0) {
                                整64 偏移常量86 = 寄存器计数[0];
                                寄存器计数[0] = 寄存器计数[0] + 1;
                                IR追加(指令, 建IR指令(IR_常量整数,
                                        整64(驻留(整数转字符串(元素序86 * 元素步进86))),
                                        0, 0, 偏移常量86, T_整64, 0));
                                整64 元素地址新86 = 寄存器计数[0];
                                寄存器计数[0] = 寄存器计数[0] + 1;
                                IR追加(指令, 建IR指令(IR_加, 字段地址c, 偏移常量86,
                                        0, 元素地址新86, T_整64, 0));
                                元素地址86 = 元素地址新86;
                            }
                            IR追加(指令, 建IR指令(IR_指针存储, 元素地址86,
                                    元素寄存器86, 0, 0, 元素宽86, 0));
                        }
                        元素序86++;
                    }
                }
            } 否则 如果 (字段大小f > 0) {
                // 结构体字段=值语义内联 → memcpy 整体拷贝（与宿主 emitStructInitTo 内联一致）
                IR追加(指令, 建IR指令(IR_结构体拷贝, 值regc, 字段地址c, 0, 0,
                                     字段大小f, 0));
            } 否则 {
                整64 宽度c = 查字段宽度码(结构体IDc, 整64(字段节点.文本));
                如果 (宽度c == T_整128 || 宽度c == T_正128) {
                    // 545（070 波D-二·1022）：128 位字段窄源写——单指针存储只写
                    //   低半 8 字节=高半垃圾（打印 18446744073709551607 实录）——
                    //   窄源按符号性物化双半槽对+双半拷贝入字段（宿主 emitCast
                    //   普通→128 同语义·与 声明位修复 同族）
                    整64 值码c128 = 查寄存器类型(值regc);
                    整64 物化码c = 值码c128;
                    整64 有符号c = 1;
                    如果 (物化码c == T_未知) { 物化码c = T_整64; }
                    如果 (物化码c == T_正32 || 物化码c == T_正64) { 有符号c = 0; }
                    整64 句柄c128 = 物化128位操作数(值regc, 物化码c, 有符号c,
                                              指令, 寄存器计数, 槽计数);
                    整64 低c = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_指针加载, 句柄c128, 0, 0, 低c, T_整64, 0));
                    IR追加(指令, 建IR指令(IR_指针存储, 字段地址c, 低c, 0, 0, T_整64, 0));
                    整64 高址c = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_字段地址, 字段地址c, 0, 0, 高址c, T_整64, 8));
                    整64 高c = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_字段地址, 句柄c128, 0, 0, 高c, T_整64, 8));
                    整64 高值c = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_指针加载, 高c, 0, 0, 高值c, T_整64, 0));
                    IR追加(指令, 建IR指令(IR_指针存储, 高址c, 高值c, 0, 0, T_整64, 0));
                } 否则 如果 (字段大小f == 0) {
                    // 919（超承载字面量参与表达式·结构体字段求值链收口）：
                    //   标量字段收 128 值（超承载字面量表达式经 638 甲案提升链
                    //   物化为地址句柄）→ 隐式窄化低半（与声明初值/赋值/返回/
                    //   实参挂点同设施·宿主端 i128→i64 Cast 同款）。原句柄地址
                    //   直存字段槽＝读出地址碎片（探针：块 甲 = 块{ 值 = 20位+0 }
                    //   输出每次不同的栈地址，应 7766279631452241919=低 64 位截断）。
                    值regc = 隐式窄化到64(值regc, 指令, 寄存器计数);
                    IR追加(指令, 建IR指令(IR_指针存储, 字段地址c, 值regc, 0, 0, 宽度c, 0));
                }
            }
        }
        fi++;
    }
    结果<空类型, 整32> 设临c = 结构体返回临时们.设置(基址regc, 结构体IDc);
    如果 (!设临c.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加栈c = 表达式栈.追加(基址regc);
    如果 (!加栈c.正常) { 运行时错误(4); }
}

