// IR容器尾（356 重构F1 自 IR容器.cn 纯机械搬移·函数体逐字保留·零逻辑变化）
导入 容器::向量;
导入 映射集合;
导入 IR;         // 签名辅助 + 节点_*/T_*/IR_*/键位移/当前函数变量类型（原 IR签名+IR常量 合并目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:




// ==================== 81-a-v2：帧尾共享 retbuf 的「返回物化」与实参临时清理 ====================

// 立案（HANDOFF 下一轮第一优先，数据损坏级）：v2 的 retbuf 是**帧尾共享单缓冲**

//   （全部结构体/结果返回共用 `retbuf序号` 槽区，`累计retbuf字节数` 定尺寸）——

//   任何「返回值跨越另一次调用」的形态都被覆盖：

//     ① `表.追加(造盒())`（单实参）：返回句柄被外层调用的 retbuf 覆盖 → 泄漏；

//     ② `合并(造盒(1),造盒(2))`（双实参）：第二次返回覆盖第一次 → **数据损坏**

//        （实测宿主 1 / v2 0）。

//   宿主对照：宿主每次调用分配独立 `__retbufN` Alloca 槽（无共享），故无此问题。

//   Rust/LLVM 对照：sret 缓冲由**每次调用各自分配**（LLVM 语义）——本实现对齐之。

// 机制主体（甲案）= **结构体/结果返回调用发射后立即物化**：把 retbuf 内容拷进

//   「生成期临时槽」（独立槽 + 返回寄存器覆盖为槽地址）→ 每个返回值独立 ✓；

//   实参位置的消费者在外层调用发射后按登记表释放其串字段（清理调用实参临时）。

// 槽分配纪律（**独立于预扫预分配槽区**）：

//   ① 预扫（预扫容器声明/登记参数槽）分配：参数槽 + 变量槽（槽 1=retbuf 指针保留）；

//   ② 生成期新增槽（本机制的临时槽）**只用同一 `槽计数` 继续递增**——不回溯、

//      不复用已分配槽号、不与参数/变量槽区交错；

//   ③ retbuf 区由**代码生成动态计算**（`扫描函数` 的 `槽基数 = 最大槽`，retbuf 区在

//      其上）→ 任何 `IR_分配`（含本机制的临时槽）都会上移该区，两者**不可能重叠**；

//   ④ 计数器随函数生成结束即失效（无跨函数残留）；登记表在函数边界清空。

// 依赖不变量（plans/020 移植纪律 7）：

//   ①**只有真结构体**（`查结构体大小 != 0`）物化——结果/可选 合成布局与容器对象

//     返回不物化（其消费路径各异，见诚实边界）；

//   ②**匹配即删除**（实参清理）；登记表**函数边界清空**（防跨函数寄存器号误命中）；

//   ③释放只服务「纯串字段结构体」（无嵌套/结果/可选/容器字段）——越界形态留给

//     接收方接管（浅拷）或登记边界（宁漏勿错）。

静态 映射<整64, 整64> 结构体返回临时们;   // 物化后寄存器（=槽地址）→ 结构体ID

// 203（021 任务 203·宿主 IRGenerator::flushPendingArgCleanups 同构）：表达式
//   物化临时登记表——字段链中间跳（表.元素(0).名）消费的容器方法返回物化
//   临时（reg→结构ID 交替对）。串字段副本随「值读出」语义产生（发射串字段
//   深拷 在位拷），但物化 reg 不进任何调用实参弹出们（清理调用实参临时 扫
//   不到）·块出口名单视形态漏收→外层调用发射完成后按基线区间回缩释放。
静态 向量<整64> 表达式物化临时们;



// 顺序可释放判定（84-c 扩容：字符串字段 + **嵌套结构体字段递归**）——无块结构版

//   释放（`发射串字段释放顺序`）的前提：结果/可选（联合体条件）/容器（DeleteObject）

//   字段=面外 → 整段不清理（宁漏勿错）。

//   原实现仅 `串字段数 == 资源字段数`（纯串字段结构体）→ 嵌套结构体元素（如

//   `外盒{ 内 = 内盒{ 名 = 串 } }`）判假 → 实参位置物化槽不清理（探针 P25② 泄漏）。

函数 是纯串字段结构体(整64 结构体ID) -> 布尔 {

    返回 可顺序释放结构体(整64(结构体ID), 0);

}



不安全 函数 可顺序释放结构体(整64 结构体ID, 整64 深度) -> 布尔 {

    如果 (深度 > 4) { 返回 假; }

    // 静默豁免业务值: 非结构体→本通道不适用早退假（原 ==0 判据同义·1541 B2 否定形态）
    如果 (!是结构体大小非零(结构体ID)) { 返回 假; }

    如果 (资源字段数(结构体ID) <= 0) { 返回 假; }

    向量<整64> 字段们 = 向量<整64>();

    取资源字段们(结构体ID, 字段们);

    整64 f = 0;

    当 (f + 2 < 字段们.大小()) {

        整64 字段类型IDf = 字段们.元素(f + 1);

        字符串 类型文本f = 字符串复制(驻留文本(字段类型IDf));

        如果 (字符串比较(类型文本f, "字符串")) {

            // 串字段：可顺序释放 ✓

        } 否则 如果 (是容器类(类型文本f) || 是结果类型(类型文本f)) {

            返回 假;

        } 否则 如果 (是结构体大小非零(字段类型IDf)) {

            如果 (!可顺序释放结构体(字段类型IDf, 深度 + 1)) { 返回 假; }

        } 否则 {

            返回 假;

        }

        f += 3;

    }

    返回 真;

}



// 82-a：把「返回类型名」限定到**被调函数的定义模块**——同名结构体的布局按模块

//   分桶独立（E2E 172：主模块 记录=4B vs 甲模块 记录=16B）；纯名在主模块上下文

//   解析会取到同名异布局类型（大小错 → 返回物化长度错，实测主侧 `甲::造甲` 的

//   返回大小被解析为 4 而非 16）。**不改返回类型表**（避免影响其它消费点）——

//   物化点单点限定：键文本含 "::" 时取模块前缀重查大小，命中才用限定名。

// 子串位置（1360 批5 结果化）：命中=某些(起始下标)，未命中/非法=可选无值。
函数 子串位置(字符串 文本, 字符串 目标) -> 可选<整64> {

    整64 n = 字符串长度(文本);

    整64 m = 字符串长度(目标);

    如果 (m <= 0 || m > n) { 返回 无; }

    整64 i = 0;

    当 (i + m <= n) {

        如果 (字符串比较(字符串子串(文本, i, m), 目标)) { 返回 某些(i); }

        i++;

    }

    返回 无;

}



函数 限定返回类型ID(整64 函数符号, 整64 返回类型ID) -> 整64 {

    字符串 类型文本 = 字符串复制(驻留文本(返回类型ID));

    可选<整64> 位查 = 子串位置(类型文本, "::");

    如果 (位查.有值) { 返回 返回类型ID; }

    // 函数键格式 = 键基#参数串（键基 = 模块$名 于非主模块 / 名 于主模块）——

    //   首个 '$' 之前 = 模块前缀（主模块函数无 '$' → 不限定）

    字符串 键文本 = 字符串复制(驻留文本(函数符号));

    可选<整64> 分位置查 = 首分段位置(键文本);

    // 1360 批5：无 '$'（无值）与 '$' 打头（位置 0）同按「无模块前缀」处置
    //   （原 `<= 0` 判据逐字保持·两段独立守卫：无值 / 值==0）
    如果 (!分位置查.有值) { 返回 返回类型ID; }

    如果 (分位置查.值 == 0) { 返回 返回类型ID; }

    整64 分位置 = 分位置查.值;

    字符串 模块前缀 = 字符串子串(键文本, 0, 分位置);

    整64 限定ID = 驻留(字符串复制(模块前缀) + "::" + 类型文本);

    如果 (是结构体大小非零(限定ID)) { 返回 限定ID; }

    返回 返回类型ID;

}



// 返回物化（调用发射后立即执行；独立槽=帧尾共享 retbuf 的替代）：

//   源=返回寄存器（=retbuf 地址）→ 新分配的生成期临时槽；**返回槽地址寄存器**

//   （调用方以它替换压栈的返回值——消费者/接收方拿到的是独立副本，与后续调用的

//   retbuf 无共享）。登记「槽地址寄存器 → 结构体ID」供实参位置清理消费。

//   Rust/LLVM 对照：sret 缓冲由每次调用各自分配（本实现以「每次返回调用一个新槽」

//   达成同一语义；槽号随槽计数递增，帧尺寸随之增长=正确性必要代价）。

不安全 函数 物化返回值到独立槽(向量<IR指令>& 指令, 整64* 寄存器计数,

                    整64* 槽计数, 整64 返回寄存器, 整64 结构体ID) -> 整64 {

    整64 大小 = 0;
    可选<整64> 大小查e = 查结构体大小(结构体ID);
    如果 (大小查e.有值) { 大小 = 大小查e.值; }

    如果 (大小 <= 0) { 返回 0; }

    整64 槽数m = (大小 + 7) / 8;

    整64 槽起 = 槽计数[0];

    槽计数[0] = 槽计数[0] + 槽数m;

    // 逐槽 IR_分配（②b B1 结构体局部同款）：扫描函数 按 附加 统计最大槽——

    //   只登记基槽会使帧尺寸少算，越界踩相邻槽

    整64 z = 0;

    当 (z < 槽数m) {

        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽起 + z));

        z++;

    }

    // **基址槽 = 槽起 + 槽数m - 1**（②b B1 约定：最大槽号=最低地址=结构体基址；

    //   槽偏移 = -(8*(最大寄存器+s)+8) 随槽号减小而升高——误用 槽起 当基址会把

    //   结构体写到相邻变量槽上（P20 实测：物化槽 -704 与 t 槽 -696 重叠 8 字节）

    整64 基槽 = 槽起 + 槽数m - 1;

    整64 槽地址reg = 寄存器计数[0];

    寄存器计数[0] = 寄存器计数[0] + 1;

    IR追加(指令, 建IR指令(IR_取地址, 基槽, 0, 0, 槽地址reg, T_整64, 0));

    IR追加(指令, 建IR指令(IR_结构体拷贝, 返回寄存器, 槽地址reg, 0, 0, 大小, 0));

    结果<空类型, 整32> 设 = 结构体返回临时们.设置(槽地址reg, 结构体ID);

    如果 (!设.正常) { 运行时错误(4); }

    返回 槽地址reg;

}



// 顺序释放（无函数IR 上下文：不发射条件分支，不清槽——临时不再被读取）

不安全 函数 发射串字段释放顺序(向量<IR指令>& 指令, 整64* 寄存器计数,

                     整64 基址reg, 整64 结构体ID) -> 空类型 {

    向量<整64> 字段们 = 向量<整64>();

    取资源字段们(结构体ID, 字段们);

    整64 f = 0;

    当 (f + 2 < 字段们.大小()) {

        整64 偏移 = 字段们.元素(f + 2);

        整64 地址reg = 寄存器计数[0];

        寄存器计数[0] = 寄存器计数[0] + 1;

        IR追加(指令, 建IR指令(IR_字段地址, 基址reg, 0, 0, 地址reg, T_整64, 偏移));

        整64 字段类型IDs = 字段们.元素(f + 1);
        字符串 字段文本975 = 字符串复制(驻留文本(字段类型IDs));


        如果 (字符串比较(字段文本975, "字符串")) {

            整64 串reg = 寄存器计数[0];

            寄存器计数[0] = 寄存器计数[0] + 1;

            IR追加(指令, 建IR指令(IR_指针加载, 地址reg, 0, 0, 串reg, T_字符串, 0));

            IR追加(指令, 建IR指令(IR_调用实参, 串reg, 0, 0, 0, 0, 0));

            IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0, 驻留("__cn_str_free")));


        } 否则 如果 (是容器类(字段文本975) || 是用户类(字段文本975)) {
            // 975（008 深水二·575 块收尾泄漏根治）：容器/用户类字段——装载句柄
            //   +删除（析构分派同 发射资源字段释放于地址 :96 段：有析构
            //   IR_删除对象〔dtor+object_delete〕·无析构直调 __cn_object_delete
            //   〔956 分派同款〕）。原实现只放 串字段/嵌套结构体——容器字段
            //   静默跳过=复制(g) LUE 搬移临时（结构体返回临时们 登记位）调用后
            //   无人释放→块收尾活动分配数不回基线（pd 探针 delta=1 实锤·575
            //   「无泄漏」两行缺失·asm 铁证=call 校验 后零清理）。
            整64 句柄975 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 地址reg, 0, 0, 句柄975, T_对象, 0));
            如果 (类有析构(字段类型IDs)) {
                IR追加(指令, 建IR指令(IR_删除对象, 句柄975, 0, 0,
                                     寄存器计数[0], 0, 字段类型IDs));
                寄存器计数[0] = 寄存器计数[0] + 1;
            } 否则 {
                IR追加(指令, 建IR指令(IR_调用实参, 句柄975, 0, 0, 0, 0, 0));
                IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                     驻留("__cn_object_delete")));
            }
        } 否则 如果 (是结构体大小非零(字段类型IDs)) {

            // 84-c：嵌套结构体字段（值语义内联）→ 以字段地址为基址递归释放

            发射串字段释放顺序(指令, 寄存器计数, 地址reg, 字段类型IDs);

        }

        f += 3;

    }

}



// 调用发射后清理本次调用的实参临时（实参寄存器命中登记表即清理，匹配即删除）

// 1502（966 姊妹·v2 面）：转移(类源) 入容器位源壳释放面两表——
//   类变量类型名们（键=变量名 ID·值=类名 ID·生成声明 用户类分派点登记·
//   与 局部槽 同键设计）；转移壳临时们（键=源句柄寄存器·值=类名 ID·
//   生成调用 实参位登记·本文件 清理调用实参临时 消费）。
//   静态表=文件级私有——跨文件消费经下列三包装函数（寄存器类型们 同例）。
静态 映射<整64, 整64> 类变量类型名们;
静态 映射<整64, 整64> 转移壳临时们;

// 1538（2026-10-25·宿主 classifyClassReturnOwnership 实参位甄别同构）：类返回物化
//   「拥有」标记表（键=物化槽地址寄存器）——85-a 门槛对齐（借用来源句柄直传）
//   后，实参位物化=调用方对象别名（写穿·plans/001 §5.3·056 甲），975 逐字段
//   释放通道若不甄别=误删调用方对象（直通探针实测 free invalid pointer·与
//   宿主 1052 段错误同根教训「未甄别修复全破」）。登记=物化点拥有性甄别通过
//   （函数符号拥有甄别1538：构造调用/662 自由函数候选/方法面候选）；消费=
//   清理调用实参临时（无标记只删登记不发射·宁漏勿错）。登记表函数边界清空
//   同 结构体返回临时们（IR生成尾 81-a-v2 清空点对称）。
静态 映射<整64, 整64> 物化拥有临时们;

不安全 函数 物化拥有登记1538(整64 物化寄存器) -> 空类型 {
    结果<空类型, 整32> 设1538 = 物化拥有临时们.设置(物化寄存器, 1);
    如果 (!设1538.正常) { 运行时错误(4); }
}

函数 物化拥有查1538(整64 物化寄存器) -> 布尔 {
    结果<整64, 整32> 查1538 = 物化拥有临时们.获取(物化寄存器);
    返回 查1538.正常;
}

不安全 函数 物化拥有删除1538(整64 物化寄存器) -> 空类型 {
    布尔 删1538 = 物化拥有临时们.删除(物化寄存器);
}

不安全 函数 物化拥有清空1538() -> 空类型 {
    物化拥有临时们.清空();
}

不安全 函数 类变量类名登记(整64 名ID, 整64 类ID) -> 空类型 {
    结果<空类型, 整32> 设 = 类变量类型名们.设置(名ID, 类ID);
    如果 (!设.正常) { 运行时错误(4); }
}

函数 类变量类名查(整64 名ID) -> 结果<整64, 整32> {
    // 33ad0a33 自举代际纪律：返回结果表达式/变量改显式构造（v2p 对「return
    //   获取(...)」直通形态解析退化整64——79 fix_p 实录）。
    结果<整64, 整32> 查 = 类变量类型名们.获取(名ID);
    如果 (查.正常) { 返回 正常(查.值); }
    // 否则 分支不访问 查.错误（v2 结果消费纪律·样板=IR容器签名 139 哨兵形）
    //   ——miss 语义=键不存在（码 2·调用方只判 .正常）。
    返回 错误(2);
}

不安全 函数 转移壳类名登记(整64 句柄寄存器, 整64 类ID) -> 空类型 {
    结果<空类型, 整32> 设 = 转移壳临时们.设置(句柄寄存器, 类ID);
    如果 (!设.正常) { 运行时错误(4); }
}

不安全 函数 清理调用实参临时(向量<整64>& 弹出们, 向量<IR指令>& 指令,

                   整64* 寄存器计数, 向量<节点> 池, 整64* 块计数) -> 空类型 {

    整64 i = 0;

    当 (i < 弹出们.大小()) {

        整64 reg = 弹出们.元素(i);

        // 662（617 三元面补全·644 传参位扩展）：三元实参（生成调用 644 段
        //   三元实参登记662）——按选中分支条件释放（选中字面量/标识符借用
        //   分支不得 free），释放后删除登记项（释放权单点·防双释放）。

        整64 位t662 = 0;

        布尔 是三元实参662 = 三元实参查位662(reg, 位t662);

        如果 (是三元实参662) {

            发射串临时释放递归662(池, 位t662, reg, 指令, 寄存器计数, 块计数);

            布尔 删t662 = 三元实参删除662(reg);

        }

        如果 (!是三元实参662) {

        // 1502（966 姊妹·v2 面）：转移(类源) 入容器位源壳——IR_删除对象 整壳
        //   析构（空安全跳过·运行时调析构+free·与 662 接收临时析构同语义）。
        //   深拷独立拥有（630）语义下源壳无人持有；转移展开已清源槽=无双释放。
        结果<整64, 整32> 查壳1502 = 转移壳临时们.获取(reg);

        如果 (查壳1502.正常) {

            IR追加(指令, 建IR指令(IR_删除对象, reg, 0, 0,
                                 寄存器计数[0], 0, 查壳1502.值));
            寄存器计数[0] = 寄存器计数[0] + 1;
            布尔 删壳1502 = 转移壳临时们.删除(reg);

        }

        结果<整64, 整32> 查 = 结构体返回临时们.获取(reg);

        如果 (查.正常) {

            如果 (查.值 == 0 - 1) {

                // 644（2026-10-14·宿主 emitStringFreeForValue 同构）：纯串临时
                //   哨兵（生成调用 实参位登记）——整串句柄释放（__cn_str_free
                //   空安全；临时寄存器此后不再被读取，无需清槽）。

                IR追加(指令, 建IR指令(IR_调用实参, reg, 0, 0, 0, 0, 0));

                IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                     驻留("__cn_str_free")));

            } 否则 如果 (!是用户类_ID(查.值) || 物化拥有查1538(reg)) {

                // 975：撤「纯串」门——释放器已扩展容器/用户类字段（纯标量结构体=零资源字段零发射 no-op）。
                // 1538（2026-10-25）：拥有甄别**分域**——85-a 门槛分域（类=串字段
                //   收窄句柄直传/结构体=资源字段维持深拷闭环）同构：
                //   · **类**（句柄 ABI）：查 物化拥有临时们 标记——85-a 收窄后借用
                //     来源实参位物化=调用方对象别名（句柄直传），无标记即释放=误删
                //     调用方对象（直通探针 free invalid pointer 实录·宿主 1479
                //     「三版未甄别修复全破」同根）。无标记只删登记不发射=宁漏勿错。
                //   · **结构体**（值语义聚合）：无条件发射（存量闭环——85-a 深拷
                //     副本+617-a 调用方拷贝副本的清理配对依赖此路径·587 锁用例
                //     实证甄别收窄即配对链断裂每轮泄 1）。

                发射串字段释放顺序(指令, 寄存器计数, reg, 查.值);

                布尔 删拥1538 = 物化拥有临时们.删除(reg);

            }

            布尔 删 = 结构体返回临时们.删除(reg);

        }
        否则 {
        }

        }

        i++;

    }

}

// 203（021 任务 203·宿主 IRGenerator::flushPendingArgCleanups 同构）：表达式

//   物化临时清理——外层调用发射完成后按 基线 区间回缩释放（基线=本次调用

//   实参求值前 表达式物化临时们.大小() 快照·嵌套调用各自持帧局部基线）。

//   释放=发射串字段释放顺序（free+槽清零幂等模型·与 975 实参清理双清安全：

//   已清条目槽句柄=0，串运行时空句柄容错跳过）。物化槽=栈槽无需对象 free。

不安全 函数 清理表达式物化临时(整64 基线, 向量<IR指令>& 指令,

                   整64* 寄存器计数) -> 空类型 {

    当 (表达式物化临时们.大小() > 基线) {

        整64 结构IDe = 表达式物化临时们.元素(表达式物化临时们.大小() - 1);

        结果<空类型, 整32> 删e = 表达式物化临时们.删除(表达式物化临时们.大小() - 1);

        如果 (!删e.正常) { 运行时错误(4); }

        整64 寄存器e = 表达式物化临时们.元素(表达式物化临时们.大小() - 1);

        删e = 表达式物化临时们.删除(表达式物化临时们.大小() - 1);

        如果 (!删e.正常) { 运行时错误(4); }

        发射串字段释放顺序(指令, 寄存器计数, 寄存器e, 结构IDe);

    }

}

// 128 位初值文本解析（静字节值/静数字字节值/静十六进制段/解析128位初值文本）已迁 IR初值解析.cn（1103 先拆再加·纯机械搬移零语义）。
