// IR容器尾（356 重构F1 自 IR容器.cn 纯机械搬移·函数体逐字保留·零逻辑变化）
导入 容器::向量;
导入 映射集合;
导入 IR;         // 签名辅助 + 节点_*/T_*/IR_*/键位移/当前函数变量类型（原 IR签名+IR常量 合并目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:




// ==================== 81-a-v2：帧尾共享 retbuf 的「返回物化」与实参临时清理 ====================

// 立案（HANDOFF 下一轮第一优先，数据损坏级）：v2 的 retbuf 是**帧尾共享单缓冲**

//   （全部结构体/结果返回共用 `retbuf序号` 槽区，`累计retbuf字节数` 定尺寸）——

//   任何「返回值跨越另一次调用」的形态都被覆盖：

//     ① `表.追加(造盒())`（单实参）：返回句柄被外层调用的 retbuf 覆盖 → 泄漏；

//     ② `合并(造盒(1),造盒(2))`（双实参）：第二次返回覆盖第一次 → **数据损坏**

//        （实测宿主 1 / v2 0）。

//   宿主对照：宿主每次调用分配独立 `__retbufN` Alloca 槽（无共享），故无此问题。

//   Rust/LLVM 对照：sret 缓冲由**每次调用各自分配**（LLVM 语义）——本实现对齐之。

// 机制主体（甲案）= **结构体/结果返回调用发射后立即物化**：把 retbuf 内容拷进

//   「生成期临时槽」（独立槽 + 返回寄存器覆盖为槽地址）→ 每个返回值独立 ✓；

//   实参位置的消费者在外层调用发射后按登记表释放其串字段（清理调用实参临时）。

// 槽分配纪律（**独立于预扫预分配槽区**）：

//   ① 预扫（预扫容器声明/登记参数槽）分配：参数槽 + 变量槽（槽 1=retbuf 指针保留）；

//   ② 生成期新增槽（本机制的临时槽）**只用同一 `槽计数` 继续递增**——不回溯、

//      不复用已分配槽号、不与参数/变量槽区交错；

//   ③ retbuf 区由**代码生成动态计算**（`扫描函数` 的 `槽基数 = 最大槽`，retbuf 区在

//      其上）→ 任何 `IR_分配`（含本机制的临时槽）都会上移该区，两者**不可能重叠**；

//   ④ 计数器随函数生成结束即失效（无跨函数残留）；登记表在函数边界清空。

// 依赖不变量（plans/020 移植纪律 7）：

//   ①**只有真结构体**（`查结构体大小 != 0`）物化——结果/可选 合成布局与容器对象

//     返回不物化（其消费路径各异，见诚实边界）；

//   ②**匹配即删除**（实参清理）；登记表**函数边界清空**（防跨函数寄存器号误命中）；

//   ③释放只服务「纯串字段结构体」（无嵌套/结果/可选/容器字段）——越界形态留给

//     接收方接管（浅拷）或登记边界（宁漏勿错）。

静态 映射<整64, 整64> 结构体返回临时们;   // 物化后寄存器（=槽地址）→ 结构体ID

// 203（021 任务 203·宿主 IRGenerator::flushPendingArgCleanups 同构）：表达式
//   物化临时登记表——字段链中间跳（表.元素(0).名）消费的容器方法返回物化
//   临时（reg→结构ID 交替对）。串字段副本随「值读出」语义产生（发射串字段
//   深拷 在位拷），但物化 reg 不进任何调用实参弹出们（清理调用实参临时 扫
//   不到）·块出口名单视形态漏收→外层调用发射完成后按基线区间回缩释放。
静态 向量<整64> 表达式物化临时们;



// 顺序可释放判定（84-c 扩容：字符串字段 + **嵌套结构体字段递归**）——无块结构版

//   释放（`发射串字段释放顺序`）的前提：结果/可选（联合体条件）/容器（DeleteObject）

//   字段=面外 → 整段不清理（宁漏勿错）。

//   原实现仅 `串字段数 == 资源字段数`（纯串字段结构体）→ 嵌套结构体元素（如

//   `外盒{ 内 = 内盒{ 名 = 串 } }`）判假 → 实参位置物化槽不清理（探针 P25② 泄漏）。

函数 是纯串字段结构体(整64 结构体ID) -> 布尔 {

    返回 可顺序释放结构体(整64(结构体ID), 0);

}



不安全 函数 可顺序释放结构体(整64 结构体ID, 整64 深度) -> 布尔 {

    如果 (深度 > 4) { 返回 假; }

    如果 (查结构体大小(结构体ID) == 0) { 返回 假; }

    如果 (资源字段数(结构体ID) <= 0) { 返回 假; }

    向量<整64> 字段们 = 向量<整64>();

    取资源字段们(结构体ID, 字段们);

    整64 f = 0;

    当 (f + 2 < 字段们.大小()) {

        整64 字段类型IDf = 字段们.元素(f + 1);

        字符串 类型文本f = 字符串复制(驻留文本(字段类型IDf));

        如果 (字符串比较(类型文本f, "字符串")) {

            // 串字段：可顺序释放 ✓

        } 否则 如果 (是容器类(类型文本f) || 是结果类型(类型文本f)) {

            返回 假;

        } 否则 如果 (查结构体大小(字段类型IDf) != 0) {

            如果 (!可顺序释放结构体(字段类型IDf, 深度 + 1)) { 返回 假; }

        } 否则 {

            返回 假;

        }

        f += 3;

    }

    返回 真;

}



// 82-a：把「返回类型名」限定到**被调函数的定义模块**——同名结构体的布局按模块

//   分桶独立（E2E 172：主模块 记录=4B vs 甲模块 记录=16B）；纯名在主模块上下文

//   解析会取到同名异布局类型（大小错 → 返回物化长度错，实测主侧 `甲::造甲` 的

//   返回大小被解析为 4 而非 16）。**不改返回类型表**（避免影响其它消费点）——

//   物化点单点限定：键文本含 "::" 时取模块前缀重查大小，命中才用限定名。

函数 子串位置(字符串 文本, 字符串 目标) -> 整64 {

    整64 n = 字符串长度(文本);

    整64 m = 字符串长度(目标);

    如果 (m <= 0 || m > n) { 返回 -1; }

    整64 i = 0;

    当 (i + m <= n) {

        如果 (字符串比较(字符串子串(文本, i, m), 目标)) { 返回 i; }

        i++;

    }

    返回 -1;

}



函数 限定返回类型ID(整64 函数符号, 整64 返回类型ID) -> 整64 {

    字符串 类型文本 = 字符串复制(驻留文本(返回类型ID));

    如果 (子串位置(类型文本, "::") >= 0) { 返回 返回类型ID; }

    // 函数键格式 = 键基#参数串（键基 = 模块$名 于非主模块 / 名 于主模块）——

    //   首个 '$' 之前 = 模块前缀（主模块函数无 '$' → 不限定）

    字符串 键文本 = 字符串复制(驻留文本(函数符号));

    整64 分位置 = 首分段位置(键文本);

    如果 (分位置 <= 0) { 返回 返回类型ID; }

    字符串 模块前缀 = 字符串子串(键文本, 0, 分位置);

    整64 限定ID = 驻留(字符串复制(模块前缀) + "::" + 类型文本);

    如果 (查结构体大小(限定ID) != 0) { 返回 限定ID; }

    返回 返回类型ID;

}



// 返回物化（调用发射后立即执行；独立槽=帧尾共享 retbuf 的替代）：

//   源=返回寄存器（=retbuf 地址）→ 新分配的生成期临时槽；**返回槽地址寄存器**

//   （调用方以它替换压栈的返回值——消费者/接收方拿到的是独立副本，与后续调用的

//   retbuf 无共享）。登记「槽地址寄存器 → 结构体ID」供实参位置清理消费。

//   Rust/LLVM 对照：sret 缓冲由每次调用各自分配（本实现以「每次返回调用一个新槽」

//   达成同一语义；槽号随槽计数递增，帧尺寸随之增长=正确性必要代价）。

不安全 函数 物化返回值到独立槽(向量<IR指令>& 指令, 整64* 寄存器计数,

                    整64* 槽计数, 整64 返回寄存器, 整64 结构体ID) -> 整64 {

    整64 大小 = 查结构体大小(结构体ID);

    如果 (大小 <= 0) { 返回 0; }

    整64 槽数m = (大小 + 7) / 8;

    整64 槽起 = 槽计数[0];

    槽计数[0] = 槽计数[0] + 槽数m;

    // 逐槽 IR_分配（②b B1 结构体局部同款）：扫描函数 按 附加 统计最大槽——

    //   只登记基槽会使帧尺寸少算，越界踩相邻槽

    整64 z = 0;

    当 (z < 槽数m) {

        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽起 + z));

        z++;

    }

    // **基址槽 = 槽起 + 槽数m - 1**（②b B1 约定：最大槽号=最低地址=结构体基址；

    //   槽偏移 = -(8*(最大寄存器+s)+8) 随槽号减小而升高——误用 槽起 当基址会把

    //   结构体写到相邻变量槽上（P20 实测：物化槽 -704 与 t 槽 -696 重叠 8 字节）

    整64 基槽 = 槽起 + 槽数m - 1;

    整64 槽地址reg = 寄存器计数[0];

    寄存器计数[0] = 寄存器计数[0] + 1;

    IR追加(指令, 建IR指令(IR_取地址, 基槽, 0, 0, 槽地址reg, T_整64, 0));

    IR追加(指令, 建IR指令(IR_结构体拷贝, 返回寄存器, 槽地址reg, 0, 0, 大小, 0));

    结果<空类型, 整32> 设 = 结构体返回临时们.设置(槽地址reg, 结构体ID);

    如果 (!设.正常) { 运行时错误(4); }

    返回 槽地址reg;

}



// 顺序释放（无函数IR 上下文：不发射条件分支，不清槽——临时不再被读取）

不安全 函数 发射串字段释放顺序(向量<IR指令>& 指令, 整64* 寄存器计数,

                     整64 基址reg, 整64 结构体ID) -> 空类型 {

    向量<整64> 字段们 = 向量<整64>();

    取资源字段们(结构体ID, 字段们);

    整64 f = 0;

    当 (f + 2 < 字段们.大小()) {

        整64 偏移 = 字段们.元素(f + 2);

        整64 地址reg = 寄存器计数[0];

        寄存器计数[0] = 寄存器计数[0] + 1;

        IR追加(指令, 建IR指令(IR_字段地址, 基址reg, 0, 0, 地址reg, T_整64, 偏移));

        整64 字段类型IDs = 字段们.元素(f + 1);
        字符串 字段文本975 = 字符串复制(驻留文本(字段类型IDs));


        如果 (字符串比较(字段文本975, "字符串")) {

            整64 串reg = 寄存器计数[0];

            寄存器计数[0] = 寄存器计数[0] + 1;

            IR追加(指令, 建IR指令(IR_指针加载, 地址reg, 0, 0, 串reg, T_字符串, 0));

            IR追加(指令, 建IR指令(IR_调用实参, 串reg, 0, 0, 0, 0, 0));

            IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0, 驻留("__cn_str_free")));


        } 否则 如果 (是容器类(字段文本975) || 是用户类(字段文本975)) {
            // 975（008 深水二·575 块收尾泄漏根治）：容器/用户类字段——装载句柄
            //   +删除（析构分派同 发射资源字段释放于地址 :96 段：有析构
            //   IR_删除对象〔dtor+object_delete〕·无析构直调 __cn_object_delete
            //   〔956 分派同款〕）。原实现只放 串字段/嵌套结构体——容器字段
            //   静默跳过=复制(g) LUE 搬移临时（结构体返回临时们 登记位）调用后
            //   无人释放→块收尾活动分配数不回基线（pd 探针 delta=1 实锤·575
            //   「无泄漏」两行缺失·asm 铁证=call 校验 后零清理）。
            整64 句柄975 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 地址reg, 0, 0, 句柄975, T_对象, 0));
            如果 (类有析构(字段类型IDs)) {
                IR追加(指令, 建IR指令(IR_删除对象, 句柄975, 0, 0,
                                     寄存器计数[0], 0, 字段类型IDs));
                寄存器计数[0] = 寄存器计数[0] + 1;
            } 否则 {
                IR追加(指令, 建IR指令(IR_调用实参, 句柄975, 0, 0, 0, 0, 0));
                IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                     驻留("__cn_object_delete")));
            }
        } 否则 如果 (查结构体大小(字段类型IDs) != 0) {

            // 84-c：嵌套结构体字段（值语义内联）→ 以字段地址为基址递归释放

            发射串字段释放顺序(指令, 寄存器计数, 地址reg, 字段类型IDs);

        }

        f += 3;

    }

}



// 调用发射后清理本次调用的实参临时（实参寄存器命中登记表即清理，匹配即删除）

不安全 函数 清理调用实参临时(向量<整64>& 弹出们, 向量<IR指令>& 指令,

                   整64* 寄存器计数) -> 空类型 {

    整64 i = 0;

    当 (i < 弹出们.大小()) {

        整64 reg = 弹出们.元素(i);

        结果<整64, 整32> 查 = 结构体返回临时们.获取(reg);

        如果 (查.正常) {

            // 975：撤「纯串」门——释放器已扩展容器/用户类字段（纯标量结构体=零资源字段零发射 no-op）。

            发射串字段释放顺序(指令, 寄存器计数, reg, 查.值);

            布尔 删 = 结构体返回临时们.删除(reg);

        }

        i++;

    }

}

// 203（021 任务 203·宿主 IRGenerator::flushPendingArgCleanups 同构）：表达式

//   物化临时清理——外层调用发射完成后按 基线 区间回缩释放（基线=本次调用

//   实参求值前 表达式物化临时们.大小() 快照·嵌套调用各自持帧局部基线）。

//   释放=发射串字段释放顺序（free+槽清零幂等模型·与 975 实参清理双清安全：

//   已清条目槽句柄=0，串运行时空句柄容错跳过）。物化槽=栈槽无需对象 free。

不安全 函数 清理表达式物化临时(整64 基线, 向量<IR指令>& 指令,

                   整64* 寄存器计数) -> 空类型 {

    当 (表达式物化临时们.大小() > 基线) {

        整64 结构IDe = 表达式物化临时们.元素(表达式物化临时们.大小() - 1);

        结果<空类型, 整32> 删e = 表达式物化临时们.删除(表达式物化临时们.大小() - 1);

        如果 (!删e.正常) { 运行时错误(4); }

        整64 寄存器e = 表达式物化临时们.元素(表达式物化临时们.大小() - 1);

        删e = 表达式物化临时们.删除(表达式物化临时们.大小() - 1);

        如果 (!删e.正常) { 运行时错误(4); }

        发射串字段释放顺序(指令, 寄存器计数, 寄存器e, 结构IDe);

    }

}

// ==================== 128 位初值文本解析（T46·467-a 宿主对齐·810 下沉 IR 层） ====================
// 〔810（053）自 代码生成共用.cn 下沉：局部 128 位字面量物化（求值层）与静态槽
//   发射（代码生成层）共用同一拆半逻辑——单一归属·单向依赖（代码生成→IR 合法方向）。
//   代码生成三后端调用点零改动（跨包裸名可见·驻留文本 先例）。〕

// 字节取值（本地副本·本文件不导入词法模块）
函数 静字节值(字符串 文本, 整64 位置) -> 整64 {
    返回 整64(文本[位置]) & 255;
}

// 数字字符字节值（'0'~'9'/'a'~'f'/'A'~'F'）→ 0~15；非法 = -1
函数 静数字字节值(整64 字节) -> 整64 {
    如果 (字节 >= 48 && 字节 <= 57) { 返回 字节 - 48; }
    如果 (字节 >= 97 && 字节 <= 102) { 返回 字节 - 87; }
    如果 (字节 >= 65 && 字节 <= 70) { 返回 字节 - 55; }
    返回 0 - 1;
}

// 十六进制段（"lo:hi" 形态两段之一）→ 整64 值；空段/非法/超 64 位 = 假
函数 静十六进制段(字符串 文本, 整64 起, 整64 终, 整64& 出) -> 布尔 {
    如果 (终 <= 起) { 返回 假; }
    整64 值 = 0;
    整64 i = 起;
    当 (i < 终) {
        整64 d = 静数字字节值(静字节值(文本, i));
        如果 (d < 0) { 返回 假; }
        如果 (值 > 1152921504606846975) { 返回 假; }   // 值*16 溢出前置判定
        值 = 值 * 16 + d;
        i++;
    }
    出 = 值;
    返回 真;
}

// 128 位静态初值文本 → 高低 64 位（two's complement 双 quad）。对齐宿主
//   types::parseInt128InitText：①"lo:hi" 十六进制两段（IR 常量约定形态）
//   ②+/- 符号 ③0x/0X/0b/0B/0o/0O 前缀（默认十进制）④逐位累加——u64 半字分解
//   （loLo/loHi/hiLo/hiHi × base + carry 各项 < 2^37 无溢出），负数取补码
//   （取反加一·低 64 位归零时向高位进位）。返回 假=非法或超 128 位。
不安全 函数 解析128位初值文本(字符串 文本, 整64& 低出, 整64& 高出) -> 布尔 {
    整64 长 = 字符串长度(文本);
    整64 起 = 0;
    当 (起 < 长 && (静字节值(文本, 起) == 32 || 静字节值(文本, 起) == 9)) { 起++; }
    整64 终 = 长;
    当 (终 > 起 && (静字节值(文本, 终 - 1) == 32 || 静字节值(文本, 终 - 1) == 9)) { 终--; }
    如果 (终 <= 起) { 返回 假; }

    // ① "lo:hi" 形态（冒号分隔十六进制两段·符号无关）
    整64 冒号 = 0 - 1;
    整64 i0 = 起;
    当 (i0 < 终) {
        如果 (静字节值(文本, i0) == 58) { 冒号 = i0; 中断; }
        i0++;
    }
    如果 (冒号 >= 0) {
        整64 低段 = 0;
        整64 高段 = 0;
        如果 (!静十六进制段(文本, 起, 冒号, 低段)) { 返回 假; }
        如果 (!静十六进制段(文本, 冒号 + 1, 终, 高段)) { 返回 假; }
        低出 = 低段;
        高出 = 高段;
        返回 真;
    }

    // ② 符号
    布尔 负 = 假;
    整64 位 = 起;
    整64 首字节v = 静字节值(文本, 位);
    如果 (首字节v == 43 || 首字节v == 45) {
        负 = (首字节v == 45);
        位++;
    }
    如果 (位 >= 终) { 返回 假; }

    // ③ 进制前缀
    正64 进制 = 10;
    如果 (终 - 位 > 2 && 静字节值(文本, 位) == 48) {
        整64 次b = 静字节值(文本, 位 + 1);
        如果 (次b == 120 || 次b == 88) { 进制 = 16; 位 = 位 + 2; }
        否则 如果 (次b == 98 || 次b == 66) { 进制 = 2; 位 = 位 + 2; }
        否则 如果 (次b == 111 || 次b == 79) { 进制 = 8; 位 = 位 + 2; }
    }
    如果 (位 >= 终) { 返回 假; }

    // ④ 逐位累加（半字分解·u64 无溢出）
    正64 低 = 0;
    正64 高 = 0;
    当 (位 < 终) {
        整64 数v = 静数字字节值(静字节值(文本, 位));
        如果 (数v < 0) {
            // 810（053）：类型后缀 L/l/U/u 自断（词法原样存文本·解析无符号 同规
            //   ——324 的 999999999999999999LL 实证）；其余非法字符拒绝
            整64 字节v = 静字节值(文本, 位);
            如果 (字节v == 76 || 字节v == 108 || 字节v == 85 || 字节v == 117) {
                中断;
            }
            返回 假;
        }
        正64 d = 正64(数v);
        如果 (d >= 进制) { 返回 假; }
        正64 低低 = 低 & 4294967295;
        正64 低高 = 低 >> 32;
        正64 t1 = 低低 * 进制 + d;
        正64 进1 = t1 >> 32;
        正64 低高乘 = 低高 * 进制 + 进1;   // 低高吸收进1——其溢出才是高半的进位
        正64 进1b = 低高乘 >> 32;          // 702-fix：原直接传 进1 给高位=重复计入
        正64 新低 = (t1 & 4294967295) | ((低高乘 & 4294967295) << 32);
        正64 高低 = 高 & 4294967295;
        正64 高高位 = 高 >> 32;
        正64 t2 = 高低 * 进制 + 进1b;
        正64 进2 = t2 >> 32;
        正64 新高 = (t2 & 4294967295) | (((高高位 * 进制 + 进2) & 4294967295) << 32);
        低 = 新低;
        高 = 新高;
        位++;
    }
    // 负数 two's complement（取反加一；低 64 位归零时向高位进位）
    如果 (负) {
        正64 反低 = ~低;
        正64 反高 = ~高;
        低 = 反低 + 1;
        如果 (低 == 0) { 高 = 反高 + 1; } 否则 { 高 = 反高; }
    }
    低出 = 整64(低);
    高出 = 整64(高);
    返回 真;
}

// ==================== 128 位双半搬运（810 轮·053 值通道共用件） ====================

// 源句柄寄存器（值=16 字节槽地址）→ 目标槽对双半拷贝。基址槽=低地址
//   （低 64 半·对象首地址）、次槽=高地址（高 64 半）——T96c emitCopy 双半
//   模式的 IR 层等价形态，声明初值/赋值/传参副本/返回缓冲 四消费点共用。
不安全 函数 发射128位双半拷贝(整64 源句柄, 整64 基址槽, 整64 次槽,
                   向量<IR指令>& 指令, 整64* 寄存器计数) -> 空类型 {
    整64 低半寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 源句柄, 0, 0, 低半寄存器, T_整64, 0));
    IR追加(指令, 建IR指令(IR_存储, 低半寄存器, 0, 0, 0, 0, 基址槽));
    整64 高源地址 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 源句柄, 0, 0, 高源地址, T_整64, 8));
    整64 高半寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 高源地址, 0, 0, 高半寄存器, T_整64, 0));
    IR追加(指令, 建IR指令(IR_存储, 高半寄存器, 0, 0, 0, 0, 次槽));
}

// ==================== 128 位二元运算（810 轮·053 批次 E） ====================

// 64 位值操作数 → 128 位槽对物化（提升·返回基址句柄寄存器）。低半=值 64 位
//   补码直存基址槽；高半=符号性分派——有符号码算术右移 63（sar 符号扩展·
//   宿主 movslq+sar 形态对齐）、无符号码/未登记零扩展（常量 0）。
不安全 函数 物化128位操作数(整64 值寄存器, 整64 值码, 整64 有符号,
                   向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数) -> 整64 {
    整64 槽起 = 槽计数[0];
    槽计数[0] = 槽计数[0] + 2;
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽起));
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽起 + 1));
    // 814（053-001）：字面量回扫拆半——值寄存器来源=IR_常量整数 时按**字面量
    //   文本**双半分解（支持 >2^64 大字面量/LL 后缀/负号·解析128位初值文本），
    //   替代 64 位寄存器路径（原大字面量在 IR_常量整数 发射层 movabs 截断——
    //   高半丢失错误值）。回扫未命中（变量/表达式产物）落下方符号扩展路径。
    整64 回物 = 指令.大小();
    当 (回物 > 0) {
        IR指令 回物i = 指令.元素(回物 - 1);
        如果 (回物i.操作码 == IR_常量整数 && 回物i.目标 == 值寄存器) {
            整64 低拆 = 0;
            整64 高拆 = 0;
            如果 (解析128位初值文本(字符串复制(驻留文本(回物i.操作数1)),
                                      低拆, 高拆)) {
                整64 低拆reg = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(低拆)), 0, 0,
                                     低拆reg, T_整64, 0));
                IR追加(指令, 建IR指令(IR_存储, 低拆reg, 0, 0, 0, 0, 槽起 + 1));
                整64 高拆reg = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(高拆)), 0, 0,
                                     高拆reg, T_整64, 0));
                IR追加(指令, 建IR指令(IR_存储, 高拆reg, 0, 0, 0, 0, 槽起));
                整64 拆句柄 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_取地址, 槽起 + 1, 0, 0, 拆句柄,
                                     T_整64, 0));
                登记寄存器类型(拆句柄, 有符号 == 1 ? T_整128 : T_正128);
                返回 拆句柄;
            }
            中断;
        }
        回物--;
    }
    IR追加(指令, 建IR指令(IR_存储, 值寄存器, 0, 0, 0, 0, 槽起 + 1));
    整64 高寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    如果 (有符号 == 1) {
        // 算术右移 63 = 符号扩展（v2 IR_右移=有符号算术右移·sar）
        整64 移量寄存器 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_常量整数, 驻留("63"), 0, 0,
                             移量寄存器, T_整64, 0));
        IR追加(指令, 建IR指令(IR_右移, 值寄存器, 移量寄存器, 0,
                             高寄存器, T_整64, 0));
    } 否则 {
        IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0,
                             高寄存器, T_整64, 0));
    }
    IR追加(指令, 建IR指令(IR_存储, 高寄存器, 0, 0, 0, 0, 槽起));
    整64 句柄 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_取地址, 槽起 + 1, 0, 0, 句柄, T_整64, 0));
    登记寄存器类型(句柄, 有符号 == 1 ? T_整128 : T_正128);
    返回 句柄;
}

// 818（064）：整数字面量「超 整128 域」判定（宿主 ir_expr.cpp parseInt128InitText
//   前判据同构=剥符号/进制约/后缀→数字串，正/负各一限串做「位数+字典序」比较；
//   非十进制按位数上限预判+拆半判）。超域 → 调用侧诊断拒绝（宿主文案对齐
//   「整数字面量超出整128（2^127-1）范围」）。负号限串=2^127（-2^127 域内合法）。
函数 字面量超128域(字符串 文本) -> 布尔 {
    整64 长 = 字符串长度(文本);
    整64 起 = 0;
    当 (起 < 长 && (静字节值(文本, 起) == 32 || 静字节值(文本, 起) == 9)) { 起++; }
    布尔 负 = 假;
    如果 (起 < 长 && 静字节值(文本, 起) == 45) { 负 = 真; 起++; }
    如果 (起 >= 长) { 返回 假; }
    // 进制约
    整64 进制 = 10;
    如果 (长 - 起 > 2 && 静字节值(文本, 起) == 48) {
        整64 次b = 静字节值(文本, 起 + 1);
        如果 (次b == 120 || 次b == 88) { 进制 = 16; 起 = 起 + 2; }
        否则 如果 (次b == 98 || 次b == 66) { 进制 = 2; 起 = 起 + 2; }
        否则 如果 (次b == 111 || 次b == 79) { 进制 = 8; 起 = 起 + 2; }
    }
    // 数字串长度（至后缀/尾空白）
    整64 位数 = 0;
    整64 i = 起;
    当 (i < 长) {
        整64 d = 静数字字节值(静字节值(文本, i));
        如果 (d < 0 || d >= 进制) { 中断; }
        位数++;
        i++;
    }
    如果 (进制 == 16) {
        如果 (位数 > 32) { 返回 真; }
        返回 假;                       // 32 位 hex 覆盖无符号全宽（有符号界另由拆半消费面控）
    }
    如果 (进制 == 8) {
        如果 (位数 > 42) { 返回 真; }
        返回 假;
    }
    如果 (进制 == 2) {
        如果 (位数 > 128) { 返回 真; }
        返回 假;
    }
    // 十进制：位数+字典序（正限 2^127-1·负限 2^127）
    如果 (位数 > 39) { 返回 真; }
    如果 (位数 < 39) { 返回 假; }
    字符串 数字串 = 字符串子串(文本, 起, 整32(位数));
    字符串 限串 = 负 ? "170141183460469231731687303715884105728"
                    : "170141183460469231731687303715884105727";
    整64 k = 0;
    当 (k < 39) {
        整64 a = 静字节值(数字串, k);
        整64 b = 静字节值(限串, k);
        如果 (a > b) { 返回 真; }
        如果 (a < b) { 返回 假; }
        k++;
    }
    返回 假;
}

// 814（053-001）：隐式窄化——64 位目标上下文收到 128 位值（地址句柄）时装载
//   低半（宿主 emitCast 隐式截断同款·规范 218 提升链的回落）。挂点=声明初值/
//   赋值/实参等 64 位消费点（超域字面量经 生成字面量 物化为 128 位后，64 位
//   上下文须窄化——446/447 的 `整64 a64 = -9223372036854775808` 句柄直存
//   实证）。
不安全 函数 隐式窄化到64(整64 值寄存器, 向量<IR指令>& 指令,
                    整64* 寄存器计数) -> 整64 {
    整64 窄码 = 查寄存器类型(值寄存器);
    如果 (窄码 == T_整128 || 窄码 == T_正128) {
        整64 低半reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_指针加载, 值寄存器, 0, 0, 低半reg, T_整64, 0));
        返回 低半reg;
    }
    返回 值寄存器;
}

// 814（053-001）：已知拆半值的 128 位字面量物化（生成字面量 大字面量分支用）
//   ——2 槽+双半常量整数直存+基址句柄+登记 T_整128（无后缀超 整64 域字面量
//   按规范 218 提升链归 整128）。
不安全 函数 物化字面量128位(整64 拆低, 整64 拆高, 向量<IR指令>& 指令,
                   整64* 寄存器计数, 整64* 槽计数) -> 整64 {
    整64 槽起 = 槽计数[0];
    槽计数[0] = 槽计数[0] + 2;
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽起));
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽起 + 1));
    整64 低reg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(拆低)), 0, 0,
                         低reg, T_整64, 0));
    IR追加(指令, 建IR指令(IR_存储, 低reg, 0, 0, 0, 0, 槽起 + 1));
    整64 高reg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(拆高)), 0, 0,
                         高reg, T_整64, 0));
    IR追加(指令, 建IR指令(IR_存储, 高reg, 0, 0, 0, 0, 槽起));
    整64 句柄 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_取地址, 槽起 + 1, 0, 0, 句柄, T_整64, 0));
    登记寄存器类型(句柄, T_整128);
    返回 句柄;
}

// 128 位二元运算主体（算术五算子+比较六算子·辅助函数路线）。操作数=地址
//   句柄（64 位值操作数经 物化128位操作数 提升）；结果=2 槽临时基址句柄
//   （算术）或 T_布尔（比较·__cn_cmp_i128/u128 返回 -1/0/1 与 0 二次比较）。
//   返回 真=已处理；假=非 128 位运算（调用方走原路径）。
不安全 函数 发射128位二元运算(整64 op, 整64 左, 整64 右,
                   向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数,
                   向量<整64>& 表达式栈) -> 布尔 {
    整64 左码 = 查寄存器类型(左);
    整64 右码 = 查寄存器类型(右);
    布尔 左128 = 左码 == T_整128 || 左码 == T_正128;
    布尔 右128 = 右码 == T_整128 || 右码 == T_正128;
    如果 (!左128 && !右128) { 返回 假; }
    布尔 有符号 = 左码 != T_正128;   // 混合符号取左（宽松·与 46-f 混宽语义一致）
    // 提升：64 位侧物化（按其自身符号性扩展）
    整64 左句柄 = 左;
    整64 右句柄 = 右;
    如果 (!左128) {
        左句柄 = 物化128位操作数(左, 左码, 左码 == T_正32 || 左码 == T_正64 ? 0 : 1,
                                 指令, 寄存器计数, 槽计数);
    }
    如果 (!右128) {
        右句柄 = 物化128位操作数(右, 右码, 右码 == T_正32 || 右码 == T_正64 ? 0 : 1,
                                 指令, 寄存器计数, 槽计数);
    }
    // 比较六算子：__cn_cmp_i128/u128(a, b) → rc(-1/0/1) → 与 0 二次比较
    如果 (op == IR_相等 || op == IR_不等 || op == IR_小于 || op == IR_大于 ||
         op == IR_小于等于 || op == IR_大于等于) {
        整64 比较寄存器 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        字符串 比较符号 = 有符号 ? "__cn_cmp_i128" : "__cn_cmp_u128";
        IR追加(指令, 建IR指令(IR_调用实参, 左句柄, 0, 0, 0, 0, 0));
        IR追加(指令, 建IR指令(IR_调用实参, 右句柄, 0, 0, 1, 0, 0));
        IR追加(指令, 建IR指令(IR_调用参数化, 2, T_整32, 0,
                             比较寄存器, 0, 驻留(比较符号)));
        // rc 与 0 的二次比较（产物=T_布尔·原比较算子直用 64 位通道）
        整64 零寄存器 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0,
                             零寄存器, T_整32, 0));
        整64 产物寄存器 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(op, 比较寄存器, 零寄存器, 0,
                             产物寄存器, T_整32, 0));
        登记寄存器类型(产物寄存器, T_布尔);
        结果<空类型, 整32> 加比较 = 表达式栈.追加(产物寄存器);
        如果 (!加比较.正常) { 运行时错误(4); }
        返回 真;
    }
    // 814（053-001）：移位 << >>（128 位左移/算术右移）——runtime __cn_shl_i128/
    //   __cn_shr_i128(左句柄, 移位量64位值, dst地址)；移位量掩码 &0x7f 语义在
    //   运行时实现（宿主内联 shld 分支同语义·t3/539 锚定）。仅左=128 走本通道。
    如果 (op == IR_左移 || op == IR_右移) {
        // 移位须左=128（右=移位量）；左非 128（64 位值移 128 位量）面外回退
        如果 (!左128) { 返回 假; }
        整64 移量寄存器 = 右;
        如果 (右码 == T_整128 || 右码 == T_正128) {
            移量寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 右句柄, 0, 0, 移量寄存器, T_整64, 0));
        }
        整64 移槽起 = 槽计数[0];
        槽计数[0] = 槽计数[0] + 2;
        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 移槽起));
        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 移槽起 + 1));
        整64 移dst = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_取地址, 移槽起 + 1, 0, 0, 移dst, T_整64, 0));
        整64 移调用 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_调用实参, 左句柄, 0, 0, 0, 0, 0));
        IR追加(指令, 建IR指令(IR_调用实参, 移量寄存器, 0, 0, 1, 0, 0));
        IR追加(指令, 建IR指令(IR_调用实参, 移dst, 0, 0, 2, 0, 0));
        IR追加(指令, 建IR指令(IR_调用参数化, 3, 0, 0, 移调用, 0,
                             驻留(op == IR_左移 ? "__cn_shl_i128" : "__cn_shr_i128")));
        整64 移句柄 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_取地址, 移槽起 + 1, 0, 0, 移句柄, T_整64, 0));
        登记寄存器类型(移句柄, 有符号 ? T_整128 : T_正128);
        结果<空类型, 整32> 加移 = 表达式栈.追加(移句柄);
        如果 (!加移.正常) { 运行时错误(4); }
        返回 真;
    }
    // 814（053-001）：位运算 & | ^（双半独立内联·无进位）——低/高半各自 op 后
    //   写 dst 槽对；产物=基址句柄。
    如果 (op == IR_位与 || op == IR_位或 || op == IR_位异或) {
        整64 位槽起 = 槽计数[0];
        槽计数[0] = 槽计数[0] + 2;
        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 位槽起));
        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 位槽起 + 1));
        整64 半i = 0;
        当 (半i < 2) {
            整64 偏 = 半i * 8;
            整64 左半地址 = 左句柄;
            整64 右半地址 = 右句柄;
            如果 (半i == 1) {
                左半地址 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_字段地址, 左句柄, 0, 0, 左半地址, T_整64, 8));
                右半地址 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_字段地址, 右句柄, 0, 0, 右半地址, T_整64, 8));
            }
            整64 左半 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 左半地址, 0, 0, 左半, T_整64, 0));
            整64 右半 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 右半地址, 0, 0, 右半, T_整64, 0));
            整64 半果 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(op, 左半, 右半, 0, 半果, T_整64, 0));
            IR追加(指令, 建IR指令(IR_存储, 半果, 0, 0, 0, 0,
                                 半i == 0 ? 位槽起 + 1 : 位槽起));
            半i++;
        }
        整64 位句柄 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_取地址, 位槽起 + 1, 0, 0, 位句柄, T_整64, 0));
        登记寄存器类型(位句柄, 有符号 ? T_整128 : T_正128);
        结果<空类型, 整32> 加位 = 表达式栈.追加(位句柄);
        如果 (!加位.正常) { 运行时错误(4); }
        返回 真;
    }
    // 算术五算子：__cn_add/sub/mul/div/mod_i128|u128(a, b, dst)——dst=2 槽
    //   临时基址；产物=基址句柄（T_整128/T_正128·打印传址/再运算/赋值消费）。
    //   add/sub 无符号与有符号位模式等价（模 2^128）→ 正128 复用 i128 版。
    整64 结果槽起 = 槽计数[0];
    槽计数[0] = 槽计数[0] + 2;
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 结果槽起));
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 结果槽起 + 1));
    整64 结果基址 = 结果槽起 + 1;
    字符串 辅助符号 = "__cn_add_i128";
    如果 (op == IR_加) { 辅助符号 = "__cn_add_i128"; }
    否则 如果 (op == IR_减) { 辅助符号 = "__cn_sub_i128"; }
    否则 如果 (op == IR_乘) { 辅助符号 = 有符号 ? "__cn_mul_i128" : "__cn_mul_u128"; }
    否则 如果 (op == IR_除) { 辅助符号 = 有符号 ? "__cn_div_i128" : "__cn_div_u128"; }
    否则 如果 (op == IR_取余) { 辅助符号 = 有符号 ? "__cn_mod_i128" : "__cn_mod_u128"; }
    否则 { 返回 假; }
    // dst 实参=结果槽基址**地址寄存器**（IR_取地址 先于 call——IR_调用实参
    //   操作数1=寄存器号，槽号直传=发射层读垃圾地址·t4 段错误实证修正）
    整64 dst寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_取地址, 结果基址, 0, 0, dst寄存器, T_整64, 0));
    整64 调用寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_调用实参, 左句柄, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用实参, 右句柄, 0, 0, 1, 0, 0));
    IR追加(指令, 建IR指令(IR_调用实参, dst寄存器, 0, 0, 2, 0, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 3, 0, 0,
                         调用寄存器, 0, 驻留(辅助符号)));
    整64 产物句柄 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_取地址, 结果基址, 0, 0, 产物句柄, T_整64, 0));
    登记寄存器类型(产物句柄, 有符号 ? T_整128 : T_正128);
    结果<空类型, 整32> 加算术 = 表达式栈.追加(产物句柄);
    如果 (!加算术.正常) { 运行时错误(4); }
    返回 真;
}
