// IR布局中（356 重构F1 自 IR布局.cn 纯机械搬移·函数体逐字保留·零逻辑变化）

导入 容器::向量;
导入 映射集合;
导入 IR;         // IR指令/签名辅助/节点_* 常量（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）


函数 资源字段数(整64 结构体名ID) -> 整64 {
    整64 键基c = 结构体布局键基(结构体名ID);
    如果 (键基c == 0) { 返回 0; }
    结果<整64, 整32> 查 = 结构体资源字段数.获取(键基c);
    如果 (查.正常) { 返回 查.值; }
    返回 0;
}

// 164-a（A4 方案A·plans/023 §十二）：标量类型文本判定（可平凡复制基础面）。
// 657-a（024/D43 单一归属收口）：删除「整数/小数」防御分支——164-a 时词法层
函数 是标量类型文本(字符串 文本) -> 布尔 {
    返回 (字符串比较(文本, "整8") || 字符串比较(文本, "整16") ||
            字符串比较(文本, "整32") || 字符串比较(文本, "整64") ||
            字符串比较(文本, "整128") ||
            字符串比较(文本, "正8") || 字符串比较(文本, "正16") ||
            字符串比较(文本, "正32") || 字符串比较(文本, "正64") ||
            字符串比较(文本, "正128") ||
            字符串比较(文本, "浮32") || 字符串比较(文本, "浮64") ||
            字符串比较(文本, "布尔") || 字符串比较(文本, "字符") ||
            字符串比较(文本, "空类型"));
}

// 164-a：指针类型文本判定（末字符 '*'——含 字符* 借用视图；可平凡复制）
函数 是指针类型文本(字符串 文本) -> 布尔 {
    整64 长p = 字符串长度(文本);
    如果 (长p == 0) { 返回 假; }
    返回 ((整64(文本[整32(长p - 1)]) & 255) == 42);
}

// ==================== T69（480-a）函数指针类型文本族（单一归属） ====================
// 合成文本 = `函数指针<返回类型>(参数1,参数2,...)`（宿主 FuncPtrTypeInfo::toString

// ==================== T69（480-a）参数串深度切段族（单一归属） ====================
// 参数串=签名键 '名#参数串' 的逗号分隔参数类型文本。函数指针类型文本
函数 参数串段数(字符串 参数串) -> 整64 {
    如果 (字符串长度(参数串) == 0) { 返回 0; }
    整64 个数480 = 1;
    整64 深度480 = 0;
    整64 i480 = 0;
    当 (i480 < 字符串长度(参数串)) {
        整64 字节480 = 整64(参数串[i480]) & 255;
        如果 (字节480 == 40) { 深度480++; }
        否则 如果 (字节480 == 41) {
            如果 (深度480 > 0) { 深度480--; }
        } 否则 如果 (字节480 == 44) {
            如果 (深度480 == 0) { 个数480++; }
        }
        i480++;
    }
    返回 个数480;
}

函数 参数串切段(字符串 参数串, 向量<字符串>& 出) -> 空类型 {
    整64 起点480 = 0;
    整64 深度480b = 0;
    整64 i480b = 0;
    当 (i480b <= 字符串长度(参数串)) {
        布尔 边界480 = i480b == 字符串长度(参数串);
        如果 (!边界480) {
            整64 字节480b = 整64(参数串[i480b]) & 255;
            如果 (字节480b == 40) { 深度480b++; }
            否则 如果 (字节480b == 41) {
                如果 (深度480b > 0) { 深度480b--; }
            } 否则 如果 (字节480b == 44) {
                如果 (深度480b == 0) { 边界480 = 真; }
            }
        }
        如果 (边界480) {
            结果<空类型, 整32> 加段480 = 出.追加(字符串子串(参数串, 起点480, i480b - 起点480));
            如果 (!加段480.正常) { 运行时错误(4); }
            起点480 = i480b + 1;
        }
        i480b++;
    }
}

// 是函数指针类型文本（前缀判定；⚠ v2 字符串族按**字节**（UTF-8）度量——
//   "函数指针<" = 4 汉字 ×3 字节 + '<' = 13 字节；最短 "函数指针<>()" = 16 字节）
函数 是函数指针类型文本(字符串 文本) -> 布尔 {
    整64 长f = 字符串长度(文本);
    如果 (长f < 16) { 返回 假; }
    返回 字符串比较(字符串子串(文本, 0, 13), "函数指针<");
}

// 函数指针返回类型文本（`函数指针<` 与匹配 '>' 之间；非形态/残缺=空串）
//   深度计数隔离嵌套泛型 `向量<整32>`；参数表内不再出现 '<'（泛型实参合成名用 $）。
函数 函数指针返回文本(字符串 文本) -> 字符串 {
    如果 (!是函数指针类型文本(文本)) { 返回 ""; }
    整64 起 = 13;   // "函数指针<" 字节长度
    整64 深度 = 1;
    整64 i = 起;
    当 (i < 字符串长度(文本)) {
        字符串 字 = 字符串子串(文本, 整32(i), 1);
        如果 (字符串比较(字, "<")) { 深度++; }
        否则 如果 (字符串比较(字, ">")) {
            深度--;
            如果 (深度 == 0) { 返回 字符串子串(文本, 整32(起), 整32(i - 起)); }
        }
        i++;
    }
    返回 "";
}

// 函数指针参数表文本（返回类型闭 '>' 之后首个 '(' 到末 ')' 之间；非形态=空串）
函数 函数指针参数文本(字符串 文本) -> 字符串 {
    整64 长f = 字符串长度(文本);
    如果 (!是函数指针类型文本(文本)) { 返回 ""; }
    整64 开 = 0 - 1;
    整64 i = 0;
    当 (i < 长f) {
        如果 (字符串比较(字符串子串(文本, 整32(i), 1), "(")) { 开 = i; 中断; }
        i++;
    }
    如果 (开 < 0) { 返回 ""; }
    整64 闭 = 长f - 1;
    当 (闭 > 开) {
        如果 (字符串比较(字符串子串(文本, 整32(闭), 1), ")")) { 中断; }
        闭--;
    }
    如果 (闭 <= 开) { 返回 ""; }
    返回 字符串子串(文本, 整32(开 + 1), 整32(闭 - 开 - 1));
}

// 函数指针参数个数（空参数表=0；逗号分隔计数——参数含嵌套函数指针时按内外层
//   逗号区分：深度计数（'(' / ')'）隔离内层。宿主 funcPtrParamsOf 简单逗号切分
//   在嵌套形态上会误切（宿主已知边界·本实现按嵌套正确计数）。
函数 函数指针参数个数(字符串 文本) -> 整64 {
    字符串 参数表 = 函数指针参数文本(文本);
    如果 (字符串长度(参数表) == 0) { 返回 0; }
    整64 个数 = 1;
    整64 深度 = 0;
    整64 i = 0;
    当 (i < 字符串长度(参数表)) {
        字符串 字 = 字符串子串(参数表, 整32(i), 1);
        如果 (字符串比较(字, "(")) { 深度++; }
        否则 如果 (字符串比较(字, ")")) {
            如果 (深度 > 0) { 深度--; }
        }
        否则 如果 (字符串比较(字, ",")) {
            如果 (深度 == 0) { 个数++; }
        }
        i++;
    }
    返回 个数;
}

// 函数指针同签名判定（返回类型+参数表逐字相等——宿主 types::canConvert
//   fnptr 分支「规范化后字符串精确相等」同构；调用方保证双方均函数指针）。
函数 函数指针同签名(字符串 a, 字符串 b) -> 布尔 {
    如果 (!函数指针类型文本比较(函数指针返回文本(a), 函数指针返回文本(b))) { 返回 假; }
    返回 函数指针类型文本比较(函数指针参数文本(a), 函数指针参数文本(b));
}

// 函数指针参数段文本（参数表内第 序号 段的类型文本·0 起；逗号深度计数切分与
//   参数个数 同构——嵌套函数指针形参的内层逗号不切分；越界=0）。
// 421（070·wt421）间接调用 128 位形参宽化的表驱动判据源（签名在编译期可得）。
函数 函数指针参数段文本(字符串 参数表, 整64 序号) -> 整64 {
    整64 当前段f = 0;
    整64 段起f = 0;
    整64 深度f = 0;
    整64 i = 0;
    当 (i < 字符串长度(参数表)) {
        字符串 字 = 字符串子串(参数表, 整32(i), 1);
        如果 (字符串比较(字, "(")) { 深度f++; }
        否则 如果 (字符串比较(字, ")")) {
            如果 (深度f > 0) { 深度f--; }
        } 否则 如果 (字符串比较(字, ",") && 深度f == 0) {
            如果 (当前段f == 序号) {
                返回 驻留(字符串子串(参数表, 整32(段起f), 整32(i - 段起f)));
            }
            当前段f++;
            段起f = i + 1;
        }
        i++;
    }
    如果 (当前段f == 序号 && 段起f <= 字符串长度(参数表)) {
        返回 驻留(字符串子串(参数表, 整32(段起f),
                             整32(字符串长度(参数表) - 段起f)));
    }
    返回 0;
}

// 文本相等（单点包装——合成名字段比较统一走 字符串比较，便于后续收紧）
函数 函数指针类型文本比较(字符串 a, 字符串 b) -> 布尔 {
    返回 字符串比较(a, b);
}

// 164-a（A4 方案A·plans/023 §十二）：可平凡复制判定（宿主 isTriviallyCopyable 同构）——
//   联合体成员类型限定的判定核心。标量/指针/数组（递归元素）/结构体（资源字段数与
函数 可平凡复制v2(字符串 类型文本) -> 布尔 {
    如果 (是标量类型文本(类型文本)) { 返回 真; }
    如果 (是指针类型文本(类型文本)) { 返回 真; }
    // 040（001 §5.8 甲案）：函数指针=8 字节代码地址槽——可平凡复制（浅拷安全·
    //   联合体成员/结构体字段值语义；非资源无析构——603 联合体位 A4 判定消费）
    如果 (是函数指针类型文本(类型文本)) { 返回 真; }
    如果 (字符串比较(类型文本, "字符串")) { 返回 假; }
    如果 (是容器类(类型文本)) { 返回 假; }
    如果 (是数组类型文本(类型文本)) {
        返回 可平凡复制v2(数组元素文本(类型文本));
    }
    如果 (查结构体类型(驻留(类型文本)) != 0) {
        如果 (资源字段数(驻留(类型文本)) > 0) { 返回 假; }
        如果 (串字段数(驻留(类型文本)) > 0) { 返回 假; }
        返回 真;
    }
    返回 假;
}

// 取结构体全部容器字段四元组（写入出参向量：[字段名ID, 字段类型ID, 偏移] 三元组平铺）
函数 取资源字段们(整64 结构体名ID, 向量<整64>& 出) -> 空类型 {
    整64 键基r = 结构体布局键基(结构体名ID);
    如果 (键基r == 0) { 返回; }
    整64 i = 0;
    当 (i + 3 <= 资源字段表们.大小()) {
        如果 (资源字段表们.元素(i) == 键基r) {
            结果<空类型, 整32> 加名 = 出.追加(资源字段表们.元素(i + 1));
            如果 (!加名.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加类 = 出.追加(资源字段表们.元素(i + 2));
            如果 (!加类.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加偏 = 出.追加(资源字段表们.元素(i + 3));
            如果 (!加偏.正常) { 运行时错误(4); }
        }
        i += 4;
    }
}

// ==================== 217 可搬运判定族（027 波2a·001 §5.8a） ====================
// 类型可搬运判定（v2 版·对标 Rust Send）——新线程 实参位检查数据面。

// 文本子段提取（[起,终) 字节区间·编译器内部拼接）
// 419 根治：原逐字符 `出 = 出 + 文本[i]`——文本[i]=数值字节，字符串+整数=
//   十进制拼接，产物=「-27-114-97…」数字串（dbg 实证）→驻留成未知名→
//   结构体布局键基=0 不识别→$ 分段载荷全部放行（627 实证）。改运行时
//   字符串子串（IR布局.cn 96/300 先例·(文本,起,长) 口径）字节正确。
函数 剥段文本217(字符串 文本, 整64 起, 整64 终) -> 字符串 {
    返回 字符串子串(文本, 整32(起), 整32(终 - 起));
}

// 文本含指定字节（编译器内部扫描）
函数 文本含字节217(字符串 文本, 整64 字节) -> 布尔 {
    整64 长217 = 字符串长度(文本);
    整64 i = 0;
    当 (i < 长217) {
        如果 ((整64(文本[整32(i)]) & 255) == 字节) { 返回 真; }
        i++;
    }
    返回 假;
}

// 文本前缀判定（编译器内部字节比较·与运行时 字符串前缀 内置无关）
函数 文本前缀217(字符串 文本, 字符串 前缀) -> 布尔 {
    整64 长1 = 字符串长度(文本);
    整64 长2 = 字符串长度(前缀);
    如果 (长1 < 长2) { 返回 假; }
    整64 i = 0;
    当 (i < 长2) {
        如果 ((整64(文本[整32(i)]) & 255) != (整64(前缀[整32(i)]) & 255)) { 返回 假; }
        i++;
    }
    返回 真;
}

// 取结构体/类全字段（[字段名ID, 字段类型ID] 对输出·照 取资源字段们 线性扫结构）
函数 取全字段们(整64 结构体名ID, 向量<整64>& 出) -> 空类型 {
    整64 键基f = 结构体布局键基(结构体名ID);
    如果 (键基f == 0) { 返回; }
    整64 i = 0;
    当 (i + 2 <= 结构体全字段表们.大小()) {
        如果 (结构体全字段表们.元素(i) == 键基f) {
            结果<空类型, 整32> 加名 = 出.追加(结构体全字段表们.元素(i + 1));
            如果 (!加名.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加类 = 出.追加(结构体全字段表们.元素(i + 2));
            如果 (!加类.正常) { 运行时错误(4); }
        }
        i += 3;
    }
}

// 类型可搬运判定（递归·链 输出最近违规字段链）
函数 可搬运判定(整64 类型名ID, 整32 深度, 字符串& 链) -> 布尔 {
    如果 (深度 > 12) { 返回 真; }
    如果 (类型名ID <= 0) { 返回 真; }
    字符串 文本 = 字符串复制(驻留文本(类型名ID));
    整64 长217 = 字符串长度(文本);
    如果 (长217 == 0) { 返回 真; }
    // 条文①：标量/字符串恒可搬运
    如果 (字符串比较(文本, "布尔") || 字符串比较(文本, "字符") ||
         字符串比较(文本, "空类型") || 字符串比较(文本, "字符串") ||
         字符串比较(文本, "整8") || 字符串比较(文本, "整16") ||
         字符串比较(文本, "整32") || 字符串比较(文本, "整64") ||
         字符串比较(文本, "整128") || 字符串比较(文本, "正8") ||
         字符串比较(文本, "正16") || 字符串比较(文本, "正32") ||
         字符串比较(文本, "正64") || 字符串比较(文本, "浮32") ||
         字符串比较(文本, "浮64")) { 返回 真; }
    // 条文④：裸指针（末字符 '*'·164-a 判定同源）默认不可搬运
    如果 (是指针类型文本(文本)) {
        如果 (字符串长度(链) == 0) { 链 = 字符串复制(文本); }
        返回 假;
    }
    // 条文①：函数指针=代码指针恒可（T69 合成文本前缀）
    如果 (文本前缀217(文本, "函数指针<")) { 返回 真; }
    // 数组：随元素类型（首个 '[' 91 前的元素类型文本）
    整64 括217 = 0;
    整64 扫217 = 0;
    当 (扫217 < 长217) {
        如果 ((整64(文本[整32(扫217)]) & 255) == 91) { 括217 = 扫217; 扫217 = 长217; }
        扫217++;
    }
    如果 (括217 > 0 && 括217 > 0) {
        如果 (括217 == 0) { 返回 真; }
        返回 可搬运判定(驻留(剥段文本217(文本, 0, 括217)), 深度 + 1, 链);
    }
    // 条文②：结果/可选（$ 合成形态·跳过基名段后逐实参段递归）
    如果 (文本前缀217(文本, "结果") || 文本前缀217(文本, "可选")) {
        // 419（002 收口·尖括号源文本形态）：语义符号表登记的 结果<T,E> 类型
        //   文本=尖括号源形态（无 $ 分隔）——原 36 分段遇之=整段自递归 12 层
        //   熔断放行（627 实证 v2 放行 vs 宿主拒=零分叉违例）。修='<' 段首、
        //   ','/'>' 括深 1 处分段递归载荷·trim 首尾空白·括深跟踪嵌套；
        //   $ 合成形态（无 '<'）走原 36 分段路径零变化。
        整64 尖起419 = 0;
        当 (尖起419 < 长217 && (整64(文本[整32(尖起419)]) & 255) != 60) { 尖起419++; }
        如果 (尖起419 < 长217) {
            布尔 全可尖419 = 真;
            整64 段起尖419 = 尖起419 + 1;
            整64 括深尖419 = 1;
            整64 k尖419 = 段起尖419;
            当 (k尖419 <= 长217) {
                整64 字节尖419 = 0;
                如果 (k尖419 < 长217) { 字节尖419 = (整64(文本[整32(k尖419)]) & 255); }
                如果 (k尖419 == 长217 ||
                     ((字节尖419 == 44 || 字节尖419 == 62) && 括深尖419 == 1)) {
                    如果 (段起尖419 < k尖419) {
                        字符串 载荷尖419 = 剥段文本217(文本, 段起尖419, k尖419);
                        整64 首尖419 = 0;
                        整64 尾尖419 = 字符串长度(载荷尖419);
                        当 (首尖419 < 尾尖419 &&
                            (整64(载荷尖419[整32(首尖419)]) & 255) == 32) { 首尖419++; }
                        当 (尾尖419 > 首尖419 &&
                            (整64(载荷尖419[整32(尾尖419 - 1)]) & 255) == 32) { 尾尖419--; }
                        如果 (尾尖419 > 首尖419) {
                            如果 (!可搬运判定(驻留(剥段文本217(载荷尖419, 首尖419, 尾尖419)),
                                              深度 + 1, 链)) {
                                全可尖419 = 假;
                            }
                        }
                    }
                    段起尖419 = k尖419 + 1;
                }
                如果 (字节尖419 == 60) { 括深尖419++; }
                否则 如果 (字节尖419 == 62) { 括深尖419--; }
                k尖419++;
            }
            返回 全可尖419;
        }
        布尔 全可217 = 真;
        整64 段起 = 0;
        整64 k = 0;
        当 (k <= 长217) {
            如果 (k == 长217 || (整64(文本[整32(k)]) & 255) == 36) {
                如果 (段起 < k) {
                    如果 (!可搬运判定(驻留(剥段文本217(文本, 段起, k)), 深度 + 1, 链)) {
                        全可217 = 假;
                    }
                }
                段起 = k + 1;
            }
            k++;
        }
        返回 全可217;
    }
    // 条文②：容器实例（$ 形态·基名白名单）随全部实参段
    如果 (文本含字节217(文本, 36)) {
        整64 基名尾 = 0;
        当 (基名尾 < 长217 && (整64(文本[整32(基名尾)]) & 255) != 36) { 基名尾++; }
        字符串 基名 = 剥段文本217(文本, 0, 基名尾);
        如果 (字符串比较(基名, "向量") || 字符串比较(基名, "映射") ||
             字符串比较(基名, "集合") || 字符串比较(基名, "链表") ||
             字符串比较(基名, "栈") || 字符串比较(基名, "队列") ||
             字符串比较(基名, "互斥锁")) {
            布尔 全可c = 真;
            整64 段起c = 基名尾 + 1;
            整64 kc = 段起c;
            当 (kc <= 长217) {
                如果 (kc == 长217 || (整64(文本[整32(kc)]) & 255) == 36) {
                    如果 (段起c < kc) {
                        如果 (!可搬运判定(驻留(剥段文本217(文本, 段起c, kc)), 深度 + 1, 链)) {
                            全可c = 假;
                        }
                    }
                    段起c = kc + 1;
                }
                kc++;
            }
            返回 全可c;
        }
    }
    // 条文③④：结构体/类=全字段递归（豁免查→全字段表遍历）
    整64 键基217 = 结构体布局键基(类型名ID);
    如果 (键基217 > 0) {
        // 「不安全 可搬运」显式豁免（语法分析 层登记·键基域）
        如果 (是可搬运豁免键基(键基217)) { 返回 真; }
        向量<整64> 字段们 = 向量<整64>();
        取全字段们(类型名ID, 字段们);
        布尔 全可s = 真;
        整64 fi = 0;
        当 (fi + 1 < 字段们.大小()) {
            字符串 子链 = "";
            如果 (!可搬运判定(字段们.元素(fi + 1), 深度 + 1, 子链)) {
                如果 (字符串长度(链) == 0) {
                    字符串 字段名文本 = 字符串复制(驻留文本(字段们.元素(fi)));
                    如果 (字符串长度(子链) > 0 && 文本含字节217(子链, 46)) {
                        链 = 字段名文本 + "." + 子链;
                    } 否则 {
                        链 = 字符串复制(字段名文本);
                    }
                }
                全可s = 假;
            }
            fi += 2;
        }
        返回 全可s;
    }
    返回 真;   // 未识别类型 → 保守放行（内置豁免窗口 sunset=218）
}

// ==================== 顶层常量收集（P7a，2026-09-01） ====================// ==================== 顶层常量收集（P7a，2026-09-01） ====================
// 常量表：键基ID -> 值文本ID（十进制文本）。代码生成 IR_常量整数 直接经
静态 映射<整64, 整64> 常量表;
静态 映射<整64, 整64> 常量候选键基们;   // 名ID*键位移+序 -> 键基ID
静态 映射<整64, 整64> 常量候选数们;     // 名ID -> 候选数

// 790（569 采样轮 H1）：整数字面量文本 → 规范十进制文本（驻留 ID·0=失败）。
//   作用：静态槽/裸全局 .data 直存初始值文本的单一数值化通道——原节点文本
//   原文透传被三平台汇编器拒绝（MASM dq 0xFF A2206 / dq 111111111111L
//   A2048·GAS .quad ...L 同病）。剥 +/- 符号、0x/0b/0o/十进制前缀与 L/U
//   类型后缀（词法原样存文本），对十进制数字数组「乘 base 加 d」转换
//   （任意精度——超 64 位文本同样十进制化）→ 三后端 dq/.quad 十进制直存；
//   与宿主 foldIntLiteralText 同构（零分叉：宿主十进制面走 728v 文本保真，
//   非十进制面 u64 累加——≤64 位域输出逐字一致）。
//   与近邻职责分界（非重复实现）：折叠文本转值1029=十进制文本→整64 值
//   （算术折叠用）；解析128位初值文本=文本→(低,高) 位模式（128 槽用）；
//   本函数=任意形态文本→十进制文本（.data 直存用）——输出形态不同。
//   失败（无数字位/进制外字节/后缀段非 L/U）＝词法已拒 用户错误形态
//   （上游已诊断），调用方按原文保真交下游（128 位通道解析/域外判拒）。
函数 字面量十进制文本(字符串 文本) -> 整64 {
    整64 长 = 字符串长度(文本);
    整64 起 = 0;
    当 (起 < 长 && ((整64(文本[整32(起)]) & 255) == 32 ||
                   (整64(文本[整32(起)]) & 255) == 9)) { 起++; }
    整64 终 = 长;
    当 (终 > 起 && ((整64(文本[整32(终 - 1)]) & 255) == 32 ||
                   (整64(文本[整32(终 - 1)]) & 255) == 9)) { 终--; }
    如果 (终 <= 起) { 返回 0; }
    // 符号（±）：字面量节点文本通常无符号（负号=独立 节点_负号），兼容折叠
    //   文本带前导 '-' 的形态（取常量下标值 474 同款判定）
    布尔 负790 = 假;
    整64 位790 = 起;
    整64 首b790 = 整64(文本[整32(位790)]) & 255;
    如果 (首b790 == 43 || 首b790 == 45) {
        负790 = (首b790 == 45);
        位790++;
    }
    // 进制前缀（0x/0b/0o；与 解析128位初值文本 ③ 同款判定）
    整64 基790 = 10;
    // 静默豁免闭集穷举: 进制前缀存在性判定（剩余长度闭集边界·非业务数值区间）
    如果 (终 - 位790 > 2 && (整64(文本[整32(位790)]) & 255) == 48) {
        整64 次b790 = 整64(文本[整32(位790 + 1)]) & 255;
        如果 (次b790 == 120 || 次b790 == 88) { 基790 = 16; 位790 = 位790 + 2; }
        否则 如果 (次b790 == 98 || 次b790 == 66) { 基790 = 2; 位790 = 位790 + 2; }
        否则 如果 (次b790 == 111 || 次b790 == 79) { 基790 = 8; 位790 = 位790 + 2; }
    }
    // 数字段「乘 base 加 d」（十进制数字数组·低位在前·任意精度无溢出面——
    //   单步上限 9*16+15=159）；L/U 后缀段自断（词法原样存文本）
    向量<整64> 数位790 = 向量<整64>();
    结果<空类型, 整32> 加零790 = 数位790.追加(0);
    如果 (!加零790.正常) { 运行时错误(4); }
    布尔 有数字790 = 假;
    布尔 后缀段790 = 假;
    当 (位790 < 终) {
        整64 字节790 = 整64(文本[整32(位790)]) & 255;
        整64 d790 = 0 - 1;
        如果 (字节790 >= 48 && 字节790 <= 57) { d790 = 字节790 - 48; }
        否则 如果 (字节790 >= 97 && 字节790 <= 102) { d790 = 字节790 - 87; }
        否则 如果 (字节790 >= 65 && 字节790 <= 70) { d790 = 字节790 - 55; }
        // 静默豁免闭集穷举: 数字字节分类结果哨兵判定（0-1=非数字·闭集值域边界）
        如果 (d790 < 0) {
            如果 (字节790 == 76 || 字节790 == 108 ||
                字节790 == 85 || 字节790 == 117) {
                后缀段790 = 真;
                中断;
            }
            返回 0;
        }
        如果 (d790 >= 基790) { 返回 0; }
        有数字790 = 真;
        整64 进790 = d790;
        整64 j790 = 0;
        当 (j790 < 数位790.大小()) {
            整64 t790 = 数位790.元素(j790) * 基790 + 进790;
            结果<空类型, 整32> 设790 = 数位790.设置(j790, t790 % 10);
            如果 (!设790.正常) { 运行时错误(4); }
            进790 = t790 / 10;
            j790++;
        }
        当 (进790 > 0) {
            结果<空类型, 整32> 加元790 = 数位790.追加(进790 % 10);
            如果 (!加元790.正常) { 运行时错误(4); }
            进790 = 进790 / 10;
        }
        位790++;
    }
    // 静默豁免上游已诊断: 无数字位=词法已拒非法字面量形态·显式失败哨兵（调用方按原文保真分流）
    如果 (!有数字790) { 返回 0; }
    如果 (后缀段790) {
        当 (位790 < 终) {
            整64 尾b790 = 整64(文本[整32(位790)]) & 255;
            如果 (!(尾b790 == 76 || 尾b790 == 108 ||
                  尾b790 == 85 || 尾b790 == 117)) { 返回 0; }
            位790++;
        }
    }
    // 序列化（跳前导零·全零输出 "0"·全零不保留负号）
    整64 顶790 = 数位790.大小() - 1;
    当 (顶790 > 0 && 数位790.元素(顶790) == 0) { 顶790--; }
    布尔 负有效790 = 负790;
    如果 (顶790 == 0 && 数位790.元素(0) == 0) { 负有效790 = 假; }
    字符串 出790 = "";
    整64 k790 = 顶790;
    当 (k790 >= 0) {
        出790 = 出790 + 字符转字符串1029(48 + 数位790.元素(k790));
        k790--;
    }
    如果 (负有效790) { 出790 = "-" + 出790; }
    返回 驻留(出790);
}

// 折叠常量初始化区间 [起点, 终点)：整数字面量，或 [字面量, 负号]（负数）。
//   返回值文本ID；不可折叠（非字面量形态）返回 0。
// 474：分治累加（协议常量 位模式累加474/取负474）——全域位模式字面量（含
//   -9223372036854775808）中间值不再有符号溢出面（编译器自举安全），mod 2^64
//   位模式与旧累加逐位一致（旧 -2^63 面靠双重回绕偶合正确，此处显式化）。
函数 折叠文本转值1029(整64 文本ID) -> 整64 {
    字符串 t = 字符串复制(驻留文本(文本ID));
    布尔 负f = 假;
    整64 i = 0;
    整64 长t = 字符串长度(t);
    如果 (长t > 0 && (整64(t[0]) & 255) == 45) { 负f = 真; i = 1; }
    整64 高 = 0;
    整64 低 = 0;
    当 (i < 长t) {
        整64 字节f = (整64(t[i]) & 255) - 48;
        如果 (字节f < 0 || 字节f > 9) { 中断; }
        位模式累加474(10, 字节f, 高, 低);
        i++;
    }
    整64 v = 位模式合成474(高, 低);
    如果 (负f) { 返回 位模式取负474(v); }
    返回 v;
}

函数 折叠值转文本1029(整64 v) -> 整64 {
    布尔 负f = v < 0;
    // 474：-2^63 取绝对值溢出面特判（旧双重回绕偶合正确·此处显式化）
    如果 (v == 0 - 9223372036854775807 - 1) { 返回 驻留("-9223372036854775808"); }
    整64 无符 = v;
    如果 (负f) { 无符 = 0 - v; }
    字符串 r = "";
    如果 (无符 == 0) { r = "0"; }
    当 (无符 > 0) {
        整64 位 = 无符 % 10;
        r = 字符串复制(字符转字符串1029(48 + 位)) + r;
        无符 = 无符 / 10;
    }
    如果 (负f) { r = "-" + r; }
    返回 驻留(r);
}

// 单个数字位转字符串（编译期·避免依赖整数转字符串运行时）
函数 字符转字符串1029(整64 码) -> 字符串 {
    字符串 r = " ";
    // CN 字符串不可变——按字节构造：驻留 单字节文本
    返回 驻留文本旁路1029(码);
}

函数 驻留文本旁路1029(整64 码) -> 字符串 {
    // 数字 0..9 的文本 = 驻留("0".."9")——枚举直取（编译期十位有限面）
    如果 (码 == 48) { 返回 "0"; }
    如果 (码 == 49) { 返回 "1"; }
    如果 (码 == 50) { 返回 "2"; }
    如果 (码 == 51) { 返回 "3"; }
    如果 (码 == 52) { 返回 "4"; }
    如果 (码 == 53) { 返回 "5"; }
    如果 (码 == 54) { 返回 "6"; }
    如果 (码 == 55) { 返回 "7"; }
    如果 (码 == 56) { 返回 "8"; }
    返回 "9";
}

// 折叠算术（op 文本·左右值文本ID）——值文本ID 进出
函数 折叠算术1029(整64 opID, 整64 左ID, 整64 右ID) -> 整64 {
    整64 a = 折叠文本转值1029(左ID);
    整64 b = 折叠文本转值1029(右ID);
    字符串 op = 字符串复制(驻留文本(opID));
    // 字符串比较=布尔语义（相等=真·903 行短路分派惯用法）——原 ==假 条件全反
    // （+ 款落到 - 款·增量=基础+5 折叠成 10-5=5 实录）
    如果 (字符串比较(op, "+")) { 返回 折叠值转文本1029(a + b); }
    如果 (字符串比较(op, "-")) { 返回 折叠值转文本1029(a - b); }
    如果 (字符串比较(op, "*")) { 返回 折叠值转文本1029(a * b); }
    如果 (字符串比较(op, "/") && b != 0) { 返回 折叠值转文本1029(a / b); }
    如果 (字符串比较(op, "%") && b != 0) { 返回 折叠值转文本1029(a % b); }
    返回 0;
}

// 递归折叠区间 [起点, 终点)——返回值文本ID（0=不可折叠）
函数 折叠区间1029(向量<节点> 池, 整32 起点, 整32 终点) -> 整64 {
    整64 长 = 终点 - 起点;
    如果 (长 == 1) {
        节点 n = 池.元素(起点);
        如果 (n.类型 == 节点_整数字面量) {
            // 790：字面量数值化十进制（原节点文本原文透传 .data 直存被
            //   汇编器拒绝）；失败=词法已拒形态（上游已诊断）原文保真
            整64 规范1029 = 字面量十进制文本(字符串复制(驻留文本(整64(n.文本))));
            如果 (规范1029 != 0) { 返回 规范1029; }
            返回 整64(n.文本);
        }
        如果 (n.类型 == 节点_布尔字面量) { 返回 整64(n.文本); }
        如果 (n.类型 == 节点_标识符) {
            // 1029：常量引用——查常量值 三级解析（声明序依赖=前向引用诚实拒绝
            // ·宿主波D 同界）
            返回 查常量值(整64(n.文本));
        }
        返回 0;
    }
    // 1029 修正（后缀栈平铺序=操作数先·运算符后——非中缀序）：
    //   两节点负号款：[表达式, 负号]（-基础 / -5·末节点=负号）
    如果 (长 == 2 && 池.元素(终点 - 1).类型 == 节点_负号) {
        整64 子 = 折叠区间1029(池, 起点, 起点 + 1);
        如果 (子 == 0) { 返回 0; }
        字符串 t = 字符串复制(驻留文本(子));
        如果 (字符串长度(t) > 0 && (整64(t[0]) & 255) == 45) {
            返回 驻留(字符串子串(t, 1, 字符串长度(t) - 1));
        }
        返回 驻留("-" + t);
    }
    // 三节点二元：[左, 右, 二元运算]（末节点=运算符·后缀序）
    如果 (长 == 3 && 池.元素(终点 - 1).类型 == 节点_二元运算) {
        整64 左 = 折叠区间1029(池, 起点, 起点 + 1);
        整64 右 = 折叠区间1029(池, 起点 + 1, 起点 + 2);
        如果 (左 == 0 || 右 == 0) { 返回 0; }
        返回 折叠算术1029(整64(池.元素(终点 - 1).文本), 左, 右);
    }
    返回 0;
}

函数 折叠常量值(向量<节点> 池, 整32 起点, 整32 终点) -> 整64 {
    如果 (终点 - 起点 == 1) {
        节点 值节点 = 池.元素(起点);
        如果 (值节点.类型 == 节点_整数字面量) {
            // 790：字面量数值化十进制（原节点文本原文透传 .data 直存被
            //   汇编器拒绝·宿主 foldIntLiteralText 同构）；失败=词法已拒
            //   形态（上游已诊断）原文保真交下游
            整64 规范790a = 字面量十进制文本(字符串复制(驻留文本(整64(值节点.文本))));
            如果 (规范790a != 0) { 返回 规范790a; }
            返回 整64(值节点.文本);
        }
        // 953（002·337 族）：布尔字面量折叠——节点文本即 "1"/"0" 值 ID
        //   （解析层 灰色点①根治：真/假 建节点文本=驻留("1"/"0")·非「真」字面）
        如果 (值节点.类型 == 节点_布尔字面量) {
            返回 整64(值节点.文本);
        }
    }
    如果 (终点 - 起点 == 2) {
        节点 值节点2 = 池.元素(起点);
        节点 负号节点 = 池.元素(起点 + 1);
        如果 (值节点2.类型 == 节点_整数字面量 && 负号节点.类型 == 节点_负号) {
            返回 驻留("-" + 驻留文本(整64(值节点2.文本)));
        }
    }
    // 1029：递归折叠（常量引用/一元负/二元算术）——旧快速面先行零回归
    返回 折叠区间1029(池, 起点, 终点);
}

// 919（超承载字面量参与表达式·静态初值求值链收口）：字面量文本数学值超
//   int64 域判定——超 int64 承载（>9223372036854775807）的字面量在表达式面
//   归整128（638 甲案「无后缀大字面量提升链」），静态折叠器（mod 2^64 位模式
//   承载）对其 + - * 与 128 域截断同态、/ % 不同态（20位/2：折叠 64 位域除
//   3883139815726120959 vs 128 域除截断 -5340232221128654849 实锚），且中间值
//   超 int64 时折叠算术自身触发 474 溢出错误码 8（探针：20位+20位 / 20位*2
//   编译中止 退出码 1）——统一拒折叠走入口注入/守卫初始化（运行期 128 域
//   求值 + 低半截断，与宿主顶层静态表达式初值走注入通道同构）。
//   判据=十进制化（字面量十进制文本）后 数文本不超上界(int64 正上界)——负号
//   壳由 节点_负号 承载（字面量节点文本取正值），|v|>int64max 恒超承载命中。
函数 字面量文本超64域919(字符串 原文本) -> 布尔 {
    整64 十进制ID919 = 字面量十进制文本(原文本);
    字符串 十进制919 = 十进制ID919 != 0 ? 字符串复制(驻留文本(十进制ID919))
                                        : 原文本;
    整64 长919 = 字符串长度(十进制919);
    整64 起919 = 0;
    如果 (长919 != 0 && (整64(十进制919[0]) & 255) == 45) { 起919 = 1; }
    如果 (起919 >= 长919) { 返回 假; }
    字符串 主体919 = 字符串子串(十进制919, 起919, 长919 - 起919);
    返回 !数文本不超上界(主体919, "9223372036854775807");
}

// 919：静态初值区间含超承载字面量扫描——区间任一 节点_整数字面量 文本超
//   int64 域即真（收集静态据此拒折叠·判据缘由见 字面量文本超64域919）。
//   负号壳（[字面量, 负号]）命中其字面量节点；嵌套区间/常量引用自然覆盖。
函数 静态初值含超承载919(向量<节点> 池, 整32 起, 整32 终) -> 布尔 {
    整32 i919 = 起;
    当 (i919 < 终) {
        节点 n919 = 池.元素(i919);
        如果 (n919.类型 == 节点_整数字面量) {
            如果 (字面量文本超64域919(字符串复制(驻留文本(整64(n919.文本))))) {
                返回 真;
            }
        }
        i919++;
    }
    返回 假;
}

// 919：常量声明拒折叠判定——单字面量与负号壳形态放行（折叠=原文规范文本/
//   「-原文」·零算术运算·保真）；其余形态（二元/嵌套）含超载字面量则拒。
//   宿主侧同旨：负号在解析层并入字面量文本（单 IntegerLiteral 节点·cnEval
//   ConstExpr 的 foldIntLiteralText 失败原文保真放行）；宿主对「--20位」等
//   多层壳 cnParseInt 失败拒=与 v2 的长≥3 拒同旨。与静态初值面判据的差异=
//   静态超载字面量直存已被 640/535 上游拒，本面单字面量须保真放行（p36/p40
//   形态：常量 巨 = ±20位 引用到整128）。
函数 常量拒折叠919(向量<节点> 池, 整32 起, 整32 终) -> 布尔 {
    如果 (终 - 起 == 1) { 返回 假; }
    如果 (终 - 起 == 2 && 池.元素(起).类型 == 节点_整数字面量 &&
        池.元素(起 + 1).类型 == 节点_负号) { 返回 假; }
    返回 静态初值含超承载919(池, 起, 终);
}

// 收集一个 程序 节点顶层区间的全部常量声明（登记进 常量表）。
//   非字面量初始化（如 常量 X = 1+2）：打印诊断且不登记——引用处将落入
不安全 函数 收集常量(向量<节点> 池, 整32 程序节点, 字符串 模块路径) -> 空类型 {
    节点 程序 = 池.元素(程序节点);
    整64 i = 整64(程序.子起点);
    当 (i < 整64(程序.子终点)) {
        节点 声明 = 池.元素(整32(i));
        如果 (声明.类型 == 节点_常量声明) {
            // 919（常量折叠面·与宿主 cnEvalConstExpr 折叠失败同旨）：初值含
            //   超载字面量且带运算/负号壳（非单字面量）→ 拒折叠——折叠器
            //   mod 2^64 承载对 / % 不同态且中间值超 int64 时触发 474 错误码 8
            //   （编译进程自身溢出中止）；放行折叠会把截断值静默展开到引用点
            //   （探针：常量 甲 = 20位+0 引用出 7766279631452241919 vs 数学值
            //   99999999999999999999）。单字面量形态保真放行（见 常量拒折叠919）。
            //   128 域常量折叠（运算形态放行+保真）为后续能力面。
            布尔 拒折919 = 常量拒折叠919(池, 整32(声明.子起点),
                                         整32(声明.子终点));
            整64 值文本 = 0;
            如果 (!拒折919) {
                值文本 = 折叠常量值(池, 声明.子起点, 声明.子终点);
            }
            如果 (值文本 != 0) {
                整64 键基v = 键基合成(模块路径, 整64(声明.文本));
                结果<空类型, 整32> 设常 = 常量表.设置(键基v, 值文本);
                如果 (!设常.正常) { 运行时错误(4); }
                整64 序c = 0;
                结果<整64, 整32> 查数c = 常量候选数们.获取(整64(声明.文本));
                如果 (查数c.正常) { 序c = 查数c.值; }
                结果<空类型, 整32> 加键c = 常量候选键基们.设置(
                    整64(声明.文本) * 键位移 + 序c, 键基v);
                如果 (!加键c.正常) { 运行时错误(4); }
                结果<空类型, 整32> 设数c = 常量候选数们.设置(整64(声明.文本), 序c + 1);
                如果 (!设数c.正常) { 运行时错误(4); }
            } 否则 {
                // 919：超承载参与形态与纯非法形态诊断区分（同拒·文案准确）
                如果 (拒折919) {
                    IR层诊断("常量初始化表达式含超 64 位承载字面量（编译期折叠不支持·919）: " +
                                  驻留文本(整64(声明.文本)));
                } 否则 {
                    IR层诊断("常量初始化须为整数字面量: " +
                                  驻留文本(整64(声明.文本)));
                }
            }
        }
        i++;
    }
    // 953（002·E 类·309 族·宿主 239-a 对齐·规格书 3.8）：内建编译期常量
    //   调试模式——默认（调试构建）=真；用户同名常量已登记时跳过（用户定义
    如果 (查常量值(驻留("调试模式")) == 0) {
        结果<空类型, 整32> 设内建953 = 常量表.设置(
            驻留("调试模式"), 驻留("1"));
        如果 (!设内建953.正常) { 运行时错误(4); }
    }
}

// 查常量值（值文本ID；0=未命中）。三级解析（结构体布局键基 同构公式）：
//   限定文本拆分直查 ＞ ① 本模块键基 ＞ ② 纯名直查（主模块键基=纯名；公开位
函数 查常量值(整64 常量名ID) -> 整64 {
    字符串 文本v = 字符串复制(驻留文本(常量名ID));
    字符串 模块v = "";
    字符串 符号v = "";
    如果 (拆限定名(文本v, 模块v, 符号v) == 1) {
        如果 (是标准库模块名(模块v)) { 返回 0; }
        结果<整64, 整32> 查x = 常量表.获取(键基合成(模块v, 驻留(符号v)));
        如果 (查x.正常) { 返回 查x.值; }
        返回 0;
    }
    结果<整64, 整32> 查1 = 常量表.获取(键基合成(取当前模块路径(), 常量名ID));
    如果 (查1.正常) { 返回 查1.值; }
    结果<整64, 整32> 查2 = 常量表.获取(常量名ID);
    如果 (查2.正常) { 返回 查2.值; }
    整64 数v = 0;
    结果<整64, 整32> 查数v = 常量候选数们.获取(常量名ID);
    如果 (查数v.正常) { 数v = 查数v.值; }
    如果 (数v > 0) {
        结果<整64, 整32> 查c = 常量候选键基们.获取(常量名ID * 键位移 + 0);
        如果 (查c.正常) {
            结果<整64, 整32> 查f = 常量表.获取(查c.值);
            如果 (查f.正常) { 返回 查f.值; }
        }
    }
    返回 0;
}

