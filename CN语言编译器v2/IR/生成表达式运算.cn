// CN 自举编译器 v2 · 生成表达式——运算族（生成短路求值 + 生成三元运算 + 生成一元运算）（D1 行数整改 120-a：自 生成表达式.cn 按族拆出）
//   纯重构零行为变更（同包「多文件合并全局可见」——函数跨文件互调无障碍；
//   与主模块函数互调经包内合并池解析，见 公开: 注释同款纪律）。
导入 容器::向量;
导入 语法;
导入 IR;
导入 协议常量;   // 335 重构B：协议常量独立包

导入 IR生成;
导入 生成表达式求值;

公开:

// 短路求值（缺陷B 根治，规范 930）：&&/|| 左操作数先行、右操作数惰性——
//   a 假/真 短路保留 a；右值经临时槽汇合，逻辑非×2 规范化 0/1（对标 C 语义值）。
//   递归生成 左/右子区间；出口等价消费 1 个位置（主循环统一 位置++）。
不安全 函数 生成短路求值(向量<节点> 池, 节点 n, 字符串 op名, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                 向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数,
                 向量<整64>& 表达式栈) -> 空类型 {
    // 88-a（2026-09-12 第八十八轮）根治：原实现「只压不弹」——左/右递归子区间
    //   各 +1、末尾结果再 +1（净 **+3**），破坏「表达式求值净栈 +1」契约 → 实参位
    //   短路 `f(a || b)` 经 生成调用 弹（实参数+被调）弹到左操作数寄存器=被调错位
    //   （`[ir2] 调用被调对象非函数名/方法` + 运行时错误6；87-a 探针 v2w 实证，
    //   宿主同形态正确）。修法=与 生成三元运算 同构的「递归子区间 + 归位」：
    //   每段递归后 表达式栈弹到深度（左/右值已由返回值持有，栈上副本即丢弃；
    //   子区间内层残留一并自愈清理），末尾压唯一结果（净 +1）。
    //   87-a 曾尝试「栈基线净化」未果（残留在本层之外），本轮以归位原语统一收口
    //   （IR生成.表达式栈弹到深度/表达式栈归位压回——净栈契约单一事实源）。
    整64 进入深度 = 表达式栈.大小();
    整64 左寄存器 = 生成表达式(池, n.子起点, 整32(n.附加), 局部槽, 参数槽,
                              指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    表达式栈弹到深度(表达式栈, 进入深度);
    整64 临时槽 = 槽计数[0];
    槽计数[0] = 槽计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 临时槽));   // 帧登记（扫描函数 据此计帧）
    IR追加(指令, 建IR指令(IR_存储, 左寄存器, 0, 0, 0, 0, 临时槽));
    整64 汇合块 = 块计数[0] + 1;
    块计数[0] = 块计数[0] + 2;
    整64 求值块 = 汇合块 + 1;
    如果 (字符串比较(op名, "&&")) {
        // && ：a 真 -> 求值 b（假短路，保留 a=0）
        IR追加(指令, 建IR指令(IR_条件跳转, 左寄存器, 求值块, 汇合块, 0, 0, 0));
    } 否则 {
        // || ：a 假 -> 求值 b（真短路，保留 a）
        IR追加(指令, 建IR指令(IR_条件跳转, 左寄存器, 汇合块, 求值块, 0, 0, 0));
    }
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 求值块));
    整64 右寄存器 = 生成表达式(池, 整32(n.附加), n.子终点, 局部槽, 参数槽,
                              指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    表达式栈弹到深度(表达式栈, 进入深度);
    IR追加(指令, 建IR指令(IR_存储, 右寄存器, 0, 0, 0, 0, 临时槽));
    IR追加(指令, 建IR指令(IR_跳转, 0, 0, 0, 0, 0, 汇合块));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 汇合块));
    整64 载入寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 临时槽, 0, 0, 载入寄存器, T_整64, 0));
    整64 非寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_逻辑非, 载入寄存器, 0, 0, 非寄存器, T_整64, 0));
    整64 逻辑结果 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_逻辑非, 非寄存器, 0, 0, 逻辑结果, T_整64, 0));
    登记寄存器类型(逻辑结果, T_布尔);
    结果<空类型, 整32> 加逻 = 表达式栈.追加(逻辑结果);
    如果 (!加逻.正常) { 运行时错误(4); }
}

// 末端节点拼接分派码推导（拼接双侧兜底共用——原左/右两段同构，R3 合并消重；
//   原名 推导末端类型码·T48 轮改造）：字符串字面量直判；否则 解析节点类型ID；
//   调用被调再查 内置返回表/函数返回回退。字符 复位 T_字符（见判定处注释）；
//   末端未登记（ID=0）时返回 既有码 兜底（行为与旧版一致）。
函数 推导末端拼接码(向量<节点> 池, 整32 末端位置, 整64 既有码) -> 整64 {
    节点 末端 = 池.元素(末端位置);
    整64 类型ID = 0;
    如果 (末端.类型 == 节点_字符串字面量) {
        类型ID = 驻留("字符串");
    } 否则 {
        类型ID = 解析节点类型ID(池, 末端位置);
        如果 (类型ID == 0 && 末端.类型 == 节点_调用 && 末端.子起点 > 0) {
            节点 被调 = 池.元素(整32(末端.子起点));
            如果 (被调.类型 == 节点_标识符) {
                类型ID = 内置函数返回类型ID(驻留文本(整64(被调.文本)));
                如果 (类型ID == 0) {
                    类型ID = 查函数返回回退(整64(被调.文本));
                }
            }
        }
    }
    如果 (类型ID == 驻留("字符")) { 返回 T_字符; }
    如果 (类型ID == 0) { 返回 既有码; }
    返回 类型码(类型ID);
}

// 91-a（2026-09-13 第九十一轮）：隐式值转换插入（浮点混合运算整数侧宽化）——
//   发射层按 (源码=操作数2, 目标码=类型字段) 组合分派（整->浮 cvtsi2sd/scvtf、
//   浮->整 cvttsd2si/fcvtzs、浮32<->浮64 cvtss2sd/cvtss2df 族）。
//   源码取寄存器登记（0=未登记按 T_整64 发射读法兜底）。
// 648 归档：源码 0=「二元算术产物不登记」既有惯例面（查寄存器类型 归档注释
//   同源·浮点混合运算高频合法），非查表 miss 病面，不登记。
不安全 函数 插入值转换(整64 源reg, 整64 目标码, 向量<IR指令>& 指令,
                 整64* 寄存器计数) -> 整64 {
    整64 转换reg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    整64 源码 = 查寄存器类型(源reg);
    IR追加(指令, 建IR指令(IR_类型转换, 源reg, 源码, 0, 转换reg, 目标码, 0));
    登记寄存器类型(转换reg, 目标码);
    返回 转换reg;
}

// 二元运算主体（非短路）：字符串拼接 +（双侧隐式转换 __cn_str_concat）与
//   算术/比较指令发射。位置 为值参（仅读：右侧末端=位置-1 推导兜底）；
//   拼接路径提前返回、算术路径自然落出——出口等价消费 1 个位置。
不安全 函数 生成二元运算主体(向量<节点> 池, 节点 n, 字符串 op名, 整32 位置,
                     映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                     向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数,
                     向量<整64>& 表达式栈) -> 空类型 {
    // ③ 第一波（2026-09-03，缺陷②根治）：字符串拼接 +（宿主 Task 2.5/2.9 对齐：
    //   __cn_str_concat 左结合、产物为字符串；字符串+数值 双向隐式转换——
    //   数值侧先 __cn_str_from_int/float/bool 再 concat）。判定：左右任一为
    //   字符串（寄存器类型登记表——字面量/标识符加载/拼接产物/内置返回；
    //   未登记侧末端节点推导兜底）
    布尔 拼接加 = 假;
    整64 拼接左码 = 0;
    整64 拼接右码 = 0;
    // 215-a（2026-09-15 第两百一十五轮，D1 行数整改）：拼接判定迁 判定字符串拼接
    //   （3 项引用输出）；浮点混合转换迁 浮点混合转换（左右寄存器引用输出）。
    判定字符串拼接(池, n, op名, 位置, 表达式栈, 拼接加, 拼接左码, 拼接右码);
    // 弹 2 个操作数，生成运算指令
    整64 右 = 0;
    整64 左 = 0;
    如果 (表达式栈.大小() >= 2) {
        右 = 表达式栈.元素(表达式栈.大小() - 1);
        结果<空类型, 整32> 删右 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删右.正常) { 运行时错误(4); }
        左 = 表达式栈.元素(表达式栈.大小() - 1);
        结果<空类型, 整32> 删左 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删左.正常) { 运行时错误(4); }
    }
    // 816（253 根治·同族漏网）：二元操作数值位函数名收口——`f == 加倍`（函数
    //   指针比较·宿主六比较符全放行）操作数=函数名负占位（生成标识符加载
    //   兜底）时还原为函数地址（480 值位收口族既有消费位之外漏网）。负占位
    //   当寄存器号入 IR_相等/小于 等 → 恒不等错值（t3/t9/t10 双态实证：
    //   宿主 == 真 v2 假·宿主 < 假 v2 真）且 win 后端可能触发 992 守卫。
    //   非负值直通=no-op（算术/拼接/128/步进糖等路径行为不变——宿主拒绝函数名
    //   参与算术/位运算/短路，语义层已拦，负值到不了此处）。
    左 = 值位函数名收口480(左, 指令, 寄存器计数);
    右 = 值位函数名收口480(右, 指令, 寄存器计数);
    如果 (拼接加) {
        // 617：左右根节点快照（n.附加-1=左子区间末端·位置-1=右子区间末端——
        //   池后缀布局末端节点=表达式根，判定字符串拼接 同款索引惯例）
        节点 左根617 = 池.元素(整32(整64(n.附加) - 1));
        节点 右根617 = 池.元素(整32(位置 - 1));
        发射字符串拼接(拼接左码, 拼接右码, 左, 右, 指令, 寄存器计数, 表达式栈);
        // 617（2026-10-14 伞批）：concat 只读消费操作数——发射完成后按 AST
        //   形态结算拥有串临时（拼接链中间临时归零点：t2=拼接(t1,c) 发射完
        //   释放 t1；宿主 genStringConcatBinary 同构）
        如果 (拥有串临时形态(池, 左根617)) {
            发射串临时释放617(左, 指令, 寄存器计数);
        }
        如果 (拥有串临时形态(池, 右根617)) {
            发射串临时释放617(右, 指令, 寄存器计数);
        }
        返回;
    }
    // 414（#414·宿主 handleOperatorOverload 同构）：左操作数为用户类实例且类
    //   沿链有「运算符X」成员 → 降级成员方法调用（重载决议顺序②；未命中返回
    //   假=落下方内置指令=顺序③守卫兜底）
    如果 (发射运算符重载二元(池, n, op名, 左, 右, 指令, 寄存器计数, 槽计数, 表达式栈)) {
        返回;
    }
    // 966（166 立法 v2 同构）：字符串×字符串 六比较符 → helper（==/!= 内容·
    //   四序字典序）。类型码=寄存器登记+末端推导兜底（拼接判定同款索引惯例：
    //   左末端=n.附加-1·右末端=位置-1）；混合形态（字符串×数值）不满足双侧
    //   T_字符串 → 落回普通指令（既有检查面推导 -1 兜底边界·与宿主拒绝分叉
    //   登记随 v2 类型推导完善收口）。
    {
        整64 左码比 = 查寄存器类型(左);
        整64 右码比 = 查寄存器类型(右);
        如果 (左码比 == 0) {
            左码比 = 推导末端拼接码(池, 整32(n.附加) - 1, 左码比);
        }
        如果 (右码比 == 0) {
            右码比 = 推导末端拼接码(池, 位置 - 1, 右码比);
        }
        布尔 是比较符2 = 字符串比较(op名, "==") || 字符串比较(op名, "!=") ||
                       字符串比较(op名, "<") || 字符串比较(op名, ">") ||
                       字符串比较(op名, "<=") || 字符串比较(op名, ">=");
        如果 (是比较符2 && 左码比 == T_字符串 && 右码比 == T_字符串) {
            发射字符串比较(op名, 左, 右, 指令, 寄存器计数, 表达式栈);
            返回;
        }
    }
    整64 op = 0;
    如果 (字符串比较(op名, "+")) { op = IR_加; }
    否则 如果 (字符串比较(op名, "-")) { op = IR_减; }
    否则 如果 (字符串比较(op名, "*")) { op = IR_乘; }
    否则 如果 (字符串比较(op名, "/")) { op = IR_除; }
    否则 如果 (字符串比较(op名, "%")) { op = IR_取余; }
    否则 如果 (字符串比较(op名, "==")) { op = IR_相等; }
    否则 如果 (字符串比较(op名, "!=")) { op = IR_不等; }
    否则 如果 (字符串比较(op名, "<")) { op = IR_小于; }
    否则 如果 (字符串比较(op名, ">")) { op = IR_大于; }
    否则 如果 (字符串比较(op名, "<=")) { op = IR_小于等于; }
    否则 如果 (字符串比较(op名, ">=")) { op = IR_大于等于; }
    // 位运算五算子（2026-09-09 规范 01b§5.4；IR_位与/位或/位异或 既有预留启用，
    //   移位 68/69 新设——注释见 IR常量.cn）
    否则 如果 (字符串比较(op名, "&")) { op = IR_位与; }
    否则 如果 (字符串比较(op名, "|")) { op = IR_位或; }
    否则 如果 (字符串比较(op名, "^")) { op = IR_位异或; }
    否则 如果 (字符串比较(op名, "<<")) { op = IR_左移; }
    否则 如果 (字符串比较(op名, ">>")) { op = IR_右移; }
    // && / || 已在短路分支处理（原 IR_相等 防御语义错误，已删）
    // 91-a（2026-09-13 第九十一轮）：浮点混合运算隐式转换（宿主对齐：浮64 + 整
    //   自动宽化，fp9 实测宿主 `乙 + 2` = 5.5）——一侧浮点一侧整数时，整数侧
    //   插入 IR_类型转换（整->浮）。结果浮点码：单侧浮点取该侧（含浮32），
    //   双侧浮点混合取浮64（宽化方向）。取余/位运算不转换（宿主 `%` 拒绝
    //   浮点操作数、规范 5.4 位运算仅整型）。
    // 266-a 波B：指针算术步进糖——左操作数带指针步进标记（指针变量加载时
    //   登记·寄存器级判定零池回溯）时，右操作数 × 元素宽 后再加/减（宿主指针
    //   算术步进=元素宽对齐）。经 查指针值步进 访问器（跨文件边界）。
    如果 (op == IR_加 || op == IR_减) {
        整64 左步进 = 查指针值步进(左);
        如果 (左步进 > 1) {
            整64 步进寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(左步进)),
                                  0, 0, 步进寄存器, T_整64, 0));
            IR追加(指令, 建IR指令(IR_乘, 右, 步进寄存器, 0, 右, T_整64, 0));
        }
    }
    浮点混合转换(op, 左, 右, 指令, 寄存器计数);
    // 810（053）：128 位二元运算（算术五算子+比较六算子·辅助函数路线）——
    //   左右任一操作数登记 T_整128/T_正128 即走本通道（64 位侧自动物化提升）。
    //   产物=2 槽临时基址句柄（算术）/T_布尔（比较）；已压栈。
    {
        整64 op128 = op;
        布尔 是算术128 = op128 == IR_加 || op128 == IR_减 || op128 == IR_乘 ||
                          op128 == IR_除 || op128 == IR_取余 ||
                          op128 == IR_左移 || op128 == IR_右移 ||
                          op128 == IR_位与 || op128 == IR_位或 || op128 == IR_位异或;
        布尔 是比较128 = op128 == IR_相等 || op128 == IR_不等 ||
                          op128 == IR_小于 || op128 == IR_大于 ||
                          op128 == IR_小于等于 || op128 == IR_大于等于;
        如果 (是算术128 || 是比较128) {
            如果 (发射128位二元运算(op128, 左, 右, 指令, 寄存器计数,
                                    槽计数, 表达式栈, 0)) {
                返回;
            }
        }
    }
    整64 寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    // 46-f 无符号语义轮（2026-09-10 第五十轮）：二元指令类型字段=操作数寄存器
    //   登记类型（原恒 T_整64——正32/正64 操作数的无符号性在此丢失，后端无从
    //   分派 div/shr/setb 族无符号指令）。取左优先（混合宽度宽松语义取左），
    //   右侧为无符号码时取右；两侧均非无符号码兜底 T_整64（既有行为不变）。
    //   比较产物仍登记 T_布尔（结果语义与操作数符号性无关）。
    // 91-a：浮点码优先（浮点操作数存在时类型字段取浮点码——后端据此分派
    //   SSE/f 族指令与 ucomisd/fcmp 比较）。
    // 265-a 波A：公共类型提升（替换 46-f「取左白名单」）——浮点面保持既有
    //   语义（单侧浮取该侧·91-a 转换后即公共浮码）；整型族=位宽大者胜/
    //   同宽混升整64/双正32 保留无符号截断面/双整32=T_整32（配套 264-a
    //   后端截断）。178 的 5<<33 按左=整32 mod32 根治；380 的 常量*整64
    //   提升整64 不截断（263-a 取左缺陷正确化）。
    //   比较产物仍登记 T_布尔（结果语义与操作数符号性无关）。
    // 377 乙案（001 §3.7a 全程窄域·用户批乙 2026-10-10·681 探针）：窄算术
    //   判定——寄存器码恒宽（v2 窄域=窄槽存回截断机制），窄性须经池回溯按
    //   **源码类型**判：同窄双侧、或单侧窄+对侧 T_整32 整字面量（285 字面量
    //   窄参与的 IR 面同口径）。算术五算子发射后 插入值转换 回窄（每步回绕：
    //   (x*2)/2 立法 144/2=72·宽算 400/2=200·单步赋值锚 p1007_05 观测等价）。
    整64 左源码377 = 0;
    整64 右源码377 = 0;
    节点 左末端377 = 池.元素(整32(n.附加) - 1);
    节点 右末端377 = 池.元素(位置 - 1);
    // 728s：字面量形态判定独立提取（后缀定级后带后缀字面量源码类型≠T_整32
    //   哨兵——下方 285 窄参与判定与负号窗口不能只看哨兵值；与宿主
    //   isIntLiteralExpr 判定同构）。
    布尔 左是字面量377 = 左末端377.类型 == 节点_整数字面量 ||
        (左末端377.类型 == 节点_负号 && 左末端377.子起点 > 0 &&
         池.元素(左末端377.子起点).类型 == 节点_整数字面量);
    布尔 右是字面量377 = 右末端377.类型 == 节点_整数字面量 ||
        (右末端377.类型 == 节点_负号 && 右末端377.子起点 > 0 &&
         池.元素(右末端377.子起点).类型 == 节点_整数字面量);
    // 04 云端红根治：类型码() 映射缺有符号窄族（整8/整16 归并宽码——372 行
    //   字符归并 T_整64 同族）——改类型名ID 直比（零映射风险）。
    如果 (左是字面量377) {
        左源码377 = 字面量源码类型377(池, 左末端377);   // 728s：后缀定级名ID/无后缀哨兵
    } 否则 {
        // 481（B 案收口）：嵌套面（内层二元经 377 窄化登记窄码）按窄码参与
        左源码377 = 嵌套窄码回溯481(解析节点类型ID(池, 整32(n.附加) - 1),
                                   查寄存器类型(左));
    }
    如果 (右是字面量377) {
        右源码377 = 字面量源码类型377(池, 右末端377);
    } 否则 {
        // 481（B 案收口）：右操作数嵌套面同构（`甲 + (乙 + 1)` 对称面）
        右源码377 = 嵌套窄码回溯481(解析节点类型ID(池, 位置 - 1),
                                   查寄存器类型(右));
    }
    布尔 是窄左377 = (左源码377 == 驻留("整8") || 左源码377 == 驻留("整16") ||
                    左源码377 == 驻留("正8") || 左源码377 == 驻留("正16"));
    布尔 是窄右377 = (右源码377 == 驻留("整8") || 右源码377 == 驻留("整16") ||
                    右源码377 == 驻留("正8") || 右源码377 == 驻留("正16"));
    整64 窄码377 = 0;
    如果 (是窄左377 && 是窄右377 && 左源码377 == 右源码377) {
        窄码377 = 左源码377;
    } 否则 如果 (是窄左377 && !是窄右377 && 右是字面量377) {
        // 728s：窄参与判定改经独立字面量谓词（原 `右源码377 == T_整32` 哨兵
        //   判定——带后缀字面量（1L 等）现为名ID 不再命中；宿主 285
        //   `isNarrow(left) && !isNarrow(right) && isIntLiteralExpr(right)`
        //   同构：任意后缀字面量按窄侧参与）
        窄码377 = 左源码377;
    } 否则 如果 (是窄右377 && !是窄左377 && 左是字面量377) {
        窄码377 = 右源码377;
    }
    // 04 病根：窄码377 此处=类型名ID（直比），插入值转换 消费**类型码**——
    //   类型码() 映射缺有符号窄族（整8/整16 归并宽码）故手工映射，缺省归 0
    //   不触发（诚实边界）。
    如果 (窄码377 == 驻留("整8")) { 窄码377 = T_整8; }
    否则 如果 (窄码377 == 驻留("整16")) { 窄码377 = T_整16; }
    否则 如果 (窄码377 == 驻留("正8")) { 窄码377 = T_正8; }
    否则 如果 (窄码377 == 驻留("正16")) { 窄码377 = T_正16; }
    整64 左码提升 = 查寄存器类型(左);
    整64 右码提升 = 查寄存器类型(右);
    整64 二元类型 = T_整64;
    如果 (左码提升 == T_浮32 || 左码提升 == T_浮64 ||
        右码提升 == T_浮32 || 右码提升 == T_浮64) {
        如果 (左码提升 == T_浮32 || 左码提升 == T_浮64) { 二元类型 = 左码提升; }
        否则 { 二元类型 = 右码提升; }
    } 否则 {
        二元类型 = 公共整型提升(左码提升, 右码提升);
    }
    // 移位类型覆盖：移位量取模=左操作数类型位宽（规范 01b§5.4·C 语义）——
    //   不用公共提升（右操作数宽度不参与）；左=T_整32 字面量形态即 178 面。
    如果 (op == IR_左移 || op == IR_右移) {
        如果 (查寄存器类型(左) == T_整32) { 二元类型 = T_整32; }
    }
    // 474（运行期整数溢出·错误码 8）：检查码推导——①窄算术（窄码377·双侧同窄
    //   或窄+整32字面量·除法含 INT_MIN/-1 窄域检查）→窄码；②宽域：**检查域=
    //   计算域**（公共提升码——检查窄于计算域会令后端按窄域计算=值截断·p5 探针
    //   实证 0-9223372036854775807 走 32 位域=1），门=左侧整型源（名映射/字面量
    //   寄存器码）——指针/串/布尔/未知名左=0 不检查（指针算术天然豁免）；乘/除
    //   无指针算术面，右侧整型源同样开门。移位窄组合（窄码377 命中）检查域=
    //   窄码位宽（572 对齐宿主 emitShift 窄型通道按窄位宽 cmp 实锤——原「移位
    //   检查域=计算域」口径随 850 dual 首跑分叉治理退役）；宽组合=计算域不变。
    //   取余恒良定义（INT_MIN % -1 ≡ 0·001 §3.7a 保留条文·立法澄清 474 轮）
    //   不设检查。不安全 函数内=0 豁免
    //   （溢出检查码474）。附加承载检查规格协议见 代码生成共用.cn。
    整64 检查码474 = 0;
    如果 (op == IR_加 || op == IR_减 || op == IR_乘 || op == IR_除 ||
         op == IR_左移 || op == IR_右移) {
        如果 (窄码377 != 0) {
            检查码474 = 窄码377;
        } 否则 {
            整64 左码474b = 检查码自类型名ID(左源码377);
            如果 (左码474b == 0 && 左源码377 == T_整32) {
                // 字面量（285 整32 标记）——真实域=寄存器登记码（超域字面量
                //   生成层已改 T_整64·292 同口径）
                左码474b = 溢出检查码自码474(查寄存器类型(左));
            }
            布尔 整型门474 = 左码474b != 0;
            如果 (!整型门474 && (op == IR_乘 || op == IR_除)) {
                整64 右码474b = 检查码自类型名ID(右源码377);
                如果 (右码474b == 0 && 右源码377 == T_整32) {
                    右码474b = 溢出检查码自码474(查寄存器类型(右));
                }
                整型门474 = 右码474b != 0;
            }
            如果 (整型门474) {
                检查码474 = 溢出检查码自码474(二元类型);
            }
        }
        检查码474 = 溢出检查码474(检查码474);
    }
    IR追加(指令, 建IR指令(op, 左, 右, 0, 寄存器, 二元类型, 检查码474));
    // ③：比较运算产物登记 T_布尔（打印 真/假 与拼接 from_bool 分派用）；
    // 91-a：浮点算术产物登记（原「算术产物不登记——按整数兜底」——打印浮点
    //   结果误走 __cn_print_int、嵌套浮点运算类型丢失；登记后打印/拼接/再运算
    //   全链消费正确）
    如果 (op == IR_相等 || op == IR_不等 || op == IR_小于 || op == IR_大于 ||
         op == IR_小于等于 || op == IR_大于等于) {
        登记寄存器类型(寄存器, T_布尔);
    } 否则 如果 (二元类型 == T_浮32 || 二元类型 == T_浮64) {
        登记寄存器类型(寄存器, 二元类型);
    }
    // 377 乙案尾部：窄算术（+ - * / %）结果 插值转换 回窄+登记窄码——链式
    //   中间每步回绕（681 探针 z 200→72）；单步赋值锚观测等价（截断点前移）。
    // 572（001 §3.7a 窄域位模式面·850 dual 首跑实锤）：移位（<< >>）窄组合
    //   同走尾部回窄——左移丢高位按窄域位模式回绕（整8 1<<7 ≡ -128·宿主
    //   emitShift 窄槽存回同款位模式·Rust i8<<7 同值）；宽域移位+尾部 Cast
    //   截断与窄域移位位模式等价（宿主同为 32 位域 shl+窄槽存回）。右移
    //   丢低位不回绕（域内恒合法·本改仅统一结果窄码登记与检查域）。
    如果 (窄码377 != 0 &&
         (op == IR_加 || op == IR_减 || op == IR_乘 || op == IR_除 ||
          op == IR_取余 || op == IR_左移 || op == IR_右移)) {
        寄存器 = 插入值转换(寄存器, 窄码377, 指令, 寄存器计数);
        登记寄存器类型(寄存器, 窄码377);
    }
    结果<空类型, 整32> 加 = 表达式栈.追加(寄存器);
    如果 (!加.正常) { 运行时错误(4); }
}

// 215-a 拼接判定/浮点混合转换已迁 生成表达式运算辅助.cn（481 行数解堵·纯移动
//   零语义）；481 嵌套窄码回溯同文件（嵌套窄码回溯481）。


// 86-a（2026-09-12 复审缺陷①）：三元聚合分支的「聚合左值」判定——区间末节点为
//   标识符/成员/下标/解引用且类型为结构体（查结构体大小>0，含结果/可选合成
//   结构体）时，分支求值改走 生成左值地址（**地址透传**）。
//   根因（P41/最小3 实证）：通用 生成表达式 对结构体标识符恒发射 8 字节 IR_加载
//   （首字段值，非地址）→ 三元汇合把「首字段值」当地址 → 返回位整体拷贝 rep movsb
//   从地址 11 读 → 段错误 rc=139。宿主同款修复：分支地址透传（visitTernaryExpr
//   聚合约定「分支 Store 地址、汇合 Load 地址」，见 ir_expr.cpp）。
//   非左值分支（调用返回=retbuf 地址 / 字面量=临时槽地址 / 嵌套三元=地址）本身
//   已是以「地址」为值的形态，保持 生成表达式 原路径。
函数 区间末为聚合左值(向量<节点> 池, 整32 起, 整32 终) -> 布尔 {
    如果 (终 <= 起) { 返回 假; }
    整32 末索引 = 终 - 1;
    节点 末 = 池.元素(末索引);
    如果 (!(末.类型 == 节点_标识符 || 末.类型 == 节点_成员 ||
          末.类型 == 节点_下标 || 末.类型 == 节点_解引用)) { 返回 假; }
    整64 类型ID = 解析节点类型ID(池, 末索引);
    如果 (类型ID == 0) { 返回 假; }
    返回 查结构体大小(类型ID) > 0;
}

// 263①（021 任务 263·2026-10-07 深度机·探针 9263tmp_d 实证）：三元分支末=
//   **聚合调用返回**（表.元素(0) 等容器方法/普通函数返回真结构体）——86-a 注释
//   「调用返回=retbuf 地址（物化独立槽基址·1013 批八值语义深拷独立拥有）」形态，
//   分支值本身已是「地址」，与聚合左值地址透传同汇合契约。原 T_对象 登记只看
//   区间末为聚合左值 → 本形态汇合 IR_加载(临时槽) 未标 T_对象 → 实参回扫
//   （回扫实参取地址 IR生成.cn 86-a 守卫）把「临时槽地址」当结构体基址传被调方
//   ——临时槽仅 8 字节（存的是物化槽地址）→ 被调方拷 查结构体大小 字节读垃圾
//   越界（9263tmp_d：挑选号(真 ? 表.元素(0) : 表.元素(1)) 读出 -2125014492·
//   宿主 visitTernaryExpr 聚合约定「分支 Store 地址、汇合 Load 地址」同形态绿）。
//   判定=末节点 节点_调用 且 解析节点类型ID 为非容器结构体——容器=单槽句柄值
//   语义（595-a·句柄直传非地址形态）排除；标量返回 查结构体大小=0 天然排除。
函数 区间末为聚合调用返回(向量<节点> 池, 整32 起, 整32 终) -> 布尔 {
    如果 (终 <= 起) { 返回 假; }
    节点 末d = 池.元素(终 - 1);
    如果 (末d.类型 != 节点_调用) { 返回 假; }
    整64 类型IDd = 解析节点类型ID(池, 终 - 1);
    如果 (类型IDd == 0) { 返回 假; }
    字符串 类型文本d = 字符串复制(驻留文本(类型IDd));
    如果 (是容器类(类型文本d)) { 返回 假; }
    返回 查结构体大小(类型IDd) > 0;
}

// 三元条件（③ 第六波，规范 01b 5.8）——惰性求值：条件跳转分派，仅选中分支
//   求值。复用短路方案：临时槽（IR_分配 帧登记）汇合两分支值，三块（真/假/汇合）。
//   栈平衡：各段递归后弹到进入前深度再压汇合结果（一元模式——净 +1，中间残留
//   全清，防「下标弹2取到残留」同族缺陷）。汇合类型=真分支寄存器登记类型
//   （语义层已保证两分支可合并；未登记兜底 T_整64——标识符加载同款）
//   86-a：聚合分支经 区间末为聚合左值 改走左值地址（地址透传，宿主同款）。
不安全 函数 生成三元运算(向量<节点> 池, 节点 n, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                 向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数,
                 向量<整64>& 表达式栈) -> 空类型 {
    整64 三元前深度 = 表达式栈.大小();
    整64 条件寄存器 = 生成表达式(池, n.子起点, n.文本, 局部槽, 参数槽,
                                指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    当 (表达式栈.大小() > 三元前深度) {
        结果<空类型, 整32> 删条 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删条.正常) { 运行时错误(4); }
    }
    整64 临时槽 = 槽计数[0];
    槽计数[0] = 槽计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 临时槽));
    整64 真块 = 块计数[0] + 1;
    整64 假块 = 块计数[0] + 2;
    整64 汇合块 = 块计数[0] + 3;
    块计数[0] = 块计数[0] + 3;
    IR追加(指令, 建IR指令(IR_条件跳转, 条件寄存器, 真块, 假块, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 真块));
    整64 真寄存器 = 0;
    如果 (区间末为聚合左值(池, 整32(n.文本), 整32(n.附加))) {
        真寄存器 = 生成左值地址(池, 整32(n.文本), 整32(n.附加), 局部槽, 参数槽,
                                指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    } 否则 {
        真寄存器 = 生成表达式(池, 整32(n.文本), 整32(n.附加), 局部槽, 参数槽,
                              指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    }
    当 (表达式栈.大小() > 三元前深度) {
        结果<空类型, 整32> 删真 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删真.正常) { 运行时错误(4); }
    }
    // 816（253 根治）：三元分支值位函数名收口——分支值=函数名（生成标识符加载
    //   兜底负占位 0-名ID）时还原为函数地址 IR_函数地址（480 值位收口族：
    //   声明初始化/赋值右值/返回/实参位既有·三元真/假分支位原漏网）。负占位
    //   直入 IR_存储 被后端当寄存器号：win 992 守卫「非法寄存器槽号 -26」中止 /
    //   linux 正偏移 [rbp+N] 越界读垃圾→函数指针=垃圾→间接调用跳栈段错误
    //   （p1006_05 三元挑 fnptr 实证）。聚合左值路径返回值=地址寄存器恒非负=
    //   收口 no-op（聚合语义不受影响）。
    真寄存器 = 值位函数名收口480(真寄存器, 指令, 寄存器计数);
    IR追加(指令, 建IR指令(IR_存储, 真寄存器, 0, 0, 0, 0, 临时槽));
    IR追加(指令, 建IR指令(IR_跳转, 0, 0, 0, 0, 0, 汇合块));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 假块));
    整64 假寄存器 = 0;
    如果 (区间末为聚合左值(池, 整32(n.附加), n.子终点)) {
        假寄存器 = 生成左值地址(池, 整32(n.附加), n.子终点, 局部槽, 参数槽,
                                指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    } 否则 {
        假寄存器 = 生成表达式(池, 整32(n.附加), n.子终点, 局部槽, 参数槽,
                              指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    }
    当 (表达式栈.大小() > 三元前深度) {
        结果<空类型, 整32> 删假 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删假.正常) { 运行时错误(4); }
    }
    // 816（253 根治）：假分支值位收口（真分支同款注释见上方 真寄存器 处）
    假寄存器 = 值位函数名收口480(假寄存器, 指令, 寄存器计数);
    IR追加(指令, 建IR指令(IR_存储, 假寄存器, 0, 0, 0, 0, 临时槽));
    IR追加(指令, 建IR指令(IR_跳转, 0, 0, 0, 0, 0, 汇合块));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 汇合块));
    整64 汇合类型 = 查寄存器类型(真寄存器);
    如果 (汇合类型 == 0) { 汇合类型 = T_整64; }
    整64 载入寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 临时槽, 0, 0, 载入寄存器, 汇合类型, 0));
    登记寄存器类型(载入寄存器, 汇合类型);
    // 86-a：聚合地址化三元——汇合值即「选中 place 地址」（T_对象 标记：值=地址，
    //   非值装载）。消费面契约：实参回扫（回扫实参取地址）对 T_对象 实参跳过
    //   「把值装载改取槽地址」的改写——否则会把「临时槽地址」当结构体基址传给
    //   被调方（P47-v2/t5_3 实证乱码：拷了临时槽 8 字节+垃圾）。
    //   263①：聚合调用返回形态并入（区间末为聚合调用返回·分支值=物化独立槽
    //   地址——错值面）。泄漏面：纯调用形态（两分支都是聚合调用返回）时把
    //   物化临时身份转移到汇合载入寄存器（结构体返回临时们.设置）——原登记在
    //   真块/假块各自的物化槽地址寄存器上，而弹出项=汇合载入寄存器 → 975
    //   清理调用实参临时 匹配失败=物化临时（整盒含串·独立副本）无人回收；
    //   转移后调用发射完 975 按弹出项命中、以载入寄存器**运行时值**（被选分支
    //   写入的合法槽地址）释放——未选块未执行=无堆分配=零泄漏·无垃圾基址释放
    //   （9263tmp_d 1000 轮泄漏实锤同源）。混合形态（左值×调用）只修错值不转移
    //   登记——左值分支汇合值=局部变量地址，登记后清理会把局部串 free=毁源
    //   （局部由 RAII 块出口管辖·既有语义）；其泄漏面（若有）独立观察。
    布尔 真聚合调用d = 区间末为聚合调用返回(池, 整32(n.文本), 整32(n.附加));
    布尔 假聚合调用d = 区间末为聚合调用返回(池, 整32(n.附加), n.子终点);
    如果 (整64(n.文本) < 整64(n.附加) &&
        (区间末为聚合左值(池, 整32(n.文本), 整32(n.附加)) ||
         区间末为聚合左值(池, 整32(n.附加), n.子终点) ||
         真聚合调用d || 假聚合调用d)) {
        登记寄存器类型(载入寄存器, T_对象);
        如果 (真聚合调用d && 假聚合调用d) {
            整64 汇合结构IDd = 解析节点类型ID(池, 整32(n.附加) - 1);
            如果 (汇合结构IDd == 0) {
                汇合结构IDd = 解析节点类型ID(池, 整32(n.子终点) - 1);
            }
            如果 (汇合结构IDd != 0) {
                结果<空类型, 整32> 设汇d = 结构体返回临时们.设置(载入寄存器, 汇合结构IDd);
                如果 (!设汇d.正常) { 运行时错误(4); }
            }
        }
    }
    结果<空类型, 整32> 加汇 = 表达式栈.追加(载入寄存器);
    如果 (!加汇.正常) { 运行时错误(4); }
}

// 一元运算四兄弟（逻辑非/负号/取地址/解引用）——共用「弹到进入前深度再压结果」
//   一元模式（③ 第三波根治：操作数线性遍历残留弹清，防下标弹2取残留解引用崩）。
//   取地址经 生成左值地址（P6c）；只弹到进入前深度——原「清空全栈」会把先序
//   压栈的调用被调负符号/二元左操作数一并弹掉。
不安全 函数 生成一元运算(向量<节点> 池, 节点 n, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                 向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数,
                 向量<整64>& 表达式栈) -> 空类型 {
    如果 (n.类型 == 节点_取地址) {
        整64 取址前深度 = 表达式栈.大小();
        // 589-a（005〔原B-T81〕甲案 v2 同构·用户 09-21 裁决甲）：&类变量 →
        //   IR_加载(槽) 产**对象地址**——类=指针槽模型（槽存句柄），与 点* 类型
        //   标注一级语义对齐（宿主 588-a ir_expr_unary 同构：类→Load/结构体与
        //   标量维持槽地址）。原 生成左值地址 对类标识符=槽地址（二级错位）。
        //   静态类变量面（查静态序号）同口径：IR_指针加载(静态地址)=读静态槽
        //   得句柄；结果/可选=v2 合成结构体（非用户类）不受影响。
        如果 (n.子起点 > 0 && n.子起点 < n.子终点) {
            节点 取址子 = 池.元素(整32(n.子起点));
            如果 (取址子.类型 == 节点_标识符) {
                整64 取址类型ID = 解析标识符类型ID(整64(取址子.文本));
                如果 (取址类型ID >= 0) {
                    字符串 取址类型文本 = 字符串复制(驻留文本(取址类型ID));
                    如果 (是用户类(取址类型文本)) {
                        整64 类槽 = 0;
                        结果<整64, 整32> 找局取址 = 局部槽.获取(整64(取址子.文本));
                        如果 (找局取址.正常) { 类槽 = 找局取址.值; }
                        如果 (类槽 == 0) {
                            结果<整64, 整32> 找参取址 = 参数槽.获取(整64(取址子.文本));
                            如果 (找参取址.正常) { 类槽 = 找参取址.值; }
                        }
                        如果 (类槽 != 0) {
                            整64 类址reg = 寄存器计数[0];
                            寄存器计数[0] = 寄存器计数[0] + 1;
                            IR追加(指令, 建IR指令(IR_加载, 类槽, 0, 0, 类址reg,
                                                 T_对象, 0));
                            登记寄存器类型(类址reg, T_对象);
                            当 (表达式栈.大小() > 取址前深度) {
                                结果<空类型, 整32> 删栈q = 表达式栈.删除(表达式栈.大小() - 1);
                                如果 (!删栈q.正常) { 运行时错误(4); }
                            }
                            结果<空类型, 整32> 加址q = 表达式栈.追加(类址reg);
                            如果 (!加址q.正常) { 运行时错误(4); }
                            返回;
                        }
                    }
                }
            }
        }
        整64 地址寄存器 = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                     指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
        当 (表达式栈.大小() > 取址前深度) {
            结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈.正常) { 运行时错误(4); }
        }
        结果<空类型, 整32> 加 = 表达式栈.追加(地址寄存器);
        如果 (!加.正常) { 运行时错误(4); }
        返回;
    }
    // 其余四种：生成操作数（子区间）-> 一元指令
    整64 前深度 = 表达式栈.大小();
    整64 操作数寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                 指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    当 (表达式栈.大小() > 前深度) {
        结果<空类型, 整32> 删栈2 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈2.正常) { 运行时错误(4); }
    }
    // 414（#414·宿主 handleUnaryOperatorOverload 同构）：单目 - ! ~ 操作数为类
    //   实例且命中「运算符X」（0 右参）→ 降级成员方法调用；未命中返回 假=落
    //   下方内置一元指令（内置数值/布尔校验由语义层守卫管辖）。
    //   P0-3：位非入面（不再解析期脱糖——类「运算符~」由此发射）
    如果 (n.类型 == 节点_负号 || n.类型 == 节点_逻辑非 || n.类型 == 节点_位非) {
        如果 (发射运算符重载一元(池, n, 操作数寄存器, 指令, 寄存器计数, 槽计数, 表达式栈)) {
            返回;
        }
    }
    整64 寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    如果 (n.类型 == 节点_位非) {
        // 414 P0-3：位非内置展开（原解析期脱糖 ~x ≡ x ^ (0-1) 下沉至此·
        //   逐指令对齐原脱糖树形态：字面量1[T_整32]→负[产物随操作数域]→^。
        //   产物码=操作数码（宿主 lastType_=operandType·位模式 x^-1 任意域恒等）
        整64 一寄存器414 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_常量整数, 驻留("1"), 0, 0, 一寄存器414, T_整32, 0));
        登记寄存器类型(一寄存器414, T_整32);
        整64 负一寄存器414 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_负, 一寄存器414, 0, 0, 负一寄存器414, T_整32, 0));
        登记寄存器类型(负一寄存器414, T_整32);
        整64 操作数码414 = 查寄存器类型(操作数寄存器);
        如果 (操作数码414 == 0 || 操作数码414 == T_未知 ||
             操作数码414 == T_浮32 || 操作数码414 == T_浮64) {
            // 648：miss 不可静默——登记显形，收尾统一中止；原兜底保留（中止
            //   前路径）。位非为单目运算，操作数（字面量/标识符/子表达式产物）
            //   均应已登记类型；未登记/未知/浮点至此=登记缺陷真 miss 面（浮点
            //   为语义层已拒形态一并显形）。行号=0（发射期无源码行上下文）。
            登记内部未登记("位非操作码",
                           "寄存器" + 整数转字符串(操作数寄存器), 0);
            操作数码414 = T_整64;   // 未登记/浮点兜底（语义层已拒浮点·防御）
        }
        IR追加(指令, 建IR指令(IR_位异或, 操作数寄存器, 负一寄存器414, 0, 寄存器, 操作数码414, 0));
        登记寄存器类型(寄存器, 操作数码414);
    } 否则 如果 (n.类型 == 节点_逻辑非) {
        IR追加(指令, 建IR指令(IR_逻辑非, 操作数寄存器, 0, 0, 寄存器, T_整64, 0));
        登记寄存器类型(寄存器, T_布尔);
    } 否则 如果 (n.类型 == 节点_负号) {
        // 91-a：类型字段按操作数登记类型（浮点->浮点码——发射层走符号位翻转
        //   btc 63/fneg；整数 neg）；浮点负号产物登记（参与后续运算/打印）
        // 353-a（T60 根治·447 门禁）：整数面产物码**随操作数**且**整数面同浮点面
        //   登记**——原整数产物恒 T_整64 且不登记，`-1` 被抬公共提升进 64 位域，
        //   `整32/-1` 32 位回绕失效（447-6a：2147483648 vs 宿主 -2147483648；
        //   宿主负号=0-x 减法路径产物随操作数域·对齐）。布尔/字符/未登记兜底
        //   T_整64 不变（负布尔无语义面）。
        整64 负操作数码 = 查寄存器类型(操作数寄存器);
        // 814（053-001）：128 位一元负——__cn_neg_i128(句柄, dst地址) 取反加一；
        //   产物=2 槽临时基址句柄（打印/再运算/赋值消费）。
        // 474 收口接线：安全函数调 chk 版取负（INT128_MIN 取负→错误码 8·与
        //   宿主直发检查行为同构）；不安全 函数维持无检查版（回绕豁免）。
        如果 (负操作数码 == T_整128 || 负操作数码 == T_正128) {
            整64 负槽起 = 槽计数[0];
            槽计数[0] = 槽计数[0] + 2;
            IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 负槽起));
            IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 负槽起 + 1));
            整64 负dst = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_取地址, 负槽起 + 1, 0, 0, 负dst, T_整64, 0));
            IR追加(指令, 建IR指令(IR_调用实参, 操作数寄存器, 0, 0, 0, 0, 0));
            IR追加(指令, 建IR指令(IR_调用实参, 负dst, 0, 0, 1, 0, 0));
            字符串 负符号474 = "__cn_neg_i128";
            如果 (!读当前生成函数不安全474()) { 负符号474 = "__cn_neg_i128_chk"; }
            IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                                 驻留(负符号474)));
            整64 负句柄 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_取地址, 负槽起 + 1, 0, 0, 负句柄, T_整64, 0));
            登记寄存器类型(负句柄, 负操作数码);
            结果<空类型, 整32> 加负 = 表达式栈.追加(负句柄);
            如果 (!加负.正常) { 运行时错误(4); }
            返回;
        }
        整64 负结果码 = T_整64;
        如果 (负操作数码 == T_浮32 || 负操作数码 == T_浮64 ||
             负操作数码 == T_整8 || 负操作数码 == T_整16 || 负操作数码 == T_整32 ||
             负操作数码 == T_整64 || 负操作数码 == T_正8 || 负操作数码 == T_正16 ||
             负操作数码 == T_正32 || 负操作数码 == T_正64) {
            负结果码 = 负操作数码;
        }
        // 474（运行期整数溢出·错误码 8）：有符号整型取负 INT_MIN 检查——检查码
        //   经池回溯源码类型（操作数末节点=子终点-1·寄存器码窄信息被类型码归并
        //   丢失，二元 377 同口径）：窄名→窄域检查（整16 -(-32768)→错误 8）、
        //   字面量→T_整32；无符号取负=两补码回绕语义（x86 neg 模 2^W）不设；
        //   浮点/位非脱糖（附加 0）不涉。不安全 函数内=0 豁免。
        整64 负检查码474 = 0;
        如果 (n.子终点 >= 1 && n.子终点 <= 整32(池.大小())) {
            节点 负末474 = 池.元素(整32(n.子终点) - 1);
            如果 (负末474.类型 == 节点_整数字面量 ||
                 (负末474.类型 == 节点_负号 && 负末474.子起点 > 0 &&
                  池.元素(负末474.子起点).类型 == 节点_整数字面量)) {
                // 字面量按整32 参与（285 同口径）——**经 豁免判**（修前直赋=
                //   不安全 函数内字面量负号取负照样报 8·447 验收分叉根因）
                负检查码474 = 溢出检查码474(T_整32);
            } 否则 {
                负检查码474 = 溢出检查码474(检查码自类型名ID(解析节点类型ID(池, 整32(n.子终点) - 1)));
            }
        }
        IR追加(指令, 建IR指令(IR_负, 操作数寄存器, 0, 0, 寄存器, 负结果码, 负检查码474));
        如果 (负结果码 == T_浮32 || 负结果码 == T_浮64 ||
             负结果码 == T_整8 || 负结果码 == T_整16 || 负结果码 == T_整32 ||
             负结果码 == T_整64 || 负结果码 == T_正8 || 负结果码 == T_正16 ||
             负结果码 == T_正32 || 负结果码 == T_正64) {
            登记寄存器类型(寄存器, 负结果码);
        }
    } 否则 {
        // 节点_解引用：* 指针 -> IR_指针加载
        // 266-a 波B：类型码=所指类型宽度码；字符借用视图豁免=A2 字符* 字符串
        //   同码（内容=整串视图非单字符·261 面）。
        // 813（2026-10-16）：推导收口 解引用所指宽度码813 单点（宿主 pointer
        //   PointeeSrcType 同构——标识符/成员链/指针算术/一元递归·操作数取**末
        //   节点** 子终点-1〔655 设计注记：成员链尾=字段节点·单节点形态同旧首
        //   节点〕）；修前只认 首节点标识符——成员链 *b.游标 恒兜底 T_整64 8 字
        //   节宽读（探针 992b=38654705672=池[1]|池[2] 两字段拼接实锤）。miss=
        //   648 显形（公共内登记内部未登记·兜底保留=中止前路径控制流零变更）。
        整64 所指码 = 解引用所指宽度码813(池, n);
        IR追加(指令, 建IR指令(IR_指针加载, 操作数寄存器, 0, 0, 寄存器, 所指码, 0));
        如果 (所指码 != T_整64) {
            登记寄存器类型(寄存器, 所指码);
        }
    }
    结果<空类型, 整32> 加2 = 表达式栈.追加(寄存器);
    如果 (!加2.正常) { 运行时错误(4); }
}

