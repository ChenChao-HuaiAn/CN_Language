// CN 自举编译器 v2 · 生成表达式——运算族（生成短路求值 + 生成三元运算 + 生成一元运算）（D1 行数整改 120-a：自 生成表达式.cn 按族拆出）
//   纯重构零行为变更（同包「多文件合并全局可见」——函数跨文件互调无障碍；
//   与主模块函数互调经包内合并池解析，见 公开: 注释同款纪律）。
导入 容器::向量;
导入 语法;
导入 IR;
导入 IR生成;
导入 生成表达式求值;

公开:

// 短路求值（缺陷B 根治，规范 930）：&&/|| 左操作数先行、右操作数惰性——
//   a 假/真 短路保留 a；右值经临时槽汇合，逻辑非×2 规范化 0/1（对标 C 语义值）。
//   递归生成 左/右子区间；出口等价消费 1 个位置（主循环统一 位置++）。
不安全 函数 生成短路求值(向量<节点> 池, 节点 n, 字符串 op名, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                 向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数,
                 向量<整64>& 表达式栈) -> 空类型 {
    // 88-a（2026-09-12 第八十八轮）根治：原实现「只压不弹」——左/右递归子区间
    //   各 +1、末尾结果再 +1（净 **+3**），破坏「表达式求值净栈 +1」契约 → 实参位
    //   短路 `f(a || b)` 经 生成调用 弹（实参数+被调）弹到左操作数寄存器=被调错位
    //   （`[ir2] 调用被调对象非函数名/方法` + 运行时错误6；87-a 探针 v2w 实证，
    //   宿主同形态正确）。修法=与 生成三元运算 同构的「递归子区间 + 归位」：
    //   每段递归后 表达式栈弹到深度（左/右值已由返回值持有，栈上副本即丢弃；
    //   子区间内层残留一并自愈清理），末尾压唯一结果（净 +1）。
    //   87-a 曾尝试「栈基线净化」未果（残留在本层之外），本轮以归位原语统一收口
    //   （IR生成.表达式栈弹到深度/表达式栈归位压回——净栈契约单一事实源）。
    整64 进入深度 = 表达式栈.大小();
    整64 左寄存器 = 生成表达式(池, n.子起点, 整32(n.附加), 局部槽, 参数槽,
                              指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    表达式栈弹到深度(表达式栈, 进入深度);
    整64 临时槽 = 槽计数[0];
    槽计数[0] = 槽计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 临时槽));   // 帧登记（扫描函数 据此计帧）
    IR追加(指令, 建IR指令(IR_存储, 左寄存器, 0, 0, 0, 0, 临时槽));
    整64 汇合块 = 块计数[0] + 1;
    块计数[0] = 块计数[0] + 2;
    整64 求值块 = 汇合块 + 1;
    如果 (字符串比较(op名, "&&")) {
        // && ：a 真 -> 求值 b（假短路，保留 a=0）
        IR追加(指令, 建IR指令(IR_条件跳转, 左寄存器, 求值块, 汇合块, 0, 0, 0));
    } 否则 {
        // || ：a 假 -> 求值 b（真短路，保留 a）
        IR追加(指令, 建IR指令(IR_条件跳转, 左寄存器, 汇合块, 求值块, 0, 0, 0));
    }
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 求值块));
    整64 右寄存器 = 生成表达式(池, 整32(n.附加), n.子终点, 局部槽, 参数槽,
                              指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    表达式栈弹到深度(表达式栈, 进入深度);
    IR追加(指令, 建IR指令(IR_存储, 右寄存器, 0, 0, 0, 0, 临时槽));
    IR追加(指令, 建IR指令(IR_跳转, 0, 0, 0, 0, 0, 汇合块));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 汇合块));
    整64 载入寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 临时槽, 0, 0, 载入寄存器, T_整64, 0));
    整64 非寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_逻辑非, 载入寄存器, 0, 0, 非寄存器, T_整64, 0));
    整64 逻辑结果 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_逻辑非, 非寄存器, 0, 0, 逻辑结果, T_整64, 0));
    登记寄存器类型(逻辑结果, T_布尔);
    结果<空类型, 整32> 加逻 = 表达式栈.追加(逻辑结果);
    如果 (!加逻.正常) { 运行时错误(4); }
}

// 末端节点类型码推导（拼接双侧兜底共用——原左/右两段同构，R3 合并消重）：
//   字符串字面量直判；否则 解析节点类型ID；调用被调再查 内置返回表/函数返回回退。
//   返回 类型码（0=未登记）。
函数 推导末端类型码(向量<节点> 池, 整32 末端位置) -> 整64 {
    节点 末端 = 池.元素(末端位置);
    整64 类型ID = 0;
    如果 (末端.类型 == 节点_字符串字面量) {
        类型ID = 驻留("字符串");
    } 否则 {
        类型ID = 解析节点类型ID(池, 末端位置);
        如果 (类型ID == 0 && 末端.类型 == 节点_调用 && 末端.子起点 > 0) {
            节点 被调 = 池.元素(整32(末端.子起点));
            如果 (被调.类型 == 节点_标识符) {
                类型ID = 内置函数返回类型ID(驻留文本(整64(被调.文本)));
                如果 (类型ID == 0) {
                    类型ID = 查函数返回回退(整64(被调.文本));
                }
            }
        }
    }
    返回 类型码(类型ID);
}

// 字符串拼接发射：数值侧隐式转换（from_int/from_float/from_bool，宿主 Task 2.9——
//   未登记类型按整数兜底）+ __cn_str_concat 裸 ASCII 直调（实参位 0/1，产物登记
//   T_字符串——链式外层判定用）。
不安全 函数 发射字符串拼接(整64 拼接左码, 整64 拼接右码, 整64 左, 整64 右,
                   向量<IR指令>& 指令, 整64* 寄存器计数, 向量<整64>& 表达式栈) -> 空类型 {
    如果 (拼接左码 != T_字符串) {
        // 92-a：浮32 数值侧先宽化 f64（__cn_str_from_float 形参为 double——
        //   原以 T_浮32 实参发射则 xmm0 低 32 位 f32 位模式被当 double 读，
        //   拼接恒 0.000000；与 91-a 内置边界提升同款，拼接路径原漏网）
        如果 (拼接左码 == T_浮32) {
            左 = 插入值转换(左, T_浮64, 指令, 寄存器计数);
            拼接左码 = T_浮64;
        }
        整64 左转 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        // 91-a：实参类型码=数值侧码（浮点走 xmm0——__cn_str_from_float(double)）
        IR追加(指令, 建IR指令(IR_调用实参, 左, 拼接左码, 0, 0, 0, 0));
        IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 左转, 0,
                             驻留(转换符号(拼接左码))));
        登记寄存器类型(左转, T_字符串);
        左 = 左转;
    }
    如果 (拼接右码 != T_字符串) {
        // 92-a：浮32 数值侧先宽化 f64（同左侧）
        如果 (拼接右码 == T_浮32) {
            右 = 插入值转换(右, T_浮64, 指令, 寄存器计数);
            拼接右码 = T_浮64;
        }
        整64 右转 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_调用实参, 右, 拼接右码, 0, 0, 0, 0));
        IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 右转, 0,
                             驻留(转换符号(拼接右码))));
        登记寄存器类型(右转, T_字符串);
        右 = 右转;
    }
    整64 拼接寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_调用实参, 左, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用实参, 右, 0, 0, 0, 1, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 拼接寄存器, 0,
                         驻留("__cn_str_concat")));
    登记寄存器类型(拼接寄存器, T_字符串);
    结果<空类型, 整32> 加拼栈 = 表达式栈.追加(拼接寄存器);
    如果 (!加拼栈.正常) { 运行时错误(4); }
}

// 91-a（2026-09-13 第九十一轮）：隐式值转换插入（浮点混合运算整数侧宽化）——
//   发射层按 (源码=操作数2, 目标码=类型字段) 组合分派（整->浮 cvtsi2sd/scvtf、
//   浮->整 cvttsd2si/fcvtzs、浮32<->浮64 cvtss2sd/cvtss2df 族）。
//   源码取寄存器登记（0=未登记按 T_整64 发射读法兜底）。
不安全 函数 插入值转换(整64 源reg, 整64 目标码, 向量<IR指令>& 指令,
                 整64* 寄存器计数) -> 整64 {
    整64 转换reg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    整64 源码 = 查寄存器类型(源reg);
    IR追加(指令, 建IR指令(IR_类型转换, 源reg, 源码, 0, 转换reg, 目标码, 0));
    登记寄存器类型(转换reg, 目标码);
    返回 转换reg;
}

// 二元运算主体（非短路）：字符串拼接 +（双侧隐式转换 __cn_str_concat）与
//   算术/比较指令发射。位置 为值参（仅读：右侧末端=位置-1 推导兜底）；
//   拼接路径提前返回、算术路径自然落出——出口等价消费 1 个位置。
不安全 函数 生成二元运算主体(向量<节点> 池, 节点 n, 字符串 op名, 整32 位置,
                     映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                     向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数,
                     向量<整64>& 表达式栈) -> 空类型 {
    // ③ 第一波（2026-09-03，缺陷②根治）：字符串拼接 +（宿主 Task 2.5/2.9 对齐：
    //   __cn_str_concat 左结合、产物为字符串；字符串+数值 双向隐式转换——
    //   数值侧先 __cn_str_from_int/float/bool 再 concat）。判定：左右任一为
    //   字符串（寄存器类型登记表——字面量/标识符加载/拼接产物/内置返回；
    //   未登记侧末端节点推导兜底）
    布尔 拼接加 = 假;
    整64 拼接左码 = 0;
    整64 拼接右码 = 0;
    // 215-a（2026-09-15 第两百一十五轮，D1 行数整改）：拼接判定迁 判定字符串拼接
    //   （3 项引用输出）；浮点混合转换迁 浮点混合转换（左右寄存器引用输出）。
    判定字符串拼接(池, n, op名, 位置, 表达式栈, 拼接加, 拼接左码, 拼接右码);
    // 弹 2 个操作数，生成运算指令
    整64 右 = 0;
    整64 左 = 0;
    如果 (表达式栈.大小() >= 2) {
        右 = 表达式栈.元素(表达式栈.大小() - 1);
        结果<空类型, 整32> 删右 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删右.正常) { 运行时错误(4); }
        左 = 表达式栈.元素(表达式栈.大小() - 1);
        结果<空类型, 整32> 删左 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删左.正常) { 运行时错误(4); }
    }
    如果 (拼接加) {
        发射字符串拼接(拼接左码, 拼接右码, 左, 右, 指令, 寄存器计数, 表达式栈);
        返回;
    }
    整64 op = 0;
    如果 (字符串比较(op名, "+")) { op = IR_加; }
    否则 如果 (字符串比较(op名, "-")) { op = IR_减; }
    否则 如果 (字符串比较(op名, "*")) { op = IR_乘; }
    否则 如果 (字符串比较(op名, "/")) { op = IR_除; }
    否则 如果 (字符串比较(op名, "%")) { op = IR_取余; }
    否则 如果 (字符串比较(op名, "==")) { op = IR_相等; }
    否则 如果 (字符串比较(op名, "!=")) { op = IR_不等; }
    否则 如果 (字符串比较(op名, "<")) { op = IR_小于; }
    否则 如果 (字符串比较(op名, ">")) { op = IR_大于; }
    否则 如果 (字符串比较(op名, "<=")) { op = IR_小于等于; }
    否则 如果 (字符串比较(op名, ">=")) { op = IR_大于等于; }
    // 位运算五算子（2026-09-09 规范 01b§5.4；IR_位与/位或/位异或 既有预留启用，
    //   移位 68/69 新设——注释见 IR常量.cn）
    否则 如果 (字符串比较(op名, "&")) { op = IR_位与; }
    否则 如果 (字符串比较(op名, "|")) { op = IR_位或; }
    否则 如果 (字符串比较(op名, "^")) { op = IR_位异或; }
    否则 如果 (字符串比较(op名, "<<")) { op = IR_左移; }
    否则 如果 (字符串比较(op名, ">>")) { op = IR_右移; }
    // && / || 已在短路分支处理（原 IR_相等 防御语义错误，已删）
    // 91-a（2026-09-13 第九十一轮）：浮点混合运算隐式转换（宿主对齐：浮64 + 整
    //   自动宽化，fp9 实测宿主 `乙 + 2` = 5.5）——一侧浮点一侧整数时，整数侧
    //   插入 IR_类型转换（整->浮）。结果浮点码：单侧浮点取该侧（含浮32），
    //   双侧浮点混合取浮64（宽化方向）。取余/位运算不转换（宿主 `%` 拒绝
    //   浮点操作数、规范 5.4 位运算仅整型）。
    // 266-a 波B：指针算术步进糖——左操作数带指针步进标记（指针变量加载时
    //   登记·寄存器级判定零池回溯）时，右操作数 × 元素宽 后再加/减（宿主指针
    //   算术步进=元素宽对齐）。经 查指针值步进 访问器（跨文件边界）。
    如果 (op == IR_加 || op == IR_减) {
        整64 左步进 = 查指针值步进(左);
        如果 (左步进 > 1) {
            整64 步进寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(左步进)),
                                  0, 0, 步进寄存器, T_整64, 0));
            IR追加(指令, 建IR指令(IR_乘, 右, 步进寄存器, 0, 右, T_整64, 0));
        }
    }
    浮点混合转换(op, 左, 右, 指令, 寄存器计数);
    整64 寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    // 46-f 无符号语义轮（2026-09-10 第五十轮）：二元指令类型字段=操作数寄存器
    //   登记类型（原恒 T_整64——正32/正64 操作数的无符号性在此丢失，后端无从
    //   分派 div/shr/setb 族无符号指令）。取左优先（混合宽度宽松语义取左），
    //   右侧为无符号码时取右；两侧均非无符号码兜底 T_整64（既有行为不变）。
    //   比较产物仍登记 T_布尔（结果语义与操作数符号性无关）。
    // 91-a：浮点码优先（浮点操作数存在时类型字段取浮点码——后端据此分派
    //   SSE/f 族指令与 ucomisd/fcmp 比较）。
    // 265-a 波A：公共类型提升（替换 46-f「取左白名单」）——浮点面保持既有
    //   语义（单侧浮取该侧·91-a 转换后即公共浮码）；整型族=位宽大者胜/
    //   同宽混升整64/双正32 保留无符号截断面/双整32=T_整32（配套 264-a
    //   后端截断）。178 的 5<<33 按左=整32 mod32 根治；380 的 常量*整64
    //   提升整64 不截断（263-a 取左缺陷正确化）。
    //   比较产物仍登记 T_布尔（结果语义与操作数符号性无关）。
    整64 左码提升 = 查寄存器类型(左);
    整64 右码提升 = 查寄存器类型(右);
    整64 二元类型 = T_整64;
    如果 (左码提升 == T_浮32 || 左码提升 == T_浮64 ||
        右码提升 == T_浮32 || 右码提升 == T_浮64) {
        如果 (左码提升 == T_浮32 || 左码提升 == T_浮64) { 二元类型 = 左码提升; }
        否则 { 二元类型 = 右码提升; }
    } 否则 {
        二元类型 = 公共整型提升(左码提升, 右码提升);
    }
    // 移位类型覆盖：移位量取模=左操作数类型位宽（规范 01b§5.4·C 语义）——
    //   不用公共提升（右操作数宽度不参与）；左=T_整32 字面量形态即 178 面。
    如果 (op == IR_左移 || op == IR_右移) {
        如果 (查寄存器类型(左) == T_整32) { 二元类型 = T_整32; }
    }
    IR追加(指令, 建IR指令(op, 左, 右, 0, 寄存器, 二元类型, 0));
    // ③：比较运算产物登记 T_布尔（打印 真/假 与拼接 from_bool 分派用）；
    // 91-a：浮点算术产物登记（原「算术产物不登记——按整数兜底」——打印浮点
    //   结果误走 __cn_print_int、嵌套浮点运算类型丢失；登记后打印/拼接/再运算
    //   全链消费正确）
    如果 (op == IR_相等 || op == IR_不等 || op == IR_小于 || op == IR_大于 ||
         op == IR_小于等于 || op == IR_大于等于) {
        登记寄存器类型(寄存器, T_布尔);
    } 否则 如果 (二元类型 == T_浮32 || 二元类型 == T_浮64) {
        登记寄存器类型(寄存器, 二元类型);
    }
    结果<空类型, 整32> 加 = 表达式栈.追加(寄存器);
    如果 (!加.正常) { 运行时错误(4); }
}

// 215-a：族① 拼接判定（③ 第一波：字符串拼接 + 双侧隐式转换——寄存器类型登记表
//   判定 + 末端节点推导兜底）。3 项引用输出：拼接加/拼接左码/拼接右码。
不安全 函数 判定字符串拼接(向量<节点> 池, 节点 n, 字符串 op名, 整32 位置,
                     向量<整64>& 表达式栈, 布尔& 拼接加, 整64& 拼接左码, 整64& 拼接右码) -> 空类型 {
    如果 (字符串比较(op名, "+") && 表达式栈.大小() >= 2) {
        整64 栈右 = 表达式栈.元素(表达式栈.大小() - 1);
        整64 栈左 = 表达式栈.元素(表达式栈.大小() - 2);
        拼接左码 = 查寄存器类型(栈左);
        拼接右码 = 查寄存器类型(栈右);
        如果 (拼接左码 == 0) {
            // 左侧末端推导兜底（附加=右操作数起点，左末端=附加-1）
            拼接左码 = 推导末端类型码(池, 整32(n.附加) - 1);
        }
        如果 (拼接右码 == 0) {
            // 右侧未登记（成员/调用对象等）——末端节点推导兜底
            拼接右码 = 推导末端类型码(池, 位置 - 1);
        }
        如果 (拼接左码 == T_字符串 || 拼接右码 == T_字符串) {
            拼接加 = 真;
        }
    }
}

// 215-a：族② 浮点混合转换（91-a：浮64+整 自动宽化·92-a 单侧浮32 升 f64 禁止隐式
//   窄化·统一按操作数码≠公共浮码插入转换）。左右寄存器引用输出（转换后更新）。
不安全 函数 浮点混合转换(整64 op, 整64& 左, 整64& 右, 向量<IR指令>& 指令, 整64* 寄存器计数) -> 空类型 {
    整64 左码浮 = 查寄存器类型(左);
    整64 右码浮 = 查寄存器类型(右);
    布尔 是浮点左 = (左码浮 == T_浮32 || 左码浮 == T_浮64);
    布尔 是浮点右 = (右码浮 == T_浮32 || 右码浮 == T_浮64);
    布尔 是算比 = (op == IR_加 || op == IR_减 || op == IR_乘 || op == IR_除 ||
                  op == IR_相等 || op == IR_不等 || op == IR_小于 ||
                  op == IR_大于 || op == IR_小于等于 || op == IR_大于等于);
    如果 ((是浮点左 || 是浮点右) && 是算比) {
        整64 浮码 = T_浮64;
        如果 (是浮点左 && !是浮点右) { 浮码 = 左码浮; }
        否则 如果 (是浮点右 && !是浮点左) { 浮码 = 右码浮; }
        否则 如果 (左码浮 == T_浮32 && 右码浮 == T_浮32) { 浮码 = T_浮32; }
        // 92-a（2026-09-13 第九十二轮）：单侧浮点为浮32、另一侧为整型 → 升 f64
        //   （禁止隐式窄化——整型转 浮32 有损，规范「仅允许无损或宽化转换」；
        //   对齐宿主「整 + 浮 → f64」与 92-a 宿主侧修复）。原「单侧浮点取该侧」
        //   在浮32 时把整型操作数窄化到 f32：实证 甲(浮32)+16777217 宿主
        //   16777218.5 / v2 前值 16777218.0（双侧分叉）。
        如果 ((是浮点左 && !是浮点右 && 左码浮 == T_浮32) ||
            (是浮点右 && !是浮点左 && 右码浮 == T_浮32)) { 浮码 = T_浮64; }
        // 92-a：统一按「操作数码 ≠ 公共浮码」插入转换（原判定仅 非浮点侧 转换
        //   ——浮码为 f64 时已是浮点的 浮32 侧被漏掉：f32 位模式直进 xmm 双精度
        //   运算/比较（f32+f64 双侧浮点形态原有同款漏网，本轮一并根治）。
        如果 (左码浮 != 浮码) {
            左 = 插入值转换(左, 浮码, 指令, 寄存器计数);
            左码浮 = 浮码;
            是浮点左 = 真;
        }
        如果 (右码浮 != 浮码) {
            右 = 插入值转换(右, 浮码, 指令, 寄存器计数);
            右码浮 = 浮码;
            是浮点右 = 真;
        }
    }
}


// 86-a（2026-09-12 复审缺陷①）：三元聚合分支的「聚合左值」判定——区间末节点为
//   标识符/成员/下标/解引用且类型为结构体（查结构体大小>0，含结果/可选合成
//   结构体）时，分支求值改走 生成左值地址（**地址透传**）。
//   根因（P41/最小3 实证）：通用 生成表达式 对结构体标识符恒发射 8 字节 IR_加载
//   （首字段值，非地址）→ 三元汇合把「首字段值」当地址 → 返回位整体拷贝 rep movsb
//   从地址 11 读 → 段错误 rc=139。宿主同款修复：分支地址透传（visitTernaryExpr
//   聚合约定「分支 Store 地址、汇合 Load 地址」，见 ir_expr.cpp）。
//   非左值分支（调用返回=retbuf 地址 / 字面量=临时槽地址 / 嵌套三元=地址）本身
//   已是以「地址」为值的形态，保持 生成表达式 原路径。
函数 区间末为聚合左值(向量<节点> 池, 整32 起, 整32 终) -> 布尔 {
    如果 (终 <= 起) { 返回 假; }
    整32 末索引 = 终 - 1;
    节点 末 = 池.元素(末索引);
    如果 (!(末.类型 == 节点_标识符 || 末.类型 == 节点_成员 ||
          末.类型 == 节点_下标 || 末.类型 == 节点_解引用)) { 返回 假; }
    整64 类型ID = 解析节点类型ID(池, 末索引);
    如果 (类型ID == 0) { 返回 假; }
    返回 查结构体大小(类型ID) > 0;
}

// 三元条件（③ 第六波，规范 01b 5.8）——惰性求值：条件跳转分派，仅选中分支
//   求值。复用短路方案：临时槽（IR_分配 帧登记）汇合两分支值，三块（真/假/汇合）。
//   栈平衡：各段递归后弹到进入前深度再压汇合结果（一元模式——净 +1，中间残留
//   全清，防「下标弹2取到残留」同族缺陷）。汇合类型=真分支寄存器登记类型
//   （语义层已保证两分支可合并；未登记兜底 T_整64——标识符加载同款）
//   86-a：聚合分支经 区间末为聚合左值 改走左值地址（地址透传，宿主同款）。
不安全 函数 生成三元运算(向量<节点> 池, 节点 n, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                 向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数,
                 向量<整64>& 表达式栈) -> 空类型 {
    整64 三元前深度 = 表达式栈.大小();
    整64 条件寄存器 = 生成表达式(池, n.子起点, n.文本, 局部槽, 参数槽,
                                指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    当 (表达式栈.大小() > 三元前深度) {
        结果<空类型, 整32> 删条 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删条.正常) { 运行时错误(4); }
    }
    整64 临时槽 = 槽计数[0];
    槽计数[0] = 槽计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 临时槽));
    整64 真块 = 块计数[0] + 1;
    整64 假块 = 块计数[0] + 2;
    整64 汇合块 = 块计数[0] + 3;
    块计数[0] = 块计数[0] + 3;
    IR追加(指令, 建IR指令(IR_条件跳转, 条件寄存器, 真块, 假块, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 真块));
    整64 真寄存器 = 0;
    如果 (区间末为聚合左值(池, 整32(n.文本), 整32(n.附加))) {
        真寄存器 = 生成左值地址(池, 整32(n.文本), 整32(n.附加), 局部槽, 参数槽,
                                指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    } 否则 {
        真寄存器 = 生成表达式(池, 整32(n.文本), 整32(n.附加), 局部槽, 参数槽,
                              指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    }
    当 (表达式栈.大小() > 三元前深度) {
        结果<空类型, 整32> 删真 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删真.正常) { 运行时错误(4); }
    }
    IR追加(指令, 建IR指令(IR_存储, 真寄存器, 0, 0, 0, 0, 临时槽));
    IR追加(指令, 建IR指令(IR_跳转, 0, 0, 0, 0, 0, 汇合块));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 假块));
    整64 假寄存器 = 0;
    如果 (区间末为聚合左值(池, 整32(n.附加), n.子终点)) {
        假寄存器 = 生成左值地址(池, 整32(n.附加), n.子终点, 局部槽, 参数槽,
                                指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    } 否则 {
        假寄存器 = 生成表达式(池, 整32(n.附加), n.子终点, 局部槽, 参数槽,
                              指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    }
    当 (表达式栈.大小() > 三元前深度) {
        结果<空类型, 整32> 删假 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删假.正常) { 运行时错误(4); }
    }
    IR追加(指令, 建IR指令(IR_存储, 假寄存器, 0, 0, 0, 0, 临时槽));
    IR追加(指令, 建IR指令(IR_跳转, 0, 0, 0, 0, 0, 汇合块));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 汇合块));
    整64 汇合类型 = 查寄存器类型(真寄存器);
    如果 (汇合类型 == 0) { 汇合类型 = T_整64; }
    整64 载入寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 临时槽, 0, 0, 载入寄存器, 汇合类型, 0));
    登记寄存器类型(载入寄存器, 汇合类型);
    // 86-a：聚合地址化三元——汇合值即「选中 place 地址」（T_对象 标记：值=地址，
    //   非值装载）。消费面契约：实参回扫（回扫实参取地址）对 T_对象 实参跳过
    //   「把值装载改取槽地址」的改写——否则会把「临时槽地址」当结构体基址传给
    //   被调方（P47-v2/t5_3 实证乱码：拷了临时槽 8 字节+垃圾）。
    如果 (整64(n.文本) < 整64(n.附加) &&
        (区间末为聚合左值(池, 整32(n.文本), 整32(n.附加)) ||
         区间末为聚合左值(池, 整32(n.附加), n.子终点))) {
        登记寄存器类型(载入寄存器, T_对象);
    }
    结果<空类型, 整32> 加汇 = 表达式栈.追加(载入寄存器);
    如果 (!加汇.正常) { 运行时错误(4); }
}

// 一元运算四兄弟（逻辑非/负号/取地址/解引用）——共用「弹到进入前深度再压结果」
//   一元模式（③ 第三波根治：操作数线性遍历残留弹清，防下标弹2取残留解引用崩）。
//   取地址经 生成左值地址（P6c）；只弹到进入前深度——原「清空全栈」会把先序
//   压栈的调用被调负符号/二元左操作数一并弹掉。
不安全 函数 生成一元运算(向量<节点> 池, 节点 n, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                 向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数,
                 向量<整64>& 表达式栈) -> 空类型 {
    如果 (n.类型 == 节点_取地址) {
        整64 取址前深度 = 表达式栈.大小();
        整64 地址寄存器 = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                     指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
        当 (表达式栈.大小() > 取址前深度) {
            结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈.正常) { 运行时错误(4); }
        }
        结果<空类型, 整32> 加 = 表达式栈.追加(地址寄存器);
        如果 (!加.正常) { 运行时错误(4); }
        返回;
    }
    // 其余三种：生成操作数（子区间）-> 一元指令
    整64 前深度 = 表达式栈.大小();
    整64 操作数寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                 指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    当 (表达式栈.大小() > 前深度) {
        结果<空类型, 整32> 删栈2 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈2.正常) { 运行时错误(4); }
    }
    整64 寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    如果 (n.类型 == 节点_逻辑非) {
        IR追加(指令, 建IR指令(IR_逻辑非, 操作数寄存器, 0, 0, 寄存器, T_整64, 0));
        登记寄存器类型(寄存器, T_布尔);
    } 否则 如果 (n.类型 == 节点_负号) {
        // 91-a：类型字段按操作数登记类型（浮点->浮点码——发射层走符号位翻转
        //   btc 63/fneg；整数 neg）；浮点负号产物登记（参与后续运算/打印）
        // 353-a（T60 根治·447 门禁）：整数面产物码**随操作数**且**整数面同浮点面
        //   登记**——原整数产物恒 T_整64 且不登记，`-1` 被抬公共提升进 64 位域，
        //   `整32/-1` 32 位回绕失效（447-6a：2147483648 vs 宿主 -2147483648；
        //   宿主负号=0-x 减法路径产物随操作数域·对齐）。布尔/字符/未登记兜底
        //   T_整64 不变（负布尔无语义面）。
        整64 负操作数码 = 查寄存器类型(操作数寄存器);
        整64 负结果码 = T_整64;
        如果 (负操作数码 == T_浮32 || 负操作数码 == T_浮64 ||
             负操作数码 == T_整8 || 负操作数码 == T_整16 || 负操作数码 == T_整32 ||
             负操作数码 == T_整64 || 负操作数码 == T_正8 || 负操作数码 == T_正16 ||
             负操作数码 == T_正32 || 负操作数码 == T_正64) {
            负结果码 = 负操作数码;
        }
        IR追加(指令, 建IR指令(IR_负, 操作数寄存器, 0, 0, 寄存器, 负结果码, 0));
        如果 (负结果码 == T_浮32 || 负结果码 == T_浮64 ||
             负结果码 == T_整8 || 负结果码 == T_整16 || 负结果码 == T_整32 ||
             负结果码 == T_整64 || 负结果码 == T_正8 || 负结果码 == T_正16 ||
             负结果码 == T_正32 || 负结果码 == T_正64) {
            登记寄存器类型(寄存器, 负结果码);
        }
    } 否则 {
        // 节点_解引用：* 指针 -> IR_指针加载
        // 266-a 波B：类型码=所指类型宽度码——标识符操作数查 指针变量类型们
        //   （经同文件静态·下标读分支同款先例）；字符借用视图豁免=A2 字符*
        //   字符串同码（内容=整串视图非单字符·261 面）；复杂操作数兜底 T_整64。
        整64 所指码 = T_整64;
        如果 (n.子起点 > 0) {
            节点 操作数节点 = 池.元素(整32(n.子起点));
            如果 (操作数节点.类型 == 节点_标识符) {
                结果<整64, 整32> 查所指 = 指针变量类型们.获取(整64(操作数节点.文本));
                如果 (查所指.正常) {
                    如果 (字符串比较(驻留文本(查所指.值), "字符")) {
                        所指码 = T_字符串;
                    } 否则 {
                        所指码 = 类型宽度码(驻留文本(查所指.值));
                    }
                }
            }
        }
        IR追加(指令, 建IR指令(IR_指针加载, 操作数寄存器, 0, 0, 寄存器, 所指码, 0));
        如果 (所指码 != T_整64) {
            登记寄存器类型(寄存器, 所指码);
        }
    }
    结果<空类型, 整32> 加2 = 表达式栈.追加(寄存器);
    如果 (!加2.正常) { 运行时错误(4); }
}


// ==================== 296-a（D35 波B·2026-09-17）：后缀错误传播 表达式? ====================
// C-1（规范 07，宿主 ir_expr_unary.cpp Operator::Propagate 同构）：操作数为
//   结果<T,E>/可选<T>——正常取 .值 继续；失败构造 错误结果 沿 retbuf 直接返回
//   （Rust ? 语义）。布局协议（生成装箱构造 同源）：标志@0(T_整32 写)+联合载荷
//   @max(结果值偏移(T),结果值偏移(E))；被调 retbuf=槽1 指针（返回 结果/可选 时
//   生成函数保留），err 块就地写 retbuf {标志=0, 错误=E} 后 IR_返回+跳尾块
//   （生成返回语句 同款块终结惯例）；ok 块读值压栈（净 +1——三元汇合同款）。
//   宽错误码传播：读按操作数 E 宽度、写按返回 E' 宽度、IR_类型转换 桥接
//   （宿主 2026-08-25 根治同构）。语义标注：n.附加=操作数类型合成名ID、
//   n.文本=函数返回类型合成名ID（检查错误传播表达式 回填·装箱构造 子终点
//   标注同款），缺失=IR层诊断 fail fast。
不安全 函数 生成错误传播(向量<节点> 池, 节点 n, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                 向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数,
                 向量<整64>& 表达式栈) -> 空类型 {
    整64 传前深度 = 表达式栈.大小();
    整64 操作数类型ID = 整64(n.附加);
    整64 返回类型ID = 整64(n.文本);
    如果 (操作数类型ID <= 0 || 返回类型ID <= 0) {
        IR层诊断("错误传播 ? 缺语义标注（操作数/函数返回类型——语义层未回填）");
    }
    字符串 操作数名 = 字符串复制(驻留文本(操作数类型ID));
    字符串 返回名 = 字符串复制(驻留文本(返回类型ID));
    布尔 操作可选 = 字符串比较(合成名基名(操作数名), "可选");
    布尔 返回可选 = 字符串比较(合成名基名(返回名), "可选");
    字符串 操作实参段 = 合成名首实参(操作数名);
    字符串 返回实参段 = 合成名首实参(返回名);
    // 读偏移（操作数侧联合载荷）：max(结果值偏移(T), 结果值偏移(E))——装箱
    //   构造写侧同款公式；可选单实参无联合取宽歧义（值即唯一载荷）
    整64 读偏移 = 结果值偏移(段首(操作实参段));
    如果 (!操作可选) {
        整64 读错偏 = 结果值偏移(段首(段余(操作实参段)));
        如果 (读错偏 > 读偏移) { 读偏移 = 读错偏; }
    }
    // 写偏移（返回侧 retbuf 联合载荷）：同款 max 公式
    整64 写偏移 = 结果值偏移(段首(返回实参段));
    如果 (!返回可选) {
        整64 写错偏 = 结果值偏移(段首(段余(返回实参段)));
        如果 (写错偏 > 写偏移) { 写偏移 = 写错偏; }
    }
    // 操作数段求值 [子起点, 子终点)（子终点=本节点自身索引·三元同款惯例）：
    //   末节点=标识符/成员/解引用（变量形态·栈顶是 Load 值非地址）走
    //   生成左值地址（生成返回结构体值分支 两形态分流同款）；调用/装箱
    //   构造=栈顶即地址（retbuf/临时槽基址）
    整64 操作数地址 = 0;
    如果 (n.子终点 > n.子起点) {
        节点 末节点p = 池.元素(整32(n.子终点 - 1));
        如果 (末节点p.类型 == 节点_标识符 || 末节点p.类型 == 节点_成员 ||
             末节点p.类型 == 节点_解引用) {
            操作数地址 = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                    指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
        } 否则 {
            操作数地址 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                  指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
        }
    } 否则 {
        IR层诊断("错误传播 ? 缺操作数");
    }
    当 (表达式栈.大小() > 传前深度) {
        结果<空类型, 整32> 删传 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删传.正常) { 运行时错误(4); }
    }
    // 标志读：@0 T_整32（装箱构造写侧同宽）
    整64 标志地址 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 操作数地址, 0, 0, 标志地址, T_整64, 0));
    整64 标志寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 标志地址, 0, 0, 标志寄存器, T_整32, 0));
    // 载荷地址（读侧联合偏移）
    整64 载荷地址 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 操作数地址, 0, 0, 载荷地址, T_整64, 读偏移));
    // 分块：真(正常)→ok 块；假(失败)→err 块（endBranch(flag, ok, err) 同序）
    整64 ok块 = 块计数[0] + 1;
    整64 err块 = 块计数[0] + 2;
    块计数[0] = 块计数[0] + 2;
    IR追加(指令, 建IR指令(IR_条件跳转, 标志寄存器, ok块, err块, 0, 0, 0));
    // ---- err 块：构造 错误结果 入 retbuf 并直接返回 ----
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, err块));
    整64 ret指针e = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 1, 0, 0, ret指针e, T_整64, 0));
    整64 零e = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("0")), 0, 0, 零e, T_整64, 0));
    // 标志@0 = 0（错误）
    IR追加(指令, 建IR指令(IR_指针存储, ret指针e, 零e, 0, 0, T_整32, 0));
    // 错误值：读操作数 E 宽 → 写返回 E' 宽（宽错误码传播 IR_类型转换 桥接）；
    //   可选无错误字段=只写标志（无值语义）
    如果 (!返回可选) {
        整64 读码e = 类型码(驻留(段首(段余(操作实参段))));
        整64 写码e = 类型码(驻留(段首(段余(返回实参段))));
        整64 err值 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_指针加载, 载荷地址, 0, 0, err值, 读码e, 0));
        如果 (读码e != 写码e) {
            整64 cast值e = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_类型转换, err值, 0, 0, cast值e, 写码e, 0));
            err值 = cast值e;
        }
        整64 err槽地址 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_字段地址, ret指针e, 0, 0, err槽地址, T_整64, 写偏移));
        IR追加(指令, 建IR指令(IR_指针存储, err槽地址, err值, 0, 0, 写码e, 0));
    }
    // rax=retbuf 返回 + 跳尾块（生成返回语句 结构体值分支同款块终结）
    IR追加(指令, 建IR指令(IR_返回, ret指针e, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_跳转, 0, 0, 0, 0, 0, 取当前函数尾块ID()));
    // ---- ok 块：取 .值 继续（值类型=操作数 T·宿主 valSrc 直读同构）----
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, ok块));
    整64 值码o = 类型码(驻留(段首(操作实参段)));
    整64 值寄存器o = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 载荷地址, 0, 0, 值寄存器o, 值码o, 0));
    如果 (值码o != T_整64) {
        登记寄存器类型(值寄存器o, 值码o);
    }
    结果<空类型, 整32> 加传值 = 表达式栈.追加(值寄存器o);
    如果 (!加传值.正常) { 运行时错误(4); }
}
