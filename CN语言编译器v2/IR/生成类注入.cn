// 生成类注入（643 拆分·自 生成类尾.cn 纯机械搬移·函数体逐字保留·零逻辑变化）
// 职责：容器元素钩子注入族——移动元素/析构元素/析构被移除 注入面 + ~容器/
//   清空/删除头部/删除尾部 元素析构链（702-a/115/221 族）+ 643 句柄模型
//   对象删除发射辅助（发射对象删除643/发射槽元素删除643——四条注入链共用）。
//   拆分缘由：643 修复落点前 生成类尾.cn 触 900 警戒线——先拆再加（纪律三）。
导入 容器::向量;
导入 映射集合;
导入 IR;         // IR_*/T_* 操作码 + 类表/布局查询/符号合成
导入 协议常量;   // 335 重构B：协议常量独立包
导入 IR生成;     // 程序IR 布局 + 类型码/权威表/控制流辅助

公开:

// ==================== 514-a（T70 B1 三层②）：容器元素钩子注入 ====================
// 背景：stdlib 容器（容器.cn）的 移动元素/析构元素/析构被移除 三个钩子方法是
函数 方法名是本元素钩子(节点 方法声明, 字符串 钩子名) -> 布尔 {
    返回 字符串比较(字符串复制(驻留文本(整64(方法声明.文本))), 钩子名);
}

// 423（任务 31·宿主 ir_oop_container.cpp arrayField 分派同构）：容器实例的
//   元素数组字段名 ID——向量/栈=数据；链表/队列=值表；集合=数据数组（76-a
//   stdlib 映射集合.cn 集合类私有字段名）；映射=键数组。0=非容器/未知
//   （消费点守卫返回）。原四处注入查死名「数据」→集合$T 钩子注入全 miss
//   （删除前移=空操作·已删值残留→包含(已删)=真·E2E 31 实锤）。
函数 容器数组字段名423(字符串 实例文本) -> 整64 {
    字符串 基名f423 = 合成名基名(实例文本);
    如果 (字符串比较(基名f423, "向量") || 字符串比较(基名f423, "栈")) {
        返回 驻留("数据");
    }
    如果 (字符串比较(基名f423, "链表") || 字符串比较(基名f423, "队列")) {
        返回 驻留("值表");
    }
    如果 (字符串比较(基名f423, "集合")) { 返回 驻留("数据数组"); }
    如果 (字符串比较(基名f423, "映射")) { 返回 驻留("键数组"); }
    返回 0;
}

// 115 同构扩（070 攻族·2026-10-05）：用户类元素析构存在判定——类析构位表
//   （IR类.cn·解析期登记·零生成时序依赖）。字符串/标量元素非用户类=假
//   （对齐宿主：字符串 析构元素 不注入=重复引用释放即悬垂·76-a）。
函数 用户类有析构位(字符串 类型文本) -> 布尔 {
    整64 名ID = 驻留(类型文本);
    如果 (!是用户类ID(名ID)) { 返回 假; }
    返回 类有析构(名ID);
}
// 942（#942）：**用户类含可释放资源字段**递归判定——容器元素=无用户析构类时
//   元素释放注入的门控（宿主 classHasReleasableFields 双侧同案）。性能红线：
//   纯标量/无资源类=假 → 零注入零运行期税（禁对全部无析构类一刀切加税）。
//   判据与 注入析构字段级联 的字段类别收集同源（字符串/容器/盒载荷(载荷=字符串)/
//   用户类字段(有析构 或 无析构递归)——清单变更须两处同步核对）；深度限 4 防环
//   （与 发射资源字段释放于地址 同限）。调用方已排除容器类元素；非用户类/未登记
//   类经类池索引 miss 归假（无字段可释放）。
函数 用户类有资源字段942(向量<节点> 池, 字符串 类型文本) -> 布尔 {
    返回 类字段含资源942(池, 驻留(类型文本), 0);
}

函数 类字段含资源942(向量<节点> 池, 整64 类名ID, 整64 深度) -> 布尔 {
    // 静默豁免业务值: 深度上限=级联递归防环终止（超过 4 层视为无更深资源——
    //   与 发射资源字段释放于地址/宿主 emitNoDtorFieldCascade 同限·设计上限）
    如果 (深度 > 4) { 返回 假; }
    整64 类池942 = 查类池索引234(类名ID);
    // 静默豁免业务值: 类池索引 miss（-1/越界）=非登记类（无字段可释放·保守返假）
    如果 (类池942 < 0 || 类池942 >= 整64(池.大小())) { 返回 假; }
    节点 类节点942 = 池.元素(整32(类池942));
    整64 位置942 = 整64(类节点942.子起点);
    当 (位置942 < 整64(类节点942.子终点) && 位置942 < 整64(池.大小())) {
        节点 成员942 = 池.元素(整32(位置942));
        如果 (成员942.类型 == 节点_类字段) {
            如果 (成员942.附加 >= 0 && 成员942.附加 < 整64(池.大小())) {
                节点 类型节点942 = 池.元素(整32(成员942.附加));
                // 381 口径：指针/引用层字段（星号在附加 1..255）非拥有者——不判
                如果 (类型节点942.附加 == 0) {
                    字符串 字段文本942 = 字符串复制(驻留文本(整64(类型节点942.文本)));
                    布尔 盒载荷942 = 是结果类型(字段文本942) || 是可选类型(字段文本942);
                    如果 (字符串比较(字段文本942, "字符串")) {
                        返回 真;
                    } 否则 如果 (是容器类(字段文本942)) {
                        返回 真;
                    } 否则 如果 (盒载荷942) {
                        // 载荷=字符串才释放（对齐 注入析构字段级联 类别 2；载荷=用户类/
                        //   结构体=既有边界外·宁漏勿错）——非字符串落到循环续扫
                        字符串 载荷942 = 段首(合成名首实参(字段文本942));
                        如果 (字符串比较(载荷942, "字符串")) {
                            返回 真;
                        }
                    } 否则 如果 (是用户类(字段文本942)) {
                        如果 (类有析构(整64(类型节点942.文本))) {
                            返回 真;
                        }
                        如果 (类字段含资源942(池, 整64(类型节点942.文本), 深度 + 1)) {
                            返回 真;
                        }
                    }
                }
            }
        }
        位置942++;
    }
    返回 假;
}
// 942（#942）：**无池版**「类含可释放资源字段」递归判定——数组元素释放面
//   （发射类数组元素释放923）门控（该调用链无 池 参数）。数据源=结构体全
//   字段表（217 登记·覆盖结构体/联合体/类·类型文本=原始星号形态）+类析构位
//   表（沿链）——与池版 用户类有资源字段942 同判据（字符串/容器/盒载荷(载荷=
//   字符串)/用户类字段(有析构 或 无析构递归)——清单变更须两处同步核对）；
//   指针层字段（类型文本末字符 42='*'）非拥有者不判；深度限 4 防环。
函数 类字段含资源942表(整64 类名ID, 整64 深度) -> 布尔 {
    // 静默豁免业务值: 深度上限=递归防环终止（超过 4 层视为无更深资源·与池版/宿主同限）
    如果 (深度 > 4) { 返回 假; }
    向量<整64> 字段们942 = 向量<整64>();
    取全字段们(类名ID, 字段们942);
    整64 i942 = 0;
    当 (i942 + 1 < 字段们942.大小()) {
        整64 类型ID942 = 字段们942.元素(i942 + 1);
        字符串 字段文本942 = 字符串复制(驻留文本(类型ID942));
        整64 长942 = 字符串长度(字段文本942);
        布尔 指针层942 = 假;
        如果 (长942 != 0) {
            如果 ((整64(字段文本942[整32(长942 - 1)]) & 255) == 42) { 指针层942 = 真; }
        }
        // 静默豁免业务值: 指针层字段=非拥有者（类型文本带星=句柄槽·不判释放面）
        如果 (!指针层942) {
            布尔 盒载荷942a = 是结果类型(字段文本942) || 是可选类型(字段文本942);
            如果 (字符串比较(字段文本942, "字符串")) {
                返回 真;
            } 否则 如果 (是容器类(字段文本942)) {
                返回 真;
            } 否则 如果 (盒载荷942a) {
                // 载荷=字符串才释放（对齐池版/注入析构字段级联 类别 2）
                字符串 载荷942a = 段首(合成名首实参(字段文本942));
                如果 (字符串比较(载荷942a, "字符串")) {
                    返回 真;
                }
            } 否则 如果 (是用户类(字段文本942)) {
                如果 (类有析构(类型ID942)) {
                    返回 真;
                }
                如果 (类字段含资源942表(类型ID942, 深度 + 1)) {
                    返回 真;
                }
            }
        }
        i942 = i942 + 2;
    }
    返回 假;
}



不安全 函数 注入元素移动体(向量<节点> 池, 整32 类节点索引, 函数IR& 函数信息,
                   整64* 寄存器计数, 整64* 槽计数) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    // 元素类型文本：实例名（`向量$T`）剥**首个 `$` 前缀**；无 `$`（普通类）→ 不注入
    字符串 类文本 = 字符串复制(驻留文本(整64(池.元素(类节点索引).文本)));
    整64 类长 = 字符串长度(类文本);
    整64 刀位 = -1;
    整64 ci = 0;
    当 (ci < 类长) {
        如果 ((整64(类文本[ci]) & 255) == 36) { 刀位 = ci; 中断; }
        ci++;
    }
    如果 (刀位 < 0) { 返回; }
    字符串 元素文本 = 字符串子串(类文本, 整32(刀位 + 1), 类长 - 刀位 - 1);
    // 703-a：引用形参实例名 & 后缀剥除（同 注入元素析构链 守卫——残留 & 误配
    //   元素布局/符号）
    整64 元长m = 字符串长度(元素文本);
    当 (元长m > 1 && ((整64(元素文本[整32(元长m - 1)]) & 255) == 38)) {
        元素文本 = 字符串子串(元素文本, 0, 整32(元长m - 1));
        元长m--;
    }
    // 元素槽宽（948 口径根治）：**类型名宽度**——用户类=8（堆对象句柄槽·221 修⑮
    //   宿主 058-ⅡA 句柄口径）/容器类=容器对象大小/结构体=内联大小/标量=标量宽
    //   （与下标读写路径 生成下标左值标识符分支 步进=类型名宽度 同源单一事实源）。
    //   原 类型大小与对齐=**类布局大小**（双字段类=16）与 8 字节句柄槽错位：类宽
    //   ≠8 的元素 步进翻倍→错槽（948 探针：双字段类 宿主 E1E3E2 vs v2 E1E3E1
    //   身份分叉+净差 1）。单字段类 8=8 巧合掩盖（116/117 族全绿非证）。
    整64 元素大小 = 类型名宽度(驻留(元素文本));
    如果 (元素大小 <= 0) {
        // 648：miss 不可静默——登记显形，收尾统一中止；原兜底保留（中止前
        //   路径）。类型名宽度 miss=容器元素类型文本未登记（真 miss 面·布局
        //   错 8 字节=元素移动踩邻槽族病源）。行号=0（发射期无源码行上下文）。
        登记内部未登记("容器元素槽宽", 元素文本, 0);
        元素大小 = 8;
    }
    // 数据 字段偏移（实例布局键；423 起数组字段名经 容器数组字段名423 按基名
    //   分派：向量/栈=数据·链表/队列=值表·集合=数据数组·映射=键数组——未知
    //   基名 0=不注入让位后续层）
    整64 类ID = 结构体布局键基(整64(池.元素(类节点索引).文本));
    如果 (类ID == 0) { 类ID = 整64(池.元素(类节点索引).文本); }
    // 423（任务 31）：数组字段名按容器基名分派（集合=数据数组·原死名「数据」对集合 miss=零注入）
    整64 数据名ID423 = 容器数组字段名423(类文本);
    如果 (数据名ID423 == 0) { 返回; }
    整64 数据偏移 = 查字段偏移(类ID, 数据名ID423);
    如果 (数据偏移 < 0) { 返回; }
    // 形参槽（移动元素(整64 目标, 整64 源)）
    整64 目标槽 = 0;
    整64 源槽 = 0;
    结果<整64, 整32> 找目标 = 函数信息.参数槽.获取(驻留("目标"));
    // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
    如果 (找目标.正常) { 目标槽 = 找目标.值; } 否则 { }
    结果<整64, 整32> 找源 = 函数信息.参数槽.获取(驻留("源"));
    // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
    如果 (找源.正常) { 源槽 = 找源.值; } 否则 { }
    如果 (目标槽 == 0 || 源槽 == 0) { 返回; }
    // this → 数据字段地址 → 数据值（元素数组基指针）
    整64 基址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 当前方法this槽, 0, 0, 基址r, T_对象, 0));
    整64 数据地址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 基址r, 0, 0, 数据地址r, T_整64, 数据偏移));
    整64 数据值r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 数据地址r, 0, 0, 数据值r, T_整64, 0));
    // 目标/源 下标值
    整64 目标值r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 目标值r, T_整64, 0));
    整64 源值r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 源槽, 0, 0, 源值r, T_整64, 0));
    // 步长常量槽
    整64 步长r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(元素大小)), 0, 0,
                         步长r, T_整64, 0));
    // 目标地址 = 数据值 + 目标*步长；源地址 = 数据值 + 源*步长
    整64 目标偏r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_乘, 目标值r, 步长r, 0, 目标偏r, T_整64, 0));
    整64 目标址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加, 数据值r, 目标偏r, 0, 目标址r, T_整64, 0));
    整64 源偏r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_乘, 源值r, 步长r, 0, 源偏r, T_整64, 0));
    整64 源址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加, 数据值r, 源偏r, 0, 源址r, T_整64, 0));
    // 整体搬运（结构体拷贝：源地址/目标地址/字节数=步长·对齐宿主 memcpy 语义）
    IR追加(指令, 建IR指令(IR_结构体拷贝, 源址r, 目标址r, 0, 0, 元素大小, 0));
    // 643 审查结论（不清零·对齐宿主）：清零源槽（句柄唯一持有者）在「删除
    //   恰一次」语义（stdlib 容器.cn 删除位 643 修正）下**非必需**——移位残留
    //   副本只存在于「数量之外」槽（析构/清空/全量链遍历 0..数量-1 不可达、
    //   追加写入直接覆盖），不清零反而与宿主（内联本体·无对应清零面）行为
    //   逐位一致（117 计数对位）。原拟「memcpy+源槽清零」因两侧可观察计数
    //   分叉（宿主无此面）撤除——宿主 injectMoveElemDestroy 的串字段清零面
    //   维持不动（结构体元素路径·76-a 既有）。
}

// 643（630 呈报·四注入点统一释放通道·事不过三提炼）：元素/节点=用户类/容器类
//   （v2 句柄模型·槽内=堆对象指针）的对象删除发射——`LoadPtr(槽址) + IR_删除
//   对象`（判空+~T+free，代码生成展开同变量/成员析构通道）。原四注入点（平铺
//   析构链/单析构、链式全量析构/删单）各自直发「调用实参+调用参数化(~T)」=
//   宿主「元素体内联」模型残遗：this 传槽地址错位（~T 把槽内指针当首字段句柄
//   →错位释放）+ 元素对象壳不释放（恒残留 1/元素）——630/643 三路径实证。
//   发射对象删除643：对象寄存器已知（调用方已 LoadPtr）包装 IR_删除对象；
//   发射槽元素删除643：槽址寄存器 → 先 LoadPtr 再走前者。
不安全 函数 发射对象删除643(向量<IR指令>& 指令, 整64* 寄存器计数,
                  整64 对象寄存器, 整64 元素文本ID) -> 空类型 {
    IR追加(指令, 建IR指令(IR_删除对象, 对象寄存器, 0, 0, 寄存器计数[0], 0,
                         元素文本ID));
    寄存器计数[0] = 寄存器计数[0] + 1;
}

不安全 函数 发射槽元素删除643(向量<IR指令>& 指令, 整64* 寄存器计数,
                    整64 槽址寄存器, 整64 元素文本ID) -> 空类型 {
    整64 对象r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 槽址寄存器, 0, 0, 对象r, T_对象, 0));
    发射对象删除643(指令, 寄存器计数, 对象r, 元素文本ID);
}

// 643（630 呈报·v2 元素双表示分派·注入元素析构链/单析构两处共用）：元素地址
//   → 按元素类别释放——用户类元素=堆对象指针槽（句柄模型·LoadPtr+IR_删除对象）；
//   容器类元素=内联容器对象本体（无独立壳·call ~容器(this=元素地址) 释放内部
//   数据数组）。两组表示不同不可统一归并（113_H8 崩 0xC0000374 实录）。
不安全 函数 发射元素释放分派643(向量<IR指令>& 指令, 整64* 寄存器计数,
                     整64 元素址寄存器, 字符串 元素文本) -> 空类型 {
    如果 (是容器类(元素文本)) {
        IR追加(指令, 建IR指令(IR_调用实参, 元素址寄存器, 0, 0, 0, 0, 0));
        IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                             驻留(析构符号(元素文本))));
    } 否则 {
        发射槽元素删除643(指令, 寄存器计数, 元素址寄存器, 驻留(元素文本));
    }
}

// 702-a：容器元素析构链注入（~容器 方法体前·宿主 h698_113.asm ~向量$映射 样板同构）。
//   循环：i=0; 当 (i<元素数量) { 删除对象(LoadPtr(数据+i*步长)); i++ }——数据==0 短路短路。
//   643（630 呈报）：释放通道=LoadPtr 取元素对象 + IR_删除对象（v2 句柄模型；
//   原直传元素槽地址给 ~T=宿主内联模型残遗——见释放段注释）。
不安全 函数 注入元素析构链(向量<节点> 池, 整32 类节点索引, 函数IR& 函数信息,
                   整64* 寄存器计数, 整64* 槽计数) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    字符串 类文本 = 字符串复制(驻留文本(整64(池.元素(类节点索引).文本)));
    // 423 审查修复（P0-1）：链表/队列 让位 221 专用全量析构注入（生成类.cn
    //   365~388 门控体前注入）——本函数 423 起按基名分派查「值表」命中后
    //   与 221 专用链**双重注入**同一循环 ~T（116 实测 析构 4 应 3·元素含
    //   堆资源用户类=double free 风险）。链式容器元素析构职责恒归 221 专用
    //   链（~链表/清空/删除头部/删除尾部），本链只服务平铺容器（向量/栈/
    //   集合）。
    {
        字符串 基名p1 = 合成名基名(类文本);
        如果 (字符串比较(基名p1, "链表") || 字符串比较(基名p1, "队列")) { 返回; }
    }
    整64 类长 = 字符串长度(类文本);
    整64 刀位 = -1;
    整64 ci = 0;
    当 (ci < 类长) {
        如果 ((整64(类文本[ci]) & 255) == 36) { 刀位 = ci; 中断; }
        ci++;
    }
    如果 (刀位 < 0) { 返回; }
    字符串 元素文本 = 字符串子串(类文本, 整32(刀位 + 1), 类长 - 刀位 - 1);
    // 703-a：引用形参实例名带 & 后缀（向量$映射$整64$符号& ← `向量<映射<...>>&`
    //   形参·79_v2 LNK2019 实锤=元素文本残留 & 拼出 映射$整64$符号&$~映射 幻影
    //   符号）——剥尾引用后缀（466-a 窄域剥层同款·循环剥多层）
    整64 元长w = 字符串长度(元素文本);
    当 (元长w > 1 && ((整64(元素文本[整32(元长w - 1)]) & 255) == 38)) {
        元素文本 = 字符串子串(元素文本, 0, 整32(元长w - 1));
        元长w--;
    }
    // 948 口径根治：步进=**类型名宽度**（用户类=8 句柄槽·原 类型大小与对齐=类
    //   布局大小与下标写路径错位·类宽≠8 错槽——见 注入元素移动体 948 注）
    整64 元素大小 = 类型名宽度(驻留(元素文本));
    如果 (元素大小 <= 0) { 返回; }
    整64 类ID = 结构体布局键基(整64(池.元素(类节点索引).文本));
    如果 (类ID == 0) { 类ID = 整64(池.元素(类节点索引).文本); }
    // 423（任务 31）：数组字段名按容器基名分派（同 注入元素移动体）
    整64 数据名IDd423 = 容器数组字段名423(类文本);
    如果 (数据名IDd423 == 0) { 返回; }
    整64 数据偏移 = 查字段偏移(类ID, 数据名IDd423);
    如果 (数据偏移 < 0) { 返回; }
    整64 数量偏移 = 查字段偏移(类ID, 驻留("元素数量"));
    如果 (数量偏移 < 0) { 返回; }
    // 元素析构存在判定：~T 方法签名（析构符号=映射$整64$符号$~映射 形态·
    //   方法名=~+剥实例基名——v2 生成方法链符号「~」前缀判定同口径）
    // 942（#942）：无用户析构但含资源字段的用户类元素同注入（宿主
    //   injectClassElemDestroy 级联通道双侧同案）——原判定只服务「有析构类/
    //   容器类」，无析构类元素内部资源（记录向量/字符串）在 ~容器/清空/
    //   析构元素路径全漏（E 探针双侧同漏 2/2 实证）。释放经
    //   发射元素释放分派643→LoadPtr+IR_删除对象→合成沿链析构体（658②
    //   恒合成）=字段级联同级联；纯标量/无资源类仍不注入（零运行期税）。
    如果 (!是容器类(元素文本) && !用户类有析构位(元素文本) &&
         !用户类有资源字段942(池, 元素文本)) { 返回; }
    // this → 数据值（元素数组基指针）与 元素数量值
    整64 基址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 当前方法this槽, 0, 0, 基址r, T_对象, 0));
    整64 数据地址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 基址r, 0, 0, 数据地址r, T_整64, 数据偏移));
    整64 数据值r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 数据地址r, 0, 0, 数据值r, T_整64, 0));
    整64 数量地址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 基址r, 0, 0, 数量地址r, T_整64, 数量偏移));
    整64 数量值r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 数量地址r, 0, 0, 数量值r, T_整64, 0));
    // 隐藏索引 i 槽（宿主 ?ewi99 同款）置 0
    整64 i槽 = 槽计数[0];
    槽计数[0] = 槽计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, i槽));
    整64 零r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零r, T_整64, 0));
    IR追加(指令, 建IR指令(IR_存储, 零r, 0, 0, 0, 0, i槽));
    // 步长常量
    整64 步长r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(元素大小)), 0, 0,
                         步长r, T_整64, 0));
    // 块链：头块(条件)/体块(析构+递增+回跳)/尾块(方法体续)
    整64 头块 = 新块(函数信息);
    整64 体块 = 新块(函数信息);
    整64 尾块 = 新块(函数信息);
    发射跳转(函数信息, 头块);
    切换块(函数信息, 头块);
    发射块标签(函数信息, 头块);
    整64 ir值r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, i槽, 0, 0, ir值r, T_整64, 0));
    整64 条件r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_小于, ir值r, 数量值r, 0, 条件r, T_整64, 0));
    发射条件跳转(函数信息, 条件r, 体块, 尾块);
    切换块(函数信息, 体块);
    发射块标签(函数信息, 体块);
    // 元素地址 = 数据值 + i*步长 → 元素类别二分释放（643·v2 元素双表示）：
    //   用户类元素=堆对象指针槽（追加位 NewObject+拷贝构造·630 副本句柄语义）
    //     → LoadPtr 取对象 + IR_删除对象（判空+~T+free·与变量/成员析构同通道）；
    //   容器类元素=**内联容器对象本体**（追加位就地拷贝构造·无独立壳·步长=容器
    //     对象大小）→ call ~容器(this=元素地址)（原语义·释放内部数据数组）。
    //   643 前史（630 呈报）：用户类元素被误走「call ~T(this=槽地址)」内联通道
    //   ——槽内指针当首字段柄错位释放+壳不释放（残留 1/元素）；容器类元素被
    //   「统一 LoadPtr+删除对象」误修则把本体首字段（数据数组指针）当对象 free
    //   ——113_H8 崩 0xC0000374 实录（两组表示不同·不可统一归并）。
    整64 ir值r2 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, i槽, 0, 0, ir值r2, T_整64, 0));
    整64 偏r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_乘, ir值r2, 步长r, 0, 偏r, T_整64, 0));
    整64 址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加, 数据值r, 偏r, 0, 址r, T_整64, 0));
    发射元素释放分派643(指令, 寄存器计数, 址r, 元素文本);
    // i++
    整64 一r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("1"), 0, 0, 一r, T_整64, 0));
    整64 新ir = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加, ir值r2, 一r, 0, 新ir, T_整64, 0));
    IR追加(指令, 建IR指令(IR_存储, 新ir, 0, 0, 0, 0, i槽));
    发射跳转(函数信息, 头块);
    切换块(函数信息, 尾块);
    发射块标签(函数信息, 尾块);
}

// 115 同构扩（070 攻族·2026-10-05）：「析构元素(整64 索引)」单元素析构注入——
//   stdlib 删除/插入 移位循环单点释放钩子（空体+编译器注入契约·宿主
不安全 函数 注入元素单析构(向量<节点> 池, 整32 类节点索引, 函数IR& 函数信息,
                   整64* 寄存器计数, 整64* 槽计数) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    字符串 类文本d = 字符串复制(驻留文本(整64(池.元素(类节点索引).文本)));
    整64 类长d = 字符串长度(类文本d);
    整64 刀位d = -1;
    整64 ci = 0;
    当 (ci < 类长d) {
        如果 ((整64(类文本d[ci]) & 255) == 36) { 刀位d = ci; 中断; }
        ci++;
    }
    如果 (刀位d < 0) { 返回; }
    字符串 元素文本d = 字符串子串(类文本d, 整32(刀位d + 1), 类长d - 刀位d - 1);
    整64 元长d = 字符串长度(元素文本d);
    当 (元长d > 1 && ((整64(元素文本d[整32(元长d - 1)]) & 255) == 38)) {
        元素文本d = 字符串子串(元素文本d, 0, 整32(元长d - 1));
        元长d--;
    }
    // 942（#942）：同 注入元素析构链 判定放宽——无用户析构但含资源字段的
    //   用户类元素（析构元素(索引) 单槽路径）同注入；纯标量/无资源类不注入。
    如果 (!是容器类(元素文本d) && !用户类有析构位(元素文本d) &&
         !用户类有资源字段942(池, 元素文本d)) { 返回; }
    // 948 口径根治：步进=**类型名宽度**（用户类=8 句柄槽·见 注入元素移动体 948 注）
    整64 元素大小d = 类型名宽度(驻留(元素文本d));
    如果 (元素大小d <= 0) { 返回; }
    整64 类IDd = 结构体布局键基(整64(池.元素(类节点索引).文本));
    如果 (类IDd == 0) { 类IDd = 整64(池.元素(类节点索引).文本); }
    // 423（任务 31）：数组字段名按容器基名分派（同 注入元素移动体）
    整64 数据名IDs423 = 容器数组字段名423(类文本d);
    如果 (数据名IDs423 == 0) { 返回; }
    整64 数据偏移d = 查字段偏移(类IDd, 数据名IDs423);
    如果 (数据偏移d < 0) { 返回; }
    整64 数量偏移d = 查字段偏移(类IDd, 驻留("元素数量"));
    如果 (数量偏移d < 0) { 返回; }
    整64 索引槽d = 0;
    结果<整64, 整32> 找索引d = 函数信息.参数槽.获取(驻留("索引"));
    // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
    如果 (找索引d.正常) { 索引槽d = 找索引d.值; } 否则 { }
    如果 (索引槽d == 0) { 返回; }
    // this → 数据值（元素数组基指针）与 元素数量值
    整64 基址d = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 当前方法this槽, 0, 0, 基址d, T_对象, 0));
    整64 数据地址d = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 基址d, 0, 0, 数据地址d, T_整64, 数据偏移d));
    整64 数据值d = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 数据地址d, 0, 0, 数据值d, T_整64, 0));
    整64 数量地址d = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 基址d, 0, 0, 数量地址d, T_整64, 数量偏移d));
    整64 数量值d = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 数量地址d, 0, 0, 数量值d, T_整64, 0));
    整64 索引值d = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 索引槽d, 0, 0, 索引值d, T_整64, 0));
    // 步长常量
    整64 步长d = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(元素大小d)), 0, 0,
                         步长d, T_整64, 0));
    // 守卫块链：析构条件 = 0<=索引<元素数量（两次条件跳转组合·无逻辑或码）——
    //   守卫块(索引<0?→跳过)/判定块(索引>=数量?→跳过)/释放块(call ~T)/跳过块(方法体续)
    整64 守卫块d = 新块(函数信息);
    整64 判定块d = 新块(函数信息);
    整64 释放块d = 新块(函数信息);
    整64 跳过块d = 新块(函数信息);
    整64 零r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零r, T_整64, 0));
    发射跳转(函数信息, 守卫块d);
    切换块(函数信息, 守卫块d);
    发射块标签(函数信息, 守卫块d);
    整64 负判定r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_小于, 索引值d, 零r, 0, 负判定r, T_整64, 0));
    发射条件跳转(函数信息, 负判定r, 跳过块d, 判定块d);
    切换块(函数信息, 判定块d);
    发射块标签(函数信息, 判定块d);
    整64 越判定r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_大于等于, 索引值d, 数量值d, 0, 越判定r, T_整64, 0));
    发射条件跳转(函数信息, 越判定r, 跳过块d, 释放块d);
    切换块(函数信息, 释放块d);
    发射块标签(函数信息, 释放块d);
    // 元素地址 = 数据值 + 索引*步长；643 元素类别二分（同 注入元素析构链）：
    //   用户类元素=LoadPtr+IR_删除对象（句柄通道）；容器类元素=内联本体
    //   → call ~容器(this=元素地址)（原语义）。
    整64 偏移r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_乘, 索引值d, 步长d, 0, 偏移r, T_整64, 0));
    整64 元素址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加, 数据值d, 偏移r, 0, 元素址r, T_整64, 0));
    发射元素释放分派643(指令, 寄存器计数, 元素址r, 元素文本d);
    发射跳转(函数信息, 跳过块d);
    切换块(函数信息, 跳过块d);
    发射块标签(函数信息, 跳过块d);
}

// 221（116 泄漏面）：链表 删除头部/删除尾部 的被摘元素析构注入（体首·宿主
//   ir_oop_call_release emitClassMethod 同构——索引=删除前 头/尾索引 旧值）。
不安全 函数 注入链表删单析构(字符串 元素文本n, 布尔 删尾n, 函数IR& 函数信息,
                   整64* 寄存器计数) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    // 948 口径根治：步进=**类型名宽度**（用户类=8 句柄槽·原 类型大小与对齐=类
    //   布局大小与下标写路径错位·类宽≠8 错槽——见 注入元素移动体 948 注）
    整64 大小n = 类型名宽度(驻留(元素文本n));
    如果 (大小n <= 0) { 返回; }
    整64 this寄n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 当前方法this槽, 0, 0, this寄n, T_对象, 0));
    字符串 索名n = "头索引";
    如果 (删尾n) { 索名n = "尾索引"; }
    整64 索偏n = 当前方法字段偏移(驻留(索名n));
    如果 (索偏n < 0) { 返回; }
    整64 索址n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, this寄n, 0, 0, 索址n, T_整64, 索偏n));
    整64 索值n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 索址n, 0, 0, 索值n, T_整64, 0));
    整64 表偏n = 当前方法字段偏移(驻留("值表"));
    如果 (表偏n < 0) { 返回; }
    整64 表址n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, this寄n, 0, 0, 表址n, T_整64, 表偏n));
    整64 表值n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 表址n, 0, 0, 表值n, T_整64, 0));
    整64 数偏n = 当前方法字段偏移(驻留("元素数量"));
    如果 (数偏n < 0) { 返回; }
    整64 数址n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, this寄n, 0, 0, 数址n, T_整64, 数偏n));
    整64 数值n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 数址n, 0, 0, 数值n, T_整64, 0));
    整64 步n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(大小n)), 0, 0,
                         步n, T_整64, 0));
    // [221 实验甲] 守卫块链直发化（stdlib 保证 删头/删尾 索引合法——单变量
    //   验证「守卫块链×方法体块链交互」是否 C374 刀口·验后按结果定夺）
    整64 零n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零n, T_整64, 0));
    整64 偏n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_乘, 索值n, 步n, 0, 偏n, T_整64, 0));
    整64 槽n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加, 表值n, 偏n, 0, 槽n, T_整64, 0));
    整64 句n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 槽n, 0, 0, 句n, T_对象, 0));
    // 948（643 受阻根治）：对象删除走 IR_删除对象（判空+~T+__cn_object_delete——
    //   运行时池感知合法删除通道·非裸 free）——补「删除头部/尾部 每删漏 1 元素壳」
    //   存量账。643 轮此改造 116 崩 0xC0000374 真根因**非本读通道**：值表槽值
    //   =元素对象句柄（追加位 NewObject 壳·探针实证），本处读通道正确；崩因=
    //   注入链表全量析构 平铺取槽（0..元素数量-1）读到已摘槽的**同款句柄**→
    //   清空 对同一对象二次 free（本改造首次暴露）——948 同轮链游化后本通道
    //   安全（见 注入链表全量析构 948 注）。
    发射对象删除643(指令, 寄存器计数, 句n, 驻留(元素文本n));
}

// 948：链游守卫块链发射（自 注入链表全量析构 拆出·函数体≤100 行纪律）——
//   空判块(值表==无 守卫)→负判块(索引<0)→越判块(步数>=元素数量)→体块 三分支
//   逐级下探（真=尾块）；返回入口块（调用方 发射跳转 入之）。旁出：体块/尾块/
//   索值寄存器（负判块装载·体块复用）/计数寄存器（越判块装载·推进复用）。
不安全 函数 发射链游守卫948(向量<IR指令>& 指令, 整64* 寄存器计数, 函数IR& 函数信息,
                    整64 this寄n, 整64 表偏n, 整64 数偏n, 整64 零n,
                    整64 索引槽n, 整64 计数槽n,
                    整64* 体块出, 整64* 尾块出, 整64* 索值出, 整64* 计数出) -> 整64 {
    整64 空判块n = 新块(函数信息);
    整64 负判块n = 新块(函数信息);
    整64 越判块n = 新块(函数信息);
    整64 体n = 新块(函数信息);
    整64 尾块n = 新块(函数信息);
    体块出[0] = 体n;
    尾块出[0] = 尾块n;
    切换块(函数信息, 空判块n);
    发射块标签(函数信息, 空判块n);
    整64 表址n0 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, this寄n, 0, 0, 表址n0, T_整64, 表偏n));
    整64 表值n0 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 表址n0, 0, 0, 表值n0, T_整64, 0));
    整64 空判n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_相等, 表值n0, 零n, 0, 空判n, T_整64, 0));
    发射条件跳转(函数信息, 空判n, 尾块n, 负判块n);
    切换块(函数信息, 负判块n);
    发射块标签(函数信息, 负判块n);
    整64 索值n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 索引槽n, 0, 0, 索值n, T_整64, 0));
    整64 负判n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_小于, 索值n, 零n, 0, 负判n, T_整64, 0));
    发射条件跳转(函数信息, 负判n, 尾块n, 越判块n);
    切换块(函数信息, 越判块n);
    发射块标签(函数信息, 越判块n);
    整64 数址n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, this寄n, 0, 0, 数址n, T_整64, 数偏n));
    整64 数值n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 数址n, 0, 0, 数值n, T_整64, 0));
    整64 计数n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 计数槽n, 0, 0, 计数n, T_整64, 0));
    整64 越判n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_大于等于, 计数n, 数值n, 0, 越判n, T_整64, 0));
    发射条件跳转(函数信息, 越判n, 尾块n, 体n);
    索值出[0] = 索值n;
    计数出[0] = 计数n;
    返回 空判块n;
}

// 948：链游推进发射（自 注入链表全量析构 拆出）——下一索引数组基址重载 +
//   索引槽n = 下一索引[索引]（整64 槽·固定 8 字节步进）+ 步数自增写回。
不安全 函数 发射链游推进948(向量<IR指令>& 指令, 整64* 寄存器计数,
                    整64 this寄n, 整64 下偏n, 整64 索值n, 整64 计数n,
                    整64 索引槽n, 整64 计数槽n) -> 空类型 {
    整64 下址n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, this寄n, 0, 0, 下址n, T_整64, 下偏n));
    整64 下值n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 下址n, 0, 0, 下值n, T_整64, 0));
    整64 八n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("8"), 0, 0, 八n, T_整64, 0));
    整64 下偏r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_乘, 索值n, 八n, 0, 下偏r, T_整64, 0));
    整64 下槽址n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加, 下值n, 下偏r, 0, 下槽址n, T_整64, 0));
    整64 下索引n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 下槽址n, 0, 0, 下索引n, T_整64, 0));
    IR追加(指令, 建IR指令(IR_存储, 下索引n, 0, 0, 0, 0, 索引槽n));
    整64 一n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("1"), 0, 0, 一n, T_整64, 0));
    整64 计新n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加, 计数n, 一n, 0, 计新n, T_整64, 0));
    IR追加(指令, 建IR指令(IR_存储, 计新n, 0, 0, 0, 0, 计数槽n));
}

// 221（全量循环析构·~链表/清空 体首）：对剩余有效元素逐个对象删除（有析构用户类；
//   无析构=no-op 判据守卫·调用方门控）。
// 948（643 受阻根治·宿主 ir_oop_container.cpp emitContainerElemWalk 链游分支同构）：
//   **链游**——idx=头索引 沿 下一索引 游走，步数上限=元素数量（防链损坏死循环）；
//   数组==无 守卫跳过。原实现平铺 0..元素数量-1 直接按槽号取 值表[i]：83-a 空闲链
//   槽复用后「槽号集合 ≠ 有效元素集合」——删头/删尾 摘除槽（归还空闲链）仍在
//   0..数量-1 号段被二次析构，链上存活元素反在号段外漏析构。探针实证：宿主
//   E1E3E2 vs v2 E1E3E1（同用例双编译输出分叉）+ 清空形泄漏 1；且与删单注入
//   IR_删除对象 合并=已释放句柄二次 free→116 rc=0xC0000374（643 回退真因）。
不安全 函数 注入链表全量析构(字符串 元素文本n, 整64 索引槽n, 整64 计数槽n,
                    函数IR& 函数信息, 整64* 寄存器计数) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    // 948 口径根治：步进=**类型名宽度**（用户类=8 句柄槽·见 注入元素移动体 948 注）
    整64 大小n = 类型名宽度(驻留(元素文本n));
    如果 (大小n <= 0) { 返回; }
    整64 this寄n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 当前方法this槽, 0, 0, this寄n, T_对象, 0));
    整64 表偏n = 当前方法字段偏移(驻留("值表"));
    整64 数偏n = 当前方法字段偏移(驻留("元素数量"));
    整64 头偏n = 当前方法字段偏移(驻留("头索引"));
    整64 下偏n = 当前方法字段偏移(驻留("下一索引"));
    // 948：字段偏移 miss 哨兵（-1）判等显形——调用方门控已限 链表/队列 实例
    //   （四字段恒在=穷举可证），命中=编译器内部错误（648 miss 不可静默·
    //   登记后收尾中止；== 判等=哨兵精确匹配，非业务区间判定）。
    如果 (表偏n == 0 - 1 || 数偏n == 0 - 1 || 头偏n == 0 - 1 || 下偏n == 0 - 1) {
        登记内部未登记("链式容器字段偏移", 元素文本n, 0);
        返回;
    }
    // 链游起点：索引槽n = 头索引（空容器 -1 条件下方 负判定 直接跳过）；步数
    //   计数槽n = 0（上限=元素数量·链损坏不死循环——宿主 cntUnique 同款）
    整64 头址n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, this寄n, 0, 0, 头址n, T_整64, 头偏n));
    整64 头值n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 头址n, 0, 0, 头值n, T_整64, 0));
    IR追加(指令, 建IR指令(IR_存储, 头值n, 0, 0, 0, 0, 索引槽n));
    整64 零n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零n, T_整64, 0));
    IR追加(指令, 建IR指令(IR_存储, 零n, 0, 0, 0, 0, 计数槽n));
    整64 体块n = 0;
    整64 尾块n = 0;
    整64 索值n = 0;
    整64 计数n = 0;
    整64 入口块n = 发射链游守卫948(指令, 寄存器计数, 函数信息, this寄n, 表偏n,
                                   数偏n, 零n, 索引槽n, 计数槽n, &体块n, &尾块n,
                                   &索值n, &计数n);
    发射跳转(函数信息, 入口块n);
    切换块(函数信息, 体块n);
    发射块标签(函数信息, 体块n);
    // 元素地址 = 表值 + 索引×步长（表基址每轮重载）→ 对象删除（判空+~T+池感知
    //   释放·643 槽元素删除通道）；643 注：LoadPtr 取元素对象=句柄槽模型正读。
    整64 表址n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, this寄n, 0, 0, 表址n, T_整64, 表偏n));
    整64 表值n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 表址n, 0, 0, 表值n, T_整64, 0));
    整64 步n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(大小n)), 0, 0,
                         步n, T_整64, 0));
    整64 偏n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_乘, 索值n, 步n, 0, 偏n, T_整64, 0));
    整64 槽址n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加, 表值n, 偏n, 0, 槽址n, T_整64, 0));
    发射槽元素删除643(指令, 寄存器计数, 槽址n, 驻留(元素文本n));
    发射链游推进948(指令, 寄存器计数, this寄n, 下偏n, 索值n, 计数n,
                   索引槽n, 计数槽n);
    发射跳转(函数信息, 入口块n);
    切换块(函数信息, 尾块n);
    发射块标签(函数信息, 尾块n);
}

// 923（629 派生·元素面·对齐宿主 955 emitStrArrayElemFreesFor 分派·D1 先拆再加
//   自 IR容器释放.cn 迁入）：**类/容器元素数组**逐元素释放——元素地址 = 数组
//   基址 + i×元素步进 → IR_调用 ~T(元素地址)（this=元素地址·内联体·不
//   IR_删除对象 不 free 本体；析构释放内部数据指针/容器数据数组）→
//   cn_memset(元素地址, 类大小) **整对象置零**。
//   幂等语义（与字符串元素路径同纪律）：块出口/跳出/函数尾多路径共享数组区
//   （函数尾全量看不到块出口截断=对已释放数组二次发射）——析构后端整对象置零
//   使二次 ~T=全空句柄空安全跳过（只清首字段不够——资源字段未必在偏移 0）；
//   原宿主 955 仅析构无清零+单路径名单=未暴露，923 挂函数尾兜底后双路径实锤
//   C0000374（p923f/p923scope 五探针崩），本置零为宿主/v2 双侧同款补齐。
//   调用面=发射数组串元素释放（IR容器释放.cn）非字符串元素分支单点调用。
不安全 函数 发射类数组元素释放923(函数IR& 函数信息, 映射<整64, 整64>& 局部槽,
                        整64* 寄存器计数, 整64 名ID, 字符串 类型文本923,
                        字符串 元素文本923) -> 空类型 {
    布尔 类元素923 = 是用户类(元素文本923) || 是容器类(元素文本923);
    // 942（#942）：无用户析构但含资源字段的类元素同注入（容器元素同案·数组
    //   载体面）——释放通道不变：IR_调用 ~T（无析构类=合成沿链析构体 658②
    //   恒存在=字段级联；有析构类=用户析构体）+cn_memset 置零幂等；纯标量/
    //   无资源类不注入（零运行期税）。无池判据=类字段含资源942表。
    布尔 释放面923 = 类有析构(驻留(元素文本923)) ||
                     类字段含资源942表(驻留(元素文本923), 0);
    // 静默豁免业务值: 非类元素/无可释放面=本注入无处理（数组元素资源释放义务不存在）
    如果 (!类元素923 || !释放面923) {
        返回;
    }
    整64 长度923 = 数组长度文本(类型文本923);
    结果<整64, 整32> 步进查923 = 数组元素步进(类型文本923);
    整64 步进923 = 0;
    如果 (步进查923.正常) { 步进923 = 步进查923.值; }
    如果 (长度923 <= 0 || 步进923 <= 0) { 返回; }
    整64 基址槽923 = 0;
    结果<整64, 整32> 找槽923 = 局部槽.获取(名ID);
    // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
    如果 (找槽923.正常) { 基址槽923 = 找槽923.值; } 否则 { }
    如果 (基址槽923 == 0) { 返回; }
    整64 基址寄存器923 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(函数信息.指令, 建IR指令(IR_取地址, 基址槽923, 0, 0,
                                 基址寄存器923, T_整64, 0));
    整64 大小常量923 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(函数信息.指令, 建IR指令(IR_常量整数,
          整64(驻留(整数转字符串(步进923))), 0, 0, 大小常量923,
          T_整64, 0));
    整64 元素序923 = 0;
    当 (元素序923 < 长度923) {
        整64 元素地址923 = 基址寄存器923;
        如果 (元素序923 > 0) {
            整64 偏移常量923 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_常量整数,
                  整64(驻留(整数转字符串(元素序923 * 步进923))), 0, 0,
                  偏移常量923, T_整64, 0));
            整64 元素地址新923 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_加, 基址寄存器923,
                  偏移常量923, 0, 元素地址新923, T_整64, 0));
            元素地址923 = 元素地址新923;
        }
        IR追加(函数信息.指令, 建IR指令(IR_调用实参, 元素地址923,
                                      0, 0, 0, 0, 0));
        IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
              驻留(析构符号(元素文本923))));
        IR追加(函数信息.指令, 建IR指令(IR_调用实参, 元素地址923,
                                      0, 0, 0, 0, 0));
        IR追加(函数信息.指令, 建IR指令(IR_调用实参, 大小常量923,
                                      0, 0, 0, 0, 0));
        IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
              驻留("cn_memset")));
        元素序923++;
    }
}
