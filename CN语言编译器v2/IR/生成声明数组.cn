// 生成声明数组（#1769 轮：数组初始化列表 IR 写链——自 生成声明尾.cn 897-a 顶层
//   包装收集+逐元素分派段搬出改造为多维递归展开。先拆再加纪律：该文件 875 行，
//   多维新逻辑承本文件）。
//
// #1769（2026-10-31 用户批甲案·二维嵌套初始化列表 {{...}}·与宿主
//   ir_decl_array.cpp 同构零分叉）：
//   ①嵌套大括号初始化列表——数组初始化列表的元素本身可为初始化列表（嵌套
//     深度=数组维度），IR 侧逐元素写链按元素类型递归展开（行主序·1473 甲案）。
//   ②缺格补「类型默认态」（1473 已批甲案·每层递归）：标量/字符串/指针/结果
//     （异常态 tag0）/可选（无值）/结构体（字段零位）=生成数组局部 全槽零填
//     已覆盖；**类缺格=默认构造**（发射类字段默认值 775+实例化字段级联 283+
//     零参构造调用·内联槽版——宿主 emitArrayTailDefaults 类分支同构·1473
//     甲案「类对象=既有入口默认构造通道」）。
//   ③维度不齐=编译期拒（语义层 语义检查初始化数组.cn 裁定·IR 层对不合法形态
//     到达=内部缺陷显形禁静默）。
//   立法条文=plans/001 §3.5（随本任务分支落盘〔通告〕）。

导入 容器::向量;
导入 语法;       // Token/AST 节点池
导入 IR;         // IR_*/T_* 操作码 + 判定族
导入 协议常量;
导入 IR生成;     // 生成表达式/权威表访问

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 897-a（070-001 波4·自 生成声明尾.cn 机械搬移提炼·零行为变更）：**顶层包装
//   倒序收集**——元素=构造字面量/嵌套列表时初始化区间物理含内层构造的全部
//   内节点（含内层 节点_数组元素 包装）——线性计数把内层包装当外层元素。
//   判据（区间覆盖）：倒序扫，包装 w.子起点 < 已收集顶层的最小子起点 = 顶层
//   （内层包装 ⊂ 顶层元素子区间必不满足）；返回=顶层包装池索引们（自尾=最左
//   正序消费）。
函数 收集顶层包装们(向量<节点> 池, 节点 初始化节点x) -> 向量<整64> {
    向量<整64> 顶层们x = 向量<整64>();
    整64 最小起x = 整64(初始化节点x.子终点);
    整64 倒扫x = 整64(初始化节点x.子终点) - 1;
    当 (倒扫x >= 整64(初始化节点x.子起点)) {
        节点 扫包装x = 池.元素(整32(倒扫x));
        如果 (扫包装x.类型 == 节点_数组元素 &&
             整64(扫包装x.子起点) < 最小起x) {
            结果<空类型, 整32> 加顶x = 顶层们x.追加(倒扫x);
            如果 (!加顶x.正常) { 运行时错误(4); }
            最小起x = 整64(扫包装x.子起点);
        }
        倒扫x--;
    }
    返回 顶层们x;
}

// 缺格补「类型默认态」#1769（元素文本=缺格元素类型；起序=缺格首序；数量=缺格
//   个数；层基址寄存器=当前层首元素基址）：①元素=数组（行缺格）→递归内层整行
//   补默认态；②元素=用户类→逐元素默认构造（内联槽版·零堆分配）；③其余=全槽
//   零填已覆盖（零位=标量 0/空串态/空指针/结果异常态/可选无值/结构体字段零）。
不安全 函数 补缺格默认态(字符串 元素文本q, 整64 层基址寄存器q, 整64 起序q,
                          整64 数量q, 整64 元素步进q,
                          向量<IR指令>& 指令, 整64* 寄存器计数) -> 空类型 {
    如果 (数量q == 0) { 返回; }   // 无缺格（数量域=层长-已写>=0 恒非负）
    如果 (是数组类型文本(元素文本q)) {
        // 行缺格：递归内层（每行=内层全缺格·行步进=元素步进q）
        可选<字符串> 内层查q = 数组元素文本(元素文本q);
        如果 (!内层查q.有值) {
            IR层诊断("内部错误: 行缺格内层元素类型缺失: " + 字符串复制(元素文本q));
            返回;
        }
        // 内层元素步进=数组元素布局宽（961 单点·与下标寻址同口径·同上）
        整64 内层步进q = 数组元素布局宽(驻留(内层查q.值));
        如果 (内层步进q == 0) {
            // 0=布局未解析（miss 显形禁静默·布局宽域恒非负）
            IR层诊断("内部错误: 行缺格内层元素布局宽未解析: " + 字符串复制(内层查q.值));
            返回;
        }
        整64 行序q = 起序q;
        当 (行序q < 起序q + 数量q) {
            整64 行地址q = 层基址寄存器q;
            如果 (行序q != 0) {   // 偏移加法跳过（序域>=0·等值化）
                整64 行偏常量q = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_常量整数,
                                      整64(驻留(整数转字符串(行序q * 元素步进q))),
                                      0, 0, 行偏常量q, T_整64, 0));
                整64 行址新q = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_加, 层基址寄存器q, 行偏常量q, 0,
                                      行址新q, T_整64, 0));
                行地址q = 行址新q;
            }
            补缺格默认态(字符串复制(内层查q.值), 行地址q, 0,
                            数组长度文本(元素文本q), 内层步进q,
                            指令, 寄存器计数);
            行序q++;
        }
        返回;
    }
    如果 (!是用户类(元素文本q)) { 返回; }   // 零位默认态已由全槽零填覆盖
    // 类缺格=默认构造（1473 甲案·内联槽版=this=元素地址·零堆分配；与宿主
    //   emitArrayTailDefaults 类分支同构：字段默认值注入+级联+零参构造调用）
    整64 类名IDq = 驻留(元素文本q);
    整64 序q = 起序q;
    当 (序q < 起序q + 数量q) {
        整64 元素地址d = 层基址寄存器q;
        如果 (序q != 0) {   // 偏移加法跳过（序域>=0·等值化）
            整64 偏常量q = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_常量整数,
                                  整64(驻留(整数转字符串(序q * 元素步进q))),
                                  0, 0, 偏常量q, T_整64, 0));
            整64 址新q = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加, 层基址寄存器q, 偏常量q, 0,
                                  址新q, T_整64, 0));
            元素地址d = 址新q;
        }
        发射类字段默认值(类名IDq, 元素地址d, 指令, 寄存器计数);
        注入实例化字段级联(类名IDq, 元素地址d, 指令, 寄存器计数);
        如果 (类有构造器(类名IDq)) {
            可选<整64> 构造查q = 查类构造参数串(类名IDq, 0);
            如果 (构造查q.有值) {
                IR追加(指令, 建IR指令(IR_调用实参, 元素地址d, 0, 0, 0, 0, 0));
                IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                     整64(驻留(方法符号(字符串复制(元素文本q),
                                                        剥实例基名(字符串复制(元素文本q)),
                                                        "")))));
            }
        }
        序q++;
    }
    返回;
}

// 单元素写入（897-a 分派段逐字搬移·零行为变更）：元素寄存器=生成表达式产物。
//   ①无元素（整数字面量 附加=1=空可选值）→零填充元素槽；②结构体/结果可选
//   合成体→IR_结构体拷贝整块拷入；③标量→隐式窄化+按宽指针存储。
//   元素步进q=当前层元素步进；类型文本d=当前层**数组类型**（元素类型查它）。
不安全 函数 生成数组元素写入(向量<节点> 池, 整64 包装索引d,
                              字符串 层数组类型文本d, 整64 元素寄存器d,
                              整64 元素地址d, 整64 元素步进q, 整64 零寄存器d,
                              向量<IR指令>& 指令, 整64* 寄存器计数) -> 空类型 {
    节点 包装x = 池.元素(整32(包装索引d));
    可选<字符串> 元素查x = 数组元素文本(层数组类型文本d);
    如果 (!元素查x.有值) {
        IR层诊断("内部错误: 元素写入层元素类型缺失: " + 字符串复制(层数组类型文本d));
        返回;
    }
    字符串 元素y = 字符串复制(元素查x.值);
    整64 元素类型IDx = 驻留(元素y);
    布尔 合成体元素x = 是结果类型(元素y);
    // 1415：无元素（节点_整数字面量 附加=1=空可选值）→零填充元素槽
    节点 元素节点x = 池.元素(整32(包装x.子起点));
    布尔 元素是无x = 合成体元素x &&
                        元素节点x.类型 == 节点_整数字面量 &&
                        元素节点x.附加 == 1;
    如果 (元素是无x) {
        整64 子偏x = 0;
        当 (子偏x < 元素步进q) {
            整64 子址x = 元素地址d;
            如果 (子偏x != 0) {
                整64 子偏常量x = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_常量整数,
                      整64(驻留(整数转字符串(子偏x))), 0, 0,
                      子偏常量x, T_整64, 0));
                整64 子址新x = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_加, 元素地址d, 子偏常量x,
                      0, 子址新x, T_整64, 0));
                子址x = 子址新x;
            }
            IR追加(指令, 建IR指令(IR_指针存储, 子址x, 零寄存器d,
                  0, 0, T_整64, 0));
            子偏x = 子偏x + 8;
        }
    } 否则 如果 (是结构体大小非零(元素类型IDx) || 合成体元素x) {
        IR追加(指令, 建IR指令(IR_结构体拷贝, 元素寄存器d, 元素地址d, 0, 0,
                              元素步进q, 0));
    } 否则 如果 (!是结构体大小非零(元素类型IDx)) {
        // 919（超承载字面量参与表达式·数组元素求值链收口）：标量元素收 128 值
        //   →隐式窄化低半（与声明初值/赋值/返回/实参挂点同设施）
        整64 窄化寄存器d = 隐式窄化到64(元素寄存器d, 指令, 寄存器计数);
        IR追加(指令, 建IR指令(IR_指针存储, 元素地址d, 窄化寄存器d, 0, 0,
                              类型宽度码(元素y), 0));
    }
    返回;
}

// #1769：多维数组初始化列表递归展开（行主序·元素序=写序=行优先逐元素）。
//   层数组类型文本=当前层**数组类型**（顶层 整32[2][2] / 内层 整32[2]）；
//   层基址寄存器=当前层首元素基址（顶层=数组变量基址·内层=行地址）。
//   ①顶层包装根=嵌套列表 且 元素类型是数组→递归下一维；②根/元素类型维度
//   不匹配（拉平/嵌塞·语义层已拒）→内部缺陷显形禁静默；③否则单元素写入
//   （897-a 分派·生成数组元素写入）。层尾缺格→补缺格默认态。
不安全 函数 生成数组初始化写入(向量<节点> 池, 整32 初始化节点索引w,
                              字符串 层数组类型文本w, 整64 层基址寄存器w,
                              整64 零寄存器w,
                              映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                              函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                              向量<整64>& 表达式栈) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    可选<字符串> 元素查w = 数组元素文本(层数组类型文本w);
    如果 (!元素查w.有值) {
        IR层诊断("内部错误: 数组元素类型缺失: " + 字符串复制(层数组类型文本w));
        返回;
    }
    字符串 元素文本w = 字符串复制(元素查w.值);
    整64 层长w = 数组长度文本(层数组类型文本w);
    // 当前层元素步进=**数组元素布局宽**（961 单点·与下标寻址/物化步进同源
    //   ——读写步进必须同口径：类型名宽度 对类恒 8（句柄槽域）而类元素=内联
    //   本体（查结构体大小），混用=写 [1][1] 落 [0][1] 体内（961 探针同病）；
    //   行维同单点（布局宽 对行类型=类型名宽度 折叠·与读侧下标链同值）。
    //   0=未知（miss 显形禁静默——布局收口后合法形态恒非零）
    整64 元素步进w = 数组元素布局宽(驻留(元素文本w));
    如果 (元素步进w == 0) {
        // 0=布局未解析（miss 显形禁静默·布局宽域恒非负）
        IR层诊断("内部错误: 数组元素布局宽未解析: " + 字符串复制(元素文本w));
        返回;
    }
    布尔 元素是数组w = 是数组类型文本(元素文本w);
    节点 初始化节点w = 池.元素(初始化节点索引w);
    向量<整64> 顶层们w = 收集顶层包装们(池, 初始化节点w);
    整64 元素序w = 0;
    整64 顶序w = 顶层们w.大小();
    当 (顶序w > 0) {
        顶序w--;
        节点 包装w = 池.元素(整32(顶层们w.元素(顶序w)));
        如果 (元素序w >= 层长w) {
            IR层诊断("数组初始化元素数超出长度: " + 字符串复制(层数组类型文本w));
            返回;
        }
        整64 元素地址w = 层基址寄存器w;
        如果 (元素序w != 0) {   // 偏移加法跳过（序域>=0·等值化）
            整64 偏移常量w = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_常量整数,
                                  整64(驻留(整数转字符串(元素序w * 元素步进w))),
                                  0, 0, 偏移常量w, T_整64, 0));
            整64 元素地址新w = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加, 层基址寄存器w, 偏移常量w, 0,
                                  元素地址新w, T_整64, 0));
            元素地址w = 元素地址新w;
        }
        整64 根索引w = 整64(包装w.子终点) - 1;
        节点 根w = 池.元素(整32(根索引w));
        布尔 根是列表w = 根w.类型 == 节点_数组初始化;
        如果 (元素是数组w && 根是列表w) {
            // 嵌套合法：递归下一维（行地址=元素地址）
            生成数组初始化写入(池, 整32(根索引w),
                                  字符串复制(元素文本w), 元素地址w,
                                  零寄存器w, 局部槽, 参数槽, 函数信息,
                                  寄存器计数, 槽计数, 表达式栈);
        } 否则 如果 (元素是数组w || 根是列表w) {
            // 拉平禁入/嵌塞一维（语义层已拒·到达=内部缺陷显形禁静默）
            IR层诊断("内部错误: 数组初始化维度不匹配未被语义层拦截: " +
                     字符串复制(元素文本w));
            返回;
        } 否则 如果 (!元素是数组w && !根是列表w) {
            // 标量/合成体/结构体元素：求值+写入（897-a 分派）
            整64 元素前深度w = 表达式栈.大小();
            整64 元素寄存器w = 生成表达式(池, 整32(包装w.子起点),
                                           整32(包装w.子终点), 局部槽, 参数槽,
                                           指令, 寄存器计数, &函数信息.块计数,
                                           槽计数, 表达式栈);
            表达式栈弹到深度(表达式栈, 元素前深度w);
            如果 (元素寄存器w != 0) {
                生成数组元素写入(池, 顶层们w.元素(顶序w),
                                    层数组类型文本w, 元素寄存器w,
                                    元素地址w, 元素步进w, 零寄存器w,
                                    指令, 寄存器计数);
            }
        }
        元素序w++;
    }
    // 层尾缺格补默认态（#1769·类=默认构造·其余零位已由全槽零填覆盖）
    如果 (顶层们w.大小() < 层长w) {
        补缺格默认态(字符串复制(元素文本w), 层基址寄存器w,
                        顶层们w.大小(), 层长w - 顶层们w.大小(),
                        元素步进w, 指令, 寄存器计数);
    }
    返回;
}
