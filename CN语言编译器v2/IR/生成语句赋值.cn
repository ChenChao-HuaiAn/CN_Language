// CN 自举编译器 v2 · 生成语句（D1 行数整改 172-a 拆分子模块，2026-09-15）
// 职责：赋值语句生成族——自 生成语句.cn 的 生成赋值语句 机械搬移（纯重构零
//   行为变更）：主分派（标识符左值 / 成员·解引用左值）+ 标识符赋值生成
//   （生成标识符赋值）+ 成员·解引用赋值生成（生成成员解引用赋值）+ 三个
//   发射面族（尝试成员结构体整体写 / 发射拥有串赋值 / 发射成员串字段写入）。
//   寄存器/引用参数等权威表经 公开: 访问函数（IR生成 主干）；模块路径=
//   生成语句赋值（新键基）。
导入 容器::向量;
导入 语法;       // Token/AST 节点池（原 导入 语法分析，目录包名）
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码（目录包名）
导入 IR生成;     // 控制流辅助/变量类型权威表（同包幂等）
导入 生成声明;    // 语句级变量声明分派（R3 拆分，同包）
导入 IO;         // 760 续诊断插桩用

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 赋值语句：文本=左值名（标识符槽/静态槽）；文本=0 时 附加=左值表达式起点
//   （解引用/成员/下标左值，按字段宽度存储）。结构体整体赋值经
//   生成结构体整体赋值（第18枚 POD Copy 语义）先行拦截。
// D1 行数整改 172-a：主函数收缩为分派骨架——标识符左值走 生成标识符赋值，
//   成员/解引用左值走 生成成员解引用赋值（行为等价于原单函数双分支）。
不安全 函数 生成赋值语句(向量<节点> 池, 节点 n,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) {
    如果 (n.文本 != 0) {
        生成标识符赋值(池, n, 局部槽, 参数槽, 函数信息,
                       寄存器计数, 槽计数, 表达式栈);
        返回;
    }
    生成成员解引用赋值(池, n, 局部槽, 参数槽, 函数信息,
                       寄存器计数, 槽计数, 表达式栈);
}

// 标识符左值赋值生成（172-a 自 生成赋值语句 分支一 机械搬移）：
//   文本=左值名（局部槽/参数槽/静态槽/类字段/拥有串归一化/引用参数写回）。
不安全 函数 生成标识符赋值(向量<节点> 池, 节点 n,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) {
    向量<IR指令>& 指令 = 函数信息.指令;
    如果 (字符串比较(字符串复制(驻留文本(整64(n.文本))), "总数")) {
        IO::打印到错误("[dbg1022s] 标识符赋值 文本=总数 附加=" + 整数转字符串(整64(n.附加)) +
                       " 子起=" + 整数转字符串(整64(n.子起点)) + " 子终=" +
                       整数转字符串(整64(n.子终点)) + "\n");
        如果 (n.附加 > 0 && n.附加 < 池.大小()) {
            整64 扫dbg = 整64(n.附加);
            当 (扫dbg < 整64(n.子终点) && 扫dbg < 池.大小()) {
                节点 dn = 池.元素(整32(扫dbg));
                IO::打印到错误("[dbg1022s]   池[" + 整数转字符串(扫dbg) + "] 类型=" +
                               整数转字符串(整64(dn.类型)) + " 文本=" +
                               字符串复制(驻留文本(整64(dn.文本))) + "\n");
                扫dbg++;
            }
        }
    }
    // 070 波G（1026）：类名.静态字段写——赋值节点 文本=字段名·左值区间末=成员
    //  且对象=用户类名+静态字段表命中 → 右值求值+静态槽写（须在 生成左值地址
    //  前拦截——成员链偏移=静态不入对象布局「成员左值字段偏移未知」诊断源）
    如果 (n.子终点 > n.子起点) {
        节点 左末g = 池.元素(整32(n.子终点 - 1));
        如果 (左末g.类型 == 节点_成员 && 左末g.子起点 > 0) {
            节点 对象g = 池.元素(整32(左末g.子起点));
            如果 (对象g.类型 == 节点_标识符 && 是用户类_ID(整64(对象g.文本)) &&
                 查类静态字段合成名(整64(对象g.文本), 整64(左末g.文本)) != 0) {
                整64 序写g2 = 查静态序号(查类静态字段合成名(整64(对象g.文本), 整64(左末g.文本)));
                如果 (序写g2 >= 0) {
                    整64 值寄存器g2 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                              指令, 寄存器计数, &函数信息.块计数,
                                              槽计数, 表达式栈);
                    整64 静址g2 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静址g2, T_整64, 序写g2));
                    IR追加(指令, 建IR指令(IR_指针存储, 静址g2, 值寄存器g2, 0, 0, T_整64, 0));
                    当 (表达式栈.大小() > 0) {
                        结果<空类型, 整32> 删栈g2 = 表达式栈.删除(表达式栈.大小() - 1);
                        如果 (!删栈g2.正常) { 运行时错误(4); }
                    }
                    返回;
                }
            }
        }
    }
    // 标识符左值：槽 <- 右值寄存器
    整64 目标槽 = 0;
    结果<整64, 整32> 找槽 = 局部槽.获取(整64(n.文本));
    如果 (找槽.正常) { 目标槽 = 找槽.值; }
    如果 (目标槽 == 0) {
        结果<整64, 整32> 找参 = 参数槽.获取(整64(n.文本));
        如果 (找参.正常) { 目标槽 = 找参.值; }
    }
        如果 (生成结构体整体赋值(池, n, 目标槽, 局部槽, 参数槽, 函数信息,
                                 寄存器计数, 槽计数, 表达式栈)) {
            返回;
        }
        // 346-a（2026-09-18 第 346 轮·T57 根治）：容器/用户类对象整体赋值深拷贝
        //   ——须先于右值求值（本通道自行发射源左值地址，与 生成容器拷贝构造
        //   同口径；右值区间不单独求值）；命中返回真。
        如果 (生成容器对象整体赋值(池, n, 目标槽, 局部槽, 参数槽, 函数信息,
                                 寄存器计数, 槽计数, 表达式栈)) {
            返回;
        }
        // 965（002·30）：合成体（结果/可选）整体赋值——须在普通 生成表达式
        //   通道前拦截（IR_存储 8 字节只写 sret 指针进基址槽 → .正常/.错误
        //   按内联布局读槽=读指针自身字节·ASLR 漂移错值·E2E 30 实证）
        如果 (生成合成体整体赋值(池, n, 目标槽, 局部槽, 参数槽, 函数信息,
                                寄存器计数, 槽计数, 表达式栈)) {
            返回;
        }
    整64 值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
    // 810（053）：128 位目标赋值——左类型 整128/正128：右值=地址句柄（128 位
    //   表达式统一形态）→ 发射128位双半拷贝 到目标槽对（基址槽=局部/参数槽
    //   登记值·低地址低半；静态目标=IR_静态地址 得 .data 槽地址 + IR_结构体
    //   拷贝 16 字节 T96c 双半）。右值=64 位值（字面量/窄表达式）→ 拆半物化
    //   （解析128位初值文本 two's complement·与声明初值同源逻辑）。
    {
        整64 左类型ID128 = 解析标识符类型ID(整64(n.文本));
        字符串 左类型文本128 = 左类型ID128 > 0 ?
            字符串复制(驻留文本(左类型ID128)) : 字符串复制("");
        如果 (字符串比较(左类型文本128, "整128") ||
             字符串比较(左类型文本128, "正128")) {
            整64 源码128 = 查寄存器类型(值寄存器);
            如果 (目标槽 != 0) {
                如果 (源码128 == T_整128 || 源码128 == T_正128) {
                    发射128位双半拷贝(值寄存器, 目标槽, 目标槽 - 1,
                                      指令, 寄存器计数);
                } 否则 {
                    IR层诊断("128 位变量赋值右值须为 128 位表达式: " +
                             驻留文本(整64(n.文本)));
                }
            } 否则 {
                整64 找静128 = 查静态序号(整64(n.文本));
                如果 (找静128 >= 0) {
                    整64 静地址128 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静地址128,
                                         T_整64, 找静128));
                    IR追加(指令, 建IR指令(IR_结构体拷贝, 值寄存器, 静地址128, 0, 0,
                                         16, 0));
                } 否则 {
                    // 810（053）：方法体字段目标（裸字段名 数 = 初始·构造器/方法内）
                    //   ——字段地址 + IR_结构体拷贝 16 字节（T96c 双半）；原实现
                    //   静默吞掉整条语句（只求值不写·420-③ 构造器 asm 空实证）。
                    整64 字段偏移128 = 当前方法字段偏移(整64(n.文本));
                    如果 (字段偏移128 >= 0) {
                        整64 字段地址128 = 发射类字段地址(字段偏移128, 指令, 寄存器计数);
                        IR追加(指令, 建IR指令(IR_结构体拷贝, 值寄存器, 字段地址128,
                                             0, 0, 16, 0));
                    } 否则 {
                        // 兜底显式诊断（禁静默降级——宁严勿松）
                        IR层诊断("128 位赋值目标未解析（非局部/参数/静态/字段）: " +
                                 驻留文本(整64(n.文本)));
                    }
                }
            }
            当 (表达式栈.大小() > 0) {
                结果<空类型, 整32> 删栈128 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删栈128.正常) { 运行时错误(4); }
            }
            返回;
        }
    }
    // T69（480-a 深度机）：赋值右值位函数名收口——`f = 减;`（函数指针变量赋值
    //   函数名）右值=函数名（负占位）→ IR_函数地址
    值寄存器 = 值位函数名收口480(值寄存器, 指令, 寄存器计数);
    // 第七十八轮（2026-09-12）：方法体字段左值赋值（字段名裸标识符——局部/参数
    //   未命中；this 槽加载 + 字段地址 + 指针存储）。结构体类型字段整体赋值=
    //   第一版边界（显式拒绝——8 字节指针存储会静默截断 >8 字节结构体）
    如果 (目标槽 == 0 && 值寄存器 != 0) {
        整64 字段偏移z = 当前方法字段偏移(整64(n.文本));
        如果 (字段偏移z >= 0) {
            整64 字段类型z = 查字段类型ID(当前方法类名ID, 整64(n.文本));
            // 595-a（001-001 双模收敛·根因6）：容器字段排除出结构体整体赋值
            //   通道（506-a 于 尝试成员结构体整体写 的同款守卫补齐到裸名通道
            //   ·侦察根因6）。撤守卫态容器字段类型入结构体大小表 → 原翻转走
            //   发射结构体整体拷贝（句柄+padding 浅拷 24/56/64 字节·绕过旧值
            //   删除/深拷）；容器字段=句柄槽 → 指针存储（下方 ·与生产态同位
            //   同路径）。
            如果 (字段类型z != 0 && !是容器类(驻留文本(字段类型z)) &&
                 查结构体大小(字段类型z) != 0) {
                // 508-a（T70 B1 三层④）：**类字段（结构体类型）整体赋值**由
                //   fail-fast 改实现（原「暂不支持」诊断+运行时错误(6) 主动中止
                //   ——撤守卫态 stdlib 克隆体触发实证 228/441/442·gdb 栈帧
                //   =生成语句赋值$生成标识符赋值）。语义对齐 生成结构体整体赋值/
                //   尝试成员结构体整体写：目标=字段地址（发射类字段地址·this
                //   槽基址）→ 整体拷贝（深拷=真·字段旧串 preFree=真）。
                //   源地址取法（右值已由上方 生成表达式 求值——避免二次求值副作用）：
                //     · 标识符/成员链 → 生成左值地址（place 地址·无副作用重算；
                //       标识符直通求值产物=首槽值非结构体地址）
                //     · 调用/三元/结构体字面量 → 求值产物即结构体地址
                //       （调用=物化槽〔结构体返回临时们〕·三元=聚合地址透传
                //       〔86-a〕·字面量=物化临时槽〔84-a〕）
                节点 右末z = 池.元素(整32(n.子终点 - 1));
                整64 源地址z = 值寄存器;
                如果 (右末z.类型 == 节点_标识符 || 右末z.类型 == 节点_成员) {
                    源地址z = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                           指令, 寄存器计数, &函数信息.块计数,
                                           槽计数, 表达式栈);
                }
                整64 目标地址z = 发射类字段地址(字段偏移z, 指令, 寄存器计数);
                如果 (目标地址z != 0 && 源地址z != 0) {
                    发射结构体整体拷贝(函数信息, 寄存器计数, 目标地址z, 源地址z,
                                     字段类型z, 真, 真);
                }
                当 (表达式栈.大小() > 0) {
                    结果<空类型, 整32> 删栈整z = 表达式栈.删除(表达式栈.大小() - 1);
                    如果 (!删栈整z.正常) { 运行时错误(4); }
                }
                返回;
            }
            // 836-a（070-③ 层②·窄面）：容器/用户类**字段** ← **成员链右值**
            //   （`X.字段 = Y.字段`·V7 形态）深拷通道：字段地址+释放旧（空安全）
            //   +新对象+拷贝构造+写回（与 346-a/833 层① 同款）。**仅成员链**——
            //   835 全开（标识符 OR 成员链）实测 5 新红链接回归 → 收窄
            //   （标识符右值形态维持原通道·零行为变更）。**已全量实证零回归**（534/3）。
            {
                节点 右末z2 = 池.元素(整32(n.子终点 - 1));
                如果 (字段类型z != 0 && 右末z2.类型 == 节点_成员 &&
                     (是容器类(驻留文本(字段类型z)) || 是用户类(驻留文本(字段类型z)))) {
                    字符串 字段文本f = 字符串复制(驻留文本(字段类型z));
                    整64 目标地址f = 发射类字段地址(字段偏移z, 指令, 寄存器计数);
                    整64 源地址f = 生成左值地址(池, 整32(n.子起点), 整32(n.子终点),
                                                 局部槽, 参数槽, 指令, 寄存器计数,
                                                 &函数信息.块计数, 槽计数, 表达式栈);
                    整64 旧对象f = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_指针加载, 目标地址f, 0, 0, 旧对象f, T_对象, 0));
                    整64 删标f = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_删除对象, 旧对象f, 0, 0, 删标f, 0, 字段类型z));
                    整64 对象字节f = 查结构体大小(字段类型z);
                    如果 (是容器类(字段文本f)) { 对象字节f = 容器对象大小(字段文本f); }
                    整64 新对象f = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新对象f, 对象字节f, 字段类型z));
                    IR追加(指令, 建IR指令(IR_调用实参, 新对象f, 0, 0, 0, 0, 0));
                    IR追加(指令, 建IR指令(IR_调用实参, 源地址f, 0, 0, 0, 1, 0));
                    IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                                          驻留(方法符号(字段文本f, 合成名基名(字段文本f),
                                                        字段文本f + "&"))));
                    IR追加(指令, 建IR指令(IR_指针存储, 目标地址f, 新对象f, 0, 0, T_整64, 0));
                    当 (表达式栈.大小() > 0) {
                        结果<空类型, 整32> 删栈f = 表达式栈.删除(表达式栈.大小() - 1);
                        如果 (!删栈f.正常) { 运行时错误(4); }
                    }
                    返回;
                }
            }
            // 843-a（070-③ 十一轮·842 根因定案实施）：容器/用户类字段 ← **构造
            //   调用右值**（`表 = 向量<字符串>()`）——构造调用物化在**栈**（值寄存器
            //   = 栈上对象地址）·字段须持**堆句柄**（842 插桩铁证：存栈地址→析构
            //   `cn_free(栈地址)`→计数 -1）→ **堆化**：IR_分配对象(对象字节) +
            //   IR_结构体拷贝(整体字节) → 堆句柄写字段（对齐 838 深拷面/346-a）。
            {
                节点 右末c = 池.元素(整32(n.子终点 - 1));
                如果 (字段类型z != 0 && 右末c.类型 == 节点_调用 &&
                    (是容器类(驻留文本(字段类型z)) || 是用户类(驻留文本(字段类型z)))) {
                    字符串 字段文本c = 字符串复制(驻留文本(字段类型z));
                    整64 对象字节c = 查结构体大小(字段类型z);
                    如果 (是容器类(字段文本c)) { 对象字节c = 容器对象大小(字段文本c); }
                    整64 堆对象c = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 堆对象c, 对象字节c, 字段类型z));
                    IR追加(指令, 建IR指令(IR_结构体拷贝, 值寄存器, 堆对象c, 0, 0, 对象字节c, 0));
                    整64 地址c = 发射类字段地址(字段偏移z, 指令, 寄存器计数);
                    IR追加(指令, 建IR指令(IR_指针存储, 地址c, 堆对象c, 0, 0, T_整64, 0));
                    当 (表达式栈.大小() > 0) {
                        结果<空类型, 整32> 删栈c = 表达式栈.删除(表达式栈.大小() - 1);
                        如果 (!删栈c.正常) { 运行时错误(4); }
                    }
                    返回;
                }
            }
            整64 地址z = 发射类字段地址(字段偏移z, 指令, 寄存器计数);
            IR追加(指令, 建IR指令(IR_指针存储, 地址z, 值寄存器, 0, 0, T_整64, 0));
            当 (表达式栈.大小() > 0) {
                结果<空类型, 整32> 删栈z = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删栈z.正常) { 运行时错误(4); }
            }
            返回;
        }
    }
    // 静态槽赋值（2026-09-06 根治，缺陷零容忍）：目标非局部/参数时查
    //   静态序号表——命中则 IR_静态存储 写回 .data 槽。原实现此处仅认
    //   局部/参数槽，静态目标「目标槽==0」静默丢存储（探针 计数器 =
    //   计数器 + 阶段(5) 打印恒 0 实证）——防御分支静默降级家族成员，
    //   与 发射自增自减 的静态读写对（②c C）同款设施补齐
    如果 (目标槽 == 0 && 值寄存器 != 0) {
        整64 找静赋 = 查静态序号(整64(n.文本));
        如果 (找静赋 < 0 && 当前方法类名ID != 0) {
            // 070 波G：类内静态字段裸名写（合成名静态槽·+= 复合脱糖写回同）
            找静赋 = 查静态序号(查类静态字段合成名(当前方法类名ID, 整64(n.文本)));
        }
        如果 (找静赋 >= 0) {
            // 87-a（2026-09-12 第八十七轮）：静态**字符串**——drop 旧 + 来源分级
            //   归一化（借用来源 __cn_str_copy 落堆）；其余静态类型（标量值/
            //   容器类句柄）保持 8 字节直存（指针槽模型）。
            如果 (字符串比较(驻留文本(取静态类型(找静赋)), "字符串")) {
                值寄存器 = 归一化静态串赋值(池, n, 值寄存器, 找静赋, 函数信息,
                                            寄存器计数);
            }
            IR追加(指令, 建IR指令(IR_静态存储, 值寄存器, 0, 0, 0, T_整64, 找静赋));
        }
    }
    // plans/019 阶段4' 第二批（2026-09-11 方案A）：拥有型字符串赋值——宿主
    //   第一批复核同构 + Rust 赋值语义（先 drop 旧再 move 新）：目标=字符串
    //   且在拥有名单且未污染时：①右值=字面量/标识符 → free 旧 + __cn_str_copy
    //   落堆（变量恒拥有堆串）；②右值=白名单八函数调用/二元拼接（+ 产物恒
    //   堆，复合赋值 += 语法层已重析为二元）→ free 旧 + 直存；③其余形态
    //   （非白名单调用/下标/成员等借用源）→ free 旧（旧值必为拥有——拥有链
    //   维护，drop 后零泄漏，优于宿主保守面）+ 污染退出 RAII + 直存。
    //   free 旧空安全（未赋值路径槽=0——预扫入口零初始化）。
    // 172-a：发射面自本函数提取为 发射拥有串赋值（返回写回后的值寄存器）。
    值寄存器 = 发射拥有串赋值(池, n, 目标槽, 值寄存器, 函数信息, 指令, 寄存器计数);
    如果 (值寄存器 != 0 && 目标槽 != 0) {                    如果 (槽是引用(目标槽)) {
            // ②c D：引用参数赋值——Load 槽得调用方左值地址，指针写回
            整64 地址reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 地址reg, T_整64, 0));
            IR追加(指令, 建IR指令(IR_指针存储, 地址reg, 值寄存器, 0, 0, T_整64, 0));
        } 否则 {
            // 46-f 第五十轮：正32 目标存储前截断——565 轮 T33 残余根治换接
            //   窄宽值规范化（整8/整16/正8/正16/整32 回绕+符号扩展·正32 位与
            //   原路径·单一事实源在 生成声明）；非窄宽零开销直通。指针变量
            //   （查指针变量类型 命中·标量类型表按基类型登记）跳过=地址非窄值
            //   （194 正8* 实锤教训）
            整64 赋目标类型 = 查当前函数变量类型(整64(n.文本));
            如果 (查指针变量类型(整64(n.文本)) < 0) {   // <0=未登记指针（-1 哨兵）·真指针跳过
                值寄存器 = 窄宽值规范化(窄宽码自文本(驻留文本(赋目标类型)), 值寄存器,
                                        指令, 寄存器计数);
            }
            值寄存器 = 浮点宽化存储(驻留文本(赋目标类型), 值寄存器, 指令, 寄存器计数);
            // 814（053-001）：64 位目标赋值收到 128 位值→隐式窄化低半（同上）
            值寄存器 = 隐式窄化到64(值寄存器, 指令, 寄存器计数);
            IR追加(指令, 建IR指令(IR_存储, 值寄存器, 0, 0, 0, 0, 目标槽));
        }
    }
    // 清空表达式栈（右值 残留）
    当 (表达式栈.大小() > 0) {
        结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈.正常) { 运行时错误(4); }
    }
}

// 346-a（2026-09-18 第 346 轮·T57 根治）：容器/用户类对象「赋值语句」深拷贝
//   语义——对齐宿主 identifierClassCopyAssign（src/cn_compiler/ir/ir_expr_assign_ident.cpp:239）
//   与 globalStaticClassAssign（同文件 159）：宿主 IR 铁证 `乙 = 甲` 发射
//   「新建对象 + 拷贝构造（源 T& 左值地址）+ 存储新对象指针」。
//   v2 原实现落 生成标识符赋值 底部 8 字节句柄浅覆盖：赋值后两变量共享同一堆
//   对象、双方 RAII 出口各自析构 = **双释放 UAF**（探针 p8=无引用参数无结构体的
//   最小形态：宿主 rc=0 逐行正确 vs v2 rc=139 段错误；p4 向量引用参数 / p6
//   结构体容器字段同族——asm 铁证 `mov qword ptr [r10], r11` 把新对象指针覆盖进
//   调用方变量槽、被调方局部新对象随即析构 → 调用方悬垂）。
//   与宿主的唯一有意差别：目标**拥有**旧对象时先释放（Rust `a = b` drop 旧值
//   语义；宿主当前不释放=宿主侧泄漏面·按「安全零容忍」取更安全侧）。
//   形态守卫（任一不满足=返回假，落原路径零行为变更）：左值类型 ∈ {容器类, 用户类}
//   且右值末节点=标识符（局部/参数/静态）且源类型同类。
不安全 函数 生成容器对象整体赋值(向量<节点> 池, 节点 n, 整64 目标槽,
                        映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                        函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                        向量<整64>& 表达式栈) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    整64 左名ID = 整64(n.文本);
    整64 左类型ID = 解析标识符类型ID(左名ID);
    如果 (左类型ID == 0) { 返回 假; }
    字符串 左类型文本 = 字符串复制(驻留文本(左类型ID));
    布尔 左是容器 = 是容器类(左类型文本);
    布尔 左是用户类 = 是用户类(左类型文本);
    如果 (!左是容器 && !左是用户类) { 返回 假; }
    如果 (n.子起点 >= n.子终点) { 返回 假; }
    节点 右末 = 池.元素(整32(n.子终点 - 1));
    // 963（008 总攻·v2 转移扩面）：**赋值位转移**（乙 = 转移(甲)）——右值=
    //   转移(单标识符) 调用时走句柄直交（跳过深拷）：①目标拥有旧对象先删
    //   （拥有型判定+IR_删除对象 空安全）；②源槽句柄 IR_存储 直入目标槽；
    //   ③源槽清零（源出口析构跳过=所有权交接·宿主 933 同模型）。
    如果 (右末.类型 == 节点_调用 && 右末.附加 == 1 && 右末.子起点 >= 0) {
        节点 赋被调963 = 池.元素(整32(右末.子起点));
        节点 赋实参963 = 池.元素(整32(右末.子起点) + 1);
        如果 (赋被调963.类型 == 节点_标识符 &&
             赋实参963.类型 == 节点_标识符 &&
             字符串比较(驻留文本(整64(赋被调963.文本)), "转移")) {
            整64 转源名963 = 整64(赋实参963.文本);
            如果 (转源名963 != 左名ID) {
                布尔 静963 = 假;
                如果 (目标槽 == 0 && 查静态序号(左名ID) >= 0) { 静963 = 真; }
                如果 (目标槽 != 0 || 静963) {
                    // ① 目标旧对象释放（拥有型：容器名单/静态恒拥有）
                    布尔 目标拥有963 = 静963;
                    如果 (!目标拥有963) {
                        整64 名m963 = 0;
                        当 (名m963 < 函数信息.容器变量们.大小()) {
                            如果 (函数信息.容器变量们.元素(名m963) == 左名ID) {
                                目标拥有963 = 真;
                                中断;
                            }
                            名m963++;
                        }
                    }
                    如果 (目标拥有963) {
                        整64 旧obj963 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        如果 (静963) {
                            整64 静序963 = 查静态序号(左名ID);
                            IR追加(指令, 建IR指令(IR_静态加载, 0, 0, 0, 旧obj963,
                                                 T_对象, 静序963));
                        } 否则 {
                            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 旧obj963,
                                                 T_对象, 0));
                        }
                        IR追加(指令, 建IR指令(IR_删除对象, 旧obj963, 0, 0,
                                             寄存器计数[0], 0, 左类型ID));
                        寄存器计数[0] = 寄存器计数[0] + 1;
                    }
                    // ② 源句柄加载（局部/参数槽）
                    整64 转源槽963 = 0;
                    结果<整64, 整32> 查局963 = 局部槽.获取(转源名963);
                    如果 (查局963.正常) { 转源槽963 = 查局963.值; }
                    如果 (转源槽963 == 0) {
                        结果<整64, 整32> 查参963 = 参数槽.获取(转源名963);
                        如果 (查参963.正常) { 转源槽963 = 查参963.值; }
                    }
                    如果 (转源槽963 != 0) {
                        整64 句柄963 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_加载, 转源槽963, 0, 0,
                                             句柄963, T_对象, 0));
                        如果 (静963) {
                            整64 静写963 = 寄存器计数[0];
                            寄存器计数[0] = 寄存器计数[0] + 1;
                            整64 静序w963 = 查静态序号(左名ID);
                            IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静写963,
                                                 T_整64, 静序w963));
                            IR追加(指令, 建IR指令(IR_指针存储, 静写963, 句柄963,
                                                 0, 0, T_整64, 0));
                        } 否则 {
                            IR追加(指令, 建IR指令(IR_存储, 句柄963, 0, 0, 0, 0,
                                                 目标槽));
                        }
                        // ③ 源槽清零（出口析构跳过=所有权交接）
                        整64 零963 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零963,
                                             T_整64, 0));
                        IR追加(指令, 建IR指令(IR_存储, 零963, 0, 0, 0, 0,
                                             转源槽963));
                        当 (表达式栈.大小() > 0) {
                            结果<空类型, 整32> 删963 = 表达式栈.删除(表达式栈.大小() - 1);
                            如果 (!删963.正常) { 运行时错误(4); }
                        }
                        返回 真;
                    }
                }
            }
        }
    }
    如果 (右末.类型 == 节点_调用) {
        // 841-a（070-③ 九轮·**右值求值单点化**·Rust「求值一次 + 移动/克隆」对照）：
        //   472-a 窄域守卫**前移**——目标槽=0 且非静态（方法字段·不可定位）时
        //   **先返回假·不执行右值求值**。原顺序（求值物化① → 守卫返回假 → 原路径
        //   再求值物化②）右值被求值两次·**物化① 泄漏**（840 asm 铁证：`盒子$盒子`
        //   两次 `__cn_object_new`+两次向量构造）。
        布尔 静472 = 假;
        如果 (目标槽 == 0 && 查静态序号(左名ID) >= 0) { 静472 = 真; }
        // 472-a（窄域守卫·与标识符分支既有守卫对齐）：目标槽=0 且非静态=
        //   目标不可定位（类构造内裸字段名重置形态·228 实证：记录 = 向量<字符串>()
        //   的 记录=类字段·局部槽/静态均无→存槽 0=写穿→空指针）→返回 假 交回
        //   原路径（字段写通道·生产态既有绿）。
        如果 (目标槽 == 0 && !静472) { 返回 假; }
        // 472-a：T57 分支重接入（守卫通过后**单次**求值·物化唯一）
        整64 前深度472 = 表达式栈.大小();
        整64 消费472 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽, 指令,
                                寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
        如果 (消费472 == 0 || 表达式栈.大小() <= 前深度472) { 返回 假; }
        整64 新对象472 = 表达式栈.元素(表达式栈.大小() - 1);
        当 (表达式栈.大小() > 前深度472) {
            结果<空类型, 整32> 删弹472 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删弹472.正常) { 运行时错误(4); }
        }
        布尔 拥有472 = 静472;
        如果 (!拥有472) {
            整64 名j472 = 0;
            当 (名j472 < 函数信息.容器变量们.大小()) {
                如果 (函数信息.容器变量们.元素(名j472) == 左名ID) {
                    拥有472 = 真;
                    中断;
                }
                名j472++;
            }
        }
        如果 (拥有472) {
            整64 旧对象472 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            如果 (静472) {
                IR追加(指令, 建IR指令(IR_静态加载, 0, 0, 0, 旧对象472, T_对象, 查静态序号(左名ID)));
            } 否则 如果 (槽是引用(目标槽)) {
                整64 目标地472 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 目标地472, T_整64, 0));
                IR追加(指令, 建IR指令(IR_指针加载, 目标地472, 0, 0, 旧对象472, T_对象, 0));
            } 否则 {
                IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 旧对象472, T_对象, 0));
            }
            // 472-a（objdel 撞号根治）：目标=寄存器计数[0]（标签唯一序号·与
            //   IR容器释放.cn:810 既有发射点同款）——466-a 版传 0→同函数第二条
            //   删除对象标签 objdel_N_0 重复定义（79_v2 fix_p.asm 61147/61170 双定义
            //   实证·MASM/GAS 符号重定义错误=228/283/79 生产态 3 红根因）。
            IR追加(指令, 建IR指令(IR_删除对象, 旧对象472, 0, 0, 寄存器计数[0], 0, 左类型ID));
            寄存器计数[0] = 寄存器计数[0] + 1;
        }
        如果 (静472) {
            IR追加(指令, 建IR指令(IR_静态存储, 新对象472, 0, 0, 0, T_整64, 查静态序号(左名ID)));
        } 否则 如果 (槽是引用(目标槽)) {
            整64 写回472 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 写回472, T_整64, 0));
            IR追加(指令, 建IR指令(IR_指针存储, 写回472, 新对象472, 0, 0, T_整64, 0));
        } 否则 {
            IR追加(指令, 建IR指令(IR_存储, 新对象472, 0, 0, 0, 0, 目标槽));
        }
        当 (表达式栈.大小() > 0) {
            结果<空类型, 整32> 删尾472 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删尾472.正常) { 运行时错误(4); }
        }
        返回 真;
    }
    如果 (右末.类型 != 节点_标识符) { 返回 假; }
    整64 右名ID = 整64(右末.文本);
    // 自赋值 no-op（甲 = 甲）——下方「先释放旧对象」会毁掉源（值语义自赋值恒
    //   无副作用，与 生成结构体整体赋值 79-a 自赋值守卫同款）
    如果 (右名ID == 左名ID) { 返回 真; }
    整64 右类型ID = 解析标识符类型ID(右名ID);
    如果 (右类型ID == 0) { 返回 假; }
    字符串 右类型文本 = 字符串复制(驻留文本(右类型ID));
    布尔 右是容器 = 是容器类(右类型文本);
    布尔 右是用户类 = 是用户类(右类型文本);
    如果 (!右是容器 && !右是用户类) { 返回 假; }
    // 静态目标（目标槽 0 = 顶层静态变量——解析标识符类型ID 已含静态表级）
    布尔 目标是静态 = 假;
    如果 (目标槽 == 0 && 查静态序号(左名ID) >= 0) { 目标是静态 = 真; }
    如果 (目标槽 == 0 && !目标是静态) { 返回 假; }
    // ---- 源对象左值地址（T& 引用位：引用参数槽内容 / 普通槽地址 / 静态符号地址）----
    整64 源槽 = 0;
    结果<整64, 整32> 找源局 = 局部槽.获取(右名ID);
    如果 (找源局.正常) { 源槽 = 找源局.值; }
    如果 (源槽 == 0) {
        结果<整64, 整32> 找源参 = 参数槽.获取(右名ID);
        如果 (找源参.正常) { 源槽 = 找源参.值; }
    }
    整64 源指针reg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    如果 (源槽 != 0) {
        如果 (槽是引用(源槽)) {
            IR追加(指令, 建IR指令(IR_加载, 源槽, 0, 0, 源指针reg, T_对象, 0));
        } 否则 {
            IR追加(指令, 建IR指令(IR_取地址, 源槽, 0, 0, 源指针reg, T_整64, 0));
        }
    } 否则 {
        整64 找源静 = 查静态序号(右名ID);
        如果 (找源静 < 0) { 返回 假; }
        // 拷贝构造源=T& 传静态槽左值地址（lea .data 槽；宿主 globalStaticClassAssign
        //   「源为顶层类静态：槽地址 = ?gstatic_名 符号地址」同款）
        IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 源指针reg, T_对象, 找源静));
    }
    // ---- 目标旧对象释放（仅**拥有型**目标——RAII 名单判定；返回接收视图等非拥有
    //   形态的旧值属他人，不释放。静态槽长期存活恒拥有）----
    布尔 目标拥有 = 目标是静态;
    如果 (!目标拥有) {
        整64 名i = 0;
        当 (名i < 函数信息.容器变量们.大小()) {
            如果 (函数信息.容器变量们.元素(名i) == 左名ID) {
                目标拥有 = 真;
                中断;
            }
            名i++;
        }
    }
    如果 (目标拥有) {
        整64 旧对象reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        如果 (目标是静态) {
            IR追加(指令, 建IR指令(IR_静态加载, 0, 0, 0, 旧对象reg, T_对象, 查静态序号(左名ID)));
        } 否则 如果 (槽是引用(目标槽)) {
            // 引用参数：槽内容 = 调用方变量地址 → 经指针加载旧对象
            整64 目标地reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 目标地reg, T_整64, 0));
            IR追加(指令, 建IR指令(IR_指针加载, 目标地reg, 0, 0, 旧对象reg, T_对象, 0));
        } 否则 {
            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 旧对象reg, T_对象, 0));
        }
        // 空安全（代码生成展开 test/je + ~类(this) + __cn_object_delete）
        // 836-a（070-③ 层③·单独实施）：标签唯一序号——取号并推进寄存器计数
        //   （原固定 0 → 同函数多处 objdel_N_0 撞号·V5 ml64 A2005 铁证；
        //   472-a 只修了部分点·385/701 为遗漏点）。**已全量实证零回归**（534/3）。
        整64 删除标签序 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_删除对象, 旧对象reg, 0, 0, 删除标签序, 0, 左类型ID));
    }
    // ---- 新建独立对象 + 拷贝构造（源 T&）——宿主同款 ----
    整64 对象字节数 = 查结构体大小(左类型ID);
    如果 (左是容器) { 对象字节数 = 容器对象大小(左类型文本); }
    整64 拷贝objreg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 拷贝objreg, 对象字节数, 左类型ID));
    // this=位0、源=位1（拷贝构造 T& 按引用位传左值地址）
    IR追加(指令, 建IR指令(IR_调用实参, 拷贝objreg, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用实参, 源指针reg, 0, 0, 0, 1, 0));
    // 拷贝构造签名=类(类&)（参数串带 &——asm 符号 _A+类型编码，宿主实例
    //   _...映射_A_T... 实证对齐；与 生成容器拷贝构造 同一符号口径）
    IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                          驻留(方法符号(左类型文本, 合成名基名(左类型文本),
                                        左类型文本 + "&"))));
    // ---- 写回目标（引用参数：槽内地址 + 指针存储；静态：静态存储；普通：槽存储）----
    如果 (目标是静态) {
        IR追加(指令, 建IR指令(IR_静态存储, 拷贝objreg, 0, 0, 0, T_整64, 查静态序号(左名ID)));
    } 否则 如果 (槽是引用(目标槽)) {
        整64 写回地reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 写回地reg, T_整64, 0));
        IR追加(指令, 建IR指令(IR_指针存储, 写回地reg, 拷贝objreg, 0, 0, T_整64, 0));
    } 否则 {
        IR追加(指令, 建IR指令(IR_存储, 拷贝objreg, 0, 0, 0, 0, 目标槽));
    }
    // 表达式栈清空（本通道不求值右值，防御性归位——对齐 生成结构体整体赋值 尾段）
    当 (表达式栈.大小() > 0) {
        结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈.正常) { 运行时错误(4); }
    }
    返回 真;
}

// 拥有型字符串赋值发射面（172-a 自 生成标识符赋值 机械搬移；172-a 前为
//   生成赋值语句 480~544 段）——返回写回后的值寄存器（字面量/标识符右值
//   经 __cn_str_copy 落堆时换用 copy 寄存器）。
不安全 函数 发射拥有串赋值(向量<节点> 池, 节点 n, 整64 目标槽, 整64 值寄存器,
                  函数IR& 函数信息, 向量<IR指令>& 指令, 整64* 寄存器计数) -> 整64 {
    如果 (值寄存器 != 0 && 目标槽 != 0) {
        整64 赋目标类型2 = 查当前函数变量类型(整64(n.文本));
        如果 (赋目标类型2 == 驻留("字符串")) {
            布尔 在名单 = 假;
            整64 名i = 0;
            当 (名i < 函数信息.字符串变量们.大小()) {
                如果 (函数信息.字符串变量们.元素(名i) == 整64(n.文本)) {
                    在名单 = 真;
                    中断;
                }
                名i++;
            }
            结果<整64, 整32> 查污赋 = 函数信息.字符串污染们.获取(整64(n.文本));
            如果 (在名单 && !查污赋.正常) {
                节点 赋末 = 池.元素(n.子终点 - 1);
                布尔 右值拥有 = 赋末.类型 == 节点_字符串字面量 ||
                                赋末.类型 == 节点_标识符 ||
                                赋末.类型 == 节点_二元运算;
                如果 (赋末.类型 == 节点_调用) {
                    节点 被调赋 = 池.元素(整32(赋末.子起点));
                    如果 (被调赋.类型 == 节点_标识符) {
                        整64 被调名赋 = 整64(被调赋.文本);
                        右值拥有 = 被调名赋 == 驻留("字符串复制") ||
                                  被调名赋 == 驻留("字符串连接") ||
                                  被调名赋 == 驻留("字符串拼接") ||
                                  被调名赋 == 驻留("字符串子串") ||
                                  被调名赋 == 驻留("字符串大写") ||
                                  被调名赋 == 驻留("字符串小写") ||
                                  被调名赋 == 驻留("字符串修剪") ||
                                  被调名赋 == 驻留("字符串反转");
                        // A2（方案甲）：返回类型契约——被调者返回 字符串 即拥有
                        //   （72-a：键基回退版——纯名查跨模块 miss=契约失效）
                        如果 (!右值拥有 &&
                             查函数返回回退(被调名赋) == 驻留("字符串")) {
                            右值拥有 = 真;
                        }
                    }
                }
                // 字面量/标识符：先 copy 落堆再 free 旧（自赋值 s = s 安全——
                //   copy 产物独立于旧值内存后才能释放旧值）
                如果 (右值拥有 && (赋末.类型 == 节点_字符串字面量 ||
                                赋末.类型 == 节点_标识符)) {
                    整64 copy赋寄存器 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_调用实参, 值寄存器, 0, 0, 0, 0, 0));
                    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, copy赋寄存器, 0,
                                         驻留("__cn_str_copy")));
                    登记寄存器类型(copy赋寄存器, T_字符串);
                    值寄存器 = copy赋寄存器;
                }
                // free 旧值（drop——拥有链维护下旧值必为堆串；空安全；二元/调用
                //   右值求值时已消费旧值内容产新堆——free 后不再引用）
                整64 旧ptr = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 旧ptr, T_字符串, 0));
                IR追加(指令, 建IR指令(IR_调用实参, 旧ptr, 0, 0, 0, 0, 0));
                IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                     驻留("__cn_str_free")));
                如果 (!右值拥有) {
                    // 借用源——污染退出（此后不再 free/拥有化）
                    登记串污染(函数信息, 整64(n.文本));   // 75-a：唯一入口
                }
            }
        }
    }
    返回 值寄存器;
}

// 成员/解引用左值赋值生成（172-a 自 生成赋值语句 分支二 机械搬移）：
//   手动生成左值地址（不走 生成表达式，避免成员取值）。
不安全 函数 生成成员解引用赋值(向量<节点> 池, 节点 n,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) {
    向量<IR指令>& 指令 = 函数信息.指令;
    // ②b B5：成员左值按字段宽度存储（类型码入 指令.类型——旧固定 8 字节
    //   写越界清零相邻槽，126 段① OOM 根因；解引用左值保持默认 8 字节）
    节点 左末 = 池.元素(n.子起点 - 1);
    如果 (左末.类型 == 节点_成员 && 左末.子起点 > 0) {
        节点 对象dbg = 池.元素(整32(左末.子起点));
        IO::打印到错误("[dbg1022q] 成员赋值 对象类型=" + 整数转字符串(整64(对象dbg.类型)) +
                       " 对象=" + 字符串复制(驻留文本(整64(对象dbg.文本))) +
                       " 是用户类=" + 整数转字符串(整64(是用户类_ID(整64(对象dbg.文本)))) +
                       " 静态查=" + 整数转字符串(查类静态字段合成名(整64(对象dbg.文本), 整64(左末.文本))) + "\n");
    }
    // 070 波G（1026）：类名.静态字段写——左=成员·对象=用户类名（非变量遮蔽）·
    //   静态字段表命中 → 右值求值+静态槽写（IR_静态地址+指针存储·合成名「类$
    //   字段」）——原落成员左值字段偏移（静态不入对象布局=偏移未知拒绝）
    如果 (左末.类型 == 节点_成员 && 左末.子起点 > 0) {
        IO::打印到错误("[dbg1022u] 成员写分支进 左=" + 字符串复制(驻留文本(整64(左末.文本))) + "\n");
        节点 对象w = 池.元素(整32(左末.子起点));
        如果 (对象w.类型 == 节点_标识符 && 是用户类_ID(整64(对象w.文本)) &&
             查类静态字段合成名(整64(对象w.文本), 整64(左末.文本)) != 0) {
            IO::打印到错误("[dbg1022u] 静态写命中\n");
            整64 合成写g = 查类静态字段合成名(整64(对象w.文本), 整64(左末.文本));
            整64 序写g = 查静态序号(合成写g);
            如果 (序写g >= 0) {
                整64 值寄存器w = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                          指令, 寄存器计数, &函数信息.块计数,
                                          槽计数, 表达式栈);
                整64 静址w = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静址w, T_整64, 序写g));
                IR追加(指令, 建IR指令(IR_指针存储, 静址w, 值寄存器w, 0, 0, T_整64, 0));
                当 (表达式栈.大小() > 0) {
                    结果<空类型, 整32> 删栈w = 表达式栈.删除(表达式栈.大小() - 1);
                    如果 (!删栈w.正常) { 运行时错误(4); }
                }
                返回;
            }
        }
    }
    // 46-a 根治（2026-09-09 第四十八轮）：成员结构体作值写（r.左上 = a /
    //   r.右下 = r.左上，含 >8 字节结构体）——左字段类型是结构体且右值为
    //   标识符/成员链（结构体值形态）时，两侧 生成左值地址 + IR_结构体拷贝
    //   整体写（Rust place 拷贝语义，与 生成结构体整体赋值 同构）。原标量
    //   宽度通道对 8 字节结构体恰好覆盖、>8 字节静默截断（数据损坏家族）；
    //   右值经 成员载荷是结构体 根治后压地址，此通道统一地址语义。
    //   构造字面量右值（节点_构造展开，186 通道）不在此拦截。
    // 172-a：发射面自本函数提取为 尝试成员结构体整体写（真=已处理）。
    如果 (尝试成员结构体整体写(池, n, 左末, 局部槽, 参数槽, 函数信息,
                             寄存器计数, 槽计数, 表达式栈)) {
        返回;
    }
    // 346-a（2026-09-18 第 346 轮·T57 根治·成员链目标）：成员链左值=容器/用户类
    //   对象字段 → 深拷贝整体写（原落下方标量宽度通道=8 字节句柄浅覆盖）
    如果 (尝试成员对象整体写(池, n, 左末, 局部槽, 参数槽, 函数信息,
                             寄存器计数, 槽计数, 表达式栈)) {
        返回;
    }
    // 890-b（002 攻族·537 D 段根治）：下标左值=**合成体元素**（结果/可选——
    //   容器数据指针 `数据[i] = 值` 形态）→ 整体深拷写（IR_结构体拷贝·元素
    //   字节=结果大小）。原落下方标量宽度通道=IR_指针存储 8 字节句柄直存——
    //   与读取侧（元素() 按元素槽 16B 值深拷）不对称 → 元素槽仅存实参地址 →
    //   读回 tag/值全错（537 D 段 D值=128 实证）。右值形态统一「源地址起拷」：
    //   标识符/成员（结构体值读=地址语义·673 同款）与构造调用（临时基址）
    //   均由 生成表达式 产地址。**排除局部数组**（`结果<T,E>[N] 组`——94-a 数组
    //   名退化=**句柄模型**：元素槽存 8B 对象句柄、读取经 op=44 取句柄再拷——
    //   537 A 段全对实证；若误入本分支=写 16B 值/读句柄错位崩溃）：仅**指针
    //   下标**（类字段 数据/指针变量——值槽模型·步进=元素字节）触发。
    布尔 下标对象是数组890 = 假;
    如果 (左末.类型 == 节点_下标 && 左末.子起点 > 0) {
        节点 下标对象890 = 池.元素(整32(左末.子起点));
        如果 (下标对象890.类型 == 节点_标识符) {
            整64 对象型890 = 查当前函数变量类型(整64(下标对象890.文本));
            如果 (对象型890 >= 0 && 是数组类型文本_ID(对象型890)) {
                下标对象是数组890 = 真;
            }
        }
    }
    如果 (左末.类型 == 节点_下标 && 左末.子起点 > 0 && !下标对象是数组890) {
        整64 元素型ID890 = 推导下标元素类型ID(池, 整32(左末.子起点));
        如果 (元素型ID890 > 0 && 是结果类型_ID(元素型ID890)) {
            整64 目标地址890 = 生成左值地址(池, 整32(n.附加), n.子起点, 局部槽,
                                          参数槽, 指令, 寄存器计数,
                                          &函数信息.块计数, 槽计数, 表达式栈);
            整64 源值890 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                     指令, 寄存器计数, &函数信息.块计数,
                                     槽计数, 表达式栈);
            整64 字节890 = 结果大小(字符串复制(驻留文本(元素型ID890)));
            如果 (目标地址890 != 0 && 源值890 != 0 && 字节890 > 0) {
                IR追加(指令, 建IR指令(IR_结构体拷贝, 源值890, 目标地址890,
                                     0, 0, 字节890, 0));
            }
            当 (表达式栈.大小() > 0) {
                结果<空类型, 整32> 删栈890 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删栈890.正常) { 运行时错误(4); }
            }
            返回;
        }
    }
    // 348-a（D11 甲方案·下标左值形态）：数组元素 = 结构体返回调用 → 源优先序整体写
    如果 (尝试下标结构体整体写(池, n, 左末, 局部槽, 参数槽, 函数信息,
                             寄存器计数, 槽计数, 表达式栈)) {
        返回;
    }
    整64 存储宽度 = T_整64;
    如果 (左末.类型 == 节点_成员) {
        存储宽度 = 取成员宽度码(池, n.子起点 - 1);
    } 否则 如果 (左末.类型 == 节点_下标) {
        // ③ 第三波：下标左值写宽度=所指元素宽度（整32* p[0]=v 写 4 字节，
        //   8 字节写越界踩相邻元素——同 B5 成员窄宽教训）
        存储宽度 = 取下标元素宽度码(池, n.子起点 - 1);
    } 否则 如果 (左末.类型 == 节点_调用) {
        // 118（929·任务 118）：引用返回调用左值（v.元素引用(i) = x）写宽度=
        //   被引用元素类型宽度——原落默认 T_整64（8 字节）→ 整32 元素写穿
        //   踩相邻元素（569 用例 元素(1) 被清 0 实证）。经 是引用返回调用 语义
        //   放行面+解析调用返回结构体 的签名表基名（已剥尾 &）取类型码；
        //   未命中（非引用返回调用·防御）保持默认。
        整64 左结构体z = 解析调用返回结构体(池, n.子起点 - 1);
        如果 (左结构体z != 0) {
            存储宽度 = 类型码(左结构体z);
        }
    }
    整64 地址寄存器 = 生成左值地址(池, 整32(n.附加), n.子起点, 局部槽, 参数槽,
                                指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);    整64 值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                               指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);    // plans/019 阶段4' 第二批：下标目标为字符串元素（字符串* 指针元素——
    //   查指针变量类型 直判所指类型，宽度码对字符串归并 T_整64 不可用）且
    //   右值为字符串变量标识符 -> 值被外部槽持有（指针逃逸模型，宿主 38_tool
    //   姓名[]=$副本 同款）-> 右值变量污染退出 RAII（出口 free=悬垂源头）
    如果 (左末.类型 == 节点_下标 && 左末.子起点 > 0 &&
         n.子起点 < n.子终点) {
        节点 借对象 = 池.元素(整32(左末.子起点));
        如果 (借对象.类型 == 节点_标识符 &&
             查指针变量类型(整64(借对象.文本)) == 驻留("字符串")) {
            节点 右末借 = 池.元素(n.子终点 - 1);
            如果 (右末借.类型 == 节点_标识符 &&
                 查当前函数变量类型(整64(右末借.文本)) == 驻留("字符串")) {
                登记串污染(函数信息, 整64(右末借.文本));   // 75-a：唯一入口
            }
        }
    }
    // 79-a（2026-09-12 第七十九轮）：成员字符串字段写入归一化——字段独立拥有
    //   （与宿主 79-a 同款分级）：字面量=驻留直存；裸函数调用（白名单族/返回
    //   字符串契约）=接管零拷贝；其余（标识符/成员/下标/二元/方法调用借用返回）
    //   =__cn_str_copy 落堆（字段独立副本，源保持拥有照常释放）。顺序=先求值+
    //   复制、后 free 旧值（自赋值 甲.名 = 甲.名 安全：新值先独立于旧值内存）。
    //   preFree 仅对「直连标识符父对象且父在资源字段名单」（拥有槽）发射——其余
    //   形态保守不释放旧值（宁漏勿错）。
    // 172-a：发射面自本函数提取为 发射成员串字段写入（返回写回后的值寄存器）。
    值寄存器 = 发射成员串字段写入(池, n, 左末, 地址寄存器, 值寄存器, 函数信息,
                              指令, 寄存器计数);
    // 565 轮（T33 残余根治）：复合赋值脱糖的标识符左值（文本=0·附加=左值区间
    //   起点·左末=标识符节点）经本路径 8 字节 IR_指针存储——存储前按变量声明
    //   类型窄宽值规范化（b5 探针：甲+=整16(30000) 宿主 -5536/v2 曾 60000——
    //   脱糖节点不走 生成标识符赋值 的规范化点）。查当前函数变量类型 miss
    //   （静态等）或指针变量（查指针变量类型 命中）→直通=行为零变化。成员/
    //   下标左值=既有 存储宽度码 通道（B5/347-a 已按字段/元素宽度·不触）。
    如果 (左末.类型 == 节点_标识符 && 查指针变量类型(整64(左末.文本)) < 0) {
        值寄存器 = 窄宽值规范化(窄宽码自文本(字符串复制(驻留文本(
                     查当前函数变量类型(整64(左末.文本))))),
                     值寄存器, 指令, 寄存器计数);
    }
    // 768 续（001 波·761 回退撤除）：原「查 结构体返回临时们 命中→按登记尺寸
    //   整体写」回退段删除——查表键=值寄存器**号域**与登记键=物化基址**号域**
    //   复用（寄存器号 1 既是某语句物化基址又是另一语句 Load 值·768 续 gdb
    //   实证 rsi=1 rep movsb 崩），判据本质不可靠；其设计目标（复制 展开产物
    //   赋下标左值=整体写）已由 尝试下标结构体整体写 的 调用/地点 右值形态
    //   统一段完全覆盖（760-a+768 续下标链扩面）——回退段=冗余+误命中雷。
    // 822（053-002）：复合赋值脱糖的 **128 位标识符左值**——值=句柄（二元/算术
    //   产物）→ 双半拷贝到目标槽对（IR_指针存储 8 字节=句柄直存错误·q3 实证
    //   `甲 += 1` 只改低半）；静态目标=IR_静态地址+IR_结构体拷贝 16 字节。
    如果 (左末.类型 == 节点_标识符 && 值寄存器 != 0) {
        字符串 左类型文本c128 = 字符串复制(
            驻留文本(查当前函数变量类型(整64(左末.文本))));
        如果 (字符串比较(左类型文本c128, "整128") ||
             字符串比较(左类型文本c128, "正128")) {
            整64 目标槽c128 = 0;
            结果<整64, 整32> 找局128 = 局部槽.获取(整64(左末.文本));
            如果 (找局128.正常) { 目标槽c128 = 找局128.值; }
            如果 (目标槽c128 == 0) {
                结果<整64, 整32> 找参128 = 参数槽.获取(整64(左末.文本));
                如果 (找参128.正常) { 目标槽c128 = 找参128.值; }
            }
            如果 (目标槽c128 != 0) {
                发射128位双半拷贝(值寄存器, 目标槽c128, 目标槽c128 - 1,
                                  指令, 寄存器计数);
            } 否则 {
                整64 找静c128 = 查静态序号(整64(左末.文本));
                如果 (找静c128 >= 0) {
                    整64 静地址c128 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静地址c128,
                                         T_整64, 找静c128));
                    IR追加(指令, 建IR指令(IR_结构体拷贝, 值寄存器, 静地址c128,
                                         0, 0, 16, 0));
                }
            }
            当 (表达式栈.大小() > 0) {
                结果<空类型, 整32> 删栈c128 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删栈c128.正常) { 运行时错误(4); }
            }
            返回;
        }
    }
    如果 (地址寄存器 != 0 && 值寄存器 != 0) {
        如果 (存储宽度 == T_整128 || 存储宽度 == T_正128) {
            // 545（070 波D-二·1022）：128 位字段窄源写（脱糖成员赋值 h.大 = 窄
            //   表达式 形态·解析期脱糖不经过 生成结构体构造）——单指针存储按
            //   句柄 8 字节直存=高半垃圾（同 字面量字段 实录）——窄源按符号性
            //   物化双半槽对+双半写（与声明位/字面量位同族三面收口）
            整64 源码m128 = 查寄存器类型(值寄存器);
            如果 (源码m128 == T_整128 || 源码m128 == T_正128) {
                整64 低m = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_指针加载, 值寄存器, 0, 0, 低m, T_整64, 0));
                IR追加(指令, 建IR指令(IR_指针存储, 地址寄存器, 低m, 0, 0, T_整64, 0));
                整64 高源m = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_字段地址, 值寄存器, 0, 0, 高源m, T_整64, 8));
                整64 高址m = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_字段地址, 地址寄存器, 0, 0, 高址m, T_整64, 8));
                整64 高值m = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_指针加载, 高源m, 0, 0, 高值m, T_整64, 0));
                IR追加(指令, 建IR指令(IR_指针存储, 高址m, 高值m, 0, 0, T_整64, 0));
            } 否则 {
                整64 物化码m = 源码m128;
                整64 有符号m = 1;
                如果 (物化码m == T_未知) { 物化码m = T_整64; }
                如果 (物化码m == T_正32 || 物化码m == T_正64) { 有符号m = 0; }
                整64 句柄m = 物化128位操作数(值寄存器, 物化码m, 有符号m,
                                        指令, 寄存器计数, 槽计数);
                整64 低m2 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_指针加载, 句柄m, 0, 0, 低m2, T_整64, 0));
                IR追加(指令, 建IR指令(IR_指针存储, 地址寄存器, 低m2, 0, 0, T_整64, 0));
                整64 高源m2 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_字段地址, 句柄m, 0, 0, 高源m2, T_整64, 8));
                整64 高址m2 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_字段地址, 地址寄存器, 0, 0, 高址m2, T_整64, 8));
                整64 高值m2 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_指针加载, 高源m2, 0, 0, 高值m2, T_整64, 0));
                IR追加(指令, 建IR指令(IR_指针存储, 高址m2, 高值m2, 0, 0, T_整64, 0));
            }
        } 否则 {
            IR追加(指令, 建IR指令(IR_指针存储, 地址寄存器, 值寄存器, 0, 0, 存储宽度, 0));
        }
    }    // 清空表达式栈（右值 残留）
    当 (表达式栈.大小() > 0) {
        结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈.正常) { 运行时错误(4); }
    }
}

// 346-a（2026-09-18 第 346 轮·T57 根治·成员链目标）：成员链左值的容器/用户类
//   对象字段「整体赋值」深拷贝——地址语义与 尝试成员结构体整体写 同款
//   （目标地址=生成左值地址 字段左值地址；NewObject+拷贝构造→IR_指针存储 目标地址）。
//   原实现落标量宽度通道（8 字节 IR_指针存储=句柄浅覆盖）→ 字段与源共享同一堆
//   对象（探针 p6：结构体引用参数的容器字段 `程.表 = 新表` → 宿主 1/7 逐行正确
//   vs v2 大小=垃圾 + 数组越界；被调方局部与父对象双方析构=双释放 UAF）。
//   旧对象释放：父对象**拥有**（容器变量们 / 资源字段名单——与 发射资源字段析构
//   同口径）时释放字段旧对象；借用视图父对象不释放（宁漏勿错）。
不安全 函数 尝试成员对象整体写(向量<节点> 池, 节点 n, 节点 左末,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    如果 (左末.类型 != 节点_成员 || n.子起点 >= n.子终点) { 返回 假; }
    // 346-a 补（类对象字段形态·家族扩散检查 p11）：字段类型统一经 解析节点类型ID
    //   （成员分支递归解析基类型——结构体与**用户类**同布局表；原判定走
    //   解析成员链结构体ID，对类对象返回 0 → 类字段的容器赋值落标量通道=
    //   8 字节浅覆盖，探针 p11 实证：宿主 袋.装.大小=1/首=7 vs v2 大小=0+越界）
    整64 字段类型ID = 解析节点类型ID(池, 整32(n.子起点 - 1));
    如果 (字段类型ID == 0) { 返回 假; }
    字符串 字段类型文本 = 字符串复制(驻留文本(字段类型ID));
    布尔 字段是容器 = 是容器类(字段类型文本);
    布尔 字段是用户类 = 是用户类(字段类型文本);
    如果 (!字段是容器 && !字段是用户类) { 返回 假; }
    节点 右末 = 池.元素(整32(n.子终点 - 1));
    // 837-a（070-③ 五轮）：**追加**成员链右值分支（`d.内 = a.内`·V7 形态）——
    //   **保留** 346-a 原标识符路径（`X.字段 = 局部变量`·441/442 面）。836 回归
    //   教训=「替换全部判定」会删掉标识符分支致 441/442 新红。
    布尔 右是标识符 = (右末.类型 == 节点_标识符);
    布尔 右是成员链 = (右末.类型 == 节点_成员);
    如果 (!右是标识符 && !右是成员链) { 返回 假; }
    整64 右类型ID = 0;
    如果 (右是标识符) {
        右类型ID = 解析标识符类型ID(整64(右末.文本));
    } 否则 {
        右类型ID = 解析节点类型ID(池, 整32(n.子终点 - 1));
    }
    如果 (右类型ID == 0) { 返回 假; }
    字符串 右类型文本 = 字符串复制(驻留文本(右类型ID));
    布尔 右是容器 = 是容器类(右类型文本);
    布尔 右是用户类 = 是用户类(右类型文本);
    如果 (!右是容器 && !右是用户类) { 返回 假; }
    // 目标字段左值地址（成员链地址——与 尝试成员结构体整体写 同款参数）
    整64 目标地址 = 生成左值地址(池, 整32(n.附加), n.子起点, 局部槽, 参数槽,
                                指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
    // 源左值地址（引用参数槽内容 / 普通槽地址 / 静态符号地址）
    整64 源槽 = 0;
    如果 (右是标识符) {
        结果<整64, 整32> 找源局 = 局部槽.获取(整64(右末.文本));
        如果 (找源局.正常) { 源槽 = 找源局.值; }
        如果 (源槽 == 0) {
            结果<整64, 整32> 找源参 = 参数槽.获取(整64(右末.文本));
            如果 (找源参.正常) { 源槽 = 找源参.值; }
        }
    }
    整64 源地址 = 0;
    如果 (右是成员链) {
        // 837-a：源=成员链——源地址=右链左值地址（`a.内` → &a.内）
        源地址 = 生成左值地址(池, 整32(n.子起点), 整32(n.子终点), 局部槽, 参数槽,
                            指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
    } 否则 {
        源地址 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        如果 (源槽 != 0) {
            如果 (槽是引用(源槽)) {
                IR追加(指令, 建IR指令(IR_加载, 源槽, 0, 0, 源地址, T_对象, 0));
            } 否则 {
                IR追加(指令, 建IR指令(IR_取地址, 源槽, 0, 0, 源地址, T_整64, 0));
            }
        } 否则 {
            整64 找源静 = 查静态序号(整64(右末.文本));
            如果 (找源静 < 0) { 返回 假; }
            IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 源地址, T_对象, 找源静));
        }
    }
    // 父对象拥有判定（容器变量们 / 资源字段名单）
    节点 父节点 = 池.元素(左末.子起点);
    布尔 父拥有 = 假;
    如果 (父节点.类型 == 节点_标识符) {
        整64 父名ID = 整64(父节点.文本);
        如果 (在资源字段名单(函数信息, 父名ID)) { 父拥有 = 真; }
        如果 (!父拥有) {
            整64 名i = 0;
            当 (名i < 函数信息.容器变量们.大小()) {
                如果 (函数信息.容器变量们.元素(名i) == 父名ID) {
                    父拥有 = 真;
                    中断;
                }
                名i++;
            }
        }
    }
    // 837-a（自赋值安全·Rust 模式 先克隆后释放）：**新对象+拷贝构造先于释放旧**
    //   ——自赋值（`a.内 = a.内`·V12 形态·目标==源）时源在拷贝阶段仍有效，释放旧
    //   不毁源（免地址比较守卫）。
    整64 对象字节数 = 查结构体大小(字段类型ID);
    如果 (字段是容器) { 对象字节数 = 容器对象大小(字段类型文本); }
    整64 新对象reg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新对象reg, 对象字节数, 字段类型ID));
    IR追加(指令, 建IR指令(IR_调用实参, 新对象reg, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用实参, 源地址, 0, 0, 0, 1, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                          驻留(方法符号(字段类型文本, 合成名基名(字段类型文本),
                                        字段类型文本 + "&"))));
    如果 (父拥有) {
        整64 旧对象reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_指针加载, 目标地址, 0, 0, 旧对象reg, T_对象, 0));
        // 836-a（层③）：标签唯一序号（同 385·取号+推进）
        整64 删标序2 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_删除对象, 旧对象reg, 0, 0, 删标序2, 0, 字段类型ID));
    }
    IR追加(指令, 建IR指令(IR_指针存储, 目标地址, 新对象reg, 0, 0, T_整64, 0));
    当 (表达式栈.大小() > 0) {
        结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈.正常) { 运行时错误(4); }
    }
    返回 真;
}

// 成员结构体作值写发射面（172-a 自 生成成员解引用赋值 机械搬移；172-a 前为
//   生成赋值语句 577~626 段；46-a 根治族）——真=已整体写并完成（调用方收尾）。
不安全 函数 尝试成员结构体整体写(向量<节点> 池, 节点 n, 节点 左末,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    如果 (左末.类型 == 节点_成员 && n.子起点 < n.子终点) {
        // 父链类型=解析成员链结构体ID(左末.子起点)（范本=取成员宽度码：
        //   成员节点 子起点=对象节点索引——传左末自身索引得的是左末字段
        //   自身类型，再查一层字段类型必 miss——首版误写实证）
        整64 父链ID48 = 解析成员链结构体ID(池, 整32(左末.子起点));
        如果 (父链ID48 != 0) {
            整64 字段结构体ID48 = 查结构体类型(
                查字段类型ID(父链ID48, 整64(左末.文本)));
            如果 (字段结构体ID48 != 0) {
                // 506-a（T70 B1 三层·466-a 同款）：**容器/用户类字段排除**——撤守卫态
                //   容器实例布局登记（423-b 裸键直设）使 查结构体类型≠0 → 本通道误抢
                //   容器成员赋值（`b.表 = <容器调用/容器变量>`），其调用路径查 结构体
                //   返回临时们 miss → 误诊断「非结构体返回值」（127 撤守卫态实证：
                //   字段=表 ×3·修复前同态）；若无调用路径则更深拷贝语义被浅拷覆盖。
                //   生产态容器字段无结构体登记=天然 0·零回归。让位既有容器深拷/接管
                //   通道（生成容器对象整体赋值·T57/346-a）。
                字符串 字段文本48 = 字符串复制(驻留文本(查字段类型ID(父链ID48, 整64(左末.文本))));
                如果 (是容器类(字段文本48) || 是用户类(字段文本48)) { 返回 假; }
                节点 右末48 = 池.元素(n.子终点 - 1);
                // 86-a（2026-09-12 复审缺陷①）：三元右值（乙箱.内盒 = (条?甲:乙)）——
                //   源地址经 生成表达式（三元聚合分支地址化=选中 place 地址），
                //   与标识符/成员（生成左值地址）分流。原白名单不含三元 → 落标量
                //   Store 通道 8 字节写 → 字段静默损坏（P47-v2 形六 t6 实证乱码）。
                // 348-a（D11 甲方案·源优先序·双侧同构）：右值=**一般结构体返回调用**
                //   → ①先求值源（生成表达式·可能含条件块〔正常/错误构造器 返回分支〕）
                //   ②再算目标地址（生成左值地址·纯地址计算无块）③整体拷贝（源=一次性
                //   物化槽 → 浅拷接管〔深拷=假〕+ 目标 preFree）。
                //   原序（目标地址先发射）使源调用的块插在地址发射之后 → 234-a
                //   「全量 v2 树编译 285 失败」根因 → 白名单被迫收窄 → 该形态落标量
                //   宽度通道 8 字节（D11·探针 p29：`甲.内 = 造点(20)` 首字段=返回值
                //   地址、余字段 0 静默错值）。对齐 生成结构体赋值调用分支（标识符
                //   目标·已是源优先序）。
                如果 (右末48.类型 == 节点_调用) {
                    // 栈纪律（346-a/88-a 净栈契约同源）：记录进入深度，源求值后
                    //   **弹到进入深度**（生成表达式可能压多个残留）——否则残留元素
                    //   会污染随后 生成左值地址 的下标/解引用分支（v2p 自身空指针
                    //   解引用错误码 3 实证）。
                    整64 前深度48 = 表达式栈.大小();
                    整64 消费48 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                           指令, 寄存器计数, &函数信息.块计数,
                                           槽计数, 表达式栈);
                    整64 源寄存器48 = 0;
                    如果 (表达式栈.大小() > 前深度48) {
                        源寄存器48 = 表达式栈.元素(表达式栈.大小() - 1);
                    }
                    当 (表达式栈.大小() > 前深度48) {
                        结果<空类型, 整32> 删源48 = 表达式栈.删除(表达式栈.大小() - 1);
                        如果 (!删源48.正常) { 运行时错误(4); }
                    }
                    结果<整64, 整32> 查源48 = 结构体返回临时们.获取(源寄存器48);
                    如果 (消费48 == 0 || 源寄存器48 == 0 || !查源48.正常) {
                        IR层诊断("结构体成员赋值右值（调用返回）非结构体返回值: 字段=" +
                                     驻留文本(整64(左末.文本)) + " 消费=" +
                                     整数转字符串(消费48) + " 源寄存器=" +
                                     整数转字符串(源寄存器48) + " 查源=" +
                                     整数转字符串(整64(查源48.正常)) + " 目标=" +
                                     驻留文本(整64(n.文本)));
                    } 否则 {
                        整64 目标地址48c = 生成左值地址(池, 整32(n.附加), n.子起点,
                                                       局部槽, 参数槽, 指令,
                                                       寄存器计数, &函数信息.块计数,
                                                       槽计数, 表达式栈);
                        如果 (目标地址48c != 0) {
                            发射结构体整体拷贝(函数信息, 寄存器计数, 目标地址48c,
                                             源寄存器48, 字段结构体ID48, 真, 假);
                        }
                    }
                    当 (表达式栈.大小() > 前深度48) {
                        结果<空类型, 整32> 删栈48c = 表达式栈.删除(表达式栈.大小() - 1);
                        如果 (!删栈48c.正常) { 运行时错误(4); }
                    }
                    返回 真;
                }
                如果 (右末48.类型 == 节点_标识符 || 右末48.类型 == 节点_成员 ||
                    右末48.类型 == 节点_三元运算) {
                    整64 目标地址48 = 生成左值地址(池, 整32(n.附加), n.子起点,
                                                   局部槽, 参数槽, 指令,
                                                   寄存器计数, &函数信息.块计数,
                                                   槽计数, 表达式栈);
                    整64 源地址48 = 0;
                    如果 (右末48.类型 == 节点_三元运算) {
                        源地址48 = 生成表达式(池, n.子起点, n.子终点,
                                             局部槽, 参数槽, 指令,
                                             寄存器计数, &函数信息.块计数,
                                             槽计数, 表达式栈);
                    } 否则 {
                        源地址48 = 生成左值地址(池, n.子起点, n.子终点,
                                               局部槽, 参数槽, 指令,
                                               寄存器计数, &函数信息.块计数,
                                               槽计数, 表达式栈);
                    }
                    如果 (目标地址48 != 0 && 源地址48 != 0) {
                        // 79-a：串字段深拷。86-a：preFree 修正为真——目标字段旧串
                        //   是「值语义拥有」（前次整体赋值/深拷的副本），覆盖前必须
                        //   释放（原「非拥有槽不 preFree」保守口径在此泄漏：E243 形五
                        //   v2 残留=1 实证）。未初始化槽的垃圾句柄经 cn_free_tracked
                        //   仅在册释放，空安全（84-f 核验结论）——宁漏勿错不再适用。
                        发射结构体整体拷贝(函数信息, 寄存器计数, 目标地址48,
                                         源地址48, 字段结构体ID48, 真, 真);
                    }
                    当 (表达式栈.大小() > 0) {
                        结果<空类型, 整32> 删栈48 = 表达式栈.删除(表达式栈.大小() - 1);
                        如果 (!删栈48.正常) { 运行时错误(4); }
                    }
                    返回 真;
                }
            }
        }
    }
    返回 假;
}

// 348-a（D11 甲方案·下标左值形态·对齐宿主 indexStructElemAssign）：数组元素 =
//   结构体返回调用 → 源优先序整体写（①先求值源〔可能含条件块〕②再算目标地址
//   〔生成左值地址·纯地址计算〕③整体拷贝〔源=一次性物化槽 → 浅拷接管·深拷=假〕）。
//   原实现落「下标左值写宽度」标量通道（取下标元素宽度码 → 8 字节/2 字节写）——
//   结构体元素只写首字段（探针 p29：`表[1] = 造点(30)` 首字段=返回值地址、余 0）。
//   守卫：左末=下标 ∧ 右值=调用 ∧ 元素类型=**结构体**（类走既有深拷通道）。
不安全 函数 尝试下标结构体整体写(向量<节点> 池, 节点 n, 节点 左末,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    如果 (左末.类型 != 节点_下标 || 左末.子起点 <= 0) {
        返回 假;
    }
    如果 (n.子起点 >= n.子终点) {
        返回 假;
    }
    节点 右末x = 池.元素(整32(n.子终点 - 1));
    // 505-a（T70 B1 二层·右值形态扩全）：原守卫只认 调用 右值——标识符/成员链/
    //   三元/结构体字面量右值全落「下标左值写宽度」标量通道（8 字节 StorePtr）：
    //   ①标识符 `表[0] = p` 只写首 8 字节（y 丢·探针 7/0）②成员链/三元/字面量
    //   更把**源地址当元素值**写入（探针 140733637143672/… 静默错值）——生产态
    //   即暴露（非撤守卫态专属；宿主 emitStructWholeAssign 全形态统一整体写=
    //   参考实现）。扩面后本通道覆盖 生成结构体整体赋值 的右值全集。
    // 768 续（001 波·113 值差单环根治）：**下标链右值形态补全**——「下标左值 =
    //   结构体下标链」（拷贝构造 `值 数组[i] = 其他.值 数组[i]`·泛型 V=符号
    //   32B）原形态表漏 节点_下标 → 本通道 return 假 → 落 8B 宽通道把**源元素
    //   槽地址当值写入**（bb24_18 铁证：写入值=步进 0x20 的地址序列·类型ID
    //   读=0·113 第 11 行值差）。宿主同形态=源/目标 place 地址 4×8B 展开整体
    //   拷（emitStructWholeAssign 32B 展开·hostout.s bb30 实测）——右是地点x
    //   扩 下标链（place 形态）走下方 生成左值地址(源)→IR_结构体拷贝 路径，
    //   Rust `values[i] = other[j]`（V: Copy）memcpy 同构〔基准=019 第 1/4 句〕。
    布尔 右是调用x = 右末x.类型 == 节点_调用;
    布尔 右是地点x = 右末x.类型 == 节点_标识符 || 右末x.类型 == 节点_成员
                  || 右末x.类型 == 节点_下标;
    布尔 右是三元x = 右末x.类型 == 节点_三元运算;
    布尔 右是构造x = 右末x.类型 == 节点_结构体构造;
    如果 (!右是调用x && !右是地点x && !右是三元x && !右是构造x) { 返回 假; }
    整64 元素类型IDx = 推导下标元素类型ID(池, 整32(左末.子起点));
    如果 (元素类型IDx == 0) { 返回 假; }
    字符串 元素文本x = 字符串复制(驻留文本(元素类型IDx));
    // 466-a（T70 面⑥·窄域剥层·仅本通道判定）：元素类型引用后缀 '&'（容器方法
    //   克隆体实参标注形态）——不剥则容器元素误进本通道且查源 miss 误诊；
    //   剥后容器/类元素=返回 假 走下标写宽度通道（复制 展开产物=一次性对象
    //   →指针浅写=接管语义）。
    整64 元素长x = 字符串长度(元素文本x);
    当 (元素长x > 1 && ((整64(元素文本x[整32(元素长x - 1)]) & 255) == 38)) {
        元素文本x = 字符串子串(元素文本x, 0, 整32(元素长x - 1));
        元素长x--;
        元素类型IDx = 驻留(元素文本x);
    }
    // 517-a（甲·对齐宿主）：**类/容器元素放行本通道**——向量内按「内联整对象」
    //   存储（尺寸=类型大小与对齐(元素)=类布局大小·与元素步长同口径）。原排除
    //   （466-a）在「元素步长=类布局大小」实例化下口径不符：元素槽只写 8 字节
    //   句柄、其余 48 字节为相邻零内存 → 消费方读到「伪对象」→ 桶数量=0 →
    //   索引未掩码 → 段错误（/tmp/p517 探针·127 撤守卫态实证）。
    布尔 元素是类x = 是容器类(元素文本x) || 是用户类(元素文本x);
    // 595-a（001-001 双模收敛·根因8）：类/容器元素+调用右值改入本通道——
    //   复制 展开③产物=新堆对象句柄（宿主 genCopyBuiltin ③ 同构·ir_fields
    //   .cpp:668 NewObject+拷贝构造），句柄即对象地址 → 从堆体 IR_结构体拷贝
    //   整块拷入内联元素槽（宿主 emitStructWholeAssign 234-a 分支同语义：
    //   srcAddr=genExpr(复制调用)→CopyStruct 全内容·H8「类元素落 StorePtr
    //   只写 8 字节→元素数据破坏」同型）。原 466-a 排除令本形态落回 8B 通道
    //   浅写句柄进 56B 元素槽=伪对象（stdlib 克隆体 数据[索引]=复制(...) 核心语
    //   句全灭·237/238/240 校验位差实红）。
    // 768 续（001 波·键段 SEGV 根治）：**标量元素排除前置**——「下标左值 =
    //   复制(标量下标链)」（键段 K=整64）的 复制 展开①直通产物=**元素值**
    //   （非地址）→ 8B 宽通道值写=正确语义（宿主 Load/Store 同构）。原标量
    //   排除在调用分支**之后**：统一段整体拷贝把「Load 值」当地址→rep movsb
    //   rsi=1 SEGV（gdb 实证·拷贝构造键段循环 bb24_15）。
    // 768 续（001 波·键段 SEGV 根治）：**标量元素排除前置**——「下标左值 =
    //   复制(标量下标链)」（键段 K=整64）的 复制 展开①直通产物=**元素值**
    //   （非地址）→ 8B 宽通道值写=正确语义（宿主 Load/Store 同构）。原标量
    //   排除在调用分支**之后**：统一段整体拷贝把「Load 值」当地址→rep movsb
    //   rsi=1 SEGV（gdb 实证·拷贝构造键段循环 bb24_15）。
    // 983：非结构体大标量（整128/正128=16 字节）元素也入本通道整体写——
    //   原 `!元素是类x && 查结构体大小==0` 排除令其落 8B StorePtr 宽通道
    //   只写 lo 半（向量<整128> 追加 元素槽 hi 半=垃圾实证）。
    如果 (!元素是类x && 查结构体大小(元素类型IDx) == 0 &&
         类型名宽度(元素类型IDx) <= 8) { 返回 假; }
    如果 (右是调用x) {
        // 760-a：统一「下标左值 = 调用右值」整体写通道——原条件「元素是类x」
        //   在泛型实例克隆体（映射$整64$符号$映射 的值段）因 推导下标元素类型ID
        //   返回未实例化参数文本「V」（元素是类x=假）而 miss→落 8B 标量写
        //   （值数组[0]=地址值·类型ID=0 实锤）→统一按调用右值整体写·尺寸回退
        //   结构体返回临时们（462-a 登记）·标量尺寸=原宽度等价。
        整64 前深度k = 表达式栈.大小();
        整64 源句柄k = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                  指令, 寄存器计数, &函数信息.块计数,
                                  槽计数, 表达式栈);
        当 (表达式栈.大小() > 前深度k) {
            结果<空类型, 整32> 删栈k = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈k.正常) { 运行时错误(4); }
        }
        整64 目标地址k = 生成左值地址(池, 整32(n.附加), n.子起点, 局部槽, 参数槽,
                                      指令, 寄存器计数, &函数信息.块计数,
                                      槽计数, 表达式栈);
        整64 尺寸k = 0;
        整64 对齐k = 0;
        类型大小与对齐(元素文本x, &尺寸k, &对齐k);
        如果 (尺寸k <= 0) {
            结果<整64, 整32> 查临k = 结构体返回临时们.获取(源句柄k);
            如果 (查临k.正常) { 尺寸k = 查结构体大小(查临k.值); }
        }
        如果 (目标地址k != 0 && 源句柄k != 0 && 尺寸k > 0) {
            IR追加(指令, 建IR指令(IR_结构体拷贝, 源句柄k, 目标地址k,
                                 0, 0, 尺寸k, 0));
        }
        返回 真;
    }
    // ===== 505-a：非调用右值（标识符/成员链/下标链/三元/结构体字面量）=====
    //   源地址三形态（对齐 尝试成员结构体整体写 86-a 口径与宿主
    //   emitStructWholeAssign 右值三形态）：
    //     · 标识符/成员链 → 生成左值地址（place 地址·顺序链）
    //     · 三元 → 生成表达式（聚合三元地址透传=选中 place 地址·86-a）
    //     · 结构体字面量 → 生成表达式（84-a 物化临时槽 → 槽地址）
    //   目标地址 = 生成左值地址（与 ① 调用路径同款）；整体拷贝深拷=真
    //   （源保持拥有·元素槽取独立副本）+ 目标元素槽 preFree=真（86-a：槽内旧串
    //   为前次整体赋值/深拷副本=值语义拥有，覆盖前须释放；未初始化槽垃圾句柄
    //   经 cn_free_tracked 仅在册释放=空安全·84-f 核验结论）。
    如果 (!右是调用x) {
        整64 目标地址n = 生成左值地址(池, 整32(n.附加), n.子起点, 局部槽, 参数槽,
                                     指令, 寄存器计数, &函数信息.块计数,
                                     槽计数, 表达式栈);
        整64 源地址x = 0;
        如果 (右是三元x || 右是构造x) {
            源地址x = 生成表达式(池, 整32(n.子起点), 整32(n.子终点),
                                局部槽, 参数槽, 指令, 寄存器计数,
                                &函数信息.块计数, 槽计数, 表达式栈);
        } 否则 如果 (元素是类x) {
            // 595-a（001-001 双模收敛·fix9 根因3 写侧）：类/容器元素+类源
            //   标识符/成员链——源地址=表达式产物句柄（=堆对象地址·宿主
            //   emitStructWholeAssign 类源 Load 槽同款），非 生成左值地址 的
            //   **句柄槽地址**。原取槽地址→IR_结构体拷贝 拷出「句柄+相邻槽
            //   垃圾」56B 伪对象进元素槽（stdlib 追加/设置 克隆体
            //    数据[元素数量] = 值 核心语句全灭·113/221/234/238/240/283
            //   段错误与校验位差实锤）。
            源地址x = 生成表达式(池, 整32(n.子起点), 整32(n.子终点),
                                局部槽, 参数槽, 指令, 寄存器计数,
                                &函数信息.块计数, 槽计数, 表达式栈);
        } 否则 {
            源地址x = 生成左值地址(池, 整32(n.子起点), 整32(n.子终点),
                                  局部槽, 参数槽, 指令, 寄存器计数,
                                  &函数信息.块计数, 槽计数, 表达式栈);
        }
        如果 (目标地址n != 0 && 源地址x != 0) {
            如果 (元素是类x) {
                整64 尺寸x = 0;
                整64 对齐x = 0;
                类型大小与对齐(元素文本x, &尺寸x, &对齐x);
                如果 (尺寸x > 0) {
                    // 698-b〔基准=019〕：类/容器元素→拷贝构造深拷（698-a 铁证的
                    //   悬垂根因修复·宿主追加 asm 同款）；无拷贝构造类回退浅拷
                    如果 (!发射类元素拷贝构造写(指令, 寄存器计数, 槽计数, 源地址x,
                                          目标地址n, 元素类型IDx)) {
                        IR追加(指令, 建IR指令(IR_结构体拷贝, 源地址x, 目标地址n,
                                             0, 0, 尺寸x, 0));
                    }
                }
            } 否则 如果 (查结构体大小(元素类型IDx) == 0) {
                // 983（002·57 转批①同族·下标元素槽写）：非结构体大标量
                //   （整128/正128=16 字节）→ IR_结构体拷贝 16 字节整体写
                //   （810 双半语义同构·源=128 位 place 槽地址；发射结构体
                //   整体拷贝 尺寸源=查结构体大小=0 会零拷贝故直发）——原落
                //   8B 宽通道 StorePtr 只写 lo 半（元素 hi 半=相邻槽垃圾·
                //   向量<整128> 追加 实证）。
                IR追加(指令, 建IR指令(IR_结构体拷贝, 源地址x, 目标地址n,
                                     0, 0, 类型名宽度(元素类型IDx), 0));
            } 否则 {
                发射结构体整体拷贝(函数信息, 寄存器计数, 目标地址n, 源地址x,
                                 元素类型IDx, 真, 真);
            }
        }
        当 (表达式栈.大小() > 0) {
            结果<空类型, 整32> 删栈n = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈n.正常) { 运行时错误(4); }
        }
        返回 真;
    }
    // ① 源（可能含块——须在目标地址发射之前）+ 栈纪律（弹到进入深度）
    整64 前深度x = 表达式栈.大小();
    整64 消费x = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽, 指令,
                           寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
    整64 源寄存器x = 0;
    如果 (表达式栈.大小() > 前深度x) {
        源寄存器x = 表达式栈.元素(表达式栈.大小() - 1);
    }
    当 (表达式栈.大小() > 前深度x) {
        结果<空类型, 整32> 删源x = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删源x.正常) { 运行时错误(4); }
    }
    结果<整64, 整32> 查源x = 结构体返回临时们.获取(源寄存器x);
    如果 (消费x == 0 || 源寄存器x == 0 || !查源x.正常) {
        IR层诊断("下标元素赋值右值（调用返回）非结构体返回值: " +
                     驻留文本(整64(n.文本)) + " [宿主=" + 驻留文本(取当前生成符号ID()) +
                     "] 元素=" + 元素文本x + " 查源=" + 整数转字符串(整64(查源x.正常)));
        返回 真;
    }
    // ② 目标地址（纯地址计算）
    整64 目标地址x = 生成左值地址(池, 整32(n.附加), n.子起点, 局部槽, 参数槽, 指令,
                                寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
    如果 (目标地址x != 0) {
        // ③ 整体拷贝（源=一次性物化槽 → 浅拷接管；目标字段串 preFree）
        发射结构体整体拷贝(函数信息, 寄存器计数, 目标地址x, 源寄存器x,
                         元素类型IDx, 真, 假);
    }
    当 (表达式栈.大小() > 前深度x) {
        结果<空类型, 整32> 删栈x = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈x.正常) { 运行时错误(4); }
    }
    返回 真;
}

// 成员字符串字段写入归一化发射面（172-a 自 生成成员解引用赋值 机械搬移；
//   172-a 前为 生成赋值语句 662~723 段；79-a/87-a 族）——返回写回后的值
//   寄存器（借用来源经 __cn_str_copy 落堆时换用 copy 寄存器）。
不安全 函数 发射成员串字段写入(向量<节点> 池, 节点 n, 节点 左末, 整64 地址寄存器,
                  整64 值寄存器, 函数IR& 函数信息, 向量<IR指令>& 指令,
                  整64* 寄存器计数) -> 整64 {
    如果 (地址寄存器 != 0 && 值寄存器 != 0 && 左末.类型 == 节点_成员) {
        整64 父链IDw = 解析成员链结构体ID(池, 整32(左末.子起点));
        如果 (父链IDw != 0) {
            整64 字段类型IDw = 查字段类型ID(父链IDw, 整64(左末.文本));
            如果 (字段类型IDw != 0 && 字符串比较(驻留文本(字段类型IDw), "字符串")) {
                节点 右末w = 池.元素(n.子终点 - 1);
                布尔 需复制 = 真;
                如果 (右末w.类型 == 节点_字符串字面量) { 需复制 = 假; }
                否则 如果 (右末w.类型 == 节点_调用 && 右末w.子起点 > 0) {
                    节点 被调w = 池.元素(整32(右末w.子起点));
                    如果 (被调w.类型 == 节点_标识符) {
                        整64 被调名w = 整64(被调w.文本);
                        布尔 白名单w = 被调名w == 驻留("字符串复制") ||
                                      被调名w == 驻留("字符串连接") ||
                                      被调名w == 驻留("字符串拼接") ||
                                      被调名w == 驻留("字符串子串") ||
                                      被调名w == 驻留("字符串大写") ||
                                      被调名w == 驻留("字符串小写") ||
                                      被调名w == 驻留("字符串修剪") ||
                                      被调名w == 驻留("字符串反转");
                        如果 (!白名单w && 查函数返回回退(被调名w) == 驻留("字符串")) {
                            白名单w = 真;   // A2 契约：签名即契约
                        }
                        需复制 = !白名单w;
                    }
                }
                如果 (需复制) {
                    值寄存器 = 发射字符串复制调用(指令, 寄存器计数, 值寄存器);
                }
                如果 (左末.子起点 > 0) {
                    节点 对象w = 池.元素(整32(左末.子起点));
                    布尔 是拥有字段槽w = 假;
                    如果 (对象w.类型 == 节点_标识符) {
                        是拥有字段槽w = 在资源字段名单(函数信息, 整64(对象w.文本));
                        // 87-a（2026-09-12 第八十七轮）：顶层静态结构体的字段槽
                        //   ——槽长期存活**恒拥有**（局部按块出口 drop；静态无出口，
                        //   重复赋值必须当场 drop 旧串，否则每次赋值泄漏）。原判据
                        //   仅「父∈资源字段名单」——静态名不在名单 → 不释放（探针
                        //   s9-v2 实证：循环 300 次赋值残留 +600）。
                        如果 (!是拥有字段槽w) {
                            整64 找静w = 查静态序号(整64(对象w.文本));
                            如果 (找静w >= 0 && 查结构体大小(取静态类型(找静w)) > 0) {
                                是拥有字段槽w = 真;
                            }
                        }
                    }
                    如果 (是拥有字段槽w) {
                        整64 旧regw = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_指针加载, 地址寄存器, 0, 0, 旧regw, T_字符串, 0));
                        IR追加(指令, 建IR指令(IR_调用实参, 旧regw, 0, 0, 0, 0, 0));
                        IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                             驻留("__cn_str_free")));
                        如果 (函数信息.零寄存器 != 0) {
                            IR追加(指令, 建IR指令(IR_指针存储, 地址寄存器,
                                         函数信息.零寄存器, 0, 0, T_整64, 0));
                        }
                    }
                }
            }
        }
    }
    返回 值寄存器;
}

// 698-b〔基准=019〕：类/容器元素槽写入=**拷贝构造深拷**（宿主 emitStructWholeAssign
//   类源 NewObject+拷贝构造/追加 asm rcx=元素槽 rdx=&值 call 拷贝构造·7178 实证同款）
//   ——原 IR_结构体拷贝 56B 浅字节拷共享指针字段（桶数组/键数组/链数组）→源 RAII
//   析构后元素槽悬垂（698-a 铁证：压入 的 层 析构 free 桶数组→元素0 桶数组=悬垂块
//   →拷贝构造读 BAADF00D→链查找 READ at -1 段错误）。装配：句柄槽 ← 源壳地址·
//   拷贝构造(自身=元素槽·其他=&句柄槽)——自身=内联接收一跳写、其他=T& 句柄两跳
//   （698-a 定案契约）。元素类无拷贝构造（查类构造参数串 miss=纯数据类）→返回 假
//   调用方回退 IR_结构体拷贝（POD 浅拷语义安全）。
//   边界（诚实边界）：覆盖写场景元素槽旧值无 preFree（追加 末尾写=新槽无旧值·
//   覆盖写场景由 86-a 串 preFree 通道自理）——旧容器元素泄漏面登记 025 §1.9。
不安全 函数 发射类元素拷贝构造写(向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数,
                              整64 源地址reg, 整64 目标地址reg, 整64 元素类型IDx) -> 布尔 {
    整64 拷贝串IDw = 查类拷贝构造串(元素类型IDx);
    如果 (拷贝串IDw == 0) { 返回 假; }
    字符串 元素文本w = 字符串复制(驻留文本(元素类型IDx));
    整64 源句柄槽w = 槽计数[0];
    槽计数[0] = 槽计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 源句柄槽w));
    IR追加(指令, 建IR指令(IR_存储, 源地址reg, 0, 0, 0, 0, 源句柄槽w));
    整64 源地址regw = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_取地址, 源句柄槽w, 0, 0, 源地址regw, T_整64, 0));
    IR追加(指令, 建IR指令(IR_调用实参, 目标地址reg, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用实参, 源地址regw, 0, 0, 0, 1, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                         驻留(方法符号(元素文本w, 合成名基名(元素文本w),
                                元素文本w + "&"))));
    返回 真;
}
