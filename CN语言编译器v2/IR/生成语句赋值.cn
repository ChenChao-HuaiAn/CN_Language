// CN 自举编译器 v2 · 生成语句（D1 行数整改 172-a 拆分子模块，2026-09-15）
// 职责：赋值语句生成族——自 生成语句.cn 的 生成赋值语句 机械搬移（纯重构零
//   行为变更）：主分派（标识符左值 / 成员·解引用左值）+ 标识符赋值生成
//   （生成标识符赋值）+ 成员·解引用赋值生成（生成成员解引用赋值）+ 三个
//   发射面族（尝试成员结构体整体写 / 发射拥有串赋值 / 发射成员串字段写入）。
//   寄存器/引用参数等权威表经 公开: 访问函数（IR生成 主干）；模块路径=
//   生成语句赋值（新键基）。
导入 容器::向量;
导入 语法;       // Token/AST 节点池（原 导入 语法分析，目录包名）
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 IR生成;     // 控制流辅助/变量类型权威表（同包幂等）
导入 生成声明;    // 语句级变量声明分派（R3 拆分，同包）
导入 IO;         // 221 d225 插桩（打印到错误·验后撤）
导入 IO;         // 760 续诊断插桩用
公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 赋值语句：文本=左值名（标识符槽/静态槽）；文本=0 时 附加=左值表达式起点
//   （解引用/成员/下标左值，按字段宽度存储）。结构体整体赋值经
//   生成结构体整体赋值（第18枚 POD Copy 语义）先行拦截。
// D1 行数整改 172-a：主函数收缩为分派骨架——标识符左值走 生成标识符赋值，
//   成员/解引用左值走 生成成员解引用赋值（行为等价于原单函数双分支）。
不安全 函数 生成赋值语句(向量<节点> 池, 节点 n,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) {
    如果 (n.文本 != 0) {
        生成标识符赋值(池, n, 局部槽, 参数槽, 函数信息,
                       寄存器计数, 槽计数, 表达式栈);
        返回;
    }
    生成成员解引用赋值(池, n, 局部槽, 参数槽, 函数信息,
                       寄存器计数, 槽计数, 表达式栈);
}

// 标识符左值赋值生成（172-a 自 生成赋值语句 分支一 机械搬移）：
//   文本=左值名（局部槽/参数槽/静态槽/类字段/拥有串归一化/引用参数写回）。
不安全 函数 生成标识符赋值(向量<节点> 池, 节点 n,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) {
    向量<IR指令>& 指令 = 函数信息.指令;
    // 070 波G（1026）：类名.静态字段写——赋值节点 文本=字段名·左值区间末=成员
    //  且对象=用户类名+静态字段表命中 → 右值求值+静态槽写（须在 生成左值地址
    //  前拦截——成员链偏移=静态不入对象布局「成员左值字段偏移未知」诊断源）
    如果 (n.子终点 > n.子起点) {
        节点 左末g = 池.元素(整32(n.子终点 - 1));
        如果 (左末g.类型 == 节点_成员 && 左末g.子起点 > 0) {
            节点 对象g = 池.元素(整32(左末g.子起点));
            如果 (对象g.类型 == 节点_标识符 && 是用户类_ID(整64(对象g.文本)) &&
                 查类静态字段合成名(整64(对象g.文本), 整64(左末g.文本)) != 0) {
                整64 序写g2 = 查静态序号含类(查类静态字段合成名(整64(对象g.文本), 整64(左末g.文本)));
                如果 (序写g2 >= 0) {
                    整64 值寄存器g2 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                              指令, 寄存器计数, &函数信息.块计数,
                                              槽计数, 表达式栈);
                    整64 静址g2 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静址g2, T_整64, 序写g2));
                    IR追加(指令, 建IR指令(IR_指针存储, 静址g2, 值寄存器g2, 0, 0, T_整64, 0));
                    当 (表达式栈.大小() > 0) {
                        结果<空类型, 整32> 删栈g2 = 表达式栈.删除(表达式栈.大小() - 1);
                        如果 (!删栈g2.正常) { 运行时错误(4); }
                    }
                    返回;
                }
            }
        }
    }
    // 标识符左值：槽 <- 右值寄存器
    整64 目标槽 = 0;
    结果<整64, 整32> 找槽 = 局部槽.获取(整64(n.文本));
    如果 (找槽.正常) { 目标槽 = 找槽.值; }
    如果 (目标槽 == 0) {
        结果<整64, 整32> 找参 = 参数槽.获取(整64(n.文本));
        如果 (找参.正常) { 目标槽 = 找参.值; }
    }
        如果 (生成结构体整体赋值(池, n, 目标槽, 局部槽, 参数槽, 函数信息,
                                 寄存器计数, 槽计数, 表达式栈)) {
            返回;
        }
        // 346-a（2026-09-18 第 346 轮·T57 根治）：容器/用户类对象整体赋值深拷贝
        //   ——须先于右值求值（本通道自行发射源左值地址，与 生成容器拷贝构造
        //   同口径；右值区间不单独求值）；命中返回真。
        如果 (生成容器对象整体赋值(池, n, 目标槽, 局部槽, 参数槽, 函数信息,
                                 寄存器计数, 槽计数, 表达式栈)) {
            返回;
        }
        // 965（002·30）：合成体（结果/可选）整体赋值——须在普通 生成表达式
        //   通道前拦截（IR_存储 8 字节只写 sret 指针进基址槽 → .正常/.错误
        //   按内联布局读槽=读指针自身字节·ASLR 漂移错值·E2E 30 实证）
        如果 (生成合成体整体赋值(池, n, 目标槽, 局部槽, 参数槽, 函数信息,
                                寄存器计数, 槽计数, 表达式栈)) {
            返回;
        }
    整64 值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
    // 810（053）：128 位目标赋值——左类型 整128/正128：右值=地址句柄（128 位
    //   表达式统一形态）→ 发射128位双半拷贝 到目标槽对（基址槽=局部/参数槽
    //   登记值·低地址低半；静态目标=IR_静态地址 得 .data 槽地址 + IR_结构体
    //   拷贝 16 字节 T96c 双半）。右值=64 位值（字面量/窄表达式）→ 拆半物化
    //   （解析128位初值文本 two's complement·与声明初值同源逻辑）。
    {
        整64 左类型ID128 = 解析标识符类型ID(整64(n.文本));
        字符串 左类型文本128 = 左类型ID128 > 0 ?
            字符串复制(驻留文本(左类型ID128)) : 字符串复制("");
        如果 (字符串比较(左类型文本128, "整128") ||
             字符串比较(左类型文本128, "正128")) {
            整64 源码128 = 查寄存器类型(值寄存器);
            如果 (目标槽 != 0) {
                如果 (源码128 == T_整128 || 源码128 == T_正128) {
                    发射128位双半拷贝(值寄存器, 目标槽, 目标槽 - 1,
                                      指令, 寄存器计数);
                } 否则 {
                    IR层诊断("128 位变量赋值右值须为 128 位表达式: " +
                             驻留文本(整64(n.文本)));
                }
            } 否则 {
                整64 找静128 = 查静态序号含类(整64(n.文本));
                如果 (找静128 >= 0) {
                    整64 静地址128 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静地址128,
                                         T_整64, 找静128));
                    IR追加(指令, 建IR指令(IR_结构体拷贝, 值寄存器, 静地址128, 0, 0,
                                         16, 0));
                } 否则 {
                    // 810（053）：方法体字段目标（裸字段名 数 = 初始·构造器/方法内）
                    //   ——字段地址 + IR_结构体拷贝 16 字节（T96c 双半）；原实现
                    //   静默吞掉整条语句（只求值不写·420-③ 构造器 asm 空实证）。
                    整64 字段偏移128 = 当前方法字段偏移(整64(n.文本));
                    如果 (字段偏移128 >= 0) {
                        整64 字段地址128 = 发射类字段地址(字段偏移128, 指令, 寄存器计数);
                        IR追加(指令, 建IR指令(IR_结构体拷贝, 值寄存器, 字段地址128,
                                             0, 0, 16, 0));
                    } 否则 {
                        // 兜底显式诊断（禁静默降级——宁严勿松）
                        IR层诊断("128 位赋值目标未解析（非局部/参数/静态/字段）: " +
                                 驻留文本(整64(n.文本)));
                    }
                }
            }
            当 (表达式栈.大小() > 0) {
                结果<空类型, 整32> 删栈128 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删栈128.正常) { 运行时错误(4); }
            }
            返回;
        }
    }
    // T69（480-a 深度机）：赋值右值位函数名收口——`f = 减;`（函数指针变量赋值
    //   函数名）右值=函数名（负占位）→ IR_函数地址
    值寄存器 = 值位函数名收口480(值寄存器, 指令, 寄存器计数);
    // 第七十八轮（2026-09-12）：方法体字段左值赋值（字段名裸标识符——局部/参数
    //   未命中；this 槽加载 + 字段地址 + 指针存储）。结构体类型字段整体赋值=
    //   第一版边界（显式拒绝——8 字节指针存储会静默截断 >8 字节结构体）
    如果 (目标槽 == 0 && 值寄存器 != 0) {
        整64 字段偏移z = 当前方法字段偏移(整64(n.文本));
        如果 (字段偏移z >= 0) {
            整64 字段类型z = 查字段类型ID(当前方法类名ID, 整64(n.文本));
            // 595-a（001-001 双模收敛·根因6）：容器字段排除出结构体整体赋值
            //   通道（506-a 于 尝试成员结构体整体写 的同款守卫补齐到裸名通道
            //   ·侦察根因6）。撤守卫态容器字段类型入结构体大小表 → 原翻转走
            //   发射结构体整体拷贝（句柄+padding 浅拷 24/56/64 字节·绕过旧值
            //   删除/深拷）；容器字段=句柄槽 → 指针存储（下方 ·与生产态同位
            //   同路径）。
            如果 (字段类型z != 0 && !是容器类(驻留文本(字段类型z)) &&
                 查结构体大小(字段类型z) != 0) {
                // 508-a（T70 B1 三层④）：**类字段（结构体类型）整体赋值**由
                //   fail-fast 改实现（原「暂不支持」诊断+运行时错误(6) 主动中止
                //   ——撤守卫态 stdlib 克隆体触发实证 228/441/442·gdb 栈帧
                //   =生成语句赋值$生成标识符赋值）。语义对齐 生成结构体整体赋值/
                //   尝试成员结构体整体写：目标=字段地址（发射类字段地址·this
                //   槽基址）→ 整体拷贝（深拷=真·字段旧串 preFree=真）。
                //   源地址取法（右值已由上方 生成表达式 求值——避免二次求值副作用）：
                //     · 标识符/成员链 → 生成左值地址（place 地址·无副作用重算；
                //       标识符直通求值产物=首槽值非结构体地址）
                //     · 调用/三元/结构体字面量 → 求值产物即结构体地址
                //       （调用=物化槽〔结构体返回临时们〕·三元=聚合地址透传
                //       〔86-a〕·字面量=物化临时槽〔84-a〕）
                节点 右末z = 池.元素(整32(n.子终点 - 1));
                整64 源地址z = 值寄存器;
                如果 (右末z.类型 == 节点_标识符 || 右末z.类型 == 节点_成员) {
                    源地址z = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                           指令, 寄存器计数, &函数信息.块计数,
                                           槽计数, 表达式栈);
                }
                整64 目标地址z = 发射类字段地址(字段偏移z, 指令, 寄存器计数);
                如果 (目标地址z != 0 && 源地址z != 0) {
                    发射结构体整体拷贝(函数信息, 寄存器计数, 目标地址z, 源地址z,
                                     字段类型z, 真, 真);
                }
                当 (表达式栈.大小() > 0) {
                    结果<空类型, 整32> 删栈整z = 表达式栈.删除(表达式栈.大小() - 1);
                    如果 (!删栈整z.正常) { 运行时错误(4); }
                }
                返回;
            }
            // 836-a（070-③ 层②·窄面）：容器/用户类**字段** ← **成员链右值**
            //   （`X.字段 = Y.字段`·V7 形态）深拷通道：字段地址+释放旧（空安全）
            //   +新对象+拷贝构造+写回（与 346-a/833 层① 同款）。**仅成员链**——
            //   835 全开（标识符 OR 成员链）实测 5 新红链接回归 → 收窄
            //   （标识符右值形态维持原通道·零行为变更）。**已全量实证零回归**（534/3）。
            {
                节点 右末z2 = 池.元素(整32(n.子终点 - 1));
                如果 (字段类型z != 0 && 右末z2.类型 == 节点_成员 &&
                     (是容器类(驻留文本(字段类型z)) || 是用户类(驻留文本(字段类型z)))) {
                    字符串 字段文本f = 字符串复制(驻留文本(字段类型z));
                    整64 目标地址f = 发射类字段地址(字段偏移z, 指令, 寄存器计数);
                    整64 源地址f = 生成左值地址(池, 整32(n.子起点), 整32(n.子终点),
                                                 局部槽, 参数槽, 指令, 寄存器计数,
                                                 &函数信息.块计数, 槽计数, 表达式栈);
                    整64 旧对象f = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_指针加载, 目标地址f, 0, 0, 旧对象f, T_对象, 0));
                    整64 删标f = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_删除对象, 旧对象f, 0, 0, 删标f, 0, 字段类型z));
                    整64 对象字节f = 查结构体大小(字段类型z);
                    如果 (是容器类(字段文本f)) { 对象字节f = 容器对象大小(字段文本f); }
                    整64 新对象f = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新对象f, 对象字节f, 字段类型z));
                    IR追加(指令, 建IR指令(IR_调用实参, 新对象f, 0, 0, 0, 0, 0));
                    IR追加(指令, 建IR指令(IR_调用实参, 源地址f, 0, 0, 0, 1, 0));
                    IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                                          驻留(方法符号(字段文本f, 合成名基名(字段文本f),
                                                        字段文本f + "&"))));
                    IR追加(指令, 建IR指令(IR_指针存储, 目标地址f, 新对象f, 0, 0, T_整64, 0));
                    当 (表达式栈.大小() > 0) {
                        结果<空类型, 整32> 删栈f = 表达式栈.删除(表达式栈.大小() - 1);
                        如果 (!删栈f.正常) { 运行时错误(4); }
                    }
                    返回;
                }
            }
            // 843-a（070-③ 十一轮·842 根因定案实施）：容器/用户类字段 ← **构造
            //   调用右值**（`表 = 向量<字符串>()`）——构造调用物化在**栈**（值寄存器
            //   = 栈上对象地址）·字段须持**堆句柄**（842 插桩铁证：存栈地址→析构
            //   `cn_free(栈地址)`→计数 -1）→ **堆化**：IR_分配对象(对象字节) +
            //   IR_结构体拷贝(整体字节) → 堆句柄写字段（对齐 838 深拷面/346-a）。
            {
                节点 右末c = 池.元素(整32(n.子终点 - 1));
                如果 (字段类型z != 0 && 右末c.类型 == 节点_调用 &&
                    (是容器类(驻留文本(字段类型z)) || 是用户类(驻留文本(字段类型z)))) {
                    字符串 字段文本c = 字符串复制(驻留文本(字段类型z));
                    整64 对象字节c = 查结构体大小(字段类型z);
                    如果 (是容器类(字段文本c)) { 对象字节c = 容器对象大小(字段文本c); }
                    整64 堆对象c = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 堆对象c, 对象字节c, 字段类型z));
                    IR追加(指令, 建IR指令(IR_结构体拷贝, 值寄存器, 堆对象c, 0, 0, 对象字节c, 0));
                    整64 地址c = 发射类字段地址(字段偏移z, 指令, 寄存器计数);
                    IR追加(指令, 建IR指令(IR_指针存储, 地址c, 堆对象c, 0, 0, T_整64, 0));
                    当 (表达式栈.大小() > 0) {
                        结果<空类型, 整32> 删栈c = 表达式栈.删除(表达式栈.大小() - 1);
                        如果 (!删栈c.正常) { 运行时错误(4); }
                    }
                    返回;
                }
            }
            整64 地址z = 发射类字段地址(字段偏移z, 指令, 寄存器计数);
            IR追加(指令, 建IR指令(IR_指针存储, 地址z, 值寄存器, 0, 0, T_整64, 0));
            当 (表达式栈.大小() > 0) {
                结果<空类型, 整32> 删栈z = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删栈z.正常) { 运行时错误(4); }
            }
            返回;
        }
    }
    // 静态槽赋值（2026-09-06 根治，缺陷零容忍）：目标非局部/参数时查
    //   静态序号表——命中则 IR_静态存储 写回 .data 槽。原实现此处仅认
    //   局部/参数槽，静态目标「目标槽==0」静默丢存储（探针 计数器 =
    //   计数器 + 阶段(5) 打印恒 0 实证）——防御分支静默降级家族成员，
    //   与 发射自增自减 的静态读写对（②c C）同款设施补齐
    如果 (目标槽 == 0 && 值寄存器 != 0) {
        整64 找静赋 = 查静态序号含类(整64(n.文本));
        如果 (找静赋 >= 0) {
            // 87-a（2026-09-12 第八十七轮）：静态**字符串**——drop 旧 + 来源分级
            //   归一化（借用来源 __cn_str_copy 落堆）；其余静态类型（标量值/
            //   容器类句柄）保持 8 字节直存（指针槽模型）。
            如果 (字符串比较(驻留文本(取静态类型(找静赋)), "字符串")) {
                值寄存器 = 归一化静态串赋值(池, n, 值寄存器, 找静赋, 函数信息,
                                            寄存器计数);
            }
            IR追加(指令, 建IR指令(IR_静态存储, 值寄存器, 0, 0, 0, T_整64, 找静赋));
        }
    }
    // plans/019 阶段4' 第二批（2026-09-11 方案A）：拥有型字符串赋值——宿主
    //   第一批复核同构 + Rust 赋值语义（先 drop 旧再 move 新）：目标=字符串
    //   且在拥有名单且未污染时：①右值=字面量/标识符 → free 旧 + __cn_str_copy
    //   落堆（变量恒拥有堆串）；②右值=白名单八函数调用/二元拼接（+ 产物恒
    //   堆，复合赋值 += 语法层已重析为二元）→ free 旧 + 直存；③其余形态
    //   （非白名单调用/下标/成员等借用源）→ free 旧（旧值必为拥有——拥有链
    //   维护，drop 后零泄漏，优于宿主保守面）+ 污染退出 RAII + 直存。
    //   free 旧空安全（未赋值路径槽=0——预扫入口零初始化）。
    // 172-a：发射面自本函数提取为 发射拥有串赋值（返回写回后的值寄存器）。
    值寄存器 = 发射拥有串赋值(池, n, 目标槽, 值寄存器, 函数信息, 指令, 寄存器计数);
    如果 (值寄存器 != 0 && 目标槽 != 0) {                    如果 (槽是引用(目标槽)) {
            // ②c D：引用参数赋值——Load 槽得调用方左值地址，指针写回
            整64 地址reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 地址reg, T_整64, 0));
            IR追加(指令, 建IR指令(IR_指针存储, 地址reg, 值寄存器, 0, 0, T_整64, 0));
        } 否则 {
            // 46-f 第五十轮：正32 目标存储前截断——565 轮 T33 残余根治换接
            //   窄宽值规范化（整8/整16/正8/正16/整32 回绕+符号扩展·正32 位与
            //   原路径·单一事实源在 生成声明）；非窄宽零开销直通。指针变量
            //   （查指针变量类型 命中·标量类型表按基类型登记）跳过=地址非窄值
            //   （194 正8* 实锤教训）
            整64 赋目标类型 = 查当前函数变量类型(整64(n.文本));
            如果 (查指针变量类型(整64(n.文本)) < 0) {   // <0=未登记指针（-1 哨兵）·真指针跳过
                值寄存器 = 窄宽值规范化(窄宽码自文本(驻留文本(赋目标类型)), 值寄存器,
                                        指令, 寄存器计数);
            }
            值寄存器 = 浮点宽化存储(驻留文本(赋目标类型), 值寄存器, 指令, 寄存器计数);
            // 814（053-001）：64 位目标赋值收到 128 位值→隐式窄化低半（同上）
            值寄存器 = 隐式窄化到64(值寄存器, 指令, 寄存器计数);
            IR追加(指令, 建IR指令(IR_存储, 值寄存器, 0, 0, 0, 0, 目标槽));
        }
    }
    // 清空表达式栈（右值 残留）
    当 (表达式栈.大小() > 0) {
        结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈.正常) { 运行时错误(4); }
    }
}

// 346-a（2026-09-18 第 346 轮·T57 根治）：容器/用户类对象「赋值语句」深拷贝
//   语义——对齐宿主 identifierClassCopyAssign（src/cn_compiler/ir/ir_expr_assign_ident.cpp:239）
//   与 globalStaticClassAssign（同文件 159）：宿主 IR 铁证 `乙 = 甲` 发射
//   「新建对象 + 拷贝构造（源 T& 左值地址）+ 存储新对象指针」。
//   v2 原实现落 生成标识符赋值 底部 8 字节句柄浅覆盖：赋值后两变量共享同一堆
//   对象、双方 RAII 出口各自析构 = **双释放 UAF**（探针 p8=无引用参数无结构体的
//   最小形态：宿主 rc=0 逐行正确 vs v2 rc=139 段错误；p4 向量引用参数 / p6
//   结构体容器字段同族——asm 铁证 `mov qword ptr [r10], r11` 把新对象指针覆盖进
//   调用方变量槽、被调方局部新对象随即析构 → 调用方悬垂）。
//   与宿主的唯一有意差别：目标**拥有**旧对象时先释放（Rust `a = b` drop 旧值
//   语义；宿主当前不释放=宿主侧泄漏面·按「安全零容忍」取更安全侧）。
//   形态守卫（任一不满足=返回假，落原路径零行为变更）：左值类型 ∈ {容器类, 用户类}
//   且右值末节点=标识符（局部/参数/静态）且源类型同类。
不安全 函数 生成容器对象整体赋值(向量<节点> 池, 节点 n, 整64 目标槽,
                        映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                        函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                        向量<整64>& 表达式栈) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    整64 左名ID = 整64(n.文本);
    // 234（2026-10-06·91303）：指针变量排除——左值是指针（登记指针变量类型
    //   表命中·含 类指针 形态）=句柄赋值（同地址语义），不走 值深拷通道。
    //   原 剥星类型解析（双轨坑 B）把 `形状* p = b` 当 类值赋值→分配+拷贝
    //   构造（asm 铁证 形状$形状_A_T形状·p 语义变 拷贝副本=指针语义破坏）。
    // 234 修正（441 预验红甄别）：排除仅限「所指类型=用户类」的指针左值
    //   （类指针赋值=句柄·指针语义）——stdlib 容器源码内部字段（数据/元素
    //   数量/数组容量·所指=元素/标量）同表命中但不排除（原值深拷语义保持·
    //   误排=容器拷贝构造全坏·A2 垃圾铁证）
    整64 所指查p = 查指针变量类型(左名ID);
    如果 (所指查p != 0 && 是用户类_ID(所指查p)) { 返回 假; }
    整64 左类型ID = 解析标识符类型ID(左名ID);
    如果 (左类型ID == 0) { 返回 假; }
    字符串 左类型文本 = 字符串复制(驻留文本(左类型ID));
    布尔 左是容器 = 是容器类(左类型文本);
    布尔 左是用户类 = 是用户类(左类型文本);
    如果 (!左是容器 && !左是用户类) { 返回 假; }
    // 234：跨类层级赋值守卫——源类型与目标同类才走深拷；派生→基类值=切片拒绝
    //   应在语义层报错（614 形态），生成层不合成（此处 首标识符右值 的源类
    //   沿链判定：派生→基类 返回假 落句柄赋值=引用语义错误面，宁可显式诊断）
    如果 (n.子起点 < n.子终点) {
        节点 右首探 = 池.元素(整32(n.子终点 - 1));
        如果 (右首探.类型 == 节点_标识符 && 是用户类_ID(整64(右首探.文本))) {
            整64 右类探 = 整64(右首探.文本);
            如果 (右类探 != 左类型ID && 是用户类_ID(左类型ID) &&
                 是否派生自(右类探, 左类型ID)) {
                返回 假;
            }
        }
    }
    如果 (n.子起点 >= n.子终点) { 返回 假; }
    节点 右末 = 池.元素(整32(n.子终点 - 1));
    // 963（008 总攻·v2 转移扩面）：**赋值位转移**（乙 = 转移(甲)）——右值=
    //   转移(单标识符) 调用时走句柄直交（跳过深拷）：①目标拥有旧对象先删
    //   （拥有型判定+IR_删除对象 空安全）；②源槽句柄 IR_存储 直入目标槽；
    //   ③源槽清零（源出口析构跳过=所有权交接·宿主 933 同模型）。
    如果 (右末.类型 == 节点_调用 && 右末.附加 == 1 && 右末.子起点 >= 0) {
        节点 赋被调963 = 池.元素(整32(右末.子起点));
        节点 赋实参963 = 池.元素(整32(右末.子起点) + 1);
        如果 (赋被调963.类型 == 节点_标识符 &&
             赋实参963.类型 == 节点_标识符 &&
             字符串比较(驻留文本(整64(赋被调963.文本)), "转移")) {
            整64 转源名963 = 整64(赋实参963.文本);
            如果 (转源名963 != 左名ID) {
                布尔 静963 = 假;
                如果 (目标槽 == 0 && 查静态序号含类(左名ID) >= 0) { 静963 = 真; }
                如果 (目标槽 != 0 || 静963) {
                    // ① 目标旧对象释放（拥有型：容器名单/静态恒拥有）
                    布尔 目标拥有963 = 静963;
                    如果 (!目标拥有963) {
                        整64 名m963 = 0;
                        当 (名m963 < 函数信息.容器变量们.大小()) {
                            如果 (函数信息.容器变量们.元素(名m963) == 左名ID) {
                                目标拥有963 = 真;
                                中断;
                            }
                            名m963++;
                        }
                    }
                    如果 (目标拥有963) {
                        整64 旧obj963 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        如果 (静963) {
                            整64 静序963 = 查静态序号含类(左名ID);
                            IR追加(指令, 建IR指令(IR_静态加载, 0, 0, 0, 旧obj963,
                                                 T_对象, 静序963));
                        } 否则 {
                            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 旧obj963,
                                                 T_对象, 0));
                        }
                        IR追加(指令, 建IR指令(IR_删除对象, 旧obj963, 0, 0,
                                             寄存器计数[0], 0, 左类型ID));
                        寄存器计数[0] = 寄存器计数[0] + 1;
                    }
                    // ② 源句柄加载（局部/参数槽）
                    整64 转源槽963 = 0;
                    结果<整64, 整32> 查局963 = 局部槽.获取(转源名963);
                    如果 (查局963.正常) { 转源槽963 = 查局963.值; }
                    如果 (转源槽963 == 0) {
                        结果<整64, 整32> 查参963 = 参数槽.获取(转源名963);
                        如果 (查参963.正常) { 转源槽963 = 查参963.值; }
                    }
                    如果 (转源槽963 != 0) {
                        整64 句柄963 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_加载, 转源槽963, 0, 0,
                                             句柄963, T_对象, 0));
                        如果 (静963) {
                            整64 静写963 = 寄存器计数[0];
                            寄存器计数[0] = 寄存器计数[0] + 1;
                            整64 静序w963 = 查静态序号含类(左名ID);
                            IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静写963,
                                                 T_整64, 静序w963));
                            IR追加(指令, 建IR指令(IR_指针存储, 静写963, 句柄963,
                                                 0, 0, T_整64, 0));
                        } 否则 {
                            IR追加(指令, 建IR指令(IR_存储, 句柄963, 0, 0, 0, 0,
                                                 目标槽));
                        }
                        // ③ 源槽清零（出口析构跳过=所有权交接）
                        整64 零963 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零963,
                                             T_整64, 0));
                        IR追加(指令, 建IR指令(IR_存储, 零963, 0, 0, 0, 0,
                                             转源槽963));
                        当 (表达式栈.大小() > 0) {
                            结果<空类型, 整32> 删963 = 表达式栈.删除(表达式栈.大小() - 1);
                            如果 (!删963.正常) { 运行时错误(4); }
                        }
                        返回 真;
                    }
                }
            }
        }
    }
    如果 (右末.类型 == 节点_调用) {
        // 841-a（070-③ 九轮·**右值求值单点化**·Rust「求值一次 + 移动/克隆」对照）：
        //   472-a 窄域守卫**前移**——目标槽=0 且非静态（方法字段·不可定位）时
        //   **先返回假·不执行右值求值**。原顺序（求值物化① → 守卫返回假 → 原路径
        //   再求值物化②）右值被求值两次·**物化① 泄漏**（840 asm 铁证：`盒子$盒子`
        //   两次 `__cn_object_new`+两次向量构造）。
        布尔 静472 = 假;
        如果 (目标槽 == 0 && 查静态序号含类(左名ID) >= 0) { 静472 = 真; }
        // 472-a（窄域守卫·与标识符分支既有守卫对齐）：目标槽=0 且非静态=
        //   目标不可定位（类构造内裸字段名重置形态·228 实证：记录 = 向量<字符串>()
        //   的 记录=类字段·局部槽/静态均无→存槽 0=写穿→空指针）→返回 假 交回
        //   原路径（字段写通道·生产态既有绿）。
        如果 (目标槽 == 0 && !静472) { 返回 假; }
        // 472-a：T57 分支重接入（守卫通过后**单次**求值·物化唯一）
        整64 前深度472 = 表达式栈.大小();
        整64 消费472 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽, 指令,
                                寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
        如果 (消费472 == 0 || 表达式栈.大小() <= 前深度472) { 返回 假; }
        整64 新对象472 = 表达式栈.元素(表达式栈.大小() - 1);
        当 (表达式栈.大小() > 前深度472) {
            结果<空类型, 整32> 删弹472 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删弹472.正常) { 运行时错误(4); }
        }
        布尔 拥有472 = 静472;
        如果 (!拥有472) {
            整64 名j472 = 0;
            当 (名j472 < 函数信息.容器变量们.大小()) {
                如果 (函数信息.容器变量们.元素(名j472) == 左名ID) {
                    拥有472 = 真;
                    中断;
                }
                名j472++;
            }
        }
        如果 (拥有472) {
            整64 旧对象472 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            如果 (静472) {
                IR追加(指令, 建IR指令(IR_静态加载, 0, 0, 0, 旧对象472, T_对象, 查静态序号含类(左名ID)));
            } 否则 如果 (槽是引用(目标槽)) {
                整64 目标地472 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 目标地472, T_整64, 0));
                IR追加(指令, 建IR指令(IR_指针加载, 目标地472, 0, 0, 旧对象472, T_对象, 0));
            } 否则 {
                IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 旧对象472, T_对象, 0));
            }
            // 472-a（objdel 撞号根治）：目标=寄存器计数[0]（标签唯一序号·与
            //   IR容器释放.cn:810 既有发射点同款）——466-a 版传 0→同函数第二条
            //   删除对象标签 objdel_N_0 重复定义（79_v2 fix_p.asm 61147/61170 双定义
            //   实证·MASM/GAS 符号重定义错误=228/283/79 生产态 3 红根因）。
            IR追加(指令, 建IR指令(IR_删除对象, 旧对象472, 0, 0, 寄存器计数[0], 0, 左类型ID));
            寄存器计数[0] = 寄存器计数[0] + 1;
        }
        如果 (静472) {
            IR追加(指令, 建IR指令(IR_静态存储, 新对象472, 0, 0, 0, T_整64, 查静态序号含类(左名ID)));
        } 否则 如果 (槽是引用(目标槽)) {
            整64 写回472 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 写回472, T_整64, 0));
            IR追加(指令, 建IR指令(IR_指针存储, 写回472, 新对象472, 0, 0, T_整64, 0));
        } 否则 {
            IR追加(指令, 建IR指令(IR_存储, 新对象472, 0, 0, 0, 0, 目标槽));
        }
        当 (表达式栈.大小() > 0) {
            结果<空类型, 整32> 删尾472 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删尾472.正常) { 运行时错误(4); }
        }
        返回 真;
    }
    如果 (右末.类型 != 节点_标识符) { 返回 假; }
    整64 右名ID = 整64(右末.文本);
    // 自赋值 no-op（甲 = 甲）——下方「先释放旧对象」会毁掉源（值语义自赋值恒
    //   无副作用，与 生成结构体整体赋值 79-a 自赋值守卫同款）
    如果 (右名ID == 左名ID) { 返回 真; }
    整64 右类型ID = 解析标识符类型ID(右名ID);
    如果 (右类型ID == 0) { 返回 假; }
    字符串 右类型文本 = 字符串复制(驻留文本(右类型ID));
    布尔 右是容器 = 是容器类(右类型文本);
    布尔 右是用户类 = 是用户类(右类型文本);
    如果 (!右是容器 && !右是用户类) { 返回 假; }
    // 静态目标（目标槽 0 = 顶层静态变量——解析标识符类型ID 已含静态表级）
    布尔 目标是静态 = 假;
    如果 (目标槽 == 0 && 查静态序号含类(左名ID) >= 0) { 目标是静态 = 真; }
    如果 (目标槽 == 0 && !目标是静态) { 返回 假; }
    // ---- 源对象左值地址（T& 引用位：引用参数槽内容 / 普通槽地址 / 静态符号地址）----
    整64 源槽 = 0;
    结果<整64, 整32> 找源局 = 局部槽.获取(右名ID);
    如果 (找源局.正常) { 源槽 = 找源局.值; }
    如果 (源槽 == 0) {
        结果<整64, 整32> 找源参 = 参数槽.获取(右名ID);
        如果 (找源参.正常) { 源槽 = 找源参.值; }
    }
    整64 源指针reg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    如果 (源槽 != 0) {
        如果 (槽是引用(源槽)) {
            IR追加(指令, 建IR指令(IR_加载, 源槽, 0, 0, 源指针reg, T_对象, 0));
        } 否则 {
            IR追加(指令, 建IR指令(IR_取地址, 源槽, 0, 0, 源指针reg, T_整64, 0));
        }
    } 否则 {
        整64 找源静 = 查静态序号含类(右名ID);
        如果 (找源静 < 0) { 返回 假; }
        // 拷贝构造源=T& 传静态槽左值地址（lea .data 槽；宿主 globalStaticClassAssign
        //   「源为顶层类静态：槽地址 = ?gstatic_名 符号地址」同款）
        IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 源指针reg, T_对象, 找源静));
    }
    // ---- 目标旧对象释放（仅**拥有型**目标——RAII 名单判定；返回接收视图等非拥有
    //   形态的旧值属他人，不释放。静态槽长期存活恒拥有）----
    布尔 目标拥有 = 目标是静态;
    如果 (!目标拥有) {
        整64 名i = 0;
        当 (名i < 函数信息.容器变量们.大小()) {
            如果 (函数信息.容器变量们.元素(名i) == 左名ID) {
                目标拥有 = 真;
                中断;
            }
            名i++;
        }
    }
    如果 (目标拥有) {
        整64 旧对象reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        如果 (目标是静态) {
            IR追加(指令, 建IR指令(IR_静态加载, 0, 0, 0, 旧对象reg, T_对象, 查静态序号含类(左名ID)));
        } 否则 如果 (槽是引用(目标槽)) {
            // 引用参数：槽内容 = 调用方变量地址 → 经指针加载旧对象
            整64 目标地reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 目标地reg, T_整64, 0));
            IR追加(指令, 建IR指令(IR_指针加载, 目标地reg, 0, 0, 旧对象reg, T_对象, 0));
        } 否则 {
            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 旧对象reg, T_对象, 0));
        }
        // 空安全（代码生成展开 test/je + ~类(this) + __cn_object_delete）
        // 836-a（070-③ 层③·单独实施）：标签唯一序号——取号并推进寄存器计数
        //   （原固定 0 → 同函数多处 objdel_N_0 撞号·V5 ml64 A2005 铁证；
        //   472-a 只修了部分点·385/701 为遗漏点）。**已全量实证零回归**（534/3）。
        整64 删除标签序 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_删除对象, 旧对象reg, 0, 0, 删除标签序, 0, 左类型ID));
    }
    // ---- 新建独立对象 + 拷贝构造（源 T&）——宿主同款 ----
    整64 对象字节数 = 查结构体大小(左类型ID);
    如果 (左是容器) { 对象字节数 = 容器对象大小(左类型文本); }
    整64 拷贝objreg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 拷贝objreg, 对象字节数, 左类型ID));
    // this=位0、源=位1（拷贝构造 T& 按引用位传左值地址）
    IR追加(指令, 建IR指令(IR_调用实参, 拷贝objreg, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用实参, 源指针reg, 0, 0, 0, 1, 0));
    // 拷贝构造签名=类(类&)（参数串带 &——asm 符号 _A+类型编码，宿主实例
    //   _...映射_A_T... 实证对齐；与 生成容器拷贝构造 同一符号口径）
    IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                          驻留(方法符号(左类型文本, 合成名基名(左类型文本),
                                        左类型文本 + "&"))));
    // ---- 写回目标（引用参数：槽内地址 + 指针存储；静态：静态存储；普通：槽存储）----
    如果 (目标是静态) {
        IR追加(指令, 建IR指令(IR_静态存储, 拷贝objreg, 0, 0, 0, T_整64, 查静态序号含类(左名ID)));
    } 否则 如果 (槽是引用(目标槽)) {
        整64 写回地reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 写回地reg, T_整64, 0));
        IR追加(指令, 建IR指令(IR_指针存储, 写回地reg, 拷贝objreg, 0, 0, T_整64, 0));
    } 否则 {
        IR追加(指令, 建IR指令(IR_存储, 拷贝objreg, 0, 0, 0, 0, 目标槽));
    }
    // 表达式栈清空（本通道不求值右值，防御性归位——对齐 生成结构体整体赋值 尾段）
    当 (表达式栈.大小() > 0) {
        结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈.正常) { 运行时错误(4); }
    }
    返回 真;
}

// 拥有型字符串赋值发射面（172-a 自 生成标识符赋值 机械搬移；172-a 前为
//   生成赋值语句 480~544 段）——返回写回后的值寄存器（字面量/标识符右值
//   经 __cn_str_copy 落堆时换用 copy 寄存器）。
