// CN 自举编译器 v2 · 生成语句（D1 行数整改 172-a 拆分子模块，2026-09-15）
// 职责：赋值语句生成族——自 生成语句.cn 的 生成赋值语句 机械搬移（纯重构零
//   行为变更）：主分派（标识符左值 / 成员·解引用左值）+ 标识符赋值生成
//   （生成标识符赋值）+ 成员·解引用赋值生成（生成成员解引用赋值）+ 三个
//   发射面族（尝试成员结构体整体写 / 发射拥有串赋值 / 发射成员串字段写入）。
//   寄存器/引用参数等权威表经 公开: 访问函数（IR生成 主干）；模块路径=
//   生成语句赋值（新键基）。
导入 容器::向量;
导入 语法;       // Token/AST 节点池（原 导入 语法分析，目录包名）
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 IR生成;     // 控制流辅助/变量类型权威表（同包幂等）
导入 生成声明;    // 语句级变量声明分派（R3 拆分，同包）
导入 IO;         // 221 d225 插桩（打印到错误·验后撤）
导入 IO;         // 760 续诊断插桩用
公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 543（127_v2 LNK2019 根治·2026-10-17）：指针形态类型文本判定——泛型替换后
//   「数据」字段（空类型* → T*）合成名形如「映射$整64$整64*」：*=指针非对象
//   本体但 是容器类 基名判定命中——对象通道旧值释放展开不存在的 ~T* 符号
//   （指针无析构·全链无定义→链接 LNK2019）。836-a/843-a 前置本守卫，指针
//   形态落通用直存（指针值拷贝·所有权由 分配/重新分配 面管理）。
函数 是指针形态ID(整64 类型ID) -> 布尔 {
    // 静默豁免闭集穷举: 类型ID=驻留池下标（正整数闭集）——<=0 为无效哨兵（判定恒假·非指针形态），非业务区间判定。
    如果 (类型ID <= 0) { 返回 假; }
    字符串 名 = 字符串复制(驻留文本(类型ID));
    整64 长 = 字符串长度(名);
    返回 长 > 0 && 字符串比较(字符串子串(名, 长 - 1, 1), "*");
}

// 赋值语句：文本=左值名（标识符槽/静态槽）；文本=0 时 附加=左值表达式起点
//   （解引用/成员/下标左值，按字段宽度存储）。结构体整体赋值经
//   生成结构体整体赋值（第18枚 POD Copy 语义）先行拦截。
// D1 行数整改 172-a：主函数收缩为分派骨架——标识符左值走 生成标识符赋值，
//   成员/解引用左值走 生成成员解引用赋值（行为等价于原单函数双分支）。
不安全 函数 生成赋值语句(向量<节点> 池, 节点 n,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) {
    如果 (n.文本 != 0) {
        生成标识符赋值(池, n, 局部槽, 参数槽, 函数信息,
                       寄存器计数, 槽计数, 表达式栈);
        返回;
    }
    生成成员解引用赋值(池, n, 局部槽, 参数槽, 函数信息,
                       寄存器计数, 槽计数, 表达式栈);
}

// 标识符左值赋值生成（172-a 自 生成赋值语句 分支一 机械搬移）：
//   文本=左值名（局部槽/参数槽/静态槽/类字段/拥有串归一化/引用参数写回）。
不安全 函数 生成标识符赋值(向量<节点> 池, 节点 n,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) {
    向量<IR指令>& 指令 = 函数信息.指令;
    // 070 波G（1026）：类名.静态字段写——赋值节点 文本=字段名·左值区间末=成员
    //  且对象=用户类名+静态字段表命中 → 右值求值+静态槽写（须在 生成左值地址
    //  前拦截——成员链偏移=静态不入对象布局「成员左值字段偏移未知」诊断源）
    如果 (n.子终点 > n.子起点) {
        节点 左末g = 池.元素(整32(n.子终点 - 1));
        如果 (左末g.类型 == 节点_成员 && 左末g.子起点 > 0) {
            节点 对象g = 池.元素(整32(左末g.子起点));
            如果 (对象g.类型 == 节点_标识符 && 是用户类_ID(整64(对象g.文本)) &&
                 查类静态字段合成名(整64(对象g.文本), 整64(左末g.文本)) != 0) {
                整64 序写g2 = 查静态序号含类(查类静态字段合成名(整64(对象g.文本), 整64(左末g.文本)));
                如果 (序写g2 >= 0) {
                    整64 值寄存器g2 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                              指令, 寄存器计数, &函数信息.块计数,
                                              槽计数, 表达式栈);
                    整64 静址g2 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静址g2, T_整64, 序写g2));
                    IR追加(指令, 建IR指令(IR_指针存储, 静址g2, 值寄存器g2, 0, 0, T_整64, 0));
                    当 (表达式栈.大小() > 0) {
                        结果<空类型, 整32> 删栈g2 = 表达式栈.删除(表达式栈.大小() - 1);
                        如果 (!删栈g2.正常) { 运行时错误(4); }
                    }
                    返回;
                }
            }
        }
    }
    // 标识符左值：槽 <- 右值寄存器
    整64 目标槽 = 0;
    结果<整64, 整32> 找槽 = 局部槽.获取(整64(n.文本));
    如果 (找槽.正常) { 目标槽 = 找槽.值; }
    如果 (目标槽 == 0) {
        结果<整64, 整32> 找参 = 参数槽.获取(整64(n.文本));
        如果 (找参.正常) { 目标槽 = 找参.值; }
    }
        如果 (生成结构体整体赋值(池, n, 目标槽, 局部槽, 参数槽, 函数信息,
                                 寄存器计数, 槽计数, 表达式栈)) {
            返回;
        }
        // 346-a（2026-09-18 第 346 轮·T57 根治）：容器/用户类对象整体赋值深拷贝
        //   ——须先于右值求值（本通道自行发射源左值地址，与 生成容器拷贝构造
        //   同口径；右值区间不单独求值）；命中返回真。
        如果 (生成容器对象整体赋值(池, n, 目标槽, 局部槽, 参数槽, 函数信息,
                                 寄存器计数, 槽计数, 表达式栈)) {
            返回;
        }
        // 965（002·30）：合成体（结果/可选）整体赋值——须在普通 生成表达式
        //   通道前拦截（IR_存储 8 字节只写 sret 指针进基址槽 → .正常/.错误
        //   按内联布局读槽=读指针自身字节·ASLR 漂移错值·E2E 30 实证）
        如果 (生成合成体整体赋值(池, n, 目标槽, 局部槽, 参数槽, 函数信息,
                                寄存器计数, 槽计数, 表达式栈)) {
            返回;
        }
    整64 值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
    // 482（#482 多实例独立快照）：赋值位载体处理——右值来源解析（lambda 字面量/
    //   已登记变量/返回来源已知调用）建/复用载体槽+快照拷贝+登记更新；
    //   来源未知=清除陈旧登记（防 p482 重赋值后调用仍展开旧定义点）。
    处理载体点482(池, 整32(n.子终点 - 1), 整64(n.文本), 局部槽, 参数槽,
                 指令, 寄存器计数, 槽计数);
    // 810（053）：128 位目标赋值——左类型 整128/正128：右值=地址句柄（128 位
    //   表达式统一形态）→ 发射128位双半拷贝 到目标槽对（基址槽=局部/参数槽
    //   登记值·低地址低半；静态目标=IR_静态地址 得 .data 槽地址 + IR_结构体
    //   拷贝 16 字节 T96c 双半）。右值=64 位值（字面量/窄表达式）→ 拆半物化
    //   （解析128位初值文本 two's complement·与声明初值同源逻辑）。
    {
        整64 左类型ID128 = 解析标识符类型ID(整64(n.文本));
        字符串 左类型文本128 = 左类型ID128 > 0 ?
            字符串复制(驻留文本(左类型ID128)) : 字符串复制("");
        如果 (字符串比较(左类型文本128, "整128") ||
             字符串比较(左类型文本128, "正128")) {
            整64 源码128 = 查寄存器类型(值寄存器);
            如果 (目标槽 != 0) {
                // 466：**引用参数目标分流**——引用槽内容=调用方左值地址，128 写
                //   须落 发射引用参数128写（调用方 16 字节对象全宽双段写·宿主
                //   i128 引用同构）。修前两态皆错：句柄右值落 发射128位双半拷贝
                //   写**本地槽对**（覆盖引用槽内地址+相邻槽=内存破坏）；窄值右值
                //   误诊断拒绝（宿主 `v = 5` 符号扩展写全宽合法语义）。
                如果 (槽是引用(目标槽)) {
                    发射引用参数128写(目标槽, 值寄存器,
                                      字符串比较(左类型文本128, "正128") ? 0 : 1,
                                      指令, 寄存器计数, 槽计数);
                } 否则 如果 (源码128 == T_整128 || 源码128 == T_正128) {
                    发射128位双半拷贝(值寄存器, 目标槽, 目标槽 - 1,
                                      指令, 寄存器计数);
                } 否则 {
                    // 418（002 收口杂项正测族·810 注释既定语义落地）：右值=64 位值
                    //   （字面量/窄表达式）→ 拆半物化双槽（物化128位操作数·字面量
                    //   回扫拆半/符号扩展高半）后 双半拷贝。原直落诊断：18_缺陷修复
                    //   实录「大数 = 999」（整128 变量赋整字面量）IR 层中止——
                    //   该用例修前在语义层 lambda 误报处中止，本面从未跑到。
                    整64 物化句柄128 = 物化128位操作数(值寄存器, T_整64,
                        字符串比较(左类型文本128, "整128") ? 1 : 0,
                        指令, 寄存器计数, 槽计数);
                    发射128位双半拷贝(物化句柄128, 目标槽, 目标槽 - 1,
                                      指令, 寄存器计数);
                }
            } 否则 {
                整64 找静128 = 查静态序号含类(整64(n.文本));
                如果 (找静128 >= 0) {
                    整64 静地址128 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静地址128,
                                         T_整64, 找静128));
                    // 479（473 采样轮·c4 探针实锚）：右值=64 位值（常量/窄
                    //   表达式）先拆半物化再块拷——128 位值模型=地址句柄，原把
                    //   64 位值寄存器直接当源地址传 IR_结构体拷贝 → rep movsb
                    //   从值地址读 16 字节 = SEGV（静态 整128 甲 = 5; 甲 = 7;
                    //   即崩·473 p4 形态残留）。与目标槽 466 分流的拆半物化
                    //   分支同构（字面量回扫拆半/符号扩展高半）。
                    整64 源静写128 = 查寄存器类型(值寄存器);
                    如果 (源静写128 != T_整128 && 源静写128 != T_正128) {
                        值寄存器 = 物化128位操作数(值寄存器, T_整64,
                            字符串比较(左类型文本128, "整128") ? 1 : 0,
                            指令, 寄存器计数, 槽计数);
                    }
                    IR追加(指令, 建IR指令(IR_结构体拷贝, 值寄存器, 静地址128, 0, 0,
                                         16, 0));
                } 否则 {
                    // 810（053）：方法体字段目标（裸字段名 数 = 初始·构造器/方法内）
                    //   ——字段地址 + IR_结构体拷贝 16 字节（T96c 双半）；原实现
                    //   静默吞掉整条语句（只求值不写·420-③ 构造器 asm 空实证）。
                    整64 字段偏移128 = 当前方法字段偏移(整64(n.文本));
                    如果 (字段偏移128 >= 0) {
                        整64 字段地址128 = 发射类字段地址(字段偏移128, 指令, 寄存器计数);
                        // 479 同族：右值 64 位值先拆半物化（静态分支同病同修）
                        整64 源字写128 = 查寄存器类型(值寄存器);
                        如果 (源字写128 != T_整128 && 源字写128 != T_正128) {
                            值寄存器 = 物化128位操作数(值寄存器, T_整64,
                                字符串比较(左类型文本128, "整128") ? 1 : 0,
                                指令, 寄存器计数, 槽计数);
                        }
                        IR追加(指令, 建IR指令(IR_结构体拷贝, 值寄存器, 字段地址128,
                                             0, 0, 16, 0));
                    } 否则 {
                        // 兜底显式诊断（禁静默降级——宁严勿松）
                        IR层诊断("128 位赋值目标未解析（非局部/参数/静态/字段）: " +
                                 驻留文本(整64(n.文本)));
                    }
                }
            }
            当 (表达式栈.大小() > 0) {
                结果<空类型, 整32> 删栈128 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删栈128.正常) { 运行时错误(4); }
            }
            返回;
        }
    }
    // T69（480-a 深度机）：赋值右值位函数名收口——`f = 减;`（函数指针变量赋值
    //   函数名）右值=函数名（负占位）→ IR_函数地址
    值寄存器 = 值位函数名收口480(值寄存器, 指令, 寄存器计数);
    // 第七十八轮（2026-09-12）：方法体字段左值赋值（字段名裸标识符——局部/参数
    //   未命中；this 槽加载 + 字段地址 + 指针存储）。结构体类型字段整体赋值=
    //   第一版边界（显式拒绝——8 字节指针存储会静默截断 >8 字节结构体）
    如果 (目标槽 == 0 && 值寄存器 != 0) {
        整64 字段偏移z = 当前方法字段偏移(整64(n.文本));
        如果 (字段偏移z >= 0) {
            整64 字段类型z = 查字段类型ID(当前方法类名ID, 整64(n.文本));
            // 595-a（001-001 双模收敛·根因6）：容器字段排除出结构体整体赋值
            //   通道（506-a 于 尝试成员结构体整体写 的同款守卫补齐到裸名通道
            //   ·侦察根因6）。撤守卫态容器字段类型入结构体大小表 → 原翻转走
            //   发射结构体整体拷贝（句柄+padding 浅拷 24/56/64 字节·绕过旧值
            //   删除/深拷）；容器字段=句柄槽 → 指针存储（下方 ·与生产态同位
            //   同路径）。
            // 106 守卫（指针字段排除）：字段类型表存**真类型**（321 星号规范化
            //   ·带尾星）——「T* 字段」克隆后=「可选$整32*」等形态，是结果类型
            //   的基名判定不剥星（可选$ 前缀命中）→ 指针字段误入整体写=把
            //   源值当地址 rep movsb（F1 向量构造「数据 = 无」从地址 0 拷 16B
            //   段错误 rc=139 实锤）。查结构体大小 对带星文本=0（键基不剥星）
            //   → 旧条件对指针字段恒假，仅 106 新加部分需星守卫。
            布尔 合成体字段z106 = 假;
            如果 (字段类型z != 0 && 是结果类型(驻留文本(字段类型z))) {
                合成体字段z106 = 真;
                字符串 字段文本z106 = 字符串复制(驻留文本(字段类型z));
                如果 (字符串长度(字段文本z106) > 0 &&
                     整64(字段文本z106[字符串长度(字段文本z106) - 1]) == 42) {
                    合成体字段z106 = 假;
                }
            }
            如果 (字段类型z != 0 && !是容器类(驻留文本(字段类型z)) &&
                 (查结构体大小(字段类型z) != 0 || 合成体字段z106)) {
                // 508-a（T70 B1 三层④）：**类字段（结构体类型）整体赋值**由
                //   fail-fast 改实现（原「暂不支持」诊断+运行时错误(6) 主动中止
                //   ——撤守卫态 stdlib 克隆体触发实证 228/441/442·gdb 栈帧
                //   =生成语句赋值$生成标识符赋值）。语义对齐 生成结构体整体赋值/
                //   尝试成员结构体整体写：目标=字段地址（发射类字段地址·this
                //   槽基址）→ 整体拷贝（深拷=真·字段旧串 preFree=真）。
                //   源地址取法（右值已由上方 生成表达式 求值——避免二次求值副作用）：
                //     · 标识符/成员链 → 生成左值地址（place 地址·无副作用重算；
                //       标识符直通求值产物=首槽值非结构体地址）
                //     · 调用/三元/结构体字面量 → 求值产物即结构体地址
                //       （调用=物化槽〔结构体返回临时们〕·三元=聚合地址透传
                //       〔86-a〕·字面量=物化临时槽〔84-a〕）
                节点 右末z = 池.元素(整32(n.子终点 - 1));
                整64 源地址z = 值寄存器;
                如果 (右末z.类型 == 节点_标识符 || 右末z.类型 == 节点_成员) {
                    源地址z = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                           指令, 寄存器计数, &函数信息.块计数,
                                           槽计数, 表达式栈);
                }
                整64 目标地址z = 发射类字段地址(字段偏移z, 指令, 寄存器计数);
                如果 (目标地址z != 0 && 源地址z != 0) {
                    // 106（890 残余·泛型方法实参面·连带根治）：尺寸取宽——
                    //   普通结构体字段=查结构体大小（深拷通道不变）；合成体
                    //   （结果/可选·结构体大小表未登记带 ·结果大小 单点）=
                    //   显式宽度 IR_结构体拷贝（标量载荷无资源深拷义务·原落
                    //   标量指针存储=写 8 字节源地址：探针 B 泛型类 值槽=形参
                    //   写 地址→读回 32767/D1b=-1 实测）。
                    如果 (查结构体大小(字段类型z) != 0) {
                        发射结构体整体拷贝(函数信息, 寄存器计数, 目标地址z,
                                          源地址z, 字段类型z, 真, 真);
                    } 否则 {
                        IR追加(指令, 建IR指令(IR_结构体拷贝, 源地址z, 目标地址z,
                              0, 0, 结果大小(驻留文本(字段类型z)), 0));
                    }
                }
                当 (表达式栈.大小() > 0) {
                    结果<空类型, 整32> 删栈整z = 表达式栈.删除(表达式栈.大小() - 1);
                    如果 (!删栈整z.正常) { 运行时错误(4); }
                }
                返回;
            }
            // 836-a（070-③ 层②·窄面）：容器/用户类**字段** ← **成员链右值**
            //   （`X.字段 = Y.字段`·V7 形态）深拷通道：字段地址+释放旧（空安全）
            //   +新对象+拷贝构造+写回（与 346-a/833 层① 同款）。**仅成员链**——
            //   835 全开（标识符 OR 成员链）实测 5 新红链接回归 → 收窄
            //   （标识符右值形态维持原通道·零行为变更）。**已全量实证零回归**（534/3）。
            {
                节点 右末z2 = 池.元素(整32(n.子终点 - 1));
                // 543 守卫：指针形态排除（同 843-a·见 是指针形态ID 头注）。
                如果 (字段类型z != 0 && !是指针形态ID(字段类型z) && 右末z2.类型 == 节点_成员 &&
                    (是容器类(驻留文本(字段类型z)) || 是用户类(驻留文本(字段类型z)))) {
                    字符串 字段文本f = 字符串复制(驻留文本(字段类型z));
                    整64 目标地址f = 发射类字段地址(字段偏移z, 指令, 寄存器计数);
                    整64 源地址f = 生成左值地址(池, 整32(n.子起点), 整32(n.子终点),
                                                 局部槽, 参数槽, 指令, 寄存器计数,
                                                 &函数信息.块计数, 槽计数, 表达式栈);
                    整64 旧对象f = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_指针加载, 目标地址f, 0, 0, 旧对象f, T_对象, 0));
                    整64 删标f = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_删除对象, 旧对象f, 0, 0, 删标f, 0, 字段类型z));
                    整64 对象字节f = 查结构体大小(字段类型z);
                    如果 (是容器类(字段文本f)) { 对象字节f = 容器对象大小(字段文本f); }
                    整64 新对象f = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新对象f, 对象字节f, 字段类型z));
                    // 543-d（2026-10-14·与 724 段同批·728x 分支同步同内容）：无显式
                    //   拷贝构造用户类→合成逐位拷贝（指针加载源本体+结构体拷贝）——
                    //   原恒发拷贝构造调用，无拷贝构造类=悬空外部 LNK2019（918 同族
                    //   预防）。
                    如果 (是用户类(字段文本f) && 查类拷贝构造串(字段类型z) == 0) {
                        整64 源本体f = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_指针加载, 源地址f, 0, 0, 源本体f,
                                             T_对象, 0));
                        IR追加(指令, 建IR指令(IR_结构体拷贝, 源本体f, 新对象f, 0, 0,
                                             对象字节f, 0));
                    } 否则 {
                        IR追加(指令, 建IR指令(IR_调用实参, 新对象f, 0, 0, 0, 0, 0));
                        IR追加(指令, 建IR指令(IR_调用实参, 源地址f, 0, 0, 0, 1, 0));
                        IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                                              驻留(方法符号(字段文本f, 合成名基名(字段文本f),
                                                            字段文本f + "&"))));
                    }
                    IR追加(指令, 建IR指令(IR_指针存储, 目标地址f, 新对象f, 0, 0, T_整64, 0));
                    当 (表达式栈.大小() > 0) {
                        结果<空类型, 整32> 删栈f = 表达式栈.删除(表达式栈.大小() - 1);
                        如果 (!删栈f.正常) { 运行时错误(4); }
                    }
                    返回;
                }
            }
            // 843-a（070-③ 十一轮·842 根因定案实施；543 接管修正 2026-10-14）：
            //   容器/用户类字段 ← **构造调用右值**（`表 = 向量<字符串>()`）。
            //   原口径「构造调用物化在栈→字段须堆化（IR_分配对象+IR_结构体拷贝）」
            //   已随求值通道演进失效：现构造调用求值产物=**堆句柄**（生成表达式
            //   求值中.cn 容器构造分支=IR_分配对象+构造调用+句柄压栈·用户类
            //   发射用户类构造 同）——堆化反而三重病：①求值产物 S 壳被浅拷后
            //   无人释放（每赋值恒漏 1 壳·p719v 探针 W2 残 1+asm 3 new 1 delete
            //   铁证）；②浅拷共享隐患（非空字段双释放）；③白费一次分配拷贝。
            //   修=**句柄接管直写**（S 无别名·调用方唯一持有）+ 写前释放旧值
            //   （836-a 同款·删除对象 空安全）——860-a 序言级联已对有默认构造
            //   类字段 分配对象+默认构造+写槽，不释放=级联壳被覆盖漏（719 v2
            //   四形态残 2/2/2/4 主源；459 批甲临时合流前壳不进 活动分配数
            //   检测面不可见）。宿主同批撤 145-a 跳过（ir_oop_field.cpp
            //   handleClassFieldAssign / ir_expr_assign.cpp
            //   memberClassFieldAssign）。
            {
                节点 右末c = 池.元素(整32(n.子终点 - 1));
                // 543 守卫：指针形态排除（见 是指针形态ID 头注——127_v2 LNK2019
                //   根治：泛型「数据」字段 T* 误入对象通道=旧值释放展开不存在的 ~T*）。
                如果 (字段类型z != 0 && !是指针形态ID(字段类型z) && 右末c.类型 == 节点_调用 &&
                    (是容器类(驻留文本(字段类型z)) || 是用户类(驻留文本(字段类型z)))) {
                    整64 地址c = 发射类字段地址(字段偏移z, 指令, 寄存器计数);
                    整64 旧对象c = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_指针加载, 地址c, 0, 0, 旧对象c, T_对象, 0));
                    整64 删标c = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_删除对象, 旧对象c, 0, 0, 删标c, 0, 字段类型z));
                    IR追加(指令, 建IR指令(IR_指针存储, 地址c, 值寄存器, 0, 0, T_整64, 0));
                    当 (表达式栈.大小() > 0) {
                        结果<空类型, 整32> 删栈c = 表达式栈.删除(表达式栈.大小() - 1);
                        如果 (!删栈c.正常) { 运行时错误(4); }
                    }
                    返回;
                }
            }
            整64 地址z = 发射类字段地址(字段偏移z, 指令, 寄存器计数);
            // 644-b（2026-10-16·52_library 云端红根治·宿主/v2 同构）：字符串
            //   实例字段直访赋值 79-a 同款来源分级归一化（与 发射成员串字段
            //   写入 同构·宿主 handleClassFieldAssign 644-b 对称）——原形态
            //   值寄存器句柄直存（指针存储裸写）=字段接管右值句柄，与 644
            //   传参位串临时 flush 冲突（构造器 形参直存字段+调用方 flush=
            //   字段悬空·52_library ISBN 全空铁证；基线靠「调用方不 flush」
            //   侥幸配对=每调用净泄 1）。分级：字面量=驻留直存（释放侧空
            //   安全）；拥有返回调用=接管直存（新串无主）；其余（形参/局部/
            //   成员链借出）=__cn_str_copy 落堆深拷。旧值释放：非构造内=
            //   free+清槽幂等（重赋值语义·分配对象 calloc 零初始化+空安全
            //   双保险）；构造内=初始化语义豁免（145-a 同规）。复合赋值 +=
            //   语法层已重析为二元落本分支=释放旧值（对齐 发射拥有串赋值
            //   ②口径·与宿主唯一有意差别取更安全侧·346-a 先例）。
            如果 (字段类型z != 0 && 字符串比较(驻留文本(字段类型z), "字符串")) {
                节点 右末zb = 池.元素(整32(n.子终点 - 1));
                布尔 需复制zb = 真;
                如果 (右末zb.类型 == 节点_字符串字面量) { 需复制zb = 假; }
                否则 如果 (右末zb.类型 == 节点_调用 && 右末zb.子起点 > 0) {
                    节点 被调zb = 池.元素(整32(右末zb.子起点));
                    如果 (被调zb.类型 == 节点_标识符) {
                        整64 被调名zb = 整64(被调zb.文本);
                        布尔 白名单zb = 被调名zb == 驻留("字符串复制") ||
                                      被调名zb == 驻留("字符串连接") ||
                                      被调名zb == 驻留("字符串拼接") ||
                                      被调名zb == 驻留("字符串子串") ||
                                      被调名zb == 驻留("字符串大写") ||
                                      被调名zb == 驻留("字符串小写") ||
                                      被调名zb == 驻留("字符串修剪") ||
                                      被调名zb == 驻留("字符串反转");
                        如果 (!白名单zb && 查函数返回回退(被调名zb) == 驻留("字符串")) {
                            白名单zb = 真;   // A2 契约：签名即契约
                        }
                        需复制zb = !白名单zb;
                    }
                }
                如果 (需复制zb) {
                    值寄存器 = 发射字符串复制调用(指令, 寄存器计数, 值寄存器);
                }
                如果 (!(当前方法类名ID > 0 &&
                        取当前方法名ID() == 驻留(合成名基名(
                            字符串复制(驻留文本(当前方法类名ID)))))) {
                    整64 旧zb = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_指针加载, 地址z, 0, 0, 旧zb, T_字符串, 0));
                    IR追加(指令, 建IR指令(IR_调用实参, 旧zb, 0, 0, 0, 0, 0));
                    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                         驻留("__cn_str_free")));
                    如果 (函数信息.零寄存器 != 0) {
                        IR追加(指令, 建IR指令(IR_指针存储, 地址z,
                                     函数信息.零寄存器, 0, 0, T_整64, 0));
                    }
                }
                整64 存宽zb = 查字段宽度码(当前方法类名ID, 整64(n.文本));
                IR追加(指令, 建IR指令(IR_指针存储, 地址z, 值寄存器, 0, 0, 存宽zb, 0));
                当 (表达式栈.大小() > 0) {
                    结果<空类型, 整32> 删栈zb = 表达式栈.删除(表达式栈.大小() - 1);
                    如果 (!删栈zb.正常) { 运行时错误(4); }
                }
                返回;
            }
            // 463：裸字段写宽度分派按字段类型码（布局实宽〔413-c 8/8 翻开〕下
            //   恒 qword 8 字节写穿相邻窄字段·#370 同域根治——与成员链写通道
            //   取成员宽度码/裸字段读侧 发射类字段读取 查字段宽度码 同源对称；
            //   未登记防御 T_整64=旧行为）
            整64 存宽z = 查字段宽度码(当前方法类名ID, 整64(n.文本));
            IR追加(指令, 建IR指令(IR_指针存储, 地址z, 值寄存器, 0, 0, 存宽z, 0));
            当 (表达式栈.大小() > 0) {
                结果<空类型, 整32> 删栈z = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删栈z.正常) { 运行时错误(4); }
            }
            返回;
        }
    }
    // 静态槽赋值（2026-09-06 根治，缺陷零容忍）：目标非局部/参数时查
    //   静态序号表——命中则 IR_静态存储 写回 .data 槽。原实现此处仅认
    //   局部/参数槽，静态目标「目标槽==0」静默丢存储（探针 计数器 =
    //   计数器 + 阶段(5) 打印恒 0 实证）——防御分支静默降级家族成员，
    //   与 发射自增自减 的静态读写对（②c C）同款设施补齐
    如果 (目标槽 == 0 && 值寄存器 != 0) {
        整64 找静赋 = 查静态序号含类(整64(n.文本));
        如果 (找静赋 < 0) {
            // 434（类名::静态字段 限定写·#284 ::矩阵第五态）：限定复合名回退——
            //   复合赋值（+=/-=·解析表达式兜底语句 脱糖「文本=左名」纯标识符
            //   形态）落本通道，静态段原只认 查静态序号含类=限定名写静默丢
            //   （709 探针 `计数器::总数 += 8` 读回不变实录）——查限定名静态
            //   序号 单点分派（语句普通赋值走 生成成员解引用赋值 通道·两者
            //   同落「类$字段」槽零分叉）
            找静赋 = 查限定名静态序号(整64(n.文本));
        }
        如果 (找静赋 >= 0) {
            // 87-a（2026-09-12 第八十七轮）：静态**字符串**——drop 旧 + 来源分级
            //   归一化（借用来源 __cn_str_copy 落堆）；其余静态类型（标量值/
            //   容器类句柄）保持 8 字节直存（指针槽模型）。
            如果 (字符串比较(驻留文本(取静态类型(找静赋)), "字符串")) {
                值寄存器 = 归一化静态串赋值(池, n, 值寄存器, 找静赋, 函数信息,
                                            寄存器计数);
            }
            // 641（修复轮）：存储宽度码=标量值语义精确码（静态值码641——
            //   整8/整16/整32 精确窄写；字符串/容器/类等非窄类型回 类型码()
            //   原值落 8 字节槽语义）。与读点（生成表达式.cn 静载码641）
            //   宽度成对。
            IR追加(指令, 建IR指令(IR_静态存储, 值寄存器, 0, 0, 0,
                                 静态值码641(取静态类型(找静赋)), 找静赋));
        }
    }
    // plans/019 阶段4' 第二批（2026-09-11 方案A）：拥有型字符串赋值——宿主
    //   第一批复核同构 + Rust 赋值语义（先 drop 旧再 move 新）：目标=字符串
    //   且在拥有名单且未污染时：①右值=字面量/标识符 → free 旧 + __cn_str_copy
    //   落堆（变量恒拥有堆串）；②右值=白名单八函数调用/二元拼接（+ 产物恒
    //   堆，复合赋值 += 语法层已重析为二元）→ free 旧 + 直存；③其余形态
    //   （非白名单调用/下标/成员等借用源）→ free 旧（旧值必为拥有——拥有链
    //   维护，drop 后零泄漏，优于宿主保守面）+ 污染退出 RAII + 直存。
    //   free 旧空安全（未赋值路径槽=0——预扫入口零初始化）。
    // 172-a：发射面自本函数提取为 发射拥有串赋值（返回写回后的值寄存器）。
    值寄存器 = 发射拥有串赋值(池, n, 目标槽, 值寄存器, 函数信息, 指令, 寄存器计数);
    如果 (值寄存器 != 0 && 目标槽 != 0) {                    如果 (槽是引用(目标槽)) {
            // ②c D：引用参数赋值——Load 槽得调用方左值地址，指针写回
            // 425：宽度码按登记引用类型（窄整族 4/2/1 字节写——原恒 T_整64
            //   整32& 写 8 字节过写相邻数组元素·55_reference 表[1] 清零实录）
            整64 地址reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 地址reg, T_整64, 0));
            IR追加(指令, 建IR指令(IR_指针存储, 地址reg, 值寄存器, 0, 0,
                                  引用参数存储码(目标槽), 0));
        } 否则 {
            // 46-f 第五十轮：正32 目标存储前截断——565 轮 T33 残余根治换接
            //   窄宽值规范化（整8/整16/正8/正16/整32 回绕+符号扩展·正32 位与
            //   原路径·单一事实源在 生成声明）；非窄宽零开销直通。指针变量
            //   （查指针变量类型 命中·标量类型表按基类型登记）跳过=地址非窄值
            //   （194 正8* 实锤教训）
            整64 赋目标类型 = 查当前函数变量类型(整64(n.文本));
            如果 (查指针变量类型(整64(n.文本)) < 0) {   // <0=未登记指针（-1 哨兵）·真指针跳过
                值寄存器 = 窄宽值规范化(窄宽码自文本(驻留文本(赋目标类型)), 值寄存器,
                                        指令, 寄存器计数);
            }
            值寄存器 = 浮点宽化存储(驻留文本(赋目标类型), 值寄存器, 指令, 寄存器计数);
            // 814（053-001）：64 位目标赋值收到 128 位值→隐式窄化低半（同上）
            值寄存器 = 隐式窄化到64(值寄存器, 指令, 寄存器计数);
            IR追加(指令, 建IR指令(IR_存储, 值寄存器, 0, 0, 0, 0, 目标槽));
        }
    }
    // 清空表达式栈（右值 残留）
    当 (表达式栈.大小() > 0) {
        结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈.正常) { 运行时错误(4); }
    }
}

// 346-a（2026-09-18 第 346 轮·T57 根治）：容器/用户类对象「赋值语句」深拷贝
//   语义——对齐宿主 identifierClassCopyAssign（src/cn_compiler/ir/ir_expr_assign_ident.cpp:239）
//   与 globalStaticClassAssign（同文件 159）：宿主 IR 铁证 `乙 = 甲` 发射
//   「新建对象 + 拷贝构造（源 T& 左值地址）+ 存储新对象指针」。
//   v2 原实现落 生成标识符赋值 底部 8 字节句柄浅覆盖：赋值后两变量共享同一堆
//   对象、双方 RAII 出口各自析构 = **双释放 UAF**（探针 p8=无引用参数无结构体的
//   最小形态：宿主 rc=0 逐行正确 vs v2 rc=139 段错误；p4 向量引用参数 / p6
//   结构体容器字段同族——asm 铁证 `mov qword ptr [r10], r11` 把新对象指针覆盖进
//   调用方变量槽、被调方局部新对象随即析构 → 调用方悬垂）。
//   与宿主的唯一有意差别：目标**拥有**旧对象时先释放（Rust `a = b` drop 旧值
//   语义；宿主当前不释放=宿主侧泄漏面·按「安全零容忍」取更安全侧）。
//   形态守卫（任一不满足=返回假，落原路径零行为变更）：左值类型 ∈ {容器类, 用户类}
//   且右值末节点=标识符（局部/参数/静态）且源类型同类。
不安全 函数 生成容器对象整体赋值(向量<节点> 池, 节点 n, 整64 目标槽,
                        映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                        函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                        向量<整64>& 表达式栈) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    整64 左名ID = 整64(n.文本);
    // 234（2026-10-06·91303）：指针变量排除——左值是指针（登记指针变量类型
    //   表命中·含 类指针 形态）=句柄赋值（同地址语义），不走 值深拷通道。
    //   原 剥星类型解析（双轨坑 B）把 `形状* p = b` 当 类值赋值→分配+拷贝
    //   构造（asm 铁证 形状$形状_A_T形状·p 语义变 拷贝副本=指针语义破坏）。
    // 234 修正（441 预验红甄别）：排除仅限「所指类型=用户类」的指针左值
    //   （类指针赋值=句柄·指针语义）——stdlib 容器源码内部字段（数据/元素
    //   数量/数组容量·所指=元素/标量）同表命中但不排除（原值深拷语义保持·
    //   误排=容器拷贝构造全坏·A2 垃圾铁证）
    整64 所指查p = 查指针变量类型(左名ID);
    如果 (所指查p != 0 && 是用户类_ID(所指查p)) { 返回 假; }
    整64 左类型ID = 解析标识符类型ID(左名ID);
    如果 (左类型ID == 0) { 返回 假; }
    字符串 左类型文本 = 字符串复制(驻留文本(左类型ID));
    布尔 左是容器 = 是容器类(左类型文本);
    布尔 左是用户类 = 是用户类(左类型文本);
    如果 (!左是容器 && !左是用户类) { 返回 假; }
    // 234：跨类层级赋值守卫——源类型与目标同类才走深拷；派生→基类值=切片拒绝
    //   应在语义层报错（614 形态），生成层不合成（此处 首标识符右值 的源类
    //   沿链判定：派生→基类 返回假 落句柄赋值=引用语义错误面，宁可显式诊断）
    如果 (n.子起点 < n.子终点) {
        节点 右首探 = 池.元素(整32(n.子终点 - 1));
        如果 (右首探.类型 == 节点_标识符 && 是用户类_ID(整64(右首探.文本))) {
            整64 右类探 = 整64(右首探.文本);
            如果 (右类探 != 左类型ID && 是用户类_ID(左类型ID) &&
                 是否派生自(右类探, 左类型ID)) {
                返回 假;
            }
        }
    }
    如果 (n.子起点 >= n.子终点) { 返回 假; }
    节点 右末 = 池.元素(整32(n.子终点 - 1));
    // 963（008 总攻·v2 转移扩面）：**赋值位转移**（乙 = 转移(甲)）——右值=
    //   转移(单标识符) 调用时走句柄直交（跳过深拷）：①目标拥有旧对象先删
    //   （拥有型判定+IR_删除对象 空安全）；②源槽句柄 IR_存储 直入目标槽；
    //   ③源槽清零（源出口析构跳过=所有权交接·宿主 933 同模型）。
    如果 (右末.类型 == 节点_调用 && 右末.附加 == 1 && 右末.子起点 >= 0) {
        节点 赋被调963 = 池.元素(整32(右末.子起点));
        节点 赋实参963 = 池.元素(整32(右末.子起点) + 1);
        如果 (赋被调963.类型 == 节点_标识符 &&
             赋实参963.类型 == 节点_标识符 &&
             字符串比较(驻留文本(整64(赋被调963.文本)), "转移")) {
            整64 转源名963 = 整64(赋实参963.文本);
            如果 (转源名963 != 左名ID) {
                布尔 静963 = 假;
                如果 (目标槽 == 0 && 查静态序号含类(左名ID) >= 0) { 静963 = 真; }
                如果 (目标槽 != 0 || 静963) {
                    // ① 目标旧对象释放（拥有型：容器名单/静态恒拥有）
                    布尔 目标拥有963 = 静963;
                    如果 (!目标拥有963) {
                        整64 名m963 = 0;
                        当 (名m963 < 函数信息.容器变量们.大小()) {
                            如果 (函数信息.容器变量们.元素(名m963) == 左名ID) {
                                目标拥有963 = 真;
                                中断;
                            }
                            名m963++;
                        }
                    }
                    如果 (目标拥有963) {
                        整64 旧obj963 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        如果 (静963) {
                            整64 静序963 = 查静态序号含类(左名ID);
                            IR追加(指令, 建IR指令(IR_静态加载, 0, 0, 0, 旧obj963,
                                                 T_对象, 静序963));
                        } 否则 {
                            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 旧obj963,
                                                 T_对象, 0));
                        }
                        IR追加(指令, 建IR指令(IR_删除对象, 旧obj963, 0, 0,
                                             寄存器计数[0], 0, 左类型ID));
                        寄存器计数[0] = 寄存器计数[0] + 1;
                    }
                    // ② 源句柄加载（局部/参数槽）
                    整64 转源槽963 = 0;
                    结果<整64, 整32> 查局963 = 局部槽.获取(转源名963);
                    如果 (查局963.正常) { 转源槽963 = 查局963.值; }
                    如果 (转源槽963 == 0) {
                        结果<整64, 整32> 查参963 = 参数槽.获取(转源名963);
                        如果 (查参963.正常) { 转源槽963 = 查参963.值; }
                    }
                    如果 (转源槽963 != 0) {
                        整64 句柄963 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_加载, 转源槽963, 0, 0,
                                             句柄963, T_对象, 0));
                        如果 (静963) {
                            整64 静写963 = 寄存器计数[0];
                            寄存器计数[0] = 寄存器计数[0] + 1;
                            整64 静序w963 = 查静态序号含类(左名ID);
                            IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静写963,
                                                 T_整64, 静序w963));
                            IR追加(指令, 建IR指令(IR_指针存储, 静写963, 句柄963,
                                                 0, 0, T_整64, 0));
                        } 否则 {
                            IR追加(指令, 建IR指令(IR_存储, 句柄963, 0, 0, 0, 0,
                                                 目标槽));
                        }
                        // ③ 源槽清零（出口析构跳过=所有权交接）
                        整64 零963 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零963,
                                             T_整64, 0));
                        IR追加(指令, 建IR指令(IR_存储, 零963, 0, 0, 0, 0,
                                             转源槽963));
                        当 (表达式栈.大小() > 0) {
                            结果<空类型, 整32> 删963 = 表达式栈.删除(表达式栈.大小() - 1);
                            如果 (!删963.正常) { 运行时错误(4); }
                        }
                        返回 真;
                    }
                }
            }
        }
    }
    // 544（458 呈报·赋值位形态①·独立函数守函数行数红线）：类目标 ←
    //   「返回类对象的调用」（普通调用/方法调用）产物 → 位拷物化接管+旧值释放
    如果 (左是用户类 && !左是容器 &&
        赋值接管返回类调用544(池, n, 目标槽, 左名ID, 左类型ID, 指令, 局部槽,
                            参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈)) {
        返回 真;
    }
    // 630（544 呈报·容器接收面·赋值位形态）：类目标 ←「容器元素类返回调用」
    //   ——产物=拷贝构造副本堆句柄（生成表达式求值中 容器分支 630 副本生成·
    //   对齐宿主元素() 副本语义）→ 旧值释放+直存/静态·引用写回（821 旧值段
    //   复用）；不得落 544/821 的「NewObject+结构体拷贝」（那以产物=帧内本体
    //   为前提，对堆句柄会误拷）。
    如果 (左是用户类 && !左是容器 &&
        赋值接管容器元素类返回630(池, n, 目标槽, 左名ID, 左类型ID, 指令, 局部槽,
                    参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈)) {
        返回 真;
    }
    // 633（632 同根·赋值位扩面；928 口径更新）：类目标 ← 引用返回调用
    //   （甲 = 取货(源)）——回扫 IR_指针加载 取 rax（被引用左值地址）→
    //   NewObject+拷贝构造深拷 → 旧值释放 → 直存（实现在 生成类返回接管.cn
    //   ——与声明位 632 同判定手法：回扫命中=普通函数引用返回；miss 面按
    //   是方法引用返回928 识别=方法引用返回〔读值=rax 直传〕；值返回值调用
    //   自然落 472 既有通道）。928 生产端对齐后函数/方法 rax 同层——hold
    //   槽物化与分档撤销（分流消除）。
    //   容器面（#633 残面④b）：左=容器族同走（深拷=容器拷贝构造）
    如果 ((左是用户类 || 左是容器) &&
        赋值接管引用返回类调用633(池, n, 目标槽, 左名ID, 左类型ID, 指令, 局部槽,
                    参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈)) {
        返回 真;
    }
    如果 (右末.类型 == 节点_调用) {
        // 841-a（070-③ 九轮·**右值求值单点化**·Rust「求值一次 + 移动/克隆」对照）：
        //   472-a 窄域守卫**前移**——目标槽=0 且非静态（方法字段·不可定位）时
        //   **先返回假·不执行右值求值**。原顺序（求值物化① → 守卫返回假 → 原路径
        //   再求值物化②）右值被求值两次·**物化① 泄漏**（840 asm 铁证：`盒子$盒子`
        //   两次 `__cn_object_new`+两次向量构造）。
        布尔 静472 = 假;
        如果 (目标槽 == 0 && 查静态序号含类(左名ID) >= 0) { 静472 = 真; }
        // 472-a（窄域守卫·与标识符分支既有守卫对齐）：目标槽=0 且非静态=
        //   目标不可定位（类构造内裸字段名重置形态·228 实证：记录 = 向量<字符串>()
        //   的 记录=类字段·局部槽/静态均无→存槽 0=写穿→空指针）→返回 假 交回
        //   原路径（字段写通道·生产态既有绿）。
        如果 (目标槽 == 0 && !静472) { 返回 假; }
        // 472-a：T57 分支重接入（守卫通过后**单次**求值·物化唯一）
        整64 前深度472 = 表达式栈.大小();
        整64 消费472 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽, 指令,
                                寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
        如果 (消费472 == 0 || 表达式栈.大小() <= 前深度472) { 返回 假; }
        整64 新对象472 = 表达式栈.元素(表达式栈.大小() - 1);
        当 (表达式栈.大小() > 前深度472) {
            结果<空类型, 整32> 删弹472 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删弹472.正常) { 运行时错误(4); }
        }
        布尔 拥有472 = 静472;
        如果 (!拥有472) {
            整64 名j472 = 0;
            当 (名j472 < 函数信息.容器变量们.大小()) {
                如果 (函数信息.容器变量们.元素(名j472) == 左名ID) {
                    拥有472 = 真;
                    中断;
                }
                名j472++;
            }
        }
        如果 (拥有472) {
            整64 旧对象472 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            如果 (静472) {
                IR追加(指令, 建IR指令(IR_静态加载, 0, 0, 0, 旧对象472, T_对象, 查静态序号含类(左名ID)));
            } 否则 如果 (槽是引用(目标槽)) {
                整64 目标地472 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 目标地472, T_整64, 0));
                IR追加(指令, 建IR指令(IR_指针加载, 目标地472, 0, 0, 旧对象472, T_对象, 0));
            } 否则 {
                IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 旧对象472, T_对象, 0));
            }
            // 472-a（objdel 撞号根治）：目标=寄存器计数[0]（标签唯一序号·与
            //   IR容器释放.cn:810 既有发射点同款）——466-a 版传 0→同函数第二条
            //   删除对象标签 objdel_N_0 重复定义（79_v2 fix_p.asm 61147/61170 双定义
            //   实证·MASM/GAS 符号重定义错误=228/283/79 生产态 3 红根因）。
            IR追加(指令, 建IR指令(IR_删除对象, 旧对象472, 0, 0, 寄存器计数[0], 0, 左类型ID));
            寄存器计数[0] = 寄存器计数[0] + 1;
        }
        如果 (静472) {
            IR追加(指令, 建IR指令(IR_静态存储, 新对象472, 0, 0, 0, T_整64, 查静态序号含类(左名ID)));
        } 否则 如果 (槽是引用(目标槽)) {
            整64 写回472 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 写回472, T_整64, 0));
            IR追加(指令, 建IR指令(IR_指针存储, 写回472, 新对象472, 0, 0, T_整64, 0));
        } 否则 {
            IR追加(指令, 建IR指令(IR_存储, 新对象472, 0, 0, 0, 0, 目标槽));
        }
        当 (表达式栈.大小() > 0) {
            结果<空类型, 整32> 删尾472 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删尾472.正常) { 运行时错误(4); }
        }
        返回 真;
    }
    // 821（#444·赋值语句面重载产物物化）：右值末=运算符重载表达式（二元/一元
    //   命中·产物类型=左类型·与声明面 414 生成类对象局部 同判据）——
    //   `甲 = 乙 + 丙`（甲=已声明类变量）→ 独立函数（守函数行数红线 ≤100）
    如果 ((右末.类型 == 节点_二元运算 || 右末.类型 == 节点_负号 ||
         右末.类型 == 节点_逻辑非 || 右末.类型 == 节点_位非) &&
        解析重载节点类型ID(池, n.子终点 - 1) == 左类型ID) {
        如果 (赋值物化重载产物821(池, n, 目标槽, 左名ID, 左类型ID, 指令,
                                 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数,
                                 表达式栈)) {
            返回 真;
        }
    }
    如果 (右末.类型 != 节点_标识符) { 返回 假; }
    整64 右名ID = 整64(右末.文本);
    // 自赋值 no-op（甲 = 甲）——下方「先释放旧对象」会毁掉源（值语义自赋值恒
    //   无副作用，与 生成结构体整体赋值 79-a 自赋值守卫同款）
    如果 (右名ID == 左名ID) { 返回 真; }
    整64 右类型ID = 解析标识符类型ID(右名ID);
    如果 (右类型ID == 0) { 返回 假; }
    字符串 右类型文本 = 字符串复制(驻留文本(右类型ID));
    布尔 右是容器 = 是容器类(右类型文本);
    布尔 右是用户类 = 是用户类(右类型文本);
    如果 (!右是容器 && !右是用户类) { 返回 假; }
    // 静态目标（目标槽 0 = 顶层静态变量——解析标识符类型ID 已含静态表级）
    布尔 目标是静态 = 假;
    如果 (目标槽 == 0 && 查静态序号含类(左名ID) >= 0) { 目标是静态 = 真; }
    如果 (目标槽 == 0 && !目标是静态) { 返回 假; }
    // ---- 源对象左值地址（T& 引用位：引用参数槽内容 / 普通槽地址 / 静态符号地址）----
    整64 源槽 = 0;
    结果<整64, 整32> 找源局 = 局部槽.获取(右名ID);
    如果 (找源局.正常) { 源槽 = 找源局.值; }
    如果 (源槽 == 0) {
        结果<整64, 整32> 找源参 = 参数槽.获取(右名ID);
        如果 (找源参.正常) { 源槽 = 找源参.值; }
    }
    整64 源指针reg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    如果 (源槽 != 0) {
        如果 (槽是引用(源槽)) {
            IR追加(指令, 建IR指令(IR_加载, 源槽, 0, 0, 源指针reg, T_对象, 0));
        } 否则 {
            IR追加(指令, 建IR指令(IR_取地址, 源槽, 0, 0, 源指针reg, T_整64, 0));
        }
    } 否则 {
        整64 找源静 = 查静态序号含类(右名ID);
        如果 (找源静 < 0) { 返回 假; }
        // 拷贝构造源=T& 传静态槽左值地址（lea .data 槽；宿主 globalStaticClassAssign
        //   「源为顶层类静态：槽地址 = ?gstatic_名 符号地址」同款）
        IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 源指针reg, T_对象, 找源静));
    }
    // ---- 目标旧对象释放（仅**拥有型**目标——RAII 名单判定；返回接收视图等非拥有
    //   形态的旧值属他人，不释放。静态槽长期存活恒拥有）----
    布尔 目标拥有 = 目标是静态;
    如果 (!目标拥有) {
        整64 名i = 0;
        当 (名i < 函数信息.容器变量们.大小()) {
            如果 (函数信息.容器变量们.元素(名i) == 左名ID) {
                目标拥有 = 真;
                中断;
            }
            名i++;
        }
    }
    如果 (目标拥有) {
        整64 旧对象reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        如果 (目标是静态) {
            IR追加(指令, 建IR指令(IR_静态加载, 0, 0, 0, 旧对象reg, T_对象, 查静态序号含类(左名ID)));
        } 否则 如果 (槽是引用(目标槽)) {
            // 引用参数：槽内容 = 调用方变量地址 → 经指针加载旧对象
            整64 目标地reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 目标地reg, T_整64, 0));
            IR追加(指令, 建IR指令(IR_指针加载, 目标地reg, 0, 0, 旧对象reg, T_对象, 0));
        } 否则 {
            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 旧对象reg, T_对象, 0));
        }
        // 空安全（代码生成展开 test/je + ~类(this) + __cn_object_delete）
        // 836-a（070-③ 层③·单独实施）：标签唯一序号——取号并推进寄存器计数
        //   （原固定 0 → 同函数多处 objdel_N_0 撞号·V5 ml64 A2005 铁证；
        //   472-a 只修了部分点·385/701 为遗漏点）。**已全量实证零回归**（534/3）。
        整64 删除标签序 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_删除对象, 旧对象reg, 0, 0, 删除标签序, 0, 左类型ID));
    }
    // ---- 新建独立对象 + 拷贝构造（源 T&）——宿主同款 ----
    整64 对象字节数 = 查结构体大小(左类型ID);
    如果 (左是容器) { 对象字节数 = 容器对象大小(左类型文本); }
    整64 拷贝objreg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 拷贝objreg, 对象字节数, 左类型ID));
    // 543-d（2026-10-14·918 形态④ v2 链接 LNK2019 实证·728x 分支同步同内容）：
    //   **无显式拷贝构造用户类→合成逐位拷贝**（宿主同款：NewObject + rep movsb
    //   内容整块拷 + 上方旧壳 preFree·宿主 t918 asm 三段齐实证）——原通道对
    //   无拷贝构造类仍发「类名$类名(类名&)」拷贝构造调用，而生成类面不为
    //   无拷贝构造类发射该符号=悬空外部（cn_main LNK2019 链接红·918 双编译
    //   对照首暴露）。判定=查类拷贝构造串==0（IR类 777 键登记面·构造参数串
    //   「类名&」时登记）；容器类恒有容器拷贝构造不受影响（是用户类 守卫先挡）。
    如果 (是用户类(左类型文本) && 查类拷贝构造串(左类型ID) == 0) {
        整64 源本体d = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_指针加载, 源指针reg, 0, 0, 源本体d, T_对象, 0));
        IR追加(指令, 建IR指令(IR_结构体拷贝, 源本体d, 拷贝objreg, 0, 0,
                              对象字节数, 0));
    } 否则 {
        // this=位0、源=位1（拷贝构造 T& 按引用位传左值地址）
        IR追加(指令, 建IR指令(IR_调用实参, 拷贝objreg, 0, 0, 0, 0, 0));
        IR追加(指令, 建IR指令(IR_调用实参, 源指针reg, 0, 0, 0, 1, 0));
        // 拷贝构造签名=类(类&)（参数串带 &——asm 符号 _A+类型编码，宿主实例
        //   _...映射_A_T... 实证对齐；与 生成容器拷贝构造 同一符号口径）
        IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                              驻留(方法符号(左类型文本, 合成名基名(左类型文本),
                                            左类型文本 + "&"))));
    }
    // ---- 写回目标（引用参数：槽内地址 + 指针存储；静态：静态存储；普通：槽存储）----
    如果 (目标是静态) {
        IR追加(指令, 建IR指令(IR_静态存储, 拷贝objreg, 0, 0, 0, T_整64, 查静态序号含类(左名ID)));
    } 否则 如果 (槽是引用(目标槽)) {
        整64 写回地reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 写回地reg, T_整64, 0));
        IR追加(指令, 建IR指令(IR_指针存储, 写回地reg, 拷贝objreg, 0, 0, T_整64, 0));
    } 否则 {
        IR追加(指令, 建IR指令(IR_存储, 拷贝objreg, 0, 0, 0, 0, 目标槽));
    }
    // 表达式栈清空（本通道不求值右值，防御性归位——对齐 生成结构体整体赋值 尾段）
    当 (表达式栈.大小() > 0) {
        结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈.正常) { 运行时错误(4); }
    }
    返回 真;
}

// 拥有型字符串赋值发射面（172-a 自 生成标识符赋值 机械搬移；172-a 前为
//   生成赋值语句 480~544 段）——返回写回后的值寄存器（字面量/标识符右值
//   经 __cn_str_copy 落堆时换用 copy 寄存器）。

// 821（#444）：重载产物赋值旧值释放发射（472-a 同款拥有型判定：静态恒拥有/
//   RAII 名单；IR_删除对象 展开空句柄空安全）——自 赋值物化重载产物821
//   提取（函数行数红线 ≤100）。
不安全 函数 发射重载产物旧值释放821(整64 目标槽, 整64 左名ID, 整64 左类型ID,
                          布尔 静821, 向量<IR指令>& 指令, 函数IR& 函数信息,
                          整64* 寄存器计数) -> 空类型 {
    布尔 拥有821 = 静821;
    // 922（#925 并入·引用参数面）：引用参数槽=调用方对象别名——「甲 = 新值」
    //   即 drop 旧值（宿主 isByRefCapture 同款·原判定漏·9119 泄漏实录）。
    如果 (!拥有821 && 槽是引用(目标槽)) { 拥有821 = 真; }
    如果 (!拥有821) {
        整64 名821 = 0;
        当 (名821 < 函数信息.容器变量们.大小()) {
            如果 (函数信息.容器变量们.元素(名821) == 左名ID) {
                拥有821 = 真;
                中断;
            }
            名821++;
        }
    }
    如果 (拥有821) {
        整64 旧obj821 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        如果 (静821) {
            IR追加(指令, 建IR指令(IR_静态加载, 0, 0, 0, 旧obj821,
                                 T_对象, 查静态序号含类(左名ID)));
        } 否则 如果 (槽是引用(目标槽)) {
            整64 目标地821 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 目标地821, T_整64, 0));
            IR追加(指令, 建IR指令(IR_指针加载, 目标地821, 0, 0, 旧obj821,
                                 T_对象, 0));
        } 否则 {
            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 旧obj821, T_对象, 0));
        }
        IR追加(指令, 建IR指令(IR_删除对象, 旧obj821, 0, 0, 寄存器计数[0], 0,
                             左类型ID));
        寄存器计数[0] = 寄存器计数[0] + 1;
    }
}

// 821（#444·赋值语句面重载产物物化·自 生成容器对象整体赋值 尾段提取以守
//   函数行数红线）：右值末=运算符重载表达式（二元/一元命中·产物类型=左类型·
//   与声明面 414 生成类对象局部 同判据）——`甲 = 乙 + 丙`（甲=已声明类变量）
//   生成表达式完整求值（聚合返回=被调方 sret 拷入调用方帧内 retbuf 栈临时·
//   单 retbuf 复用）→ NewObject + 结构体拷贝物化（对齐声明面 414；原直存=
//   retbuf 栈地址入槽：块出口按堆句柄 free 栈地址〔free(): invalid size〕或
//   字段读经栈地址段错误——探针双侧实证）+ 旧值释放（Rust drop 语义·原路径
//   通用 Store 覆盖=旧对象资源成孤儿）→ 堆句柄入槽（尾析构登记释放合法）。
//   判定/守卫由调用方完成；返回 假=目标不可定位（字段面）交回原路径。
不安全 函数 赋值物化重载产物821(向量<节点> 池, 节点 n, 整64 目标槽,
                     整64 左名ID, 整64 左类型ID, 向量<IR指令>& 指令,
                     映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                     函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                     向量<整64>& 表达式栈) -> 布尔 {
    布尔 静821 = 假;
    如果 (目标槽 == 0 && 查静态序号含类(左名ID) >= 0) { 静821 = 真; }
    如果 (目标槽 == 0 && !静821) { 返回 假; }
    整64 字节821 = 查结构体大小(左类型ID);
    如果 (字节821 == 0) { 返回 假; }
    // ① 右值求值（重载调用·聚合返回 retbuf 地址）
    整64 产物821 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽, 指令,
                             寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
    如果 (产物821 != 0) {
        // ② 物化（NewObject + 结构体拷贝·源=retbuf·对齐声明面 414）
        整64 新对象821 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新对象821, 字节821,
                             左类型ID));
        IR追加(指令, 建IR指令(IR_结构体拷贝, 产物821, 新对象821, 0, 0,
                             字节821, 0));
        // ③ 旧值释放（先求值后释放=自用右值 甲 = 甲 + 乙 安全）
        发射重载产物旧值释放821(目标槽, 左名ID, 左类型ID, 静821, 指令,
                              函数信息, 寄存器计数);
        // ④ 写回（堆句柄入槽）
        如果 (静821) {
            IR追加(指令, 建IR指令(IR_静态存储, 新对象821, 0, 0, 0,
                                 T_整64, 查静态序号含类(左名ID)));
        } 否则 如果 (槽是引用(目标槽)) {
            整64 写回821 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 写回821, T_整64, 0));
            IR追加(指令, 建IR指令(IR_指针存储, 写回821, 新对象821, 0, 0,
                                 T_整64, 0));
        } 否则 {
            IR追加(指令, 建IR指令(IR_存储, 新对象821, 0, 0, 0, 0, 目标槽));
        }
    }
    当 (表达式栈.大小() > 0) {
        结果<空类型, 整32> 删821 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删821.正常) { 运行时错误(4); }
    }
    返回 真;
}

// 544（458 呈报·赋值位形态①·自 生成容器对象整体赋值 提取以守函数行数红线）：
//   右值末=「返回类对象的调用」（普通函数调用/方法调用·非构造·返回类型严格
//   等于左类型·判定内聚于 是返回类调用_544）——产物=调用物化槽（调用方帧内
//   栈地址·聚合返回 ABI 物化），472-a 直存=块出口按堆句柄释放栈地址
//   （free(): invalid pointer·探针 rc=134 实测）；物化接管=821 同款位拷物化
//   （NewObject+结构体拷贝）+旧值释放+堆句柄入槽（目标不可定位=821 内守卫
//   返回假交回原路径）。判定前置由调用方（左是用户类/非容器）与内部完成。
不安全 函数 赋值接管返回类调用544(向量<节点> 池, 节点 n, 整64 目标槽,
                     整64 左名ID, 整64 左类型ID, 向量<IR指令>& 指令,
                     映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                     函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                     向量<整64>& 表达式栈) -> 布尔 {
    如果 (n.子终点 <= n.子起点) { 返回 假; }
    节点 右末544 = 池.元素(n.子终点 - 1);
    如果 (右末544.类型 != 节点_调用) { 返回 假; }
    如果 (!是返回类调用_544(池, 整64(n.子终点 - 1), 左类型ID)) { 返回 假; }
    返回 赋值物化重载产物821(池, n, 目标槽, 左名ID, 左类型ID, 指令,
                             局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数,
                             表达式栈);
}
