// CN 自举编译器 v2 · 生成语句（D1 行数整改 172-a 拆分子模块，2026-09-15）
// 职责：赋值语句生成族——自 生成语句.cn 的 生成赋值语句 机械搬移（纯重构零
//   行为变更）：主分派（标识符左值 / 成员·解引用左值）+ 标识符赋值生成
//   （生成标识符赋值）+ 成员·解引用赋值生成（生成成员解引用赋值）+ 三个
//   发射面族（尝试成员结构体整体写 / 发射拥有串赋值 / 发射成员串字段写入）。
//   寄存器/引用参数等权威表经 公开: 访问函数（IR生成 主干）；模块路径=
//   生成语句赋值（新键基）。
导入 容器::向量;
导入 语法;       // Token/AST 节点池（原 导入 语法分析，目录包名）
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码（目录包名）
导入 IR生成;     // 控制流辅助/变量类型权威表（同包幂等）
导入 生成声明;    // 语句级变量声明分派（R3 拆分，同包）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 赋值语句：文本=左值名（标识符槽/静态槽）；文本=0 时 附加=左值表达式起点
//   （解引用/成员/下标左值，按字段宽度存储）。结构体整体赋值经
//   生成结构体整体赋值（第18枚 POD Copy 语义）先行拦截。
// D1 行数整改 172-a：主函数收缩为分派骨架——标识符左值走 生成标识符赋值，
//   成员/解引用左值走 生成成员解引用赋值（行为等价于原单函数双分支）。
不安全 函数 生成赋值语句(向量<节点> 池, 节点 n,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) {
    如果 (n.文本 != 0) {
        生成标识符赋值(池, n, 局部槽, 参数槽, 函数信息,
                       寄存器计数, 槽计数, 表达式栈);
        返回;
    }
    生成成员解引用赋值(池, n, 局部槽, 参数槽, 函数信息,
                       寄存器计数, 槽计数, 表达式栈);
}

// 标识符左值赋值生成（172-a 自 生成赋值语句 分支一 机械搬移）：
//   文本=左值名（局部槽/参数槽/静态槽/类字段/拥有串归一化/引用参数写回）。
不安全 函数 生成标识符赋值(向量<节点> 池, 节点 n,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) {
    向量<IR指令>& 指令 = 函数信息.指令;
    // 标识符左值：槽 <- 右值寄存器
    整64 目标槽 = 0;
    结果<整64, 整32> 找槽 = 局部槽.获取(整64(n.文本));
    如果 (找槽.正常) { 目标槽 = 找槽.值; }
    如果 (目标槽 == 0) {
        结果<整64, 整32> 找参 = 参数槽.获取(整64(n.文本));
        如果 (找参.正常) { 目标槽 = 找参.值; }
    }
        如果 (生成结构体整体赋值(池, n, 目标槽, 局部槽, 参数槽, 函数信息,
                                 寄存器计数, 槽计数, 表达式栈)) {
            返回;
        }
    整64 值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
    // 第七十八轮（2026-09-12）：方法体字段左值赋值（字段名裸标识符——局部/参数
    //   未命中；this 槽加载 + 字段地址 + 指针存储）。结构体类型字段整体赋值=
    //   第一版边界（显式拒绝——8 字节指针存储会静默截断 >8 字节结构体）
    如果 (目标槽 == 0 && 值寄存器 != 0) {
        整64 字段偏移z = 当前方法字段偏移(整64(n.文本));
        如果 (字段偏移z >= 0) {
            整64 字段类型z = 查字段类型ID(当前方法类名ID, 整64(n.文本));
            如果 (字段类型z != 0 && 查结构体大小(字段类型z) != 0) {
                IR层诊断("类字段（结构体类型）整体赋值暂不支持: " +
                             驻留文本(整64(n.文本)));
                运行时错误(6);
            }
            整64 地址z = 发射类字段地址(字段偏移z, 指令, 寄存器计数);
            IR追加(指令, 建IR指令(IR_指针存储, 地址z, 值寄存器, 0, 0, T_整64, 0));
            当 (表达式栈.大小() > 0) {
                结果<空类型, 整32> 删栈z = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删栈z.正常) { 运行时错误(4); }
            }
            返回;
        }
    }
    // 静态槽赋值（2026-09-06 根治，缺陷零容忍）：目标非局部/参数时查
    //   静态序号表——命中则 IR_静态存储 写回 .data 槽。原实现此处仅认
    //   局部/参数槽，静态目标「目标槽==0」静默丢存储（探针 计数器 =
    //   计数器 + 阶段(5) 打印恒 0 实证）——防御分支静默降级家族成员，
    //   与 发射自增自减 的静态读写对（②c C）同款设施补齐
    如果 (目标槽 == 0 && 值寄存器 != 0) {
        整64 找静赋 = 查静态序号(整64(n.文本));
        如果 (找静赋 >= 0) {
            // 87-a（2026-09-12 第八十七轮）：静态**字符串**——drop 旧 + 来源分级
            //   归一化（借用来源 __cn_str_copy 落堆）；其余静态类型（标量值/
            //   容器类句柄）保持 8 字节直存（指针槽模型）。
            如果 (字符串比较(驻留文本(取静态类型(找静赋)), "字符串")) {
                值寄存器 = 归一化静态串赋值(池, n, 值寄存器, 找静赋, 函数信息,
                                            寄存器计数);
            }
            IR追加(指令, 建IR指令(IR_静态存储, 值寄存器, 0, 0, 0, T_整64, 找静赋));
        }
    }
    // plans/019 阶段4' 第二批（2026-09-11 方案A）：拥有型字符串赋值——宿主
    //   第一批复核同构 + Rust 赋值语义（先 drop 旧再 move 新）：目标=字符串
    //   且在拥有名单且未污染时：①右值=字面量/标识符 → free 旧 + __cn_str_copy
    //   落堆（变量恒拥有堆串）；②右值=白名单八函数调用/二元拼接（+ 产物恒
    //   堆，复合赋值 += 语法层已重析为二元）→ free 旧 + 直存；③其余形态
    //   （非白名单调用/下标/成员等借用源）→ free 旧（旧值必为拥有——拥有链
    //   维护，drop 后零泄漏，优于宿主保守面）+ 污染退出 RAII + 直存。
    //   free 旧空安全（未赋值路径槽=0——预扫入口零初始化）。
    // 172-a：发射面自本函数提取为 发射拥有串赋值（返回写回后的值寄存器）。
    值寄存器 = 发射拥有串赋值(池, n, 目标槽, 值寄存器, 函数信息, 指令, 寄存器计数);
    如果 (值寄存器 != 0 && 目标槽 != 0) {                    如果 (槽是引用(目标槽)) {
            // ②c D：引用参数赋值——Load 槽得调用方左值地址，指针写回
            整64 地址reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 地址reg, T_整64, 0));
            IR追加(指令, 建IR指令(IR_指针存储, 地址reg, 值寄存器, 0, 0, T_整64, 0));
        } 否则 {
            // 46-f 第五十轮：正32 目标存储前截断（wrapping mod 2^32，助手
            //   单一事实源在 生成声明——非正32 目标零开销直通）
            整64 赋目标类型 = 查当前函数变量类型(整64(n.文本));
            值寄存器 = 正32存储截断(驻留文本(赋目标类型), 值寄存器, 指令, 寄存器计数);
            值寄存器 = 浮点宽化存储(驻留文本(赋目标类型), 值寄存器, 指令, 寄存器计数);
            IR追加(指令, 建IR指令(IR_存储, 值寄存器, 0, 0, 0, 0, 目标槽));
        }
    }
    // 清空表达式栈（右值 残留）
    当 (表达式栈.大小() > 0) {
        结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈.正常) { 运行时错误(4); }
    }
}

// 拥有型字符串赋值发射面（172-a 自 生成标识符赋值 机械搬移；172-a 前为
//   生成赋值语句 480~544 段）——返回写回后的值寄存器（字面量/标识符右值
//   经 __cn_str_copy 落堆时换用 copy 寄存器）。
不安全 函数 发射拥有串赋值(向量<节点> 池, 节点 n, 整64 目标槽, 整64 值寄存器,
                  函数IR& 函数信息, 向量<IR指令>& 指令, 整64* 寄存器计数) -> 整64 {
    如果 (值寄存器 != 0 && 目标槽 != 0) {
        整64 赋目标类型2 = 查当前函数变量类型(整64(n.文本));
        如果 (赋目标类型2 == 驻留("字符串")) {
            布尔 在名单 = 假;
            整64 名i = 0;
            当 (名i < 函数信息.字符串变量们.大小()) {
                如果 (函数信息.字符串变量们.元素(名i) == 整64(n.文本)) {
                    在名单 = 真;
                    中断;
                }
                名i++;
            }
            结果<整64, 整32> 查污赋 = 函数信息.字符串污染们.获取(整64(n.文本));
            如果 (在名单 && !查污赋.正常) {
                节点 赋末 = 池.元素(n.子终点 - 1);
                布尔 右值拥有 = 赋末.类型 == 节点_字符串字面量 ||
                                赋末.类型 == 节点_标识符 ||
                                赋末.类型 == 节点_二元运算;
                如果 (赋末.类型 == 节点_调用) {
                    节点 被调赋 = 池.元素(整32(赋末.子起点));
                    如果 (被调赋.类型 == 节点_标识符) {
                        整64 被调名赋 = 整64(被调赋.文本);
                        右值拥有 = 被调名赋 == 驻留("字符串复制") ||
                                  被调名赋 == 驻留("字符串连接") ||
                                  被调名赋 == 驻留("字符串拼接") ||
                                  被调名赋 == 驻留("字符串子串") ||
                                  被调名赋 == 驻留("字符串大写") ||
                                  被调名赋 == 驻留("字符串小写") ||
                                  被调名赋 == 驻留("字符串修剪") ||
                                  被调名赋 == 驻留("字符串反转");
                        // A2（方案甲）：返回类型契约——被调者返回 字符串 即拥有
                        //   （72-a：键基回退版——纯名查跨模块 miss=契约失效）
                        如果 (!右值拥有 &&
                             查函数返回回退(被调名赋) == 驻留("字符串")) {
                            右值拥有 = 真;
                        }
                    }
                }
                // 字面量/标识符：先 copy 落堆再 free 旧（自赋值 s = s 安全——
                //   copy 产物独立于旧值内存后才能释放旧值）
                如果 (右值拥有 && (赋末.类型 == 节点_字符串字面量 ||
                                赋末.类型 == 节点_标识符)) {
                    整64 copy赋寄存器 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_调用实参, 值寄存器, 0, 0, 0, 0, 0));
                    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, copy赋寄存器, 0,
                                         驻留("__cn_str_copy")));
                    登记寄存器类型(copy赋寄存器, T_字符串);
                    值寄存器 = copy赋寄存器;
                }
                // free 旧值（drop——拥有链维护下旧值必为堆串；空安全；二元/调用
                //   右值求值时已消费旧值内容产新堆——free 后不再引用）
                整64 旧ptr = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 旧ptr, T_字符串, 0));
                IR追加(指令, 建IR指令(IR_调用实参, 旧ptr, 0, 0, 0, 0, 0));
                IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                     驻留("__cn_str_free")));
                如果 (!右值拥有) {
                    // 借用源——污染退出（此后不再 free/拥有化）
                    登记串污染(函数信息, 整64(n.文本));   // 75-a：唯一入口
                }
            }
        }
    }
    返回 值寄存器;
}

// 成员/解引用左值赋值生成（172-a 自 生成赋值语句 分支二 机械搬移）：
//   手动生成左值地址（不走 生成表达式，避免成员取值）。
不安全 函数 生成成员解引用赋值(向量<节点> 池, 节点 n,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) {
    向量<IR指令>& 指令 = 函数信息.指令;
    // ②b B5：成员左值按字段宽度存储（类型码入 指令.类型——旧固定 8 字节
    //   写越界清零相邻槽，126 段① OOM 根因；解引用左值保持默认 8 字节）
    节点 左末 = 池.元素(n.子起点 - 1);
    // 46-a 根治（2026-09-09 第四十八轮）：成员结构体作值写（r.左上 = a /
    //   r.右下 = r.左上，含 >8 字节结构体）——左字段类型是结构体且右值为
    //   标识符/成员链（结构体值形态）时，两侧 生成左值地址 + IR_结构体拷贝
    //   整体写（Rust place 拷贝语义，与 生成结构体整体赋值 同构）。原标量
    //   宽度通道对 8 字节结构体恰好覆盖、>8 字节静默截断（数据损坏家族）；
    //   右值经 成员载荷是结构体 根治后压地址，此通道统一地址语义。
    //   构造字面量右值（节点_构造展开，186 通道）不在此拦截。
    // 172-a：发射面自本函数提取为 尝试成员结构体整体写（真=已处理）。
    如果 (尝试成员结构体整体写(池, n, 左末, 局部槽, 参数槽, 函数信息,
                             寄存器计数, 槽计数, 表达式栈)) {
        返回;
    }
    整64 存储宽度 = T_整64;
    如果 (左末.类型 == 节点_成员) {
        存储宽度 = 取成员宽度码(池, n.子起点 - 1);
    } 否则 如果 (左末.类型 == 节点_下标) {
        // ③ 第三波：下标左值写宽度=所指元素宽度（整32* p[0]=v 写 4 字节，
        //   8 字节写越界踩相邻元素——同 B5 成员窄宽教训）
        存储宽度 = 取下标元素宽度码(池, n.子起点 - 1);
    }
    整64 地址寄存器 = 生成左值地址(池, 整32(n.附加), n.子起点, 局部槽, 参数槽,
                                指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
    整64 值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                               指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
    // plans/019 阶段4' 第二批：下标目标为字符串元素（字符串* 指针元素——
    //   查指针变量类型 直判所指类型，宽度码对字符串归并 T_整64 不可用）且
    //   右值为字符串变量标识符 -> 值被外部槽持有（指针逃逸模型，宿主 38_tool
    //   姓名[]=$副本 同款）-> 右值变量污染退出 RAII（出口 free=悬垂源头）
    如果 (左末.类型 == 节点_下标 && 左末.子起点 > 0 &&
         n.子起点 < n.子终点) {
        节点 借对象 = 池.元素(整32(左末.子起点));
        如果 (借对象.类型 == 节点_标识符 &&
             查指针变量类型(整64(借对象.文本)) == 驻留("字符串")) {
            节点 右末借 = 池.元素(n.子终点 - 1);
            如果 (右末借.类型 == 节点_标识符 &&
                 查当前函数变量类型(整64(右末借.文本)) == 驻留("字符串")) {
                登记串污染(函数信息, 整64(右末借.文本));   // 75-a：唯一入口
            }
        }
    }
    // 79-a（2026-09-12 第七十九轮）：成员字符串字段写入归一化——字段独立拥有
    //   （与宿主 79-a 同款分级）：字面量=驻留直存；裸函数调用（白名单族/返回
    //   字符串契约）=接管零拷贝；其余（标识符/成员/下标/二元/方法调用借用返回）
    //   =__cn_str_copy 落堆（字段独立副本，源保持拥有照常释放）。顺序=先求值+
    //   复制、后 free 旧值（自赋值 甲.名 = 甲.名 安全：新值先独立于旧值内存）。
    //   preFree 仅对「直连标识符父对象且父在资源字段名单」（拥有槽）发射——其余
    //   形态保守不释放旧值（宁漏勿错）。
    // 172-a：发射面自本函数提取为 发射成员串字段写入（返回写回后的值寄存器）。
    值寄存器 = 发射成员串字段写入(池, n, 左末, 地址寄存器, 值寄存器, 函数信息,
                              指令, 寄存器计数);
    如果 (地址寄存器 != 0 && 值寄存器 != 0) {
        IR追加(指令, 建IR指令(IR_指针存储, 地址寄存器, 值寄存器, 0, 0, 存储宽度, 0));
    }
    // 清空表达式栈（右值 残留）
    当 (表达式栈.大小() > 0) {
        结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈.正常) { 运行时错误(4); }
    }
}

// 成员结构体作值写发射面（172-a 自 生成成员解引用赋值 机械搬移；172-a 前为
//   生成赋值语句 577~626 段；46-a 根治族）——真=已整体写并完成（调用方收尾）。
不安全 函数 尝试成员结构体整体写(向量<节点> 池, 节点 n, 节点 左末,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    如果 (左末.类型 == 节点_成员 && n.子起点 < n.子终点) {
        // 父链类型=解析成员链结构体ID(左末.子起点)（范本=取成员宽度码：
        //   成员节点 子起点=对象节点索引——传左末自身索引得的是左末字段
        //   自身类型，再查一层字段类型必 miss——首版误写实证）
        整64 父链ID48 = 解析成员链结构体ID(池, 整32(左末.子起点));
        如果 (父链ID48 != 0) {
            整64 字段结构体ID48 = 查结构体类型(
                查字段类型ID(父链ID48, 整64(左末.文本)));
            如果 (字段结构体ID48 != 0) {
                节点 右末48 = 池.元素(n.子终点 - 1);
                // 86-a（2026-09-12 复审缺陷①）：三元右值（乙箱.内盒 = (条?甲:乙)）——
                //   源地址经 生成表达式（三元聚合分支地址化=选中 place 地址），
                //   与标识符/成员（生成左值地址）分流。原白名单不含三元 → 落标量
                //   Store 通道 8 字节写 → 字段静默损坏（P47-v2 形六 t6 实证乱码）。
                如果 (右末48.类型 == 节点_标识符 || 右末48.类型 == 节点_成员 ||
                    右末48.类型 == 节点_三元运算) {
                    整64 目标地址48 = 生成左值地址(池, 整32(n.附加), n.子起点,
                                                   局部槽, 参数槽, 指令,
                                                   寄存器计数, &函数信息.块计数,
                                                   槽计数, 表达式栈);
                    整64 源地址48 = 0;
                    如果 (右末48.类型 == 节点_三元运算) {
                        源地址48 = 生成表达式(池, n.子起点, n.子终点,
                                             局部槽, 参数槽, 指令,
                                             寄存器计数, &函数信息.块计数,
                                             槽计数, 表达式栈);
                    } 否则 {
                        源地址48 = 生成左值地址(池, n.子起点, n.子终点,
                                               局部槽, 参数槽, 指令,
                                               寄存器计数, &函数信息.块计数,
                                               槽计数, 表达式栈);
                    }
                    如果 (目标地址48 != 0 && 源地址48 != 0) {
                        // 79-a：串字段深拷。86-a：preFree 修正为真——目标字段旧串
                        //   是「值语义拥有」（前次整体赋值/深拷的副本），覆盖前必须
                        //   释放（原「非拥有槽不 preFree」保守口径在此泄漏：E243 形五
                        //   v2 残留=1 实证）。未初始化槽的垃圾句柄经 cn_free_tracked
                        //   仅在册释放，空安全（84-f 核验结论）——宁漏勿错不再适用。
                        发射结构体整体拷贝(函数信息, 寄存器计数, 目标地址48,
                                         源地址48, 字段结构体ID48, 真, 真);
                    }
                    当 (表达式栈.大小() > 0) {
                        结果<空类型, 整32> 删栈48 = 表达式栈.删除(表达式栈.大小() - 1);
                        如果 (!删栈48.正常) { 运行时错误(4); }
                    }
                    返回 真;
                }
            }
        }
    }
    返回 假;
}

// 成员字符串字段写入归一化发射面（172-a 自 生成成员解引用赋值 机械搬移；
//   172-a 前为 生成赋值语句 662~723 段；79-a/87-a 族）——返回写回后的值
//   寄存器（借用来源经 __cn_str_copy 落堆时换用 copy 寄存器）。
不安全 函数 发射成员串字段写入(向量<节点> 池, 节点 n, 节点 左末, 整64 地址寄存器,
                  整64 值寄存器, 函数IR& 函数信息, 向量<IR指令>& 指令,
                  整64* 寄存器计数) -> 整64 {
    如果 (地址寄存器 != 0 && 值寄存器 != 0 && 左末.类型 == 节点_成员) {
        整64 父链IDw = 解析成员链结构体ID(池, 整32(左末.子起点));
        如果 (父链IDw != 0) {
            整64 字段类型IDw = 查字段类型ID(父链IDw, 整64(左末.文本));
            如果 (字段类型IDw != 0 && 字符串比较(驻留文本(字段类型IDw), "字符串")) {
                节点 右末w = 池.元素(n.子终点 - 1);
                布尔 需复制 = 真;
                如果 (右末w.类型 == 节点_字符串字面量) { 需复制 = 假; }
                否则 如果 (右末w.类型 == 节点_调用 && 右末w.子起点 > 0) {
                    节点 被调w = 池.元素(整32(右末w.子起点));
                    如果 (被调w.类型 == 节点_标识符) {
                        整64 被调名w = 整64(被调w.文本);
                        布尔 白名单w = 被调名w == 驻留("字符串复制") ||
                                      被调名w == 驻留("字符串连接") ||
                                      被调名w == 驻留("字符串拼接") ||
                                      被调名w == 驻留("字符串子串") ||
                                      被调名w == 驻留("字符串大写") ||
                                      被调名w == 驻留("字符串小写") ||
                                      被调名w == 驻留("字符串修剪") ||
                                      被调名w == 驻留("字符串反转");
                        如果 (!白名单w && 查函数返回回退(被调名w) == 驻留("字符串")) {
                            白名单w = 真;   // A2 契约：签名即契约
                        }
                        需复制 = !白名单w;
                    }
                }
                如果 (需复制) {
                    值寄存器 = 发射字符串复制调用(指令, 寄存器计数, 值寄存器);
                }
                如果 (左末.子起点 > 0) {
                    节点 对象w = 池.元素(整32(左末.子起点));
                    布尔 是拥有字段槽w = 假;
                    如果 (对象w.类型 == 节点_标识符) {
                        是拥有字段槽w = 在资源字段名单(函数信息, 整64(对象w.文本));
                        // 87-a（2026-09-12 第八十七轮）：顶层静态结构体的字段槽
                        //   ——槽长期存活**恒拥有**（局部按块出口 drop；静态无出口，
                        //   重复赋值必须当场 drop 旧串，否则每次赋值泄漏）。原判据
                        //   仅「父∈资源字段名单」——静态名不在名单 → 不释放（探针
                        //   s9-v2 实证：循环 300 次赋值残留 +600）。
                        如果 (!是拥有字段槽w) {
                            整64 找静w = 查静态序号(整64(对象w.文本));
                            如果 (找静w >= 0 && 查结构体大小(取静态类型(找静w)) > 0) {
                                是拥有字段槽w = 真;
                            }
                        }
                    }
                    如果 (是拥有字段槽w) {
                        整64 旧regw = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_指针加载, 地址寄存器, 0, 0, 旧regw, T_字符串, 0));
                        IR追加(指令, 建IR指令(IR_调用实参, 旧regw, 0, 0, 0, 0, 0));
                        IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                             驻留("__cn_str_free")));
                        如果 (函数信息.零寄存器 != 0) {
                            IR追加(指令, 建IR指令(IR_指针存储, 地址寄存器,
                                         函数信息.零寄存器, 0, 0, T_整64, 0));
                        }
                    }
                }
            }
        }
    }
    返回 值寄存器;
}
