// CN 自举编译器 v2 · 生成函数（千行拆分子模块，2026-09-08 用户裁决阶段目录包）
// 职责：函数遍历与程序遍历（生成函数/IR生成/IR生成多文件——IR 生成入口）
//   ——自 IR生成.cn 机械搬移；权威表/重载决议/引用参数设施经 公开: 函数
//   访问 IR生成 主干；模块路径=生成函数（新键基）。
导入 容器::向量;
导入 语法;       // Token/AST 节点池（原 导入 语法分析，目录包名）
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码（目录包名）
导入 IR生成;     // 权威表/控制流辅助/实参结构收集（同包）
导入 生成表达式; // 表达式后缀求值（同包）
导入 生成语句;   // 语句遍历/块遍历（同包）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 296-a（D35 波B·2026-09-17）：当前函数尾块ID 全局登记（生成函数 串行设置/
//   生成完复位——当前方法类名ID 同款全局模式）——生成错误传播 err 块在
//   IR_返回 后发射跳尾块（epilogue 唯一·缺陷A 惯例）须知晓尾块编号；生成
//   表达式层无 函数信息 上下文，经本全局直读。
静态 整64 当前函数尾块ID全局 = 0;
静态 整64 当前生成符号ID全局 = 0;   // 422-a：诊断宿主定位临时代码（定位后删）

不安全 函数 设置当前生成符号ID(整64 符号ID) -> 空类型 {
    当前生成符号ID全局 = 符号ID;
}

// 422-a：读当前生成符号（诊断宿主打印用·纯读）
函数 取当前生成符号ID() -> 整64 {
    返回 当前生成符号ID全局;
}

不安全 函数 设当前函数尾块ID(整64 块ID) -> 空类型 {
    当前函数尾块ID全局 = 块ID;
}

函数 取当前函数尾块ID() -> 整64 {
    返回 当前函数尾块ID全局;
}

// ==================== 函数遍历 ====================
// 从函数节点生成 函数IR（参数槽 + 局部槽 + 指令）。
函数 生成函数(向量<节点> 池, 整32 函数节点, 字符串 模块路径) -> 函数IR {
    函数IR 函数信息;
    // 211-a（2026-09-15 第两百一十一轮，D1 行数整改）：字段显式初始化迁
    //   初始化函数信息字段（裸声明字段无默认构造——lessons 权重7 机械初始化集）；
    //   签名键名+返回相关字段（返回类型/引用/结构体/结果）迁 初始化签名与返回字段。
    初始化函数信息字段(函数信息);
    // ②c D：引用参数槽表/函数级变量类型权威表 按函数重置（生成函数 串行——无交叉）
    清空函数级槽表();
    清空当前函数变量类型();
    节点 函数声明 = 池.元素(函数节点);
    初始化签名与返回字段(池, 函数声明, 函数节点, 模块路径, 函数信息);
    函数信息.块计数 = 0;      // P6b：块编号从 0（入口块）起
    函数信息.当前块 = 0;
    函数信息.循环出口块 = 0;
    函数信息.循环继续块 = 0;
    // 73-a（2026-09-11 方案A 用户裁决）：循环体基线三枚（dict 化字段须显式初始化
    //   ——lessons 权重7：裸声明字段无默认构造）
    函数信息.循环串基线 = 0;
    函数信息.循环容基线 = 0;
    函数信息.循环字段基线 = 0;
    函数信息.函数尾块 = 新块(函数信息);  // 缺陷A：尾块先建（体中 IR_返回 可引用）
    设当前函数尾块ID(整64(函数信息.函数尾块));   // 296-a：错误传播 err 块跳尾块用；标签末尾发射
    复位retbuf字节数();      // ②b B6：本函数 retbuf 尺寸累计清零（生成表达式 累计）
    设当前模块路径(模块路径);   // plans/018 第 4 层+类型分桶：深处键基回退/布局查询统一窗口（IR容器 单一归属）
    整64 寄存器计数 = 1;
    整64 槽计数 = 1;
    如果 (函数信息.返回结构体ID != 0 || 函数信息.返回结果名ID != 0) { 槽计数 = 2; }   // 槽 1=retbuf 指针保留（71-a：结果返回同款）
    向量<整64> 表达式栈 = 向量<整64>();
    // 参数：函数节点子区间 [子起点, 块.子起点) 为参数节点（块 在 子终点=块索引）；
    //   块 的语句节点（表达式/返回）在 [块.子起点, 块索引)，不能当参数遍历。
    整64 参数起点 = 整64(函数声明.子起点);
    整32 块索引 = 函数声明.子终点;
    整64 参数终点 = 参数起点;
    如果 (块索引 < 池.大小()) {
        节点 块节点 = 池.元素(块索引);
        参数终点 = 整64(块节点.子起点);
    }
    整64 参数位置 = 参数起点;
    当 (参数位置 < 参数终点) {
        节点 参数 = 池.元素(整32(参数位置));
        // 只注册 参数 节点（区间可能含 块语句前的非参数节点）
        如果 (参数.类型 == 节点_参数) {
            登记参数槽(池, 参数, 函数信息, &槽计数);
        }
        参数位置++;
    }
    // ②c C：入口函数（主）——静态初始化注入（容器构造 + 87-a 结构体初值）
    如果 (函数声明.文本 == 整32(驻留("主"))) {
        注入主函数静态初始化(池, 函数信息, &寄存器计数, &槽计数, 表达式栈);
    }
    // P7b 预扫容器声明：槽分配+入口零初始化+类型登记（先于函数体生成——
    //   入口零初始化指令位于函数最前）
    如果 (块索引 < 池.大小()) {
        预扫容器声明(池, 块索引, 函数信息, &槽计数, &寄存器计数);
    }
    // 函数体：块 在 函数声明.子终点（块索引）
    布尔 体终止72 = 假;
    如果 (块索引 < 池.大小()) {
        体终止72 = 生成块(池, 块索引, 函数信息.局部槽, 函数信息.参数槽, 函数信息,
                          &寄存器计数, &槽计数, 表达式栈, 函数信息.返回类型);
    }
    // 缺陷A根治：函数尾块——fall-through 与全部 返回 汇聚于此（epilogue 唯一）。
    //   体末的 跳转 对已 返回 的路径是死代码（无害），对 fall-through 路径必经。
    // 72-a（2026-09-11 第七十二轮根治）：函数落空路径（体末无 返回 语句——
    //   fall-through 直达函数尾块）的 RAII 出口释放。原实现只在 返回 语句路径
    //   （生成返回语句 三出口）发射 发射容器析构/发射字符串释放，落空路径
    //   完全不释放=拥有串/容器局部随栈帧销毁永久泄漏（探针实证：`函数 落空()
    //   { 字符串 甲 = 造串(); }` 的 asm 无 __cn_str_free）。Rust 语义=函数体
    //   末尾隐式 drop。**仅在体块未终止（未被 返回/中断/继续 提前终止）时发射**
    //   ——已终止的路径各自在 生成返回语句 里释放并跳尾块，此处再释放即
    //   二次释放（v2 释放路径不清零槽——210_v2/196_v2 首版实证退出码归零=
    //   返回值被误释放）。
    如果 (!体终止72) {
        发射容器析构(函数信息, 函数信息.指令, &寄存器计数, 函数信息.局部槽, 0);
        发射字符串释放(函数信息, 函数信息.指令, &寄存器计数, 函数信息.局部槽, 0);
    }
    发射跳转(函数信息, 函数信息.函数尾块);
    切换块(函数信息, 函数信息.函数尾块);
    发射块标签(函数信息, 函数信息.函数尾块);
    函数信息.retbuf字节数 = 取retbuf字节数();    // ②b B6：回填（扫描函数 据此定 retbuf 帧区）
    返回 函数信息;
}


// 211-a（2026-09-15 第两百一十一轮，D1 行数整改）：函数IR 字段显式初始化集（裸声明
//   字段无默认构造——lessons 权重7：不初始化即空指针/垃圾，v2p 半成品构建即崩根因）。
函数 初始化函数信息字段(函数IR& 函数信息) -> 空类型 {
    // 结构体裸声明不调用字段默认构造——容器字段须显式初始化（否则 .追加/.设置 空指针/垃圾）
    函数信息.指令 = 向量<IR指令>();
    函数信息.局部槽 = 映射<整64, 整64>();
    函数信息.参数槽 = 映射<整64, 整64>();
    函数信息.变量类型 = 映射<整64, 整64>();
    // plans/019 阶段4' 第二批：拥有型字符串名单/污染名单（裸声明字段须显式
    //   初始化——否则 .追加/.获取 空指针/垃圾，v2p 半成品构建即崩的根因）
    函数信息.字符串变量们 = 向量<整64>();
    函数信息.字符串数组变量们 = 向量<整64>();   // 98-a（C9）：字符串元素数组名单
    函数信息.循环数组串基线 = 0;                 // 98-a：跳出释放基线（同 循环串基线）
    函数信息.字符串污染们 = 映射<整64, 整64>();
    函数信息.容器变量们 = 向量<整64>();
    函数信息.资源字段局部们 = 向量<整64>();
    函数信息.资源字段结构体们 = 向量<整64>();
    函数信息.参数槽序们 = 向量<整64>();
    函数信息.参数拷贝字节们 = 向量<整64>();
    // 91-a：参数类型码表（序言装载寄存器类分派；裸声明字段须显式初始化）
    函数信息.参数类型们 = 向量<整64>();
    // 73-a（2026-09-11 方案A 用户裁决）：释放点清零寄存器（预扫回填；无资源
    //   声明保持 0=无清零）——裸声明字段无默认构造，须显式初始化（lessons 权重7）
    函数信息.零寄存器 = 0;
}

// 211-a：签名键名+返回相关字段初始化——签名键（plans/018 第 4 层链接键）/返回类型/
//   引用返回（尾 &）/结构体返回 retbuf 槽保留（E2E 148）/结果返回 retbuf ABI（71-a）。
函数 初始化签名与返回字段(向量<节点> 池, 节点 函数声明, 整32 函数节点, 字符串 模块路径, 函数IR& 函数信息) -> 空类型 {
    // 呈报③方案A（2026-09-06）：函数 IR 名=签名键 名#参数串——跨文件同名重载
    //   asm 符号消歧（三后端 符号修饰 已支持 '#' 参数串类型编码，P7b 容器方法
    //   同链路验证；无参=纯名，与宿主 signatureKey/附录C 一致）
    // plans/018 第 4 层（2026-09-07）：定义侧升级链接键（键基#参数串，键基=
    //   主模块纯名/其余 模块$名）——与调用侧 决议函数符号 产物同公式同源
    //   （宿主 functionLinkKey 唯一归属对齐），跨模块同名同签名 asm 符号
    //   天然隔离；主模块/单文件形态逐字节不变（v2self 对拍硬基准）
    函数信息.名字 = 整32(函数签名键(键基合成(模块路径, 整64(函数声明.文本)),
                                    函数参数串(池, 函数节点)));
    设置当前生成符号ID(整64(函数信息.名字));   // 422-a：诊断宿主定位临时代码（定位后删）
    函数信息.返回类型 = 类型码(整64(函数声明.附加));
    函数信息.返回结果名ID = 0;   // 71-a：裸声明字段无默认构造——显式初始化（lessons 权重7）
    // 引用返回（2026-09-04 缺陷零容忍收口，宿主 P3-18 对齐）：返回类型名尾 '&'
    //   （-> 整64&，语法层已并入）——返回语句按左值地址发射
    字符串 返回类型名r = 字符串复制(驻留文本(整64(函数声明.附加)));
    如果 (字符串长度(返回类型名r) > 0 &&
         字符串比较(字符串子串(返回类型名r, 字符串长度(返回类型名r) - 1, 1), "&")) {
        函数信息.返回引用 = 1;
    }
    // 用户函数返回结构体（2026-09-04，E2E 148）：被调方槽 1 保留（调用方传入的
    //   retbuf 指针——prologue 位0 rcx 存入；IR_分配 附加=1 占位使帧扫描计入）
    如果 (查结构体大小(整64(函数声明.附加)) != 0) {
        函数信息.返回结构体ID = 整64(函数声明.附加);
        IR追加(函数信息.指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 1));
    }
    // 71-a（2026-09-11 方案A 用户裁决）：用户函数返回 结果/可选——与结构体返回
    //   同款 retbuf ABI（结构体表查不到结果合成名，独立字段判定）：槽 1=retbuf
    //   指针保留（IR_分配 附加=1 占位）、返回语句把装箱值/结果变量拷入 retbuf、
    //   rax=retbuf；调用方（发射普通函数调用）位 0 装载 retbuf（互操作面：
    //   宿主 stdlib 包装返回 结果<> 同 ABI——布局 正常@0+值@4/8 双侧一致）
    如果 (函数信息.返回结构体ID == 0 &&
         是结果类型(字符串复制(驻留文本(整64(函数声明.附加))))) {
        函数信息.返回结果名ID = 整64(函数声明.附加);
        IR追加(函数信息.指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 1));
    }
    设当前函数返回结果名ID(函数信息.返回结果名ID);   // 430-b（族③）装箱语境（含 0 复位）
}


// 单个参数槽登记（R3 拆分，2026-09-08 自 生成函数 机械搬移）：类型附加位分派——
//   引用(>=256)单槽存地址 / 指针(1..255)单槽直存（第17枚）/ 结构体按值多槽（B8）/
//   标量单槽；登记 槽序/拷贝字节（prologue 契约）+ 引用/指针/类型权威表。
不安全 函数 登记参数槽(向量<节点> 池, 节点 参数, 函数IR& 函数信息, 整64* 槽计数) -> 空类型 {
        // ②b B8：结构体按值参数——多槽（槽数=ceil(大小/8)，基址槽=最大槽号=最低
        //   地址，与 B1 局部同约定）；标量单槽。声明序登记 槽序/拷贝字节——
        //   双后端 prologue 据此：标量直存寄存器值；结构体从指针入参拷贝入槽。
        //   ②c D：& 引用参数——槽存调用方左值地址（跳过多槽拷贝：拷贝字节 0、
        //   单槽），登记 引用参数槽们/类型们（读取分流发射）
        整64 拷贝字节 = 0;
        整64 参数槽数 = 1;
        布尔 是引用参数 = 假;
        节点 参数类型节点 = 参数;
        // 守卫用 >= 0（lessons 池索引 0 合法）：首函数首参数的类型节点恰在
        //   池索引 0 时，原 > 0 漏解析——指针登记随之漏（min 探针实锤）
        如果 (参数.附加 >= 0 && 参数.附加 < 池.大小()) {
            节点 参数类型候选 = 池.元素(整32(参数.附加));
            如果 (参数类型候选.类型 == 节点_类型) {
                参数类型节点 = 参数类型候选;
                如果 (参数类型节点.附加 >= 256) {
                    是引用参数 = 真;
                } 否则 {
                    // ③ 第三波：指针参数登记（附加=指针层数 1..255——槽存指针值
                    //   单槽，下标读写按所指元素宽度步进；引用 >=256 不入）
                    如果 (参数类型节点.附加 >= 1) {
                        登记指针变量类型(整64(参数.文本), 整64(参数类型节点.文本));
                        // 第17枚根治（2026-09-06）：指针参数=单槽直存指针值（拷贝
                        //   字节保持 0=寄存器直存路径）——不按结构体大小多槽分配+
                        //   prologue 解引用拷贝（方法签名* 旧按 32 字节 4 槽解引用
                        //   拷贝 -> 出.基槽=*签 首 8 字节（签.参数串 值）而非签地址
                        //   -> 成员写空指针/写穿相邻槽）
                        拷贝字节 = 0;
                        参数槽数 = 1;
                    } 否则 {
                        整64 结构大小 = 查结构体大小(整64(参数类型节点.文本));
                        如果 (结构大小 != 0) {
                            拷贝字节 = 结构大小;
                            参数槽数 = (结构大小 + 7) / 8;
                        }
                    }
                }
            }
        }
        整64 槽 = 槽计数[0];
        槽计数[0] = 槽计数[0] + 参数槽数;
        结果<空类型, 整32> 设参 = 函数信息.参数槽.设置(整64(参数.文本), 槽 + 参数槽数 - 1);
        如果 (!设参.正常) { 运行时错误(4); }
        结果<空类型, 整32> 加槽序 = 函数信息.参数槽序们.追加(槽 + 参数槽数 - 1);
        如果 (!加槽序.正常) { 运行时错误(4); }
        结果<空类型, 整32> 加拷贝 = 函数信息.参数拷贝字节们.追加(拷贝字节);
        如果 (!加拷贝.正常) { 运行时错误(4); }
        // 91-a（2026-09-13 第九十一轮）：参数类型码登记（序言装载寄存器类分派）
        //   ——纯标量类型名（整/浮/布尔/字符/字符串）保留自身类型码（T_浮32/
        //   T_浮64 走 xmm/d 浮点寄存器类，SysV/AAPCS64 双计数）；地址传递
        //   形态（引用参数/指针参数/结构体按值多槽）与未知类型码一律 T_整64
        //   （值即地址/整数寄存器类）。
        整64 参类型码 = T_整64;
        如果 (参数类型节点.类型 == 节点_类型 && 参数类型节点.附加 == 0 &&
             拷贝字节 == 0) {
            整64 参标量码 = 类型码(整64(参数类型节点.文本));
            如果 (参标量码 != T_未知) { 参类型码 = 参标量码; }
        }
        结果<空类型, 整32> 加参类 = 函数信息.参数类型们.追加(参类型码);
        如果 (!加参类.正常) { 运行时错误(4); }
        如果 (是引用参数) {
            登记引用参数槽(槽 + 参数槽数 - 1);
            登记引用参数类型(槽 + 参数槽数 - 1, 整64(参数类型节点.文本));
        }
        // 第17枚根治：结构体指针参数（类型节点附加=指针层 1..255）登记指针槽
        //   ——成员访问 p.字段 基址=装载槽值（指针解引用），见 槽是指针参数
        如果 (!是引用参数 && 参数类型节点.附加 >= 1 && 参数类型节点.附加 < 256) {
            登记指针参数槽(槽 + 参数槽数 - 1);
        }
        // P7b：容器/结果参数登记类型（方法调用的对象类型解析用）；
        //   容器参数不 RAII 析构（按值传=浅共享指针，被调方不拥有）。
        //   ②c D：全部参数类型入 函数级变量类型权威表（含 结构体 值/引用——
        //   跨函数同名异型根治）。守卫 >= 0：首函数首参数类型节点可恰在池 0
        如果 (参数.附加 >= 0 && 参数.附加 < 池.大小()) {
            字符串 参数类型文本 = 字符串复制(驻留文本(整64(参数类型节点.文本)));
            如果 (是容器类(参数类型文本) || 是结果类型(参数类型文本)) {
                结果<空类型, 整32> 设参类 = 函数信息.变量类型.设置(整64(参数.文本),
                                                        整64(参数类型节点.文本));
                如果 (!设参类.正常) { 运行时错误(4); }
                登记当前函数变量类型(整64(参数.文本), 整64(参数类型节点.文本));
            } 否则 {
                如果 (查结构体大小(整64(参数类型节点.文本)) != 0) {
                    登记当前函数变量类型(整64(参数.文本), 整64(参数类型节点.文本));
                } 否则 {
                    // ③ 缺陷①根治：标量参数（字符串/浮点/布尔/整数）入权威表
                    //   （与标量局部同——打印分派/拼接转换消费）
                    登记当前函数变量类型(整64(参数.文本), 整64(参数类型节点.文本));
                }
            }
        }
}

// 入口函数（主）静态初始化注入（R3 拆分；87-a 扩展结构体面）：
//   ① 容器/类静态：NewObject+构造+IR_静态存储 存指针进 .data 槽（P3-8 指针槽）；
//   ② 标量静态：初始值已在 .data 直存，跳过（零运行期开销）；
//   ③ 87-a（2026-09-12 第八十七轮）结构体静态：有初值区间 → 生成表达式物化
//      （结构体字面量=临时槽逐字段构造/字段串归一化；表达式=求值）→ 目标
//      = .data 符号地址（IR_静态地址）+ 整体拷贝（深拷=真：源为栈临时，
//      字段串独立落堆；先释放=假：首次初始化 .data 槽零值无旧句柄）。
//      无初值 → 跳过（.data 零 = 结构体零值，语义正确）。
不安全 函数 注入主函数静态初始化(向量<节点> 池, 函数IR& 函数信息, 整64* 寄存器计数,
                        整64* 槽计数, 向量<整64>& 表达式栈) -> 空类型 {
    整64 s序 = 0;
    当 (s序 < 取静态数()) {
        整64 静态类型ID = 取静态类型(s序);
        字符串 静态类型文本 = 字符串复制(驻留文本(静态类型ID));
        如果 (是容器类(静态类型文本)) {
            整64 obj寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_分配对象, 0, 0, 0, obj寄存器,
                                                 容器对象大小(静态类型文本), 静态类型ID));
            IR追加(函数信息.指令, 建IR指令(IR_调用实参, obj寄存器, 0, 0, 0, 0, 0));
            IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                                 驻留(构造符号(静态类型文本))));
            IR追加(函数信息.指令, 建IR指令(IR_静态存储, obj寄存器, 0, 0, 0, 0, s序));
        } 否则 如果 (查结构体大小(静态类型ID) > 0) {
            // 87-a：结构体静态初值注入
            整64 初值起i = 取静态初值起点(s序);
            整64 初值止i = 取静态初值终点(s序);
            如果 (初值起i >= 0 && 初值止i > 初值起i) {
                生成表达式(池, 整32(初值起i), 整32(初值止i), 函数信息.局部槽,
                          函数信息.参数槽, 函数信息.指令, 寄存器计数,
                          &函数信息.块计数, 槽计数, 表达式栈);
                整64 源地址i = 0;
                如果 (表达式栈.大小() > 0) {
                    源地址i = 表达式栈.元素(表达式栈.大小() - 1);
                    结果<空类型, 整32> 删源i = 表达式栈.删除(表达式栈.大小() - 1);
                    如果 (!删源i.正常) { 运行时错误(4); }
                }
                整64 目标地址i = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(函数信息.指令, 建IR指令(IR_静态地址, 0, 0, 0, 目标地址i,
                                                     T_整64, s序));
                发射结构体整体拷贝(函数信息, 寄存器计数, 目标地址i, 源地址i,
                                  静态类型ID, 真, 假);
            }
        } 否则 如果 (取静态需注入(s序)) {
            // 87-a（2026-09-12 第八十七轮）：初值物化注入（8 字节值语义）——
            //   覆盖 ①字符串（字面量=驻留常量地址零分配；表达式=求值）；
            //   ②折叠失败的标量（布尔/浮点/字符字面量——折叠常量值 只认整数
            //   文本，原实现静默落 .data 0=初值丢失：探针实证 布尔=假/浮=0）。
            //   .data 槽保持 0，入口求值后 IR_静态存储 写回。
            整64 初值起s = 取静态初值起点(s序);
            整64 初值止s = 取静态初值终点(s序);
            如果 (初值起s >= 0 && 初值止s > 初值起s) {
                生成表达式(池, 整32(初值起s), 整32(初值止s), 函数信息.局部槽,
                          函数信息.参数槽, 函数信息.指令, 寄存器计数,
                          &函数信息.块计数, 槽计数, 表达式栈);
                整64 串值reg = 0;
                布尔 串有值 = 假;
                如果 (表达式栈.大小() > 0) {
                    串值reg = 表达式栈.元素(表达式栈.大小() - 1);
                    串有值 = 真;
                    结果<空类型, 整32> 删串s = 表达式栈.删除(表达式栈.大小() - 1);
                    如果 (!删串s.正常) { 运行时错误(4); }
                }
                如果 (串有值) {
                    IR追加(函数信息.指令, 建IR指令(IR_静态存储, 串值reg, 0, 0, 0,
                                                         T_字符串, s序));
                }
            }
        }
        s序++;
    }
}


// ==================== 程序遍历 ====================
// 从 程序 节点生成 程序IR（所有函数）。
函数 IR生成(向量<节点> 池, 整32 程序节点) -> 程序IR {
    程序IR 程序;
    // 结构体裸声明不调用字段默认构造——容器字段须显式初始化（否则 .追加 空指针/垃圾）
    程序.函数们 = 向量<函数IR>();
    程序.静态初始值们 = 向量<整64>();
    程序.静态数 = 0;
    清空常量表();           // P7a：常量表任务级生命周期（入口清空，幂等）
    收集常量(池, 程序节点, "主");   // plans/018 常量分桶：单文件=主模块
    清空函数签名();          // 呈报③方案A：函数签名表任务级生命周期（入口清空）
    收集函数签名(池, 程序节点, "主");   // 呈报③方案A：先签名表（单文件=主模块）
    清空实参与返回类型表();  // ②b B8/③第二波：任务级生命周期（入口清空）
    收集函数实参结构(池, 程序节点, "主");
    收集函数返回类型(池, 程序节点, "主");
    清空引用参数表();        // ②c D：任务级生命周期
    清空静态表();            // ②c C：任务级生命周期（入口清空，幂等）
    收集静态(池, 程序节点, 程序.静态初始值们);
    程序.静态数 = 取静态数();
    节点 程序声明 = 池.元素(程序节点);
    整64 位置 = 整64(程序声明.子起点);
    整64 终点 = 整64(程序声明.子终点);
    当 (位置 < 终点) {
        节点 声明 = 池.元素(整32(位置));
        如果 (声明.类型 == 节点_函数) {
            // 419-a：泛型函数单态化分派（与多文件版同款·单文件形态）
            如果 (查泛型基类参数序(整64(声明.文本)) != 0) {
                整64 nfs = 泛型实例函数节点们.大小();
                整64 ifs = 0;
                当 (ifs < nfs) {
                    节点 克隆声明gs = 池.元素(整32(泛型实例函数节点们.元素(ifs)));
                    如果 (字符串比较(剥实例基名(字符串复制(驻留文本(整64(克隆声明gs.文本)))), 字符串复制(驻留文本(声明.文本)))) {
                        函数IR 函数信息gs = 生成函数(池, 整32(泛型实例函数节点们.元素(ifs)), "主");
                        结果<空类型, 整32> 加gs = 程序.函数们.追加(函数信息gs);
                        如果 (!加gs.正常) { 运行时错误(4); }
                    }
                    ifs++;
                }
            } 否则 {
                函数IR 函数信息 = 生成函数(池, 整32(位置), "主");
                结果<空类型, 整32> 加 = 程序.函数们.追加(函数信息);
                如果 (!加.正常) { 运行时错误(4); }
            }
        }
        如果 (声明.类型 == 节点_类) {
            // 第七十八轮（2026-09-12）：用户类方法生成（单文件形态）
            生成类方法们(池, 整32(位置), "主", 程序);
        }
        位置++;
    }
    返回 程序;
}

// ==================== 程序遍历（多文件 P6h + 模块链接键 plans/018 第 4 层） ====================
// 多源文件：遍历全部 程序 节点的函数声明，合并进同一 程序IR（函数们 顺序 = 文件
//   加载顺序）。模块路径们 = 每文件模块路径（主.cn 加载器收集，与 程序节点们
//   平行）——定义侧链接键（键基#参数串）与收集表键基均按此合成。
函数 IR生成多文件(向量<节点> 池, 向量<整32> 程序节点们, 向量<字符串>& 模块路径们) -> 程序IR {
    程序IR 程序;
    // IR 层错误计数任务级清空（2026-09-04，IR 层错误即中止纪律——主.cn 检查点）
    清空IR层错误计数();
    // 结构体裸声明不调用字段默认构造——容器字段须显式初始化（否则 .追加 空指针/垃圾）
    程序.函数们 = 向量<函数IR>();
    程序.静态初始值们 = 向量<整64>();
    程序.静态数 = 0;
    清空常量表();           // P7a：常量表任务级生命周期（入口清空；全部文件依次收集）
    清空函数签名();          // 呈报③方案A：函数签名表任务级生命周期（全部文件依次收集）
    清空实参与返回类型表();  // ②b B8/③第二波：任务级生命周期（全部文件依次收集）
    清空引用参数表();        // ②c D：任务级生命周期
    清空静态表();            // ②c C：任务级生命周期（全部文件依次收集）
    整64 f = 0;
    当 (f < 程序节点们.大小()) {
        收集常量(池, 程序节点们.元素(整32(f)), 模块路径们.元素(整32(f)));   // plans/018 常量分桶：按文件键基登记
        收集函数签名(池, 程序节点们.元素(整32(f)), 模块路径们.元素(整32(f)));
        收集函数实参结构(池, 程序节点们.元素(整32(f)), 模块路径们.元素(整32(f)));
        收集函数返回类型(池, 程序节点们.元素(整32(f)), 模块路径们.元素(整32(f)));
        收集静态(池, 程序节点们.元素(整32(f)), 程序.静态初始值们);
        f++;
    }
    程序.静态数 = 取静态数();
    // 416-a（D42 波 2）：泛型类实例收集（线性扫类型节点）+实例注册（克隆类节点/
    //   布局/方法表·须在生成主循环前——主函数生成的方法调用查实例表命中）
    收集泛型实例(池, 程序节点们);
    实例化注册(池, 程序节点们);
    实例化函数注册(池, 程序节点们, 模块路径们.元素(整32(0)));   // 419-a：函数实例克隆编排
    收集实例方法实参引用(池);   // 432-b：实例方法 引用/结构体实参位（须在克隆后·生成前）
    f = 0;
    当 (f < 程序节点们.大小()) {
        节点 程序声明 = 池.元素(程序节点们.元素(整32(f)));
        整64 位置 = 整64(程序声明.子起点);
        整64 终点 = 整64(程序声明.子终点);
        当 (位置 < 终点) {
            节点 声明 = 池.元素(整32(位置));
            如果 (声明.类型 == 节点_函数) {
                // 419-a（D42 波 3）：泛型函数——本体跳过（T 布局不真实）·对实例
                //   克隆体生成（符号自动含实例参数·调用侧 callee 合成名一致）
                如果 (查泛型基类参数序(整64(声明.文本)) != 0) {
                    // 遍历函数节点表自身（零全集索引错位——419 越界归因修复）
                    整64 nf = 泛型实例函数节点们.大小();
                    整64 iff = 0;
                    当 (iff < nf) {
                        节点 克隆声明gf = 池.元素(整32(泛型实例函数节点们.元素(iff)));
                        如果 (字符串比较(剥实例基名(字符串复制(驻留文本(整64(克隆声明gf.文本)))), 字符串复制(驻留文本(声明.文本)))) {
                            函数IR 函数信息g = 生成函数(池, 整32(泛型实例函数节点们.元素(iff)), 模块路径们.元素(整32(f)));
                            结果<空类型, 整32> 加g = 程序.函数们.追加(函数信息g);
                            如果 (!加g.正常) { 运行时错误(4); }
                        }
                        iff++;
                    }
                } 否则 {
                    函数IR 函数信息 = 生成函数(池, 整32(位置), 模块路径们.元素(整32(f)));
                    结果<空类型, 整32> 加 = 程序.函数们.追加(函数信息);
                    如果 (!加.正常) { 运行时错误(4); }
                }
            }
            如果 (声明.类型 == 节点_类) {
                // 第七十八轮（2026-09-12）：用户类方法生成（多文件主链形态）
                生成类方法们(池, 整32(位置), 模块路径们.元素(整32(f)), 程序);
            }
            位置++;
        }
        f++;
    }
    返回 程序;
}