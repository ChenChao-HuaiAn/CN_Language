公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

不安全 函数 收集函数实参结构(向量<节点> 池, 整32 程序节点, 字符串 模块路径) -> 空类型 {
    节点 程序 = 池.元素(程序节点);
    整64 位置 = 整64(程序.子起点);
    当 (位置 < 整64(程序.子终点)) {
        节点 声明 = 池.元素(整32(位置));
        如果 (声明.类型 == 节点_函数) {
            // 738（容器模板形参·可选<T>/结果<T,E> 分叉根治）：泛型函数**模板态
            //   本体**整体跳过 ABI 登记——本体不生成代码（419-a 主循环同款判定
            //   查泛型基类参数序），其形参含类型参数名（可选<T> 的载荷=T）时
            //   是结果类型→结果大小→结果载荷字节("T") 三链必炸（载荷豁免表无
            //   裸类型参数名·648 显形化中止）；且本体登记键=基函数键，与实例
            //   克隆体键（实例合成名）不同——表项对克隆体零消费。克隆体的
            //   128 位/引用实参位由实例化注册伴随段 登记克隆体128位形参
            //   （415-r/425 双键）补挂，语义不变。421 先例（收集泛型实例文本
            //   类实例实参段含泛型参数名=延迟拦截）同构口径：模板态不进
            //   具体类型求宽通道。
            // 1541 B2：有值=泛型函数模板本体（原 !=0 判据）
            可选<整64> 泛序查738 = 查泛型基类参数序(整64(声明.文本));
            如果 (泛序查738.有值) {
                位置++;
                继续;
            }
            // 参数区间 = [函数.子起点, 块.子起点)（块 在 函数.子终点=块索引）
            整64 参数终点 = 整64(声明.子起点);
            如果 (声明.子终点 < 池.大小()) {
                节点 块节点 = 池.元素(声明.子终点);
                参数终点 = 整64(块节点.子起点);
            }
            // 呈报③方案A：双键基——签名键恒有；纯名键同名唯一时才有（主模块）
            整64 键基p = 键基合成(模块路径, 整64(声明.文本));
            整64 签名键 = 函数签名键(键基p, 函数参数串(池, 整32(位置)));
            整64 纯名键 = 0;
            如果 (是主模块路径(模块路径)) {
                结果<整64, 整32> 查唯数 = 查函数签名个数(键基p);
                如果 (查唯数.正常) {
                    如果 (查唯数.值 == 1) { 纯名键 = 整64(声明.文本); }
                }
            }
            整64 参数序 = 0;
            整64 参数位置 = 整64(声明.子起点);
            当 (参数位置 < 参数终点) {
                节点 参数 = 池.元素(整32(参数位置));
                如果 (参数.类型 == 节点_参数) {
                    // 守卫用 >= 0（lessons 池索引 0 合法——生成函数 同款）：首函数
                    //   首参数的类型节点恰在池索引 0 时，原 > 0 漏登记——mapref 探针
                    //   实锤（灌 的 映射& 表 引用实参位漏收集→调用方不取址→被调方
                    //   双重解引用读垃圾→映射对象状态坏崩溃）
                    如果 (参数.附加 >= 0 && 参数.附加 < 池.大小()) {
                        节点 参数类型节点 = 池.元素(整32(参数.附加));
                        // 595-a（001-001 fix5b·自由函数版 同上）：容器实参句柄直传。
                        // 810（053）：128 位形参位——登记 函数实参128位们（回扫
                        //   物化 64 位值实参为地址句柄）
                        字符串 参类型名128 = 字符串复制(驻留文本(整64(参数类型节点.文本)));
                        如果 (参数类型节点.附加 == 0 &&
                             (字符串比较(参类型名128, "整128") ||
                              字符串比较(参类型名128, "正128"))) {
                            结果<空类型, 整32> 设128 = 函数实参128位们.设置(
                                签名键 * 键位移 + 参数序, 1);
                            如果 (!设128.正常) { 运行时错误(4); }
                            如果 (纯名键 != 0) {
                                结果<空类型, 整32> 设128n = 函数实参128位们.设置(
                                    纯名键 * 键位移 + 参数序, 1);
                                如果 (!设128n.正常) { 运行时错误(4); }
                            }
                        }
                        // 1887（#1396 ③宽化通道配套）：浮点形参位登记 浮码表
                        //   （键公式同 函数实参结构们·值=T_浮32/T_浮64 形参码）
                        //   ——调用点 发射浮点实参宽化 消费：实参登记 T_浮32 +
                        //   形参 T_浮64 → cvtss2sd 数值宽化（352 面按后缀发
                        //   浮32 位模式直传浮64 形参槽=位模式垃圾，1654 第4行
                        //   win 面 0.000000 实锚）。仅值传（附加==0）面登记。
                        如果 (参数类型节点.附加 == 0 &&
                             (字符串比较(参类型名128, "浮32") ||
                              字符串比较(参类型名128, "浮64"))) {
                            整64 形参浮码 = 字符串比较(参类型名128, "浮32")
                                             ? T_浮32 : T_浮64;
                            结果<空类型, 整32> 设形参浮码 = 函数实参浮码们.设置(
                                签名键 * 键位移 + 参数序, 形参浮码);
                            如果 (!设形参浮码.正常) { 运行时错误(4); }
                            如果 (纯名键 != 0) {
                                结果<空类型, 整32> 设形参浮码纯名 = 函数实参浮码们.设置(
                                    纯名键 * 键位移 + 参数序, 形参浮码);
                                如果 (!设形参浮码纯名.正常) { 运行时错误(4); }
                            }
                        }
                        // 111（919 轮）：**指针层守卫**——类型节点 附加>=1
                        //   （盒子* 形参·星在附加·文本=剥星基名）原误命中
                        //   查结构体大小(盒子)→登记「结构体按值实参」→调用方
                        //   B3 回扫取地址传 &p；被调按标量通道收（附加=1）→
                        //   槽存地址≠指针值→返回/读值错值（561 实测 gdb 定案）。
                        //   指针形参=标量通道（rax 直传指针值·整64* 同款）。
                        // 1011（408/551·合成体按值实参宽度分档）：**结果类合成体
                        //   总宽 >8**（结果<整32,整32>=16）同登结构体表——被调方
                        //   prologue rep movsb 按源地址拷全宽，调用侧须回扫取地址
                        //   传槽基址；可选<整32>=8 不登（寄存器值传·t7 ABI）。
                        //   原判据漏合成体（查结构体大小 对结果名 miss）→标识符
                        //   实参 IR_加载 首 8 字节值传→被调 rep movsb 解引用打包
                        //   值（fault=0x2900000001=正常(41) 打包·408/551 实锤）。
                        布尔 合成体宽登记1011 = 假;
                        字符串 参数类型名1011 = 字符串复制(驻留文本(整64(参数类型节点.文本)));
                        如果 (参数类型节点.附加 == 0 &&
                             是结果类型(参数类型名1011) &&
                             结果大小(参数类型名1011) > 8) {
                            合成体宽登记1011 = 真;
                        }
                        // 087b（#087 余量·宿主 82984e4bbe 同构）：数组形参位——
                        //   B8 表登记（回扫结构体与引用实参 表驱动→回扫实参取地址
                        //   传源数组地址；被调 prologue 参数拷贝字节们 整块拷——
                        //   生成函数 登记参数槽 数组分支配对）。
                        布尔 数组形参登记087b = 假;
                        如果 (参数类型节点.附加 == 0 &&
                             是数组类型文本(参数类型名1011)) {
                            数组形参登记087b = 真;
                        }
                        // 414 P1-1（审查·595-a/类方法面 同族对称）：用户类实例
                        //   实参=句柄直传（不取地址不按值拷）——自由函数类参数原
                        //   按结构体大小登记结构位→调用方取地址+被调 prologue 拷
                        //   类字段宽度字节=截断 8 字节句柄（与 25/340 类方法面
                        //   同病·宿主指针模型同构）。
                        如果 (参数类型节点.附加 == 0 &&
                             !是容器类(驻留文本(整64(参数类型节点.文本))) &&
                             !是用户类ID(整64(参数类型节点.文本)) &&
                             (是结构体大小非零(整64(参数类型节点.文本)) ||
                              合成体宽登记1011 || 数组形参登记087b)) {
                            结果<空类型, 整32> 设结 = 函数实参结构们.设置(
                                签名键 * 键位移 + 参数序, 1);
                            如果 (!设结.正常) { 运行时错误(4); }
                            如果 (纯名键 != 0) {
                                结果<空类型, 整32> 设结n = 函数实参结构们.设置(
                                    纯名键 * 键位移 + 参数序, 1);
                                如果 (!设结n.正常) { 运行时错误(4); }
                            }
                        }
                        // ②c D：引用形参（类型节点 附加=引用*256）——调用方传左值地址
                        如果 (参数类型节点.附加 >= 256) {
                            结果<空类型, 整32> 设引 = 函数实参引用们.设置(
                                签名键 * 键位移 + 参数序, 1);
                            如果 (!设引.正常) { 运行时错误(4); }
                            如果 (纯名键 != 0) {
                                结果<空类型, 整32> 设引n = 函数实参引用们.设置(
                                    纯名键 * 键位移 + 参数序, 1);
                                如果 (!设引n.正常) { 运行时错误(4); }
                            }
                            // #1813：剥引用层判类——容器类/用户类引用位=堆对象表示
                            //   （实参为内联对象本体地址时须物化槽；标量/结构体直传）
                            如果 (是容器类(驻留文本(整64(参数类型节点.文本))) ||
                                 是用户类_ID(整64(参数类型节点.文本))) {
                                登记引用位物化槽(签名键 * 键位移 + 参数序);
                                如果 (纯名键 != 0) {
                                    登记引用位物化槽(纯名键 * 键位移 + 参数序);
                                }
                            }
                        }
                    }
                    参数序++;
                }
                参数位置++;
            }
        }
        位置++;
    }
}

// ==================== 用户函数返回类型表（③ 第二波，方案A 登记点补全 2026-09-03） ====================
// ③ 第一波登记点枚举漏「用户函数调用返回」——打印错分派 print_int（打指针值）、
//   拼接漏判/误转 from_int（指针转数字串）静默错误代码（asm 探针实锤；v2 组件
//   代码生成共用.cn:30/104 字节十六进制=符号修饰核心实际在用）。表：函数名ID ->
//   返回类型名ID（节点_函数.附加）。IR生成/IR生成多文件 入口收集（先于全部生成）。
静态 映射<整64, 整64> 函数返回类型们;

// 662（方法链消费位·2026-10-16）：函数返回类对象「拥有形态」标记表——候选=名ID
//   （全局唯一门槛：同名函数再次出现即转冲突=不可辨·保守不标记）；查询=函数
//   返回拥有662（生成方法调用 接收者=调用返回对象临时的析构判定）。
静态 映射<整64, 整64> 返回拥有候选们;
静态 映射<整64, 整64> 返回拥有冲突们;

// 1390（#1353 收口）：跨模块**裸名**调用返回类型回退表。多文件合并全局池下
//   语义层允许裸名解析到他模块函数（同包成员/导入面），但 函数返回类型们 的
//   键均是**定义模块键基**/签名键——「查函数返回回退」纯名+本模块键基两查对
//   裸名跨模块调用恒 miss → 结果/可选 返回的 `调用().正常/.有值` 成员偏移
//   未知 IR 中止（1390 最小探针复现：[ir2] 成员字段偏移未知: .正常；宿主
//   正常放行=宿主统一函数表无模块键基分隔，V2 单侧分叉）。
//   本表=名ID → 返回类型ID 全量收录；查询侧仅在**全局唯一名**（计数==1）时
//   采用——同名跨模块歧义维持原 miss=0 行为（不猜返回类型：错误 ABI 比 miss
//   更危险）。泛型函数模板本体不入（返回类型=类型参数占位 T，非具体 ABI，
//   与 738 实参登记口径同源）。
静态 映射<整64, 整64> 函数名全局计数1390;   // 名ID -> 跨模块声明次数
静态 映射<整64, 整64> 函数名全局返回1390;   // 名ID -> 返回类型ID（唯一名有效）

// 收集一个 程序 节点区间的全部函数声明的返回类型
// plans/018 第 4 层：签名键=链接键（键基#参数串）；键基无参键同名唯一时登记
//   （748②：原仅主模块，推广至全部模块——跨模块返回契约补全）
不安全 函数 收集函数返回类型(向量<节点> 池, 整32 程序节点, 字符串 模块路径) -> 空类型 {
    节点 程序 = 池.元素(程序节点);
    整64 位置 = 整64(程序.子起点);
    当 (位置 < 整64(程序.子终点)) {
        节点 声明 = 池.元素(整32(位置));
        如果 (声明.类型 == 节点_函数) {
            // 1390：跨模块裸名返回回退收录（全量计数 + 后写覆盖返回类型；
            //   唯一名判定在 查函数返回回退 查询侧）。泛型模板本体跳过——
            //   返回类型=类型参数占位（T）非具体 ABI，与 738 实参登记同源
            //   （查泛型基类参数序 由 收集函数签名 先行登记，本函数恒在其后）。
            // 1541 B2：无值=非泛型函数本体（原 ==0 判据）
            可选<整64> 泛序查1390 = 查泛型基类参数序(整64(声明.文本));
            如果 (!泛序查1390.有值) {
                结果<整64, 整32> 查计1390 = 函数名全局计数1390.获取(
                    整64(声明.文本));
                整64 计1390 = 0;
                如果 (查计1390.正常) { 计1390 = 查计1390.值; }
                结果<空类型, 整32> 设计1390 = 函数名全局计数1390.设置(
                    整64(声明.文本), 计1390 + 1);
                如果 (!设计1390.正常) { 运行时错误(4); }
                结果<空类型, 整32> 设返1390 = 函数名全局返回1390.设置(
                    整64(声明.文本), 整64(声明.附加));
                如果 (!设返1390.正常) { 运行时错误(4); }
            }
            // 呈报③方案A：双键——签名键恒登记（重载各键独立），键基无参键仅
            //   同名唯一时（既有纯名消费点零回归：解析调用返回结构体/拼接推导）。
            //   748②（零分叉·跨模块函数返回契约补全·2026-10-14）：无参键登记由
            //   「仅主模块」推广至**全部模块**——stdlib 用户模块函数（JSON::
            //   生成JSON/字符串扩展 族等）原仅登记签名键（键基#参数串），跨模块
            //   查询按 键基合成(模块,名)（无参键）恒 miss → 初始化位/赋值位把
            //   「跨模块函数返回拥有串」判借用（生成JSON 段每段净漏 1·728p 探针
            //   d8/d9=5、九形态每段固定 +1 实锤）。宿主统一函数表
            //   （functionLinkKey 无重载不拼 #·内建/用户同表）无此缺口。
            //   门槛与主模块既有策略同源：唯一签名（CN 无重载=常态）才登记；
            //   重载族保持 miss（返回异型为诚实边界·对齐宿主首候选口径）。
            整64 键基r = 键基合成(模块路径, 整64(声明.文本));
            整64 签名键 = 函数签名键(键基r, 函数参数串(池, 整32(位置)));
            结果<空类型, 整32> 设返 = 函数返回类型们.设置(签名键,
                                                         整64(声明.附加));
            如果 (!设返.正常) { 运行时错误(4); }
            结果<整64, 整32> 查唯返 = 查函数签名个数(键基r);
            如果 (查唯返.正常) {
                如果 (查唯返.值 == 1) {
                    结果<空类型, 整32> 设返n = 函数返回类型们.设置(键基r,
                                                                 整64(声明.附加));
                    如果 (!设返n.正常) { 运行时错误(4); }
                    // 662（方法链消费位）：类对象返回「拥有形态」标记收集（宿主
                    //   checkReturnOwnedClass662/FunctionInfo::returnsOwnedClass662
                    //   同构——唯一签名门槛与键基登记同源）。
                    收集返回拥有标记662(池, 整32(位置));
                }
            }
        }
        位置++;
    }
    // 1538（2026-10-25）：方法面拥有形态收集——与 自由函数面 662 收集同域同循环
    //   （覆盖主模块与跨模块全部程序节点·含后置类定义）。
    收集方法返回拥有标记1538(池, 程序节点);
}

// 662（方法链消费位·2026-10-16）：返回形态=拥有（本地标识符移出 / 类构造调用
//   新建）判定——顺序敏感（局部名集按语句序推进：返回语句之前的声明才计入，
//   后置声明不遮蔽先前返回的解析）。借用形态（参数/全局/静态/字段/下标/解引用/
//   透传调用/其余）=假（保守）。
不安全 函数 返回形态拥有662(向量<节点> 池, 节点 返回n, 向量<整64>& 局部IDs) -> 布尔 {
    如果 (返回n.子起点 >= 返回n.子终点) { 返回 假; }
    节点 末662 = 池.元素(整32(返回n.子终点 - 1));
    如果 (末662.类型 == 节点_标识符) {
        整64 名662 = 整64(末662.文本);
        整64 k662 = 0;
        当 (k662 < 局部IDs.大小()) {
            如果 (局部IDs.元素(k662) == 名662) { 返回 真; }
            k662++;
        }
        返回 假;   // 非局部（参数/全局/静态/字段）=借用
    }
    如果 (末662.类型 == 节点_调用 && 末662.子起点 > 0) {
        节点 被调662 = 池.元素(整32(末662.子起点));
        如果 (被调662.类型 == 节点_标识符 && 是用户类_ID(整64(被调662.文本))) {
            返回 真;   // 类构造调用=新建（拥有）
        }
        返回 假;   // 透传/其余调用=借用（跨函数所有权不可静态判定·保守）
    }
    返回 假;
}

// 662：函数返回类对象拥有形态收集（收集函数返回类型 循环内每函数调用一次）：
//   · 返回类型非用户类=不涉（构造/标量/指针/结构体不标记）。
//   · 扫体顶层语句（白名单放行：变量声明/返回语句/表达式语句/赋值/自增自减/
//     静态与常量声明——简单语句内不含 return；含控制流或未知类型=放弃本次
//     标记——全部返回路径无法静态确认=保守不标记·宁可泄漏不可误析构）。
//   · 全部返回语句均为拥有形态且存在返回语句 → 名ID 入候选；否则该名ID 入
//     冲突表（全局唯一门槛：同名再次出现即不可辨·候选与冲突互斥）。
// 1538（2026-10-25）：体扫描+落表内核提炼（键参数化·1538 方法面收集复用——
//   键=合成名「类名$方法名」；原函数改壳传 fn.文本·逐字零行为变化）。
不安全 函数 收集返回拥有标记662(向量<节点> 池, 整32 函数位) -> 空类型 {
    节点 fn662 = 池.元素(函数位);
    收集拥有标记落表内核1538(池, 函数位, 整64(fn662.文本));
}

// 1538 内核：拥有形态体扫描+候选/冲突落表（键调用方定——662 自由函数=裸名、
//   方法面=类名$方法名 合成键·键语法隔离不互撞）。扫描与落表逻辑自
//   收集返回拥有标记662 原体逐字搬移（名ID662→键ID1538 参数化）。
不安全 函数 收集拥有标记落表内核1538(向量<节点> 池, 整32 函数位, 整64 键ID1538) -> 空类型 {
    节点 fn662 = 池.元素(函数位);
    整64 名ID662 = 键ID1538;
    结果<整64, 整32> 旧冲662 = 返回拥有冲突们.获取(名ID662);
    如果 (旧冲662.正常) { 返回; } 否则 {
    }   // 静默豁免业务值: 未冲突=继续分析（业务分流·1360 批5 显形补）
    布尔 可行662 = 假;
    如果 (整64(fn662.附加) != 0 && 是用户类_ID(整64(fn662.附加))) {
        整32 体位662 = fn662.子终点;
        如果 (体位662 > 0 && 整64(体位662) < 整64(池.大小())) {
            节点 体662 = 池.元素(体位662);
            如果 (体662.类型 == 节点_块) {
                向量<整64> 局部IDs662 = 向量<整64>();
                布尔 全部拥有662 = 真;
                布尔 见返回662 = 假;
                整64 i662 = 整64(体662.子起点);
                // 线性扫体区间（嵌套块/条件体语句节点均含于体块子区间·池顺序
                //   追加——生成语句/形参被消耗 同源口径）：变量声明喂局部名集
                //   （顺序敏感），返回语句逐条判定（含嵌套返回——与宿主
                //   visitReturnStmt 全覆盖一致）；其余节点（表达式子节点/控制流/
                //   块）忽略——线性区间已含全部嵌套语句，无需下钻或放弃。
                当 (i662 < 整64(体662.子终点) && i662 < 整64(池.大小())) {
                    节点 s662 = 池.元素(整32(i662));
                    如果 (s662.类型 == 节点_变量声明) {
                        结果<空类型, 整32> 加l662 = 局部IDs662.追加(整64(s662.文本));
                        如果 (!加l662.正常) { 运行时错误(4); }
                    } 否则 如果 (s662.类型 == 节点_返回语句) {
                        见返回662 = 真;
                        如果 (!返回形态拥有662(池, s662, 局部IDs662)) { 全部拥有662 = 假; }
                    }
                    i662++;
                }
                可行662 = 见返回662 && 全部拥有662;
            }
        }
    }
    // 落表：可行=入候选（同名再出现转冲突）；不可行=入冲突（防后续同名可行者误标）
    结果<整64, 整32> 旧候662 = 返回拥有候选们.获取(名ID662);
    如果 (可行662 && !旧候662.正常) {
        结果<空类型, 整32> 设候662 = 返回拥有候选们.设置(名ID662, 1);
        如果 (!设候662.正常) { 运行时错误(4); }
        返回;
    }
    如果 (旧候662.正常) {
        布尔 删候662 = 返回拥有候选们.删除(名ID662);
    }
    否则 {
    }
    结果<空类型, 整32> 设冲662 = 返回拥有冲突们.设置(名ID662, 1);
    如果 (!设冲662.正常) { 运行时错误(4); }
}

// 1538（2026-10-25·方法面拥有形态收集·对称 662 自由函数面）：遍历顶层类声明，
//   实例方法（节点_方法·附加=返回类型ID 非零且=用户类）按 662 同款体扫描判定，
//   键=「类名$方法名」合成（与 克隆体符号 方法符号(类,名,参数串) 的基段同源；
//   无参键+同名再出现转冲突=重载族保守不标记，与 662 全局唯一门槛同构）。
//   静态方法排除（是类静态方法 表——宿主 classifyClassReturnOwnership 静态面
//   Conservative 不释放同口径·标记即语句位误删=分叉）。消费=1538 语句位类
//   临时释放的方法面甄别（函数返回拥有662 同表查询·键同构）。
不安全 函数 收集方法返回拥有标记1538(向量<节点> 池, 整32 程序节点) -> 空类型 {
    节点 程序1538 = 池.元素(程序节点);
    整64 位置1538 = 整64(程序1538.子起点);
    当 (位置1538 < 整64(程序1538.子终点)) {
        节点 声明1538 = 池.元素(整32(位置1538));
        如果 (声明1538.类型 == 节点_类) {
            字符串 类名文本1538 = 字符串复制(驻留文本(整64(声明1538.文本)));
            整64 成员位1538 = 整64(声明1538.子起点);
            当 (成员位1538 < 整64(声明1538.子终点) &&
                成员位1538 < 整64(池.大小())) {
                节点 成员1538 = 池.元素(整32(成员位1538));
                如果 (成员1538.类型 == 节点_方法 && 整64(成员1538.附加) != 0 &&
                     是用户类_ID(整64(成员1538.附加)) &&
                     !是类静态方法(整64(声明1538.文本), 整64(成员1538.文本))) {
                    字符串 方法名文本1538 = 字符串复制(
                        驻留文本(整64(成员1538.文本)));
                    整64 键1538 = 整64(驻留(类名文本1538 + "$" + 方法名文本1538));
                    收集拥有标记落表内核1538(池, 整32(成员位1538), 键1538);
                }
                成员位1538++;
            }
        }
        位置1538++;
    }
}

// 662：查询（生成方法调用 接收者析构判定）——名ID 在候选且不在冲突=拥有。
函数 函数返回拥有662(整64 名ID662) -> 布尔 {
    结果<整64, 整32> 冲662 = 返回拥有冲突们.获取(名ID662);
    // 冲突表命中=move 转交过=非拥有（查表否定回答）；miss 落候选表二级判定
    如果 (冲662.正常) { 返回 假; } 否则 { }
    结果<整64, 整32> 候662 = 返回拥有候选们.获取(名ID662);
    返回 候662.正常;
}

// 1538（2026-10-25）：被调符号拥有性甄别（类返回物化点登记面·宿主
//   classifyClassReturnOwnership 三分同构）——符号形态三分：
//   · 构造调用（符号=用户类ID）→ 拥有（新建产物）；
//   · 方法/克隆体（符号含 $·形态=类$方法[#参数串]）→ 剥 # 参数串后按
//     「类$方法」键查 662 双表（收集键同构）；
//   · 自由函数 → 剥 # 后查 662 双表。
//   miss/冲突/泛型实例（662 键 miss）=假（保守·不标记=实参位不释放，
//   宁漏勿错——与 662 全局唯一门槛同哲学）。非标识符形态不在此判（物化点
//   只有已合成符号）。
函数 函数返回拥有甄别(整64 符号ID判) -> 布尔 {
    如果 (是用户类_ID(符号ID判)) { 返回 真; }   // 构造调用=新建产物
    字符串 符号文本1538 = 字符串复制(驻留文本(符号ID判));
    整64 键1538 = 符号ID判;
    可选<整64> 井位1538 = 子串位置(符号文本1538, "#");
    如果 (井位1538.有值) {
        键1538 = 整64(驻留(字符串子串(符号文本1538, 0,
                                     整32(井位1538.值))));
    }
    如果 (字符串长度(驻留文本(键1538)) == 0) { 返回 假; }
    返回 函数返回拥有662(键1538);
}

// 回扫实参取地址（②b B3/B8 共用）：裸标识符实参的 IR_加载 回扫取源槽改发
//   IR_取地址（宿主 ABI：调用方传指针）；找不到（表达式实参）打印诊断（P7c）
不安全 函数 回扫实参取地址(向量<IR指令>& 指令, 向量<整64>& 弹出们, 整64 实i,
                    整64* 寄存器计数, 整64* 槽计数) -> 空类型 {
    整64 实reg = 弹出们.元素(弹出们.大小() - 1 - 实i);
    // 86-a（2026-09-12 复审缺陷①）：聚合地址化三元实参（登记 T_对象）——
    //   寄存器值**即选中 place 地址**（非值装载），回扫不得改写（改写会把
    //   「三元临时槽地址」当结构体基址传给被调方——P47-v2/t5_3 实证乱码）。
    可选<整64> 实码查 = 查寄存器类型(实reg);
    如果 (实码查.有值 && 实码查.值 == T_对象) { 返回; }
    整64 源槽 = 0;
    整64 回 = 指令.大小();
    当 (回 > 0) {
        IR指令 回扫 = 指令.元素(回 - 1);
        如果 (回扫.操作码 == IR_加载 && 回扫.目标 == 实reg) {
            源槽 = 回扫.操作数1;
            中断;
        }
        回--;
    }
    如果 (源槽 != 0) {
        整64 地址reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        // 引用局部（2026-09-04 IR生成.cn 冒烟根治）：实参=槽内容（绑定对象
        //   左值地址）——与标识符取槽地址的值语义形态分流
        如果 (槽是引用(源槽)) {
            IR追加(指令, 建IR指令(IR_加载, 源槽, 0, 0, 地址reg, T_整64, 0));
        } 否则 {
            IR追加(指令, 建IR指令(IR_取地址, 源槽, 0, 0, 地址reg, T_整64, 0));
        }
        结果<空类型, 整32> 改实 = 弹出们.设置(弹出们.大小() - 1 - 实i, 地址reg);
        如果 (!改实.正常) { 运行时错误(4); }
        返回;
    }
    // 指针加载形态（引用局部读/成员字段加载，2026-09-04）：发射引用参数读
    //   （IR_加载 槽→L + IR_指针加载 L→对象指针）与容器字段取载
    //   （IR_字段地址 + IR_指针加载）的目标实参，其 IR_指针加载.操作数1
    //   寄存器即「绑定对象/字段的左值地址」——直接复用（零新指令）。
    //   被 127 既有标识符形态不经过此路径（IR_加载.目标==实reg 先命中）。
    整64 回2 = 指令.大小();
    当 (回2 > 0) {
        IR指令 回扫2 = 指令.元素(回2 - 1);
        如果 (回扫2.操作码 == IR_指针加载 && 回扫2.目标 == 实reg) {
            结果<空类型, 整32> 改实2 = 弹出们.设置(弹出们.大小() - 1 - 实i, 回扫2.操作数1);
            如果 (!改实2.正常) { 运行时错误(4); }
            返回;
        }
        回2--;
    }
    // 字段地址形态（2026-09-06 结果载荷结构体根治）：实 reg 来源=IR_字段地址
    //   （查.值 结构体载荷——实参=字段地址本身），直接复用（实reg 已是左值地址）
    整64 回2f = 指令.大小();
    当 (回2f > 0) {
        IR指令 回扫2f = 指令.元素(回2f - 1);
        如果 (回扫2f.操作码 == IR_字段地址 && 回扫2f.目标 == 实reg) {
            返回;
        }
        回2f--;
    }
    // 调用返回形态（2026-09-04，E2E 148）：实 reg 来源=IR_调用参数化——返回
    //   结构体时 rax=retbuf 地址即结构体地址，按值实参恰好要传地址——实参
    //   数值本已正确，直接复用（原「结构体实参须为标识符」诊断对此形态为
    //   误报：v2 自身 IR追加(指令, 建IR指令(...)) 655 条实证）。
    整64 回3 = 指令.大小();
    当 (回3 > 0) {
        IR指令 回扫3 = 指令.元素(回3 - 1);
        如果 (回扫3.操作码 == IR_调用参数化 && 回扫3.目标 == 实reg) {
            返回;   // 实参保持 实reg（结构体地址）
        }
        回3--;
    }
    // 取地址形态（2026-09-04，E2E 148 收尾）：实 reg 来源=IR_取地址（&标识符
    //   实参传引用位——查方法签名(..., &签) 26 处实证）——取地址值即左值地址，
    //   引用位恰好要传左值地址，实参数值本已正确，直接复用（误报根治）。
    整64 回4 = 指令.大小();
    当 (回4 > 0) {
        IR指令 回扫4 = 指令.元素(回4 - 1);
        如果 (回扫4.操作码 == IR_取地址 && 回扫4.目标 == 实reg) {
            返回;
        }
        回4--;
    }
    // 静态容器形态（plans/018 根治，2026-09-07）：实 reg 来源=IR_静态加载（顶层
    //   静态容器读句柄）——引用形参须传「句柄槽地址」而非句柄值：回扫改发
    //   IR_静态地址（.data 槽 lea，附加=同一静态序号）。与宿主 ir_expr.cpp
    //   AddressOf 静态分支根治完全同构（宿主侧先实证：句柄值被被调方再解引用
    //   ——空容器句柄 0=错误码3、非空=读写容器对象头错位）。语义依据：C++
    //   T& x = 静态变量 绑定存储位置本身；Rust &mut static 恒指向槽。
    整64 回5 = 指令.大小();
    当 (回5 > 0) {
        IR指令 回扫5 = 指令.元素(回5 - 1);
        如果 (回扫5.操作码 == IR_静态加载 && 回扫5.目标 == 实reg) {
            整64 地址reg5 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 地址reg5, T_整64,
                                 回扫5.附加));
            结果<空类型, 整32> 改实5 = 弹出们.设置(弹出们.大小() - 1 - 实i, 地址reg5);
            如果 (!改实5.正常) { 运行时错误(4); }
            返回;
        }
        回5--;
    }
    // 433（070 波E·1022 深度机）：i128 字面量实参——常量寄存器回扫命中=
    //   物化128位操作数（814 字面量回扫拆半·>2^64 支持）+弹出改实=句柄
    //   （16B 双半地址传·983 大标量按引用 ABI 同型）
    整64 回6 = 指令.大小();
    当 (回6 > 0) {
        IR指令 回扫6 = 指令.元素(回6 - 1);
        如果 (回扫6.操作码 == IR_常量整数 && 回扫6.目标 == 实reg) {
            整64 句柄6 = 物化128位操作数(实reg, T_整64, 1, 指令, 寄存器计数, 槽计数);
            结果<空类型, 整32> 改实6 = 弹出们.设置(弹出们.大小() - 1 - 实i, 句柄6);
            如果 (!改实6.正常) { 运行时错误(4); }
            返回;
        }
        回6--;
    }
    IR层诊断("结构体实参须为标识符（表达式实参见P7c）");
}

// ==================== 引用参数（②c D，2026-09-02） ====================
// byRef 槽语义（对齐宿主 A-1）：参数槽存调用方左值地址——读取解引用/赋值写回；
//   容器& 双层解引用得对象指针（this 直用）；结构体& 槽内容即结构体基址
//   （成员访问直接复用，跳过 prologue 多槽拷贝）。调用方经 函数实参引用们
//   表驱动回扫取址（B8 同款机制扩展）。
静态 映射<整64, 整64> 函数实参引用们;    // 函数名ID*键位移+实参序 -> 1（该实参为 & 引用）
静态 映射<整64, 整64> 引用参数槽们;      // 槽号 -> 1（本函数该参数为 & 引用形参）
静态 映射<整64, 整64> 引用参数类型们;    // 槽号 -> 类型名ID（读取分流：容器/结构体/标量）
// 第17枚根治（2026-09-06，v2self 实参们槽高字节污染）：指针参数槽——方法签名* 出
//   等结构体指针形参（类型节点附加=指针层 1..255）。成员访问 p.字段 基址=装载槽值
//   （指针解引用，v2.1 用户裁决 p.字段 ≡ (*p).字段）——旧实现误走 IR_取地址（取
//   指针槽自身地址）少一层解引用 + 字段偏移 -1 未校验，写穿相邻槽（实测 偏移 -1
//   落在 实参们 句柄槽最高字节 -> 句柄 0xd00000000177eca0 -> 向量$大小 解引用崩）。
静态 映射<整64, 整64> 指针参数槽们;      // 槽号 -> 1（本函数该参数为结构体指针形参）

// #1813：引用位的「堆对象表示」标记——键同 函数实参引用们（函数符号*键位移+
//   实参序）。v2 的容器类/用户类实例有两种存储表示：局部/参数槽的「8 字节句柄
//   槽」（间接）与数组元素/类字段内的「内联对象本体」（直接）。引用形参被调方
//   固定解一层（槽内容 = 对象指针），故实参为**内联对象本体地址**（下标元素
//   地址/内联字段地址这类地址计算产物）时，调用方须物化「槽内 = 本体地址」并
//   传槽地址（宿主 ir_expr.cpp AddressOf 同形：临时槽物化 + lea 槽地址）。标量/
//   结构体引用无此层（被调侧读取语义不同：标量解一层得值、结构体直接取槽内容
//   作基址），保持直传=既有正确路径。
静态 映射<整64, 整64> 引用位物化槽们;

// 登记「该引用位实参须物化对象指针槽」（四处引用形参收集点共用口径：形参基
//   类型剥引用层后是容器类/用户类=堆对象表示）
不安全 函数 登记引用位物化槽(整64 键) -> 空类型 {
    结果<空类型, 整32> 设 = 引用位物化槽们.设置(键, 1);
    如果 (!设.正常) { 运行时错误(4); }
}

// 查询该引用位是否须物化槽。无值=该位非堆对象类引用（标量/结构体引用位或
//   非引用位）——直传即正确 ABI。属纯真假语义判定（#1360 谓词口径：非失败
//   通道），故按业务值返回布尔而非错误通道。
函数 引用位需物化槽(整64 键) -> 布尔 {
    结果<整64, 整32> 查 = 引用位物化槽们.获取(键);
    返回 查.正常;
}

// 清空引用位物化槽们（与 函数实参引用们 同生命周期·清空引用参数表 调用）
不安全 函数 清空引用位物化槽们() -> 空类型 {
    引用位物化槽们.清空();
}

// 引用段文本判据（参数串段格式：类型文本 + 尾 '&'；单字节 '&' 裸段=畸形类型
//   文本不支持——基名剥层后为空）
函数 是引用段文本(字符串 段文本) -> 布尔 {
    整64 长段 = 字符串长度(段文本);
    返回 长段 > 1 && ((整64(段文本[整32(长段 - 1)]) & 255) == 38);
}

// 引用段是否堆对象类（方法调用/接口收集路径用）：剥尾 '&' 后基名是容器类/
//   用户类=实参须物化槽（与 函数实参引用们 登记面同口径）
函数 引用段是堆对象类(字符串 段文本) -> 布尔 {
    如果 (是引用段文本(段文本)) {
        字符串 基名段 = 字符串子串(段文本, 0, 整32(字符串长度(段文本) - 1));
        如果 (是容器类(基名段)) { 返回 真; }
        返回 是用户类_ID(驻留(基名段));
    }
    返回 假;
}

// 物化引用实参槽（#1813）：实参寄存器是「堆对象指针值/内联对象本体地址」而非
//   「指针存放处地址」时，把该值存入新栈槽并把弹出项改为槽地址——被调方解一层
//   正好得对象指针（内联本体地址即对象指针）。识别来源：
//   · IR_加 / IR_字段地址 = 地址计算（下标元素/内联字段的本体地址）
//   · IR_调用参数化 / IR_分配对象 = 对象指针产物（容器方法返回/复制 新对象）
//   返回 真=已改写弹出项。其余形态返回 假，调用方走 回扫实参取地址 既有分支
//   （标识符/静态/指针加载 等已给「指针存放处地址」的正确 ABI 路径）。
不安全 函数 物化引用实参槽(向量<IR指令>& 指令, 向量<整64>& 弹出们, 整64 实i,
                    整64* 寄存器计数, 整64* 槽计数) -> 布尔 {
    整64 实reg = 弹出们.元素(弹出们.大小() - 1 - 实i);
    布尔 须物化值 = 假;
    整64 回 = 指令.大小();
    当 (回 > 0) {
        IR指令 回扫 = 指令.元素(回 - 1);
        如果 (回扫.目标 == 实reg &&
             (回扫.操作码 == IR_加 || 回扫.操作码 == IR_字段地址 ||
              回扫.操作码 == IR_调用参数化 || 回扫.操作码 == IR_分配对象)) {
            须物化值 = 真;
            中断;
        }
        回--;
    }
    如果 (须物化值) {
        整64 物化槽 = 槽计数[0];
        槽计数[0] = 槽计数[0] + 1;
        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 物化槽));
        IR追加(指令, 建IR指令(IR_存储, 实reg, 0, 0, 0, 0, 物化槽));
        整64 槽址reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_取地址, 物化槽, 0, 0, 槽址reg, T_整64, 0));
        结果<空类型, 整32> 改实 = 弹出们.设置(弹出们.大小() - 1 - 实i, 槽址reg);
        如果 (!改实.正常) { 运行时错误(4); }
        返回 真;
    }
    返回 假;
}

// 槽是否为引用参数
函数 槽是引用(整64 槽) -> 布尔 {
    结果<整64, 整32> 查 = 引用参数槽们.获取(槽);
    返回 查.正常;
}

// 槽是否为指针参数
函数 槽是指针参数(整64 槽) -> 布尔 {
    结果<整64, 整32> 查p = 指针参数槽们.获取(槽);
    返回 查p.正常;
}

// 92-a（2026-09-13 第九十二轮）：自增/自减增量常量发射（目标类型分派）——
//   浮点目标造浮点常量 1.0（v2 浮点常量面 89-a 为浮64 单面：浮32 目标再经
//   IR_类型转换 f64->f32 降精度，复用 91-a 四向转换设施）；整型目标造
//   IR_常量整数 1（原行为）。返回常量所在寄存器号。
// 266-a 波B：带步进宽版增量发射——指针变量=元素宽（q++ 步进 4 字节语义
//   对齐宿主；修复前恒 1=步进 1 字节解引用错位）；其余=1 走原逻辑。
不安全 函数 发射自增增量宽(向量<IR指令>& 指令, 整64 目标类型码,
                    整64* 寄存器计数, 整64 增量宽) -> 整64 {
    如果 (增量宽 != 1 && 目标类型码 == T_整64) {
        整64 步寄存器 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(增量宽)),
                             0, 0, 步寄存器, T_整64, 0));
        返回 步寄存器;
    }
    返回 发射自增增量(指令, 目标类型码, 寄存器计数);
}

