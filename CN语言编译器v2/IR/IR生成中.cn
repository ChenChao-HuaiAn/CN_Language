// IR生成中（357 重构F2 自 IR生成.cn 纯机械搬移·函数体逐字保留·零逻辑变化）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

函数 收集函数实参结构(向量<节点> 池, 整32 程序节点, 字符串 模块路径) -> 空类型 {
    节点 程序 = 池.元素(程序节点);
    整64 位置 = 整64(程序.子起点);
    当 (位置 < 整64(程序.子终点)) {
        节点 声明 = 池.元素(整32(位置));
        如果 (声明.类型 == 节点_函数) {
            // 参数区间 = [函数.子起点, 块.子起点)（块 在 函数.子终点=块索引）
            整64 参数终点 = 整64(声明.子起点);
            如果 (声明.子终点 < 池.大小()) {
                节点 块节点 = 池.元素(声明.子终点);
                参数终点 = 整64(块节点.子起点);
            }
            // 呈报③方案A：双键基——签名键恒有；纯名键同名唯一时才有（主模块）
            整64 键基p = 键基合成(模块路径, 整64(声明.文本));
            整64 签名键 = 函数签名键(键基p, 函数参数串(池, 整32(位置)));
            整64 纯名键 = 0;
            如果 (是主模块路径(模块路径)) {
                整64 查唯数 = 查函数签名个数(键基p);
                如果 (查唯数 >= 0) {
                    如果 (查唯数 == 1) { 纯名键 = 整64(声明.文本); }
                }
            }
            整64 参数序 = 0;
            整64 参数位置 = 整64(声明.子起点);
            当 (参数位置 < 参数终点) {
                节点 参数 = 池.元素(整32(参数位置));
                如果 (参数.类型 == 节点_参数) {
                    // 守卫用 >= 0（lessons 池索引 0 合法——生成函数 同款）：首函数
                    //   首参数的类型节点恰在池索引 0 时，原 > 0 漏登记——mapref 探针
                    //   实锤（灌 的 映射& 表 引用实参位漏收集→调用方不取址→被调方
                    //   双重解引用读垃圾→映射对象状态坏崩溃）
                    如果 (参数.附加 >= 0 && 参数.附加 < 池.大小()) {
                        节点 参数类型节点 = 池.元素(整32(参数.附加));
                        // 595-a（001-001 fix5b·自由函数版 同上）：容器实参句柄直传。
                        // 810（053）：128 位形参位——登记 函数实参128位们（回扫
                        //   物化 64 位值实参为地址句柄）
                        字符串 参类型名128 = 字符串复制(驻留文本(整64(参数类型节点.文本)));
                        如果 (参数类型节点.附加 == 0 &&
                             (字符串比较(参类型名128, "整128") ||
                              字符串比较(参类型名128, "正128"))) {
                            结果<空类型, 整32> 设128 = 函数实参128位们.设置(
                                签名键 * 键位移 + 参数序, 1);
                            如果 (!设128.正常) { 运行时错误(4); }
                            如果 (纯名键 != 0) {
                                结果<空类型, 整32> 设128n = 函数实参128位们.设置(
                                    纯名键 * 键位移 + 参数序, 1);
                                如果 (!设128n.正常) { 运行时错误(4); }
                            }
                        }
                        // 111（919 轮）：**指针层守卫**——类型节点 附加>=1
                        //   （盒子* 形参·星在附加·文本=剥星基名）原误命中
                        //   查结构体大小(盒子)→登记「结构体按值实参」→调用方
                        //   B3 回扫取地址传 &p；被调按标量通道收（附加=1）→
                        //   槽存地址≠指针值→返回/读值错值（561 实测 gdb 定案）。
                        //   指针形参=标量通道（rax 直传指针值·整64* 同款）。
                        // 1011（408/551·合成体按值实参宽度分档）：**结果类合成体
                        //   总宽 >8**（结果<整32,整32>=16）同登结构体表——被调方
                        //   prologue rep movsb 按源地址拷全宽，调用侧须回扫取地址
                        //   传槽基址；可选<整32>=8 不登（寄存器值传·t7 ABI）。
                        //   原判据漏合成体（查结构体大小 对结果名 miss）→标识符
                        //   实参 IR_加载 首 8 字节值传→被调 rep movsb 解引用打包
                        //   值（fault=0x2900000001=正常(41) 打包·408/551 实锤）。
                        布尔 合成体宽登记1011 = 假;
                        字符串 参数类型名1011 = 字符串复制(驻留文本(整64(参数类型节点.文本)));
                        如果 (参数类型节点.附加 == 0 &&
                             是结果类型(参数类型名1011) &&
                             结果大小(参数类型名1011) > 8) {
                            合成体宽登记1011 = 真;
                        }
                        // 087b（#087 余量·宿主 82984e4bbe 同构）：数组形参位——
                        //   B8 表登记（回扫结构体与引用实参 表驱动→回扫实参取地址
                        //   传源数组地址；被调 prologue 参数拷贝字节们 整块拷——
                        //   生成函数 登记参数槽 数组分支配对）。
                        布尔 数组形参登记087b = 假;
                        如果 (参数类型节点.附加 == 0 &&
                             是数组类型文本(参数类型名1011)) {
                            数组形参登记087b = 真;
                        }
                        如果 (参数类型节点.附加 == 0 &&
                             !是容器类(驻留文本(整64(参数类型节点.文本))) &&
                             (查结构体大小(整64(参数类型节点.文本)) != 0 ||
                              合成体宽登记1011 || 数组形参登记087b)) {
                            结果<空类型, 整32> 设结 = 函数实参结构们.设置(
                                签名键 * 键位移 + 参数序, 1);
                            如果 (!设结.正常) { 运行时错误(4); }
                            如果 (纯名键 != 0) {
                                结果<空类型, 整32> 设结n = 函数实参结构们.设置(
                                    纯名键 * 键位移 + 参数序, 1);
                                如果 (!设结n.正常) { 运行时错误(4); }
                            }
                        }
                        // ②c D：引用形参（类型节点 附加=引用*256）——调用方传左值地址
                        如果 (参数类型节点.附加 >= 256) {
                            结果<空类型, 整32> 设引 = 函数实参引用们.设置(
                                签名键 * 键位移 + 参数序, 1);
                            如果 (!设引.正常) { 运行时错误(4); }
                            如果 (纯名键 != 0) {
                                结果<空类型, 整32> 设引n = 函数实参引用们.设置(
                                    纯名键 * 键位移 + 参数序, 1);
                                如果 (!设引n.正常) { 运行时错误(4); }
                            }
                        }
                    }
                    参数序++;
                }
                参数位置++;
            }
        }
        位置++;
    }
}

// ==================== 用户函数返回类型表（③ 第二波，方案A 登记点补全 2026-09-03） ====================
// ③ 第一波登记点枚举漏「用户函数调用返回」——打印错分派 print_int（打指针值）、
//   拼接漏判/误转 from_int（指针转数字串）静默错误代码（asm 探针实锤；v2 组件
//   代码生成共用.cn:30/104 字节十六进制=符号修饰核心实际在用）。表：函数名ID ->
//   返回类型名ID（节点_函数.附加）。IR生成/IR生成多文件 入口收集（先于全部生成）。
静态 映射<整64, 整64> 函数返回类型们;

// 收集一个 程序 节点区间的全部函数声明的返回类型
// plans/018 第 4 层：签名键=链接键（键基#参数串）；纯名键仅主模块（键基=纯名）
函数 收集函数返回类型(向量<节点> 池, 整32 程序节点, 字符串 模块路径) -> 空类型 {
    节点 程序 = 池.元素(程序节点);
    整64 位置 = 整64(程序.子起点);
    当 (位置 < 整64(程序.子终点)) {
        节点 声明 = 池.元素(整32(位置));
        如果 (声明.类型 == 节点_函数) {
            // 呈报③方案A：双键——签名键恒登记（重载各键独立），纯名键仅
            //   同名唯一时（既有纯名消费点零回归：解析调用返回结构体/拼接推导）
            整64 键基r = 键基合成(模块路径, 整64(声明.文本));
            整64 签名键 = 函数签名键(键基r, 函数参数串(池, 整32(位置)));
            结果<空类型, 整32> 设返 = 函数返回类型们.设置(签名键,
                                                         整64(声明.附加));
            如果 (!设返.正常) { 运行时错误(4); }
            如果 (是主模块路径(模块路径)) {
                整64 查唯返 = 查函数签名个数(键基r);
                如果 (查唯返 >= 0) {
                    如果 (查唯返 == 1) {
                        结果<空类型, 整32> 设返n = 函数返回类型们.设置(整64(声明.文本),
                                                                     整64(声明.附加));
                        如果 (!设返n.正常) { 运行时错误(4); }
                    }
                }
            }
        }
        位置++;
    }
}

// 回扫实参取地址（②b B3/B8 共用）：裸标识符实参的 IR_加载 回扫取源槽改发
//   IR_取地址（宿主 ABI：调用方传指针）；找不到（表达式实参）打印诊断（P7c）
不安全 函数 回扫实参取地址(向量<IR指令>& 指令, 向量<整64>& 弹出们, 整64 实i,
                    整64* 寄存器计数, 整64* 槽计数) -> 空类型 {
    整64 实reg = 弹出们.元素(弹出们.大小() - 1 - 实i);
    // 86-a（2026-09-12 复审缺陷①）：聚合地址化三元实参（登记 T_对象）——
    //   寄存器值**即选中 place 地址**（非值装载），回扫不得改写（改写会把
    //   「三元临时槽地址」当结构体基址传给被调方——P47-v2/t5_3 实证乱码）。
    如果 (查寄存器类型(实reg) == T_对象) { 返回; }
    整64 源槽 = 0;
    整64 回 = 指令.大小();
    当 (回 > 0) {
        IR指令 回扫 = 指令.元素(回 - 1);
        如果 (回扫.操作码 == IR_加载 && 回扫.目标 == 实reg) {
            源槽 = 回扫.操作数1;
            中断;
        }
        回--;
    }
    如果 (源槽 != 0) {
        整64 地址reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        // 引用局部（2026-09-04 IR生成.cn 冒烟根治）：实参=槽内容（绑定对象
        //   左值地址）——与标识符取槽地址的值语义形态分流
        如果 (槽是引用(源槽)) {
            IR追加(指令, 建IR指令(IR_加载, 源槽, 0, 0, 地址reg, T_整64, 0));
        } 否则 {
            IR追加(指令, 建IR指令(IR_取地址, 源槽, 0, 0, 地址reg, T_整64, 0));
        }
        结果<空类型, 整32> 改实 = 弹出们.设置(弹出们.大小() - 1 - 实i, 地址reg);
        如果 (!改实.正常) { 运行时错误(4); }
        返回;
    }
    // 指针加载形态（引用局部读/成员字段加载，2026-09-04）：发射引用参数读
    //   （IR_加载 槽→L + IR_指针加载 L→对象指针）与容器字段取载
    //   （IR_字段地址 + IR_指针加载）的目标实参，其 IR_指针加载.操作数1
    //   寄存器即「绑定对象/字段的左值地址」——直接复用（零新指令）。
    //   被 127 既有标识符形态不经过此路径（IR_加载.目标==实reg 先命中）。
    整64 回2 = 指令.大小();
    当 (回2 > 0) {
        IR指令 回扫2 = 指令.元素(回2 - 1);
        如果 (回扫2.操作码 == IR_指针加载 && 回扫2.目标 == 实reg) {
            结果<空类型, 整32> 改实2 = 弹出们.设置(弹出们.大小() - 1 - 实i, 回扫2.操作数1);
            如果 (!改实2.正常) { 运行时错误(4); }
            返回;
        }
        回2--;
    }
    // 字段地址形态（2026-09-06 结果载荷结构体根治）：实 reg 来源=IR_字段地址
    //   （查.值 结构体载荷——实参=字段地址本身），直接复用（实reg 已是左值地址）
    整64 回2f = 指令.大小();
    当 (回2f > 0) {
        IR指令 回扫2f = 指令.元素(回2f - 1);
        如果 (回扫2f.操作码 == IR_字段地址 && 回扫2f.目标 == 实reg) {
            返回;
        }
        回2f--;
    }
    // 调用返回形态（2026-09-04，E2E 148）：实 reg 来源=IR_调用参数化——返回
    //   结构体时 rax=retbuf 地址即结构体地址，按值实参恰好要传地址——实参
    //   数值本已正确，直接复用（原「结构体实参须为标识符」诊断对此形态为
    //   误报：v2 自身 IR追加(指令, 建IR指令(...)) 655 条实证）。
    整64 回3 = 指令.大小();
    当 (回3 > 0) {
        IR指令 回扫3 = 指令.元素(回3 - 1);
        如果 (回扫3.操作码 == IR_调用参数化 && 回扫3.目标 == 实reg) {
            返回;   // 实参保持 实reg（结构体地址）
        }
        回3--;
    }
    // 取地址形态（2026-09-04，E2E 148 收尾）：实 reg 来源=IR_取地址（&标识符
    //   实参传引用位——查方法签名(..., &签) 26 处实证）——取地址值即左值地址，
    //   引用位恰好要传左值地址，实参数值本已正确，直接复用（误报根治）。
    整64 回4 = 指令.大小();
    当 (回4 > 0) {
        IR指令 回扫4 = 指令.元素(回4 - 1);
        如果 (回扫4.操作码 == IR_取地址 && 回扫4.目标 == 实reg) {
            返回;
        }
        回4--;
    }
    // 静态容器形态（plans/018 根治，2026-09-07）：实 reg 来源=IR_静态加载（顶层
    //   静态容器读句柄）——引用形参须传「句柄槽地址」而非句柄值：回扫改发
    //   IR_静态地址（.data 槽 lea，附加=同一静态序号）。与宿主 ir_expr.cpp
    //   AddressOf 静态分支根治完全同构（宿主侧先实证：句柄值被被调方再解引用
    //   ——空容器句柄 0=错误码3、非空=读写容器对象头错位）。语义依据：C++
    //   T& x = 静态变量 绑定存储位置本身；Rust &mut static 恒指向槽。
    整64 回5 = 指令.大小();
    当 (回5 > 0) {
        IR指令 回扫5 = 指令.元素(回5 - 1);
        如果 (回扫5.操作码 == IR_静态加载 && 回扫5.目标 == 实reg) {
            整64 地址reg5 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 地址reg5, T_整64,
                                 回扫5.附加));
            结果<空类型, 整32> 改实5 = 弹出们.设置(弹出们.大小() - 1 - 实i, 地址reg5);
            如果 (!改实5.正常) { 运行时错误(4); }
            返回;
        }
        回5--;
    }
    // 433（070 波E·1022 深度机）：i128 字面量实参——常量寄存器回扫命中=
    //   物化128位操作数（814 字面量回扫拆半·>2^64 支持）+弹出改实=句柄
    //   （16B 双半地址传·983 大标量按引用 ABI 同型）
    整64 回6 = 指令.大小();
    当 (回6 > 0) {
        IR指令 回扫6 = 指令.元素(回6 - 1);
        如果 (回扫6.操作码 == IR_常量整数 && 回扫6.目标 == 实reg) {
            整64 句柄6 = 物化128位操作数(实reg, T_整64, 1, 指令, 寄存器计数, 槽计数);
            结果<空类型, 整32> 改实6 = 弹出们.设置(弹出们.大小() - 1 - 实i, 句柄6);
            如果 (!改实6.正常) { 运行时错误(4); }
            返回;
        }
        回6--;
    }
    IR层诊断("结构体实参须为标识符（表达式实参见P7c）");
}

// ==================== 引用参数（②c D，2026-09-02） ====================
// byRef 槽语义（对齐宿主 A-1）：参数槽存调用方左值地址——读取解引用/赋值写回；
//   容器& 双层解引用得对象指针（this 直用）；结构体& 槽内容即结构体基址
//   （成员访问直接复用，跳过 prologue 多槽拷贝）。调用方经 函数实参引用们
//   表驱动回扫取址（B8 同款机制扩展）。
静态 映射<整64, 整64> 函数实参引用们;    // 函数名ID*键位移+实参序 -> 1（该实参为 & 引用）
静态 映射<整64, 整64> 引用参数槽们;      // 槽号 -> 1（本函数该参数为 & 引用形参）
静态 映射<整64, 整64> 引用参数类型们;    // 槽号 -> 类型名ID（读取分流：容器/结构体/标量）
// 第17枚根治（2026-09-06，v2self 实参们槽高字节污染）：指针参数槽——方法签名* 出
//   等结构体指针形参（类型节点附加=指针层 1..255）。成员访问 p.字段 基址=装载槽值
//   （指针解引用，v2.1 用户裁决 p.字段 ≡ (*p).字段）——旧实现误走 IR_取地址（取
//   指针槽自身地址）少一层解引用 + 字段偏移 -1 未校验，写穿相邻槽（实测 偏移 -1
//   落在 实参们 句柄槽最高字节 -> 句柄 0xd00000000177eca0 -> 向量$大小 解引用崩）。
静态 映射<整64, 整64> 指针参数槽们;      // 槽号 -> 1（本函数该参数为结构体指针形参）

// 槽是否为引用参数
函数 槽是引用(整64 槽) -> 布尔 {
    结果<整64, 整32> 查 = 引用参数槽们.获取(槽);
    返回 查.正常;
}

// 槽是否为指针参数
函数 槽是指针参数(整64 槽) -> 布尔 {
    结果<整64, 整32> 查p = 指针参数槽们.获取(槽);
    返回 查p.正常;
}

// 92-a（2026-09-13 第九十二轮）：自增/自减增量常量发射（目标类型分派）——
//   浮点目标造浮点常量 1.0（v2 浮点常量面 89-a 为浮64 单面：浮32 目标再经
//   IR_类型转换 f64->f32 降精度，复用 91-a 四向转换设施）；整型目标造
//   IR_常量整数 1（原行为）。返回常量所在寄存器号。
// 266-a 波B：带步进宽版增量发射——指针变量=元素宽（q++ 步进 4 字节语义
//   对齐宿主；修复前恒 1=步进 1 字节解引用错位）；其余=1 走原逻辑。
不安全 函数 发射自增增量宽(向量<IR指令>& 指令, 整64 目标类型码,
                    整64* 寄存器计数, 整64 增量宽) -> 整64 {
    如果 (增量宽 != 1 && 目标类型码 == T_整64) {
        整64 步寄存器 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(增量宽)),
                             0, 0, 步寄存器, T_整64, 0));
        返回 步寄存器;
    }
    返回 发射自增增量(指令, 目标类型码, 寄存器计数);
}

