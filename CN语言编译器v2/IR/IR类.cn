// CN 自举编译器 v2 · 用户自定义类支持表（第七十八轮，2026-09-12）
// 职责：用户类元数据的单一归属——类名表（是用户类判定）/方法签名表（返回类型
//   名ID+参数串）/构造参数串/析构存在位。对应「类声明→类型登记→字段表→方法体
//   检查→IR 生成」链的类型登记与字段表半步（字段偏移/类型复用 IR布局 结构体
//   布局表族——布局登记与结构体同键同表，字段访问/对象大小/宽度全链复用）。
// 登记点：语法层 解析类声明（解析期，跨文件保留——与结构体布局登记同时机）；
//   查询点：语义检查（方法体检查/类型引用）、IR 生成（构造/方法调用/RAII 分派）。
// 位置理由：语法层（语法组件 导入 IR 包）与 IR 层（同包）双可达；本文件仅依赖
//   映射集合+IR常量，无反向依赖（与 IR布局 布局表族同层同纪律）。
// 第一版范围（诚实边界，探针 D 缺口专项）：无继承/虚函数/接口/泛型类/静态成员/
//   常量成员/运算符重载/访问控制强制；重载方法不支持（同名方法唯一——语法层
//   重复登记诊断）。v2 树自身不用类（自举闭环零影响）。
导入 映射集合;
导入 协议常量;   // 键位移（335：协议常量独立包）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

公开:

静态 映射<整64, 整64> 用户类们;         // 类名ID -> 1
静态 映射<整64, 整64> 用户类键基们;     // #1252：键基(模块路径$类名) -> 1（模块感知用户类集合·继承位歧义候选过滤）
静态 映射<整64, 整64> 类方法返回们;     // 类名ID*键位移+方法名ID -> 返回类型名ID
静态 映射<整64, 整64> 类方法参数串们;   // 类名ID*键位移+方法名ID -> 参数串ID
静态 映射<整64, 整64> 类构造参数串们;   // 类名ID -> 构造器参数串ID
静态 映射<整64, 整64> 类析构位们;       // 类名ID -> 1（有析构函数）
静态 映射<整64, 整64> 类静态方法们;     // 类名ID*键位移+方法名ID -> 1（070 波G 静态成员）
静态 映射<整64, 整64> 友元授权们;       // 类名ID*键位移+函数名ID -> 1（070 波H 友元：授权该全局函数访问私有）
静态 映射<整64, 整64> 类基名们;         // 234：类名ID -> 基类名ID（0=无继承·解析期登记）
静态 映射<整64, 整64> 类虚方法槽们;     // 234：类名ID*键位移+方法名ID -> 槽（分派判定·沿链覆盖）
静态 映射<整64, 整64> 类虚槽方法们;     // 234：类名ID*键位移+槽 -> 方法名ID（vtable 发射·含沿链继承）
静态 映射<整64, 整64> 类虚槽数们;       // 234：类名ID -> 本类 vtable 槽总数（0=无虚表）
静态 映射<整64, 整64> 类布局头们;       // 234：类名ID -> 布局头字节数（vtable 8·派生=父大小+头）
静态 映射<整64, 整64> 类字段区尾们;     // 463：类名ID -> 字段区尾 raw 偏移（未尾对齐——宿主 computeClassLayout 沿链连续推进·派生字段起点=父尾 raw+头区·与父尾 pad 无关）
静态 映射<整64, 整64> 类节点索引们;     // 234：类名ID -> 类节点池索引（继承链字段/方法注入定位）
静态 向量<整64> 有虚类清单们;           // 234：有虚表类的类名ID 清单（去重·vtable 数据段发射枚举）
静态 向量<整64> 全部类清单们;           // 332：全部用户类清单（虚表沿链合成遍历域）
静态 映射<整64, 整64> 类有构造器位们;   // 234：类名ID -> 1（有任意用户构造器·隐式默认判定）
静态 映射<整64, 整64> 类基构造根表们;   // 234：平铺序 -> 实参根节点索引（映射版·向量无 获取）
静态 映射<整64, 整64> 类基构造起们;     // 234：类ID*键位移+构造名ID -> 根平铺起始序
静态 映射<整64, 整64> 类基构造数们;     // 234：类ID*键位移+构造名ID -> 实参根个数

// 任务级生命周期清空（主.cn 与 清空结构体布局表 同步调用；多文件窗口重置）
不安全 函数 清空类表() -> 空类型 {
    用户类们.清空();
    用户类键基们.清空();
    类基名们.清空();
    类虚方法槽们.清空();
    类虚槽方法们.清空();
    类虚槽数们.清空();
    类布局头们.清空();
    类字段区尾们.清空();
    类节点索引们.清空();
    有虚类清单们.清空();
    全部类清单们.清空();
    类有构造器位们.清空();
    类基构造根表们.清空();
    类基构造起们.清空();
    类基构造数们.清空();
    类方法返回们.清空();
    类方法参数串们.清空();
    类构造参数串们.清空();
    类析构位们.清空();
    类静态方法们.清空();
    友元授权们.清空();
}

// 070 波H（1026）：友元授权登记/判定（解析类声明 友元分支消费·私有可见性检查豁免）
不安全 函数 登记友元授权(整64 类名ID, 整64 函数名ID) -> 空类型 {
    结果<空类型, 整32> 设 = 友元授权们.设置(类名ID * 键位移 + 函数名ID, 1);
    如果 (!设.正常) { 运行时错误(4); }
}

函数 查友元授权(整64 类名ID, 整64 函数名ID) -> 布尔 {
    结果<整64, 整32> 查 = 友元授权们.获取(类名ID * 键位移 + 函数名ID);
    返回 查.正常;
}

// 070 波G（1026）：类静态方法登记/判定（解析类声明 消费·调用分派/作值 消费）
不安全 函数 登记类静态方法(整64 类名ID, 整64 方法名ID) -> 空类型 {
    结果<空类型, 整32> 设 = 类静态方法们.设置(类名ID * 键位移 + 方法名ID, 1);
    如果 (!设.正常) { 运行时错误(4); }
}

函数 是类静态方法(整64 类名ID, 整64 方法名ID) -> 布尔 {
    结果<整64, 整32> 查 = 类静态方法们.获取(类名ID * 键位移 + 方法名ID);
    返回 查.正常;
}

// 登记类名（解析类声明调用；幂等——解析期单点）
不安全 函数 登记用户类(整64 类名ID) -> 空类型 {
    结果<空类型, 整32> 设 = 用户类们.设置(类名ID, 1);
    如果 (!设.正常) { 运行时错误(4); }
    // 332：全类清单（解析序）——虚表沿链合成遍历域
    结果<空类型, 整32> 设清 = 全部类清单们.追加(类名ID);
    如果 (!设清.正常) { 运行时错误(4); }
}

函数 是用户类ID(整64 名ID) -> 布尔 {
    结果<整64, 整32> 查 = 用户类们.获取(名ID);
    返回 查.正常;
}

// 字符串形态判定（IR 深处拿到类型文本——容器类判定同款消费面）
函数 是用户类(字符串 名) -> 布尔 {
    结果<整64, 整32> 查 = 用户类们.获取(驻留(名));
    返回 查.正常;
}

// 065 波3（829）：用户类判定 ID 入口——零文本（原文本版内部即 驻留(名) 再查表，
//   故直接以 ID 查表语义等价；ID 唯一性由驻留表保证）。
函数 是用户类_ID(整64 名ID) -> 布尔 {
    如果 (名ID <= 0) { 返回 假; }
    结果<整64, 整32> 查 = 用户类们.获取(名ID);
    返回 查.正常;
}

// #1252：模块感知用户类集合（键基=模块路径$类名）——继承位歧义候选过滤。
//   成员索引 模块成员键基们 混装函数/结构体/类/常量，仅类可作父类；本表把
//   「该模块名下确是用户类」这一事实独立登记（登记点=解析类布局收口，与
//   结构体布局键基同源），供语义第二趟逐候选判定。
不安全 函数 登记用户类键基(整64 类键基) -> 空类型 {
    结果<空类型, 整32> 设 = 用户类键基们.设置(类键基, 1);
    如果 (!设.正常) { 运行时错误(4); }
}

函数 是用户类键基(整64 类键基) -> 布尔 {
    如果 (类键基 == 0) { 返回 假; }
    结果<整64, 整32> 查 = 用户类键基们.获取(类键基);
    返回 查.正常;
}

// 登记类方法（普通方法/构造/析构统一入口）：返回类型名ID + 参数串（空=无参）。
// 同名方法已登记=第一版不支持重载（语法层已诊断——此处防御保留首登记）
不安全 函数 登记类方法(整64 类名ID, 整64 方法名ID, 整64 返回类型ID, 字符串 参数串) -> 空类型 {
    结果<整64, 整32> 查有 = 类方法返回们.获取(类名ID * 键位移 + 方法名ID);
    如果 (!查有.正常) {
        结果<空类型, 整32> 设返 = 类方法返回们.设置(类名ID * 键位移 + 方法名ID,
                                                      返回类型ID);
        如果 (!设返.正常) { 运行时错误(4); }
    }
    结果<空类型, 整32> 设串 = 类方法参数串们.设置(类名ID * 键位移 + 方法名ID,
                                                  驻留(参数串));
    如果 (!设串.正常) { 运行时错误(4); }
}

函数 有类方法(整64 类名ID, 整64 方法名ID) -> 布尔 {
    返回 查类方法定义层(类名ID, 方法名ID) != 0;
}


// 414（审查 P0-1·宿主 class_resolver collectClassMembers methods.find 同构）：
//   本类级方法查有（不走基类链）——定义处「重复定义运算符」判重专用：
//   沿链版（查类方法定义层）对子类定义同名运算符会命中父类层=误报重复定义
//   并丢子类重写；宿主收集是逐类 info.methods.find=只查本类表，子类覆盖合法。
函数 查本类方法有(整64 类名ID, 整64 方法名ID) -> 布尔 {
    结果<整64, 整32> 查 = 类方法返回们.获取(类名ID * 键位移 + 方法名ID);
    返回 查.正常;
}


// 查方法返回类型名ID（0=无此方法）
函数 查类方法返回(整64 类名ID, 整64 方法名ID) -> 整64 {
    // 234：沿链继承
    整64 当前c = 类名ID;
    整64 守卫h = 0;
    当 (当前c != 0 && 守卫h < 64) {
        结果<整64, 整32> 查 = 类方法返回们.获取(当前c * 键位移 + 方法名ID);
        // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
        如果 (查.正常) { 返回 查.值; } 否则 { }
        当前c = 查类基名(当前c);
        守卫h++;
    }
    返回 0;
}

// 查方法参数串 ID（0=无此方法）
函数 查类方法参数串(整64 类名ID, 整64 方法名ID) -> 整64 {
    // 234：沿链继承
    整64 当前c = 类名ID;
    整64 守卫h = 0;
    当 (当前c != 0 && 守卫h < 64) {
        结果<整64, 整32> 查 = 类方法参数串们.获取(当前c * 键位移 + 方法名ID);
        // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
        如果 (查.正常) { 返回 查.值; } 否则 { }
        当前c = 查类基名(当前c);
        守卫h++;
    }
    返回 0;
}

// 登记构造器（432-b 根治：键=(类ID,实参数)——构造重载并存〔无参+拷贝〕原单槽
//   后写覆盖=实例侧无参构造丢失；构造符号=类名$类名[#参数串] 由 IR 层合成）
// 107（945·§2.205 零槽号修法）：拷贝构造参数串存「影子键 777」（真实构造
//   个数 0~99 恒不冲突）——零新增静态容器=零槽号漂移。原 (类,个数) 槽留给
//   用户构造——同参重载不互覆盖（P7c 根治）。
不安全 函数 登记类构造(整64 类名ID, 字符串 参数串) -> 空类型 {
    // 234：有构造器位（隐式默认构造判定——无构造器基类=分配 vptr 即默认·父构造跳过）
    结果<空类型, 整32> 设位c = 类有构造器位们.设置(类名ID, 1);
    如果 (!设位c.正常) { 运行时错误(4); }
    字符串 类文本107 = 字符串复制(驻留文本(类名ID));
    如果 (字符串比较(参数串, 剥实例基名(类文本107) + "&") ||
         字符串比较(参数串, 类文本107 + "&")) {
        结果<空类型, 整32> 设拷 = 类构造参数串们.设置(
            类名ID * 键位移 + 777, 驻留(参数串));
        如果 (!设拷.正常) { 运行时错误(4); }
        返回;
    }
    结果<空类型, 整32> 设 = 类构造参数串们.设置(类名ID * 键位移 + 参数段个数(参数串),
                                                 驻留(参数串));
    如果 (!设.正常) { 运行时错误(4); }
}
函数 查类拷贝构造串(整64 类名ID) -> 整64 {
    结果<整64, 整32> 查 = 类构造参数串们.获取(类名ID * 键位移 + 777);
    // 静默豁免业务值: 查表 miss=键不存在·显式 0 哨兵（1241 批量显式化·否则块承载错误分支）
    如果 (查.正常) { 返回 查.值; } 否则 { 返回 0; }
}

// 741：拷贝构造沿链查询——每层只认**自有**拷贝构造（777 影子键），本类无才
//   沿基名链上溯（宿主 class_resolver.cpp findCopyConstructor 同序：无自有
//   =继承祖先定制复印·C++ 同序）。0=全链无拷贝构造（741 语义层「有析构类
//   按值拷贝须有拷贝构造」判定消费）。
函数 查类拷贝构造沿链(整64 类名ID) -> 整64 {
    整64 当前c = 类名ID;
    整64 守卫h = 0;
    当 (当前c != 0 && 守卫h < 64) {
        整64 查 = 查类拷贝构造串(当前c);
        如果 (查 != 0) { 返回 查; }
        当前c = 查类基名(当前c);
        守卫h++;
    }
    返回 0;
}

// 查构造参数串 ID（0=无该实参数构造器——第一版要求类必有构造器，检查层诊断）
函数 查类构造参数串(整64 类名ID, 整64 实参数) -> 整64 {
    结果<整64, 整32> 查 = 类构造参数串们.获取(类名ID * 键位移 + 实参数);
    // 静默豁免业务值: 查表 miss=键不存在·显式 0 哨兵（1241 批量显式化·否则块承载错误分支）
    如果 (查.正常) { 返回 查.值; } 否则 { 返回 0; }
}

不安全 函数 登记类析构(整64 类名ID) -> 空类型 {
    结果<空类型, 整32> 设 = 类析构位们.设置(类名ID, 1);
    如果 (!设.正常) { 运行时错误(4); }
}

// 类是否有析构函数（RAII 分派：有析构类局部函数出口析构——对齐宿主
//   ir_decl.cpp「类类型局部变量（有析构函数）收尾 DeleteObject」口径；
//   无析构类不释放=宿主既有语义，浅共享保守——移植纪律 7 不变量）
函数 类有析构(整64 类名ID) -> 布尔 {
    // 234：析构沿链继承（父析构子有——生成层析构链沿链发射）
    整64 当前c = 类名ID;
    整64 守卫h = 0;
    当 (当前c != 0 && 守卫h < 64) {
        结果<整64, 整32> 查 = 类析构位们.获取(当前c);
        // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
        如果 (查.正常) { 返回 真; } 否则 { }
        当前c = 查类基名(当前c);
        守卫h++;
    }
    返回 假;
}

// ==================== 416-a（D42 甲案波 2）：泛型类实例单态化表 ====================
// 职责：用户泛型类实例（盒子$整32）的收集与注册——实例合成名注册为「完整
//   用户类」（类名表+布局+字段偏移/类型+方法表+构造/析构位），既有用户类全链
//   （对象声明/方法调用/字段访问/RAII）零修改复用；方法体单态化=类体 AST 克隆
//   （克隆泛型类节点→实例类节点·生成类方法们 对克隆体照常生成·符号自动含实例
//   参数）。rustc instantiate 同构（编译期一次性·运行期零开销）。
// 基类参数序表：基名ID -> 参数名串（"T,U" 驻留ID·解析泛型类声明 登记点）。
静态 映射<整64, 整64> 泛型基类参数序们;
静态 向量<整64> 泛型实例们;        // 实例合成名ID（去重平铺·收集序）
静态 向量<整64> 泛型实例类节点们;  // 平行：实例ID -> 克隆类节点索引（池尾·生成期消费）
静态 向量<整64> 泛型实例函数节点们; // 419-a：函数实例ID -> 克隆函数节点索引（池尾）

// 任务级生命周期（主.cn 与 清空类表 同位调用）
不安全 函数 清空泛型实例们() -> 空类型 {
    泛型基类参数序们.清空();
    泛型实例们.清空();
    泛型实例类节点们.清空();
    泛型实例函数节点们.清空();
}

// 登记泛型基类参数序（解析泛型类声明 调用·幂等）
不安全 函数 登记泛型基类参数序(整64 基名ID, 字符串 参数名串) -> 空类型 {
    // 417-a：泛型函数声明共用本表（函数名 ID 键）——类存在防御删除（调用点
    //   次序自保证：类=解析类声明 后·函数=解析函数声明 后）
    结果<空类型, 整32> 设g = 泛型基类参数序们.设置(基名ID, 驻留(参数名串));
    如果 (!设g.正常) { 运行时错误(4); }
}

// 查基类参数名串 ID（0=非泛型基类）
函数 查泛型基类参数序(整64 基名ID) -> 整64 {
    结果<整64, 整32> 查g = 泛型基类参数序们.获取(基名ID);
    // 静默豁免业务值: 查表 miss=键不存在·显式 0 哨兵（1241 批量显式化·否则块承载错误分支）
    如果 (查g.正常) { 返回 查g.值; } 否则 { 返回 0; }
}

// 剥实例合成名基名（首 '$' 前段；无 '$' 返回原文——非泛型类构造/析构符号
//   保持 类$类名 既有口径·调用方 方法符号(类型文本, 剥实例基名(类型文本)) 对
//   两类形态统一成立）
函数 剥实例基名(字符串 合成名) -> 字符串 {
    整64 i = 0;
    当 (i < 字符串长度(合成名)) {
        如果 (((整64(合成名[整32(i)]) & 255) == 36)) {
            返回 字符串子串(合成名, 0, 整32(i));
        }
        i++;
    }
    返回 字符串复制(合成名);
}

// 剥实例参数段（首 '$' 后按 '$' 分段·平铺 ID 向量；无参=空）
// 466-a（T70 面⑥·递归平衡拆段·根治 464-a 吞段错位）：泛型基类参数序表值=
//   参数序串驻留 ID（非个数）——464-a 误将 ID 当段数吞段（吞段数=任意整数→
//   撤守卫态 stdlib 源码级嵌套实例大面积「实参与参数序不匹配」错误码6·27 红
//   回归根因）。本版=递归平衡消费：段名是泛型基类(k 参)则递归消费 k 个完整
//   子类型段——向量$向量$整64→[向量$整64]·向量$映射$整64$符号→[映射$整64$符号]
//   ·任意深度同/异族嵌套均正确；生产态无基类登记=全 k=0 平拆=原行为零回归。
函数 泛型基类参数个数(整64 基名ID) -> 整64 {
    整64 序ID466 = 查泛型基类参数序(基名ID);
    如果 (序ID466 == 0) {
        // 888-a（070·G-N·537 ⑧ 终格）：**内置泛型**参数个数——`结果<T,E>`=2 /
        //   `可选<T>`=1。实例名递归切分（拆段消费一类型）依赖本函数判断「段名后
        //   跟几个子段」；内置泛型非用户声明（不在泛型声明参数序表）→ 原返 0 →
        //   递归中断 → 嵌套实参被逐段拆散（`向量$结果$整32$整32` → [结果, 整32,
        //   整32] 3 段 ≠ 基类参数序 1）→ 误报「实参与基类参数序不匹配」+ v2p
        //   崩（错误码 6·537 D 段实锤）。Rust 对照：prelude 泛型（Result/Option）
        //   与用户泛型同权重参与结构解析。
        字符串 基名466 = 字符串复制(驻留文本(基名ID));
        如果 (字符串比较(基名466, "结果")) { 返回 2; }
        如果 (字符串比较(基名466, "可选")) { 返回 1; }
        返回 0;
    }
    字符串 序文本466 = 字符串复制(驻留文本(序ID466));
    整64 个466 = 1;
    整64 i466 = 0;
    当 (i466 < 字符串长度(序文本466)) {
        如果 (((整64(序文本466[整32(i466)]) & 255) == 44)) { 个466++; }
        i466++;
    }
    返回 个466;
}

// 递归消费一个完整类型段（自 位置 起）：读段名至 '$'/尾；段名是泛型基类则
//   递归消费其参数数个子段。返回消费后的位置（下一 '$' 或串尾）。
函数 拆段消费一类型(字符串 合成名, 整64 位置, 整64 长度) -> 整64 {
    整64 段尾466 = 位置;
    当 (段尾466 < 长度 && !((整64(合成名[整32(段尾466)]) & 255) == 36)) { 段尾466++; }
    字符串 段名466 = 字符串子串(合成名, 整32(位置), 整32(段尾466 - 位置));
    整64 参数数466 = 泛型基类参数个数(驻留(段名466));
    整64 消费位466 = 段尾466;
    整64 已消466 = 0;
    当 (已消466 < 参数数466 && 消费位466 < 长度) {
        消费位466++;
        消费位466 = 拆段消费一类型(合成名, 消费位466, 长度);
        已消466++;
    }
    返回 消费位466;
}

函数 剥实例参数段(字符串 合成名, 向量<整64>& 段名ID们) -> 空类型 {
    整64 首i = 0 - 1;
    整64 i = 0;
    当 (i < 字符串长度(合成名)) {
        如果 (((整64(合成名[整32(i)]) & 255) == 36)) {
            如果 (首i == 0 - 1) { 首i = i; }
        }
        i++;
    }
    如果 (首i == 0 - 1) { 返回; }
    整64 长度g = 字符串长度(合成名);
    整64 位g = 首i + 1;
    当 (位g < 长度g) {
        整64 段起g = 位g;
        位g = 拆段消费一类型(合成名, 位g, 长度g);
        如果 (位g > 段起g) {
            结果<空类型, 整32> 加段 = 段名ID们.追加(整64(驻留(字符串子串(合成名, 整32(段起g), 整32(位g - 段起g)))));
            如果 (!加段.正常) { 运行时错误(4); }
        }
        如果 (位g < 长度g) { 位g++; }
    }
}

// 类型文本的参数替换（精确匹配或 参数名+*/&/[n] 后缀；嵌套 $ 含参名=不替换
//   〔嵌套泛型实参=波3 面·保持原文交既有诊断〕）
函数 替换实例类型文本(字符串 类型文本, 向量<整64>& 参数名ID们, 向量<整64>& 实参ID们) -> 字符串 {
    // 421（070·wt421）：函数指针类型文本参数表的参数名替换——`整32(*处理)(T)`
    //   声明经语法层 解析函数指针类型节点 规范化为 `函数指针<整32>(T)`（480-a
    //   合成约定），参数表含裸参数名 T 时下方「整串参数名后缀 / $ 合成段」两
    //   模式均不命中 → 克隆体形参类型登记保留 T → 间接调用 128 位宽化判据
    //   类型码("T")=T_未知不宽化（探针 I2 泛应用<整128> 处理(600000000000)
    //   fault=字面量值本身 实锤）。参数表段级替换后重合成（段内递归全模式）。
    如果 (是函数指针类型文本(类型文本)) {
        字符串 参数表fp = 函数指针参数文本(类型文本);
        如果 (字符串长度(参数表fp) > 0) {
            字符串 重构fp = "";
            整64 扫fp = 0;
            整64 深fp = 0;
            整64 段起fp = 0;
            整64 段数fp = 0;
            布尔 有改fp = 假;
            当 (扫fp <= 字符串长度(参数表fp)) {
                布尔 尾fp = (扫fp == 字符串长度(参数表fp));
                如果 (尾fp || ((整64(参数表fp[整32(扫fp)]) & 255) == 44 && 深fp == 0)) {
                    字符串 段原fp = 字符串子串(参数表fp, 整32(段起fp),
                                               整32(扫fp - 段起fp));
                    字符串 段新fp = 替换实例类型文本(段原fp, 参数名ID们, 实参ID们);
                    如果 (!字符串比较(段新fp, 段原fp)) { 有改fp = 真; }
                    如果 (段数fp > 0) { 重构fp = 重构fp + ","; }
                    重构fp = 重构fp + 段新fp;
                    段数fp++;
                    段起fp = 扫fp + 1;
                } 否则 如果 ((整64(参数表fp[整32(扫fp)]) & 255) == 40) {
                    深fp++;
                } 否则 如果 ((整64(参数表fp[整32(扫fp)]) & 255) == 41) {
                    如果 (深fp > 0) { 深fp--; }
                }
                扫fp++;
            }
            如果 (有改fp) {
                // 规范合成格式对齐 解析函数指针类型节点（解析表达式尾 合成fp）：
                // 函数指针<返回>(参数表)——缺「>」=畸形文本（同签名判定/类型码
                // 登记等按规范格式的下游消费面会错位）
                返回 字符串复制("函数指针<") + 函数指针返回文本(类型文本) +
                       字符串复制(">(") + 重构fp + 字符串复制(")");
            }
        }
        返回 字符串复制(类型文本);
    }
    整64 i = 0;
    当 (i < 参数名ID们.大小() && i < 实参ID们.大小()) {
        字符串 参数名t = 字符串复制(驻留文本(参数名ID们.元素(i)));
        字符串 实参t = 字符串复制(驻留文本(实参ID们.元素(i)));
        整64 参数长t = 字符串长度(参数名t);
        整64 文本长t = 字符串长度(类型文本);
        如果 (文本长t >= 参数长t) {
            // 前缀精确匹配（逐字节·065 A账：字节直读零分配）
            整64 匹配长t = 0;
            当 (匹配长t < 参数长t) {
                如果 (!((整64(类型文本[整32(匹配长t)]) & 255) == (整64(参数名t[整32(匹配长t)]) & 255))) { 中断; }
                匹配长t++;
            }
            如果 (匹配长t == 参数长t) {
                字符串 剩余t = 字符串子串(类型文本, 整32(参数长t), 整32(文本长t - 参数长t));
                // 剩余合法性：空 / 纯 *、& 字符 / [数字] 尾形态——防 前缀误替换
                整64 k = 0;
                布尔 合法后缀t = 真;
                当 (k < 字符串长度(剩余t)) {
                    整64 ct = 整64(剩余t[整32(k)]) & 255;
                    如果 (ct == 42 || ct == 38) {
                        k++;
                        继续;
                    }
                    如果 (ct == 91) {
                        // [数字] 尾形态：数字直到 ']'
                        整64 m = k + 1;
                        当 (m < 字符串长度(剩余t)) {
                            整64 cm = 整64(剩余t[整32(m)]) & 255;
                            如果 (cm == 93) { m++; 继续; }
                            m++;
                        }
                        k = 字符串长度(剩余t);
                        继续;
                    }
                    合法后缀t = 假;
                    中断;
                }
                如果 (合法后缀t == 真) {
                    返回 实参t + 剩余t;
                }
            }
        }
        i++;
    }
    // 421-c（延迟绑定）：$ 分段感知——合成名 查找值位置$T 的 T 段替换→
    //   查找值位置$整64（原前缀逻辑对 $ 中间段不生效=克隆体内调用 callee
    //   与定义侧键不一致的根因）。段级精确匹配·非参数段原样保留。
    整64 含合成f = 0;
    整64 扫f = 0;
    当 (扫f < 字符串长度(类型文本)) {
        如果 (((整64(类型文本[整32(扫f)]) & 255) == 36)) { 含合成f = 1; }
        扫f++;
    }
    如果 (含合成f == 0) { 返回 字符串复制(类型文本); }
    字符串 重构f = "";
    整64 段起f = 0;
    整64 j = 0;
    // 1175（泛型实例指针三形态·根因 c）：**首段（基名）不做段级替换**。
    //   432-b 自引用替换对（基名 节点 -> 实例 节点$整32）同时存在于 参数名们/
    //   实参们：合成类型文本 `节点$T` 的基名段 节点 被自引用对再替换一次 ->
    //   `节点$整32$整32`（实测 dbg 轨迹：节点$T -> 节点$整32$整32）——实例布局
    //   字段类型表因此存入错名，尾星剥星后查结构体类型恒 miss → 多级/宽载荷
    //   链「成员字段偏移未知」。裸基名/带后缀基名（节点 / 节点* / 节点[3]）已
    //   由上方前缀精确匹配分支按 432-b 正确替换（节点* -> 节点$整32*），
    //   $-合成文本的基名段本就已是实例身份->跳过不丢替换能力；参数名段
    //   （T/K/V）从第二段起照常替换。嵌套泛型实参含参名=既有文档边界（不替换）。
    整64 段序f = 0;
    当 (j <= 字符串长度(类型文本)) {
        布尔 尾f = 假;
        如果 (j == 字符串长度(类型文本)) { 尾f = 真; }
        如果 (尾f || ((整64(类型文本[整32(j)]) & 255) == 36)) {
            字符串 段f = 字符串子串(类型文本, 整32(段起f), 整32(j - 段起f));
            字符串 段替f = 字符串复制(段f);
            如果 (段序f != 0) {
                整64 m = 0;
                当 (m < 参数名ID们.大小() && m < 实参ID们.大小()) {
                    字符串 参数名f = 字符串复制(驻留文本(参数名ID们.元素(m)));
                    如果 (字符串比较(段f, 参数名f)) {
                        段替f = 字符串复制(驻留文本(实参ID们.元素(m)));
                    }
                    m++;
                }
            }
            如果 (字符串长度(重构f) > 0) {
                重构f = 字符串复制(重构f + "$" + 段替f);
            } 否则 {
                重构f = 段替f;
            }
            段序f++;
            段起f = j + 1;
        }
        j++;
    }
    返回 重构f;
}

// 实例是否已登记（去重线性查）

// 423（任务 421·审查 P1-1 单一归属）：伪实例判定——实参段中任一命中基参数序
//   裸参数名（T/K/V）=未绑定快照实例（泛型类方法体/泛型函数体内 向量<T> 形态·
//   语法层合成 基名$T）。原 实例化注册/实例化函数注册 两处 22 行逐字重复。
函数 是伪实例423(向量<整64>& 实参们, 向量<整64>& 参数名们) -> 布尔 {
    整64 参检p = 0;
    当 (参检p < 实参们.大小()) {
        整64 名检p = 0;
        当 (名检p < 参数名们.大小()) {
            如果 (实参们.元素(参检p) == 参数名们.元素(名检p)) { 返回 真; }
            名检p++;
        }
        参检p++;
    }
    返回 假;
}
