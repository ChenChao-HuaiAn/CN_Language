// CN 自举编译器 v2 · 用户自定义类支持表（第七十八轮，2026-09-12）
// 职责：用户类元数据的单一归属——类名表（是用户类判定）/方法签名表（返回类型
//   名ID+参数串）/构造参数串/析构存在位。对应「类声明→类型登记→字段表→方法体
//   检查→IR 生成」链的类型登记与字段表半步（字段偏移/类型复用 IR布局 结构体
//   布局表族——布局登记与结构体同键同表，字段访问/对象大小/宽度全链复用）。
// 登记点：语法层 解析类声明（解析期，跨文件保留——与结构体布局登记同时机）；
//   查询点：语义检查（方法体检查/类型引用）、IR 生成（构造/方法调用/RAII 分派）。
// 位置理由：语法层（语法组件 导入 IR 包）与 IR 层（同包）双可达；本文件仅依赖
//   映射集合+IR常量，无反向依赖（与 IR布局 布局表族同层同纪律）。
// 第一版范围（诚实边界，探针 D 缺口专项）：无继承/虚函数/接口/泛型类/静态成员/
//   常量成员/运算符重载/访问控制强制；重载方法不支持（同名方法唯一——语法层
//   重复登记诊断）。v2 树自身不用类（自举闭环零影响）。
导入 映射集合;
导入 IR常量;   // 键位移

公开:

静态 映射<整64, 整64> 用户类们;         // 类名ID -> 1
静态 映射<整64, 整64> 类方法返回们;     // 类名ID*键位移+方法名ID -> 返回类型名ID
静态 映射<整64, 整64> 类方法参数串们;   // 类名ID*键位移+方法名ID -> 参数串ID
静态 映射<整64, 整64> 类构造参数串们;   // 类名ID -> 构造器参数串ID
静态 映射<整64, 整64> 类析构位们;       // 类名ID -> 1（有析构函数）

// 任务级生命周期清空（主.cn 与 清空结构体布局表 同步调用；多文件窗口重置）
函数 清空类表() -> 空类型 {
    用户类们.清空();
    类方法返回们.清空();
    类方法参数串们.清空();
    类构造参数串们.清空();
    类析构位们.清空();
}

// 登记类名（解析类声明调用；幂等——解析期单点）
函数 登记用户类(整64 类名ID) -> 空类型 {
    结果<空类型, 整32> 设 = 用户类们.设置(类名ID, 1);
    如果 (!设.正常) { 运行时错误(4); }
}

函数 是用户类ID(整64 名ID) -> 布尔 {
    结果<整64, 整32> 查 = 用户类们.获取(名ID);
    返回 查.正常;
}

// 字符串形态判定（IR 深处拿到类型文本——容器类判定同款消费面）
函数 是用户类(字符串 名) -> 布尔 {
    结果<整64, 整32> 查 = 用户类们.获取(驻留(名));
    返回 查.正常;
}

// 登记类方法（普通方法/构造/析构统一入口）：返回类型名ID + 参数串（空=无参）。
// 同名方法已登记=第一版不支持重载（语法层已诊断——此处防御保留首登记）
函数 登记类方法(整64 类名ID, 整64 方法名ID, 整64 返回类型ID, 字符串 参数串) -> 空类型 {
    结果<整64, 整32> 查有 = 类方法返回们.获取(类名ID * 键位移 + 方法名ID);
    如果 (!查有.正常) {
        结果<空类型, 整32> 设返 = 类方法返回们.设置(类名ID * 键位移 + 方法名ID,
                                                      返回类型ID);
        如果 (!设返.正常) { 运行时错误(4); }
    }
    结果<空类型, 整32> 设串 = 类方法参数串们.设置(类名ID * 键位移 + 方法名ID,
                                                  驻留(参数串));
    如果 (!设串.正常) { 运行时错误(4); }
}

函数 有类方法(整64 类名ID, 整64 方法名ID) -> 布尔 {
    结果<整64, 整32> 查 = 类方法返回们.获取(类名ID * 键位移 + 方法名ID);
    返回 查.正常;
}

// 查方法返回类型名ID（0=无此方法）
函数 查类方法返回(整64 类名ID, 整64 方法名ID) -> 整64 {
    结果<整64, 整32> 查 = 类方法返回们.获取(类名ID * 键位移 + 方法名ID);
    如果 (查.正常) { 返回 查.值; }
    返回 0;
}

// 查方法参数串 ID（0=无此方法）
函数 查类方法参数串(整64 类名ID, 整64 方法名ID) -> 整64 {
    结果<整64, 整32> 查 = 类方法参数串们.获取(类名ID * 键位移 + 方法名ID);
    如果 (查.正常) { 返回 查.值; }
    返回 0;
}

// 登记构造器（方法名=类名ID 同键并存——构造符号=类名$类名[#参数串] 由 IR 层合成）
函数 登记类构造(整64 类名ID, 字符串 参数串) -> 空类型 {
    结果<空类型, 整32> 设 = 类构造参数串们.设置(类名ID, 驻留(参数串));
    如果 (!设.正常) { 运行时错误(4); }
}

// 查构造参数串 ID（0=无构造器——第一版要求类必有构造器，检查层诊断）
函数 查类构造参数串(整64 类名ID) -> 整64 {
    结果<整64, 整32> 查 = 类构造参数串们.获取(类名ID);
    如果 (查.正常) { 返回 查.值; }
    返回 0;
}

函数 登记类析构(整64 类名ID) -> 空类型 {
    结果<空类型, 整32> 设 = 类析构位们.设置(类名ID, 1);
    如果 (!设.正常) { 运行时错误(4); }
}

// 类是否有析构函数（RAII 分派：有析构类局部函数出口析构——对齐宿主
//   ir_decl.cpp「类类型局部变量（有析构函数）收尾 DeleteObject」口径；
//   无析构类不释放=宿主既有语义，浅共享保守——移植纪律 7 不变量）
函数 类有析构(整64 类名ID) -> 布尔 {
    结果<整64, 整32> 查 = 类析构位们.获取(类名ID);
    返回 查.正常;
}

// ==================== 416-a（D42 甲案波 2）：泛型类实例单态化表 ====================
// 职责：用户泛型类实例（盒子$整32）的收集与注册——实例合成名注册为「完整
//   用户类」（类名表+布局+字段偏移/类型+方法表+构造/析构位），既有用户类全链
//   （对象声明/方法调用/字段访问/RAII）零修改复用；方法体单态化=类体 AST 克隆
//   （克隆泛型类节点→实例类节点·生成类方法们 对克隆体照常生成·符号自动含实例
//   参数）。rustc instantiate 同构（编译期一次性·运行期零开销）。
// 基类参数序表：基名ID -> 参数名串（"T,U" 驻留ID·解析泛型类声明 登记点）。
静态 映射<整64, 整64> 泛型基类参数序们;
静态 向量<整64> 泛型实例们;        // 实例合成名ID（去重平铺·收集序）
静态 向量<整64> 泛型实例类节点们;  // 平行：实例ID -> 克隆类节点索引（池尾·生成期消费）
静态 向量<整64> 泛型实例函数节点们; // 419-a：函数实例ID -> 克隆函数节点索引（池尾）

// 任务级生命周期（主.cn 与 清空类表 同位调用）
函数 清空泛型实例们() -> 空类型 {
    泛型基类参数序们.清空();
    泛型实例们.清空();
    泛型实例类节点们.清空();
    泛型实例函数节点们.清空();
}

// 登记泛型基类参数序（解析泛型类声明 调用·幂等）
函数 登记泛型基类参数序(整64 基名ID, 字符串 参数名串) -> 空类型 {
    // 417-a：泛型函数声明共用本表（函数名 ID 键）——类存在防御删除（调用点
    //   次序自保证：类=解析类声明 后·函数=解析函数声明 后）
    结果<空类型, 整32> 设g = 泛型基类参数序们.设置(基名ID, 驻留(参数名串));
    如果 (!设g.正常) { 运行时错误(4); }
}

// 查基类参数名串 ID（0=非泛型基类）
函数 查泛型基类参数序(整64 基名ID) -> 整64 {
    结果<整64, 整32> 查g = 泛型基类参数序们.获取(基名ID);
    如果 (查g.正常) { 返回 查g.值; }
    返回 0;
}

// 剥实例合成名基名（首 '$' 前段；无 '$' 返回原文——非泛型类构造/析构符号
//   保持 类$类名 既有口径·调用方 方法符号(类型文本, 剥实例基名(类型文本)) 对
//   两类形态统一成立）
函数 剥实例基名(字符串 合成名) -> 字符串 {
    整64 i = 0;
    当 (i < 字符串长度(合成名)) {
        如果 (字符串比较(字符串子串(合成名, 整32(i), 1), "$")) {
            返回 字符串子串(合成名, 0, 整32(i));
        }
        i++;
    }
    返回 字符串复制(合成名);
}

// 剥实例参数段（首 '$' 后按 '$' 分段·平铺 ID 向量；无参=空）
函数 剥实例参数段(字符串 合成名, 向量<整64>& 段名ID们) -> 空类型 {
    整64 首i = 0 - 1;
    整64 i = 0;
    当 (i < 字符串长度(合成名)) {
        如果 (字符串比较(字符串子串(合成名, 整32(i), 1), "$")) {
            如果 (首i == 0 - 1) { 首i = i; }
            i++;
            继续;
        }
        i++;
    }
    如果 (首i == 0 - 1) { 返回; }
    // 从首 '$' 后逐段（'$' 分隔）
    整64 段起 = 首i + 1;
    i = 段起;
    当 (i <= 字符串长度(合成名)) {
        如果 (i == 字符串长度(合成名) ||
             字符串比较(字符串子串(合成名, 整32(i), 1), "$")) {
            如果 (i > 段起) {
                结果<空类型, 整32> 加段 = 段名ID们.追加(整64(驻留(字符串子串(合成名, 整32(段起), 整32(i - 段起)))));
                如果 (!加段.正常) { 运行时错误(4); }
            }
            段起 = i + 1;
        }
        i++;
    }
}

// 类型文本的参数替换（精确匹配或 参数名+*/&/[n] 后缀；嵌套 $ 含参名=不替换
//   〔嵌套泛型实参=波3 面·保持原文交既有诊断〕）
函数 替换实例类型文本(字符串 类型文本, 向量<整64>& 参数名ID们, 向量<整64>& 实参ID们) -> 字符串 {
    整64 i = 0;
    当 (i < 参数名ID们.大小() && i < 实参ID们.大小()) {
        字符串 参数名t = 字符串复制(驻留文本(参数名ID们.元素(i)));
        字符串 实参t = 字符串复制(驻留文本(实参ID们.元素(i)));
        整64 参数长t = 字符串长度(参数名t);
        整64 文本长t = 字符串长度(类型文本);
        如果 (文本长t >= 参数长t) {
            // 前缀精确匹配（逐字符·字符串比较 相等=真）
            整64 匹配长t = 0;
            当 (匹配长t < 参数长t) {
                如果 (!字符串比较(字符串子串(类型文本, 整32(匹配长t), 1),
                                  字符串子串(参数名t, 整32(匹配长t), 1))) { 中断; }
                匹配长t++;
            }
            如果 (匹配长t == 参数长t) {
                字符串 剩余t = 字符串子串(类型文本, 整32(参数长t), 整32(文本长t - 参数长t));
                // 剩余合法性：空 / 纯 *、& 字符 / [数字] 尾形态——防 前缀误替换
                整64 k = 0;
                布尔 合法后缀t = 真;
                当 (k < 字符串长度(剩余t)) {
                    字符串 ct = 字符串子串(剩余t, 整32(k), 1);
                    如果 (字符串比较(ct, "*") || 字符串比较(ct, "&")) {
                        k++;
                        继续;
                    }
                    如果 (字符串比较(ct, "[")) {
                        // [数字] 尾形态：数字直到 ']'
                        整64 m = k + 1;
                        当 (m < 字符串长度(剩余t)) {
                            字符串 cm = 字符串子串(剩余t, 整32(m), 1);
                            如果 (字符串比较(cm, "]")) { m++; 继续; }
                            m++;
                        }
                        k = 字符串长度(剩余t);
                        继续;
                    }
                    合法后缀t = 假;
                    中断;
                }
                如果 (合法后缀t == 真) {
                    返回 实参t + 剩余t;
                }
            }
        }
        i++;
    }
    返回 字符串复制(类型文本);
}

// 实例是否已登记（去重线性查）
函数 是泛型实例(整64 实例ID) -> 布尔 {
    整64 n = 泛型实例们.大小();
    整64 i = 0;
    当 (i < n) {
        如果 (泛型实例们.元素(i) == 实例ID) { 返回 真; }
        i++;
    }
    返回 假;
}

// 收集一个类型文本（含 '$' 且剥基名命中 用户类们→登记实例）
//   消费点=线性扫池内 节点_类型 节点（收集泛型实例）——容器/结果合成名被
//   生成期前置分派自过滤（是容器类/是结果类型 先于 是用户类），此处仅按
//   「基名是用户类」过滤——stdlib 容器基名不在 用户类们（登记用户类 仅类声明）。
函数 收集泛型实例文本(整64 类型名ID) -> 空类型 {
    字符串 文本g = 字符串复制(驻留文本(类型名ID));
    如果 (字符串长度(文本g) == 0) { 返回; }
    // 无 '$' = 非泛型形态（纯类名/基础类型）——提前返回（防非泛型类误收集）
    布尔 含合成符g = 假;
    整64 扫g = 0;
    当 (扫g < 字符串长度(文本g)) {
        如果 (字符串比较(字符串子串(文本g, 整32(扫g), 1), "$")) { 含合成符g = 真; }
        扫g++;
    }
    如果 (!含合成符g) { 返回; }
    字符串 基名g = 剥实例基名(文本g);
    如果 (字符串长度(基名g) == 0) { 返回; }
    // 419-a：类实例（基名∈用户类们）∪ 函数实例（基名∈泛型函数参数序表）
    如果 (!是用户类(基名g) && 查泛型基类参数序(驻留(基名g)) == 0) { 返回; }
    整64 实例IDg = 整64(驻留(文本g));
    如果 (!是泛型实例(实例IDg)) {
        结果<空类型, 整32> 加g = 泛型实例们.追加(实例IDg);
        如果 (!加g.正常) { 运行时错误(4); }
    }
}

// 线性扫程序区间全部 节点_类型 节点→收集实例（IR生成多文件 收集阶段调用·O(池)）
函数 收集泛型实例(向量<节点> 池, 向量<整32> 程序节点们) -> 空类型 {
    整64 f = 0;
    当 (f < 程序节点们.大小()) {
        节点 程序声明 = 池.元素(程序节点们.元素(整32(f)));
        整64 位置 = 整64(程序声明.子起点);
        整64 终点 = 整64(程序声明.子终点);
        当 (位置 < 终点) {
            节点 n = 池.元素(整32(位置));
            如果 (n.类型 == 节点_类型) {
                收集泛型实例文本(整64(n.文本));
            }
            如果 (n.类型 == 节点_调用 && n.子起点 > 0) {
                // 419-a：泛型函数显式实例化调用点（callee=名$实参合成名——
                //   被调标识符在 子起点·调用节点自身 文本=0）
                节点 被调c = 池.元素(整32(n.子起点));
                如果 (被调c.类型 == 节点_标识符) {
                    收集泛型实例文本(整64(被调c.文本));
                }
            }
            位置++;
        }
        f++;
    }
}

// 注册实例布局（从克隆类节点字段·字段类型已替换）：偏移/对齐重算+三表登记
//   （算法=解析类字段/布局收口 同款·键=实例ID）
函数 实例化布局登记(向量<节点> 池, 整32 克隆类节点索引) -> 空类型 {
    节点 类节点k = 池.元素(克隆类节点索引);
    整64 实例IDk = 整64(类节点k.文本);
    整64 字段偏移k = 0;
    整64 最大对齐k = 1;
    整64 位置k = 整64(类节点k.子起点);
    当 (位置k < 整64(类节点k.子终点)) {
        节点 成员k = 池.元素(整32(位置k));
        如果 (成员k.类型 == 节点_类字段) {
            // 克隆体 类字段.附加=克隆类型节点索引（克隆器已修针）
            节点 类型节点k = 池.元素(整32(成员k.附加));
            字符串 字段类型文本k = 字符串复制(驻留文本(整64(类型节点k.文本)));
            整64 字段大小k = 8;
            整64 字段对齐k = 8;
            类型大小与对齐(字段类型文本k, &字段大小k, &字段对齐k);
            整64 余k = 字段偏移k % 字段对齐k;
            如果 (余k != 0) { 字段偏移k = 字段偏移k + (字段对齐k - 余k); }
            整64 分桶键k = 实例IDk * 键位移 + 整64(成员k.文本);
            登记字段类型(分桶键k, 整64(类型节点k.文本));
            登记字段偏移(分桶键k, 字段偏移k);
            如果 (字段对齐k > 最大对齐k) { 最大对齐k = 字段对齐k; }
            字段偏移k = 字段偏移k + 字段大小k;
        }
        位置k++;
    }
    整64 尾余k = 字段偏移k % 最大对齐k;
    如果 (尾余k != 0) { 字段偏移k = 字段偏移k + (最大对齐k - 尾余k); }
    登记结构体布局(实例IDk, 字段偏移k, 最大对齐k, 1);
}

// 克隆泛型类节点为实例类节点（两遍法：①区间内逐节点值拷贝+索引映射·
//   节点_类型 文本替换；②修针=子区间平移（>0 才平移·0=空保持——池索引 0 哨兵
//   纪律）/类字段与参数的附加（类型节点索引）映射/方法附加（返回类型ID）替换）。
//   节点_方法.子终点=块单点索引——开区间映射公式（映射[旧终点-1]+1）天然兼容。
// 返回 克隆类节点池索引。
函数 克隆泛型类节点(向量<节点> 池, 整32 类节点索引, 整64 实例ID,
                 向量<整64>& 参数名ID们, 向量<整64>& 实参ID们) -> 整32 {
    节点 基类节点c = 池.元素(类节点索引);
    整64 旧起c = 整64(基类节点c.子起点);
    整64 旧终c = 整64(基类节点c.子终点);
    映射<整64, 整64> 索引映射c;
    // 遍 1：原样复制（类型文本替换）+映射
    整64 ic = 旧起c;
    当 (ic < 旧终c) {
        节点 nc = 池.元素(整32(ic));
        如果 (nc.类型 == 节点_类型) {
            字符串 原文本c = 字符串复制(驻留文本(整64(nc.文本)));
            字符串 新文本c = 替换实例类型文本(原文本c, 参数名ID们, 实参ID们);
            如果 (!字符串比较(新文本c, 原文本c)) {
                nc.文本 = 整32(驻留(新文本c));
            }
        }
        整64 新索引c = 池.大小();
        池追加(池, nc);
        结果<空类型, 整32> 设mc = 索引映射c.设置(ic, 新索引c);
        如果 (!设mc.正常) { 运行时错误(4); }
        ic++;
    }
    // 遍 2：修针（写回池.设置——值语义）
    ic = 旧起c;
    当 (ic < 旧终c) {
        结果<整64, 整32> 查mc = 索引映射c.获取(ic);
        如果 (查mc.正常) {
        节点 n2c = 池.元素(整32(查mc.值));
        如果 (n2c.子起点 > 0) {
            结果<整64, 整32> 查sc = 索引映射c.获取(整64(n2c.子起点));
            如果 (查sc.正常) { n2c.子起点 = 整32(查sc.值); }
        }
        如果 (n2c.子终点 > 0) {
            结果<整64, 整32> 查ec = 索引映射c.获取(整64(n2c.子终点) - 1);
            如果 (查ec.正常) { n2c.子终点 = 整32(查ec.值) + 1; }
        }
        如果 (n2c.类型 == 节点_类字段 || n2c.类型 == 节点_参数) {
            如果 (n2c.附加 > 0) {
                结果<整64, 整32> 查ac = 索引映射c.获取(n2c.附加);
                如果 (查ac.正常) { n2c.附加 = 查ac.值; }
            }
        }
        如果 (n2c.类型 == 节点_方法) {
            如果 (n2c.附加 > 0) {
                字符串 返原c = 字符串复制(驻留文本(n2c.附加));
                字符串 返新c = 替换实例类型文本(返原c, 参数名ID们, 实参ID们);
                如果 (!字符串比较(返新c, 返原c)) { n2c.附加 = 整64(驻留(返新c)); }
            }
        }
        结果<空类型, 整32> 设w2c = 池.设置(整32(查mc.值), n2c);
        如果 (!设w2c.正常) { 运行时错误(4); }
        }
        ic++;
    }
    // 实例类节点（文本=实例合成名ID·区间=克隆体首尾）
    结果<整64, 整32> 查fc = 索引映射c.获取(旧起c);
    结果<整64, 整32> 查lc = 索引映射c.获取(旧终c - 1);
    整64 新起f = 0;
    如果 (查fc.正常) { 新起f = 查fc.值; }
    整64 新终l = 0;
    如果 (查lc.正常) { 新终l = 查lc.值; }
    节点 实例类节点c;
    实例类节点c.类型 = 节点_类;
    实例类节点c.文本 = 整32(实例ID);
    实例类节点c.附加 = 0;
    实例类节点c.子起点 = 整32(新起f);
    实例类节点c.子终点 = 整32(新终l + 1);
    实例类节点c.行 = 0;
    实例类节点c.修饰 = 0;
    整32 克隆索引c = 整32(池.大小());
    池追加(池, 实例类节点c);
    返回 克隆索引c;
}

// 实例方法表登记（从克隆类节点·参数串从克隆方法节点参数区拼·返回/参数类型
//   已被克隆器替换——登记格式与语义收集类方法 同款：构造=方法名==类名/析构=
//   ~类名 前缀/普通方法）
函数 实例化方法表登记(向量<节点> 池, 整32 克隆类节点索引) -> 空类型 {
    节点 类节点m = 池.元素(克隆类节点索引);
    整64 实例IDm = 整64(类节点m.文本);
    整64 位置m = 整64(类节点m.子起点);
    当 (位置m < 整64(类节点m.子终点)) {
        节点 成员m = 池.元素(整32(位置m));
        如果 (成员m.类型 == 节点_方法) {
            字符串 参数串m = 函数参数串(池, 整32(位置m));
            整64 方法名IDm = 整64(成员m.文本);
            整64 返回类型IDm = 整64(成员m.附加);
            如果 (返回类型IDm == 0) { 返回类型IDm = 整64(驻留("空类型")); }
            如果 (方法名IDm == 实例IDm) {
                登记类构造(实例IDm, 参数串m);
            } 否则 如果 (字符串比较(字符串子串(驻留文本(方法名IDm), 0, 1), "~")) {
                登记类析构(实例IDm);
            } 否则 {
                登记类方法(实例IDm, 方法名IDm, 返回类型IDm, 参数串m);
            }
        }
        位置m++;
    }
}

// 实例化总编排（IR生成多文件 收集阶段·生成主循环之前调用）：
//   逐实例→剥基名/实参段→取基类参数序→定位基类类节点→克隆→布局登记→
//   方法表登记→克隆索引表（生成期 生成类方法们 分派消费）。
函数 实例化注册(向量<节点> 池, 向量<整32> 程序节点们) -> 空类型 {
    整64 n = 泛型实例们.大小();
    整64 i = 0;
    当 (i < n) {
        整64 实例IDr = 泛型实例们.元素(i);
        字符串 实例文本r = 字符串复制(驻留文本(实例IDr));
        字符串 基名r = 剥实例基名(实例文本r);
        整64 基名IDr = 整64(驻留(基名r));
        整64 参数序IDr = 查泛型基类参数序(基名IDr);
        如果 (参数序IDr == 0) {
            i++;
            继续;   // 非泛型基类的 $ 名（防御·零注册）
        }
        向量<整64> 参数名们r = 向量<整64>();
        向量<整64> 实参们r = 向量<整64>();
        // 参数名串（逗号分隔）拆段
        字符串 参数串文本r = 字符串复制(驻留文本(参数序IDr));
        整64 段起r = 0;
        整64 cr = 0;
        当 (cr <= 字符串长度(参数串文本r)) {
            布尔 尾r = cr == 字符串长度(参数串文本r);
            如果 (尾r || 字符串比较(字符串子串(参数串文本r, 整32(cr), 1), ",")) {
                如果 (cr > 段起r) {
                    结果<空类型, 整32> 加nr = 参数名们r.追加(整64(驻留(字符串子串(参数串文本r, 整32(段起r), 整32(cr - 段起r)))));
                    如果 (!加nr.正常) { 运行时错误(4); }
                }
                段起r = cr + 1;
            }
            cr++;
        }
        剥实例参数段(实例文本r, 实参们r);
        如果 (参数名们r.大小() != 实参们r.大小()) {
            IR层诊断("泛型实例实参与基类参数序不匹配: " + 实例文本r);
            运行时错误(6);
        }
        // 定位基类类节点（程序区间扫描）
        整32 基类索引r = 0 - 1;
        整64 f = 0;
        当 (f < 程序节点们.大小() && 基类索引r == 0 - 1) {
            节点 程序声明r = 池.元素(程序节点们.元素(整32(f)));
            整64 位置r = 整64(程序声明r.子起点);
            整64 终点r = 整64(程序声明r.子终点);
            当 (位置r < 终点r) {
                节点 声明r = 池.元素(整32(位置r));
                如果 (声明r.类型 == 节点_类 && 整64(声明r.文本) == 基名IDr) {
                    基类索引r = 整32(位置r);
                    中断;
                }
                位置r++;
            }
            f++;
        }
        如果 (基类索引r == 0 - 1) {
            i++;
            继续;   // 基类不在本编译单元（跨模块=波3 面·静默零注册）
        }
        // 注册为完整用户类（对象声明/方法调用分派链入口——是用户类(实例合成名)）
        登记用户类(实例IDr);
        整32 克隆索引r = 克隆泛型类节点(池, 基类索引r, 实例IDr, 参数名们r, 实参们r);
        实例化布局登记(池, 克隆索引r);
        实例化方法表登记(池, 克隆索引r);
        结果<空类型, 整32> 加cr = 泛型实例类节点们.追加(整64(克隆索引r));
        如果 (!加cr.正常) { 运行时错误(4); }
        i++;
    }
}

// 419-a（D42 波 3）：克隆泛型函数节点为实例函数节点（两遍法同 克隆泛型类节点——
//   区间=函数节点子区间（参数区+体块）+函数节点本身（文本=实例合成名ID·
//   附加=返回类型ID 替换）。返回 克隆函数节点池索引。
函数 克隆泛型函数节点(向量<节点> 池, 整32 函数节点索引, 整64 实例ID,
                   向量<整64>& 参数名ID们, 向量<整64>& 实参ID们) -> 整32 {
    节点 基函数节点c = 池.元素(函数节点索引);
    整64 旧起c = 整64(基函数节点c.子起点);
    整64 旧终c = 整64(基函数节点c.子终点);   // =块节点索引（单点）
    // 420-a 根治：克隆区间 **闭式含块**——原 [旧起, 旧终) 漏块节点→克隆体无
    //   体块→生成块 拿参数节点当块=空体（返回 长度 读 0/数组[0] 读垃圾 184
    //   实测）。函数节点.子终点=块索引 单点语义（区别于类节点的区间终点）。
    旧终c = 旧终c + 1;
    映射<整64, 整64> 索引映射c;
    整64 ic = 旧起c;
    当 (ic < 旧终c) {
        节点 nc = 池.元素(整32(ic));
        如果 (nc.类型 == 节点_类型) {
            字符串 原文本c = 字符串复制(驻留文本(整64(nc.文本)));
            字符串 新文本c = 替换实例类型文本(原文本c, 参数名ID们, 实参ID们);
            如果 (!字符串比较(新文本c, 原文本c)) {
                nc.文本 = 整32(驻留(新文本c));
            }
        }
        整64 新索引c = 池.大小();
        池追加(池, nc);
        结果<空类型, 整32> 设mc = 索引映射c.设置(ic, 新索引c);
        如果 (!设mc.正常) { 运行时错误(4); }
        ic++;
    }
    ic = 旧起c;
    当 (ic < 旧终c) {
        结果<整64, 整32> 查mc = 索引映射c.获取(ic);
        如果 (查mc.正常) {
        节点 n2c = 池.元素(整32(查mc.值));
        如果 (n2c.子起点 > 0) {
            结果<整64, 整32> 查sc = 索引映射c.获取(整64(n2c.子起点));
            如果 (查sc.正常) { n2c.子起点 = 整32(查sc.值); }
        }
        如果 (n2c.子终点 > 0) {
            结果<整64, 整32> 查ec = 索引映射c.获取(整64(n2c.子终点) - 1);
            如果 (查ec.正常) { n2c.子终点 = 整32(查ec.值) + 1; }
        }
        如果 (n2c.类型 == 节点_类字段 || n2c.类型 == 节点_参数) {
            如果 (n2c.附加 > 0) {
                结果<整64, 整32> 查ac = 索引映射c.获取(n2c.附加);
                如果 (查ac.正常) { n2c.附加 = 查ac.值; }
            }
        }
        结果<空类型, 整32> 设w2c = 池.设置(整32(查mc.值), n2c);
        如果 (!设w2c.正常) { 运行时错误(4); }
        }
        ic++;
    }
    // 实例函数节点（文本=实例合成名ID·附加=替换后返回类型·区间=克隆体）
    整64 原返c = 整64(基函数节点c.附加);
    整64 新返c = 0;
    如果 (原返c > 0) {
        字符串 返原c = 字符串复制(驻留文本(原返c));
        字符串 返新c = 替换实例类型文本(返原c, 参数名ID们, 实参ID们);
        新返c = 整64(驻留(返新c));
    }
    结果<整64, 整32> 查fc2 = 索引映射c.获取(旧起c);
    结果<整64, 整32> 查lc2 = 索引映射c.获取(旧终c - 1);
    整64 新起f2 = 0;
    如果 (查fc2.正常) { 新起f2 = 查fc2.值; }
    整64 新终l2 = 0;
    如果 (查lc2.正常) { 新终l2 = 查lc2.值; }
    节点 实例函数节点c;
    实例函数节点c.类型 = 节点_函数;
    实例函数节点c.文本 = 整32(实例ID);
    实例函数节点c.附加 = 整32(新返c);
    实例函数节点c.子起点 = 整32(新起f2);
    // 子终点=块节点索引（单点语义·非区间+1）——生成函数 按 块.子起点 定参数
    //   终点、按 块索引 取体块；+1 即指向垃圾节点=参数遍历区间错位+体块错
    //   （420-a gdb/asm 铁证：prologue 参数读 [rbp+288]·槽序错位 ~30）
    实例函数节点c.子终点 = 整32(新终l2);
    实例函数节点c.行 = 0;
    实例函数节点c.修饰 = 基函数节点c.修饰;
    整32 克隆索引c = 整32(池.大小());
    池追加(池, 实例函数节点c);
    返回 克隆索引c;
}

// 419-a：函数实例化总编排（IR生成多文件 收集阶段·实例类注册 后调用）：
//   逐实例（剥基名→泛型函数参数序命中=函数实例）→定位基函数节点→克隆→
//   函数节点平行表（生成期 生成遍历分派消费）。类实例由 实例化注册 处理
//   （剥基名查 用户类们——两编排互斥判定）。
函数 实例化函数注册(向量<节点> 池, 向量<整32> 程序节点们, 字符串 模块路径) -> 空类型 {
    整64 n = 泛型实例们.大小();
    整64 i = 0;
    当 (i < n) {
        整64 实例IDr = 泛型实例们.元素(i);
        字符串 实例文本r = 字符串复制(驻留文本(实例IDr));
        字符串 基名r = 剥实例基名(实例文本r);
        整64 基名IDr = 整64(驻留(基名r));
        整64 参数序IDr = 查泛型基类参数序(基名IDr);
        如果 (参数序IDr == 0) { i++; 继续; }
        如果 (是用户类ID(基名IDr)) { i++; 继续; }   // 类实例=实例化注册 已处理
        // 参数名/实参段拆分
        向量<整64> 参数名们r2 = 向量<整64>();
        向量<整64> 实参们r2 = 向量<整64>();
        字符串 参数串文本r2 = 字符串复制(驻留文本(参数序IDr));
        整64 段起r2 = 0;
        整64 cr2 = 0;
        当 (cr2 <= 字符串长度(参数串文本r2)) {
            如果 (cr2 == 字符串长度(参数串文本r2) ||
                 字符串比较(字符串子串(参数串文本r2, 整32(cr2), 1), ",")) {
                如果 (cr2 > 段起r2) {
                    结果<空类型, 整32> 加nr2 = 参数名们r2.追加(整64(驻留(字符串子串(参数串文本r2, 整32(段起r2), 整32(cr2 - 段起r2)))));
                    如果 (!加nr2.正常) { 运行时错误(4); }
                }
                段起r2 = cr2 + 1;
            }
            cr2++;
        }
        剥实例参数段(实例文本r, 实参们r2);
        如果 (参数名们r2.大小() != 实参们r2.大小()) {
            IR层诊断("泛型函数实例实参与参数序不匹配: " + 实例文本r);
            运行时错误(6);
        }
        // 定位基函数节点
        整32 基函数索引r = 0 - 1;
        整64 f = 0;
        当 (f < 程序节点们.大小() && 基函数索引r == 0 - 1) {
            节点 程序声明r = 池.元素(程序节点们.元素(整32(f)));
            整64 位置r = 整64(程序声明r.子起点);
            整64 终点r = 整64(程序声明r.子终点);
            当 (位置r < 终点r) {
                节点 声明r = 池.元素(整32(位置r));
                如果 (声明r.类型 == 节点_函数 && 整64(声明r.文本) == 基名IDr) {
                    基函数索引r = 整32(位置r);
                    中断;
                }
                位置r++;
            }
            f++;
        }
        如果 (基函数索引r == 0 - 1) {
            i++; 继续;
        }
        整32 克隆索引r = 克隆泛型函数节点(池, 基函数索引r, 实例IDr, 参数名们r2, 实参们r2);
        // 签名表登记（克隆体·替换后参数串）——调用侧 决议函数符号 与定义侧
        //   函数签名键 同公式同源（缺失=调用侧裸名 call vs 定义侧类型编码
        //   符号·链接 undefined 的根因）
        登记函数签名K(池, 克隆索引r, 键基合成(模块路径, 实例IDr));
        结果<空类型, 整32> 加fr = 泛型实例函数节点们.追加(整64(克隆索引r));
        如果 (!加fr.正常) { 运行时错误(4); }
        i++;
    }
}
