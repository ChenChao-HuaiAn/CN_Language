// CN 自举编译器 v2：结构化 IR 生成器（自举重建 P5，2026-08-25）
// 性能最优架构第三层：AST 节点池（后缀表达式栈）-> 三地址码 IR 指令数组。
// 设计（对标 rustc/LLVM）：
//   - 指令为结构化结构体（操作码/操作数/结果寄存器/类型码/附加），非字符串行。
//   - 寄存器 = 整数 ID（虚拟寄存器，代码生成阶段映射到栈槽）。
//   - 表达式按后缀栈求值：遍历节点池区间，字面量/标识符压栈（生成加载指令），
//     二元/后缀操作符弹栈生成运算指令，结果压栈。
//   - 语句按 子起点/子终点 区间遍历；变量声明分配槽（映射 名ID -> 槽索引）。
// 依赖：P2 词法（Token）/ P3 语法（节点池）/ P4 语义（类型检查）。
// 说明：本组件只生成 IR 指令（不含汇编输出——汇编在 P6 代码生成组件）。
公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）


导入 容器::向量;
导入 语法;       // Token/AST 节点池（原 语法分析，阶段目录包名）
导入 IR;         // 容器判定/符号合成 + IR_*/T_* 操作码（原 IR容器+IR常量 合并目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
               //   单一归属 IR常量.cn（原定义在本文件顶层，IR容器 引用不可导=循环）

公开:

// ==================== 结构化 IR 指令 ====================
// 呈报①A 根治（2026-09-05）：IR指令/函数IR 结构体定义下沉至 IR容器.cn
//   （本文件导入它）——原定义在本文件顶层，IR容器.cn 引用它们而 IR生成 导入
//   IR容器 = 反向引用不可导；主链靠多文件合并全局可见，冒烟子链（IR容器/
//   语法分析/语义分析 入口，链上无本文件）结构体登记缺失 -> 方法对象类型解析
//   查结构体大小 miss =「方法调用的对象类型未知: 元素」误诊（曾误归因
//   IR常量.cn 新增常量对——第十四轮消融的「不触发」系检查面不全/陈旧产物假绿）。
//   此处纯名引用（导入 IR容器 后全局可见）。程序IR 定义保留在本文件
//   （引用方：代码生成族/主——导入链恒含本文件）。

// 程序 IR：函数 IR 列表
结构体 程序IR {
    向量<函数IR> 函数们;
    整64 静态数;              // ②c C：静态槽总数（双后端 .data 发射 _cn_gstatic_N）
    向量<整64> 静态初始值们;  // ②c C：各静态初始值文本ID（容器=0；标量=折叠字面量）
}

// ==================== 控制流辅助（P6b） ====================
// 新建块：返回唯一块 ID（标签随建随取——嵌套控制流每个标签独立计数）
函数 新块(函数IR& 函数信息) -> 整64 {
    函数信息.块计数 = 函数信息.块计数 + 1;
    返回 函数信息.块计数;
}

// 发射无条件跳转到目标块
函数 发射跳转(函数IR& 函数信息, 整64 目标块) -> 空类型 {
    IR追加(函数信息.指令, 建IR指令(IR_跳转, 0, 0, 0, 0, 0, 目标块));
}

// 发射条件跳转：条件寄存器 非零 -> 真块；零 -> 假块
函数 发射条件跳转(函数IR& 函数信息, 整64 条件寄存器, 整64 真块, 整64 假块) -> 空类型 {
    IR追加(函数信息.指令, 建IR指令(IR_条件跳转, 条件寄存器, 真块, 假块, 0, 0, 0));
}

// 发射块标签：MASM 需要标号（bbN:）。IR 层只登记块 ID，代码生成按块号输出标签。
函数 发射块标签(函数IR& 函数信息, 整64 块ID) -> 空类型 {
    // 块标签无需 IR 指令——代码生成按 当前块 切换时输出；此辅助仅作文档性登记
    IR追加(函数信息.指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 块ID));
}

// 切换当前块：记录 当前块；代码生成据此输出 bbN: 标签
函数 切换块(函数IR& 函数信息, 整64 块ID) -> 空类型 {
    函数信息.当前块 = 块ID;
}

// ==================== 表达式栈净栈契约（第八十八轮 88-a，单一事实源） ====================
// **契约**：`生成表达式(区间)` 的净栈增量恒为 **+1**（求值结果=栈顶元素；无值形态
//   返回 0 且净 0）。一切消费点据此工作：
//     ①「相对栈顶」消费——生成调用 弹（实参数+被调）/二元弹2/下标弹2/方法接收者弹对象；
//     ②「弹到进入前深度」归位——三元/一元/取地址/结构体构造字段。
// 违反契约（净 > +1）会让 ① 弹到**残留**而非真值：实参位短路 `f(a || b)` 原实现
//   只压不弹（左 +1/右 +1/结果 +1 = 净 +3）→ 弹 3 实参后被调取到左操作数寄存器 →
//   `[ir2] 调用被调对象非函数名/方法`（87-a 探针 v2w 实证；宿主同形态正确）。
// Rust 对照：rustc MIR 每个值有唯一 def-use（无隐式栈残留面）；CN 沿用后缀栈模型，
//   故以「净 +1」为不变量 + 本处两个归位原语为唯一实现点——**禁止裸循环弹栈复制**。
// 性能：纯编译期向量操作，运行时零成本；归位为自愈语义（内层残留一并清理）。
// 归位原语：弹到 深度（丢弃深度以上全部残留；深度 允许大于当前大小=无操作）。
函数 表达式栈弹到深度(向量<整64>& 表达式栈, 整64 深度) -> 空类型 {
    当 (表达式栈.大小() > 深度) {
        结果<空类型, 整32> 删栈归 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈归.正常) { 运行时错误(4); }
    }
}

// 归位压回：弹到 深度 后压回 结果寄存器（「结果留栈」形态出口；净 +1 契约实现）。
函数 表达式栈归位压回(向量<整64>& 表达式栈, 整64 深度, 整64 结果寄存器) -> 空类型 {
    表达式栈弹到深度(表达式栈, 深度);
    结果<空类型, 整32> 加归 = 表达式栈.追加(结果寄存器);
    如果 (!加归.正常) { 运行时错误(4); }
}

// ==================== 成员宽度/链式偏移收口（②b B5，2026-09-02） ====================
// 根治：字段按统一 8 字节读/写——末字段越界清零相邻槽（126 段① i 槽被 子终点
//   8 字节写击穿 -> 当循环死循环 -> 堆 OOM SIGKILL）+ 链式 池.元素(i).字段
//   偏移扁平回退（同名字段跨结构体必错）。宽度/偏移按 结构体名ID*键位移+字段名ID
//   分桶查（IR容器 字段类型表/字段偏移表们）。

// ②b B6：当前函数 retbuf 最大返回字节数（生成表达式 触不到 函数信息——模块级
//   累计；生成函数 入口清零、出口回填 函数信息.retbuf字节数）
静态 整64 当前retbuf字节数 = 0;

// 解析标识符对象的结构体名ID（②c D：函数级变量类型权威表 优先——解析期
//   变量结构体表 跨函数同名异型会串；值=1 是结构体名标记非对象类型）。
// 1541 B2 可选化：有值=结构体键基 ID（恒 >0）；无值=非结构体/未登记对象
//   （原 0 哨兵与合法键基 ID 同域不可分——miss 语义逐消费点等价保留）。
函数 解析对象结构体ID(节点 对象节点) -> 可选<整64> {
    如果 (对象节点.类型 != 节点_标识符) { 返回 无; }
    可选<整64> 查权威查 = 查当前函数变量类型(整64(对象节点.文本));
    如果 (查权威查.有值) {
        整64 查权威 = 查权威查.值;
        // plans/018 类型分桶：返回值统一键基域（结构体布局键基 幂等解析——
        //   权威表值 纯名/键基通吃；0=非结构体）
        // 362 根治（2026-10-10·双轨坑 B 家族 v2 版）：类指针字段权威表值带
        //   '*'（435-b 表存真类型·如 JSON树*）——「对象的结构体ID」语义=
        //   接收者解引用（001：. 左侧指针自动解引用一级）——剥星取所指布局。
        //   剥星须限本函数：键基入口无差别剥星误伤哨兵消费（指针形态判 0 的
        //   值类型判定）→126/127/147 dual 段错误+79_v2 自举崩（回归实验实锤）。
        整64 对象ID362 = 查权威;
        字符串 类型t362 = 字符串复制(驻留文本(查权威));
        如果 (字符串长度(类型t362) > 1 &&
             (整64(类型t362[字符串长度(类型t362) - 1]) & 255) == 42) {
            对象ID362 = 驻留(字符串子串(类型t362, 0, 整32(字符串长度(类型t362) - 1)));
        }
        返回 结构体布局键基(对象ID362);
    }
    // 1032（2026-10-17·#1032 静态泛型实例字段访问断链）：顶层静态表级回退——
    //   **泛型实例静态对象**（静态 盒子<整32> 全局盒）的类型解析入口。病面：
    //   全局盒.值 读/写全链 [ir2] 成员字段偏移未知/成员左值字段偏移未知/
    //   成员宽度码·对象类型未登记（编译期中止·宿主正常）。
    //   根因：本函数原两通道=①函数级权威表 ②变量结构体表（查结构体类型）
    //   ——②对普通静态结构体/类有效（语法层 解析静态声明 登记 变量结构体表
    //   时 查结构体类型(类名/结构体名) 在表命中），而泛型实例类型文本
    //   「盒子$整32」的实例身份在 **IR 收集阶段**才登记（IR类中 泛型实例注册
    //   登记变量结构体(实例ID,1)）——语法层登记窗口 查结构体类型(盒子$整32)
    //   恒 miss → 「全局盒」全表无登记 → IR 生成期本函数 miss → 字段三元组
    //   不查 → 偏移 -1 三链全断（921 轮静态专项副产品）。
    //   修复：与 87-a（解析标识符类型ID 补静态表级）同构——静态对象的类型
    //   权威=静态表（取静态类型 → 结构体布局键基 幂等进键基域）；IR 生成期
    //   实例布局已登记（实例化布局登记 裸键直设＋候选表），键基解析命中。
    //   容器/结果静态排除：其语法层登记走 变量容器表 分流（本函数语义=结构体
    //   布局键）——防容器实例布局（向量$整64 等）经本函数改变既有 miss 行为。
    结果<整64, 整32> 找静o1032 = 查静态序号含类(整64(对象节点.文本));
    如果 (找静o1032.正常) {
        整64 静类型o1032 = 取静态类型(找静o1032.值);
        字符串 静文本o1032 = 字符串复制(驻留文本(静类型o1032));
        如果 (!是容器类(静文本o1032) && !是结果类型(静文本o1032)) {
            返回 结构体布局键基(静类型o1032);
        }
    }
    // 1637：可选直通——有值=结构体键基（无值=非结构体·本函数可选返回同语义）
    返回 查结构体类型(整64(对象节点.文本));
}

// 解析调用对象（池.元素(i).字段 的对象）的返回结构体名ID——经被调方法签名返回
//   文本分桶收口；0=非结构体返回。②c A/B：对象经 解析节点类型ID 统一推导
//   （标识符/成员/调用 递归——函数级权威表优先）。
//   用户函数返回结构体（2026-09-04，E2E 148）：被调为普通标识符（造点(10,20).x
//   链式字段访问）——经 函数返回类型们 查返回类型，结构体即返回其名ID。
// plans/018 第 4 层（2026-09-07）：当前生成文件的模块路径（生成函数 开头设置
//   ——生成表达式深处纯名消费点键基回退用；单文件="主" 行为不变）。
// plans/018 类型分桶（2026-09-08）：统一归入 IR容器.当前模块路径（单一归属，
//   语法解析窗口与 IR 生成窗口共用，防双静态漂移）——本组件读 经 取当前模块路径()。

// 函数返回类型纯名查询（键基回退版——plans/018 第 4 层）：
//   ① 纯名直查（主模块双键形态——行为不变）；
//   ② miss 后键基回退：限定名（B1 改写产物/显式限定）拆 m::x 按 键基合成(m,x)；
//      纯名按 键基合成(取当前模块路径(), 名)（非主模块同文件/自模块调用）。
//   stdlib 限定与内置：miss 返回 0（非结构体/未知——既有兜底行为）。
//   366（2026-10-13）：内建限定名返回类型契约——标准库模块名分支原恒 0，使
//   「字符串构建器::完成」等 内置返回字符串 的 A2 拥有契约整体失效（出串
//   不 RAII·866 回落差 v2=1 实锤）；改先查 内置函数返回类型直查（miss=0
//   行为不变），stdlib 用户函数仍 0 兜底。
//   645（2026-10-14）：无限定内置返回类型兜底——「格式化/字符串大写/整数转
//   字符串」等无限定直调形态 ①纯名 ②键基 两查皆 miss（内置不进
//   函数返回类型们）→ 返回 0=A2 拥有契约判定整体失效：赋值位不 RAII（探针
//   908 v2 侧赋值位对照净泄 100·宿主同位绿=分叉）+语句位丢弃面同缺。
//   尾部兜底查 内置函数返回类型ID（两级：直查+归一基名·miss=0 行为不变——
//   生成表达式运算 表达式类型推导点早已同序内置先行，本处补齐单点事实源）。
// 1541 B2 可选化：有值=返回类型ID（恒 >0）；无值=返回类型未知（内置裸名/
//   类型转换/跨模块 miss——原 0 哨兵为合法信号，与合法类型 ID 同域不可分，
//   本波改无值通道显式承接；逐消费点 miss 语义等价保留）。
函数 查函数返回回退(整64 名ID) -> 可选<整64> {
    结果<整64, 整32> 查纯 = 函数返回类型们.获取(名ID);
    如果 (查纯.正常) {
        整64 纯返r = 查纯.值;
        返回 某些(纯返r);
    }
    字符串 名文本r = 字符串复制(驻留文本(名ID));
    字符串 模块s = "";
    字符串 符号s = "";
    如果 (拆限定名(名文本r, 模块s, 符号s) == 1) {
        // 366：内建限定名先查内置返回类型直查表（无值=非内置）
        如果 (是标准库模块名(模块s)) { 返回 内置函数返回类型直查(名文本r); }
        结果<整64, 整32> 查限 = 函数返回类型们.获取(键基合成(模块s, 驻留(符号s)));
        如果 (查限.正常) {
            整64 限返r = 查限.值;
            返回 某些(限返r);
        }
        // 648 归档（豁免边界声明）：本查询为「返回类型接口」——无值是
        //   合法信号，查表域外合法输入常态到达：v2 内置函数裸名（字符串长度 等
        //   ·运行时才映射 __cn_ 符号·L2 128/138/196/208 实证）、类型转换调用
        //   （整64(x) 的 整64·L2 150/181/193/194 实证）、跨文件函数键基 miss
        //   （120 常量和 实证）——1541 B2 改 无值 显式通道（原 0 哨兵）。
        返回 无;
    }
    结果<整64, 整32> 查键 = 函数返回类型们.获取(键基合成(取当前模块路径(), 名ID));
    如果 (查键.正常) {
        整64 键返r = 查键.值;
        返回 某些(键返r);
    }
    // 1390（#1353 收口）：跨模块**裸名**调用回退——多文件合并全局池下裸名可
    //   解析到他模块函数（同包成员/导入可见面，语义层已放行），而本表键均为
    //   定义模块键基/签名键：上方两查对裸名跨模块调用恒 miss → 结果/可选
    //   返回的 `调用().正常/.有值` 成员偏移未知 IR 中止（1390 最小探针
    //   [ir2] 成员字段偏移未知: .正常；宿主无模块键基分隔=正常放行，V2 单侧
    //   分叉）。仅**全局唯一名**（计数==1）采用；同名跨模块歧义维持原
    //   miss=无值（不猜返回类型——错误 ABI 比 miss 更危险）。
    结果<整64, 整32> 查计1390 = 函数名全局计数1390.获取(名ID);
    如果 (查计1390.正常 && 查计1390.值 == 1) {
        结果<整64, 整32> 查全1390 = 函数名全局返回1390.获取(名ID);
        如果 (查全1390.正常) {
            整64 全返1390 = 查全1390.值;
            返回 某些(全返1390);
        }
    }
    // 645（2026-10-14）：无限定内置返回类型兜底（两级：直查+归一基名·无值
    //   行为不变）——「格式化/字符串大写/整数转字符串」等无限定直调形态
    //   ①纯名 ②键基 两查皆 miss（内置不进 函数返回类型们）→ 原返回 0=A2
    //   拥有契约判定整体失效（探针 908 v2 侧赋值位对照净泄 100·宿主同位绿
    //   =分叉）+语句位丢弃面同缺。648 归档豁免面同源：本查询为「返回类型
    //   接口」——无值为合法信号（内置裸名/类型转换/跨文件键基 miss 常态
    //   到达），真 miss 显形在语义层；内置兜底优先于无值，非内置名仍落 无。
    返回 内置函数返回类型ID(名文本r);
}

// ③ 第三波：下标左值元素宽度码（p[i] = v 存储宽度）——指针对象经 指针变量
//   类型们 查所指类型 -> 类型宽度码；非指针对象默认 T_整64（语义层已拒，防御）
// 861-a（002 攻族 G-N 根因根治）：**成员链数组字段/数组变量对象**——原实现只认
//   「标识符+指针变量表」，对象为成员链（`出.分数[i] = v`·结构体数组字段元素）
//   或数组变量（`arr[i] = v`·非指针）时落 T_整64 默认 → **8 字节存储踩邻元素**
//   （三实锤 y1/y2/y3：整32[3] 字段写 [i] 清零 [i+1]——宿主 4 字节写正确）。
//   修复=97-a 既有通用设施 推导下标元素类型ID（标识符/成员/下标/指针链全形态）
//   兜底；原标识符指针分支保留在前（零回归优先），miss 才走通用推导。
不安全 // 871-a（070·G-N·870 修复的边界收口）：**局部/参数真指针**判定——
//   查指针变量类型 对**数组变量**（94-a 数组名退化为元素指针）同样返回元素类型，
//   直接用它区分「指针局部」会把数组变量误纳 → 数组下标/成员基址被改成「装载
//   槽值」（应取槽地址）→ 253/260 双编译对照崩（归属对照实验实锤）。判据=
//   指针表命中 且 变量类型文本**非数组**。
函数 局部真指针87(整64 名ID) -> 布尔 {
    可选<整64> 指针查87 = 查指针变量类型(名ID);
    如果 (!指针查87.有值) { 返回 假; }
    可选<整64> 类型IDp查 = 查当前函数变量类型(名ID);
    // 无值=非本函数变量（原 -1 与 ==0 判据漏判——统一按「非局部真指针」处置）
    如果 (!类型IDp查.有值) { 返回 假; }
    整64 类型IDp = 类型IDp查.值;
    如果 (类型IDp == 0) { 返回 假; }
    返回 !是数组类型文本(字符串复制(驻留文本(类型IDp)));
}

不安全 函数 取下标元素宽度码(向量<节点> 池, 整32 下标索引) -> 整64 {
    节点 s = 池.元素(下标索引);
    如果 (s.类型 == 节点_下标 && s.子起点 > 0) {
        节点 对象节点下 = 池.元素(整32(s.子起点));
        如果 (对象节点下.类型 == 节点_标识符) {
            结果<整64, 整32> 查所指宽 = 指针变量类型们.获取(整64(对象节点下.文本));
            如果 (查所指宽.正常) {
                返回 类型宽度码(驻留文本(查所指宽.值));
            }
            否则 {
            }
        }
        // 861-a：通用元素类型推导兜底（成员链数组字段/数组变量/下标链）
        整64 元素类型86 = 推导下标元素类型ID(池, 整32(s.子起点));
        如果 (元素类型86 > 0) {
            返回 类型宽度码(驻留文本(元素类型86));
        }
    }
    // 648：miss 不可静默——登记显形，收尾统一中止；原兜底保留（中止前路径）。
    //   指针表与通用推导双 miss（或非下标形态=上游分派防御）=真未登记面。
    //   行号=0（节点池无行号字段）。
    字符串 对象名下648 = "非下标形态";
    如果 (s.类型 == 节点_下标 && s.子起点 > 0) {
        对象名下648 = 字符串复制(驻留文本(整64(池.元素(整32(s.子起点)).文本)));
    }
    登记内部未登记("下标元素宽度", 对象名下648, 0);
    返回 T_整64;
}

// ==================== 函数级变量类型权威表（②c D，2026-09-02） ====================
// 解析期 变量容器表/变量结构体表 为全局按名键——跨函数同名异型（追加表 的参数 t
// 与 主 的局部 桶 t）串类型。本表由 生成函数 按当前函数填充（参数/容器/结果/
// 结构体局部），标识符类型解析先查此表（函数级真相），解析期表退为静态/兜底。
// 簇①根治·A2（2026-09-04）：表本体下沉 IR常量.cn（IR容器 成员推导双向引用，
//   原定义在本文件=不可导循环）；清空/填充/读取仍全在本组件。

// ③ 第一波（2026-09-03，缺陷①②当场根治后升级）：本函数「寄存器号 -> IR 类型码」
// 登记表——登记点：字面量（整数/字符串）/标识符加载（函数级权威表类型）/拼接 + 产物/
// 内置函数返回。消费点：打印 参数分派（print_str/float/bool/int）、拼接 双侧字符串性
// 判定与 隐式转换（from_int/from_float/from_bool）。生成函数 串行——无交叉，入口清空。
// 边界：无符号（正*）在 v2 类型码体系归并 T_整64（类型系统级现状，非本表层）。
静态 映射<整64, 整64> 寄存器类型们;

// 266-a 波B：指针值寄存器步进表（寄存器 -> 元素宽）——指针变量加载时登记，
//   二元 +/- 的指针算术步进糖消费（右×步进）。访问器模式（静态文件私有，
//   跨文件经函数——对齐 寄存器类型们 架构）。生成函数 串行·入口清空同款。
静态 映射<整64, 整64> 指针值步进们;

// ③ 第三波（2026-09-03）：指针变量类型表——名ID -> 所指元素类型名ID（参数/局部
//   类型节点 附加=指针层数 1..255 登记；语义层同款约定）。消费点：下标读分支
//   （步进=元素宽度/LoadPtr 宽度码/结果类型登记）、下标左值地址与赋值存储宽度。
//   生成函数 串行——入口清空（与 语义分析.指针变量表 平行，IR 层独立消费）。
静态 映射<整64, 整64> 指针变量类型们;

// 615（2026-10-16）：指针变量层数并行表——名ID -> 层数（1..255）。登记与
//   指针变量类型们 同点成对（登记指针变量类型 三参单点写·防漏改）；消费=
//   成员链对象段加载次数（顺序链标识符地址·多级指针变量经 (*qq).x 归一形态
//   须逐级解引用 N 次——N=1 逐字现状）。生命周期与 指针变量类型们 同
//   （清空函数级槽表 成对清）。
静态 映射<整64, 整64> 指针变量层数们;

// 登记寄存器类型（重复登记=后写覆盖——同一寄存器号本函数内不复用）
不安全 函数 登记寄存器类型(整64 寄存器, 整64 码) -> 空类型 {
    结果<空类型, 整32> 设型 = 寄存器类型们.设置(寄存器, 码);
    如果 (!设型.正常) { 运行时错误(4); }
}

// 查询寄存器类型码；无值=未登记（1360 批5 结果化——原 0 哨兵与 T_未知 合法
//   类型码/高频兜底值同域不可分）。
// 648 归档：无值=高频合法返回值面（「二元算术产物不登记·既有惯例」——产物码随
//   用随推，消费点按整数读法处理为设计行为）——函数内查表 miss 唯一、无
//   「真 miss」可分分支，不在本函数登记；真 miss 显形下沉到消费点的病态
//   兜底分支（如 生成表达式运算 位非操作码兜底处登记）。
// 1360 批5 结果化：命中 某些(码)、miss 无值；消费点按 无值=未登记 显式分流
//   （原「按 T_未知 整数兜底」的消费点保留同语义，但兜底赋值显形并登记）。
函数 查寄存器类型(整64 寄存器) -> 可选<整64> {
    结果<整64, 整32> 查型 = 寄存器类型们.获取(寄存器);
    // 静默豁免业务值: 查表 miss=未登记寄存器·可选无值（1360 批5 结果化——未登记语义由消费点显形为 T_未知）
    如果 (查型.正常) { 返回 某些(查型.值); } 否则 { 返回 无; }
}

// 未登记寄存器=类型未知（T_未知=0）——1360 批5 结果化显式业务兜底（唯一登记点）。
//   原 查寄存器类型 miss 返回 0 哨兵语义的单点承接：各处消费点按「未登记寄存器
//   =类型未知按整数兜底」处理，禁再散写 可选查+T_未知 初值+有值覆盖 三段式。
// 静默豁免业务值: 未登记寄存器=类型未知按整数兜底（原 查寄存器类型 miss 返回 0 语义）
函数 查寄存器类型或未知(整64 寄存器) -> 整64 {
    可选<整64> 码 = 查寄存器类型(寄存器);
    如果 (码.有值) { 返回 码.值; }
    返回 T_未知;
}


// 调用节点的被调方法返回容器类型（②c A：元素(i) 返回映射 等）；0=非容器返回。
//   递归经 解析方法对象类型 解析该调用自身的方法对象。
// 1541 B2 可选化：有值=容器类合成名 ID（恒 >0）；无值=非容器返回/不可解析
//   （原 0 哨兵与合法类型 ID 同域不可分——miss 语义等值保留）。
函数 解析调用返回容器(向量<节点> 池, 整32 调用索引) -> 可选<整64> {
    节点 调用节点 = 池.元素(调用索引);
    如果 (调用节点.类型 != 节点_调用 || 调用节点.子起点 <= 0) { 返回 无; }
    节点 被调成员 = 池.元素(整32(调用节点.子起点));
    如果 (被调成员.类型 != 节点_成员 || 被调成员.附加 != 成员方法标记) { 返回 无; }
    可选<整64> 对象类查 = 解析方法对象类型(池, 调用索引);
    如果 (!对象类查.有值) { 返回 无; }
    整64 对象类ID = 0;
    如果 (对象类查.有值) { 对象类ID = 对象类查.值; }
    字符串 类名 = 字符串复制(驻留文本(对象类ID));
    如果 (!是容器类(类名)) { 返回 无; }
    方法签名 签;
    如果 (!查方法签名(类名, 驻留文本(整64(被调成员.文本)), 调用节点.附加, &签)) { 返回 无; }
    如果 (字符串长度(签.返回文本) == 0) { 返回 无; }
    如果 (!是容器类(签.返回文本)) { 返回 无; }
    返回 某些(驻留(签.返回文本));
}

// ==================== 函数实参结构表与实参回扫（②b B3/B8，2026-09-02） ====================
// 普通函数调用的结构体按值实参 -> 传地址（B3 仅覆盖容器方法调用；v2 自身源码
//   IR追加(指令, 建IR指令(...)) 全是此形态，③ 自举必需）。表：函数名ID*键位移+
//   实参序 -> 1（该实参为结构体）。IR生成/IR生成多文件 入口收集（先于全部生成）。
静态 映射<整64, 整64> 函数实参结构们;

// 810（053）：函数实参 128 位表——实参位为 整128/正128 形参（键公式同 函数实参
//   结构们）。调用点回扫：实参寄存器已是句柄（T_整128/正128）→直传；64 位值
//   形态（字面量/窄表达式/64 位调用返回）→物化 2 槽（物化128位操作数·符号性
//   按其登记码）后传句柄——prologue 收地址双半拷 16 字节入本地副本（值语义）。
//   基线缺口实证：值直传→prologue 当地址解引用段错误（420-① 制造(字面量)/
//   153 第 6 参数位实锤）。
静态 映射<整64, 整64> 函数实参128位们;

// 432-b（撤守卫·stdlib 源码级）：实例克隆方法 引用/结构体实参位登记——原预扫
//   (收集函数实参结构) 只扫 节点_函数，类方法（实例克隆体）的引用形参从未入表
//   →调用方 回扫不取址→传值→被调方解引用写崩（123 链查找 整64& 前驱 实测
//   SIGSEGV，r10=-1=前驱初值当地址）。键公式与 发射用户类方法调用 同源：
//   驻留(方法符号(实例名, 方法名, 参数串)) * 键位移 + 实参序。
函数 收集实例方法实参引用(向量<节点> 池) -> 空类型 {
    // 510-a（T80 双侧根治·v2 侧）：原只覆盖 泛型实例类节点们（泛型克隆体）——
    //   **普通用户类**方法完全未登记 → 结构体按值实参在 函数实参结构们 无表项
    //   → 调用方 回扫不取址、传「字段值」而非结构体地址（探针 `盒{点 内; 设(点 p){…}}`
    //   + `b.设(点变量)` 产物 rsi=字段值 7 铁证·被调方解引用即段错误；宿主同形态
    //   同崩=双端）。改为**双源**：泛型实例克隆体（原路径）+ 池内全部 节点_类
    //   （普通用户类/stdlib 类；克隆体在池内=重复扫描，设置幂等无害）。
    整64 cb = 0;
    当 (cb < 泛型实例类节点们.大小()) {
        收集单类方法实参表(池, 整32(泛型实例类节点们.元素(cb)));
        cb++;
    }
    整64 pn = 0;
    当 (pn < 池.大小()) {
        节点 类候选 = 池.元素(整32(pn));
        如果 (类候选.类型 == 节点_类) { 收集单类方法实参表(池, 整32(pn)); }
        pn++;
    }
    // 552（接口方法 × 128 形参双侧同案·v2 侧）：接口方法实参表收集——接口
    //   方法无池节点形态（解析接口.cn 零池副作用：参数不建节点防池区间错位），
    //   须自接口表签名参数串收集（时机与实例方法收集同——全部解析完成后的
    //   生成入口；调用点 回扫结构体与引用实参 表驱动命中）。
    收集接口方法实参表();
}

// 510-a：单类节点的 方法实参 结构/引用 登记（自 收集实例方法实参引用 内层
//   机械提取·零语义改动——键公式=驻留(方法符号(类名文本, 方法名, 参数串))*键位移+实参序，
//   与 发射用户类方法调用 的查表键同源）。
不安全 函数 收集单类方法实参表(向量<节点> 池, 整32 类节点索引) -> 空类型 {
    {
        节点 克隆类节点d = 池.元素(类节点索引);
        整64 实例IDd = 整64(克隆类节点d.文本);
        字符串 实例文本d = 字符串复制(驻留文本(实例IDd));
        整64 位置d = 整64(克隆类节点d.子起点);
        当 (位置d < 整64(克隆类节点d.子终点)) {
            节点 成员d = 池.元素(整32(位置d));
            如果 (成员d.类型 == 节点_方法) {
                字符串 方法名文本d = 字符串复制(驻留文本(整64(成员d.文本)));
                字符串 参数串d = 函数参数串(池, 整32(位置d));
                整64 方法符号IDd = 整64(驻留(方法符号(实例文本d, 方法名文本d, 参数串d)));
                整64 参数终点d = 整64(成员d.子起点);
                如果 (成员d.子终点 < 池.大小()) {
                    参数终点d = 整64(池.元素(整32(成员d.子终点)).子起点);
                }
                整64 参数序d = 0;
                整64 参数位置d = 整64(成员d.子起点);
                当 (参数位置d < 参数终点d) {
                    节点 参数d = 池.元素(整32(参数位置d));
                    如果 (参数d.类型 == 节点_参数 && 参数d.附加 >= 0 && 参数d.附加 < 池.大小()) {
                        节点 参数类型节点d = 池.元素(整32(参数d.附加));
                        // 595-a（001-001 fix5b·调用侧对齐）：容器实例实参=句柄直传
                        //   （不取地址）——与 登记参数槽 fix5 被调方单槽对齐。撤守卫
                        //   态容器名入结构体大小表 → 原按值登记 → 调用侧回扫取地址
                        //   传槽地址、被调方当句柄 → 崩（113 压入/注册 实锤）。
                        // 810（053）：方法 128 位形参位同款登记
                        字符串 参类型名128d = 字符串复制(驻留文本(整64(参数类型节点d.文本)));
                        如果 (参数类型节点d.附加 == 0 &&
                             (字符串比较(参类型名128d, "整128") ||
                              字符串比较(参类型名128d, "正128"))) {
                            结果<空类型, 整32> 设128d = 函数实参128位们.设置(
                                方法符号IDd * 键位移 + 参数序d, 1);
                            如果 (!设128d.正常) { 运行时错误(4); }
                        }
                        // 087b（#087 余量·宿主 82984e4bbe 同构）：方法数组形参——
                        //   B8 表登记（方法调用侧回扫取地址·与被调 登记参数槽
                        //   数组分支配对——方法体生成走同套 登记参数槽）
                        字符串 参类型名087b = 字符串复制(驻留文本(整64(参数类型节点d.文本)));
                        如果 (参数类型节点d.附加 == 0 &&
                             是数组类型文本(参类型名087b)) {
                            结果<空类型, 整32> 设结087b = 函数实参结构们.设置(
                                方法符号IDd * 键位移 + 参数序d, 1);
                            如果 (!设结087b.正常) { 运行时错误(4); }
                        }
                        // 414（#414·595-a 同族扩展）：用户类实例实参=句柄直传——
                        //   类参数原按「结构体大小表」登记结构位（类大小=字段宽 4）
                        //   →调用方取地址+被调方 prologue 拷 4 字节=**截断 8 字节
                        //   句柄**→被调方解引用半截句柄崩（25/340 重载用例实测）。
                        //   宿主类=指针模型，类参数=指针直传（8 字节）同构。
                        // 106（890 残余·泛型方法实参面·连带根治）：**合成体形参
                        //   （结果/可选·值语义·附加==0）同款登记**——被调方收
                        //   「源地址」（prologue 按形参宽拷入参局部），调用方须
                        //   取地址传；原条件只认 查结构体大小（合成体=0 miss）
                        //   → 契约错配：实参「无」=常量 0 直传、被调方把 0 当
                        //   源地址解引用（E2 段错误 rc=139）/可选变量实参传值
                        //   （F6/D1b 错值 32767/-1 实测；F5 容器面同判据
                        //   〔983 大标量按引用 ABI〕早已对齐=绿）。
                        //   附加==0 守卫：指针形参（附加≥1·如 T* 克隆为
                        //   可选$整32*）是结果类型基名判定亦命中（不剥星）——
                        //   指针形参=值传通道，不得登记结构位。
                        布尔 合成体实参106d = 参数类型节点d.附加 == 0 &&
                                              是结果类型(参类型名087b);
                        如果 (!是容器类(驻留文本(整64(参数类型节点d.文本))) &&
                             !是用户类ID(整64(参数类型节点d.文本)) &&
                             (是结构体大小非零(整64(参数类型节点d.文本)) ||
                              合成体实参106d)) {
                            结果<空类型, 整32> 设结d = 函数实参结构们.设置(
                                方法符号IDd * 键位移 + 参数序d, 1);
                            如果 (!设结d.正常) { 运行时错误(4); }
                        }
                        如果 (参数类型节点d.附加 >= 256) {
                            结果<空类型, 整32> 设引d = 函数实参引用们.设置(
                                方法符号IDd * 键位移 + 参数序d, 1);
                            如果 (!设引d.正常) { 运行时错误(4); }
                        }
                    }
                    如果 (参数d.类型 == 节点_参数) { 参数序d++; }
                    参数位置d++;
                }
            }
            位置d++;
        }
    }
}

// 552（接口方法 × 128 形参双侧同案·v2 侧）：接口方法实参表收集——接口方法
//   无池节点形态（解析接口.cn 零池副作用），调用点 回扫结构体与引用实参
//   表驱动无从命中 → 128 位窄实参按 64 位值直传、被调 prologue 按双槽地址
//   rep movsb 解引用 SIGSEGV（探针 552pe2：引用.取整(42) rc=139）；结构体
//   按值实参传字段值当基址同崩（探针 552st1 rc=139·宿主绿=分叉）。本收集
//   从接口表签名参数串逐段判定登记（三张全局实参表·与 收集单类方法实参表
//   同表同判据口径）：键=驻留(方法符号(接口名, 方法名, 参数串))*键位移+
//   实参序（调用点 发射接口方法调用 同公式复算·单一归属）。
//   判据子集：引用位（段名尾字节 '&'——568 补登记）+ 128 值位（整128/正128
//   精确名）+ 结构体位（数组/合成体宽>8/普通结构体——非容器非用户类）。
//   引用位判据=段文本尾字节 38='&'（432-b 普通函数/容器路径同判据单一归属），
//   与 收集单类方法实参表「参数.附加>=256 → 函数实参引用们」同款镜像；
//   引用段先于 128/结构 判据分流（带 & 段不落入三类值位判据）。
不安全 函数 收集接口方法实参表() -> 空类型 {
    整64 序数552 = 接口方法序数();
    整64 序552 = 0;
    当 (序552 < 序数552) {
        整64 接口ID552 = 接口槽取接口(序552);
        整64 方法ID552 = 接口槽取方法(序552);
        整64 参数串ID552 = 0;
        可选<整64> 参数串查552 = 查接口方法参数串(接口ID552, 方法ID552);
        如果 (参数串查552.有值) { 参数串ID552 = 参数串查552.值; }
        如果 (接口ID552 != 0 && 方法ID552 != 0 && 参数串ID552 != 0) {
            字符串 参数串552 = 字符串复制(驻留文本(参数串ID552));
            整64 符号键552 = 整64(驻留(方法符号(字符串复制(驻留文本(接口ID552)),
                                                  字符串复制(驻留文本(方法ID552)),
                                                  参数串552)));
            整64 段数552 = 参数段个数(参数串552);
            整64 段序552 = 0;
            当 (段序552 < 段数552) {
                整64 段ID552 = 函数指针参数段文本(参数串552, 段序552);
                如果 (段ID552 != 0) {
                    字符串 段名552 = 字符串复制(驻留文本(段ID552));
                    // 568（接口方法 × 非128引用形参双侧同案·v2 侧）：段为引用位
                    //   （尾字节 '&'，如 整64&/整128&）→ 函数实参引用们登记——
                    //   调用点 回扫结构体与引用实参 命中后 回扫实参取地址
                    //   （传左值地址）。原缺 → 引用实参按值直传、被调方按地址
                    //   解引用 SIGSEGV（探针 568 直调/间接双路径 rc=139）。
                    //   判据=段文本尾字节 38='&' 单一归属（432-b 普通函数/容器
                    //   路径同判据；与 收集单类方法实参表「附加>=256 → 引用表」
                    //   镜像）。★本支先于 128/结构 判据分流：引用段不落入值位表。
                    如果 (字符串长度(段名552) > 0 &&
                          ((整64(段名552[整32(字符串长度(段名552) - 1)]) & 255) == 38)) {
                        结果<空类型, 整32> 设引i = 函数实参引用们.设置(
                            符号键552 * 键位移 + 段序552, 1);
                        如果 (!设引i.正常) { 运行时错误(4); }
                    } 否则 如果 (字符串比较(段名552, "整128") ||
                                 字符串比较(段名552, "正128")) {
                        结果<空类型, 整32> 设128i = 函数实参128位们.设置(
                            符号键552 * 键位移 + 段序552, 1);
                        如果 (!设128i.正常) { 运行时错误(4); }
                    } 否则 如果 (是数组类型文本(段名552) ||
                                  (是结构体大小非零(段ID552) &&
                                   !是容器类(段名552) &&
                                   !是用户类_ID(段ID552)) ||
                                  (是结果类型(段名552) && 结果大小(段名552) > 8)) {
                        结果<空类型, 整32> 设结i = 函数实参结构们.设置(
                            符号键552 * 键位移 + 段序552, 1);
                        如果 (!设结i.正常) { 运行时错误(4); }
                    }
                }
                段序552++;
            }
        }
        序552++;
    }
}

// 收集一个 程序 节点区间的全部函数声明的结构体实参位（键 = 链接键*键位移+实参序）
// 呈报③方案A（2026-09-06）：双键登记——签名键（名#参数串 ID）恒登记（重载
//   各键独立），纯名键仅同名唯一时候选登记（既有纯名消费点零回归：解析调用
//   返回结构体/拼接推导按纯名查；重载时纯名 miss 走调用点决议键）。
// plans/018 第 4 层（2026-09-07）：键升级为链接键（键基#参数串，键基=主模块
//   纯名/其余 模块$名）——跨模块同名函数实参结构互不串扰；主模块键基=纯名，
//   双键退化同键（行为不变）。
// ==================== 1186（2026-10-20·1020 采样轮 P0）：调用标量返回类型解析 ====================
// 1186 病理：解析节点类型ID 调用分支原只认容器返回（解析调用返回容器）与结构体
//   返回（解析调用返回结构体·查结构体大小守卫把标量返回丢弃），**标量返回
//   （整32/整8/整64 族）恒 0** → 消费面（生成表达式运算 377 源码推导/474 检查码
//   门/语义期移位量域检查）对「调用左」全 miss：取值()>>33 移位检查门不开 →
//   检查码=0 → 后端 265-a 静默取模掩码输出 2（宿主运行期错误码 8 rc=1）；取满()+1
//   窄域按宽域算 → 赋值位静默回绕 -128；取64()<<70 编译期放行（宿主编译期拒）
//   ——t3/t7/t8 三形态 v2 静默 vs 宿主拒绝分叉实录（对照组 标识符左 v2 正确报错
//   码 8=同函数内两形态不一致铁证）。
//   本函数=377 窄码/474 检查码推导的**局部兜底**（1027 收口：不做全局挂载——
//   全局挂载波及发射宽度面，regex 示例 cmp ebx,r14 尺寸混配 A2022 实录）。
//   残面：被调非标识符非方法（函数指针间接调用等）=0 诚实边界（474 检不出=不检查
//   立法面同口径）。
// 返回：被调签名返回类型名ID；0=解析不出（诚实边界）。
函数 解析调用返回标量ID1186(向量<节点> 池, 整32 调用索引) -> 整64 {
    节点 调用节点1186 = 池.元素(调用索引);
    // 882 单边禁令：比较式归入命名布尔（索引域守卫·927 先例同款手法）
    布尔 调用形态有效1186 = 调用节点1186.类型 == 节点_调用 &&
        调用节点1186.子起点 > 0;
    如果 (调用形态有效1186) {
        节点 被调1186 = 池.元素(整32(调用节点1186.子起点));
        如果 (被调1186.类型 == 节点_标识符) {
            // 查函数返回回退：用户签名表（纯名/键基/限定）+内置返回表两级兜底
            //   （645/366 单点事实源）——容器/结构体返回已被上级两级命中不会到达。
            可选<整64> 回退查1186 = 查函数返回回退(整64(被调1186.文本));
            如果 (!回退查1186.有值) { 返回 0; }
            返回 回退查1186.值;
        }
        布尔 是方法被调1186 = 被调1186.类型 == 节点_成员 &&
            被调1186.附加 == 成员方法标记 && 被调1186.子起点 > 0;
        如果 (是方法被调1186) {
            可选<整64> 对象类型查1186 = 解析节点类型ID(池, 整32(被调1186.子起点));
            如果 (!对象类型查1186.有值) { 返回 0; }
            整64 对象类型ID1186 = 对象类型查1186.值;
            如果 (对象类型ID1186 == 0) { 返回 0; }
            字符串 类名1186 = 字符串复制(驻留文本(对象类型ID1186));
            如果 (是容器类(类名1186)) {
                方法签名 签1186;
                如果 (!查方法签名(类名1186, 驻留文本(整64(被调1186.文本)),
                                整64(调用节点1186.附加), &签1186)) { 返回 0; }
                如果 (字符串长度(签1186.返回文本) == 0) { 返回 0; }
                // 118：引用返回方法剥尾 '&'（带 & 名查位宽/检查码映射恒 miss）
                字符串 返回基名1186 = 字符串复制(签1186.返回文本);
                布尔 是引用返回1186 = 字符串长度(返回基名1186) > 1 &&
                    ((整64(返回基名1186[字符串长度(返回基名1186) - 1]) & 255) == 38);
                如果 (是引用返回1186) {
                    返回基名1186 = 字符串子串(返回基名1186, 0,
                                             字符串长度(返回基名1186) - 1);
                }
                返回 驻留(返回基名1186);
            }
            // 244 同源：用户类方法返回经 查类方法返回（语义分析 方法表单源）
            可选<整64> 类方法查1186 = 查类方法返回(对象类型ID1186, 整64(被调1186.文本));
            如果 (!类方法查1186.有值) { 返回 0; }
            返回 类方法查1186.值;
        }
    }
    // 静默豁免业务值: 被调形态域外（函数指针间接调用/非调用节点分派守卫）无签名可查=0 诚实边界（474 检不出=不检查立法面）
    返回 0;
}

// 1186 收口单点：377 窄码推导的左/右操作数类型码——解析节点类型ID 命中即用，
//   miss 时降级 解析调用返回标量ID1186（仅 377 窄码/474 检查码推导面消费；
//   全局挂载已回滚——全局挂载波及发射宽度面，regex 示例 cmp ebx,r14 尺寸混配
//   A2022 实录：加载点按槽声明宽、比较点按本解析宽=两侧不一致）。
函数 调用类型码兜底1186(向量<节点> 池, 整32 子节点索引) -> 整64 {
    可选<整64> 名查1186 = 解析节点类型ID(池, 子节点索引);
    如果 (名查1186.有值) { 返回 名查1186.值; }
    返回 解析调用返回标量ID1186(池, 子节点索引);
}
