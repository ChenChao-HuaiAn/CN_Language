// CN 自举编译器 v2：结构化 IR 生成器（自举重建 P5，2026-08-25）
// 性能最优架构第三层：AST 节点池（后缀表达式栈）-> 三地址码 IR 指令数组。
// 设计（对标 rustc/LLVM）：
//   - 指令为结构化结构体（操作码/操作数/结果寄存器/类型码/附加），非字符串行。
//   - 寄存器 = 整数 ID（虚拟寄存器，代码生成阶段映射到栈槽）。
//   - 表达式按后缀栈求值：遍历节点池区间，字面量/标识符压栈（生成加载指令），
//     二元/后缀操作符弹栈生成运算指令，结果压栈。
//   - 语句按 子起点/子终点 区间遍历；变量声明分配槽（映射 名ID -> 槽索引）。
// 依赖：P2 词法（Token）/ P3 语法（节点池）/ P4 语义（类型检查）。
// 说明：本组件只生成 IR 指令（不含汇编输出——汇编在 P6 代码生成组件）。

导入 容器::向量;
导入 语法;       // Token/AST 节点池（原 语法分析，阶段目录包名）
导入 IR;         // 容器判定/符号合成 + IR_*/T_* 操作码（原 IR容器+IR常量 合并目录包名）
               //   单一归属 IR常量.cn（原定义在本文件顶层，IR容器 引用不可导=循环）

公开:

// ==================== 结构化 IR 指令 ====================
// 呈报①A 根治（2026-09-05）：IR指令/函数IR 结构体定义下沉至 IR容器.cn
//   （本文件导入它）——原定义在本文件顶层，IR容器.cn 引用它们而 IR生成 导入
//   IR容器 = 反向引用不可导；主链靠多文件合并全局可见，冒烟子链（IR容器/
//   语法分析/语义分析 入口，链上无本文件）结构体登记缺失 -> 方法对象类型解析
//   查结构体大小 miss =「方法调用的对象类型未知: 元素」误诊（曾误归因
//   IR常量.cn 新增常量对——第十四轮消融的「不触发」系检查面不全/陈旧产物假绿）。
//   此处纯名引用（导入 IR容器 后全局可见）。程序IR 定义保留在本文件
//   （引用方：代码生成族/主——导入链恒含本文件）。

// 程序 IR：函数 IR 列表
结构体 程序IR {
    向量<函数IR> 函数们;
    整64 静态数;              // ②c C：静态槽总数（双后端 .data 发射 _cn_gstatic_N）
    向量<整64> 静态初始值们;  // ②c C：各静态初始值文本ID（容器=0；标量=折叠字面量）
}

// ==================== 控制流辅助（P6b） ====================
// 新建块：返回唯一块 ID（标签随建随取——嵌套控制流每个标签独立计数）
函数 新块(函数IR& 函数信息) -> 整64 {
    函数信息.块计数 = 函数信息.块计数 + 1;
    返回 函数信息.块计数;
}

// 发射无条件跳转到目标块
函数 发射跳转(函数IR& 函数信息, 整64 目标块) -> 空类型 {
    IR追加(函数信息.指令, 建IR指令(IR_跳转, 0, 0, 0, 0, 0, 目标块));
}

// 发射条件跳转：条件寄存器 非零 -> 真块；零 -> 假块
函数 发射条件跳转(函数IR& 函数信息, 整64 条件寄存器, 整64 真块, 整64 假块) -> 空类型 {
    IR追加(函数信息.指令, 建IR指令(IR_条件跳转, 条件寄存器, 真块, 假块, 0, 0, 0));
}

// 发射块标签：MASM 需要标号（bbN:）。IR 层只登记块 ID，代码生成按块号输出标签。
函数 发射块标签(函数IR& 函数信息, 整64 块ID) -> 空类型 {
    // 块标签无需 IR 指令——代码生成按 当前块 切换时输出；此辅助仅作文档性登记
    IR追加(函数信息.指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 块ID));
}

// 切换当前块：记录 当前块；代码生成据此输出 bbN: 标签
函数 切换块(函数IR& 函数信息, 整64 块ID) -> 空类型 {
    函数信息.当前块 = 块ID;
}

// ==================== 表达式栈净栈契约（第八十八轮 88-a，单一事实源） ====================
// **契约**：`生成表达式(区间)` 的净栈增量恒为 **+1**（求值结果=栈顶元素；无值形态
//   返回 0 且净 0）。一切消费点据此工作：
//     ①「相对栈顶」消费——生成调用 弹（实参数+被调）/二元弹2/下标弹2/方法接收者弹对象；
//     ②「弹到进入前深度」归位——三元/一元/取地址/结构体构造字段。
// 违反契约（净 > +1）会让 ① 弹到**残留**而非真值：实参位短路 `f(a || b)` 原实现
//   只压不弹（左 +1/右 +1/结果 +1 = 净 +3）→ 弹 3 实参后被调取到左操作数寄存器 →
//   `[ir2] 调用被调对象非函数名/方法`（87-a 探针 v2w 实证；宿主同形态正确）。
// Rust 对照：rustc MIR 每个值有唯一 def-use（无隐式栈残留面）；CN 沿用后缀栈模型，
//   故以「净 +1」为不变量 + 本处两个归位原语为唯一实现点——**禁止裸循环弹栈复制**。
// 性能：纯编译期向量操作，运行时零成本；归位为自愈语义（内层残留一并清理）。
// 归位原语：弹到 深度（丢弃深度以上全部残留；深度 允许大于当前大小=无操作）。
函数 表达式栈弹到深度(向量<整64>& 表达式栈, 整64 深度) -> 空类型 {
    当 (表达式栈.大小() > 深度) {
        结果<空类型, 整32> 删栈归 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈归.正常) { 运行时错误(4); }
    }
}

// 归位压回：弹到 深度 后压回 结果寄存器（「结果留栈」形态出口；净 +1 契约实现）。
函数 表达式栈归位压回(向量<整64>& 表达式栈, 整64 深度, 整64 结果寄存器) -> 空类型 {
    表达式栈弹到深度(表达式栈, 深度);
    结果<空类型, 整32> 加归 = 表达式栈.追加(结果寄存器);
    如果 (!加归.正常) { 运行时错误(4); }
}

// ==================== 成员宽度/链式偏移收口（②b B5，2026-09-02） ====================
// 根治：字段按统一 8 字节读/写——末字段越界清零相邻槽（126 段① i 槽被 子终点
//   8 字节写击穿 -> 当循环死循环 -> 堆 OOM SIGKILL）+ 链式 池.元素(i).字段
//   偏移扁平回退（同名字段跨结构体必错）。宽度/偏移按 结构体名ID*键位移+字段名ID
//   分桶查（IR容器 字段类型表/字段偏移表们）。

// ②b B6：当前函数 retbuf 最大返回字节数（生成表达式 触不到 函数信息——模块级
//   累计；生成函数 入口清零、出口回填 函数信息.retbuf字节数）
静态 整64 当前retbuf字节数 = 0;

// 解析标识符对象的结构体名ID（②c D：函数级变量类型权威表 优先——解析期
//   变量结构体表 跨函数同名异型会串；值=1 是结构体名标记非对象类型）。0=非结构体对象。
函数 解析对象结构体ID(节点 对象节点) -> 整64 {
    如果 (对象节点.类型 != 节点_标识符) { 返回 0; }
    整64 查权威 = 查当前函数变量类型(整64(对象节点.文本));
    如果 (查权威 >= 0) {
        // plans/018 类型分桶：返回值统一键基域（结构体布局键基 幂等解析——
        //   权威表值 纯名/键基通吃；0=非结构体）
        返回 结构体布局键基(查权威);
    }
    返回 查结构体类型(整64(对象节点.文本));
}

// 解析调用对象（池.元素(i).字段 的对象）的返回结构体名ID——经被调方法签名返回
//   文本分桶收口；0=非结构体返回。②c A/B：对象经 解析节点类型ID 统一推导
//   （标识符/成员/调用 递归——函数级权威表优先）。
//   用户函数返回结构体（2026-09-04，E2E 148）：被调为普通标识符（造点(10,20).x
//   链式字段访问）——经 函数返回类型们 查返回类型，结构体即返回其名ID。
// plans/018 第 4 层（2026-09-07）：当前生成文件的模块路径（生成函数 开头设置
//   ——生成表达式深处纯名消费点键基回退用；单文件="主" 行为不变）。
// plans/018 类型分桶（2026-09-08）：统一归入 IR容器.当前模块路径（单一归属，
//   语法解析窗口与 IR 生成窗口共用，防双静态漂移）——本组件读 经 取当前模块路径()。

// 函数返回类型纯名查询（键基回退版——plans/018 第 4 层）：
//   ① 纯名直查（主模块双键形态——行为不变）；
//   ② miss 后键基回退：限定名（B1 改写产物/显式限定）拆 m::x 按 键基合成(m,x)；
//      纯名按 键基合成(取当前模块路径(), 名)（非主模块同文件/自模块调用）。
//   stdlib 限定与内置：miss 返回 0（非结构体/未知——既有兜底行为）。
函数 查函数返回回退(整64 名ID) -> 整64 {
    结果<整64, 整32> 查纯 = 函数返回类型们.获取(名ID);
    如果 (查纯.正常) { 返回 查纯.值; }
    字符串 名文本r = 字符串复制(驻留文本(名ID));
    字符串 模块s = "";
    字符串 符号s = "";
    如果 (拆限定名(名文本r, 模块s, 符号s) == 1) {
        如果 (是标准库模块名(模块s)) { 返回 0; }
        结果<整64, 整32> 查限 = 函数返回类型们.获取(键基合成(模块s, 驻留(符号s)));
        如果 (查限.正常) { 返回 查限.值; }
        返回 0;
    }
    结果<整64, 整32> 查键 = 函数返回类型们.获取(键基合成(取当前模块路径(), 名ID));
    如果 (查键.正常) { 返回 查键.值; }
    返回 0;
}


// ③ 第三波：下标左值元素宽度码（p[i] = v 存储宽度）——指针对象经 指针变量
//   类型们 查所指类型 -> 类型宽度码；非指针对象默认 T_整64（语义层已拒，防御）
函数 取下标元素宽度码(向量<节点> 池, 整32 下标索引) -> 整64 {
    节点 s = 池.元素(下标索引);
    如果 (s.类型 == 节点_下标 && s.子起点 > 0) {
        节点 对象节点下 = 池.元素(整32(s.子起点));
        如果 (对象节点下.类型 == 节点_标识符) {
            结果<整64, 整32> 查所指宽 = 指针变量类型们.获取(整64(对象节点下.文本));
            如果 (查所指宽.正常) {
                返回 类型宽度码(驻留文本(查所指宽.值));
            }
        }
    }
    返回 T_整64;
}

// ==================== 函数级变量类型权威表（②c D，2026-09-02） ====================
// 解析期 变量容器表/变量结构体表 为全局按名键——跨函数同名异型（追加表 的参数 t
// 与 主 的局部 桶 t）串类型。本表由 生成函数 按当前函数填充（参数/容器/结果/
// 结构体局部），标识符类型解析先查此表（函数级真相），解析期表退为静态/兜底。
// 簇①根治·A2（2026-09-04）：表本体下沉 IR常量.cn（IR容器 成员推导双向引用，
//   原定义在本文件=不可导循环）；清空/填充/读取仍全在本组件。

// ③ 第一波（2026-09-03，缺陷①②当场根治后升级）：本函数「寄存器号 -> IR 类型码」
// 登记表——登记点：字面量（整数/字符串）/标识符加载（函数级权威表类型）/拼接 + 产物/
// 内置函数返回。消费点：打印 参数分派（print_str/float/bool/int）、拼接 双侧字符串性
// 判定与 隐式转换（from_int/from_float/from_bool）。生成函数 串行——无交叉，入口清空。
// 边界：无符号（正*）在 v2 类型码体系归并 T_整64（类型系统级现状，非本表层）。
静态 映射<整64, 整64> 寄存器类型们;

// ③ 第三波（2026-09-03）：指针变量类型表——名ID -> 所指元素类型名ID（参数/局部
//   类型节点 附加=指针层数 1..255 登记；语义层同款约定）。消费点：下标读分支
//   （步进=元素宽度/LoadPtr 宽度码/结果类型登记）、下标左值地址与赋值存储宽度。
//   生成函数 串行——入口清空（与 语义分析.指针变量表 平行，IR 层独立消费）。
静态 映射<整64, 整64> 指针变量类型们;

// 登记寄存器类型（重复登记=后写覆盖——同一寄存器号本函数内不复用）
函数 登记寄存器类型(整64 寄存器, 整64 码) -> 空类型 {
    结果<空类型, 整32> 设型 = 寄存器类型们.设置(寄存器, 码);
    如果 (!设型.正常) { 运行时错误(4); }
}

// 查询寄存器类型码；0=未登记（未知——按整数兜底处理）
函数 查寄存器类型(整64 寄存器) -> 整64 {
    结果<整64, 整32> 查型 = 寄存器类型们.获取(寄存器);
    如果 (查型.正常) { 返回 查型.值; }
    返回 0;
}


// 调用节点的被调方法返回容器类型（②c A：元素(i) 返回映射 等）；0=非容器返回。
//   递归经 解析方法对象类型 解析该调用自身的方法对象。
函数 解析调用返回容器(向量<节点> 池, 整32 调用索引) -> 整64 {
    节点 调用节点 = 池.元素(调用索引);
    如果 (调用节点.类型 != 节点_调用 || 调用节点.子起点 <= 0) { 返回 0; }
    节点 被调成员 = 池.元素(整32(调用节点.子起点));
    如果 (被调成员.类型 != 节点_成员 || 被调成员.附加 != 成员方法标记) { 返回 0; }
    整64 对象类ID = 解析方法对象类型(池, 调用索引);
    如果 (对象类ID == 0) { 返回 0; }
    字符串 类名 = 字符串复制(驻留文本(对象类ID));
    如果 (!是容器类(类名)) { 返回 0; }
    方法签名 签;
    如果 (!查方法签名(类名, 驻留文本(整64(被调成员.文本)), 调用节点.附加, &签)) { 返回 0; }
    如果 (字符串长度(签.返回文本) == 0) { 返回 0; }
    如果 (!是容器类(签.返回文本)) { 返回 0; }
    返回 驻留(签.返回文本);
}

// ==================== 函数实参结构表与实参回扫（②b B3/B8，2026-09-02） ====================
// 普通函数调用的结构体按值实参 -> 传地址（B3 仅覆盖容器方法调用；v2 自身源码
//   IR追加(指令, 建IR指令(...)) 全是此形态，③ 自举必需）。表：函数名ID*键位移+
//   实参序 -> 1（该实参为结构体）。IR生成/IR生成多文件 入口收集（先于全部生成）。
静态 映射<整64, 整64> 函数实参结构们;

// 收集一个 程序 节点区间的全部函数声明的结构体实参位（键 = 链接键*键位移+实参序）
// 呈报③方案A（2026-09-06）：双键登记——签名键（名#参数串 ID）恒登记（重载
//   各键独立），纯名键仅同名唯一时候选登记（既有纯名消费点零回归：解析调用
//   返回结构体/拼接推导按纯名查；重载时纯名 miss 走调用点决议键）。
// plans/018 第 4 层（2026-09-07）：键升级为链接键（键基#参数串，键基=主模块
//   纯名/其余 模块$名）——跨模块同名函数实参结构互不串扰；主模块键基=纯名，
//   双键退化同键（行为不变）。
函数 收集函数实参结构(向量<节点> 池, 整32 程序节点, 字符串 模块路径) -> 空类型 {
    节点 程序 = 池.元素(程序节点);
    整64 位置 = 整64(程序.子起点);
    当 (位置 < 整64(程序.子终点)) {
        节点 声明 = 池.元素(整32(位置));
        如果 (声明.类型 == 节点_函数) {
            // 参数区间 = [函数.子起点, 块.子起点)（块 在 函数.子终点=块索引）
            整64 参数终点 = 整64(声明.子起点);
            如果 (声明.子终点 < 池.大小()) {
                节点 块节点 = 池.元素(声明.子终点);
                参数终点 = 整64(块节点.子起点);
            }
            // 呈报③方案A：双键基——签名键恒有；纯名键同名唯一时才有（主模块）
            整64 键基p = 键基合成(模块路径, 整64(声明.文本));
            整64 签名键 = 函数签名键(键基p, 函数参数串(池, 整32(位置)));
            整64 纯名键 = 0;
            如果 (是主模块路径(模块路径)) {
                整64 查唯数 = 查函数签名个数(键基p);
                如果 (查唯数 >= 0) {
                    如果 (查唯数 == 1) { 纯名键 = 整64(声明.文本); }
                }
            }
            整64 参数序 = 0;
            整64 参数位置 = 整64(声明.子起点);
            当 (参数位置 < 参数终点) {
                节点 参数 = 池.元素(整32(参数位置));
                如果 (参数.类型 == 节点_参数) {
                    // 守卫用 >= 0（lessons 池索引 0 合法——生成函数 同款）：首函数
                    //   首参数的类型节点恰在池索引 0 时，原 > 0 漏登记——mapref 探针
                    //   实锤（灌 的 映射& 表 引用实参位漏收集→调用方不取址→被调方
                    //   双重解引用读垃圾→映射对象状态坏崩溃）
                    如果 (参数.附加 >= 0 && 参数.附加 < 池.大小()) {
                        节点 参数类型节点 = 池.元素(整32(参数.附加));
                        如果 (查结构体大小(整64(参数类型节点.文本)) != 0) {
                            结果<空类型, 整32> 设结 = 函数实参结构们.设置(
                                签名键 * 键位移 + 参数序, 1);
                            如果 (!设结.正常) { 运行时错误(4); }
                            如果 (纯名键 != 0) {
                                结果<空类型, 整32> 设结n = 函数实参结构们.设置(
                                    纯名键 * 键位移 + 参数序, 1);
                                如果 (!设结n.正常) { 运行时错误(4); }
                            }
                        }
                        // ②c D：引用形参（类型节点 附加=引用*256）——调用方传左值地址
                        如果 (参数类型节点.附加 >= 256) {
                            结果<空类型, 整32> 设引 = 函数实参引用们.设置(
                                签名键 * 键位移 + 参数序, 1);
                            如果 (!设引.正常) { 运行时错误(4); }
                            如果 (纯名键 != 0) {
                                结果<空类型, 整32> 设引n = 函数实参引用们.设置(
                                    纯名键 * 键位移 + 参数序, 1);
                                如果 (!设引n.正常) { 运行时错误(4); }
                            }
                        }
                    }
                    参数序++;
                }
                参数位置++;
            }
        }
        位置++;
    }
}

// ==================== 用户函数返回类型表（③ 第二波，方案A 登记点补全 2026-09-03） ====================
// ③ 第一波登记点枚举漏「用户函数调用返回」——打印错分派 print_int（打指针值）、
//   拼接漏判/误转 from_int（指针转数字串）静默错误代码（asm 探针实锤；v2 组件
//   代码生成共用.cn:30/104 字节十六进制=符号修饰核心实际在用）。表：函数名ID ->
//   返回类型名ID（节点_函数.附加）。IR生成/IR生成多文件 入口收集（先于全部生成）。
静态 映射<整64, 整64> 函数返回类型们;

// 收集一个 程序 节点区间的全部函数声明的返回类型
// plans/018 第 4 层：签名键=链接键（键基#参数串）；纯名键仅主模块（键基=纯名）
函数 收集函数返回类型(向量<节点> 池, 整32 程序节点, 字符串 模块路径) -> 空类型 {
    节点 程序 = 池.元素(程序节点);
    整64 位置 = 整64(程序.子起点);
    当 (位置 < 整64(程序.子终点)) {
        节点 声明 = 池.元素(整32(位置));
        如果 (声明.类型 == 节点_函数) {
            // 呈报③方案A：双键——签名键恒登记（重载各键独立），纯名键仅
            //   同名唯一时（既有纯名消费点零回归：解析调用返回结构体/拼接推导）
            整64 键基r = 键基合成(模块路径, 整64(声明.文本));
            整64 签名键 = 函数签名键(键基r, 函数参数串(池, 整32(位置)));
            结果<空类型, 整32> 设返 = 函数返回类型们.设置(签名键,
                                                         整64(声明.附加));
            如果 (!设返.正常) { 运行时错误(4); }
            如果 (是主模块路径(模块路径)) {
                整64 查唯返 = 查函数签名个数(键基r);
                如果 (查唯返 >= 0) {
                    如果 (查唯返 == 1) {
                        结果<空类型, 整32> 设返n = 函数返回类型们.设置(整64(声明.文本),
                                                                     整64(声明.附加));
                        如果 (!设返n.正常) { 运行时错误(4); }
                    }
                }
            }
        }
        位置++;
    }
}

// 回扫实参取地址（②b B3/B8 共用）：裸标识符实参的 IR_加载 回扫取源槽改发
//   IR_取地址（宿主 ABI：调用方传指针）；找不到（表达式实参）打印诊断（P7c）
不安全 函数 回扫实参取地址(向量<IR指令>& 指令, 向量<整64>& 弹出们, 整64 实i,
                    整64* 寄存器计数) -> 空类型 {
    整64 实reg = 弹出们.元素(弹出们.大小() - 1 - 实i);
    // 86-a（2026-09-12 复审缺陷①）：聚合地址化三元实参（登记 T_对象）——
    //   寄存器值**即选中 place 地址**（非值装载），回扫不得改写（改写会把
    //   「三元临时槽地址」当结构体基址传给被调方——P47-v2/t5_3 实证乱码）。
    如果 (查寄存器类型(实reg) == T_对象) { 返回; }
    整64 源槽 = 0;
    整64 回 = 指令.大小();
    当 (回 > 0) {
        IR指令 回扫 = 指令.元素(回 - 1);
        如果 (回扫.操作码 == IR_加载 && 回扫.目标 == 实reg) {
            源槽 = 回扫.操作数1;
            中断;
        }
        回--;
    }
    如果 (源槽 != 0) {
        整64 地址reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        // 引用局部（2026-09-04 IR生成.cn 冒烟根治）：实参=槽内容（绑定对象
        //   左值地址）——与标识符取槽地址的值语义形态分流
        如果 (槽是引用(源槽)) {
            IR追加(指令, 建IR指令(IR_加载, 源槽, 0, 0, 地址reg, T_整64, 0));
        } 否则 {
            IR追加(指令, 建IR指令(IR_取地址, 源槽, 0, 0, 地址reg, T_整64, 0));
        }
        结果<空类型, 整32> 改实 = 弹出们.设置(弹出们.大小() - 1 - 实i, 地址reg);
        如果 (!改实.正常) { 运行时错误(4); }
        返回;
    }
    // 指针加载形态（引用局部读/成员字段加载，2026-09-04）：发射引用参数读
    //   （IR_加载 槽→L + IR_指针加载 L→对象指针）与容器字段取载
    //   （IR_字段地址 + IR_指针加载）的目标实参，其 IR_指针加载.操作数1
    //   寄存器即「绑定对象/字段的左值地址」——直接复用（零新指令）。
    //   被 127 既有标识符形态不经过此路径（IR_加载.目标==实reg 先命中）。
    整64 回2 = 指令.大小();
    当 (回2 > 0) {
        IR指令 回扫2 = 指令.元素(回2 - 1);
        如果 (回扫2.操作码 == IR_指针加载 && 回扫2.目标 == 实reg) {
            结果<空类型, 整32> 改实2 = 弹出们.设置(弹出们.大小() - 1 - 实i, 回扫2.操作数1);
            如果 (!改实2.正常) { 运行时错误(4); }
            返回;
        }
        回2--;
    }
    // 字段地址形态（2026-09-06 结果载荷结构体根治）：实 reg 来源=IR_字段地址
    //   （查.值 结构体载荷——实参=字段地址本身），直接复用（实reg 已是左值地址）
    整64 回2f = 指令.大小();
    当 (回2f > 0) {
        IR指令 回扫2f = 指令.元素(回2f - 1);
        如果 (回扫2f.操作码 == IR_字段地址 && 回扫2f.目标 == 实reg) {
            返回;
        }
        回2f--;
    }
    // 调用返回形态（2026-09-04，E2E 148）：实 reg 来源=IR_调用参数化——返回
    //   结构体时 rax=retbuf 地址即结构体地址，按值实参恰好要传地址——实参
    //   数值本已正确，直接复用（原「结构体实参须为标识符」诊断对此形态为
    //   误报：v2 自身 IR追加(指令, 建IR指令(...)) 655 条实证）。
    整64 回3 = 指令.大小();
    当 (回3 > 0) {
        IR指令 回扫3 = 指令.元素(回3 - 1);
        如果 (回扫3.操作码 == IR_调用参数化 && 回扫3.目标 == 实reg) {
            返回;   // 实参保持 实reg（结构体地址）
        }
        回3--;
    }
    // 取地址形态（2026-09-04，E2E 148 收尾）：实 reg 来源=IR_取地址（&标识符
    //   实参传引用位——查方法签名(..., &签) 26 处实证）——取地址值即左值地址，
    //   引用位恰好要传左值地址，实参数值本已正确，直接复用（误报根治）。
    整64 回4 = 指令.大小();
    当 (回4 > 0) {
        IR指令 回扫4 = 指令.元素(回4 - 1);
        如果 (回扫4.操作码 == IR_取地址 && 回扫4.目标 == 实reg) {
            返回;
        }
        回4--;
    }
    // 静态容器形态（plans/018 根治，2026-09-07）：实 reg 来源=IR_静态加载（顶层
    //   静态容器读句柄）——引用形参须传「句柄槽地址」而非句柄值：回扫改发
    //   IR_静态地址（.data 槽 lea，附加=同一静态序号）。与宿主 ir_expr.cpp
    //   AddressOf 静态分支根治完全同构（宿主侧先实证：句柄值被被调方再解引用
    //   ——空容器句柄 0=错误码3、非空=读写容器对象头错位）。语义依据：C++
    //   T& x = 静态变量 绑定存储位置本身；Rust &mut static 恒指向槽。
    整64 回5 = 指令.大小();
    当 (回5 > 0) {
        IR指令 回扫5 = 指令.元素(回5 - 1);
        如果 (回扫5.操作码 == IR_静态加载 && 回扫5.目标 == 实reg) {
            整64 地址reg5 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 地址reg5, T_整64,
                                 回扫5.附加));
            结果<空类型, 整32> 改实5 = 弹出们.设置(弹出们.大小() - 1 - 实i, 地址reg5);
            如果 (!改实5.正常) { 运行时错误(4); }
            返回;
        }
        回5--;
    }
    IR层诊断("结构体实参须为标识符（表达式实参见P7c）");
}

// ==================== 引用参数（②c D，2026-09-02） ====================
// byRef 槽语义（对齐宿主 A-1）：参数槽存调用方左值地址——读取解引用/赋值写回；
//   容器& 双层解引用得对象指针（this 直用）；结构体& 槽内容即结构体基址
//   （成员访问直接复用，跳过 prologue 多槽拷贝）。调用方经 函数实参引用们
//   表驱动回扫取址（B8 同款机制扩展）。
静态 映射<整64, 整64> 函数实参引用们;    // 函数名ID*键位移+实参序 -> 1（该实参为 & 引用）
静态 映射<整64, 整64> 引用参数槽们;      // 槽号 -> 1（本函数该参数为 & 引用形参）
静态 映射<整64, 整64> 引用参数类型们;    // 槽号 -> 类型名ID（读取分流：容器/结构体/标量）
// 第17枚根治（2026-09-06，v2self 实参们槽高字节污染）：指针参数槽——方法签名* 出
//   等结构体指针形参（类型节点附加=指针层 1..255）。成员访问 p.字段 基址=装载槽值
//   （指针解引用，v2.1 用户裁决 p.字段 ≡ (*p).字段）——旧实现误走 IR_取地址（取
//   指针槽自身地址）少一层解引用 + 字段偏移 -1 未校验，写穿相邻槽（实测 偏移 -1
//   落在 实参们 句柄槽最高字节 -> 句柄 0xd00000000177eca0 -> 向量$大小 解引用崩）。
静态 映射<整64, 整64> 指针参数槽们;      // 槽号 -> 1（本函数该参数为结构体指针形参）

// 槽是否为引用参数
函数 槽是引用(整64 槽) -> 布尔 {
    结果<整64, 整32> 查 = 引用参数槽们.获取(槽);
    返回 查.正常;
}

// 槽是否为指针参数
函数 槽是指针参数(整64 槽) -> 布尔 {
    结果<整64, 整32> 查p = 指针参数槽们.获取(槽);
    返回 查p.正常;
}

// 92-a（2026-09-13 第九十二轮）：自增/自减增量常量发射（目标类型分派）——
//   浮点目标造浮点常量 1.0（v2 浮点常量面 89-a 为浮64 单面：浮32 目标再经
//   IR_类型转换 f64->f32 降精度，复用 91-a 四向转换设施）；整型目标造
//   IR_常量整数 1（原行为）。返回常量所在寄存器号。
不安全 函数 发射自增增量(向量<IR指令>& 指令, 整64 目标类型码,
                   整64* 寄存器计数) -> 整64 {
    如果 (目标类型码 == T_浮32) {
        整64 浮64寄存器 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_常量浮点, 整64(驻留("1.0")), 0, 0,
                             浮64寄存器, T_浮64, 0));
        整64 降精度寄存器 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_类型转换, 浮64寄存器, T_浮64, 0,
                             降精度寄存器, T_浮32, 0));
        返回 降精度寄存器;
    }
    整64 常量寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    如果 (目标类型码 == T_浮64) {
        IR追加(指令, 建IR指令(IR_常量浮点, 整64(驻留("1.0")), 0, 0,
                             常量寄存器, T_浮64, 0));
    } 否则 {
        IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("1")), 0, 0,
                             常量寄存器, T_整64, 0));
    }
    返回 常量寄存器;
}

// 簇③根治·自减全链 C1（2026-09-04 用户裁决）：自增/自减共用发射函数——目标解析链
//   （局部槽→参数槽→静态序号）+ 引用参数经指针读写回（②c D）+ 静态读写对
//   （③ 第六波），运算码按 是自减 分派 IR_加/IR_减。原 节点_自增 分支体平移
//   抽出（行为零变化），节点_自减 对称接入
// 92-a（2026-09-13 第九十二轮）：目标类型码分派——原恒 T_整64 使浮点自增对
//   IEEE754 位模式做整数加 1（只改尾数最低位，`甲++` 对浮点静默失效；宿主
//   同族缺陷 92-a 同轮根治）。浮点目标：增量常量 1.0 + 浮点运算类型码；
//   槽位模式搬运保持 8 字节（v2 标量槽=1 槽 8 字节，浮32 低位即单精度位模式）。
不安全 函数 发射自增自减(向量<IR指令>& 指令, 整64 名ID, 布尔 是自减,
                   映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                   整64* 寄存器计数) -> 空类型 {
    整64 运算码 = IR_加;
    如果 (是自减) { 运算码 = IR_减; }
    整64 目标类型码 = T_整64;
    整64 自增类型名ID = 查当前函数变量类型(名ID);
    如果 (自增类型名ID >= 0) {
        整64 自增码 = 类型码(自增类型名ID);
        如果 (自增码 == T_浮32 || 自增码 == T_浮64) { 目标类型码 = 自增码; }
    }
    整64 目标槽 = 0;
    结果<整64, 整32> 找槽 = 局部槽.获取(名ID);
    如果 (找槽.正常) { 目标槽 = 找槽.值; }
    如果 (目标槽 == 0) {
        结果<整64, 整32> 找参 = 参数槽.获取(名ID);
        如果 (找参.正常) { 目标槽 = 找参.值; }
    }
    如果 (目标槽 == 0) {
        // 静态槽自增/自减：IR_静态加载/静态存储 读写对（②c C 设施）
        整64 找静 = 查静态序号(名ID);
        如果 (找静 >= 0) {
            整64 静值reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_静态加载, 0, 0, 0, 静值reg, 目标类型码, 找静));
            整64 静常量1 = 发射自增增量(指令, 目标类型码, 寄存器计数);
            整64 静结果 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(运算码, 静值reg, 静常量1, 0, 静结果, 目标类型码, 0));
            IR追加(指令, 建IR指令(IR_静态存储, 静结果, 0, 0, 0, 目标类型码, 找静));
        }
    }
    如果 (目标槽 != 0) {
        整64 寄存器1 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        如果 (槽是引用(目标槽)) {
            // 引用参数：经指针读写回调用方槽
            整64 地址reg2 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 地址reg2, T_整64, 0));
            IR追加(指令, 建IR指令(IR_指针加载, 地址reg2, 0, 0, 寄存器1, 目标类型码, 0));
            整64 常量1r = 发射自增增量(指令, 目标类型码, 寄存器计数);
            整64 结果寄存器r = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(运算码, 寄存器1, 常量1r, 0, 结果寄存器r, 目标类型码, 0));
            IR追加(指令, 建IR指令(IR_指针存储, 地址reg2, 结果寄存器r, 0, 0, 目标类型码, 0));
        } 否则 {
            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 寄存器1, T_整64, 0));
            整64 常量1 = 发射自增增量(指令, 目标类型码, 寄存器计数);
            整64 结果寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(运算码, 寄存器1, 常量1, 0, 结果寄存器, 目标类型码, 0));
            IR追加(指令, 建IR指令(IR_存储, 结果寄存器, 0, 0, 0, 0, 目标槽));
        }
    }
}

// 引用参数标识符读取发射（压值）：
//   容器&：Load 槽（=&调用方槽）-> 指针加载（=对象指针，方法接收者 this 直用）；
//   结构体&：Load 槽（=调用方结构体基址——成员基址直接复用，不再解引用）；
//   标量&：Load 槽 -> 指针加载（=值）。
不安全 函数 发射引用参数读(整64 槽, 向量<IR指令>& 指令, 整64* 寄存器计数,
                     向量<整64>& 表达式栈) -> 空类型 {
    整64 类型ID = 0;
    结果<整64, 整32> 查类型 = 引用参数类型们.获取(槽);
    如果 (查类型.正常) { 类型ID = 查类型.值; }
    整64 地址寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 槽, 0, 0, 地址寄存器, T_整64, 0));
    字符串 类型文本 = 字符串复制(驻留文本(类型ID));
    如果 (是容器类(类型文本)) {
        整64 对象寄存器 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_指针加载, 地址寄存器, 0, 0, 对象寄存器, T_对象, 0));
        结果<空类型, 整32> 加容 = 表达式栈.追加(对象寄存器);
        如果 (!加容.正常) { 运行时错误(4); }
        返回;
    }
    如果 (查结构体大小(类型ID) != 0) {
        结果<空类型, 整32> 加结 = 表达式栈.追加(地址寄存器);
        如果 (!加结.正常) { 运行时错误(4); }
        返回;
    }
    整64 值寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 地址寄存器, 0, 0, 值寄存器, T_整64, 0));
    结果<空类型, 整32> 加标 = 表达式栈.追加(值寄存器);
    如果 (!加标.正常) { 运行时错误(4); }
}

// 清空引用参数模块表（IR生成/IR生成多文件 入口——任务级生命周期）
函数 清空引用参数表() -> 空类型 {
    函数实参引用们.清空();
    引用参数槽们.清空();
    引用参数类型们.清空();
    指针参数槽们.清空();
}


// ==================== 跨子模块访问函数（千行拆分，2026-09-08） ====================
//   生成表达式/生成语句/生成函数 子模块经下列 公开: 函数访问函数级权威表
//   （静态表=文件级私有，跨文件仅函数可见——表与访问函数同文件单一归属；
//   查询未命中统一返回 -1 哨兵：类型ID/宽度值域恒正无冲突）
函数 累计retbuf字节数(整64 字节数) -> 空类型 {
    如果 (字节数 > 当前retbuf字节数) { 当前retbuf字节数 = 字节数; }
}

函数 取retbuf字节数() -> 整64 {
    返回 当前retbuf字节数;
}

函数 复位retbuf字节数() -> 空类型 {
    当前retbuf字节数 = 0;
}

// 71-a（2026-09-11 方案A 用户裁决）：本函数已装箱（正常/某些(标识符)）名ID 集
//   合——装箱=所有权经结果/可选转交（Rust Ok(s) move 语义），出口释放（发射
//   字符串释放/发射容器析构/块出口析构）对已装箱名跳过=防「装箱浅共享×出口
//   释放=悬垂」（宿主 ir_error_ctor 源槽清零同效，v2 侧跳过模型更优：双装箱
//   退化为借用共享而非源清零 NULL）。名单外/污染名登记无副作用（出口本就
//   不释放）。函数级生命周期（生成函数 开头随 清空函数级槽表 重置）。
静态 向量<整64> 已装箱名们;

// 75-a（2026-09-12 第七十五轮，方案甲 用户裁决）：**当前函数串污染名单镜像**。
//   动机：入容器位所有权归一化（归一化入容器实参，位于生成表达式求值 深层）
//   拿不到 函数信息，而「转移(拥有局部) 入容器=真 move」判定需要「源是否拥有」
//   ——污染名单是唯一缺口信息（局部槽/参数槽 已随调用链可得）。
//   与权威 函数信息.字符串污染们 **同生同灭**：唯一写入入口 登记串污染
//   （内部同时写权威与镜像），函数级重置随 清空函数级槽表（生成函数 开头）。
//   ⚠ 维护契约：新增污染登记点一律经 登记串污染，**禁止直写 函数信息.字符串污染们**
//   （直写会让镜像漏项 → 归一化误判「拥有」→ 容器接管借用句柄 → 容器析构释放
//   他人串=UAF；镜像漏项方向不保守，故此处以注释为强制约束）。
静态 向量<整64> 当前串污染们;

// 登记串污染（唯一写入入口）：写权威 函数信息.字符串污染们 + 追加镜像（去重）
函数 登记串污染(函数IR& 函数信息, 整64 名ID) -> 空类型 {
    结果<空类型, 整32> 设污 = 函数信息.字符串污染们.设置(名ID, 1);
    如果 (!设污.正常) { 运行时错误(4); }
    登记串污染镜像(名ID);
}

// 79-a：镜像登记（无 函数IR 上下文路径——如 生成方法调用 作用域无函数信息，
//   污染仅经镜像；释放侧 发射资源字段析构 同读镜像=自洽）。语义=「该名退出
//   拥有权（RAII 释放跳过）」——字符串借用视图 与 入容器结构体共享源 共用。
函数 登记串污染镜像(整64 名ID) -> 空类型 {
    如果 (!是当前串污染(名ID)) {
        结果<空类型, 整32> 加污 = 当前串污染们.追加(名ID);
        如果 (!加污.正常) { 运行时错误(4); }
    }
}

// 查询镜像（归一化真 move 判据之一；名ID 命中=借用视图/非拥有初始化）
函数 是当前串污染(整64 名ID) -> 布尔 {
    整64 i = 0;
    当 (i < 当前串污染们.大小()) {
        如果 (当前串污染们.元素(i) == 名ID) { 返回 真; }
        i++;
    }
    返回 假;
}

函数 清空函数级槽表() -> 空类型 {
    // ②c D/③第三波：函数级生命周期（生成函数 开头重置，串行无交叉）
    引用参数槽们.清空();
    引用参数类型们.清空();
    指针参数槽们.清空();
    寄存器类型们.清空();
    指针变量类型们.清空();
    已装箱名们.清空();
    当前串污染们.清空();
    结构体返回临时们.清空();   // 81-a-v2：返回物化登记（防跨函数寄存器号误命中）
}

函数 登记已装箱名(整64 名ID) -> 空类型 {
    结果<空类型, 整32> 加 = 已装箱名们.追加(名ID);
    如果 (!加.正常) { 运行时错误(4); }
}

函数 是已装箱名(整64 名ID) -> 布尔 {
    整64 i = 0;
    当 (i < 已装箱名们.大小()) {
        如果 (已装箱名们.元素(i) == 名ID) { 返回 真; }
        i++;
    }
    返回 假;
}

函数 登记指针变量类型(整64 键, 整64 码) -> 空类型 {
    结果<空类型, 整32> 设 = 指针变量类型们.设置(键, 码);
    如果 (!设.正常) { 运行时错误(4); }
}

函数 查指针变量类型(整64 键) -> 整64 {
    结果<整64, 整32> 查 = 指针变量类型们.获取(键);
    如果 (查.正常) { 返回 查.值; }
    返回 0 - 1;
}

函数 查函数实参结构(整64 键) -> 整64 {
    结果<整64, 整32> 查 = 函数实参结构们.获取(键);
    如果 (查.正常) { 返回 查.值; }
    返回 0 - 1;
}

函数 是函数实参引用(整64 键) -> 布尔 {
    结果<整64, 整32> 查 = 函数实参引用们.获取(键);
    返回 查.正常;
}

函数 查函数返回类型(整64 键) -> 整64 {
    结果<整64, 整32> 查 = 函数返回类型们.获取(键);
    如果 (查.正常) { 返回 查.值; }
    返回 0 - 1;
}

函数 清空实参与返回类型表() -> 空类型 {
    // ②b B8/③第二波：任务级生命周期（IR生成/IR生成多文件 入口清空）
    函数实参结构们.清空();
    函数返回类型们.清空();
}

函数 登记引用参数槽(整64 槽) -> 空类型 {
    结果<空类型, 整32> 设 = 引用参数槽们.设置(槽, 1);
    如果 (!设.正常) { 运行时错误(4); }
}

函数 登记引用参数类型(整64 槽, 整64 类型ID) -> 空类型 {
    结果<空类型, 整32> 设 = 引用参数类型们.设置(槽, 类型ID);
    如果 (!设.正常) { 运行时错误(4); }
}

函数 登记指针参数槽(整64 槽) -> 空类型 {
    结果<空类型, 整32> 设 = 指针参数槽们.设置(槽, 1);
    如果 (!设.正常) { 运行时错误(4); }
}
