// CN 自举编译器 v2 · lambda 类字段捕获快照固化（#1178·2026-10-31·单一职责）
// 职责：固化lambda快照432（生成蹦床.cn）的**类字段捕获源通道**（函数提炼=1093
//   行冻结线拆出·调用点=固化lambda快照432 源槽 miss 分支）。001 §lambda 捕获
//   条〔通告〕：[=]/[&]/[字段名] 显式声明捕获类字段=合法面，但字段名不在局部/
//   参数槽（语义层符号表注册·IR 槽无登记）→原源槽 miss 跳过=静态快照槽不注册
//   +蹦床还原实参缺位（真身 rdi 残留垃圾·1674-D3 实测 857783025）。
// 实现=定义点固化对齐静态槽架构（宿主 emitLambdaSnapshotStores 同构）：
//   ①字段地址=发射类字段地址（当前方法上下文·this 槽+字段偏移）；
//   ②[&]=字段地址直存（体内解引用读最新/写穿）；
//   ③结构体/128 字段=字段地址→静态槽整块拷+串字段深拷（【#940】同款·源址=
//     字段地址=对象本体位置·别名透明免加载/取地址二分）；
//   ④标量/字符串/指针=字段值加载→静态存储（捕码定宽·spec 04-一D 捕获时复制）。
// 挂账：容器/用户类字段值捕获=拷贝构造深拷面（源=句柄两跳与字段址语义不同构
//   ·本件不接=返回 假 走原 miss 面）。非方法上下文=字段偏移 miss=假（顶层
//   lambda 无字段可捕获·闭集穷举）。
导入 容器::向量;
导入 映射集合;
导入 IR;         // IR指令/建IR指令/IR追加/操作码与类型码常量（目录包名）
导入 协议常量;   // 节点_*/常量（目录包名·335 重构B 独立包）
导入 IR生成;     // 静态名们/静态类型们/静态序号们/静态初值起终表/查静态序号（同包）

公开:

// 返回 真=字段通道已固化（调用方 快照序号++ 继续）；假=非字段/挂账面（调用方
//   走原 miss 面·蹦床还原位号恒占）。
不安全 函数 固化lambda字段快照(整64 lambda名ID, 整64 捕获名, 整64 捕获形态,
                        整64 捕获类型, 向量<IR指令>& 指令, 整64* 寄存器计数) -> 布尔 {
    可选<整64> 查字段偏移 = 当前方法字段偏移(捕获名);
    如果 (查字段偏移.有值) {
        // 真分支内消费（取反+继续=守卫识别盲区·存量同场景=真分支包裹式）
        整64 字段偏移 = 查字段偏移.值;
        // 捕附加/捕码/快照大小（与局部源段同判——指针层恢复 T_整64）
        结果<整64, 整32> 查指针附加 = 查lambda捕获参数附加(lambda名ID, 捕获名);
        整64 指针附加 = 0;
        如果 (查指针附加.正常) { 指针附加 = 查指针附加.值; } 否则 { }
        整64 快照捕码 = 类型码(捕获类型);
        如果 (捕获形态 != 3 && 指针附加 >= 1 && 指针附加 < 256) {
            快照捕码 = T_整64;
        }
        整64 字段块字节 = 0;
        // 【#1880】数组字段旗标：数组字段=类型大小与对齐 全尺寸（快照槽全尺寸
        //   固化）——1408 同族借道面：原无数组分支落标量路=只快照首 8 字节。
        布尔 字段是数组面 = (捕获形态 != 3 && 指针附加 == 0 &&
                        是数组类型文本(驻留文本(捕获类型)));
        如果 (捕获形态 != 3 && 指针附加 == 0 && !字段是数组面 &&
             !是容器类(驻留文本(捕获类型)) &&
             !是用户类_ID(捕获类型)) {
            可选<整64> 查字段块字节 = 查结构体大小(捕获类型);
            如果 (查字段块字节.有值) { 字段块字节 = 查字段块字节.值; }
            // 128 位标量=16 字节双槽（#418 布局同序）——布尔化避分支头
            //   单边比较词面（==0=闭区间式合规写法）
            布尔 字段是128面 = (字符串比较(驻留文本(捕获类型), "整128") ||
                          字符串比较(驻留文本(捕获类型), "正128"));
            如果 (字段块字节 == 0 && 字段是128面) {
                字段块字节 = 16;
            }
        }
        如果 (字段是数组面) {
            整64 数组总字节 = 0;
            整64 数组对齐宽 = 0;
            类型大小与对齐(驻留文本(捕获类型), &数组总字节, &数组对齐宽);
            字段块字节 = 数组总字节;
        }
        // 容器/用户类字段值捕获=拷贝构造深拷挂账面（miss 保持·见文件头注）
        如果 (捕获形态 != 3 && 字段块字节 == 0 && 指针附加 == 0 &&
             (是容器类(驻留文本(捕获类型)) || 是用户类_ID(捕获类型))) {
            返回 假;
        }
        // 静态快照槽注册（cap$?lambdaN$捕名·与局部源段同表同规·平行表
        //   初值区间 -1/-1=运行期固化）
        字符串 静态槽名文本 = "cap$" + 驻留文本(lambda名ID) + "$" + 驻留文本(捕获名);
        整64 静态槽名 = 驻留(静态槽名文本);
        结果<整64, 整32> 查静态已有 = 静态序号们.获取(静态槽名);
        如果 (!查静态已有.正常) {
            整64 静态新序 = 静态名们.大小();
            结果<空类型, 整32> 追加静态名 = 静态名们.追加(静态槽名);
            如果 (!追加静态名.正常) { 运行时错误(4); }
            结果<空类型, 整32> 追加静态类型 = 静态类型们.追加(捕获类型);
            如果 (!追加静态类型.正常) { 运行时错误(4); }
            结果<空类型, 整32> 设置静态序 = 静态序号们.设置(静态槽名, 静态新序);
            如果 (!设置静态序.正常) { 运行时错误(4); }
            结果<空类型, 整32> 追加初值起 = 静态初值起点们.追加(0 - 1);
            如果 (!追加初值起.正常) { 运行时错误(4); }
            结果<空类型, 整32> 追加初值终 = 静态初值终点们.追加(0 - 1);
            如果 (!追加初值终.正常) { 运行时错误(4); }
        }
        整64 静态槽序 = 0 - 1;
        结果<整64, 整32> 查静态槽序 = 查静态序号(静态槽名);
        // 快照槽上文刚注册/已存在（注册单点）——miss=编译器内部不一致
        如果 (查静态槽序.正常) { 静态槽序 = 查静态槽序.值; } 否则 {
            运行时错误(4);
        }
        // 字段地址（this 槽+字段偏移·发射类字段地址 同款·生成类 上下文）
        整64 字段地址 = 发射类字段地址(字段偏移, 指令, 寄存器计数);
        // 分派预判布尔化（分支头避单边比较词面）
        布尔 字段是块拷 = (字段块字节 != 0);
        如果 (捕获形态 == 3) {
            // [&] 引用捕获：字段地址直存（体内解引用读最新/写穿）
            IR追加(指令, 建IR指令(IR_静态存储, 字段地址, 0, 0, 0, 0, 静态槽序));
        } 否则 如果 (字段是块拷) {
            // 结构体/128/数组（【#1880】）字段：字段地址→静态槽整块拷+深拷
            //  （【#940】同款·源址=字段地址=对象本体位置·别名透明免加载/取地址
            //  二分）——数组字段经 发射串字段深拷 入口数组分派走元素级递归深拷
            //  （发射数组元素级深拷·标量元素=位拷已正确/句柄元素=独立副本）。
            整64 目标槽地址 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 目标槽地址, T_整64,
                                 静态槽序));
            IR追加(指令, 建IR指令(IR_结构体拷贝, 字段地址, 目标槽地址, 0, 0,
                                 字段块字节, 0));
            发射串字段深拷(指令, 寄存器计数, 目标槽地址, 字段地址, 捕获类型, 0);
        } 否则 如果 (捕获形态 != 3 && 字段块字节 == 0) {
            // 标量/字符串/指针：字段值加载→静态存储（捕码定宽·spec 04-一D
            //   捕获时复制）
            整64 字段值 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 字段地址, 0, 0, 字段值,
                                 快照捕码, 0));
            IR追加(指令, 建IR指令(IR_静态存储, 字段值, 0, 0, 0, 0, 静态槽序));
        } 否则 {
            // 形态×快照大小闭集外=不可达（形态闭集={0,1,2,3}·前两路已
            //   分流 形态3 与 块拷面）——882 处置③穷举断言拦截
            运行时错误(4);
        }
        返回 真;
    }
    // 无值=非字段非槽名=原 miss 面（顶层 lambda 无字段可捕获·闭集穷举）
    返回 假;
}
