// ==================== 生成语句赋值辅助（# 轮文件长度冻结线清偿·1068 先拆再加纪律） ====================
// 原 生成语句赋值.cn 尾段辅助函数族机械搬移（函数体逐字保留·零逻辑变化）：
//   方法值赋值位三表 /  出参串赋值前处理族（同包零新增跨层依赖）。

导入 容器::向量;
导入 映射集合;
导入 IR;         // IR指令/签名辅助/节点_* 常量（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 031/1114（# 改绑口径·声明位 生成声明 三表登记同构）：方法值变量赋值位
//   三表更新——右值末节点=成员（对象.方法 求值站点已写 最近方法引用*）→
//   目标名三表更新（改绑语义：调用快径展开**新**绑定——旧 1068 未覆盖面：
//   cb = 丙.双倍 后 cb(2) 快径仍展开旧对象（202 实锤）；宿主两槽值通道天然
//   正确=零分叉收口）；右值末=标识符且在 方法引用符号们 → 三表整体复制
//   （cb2 = cb 拷贝链·816 声明位版的赋值位版）。消费后清 最近*（单槽覆盖
//   写协议·与声明位同规）；其余形态（字段赋值/错误恢复）不触碰（保守）。
不安全 函数 方法值赋值位三表(向量<节点> 池, 节点 n) -> 空类型 {
    如果 (整64(n.子终点) <= 整64(n.子起点) + 1) { 返回; }
    节点 末 = 池.元素(整32(整64(n.子终点) - 1));
    如果 (末.类型 == 节点_成员) {
        如果 (最近方法引用符号 != 0) {
            结果<空类型, 整32> 设b = 方法引用符号们.设置(整64(n.文本), 最近方法引用符号);
            如果 (!设b.正常) { 运行时错误(4); }
            结果<空类型, 整32> 设c = 方法引用对象们.设置(整64(n.文本), 最近方法引用对象);
            如果 (!设c.正常) { 运行时错误(4); }
            结果<空类型, 整32> 设d = 方法引用返回码们.设置(整64(n.文本), 最近方法引用返回码);
            如果 (!设d.正常) { 运行时错误(4); }
            最近方法引用符号 = 0;
            最近方法引用对象 = 0;
            最近方法引用返回码 = 0;
        }
        返回;
    }
    如果 (末.类型 != 节点_标识符) { 返回; }
    结果<整64, 整32> 查源 = 方法引用符号们.获取(整64(末.文本));
    如果 (!查源.正常) { 返回; }
    结果<整64, 整32> 查对源 = 方法引用对象们.获取(整64(末.文本));
    结果<整64, 整32> 查码源 = 方法引用返回码们.获取(整64(末.文本));
    整64 符号值 = 0;
    整64 对象值改绑 = 0;
    整64 码值 = 0;
    如果 (查对源.正常) {
        如果 (查码源.正常) {
            符号值 = 查源.值;
            对象值改绑 = 查对源.值;
            码值 = 查码源.值;
        }
        否则 {
        }
    }
    否则 {
    }
    如果 (符号值 == 0) { 返回; }
    结果<空类型, 整32> 设e = 方法引用符号们.设置(整64(n.文本), 符号值);
    如果 (!设e.正常) { 运行时错误(4); }
    结果<空类型, 整32> 设f = 方法引用对象们.设置(整64(n.文本), 对象值改绑);
    如果 (!设f.正常) { 运行时错误(4); }
    结果<空类型, 整32> 设g = 方法引用返回码们.设置(整64(n.文本), 码值);
    如果 (!设g.正常) { 运行时错误(4); }
}
// ==================== ：出参串赋值前处理（字符串 T& 引用交换双侧病·v2 侧）====================

// （1017 采样轮探针 v07 同族·字符串 T& 引用交换双侧病·v2 侧根因）：
//   引用参数（出参）目标 ← 标识符源 的拥有型串赋值——**目标旧值 drop + 源移交
//   清零**（Rust `*out = s`（&mut String）对 String 即 move：旧值先析构、出参槽
//   获得所有权、源失效。与宿主 identifierStringByRefAssign 同构·双侧零分叉）。
//   修前病象（双侧探针实录）：①写回调用方槽后源槽未清——源=局部拥有串
//   （字符串变量们 名单）时函数出口 RAII 按名单 __cn_str_free(源) 把**已移交
//   调用方的句柄**释放=调用方悬垂（交换探针：打印行「乙」缺「甲」；212 F5
//   「输出 = 缓冲」同型）；源=引用参数（交换第一笔 `甲 = 乙`）时源变量与
//   新目标槽共享句柄（双主）亦然；②写回覆盖目标旧句柄无释放——交换净泄 1
//   堆串（内存账探针：活动分配差 3 vs 基线 2）。
//   形态分桶（源槽定位·先后序=局部表→参数表）：
//   ①源=局部槽：在 字符串变量们 名单且无污染登记 → 源槽清 0（出口 free(0)
//     空安全跳过——句柄已移交调用方，本函数不得再释放）；
//   ②源=引用参数槽（槽是引用）：清零**被引用变量槽**（*源参槽=0）——源参槽
//     自身存变量地址须保留（后续再读/写该参数链不断；宿主  同修点：
//     误清参槽=交换第二笔经 0 地址写回=空指针解引用〔错误码3〕实录）；
//     源变量既已移交=失效（对齐宿主 move 语义）；源=按值串参数（名单）同①清参槽。
//   ③其余（静态/全局/污染借用名）→ 清零零发射（源非拥有=无出口释放可双）；
//     同名自赋值（甲=甲）drop 与清源均跳过（drop 旧值后写回同句柄=UAF 面，
//     无操作语义）。
//   目标旧值 drop 空/非追踪安全：__cn_str_free → cn_free_tracked 对未注册
//   指针忽略（字面量/视图直存形态零误伤——与宿主同口径）。
//   补给面（非标识符源）：drop 对**一切源形态**执行（字面量/调用产物/拼接/
//   转移——`出 = 字符串复制("新")` 三次覆盖净泄 3 块实录）；源移交清零仅
//   标识符源（非标识符无可清源槽）。与宿主通用引用写回分支  drop 同构。
不安全 函数 发射出参串赋前处理(向量<节点> 池, 节点 n, 整64 目标槽,
                   映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                   函数IR& 函数信息, 向量<IR指令>& 指令, 整64* 寄存器计数) -> 空类型 {
    // 命名豁免规范编号: 是引用串参数1089=既有 #1089 机制函数名（IR生成尾.cn 定义·调用面不可改名）
    如果 (!是引用串参数1089(目标槽)) { 返回; }
    如果 (n.子终点 <= n.子起点) { 返回; }
    节点 源末 = 池.元素(整32(n.子终点 - 1));
    布尔 源标 = 源末.类型 == 节点_标识符;
    布尔 自赋 = 假;
    如果 (源标) { 自赋 = 整64(源末.文本) == 整64(n.文本); }
    如果 (!自赋) {
        // ①目标旧值 drop：Load 目标参槽（变量地址）→ PtrLoad（旧句柄）→ free
        //   （须在写回覆盖前——写回后读的是新值；一切源形态）。
        整64 目址 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 目址, T_整64, 0));
        整64 旧值出参 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_指针加载, 目址, 0, 0, 旧值出参, T_字符串, 0));
        发射寄存器串释放(旧值出参, 指令);
        如果 (源标) {
            整64 源名 = 整64(源末.文本);
            // ②源移交清零（标识符源·分桶：局部名单串→清源槽；引用参数→清
            //   被引用变量槽；其余形态无对象——写回照常）
            结果<整64, 整32> 找局出参 = 局部槽.获取(源名);
            如果 (找局出参.正常) {
                如果 (是名单串(函数信息, 源名)) {
                    发射清槽(指令, 寄存器计数, 找局出参.值);
                }
                返回;
            }
            否则 {
            }
            结果<整64, 整32> 找参出参 = 参数槽.获取(源名);
            如果 (找参出参.正常) {
                如果 (槽是引用(找参出参.值)) {
                    发射清引用目标(指令, 寄存器计数, 找参出参.值);
                } 否则 如果 (是名单串(函数信息, 源名)) {
                    发射清槽(指令, 寄存器计数, 找参出参.值);
                }
            }
            否则 {
            }
        }
    }
}

// ：源=拥有型串判定（字符串变量们 名单命中 ∧ 字符串污染们 无登记）——
//   名单=声明位/被消耗形参副本登记（生成声明/生成函数 两处单点）；污染名
//   （借用视图来源）不作移交清零（源非拥有=无出口释放可双）。
不安全 函数 是名单串(函数IR& 函数信息, 整64 名ID) -> 布尔 {
    结果<整64, 整32> 查污 = 函数信息.字符串污染们.获取(名ID);
    如果 (查污.正常) { 返回 假; } 否则 { }
    整64 序出参 = 0;
    布尔 命中出参 = 假;
    当 (序出参 < 函数信息.字符串变量们.大小() && !命中出参) {
        如果 (函数信息.字符串变量们.元素(序出参) == 名ID) { 命中出参 = 真; }
        序出参++;
    }
    返回 命中出参;
}

// ：源槽清零（常量 0 寄存器 存 0 到槽·释放点清零 73-a 口径；槽 0=未登记
//   跳过——宁漏勿错不崩）。不用 零寄存器 预扫面：本通道函数可无资源声明
//   （零寄存器=0·探针实证）仍须清零，自建常量 0 单条。
不安全 函数 发射清槽(向量<IR指令>& 指令, 整64* 寄存器计数, 整64 槽) -> 空类型 {
    如果 (槽 != 0) {
        整64 零a = 发射常量零(指令, 寄存器计数);
        IR追加(指令, 建IR指令(IR_存储, 零a, 0, 0, 0, 0, 槽));
    }
}

// ：清零被引用变量槽（*源参槽 = 0）——源参槽自身（存变量地址）保留：
//   后续再读/写该参数链不断（宿主  实录：误清参槽=地址丢失→经 0 地址
//   写回=空指针解引用〔错误码3〕）。
不安全 函数 发射清引用目标(向量<IR指令>& 指令, 整64* 寄存器计数,
                   整64 源参槽) -> 空类型 {
    整64 变址出参 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 源参槽, 0, 0, 变址出参, T_整64, 0));
    整64 零出参乙 = 发射常量零(指令, 寄存器计数);
    IR追加(指令, 建IR指令(IR_指针存储, 变址出参, 零出参乙, 0, 0, T_整64, 0));
}

// ：常量 0 寄存器发射（IR_常量整数 文本 "0"）——返回新寄存器号。
不安全 函数 发射常量零(向量<IR指令>& 指令, 整64* 寄存器计数) -> 整64 {
    整64 零出参 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("0")), 0, 0, 零出参, T_整64, 0));
    返回 零出参;
}

// ===== 冻结线清偿：544b 成员旧值释放族自 生成语句赋值中.cn 机械搬出 =====
//   （生成语句赋值中 触 1000 冻结线·先拆再加；纯搬运零行为变更——消费方=同包
//   尝试成员类返回调用写544b / 尝试成员容器返回调用写922 / 尝试成员构造直存写625b；
//   依赖 在资源字段名单/容器变量们/析构符号/是容器类 均为本包更早加载面）
// 544b（544 呈报·赋值位形态②成员面·2026-10-17 任务629）：成员链左值 ←
//   「返回类对象的调用」产物（盒.槽 = 仓.产()·字段=用户类）——544 标识符面
//   同根异面。缺陷链（629 探针矩阵 v2 侧实证）：右值经聚合返回 ABI 物化到
//   调用方帧内（栈临时·对象本体）——原落标量宽度通道 IR_指针存储 直存
//   **栈临时地址**：块出口父析构级联按堆句柄释放 槽=free 栈地址 →
//   C0000374（p629d 实录）。宿主=调用产物堆句柄直存（rax=对象指针）。
//   修=544 同款「位拷物化 + 旧值释放 + 堆句柄入槽」（判定严格：字段=用户类
//   非容器 ∧ 右末=调用 ∧ 是返回类调用_544 单一事实源）。返回 真=已处理。
不安全 函数 发射成员拥有旧值释放(向量<节点> 池, 节点 左末, 整64 目标地址,
                   整64 字段类型ID, 向量<IR指令>& 指令,
                   函数IR& 函数信息, 整64* 寄存器计数) -> 空类型 {
    如果 (目标地址 == 0) { 返回; }
    节点 父对象节点 = 池.元素(整32(左末.子起点));
    布尔 父拥有字段 = 假;
    如果 (父对象节点.类型 == 节点_标识符) {
        整64 父名 = 整64(父对象节点.文本);
        如果 (在资源字段名单(函数信息, 父名)) { 父拥有字段 = 真; }
        如果 (!父拥有字段) {
            整64 变量序 = 0;
            当 (变量序 < 函数信息.容器变量们.大小()) {
                如果 (函数信息.容器变量们.元素(变量序) == 父名) {
                    父拥有字段 = 真;
                    中断;
                }
                变量序++;
            }
        }
    }
    如果 (父拥有字段) {
        // #1970 内联头容器分支（宿主 emitClassFieldHandleCopy 旧值释放同批
        //   同构·1601 翻车位）：容器字段=头内联域——旧值释放=Call ~容器
        //   （this=内联头地址·判空释放数组幂等），禁 LoadPtr 把头首字段当
        //   壳指针删除（free(0x1) 段错误 127_v2 实锚同型）。
        // #1970 两态归一（容器字段是类内联域 单一判据源）：内联头仅类字段——
        //   结构体对象的容器字段=句柄槽，落下方 LoadPtr+删除对象 通道
        //   （宿主结构体成员赋值旧值释放同款）。
        整64 父对象类型ID = 0;
        如果 (父对象节点.类型 == 节点_标识符) {
            父对象类型ID = 解析标识符类型ID(整64(父对象节点.文本));
        }
        如果 (容器字段是类内联域(父对象类型ID) &&
            (是容器类(字符串复制(驻留文本(字段类型ID))) ||
             是字符串映射实例名(字符串复制(驻留文本(字段类型ID))))) {
            IR追加(指令, 建IR指令(IR_调用实参, 目标地址, 0, 0, 0, 0, 0));
            IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                 整64(驻留(析构符号(字符串复制(驻留文本(字段类型ID)))))));
            返回;
        }
        整64 旧壳对象 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_指针加载, 目标地址, 0, 0, 旧壳对象,
                              T_对象, 0));
        IR追加(指令, 建IR指令(IR_删除对象, 旧壳对象, 0, 0, 寄存器计数[0], 0,
                             字段类型ID));
        寄存器计数[0] = 寄存器计数[0] + 1;
    }
}

// 544b：指针字段排除（381 同款·声明类型带星=句柄槽赋值维持标量通道）
函数 成员字段声明是指针(向量<节点> 池, 节点 左末) -> 布尔 {
    节点 父节点 = 池.元素(整32(左末.子起点));
    如果 (父节点.类型 == 节点_标识符) {
        整64 父对象类型ID = 解析标识符类型ID(整64(父节点.文本));
        如果 (父对象类型ID != 0) {
            可选<整64> 声明类型查 = 查字段类型ID(父对象类型ID, 整64(左末.文本));
            如果 (声明类型查.有值) {
                整64 声明类型 = 声明类型查.值;
                字符串 声明文本 = 字符串复制(驻留文本(声明类型));
                // 静默豁免闭集穷举: 长度 0/1=裸基名（无星/引用尾缀）·尾字符判据前置
                如果 (字符串长度(声明文本) > 1 &&
                    (整64(声明文本[字符串长度(声明文本) - 1]) & 255) == 42) {
                    返回 真;
                }
            }
        }
    }
    返回 假;
}
