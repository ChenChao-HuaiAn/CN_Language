// 生成语句赋值中（356 重构F1 自 生成语句赋值.cn 纯机械搬移·函数体逐字保留·零逻辑变化）

导入 容器::向量;
导入 映射集合;
导入 IR;         // IR指令/签名辅助/节点_* 常量（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）


不安全 函数 发射拥有串赋值(向量<节点> 池, 节点 n, 整64 目标槽, 整64 值寄存器,
                  函数IR& 函数信息, 向量<IR指令>& 指令, 整64* 寄存器计数) -> 整64 {
    如果 (值寄存器 != 0 && 目标槽 != 0) {
        可选<整64> 赋类型2查 = 查当前函数变量类型(整64(n.文本));
        如果 (赋类型2查.有值 && 赋类型2查.值 == 驻留("字符串")) {
            布尔 在名单 = 假;
            整64 名i = 0;
            当 (名i < 函数信息.字符串变量们.大小()) {
                如果 (函数信息.字符串变量们.元素(名i) == 整64(n.文本)) {
                    在名单 = 真;
                    中断;
                }
                名i++;
            }
            结果<整64, 整32> 查污赋 = 函数信息.字符串污染们.获取(整64(n.文本));
            如果 (在名单 && !查污赋.正常) {
                节点 赋末 = 池.元素(n.子终点 - 1);
                布尔 右值拥有 = 赋末.类型 == 节点_字符串字面量 ||
                                赋末.类型 == 节点_标识符 ||
                                赋末.类型 == 节点_二元运算;
                // 933（任务 933·双侧零分叉）：引用返回字符串调用（`副 = b.读名();`·
                //   被调返回 字符串&）——右值读值=借用视图（柄归被引用对象），
                //   赋值位=拥有型语义 → free 旧 + __cn_str_copy 落堆独立拥有
                //   （与字面量/标识符分支同款，而**非**值返回调用的直存 move）。
                //   原落「非白名单调用 → 污染退出」=浅拷共享+不释放：源改名后
                //   副悬垂（933 探针实录）。声明位/返回位同族修见 生成声明.cn/
                //   生成语句辅助.cn；宿主同面同轮对齐。
                布尔 引用返回拷933 = 假;
                如果 (赋末.类型 == 节点_调用) {
                    节点 被调赋 = 池.元素(整32(赋末.子起点));
                    如果 (被调赋.类型 == 节点_标识符) {
                        整64 被调名赋 = 整64(被调赋.文本);
                        右值拥有 = 被调名赋 == 驻留("字符串复制") ||
                                  被调名赋 == 驻留("字符串连接") ||
                                  被调名赋 == 驻留("字符串拼接") ||
                                  被调名赋 == 驻留("字符串子串") ||
                                  被调名赋 == 驻留("字符串大写") ||
                                  被调名赋 == 驻留("字符串小写") ||
                                  被调名赋 == 驻留("字符串修剪") ||
                                  被调名赋 == 驻留("字符串反转");
                        // A2（方案甲）：返回类型契约——被调者返回 字符串 即拥有
                        //   （72-a：键基回退版——纯名查跨模块 miss=契约失效）
                        如果 (!右值拥有) {
                            // 1541 B2：无值=返回类型未知（原 0 判据等价）
                            可选<整64> 赋返查 = 查函数返回回退(被调名赋);
                            如果 (赋返查.有值) {
                                整64 赋返ID = 赋返查.值;
                                如果 (赋返ID == 驻留("字符串")) { 右值拥有 = 真; }
                            }
                        }
                    }
                    如果 (!右值拥有 &&
                        是引用返回字符串调用933(池, 整32(n.子终点 - 1))) {
                        引用返回拷933 = 真;
                    }
                }
                // 字面量/标识符/引用返回调用：先 copy 落堆再 free 旧（自赋值
                //   s = s 安全——copy 产物独立于旧值内存后才能释放旧值；引用
                //   返回=借用视图·933 同款）
                如果 ((右值拥有 && (赋末.类型 == 节点_字符串字面量 ||
                                赋末.类型 == 节点_标识符)) || 引用返回拷933) {
                    整64 copy赋寄存器 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_调用实参, 值寄存器, 0, 0, 0, 0, 0));
                    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, copy赋寄存器, 0,
                                         驻留("__cn_str_copy")));
                    登记寄存器类型(copy赋寄存器, T_字符串);
                    值寄存器 = copy赋寄存器;
                }
                // free 旧值（drop——拥有链维护下旧值必为堆串；空安全；二元/调用
                //   右值求值时已消费旧值内容产新堆——free 后不再引用）
                整64 旧ptr = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 旧ptr, T_字符串, 0));
                IR追加(指令, 建IR指令(IR_调用实参, 旧ptr, 0, 0, 0, 0, 0));
                IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                     驻留("__cn_str_free")));
                如果 (!右值拥有 && !引用返回拷933) {
                    // 借用源——污染退出（此后不再 free/拥有化）
                    登记串污染(函数信息, 整64(n.文本));   // 75-a：唯一入口
                }
            }
        }
    }
    返回 值寄存器;
}

// 成员/解引用左值赋值生成（172-a 自 生成赋值语句 分支二 机械搬移）：
//   手动生成左值地址（不走 生成表达式，避免成员取值）。
不安全 函数 生成成员解引用赋值(向量<节点> 池, 节点 n,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) {
    向量<IR指令>& 指令 = 函数信息.指令;
    // ②b B5：成员左值按字段宽度存储（类型码入 指令.类型——旧固定 8 字节
    //   写越界清零相邻槽，126 段① OOM 根因；解引用左值保持默认 8 字节）
    节点 左末 = 池.元素(n.子起点 - 1);
    // 070 波G（1026）：类名.静态字段写——左=成员·对象=用户类名（非变量遮蔽）·
    //   静态字段表命中 → 右值求值+静态槽写（IR_静态地址+指针存储·合成名「类$
    //   字段」）——原落成员左值字段偏移（静态不入对象布局=偏移未知拒绝）
    如果 (左末.类型 == 节点_成员 && 左末.子起点 > 0) {
        节点 对象w = 池.元素(整32(左末.子起点));
        如果 (对象w.类型 == 节点_标识符 && 是用户类_ID(整64(对象w.文本))) {
            结果<整64, 整32> 合成写g = 查类静态字段合成名(整64(对象w.文本), 整64(左末.文本));
            整64 序写g = 0 - 1;
            如果 (合成写g.正常) {
                结果<整64, 整32> 序写g查 = 查静态序号含类(合成写g.值);
                如果 (序写g查.正常) { 序写g = 序写g查.值; } 否则 { }
            } 否则 {
            }
            如果 (序写g >= 0) {
                整64 值寄存器w = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                          指令, 寄存器计数, &函数信息.块计数,
                                          槽计数, 表达式栈);
                // 861（644-b 静态段对称补完·87-a 同律）：静态字符串字段写归一化
                //   ——原 070 通道句柄裸写：借用来源直存=悬垂/重复赋值旧值泄漏
                //   （探针 p9①c/②c 实录）。走 归一化静态串赋值 单点（copy 分级
                //   + drop 旧 + 写新；与 生成标识符赋值 内 070 段同款）。
                布尔 是串w = 字符串比较(驻留文本(取静态类型(序写g)), "字符串");
                如果 (是串w) {
                    值寄存器w = 归一化静态串赋值(池, n, 值寄存器w, 序写g,
                                                 函数信息, 寄存器计数);
                } 否则 如果 (!是串w) {
                    整64 静址w = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静址w, T_整64, 序写g));
                    IR追加(指令, 建IR指令(IR_指针存储, 静址w, 值寄存器w, 0, 0, T_整64, 0));
                }
                当 (表达式栈.大小() > 0) {
                    结果<空类型, 整32> 删栈w = 表达式栈.删除(表达式栈.大小() - 1);
                    如果 (!删栈w.正常) { 运行时错误(4); }
                }
                返回;
            }
        }
    }
    // 46-a 根治（2026-09-09 第四十八轮）：成员结构体作值写（r.左上 = a /
    //   r.右下 = r.左上，含 >8 字节结构体）——左字段类型是结构体且右值为
    //   标识符/成员链（结构体值形态）时，两侧 生成左值地址 + IR_结构体拷贝
    //   整体写（Rust place 拷贝语义，与 生成结构体整体赋值 同构）。原标量
    //   宽度通道对 8 字节结构体恰好覆盖、>8 字节静默截断（数据损坏家族）；
    //   右值经 成员载荷是结构体 根治后压地址，此通道统一地址语义。
    //   构造字面量右值（节点_构造展开，186 通道）不在此拦截。
    // 172-a：发射面自本函数提取为 尝试成员结构体整体写（真=已处理）。
    如果 (尝试成员结构体整体写(池, n, 左末, 局部槽, 参数槽, 函数信息,
                             寄存器计数, 槽计数, 表达式栈)) {
        返回;
    }
    // 346-a（2026-09-18 第 346 轮·T57 根治·成员链目标）：成员链左值=容器/用户类
    //   对象字段 → 深拷贝整体写（原落下方标量宽度通道=8 字节句柄浅覆盖）
    如果 (尝试成员对象整体写(池, n, 左末, 局部槽, 参数槽, 函数信息,
                             寄存器计数, 槽计数, 表达式栈)) {
        返回;
    }
    // 544b（544 呈报·成员面·任务629）：成员链左值 ←「返回类对象的调用」产物
    //   （盒.槽 = 仓.产()）——位拷物化 + 旧值释放 + 堆句柄入槽（族实现=本文件）
    如果 (尝试成员类返回调用写544b(池, n, 左末, 局部槽, 参数槽, 函数信息,
                             寄存器计数, 槽计数, 表达式栈)) {
        返回;
    }
    // 922（#925 并入·成员容器字段面）：成员链左值=**容器字段** ←「返回容器的
    //   调用」（盒.槽 = 厂.产()）——544b 容器守卫排除后的同族残面（922 矩阵
    //   9113 C0000374 实录）——堆物化+旧值释放+地址入槽（族实现=本文件）
    如果 (尝试成员容器返回调用写922(池, n, 左末, 局部槽, 参数槽, 函数信息,
                             寄存器计数, 槽计数, 表达式栈)) {
        返回;
    }
    // 625b（629 矩阵·成员×构造面）：成员链左值 ← 字段类构造调用（盒.槽 =
    //   货架()）——旧值释放 + 堆句柄直存（族实现=本文件）
    如果 (尝试成员构造直存写625b(池, n, 左末, 局部槽, 参数槽, 函数信息,
                             寄存器计数, 槽计数, 表达式栈)) {
        返回;
    }
    // 658①（2026-10-14·#658）：成员链左值=类对象×合成体字段（可选/结果）整体
    //   写——原 尝试成员结构体整体写 对合成体 查结构体类型=0 miss → 落标量
    //   宽度通道 8B 写「临时槽基址」（904 形二三 56≠120·悬垂+泄漏实证）。
    如果 (尝试成员合成体整体写(池, n, 左末, 局部槽, 参数槽, 函数信息,
                             寄存器计数, 槽计数, 表达式栈)) {
        返回;
    }
    // 890-b（002 攻族·537 D 段根治）：下标左值=**合成体元素**（结果/可选——
    //   容器数据指针 `数据[i] = 值` 形态）→ 整体深拷写（IR_结构体拷贝·元素
    //   字节=结果大小）。原落下方标量宽度通道=IR_指针存储 8 字节句柄直存——
    //   与读取侧（元素() 按元素槽 16B 值深拷）不对称 → 元素槽仅存实参地址 →
    //   读回 tag/值全错（537 D 段 D值=128 实证）。右值形态统一「源地址起拷」：
    //   标识符/成员（结构体值读=地址语义·673 同款）与构造调用（临时基址）
    //   均由 生成表达式 产地址。**排除局部数组**（`结果<T,E>[N] 组`——94-a 数组
    //   名退化=**句柄模型**：元素槽存 8B 对象句柄、读取经 op=44 取句柄再拷——
    //   537 A 段全对实证；若误入本分支=写 16B 值/读句柄错位崩溃）：仅**指针
    //   下标**（类字段 数据/指针变量——值槽模型·步进=元素字节）触发。
    布尔 下标对象是数组890 = 假;
    如果 (左末.类型 == 节点_下标 && 左末.子起点 > 0) {
        节点 下标对象890 = 池.元素(整32(左末.子起点));
        如果 (下标对象890.类型 == 节点_标识符) {
            可选<整64> 对象型890查 = 查当前函数变量类型(整64(下标对象890.文本));
            如果 (对象型890查.有值 && 是数组类型文本_ID(对象型890查.值)) {
                下标对象是数组890 = 真;
            }
        }
    }
    如果 (左末.类型 == 节点_下标 && 左末.子起点 > 0 && !下标对象是数组890) {
        整64 元素型ID890 = 推导下标元素类型ID(池, 整32(左末.子起点));
        如果 (元素型ID890 > 0 && 是结果类型_ID(元素型ID890)) {
            整64 目标地址890 = 生成左值地址(池, 整32(n.附加), n.子起点, 局部槽,
                                          参数槽, 指令, 寄存器计数,
                                          &函数信息.块计数, 槽计数, 表达式栈);
            整64 源值890 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                     指令, 寄存器计数, &函数信息.块计数,
                                     槽计数, 表达式栈);
            整64 字节890 = 结果大小(字符串复制(驻留文本(元素型ID890)));
            如果 (目标地址890 != 0 && 源值890 != 0 && 字节890 > 0) {
                IR追加(指令, 建IR指令(IR_结构体拷贝, 源值890, 目标地址890,
                                     0, 0, 字节890, 0));
            }
            当 (表达式栈.大小() > 0) {
                结果<空类型, 整32> 删栈890 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删栈890.正常) { 运行时错误(4); }
            }
            返回;
        }
    }
    // 348-a（D11 甲方案·下标左值形态）：数组元素 = 结构体返回调用 → 源优先序整体写
    如果 (尝试下标结构体整体写(池, n, 左末, 局部槽, 参数槽, 函数信息,
                             寄存器计数, 槽计数, 表达式栈)) {
        返回;
    }
    // 208 病面④（2026-10-06·615 实证）：解引用左值=结构体/类/大标量 → 整体写
    //   （对齐宿主 indexStructElemAssign 守卫放宽——原落标量宽度通道 8 字节
    //   只写前半·丙 残留旧值）
    如果 (尝试解引用结构体整体写(池, n, 左末, 局部槽, 参数槽, 函数信息,
                             寄存器计数, 槽计数, 表达式栈)) {
        返回;
    }
    // 648 归档：T_整64=分派初值非 miss 终态（成员/下标/调用/解引用 四形态
    //   分派覆盖；真 miss 面已下沉 取成员宽度码/取下标元素宽度码/类型码 各查
    //   询点登记）——初值行不登记。
    整64 存储宽度 = T_整64;
    如果 (左末.类型 == 节点_成员) {
        存储宽度 = 取成员宽度码(池, n.子起点 - 1);
    } 否则 如果 (左末.类型 == 节点_下标) {
        // ③ 第三波：下标左值写宽度=所指元素宽度（整32* p[0]=v 写 4 字节，
        //   8 字节写越界踩相邻元素——同 B5 成员窄宽教训）
        存储宽度 = 取下标元素宽度码(池, n.子起点 - 1);
    } 否则 如果 (左末.类型 == 节点_调用) {
        // 118（929·任务 118）：引用返回调用左值（v.元素引用(i) = x）写宽度=
        //   被引用元素类型宽度——原落默认 T_整64（8 字节）→ 整32 元素写穿
        //   踩相邻元素（569 用例 元素(1) 被清 0 实证）。经 是引用返回调用 语义
        //   放行面+解析调用返回结构体 的签名表基名（已剥尾 &）取类型码；
        //   未命中（非引用返回调用·防御）保持默认。
        // 648 归档：未命中=「非引用返回调用左值」语义层已拒形态的防御恢复
        //   路径（上游已报错），按豁免判据只补注释不登记。
        整64 左结构体z = 0;
        可选<整64> 左结构查z = 解析调用返回结构体(池, n.子起点 - 1);
        如果 (左结构查z.有值) { 左结构体z = 左结构查z.值; }
        如果 (左结构体z != 0) {
            存储宽度 = 类型码(左结构体z);
        }
    } 否则 如果 (左末.类型 == 节点_解引用 && 左末.子起点 > 0) {
        // 208 病面①（2026-10-06·613/614 实证）：解引用左值写宽度=指针元素类型
        //   宽度码（`*整32指针 = 值` 写 4 字节·整8/整16 同理——原落默认 T_整64
        //   8 字节写越界清零相邻元素·asm mov [rax],rcx 铁证）。字符豁免=整串
        //   句柄视图（同读侧 A2）。
        // 813（2026-10-16）：推导收口 解引用所指宽度码813 单点（与读侧 266-a
        //   同源·操作数取**末节点** 子终点-1〔655 设计注记〕+标识符/成员链/指针
        //   算术/一元递归全分支）；修前只认首节点标识符——成员链 *b.游标 = v
        //   恒兜底 T_整64 8 字节宽写穿邻（与读侧 992b 同族）。miss=648 显形。
        存储宽度 = 解引用所指宽度码813(池, 左末);
    }
    整64 地址寄存器 = 生成左值地址(池, 整32(n.附加), n.子起点, 局部槽, 参数槽,
                                指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
    整64 值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                               指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
    // 040（001 §5.8 甲案）：成员/下标赋值位右值函数名收口——`h.回调 = 加一` /
    //   `表[0] = 加一`（生成标识符赋值 :151 同款·原缺=负占位直存指针存储·
    //   probe603/fld 值寄存器 -36 发射守卫中止实证）
    值寄存器 = 值位函数名收口480(值寄存器, 指令, 寄存器计数);    // plans/019 阶段4' 第二批：下标目标为字符串元素（字符串* 指针元素——
    //   查指针变量类型 直判所指类型，宽度码对字符串归并 T_整64 不可用）且
    //   右值为字符串变量标识符 -> 值被外部槽持有（指针逃逸模型，宿主 38_tool
    //   姓名[]=$副本 同款）-> 右值变量污染退出 RAII（出口 free=悬垂源头）
    如果 (左末.类型 == 节点_下标 && 左末.子起点 > 0 &&
         n.子起点 < n.子终点) {
        节点 借对象 = 池.元素(整32(左末.子起点));
        可选<整64> 借所指查 = 查指针变量类型(整64(借对象.文本));
        如果 (借对象.类型 == 节点_标识符) {
            如果 (借所指查.有值) {
                整64 借所指 = 借所指查.值;
                如果 (借所指 == 驻留("字符串")) {
                    节点 右末借 = 池.元素(n.子终点 - 1);
                    可选<整64> 右末类型查 = 查当前函数变量类型(整64(右末借.文本));
                    如果 (右末借.类型 == 节点_标识符) {
                        如果 (右末类型查.有值) {
                            整64 右末类型 = 右末类型查.值;
                            如果 (右末类型 == 驻留("字符串")) {
                                登记串污染(函数信息, 整64(右末借.文本));   // 75-a：唯一入口
                            }
                        }
                    }
                }
            }
        }
    }
    // 79-a（2026-09-12 第七十九轮）：成员字符串字段写入归一化——字段独立拥有
    //   （与宿主 79-a 同款分级）：字面量=驻留直存；裸函数调用（白名单族/返回
    //   字符串契约）=接管零拷贝；其余（标识符/成员/下标/二元/方法调用借用返回）
    //   =__cn_str_copy 落堆（字段独立副本，源保持拥有照常释放）。顺序=先求值+
    //   复制、后 free 旧值（自赋值 甲.名 = 甲.名 安全：新值先独立于旧值内存）。
    //   preFree 仅对「直连标识符父对象且父在资源字段名单」（拥有槽）发射——其余
    //   形态保守不释放旧值（宁漏勿错）。
    // 172-a：发射面自本函数提取为 发射成员串字段写入（返回写回后的值寄存器）。
    值寄存器 = 发射成员串字段写入(池, n, 左末, 地址寄存器, 值寄存器, 函数信息,
                              指令, 寄存器计数);
    // 565 轮（T33 残余根治）：复合赋值脱糖的标识符左值（文本=0·附加=左值区间
    //   起点·左末=标识符节点）经本路径 8 字节 IR_指针存储——存储前按变量声明
    //   类型窄宽值规范化（b5 探针：甲+=整16(30000) 宿主 -5536/v2 曾 60000——
    //   脱糖节点不走 生成标识符赋值 的规范化点）。查当前函数变量类型 miss
    //   （静态等）或指针变量（查指针变量类型 命中）→直通=行为零变化。成员/
    //   下标左值=既有 存储宽度码 通道（B5/347-a 已按字段/元素宽度·不触）。
    可选<整64> 左末指针查 = 查指针变量类型(整64(左末.文本));
    可选<整64> 左末类型查 = 查当前函数变量类型(整64(左末.文本));
    // 无类型文本（无值=静态等·原 -1→空串）跳过规范化=原直通语义
    如果 (左末.类型 == 节点_标识符 && !左末指针查.有值) {
        如果 (左末类型查.有值) {
            值寄存器 = 窄宽值规范化(窄宽码自文本(字符串复制(驻留文本(左末类型查.值))),
                         值寄存器, 指令, 寄存器计数);
        }
    }
    // 768 续（001 波·761 回退撤除）：原「查 结构体返回临时们 命中→按登记尺寸
    //   整体写」回退段删除——查表键=值寄存器**号域**与登记键=物化基址**号域**
    //   复用（寄存器号 1 既是某语句物化基址又是另一语句 Load 值·768 续 gdb
    //   实证 rsi=1 rep movsb 崩），判据本质不可靠；其设计目标（复制 展开产物
    //   赋下标左值=整体写）已由 尝试下标结构体整体写 的 调用/地点 右值形态
    //   统一段完全覆盖（760-a+768 续下标链扩面）——回退段=冗余+误命中雷。
    // 822（053-002）：复合赋值脱糖的 **128 位标识符左值**——值=句柄（二元/算术
    //   产物）→ 双半拷贝到目标槽对（IR_指针存储 8 字节=句柄直存错误·q3 实证
    //   `甲 += 1` 只改低半）；静态目标=IR_静态地址+IR_结构体拷贝 16 字节。
    如果 (左末.类型 == 节点_标识符 && 值寄存器 != 0) {
        可选<整64> 左类型128查 = 查当前函数变量类型(整64(左末.文本));
        // 无值=非本函数变量（静态等）——原 -1→空串：非 128，走既有 8 字节通道
        字符串 左类型文本c128 = "";
        如果 (左类型128查.有值) { 左类型文本c128 = 字符串复制(驻留文本(左类型128查.值)); }
        如果 (字符串比较(左类型文本c128, "整128") ||
             字符串比较(左类型文本c128, "正128")) {
            整64 目标槽c128 = 0;
            结果<整64, 整32> 找局128 = 局部槽.获取(整64(左末.文本));
            // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
            如果 (找局128.正常) { 目标槽c128 = 找局128.值; } 否则 { }
            如果 (目标槽c128 == 0) {
                结果<整64, 整32> 找参128 = 参数槽.获取(整64(左末.文本));
                // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
                如果 (找参128.正常) { 目标槽c128 = 找参128.值; } 否则 { }
            }
            如果 (目标槽c128 != 0) {
                // 466：引用参数目标分流——复合赋值脱糖左值=引用槽（内容=调用方
                //   左值地址）时 双半拷贝 写本地槽对=覆盖地址+相邻槽（同 生成
                //   标识符赋值 128 通道·v += 1 脱糖形态同病），改发
                //   发射引用参数128写 落调用方 16 字节对象全宽。
                如果 (槽是引用(目标槽c128)) {
                    发射引用参数128写(目标槽c128, 值寄存器,
                                      字符串比较(左类型文本c128, "正128") ? 0 : 1,
                                      指令, 寄存器计数, 槽计数);
                } 否则 {
                    发射128位双半拷贝(值寄存器, 目标槽c128, 目标槽c128 - 1,
                                      指令, 寄存器计数);
                }
            } 否则 {   // 静默豁免业务值: 成员 128 位赋值静态目标分支（既有通道·1360 批5 结果化改锚）
                结果<整64, 整32> 找静c128查 = 查静态序号含类(整64(左末.文本));
                如果 (找静c128查.正常) {
                    整64 静地址c128 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静地址c128,
                                         T_整64, 找静c128查.值));
                    IR追加(指令, 建IR指令(IR_结构体拷贝, 值寄存器, 静地址c128,
                                         0, 0, 16, 0));
                }
            }
            当 (表达式栈.大小() > 0) {
                结果<空类型, 整32> 删栈c128 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删栈c128.正常) { 运行时错误(4); }
            }
            返回;
        }
    }
    如果 (地址寄存器 != 0 && 值寄存器 != 0) {
        如果 (存储宽度 == T_整128 || 存储宽度 == T_正128) {
            // 545（070 波D-二·1022）：128 位字段窄源写（脱糖成员赋值 h.大 = 窄
            //   表达式 形态·解析期脱糖不经过 生成结构体构造）——单指针存储按
            //   句柄 8 字节直存=高半垃圾（同 字面量字段 实录）——窄源按符号性
            //   物化双半槽对+双半写（与声明位/字面量位同族三面收口）
            // 1360 批5：未登记=类型未知（T_未知 兜底·既有业务语义：非 128 源）
            整64 源码m128 = 查寄存器类型或未知(值寄存器);
            如果 (源码m128 == T_整128 || 源码m128 == T_正128) {
                整64 低m = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_指针加载, 值寄存器, 0, 0, 低m, T_整64, 0));
                IR追加(指令, 建IR指令(IR_指针存储, 地址寄存器, 低m, 0, 0, T_整64, 0));
                整64 高源m = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_字段地址, 值寄存器, 0, 0, 高源m, T_整64, 8));
                整64 高址m = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_字段地址, 地址寄存器, 0, 0, 高址m, T_整64, 8));
                整64 高值m = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_指针加载, 高源m, 0, 0, 高值m, T_整64, 0));
                IR追加(指令, 建IR指令(IR_指针存储, 高址m, 高值m, 0, 0, T_整64, 0));
            } 否则 {
                整64 物化码m = 源码m128;
                整64 有符号m = 1;
                // 648 归档：T_未知 兜底源=「二元算术产物不登记」既有惯例（查
                //   寄存器类型 0=高频合法值面·见该函数归档注释），非查表 miss
                //   病面，不登记（与 生成声明 128 物化同款口径）。
                如果 (物化码m == T_未知) { 物化码m = T_整64; }
                如果 (物化码m == T_正32 || 物化码m == T_正64) { 有符号m = 0; }
                整64 句柄m = 物化128位操作数(值寄存器, 物化码m, 有符号m,
                                        指令, 寄存器计数, 槽计数);
                整64 低m2 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_指针加载, 句柄m, 0, 0, 低m2, T_整64, 0));
                IR追加(指令, 建IR指令(IR_指针存储, 地址寄存器, 低m2, 0, 0, T_整64, 0));
                整64 高源m2 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_字段地址, 句柄m, 0, 0, 高源m2, T_整64, 8));
                整64 高址m2 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_字段地址, 地址寄存器, 0, 0, 高址m2, T_整64, 8));
                整64 高值m2 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_指针加载, 高源m2, 0, 0, 高值m2, T_整64, 0));
                IR追加(指令, 建IR指令(IR_指针存储, 高址m2, 高值m2, 0, 0, T_整64, 0));
            }
        } 否则 如果 (存储宽度 != T_整128 && 存储宽度 != T_正128) {
            // 919（超承载字面量参与表达式·成员左值字段求值链收口）：非 128 字段
            //   收 128 值（超承载字面量表达式经 638 甲案提升链物化为地址句柄）→
            //   隐式窄化低半（与声明初值/赋值/返回/实参/静态挂点同设施·宿主端
            //   i128→i64 Cast 同款）。本通道=结构体字面量声明位展开的逐字段赋值
            //   （`块 甲 = 块{ 值 = 20位+0 }` 经 解析构造字段赋值们 展开为
            //   成员赋值节点·左末=成员 文本=0 落本函数）——原句柄地址直存字段
            //   槽＝读出地址碎片（探针：输出每次不同的栈地址，应
            //   7766279631452241919=低 64 位截断）。
            值寄存器 = 隐式窄化到64(值寄存器, 指令, 寄存器计数);
            IR追加(指令, 建IR指令(IR_指针存储, 地址寄存器, 值寄存器, 0, 0, 存储宽度, 0));
        }
    }    // 清空表达式栈（右值 残留）
    当 (表达式栈.大小() > 0) {
        结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈.正常) { 运行时错误(4); }
    }
}

// 346-a（2026-09-18 第 346 轮·T57 根治·成员链目标）：成员链左值的容器/用户类
//   对象字段「整体赋值」深拷贝——地址语义与 尝试成员结构体整体写 同款
//   （目标地址=生成左值地址 字段左值地址；NewObject+拷贝构造→IR_指针存储 目标地址）。
//   原实现落标量宽度通道（8 字节 IR_指针存储=句柄浅覆盖）→ 字段与源共享同一堆
//   对象（探针 p6：结构体引用参数的容器字段 `程.表 = 新表` → 宿主 1/7 逐行正确
//   vs v2 大小=垃圾 + 数组越界；被调方局部与父对象双方析构=双释放 UAF）。
//   旧对象释放：父对象**拥有**（容器变量们 / 资源字段名单——与 发射资源字段析构
//   同口径）时释放字段旧对象；借用视图父对象不释放（宁漏勿错）。
不安全 函数 尝试成员对象整体写(向量<节点> 池, 节点 n, 节点 左末,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    如果 (左末.类型 != 节点_成员 || n.子起点 >= n.子终点) { 返回 假; }
    // 346-a 补（类对象字段形态·家族扩散检查 p11）：字段类型统一经 解析节点类型ID
    //   （成员分支递归解析基类型——结构体与**用户类**同布局表；原判定走
    //   解析成员链结构体ID，对类对象返回 0 → 类字段的容器赋值落标量通道=
    //   8 字节浅覆盖，探针 p11 实证：宿主 袋.装.大小=1/首=7 vs v2 大小=0+越界）
    可选<整64> 字段类型查472 = 解析节点类型ID(池, 整32(n.子起点 - 1));
    如果 (!字段类型查472.有值) { 返回 假; }
    整64 字段类型ID = 0; 如果 (字段类型查472.有值) { 字段类型ID = 字段类型查472.值; }
    字符串 字段类型文本 = 字符串复制(驻留文本(字段类型ID));
    // 381 根治（2026-10-10）：**指针形态排除**——按字段**声明类型**直查判星
    //   （查字段类型ID 表存真类型带星·435-b）。解析节点类型ID 的链上剥星
    //   （321 中间跳/362 键基）会把指针字段失真为所指类型——字段类型文本
    //   已无星·排除须走声明类型原文本。带星=句柄槽赋值（标量通道 IR_存储
    //   8 字节直存·234/435-b 指针槽口径）——原失真使「JSON解析器.树: JSON树*」
    //   被当值类深拷（分配 88+拷贝构造「JSON树$JSON树_A_TJSON树」·JSON树
    //   未定义拷贝构造=符号无定义链接失败·669 解析JSON 器.树=树 asm 铁证）。
    {
        节点 父节点381 = 池.元素(整32(左末.子起点));
        如果 (父节点381.类型 == 节点_标识符) {
            整64 父类型ID381 = 解析标识符类型ID(整64(父节点381.文本));
            如果 (父类型ID381 != 0) {
                可选<整64> 声明类型查381 = 查字段类型ID(父类型ID381, 整64(左末.文本));
                如果 (声明类型查381.有值) {
                    整64 声明类型381 = 声明类型查381.值;
                    字符串 声明文本381 = 字符串复制(驻留文本(声明类型381));
                    如果 (字符串长度(声明文本381) > 1 &&
                         (整64(声明文本381[字符串长度(声明文本381) - 1]) & 255) == 42) {
                        返回 假;
