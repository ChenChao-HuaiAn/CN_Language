        }
    }
    // 837-a（自赋值安全·Rust 模式 先克隆后释放）：**新对象+拷贝构造先于释放旧**
    //   ——自赋值（`a.内 = a.内`·V12 形态·目标==源）时源在拷贝阶段仍有效，释放旧
    //   不毁源（免地址比较守卫）。
    整64 对象字节数 = 0;
