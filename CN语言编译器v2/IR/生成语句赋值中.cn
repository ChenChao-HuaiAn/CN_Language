    如果 (对象字节数查.有值) { 对象字节数 = 对象字节数查.值; }
    如果 (字段是容器) { 对象字节数 = 容器对象大小(字段类型文本); }
    整64 新对象reg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新对象reg, 对象字节数, 字段类型ID));
    // 543-d（2026-10-14·与 生成语句赋值 724/288 段同批·728x 分支同步同内容）：
    //   无显式拷贝构造用户类→合成逐位拷贝（指针加载源本体+结构体拷贝）——原恒发
    //   拷贝构造调用，无拷贝构造类=悬空外部 LNK2019（918 同族预防·837-a 字段位）。
    // 1541 B2：无值=无拷贝构造（原 ==0 判据）
    可选<整64> 拷贝查z2 = 查类拷贝构造串(字段类型ID);
    如果 (字段是用户类 && !拷贝查z2.有值) {
        整64 源本体z = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_指针加载, 源地址, 0, 0, 源本体z, T_对象, 0));
        IR追加(指令, 建IR指令(IR_结构体拷贝, 源本体z, 新对象reg, 0, 0,
                             对象字节数, 0));
    } 否则 {
        IR追加(指令, 建IR指令(IR_调用实参, 新对象reg, 0, 0, 0, 0, 0));
        IR追加(指令, 建IR指令(IR_调用实参, 源地址, 0, 0, 0, 1, 0));
        IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                              驻留(方法符号(字段类型文本, 合成名基名(字段类型文本),
                                            字段类型文本 + "&"))));
    }
    如果 (父拥有) {
        整64 旧对象reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_指针加载, 目标地址, 0, 0, 旧对象reg, T_对象, 0));
        // 836-a（层③）：标签唯一序号（同 385·取号+推进）
        整64 删标序2 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_删除对象, 旧对象reg, 0, 0, 删标序2, 0, 字段类型ID));
    }
    IR追加(指令, 建IR指令(IR_指针存储, 目标地址, 新对象reg, 0, 0, T_整64, 0));
    当 (表达式栈.大小() > 0) {
        结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈.正常) { 运行时错误(4); }
    }
    返回 真;
}

