    整64 目标地址 = 生成左值地址(池, 整32(n.附加), n.子起点, 局部槽, 参数槽,
                                指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
    // 源左值地址（引用参数槽内容 / 普通槽地址 / 静态符号地址）
    整64 源槽 = 0;
    如果 (右是标识符) {
        结果<整64, 整32> 找源局 = 局部槽.获取(整64(右末.文本));
        // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
        如果 (找源局.正常) { 源槽 = 找源局.值; } 否则 { }
        如果 (源槽 == 0) {
            结果<整64, 整32> 找源参 = 参数槽.获取(整64(右末.文本));
            // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
            如果 (找源参.正常) { 源槽 = 找源参.值; } 否则 { }
        }
    }
    整64 源地址 = 0;
    如果 (右是成员链) {
        // 837-a：源=成员链——源地址=右链左值地址（`a.内` → &a.内）
        源地址 = 生成左值地址(池, 整32(n.子起点), 整32(n.子终点), 局部槽, 参数槽,
                            指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
    } 否则 {
        源地址 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        如果 (源槽 != 0) {
            如果 (槽是引用(源槽)) {
                IR追加(指令, 建IR指令(IR_加载, 源槽, 0, 0, 源地址, T_对象, 0));
            } 否则 {
                IR追加(指令, 建IR指令(IR_取地址, 源槽, 0, 0, 源地址, T_整64, 0));
            }
        } 否则 {   // 静默豁免业务值: 成员整体赋值静态源分支（局部/参数 miss 后既有回退通道·1360 批5 结果化改锚）
            结果<整64, 整32> 找源静查 = 查静态序号含类(整64(右末.文本));
            // 静默豁免业务值: 静态表 miss=源未解析·交回既有原路径（返假契约·1360 批5 结果化）
            如果 (!找源静查.正常) { 返回 假; }
            整64 找源静 = 找源静查.值;
            IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 源地址, T_对象, 找源静));
        }
    }
    // 父对象拥有判定（容器变量们 / 资源字段名单）
    节点 父节点 = 池.元素(左末.子起点);
    布尔 父拥有 = 假;
    如果 (父节点.类型 == 节点_标识符) {
        整64 父名ID = 整64(父节点.文本);
        如果 (在资源字段名单(函数信息, 父名ID)) { 父拥有 = 真; }
        如果 (!父拥有) {
            整64 名i = 0;
            当 (名i < 函数信息.容器变量们.大小()) {
                如果 (函数信息.容器变量们.元素(名i) == 父名ID) {
