    整64 字段类型ID625b = 0; 如果 (字段类型查625b.有值) { 字段类型ID625b = 字段类型查625b.值; }
    字符串 字段类型文本625b = 字符串复制(驻留文本(字段类型ID625b));
    如果 (!是用户类(字段类型文本625b) || 是容器类(字段类型文本625b)) { 返回 假; }
    如果 (成员字段声明是指针544b(池, 左末)) { 返回 假; }
    字符串 被调文本625b = 字符串复制(驻留文本(整64(被调625b.文本)));
    布尔 是构造625b = 字符串比较(被调文本625b, 字段类型文本625b);
    如果 (!是构造625b) {
        字符串 改写模块625b = "";
        字符串 改写符号625b = "";
        如果 (拆限定名(被调文本625b, 改写模块625b, 改写符号625b) == 1 &&
             字符串比较(改写符号625b, 字段类型文本625b)) {
            是构造625b = 真;
        }
    }
    如果 (!是构造625b) { 返回 假; }
    // ① 源求值（构造调用=NewObject 堆句柄）② 目标字段地址 ③ 旧值释放+入槽
    整64 产物625b = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                               指令, 寄存器计数, &函数信息.块计数, 槽计数,
                               表达式栈);
    如果 (产物625b == 0) {
        IR层诊断("成员构造直存: 右值求值失败(产物reg=0): " + 字段类型文本625b);
        运行时错误(6);
    }
    整64 目标地址625b = 生成左值地址(池, 整32(n.附加), n.子起点, 局部槽, 参数槽,
                                     指令, 寄存器计数, &函数信息.块计数,
                                     槽计数, 表达式栈);
    发射成员拥有旧值释放544b(池, 左末, 目标地址625b, 字段类型ID625b, 指令,
                           函数信息, 寄存器计数);
    如果 (目标地址625b != 0) {
        IR追加(指令, 建IR指令(IR_指针存储, 目标地址625b, 产物625b, 0, 0,
                             T_整64, 0));
    }
    当 (表达式栈.大小() > 0) {
        结果<空类型, 整32> 删栈625b = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈625b.正常) { 运行时错误(4); }
    }
    返回 真;
}

// 922（#925 并入·成员容器字段面·任务922）：成员链左值=**容器字段** ←
//   「返回容器的调用」产物（盒.槽 = 厂.产()·字段=容器）——544b 同根异面
//   （544b 容器守卫 `是容器类` 排除后的残面·922 矩阵 9113 C0000374 实录）。
//   缺陷链与标识符面（赋值接管返回容器调用922）同源：产物=被调方 sret
//   物化到本帧的容器壳栈槽（24B）落标量宽度通道 IR_指针存储 直存字段槽
//   → 块出口父析构级联按堆句柄 free 栈地址=C0000374。宿主=调用产物堆句柄
//   直收（容器标识符位同收=正确基准）。修=922 同款堆物化（NewObject
//   容器对象大小 + CopyStruct 壳）+ 旧值释放（544b 单点共用：父拥有判定
//   容器变量们/资源字段名单·空句柄空安全）+ 地址入槽。
//   判定从严：字段=容器（是容器类_ID）∧ 非指针字段（381/544b 同款声明面
//   排除）∧ 右末=调用 ∧ 是返回容器调用922（返回类型严格等·引用返回/容器
//   元素/构造调用自然排除）。返回 真=已处理；假=非该形态（零行为变更）。
不安全 函数 尝试成员容器返回调用写922(向量<节点> 池, 节点 n, 节点 左末,
                   映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                   函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                   向量<整64>& 表达式栈) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    如果 (左末.类型 != 节点_成员 || n.子起点 >= n.子终点) { 返回 假; }
    如果 (n.子终点 <= n.子起点) { 返回 假; }
    节点 右末922m = 池.元素(n.子终点 - 1);
    如果 (右末922m.类型 != 节点_调用) { 返回 假; }
    可选<整64> 字段类型查922m = 解析节点类型ID(池, 整32(n.子起点 - 1));
    如果 (!字段类型查922m.有值) { 返回 假; }
    整64 字段类型ID922m = 0; 如果 (字段类型查922m.有值) { 字段类型ID922m = 字段类型查922m.值; }
// 字段非容器=非本通道形态（假=落原路径·判定守卫）
    如果 (!是容器类_ID(字段类型ID922m)) { 返回 假; }
    如果 (成员字段声明是指针544b(池, 左末)) { 返回 假; }
// 非「值返回容器调用」形态（假=落原路径·判定守卫）
    如果 (!是返回容器调用922(池, 整64(n.子终点 - 1), 字段类型ID922m)) { 返回 假; }
    整64 对象大小922m = 容器对象大小(字符串复制(驻留文本(字段类型ID922m)));
    如果 (对象大小922m <= 0) { 返回 假; }
    // ① 源求值（单点：产物=被调方 sret 物化壳栈槽地址）
    整64 前深度922m = 表达式栈.大小();
    整64 产物922m = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                               指令, 寄存器计数, &函数信息.块计数, 槽计数,
                               表达式栈);
    如果 (产物922m == 0) {
        IR层诊断("成员容器返回调用接管: 右值求值失败(产物reg=0): " +
                     驻留文本(字段类型ID922m));
        运行时错误(6);
    }
    // ② 堆物化（091 同款：容器壳 → 新堆壳）
    整64 新壳922m = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新壳922m, 对象大小922m,
                         字段类型ID922m));
    IR追加(指令, 建IR指令(IR_结构体拷贝, 产物922m, 新壳922m, 0, 0,
                         对象大小922m, 0));
    // ③ 目标字段地址（纯地址计算）④ 旧值释放（父拥有·544b 单点共用）
    整64 目标地址922m = 生成左值地址(池, 整32(n.附加), n.子起点, 局部槽, 参数槽,
                                     指令, 寄存器计数, &函数信息.块计数,
                                     槽计数, 表达式栈);
    发射成员拥有旧值释放544b(池, 左末, 目标地址922m, 字段类型ID922m, 指令,
                           函数信息, 寄存器计数);
    // ⑤ 堆句柄入槽
    如果 (目标地址922m != 0) {
        IR追加(指令, 建IR指令(IR_指针存储, 目标地址922m, 新壳922m, 0, 0,
                             T_整64, 0));
    }
    表达式栈弹到深度(表达式栈, 前深度922m);
    返回 真;
}
