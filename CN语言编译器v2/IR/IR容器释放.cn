// CN 自举编译器 v2：容器类型 IR 辅助（自举重建 P7b，2026-09-01）
// 容器类型（向量/映射/链表/栈/队列/集合/结果）类型判定、对象大小表、
// 方法签名表——IR生成.cn 的容器实例化/方法调用据此合成宿主对齐符号
// （类$方法#参数串 → nameMangle，实现链接宿主编译 obj，rustc 预编译 std 模式）。
// 契约对标：宿主 generics.cpp（实例名 类名$实参 扁平 $ 连接）、semantic.cpp
//   signatureKey（方法名#参数类型1,参数类型2）、stdlib 容器.cn/映射集合.cn
//   （方法签名与字段布局）。
// 依赖说明：IR_* 操作码/T_* 类型码/常量表 由 IR常量.cn 定义（簇① A2 单一归属）；
//   IR 指令/函数 IR 数据结构（IR指令/函数IR 结构体）自 呈报①A 根治（2026-09-05）
//   起定义在本模块（见下）——原定义在 IR生成.cn 顶层，而本模块引用它 + IR生成
//   导入本模块 = 反向引用不可导；主链靠多文件合并全局可见掩盖，冒烟子链
//   （IR容器/语法分析/语义分析 入口——链上无 IR生成.cn）结构体登记缺失 ->
//   解析方法对象类型 查结构体大小 miss = 「方法调用的对象类型未知」误诊
//   （冒烟 asm 断供；曾误归因 IR常量.cn 新增常量对，实为登记源结构性缺失）。
导入 容器::向量;
导入 映射集合;
导入 IR;         // 签名辅助 + 节点_*/T_*/IR_*/键位移/当前函数变量类型（原 IR签名+IR常量 合并目录包名）

公开:
// D1 行数整改 124-a：自 IR容器.cn 按族拆出——资源字段释放与 RAII 析构（发射资源字段释放于地址 + 发射串字段清旧 + 发射串字段深拷 + 发射结构体整体拷贝 + 在资源字段名单 + 发射资源字段析构 + 发射数组串元素释放 + 块出口析构 + 循环跳出析构 + 发射数组串释放全部 + 名单追加去重 + 预扫容器声明 + 发射容器析构 + 发射字符串释放）（纯重构零行为变更）

// ==================== 容器声明预扫与 RAII（P7b） ====================
// ②c B：含容器字段结构体局部 [起, 止) 的字段逆序级联析构（指针槽模型：取基槽地址
//   -> 字段地址 -> 指针加载 -> DeleteObject——空安全，裸声明零初始化保证跳过）。
//   局部逆序 + 字段逆序（后声明先释放）。局部声明在 生成语句 B1 分支登记。
// 79-a（2026-09-12 第七十九轮）：资源字段于地址释放——按字段类型分派：
//   字符串字段 -> __cn_str_free(字段句柄) + 字段槽清零（幂等：多释放点共享槽）；
//   含资源字段的嵌套结构体 -> 递归（字段内联存储，基址=该字段地址）；
//   容器字段 -> 指针槽模型（LoadPtr -> 元素串释放 -> DeleteObject）+ 清槽。
//   与宿主 emitOwnedStrFieldFreesAt / emitFieldStringFreeAt 同构
//   （plans/020 移植纪律 7/8：机制主体+不变量 ①释放+清槽幂等；深度上限 4 防环）。
不安全 函数 发射资源字段释放于地址(函数IR& 函数信息, 整64* 寄存器计数,
                            整64 结构体ID, 整64 基址reg, 整64 深度) -> 空类型 {
    如果 (深度 > 4) { 返回; }
    // 79-a 特例：结果/可选（内置合成布局，非用户结构体）——值字段为字符串时
    //   条件释放：值/错误 共用联合体偏移（值@4/8，错误同槽），非「正常/有值」
    //   分支下值位是错误码整数（free 整数指针=崩）——与宿主 emitFieldStringFreeIf
    //   同构（IR 条件分支，零运行时辅助）。
    字符串 类型文本r = 字符串复制(驻留文本(结构体ID));
    如果 (是结果类型(类型文本r)) {
        字符串 值类型r = 段首(合成名首实参(类型文本r));
        如果 (字符串比较(值类型r, "字符串")) {
            整64 值偏移r = 结果值偏移("字符串");
            整64 条件地址 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_字段地址, 基址reg, 0, 0, 条件地址, T_整64, 0));
            整64 条件reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_指针加载, 条件地址, 0, 0, 条件reg, T_整32, 0));
            整64 释放块 = 新块(函数信息);
            整64 汇合块 = 新块(函数信息);
            发射条件跳转(函数信息, 条件reg, 释放块, 汇合块);
            切换块(函数信息, 释放块);
            发射块标签(函数信息, 释放块);
            整64 值地址r = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_字段地址, 基址reg, 0, 0, 值地址r, T_整64, 值偏移r));
            整64 值regr = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_指针加载, 值地址r, 0, 0, 值regr, T_字符串, 0));
            IR追加(函数信息.指令, 建IR指令(IR_调用实参, 值regr, 0, 0, 0, 0, 0));
            IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                 驻留("__cn_str_free")));
            如果 (函数信息.零寄存器 != 0) {
                IR追加(函数信息.指令, 建IR指令(IR_指针存储, 值地址r,
                                     函数信息.零寄存器, 0, 0, T_整64, 0));
            }
            发射跳转(函数信息, 汇合块);
            切换块(函数信息, 汇合块);
            发射块标签(函数信息, 汇合块);
        }
        返回;
    }
    向量<整64> 字段们 = 向量<整64>();
    取资源字段们(结构体ID, 字段们);
    整64 f = 字段们.大小();
    当 (f > 0) {
        f -= 3;
        整64 字段类型ID = 字段们.元素(f + 1);
        整64 偏移 = 字段们.元素(f + 2);
        // 73-a：字段地址另存 地址reg（加载会把值寄存器指向对象，清零须回写
        //   字段槽本身）——释放+清零幂等模型
        整64 地址reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(函数信息.指令, 建IR指令(IR_字段地址, 基址reg, 0, 0, 地址reg, T_整64, 偏移));
        如果 (字符串比较(驻留文本(字段类型ID), "字符串")) {
            整64 串reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_指针加载, 地址reg, 0, 0, 串reg, T_字符串, 0));
            IR追加(函数信息.指令, 建IR指令(IR_调用实参, 串reg, 0, 0, 0, 0, 0));
            IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                 驻留("__cn_str_free")));
            如果 (函数信息.零寄存器 != 0) {
                IR追加(函数信息.指令, 建IR指令(IR_指针存储, 地址reg,
                                     函数信息.零寄存器, 0, 0, T_整64, 0));
            }
        } 否则 如果 (是数组类型文本(字符串复制(驻留文本(字段类型ID))) &&
                      字符串比较(数组元素文本(字符串复制(驻留文本(字段类型ID))),
                                "字符串")) {
            // 99-a（C11）：**字符串数组字段**——逐元素释放（字段地址=数组基址；
            //   基址 + i×元素步进 -> 指针加载 -> __cn_str_free -> 清槽幂等模型）
            字符串 字段文本99 = 字符串复制(驻留文本(字段类型ID));
            整64 长度99 = 数组长度文本(字段文本99);
            整64 步进99 = 数组元素步进(字段文本99);
            整64 序99 = 0;
            当 (序99 < 长度99) {
                整64 元素地址99 = 地址reg;
                如果 (序99 > 0) {
                    整64 偏移常量99 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(函数信息.指令, 建IR指令(IR_常量整数,
                          整64(驻留(整数转字符串(序99 * 步进99))), 0, 0,
                          偏移常量99, T_整64, 0));
                    整64 元素地址新99 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(函数信息.指令, 建IR指令(IR_加, 地址reg, 偏移常量99,
                          0, 元素地址新99, T_整64, 0));
                    元素地址99 = 元素地址新99;
                }
                整64 元素reg99 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(函数信息.指令, 建IR指令(IR_指针加载, 元素地址99, 0, 0,
                      元素reg99, T_字符串, 0));
                IR追加(函数信息.指令, 建IR指令(IR_调用实参, 元素reg99, 0, 0, 0, 0, 0));
                IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                      驻留("__cn_str_free")));
                如果 (函数信息.零寄存器 != 0) {
                    IR追加(函数信息.指令, 建IR指令(IR_指针存储, 元素地址99,
                          函数信息.零寄存器, 0, 0, T_整64, 0));
                }
                序99++;
            }
        } 否则 如果 (是数组类型文本(字符串复制(驻留文本(字段类型ID))) &&
                      查结构体类型(驻留(数组元素文本(
                          字符串复制(驻留文本(字段类型ID))))) != 0) {
            // 100-a（C12）：**字段数组元素=结构体（含资源字段）**——逐元素递归
            //   释放其字段（元素地址 = 字段基址 + i×元素步进 -> 发射资源字段
            //   释放于地址(元素结构体, 元素地址, 深度+1)）
            字符串 字段文本12 = 字符串复制(驻留文本(字段类型ID));
            整64 元素文本ID12 = 驻留(数组元素文本(字段文本12));
            整64 长度12 = 数组长度文本(字段文本12);
            整64 步进12 = 数组元素步进(字段文本12);
            整64 序12 = 0;
            当 (序12 < 长度12) {
                整64 元素地址12 = 地址reg;
                如果 (序12 > 0) {
                    整64 偏移常量12 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(函数信息.指令, 建IR指令(IR_常量整数,
                          整64(驻留(整数转字符串(序12 * 步进12))), 0, 0,
                          偏移常量12, T_整64, 0));
                    整64 元素地址新12 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(函数信息.指令, 建IR指令(IR_加, 地址reg, 偏移常量12,
                          0, 元素地址新12, T_整64, 0));
                    元素地址12 = 元素地址新12;
                }
                发射资源字段释放于地址(函数信息, 寄存器计数, 元素文本ID12,
                                    元素地址12, 深度 + 1);
                序12++;
            }
        } 否则 如果 (资源字段数(字段类型ID) > 0) {
            // 嵌套含资源字段的结构体（值语义内联）——递归释放其字段
            发射资源字段释放于地址(函数信息, 寄存器计数, 字段类型ID, 地址reg,
                                深度 + 1);
        } 否则 如果 (查结构体大小(字段类型ID) > 0) {
            // 84-e：**纯标量结构体字段**（值语义内联、无堆资源）→ 跳过。
            //   原实现落下方「容器路径」：IR_指针加载(值当对象指针) + 发射容器元素
            //   释放 + **IR_删除对象**（生成 `call 类型$~类型`）→ 缺符号链接失败
            //   （E2E 190 `点$~点` / 241 `深B$~深B` 实证）。结构体字段=内联值，
            //   释放义务归其自身字段（无资源字段即无义务）。
        } 否则 {
            整64 基址reg2 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_指针加载, 地址reg, 0, 0, 基址reg2, T_对象, 0));
            // 74-a：容器字段元素串释放（宿主 emitContainerElemFreeFor 同款；
            //   与局部容器同一释放模型——plans/020 移植纪律 8 三路径对称核对）
            发射容器元素释放(函数信息, 寄存器计数, 基址reg2, 字段类型ID);
            IR追加(函数信息.指令, 建IR指令(IR_删除对象, 基址reg2, 0, 0,
                                                 寄存器计数[0], 0, 字段类型ID));
            寄存器计数[0] = 寄存器计数[0] + 1;
            如果 (函数信息.零寄存器 != 0) {
                IR追加(函数信息.指令, 建IR指令(IR_指针存储, 地址reg,
                                     函数信息.零寄存器, 0, 0, T_整64, 0));
            }
        }
    }
}

// 79-a（2026-09-12 第七十九轮）：串字段清旧（preFree）——目标聚合的字符串字段
//   逐字段 free+清槽（含嵌套结构体递归）。调用点=整体拷贝前（memcpy 会覆盖目标
//   槽，旧句柄必须先释放；未初始化槽=0 空安全）。仅串字段（容器字段非本面）。
不安全 函数 发射串字段清旧(函数IR& 函数信息, 整64* 寄存器计数,
                   整64 基址reg, 整64 结构体ID, 整64 深度) -> 空类型 {
    如果 (深度 > 4) { 返回; }
    向量<整64> 字段们 = 向量<整64>();
    取资源字段们(结构体ID, 字段们);
    整64 f = 字段们.大小();
    当 (f > 0) {
        f -= 3;
        整64 字段类型ID = 字段们.元素(f + 1);
        整64 偏移 = 字段们.元素(f + 2);
        整64 地址reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(函数信息.指令, 建IR指令(IR_字段地址, 基址reg, 0, 0, 地址reg, T_整64, 偏移));
        如果 (字符串比较(驻留文本(字段类型ID), "字符串")) {
            整64 串reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_指针加载, 地址reg, 0, 0, 串reg, T_字符串, 0));
            IR追加(函数信息.指令, 建IR指令(IR_调用实参, 串reg, 0, 0, 0, 0, 0));
            IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                 驻留("__cn_str_free")));
            如果 (函数信息.零寄存器 != 0) {
                IR追加(函数信息.指令, 建IR指令(IR_指针存储, 地址reg,
                                     函数信息.零寄存器, 0, 0, T_整64, 0));
            }
        } 否则 如果 (是数组类型文本(字符串复制(驻留文本(字段类型ID))) &&
                      字符串比较(数组元素文本(字符串复制(驻留文本(字段类型ID))),
                                "字符串")) {
            // 99-a（C11）：**字符串数组字段**——逐元素释放（字段地址=数组基址；
            //   基址 + i×元素步进 -> 指针加载 -> __cn_str_free -> 清槽幂等模型）
            字符串 字段文本99 = 字符串复制(驻留文本(字段类型ID));
            整64 长度99 = 数组长度文本(字段文本99);
            整64 步进99 = 数组元素步进(字段文本99);
            整64 序99 = 0;
            当 (序99 < 长度99) {
                整64 元素地址99 = 地址reg;
                如果 (序99 > 0) {
                    整64 偏移常量99 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(函数信息.指令, 建IR指令(IR_常量整数,
                          整64(驻留(整数转字符串(序99 * 步进99))), 0, 0,
                          偏移常量99, T_整64, 0));
                    整64 元素地址新99 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(函数信息.指令, 建IR指令(IR_加, 地址reg, 偏移常量99,
                          0, 元素地址新99, T_整64, 0));
                    元素地址99 = 元素地址新99;
                }
                整64 元素reg99 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(函数信息.指令, 建IR指令(IR_指针加载, 元素地址99, 0, 0,
                      元素reg99, T_字符串, 0));
                IR追加(函数信息.指令, 建IR指令(IR_调用实参, 元素reg99, 0, 0, 0, 0, 0));
                IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                      驻留("__cn_str_free")));
                如果 (函数信息.零寄存器 != 0) {
                    IR追加(函数信息.指令, 建IR指令(IR_指针存储, 元素地址99,
                          函数信息.零寄存器, 0, 0, T_整64, 0));
                }
                序99++;
            }
        } 否则 如果 (是数组类型文本(字符串复制(驻留文本(字段类型ID))) &&
                      查结构体类型(驻留(数组元素文本(
                          字符串复制(驻留文本(字段类型ID))))) != 0) {
            // 100-a（C12）：**字段数组元素=结构体（含资源字段）**——逐元素递归
            //   释放其字段（元素地址 = 字段基址 + i×元素步进 -> 发射资源字段
            //   释放于地址(元素结构体, 元素地址, 深度+1)）
            字符串 字段文本12 = 字符串复制(驻留文本(字段类型ID));
            整64 元素文本ID12 = 驻留(数组元素文本(字段文本12));
            整64 长度12 = 数组长度文本(字段文本12);
            整64 步进12 = 数组元素步进(字段文本12);
            整64 序12 = 0;
            当 (序12 < 长度12) {
                整64 元素地址12 = 地址reg;
                如果 (序12 > 0) {
                    整64 偏移常量12 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(函数信息.指令, 建IR指令(IR_常量整数,
                          整64(驻留(整数转字符串(序12 * 步进12))), 0, 0,
                          偏移常量12, T_整64, 0));
                    整64 元素地址新12 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(函数信息.指令, 建IR指令(IR_加, 地址reg, 偏移常量12,
                          0, 元素地址新12, T_整64, 0));
                    元素地址12 = 元素地址新12;
                }
                发射资源字段释放于地址(函数信息, 寄存器计数, 元素文本ID12,
                                    元素地址12, 深度 + 1);
                序12++;
            }
        } 否则 如果 (资源字段数(字段类型ID) > 0) {
            发射串字段清旧(函数信息, 寄存器计数, 地址reg, 字段类型ID, 深度 + 1);
        } 否则 如果 (查结构体大小(字段类型ID) > 0) {
            // 84-e：纯标量结构体字段（内联值、无串字段）→ 无可清旧
        }
    }
}

// 79-a：串字段深拷（postCopy）——memcpy 之后把目标串字段句柄替换为独立副本
//   （__cn_str_copy 落堆）：目标独立拥有、源保持拥有（值语义拷贝；Rust Clone
//   由编译器代写）。先复制后写（目标旧句柄已由 preFree 释放或为 memcpy 传入的
//   源句柄——不得再 free）。含嵌套结构体递归。
不安全 函数 发射串字段深拷(函数IR& 函数信息, 整64* 寄存器计数,
                   整64 目标基址, 整64 源基址, 整64 结构体ID, 整64 深度) -> 空类型 {
    如果 (深度 > 4) { 返回; }
    向量<整64> 字段们 = 向量<整64>();
    取资源字段们(结构体ID, 字段们);
    整64 f = 字段们.大小();
    当 (f > 0) {
        f -= 3;
        整64 字段类型ID = 字段们.元素(f + 1);
        整64 偏移 = 字段们.元素(f + 2);
        如果 (字符串比较(驻留文本(字段类型ID), "字符串")) {
            整64 源地址c = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_字段地址, 源基址, 0, 0, 源地址c, T_整64, 偏移));
            整64 目标地址c = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_字段地址, 目标基址, 0, 0, 目标地址c, T_整64, 偏移));
            整64 源值c = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_指针加载, 源地址c, 0, 0, 源值c, T_字符串, 0));
            整64 副本c = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_调用实参, 源值c, 0, 0, 0, 0, 0));
            IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 1, 0, 0, 副本c, 0,
                                 驻留("__cn_str_copy")));
            登记寄存器类型(副本c, T_字符串);
            IR追加(函数信息.指令, 建IR指令(IR_指针存储, 目标地址c, 副本c, 0, 0, T_整64, 0));
        } 否则 如果 (资源字段数(字段类型ID) > 0) {
            // 86-a：递归分支必须在「结构体跳过」**之前**——含串结构体同时满足
            //   「查结构体大小>0」与「资源字段数>0」，守卫若在前则递归恒不可达
            //   （84-e 插入顺序错误，P42 实证：嵌套整体赋值深拷失效 → 悬垂乱码）。
            //   与 发射资源字段释放于地址 / 发射串字段清旧 两处同序（资源字段判定在前）。
            整64 源内 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_字段地址, 源基址, 0, 0, 源内, T_整64, 偏移));
            整64 目标内 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_字段地址, 目标基址, 0, 0, 目标内, T_整64, 偏移));
            发射串字段深拷(函数信息, 寄存器计数, 目标内, 源内, 字段类型ID, 深度 + 1);
        } 否则 如果 (查结构体大小(字段类型ID) > 0) {
            // 84-e：纯标量结构体字段（内联值、无串字段）→ 无深拷义务
        }
    }
}

// 79-a：结构体整体拷贝（含串字段深拷）——preFree（先释放=真）+ memcpy + 深拷
//   （深拷=真）。深拷=假 用于「调用返回来源（retbuf）接管」：句柄唯一持有者转为
//   目标（被调方返回移出已跳过释放），零拷贝 move 语义。无资源字段类型零开销
//   （memcpy 与既有行为一致）。
不安全 函数 发射结构体整体拷贝(函数IR& 函数信息, 整64* 寄存器计数,
                      整64 目标地址, 整64 源地址, 整64 结构体ID,
                      布尔 深拷, 布尔 先释放) -> 空类型 {
    如果 (先释放) { 发射串字段清旧(函数信息, 寄存器计数, 目标地址, 结构体ID, 0); }
    IR追加(函数信息.指令, 建IR指令(IR_结构体拷贝, 源地址, 目标地址, 0, 0,
                         查结构体大小(结构体ID), 0));
    如果 (深拷) { 发射串字段深拷(函数信息, 寄存器计数, 目标地址, 源地址, 结构体ID, 0); }
}

// 资源字段名单是否含该局部（写入位 preFree 判据：仅拥有槽可释放旧字段值）
函数 在资源字段名单(函数IR& 函数信息, 整64 名ID) -> 布尔 {
    整64 i = 0;
    当 (i < 函数信息.资源字段局部们.大小()) {
        如果 (函数信息.资源字段局部们.元素(i) == 名ID) { 返回 真; }
        i++;
    }
    返回 假;
}

// ②c B（79-a 扩容）：含资源字段结构体局部 [起, 止) 的字段逆序级联析构
//   （字符串字段 free+清槽 / 容器字段 DeleteObject / 嵌套递归）。局部逆序 +
//   字段逆序（后声明先释放）。局部声明在 生成语句 B1 分支登记；
//   被返回的局部（跳过名ID）跳过释放=所有权转移给调用方（Rust move 出）。
不安全 函数 发射资源字段析构(函数IR& 函数信息, 映射<整64, 整64>& 局部槽, 整64* 寄存器计数,
                       整64 起, 整64 止, 整64 跳过名ID) -> 空类型 {
    整64 i = 止;
    当 (i > 起) {
        i--;
        整64 名ID = 函数信息.资源字段局部们.元素(i);
        // 2026-09-06 根治（T6 自举首踩）：返回语句所有权转移——被返回的含容器
        //   字段局部跳过析构（返回值已浅拷入 retbuf 共享堆指针，再析构=悬垂）
        如果 (名ID == 跳过名ID) { 继续; }
        // 79-a：入容器共享源（元素浅拷共享字段串——元素字段释放面未开=靶子）
        //   跳过字段串释放（否则元素悬垂；宁漏勿错，泄漏维持既有边界）。
        //   读镜像 当前串污染们（登记侧同经镜像——生成方法调用 作用域无 函数IR）
        如果 (是当前串污染(名ID)) { 继续; }
        整64 结构体ID = 函数信息.资源字段结构体们.元素(i);
        整64 槽 = 0;
        结果<整64, 整32> 找槽 = 局部槽.获取(名ID);
        如果 (找槽.正常) { 槽 = 找槽.值; }
        如果 (槽 != 0) {
            整64 基址reg0 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_取地址, 槽, 0, 0, 基址reg0, T_整64, 0));
            发射资源字段释放于地址(函数信息, 寄存器计数, 结构体ID, 基址reg0, 0);
        }
    }
}

// 块级作用域出口析构（用户裁决项2，生成块 调用）：对 容器变量们 在 基线 之后
//   新增的容器（本块声明的，逆序）发 RAII 析构并截断列表——块结束即释放；
//   ②c B：含容器字段结构体局部同款（字段基线 截断）。
//   plans/019 阶段4' 第二批：字符串基线同款——本块新增的拥有型字符串逆序
//   __cn_str_free 并截断（污染名跳过；块结束即释放——Rust 作用域 drop）。
// 73-a（2026-09-11 方案A 用户裁决）：新增 截断 参数——块出口（生成块）传 真
//   （释放并截断名单，保证外层块基线机制正确）；循环跳出 drop-on-jump 传 假
//   （同一块内的其他路径仍须发射自己的释放指令：如循环体内「如果{中断}」的
//   中断路径与自然结束路径互斥，若跳出时就截断名单，自然结束路径的块出口
//   析构将无变量可释放=该路径泄漏）。不截断模式下遍历用下标递减（不以名单
//   长度作循环条件，避免死循环）。
// 98-a（C9）：字符串元素数组释放发射——编译期展开逐元素（长度已知）：
//   元素地址 = 基址 + i×元素步进 → IR_指针加载(T_字符串) → __cn_str_free →
//   元素槽清零（释放+清零幂等模型：块出口/跳出/函数尾多路径共享数组区，重复
//   经过的释放点对已清零槽空安全跳过）。
不安全 函数 发射数组串元素释放(函数IR& 函数信息, 映射<整64, 整64>& 局部槽,
                        整64* 寄存器计数, 整64 名ID) -> 空类型 {
    整64 类型IDa = 查当前函数变量类型(名ID);
    如果 (类型IDa < 0) { 返回; }
    字符串 类型文本a = 字符串复制(驻留文本(类型IDa));
    如果 (!是数组类型文本(类型文本a)) { 返回; }
    字符串 元素文本a = 数组元素文本(类型文本a);
    如果 (!字符串比较(元素文本a, "字符串")) { 返回; }
    整64 长度a = 数组长度文本(类型文本a);
    整64 步进a = 数组元素步进(类型文本a);
    如果 (长度a <= 0 || 步进a <= 0) { 返回; }
    整64 基址槽a = 0;
    结果<整64, 整32> 找槽a = 局部槽.获取(名ID);
    如果 (找槽a.正常) { 基址槽a = 找槽a.值; }
    如果 (基址槽a == 0) { 返回; }
    整64 基址寄存器a = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(函数信息.指令, 建IR指令(IR_取地址, 基址槽a, 0, 0, 基址寄存器a,
                                  T_整64, 0));
    整64 元素序a = 0;
    当 (元素序a < 长度a) {
        整64 元素地址a = 基址寄存器a;
        如果 (元素序a > 0) {
            整64 偏移常量a = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_常量整数,
                  整64(驻留(整数转字符串(元素序a * 步进a))), 0, 0,
                  偏移常量a, T_整64, 0));
            整64 元素地址新a = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_加, 基址寄存器a, 偏移常量a, 0,
                  元素地址新a, T_整64, 0));
            元素地址a = 元素地址新a;
        }
        整64 句柄寄存器a = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(函数信息.指令, 建IR指令(IR_指针加载, 元素地址a, 0, 0,
              句柄寄存器a, T_字符串, 0));
        IR追加(函数信息.指令, 建IR指令(IR_调用实参, 句柄寄存器a, 0, 0, 0, 0, 0));
        IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
              驻留("__cn_str_free")));
        如果 (函数信息.零寄存器 != 0) {
            IR追加(函数信息.指令, 建IR指令(IR_指针存储, 元素地址a,
                  函数信息.零寄存器, 0, 0, T_字符串, 0));
        }
        元素序a++;
    }
}

不安全 函数 块出口析构(函数IR& 函数信息, 映射<整64, 整64>& 局部槽, 整64* 寄存器计数,
                整64 作用域基线, 整64 字段基线, 整64 字符串基线,
                整64 数组串基线, 布尔 截断) -> 空类型 {
    整64 串i = 函数信息.字符串变量们.大小();
    当 (串i > 字符串基线) {
        串i--;
        整64 串名ID = 函数信息.字符串变量们.元素(串i);
        结果<整64, 整32> 查污出 = 函数信息.字符串污染们.获取(串名ID);
        如果 (!查污出.正常 && !是已装箱名(串名ID)) {   // 71-a：装箱=move 转交跳过
            整64 串槽 = 0;
            结果<整64, 整32> 找串槽 = 局部槽.获取(串名ID);
            如果 (找串槽.正常) { 串槽 = 找串槽.值; } 否则 { 串槽 = 0; }
            如果 (串槽 != 0) {
                整64 串ptr = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(函数信息.指令, 建IR指令(IR_加载, 串槽, 0, 0, 串ptr, T_字符串, 0));
                IR追加(函数信息.指令, 建IR指令(IR_调用实参, 串ptr, 0, 0, 0, 0, 0));
                IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                     驻留("__cn_str_free")));
                // 73-a（幂等模型，宿主 72-a 同款）：释放后槽清零——块出口/跳出/
                //   函数级兜底多路径共享槽，清零后 __cn_str_free(nullptr) 空安全，
                //   重复经过的释放点不再二次释放（探针：容器跳出形态未清零时
                //   跳出释放 + 函数级兜底 = double free SIGSEGV 实证）
                如果 (函数信息.零寄存器 != 0) {
                    IR追加(函数信息.指令, 建IR指令(IR_存储, 函数信息.零寄存器, 0, 0,
                                         0, 0, 串槽));
                }
            }
        }
        如果 (截断) {
            结果<空类型, 整32> 删串 = 函数信息.字符串变量们.删除(
                函数信息.字符串变量们.大小() - 1);
            如果 (!删串.正常) { 运行时错误(4); }
        }
    }
    整64 容i = 函数信息.容器变量们.大小();
    当 (容i > 作用域基线) {
        容i--;
        整64 名ID = 函数信息.容器变量们.元素(容i);
        整64 槽 = 0;
        结果<整64, 整32> 找槽 = 局部槽.获取(名ID);
        如果 (找槽.正常) { 槽 = 找槽.值; }
        如果 (槽 != 0 && !是已装箱名(名ID)) {   // 71-a：装箱=move 转交跳过
            结果<整64, 整32> 查类型 = 函数信息.变量类型.获取(名ID);
            如果 (查类型.正常) {
                整64 ptr寄存器 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(函数信息.指令, 建IR指令(IR_加载, 槽, 0, 0, ptr寄存器, T_对象, 0));
                // 74-a（2026-09-11 第七十四轮）：容器元素串释放——容器拥有元素
                //   所有权（入容器位编译器接管），析构前逐元素释放（宿主
                //   emitContainerElemFreeFor 同款；原 v2 无此机制=容器元素串
                //   永不释放，探针 74-G 实证残留 2）。释放后元素槽清零在运行时
                //   辅助内完成（幂等不变量，与宿主共享同一运行时）。顺序=先元素
                //   后对象（宿主同序：元素数组先释放，再 DeleteObject 释放容器）。
                发射容器元素释放(函数信息, 寄存器计数, ptr寄存器, 查类型.值);
                IR追加(函数信息.指令, 建IR指令(IR_删除对象, ptr寄存器, 0, 0,
                                                     寄存器计数[0], 0, 查类型.值));
                寄存器计数[0] = 寄存器计数[0] + 1;
                // 73-a（幂等模型）：释放后槽清零（IR_删除对象 空安全——
                //   代码生成 test/je 跳过；多释放点共享槽不再二次释放）
                如果 (函数信息.零寄存器 != 0) {
                    IR追加(函数信息.指令, 建IR指令(IR_存储, 函数信息.零寄存器, 0, 0,
                                         0, 0, 槽));
                }
            }
        }
        如果 (截断) {
            结果<空类型, 整32> 删容 = 函数信息.容器变量们.删除(
                函数信息.容器变量们.大小() - 1);
            如果 (!删容.正常) { 运行时错误(4); }
        }
    }
    // 98-a（C9）：字符串元素数组——逐元素释放（逆序，与容器/字符串名单同序纪律）
    如果 (函数信息.字符串数组变量们.大小() > 数组串基线) {
        整64 数组i98 = 函数信息.字符串数组变量们.大小();
        当 (数组i98 > 数组串基线) {
            数组i98--;
            发射数组串元素释放(函数信息, 局部槽, 寄存器计数,
                              函数信息.字符串数组变量们.元素(数组i98));
            如果 (截断) {
                结果<空类型, 整32> 删数组98 = 函数信息.字符串数组变量们.删除(
                    函数信息.字符串数组变量们.大小() - 1);
                如果 (!删数组98.正常) { 运行时错误(4); }
            }
        }
    }
    如果 (函数信息.资源字段局部们.大小() > 字段基线) {
        发射资源字段析构(函数信息, 局部槽, 寄存器计数, 字段基线,
                          函数信息.资源字段局部们.大小(), 0);
        // 截断两条跟踪列表至基线（跳出模式不截断——同块其他路径仍须发射释放）
        如果 (截断) {
            当 (函数信息.资源字段局部们.大小() > 字段基线) {
                结果<空类型, 整32> 删局 = 函数信息.资源字段局部们.删除(
                    函数信息.资源字段局部们.大小() - 1);
                如果 (!删局.正常) { 运行时错误(4); }
                结果<空类型, 整32> 删构 = 函数信息.资源字段结构体们.删除(
                    函数信息.资源字段结构体们.大小() - 1);
                如果 (!删构.正常) { 运行时错误(4); }
            }
        }
    }
}

// 73-a（2026-09-11 方案A 用户裁决）：循环跳出（中断/继续）drop-on-jump——
//   按最近循环体的三个基线（生成当 进入体块前记录）释放本轮已声明资源，
//   编译期名单**不截断**。与宿主 72-a genJumpDestructFrom(stringBase, classBase)
//   同构（Rust：break/continue 前 drop 当前作用域内已初始化值）。
不安全 函数 循环跳出析构(函数IR& 函数信息, 映射<整64, 整64>& 局部槽,
                  整64* 寄存器计数) -> 空类型 {
    块出口析构(函数信息, 局部槽, 寄存器计数,
               函数信息.循环容基线, 函数信息.循环字段基线, 函数信息.循环串基线,
               函数信息.循环数组串基线, 假);
}

// 98-a（C9）：字符串元素数组**全量**释放（函数返回路径——与 发射字符串释放
//   名 0=全释放 同款纪律：遍历全部名单逆序逐元素释放）
不安全 函数 发射数组串释放全部(函数IR& 函数信息, 映射<整64, 整64>& 局部槽,
                        整64* 寄存器计数) -> 空类型 {
    整64 序98 = 函数信息.字符串数组变量们.大小();
    当 (序98 > 0) {
        序98--;
        发射数组串元素释放(函数信息, 局部槽, 寄存器计数,
                          函数信息.字符串数组变量们.元素(序98));
    }
}

// 释放名单追加去重（73-a）：生成期登记可能与已有项同名（v2 局部槽为函数级
//   映射，同名变量合槽；预扫 已有 判定同款）——重复登记会导致同名多次释放。
函数 名单追加去重(向量<整64>& 名单, 整64 名ID) -> 空类型 {
    整64 i = 0;
    当 (i < 名单.大小()) {
        如果 (名单.元素(i) == 名ID) { 返回; }
        i++;
    }
    结果<空类型, 整32> 加 = 名单.追加(名ID);
    如果 (!加.正常) { 运行时错误(4); }
}

// 预扫容器声明：函数体块区间一次线性扫描（嵌套块/条件体语句节点均含于函数体块
//   子区间——节点池顺序追加，体块节点最后入池），为全部容器变量：分配槽 +
//   入口零初始化（未执行声明路径的槽=确定性空指针，DeleteObject 空安全跳过）+
//   登记 变量类型/容器变量们。注：同名变量（不同块）合并同槽（v2 局部槽为
//   函数级映射——精确块级作用域析构留 P7c）。
不安全 函数 预扫容器声明(向量<节点> 池, 整32 块节点, 函数IR& 函数信息,
                  整64* 槽计数, 整64* 寄存器计数) -> 空类型 {
    整64 零寄存器 = 0;
    节点 块 = 池.元素(块节点);
    整64 i = 整64(块.子起点);
    当 (i < 整64(块.子终点)) {
        节点 声明 = 池.元素(整32(i));
        如果 (声明.类型 == 节点_变量声明) {
            节点 类型节点 = 池.元素(整32(声明.附加));
            字符串 类型文本 = 字符串复制(驻留文本(整64(类型节点.文本)));
            // 引用局部（2026-09-04 IR生成.cn 冒烟根治）：绑定不拥有——槽分配/
            //   绑定存储/引用槽登记由 生成语句 引用分支自管；此处若入 RAII 名单
            //   =返回前对绑定对象（字段地址当 this）双重析构（E2E 147 探针
            //   0xC0000374 堆损坏实证）。
            如果 (是容器类(类型文本) && 类型节点.附加 != 256) {
                结果<整64, 整32> 已有 = 函数信息.局部槽.获取(整64(声明.文本));
                如果 (!已有.正常) {
                    整64 槽 = 槽计数[0];
                    槽计数[0] = 槽计数[0] + 1;
                    结果<空类型, 整32> 设槽 = 函数信息.局部槽.设置(整64(声明.文本), 槽);
                    如果 (!设槽.正常) { 运行时错误(4); }
                    IR追加(函数信息.指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽));
                    // 入口零初始化（共享一个零寄存器）
                    如果 (零寄存器 == 0) {
                        零寄存器 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(函数信息.指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0,
                                             零寄存器, T_整64, 0));
                    }
                    IR追加(函数信息.指令, 建IR指令(IR_存储, 零寄存器, 0, 0, 0, 0, 槽));
                    结果<空类型, 整32> 设类型 = 函数信息.变量类型.设置(整64(声明.文本),
                                                              整64(类型节点.文本));
                    如果 (!设类型.正常) { 运行时错误(4); }
                    // ②c D：函数级变量类型权威表（跨函数同名异型根治）
                    登记当前函数变量类型(整64(声明.文本), 整64(类型节点.文本));
                    // 2026-09-06 根治（宿主对齐·视图语义）：初值末节点=调用且非构造
                    //   调用（返回接收）→ 不入 RAII 名单。宿主实证（vieww/retown 探针
                    //   asm）：接收 rax 直用——元素(i) 返回向量内联元素地址（视图共享
                    //   写可见）、函数返回新对象（转移）——接收方一律不析构；原「接收
                    //   转移=本槽拥有」假设对元素(i) 形态=对向量内部元素 DeleteObject
                    //   →double free/堆坏（vcopy 探针 SIGSEGV 实证=v2self 符号表崩溃
                    //   同根因）。槽保留（读取/传参用，出口零值空安全）。
                    // 73-a（2026-09-11 方案A 用户裁决）：**名单登记移至生成期**——
                    //   预扫是函数级一次性扫描、先于函数体生成，若在预扫登记则 生成块
                    //   入口取基线时名单已含本块变量、基线恒等于名单大小，块出口析构
                    //   永远无新增项可释放=v2 块级 RAII 从未生效（探针 89：20 万轮
                    //   循环体拥有串残留 199999 实证）。预扫职责自此收敛为槽分配 +
                    //   入口零初始化 + 类型登记；释放名单随生成顺序追加（生成容器
                    //   局部 非返回接收分支），基线机制方能生效（Rust 作用域 drop）。
                }
            }
            // plans/019 阶段4' 第二批（2026-09-11 方案A 用户裁决）：拥有型字符串局部
            //   预扫**判定**——与容器同模型：槽预分配（生成变量声明 复用）+ 入口零初始化
            //   （未执行声明路径的槽=确定性 0，__cn_str_free 空安全跳过）+ 白名单判定
            //   （宿主第一批同构）：无初值/字面量/标识符=拥有登记；调用=内置分配族八
            //   函数（复制/连接/拼接/子串/大写/小写/修剪/反转——返回恒堆）才登记，
            //   其余调用（驻留文本/用户函数——可能返回借用包装）与下标/成员等形态
            //   一律不登记（借用保守，宁可不自动释放保安全——单 字符串 类型静态
            //   无法区分拥有/借用返回）。登记后由 生成变量声明 拥有化初始化 +
            //   生成赋值语句 拥有化赋值/污染传播 + 发射字符串释放/块出口析构 释放。
            //   引用形态（附加==256）不入（绑定不拥有）。
            //   73-a（2026-09-11 方案A 用户裁决）：**名单登记**（字符串变量们.追加）
            //   移至生成期（生成变量声明 拥有化初始化后）——预扫只判定「是否预分配
            //   槽」；预扫登记会使块出口析构基线机制失效（预扫先于函数体生成）。
            如果 (整64(类型节点.文本) == 驻留("字符串") && 类型节点.附加 != 256) {
                结果<整64, 整32> 已有串 = 函数信息.局部槽.获取(整64(声明.文本));
                如果 (!已有串.正常) {
                    布尔 拥有初值 = 真;
                    如果 (声明.子起点 < 声明.子终点) {
                        节点 初末s = 池.元素(声明.子终点 - 1);
                        如果 (初末s.类型 == 节点_调用) {
                            // 调用初值：白名单八函数 ∪ 返回类型契约（A2 2026-09-11
                            //   方案甲）：被调者返回 字符串=拥有（内置表/签名表按纯名
                            //   查——重载族返回异型为诚实边界，对齐宿主首候选口径）；
                            //   驻留文本 已改 字符* 返回=借用不登记。
                            布尔 是白名单 = 假;
                            如果 (初末s.子起点 >= 0) {
                                节点 被调s = 池.元素(整32(初末s.子起点));
                                如果 (被调s.类型 == 节点_标识符) {
                                    整64 被调名s = 整64(被调s.文本);
                                    是白名单 = 被调名s == 驻留("字符串复制") ||
                                         被调名s == 驻留("字符串连接") ||
                                         被调名s == 驻留("字符串拼接") ||
                                         被调名s == 驻留("字符串子串") ||
                                         被调名s == 驻留("字符串大写") ||
                                         被调名s == 驻留("字符串小写") ||
                                         被调名s == 驻留("字符串修剪") ||
                                         被调名s == 驻留("字符串反转");
                                            如果 (!是白名单) {
                                        // 72-a（2026-09-11 第七十二轮）：键基回退版
                                        //   （纯名查跨模块 miss=契约失效，宿主同族根治）
                                        整64 查返s = 查函数返回回退(被调名s);
                                        如果 (查返s == 驻留("字符串")) { 是白名单 = 真; }
                                    }
                                }
                            }
                            拥有初值 = 是白名单;
                        } 否则 如果 (初末s.类型 == 节点_下标 ||
                                    初末s.类型 == 节点_成员 ||
                                    初末s.类型 == 节点_解引用) {
                            // 下标/成员/解引用初值=借用（元素借出/字段视图/指针指向）
                            //   ——宿主初始化位此形态未污染（潜在缺口，v2 侧保守不登记）
                            拥有初值 = 假;
                        }
                    }
                    如果 (拥有初值) {
                        整64 槽s = 槽计数[0];
                        槽计数[0] = 槽计数[0] + 1;
                        结果<空类型, 整32> 设槽s = 函数信息.局部槽.设置(整64(声明.文本), 槽s);
                        如果 (!设槽s.正常) { 运行时错误(4); }
                        IR追加(函数信息.指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽s));
                        // 入口零初始化（与容器共用 零寄存器）
                        如果 (零寄存器 == 0) {
                            零寄存器 = 寄存器计数[0];
                            寄存器计数[0] = 寄存器计数[0] + 1;
                            IR追加(函数信息.指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0,
                                                 零寄存器, T_整64, 0));
                        }
                        IR追加(函数信息.指令, 建IR指令(IR_存储, 零寄存器, 0, 0, 0, 0, 槽s));
                        // 73-a（2026-09-11 方案A 用户裁决）：名单登记移至生成期
                        //   （生成变量声明 拥有化初始化后）——预扫登记会使 生成块
                        //   基线机制失效（详见 预扫容器声明 头部说明）
                    }
                }
            }
        }
        i++;
    }
    // 73-a：零寄存器回填——释放点清零槽复用（指令已在函数入口发射，运行期
    //   任何释放点路径均已执行过它）；无资源声明时保持 0（无释放点，无需清零）
    函数信息.零寄存器 = 零寄存器;
}

// 发射容器析构（RAII）：对本函数全部容器局部 Load 槽 + IR_删除对象。
//   代码生成展开：test/je 空安全 + call ~类(this) + call __cn_object_delete(this)。
//   ②c B：含容器字段结构体局部随后按字段逆序级联析构（发射资源字段析构 全量）。
不安全 函数 发射容器析构(函数IR& 函数信息, 向量<IR指令>& 指令, 整64* 寄存器计数,
                  映射<整64, 整64>& 局部槽, 整64 跳过名ID) -> 空类型 {
    整64 i = 0;
    当 (i < 函数信息.容器变量们.大小()) {
        整64 名ID = 函数信息.容器变量们.元素(i);
        // 2026-09-06 根治：返回语句所有权转移——被返回的容器局部跳过析构
        // 71-a：装箱（正常/某些(容器局部)）=move 转交，同跳过
        如果 (名ID == 跳过名ID || 是已装箱名(名ID)) { i++; 继续; }
        整64 槽 = 0;
        结果<整64, 整32> 找槽 = 局部槽.获取(名ID);
        如果 (找槽.正常) { 槽 = 找槽.值; }
        如果 (槽 != 0) {
            结果<整64, 整32> 查类型 = 函数信息.变量类型.获取(名ID);
            如果 (查类型.正常) {
                整64 ptr寄存器 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                // 目标=标签唯一序号（代码生成 objdel_函数序号_目标 拼标签——
                //   多容器变量同函数多条删除指令，序号须唯一否则 MASM A2005）
                IR追加(指令, 建IR指令(IR_加载, 槽, 0, 0, ptr寄存器, T_对象, 0));
                // 74-a：容器元素串释放（容器拥有元素所有权；宿主三处释放路径同款，
                //   与块出口析构同机制——plans/020 移植纪律 8「释放路径两侧对照」）
                发射容器元素释放(函数信息, 寄存器计数, ptr寄存器, 查类型.值);
                IR追加(指令, 建IR指令(IR_删除对象, ptr寄存器, 0, 0, 寄存器计数[0], 0, 查类型.值));
                寄存器计数[0] = 寄存器计数[0] + 1;
            }
        }
        i++;
    }
    // ②c B：含容器字段结构体局部（全部——返回语句跨块跳出兜底，全量逆序）
    发射资源字段析构(函数信息, 局部槽, 寄存器计数, 0, 函数信息.资源字段局部们.大小(), 跳过名ID);
}

// plans/019 阶段4' 第二批（2026-09-11 方案A 用户裁决）：拥有型字符串 RAII——
//   与 发射容器析构 同模型：对 字符串变量们 名单（预扫白名单判定后）注入
//   __cn_str_free 直调（IR_调用实参+IR_调用参数化 两指令形态——__cn_str_concat
//   先例；代码生成 __cn_ 前缀直通；空安全：__cn_str_free(nullptr) 安全跳过）；
//   污染名（字符串污染们——非拥有赋值/下标借出）与跳过名（返回标识符=所有权
//   移出，与容器析构跳过同构）一律跳过。
不安全 函数 发射字符串释放(函数IR& 函数信息, 向量<IR指令>& 指令, 整64* 寄存器计数,
                  映射<整64, 整64>& 局部槽, 整64 跳过名ID) -> 空类型 {
    整64 i = 0;
    当 (i < 函数信息.字符串变量们.大小()) {
        整64 名ID = 函数信息.字符串变量们.元素(i);
        如果 (名ID == 跳过名ID || 是已装箱名(名ID)) { i++; 继续; }   // 71-a：装箱=move 转交跳过
        结果<整64, 整32> 查污 = 函数信息.字符串污染们.获取(名ID);
        如果 (查污.正常) { i++; 继续; } 否则 { }
        整64 槽 = 0;
        结果<整64, 整32> 找槽 = 局部槽.获取(名ID);
        如果 (找槽.正常) { 槽 = 找槽.值; } 否则 { 槽 = 0; }
        如果 (槽 != 0) {
            整64 ptr寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 槽, 0, 0, ptr寄存器, T_字符串, 0));
            IR追加(指令, 建IR指令(IR_调用实参, ptr寄存器, 0, 0, 0, 0, 0));
            IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                 驻留("__cn_str_free")));
        }
        i++;
    }
}
