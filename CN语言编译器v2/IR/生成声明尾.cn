    //   （`整32[3] w = 造表();`——sret 调用返回值=retbuf 地址=数组基址；
    //   数组名=基址）→ IR_结构体拷贝 整块拷入本变量槽（原非 数组初始化
    //   静默返回=槽恒零+retbuf 数据丢；宿主「声明接收=数组+调用初值
    //   CopyStruct 整块拷」同面）。元素=字符串/类 的句柄共享面双侧同浅拷
    //   （85-a 域·宿主同款位拷=零分叉，不扩战场）。
    如果 (初末A.类型 != 节点_数组初始化) {
        整64 初前深度087b = 表达式栈.大小();
        整64 源reg087b = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                     指令, 寄存器计数, &函数信息.块计数,
                                     槽计数, 表达式栈);
        当 (表达式栈.大小() > 初前深度087b) {
