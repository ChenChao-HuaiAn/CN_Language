        整64 基址087b = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_取地址, 槽起A + 槽数A - 1, 0, 0, 基址087b,
                              T_整64, 0));
        IR追加(指令, 建IR指令(IR_结构体拷贝, 源reg087b, 基址087b, 0, 0,
                              元素步进A * 长度A, 0));
