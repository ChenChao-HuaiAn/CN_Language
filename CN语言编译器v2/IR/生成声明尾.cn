    整64 基址寄存器A = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_取地址, 槽起A + 槽数A - 1, 0, 0, 基址寄存器A,
                          T_整64, 0));
    // 897-a（070-001 波4）：**顶层包装倒序收集**——元素=构造字面量（`班级[2]
    //   各班 = { 班级{ 成绩={60,70,80} }, … }`）时初始化区间物理含内层构造的
    //   全部内节点（含内层 节点_数组元素 包装）——原线性计数把内层包装当外层
    //   元素（998 探针「元素数超出长度: 班级[2]」·长度=2 而序误到 2+）。判据
    //   （区间覆盖）：倒序扫，包装 w.子起点 < 已收集顶层的最小子起点 = 顶层
    //   （内层包装 ⊂ 顶层元素子区间必不满足）；收集后自尾（=最左）正序生成。
    向量<整64> 顶层们A = 向量<整64>();
    整64 最小起A = 整64(初末A.子终点);
    整64 倒扫A = 整64(初末A.子终点) - 1;
    当 (倒扫A >= 整64(初末A.子起点)) {
        节点 扫wA = 池.元素(整32(倒扫A));
        如果 (扫wA.类型 == 节点_数组元素 &&
             整64(扫wA.子起点) < 最小起A) {
            结果<空类型, 整32> 加顶A = 顶层们A.追加(倒扫A);
            如果 (!加顶A.正常) { 运行时错误(4); }
            最小起A = 整64(扫wA.子起点);
        }
        倒扫A--;
    }
    整64 元素序A = 0;
    整64 顶iA = 顶层们A.大小();
    当 (顶iA > 0) {
        顶iA--;
        节点 包装A = 池.元素(整32(顶层们A.元素(顶iA)));
        如果 (元素序A >= 长度A) {
            IR层诊断("数组初始化元素数超出长度: " + 类型文本);
            返回;
        }
        整64 元素前深度A = 表达式栈.大小();
        整64 元素寄存器A = 生成表达式(池, 整32(包装A.子起点),
                                       整32(包装A.子终点), 局部槽, 参数槽,
                                       指令, 寄存器计数, &函数信息.块计数,
                                       槽计数, 表达式栈);
        表达式栈弹到深度(表达式栈, 元素前深度A);
        如果 (元素寄存器A != 0) {
            整64 元素地址A = 基址寄存器A;
            如果 (元素序A > 0) {
                整64 偏移常量A = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_常量整数,
                                      整64(驻留(整数转字符串(元素序A * 元素步进A))),
                                      0, 0, 偏移常量A, T_整64, 0));
                整64 元素地址新A = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_加, 基址寄存器A, 偏移常量A, 0,
                                      元素地址新A, T_整64, 0));
                元素地址A = 元素地址新A;
            }
            // 897-a：元素=**结构体**（查结构体大小 != 0）——元素寄存器=构造
            //   产物**地址**（84-a 物化槽）→ IR_结构体拷贝 整体拷入元素位
            //   （原 8B 指针存储把地址当值存=读取按内联偏移全垃圾）；
            //   标量/指针维持指针存储原路。
            整64 元素类型ID897 = 驻留(数组元素文本(类型文本));
            如果 (查结构体大小(元素类型ID897) != 0) {
                IR追加(指令, 建IR指令(IR_结构体拷贝, 元素寄存器A, 元素地址A, 0, 0,
                                      元素步进A, 0));
            } 否则 如果 (查结构体大小(元素类型ID897) == 0) {
                // 919（超承载字面量参与表达式·数组元素求值链收口）：标量元素
                //   收 128 值（超承载字面量表达式经 638 甲案提升链物化为地址
                //   句柄）→ 隐式窄化低半（与声明初值/赋值/返回/实参挂点同设施
                //   ·宿主端 i128→i64 Cast 同款）。原句柄地址直存元素槽＝数组
                //   读出地址碎片（探针：整64[2] 数组 = { 20位+0, 1 } 输出每次
                //   不同的栈地址，应 7766279631452241919=低 64 位截断）。
                元素寄存器A = 隐式窄化到64(元素寄存器A, 指令, 寄存器计数);
                IR追加(指令, 建IR指令(IR_指针存储, 元素地址A, 元素寄存器A, 0, 0,
                                      类型宽度码(数组元素文本(类型文本)), 0));
            }
        }
        元素序A++;
    }
}


// 775（甲案·2026-10-15 用户裁决）：类实例字段默认值注入（构造调用前·声明序
//   输出·宿主 emitClassFieldDefaults 同构·零分叉）。数据源=结构体全字段表们
//   三元组 [键基, 字段名ID, 字段类型ID]（283 甲案 注入实例化字段级联 同款
//   遍历）——祖先层字段默认值经 并入基类字段 随全字段表并入子类键基域（本层
//   声明序先于并入·遮蔽字段自有默认值已登记不被覆盖），单层遍历即全链覆盖：
//   与宿主逐层注入（层内声明序×对象布局偏移）语义等价。默认值=解析期折叠的
//   规范文本（解析类字段→折叠类字段默认值·宿主 defaultInitText 同构）；
//   字段地址+常量整数+按宽指针存储。
不安全 函数 发射类字段默认值(整64 类名ID, 整64 对象reg,
                   向量<IR指令>& 指令, 整64* 寄存器计数) -> 空类型 {
    整64 键基d = 结构体布局键基(类名ID);
    如果 (键基d == 0) {
        // 648（2026-10-14 用户令）：miss 不可静默——调用点=类对象创建路径
        //   （类型必经过解析收口 登记结构体布局）；此 miss=编译器内部缺陷，
        //   登记显形收尾中止（静默漏发默认值=对象字段错值·648 红线本面）。
        登记内部未登记("类字段默认值·类未登记", 字符串复制(驻留文本(类名ID)), 0);
        返回;
    }
    整64 ibd = 0;
    当 (ibd + 2 < 结构体全字段表们.大小()) {
        如果 (结构体全字段表们.元素(ibd) == 键基d) {
            整64 名IDd = 结构体全字段表们.元素(ibd + 1);
            结果<整64, 整32> 默认查d = 查字段默认值(类名ID, 名IDd);   // 值=规范文本ID
            如果 (默认查d.正常) {
                整64 默认文IDd = 默认查d.值;
                整64 偏d = 查字段偏移(类名ID, 名IDd);
                如果 (偏d >= 0) {
                    字符串 常量文d = 字符串复制(驻留文本(默认文IDd));
                    整64 址d = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_字段地址, 对象reg, 0, 0,
                                         址d, T_整64, 偏d));
                    整64 值d = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_常量整数, 驻留(常量文d), 0, 0,
                                         值d, T_整64, 0));
                    整64 宽码d = 查字段宽度码(类名ID, 名IDd);
                    IR追加(指令, 建IR指令(IR_指针存储, 址d, 值d, 0, 0,
                                         宽码d, 0));
                }
            }
        }
        ibd = ibd + 3;
    }
}
