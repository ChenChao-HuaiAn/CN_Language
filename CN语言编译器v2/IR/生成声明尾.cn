// 生成声明尾（357 重构F2 自 生成声明.cn 纯机械搬移·函数体逐字保留·零逻辑变化）

导入 容器::向量;
导入 语法;       // Token/AST 节点池
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 IR生成;     // 生成表达式/生成左值地址 + 权威表访问函数

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

不安全 函数 生成结果局部(向量<节点> 池, 节点 n, 节点 类型节点,
                       映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                       函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                       向量<整64>& 表达式栈) {
    向量<IR指令>& 指令 = 函数信息.指令;
    字符串 类型文本 = 字符串复制(驻留文本(整64(类型节点.文本)));
    // 多槽变量数据基址=低地址槽（高槽号）：槽号越大地址越低（8*(R+s)+8），
    //   结果字节从基址向上写——若取低槽号（高地址），写入越界覆盖
    //   槽号更小的相邻变量（表对象指针被污染 -> SIGSEGV，实测踩坑）。
    //   2026-09-06 根治（freg 探针/v2self 表注册 崩溃）：T=结构体时
    //   结果>16 字节（结果<符号>=24/40）——原硬编码 2 槽+基槽 槽r+1，
    //   24 字节拷贝自基槽向上覆盖相邻变量槽（顶层容器槽被清零 ->
    //   后续方法调用 this=null 判空 fail）。按 结果槽位数 逐槽分配，
    //   基槽=最大槽号（低地址）。
    整64 槽r = 槽计数[0];
    整64 结果槽数 = 结果槽位数(类型文本);
    槽计数[0] = 槽计数[0] + 结果槽数;
    结果<空类型, 整32> 设r = 局部槽.设置(整64(n.文本), 槽r + 结果槽数 - 1);
    如果 (!设r.正常) { 运行时错误(4); }
    // 107（945）：合成体类型登记归一（尖括号→$）
    整64 归一类型ID107 = 驻留(归一结果名(类型文本));
    结果<空类型, 整32> 设类r = 函数信息.变量类型.设置(整64(n.文本), 归一类型ID107);
    如果 (!设类r.正常) { 运行时错误(4); }
    登记当前函数变量类型(整64(n.文本), 归一类型ID107);
    // 107（946）：类值载荷盒登记容器变量们——出口段（块出口+函数级兜底）经
    //   runtime 辅助 __cn_box_class_delete 免切块摘取句柄后 IR_删除对象 收尾。
    {
        字符串 载荷946 = 段首(合成名首实参(归一结果名(类型文本)));
        如果 (是用户类(载荷946)) {
            名单追加去重(函数信息.容器变量们, 整64(n.文本));
        }
    }
    整64 槽i = 0;
    当 (槽i < 结果槽数) {
        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽r + 槽i));
        槽i++;
    }
    如果 (n.子起点 < n.子终点) {
        // 限定名内置直调初值（2026-09-06 根治，T6 自举首踩）：文件::/IO::
        //   限定名内置返回裸指针（char*/FILE*，null=EOF/失败）——旧实现
        //   把返回寄存器当「16 字节结果结构体地址」IR_结构体拷贝（读字符串
        //   内容当结构体，v2 编译 v2 自身 读源文件 段错误实证）。改合成构造：
        //   判空 -> 正常@0、指针 -> 值@8（对齐 结果 ABI 防御布局）
        布尔 限定内置 = 假;
        节点 首节点 = 池.元素(整32(n.子起点));
        // 池顺序：调用表达式的被调标识符先入池（P6f 调用节点.子起点=被调
        //   索引的镜像约定）——变量声明.子起点 即被调标识符（限定名内置
        //   形态=「标识符(」无成员/后缀前缀）
        如果 (首节点.类型 == 节点_标识符) {
            字符串 被调名v = 字符串复制(驻留文本(整64(首节点.文本)));
            // 限定名判定（含 ':'，IO::/文件::）——字节位置 在 代码生成共用.cn
            //   （IR生成 不导入=依赖环），此处内联首冒号扫描
            布尔 含冒号 = 假;
            整64 ci = 0;
            当 (ci < 字符串长度(被调名v)) {
                整64 cb = 整64(被调名v[ci]) & 255;
                如果 (cb == 58) { 含冒号 = 真; 中断; }
                ci++;
            }
            如果 (字符串长度(内置函数符号(被调名v)) != 0 && 含冒号) {
                限定内置 = 真;
            }
        }
        如果 (限定内置) {
            整64 指针reg = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                       指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
            如果 (指针reg != 0) {
                // 零初始化两槽（值@8=槽r、正常@0=槽r+1——基址槽=大槽号低地址）
                整64 零reg = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("0")), 0, 0, 零reg, T_整64, 0));
                IR追加(指令, 建IR指令(IR_存储, 零reg, 0, 0, 0, 0, 槽r));
                IR追加(指令, 建IR指令(IR_存储, 零reg, 0, 0, 0, 0, 槽r + 结果槽数 - 1));
                // 值槽 = 裸指针
                IR追加(指令, 建IR指令(IR_存储, 指针reg, 0, 0, 0, 0, 槽r));
                // 正常槽 = 指针 != 0
                整64 正常reg = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_不等, 指针reg, 零reg, 0, 正常reg, T_布尔, 0));
                IR追加(指令, 建IR指令(IR_存储, 正常reg, 0, 0, 0, 0, 槽r + 结果槽数 - 1));
            }
        } 否则 如果 (池.元素(n.子终点 - 1).类型 == 节点_整数字面量) {
            // 107-a（H6 同族）：可选局部 = 无（语法层把「无」解析为 节点_整数字面量
            //   值 0）零初始化全部结果槽（原走下方「生成表达式」路径把 0 当结构体
            //   地址 -> 自 NULL 读；语义层同步放行可选「无」，两侧与宿主同构）
            整64 零regv = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("0")), 0, 0,
                                 零regv, T_整64, 0));
            整64 zv = 0;
            当 (zv < 结果槽数) {
                IR追加(指令, 建IR指令(IR_存储, 零regv, 0, 0, 0, 0, 槽r + zv));
                zv++;
            }
        } 否则 {
            整64 源地址 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                     指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
            如果 (源地址 != 0) {
                整64 目标地址 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_取地址, 槽r + 结果槽数 - 1, 0, 0, 目标地址, T_整64, 0));
                IR追加(指令, 建IR指令(IR_结构体拷贝, 源地址, 目标地址, 0, 0,
                                     结果大小(类型文本), 0));
            }
        }
        当 (表达式栈.大小() > 0) {
            结果<空类型, 整32> 删栈r = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈r.正常) { 运行时错误(4); }
        }
    }
    // 79-a（2026-09-12 第七十九轮）：结果/可选 值字段为字符串 -> 资源字段释放
    //   名单（块出口/跳出/函数尾条件释放值字段）——局部=「调用返回接收」·宿主
    //   70-a 装箱 move 语义：值所有权随装箱转入本变量，登记释放即唯一持有者。
    // 205：值载荷=结构体且含资源字段（结果<盒子>）同登记（配套装箱在位深拷·详 coverage_map）。
    如果 (结果载荷带资源205(类型文本)) {
        结果<空类型, 整32> 加局r = 函数信息.资源字段局部们.追加(整64(n.文本));
        如果 (!加局r.正常) { 运行时错误(4); }
        结果<空类型, 整32> 加构r = 函数信息.资源字段结构体们.追加(整64(类型节点.文本));
        如果 (!加构r.正常) { 运行时错误(4); }
    }
}

// ②b B1（2026-09-02）：结构体局部变量——多槽布局（槽数=ceil(大小/8)，
//   基址槽=最大槽号=最低地址，多槽向上写不越界）+ 零初始化（安全：
//   字符串字段垃圾指针析构即崩——对齐宿主类局部入口零初始化防御）。
//   整体初始化（= 表达式）暂不支持（诊断）；字段赋值走成员路径。
不安全 函数 生成结构体局部(向量<节点> 池, 节点 n, 节点 类型节点,
                       映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                       函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                       向量<整64>& 表达式栈) {
    向量<IR指令>& 指令 = 函数信息.指令;
    整64 结构大小 = 查结构体大小(整64(类型节点.文本));
    整64 槽数 = (结构大小 + 7) / 8;
    整64 槽起 = 槽计数[0];
    槽计数[0] = 槽计数[0] + 槽数;
    结果<空类型, 整32> 设槽s = 局部槽.设置(整64(n.文本), 槽起 + 槽数 - 1);
    如果 (!设槽s.正常) { 运行时错误(4); }
    // ②c D：结构体局部入函数级变量类型权威表（成员偏移/宽度/方法对象解析）
    登记当前函数变量类型(整64(n.文本), 整64(类型节点.文本));
    整64 z = 0;
    当 (z < 槽数) {
        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽起 + z));
        z++;
    }
    // 零初始化：常量 0 -> 各槽
    整64 零寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("0")), 0, 0, 零寄存器, T_整64, 0));
    z = 0;
    当 (z < 槽数) {
        IR追加(指令, 建IR指令(IR_存储, 零寄存器, 0, 0, 0, 0, 槽起 + z));
        z++;
    }
    // 860-a（058 挂账②·结构体面 v2 同构·宿主 ir_stmt_decl.cpp 闭合域级联对应）：
    //   无初始化器结构体局部——对「hasDtor ∧ 有拷贝构造 ∧ 有默认构造」用户类
    //   字段级联构造（分配对象+无参构造+指针存储；=资源字段收集域：拷贝
    //   postCopy 深拷/释放 preFree 闭环，活句柄全程无共享）。域外类字段维持
    //   上方零初始化=确定性空句柄（拷贝浅共享空句柄无害；级联活句柄+浅拷
    //   共享=双主——142-a 泛化回退教训，不越域）。构造字面量初始化不走本段。
    如果 (n.子起点 >= n.子终点) {
        整64 基址g = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_取地址, 槽起 + 槽数 - 1, 0, 0,
                             基址g, T_整64, 0));
        整64 结构键基g = 结构体布局键基(整64(类型节点.文本));
        如果 (结构键基g == 0) { 结构键基g = 整64(类型节点.文本); }
        整64 字段数g = 构造字段数(结构键基g);
        整64 字段序g = 0;
        当 (字段序g < 字段数g) {
            整64 字段名g = 构造字段名(结构键基g, 字段序g);
            如果 (字段名g > 0) {
                整64 字段类型g = 查字段类型ID(整64(类型节点.文本), 字段名g);
                如果 (字段类型g > 0) {
                    字符串 字段文本g = 字符串复制(驻留文本(字段类型g));
                    如果 (是用户类(字段文本g)) {
                        布尔 有析构g = 类有析构(字段类型g);
                        整64 单参串g = 查类拷贝构造串(字段类型g);
                        布尔 有拷贝g = 单参串g != 0;
                        整64 无参串g = 查类构造参数串(字段类型g, 0);
                        如果 (有析构g && 有拷贝g && 无参串g != 0) {
                            整64 字段偏g = 查字段偏移(整64(类型节点.文本), 字段名g);
                            如果 (字段偏g >= 0) {
                                整64 字段址g = 寄存器计数[0];
                                寄存器计数[0] = 寄存器计数[0] + 1;
                                IR追加(指令, 建IR指令(IR_字段地址, 基址g, 0, 0,
                                                     字段址g, T_整64, 字段偏g));
                                整64 字段对g = 寄存器计数[0];
                                寄存器计数[0] = 寄存器计数[0] + 1;
                                IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 字段对g,
                                                     查结构体大小(字段类型g), 字段类型g));
                                IR追加(指令, 建IR指令(IR_调用实参, 字段对g, 0, 0, 0, 0, 0));
                                IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                                     整64(驻留(方法符号(字段文本g,
                                                                          剥实例基名(字段文本g),
                                                                          字符串复制(驻留文本(无参串g)))))));
                                IR追加(指令, 建IR指令(IR_指针存储, 字段址g, 字段对g, 0, 0, T_对象, 0));
                            }
                        }
                    }
                }
            }
            字段序g++;
        }
    }
    // ②c B：含容器字段的结构体局部——登记 RAII 跟踪（块出口/返回按字段
    //   逆序级联析构：字段地址->指针加载->DeleteObject，空安全）
    //   第 15 枚豁免（2026-09-06，v2self 第 8 层）：初值末节点=调用
    //   （非构造——结构体无构造调用）-> 不登记——sret 浅拷贝自调用方
    //   容器元素（收集字符串常量 实证：函数IR 扫函数 = 程序.函数们.
    //   元素(f) 出口级联析构=free 调用方 程序.函数们[f].指令 数据 ->
    //   后续迭代读/再析构已释放内存 -> invalid free SIGABRT）；宿主
    //   语义=调用返回接收不析构（泄漏对齐现状），与第 9 枚「容器变量
    //   调用返回初值不入 RAII」同款豁免。
    布尔 结构体返回接收 = 假;
    如果 (n.子起点 < n.子终点) {
        节点 首节点s = 池.元素(n.子起点);
        节点 末节点s = 池.元素(n.子终点 - 1);
        如果 (末节点s.类型 == 节点_调用 &&
            !(首节点s.类型 == 节点_标识符 && 首节点s.文本 == 类型节点.文本)) {
            结构体返回接收 = 真;
        }
    }
    // 79-a：登记拆分为两类判定——①容器字段（资源字段数 - 串字段数）：返回
    //   接收（sret 浅拷共享对象指针）豁免登记（既有防双释放语义）；②字符串
    //   字段：返回接收=被调方返回移出 + 调用方接管唯一持有者，登记安全
    //   （与宿主 79-a 对齐）。
    如果 ((资源字段数(整64(类型节点.文本)) - 串字段数(整64(类型节点.文本)) > 0 &&
          !结构体返回接收) ||
        串字段数(整64(类型节点.文本)) > 0) {
        结果<空类型, 整32> 加字段局部 = 函数信息.资源字段局部们.追加(整64(n.文本));
        如果 (!加字段局部.正常) { 运行时错误(4); }
        结果<空类型, 整32> 加字段结构体 = 函数信息.资源字段结构体们.追加(整64(类型节点.文本));
        如果 (!加字段结构体.正常) { 运行时错误(4); }
    }
    如果 (n.子起点 < n.子终点) {
        // 结构体初始化三形态（2026-09-04 E2E 148 两形态 + 呈报①A 冒烟
        //   暴露第三形态 2026-09-05——v2 自举刚需）：
        //   ①调用返回（IR指令 项 = 建IR指令(...)）：rax=结构体地址
        //     （被调 retbuf）-> IR_结构体拷贝 入本变量基槽；
        //   ②标识符拷贝（节点 参数类型节点 = 参数——生成函数 参数循环
        //     实测形态）：源=标识符左值地址（局部/参数基槽）-> 拷贝；
        //   ③成员字段（符号 找到 = 查.值——结果<T>.值 整体接收，语义分析.cn
        //     冒烟踩出）：生成表达式 成员分支压字段地址（结果值字段=结构体
        //     值语义不 LoadPtr）-> 拷贝。字面量等其他形态保持诊断（诚实边界）。
        节点 初始化末s = 池.元素(n.子终点 - 1);
        如果 (初始化末s.类型 == 节点_调用 || 初始化末s.类型 == 节点_标识符 ||
             初始化末s.类型 == 节点_成员 || 初始化末s.类型 == 节点_三元运算 ||
             初始化末s.类型 == 节点_结构体构造) {
            // 952（002·§2.210 工单·84-a 家族声明位收口）：结构体字面量
            //   （变量 x = 名{ 字段 = 值 }）——生成表达式 命中 节点_结构体构造
            //   分支（84-a 临时槽+逐字段写+槽地址压栈）→ 源地址=临时槽地址
            //   → 整体拷入本变量基槽（84-a 临时槽一次性——按源是调用假=深拷口径）
            整64 源地址 = 0;
            如果 (初始化末s.类型 == 节点_调用 || 初始化末s.类型 == 节点_成员 ||
                初始化末s.类型 == 节点_三元运算 || 初始化末s.类型 == 节点_结构体构造) {
                // 86-a（2026-09-12 复审缺陷①）第四形态：三元聚合初值——生成
                //   表达式 经 生成三元运算（86-a 聚合分支地址化）得出**选中
                //   place 地址**（地址透传，与成员第三形态同款消费）。
                //   原无此形态 → 「结构体整体初始化暂不支持」IR 层拒绝
                //   （P46 v2 实证）。源非调用 → 深拷（两个候选 place 均为
                //   局部拥有，接收方独立副本，候选源保持拥有）。
                源地址 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                     指令, 寄存器计数, &函数信息.块计数,
                                     槽计数, 表达式栈);
            } 否则 {
                源地址 = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                       指令, 寄存器计数, &函数信息.块计数,
                                       槽计数, 表达式栈);
            }
            如果 (源地址 != 0) {
                整64 目标地址 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_取地址, 槽起 + 槽数 - 1, 0, 0,
                                     目标地址, T_整64, 0));
                // 79-a：含串字段结构体的局部初始化——源为标识符/成员（值语义
                //   拷贝）=深拷（源保持拥有，目标独立副本）；源为调用返回
                //   （retbuf，被调方返回移出已跳过释放）=浅拷接管（零拷贝，句柄
                //   唯一持有者转为目标——深拷会造成副本泄漏）。目标刚声明零初始化。
                布尔 源是调用 = 初始化末s.类型 == 节点_调用;
                发射结构体整体拷贝(函数信息, 寄存器计数, 目标地址, 源地址,
                                 整64(类型节点.文本), !源是调用, 假);
                // 1013 批八续（79_v2 根治配对·〔基准=019〕）：源=调用返回 且
                //   命中 结构体返回临时们（81-a-v2 物化壳）且类型含资源字段
                //   → 物化点已对壳做逐资源字段深拷（独立副本）→ 上方 move 接管
                //   后**本变量=独立副本唯一拥有者**——须补 RAII 登记（原「结构体
                //   返回接收」豁免（954 行第 15 枚）的前提=浅拷共享（容器拥有），
                //   深拷后前提不成立，豁免=泄漏——240 ④⑦ 残留 1 实证）；并删除
                //   临时登记（拥有移交·防后续 975 误清）。登记晚于上方统一登记段
                //   （求值需先得 源地址）——块出口区间机制按名单序消费，无时序影响。
                如果 (源是调用) {
                    结果<整64, 整32> 查临1013 = 结构体返回临时们.获取(源地址);
                    如果 (查临1013.正常 && 资源字段数(整64(类型节点.文本)) > 0) {
                        // 成对纪律：与局部们同下标——名单追加去重 两表分别去重
                        //   在两表历史不同步时错位（同名跨类型·批八续教训）。
                        如果 (!在资源字段名单(函数信息, 整64(n.文本))) {
                            结果<空类型, 整32> 加局1013 = 函数信息.资源字段局部们.追加(整64(n.文本));
                            如果 (!加局1013.正常) { 运行时错误(4); }
                            结果<空类型, 整32> 加构1013 = 函数信息.资源字段结构体们.追加(整64(类型节点.文本));
                            如果 (!加构1013.正常) { 运行时错误(4); }
                        }
                        布尔 删临1013 = 结构体返回临时们.删除(源地址);
                    }
                }
            }
            当 (表达式栈.大小() > 0) {
                结果<空类型, 整32> 删栈s = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删栈s.正常) { 运行时错误(4); }
            }
        } 否则 {
            IR层诊断("结构体整体初始化暂不支持（字段赋值可用）");
        }
    }
}

// 94-a（2026-09-13 第九十四轮）：数组局部变量——C 布局多槽（槽数=ceil(元素大小×
//   长度/8)，基址槽=最大槽号=最低地址，逐槽 IR_分配）+ 零初始化 + 可选初始化列表
//   （逐元素 store 到 基址+序号×元素步进；余下元素保零=宿主「部分初始化补零」同构）。
//   对齐宿主：ir.cpp registerVarSlots 数组分支（槽数按 C 总大小 ceil(元素大小×长度/8)）
//   + 数组名退化（标识符值=元素指针=基址地址，见 生成表达式.生成标识符加载）。
//   槽分配纪律（82-a 四条）：基址槽=槽起+槽数-1（低地址）/逐槽分配/零初始化先行/
//   临时寄存器只递增不复用。
不安全 函数 生成数组局部(向量<节点> 池, 节点 n, 节点 类型节点,
                       映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                       函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                       向量<整64>& 表达式栈) {
    向量<IR指令>& 指令 = 函数信息.指令;
    字符串 类型文本 = 字符串复制(驻留文本(整64(类型节点.文本)));
    整64 元素步进A = 数组元素步进(类型文本);
    整64 长度A = 数组长度文本(类型文本);
    如果 (元素步进A <= 0 || 长度A <= 0) {
        IR层诊断("数组类型元素/长度未知: " + 类型文本);
        返回;
    }
    整64 槽数A = (元素步进A * 长度A + 7) / 8;
    整64 槽起A = 槽计数[0];
    槽计数[0] = 槽计数[0] + 槽数A;
    结果<空类型, 整32> 设槽A = 局部槽.设置(整64(n.文本), 槽起A + 槽数A - 1);
    如果 (!设槽A.正常) { 运行时错误(4); }
    登记当前函数变量类型(整64(n.文本), 整64(类型节点.文本));
    // 94-a：数组名退化为元素指针——登记**指针变量表**（名 -> 元素类型ID）：
    //   下标读（生成下标访问）/下标左值写（生成下标左值地址）全链复用既有指针
    //   路径（步进=元素宽度/加载宽度=元素宽度码/结果类型=元素类型码）——零新增
    //   下标分支（宿主「数组名引用为元素指针」语义同构）。元素=结构体/字符串
    //   同样成立（宽度经 类型名宽度/查结构体大小 单点）。
    登记指针变量类型(整64(n.文本), 驻留(数组元素文本(类型文本)));
    // 98-a（C9）：字符串元素数组登记（块出口/跳出/函数尾逐元素 __cn_str_free；
    //   元素槽释放+清零=幂等模型。宿主同款靶子面「数组元素残留 2」双侧收口）
    如果 (字符串比较(数组元素文本(类型文本), "字符串")) {
        名单追加去重(函数信息.字符串数组变量们, 整64(n.文本));
    }
    整64 zA = 0;
    当 (zA < 槽数A) {
        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽起A + zA));
        zA++;
    }
    整64 零寄存器A = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("0")), 0, 0, 零寄存器A, T_整64, 0));
    zA = 0;
    当 (zA < 槽数A) {
        IR追加(指令, 建IR指令(IR_存储, 零寄存器A, 0, 0, 0, 0, 槽起A + zA));
        zA++;
    }
    如果 (n.子起点 >= n.子终点) { 返回; }
    节点 初末A = 池.元素(n.子终点 - 1);
    // 087b（#087 余量·宿主 82984e4bbe 同构）：数组声明**表达式初值**
    //   （`整32[3] w = 造表();`——sret 调用返回值=retbuf 地址=数组基址；
    //   数组名=基址）→ IR_结构体拷贝 整块拷入本变量槽（原非 数组初始化
    //   静默返回=槽恒零+retbuf 数据丢；宿主「声明接收=数组+调用初值
    //   CopyStruct 整块拷」同面）。元素=字符串/类 的句柄共享面双侧同浅拷
    //   （85-a 域·宿主同款位拷=零分叉，不扩战场）。
    如果 (初末A.类型 != 节点_数组初始化) {
        整64 初前深度087b = 表达式栈.大小();
        整64 源reg087b = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                     指令, 寄存器计数, &函数信息.块计数,
                                     槽计数, 表达式栈);
        当 (表达式栈.大小() > 初前深度087b) {
            结果<空类型, 整32> 删栈087b = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈087b.正常) { 运行时错误(4); }
        }
        整64 基址087b = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_取地址, 槽起A + 槽数A - 1, 0, 0, 基址087b,
                              T_整64, 0));
        IR追加(指令, 建IR指令(IR_结构体拷贝, 源reg087b, 基址087b, 0, 0,
                              元素步进A * 长度A, 0));
        返回;
    }
    整64 基址寄存器A = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_取地址, 槽起A + 槽数A - 1, 0, 0, 基址寄存器A,
                          T_整64, 0));
    // 897-a（070-001 波4）：**顶层包装倒序收集**——元素=构造字面量（`班级[2]
    //   各班 = { 班级{ 成绩={60,70,80} }, … }`）时初始化区间物理含内层构造的
    //   全部内节点（含内层 节点_数组元素 包装）——原线性计数把内层包装当外层
    //   元素（998 探针「元素数超出长度: 班级[2]」·长度=2 而序误到 2+）。判据
    //   （区间覆盖）：倒序扫，包装 w.子起点 < 已收集顶层的最小子起点 = 顶层
    //   （内层包装 ⊂ 顶层元素子区间必不满足）；收集后自尾（=最左）正序生成。
    向量<整64> 顶层们A = 向量<整64>();
    整64 最小起A = 整64(初末A.子终点);
    整64 倒扫A = 整64(初末A.子终点) - 1;
    当 (倒扫A >= 整64(初末A.子起点)) {
        节点 扫wA = 池.元素(整32(倒扫A));
        如果 (扫wA.类型 == 节点_数组元素 &&
             整64(扫wA.子起点) < 最小起A) {
            结果<空类型, 整32> 加顶A = 顶层们A.追加(倒扫A);
            如果 (!加顶A.正常) { 运行时错误(4); }
            最小起A = 整64(扫wA.子起点);
        }
        倒扫A--;
    }
    整64 元素序A = 0;
    整64 顶iA = 顶层们A.大小();
    当 (顶iA > 0) {
        顶iA--;
        节点 包装A = 池.元素(整32(顶层们A.元素(顶iA)));
        如果 (元素序A >= 长度A) {
            IR层诊断("数组初始化元素数超出长度: " + 类型文本);
            返回;
        }
        整64 元素前深度A = 表达式栈.大小();
        整64 元素寄存器A = 生成表达式(池, 整32(包装A.子起点),
                                       整32(包装A.子终点), 局部槽, 参数槽,
                                       指令, 寄存器计数, &函数信息.块计数,
                                       槽计数, 表达式栈);
        表达式栈弹到深度(表达式栈, 元素前深度A);
        如果 (元素寄存器A != 0) {
            整64 元素地址A = 基址寄存器A;
            如果 (元素序A > 0) {
                整64 偏移常量A = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_常量整数,
                                      整64(驻留(整数转字符串(元素序A * 元素步进A))),
                                      0, 0, 偏移常量A, T_整64, 0));
                整64 元素地址新A = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_加, 基址寄存器A, 偏移常量A, 0,
                                      元素地址新A, T_整64, 0));
                元素地址A = 元素地址新A;
            }
            // 897-a：元素=**结构体**（查结构体大小 != 0）——元素寄存器=构造
            //   产物**地址**（84-a 物化槽）→ IR_结构体拷贝 整体拷入元素位
            //   （原 8B 指针存储把地址当值存=读取按内联偏移全垃圾）；
            //   标量/指针维持指针存储原路。
            整64 元素类型ID897 = 驻留(数组元素文本(类型文本));
            如果 (查结构体大小(元素类型ID897) != 0) {
                IR追加(指令, 建IR指令(IR_结构体拷贝, 元素寄存器A, 元素地址A, 0, 0,
                                      元素步进A, 0));
            } 否则 {
                IR追加(指令, 建IR指令(IR_指针存储, 元素地址A, 元素寄存器A, 0, 0,
                                      类型宽度码(数组元素文本(类型文本)), 0));
            }
        }
        元素序A++;
    }
}
