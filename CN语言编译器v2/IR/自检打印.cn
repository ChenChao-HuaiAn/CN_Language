// CN 自举编译器 v2 · IR 自检打印（1272 自主.cn 机械搬移，函数体逐字保留）
// 职责：[ir1] 函数 IR dump（每函数头+每指令行=自举最大输出税）——仅在
//   详细诊断开关开启时由 主() 调用；自检行打源码声明名（人类可读归真）。
公开:

// 冒烟打印函数 IR 指令（操作码/操作数/结果）
// 呈报③方案A 后 函数IR.名字=签名键（名#参数串，asm 符号消歧用）；自检行打
//   源码声明名（人类可读归真，2026-09-06 用户裁决方案A）——剥首个 # 后缀
//   （签名键格式=名#参数串，CN 标识符无 #，剥离安全）
函数 自检显示名(整64 名ID) -> 字符串 {
    字符串 名 = 字符串复制(驻留文本(名ID));
    整64 i = 0;
    当 (i < 字符串长度(名)) {
        如果 (((整64(名[整32(i)]) & 255) == 35)) {
            返回 字符串子串(名, 0, 整32(i));
        }
        i++;
    }
    返回 名;
}

函数 打印函数IR(函数IR 函数信息) -> 空类型 {
    IO::打印到错误("[ir1] 函数: " + 自检显示名(整64(函数信息.名字)) +
                   " 返回类型码=" + 整数转字符串(函数信息.返回类型) + "\n");
    整64 i = 0;
    当 (i < 函数信息.指令.大小()) {
        IR指令 指令 = 函数信息.指令.元素(i);
        IO::打印到错误("[ir1]  op=" + 整数转字符串(指令.操作码) +
                       " o1=" + 整数转字符串(指令.操作数1) +
                       " o2=" + 整数转字符串(指令.操作数2) +
                       " o3=" + 整数转字符串(指令.操作数3) +
                       " 目标=" + 整数转字符串(指令.目标) +
                       " 类型=" + 整数转字符串(指令.类型) +
                       " 附加=" + 整数转字符串(指令.附加) + "\n");
        i++;
    }
}
