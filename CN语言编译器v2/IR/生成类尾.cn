// 生成类尾（356 重构F1 自 生成类.cn 纯机械搬移·函数体逐字保留·零逻辑变化）
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_* 常量
导入 IR;         // IR_*/T_* 操作码 + 类表/布局查询/符号合成
导入 协议常量;   // 335 重构B：协议常量独立包
导入 IR生成;     // 程序IR 布局 + 类型码/权威表/控制流辅助

公开:

// 生成类方法们（节点_类 遍历点——IR生成多文件 类分支调用）：逐 节点_方法
//   生成方法 IR 并追加程序。
不安全 函数 生成类方法们(向量<节点> 池, 整32 类节点索引, 字符串 模块路径,
                    程序IR& 程序) -> 空类型 {
    节点 类节点 = 池.元素(类节点索引);
    整64 类名ID = 整64(类节点.文本);
    // 416-a（D42 波 2）：泛型基类——方法体经实例克隆体生成（单态化·符号自动含
    //   实例参数）；基类本体不生成（T 字段布局不真实）。克隆类节点由 实例化注册
    //   建好（池尾·生成主循环之前）。
    如果 (查泛型基类参数序(类名ID) != 0) {
        // 430-b 根治：克隆注册表自遍历——原按 泛型实例们（收集表）下标直配
        //   泛型实例类节点们（注册表），但 实例化注册 有双跳过路径（参数序
        整64 nd = 泛型实例类节点们.大小();
        整64 id = 0;
        当 (id < nd) {
            节点 克隆类d = 池.元素(整32(泛型实例类节点们.元素(id)));
            字符串 实例文本d = 字符串复制(驻留文本(整64(克隆类d.文本)));
            如果 (字符串比较(剥实例基名(实例文本d), 字符串复制(驻留文本(类名ID)))) {
                // 462-a（T70 面①根治）：克隆体生成窗口=实例化点模块（"主"）——
                //   原传 基类文件段模块路径（撤守卫态=stdlib 容器模块）→克隆体内
                生成类方法们(池, 整32(泛型实例类节点们.元素(id)), "主", 程序);
            }
            id++;
        }
        返回;
    }
    整64 位置 = 整64(类节点.子起点);
    当 (位置 < 整64(类节点.子终点)) {
        节点 成员 = 池.元素(整32(位置));
        如果 (成员.类型 == 节点_方法) {
            函数IR 函数信息 = 生成方法(池, 整32(位置), 类节点索引, 模块路径);
            结果<空类型, 整32> 加 = 程序.函数们.追加(函数信息);
            如果 (!加.正常) { 运行时错误(4); }
        }
        位置++;
    }
    // 309（2026-10-09）：沿链析构体合成——「本类无用户析构·沿链有析构」的
    //   派生类（568 形态⑥ 猫 实证：RAII 出口 类有析构 沿链判定发 IR_删除对象
    //   （附加=本类名ID），代码生成展开调 析构符号(本类)=猫$~猫 无人定义=
    //   链接失败）。C++ 隐式析构同语义：合成体=成员析构+父析构级联。
    结果<整64, 整32> 本析g = 类析构位们.获取(类名ID);
    如果 (!本析g.正常 && 类有析构(类名ID)) {
        函数IR 合成g = 合成沿链析构体(池, 类节点索引, 模块路径);
        结果<空类型, 整32> 加合g = 程序.函数们.追加(合成g);
        如果 (!加合g.正常) { 运行时错误(4); }
    }
}



// ==================== 607-a（001-001 续）：串字段路径收集（81-a 面） ====================
// 收集结构体类型的拥有串字段**内联偏移路径**（宿主 ownedStrFieldsOf 的运行时
不安全 函数 收集串字段路径(整64 结构体ID, 整64 基偏移, 向量<整64>& 出, 整64 深度) -> 空类型 {
    如果 (深度 > 4) { 返回; }
    向量<整64> 三元组w = 向量<整64>();
    取资源字段们(结构体ID, 三元组w);
    整64 iw = 0;
    当 (iw + 2 < 三元组w.大小()) {
        整64 字段类型IDw = 三元组w.元素(iw + 1);
        整64 合成偏w = 基偏移 + 三元组w.元素(iw + 2);
        如果 (字段类型IDw == 驻留("字符串")) {
            结果<空类型, 整32> 加w = 出.追加(合成偏w);
            如果 (!加w.正常) { 运行时错误(4); }
        } 否则 {
            整64 嵌套键w = 结构体布局键基(字段类型IDw);
            如果 (嵌套键w != 0 && 资源字段数(嵌套键w) > 0) {
                收集串字段路径(嵌套键w, 合成偏w, 出, 深度 + 1);
            }
        }
        iw += 3;
    }
}

// ==================== 514-a（T70 B1 三层②）：容器元素钩子注入 ====================
// 背景：stdlib 容器（容器.cn）的 移动元素/析构元素/析构被移除 三个钩子方法是
函数 方法名是本元素钩子(节点 方法声明, 字符串 钩子名) -> 布尔 {
    返回 字符串比较(字符串复制(驻留文本(整64(方法声明.文本))), 钩子名);
}

// 423（任务 31·宿主 ir_oop_container.cpp arrayField 分派同构）：容器实例的
//   元素数组字段名 ID——向量/栈=数据；链表/队列=值表；集合=数据数组（76-a
//   stdlib 映射集合.cn 集合类私有字段名）；映射=键数组。0=非容器/未知
//   （消费点守卫返回）。原四处注入查死名「数据」→集合$T 钩子注入全 miss
//   （删除前移=空操作·已删值残留→包含(已删)=真·E2E 31 实锤）。
函数 容器数组字段名423(字符串 实例文本) -> 整64 {
    字符串 基名f423 = 合成名基名(实例文本);
    如果 (字符串比较(基名f423, "向量") || 字符串比较(基名f423, "栈")) {
        返回 驻留("数据");
    }
    如果 (字符串比较(基名f423, "链表") || 字符串比较(基名f423, "队列")) {
        返回 驻留("值表");
    }
    如果 (字符串比较(基名f423, "集合")) { 返回 驻留("数据数组"); }
    如果 (字符串比较(基名f423, "映射")) { 返回 驻留("键数组"); }
    返回 0;
}

// 115 同构扩（070 攻族·2026-10-05）：用户类元素析构存在判定——类析构位表
//   （IR类.cn·解析期登记·零生成时序依赖）。字符串/标量元素非用户类=假
//   （对齐宿主：字符串 析构元素 不注入=重复引用释放即悬垂·76-a）。
函数 用户类有析构位(字符串 类型文本) -> 布尔 {
    整64 名ID = 驻留(类型文本);
    如果 (!是用户类ID(名ID)) { 返回 假; }
    返回 类有析构(名ID);
}

不安全 函数 注入元素移动体(向量<节点> 池, 整32 类节点索引, 函数IR& 函数信息,
                   整64* 寄存器计数, 整64* 槽计数) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    // 元素类型文本：实例名（`向量$T`）剥**首个 `$` 前缀**；无 `$`（普通类）→ 不注入
    字符串 类文本 = 字符串复制(驻留文本(整64(池.元素(类节点索引).文本)));
    整64 类长 = 字符串长度(类文本);
    整64 刀位 = -1;
    整64 ci = 0;
    当 (ci < 类长) {
        如果 ((整64(类文本[ci]) & 255) == 36) { 刀位 = ci; 中断; }
        ci++;
    }
    如果 (刀位 < 0) { 返回; }
    字符串 元素文本 = 字符串子串(类文本, 整32(刀位 + 1), 类长 - 刀位 - 1);
    // 703-a：引用形参实例名 & 后缀剥除（同 注入元素析构链 守卫——残留 & 误配
    //   元素布局/符号）
    整64 元长m = 字符串长度(元素文本);
    当 (元长m > 1 && ((整64(元素文本[整32(元长m - 1)]) & 255) == 38)) {
        元素文本 = 字符串子串(元素文本, 0, 整32(元长m - 1));
        元长m--;
    }
    // 元素步长（类型大小表；标量/指针类兜底 8 字节——与宿主 types::typeSizeOf 口径对齐）
    整64 元素大小 = 0;
    整64 元素对齐 = 0;
    类型大小与对齐(元素文本, &元素大小, &元素对齐);
    如果 (元素大小 <= 0) { 元素大小 = 8; }
    // 数据 字段偏移（实例布局键；423 起数组字段名经 容器数组字段名423 按基名
    //   分派：向量/栈=数据·链表/队列=值表·集合=数据数组·映射=键数组——未知
    //   基名 0=不注入让位后续层）
    整64 类ID = 结构体布局键基(整64(池.元素(类节点索引).文本));
    如果 (类ID == 0) { 类ID = 整64(池.元素(类节点索引).文本); }
    // 423（任务 31）：数组字段名按容器基名分派（集合=数据数组·原死名「数据」对集合 miss=零注入）
    整64 数据名ID423 = 容器数组字段名423(类文本);
    如果 (数据名ID423 == 0) { 返回; }
    整64 数据偏移 = 查字段偏移(类ID, 数据名ID423);
    如果 (数据偏移 < 0) { 返回; }
    // 形参槽（移动元素(整64 目标, 整64 源)）
    整64 目标槽 = 0;
    整64 源槽 = 0;
    结果<整64, 整32> 找目标 = 函数信息.参数槽.获取(驻留("目标"));
    如果 (找目标.正常) { 目标槽 = 找目标.值; }
    结果<整64, 整32> 找源 = 函数信息.参数槽.获取(驻留("源"));
    如果 (找源.正常) { 源槽 = 找源.值; }
    如果 (目标槽 == 0 || 源槽 == 0) { 返回; }
    // this → 数据字段地址 → 数据值（元素数组基指针）
    整64 基址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 当前方法this槽, 0, 0, 基址r, T_对象, 0));
    整64 数据地址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 基址r, 0, 0, 数据地址r, T_整64, 数据偏移));
    整64 数据值r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 数据地址r, 0, 0, 数据值r, T_整64, 0));
    // 目标/源 下标值
    整64 目标值r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 目标值r, T_整64, 0));
    整64 源值r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 源槽, 0, 0, 源值r, T_整64, 0));
    // 步长常量槽
    整64 步长r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(元素大小)), 0, 0,
                         步长r, T_整64, 0));
    // 目标地址 = 数据值 + 目标*步长；源地址 = 数据值 + 源*步长
    整64 目标偏r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_乘, 目标值r, 步长r, 0, 目标偏r, T_整64, 0));
    整64 目标址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加, 数据值r, 目标偏r, 0, 目标址r, T_整64, 0));
    整64 源偏r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_乘, 源值r, 步长r, 0, 源偏r, T_整64, 0));
    整64 源址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加, 数据值r, 源偏r, 0, 源址r, T_整64, 0));
    // 整体搬运（结构体拷贝：源地址/目标地址/字节数=步长·对齐宿主 memcpy 语义）
    IR追加(指令, 建IR指令(IR_结构体拷贝, 源址r, 目标址r, 0, 0, 元素大小, 0));
}

// 702-a：容器元素析构链注入（~容器 方法体前·宿主 h698_113.asm ~向量$映射 样板同构）。
//   循环：i=0; 当 (i<元素数量) { ~T(this=数据+i*步长); i++ }——数据==0 短路短路。
不安全 函数 注入元素析构链(向量<节点> 池, 整32 类节点索引, 函数IR& 函数信息,
                   整64* 寄存器计数, 整64* 槽计数) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    字符串 类文本 = 字符串复制(驻留文本(整64(池.元素(类节点索引).文本)));
    // 423 审查修复（P0-1）：链表/队列 让位 221 专用全量析构注入（生成类.cn
    //   365~388 门控体前注入）——本函数 423 起按基名分派查「值表」命中后
    //   与 221 专用链**双重注入**同一循环 ~T（116 实测 析构 4 应 3·元素含
    //   堆资源用户类=double free 风险）。链式容器元素析构职责恒归 221 专用
    //   链（~链表/清空/删除头部/删除尾部），本链只服务平铺容器（向量/栈/
    //   集合）。
    {
        字符串 基名p1 = 合成名基名(类文本);
        如果 (字符串比较(基名p1, "链表") || 字符串比较(基名p1, "队列")) { 返回; }
    }
    整64 类长 = 字符串长度(类文本);
    整64 刀位 = -1;
    整64 ci = 0;
    当 (ci < 类长) {
        如果 ((整64(类文本[ci]) & 255) == 36) { 刀位 = ci; 中断; }
        ci++;
    }
    如果 (刀位 < 0) { 返回; }
    字符串 元素文本 = 字符串子串(类文本, 整32(刀位 + 1), 类长 - 刀位 - 1);
    // 703-a：引用形参实例名带 & 后缀（向量$映射$整64$符号& ← `向量<映射<...>>&`
    //   形参·79_v2 LNK2019 实锤=元素文本残留 & 拼出 映射$整64$符号&$~映射 幻影
    //   符号）——剥尾引用后缀（466-a 窄域剥层同款·循环剥多层）
    整64 元长w = 字符串长度(元素文本);
    当 (元长w > 1 && ((整64(元素文本[整32(元长w - 1)]) & 255) == 38)) {
        元素文本 = 字符串子串(元素文本, 0, 整32(元长w - 1));
        元长w--;
    }
    整64 元素大小 = 0;
    整64 元素对齐 = 0;
    类型大小与对齐(元素文本, &元素大小, &元素对齐);
    如果 (元素大小 <= 0) { 返回; }
    整64 类ID = 结构体布局键基(整64(池.元素(类节点索引).文本));
    如果 (类ID == 0) { 类ID = 整64(池.元素(类节点索引).文本); }
    // 423（任务 31）：数组字段名按容器基名分派（同 注入元素移动体）
    整64 数据名IDd423 = 容器数组字段名423(类文本);
    如果 (数据名IDd423 == 0) { 返回; }
    整64 数据偏移 = 查字段偏移(类ID, 数据名IDd423);
    如果 (数据偏移 < 0) { 返回; }
    整64 数量偏移 = 查字段偏移(类ID, 驻留("元素数量"));
    如果 (数量偏移 < 0) { 返回; }
    // 元素析构存在判定：~T 方法签名（析构符号=映射$整64$符号$~映射 形态·
    //   方法名=~+剥实例基名——v2 生成方法链符号「~」前缀判定同口径）
    如果 (!是容器类(元素文本) && !用户类有析构位(元素文本)) { 返回; }
    // this → 数据值（元素数组基指针）与 元素数量值
    整64 基址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 当前方法this槽, 0, 0, 基址r, T_对象, 0));
    整64 数据地址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 基址r, 0, 0, 数据地址r, T_整64, 数据偏移));
    整64 数据值r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 数据地址r, 0, 0, 数据值r, T_整64, 0));
    整64 数量地址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 基址r, 0, 0, 数量地址r, T_整64, 数量偏移));
    整64 数量值r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 数量地址r, 0, 0, 数量值r, T_整64, 0));
    // 隐藏索引 i 槽（宿主 ?ewi99 同款）置 0
    整64 i槽 = 槽计数[0];
    槽计数[0] = 槽计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, i槽));
    整64 零r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零r, T_整64, 0));
    IR追加(指令, 建IR指令(IR_存储, 零r, 0, 0, 0, 0, i槽));
    // 步长常量
    整64 步长r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(元素大小)), 0, 0,
                         步长r, T_整64, 0));
    // 块链：头块(条件)/体块(析构+递增+回跳)/尾块(方法体续)
    整64 头块 = 新块(函数信息);
    整64 体块 = 新块(函数信息);
    整64 尾块 = 新块(函数信息);
    发射跳转(函数信息, 头块);
    切换块(函数信息, 头块);
    发射块标签(函数信息, 头块);
    整64 ir值r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, i槽, 0, 0, ir值r, T_整64, 0));
    整64 条件r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_小于, ir值r, 数量值r, 0, 条件r, T_整64, 0));
    发射条件跳转(函数信息, 条件r, 体块, 尾块);
    切换块(函数信息, 体块);
    发射块标签(函数信息, 体块);
    // 元素地址 = 数据值 + i*步长；call ~T(this=元素地址)
    整64 ir值r2 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, i槽, 0, 0, ir值r2, T_整64, 0));
    整64 偏r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_乘, ir值r2, 步长r, 0, 偏r, T_整64, 0));
    整64 址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加, 数据值r, 偏r, 0, 址r, T_整64, 0));
    IR追加(指令, 建IR指令(IR_调用实参, 址r, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                         驻留(析构符号(元素文本))));
    // i++
    整64 一r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("1"), 0, 0, 一r, T_整64, 0));
    整64 新ir = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加, ir值r2, 一r, 0, 新ir, T_整64, 0));
    IR追加(指令, 建IR指令(IR_存储, 新ir, 0, 0, 0, 0, i槽));
    发射跳转(函数信息, 头块);
    切换块(函数信息, 尾块);
    发射块标签(函数信息, 尾块);
}

// 115 同构扩（070 攻族·2026-10-05）：「析构元素(整64 索引)」单元素析构注入——
//   stdlib 删除/插入 移位循环单点释放钩子（空体+编译器注入契约·宿主
不安全 函数 注入元素单析构(向量<节点> 池, 整32 类节点索引, 函数IR& 函数信息,
                   整64* 寄存器计数, 整64* 槽计数) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    字符串 类文本d = 字符串复制(驻留文本(整64(池.元素(类节点索引).文本)));
    整64 类长d = 字符串长度(类文本d);
    整64 刀位d = -1;
    整64 ci = 0;
    当 (ci < 类长d) {
        如果 ((整64(类文本d[ci]) & 255) == 36) { 刀位d = ci; 中断; }
        ci++;
    }
    如果 (刀位d < 0) { 返回; }
    字符串 元素文本d = 字符串子串(类文本d, 整32(刀位d + 1), 类长d - 刀位d - 1);
    整64 元长d = 字符串长度(元素文本d);
    当 (元长d > 1 && ((整64(元素文本d[整32(元长d - 1)]) & 255) == 38)) {
        元素文本d = 字符串子串(元素文本d, 0, 整32(元长d - 1));
        元长d--;
    }
    如果 (!是容器类(元素文本d) && !用户类有析构位(元素文本d)) { 返回; }
    整64 元素大小d = 0;
    整64 元素对齐d = 0;
    类型大小与对齐(元素文本d, &元素大小d, &元素对齐d);
    如果 (元素大小d <= 0) { 返回; }
    整64 类IDd = 结构体布局键基(整64(池.元素(类节点索引).文本));
    如果 (类IDd == 0) { 类IDd = 整64(池.元素(类节点索引).文本); }
    // 423（任务 31）：数组字段名按容器基名分派（同 注入元素移动体）
    整64 数据名IDs423 = 容器数组字段名423(类文本d);
    如果 (数据名IDs423 == 0) { 返回; }
    整64 数据偏移d = 查字段偏移(类IDd, 数据名IDs423);
    如果 (数据偏移d < 0) { 返回; }
    整64 数量偏移d = 查字段偏移(类IDd, 驻留("元素数量"));
    如果 (数量偏移d < 0) { 返回; }
    整64 索引槽d = 0;
    结果<整64, 整32> 找索引d = 函数信息.参数槽.获取(驻留("索引"));
    如果 (找索引d.正常) { 索引槽d = 找索引d.值; }
    如果 (索引槽d == 0) { 返回; }
    // this → 数据值（元素数组基指针）与 元素数量值
    整64 基址d = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 当前方法this槽, 0, 0, 基址d, T_对象, 0));
    整64 数据地址d = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 基址d, 0, 0, 数据地址d, T_整64, 数据偏移d));
    整64 数据值d = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 数据地址d, 0, 0, 数据值d, T_整64, 0));
    整64 数量地址d = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 基址d, 0, 0, 数量地址d, T_整64, 数量偏移d));
    整64 数量值d = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 数量地址d, 0, 0, 数量值d, T_整64, 0));
    整64 索引值d = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 索引槽d, 0, 0, 索引值d, T_整64, 0));
    // 步长常量
    整64 步长d = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(元素大小d)), 0, 0,
                         步长d, T_整64, 0));
    // 守卫块链：析构条件 = 0<=索引<元素数量（两次条件跳转组合·无逻辑或码）——
    //   守卫块(索引<0?→跳过)/判定块(索引>=数量?→跳过)/释放块(call ~T)/跳过块(方法体续)
    整64 守卫块d = 新块(函数信息);
    整64 判定块d = 新块(函数信息);
    整64 释放块d = 新块(函数信息);
    整64 跳过块d = 新块(函数信息);
    整64 零r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零r, T_整64, 0));
    发射跳转(函数信息, 守卫块d);
    切换块(函数信息, 守卫块d);
    发射块标签(函数信息, 守卫块d);
    整64 负判定r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_小于, 索引值d, 零r, 0, 负判定r, T_整64, 0));
    发射条件跳转(函数信息, 负判定r, 跳过块d, 判定块d);
    切换块(函数信息, 判定块d);
    发射块标签(函数信息, 判定块d);
    整64 越判定r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_大于等于, 索引值d, 数量值d, 0, 越判定r, T_整64, 0));
    发射条件跳转(函数信息, 越判定r, 跳过块d, 释放块d);
    切换块(函数信息, 释放块d);
    发射块标签(函数信息, 释放块d);
    // 元素地址 = 数据值 + 索引*步长；call ~T(this=元素地址)
    整64 偏移r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_乘, 索引值d, 步长d, 0, 偏移r, T_整64, 0));
    整64 元素址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加, 数据值d, 偏移r, 0, 元素址r, T_整64, 0));
    IR追加(指令, 建IR指令(IR_调用实参, 元素址r, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                         驻留(析构符号(元素文本d))));
    发射跳转(函数信息, 跳过块d);
    切换块(函数信息, 跳过块d);
    发射块标签(函数信息, 跳过块d);
}

// 221（116 泄漏面）：链表 删除头部/删除尾部 的被摘元素析构注入（体首·宿主
//   ir_oop_call_release emitClassMethod 同构——索引=删除前 头/尾索引 旧值）。
不安全 函数 注入链表删单析构(字符串 元素文本n, 布尔 删尾n, 函数IR& 函数信息,
                   整64* 寄存器计数) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    整64 大小n = 0;
    整64 对齐n = 0;
    类型大小与对齐(元素文本n, &大小n, &对齐n);
    如果 (大小n <= 0) { 返回; }
    整64 this寄n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 当前方法this槽, 0, 0, this寄n, T_对象, 0));
    字符串 索名n = "头索引";
    如果 (删尾n) { 索名n = "尾索引"; }
    整64 索偏n = 当前方法字段偏移(驻留(索名n));
    如果 (索偏n < 0) { 返回; }
    整64 索址n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, this寄n, 0, 0, 索址n, T_整64, 索偏n));
    整64 索值n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 索址n, 0, 0, 索值n, T_整64, 0));
    整64 表偏n = 当前方法字段偏移(驻留("值表"));
    如果 (表偏n < 0) { 返回; }
    整64 表址n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, this寄n, 0, 0, 表址n, T_整64, 表偏n));
    整64 表值n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 表址n, 0, 0, 表值n, T_整64, 0));
    整64 数偏n = 当前方法字段偏移(驻留("元素数量"));
    如果 (数偏n < 0) { 返回; }
    整64 数址n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, this寄n, 0, 0, 数址n, T_整64, 数偏n));
    整64 数值n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 数址n, 0, 0, 数值n, T_整64, 0));
    整64 步n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(大小n)), 0, 0,
                         步n, T_整64, 0));
    // [221 实验甲] 守卫块链直发化（stdlib 保证 删头/删尾 索引合法——单变量
    //   验证「守卫块链×方法体块链交互」是否 C374 刀口·验后按结果定夺）
    整64 零n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零n, T_整64, 0));
    整64 偏n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_乘, 索值n, 步n, 0, 偏n, T_整64, 0));
    整64 槽n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加, 表值n, 偏n, 0, 槽n, T_整64, 0));
    整64 句n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 槽n, 0, 0, 句n, T_整64, 0));
    IR追加(指令, 建IR指令(IR_调用实参, 句n, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                         驻留(析构符号(元素文本n))));
}

// 221（全量循环析构·~链表/清空 体首·宿主 ir_oop_call_release 同构）：对剩余
//   内联元素逐个 ~T（有析构用户类；无析构=no-op 判据守卫）——内联模型下
不安全 函数 注入链表全量析构(字符串 元素文本n, 整64 索引槽n, 函数IR& 函数信息,
                   整64* 寄存器计数) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    整64 大小n = 0;
    整64 对齐n = 0;
    类型大小与对齐(元素文本n, &大小n, &对齐n);
    如果 (大小n <= 0) { 返回; }
    整64 this寄n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 当前方法this槽, 0, 0, this寄n, T_对象, 0));
    整64 表偏n = 当前方法字段偏移(驻留("值表"));
    整64 数偏n = 当前方法字段偏移(驻留("元素数量"));
    如果 (表偏n < 0 || 数偏n < 0) { 返回; }
    整64 条件n = 新块(函数信息);
    整64 体n = 新块(函数信息);
    整64 尾块n = 新块(函数信息);
    整64 零n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零n, T_整64, 0));
    IR追加(指令, 建IR指令(IR_存储, 零n, 0, 0, 0, 0, 索引槽n));
    发射跳转(函数信息, 条件n);
    切换块(函数信息, 条件n);
    发射块标签(函数信息, 条件n);
    整64 数址n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, this寄n, 0, 0, 数址n, T_整64, 数偏n));
    整64 数值n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 数址n, 0, 0, 数值n, T_整64, 0));
    整64 索值n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 索引槽n, 0, 0, 索值n, T_整64, 0));
    整64 判n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_小于, 索值n, 数值n, 0, 判n, T_整64, 0));
    发射条件跳转(函数信息, 判n, 体n, 尾块n);
    切换块(函数信息, 体n);
    发射块标签(函数信息, 体n);
    整64 表址n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, this寄n, 0, 0, 表址n, T_整64, 表偏n));
    整64 表值n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 表址n, 0, 0, 表值n, T_整64, 0));
    整64 步n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(大小n)), 0, 0,
                         步n, T_整64, 0));
    整64 偏n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_乘, 索值n, 步n, 0, 偏n, T_整64, 0));
    整64 槽址n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加, 表值n, 偏n, 0, 槽址n, T_整64, 0));
    IR追加(指令, 建IR指令(IR_调用实参, 槽址n, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                         驻留(析构符号(元素文本n))));
    整64 一n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("1"), 0, 0, 一n, T_整64, 0));
    整64 加n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加, 索值n, 一n, 0, 加n, T_整64, 0));
    IR追加(指令, 建IR指令(IR_存储, 加n, 0, 0, 0, 0, 索引槽n));
    发射跳转(函数信息, 条件n);
    切换块(函数信息, 尾块n);
    发射块标签(函数信息, 尾块n);
}
// 438 根治（423 族·284 形态④⑤·复制声明位在册泄漏 +2）：右值=复制(…)调用形态 →
//   产物=堆对象句柄，**接管直存**（82-a 返回接收接管同款语义）。
//   缺陷链（探针矩阵实证·宿主净 0/v2 残留 +2）：右值 复制(甲) 求值时 LUE 命中
//   （纯局部标识符+后向无读）→ 生成复制展开LUEmove 源槽清零（所有权移交）；原
//   拷贝构造初始化通道再拿该句柄当源 NewObject+拷贝构造深拷——复制语义与 move
//   语义混搭：乙=深拷新壳，甲 原壳（连同其字段容器与元素）因源槽已清零失去唯一
//   持有者成孤儿 → 块出口仅回收乙 深拷一方（任务行「深拷后块出口仅回收一方」
//   实录；活分配数 +2=原数据数组+原字符串，原壳/字段容器壳 calloc 不计数同泄漏）。
//   非 LUE 态（源后向有读）同泄漏形态：复制 内置 ③ 分支已 NewObject 独立深拷壳，
//   原通道再拷一次=双重深拷+临时壳孤儿（719 反证实证：撤修复 v2 退出码 9=②③两态
//   同红）。修复后两态皆句柄接管：LUE 态=move 接管（宿主 LUE 零拷贝对齐）、
//   非 LUE 态=消双重拷贝（③ 壳直存），块出口在册回收槽句柄一方、源方按各自语义
//   （LUE 已移交/非 LUE 保持拥有）回收——探针矩阵四形态双侧净 0。
//   返回 真=已接管直存终结（跳过 NewObject+拷贝构造主路径）；假=非复制形态落主路径。
不安全 函数 发射类复制声明接管(向量<节点> 池, 节点 n, 整64 类名ID, 整64 槽c,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    节点 复源末438 = 池.元素(n.子终点 - 1);
    如果 (!(复源末438.类型 == 节点_调用 && 复源末438.子起点 >= 0 &&
         整32(复源末438.子起点) < 整32(池.大小()))) { 返回 假; }
    节点 复被调438 = 池.元素(整32(复源末438.子起点));
    如果 (!(复被调438.类型 == 节点_标识符 &&
         字符串比较(驻留文本(整64(复被调438.文本)), "复制"))) { 返回 假; }
    // 完整求值右值（复制 展开：LUE 态=源槽清零+句柄移交/非 LUE 态=③ 独立深拷壳）
    整64 句柄438 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                               指令, 寄存器计数, &函数信息.块计数, 槽计数,
                               表达式栈);
    如果 (句柄438 != 0) {
        IR追加(指令, 建IR指令(IR_存储, 句柄438, 0, 0, 0, 0, 槽c));
    }
    当 (表达式栈.大小() > 0) {
        结果<空类型, 整32> 删栈438 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈438.正常) { 运行时错误(4); }
    }
    返回 真;
}

不安全 函数 发射类拷贝构造初始化(向量<节点> 池, 节点 n, 字符串 类型文本, 整64 类名ID, 整64 槽c,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
        // 438 根治：右值=复制(…) → 句柄接管判定移交 发射类复制声明接管
        //   （真=已直存终结·假=非复制形态落 NewObject+拷贝构造主路径）。
        如果 (发射类复制声明接管(池, n, 类名ID, 槽c, 局部槽, 参数槽, 函数信息,
                              寄存器计数, 槽计数, 表达式栈)) { 返回; }
        // 438-b 根①：类对象拷贝初始化 b = a——分配新对象 + 拷贝构造(this=新，
        //   其他=源)（Rust Clone::clone 同构；与 发射用户类构造 同 ABI）。拷贝
        //   构造缺失→维持既有拒绝诊断（克隆契约：无拷贝构造不可独立拥有）。
        整64 拷贝串ID = 查类拷贝构造串(类名ID);
        如果 (拷贝串ID == 0) {
            IR层诊断("类对象初始化仅支持构造调用（类 " + 类型文本 +
                          "；拷贝/其它形态随后续轮次）");
            运行时错误(6);
        }
        字符串 拷贝串 = 字符串复制(驻留文本(拷贝串ID));
        整64 新obj = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新obj,
                             查结构体大小(类名ID), 类名ID));
        // 448-b 根治（44#2 多余解引用·撤守卫态 111 SEGV·D42 波 3 收口）：
        //   拷贝构造 T& 形参侧=引用槽模型（发射引用参数读 容器& 双解：Load 槽
        整64 源地址reg = 0;
        节点 源末448b = 池.元素(n.子终点 - 1);
        如果 (源末448b.类型 == 节点_标识符) {
            整64 源槽448b = 0;
            结果<整64, 整32> 找源局448b = 局部槽.获取(整64(源末448b.文本));
            如果 (找源局448b.正常) { 源槽448b = 找源局448b.值; }
            如果 (源槽448b == 0) {
                结果<整64, 整32> 找源参448b = 参数槽.获取(整64(源末448b.文本));
                如果 (找源参448b.正常) { 源槽448b = 找源参448b.值; }
            }
            如果 (源槽448b != 0) {
                源地址reg = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                如果 (槽是引用(源槽448b)) {
                    IR追加(指令, 建IR指令(IR_加载, 源槽448b, 0, 0, 源地址reg, T_对象, 0));
                } 否则 {
                    IR追加(指令, 建IR指令(IR_取地址, 源槽448b, 0, 0, 源地址reg, T_整64, 0));
                }
            } 否则 {
                整64 找源静448b = 查静态序号含类(整64(源末448b.文本));
                如果 (找源静448b >= 0) {
                    源地址reg = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 源地址reg,
                                         T_对象, 找源静448b));
                }
            }
        }
        如果 (源地址reg == 0) {
            整64 源值448b = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                         指令, 寄存器计数, &函数信息.块计数, 槽计数,
                                         表达式栈);
            整64 hold槽448b = 槽计数[0];
            槽计数[0] = 槽计数[0] + 1;
            IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, hold槽448b));
            IR追加(指令, 建IR指令(IR_存储, 源值448b, 0, 0, 0, 0, hold槽448b));
            源地址reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_取地址, hold槽448b, 0, 0, 源地址reg, T_整64, 0));
            当 (表达式栈.大小() > 0) {
                结果<空类型, 整32> 删源448b = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删源448b.正常) { 运行时错误(4); }
            }
        }
        IR追加(指令, 建IR指令(IR_调用实参, 新obj, 0, 0, 0, 0, 0));
        IR追加(指令, 建IR指令(IR_调用实参, 源地址reg, 0, 0, 0, 1, 0));
        IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                             驻留(方法符号(类型文本, 剥实例基名(类型文本), 拷贝串))));
        IR追加(指令, 建IR指令(IR_存储, 新obj, 0, 0, 0, 0, 槽c));
        当 (表达式栈.大小() > 0) {
            结果<空类型, 整32> 删栈k = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈k.正常) { 运行时错误(4); }
        }
        返回;
}



// ==================== 413：接口方法调用发射（2026-10-11 接口语法族） ====================
// plans/006 P3-19 B1 全局槽位分派 + plans/008 D3A 去虚拟化（宿主
//   ir_oop_call.cpp tryInterfaceMethodCall 同构）：
//   · 去虚拟化：接口全局唯一实现类 → 编译期直调该类实现方法（跳过 LoadPtr+
//     间接调用，热路径省 1 次间接跳转；实现类数含继承链并入——解析类继承登记
//     基类沿链接口补登·多实现回退间接分派，与宿主 interfaceImplClasses 同口径；
//     宿主另排除抽象类——v2 无抽象类面·将来同步）
//   · 间接路径：LoadPtr(对象.接口区[槽]=对象+8+槽*8) → IR_间接调用
//     （this=位0·实参位1..——IR_调用实参/间接调用 与函数指针通道同 ABI）
// 接口变量=对象地址本身（A1 零指针调整），this 直传不转换。
// 聚合返回（413-b 审查修复·宿主实测绿：接口 I{取点()->点} 输出 x:3 y:4）：
//   直调=用户类聚合 retbuf 发射先例（发射用户类方法调用 T87/421 同形态——
//   类型位=retbuf 槽·位0=retbuf/位1=this·返回寄存器=MS/SysV ABI 隐藏指针）；
//   间接=IR_间接调用 类型位形态（三后端 retbuf 前导位·对照宿主 CallIndirect
//   聚合通道）——retbuf 地址压栈供 .x/.y 成员消费。
不安全 函数 发射接口方法调用(字符串 接口名文本, 字符串 方法名文本, 整64 this寄存器,
                   向量<整64>& 弹出们, 整64 实参数, 向量<IR指令>& 指令,
                   整64* 寄存器计数, 整64* 槽计数, 向量<整64>& 表达式栈,
                   整64 retbuf序号) -> 空类型 {
    整64 接口IDk = 驻留(接口名文本);
    整64 方法IDk = 驻留(方法名文本);
    整64 槽k = 查接口方法槽(接口IDk, 方法IDk);
    如果 (槽k < 0) {
        IR层诊断("接口无此方法: " + 接口名文本 + "." + 方法名文本);
        运行时错误(6);
    }
    整64 返回类型IDk = 查接口方法返回(接口IDk, 方法IDk);
    字符串 返回文本k = "";
    如果 (返回类型IDk != 0) { 返回文本k = 字符串复制(驻留文本(返回类型IDk)); }
    整64 参数串IDk = 查接口方法参数串(接口IDk, 方法IDk);
    如果 (参数串IDk != 0 && 参数段个数(字符串复制(驻留文本(参数串IDk))) != 实参数) {
        IR层诊断("接口方法调用实参数不匹配（" + 接口名文本 + "." + 方法名文本 +
                      "：期望 " + 整数转字符串(参数段个数(字符串复制(驻留文本(参数串IDk)))) +
                      " 个）");
        运行时错误(6);
    }
    // 552（接口方法 × 128 形参双侧同案·v2 侧）：接口方法实参回扫——128 位
    //   窄实参物化双槽句柄 + 结构体按值实参取地址，与 442 静态方法/实例方法/
    //   构造/普通函数四路径同款表驱动（回扫结构体与引用实参 单点机制）。
    //   原缺 → 窄实参按 64 位值直传、被调 prologue 按双槽地址 rep movsb
    //   解引用 SIGSEGV（探针 552pe2：引用.取整(42) rc=139 实锤）；结构体按值
    //   实参传字段值当基址同崩（探针 552st1 rc=139·宿主绿=分叉）。
    //   表键=接口方法符号*键位移+实参序（登记点=收集接口方法实参表·接口方法
    //   无池节点，键自接口名/方法名/参数串 合成——此处同公式复算，单一归属）。
    //   直调/间接两分支共用本回扫（弹出们 为同一实参序列——先于分叉执行）。
    字符串 参数串552 = "";
    如果 (参数串IDk != 0) { 参数串552 = 字符串复制(驻留文本(参数串IDk)); }
    回扫结构体与引用实参(弹出们, 整64(驻留(方法符号(接口名文本, 方法名文本,
                                                   参数串552))),
                         指令, 寄存器计数, 槽计数);
    // 聚合返回判定（结构体/容器/结果/数组/128 位——宿主 mapType+聚合通道同族；
    // 413-b 前版此处硬拒=与宿主实测绿分叉·已撤）
    布尔 返回128k = (字符串比较(返回文本k, "整128") || 字符串比较(返回文本k, "正128"));
    布尔 聚合返回k = (查结构体大小(返回类型IDk) != 0 || 是容器类(返回文本k) ||
                     是结果类型(返回文本k) || 是数组类型文本(返回文本k) || 返回128k);
    整64 返回码k = 0;
    如果 (返回类型IDk != 0) { 返回码k = 类型码(返回类型IDk); }
    整64 retbuf槽k = 0;
    整64 起始位k = 1;
    整64 目标寄存器k = 0;
    如果 (聚合返回k) {
        // 聚合 retbuf 形态（用户类聚合直调先例同构）：返回码=0（地址标 0 整型
        //   类）·retbuf 尺寸登记（帧预留——585-a/087b/421 兜底同族）
        返回码k = 0;
        整64 返回字节k = 查结构体大小(返回类型IDk);
        如果 (返回字节k == 0 && 是结果类型(返回文本k)) { 返回字节k = 结果大小(返回文本k); }
        如果 (返回字节k == 0 && 是数组类型文本(返回文本k)) { 返回字节k = 类型名宽度(返回类型IDk); }
        如果 (返回字节k == 0 && 返回128k) { 返回字节k = 16; }
        累计retbuf字节数(返回字节k);
        retbuf槽k = retbuf序号;
        起始位k = 2;   // 位0=retbuf·位1=this·位2..=实参
        // 聚合无条件分配目标寄存器（=retbuf 地址句柄·用户类聚合分支同款——
        //   返回码已改写 0（T_未知），沿用标量判定会漏分配压栈 0）
        目标寄存器k = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
    } 否则 如果 (返回码k != T_空类型 && 返回码k != T_未知) {
        目标寄存器k = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
    }
    // D3A 去虚拟化：全局唯一实现类 → 直调实现方法符号（继承实现=沿链定义层）
    如果 (接口实现类数(接口IDk) == 1) {
        整64 唯一类k = 接口唯一实现(接口IDk);
        整64 定义层k = 查类方法定义层(唯一类k, 方法IDk);
        如果 (定义层k != 0) {
            字符串 定义类名k = 字符串复制(驻留文本(定义层k));
            字符串 参数串k = "";
            整64 定义串IDk = 查类方法参数串(定义层k, 方法IDk);
            如果 (定义串IDk != 0) { 参数串k = 字符串复制(驻留文本(定义串IDk)); }
            整64 符号IDk = 整64(驻留(方法符号(定义类名k, 方法名文本, 参数串k)));
            IR追加(指令, 建IR指令(IR_调用实参, this寄存器, 0, 0, 0, 起始位k - 1, 0));
            发射调用实参们(弹出们, 起始位k, 指令, 实参类型码们(弹出们));
            // retbuf 槽：标量返回传 0（非聚合不走 retbuf 形态——类型位≠0 即被
            //   后端判 retbuf 调用·413 直调 rcx 占用实录）；聚合传 retbuf序号
            IR追加(指令, 建IR指令(IR_调用参数化, 起始位k + 实参数, 返回码k, 0,
                                 目标寄存器k, retbuf槽k, 符号IDk));
            如果 (聚合返回k) {
                // 421：128 位标量返回的 retbuf 句柄登记（打印传址/实参物化分派）
                如果 (返回128k) {
                    登记寄存器类型(目标寄存器k, 类型码(返回类型IDk));
                }
                // retbuf 地址压栈（.x/.y 成员消费——用户类聚合分支同款不标量登记；
                // 目标=MS/SysV ABI 隐藏指针·返回装载 mov 目标,rax 同值）
                结果<空类型, 整32> 加直聚k = 表达式栈.追加(目标寄存器k);
                如果 (!加直聚k.正常) { 运行时错误(4); }
                返回;
            }
            如果 (目标寄存器k != 0) {
                登记寄存器类型(目标寄存器k, 返回码k);
                结果<空类型, 整32> 加直k = 表达式栈.追加(目标寄存器k);
                如果 (!加直k.正常) { 运行时错误(4); }
            }
            返回;
        }
    }
    // 间接路径：接口区偏移 = 8（vptr）+ 槽*8（解析布局 [vptr][接口区][字段区]）
    整64 区址寄存器k = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, this寄存器, 0, 0,
                         区址寄存器k, T_整64, 8 + 槽k * 8));
    整64 方法址寄存器k = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 区址寄存器k, 0, 0,
                         方法址寄存器k, T_整64, 0));
    IR追加(指令, 建IR指令(IR_调用实参, this寄存器, 0, 0, 0, 起始位k - 1, 0));
    发射调用实参们(弹出们, 起始位k, 指令, 实参类型码们(弹出们));
    // 类型位=retbuf槽（聚合形态·三后端 retbuf 前导位；标量=0 维持既有 ABI）
    IR追加(指令, 建IR指令(IR_间接调用, 起始位k + 实参数, 返回码k, 0,
                         目标寄存器k, retbuf槽k, 方法址寄存器k));
    如果 (聚合返回k) {
        // 421：128 位标量返回的 retbuf 句柄登记（同直调聚合）
        如果 (返回128k) {
            登记寄存器类型(目标寄存器k, 类型码(返回类型IDk));
        }
        // retbuf 地址压栈（间接聚合——返回装载 mov 目标,rax 隐藏指针同值）
        结果<空类型, 整32> 加间聚k = 表达式栈.追加(目标寄存器k);
        如果 (!加间聚k.正常) { 运行时错误(4); }
        返回;
    }
    如果 (目标寄存器k != 0) {
        登记寄存器类型(目标寄存器k, 返回码k);
        结果<空类型, 整32> 加间k = 表达式栈.追加(目标寄存器k);
        如果 (!加间k.正常) { 运行时错误(4); }
    }
}
