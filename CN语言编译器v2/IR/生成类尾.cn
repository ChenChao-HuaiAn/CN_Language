// 生成类尾（356 重构F1 自 生成类.cn 纯机械搬移·函数体逐字保留·零逻辑变化）
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_* 常量
导入 IR;         // IR_*/T_* 操作码 + 类表/布局查询/符号合成
导入 协议常量;   // 335 重构B：协议常量独立包
导入 IR生成;     // 程序IR 布局 + 类型码/权威表/控制流辅助

公开:

// 生成类方法们（节点_类 遍历点——IR生成多文件 类分支调用）：逐 节点_方法
//   生成方法 IR 并追加程序。
不安全 函数 生成类方法们(向量<节点> 池, 整32 类节点索引, 字符串 模块路径,
                    程序IR& 程序) -> 空类型 {
    节点 类节点 = 池.元素(类节点索引);
    整64 类名ID = 整64(类节点.文本);
    // 416-a（D42 波 2）：泛型基类——方法体经实例克隆体生成（单态化·符号自动含
    //   实例参数）；基类本体不生成（T 字段布局不真实）。克隆类节点由 实例化注册
    //   建好（池尾·生成主循环之前）。
    如果 (查泛型基类参数序(类名ID) != 0) {
        // 430-b 根治：克隆注册表自遍历——原按 泛型实例们（收集表）下标直配
        //   泛型实例类节点们（注册表），但 实例化注册 有双跳过路径（参数序
        整64 nd = 泛型实例类节点们.大小();
        整64 id = 0;
        当 (id < nd) {
            节点 克隆类d = 池.元素(整32(泛型实例类节点们.元素(id)));
            字符串 实例文本d = 字符串复制(驻留文本(整64(克隆类d.文本)));
            如果 (字符串比较(剥实例基名(实例文本d), 字符串复制(驻留文本(类名ID)))) {
                // 462-a（T70 面①根治）：克隆体生成窗口=实例化点模块（"主"）——
                //   原传 基类文件段模块路径（撤守卫态=stdlib 容器模块）→克隆体内
                生成类方法们(池, 整32(泛型实例类节点们.元素(id)), "主", 程序);
            }
            id++;
        }
        返回;
    }
    整64 位置 = 整64(类节点.子起点);
    当 (位置 < 整64(类节点.子终点)) {
        节点 成员 = 池.元素(整32(位置));
        如果 (成员.类型 == 节点_方法) {
            函数IR 函数信息 = 生成方法(池, 整32(位置), 类节点索引, 模块路径);
            结果<空类型, 整32> 加 = 程序.函数们.追加(函数信息);
            如果 (!加.正常) { 运行时错误(4); }
        }
        位置++;
    }
    // 309（2026-10-09）：沿链析构体合成——「本类无用户析构·沿链有析构」的
    //   派生类（568 形态⑥ 猫 实证：RAII 出口 类有析构 沿链判定发 IR_删除对象
    //   （附加=本类名ID），代码生成展开调 析构符号(本类)=猫$~猫 无人定义=
    //   链接失败）。C++ 隐式析构同语义：合成体=成员析构+父析构级联。
    结果<整64, 整32> 本析g = 类析构位们.获取(类名ID);
    如果 (!本析g.正常 && 类有析构(类名ID)) {
        函数IR 合成g = 合成沿链析构体(池, 类节点索引, 模块路径);
        结果<空类型, 整32> 加合g = 程序.函数们.追加(合成g);
        如果 (!加合g.正常) { 运行时错误(4); }
    }
}



// ==================== 607-a（001-001 续）：串字段路径收集（81-a 面） ====================
// 收集结构体类型的拥有串字段**内联偏移路径**（宿主 ownedStrFieldsOf 的运行时
不安全 函数 收集串字段路径(整64 结构体ID, 整64 基偏移, 向量<整64>& 出, 整64 深度) -> 空类型 {
    如果 (深度 > 4) { 返回; }
    向量<整64> 三元组w = 向量<整64>();
    取资源字段们(结构体ID, 三元组w);
    整64 iw = 0;
    当 (iw + 2 < 三元组w.大小()) {
        整64 字段类型IDw = 三元组w.元素(iw + 1);
        整64 合成偏w = 基偏移 + 三元组w.元素(iw + 2);
        如果 (字段类型IDw == 驻留("字符串")) {
            结果<空类型, 整32> 加w = 出.追加(合成偏w);
            如果 (!加w.正常) { 运行时错误(4); }
        } 否则 {
            整64 嵌套键w = 结构体布局键基(字段类型IDw);
            如果 (嵌套键w != 0 && 资源字段数(嵌套键w) > 0) {
                收集串字段路径(嵌套键w, 合成偏w, 出, 深度 + 1);
            }
        }
        iw += 3;
    }
}

// ==================== 514-a（T70 B1 三层②）：容器元素钩子注入 ====================
// 背景：stdlib 容器（容器.cn）的 移动元素/析构元素/析构被移除 三个钩子方法是
函数 方法名是本元素钩子(节点 方法声明, 字符串 钩子名) -> 布尔 {
    返回 字符串比较(字符串复制(驻留文本(整64(方法声明.文本))), 钩子名);
}

// 115 同构扩（070 攻族·2026-10-05）：用户类元素析构存在判定——类析构位表
//   （IR类.cn·解析期登记·零生成时序依赖）。字符串/标量元素非用户类=假
//   （对齐宿主：字符串 析构元素 不注入=重复引用释放即悬垂·76-a）。
函数 用户类有析构位(字符串 类型文本) -> 布尔 {
    整64 名ID = 驻留(类型文本);
    如果 (!是用户类ID(名ID)) { 返回 假; }
    返回 类有析构(名ID);
}

不安全 函数 注入元素移动体(向量<节点> 池, 整32 类节点索引, 函数IR& 函数信息,
                   整64* 寄存器计数, 整64* 槽计数) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    // 元素类型文本：实例名（`向量$T`）剥**首个 `$` 前缀**；无 `$`（普通类）→ 不注入
    字符串 类文本 = 字符串复制(驻留文本(整64(池.元素(类节点索引).文本)));
    整64 类长 = 字符串长度(类文本);
    整64 刀位 = -1;
    整64 ci = 0;
    当 (ci < 类长) {
        如果 ((整64(类文本[ci]) & 255) == 36) { 刀位 = ci; 中断; }
        ci++;
    }
    如果 (刀位 < 0) { 返回; }
    字符串 元素文本 = 字符串子串(类文本, 整32(刀位 + 1), 类长 - 刀位 - 1);
    // 703-a：引用形参实例名 & 后缀剥除（同 注入元素析构链 守卫——残留 & 误配
    //   元素布局/符号）
    整64 元长m = 字符串长度(元素文本);
    当 (元长m > 1 && ((整64(元素文本[整32(元长m - 1)]) & 255) == 38)) {
        元素文本 = 字符串子串(元素文本, 0, 整32(元长m - 1));
        元长m--;
    }
    // 元素步长（类型大小表；标量/指针类兜底 8 字节——与宿主 types::typeSizeOf 口径对齐）
    整64 元素大小 = 0;
    整64 元素对齐 = 0;
    类型大小与对齐(元素文本, &元素大小, &元素对齐);
    如果 (元素大小 <= 0) { 元素大小 = 8; }
    // 数据 字段偏移（实例布局键；栈/队列/映射 字段名各异 → 查不到即不注入=让位后续层）
    整64 类ID = 结构体布局键基(整64(池.元素(类节点索引).文本));
    如果 (类ID == 0) { 类ID = 整64(池.元素(类节点索引).文本); }
    整64 数据偏移 = 查字段偏移(类ID, 驻留("数据"));
    如果 (数据偏移 < 0) { 返回; }
    // 形参槽（移动元素(整64 目标, 整64 源)）
    整64 目标槽 = 0;
    整64 源槽 = 0;
    结果<整64, 整32> 找目标 = 函数信息.参数槽.获取(驻留("目标"));
    如果 (找目标.正常) { 目标槽 = 找目标.值; }
    结果<整64, 整32> 找源 = 函数信息.参数槽.获取(驻留("源"));
    如果 (找源.正常) { 源槽 = 找源.值; }
    如果 (目标槽 == 0 || 源槽 == 0) { 返回; }
    // this → 数据字段地址 → 数据值（元素数组基指针）
    整64 基址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 当前方法this槽, 0, 0, 基址r, T_对象, 0));
    整64 数据地址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 基址r, 0, 0, 数据地址r, T_整64, 数据偏移));
    整64 数据值r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 数据地址r, 0, 0, 数据值r, T_整64, 0));
    // 目标/源 下标值
    整64 目标值r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 目标值r, T_整64, 0));
    整64 源值r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 源槽, 0, 0, 源值r, T_整64, 0));
    // 步长常量槽
    整64 步长r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(元素大小)), 0, 0,
                         步长r, T_整64, 0));
    // 目标地址 = 数据值 + 目标*步长；源地址 = 数据值 + 源*步长
    整64 目标偏r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_乘, 目标值r, 步长r, 0, 目标偏r, T_整64, 0));
    整64 目标址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加, 数据值r, 目标偏r, 0, 目标址r, T_整64, 0));
    整64 源偏r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_乘, 源值r, 步长r, 0, 源偏r, T_整64, 0));
    整64 源址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加, 数据值r, 源偏r, 0, 源址r, T_整64, 0));
    // 整体搬运（结构体拷贝：源地址/目标地址/字节数=步长·对齐宿主 memcpy 语义）
    IR追加(指令, 建IR指令(IR_结构体拷贝, 源址r, 目标址r, 0, 0, 元素大小, 0));
}

// 702-a：容器元素析构链注入（~容器 方法体前·宿主 h698_113.asm ~向量$映射 样板同构）。
//   循环：i=0; 当 (i<元素数量) { ~T(this=数据+i*步长); i++ }——数据==0 短路短路。
不安全 函数 注入元素析构链(向量<节点> 池, 整32 类节点索引, 函数IR& 函数信息,
                   整64* 寄存器计数, 整64* 槽计数) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    字符串 类文本 = 字符串复制(驻留文本(整64(池.元素(类节点索引).文本)));
    整64 类长 = 字符串长度(类文本);
    整64 刀位 = -1;
    整64 ci = 0;
    当 (ci < 类长) {
        如果 ((整64(类文本[ci]) & 255) == 36) { 刀位 = ci; 中断; }
        ci++;
    }
    如果 (刀位 < 0) { 返回; }
    字符串 元素文本 = 字符串子串(类文本, 整32(刀位 + 1), 类长 - 刀位 - 1);
    // 703-a：引用形参实例名带 & 后缀（向量$映射$整64$符号& ← `向量<映射<...>>&`
    //   形参·79_v2 LNK2019 实锤=元素文本残留 & 拼出 映射$整64$符号&$~映射 幻影
    //   符号）——剥尾引用后缀（466-a 窄域剥层同款·循环剥多层）
    整64 元长w = 字符串长度(元素文本);
    当 (元长w > 1 && ((整64(元素文本[整32(元长w - 1)]) & 255) == 38)) {
        元素文本 = 字符串子串(元素文本, 0, 整32(元长w - 1));
        元长w--;
    }
    整64 元素大小 = 0;
    整64 元素对齐 = 0;
    类型大小与对齐(元素文本, &元素大小, &元素对齐);
    如果 (元素大小 <= 0) { 返回; }
    整64 类ID = 结构体布局键基(整64(池.元素(类节点索引).文本));
    如果 (类ID == 0) { 类ID = 整64(池.元素(类节点索引).文本); }
    整64 数据偏移 = 查字段偏移(类ID, 驻留("数据"));
    如果 (数据偏移 < 0) { 返回; }
    整64 数量偏移 = 查字段偏移(类ID, 驻留("元素数量"));
    如果 (数量偏移 < 0) { 返回; }
    // 元素析构存在判定：~T 方法签名（析构符号=映射$整64$符号$~映射 形态·
    //   方法名=~+剥实例基名——v2 生成方法链符号「~」前缀判定同口径）
    如果 (!是容器类(元素文本) && !用户类有析构位(元素文本)) { 返回; }
    // this → 数据值（元素数组基指针）与 元素数量值
    整64 基址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 当前方法this槽, 0, 0, 基址r, T_对象, 0));
    整64 数据地址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 基址r, 0, 0, 数据地址r, T_整64, 数据偏移));
    整64 数据值r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 数据地址r, 0, 0, 数据值r, T_整64, 0));
    整64 数量地址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 基址r, 0, 0, 数量地址r, T_整64, 数量偏移));
    整64 数量值r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 数量地址r, 0, 0, 数量值r, T_整64, 0));
    // 隐藏索引 i 槽（宿主 ?ewi99 同款）置 0
    整64 i槽 = 槽计数[0];
    槽计数[0] = 槽计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, i槽));
    整64 零r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零r, T_整64, 0));
    IR追加(指令, 建IR指令(IR_存储, 零r, 0, 0, 0, 0, i槽));
    // 步长常量
    整64 步长r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(元素大小)), 0, 0,
                         步长r, T_整64, 0));
    // 块链：头块(条件)/体块(析构+递增+回跳)/尾块(方法体续)
    整64 头块 = 新块(函数信息);
    整64 体块 = 新块(函数信息);
    整64 尾块 = 新块(函数信息);
    发射跳转(函数信息, 头块);
    切换块(函数信息, 头块);
    发射块标签(函数信息, 头块);
    整64 ir值r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, i槽, 0, 0, ir值r, T_整64, 0));
    整64 条件r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_小于, ir值r, 数量值r, 0, 条件r, T_整64, 0));
    发射条件跳转(函数信息, 条件r, 体块, 尾块);
    切换块(函数信息, 体块);
    发射块标签(函数信息, 体块);
    // 元素地址 = 数据值 + i*步长；call ~T(this=元素地址)
    整64 ir值r2 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, i槽, 0, 0, ir值r2, T_整64, 0));
    整64 偏r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_乘, ir值r2, 步长r, 0, 偏r, T_整64, 0));
    整64 址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加, 数据值r, 偏r, 0, 址r, T_整64, 0));
    IR追加(指令, 建IR指令(IR_调用实参, 址r, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                         驻留(析构符号(元素文本))));
    // i++
    整64 一r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("1"), 0, 0, 一r, T_整64, 0));
    整64 新ir = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加, ir值r2, 一r, 0, 新ir, T_整64, 0));
    IR追加(指令, 建IR指令(IR_存储, 新ir, 0, 0, 0, 0, i槽));
    发射跳转(函数信息, 头块);
    切换块(函数信息, 尾块);
    发射块标签(函数信息, 尾块);
}

// 115 同构扩（070 攻族·2026-10-05）：「析构元素(整64 索引)」单元素析构注入——
//   stdlib 删除/插入 移位循环单点释放钩子（空体+编译器注入契约·宿主
不安全 函数 注入元素单析构(向量<节点> 池, 整32 类节点索引, 函数IR& 函数信息,
                   整64* 寄存器计数, 整64* 槽计数) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    字符串 类文本d = 字符串复制(驻留文本(整64(池.元素(类节点索引).文本)));
    整64 类长d = 字符串长度(类文本d);
    整64 刀位d = -1;
    整64 ci = 0;
    当 (ci < 类长d) {
        如果 ((整64(类文本d[ci]) & 255) == 36) { 刀位d = ci; 中断; }
        ci++;
    }
    如果 (刀位d < 0) { 返回; }
    字符串 元素文本d = 字符串子串(类文本d, 整32(刀位d + 1), 类长d - 刀位d - 1);
    整64 元长d = 字符串长度(元素文本d);
    当 (元长d > 1 && ((整64(元素文本d[整32(元长d - 1)]) & 255) == 38)) {
        元素文本d = 字符串子串(元素文本d, 0, 整32(元长d - 1));
        元长d--;
    }
    如果 (!是容器类(元素文本d) && !用户类有析构位(元素文本d)) { 返回; }
    整64 元素大小d = 0;
    整64 元素对齐d = 0;
    类型大小与对齐(元素文本d, &元素大小d, &元素对齐d);
    如果 (元素大小d <= 0) { 返回; }
    整64 类IDd = 结构体布局键基(整64(池.元素(类节点索引).文本));
    如果 (类IDd == 0) { 类IDd = 整64(池.元素(类节点索引).文本); }
    整64 数据偏移d = 查字段偏移(类IDd, 驻留("数据"));
    如果 (数据偏移d < 0) { 返回; }
    整64 数量偏移d = 查字段偏移(类IDd, 驻留("元素数量"));
    如果 (数量偏移d < 0) { 返回; }
    整64 索引槽d = 0;
    结果<整64, 整32> 找索引d = 函数信息.参数槽.获取(驻留("索引"));
    如果 (找索引d.正常) { 索引槽d = 找索引d.值; }
    如果 (索引槽d == 0) { 返回; }
    // this → 数据值（元素数组基指针）与 元素数量值
    整64 基址d = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 当前方法this槽, 0, 0, 基址d, T_对象, 0));
    整64 数据地址d = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 基址d, 0, 0, 数据地址d, T_整64, 数据偏移d));
    整64 数据值d = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 数据地址d, 0, 0, 数据值d, T_整64, 0));
    整64 数量地址d = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 基址d, 0, 0, 数量地址d, T_整64, 数量偏移d));
    整64 数量值d = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 数量地址d, 0, 0, 数量值d, T_整64, 0));
    整64 索引值d = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 索引槽d, 0, 0, 索引值d, T_整64, 0));
    // 步长常量
    整64 步长d = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(元素大小d)), 0, 0,
                         步长d, T_整64, 0));
    // 守卫块链：析构条件 = 0<=索引<元素数量（两次条件跳转组合·无逻辑或码）——
    //   守卫块(索引<0?→跳过)/判定块(索引>=数量?→跳过)/释放块(call ~T)/跳过块(方法体续)
    整64 守卫块d = 新块(函数信息);
    整64 判定块d = 新块(函数信息);
    整64 释放块d = 新块(函数信息);
    整64 跳过块d = 新块(函数信息);
    整64 零r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零r, T_整64, 0));
    发射跳转(函数信息, 守卫块d);
    切换块(函数信息, 守卫块d);
    发射块标签(函数信息, 守卫块d);
    整64 负判定r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_小于, 索引值d, 零r, 0, 负判定r, T_整64, 0));
    发射条件跳转(函数信息, 负判定r, 跳过块d, 判定块d);
    切换块(函数信息, 判定块d);
    发射块标签(函数信息, 判定块d);
    整64 越判定r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_大于等于, 索引值d, 数量值d, 0, 越判定r, T_整64, 0));
    发射条件跳转(函数信息, 越判定r, 跳过块d, 释放块d);
    切换块(函数信息, 释放块d);
    发射块标签(函数信息, 释放块d);
    // 元素地址 = 数据值 + 索引*步长；call ~T(this=元素地址)
    整64 偏移r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_乘, 索引值d, 步长d, 0, 偏移r, T_整64, 0));
    整64 元素址r = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加, 数据值d, 偏移r, 0, 元素址r, T_整64, 0));
    IR追加(指令, 建IR指令(IR_调用实参, 元素址r, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                         驻留(析构符号(元素文本d))));
    发射跳转(函数信息, 跳过块d);
    切换块(函数信息, 跳过块d);
    发射块标签(函数信息, 跳过块d);
}

