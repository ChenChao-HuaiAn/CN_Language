    整64 数值n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 数址n, 0, 0, 数值n, T_整64, 0));
    整64 步n = 寄存器计数[0];
