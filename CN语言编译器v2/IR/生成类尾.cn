// 生成类方法们（节点_类 遍历点——IR生成多文件 类分支调用）：逐 节点_方法
//   生成方法 IR 并追加程序。
不安全 函数 生成类方法们(向量<节点> 池, 整32 类节点索引, 字符串 模块路径,
                    程序IR& 程序) -> 空类型 {
    节点 类节点 = 池.元素(类节点索引);
    整64 类名ID = 整64(类节点.文本);
    // 416-a（D42 波 2）：泛型基类——方法体经实例克隆体生成（单态化·符号自动含
    //   实例参数）；基类本体不生成（T 字段布局不真实）。克隆类节点由 实例化注册
    //   建好（池尾·生成主循环之前）。
    // 1541 B2：有值=泛型基类（方法体经实例克隆体生成·原 !=0 判据）
    可选<整64> 泛序查类 = 查泛型基类参数序(类名ID);
    如果 (泛序查类.有值) {
        // 430-b 根治：克隆注册表自遍历——原按 泛型实例们（收集表）下标直配
        //   泛型实例类节点们（注册表），但 实例化注册 有双跳过路径（参数序
        整64 nd = 泛型实例类节点们.大小();
        整64 id = 0;
        当 (id < nd) {
            节点 克隆类d = 池.元素(整32(泛型实例类节点们.元素(id)));
            字符串 实例文本d = 字符串复制(驻留文本(整64(克隆类d.文本)));
            如果 (字符串比较(剥实例基名(实例文本d), 字符串复制(驻留文本(类名ID)))) {
                // 462-a（T70 面①根治）：克隆体生成窗口=实例化点模块（"主"）——
                //   原传 基类文件段模块路径（撤守卫态=stdlib 容器模块）→克隆体内
                生成类方法们(池, 整32(泛型实例类节点们.元素(id)), "主", 程序);
            }
            id++;
        }
        返回;
    }
    整64 位置 = 整64(类节点.子起点);
    当 (位置 < 整64(类节点.子终点)) {
        节点 成员 = 池.元素(整32(位置));
        如果 (成员.类型 == 节点_方法) {
            // 193（2026-10-13 任务193）：抽象方法（修饰位 8=256·无实现体）跳过
            //   生成（宿主 ir_oop.cpp「member->body == nullptr → 抽象/接口签名
            //   无体 return」同构）——抽象类不可实例化（语义层已拒），无体符号
            //   无调用点；派生类重写者以派生类符号生成（虚表分派同链）。
            如果 ((整64(成员.修饰) / 256) % 2 == 1) {
                位置++;
                继续;
            }
            函数IR 函数信息 = 生成方法(池, 整32(位置), 类节点索引, 模块路径);
            结果<空类型, 整32> 加 = 程序.函数们.追加(函数信息);
            如果 (!加.正常) { 运行时错误(4); }
        }
        位置++;
    }
    // 309（2026-10-09）：沿链析构体合成——「本类无用户析构·沿链有析构」的
    //   派生类（568 形态⑥ 猫 实证：RAII 出口 类有析构 沿链判定发 IR_删除对象
    //   （附加=本类名ID），代码生成展开调 析构符号(本类)=猫$~猫 无人定义=
    //   链接失败）。C++ 隐式析构同语义：合成体=成员析构+父析构级联。
    // 658②（2026-10-14·#658）：条件放开为「本类无用户析构即合成」——无析构
    //   类局部随 RAII 名单全量化（生成类中 同轮）出口 IR_删除对象，~符号必须
    //   恒存在；合成体=注入析构字段级联（字符串/容器/盒载荷/有析构类字段）
    //   +注入父析构调用（无基类/基无析构=内部早退）——**无析构类字段级联释放
    //   的 v2 承载面**（宿主 emitNoDtorFieldCascade 同语义双侧对齐）。有用户
    //   析构类不进（体内已注入=勿双释放幂等判据·与 309 沿链面同判）。
    结果<整64, 整32> 本析g = 类析构位们.获取(类名ID);
    如果 (!本析g.正常) {
        函数IR 合成g = 合成沿链析构体(池, 类节点索引, 模块路径);
        结果<空类型, 整32> 加合g = 程序.函数们.追加(合成g);
        如果 (!加合g.正常) { 运行时错误(4); }
    }
}



// ==================== 607-a（001-001 续）：串字段路径收集（81-a 面） ====================
// 收集结构体类型的拥有串字段**内联偏移路径**（宿主 ownedStrFieldsOf 的运行时
不安全 函数 收集串字段路径(整64 结构体ID, 整64 基偏移, 向量<整64>& 出, 整64 深度) -> 空类型 {
    如果 (深度 > 4) { 返回; }
    向量<整64> 三元组w = 向量<整64>();
    取资源字段们(结构体ID, 三元组w);
    整64 iw = 0;
    当 (iw + 2 < 三元组w.大小()) {
        整64 字段类型IDw = 三元组w.元素(iw + 1);
        整64 合成偏w = 基偏移 + 三元组w.元素(iw + 2);
        如果 (字段类型IDw == 驻留("字符串")) {
            结果<空类型, 整32> 加w = 出.追加(合成偏w);
            如果 (!加w.正常) { 运行时错误(4); }
        }
        // 1541 B2：else 业务块改互补正条件（用户 else 新规·判据等价）
        如果 (字段类型IDw != 驻留("字符串")) {
            整64 嵌套键w = 0;
            可选<整64> 嵌套键w查 = 结构体布局键基(字段类型IDw);
            如果 (嵌套键w查.有值) { 嵌套键w = 嵌套键w查.值; }
            如果 (嵌套键w != 0 && 资源字段数(嵌套键w) > 0) {
                收集串字段路径(嵌套键w, 合成偏w, 出, 深度 + 1);
            }
        }
        iw += 3;
    }
}


不安全 函数 发射类拷贝构造初始化(向量<节点> 池, 节点 n, 字符串 类型文本, 整64 类名ID, 整64 槽c,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
        // 438 根治：右值=复制(…) → 句柄接管判定移交 发射类复制声明接管
        //   （真=已直存终结·假=非复制形态落 NewObject+拷贝构造主路径）。
        如果 (发射类复制声明接管(池, n, 类名ID, 槽c, 局部槽, 参数槽, 函数信息,
                              寄存器计数, 槽计数, 表达式栈)) { 返回; }
        // 438-b 根①：类对象拷贝初始化 b = a——分配新对象 + 拷贝构造(this=新，
        //   其他=源)（Rust Clone::clone 同构；与 发射用户类构造 同 ABI）。拷贝
        //   构造缺失的处置随 768 双分（无析构=位拷贝回退·有析构=维持拒绝）。
        // 768 根治（741 轮呈报·728x/543-d 同族第三形态·2026-10-14）：判定双分——
        //   ①拷贝构造串==0 且 类有析构==假（无析构纯数据类）→ 源地址解析后落
        //   位拷贝回退通道（728x 赋值面同款）；②拷贝构造串==0 且 类有析构==真
        //   → 维持既有拒绝（有析构类按值拷贝须显式拷贝构造——741 语义强制集成后
        //   语义层拦，此处 IR 层兜底）。无析构+有拷贝构造（拷贝串!=0）仍走拷贝
        //   构造调用=宿主 findCopyConstructor 命中同构（ir_stmt_decl_init.cpp
        //   方案A 判据=拷贝构造有无，非析构有无）。修前面：声明面 IR 通道只有
        //   拷贝构造一条路，无析构类标识符拷贝（纯数 乙 = 甲）诊断红+运行时
        //   错误(6) 编译中止，宿主浅拷贝零开销绿——零分叉铁律破面实录。
        // 1541 B2：无值=本类无自有拷贝构造（原 0 判据）；有值=拷贝构造参数串 ID
        可选<整64> 拷贝串查ID = 查类拷贝构造串(类名ID);
        如果 (!拷贝串查ID.有值 && 类有析构(类名ID)) {
            IR层诊断("类对象初始化仅支持构造调用（类 " + 类型文本 +
                          "；拷贝/其它形态随后续轮次）");
            运行时错误(6);
        }
        整64 新obj = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新obj,
                             查结构体大小(类名ID), 类名ID));
        // 448-b 根治（44#2 多余解引用·撤守卫态 111 SEGV·D42 波 3 收口）：
        //   拷贝构造 T& 形参侧=引用槽模型（发射引用参数读 容器& 双解：Load 槽
        整64 源地址reg = 0;
        节点 源末448b = 池.元素(n.子终点 - 1);
        如果 (源末448b.类型 == 节点_标识符) {
            整64 源槽448b = 0;
            结果<整64, 整32> 找源局448b = 局部槽.获取(整64(源末448b.文本));
            如果 (找源局448b.正常) { 源槽448b = 找源局448b.值; } 否则 { }
            如果 (源槽448b == 0) {
                结果<整64, 整32> 找源参448b = 参数槽.获取(整64(源末448b.文本));
                如果 (找源参448b.正常) { 源槽448b = 找源参448b.值; } 否则 { }
            }
            如果 (源槽448b != 0) {
                源地址reg = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                如果 (槽是引用(源槽448b)) {
                    IR追加(指令, 建IR指令(IR_加载, 源槽448b, 0, 0, 源地址reg, T_对象, 0));
                } 否则 {
                    IR追加(指令, 建IR指令(IR_取地址, 源槽448b, 0, 0, 源地址reg, T_整64, 0));
                }
            } 否则 {   // 静默豁免业务值: 拷贝构造源=静态槽分支（局部/参数 miss 后既有回退通道·1360 批5 结果化改锚）
                结果<整64, 整32> 找源静448b = 查静态序号含类(整64(源末448b.文本));
                如果 (找源静448b.正常) {
                    源地址reg = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 源地址reg,
                                         T_对象, 找源静448b.值));
                }
            }
        }
        如果 (源地址reg == 0) {
            整64 源值448b = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                         指令, 寄存器计数, &函数信息.块计数, 槽计数,
                                         表达式栈);
            // 632（544 呈报·宿主同轮）：右值=引用返回调用——调用点默认读值多解
            //   一层（对象首字段当深拷源→副本空：pA 甲.记录.大小()=0 vs 宿主 1）
            //   ——回扫丢弃该 IR_指针加载 取操作数1（调用原址 rax）作深拷源。
            //   限右值末=调用+命中指针加载（普通函数读值=发射引用返回加载）；
            //   方法调用读值=rax 直传（无 IR_指针加载·回扫自然 miss=原值）。
            布尔 是引用返回源448b = 假;
            如果 (n.子终点 > n.子起点 && 源值448b != 0 &&
                池.元素(n.子终点 - 1).类型 == 节点_调用) {
                整64 回632 = 指令.大小();
                当 (回632 > 0) {
                    IR指令 回扫632 = 指令.元素(回632 - 1);
                    如果 (回扫632.操作码 == IR_指针加载 && 回扫632.目标 == 源值448b) {
                        源值448b = 回扫632.操作数1;
                        是引用返回源448b = 真;
                        中断;
                    }
                    回632--;
                }
            }
            // 928 修订（543/551/765/766 双平台红回归·arm64 云端预验 ab037d75b2
            //   4 例 + win 本机复现 fault=箱子值字段 5 被当对象指针实录）：
            //   **直用仅限「引用返回调用」识别面**——回扫命中（普通函数读值
            //   PtrLoad=发射引用返回加载）或 是方法引用返回928（方法读值=rax
            //   直传·回扫 miss）；二者读值/回扫=rax=**被引用左值地址**（928
            //   生产端对齐·函数方法同口径）→ 直用（拷贝构造 T& 源约定「装着
            //   壳地址的槽地址」）。
            //   其余一切（末≠调用=成员/下标/三元等**表达式读值**=对象指针/
            //   句柄本体，如 `盒子 b = 内.值;` 读值=载荷句柄；末=调用但非引用
            //   返回=保守面/复制族未接管残留）→ **hold 槽物化**（分配槽+存值+
            //   取址）——928 首版误随 hold 一并撤销致「句柄本体当槽地址→被调方
            //   [源] 解引用把对象首字段（=箱子 `值` 字段 5/盒标签）当壳指针」
            //   段错误。
            如果 (!是引用返回源448b && 源值448b != 0 &&
                n.子终点 > n.子起点 &&
                是方法引用返回928(池, 整64(n.子终点 - 1), 类名ID)) {
                是引用返回源448b = 真;
            }
            如果 (是引用返回源448b) {
                源地址reg = 源值448b;
            } 否则 {
            整64 hold槽448b = 槽计数[0];
            槽计数[0] = 槽计数[0] + 1;
            IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, hold槽448b));
            IR追加(指令, 建IR指令(IR_存储, 源值448b, 0, 0, 0, 0, hold槽448b));
            源地址reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_取地址, hold槽448b, 0, 0, 源地址reg, T_整64, 0));
            }
            当 (表达式栈.大小() > 0) {
                结果<空类型, 整32> 删源448b = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删源448b.正常) { 运行时错误(4); }
            }
        }
        // 768 无析构回退通道（拷贝串==0 且 类有析构==假 才到此——有析构无拷贝
        //   构造已在上方拒绝）：源槽解句柄+结构体位拷贝入新壳（728x 赋值面
        //   同款：指针加载源本体+IR_结构体拷贝整块拷——源地址reg=源变量槽地址
        //   ·槽内=对象句柄，解一层得本体）；直存声明槽终结（浅拷贝零开销·
        //   宿主 ir_stmt_decl_init.cpp 无拷贝构造→CopyStruct 回退同构）。
        如果 (!拷贝串查ID.有值) {
            发射类无析构位拷贝初始化(指令, 源地址reg, 新obj, 类名ID, 槽c,
                                  寄存器计数, 表达式栈);
            返回;
        }
        // 上行无值已返回；此处 0 仅占位（不可达·既有未命中语义）
        整64 拷贝串ID = 0;
        如果 (拷贝串查ID.有值) { 拷贝串ID = 拷贝串查ID.值; }
        字符串 拷贝串 = 字符串复制(驻留文本(拷贝串ID));
        IR追加(指令, 建IR指令(IR_调用实参, 新obj, 0, 0, 0, 0, 0));
        IR追加(指令, 建IR指令(IR_调用实参, 源地址reg, 0, 0, 0, 1, 0));
        IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                             驻留(方法符号(类型文本, 剥实例基名(类型文本), 拷贝串))));
        IR追加(指令, 建IR指令(IR_存储, 新obj, 0, 0, 0, 0, 槽c));
        当 (表达式栈.大小() > 0) {
            结果<空类型, 整32> 删栈k = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈k.正常) { 运行时错误(4); }
        }
        返回;
}

// 768：无析构类声明初始化位拷贝子通道（自 发射类拷贝构造初始化 拆出——主函数
//   函数行数红线先拆再加）。前置=调用方已判 拷贝构造串==0 且 类有析构==假
//   （无析构纯数据类）且 源地址reg 已解析（标识符=局部/参数/静态槽地址·非标识
//   符=表达式临时槽地址；槽内=对象句柄）。发射=源槽指针加载解句柄得本体 →
//   IR_结构体拷贝 整块拷入 NewObject 新壳 → 直存声明槽终结（728x/543-d 赋值面
//   位拷贝同款形态——源形态异〔彼=表达式源指针·此=槽地址解句柄〕故独立成函数
//   不强行归纳；宿主同构=ir_stmt_decl_init.cpp 无拷贝构造→NewObject+CopyStruct）。
不安全 函数 发射类无析构位拷贝初始化(向量<IR指令>& 指令, 整64 源地址reg, 整64 新obj,
                   整64 类名ID, 整64 槽c, 整64* 寄存器计数,
                   向量<整64>& 表达式栈) -> 空类型 {
    整64 源本体768 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 源地址reg, 0, 0, 源本体768, T_对象, 0));
    IR追加(指令, 建IR指令(IR_结构体拷贝, 源本体768, 新obj, 0, 0,
                         查结构体大小(类名ID), 0));
    IR追加(指令, 建IR指令(IR_存储, 新obj, 0, 0, 0, 0, 槽c));
    当 (表达式栈.大小() > 0) {
        结果<空类型, 整32> 删栈768 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈768.正常) { 运行时错误(4); }
    }
}



// ==================== 413：接口方法调用发射（2026-10-11 接口语法族） ====================
// plans/006 P3-19 B1 全局槽位分派 + plans/008 D3A 去虚拟化（宿主
//   ir_oop_call.cpp tryInterfaceMethodCall 同构）：
//   · 去虚拟化：接口全局唯一实现类 → 编译期直调该类实现方法（跳过 LoadPtr+
//     间接调用，热路径省 1 次间接跳转；实现类数含继承链并入——解析类继承登记
//     基类沿链接口补登·多实现回退间接分派，与宿主 interfaceImplClasses 同口径；
//     抽象类排除同步——193 任务193·是抽象类ID 判定·宿主 ci.isAbstract 同款）
//   · 间接路径：LoadPtr(对象.接口区[槽]=对象+8+槽*8) → IR_间接调用
//     （this=位0·实参位1..——IR_调用实参/间接调用 与函数指针通道同 ABI）
// 接口变量=对象地址本身（A1 零指针调整），this 直传不转换。
// 聚合返回（413-b 审查修复·宿主实测绿：接口 I{取点()->点} 输出 x:3 y:4）：
//   直调=用户类聚合 retbuf 发射先例（发射用户类方法调用 T87/421 同形态——
//   类型位=retbuf 槽·位0=retbuf/位1=this·返回寄存器=MS/SysV ABI 隐藏指针）；
//   间接=IR_间接调用 类型位形态（三后端 retbuf 前导位·对照宿主 CallIndirect
//   聚合通道）——retbuf 地址压栈供 .x/.y 成员消费。
不安全 函数 发射接口方法调用(字符串 接口名文本, 字符串 方法名文本, 整64 this寄存器,
                   向量<整64>& 弹出们, 整64 实参数, 向量<IR指令>& 指令,
                   整64* 寄存器计数, 整64* 槽计数, 向量<整64>& 表达式栈,
                   整64 retbuf序号) -> 空类型 {
    整64 接口IDk = 驻留(接口名文本);
    整64 方法IDk = 驻留(方法名文本);
    可选<整64> 槽查k = 查接口方法槽(接口IDk, 方法IDk);
    如果 (!槽查k.有值) {
        IR层诊断("接口无此方法: " + 接口名文本 + "." + 方法名文本);
        运行时错误(6);
    }
    // 上行为内部错误中止；0 仅占位（不可达·既有非接口方法语义=诊断中止）
    整64 槽k = 0;
    如果 (槽查k.有值) { 槽k = 槽查k.值; }
    整64 返回类型IDk = 0;
    可选<整64> 返回类型查k = 查接口方法返回(接口IDk, 方法IDk);
    如果 (返回类型查k.有值) { 返回类型IDk = 返回类型查k.值; }
    字符串 返回文本k = "";
    如果 (返回类型IDk != 0) { 返回文本k = 字符串复制(驻留文本(返回类型IDk)); }
    整64 参数串IDk = 0;
    可选<整64> 参数串查k = 查接口方法参数串(接口IDk, 方法IDk);
    如果 (参数串查k.有值) { 参数串IDk = 参数串查k.值; }
    如果 (参数串IDk != 0 && 参数段个数(字符串复制(驻留文本(参数串IDk))) != 实参数) {
        IR层诊断("接口方法调用实参数不匹配（" + 接口名文本 + "." + 方法名文本 +
                      "：期望 " + 整数转字符串(参数段个数(字符串复制(驻留文本(参数串IDk)))) +
                      " 个）");
        运行时错误(6);
    }
    // 552（接口方法 × 128 形参双侧同案·v2 侧）：接口方法实参回扫——128 位
    //   窄实参物化双槽句柄 + 结构体按值实参取地址，与 442 静态方法/实例方法/
    //   构造/普通函数四路径同款表驱动（回扫结构体与引用实参 单点机制）。
    //   原缺 → 窄实参按 64 位值直传、被调 prologue 按双槽地址 rep movsb
    //   解引用 SIGSEGV（探针 552pe2：引用.取整(42) rc=139 实锤）；结构体按值
    //   实参传字段值当基址同崩（探针 552st1 rc=139·宿主绿=分叉）。
    //   表键=接口方法符号*键位移+实参序（登记点=收集接口方法实参表·接口方法
    //   无池节点，键自接口名/方法名/参数串 合成——此处同公式复算，单一归属）。
    //   直调/间接两分支共用本回扫（弹出们 为同一实参序列——先于分叉执行）。
    字符串 参数串552 = "";
    如果 (参数串IDk != 0) { 参数串552 = 字符串复制(驻留文本(参数串IDk)); }
    回扫结构体与引用实参(弹出们, 整64(驻留(方法符号(接口名文本, 方法名文本,
                                                   参数串552))),
                         指令, 寄存器计数, 槽计数);
    // 聚合返回判定（结构体/容器/结果/数组/128 位——宿主 mapType+聚合通道同族；
    // 413-b 前版此处硬拒=与宿主实测绿分叉·已撤）
    布尔 返回128k = (字符串比较(返回文本k, "整128") || 字符串比较(返回文本k, "正128"));
    布尔 聚合返回k = (查结构体大小(返回类型IDk) != 0 || 是容器类(返回文本k) ||
                     是结果类型(返回文本k) || 是数组类型文本(返回文本k) || 返回128k);
    整64 返回码k = 0;
    如果 (返回类型IDk != 0) { 返回码k = 类型码(返回类型IDk); }
    整64 retbuf槽k = 0;
    整64 起始位k = 1;
    整64 目标寄存器k = 0;
    如果 (聚合返回k) {
        // 聚合 retbuf 形态（用户类聚合直调先例同构）：返回码=0（地址标 0 整型
        //   类）·retbuf 尺寸登记（帧预留——585-a/087b/421 兜底同族）
        返回码k = 0;
        整64 返回字节k = 查结构体大小(返回类型IDk);
        如果 (返回字节k == 0 && 是结果类型(返回文本k)) { 返回字节k = 结果大小(返回文本k); }
        如果 (返回字节k == 0 && 是数组类型文本(返回文本k)) { 返回字节k = 类型名宽度(返回类型IDk); }
        如果 (返回字节k == 0 && 返回128k) { 返回字节k = 16; }
        累计retbuf字节数(返回字节k);
        retbuf槽k = retbuf序号;
        起始位k = 2;   // 位0=retbuf·位1=this·位2..=实参
        // 聚合无条件分配目标寄存器（=retbuf 地址句柄·用户类聚合分支同款——
        //   返回码已改写 0（T_未知），沿用标量判定会漏分配压栈 0）
        目标寄存器k = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
    } 否则 如果 (返回码k != T_空类型 && 返回码k != T_未知) {
        目标寄存器k = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
    }
    // D3A 去虚拟化：全局唯一实现类 → 直调实现方法符号（继承实现=沿链定义层）
    // 193（2026-10-13 任务193）：抽象类不构成去虚拟化直调目标（宿主
    //   interfaceImplClasses「ci.isAbstract → continue 不构成实现目标」同构·
    //   原「v2 无抽象类面·将来同步」预告点）——唯一实现为抽象类时回退间接分派。
    如果 (接口实现类数(接口IDk) == 1 && !是抽象类ID(接口唯一实现(接口IDk))) {
        整64 唯一类k = 接口唯一实现(接口IDk);
        // 1541 B2：无值=沿链无此方法（原 !=0 判据）
        可选<整64> 定义查k = 查类方法定义层(唯一类k, 方法IDk);
        如果 (定义查k.有值) {
            整64 定义层k = 定义查k.值;
            字符串 定义类名k = 字符串复制(驻留文本(定义层k));
            字符串 参数串k = "";
            // 1541 B2：无值=方法表未登记参数串→空参数串（原 0→空串逐点等价）
            可选<整64> 定义串查IDk = 查类方法参数串(定义层k, 方法IDk);
            如果 (定义串查IDk.有值) { 参数串k = 字符串复制(驻留文本(定义串查IDk.值)); }
            整64 符号IDk = 整64(驻留(方法符号(定义类名k, 方法名文本, 参数串k)));
            IR追加(指令, 建IR指令(IR_调用实参, this寄存器, 0, 0, 0, 起始位k - 1, 0));
            发射调用实参们(弹出们, 起始位k, 指令, 实参类型码们(弹出们));
            // retbuf 槽：标量返回传 0（非聚合不走 retbuf 形态——类型位≠0 即被
            //   后端判 retbuf 调用·413 直调 rcx 占用实录）；聚合传 retbuf序号
            IR追加(指令, 建IR指令(IR_调用参数化, 起始位k + 实参数, 返回码k, 0,
                                 目标寄存器k, retbuf槽k, 符号IDk));
            如果 (聚合返回k) {
                // 421：128 位标量返回的 retbuf 句柄登记（打印传址/实参物化分派）
                如果 (返回128k) {
                    登记寄存器类型(目标寄存器k, 类型码(返回类型IDk));
                }
                // retbuf 地址压栈（.x/.y 成员消费——用户类聚合分支同款不标量登记；
                // 目标=MS/SysV ABI 隐藏指针·返回装载 mov 目标,rax 同值）
                结果<空类型, 整32> 加直聚k = 表达式栈.追加(目标寄存器k);
                如果 (!加直聚k.正常) { 运行时错误(4); }
                返回;
            }
            如果 (目标寄存器k != 0) {
                登记寄存器类型(目标寄存器k, 返回码k);
                结果<空类型, 整32> 加直k = 表达式栈.追加(目标寄存器k);
                如果 (!加直k.正常) { 运行时错误(4); }
            }
            返回;
        }
    }
    // 间接路径：接口区偏移 = 8（vptr）+ 槽*8（解析布局 [vptr][接口区][字段区]）
    整64 区址寄存器k = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, this寄存器, 0, 0,
                         区址寄存器k, T_整64, 8 + 槽k * 8));
    整64 方法址寄存器k = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 区址寄存器k, 0, 0,
                         方法址寄存器k, T_整64, 0));
    IR追加(指令, 建IR指令(IR_调用实参, this寄存器, 0, 0, 0, 起始位k - 1, 0));
    发射调用实参们(弹出们, 起始位k, 指令, 实参类型码们(弹出们));
    // 类型位=retbuf槽（聚合形态·三后端 retbuf 前导位；标量=0 维持既有 ABI）
    IR追加(指令, 建IR指令(IR_间接调用, 起始位k + 实参数, 返回码k, 0,
                         目标寄存器k, retbuf槽k, 方法址寄存器k));
    如果 (聚合返回k) {
        // 421：128 位标量返回的 retbuf 句柄登记（同直调聚合）
        如果 (返回128k) {
            登记寄存器类型(目标寄存器k, 类型码(返回类型IDk));
        }
        // retbuf 地址压栈（间接聚合——返回装载 mov 目标,rax 隐藏指针同值）
        结果<空类型, 整32> 加间聚k = 表达式栈.追加(目标寄存器k);
        如果 (!加间聚k.正常) { 运行时错误(4); }
        返回;
    }
    如果 (目标寄存器k != 0) {
        登记寄存器类型(目标寄存器k, 返回码k);
        结果<空类型, 整32> 加间k = 表达式栈.追加(目标寄存器k);
        如果 (!加间k.正常) { 运行时错误(4); }
    }
}
