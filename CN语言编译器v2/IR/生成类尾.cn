    发射条件跳转(函数信息, 判n, 体n, 尾块n);
    切换块(函数信息, 体n);
    发射块标签(函数信息, 体n);
    整64 表址n = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
