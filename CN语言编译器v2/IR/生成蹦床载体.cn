// ==================== 482（#482 多实例独立快照）载体槽族 ====================
// 缺陷（核验波2 实证）：蹦床从「同一定义点共享的静态快照槽」还原捕获——同一定
//   义点在循环内/跨函数接收/重赋值多次求值产生多实例共存时后写覆盖先值
//   （p482b/p482e/p482 实测双侧同病）。根治=快照随「值载体变量」独立存储
//   （载体槽=「变量名$cap$捕获名」局部槽·生成声明 波1 既有命名规则）+ 调用点
//   写回共享槽（蹦床还原读到的=该实例快照——各实例互不影响）：
//   ① 定义点（生成声明 既有段落）建载体槽固化快照（本身即多实例正确）；
//   ② 接收点（初值/赋值右值=返回来源已知的调用/已登记变量）：建载体槽+
//      共享槽->载体槽（拷贝链经「源载体->共享->目标载体」两跳）；
//   ③ 赋值位：登记更新/陈旧清除（p482 根因：重赋值后调用仍展开旧定义点）；
//   ④ 返回点（返回已登记变量）：载体槽->共享槽（接收方拷到被返回实例）；
//   ⑤ 调用点（lambda闭包调用展开 早退处）：载体槽->共享槽写回，蹦床还原
//      即该实例快照；无登记/无槽=现状直路（共享槽=最近实例，与现状同界）。
// 解析函数：解析lambda来源482——标识符（?lambdaN 定义点/闭包表登记变量）/
//   直接调用（决议函数符号查 函数返回来源482 表）。

// 482：函数返回来源表（签名键名ID -> ?lambdaN 名ID；缺=未知）——接收点静态
//   解析「该调用返回哪个定义点的实例」（生成函数 收尾写入）。
静态 映射<整64, 整64> 函数返回来源482;
// 482：本函数返回来源跟踪（生成函数 入口复位；0=未见；0-1=冲突/未知哨兵）。
静态 整64 本函数返回来源482 = 0;

// 482：函数入口复位（生成函数 调用）——闭包表清空隔离跨函数同名污染
//   （宿主 485 clear 同构；v2 原表只写不读故无清、读点激活后必须隔离）。
不安全 函数 复位载体族482() -> 空类型 {
    lambda闭包变量们.清空();
    本函数返回来源482 = 0;
}

// 482：生成函数 收尾登记（唯一已知来源才入表——冲突哨兵/未见=不登记）。
不安全 函数 收尾登记返回来源482(整64 函数名ID) -> 空类型 {
    如果 (函数名ID == 0) { 返回; }
    如果 (本函数返回来源482 <= 0) { 返回; }
    结果<空类型, 整32> 设482 = 函数返回来源482.设置(函数名ID, 本函数返回来源482);
    如果 (!设482.正常) { 运行时错误(4); }
}

// 482：来源解析——右值节点 -> ?lambdaN 名ID（0=未知）。
//   ①标识符 ?lambdaN（lambda 字面量改写形态）=定义点直用；
//   ②标识符（闭包表登记变量——值语义拷贝链的来源）；
//   ③调用（被调=标识符·决议函数符号查返回来源表——跨函数接收）。
函数 解析lambda来源482(向量<节点> 池, 节点 右值482, 整32 右值位置482) -> 可选<整64> {
    如果 (右值482.类型 == 节点_标识符) {
        字符串 名482 = 字符串复制(驻留文本(整64(右值482.文本)));
        如果 (文本前缀(名482, "?")) { 返回 某些(整64(右值482.文本)); }
        结果<整64, 整32> 查登482 = lambda闭包变量们.获取(整64(右值482.文本));
        如果 (查登482.正常) {
            如果 (查登482.值 != 0) { 返回 某些(查登482.值); }
        }
        否则 { }
        返回 无;
    }
    如果 (右值482.类型 == 节点_调用 && 右值482.子起点 > 0 &&
        整32(右值482.子起点) < 整32(池.大小())) {
        节点 被调482 = 池.元素(整32(右值482.子起点));
        如果 (被调482.类型 == 节点_标识符) {
            // 482：符号推导走「语义决议键基 + 候选枚举 + 统一链接键直查」——
            //   不经「决议函数符号」（其失败会打 IR 层诊断+计错误中止产物；
            //   本处=纯静态来源分析，失败=分析放弃回退现状直路，非编译错误。
            //   候选多值时仅当全部命中同值才采信（重载不同来源=特化实例=
            //   放弃，保守方向）。
            // 1360 批5 表轮结果化：miss=未决议=放弃（业务回退·原 -1 哨兵比较）
            // 静默豁免业务值: miss=符号来源分析放弃·回退现状直路（非编译错误·1360 批5 表轮）
            结果<整64, 整32> 键查482 = 调用决议查询(整64(右值位置482));
            如果 (!键查482.正常) { 返回 无; }   // 未决议=分析回退（可选无值·非编译错误）
            整64 键基482 = 键查482.值;
            整64 候选数482 = 0;   // 候选数提取（结果 流敏感检查惯例；计数登记恒 ≥1）
            结果<整64, 整32> 候选查482 = 查函数签名个数(键基482);
            如果 (候选查482.正常) { 候选数482 = 候选查482.值; }
            如果 (候选数482 == 0) {
                结果<整64, 整32> 查单482 = 函数返回来源482.获取(键基482);
                // 来源表 miss=分析放弃（可选无值·回退现状直路·非编译错误）
                如果 (查单482.正常) { 返回 某些(查单482.值); }
                返回 无;
            }
            整64 命中值482 = 0;
            整64 命中数482 = 0;
            整64 k482 = 0;
            当 (k482 < 候选数482) {
                结果<整64, 整32> 查串482 = 函数签名参数串们.获取(
                    键基482 * 键位移 + k482);
                如果 (查串482.正常) {
                    整64 链接482 = 统一链接键(键基482, 整64(被调482.文本),
                                             驻留文本(查串482.值));
                    结果<整64, 整32> 查返482 = 函数返回来源482.获取(链接482);
                    如果 (查返482.正常) {
                        如果 (命中数482 == 0) {
                            命中值482 = 查返482.值;
                        } 否则 如果 (命中值482 != 查返482.值) {
                            返回 无;   // 重载来源不一致=放弃
                        }
                        命中数482 = 命中数482 + 1;
                    }
                    否则 { }
                }
                否则 { }
                k482++;
            }
            如果 (命中数482 == 0) { 返回 无; }
            返回 某些(命中值482);
        }
    }
    返回 无;
}

// 482：载体槽名（「变量名$cap$捕获名」·生成声明 波1 规则单点）驻留名ID。
函数 载体槽名482(整64 变量名ID, 整64 捕名ID) -> 整64 {
    字符串 载名482 = 字符串复制(驻留文本(变量名ID)) + "$cap$" + 驻留文本(捕名ID);
    返回 驻留(载名482);
}

// 482：载体槽定位（单表版；无值=未建·1360 批5 结果化）——调用方按
//   局部槽->参数槽 顺序两查（同一调用双可变借用=别名冲突，v2 语义拒绝——故拆单表）。
函数 查载体槽482(映射<整64, 整64>& 槽表482, 整64 载名ID) -> 可选<整64> {
    结果<整64, 整32> 查482 = 槽表482.获取(载名ID);
    如果 (查482.正常) { 返回 某些(查482.值); }
    返回 无;
}

// 482：lambda 合成函数节点查找（生成声明 段同款倒序；未找到=节点文本为 0
//   ——合成节点文本=?lambdaN 名ID 恒非 0）。
函数 找合成节点482(向量<节点> 池, 整64 lambda名ID) -> 节点 {
    节点 找到节点482;
    整64 li482 = lambda合成函数索引们.大小() - 1;
    当 (li482 >= 0) {
        节点 cand482 = 池.元素(整32(lambda合成函数索引们.元素(整32(li482))));
        如果 (整64(cand482.文本) == lambda名ID) { 返回 cand482; }
        li482--;
    }
    返回 找到节点482;
}

// 482：单捕获布局解析（捕型/捕码/快照大小三出参——生成声明 段同口径复用）。
函数 解析捕获布局482(向量<节点> 池, 节点 合成482, 整64 lambda名ID, 整64 cap索引,
                     整64& 捕型出, 整64& 捕码出, 整64& 大小出) -> 空类型 {
    捕型出 = 0; 捕码出 = T_整64; 大小出 = 0;
    整64 载体捕获形态 = 0;
    结果<整64, 整32> 查形482 = lambda捕获形态们.获取(lambda名ID);
    // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
    如果 (查形482.正常) { 载体捕获形态 = 查形482.值; } 否则 { }
    整64 参数索引482 = 整64(合成482.子起点) + cap索引;
    整64 载体捕附加 = 0;
    如果 (参数索引482 >= 0 && 参数索引482 < 整64(池.大小())) {
        节点 捕获参数482 = 池.元素(整32(参数索引482));
        如果 (整64(捕获参数482.附加) > 0 &&
            整64(捕获参数482.附加) < 整64(池.大小())) {
            节点 类型节点482 = 池.元素(整32(捕获参数482.附加));
            捕型出 = 整64(类型节点482.文本);
            载体捕附加 = 整64(类型节点482.附加);
        }
    }
    如果 (捕型出 == 0) { 捕型出 = 驻留("整64"); }
    捕码出 = 类型码(捕型出);
    如果 (载体捕获形态 == 3) { 捕码出 = T_整64; }
    否则 如果 (载体捕附加 >= 1 && 载体捕附加 < 256) { 捕码出 = T_整64; }
    // 【#1880】数组前置判（容器/类元素数组显式数组路）：泛型实例数组文本
    //   =「向量$整64[2]」（$ 合成形态+数组后缀）——是容器类 对其剥 $ 基名
    //   命中白名单=真，原守卫 !是容器类 && !是用户类_ID 把它拦外=大小 0=
    //   载体槽按 1 槽分配/双向整拷宽 8（容器数组壳 48B 只同步首 8B=ABI 错位
    //   链）。数组文本谓词单点前置（与固化端 捕是数组旗/蹦床还原段前置判
    //   同判据同源），命中即按数组全尺寸分配载体槽/双向整拷。
    如果 (载体捕获形态 != 3 && 载体捕附加 == 0 &&
        是数组类型文本(驻留文本(捕型出))) {
        整64 数组总字节 = 0;
        整64 数组对齐宽 = 0;
        类型大小与对齐(字符串复制(驻留文本(捕型出)), &数组总字节,
                      &数组对齐宽);
        大小出 = 数组总字节;
    } 否则 如果 (载体捕获形态 != 3 && 载体捕附加 == 0 &&
        !是容器类(驻留文本(捕型出)) && !是用户类_ID(捕型出)) {
        可选<整64> 大小出查 = 查结构体大小(捕型出); 如果 (大小出查.有值) { 大小出 = 大小出查.值; }
        如果 (大小出 <= 0 &&
            (字符串比较(驻留文本(捕型出), "整128") ||
             字符串比较(驻留文本(捕型出), "正128"))) {
            大小出 = 16;
        }
        // 1408（形态①）：数组值捕获=聚合值语义——载体槽按数组全尺寸分配/
        //   双向整拷（发射共享到载体482/发射载体到共享482 的 CopyStruct 宽度
        //   源·与固化/还原两端同批同宽）。数组分支已前置（上方 #1880 数组
        //   前置判·含容器/类元素数组全形态——原内嵌于本守卫的分支撤并）。
    }
}

// 482：载体槽按需建立（每捕获按类型宽分配·生成声明 快照段槽宽约定同款：
//   128=2 槽基址=低半；结构体=多槽基址=最高槽；标量=1 槽）。返回基址槽。
不安全 函数 确保载体槽482(映射<整64, 整64>& 局部槽, 整64 载名ID,
                    整64 捕码482, 整64 大小482, 整64* 槽计数) -> 整64 {
    可选<整64> 已有查482 = 查载体槽482(局部槽, 载名ID);
    如果 (已有查482.有值) { 返回 已有查482.值; }
    整64 基址482 = 0;
    如果 (大小482 > 0) {
        整64 槽数482 = (大小482 + 7) / 8;
        基址482 = 槽计数[0] + 槽数482 - 1;
        槽计数[0] = 槽计数[0] + 槽数482;
    } 否则 如果 (捕码482 == T_整128 || 捕码482 == T_正128) {
        整64 底槽482 = 槽计数[0];
        槽计数[0] = 槽计数[0] + 2;
        基址482 = 底槽482 + 1;
    } 否则 {
        基址482 = 槽计数[0];
        槽计数[0] = 槽计数[0] + 1;
    }
    结果<空类型, 整32> 设槽482 = 局部槽.设置(载名ID, 基址482);
    如果 (!设槽482.正常) { 运行时错误(4); }
    返回 基址482;
}

// 482：共享静态槽 -> 载体槽（接收点/拷贝链目标端；逐捕获按型整拷；返回
//   建成数——0=无槽可建/该 lambda 无可蹦床快照）。
不安全 函数 发射共享到载体482(向量<节点> 池, 整64 变量名ID, 整64 lambda名ID,
                       映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                       向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数) -> 整64 {
    节点 合成482 = 找合成节点482(池, lambda名ID);
    如果 (整64(合成482.文本) == 0) { 返回 0; }
    整64 捕获数482 = 0; 整64 起482 = 0;
    结果<整64, 整32> 查数482 = lambda捕获计数们.获取(lambda名ID);
    // 捕获计数 miss=0=无捕获（循环空转零动作·两态皆正常）
    如果 (查数482.正常) { 捕获数482 = 查数482.值; } 否则 { }
    结果<整64, 整32> 查起482 = lambda捕获起们.获取(lambda名ID);
    // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
    如果 (查起482.正常) { 起482 = 查起482.值; } 否则 { }
    整64 建成482 = 0; 整64 cap482 = 0;
    当 (cap482 < 捕获数482) {
        整64 捕名482 = lambda捕获名序们.元素(整32(起482 + cap482));
        如果 (捕名482 == 0) { cap482++; 继续; }
        整64 捕型482 = 0;
        整64 捕码482 = 0;
        整64 大小482 = 0;
        解析捕获布局482(池, 合成482, lambda名ID, cap482, 捕型482, 捕码482, 大小482);
        字符串 静名482 = "cap$" + 驻留文本(lambda名ID) + "$" + 驻留文本(捕名482);
        整64 静序482 = 0 - 1;
        结果<整64, 整32> 静序482查 = 查静态序号(驻留(静名482));
        如果 (静序482查.正常) { 静序482 = 静序482查.值; } 否则 { }
        如果 (静序482 < 0) { cap482++; 继续; }   // 无快照静态槽=合法无动作
        整64 载槽482 = 确保载体槽482(局部槽, 载体槽名482(变量名ID, 捕名482),
                                     捕码482, 大小482, 槽计数);
        如果 (大小482 > 0) {
            整64 源址482 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            整64 目标址482 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 源址482, T_整64, 静序482));
            IR追加(指令, 建IR指令(IR_取地址, 载槽482, 0, 0, 目标址482, T_整64, 0));
            IR追加(指令, 建IR指令(IR_结构体拷贝, 源址482, 目标址482, 0, 0,
                                 大小482, 0));
        } 否则 {
            整64 读482 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_静态加载, 0, 0, 0, 读482, 捕码482, 静序482));
            IR追加(指令, 建IR指令(IR_存储, 读482, 0, 0, 0, 0, 载槽482));
        }
        建成482 = 建成482 + 1;
        cap482++;
    }
    返回 建成482;
}

// 482：载体槽 -> 共享静态槽（返回点/调用点写回/拷贝链源端；逐捕获按型整拷；
//   返回建成数——0=该变量无载体快照（零动作=现状直路））。
不安全 函数 发射载体到共享482(向量<节点> 池, 整64 变量名ID, 整64 lambda名ID,
                       映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                       向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数) -> 整64 {
    节点 合成482 = 找合成节点482(池, lambda名ID);
    如果 (整64(合成482.文本) == 0) { 返回 0; }
    整64 捕获数482 = 0; 整64 起482 = 0;
    结果<整64, 整32> 查数482 = lambda捕获计数们.获取(lambda名ID);
    // 捕获计数 miss=0=无捕获（循环空转零动作·两态皆正常）
    如果 (查数482.正常) { 捕获数482 = 查数482.值; } 否则 { }
    结果<整64, 整32> 查起482 = lambda捕获起们.获取(lambda名ID);
    // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
    如果 (查起482.正常) { 起482 = 查起482.值; } 否则 { }
    整64 建成482 = 0; 整64 cap482 = 0;
    当 (cap482 < 捕获数482) {
        整64 捕名482 = lambda捕获名序们.元素(整32(起482 + cap482));
        如果 (捕名482 == 0) { cap482++; 继续; }
        可选<整64> 载槽查482 = 查载体槽482(局部槽, 载体槽名482(变量名ID, 捕名482));
        如果 (!载槽查482.有值) {
            载槽查482 = 查载体槽482(参数槽, 载体槽名482(变量名ID, 捕名482));
        }
        如果 (载槽查482.有值) {
            整64 载槽482 = 载槽查482.值;
            整64 捕型482 = 0;
            整64 捕码482 = 0;
            整64 大小482 = 0;
            解析捕获布局482(池, 合成482, lambda名ID, cap482, 捕型482, 捕码482, 大小482);
            字符串 静名482 = "cap$" + 驻留文本(lambda名ID) + "$" + 驻留文本(捕名482);
            整64 静序482 = 0 - 1;
            结果<整64, 整32> 静序482查b = 查静态序号(驻留(静名482));
            如果 (静序482查b.正常) { 静序482 = 静序482查b.值; } 否则 { }
            如果 (静序482 >= 0) {
                如果 (大小482 > 0) {
                    整64 源址482 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    整64 目标址482 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_取地址, 载槽482, 0, 0, 源址482,
                                         T_整64, 0));
                    IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 目标址482,
                                         T_整64, 静序482));
                    IR追加(指令, 建IR指令(IR_结构体拷贝, 源址482, 目标址482, 0, 0,
                                         大小482, 0));
                } 否则 {
                    整64 读482 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_加载, 载槽482, 0, 0, 读482,
                                         捕码482, 0));
                    IR追加(指令, 建IR指令(IR_静态存储, 读482, 0, 0, 0, 0,
                                         静序482));
                }
                建成482 = 建成482 + 1;
            }
        }
        cap482++;
    }
    返回 建成482;
}

// 482：载体点统一处理（接收点/赋值位共用）——右值来源解析+快照拷贝+登记更新；
//   来源未知=清除陈旧登记（防 p482 重赋值后调用仍展开旧定义点）。
不安全 函数 处理载体点482(向量<节点> 池, 整32 右值位置482, 整64 变量名ID,
                    映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                    向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数) {
    如果 (右值位置482 < 0 || 右值位置482 >= 整32(池.大小())) { 返回; }
    节点 右值482 = 池.元素(右值位置482);
    可选<整64> 来源482 = 解析lambda来源482(池, 右值482, 右值位置482);
    如果 (来源482.有值) {
        // 源=标识符（非 ? 前缀=已登记变量）：源载体槽->共享槽（源当前实例）
        //   ——后续共享->目标两跳完成值语义拷贝（拷贝链独立快照）。
        如果 (右值482.类型 == 节点_标识符) {
            字符串 源名482 = 字符串复制(驻留文本(整64(右值482.文本)));
            如果 (!文本前缀(源名482, "?")) {
                发射载体到共享482(池, 整64(右值482.文本), 来源482.值, 局部槽, 参数槽,
                               指令, 寄存器计数, 槽计数);
            }
        }
        发射共享到载体482(池, 变量名ID, 来源482.值, 局部槽, 参数槽,
                       指令, 寄存器计数, 槽计数);
        结果<空类型, 整32> 登482 = lambda闭包变量们.设置(变量名ID, 来源482.值);
        如果 (!登482.正常) { 运行时错误(4); }
    } 否则 {
        结果<空类型, 整32> 清482 = lambda闭包变量们.设置(变量名ID, 0);
        如果 (!清482.正常) { 运行时错误(4); }
    }
}

// 482：返回点处理（生成返回语句 值生成后）——右值=已登记变量时载体槽->共享槽
//   （接收方按「函数返回来源」拷到被返回实例）+本函数返回来源跟踪。
不安全 函数 发射返回点482(向量<节点> 池, 整32 右值位置482,
                    映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                    向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数) {
    如果 (右值位置482 < 0 || 右值位置482 >= 整32(池.大小())) { 返回; }
    节点 右值482 = 池.元素(右值位置482);
    可选<整64> 来源482 = 解析lambda来源482(池, 右值482, 右值位置482);
    如果 (来源482.有值) {
        如果 (右值482.类型 == 节点_标识符) {
            字符串 源名482 = 字符串复制(驻留文本(整64(右值482.文本)));
            如果 (!文本前缀(源名482, "?")) {
                发射载体到共享482(池, 整64(右值482.文本), 来源482.值, 局部槽, 参数槽,
                               指令, 寄存器计数, 槽计数);
            }
        }
        如果 (本函数返回来源482 == 0) {
            本函数返回来源482 = 来源482.值;
        } 否则 如果 (本函数返回来源482 != 来源482.值) {
            本函数返回来源482 = 0 - 1;
        }
    } 否则 {
        如果 (本函数返回来源482 != 0) { 本函数返回来源482 = 0 - 1; }
    }
}
