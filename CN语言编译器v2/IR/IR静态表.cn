// IR 静态表（1946 轮先拆再加：自 IR容器.cn 机械搬移·函数体逐字保留零行为变更）
// 职责：顶层静态声明表族（静态序号们/名/类型/初值区间/需注入/守卫标记——②c C）
//   + IR 层错误计数与统一诊断（[ir2] 纪律）+ 类静态字段表族 + lambda 捕获表族
//   + 收集静态（IR生成 入口收集）。
// 加载序：居 IR容器 后加载（函数IR 数据结构在 IR容器·消费方=生成函数/生成类/
//   IR生成多文件 等 经包内合并全局池解析零改动；先例=IR容器作用域 1415 拆分）。
导入 容器::向量;
导入 映射集合;
导入 IR;         // 函数IR 数据结构 + 键位移（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:

// ==================== 顶层静态声明表（②c C，2026-09-02） ====================

// 任务级生命周期：名ID -> 序号（IR 标识符解析）；名/类型平铺（入口构造注入）；

//   IR生成 入口收集（先清空，幂等）。存储=双后端 .data _cn_gstatic_<序号> 槽

//   （统一指针槽：容器=堆对象指针；标量=初始值——.data 直存折叠字面量）。

静态 映射<整64, 整64> 静态序号们;


// IR 层错误计数与统一诊断（2026-09-04，IR生成.cn 冒烟 [ir2] 纪律收口）：

//   [ir2] 级诊断=IR 不完整（形态不支持/目标未解析）——产物不可信。对齐

//   「语义错误即中止」（E2E 139 纪律）：主.cn 于 IR 生成后检查计数>0 即

//   中止（不产 asm）。单一归属本组件（IR生成/IR容器 诊断点全部经此计数）。

静态 整64 IR层错误计数 = 0;


不安全 函数 IR层诊断(字符串 消息) -> 空类型 {

    IR层错误计数 = IR层错误计数 + 1;

    IO::打印到错误("[ir2] " + 消息 + "\n");

}


函数 取IR层错误数() -> 整64 {

    返回 IR层错误计数;

}


不安全 函数 清空IR层错误计数() -> 空类型 {

    IR层错误计数 = 0;

}

静态 向量<整64> 静态名们;

静态 向量<整64> 静态类型们;

// 87-a（2026-09-12 第八十七轮）：静态初值区间表（每静态 2 项：起点、终点；

//   无初值 = -1/-1）。结构体静态的初值不可 .data 直存（须入口注入逐字段构造/

//   整体拷贝），注入点在 生成函数 的主入口——须按序号回查 AST 初值区间。

静态 向量<整64> 静态初值起点们;

静态 向量<整64> 静态初值终点们;

// 87-a（2026-09-12 第八十七轮）：静态需注入表（1=初值不可 .data 直存，须入口

//   物化）。覆盖：结构体（逐字段构造/整体拷贝）、字符串（驻留/堆串）、以及

//   折叠失败的标量（布尔/浮点/字符字面量——折叠常量值 只认整数文本，原实现

//   静默落 .data 0 = 初值丢失，探针实证 布尔=假/浮=0）。容器类经 NewObject

//   注入（原路径），不入本表。

静态 向量<整64> 静态需注入们;

// 852（2026-10-16·843 呈报）：静态守卫初始化表（1=函数内静态+非常量初值）——
//   运行期初始化由**声明所在函数的语句流守卫块**承担（首调经过声明点快照·
//   665 先例+001 §5.2a「经注入通道」）。原路径进主函数入口注入=在主函数
//   上下文求值初值——引用同函数局部名时查无此名→按未知名发射 _名 全局
//   符号=链接失败（S2/S7 探针·1006 用例实录）。

静态 向量<整64> 静态守卫标记们;


不安全 函数 清空静态表() -> 空类型 {

    静态序号们.清空();

    静态名们 = 向量<整64>();

    静态类型们 = 向量<整64>();

    静态初值起点们 = 向量<整64>();

    静态初值终点们 = 向量<整64>();

    静态需注入们 = 向量<整64>();

    静态守卫标记们 = 向量<整64>();

}


// 收集一个 程序 节点区间的全部静态声明（容器/标量通用——初始值折叠由 IR生成 完成）

// ==================== 070 波G（1026 深度机）：类静态字段 ====================
// 静态 字段=全类共享 .data 槽——**合成名「类$字段」注册顶层静态全链**（静态名们/
//   类型们/序号/初始值·与 收集静态 同构单追加）——静态地址/加载/存储/数据段发射
//   零改动复用。解析期登记 名/类型/初值文本（三表+序驱动向量）；IR生成 收集静态
//   后 补登类静态字段（序号接续顶层——槽布局一致）。
静态 映射<整64, 整64> 类静态字段合成名们;   // 类ID*键位移+字段ID -> 合成名ID（类$字段）
静态 映射<整64, 整64> 类静态字段类型们;     // 同键 -> 类型名ID
静态 映射<整64, 整64> 类静态字段初值们;     // 同键 -> 初值文本ID（0=无初值按 0）
静态 向量<整64> 类静态字段序们;             // 组合键（类ID*键位移+字段ID·解析序·补登遍历驱动）

不安全 函数 清空类静态字段表() -> 空类型 {
    类静态字段合成名们.清空();
    类静态字段类型们.清空();
    类静态字段初值们.清空();
    整64 n = 类静态字段序们.大小();
    当 (n > 0) {
        结果<空类型, 整32> 删 = 类静态字段序们.删除(n - 1);
        如果 (!删.正常) { 运行时错误(4); }
        n--;
    }
}

// 解析期登记（解析类声明 静态字段分支消费）——合成名注册+三表+序驱动
不安全 函数 登记类静态字段(整64 类名ID, 整64 字段名ID, 整64 类型名ID, 字符串 初值文本) -> 空类型 {
    字符串 合成 = 字符串复制(驻留文本(类名ID)) + "$" + 字符串复制(驻留文本(字段名ID));
    整64 合成ID = 驻留(合成);
    整64 组合键 = 类名ID * 键位移 + 字段名ID;
    结果<空类型, 整32> 设1 = 类静态字段合成名们.设置(组合键, 合成ID);
    如果 (!设1.正常) { 运行时错误(4); }
    结果<空类型, 整32> 设2 = 类静态字段类型们.设置(组合键, 类型名ID);
    如果 (!设2.正常) { 运行时错误(4); }
    结果<空类型, 整32> 设3 = 类静态字段初值们.设置(组合键, 驻留(初值文本));
    如果 (!设3.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加序 = 类静态字段序们.追加(组合键);
    如果 (!加序.正常) { 运行时错误(4); }
}

// 查类静态字段类型（未命中/非静态字段 → 错误通道·1240 结果化——静态序号补登在 IR 期不可依赖）
// #1445 同构宿主 findStaticFieldAlongChain：沿基类链向上解析——继承静态字段
//   声明类唯一槽（先本类=子类遮蔽生效；miss 沿 查类基名 链向上——宿主读写全
//   通道落声明类槽同口径）。链耗尽=错误通道显形（禁静默默认）。
函数 查类静态字段类型(整64 类名ID, 整64 字段名ID) -> 结果<整64, 整32> {
    整64 链类ID = 类名ID;
    整64 守卫链 = 0;
    当 (链类ID != 0 && 守卫链 < 64) {
        结果<整64, 整32> 查 = 类静态字段类型们.获取(链类ID * 键位移 + 字段名ID);
        如果 (查.正常) { 返回 正常(查.值); } 否则 { }   // 1457 款：查表 miss=沿链继续（空否则显式化·保留 1445 沿链语义）
        可选<整64> 基查 = 查类基名(链类ID);
        如果 (基查.有值) {
            链类ID = 基查.值;
        } 否则 { 返回 错误(1); }   // 静默豁免业务值: 查类基名 miss=无基类即链耗尽→错误通道显形（#1445 沿链）
        守卫链 = 守卫链 + 1;
    }
    // 静默豁免业务值: 沿链耗尽=错误通道（1360 批5 表轮·develop 存量显形补·PRE-1a）
    返回 错误(1);
}

// 查类静态字段合成名（未命中/非静态字段 → 错误通道）——类内裸名/类名.字段 两消费口径共用
// #1445 同构：沿基类链向上解析——命中祖先条目时合成名=「声明类$字段」（登记表
//   值天然带声明类）→ 静态槽序号即声明类槽（与宿主零分叉）。
函数 查类静态字段合成名(整64 类名ID, 整64 字段名ID) -> 结果<整64, 整32> {
    整64 链类ID = 类名ID;
    整64 守卫链 = 0;
    当 (链类ID != 0 && 守卫链 < 64) {
        结果<整64, 整32> 查 = 类静态字段合成名们.获取(链类ID * 键位移 + 字段名ID);
        如果 (查.正常) { 返回 正常(查.值); } 否则 { }   // 1457 款：查表 miss=沿链继续（空否则显式化·保留 1445 沿链语义）
        可选<整64> 基查 = 查类基名(链类ID);
        如果 (基查.有值) {
            链类ID = 基查.值;
        } 否则 { 返回 错误(1); }   // 静默豁免业务值: 查类基名 miss=无基类即链耗尽→错误通道显形（#1445 沿链）
        守卫链 = 守卫链 + 1;
    }
    // 静默豁免业务值: 沿链耗尽=错误通道（1360 批5 表轮·develop 存量显形补·PRE-1a）
    返回 错误(1);
}

// 434（类名::静态字段 限定读写·#284 ::矩阵第五态）：限定复合名「类名::字段」
//   → 类静态字段类型（0=非限定形态/非用户类/非类静态字段）。宿主侧 `类名::成员`
//   与 `类名.成员` 同通道折叠 MemberExpr（语义/IR 零分叉锚：292/561 点号全绿），
//   v2 词法把限定名折成一个复合文本标识符——语义 5 处（读/写语句位/链式位/
//   自增/自减）经本判定统一回退，判定单一归属防各消费点口径漂移。
// （1240 结果化·9008：未命中 → 错误通道；1=非限定形态 / 2=非用户类 / 3=非类静态字段）
函数 查限定名静态字段类型(整64 名ID) -> 结果<整64, 整32> {
    字符串 限模t = "";
    字符串 限符t = "";
    如果 (拆限定名(字符串复制(驻留文本(名ID)), 限模t, 限符t) != 1) { 返回 错误(1); }
    整64 类IDt = 驻留(限模t);
    如果 (!是用户类_ID(类IDt)) { 返回 错误(2); }
    结果<整64, 整32> 合成t = 查类静态字段合成名(类IDt, 驻留(限符t));
    如果 (!合成t.正常) { 返回 错误(3); }
    返回 查类静态字段类型(类IDt, 驻留(限符t));
}

// 433（002 收口·lambda 值捕获结构体 701）：lambda 捕获形参类型跨层静态表——
//   语义检查lambda 的捕获类型回填写的是**层间按值池**（对 IR 层不可见·
//   生成声明 46-c 同款坑），IR 生成合成函数时捕获形参 附加=0＝无类型节点→
//   登记参数槽 按无类型标量单槽登记→闭包体 p.x 的 解析对象结构体ID miss
//   →「成员字段偏移未知: .x」。表：合成函数名ID*键位移+捕获名ID → 捕型ID
//   （语义回填时登记·登记参数槽 类型节点缺失时查表合成替身·46-c 跨层
//   静态表 同模式——推断声明类型表 先例）。
静态 映射<整64, 整64> lambda捕获参数类型们;

// 457（462-② 同键平行表）：lambda 捕获形参类型**附加位**跨层静态表——
//   433 主表只存捕型基名文本（符号类型ID=剥星基名·55-c 口径），指针层/
//   引用标记（附加=指针层 1..255·引用 256）丢失→指针捕获调用点/快照段
//   按基名误判（捕 点* 判结构体取快照槽地址·快照固化 T_整32 截断指针
//   SEGV·801c 实录）；替身/调用点/蹦床按本表恢复附加位（语义回填时同键
//   登记·解析类型 惯例：附加=指针层+引用×256）。
静态 映射<整64, 整64> lambda捕获参数附加们;

// 登记 lambda 捕获形参类型+附加位（语义检查lambda 回填时调用·IR 层
//   登记参数槽/调用点/蹦床 消费）
不安全 函数 登记lambda捕获参数类型(整64 合成函数名ID, 整64 捕获名ID, 整64 捕型ID,
                      整64 附加位457) -> 空类型 {
    结果<空类型, 整32> 加433 = lambda捕获参数类型们.设置(
        合成函数名ID * 键位移 + 捕获名ID, 捕型ID);
    如果 (!加433.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加附457 = lambda捕获参数附加们.设置(
        合成函数名ID * 键位移 + 捕获名ID, 附加位457);
    如果 (!加附457.正常) { 运行时错误(4); }
}

// 查 lambda 捕获形参类型（未登记/非 lambda 形态 → 错误通道·1238 兜底禁令/1240 替代）
函数 查lambda捕获参数类型(整64 合成函数名ID, 整64 捕获名ID) -> 结果<整64, 整32> {
    结果<整64, 整32> 查433 = lambda捕获参数类型们.获取(合成函数名ID * 键位移 + 捕获名ID);
    如果 (查433.正常) { 返回 正常(查433.值); }
    // 静默豁免业务值: 查表 miss=错误通道（1360 批5 表轮·develop 存量显形补·PRE-1a）
    否则 { 返回 错误(1); }
}

// 查 lambda 捕获形参附加位（未登记 → 错误通道；正常 0=值捕获标量·1..255=指针层·>=256=引用）
函数 查lambda捕获参数附加(整64 合成函数名ID, 整64 捕获名ID) -> 结果<整64, 整32> {
    结果<整64, 整32> 查附457 = lambda捕获参数附加们.获取(合成函数名ID * 键位移 + 捕获名ID);
    如果 (查附457.正常) { 返回 正常(查附457.值); }
    // 静默豁免业务值: 查表 miss=错误通道（1360 批5 表轮·develop 存量显形补·PRE-1a）
    否则 { 返回 错误(1); }
}

// 433：当前生成的 lambda 合成函数名（生成函数 lambda 循环 设置/清零——
//   登记参数槽 对无类型节点参数查表合成类型替身；普通函数生成=0 零侵扰）
静态 整64 当前合成lambda名ID = 0;

不安全 函数 设置当前合成lambda名(整64 名ID) -> 空类型 {
    当前合成lambda名ID = 名ID;
}

函数 取当前合成lambda名() -> 整64 {
    返回 当前合成lambda名ID;
}
// IR生成 收集静态 后补登：类静态字段序号接续顶层（静态名们 尾追加）+初始值注入
//   （初值文本ID 直存·无初值按 0——与 收集静态 标量折叠同款数据面）。
不安全 函数 补登类静态字段(向量<整64>& 初始值们) -> 空类型 {
    整64 i = 0;
    当 (i < 类静态字段序们.大小()) {
        整64 组合键 = 类静态字段序们.元素(i);
        结果<整64, 整32> 查合成 = 类静态字段合成名们.获取(组合键);
        结果<整64, 整32> 查类2 = 类静态字段类型们.获取(组合键);
        结果<整64, 整32> 查值 = 类静态字段初值们.获取(组合键);
        // 1360 批5 PRE-1a 显形补：肯定嵌套固化（v2 结果纪律·.值 访问须在
        //   如果 真分支内）+各层 否则 承接 miss=跳过该字段（业务分流）。
        // 静默豁免业务值: 合成名查表 miss=跳过该字段（三件套不齐·业务分流）
        如果 (查合成.正常) {
            如果 (查类2.正常) {
                如果 (查值.正常) {
                    整64 合成名ID = 查合成.值;
                    整64 序号 = 静态名们.大小();
                    结果<空类型, 整32> 加名 = 静态名们.追加(合成名ID);
                    如果 (!加名.正常) { 运行时错误(4); }
                    结果<空类型, 整32> 加类 = 静态类型们.追加(查类2.值);
                    如果 (!加类.正常) { 运行时错误(4); }
                    结果<空类型, 整32> 设序 = 静态序号们.设置(合成名ID, 序号);
                    如果 (!设序.正常) { 运行时错误(4); }
                    结果<空类型, 整32> 加起 = 静态初值起点们.追加(0 - 1);
                    如果 (!加起.正常) { 运行时错误(4); }
                    结果<空类型, 整32> 加终 = 静态初值终点们.追加(0 - 1);
                    如果 (!加终.正常) { 运行时错误(4); }
                    整64 值ID = 驻留("0");
                    如果 (查值.值 != 0) { 值ID = 查值.值; }
                    结果<空类型, 整32> 加值 = 初始值们.追加(值ID);
                    如果 (!加值.正常) { 运行时错误(4); }
                } 否则 { i++; 继续; }   // 静默豁免业务值: 初值查表 miss=跳过（1360 批5 显形补）
            } 否则 { i++; 继续; }   // 静默豁免业务值: 类型查表 miss=跳过（1360 批5 显形补）
        } 否则 { i++; 继续; }   // 静默豁免业务值: 合成名查表 miss=跳过（1360 批5 显形补）
        i++;
    }
}

不安全 函数 收集静态(向量<节点> 池, 整32 程序节点, 向量<整64>& 初始值们) -> 空类型 {

    节点 程序 = 池.元素(程序节点);

    整64 i = 整64(程序.子起点);

    当 (i < 整64(程序.子终点)) {

        节点 声明 = 池.元素(整32(i));

        如果 (声明.类型 == 节点_静态声明) {

            整64 序号 = 静态名们.大小();

            结果<空类型, 整32> 加名 = 静态名们.追加(整64(声明.文本));

            如果 (!加名.正常) { 运行时错误(4); }

            节点 类型节点 = 池.元素(整32(声明.附加));

            结果<空类型, 整32> 加类 = 静态类型们.追加(整64(类型节点.文本));

            如果 (!加类.正常) { 运行时错误(4); }

            结果<空类型, 整32> 设序 = 静态序号们.设置(整64(声明.文本), 序号);

            如果 (!设序.正常) { 运行时错误(4); }

            // 87-a：初值区间登记（有初值=声明子区间；无=-1/-1）

            整64 初起 = 0 - 1;

            整64 初终 = 0 - 1;

            如果 (声明.子起点 < 声明.子终点) {

                初起 = 整64(声明.子起点);

                初终 = 整64(声明.子终点);

            }

            结果<空类型, 整32> 加起 = 静态初值起点们.追加(初起);

            如果 (!加起.正常) { 运行时错误(4); }

            结果<空类型, 整32> 加终 = 静态初值终点们.追加(初终);

            如果 (!加终.正常) { 运行时错误(4); }

            字符串 类型文本 = 字符串复制(驻留文本(整64(类型节点.文本)));

            整64 需注入v = 0;

            // 852：守卫初始化标记（标量段折叠失败+修饰==1 置位·公共尾追加）

            整64 守卫852 = 0;

            如果 (是容器类(类型文本)) {

                // 容器静态：入口 NewObject+构造（初始值表达式同构，忽略）——

                //   .data 槽初值 0（文本 ID 形态——代码生成经 驻留文本 还原）

                结果<空类型, 整32> 加零 = 初始值们.追加(驻留("0"));

                如果 (!加零.正常) { 运行时错误(4); }

            } 否则 {

                // 标量静态：初始值折叠（空初始化按 0）

                整64 值ID = 驻留("0");

                如果 (声明.子起点 < 声明.子终点) {

                    整64 折叠 = 0;

                    // 919（超承载字面量参与表达式·静态初值求值链收口）：含超载
                    //   字面量的**运算形态**（二元/嵌套）拒折叠走入口注入/守卫
                    //   初始化（运行期 128 域求值+低半截断，与宿主顶层静态表达式
                    //   初值注入通道同构）；单字面量/负号壳=文本保真折叠放行（负号
                    //   拼接零算术·483 的 `静态 整128 丁 = -2^127` 形态：字面量正
                    //   形 2^127 在负号壳下合法，拒折叠走注入会触发裸正形超128判据
                    //   误拒）。判据与缘由见 常量拒折叠919/字面量文本超64域919。
                    // 919-final（2026-10-18 用户裁决「字面量单点判域」升级）：
                    //   拒载面按声明目标域分流——区间含超**目标域**字面量 → IR 层
                    //   诊断拒（编译期拒双保险：语义层 535 单点扫描已前置拦截此类
                    //   形态，本面=漏网兜底）；字面量超 64 承载但目标域内（整128/
                    //   正128 承接）=合法形态 → 拒折叠走入口注入/守卫（运行期
                    //   128 域求值链·不得编译期拒）。
                    如果 (!常量拒折叠919(池, 整32(声明.子起点), 整32(声明.子终点))) {

                        折叠 = 折叠常量值(池, 声明.子起点, 声明.子终点);

                    } 否则 如果 (区间含超域字面量919(池, 整32(整64(声明.子终点) - 1), 类型文本)) {

                        IR层诊断("静态初始化表达式含超 " + 类型文本 + " 域字面量（919）: " + 驻留文本(整64(声明.文本)));

                    }

                    // 1073：折叠值承载分流（.data 直存只认 ≤64 位立即数）——
                    //   ① 超 64 位承载 + 128 界内 → 拒直存走注入（运行期 128 域
                    //   链物化：128 槽 16 字节双半写/≤64 槽隐式窄化；单点判域
                    //   口径「128 上下文承载内→合法放行」的运行期承接）；
                    //   ② 超 128 界 → 编译期拒（IR 层诊断·超一切整型域）；
                    //   ③ 承载内折叠值维持 .data 直存（零回归）。
                    //   判定+诊断单点=静态折叠承载分流919（IR容器判定.cn·三态哨兵）
                    布尔 直存919 = 折叠 != 0;

                    如果 (直存919) {

                        整64 分流919 = 静态折叠承载分流919(
                            字符串复制(驻留文本(折叠)), 类型文本, 整64(声明.文本));

                        如果 (分流919 != 0) { 直存919 = 假; }

                    }

                    // 852（2026-10-16）：折叠失败（非常量初值）按声明归属分派——
                    //   函数内静态（修饰==1·865-a 标记）=守卫初始化（语句流守卫
                    //   块·所在函数上下文求值=局部名可达）；顶层静态维持主函数
                    //   入口注入（001 §5.2a 原通道·998 丙=顶层源 面不动）。
                    //   1073：三态显式枚举（直存/守卫/注入互补完备·非 else 兜底）
                    如果 (直存919) { 值ID = 折叠; }

                    如果 (!直存919 && 声明.修饰 == 1) { 守卫852 = 1; }

                    如果 (!直存919 && 声明.修饰 != 1) { 需注入v = 1; }

                }

                结果<空类型, 整32> 加值 = 初始值们.追加(值ID);

               如果 (!加值.正常) { 运行时错误(4); }

            }

            // 87-a：结构体/字符串（不可 .data 直存）→ 需注入

            如果 (是结构体大小非零(整64(类型节点.文本))) { 需注入v = 1; }

            如果 (字符串比较(类型文本, "字符串")) { 需注入v = 1; }

            结果<空类型, 整32> 加注 = 静态需注入们.追加(需注入v);

            如果 (!加注.正常) { 运行时错误(4); }

            // 852：主静态自身守卫标记（与 静态需注入们 平行——七表追加序严格
            //   一致，guard 哨兵槽在主静态全部七表落定后再追加）

            结果<空类型, 整32> 加卫852 = 静态守卫标记们.追加(守卫852);

            如果 (!加卫852.正常) { 运行时错误(4); }

            // 852：守卫静态补 guard 哨兵槽（合成名+$已初始化·布尔·零初值——
            //   静态七表平行追加序号连续；语句流守卫块经 IR_静态加载/IR_静态
            //   存储按本序号读写哨兵）

            如果 (守卫852 == 1) {

                整64 guard名852 = 驻留(字符串复制(驻留文本(整64(声明.文本))) + "$已初始化");

                整64 guard序852 = 静态名们.大小();

                结果<空类型, 整32> 加g名 = 静态名们.追加(guard名852);

                如果 (!加g名.正常) { 运行时错误(4); }

                结果<空类型, 整32> 加g类 = 静态类型们.追加(驻留("布尔"));

                如果 (!加g类.正常) { 运行时错误(4); }

                结果<空类型, 整32> 设g序 = 静态序号们.设置(guard名852, guard序852);

                如果 (!设g序.正常) { 运行时错误(4); }

                结果<空类型, 整32> 加g起 = 静态初值起点们.追加(0 - 1);

                如果 (!加g起.正常) { 运行时错误(4); }

                结果<空类型, 整32> 加g终 = 静态初值终点们.追加(0 - 1);

                如果 (!加g终.正常) { 运行时错误(4); }

                结果<空类型, 整32> 加g值 = 初始值们.追加(驻留("0"));

                如果 (!加g值.正常) { 运行时错误(4); }

                结果<空类型, 整32> 加g注 = 静态需注入们.追加(0);

                如果 (!加g注.正常) { 运行时错误(4); }

                结果<空类型, 整32> 加g卫 = 静态守卫标记们.追加(0);

                如果 (!加g卫.正常) { 运行时错误(4); }

            }

        }

        i++;

    }

}
