// IR初值解析（1103 拆分：自 IR容器尾.cn 纯机械搬移·函数体逐字保留·零逻辑变化）
// 职责：128 位初值文本解析族——静字节值/静数字字节值/静十六进制段/解析128位初值文本。
// 迁移缘由：IR容器尾.cn 已 994 行（900 警戒线上）——1103「474 移位检查接线」须
//   「先拆再加」（481/861/1036 先例）——纯移动腾余量。
// 加载序：居 IR容器尾 之前（IR容器尾 内 字面量超128域/物化字面量128位 及后续
//   生成表达式/生成声明/代码生成三后端/语法解析类辅助 消费）。
导入 协议常量;   // 335 重构B：协议常量独立包（位模式累加474/位模式合成474）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）


// ==================== 128 位初值文本解析（T46·467-a 宿主对齐·810 下沉 IR 层） ====================
// 〔810（053）自 代码生成共用.cn 下沉：局部 128 位字面量物化（求值层）与静态槽
//   发射（代码生成层）共用同一拆半逻辑——单一归属·单向依赖（代码生成→IR 合法方向）。
//   代码生成三后端调用点零改动（跨包裸名可见·驻留文本 先例）。〕

// 字节取值（本地副本·本文件不导入词法模块）
函数 静字节值(字符串 文本, 整64 位置) -> 整64 {
    返回 整64(文本[位置]) & 255;
}

// 数字字符字节值（'0'~'9'/'a'~'f'/'A'~'F'）→ 0~15；非法 = -1
函数 静数字字节值(整64 字节) -> 整64 {
    如果 (字节 >= 48 && 字节 <= 57) { 返回 字节 - 48; }
    如果 (字节 >= 97 && 字节 <= 102) { 返回 字节 - 87; }
    如果 (字节 >= 65 && 字节 <= 70) { 返回 字节 - 55; }
    返回 0 - 1;
}

// 十六进制段（"lo:hi" 形态两段之一）→ 整64 值；空段/非法/超 64 位 = 假
// 474：高32/低32 分治累加（协议常量 位模式累加474）——满 quad（2^64-1）段
//   中间值不再有符号溢出面（编译器自举安全）；位模式与旧累加逐位一致；
//   >16 位段照旧拒绝（旧 2^60 守卫等价语义——quad 上限 16 位 hex）。
函数 静十六进制段(字符串 文本, 整64 起, 整64 终, 整64& 出) -> 布尔 {
    如果 (终 <= 起) { 返回 假; }
    整64 高 = 0;
    整64 低 = 0;
    整64 i = 起;
    当 (i < 终) {
        整64 d = 静数字字节值(静字节值(文本, i));
        如果 (d < 0) { 返回 假; }
        如果 (i - 起 >= 16) { 返回 假; }
        位模式累加474(16, d, 高, 低);
        i++;
    }
    出 = 位模式合成474(高, 低);
    返回 真;
}

// 128 位静态初值文本 → 高低 64 位（two's complement 双 quad）。对齐宿主
//   types::parseInt128InitText：①"lo:hi" 十六进制两段（IR 常量约定形态）
//   ②+/- 符号 ③0x/0X/0b/0B/0o/0O 前缀（默认十进制）④逐位累加——u64 半字分解
//   （loLo/loHi/hiLo/hiHi × base + carry 各项 < 2^37 无溢出），负数取补码
//   （取反加一·低 64 位归零时向高位进位）。返回 假=非法或超 128 位。
不安全 函数 解析128位初值文本(字符串 文本, 整64& 低出, 整64& 高出) -> 布尔 {
    整64 长 = 字符串长度(文本);
    整64 起 = 0;
    当 (起 < 长 && (静字节值(文本, 起) == 32 || 静字节值(文本, 起) == 9)) { 起++; }
    整64 终 = 长;
    当 (终 > 起 && (静字节值(文本, 终 - 1) == 32 || 静字节值(文本, 终 - 1) == 9)) { 终--; }
    如果 (终 <= 起) { 返回 假; }

    // ① "lo:hi" 形态（冒号分隔十六进制两段·符号无关）
    整64 冒号 = 0 - 1;
    整64 i0 = 起;
    当 (i0 < 终) {
        如果 (静字节值(文本, i0) == 58) { 冒号 = i0; 中断; }
        i0++;
    }
    如果 (冒号 >= 0) {
        整64 低段 = 0;
        整64 高段 = 0;
        如果 (!静十六进制段(文本, 起, 冒号, 低段)) { 返回 假; }
        如果 (!静十六进制段(文本, 冒号 + 1, 终, 高段)) { 返回 假; }
        低出 = 低段;
        高出 = 高段;
        返回 真;
    }

    // ② 符号
    布尔 负 = 假;
    整64 位 = 起;
    整64 首字节v = 静字节值(文本, 位);
    如果 (首字节v == 43 || 首字节v == 45) {
        负 = (首字节v == 45);
        位++;
    }
    如果 (位 >= 终) { 返回 假; }

    // ③ 进制前缀
    正64 进制 = 10;
    如果 (终 - 位 > 2 && 静字节值(文本, 位) == 48) {
        整64 次b = 静字节值(文本, 位 + 1);
        如果 (次b == 120 || 次b == 88) { 进制 = 16; 位 = 位 + 2; }
        否则 如果 (次b == 98 || 次b == 66) { 进制 = 2; 位 = 位 + 2; }
        否则 如果 (次b == 111 || 次b == 79) { 进制 = 8; 位 = 位 + 2; }
    }
    如果 (位 >= 终) { 返回 假; }

    // ④ 逐位累加（半字分解·u64 无溢出）
    正64 低 = 0;
    正64 高 = 0;
    当 (位 < 终) {
        整64 数v = 静数字字节值(静字节值(文本, 位));
        如果 (数v < 0) {
            // 810（053）：类型后缀 L/l/U/u 自断（词法原样存文本·解析无符号 同规
            //   ——324 的 999999999999999999LL 实证）；其余非法字符拒绝
            整64 字节v = 静字节值(文本, 位);
            如果 (字节v == 76 || 字节v == 108 || 字节v == 85 || 字节v == 117) {
                中断;
            }
            返回 假;
        }
        正64 d = 正64(数v);
        如果 (d >= 进制) { 返回 假; }
        正64 低低 = 低 & 4294967295;
        正64 低高 = 低 >> 32;
        正64 t1 = 低低 * 进制 + d;
        正64 进1 = t1 >> 32;
        正64 低高乘 = 低高 * 进制 + 进1;   // 低高吸收进1——其溢出才是高半的进位
        正64 进1b = 低高乘 >> 32;          // 702-fix：原直接传 进1 给高位=重复计入
        正64 新低 = (t1 & 4294967295) | ((低高乘 & 4294967295) << 32);
        正64 高低 = 高 & 4294967295;
        正64 高高位 = 高 >> 32;
        正64 t2 = 高低 * 进制 + 进1b;
        正64 进2 = t2 >> 32;
        正64 新高 = (t2 & 4294967295) | (((高高位 * 进制 + 进2) & 4294967295) << 32);
        低 = 新低;
        高 = 新高;
        位++;
    }
    // 负数 two's complement（取反加一；低 64 位归零时向高位进位）
    // 474：借位显式化（旧 反低+1 回绕面=新语义运行期错误面·编译器自举安全）——
    //   反低==MAX ⟺ 原 低==0 → 低=0 向高借位进 1；高同理级联。
    如果 (负) {
        正64 反低 = ~低;
        正64 反高 = ~高;
        如果 (反低 == 18446744073709551615) {
            低 = 0;
            如果 (反高 == 18446744073709551615) {
                高 = 0;
            } 否则 {
                高 = 反高 + 1;
            }
        } 否则 {
            低 = 反低 + 1;
            高 = 反高;
        }
    }
    低出 = 整64(低);
    高出 = 整64(高);
    返回 真;
}

// 1016（五轮审查 P1-2）：正形整数字面量值 ≤ 2^128-1（128 位无符号位模式
//   承载）——IR 物化面允许负号链中间量（2^127..2^128-1）物化（外层
//   __cn_neg_i128 取负得合法值）；直接使用形态由语义层 535/隐式转换前置
//   于域拒绝。负形文本=非本判据面（负号由独立节点承载）。
函数 字面量在128位承载(字符串 文本) -> 布尔 {
    整64 十进 = 字面量十进制文本(文本);
    // 静默豁免上游已诊断: 十进制化失败=词法已拒形态（显式假哨兵）
    如果 (十进 == 0) { 返回 假; }
    字符串 文 = 字符串复制(驻留文本(十进));
    // 静默豁免业务值: 负形=非本判据面（判定否定分支·显式假哨兵）
    如果 (字符串长度(文) > 0 && (整64(文[0]) & 255) == 45) { 返回 假; }
    返回 数文本不超上界(文, "340282366920938463463374607431768211455");
}

// 1016（四轮审查 P2②）：常量初值可折叠形态判定（单字面量/纯负号链）——
//   自 IR布局中.cn 常量拒折叠919 内联判定下沉（IR布局中.cn 存量 934 行超
//   900 警戒线）。纯负链（[字面量, 负号×N]）折叠后由 静态折叠承载分流919
//   按目标域判域：三负 -2^127 等 128 负域合法形态不再落生成表达式逐节点
//   求值（原内层正字面量 2^127 先按正域误拒）。
函数 常量初值可折叠919(向量<节点> 池, 整32 起, 整32 终) -> 布尔 {
    如果 (终 - 起 == 1) { 返回 真; }
    // 静默豁免闭集穷举: 区间空/单节点边界判定（显式假哨兵·非业务默认值）
    如果 (终 - 起 < 2) { 返回 假; }
    如果 (池.元素(起).类型 != 节点_整数字面量) { 返回 假; }
    整64 q919 = 整64(起) + 1;
    当 (q919 < 整64(终)) {
        节点 负节919 = 池.元素(整32(q919));
        // 静默豁免业务值: 纯负号链形态判定（非负号节点=非本形态·显式假）
        如果 (负节919.类型 != 节点_负号) { 返回 假; }
        q919++;
    }
    返回 真;
}

// 1016（审查 P2-2）：负号壳字面量十进制化（自 IR布局中.cn 折叠常量值 快
//   路径下沉——IR布局中.cn 存量 934 行超 900 警戒线，先拆再加·本文件
//   153 行余量充足）。输入=字面量节点原文（0x/0b/0o 前缀与 L/U 后缀均可），
//   输出=驻留 ID："-" + 规范十进制（-0x8000000000000000 →
//   -9223372036854775808），供 .data 直存（MASM 拒 0x 前缀原文）。
//   十进制化失败=词法已拒形态原文保真（上游已诊断·调用方判域兜底）。
函数 负号壳十进制文本1016(字符串 原文本) -> 整64 {
    整64 规范1016 = 字面量十进制文本(原文本);
    如果 (规范1016 != 0) {
        返回 驻留("-" + 字符串复制(驻留文本(规范1016)));
    }
    返回 驻留("-" + 原文本);
}
