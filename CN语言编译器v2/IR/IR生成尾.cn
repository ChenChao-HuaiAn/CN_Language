// IR生成尾（357 重构F2 自 IR生成.cn 纯机械搬移·函数体逐字保留·零逻辑变化）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

不安全 函数 发射自增增量(向量<IR指令>& 指令, 整64 目标类型码,
                   整64* 寄存器计数) -> 整64 {
    如果 (目标类型码 == T_浮32) {
        整64 浮64寄存器 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_常量浮点, 整64(驻留("1.0")), 0, 0,
                             浮64寄存器, T_浮64, 0));
        整64 降精度寄存器 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_类型转换, 浮64寄存器, T_浮64, 0,
                             降精度寄存器, T_浮32, 0));
        返回 降精度寄存器;
    }
    整64 常量寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    如果 (目标类型码 == T_浮64) {
        IR追加(指令, 建IR指令(IR_常量浮点, 整64(驻留("1.0")), 0, 0,
                             常量寄存器, T_浮64, 0));
    } 否则 {
        IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("1")), 0, 0,
                             常量寄存器, T_整64, 0));
    }
    返回 常量寄存器;
}

// 簇③根治·自减全链 C1（2026-09-04 用户裁决）：自增/自减共用发射函数——目标解析链
//   （局部槽→参数槽→静态序号）+ 引用参数经指针读写回（②c D）+ 静态读写对
//   （③ 第六波），运算码按 是自减 分派 IR_加/IR_减。原 节点_自增 分支体平移
//   抽出（行为零变化），节点_自减 对称接入
// 92-a（2026-09-13 第九十二轮）：目标类型码分派——原恒 T_整64 使浮点自增对
//   IEEE754 位模式做整数加 1（只改尾数最低位，`甲++` 对浮点静默失效；宿主
//   同族缺陷 92-a 同轮根治）。浮点目标：增量常量 1.0 + 浮点运算类型码；
//   槽位模式搬运保持 8 字节（v2 标量槽=1 槽 8 字节，浮32 低位即单精度位模式）。
// 422(002 收口·窄域自增写回回绕):自增/自减写回值窄域规范化——整8/整16/整32/
//   正8/正16/正32 变量 ±1 后写回前规范到目标宽。槽模型 8 字节全宽存储,不规范化=
//   越界值原样入槽(682 实证 整16 32767+1 读回 32768·宿主回绕 -32768·001 §3.7a);
//   指针自增(步进语义)与非窄宽(整64/浮/128·窄宽码自文本=0)零开销直通。七消费点
//   单一归属:语句位 引用/局部/静态/字段(发射自增自减)+表达式位 标识符/静态/字段
//   (生成自增表达式·局部路 894-a 内联判据同款归纳)。类型解析:显式类型名ID 优先
//   (静态路=取静态类型·字段路=查字段类型ID——函数内静态/类字段不在 局部变量
//   类型表,查当前函数变量类型 恒 -1·697 首跑实证),<=0 兜底局部表自查。
不安全 函数 自增写回窄域回绕(整64 显式类型名ID, 整64 名ID, 整64 值寄存器,
                       向量<IR指令>& 指令, 整64* 寄存器计数) -> 整64 {
    整64 类型ID = 显式类型名ID;
    如果 (类型ID <= 0) { 类型ID = 查当前函数变量类型(名ID); }
    如果 (类型ID < 0 || 查指针变量类型(名ID) >= 0) { 返回 值寄存器; }
    返回 窄宽值规范化(窄宽码自文本(驻留文本(类型ID)), 值寄存器, 指令, 寄存器计数);
}

不安全 函数 发射自增自减(向量<IR指令>& 指令, 整64 名ID, 布尔 是自减,
                   映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                   整64* 寄存器计数, 整64* 槽计数) -> 空类型 {
    // 474 接线：槽计数透传（i128 helper 面的常量句柄/结果 2 槽分配所需）
    整64 运算码 = IR_加;
    如果 (是自减) { 运算码 = IR_减; }
    整64 目标类型码 = T_整64;
    整64 自增类型名ID = 查当前函数变量类型(名ID);
    如果 (自增类型名ID >= 0) {
        整64 自增码 = 类型码(自增类型名ID);
        如果 (自增码 == T_浮32 || 自增码 == T_浮64) { 目标类型码 = 自增码; }
    }
    // 432（070 波J·1026）：i128 自增/自减——16B 双半读改写（原按 64 位槽 ±1=
    //   高半不动·432 实录 总值位型错）。局部=双槽（基址槽=局部槽登记）取地址；
    //   静态=合成名静态槽地址。
    // 474 收口接线：自增/自减改走 __cn_add/sub_i128(_chk) helper（常量 1 句柄
    //   实参）——安全函数调 chk 版（溢出=错误码 8·与宿主直发检查行为同构），
    //   不安全 函数维持无检查版（回绕豁免）；替换旧内联进/借位链（进位逻辑
    //   下沉 helper·回绕面行为等价）。
    如果 (自增类型名ID > 0 &&
         (字符串比较(驻留文本(自增类型名ID), "整128") ||
          字符串比较(驻留文本(自增类型名ID), "正128"))) {
        整64 基址128z = 0;
        结果<整64, 整32> 找槽z = 局部槽.获取(名ID);
        如果 (找槽z.正常 && 找槽z.值 != 0) {
            基址128z = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_取地址, 找槽z.值, 0, 0, 基址128z, T_整64, 0));
        }
        如果 (基址128z == 0) {
            整64 找静z = 查静态序号(名ID);
            如果 (找静z < 0 && 当前方法类名ID != 0) {
                找静z = 查静态序号(查类静态字段合成名(当前方法类名ID, 名ID));
            }
            如果 (找静z >= 0) {
                基址128z = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 基址128z, T_整64, 找静z));
            }
        }
        // 466：128 引用参数形态——局部/静态均 miss 落此处；引用槽内容=调用方
        //   16 字节对象首地址（加载即基址·**禁取引用槽自身地址**——432 原两路
        //   对引用参数 miss 跳过 → 落普通引用分支按 64 位 ±1=只改低 8 字节
        //   高半不动·宿主 128& v++ 双段全宽同语义缺口）。
        如果 (基址128z == 0) {
            结果<整64, 整32> 找参z466 = 参数槽.获取(名ID);
            // 466-a（78_v2 自举链 fix_p sem5 实录）：.值 访问须在「如果(正常)」
            //   单条件真分支内——sem5 不识别 && 复合条件链中的 正常 检查传播
            //   （原 `如果 (找参z466.正常 && 找参z466.值 != 0 && 槽是引用(…))`
            //   条件内 .value ×2+真分支 IR追加 .值 ×1=sem5 报 4 错中止 fix_p
            //   编译 v2 全树）。语义等价改写：先单条件取值再判。
            整64 参槽z466 = 0;
            如果 (找参z466.正常) {
                参槽z466 = 找参z466.值;
            }
            如果 (参槽z466 != 0 && 槽是引用(参槽z466)) {
                基址128z = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_加载, 参槽z466, 0, 0,
                                     基址128z, T_整64, 0));
            }
        }
        如果 (基址128z != 0) {
            // 常量 1 句柄（2 槽：高 0 低 1·__cn_add/sub_i128 实参布局）
            整64 一槽起z = 槽计数[0];
            槽计数[0] = 槽计数[0] + 2;
            IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 一槽起z));
            IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 一槽起z + 1));
            整64 一低z = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_常量整数, 驻留("1"), 0, 0, 一低z, T_整64, 0));
            IR追加(指令, 建IR指令(IR_存储, 一低z, 0, 0, 0, 0, 一槽起z + 1));
            整64 一高z = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 一高z, T_整64, 0));
            IR追加(指令, 建IR指令(IR_存储, 一高z, 0, 0, 0, 0, 一槽起z));
            整64 一句柄z = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_取地址, 一槽起z + 1, 0, 0, 一句柄z, T_整64, 0));
            // helper 调用：dst=2 槽临时基址（符号按 是自减 × 不安全474 选调）
            字符串 增减符号474 = 是自减 ? "__cn_sub_i128" : "__cn_add_i128";
            如果 (!读当前生成函数不安全474()) {
                增减符号474 = 是自减 ? "__cn_sub_i128_chk" : "__cn_add_i128_chk";
            }
            整64 果槽起z = 槽计数[0];
            槽计数[0] = 槽计数[0] + 2;
            IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 果槽起z));
            IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 果槽起z + 1));
            整64 dstz = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_取地址, 果槽起z + 1, 0, 0, dstz, T_整64, 0));
            IR追加(指令, 建IR指令(IR_调用实参, 基址128z, 0, 0, 0, 0, 0));
            IR追加(指令, 建IR指令(IR_调用实参, 一句柄z, 0, 0, 1, 0, 0));
            IR追加(指令, 建IR指令(IR_调用实参, dstz, 0, 0, 2, 0, 0));
            IR追加(指令, 建IR指令(IR_调用参数化, 3, 0, 0, 0, 0,
                                 驻留(增减符号474)));
            // 双半写回（dst 2 槽 → 变量基址）
            整64 新低z = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, dstz, 0, 0, 新低z, T_整64, 0));
            IR追加(指令, 建IR指令(IR_指针存储, 基址128z, 新低z, 0, 0, T_整64, 0));
            整64 dst高址z = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_字段地址, dstz, 0, 0, dst高址z, T_整64, 8));
            整64 旧高址z = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_字段地址, 基址128z, 0, 0, 旧高址z, T_整64, 8));
            整64 新高z = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, dst高址z, 0, 0, 新高z, T_整64, 0));
            IR追加(指令, 建IR指令(IR_指针存储, 旧高址z, 新高z, 0, 0, T_整64, 0));
            返回;
        }
    }
    // 266-a 波B：指针变量自增/自减步进=所指元素宽（q++ 语义对齐宿主）
    整64 自增量宽 = 1;
    整64 自增指针所指 = 查指针变量类型(名ID);
    如果 (自增指针所指 > 0) {
        目标类型码 = T_整64;
        自增量宽 = 类型名宽度(自增指针所指);
    }
    整64 目标槽 = 0;
    整64 找静 = 0 - 1;
    结果<整64, 整32> 找槽 = 局部槽.获取(名ID);
    如果 (找槽.正常) { 目标槽 = 找槽.值; }
    如果 (目标槽 == 0) {
        结果<整64, 整32> 找参 = 参数槽.获取(名ID);
        如果 (找参.正常) { 目标槽 = 找参.值; }
    }
    如果 (目标槽 == 0) {
        // 静态槽自增/自减：IR_静态加载/静态存储 读写对（②c C 设施）
        找静 = 查静态序号含类(名ID);
        如果 (找静 < 0 && 当前方法类名ID != 0) {
            // 070 波G：类内静态字段裸名——合成名「类$字段」的静态槽（查静态序
            //   号(0)=miss 安全）
            找静 = 查静态序号含类(查类静态字段合成名(当前方法类名ID, 名ID));
        }
        如果 (找静 < 0) {
            // 434（类名::静态字段 限定写·#284 ::矩阵第五态）：自增/自减语句位
            //   限定复合名回退——查限定名静态序号 单点分派（表达式位
            //   生成自增表达式 同源·宿主 `类名::字段++/--` 左值通道同语义）
            找静 = 查限定名静态序号(名ID);
        }
        如果 (找静 >= 0) {
            整64 静值reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_静态加载, 0, 0, 0, 静值reg, 目标类型码, 找静));
            整64 静常量1 = 发射自增增量宽(指令, 目标类型码, 寄存器计数, 自增量宽);
            整64 静结果 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            // 474：自增/自减溢出检查（检查码=静态槽类型名→全整型族码；指针/浮点=0）
            IR追加(指令, 建IR指令(运算码, 静值reg, 静常量1, 0, 静结果, 目标类型码,
                                 溢出检查码474(检查码自类型名ID(取静态类型(找静)))));
            // 422:静态槽窄域回绕（静态不在局部类型表·显式传 取静态类型）
            静结果 = 自增写回窄域回绕(取静态类型(找静), 名ID, 静结果, 指令, 寄存器计数);
            IR追加(指令, 建IR指令(IR_静态存储, 静结果, 0, 0, 0, 目标类型码, 找静));
        }
    }
    // 433-b 根治：字段自增/自减（方法体内裸字段名 数量++）——字段地址（this+
    //   偏移）→ 过指针加载旧值 → ±增量 → 过指针存储写回（与 生成标识符赋值
    //   字段路径同款）。原三路（局部/参数/静态）不含字段=自增静默丢失（456
    //   实测：数量 恒 0→第二次写入覆盖第一次→取(0)=20）
    如果 (目标槽 == 0 && 找静 < 0 && 当前方法类名ID != 0) {
        整64 字段偏z = 当前方法字段偏移(名ID);
        如果 (字段偏z >= 0) {
            // 463：字段自增读写宽按字段类型码（布局实宽下恒 qword 读写踩相邻
            //   窄字段——加载与存储同码对称·与 生成表达式中 表达式位字段自增
            //   同判据；浮点局部变量面已有覆盖不扰）
            目标类型码 = 查字段宽度码(当前方法类名ID, 名ID);
            整64 字段地址z = 发射类字段地址(字段偏z, 指令, 寄存器计数);
            整64 旧值z = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 字段地址z, 0, 0, 旧值z, 目标类型码, 0));
            整64 常量1z = 发射自增增量宽(指令, 目标类型码, 寄存器计数, 自增量宽);
            整64 结果z = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            // 474：字段自增/自减溢出检查（检查码=字段类型名→全整型族码）
            IR追加(指令, 建IR指令(运算码, 旧值z, 常量1z, 0, 结果z, 目标类型码,
                                 溢出检查码474(检查码自类型名ID(
                                     查字段类型ID(当前方法类名ID, 名ID)))));
            // 422:类字段窄域回绕（字段不在局部类型表·显式传 查字段类型ID）
            结果z = 自增写回窄域回绕(查字段类型ID(当前方法类名ID, 名ID), 名ID,
                                  结果z, 指令, 寄存器计数);
            IR追加(指令, 建IR指令(IR_指针存储, 字段地址z, 结果z, 0, 0, 目标类型码, 0));
        }
    }
    如果 (目标槽 != 0) {
        整64 寄存器1 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        如果 (槽是引用(目标槽)) {
            // 引用参数：经指针读写回调用方槽
            整64 地址reg2 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 地址reg2, T_整64, 0));
            IR追加(指令, 建IR指令(IR_指针加载, 地址reg2, 0, 0, 寄存器1, 目标类型码, 0));
            整64 常量1r = 发射自增增量宽(指令, 目标类型码, 寄存器计数, 自增量宽);
            整64 结果寄存器r = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            // 474：引用形参自增/自减溢出检查（检查码=变量类型名→全整型族码）
            IR追加(指令, 建IR指令(运算码, 寄存器1, 常量1r, 0, 结果寄存器r, 目标类型码,
                                 溢出检查码474(检查码自类型名ID(自增类型名ID))));
            // 422:引用形参窄域回绕（写回调用方槽前规范到窄宽·与局部路同判据）
            结果寄存器r = 自增写回窄域回绕(自增类型名ID, 名ID, 结果寄存器r, 指令, 寄存器计数);
            IR追加(指令, 建IR指令(IR_指针存储, 地址reg2, 结果寄存器r, 0, 0, 目标类型码, 0));
        } 否则 {
            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 寄存器1, T_整64, 0));
            整64 常量1 = 发射自增增量宽(指令, 目标类型码, 寄存器计数, 自增量宽);
            整64 结果寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            // 474：局部/参数自增/自减溢出检查（检查码=变量类型名→全整型族码；
            //   指针步进/浮点 delta=检查码 0 直通）
            IR追加(指令, 建IR指令(运算码, 寄存器1, 常量1, 0, 结果寄存器, 目标类型码,
                                 溢出检查码474(检查码自类型名ID(自增类型名ID))));
            // 422:局部/参数槽窄域回绕（319 修复漏网的语句位通道·682 实证）
            结果寄存器 = 自增写回窄域回绕(自增类型名ID, 名ID, 结果寄存器, 指令, 寄存器计数);
            IR追加(指令, 建IR指令(IR_存储, 结果寄存器, 0, 0, 0, 0, 目标槽));
        }
    }
}

// 引用参数标识符读取发射（压值）：
//   容器&：Load 槽（=&调用方槽）-> 指针加载（=对象指针，方法接收者 this 直用）；
//   结构体&：Load 槽（=调用方结构体基址——成员基址直接复用，不再解引用）；
//   标量&：Load 槽 -> 指针加载（=值）。
不安全 函数 发射引用参数读(整64 槽, 向量<IR指令>& 指令, 整64* 寄存器计数,
                     向量<整64>& 表达式栈) -> 空类型 {
    // 1121 审查 P2：类型ID=0 是查表 miss 的**显式哨兵**（0=未登记），不是静默
    //   默认值——此后的 类型文本="" 只用于形态分流（容器/用户类/结构体判定全
    //   miss=按标量路），真正消费点 引用参数存储码 对 类型ID<=0 单点
    //   登记内部未登记（648 miss 不可静默·收尾统一中止），故此处无需重复报错
    //   （合法恢复路径依赖：miss 必然在存储码处显形·防双报）。
    整64 类型ID = 0;
    结果<整64, 整32> 查类型 = 引用参数类型们.获取(槽);
    如果 (查类型.正常) { 类型ID = 查类型.值; }
    整64 地址寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 槽, 0, 0, 地址寄存器, T_整64, 0));
    字符串 类型文本 = 字符串复制(驻留文本(类型ID));
    // 847（指针槽语义四件套之②c·被调侧）:容器/**用户类**引用参数=指针槽——
    //   槽内容＝变量地址（调用侧传左值地址），值＝对象指针须**两层读取**
    //   （[槽] 得变量地址 → 指针加载得对象指针）。用户类并入理由：用户类字段/
    //   参数与容器同为指针槽（838/843 模型），旧实现落下方「结构体分支」按
    //   值语义一层 → 少一次解引用（V13 铁证：盒子$盒子盒子的 其他.表 读
    //   [&a.内+0]=C 而应 [[&a.内]+0]=P2 → 克隆元素数量 0）。结构体（内嵌值）
    //   保持一层（槽内容即对象地址）。
    如果 (是容器类(类型文本) || 是用户类(类型文本)) {
        整64 对象寄存器 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_指针加载, 地址寄存器, 0, 0, 对象寄存器, T_对象, 0));
        结果<空类型, 整32> 加容 = 表达式栈.追加(对象寄存器);
        如果 (!加容.正常) { 运行时错误(4); }
        返回;
    }
    如果 (查结构体大小(类型ID) != 0) {
        结果<空类型, 整32> 加结 = 表达式栈.追加(地址寄存器);
        如果 (!加结.正常) { 运行时错误(4); }
        返回;
    }
    整64 值寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    // 425：窄整族按登记类型码窄读（消 8 字节读脏高位——宿主整32& 读 4 字节）
    // 449：窄码同步登记寄存器类型——下游 浮点宽化存储/窄宽值规范化 经
    //   查寄存器类型 判「源已规范」；miss（未知=整数类兜底）会把浮32 位模式
    //   当整数 cvtsi2ss 重转换（`浮32 t = a;` t=1.06e9 级垃圾·449 探针
    //   ft[2] 位不齐实证），窄整族同漏=多余一次位模式转换。同码直通零开销。
    整64 读码449 = 引用参数存储码(槽);
    // 466：128 读=**别名句柄**——地址寄存器已是调用方 16 字节对象首地址
    //   （值=地址语义·与 810 一切 128 消费点契约同构），登记 T_整128/T_正128
    //   直压栈：下游双半拷/打印传址/128 二元/实参物化全按「读 [句柄]」消费
    //   （只读面）=lvalue-to-rvalue 快照语义与宿主 LoadPtr i128 全宽读等价。
    //   修前 读码=T_整64 单条 8 字节读=高半静默丢失（466 形态④探针实录）。
    如果 (读码449 == T_整128 || 读码449 == T_正128) {
        登记寄存器类型(地址寄存器, 读码449);
        结果<空类型, 整32> 加128读 = 表达式栈.追加(地址寄存器);
        如果 (!加128读.正常) { 运行时错误(4); }
        返回;
    }
    IR追加(指令, 建IR指令(IR_指针加载, 地址寄存器, 0, 0, 值寄存器, 读码449, 0));
    // 1030（1017 采样轮探针 p19 同族·浮64 引用读值登记根治）：登记改值语义
    //   精确码——读码449 是读写字节宽码（宽类型兜底 T_整64），浮64& 读值按
    //   它登记 T_整64 会让下游 浮点宽化存储 判「源=整」走 cvtsi2sd 错转位
    //   模式（`浮64 临时 = 甲;` 甲:浮64& → 4609434218613702656.000000 实录）。
    //   与 449（浮32 窄码同步登记）/466（128 直压栈）同轴补齐。
    登记寄存器类型(值寄存器, 引用参数值码(类型文本, 读码449));
    结果<空类型, 整32> 加标 = 表达式栈.追加(值寄存器);
    如果 (!加标.正常) { 运行时错误(4); }
}

// 1030（1017 采样轮探针 p19 同族·引用读值类型码）：读宽度码→值语义精确码。
//   引用参数存储码 产出的 读码449 是「指针读写字节宽」语义（宽类型兜底
//   T_整64=8 字节），用作 值寄存器类型登记 时浮64 被误判整源（浮点宽化
//   存储 走 cvtsi2sd 错转·`浮64 临时 = 甲;` 甲:浮64& 出
//   4609434218613702656.000000 实录）。本函数=登记精化：窄族/浮32/128/
//   枚举（读码非 T_整64）=读码自身即精确直通（449/466 既有登记面零变化）；
//   T_整64 兜底面剥尾 '&' 后走**类型码 全量映射**（由调用方传入类型文本=
//   同一类型表查询单点消化，函数内不重复查表）——与 1036 引用返回通道
//   （生成表达式求值尾.cn 发射引用返回加载：类型码(剥&基类型ID)，T_未知/
//   T_空类型 不登记）同口径：正64→T_正64（无符号打印/除法/移位/比较分派）、
//   字符*→T_字符串（借用视图按字符串打印·IR容器签名.cn 类型码 定义）、
//   浮64→T_浮64、字符串→T_字符串（1121：lambda [&] 捕获字符串/普通 字符串&
//   形参读值原落 T_整64 → 打印分派 __cn_print_int 打指针值/拼接比较走整数
//   路径；审查 P1-1 同族：正64&/字符*& 同病）。类型码 T_未知（结构体/容器
//   句柄/域外名）与 T_空类型（void 无值语义）=合法终态落 T_整64 兜底。
//   类型表 miss=调用方存储码已单点 登记内部未登记，类型文本此处为空串→
//   类型码 T_未知→T_整64（随其后·防双报）。
函数 引用参数值码(字符串 类型文本1030, 整64 读码449) -> 整64 {
    如果 (读码449 != T_整64) { 返回 读码449; }
    字符串 名1030 = 字符串复制(类型文本1030);
    整64 名长1030 = 字符串长度(名1030);
    当 (名长1030 > 1 && ((整64(名1030[整32(名长1030 - 1)]) & 255) == 38)) {
        名1030 = 字符串子串(名1030, 0, 整32(名长1030 - 1));
        名长1030--;
    }
    // 1121 审查 P1-1（甲案）：类型文本匹配升级为 类型码 全量映射（与 1036
    //   引用返回登记同函数口径）——原逐名 if 链只覆盖 浮64/字符串，正64 与
    //   字符* 落 T_整64：正64& 读值按有符号分派（x/2 大值→0、x>>1→-1、
    //   x>100 误判、打印 -1），字符*& 读值走 __cn_print_int 打指针整数；
    //   宿主 mapType 同面=正64 无符号/T_字符串 借用视图（探针 p1121_u64/
    //   p1121_cptr 双侧实录）。T_未知/T_空类型=合法哨兵（域外名/void），
    //   保持 T_整64 兜底（结构体/容器引用走 发射引用参数读 专门分支，不到
    //   本函数；此处域=标量宽类型）。
    整64 码1030 = 类型码(驻留(名1030));
    如果 (码1030 != T_未知 && 码1030 != T_空类型) { 返回 码1030; }
    返回 T_整64;
}

// 1089（1017 采样轮探针 v07 同族·字符串 T& 引用交换双侧病·v2 侧）：引用参数
//   目标是否**字符串**类型（引用参数类型们 登记=类型节点.文本原样含尾 '&'——
//   剥尾 '&' 后比较「字符串」·与 引用参数值码/引用参数存储码 剥尾同轴）。
//   出参串赋值前处理（发射出参串赋前处理1089）以此判形态：非字符串引用目标
//   （整/浮/容器/结构体/指针…）零运行期税直退（防误清整数引用源变量）。
//   类型表 miss（<=0）=未登记形态，返回假=本通道不适用（形态枚举分流，
//   非静默取值继续——调用方仅跳过源移交，写回不受影响）。
函数 是引用串参数1089(整64 槽) -> 布尔 {
    布尔 是串1089 = 假;
    整64 类型ID1089 = 0;
    结果<整64, 整32> 查类型1089 = 引用参数类型们.获取(槽);
    如果 (查类型1089.正常) { 类型ID1089 = 查类型1089.值; }
    如果 (类型ID1089 >= 1 && 类型ID1089 <= 2147483647) {
        字符串 名1089a = 字符串复制(驻留文本(类型ID1089));
        整64 长1089a = 字符串长度(名1089a);
        当 (长1089a > 1 && ((整64(名1089a[整32(长1089a - 1)]) & 255) == 38)) {
            名1089a = 字符串子串(名1089a, 0, 整32(长1089a - 1));
            长1089a--;
        }
        是串1089 = 字符串比较(名1089a, "字符串");
    }
    返回 是串1089;
}


// 清空引用参数模块表（IR生成/IR生成多文件 入口——任务级生命周期）
不安全 函数 清空引用参数表() -> 空类型 {
    函数实参引用们.清空();
    引用参数槽们.清空();
    引用参数类型们.清空();
    指针参数槽们.清空();
}


// ==================== 跨子模块访问函数（千行拆分，2026-09-08） ====================
//   生成表达式/生成语句/生成函数 子模块经下列 公开: 函数访问函数级权威表
//   （静态表=文件级私有，跨文件仅函数可见——表与访问函数同文件单一归属；
//   查询未命中统一返回 -1 哨兵：类型ID/宽度值域恒正无冲突）
不安全 函数 累计retbuf字节数(整64 字节数) -> 空类型 {
    如果 (字节数 > 当前retbuf字节数) { 当前retbuf字节数 = 字节数; }
}

函数 取retbuf字节数() -> 整64 {
    返回 当前retbuf字节数;
}

不安全 函数 复位retbuf字节数() -> 空类型 {
    当前retbuf字节数 = 0;
}

// 71-a（2026-09-11 方案A 用户裁决）：本函数已装箱（正常/某些(标识符)）名ID 集
//   合——装箱=所有权经结果/可选转交（Rust Ok(s) move 语义），出口释放（发射
//   字符串释放/发射容器析构/块出口析构）对已装箱名跳过=防「装箱浅共享×出口
//   释放=悬垂」（宿主 ir_error_ctor 源槽清零同效，v2 侧跳过模型更优：双装箱
//   退化为借用共享而非源清零 NULL）。名单外/污染名登记无副作用（出口本就
//   不释放）。函数级生命周期（生成函数 开头随 清空函数级槽表 重置）。
静态 向量<整64> 已装箱名们;

// 75-a（2026-09-12 第七十五轮，方案甲 用户裁决）：**当前函数串污染名单镜像**。
//   动机：入容器位所有权归一化（归一化入容器实参，位于生成表达式求值 深层）
//   拿不到 函数信息，而「转移(拥有局部) 入容器=真 move」判定需要「源是否拥有」
//   ——污染名单是唯一缺口信息（局部槽/参数槽 已随调用链可得）。
//   与权威 函数信息.字符串污染们 **同生同灭**：唯一写入入口 登记串污染
//   （内部同时写权威与镜像），函数级重置随 清空函数级槽表（生成函数 开头）。
//   ⚠ 维护契约：新增污染登记点一律经 登记串污染，**禁止直写 函数信息.字符串污染们**
//   （直写会让镜像漏项 → 归一化误判「拥有」→ 容器接管借用句柄 → 容器析构释放
//   他人串=UAF；镜像漏项方向不保守，故此处以注释为强制约束）。
静态 向量<整64> 当前串污染们;

// 登记串污染（唯一写入入口）：写权威 函数信息.字符串污染们 + 追加镜像（去重）
函数 登记串污染(函数IR& 函数信息, 整64 名ID) -> 空类型 {
    结果<空类型, 整32> 设污 = 函数信息.字符串污染们.设置(名ID, 1);
    如果 (!设污.正常) { 运行时错误(4); }
    登记串污染镜像(名ID);
}

// 79-a：镜像登记（无 函数IR 上下文路径——如 生成方法调用 作用域无函数信息，
//   污染仅经镜像；释放侧 发射资源字段析构 同读镜像=自洽）。语义=「该名退出
//   拥有权（RAII 释放跳过）」——字符串借用视图 与 入容器结构体共享源 共用。
不安全 函数 登记串污染镜像(整64 名ID) -> 空类型 {
    如果 (!是当前串污染(名ID)) {
        结果<空类型, 整32> 加污 = 当前串污染们.追加(名ID);
        如果 (!加污.正常) { 运行时错误(4); }
    }
}

// 查询镜像（归一化真 move 判据之一；名ID 命中=借用视图/非拥有初始化）
函数 是当前串污染(整64 名ID) -> 布尔 {
    整64 i = 0;
    当 (i < 当前串污染们.大小()) {
        如果 (当前串污染们.元素(i) == 名ID) { 返回 真; }
        i++;
    }
    返回 假;
}

不安全 函数 清空函数级槽表() -> 空类型 {
    // ②c D/③第三波：函数级生命周期（生成函数 开头重置，串行无交叉）
    引用参数槽们.清空();
    引用参数类型们.清空();
    指针参数槽们.清空();
    寄存器类型们.清空();
    指针变量类型们.清空();
    指针变量层数们.清空();   // 615：层数表成对清（同函数级生命周期）
    指针值步进们.清空();
    已装箱名们.清空();
    当前串污染们.清空();
    结构体返回临时们.清空();   // 81-a-v2：返回物化登记（防跨函数寄存器号误命中）
}

不安全 函数 登记已装箱名(整64 名ID) -> 空类型 {
    结果<空类型, 整32> 加 = 已装箱名们.追加(名ID);
    如果 (!加.正常) { 运行时错误(4); }
}

函数 是已装箱名(整64 名ID) -> 布尔 {
    整64 i = 0;
    当 (i < 已装箱名们.大小()) {
        如果 (已装箱名们.元素(i) == 名ID) { 返回 真; }
        i++;
    }
    返回 假;
}

// 265-a 波A：公共类型提升（整型族）——位宽大者胜（64>32）；同宽整32×正32
//   混=升 T_整64（保守不截断）；双正32=T_正32/双整32=T_整32（唯一 32 位
//   截断面·后端 264-a 出口截断配套）；非整型参与（指针/串/布尔/未知）=保守
//   T_整64 兜底。浮点面由 浮点混合转换 前置处理不经此函数。
// 648 归档：本函数=纯码映射（无查表），「非整型参与升 T_整64」与「64 位面
//   默认 T_整64」均为设计终态合法返回路径（指针算术/常规整型运算主路径），
//   非「查表 miss 终态取默认」立法面，不登记。
函数 公共整型提升(整64 左码, 整64 右码) -> 整64 {
    整64 左宽 = 0;
    如果 (左码 == T_整32 || 左码 == T_正32) { 左宽 = 32; }
    如果 (左码 == T_整64 || 左码 == T_正64) { 左宽 = 64; }
    整64 右宽 = 0;
    如果 (右码 == T_整32 || 右码 == T_正32) { 右宽 = 32; }
    如果 (右码 == T_整64 || 右码 == T_正64) { 右宽 = 64; }
    如果 (左宽 == 0 || 右宽 == 0) { 返回 T_整64; }
    // 无符号胜（C/Rust unsigned wins·46-f 宿主口径）：64 位面任一正64=T_正64
    //   （178 形5 全一>>60 的 shr 依赖·归并整64 会误走 sar=-1）；32 位面任一
    //   正32=T_正32（191 的 udiv/shr 面）；否则 T_整32（唯一 32 位截断面）
    如果 (左宽 == 64 || 右宽 == 64) {
        如果 (左码 == T_正64 || 右码 == T_正64) { 返回 T_正64; }
        返回 T_整64;
    }
    如果 (左码 == T_正32 || 右码 == T_正32) { 返回 T_正32; }
    返回 T_整32;
}

// ==================== 474（运行期整数溢出·错误码 8）发射面设施 ====================

// 源码类型名ID → 溢出检查类型码：全整型族（整8/16/32/64、正8/16/32/64）精确
//   名命中→对应码；指针/字符串/布尔/浮点/窄宽表外/未知名（含 -1 miss）→0
//   （不检查——解析节点类型ID 检不出=诚实边界，与语义层同口径；指针名精确
//   不命中=指针算术天然豁免，对齐宿主）。
函数 检查码自类型名ID(整64 类型名ID) -> 整64 {
    如果 (类型名ID <= 0) { 返回 0; }
    字符串 名 = 字符串复制(驻留文本(类型名ID));
    如果 (字符串比较(名, "整8")) { 返回 T_整8; }
    如果 (字符串比较(名, "整16")) { 返回 T_整16; }
    如果 (字符串比较(名, "正8")) { 返回 T_正8; }
    如果 (字符串比较(名, "正16")) { 返回 T_正16; }
    如果 (字符串比较(名, "整32")) { 返回 T_整32; }
    如果 (字符串比较(名, "正32")) { 返回 T_正32; }
    如果 (字符串比较(名, "整64")) { 返回 T_整64; }
    如果 (字符串比较(名, "正64")) { 返回 T_正64; }
    返回 0;
}

// 当前生成函数不安全标志（474 溢出检查豁免面）：真=本函数为 不安全 修饰
//   （节点.修饰 位 0·语义层 153-a 同款判据 %2），算术发射点据此把检查码置 0
//   （不安全函数内溢出维持两补码回绕=宿主同构）。生成函数 串行——入口设置，
//   同 全局模式（当前方法类名ID/当前函数尾块ID 同族）。
静态 布尔 当前生成函数不安全474 = 假;

不安全 函数 设当前生成函数不安全474(布尔 值) -> 空类型 {
    当前生成函数不安全474 = 值;
}

函数 读当前生成函数不安全474() -> 布尔 {
    返回 当前生成函数不安全474;
}

// 溢出检查码终判：不安全函数内=0（豁免）；安全函数=检查码原样。
函数 溢出检查码474(整64 检查码) -> 整64 {
    如果 (读当前生成函数不安全474()) { 返回 0; }
    返回 检查码;
}

// IR 侧类型码白名单（全整型族码有效，其余 0）——地址模型自增宽度码等
//   已是类型码域的输入用（与代码生成共用层 溢出检查码自附加 同判据副本；
//   IR 包禁导入代码生成〔单向依赖〕故单点复制，判据恒同步改双处）。
函数 溢出检查码自码474(整64 码) -> 整64 {
    如果 (码 == T_整32 || 码 == T_整64 || 码 == T_整8 || 码 == T_整16 ||
         码 == T_正8 || 码 == T_正16 || 码 == T_正32 || 码 == T_正64) {
        返回 码;
    }
    返回 0;
}

不安全 函数 登记指针值步进(整64 寄存器, 整64 宽) -> 空类型 {
