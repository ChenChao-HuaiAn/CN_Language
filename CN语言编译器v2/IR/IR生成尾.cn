// 425（wt425·55_reference 实录·宿主整32& 写 4 字节同构）：引用参数读写宽度
//   码——按 引用参数类型们 登记的类型名取宽度码，**窄族**（整8/正8/整16/
//   正16/整32/正32/布尔/字符/浮32）返回窄码（IR_指针加载/存储 三后端按码
//   发射 byte/word/dword 宽度）；其余（浮64/指针/容器/结构体/未知）返回
//   T_整64（8 字节·存量兼容——浮64& 写读全宽 8 字节本就正确）。
//   根因=引用参数赋值写回恒 T_整64：整32& 写 8 字节过写相邻数组元素
//   （`交换(表[0],表[2])` 表[1] 被清零·探针 D 三案例「a=b 与 b=临时 各写
//   8 字节」逐位吻合铁证；指针下标写走 查指针变量 类型 宽度面无此病=同轮
//   对照）。
// 449（wt449·审查扩面根治）：**不经 类型码()**——其把 整8/整16/正8/正16/
//   字符/指针 归并返回 T_整64（IR容器签名·运算层中立归并），上版白名单
//   五分支成死代码：整8&/正8&/整16&/正16&/字符& 引用写回仍 8 字节过写
//   （449 探针矩阵实证：整8[6] 交换(表[0],表[4]) 表[1..3] 清零、字符[4]
//   交换 表[1] 垃圾大数）。本版直接按登记类型名文本映射宽度码+枚举名→
//   整32 档（宿主 mapType 枚举=i32 4 字节·279 布局 4/4 同源），函数内
//   闭环一处根治全族、不触 类型码 全局归并面；尾缀 '&' 剥层防御
//   （466-a 同款——方法形参类型文本带 & 形态）。浮32→T_浮32 配套三后端
//   IR_指针存储/加载 补 dword 分支（宿主 f32 movss 4 字节同构）。
函数 引用参数存储码(整64 槽) -> 整64 {
    整64 类型ID = 0;
    结果<整64, 整32> 查类型 = 引用参数类型们.获取(槽);
    如果 (查类型.正常) { 类型ID = 查类型.值; }
    如果 (类型ID <= 0) {
        // 648：miss 不可静默——登记显形，收尾统一中止；原兜底保留（中止前
        //   路径）。引用参数类型表 miss=该槽类型未登记（真 miss 面·窄引用
        //   误按 8 字节读写=过写踩邻槽族病源）。行号=0（发射期无源码行上
        //   下文；槽号为现场可得标识）。
        登记内部未登记("引用参数存储码",
                       "槽" + 整数转字符串(槽), 0);
        返回 T_整64;
    }
    字符串 名449 = 字符串复制(驻留文本(类型ID));
    整64 名长449 = 字符串长度(名449);
    当 (名长449 > 1 && ((整64(名449[整32(名长449 - 1)]) & 255) == 38)) {
        名449 = 字符串子串(名449, 0, 整32(名长449 - 1));
        名长449--;
    }
    如果 (字符串比较(名449, "整8")) { 返回 T_整8; }
    如果 (字符串比较(名449, "整16")) { 返回 T_整16; }
    如果 (字符串比较(名449, "正8")) { 返回 T_正8; }
    如果 (字符串比较(名449, "正16")) { 返回 T_正16; }
    如果 (字符串比较(名449, "字符")) { 返回 T_字符; }
    如果 (字符串比较(名449, "整32")) { 返回 T_整32; }
    如果 (字符串比较(名449, "正32")) { 返回 T_正32; }
    如果 (字符串比较(名449, "布尔")) { 返回 T_布尔; }
    如果 (字符串比较(名449, "浮32")) { 返回 T_浮32; }
    // 466（wt466·任务行实录）：128 档——返回专用码作为「16 字节面」判别，
    //   读写两侧（发射引用参数读/生成标识符赋值 128 通道/自增引用分支）按它
    //   展开双半序列（单条 指针存储/加载 三后端无 128 宽度分派·恒不落单条）。
    //   修前 128& 落 T_整64 兜底：写回落只写低 8 字节（宿主 i128 双段写 16 字节
    //   全宽——写宽度错=数据破坏·零分叉铁律对齐面）。
    如果 (字符串比较(名449, "整128")) { 返回 T_整128; }
    如果 (字符串比较(名449, "正128")) { 返回 T_正128; }
    如果 (是枚举名(驻留(名449))) { 返回 T_整32; }
    // 648 归档：白名单=窄类型全集（1/2/4/16 字节档+枚举），兜底 T_整64=宽
    //   类型合法终态（整64/正64/浮64/字符串/指针/引用/结构体句柄——8 字节
    //   读写正确），非查表 miss 面，不登记。
    返回 T_整64;
}

// 466（wt466）：128 位引用参数写回落——调用方 16 字节对象全宽双段写
//   （宿主 i128 引用=[地址] 双 8 字节 mov 同构·写宽度错=数据破坏零容忍面）。
//   源=128 句柄（登记 T_整128/T_正128 直用·值=地址语义）或 64 位值（按
//   有符号 物化128位操作数 提升符号扩展双半——宿主 `v = 整64窄值` 写全宽
//   同语义）；地址=加载 引用槽（调用方左值地址）→ 低半 [地址+0] 高半 [地址+8]。
不安全 函数 发射引用参数128写(整64 槽, 整64 值寄存器, 整64 有符号,
                   向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数) -> 空类型 {
    整64 源码466 = 查寄存器类型(值寄存器);
    整64 句柄466 = 值寄存器;
    如果 (源码466 != T_整128 && 源码466 != T_正128) {
        句柄466 = 物化128位操作数(值寄存器,
                                  源码466 == T_未知 ? T_整64 : 源码466, 有符号,
                                  指令, 寄存器计数, 槽计数);
    }
    整64 地址reg466 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 槽, 0, 0, 地址reg466, T_整64, 0));
    整64 低半466 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 句柄466, 0, 0, 低半466, T_整64, 0));
    IR追加(指令, 建IR指令(IR_指针存储, 地址reg466, 低半466, 0, 0, T_整64, 0));
    整64 高源466 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 句柄466, 0, 0, 高源466, T_整64, 8));
    整64 高址466 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 地址reg466, 0, 0, 高址466, T_整64, 8));
    整64 高半466 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 高源466, 0, 0, 高半466, T_整64, 0));
    IR追加(指令, 建IR指令(IR_指针存储, 高址466, 高半466, 0, 0, T_整64, 0));
}

不安全 函数 登记指针参数槽(整64 槽) -> 空类型 {
    结果<空类型, 整32> 设 = 指针参数槽们.设置(槽, 1);
    如果 (!设.正常) { 运行时错误(4); }
