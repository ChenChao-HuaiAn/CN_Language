// IR类嵌套推导（1470 自 IR类尾.cn 职责拆出·先拆再加纪律——原文件 882 行近
//   警戒线，且本函数族本轮承担实质修复非纯搬移，单一归属成文件）
// 职责：泛型克隆体（函数实例/类实例方法体/嵌套递归）内「嵌套泛型函数调用」
//   的单调用点类型推导+实例改写+克隆编排（415 机制·宿主 303/317-a 推断式
//   单态化同构）。
// 1470 根治：泛型上下文（泛型函数体/泛型类方法体）内泛型函数调用符号修饰丢
//   实例段→LNK2019。病根=实参根定位与实参类型推导的可靠面过窄：
//   ①实参=调用表达式（加一(加一(x))）时 P1-2 区间长度守卫放弃→调用点保持
//     裸名→IR 按基函数形参造符号（?加一@@Y_T54@Z）与定义侧
//     （?加一$整32@@Y）修饰不一致→链接 undefined；
//   ②泛型类实例克隆（实例化注册）的方法体内泛型调用无实例化扫描→同样裸名
//     落码（y2 形态）。
//   修复=实参根经解析期实参末位表精确定位（克隆体=源码常数平移拷贝，任意
//   实参形态）+实参类型推导面扩调用表达式返回类型链/方法形参/实例类字段/
//   克隆体局部声明+可靠面推导失败显式 IR 诊断（诚实拒绝优于静默坏符号）。
// 类面挂载时机（A2005 教训·1470 对拍实录）：类方法体嵌套扫描必须挂在
//   实例化函数注册 主循环**之后**（实例化类方法嵌套泛型调用）——若挂在
//   类克隆期（主循环前），当场克隆的实例会进 泛型实例们 而函数主循环 n 快照
//   含之→同名实例克隆两次→ml64 A2005 symbol redefinition（加一$整32 实录）。
//   主循环后挂载=新克隆无重复面，克隆/签名/返回类型登记行为与函数面逐字复用。

导入 映射集合;
导入 协议常量;   // 查调用实参末位（1470 下沉中立层的跨组件实参末位表·334 合规）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 单调用点推导+嵌套实例克隆（宿主 303 逐参数对齐同构）：
//   形参基=嵌套基函数模板态形参类型（P1-3 修正——原误用外层克隆体形参类型
//   当形参基+类型参数数守卫，最小(T,T)=1 类型参数×2 形参位被静默跳过=EXTERN
//   悬空）；实参类型=克隆体侧逐位推导（1470 单点委托 实参类型推导1470）；
//   实参类型=泛型参数名（模板态信号·延迟绑定实例链 421-c 合法暂停）静默返回
//   ——展开实例由 421-c 第二遍（延迟绑定展开+重跑本扫描）接管。
// 1470 新参：模块序=克隆体归属模块（返回类型键基查询域·1011 同源口径）；
//   累计平移=克隆体首-解析期源节点首（嵌套克隆逐层叠加）——解析期实参末位表
//   键换算基；克隆首=本克隆体区间下界（克隆体局部声明查询域）。
不安全 函数 推导克隆嵌套实例(向量<节点> 池, 整64 调用节点索引415, 整32 克隆索引,
                  向量<整32> 程序节点们, 向量<字符串> 模块路径们,
                  整64 模块序, 整64 累计平移, 整64 克隆首, 整64 深度) -> 空类型 {
    节点 调用n415 = 池.元素(整32(调用节点索引415));
    整64 调用起点415 = 整64(调用n415.子起点);
    如果 (调用起点415 <= 0) { 返回; }
    节点 被调n415 = 池.元素(整32(调用起点415));
    如果 (被调n415.类型 != 节点_标识符) { 返回; }
    字符串 被调文本415 = 字符串复制(驻留文本(整64(被调n415.文本)));
    字符串 嵌套基名b415 = 剥实例基名(被调文本415);
    如果 (字符串长度(嵌套基名b415) == 0 || !字符串比较(嵌套基名b415, 被调文本415)) { 返回; }
    整64 嵌套基名ID415 = 整64(驻留(被调文本415));
    整64 嵌套参数序ID415 = 查泛型基类参数序(嵌套基名ID415);
    如果 (嵌套参数序ID415 == 0 || 是用户类ID(嵌套基名ID415)) { 返回; }
    // 类型参数名拆段（P2 收口·单一函数）
    向量<整64> 嵌套参数名们415 = 向量<整64>();
    泛型参数序拆段(嵌套参数序ID415, 嵌套参数名们415);
    整64 实参数415 = 整64(调用n415.附加);
    如果 (实参数415 == 0) { 返回; }
    // 定位嵌套基函数（形参序列守卫与克隆同源）
    整64 嵌套模块序415 = 0;
    可选<整32> 嵌套基函数查415 = 定位泛型基序(池, 程序节点们, 被调文本415, 嵌套模块序415);
    如果 (!嵌套基函数查415.有值) { 返回; }
    整32 嵌套基函数415 = 0;
    如果 (嵌套基函数查415.有值) { 嵌套基函数415 = 嵌套基函数查415.值; }
    // 嵌套基函数模板态形参序列（形参基来源·函数节点与克隆体节点同构复用）
    向量<整64> 基形参名表415 = 向量<整64>();
    向量<字符串> 基形参类型表415 = 向量<字符串>();
    克隆体形参类型表(池, 嵌套基函数415, 基形参名表415, 基形参类型表415);
    // P1-3：形参位数==实参数（类型参数名数独立——最小(T,T)=1×2 可推）
    如果 (基形参类型表415.大小() != 实参数415) { 返回; }
    // 逐位推导（推导值平行表·初始空=未约束）
    向量<字符串> 推导们415 = 向量<字符串>();
    {
        整64 名i415 = 0;
        当 (名i415 < 嵌套参数名们415.大小()) {
            结果<空类型, 整32> 加空415 = 推导们415.追加("");
            如果 (!加空415.正常) { 运行时错误(4); }
            名i415++;
        }
    }
    整64 位415 = 0;
    当 (位415 < 实参数415) {
        字符串 形参类型415 = "";
        如果 (位415 < 基形参类型表415.大小()) { 形参类型415 = 基形参类型表415.元素(整32(位415)); }
        字符串 形参基415 = 字符串复制(形参类型415);
        字符串 形参尾415 = "";
        当 (字符串长度(形参基415) > 0) {
            整64 尾码415 = 整64(形参基415[整32(字符串长度(形参基415) - 1)]) & 255;
            如果 (尾码415 == 42 || 尾码415 == 38) {
                形参尾415 = 字符串复制(字符串子串(形参基415, 整32(字符串长度(形参基415) - 1), 1) + 形参尾415);
                形参基415 = 字符串子串(形参基415, 0, 整32(字符串长度(形参基415) - 1));
            } 否则 { 中断; }
        }
        // 1470：实参根经解析期实参末位表精确定位——克隆体=源码节点常数平移
        //   拷贝，解析期原调用节点索引=克隆体调用索引-累计平移（嵌套克隆逐层
        //   叠加）；任意实参形态（调用表达式/多节点运算）不漏位。原「区间长度
        //   守卫+单节点下标公式」的放弃面=本缺陷病灶（实参=调用表达式即放弃
        //   →裸名落码→符号修饰丢实例段 LNK2019·铁证 ?加一@@Y_T54@Z）。
        可选<整64> 根索引查415 = 查调用实参末位(调用节点索引415 - 累计平移, 位415);
        如果 (!根索引查415.有值) {
            // miss=克隆调用点非源码平移产物（内部不变量破坏）——显形不兜底
            //   （查调用实参末位 880 批5 结果化：无值=未登记）
            IR层诊断("[1470] 泛型嵌套推导实参根不可定位: " + 被调文本415);
            返回;
        }
        整64 根索引415 = 0;
        如果 (根索引查415.有值) { 根索引415 = 根索引查415.值 + 累计平移; }
        如果 (根索引415 < 0 || 根索引415 >= 整64(池.大小())) {
            IR层诊断("[1470] 泛型嵌套推导实参根越界: " + 被调文本415);
            返回;
        }
        // 1470：实参类型推导单点委托（标识符面=形参/方法形参/局部声明/字段；
        //   表达式面=调用返回类型链/浮点/字符串字面量）——结果错误=不可推导
        //   （调用方 IR 层诊断显形·#1239 结果化无哨兵）
        结果<字符串, 整32> 查型1470 = 实参类型推导1470(池, 根索引415, 克隆索引, 克隆首,
                                    调用节点索引415, 模块路径们, 模块序);
        如果 (!查型1470.正常) {
            IR层诊断("[1470] 泛型嵌套推导实参类型不可达: " + 被调文本415 +
                     " 实参位 " + 整数转字符串(位415));
            返回;
        }
        字符串 实参类型415 = 字符串复制(查型1470.值);
        // 模板态信号（实参类型=泛型参数名·延迟绑定实例克隆体形态）=静默返回
        //   ——真实展开由 421-c 第二遍（延迟绑定展开+重跑本扫描）接管（合法
        //   暂停非静默 miss：展开实例克隆体同函数会再次到达本推导）
        如果 (是泛型参数名(整64(驻留(实参类型415)))) { 返回; }
        // 位匹配（形参基=类型参数名→推导；固定位不参与推导）
        整64 位约束415 = 0;
        整64 名k415 = 0;
        当 (名k415 < 嵌套参数名们415.大小()) {
            字符串 参数名k415 = 字符串复制(驻留文本(嵌套参数名们415.元素(整32(名k415))));
            如果 (字符串比较(形参基415, 参数名k415)) {
                位约束415 = 1;
                整64 尾长415 = 字符串长度(形参尾415);
                如果 (字符串长度(实参类型415) < 尾长415) {
                    IR层诊断("[1470] 泛型嵌套推导实参类型短于形参尾: " + 被调文本415);
                    返回;
                }
                如果 (尾长415 > 0 &&
                     !字符串比较(字符串子串(实参类型415,
                        整32(字符串长度(实参类型415) - 尾长415), 整32(尾长415)), 形参尾415)) {
                    IR层诊断("[1470] 泛型嵌套推导实参形态与参数位不匹配: " + 被调文本415);
                    返回;   // 实参形态与参数位不匹配（T* 位收非指针）
                }
                字符串 推导值415 = 字符串子串(实参类型415, 0,
                    整32(字符串长度(实参类型415) - 尾长415));
                如果 (字符串长度(推导们415.元素(整32(名k415))) > 0) {
                    如果 (!字符串比较(推导们415.元素(整32(名k415)), 推导值415)) {
                        IR层诊断("[1470] 泛型嵌套推导多位置类型冲突: " + 被调文本415);
                        返回;   // 同一类型参数多位置推导冲突
                    }
                } 否则 {
                    结果<空类型, 整32> 设推415 = 推导们415.设置(整32(名k415), 推导值415);
                    如果 (!设推415.正常) { 运行时错误(4); }
                }
                中断;
            }
            名k415++;
        }
        // 函数指针固定位=整体推导失败（宿主 303 对齐·P1-5 嵌套面同款）
        如果 (位约束415 == 0 && 是函数指针类型文本(形参类型415)) {
            IR层诊断("[1470] 泛型嵌套推导函数指针位不可推: " + 被调文本415);
            返回;
        }
        位415++;
    }
    // 未约束类型参数=推导失败（全部参数须被约束且一致）
    {
        整64 名c415 = 0;
        当 (名c415 < 嵌套参数名们415.大小()) {
            如果 (字符串长度(推导们415.元素(整32(名c415))) == 0) {
                IR层诊断("[1470] 泛型嵌套推导类型参数未被约束: " + 被调文本415);
                返回;
            }
            名c415++;
        }
    }
    // 合成嵌套实例文本（多实参 '$' 连接·剥实例参数段 递归平衡分段同构）
    字符串 实例文本415 = 被调文本415;
    {
        整64 段j415 = 0;
        当 (段j415 < 推导们415.大小()) {
            实例文本415 = 字符串复制(实例文本415 + "$" +
                          字符串复制(推导们415.元素(整32(段j415))));
            段j415++;
        }
    }
    整64 嵌套实例ID415 = 整64(驻留(实例文本415));
    // 改写克隆体内调用点文本（实例已注册/新建均须——克隆体为池内独立节点
    //   改写安全；漏改=克隆体 call 裸名 EXTERN 悬空·p5 实录）
    被调n415.文本 = 整32(嵌套实例ID415);
    结果<空类型, 整32> 设被调n415 = 池.设置(整32(调用起点415), 被调n415);
    如果 (!设被调n415.正常) { 运行时错误(4); }
    如果 (是泛型实例(嵌套实例ID415)) { 返回; }
    结果<空类型, 整32> 加n415 = 泛型实例们.追加(嵌套实例ID415);
    如果 (!加n415.正常) { 运行时错误(4); }
    // 推导文本→ID（克隆替换实参）
    向量<整64> 推导ID们415 = 向量<整64>();
    {
        整64 段k415 = 0;
        当 (段k415 < 推导们415.大小()) {
            结果<空类型, 整32> 加推415 = 推导ID们415.追加(
                整64(驻留(推导们415.元素(整32(段k415)))));
            如果 (!加推415.正常) { 运行时错误(4); }
            段k415++;
        }
    }
    整64 嵌套克隆首415 = 池.大小();
    整32 嵌套克隆415 = 克隆泛型函数节点(池, 嵌套基函数415, 嵌套实例ID415,
                                嵌套参数名们415, 推导ID们415);
    // 签名/返回类型/128 位形参登记（主循环 1011 段同构——键基=基函数归属模块）
    字符串 嵌套基模块415 = 模块路径们.元素(整32(嵌套模块序415));
    登记函数签名K(池, 嵌套克隆415, 键基合成(嵌套基模块415, 嵌套实例ID415));
    {
        节点 嵌套声明415 = 池.元素(嵌套克隆415);
        如果 (整64(嵌套声明415.附加) > 0) {
            整64 签名键415 = 函数签名键(键基合成(嵌套基模块415, 嵌套实例ID415),
                                      函数参数串(池, 嵌套克隆415));
            结果<空类型, 整32> 设返415 = 函数返回类型们.设置(
                签名键415, 整64(嵌套声明415.附加));
            如果 (!设返415.正常) { 运行时错误(4); }
            结果<空类型, 整32> 设返名415 = 函数返回类型们.设置(
                嵌套实例ID415, 整64(嵌套声明415.附加));
            如果 (!设返名415.正常) { 运行时错误(4); }
        }
    }
    // P1-4：128 位形参双键登记（主循环同源——嵌套面回归防线）
    登记克隆体128位形参(池, 嵌套克隆415,
                    函数签名键(键基合成(嵌套基模块415, 嵌套实例ID415),
                               函数参数串(池, 嵌套克隆415)),
                    嵌套实例ID415);
    结果<空类型, 整32> 加fn415 = 泛型实例函数节点们.追加(整64(嵌套克隆415));
    如果 (!加fn415.正常) { 运行时错误(4); }
    // 递归处理嵌套克隆体内的再嵌套调用（深度护栏防无限类型递归）——
    //   1470：累计平移=本层平移（嵌套克隆首-嵌套基函数子起点）+外层累计
    整64 嵌套平移1470 = 嵌套克隆首415 -
                     整64(池.元素(嵌套基函数415).子起点) + 累计平移;
    实例化嵌套泛型调用(池, 嵌套克隆首415, 嵌套克隆415, 程序节点们, 模块路径们,
                   嵌套模块序415, 嵌套平移1470, 深度 + 1);
}

// 扫克隆体区间调用点分派（递归入口·深度护栏 16）
// 1470 新参：模块序=克隆体归属模块序（返回类型键基查询域）；累计平移=克隆体
//   首-解析期源节点首（嵌套递归逐层叠加）；克隆首=局部声明查询域下界。
函数 实例化嵌套泛型调用(向量<节点> 池, 整64 克隆首, 整32 克隆索引,
                   向量<整32> 程序节点们, 向量<字符串> 模块路径们,
                   整64 模块序, 整64 累计平移, 整64 深度) -> 空类型 {
    如果 (深度 > 16) {
        IR层诊断("泛型嵌套实例化超深（>16）: " +
                 字符串复制(驻留文本(整64(池.元素(克隆索引).文本))));
        返回;
    }
    整64 位置s = 克隆首;
    当 (位置s < 整64(克隆索引)) {
        节点 调用s = 池.元素(整32(位置s));
        如果 (调用s.类型 == 节点_调用 && 整64(调用s.子起点) > 0) {
            节点 被调s = 池.元素(整32(调用s.子起点));
            如果 (被调s.类型 == 节点_标识符) {
                字符串 被调文本s = 字符串复制(驻留文本(整64(被调s.文本)));
                字符串 基名s = 剥实例基名(被调文本s);
                // 裸名（无 '$' 段）才=嵌套模板态调用（合成名=显式实例·既有通路）
                如果 (字符串比较(基名s, 被调文本s)) {
                    推导克隆嵌套实例(池, 位置s, 克隆索引, 程序节点们, 模块路径们,
                                模块序, 累计平移, 克隆首, 深度);
                }
            }
        }
        位置s++;
    }
}

// 1470：泛型类实例克隆体方法体嵌套泛型调用实例化（y2 病灶挂载点）——
//   遍历全部泛型实例类节点，对类克隆体区间跑与函数面同款的嵌套扫描。
//   **调用时机=实例化函数注册 主循环之后**（A2005 教训见文件头——主循环前
//   挂载会致同名实例双克隆）。逐类克隆体：基类定位（剥实例基名 程序区间扫
//   节点_类）得基类子起点与归属模块序→累计平移=类克隆体首-基类子起点（克隆
//   体=源码常数平移拷贝·解析期实参末位表键换算基）→扫描区间=[类克隆体首,
//   类节点索引)（克隆内容+实例类节点自身·后者非调用节点零命中）。
不安全 函数 实例化类方法嵌套泛型调用(向量<节点> 池, 向量<整32> 程序节点们,
                          向量<字符串> 模块路径们) -> 空类型 {
    整64 cb1470 = 0;
    当 (cb1470 < 泛型实例类节点们.大小()) {
        整32 类克隆索引 = 整32(泛型实例类节点们.元素(整32(cb1470)));
        节点 类克隆节点 = 池.元素(类克隆索引);
        字符串 实例文本c = 字符串复制(驻留文本(整64(类克隆节点.文本)));
        字符串 基名c = 剥实例基名(实例文本c);
        // 定位基类类节点（程序区间扫描·与 实例化注册 同款）
        整32 基类索引c = 0 - 1;
        整64 模块序c = 0;
        整64 f = 0;
        当 (f < 程序节点们.大小() && 基类索引c == 0 - 1) {
            节点 程序声明c = 池.元素(程序节点们.元素(整32(f)));
            整64 位置c = 整64(程序声明c.子起点);
            整64 终点c = 整64(程序声明c.子终点);
            当 (位置c < 终点c) {
                节点 声明c = 池.元素(整32(位置c));
                如果 (声明c.类型 == 节点_类 && 字符串比较(驻留文本(整64(声明c.文本)), 基名c)) {
                    基类索引c = 整32(位置c);
                    模块序c = f;
                    中断;
                }
                位置c++;
            }
            f++;
        }
        如果 (基类索引c != 0 - 1) {
            整64 克隆首c = 整64(类克隆节点.子起点);
            实例化嵌套泛型调用(池, 克隆首c, 类克隆索引, 程序节点们, 模块路径们,
                           模块序c, 克隆首c - 整64(池.元素(基类索引c).子起点), 0);
        }
        cb1470++;
    }
}

// ==================== 1470：克隆体侧实参类型推导族 ====================
// 全族 结果<字符串, 整32> 化（#1239 API 哨兵禁令正解）：错误=不可推导（调用
//   方 IR 层诊断显形），无空串/负数哨兵字面（1238 机械门禁单边比较/静默形态
//   双面清偿）；既有查询函数哨兵（查函数返回类型=-1/查字段类型ID=0）在消费
//   点显式枚举判定（== 判等非单边开区间）。

// 单实参位类型推导（可靠面单点·1470）——错误=不可推导（调用方诊断显形）。
// 标识符面查询链：外层克隆体形参（函数克隆面）→ 所属方法形参+实例类字段
//   （类克隆面·y2 病灶）→ 克隆体局部声明（声明序先于调用点·后序平铺）。
// 表达式面：调用表达式返回类型三级链（G05 嵌套调用病灶）/浮点/字符串字面量。
函数 实参类型推导1470(向量<节点> 池, 整64 根索引, 整32 克隆索引, 整64 克隆首,
                  整64 调用节点索引, 向量<字符串> 模块路径们, 整64 模块序) -> 结果<字符串, 整32> {
    节点 实参根 = 池.元素(整32(根索引));
    // 字面量面（解析期定类·零查询）
    如果 (实参根.类型 == 节点_整数字面量) { 返回 正常("整32"); }
    如果 (实参根.类型 == 节点_浮点字面量) { 返回 正常("浮64"); }
    如果 (实参根.类型 == 节点_字符串字面量) { 返回 正常("字符串"); }
    // 标识符面（形参/方法形参/局部声明/字段）
    如果 (实参根.类型 == 节点_标识符) {
        整64 名ID = 整64(实参根.文本);
        节点 克隆节点 = 池.元素(克隆索引);
        如果 (克隆节点.类型 == 节点_函数) {
            // 函数克隆面：外层克隆体形参表（类型节点已替换为外层实例实参）
            向量<整64> 形参名表 = 向量<整64>();
            向量<字符串> 形参类型表 = 向量<字符串>();
            克隆体形参类型表(池, 克隆索引, 形参名表, 形参类型表);
            整64 表i = 0;
            当 (表i < 形参名表.大小()) {
                如果 (形参名表.元素(整32(表i)) == 名ID) {
                    返回 正常(字符串复制(形参类型表.元素(整32(表i))));
                }
                表i++;
            }
        }
        如果 (克隆节点.类型 == 节点_类) {
            // 类克隆面：调用点所属方法形参（1470 y2 病灶——泛型类方法体内
            //   泛型调用实参=方法形参）
            结果<字符串, 整32> 查方 = 方法形参类型1470(池, 克隆索引, 调用节点索引, 名ID);
            如果 (查方.正常) { 返回 正常(查方.值); }
            // 实例类字段（克隆后字段类型文本已=实例实参·435-b 登记面同源；
            //   查字段类型ID 哨兵=0 未登记·显式枚举判定）
            整64 字段型 = 查字段类型ID(整64(克隆节点.文本), 名ID);
            如果 (字段型 != 0) { 返回 正常(字符串复制(驻留文本(字段型))); }
        }
        // 克隆体局部声明（显式类型声明·类型节点已被克隆器替换）
        返回 局部声明类型1470(池, 克隆首, 调用节点索引, 名ID);
    }
    // 调用表达式面（实参=另一调用的返回值·G05 病灶 加一(加一(x))）
    如果 (实参根.类型 == 节点_调用) {
        返回 调用返回类型1470(池, 根索引, 模块路径们, 模块序);
    }
    返回 错误(1);
}

// 类克隆面：调用点所属方法的形参类型查询（1470）——扫克隆类区间 节点_方法，
//   命中判据=调用点索引∈[方法.子起点, 方法.子终点)（子终点=块单点索引·
//   后序平铺调用点恒在块子树内）。方法节点与函数节点同构（参数区+体块），
//   形参表复用 克隆体形参类型表。
函数 方法形参类型1470(向量<节点> 池, 整32 克隆索引, 整64 调用节点索引, 整64 名ID) -> 结果<字符串, 整32> {
    节点 类节点 = 池.元素(克隆索引);
    整64 位置 = 整64(类节点.子起点);
    当 (位置 < 整64(类节点.子终点)) {
        节点 成员 = 池.元素(整32(位置));
        如果 (成员.类型 == 节点_方法 && 整64(成员.子起点) <= 调用节点索引 &&
             调用节点索引 < 整64(成员.子终点)) {
            向量<整64> 名表 = 向量<整64>();
            向量<字符串> 型表 = 向量<字符串>();
            克隆体形参类型表(池, 整32(位置), 名表, 型表);
            整64 k = 0;
            当 (k < 名表.大小()) {
                如果 (名表.元素(整32(k)) == 名ID) {
                    返回 正常(字符串复制(型表.元素(整32(k))));
                }
                k++;
            }
            返回 错误(1);
        }
        位置++;
    }
    返回 错误(1);
}

// 克隆体局部变量声明类型查询（1470）——显式类型声明（类型节点已被克隆器
//   替换为实例实参）；星/引用层自类型节点附加还原（克隆体形参类型表同口径）。
// 推断声明（无显式类型标注）不在此域=诚实 miss（调用方诊断显形）。
函数 局部声明类型1470(向量<节点> 池, 整64 克隆首, 整64 调用节点索引, 整64 名ID) -> 结果<字符串, 整32> {
    整64 位置 = 克隆首;
    当 (位置 < 调用节点索引) {
        节点 n = 池.元素(整32(位置));
        如果 (n.类型 == 节点_变量声明 && 整64(n.文本) == 名ID && 整64(n.附加) > 0 &&
             整64(n.附加) < 整64(池.大小())) {
            节点 类型节点 = 池.元素(整32(n.附加));
            字符串 类型文本 = 字符串复制(驻留文本(整64(类型节点.文本)));
            整64 星 = 整64(类型节点.附加);
            当 (星 >= 1 && 星 <= 255) {
                类型文本 = 字符串复制(类型文本 + "*");
                星--;
            }
            如果 (星 == 256) { 类型文本 = 字符串复制(类型文本 + "&"); }
            返回 正常(类型文本);
        }
        位置++;
    }
    返回 错误(1);
}

// 调用表达式返回类型三级查询链（1470）——实参=另一调用的返回值时取其返回
//   类型文本：①实例合成名/纯名直查（克隆体 实例ID 键·收集函数返回类型 纯名
//   面）②键基（唯一签名·收集函数返回类型 键基登记面）③签名键（重载面）。
// 三级全 miss（内置构造器/成员调用被调等）=错误（调用方诊断显形）。
// 查函数返回类型 哨兵=-1（既有函数文档化哨兵）——消费点显式 == 判等枚举。
函数 调用返回类型1470(向量<节点> 池, 整64 调用索引, 向量<字符串> 模块路径们,
                  整64 模块序) -> 结果<字符串, 整32> {
    节点 调用n = 池.元素(整32(调用索引));
    如果 (整64(调用n.子起点) == 0) { 返回 错误(1); }   // 子起点=0 哨兵=无被调（协议）
    节点 被调n = 池.元素(整32(调用n.子起点));
    如果 (被调n.类型 != 节点_标识符) { 返回 错误(1); }   // 成员调用等形态=诚实边界
    整64 被调ID = 整64(被调n.文本);
    可选<整64> 返型查 = 查函数返回类型(被调ID);
    如果 (!返型查.有值) {
        返型查 = 查函数返回类型(键基合成(模块路径们.元素(整32(模块序)), 被调ID));
    }
    如果 (!返型查.有值) {
        整64 键基 = 键基合成(模块路径们.元素(整32(模块序)), 被调ID);
        返型查 = 查函数返回类型(函数签名键(键基, 函数参数串(池, 整32(调用索引))));
    }
    如果 (返型查.有值) { 返回 正常(字符串复制(驻留文本(返型查.值))); }
    返回 错误(1);
}
