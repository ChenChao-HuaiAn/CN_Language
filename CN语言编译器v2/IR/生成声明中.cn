// 生成声明中（357 重构F2 自 生成声明.cn 纯机械搬移·函数体逐字保留·零逻辑变化）

导入 容器::向量;
导入 映射集合;  // 852：静态声明守卫块签名（映射<整64,整64>& 槽表）
导入 语法;       // Token/AST 节点池
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 IR生成;     // 生成表达式/生成左值地址 + 权威表访问函数

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

不安全 函数 登记声明字符串RAII(节点 n, 节点 类型节点, 布尔 预扫已分配, 函数IR& 函数信息) -> 空类型 {
    // 73-a（2026-09-11 方案A 用户裁决）：拥有型字符串 RAII 名单**生成期登记**
    //   ——原实现由预扫登记，但预扫先于函数体生成（函数级一次性扫描），登记
    //   发生在 生成块 取基线之前，基线恒等于名单大小=块出口析构永远无新增项，
    //   v2 块级 RAII 从未生效（探针 89：20 万轮循环体拥有串残留 199999）。
    //   登记条件与预扫判定同源（预扫 已分配槽 ⇔ 拥有初值判定通过），污染名
    //   不登记（借用形态：下标/成员/非白名单调用——其释放由源持有）；无初值
    //   声明同样登记（槽零初始化，后续 生成赋值语句 拥有化赋值维护拥有链）。
    //   登记时机=值已入槽之后（释放指令届时读槽有效）；块出口基线机制自此
    //   与宿主同构（Rust 作用域 drop 按声明顺序逆序 drop）。
    如果 (预扫已分配 && 整64(类型节点.文本) == 驻留("字符串")) {
        结果<整64, 整32> 查污登 = 函数信息.字符串污染们.获取(整64(n.文本));
        如果 (!查污登.正常) {
            名单追加去重(函数信息.字符串变量们, 整64(n.文本));
        }
    }
}

// 正32 存储截断（46-f 第五十轮 wrapping 语义，单一事实源——生成变量声明/
//   生成赋值语句 两存储点共用）：目标类型文本=正32 时存储前 IR_位与
//   0xFFFFFFFF（mod 2^32，对齐宿主 u32 4 字节槽截断）；其余类型零开销直通。
//   截断寄存器登记 T_正32（后续消费符号性保持）。
不安全 函数 正32存储截断(字符串 目标类型文本, 整64 值寄存器, 向量<IR指令>& 指令,
                  整64* 寄存器计数) -> 整64 {
    如果 (!字符串比较(目标类型文本, "正32")) { 返回 值寄存器; }
    整64 掩码寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(4294967295)), 0, 0,
                          掩码寄存器, T_整64, 0));
    整64 截断寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_位与, 值寄存器, 掩码寄存器, 0, 截断寄存器, T_正32, 0));
    登记寄存器类型(截断寄存器, T_正32);
    返回 截断寄存器;
}

// 565 轮（T33 残余根治）：窄宽码自文本——目标类型 整8/整16/正8/正16/整32/正32
//   → 对应 IR 码；其余（整64/浮/串/布尔/聚合…）=0（非窄宽·直通）。
//   单一归属：窄宽值规范化/生成函数 形参入口/返回窄宽码登记 三消费点共用。
函数 窄宽码自文本(字符串 目标类型文本) -> 整64 {
    如果 (字符串比较(目标类型文本, "整8")) { 返回 T_整8; }
    如果 (字符串比较(目标类型文本, "整16")) { 返回 T_整16; }
    如果 (字符串比较(目标类型文本, "正8")) { 返回 T_正8; }
    如果 (字符串比较(目标类型文本, "正16")) { 返回 T_正16; }
    如果 (字符串比较(目标类型文本, "整32")) { 返回 T_整32; }
    如果 (字符串比较(目标类型文本, "正32")) { 返回 T_正32; }
    返回 0;
}

// 565 轮（T33 残余根治）：窄宽值规范化——窄宽目标（码=窄宽码自文本 产物）的
//   值汇（声明初始化/赋值·复合赋值脱糖/形参槽/返回位）在存储/返回前把值寄存器
//   规范到目标宽度。槽模型 8 字节、变量槽读=8 字节直读（无窄读）——不规范化=
//   越界值原样入槽（宿主 回绕 -5536 vs v2 60000 实证·/tmp/t33probe 矩阵）。
//   机制=复用显式强转同款 IR_类型转换 窄宽目标码（发射层窄读+符号/零扩展·
//   三后端既有设施·E2E 194 锚定）；整32=T_整32 转换（sxtw/movsxd 符号回绕·
//   宿主 h1/h5「任意字面量放行+运行回绕」实测定案·不设值域）；正32=落既有
//   正32存储截断 位与（零变化）；码 0/值寄存器 0 直通；已规范寄存器（窄码
//   标注·显式强转产物）直通零开销。
不安全 函数 窄宽值规范化(整64 目标码, 整64 值寄存器, 向量<IR指令>& 指令,
                  整64* 寄存器计数) -> 整64 {
    如果 (值寄存器 == 0 || 目标码 == 0) { 返回 值寄存器; }
    如果 (目标码 == T_正32) {
        返回 正32存储截断("正32", 值寄存器, 指令, 寄存器计数);
    }
    如果 (查寄存器类型(值寄存器) == 目标码) { 返回 值寄存器; }
    整64 规范寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_类型转换, 值寄存器, T_整64, 0, 规范寄存器, 目标码, 0));
    登记寄存器类型(规范寄存器, 目标码);
    返回 规范寄存器;
}

// 92-a（2026-09-13 第九十二轮）：浮点隐式宽化存储适配——目标声明类型为 浮64
//   而值寄存器为 浮32 时插入 IR_类型转换（cvtss2sd；IEEE754 单->双无损，
//   规范「仅允许无损或宽化」）。原缺：f32 位模式直进 8 字节槽，按 f64 读得
//   极小非规格化数（≈0）——`浮64 宽 = 浮32(1.5);` 读回 0 实证（宿主侧正确=
//   双侧分叉）。非浮64 目标/同码零开销直通（生成声明初始化 + 生成赋值语句
//   两存储点共用，与 正32存储截断 同款单一事实源）。
不安全 函数 浮点宽化存储(字符串 目标类型文本, 整64 值寄存器, 向量<IR指令>& 指令,
                  整64* 寄存器计数) -> 整64 {
    // 070 波I（1026）：四组合扩展——浮64 目标浮32 源（既有宽化）+ **整源→浮**
    //   （04_types 实录 浮64 fi = a32 输出 0——整源位型直存浮槽=垃圾→cvtsi2sd
    //   隐式转换·三调用点 声明/赋值/复合赋值 同受益）
    整64 目标码w = 0;
    如果 (字符串比较(目标类型文本, "浮64")) { 目标码w = T_浮64; }
    否则 如果 (字符串比较(目标类型文本, "浮32")) { 目标码w = T_浮32; }
    如果 (目标码w == 0) { 返回 值寄存器; }
    整64 源码w = 查寄存器类型(值寄存器);
    如果 (源码w == 目标码w) { 返回 值寄存器; }
    如果 (源码w == T_浮32 || 源码w == T_浮64) {
        返回 插入值转换(值寄存器, 目标码w, 指令, 寄存器计数);
    }
    // 整源（含未知=整数类兜底）→ 浮：cvtsi2sd/ss
    返回 插入值转换(值寄存器, 目标码w, 指令, 寄存器计数);
}

// #1023（H2 双重解引用错位根治）：指针槽模型对象的引用绑定地址单点。
//   引用槽内容全链路契约（847 模型：读取两层〔变量地址→对象指针〕/写回
//   Load+指针存储/再传引用实参 Load 槽）恒为「绑定对象左值地址」；而
//   生成左值地址 对用户类/容器标识符（指针槽模型）返回 Load 槽值=
//   **对象指针**（成员链基座语义）——引用绑定点两语义错位：绑定对象指针后
//   读取按契约两读=把对象首字段/vtable 指针当变量地址再解一层（H2 实录：
//   字段读/虚调/直调 C0000005·字段写错误码3·{1020 采样轮 b02/b03/m03}）。
//   本函数=绑定地址契约单点：命中（局部/参数槽命中·非引用槽·类型=用户类/
//   容器）发射 IR_取地址 槽（=&变量槽·镜像调用侧 回扫实参取地址 普通变量
//   分支与宿主 genIdentifierLvalue AddrOf）；静态类/容器（972 句柄槽）→
//   IR_静态地址（=静态槽地址·镜像 回扫实参取地址 静态分支「句柄槽地址」）。
//   miss（引用槽/结构体/标量/成员链/结果合成体）=显式哨兵 0，调用方落
//   生成左值地址 原路径（四形态既有语义零变化·非静默默认）。
不安全 函数 引用绑定地址1023(向量<节点> 池, 节点 n,
        映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
        向量<IR指令>& 指令, 整64* 寄存器计数) -> 整64 {
    如果 (整32(n.子终点) != 整32(n.子起点) + 1) { 返回 0; }
    节点 绑源 = 池.元素(整32(n.子起点));
    如果 (绑源.类型 != 节点_标识符) { 返回 0; }
    整64 源名ID = 整64(绑源.文本);
    整64 源槽 = 0;
    结果<整64, 整32> 找局 = 局部槽.获取(源名ID);
    // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
    如果 (找局.正常) { 源槽 = 找局.值; } 否则 { }
    如果 (源槽 == 0) {
        结果<整64, 整32> 找参 = 参数槽.获取(源名ID);
        // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
        如果 (找参.正常) { 源槽 = 找参.值; } 否则 { }
    }
    如果 (源槽 != 0) {
        // 引用槽（引用形参/已有引用局部）：生成左值地址 已按 Load 槽=
        //   被引用左值地址 产出（928 单段链语义）——不触
        如果 (槽是引用(源槽)) { 返回 0; }
        整64 源类型局部 = 解析标识符类型ID(源名ID);
        如果 (源类型局部 == 0) { 返回 0; }
        // 静默豁免业务值: 非用户类/容器=非指针槽模型对象（显式哨兵 0·消费点强制检查落原路径·非静默默认值）
        如果 (!是用户类_ID(源类型局部) && !是容器类_ID(源类型局部)) { 返回 0; }
        整64 地址reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_取地址, 源槽, 0, 0, 地址reg, T_整64, 0));
        返回 地址reg;
    }
    整64 找静 = 查静态序号含类(源名ID);
    // 静默豁免闭集穷举: 静态序号闭集下标—1=无此静态哨兵（显式分流·消费点检查 0 落原路径）
    如果 (找静 < 0) { 返回 0; }
    整64 源类型静态 = 取静态类型(找静);
    如果 (源类型静态 == 0) { 返回 0; }
    // 静默豁免业务值: 非用户类/容器静态=非指针槽模型对象（显式哨兵 0·消费点强制检查落原路径）
    如果 (!是用户类_ID(源类型静态) && !是容器类_ID(源类型静态)) { 返回 0; }
    整64 静址reg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静址reg, T_整64, 找静));
    返回 静址reg;
}

// 引用局部（泛型引用绑定）：单槽存绑定对象左值地址——与引用参数槽完全同构
//   （读取分流/成员基址/赋值写回/再传引用实参数据流复用 全套机制）。
不安全 函数 生成引用局部(向量<节点> 池, 节点 n,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) {
    // 引用局部（泛型引用绑定，2026-09-04 IR生成.cn 冒烟 96 错根治）：
    //   单槽存绑定对象左值地址——与引用参数槽完全同构（读取分流/成员
    //   基址/赋值写回/再传引用实参数据流复用 引用参数槽们/类型们 全套
    //   机制）。绑定=初始化区间按 生成左值地址（成员/标识符——不走
    //   生成表达式，避免成员取值）。不入 RAII 名单：引用不拥有对象
    //   （绑定字段归宿主结构体所有，出口析构=双重释放必错）。
    //   语义层已拒无初始化/非左值形态（防御双保险，此处再守一道）。
    向量<IR指令>& 指令 = 函数信息.指令;
    节点 类型节点 = 池.元素(整32(n.附加));
    字符串 类型文本 = 字符串复制(驻留文本(整64(池.元素(整32(n.附加)).文本)));
    如果 (n.子起点 >= n.子终点) {
        IR层诊断("引用声明必须初始化: " + 类型文本);
    }
    整64 槽y = 槽计数[0];
    槽计数[0] = 槽计数[0] + 1;
    结果<空类型, 整32> 设槽y = 局部槽.设置(整64(n.文本), 槽y);
    如果 (!设槽y.正常) { 运行时错误(4); }
    // 容器/结果类型入双表（方法调用对象类型解析——与容器参数同款）
    如果 (是容器类(类型文本) || 是结果类型(类型文本)) {
        结果<空类型, 整32> 设类y = 函数信息.变量类型.设置(整64(n.文本),
                                                整64(类型节点.文本));
        如果 (!设类y.正常) { 运行时错误(4); }
    }
    登记当前函数变量类型(整64(n.文本), 整64(类型节点.文本));
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽y));
    登记引用参数槽(槽y);
    登记引用参数类型(槽y, 整64(类型节点.文本));
    如果 (n.子起点 < n.子终点) {
        节点 绑末y633 = 池.元素(整32(n.子终点 - 1));
        // 右值=引用返回调用（633 语义·左值地址回扫）——显式枚举两区间
        //   （1023 轮消 else：else 块内禁业务代码纪律）
        布尔 是调633 = 绑末y633.类型 == 节点_调用 &&
                       整32(绑末y633.子起点) > 0;
        如果 (是调633) {
            // 633（#633 残面③·v2 侧；928 口径更新）：右值=引用返回调用——
            //   回扫判定：普通函数读值必发 IR_指针加载（目标=求值产物）→
            //   命中=取操作数1（rax=被引用左值地址·928 生产端对齐后函数/方法
            //   统一）；miss=方法调用读值直传（rax·无 IR_指针加载）或值返回
            //   调用——miss 面直存「值」（方法引用返回时值即 rax=被引用左值
            //   地址；值返回=原路径零行为变更）。绑定槽约定「存绑定对象左值
            //   地址」直存，原 hold 槽物化分档随生产端对齐撤销（见下方 928）。
            整64 前深y633 = 表达式栈.大小();
            整64 值y633 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                    指令, 寄存器计数, &函数信息.块计数,
                                    槽计数, 表达式栈);
            整64 源指y633 = 0;
            如果 (值y633 != 0) {
                整64 回y633 = 指令.大小();
                当 (回y633 > 0) {
                    IR指令 回扫y633 = 指令.元素(回y633 - 1);
                    如果 (回扫y633.操作码 == IR_指针加载 &&
                        回扫y633.目标 == 值y633) {
                        源指y633 = 回扫y633.操作数1;
                        中断;
                    }
                    回y633--;
                }
            }
            表达式栈弹到深度(表达式栈, 前深y633);
            如果 (源指y633 != 0) {
                // 928（#928·633 分流消除·宿主 ABI 对齐）：引用返回调用 rax=
                //   被引用左值地址（字段槽地址/引用参数槽地址·函数与方法同
                //   口径）——绑定槽约定「存绑定对象左值地址」直存；原分档
                //   （①方法直存 ②标量/结构体直存 ③类对象引用返回〔普通函数
                //   P〕→hold 槽物化）以「普通函数 rax=对象指针本体」为前提，
                //   928 生产端对齐后前提消失——撤销 hold 与分档谓词消费。
                IR追加(指令, 建IR指令(IR_存储, 源指y633, 0, 0, 0, 0, 槽y));
            } 否则 如果 (值y633 != 0) {
                IR追加(指令, 建IR指令(IR_存储, 值y633, 0, 0, 0, 0, 槽y));
            }
        }
        如果 (!是调633) {
            整64 绑定地址 = 引用绑定地址1023(池, n, 局部槽, 参数槽,
                                            指令, 寄存器计数);
            如果 (绑定地址 == 0) {
                绑定地址 = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                     指令, 寄存器计数, &函数信息.块计数,
                                     槽计数, 表达式栈);
            }
            如果 (绑定地址 != 0) {
                IR追加(指令, 建IR指令(IR_存储, 绑定地址, 0, 0, 0, 0, 槽y));
            }
        }
    }
}

// P7b 容器变量：槽已由预扫分配（入口零初始化）；此处 NewObject +
//   无参构造 + Store（H7 同款：无初始化器也默认构造）；
//   初值三形态（2026-09-04，IR生成.cn 冒烟 [ir2] 收口）：
//   ①构造调用（= 向量$T()）——NewObject+构造；
//   ②函数调用返回（= 取实例实参们(x)）——接收转移：不 NewObject，
//     被调方构造对象所有权移交本槽（RAII 出口析构恰一次）；
//   ③标识符拷贝（静态/局部源）——深拷贝构造（2026-09-06 宿主对齐，见 拷贝构造）。
不安全 函数 生成容器局部(向量<节点> 池, 节点 n, 节点 类型节点,
                       映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                       函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                       向量<整64>& 表达式栈) {
    向量<IR指令>& 指令 = 函数信息.指令;
    字符串 类型文本 = 字符串复制(驻留文本(整64(类型节点.文本)));
    布尔 是构造调用 = 假;
    布尔 是返回接收 = 假;
    布尔 是标识符拷贝 = 假;
    如果 (n.子起点 < n.子终点) {
        节点 首节点 = 池.元素(n.子起点);
        节点 末节点c = 池.元素(n.子终点 - 1);
        如果 (首节点.类型 == 节点_标识符 && 首节点.文本 == 类型节点.文本 &&
             末节点c.类型 == 节点_调用) {
            是构造调用 = 真;
        } 否则 如果 (末节点c.类型 == 节点_调用) {
            是返回接收 = 真;
        } 否则 如果 (末节点c.类型 == 节点_标识符) {
            是标识符拷贝 = 真;
        } 否则 {
            IR层诊断("容器初始化仅支持构造/调用返回/标识符拷贝: " +
                          类型文本);
        }
    }
    整64 槽c = 0;
    结果<整64, 整32> 找槽c = 局部槽.获取(整64(n.文本));
    // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
    如果 (找槽c.正常) { 槽c = 找槽c.值; } 否则 { }
    // 73-a（2026-09-11 方案A 用户裁决）：RAII 名单生成期登记——预扫不再登记
    //   （预扫先于函数体生成，登记会让块出口析构基线恒等=块级 RAII 失效）。
    //   091（914 轮根治·泄漏零容忍）：返回接收**同样登记**——原豁免（2026-09-06
    //   「rax 直用=视图/转移」裁定）经 914 侦查证伪：返回接收句柄实际落变量槽
    //   （顶层/嵌套块两形态 asm 铁证 op=41 写/op=40 读）且返回副本=**深拷独立**
    //   （552 搅动判据双侧值对）——豁免的唯一效果=拥有副本无人释放=泄漏。
    //   借出方法返回标量/元素副本不落本路径（返回类型≠容器）；元素(i) 返回
    //   T 完整副本（74-a/75-a 归一化）登记释放=正确。登记在槽/对象建立之前
    //   ——释放列表与生成顺序一致，块出口基线机制据此成立。
    名单追加去重(函数信息.容器变量们, 整64(n.文本));
    // 272（021 任务 272）：②c D 权威表的容器路径生成期登记（其余四路径皆有）——
    //   预扫首声明守卫登记致跨块同名异型容器类型停驻（639 错调泛型符号实证）；生成期序=遮蔽覆盖序，预扫终态登记不可替代（补丁 v1 反向污染实证）。
    登记当前函数变量类型(整64(n.文本), 整64(类型节点.文本));
    如果 (是返回接收) {
        // 091（914 轮·转移特判前置）：被调=**转移(源)** 内置（拥有交接·459-a
        //   宿主同款真 move：句柄零拷移交接收方+源侧失拥有）——**不堆物化**
        //   （堆物化=浅拷头共享内部指针+双侧析构=double free·203_v2 实证）；
        //   句柄直存（61 轮豁免模型 Store 形态）+接收方登记（无条件登记已在
        //   上文）+**源除名**（容器变量们 移除源名——源不再析构·拥有唯一化，
        //   替代 61 轮「豁免凑合」〔共享句柄+单侧析构=接收方悬垂〕）。
        布尔 是转移接收 = 假;
        整64 转移源名 = 0;
        如果 (n.子终点 > n.子起点) {
            节点 末节点z = 池.元素(整32(n.子终点 - 1));
            如果 (末节点z.类型 == 节点_调用 && 末节点z.子起点 > 0) {
                节点 被调z = 池.元素(整32(末节点z.子起点));
                如果 (被调z.类型 == 节点_标识符 && 被调z.文本 == 整32(驻留("转移"))) {
                    如果 (末节点z.子起点 + 1 < 整32(池.大小())) {
                        节点 源实参z = 池.元素(整32(末节点z.子起点 + 1));
                        如果 (源实参z.类型 == 节点_标识符) {
                            是转移接收 = 真;
                            转移源名 = 整64(源实参z.文本);
                        }
                    }
                }
            }
        }
        如果 (是转移接收) {
            整64 返回值reg = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                         指令, 寄存器计数, &函数信息.块计数,
                                         槽计数, 表达式栈);
            如果 (返回值reg == 0) {
                IR层诊断("容器转移接收: 初值求值失败(返回值reg=0): " +
                         驻留文本(整64(n.文本)));
            }
            如果 (返回值reg != 0 && 槽c != 0) {
                IR追加(指令, 建IR指令(IR_存储, 返回值reg, 0, 0, 0, 0, 槽c));
            }
            // 源除名：容器变量们 移除源名（拥有移交·源侧不再析构）
            整64 名i = 0;
            当 (名i < 函数信息.容器变量们.大小()) {
                如果 (函数信息.容器变量们.元素(整32(名i)) == 转移源名) {
                    结果<空类型, 整32> 删名 = 函数信息.容器变量们.删除(整32(名i));
                    如果 (!删名.正常) { 运行时错误(4); }
                    中断;
                }
                名i++;
            }
            当 (表达式栈.大小() > 0) {
                结果<空类型, 整32> 删栈z = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删栈z.正常) { 运行时错误(4); }
            }
            返回;
        }
        // 091（914 轮根治·泄漏零容忍）：返回接收**堆物化**——原「rax 直接入槽」
        //   存的是 **sret 栈物化地址**（大对象返回 ABI：调用方 rdi 预置帧内
        //   retbuf·被调 rep movsb 浅拷头+拥有直移〔被调方豁免析构·内部指针
        //   唯一拥有随头移交〕）——直接存槽的后果：①豁免登记=函数尾随帧销毁
        //   =内部指针丢失=泄漏（091 立案面）；②登记析构=free 栈地址（909/914
        //   双度实证 munmap/free invalid pointer）。堆物化=NewObject+CopyStruct
        //   24B 头（内部指针唯一性保持·被调拥有直移零拷语义不变）→ 堆句柄
        //   入槽（上文 091 登记的尾析构=合法释放）。
        整64 返回值reg = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                     指令, 寄存器计数, &函数信息.块计数,
                                     槽计数, 表达式栈);
        // 692-a：返回值reg==0=生成表达式失败（净栈校验失败/内部错误静默返回
        //   0）——fail-fast 诊断消灭静默（691-a：层 槽保持零初始化→层.获取
        //   this=0→READ [null+0x20] 段错误的静默源头）
        如果 (返回值reg == 0) {
            IR层诊断("容器返回接收: 初值求值失败(返回值reg=0): " +
                     驻留文本(整64(n.文本)));
        }
        如果 (返回值reg != 0) {
            // 633（#633 残面④b）：回扫判定引用返回调用——v2 引用返回 rax=
            //   被引用左值地址（借出·非新对象）；默认读值多解一层取容器
            //   首字段（数据指针/长度）当 sret 源=垃圾拷贝 or 句柄错位双释放
            //   （探针 p4b C0000374 实录）。命中=深拷副本（NewObject 容器 +
            //   容器拷贝构造——与 生成容器拷贝构造 同 ABI：T& 源=装着壳地址
            //   的槽；容器拷贝构造符号同单点公式）；miss=值返回调用（sret
            //   物化槽地址）原堆物化路径零行为变更。
            // 928（#928·「返回引用参数」方法作容器接收补位）：方法调用读值=
            //   rax 直传（无 IR_指针加载·回扫天然 miss）——miss 面按
            //   是方法引用返回928（成员方法+返回文本尾&+剥尾&==接收容器类型）
            //   识别：源指=读值寄存器（=rax=被引用左值地址·与普通函数回扫
            //   结果同层）。
            整64 源指c633 = 0;
            整64 回c633 = 指令.大小();
            当 (回c633 > 0) {
                IR指令 回扫c633 = 指令.元素(回c633 - 1);
                如果 (回扫c633.操作码 == IR_指针加载 &&
                    回扫c633.目标 == 返回值reg) {
                    源指c633 = 回扫c633.操作数1;
                    中断;
                }
                回c633--;
            }
            如果 (源指c633 == 0 &&
                是方法引用返回928(池, 整64(n.子终点 - 1), 整64(类型节点.文本))) {
                源指c633 = 返回值reg;
            }
            如果 (源指c633 != 0) {
                // 928（#928·633 分流消除+方法补位）：引用返回 rax=被引用左值
                //   地址（容器变量槽地址·函数与方法同口径）——直接作拷贝构造
                //   源址（容器拷贝构造 T& 源约定「装着容器句柄的槽」）；原
                //   「普通函数 hold 槽物化」分档随 928 生产端对齐撤销。
                整64 源址c633 = 源指c633;
                整64 新对象633 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                整64 对象大小c = 容器对象大小(类型文本);
                IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新对象633,
                                     对象大小c, 整64(类型节点.文本)));
                IR追加(指令, 建IR指令(IR_调用实参, 新对象633, 0, 0, 0, 0, 0));
                IR追加(指令, 建IR指令(IR_调用实参, 源址c633, 0, 0, 0, 1, 0));
                IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                     驻留(方法符号(类型文本, 合成名基名(类型文本),
                                   类型文本 + "&"))));
                如果 (槽c != 0) {
                    IR追加(指令, 建IR指令(IR_存储, 新对象633, 0, 0, 0, 0, 槽c));
                }
            } 否则 {
            // 堆物化：新堆对象 ← CopyStruct（源=sret 栈物化·24B 头）→ 句柄入槽
            整64 新对象reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            整64 对象大小c = 容器对象大小(类型文本);
            IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新对象reg,
                                 对象大小c, 整64(类型节点.文本)));
            IR追加(指令, 建IR指令(IR_结构体拷贝, 返回值reg, 新对象reg, 0, 0,
                                 对象大小c, 0));
            如果 (槽c != 0) {
                IR追加(指令, 建IR指令(IR_存储, 新对象reg, 0, 0, 0, 0, 槽c));
            }
            }
        }
        当 (表达式栈.大小() > 0) {
            结果<空类型, 整32> 删栈c = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈c.正常) { 运行时错误(4); }
        }
        返回;
    }
    如果 (是标识符拷贝) {
        生成容器拷贝构造(池, n, 类型节点, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 槽c);
        返回;
    }
    整64 obj寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, obj寄存器,
                         容器对象大小(类型文本), 整64(类型节点.文本)));
    // 775（甲案·2026-10-15 用户裁决）：本点=容器对象创建（返回接收堆物化·
    //   源对象拷贝场景）——用户类实例字段默认值注入不在此（用户类对象创建
    //   经 生成声明.cn 分派 生成类对象局部/发射用户类构造 两真实注入点；
    //   容器对象无实例字段默认值登记面）。
    // 参数区模式（项3）：this 经 IR_调用实参(64) 声明装载，63 只存总位数
    IR追加(指令, 建IR指令(IR_调用实参, obj寄存器, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                         驻留(构造符号(类型文本))));
    如果 (槽c != 0) {
        IR追加(指令, 建IR指令(IR_存储, obj寄存器, 0, 0, 0, 0, 槽c));
    }
}

// 容器标识符拷贝（2026-09-06 根治·宿主对齐·深拷贝构造）：宿主实证（alias 探针
//   asm）`映射 B = A` 发射 NewObject+拷贝构造（符号 类$基名#类型，独立对象出口
//   析构）；原浅共享 IR_存储 与宿主分叉——源局部+接收双析构=double free、写穿
//   共享与宿主深拷贝语义矛盾。源指针装载：局部/参数槽 IR_加载、静态 IR_静态加载。
不安全 函数 生成容器拷贝构造(向量<节点> 池, 节点 n, 节点 类型节点,
                       映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                       函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                       向量<整64>& 表达式栈, 整64 槽c) {
    向量<IR指令>& 指令 = 函数信息.指令;
    字符串 类型文本 = 字符串复制(驻留文本(整64(类型节点.文本)));
    // 2026-09-06 根治（宿主对齐·深拷贝构造）：宿主实证（alias 探针
    //   asm）`映射 B = A` 发射 NewObject+拷贝构造（符号 类$基名#类型，
    //   独立对象出口析构）；原浅共享 IR_存储 与宿主分叉——源局部+
    //   接收双析构=double free、写穿共享与宿主深拷贝语义矛盾。
    //   源指针装载：局部/参数槽 IR_加载、静态 IR_静态加载。
    节点 源节点 = 池.元素(n.子终点 - 1);
    整64 源槽c = 0;
    结果<整64, 整32> 找源局 = 局部槽.获取(整64(源节点.文本));
    // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
    如果 (找源局.正常) { 源槽c = 找源局.值; } 否则 { }
    如果 (源槽c == 0) {
        结果<整64, 整32> 找源参 = 参数槽.获取(整64(源节点.文本));
        // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
        如果 (找源参.正常) { 源槽c = 找源参.值; } 否则 { }
    }
    整64 源指针reg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    布尔 源已解析 = 真;
    如果 (源槽c != 0) {
        // 拷贝构造源=T&（引用位传左值地址——宿主 ABI 实证：被调方
        //   (%rsi) 解引用取对象指针）；槽是引用（绑定对象）则槽内容
        //   即左值地址直接加载（回扫实参取地址 引用分支同款）
        如果 (槽是引用(源槽c)) {
            IR追加(指令, 建IR指令(IR_加载, 源槽c, 0, 0, 源指针reg, T_对象, 0));
        } 否则 {
            IR追加(指令, 建IR指令(IR_取地址, 源槽c, 0, 0, 源指针reg, T_整64, 0));
        }
    } 否则 {
        整64 找源静 = 查静态序号含类(整64(源节点.文本));
        如果 (找源静 >= 0) {
            // 静态容器源（取走惯用法：向量 模块列表 = 导入模块们）：
            //   拷贝构造 T& 传静态槽左值地址（lea .data 槽）
            IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 源指针reg,
                                 T_对象, 找源静));
        } 否则 {
            源已解析 = 假;
            IR层诊断("容器拷贝源未解析: " +
                          驻留文本(整64(源节点.文本)));
        }
    }
    如果 (源已解析) {
        整64 拷贝objreg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 拷贝objreg,
                             容器对象大小(类型文本),
                             整64(类型节点.文本)));
        // this=位0、源=位1（拷贝构造 T& 按引用位传对象指针）
        IR追加(指令, 建IR指令(IR_调用实参, 拷贝objreg, 0, 0, 0, 0, 0));
        IR追加(指令, 建IR指令(IR_调用实参, 源指针reg, 0, 0, 0, 1, 0));
        // 拷贝构造签名=构造(T&)——参数串带 &（asm 符号 _A+类型编码，
        //   alias.o 宿主实例 _...映射_A_T... 实证对齐）
        IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                             驻留(方法符号(类型文本,
                                    合成名基名(类型文本),
                                    类型文本 + "&"))));
        如果 (槽c != 0) {
            IR追加(指令, 建IR指令(IR_存储, 拷贝objreg, 0, 0, 0, 0, 槽c));
        }
    }
}

// P7b 结果/可选 变量：2 槽内联布局（12/16 字节）+ 变量类型登记；
//   初值 = 容器方法调用（retbuf 地址）-> IR_结构体拷贝 到本变量槽

// 852（2026-10-16·843 呈报）：函数内静态声明守卫块（语句流内联发射）——
//   形态=if (!guard) { 主槽=求值(初值); guard=1; }。初值在**声明所在函数**
//   上下文求值（局部槽/参数槽可达=同函数局部名不悬空），首调经过声明点
//   快照初始化（665 先例+001 §5.2a「经注入通道」·宿主 genStaticLocalGuardInit
//   同语义）。常量初值面（折叠成功）由收集静态 .data 直存·守卫标记=0·本函数
//   零发射（665/998 既有面零回归）。
不安全 函数 生成静态声明守卫852(向量<节点> 池, 节点 n,
                          映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                          函数IR& 函数信息, 整64* 寄存器计数,
                          整64* 槽计数, 向量<整64>& 表达式栈) -> 空类型 {
    整64 主槽序852 = 查静态序号含类(整64(n.文本));
    如果 (主槽序852 < 0) { 返回; }
    如果 (取静态守卫标记(主槽序852) == 0) { 返回; }
    整64 guard序852 = 查静态序号含类(驻留(字符串复制(驻留文本(整64(n.文本))) + "$已初始化"));
    如果 (guard序852 < 0) { 返回; }
    向量<IR指令>& 指令 = 函数信息.指令;
    // ① 读哨兵：guard = 主槽名$已初始化（.bss 零=未初始化）
    整64 guard寄 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_静态加载, 0, 0, 0, guard寄, T_布尔, guard序852));
    // ② 条件分派：guard 真（已初始化）→汇合；假→初始化块
    整64 初始化块852 = 新块(函数信息);
    整64 汇合块852 = 新块(函数信息);
    发射条件跳转(函数信息, guard寄, 汇合块852, 初始化块852);
    切换块(函数信息, 初始化块852);
    发射块标签(函数信息, 初始化块852);
    // ③ 求值初值——声明所在函数上下文（局部名走局部/参数槽通道=悬空根除）
    整64 初值起g = 取静态初值起点(主槽序852);
    整64 初值止g = 取静态初值终点(主槽序852);
    如果 (初值起g >= 0 && 初值止g > 初值起g) {
        生成表达式(池, 整32(初值起g), 整32(初值止g), 局部槽, 参数槽,
                  函数信息.指令, 寄存器计数, &函数信息.块计数, 槽计数,
                  表达式栈);
        如果 (表达式栈.大小() > 0) {
            整64 值寄852 = 表达式栈.元素(表达式栈.大小() - 1);
            结果<空类型, 整32> 删g = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删g.正常) { 运行时错误(4); }
            // ④ 主槽写入分派：数组=基址+整块拷（259 静态数组同款）；标量=直存
            字符串 主类型文本852 = 字符串复制(驻留文本(取静态类型(主槽序852)));
            布尔 是数组852 = 是数组类型文本(主类型文本852);
            如果 (是数组852) {
                整64 目的基址852 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 目的基址852,
                                              T_整64, 主槽序852));
                整64 字节数852 = 数组元素步进(主类型文本852) * 数组长度文本(主类型文本852);
                IR追加(指令, 建IR指令(IR_结构体拷贝, 值寄852, 目的基址852, 0, 0,
                                              字节数852, 0));
            } 否则 如果 (字符串比较(主类型文本852, "整128") ||
                        字符串比较(主类型文本852, "正128")) {
                // 919（超承载字面量参与表达式·函数内静态守卫链收口）/1073 复核
                //   （守卫852 标量主槽按声明类型宽物化）：128 槽收 128 值（超承载
                //   字面量表达式经 638 甲案提升链物化为地址句柄）→ 静态地址+结构体
                //   拷贝 16 字节（生成语句赋值 静态 128 分支同构——非 128 值源先
                //   拆半物化；与 生成静态注入.cn 同构·双半写）；原恒 IR_静态存储
                //   半槽写只落低 8 字节（丢高半实证：静态 整128 运算形态）。
                整64 值码852 = 查寄存器类型(值寄852);
                如果 (值码852 != T_整128 && 值码852 != T_正128) {
                    值寄852 = 物化128位操作数(值寄852, 值码852,
                        字符串比较(主类型文本852, "整128") ? 1 : 0,
                        指令, 寄存器计数, 槽计数);
                }
                整64 槽址852 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 槽址852,
                                              T_整64, 主槽序852));
                IR追加(指令, 建IR指令(IR_结构体拷贝, 值寄852, 槽址852, 0, 0, 16, 0));
            } 否则 如果 (!字符串比较(主类型文本852, "整128") &&
                         !字符串比较(主类型文本852, "正128")) {
                // 919：≤64 槽收 128 值 → 隐式窄化低半（与静态注入/声明初值/
                //   赋值/返回/实参挂点同设施；1073 复核同旨）
                值寄852 = 隐式窄化到64(值寄852, 指令, 寄存器计数);
                IR追加(指令, 建IR指令(IR_静态存储, 值寄852, 0, 0, 0, 0, 主槽序852));
            }
        }
    }
    // ⑤ guard = 真
    整64 一寄852 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("1"), 0, 0, 一寄852, T_布尔, 0));
    IR追加(指令, 建IR指令(IR_静态存储, 一寄852, 0, 0, 0, 0, guard序852));
    发射跳转(函数信息, 汇合块852);
    // ⑥ 汇合块
    切换块(函数信息, 汇合块852);
    发射块标签(函数信息, 汇合块852);
}
