        如果 (trap信息432.返回类型 != T_未知 && trap信息432.返回类型 != T_空类型) {
            登记寄存器类型(返回寄存器432b, trap信息432.返回类型);
            IR追加(trap信息432.指令, 建IR指令(IR_返回, 返回寄存器432b, 0, 0, 0, 0, 0));
        } 否则 {
            IR追加(trap信息432.指令, 建IR指令(IR_返回, 0, 0, 0, 0, 0, 0));
        }
    }
    返回 trap信息432;
}

