// CN 自举编译器 v2 · lambda 蹦床合成（432·#276 波3·新文件=宿主 ir_lambda.cpp 对称·单一职责）
// 职责：为每个 lambda 合成函数生成蹦床函数 IR（?lambdaN$trap）——签名=用户签名；
//   体=逐捕获 IR_静态加载（静态快照槽·生成声明 绑定段注册固化）+ 用户参数槽装载
//   + IR_间接调用 直调 ?lambdaN + IR_返回。
// 闭包值模型（宿主 ir_lambda.cpp 同构·001 §5.6 lambda+spec 04-一D）：
//   lambda 值=蹦床地址（变量槽装蹦床地址·合法函数指针值）——可安全作函数指针
//   返回/实参传递（高阶两面载体·逃逸调用走既有 T69 间接调用通道零新增调用面）；
//   捕获快照固化静态槽（值捕获=定义处值；[&]=变量地址）随蹦床全局存活=逃逸安全
//   （悬垂零容忍·安全目标②；[&] 逃逸=悬垂域挂 #435/#468 逃逸检查面）。
//   结构体/128 捕获保持旧轨（局部槽快照+展开直调·#428/#418 多槽面——生成声明
//   trap形432 旗分流），蹦床不生成。
// 协议依据：函数IR/IR指令（IR容器）·IR_调用实参 类型字段=参数位号·IR_间接调用
//   操作数1=参数总数/附加=被调指针寄存器（lambda闭包调用展开 同款发射序）。
导入 容器::向量;
导入 映射集合;
导入 IR;         // IR指令/函数IR/建IR指令/IR追加/操作码与类型码常量（目录包名）
导入 协议常量;   // 节点/节点_*/常量（目录包名·335 重构B 独立包）
导入 IR生成;     // 登记寄存器类型（同包）
导入 固化lambda字段快照;   // #1178：类字段捕获快照固化通道（同包兄弟·冻结线拆出）

公开:

// 432：lambda 可蹦床判定（捕获全∈标量/字符串/引用·结构体/128=旧轨否决）。
//   生成表达式 标识符收口（表达式位统一 trap 化）与 lambda闭包调用展开
//   （trap 形态早退走 T69）双消费点共用——通道归一单一判定源。
函数 lambda可蹦床432(整64 lambda名ID432) -> 布尔 {
    整64 快照形态 = 0;
    结果<整64, 整32> 查快照形态 = lambda捕获形态们.获取(lambda名ID432);
    // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
    如果 (查快照形态.正常) { 快照形态 = 查快照形态.值; } 否则 { }
    整64 捕获数432 = 0;
    结果<整64, 整32> 查数432 = lambda捕获计数们.获取(lambda名ID432);
    如果 (查数432.正常) { 捕获数432 = 查数432.值; } 否则 { }
    整64 捕获起432 = 0;
    结果<整64, 整32> 查起432 = lambda捕获起们.获取(lambda名ID432);
    // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
    如果 (查起432.正常) { 捕获起432 = 查起432.值; } 否则 { }
    整64 cap432 = 0;
    当 (cap432 < 捕获数432) {
        // 485：128 位/结构体值捕获否决解除——快照静态槽按类型全尺寸分配
        //（128=双 quad T46 已备·结构体=按类型尺寸 87-a 已备），固化=IR_结构体
        // 拷贝整块拷（固化lambda快照432 分派）·蹦床还原=槽地址传参（810 参数
        // 传址协议·生成lambda蹦床432 分派）——原否决（#428 多槽面/#418 双槽
        // 面）=旧轨局部快照（栈上）=逃逸后调用读已销亡帧（#485「快照槽同函数
        // 限制同不可逃逸」立案面）。标量/字符串/容器/类/引用捕获原有通道不动。
        cap432++;
    }
    返回 真;
}

// 432：lambda 快照静态槽注册+定义处固化（表达式求值位=定义点·宿主
//   emitLambdaSnapshotStores 同构）。[&]=槽地址（引用语义）；值捕获=槽值
//  （捕获时复制·spec 04-一D）。
不安全 函数 固化lambda快照432(整64 lambda名ID432, 映射<整64, 整64>& 局部槽,
                          映射<整64, 整64>& 参数槽, 向量<IR指令>& 指令,
                          整64* 寄存器计数) -> 空类型 {
    整64 快照形态 = 0;
    结果<整64, 整32> 查快照形态 = lambda捕获形态们.获取(lambda名ID432);
    // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
    如果 (查快照形态.正常) { 快照形态 = 查快照形态.值; } 否则 { }
    整64 捕获数432 = 0;
    结果<整64, 整32> 查数432 = lambda捕获计数们.获取(lambda名ID432);
    如果 (查数432.正常) { 捕获数432 = 查数432.值; } 否则 { }
    整64 捕获起432 = 0;
    结果<整64, 整32> 查起432 = lambda捕获起们.获取(lambda名ID432);
    // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
    如果 (查起432.正常) { 捕获起432 = 查起432.值; } 否则 { }
    整64 cap432 = 0;
    当 (cap432 < 捕获数432) {
        整64 快照捕名 = lambda捕获名序们.元素(整32(捕获起432 + cap432));
        // 457：语义回填噪声名哨兵（名序位=0）跳过——剔除位不固化不注册静态槽
        如果 (快照捕名 == 0) { cap432++; 继续; }
        结果<整64, 整32> 捕查432 = 查lambda捕获参数类型(lambda名ID432, 快照捕名);
        整64 快照捕型 = 驻留("整64");   // 未登记默认整64（消费点业务缺省·显式 kept）
        如果 (捕查432.正常) { 快照捕型 = 捕查432.值; } 否则 { }
        // 外层捕获变量槽（局部/参数·定义处当前值=快照源）
        整64 快照源槽 = 0;
        结果<整64, 整32> 查局432 = 局部槽.获取(快照捕名);
        // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
        如果 (查局432.正常) { 快照源槽 = 查局432.值; } 否则 { }
        如果 (快照源槽 == 0) {
            结果<整64, 整32> 查参432 = 参数槽.获取(快照捕名);
            // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
            如果 (查参432.正常) { 快照源槽 = 查参432.值; } 否则 { }
        }
        如果 (快照源槽 == 0) {
            // #1178（2026-10-31·001 §lambda 捕获条〔通告〕）：类字段捕获源通道
            //   （[=]/[&]/[字段名] 合法面·静态槽架构对齐宿主 emitLambdaSnapshotStores
            //   ·函数提炼=1093 冻结线拆出·实现见 固化lambda字段快照.cn）——真=已固化；
            //   假=非字段非槽名=原 miss 面（蹦床还原位号恒占·闭集穷举）。
            如果 (固化lambda字段快照(lambda名ID432, 快照捕名, 快照形态, 快照捕型, 指令, 寄存器计数)) { cap432++; 继续; }
            cap432++;
            继续;
        }
        // 静态快照槽注册（cap$?lambdaN$捕名·宿主 lambdaSlotKey 同名同构；
        //   平行表同步——初值区间 -1/-1=运行期固化·静态初始值们 不追加=
        //   代码生成 g 越界默认 "0" 无错位）
        字符串 静名432 = "cap$" + 驻留文本(lambda名ID432) + "$" + 驻留文本(快照捕名);
        整64 静名ID432 = 驻留(静名432);
        结果<整64, 整32> 查已有432 = 静态序号们.获取(静名ID432);
        如果 (!查已有432.正常) {
            整64 静序432 = 静态名们.大小();
            结果<空类型, 整32> 加静名432 = 静态名们.追加(静名ID432);
            如果 (!加静名432.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加静型432 = 静态类型们.追加(快照捕型);
            如果 (!加静型432.正常) { 运行时错误(4); }
            结果<空类型, 整32> 设静序432 = 静态序号们.设置(静名ID432, 静序432);
            如果 (!设静序432.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加起432 = 静态初值起点们.追加(0 - 1);
            如果 (!加起432.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加终432 = 静态初值终点们.追加(0 - 1);
            如果 (!加终432.正常) { 运行时错误(4); }
        }
        整64 快照静序实 = 0 - 1;
        结果<整64, 整32> 静序实查432 = 查静态序号(静名ID432);
        // 快照槽上文刚注册/已存在（注册单点）——miss=编译器内部不一致
        如果 (静序实查432.正常) { 快照静序实 = 静序实查432.值; } 否则 {
            运行时错误(4);
        }
        // 457（462-②）：捕码按附加位恢复——指针捕获（附加=指针层 1..255）
        //   快照=单槽 64 位指针值，捕码按基名（T_整32）装载=截断指针 SEGV
        //   （801c 实录）；形态3 引用捕获=地址（下方分支先行）。
        结果<整64, 整32> 捕附查432 = 查lambda捕获参数附加(lambda名ID432, 快照捕名);
        整64 快照捕附加 = 0;
        如果 (捕附查432.正常) { 快照捕附加 = 捕附查432.值; } 否则 { }
        整64 快照捕码 = 类型码(快照捕型);
        如果 (快照形态 != 3 && 快照捕附加 >= 1 && 快照捕附加 < 256) {
            快照捕码 = T_整64;
        }
        // 1321：被捕获变量自身是引用变量（引用形参/引用局部，槽是引用 命中·
        //   引用槽内容=绑定对象左值地址）——下方固化分派五路据此分流（地址类
        //   加载(源槽) 代 取地址(源槽)·值类再 指针加载 读值/句柄）。原无条件
        //   取地址/加载把别名槽当本体：快照固化别名槽地址=体内读别名槽内容
        //   当值（静默错值）·写毁外层别名槽（m13/s6 实录）。
        布尔 快照源是引用 = 槽是引用(快照源槽);
        // 定义处固化分派（485 三路·生成声明 快照写同款）：
        //   ① [&]=变量槽地址（引用语义·读最新/写穿载体）；
        //   ② 128 位/结构体值捕获=IR_取地址×2+IR_结构体拷贝 整块拷——快照静态
        //     槽按类型全尺寸分配（128 双 quad T46·结构体 87-a·静态类型们 已
        //     追加捕型），16B/多字节一次到位（原单槽 Load/Store 只拷首 8 字节
        //     =尾字节垃圾·#433 同族面根治）；
        //   ③ 标量=Load→静态存储（spec 04-一D 捕获时复制）。
        // 【#1880】②路准入改**显式白名单**（用户裁决「不允许默认通道，查不到
        //   的必须显式报错」）：只有「128 位标量」与「结构体」可进整块拷路——
        //   数组摘出借道（1408 曾借②路整块位拷=元素句柄浅共享面），改走下方
        //   **数组显式路**（整块拷+发射数组元素级深拷·元素级递归到底）；四路
        //   全不认识的类型落**终局否则=编译期诊断错误**（原末端 否则=默认按
        //   标量 Load 静默丢失·本块旗标显式甄别后通道闭集枚举）。
        布尔 快照捕是128旗 = (快照形态 != 3 && 快照捕附加 == 0 &&
                        (字符串比较(驻留文本(快照捕型), "整128") ||
                         字符串比较(驻留文本(快照捕型), "正128")));
        布尔 快照捕是数组旗 = (快照形态 != 3 && 快照捕附加 == 0 &&
                         是数组类型文本(驻留文本(快照捕型)));
        整64 快照大小432 = 0;
        如果 (快照捕是128旗) {
            快照大小432 = 16;   // 128 位标量=16 字节双槽（#418 布局同序）
        } 否则 如果 (快照形态 != 3 && 快照捕附加 == 0 &&
                     !快照捕是数组旗 && !是容器类(驻留文本(快照捕型)) &&
                     !是用户类_ID(快照捕型)) {
            // 结构体白名单路：查表有值才设大小（miss 类型不再落②路=终局否决）
            可选<整64> 快照大小432查 = 查结构体大小(快照捕型); 如果 (快照大小432查.有值) { 快照大小432 = 快照大小432查.值; }
        }
        如果 (快照捕是数组旗) {
            // 数组显式路尺寸：快照静态槽按数组全尺寸分配（静态类型们 追加捕型=
            //   数组文本·259 数据段按 元素×长度同通道·多维 类型大小与对齐
            //   单点折叠全维）——元素级深拷见下方数组显式分支。
            整64 数组总字节 = 0;
            整64 数组对齐宽 = 0;
            类型大小与对齐(驻留文本(快照捕型), &数组总字节, &数组对齐宽);
            快照大小432 = 数组总字节;
        }
        如果 (快照形态 == 3) {
            // 1321：引用源=加载(源槽)=被引用左值地址直存快照（读最新/写穿
            //   透别名）；普通变量=取地址 原路径零变化。
            整64 固化寄存器432 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            // 1321：引用源=加载(源槽)=被引用左值地址（别名透明）；普通=取地址（原路径）。
            //   内联形态（与生成蹦床.cn/生成声明.cn 固化段同构重复·第 2+ 处·标记待归纳
            //   ——提炼公共函数形态曾激活 79 固定点跨代分叉【#1368 后新案】·内联为本任务定版）。
            如果 (快照源是引用) {
                IR追加(指令, 建IR指令(IR_加载, 快照源槽, 0, 0, 固化寄存器432, T_整64, 0));
            } 否则 如果 (!快照源是引用) {
                IR追加(指令, 建IR指令(IR_取地址, 快照源槽, 0, 0, 固化寄存器432, T_整64, 0));
            }
            IR追加(指令, 建IR指令(IR_静态存储, 固化寄存器432, 0, 0, 0, 0, 快照静序实));
        } 否则 如果 (快照捕是数组旗) {
            // 【#1880】数组显式路：整块拷（全尺寸）+发射数组元素级深拷——元素
            //   甄别显式枚举（标量=位拷已正确/字符串=__cn_str_copy/容器类=拷贝
            //   构造/嵌套数组=递归到底），设施=发射数组元素级深拷（IR数组工具·
            //   940 结构体字段深拷先例的数组版）。1408 曾借②路整块位拷=元素句
            //   柄浅共享（源重赋值/块析构释放后快照读悬垂·写穿共享缓冲）——
            //   用户裁决「不允许默认通道」后本显式路为唯一数组通道。
            //   内联形态（与生成声明.cn 固化段同构重复·第 2+ 处·标记待归纳
            //   ——提炼公共函数形态曾激活 79 固定点跨代分叉【#1368 后新案】·
            //   内联为本任务定版）。
            整64 快照数组源址 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            如果 (快照源是引用) {
                IR追加(指令, 建IR指令(IR_加载, 快照源槽, 0, 0, 快照数组源址, T_整64, 0));
            } 否则 如果 (!快照源是引用) {
                IR追加(指令, 建IR指令(IR_取地址, 快照源槽, 0, 0, 快照数组源址, T_整64, 0));
            }
            整64 快照数组目标址 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 快照数组目标址, T_整64,
                                 快照静序实));
            IR追加(指令, 建IR指令(IR_结构体拷贝, 快照数组源址, 快照数组目标址, 0, 0,
                                 快照大小432, 0));
            发射数组元素级深拷(指令, 寄存器计数, 快照数组目标址, 快照数组源址,
                          驻留文本(快照捕型), 0);
        } 否则 如果 (快照大小432 > 0) {
            // 1321：深拷源地址走单点（引用源=加载=被引用对象基址·含 128 引用
            //   源=目标 16 字节对象首地址整块拷）
            整64 源址432 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            // 1321：引用源=加载(源槽)=被引用左值地址（别名透明）；普通=取地址（原路径）。
            //   内联形态（与生成蹦床.cn/生成声明.cn 固化段同构重复·第 2+ 处·标记待归纳
            //   ——提炼公共函数形态曾激活 79 固定点跨代分叉【#1368 后新案】·内联为本任务定版）。
            如果 (快照源是引用) {
                IR追加(指令, 建IR指令(IR_加载, 快照源槽, 0, 0, 源址432, T_整64, 0));
            } 否则 如果 (!快照源是引用) {
                IR追加(指令, 建IR指令(IR_取地址, 快照源槽, 0, 0, 源址432, T_整64, 0));
            }
