// CN 自举编译器 v2 · lambda 蹦床合成（432·#276 波3·新文件=宿主 ir_lambda.cpp 对称·单一职责）
// 职责：为每个 lambda 合成函数生成蹦床函数 IR（?lambdaN$trap）——签名=用户签名；
//   体=逐捕获 IR_静态加载（静态快照槽·生成声明 绑定段注册固化）+ 用户参数槽装载
//   + IR_间接调用 直调 ?lambdaN + IR_返回。
// 闭包值模型（宿主 ir_lambda.cpp 同构·001 §5.6 lambda+spec 04-一D）：
//   lambda 值=蹦床地址（变量槽装蹦床地址·合法函数指针值）——可安全作函数指针
//   返回/实参传递（高阶两面载体·逃逸调用走既有 T69 间接调用通道零新增调用面）；
//   捕获快照固化静态槽（值捕获=定义处值；[&]=变量地址）随蹦床全局存活=逃逸安全
//   （悬垂零容忍·安全目标②；[&] 逃逸=悬垂域挂 #435/#468 逃逸检查面）。
//   结构体/128 捕获保持旧轨（局部槽快照+展开直调·#428/#418 多槽面——生成声明
//   trap形432 旗分流），蹦床不生成。
// 协议依据：函数IR/IR指令（IR容器）·IR_调用实参 类型字段=参数位号·IR_间接调用
//   操作数1=参数总数/附加=被调指针寄存器（lambda闭包调用展开 同款发射序）。
导入 容器::向量;
导入 映射集合;
导入 IR;         // IR指令/函数IR/建IR指令/IR追加/操作码与类型码常量（目录包名）
导入 协议常量;   // 节点/节点_*/常量（目录包名·335 重构B 独立包）
导入 IR生成;     // 登记寄存器类型（同包）

公开:

// 432：lambda 可蹦床判定（捕获全∈标量/字符串/引用·结构体/128=旧轨否决）。
//   生成表达式 标识符收口（表达式位统一 trap 化）与 lambda闭包调用展开
//   （trap 形态早退走 T69）双消费点共用——通道归一单一判定源。
函数 lambda可蹦床432(整64 lambda名ID432) -> 布尔 {
    整64 形态432 = 0;
    结果<整64, 整32> 查形态432 = lambda捕获形态们.获取(lambda名ID432);
    如果 (查形态432.正常) { 形态432 = 查形态432.值; }
    整64 捕获数432 = 0;
    结果<整64, 整32> 查数432 = lambda捕获计数们.获取(lambda名ID432);
    如果 (查数432.正常) { 捕获数432 = 查数432.值; }
    整64 捕获起432 = 0;
    结果<整64, 整32> 查起432 = lambda捕获起们.获取(lambda名ID432);
    如果 (查起432.正常) { 捕获起432 = 查起432.值; }
    整64 cap432 = 0;
    当 (cap432 < 捕获数432) {
        // 485：128 位/结构体值捕获否决解除——快照静态槽按类型全尺寸分配
        //（128=双 quad T46 已备·结构体=按类型尺寸 87-a 已备），固化=IR_结构体
        // 拷贝整块拷（固化lambda快照432 分派）·蹦床还原=槽地址传参（810 参数
        // 传址协议·生成lambda蹦床432 分派）——原否决（#428 多槽面/#418 双槽
        // 面）=旧轨局部快照（栈上）=逃逸后调用读已销亡帧（#485「快照槽同函数
        // 限制同不可逃逸」立案面）。标量/字符串/容器/类/引用捕获原有通道不动。
        cap432++;
    }
    返回 真;
}

// 432：lambda 快照静态槽注册+定义处固化（表达式求值位=定义点·宿主
//   emitLambdaSnapshotStores 同构）。[&]=槽地址（引用语义）；值捕获=槽值
//  （捕获时复制·spec 04-一D）。
不安全 函数 固化lambda快照432(整64 lambda名ID432, 映射<整64, 整64>& 局部槽,
                          映射<整64, 整64>& 参数槽, 向量<IR指令>& 指令,
                          整64* 寄存器计数) -> 空类型 {
    整64 形态432 = 0;
    结果<整64, 整32> 查形态432 = lambda捕获形态们.获取(lambda名ID432);
    如果 (查形态432.正常) { 形态432 = 查形态432.值; }
    整64 捕获数432 = 0;
    结果<整64, 整32> 查数432 = lambda捕获计数们.获取(lambda名ID432);
    如果 (查数432.正常) { 捕获数432 = 查数432.值; }
    整64 捕获起432 = 0;
    结果<整64, 整32> 查起432 = lambda捕获起们.获取(lambda名ID432);
    如果 (查起432.正常) { 捕获起432 = 查起432.值; }
    整64 cap432 = 0;
    当 (cap432 < 捕获数432) {
        整64 捕名432 = lambda捕获名序们.元素(整32(捕获起432 + cap432));
        // 457：语义回填噪声名哨兵（名序位=0）跳过——剔除位不固化不注册静态槽
        如果 (捕名432 == 0) { cap432++; 继续; }
        整64 捕型432 = 查lambda捕获参数类型(lambda名ID432, 捕名432);
        如果 (捕型432 == 0) { 捕型432 = 驻留("整64"); }
        // 外层捕获变量槽（局部/参数·定义处当前值=快照源）
        整64 源槽432 = 0;
        结果<整64, 整32> 查局432 = 局部槽.获取(捕名432);
        如果 (查局432.正常) { 源槽432 = 查局432.值; }
        如果 (源槽432 == 0) {
            结果<整64, 整32> 查参432 = 参数槽.获取(捕名432);
            如果 (查参432.正常) { 源槽432 = 查参432.值; }
        }
        如果 (源槽432 == 0) {
            cap432++;
            继续;
        }
        // 静态快照槽注册（cap$?lambdaN$捕名·宿主 lambdaSlotKey 同名同构；
        //   平行表同步——初值区间 -1/-1=运行期固化·静态初始值们 不追加=
        //   代码生成 g 越界默认 "0" 无错位）
        字符串 静名432 = "cap$" + 驻留文本(lambda名ID432) + "$" + 驻留文本(捕名432);
        整64 静名ID432 = 驻留(静名432);
        结果<整64, 整32> 查已有432 = 静态序号们.获取(静名ID432);
        如果 (!查已有432.正常) {
            整64 静序432 = 静态名们.大小();
            结果<空类型, 整32> 加静名432 = 静态名们.追加(静名ID432);
            如果 (!加静名432.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加静型432 = 静态类型们.追加(捕型432);
            如果 (!加静型432.正常) { 运行时错误(4); }
            结果<空类型, 整32> 设静序432 = 静态序号们.设置(静名ID432, 静序432);
            如果 (!设静序432.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加起432 = 静态初值起点们.追加(0 - 1);
            如果 (!加起432.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加终432 = 静态初值终点们.追加(0 - 1);
            如果 (!加终432.正常) { 运行时错误(4); }
        }
        整64 静序实432 = 查静态序号(静名ID432);
        // 457（462-②）：捕码按附加位恢复——指针捕获（附加=指针层 1..255）
        //   快照=单槽 64 位指针值，捕码按基名（T_整32）装载=截断指针 SEGV
        //   （801c 实录）；形态3 引用捕获=地址（下方分支先行）。
        整64 捕附加432 = 查lambda捕获参数附加(lambda名ID432, 捕名432);
        整64 捕码432 = 类型码(捕型432);
        如果 (形态432 != 3 && 捕附加432 >= 1 && 捕附加432 < 256) {
            捕码432 = T_整64;
        }
        // 定义处固化分派（485 三路·生成声明 快照写同款）：
        //   ① [&]=变量槽地址（引用语义·读最新/写穿载体）；
        //   ② 128 位/结构体值捕获=IR_取地址×2+IR_结构体拷贝 整块拷——快照静态
        //     槽按类型全尺寸分配（128 双 quad T46·结构体 87-a·静态类型们 已
        //     追加捕型），16B/多字节一次到位（原单槽 Load/Store 只拷首 8 字节
        //     =尾字节垃圾·#433 同族面根治）；
        //   ③ 标量=Load→静态存储（spec 04-一D 捕获时复制）。
        整64 快照大小432 = 0;
        如果 (形态432 != 3 && 捕附加432 == 0 && !是容器类(驻留文本(捕型432)) &&
             !是用户类_ID(捕型432)) {
            快照大小432 = 查结构体大小(捕型432);
            如果 (快照大小432 <= 0 &&
                 (字符串比较(驻留文本(捕型432), "整128") ||
                  字符串比较(驻留文本(捕型432), "正128"))) {
                快照大小432 = 16;   // 128 位标量=16 字节双槽（#418 布局同序）
            }
        }
        如果 (形态432 == 3) {
            整64 固化寄存器432 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_取地址, 源槽432, 0, 0, 固化寄存器432,
                                 T_整64, 0));
            IR追加(指令, 建IR指令(IR_静态存储, 固化寄存器432, 0, 0, 0, 0, 静序实432));
        } 否则 如果 (快照大小432 > 0) {
            整64 源址432 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            整64 目标址432 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_取地址, 源槽432, 0, 0, 源址432, T_整64, 0));
            IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 目标址432, T_整64,
                                 静序实432));
            IR追加(指令, 建IR指令(IR_结构体拷贝, 源址432, 目标址432, 0, 0,
                                 快照大小432, 0));
            // 【#940】值捕获结构体快照=定义处**深拷**（宿主 emitLambdaSnapshotStores
            //   emitStructCopyWithFields(deepCopy=true) 同构·零分叉）：原仅位拷
            //   首层字节——字符串字段=句柄浅共享（源重赋值/块析构释放堆串后
            //   闭包读空串悬垂）、容器/类字段=指针浅共享（源释放后读大小 0/
            //   元素(0) 越界）——违反 001 §一D「值捕获快照语义无悬垂面」。
            //   深拷=字段级独立拥有副本（串 __cn_str_copy 落堆·容器/类字段
            //   拷贝构造·嵌套递归）；纯标量结构体字段表空=零开销（发射为空）。
            //   副本不释放（宿主 940 同裁决）：释放归属=闭包值生命周期（CN
            //   闭包值=裸函数指针无析构语义·语言级缺口）——挂账独立任务；
            //   悬垂（安全目标②）优先于残留（性能面）。
            发射串字段深拷(指令, 寄存器计数, 目标址432, 源址432, 捕型432, 0);
        } 否则 如果 (捕附加432 == 0 &&
                     (是容器类(驻留文本(捕型432)) || 是用户类_ID(捕型432))) {
            // 【#940】容器/用户类值捕获=定义处拷贝构造深拷独立副本（宿主
            //   evalValueCaptureCopy 同构·拷贝构造公式=方法符号(类,基名,类&)）
            //   ——原裸句柄浅共享，源重赋值/块析构释放后闭包读大小 0/元素(0)
            //   越界（F2 探针实录）。
            字符串 捕容器文432 = 字符串复制(驻留文本(捕型432));
            整64 对象字节432 = 查结构体大小(捕型432);
            如果 (是容器类(捕容器文432)) {
                对象字节432 = 容器对象大小(捕容器文432);
            }
            整64 新对象432x = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新对象432x,
                                 对象字节432, 捕型432));
            整64 源址432x = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_取地址, 源槽432, 0, 0, 源址432x, T_整64, 0));
            IR追加(指令, 建IR指令(IR_调用实参, 新对象432x, 0, 0, 0, 0, 0));
            IR追加(指令, 建IR指令(IR_调用实参, 源址432x, 0, 0, 0, 1, 0));
            IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                                 驻留(方法符号(捕容器文432, 合成名基名(捕容器文432),
                                               捕容器文432 + "&"))));
            IR追加(指令, 建IR指令(IR_静态存储, 新对象432x, 0, 0, 0, 0, 静序实432));
        } 否则 如果 (捕码432 == T_字符串) {
            // 【#940】字符串值捕获=__cn_str_copy 落堆独立副本 → 静态存储（原
            //   裸句柄浅共享——源重赋值释放旧堆串后闭包读悬垂·F1 探针实录）。
            整64 串载432 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 源槽432, 0, 0, 串载432, T_字符串, 0));
            整64 串副本432 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_调用实参, 串载432, 0, 0, 0, 0, 0));
            IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 串副本432, 0,
                                 驻留("__cn_str_copy")));
            登记寄存器类型(串副本432, T_字符串);
            IR追加(指令, 建IR指令(IR_静态存储, 串副本432, 0, 0, 0, 0, 静序实432));
        } 否则 {
            整64 固化寄存器432 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 源槽432, 0, 0, 固化寄存器432,
                                 捕码432, 0));
            IR追加(指令, 建IR指令(IR_静态存储, 固化寄存器432, 0, 0, 0, 0, 静序实432));
        }
        cap432++;
    }
}

// 432：lambda 蹦床函数 IR 生成（IR生成尾 lambda 合成循环逐个调用·追加进 程序.函数们）。
//   定义名ID432=?lambdaN 定义侧 函数IR.名字（签名键 名#参数串——捕获段类型带引用
//   后缀 [&]=整32&·类型编码 AH）——trap 被调 IR_函数地址 附加直接取之=与定义侧
//   PROC 符号同源逐位对称（自拼串漏 & 后缀=707/721 linux LNK2019 实录·win MASM
//   同病同修对称面）。空（0）=回退自拼串（防御）。
//   485 起：全捕获形态可生成（128/结构体否决解除·判定①口径见函数体内注）；
//   名字=0 哨兵路径保留（防御回退）。
不安全 函数 生成lambda蹦床432(向量<节点> 池, 节点 合成432, 整64 lambda名ID432,
                          整32 定义名ID432) -> 函数IR {
    函数IR trap信息432;
    初始化函数信息字段(trap信息432);
    trap信息432.块计数 = 0;
    trap信息432.当前块 = 0;
    整64 捕获数432b = 0;
    结果<整64, 整32> 查数432b = lambda捕获计数们.获取(lambda名ID432);
    如果 (查数432b.正常) { 捕获数432b = 查数432b.值; }
    整64 捕获起432b = 0;
    结果<整64, 整32> 查起432b = lambda捕获起们.获取(lambda名ID432);
    如果 (查起432b.正常) { 捕获起432b = 查起432b.值; }
    整64 形态432b = 0;
    结果<整64, 整32> 查形态432b = lambda捕获形态们.获取(lambda名ID432);
    如果 (查形态432b.正常) { 形态432b = 查形态432b.值; }
    // 可生成判定①（485）：全捕获形态可生成——128 位/结构体值捕获原否决
    //   （#428/#418 旧轨局部快照=逃逸后读已销亡帧·#485 立案面）解除：静态
    //   快照槽按类型全尺寸分配+固化整块拷+还原槽地址传参（固化lambda快照432
    //   与本函数还原段分派）。与 lambda可蹦床432（生成表达式 收口）保持同一
    //   判定口径（440 LNK2019 实录=两处判定不对称教训）。
    整64 可生成432 = 1;
    整64 cap432b = 0;
    当 (cap432b < 捕获数432b) {
        cap432b++;
    }
    // 用户参数段：槽分配+参数槽四表登记（生成函数 同协议·声明序）——
    //   标量=1 槽直存（拷贝字节 0）；128 位=双槽 16 字节（810·类型码 T_整128/
    //   T_正128）；结构体按值=多槽+拷贝字节=类型大小（②b B8 传址 prologue 拷贝）。
    //   **判定单一化**：可生成性只由捕获面决定（判定①）——参数段全形态可载，
    //   与 lambda可蹦床432（生成表达式 收口·无池只查捕获）天然对称（440
    //   LNK2019 实录=两处判定不对称：收口引用 trap 符号而生成侧否决缺席）。
    整64 pi432b = 整64(合成432.子起点) + 捕获数432b;
    如果 (可生成432 == 0) {
        trap信息432.名字 = 0;
        返回 trap信息432;
    }
    // 490（结构体/结果/数组返回 lambda 的 sret 协议·宿主 ir_lambda.cpp 485 面
    //   buildLambdaTrampoline structReturn 同构；551 增 128 位标量第三形态——
    //   生成函数 810 同构）：蹦床作 fnptr 逃逸后经 T69 retbuf 形态间接调用
    //   （位0=调用方 retbuf），蹦床须自建被调 sret 面——置 返回结构体ID/
    //   返回结果名ID/返回128位/返回数组字节（后端 生成函数参数装载 返回结构体
    //   分支据此把位0 存槽1+参数寄存器自 rdx 起），槽1 保留。
    //   判定用源码返回类型（返回类型 经 类型码 已塌缩 T_未知=0 不可判）。
    //   转发段（本函数尾部）消费：?lambdaN 亦 sret（生成函数 通道自动），
    //   转发=retbuf 形态（帧尾共享区）+返回透传（整块拷到槽1 指向+rax=槽1 值）。
    整64 蹦床返回名ID490 = 整64(合成432.附加);
    整64 蹦床返回字节490 = 0;
    如果 (蹦床返回名ID490 != 0) {
        字符串 蹦床返回名490 = 字符串复制(驻留文本(蹦床返回名ID490));
        如果 (查结构体大小(蹦床返回名ID490) > 0 && !是容器类(蹦床返回名490) &&
             !是用户类_ID(蹦床返回名ID490)) {
            蹦床返回字节490 = 查结构体大小(蹦床返回名ID490);
            trap信息432.返回结构体ID = 蹦床返回名ID490;
        } 否则 如果 (是结果类型(蹦床返回名490)) {
            蹦床返回字节490 = 结果大小(蹦床返回名490);
            trap信息432.返回结果名ID = 蹦床返回名ID490;
        } 否则 如果 (字符串比较(蹦床返回名490, "整128")) {
            // 551（442 呈报缺陷①）：128 位标量返回（16 字节）=retbuf ABI 第三
            //   形态（正报函数 生成函数 810 同构）——原判定链只有结构体/结果/
            //   数组三分支，整128/正128 不中任何分支→蹦床本体无 sret 槽（rcx
            //   装首实参），而调用点（后端 418 判据融合 操作数2=T_整128→
            //   retbuf 形态）按签名传 rdi=retbuf/rsi=实参→ABI 错位一档=值错/
            //   读亡帧。补：返回128位 置位（后端 生成函数参数装载 返回结构体
            //   判据含 返回128位!=0→prologue 自动 rcx 存槽1+实参自 rdx 起）+
            //   转发 retbuf 形态+返回透传（本函数尾部 490 通道共用）。
            蹦床返回字节490 = 16;
            trap信息432.返回128位 = 1;
        } 否则 如果 (字符串比较(蹦床返回名490, "正128")) {
            蹦床返回字节490 = 16;
            trap信息432.返回128位 = 2;
        } 否则 如果 (是数组类型文本(蹦床返回名490)) {
            蹦床返回字节490 = 类型名宽度(蹦床返回名ID490);
            trap信息432.返回数组字节 = 蹦床返回字节490;
        }
        如果 (蹦床返回字节490 > 0) {
            // 帧尾 retbuf 区（转发 ?lambdaN 的返回缓冲——retbuf槽位数 <16→16 兜底）
            trap信息432.retbuf字节数 = 蹦床返回字节490;
            // 551：sret rcx 存槽（变量槽 1）占位——正报函数同构（生成函数 各
            //   sret 形态均 IR_分配 附加=1 登记）——原缺：扫描函数 最大槽=0
            //   （蹦床无 IR_分配/无参数槽·rcx 存槽是后端 prologue 隐式写）→
            //   retbuf 区自槽 0 起，16 字节返回缓冲恰好覆盖变量槽 1=?lambdaN
            //   转发返回缓冲高半踩掉 rcx 存槽 → 透传读槽 1 得垃圾 rdi（839
            //   崩溃实录：rdi=大值高半/0 写空指针）。占位后 retbuf 区自槽 2 起。
            IR追加(trap信息432.指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 1));
        }
    }
    // 用户参数段：槽分配（标量单槽·声明序）+参数槽三表登记（生成函数 同协议——
    //   拷贝字节=0 标量直存；参数类型码=序言装载寄存器类分派依据）
    pi432b = 整64(合成432.子起点) + 捕获数432b;
    整64 槽序432b = 1;   // 槽号从 1 起（0=非法哨兵·992 守卫域）
    // 490：sret 形态槽 1=调用方 retbuf 指针保留（生成函数 同协议·参数自槽 2 起）
    如果 (蹦床返回字节490 > 0) { 槽序432b = 2; }
    // 432：签名键参数串（名#参数类型串·逗号分隔——trap 引用 ?lambdaN 的
    //   IR_函数地址 附加须经同款签名键，代码生成 符号修饰 才与定义侧 PROC
    //   符号一致（纯名直通≠带参修饰·LNK2019 实录）。**串含捕获参数**：
    //   定义侧 ?lambdaN 函数IR 参数=捕获+用户全段（visitLambdaExpr 同构），
    //   引用串须与定义侧逐位一致（?lambda1 双 H 实录=串漏捕获段））
    字符串 参数串432 = "";
    {
        整64 cap串432 = 0;
        当 (cap串432 < 捕获数432b) {
            整64 捕名串432 = lambda捕获名序们.元素(整32(捕获起432b + cap串432));
            // 457：哨兵位跳过（定义侧合成参数区间按 节点_参数 扫·哨兵不在=
            //   签名键参数串不含·两处口径必须一致防 LNK2019）
            如果 (捕名串432 == 0) { cap串432++; 继续; }
            整64 捕型串432 = 查lambda捕获参数类型(lambda名ID432, 捕名串432);
            如果 (捕型串432 == 0) { 捕型串432 = 驻留("整64"); }
            如果 (字符串长度(参数串432) > 0) { 参数串432 = 参数串432 + ","; }
            参数串432 = 参数串432 + 驻留文本(捕型串432);
            cap串432++;
        }
    }
    当 (pi432b < 整64(合成432.子终点)) {
        节点 参数节点432c = 池.元素(整32(pi432b));
        如果 (参数节点432c.类型 == 节点_参数) {
            整64 参型432c = 0;
            如果 (整64(参数节点432c.附加) > 0 &&
                 整64(参数节点432c.附加) < 整64(池.大小())) {
                参型432c = 整64(池.元素(整32(参数节点432c.附加)).文本);
            }
            如果 (参型432c == 0) { 参型432c = 驻留("整64"); }
            整64 参码432c = 类型码(参型432c);
            // 810：128 位形参——双槽（拷贝字节 16·类型码 T_整128/T_正128·
            //   基槽登记=最大槽号=低地址）·结构体按值=多槽（拷贝字节=类型大小）
            整64 参槽数432c = 1;
            整64 参拷贝432c = 0;
            如果 (参码432c == T_整128 || 参码432c == T_正128) {
                参槽数432c = 2;
                参拷贝432c = 16;
            } 否则 如果 (查结构体大小(参型432c) > 0 &&
                        !是容器类(驻留文本(参型432c)) &&
                        !是用户类_ID(参型432c)) {
                参拷贝432c = 查结构体大小(参型432c);
                参槽数432c = (参拷贝432c + 7) / 8;
                参码432c = T_整64;   // 传址形态=地址装载（91-a 同判）
            }
            如果 (字符串长度(参数串432) > 0) { 参数串432 = 参数串432 + ","; }
            参数串432 = 参数串432 + 驻留文本(参型432c);
            整64 基槽432c = 槽序432b + 参槽数432c - 1;
            结果<空类型, 整32> 设参槽432b = trap信息432.参数槽.设置(
                整64(参数节点432c.文本), 基槽432c);
            如果 (!设参槽432b.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加槽序432b = trap信息432.参数槽序们.追加(基槽432c);
            如果 (!加槽序432b.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加拷贝432b = trap信息432.参数拷贝字节们.追加(参拷贝432c);
            如果 (!加拷贝432b.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加类型432b = trap信息432.参数类型们.追加(参码432c);
            如果 (!加类型432b.正常) { 运行时错误(4); }
            槽序432b = 槽序432b + 参槽数432c;
        }
        pi432b++;
    }
    // 返回类型（合成.附加=返回类型名ID·语义层推导回填位）
    trap信息432.返回类型 = 类型码(整64(合成432.附加));
    // 蹦床名（IR_函数地址 调用侧符号与 名字 字段一致）
    trap信息432.名字 = 整32(驻留(驻留文本(lambda名ID432) + "$trap"));
    // 指令体：独立寄存器空间（trap 函数局部计数·寄存器号从 1 起——992 守卫域）
    整64 寄存器432b = 1;
    整64 被调432b = 寄存器432b;
    寄存器432b++;
    字符串 被调符号432b;
    如果 (定义名ID432 != 0) {
        // 定义侧签名键直取（同源对称——[&] 捕获段的 & 后缀逐位一致）
        被调符号432b = 字符串复制(驻留文本(定义名ID432));
    } 否则 {
        被调符号432b = 字符串复制(驻留文本(lambda名ID432));
        如果 (字符串长度(参数串432) > 0) {
            被调符号432b = 字符串复制(被调符号432b + "#" + 参数串432);
        }
    }
    IR追加(trap信息432.指令, 建IR指令(IR_函数地址, 0, 0, 0, 被调432b, T_整64,
                                     驻留(被调符号432b)));
    // 捕获实参还原：IR_静态加载（生成声明 绑定段注册固化的静态快照槽）
    //   457：哨兵位（语义回填噪声名剔除·名序位=0）跳过且**实参位号不占**
    //   （被调形参序=合成参数区间按 节点_参数 扫·哨兵不在=位压缩）。
    // 490：sret 形态实参位号整体 +1（位0=retbuf——转发 retbuf 形态配套·
    //   位偏叠加于 457 压缩位号之上，两机制正交）。
    整64 位偏490 = 0;
    如果 (蹦床返回字节490 > 0) { 位偏490 = 1; }
    cap432b = 0;
    整64 位457 = 0;   // 实参位号（哨兵跳过不占·与被调形参序严格一致）
    当 (cap432b < 捕获数432b) {
        整64 捕名432d = lambda捕获名序们.元素(整32(捕获起432b + cap432b));
        如果 (捕名432d == 0) { cap432b++; 继续; }   // 457：哨兵=剔除位
        整64 捕型432d = 0;
        整64 捕附加432d = 0;
        整64 参数索引432d = 整64(合成432.子起点) + cap432b;
        如果 (参数索引432d >= 0 && 参数索引432d < 整64(池.大小())) {
            节点 捕获参数432d = 池.元素(整32(参数索引432d));
            如果 (整64(捕获参数432d.附加) > 0 &&
                 整64(捕获参数432d.附加) < 整64(池.大小())) {
                节点 类型节点432d = 池.元素(整32(捕获参数432d.附加));
                捕型432d = 整64(类型节点432d.文本);
                捕附加432d = 整64(类型节点432d.附加);
            }
        }
        如果 (捕型432d == 0) { 捕型432d = 驻留("整64"); }
        整64 捕码432d = 类型码(捕型432d);
        如果 (形态432b == 3) { 捕码432d = T_整64; }   // [&] 快照=地址
        // 457（462-②）：指针捕获还原=整64 指针值（捕码按基名 T_整32 截断
        //   SEGV·801c 实录）
        否则 如果 (捕附加432d >= 1 && 捕附加432d < 256) { 捕码432d = T_整64; }
        // 485：128 位/结构体值捕获=静态快照槽地址传参（810 参数传址协议——
        //   ?lambdaN prologue 从指针整块拷贝 16B/多字节·与用户 128/结构体参数
        //   同 ABI）——原 IR_静态加载 单槽 8B 读=尾半垃圾（否决解除后的还原面
        //   分派·固化端 IR_结构体拷贝 整块拷配套）。
        //   457：补**指针层排除**（附加>=1=快照单槽指针值·按标量还原——原判
        //   缺附加：捕 结构体* 误走槽地址传参→prologue 把指针位模式+相邻垃圾
        //   当结构体整块拷）。
        整64 还原大小432d = 0;
        如果 (形态432b != 3 && 捕附加432d == 0 && !是容器类(驻留文本(捕型432d)) &&
             !是用户类_ID(捕型432d)) {
            还原大小432d = 查结构体大小(捕型432d);
            如果 (还原大小432d <= 0 &&
                 (字符串比较(驻留文本(捕型432d), "整128") ||
                  字符串比较(驻留文本(捕型432d), "正128"))) {
                还原大小432d = 16;
            }
        }
        字符串 静名432d = "cap$" + 驻留文本(lambda名ID432) + "$" + 驻留文本(捕名432d);
        整64 静序432d = 查静态序号(驻留(静名432d));
        如果 (静序432d >= 0) {
            整64 读432d = 寄存器432b;
            寄存器432b++;
            如果 (还原大小432d > 0) {
                IR追加(trap信息432.指令, 建IR指令(IR_静态地址, 0, 0, 0, 读432d,
                                                 T_整64, 静序432d));
                IR追加(trap信息432.指令, 建IR指令(IR_调用实参, 读432d, T_整64, 0,
                                                 0, 位457 + 位偏490, 0));
            } 否则 {
                IR追加(trap信息432.指令, 建IR指令(IR_静态加载, 0, 0, 0, 读432d,
                                                 捕码432d, 静序432d));
                IR追加(trap信息432.指令, 建IR指令(IR_调用实参, 读432d, 捕码432d, 0,
                                                 0, 位457 + 位偏490, 0));
            }
        }
        // 位号恒占（非哨兵位与被调形参序严格一致——形参区间按 节点_参数 全量
        //   扫·静序<0 位不传参但形参位仍在）
        位457++;
        cap432b++;
    }
    // 用户实参：参数槽装载（位=压缩后捕获数..·IR_加载 从参数槽读值——与
    //   lambda 体内读参数同通道；457：哨兵剔除位不占被调形参号→用户段位号
    //   起点=位457（非哨兵捕获实参数））
    pi432b = 整64(合成432.子起点) + 捕获数432b;
    整64 位起457 = 位457;
    整64 位432b = 位起457;
    当 (pi432b < 整64(合成432.子终点)) {
        节点 参数节点432d = 池.元素(整32(pi432b));
        如果 (参数节点432d.类型 == 节点_参数) {
            // 参数类型码按声明序取（参数类型们 与参数声明序一一对应）
            整64 参码432d = trap信息432.参数类型们.元素(整32(位432b - 位起457));
            整64 参拷贝432d = trap信息432.参数拷贝字节们.元素(整32(位432b - 位起457));
            整64 参槽432d = 0;
            结果<整64, 整32> 查槽432d = trap信息432.参数槽.获取(
                整64(参数节点432d.文本));
            如果 (查槽432d.正常) { 参槽432d = 查槽432d.值; }
            整64 读432e = 寄存器432b;
            寄存器432b++;
            如果 (参拷贝432d > 0) {
                // 810/②b B8：128/结构体参数=传址（?lambdaN prologue 从指针
                //   整块拷贝——基槽地址即参数块地址·433 同款）
                IR追加(trap信息432.指令, 建IR指令(IR_取地址, 参槽432d, 0, 0,
                                                 读432e, T_整64, 0));
                IR追加(trap信息432.指令, 建IR指令(IR_调用实参, 读432e, T_整64, 0,
                                                 0, 位432b + 位偏490, 0));
            } 否则 {
                // 标量=值装载（IR_加载 从参数槽读值——与 lambda 体内读参数同通道）
                IR追加(trap信息432.指令, 建IR指令(IR_加载, 参槽432d, 0, 0, 读432e,
                                                 参码432d, 0));
                IR追加(trap信息432.指令, 建IR指令(IR_调用实参, 读432e, 参码432d, 0,
                                                 0, 位432b + 位偏490, 0));
            }
            位432b++;
        }
        pi432b++;
    }
    // 间接调用收尾直调 ?lambdaN（操作数1=参数总数·操作数2=返回码·附加=被调）
    整64 返回寄存器432b = 寄存器432b;
    寄存器432b++;
    如果 (蹦床返回字节490 > 0) {
        // 490：转发 retbuf 形态（类型位=retbuf 槽·位0=蹦床内帧尾共享区——
        //   后端 lea rcx；?lambdaN 亦 sret=生成函数 通道自动置 retbuf 被调
        //   形态），返回码=0（返回装载 mov 目标,rax=MS/SysV 隐藏指针）——
        //   原返回码=T_未知 且 类型位=0：后端判无 retbuf → rcx 装首捕获实参，
        //   ?lambdaN 把捕获快照地址当 retbuf 写=814 面2/3 同族崩溃（#485
        //   宿主 ir_lambda.cpp 转发 retbuf 预插同面）。
        IR追加(trap信息432.指令, 建IR指令(IR_间接调用, 位432b + 位偏490, 0, 0,
                                         返回寄存器432b, 1, 被调432b));
        // 返回透传（宿主 endReturn(buf) 同构）：?lambdaN retbuf（rax=基址）
        //   整块拷到槽1 指向（调用方 retbuf·prologue 已存）+rax=槽1 值
        //   （MS/SysV sret 返回约定）——epilogue 按 IR_返回 装载。
        整64 调方buf490 = 寄存器432b;
        寄存器432b++;
        IR追加(trap信息432.指令, 建IR指令(IR_加载, 1, 0, 0, 调方buf490, T_整64, 0));
        IR追加(trap信息432.指令, 建IR指令(IR_结构体拷贝, 返回寄存器432b,
                                         调方buf490, 0, 0, 蹦床返回字节490, 0));
        IR追加(trap信息432.指令, 建IR指令(IR_返回, 调方buf490, 0, 0, 0, 0, 0));
    } 否则 {
        IR追加(trap信息432.指令, 建IR指令(IR_间接调用, 位432b,
                                         trap信息432.返回类型, 0,
                                         返回寄存器432b, 0, 被调432b));
        如果 (trap信息432.返回类型 != T_未知 && trap信息432.返回类型 != T_空类型) {
            登记寄存器类型(返回寄存器432b, trap信息432.返回类型);
            IR追加(trap信息432.指令, 建IR指令(IR_返回, 返回寄存器432b, 0, 0, 0, 0, 0));
        } 否则 {
            IR追加(trap信息432.指令, 建IR指令(IR_返回, 0, 0, 0, 0, 0, 0));
        }
    }
    返回 trap信息432;
}

// ==================== 482（#482 多实例独立快照）载体槽族 ====================
// 缺陷（核验波2 实证）：蹦床从「同一定义点共享的静态快照槽」还原捕获——同一定
//   义点在循环内/跨函数接收/重赋值多次求值产生多实例共存时后写覆盖先值
//   （p482b/p482e/p482 实测双侧同病）。根治=快照随「值载体变量」独立存储
//   （载体槽=「变量名$cap$捕获名」局部槽·生成声明 波1 既有命名规则）+ 调用点
//   写回共享槽（蹦床还原读到的=该实例快照——各实例互不影响）：
//   ① 定义点（生成声明 既有段落）建载体槽固化快照（本身即多实例正确）；
//   ② 接收点（初值/赋值右值=返回来源已知的调用/已登记变量）：建载体槽+
//      共享槽->载体槽（拷贝链经「源载体->共享->目标载体」两跳）；
//   ③ 赋值位：登记更新/陈旧清除（p482 根因：重赋值后调用仍展开旧定义点）；
//   ④ 返回点（返回已登记变量）：载体槽->共享槽（接收方拷到被返回实例）；
//   ⑤ 调用点（lambda闭包调用展开 早退处）：载体槽->共享槽写回，蹦床还原
//      即该实例快照；无登记/无槽=现状直路（共享槽=最近实例，与现状同界）。
// 解析函数：解析lambda来源482——标识符（?lambdaN 定义点/闭包表登记变量）/
//   直接调用（决议函数符号查 函数返回来源482 表）。

// 482：函数返回来源表（签名键名ID -> ?lambdaN 名ID；缺=未知）——接收点静态
//   解析「该调用返回哪个定义点的实例」（生成函数 收尾写入）。
静态 映射<整64, 整64> 函数返回来源482;
// 482：本函数返回来源跟踪（生成函数 入口复位；0=未见；0-1=冲突/未知哨兵）。
静态 整64 本函数返回来源482 = 0;

// 482：函数入口复位（生成函数 调用）——闭包表清空隔离跨函数同名污染
//   （宿主 485 clear 同构；v2 原表只写不读故无清、读点激活后必须隔离）。
不安全 函数 复位载体族482() -> 空类型 {
    lambda闭包变量们.清空();
    本函数返回来源482 = 0;
}

// 482：生成函数 收尾登记（唯一已知来源才入表——冲突哨兵/未见=不登记）。
不安全 函数 收尾登记返回来源482(整64 函数名ID) -> 空类型 {
    如果 (函数名ID == 0) { 返回; }
    如果 (本函数返回来源482 <= 0) { 返回; }
    结果<空类型, 整32> 设482 = 函数返回来源482.设置(函数名ID, 本函数返回来源482);
    如果 (!设482.正常) { 运行时错误(4); }
}

// 482：来源解析——右值节点 -> ?lambdaN 名ID（0=未知）。
//   ①标识符 ?lambdaN（lambda 字面量改写形态）=定义点直用；
//   ②标识符（闭包表登记变量——值语义拷贝链的来源）；
//   ③调用（被调=标识符·决议函数符号查返回来源表——跨函数接收）。
函数 解析lambda来源482(向量<节点> 池, 节点 右值482, 整32 右值位置482) -> 整64 {
    如果 (右值482.类型 == 节点_标识符) {
        字符串 名482 = 字符串复制(驻留文本(整64(右值482.文本)));
        如果 (文本前缀217(名482, "?")) { 返回 整64(右值482.文本); }
        结果<整64, 整32> 查登482 = lambda闭包变量们.获取(整64(右值482.文本));
        如果 (查登482.正常) {
            如果 (查登482.值 != 0) { 返回 查登482.值; }
        }
        返回 0;
    }
    如果 (右值482.类型 == 节点_调用 && 右值482.子起点 > 0 &&
        整32(右值482.子起点) < 整32(池.大小())) {
        节点 被调482 = 池.元素(整32(右值482.子起点));
        如果 (被调482.类型 == 节点_标识符) {
            // 482：符号推导走「语义决议键基 + 候选枚举 + 统一链接键直查」——
            //   不经「决议函数符号」（其失败会打 IR 层诊断+计错误中止产物；
            //   本处=纯静态来源分析，失败=分析放弃回退现状直路，非编译错误。
            //   候选多值时仅当全部命中同值才采信（重载不同来源=特化实例=
            //   放弃，保守方向）。
            整64 键基482 = 调用决议查询(整64(右值位置482));
            如果 (键基482 < 0) { 返回 0; }   // 未决议（内置/构造/模板）=放弃
            整64 候选数482 = 查函数签名个数(键基482);
            如果 (候选数482 <= 0) {
                结果<整64, 整32> 查单482 = 函数返回来源482.获取(键基482);
                如果 (查单482.正常) { 返回 查单482.值; }
                // 静默豁免业务值: 查表 miss=键不存在·显式 0 哨兵（1241 批量显式化·否则块承载错误分支）
                否则 { 返回 0; }
            }
            整64 命中值482 = 0;
            整64 命中数482 = 0;
            整64 k482 = 0;
            当 (k482 < 候选数482) {
                结果<整64, 整32> 查串482 = 函数签名参数串们.获取(
                    键基482 * 键位移 + k482);
                如果 (查串482.正常) {
                    整64 链接482 = 统一链接键(键基482, 整64(被调482.文本),
                                             驻留文本(查串482.值));
                    结果<整64, 整32> 查返482 = 函数返回来源482.获取(链接482);
                    如果 (查返482.正常) {
                        如果 (命中数482 == 0) {
                            命中值482 = 查返482.值;
                        } 否则 如果 (命中值482 != 查返482.值) {
                            返回 0;   // 重载来源不一致=放弃
                        }
                        命中数482 = 命中数482 + 1;
                    }
                }
                k482++;
            }
            返回 命中值482;
        }
    }
    返回 0;
}

// 482：载体槽名（「变量名$cap$捕获名」·生成声明 波1 规则单点）驻留名ID。
函数 载体槽名482(整64 变量名ID, 整64 捕名ID) -> 整64 {
    字符串 载名482 = 字符串复制(驻留文本(变量名ID)) + "$cap$" + 驻留文本(捕名ID);
    返回 驻留(载名482);
}

// 482：载体槽定位（单表版；返回 0-1=未建）——调用方按 局部槽->参数槽 顺序
//   两查（同一调用双可变借用=别名冲突，v2 语义拒绝——故拆单表）。
函数 查载体槽482(映射<整64, 整64>& 槽表482, 整64 载名ID) -> 整64 {
    结果<整64, 整32> 查482 = 槽表482.获取(载名ID);
    如果 (查482.正常) { 返回 查482.值; }
    返回 0 - 1;
}

// 482：lambda 合成函数节点查找（生成声明 段同款倒序；未找到=节点文本为 0
//   ——合成节点文本=?lambdaN 名ID 恒非 0）。
函数 找合成节点482(向量<节点> 池, 整64 lambda名ID) -> 节点 {
    节点 找到节点482;
    整64 li482 = lambda合成函数索引们.大小() - 1;
    当 (li482 >= 0) {
        节点 cand482 = 池.元素(整32(lambda合成函数索引们.元素(整32(li482))));
        如果 (整64(cand482.文本) == lambda名ID) { 返回 cand482; }
        li482--;
    }
    返回 找到节点482;
}

// 482：单捕获布局解析（捕型/捕码/快照大小三出参——生成声明 段同口径复用）。
函数 解析捕获布局482(向量<节点> 池, 节点 合成482, 整64 lambda名ID, 整64 cap索引,
                     整64& 捕型出, 整64& 捕码出, 整64& 大小出) -> 空类型 {
    捕型出 = 0;
    捕码出 = T_整64;
    大小出 = 0;
    整64 形态482 = 0;
    结果<整64, 整32> 查形482 = lambda捕获形态们.获取(lambda名ID);
    如果 (查形482.正常) { 形态482 = 查形482.值; }
    整64 参数索引482 = 整64(合成482.子起点) + cap索引;
    整64 捕附加482 = 0;
    如果 (参数索引482 >= 0 && 参数索引482 < 整64(池.大小())) {
        节点 捕获参数482 = 池.元素(整32(参数索引482));
        如果 (整64(捕获参数482.附加) > 0 &&
            整64(捕获参数482.附加) < 整64(池.大小())) {
            节点 类型节点482 = 池.元素(整32(捕获参数482.附加));
            捕型出 = 整64(类型节点482.文本);
            捕附加482 = 整64(类型节点482.附加);
        }
    }
    如果 (捕型出 == 0) { 捕型出 = 驻留("整64"); }
    捕码出 = 类型码(捕型出);
    如果 (形态482 == 3) { 捕码出 = T_整64; }
    否则 如果 (捕附加482 >= 1 && 捕附加482 < 256) { 捕码出 = T_整64; }
    如果 (形态482 != 3 && 捕附加482 == 0 &&
        !是容器类(驻留文本(捕型出)) && !是用户类_ID(捕型出)) {
        大小出 = 查结构体大小(捕型出);
        如果 (大小出 <= 0 &&
            (字符串比较(驻留文本(捕型出), "整128") ||
             字符串比较(驻留文本(捕型出), "正128"))) {
            大小出 = 16;
        }
    }
}

// 482：载体槽按需建立（每捕获按类型宽分配·生成声明 快照段槽宽约定同款：
//   128=2 槽基址=低半；结构体=多槽基址=最高槽；标量=1 槽）。返回基址槽。
不安全 函数 确保载体槽482(映射<整64, 整64>& 局部槽, 整64 载名ID,
                    整64 捕码482, 整64 大小482, 整64* 槽计数) -> 整64 {
    整64 已有482 = 查载体槽482(局部槽, 载名ID);
    如果 (已有482 >= 0) { 返回 已有482; }
    整64 基址482 = 0;
    如果 (大小482 > 0) {
        整64 槽数482 = (大小482 + 7) / 8;
        基址482 = 槽计数[0] + 槽数482 - 1;
        槽计数[0] = 槽计数[0] + 槽数482;
    } 否则 如果 (捕码482 == T_整128 || 捕码482 == T_正128) {
        整64 底槽482 = 槽计数[0];
        槽计数[0] = 槽计数[0] + 2;
        基址482 = 底槽482 + 1;
    } 否则 {
        基址482 = 槽计数[0];
        槽计数[0] = 槽计数[0] + 1;
    }
    结果<空类型, 整32> 设槽482 = 局部槽.设置(载名ID, 基址482);
    如果 (!设槽482.正常) { 运行时错误(4); }
    返回 基址482;
}

// 482：共享静态槽 -> 载体槽（接收点/拷贝链目标端；逐捕获按型整拷；返回
//   建成数——0=无槽可建/该 lambda 无可蹦床快照）。
不安全 函数 发射共享到载体482(向量<节点> 池, 整64 变量名ID, 整64 lambda名ID,
                       映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                       向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数) -> 整64 {
    节点 合成482 = 找合成节点482(池, lambda名ID);
    如果 (整64(合成482.文本) == 0) { 返回 0; }
    整64 捕获数482 = 0;
    整64 起482 = 0;
    结果<整64, 整32> 查数482 = lambda捕获计数们.获取(lambda名ID);
    如果 (查数482.正常) { 捕获数482 = 查数482.值; }
    结果<整64, 整32> 查起482 = lambda捕获起们.获取(lambda名ID);
    如果 (查起482.正常) { 起482 = 查起482.值; }
    整64 建成482 = 0;
    整64 cap482 = 0;
    当 (cap482 < 捕获数482) {
        整64 捕名482 = lambda捕获名序们.元素(整32(起482 + cap482));
        如果 (捕名482 == 0) { cap482++; 继续; }
        整64 捕型482 = 0;
        整64 捕码482 = 0;
        整64 大小482 = 0;
        解析捕获布局482(池, 合成482, lambda名ID, cap482, 捕型482, 捕码482, 大小482);
        字符串 静名482 = "cap$" + 驻留文本(lambda名ID) + "$" + 驻留文本(捕名482);
        整64 静序482 = 查静态序号(驻留(静名482));
        如果 (静序482 < 0) { cap482++; 继续; }   // 无快照静态槽=合法无动作
        整64 载槽482 = 确保载体槽482(局部槽, 载体槽名482(变量名ID, 捕名482),
                                     捕码482, 大小482, 槽计数);
        如果 (大小482 > 0) {
            整64 源址482 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            整64 目标址482 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 源址482, T_整64, 静序482));
            IR追加(指令, 建IR指令(IR_取地址, 载槽482, 0, 0, 目标址482, T_整64, 0));
            IR追加(指令, 建IR指令(IR_结构体拷贝, 源址482, 目标址482, 0, 0,
                                 大小482, 0));
        } 否则 {
            整64 读482 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_静态加载, 0, 0, 0, 读482, 捕码482, 静序482));
            IR追加(指令, 建IR指令(IR_存储, 读482, 0, 0, 0, 0, 载槽482));
        }
        建成482 = 建成482 + 1;
        cap482++;
    }
    返回 建成482;
}

// 482：载体槽 -> 共享静态槽（返回点/调用点写回/拷贝链源端；逐捕获按型整拷；
//   返回建成数——0=该变量无载体快照（零动作=现状直路））。
不安全 函数 发射载体到共享482(向量<节点> 池, 整64 变量名ID, 整64 lambda名ID,
                       映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                       向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数) -> 整64 {
    节点 合成482 = 找合成节点482(池, lambda名ID);
    如果 (整64(合成482.文本) == 0) { 返回 0; }
    整64 捕获数482 = 0;
    整64 起482 = 0;
    结果<整64, 整32> 查数482 = lambda捕获计数们.获取(lambda名ID);
    如果 (查数482.正常) { 捕获数482 = 查数482.值; }
    结果<整64, 整32> 查起482 = lambda捕获起们.获取(lambda名ID);
    如果 (查起482.正常) { 起482 = 查起482.值; }
    整64 建成482 = 0;
    整64 cap482 = 0;
    当 (cap482 < 捕获数482) {
        整64 捕名482 = lambda捕获名序们.元素(整32(起482 + cap482));
        如果 (捕名482 == 0) { cap482++; 继续; }
        整64 载槽482 = 查载体槽482(局部槽, 载体槽名482(变量名ID, 捕名482));
        如果 (载槽482 < 0) {
            载槽482 = 查载体槽482(参数槽, 载体槽名482(变量名ID, 捕名482));
        }
        如果 (载槽482 >= 0) {
            整64 捕型482 = 0;
            整64 捕码482 = 0;
            整64 大小482 = 0;
            解析捕获布局482(池, 合成482, lambda名ID, cap482, 捕型482, 捕码482, 大小482);
            字符串 静名482 = "cap$" + 驻留文本(lambda名ID) + "$" + 驻留文本(捕名482);
            整64 静序482 = 查静态序号(驻留(静名482));
            如果 (静序482 >= 0) {
                如果 (大小482 > 0) {
                    整64 源址482 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    整64 目标址482 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_取地址, 载槽482, 0, 0, 源址482,
                                         T_整64, 0));
                    IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 目标址482,
                                         T_整64, 静序482));
                    IR追加(指令, 建IR指令(IR_结构体拷贝, 源址482, 目标址482, 0, 0,
                                         大小482, 0));
                } 否则 {
                    整64 读482 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_加载, 载槽482, 0, 0, 读482,
                                         捕码482, 0));
                    IR追加(指令, 建IR指令(IR_静态存储, 读482, 0, 0, 0, 0,
                                         静序482));
                }
                建成482 = 建成482 + 1;
            }
        }
        cap482++;
    }
    返回 建成482;
}

// 482：载体点统一处理（接收点/赋值位共用）——右值来源解析+快照拷贝+登记更新；
//   来源未知=清除陈旧登记（防 p482 重赋值后调用仍展开旧定义点）。
不安全 函数 处理载体点482(向量<节点> 池, 整32 右值位置482, 整64 变量名ID,
                    映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                    向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数) {
    如果 (右值位置482 < 0 || 右值位置482 >= 整32(池.大小())) { 返回; }
    节点 右值482 = 池.元素(右值位置482);
    整64 来源482 = 解析lambda来源482(池, 右值482, 右值位置482);
    如果 (来源482 > 0) {
        // 源=标识符（非 ? 前缀=已登记变量）：源载体槽->共享槽（源当前实例）
        //   ——后续共享->目标两跳完成值语义拷贝（拷贝链独立快照）。
        如果 (右值482.类型 == 节点_标识符) {
            字符串 源名482 = 字符串复制(驻留文本(整64(右值482.文本)));
            如果 (!文本前缀217(源名482, "?")) {
                发射载体到共享482(池, 整64(右值482.文本), 来源482, 局部槽, 参数槽,
                               指令, 寄存器计数, 槽计数);
            }
        }
        发射共享到载体482(池, 变量名ID, 来源482, 局部槽, 参数槽,
                       指令, 寄存器计数, 槽计数);
        结果<空类型, 整32> 登482 = lambda闭包变量们.设置(变量名ID, 来源482);
        如果 (!登482.正常) { 运行时错误(4); }
    } 否则 {
        结果<空类型, 整32> 清482 = lambda闭包变量们.设置(变量名ID, 0);
        如果 (!清482.正常) { 运行时错误(4); }
    }
}

// 482：返回点处理（生成返回语句 值生成后）——右值=已登记变量时载体槽->共享槽
//   （接收方按「函数返回来源」拷到被返回实例）+本函数返回来源跟踪。
不安全 函数 发射返回点482(向量<节点> 池, 整32 右值位置482,
                    映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                    向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数) {
    如果 (右值位置482 < 0 || 右值位置482 >= 整32(池.大小())) { 返回; }
    节点 右值482 = 池.元素(右值位置482);
    整64 来源482 = 解析lambda来源482(池, 右值482, 右值位置482);
    如果 (来源482 > 0) {
        如果 (右值482.类型 == 节点_标识符) {
            字符串 源名482 = 字符串复制(驻留文本(整64(右值482.文本)));
            如果 (!文本前缀217(源名482, "?")) {
                发射载体到共享482(池, 整64(右值482.文本), 来源482, 局部槽, 参数槽,
                               指令, 寄存器计数, 槽计数);
            }
        }
        如果 (本函数返回来源482 == 0) {
            本函数返回来源482 = 来源482;
        } 否则 如果 (本函数返回来源482 != 来源482) {
            本函数返回来源482 = 0 - 1;
        }
    } 否则 {
        如果 (本函数返回来源482 != 0) { 本函数返回来源482 = 0 - 1; }
    }
}
