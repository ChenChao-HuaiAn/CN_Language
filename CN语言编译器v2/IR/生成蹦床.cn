// CN 自举编译器 v2 · lambda 蹦床合成（432·#276 波3·新文件=宿主 ir_lambda.cpp 对称·单一职责）
// 职责：为每个 lambda 合成函数生成蹦床函数 IR（?lambdaN$trap）——签名=用户签名；
//   体=逐捕获 IR_静态加载（静态快照槽·生成声明 绑定段注册固化）+ 用户参数槽装载
//   + IR_间接调用 直调 ?lambdaN + IR_返回。
// 闭包值模型（宿主 ir_lambda.cpp 同构·001 §5.6 lambda+spec 04-一D）：
//   lambda 值=蹦床地址（变量槽装蹦床地址·合法函数指针值）——可安全作函数指针
//   返回/实参传递（高阶两面载体·逃逸调用走既有 T69 间接调用通道零新增调用面）；
//   捕获快照固化静态槽（值捕获=定义处值；[&]=变量地址）随蹦床全局存活=逃逸安全
//   （悬垂零容忍·安全目标②；[&] 逃逸=悬垂域挂 #435/#468 逃逸检查面）。
//   结构体/128 捕获保持旧轨（局部槽快照+展开直调·#428/#418 多槽面——生成声明
//   trap形432 旗分流），蹦床不生成。
// 协议依据：函数IR/IR指令（IR容器）·IR_调用实参 类型字段=参数位号·IR_间接调用
//   操作数1=参数总数/附加=被调指针寄存器（lambda闭包调用展开 同款发射序）。
导入 容器::向量;
导入 映射集合;
导入 IR;         // IR指令/函数IR/建IR指令/IR追加/操作码与类型码常量（目录包名）
导入 协议常量;   // 节点/节点_*/常量（目录包名·335 重构B 独立包）
导入 IR生成;     // 登记寄存器类型（同包）

公开:

// 432：lambda 可蹦床判定（捕获全∈标量/字符串/引用·结构体/128=旧轨否决）。
//   生成表达式 标识符收口（表达式位统一 trap 化）与 lambda闭包调用展开
//   （trap 形态早退走 T69）双消费点共用——通道归一单一判定源。
函数 lambda可蹦床432(整64 lambda名ID432) -> 布尔 {
    整64 形态432 = 0;
    结果<整64, 整32> 查形态432 = lambda捕获形态们.获取(lambda名ID432);
    如果 (查形态432.正常) { 形态432 = 查形态432.值; }
    整64 捕获数432 = 0;
    结果<整64, 整32> 查数432 = lambda捕获计数们.获取(lambda名ID432);
    如果 (查数432.正常) { 捕获数432 = 查数432.值; }
    整64 捕获起432 = 0;
    结果<整64, 整32> 查起432 = lambda捕获起们.获取(lambda名ID432);
    如果 (查起432.正常) { 捕获起432 = 查起432.值; }
    整64 cap432 = 0;
    当 (cap432 < 捕获数432) {
        整64 捕名432 = lambda捕获名序们.元素(整32(捕获起432 + cap432));
        整64 捕型432 = 查lambda捕获参数类型(lambda名ID432, 捕名432);
        如果 (捕型432 == 0) { 捕型432 = 驻留("整64"); }
        // 结构体值捕获否决（#428 多槽面·静态单槽装不下）；128 位捕获否决
        //（#418 双槽面）；容器/类=指针语义单槽可载（指针捕获同标量面）
        如果 (形态432 != 3 && 查结构体大小(捕型432) > 0 &&
             !是容器类(驻留文本(捕型432)) && !是用户类_ID(捕型432)) {
            返回 假;
        }
        如果 (字符串比较(驻留文本(捕型432), "整128") ||
             字符串比较(驻留文本(捕型432), "正128")) {
            返回 假;
        }
        cap432++;
    }
    返回 真;
}

// 432：lambda 快照静态槽注册+定义处固化（表达式求值位=定义点·宿主
//   emitLambdaSnapshotStores 同构）。[&]=槽地址（引用语义）；值捕获=槽值
//  （捕获时复制·spec 04-一D）。
不安全 函数 固化lambda快照432(整64 lambda名ID432, 映射<整64, 整64>& 局部槽,
                          映射<整64, 整64>& 参数槽, 向量<IR指令>& 指令,
                          整64* 寄存器计数) -> 空类型 {
    整64 形态432 = 0;
    结果<整64, 整32> 查形态432 = lambda捕获形态们.获取(lambda名ID432);
    如果 (查形态432.正常) { 形态432 = 查形态432.值; }
    整64 捕获数432 = 0;
    结果<整64, 整32> 查数432 = lambda捕获计数们.获取(lambda名ID432);
    如果 (查数432.正常) { 捕获数432 = 查数432.值; }
    整64 捕获起432 = 0;
    结果<整64, 整32> 查起432 = lambda捕获起们.获取(lambda名ID432);
    如果 (查起432.正常) { 捕获起432 = 查起432.值; }
    整64 cap432 = 0;
    当 (cap432 < 捕获数432) {
        整64 捕名432 = lambda捕获名序们.元素(整32(捕获起432 + cap432));
        整64 捕型432 = 查lambda捕获参数类型(lambda名ID432, 捕名432);
        如果 (捕型432 == 0) { 捕型432 = 驻留("整64"); }
        // 外层捕获变量槽（局部/参数·定义处当前值=快照源）
        整64 源槽432 = 0;
        结果<整64, 整32> 查局432 = 局部槽.获取(捕名432);
        如果 (查局432.正常) { 源槽432 = 查局432.值; }
        如果 (源槽432 == 0) {
            结果<整64, 整32> 查参432 = 参数槽.获取(捕名432);
            如果 (查参432.正常) { 源槽432 = 查参432.值; }
        }
        如果 (源槽432 == 0) {
            cap432++;
            继续;
        }
        // 静态快照槽注册（cap$?lambdaN$捕名·宿主 lambdaSlotKey 同名同构；
        //   平行表同步——初值区间 -1/-1=运行期固化·静态初始值们 不追加=
        //   代码生成 g 越界默认 "0" 无错位）
        字符串 静名432 = "cap$" + 驻留文本(lambda名ID432) + "$" + 驻留文本(捕名432);
        整64 静名ID432 = 驻留(静名432);
        结果<整64, 整32> 查已有432 = 静态序号们.获取(静名ID432);
        如果 (!查已有432.正常) {
            整64 静序432 = 静态名们.大小();
            结果<空类型, 整32> 加静名432 = 静态名们.追加(静名ID432);
            如果 (!加静名432.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加静型432 = 静态类型们.追加(捕型432);
            如果 (!加静型432.正常) { 运行时错误(4); }
            结果<空类型, 整32> 设静序432 = 静态序号们.设置(静名ID432, 静序432);
            如果 (!设静序432.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加起432 = 静态初值起点们.追加(0 - 1);
            如果 (!加起432.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加终432 = 静态初值终点们.追加(0 - 1);
            如果 (!加终432.正常) { 运行时错误(4); }
        }
        整64 静序实432 = 查静态序号(静名ID432);
        整64 捕码432 = 类型码(捕型432);
        // 定义处固化：[&]=变量槽地址；值捕获=槽值
        整64 固化寄存器432 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        如果 (形态432 == 3) {
            IR追加(指令, 建IR指令(IR_取地址, 源槽432, 0, 0, 固化寄存器432,
                                 T_整64, 0));
        } 否则 {
            IR追加(指令, 建IR指令(IR_加载, 源槽432, 0, 0, 固化寄存器432,
                                 捕码432, 0));
        }
        IR追加(指令, 建IR指令(IR_静态存储, 固化寄存器432, 0, 0, 0, 0, 静序实432));
        cap432++;
    }
}

// 432：lambda 蹦床函数 IR 生成（IR生成尾 lambda 合成循环逐个调用·追加进 程序.函数们）。
//   不可生成形态（结构体/128 捕获·结构体/128 用户参数）返回 名字=0 哨兵（调用方跳过追加）。
不安全 函数 生成lambda蹦床432(向量<节点> 池, 节点 合成432, 整64 lambda名ID432) -> 函数IR {
    函数IR trap信息432;
    初始化函数信息字段(trap信息432);
    trap信息432.块计数 = 0;
    trap信息432.当前块 = 0;
    整64 捕获数432b = 0;
    结果<整64, 整32> 查数432b = lambda捕获计数们.获取(lambda名ID432);
    如果 (查数432b.正常) { 捕获数432b = 查数432b.值; }
    整64 捕获起432b = 0;
    结果<整64, 整32> 查起432b = lambda捕获起们.获取(lambda名ID432);
    如果 (查起432b.正常) { 捕获起432b = 查起432b.值; }
    整64 形态432b = 0;
    结果<整64, 整32> 查形态432b = lambda捕获形态们.获取(lambda名ID432);
    如果 (查形态432b.正常) { 形态432b = 查形态432b.值; }
    // 可生成判定①：捕获全∈标量/字符串/引用（结构体/128=旧轨否决）
    整64 可生成432 = 1;
    整64 cap432b = 0;
    当 (cap432b < 捕获数432b) {
        整64 捕名432c = lambda捕获名序们.元素(整32(捕获起432b + cap432b));
        整64 捕型432c = 0;
        整64 参数索引432c = 整64(合成432.子起点) + cap432b;
        如果 (参数索引432c >= 0 && 参数索引432c < 整64(池.大小())) {
            节点 捕获参数432c = 池.元素(整32(参数索引432c));
            如果 (整64(捕获参数432c.附加) > 0 &&
                 整64(捕获参数432c.附加) < 整64(池.大小())) {
                捕型432c = 整64(池.元素(整32(捕获参数432c.附加)).文本);
            }
        }
        如果 (捕型432c == 0) { 捕型432c = 驻留("整64"); }
        // 结构体值捕获否决（#428 面·静态单槽装不下多槽快照）；128 位捕获否决
        //（#418 双槽面）；容器/类=指针语义单槽可载（指针捕获同标量面）
        如果 (形态432b != 3 && 查结构体大小(捕型432c) > 0 &&
             !是容器类(驻留文本(捕型432c)) && !是用户类_ID(捕型432c)) {
            可生成432 = 0;
        }
        如果 (字符串比较(驻留文本(捕型432c), "整128") ||
             字符串比较(驻留文本(捕型432c), "正128")) {
            可生成432 = 0;
        }
        cap432b++;
    }
    // 用户参数段：槽分配+参数槽四表登记（生成函数 同协议·声明序）——
    //   标量=1 槽直存（拷贝字节 0）；128 位=双槽 16 字节（810·类型码 T_整128/
    //   T_正128）；结构体按值=多槽+拷贝字节=类型大小（②b B8 传址 prologue 拷贝）。
    //   **判定单一化**：可生成性只由捕获面决定（判定①）——参数段全形态可载，
    //   与 lambda可蹦床432（生成表达式 收口·无池只查捕获）天然对称（440
    //   LNK2019 实录=两处判定不对称：收口引用 trap 符号而生成侧否决缺席）。
    整64 pi432b = 整64(合成432.子起点) + 捕获数432b;
    如果 (可生成432 == 0) {
        trap信息432.名字 = 0;
        返回 trap信息432;
    }
    // 用户参数段：槽分配（标量单槽·声明序）+参数槽三表登记（生成函数 同协议——
    //   拷贝字节=0 标量直存；参数类型码=序言装载寄存器类分派依据）
    pi432b = 整64(合成432.子起点) + 捕获数432b;
    整64 槽序432b = 1;   // 槽号从 1 起（0=非法哨兵·992 守卫域）
    // 432：签名键参数串（名#参数类型串·逗号分隔——trap 引用 ?lambdaN 的
    //   IR_函数地址 附加须经同款签名键，代码生成 符号修饰 才与定义侧 PROC
    //   符号一致（纯名直通≠带参修饰·LNK2019 实录）。**串含捕获参数**：
    //   定义侧 ?lambdaN 函数IR 参数=捕获+用户全段（visitLambdaExpr 同构），
    //   引用串须与定义侧逐位一致（?lambda1 双 H 实录=串漏捕获段））
    字符串 参数串432 = "";
    {
        整64 cap串432 = 0;
        当 (cap串432 < 捕获数432b) {
            整64 捕名串432 = lambda捕获名序们.元素(整32(捕获起432b + cap串432));
            整64 捕型串432 = 查lambda捕获参数类型(lambda名ID432, 捕名串432);
            如果 (捕型串432 == 0) { 捕型串432 = 驻留("整64"); }
            如果 (字符串长度(参数串432) > 0) { 参数串432 = 参数串432 + ","; }
            参数串432 = 参数串432 + 驻留文本(捕型串432);
            cap串432++;
        }
    }
    当 (pi432b < 整64(合成432.子终点)) {
        节点 参数节点432c = 池.元素(整32(pi432b));
        如果 (参数节点432c.类型 == 节点_参数) {
            整64 参型432c = 0;
            如果 (整64(参数节点432c.附加) > 0 &&
                 整64(参数节点432c.附加) < 整64(池.大小())) {
                参型432c = 整64(池.元素(整32(参数节点432c.附加)).文本);
            }
            如果 (参型432c == 0) { 参型432c = 驻留("整64"); }
            整64 参码432c = 类型码(参型432c);
            // 810：128 位形参——双槽（拷贝字节 16·类型码 T_整128/T_正128·
            //   基槽登记=最大槽号=低地址）·结构体按值=多槽（拷贝字节=类型大小）
            整64 参槽数432c = 1;
            整64 参拷贝432c = 0;
            如果 (参码432c == T_整128 || 参码432c == T_正128) {
                参槽数432c = 2;
                参拷贝432c = 16;
            } 否则 如果 (查结构体大小(参型432c) > 0 &&
                        !是容器类(驻留文本(参型432c)) &&
                        !是用户类_ID(参型432c)) {
                参拷贝432c = 查结构体大小(参型432c);
                参槽数432c = (参拷贝432c + 7) / 8;
                参码432c = T_整64;   // 传址形态=地址装载（91-a 同判）
            }
            如果 (字符串长度(参数串432) > 0) { 参数串432 = 参数串432 + ","; }
            参数串432 = 参数串432 + 驻留文本(参型432c);
            整64 基槽432c = 槽序432b + 参槽数432c - 1;
            结果<空类型, 整32> 设参槽432b = trap信息432.参数槽.设置(
                整64(参数节点432c.文本), 基槽432c);
            如果 (!设参槽432b.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加槽序432b = trap信息432.参数槽序们.追加(基槽432c);
            如果 (!加槽序432b.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加拷贝432b = trap信息432.参数拷贝字节们.追加(参拷贝432c);
            如果 (!加拷贝432b.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加类型432b = trap信息432.参数类型们.追加(参码432c);
            如果 (!加类型432b.正常) { 运行时错误(4); }
            槽序432b = 槽序432b + 参槽数432c;
        }
        pi432b++;
    }
    // 返回类型（合成.附加=返回类型名ID·语义层推导回填位）
    trap信息432.返回类型 = 类型码(整64(合成432.附加));
    // 蹦床名（IR_函数地址 调用侧符号与 名字 字段一致）
    trap信息432.名字 = 整32(驻留(驻留文本(lambda名ID432) + "$trap"));
    // 指令体：独立寄存器空间（trap 函数局部计数·寄存器号从 1 起——992 守卫域）
    整64 寄存器432b = 1;
    整64 被调432b = 寄存器432b;
    寄存器432b++;
    字符串 被调符号432b = 字符串复制(驻留文本(lambda名ID432));
    如果 (字符串长度(参数串432) > 0) {
        被调符号432b = 字符串复制(被调符号432b + "#" + 参数串432);
    }
    IR追加(trap信息432.指令, 建IR指令(IR_函数地址, 0, 0, 0, 被调432b, T_整64,
                                     驻留(被调符号432b)));
    // 捕获实参还原：IR_静态加载（生成声明 绑定段注册固化的静态快照槽）
    cap432b = 0;
    当 (cap432b < 捕获数432b) {
        整64 捕名432d = lambda捕获名序们.元素(整32(捕获起432b + cap432b));
        整64 捕型432d = 0;
        整64 参数索引432d = 整64(合成432.子起点) + cap432b;
        如果 (参数索引432d >= 0 && 参数索引432d < 整64(池.大小())) {
            节点 捕获参数432d = 池.元素(整32(参数索引432d));
            如果 (整64(捕获参数432d.附加) > 0 &&
                 整64(捕获参数432d.附加) < 整64(池.大小())) {
                捕型432d = 整64(池.元素(整32(捕获参数432d.附加)).文本);
            }
        }
        如果 (捕型432d == 0) { 捕型432d = 驻留("整64"); }
        整64 捕码432d = 类型码(捕型432d);
        如果 (形态432b == 3) { 捕码432d = T_整64; }   // [&] 快照=地址
        字符串 静名432d = "cap$" + 驻留文本(lambda名ID432) + "$" + 驻留文本(捕名432d);
        整64 静序432d = 查静态序号(驻留(静名432d));
        如果 (静序432d >= 0) {
            整64 读432d = 寄存器432b;
            寄存器432b++;
            IR追加(trap信息432.指令, 建IR指令(IR_静态加载, 0, 0, 0, 读432d,
                                             捕码432d, 静序432d));
            IR追加(trap信息432.指令, 建IR指令(IR_调用实参, 读432d, 捕码432d, 0,
                                             0, cap432b, 0));
        }
        cap432b++;
    }
    // 用户实参：参数槽装载（位=捕获数..·IR_加载 从参数槽读值——与 lambda 体
    //   内读参数同通道）
    pi432b = 整64(合成432.子起点) + 捕获数432b;
    整64 位432b = 捕获数432b;
    当 (pi432b < 整64(合成432.子终点)) {
        节点 参数节点432d = 池.元素(整32(pi432b));
        如果 (参数节点432d.类型 == 节点_参数) {
            // 参数类型码按声明序取（参数类型们 与参数声明序一一对应）
            整64 参码432d = trap信息432.参数类型们.元素(整32(位432b - 捕获数432b));
            整64 参拷贝432d = trap信息432.参数拷贝字节们.元素(整32(位432b - 捕获数432b));
            整64 参槽432d = 0;
            结果<整64, 整32> 查槽432d = trap信息432.参数槽.获取(
                整64(参数节点432d.文本));
            如果 (查槽432d.正常) { 参槽432d = 查槽432d.值; }
            整64 读432e = 寄存器432b;
            寄存器432b++;
            如果 (参拷贝432d > 0) {
                // 810/②b B8：128/结构体参数=传址（?lambdaN prologue 从指针
                //   整块拷贝——基槽地址即参数块地址·433 同款）
                IR追加(trap信息432.指令, 建IR指令(IR_取地址, 参槽432d, 0, 0,
                                                 读432e, T_整64, 0));
                IR追加(trap信息432.指令, 建IR指令(IR_调用实参, 读432e, T_整64, 0,
                                                 0, 位432b, 0));
            } 否则 {
                // 标量=值装载（IR_加载 从参数槽读值——与 lambda 体内读参数同通道）
                IR追加(trap信息432.指令, 建IR指令(IR_加载, 参槽432d, 0, 0, 读432e,
                                                 参码432d, 0));
                IR追加(trap信息432.指令, 建IR指令(IR_调用实参, 读432e, 参码432d, 0,
                                                 0, 位432b, 0));
            }
            位432b++;
        }
        pi432b++;
    }
    // 间接调用收尾直调 ?lambdaN（操作数1=参数总数·操作数2=返回码·附加=被调）
    整64 返回寄存器432b = 寄存器432b;
    寄存器432b++;
    IR追加(trap信息432.指令, 建IR指令(IR_间接调用, 位432b,
                                     trap信息432.返回类型, 0,
                                     返回寄存器432b, 0, 被调432b));
    如果 (trap信息432.返回类型 != T_未知 && trap信息432.返回类型 != T_空类型) {
        登记寄存器类型(返回寄存器432b, trap信息432.返回类型);
        IR追加(trap信息432.指令, 建IR指令(IR_返回, 返回寄存器432b, 0, 0, 0, 0, 0));
    } 否则 {
        IR追加(trap信息432.指令, 建IR指令(IR_返回, 0, 0, 0, 0, 0, 0));
    }
    返回 trap信息432;
}
