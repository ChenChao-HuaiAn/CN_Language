// CN 自举编译器 v2 · 生成表达式（千行拆分子模块，2026-09-08 用户裁决阶段目录包）
// 职责：表达式后缀求值（生成表达式）+ 左值地址生成（生成左值地址）——自
//   IR生成.cn 机械搬移；寄存器/引用参数/实参结构等权威表经 公开: 访问
//   函数（IR生成 主干）；模块路径=生成表达式（新键基）。
导入 容器::向量;
导入 语法;       // Token/AST 节点池（原 导入 语法分析，目录包名）
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 IR生成;     // 函数级变量类型权威表/重载决议/控制流辅助（同包幂等）
导入 生成表达式求值; // 调用族+下标族六函数（R3 拆分，单向依赖无循环）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）
// D1 行数整改 120-a：按族拆出 生成表达式运算.cn / 生成表达式字段.cn（纯重构零行为变更）

// 函数名作值的链接符号（宿主 funcFirstSigKey 语义=重载取**首个签名**）：值位
//   无实参可决议（决议函数符号 走调用位实参推导）——按签名表首候选合成签名键
//   （键基#参数串，与定义侧 初始化签名与返回字段 同公式）。
//   查序：纯名键基 -> 当前模块键基合成；签名键 miss 时内置名报内部错误中止
//   （#1705②·内置无链接符号·禁静默降级），非内置名=纯名回退（无参老式名
//   合法面·符号修饰 天然处理）。
函数 函数值符号480(整64 名ID) -> 整64 {
    整64 键480 = 名ID;
    布尔 有签480 = 假;   // 候选数提取（结果 流敏感检查惯例；计数登记恒 ≥1）
    结果<整64, 整32> 查数480 = 查函数签名个数(键480);
    如果 (查数480.正常) { 有签480 = 查数480.值 > 0; }
    如果 (!有签480) {
        整64 键2 = 键基合成(取当前模块路径(), 名ID);
        如果 (键2 != 键480) {
            结果<整64, 整32> 查数2 = 查函数签名个数(键2);
            如果 (查数2.正常) {
                // 1360 批5 审查 P1：回退命中必须切换键——原实现丢 `键480 = 键2`
                //   致非主模块函数名作值仍按裸名键取参数串（必 miss）→ 发裸符号
                //   （他模块同名=静默错派/否则链接失败）。
                如果 (查数2.值 != 0) { 键480 = 键2; 有签480 = 真; }
            }
        }
    }
    如果 (有签480) {
        结果<整64, 整32> 串查480 = 查函数签名参数串(键480 * 键位移);
        如果 (串查480.正常) {
            // 943（工单Ⅰ）：值位经统一链接键（克隆分支同口径）
            整64 键值480 = 统一链接键(键480, 名ID, 驻留文本(串查480.值));
            如果 (键值480 != 0) { 返回 键值480; }
        }
    }
    // #1705②（内置查表 miss 显形·882 处置①·436/466-a fail fast 同族）：两级
    //   签名键皆 miss 且名=内置函数——内置无链接符号（打印族=逐参复合发射·
    //   其余=__cn_ 运行时直调），按普通名回落=发 ?E68993E58DB0@@Y 类链接期
    //   未定义符号（#1705/#1455 实录）→ 当场报内部错误中止，全面禁止静默
    //   降级。用户函数恒有签名登记（954 计数口径）不受影响；用户与内置同名
    //   被注册面拒绝（内置独占惯例）→ 不会误伤。
    //   判据两面：①内置函数返回类型ID 表成员（打印族/摘除/驻留/字符串族/
    //   IO::/文件::/数学::/内存::/时间::/线程::/解析::/系统::/构建器::/分配族/
    //   运行时错误 全集）；②复合内置枚举（正常/错误/某些=结果构造器·转移/
    //   回绕三件套/复制=编译期展开——返回类型表不含形态；宿主 functions_ 纯名
    //   注册面同集合·v2 语义层裸名拦截不全〔某些/转移 实测静默放行〕IR 层补
    //   显形=双编译零分叉）。
    可选<整64> 内置身份查1705 = 内置函数返回类型ID(驻留文本(名ID));
    布尔 内置命中1705 = 内置身份查1705.有值;
    如果 (!内置命中1705) {
        字符串 名1705 = 字符串复制(驻留文本(名ID));   // 019 拥有契约：借用视图显式落堆
        如果 (字符串比较(名1705, "正常") || 字符串比较(名1705, "错误") ||
             字符串比较(名1705, "某些") || 字符串比较(名1705, "转移") ||
             字符串比较(名1705, "复制") || 字符串比较(名1705, "回绕加") ||
             字符串比较(名1705, "回绕减") || 字符串比较(名1705, "回绕乘")) {
            内置命中1705 = 真;
        }
    }
    如果 (内置命中1705) {
        IR层诊断("内置函数 '" + 驻留文本(名ID) +
                 "' 签名查表 miss 被按普通函数名取地址——内置无链接符号·静默降级已废除（#1705）");
        运行时错误(6);
    }
    返回 名ID;   // 纯名回退（非内置·无参老式名合法面·原行为）
}

// ==================== T69（480-a 深度机）函数指针值位收口 ====================
// 函数名作值：生成标识符加载 的兜底把未命中变量/参数/静态/常量的标识符压成
//   「0-名ID」负占位（供 生成调用 识别被调=直接调用）。该形态落在**值位**
//   （实参/初值/赋值右值/返回）时须还原为函数地址（宿主 ir_expr.cpp:245-256
//   标识符非变量→FuncAddr 同构）。
//   本函数=消费侧单点收口（负值→IR_函数地址 新寄存器；非负值原样直通）：
//   被调位（生成调用 弹被调）不经此处=直接调用语义不变（零性能影响）。
不安全 函数 值位函数名收口480(整64 值, 向量<IR指令>& 指令, 整64* 寄存器计数) -> 整64 {
    如果 (值 >= 0) { 返回 值; }
    整64 寄存器480 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_函数地址, 0, 0, 0, 寄存器480, T_整64,
                         函数值符号480(0 - 值)));
    登记寄存器类型(寄存器480, T_整64);
    返回 寄存器480;
}

// 实参弹出们 值位收口（原地替换负占位——实参顺序不变，就地改写向量元素）
函数 实参负占位收口480(向量<IR指令>& 指令, 整64* 寄存器计数,
                     向量<整64>& 弹出们) -> 空类型 {
    整64 i480 = 0;
    当 (i480 < 弹出们.大小()) {
        整64 值480 = 弹出们.元素(i480);
        如果 (值480 < 0) {
            整64 新值480 = 值位函数名收口480(值480, 指令, 寄存器计数);
            结果<空类型, 整32> 设480 = 弹出们.设置(i480, 新值480);
            如果 (!设480.正常) { 运行时错误(4); }
        }
        i480++;
    }
}

// 预扫描区间收集族+区间终点（自增/取址/构造/打印/短路/三元/错误传播/区间终点）
//   已拆出至同目录 生成预扫区间.cn（#1705 轮先拆再加·函数体逐字搬移·零逻辑
//   变化·声明见 包.cn）——同包符号经合并全局池解析·调用点零变化。

// 字面量节点（整/布尔/字符串）发射常量寄存器并入栈，返回 压栈寄存器。
// 265-a 波A：整字面量位宽判定（纯长度保守法）——含负号总长 ≤10 恒适配
//   T_整32（宿主 C 语义字面量缺省 int）；长度 ≥11 保守 T_整64。
//   配套=公共整型提升（二元面位宽大者胜）——263-a 回归根因是「取左保持窄」
//   误截断非移位算术，波A 以提升规则正确化（380 校验和=最强哨兵）。
// 565 轮（T33 残余根治·配套修正）：改**值域判定**——原「纯长度保守法」≤10 位
//   恒真把 4000000000〔10 位·超 int32 上界 2147483647〕也登记 T_整32，违反
//   「T_整32 登记=值合 int32 域」寄存器类型契约（h1/h5 实锤：槽存原值
//   4000000000·宿主 -294967296 回绕）；超域字面量改 T_整64（同符号宽化放行
//   §混符规则）→窄宽值规范化/正32存储截断 各存储点按码正确回绕；位数 >10=
//   必然越界恒 假（不再解析防 整64 溢出）。
函数 字面量适配整32(字符串 文本) -> 布尔 {
    整64 长度 = 字符串长度(文本);
    如果 (长度 <= 0 || 长度 > 10) { 返回 假; }
    整64 值 = 0;
    整64 i = 0;
    当 (i < 长度) {
        整64 字节b = 字节值(文本, i);
        如果 (字节b < 48 || 字节b > 57) { 返回 假; }
        值 = 值 * 10 + (字节b - 48);
        i++;
    }
    返回 值 <= 2147483647;
}

// 728s：整数字面量文本后缀 → 类型名ID（宿主 literalTypeOf 同构；语义层
//   字面量后缀类型ID（语义检查字面量域.cn）的 IR 侧同名判据副本——IR 包禁
//   导入语义〔334 单向依赖〕故单点复制，后缀集合恒同步改双处；溢出检查码
//   自码474 与 代码生成共用 的同判据副本先例同款）。
//   L→整64／LL→整128／U→正32／UL→正64／ULL→正128；无后缀/非法组合=0
//   （调用方维持既有值域分派/无后缀契约）。0x/0b/0o 前缀无碍（F 不属后缀集）。
函数 字面量后缀类型名ID(字符串 字面文本) -> 整64 {
    字符串 后缀 = "";
    整64 尾 = 字符串长度(字面文本);
    当 (尾 > 0) {
        整64 字节 = 整64(字面文本[尾 - 1]) & 255;
        如果 (字节 == 76 || 字节 == 108) {          // 'L'/'l'
            后缀 = 字符串复制("L" + 后缀);
        } 否则 如果 (字节 == 85 || 字节 == 117) {   // 'U'/'u'
            后缀 = 字符串复制("U" + 后缀);
        } 否则 {
            中断;
        }
        尾 = 尾 - 1;
    }
    如果 (字符串比较(后缀, "L")) { 返回 驻留("整64"); }
    如果 (字符串比较(后缀, "LL")) { 返回 驻留("整128"); }
    如果 (字符串比较(后缀, "U")) { 返回 驻留("正32"); }
    如果 (字符串比较(后缀, "UL")) { 返回 驻留("正64"); }
    如果 (字符串比较(后缀, "ULL")) { 返回 驻留("正128"); }
    返回 0;
}

// 728s：字面量源码类型（生成表达式运算 377 段消费）——后缀定级名ID ∪ 无后缀
//   T_整32 哨兵（既有契约：检查码 474 经哨兵 fallback 寄存器码）。取根文本=
//   字面量节点自身或负号操作数。修复前带后缀字面量恒 T_整32 哨兵 → 检查码
//   474 走寄存器码 fallback（T_整32 值域分派）与无符号语义分叉；后缀定级后
//   名ID 使 检查码自类型名ID 直取 T_正32/T_整64 等（`2147483647U+1U` 检查域
//   =正32·宿主同口径）。
函数 字面量源码类型377(向量<节点> 池, 节点 末端) -> 整64 {
    整64 名IDl = 0;
    如果 (末端.类型 == 节点_整数字面量) { 名IDl = 整64(末端.文本); }
    否则 如果 (末端.类型 == 节点_负号 && 末端.子起点 > 0 &&
              末端.子起点 < 整32(池.大小()) &&
              池.元素(整32(末端.子起点)).类型 == 节点_整数字面量) {
        名IDl = 整64(池.元素(整32(末端.子起点)).文本);
    }
    如果 (名IDl != 0) {
        整64 后缀名 = 字面量后缀类型名ID(驻留文本(名IDl));
        如果 (后缀名 > 0) { 返回 后缀名; }
    }
    返回 T_整32;   // 无后缀/非法组合=既有哨兵（285 语义面同口径）
}

// 1068（910 邻接·遗留收口）：整数字面量运行期类型（数学值域提升链）——宿主
//   types::integerLiteralRuntimeType 的 v2 对称物（判定单一真源·双侧同口径；
//   910 五面已收口本判据，本函数补回绕内置实参位面）。输入=字面量文本（v2
//   负号=独立节点，经 负号 标志并入数学值）+负号标志；输出=类型名ID
//   （整32/整64/整128/正32/正64/正128）。
//   链：基型=后缀定级（字面量后缀类型名ID·无后缀/非法组合=整32 恒定级）；
//   无后缀/整64 超 int32 双域→整64、超 int64 双域→整128；正32 超 u32→
//   正64、超 u64→正128；正64 超 u64→正128；LL/ULL 恒定级 128。判定素材=
//   字面量文本入域/字面量文本入域128_640（910 既有单点·与宿主 decTextFits*
//   同口径·含进制面位数分档——0x8000000000000000 归一按数学值判超 int64）。
//   超 128 界（或超 u128）→ 返回定级 128 类型（物化面 字面量超128域 / 语义
//   诊断承接拒绝——宿主 st910 返回可诊断定级类型同语义）。
函数 字面量运行期类型1068(字符串 文本1068, 布尔 负号1068) -> 整64 {
    整64 基型1068 = 字面量后缀类型名ID(文本1068);
    如果 (基型1068 == 0) { 基型1068 = 驻留("整32"); }
    如果 (基型1068 == 驻留("整32")) {
        如果 (字面量文本入域(文本1068, "整32", 负号1068)) { 返回 驻留("整32"); }
        如果 (字面量文本入域(文本1068, "整64", 负号1068)) { 返回 驻留("整64"); }
        返回 驻留("整128");
    }
    如果 (基型1068 == 驻留("整64")) {
        如果 (字面量文本入域(文本1068, "整64", 负号1068)) { 返回 驻留("整64"); }
        返回 驻留("整128");
    }
    如果 (基型1068 == 驻留("正32")) {
        如果 (字面量文本入域(文本1068, "正32", 负号1068)) { 返回 驻留("正32"); }
        如果 (字面量文本入域(文本1068, "正64", 负号1068)) { 返回 驻留("正64"); }
        返回 驻留("正128");
    }
    如果 (基型1068 == 驻留("正64")) {
        如果 (字面量文本入域(文本1068, "正64", 负号1068)) { 返回 驻留("正64"); }
        返回 驻留("正128");
    }
    如果 (基型1068 == 驻留("整128")) { 返回 驻留("整128"); }
    返回 驻留("正128");
}

不安全 函数 生成字面量(节点 n, 向量<IR指令>& 指令, 整64* 寄存器计数,
                  整64* 槽计数, 向量<整64>& 表达式栈) -> 整64 {
    整64 寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    如果 (n.类型 == 节点_整数字面量) {
        // 814（053-001）：**大字面量 128 位物化**（规范 218「超出 整64 域的无
        //   后缀字面量按提升链归 整128」）——解析128位初值文本 拆半，高半
        //   非低半符号扩展（超 整64 域）→ 2 槽物化+句柄登记 T_整128（值=地址
        //   语义·一切 128 位消费点直用；原落 IR_常量整数 发射层 movabs 截断
        //   ——高半丢失·s2 探针 2^64+1+1 出 2 实证）。域内字面量保持原路径。
        字符串 字面文本 = 字符串复制(驻留文本(整64(n.文本)));
        整64 拆低 = 0;
        整64 拆高 = 0;
        布尔 超64域 = 假;
        // 818（064）：超 整128 域先判拒（宿主 parse 判据同构·诊断文案对齐）
        // 1016（五轮审查 P1-2）：正字面量 2^127..2^128-1 允许 128 位位模式
        //   物化（负号链中间量：-(-(-2^127)) 外层 __cn_neg_i128 取负得合法值；
        //   直接使用形态由语义层 535/隐式转换前置于域拒）。原一律按整128
        //   有符号正域拒 → 合法纯负号链表达式误拒。
        布尔 超128有符号域 = 字面量超128域(字面文本);
        布尔 位模式可物化 = 超128有符号域 && 字面量在128位承载(字面文本);
        如果 (超128有符号域 && !位模式可物化) {
            IR层诊断("整数字面量超出整128（2^127-1）范围: " + 字面文本);
        } 否则 如果 (解析128位初值文本(字面文本, 拆低, 拆高)) {
            整64 预期高 = 0;
            如果 (拆低 < 0) { 预期高 = 0 - 1; }
            如果 (拆高 != 预期高) { 超64域 = 真; }
            // 位模式中间量（2^127..2^128-1）恒超 64 位承载 → 强制 128 物化
            如果 (位模式可物化) { 超64域 = 真; }
        }
        // 728s：后缀类型名（L/U/UL 64 位族定级用；**LL/ULL 值域内不物化**——
        //   恒 128 物化会令小值 LL 字面量走 128 句柄通道，而 64 位消费点
        //   （整数转字符串/打印等）不认句柄（856 第3行 -5LL<<40 句柄垃圾值
        //   实证）；128 位语义（移位量域/超域拦截）由语义层 字面量后缀位宽474
        //   通道承载〈502 P1-2 既有·856 绿锚〉。LL/ULL 小值完整 128 物化=
        //   128 通道消费点扩展面（呈报立案））。
        整64 后缀名728 = 字面量后缀类型名ID(字面文本);
        如果 (超64域) {
            寄存器计数[0] = 寄存器计数[0] - 1;   // 释放上方预取寄存器（物化用槽）
            整64 大字句柄 = 物化字面量128位(拆低, 拆高, 指令, 寄存器计数, 槽计数);
            结果<空类型, 整32> 加大字 = 表达式栈.追加(大字句柄);
            如果 (!加大字.正常) { 运行时错误(4); }
            返回 大字句柄;
        }
        // 常量整数：操作数1=Symbol ID（文本），类型=按值域分流
        整64 字面量码 = T_整64;
        如果 (字面量适配整32(驻留文本(整64(n.文本)))) { 字面量码 = T_整32; }
        // 728s：64 位族后缀定级覆盖值域分派（宿主 literalTypeOf 同构——无后缀
        //   才按值域分流；LL/ULL 已由上方物化分支收口）——`1U`=T_正32（无符号
        //   除法/移位/比较分派与打印面全链正确）、`1L`=T_整64、`1UL`=T_正64。
        如果 (后缀名728 == 驻留("整64")) { 字面量码 = T_整64; }
        否则 如果 (后缀名728 == 驻留("正32")) { 字面量码 = T_正32; }
        否则 如果 (后缀名728 == 驻留("正64")) { 字面量码 = T_正64; }
        IR追加(指令, 建IR指令(IR_常量整数, 整64(n.文本), 0, 0, 寄存器, 字面量码, 0));
        登记寄存器类型(寄存器, 字面量码);
    } 否则 如果 (n.类型 == 节点_布尔字面量) {
        // 灰色点①根治（2026-09-04）：真/假 独立节点——常量 1/0 登记 T_布尔
        //   （打印分派 __cn_print_bool 输出 真/假、拼接 from_bool 自动分派）
        IR追加(指令, 建IR指令(IR_常量整数, 整64(n.文本), 0, 0, 寄存器, T_布尔, 0));
        登记寄存器类型(寄存器, T_布尔);
    } 否则 如果 (n.类型 == 节点_字符字面量) {
        // 95-a（2026-09-13 第九十五轮）：字符字面量——文本=Unicode 码点数字ID
        //   （词法层解码）→ IR_常量整数 + T_字符 登记（打印分派按数值输出 ASCII/
        //   码点，与宿主 字符=i32 存储 + 打印整数语义同构；规范 01b 三）
        IR追加(指令, 建IR指令(IR_常量整数, 整64(n.文本), 0, 0, 寄存器, T_字符, 0));
        登记寄存器类型(寄存器, T_字符);
    } 否则 如果 (n.类型 == 节点_浮点字面量) {
        // 89-a（2026-09-12 第八十九轮）：浮点字面量（浮64）——IR_常量浮点
        //   （操作数1=文本 Symbol ID；代码生成侧经 浮点文本净 剥 L/U 尾缀后
        //   .double/REAL8 文本直通发射——IEEE754 位模式由汇编器解析，编译期
        //   零开销）+ T_浮64 登记（打印分派/拼接消费）。
        //   缺陷背景（88-b 出口校验探针实证）：原实现主循环无此分派 + 本函数
        //   无此分支 → 浮点字面量被**静默跳过**——二元弹栈判定退化（操作数
        //   缺失 → 左右均取寄存器 0 → `cmp x,x` 恒真）、净栈 +2 契约违反、
        //   静态浮点初值注入落空（87-a 注入经 生成表达式 求值）。E2E 246 原
        //   「巧合通过」=双重侥幸，宿主同形态正确。
        IR追加(指令, 建IR指令(IR_常量浮点, 整64(n.文本), 0, 0, 寄存器, T_浮64, 0));
        登记寄存器类型(寄存器, T_浮64);
        // 352/04_types（070 波I·1026 深度机）：浮32 字面量——f/F 尾缀分型 →
        //   IR_类型转换(浮64→浮32)（后端 cvtsd2ss·单精度位型 4B 有效）——
        //   原 .double 位型 8B 装载·浮32 变量槽 4B 取低 32=0（2.5f→0.000000
        //   04_types/352/406 域实录）——转换寄存器压栈（登记 T_浮32）
        {
            字符串 浮文本i = 字符串复制(驻留文本(整64(n.文本)));
            整64 浮长i = 字符串长度(浮文本i);
            如果 (浮长i > 0) {
                整64 尾i = 整64(浮文本i[浮长i - 1]) & 255;
                如果 (尾i == 102 || 尾i == 70) {
                    寄存器 = 插入值转换(寄存器, T_浮32, 指令, 寄存器计数);
                }
            }
        }
    } 否则 {
        // P7b 字符串字面量：IR_常量字符串（操作数1=驻留文本ID）——代码生成
        //   发射 .code 段内 strData_<ID> 数据标签地址
        IR追加(指令, 建IR指令(IR_常量字符串, 整64(n.文本), 0, 0, 寄存器, T_字符串, 0));
        登记寄存器类型(寄存器, T_字符串);
    }
    结果<空类型, 整32> 加 = 表达式栈.追加(寄存器);
    如果 (!加.正常) { 运行时错误(4); }
    返回 寄存器;
}

// 标识符加载：参数槽 优先，其次 局部槽；未命中查 顶层常量（内联 IR_常量整数）/
//   顶层静态（IR_静态加载）/函数名兜底（压负数符号）；引用参数按类型分流
//   （发射引用参数读）。全部出口等价消费 1 个位置（主循环统一 位置++）。
不安全 函数 生成标识符加载(节点 n, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                   向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数,
                   向量<整64>& 表达式栈) -> 空类型 {
    整64 槽 = 0;
    结果<整64, 整32> 找参 = 参数槽.获取(整64(n.文本));
    如果 (找参.正常) { 槽 = 找参.值; } 否则 { }
    如果 (槽 == 0) {
        结果<整64, 整32> 找局 = 局部槽.获取(整64(n.文本));
        如果 (找局.正常) { 槽 = 找局.值; } 否则 { }
    }
    如果 (槽 == 0) {
        // 第七十八轮（2026-09-12）：方法体 this 引用——「自身」标识符（宿主
        //   方法体参数名同款）→ this 槽加载（对象指针；自身.方法() 调用链/
        //   自身作实参均经此出口）
        如果 (当前方法类名ID != 0 && 整64(n.文本) == 整64(驻留("自身"))) {
            整64 自寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 当前方法this槽, 0, 0, 自寄存器,
                                 T_对象, 0));
            结果<空类型, 整32> 加自 = 表达式栈.追加(自寄存器);
            如果 (!加自.正常) { 运行时错误(4); }
            返回;
        }
        // 328（2026-10-09·002·21）：「父类」标识符（基类限定调用对象位·规格06）
        //   → this 槽加载（与 自身 同出口——基类方法对子类对象安全=布局前缀
        //   同构〔278〕；父类.方法() 经 发射用户类方法调用 走基类符号静态直调·
        //   虚槽旁路由 328 尾参配套；有值守卫=无基类类不劫持同名标识符）
        可选<整64> 父基查328 = 查类基名(当前方法类名ID);
        如果 (当前方法类名ID != 0 && 整64(n.文本) == 整64(驻留("父类")) &&
             父基查328.有值) {
            整64 父寄存器328 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 当前方法this槽, 0, 0, 父寄存器328,
                                 T_对象, 0));
            结果<空类型, 整32> 加父328 = 表达式栈.追加(父寄存器328);
            如果 (!加父328.正常) { 运行时错误(4); }
            返回;
        }
        // 第七十八轮（2026-09-12）：方法体字段分派——类方法内字段名裸标识符
        //   （局部/参数槽未命中后）→ this 槽加载 + 字段地址 + 指针加载（类区间
        //   字段；当前方法上下文由 生成类.生成方法 设置——非方法体恒 miss）
        // #1310 复审 P0-A/B：静态方法无 this——实例字段裸名不参与解析（宿主
        //   isInstanceField 在静态方法恒假同口径），回落常量/静态段。
        如果 (!当前方法静态标记) {
            可选<整64> 字段偏移g查 = 当前方法字段偏移(整64(n.文本));
            如果 (字段偏移g查.有值) {
                整64 字段偏移g = 字段偏移g查.值;
                发射类字段读取(字段偏移g, 整64(n.文本), 指令, 寄存器计数, 表达式栈);
                返回;
            }
        }
        // #1310 审查 P0-1/P0-2（2026-10-23）：静态解析段**前移**至顶层常量之前——
        //   与宿主 visitIdentifierExpr 名称解析顺序对齐（handleClassFieldRead 静态/
        //   实例字段先于常量内联；584-a 遮蔽家族）。原顺序=常量先命中：类静态
        //   字段裸名与顶层常量同名时被常量劫持（1468/1469 实测 v2 读同名常量值
        //   而宿主读字段槽 → 越界判定分叉）。本段含：顶层静态/类静态字段裸名/
        //   限定名静态三类，全部按「变量槽优先于常量」语义。
        // ②c C：顶层静态——命中序号则 IR_静态加载（.data _cn_gstatic_N 槽：
        //   容器=堆对象指针；标量=初始值）。常量/局部/参数之后、函数名兜底之前。
        //   87-a（2026-09-12 第八十七轮）：静态**结构体**——值=**地址**
        //   （IR_静态地址，与局部结构体变量同款「表达式值为结构体地址」约定）。
        //   原实现无条件 IR_静态加载（读首 8 字节）：结构体实参/整体拷贝/成员链
        //   基址把首字段句柄当结构体地址（探针 P50b v2 实证：跨函数写读全错）。
        //   其余（标量=值；容器/类=堆对象指针）保持 IR_静态加载（指针槽模型）。
        整64 找静 = 0 - 1;
        结果<整64, 整32> 找静r = 查静态序号含类(整64(n.文本));
        如果 (找静r.正常) { 找静 = 找静r.值; } 否则 { }
        如果 (找静 < 0 && 当前方法类名ID != 0) {
            // 070 波G：类内静态字段裸名读（合成名静态槽）——#1310 审查 P0-2：
            //   沿基类链查找（宿主 handleClassFieldRead 遍历 ci->baseName 同口径；
            //   继承静态字段的合成名登记在基类下，当前类名查不到=1469 实测回退
            //   到同名常量）。
            整64 类查g = 当前方法类名ID;
            整64 守卫g = 0;
            当 (类查g != 0 && 守卫g < 64 && 找静 < 0) {
                结果<整64, 整32> 合成裸读 = 查类静态字段合成名(类查g, 整64(n.文本));
                如果 (合成裸读.正常) {
                    结果<整64, 整32> 找静r2 = 查静态序号含类(合成裸读.值);
                    如果 (找静r2.正常) { 找静 = 找静r2.值; } 否则 { }
                } 否则 {
                }
                // 1541 B2：无值=链到此为止（原 0 使循环条件为假·中断同效）
                可选<整64> 类上查g = 查类基名(类查g);
                如果 (!类上查g.有值) { 中断; }
                如果 (类上查g.有值) { 类查g = 类上查g.值; }
                守卫g = 守卫g + 1;
            }
        }
        如果 (找静 < 0) {
            // 434（类名::静态字段 限定读·#284 ::矩阵第五态）：限定复合名回退——
            //   查限定名静态序号 拆「类名::字段」取合成名「类$字段」静态槽，落
            //   下方既有静态读发射（517-a/87-a/810/259 全类型分派零改动复用·
            //   宿主 MemberExpr :: 与点号同语义对齐·上方静态方法 IR_函数地址
            //   分支先行·名字空间不相交）
            结果<整64, 整32> 找静q = 查限定名静态序号(整64(n.文本));
            如果 (找静q.正常) { 找静 = 找静q.值; } 否则 { }
        }
        如果 (找静 >= 0) {
            整64 静寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            // 517-a（T70 B1 三层③残余层）：**类/容器静态排除结构体地址语义**——
            //   静态槽对类/容器存的是**对象指针**（构造函数入口注入），须走
            //   IR_静态加载；原判据仅 查结构体大小>0，而类布局尺寸（映射=56）
            //   同样 >0 → 误发 IR_静态地址=**槽地址** ⇒ 使用点（方法接收者/
            //   成员链基址）拿到 .data 槽地址当对象指针 → 链查找读 桶数组=0 →
            //   段错误（127 撤守卫态 `偏移表.设置(9,200)` 实证：接收者=0x63e260
            //   〔gstatic 邻域〕而槽内容才是对象指针 0x6562d0·对象本身字段全对）。
            布尔 静是类x = 是容器类_ID(取静态类型(找静)) ||
                          是用户类_ID(取静态类型(找静));
            字符串 静类型文本y = 字符串复制(驻留文本(取静态类型(找静)));
            // 810 轮（053）：128 位静态引用——值=16 字节槽地址（IR_静态地址 lea），
            //   寄存器登记 T_整128/T_正128（值=地址语义·与 87-a 结构体静态 T_对象
            //   同构）。替换 701-a 波H「设地址128标记」：标记按寄存器号记录、
            //   寄存器复用即泄漏（波H 返回值面崩溃实证）——类型表登记与既有
            //   登记寄存器类型 生命周期同步，打印/赋值/传参消费点直接查类型。
            // 259（2026-10-07·#259 静态数组）：数组静态——值=**基址**
            //   （IR_静态地址·与 94-a 局部数组名退化/87-a 结构体静态地址约定
            //   同构；原无条件 IR_静态加载 读首 8 字节=下标读写错位崩溃·宿主
            //   ir_expr.cpp 259 同款）。登记 T_整64（指针值语义）。
            如果 (是数组类型文本(静类型文本y)) {
                IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静寄存器, T_整64, 找静));
                登记寄存器类型(静寄存器, T_整64);
            } 否则 如果 (字符串比较(静类型文本y, "整128")) {
                IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静寄存器, T_整128, 找静));
                登记寄存器类型(静寄存器, T_整128);
            } 否则 如果 (字符串比较(静类型文本y, "正128")) {
                IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静寄存器, T_正128, 找静));
                登记寄存器类型(静寄存器, T_正128);
            } 否则 如果 (是结构体大小非零(取静态类型(找静)) && !静是类x) {
                IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静寄存器, T_整64, 找静));
                // 87-a：登记 T_对象（值即地址）——回扫实参取地址不得改写
                //   （与 86-a 三元地址化同款；否则符号地址被当"值装载"改取槽）
                登记寄存器类型(静寄存器, T_对象);
            } 否则 {
                // 87-a：类型码按静态类型表分派（原硬编码 T_整64）——字符串/字符*
                //   须 T_字符串（打印/拼接按字符串分派；原按整64 分派打印出句柄
                //   数值，探针 s9-v2「串值=[94113…]」实证）；容器/类 T_对象；
                //   标量按 类型码 表（整32/正64/浮64… 各自精确）。
                整64 静类型码 = 类型码(取静态类型(找静));
                // 641-fix：装载宽度码=标量值语义精确码（整数 1/2/4 字节槽
                //   精确装载·m641y 整8/整16 窄读目标；寄存器类型登记仍用
                //   归并码 静类型码——下游运算/打印按 64 位值语义口径不变）。
                整64 静载码641 = 静态值码641(取静态类型(找静));
                IR追加(指令, 建IR指令(IR_静态加载, 0, 0, 0, 静寄存器, 静载码641,
                                             找静));
                如果 (静类型码 != T_未知) { 登记寄存器类型(静寄存器, 静类型码); }
            }
            结果<空类型, 整32> 加静 = 表达式栈.追加(静寄存器);
            如果 (!加静.正常) { 运行时错误(4); }
            返回;
        }
        // P7a：顶层常量——命中则内联 IR_常量整数（操作数1=值文本ID，
        //   代码生成经 驻留文本 还原立即数）。参数/局部未命中才查，
        //   局部变量遮蔽同名常量语义正确。
        // plans/018 常量分桶：查常量值 三级解析（本模块键基＞纯名＞候选——
        //   限定文本 甲::版本 拆分直查；修复前纯名平铺跨模块覆盖串值）
        // 1073：超 64 位承载值 128 位物化（与 生成字面量 814 大字面量链同款·
        //   第 2 处重复留此标记：第 3 处出现前提炼）——原恒 IR_常量整数(T_整64)
        //   把 20 位文本作 64 位立即数发射（截断低 64 位静默错值）；域内维持
        //   原路径（零回归）。
        结果<整64, 整32> 常值查 = 查常量值(整64(n.文本));
        如果 (常值查.正常) {
            整64 常值 = 常值查.值;
            字符串 常文本1073 = 字符串复制(驻留文本(常值));
            整64 拆低1073 = 0;
            整64 拆高1073 = 0;
            布尔 常超64 = 假;
            如果 (解析128位初值文本(常文本1073, 拆低1073, 拆高1073)) {
                整64 预期高1073 = 0;
                如果 (拆低1073 >= 0 - 9223372036854775807 - 1 && 拆低1073 <= 0 - 1) { 预期高1073 = 0 - 1; }
                如果 (拆高1073 != 预期高1073) { 常超64 = 真; }
            }
            布尔 常超128域1073 = 常超64 && 字面量超128域(常文本1073);
            如果 (常超128域1073) {
                IR层诊断("常量值超出整128（2^127-1）范围: " + 常文本1073);
                整64 零寄存器1073 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0,
                                     零寄存器1073, T_整64, 0));
                结果<空类型, 整32> 加零常 = 表达式栈.追加(零寄存器1073);
                如果 (!加零常.正常) { 运行时错误(4); }
                返回;
            }
            如果 (常超64 && !常超128域1073) {
                整64 大句柄常 = 物化字面量128位(拆低1073, 拆高1073, 指令,
                                                寄存器计数, 槽计数);
                结果<空类型, 整32> 加大常 = 表达式栈.追加(大句柄常);
                如果 (!加大常.正常) { 运行时错误(4); }
                返回;
            }
            如果 (!常超64) {
                整64 常寄存器 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                // 938（618 探针分叉面）：字符串常量内联——含引号值文本（折叠串面
                //   约定·是折叠串值938 判定）→ IR_常量字符串（操作数1=内容文本ID·
                //   T_字符串），与字符串字面量生成分支同款（代码生成发射
                //   strData_<ID> 地址·641 收集）；整数值维持 IR_常量整数。
                //   分流=如果/否则如果 双分支显式枚举（miss_gate else 新规：
                //   否则=非法输入拦截位·业务双路分流禁落否则块）。
                布尔 是串常938 = 是折叠串值938(常值);
                如果 (是串常938) {
                    IR追加(指令, 建IR指令(IR_常量字符串, 驻留(折叠串内容938(常值)),
                                         0, 0, 常寄存器, T_字符串, 0));
                    登记寄存器类型(常寄存器, T_字符串);
                } 否则 如果 (!是串常938) {
                    IR追加(指令, 建IR指令(IR_常量整数, 常值, 0, 0, 常寄存器, T_整64, 0));
                }
                结果<空类型, 整32> 加常 = 表达式栈.追加(常寄存器);
                如果 (!加常.正常) { 运行时错误(4); }
                返回;
            }
        }
        否则 {
        }
        // 070 波G 余波（1026）：类名::静态方法 限定引用——IR_函数地址(方法
        //   符号)（98 形态 应用(计算器::双倍静态, 5)·宿主 P3-23 静态作值；
        //   语义层 检查限定标识符 同判据放行返回类型）
        {
            字符串 限模g = "";
            字符串 限符g = "";
            如果 (拆限定名(字符串复制(驻留文本(整64(n.文本))), 限模g, 限符g) == 1 &&
                 是用户类_ID(驻留(限模g)) &&
                 是类静态方法(驻留(限模g), 驻留(限符g))) {
                // 912 归纳：块体（查参数串→方法符号→IR_函数地址→登记→压栈）
                //   提炼为 发射静态方法引用值 公共函数（逐字等价·点号形态共用）
                发射静态方法引用值(驻留(限模g), 驻留(限符g), 指令, 寄存器计数,
                                  表达式栈);
                返回;
            }
        }
        // 1007（98 静态方法作值·P3-23）：限定名 类::静态方法 值——IR_函数地址
        //   (方法符号 类$名[参数串]) 压栈（无 this 绑定=纯函数地址；调用位走
        //   T69 间接调用·104 方法引用同款发射）。宿主静态分发 FuncAddr 同构。
        {
            字符串 名文本fz = 字符串复制(驻留文本(整64(n.文本)));
            字符串 限定模块fz = 字符串复制("");
            字符串 限定符号fz = 字符串复制("");
            如果 (拆限定名(名文本fz, 限定模块fz, 限定符号fz) == 1 &&
                 是用户类(限定模块fz) &&
                 是类静态方法(整64(驻留(限定模块fz)), 整64(驻留(限定符号fz)))) {
                // 912 归纳：块体提炼为 发射静态方法引用值（逐字等价·点号形态共用）
                发射静态方法引用值(整64(驻留(限定模块fz)), 整64(驻留(限定符号fz)),
                                  指令, 寄存器计数, 表达式栈);
                返回;
            }
        }
        // 432（#276 波3）：lambda 字面量标识符（解析层压 ?lambdaN 占位·可蹦床
        //   形态）——静态快照槽注册+定义处固化+压蹦床地址（表达式位统一收口=
        //   绑定/实参/返回全形态归一·宿主 visitLambdaExpr 表达式位 FuncAddr(trap)
        //   同构）。不可蹦床（结构体/128 捕获）落下方函数名兜底原路（旧轨）。
        如果 (文本前缀217(字符串复制(驻留文本(整64(n.文本))), "?")) {
            如果 (lambda可蹦床432(整64(n.文本))) {
                固化lambda快照432(整64(n.文本), 局部槽, 参数槽, 指令, 寄存器计数);
                字符串 trap名432 = 驻留文本(整64(n.文本)) + "$trap";
                整64 trap寄存器432 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_函数地址, 0, 0, 0, trap寄存器432,
                                     T_整64, 驻留(trap名432)));
                登记寄存器类型(trap寄存器432, T_整64);
                结果<空类型, 整32> 加trap432 = 表达式栈.追加(trap寄存器432);
                如果 (!加trap432.正常) { 运行时错误(4); }
                返回;
            }
        }
        // 函数名（调用 被调对象）：压 负数符号 到 表达式栈（0-符号ID），
        //   非变量（参数/局部 查无）——语义层已检查未声明
        结果<空类型, 整32> 加函 = 表达式栈.追加(0 - 整64(n.文本));
        如果 (!加函.正常) { 运行时错误(4); }
        返回;
    }
    整64 寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    // ②c D：引用参数——按类型分流发射（容器& 双重解引用/结构体& 基址/标量& 解引用）
    如果 (槽是引用(槽)) {
        发射引用参数读(槽, 指令, 寄存器计数, 表达式栈);
        返回;
    }
    // 1011（537D·合成体变量/形参标识符读=地址语义）：结果/可选类槽的表达式值
    //   =**槽地址**（87-a 结构体局部/静态「值=地址」约定同构·与批二下标读侧
    //   对称）——原 IR_加载 读前 8 字节（标志+值打包）→ IR_结构体拷贝 源=打包
    //   值 → rep movsb 解引用（追加 数据[元素数量]=值 形态 fault=0x1F00000001
    //   =正常(31) 打包·537D/容器<合成体>全族实锤）。成员访问（r.值）走独立
    //   路径不受影响；传参/整体拷贝/返回物化均按地址消费（894/81-a 链）。
    {
        整64 标识类型1011 = 解析标识符类型ID(整64(n.文本));
        // #1666：**指针变量排除**——指针目标=结果/可选 时（`可选<T>* 针`）指针
        //   表登记的是剥星基名（94-a/472 同源），原判定按基名命中合成体分支 →
        //   指针变量读成「自身槽地址」（IR_取地址）而非指针值（IR_加载）：
        //   `*针 = …` 目标地址=指针槽地址（写到针槽自身·*针 写入丢失）。宿主
        //   checkExpr 标识符恒读变量值同口径；数组仍走下方数组名=基址分支。
        字符串 标识文本1011 = "";
        如果 (标识类型1011 != 0) {
            标识文本1011 = 字符串复制(驻留文本(标识类型1011));
        }
        布尔 数组名1011 = 是数组类型文本(标识文本1011);
        可选<整64> 指针查1011 = 查指针变量类型(整64(n.文本));
        布尔 指针值1011 = 指针查1011.有值 && !数组名1011;
        如果 (!指针值1011 && 是结果类型_ID(标识类型1011)) {
            IR追加(指令, 建IR指令(IR_取地址, 槽, 0, 0, 寄存器, T_整64, 0));
            登记寄存器类型(寄存器, T_对象);
            结果<空类型, 整32> 加合1011 = 表达式栈.追加(寄存器);
            如果 (!加合1011.正常) { 运行时错误(4); }
            返回;
        }
    }
    // 94-a（2026-09-13 第九十四轮）：数组变量——标识符值 = **基址地址**（数组名
    //   退化为元素指针，宿主 ir.cpp「数组名引用为元素指针」同构）：IR_取地址
    //   （基址槽=槽起+槽数-1 低地址）→ 元素指针。下标读/左值写/作实参/指针
    //   运算全链零拷贝消费（指针路径复用）；原实现 Load 槽值=数组首 8 字节数据
    //   当指针用（错误）。
    如果 (整64(解析标识符类型ID(整64(n.文本))) >= 0) {
        字符串 标识文本v = 字符串复制(
            驻留文本(解析标识符类型ID(整64(n.文本))));
        如果 (是数组类型文本(标识文本v)) {
            IR追加(指令, 建IR指令(IR_取地址, 槽, 0, 0, 寄存器, T_整64, 0));
            登记寄存器类型(寄存器, T_整64);
            // 425（wt425·09_integration 实录·宿主 ptrElemStride 数组分支同构）：
            //   数组名退化值=基址（本分支）——登记**元素宽**指针值步进，供二元
            //   +/- 步进糖（266-a 波B·生成表达式运算）消费：`名单 + 人数` 偏移
            //   =人数×元素宽（宿主同构）。原漏登=步进糖查 miss→按 1 字节步进，
            //   学生[5]（元素 24 字节）上界 `名单+5` 偏 5 字节→循环提前退出。
            可选<字符串> 元素查v = 数组元素文本(标识文本v);
            字符串 元素v = "";
            如果 (元素查v.有值) { 元素v = 字符串复制(元素查v.值); }
            登记指针值步进(寄存器, 类型名宽度(驻留(元素v)));
            结果<空类型, 整32> 加数组v = 表达式栈.追加(寄存器);
            如果 (!加数组v.正常) { 运行时错误(4); }
            返回;
        }
    }
    // 810 轮（053）：128 位标量变量（局部/形参）——标识符值=**16 字节槽对
    //   基址地址**（值=地址语义·与 87-a 结构体静态 T_对象/94-a 数组名退化
    //   同构）：IR_取地址 基址槽+登记 T_整128/T_正128。打印传址/赋值双半拷/
    //   传参传址/算术辅助函数全消费点按此语义（局部槽映射登记值=基址槽·
    //   分配标量声明槽/形参 2 槽协同）。
    字符串 标识类型文本128 = 字符串复制(
        驻留文本(解析标识符类型ID(整64(n.文本))));
    // 472（2026-10-11·1360 批5 结果化）：查指针变量类型 无值守卫（未命中=可选无值）——
    //   `整128* p` 权威表登记剥星基名 "整128"，原判定命中 → p 求值=槽对地址
    //   句柄（128 值语义）而非 IR_加载 指针值，p[i]/传参全链错位（与 472
    //   声明通道 附加==0 成对）。指针求值落下方 查指针变量类型 Load 路径。
    可选<整64> 指针查128 = 查指针变量类型(整64(n.文本));
    如果 (!指针查128.有值 &&
         (字符串比较(标识类型文本128, "整128") ||
          字符串比较(标识类型文本128, "正128"))) {
        IR追加(指令, 建IR指令(IR_取地址, 槽, 0, 0, 寄存器, T_整64, 0));
        如果 (字符串比较(标识类型文本128, "整128")) {
            登记寄存器类型(寄存器, T_整128);
        } 否则 {
            登记寄存器类型(寄存器, T_正128);
        }
        结果<空类型, 整32> 加128 = 表达式栈.追加(寄存器);
        如果 (!加128.正常) { 运行时错误(4); }
        返回;
    }
    IR追加(指令, 建IR指令(IR_加载, 槽, 0, 0, 寄存器, T_整64, 0));
    // ③ 缺陷①根治：变量/参数类型登记（打印分派/拼接转换——字符串/浮点/布尔
    //   全覆盖；经 函数级权威表+类型码，未登记=未知按整数兜底）
    整64 标识类型码 = 类型码(解析标识符类型ID(整64(n.文本)));
    // 266-a 波B：指针变量（指针变量类型们 已登记·层数分离设计下 类型码 会
    //   误取所指类型）寄存器码=T_整64——指针值 64 位语义；同时登记指针值
    //   步进（二元 +/- 步进糖消费·263-a 教训=跨文件走访问器 查指针变量类型）。
    可选<整64> 指针查步 = 查指针变量类型(整64(n.文本));
    如果 (指针查步.有值) {
        标识类型码 = T_整64;
        登记指针值步进(寄存器, 类型名宽度(指针查步.值));
    }
    如果 (标识类型码 != T_未知) {
        登记寄存器类型(寄存器, 标识类型码);
    }
    结果<空类型, 整32> 加 = 表达式栈.追加(寄存器);
    如果 (!加.正常) { 运行时错误(4); }
}

//     ① 多压（Δ>1）：残留破坏后续「相对栈顶」消费——88-a 实参位短路旧实现
//        净 +3 即此形态，症状却是远端 `[ir2] 调用被调对象非函数名/方法`
//        （契约违反表现为下游症状，定位跨三层）；88-b 实证另一例：浮点字面量
//        漏分派（操作数缺失退化弹栈判定）净 +2——已随 89-a 根治。
//     ② 吞外层（Δ<0）：弹掉了调用方先序压栈值（调用实参求值中消失等）。
//   Rust 对照：rustc MIR validator / ICE——编译器不变量违反立刻报告，
//   不让错误产物进入下游（本校验把「下游症状」提前到「当场暴露」）。
//   调用纪律：生成表达式 唯一正常出口调用（错误路径 生成调用 返回 0 已诊断——
//   不校验，避免二次噪音）。性能：1 次函数调用 + 1 次减法 + 2 次比较（无分配；
//   出口深度顺带回传省一次 大小()）——实测编译 v2 树与基线差异在噪声内
//   （plans/020 本轮量化）。
// 返回出口栈深度（调用方据此取栈顶/判空——省重复 大小() 调用）。

// 1016（五轮审查 P1-2）：纯负号链折叠生成——[字面量, 负号×N]（后缀序）链先
//   算符号（奇数层负），文本=十进制化后加符号；最终值 ≤int64 → IR_常量整数；
//   否则 128 位双半物化（超 2^127 负界/2^128 正位模式的形态由语义层判域
//   前置拒绝，本函数解析失败交回逐节点路径）。返回=0 非纯链/不可折叠
//   （调用方落逐节点求值——中间层可能溢出，故纯链必须走本路径）。
不安全 函数 折叠负号链生成1016(向量<节点> 池, 整32 根索引,
                             向量<IR指令>& 指令, 整64* 寄存器计数,
                             整64* 槽计数, 向量<整64>& 表达式栈) -> 整64 {
    如果 (根索引 <= 0 || 根索引 >= 整32(池.大小())) { 返回 0; }
    整64 层数1016 = 0;
    整64 游1016 = 整64(根索引);
    当 (游1016 > 0) {
        节点 节1016 = 池.元素(整32(游1016));
        如果 (节1016.类型 != 节点_负号) { 中断; }
        层数1016++;
        游1016 = 游1016 - 1;
    }
    如果 (层数1016 == 0) { 返回 0; }
    节点 叶1016 = 池.元素(整32(游1016));
    如果 (叶1016.类型 != 节点_整数字面量) { 返回 0; }
    字符串 原1016 = 字符串复制(驻留文本(整64(叶1016.文本)));
    字符串 折1016 = 原1016;
    如果 (层数1016 % 2 == 1) { 折1016 = 字符串复制("-" + 原1016); }
    可选<字符串> 十进1016查 = 字面量十进制文本(折1016);
    // 十进制化失败=词法已拒形态（上游已诊断）→ 可选无值显式跳过
    如果 (!十进1016查.有值) { 返回 0; }
    字符串 文1016 = 字符串复制(十进1016查.值);
    整64 起1016 = 0;
    如果 (字符串长度(文1016) > 0 && (整64(文1016[0]) & 255) == 45) { 起1016 = 1; }
    字符串 体1016 = 字符串子串(文1016, 整32(起1016),
                                整32(字符串长度(文1016) - 起1016));
    布尔 承641016 = 数文本不超上界(体1016, "9223372036854775807");
    如果 (起1016 == 1) {
        承641016 = 数文本不超上界(体1016, "9223372036854775808");
    }
    整64 寄存器1016 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    如果 (承641016) {
        // ≤int64 承载：交逐节点求值（产物类型码随操作数保持——本折叠仅
        //   解决 128 中间量溢出；承载内逐节点无溢出风险且语义零变化）
        寄存器计数[0] = 寄存器计数[0] - 1;
        返回 0;
    }
    整64 低1016 = 0;
    整64 高1016 = 0;
    // 1303 二期（882 处置①）：语义层判域已前置（超 128 域/非法文本形态不达
    //   此处——负无符号非零1016/535 域外判拒在语义期收口），十进制化成功后
    //   本解析必成功；失败=语义层与代码生成解析器不一致=编译器内部缺陷，
    //   报内部错误显形（主流程收尾 内部未登记数>0 中止产物·同 648 位非
    //   操作码先例），返回 0 保留逐节点回退控制流（收尾报在前·非静默错值）。
    //   行号传 0：发射期无源码行上下文（648 同款）。
    如果 (!解析128位初值文本(文1016, 低1016, 高1016)) {
        登记内部未登记("折叠负号链128解析", 文1016, 0);
        寄存器计数[0] = 寄存器计数[0] - 1;
        返回 0;
    }
    寄存器计数[0] = 寄存器计数[0] - 1;   // 释放预取寄存器（物化用槽·同 生成字面量）
    整64 句柄1016 = 物化字面量128位(低1016, 高1016, 指令, 寄存器计数, 槽计数);
    结果<空类型, 整32> 加句1016 = 表达式栈.追加(句柄1016);
    如果 (!加句1016.正常) { 运行时错误(4); }
    返回 句柄1016;
}
