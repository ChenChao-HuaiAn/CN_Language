            登记寄存器类型(寄存器, T_整64);
            // 425（wt425·09_integration 实录·宿主 ptrElemStride 数组分支同构）：
            //   数组名退化值=基址（本分支）——登记**元素宽**指针值步进，供二元
            //   +/- 步进糖（266-a 波B·生成表达式运算）消费：`名单 + 人数` 偏移
            //   =人数×元素宽（宿主同构）。原漏登=步进糖查 miss→按 1 字节步进，
            //   学生[5]（元素 24 字节）上界 `名单+5` 偏 5 字节→循环提前退出。
            可选<字符串> 元素查v = 数组元素文本(标识文本v);
            字符串 元素v = "";
            如果 (元素查v.有值) { 元素v = 字符串复制(元素查v.值); }
            登记指针值步进(寄存器, 类型名宽度(驻留(元素v)));
            结果<空类型, 整32> 加数组v = 表达式栈.追加(寄存器);
            如果 (!加数组v.正常) { 运行时错误(4); }
            返回;
        }
    }
    // 810 轮（053）：128 位标量变量（局部/形参）——标识符值=**16 字节槽对
    //   基址地址**（值=地址语义·与 87-a 结构体静态 T_对象/94-a 数组名退化
    //   同构）：IR_取地址 基址槽+登记 T_整128/T_正128。打印传址/赋值双半拷/
    //   传参传址/算术辅助函数全消费点按此语义（局部槽映射登记值=基址槽·
    //   分配标量声明槽/形参 2 槽协同）。
    字符串 标识类型文本128 = 字符串复制(
        驻留文本(解析标识符类型ID(整64(n.文本))));
    // 472（2026-10-11）：查指针变量类型<=0 守卫（未命中=-1·命中=所指ID>0）——
    //   `整128* p` 权威表登记剥星基名 "整128"，原判定命中 → p 求值=槽对地址
    //   句柄（128 值语义）而非 IR_加载 指针值，p[i]/传参全链错位（与 472
    //   声明通道 附加==0 成对）。指针求值落下方 查指针变量类型 Load 路径。
    如果 (查指针变量类型(整64(n.文本)) <= 0 &&
         (字符串比较(标识类型文本128, "整128") ||
          字符串比较(标识类型文本128, "正128"))) {
        IR追加(指令, 建IR指令(IR_取地址, 槽, 0, 0, 寄存器, T_整64, 0));
        如果 (字符串比较(标识类型文本128, "整128")) {
            登记寄存器类型(寄存器, T_整128);
        } 否则 {
            登记寄存器类型(寄存器, T_正128);
        }
        结果<空类型, 整32> 加128 = 表达式栈.追加(寄存器);
        如果 (!加128.正常) { 运行时错误(4); }
        返回;
    }
    IR追加(指令, 建IR指令(IR_加载, 槽, 0, 0, 寄存器, T_整64, 0));
    // ③ 缺陷①根治：变量/参数类型登记（打印分派/拼接转换——字符串/浮点/布尔
    //   全覆盖；经 函数级权威表+类型码，未登记=未知按整数兜底）
    整64 标识类型码 = 类型码(解析标识符类型ID(整64(n.文本)));
    // 266-a 波B：指针变量（指针变量类型们 已登记·层数分离设计下 类型码 会
    //   误取所指类型）寄存器码=T_整64——指针值 64 位语义；同时登记指针值
    //   步进（二元 +/- 步进糖消费·263-a 教训=跨文件走访问器 查指针变量类型）。
    如果 (查指针变量类型(整64(n.文本)) > 0) {
        标识类型码 = T_整64;
        登记指针值步进(寄存器, 类型名宽度(查指针变量类型(整64(n.文本))));
    }
    如果 (标识类型码 != T_未知) {
        登记寄存器类型(寄存器, 标识类型码);
    }
    结果<空类型, 整32> 加 = 表达式栈.追加(寄存器);
    如果 (!加.正常) { 运行时错误(4); }
}

//     ① 多压（Δ>1）：残留破坏后续「相对栈顶」消费——88-a 实参位短路旧实现
//        净 +3 即此形态，症状却是远端 `[ir2] 调用被调对象非函数名/方法`
//        （契约违反表现为下游症状，定位跨三层）；88-b 实证另一例：浮点字面量
//        漏分派（操作数缺失退化弹栈判定）净 +2——已随 89-a 根治。
//     ② 吞外层（Δ<0）：弹掉了调用方先序压栈值（调用实参求值中消失等）。
//   Rust 对照：rustc MIR validator / ICE——编译器不变量违反立刻报告，
//   不让错误产物进入下游（本校验把「下游症状」提前到「当场暴露」）。
//   调用纪律：生成表达式 唯一正常出口调用（错误路径 生成调用 返回 0 已诊断——
//   不校验，避免二次噪音）。性能：1 次函数调用 + 1 次减法 + 2 次比较（无分配；
//   出口深度顺带回传省一次 大小()）——实测编译 v2 树与基线差异在噪声内
//   （plans/020 本轮量化）。
// 返回出口栈深度（调用方据此取栈顶/判空——省重复 大小() 调用）。

// 1016（五轮审查 P1-2）：纯负号链折叠生成——[字面量, 负号×N]（后缀序）链先
//   算符号（奇数层负），文本=十进制化后加符号；最终值 ≤int64 → IR_常量整数；
//   否则 128 位双半物化（超 2^127 负界/2^128 正位模式的形态由语义层判域
//   前置拒绝，本函数解析失败交回逐节点路径）。返回=0 非纯链/不可折叠
//   （调用方落逐节点求值——中间层可能溢出，故纯链必须走本路径）。
不安全 函数 折叠负号链生成1016(向量<节点> 池, 整32 根索引,
                             向量<IR指令>& 指令, 整64* 寄存器计数,
                             整64* 槽计数, 向量<整64>& 表达式栈) -> 整64 {
    如果 (根索引 <= 0 || 根索引 >= 整32(池.大小())) { 返回 0; }
    整64 层数1016 = 0;
    整64 游1016 = 整64(根索引);
    当 (游1016 > 0) {
        节点 节1016 = 池.元素(整32(游1016));
        如果 (节1016.类型 != 节点_负号) { 中断; }
        层数1016++;
        游1016 = 游1016 - 1;
    }
    如果 (层数1016 == 0) { 返回 0; }
    节点 叶1016 = 池.元素(整32(游1016));
    如果 (叶1016.类型 != 节点_整数字面量) { 返回 0; }
    字符串 原1016 = 字符串复制(驻留文本(整64(叶1016.文本)));
    字符串 折1016 = 原1016;
    如果 (层数1016 % 2 == 1) { 折1016 = 字符串复制("-" + 原1016); }
    可选<字符串> 十进1016查 = 字面量十进制文本(折1016);
    // 十进制化失败=词法已拒形态（上游已诊断）→ 可选无值显式跳过
    如果 (!十进1016查.有值) { 返回 0; }
    字符串 文1016 = 字符串复制(十进1016查.值);
    整64 起1016 = 0;
    如果 (字符串长度(文1016) > 0 && (整64(文1016[0]) & 255) == 45) { 起1016 = 1; }
    字符串 体1016 = 字符串子串(文1016, 整32(起1016),
                                整32(字符串长度(文1016) - 起1016));
    布尔 承641016 = 数文本不超上界(体1016, "9223372036854775807");
    如果 (起1016 == 1) {
        承641016 = 数文本不超上界(体1016, "9223372036854775808");
    }
    整64 寄存器1016 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    如果 (承641016) {
        // ≤int64 承载：交逐节点求值（产物类型码随操作数保持——本折叠仅
        //   解决 128 中间量溢出；承载内逐节点无溢出风险且语义零变化）
        寄存器计数[0] = 寄存器计数[0] - 1;
        返回 0;
    }
    整64 低1016 = 0;
    整64 高1016 = 0;
    // 1303 二期（882 处置①）：语义层判域已前置（超 128 域/非法文本形态不达
    //   此处——负无符号非零1016/535 域外判拒在语义期收口），十进制化成功后
    //   本解析必成功；失败=语义层与代码生成解析器不一致=编译器内部缺陷，
    //   报内部错误显形（主流程收尾 内部未登记数>0 中止产物·同 648 位非
    //   操作码先例），返回 0 保留逐节点回退控制流（收尾报在前·非静默错值）。
    //   行号传 0：发射期无源码行上下文（648 同款）。
    如果 (!解析128位初值文本(文1016, 低1016, 高1016)) {
        登记内部未登记("折叠负号链128解析", 文1016, 0);
        寄存器计数[0] = 寄存器计数[0] - 1;
        返回 0;
    }
    寄存器计数[0] = 寄存器计数[0] - 1;   // 释放预取寄存器（物化用槽·同 生成字面量）
    整64 句柄1016 = 物化字面量128位(低1016, 高1016, 指令, 寄存器计数, 槽计数);
    结果<空类型, 整32> 加句1016 = 表达式栈.追加(句柄1016);
    如果 (!加句1016.正常) { 运行时错误(4); }
    返回 句柄1016;
}
