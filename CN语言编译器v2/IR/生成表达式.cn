// CN 自举编译器 v2 · 生成表达式（千行拆分子模块，2026-09-08 用户裁决阶段目录包）
// 职责：表达式后缀求值（生成表达式）+ 左值地址生成（生成左值地址）——自
//   IR生成.cn 机械搬移；寄存器/引用参数/实参结构等权威表经 公开: 访问
//   函数（IR生成 主干）；模块路径=生成表达式（新键基）。
导入 容器::向量;
导入 语法;       // Token/AST 节点池（原 导入 语法分析，目录包名）
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 IR生成;     // 函数级变量类型权威表/重载决议/控制流辅助（同包幂等）
导入 生成表达式求值; // 调用族+下标族六函数（R3 拆分，单向依赖无循环）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）
// D1 行数整改 120-a：按族拆出 生成表达式运算.cn / 生成表达式字段.cn（纯重构零行为变更）

// 函数名作值的链接符号（宿主 funcFirstSigKey 语义=重载取**首个签名**）：值位
//   无实参可决议（决议函数符号 走调用位实参推导）——按签名表首候选合成签名键
//   （键基#参数串，与定义侧 初始化签名与返回字段 同公式）。
//   查序：纯名键基 -> 当前模块键基合成；无签名登记（内置/运行时/无参老式名）
//   =纯名回退（符号修饰 天然处理）。
函数 函数值符号480(整64 名ID) -> 整64 {
    整64 键480 = 名ID;
    布尔 有签480 = 假;   // 候选数提取（结果 流敏感检查惯例；计数登记恒 ≥1）
    结果<整64, 整32> 查数480 = 查函数签名个数(键480);
    如果 (查数480.正常) { 有签480 = 查数480.值 > 0; }
    如果 (!有签480) {
        整64 键2 = 键基合成(取当前模块路径(), 名ID);
        如果 (键2 != 键480) {
            结果<整64, 整32> 查数2 = 查函数签名个数(键2);
            如果 (查数2.正常) { 有签480 = 查数2.值 > 0; }
        }
    }
    如果 (有签480) {
        结果<整64, 整32> 串查480 = 查函数签名参数串(键480 * 键位移);
        如果 (串查480.正常) {
            // 943（工单Ⅰ）：值位经统一链接键（克隆分支同口径）
            整64 键值480 = 统一链接键(键480, 名ID, 驻留文本(串查480.值));
            如果 (键值480 != 0) { 返回 键值480; }
        }
    }
    返回 名ID;
}

// ==================== T69（480-a 深度机）函数指针值位收口 ====================
// 函数名作值：生成标识符加载 的兜底把未命中变量/参数/静态/常量的标识符压成
//   「0-名ID」负占位（供 生成调用 识别被调=直接调用）。该形态落在**值位**
//   （实参/初值/赋值右值/返回）时须还原为函数地址（宿主 ir_expr.cpp:245-256
//   标识符非变量→FuncAddr 同构）。
//   本函数=消费侧单点收口（负值→IR_函数地址 新寄存器；非负值原样直通）：
//   被调位（生成调用 弹被调）不经此处=直接调用语义不变（零性能影响）。
不安全 函数 值位函数名收口480(整64 值, 向量<IR指令>& 指令, 整64* 寄存器计数) -> 整64 {
    如果 (值 >= 0) { 返回 值; }
    整64 寄存器480 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_函数地址, 0, 0, 0, 寄存器480, T_整64,
                         函数值符号480(0 - 值)));
    登记寄存器类型(寄存器480, T_整64);
    返回 寄存器480;
}

// 实参弹出们 值位收口（原地替换负占位——实参顺序不变，就地改写向量元素）
函数 实参负占位收口480(向量<IR指令>& 指令, 整64* 寄存器计数,
                     向量<整64>& 弹出们) -> 空类型 {
    整64 i480 = 0;
    当 (i480 < 弹出们.大小()) {
        整64 值480 = 弹出们.元素(i480);
        如果 (值480 < 0) {
            整64 新值480 = 值位函数名收口480(值480, 指令, 寄存器计数);
            结果<空类型, 整32> 设480 = 弹出们.设置(i480, 新值480);
            如果 (!设480.正常) { 运行时错误(4); }
        }
        i480++;
    }
}

// ==================== 表达式求值辅助（R3 千行函数拆分，2026-09-08） ====================
// 以下 5 个辅助函数自 生成表达式 主函数同体提取（逐字节等价变换：逻辑原样，
//   唯一改动=局部副本化与出口改返回）。纪律：容器出参一律 引用&（成熟形态），
//   容器按值返回/嵌套容器静态追加禁用（lessons 15 枚句柄悬垂同族）。

// 预扫描 前缀一元（取地址/负号/逻辑非/解引用）子区间——其操作数不单独生成
//   （避免重复指令；130 负下标缺陷家族）。平铺区间对 [起,终,...] 经出参返回。
// 894-a（070·G-N 特性波3）：预扫描自增表达式位左值区间（[子起点,子终点)）
//   ——主遍历跳过（左值由 生成自增表达式 统一取址读写，避免主循环把左值
//   标识符/成员先求值压栈=栈错位），与 取地址/短路/三元 区间同款机制。
函数 收集自增区间(向量<节点> 池, 整32 起点, 整32 终点, 向量<整64>& 区间们) -> 空类型 {
    整32 预扫 = 起点;
    当 (预扫 < 终点) {
        节点 预节点 = 池.元素(预扫);
        如果 (预节点.类型 == 节点_自增表达式 &&
             预节点.子起点 < 预节点.子终点) {
            结果<空类型, 整32> 加区 = 区间们.追加(整64(预节点.子起点));
            如果 (!加区.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加区2 = 区间们.追加(整64(预节点.子终点));
            如果 (!加区2.正常) { 运行时错误(4); }
        }
        预扫++;
    }
}

函数 收集取址区间(向量<节点> 池, 整32 起点, 整32 终点, 向量<整64>& 区间们) -> 空类型 {
    整32 预扫 = 起点;
    当 (预扫 < 终点) {
        节点 预节点 = 池.元素(预扫);
        // 414 P0-3：位非入列（原解析期脱糖树中无 位非 节点·下沉后须与
        //   负号/逻辑非 同款登记操作数子区间——缺登记=主循环先压操作数、
        //   生成一元运算 内部再求值再压=净栈多压（709 实测））
        如果 (预节点.类型 == 节点_取地址 || 预节点.类型 == 节点_负号 ||
             预节点.类型 == 节点_逻辑非 || 预节点.类型 == 节点_位非 ||
             预节点.类型 == 节点_解引用) {
            如果 (预节点.子起点 < 预节点.子终点) {
                结果<空类型, 整32> 加区 = 区间们.追加(整64(预节点.子起点));
                如果 (!加区.正常) { 运行时错误(4); }
                结果<空类型, 整32> 加区2 = 区间们.追加(整64(预节点.子终点));
                如果 (!加区2.正常) { 运行时错误(4); }
            }
        }
        预扫++;
    }
}

// 84-a：预扫描 结构体字面量构造 的**值区间**（[构造.子起点, 构造.子终点) 含
//   值表达式与字段初值节点）——主遍历跳过（由 结构体构造 节点统一求值，
//   避免值表达式被主循环重复求值=副作用/多次分配）；跳过终点恰为构造节点位置。
// 84-c：**只保留最外层**构造区间——嵌套字面量（`外盒{ 内 = 内盒{ 名 = 串 } }`）的
//   内层构造区间被外层包含；若内层区间也入表，主遍历在共享起点处取「第一个匹配」
//   （=内层，区间更短）→ 先处理内层构造（**第一次求值**），外层生成函数求值字段值时
//   再求值一次 → 内层字面量被求值两次（其一分配泄漏；探针 P26② 实证：两次
//   __cn_str_copy、仅一次 __cn_str_free、残留 1）。过滤=两两包含判定剔除内层。
函数 收集构造区间(向量<节点> 池, 整32 起点, 整32 终点, 向量<整64>& 区间们) -> 空类型 {
    向量<整64> 候选们 = 向量<整64>();
    整32 预扫 = 起点;
    当 (预扫 < 终点) {
        节点 预节点 = 池.元素(预扫);
        如果 (预节点.类型 == 节点_结构体构造) {
            如果 (预节点.子起点 < 预节点.子终点) {
                结果<空类型, 整32> 加区 = 候选们.追加(整64(预节点.子起点));
                如果 (!加区.正常) { 运行时错误(4); }
                结果<空类型, 整32> 加区2 = 候选们.追加(整64(预节点.子终点));
                如果 (!加区2.正常) { 运行时错误(4); }
            }
        }
        预扫++;
    }
    整64 i = 0;
    当 (i < 候选们.大小()) {
        整64 起i = 候选们.元素(i);
        整64 终i = 候选们.元素(i + 1);
        布尔 被包含 = 假;
        整64 j = 0;
        当 (j < 候选们.大小()) {
            如果 (j != i) {
                整64 起j = 候选们.元素(j);
                整64 终j = 候选们.元素(j + 1);
                如果 (起j <= 起i && 终i <= 终j && (起j < 起i || 终i < 终j)) { 被包含 = 真; }
            }
            j += 2;
        }
        如果 (!被包含) {
            结果<空类型, 整32> 加区o = 区间们.追加(起i);
            如果 (!加区o.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加区o2 = 区间们.追加(终i);
            如果 (!加区o2.正常) { 运行时错误(4); }
        }
        i += 2;
    }
}

// 862（任务 215 甲裁决实施·打印族流式化）：预扫描打印族调用——被调归一基名
//   ∈{打印,打印行} 时逐实参子区间登记 [前末位+1, 实参末位+1)（半开·与区间终点
//   判定对齐），主遍历跳过、调用节点处流式分派（逐参求值→打印调用交替·宿主
//   流式同款）。末位表缺失/边界异常形态不登记＝兜底走 生成调用 原路径（批式
//   行为不变）。打印实参树内不可能嵌套内层打印（void 语义层拒绝），区间要么
//   嵌套要么不相交（树结构）——主遍历判定置于其他区间之前即可安全共存。
函数 收集打印调用区间(向量<节点> 池, 整32 起点, 整32 终点, 向量<整64>& 区间们) -> 空类型 {
    整32 预扫 = 起点;
    当 (预扫 < 终点) {
        节点 预节点 = 池.元素(预扫);
        如果 (预节点.类型 == 节点_调用) {
            向量<整64> 实参终点们 = 向量<整64>();
            如果 (打印族实参终点们(池, 预节点, 整64(预扫), 实参终点们)) {
                整64 区间起 = 整64(预节点.子起点) + 1;
                整64 参i = 0;
                当 (参i < 实参终点们.大小()) {
                    整64 区间终 = 实参终点们.元素(参i) + 1;
                    结果<空类型, 整32> 加起 = 区间们.追加(区间起);
                    如果 (!加起.正常) { 运行时错误(4); }
                    结果<空类型, 整32> 加终 = 区间们.追加(区间终);
                    如果 (!加终.正常) { 运行时错误(4); }
                    区间起 = 区间终;
                    参i++;
                }
            }
        }
        预扫++;
    }
}

// 862：打印族判定+逐实参末位收集——收集器与流式分派共用单一事实源。
//   返回 真=打印族且末位表完整（实参终点们=逐参末位·闭区间右端）；假=非打印
//   族或 查调用实参末位 缺失/边界异常（调用方按原路径兜底）。
函数 打印族实参终点们(向量<节点> 池, 节点 n, 整64 调用位置, 向量<整64>& 实参终点们) -> 布尔 {
    如果 (n.子起点 <= 0 || n.附加 <= 0) { 返回 假; }
    节点 被调节点 = 池.元素(整32(n.子起点));
    如果 (被调节点.类型 != 节点_标识符) { 返回 假; }
    字符串 被调名 = 字符串复制(驻留文本(整64(被调节点.文本)));
    字符串 打印名 = 内置归一基名(被调名);
    如果 (!字符串比较(打印名, "打印") && !字符串比较(打印名, "打印行")) { 返回 假; }
    整64 前末位 = 整64(n.子起点);
    整64 参k = 0;
    当 (参k < n.附加) {
        整64 末位k = 查调用实参末位(调用位置, 参k);
        如果 (末位k < 0 || 末位k <= 前末位 || 末位k >= 调用位置) { 返回 假; }
        结果<空类型, 整32> 加末 = 实参终点们.追加(末位k);
        如果 (!加末.正常) { 运行时错误(4); }
        前末位 = 末位k;
        参k++;
    }
    返回 真;
}

// 预扫描 短路运算符（&&/||）操作数区间（语法层标注：附加=右起点）——主遍历
//   跳过，运算符节点处延迟求值。三元平铺 [起,中,终,...]（检查用起/终两元）。
函数 收集短路区间(向量<节点> 池, 整32 起点, 整32 终点, 向量<整64>& 区间们) -> 空类型 {
    整32 预扫 = 起点;
    当 (预扫 < 终点) {
        节点 预节点 = 池.元素(预扫);
        如果 (预节点.类型 == 节点_二元运算 && 预节点.子终点 != 0) {
            字符串 op名 = 字符串复制(驻留文本(整64(预节点.文本)));
            如果 (字符串比较(op名, "&&") || 字符串比较(op名, "||")) {
                结果<空类型, 整32> 加逻 = 区间们.追加(整64(预节点.子起点));
                如果 (!加逻.正常) { 运行时错误(4); }
                结果<空类型, 整32> 加逻2 = 区间们.追加(预节点.附加);
                如果 (!加逻2.正常) { 运行时错误(4); }
                结果<空类型, 整32> 加逻3 = 区间们.追加(整64(预节点.子终点));
                如果 (!加逻3.正常) { 运行时错误(4); }
            }
        }
        预扫++;
    }
}

// 预扫描 三元运算三段区间（[子起点, 子终点) 全跳——条件/真值/假值延迟到三元
//   节点处惰性生成：仅选中分支求值，规范 01b 5.8）。平铺区间对 [起,终,...]。
函数 收集三元区间(向量<节点> 池, 整32 起点, 整32 终点, 向量<整64>& 区间们) -> 空类型 {
    整32 预扫 = 起点;
    当 (预扫 < 终点) {
        节点 预节点 = 池.元素(预扫);
        如果 (预节点.类型 == 节点_三元运算) {
            结果<空类型, 整32> 加三 = 区间们.追加(整64(预节点.子起点));
            如果 (!加三.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加三2 = 区间们.追加(整64(预节点.子终点));
            如果 (!加三2.正常) { 运行时错误(4); }
        }
        预扫++;
    }
}

// 296-a（D35 波B·2026-09-17）：预扫描 错误传播操作数区间（[子起点, 子终点)
//   全跳——操作数延迟到 节点_错误传播 处统一生成：含条件跳转分块与 err 块
//   构造返回）。布局与 收集三元区间 同构（错误传播节点亦居区间末位）。
函数 收集错误传播区间(向量<节点> 池, 整32 起点, 整32 终点, 向量<整64>& 区间们) -> 空类型 {
    整32 预扫e = 起点;
    当 (预扫e < 终点) {
        节点 预节点e = 池.元素(预扫e);
        如果 (预节点e.类型 == 节点_错误传播) {
            结果<空类型, 整32> 加传 = 区间们.追加(整64(预节点e.子起点));
            如果 (!加传.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加传2 = 区间们.追加(整64(预节点e.子终点));
            如果 (!加传2.正常) { 运行时错误(4); }
        }
        预扫e++;
    }
}

// 位置 是否落在平铺区间们内（步长=每组元素数：取址/三元=2、短路=3）。
//   命中返回该组终点（主循环跳到），未命中返回 -1。
函数 区间终点(向量<整64>& 区间们, 整32 位置, 整64 步长) -> 整64 {
    整64 i = 0;
    当 (i < 区间们.大小()) {
        整64 起 = 区间们.元素(i);
        整64 终 = 区间们.元素(i + 步长 - 1);
        如果 (整64(位置) >= 起 && 整64(位置) < 终) {
            返回 终;
        }
        i += 步长;
    }
    返回 0 - 1;
}

// 字面量节点（整/布尔/字符串）发射常量寄存器并入栈，返回 压栈寄存器。
// 265-a 波A：整字面量位宽判定（纯长度保守法）——含负号总长 ≤10 恒适配
//   T_整32（宿主 C 语义字面量缺省 int）；长度 ≥11 保守 T_整64。
//   配套=公共整型提升（二元面位宽大者胜）——263-a 回归根因是「取左保持窄」
//   误截断非移位算术，波A 以提升规则正确化（380 校验和=最强哨兵）。
// 565 轮（T33 残余根治·配套修正）：改**值域判定**——原「纯长度保守法」≤10 位
//   恒真把 4000000000〔10 位·超 int32 上界 2147483647〕也登记 T_整32，违反
//   「T_整32 登记=值合 int32 域」寄存器类型契约（h1/h5 实锤：槽存原值
//   4000000000·宿主 -294967296 回绕）；超域字面量改 T_整64（同符号宽化放行
//   §混符规则）→窄宽值规范化/正32存储截断 各存储点按码正确回绕；位数 >10=
//   必然越界恒 假（不再解析防 整64 溢出）。
函数 字面量适配整32(字符串 文本) -> 布尔 {
    整64 长度 = 字符串长度(文本);
    如果 (长度 <= 0 || 长度 > 10) { 返回 假; }
    整64 值 = 0;
    整64 i = 0;
    当 (i < 长度) {
        整64 字节b = 字节值(文本, i);
        如果 (字节b < 48 || 字节b > 57) { 返回 假; }
        值 = 值 * 10 + (字节b - 48);
        i++;
    }
    返回 值 <= 2147483647;
}

// 728s：整数字面量文本后缀 → 类型名ID（宿主 literalTypeOf 同构；语义层
//   字面量后缀类型ID（语义检查字面量域.cn）的 IR 侧同名判据副本——IR 包禁
//   导入语义〔334 单向依赖〕故单点复制，后缀集合恒同步改双处；溢出检查码
//   自码474 与 代码生成共用 的同判据副本先例同款）。
//   L→整64／LL→整128／U→正32／UL→正64／ULL→正128；无后缀/非法组合=0
//   （调用方维持既有值域分派/无后缀契约）。0x/0b/0o 前缀无碍（F 不属后缀集）。
函数 字面量后缀类型名ID(字符串 字面文本) -> 整64 {
    字符串 后缀 = "";
    整64 尾 = 字符串长度(字面文本);
    当 (尾 > 0) {
        整64 字节 = 整64(字面文本[尾 - 1]) & 255;
        如果 (字节 == 76 || 字节 == 108) {          // 'L'/'l'
            后缀 = 字符串复制("L" + 后缀);
        } 否则 如果 (字节 == 85 || 字节 == 117) {   // 'U'/'u'
            后缀 = 字符串复制("U" + 后缀);
        } 否则 {
            中断;
        }
        尾 = 尾 - 1;
    }
    如果 (字符串比较(后缀, "L")) { 返回 驻留("整64"); }
    如果 (字符串比较(后缀, "LL")) { 返回 驻留("整128"); }
    如果 (字符串比较(后缀, "U")) { 返回 驻留("正32"); }
    如果 (字符串比较(后缀, "UL")) { 返回 驻留("正64"); }
    如果 (字符串比较(后缀, "ULL")) { 返回 驻留("正128"); }
    返回 0;
}

// 728s：字面量源码类型（生成表达式运算 377 段消费）——后缀定级名ID ∪ 无后缀
//   T_整32 哨兵（既有契约：检查码 474 经哨兵 fallback 寄存器码）。取根文本=
//   字面量节点自身或负号操作数。修复前带后缀字面量恒 T_整32 哨兵 → 检查码
//   474 走寄存器码 fallback（T_整32 值域分派）与无符号语义分叉；后缀定级后
//   名ID 使 检查码自类型名ID 直取 T_正32/T_整64 等（`2147483647U+1U` 检查域
//   =正32·宿主同口径）。
函数 字面量源码类型377(向量<节点> 池, 节点 末端) -> 整64 {
    整64 名IDl = 0;
    如果 (末端.类型 == 节点_整数字面量) { 名IDl = 整64(末端.文本); }
    否则 如果 (末端.类型 == 节点_负号 && 末端.子起点 > 0 &&
              末端.子起点 < 整32(池.大小()) &&
              池.元素(整32(末端.子起点)).类型 == 节点_整数字面量) {
        名IDl = 整64(池.元素(整32(末端.子起点)).文本);
    }
    如果 (名IDl != 0) {
        整64 后缀名 = 字面量后缀类型名ID(驻留文本(名IDl));
        如果 (后缀名 > 0) { 返回 后缀名; }
    }
    返回 T_整32;   // 无后缀/非法组合=既有哨兵（285 语义面同口径）
}

// 1068（910 邻接·遗留收口）：整数字面量运行期类型（数学值域提升链）——宿主
//   types::integerLiteralRuntimeType 的 v2 对称物（判定单一真源·双侧同口径；
//   910 五面已收口本判据，本函数补回绕内置实参位面）。输入=字面量文本（v2
//   负号=独立节点，经 负号 标志并入数学值）+负号标志；输出=类型名ID
//   （整32/整64/整128/正32/正64/正128）。
//   链：基型=后缀定级（字面量后缀类型名ID·无后缀/非法组合=整32 恒定级）；
//   无后缀/整64 超 int32 双域→整64、超 int64 双域→整128；正32 超 u32→
//   正64、超 u64→正128；正64 超 u64→正128；LL/ULL 恒定级 128。判定素材=
//   字面量文本入域/字面量文本入域128_640（910 既有单点·与宿主 decTextFits*
//   同口径·含进制面位数分档——0x8000000000000000 归一按数学值判超 int64）。
//   超 128 界（或超 u128）→ 返回定级 128 类型（物化面 字面量超128域 / 语义
//   诊断承接拒绝——宿主 st910 返回可诊断定级类型同语义）。
函数 字面量运行期类型1068(字符串 文本1068, 布尔 负号1068) -> 整64 {
    整64 基型1068 = 字面量后缀类型名ID(文本1068);
    如果 (基型1068 == 0) { 基型1068 = 驻留("整32"); }
    如果 (基型1068 == 驻留("整32")) {
        如果 (字面量文本入域(文本1068, "整32", 负号1068)) { 返回 驻留("整32"); }
        如果 (字面量文本入域(文本1068, "整64", 负号1068)) { 返回 驻留("整64"); }
        返回 驻留("整128");
    }
    如果 (基型1068 == 驻留("整64")) {
        如果 (字面量文本入域(文本1068, "整64", 负号1068)) { 返回 驻留("整64"); }
        返回 驻留("整128");
    }
    如果 (基型1068 == 驻留("正32")) {
        如果 (字面量文本入域(文本1068, "正32", 负号1068)) { 返回 驻留("正32"); }
        如果 (字面量文本入域(文本1068, "正64", 负号1068)) { 返回 驻留("正64"); }
        返回 驻留("正128");
    }
    如果 (基型1068 == 驻留("正64")) {
        如果 (字面量文本入域(文本1068, "正64", 负号1068)) { 返回 驻留("正64"); }
        返回 驻留("正128");
    }
    如果 (基型1068 == 驻留("整128")) { 返回 驻留("整128"); }
    返回 驻留("正128");
}

不安全 函数 生成字面量(节点 n, 向量<IR指令>& 指令, 整64* 寄存器计数,
                  整64* 槽计数, 向量<整64>& 表达式栈) -> 整64 {
    整64 寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    如果 (n.类型 == 节点_整数字面量) {
        // 814（053-001）：**大字面量 128 位物化**（规范 218「超出 整64 域的无
        //   后缀字面量按提升链归 整128」）——解析128位初值文本 拆半，高半
        //   非低半符号扩展（超 整64 域）→ 2 槽物化+句柄登记 T_整128（值=地址
        //   语义·一切 128 位消费点直用；原落 IR_常量整数 发射层 movabs 截断
        //   ——高半丢失·s2 探针 2^64+1+1 出 2 实证）。域内字面量保持原路径。
        字符串 字面文本 = 字符串复制(驻留文本(整64(n.文本)));
        整64 拆低 = 0;
        整64 拆高 = 0;
        布尔 超64域 = 假;
        // 818（064）：超 整128 域先判拒（宿主 parse 判据同构·诊断文案对齐）
        // 1016（五轮审查 P1-2）：正字面量 2^127..2^128-1 允许 128 位位模式
        //   物化（负号链中间量：-(-(-2^127)) 外层 __cn_neg_i128 取负得合法值；
        //   直接使用形态由语义层 535/隐式转换前置于域拒）。原一律按整128
        //   有符号正域拒 → 合法纯负号链表达式误拒。
        布尔 超128有符号域 = 字面量超128域(字面文本);
        布尔 位模式可物化 = 超128有符号域 && 字面量在128位承载(字面文本);
        如果 (超128有符号域 && !位模式可物化) {
            IR层诊断("整数字面量超出整128（2^127-1）范围: " + 字面文本);
        } 否则 如果 (解析128位初值文本(字面文本, 拆低, 拆高)) {
            整64 预期高 = 0;
            如果 (拆低 < 0) { 预期高 = 0 - 1; }
            如果 (拆高 != 预期高) { 超64域 = 真; }
            // 位模式中间量（2^127..2^128-1）恒超 64 位承载 → 强制 128 物化
            如果 (位模式可物化) { 超64域 = 真; }
        }
        // 728s：后缀类型名（L/U/UL 64 位族定级用；**LL/ULL 值域内不物化**——
        //   恒 128 物化会令小值 LL 字面量走 128 句柄通道，而 64 位消费点
        //   （整数转字符串/打印等）不认句柄（856 第3行 -5LL<<40 句柄垃圾值
        //   实证）；128 位语义（移位量域/超域拦截）由语义层 字面量后缀位宽474
        //   通道承载〈502 P1-2 既有·856 绿锚〉。LL/ULL 小值完整 128 物化=
        //   128 通道消费点扩展面（呈报立案））。
        整64 后缀名728 = 字面量后缀类型名ID(字面文本);
        如果 (超64域) {
            寄存器计数[0] = 寄存器计数[0] - 1;   // 释放上方预取寄存器（物化用槽）
            整64 大字句柄 = 物化字面量128位(拆低, 拆高, 指令, 寄存器计数, 槽计数);
            结果<空类型, 整32> 加大字 = 表达式栈.追加(大字句柄);
            如果 (!加大字.正常) { 运行时错误(4); }
            返回 大字句柄;
        }
        // 常量整数：操作数1=Symbol ID（文本），类型=按值域分流
        整64 字面量码 = T_整64;
        如果 (字面量适配整32(驻留文本(整64(n.文本)))) { 字面量码 = T_整32; }
        // 728s：64 位族后缀定级覆盖值域分派（宿主 literalTypeOf 同构——无后缀
        //   才按值域分流；LL/ULL 已由上方物化分支收口）——`1U`=T_正32（无符号
        //   除法/移位/比较分派与打印面全链正确）、`1L`=T_整64、`1UL`=T_正64。
        如果 (后缀名728 == 驻留("整64")) { 字面量码 = T_整64; }
        否则 如果 (后缀名728 == 驻留("正32")) { 字面量码 = T_正32; }
        否则 如果 (后缀名728 == 驻留("正64")) { 字面量码 = T_正64; }
        IR追加(指令, 建IR指令(IR_常量整数, 整64(n.文本), 0, 0, 寄存器, 字面量码, 0));
        登记寄存器类型(寄存器, 字面量码);
    } 否则 如果 (n.类型 == 节点_布尔字面量) {
        // 灰色点①根治（2026-09-04）：真/假 独立节点——常量 1/0 登记 T_布尔
        //   （打印分派 __cn_print_bool 输出 真/假、拼接 from_bool 自动分派）
        IR追加(指令, 建IR指令(IR_常量整数, 整64(n.文本), 0, 0, 寄存器, T_布尔, 0));
        登记寄存器类型(寄存器, T_布尔);
    } 否则 如果 (n.类型 == 节点_字符字面量) {
        // 95-a（2026-09-13 第九十五轮）：字符字面量——文本=Unicode 码点数字ID
        //   （词法层解码）→ IR_常量整数 + T_字符 登记（打印分派按数值输出 ASCII/
        //   码点，与宿主 字符=i32 存储 + 打印整数语义同构；规范 01b 三）
        IR追加(指令, 建IR指令(IR_常量整数, 整64(n.文本), 0, 0, 寄存器, T_字符, 0));
        登记寄存器类型(寄存器, T_字符);
    } 否则 如果 (n.类型 == 节点_浮点字面量) {
        // 89-a（2026-09-12 第八十九轮）：浮点字面量（浮64）——IR_常量浮点
        //   （操作数1=文本 Symbol ID；代码生成侧经 浮点文本净 剥 L/U 尾缀后
        //   .double/REAL8 文本直通发射——IEEE754 位模式由汇编器解析，编译期
        //   零开销）+ T_浮64 登记（打印分派/拼接消费）。
        //   缺陷背景（88-b 出口校验探针实证）：原实现主循环无此分派 + 本函数
        //   无此分支 → 浮点字面量被**静默跳过**——二元弹栈判定退化（操作数
        //   缺失 → 左右均取寄存器 0 → `cmp x,x` 恒真）、净栈 +2 契约违反、
        //   静态浮点初值注入落空（87-a 注入经 生成表达式 求值）。E2E 246 原
        //   「巧合通过」=双重侥幸，宿主同形态正确。
        IR追加(指令, 建IR指令(IR_常量浮点, 整64(n.文本), 0, 0, 寄存器, T_浮64, 0));
        登记寄存器类型(寄存器, T_浮64);
        // 352/04_types（070 波I·1026 深度机）：浮32 字面量——f/F 尾缀分型 →
        //   IR_类型转换(浮64→浮32)（后端 cvtsd2ss·单精度位型 4B 有效）——
        //   原 .double 位型 8B 装载·浮32 变量槽 4B 取低 32=0（2.5f→0.000000
        //   04_types/352/406 域实录）——转换寄存器压栈（登记 T_浮32）
        {
            字符串 浮文本i = 字符串复制(驻留文本(整64(n.文本)));
            整64 浮长i = 字符串长度(浮文本i);
            如果 (浮长i > 0) {
                整64 尾i = 整64(浮文本i[浮长i - 1]) & 255;
                如果 (尾i == 102 || 尾i == 70) {
                    寄存器 = 插入值转换(寄存器, T_浮32, 指令, 寄存器计数);
                }
            }
        }
    } 否则 {
        // P7b 字符串字面量：IR_常量字符串（操作数1=驻留文本ID）——代码生成
        //   发射 .code 段内 strData_<ID> 数据标签地址
        IR追加(指令, 建IR指令(IR_常量字符串, 整64(n.文本), 0, 0, 寄存器, T_字符串, 0));
        登记寄存器类型(寄存器, T_字符串);
    }
    结果<空类型, 整32> 加 = 表达式栈.追加(寄存器);
    如果 (!加.正常) { 运行时错误(4); }
    返回 寄存器;
}

// 标识符加载：参数槽 优先，其次 局部槽；未命中查 顶层常量（内联 IR_常量整数）/
//   顶层静态（IR_静态加载）/函数名兜底（压负数符号）；引用参数按类型分流
//   （发射引用参数读）。全部出口等价消费 1 个位置（主循环统一 位置++）。
不安全 函数 生成标识符加载(节点 n, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                   向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数,
                   向量<整64>& 表达式栈) -> 空类型 {
    整64 槽 = 0;
    结果<整64, 整32> 找参 = 参数槽.获取(整64(n.文本));
    如果 (找参.正常) { 槽 = 找参.值; } 否则 { }
    如果 (槽 == 0) {
        结果<整64, 整32> 找局 = 局部槽.获取(整64(n.文本));
        如果 (找局.正常) { 槽 = 找局.值; } 否则 { }
    }
    如果 (槽 == 0) {
        // 第七十八轮（2026-09-12）：方法体 this 引用——「自身」标识符（宿主
        //   方法体参数名同款）→ this 槽加载（对象指针；自身.方法() 调用链/
        //   自身作实参均经此出口）
        如果 (当前方法类名ID != 0 && 整64(n.文本) == 整64(驻留("自身"))) {
            整64 自寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 当前方法this槽, 0, 0, 自寄存器,
                                 T_对象, 0));
            结果<空类型, 整32> 加自 = 表达式栈.追加(自寄存器);
            如果 (!加自.正常) { 运行时错误(4); }
            返回;
        }
        // 328（2026-10-09·002·21）：「父类」标识符（基类限定调用对象位·规格06）
        //   → this 槽加载（与 自身 同出口——基类方法对子类对象安全=布局前缀
        //   同构〔278〕；父类.方法() 经 发射用户类方法调用 走基类符号静态直调·
        //   虚槽旁路由 328 尾参配套；查类基名!=0 守卫=无基类类不劫持同名标识符）
        如果 (当前方法类名ID != 0 && 整64(n.文本) == 整64(驻留("父类")) &&
             查类基名(当前方法类名ID) != 0) {
            整64 父寄存器328 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 当前方法this槽, 0, 0, 父寄存器328,
                                 T_对象, 0));
            结果<空类型, 整32> 加父328 = 表达式栈.追加(父寄存器328);
            如果 (!加父328.正常) { 运行时错误(4); }
            返回;
        }
        // 第七十八轮（2026-09-12）：方法体字段分派——类方法内字段名裸标识符
        //   （局部/参数槽未命中后）→ this 槽加载 + 字段地址 + 指针加载（类区间
        //   字段；当前方法上下文由 生成类.生成方法 设置——非方法体恒 miss）
        // #1310 复审 P0-A/B：静态方法无 this——实例字段裸名不参与解析（宿主
        //   isInstanceField 在静态方法恒假同口径），回落常量/静态段。
        如果 (!当前方法静态标记) {
            整64 字段偏移g = 当前方法字段偏移(整64(n.文本));
            如果 (字段偏移g >= 0) {
