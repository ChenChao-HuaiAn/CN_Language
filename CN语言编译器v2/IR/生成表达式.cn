// CN 自举编译器 v2 · 生成表达式（千行拆分子模块，2026-09-08 用户裁决阶段目录包）
// 职责：表达式后缀求值（生成表达式）+ 左值地址生成（生成左值地址）——自
//   IR生成.cn 机械搬移；寄存器/引用参数/实参结构等权威表经 公开: 访问
//   函数（IR生成 主干）；模块路径=生成表达式（新键基）。
导入 容器::向量;
导入 语法;       // Token/AST 节点池（原 导入 语法分析，目录包名）
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码（目录包名）
导入 IR生成;     // 函数级变量类型权威表/重载决议/控制流辅助（同包幂等）
导入 生成表达式求值; // 调用族+下标族六函数（R3 拆分，单向依赖无循环）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）
// D1 行数整改 120-a：按族拆出 生成表达式运算.cn / 生成表达式字段.cn（纯重构零行为变更）

// 函数名作值的链接符号（宿主 funcFirstSigKey 语义=重载取**首个签名**）：值位
//   无实参可决议（决议函数符号 走调用位实参推导）——按签名表首候选合成签名键
//   （键基#参数串，与定义侧 初始化签名与返回字段 同公式）。
//   查序：纯名键基 -> 当前模块键基合成；无签名登记（内置/运行时/无参老式名）
//   =纯名回退（符号修饰 天然处理）。
函数 函数值符号480(整64 名ID) -> 整64 {
    整64 键480 = 名ID;
    如果 (查函数签名个数(键480) <= 0) {
        整64 键2 = 键基合成(取当前模块路径(), 名ID);
        如果 (键2 != 键480 && 查函数签名个数(键2) > 0) { 键480 = 键2; }
    }
    如果 (查函数签名个数(键480) > 0) {
        整64 串480 = 查函数签名参数串(键480 * 键位移);
        如果 (串480 >= 0) {
            // 943（工单Ⅰ）：值位经统一链接键（克隆分支同口径）
            整64 键值480 = 统一链接键(键480, 名ID, 驻留文本(串480));
            如果 (键值480 != 0) { 返回 键值480; }
        }
    }
    返回 名ID;
}

// ==================== T69（480-a 深度机）函数指针值位收口 ====================
// 函数名作值：生成标识符加载 的兜底把未命中变量/参数/静态/常量的标识符压成
//   「0-名ID」负占位（供 生成调用 识别被调=直接调用）。该形态落在**值位**
//   （实参/初值/赋值右值/返回）时须还原为函数地址（宿主 ir_expr.cpp:245-256
//   标识符非变量→FuncAddr 同构）。
//   本函数=消费侧单点收口（负值→IR_函数地址 新寄存器；非负值原样直通）：
//   被调位（生成调用 弹被调）不经此处=直接调用语义不变（零性能影响）。
不安全 函数 值位函数名收口480(整64 值, 向量<IR指令>& 指令, 整64* 寄存器计数) -> 整64 {
    如果 (值 >= 0) { 返回 值; }
    整64 寄存器480 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_函数地址, 0, 0, 0, 寄存器480, T_整64,
                         函数值符号480(0 - 值)));
    登记寄存器类型(寄存器480, T_整64);
    返回 寄存器480;
}

// 实参弹出们 值位收口（原地替换负占位——实参顺序不变，就地改写向量元素）
函数 实参负占位收口480(向量<IR指令>& 指令, 整64* 寄存器计数,
                     向量<整64>& 弹出们) -> 空类型 {
    整64 i480 = 0;
    当 (i480 < 弹出们.大小()) {
        整64 值480 = 弹出们.元素(i480);
        如果 (值480 < 0) {
            整64 新值480 = 值位函数名收口480(值480, 指令, 寄存器计数);
            结果<空类型, 整32> 设480 = 弹出们.设置(i480, 新值480);
            如果 (!设480.正常) { 运行时错误(4); }
        }
        i480++;
    }
}

// ==================== 表达式求值辅助（R3 千行函数拆分，2026-09-08） ====================
// 以下 5 个辅助函数自 生成表达式 主函数同体提取（逐字节等价变换：逻辑原样，
//   唯一改动=局部副本化与出口改返回）。纪律：容器出参一律 引用&（成熟形态），
//   容器按值返回/嵌套容器静态追加禁用（lessons 15 枚句柄悬垂同族）。

// 预扫描 前缀一元（取地址/负号/逻辑非/解引用）子区间——其操作数不单独生成
//   （避免重复指令；130 负下标缺陷家族）。平铺区间对 [起,终,...] 经出参返回。
// 894-a（070·G-N 特性波3）：预扫描自增表达式位左值区间（[子起点,子终点)）
//   ——主遍历跳过（左值由 生成自增表达式 统一取址读写，避免主循环把左值
//   标识符/成员先求值压栈=栈错位），与 取地址/短路/三元 区间同款机制。
函数 收集自增区间(向量<节点> 池, 整32 起点, 整32 终点, 向量<整64>& 区间们) -> 空类型 {
    整32 预扫 = 起点;
    当 (预扫 < 终点) {
        节点 预节点 = 池.元素(预扫);
        如果 (预节点.类型 == 节点_自增表达式 &&
             预节点.子起点 < 预节点.子终点) {
            结果<空类型, 整32> 加区 = 区间们.追加(整64(预节点.子起点));
            如果 (!加区.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加区2 = 区间们.追加(整64(预节点.子终点));
            如果 (!加区2.正常) { 运行时错误(4); }
        }
        预扫++;
    }
}

函数 收集取址区间(向量<节点> 池, 整32 起点, 整32 终点, 向量<整64>& 区间们) -> 空类型 {
    整32 预扫 = 起点;
    当 (预扫 < 终点) {
        节点 预节点 = 池.元素(预扫);
        如果 (预节点.类型 == 节点_取地址 || 预节点.类型 == 节点_负号 ||
             预节点.类型 == 节点_逻辑非 || 预节点.类型 == 节点_解引用) {
            如果 (预节点.子起点 < 预节点.子终点) {
                结果<空类型, 整32> 加区 = 区间们.追加(整64(预节点.子起点));
                如果 (!加区.正常) { 运行时错误(4); }
                结果<空类型, 整32> 加区2 = 区间们.追加(整64(预节点.子终点));
                如果 (!加区2.正常) { 运行时错误(4); }
            }
        }
        预扫++;
    }
}

// 84-a：预扫描 结构体字面量构造 的**值区间**（[构造.子起点, 构造.子终点) 含
//   值表达式与字段初值节点）——主遍历跳过（由 结构体构造 节点统一求值，
//   避免值表达式被主循环重复求值=副作用/多次分配）；跳过终点恰为构造节点位置。
// 84-c：**只保留最外层**构造区间——嵌套字面量（`外盒{ 内 = 内盒{ 名 = 串 } }`）的
//   内层构造区间被外层包含；若内层区间也入表，主遍历在共享起点处取「第一个匹配」
//   （=内层，区间更短）→ 先处理内层构造（**第一次求值**），外层生成函数求值字段值时
//   再求值一次 → 内层字面量被求值两次（其一分配泄漏；探针 P26② 实证：两次
//   __cn_str_copy、仅一次 __cn_str_free、残留 1）。过滤=两两包含判定剔除内层。
函数 收集构造区间(向量<节点> 池, 整32 起点, 整32 终点, 向量<整64>& 区间们) -> 空类型 {
    向量<整64> 候选们 = 向量<整64>();
    整32 预扫 = 起点;
    当 (预扫 < 终点) {
        节点 预节点 = 池.元素(预扫);
        如果 (预节点.类型 == 节点_结构体构造) {
            如果 (预节点.子起点 < 预节点.子终点) {
                结果<空类型, 整32> 加区 = 候选们.追加(整64(预节点.子起点));
                如果 (!加区.正常) { 运行时错误(4); }
                结果<空类型, 整32> 加区2 = 候选们.追加(整64(预节点.子终点));
                如果 (!加区2.正常) { 运行时错误(4); }
            }
        }
        预扫++;
    }
    整64 i = 0;
    当 (i < 候选们.大小()) {
        整64 起i = 候选们.元素(i);
        整64 终i = 候选们.元素(i + 1);
        布尔 被包含 = 假;
        整64 j = 0;
        当 (j < 候选们.大小()) {
            如果 (j != i) {
                整64 起j = 候选们.元素(j);
                整64 终j = 候选们.元素(j + 1);
                如果 (起j <= 起i && 终i <= 终j && (起j < 起i || 终i < 终j)) { 被包含 = 真; }
            }
            j += 2;
        }
        如果 (!被包含) {
            结果<空类型, 整32> 加区o = 区间们.追加(起i);
            如果 (!加区o.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加区o2 = 区间们.追加(终i);
            如果 (!加区o2.正常) { 运行时错误(4); }
        }
        i += 2;
    }
}

// 862（任务 215 甲裁决实施·打印族流式化）：预扫描打印族调用——被调归一基名
//   ∈{打印,打印行} 时逐实参子区间登记 [前末位+1, 实参末位+1)（半开·与区间终点
//   判定对齐），主遍历跳过、调用节点处流式分派（逐参求值→打印调用交替·宿主
//   流式同款）。末位表缺失/边界异常形态不登记＝兜底走 生成调用 原路径（批式
//   行为不变）。打印实参树内不可能嵌套内层打印（void 语义层拒绝），区间要么
//   嵌套要么不相交（树结构）——主遍历判定置于其他区间之前即可安全共存。
函数 收集打印调用区间(向量<节点> 池, 整32 起点, 整32 终点, 向量<整64>& 区间们) -> 空类型 {
    整32 预扫 = 起点;
    当 (预扫 < 终点) {
        节点 预节点 = 池.元素(预扫);
        如果 (预节点.类型 == 节点_调用) {
            向量<整64> 实参终点们 = 向量<整64>();
            如果 (打印族实参终点们(池, 预节点, 整64(预扫), 实参终点们)) {
                整64 区间起 = 整64(预节点.子起点) + 1;
                整64 参i = 0;
                当 (参i < 实参终点们.大小()) {
                    整64 区间终 = 实参终点们.元素(参i) + 1;
                    结果<空类型, 整32> 加起 = 区间们.追加(区间起);
                    如果 (!加起.正常) { 运行时错误(4); }
                    结果<空类型, 整32> 加终 = 区间们.追加(区间终);
                    如果 (!加终.正常) { 运行时错误(4); }
                    区间起 = 区间终;
                    参i++;
                }
            }
        }
        预扫++;
    }
}

// 862：打印族判定+逐实参末位收集——收集器与流式分派共用单一事实源。
//   返回 真=打印族且末位表完整（实参终点们=逐参末位·闭区间右端）；假=非打印
//   族或 查调用实参末位 缺失/边界异常（调用方按原路径兜底）。
函数 打印族实参终点们(向量<节点> 池, 节点 n, 整64 调用位置, 向量<整64>& 实参终点们) -> 布尔 {
    如果 (n.子起点 <= 0 || n.附加 <= 0) { 返回 假; }
    节点 被调节点 = 池.元素(整32(n.子起点));
    如果 (被调节点.类型 != 节点_标识符) { 返回 假; }
    字符串 被调名 = 字符串复制(驻留文本(整64(被调节点.文本)));
    字符串 打印名 = 内置归一基名(被调名);
    如果 (!字符串比较(打印名, "打印") && !字符串比较(打印名, "打印行")) { 返回 假; }
    整64 前末位 = 整64(n.子起点);
    整64 参k = 0;
    当 (参k < n.附加) {
        整64 末位k = 查调用实参末位(调用位置, 参k);
        如果 (末位k < 0 || 末位k <= 前末位 || 末位k >= 调用位置) { 返回 假; }
        结果<空类型, 整32> 加末 = 实参终点们.追加(末位k);
        如果 (!加末.正常) { 运行时错误(4); }
        前末位 = 末位k;
        参k++;
    }
    返回 真;
}

// 预扫描 短路运算符（&&/||）操作数区间（语法层标注：附加=右起点）——主遍历
//   跳过，运算符节点处延迟求值。三元平铺 [起,中,终,...]（检查用起/终两元）。
函数 收集短路区间(向量<节点> 池, 整32 起点, 整32 终点, 向量<整64>& 区间们) -> 空类型 {
    整32 预扫 = 起点;
    当 (预扫 < 终点) {
        节点 预节点 = 池.元素(预扫);
        如果 (预节点.类型 == 节点_二元运算 && 预节点.子终点 != 0) {
            字符串 op名 = 字符串复制(驻留文本(整64(预节点.文本)));
            如果 (字符串比较(op名, "&&") || 字符串比较(op名, "||")) {
                结果<空类型, 整32> 加逻 = 区间们.追加(整64(预节点.子起点));
                如果 (!加逻.正常) { 运行时错误(4); }
                结果<空类型, 整32> 加逻2 = 区间们.追加(预节点.附加);
                如果 (!加逻2.正常) { 运行时错误(4); }
                结果<空类型, 整32> 加逻3 = 区间们.追加(整64(预节点.子终点));
                如果 (!加逻3.正常) { 运行时错误(4); }
            }
        }
        预扫++;
    }
}

// 预扫描 三元运算三段区间（[子起点, 子终点) 全跳——条件/真值/假值延迟到三元
//   节点处惰性生成：仅选中分支求值，规范 01b 5.8）。平铺区间对 [起,终,...]。
函数 收集三元区间(向量<节点> 池, 整32 起点, 整32 终点, 向量<整64>& 区间们) -> 空类型 {
    整32 预扫 = 起点;
    当 (预扫 < 终点) {
        节点 预节点 = 池.元素(预扫);
        如果 (预节点.类型 == 节点_三元运算) {
            结果<空类型, 整32> 加三 = 区间们.追加(整64(预节点.子起点));
            如果 (!加三.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加三2 = 区间们.追加(整64(预节点.子终点));
            如果 (!加三2.正常) { 运行时错误(4); }
        }
        预扫++;
    }
}

// 296-a（D35 波B·2026-09-17）：预扫描 错误传播操作数区间（[子起点, 子终点)
//   全跳——操作数延迟到 节点_错误传播 处统一生成：含条件跳转分块与 err 块
//   构造返回）。布局与 收集三元区间 同构（错误传播节点亦居区间末位）。
函数 收集错误传播区间(向量<节点> 池, 整32 起点, 整32 终点, 向量<整64>& 区间们) -> 空类型 {
    整32 预扫e = 起点;
    当 (预扫e < 终点) {
        节点 预节点e = 池.元素(预扫e);
        如果 (预节点e.类型 == 节点_错误传播) {
            结果<空类型, 整32> 加传 = 区间们.追加(整64(预节点e.子起点));
            如果 (!加传.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加传2 = 区间们.追加(整64(预节点e.子终点));
            如果 (!加传2.正常) { 运行时错误(4); }
        }
        预扫e++;
    }
}

// 位置 是否落在平铺区间们内（步长=每组元素数：取址/三元=2、短路=3）。
//   命中返回该组终点（主循环跳到），未命中返回 -1。
函数 区间终点(向量<整64>& 区间们, 整32 位置, 整64 步长) -> 整64 {
    整64 i = 0;
    当 (i < 区间们.大小()) {
        整64 起 = 区间们.元素(i);
        整64 终 = 区间们.元素(i + 步长 - 1);
        如果 (整64(位置) >= 起 && 整64(位置) < 终) {
            返回 终;
        }
        i += 步长;
    }
    返回 0 - 1;
}

// 字面量节点（整/布尔/字符串）发射常量寄存器并入栈，返回 压栈寄存器。
// 265-a 波A：整字面量位宽判定（纯长度保守法）——含负号总长 ≤10 恒适配
//   T_整32（宿主 C 语义字面量缺省 int）；长度 ≥11 保守 T_整64。
//   配套=公共整型提升（二元面位宽大者胜）——263-a 回归根因是「取左保持窄」
//   误截断非移位算术，波A 以提升规则正确化（380 校验和=最强哨兵）。
// 565 轮（T33 残余根治·配套修正）：改**值域判定**——原「纯长度保守法」≤10 位
//   恒真把 4000000000〔10 位·超 int32 上界 2147483647〕也登记 T_整32，违反
//   「T_整32 登记=值合 int32 域」寄存器类型契约（h1/h5 实锤：槽存原值
//   4000000000·宿主 -294967296 回绕）；超域字面量改 T_整64（同符号宽化放行
//   §混符规则）→窄宽值规范化/正32存储截断 各存储点按码正确回绕；位数 >10=
//   必然越界恒 假（不再解析防 整64 溢出）。
函数 字面量适配整32(字符串 文本) -> 布尔 {
    整64 长度 = 字符串长度(文本);
    如果 (长度 <= 0 || 长度 > 10) { 返回 假; }
    整64 值 = 0;
    整64 i = 0;
    当 (i < 长度) {
        整64 字节b = 字节值(文本, i);
        如果 (字节b < 48 || 字节b > 57) { 返回 假; }
        值 = 值 * 10 + (字节b - 48);
        i++;
    }
    返回 值 <= 2147483647;
}

不安全 函数 生成字面量(节点 n, 向量<IR指令>& 指令, 整64* 寄存器计数,
                  整64* 槽计数, 向量<整64>& 表达式栈) -> 整64 {
    整64 寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    如果 (n.类型 == 节点_整数字面量) {
        // 814（053-001）：**大字面量 128 位物化**（规范 218「超出 整64 域的无
        //   后缀字面量按提升链归 整128」）——解析128位初值文本 拆半，高半
        //   非低半符号扩展（超 整64 域）→ 2 槽物化+句柄登记 T_整128（值=地址
        //   语义·一切 128 位消费点直用；原落 IR_常量整数 发射层 movabs 截断
        //   ——高半丢失·s2 探针 2^64+1+1 出 2 实证）。域内字面量保持原路径。
        字符串 字面文本 = 字符串复制(驻留文本(整64(n.文本)));
        整64 拆低 = 0;
        整64 拆高 = 0;
        布尔 超64域 = 假;
        // 818（064）：超 整128 域先判拒（宿主 parse 判据同构·诊断文案对齐）
        如果 (字面量超128域(字面文本)) {
            IR层诊断("整数字面量超出整128（2^127-1）范围: " + 字面文本);
        } 否则 如果 (解析128位初值文本(字面文本, 拆低, 拆高)) {
            整64 预期高 = 0;
            如果 (拆低 < 0) { 预期高 = 0 - 1; }
            如果 (拆高 != 预期高) { 超64域 = 真; }
        }
        如果 (超64域) {
            寄存器计数[0] = 寄存器计数[0] - 1;   // 释放上方预取寄存器（物化用槽）
            整64 大字句柄 = 物化字面量128位(拆低, 拆高, 指令, 寄存器计数, 槽计数);
            结果<空类型, 整32> 加大字 = 表达式栈.追加(大字句柄);
            如果 (!加大字.正常) { 运行时错误(4); }
            返回 大字句柄;
        }
        // 常量整数：操作数1=Symbol ID（文本），类型=按值域分流
        整64 字面量码 = T_整64;
        如果 (字面量适配整32(驻留文本(整64(n.文本)))) { 字面量码 = T_整32; }
        IR追加(指令, 建IR指令(IR_常量整数, 整64(n.文本), 0, 0, 寄存器, 字面量码, 0));
        登记寄存器类型(寄存器, 字面量码);
    } 否则 如果 (n.类型 == 节点_布尔字面量) {
        // 灰色点①根治（2026-09-04）：真/假 独立节点——常量 1/0 登记 T_布尔
        //   （打印分派 __cn_print_bool 输出 真/假、拼接 from_bool 自动分派）
        IR追加(指令, 建IR指令(IR_常量整数, 整64(n.文本), 0, 0, 寄存器, T_布尔, 0));
        登记寄存器类型(寄存器, T_布尔);
    } 否则 如果 (n.类型 == 节点_字符字面量) {
        // 95-a（2026-09-13 第九十五轮）：字符字面量——文本=Unicode 码点数字ID
        //   （词法层解码）→ IR_常量整数 + T_字符 登记（打印分派按数值输出 ASCII/
        //   码点，与宿主 字符=i32 存储 + 打印整数语义同构；规范 01b 三）
        IR追加(指令, 建IR指令(IR_常量整数, 整64(n.文本), 0, 0, 寄存器, T_字符, 0));
        登记寄存器类型(寄存器, T_字符);
    } 否则 如果 (n.类型 == 节点_浮点字面量) {
        // 89-a（2026-09-12 第八十九轮）：浮点字面量（浮64）——IR_常量浮点
        //   （操作数1=文本 Symbol ID；代码生成侧经 浮点文本净 剥 L/U 尾缀后
        //   .double/REAL8 文本直通发射——IEEE754 位模式由汇编器解析，编译期
        //   零开销）+ T_浮64 登记（打印分派/拼接消费）。
        //   缺陷背景（88-b 出口校验探针实证）：原实现主循环无此分派 + 本函数
        //   无此分支 → 浮点字面量被**静默跳过**——二元弹栈判定退化（操作数
        //   缺失 → 左右均取寄存器 0 → `cmp x,x` 恒真）、净栈 +2 契约违反、
        //   静态浮点初值注入落空（87-a 注入经 生成表达式 求值）。E2E 246 原
        //   「巧合通过」=双重侥幸，宿主同形态正确。
        IR追加(指令, 建IR指令(IR_常量浮点, 整64(n.文本), 0, 0, 寄存器, T_浮64, 0));
        登记寄存器类型(寄存器, T_浮64);
        // 352/04_types（070 波I·1026 深度机）：浮32 字面量——f/F 尾缀分型 →
        //   IR_类型转换(浮64→浮32)（后端 cvtsd2ss·单精度位型 4B 有效）——
        //   原 .double 位型 8B 装载·浮32 变量槽 4B 取低 32=0（2.5f→0.000000
        //   04_types/352/406 域实录）——转换寄存器压栈（登记 T_浮32）
        {
            字符串 浮文本i = 字符串复制(驻留文本(整64(n.文本)));
            整64 浮长i = 字符串长度(浮文本i);
            如果 (浮长i > 0) {
                整64 尾i = 整64(浮文本i[浮长i - 1]) & 255;
                如果 (尾i == 102 || 尾i == 70) {
                    寄存器 = 插入值转换(寄存器, T_浮32, 指令, 寄存器计数);
                }
            }
        }
    } 否则 {
        // P7b 字符串字面量：IR_常量字符串（操作数1=驻留文本ID）——代码生成
        //   发射 .code 段内 strData_<ID> 数据标签地址
        IR追加(指令, 建IR指令(IR_常量字符串, 整64(n.文本), 0, 0, 寄存器, T_字符串, 0));
        登记寄存器类型(寄存器, T_字符串);
    }
    结果<空类型, 整32> 加 = 表达式栈.追加(寄存器);
    如果 (!加.正常) { 运行时错误(4); }
    返回 寄存器;
}

// 标识符加载：参数槽 优先，其次 局部槽；未命中查 顶层常量（内联 IR_常量整数）/
//   顶层静态（IR_静态加载）/函数名兜底（压负数符号）；引用参数按类型分流
//   （发射引用参数读）。全部出口等价消费 1 个位置（主循环统一 位置++）。
不安全 函数 生成标识符加载(节点 n, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                   向量<IR指令>& 指令, 整64* 寄存器计数, 向量<整64>& 表达式栈) -> 空类型 {
    整64 槽 = 0;
    结果<整64, 整32> 找参 = 参数槽.获取(整64(n.文本));
    如果 (找参.正常) { 槽 = 找参.值; }
    如果 (槽 == 0) {
        结果<整64, 整32> 找局 = 局部槽.获取(整64(n.文本));
        如果 (找局.正常) { 槽 = 找局.值; }
    }
    如果 (槽 == 0) {
        // 第七十八轮（2026-09-12）：方法体 this 引用——「自身」标识符（宿主
        //   方法体参数名同款）→ this 槽加载（对象指针；自身.方法() 调用链/
        //   自身作实参均经此出口）
        如果 (当前方法类名ID != 0 && 整64(n.文本) == 整64(驻留("自身"))) {
            整64 自寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 当前方法this槽, 0, 0, 自寄存器,
                                 T_对象, 0));
            结果<空类型, 整32> 加自 = 表达式栈.追加(自寄存器);
            如果 (!加自.正常) { 运行时错误(4); }
            返回;
        }
        // 第七十八轮（2026-09-12）：方法体字段分派——类方法内字段名裸标识符
        //   （局部/参数槽未命中后）→ this 槽加载 + 字段地址 + 指针加载（类区间
        //   字段；当前方法上下文由 生成类.生成方法 设置——非方法体恒 miss）
        整64 字段偏移g = 当前方法字段偏移(整64(n.文本));
        如果 (字段偏移g >= 0) {
            发射类字段读取(字段偏移g, 整64(n.文本), 指令, 寄存器计数, 表达式栈);
            返回;
        }
        // P7a：顶层常量——命中则内联 IR_常量整数（操作数1=值文本ID，
        //   代码生成经 驻留文本 还原立即数）。参数/局部未命中才查，
        //   局部变量遮蔽同名常量语义正确。
        // plans/018 常量分桶：查常量值 三级解析（本模块键基＞纯名＞候选——
        //   限定文本 甲::版本 拆分直查；修复前纯名平铺跨模块覆盖串值）
        整64 常值 = 查常量值(整64(n.文本));
        如果 (常值 != 0) {
            整64 常寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_常量整数, 常值, 0, 0, 常寄存器, T_整64, 0));
            结果<空类型, 整32> 加常 = 表达式栈.追加(常寄存器);
            如果 (!加常.正常) { 运行时错误(4); }
            返回;
        }
        // 070 波G 余波（1026）：类名::静态方法 限定引用——IR_函数地址(方法
        //   符号)（98 形态 应用(计算器::双倍静态, 5)·宿主 P3-23 静态作值；
        //   语义层 检查限定标识符 同判据放行返回类型）
        {
            字符串 限模g = "";
            字符串 限符g = "";
            如果 (拆限定名(字符串复制(驻留文本(整64(n.文本))), 限模g, 限符g) == 1 &&
                 是用户类_ID(驻留(限模g)) &&
                 是类静态方法(驻留(限模g), 驻留(限符g))) {
                整64 参数串IDg = 查类方法参数串(驻留(限模g), 驻留(限符g));
                字符串 参数串g = "";
                如果 (参数串IDg != 0) { 参数串g = 字符串复制(驻留文本(参数串IDg)); }
                字符串 方法符号g = 方法符号(限模g, 限符g, 参数串g);
                整64 值位g = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_函数地址, 0, 0, 0, 值位g, T_整64, 驻留(方法符号g)));
                登记寄存器类型(值位g, T_整64);
                结果<空类型, 整32> 加限定g = 表达式栈.追加(值位g);
                如果 (!加限定g.正常) { 运行时错误(4); }
                返回;
            }
        }
        // ②c C：顶层静态——命中序号则 IR_静态加载（.data _cn_gstatic_N 槽：
        //   容器=堆对象指针；标量=初始值）。常量/局部/参数之后、函数名兜底之前。
        //   87-a（2026-09-12 第八十七轮）：静态**结构体**——值=**地址**
        //   （IR_静态地址，与局部结构体变量同款「表达式值为结构体地址」约定）。
        //   原实现无条件 IR_静态加载（读首 8 字节）：结构体实参/整体拷贝/成员链
        //   基址把首字段句柄当结构体地址（探针 P50b v2 实证：跨函数写读全错）。
        //   其余（标量=值；容器/类=堆对象指针）保持 IR_静态加载（指针槽模型）。
        整64 找静 = 查静态序号含类(整64(n.文本));
        如果 (找静 < 0 && 当前方法类名ID != 0) {
            // 070 波G：类内静态字段裸名读（合成名静态槽）
            找静 = 查静态序号含类(查类静态字段合成名(当前方法类名ID, 整64(n.文本)));
        }
        如果 (找静 >= 0) {
            整64 静寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            // 517-a（T70 B1 三层③残余层）：**类/容器静态排除结构体地址语义**——
            //   静态槽对类/容器存的是**对象指针**（构造函数入口注入），须走
            //   IR_静态加载；原判据仅 查结构体大小>0，而类布局尺寸（映射=56）
            //   同样 >0 → 误发 IR_静态地址=**槽地址** ⇒ 使用点（方法接收者/
            //   成员链基址）拿到 .data 槽地址当对象指针 → 链查找读 桶数组=0 →
            //   段错误（127 撤守卫态 `偏移表.设置(9,200)` 实证：接收者=0x63e260
            //   〔gstatic 邻域〕而槽内容才是对象指针 0x6562d0·对象本身字段全对）。
            布尔 静是类x = 是容器类_ID(取静态类型(找静)) ||
                          是用户类_ID(取静态类型(找静));
            字符串 静类型文本y = 字符串复制(驻留文本(取静态类型(找静)));
            // 810 轮（053）：128 位静态引用——值=16 字节槽地址（IR_静态地址 lea），
            //   寄存器登记 T_整128/T_正128（值=地址语义·与 87-a 结构体静态 T_对象
            //   同构）。替换 701-a 波H「设地址128标记」：标记按寄存器号记录、
            //   寄存器复用即泄漏（波H 返回值面崩溃实证）——类型表登记与既有
            //   登记寄存器类型 生命周期同步，打印/赋值/传参消费点直接查类型。
            如果 (字符串比较(静类型文本y, "整128")) {
                IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静寄存器, T_整128, 找静));
                登记寄存器类型(静寄存器, T_整128);
            } 否则 如果 (字符串比较(静类型文本y, "正128")) {
                IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静寄存器, T_正128, 找静));
                登记寄存器类型(静寄存器, T_正128);
            } 否则 如果 (查结构体大小(取静态类型(找静)) > 0 && !静是类x) {
                IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静寄存器, T_整64, 找静));
                // 87-a：登记 T_对象（值即地址）——回扫实参取地址不得改写
                //   （与 86-a 三元地址化同款；否则符号地址被当"值装载"改取槽）
                登记寄存器类型(静寄存器, T_对象);
            } 否则 {
                // 87-a：类型码按静态类型表分派（原硬编码 T_整64）——字符串/字符*
                //   须 T_字符串（打印/拼接按字符串分派；原按整64 分派打印出句柄
                //   数值，探针 s9-v2「串值=[94113…]」实证）；容器/类 T_对象；
                //   标量按 类型码 表（整32/正64/浮64… 各自精确）。
                整64 静类型码 = 类型码(取静态类型(找静));
                IR追加(指令, 建IR指令(IR_静态加载, 0, 0, 0, 静寄存器, 静类型码,
                                             找静));
                如果 (静类型码 != T_未知) { 登记寄存器类型(静寄存器, 静类型码); }
            }
            结果<空类型, 整32> 加静 = 表达式栈.追加(静寄存器);
            如果 (!加静.正常) { 运行时错误(4); }
            返回;
        }
        // 1007（98 静态方法作值·P3-23）：限定名 类::静态方法 值——IR_函数地址
        //   (方法符号 类$名[参数串]) 压栈（无 this 绑定=纯函数地址；调用位走
        //   T69 间接调用·104 方法引用同款发射）。宿主静态分发 FuncAddr 同构。
        {
            字符串 名文本fz = 字符串复制(驻留文本(整64(n.文本)));
            字符串 限定模块fz = 字符串复制("");
            字符串 限定符号fz = 字符串复制("");
            如果 (拆限定名(名文本fz, 限定模块fz, 限定符号fz) == 1 &&
                 是用户类(限定模块fz) &&
                 是类静态方法(整64(驻留(限定模块fz)), 整64(驻留(限定符号fz)))) {
                整64 参数串fz = 查类方法参数串(整64(驻留(限定模块fz)),
                                              整64(驻留(限定符号fz)));
                字符串 参数串fs = "";
                如果 (参数串fz != 0) { 参数串fs = 字符串复制(驻留文本(参数串fz)); }
                字符串 方法符号串fz = 方法符号(限定模块fz, 限定符号fz, 参数串fs);
                整64 函址寄存器fz = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_函数地址, 0, 0, 0,
                                     函址寄存器fz, T_整64, 驻留(方法符号串fz)));
                登记寄存器类型(函址寄存器fz, T_整64);
                结果<空类型, 整32> 加函址fz = 表达式栈.追加(函址寄存器fz);
                如果 (!加函址fz.正常) { 运行时错误(4); }
                返回;
            }
        }
        // 函数名（调用 被调对象）：压 负数符号 到 表达式栈（0-符号ID），
        //   非变量（参数/局部 查无）——语义层已检查未声明
        结果<空类型, 整32> 加函 = 表达式栈.追加(0 - 整64(n.文本));
        如果 (!加函.正常) { 运行时错误(4); }
        返回;
    }
    整64 寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    // ②c D：引用参数——按类型分流发射（容器& 双重解引用/结构体& 基址/标量& 解引用）
    如果 (槽是引用(槽)) {
        发射引用参数读(槽, 指令, 寄存器计数, 表达式栈);
        返回;
    }
    // 1011（537D·合成体变量/形参标识符读=地址语义）：结果/可选类槽的表达式值
    //   =**槽地址**（87-a 结构体局部/静态「值=地址」约定同构·与批二下标读侧
    //   对称）——原 IR_加载 读前 8 字节（标志+值打包）→ IR_结构体拷贝 源=打包
    //   值 → rep movsb 解引用（追加 数据[元素数量]=值 形态 fault=0x1F00000001
    //   =正常(31) 打包·537D/容器<合成体>全族实锤）。成员访问（r.值）走独立
    //   路径不受影响；传参/整体拷贝/返回物化均按地址消费（894/81-a 链）。
    {
        整64 标识类型1011 = 解析标识符类型ID(整64(n.文本));
        如果 (标识类型1011 > 0 && 是结果类型_ID(标识类型1011)) {
            IR追加(指令, 建IR指令(IR_取地址, 槽, 0, 0, 寄存器, T_整64, 0));
            登记寄存器类型(寄存器, T_对象);
            结果<空类型, 整32> 加合1011 = 表达式栈.追加(寄存器);
            如果 (!加合1011.正常) { 运行时错误(4); }
            返回;
        }
    }
    // 94-a（2026-09-13 第九十四轮）：数组变量——标识符值 = **基址地址**（数组名
    //   退化为元素指针，宿主 ir.cpp「数组名引用为元素指针」同构）：IR_取地址
    //   （基址槽=槽起+槽数-1 低地址）→ 元素指针。下标读/左值写/作实参/指针
    //   运算全链零拷贝消费（指针路径复用）；原实现 Load 槽值=数组首 8 字节数据
    //   当指针用（错误）。
    如果 (整64(解析标识符类型ID(整64(n.文本))) >= 0) {
        字符串 标识文本v = 字符串复制(
            驻留文本(解析标识符类型ID(整64(n.文本))));
        如果 (是数组类型文本(标识文本v)) {
            IR追加(指令, 建IR指令(IR_取地址, 槽, 0, 0, 寄存器, T_整64, 0));
            登记寄存器类型(寄存器, T_整64);
            结果<空类型, 整32> 加数组v = 表达式栈.追加(寄存器);
            如果 (!加数组v.正常) { 运行时错误(4); }
            返回;
        }
    }
    // 810 轮（053）：128 位标量变量（局部/形参）——标识符值=**16 字节槽对
    //   基址地址**（值=地址语义·与 87-a 结构体静态 T_对象/94-a 数组名退化
    //   同构）：IR_取地址 基址槽+登记 T_整128/T_正128。打印传址/赋值双半拷/
    //   传参传址/算术辅助函数全消费点按此语义（局部槽映射登记值=基址槽·
    //   分配标量声明槽/形参 2 槽协同）。
    字符串 标识类型文本128 = 字符串复制(
        驻留文本(解析标识符类型ID(整64(n.文本))));
    如果 (字符串比较(标识类型文本128, "整128") ||
         字符串比较(标识类型文本128, "正128")) {
        IR追加(指令, 建IR指令(IR_取地址, 槽, 0, 0, 寄存器, T_整64, 0));
        如果 (字符串比较(标识类型文本128, "整128")) {
            登记寄存器类型(寄存器, T_整128);
        } 否则 {
            登记寄存器类型(寄存器, T_正128);
        }
        IO::打印到错误("[dbg1022z] 128加载 名=" + 字符串复制(驻留文本(整64(n.文本))) +
                       " reg=" + 整数转字符串(寄存器) + "\n");
        结果<空类型, 整32> 加128 = 表达式栈.追加(寄存器);
        如果 (!加128.正常) { 运行时错误(4); }
        返回;
    }
    IR追加(指令, 建IR指令(IR_加载, 槽, 0, 0, 寄存器, T_整64, 0));
    // ③ 缺陷①根治：变量/参数类型登记（打印分派/拼接转换——字符串/浮点/布尔
    //   全覆盖；经 函数级权威表+类型码，未登记=未知按整数兜底）
    整64 标识类型码 = 类型码(解析标识符类型ID(整64(n.文本)));
    // 266-a 波B：指针变量（指针变量类型们 已登记·层数分离设计下 类型码 会
    //   误取所指类型）寄存器码=T_整64——指针值 64 位语义；同时登记指针值
    //   步进（二元 +/- 步进糖消费·263-a 教训=跨文件走访问器 查指针变量类型）。
    如果 (查指针变量类型(整64(n.文本)) > 0) {
        标识类型码 = T_整64;
        登记指针值步进(寄存器, 类型名宽度(查指针变量类型(整64(n.文本))));
    }
    如果 (标识类型码 != T_未知) {
        登记寄存器类型(寄存器, 标识类型码);
    }
    结果<空类型, 整32> 加 = 表达式栈.追加(寄存器);
    如果 (!加.正常) { 运行时错误(4); }
}

//     ① 多压（Δ>1）：残留破坏后续「相对栈顶」消费——88-a 实参位短路旧实现
//        净 +3 即此形态，症状却是远端 `[ir2] 调用被调对象非函数名/方法`
//        （契约违反表现为下游症状，定位跨三层）；88-b 实证另一例：浮点字面量
//        漏分派（操作数缺失退化弹栈判定）净 +2——已随 89-a 根治。
//     ② 吞外层（Δ<0）：弹掉了调用方先序压栈值（调用实参求值中消失等）。
//   Rust 对照：rustc MIR validator / ICE——编译器不变量违反立刻报告，
//   不让错误产物进入下游（本校验把「下游症状」提前到「当场暴露」）。
//   调用纪律：生成表达式 唯一正常出口调用（错误路径 生成调用 返回 0 已诊断——
//   不校验，避免二次噪音）。性能：1 次函数调用 + 1 次减法 + 2 次比较（无分配；
//   出口深度顺带回传省一次 大小()）——实测编译 v2 树与基线差异在噪声内
//   （plans/020 本轮量化）。
// 返回出口栈深度（调用方据此取栈顶/判空——省重复 大小() 调用）。
函数 净栈契约出口校验(向量<整64>& 表达式栈, 整64 进入深度, 整32 起点, 整32 终点) -> 整64 {
    整64 出口深度 = 表达式栈.大小();
    整64 净栈增量 = 出口深度 - 进入深度;
    如果 (净栈增量 > 1) {
        IR层诊断("表达式净栈契约违反(多压): 增量=" + 整数转字符串(净栈增量) +
                       " 区间=[" + 整数转字符串(整64(起点)) + "," +
                       整数转字符串(整64(终点)) + ") 进入深度=" +
                       整数转字符串(进入深度));
    }
    如果 (净栈增量 < 0) {
        IR层诊断("表达式净栈契约违反(吞外层): 增量=" + 整数转字符串(净栈增量) +
                       " 区间=[" + 整数转字符串(整64(起点)) + "," +
                       整数转字符串(整64(终点)) + ") 进入深度=" +
                       整数转字符串(进入深度));
    }
    返回 出口深度;
}
// 894-a（070·G-N 特性波3）：自增/自减**表达式位**发射（407）——读-算-写回，
//   表达式值=旧值（后缀）/新值（前缀）——宿主 T24（297-a）`lastExpr = postfix ?
//   cur : res` 同构、Rust 对照=`x_old = x; x += 1; x_old`（无原生自增表达式·
//   CN 对齐 C 语义）。左值两路：标识符=槽模型（局部/参数/静态/字段/引用·
//   发射自增自减 语句位同款分支+浮点 delta/指针步进/窄宽回绕）；
//   成员/下标=地址模型（生成左值地址 + 指针读写对·宽度=字段三元组推导）。
不安全 函数 生成自增表达式(向量<节点> 池, 节点 n,
                           映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                           向量<IR指令>& 指令, 整64* 寄存器计数,
                           整64* 块计数, 整64* 槽计数, 向量<整64>& 表达式栈) -> 布尔 {
    布尔 是自减 = 整64(n.文本) == 驻留("--");
    布尔 是前缀 = n.附加 == 1;
    整64 运算码 = IR_加;
    如果 (是自减) { 运算码 = IR_减; }
    节点 左末 = 池.元素(整32(n.子终点 - 1));
    整64 旧值reg = 0;
    整64 新值reg = 0;
    如果 (左末.类型 == 节点_标识符) {
        整64 名ID = 整64(左末.文本);
        // 类型码/步进宽（发射自增自减 同款：浮点 delta 同精度·指针步进=元素宽）
        整64 目标类型码 = T_整64;
        整64 自增类型名ID = 查当前函数变量类型(名ID);
        如果 (自增类型名ID >= 0) {
            整64 自增码 = 类型码(自增类型名ID);
            如果 (自增码 == T_浮32 || 自增码 == T_浮64) { 目标类型码 = 自增码; }
        }
        整64 自增量宽 = 1;
        整64 自增指针所指 = 查指针变量类型(名ID);
        如果 (自增指针所指 > 0) {
            目标类型码 = T_整64;
            自增量宽 = 类型名宽度(自增指针所指);
        }
        整64 常量1 = 发射自增增量宽(指令, 目标类型码, 寄存器计数, 自增量宽);
        整64 目标槽 = 0;
        结果<整64, 整32> 找槽 = 局部槽.获取(名ID);
        如果 (找槽.正常) { 目标槽 = 找槽.值; }
        如果 (目标槽 == 0) {
            结果<整64, 整32> 找参 = 参数槽.获取(名ID);
            如果 (找参.正常) { 目标槽 = 找参.值; }
        }
        如果 (目标槽 != 0) {
            如果 (槽是引用(目标槽)) {
                // 引用参数：Load 槽得调用方地址 → 指针读写对
                整64 地址reg = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 地址reg, T_整64, 0));
                旧值reg = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_指针加载, 地址reg, 0, 0, 旧值reg, 目标类型码, 0));
                新值reg = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(运算码, 旧值reg, 常量1, 0, 新值reg, 目标类型码, 0));
                IR追加(指令, 建IR指令(IR_指针存储, 地址reg, 新值reg, 0, 0, 目标类型码, 0));
            } 否则 {
                旧值reg = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 旧值reg, 目标类型码, 0));
                新值reg = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(运算码, 旧值reg, 常量1, 0, 新值reg, 目标类型码, 0));
                // 窄型回绕（整8/16 域规范化·非窄宽零开销直通·主路径同款）
                如果 (自增类型名ID >= 0 && 查指针变量类型(名ID) < 0) {
                    新值reg = 窄宽值规范化(窄宽码自文本(驻留文本(自增类型名ID)),
                                           新值reg, 指令, 寄存器计数);
                }
                IR追加(指令, 建IR指令(IR_存储, 新值reg, 0, 0, 0, 0, 目标槽));
            }
        } 否则 {
            整64 找静 = 查静态序号含类(名ID);
            如果 (找静 < 0 && 当前方法类名ID != 0) {
                // 070 波G：类内静态字段裸名（复合赋值 同 自增 口径）
                找静 = 查静态序号含类(查类静态字段合成名(当前方法类名ID, 名ID));
            }
            如果 (找静 >= 0) {
                旧值reg = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_静态加载, 0, 0, 0, 旧值reg, 目标类型码, 找静));
                新值reg = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(运算码, 旧值reg, 常量1, 0, 新值reg, 目标类型码, 0));
                IR追加(指令, 建IR指令(IR_静态存储, 新值reg, 0, 0, 0, 目标类型码, 找静));
            } 否则 {
                整64 字段偏移 = 当前方法字段偏移(名ID);
                如果 (字段偏移 >= 0) {
                    整64 字段地址 = 发射类字段地址(字段偏移, 指令, 寄存器计数);
                    旧值reg = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_指针加载, 字段地址, 0, 0, 旧值reg, 目标类型码, 0));
                    新值reg = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(运算码, 旧值reg, 常量1, 0, 新值reg, 目标类型码, 0));
                    IR追加(指令, 建IR指令(IR_指针存储, 字段地址, 新值reg, 0, 0, 目标类型码, 0));
                } 否则 {
                    IR层诊断("自增表达式目标未解析（局部/参数/静态/字段）: " +
                             驻留文本(名ID));
                    返回 假;
                }
            }
        }
    } 否则 如果 (左末.类型 == 节点_成员 || 左末.类型 == 节点_下标) {
        // 地址模型：生成左值地址（区间取址·无副作用）+ 指针读写对（宽度=字段
        //   三元组推导〔成员〕/默认 8〔下标·v2 值槽模型〕）
        整64 地址 = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
        如果 (地址 == 0) {
            IR层诊断("自增表达式左值地址生成失败");
            返回 假;
        }
        整64 宽度码 = T_整64;
        如果 (左末.类型 == 节点_成员 && 左末.子起点 > 0) {
            节点 对象节点w = 池.元素(整32(左末.子起点));
            整64 偏移w = 0;
            整64 加载类型w = 0;
            整64 对象类型w = 0;
            整64 值码w = 0;
            解析字段三元组(池, 左末, 对象节点w, 偏移w, 加载类型w, 对象类型w, 值码w);
            如果 (加载类型w != 0) { 宽度码 = 加载类型w; }
        }
        旧值reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_指针加载, 地址, 0, 0, 旧值reg, 宽度码, 0));
        整64 常量1w = 发射自增增量宽(指令, 宽度码, 寄存器计数, 1);
        新值reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(运算码, 旧值reg, 常量1w, 0, 新值reg, 宽度码, 0));
        IR追加(指令, 建IR指令(IR_指针存储, 地址, 新值reg, 0, 0, 宽度码, 0));
    } 否则 {
        IR层诊断("自增表达式左值形态暂限标识符/成员/下标（解引用位登记 002 后续波）");
        返回 假;
    }
    // 表达式值：后缀=旧值 / 前缀=新值（宿主 T24 同构）
    整64 值压回 = 是前缀 ? 新值reg : 旧值reg;
    结果<空类型, 整32> 压回z = 表达式栈.追加(值压回);
    如果 (!压回z.正常) { 运行时错误(4); }
    返回 真;
}

// 894-a（070·G-N 特性波3）：赋值表达式位轻量发射（287 链式赋值）——主循环
//   已逐节点求值右值子区间（[子起点,子终点) 物理在赋值根之前）→栈顶即右值
//   值寄存器；弹栈→按左值形态存储→值寄存器压回（表达式值=所赋值·C 语义）。
//   Rust 对照：Rust 赋值表达式值=()（赋值非值表达式）；CN 规范对齐 C++（值=
//   所赋值·宿主 AssignmentExpr 同构）——寄存器型 IR 天然零拷贝（右值寄存器
//   直通表达式值，无写后回读；对齐双目标「性能超 C++」的零额外指令路径）。
//   守卫（宁严勿松）：结构体/容器/用户类/字符串左值（整体值/句柄类——轻量
//   通道无深拷/拥有串设施〔生成赋值语句 家族职责〕，浅存=双释放/泄漏面）
//   与非标识符左值（成员/下标/解引用）→ IR 层诊断拒绝（宿主全支持·诚实边界
//   登记 002 后续波「链式赋值全形态」）。128 位=地址句柄双半拷贝（生成标识符
//   赋值 810 分支同款）。
不安全 函数 生成赋值表达式(向量<节点> 池, 节点 n,
                            映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                            向量<IR指令>& 指令, 整64* 寄存器计数,
                            整64* 槽计数, 向量<整64>& 表达式栈) -> 布尔 {
    如果 (n.文本 == 0) {
        IR层诊断("链式赋值表达式左值暂限标识符（成员/下标/解引用位登记 002 后续波）");
        返回 假;
    }
    整64 左类型ID = 查当前函数变量类型(整64(n.文本));
    字符串 左类型文本 = 左类型ID > 0 ? 字符串复制(驻留文本(左类型ID)) : 字符串复制("");
    如果 (左类型ID > 0 && (查结构体大小(左类型ID) != 0 || 是容器类(左类型文本) ||
                          是用户类(左类型文本) ||
                          字符串比较(左类型文本, "字符串"))) {
        IR层诊断("链式赋值表达式左值类型暂限标量/指针（整体值类登记 002 后续波）: " + 左类型文本);
        返回 假;
    }
    // 弹右值前先弹**左值标识符求值残留**（主循环线性求值把左值 x 也压了栈
    //   ——赋值消费它·净贡献=左值(+1)+右值(+1)+本节点(弹2压1)=+1·净栈契约
    //   实测增量=2 违规的根因）；标识符左值=恰 1 压（本轮限定面）
    如果 (表达式栈.大小() < 2) { 返回 假; }
    整64 值寄存器 = 表达式栈.元素(表达式栈.大小() - 1);
    结果<空类型, 整32> 弹栈a = 表达式栈.删除(表达式栈.大小() - 1);
    如果 (!弹栈a.正常) { 运行时错误(4); }
    结果<空类型, 整32> 弹左残 = 表达式栈.删除(表达式栈.大小() - 1);
    如果 (!弹左残.正常) { 运行时错误(4); }
    // 128 位：值寄存器=地址句柄→目标槽对双半拷贝（局部/参数）/静态区 16 字节
    如果 (字符串比较(左类型文本, "整128") || 字符串比较(左类型文本, "正128")) {
        整64 源码128 = 查寄存器类型(值寄存器);
        整64 目标槽128 = 0;
        结果<整64, 整32> 找槽128 = 局部槽.获取(整64(n.文本));
        如果 (找槽128.正常) { 目标槽128 = 找槽128.值; }
        如果 (目标槽128 == 0) {
            结果<整64, 整32> 找参128 = 参数槽.获取(整64(n.文本));
            如果 (找参128.正常) { 目标槽128 = 找参128.值; }
        }
        如果 (目标槽128 != 0 && (源码128 == T_整128 || 源码128 == T_正128)) {
            发射128位双半拷贝(值寄存器, 目标槽128, 目标槽128 - 1, 指令, 寄存器计数);
        } 否则 {
            整64 找静128 = 查静态序号含类(整64(n.文本));
            如果 (找静128 >= 0) {
                整64 静地址128 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静地址128, T_整64, 找静128));
                IR追加(指令, 建IR指令(IR_结构体拷贝, 值寄存器, 静地址128, 0, 0, 16, 0));
            } 否则 {
                IR层诊断("128 位链式赋值目标未解析（局部/参数/静态外登记后续）: " +
                         驻留文本(整64(n.文本)));
                返回 假;
            }
        }
        结果<空类型, 整32> 压回128 = 表达式栈.追加(值寄存器);
        如果 (!压回128.正常) { 运行时错误(4); }
        返回 真;
    }
    // 目标槽解析：局部 → 参数 → 静态 → 方法体字段
    整64 目标槽 = 0;
    结果<整64, 整32> 找槽 = 局部槽.获取(整64(n.文本));
    如果 (找槽.正常) { 目标槽 = 找槽.值; }
    如果 (目标槽 == 0) {
        结果<整64, 整32> 找参 = 参数槽.获取(整64(n.文本));
        如果 (找参.正常) { 目标槽 = 找参.值; }
    }
    如果 (目标槽 != 0) {
        如果 (槽是引用(目标槽)) {
            // 引用参数：Load 槽得调用方左值地址 → 指针写回（主路径同款）
            整64 地址reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 地址reg, T_整64, 0));
            IR追加(指令, 建IR指令(IR_指针存储, 地址reg, 值寄存器, 0, 0, T_整64, 0));
        } 否则 {
            // 窄宽值规范化（指针跳过）+ 浮点宽化 + 隐式窄化（主路径同款三连）
            如果 (查指针变量类型(整64(n.文本)) < 0) {
                值寄存器 = 窄宽值规范化(窄宽码自文本(左类型文本), 值寄存器,
                                        指令, 寄存器计数);
            }
            值寄存器 = 浮点宽化存储(左类型文本, 值寄存器, 指令, 寄存器计数);
            值寄存器 = 隐式窄化到64(值寄存器, 指令, 寄存器计数);
            IR追加(指令, 建IR指令(IR_存储, 值寄存器, 0, 0, 0, 0, 目标槽));
        }
    } 否则 {
        整64 找静 = 查静态序号含类(整64(n.文本));
        如果 (找静 < 0 && 当前方法类名ID != 0) {
            // 070 波G：类内静态字段裸名写（合成名静态槽）
            找静 = 查静态序号含类(查类静态字段合成名(当前方法类名ID, 整64(n.文本)));
        }
        如果 (找静 < 0 && n.子终点 > n.子起点) {
            // 070 波G：类名.静态字段写（赋值节点 文本=字段名·左值区间=对象.字段·
            //   对象=用户类名+静态字段表命中 → 静态槽写——原落字段偏移=静态不入
            //   对象布局「成员左值字段偏移未知」拒绝）
            节点 左末w2 = 池.元素(整32(n.子终点 - 1));
            如果 (左末w2.类型 == 节点_成员 && 左末w2.子起点 > 0) {
                节点 对象w2 = 池.元素(整32(左末w2.子起点));
                如果 (对象w2.类型 == 节点_标识符 && 是用户类_ID(整64(对象w2.文本))) {
                    找静 = 查静态序号含类(查类静态字段合成名(整64(对象w2.文本), 整64(左末w2.文本)));
                }
            }
        }
        如果 (找静 >= 0) {
            IR追加(指令, 建IR指令(IR_静态存储, 值寄存器, 0, 0, 0, T_整64, 找静));
        } 否则 {
            整64 字段偏移 = 当前方法字段偏移(整64(n.文本));
            如果 (字段偏移 >= 0) {
                整64 字段地址 = 发射类字段地址(字段偏移, 指令, 寄存器计数);
                IR追加(指令, 建IR指令(IR_指针存储, 字段地址, 值寄存器, 0, 0, T_整64, 0));
            } 否则 {
                IR层诊断("链式赋值目标未解析（局部/参数/静态/字段）: " +
                         驻留文本(整64(n.文本)));
                返回 假;
            }
        }
    }
    // 表达式值=所赋值（压回栈顶——右值寄存器直通·零拷贝）
    结果<空类型, 整32> 压回 = 表达式栈.追加(值寄存器);
    如果 (!压回.正常) { 运行时错误(4); }
    返回 真;
}

函数 生成表达式(向量<节点> 池, 整32 起点, 整32 终点,
                 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                 向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数,
                 向量<整64>& 表达式栈) -> 整64 {
    // 净栈契约出口校验（88-b）：进入深度——须在任何栈操作之前记录
    整64 净栈进入深度 = 表达式栈.大小();
    // P7b：结果返回 retbuf 共享序号（帧尾 16 字节区）——发射顺序=使用顺序，
    //   每次调用后立即消费（接收 CopyStruct / 丢弃），单 retbuf 复用安全
    常量 retbuf序号 = 1;
    // P6c：预扫描（提取为 收集取址区间/收集短路区间/收集三元区间，R3）。
    向量<整64> 取址区间们 = 向量<整64>();
    收集取址区间(池, 起点, 终点, 取址区间们);
    // 894-a：自增表达式位左值区间（跳过+自增根统一读写）
    向量<整64> 自增区间们 = 向量<整64>();
    收集自增区间(池, 起点, 终点, 自增区间们);
    向量<整64> 逻辑区间们 = 向量<整64>();
    收集短路区间(池, 起点, 终点, 逻辑区间们);
    向量<整64> 三元区间们 = 向量<整64>();
    收集三元区间(池, 起点, 终点, 三元区间们);
    向量<整64> 传播区间们 = 向量<整64>();
    收集错误传播区间(池, 起点, 终点, 传播区间们);
    向量<整64> 构造区间们 = 向量<整64>();
    收集构造区间(池, 起点, 终点, 构造区间们);
    // 862（任务 215 甲裁决实施）：打印族调用实参区间——主遍历跳过，调用节点处
    //   流式分派＝逐参求值→打印调用交替（宿主流式同款·批式对照=849-a「右→左」
    //   观测源）。末位表缺失形态不登记＝兜底走 生成调用 原路径。
    向量<整64> 打印区间们 = 向量<整64>();
    收集打印调用区间(池, 起点, 终点, 打印区间们);
    整32 位置 = 起点;
    当 (位置 < 终点) {
        // 862：打印族实参区间跳过（判定置于其他区间之前——内层短路/三元/取址
        //   结构由流式分派递归 生成表达式 重新预扫描，树结构保证区间要么嵌套
        //   要么不相交）
        整64 打终 = 区间终点(打印区间们, 位置, 2);
        如果 (打终 >= 0) { 位置 = 整32(打终); 继续; }
        // 跳过 取地址 子区间 / 短路操作数区间 / 三元三段区间（R3：区间终点 统一判定）
        整64 取终 = 区间终点(取址区间们, 位置, 2);
        如果 (取终 >= 0) { 位置 = 整32(取终); 继续; }
        // 894-a：自增左值区间跳过（左值由自增根统一处理）
        整64 增终 = 区间终点(自增区间们, 位置, 2);
        如果 (增终 >= 0) { 位置 = 整32(增终); 继续; }
        整64 逻终 = 区间终点(逻辑区间们, 位置, 3);
        如果 (逻终 >= 0) { 位置 = 整32(逻终); 继续; }
        整64 三终 = 区间终点(三元区间们, 位置, 2);
        如果 (三终 >= 0) { 位置 = 整32(三终); 继续; }
        整64 传终 = 区间终点(传播区间们, 位置, 2);
        如果 (传终 >= 0) { 位置 = 整32(传终); 继续; }
        // 84-a：结构体字面量构造的值区间跳过（终点=构造节点位置——由该节点统一求值，
        //   避免值表达式被主循环重复求值）
        整64 构终84 = 区间终点(构造区间们, 位置, 2);
        如果 (构终84 >= 0) { 位置 = 整32(构终84); 继续; }
        节点 n = 池.元素(位置);
        // 84-a：结构体字面量作实参（临时槽 + 逐字段写；槽地址压栈 + 登记实参清理）
        如果 (n.类型 == 节点_结构体构造) {
            生成结构体构造(池, n, 局部槽, 参数槽, 指令, 寄存器计数, 块计数,
                          槽计数, 表达式栈);
            位置++;
            继续;
        }
    如果 (n.类型 == 节点_整数字面量 || n.类型 == 节点_布尔字面量 ||
         n.类型 == 节点_字符串字面量 || n.类型 == 节点_浮点字面量 ||
         n.类型 == 节点_字符字面量) {
        生成字面量(n, 指令, 寄存器计数, 槽计数, 表达式栈);
    } 否则 如果 (n.类型 == 节点_标识符) {
            // 418-a（D40 细分）：枚举名裸标识符不压栈——仅作成员链基名
            //   （颜色.绿 由 生成枚举成员常量 折叠压值·裸枚举名无值语义）
            如果 (是枚举名(整64(n.文本))) {
                位置++;
                继续;
            }
            生成标识符加载(n, 局部槽, 参数槽, 指令, 寄存器计数, 表达式栈);
            位置++;
            继续;
        } 否则 如果 (n.类型 == 节点_二元运算) {
            字符串 op名 = 字符串复制(驻留文本(整64(n.文本)));
            // CN 字符串 == 是指针比较（非内容）——须用 字符串比较
            // 短路（&&/||）惰性求值与普通二元（拼接/算术/比较）分流（R3 提取）
            如果 (字符串比较(op名, "&&") || 字符串比较(op名, "||")) {
                生成短路求值(池, n, op名, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
            } 否则 {
                生成二元运算主体(池, n, op名, 位置, 局部槽, 参数槽, 指令, 寄存器计数, 槽计数, 表达式栈);
            }
            位置++;
            继续;
        } 否则 如果 (n.类型 == 节点_三元运算) {
            生成三元运算(池, n, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
        } 否则 如果 (n.类型 == 节点_错误传播) {
            // 296-a（D35 波B）：后缀错误传播 表达式?——操作数求值+条件分块，
            //   err 块构造错误结果沿 retbuf 直接返回（宿主 Operator::Propagate 同构）
            生成错误传播(池, n, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
            位置++;
            继续;
        } 否则 如果 (n.类型 == 节点_逻辑非 || n.类型 == 节点_负号 ||
             n.类型 == 节点_取地址 || n.类型 == 节点_解引用) {
            生成一元运算(池, n, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
        } 否则 如果 (n.类型 == 节点_成员) {
            // 418-a（D40 细分）：枚举成员链（错误码.内存）——基名=枚举名→
            //   编译期常量折叠（不安全 辅助函数·指针下标安全区挂点隔离）
            如果 (n.子起点 > 0) {
                节点 基名节点e = 池.元素(整32(n.子起点));
                如果 (基名节点e.类型 == 节点_标识符 && 是枚举名(整64(基名节点e.文本))) {
                    生成枚举成员常量(池, n, 指令, 寄存器计数, 表达式栈);
                    位置++;
                    继续;
                }
            }
            // 对象.字段 / 对象->字段：方法接收者 或 字段访问（R3 提取两形态）
            如果 (n.附加 == 成员方法标记) {
                生成方法接收者(池, n, 局部槽, 参数槽, 指令, 寄存器计数, 表达式栈);
            } 否则 {
                生成字段访问(池, n, 局部槽, 参数槽, 指令, 寄存器计数, 表达式栈);
            }
            位置++;
            继续;
        } 否则 如果 (n.类型 == 节点_调用) {
            // 862：打印族流式分派（逐参求值→打印调用交替·宿主流式同款）——
            //   0=非打印族/末位表缺失→兜底走 生成调用 原路径（批式行为不变·
            //   未动指令栈可安全兜底）；-1=流式生成中途失败（半成品指令已发射·
            //   不可兜底）→按生成失败终止
            整64 结果码 = 生成打印流式调用(池, n, 位置, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
            如果 (结果码 == 0) {
                结果码 = 生成调用(池, n, 位置, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈, retbuf序号);
            }
            如果 (结果码 <= 0) { 返回 0; }
            位置++;
            继续;
        } 否则 如果 (n.类型 == 节点_下标) {
            生成下标访问(池, n, 指令, 寄存器计数, 块计数, 表达式栈);
            位置++;
            继续;
        } 否则 如果 (n.类型 == 节点_自增表达式) {
            // 894-a：自增/自减表达式位（407）——读-算-写回+值=旧值(后缀)/新值(前缀)
            布尔 自增式成 = 生成自增表达式(池, n, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
            如果 (!自增式成) { 返回 0; }
            位置++;
            继续;
        } 否则 如果 (n.类型 == 节点_赋值) {
            // 894-a（070·G-N 特性波3）：链式赋值表达式位（287）——右值子区间
            //   [子起点,子终点) 物理在赋值根之前、已被主循环逐节点求值→栈顶
            //   即右值寄存器；存储后压回=表达式值（C 语义「值=所赋值」）。
            布尔 赋值式成 = 生成赋值表达式(池, n, 局部槽, 参数槽, 指令, 寄存器计数, 槽计数, 表达式栈);
            如果 (!赋值式成) { 返回 0; }
            位置++;
            继续;
        }
        位置++;
    }
    // 净栈契约出口校验（88-b）：多压/吞外层当场诊断——契约/性能/Rust 对照详见
    //   净栈契约出口校验 定义处注释（单一事实源）
    整64 出口深度 = 净栈契约出口校验(表达式栈, 净栈进入深度, 起点, 终点);
    如果 (出口深度 == 0) { 返回 0; }
    返回 表达式栈.元素(出口深度 - 1);
}

// ==================== 打印族流式分派（862·任务 215 甲裁决实施） ====================
// 逐参「求值→打印调用」交替——宿主 ir_call 流式同款。215 实测定性：v2 批式
//   （全部实参求值完→逐参发射打印·`生成打印与内置调用` 原路径）观测等效
//   849-a 呈报的「右→左」（实参副作用先于前参输出）；宿主流式＝前参输出先于
//   后参求值副作用。本函数与 收集打印调用区间/打印族实参终点们 构成跳过+分派
//   单一事实源链；返回 0=非打印族/末位表缺失（调用方兜底走 生成调用 原路径）。
不安全 函数 生成打印流式调用(向量<节点> 池, 节点 n, 整32 位置, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) -> 整32 {
    向量<整64> 实参终点们 = 向量<整64>();
    如果 (!打印族实参终点们(池, n, 整64(位置), 实参终点们)) { 返回 0; }
    节点 被调节点 = 池.元素(整32(n.子起点));
    字符串 被调名 = 字符串复制(驻留文本(整64(被调节点.文本)));
    字符串 打印名 = 内置归一基名(被调名);
    布尔 是打印换行 = 字符串比较(打印名, "打印");
    // 逐参：实参子区间求值→弹栈→负占位收口→单参打印发射→串字段临时清理
    //   （求值指令与打印调用指令交织＝流式；实参生成经 生成表达式 递归——
    //   内层短路/三元/取址等形态自建区间正确）
    整64 区间起 = 整64(n.子起点) + 1;
    整64 参i = 0;
    当 (参i < 实参终点们.大小()) {
        整64 区间终 = 实参终点们.元素(参i);
        整64 求值码 = 生成表达式(池, 整32(区间起), 整32(区间终) + 1, 局部槽, 参数槽,
                              指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
        如果 (求值码 == 0) { 返回 0 - 1; }
        如果 (表达式栈.大小() == 0) { 运行时错误(4); }
        整64 打参 = 表达式栈.元素(表达式栈.大小() - 1);
        结果<空类型, 整32> 删参 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删参.正常) { 运行时错误(4); }
        向量<整64> 单参们 = 向量<整64>();
        结果<空类型, 整32> 加单 = 单参们.追加(打参);
        如果 (!加单.正常) { 运行时错误(4); }
        实参负占位收口480(指令, 寄存器计数, 单参们);
        发射单参打印(单参们.元素(0), 指令, 寄存器计数);
        清理调用实参临时(单参们, 指令, 寄存器计数);
        区间起 = 区间终 + 1;
        参i++;
    }
    // 打印 尾随换行（打印行 不加）——同原路径
    如果 (是打印换行) {
        IR追加(指令, 建IR指令(IR_调用参数化, 0, 0, 0, 0, 0,
                             驻留("__cn_print_newline")));
    }
    返回 1;
}

// ==================== 左值地址生成（P6c） ====================
// 生成左值区间 [起点, 终点) 的地址（标识符->槽地址；成员->字段地址；解引用->操作数地址）。
// 不走 生成表达式（成员会取值）；返回地址寄存器（0=失败）。
// 块计数/槽计数：短路求值透传（缺陷B，2026-09-02）。
// 下标左值地址（p[i] = v）：指针对象 槽 Load 值+下标×步进=元素地址（③ 第三波）。
//   非指针对象（字符串下标只读等）语义层已拒——诊断报错返回 0。
// 97-a（2026-09-13 第九十七轮 C8）：左值对象链**根索引**递归（成员/下标节点取子起点，
//   标识符/叶节点即根）——结构体字段数组元素左值（r.分数[0] = v / t.两行[1].分数[2]）
//   的基址经 生成左值地址(根, 对象索引+1) 全链重建（顺序链：标识符->成员->下标->成员…）。
不安全 函数 对象链根索引(向量<节点> 池, 整32 节点索引) -> 整32 {
    节点 n = 池.元素(节点索引);
    如果 (n.类型 == 节点_成员 || n.类型 == 节点_下标) {
        如果 (n.子起点 > 0) {
            返回 对象链根索引(池, 整32(n.子起点));
        }
    }
    返回 节点索引;
}

不安全 函数 生成下标左值地址(向量<节点> 池, 节点 末节点, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                     向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数,
                     向量<整64>& 表达式栈) -> 整64 {
节点 下标对象左值 = 池.元素(整32(末节点.子起点));
    整64 地址g1 = 生成下标左值标识符分支(池, 末节点, 下标对象左值, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    如果 (地址g1 != 0) { 返回 地址g1; }
    如果 (下标对象左值.类型 == 节点_成员 || 下标对象左值.类型 == 节点_下标) {
    整64 地址g2 = 生成下标左值成员下标分支(池, 末节点, 下标对象左值, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    如果 (地址g2 != 0) { 返回 地址g2; }
    }
    如果 (下标对象左值.类型 == 节点_标识符 && 当前方法类名ID != 0) {
    整64 地址g3 = 生成下标左值裸字段分支(池, 末节点, 下标对象左值, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    如果 (地址g3 != 0) { 返回 地址g3; }
    }
    IR层诊断("下标左值对象未支持（须指针/数组/字段数组）");
    返回 0;
}

// 顺序链标识符基址：槽解析（局部/参数）+ 引用参数（Load 槽内容）/指针参数
//   （装载指针值）/普通（取槽地址）三分流（②c D/第17枚根治）。返回 地址寄存器。
不安全 函数 顺序链标识符地址(节点 左, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                     向量<IR指令>& 指令, 整64* 寄存器计数) -> 整64 {
    整64 槽 = 0;
    结果<整64, 整32> 找局 = 局部槽.获取(整64(左.文本));
    如果 (找局.正常) { 槽 = 找局.值; }
    如果 (槽 == 0) {
        结果<整64, 整32> 找参 = 参数槽.获取(整64(左.文本));
        如果 (找参.正常) { 槽 = 找参.值; }
    }
    // 87-a（2026-09-12 第八十七轮）：顶层静态结构体左值链基址——.data 符号地址
    //   （IR_静态地址；值即地址）。原实现落尾端「取槽 0 地址」——静态成员链
    //   赋值/构造字面量脱糖后的逐字段写入全落垃圾基址（探针 P50b v2 实证）。
    // 810（053）：顶层静态 128 位标量同款——.data 双 quad 槽符号地址
    //   （返回语句 retbuf 拷贝源/赋值源=16 字节槽整块地址·查结构体大小=0
    //   不入结构体分支故独立判定）。
    如果 (槽 == 0) {
        整64 找静链 = 查静态序号含类(整64(左.文本));
 如果 (找静链 < 0 && 当前方法类名ID != 0) {
// 070 波G：类内静态字段裸名左值链（合成名静态槽·返回 总数 的返回位等）
找静链 = 查静态序号含类(查类静态字段合成名(当前方法类名ID, 整64(左.文本)));
}
        // 972（深水一）：**用户类静态排除结构体地址语义**（读路径 517-a 同款
        //   守卫）——类布局 查结构体大小>0（映射=56 同族）先命中本分支=槽地址
        //   当对象基址 → 成员写穿槽（[槽+0]=槽本身）。让位下方 972 静态加载
        //   分支（装载槽内容句柄）。
        布尔 静是类链 = 找静链 >= 0 &&
                      是用户类_ID(取静态类型(找静链));
        如果 (找静链 >= 0 && 查结构体大小(取静态类型(找静链)) > 0 &&
             !静是类链) {
            整64 静基reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静基reg, T_整64, 找静链));
            返回 静基reg;
        }
        如果 (找静链 >= 0) {
            字符串 静类型链 = 字符串复制(驻留文本(取静态类型(找静链)));
            如果 (字符串比较(静类型链, "整128") || 字符串比较(静类型链, "正128")) {
                整64 静基reg128 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静基reg128, T_整64,
                                     找静链));
                返回 静基reg128;
            }
            // 890-a（002 攻族·537 B 段根治）：**静态合成体**（结果/可选）左值链
            //   基址——槽内容=**对象指针**（对象由入口注入/堆构造，_cn_gstatic 存
            //   句柄），装载即对象基址（类/容器同款指针槽模型）。原两判据只认
            //   结构体（合成体 查结构体大小==0 不在结构体表）与 128 位 → 落尾端
            //   「取地址 槽0」=未初始化帧槽：`返回 槽`（静态局部合成体）拷贝源
            //   =垃圾地址（537 B 段 v2 值=栈垃圾·888 层⑨登记实证）。
            如果 (是结果类型(静类型链)) {
                整64 静基regH = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_静态加载, 0, 0, 0, 静基regH, T_对象,
                                     找静链));
                返回 静基regH;
            }
            // 972（008 总攻·深水一根治）：**静态类/容器左值链基址**——槽内容=
            //   对象句柄（指针槽模型），装载即对象基址。原判据只认结构体/128/
            //   合成体 → 静态类落尾端「槽0 地址/IR_静态地址」=**槽地址当对象
            //   基址** → 消费端 [槽地址+字段偏移]=[槽内容]=句柄被当字段值
            //   （m574e print_str(句柄)→strlen 崩·rdi=串内容字节铁证）。
            如果 (是用户类(静类型链)) {
                整64 静基regC972 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_静态加载, 0, 0, 0, 静基regC972,
                                     T_对象, 找静链));
                返回 静基regC972;
            }
        }
    }
    // 第七十八轮：方法体字段左值地址（字段.子字段 链式/&字段——局部/参数未命中）
    如果 (槽 == 0) {
        // 293-a（T34 根治·2026-09-17）：方法体左值链根「自身」——镜像 读路径
        //   第七十八轮特判（生成标识符加载）：局部/参数槽未命中且在方法体内
        //   → 加载 this 槽值（对象指针）为链基址。原实现 fall-through 到尾端
        //   IR_取地址(哨兵槽)——成员赋值写穿方法帧（50 构造器 asm 铁证：
        //   自身.计数=0 落方法栈槽、对象字段保持堆垃圾→读取() 出垃圾值；
        //   读路径正确/写路径错=双侧分叉实锤）。
        如果 (当前方法类名ID != 0 && 整64(左.文本) == 整64(驻留("自身"))) {
            整64 自寄存器L = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 当前方法this槽, 0, 0, 自寄存器L,
                                 T_对象, 0));
            返回 自寄存器L;
        }
        整64 字段偏移s = 当前方法字段偏移(整64(左.文本));
        如果 (字段偏移s >= 0) {
            返回 发射类字段地址(字段偏移s, 指令, 寄存器计数);
        }
    }
    整64 寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    // 346-a 补（T58 立案并同轮根治·崩溃级）：用户类对象变量——对象基址 = 槽内容
    //   （Load 槽 = 对象指针），非槽地址。原实现落尾端 IR_取地址（槽地址）→
    //   成员链左值赋值以「槽地址 + 字段偏移」写穿栈槽（探针 p13：盒 甲; 甲.值=42
    //   → v2 rc=139 段错误 vs 宿主 42/43；p11 类字段容器赋值同根因）。类对象
    //   引用参数形态=两级（Load 槽=调用方变量地址 → 指针加载=对象指针）。
    如果 (对象槽是类对象(整64(左.文本))) {
        如果 (槽是引用(槽)) {
            整64 变址reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 槽, 0, 0, 变址reg, T_整64, 0));
            整64 对reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 变址reg, 0, 0, 对reg, T_对象, 0));
            返回 对reg;
        }
        整64 类基reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_加载, 槽, 0, 0, 类基reg, T_对象, 0));
        返回 类基reg;
    }
    如果 (槽是引用(槽)) {
        // ②c D：引用参数——槽内容即左值基址（Load 槽），非槽地址
        IR追加(指令, 建IR指令(IR_加载, 槽, 0, 0, 寄存器, T_整64, 0));
    } 否则 如果 (槽是指针参数(槽) || 局部真指针87(整64(左.文本))) {
        // 第17枚根治：指针参数 p（方法签名* 等）——成员左值 p.字段 基址=
        //   装载指针值（解引用一级，v2.1 用户裁决 p.字段 ≡ (*p).字段）；
        //   旧 IR_取地址 取指针槽自身地址 = 少一层解引用（写穿相邻槽根因）
        // 871-a（070·G-N·870 修复·134 前置）：**局部指针变量**（`点* p2 = &p;`
        //   ——判据 局部真指针87 排除**数组变量**（数组名退化同表命中·253/260 回归实锤）：
        //   `q.x = v`）同款——槽内容=指针值（对象地址），装载即基址；原落
        //   取地址兜底 → 写栈槽附近 → 134 写面错值/崩溃。
        IR追加(指令, 建IR指令(IR_加载, 槽, 0, 0, 寄存器, T_整64, 0));
    } 否则 {
        IR追加(指令, 建IR指令(IR_取地址, 槽, 0, 0, 寄存器, T_整64, 0));
    }
    返回 寄存器;
}

// 顺序链下标地址（94-a）：当前地址 += 下标值 × 元素步进——顺序链中间跳下标
//   （结构体数组元素成员链 表[0].x = v 的左值路径；数组名登记指针变量表=元素类型，
//   步进经 类型名宽度 单点）。下标表达式区间 = [子起点+1, 子终点)（对象在子起点，
//   解析期 解析后缀链 约定）；生成后表达式栈归位（净栈契约）。
不安全 函数 顺序链下标地址(向量<节点> 池, 节点 左, 整64 当前地址,
                    映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                    向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数,
                    整64* 槽计数, 向量<整64>& 表达式栈) -> 整64 {
    // 97-a：元素类型推导统一经 helper（标识符数组变量 / 指针变量 / **结构体字段
    //   数组**（成员对象链）三形态同源）
    整64 元素类型IDq = 0;
    如果 (左.子起点 > 0 && 整64(左.子起点) < 池.大小()) {
        元素类型IDq = 推导下标元素类型ID(池, 整32(左.子起点));
    }
    如果 (元素类型IDq == 0) {
        IR层诊断("顺序链下标对象类型未知（须数组/指针/字段数组）");
        返回 0;
    }
    整64 前深度q = 表达式栈.大小();
    整64 下标值q = 生成表达式(池, 整32(左.子起点 + 1), 整32(左.子终点), 局部槽,
                            参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    表达式栈弹到深度(表达式栈, 前深度q);
    如果 (下标值q == 0) { 返回 0; }
    整64 步进q = 类型名宽度(元素类型IDq);
    整64 缩放q = 下标值q;
    如果 (步进q != 1) {
        整64 步进常量q = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留(整数转字符串(步进q))), 0, 0,
                              步进常量q, T_整64, 0));
        整64 缩放寄存器q = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_乘, 下标值q, 步进常量q, 0, 缩放寄存器q,
                              T_整64, 0));
        缩放q = 缩放寄存器q;
    }
    整64 新地址q = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加, 当前地址, 缩放q, 0, 新地址q, T_整64, 0));
    返回 新地址q;
}

// 顺序链成员字段地址：偏移兜底（附加 -1 → 解析对象结构体ID 分桶查；仍未知
//   IR 层诊断拒绝——毒地址纪律）。返回 新当前地址；0=失败（调用方整体返回 0）。
不安全 函数 顺序链成员地址(向量<节点> 池, 节点 左, 整64 当前地址, 整32 位置, 整32 起点,
                   整64 终点, 向量<IR指令>& 指令, 整64* 寄存器计数) -> 整64 {
    // 第17枚根治·偏移兜底：语法层附加 -1=未知（指针形态/跨文件未标注）——
    //   经 解析对象结构体ID 分桶查偏移（结构体ID*键位移+字段名ID）；仍未知
    //   则 IR 层诊断拒绝发射（IR_字段地址.附加=-1 = 基址-1 毒地址，写穿
    //   相邻槽——v2self 实测根因）。IR 层错误即产物不可信（[ir2] 纪律）
    整64 左值偏移 = 左.附加;
    如果 (左值偏移 < 0 && 位置 > 起点) {
        // 46-b 根治（2026-09-09 第四十八轮）：兜底统一走 解析成员链结构体ID
        //   （标识符行为=解析对象结构体ID 不变；成员链中间跳 a.b.c 的 .c——
        //   对象=成员节点，原解析 0 → 偏移未知诊断拒绝，现递归解父链分桶查）
        整64 左值结构体ID = 解析成员链结构体ID(池, 整32(位置 - 1));
        如果 (左值结构体ID != 0) {
            整64 桶偏左 = 查字段偏移(左值结构体ID, 整64(左.文本));
            如果 (桶偏左 >= 0) { 左值偏移 = 桶偏左; }
        }
    }
    如果 (左值偏移 < 0 && 当前方法类名ID != 0) {
        // 070 波G：类静态字段成员链步进——类方法体裸名静态字段被脱糖成
        //   自身.字段 链（T58·静态字段不入对象布局=偏移 miss）→ 静态槽地址
        //   作链当前地址（终结=返回位按返回类型拷贝；续链=后续成员基址）
        整64 合成c = 查类静态字段合成名(当前方法类名ID, 整64(左.文本));
        如果 (合成c != 0) {
            整64 序c = 查静态序号含类(合成c);
            如果 (序c >= 0) {
                整64 静址c = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静址c, T_整64, 序c));
                返回 静址c;
            }
        }
    }
    如果 (左值偏移 < 0) {
        IR层诊断("成员左值字段偏移未知: " + 驻留文本(整64(左.文本)));
        返回 0;
    }
    整64 寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 当前地址, 0, 0, 寄存器, T_整64, 左值偏移));
    // 847（指针槽语义四件套之②b·左值面）：**中间段**字段类型=容器/类（指针槽·
    //   838/843 模型）——取字段值（对象指针）续链；**最后一段不加载**（要的是字段
    //   槽地址本身，如 &a.内）。与右值面（成员载荷是结构体 847 修复）配对：缺此则
    //   左右值不一致（右值已按指针槽取载、左值仍按值语义内联算地址 → 外层对象被当
    //   内层，克隆/写穿错层）。**本函数为 不安全 函数**——安全区边界（指针下标/
    //   寄存器计数下标）在此合法；生成左值地址（安全函数）不得直接发射。
    如果 (位置 + 1 < 终点) {
        整64 段结构ID847 = 解析成员链结构体ID(池, 位置 - 1);
        如果 (段结构ID847 != 0) {
            整64 段类型ID847 = 查字段类型ID(段结构ID847, 整64(左.文本));
            如果 (段类型ID847 != 0 &&
                 (是容器类_ID(段类型ID847) || 是用户类_ID(段类型ID847))) {
                整64 加载reg847 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_指针加载, 寄存器, 0, 0,
                                     加载reg847, T_对象, 0));
                寄存器 = 加载reg847;
            }
        }
    }
    返回 寄存器;
}

函数 生成左值地址(向量<节点> 池, 整32 起点, 整32 终点,
                 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                 向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数,
                 向量<整64>& 表达式栈) -> 整64 {
    // 顺序遍历左值区间：标识符 -> 槽地址；成员 -> 基于当前基址字段地址；
    //   解引用 -> 其操作数（指针值）即地址。
    // 若区间末尾是 解引用 根节点（*指针）：其操作数即地址，前面节点（指针）跳过
    节点 末节点 = 池.元素(终点 - 1);
    如果 (末节点.类型 == 节点_解引用) {
        // ③ 第三波：只弹到进入前深度（&*p 作调用实参等嵌套形态——清空全栈
        //   会弹掉调用方先序压栈内容，同 取地址 分支根治）
        整64 解引用前深度 = 表达式栈.大小();
        整64 地址 = 生成表达式(池, 末节点.子起点, 末节点.子终点, 局部槽, 参数槽,
                               指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
        当 (表达式栈.大小() > 解引用前深度) {
            结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈.正常) { 运行时错误(4); }
        }
        返回 地址;
    }
    // 引用返回调用左值（2026-09-04 缺陷零容忍收口，宿主 P3-18 对齐）：末节点
    //   =调用（取值(p) = 42 / += 8 / 整64& r = 取值(p)）——调用点默认按右值读
    //   （IR_调用参数化 后 IR_指针加载 值），地址=回扫该 IR_指针加载.操作数1
    //   （即调用返回的左值地址；同 回扫实参取地址 第二遍模式）
    如果 (末节点.类型 == 节点_调用) {
        整64 调用前深度 = 表达式栈.大小();
        整64 值reg = 生成表达式(池, 起点, 终点, 局部槽, 参数槽,
                               指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
        当 (表达式栈.大小() > 调用前深度) {
            结果<空类型, 整32> 删栈c2 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈c2.正常) { 运行时错误(4); }
        }
        如果 (值reg != 0) {
            整64 回c = 指令.大小();
            当 (回c > 0) {
                IR指令 回扫c = 指令.元素(回c - 1);
                如果 (回扫c.操作码 == IR_指针加载 && 回扫c.目标 == 值reg) {
                    返回 回扫c.操作数1;
                }
                回c--;
            }
        }
        返回 值reg;
    }
    // ③ 第三波：下标左值（p[i] = v）——指针对象：地址 = 对象槽值 + 下标×步进
    //   （宿主 ir_expr.cpp:981~1003 对齐）。R3 提取 生成下标左值地址
    如果 (末节点.类型 == 节点_下标 && 末节点.子起点 > 0) {
        返回 生成下标左值地址(池, 末节点, 局部槽, 参数槽, 指令, 寄存器计数,
                              块计数, 槽计数, 表达式栈);
    }
    整64 当前地址 = 0;
    整32 位置 = 起点;
    当 (位置 < 终点) {
        节点 左 = 池.元素(位置);
        如果 (左.类型 == 节点_标识符) {
            当前地址 = 顺序链标识符地址(左, 局部槽, 参数槽, 指令, 寄存器计数);
        } 否则 如果 (左.类型 == 节点_成员 && 左.附加 == 成员方法标记) {
            // 118（929·任务 118）：链中方法调用段（表.元素引用(0).x = 9——
            //   成员带方法标记=非字段偏移，是链内嵌调用）。790-a 同款前瞻定位
            //   调用节点（池布局 [对象..,成员,实参...,调用]·调用.子起点==位置+1）；
            //   段=生成表达式（引用返回已按聚合分叉解引用/直传）→回扫
            //   IR_指针加载 取操作数1=调用原址（末节点=调用 分支同款=左值地址）。
            整64 深度w = 表达式栈.大小();
            整32 调用位w = 0 - 1;
            整32 扫w = 位置 + 2;
            当 (扫w < 整32(池.大小()) && 扫w <= 位置 + 12 && 扫w < 整32(终点)) {
                节点 扫n = 池.元素(扫w);
                如果 (扫n.类型 == 节点_调用 && 扫n.子起点 == 位置 + 1) {
                    调用位w = 扫w;
                    中断;
                }
                扫w++;
            }
            如果 (调用位w < 0) { 调用位w = 整32(终点 - 1); }
            // 段=完整方法调用表达式（**从链头 起**——含接收者；从成员位起=
            //   丢接收者 → this 解析失败取槽垃圾（v2p 实证 rdi=1 崩错误码3）。
            //   接收者重解析幂等（纯地址计算·当前地址 丢弃重算））
            整64 段值w = 生成表达式(池, 起点, 调用位w + 1, 局部槽, 参数槽,
                                    指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
            表达式栈弹到深度(表达式栈, 深度w);
            如果 (段值w != 0) {
                整64 回w = 指令.大小();
                当 (回w > 0) {
                    IR指令 回扫w = 指令.元素(回w - 1);
                    如果 (回扫w.操作码 == IR_指针加载 && 回扫w.目标 == 段值w) {
                        段值w = 回扫w.操作数1;
                        中断;
                    }
                    回w--;
                }
            }
            当前地址 = 段值w;
            如果 (当前地址 == 0) { 返回 0; }
            位置 = 调用位w;
        } 否则 如果 (左.类型 == 节点_成员) {
            当前地址 = 顺序链成员地址(池, 左, 当前地址, 位置, 起点, 终点, 指令, 寄存器计数);
            如果 (当前地址 == 0) { 返回 0; }        } 否则 如果 (左.类型 == 节点_下标) {
            // 94-a（2026-09-13 第九十四轮）：顺序链中间跳下标（结构体数组元素
            //   成员链 表[0].x = v / 表[i].x = v；也覆盖 p[i].字段）——当前地址
            //   += 下标值 × 元素步进。原实现无此分支：链上下标被**静默跳过**
            //   → 元素索引恒 0（arr5 探针实证：表[1].x 写入落在表[0].x）
            当前地址 = 顺序链下标地址(池, 左, 当前地址, 局部槽, 参数槽, 指令,
                                      寄存器计数, 块计数, 槽计数, 表达式栈);
            如果 (当前地址 == 0) { 返回 0; }
        } 否则 如果 (左.类型 == 节点_解引用) {
            当前地址 = 生成表达式(池, 左.子起点, 左.子终点, 局部槽, 参数槽,
                                   指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
            当 (表达式栈.大小() > 0) {
                结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删栈.正常) { 运行时错误(4); }
            }
        }
        位置++;
    }
    返回 当前地址;
}

// 418-a（D40 细分）：枚举成员链常量折叠发射——错误码.内存 → IR_常量整数
//   （成员值=解析期数字文本转数值·此处转回文本 ID 直传=整数字面量同机制·
//   汇编器负责数值落地）。不安全 修饰=寄存器计数 指针下标读写安全区挂点。
不安全 函数 生成枚举成员常量(向量<节点> 池, 节点 n, 向量<IR指令>& 指令,
                       整64* 寄存器计数, 向量<整64>& 表达式栈) -> 空类型 {
    节点 基名节点e = 池.元素(整32(n.子起点));
    整64 成员值e = 查枚举成员值(整64(基名节点e.文本), 整64(n.文本));
    IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(成员值e)), 0, 0,
                         寄存器计数[0], T_整32, 0));
    登记寄存器类型(寄存器计数[0], T_整32);
    结果<空类型, 整32> 加栈e = 表达式栈.追加(寄存器计数[0]);
    如果 (!加栈e.正常) { 运行时错误(4); }
    寄存器计数[0] = 寄存器计数[0] + 1;
}

不安全 函数 生成下标左值标识符分支(向量<节点> 池, 节点 末节点, 节点 下标对象左值, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽, 向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数, 向量<整64>& 表达式栈) -> 整64 {
        整64 查所指左 = 查指针变量类型(整64(下标对象左值.文本));
        如果 (查所指左 >= 0) {
            // 对象指针值：槽 Load（局部/参数——指针参数为普通值槽非引用）
            整64 对象槽下 = 0;
            结果<整64, 整32> 找局下 = 局部槽.获取(整64(下标对象左值.文本));
            如果 (找局下.正常) { 对象槽下 = 找局下.值; }
            如果 (对象槽下 == 0) {
                结果<整64, 整32> 找参下 = 参数槽.获取(整64(下标对象左值.文本));
                如果 (找参下.正常) { 对象槽下 = 找参下.值; }
            }
            如果 (对象槽下 != 0) {
                整64 指针值 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                // 94-a（2026-09-13）：数组对象下标左值——基址=**槽地址**（数组名
                //   退化为元素指针；数组槽里是元素数据而非指针，Load 会取首 8 字节
                //   数据当指针 → 段错误〈探针 arr1 实证：r10=0x200000009=数组内容〉）。
                //   判定=当前函数变量类型是数组文本；非数组（真指针变量）保持 Load。
                布尔 数组对象左A = 假;
                整64 对象数组类型A = 查当前函数变量类型(整64(下标对象左值.文本));
                如果 (对象数组类型A >= 0) {
                    如果 (是数组类型文本_ID(对象数组类型A)) {
                        数组对象左A = 真;
                    }
                }
                如果 (数组对象左A) {
                    IR追加(指令, 建IR指令(IR_取地址, 对象槽下, 0, 0, 指针值,
                                          T_整64, 0));
                } 否则 {
                    IR追加(指令, 建IR指令(IR_加载, 对象槽下, 0, 0, 指针值, T_整64, 0));
                }
                // 下标表达式区间 [子起点+1, 子终点)（子起点=对象单节点）；
                //   只弹到进入前深度（&p[i] 作调用实参等嵌套形态）
                整64 下标前深度 = 表达式栈.大小();
                整64 下标值左 = 生成表达式(池, 末节点.子起点 + 1, 末节点.子终点,
                                            局部槽, 参数槽, 指令, 寄存器计数,
                                            块计数, 槽计数, 表达式栈);
                当 (表达式栈.大小() > 下标前深度) {
                    结果<空类型, 整32> 删栈下 = 表达式栈.删除(表达式栈.大小() - 1);
                    如果 (!删栈下.正常) { 运行时错误(4); }
                }
                整64 步进左 = 类型名宽度(查所指左);
                // 908（任务 092·与读侧 94-a 发射数组越界检查对称）：数组下标**写**
                //   越界检查（下标 >= 长度 → 运行时错误(2)·错误码与读侧/宿主同码）——
                //   长度经 读侧同款推导 helper（标识符数组变量/结构体字段数组同源）；
                //   指针对象无长度信息（长度 0）=不发射（读侧同口径·既有边界）。
                整64 数组长度写a = 推导下标数组长度(池, 整32(末节点.子起点));
                如果 (数组长度写a > 0) {
                    发射数组越界检查(下标值左, 数组长度写a, 指令, 寄存器计数, 块计数);
                }
                整64 缩放值左 = 下标值左;
                如果 (步进左 != 1) {
                    整64 步进常量左 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_常量整数,
                                         整64(驻留(整数转字符串(步进左))), 0, 0,
                                         步进常量左, T_整64, 0));
                    整64 缩放寄存器左 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_乘, 下标值左, 步进常量左, 0,
                                         缩放寄存器左, T_整64, 0));
                    缩放值左 = 缩放寄存器左;
                }
                整64 元素地址左 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_加, 指针值, 缩放值左, 0, 元素地址左, T_整64, 0));
                返回 元素地址左;
            }
        }
    返回 0;
}

不安全 函数 生成下标左值成员下标分支(向量<节点> 池, 节点 末节点, 节点 下标对象左值, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽, 向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数, 向量<整64>& 表达式栈) -> 整64 {
            整64 元素类型m97 = 推导下标元素类型ID(池, 整32(末节点.子起点));
            如果 (元素类型m97 != 0) {
                整32 根m97 = 对象链根索引(池, 整32(末节点.子起点));
                整64 基址m97 = 生成左值地址(池, 根m97, 整32(末节点.子起点) + 1,
                                            局部槽, 参数槽, 指令, 寄存器计数,
                                            块计数, 槽计数, 表达式栈);
                如果 (基址m97 == 0) { 返回 0; }
                // 673（051 主线·成员链下标基址解引补全·444-b/433-b 同族第三缺口）：
                //   下标对象为成员链且其**尾字段/尾层为 T\* 指针**时，上面 生成左值地址
                //   产出的是「链上末级字段的槽地址」（对象壳内偏移），下标基址须是其
                //   **值**（堆数组基址）——过 IR_指针加载 解引取值（指针语义·与裸字段
                //   分支 433-b 同构）。缺此解引 → 元素地址=壳内槽地址+i×步进（野写
                //   栈壳后方/读壳内垃圾）：映射 拷贝构造 `值数组[i] = 复制(其他.值数组[i])`
                //   op=61 源地址落壳+8+i×32（M2 探针：副本值数组内容全垃圾·键数组
                //   同形态幸存对比=标量写走普通赋值左值路径有解引）。推导 miss/非指针
                //   （含内联数组字段 [N] 尾缀）=原路零变化。
                如果 (下标对象左值.类型 == 节点_成员 || 下标对象左值.类型 == 节点_下标) {
                    整64 链类型c = 推导成员链类型ID(池, 整32(末节点.子起点));
                    如果 (链类型c > 0) {
                        字符串 链文本c = 字符串复制(驻留文本(链类型c));
                        整64 文本长c = 字符串长度(链文本c);
                        如果 (文本长c > 0 && ((整64(链文本c[整32(文本长c - 1)]) & 255) == 42)) {
                            整64 解引基址c = 寄存器计数[0];
                            寄存器计数[0] = 寄存器计数[0] + 1;
                            IR追加(指令, 建IR指令(IR_指针加载, 基址m97, 0, 0,
                                                  解引基址c, T_整64, 0));
                            基址m97 = 解引基址c;
                        }
                    }
                }
                整64 下标前深度m97 = 表达式栈.大小();
                整64 下标值m97 = 生成表达式(池, 末节点.子起点 + 1, 末节点.子终点,
                                            局部槽, 参数槽, 指令, 寄存器计数,
                                            块计数, 槽计数, 表达式栈);
                表达式栈弹到深度(表达式栈, 下标前深度m97);
                整64 步进m97 = 类型名宽度(元素类型m97);
                // 908（任务 092·读侧 94-a 对称）：成员链字段数组的下标写越界检查
                //   （o.f[i]=x / 字段[下标]=值·错误码 2 同读侧同宿主）
                整64 数组长度写m = 推导下标数组长度(池, 整32(末节点.子起点));
                如果 (数组长度写m > 0) {
                    发射数组越界检查(下标值m97, 数组长度写m, 指令, 寄存器计数, 块计数);
                }
                整64 缩放m97 = 下标值m97;
                如果 (步进m97 != 1) {
                    整64 步进常量m97 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_常量整数,
                                          整64(驻留(整数转字符串(步进m97))), 0, 0,
                                          步进常量m97, T_整64, 0));
                    整64 缩放寄存器m97 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_乘, 下标值m97, 步进常量m97, 0,
                                          缩放寄存器m97, T_整64, 0));
                    缩放m97 = 缩放寄存器m97;
                }
                整64 元素地址m97 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_加, 基址m97, 缩放m97, 0,
                                      元素地址m97, T_整64, 0));
                返回 元素地址m97;
            }
    返回 0;
}

不安全 函数 生成下标左值裸字段分支(向量<节点> 池, 节点 末节点, 节点 下标对象左值, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽, 向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数, 向量<整64>& 表达式栈) -> 整64 {
            整64 查所指f = 查指针变量类型(整64(下标对象左值.文本));
            如果 (查所指f < 0) {            整64 字段偏f = 当前方法字段偏移(整64(下标对象左值.文本));
                如果 (字段偏f >= 0) {
                    // 444-b：类型来源双源——布局字段类型表优先（星号已同步），
                    //   函数级权威表兜底
                    整64 字段类型IDf = 查字段类型ID(当前方法类名ID, 整64(下标对象左值.文本));
                    如果 (字段类型IDf < 0) {
                        字段类型IDf = 查当前函数变量类型(整64(下标对象左值.文本));
                    }
                    如果 (字段类型IDf >= 0) {
                    字符串 字段类型文本f = 字符串复制(驻留文本(字段类型IDf));
                    整64 文本长f = 字符串长度(字段类型文本f);
                    布尔 指针字段f = 假;
                    如果 (文本长f > 0 && ((整64(字段类型文本f[整32(文本长f - 1)]) & 255) == 42)) {
                        指针字段f = 真;
                    }
                    整64 基类型IDf = 字段类型IDf;
                    如果 (指针字段f) {
                        基类型IDf = 整64(驻留(字符串子串(字段类型文本f, 0, 整32(文本长f - 1))));
                    }
                    整64 步进f = 类型名宽度(基类型IDf);                如果 (步进f <= 0) { 步进f = 8; }
                    整64 基址f = 0;
                    如果 (指针字段f) {
                        整64 字段地址f = 发射类字段地址(字段偏f, 指令, 寄存器计数);
                        基址f = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        // 433-b 根治：字段地址=寄存器（指针语义）→ 过指针加载取字段值
                        //   （IR_加载=槽加载——原发 IR_加载(寄存器)=读错槽→基址垃圾
                        //   →456/123 下标写 SEGV 实测）
                        IR追加(指令, 建IR指令(IR_指针加载, 字段地址f, 0, 0, 基址f, T_整64, 0));
                    } 否则 {
                        基址f = 发射类字段地址(字段偏f, 指令, 寄存器计数);
                    }
                    整64 下标前深度f = 表达式栈.大小();                整64 下标值f = 生成表达式(池, 末节点.子起点 + 1, 末节点.子终点,
                                                局部槽, 参数槽, 指令, 寄存器计数,
                                                块计数, 槽计数, 表达式栈);                当 (表达式栈.大小() > 下标前深度f) {
                        结果<空类型, 整32> 删栈f = 表达式栈.删除(表达式栈.大小() - 1);
                        如果 (!删栈f.正常) { 运行时错误(4); }
                    }
                    整64 缩放值f = 下标值f;
                    // 908（任务 092·读侧 94-a 对称）：方法体内裸字段数组的下标写
                    //   越界检查（数据[位置]=值 形态·错误码 2 同读侧同宿主）——
                    //   指针字段（指针字段f=真）无长度不发射
                    整64 数组长度写f = 推导下标数组长度(池, 整32(末节点.子起点));
                    如果 (数组长度写f > 0) {
                        发射数组越界检查(下标值f, 数组长度写f, 指令, 寄存器计数, 块计数);
                    }
                    如果 (步进f != 1) {                    整64 步进常量f = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_常量整数,
                                             整64(驻留(整数转字符串(步进f))), 0, 0,
                                             步进常量f, T_整64, 0));
                        整64 缩放寄存器f = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_乘, 下标值f, 步进常量f, 0,
                                             缩放寄存器f, T_整64, 0));
                        缩放值f = 缩放寄存器f;
                    }
                    整64 元素地址f = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_加, 基址f, 缩放值f, 0, 元素地址f, T_整64, 0));                返回 元素地址f;
                    }
                }
            }
    返回 0;
}

