// CN 自举编译器 v2 · 生成表达式（千行拆分子模块，2026-09-08 用户裁决阶段目录包）
// 职责：表达式后缀求值（生成表达式）+ 左值地址生成（生成左值地址）——自
//   IR生成.cn 机械搬移；寄存器/引用参数/实参结构等权威表经 公开: 访问
//   函数（IR生成 主干）；模块路径=生成表达式（新键基）。
导入 容器::向量;
导入 语法;       // Token/AST 节点池（原 导入 语法分析，目录包名）
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码（目录包名）
导入 IR生成;     // 函数级变量类型权威表/重载决议/控制流辅助（同包幂等）
导入 生成表达式求值; // 调用族+下标族六函数（R3 拆分，单向依赖无循环）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// ==================== 表达式求值辅助（R3 千行函数拆分，2026-09-08） ====================
// 以下 5 个辅助函数自 生成表达式 主函数同体提取（逐字节等价变换：逻辑原样，
//   唯一改动=局部副本化与出口改返回）。纪律：容器出参一律 引用&（成熟形态），
//   容器按值返回/嵌套容器静态追加禁用（lessons 15 枚句柄悬垂同族）。

// 预扫描 前缀一元（取地址/负号/逻辑非/解引用）子区间——其操作数不单独生成
//   （避免重复指令；130 负下标缺陷家族）。平铺区间对 [起,终,...] 经出参返回。
函数 收集取址区间(向量<节点> 池, 整32 起点, 整32 终点, 向量<整64>& 区间们) -> 空类型 {
    整32 预扫 = 起点;
    当 (预扫 < 终点) {
        节点 预节点 = 池.元素(预扫);
        如果 (预节点.类型 == 节点_取地址 || 预节点.类型 == 节点_负号 ||
             预节点.类型 == 节点_逻辑非 || 预节点.类型 == 节点_解引用) {
            如果 (预节点.子起点 < 预节点.子终点) {
                结果<空类型, 整32> 加区 = 区间们.追加(整64(预节点.子起点));
                如果 (!加区.正常) { 运行时错误(4); }
                结果<空类型, 整32> 加区2 = 区间们.追加(整64(预节点.子终点));
                如果 (!加区2.正常) { 运行时错误(4); }
            }
        }
        预扫++;
    }
}

// 84-a：预扫描 结构体字面量构造 的**值区间**（[构造.子起点, 构造.子终点) 含
//   值表达式与字段初值节点）——主遍历跳过（由 结构体构造 节点统一求值，
//   避免值表达式被主循环重复求值=副作用/多次分配）；跳过终点恰为构造节点位置。
// 84-c：**只保留最外层**构造区间——嵌套字面量（`外盒{ 内 = 内盒{ 名 = 串 } }`）的
//   内层构造区间被外层包含；若内层区间也入表，主遍历在共享起点处取「第一个匹配」
//   （=内层，区间更短）→ 先处理内层构造（**第一次求值**），外层生成函数求值字段值时
//   再求值一次 → 内层字面量被求值两次（其一分配泄漏；探针 P26② 实证：两次
//   __cn_str_copy、仅一次 __cn_str_free、残留 1）。过滤=两两包含判定剔除内层。
函数 收集构造区间(向量<节点> 池, 整32 起点, 整32 终点, 向量<整64>& 区间们) -> 空类型 {
    向量<整64> 候选们 = 向量<整64>();
    整32 预扫 = 起点;
    当 (预扫 < 终点) {
        节点 预节点 = 池.元素(预扫);
        如果 (预节点.类型 == 节点_结构体构造) {
            如果 (预节点.子起点 < 预节点.子终点) {
                结果<空类型, 整32> 加区 = 候选们.追加(整64(预节点.子起点));
                如果 (!加区.正常) { 运行时错误(4); }
                结果<空类型, 整32> 加区2 = 候选们.追加(整64(预节点.子终点));
                如果 (!加区2.正常) { 运行时错误(4); }
            }
        }
        预扫++;
    }
    整64 i = 0;
    当 (i < 候选们.大小()) {
        整64 起i = 候选们.元素(i);
        整64 终i = 候选们.元素(i + 1);
        布尔 被包含 = 假;
        整64 j = 0;
        当 (j < 候选们.大小()) {
            如果 (j != i) {
                整64 起j = 候选们.元素(j);
                整64 终j = 候选们.元素(j + 1);
                如果 (起j <= 起i && 终i <= 终j && (起j < 起i || 终i < 终j)) { 被包含 = 真; }
            }
            j += 2;
        }
        如果 (!被包含) {
            结果<空类型, 整32> 加区o = 区间们.追加(起i);
            如果 (!加区o.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加区o2 = 区间们.追加(终i);
            如果 (!加区o2.正常) { 运行时错误(4); }
        }
        i += 2;
    }
}

// 预扫描 短路运算符（&&/||）操作数区间（语法层标注：附加=右起点）——主遍历
//   跳过，运算符节点处延迟求值。三元平铺 [起,中,终,...]（检查用起/终两元）。
函数 收集短路区间(向量<节点> 池, 整32 起点, 整32 终点, 向量<整64>& 区间们) -> 空类型 {
    整32 预扫 = 起点;
    当 (预扫 < 终点) {
        节点 预节点 = 池.元素(预扫);
        如果 (预节点.类型 == 节点_二元运算 && 预节点.子终点 != 0) {
            字符串 op名 = 字符串复制(驻留文本(整64(预节点.文本)));
            如果 (字符串比较(op名, "&&") || 字符串比较(op名, "||")) {
                结果<空类型, 整32> 加逻 = 区间们.追加(整64(预节点.子起点));
                如果 (!加逻.正常) { 运行时错误(4); }
                结果<空类型, 整32> 加逻2 = 区间们.追加(预节点.附加);
                如果 (!加逻2.正常) { 运行时错误(4); }
                结果<空类型, 整32> 加逻3 = 区间们.追加(整64(预节点.子终点));
                如果 (!加逻3.正常) { 运行时错误(4); }
            }
        }
        预扫++;
    }
}

// 预扫描 三元运算三段区间（[子起点, 子终点) 全跳——条件/真值/假值延迟到三元
//   节点处惰性生成：仅选中分支求值，规范 01b 5.8）。平铺区间对 [起,终,...]。
函数 收集三元区间(向量<节点> 池, 整32 起点, 整32 终点, 向量<整64>& 区间们) -> 空类型 {
    整32 预扫 = 起点;
    当 (预扫 < 终点) {
        节点 预节点 = 池.元素(预扫);
        如果 (预节点.类型 == 节点_三元运算) {
            结果<空类型, 整32> 加三 = 区间们.追加(整64(预节点.子起点));
            如果 (!加三.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加三2 = 区间们.追加(整64(预节点.子终点));
            如果 (!加三2.正常) { 运行时错误(4); }
        }
        预扫++;
    }
}

// 位置 是否落在平铺区间们内（步长=每组元素数：取址/三元=2、短路=3）。
//   命中返回该组终点（主循环跳到），未命中返回 -1。
函数 区间终点(向量<整64>& 区间们, 整32 位置, 整64 步长) -> 整64 {
    整64 i = 0;
    当 (i < 区间们.大小()) {
        整64 起 = 区间们.元素(i);
        整64 终 = 区间们.元素(i + 步长 - 1);
        如果 (整64(位置) >= 起 && 整64(位置) < 终) {
            返回 终;
        }
        i += 步长;
    }
    返回 0 - 1;
}

// 字面量节点（整/布尔/字符串）发射常量寄存器并入栈，返回 压栈寄存器。
不安全 函数 生成字面量(节点 n, 向量<IR指令>& 指令, 整64* 寄存器计数, 向量<整64>& 表达式栈) -> 整64 {
    整64 寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    如果 (n.类型 == 节点_整数字面量) {
        // 常量整数：操作数1=Symbol ID（文本），类型=整64
        IR追加(指令, 建IR指令(IR_常量整数, 整64(n.文本), 0, 0, 寄存器, T_整64, 0));
        登记寄存器类型(寄存器, T_整64);
    } 否则 如果 (n.类型 == 节点_布尔字面量) {
        // 灰色点①根治（2026-09-04）：真/假 独立节点——常量 1/0 登记 T_布尔
        //   （打印分派 __cn_print_bool 输出 真/假、拼接 from_bool 自动分派）
        IR追加(指令, 建IR指令(IR_常量整数, 整64(n.文本), 0, 0, 寄存器, T_布尔, 0));
        登记寄存器类型(寄存器, T_布尔);
    } 否则 如果 (n.类型 == 节点_字符字面量) {
        // 95-a（2026-09-13 第九十五轮）：字符字面量——文本=Unicode 码点数字ID
        //   （词法层解码）→ IR_常量整数 + T_字符 登记（打印分派按数值输出 ASCII/
        //   码点，与宿主 字符=i32 存储 + 打印整数语义同构；规范 01b 三）
        IR追加(指令, 建IR指令(IR_常量整数, 整64(n.文本), 0, 0, 寄存器, T_字符, 0));
        登记寄存器类型(寄存器, T_字符);
    } 否则 如果 (n.类型 == 节点_浮点字面量) {
        // 89-a（2026-09-12 第八十九轮）：浮点字面量（浮64）——IR_常量浮点
        //   （操作数1=文本 Symbol ID；代码生成侧经 浮点文本净 剥 L/U 尾缀后
        //   .double/REAL8 文本直通发射——IEEE754 位模式由汇编器解析，编译期
        //   零开销）+ T_浮64 登记（打印分派/拼接消费）。
        //   缺陷背景（88-b 出口校验探针实证）：原实现主循环无此分派 + 本函数
        //   无此分支 → 浮点字面量被**静默跳过**——二元弹栈判定退化（操作数
        //   缺失 → 左右均取寄存器 0 → `cmp x,x` 恒真）、净栈 +2 契约违反、
        //   静态浮点初值注入落空（87-a 注入经 生成表达式 求值）。E2E 246 原
        //   「巧合通过」=双重侥幸，宿主同形态正确。
        IR追加(指令, 建IR指令(IR_常量浮点, 整64(n.文本), 0, 0, 寄存器, T_浮64, 0));
        登记寄存器类型(寄存器, T_浮64);
    } 否则 {
        // P7b 字符串字面量：IR_常量字符串（操作数1=驻留文本ID）——代码生成
        //   发射 .code 段内 strData_<ID> 数据标签地址
        IR追加(指令, 建IR指令(IR_常量字符串, 整64(n.文本), 0, 0, 寄存器, T_字符串, 0));
        登记寄存器类型(寄存器, T_字符串);
    }
    结果<空类型, 整32> 加 = 表达式栈.追加(寄存器);
    如果 (!加.正常) { 运行时错误(4); }
    返回 寄存器;
}

// 标识符加载：参数槽 优先，其次 局部槽；未命中查 顶层常量（内联 IR_常量整数）/
//   顶层静态（IR_静态加载）/函数名兜底（压负数符号）；引用参数按类型分流
//   （发射引用参数读）。全部出口等价消费 1 个位置（主循环统一 位置++）。
不安全 函数 生成标识符加载(节点 n, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                   向量<IR指令>& 指令, 整64* 寄存器计数, 向量<整64>& 表达式栈) -> 空类型 {
    整64 槽 = 0;
    结果<整64, 整32> 找参 = 参数槽.获取(整64(n.文本));
    如果 (找参.正常) { 槽 = 找参.值; }
    如果 (槽 == 0) {
        结果<整64, 整32> 找局 = 局部槽.获取(整64(n.文本));
        如果 (找局.正常) { 槽 = 找局.值; }
    }
    如果 (槽 == 0) {
        // 第七十八轮（2026-09-12）：方法体 this 引用——「自身」标识符（宿主
        //   方法体参数名同款）→ this 槽加载（对象指针；自身.方法() 调用链/
        //   自身作实参均经此出口）
        如果 (当前方法类名ID != 0 && 整64(n.文本) == 整64(驻留("自身"))) {
            整64 自寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 当前方法this槽, 0, 0, 自寄存器,
                                 T_对象, 0));
            结果<空类型, 整32> 加自 = 表达式栈.追加(自寄存器);
            如果 (!加自.正常) { 运行时错误(4); }
            返回;
        }
        // 第七十八轮（2026-09-12）：方法体字段分派——类方法内字段名裸标识符
        //   （局部/参数槽未命中后）→ this 槽加载 + 字段地址 + 指针加载（类区间
        //   字段；当前方法上下文由 生成类.生成方法 设置——非方法体恒 miss）
        整64 字段偏移g = 当前方法字段偏移(整64(n.文本));
        如果 (字段偏移g >= 0) {
            发射类字段读取(字段偏移g, 整64(n.文本), 指令, 寄存器计数, 表达式栈);
            返回;
        }
        // P7a：顶层常量——命中则内联 IR_常量整数（操作数1=值文本ID，
        //   代码生成经 驻留文本 还原立即数）。参数/局部未命中才查，
        //   局部变量遮蔽同名常量语义正确。
        // plans/018 常量分桶：查常量值 三级解析（本模块键基＞纯名＞候选——
        //   限定文本 甲::版本 拆分直查；修复前纯名平铺跨模块覆盖串值）
        整64 常值 = 查常量值(整64(n.文本));
        如果 (常值 != 0) {
            整64 常寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_常量整数, 常值, 0, 0, 常寄存器, T_整64, 0));
            结果<空类型, 整32> 加常 = 表达式栈.追加(常寄存器);
            如果 (!加常.正常) { 运行时错误(4); }
            返回;
        }
        // ②c C：顶层静态——命中序号则 IR_静态加载（.data _cn_gstatic_N 槽：
        //   容器=堆对象指针；标量=初始值）。常量/局部/参数之后、函数名兜底之前。
        //   87-a（2026-09-12 第八十七轮）：静态**结构体**——值=**地址**
        //   （IR_静态地址，与局部结构体变量同款「表达式值为结构体地址」约定）。
        //   原实现无条件 IR_静态加载（读首 8 字节）：结构体实参/整体拷贝/成员链
        //   基址把首字段句柄当结构体地址（探针 P50b v2 实证：跨函数写读全错）。
        //   其余（标量=值；容器/类=堆对象指针）保持 IR_静态加载（指针槽模型）。
        整64 找静 = 查静态序号(整64(n.文本));
        如果 (找静 >= 0) {
            整64 静寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            如果 (查结构体大小(取静态类型(找静)) > 0) {
                IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静寄存器, T_整64, 找静));
                // 87-a：登记 T_对象（值即地址）——回扫实参取地址不得改写
                //   （与 86-a 三元地址化同款；否则符号地址被当"值装载"改取槽）
                登记寄存器类型(静寄存器, T_对象);
            } 否则 {
                // 87-a：类型码按静态类型表分派（原硬编码 T_整64）——字符串/字符*
                //   须 T_字符串（打印/拼接按字符串分派；原按整64 分派打印出句柄
                //   数值，探针 s9-v2「串值=[94113…]」实证）；容器/类 T_对象；
                //   标量按 类型码 表（整32/正64/浮64… 各自精确）。
                整64 静类型码 = 类型码(取静态类型(找静));
                IR追加(指令, 建IR指令(IR_静态加载, 0, 0, 0, 静寄存器, 静类型码,
                                             找静));
                如果 (静类型码 != T_未知) { 登记寄存器类型(静寄存器, 静类型码); }
            }
            结果<空类型, 整32> 加静 = 表达式栈.追加(静寄存器);
            如果 (!加静.正常) { 运行时错误(4); }
            返回;
        }
        // 函数名（调用 被调对象）：压 负数符号 到 表达式栈（0-符号ID），
        //   非变量（参数/局部 查无）——语义层已检查未声明
        结果<空类型, 整32> 加函 = 表达式栈.追加(0 - 整64(n.文本));
        如果 (!加函.正常) { 运行时错误(4); }
        返回;
    }
    整64 寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    // ②c D：引用参数——按类型分流发射（容器& 双重解引用/结构体& 基址/标量& 解引用）
    如果 (槽是引用(槽)) {
        发射引用参数读(槽, 指令, 寄存器计数, 表达式栈);
        返回;
    }
    // 94-a（2026-09-13 第九十四轮）：数组变量——标识符值 = **基址地址**（数组名
    //   退化为元素指针，宿主 ir.cpp「数组名引用为元素指针」同构）：IR_取地址
    //   （基址槽=槽起+槽数-1 低地址）→ 元素指针。下标读/左值写/作实参/指针
    //   运算全链零拷贝消费（指针路径复用）；原实现 Load 槽值=数组首 8 字节数据
    //   当指针用（错误）。
    如果 (整64(解析标识符类型ID(整64(n.文本))) >= 0) {
        字符串 标识文本v = 字符串复制(
            驻留文本(解析标识符类型ID(整64(n.文本))));
        如果 (是数组类型文本(标识文本v)) {
            IR追加(指令, 建IR指令(IR_取地址, 槽, 0, 0, 寄存器, T_整64, 0));
            登记寄存器类型(寄存器, T_整64);
            结果<空类型, 整32> 加数组v = 表达式栈.追加(寄存器);
            如果 (!加数组v.正常) { 运行时错误(4); }
            返回;
        }
    }
    IR追加(指令, 建IR指令(IR_加载, 槽, 0, 0, 寄存器, T_整64, 0));
    // ③ 缺陷①根治：变量/参数类型登记（打印分派/拼接转换——字符串/浮点/布尔
    //   全覆盖；经 函数级权威表+类型码，未登记=未知按整数兜底）
    整64 标识类型码 = 类型码(解析标识符类型ID(整64(n.文本)));
    如果 (标识类型码 != T_未知) {
        登记寄存器类型(寄存器, 标识类型码);
    }
    结果<空类型, 整32> 加 = 表达式栈.追加(寄存器);
    如果 (!加.正常) { 运行时错误(4); }
}

// 短路求值（缺陷B 根治，规范 930）：&&/|| 左操作数先行、右操作数惰性——
//   a 假/真 短路保留 a；右值经临时槽汇合，逻辑非×2 规范化 0/1（对标 C 语义值）。
//   递归生成 左/右子区间；出口等价消费 1 个位置（主循环统一 位置++）。
不安全 函数 生成短路求值(向量<节点> 池, 节点 n, 字符串 op名, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                 向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数,
                 向量<整64>& 表达式栈) -> 空类型 {
    // 88-a（2026-09-12 第八十八轮）根治：原实现「只压不弹」——左/右递归子区间
    //   各 +1、末尾结果再 +1（净 **+3**），破坏「表达式求值净栈 +1」契约 → 实参位
    //   短路 `f(a || b)` 经 生成调用 弹（实参数+被调）弹到左操作数寄存器=被调错位
    //   （`[ir2] 调用被调对象非函数名/方法` + 运行时错误6；87-a 探针 v2w 实证，
    //   宿主同形态正确）。修法=与 生成三元运算 同构的「递归子区间 + 归位」：
    //   每段递归后 表达式栈弹到深度（左/右值已由返回值持有，栈上副本即丢弃；
    //   子区间内层残留一并自愈清理），末尾压唯一结果（净 +1）。
    //   87-a 曾尝试「栈基线净化」未果（残留在本层之外），本轮以归位原语统一收口
    //   （IR生成.表达式栈弹到深度/表达式栈归位压回——净栈契约单一事实源）。
    整64 进入深度 = 表达式栈.大小();
    整64 左寄存器 = 生成表达式(池, n.子起点, 整32(n.附加), 局部槽, 参数槽,
                              指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    表达式栈弹到深度(表达式栈, 进入深度);
    整64 临时槽 = 槽计数[0];
    槽计数[0] = 槽计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 临时槽));   // 帧登记（扫描函数 据此计帧）
    IR追加(指令, 建IR指令(IR_存储, 左寄存器, 0, 0, 0, 0, 临时槽));
    整64 汇合块 = 块计数[0] + 1;
    块计数[0] = 块计数[0] + 2;
    整64 求值块 = 汇合块 + 1;
    如果 (字符串比较(op名, "&&")) {
        // && ：a 真 -> 求值 b（假短路，保留 a=0）
        IR追加(指令, 建IR指令(IR_条件跳转, 左寄存器, 求值块, 汇合块, 0, 0, 0));
    } 否则 {
        // || ：a 假 -> 求值 b（真短路，保留 a）
        IR追加(指令, 建IR指令(IR_条件跳转, 左寄存器, 汇合块, 求值块, 0, 0, 0));
    }
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 求值块));
    整64 右寄存器 = 生成表达式(池, 整32(n.附加), n.子终点, 局部槽, 参数槽,
                              指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    表达式栈弹到深度(表达式栈, 进入深度);
    IR追加(指令, 建IR指令(IR_存储, 右寄存器, 0, 0, 0, 0, 临时槽));
    IR追加(指令, 建IR指令(IR_跳转, 0, 0, 0, 0, 0, 汇合块));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 汇合块));
    整64 载入寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 临时槽, 0, 0, 载入寄存器, T_整64, 0));
    整64 非寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_逻辑非, 载入寄存器, 0, 0, 非寄存器, T_整64, 0));
    整64 逻辑结果 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_逻辑非, 非寄存器, 0, 0, 逻辑结果, T_整64, 0));
    登记寄存器类型(逻辑结果, T_布尔);
    结果<空类型, 整32> 加逻 = 表达式栈.追加(逻辑结果);
    如果 (!加逻.正常) { 运行时错误(4); }
}

// 末端节点类型码推导（拼接双侧兜底共用——原左/右两段同构，R3 合并消重）：
//   字符串字面量直判；否则 解析节点类型ID；调用被调再查 内置返回表/函数返回回退。
//   返回 类型码（0=未登记）。
函数 推导末端类型码(向量<节点> 池, 整32 末端位置) -> 整64 {
    节点 末端 = 池.元素(末端位置);
    整64 类型ID = 0;
    如果 (末端.类型 == 节点_字符串字面量) {
        类型ID = 驻留("字符串");
    } 否则 {
        类型ID = 解析节点类型ID(池, 末端位置);
        如果 (类型ID == 0 && 末端.类型 == 节点_调用 && 末端.子起点 > 0) {
            节点 被调 = 池.元素(整32(末端.子起点));
            如果 (被调.类型 == 节点_标识符) {
                类型ID = 内置函数返回类型ID(驻留文本(整64(被调.文本)));
                如果 (类型ID == 0) {
                    类型ID = 查函数返回回退(整64(被调.文本));
                }
            }
        }
    }
    返回 类型码(类型ID);
}

// 字符串拼接发射：数值侧隐式转换（from_int/from_float/from_bool，宿主 Task 2.9——
//   未登记类型按整数兜底）+ __cn_str_concat 裸 ASCII 直调（实参位 0/1，产物登记
//   T_字符串——链式外层判定用）。
不安全 函数 发射字符串拼接(整64 拼接左码, 整64 拼接右码, 整64 左, 整64 右,
                   向量<IR指令>& 指令, 整64* 寄存器计数, 向量<整64>& 表达式栈) -> 空类型 {
    如果 (拼接左码 != T_字符串) {
        // 92-a：浮32 数值侧先宽化 f64（__cn_str_from_float 形参为 double——
        //   原以 T_浮32 实参发射则 xmm0 低 32 位 f32 位模式被当 double 读，
        //   拼接恒 0.000000；与 91-a 内置边界提升同款，拼接路径原漏网）
        如果 (拼接左码 == T_浮32) {
            左 = 插入值转换(左, T_浮64, 指令, 寄存器计数);
            拼接左码 = T_浮64;
        }
        整64 左转 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        // 91-a：实参类型码=数值侧码（浮点走 xmm0——__cn_str_from_float(double)）
        IR追加(指令, 建IR指令(IR_调用实参, 左, 拼接左码, 0, 0, 0, 0));
        IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 左转, 0,
                             驻留(转换符号(拼接左码))));
        登记寄存器类型(左转, T_字符串);
        左 = 左转;
    }
    如果 (拼接右码 != T_字符串) {
        // 92-a：浮32 数值侧先宽化 f64（同左侧）
        如果 (拼接右码 == T_浮32) {
            右 = 插入值转换(右, T_浮64, 指令, 寄存器计数);
            拼接右码 = T_浮64;
        }
        整64 右转 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_调用实参, 右, 拼接右码, 0, 0, 0, 0));
        IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 右转, 0,
                             驻留(转换符号(拼接右码))));
        登记寄存器类型(右转, T_字符串);
        右 = 右转;
    }
    整64 拼接寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_调用实参, 左, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用实参, 右, 0, 0, 0, 1, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 拼接寄存器, 0,
                         驻留("__cn_str_concat")));
    登记寄存器类型(拼接寄存器, T_字符串);
    结果<空类型, 整32> 加拼栈 = 表达式栈.追加(拼接寄存器);
    如果 (!加拼栈.正常) { 运行时错误(4); }
}

// 91-a（2026-09-13 第九十一轮）：隐式值转换插入（浮点混合运算整数侧宽化）——
//   发射层按 (源码=操作数2, 目标码=类型字段) 组合分派（整->浮 cvtsi2sd/scvtf、
//   浮->整 cvttsd2si/fcvtzs、浮32<->浮64 cvtss2sd/cvtss2df 族）。
//   源码取寄存器登记（0=未登记按 T_整64 发射读法兜底）。
不安全 函数 插入值转换(整64 源reg, 整64 目标码, 向量<IR指令>& 指令,
                 整64* 寄存器计数) -> 整64 {
    整64 转换reg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    整64 源码 = 查寄存器类型(源reg);
    IR追加(指令, 建IR指令(IR_类型转换, 源reg, 源码, 0, 转换reg, 目标码, 0));
    登记寄存器类型(转换reg, 目标码);
    返回 转换reg;
}

// 二元运算主体（非短路）：字符串拼接 +（双侧隐式转换 __cn_str_concat）与
//   算术/比较指令发射。位置 为值参（仅读：右侧末端=位置-1 推导兜底）；
//   拼接路径提前返回、算术路径自然落出——出口等价消费 1 个位置。
不安全 函数 生成二元运算主体(向量<节点> 池, 节点 n, 字符串 op名, 整32 位置,
                     映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                     向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数,
                     向量<整64>& 表达式栈) -> 空类型 {
    // ③ 第一波（2026-09-03，缺陷②根治）：字符串拼接 +（宿主 Task 2.5/2.9 对齐：
    //   __cn_str_concat 左结合、产物为字符串；字符串+数值 双向隐式转换——
    //   数值侧先 __cn_str_from_int/float/bool 再 concat）。判定：左右任一为
    //   字符串（寄存器类型登记表——字面量/标识符加载/拼接产物/内置返回；
    //   未登记侧末端节点推导兜底）
    布尔 拼接加 = 假;
    整64 拼接左码 = 0;
    整64 拼接右码 = 0;
    如果 (字符串比较(op名, "+") && 表达式栈.大小() >= 2) {
        整64 栈右 = 表达式栈.元素(表达式栈.大小() - 1);
        整64 栈左 = 表达式栈.元素(表达式栈.大小() - 2);
        拼接左码 = 查寄存器类型(栈左);
        拼接右码 = 查寄存器类型(栈右);
        如果 (拼接左码 == 0) {
            // 左侧末端推导兜底（附加=右操作数起点，左末端=附加-1）
            拼接左码 = 推导末端类型码(池, 整32(n.附加) - 1);
        }
        如果 (拼接右码 == 0) {
            // 右侧未登记（成员/调用对象等）——末端节点推导兜底
            拼接右码 = 推导末端类型码(池, 位置 - 1);
        }
        如果 (拼接左码 == T_字符串 || 拼接右码 == T_字符串) {
            拼接加 = 真;
        }
    }
    // 弹 2 个操作数，生成运算指令
    整64 右 = 0;
    整64 左 = 0;
    如果 (表达式栈.大小() >= 2) {
        右 = 表达式栈.元素(表达式栈.大小() - 1);
        结果<空类型, 整32> 删右 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删右.正常) { 运行时错误(4); }
        左 = 表达式栈.元素(表达式栈.大小() - 1);
        结果<空类型, 整32> 删左 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删左.正常) { 运行时错误(4); }
    }
    如果 (拼接加) {
        发射字符串拼接(拼接左码, 拼接右码, 左, 右, 指令, 寄存器计数, 表达式栈);
        返回;
    }
    整64 op = 0;
    如果 (字符串比较(op名, "+")) { op = IR_加; }
    否则 如果 (字符串比较(op名, "-")) { op = IR_减; }
    否则 如果 (字符串比较(op名, "*")) { op = IR_乘; }
    否则 如果 (字符串比较(op名, "/")) { op = IR_除; }
    否则 如果 (字符串比较(op名, "%")) { op = IR_取余; }
    否则 如果 (字符串比较(op名, "==")) { op = IR_相等; }
    否则 如果 (字符串比较(op名, "!=")) { op = IR_不等; }
    否则 如果 (字符串比较(op名, "<")) { op = IR_小于; }
    否则 如果 (字符串比较(op名, ">")) { op = IR_大于; }
    否则 如果 (字符串比较(op名, "<=")) { op = IR_小于等于; }
    否则 如果 (字符串比较(op名, ">=")) { op = IR_大于等于; }
    // 位运算五算子（2026-09-09 规范 01b§5.4；IR_位与/位或/位异或 既有预留启用，
    //   移位 68/69 新设——注释见 IR常量.cn）
    否则 如果 (字符串比较(op名, "&")) { op = IR_位与; }
    否则 如果 (字符串比较(op名, "|")) { op = IR_位或; }
    否则 如果 (字符串比较(op名, "^")) { op = IR_位异或; }
    否则 如果 (字符串比较(op名, "<<")) { op = IR_左移; }
    否则 如果 (字符串比较(op名, ">>")) { op = IR_右移; }
    // && / || 已在短路分支处理（原 IR_相等 防御语义错误，已删）
    // 91-a（2026-09-13 第九十一轮）：浮点混合运算隐式转换（宿主对齐：浮64 + 整
    //   自动宽化，fp9 实测宿主 `乙 + 2` = 5.5）——一侧浮点一侧整数时，整数侧
    //   插入 IR_类型转换（整->浮）。结果浮点码：单侧浮点取该侧（含浮32），
    //   双侧浮点混合取浮64（宽化方向）。取余/位运算不转换（宿主 `%` 拒绝
    //   浮点操作数、规范 5.4 位运算仅整型）。
    整64 左码浮 = 查寄存器类型(左);
    整64 右码浮 = 查寄存器类型(右);
    布尔 是浮点左 = (左码浮 == T_浮32 || 左码浮 == T_浮64);
    布尔 是浮点右 = (右码浮 == T_浮32 || 右码浮 == T_浮64);
    布尔 是算比 = (op == IR_加 || op == IR_减 || op == IR_乘 || op == IR_除 ||
                  op == IR_相等 || op == IR_不等 || op == IR_小于 ||
                  op == IR_大于 || op == IR_小于等于 || op == IR_大于等于);
    如果 ((是浮点左 || 是浮点右) && 是算比) {
        整64 浮码 = T_浮64;
        如果 (是浮点左 && !是浮点右) { 浮码 = 左码浮; }
        否则 如果 (是浮点右 && !是浮点左) { 浮码 = 右码浮; }
        否则 如果 (左码浮 == T_浮32 && 右码浮 == T_浮32) { 浮码 = T_浮32; }
        // 92-a（2026-09-13 第九十二轮）：单侧浮点为浮32、另一侧为整型 → 升 f64
        //   （禁止隐式窄化——整型转 浮32 有损，规范「仅允许无损或宽化转换」；
        //   对齐宿主「整 + 浮 → f64」与 92-a 宿主侧修复）。原「单侧浮点取该侧」
        //   在浮32 时把整型操作数窄化到 f32：实证 甲(浮32)+16777217 宿主
        //   16777218.5 / v2 前值 16777218.0（双侧分叉）。
        如果 ((是浮点左 && !是浮点右 && 左码浮 == T_浮32) ||
            (是浮点右 && !是浮点左 && 右码浮 == T_浮32)) { 浮码 = T_浮64; }
        // 92-a：统一按「操作数码 ≠ 公共浮码」插入转换（原判定仅 非浮点侧 转换
        //   ——浮码为 f64 时已是浮点的 浮32 侧被漏掉：f32 位模式直进 xmm 双精度
        //   运算/比较（f32+f64 双侧浮点形态原有同款漏网，本轮一并根治）。
        如果 (左码浮 != 浮码) {
            左 = 插入值转换(左, 浮码, 指令, 寄存器计数);
            左码浮 = 浮码;
            是浮点左 = 真;
        }
        如果 (右码浮 != 浮码) {
            右 = 插入值转换(右, 浮码, 指令, 寄存器计数);
            右码浮 = 浮码;
            是浮点右 = 真;
        }
    }
    整64 寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    // 46-f 无符号语义轮（2026-09-10 第五十轮）：二元指令类型字段=操作数寄存器
    //   登记类型（原恒 T_整64——正32/正64 操作数的无符号性在此丢失，后端无从
    //   分派 div/shr/setb 族无符号指令）。取左优先（混合宽度宽松语义取左），
    //   右侧为无符号码时取右；两侧均非无符号码兜底 T_整64（既有行为不变）。
    //   比较产物仍登记 T_布尔（结果语义与操作数符号性无关）。
    // 91-a：浮点码优先（浮点操作数存在时类型字段取浮点码——后端据此分派
    //   SSE/f 族指令与 ucomisd/fcmp 比较）。
    整64 二元类型 = 查寄存器类型(左);
    如果 (二元类型 != T_正32 && 二元类型 != T_正64 &&
        二元类型 != T_浮32 && 二元类型 != T_浮64) {
        二元类型 = 查寄存器类型(右);
        如果 (二元类型 != T_正32 && 二元类型 != T_正64 &&
            二元类型 != T_浮32 && 二元类型 != T_浮64) { 二元类型 = T_整64; }
    }
    IR追加(指令, 建IR指令(op, 左, 右, 0, 寄存器, 二元类型, 0));
    // ③：比较运算产物登记 T_布尔（打印 真/假 与拼接 from_bool 分派用）；
    // 91-a：浮点算术产物登记（原「算术产物不登记——按整数兜底」——打印浮点
    //   结果误走 __cn_print_int、嵌套浮点运算类型丢失；登记后打印/拼接/再运算
    //   全链消费正确）
    如果 (op == IR_相等 || op == IR_不等 || op == IR_小于 || op == IR_大于 ||
         op == IR_小于等于 || op == IR_大于等于) {
        登记寄存器类型(寄存器, T_布尔);
    } 否则 如果 (二元类型 == T_浮32 || 二元类型 == T_浮64) {
        登记寄存器类型(寄存器, 二元类型);
    }
    结果<空类型, 整32> 加 = 表达式栈.追加(寄存器);
    如果 (!加.正常) { 运行时错误(4); }
}

// 86-a（2026-09-12 复审缺陷①）：三元聚合分支的「聚合左值」判定——区间末节点为
//   标识符/成员/下标/解引用且类型为结构体（查结构体大小>0，含结果/可选合成
//   结构体）时，分支求值改走 生成左值地址（**地址透传**）。
//   根因（P41/最小3 实证）：通用 生成表达式 对结构体标识符恒发射 8 字节 IR_加载
//   （首字段值，非地址）→ 三元汇合把「首字段值」当地址 → 返回位整体拷贝 rep movsb
//   从地址 11 读 → 段错误 rc=139。宿主同款修复：分支地址透传（visitTernaryExpr
//   聚合约定「分支 Store 地址、汇合 Load 地址」，见 ir_expr.cpp）。
//   非左值分支（调用返回=retbuf 地址 / 字面量=临时槽地址 / 嵌套三元=地址）本身
//   已是以「地址」为值的形态，保持 生成表达式 原路径。
函数 区间末为聚合左值(向量<节点> 池, 整32 起, 整32 终) -> 布尔 {
    如果 (终 <= 起) { 返回 假; }
    整32 末索引 = 终 - 1;
    节点 末 = 池.元素(末索引);
    如果 (!(末.类型 == 节点_标识符 || 末.类型 == 节点_成员 ||
          末.类型 == 节点_下标 || 末.类型 == 节点_解引用)) { 返回 假; }
    整64 类型ID = 解析节点类型ID(池, 末索引);
    如果 (类型ID == 0) { 返回 假; }
    返回 查结构体大小(类型ID) > 0;
}

// 三元条件（③ 第六波，规范 01b 5.8）——惰性求值：条件跳转分派，仅选中分支
//   求值。复用短路方案：临时槽（IR_分配 帧登记）汇合两分支值，三块（真/假/汇合）。
//   栈平衡：各段递归后弹到进入前深度再压汇合结果（一元模式——净 +1，中间残留
//   全清，防「下标弹2取到残留」同族缺陷）。汇合类型=真分支寄存器登记类型
//   （语义层已保证两分支可合并；未登记兜底 T_整64——标识符加载同款）
//   86-a：聚合分支经 区间末为聚合左值 改走左值地址（地址透传，宿主同款）。
不安全 函数 生成三元运算(向量<节点> 池, 节点 n, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                 向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数,
                 向量<整64>& 表达式栈) -> 空类型 {
    整64 三元前深度 = 表达式栈.大小();
    整64 条件寄存器 = 生成表达式(池, n.子起点, n.文本, 局部槽, 参数槽,
                                指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    当 (表达式栈.大小() > 三元前深度) {
        结果<空类型, 整32> 删条 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删条.正常) { 运行时错误(4); }
    }
    整64 临时槽 = 槽计数[0];
    槽计数[0] = 槽计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 临时槽));
    整64 真块 = 块计数[0] + 1;
    整64 假块 = 块计数[0] + 2;
    整64 汇合块 = 块计数[0] + 3;
    块计数[0] = 块计数[0] + 3;
    IR追加(指令, 建IR指令(IR_条件跳转, 条件寄存器, 真块, 假块, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 真块));
    整64 真寄存器 = 0;
    如果 (区间末为聚合左值(池, 整32(n.文本), 整32(n.附加))) {
        真寄存器 = 生成左值地址(池, 整32(n.文本), 整32(n.附加), 局部槽, 参数槽,
                                指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    } 否则 {
        真寄存器 = 生成表达式(池, 整32(n.文本), 整32(n.附加), 局部槽, 参数槽,
                              指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    }
    当 (表达式栈.大小() > 三元前深度) {
        结果<空类型, 整32> 删真 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删真.正常) { 运行时错误(4); }
    }
    IR追加(指令, 建IR指令(IR_存储, 真寄存器, 0, 0, 0, 0, 临时槽));
    IR追加(指令, 建IR指令(IR_跳转, 0, 0, 0, 0, 0, 汇合块));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 假块));
    整64 假寄存器 = 0;
    如果 (区间末为聚合左值(池, 整32(n.附加), n.子终点)) {
        假寄存器 = 生成左值地址(池, 整32(n.附加), n.子终点, 局部槽, 参数槽,
                                指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    } 否则 {
        假寄存器 = 生成表达式(池, 整32(n.附加), n.子终点, 局部槽, 参数槽,
                              指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    }
    当 (表达式栈.大小() > 三元前深度) {
        结果<空类型, 整32> 删假 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删假.正常) { 运行时错误(4); }
    }
    IR追加(指令, 建IR指令(IR_存储, 假寄存器, 0, 0, 0, 0, 临时槽));
    IR追加(指令, 建IR指令(IR_跳转, 0, 0, 0, 0, 0, 汇合块));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 汇合块));
    整64 汇合类型 = 查寄存器类型(真寄存器);
    如果 (汇合类型 == 0) { 汇合类型 = T_整64; }
    整64 载入寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 临时槽, 0, 0, 载入寄存器, 汇合类型, 0));
    登记寄存器类型(载入寄存器, 汇合类型);
    // 86-a：聚合地址化三元——汇合值即「选中 place 地址」（T_对象 标记：值=地址，
    //   非值装载）。消费面契约：实参回扫（回扫实参取地址）对 T_对象 实参跳过
    //   「把值装载改取槽地址」的改写——否则会把「临时槽地址」当结构体基址传给
    //   被调方（P47-v2/t5_3 实证乱码：拷了临时槽 8 字节+垃圾）。
    如果 (整64(n.文本) < 整64(n.附加) &&
        (区间末为聚合左值(池, 整32(n.文本), 整32(n.附加)) ||
         区间末为聚合左值(池, 整32(n.附加), n.子终点))) {
        登记寄存器类型(载入寄存器, T_对象);
    }
    结果<空类型, 整32> 加汇 = 表达式栈.追加(载入寄存器);
    如果 (!加汇.正常) { 运行时错误(4); }
}

// 一元运算四兄弟（逻辑非/负号/取地址/解引用）——共用「弹到进入前深度再压结果」
//   一元模式（③ 第三波根治：操作数线性遍历残留弹清，防下标弹2取残留解引用崩）。
//   取地址经 生成左值地址（P6c）；只弹到进入前深度——原「清空全栈」会把先序
//   压栈的调用被调负符号/二元左操作数一并弹掉。
不安全 函数 生成一元运算(向量<节点> 池, 节点 n, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                 向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数,
                 向量<整64>& 表达式栈) -> 空类型 {
    如果 (n.类型 == 节点_取地址) {
        整64 取址前深度 = 表达式栈.大小();
        整64 地址寄存器 = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                     指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
        当 (表达式栈.大小() > 取址前深度) {
            结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈.正常) { 运行时错误(4); }
        }
        结果<空类型, 整32> 加 = 表达式栈.追加(地址寄存器);
        如果 (!加.正常) { 运行时错误(4); }
        返回;
    }
    // 其余三种：生成操作数（子区间）-> 一元指令
    整64 前深度 = 表达式栈.大小();
    整64 操作数寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                 指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    当 (表达式栈.大小() > 前深度) {
        结果<空类型, 整32> 删栈2 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈2.正常) { 运行时错误(4); }
    }
    整64 寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    如果 (n.类型 == 节点_逻辑非) {
        IR追加(指令, 建IR指令(IR_逻辑非, 操作数寄存器, 0, 0, 寄存器, T_整64, 0));
        登记寄存器类型(寄存器, T_布尔);
    } 否则 如果 (n.类型 == 节点_负号) {
        // 91-a：类型字段按操作数登记类型（浮点->浮点码——发射层走符号位翻转
        //   btc 63/fneg；整数 neg）；浮点负号产物登记（参与后续运算/打印）
        整64 负操作数码 = 查寄存器类型(操作数寄存器);
        整64 负结果码 = T_整64;
        如果 (负操作数码 == T_浮32 || 负操作数码 == T_浮64) { 负结果码 = 负操作数码; }
        IR追加(指令, 建IR指令(IR_负, 操作数寄存器, 0, 0, 寄存器, 负结果码, 0));
        如果 (负结果码 == T_浮32 || 负结果码 == T_浮64) {
            登记寄存器类型(寄存器, 负结果码);
        }
    } 否则 {
        // 节点_解引用：* 指针 -> IR_指针加载
        IR追加(指令, 建IR指令(IR_指针加载, 操作数寄存器, 0, 0, 寄存器, T_整64, 0));
    }
    结果<空类型, 整32> 加2 = 表达式栈.追加(寄存器);
    如果 (!加2.正常) { 运行时错误(4); }
}

// 成员访问两形态（R3 提取，2026-09-08）：方法接收者（P7b [this, 方法标记] 压栈）
不安全 函数 生成方法接收者(向量<节点> 池, 节点 n, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                   向量<IR指令>& 指令, 整64* 寄存器计数, 向量<整64>& 表达式栈) -> 空类型 {
    // P7b 方法调用接收者（表.追加(x) 的 表.追加 部分）：弹对象值
    //   （容器变量 Load 值=堆对象指针即 this），压 [this, 方法标记]
        // P7b 方法调用接收者（表.追加(x) 的 表.追加 部分）：弹对象值
        //   （容器变量 Load 值=堆对象指针即 this），压 [this, 方法标记]
        // ②c B：对象为结构体的容器字段（b.表.追加）——接收者=字段槽首 8 字节的
        //   堆对象指针：标识符对象取槽地址/调用对象用结果基址（retbuf/视图地址），
        //   经 字段地址+指针加载 取载（指针槽模型）
        节点 对象节点m = 池.元素(整32(n.子起点));
        整64 字段取载偏移 = -1;
        整64 字段取载基址 = 0;
        如果 (对象节点m.类型 == 节点_标识符) {
            整64 结构体IDm = 解析对象结构体ID(对象节点m);
            如果 (结构体IDm != 0) {
                整64 桶偏移m = 查字段偏移(结构体IDm, 整64(n.文本));
                如果 (桶偏移m >= 0) {
                    字段取载偏移 = 桶偏移m;
                    // 标识符对象：取结构体基槽地址（调用方/局部 多槽基址=最大槽号）
                    整64 对象槽m = 0;
                    结果<整64, 整32> 找局m = 局部槽.获取(整64(对象节点m.文本));
                    如果 (找局m.正常) { 对象槽m = 找局m.值; }
                    如果 (对象槽m == 0) {
                        结果<整64, 整32> 找参m = 参数槽.获取(整64(对象节点m.文本));
                        如果 (找参m.正常) { 对象槽m = 找参m.值; }
                    }
                    如果 (对象槽m != 0) {
                        整64 基址reg = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        // ②c D：结构体& 引用参数——槽内容即基址（Load 槽），非槽地址
                        如果 (槽是引用(对象槽m)) {
                            IR追加(指令, 建IR指令(IR_加载, 对象槽m, 0, 0, 基址reg, T_整64, 0));
                        } 否则 {
                            IR追加(指令, 建IR指令(IR_取地址, 对象槽m, 0, 0, 基址reg, T_整64, 0));
                        }
                        字段取载基址 = 基址reg;
                    }
                }
            }
        } 否则 如果 (对象节点m.类型 == 节点_调用) {
            // 调用对象：返回结构体的容器字段（词池.元素(0).表.追加）——
            //   弹出的调用结果寄存器（retbuf/视图地址）即基址
            整64 返回结构体IDm = 解析调用返回结构体(池, 整32(n.子起点));
            如果 (返回结构体IDm != 0 && 查结构体大小(返回结构体IDm) != 0) {
                整64 桶偏移m2 = 查字段偏移(返回结构体IDm, 整64(n.文本));
                如果 (桶偏移m2 >= 0) {
                    字段取载偏移 = 桶偏移m2;
                    字段取载基址 = -1;   // 栈顶（弹出的对象值）即基址
                }
            }
        }
        整64 对象值 = 0;
        如果 (表达式栈.大小() >= 1) {
            对象值 = 表达式栈.元素(表达式栈.大小() - 1);
            结果<空类型, 整32> 删对 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删对.正常) { 运行时错误(4); }
        }
        如果 (字段取载偏移 >= 0 && (字段取载基址 > 0 || 字段取载基址 == -1)) {
            // 字段首 8 字节的堆对象指针 -> this
            整64 基址值 = 对象值;
            如果 (字段取载基址 > 0) { 基址值 = 字段取载基址; }
            整64 字段地址reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_字段地址, 基址值, 0, 0, 字段地址reg, T_整64, 字段取载偏移));
            整64 对象指针reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 字段地址reg, 0, 0, 对象指针reg, T_对象, 0));
            对象值 = 对象指针reg;
        }
        结果<空类型, 整32> 加对 = 表达式栈.追加(对象值);
        如果 (!加对.正常) { 运行时错误(4); }
        结果<空类型, 整32> 加标 = 表达式栈.追加(0 - (1000000 + 整64(n.文本)));
        如果 (!加标.正常) { 运行时错误(4); }
}

// 字段访问右值（.字段/.->字段）：三源分桶布局判定+结果/可选 兜底+取值发射
不安全 函数 生成字段访问(向量<节点> 池, 节点 n, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                 向量<IR指令>& 指令, 整64* 寄存器计数, 向量<整64>& 表达式栈) -> 空类型 {
    节点 对象节点 = 池.元素(n.子起点);  // 子起点=对象节点索引（P6c 解析时记录）
    整64 基址寄存器 = 0;
        // P7b：对象是 结果/可选 变量 -> 字段偏移按合成布局（正常@0 布尔宽度；
        //   值/错误@联合偏移 4/8——IR容器.结果值偏移）。对象类型取语法层
        //   预标注（节点.子终点=对象类型ID，语法分析 解析后缀链 登记）
        整64 字段偏移量 = n.附加;
        整64 加载类型 = T_整64;
        整64 成员对象类型ID = 0;
        整64 成员值码 = T_未知;
        如果 (对象节点.类型 == 节点_标识符) {
            成员对象类型ID = 解析标识符类型ID(整64(对象节点.文本));
            // ②b B5：标识符对象为结构体局部/参数 -> 分桶查字段宽度（读写同源根治）
            整64 结构体ID = 解析对象结构体ID(对象节点);
            如果 (结构体ID != 0) {
                加载类型 = 查字段宽度码(结构体ID, 整64(n.文本));
                // ③ 第二波（方案A）：字段声明类型码（成员加载值登记用）
                成员值码 = 类型码(查字段类型ID(结构体ID, 整64(n.文本)));
            }
        } 否则 如果 (对象节点.类型 == 节点_调用) {
            // ②b B5：调用对象（池.元素(i).字段）——方法返回结构体：分桶收口
            //   偏移+宽度（语法层只能扁平回退查偏移——同名字段跨结构体必错）
            整64 返回结构体ID = 解析调用返回结构体(池, 整32(n.子起点));
            如果 (返回结构体ID != 0 && 查结构体大小(返回结构体ID) != 0) {
                整64 桶偏移 = 查字段偏移(返回结构体ID, 整64(n.文本));
                如果 (桶偏移 >= 0) { 字段偏移量 = 桶偏移; }
                加载类型 = 查字段宽度码(返回结构体ID, 整64(n.文本));
                成员值码 = 类型码(查字段类型ID(返回结构体ID, 整64(n.文本)));
            }
        } 否则 如果 (对象节点.类型 == 节点_成员) {
            // 46-b 根治（2026-09-09 第四十八轮）：成员链中间跳（r.左上.x 的
            //   .x——对象=成员节点）——语法层附加为扁平回退（按首对象 r 的
            //   矩形查 .x 必 miss=-1），旧兜底 解析对象结构体ID 只认标识符。
            //   经 解析成员链结构体ID 递归（矩形→左上→点）分桶查 偏移/宽度/
            //   类型码 三元组；基址=栈顶弹出（前跳压的结构体字段地址，不重取
            //   槽地址——标识符对象专属通道不受影响）。
            整64 链结构体ID48 = 解析成员链结构体ID(池, 整32(n.子起点));
            如果 (链结构体ID48 != 0) {
                整64 桶偏移c = 查字段偏移(链结构体ID48, 整64(n.文本));
                如果 (桶偏移c >= 0) { 字段偏移量 = 桶偏移c; }
                加载类型 = 查字段宽度码(链结构体ID48, 整64(n.文本));
                成员值码 = 类型码(查字段类型ID(链结构体ID48, 整64(n.文本)));
            }
        } 否则 如果 (对象节点.类型 == 节点_下标) {
            // 94-a（2026-09-13 第九十四轮）：对象=下标表达式（结构体数组元素
            //   `表[0].x` 右值）——元素结构体键经 解析成员链结构体ID（下标分支，
            //   数组元素结构体表）分桶查 偏移/宽度/类型码 三元组；基址侧无需
            //   改动（下标生成对结构体元素压**元素地址**，非标识符=复用栈顶分流）
            整64 元素结构体ID94 = 解析成员链结构体ID(池, 整32(n.子起点));
            如果 (元素结构体ID94 != 0) {
                整64 桶偏94 = 查字段偏移(元素结构体ID94, 整64(n.文本));
                如果 (桶偏94 >= 0) { 字段偏移量 = 桶偏94; }
                加载类型 = 查字段宽度码(元素结构体ID94, 整64(n.文本));
                成员值码 = 类型码(查字段类型ID(元素结构体ID94, 整64(n.文本)));
            }
        }
        如果 (字段偏移量 < 0 && 成员对象类型ID != 0) {
            字符串 对象类型文本 = 字符串复制(驻留文本(成员对象类型ID));
            如果 (是结果类型(对象类型文本)) {
                字符串 成员名文本 = 字符串复制(驻留文本(整64(n.文本)));
                如果 (字符串比较(成员名文本, "正常") || 字符串比较(成员名文本, "有值") ||
                     字符串比较(成员名文本, "是否某些")) {
                    字段偏移量 = 0;
                    加载类型 = T_布尔;
                    成员值码 = T_布尔;
                } 否则 {
                    // 79-a 缺陷根治（既有，基线复现）：.值/.错误 载荷类型须按成员名
                    //   分派——.值 = 结果首实参（T）、.错误 = 次实参（E）。原实现
                    //   一律取首实参：结果<字符串,整32>.错误 的类型码=T_字符串 ->
                    //   打印/比较按字符串分派（错误码判别静默失效，探针 P10/P11
                    //   两侧对照实证：宿主 5 / v2 空或垃圾）。
                    字符串 载荷类型 = 段首(合成名首实参(对象类型文本));
                    如果 (字符串比较(成员名文本, "错误")) {
                        载荷类型 = 段首(段余(合成名首实参(对象类型文本)));
                    }
                    // 联合体偏移 = 较宽成员（T 或 E 为 整64/字符串/指针 -> 8）——
                    //   原按 T 单侧定偏移，E 更宽时错位（登记边界，本轮取两者较宽）
                    整64 值偏移 = 结果值偏移(段首(合成名首实参(对象类型文本)));
                    如果 (字符串比较(合成名基名(对象类型文本), "结果")) {
                        整64 错偏移 = 结果值偏移(
                            段首(段余(合成名首实参(对象类型文本))));
                        如果 (错偏移 > 值偏移) { 值偏移 = 错偏移; }
                    }
                    字段偏移量 = 值偏移;
                    // 71-a：加载宽度按载荷类型（整32/正32 载荷值四字节读——
                    //   原 T_整64 八字节读拼垃圾高位，首个整32 载荷用例暴露）
                    成员值码 = 类型码(驻留(载荷类型));
                    如果 (成员值码 != T_未知) { 加载类型 = 成员值码; }
                }
            }
        }
        // 第17枚根治·右值偏移兜底（2026-09-06）：结果类型兜底后仍 -1 -> 分桶查
        //   （解析对象结构体ID——指针参数经权威表同样命中）；仍未知即 IR 层诊断
        //   拒绝发射（附加=-1 = 基址-1 毒地址，写穿相邻槽，[ir2] 产物不可信纪律）
        如果 (字段偏移量 < 0) {
            // 86-a（2026-09-12 复审缺陷①）：三元对象成员基（(条 ? 甲 : 乙).字段）
            //   ——对象类型经 解析节点类型ID（86-a 三元分支递归两分支）推导后
            //   查字段偏移/宽度（P47-v2 形八「成员字段偏移未知: .号」实证）。
            //   基址侧无需改动：三元聚合分支地址化后栈顶即选中 place 地址
            //   （与成员/解引用对象同款「非标识符即复用栈顶」分流）。
            如果 (对象节点.类型 == 节点_三元运算) {
                整64 三元对象ID = 解析节点类型ID(池, 整32(n.子起点));
                如果 (三元对象ID != 0) {
                    整64 桶偏三 = 查字段偏移(三元对象ID, 整64(n.文本));
                    如果 (桶偏三 >= 0) {
                        字段偏移量 = 桶偏三;
                        加载类型 = 查字段宽度码(三元对象ID, 整64(n.文本));
                        成员值码 = 类型码(查字段类型ID(三元对象ID, 整64(n.文本)));
                    }
                }
            }
            整64 兜底结构体ID = 解析对象结构体ID(对象节点);
            如果 (兜底结构体ID != 0) {
                整64 桶偏右 = 查字段偏移(兜底结构体ID, 整64(n.文本));
                如果 (桶偏右 >= 0) {
                    字段偏移量 = 桶偏右;
                    加载类型 = 查字段宽度码(兜底结构体ID, 整64(n.文本));
                    成员值码 = 类型码(查字段类型ID(兜底结构体ID, 整64(n.文本)));
                }
            }
            如果 (字段偏移量 < 0) {
                IR层诊断("成员字段偏移未知: ." + 驻留文本(整64(n.文本)));
            }
        }
        // 无论对象形态，先弹掉表达式栈顶（标识符=Load 值丢弃；解引用/成员=地址复用）
        如果 (表达式栈.大小() >= 1) {
            基址寄存器 = 表达式栈.元素(表达式栈.大小() - 1);
            结果<空类型, 整32> 删 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删.正常) { 运行时错误(4); }
        }
        如果 (对象节点.类型 == 节点_标识符) {
            // 标识符对象：栈顶是 Load 值，需重新取槽地址（结构体存于槽）。
            //   ②c D：结构体& 引用参数/指针参数——栈顶即基址，不再取槽地址（R3 提取）
            基址寄存器 = 重取成员对象基址(对象节点, 基址寄存器, 局部槽, 参数槽, 指令, 寄存器计数);
        }
        整64 寄存器 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_字段地址, 基址寄存器, 0, 0, 寄存器, T_整64, 字段偏移量));
        // 成员访问作为右值：字段地址 -> 立即取值（压值；赋值左值走专用路径）。
        //   2026-09-06 根治（v2self 表查找类型ID 崩溃）：对象为 结果/可选 且
        //   成员为 值/错误 且载荷=结构体（查.值——符号 32B）——压**字段地址**
        //   不 LoadPtr（原无条件取 8 字节=载荷首字段值当地址，结构体拷贝源=
        //   小整数（47=名ID）-> SIGSEGV；注释 2134 声明的语义至此真正实现）
        布尔 载荷是结构体 = 成员载荷是结构体(池, n, 对象节点, 成员对象类型ID);
        发射成员取值(指令, 寄存器计数, 寄存器, 加载类型, 成员值码, 载荷是结构体, 表达式栈);
}

// 成员取值发射：结果/可选 结构体载荷（.值/.错误 且载荷=结构体）压字段地址
//   不取值（2026-09-06 根治：LoadPtr 取 8 字节=载荷首字段值当地址 -> SIGSEGV）；
//   普通字段 IR_指针加载 + ③ 第二波 类型登记（字段声明类型/结果载荷类型——
//   缺陷①同族根治：字符串字段未登记 -> print_int 打指针值）。
不安全 函数 发射成员取值(向量<IR指令>& 指令, 整64* 寄存器计数, 整64 字段地址寄存器, 整64 加载类型,
                 整64 成员值码, 布尔 载荷是结构体, 向量<整64>& 表达式栈) -> 空类型 {
    如果 (载荷是结构体) {
        结果<空类型, 整32> 加m = 表达式栈.追加(字段地址寄存器);
        如果 (!加m.正常) { 运行时错误(4); }
        返回;
    }
    整64 值寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 字段地址寄存器, 0, 0, 值寄存器, 加载类型, 0));
    如果 (成员值码 != T_未知) {
        登记寄存器类型(值寄存器, 成员值码);
    }
    结果<空类型, 整32> 加 = 表达式栈.追加(值寄存器);
    如果 (!加.正常) { 运行时错误(4); }
}

// 标识符对象的字段基址重取：栈顶是 Load 值，需取槽地址（结构体存于槽）。
//   ②c D：结构体& 引用参数——槽内容即调用方结构体基址（已按引用发射），栈顶即基址；
//   指针参数 p.字段——栈顶=装载的指针值（≡(*p).字段），同不取槽地址。返回 新基址。
不安全 函数 重取成员对象基址(节点 对象节点, 整64 弹出基址, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                     向量<IR指令>& 指令, 整64* 寄存器计数) -> 整64 {
    整64 基址寄存器 = 弹出基址;
    整64 对象槽 = 0;
    结果<整64, 整32> 找局 = 局部槽.获取(整64(对象节点.文本));
    如果 (找局.正常) { 对象槽 = 找局.值; }
    如果 (对象槽 == 0) {
        结果<整64, 整32> 找参 = 参数槽.获取(整64(对象节点.文本));
        如果 (找参.正常) { 对象槽 = 找参.值; }
    }
    // 87-a（2026-09-12 第八十七轮）：顶层静态结构体对象——标识符读取已生成
    //   IR_静态地址（**值即地址**），栈顶即基址，不再取槽地址。原实现落尾端
    //   兜底「取对象槽 0 地址」——静态成员读写出垃圾基址（探针 P50b v2 实证：
    //   甲.名 读库符号串）。与 引用参数/指针参数「栈顶即基址」同款分流。
    如果 (对象槽 == 0) {
        整64 找静基 = 查静态序号(整64(对象节点.文本));
        如果 (找静基 >= 0 && 查结构体大小(取静态类型(找静基)) > 0) {
            返回 基址寄存器;
        }
    }
    如果 (对象槽 != 0 && 槽是引用(对象槽)) {
        // 引用参数：弹栈时 基址寄存器 已持有槽内容（=调用方结构体基址）
    } 否则 如果 (对象槽 != 0 && 槽是指针参数(对象槽)) {
        // 第17枚根治：指针参数 p.字段——栈顶=标识符读取装载的指针值，不再取槽地址
    } 否则 如果 (对象槽 != 0 && 对象槽是类对象(整64(对象节点.文本))) {
        // 第七十八轮（2026-09-12）：用户类对象成员访问——槽内容=堆对象指针
        //   （对象语义同容器：Load 即基址；结构体值语义走 取地址 槽。原路径
        //   取槽地址=传栈地址给字段访问/方法 this=段错误实证——228 用例）
        整64 指针寄存器2 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_加载, 对象槽, 0, 0, 指针寄存器2, T_对象, 0));
        基址寄存器 = 指针寄存器2;
    } 否则 {
        整64 地址寄存器2 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_取地址, 对象槽, 0, 0, 地址寄存器2, T_整64, 0));
        基址寄存器 = 地址寄存器2;
    }
    返回 基址寄存器;
}

// 标识符名字是否为用户类对象（权威表类型 -> 用户类判定——成员基址指针语义分派用）
函数 对象槽是类对象(整64 名ID) -> 布尔 {
    整64 类型IDc = 查当前函数变量类型(名ID);
    如果 (类型IDc == 0) { 返回 假; }
    返回 是用户类(字符串复制(驻留文本(类型IDc)));
}

// 结果/可选 载荷成员（.值/.错误）且载荷为结构体时，成员访问压字段地址不取值
//   （2026-09-06 根治：载荷结构体若 LoadPtr 取 8 字节=载荷首字段值当地址 -> SIGSEGV）
函数 成员载荷是结构体(向量<节点> 池, 节点 n, 节点 对象节点, 整64 成员对象类型ID) -> 布尔 {
    如果 (对象节点.类型 == 节点_标识符 && 成员对象类型ID != 0) {
        字符串 对象类型文本2 = 字符串复制(驻留文本(成员对象类型ID));
        如果 (是结果类型(对象类型文本2)) {
            字符串 成员名文本2 = 字符串复制(驻留文本(整64(n.文本)));
            如果 (字符串比较(成员名文本2, "正常") || 字符串比较(成员名文本2, "有值") ||
                 字符串比较(成员名文本2, "是否某些")) { 返回 假; }
            字符串 载荷类型 = 段首(合成名首实参(对象类型文本2));
            返回 查结构体大小(驻留(载荷类型)) != 0;
        }
    }
    // 46-a 根治（2026-09-09 第四十八轮）：成员字段类型是结构体即压地址不取值
    //   （v2 结构体值以地址传递的既定约定，与 实参通道 回扫字段地址形态/容器
    //   类字段指针读 三方一致）。原仅 结果.值 特判：普通结构体成员（点 t =
    //   r.左上）被 LoadPtr 取 8 字节值——声明位把该值当源地址结构体拷贝=
    //   解引用垃圾地址段错误（win 0xC0000005/linux rc=139 实锤）。对象解析经
    //   解析成员链结构体ID（186 根治产物）统一覆盖 标识符/成员链/调用 三形态。
    整64 成员链结构体ID = 解析成员链结构体ID(池, 整32(n.子起点));
    如果 (成员链结构体ID != 0) {
        整64 字段类型ID48 = 查字段类型ID(成员链结构体ID, 整64(n.文本));
        返回 查结构体类型(字段类型ID48) != 0;
    }
    返回 假;
}

// ==================== 表达式后缀求值 ====================
// 遍历 池[起点, 终点) 内表达式节点（后缀栈），生成指令到 目标 指令数组。
// 返回表达式结果寄存器 ID（0=无）。
// 栈：表达式寄存器栈（向量<整64>）。
// 栈值编码：正数=寄存器；负数 -(名ID)=函数符号；-(1000000+名ID)=成员方法标记（P7b）。
//   方法标记下压着对象值（this=容器槽 Load 值=堆对象指针）。
// 缺陷B根治（2026-09-02）：新增 块计数/槽计数 指针——短路求值（规范 930）需
//   在表达式内建块（条件跳转/标签）与临时槽（两分支值汇合）。mangled 核算：
//   两 整64* 标量参数 +8 字符（约 213 < 247，MASM 符号限制安全）。
// ==================== 净栈契约出口校验（88-b，2026-09-12 第八十九轮） ====================
// 契约（单一事实源：IR生成.cn「表达式栈净栈契约」节 + 本函数唯一校验实现）：
//   净栈增量 ∈ {0, +1}——+1=有值形态（结果=栈顶）；0=void 无值形态（如返回
//   空类型的方法调用——「void 不压栈」设计，生成表达式求值.cn 明确）。
//   两类违反当场诊断（IR 层错误即中止纪律：主.cn 检查计数>0 止于产 asm）：
//     ① 多压（Δ>1）：残留破坏后续「相对栈顶」消费——88-a 实参位短路旧实现
//        净 +3 即此形态，症状却是远端 `[ir2] 调用被调对象非函数名/方法`
//        （契约违反表现为下游症状，定位跨三层）；88-b 实证另一例：浮点字面量
//        漏分派（操作数缺失退化弹栈判定）净 +2——已随 89-a 根治。
//     ② 吞外层（Δ<0）：弹掉了调用方先序压栈值（调用实参求值中消失等）。
//   Rust 对照：rustc MIR validator / ICE——编译器不变量违反立刻报告，
//   不让错误产物进入下游（本校验把「下游症状」提前到「当场暴露」）。
//   调用纪律：生成表达式 唯一正常出口调用（错误路径 生成调用 返回 0 已诊断——
//   不校验，避免二次噪音）。性能：1 次函数调用 + 1 次减法 + 2 次比较（无分配；
//   出口深度顺带回传省一次 大小()）——实测编译 v2 树与基线差异在噪声内
//   （plans/020 本轮量化）。
// 返回出口栈深度（调用方据此取栈顶/判空——省重复 大小() 调用）。
函数 净栈契约出口校验(向量<整64>& 表达式栈, 整64 进入深度, 整32 起点, 整32 终点) -> 整64 {
    整64 出口深度 = 表达式栈.大小();
    整64 净栈增量 = 出口深度 - 进入深度;
    如果 (净栈增量 > 1) {
        IR层诊断("表达式净栈契约违反(多压): 增量=" + 整数转字符串(净栈增量) +
                       " 区间=[" + 整数转字符串(整64(起点)) + "," +
                       整数转字符串(整64(终点)) + ") 进入深度=" +
                       整数转字符串(进入深度));
    }
    如果 (净栈增量 < 0) {
        IR层诊断("表达式净栈契约违反(吞外层): 增量=" + 整数转字符串(净栈增量) +
                       " 区间=[" + 整数转字符串(整64(起点)) + "," +
                       整数转字符串(整64(终点)) + ") 进入深度=" +
                       整数转字符串(进入深度));
    }
    返回 出口深度;
}
函数 生成表达式(向量<节点> 池, 整32 起点, 整32 终点,
                 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                 向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数,
                 向量<整64>& 表达式栈) -> 整64 {
    // 净栈契约出口校验（88-b）：进入深度——须在任何栈操作之前记录
    整64 净栈进入深度 = 表达式栈.大小();
    // P7b：结果返回 retbuf 共享序号（帧尾 16 字节区）——发射顺序=使用顺序，
    //   每次调用后立即消费（接收 CopyStruct / 丢弃），单 retbuf 复用安全
    常量 retbuf序号 = 1;
    // P6c：预扫描（提取为 收集取址区间/收集短路区间/收集三元区间，R3）。
    向量<整64> 取址区间们 = 向量<整64>();
    收集取址区间(池, 起点, 终点, 取址区间们);
    向量<整64> 逻辑区间们 = 向量<整64>();
    收集短路区间(池, 起点, 终点, 逻辑区间们);
    向量<整64> 三元区间们 = 向量<整64>();
    收集三元区间(池, 起点, 终点, 三元区间们);
    向量<整64> 构造区间们 = 向量<整64>();
    收集构造区间(池, 起点, 终点, 构造区间们);
    整32 位置 = 起点;
    当 (位置 < 终点) {
        // 跳过 取地址 子区间 / 短路操作数区间 / 三元三段区间（R3：区间终点 统一判定）
        整64 取终 = 区间终点(取址区间们, 位置, 2);
        如果 (取终 >= 0) { 位置 = 整32(取终); 继续; }
        整64 逻终 = 区间终点(逻辑区间们, 位置, 3);
        如果 (逻终 >= 0) { 位置 = 整32(逻终); 继续; }
        整64 三终 = 区间终点(三元区间们, 位置, 2);
        如果 (三终 >= 0) { 位置 = 整32(三终); 继续; }
        // 84-a：结构体字面量构造的值区间跳过（终点=构造节点位置——由该节点统一求值，
        //   避免值表达式被主循环重复求值）
        整64 构终84 = 区间终点(构造区间们, 位置, 2);
        如果 (构终84 >= 0) { 位置 = 整32(构终84); 继续; }
        节点 n = 池.元素(位置);
        // 84-a：结构体字面量作实参（临时槽 + 逐字段写；槽地址压栈 + 登记实参清理）
        如果 (n.类型 == 节点_结构体构造) {
            生成结构体构造(池, n, 局部槽, 参数槽, 指令, 寄存器计数, 块计数,
                          槽计数, 表达式栈);
            位置++;
            继续;
        }
    如果 (n.类型 == 节点_整数字面量 || n.类型 == 节点_布尔字面量 ||
         n.类型 == 节点_字符串字面量 || n.类型 == 节点_浮点字面量 ||
         n.类型 == 节点_字符字面量) {
        生成字面量(n, 指令, 寄存器计数, 表达式栈);
    } 否则 如果 (n.类型 == 节点_标识符) {
            生成标识符加载(n, 局部槽, 参数槽, 指令, 寄存器计数, 表达式栈);
            位置++;
            继续;
        } 否则 如果 (n.类型 == 节点_二元运算) {
            字符串 op名 = 字符串复制(驻留文本(整64(n.文本)));
            // CN 字符串 == 是指针比较（非内容）——须用 字符串比较
            // 短路（&&/||）惰性求值与普通二元（拼接/算术/比较）分流（R3 提取）
            如果 (字符串比较(op名, "&&") || 字符串比较(op名, "||")) {
                生成短路求值(池, n, op名, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
            } 否则 {
                生成二元运算主体(池, n, op名, 位置, 局部槽, 参数槽, 指令, 寄存器计数, 槽计数, 表达式栈);
            }
            位置++;
            继续;
        } 否则 如果 (n.类型 == 节点_三元运算) {
            生成三元运算(池, n, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
        } 否则 如果 (n.类型 == 节点_逻辑非 || n.类型 == 节点_负号 ||
             n.类型 == 节点_取地址 || n.类型 == 节点_解引用) {
            生成一元运算(池, n, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
        } 否则 如果 (n.类型 == 节点_成员) {
            // 对象.字段 / 对象->字段：方法接收者 或 字段访问（R3 提取两形态）
            如果 (n.附加 == 成员方法标记) {
                生成方法接收者(池, n, 局部槽, 参数槽, 指令, 寄存器计数, 表达式栈);
            } 否则 {
                生成字段访问(池, n, 局部槽, 参数槽, 指令, 寄存器计数, 表达式栈);
            }
            位置++;
            继续;
        } 否则 如果 (n.类型 == 节点_调用) {
            整64 结果码 = 生成调用(池, n, 位置, 局部槽, 参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈, retbuf序号);
            如果 (结果码 == 0) { 返回 0; }
            位置++;
            继续;
        } 否则 如果 (n.类型 == 节点_下标) {
            生成下标访问(池, n, 指令, 寄存器计数, 块计数, 表达式栈);
            位置++;
            继续;
        }
        位置++;
    }
    // 净栈契约出口校验（88-b）：多压/吞外层当场诊断——契约/性能/Rust 对照详见
    //   净栈契约出口校验 定义处注释（单一事实源）
    整64 出口深度 = 净栈契约出口校验(表达式栈, 净栈进入深度, 起点, 终点);
    如果 (出口深度 == 0) { 返回 0; }
    返回 表达式栈.元素(出口深度 - 1);
}

// ==================== 左值地址生成（P6c） ====================
// 生成左值区间 [起点, 终点) 的地址（标识符->槽地址；成员->字段地址；解引用->操作数地址）。
// 不走 生成表达式（成员会取值）；返回地址寄存器（0=失败）。
// 块计数/槽计数：短路求值透传（缺陷B，2026-09-02）。
// 下标左值地址（p[i] = v）：指针对象 槽 Load 值+下标×步进=元素地址（③ 第三波）。
//   非指针对象（字符串下标只读等）语义层已拒——诊断报错返回 0。
不安全 函数 生成下标左值地址(向量<节点> 池, 节点 末节点, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                     向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数,
                     向量<整64>& 表达式栈) -> 整64 {
节点 下标对象左值 = 池.元素(整32(末节点.子起点));
如果 (下标对象左值.类型 == 节点_标识符) {
    整64 查所指左 = 查指针变量类型(整64(下标对象左值.文本));
    如果 (查所指左 >= 0) {
        // 对象指针值：槽 Load（局部/参数——指针参数为普通值槽非引用）
        整64 对象槽下 = 0;
        结果<整64, 整32> 找局下 = 局部槽.获取(整64(下标对象左值.文本));
        如果 (找局下.正常) { 对象槽下 = 找局下.值; }
        如果 (对象槽下 == 0) {
            结果<整64, 整32> 找参下 = 参数槽.获取(整64(下标对象左值.文本));
            如果 (找参下.正常) { 对象槽下 = 找参下.值; }
        }
        如果 (对象槽下 != 0) {
            整64 指针值 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            // 94-a（2026-09-13）：数组对象下标左值——基址=**槽地址**（数组名
            //   退化为元素指针；数组槽里是元素数据而非指针，Load 会取首 8 字节
            //   数据当指针 → 段错误〈探针 arr1 实证：r10=0x200000009=数组内容〉）。
            //   判定=当前函数变量类型是数组文本；非数组（真指针变量）保持 Load。
            布尔 数组对象左A = 假;
            整64 对象数组类型A = 查当前函数变量类型(整64(下标对象左值.文本));
            如果 (对象数组类型A >= 0) {
                如果 (是数组类型文本(字符串复制(驻留文本(对象数组类型A)))) {
                    数组对象左A = 真;
                }
            }
            如果 (数组对象左A) {
                IR追加(指令, 建IR指令(IR_取地址, 对象槽下, 0, 0, 指针值,
                                      T_整64, 0));
            } 否则 {
                IR追加(指令, 建IR指令(IR_加载, 对象槽下, 0, 0, 指针值, T_整64, 0));
            }
            // 下标表达式区间 [子起点+1, 子终点)（子起点=对象单节点）；
            //   只弹到进入前深度（&p[i] 作调用实参等嵌套形态）
            整64 下标前深度 = 表达式栈.大小();
            整64 下标值左 = 生成表达式(池, 末节点.子起点 + 1, 末节点.子终点,
                                        局部槽, 参数槽, 指令, 寄存器计数,
                                        块计数, 槽计数, 表达式栈);
            当 (表达式栈.大小() > 下标前深度) {
                结果<空类型, 整32> 删栈下 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删栈下.正常) { 运行时错误(4); }
            }
            整64 步进左 = 类型名宽度(查所指左);
            整64 缩放值左 = 下标值左;
            如果 (步进左 != 1) {
                整64 步进常量左 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_常量整数,
                                     整64(驻留(整数转字符串(步进左))), 0, 0,
                                     步进常量左, T_整64, 0));
                整64 缩放寄存器左 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_乘, 下标值左, 步进常量左, 0,
                                     缩放寄存器左, T_整64, 0));
                缩放值左 = 缩放寄存器左;
            }
            整64 元素地址左 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加, 指针值, 缩放值左, 0, 元素地址左, T_整64, 0));
            返回 元素地址左;
        }
    }
}
IR层诊断("下标左值对象未支持（须指针变量）");
返回 0;
}

// 顺序链标识符基址：槽解析（局部/参数）+ 引用参数（Load 槽内容）/指针参数
//   （装载指针值）/普通（取槽地址）三分流（②c D/第17枚根治）。返回 地址寄存器。
不安全 函数 顺序链标识符地址(节点 左, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                     向量<IR指令>& 指令, 整64* 寄存器计数) -> 整64 {
    整64 槽 = 0;
    结果<整64, 整32> 找局 = 局部槽.获取(整64(左.文本));
    如果 (找局.正常) { 槽 = 找局.值; }
    如果 (槽 == 0) {
        结果<整64, 整32> 找参 = 参数槽.获取(整64(左.文本));
        如果 (找参.正常) { 槽 = 找参.值; }
    }
    // 87-a（2026-09-12 第八十七轮）：顶层静态结构体左值链基址——.data 符号地址
    //   （IR_静态地址；值即地址）。原实现落尾端「取槽 0 地址」——静态成员链
    //   赋值/构造字面量脱糖后的逐字段写入全落垃圾基址（探针 P50b v2 实证）。
    如果 (槽 == 0) {
        整64 找静链 = 查静态序号(整64(左.文本));
        如果 (找静链 >= 0 && 查结构体大小(取静态类型(找静链)) > 0) {
            整64 静基reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静基reg, T_整64, 找静链));
            返回 静基reg;
        }
    }
    // 第七十八轮：方法体字段左值地址（字段.子字段 链式/&字段——局部/参数未命中）
    如果 (槽 == 0) {
        整64 字段偏移s = 当前方法字段偏移(整64(左.文本));
        如果 (字段偏移s >= 0) {
            返回 发射类字段地址(字段偏移s, 指令, 寄存器计数);
        }
    }
    整64 寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    如果 (槽是引用(槽)) {
        // ②c D：引用参数——槽内容即左值基址（Load 槽），非槽地址
        IR追加(指令, 建IR指令(IR_加载, 槽, 0, 0, 寄存器, T_整64, 0));
    } 否则 如果 (槽是指针参数(槽)) {
        // 第17枚根治：指针参数 p（方法签名* 等）——成员左值 p.字段 基址=
        //   装载指针值（解引用一级，v2.1 用户裁决 p.字段 ≡ (*p).字段）；
        //   旧 IR_取地址 取指针槽自身地址 = 少一层解引用（写穿相邻槽根因）
        IR追加(指令, 建IR指令(IR_加载, 槽, 0, 0, 寄存器, T_整64, 0));
    } 否则 {
        IR追加(指令, 建IR指令(IR_取地址, 槽, 0, 0, 寄存器, T_整64, 0));
    }
    返回 寄存器;
}

// 顺序链下标地址（94-a）：当前地址 += 下标值 × 元素步进——顺序链中间跳下标
//   （结构体数组元素成员链 表[0].x = v 的左值路径；数组名登记指针变量表=元素类型，
//   步进经 类型名宽度 单点）。下标表达式区间 = [子起点+1, 子终点)（对象在子起点，
//   解析期 解析后缀链 约定）；生成后表达式栈归位（净栈契约）。
不安全 函数 顺序链下标地址(向量<节点> 池, 节点 左, 整64 当前地址,
                    映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                    向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数,
                    整64* 槽计数, 向量<整64>& 表达式栈) -> 整64 {
    整64 元素类型IDq = 0;
    如果 (左.子起点 > 0 && 整64(左.子起点) < 池.大小()) {
        节点 对象节点q = 池.元素(整32(左.子起点));
        如果 (对象节点q.类型 == 节点_标识符) {
            整64 查所指q = 查指针变量类型(整64(对象节点q.文本));
            如果 (查所指q >= 0) { 元素类型IDq = 查所指q; }
        }
    }
    如果 (元素类型IDq == 0) {
        IR层诊断("顺序链下标对象类型未知（须数组/指针变量）");
        返回 0;
    }
    整64 前深度q = 表达式栈.大小();
    整64 下标值q = 生成表达式(池, 整32(左.子起点 + 1), 整32(左.子终点), 局部槽,
                            参数槽, 指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    表达式栈弹到深度(表达式栈, 前深度q);
    如果 (下标值q == 0) { 返回 0; }
    整64 步进q = 类型名宽度(元素类型IDq);
    整64 缩放q = 下标值q;
    如果 (步进q != 1) {
        整64 步进常量q = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留(整数转字符串(步进q))), 0, 0,
                              步进常量q, T_整64, 0));
        整64 缩放寄存器q = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_乘, 下标值q, 步进常量q, 0, 缩放寄存器q,
                              T_整64, 0));
        缩放q = 缩放寄存器q;
    }
    整64 新地址q = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加, 当前地址, 缩放q, 0, 新地址q, T_整64, 0));
    返回 新地址q;
}

// 顺序链成员字段地址：偏移兜底（附加 -1 → 解析对象结构体ID 分桶查；仍未知
//   IR 层诊断拒绝——毒地址纪律）。返回 新当前地址；0=失败（调用方整体返回 0）。
不安全 函数 顺序链成员地址(向量<节点> 池, 节点 左, 整64 当前地址, 整32 位置, 整32 起点,
                   向量<IR指令>& 指令, 整64* 寄存器计数) -> 整64 {
    // 第17枚根治·偏移兜底：语法层附加 -1=未知（指针形态/跨文件未标注）——
    //   经 解析对象结构体ID 分桶查偏移（结构体ID*键位移+字段名ID）；仍未知
    //   则 IR 层诊断拒绝发射（IR_字段地址.附加=-1 = 基址-1 毒地址，写穿
    //   相邻槽——v2self 实测根因）。IR 层错误即产物不可信（[ir2] 纪律）
    整64 左值偏移 = 左.附加;
    如果 (左值偏移 < 0 && 位置 > 起点) {
        // 46-b 根治（2026-09-09 第四十八轮）：兜底统一走 解析成员链结构体ID
        //   （标识符行为=解析对象结构体ID 不变；成员链中间跳 a.b.c 的 .c——
        //   对象=成员节点，原解析 0 → 偏移未知诊断拒绝，现递归解父链分桶查）
        整64 左值结构体ID = 解析成员链结构体ID(池, 整32(位置 - 1));
        如果 (左值结构体ID != 0) {
            整64 桶偏左 = 查字段偏移(左值结构体ID, 整64(左.文本));
            如果 (桶偏左 >= 0) { 左值偏移 = 桶偏左; }
        }
    }
    如果 (左值偏移 < 0) {
        IR层诊断("成员左值字段偏移未知: " + 驻留文本(整64(左.文本)));
        返回 0;
    }
    整64 寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 当前地址, 0, 0, 寄存器, T_整64, 左值偏移));
    返回 寄存器;
}

函数 生成左值地址(向量<节点> 池, 整32 起点, 整32 终点,
                 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                 向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数,
                 向量<整64>& 表达式栈) -> 整64 {
    // 顺序遍历左值区间：标识符 -> 槽地址；成员 -> 基于当前基址字段地址；
    //   解引用 -> 其操作数（指针值）即地址。
    // 若区间末尾是 解引用 根节点（*指针）：其操作数即地址，前面节点（指针）跳过
    节点 末节点 = 池.元素(终点 - 1);
    如果 (末节点.类型 == 节点_解引用) {
        // ③ 第三波：只弹到进入前深度（&*p 作调用实参等嵌套形态——清空全栈
        //   会弹掉调用方先序压栈内容，同 取地址 分支根治）
        整64 解引用前深度 = 表达式栈.大小();
        整64 地址 = 生成表达式(池, 末节点.子起点, 末节点.子终点, 局部槽, 参数槽,
                               指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
        当 (表达式栈.大小() > 解引用前深度) {
            结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈.正常) { 运行时错误(4); }
        }
        返回 地址;
    }
    // 引用返回调用左值（2026-09-04 缺陷零容忍收口，宿主 P3-18 对齐）：末节点
    //   =调用（取值(p) = 42 / += 8 / 整64& r = 取值(p)）——调用点默认按右值读
    //   （IR_调用参数化 后 IR_指针加载 值），地址=回扫该 IR_指针加载.操作数1
    //   （即调用返回的左值地址；同 回扫实参取地址 第二遍模式）
    如果 (末节点.类型 == 节点_调用) {
        整64 调用前深度 = 表达式栈.大小();
        整64 值reg = 生成表达式(池, 起点, 终点, 局部槽, 参数槽,
                               指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
        当 (表达式栈.大小() > 调用前深度) {
            结果<空类型, 整32> 删栈c2 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈c2.正常) { 运行时错误(4); }
        }
        如果 (值reg != 0) {
            整64 回c = 指令.大小();
            当 (回c > 0) {
                IR指令 回扫c = 指令.元素(回c - 1);
                如果 (回扫c.操作码 == IR_指针加载 && 回扫c.目标 == 值reg) {
                    返回 回扫c.操作数1;
                }
                回c--;
            }
        }
        返回 值reg;
    }
    // ③ 第三波：下标左值（p[i] = v）——指针对象：地址 = 对象槽值 + 下标×步进
    //   （宿主 ir_expr.cpp:981~1003 对齐）。R3 提取 生成下标左值地址
    如果 (末节点.类型 == 节点_下标 && 末节点.子起点 > 0) {
        返回 生成下标左值地址(池, 末节点, 局部槽, 参数槽, 指令, 寄存器计数,
                              块计数, 槽计数, 表达式栈);
    }
    整64 当前地址 = 0;
    整32 位置 = 起点;
    当 (位置 < 终点) {
        节点 左 = 池.元素(位置);
        如果 (左.类型 == 节点_标识符) {
            当前地址 = 顺序链标识符地址(左, 局部槽, 参数槽, 指令, 寄存器计数);
        } 否则 如果 (左.类型 == 节点_成员) {
            当前地址 = 顺序链成员地址(池, 左, 当前地址, 位置, 起点, 指令, 寄存器计数);
            如果 (当前地址 == 0) { 返回 0; }
        } 否则 如果 (左.类型 == 节点_下标) {
            // 94-a（2026-09-13 第九十四轮）：顺序链中间跳下标（结构体数组元素
            //   成员链 表[0].x = v / 表[i].x = v；也覆盖 p[i].字段）——当前地址
            //   += 下标值 × 元素步进。原实现无此分支：链上下标被**静默跳过**
            //   → 元素索引恒 0（arr5 探针实证：表[1].x 写入落在表[0].x）
            当前地址 = 顺序链下标地址(池, 左, 当前地址, 局部槽, 参数槽, 指令,
                                      寄存器计数, 块计数, 槽计数, 表达式栈);
            如果 (当前地址 == 0) { 返回 0; }
        } 否则 如果 (左.类型 == 节点_解引用) {
            当前地址 = 生成表达式(池, 左.子起点, 左.子终点, 局部槽, 参数槽,
                                   指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
            当 (表达式栈.大小() > 0) {
                结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删栈.正常) { 运行时错误(4); }
            }
        }
        位置++;
    }
    返回 当前地址;
}
