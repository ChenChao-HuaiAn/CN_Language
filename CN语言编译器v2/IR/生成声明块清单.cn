// 生成声明块清单（1415 拆分：自 生成声明.cn 机械搬移 · 文件超 1000 硬线先拆再加）
// 职责：语句块级作用域清单族——396-a 块新名清单栈（块名/旧槽/边界）、584-a 覆盖型
//   旧绑定、1415 块级类型恢复（旧镜像/旧变量类型两平行表）与 登记块级绑定1415 单点。
//   函数体逐字搬移（零行为变更）；消费=生成声明/生成声明中/生成声明尾/生成语句/
//   生成语句中/生成语句尾（同包全局池·本模块声明序居 生成声明 之前）。
// 1415 额外：块清单出栈恢复连带 函数信息.变量类型/镜像（消除同名重绑定垃圾读）；
//   登记块级绑定1415 供 类/结构体/数组/引用/结果 局部声明点单点调用。
导入 容器::向量;
导入 映射集合;
导入 IR;         // 函数IR 数据结构 + 当前函数变量类型访问（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// ==================== 396-a（D36·块新名清单栈·352-b 设计） ====================
// 扁平模型：块名清单平铺+边界栈（出块按边界恢复局部槽绑定·D36 遮蔽语义根治）
// 584-a（011 覆盖型）：平行 块名旧槽平铺 记录登记时被遮蔽的旧绑定——删除型=0-1
//   （出块 删除）、覆盖型=旧槽值（出块 设置 恢复外层绑定，505 锚：嵌套同名
//   标量出块读外层值而非块内残值）。两向量严格同步 push/pop。
静态 向量<整64> 块名清单平铺;
静态 向量<整64> 块名旧槽平铺;
// 1415（#1415 P1）：块级类型恢复——与 块名 平行两表记录登记点旧类型值
//   （-1=该名此前无条目）。出块时恢复/删除 函数信息.变量类型 与镜像
//   当前函数变量类型，消除同名重绑定后读垃圾（t_collide2：外层 整64 甲=42，
//   条件块内 结果<整64,整32> 甲=求()，出块后直接读 甲 得垃圾）。
静态 向量<整64> 块名旧镜像类型平铺;   // 登记时 查当前函数变量类型 值（无值落 -1 哨兵）
静态 向量<整64> 块名旧变量类型平铺;   // 登记时 函数信息.变量类型 值（-1=无）
静态 向量<整64> 块边界栈;

不安全 函数 块清单入栈() -> 空类型 {
    整64 当前尾 = 块名清单平铺.大小();
    结果<空类型, 整32> 加 = 块边界栈.追加(当前尾);
    如果 加.正常 {
    } 否则 {
        运行时错误(4);
    }
}

// 1415：块清单追加项单点（新名/遮蔽两入口共用——四平行表严格同步 push/pop）。
//   旧类型快照须在声明点写类型表**之前**取：分配标量声明槽/生成结果局部 等
//   调用点均为「先登记、后写类型」，故此处读到的是外层旧值（新名=-1）。
不安全 函数 块清单追加项(整64 名ID, 整64 旧槽, 函数IR& 函数信息) -> 空类型 {
    如果 (块边界栈.大小() == 0) { 返回; }
    结果<空类型, 整32> 加 = 块名清单平铺.追加(名ID);
    如果 加.正常 {
    } 否则 {
        运行时错误(4);
    }
    结果<空类型, 整32> 加旧 = 块名旧槽平铺.追加(旧槽);
    如果 加旧.正常 {
    } 否则 {
        运行时错误(4);
    }
    // 镜像表协议：-1=登记前无条目（消费点 块清单出栈恢复 显式判等）——
    //   可选无值在此显形落哨兵，非静默默认。
    整64 旧镜快照 = 0 - 1;
    可选<整64> 旧镜快照查 = 查当前函数变量类型(名ID);
    如果 (旧镜快照查.有值) { 旧镜快照 = 旧镜快照查.值; }
    结果<空类型, 整32> 加镜 = 块名旧镜像类型平铺.追加(旧镜快照);
    如果 加镜.正常 {
    } 否则 {
        运行时错误(4);
    }
    整64 旧类型 = 0 - 1;
    结果<整64, 整32> 查旧类型 = 函数信息.变量类型.获取(名ID);
    如果 (查旧类型.正常) { 旧类型 = 查旧类型.值; }
    结果<空类型, 整32> 加型 = 块名旧变量类型平铺.追加(旧类型);
    如果 加型.正常 {
    } 否则 {
        运行时错误(4);
    }
}

不安全 函数 块清单登记(整64 名ID, 函数IR& 函数信息) -> 空类型 {
    块清单追加项(名ID, 0 - 1, 函数信息);
}

// 584-a（011 覆盖型）：块内同名遮蔽重声明——新槽已由调用方分配并 设置，
//   此处登记「名 + 被遮蔽旧槽」→出块时 设置 恢复外层绑定（非删除）。
不安全 函数 块清单登记遮蔽(整64 名ID, 整64 旧槽, 函数IR& 函数信息) -> 空类型 {
    块清单追加项(名ID, 旧槽, 函数信息);
}

// 1415（#1415 P1·点4 聚合局部块级绑定恢复）：声明点绑定登记单点——
//   同名遮蔽=旧槽入块清单（出块恢复外层绑定 + 类型表/镜像），新名=入清单
//   （出块删除）。调用纪律=**局部槽.设置 与 类型表写入之前**（块清单追加项
//   读到的才是外层旧值）。原仅标量/结果路径有绑定恢复：类对象/结构体/数组
//   局部同名遮蔽后出块仍指内层槽+内层类型（宿主 42 / v2 垃圾，探针
//   shadow.cn 四形态实证）；本单点并入三族（容器同名遮蔽=语义层 P7c 前置拒绝）。
不安全 函数 登记块级绑定1415(整64 名ID, 映射<整64, 整64>& 局部槽,
                    函数IR& 函数信息) -> 空类型 {
    整64 旧槽b = 0;
    布尔 有旧b = 假;
    结果<整64, 整32> 查旧b = 局部槽.获取(名ID);
    如果 (查旧b.正常) { 旧槽b = 查旧b.值; 有旧b = 真; }
    如果 (有旧b) {
        块清单登记遮蔽(名ID, 旧槽b, 函数信息);
    }
    如果 (!有旧b) {
        块清单登记(名ID, 函数信息);
    }
}

不安全 函数 块清单出栈恢复(函数IR& 函数信息, 映射<整64, 整64>& 局部槽) -> 空类型 {
    如果 (块边界栈.大小() == 0) { 返回; }
    整64 末边界 = 块边界栈.元素(块边界栈.大小() - 1);
    整64 i = 块名清单平铺.大小() - 1;
    当 (i >= 末边界) {
        整64 名ID = 块名清单平铺.元素(整32(i));
        整64 旧槽 = 块名旧槽平铺.元素(整32(i));
        // 1415（拆分清偿·else 降格纪律）：旧槽=-1=删除型（新名·出块删绑定）/
        //   >=0=覆盖型（恢复外层绑定）。两步独立守卫（精确哨兵比较非业务区间）。
        布尔 无旧槽 = 旧槽 == 0 - 1;
        如果 (!无旧槽) {
            // 覆盖型：恢复外层绑定（块内遮蔽声明的新槽弃用）
            结果<空类型, 整32> 设回 = 局部槽.设置(名ID, 旧槽);
            如果 (!设回.正常) { 运行时错误(4); }
        }
        如果 (无旧槽) {
            // 映射.删除 返回 布尔（stdlib/映射集合 签名）——语句式调用（布尔丢弃
            //   不触发结果检查防线·出块删除的名必在=本函数内分配）
            局部槽.删除(名ID);
        }
        // 1415：块级类型恢复——镜像（表达式/成员链类型推导权威）与
        //   函数信息.变量类型（容器析构类型分派源）随块清单出栈恢复/删除；
        //   旧值=-1（登记前无条目）→ 删除，否则设置回外层类型。
        整64 旧镜像 = 块名旧镜像类型平铺.元素(整32(i));
        // 1415：哨兵 -1=登记前无条目（协议否定值·精确比较非业务区间）——
        //   无=删除镜像条目，有=恢复外层类型（两步独立守卫·else 降格纪律）。
        布尔 无旧镜像 = 旧镜像 == 0 - 1;
        如果 (!无旧镜像) {
            登记当前函数变量类型(名ID, 旧镜像);
        }
        如果 (无旧镜像) {
            删除当前函数变量类型(名ID);
        }
        整64 旧变量类型 = 块名旧变量类型平铺.元素(整32(i));
        布尔 无旧变量类型 = 旧变量类型 == 0 - 1;
        如果 (!无旧变量类型) {
            结果<空类型, 整32> 设型回 = 函数信息.变量类型.设置(名ID, 旧变量类型);
            如果 (!设型回.正常) { 运行时错误(4); }
        }
        如果 (无旧变量类型) {
            函数信息.变量类型.删除(名ID);
        }
        结果<空类型, 整32> 删平 = 块名清单平铺.删除(整32(i));
        如果 删平.正常 {
        } 否则 {
            运行时错误(4);
        }
        结果<空类型, 整32> 删旧 = 块名旧槽平铺.删除(整32(i));
        如果 删旧.正常 {
        } 否则 {
            运行时错误(4);
        }
        结果<空类型, 整32> 删镜 = 块名旧镜像类型平铺.删除(整32(i));
        如果 删镜.正常 {
        } 否则 {
            运行时错误(4);
        }
        结果<空类型, 整32> 删型 = 块名旧变量类型平铺.删除(整32(i));
        如果 删型.正常 {
        } 否则 {
            运行时错误(4);
        }
        i--;
    }
    结果<空类型, 整32> 删边 = 块边界栈.删除(块边界栈.大小() - 1);
    如果 删边.正常 {
    } 否则 {
        运行时错误(4);
    }
}
