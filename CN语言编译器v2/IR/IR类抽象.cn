// CN 自举编译器 v2 · 抽象类标志表（任务193·specs/06 §八·宿主 class_resolver 同构）
// 职责：抽象类元数据单一归属——本类声明的无体抽象方法名集（解析期登记）+
//   未实现抽象方法名集（收口沿链传播）。抽象类=含未实现抽象方法的类，不可直接
//   实例化（宿主 ci.isAbstract：本类方法 isAbstract && !hasBody；派生类经父类
//   方法并入天然传播）。对应消费点：语法层 解析类声明（抽象分支登记+布局收口
//   收口）/语义层（变量裸声明+构造调用实例化拒绝）/IR 生成（无体方法跳过生成）。
// 独立成文件缘由：IR类尾.cn 已 873 行越 900 警戒线（AGENTS 单一职责红线·
//   先拆再加）——本文件仅依赖 IR类（表）+IR类尾（查类基名/查类方法定义层），
//   与 接口表.cn 同层同纪律。
导入 映射集合;
导入 协议常量;   // 键位移（335：协议常量独立包）

公开:   // 全文件公开（包内兄弟模块与跨包消费方经合并全局池解析）

公开:

静态 映射<整64, 整64> 类抽象声明串们;   // 193：类名ID -> 本类声明的无体抽象方法名平铺串ID（"名1,名2"·解析期登记）
静态 映射<整64, 整64> 类未实现抽象串们; // 193：类名ID -> 未实现抽象方法名平铺串ID（收口沿链传播·非空=抽象类不可实例化）

// 任务级生命周期清空（与 IR类 清空类表 同步调用；多文件窗口重置）
函数 清空类抽象表() -> 空类型 {
    类抽象声明串们.清空();
    类未实现抽象串们.清空();
}

// 逗号平铺串含名（全等段匹配——左右界为串端或逗号·防前缀误命中）
函数 逗号串含名(整64 串ID, 整64 名ID) -> 布尔 {
    字符串 s = 字符串复制(驻留文本(串ID));
    字符串 m = 字符串复制(驻留文本(名ID));
    整64 长s = 字符串长度(s);
    整64 长m = 字符串长度(m);
    如果 (长m == 0 || 长s == 0 || 长m > 长s) { 返回 假; }
    整64 i = 0;
    当 (i + 长m <= 长s) {
        如果 (字符串比较(字符串子串(s, 整32(i), 整32(长m)), m)) {
            布尔 左界 = (i == 0) || 字符串比较(字符串子串(s, 整32(i - 1), 1), ",");
            布尔 右界 = (i + 长m == 长s) || 字符串比较(字符串子串(s, 整32(i + 长m), 1), ",");
            如果 (左界 && 右界) { 返回 真; }
        }
        i++;
    }
    返回 假;
}

// 逗号平铺串并名（去重——已含原样返回）
函数 逗号串并名(整64 串ID, 整64 名ID) -> 整64 {
    如果 (逗号串含名(串ID, 名ID)) { 返回 串ID; }
    字符串 s = 字符串复制(驻留文本(串ID));
    字符串 m = 字符串复制(驻留文本(名ID));
    如果 (字符串长度(s) == 0) { 返回 驻留(m); }
    返回 驻留(s + "," + m);
}

// 串逐段并集（辅助——串ID 各段并进 结果串 出参）
函数 串逐段并集(整64 串ID, 整64& 结果串) -> 空类型 {
    字符串 s = 字符串复制(驻留文本(串ID));
    整64 长s = 字符串长度(s);
    整64 i = 0;
    整64 段起 = 0;
    当 (i <= 长s) {
        如果 (i == 长s || 字符串比较(字符串子串(s, 整32(i), 1), ",")) {
            整64 段长 = i - 段起;
            如果 (段长 > 0) {
                结果串 = 逗号串并名(结果串, 驻留(字符串子串(s, 整32(段起), 整32(段长))));
            }
            段起 = i + 1;
        }
        i++;
    }
}

// 登记类抽象方法名（解析类体 抽象 函数 分支调——本类声明的无体抽象方法）
函数 登记类抽象方法名(整64 类名ID, 整64 方法名ID) -> 空类型 {
    整64 旧串 = 0;
    结果<整64, 整32> 查 = 类抽象声明串们.获取(类名ID);
    如果 (查.正常) { 旧串 = 查.值; }
    整64 新串 = 逗号串并名(旧串, 方法名ID);
    结果<空类型, 整32> 设 = 类抽象声明串们.设置(类名ID, 新串);
    如果 (!设.正常) { 运行时错误(4); }
}

// 收口类抽象性（解析类布局收口点调·父先子后序保证父串已收口）：
//   未实现集 = (父未实现集 − 本类有体重写名) ∪ 本类声明集。
//   本类重写判定=查类方法定义层(本类, 名)==本类（本类有定义；无体声明必走
//   抽象登记·定义层命中且非再抽象声明即有体重写出集）。
函数 收口类抽象性(整64 类名ID) -> 空类型 {
    整64 结果串 = 0;
    整64 基名k = 查类基名(类名ID);
    如果 (基名k != 0) {
        结果<整64, 整32> 查父 = 类未实现抽象串们.获取(基名k);
        如果 (查父.正常 && 查父.值 != 0) {
            字符串 父串 = 字符串复制(驻留文本(查父.值));
            整64 长p = 字符串长度(父串);
            整64 i = 0;
            整64 段起 = 0;
            当 (i <= 长p) {
                如果 (i == 长p || 字符串比较(字符串子串(父串, 整32(i), 1), ",")) {
                    整64 段长 = i - 段起;
                    如果 (段长 > 0) {
                        整64 段名 = 驻留(字符串子串(父串, 整32(段起), 整32(段长)));
                        结果<整64, 整32> 查本抽象 = 类抽象声明串们.获取(类名ID);
                        布尔 本类再抽象 = 假;
                        如果 (查本抽象.正常 && 查本抽象.值 != 0) {
                            本类再抽象 = 逗号串含名(查本抽象.值, 段名);
                        }
                        如果 (!本类再抽象 && 查类方法定义层(类名ID, 段名) == 类名ID) {
                            // 本类有体重写——出集（跳过）
                        } 否则 {
                            结果串 = 逗号串并名(结果串, 段名);
                        }
                    }
                    段起 = i + 1;
                }
                i++;
            }
        }
    }
    结果<整64, 整32> 查本 = 类抽象声明串们.获取(类名ID);
    如果 (查本.正常 && 查本.值 != 0) {
        串逐段并集(查本.值, 结果串);
    }
    结果<空类型, 整32> 设 = 类未实现抽象串们.设置(类名ID, 结果串);
    如果 (!设.正常) { 运行时错误(4); }
}

// 是抽象类ID（语义层实例化拒绝判定入口·非空未实现集=抽象类）
函数 是抽象类ID(整64 类名ID) -> 布尔 {
    如果 (类名ID <= 0) { 返回 假; }
    结果<整64, 整32> 查 = 类未实现抽象串们.获取(类名ID);
    如果 (查.正常 && 查.值 != 0) {
        整64 串v = 查.值;
        返回 字符串长度(驻留文本(串v)) > 0;
    }
    返回 假;
}
