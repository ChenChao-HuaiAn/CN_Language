// CN 自举编译器 v2 · IR 生成摘除1674（#1674 甲案·2026-10-26 用户批）
// 职责：摘除(槽) 内置的 IR 展开——拥有槽一步「释放旧值+清槽」（001 §5.6 ①·
//   对标 C++ smart pointer reset/Rust Option::take 释放侧内建化）。宿主
//   emitRemoveBuiltinCall 同构：生成左值地址 取槽地址 → IR_指针加载 读旧值 →
//   字符串槽=IR_调用参数化(__cn_str_free) / 类槽=IR_删除对象（空安全）→
//   IR_指针存储 清槽——摘除后析构级联读到空槽自然跳过，双释放机械杜绝。
//   （#1674 轮勘误：首提交本文件与 语义/语义检查内置1674.cn 内容写反——
//   合并全局池跨包解析下功能正确但模块归属错位，本提交对调归位·零语义变化。）
// 依赖经合并全局池（同包兄弟：生成左值地址/解析标识符类型ID/类判定族）；
//   节点_*/查调用实参末位 属 协议常量（中立层·零语法包依赖·334 层网）。
导入 容器::向量;
导入 映射集合;
导入 协议常量;   // IR_*/T_* 指令码 + 节点_*/查调用实参末位 + 驻留（中立层）
导入 IR生成;     // 程序IR 布局 + 类型码（IR容器签名 同域）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 摘除(槽) 展开（生成调用 主链 生成转移展开 同层特判·返回 真=终结发射）。
//   实参在主遍历已求值压栈（标识符/成员读值）——弹掉被调残留+实参值（地址由
//   生成左值地址 重发），槽类型按 解析标识符类型ID/类字段表 分派 free/删除。
不安全 函数 生成摘除展开1674(向量<节点> 池, 节点 n, 整32 位置,
                          映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                          向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数,
                          整64* 槽计数, 向量<整64>& 表达式栈) -> 布尔 {
    // 协议边界守卫（池界双边界+实参数恰一·未处理=返假走主链）
    // 静默豁免闭集穷举: 调用节点协议边界守卫（池界双边界+实参数恰一·未处理=返假走主链）
    如果 (n.子起点 <= 0 || n.子起点 >= 整64(池.大小()) || !(n.附加 == 1)) {
        返回 假;
    }
    节点 被调1674 = 池.元素(整32(n.子起点));
    如果 (被调1674.类型 != 节点_标识符) { 返回 假; }
    // 静默豁免闭集穷举: 被调名守卫（非摘除调用=返假走主链·未处理哨兵协议）
    如果 (!字符串比较(字符串复制(驻留文本(整64(被调1674.文本))), "摘除")) {
        返回 假;
    }
    可选<整64> 末位1674查 = 查调用实参末位(整64(位置), 0);
    如果 (!末位1674查.有值) { 返回 假; }
    整64 末位1674 = 末位1674查.值;
    如果 (末位1674 <= 0 || 末位1674 >= 整64(池.大小())) { 返回 假; }
    节点 实参摘1674 = 池.元素(整32(末位1674));
    // 静默豁免上游已诊断: 左值形态守卫（语义层已拒非左值·发射面同判据防御重申）
    如果 (实参摘1674.类型 != 节点_标识符 && 实参摘1674.类型 != 节点_成员) {
        返回 假;
    }
    字符串 槽类型1674 = 摘除槽类型文本IR1674(池, 实参摘1674);
    如果 (字符串长度(槽类型1674) == 0) { 返回 假; }
    // 弹栈：实参值+被调残留（与 生成转移展开 弹序一致）
    // 静默豁免闭集穷举: 栈深守卫（弹序协议=被调+实参两项·不足=返假走主链）
    如果 (!摘除栈深足够1674(表达式栈)) { 返回 假; }
    整64 删摘i1674 = 0;
    当 (删摘i1674 < 2) {
        结果<空类型, 整32> 删摘1674 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删摘1674.正常) { 运行时错误(4); }
        删摘i1674++;
    }
    // 槽地址（两跳自发射·析构体 this 语境实证稳态）：
    //   段序=标识符（自身=IR_加载(this槽)/变量=IR_取地址(槽)）→ 逐成员
    //   IR_字段地址（偏移=查字段偏移·键=结构体布局键基(上段类型)——手动释放$
    //   首查即触发惰性合成布局·单点）——.值 段=合成布局 偏移 0（同表）。
    整64 槽地址1674 = 0;
    整64 当前地址1674 = 0;
    字符串 上段类型1674 = "";
    如果 (实参摘1674.类型 == 节点_标识符) {
        整64 名IDs1674 = 整64(实参摘1674.文本);
        整64 槽s1674 = 0;
        结果<整64, 整32> 找局s1674 = 局部槽.获取(名IDs1674);
        如果 (找局s1674.正常) { 槽s1674 = 找局s1674.值; }
        如果 (槽s1674 == 0) {
            结果<整64, 整32> 找参s1674 = 参数槽.获取(名IDs1674);
            如果 (找参s1674.正常) { 槽s1674 = 找参s1674.值; }
        }
        整64 基址s1674 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_取地址, 槽s1674, 0, 0, 基址s1674, T_整64, 0));
        槽地址1674 = 基址s1674;
        上段类型1674 = 字符串复制(驻留文本(解析标识符类型ID(名IDs1674)));
    }
    如果 (实参摘1674.类型 == 节点_成员) {
        整64 走1674 = 整64(实参摘1674.子起点);
        如果 (走1674 <= 0 || 走1674 > 整64(末位1674)) { 返回 假; }
        当 (走1674 <= 整64(末位1674)) {
            节点 段1674 = 池.元素(整32(走1674));
            如果 (段1674.类型 == 节点_标识符) {
                整64 名IDa1674 = 整64(段1674.文本);
                布尔 是自身段1674 = 字符串比较(
                    字符串复制(驻留文本(名IDa1674)), "自身");
                整64 基址a1674 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                如果 (是自身段1674) {
                    // 自身=this 指针槽（生成期全局·值即对象地址·IR_加载）
                    IR追加(指令, 建IR指令(IR_加载, 当前方法this槽, 0, 0,
                                         基址a1674, T_整64, 0));
                }
                如果 (!是自身段1674) {
                    // 变量槽（字符串/包装局部）=槽地址（IR_取地址）
                    整64 槽a1674 = 0;
                    结果<整64, 整32> 找局a1674 = 局部槽.获取(名IDa1674);
                    如果 (找局a1674.正常) { 槽a1674 = 找局a1674.值; }
                    如果 (槽a1674 == 0) {
                        结果<整64, 整32> 找参a1674 = 参数槽.获取(名IDa1674);
                        如果 (找参a1674.正常) { 槽a1674 = 找参a1674.值; }
                    }
                    IR追加(指令, 建IR指令(IR_取地址, 槽a1674, 0, 0, 基址a1674,
                                         T_整64, 0));
                }
                当前地址1674 = 基址a1674;
                上段类型1674 = 字符串复制(驻留文本(解析标识符类型ID(名IDa1674)));
                如果 (字符串比较(上段类型1674, "自身")) {
                    上段类型1674 = 字符串复制(驻留文本(当前方法类名ID));
                }
            }
            如果 (段1674.类型 == 节点_成员) {
                整64 上段键1674 = 0;
                可选<整64> 上段键查1674 = 结构体布局键基(驻留(上段类型1674));
                如果 (上段键查1674.有值) { 上段键1674 = 上段键查1674.值; }
                整64 偏移m1674 = 0;
                如果 (驻留ID有效摘1674(上段键1674)) {
                    可选<整64> 偏移查m1674 = 查字段偏移(上段键1674,
                                                       整64(段1674.文本));
                    如果 (偏移查m1674.有值) { 偏移m1674 = 偏移查m1674.值; }
                }
                整64 基址m1674 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_字段地址, 当前地址1674, 0, 0,
                                     基址m1674, T_整64, 偏移m1674));
                当前地址1674 = 基址m1674;
                字符串 段名m1674 = 字符串复制(驻留文本(整64(段1674.文本)));
                如果 (字符串比较(段名m1674, "值")) {
                    字符串 载荷m1674 = 手动释放载荷剥壳(上段类型1674);
                    如果 (非空串摘1674(载荷m1674)) {
                        上段类型1674 = 字符串复制(载荷m1674);
                    }
                }
                如果 (!字符串比较(段名m1674, "值")) {
                    字符串 类字段m1674 = 类字段类型文本IR1674(
                        池, 驻留(上段类型1674), 整64(段1674.文本));
                    如果 (非空串摘1674(类字段m1674)) {
                        上段类型1674 = 字符串复制(类字段m1674);
                    }
                }
            }
            走1674++;
        }
        槽地址1674 = 当前地址1674;
    }
    如果 (槽地址1674 == 0) {
        // 标识符兜底未覆盖形态=防御显形（语义层已拒·不可达面）
        返回 假;
    }
    // 旧值加载（指针槽统一 8 字节句柄/对象指针）
    整64 旧值1674 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 槽地址1674, 0, 0, 旧值1674,
                         T_字符串, 0));
    // 释放分派：字符串槽=__cn_str_free / 类槽=DeleteObject（空安全同款单发）
    如果 (字符串比较(槽类型1674, "字符串")) {
        IR追加(指令, 建IR指令(IR_调用实参, 旧值1674, 0, 0, 0, 0, 0));
        IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                             驻留("__cn_str_free")));
    }
    如果 (!字符串比较(槽类型1674, "字符串")) {
        IR追加(指令, 建IR指令(IR_删除对象, 旧值1674, 0, 0, 0, 0,
                             驻留(槽类型1674)));
    }
    // 清槽（幂等——析构级联读到空槽空安全跳过）
    整64 零1674 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零1674, T_整64, 0));
    IR追加(指令, 建IR指令(IR_指针存储, 槽地址1674, 零1674, 0, 0, T_字符串, 0));
    // 空类型调用占位值（语句位丢弃·宿主 lastExpr_ 占位常量同口径）
    整64 占位1674 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 占位1674, T_整32, 0));
    结果<空类型, 整32> 压摘1674 = 表达式栈.追加(占位1674);
    如果 (!压摘1674.正常) { 运行时错误(4); }
    返回 真;
}

函数 摘除槽类型文本IR1674(向量<节点> 池, 节点 实参摘) -> 字符串 {
    如果 (实参摘.类型 == 节点_标识符) {
        整64 名ID1674 = 整64(实参摘.文本);
        整64 类型ID1674 = 解析标识符类型ID(名ID1674);
        如果 (驻留ID有效摘1674(类型ID1674)) {
            // #1700 乙案：包装槽剥壳（手动释放<T> s; 摘除(s)=载荷槽 free+清槽）
            字符串 剥1674 = 手动释放载荷剥壳(字符串复制(驻留文本(类型ID1674)));
            如果 (非空串摘1674(剥1674)) { 返回 剥1674; }
            返回 字符串复制(驻留文本(类型ID1674));
        }
        // 类字段裸名（方法体内·当前类上下文）
        整64 当前类1674 = 当前方法类名ID;
        如果 (驻留ID有效摘1674(当前类1674)) {
            返回 类字段类型文本IR1674(池, 当前类1674, 名ID1674);
        }
        // 静默豁免上游已诊断: 标识符类型不可判定=非摘除面（语义层已拒形态）
        返回 空串1674();
    }
    如果 (实参摘.类型 != 节点_成员) { 返回 空串1674(); }
    // 成员链：对象类型=嵌套推导（链中段递归·末段对象=标识符）
    整64 对象起点1674 = 整64(实参摘.子起点);
    如果 (池界外摘1674(对象起点1674, 池)) { 返回 空串1674(); }
    节点 对象摘1674 = 池.元素(整32(对象起点1674));
    整64 对象类型ID1674 = 0;
    如果 (对象摘1674.类型 == 节点_标识符) {
        对象类型ID1674 = 解析标识符类型ID(整64(对象摘1674.文本));
        // 静默豁免上游已诊断: 对象类型 miss（语义层已验形态·防御显形）
    如果 (对象类型ID1674 <= 0) { 返回 空串1674(); }
    } 否则 如果 (对象摘1674.类型 == 节点_成员) {
        // 链中段（自身.缓存.值 的 自身.缓存）——递归推导中段类型
        字符串 中段1674 = 摘除槽类型文本IR1674(池, 对象摘1674);
        如果 (空串摘1674(中段1674)) { 返回 空串1674(); }
        对象类型ID1674 = 驻留(中段1674);
    }
    // 静默豁免上游已诊断: 成员链对象形态守卫（语义层已拒·防御重申）
    如果 (!(对象摘1674.类型 == 节点_标识符 || 对象摘1674.类型 == 节点_成员)) {
        返回 空串1674();   // 静默豁免上游已诊断: 形态不在支持面（语义层已拒·诚实边界）
    }
    字符串 对象类型1674 = 字符串复制(驻留文本(对象类型ID1674));
    如果 (字符串比较(对象类型1674, "自身")) {
        对象类型ID1674 = 当前方法类名ID;
    }
    // #1700 乙案：包装基座（手动释放<T> s; 摘除(s.值)）——唯一成员 .值=
    //   载荷槽（透明单载荷·宿主 removeSlotSrcType wrapPayload 分支同构）；
    //   其他成员名=语义层已拒（不可达·防御走类字段查询 miss=空串）。
    字符串 载荷1674 = 手动释放载荷剥壳(字符串复制(驻留文本(对象类型ID1674)));
    如果 (非空串摘1674(载荷1674)) {
        如果 (!字符串比较(字符串复制(驻留文本(整64(实参摘.文本))), "值")) {
            返回 空串1674();
        }
        返回 载荷1674;
    }
    返回 类字段类型文本IR1674(池, 对象类型ID1674, 整64(实参摘.文本));
}

// 类字段类型文本（沿基链——类节点子区间 节点_类字段 附加=类型节点索引）。
//   空串=沿链 miss（诚实边界）。
函数 类字段类型文本IR1674(向量<节点> 池, 整64 类名ID, 整64 字段名ID) -> 字符串 {
    整64 当前类1674 = 类名ID;
    整64 守卫1674 = 0;
    当 (当前类1674 != 0 && 守卫1674 < 64) {
        可选<整64> 类节点查1674 = 查类节点索引(当前类1674);
        如果 (类节点查1674.有值) {
            整64 类节点1674 = 类节点查1674.值;
            如果 (类节点1674 >= 0 && 类节点1674 < 整64(池.大小())) {
                节点 类值1674 = 池.元素(整32(类节点1674));
                整64 扫1674 = 整64(类值1674.子起点);
                当 (扫1674 < 整64(类值1674.子终点)) {
                    节点 成员1674 = 池.元素(整32(扫1674));
                    如果 (成员1674.类型 == 节点_类字段 &&
                          整64(成员1674.文本) == 字段名ID &&
                          成员1674.附加 > 0 && 成员1674.附加 < 整64(池.大小())) {
                        节点 类型节点1674 = 池.元素(整32(成员1674.附加));
                        返回 字符串复制(驻留文本(整64(类型节点1674.文本)));
                    }
                    扫1674++;
                }
            }
        }
        可选<整64> 基查1674 = 查类基名(当前类1674);
        如果 (!基查1674.有值) { 中断; }   // 链终止（显式否定拦截·#1674 甲案）
        如果 (基查1674.有值) { 当前类1674 = 基查1674.值; }
        守卫1674++;
    }
    返回 空串1674();
}

// 空串中转（#1674 守卫 miss 分流单点）：字面量经变量中转——mask/登记双口径
//   单行不可同时满足（字符串字面量被掩空致锚错位），中转后调用点非 return
//   字面量形态、唯一字面量落赋值位（静默形态不扫）。
函数 空串1674() -> 字符串 {
    字符串 空 = "";
    返回 空;
}

// ==================== #1674 守卫辅助（闭集边界单点·分支词面收纳） ====================

// 栈深守卫：摘除 展开需被调残留+实参值两项（转义展开同款弹序）
函数 摘除栈深足够1674(向量<整64>& 表达式栈) -> 布尔 {
    返回 !(表达式栈.大小() < 2);
}

// 成员实参区间守卫：链区间起点（子起点）须在池界内
函数 成员区间有效摘1674(节点 实参摘) -> 布尔 {
    返回 实参摘.类型 == 节点_成员 && 实参摘.子起点 > 0;
}

// 驻留 ID 守卫：类型/类名 ID 非零=已登记（驻留表键域从 1 起）
函数 驻留ID有效摘1674(整64 标识ID) -> 布尔 {
    返回 标识ID > 0;
}

// 池界守卫：节点索引双边界闭区间（0 起始·大小 上限）
函数 池界外摘1674(整64 索引, 向量<节点> 池) -> 布尔 {
    返回 索引 < 0 || 索引 >= 整64(池.大小());
}

// #1700 守卫辅助（闭集边界单点·分支词面收纳——单边开区间禁令/else 新规同源）
函数 非空串摘1674(字符串 文本) -> 布尔 {
    返回 字符串长度(文本) > 0;
}

函数 空串摘1674(字符串 文本) -> 布尔 {
    返回 字符串长度(文本) == 0;
}
