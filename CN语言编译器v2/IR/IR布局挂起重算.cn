// CN 自举编译器 v2 · IR 布局挂起重算（1079 两趟布局·宿主 920 同构）
// 职责：结构体/联合体布局前向引用支持——第一趟（解析期）字段依赖未登记的
//   容器挂起布局（大小表先落占位值·结果载荷字节 miss 落占位 8 不显形），
//   全部顶层声明解析完后收尾统一重算（第二趟）：全容器依赖图 DFS 后序=
//   被依赖者先算（拓扑序），值字段递归环显式报错（「无穷大小类型」编译期
//   拒绝）。
// 契约对标：宿主 semantic_types.cpp computeLayout（920 丙案「合成体就绪化
//   递归」+字段递归剥数组+layoutVisiting_ 栈环检测）——宿主布局惰性在语义
//   期触发（全部结构体已注册·依赖可即时递归就绪化）；v2 布局计算在解析期
//   （被依赖者可能尚未解析·即时递归不可得），同构语义以「解析期挂起+收尾
//   拓扑重算」实现——两语言时机不同·语义一致：前向引用合法（1049 锁面）·
//   环拒绝（414/1375/755 锁面）。
// 类（class）面（#1779·1079 机制对称扩展）：类布局重算涉 vptr/接口区/祖先字段
//   平移——复刻 解析类声明 的 computeClassLayout 链算法（同一头/推进/并入/尾
//   对齐口径·勿发明新布局规则）。触发条件=类挂起 或 结构体挂起（后者可能已
//   被类字段以占位值嵌入）。宿主 computeClassLayout 在全部结构体布局之后执行
//   （semantic.cpp 阶段B），本就无此前向引用缺陷——本段为 v2 时机族补齐。
// miss 纪律（648/882/1238）：占位面=解析期容器（结构体/联合体/类）字段布局
//   语境 且 依赖名 ∈待声明依赖集（字段循环前置提取登记）——重算后依赖仍 miss
//   （真未知类型）走既有 显形/T3 通道中止，零新增静默默认。挂起≠静默：显式
//   编译器内部状态·收尾强制重算闭环（挂起数>0 必走重算）。
// 依赖说明：仅导入 IR 包根（布局表族接口+类型判定族+键位移）——重算数据源
//   =字段区间索引/全字段表/类型大小与对齐（IR布局.cn 1079 段）。模块单向
//   依赖：本模块→IR布局 单向；消费方=语法分析（解析结构体声明 收口·语法
//   包→IR 包正向）+主（收尾调用）+IR容器判定（结果载荷字节 占位判定·同包）。
导入 容器::向量;
导入 映射集合;
导入 IR;
导入 协议常量;
导入 IO;         // 解析/收尾诊断输出（打印到错误）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// ==================== 挂起表（第一趟解析期写入） ====================
静态 向量<整64> 挂起键基们;      // 挂起容器键基（登记序——重算算法分派查字段区间类别表）
// 结构体形依赖名ID -> 1：解析期「已引用未登记」集——结果载荷字节 miss 占位
//   判据（命中=前向引用候选占位继续·重算修正；未命中=真 miss 照旧显形）。
//   生命周期=单次编译任务（清空布局挂起 与布局表族同步）。
静态 映射<整64, 整64> 待声明依赖名集;
// 解析期：容器（结构体/联合体/类）字段布局计算中=1（收口复位）——结果载荷
//   字节 占位判定的语境门（语义/生成期恒 0=占位窗口严格限于解析期字段布局；
//   #1779：类字段布局计算同置位——原类面排除导致结果载荷前向引用显形中止）
静态 整64 容器收口标记 = 0;

不安全 函数 设容器收口标记(整64 值) -> 空类型 { 容器收口标记 = 值; }

函数 查容器收口标记() -> 整64 { 返回 容器收口标记; }

// 登记布局挂起（解析结构体声明 收口·字段循环存在未登记依赖时调用）——
//   大小表已落占位值（登记结构体布局 照常），此处补挂起标记待收尾重算
//   （联合/结构体类别经 字段区间类别表 查——挂起表只记账键基）
不安全 函数 登记布局挂起(整64 结构体键基) -> 空类型 {
    结果<空类型, 整32> 加键 = 挂起键基们.追加(结构体键基);
    如果 (!加键.正常) { 运行时错误(4); }
}

函数 挂起布局数() -> 整64 { 返回 挂起键基们.大小(); }

// 待声明依赖名登记（字段循环前置提取·每未登记依赖名一条——集只增不减：
//   重名重复登记同值幂等）
不安全 函数 登记待声明依赖名(整64 类型名ID) -> 空类型 {
    结果<空类型, 整32> 加 = 待声明依赖名集.设置(类型名ID, 1);
    如果 (!加.正常) { 运行时错误(4); }
}

// 结果载荷字节 miss 占位判据（IR容器判定 消费）——命中=解析期前向引用候选
函数 是待声明依赖名(整64 类型名ID) -> 布尔 {
    结果<整64, 整32> 查 = 待声明依赖名集.获取(类型名ID);
    如果 (查.正常) { 返回 真; }
    返回 假;
}

// 收尾重算工作态（第二趟 DFS·收尾期间有效·清空结构体挂起态 统一复位）
静态 映射<整64, 整64> 重算色标们;   // 键基 -> 0=白(未访) 1=灰(重算栈中) 2=黑(已重算)
静态 映射<整64, 整64> 已报环键们;   // 键基 -> 1（每环只报一次·防多环连锁重复诊断）
静态 整64 本轮环诊断数 = 0;

// ==================== 类布局重算表（#1779·第一趟解析期写入） ====================
// 类名ID 而非键基作主键：类收口在解析期（当前模块路径=所属模块），收尾时
//   当前模块路径已切换——键基须在解析期留档，禁在收尾重算（防跨模块同名
//   类/派生类串桶）。
静态 向量<整64> 类重算清单们;        // 类名ID 登记序（声明序=基类先于派生类）
静态 映射<整64, 整64> 类重算键基们;   // 类名ID -> 解析期键基
静态 映射<整64, 整64> 类区间起点们;   // 类名ID -> 全字段表区间起点（并入祖先条目起）
静态 映射<整64, 整64> 类区间总数们;   // 类名ID -> 区间条目总数（并入祖先+自身字段）
静态 映射<整64, 整64> 类自身起点们;   // 类名ID -> 自身字段起点（并入祖先条目之后）
静态 映射<整64, 整64> 类自身数们;     // 类名ID -> 自身字段数
静态 向量<整64> 类挂起名ID们;        // 类名ID 挂起清单（自身字段存在未登记依赖）
静态 映射<整64, 整64> 类重算色标们;   // 类名ID -> 0白/1灰/2黑（基类先算·防御环）

// 结构体侧工作态清理（收尾重算挂起布局 结束调用——类挂起须保留到类重算）
不安全 函数 清空结构体挂起态() -> 空类型 {
    挂起键基们 = 向量<整64>();
    待声明依赖名集.清空();
    容器收口标记 = 0;
    重算色标们.清空();
    已报环键们.清空();
    本轮环诊断数 = 0;
}

// 类侧工作态清理（收尾重算类布局 结束调用）
不安全 函数 清空类布局挂起态() -> 空类型 {
    类重算清单们 = 向量<整64>();
    类重算键基们.清空();
    类区间起点们.清空();
    类区间总数们.清空();
    类自身起点们.清空();
    类自身数们.清空();
    类挂起名ID们 = 向量<整64>();
    类重算色标们.清空();
}

// 任务级清空（主.cn 与 清空结构体布局表 同步调用点——防跨编译轮残留；
//   含两侧收尾重算工作态——收尾完成/中止后统一复位）
不安全 函数 清空布局挂起() -> 空类型 {
    清空结构体挂起态();
    清空类布局挂起态();
}

// ==================== 结构体形依赖名提取 ====================
// 字段类型文本中的全部结构体形依赖名收集（环检测图与挂起判定共用数据源）。
//   剥指针层（尾 '*'·指针/引用槽 8 字节非值依赖——T3 附加判据同构）→
//   函数指针豁免 → 循环剥数组（元素指针同豁免）→ 结果/可选外壳剥载荷
//   （逐实参递归——嵌套合成体多实参独立收集）→ 基名豁免（标量族/字符串/
//   空类型/容器/用户类/枚举/泛型形参）后收集（已登记与否不在此判——调用方
//   按查结构体大小 分流：miss=待声明入集·命中=仅入图）。
// 与 T3 排除清单（语法分析中 收集未登记引用 前置判定）同源口径·超集：
//   T3 不剥结果/可选载荷（结果字段整体豁免）——本函数剥（载荷内结构体名
//   须进依赖图·1049 ②形态）。
不安全 函数 收集字段结构体依赖(字符串 字段类型文本, 向量<整64>& 出依赖) -> 空类型 {
    字符串 文本 = 字符串复制(字段类型文本);
    如果 (是指针类型文本(文本)) { 返回; }   // 指针/引用槽=8 字节地址·非值依赖
    // 040：函数指针字段文本（含 [N] 数组位）=指针族合法类型不入依赖
    如果 (字符串长度(文本) >= 16 && 字符串长度(文本) <= 2147483647 &&
         字符串比较(字符串子串(文本, 0, 13), "函数指针<")) { 返回; }
    // 循环剥数组壳（甲[2][3] 多层一次剥尽；元素指针 甲*[2] 元素层同豁免）
    当 (是数组类型文本(文本)) {
        可选<字符串> 剥元查 = 数组元素文本(文本);
        如果 (!剥元查.有值) { 返回; }   // 首字符即 '[' 等异常文本（正常解析不可达）——不入依赖
        文本 = 字符串复制(剥元查.值);
        如果 (是指针类型文本(文本)) { 返回; }
    }
    // 结果/可选外壳剥载荷：双形态——尖括号（源码原文）与 $ 合成形态（解析层
    //   类型文本归一形态：结构体/类字段声明的实际存储文本=结果$盒4$整32）。
    //   1079 缺口根治：原只认尖括号前缀 → $ 形态整名入依赖集、真载荷名反而
    //   不入（「结果<盒4,整32> 字段声明集里只有 结果$盒4$整32」）→ 结果载荷
    //   字节 miss 占位判据查不到 盒4 → 无先行同依赖引用时仍显形中止（1625 靠
    //   倒挂外[2] 数组先登记 盒4 侥幸通过=声明序敏感缺陷）。$ 形态按元数感知
    //   切分（取实例实参们·嵌套合成名整段完整），与尖括号形态逐实参递归同构。
    如果 (是手动释放类型(文本)) { 返回; }   // 手动释放<T>=8 字节句柄槽（#1700 乙案）
    布尔 尖括号形态 = 字符串长度(文本) >= 7 && 字符串长度(文本) <= 2147483647 &&
        (字符串比较(字符串子串(文本, 0, 7), "结果<") ||
         字符串比较(字符串子串(文本, 0, 7), "可选<"));
    如果 (尖括号形态 || 是结果类型(文本)) {
        // $ 形态切分为默认路径；尖括号形态（源码原文）再覆盖重取——两形态
        //   单点互斥（无 else 分支：形态判据已由 尖括号形态 显式枚举）
        向量<字符串> 实参们 = 取实例实参们(文本);
        如果 (尖括号形态) {
            实参们 = 向量<字符串>();
            提取合成实参们(文本, 实参们);
        }
        整64 序 = 0;
        当 (序 < 实参们.大小()) {
            收集字段结构体依赖(实参们.元素(整32(序)), 出依赖);
            序++;
        }
        返回;
    }
    // 基名豁免清单（非结构体形的合法类型全集·与 T3 排除清单同源）——
    //   剩余=结构体形基名（含前向未登记者）收集
    //   泛型实例化类（`盒子$整64`）=类句柄槽 8 字节·非值依赖（与 是用户类 同族；
    //   实例名在解析期未入 用户类们，故单列判据——#1779 预验 1556 回归根治）
    如果 (字符串长度(文本) == 0 ||
         是标量类型文本(文本) ||
         字符串比较(文本, "字符串") || 字符串比较(文本, "空类型") ||
         是用户类(文本) || 是容器类(文本) ||
         是泛型实例类名(文本) ||
         是枚举名(驻留(文本)) || 是泛型参数名(驻留(文本))) { 返回; }
    结果<空类型, 整32> 加 = 出依赖.追加(驻留(文本));
    如果 (!加.正常) { 运行时错误(4); }
}

// 合成名实参提取（尖括号深度感知逗号分割）：「结果<甲[2], 整32>」→
//   ["甲[2]", "整32"]（实参首尾空白修剪）。返回实参数（0=无配对尖括号）。
函数 提取合成实参们(字符串 合成名文本, 向量<字符串>& 出实参) -> 整64 {
    整64 长度 = 字符串长度(合成名文本);
    整64 起括 = -1;
    整64 深度 = 0;
    整64 段起点 = -1;
    整64 扫位 = 0;
    当 (扫位 < 长度) {
        整64 字节b = 整64(合成名文本[整32(扫位)]) & 255;
        如果 (字节b == 60) {              // '<'
            如果 (深度 == 0) { 起括 = 扫位; 段起点 = 扫位 + 1; }
            深度 = 深度 + 1;
        } 否则 如果 (字节b == 62) {        // '>'
            深度 = 深度 - 1;
            如果 (深度 == 0) {
                结果<空类型, 整32> 加 = 出实参.追加(
                    去文本首尾空白(字符串子串(合成名文本, 整32(段起点), 整32(扫位 - 段起点))));
                如果 (!加.正常) { 运行时错误(4); }
                中断;
            }
        } 否则 如果 (字节b == 44 && 深度 == 1) {   // ',' 顶层分割
            结果<空类型, 整32> 加段 = 出实参.追加(
                去文本首尾空白(字符串子串(合成名文本, 整32(段起点), 整32(扫位 - 段起点))));
            如果 (!加段.正常) { 运行时错误(4); }
            段起点 = 扫位 + 1;
        }
        扫位++;
    }
    返回 出实参.大小();
}

// 文本首尾空白修剪（空格 32——合成名实参分隔符后置空格清理）
函数 去文本首尾空白(字符串 原文) -> 字符串 {
    整64 起 = 0;
    整64 末 = 字符串长度(原文);
    当 (起 < 末 && (整64(原文[整32(起)]) & 255) == 32) { 起++; }
    当 (末 > 起 && (整64(原文[整32(末 - 1)]) & 255) == 32) { 末--; }
    如果 (起 == 0 && 末 == 字符串长度(原文)) { 返回 字符串复制(原文); }   // 拥有契约：返回值须落堆（参数=借用）
    返回 字符串子串(原文, 整32(起), 整32(末 - 起));
}

// ==================== 语法层收口调用 ====================
// 字段大小/对齐口径单点（1079 两趟布局提炼）：类型大小与对齐（857 前置·数组/
//   结果/结构体递归）+ 指针层宽对齐折算（857 指针槽 8/8）+ 类/容器句柄口径
//   （860-a 8/8）三段合一——解析结构体字段/解析类字段 与 本模块重算闭包 单点
//   共享（重复归纳纪律：同一布局口径三处消费·归纳单点防漂移）。
//   层位注记：本函数只调 IR布局 公开判定族（零私有表访问）·居本模块=重算闭包
//   同文件消费+语法包跨包正向调用（语法→IR 单向）。
不安全 函数 字段布局口径(字符串 基名文本, 整64 星层, 整64* 大小, 整64* 对齐) -> 空类型 {
    大小[0] = 8;
    对齐[0] = 8;
    类型大小与对齐(基名文本, 大小, 对齐);
    指针层宽对齐折算(星层, 大小, 对齐);
    // 类/容器/泛型实例化类=对象句柄（8/8）——泛型实例名（盒子$整64）不含于
    //   用户类们（IR 生成期才注册），须显式并入本口径，免落 类型大小与对齐
    //   尾部未知默认（值虽同为 8/8，但口径来源须显式=防未来默认值漂移）
    如果 (是用户类(基名文本) || 是容器类(基名文本) ||
         是泛型实例类名(基名文本)) {
        大小[0] = 8;
        对齐[0] = 8;
    }
}

// 逐字段前置提取（解析结构体声明 字段循环·解析结构体字段 调用前——须赶在
//   字段布局计算的结果载荷 miss 判定之前入集）：指针/引用层字段零值依赖直接
//   豁免；其余提取依赖→未登记者入待声明集。返回 真=本字段存在未登记依赖
//   （调用方累计——收口判定挂起依据）。
不安全 函数 登记字段布局依赖(字符串 字段类型文本, 整64 星层) -> 布尔 {
    // 附加域口径（857 注）：0=值字段 / 1..255=指针层 / 256+=引用层——非零即
    //   槽语义（8 字节地址·零值依赖），豁免判据与 T3 收集器（附加 == 0 才入
    //   收集）真同源。布尔提取=「有附加层」语义判断（开放域非闭区间·
    //   #1716 审查修正：原 1..255 闭区间漏引用层 256+ 致 `甲&` 误收集）。
    布尔 有附加层 = 星层 >= 1;
    如果 (有附加层) { 返回 假; }   // 类型节点文本=剥层基名·层在附加位——文本域判不出
    向量<整64> 依赖们 = 向量<整64>();
    收集字段结构体依赖(字段类型文本, 依赖们);
    布尔 有未登记 = 假;
    整64 序 = 0;
    当 (序 < 依赖们.大小()) {
        整64 依赖名 = 依赖们.元素(整32(序));
        如果 (!是结构体大小非零(依赖名)) {
            登记待声明依赖名(依赖名);
            有未登记 = 真;
        }
        序++;
    }
    返回 有未登记;
}

// 解析结构体声明 收口（登记结构体布局 之后）：字段循环存在未登记依赖=挂起
//   （占位布局已落大小表·待收尾重算修正）。区间索引同点登记（重算字段数据源）。
不安全 函数 收口布局挂起(整64 结构体键基, 整64 字段起点序, 整64 字段数,
                    整64 是联合, 整64 有未登记依赖) -> 空类型 {
    整64 区间类别 = 0;
    如果 (是联合 == 1) { 区间类别 = 1; }
    登记结构体字段区间(结构体键基, 字段起点序, 字段数, 区间类别);
    如果 (有未登记依赖 == 1) {
        登记布局挂起(结构体键基);
    }
}

// ==================== 类布局两趟（#1779·1079 结构体机制对称扩展） ====================
// 第一趟（解析期）登记：类收口调用——重算区间/自身字段区间留档+挂起判定。
//   区间起点=并入祖先条目之前（全字段表布局：祖先层…自身层）；自身起点=并入
//   完成之后（自身字段循环起点）。类字段前向引用（结构体值类型/数组/结果载荷）
//   在解析期按未知默认 8/8 占位，收尾重算按真值覆盖。
//   挂起判定口径同结构体：自身字段依赖名 是结构体大小非零 为假=未登记依赖
//   （前向引用候选；类名句柄 8/8 重算幂等，挂起无副作用）。
不安全 函数 登记类布局区间(整64 类名ID, 整64 类键基, 整64 区间起点, 整64 自身起点) -> 空类型 {
    整64 条目总数 = 全字段表条目数();
    整64 区间总数 = 条目总数 - 区间起点;
    整64 自身数 = 条目总数 - 自身起点;
    // 清单幂等（类解析单点，防御重复登记：只覆盖数值·清单不重复追加）
    结果<整64, 整32> 查已 = 类重算键基们.获取(类名ID);
    如果 (!查已.正常) {
        结果<空类型, 整32> 加列 = 类重算清单们.追加(类名ID);
        如果 (!加列.正常) { 运行时错误(4); }
    }
    结果<空类型, 整32> 设键 = 类重算键基们.设置(类名ID, 类键基);
    如果 (!设键.正常) { 运行时错误(4); }
    结果<空类型, 整32> 设起 = 类区间起点们.设置(类名ID, 区间起点);
    如果 (!设起.正常) { 运行时错误(4); }
    结果<空类型, 整32> 设总 = 类区间总数们.设置(类名ID, 区间总数);
    如果 (!设总.正常) { 运行时错误(4); }
    结果<空类型, 整32> 设自起 = 类自身起点们.设置(类名ID, 自身起点);
    如果 (!设自起.正常) { 运行时错误(4); }
    结果<空类型, 整32> 设自数 = 类自身数们.设置(类名ID, 自身数);
    如果 (!设自数.正常) { 运行时错误(4); }
    // 挂起判定：自身字段依赖扫描（收集器与结构体面同源——结果/可选载荷递归
    //   剥壳·指针/函数指针/标量/容器/枚举/泛型形参豁免）
    布尔 有未登记 = 假;
    整64 序 = 0;
    当 (序 < 自身数) {
        整64 键z = 0;
        整64 名z = 0;
        整64 类型z = 0;
        读全字段条目(自身起点 + 序, &键z, &名z, &类型z);
        向量<整64> 依赖们 = 向量<整64>();
        收集字段结构体依赖(驻留文本(类型z), 依赖们);
        // T3 未登记引用收集（#1779 类字段面并入·与结构体字段同源单点）：
        //   前向引用收尾后已登记=静默跳过；真未知类型收尾报「类 '...' 未知」。
        //   此处文本=全字段表原始形态（指针字段带尾星——收集器指针分支豁免）。
        收集字段未登记引用(字符串复制(驻留文本(类型z)), 0, 类名ID, 1);
        整64 依序 = 0;
        当 (依序 < 依赖们.大小()) {
            如果 (!是结构体大小非零(依赖们.元素(整32(依序)))) {
                有未登记 = 真;
            }
            依序++;
        }
        序++;
    }
    如果 (有未登记) {
        结果<空类型, 整32> 加挂 = 类挂起名ID们.追加(类名ID);
        如果 (!加挂.正常) { 运行时错误(4); }
    }
}

函数 类挂起布局数() -> 整64 { 返回 类挂起名ID们.大小(); }

// 字段类型「未登记引用」收集单点（T3 数据源·结构体/联合体/类三面共用）：
//   排除清单=非结构体形合法类型全集；数组按元素类型判定（1025：多层一次剥
//   尽——数组自身非结构体名）；解析期查大小 miss=入收集，收尾重算后仍未登记
//   → 检查未登记引用 报「未知类型」；已被前向声明补齐=静默跳过（布局已修正）。
不安全 函数 收集字段未登记引用(字符串 字段类型文本, 整64 星层,
                        整64 引用者名ID, 整64 引用者类别) -> 空类型 {
    // 指针/引用层（附加 1..255 / 256+）=8 字节槽·非值依赖（与结构体收集同源）
    如果 (星层 != 0) { 返回; }
    字符串 判定文本 = 字符串复制(字段类型文本);
    如果 (是数组类型文本(判定文本)) {
        可选<字符串> 剥元查 = 数组元素文本(判定文本);
        如果 (剥元查.有值) {
            字符串 剥元 = 字符串复制(剥元查.值);
            如果 (字符串长度(剥元) != 0) { 判定文本 = 剥元; }
        }
    }
    整64 判定名ID = 驻留(判定文本);
    布尔 非结构体形 = 是标量类型文本(判定文本) ||
        字符串比较(判定文本, "字符串") ||
        是用户类(判定文本) || 是指针类型文本(判定文本) ||
        是容器类(判定文本) || 是数组类型文本(判定文本) ||
        是结果类型(判定文本) || 是可选类型(判定文本) ||
        // 泛型实例化类（`盒子$整64`）=类句柄 8 字节·声明序无关合法类型——
        //   实例类名入 用户类们 在 IR 生成期，解析期此处须按基名判据放行
        //   （#1779 预验 1556：合法泛型类字段原被判未声明类型中止）
        是泛型实例类名(判定文本) ||
        是枚举名(驻留(判定文本)) ||
        是泛型参数名(驻留(判定文本)) ||   // 泛型类类型形参（单态化前合法占位·T/K/V）
        (字符串长度(判定文本) >= 16 && 字符串长度(判定文本) <= 2147483647 &&
         字符串比较(字符串子串(判定文本, 0, 13), "函数指针<"));
    如果 (非结构体形) { 返回; }
    如果 (!是结构体大小非零(判定名ID)) {
        收集未登记引用(引用者名ID, 判定名ID, 引用者类别);
    }
}

// ==================== 收尾重算（第二趟·类面） ====================
// 主入口：结构体检修之后由 布局收尾守卫 调用（类字段值类型依赖结构体真值）。
//   触发面=类挂起 或 结构体挂起（后者可能已被类字段按占位大小入布局——全量
//   重算幂等）。基类先于派生类（解析器「基类须先于派生类声明」），DFS 仍按基链
//   先算（防御性色标：环=编译器内部状态错误，解析器已拒未声明基类）。
不安全 函数 收尾重算类布局() -> 空类型 {
    整64 全数 = 类重算清单们.大小();
    整64 序 = 0;
    当 (序 < 全数) {
        类重算深度优先(类重算清单们.元素(整32(序)));
        序++;
    }
    清空类布局挂起态();
}

不安全 函数 类重算深度优先(整64 类名ID) -> 空类型 {
    整64 色 = 0;
    结果<整64, 整32> 查色 = 类重算色标们.获取(类名ID);
    如果 (查色.正常) { 色 = 查色.值; }
    如果 (色 == 0) {
        结果<空类型, 整32> 设灰 = 类重算色标们.设置(类名ID, 1);
        如果 (!设灰.正常) { 运行时错误(4); }
        可选<整64> 基查 = 查类基名(类名ID);
        如果 (基查.有值) { 类重算深度优先(基查.值); }
        重算类布局(类名ID);
        结果<空类型, 整32> 设黑 = 类重算色标们.设置(类名ID, 2);
        如果 (!设黑.正常) { 运行时错误(4); }
    } 否则 如果 (色 == 1) {
        // 基链环：解析器保证不可达——内部错误显形（不静默继续）
        登记内部未登记("类继承环", 字符串复制(驻留文本(类名ID)), 0);
    } 否则 如果 (色 == 2) {
        // 已重算真值就绪·跳过
    }
    // 色标闭集 {0,1,2} 全枚举；其他值=编译器内部状态错误（显形中止）
    布尔 色合法 = 色 == 0 || 色 == 1 || 色 == 2;
    如果 (!色合法) {
        登记内部未登记("类重算色标", 字符串复制(驻留文本(类名ID)), 0);
    }
}

// 类布局重算：复刻 解析类声明 的 [头区 vptr+接口区] + [祖先区] + 自身字段 + 尾
//   对齐算法逐位同构（头/接口槽由 登记类布局头 冻结·与字段大小无关，不重算）。
//   数据源=全字段表自身字段区间 + 解析期留档键基（收尾时当前模块路径已变）。
不安全 函数 重算类布局(整64 类名ID) -> 空类型 {
    结果<整64, 整32> 键基查 = 类重算键基们.获取(类名ID);
    如果 (!键基查.正常) {
        登记内部未登记("类布局键基", 字符串复制(驻留文本(类名ID)), 0);
        返回;
    }
    整64 类键基 = 键基查.值;
    整64 自身起点 = 0;
    整64 自身数 = 0;
    结果<整64, 整32> 查自起 = 类自身起点们.获取(类名ID);
    如果 (!查自起.正常) {
        登记内部未登记("类布局自身区间", 字符串复制(驻留文本(类名ID)), 0);
        返回;
    }
    结果<整64, 整32> 查自数 = 类自身数们.获取(类名ID);
    如果 (!查自数.正常) {
        登记内部未登记("类布局自身区间", 字符串复制(驻留文本(类名ID)), 0);
        返回;
    }
    自身起点 = 查自起.值;
    自身数 = 查自数.值;
    // 头区（vptr 8 + 接口分派区 槽数*8——解析期 登记类布局头 已冻结）
    整64 头 = 查类布局头(类名ID);
    整64 最大对齐 = 1;
    如果 (头 != 0) { 最大对齐 = 8; }
    整64 字段偏移 = 头;
    // 祖先区 + 并入条目偏移重算（父字段区尾 raw - 父头；平移=本头-父头）
    可选<整64> 基查 = 查类基名(类名ID);
    如果 (基查.有值) {
        重算类祖先区(类键基, 基查.值, 头, &字段偏移, &最大对齐);
    }
    // 自身字段（区间重放·口径单点 字段布局口径——与解析期同算法）
    整64 字段序 = 0;
    当 (字段序 < 自身数) {
        整64 键f = 0;
        整64 名f = 0;
        整64 类型f = 0;
        读全字段条目(自身起点 + 字段序, &键f, &名f, &类型f);
        整64 星层 = 0;
        字符串 基名文本 = 剥尾星基名(驻留文本(类型f), &星层);
        整64 字段大小 = 8;
        整64 字段对齐 = 8;
        字段布局口径(基名文本, 星层, &字段大小, &字段对齐);
        整64 余 = 字段偏移 % 字段对齐;
        如果 (余 != 0) { 字段偏移 = 字段偏移 + (字段对齐 - 余); }
        登记字段偏移(类键基 * 键位移 + 名f, 字段偏移);
        修正资源字段偏移(类键基, 名f, 字段偏移);
        如果 (字段对齐 > 最大对齐) { 最大对齐 = 字段对齐; }
        字段偏移 = 字段偏移 + 字段大小;
        字段序++;
    }
    // 收口：字段区尾 raw 留档（派生类祖先区消费）+ 尾对齐大小（解析期同款）
    整64 原始尾 = 字段偏移;
    整64 尾余 = 字段偏移 % 最大对齐;
    如果 (尾余 != 0) { 字段偏移 = 字段偏移 + (最大对齐 - 尾余); }
    登记类字段区尾(类名ID, 原始尾);
    覆盖结构体布局(类键基, 字段偏移, 最大对齐);
}

// 祖先区重算 + 并入条目偏移修正：子类键基域下父字段偏移=父真值+平移。
//   父区间（含父的并入条目）为遍历源——父键基域下的字段偏移表已是真值
//   （DFS 基类先算）。阴影字段（子重名）由自身字段循环后写覆盖（解析期同序）。
不安全 函数 重算类祖先区(整64 类键基, 整64 基名ID, 整64 本头,
                  整64* 字段偏移, 整64* 最大对齐) -> 空类型 {
    结果<整64, 整32> 基键查 = 类重算键基们.获取(基名ID);
    如果 (!基键查.正常) {
        登记内部未登记("类基布局键基", 字符串复制(驻留文本(基名ID)), 0);
        返回;
    }
    整64 基键 = 基键查.值;
    整64 基头 = 查类布局头(基名ID);
    整64 祖先区 = 0;
    可选<整64> 父尾查 = 查类字段区尾(基名ID);
    如果 (父尾查.有值) {
        祖先区 = 父尾查.值 - 基头;
    }
    如果 (!父尾查.有值) {
        // 解析期同款回退（类字段区尾 未登记=理论不可达）：父对象大小-父头
        结果<整64, 整32> 查父大 = 结构体大小表.获取(基键);
        如果 (!查父大.正常) {
            登记内部未登记("类基布局大小", 字符串复制(驻留文本(基名ID)), 0);
        }
        如果 (查父大.正常) {
            祖先区 = 查父大.值 - 基头;
        }
    }
    字段偏移[0] = 字段偏移[0] + 祖先区;
    结果<整64, 整32> 查父齐 = 结构体对齐表.获取(基键);
    如果 (!查父齐.正常) {
        登记内部未登记("类基布局对齐", 字符串复制(驻留文本(基名ID)), 0);
    }
    如果 (查父齐.正常) {
        如果 (查父齐.值 > 最大对齐[0]) { 最大对齐[0] = 查父齐.值; }
    }
    整64 平移 = 本头 - 基头;
    整64 基区间起点 = 0;
    整64 基区间总数 = 0;
    结果<整64, 整32> 查基起 = 类区间起点们.获取(基名ID);
    如果 (!查基起.正常) {
        登记内部未登记("类基布局区间", 字符串复制(驻留文本(基名ID)), 0);
        返回;
    }
    结果<整64, 整32> 查基总 = 类区间总数们.获取(基名ID);
    如果 (!查基总.正常) {
        登记内部未登记("类基布局区间", 字符串复制(驻留文本(基名ID)), 0);
        返回;
    }
    基区间起点 = 查基起.值;
    基区间总数 = 查基总.值;
    整64 序b = 0;
    当 (序b < 基区间总数) {
        整64 键b = 0;
        整64 名b = 0;
        整64 类型b = 0;
        读全字段条目(基区间起点 + 序b, &键b, &名b, &类型b);
        结果<整64, 整32> 查父偏 = 字段偏移表们.获取(基键 * 键位移 + 名b);
        如果 (!查父偏.正常) {
            登记内部未登记("类并入字段偏移", 字符串复制(驻留文本(名b)), 0);
        }
        如果 (查父偏.正常) {
            整64 新偏 = 查父偏.值 + 平移;
            登记字段偏移(类键基 * 键位移 + 名b, 新偏);
            修正资源字段偏移(类键基, 名b, 新偏);
        }
        序b++;
    }
}

// 剥尾星取基名+星层（全字段表存原始星号形态——解析期 类型节点.文本=基名、
//   附加=星层；重算闭包按文本剥离还原同一口径）。星层域 1..255（857 指针层
//   闭集）；超出=解析期不可产出的形态，按原文本返回（字段布局口径 兜底同款）。
不安全 函数 剥尾星基名(字符串 原始文本, 整64* 星层出) -> 字符串 {
    整64 星层 = 0;
    整64 末位 = 字符串长度(原始文本);
    当 (末位 > 0 && (整64(原始文本[整32(末位 - 1)]) & 255) == 42) {
        末位--;
        星层++;
    }
    星层出[0] = 星层;
    如果 (星层 >= 1 && 星层 <= 255) {
        返回 字符串子串(原始文本, 0, 整32(末位));
    }
    返回 字符串复制(原始文本);
}

// 布局收尾守卫（主.cn 全解析后·语义检查前调用——原主.cn 内联 T3 段+1079 收尾
//   段收拢单点·主.cn 体量冻结线 242）：
//   ①1079 收尾重算挂起布局：前向引用拓扑修正+值字段递归环检测——须先于 T3
//     判定（重算修正大小后「已登记」才区分前向引用（已修正）与真未知类型）；
//     环诊断>0 返回 1（逐条环诊断行已出·占位值维持不产假值产物）。
//   ②1779 类面收尾重算：类挂起（类字段前向引用）或结构体挂起（类字段可能以
//     占位结构体大小入布局）任一成立→全量类重算（声明序+基链先算·幂等）。
//   ③T3 未知类型聚合守卫（311-a=306-b v2 侧·1079 立法收窄：「先声明后使用」
//     类别废除——前向引用合法化（布局由①②拓扑修正），环检测移至①重算闭包
//     （对齐宿主 920 computeLayout visiting 栈语义）；本段剩余职责=真未声明
//     类型逐条诊断+中止；聚合后清空防跨编译轮残留）。
//   返回 0=通过；1=中止（不产 IR/asm·错误产物纪律同族）。
不安全 函数 布局收尾守卫() -> 整64 {
    整64 结构体挂起数 = 挂起布局数();
    整64 类挂起数 = 类挂起布局数();
    如果 (结构体挂起数 >= 1 && 结构体挂起数 <= 2147483647) {
        整64 环诊断数 = 收尾重算挂起布局();
        如果 (环诊断数 >= 1 && 环诊断数 <= 2147483647) { 返回 1; }
    }
    布尔 需重算类 = (类挂起数 >= 1 && 类挂起数 <= 2147483647) ||
                    (结构体挂起数 >= 1 && 结构体挂起数 <= 2147483647);
    如果 (需重算类) {
        收尾重算类布局();
    }
    如果 (未登记引用数() >= 1 && 未登记引用数() <= 2147483647) {
        整64 布局违规数 = 检查未登记引用();
        清空未登记引用();
        如果 (布局违规数 >= 1 && 布局违规数 <= 2147483647) { 返回 1; }
    }
    返回 0;
}

// ==================== 收尾重算（第二趟·由 布局收尾守卫 调用） ====================

// 主入口：返回环诊断数（>0=编译中止·环成员维持占位值不产假值产物）。
//   快路径：无挂起零开销（常规编译恒走——挂起机制只在前向引用程序激活）。
//   全量 DFS（全结构体键基清单·非仅挂起者）：已布局者的布局可能基于挂起者
//   占位值（声明序居后者），须一并重算——非挂起者重算幂等（依赖真值·同值
//   覆盖），挂起者重算修正。环诊断数>0 时跳过全部重算（错误程序中止·不产
//   部分重算的混合态）。
不安全 函数 收尾重算挂起布局() -> 整64 {
    如果 (挂起布局数() == 0) { 返回 0; }
    整64 全数 = 全结构体键基数();
    整64 序 = 0;
    当 (序 < 全数) {
        整64 键基 = 全结构体键基(序);
        结果<整64, 整32> 查色 = 重算色标们.获取(键基);
        如果 (!查色.正常) {
            重算深度优先(键基);
        }
        序++;
    }
    整64 环诊断数 = 本轮环诊断数;
    清空结构体挂起态();
    返回 环诊断数;
}

// 依赖图 DFS：灰命中=值字段递归环（报错一次/环）；依赖闭包就绪后重算本容器
//   （拓扑后序=被依赖者先算——宿主 computeLayout 惰性递归同构）。
不安全 函数 重算深度优先(整64 键基) -> 空类型 {
    结果<空类型, 整32> 设灰 = 重算色标们.设置(键基, 1);
    如果 (!设灰.正常) { 运行时错误(4); }
    整64 区间起点 = 0;
    整64 字段数 = 0;
    整64 类别 = 0;
    结果<空类型, 整32> 区间查 = 查结构体字段区间(键基, &区间起点, &字段数, &类别);
    布尔 区间命中 = 区间查.正常;
    如果 (区间命中) {
        // 依赖先算（字段循环逐依赖递归——依赖者未算则其布局按占位值，
        //   本容器会连带错值；先递归即拓扑序真值链）
        整64 字段序 = 0;
        当 (字段序 < 字段数) {
            整64 键f = 0;
            整64 名f = 0;
            整64 类型f = 0;
            读全字段条目(区间起点 + 字段序, &键f, &名f, &类型f);
            向量<整64> 依赖们 = 向量<整64>();
            收集字段结构体依赖(驻留文本(类型f), 依赖们);
            整64 依赖序 = 0;
            当 (依赖序 < 依赖们.大小()) {
                整64 依赖名 = 依赖们.元素(整32(依赖序));
                可选<整64> 依赖键查 = 结构体布局键基(依赖名);
                如果 (依赖键查.有值) {
                    整64 依赖键 = 依赖键查.值;
                    // 色标闭集 {0=白, 1=灰, 2=黑} 显式枚举分派（1079 else 新规：
                    //   无 else 兜底——非法值不可达，色标只经 设置 写闭集值）
                    整64 色d = 0;
                    结果<整64, 整32> 查色d = 重算色标们.获取(依赖键);
                    如果 (查色d.正常) { 色d = 查色d.值; }
                    如果 (色d == 1) {
                        // 灰=环：依赖者正在重算栈中（无穷大小类型）
                        报环诊断(键基, 名f, 依赖键);
                    } 否则 如果 (色d == 0) {
                        // 白=未访：依赖者未重算——查区间递归（无区间=非本库
                        //   容器·收集器豁免清单保证结构体形依赖必登记）
                        整64 依赖类别 = 0;
                        整64 依赖起点 = 0;
                        整64 依赖字段数 = 0;
                        结果<空类型, 整32> 依赖区间查 = 查结构体字段区间(依赖键, &依赖起点, &依赖字段数, &依赖类别);
                        如果 (依赖区间查.正常) { 重算深度优先(依赖键); }
                    }
                    // 黑（2）=已重算真值就绪·跳过
                }
                依赖序++;
            }
            字段序++;
        }
    }
    // 依赖闭包就绪 → 重算本容器布局（环已现形时放弃重算——错误程序中止·
    //   不产占位/半真值混合态）
    如果 (本轮环诊断数 == 0 && 区间命中) {
        重算容器布局(键基, 区间起点, 字段数, 类别);
    }
    结果<空类型, 整32> 设黑 = 重算色标们.设置(键基, 2);
    如果 (!设黑.正常) { 运行时错误(4); }
}

// 环诊断（宿主 computeLayout 字段循环环报错同语义·文案对齐「无穷大小类型」
//   编译期拒绝锚）——每环只报一次（环上其余成员静默·防连锁重复诊断·
//   宿主「错误已报，防连锁误报」同款）
不安全 函数 报环诊断(整64 引用者键基, 整64 字段名ID, 整64 被引键基) -> 空类型 {
    结果<整64, 整32> 查报 = 已报环键们.获取(被引键基);
    如果 (查报.正常) { 返回; }
    结果<空类型, 整32> 设报 = 已报环键们.设置(被引键基, 1);
    如果 (!设报.正常) { 运行时错误(4); }
    IO::打印到错误("[布局] 结构体 '" + 字符串复制(驻留文本(引用者键基)) +
                   "' 的字段 '" + 字符串复制(驻留文本(字段名ID)) +
                   "' 递归引用了正在收尾重算布局的结构体 '" +
                   字符串复制(驻留文本(被引键基)) +
                   "'（值字段递归=无穷大小类型）——请将该字段改为指针，或改用类（引用语义）\n");
    本轮环诊断数++;
}

// 容器布局重算（结构体/联合体——类别 0/1；区间重放字段·口径单点 字段布局
//   口径）：大小/对齐覆盖 结构体大小表/对齐表；字段偏移覆盖 字段偏移表们
//   （生成期 728h 权威偏移覆盖机制读此表——语法层节点附加错值由其纠偏）；
//   资源字段偏移原地修正（四元组平铺向量·字段集合不变仅偏移变）。
//   构造字段/字段类型/全字段表/候选表与字段集合相关·重算零涉及（不重复登记）。
不安全 函数 重算容器布局(整64 键基, 整64 区间起点, 整64 字段数, 整64 类别) -> 空类型 {
    整64 总偏移 = 0;
    整64 最大对齐 = 1;
    整64 最大字段 = 0;
    整64 字段序 = 0;
    当 (字段序 < 字段数) {
        整64 键f = 0;
        整64 名f = 0;
        整64 类型f = 0;
        读全字段条目(区间起点 + 字段序, &键f, &名f, &类型f);
        整64 字段大小 = 8;
        整64 字段对齐 = 8;
        // 原始类型文本含尾星（217 登记原始星号形态）——剥星取基名+星层
        整64 星层 = 0;
        字符串 基名文本 = 剥尾星基名(驻留文本(类型f), &星层);
        字段布局口径(基名文本, 星层, &字段大小, &字段对齐);
        // 偏移（联合体=全字段 0·结构体=对齐推进——与解析期算法同构）
        整64 偏移f = 0;
        如果 (类别 != 1) {
            整64 余 = 总偏移 % 字段对齐;
            如果 (余 != 0) { 总偏移 = 总偏移 + (字段对齐 - 余); }
            偏移f = 总偏移;
        }
        整64 分桶键 = 键基 * 键位移 + 名f;
        登记字段偏移(分桶键, 偏移f);
        修正资源字段偏移(键基, 名f, 偏移f);
        如果 (字段对齐 > 最大对齐) { 最大对齐 = 字段对齐; }
        如果 (字段大小 > 最大字段) { 最大字段 = 字段大小; }
        如果 (类别 != 1) { 总偏移 = 偏移f + 字段大小; }
        字段序++;
    }
    // 收口（结构体=尾对齐总偏移·联合体=最大字段向最大对齐圆整——C 布局语义；
    //   类别闭集 {0=结构体, 1=联合体} 显式枚举·无 else 兜底）
    整64 总大小 = 0;
    如果 (类别 == 1) {
        整64 尾余u = 最大字段 % 最大对齐;
        如果 (尾余u != 0) { 最大字段 = 最大字段 + (最大对齐 - 尾余u); }
        总大小 = 最大字段;
    } 否则 如果 (类别 == 0) {
        整64 尾余 = 总偏移 % 最大对齐;
        如果 (尾余 != 0) { 总偏移 = 总偏移 + (最大对齐 - 尾余); }
        总大小 = 总偏移;
    }
    覆盖结构体布局(键基, 总大小, 最大对齐);
}
