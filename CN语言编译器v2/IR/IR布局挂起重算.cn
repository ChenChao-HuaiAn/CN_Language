// CN 自举编译器 v2 · IR 布局挂起重算（1079 两趟布局·宿主 920 同构）
// 职责：结构体/联合体布局前向引用支持——第一趟（解析期）字段依赖未登记的
//   容器挂起布局（大小表先落占位值·结果载荷字节 miss 落占位 8 不显形），
//   全部顶层声明解析完后收尾统一重算（第二趟）：全容器依赖图 DFS 后序=
//   被依赖者先算（拓扑序），值字段递归环显式报错（「无穷大小类型」编译期
//   拒绝）。
// 契约对标：宿主 semantic_types.cpp computeLayout（920 丙案「合成体就绪化
//   递归」+字段递归剥数组+layoutVisiting_ 栈环检测）——宿主布局惰性在语义
//   期触发（全部结构体已注册·依赖可即时递归就绪化）；v2 布局计算在解析期
//   （被依赖者可能尚未解析·即时递归不可得），同构语义以「解析期挂起+收尾
//   拓扑重算」实现——两语言时机不同·语义一致：前向引用合法（1049 锁面）·
//   环拒绝（414/1375/755 锁面）。
// 类（class）面边界：类布局重算涉及 vptr/接口区/祖先字段平移（computeClass
//   Layout 链逻辑复刻·78/79 固定点敏感），本模块不纳入——类收口不置 收口
//   中 标记，类字段的结果载荷 miss 照旧显形中止（现状行为零变化·类面前向
//   引用缺陷另行立项）。
// miss 纪律（648/882/1238）：占位面=解析期结构体/联合体收口语境 且 依赖名
//   ∈待声明依赖集（字段循环前置提取登记）——重算后依赖仍 miss（真未知类
//   型）走既有 显形/T3 通道中止，零新增静默默认。挂起≠静默：显式编译器内
//   部状态·收尾强制重算闭环（挂起数>0 必走重算）。
// 依赖说明：仅导入 IR 包根（布局表族接口+类型判定族+键位移）——重算数据源
//   =字段区间索引/全字段表/类型大小与对齐（IR布局.cn 1079 段）。模块单向
//   依赖：本模块→IR布局 单向；消费方=语法分析（解析结构体声明 收口·语法
//   包→IR 包正向）+主（收尾调用）+IR容器判定（结果载荷字节 占位判定·同包）。
导入 容器::向量;
导入 映射集合;
导入 IR;
导入 协议常量;
导入 IO;         // 解析/收尾诊断输出（打印到错误）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// ==================== 挂起表（第一趟解析期写入） ====================
静态 向量<整64> 挂起键基们;      // 挂起容器键基（登记序——重算算法分派查字段区间类别表）
// 结构体形依赖名ID -> 1：解析期「已引用未登记」集——结果载荷字节 miss 占位
//   判据（命中=前向引用候选占位继续·重算修正；未命中=真 miss 照旧显形）。
//   生命周期=单次编译任务（清空布局挂起 与布局表族同步）。
静态 映射<整64, 整64> 待声明依赖名集;
// 解析期：结构体/联合体字段循环中=1（收口复位）——结果载荷字节 占位判定的
//   语境门（类收口不置位·语义/生成期恒 0=占位窗口严格限于解析期结构体收口）
静态 整64 结构体收口标记 = 0;

不安全 函数 设结构体收口标记(整64 值) -> 空类型 { 结构体收口标记 = 值; }

函数 查结构体收口标记() -> 整64 { 返回 结构体收口标记; }

// 登记布局挂起（解析结构体声明 收口·字段循环存在未登记依赖时调用）——
//   大小表已落占位值（登记结构体布局 照常），此处补挂起标记待收尾重算
//   （联合/结构体类别经 字段区间类别表 查——挂起表只记账键基）
不安全 函数 登记布局挂起(整64 结构体键基) -> 空类型 {
    结果<空类型, 整32> 加键 = 挂起键基们.追加(结构体键基);
    如果 (!加键.正常) { 运行时错误(4); }
}

函数 挂起布局数() -> 整64 { 返回 挂起键基们.大小(); }

// 待声明依赖名登记（字段循环前置提取·每未登记依赖名一条——集只增不减：
//   重名重复登记同值幂等）
不安全 函数 登记待声明依赖名(整64 类型名ID) -> 空类型 {
    结果<空类型, 整32> 加 = 待声明依赖名集.设置(类型名ID, 1);
    如果 (!加.正常) { 运行时错误(4); }
}

// 结果载荷字节 miss 占位判据（IR容器判定 消费）——命中=解析期前向引用候选
函数 是待声明依赖名(整64 类型名ID) -> 布尔 {
    结果<整64, 整32> 查 = 待声明依赖名集.获取(类型名ID);
    如果 (查.正常) { 返回 真; }
    返回 假;
}

// 收尾重算工作态（第二趟 DFS·收尾期间有效·清空布局挂起 统一复位）
静态 映射<整64, 整64> 重算色标们;   // 键基 -> 0=白(未访) 1=灰(重算栈中) 2=黑(已重算)
静态 映射<整64, 整64> 已报环键们;   // 键基 -> 1（每环只报一次·防多环连锁重复诊断）
静态 整64 本轮环诊断数 = 0;

// 任务级清空（主.cn 与 清空结构体布局表 同步调用点——防跨编译轮残留；
//   含收尾重算工作态——收尾完成/中止后统一复位）
不安全 函数 清空布局挂起() -> 空类型 {
    挂起键基们 = 向量<整64>();
    待声明依赖名集.清空();
    结构体收口标记 = 0;
    重算色标们.清空();
    已报环键们.清空();
    本轮环诊断数 = 0;
}

// ==================== 结构体形依赖名提取 ====================
// 字段类型文本中的全部结构体形依赖名收集（环检测图与挂起判定共用数据源）。
//   剥指针层（尾 '*'·指针/引用槽 8 字节非值依赖——T3 附加判据同构）→
//   函数指针豁免 → 循环剥数组（元素指针同豁免）→ 结果/可选外壳剥载荷
//   （逐实参递归——嵌套合成体多实参独立收集）→ 基名豁免（标量族/字符串/
//   空类型/容器/用户类/枚举/泛型形参）后收集（已登记与否不在此判——调用方
//   按查结构体大小 分流：miss=待声明入集·命中=仅入图）。
// 与 T3 排除清单（语法分析中 收集未登记引用 前置判定）同源口径·超集：
//   T3 不剥结果/可选载荷（结果字段整体豁免）——本函数剥（载荷内结构体名
//   须进依赖图·1049 ②形态）。
不安全 函数 收集字段结构体依赖(字符串 字段类型文本, 向量<整64>& 出依赖) -> 空类型 {
    字符串 文本 = 字符串复制(字段类型文本);
    如果 (是指针类型文本(文本)) { 返回; }   // 指针/引用槽=8 字节地址·非值依赖
    // 040：函数指针字段文本（含 [N] 数组位）=指针族合法类型不入依赖
    如果 (字符串长度(文本) >= 16 && 字符串长度(文本) <= 2147483647 &&
         字符串比较(字符串子串(文本, 0, 13), "函数指针<")) { 返回; }
    // 循环剥数组壳（甲[2][3] 多层一次剥尽；元素指针 甲*[2] 元素层同豁免）
    当 (是数组类型文本(文本)) {
        可选<字符串> 剥元查 = 数组元素文本(文本);
        如果 (!剥元查.有值) { 返回; }   // 首字符即 '[' 等异常文本（正常解析不可达）——不入依赖
        文本 = 字符串复制(剥元查.值);
        如果 (是指针类型文本(文本)) { 返回; }
    }
    // 结果/可选外壳剥载荷（尖括号形态——$ 形态合成名不进字段声明文本·
    //   容器归一化内部形态由 是容器类 豁免承担）
    如果 (字符串长度(文本) >= 7 && 字符串长度(文本) <= 2147483647 &&
         (字符串比较(字符串子串(文本, 0, 7), "结果<") ||
          字符串比较(字符串子串(文本, 0, 7), "可选<"))) {
        向量<字符串> 实参们 = 向量<字符串>();
        提取合成实参们(文本, 实参们);
        整64 序 = 0;
        当 (序 < 实参们.大小()) {
            收集字段结构体依赖(实参们.元素(整32(序)), 出依赖);
            序++;
        }
        返回;
    }
    // 基名豁免清单（非结构体形的合法类型全集·与 T3 排除清单同源）——
    //   剩余=结构体形基名（含前向未登记者）收集
    如果 (字符串长度(文本) == 0 ||
         是标量类型文本(文本) ||
         字符串比较(文本, "字符串") || 字符串比较(文本, "空类型") ||
         是用户类(文本) || 是容器类(文本) ||
         是枚举名(驻留(文本)) || 是泛型参数名(驻留(文本))) { 返回; }
    结果<空类型, 整32> 加 = 出依赖.追加(驻留(文本));
    如果 (!加.正常) { 运行时错误(4); }
}

// 合成名实参提取（尖括号深度感知逗号分割）：「结果<甲[2], 整32>」→
//   ["甲[2]", "整32"]（实参首尾空白修剪）。返回实参数（0=无配对尖括号）。
函数 提取合成实参们(字符串 合成名文本, 向量<字符串>& 出实参) -> 整64 {
    整64 长度 = 字符串长度(合成名文本);
    整64 起括 = -1;
    整64 深度 = 0;
    整64 段起点 = -1;
    整64 扫位 = 0;
    当 (扫位 < 长度) {
        整64 字节b = 整64(合成名文本[整32(扫位)]) & 255;
        如果 (字节b == 60) {              // '<'
            如果 (深度 == 0) { 起括 = 扫位; 段起点 = 扫位 + 1; }
            深度 = 深度 + 1;
        } 否则 如果 (字节b == 62) {        // '>'
            深度 = 深度 - 1;
            如果 (深度 == 0) {
                结果<空类型, 整32> 加 = 出实参.追加(
                    去文本首尾空白(字符串子串(合成名文本, 整32(段起点), 整32(扫位 - 段起点))));
                如果 (!加.正常) { 运行时错误(4); }
                中断;
            }
        } 否则 如果 (字节b == 44 && 深度 == 1) {   // ',' 顶层分割
            结果<空类型, 整32> 加段 = 出实参.追加(
                去文本首尾空白(字符串子串(合成名文本, 整32(段起点), 整32(扫位 - 段起点))));
            如果 (!加段.正常) { 运行时错误(4); }
            段起点 = 扫位 + 1;
        }
        扫位++;
    }
    返回 出实参.大小();
}

// 文本首尾空白修剪（空格 32——合成名实参分隔符后置空格清理）
函数 去文本首尾空白(字符串 原文) -> 字符串 {
    整64 起 = 0;
    整64 末 = 字符串长度(原文);
    当 (起 < 末 && (整64(原文[整32(起)]) & 255) == 32) { 起++; }
    当 (末 > 起 && (整64(原文[整32(末 - 1)]) & 255) == 32) { 末--; }
    如果 (起 == 0 && 末 == 字符串长度(原文)) { 返回 字符串复制(原文); }   // 拥有契约：返回值须落堆（参数=借用）
    返回 字符串子串(原文, 整32(起), 整32(末 - 起));
}

// ==================== 语法层收口调用 ====================
// 字段大小/对齐口径单点（1079 两趟布局提炼）：类型大小与对齐（857 前置·数组/
//   结果/结构体递归）+ 指针层宽对齐折算（857 指针槽 8/8）+ 类/容器句柄口径
//   （860-a 8/8）三段合一——解析结构体字段/解析类字段 与 本模块重算闭包 单点
//   共享（重复归纳纪律：同一布局口径三处消费·归纳单点防漂移）。
//   层位注记：本函数只调 IR布局 公开判定族（零私有表访问）·居本模块=重算闭包
//   同文件消费+语法包跨包正向调用（语法→IR 单向）。
不安全 函数 字段布局口径(字符串 基名文本, 整64 星层, 整64* 大小, 整64* 对齐) -> 空类型 {
    大小[0] = 8;
    对齐[0] = 8;
    类型大小与对齐(基名文本, 大小, 对齐);
    指针层宽对齐折算(星层, 大小, 对齐);
    如果 (是用户类(基名文本) || 是容器类(基名文本)) {
        大小[0] = 8;
        对齐[0] = 8;
    }
}

// 逐字段前置提取（解析结构体声明 字段循环·解析结构体字段 调用前——须赶在
//   字段布局计算的结果载荷 miss 判定之前入集）：指针层字段零值依赖直接豁免；
//   其余提取依赖→未登记者入待声明集。返回 真=本字段存在未登记依赖（调用方
//   累计——收口判定挂起依据）。
不安全 函数 登记字段布局依赖(字符串 字段类型文本, 整64 星层) -> 布尔 {
    如果 (星层 >= 1 && 星层 <= 255) { 返回 假; }   // 指针/引用槽=8 字节地址·零值依赖
                                   //   （类型节点文本=剥星基名·星层在附加位——文本域判不出；
                                   //   指针层域 1..255=857 口径·闭区间枚举）
    向量<整64> 依赖们 = 向量<整64>();
    收集字段结构体依赖(字段类型文本, 依赖们);
    布尔 有未登记 = 假;
    整64 序 = 0;
    当 (序 < 依赖们.大小()) {
        整64 依赖名 = 依赖们.元素(整32(序));
        如果 (!是结构体大小非零(依赖名)) {
            登记待声明依赖名(依赖名);
            有未登记 = 真;
        }
        序++;
    }
    返回 有未登记;
}

// 解析结构体声明 收口（登记结构体布局 之后）：字段循环存在未登记依赖=挂起
//   （占位布局已落大小表·待收尾重算修正）。区间索引同点登记（重算字段数据源）。
不安全 函数 收口布局挂起(整64 结构体键基, 整64 字段起点序, 整64 字段数,
                    整64 是联合, 整64 有未登记依赖) -> 空类型 {
    整64 区间类别 = 0;
    如果 (是联合 == 1) { 区间类别 = 1; }
    登记结构体字段区间(结构体键基, 字段起点序, 字段数, 区间类别);
    如果 (有未登记依赖 == 1) {
        登记布局挂起(结构体键基);
    }
}

// 布局收尾守卫（主.cn 全解析后·语义检查前调用——原主.cn 内联 T3 段+1079 收尾
//   段收拢单点·主.cn 体量冻结线 242）：
//   ①1079 收尾重算挂起布局：前向引用拓扑修正+值字段递归环检测——须先于 T3
//     判定（重算修正大小后「已登记」才区分前向引用（已修正）与真未知类型）；
//     环诊断>0 返回 1（逐条环诊断行已出·占位值维持不产假值产物）。
//   ②T3 未知类型聚合守卫（311-a=306-b v2 侧·1079 立法收窄：「先声明后使用」
//     类别废除——前向引用合法化（布局由①拓扑修正），环检测移至①重算闭包
//     （对齐宿主 920 computeLayout visiting 栈语义）；本段剩余职责=真未声明
//     类型逐条诊断+中止；聚合后清空防跨编译轮残留）。
//   返回 0=通过；1=中止（不产 IR/asm·错误产物纪律同族）。
不安全 函数 布局收尾守卫() -> 整64 {
    如果 (挂起布局数() >= 1 && 挂起布局数() <= 2147483647) {
        整64 环诊断数1079 = 收尾重算挂起布局();
        如果 (环诊断数1079 >= 1 && 环诊断数1079 <= 2147483647) { 返回 1; }
    }
    如果 (未登记引用数() >= 1 && 未登记引用数() <= 2147483647) {
        整64 布局违规数 = 检查未登记引用();
        清空未登记引用();
        如果 (布局违规数 >= 1 && 布局违规数 <= 2147483647) { 返回 1; }
    }
    返回 0;
}

// ==================== 收尾重算（第二趟·由 布局收尾守卫 调用） ====================

// 主入口：返回环诊断数（>0=编译中止·环成员维持占位值不产假值产物）。
//   快路径：无挂起零开销（常规编译恒走——挂起机制只在前向引用程序激活）。
//   全量 DFS（全结构体键基清单·非仅挂起者）：已布局者的布局可能基于挂起者
//   占位值（声明序居后者），须一并重算——非挂起者重算幂等（依赖真值·同值
//   覆盖），挂起者重算修正。环诊断数>0 时跳过全部重算（错误程序中止·不产
//   部分重算的混合态）。
不安全 函数 收尾重算挂起布局() -> 整64 {
    如果 (挂起布局数() == 0) { 返回 0; }
    整64 全数 = 全结构体键基数();
    整64 序 = 0;
    当 (序 < 全数) {
        整64 键基 = 全结构体键基(序);
        结果<整64, 整32> 查色 = 重算色标们.获取(键基);
        如果 (!查色.正常) {
            重算深度优先(键基);
        }
        序++;
    }
    整64 环诊断数 = 本轮环诊断数;
    清空布局挂起();
    返回 环诊断数;
}

// 依赖图 DFS：灰命中=值字段递归环（报错一次/环）；依赖闭包就绪后重算本容器
//   （拓扑后序=被依赖者先算——宿主 computeLayout 惰性递归同构）。
不安全 函数 重算深度优先(整64 键基) -> 空类型 {
    结果<空类型, 整32> 设灰 = 重算色标们.设置(键基, 1);
    如果 (!设灰.正常) { 运行时错误(4); }
    整64 区间起点 = 0;
    整64 字段数 = 0;
    整64 类别 = 0;
    结果<空类型, 整32> 区间查1079 = 查结构体字段区间(键基, &区间起点, &字段数, &类别);
    布尔 区间命中 = 区间查1079.正常;
    如果 (区间命中) {
        // 依赖先算（字段循环逐依赖递归——依赖者未算则其布局按占位值，
        //   本容器会连带错值；先递归即拓扑序真值链）
        整64 字段序 = 0;
        当 (字段序 < 字段数) {
            整64 键f = 0;
            整64 名f = 0;
            整64 类型f = 0;
            读全字段条目(区间起点 + 字段序, &键f, &名f, &类型f);
            向量<整64> 依赖们 = 向量<整64>();
            收集字段结构体依赖(驻留文本(类型f), 依赖们);
            整64 依赖序 = 0;
            当 (依赖序 < 依赖们.大小()) {
                整64 依赖名 = 依赖们.元素(整32(依赖序));
                可选<整64> 依赖键查 = 结构体布局键基(依赖名);
                如果 (依赖键查.有值) {
                    整64 依赖键 = 依赖键查.值;
                    // 色标闭集 {0=白, 1=灰, 2=黑} 显式枚举分派（1079 else 新规：
                    //   无 else 兜底——非法值不可达，色标只经 设置 写闭集值）
                    整64 色d = 0;
                    结果<整64, 整32> 查色d = 重算色标们.获取(依赖键);
                    如果 (查色d.正常) { 色d = 查色d.值; }
                    如果 (色d == 1) {
                        // 灰=环：依赖者正在重算栈中（无穷大小类型）
                        报环诊断(键基, 名f, 依赖键);
                    } 否则 如果 (色d == 0) {
                        // 白=未访：依赖者未重算——查区间递归（无区间=非本库
                        //   容器·收集器豁免清单保证结构体形依赖必登记）
                        整64 依赖类别 = 0;
                        整64 依赖起点 = 0;
                        整64 依赖字段数 = 0;
                        结果<空类型, 整32> 依赖区间查 = 查结构体字段区间(依赖键, &依赖起点, &依赖字段数, &依赖类别);
                        如果 (依赖区间查.正常) { 重算深度优先(依赖键); }
                    }
                    // 黑（2）=已重算真值就绪·跳过
                }
                依赖序++;
            }
            字段序++;
        }
    }
    // 依赖闭包就绪 → 重算本容器布局（环已现形时放弃重算——错误程序中止·
    //   不产占位/半真值混合态）
    如果 (本轮环诊断数 == 0 && 区间命中) {
        重算容器布局(键基, 区间起点, 字段数, 类别);
    }
    结果<空类型, 整32> 设黑 = 重算色标们.设置(键基, 2);
    如果 (!设黑.正常) { 运行时错误(4); }
}

// 环诊断（宿主 computeLayout 字段循环环报错同语义·文案对齐「无穷大小类型」
//   编译期拒绝锚）——每环只报一次（环上其余成员静默·防连锁重复诊断·
//   宿主「错误已报，防连锁误报」同款）
不安全 函数 报环诊断(整64 引用者键基, 整64 字段名ID, 整64 被引键基) -> 空类型 {
    结果<整64, 整32> 查报 = 已报环键们.获取(被引键基);
    如果 (查报.正常) { 返回; }
    结果<空类型, 整32> 设报 = 已报环键们.设置(被引键基, 1);
    如果 (!设报.正常) { 运行时错误(4); }
    IO::打印到错误("[布局] 结构体 '" + 字符串复制(驻留文本(引用者键基)) +
                   "' 的字段 '" + 字符串复制(驻留文本(字段名ID)) +
                   "' 递归引用了正在收尾重算布局的结构体 '" +
                   字符串复制(驻留文本(被引键基)) +
                   "'（值字段递归=无穷大小类型）——请将该字段改为指针，或改用类（引用语义）\n");
    本轮环诊断数++;
}

// 容器布局重算（结构体/联合体——类别 0/1；区间重放字段·口径单点 字段布局
//   口径）：大小/对齐覆盖 结构体大小表/对齐表；字段偏移覆盖 字段偏移表们
//   （生成期 728h 权威偏移覆盖机制读此表——语法层节点附加错值由其纠偏）；
//   资源字段偏移原地修正（四元组平铺向量·字段集合不变仅偏移变）。
//   构造字段/字段类型/全字段表/候选表与字段集合相关·重算零涉及（不重复登记）。
不安全 函数 重算容器布局(整64 键基, 整64 区间起点, 整64 字段数, 整64 类别) -> 空类型 {
    整64 总偏移 = 0;
    整64 最大对齐 = 1;
    整64 最大字段 = 0;
    整64 字段序 = 0;
    当 (字段序 < 字段数) {
        整64 键f = 0;
        整64 名f = 0;
        整64 类型f = 0;
        读全字段条目(区间起点 + 字段序, &键f, &名f, &类型f);
        整64 字段大小 = 8;
        整64 字段对齐 = 8;
        // 原始类型文本含尾星（217 登记原始星号形态）——剥星取基名+星层
        字符串 原始文本 = 字符串复制(驻留文本(类型f));
        整64 星层 = 0;
        整64 末位 = 字符串长度(原始文本);
        当 (末位 > 0 && (整64(原始文本[整32(末位 - 1)]) & 255) == 42) {
            末位--;
            星层++;
        }
        字符串 基名文本 = 原始文本;
        如果 (星层 >= 1 && 星层 <= 255) {   // 指针层域 1..255（857 口径·闭区间枚举）
            基名文本 = 字符串子串(原始文本, 0, 整32(末位));
        }
        字段布局口径(基名文本, 星层, &字段大小, &字段对齐);
        // 偏移（联合体=全字段 0·结构体=对齐推进——与解析期算法同构）
        整64 偏移f = 0;
        如果 (类别 != 1) {
            整64 余 = 总偏移 % 字段对齐;
            如果 (余 != 0) { 总偏移 = 总偏移 + (字段对齐 - 余); }
            偏移f = 总偏移;
        }
        整64 分桶键 = 键基 * 键位移 + 名f;
        登记字段偏移(分桶键, 偏移f);
        修正资源字段偏移(键基, 名f, 偏移f);
        如果 (字段对齐 > 最大对齐) { 最大对齐 = 字段对齐; }
        如果 (字段大小 > 最大字段) { 最大字段 = 字段大小; }
        如果 (类别 != 1) { 总偏移 = 偏移f + 字段大小; }
        字段序++;
    }
    // 收口（结构体=尾对齐总偏移·联合体=最大字段向最大对齐圆整——C 布局语义；
    //   类别闭集 {0=结构体, 1=联合体} 显式枚举·无 else 兜底）
    整64 总大小 = 0;
    如果 (类别 == 1) {
        整64 尾余u = 最大字段 % 最大对齐;
        如果 (尾余u != 0) { 最大字段 = 最大字段 + (最大对齐 - 尾余u); }
        总大小 = 最大字段;
    } 否则 如果 (类别 == 0) {
        整64 尾余 = 总偏移 % 最大对齐;
        如果 (尾余 != 0) { 总偏移 = 总偏移 + (最大对齐 - 尾余); }
        总大小 = 总偏移;
    }
    覆盖结构体布局(键基, 总大小, 最大对齐);
}
