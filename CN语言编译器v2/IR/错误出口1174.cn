// 错误出口1174.cn —— 错误传播统一出口设施（#1174·自 生成函数.cn 外迁·660
// 行数红线拆分·机械搬移零行为变更）。职责：问号传播失败路径的函数级统一错误出口——
// err 块错误码写帧上专有槽+跳出口块；出口块由函数/类方法收尾发射 LIFO 出口释放
// （释放目标=**增量镜像名单**·名单追加点同步·曾见全量·不受块级基线回滚影响）；
// 蹦床（lambda）嵌套经 保存/恢复 对隔离。

导入 容器::向量;
导入 映射集合;
导入 协议常量;   // 键位移/T_*/IR_*
导入 IR生成;     // 发射容器元素释放
导入 IO;

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 1174（2026-10-26·1019采样轮 P1）：错误传播统一出口登记——生成错误传播 err 块
//   不再直 IR_返回（原形态跳过 发射容器析构/发射字符串释放/发射数组串释放全部
//   =函数内已构造的容器/串/数组局部泄漏·e05/e07 探针 v2 缺错误路径的 D2），
//   改为：错误码写**函数级专有局部槽**+跳**错误出口块**；出口块由函数收尾段
//   （生成函数/生成类/生成蹦床·函数信息 在域）在尾块标签前发射：LIFO 出口释放
//   三调（与 发射返回公共尾段 同款·跳过名=0）+读槽构造 retbuf+IR_返回——宿主
//   C++ 统一出口同构。登记五元组（出口块ID/标志槽/码槽/写偏移/写码）静态承载
//   （尾块ID 同款全局模式·生成串行）；**蹦床嵌套**（lambda 体在表达式生成内
//   完整生成·可能覆盖登记）经 保存/恢复 对兜住。登记语义：hasErrorExit=0 无
//   问号传播（函数无错误出口块·收尾零发射）；hasCodeSeg=可选返回（无错误值段·出口
//   只写标志）。写偏移/写码=首个传播点的返回错误段参数（同函数同返回类型·
//   幂等覆盖安全）。
静态 整64 错误出口块ID全局 = 0;
静态 整64 错误出口标志槽全局 = 0;
静态 整64 错误出口码槽全局 = 0;
静态 整64 错误出口写偏移全局 = 0;
静态 整64 错误出口写码全局 = 0;
静态 整64 错误出口有码段全局 = 0;
静态 向量<整64> 错误出口保存栈1174;   // 蹦床嵌套保存恢复（六元组顺次压栈）
// 1174-D5：收尾点名单已被**块级基线回滚**清空（返回路径释放后弹出·D5 实证
//   出口块发射时 容器名单大小=0）——出口块的 LIFO 释放目标改用**传播点时刻
//   的名单快照**（首个传播点登记·名单完整时刻=返回回滚前）。六件套镜像
//   发射容器析构/发射字符串释放/发射数组串释放全部 的 函数信息 依赖字段。
静态 向量<整64> 快照容器名单1174;
静态 向量<整64> 快照串名单1174;
静态 向量<整64> 快照数组串名单1174;
静态 映射<整64, 整64> 快照变量类型1174;
静态 映射<整64, 整64> 快照串污染1174;
静态 向量<整64> 快照资源字段局部1174;
静态 映射<整64, 整64> 快照局部槽1174;   // 1174-D8：局部槽快照（块级绑定恢复删项防）
// 1174-D7：**增量镜像**（名单追加点同步·曾见全量·不受块级回滚影响）——
//   运行时快照被后续空名单调用覆盖（D6/D7 实录）·镜像=正解
静态 向量<整64> 镜像容器名单1174;
静态 向量<整64> 镜像串名单1174;
静态 向量<整64> 镜像数组串名单1174;
静态 映射<整64, 整64> 镜像容器槽1174;    // 名ID -> 帧槽号（出口块加载壳指针）
静态 映射<整64, 整64> 镜像容器类型1174;  // 名ID -> 类类型 ID（删除对象/元素释放判定）
静态 映射<整64, 整64> 镜像串槽1174;      // 名ID -> 帧槽号（串句柄槽·出口块 free+清槽）
静态 映射<整64, 整64> 镜像数组串槽1174;  // 名ID -> 帧槽号（字符串数组基址槽）

不安全 函数 镜像容器追加1174(整64 名ID) -> 空类型 {
    结果<整64, 整32> 查重 = 静态序号们.获取(名ID);
    如果 (!查重.正常) {
        // 非静态名（局部/参数）——查重借用 静态序号们 不当；改线性去重
    }
    整64 i = 0;
    当 (i < 镜像容器名单1174.大小()) {
        如果 (镜像容器名单1174.元素(i) == 名ID) { 返回; }
        i++;
    }
    结果<空类型, 整32> 加 = 镜像容器名单1174.追加(名ID);
    如果 (!加.正常) { 运行时错误(4); }
}

不安全 函数 镜像串追加1174(整64 名ID) -> 空类型 {
    整64 i = 0;
    当 (i < 镜像串名单1174.大小()) {
        如果 (镜像串名单1174.元素(i) == 名ID) { 返回; }
        i++;
    }
    结果<空类型, 整32> 加 = 镜像串名单1174.追加(名ID);
    如果 (!加.正常) { 运行时错误(4); }
}

不安全 函数 镜像数组串追加1174(整64 名ID) -> 空类型 {
    整64 i = 0;
    当 (i < 镜像数组串名单1174.大小()) {
        如果 (镜像数组串名单1174.元素(i) == 名ID) { 返回; }
        i++;
    }
    结果<空类型, 整32> 加 = 镜像数组串名单1174.追加(名ID);
    如果 (!加.正常) { 运行时错误(4); }
}

// 函数切换清镜像（生成函数/生成类方法 生成入口调用——名单按函数隔离）
不安全 函数 清错误出口镜像1174() -> 空类型 {
    镜像容器名单1174.清空();
    镜像串名单1174.清空();
    镜像数组串名单1174.清空();
    镜像容器槽1174.清空();
    镜像容器类型1174.清空();
    镜像串槽1174.清空();
    镜像数组串槽1174.清空();
}

// 1174：串/数组串镜像槽同步（声明分配点调用——收尾点局部槽已被块级绑定恢复
//   删项·D8 实证——镜像=出口块唯一可信槽源）
不安全 函数 镜像串槽同步1174(整64 名ID, 整64 槽号) -> 空类型 {
    结果<空类型, 整32> 设s = 镜像串槽1174.设置(名ID, 槽号);
    如果 (!设s.正常) { 运行时错误(4); }
}

不安全 函数 镜像数组串槽同步1174(整64 名ID, 整64 槽号) -> 空类型 {
    结果<空类型, 整32> 设a = 镜像数组串槽1174.设置(名ID, 槽号);
    如果 (!设a.正常) { 运行时错误(4); }
}

// 1174：出口块串释放（自足——遍镜像串名单·查镜像槽·__cn_str_free+清槽；
//   空安全：未初始化路径槽=0 free 空安全跳过；与 发射字符串释放 同语义）
不安全 函数 发射错误出口串释放1174(向量<IR指令>& 指令, 整64* 寄存器计数) -> 空类型 {
    整64 i = 镜像串名单1174.大小();
    当 (i > 0) {
        i--;
        整64 名ID = 镜像串名单1174.元素(i);
        结果<整64, 整32> 槽查 = 镜像串槽1174.获取(名ID);
        如果 (槽查.正常) {
            整64 槽 = 槽查.值;
            整64 句柄 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 槽, 0, 0, 句柄, T_字符串, 0));
            IR追加(指令, 建IR指令(IR_调用实参, 句柄, 0, 0, 0, 0, 0));
            IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0, 驻留("__cn_str_free")));
            // 清槽幂等（零寄存器语义：现发常量 0 写回）
            整64 零reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零reg, T_整64, 0));
            IR追加(指令, 建IR指令(IR_存储, 零reg, 0, 0, 0, 0, 槽));
        }
    }
}

// 1174：出口块字符串数组释放（自足——遍镜像名单·查镜像槽/类型表·逐元素串
//   释放循环；与 发射数组串元素释放 字符串元素分支同语义——类型文本从镜像取）
// 镜像数组串类型表（名ID -> 类型 ID·数组类型文本）
静态 映射<整64, 整64> 镜像数组串类型1174;

// 同步点：数组串声明分配点（镜像槽同步同点调用）
不安全 函数 镜像数组串类型同步1174(整64 名ID, 整64 类型ID) -> 空类型 {
    结果<空类型, 整32> 设t = 镜像数组串类型1174.设置(名ID, 类型ID);
    如果 (!设t.正常) { 运行时错误(4); }
}

不安全 函数 发射错误出口数组串释放1174(向量<IR指令>& 指令, 整64* 寄存器计数) -> 空类型 {
    整64 i = 镜像数组串名单1174.大小();
    当 (i > 0) {
        i--;
        整64 名ID = 镜像数组串名单1174.元素(i);
        // 结果纪律：结果/可选.值 访问须在对应 如果 真分支内（!正常+继续 不认）
        整64 槽 = 0;
        整64 类型IDa1174 = 0;
        结果<整64, 整32> 槽查 = 镜像数组串槽1174.获取(名ID);
        如果 (槽查.正常) { 槽 = 槽查.值; }
        结果<整64, 整32> 类型查a = 镜像数组串类型1174.获取(名ID);
        如果 (类型查a.正常) { 类型IDa1174 = 类型查a.值; }
        如果 (槽 == 0 || 类型IDa1174 == 0) { 继续; }
        字符串 类型文本a = 字符串复制(驻留文本(类型IDa1174));
        如果 (!是数组类型文本(类型文本a)) { 继续; }
        可选<字符串> 元素文本a查 = 数组元素文本(类型文本a);
        布尔 元素串a1174 = 假;
        如果 (元素文本a查.有值) {
            如果 (字符串比较(元素文本a查.值, "字符串")) { 元素串a1174 = 真; }
        }
        如果 (!元素串a1174) { 继续; }
        整64 长度a = 数组长度文本(类型文本a);
        整64 步进a = 0;
        结果<整64, 整32> 步进查a = 数组元素步进(类型文本a);
        如果 (步进查a.正常) { 步进a = 步进查a.值; }
        // 单边比较清偿：长度/步进=解析产物非负不变量（数组长度文本/数组元素步进
        //   保证）——零值即无效区间，两条件正向枚举
        如果 (长度a == 0) { 继续; }
        如果 (步进a == 0) { 继续; }
        整64 基址寄存器a = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_取地址, 槽, 0, 0, 基址寄存器a, T_整64, 0));
        整64 元素序a = 0;
        当 (元素序a < 长度a) {
            整64 元素地址a = 基址寄存器a;
            如果 (元素序a != 0) {   // 首元素零偏移（序非负递增·!=0 等价）
                整64 偏移常量a = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_常量整数,
                      整64(驻留(整数转字符串(元素序a * 步进a))), 0, 0,
                      偏移常量a, T_整64, 0));
                整64 元素地址新a = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_加, 基址寄存器a, 偏移常量a, 0,
                      元素地址新a, T_整64, 0));
                元素地址a = 元素地址新a;
            }
            整64 句柄寄存器a = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 元素地址a, 0, 0,
                  句柄寄存器a, T_字符串, 0));
            IR追加(指令, 建IR指令(IR_调用实参, 句柄寄存器a, 0, 0, 0, 0, 0));
            IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                 驻留("__cn_str_free")));
            // 元素槽清零（幂等·74-a 同款）
            整64 元素零地址a = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_字段地址, 元素地址a, 0, 0, 元素零地址a,
                                 T_整64, 0));
            整64 元素零reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 元素零reg,
                                 T_整64, 0));
            IR追加(指令, 建IR指令(IR_指针存储, 元素零地址a, 元素零reg, 0, 0,
                                 T_整64, 0));
            元素序a++;
        }
        // 数组本体 free（基址若堆分配——97-a 同款 数据数组随元素清零即可·
        //   数组槽清零=幂等出口多路径安全）
        整64 零reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零reg, T_整64, 0));
        IR追加(指令, 建IR指令(IR_存储, 零reg, 0, 0, 0, 0, 槽));
    }
}

// 1174：错误出口析构发射（完全自足——遍**镜像**名单/槽/类型·零快照零视图依赖）：
//   名单逆序 LIFO（同 发射容器析构 197 遍历序）→加载壳指针（镜像槽）→判空→
//   容器元素释放（镜像类型=容器类时）→IR_删除对象（镜像类型·~类 级联）。调用点=
//   生成函数/生成类 收尾错误出口块（镜像 已含全函数局部·块回滚不影响）。
不安全 函数 发射错误出口析构1174(函数IR& 函数信息, 向量<IR指令>& 指令, 整64* 寄存器计数) -> 空类型 {
    整64 i = 镜像容器名单1174.大小();
    当 (i > 0) {
        i--;
        整64 名ID = 镜像容器名单1174.元素(i);
        结果<整64, 整32> 槽查 = 镜像容器槽1174.获取(名ID);
        // 结果纪律：结果.值 访问须在 结果.正常 的 如果 真分支内（!正常+继续
        //   形态不认·sem5 三错实录）——正向嵌套形态
        如果 (槽查.正常) {
            整64 槽 = 槽查.值;
            结果<整64, 整32> 类型查 = 镜像容器类型1174.获取(名ID);
            如果 (类型查.正常) {
                整64 类型ID = 类型查.值;
                整64 ptr寄存器 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_加载, 槽, 0, 0, ptr寄存器, T_对象, 0));
                发射容器元素释放(函数信息, 寄存器计数, ptr寄存器, 类型ID);
                IR追加(指令, 建IR指令(IR_删除对象, ptr寄存器, 0, 0, 寄存器计数[0], 0, 类型ID));
                寄存器计数[0] = 寄存器计数[0] + 1;
            }
        }
    }
}

不安全 函数 快照错误出口名单1174(函数IR& 函数信息) -> 空类型 {
    // 1174-D6：**空名单不覆盖**（返回路径快照(=1) 会被后续块出口/其它路径的
    //   空名单调用覆盖回零·读出=0 实录）——保留「曾见的最全名单」（出口释放
    //   目标=函数内全部局部·幂等安全：多 propagaton 点共享同一出口块）
    // 1174-D7：名单源改**增量镜像**（曾见全量·不受回滚影响）——运行时
    //   函数信息.容器变量们 已被块级回滚清空（D5/D6/D7 三轮实证）
    如果 (镜像容器名单1174.大小() == 0 && 镜像串名单1174.大小() == 0 &&
         镜像数组串名单1174.大小() == 0) { 返回; }
    快照容器名单1174 = 镜像容器名单1174;
    快照串名单1174 = 镜像串名单1174;
    快照数组串名单1174 = 镜像数组串名单1174;
    // 变量类型/污染/资源字段 仍取当前 函数信息（键=名 ID·回滚不删映射项）
    快照变量类型1174 = 函数信息.变量类型;
    快照串污染1174 = 函数信息.字符串污染们;
    快照资源字段局部1174 = 函数信息.资源字段局部们;
}

不安全 函数 设错误出口登记1174(整64 出口块, 整64 标志槽, 整64 码槽,
                     整64 写偏移, 整64 写码, 整64 有码段) -> 空类型 {
    错误出口块ID全局 = 出口块;
    错误出口标志槽全局 = 标志槽;
    错误出口码槽全局 = 码槽;
    错误出口写偏移全局 = 写偏移;
    错误出口写码全局 = 写码;
    错误出口有码段全局 = 有码段;
}

函数 错误出口已登记1174() -> 整64 {
    如果 (错误出口块ID全局 != 0) { 返回 1; }
    返回 0;
}

函数 取错误出口块ID1174() -> 整64 { 返回 错误出口块ID全局; }
函数 取错误出口标志槽1174() -> 整64 { 返回 错误出口标志槽全局; }
函数 取错误出口码槽1174() -> 整64 { 返回 错误出口码槽全局; }
