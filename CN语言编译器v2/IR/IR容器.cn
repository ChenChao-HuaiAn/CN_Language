// CN 自举编译器 v2：容器类型 IR 辅助（自举重建 P7b，2026-09-01）

// 容器类型（向量/映射/链表/栈/队列/集合/结果）类型判定、对象大小表、

// 方法签名表——IR生成.cn 的容器实例化/方法调用据此合成宿主对齐符号

// （类$方法#参数串 → nameMangle，实现链接宿主编译 obj，rustc 预编译 std 模式）。

// 契约对标：宿主 generics.cpp（实例名 类名$实参 扁平 $ 连接）、semantic.cpp

//   signatureKey（方法名#参数类型1,参数类型2）、stdlib 容器.cn/映射集合.cn

//   （方法签名与字段布局）。

// 依赖说明：IR_* 操作码/T_* 类型码/常量表 由 IR常量.cn 定义（簇① A2 单一归属）；

//   IR 指令/函数 IR 数据结构（IR指令/函数IR 结构体）自 呈报①A 根治（2026-09-05）

//   起定义在本模块（见下）——原定义在 IR生成.cn 顶层，而本模块引用它 + IR生成

//   导入本模块 = 反向引用不可导；主链靠多文件合并全局可见掩盖，冒烟子链

//   （IR容器/语法分析/语义分析 入口——链上无 IR生成.cn）结构体登记缺失 ->

//   解析方法对象类型 查结构体大小 miss = 「方法调用的对象类型未知」误诊

//   （冒烟 asm 断供；曾误归因 IR常量.cn 新增常量对，实为登记源结构性缺失）。

导入 容器::向量;

导入 映射集合;

导入 IR;         // 签名辅助 + 节点_*/T_*/IR_*/键位移/当前函数变量类型（原 IR签名+IR常量 合并目录包名）



公开:



// ==================== IR 数据结构（呈报①A 下沉，2026-09-05） ====================

// IR指令/函数IR 自 IR生成.cn 下沉至本模块：本模块（IR追加/建IR指令/发射容器

//   析构族）与其全部引用方（IR生成/代码生成/代码生成ARM64/代码生成共用/主）

//   的导入链均含本模块——登记源（语法分析 解析结构体声明 -> 登记结构体布局）

//   在任意冒烟子链上恒可达。程序IR 仍留 IR生成.cn（引用方链上恒含 IR生成）。

结构体 IR指令 {

    整64 操作码;

    整64 操作数1;

    整64 操作数2;

    整64 操作数3;

    整64 目标;

    整64 类型;

    整64 附加;

}



// ==================== 函数 IR ====================

// 每个函数：指令数组 + 局部槽表（名ID -> 槽索引）+ 参数槽表 + 返回类型码。

结构体 函数IR {

    向量<IR指令> 指令;

    映射<整64, 整64> 局部槽;

    映射<整64, 整64> 参数槽;

    整64 返回类型;

    整64 返回结构体ID;  // 用户函数返回结构体（2026-09-04，E2E 148）：非 0=返回

                        //   类型为该结构体——宿主 ABI 走隐藏 retbuf（位0 传入、

                        //   rax 返回）；被调方槽 1=retbuf 指针（调用方帧尾缓冲）

    整64 返回引用;      // 引用返回（2026-09-04 缺陷零容忍收口，宿主 P3-18 对齐）：

                        //   1=返回类型尾 '&'（-> 整64&）——返回语句发射被引用

                        //   左值地址（生成左值地址），调用方经指针加载读/指针

                        //   存储写（赋值目标/复合赋值）/直接绑定（引用初始化）

    整64 返回结果名ID;  // 71-a（2026-09-11 方案A 用户裁决）：返回类型为 结果/可选

                        //   合成名（结果$字符串$整32）的名ID——非 0=结果返回，与

                        //   返回结构体ID 同款 retbuf ABI（槽 1=retbuf 指针、位 0

                        //   装载、rax=retbuf；结果大小=结果大小(合成名)——结构体

                        //   表查不到 0，故独立字段不复用 ID）

    整64 返回窄宽码;    // 565 轮（T33 残余根治）：返回类型 整8/整16/正8/正16/整32/

                        //   正32 → 对应 IR 码（类型码() 对窄宽归 T_整64 不可用·

                        //   生成函数 初始化签名与返回字段 从返回类型文本登记）——

                        //   生成返回语句 标量返回按此规范化（0=非窄宽·直通）

    整32 名字;

    整64 块计数;        // P6b：块编号计数器（标签随建随取，嵌套安全）

    整64 当前块;        // P6b：当前块 ID（跳转目标；初始 0=函数入口块）

    整64 循环出口块;    // P6b：最近 当/循环 出口块（中断 跳转目标；0=无）

    整64 选择出口块;    // 376-a（D40）：最近 选择 出口块（中断 优先跳选择出口——
                        //   C break 同款：选择内 中断=跳出选择；0=不在选择内）

    整64 循环继续块;    // P6b：最近 当/循环 继续块（继续 跳转目标；0=无）

    整64 循环串基线;    // 73-a（2026-09-11 方案A 用户裁决）：进入最近循环体前的

                        //   字符串变量们 基线——中断/继续 跳出 drop-on-jump 的

                        //   释放范围起点（生成当 保存/恢复，嵌套循环自然正确）

    整64 循环容基线;    // 73-a：容器变量们 基线（同上）

    整64 循环字段基线;  // 73-a：资源字段局部们 基线（同上）

    整64 函数尾块;      // 缺陷A根治（2026-09-02）：函数尾块——IR_返回 后跳转至此，

                        //   标签在函数体末发射（epilogue 唯一，中途回退不再穿透）

    映射<整64, 整64> 变量类型;    // P7b：变量名ID -> 类型名ID（容器/结果成员访问与方法解析）

    向量<整64> 字符串变量们;     // plans/019 阶段4' 第二批：拥有型字符串局部名单（白名单判定后）

    映射<整64, 整64> 字符串污染们;  // plans/019 阶段4' 第二批：污染名ID -> 1（非拥有赋值/

                                //   下标借出——释放挂点一律跳过，宿主 stringTainted_ 同构）

    向量<整64> 容器变量们;        // P7b：容器变量名ID 列表（RAII 返回前析构遍历）

    向量<整64> 字符串数组变量们;  // 98-a（C9）：**字符串元素数组**局部名ID 列表——

                                //   块出口/跳出/函数尾逐元素 __cn_str_free（编译期

                                //   展开 N 次；元素槽释放+清零=幂等模型）。与

                                //   字符串变量们 同基线/截断纪律（块出口按基线截断）

    整64 循环数组串基线;          // 98-a：中断/继续 跳出 drop-on-jump 的数组串

                                //   释放范围起点（生成当 保存/恢复，同 循环串基线）

    向量<整64> 资源字段局部们;    // ②c B：含容器字段的结构体局部名ID（块出口级联析构）

    向量<整64> 资源字段结构体们;  // ②c B：对应结构体名ID（与 资源字段局部们 同下标）

    整64 retbuf字节数;    // ②b B6：本函数 retbuf 调用最大返回字节数（帧尺寸依据；

                        //   生成函数 出口自 当前retbuf字节数 回填）

    向量<整64> 参数槽序们;        // ②b B8：参数按声明序的基槽（多槽结构体参数=最大槽号）

    向量<整64> 参数拷贝字节们;    // ②b B8：参数按声明序的 prologue 拷贝字节数

                                //   （0=标量直存；>0=结构体按值：指针入参 -> 多槽拷贝）

    向量<整64> 参数类型们;        // 91-a（2026-09-13 第九十一轮）：参数按声明序的类型码

                                //   （T_* 标量码；引用/指针/结构体按值=地址传递标

                                //   T_整64）——序言参数装载按码分派寄存器类：

                                //   T_浮32/T_浮64 -> xmm/d 寄存器（SysV/AAPCS64 浮点

                                //   参数独立计数），其余 -> 整型寄存器。与宿主

                                //   emitParamSetup isFloatType 分派同构

    整64 零寄存器;        // 73-a（2026-09-11 方案A 用户裁决）：函数入口常量 0 的

                        //   寄存器号（预扫 无资源声明时为 0=未分配）——释放点

                        //   清零槽用（释放+清零幂等模型：跳出释放/块出口释放后

                        //   槽清零，函数级兜底再次经过时读 0=空安全跳过，杜绝

                        //   双释；宿主 72-a 同款）。该指令位于函数入口必经路径，

                        //   任何释放点的运行期路径都已执行过它。

}



// ==================== 方法返回形态 ====================

常量 容器返回_标量 = 0;     // 标量返回 rax（大小/元素/为空/包含/删除(K) 布尔）

常量 容器返回_结果空 = 1;   // 结果<空类型,整32>：隐藏返回指针，12 字节（追加/删除(i)/设置/插入/预留）

常量 容器返回_结果值 = 2;   // 结果<T,整32>：隐藏返回指针（读取/获取/弹出/栈顶/出队/队首）

常量 容器返回_空类型 = 3;   // 无返回值（清空）

常量 容器返回_结构体 = 4;   // ②b B2（2026-09-02）：T 为结构体的按值返回（元素(位置)->T）——

                           //   隐藏返回指针，调用后 rax/x0=缓冲地址即结构体地址（宿主

                           //   epilogue mov x0,x19 / win rax 同款），链式 .字段 以此为基址



// ==================== 实例实参再切分（②c A，2026-09-02） ====================

// $ 扁平合成名的实参串按基名元数贪婪再切分：向量$映射$整64$整64 -> ["映射$整64$整64"]、

//   映射$整64$整64 -> ["整64","整64"]。朴素 '$' 切分对嵌套实参必错（单参 T 被切成

//   首段 "映射"），方法符号（#参数串）与返回类型推导双双失真（对标宿主 AST 级

//   实例化——扁平串须按元数还原）。

函数 基名元数(字符串 基名) -> 整64 {

    如果 (字符串比较(基名, "映射") || 字符串比较(基名, "结果")) { 返回 2; }

    返回 1;

}



// 实例化基名（容器 + 结果/可选——参与实参段的递归消费）

函数 是实例化基名(字符串 名) -> 布尔 {

    返回 是容器基名(名) || 字符串比较(名, "结果") || 字符串比较(名, "可选");

}



// 解析 [位置..] 为一个实参段：标识符词（含数字——类型名 整64/浮32/整128 等）；

//   实例化基名递归消费其元数个实参段；尾缀 '*'/'&' 字节原样并入。位置 出参推进

//  （调用方保证 '$' 分隔已消费）。

不安全 函数 解析实参段(字符串 实参串, 整64* 位置) -> 字符串 {

    整64 i = 位置[0];

    整64 n = 字符串长度(实参串);

    字符串 词 = "";

    当 (i < n) {

        整64 字节 = 整64(实参串[i]) & 255;

        布尔 词字节 = 字节 >= 128 || (字节 >= 48 && 字节 <= 57) ||

                      (字节 >= 65 && 字节 <= 90) ||

                      (字节 >= 97 && 字节 <= 122) || 字节 == 95;

        如果 (词字节) {

            词 = 词 + 字符串子串(实参串, i, 1);

            i++;

        } 否则 {

            中断;

        }

    }

    如果 (字符串长度(词) == 0) { 返回 ""; }

    如果 (是实例化基名(词)) {

        整64 元 = 基名元数(词);

        整64 k = 0;

        当 (k < 元) {

            // 期望 '$' 分隔（防御：不足则停止）

            如果 (i < n) {

                整64 分隔 = 整64(实参串[i]) & 255;

                如果 (分隔 == 36) { i++; }

            }

            位置[0] = i;

            字符串 子段 = 解析实参段(实参串, 位置);

            如果 (字符串长度(子段) == 0) { 中断; }

            词 = 词 + "$" + 子段;

            i = 位置[0];

            k++;

        }

    }

    // 尾缀 '*'(42) / '&'(38) 原样并入（指针/引用形实参）

    当 (i < n) {

        整64 后缀 = 整64(实参串[i]) & 255;

        如果 (后缀 == 42 || 后缀 == 38) {

            词 = 词 + 字符串子串(实参串, i, 1);

            i++;

        } 否则 {

            中断;

        }

    }

    位置[0] = i;

    返回 词;

}



// 取实例实参们：跳过基名首段，按元数贪婪切分全部实参（返回向量）

函数 取实例实参们(字符串 合成名) -> 向量<字符串> {

    向量<字符串> 实参们 = 向量<字符串>();

    整64 首 = 首分段位置(合成名);

    如果 (首 < 0) { 返回 实参们; }

    整64 i = 首 + 1;

    整64 n = 字符串长度(合成名);

    当 (i < n) {

        整64 位置 = i;

        字符串 段 = 解析实参段(合成名, &位置);

        如果 (字符串长度(段) == 0) { 中断; }

        // A2：段 是循环内登记变量（返回块 RAII 释放末迭代值）——入容器显式

        //   复制，防向量元素悬垂（浅共享×源释放）。

        结果<空类型, 整32> 加段 = 实参们.追加(字符串复制(段));

        如果 (!加段.正常) { 运行时错误(4); }

        i = 位置;

        // 期望 '$' 分隔或结束

        如果 (i < n) {

            整64 分隔 = 整64(合成名[i]) & 255;

            如果 (分隔 == 36) { i++; }

        }

    }

    返回 实参们;

}



// ==================== 顶层静态声明表（②c C，2026-09-02） ====================

// 任务级生命周期：名ID -> 序号（IR 标识符解析）；名/类型平铺（入口构造注入）；

//   IR生成 入口收集（先清空，幂等）。存储=双后端 .data _cn_gstatic_<序号> 槽

//   （统一指针槽：容器=堆对象指针；标量=初始值——.data 直存折叠字面量）。

静态 映射<整64, 整64> 静态序号们;



// IR 层错误计数与统一诊断（2026-09-04，IR生成.cn 冒烟 [ir2] 纪律收口）：

//   [ir2] 级诊断=IR 不完整（形态不支持/目标未解析）——产物不可信。对齐

//   「语义错误即中止」（E2E 139 纪律）：主.cn 于 IR 生成后检查计数>0 即

//   中止（不产 asm）。单一归属本组件（IR生成/IR容器 诊断点全部经此计数）。

静态 整64 IR层错误计数 = 0;



不安全 函数 IR层诊断(字符串 消息) -> 空类型 {

    IR层错误计数 = IR层错误计数 + 1;

    IO::打印到错误("[ir2] " + 消息 + "\n");

}



函数 取IR层错误数() -> 整64 {

    返回 IR层错误计数;

}



不安全 函数 清空IR层错误计数() -> 空类型 {

    IR层错误计数 = 0;

}

静态 向量<整64> 静态名们;

静态 向量<整64> 静态类型们;

// 87-a（2026-09-12 第八十七轮）：静态初值区间表（每静态 2 项：起点、终点；

//   无初值 = -1/-1）。结构体静态的初值不可 .data 直存（须入口注入逐字段构造/

//   整体拷贝），注入点在 生成函数 的主入口——须按序号回查 AST 初值区间。

静态 向量<整64> 静态初值起点们;

静态 向量<整64> 静态初值终点们;

// 87-a（2026-09-12 第八十七轮）：静态需注入表（1=初值不可 .data 直存，须入口

//   物化）。覆盖：结构体（逐字段构造/整体拷贝）、字符串（驻留/堆串）、以及

//   折叠失败的标量（布尔/浮点/字符字面量——折叠常量值 只认整数文本，原实现

//   静默落 .data 0 = 初值丢失，探针实证 布尔=假/浮=0）。容器类经 NewObject

//   注入（原路径），不入本表。

静态 向量<整64> 静态需注入们;



不安全 函数 清空静态表() -> 空类型 {

    静态序号们.清空();

    静态名们 = 向量<整64>();

    静态类型们 = 向量<整64>();

    静态初值起点们 = 向量<整64>();

    静态初值终点们 = 向量<整64>();

    静态需注入们 = 向量<整64>();

}



// 收集一个 程序 节点区间的全部静态声明（容器/标量通用——初始值折叠由 IR生成 完成）

函数 收集静态(向量<节点> 池, 整32 程序节点, 向量<整64>& 初始值们) -> 空类型 {

    节点 程序 = 池.元素(程序节点);

    整64 i = 整64(程序.子起点);

    当 (i < 整64(程序.子终点)) {

        节点 声明 = 池.元素(整32(i));

        如果 (声明.类型 == 节点_静态声明) {

            整64 序号 = 静态名们.大小();

            结果<空类型, 整32> 加名 = 静态名们.追加(整64(声明.文本));

            如果 (!加名.正常) { 运行时错误(4); }

            节点 类型节点 = 池.元素(整32(声明.附加));

            结果<空类型, 整32> 加类 = 静态类型们.追加(整64(类型节点.文本));

            如果 (!加类.正常) { 运行时错误(4); }

            结果<空类型, 整32> 设序 = 静态序号们.设置(整64(声明.文本), 序号);

            如果 (!设序.正常) { 运行时错误(4); }

            // 87-a：初值区间登记（有初值=声明子区间；无=-1/-1）

            整64 初起 = 0 - 1;

            整64 初终 = 0 - 1;

            如果 (声明.子起点 < 声明.子终点) {

                初起 = 整64(声明.子起点);

                初终 = 整64(声明.子终点);

            }

            结果<空类型, 整32> 加起 = 静态初值起点们.追加(初起);

            如果 (!加起.正常) { 运行时错误(4); }

            结果<空类型, 整32> 加终 = 静态初值终点们.追加(初终);

            如果 (!加终.正常) { 运行时错误(4); }

            字符串 类型文本 = 字符串复制(驻留文本(整64(类型节点.文本)));

            整64 需注入v = 0;

            如果 (是容器类(类型文本)) {

                // 容器静态：入口 NewObject+构造（初始值表达式同构，忽略）——

                //   .data 槽初值 0（文本 ID 形态——代码生成经 驻留文本 还原）

                结果<空类型, 整32> 加零 = 初始值们.追加(驻留("0"));

                如果 (!加零.正常) { 运行时错误(4); }

            } 否则 {

                // 标量静态：初始值折叠（空初始化按 0）

                整64 值ID = 驻留("0");

                如果 (声明.子起点 < 声明.子终点) {

                    整64 折叠 = 折叠常量值(池, 声明.子起点, 声明.子终点);

                    如果 (折叠 != 0) { 值ID = 折叠; } 否则 { 需注入v = 1; }

                }

                结果<空类型, 整32> 加值 = 初始值们.追加(值ID);

               如果 (!加值.正常) { 运行时错误(4); }

            }

            // 87-a：结构体/字符串（不可 .data 直存）→ 需注入

            如果 (查结构体大小(整64(类型节点.文本)) > 0) { 需注入v = 1; }

            如果 (字符串比较(类型文本, "字符串")) { 需注入v = 1; }

            结果<空类型, 整32> 加注 = 静态需注入们.追加(需注入v);

            如果 (!加注.正常) { 运行时错误(4); }

        }

        i++;

    }

}



// ==================== 符号合成（宿主 methodSymbolKey 对齐） ====================

// 无参构造符号：类$基名（向量$整64 -> 向量$整64$向量；宿主构造方法名=类名）

函数 构造符号(字符串 合成名) -> 字符串 {

    返回 合成名 + "$" + 合成名基名(合成名);

}



// 析构符号：类$~基名（向量$整64 -> 向量$整64$~向量）

函数 析构符号(字符串 合成名) -> 字符串 {

    返回 合成名 + "$~" + 合成名基名(合成名);

}



// 方法符号：类$方法[#参数串]（参数串空则无 #——对标宿主 signatureKey）

函数 方法符号(字符串 合成名, 字符串 方法名, 字符串 参数串) -> 字符串 {

    如果 (字符串长度(参数串) == 0) { 返回 合成名 + "$" + 方法名; }

    返回 合成名 + "$" + 方法名 + "#" + 参数串;

}



// ==================== 函数签名表（呈报③方案A：重载消歧，2026-09-06） ====================

// 规格书 §函数重载（plans/001:358）：同名函数按参数类型与个数区分（重载决议），

//   名称修饰按签名编码（附录C）。宿主权威 = signatureKey（semantic.cpp:546，

//   名#参数串，参数串空则无 '#'）——v2 原函数登记键=纯声明名，同名映射覆盖

//   （后吞前静默）+ 函数IR.名字=纯名（跨文件同名重载 asm 重复定义，第一轮

//   冒烟实测源码改名 生成函数W 规避）。本表为决议与消歧的数据基座：

//   键1 = 键基ID -> 候选数；键2 = 键基ID*键位移+候选序 -> 参数串ID。

//   签名键 = 驻留(键基文本 或 键基文本#参数串)——与 函数实参结构们/函数返回类型们

//   的签名键登记、调用点决议产物三方一致（同字符串驻留 = 同 ID）。

// plans/018 P6b 第 4 层（2026-09-07）：登记维度由纯名升级为「键基」（plans/018

//   工作流3 第 3/4 层，宿主 functionLinkKey 公式对齐）——键基 = 主模块（入口，

//   含单文件）纯名本身；其余模块 驻留(模块路径 + "$" + 名)。跨模块同名同签名

//   函数因此合法共存（链接符号天然隔离：非主模块 asm 符号=模块$名#参数串，

//   单文件/主模块形态逐字节不变=v2self 产物对拍硬基准）。登记源（幂等）：

//   语义分析.声明收集（主链+语义冒烟子链）、IR生成/IR生成多文件 入口（IR 冒烟

//   子链，清空后重收集=权威）——两处登记均按键基，同模块同签名重复登记被幂等

//   跳过，跨模块同名互不干扰。

静态 映射<整64, 整64> 函数签名个数们;

静态 映射<整64, 整64> 函数签名参数串们;



// ==================== 调用决议表（plans/018 第 4 层：语义驱动 IR） ====================

// 语义分析 检查表达式 调用分支完成三级名称解析（①本模块 > ②显式导入 >

//   ③glob+歧义诊断，宿主 resolvedSignature=注册键同构）后，把调用点的

//   键基决议结果写入本表（键 = 调用节点池索引 -> 键基ID）；IR 层

//   决议函数符号 据此锁定候选模块桶再做重载决议——IR 不重复名称解析、

//   不反向依赖语义组件（表在 IR容器 中立层，两侧已导入）。主模块/单文件

//   条目值=纯名 ID（与决议函数符号 旧纯名路径等价，行为不变）。

// 生命周期：语义分析/语义分析多文件 入口清空（检查阶段写）；IR 生成阶段只读。

静态 映射<整64, 整64> 调用决议键基们;



函数 调用决议登记(整64 调用节点索引, 整64 键基ID) -> 空类型 {

    结果<空类型, 整32> 设 = 调用决议键基们.设置(调用节点索引, 键基ID);

    如果 (!设.正常) { 运行时错误(4); }

}



函数 调用决议查询(整64 调用节点索引) -> 整64 {

    结果<整64, 整32> 查 = 调用决议键基们.获取(调用节点索引);

    如果 (查.正常) { 返回 查.值; }

    返回 -1;

}



函数 清空调用决议() -> 空类型 {

    调用决议键基们.清空();

}



// 函数参数串提取：遍历函数节点参数区间 [子起点, 块.子起点)（块 在 子终点=

//   块索引，收集函数实参结构 同款），逐参数 类型文本+后缀（类型节点 附加

//   1..255=指针层 '*'×层、>=256=引用 '&'——参数声明位类型文本无后缀，

//   后缀语义在附加），逗号连接。无参返回 空串。

函数 函数参数串(向量<节点> 池, 整32 函数节点) -> 字符串 {

    节点 函数声明 = 池.元素(函数节点);

    整64 参数终点 = 整64(函数声明.子终点);

    如果 (参数终点 < 整64(池.大小())) {

        节点 块节点 = 池.元素(整32(参数终点));

        参数终点 = 整64(块节点.子起点);

    }

    字符串 串 = "";

    整64 i = 整64(函数声明.子起点);

    当 (i < 参数终点) {

        节点 参数 = 池.元素(整32(i));

        如果 (参数.类型 == 节点_参数) {

            字符串 类型文本 = "";

            // 守卫 >= 0（lessons 池索引 0 合法——生成函数 同款）

            如果 (参数.附加 >= 0 && 参数.附加 < 整64(池.大小())) {

                节点 类型节点 = 池.元素(整32(参数.附加));

                如果 (类型节点.类型 == 节点_类型) {

                    类型文本 = 字符串复制(驻留文本(整64(类型节点.文本)));

                    如果 (类型节点.附加 >= 256) {

                        类型文本 = 类型文本 + "&";

                    } 否则 如果 (类型节点.附加 >= 1) {

                        整64 层 = 类型节点.附加;

                        当 (层 > 0) {

                            类型文本 = 类型文本 + "*";

                            层--;

                        }

                    }

                }

            }

            如果 (字符串长度(串) > 0) { 串 = 串 + ","; }

            串 = 串 + 类型文本;

        }

        i++;

    }

    返回 串;

}



// 签名键合成：参数串空 -> 纯名（无 '#'，对齐宿主 signatureKey/方法符号惯例）

函数 函数签名键(整64 名ID, 字符串 参数串) -> 整64 {

    如果 (字符串长度(参数串) == 0) { 返回 名ID; }

    返回 驻留(驻留文本(名ID) + "#" + 参数串);

}



// 登记单个函数签名（幂等：键基下既有候选同参数串 -> 跳过——重定义由语义层

//   声明收集 诊断，本表不重复计候选）。键基语义见上表注（plans/018：主模块

//   =纯名；其余模块=模块$名——跨模块同名同签名合法共存的数据基座）。

函数 登记函数签名K(向量<节点> 池, 整32 函数节点, 整64 键基ID) -> 空类型 {

    节点 函数声明 = 池.元素(函数节点);

    字符串 参数串 = 函数参数串(池, 函数节点);

    整64 键串 = 驻留(参数串);

    整64 候选数 = 0;

    结果<整64, 整32> 查数 = 函数签名个数们.获取(键基ID);

    如果 (查数.正常) { 候选数 = 查数.值; }

    整64 k = 0;

    当 (k < 候选数) {

        结果<整64, 整32> 查串 = 函数签名参数串们.获取(键基ID * 键位移 + k);

        如果 (查串.正常) {

            如果 (查串.值 == 键串) { 返回; }

        }

        k++;

    }

    结果<空类型, 整32> 设串 = 函数签名参数串们.设置(

        键基ID * 键位移 + 候选数, 键串);

    如果 (!设串.正常) { 运行时错误(4); }

    结果<空类型, 整32> 设数 = 函数签名个数们.设置(键基ID, 候选数 + 1);

    如果 (!设数.正常) { 运行时错误(4); }

}



// 收集一个 程序 节点区间的全部函数签名（IR生成/IR生成多文件 入口用；

//   模块路径 = 该文件所属模块（主.cn 加载器传入）——键基按此合成。

//   语义层 声明收集 逐声明调 登记函数签名K——同一机制两个登记面）

函数 收集函数签名(向量<节点> 池, 整32 程序节点, 字符串 模块路径) -> 空类型 {

    节点 程序 = 池.元素(程序节点);

    整64 位置 = 整64(程序.子起点);

    当 (位置 < 整64(程序.子终点)) {

        节点 声明 = 池.元素(整32(位置));

        如果 (声明.类型 == 节点_函数) {

            整64 键基i = 键基合成(模块路径, 整64(声明.文本));

            登记函数签名K(池, 整32(位置), 键基i);

        }

        位置++;

    }

}



// 清空（任务级生命周期惯例——语义分析/语义分析多文件 与 IR生成/IR生成多文件

//   入口清空；主链两段各清空后重收集，内容一致幂等）

函数 清空函数签名() -> 空类型 {

    函数签名个数们.清空();

    函数签名参数串们.清空();

}





// ==================== 方法签名表 ====================

// 查表：类$合成名 + 方法名 + 实参数 → 参数类型串（T/K/V 已替换实例文本，

//   逗号连接——对标宿主 signatureKey）与返回形态。出参 值偏移=结果<T,E>.值

//   字节偏移（整32→4；整64/字符串/指针→8）。返回 假=方法未收录。

结构体 方法签名 {

    字符串 参数串;

    整64 返回形态;

    整64 值偏移;

    字符串 返回文本;    // ②b B5：替换后返回类型文本（链式成员 偏移/宽度 收口 + retbuf 尺寸用）

}



// 结果<T,E> 的 值 字节偏移：T=整32 -> 4（正常@0+联合@4）；其余（整64/字符串/指针）-> 8

函数 结果值偏移(字符串 值类型) -> 整64 {

    如果 (字符串比较(值类型, "整32")) { 返回 4; }

    如果 (字符串比较(值类型, "正32")) { 返回 4; }

    返回 8;

}



// 查方法签名（用户裁决项1：签名表查询 + 类型参数替换，替代硬编码 if 链——

//   stdlib 改签名/加方法 v2 自动跟随）。返回形态按替换后的返回类型通用判定：

//   结果$T$E -> 结果空（T=空类型）/结果值（+值偏移）；空类型 -> 无返回；

//   容器 $ 合成名 -> 容器返回_结构体（②c A：元素(i) 返回容器——宿主 typeSizeOf>8

//   隐藏返回指针拷贝对象字段，rax=缓冲地址即对象形基址，链式 .设置/.获取 this=此）；

//   其余 -> 标量（结构体返回亦走 结构体 形态）。未收录（表无此键）返回 假（调用方诊断）。

函数 查方法签名(字符串 合成名, 字符串 方法名, 整64 实参数, 方法签名* 出) -> 布尔 {

    字符串 基名 = 合成名基名(合成名);

    确保签名已加载();

    整64 键ID = 驻留(基名 + "." + 方法名 + "." + 整数转字符串(实参数));

    整64 查参 = 查签名参数串(键ID);

    整64 查返 = 查签名返回(键ID);

    如果 (查参 >= 0) {

        如果 (查返 >= 0) {

            // ②c A：实参替换改按元数切分的实参列表（朴素 '$' 切分对嵌套实参错）；

            //   类型参数序串经 类类型参数们 查取（基名 -> "T"/"K,V"）

            向量<字符串> 实参们 = 取实例实参们(合成名);

            字符串 序串 = "";

            整64 查序 = 查类类型参数(驻留(基名));

            如果 (查序 >= 0) { 序串 = 字符串复制(驻留文本(查序)); }

            // A2（2026-09-11 方案甲）：局部拥有串（归一结果名/替换 返回类型=字符串

            //   契约→登记 RAII→函数退出 free）存入结构体字段须显式复制——原浅存

            //   =字段悬垂（自举第二代实测：签.返回文本 悬垂→解析调用返回结构体

            //   驻留(垃圾)→结构体大小 0→45 个「成员字段偏移未知」；第一代堆未

            //   复用侥幸绿。「字符串入结构体须显式复制」纪律——容器 move 语义

            //   随后续批次）。

            出.参数串 = 字符串复制(替换类型参数带段们(驻留文本(查参), 序串, 实参们));

            字符串 返回文本 = 归一结果名(替换类型参数带段们(驻留文本(查返), 序串, 实参们));

            出.返回文本 = 字符串复制(返回文本);

            如果 (是结果类型(返回文本)) {

                字符串 值类型 = 段首(合成名首实参(返回文本));

                如果 (字符串比较(值类型, "空类型")) {

                    出.返回形态 = 容器返回_结果空;

                } 否则 {

                    出.返回形态 = 容器返回_结果值;

                    出.值偏移 = 结果值偏移(值类型);

                }

            } 否则 如果 (字符串比较(返回文本, "空类型")) {

                出.返回形态 = 容器返回_空类型;

            } 否则 {

                // ②b B2：T 为结构体 -> 隐藏返回指针形态（元素(位置)->T 按值返回 sret，

                //   链式 .字段 经 retbuf 基址访问）。T 为容器（类）不在结构体大小表 ->

                //   标量（ptr）：类元素 8 字节指针步长存储、rax 返回元素句柄。

                //   第 14 枚根治（2026-09-06，v2self 第 7 层）：「含容器字段的结构体 ->

                //   标量」旧判定撤销——它是 E2E 127 时代「供给.cn 类形态供给」的专属

                //   契约（主.cn 结构体声明 × 供给类实现 = 同名双 ABI），与宿主真语义

                //   分叉：宿主对 向量<词条>.元素(0)（词条=含容器字段结构体）发射

                //   rdi=retbuf/rsi=this/rdx=位置 三装载 sret（127 直编 asm 实证+

                //   运行 exit=0；v2p_rt 同款）。v2 旧判定发射 rdi=this/rsi=实参 ->

                //   this/实参整体错位（v2self 崩于 程序.函数们.元素(f)：this=0、

                //   位置=残留 0xffffffff -> 运行时错误3）。Rust 对齐：类型即布局、

                //   布局即 ABI——同名类型禁止双 ABI；大对象按值返回=sret 与

                //   Rust/LLVM codegen 一致，零额外开销。127 供给契约同步修

                //（供给.cn 词条 类->结构体，与本处配套消灭双 ABI）。

                整64 返回ID = 驻留(返回文本);

                // 595-a（001-001 双模收敛·根因2）：容器实例返回恒标量（ptr 句柄
                //   ·宿主 ir_oop_call mapType(容器)="ptr" 权威）。撤守卫态返回文
                //   本入结构体大小表后 查结构体大小 命中 → 原翻转 sret：调用方把
                //   rax(retbuf 栈地址) 当堆句柄存槽 → 出口析构栈地址=崩溃。生产态
                //   容器名查表 miss=恒标量（本排除等价零变化）。

                如果 (!是容器类(返回文本) && 查结构体大小(返回ID) != 0) {

                    出.返回形态 = 容器返回_结构体;

                } 否则 {

                    出.返回形态 = 容器返回_标量;

                }

            }

            返回 真;

        }

    }

    返回 假;

}



// 返回形态字节数（②b B6：retbuf 区按真实返回尺寸定帧——旧固定 2 槽=16 字节

//   对 ≥17 字节结构体返回越界踩顶变量槽，126 节点=24 字节实测踩中）。

//   结果空 16 / 结果值 结果大小 / 结构体 查结构体大小（②c A：容器返回=容器对象大小）；

//   标量/空类型 0=无 retbuf。

不安全 函数 签名返回字节数(方法签名* 签) -> 整64 {

    // 585-a（撤守卫收口·268-a 口径对齐）：结果空 12→16——错误槽实际发射偏移=8

    //   +宽 8=需 16（同 结果大小 整32/正32/空类型 分支）。旧 12=retbuf 帧预留

    //   少 8B：撤守卫态被调=stdlib 源码级容器方法（v2 生成 sret 写 16B）→

    //   踩 retbuf 相邻变量槽（441 A3「新表」句柄归零/探针 rc=139 实测；生产态

    //   被调=C 运行时实现写 12B 故长期免疫——守卫掩盖下的潜伏缺陷）。

    如果 (签.返回形态 == 容器返回_结果空) { 返回 16; }

    如果 (签.返回形态 == 容器返回_结果值) { 返回 结果大小(签.返回文本); }

    如果 (签.返回形态 == 容器返回_结构体) {

        如果 (是容器类(签.返回文本)) { 返回 容器对象大小(签.返回文本); }

        返回 查结构体大小(驻留(签.返回文本));

    }

    返回 0;

}



// 发射调用实参装载（参数区模式，用户裁决项3）：弹出们 为倒序（元素0=最后实参），

//   实参 j（0 起，第 j+1 个）位号=起始位+j，寄存器=弹出们[个数-1-j]。

//   IR_调用实参 为声明性指令（代码生成在 IR_调用参数化 统一展开装载）。

// 91-a（2026-09-13 第九十一轮）：操作数2 = 实参类型码（调用点寄存器类分派——

//   T_浮32/T_浮64 走 xmm0-xmm7/d0-d7 浮点寄存器类，SysV/AAPCS64 浮点独立计数；

//   0/未标注按整型类兜底）。类型码由调用方经 查寄存器类型 取得、与 弹出们

//   同序传入（IR容器 不在 IR生成 导入链上不能查表——调用方全在 IR生成 包内）。

函数 发射调用实参们(向量<整64> 弹出们, 整64 起始位, 向量<IR指令>& 指令,

                  向量<整64> 实参类型码们) -> 空类型 {

    整64 n = 弹出们.大小();

    整64 j = 0;

    当 (j < n) {

        整64 实参码 = 0;

        如果 (j < 实参类型码们.大小()) { 实参码 = 实参类型码们.元素(n - 1 - j); }

        IR追加(指令, 建IR指令(IR_调用实参, 弹出们.元素(n - 1 - j), 实参码,

                              0, 0, 起始位 + j, 0));

        j++;

    }

}





// ==================== 类型名 -> IR 类型码 ====================

// 源码类型名（驻留文本）-> IR 类型码（T_*）。未知返回 T_未知。

函数 类型码(整64 类型名ID) -> 整64 {

    字符串 名 = 字符串复制(驻留文本(类型名ID));

    // 94-a：数组类型——类型码按**元素类型**（宿主 mapType(数组)=mapType(元素)

    //   同构；数组名退化为元素指针，打印/拼接/转换分派按元素类型）

    如果 (是数组类型文本(名)) {

        字符串 元素c = 数组元素文本(名);

        如果 (字符串长度(元素c) > 0) { 返回 类型码(驻留(元素c)); }

    }

    // CN 字符串 == 是指针比较（非内容）——须用 字符串比较

    如果 (字符串比较(名, "整32")) { 返回 T_整32; }

    如果 (字符串比较(名, "整64")) { 返回 T_整64; }

    如果 (字符串比较(名, "浮32")) { 返回 T_浮32; }

    如果 (字符串比较(名, "浮64")) { 返回 T_浮64; }

    如果 (字符串比较(名, "布尔")) { 返回 T_布尔; }

    如果 (字符串比较(名, "字符串")) { 返回 T_字符串; }

    如果 (字符串比较(名, "空类型")) { 返回 T_空类型; }

    // 46-f 无符号语义轮（2026-09-10 第五十轮）：正32/正64 独立类型码（原与

    //   整64 同码归并，运算层无从分派无符号）——寄存器类型登记/二元指令

    //   类型字段经此传播，三后端按码分派 div/shr/setb 族无符号指令

    如果 (字符串比较(名, "正32")) { 返回 T_正32; }

    如果 (字符串比较(名, "正64")) { 返回 T_正64; }

    如果 (字符串比较(名, "整8") || 字符串比较(名, "整16") ||

        字符串比较(名, "正8") || 字符串比较(名, "正16") ||

        字符串比较(名, "字符") || 字符串比较(名, "指针")) { 返回 T_整64; }

    // A2：字符* 借用视图=指针单槽，与 字符串 同码（打印/拼接按字符串消费；

    //   区别只在拥有性——语义层判定，类型码层等价）

    如果 (字符串比较(名, "字符*")) { 返回 T_字符串; }

    返回 T_未知;

}





// ==================== 跨子模块访问函数（千行拆分，2026-09-08） ====================

//   生成表达式/生成语句/生成函数/语义检查 子模块经下列函数访问

//   静态表/签名表（静态表=文件级私有，跨文件仅函数可见）

函数 查静态序号(整64 名ID) -> 整64 {

    结果<整64, 整32> 查 = 静态序号们.获取(名ID);

    如果 (查.正常) { 返回 查.值; }

    返回 0 - 1;

}



函数 取静态数() -> 整64 {

    返回 静态名们.大小();

}



函数 取静态类型(整64 序) -> 整64 {

    返回 静态类型们.元素(序);

}



// 87-a：静态初值区间查询（无初值返回 -1）

函数 取静态初值起点(整64 序) -> 整64 {

    如果 (序 >= 静态初值起点们.大小()) { 返回 0 - 1; }

    返回 静态初值起点们.元素(序);

}



函数 取静态初值终点(整64 序) -> 整64 {

    如果 (序 >= 静态初值终点们.大小()) { 返回 0 - 1; }

    返回 静态初值终点们.元素(序);

}



// 87-a：静态初值是否需入口注入（结构体/字符串/折叠失败标量）

函数 取静态需注入(整64 序) -> 布尔 {

    如果 (序 >= 静态需注入们.大小()) { 返回 假; }

    返回 静态需注入们.元素(序) != 0;

}



函数 查函数签名个数(整64 键基) -> 整64 {

    结果<整64, 整32> 查 = 函数签名个数们.获取(键基);

    如果 (查.正常) { 返回 查.值; }

    返回 0 - 1;

}



函数 查函数签名参数串(整64 键) -> 整64 {

    结果<整64, 整32> 查 = 函数签名参数串们.获取(键);

    如果 (查.正常) { 返回 查.值; }

    返回 0 - 1;

}





// ==================== 81-a-v2：帧尾共享 retbuf 的「返回物化」与实参临时清理 ====================

// 立案（HANDOFF 下一轮第一优先，数据损坏级）：v2 的 retbuf 是**帧尾共享单缓冲**

//   （全部结构体/结果返回共用 `retbuf序号` 槽区，`累计retbuf字节数` 定尺寸）——

//   任何「返回值跨越另一次调用」的形态都被覆盖：

//     ① `表.追加(造盒())`（单实参）：返回句柄被外层调用的 retbuf 覆盖 → 泄漏；

//     ② `合并(造盒(1),造盒(2))`（双实参）：第二次返回覆盖第一次 → **数据损坏**

//        （实测宿主 1 / v2 0）。

//   宿主对照：宿主每次调用分配独立 `__retbufN` Alloca 槽（无共享），故无此问题。

//   Rust/LLVM 对照：sret 缓冲由**每次调用各自分配**（LLVM 语义）——本实现对齐之。

// 机制主体（甲案）= **结构体/结果返回调用发射后立即物化**：把 retbuf 内容拷进

//   「生成期临时槽」（独立槽 + 返回寄存器覆盖为槽地址）→ 每个返回值独立 ✓；

//   实参位置的消费者在外层调用发射后按登记表释放其串字段（清理调用实参临时）。

// 槽分配纪律（**独立于预扫预分配槽区**）：

//   ① 预扫（预扫容器声明/登记参数槽）分配：参数槽 + 变量槽（槽 1=retbuf 指针保留）；

//   ② 生成期新增槽（本机制的临时槽）**只用同一 `槽计数` 继续递增**——不回溯、

//      不复用已分配槽号、不与参数/变量槽区交错；

//   ③ retbuf 区由**代码生成动态计算**（`扫描函数` 的 `槽基数 = 最大槽`，retbuf 区在

//      其上）→ 任何 `IR_分配`（含本机制的临时槽）都会上移该区，两者**不可能重叠**；

//   ④ 计数器随函数生成结束即失效（无跨函数残留）；登记表在函数边界清空。

// 依赖不变量（plans/020 移植纪律 7）：

//   ①**只有真结构体**（`查结构体大小 != 0`）物化——结果/可选 合成布局与容器对象

//     返回不物化（其消费路径各异，见诚实边界）；

//   ②**匹配即删除**（实参清理）；登记表**函数边界清空**（防跨函数寄存器号误命中）；

//   ③释放只服务「纯串字段结构体」（无嵌套/结果/可选/容器字段）——越界形态留给

//     接收方接管（浅拷）或登记边界（宁漏勿错）。

静态 映射<整64, 整64> 结构体返回临时们;   // 物化后寄存器（=槽地址）→ 结构体ID



// 顺序可释放判定（84-c 扩容：字符串字段 + **嵌套结构体字段递归**）——无块结构版

//   释放（`发射串字段释放顺序`）的前提：结果/可选（联合体条件）/容器（DeleteObject）

//   字段=面外 → 整段不清理（宁漏勿错）。

//   原实现仅 `串字段数 == 资源字段数`（纯串字段结构体）→ 嵌套结构体元素（如

//   `外盒{ 内 = 内盒{ 名 = 串 } }`）判假 → 实参位置物化槽不清理（探针 P25② 泄漏）。

函数 是纯串字段结构体(整64 结构体ID) -> 布尔 {

    返回 可顺序释放结构体(整64(结构体ID), 0);

}



不安全 函数 可顺序释放结构体(整64 结构体ID, 整64 深度) -> 布尔 {

    如果 (深度 > 4) { 返回 假; }

    如果 (查结构体大小(结构体ID) == 0) { 返回 假; }

    如果 (资源字段数(结构体ID) <= 0) { 返回 假; }

    向量<整64> 字段们 = 向量<整64>();

    取资源字段们(结构体ID, 字段们);

    整64 f = 0;

    当 (f + 2 < 字段们.大小()) {

        整64 字段类型IDf = 字段们.元素(f + 1);

        字符串 类型文本f = 字符串复制(驻留文本(字段类型IDf));

        如果 (字符串比较(类型文本f, "字符串")) {

            // 串字段：可顺序释放 ✓

        } 否则 如果 (是容器类(类型文本f) || 是结果类型(类型文本f)) {

            返回 假;

        } 否则 如果 (查结构体大小(字段类型IDf) != 0) {

            如果 (!可顺序释放结构体(字段类型IDf, 深度 + 1)) { 返回 假; }

        } 否则 {

            返回 假;

        }

        f += 3;

    }

    返回 真;

}



// 82-a：把「返回类型名」限定到**被调函数的定义模块**——同名结构体的布局按模块

//   分桶独立（E2E 172：主模块 记录=4B vs 甲模块 记录=16B）；纯名在主模块上下文

//   解析会取到同名异布局类型（大小错 → 返回物化长度错，实测主侧 `甲::造甲` 的

//   返回大小被解析为 4 而非 16）。**不改返回类型表**（避免影响其它消费点）——

//   物化点单点限定：键文本含 "::" 时取模块前缀重查大小，命中才用限定名。

函数 子串位置(字符串 文本, 字符串 目标) -> 整64 {

    整64 n = 字符串长度(文本);

    整64 m = 字符串长度(目标);

    如果 (m <= 0 || m > n) { 返回 -1; }

    整64 i = 0;

    当 (i + m <= n) {

        如果 (字符串比较(字符串子串(文本, i, m), 目标)) { 返回 i; }

        i++;

    }

    返回 -1;

}



函数 限定返回类型ID(整64 函数符号, 整64 返回类型ID) -> 整64 {

    字符串 类型文本 = 字符串复制(驻留文本(返回类型ID));

    如果 (子串位置(类型文本, "::") >= 0) { 返回 返回类型ID; }

    // 函数键格式 = 键基#参数串（键基 = 模块$名 于非主模块 / 名 于主模块）——

    //   首个 '$' 之前 = 模块前缀（主模块函数无 '$' → 不限定）

    字符串 键文本 = 字符串复制(驻留文本(函数符号));

    整64 分位置 = 首分段位置(键文本);

    如果 (分位置 <= 0) { 返回 返回类型ID; }

    字符串 模块前缀 = 字符串子串(键文本, 0, 分位置);

    整64 限定ID = 驻留(字符串复制(模块前缀) + "::" + 类型文本);

    如果 (查结构体大小(限定ID) != 0) { 返回 限定ID; }

    返回 返回类型ID;

}



// 返回物化（调用发射后立即执行；独立槽=帧尾共享 retbuf 的替代）：

//   源=返回寄存器（=retbuf 地址）→ 新分配的生成期临时槽；**返回槽地址寄存器**

//   （调用方以它替换压栈的返回值——消费者/接收方拿到的是独立副本，与后续调用的

//   retbuf 无共享）。登记「槽地址寄存器 → 结构体ID」供实参位置清理消费。

//   Rust/LLVM 对照：sret 缓冲由每次调用各自分配（本实现以「每次返回调用一个新槽」

//   达成同一语义；槽号随槽计数递增，帧尺寸随之增长=正确性必要代价）。

不安全 函数 物化返回值到独立槽(向量<IR指令>& 指令, 整64* 寄存器计数,

                    整64* 槽计数, 整64 返回寄存器, 整64 结构体ID) -> 整64 {

    整64 大小 = 查结构体大小(结构体ID);

    如果 (大小 <= 0) { 返回 0; }

    整64 槽数m = (大小 + 7) / 8;

    整64 槽起 = 槽计数[0];

    槽计数[0] = 槽计数[0] + 槽数m;

    // 逐槽 IR_分配（②b B1 结构体局部同款）：扫描函数 按 附加 统计最大槽——

    //   只登记基槽会使帧尺寸少算，越界踩相邻槽

    整64 z = 0;

    当 (z < 槽数m) {

        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽起 + z));

        z++;

    }

    // **基址槽 = 槽起 + 槽数m - 1**（②b B1 约定：最大槽号=最低地址=结构体基址；

    //   槽偏移 = -(8*(最大寄存器+s)+8) 随槽号减小而升高——误用 槽起 当基址会把

    //   结构体写到相邻变量槽上（P20 实测：物化槽 -704 与 t 槽 -696 重叠 8 字节）

    整64 基槽 = 槽起 + 槽数m - 1;

    整64 槽地址reg = 寄存器计数[0];

    寄存器计数[0] = 寄存器计数[0] + 1;

    IR追加(指令, 建IR指令(IR_取地址, 基槽, 0, 0, 槽地址reg, T_整64, 0));

    IR追加(指令, 建IR指令(IR_结构体拷贝, 返回寄存器, 槽地址reg, 0, 0, 大小, 0));

    结果<空类型, 整32> 设 = 结构体返回临时们.设置(槽地址reg, 结构体ID);

    如果 (!设.正常) { 运行时错误(4); }

    返回 槽地址reg;

}



// 顺序释放（无函数IR 上下文：不发射条件分支，不清槽——临时不再被读取）

不安全 函数 发射串字段释放顺序(向量<IR指令>& 指令, 整64* 寄存器计数,

                     整64 基址reg, 整64 结构体ID) -> 空类型 {

    向量<整64> 字段们 = 向量<整64>();

    取资源字段们(结构体ID, 字段们);

    整64 f = 0;

    当 (f + 2 < 字段们.大小()) {

        整64 偏移 = 字段们.元素(f + 2);

        整64 地址reg = 寄存器计数[0];

        寄存器计数[0] = 寄存器计数[0] + 1;

        IR追加(指令, 建IR指令(IR_字段地址, 基址reg, 0, 0, 地址reg, T_整64, 偏移));

        整64 字段类型IDs = 字段们.元素(f + 1);

        如果 (字符串比较(字符串复制(驻留文本(字段类型IDs)), "字符串")) {

            整64 串reg = 寄存器计数[0];

            寄存器计数[0] = 寄存器计数[0] + 1;

            IR追加(指令, 建IR指令(IR_指针加载, 地址reg, 0, 0, 串reg, T_字符串, 0));

            IR追加(指令, 建IR指令(IR_调用实参, 串reg, 0, 0, 0, 0, 0));

            IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0, 驻留("__cn_str_free")));

        } 否则 如果 (查结构体大小(字段类型IDs) != 0) {

            // 84-c：嵌套结构体字段（值语义内联）→ 以字段地址为基址递归释放

            发射串字段释放顺序(指令, 寄存器计数, 地址reg, 字段类型IDs);

        }

        f += 3;

    }

}



// 调用发射后清理本次调用的实参临时（实参寄存器命中登记表即清理，匹配即删除）

不安全 函数 清理调用实参临时(向量<整64>& 弹出们, 向量<IR指令>& 指令,

                   整64* 寄存器计数) -> 空类型 {

    整64 i = 0;

    当 (i < 弹出们.大小()) {

        整64 reg = 弹出们.元素(i);

        结果<整64, 整32> 查 = 结构体返回临时们.获取(reg);

        如果 (查.正常) {

            如果 (是纯串字段结构体(查.值)) {

                发射串字段释放顺序(指令, 寄存器计数, reg, 查.值);

            }

            布尔 删 = 结构体返回临时们.删除(reg);

        }

        i++;

    }

}
