// CN 自举编译器 v2：容器类型 IR 辅助（自举重建 P7b，2026-09-01）
// 容器类型（向量/映射/链表/栈/队列/集合/结果）类型判定、对象大小表、
// 方法签名表——IR生成.cn 的容器实例化/方法调用据此合成宿主对齐符号
// （类$方法#参数串 → nameMangle，实现链接宿主编译 obj，rustc 预编译 std 模式）。
// 契约对标：宿主 generics.cpp（实例名 类名$实参 扁平 $ 连接）、semantic.cpp
//   signatureKey（方法名#参数类型1,参数类型2）、stdlib 容器.cn/映射集合.cn
//   （方法签名与字段布局）。
// 依赖说明：IR_* 操作码/T_* 类型码/常量表 由 IR常量.cn 定义（簇① A2 单一归属）；
//   IR 指令/函数 IR 数据结构（IR指令/函数IR 结构体）自 呈报①A 根治（2026-09-05）
//   起定义在本模块（见下）——原定义在 IR生成.cn 顶层，而本模块引用它 + IR生成
//   导入本模块 = 反向引用不可导；主链靠多文件合并全局可见掩盖，冒烟子链
//   （IR容器/语法分析/语义分析 入口——链上无 IR生成.cn）结构体登记缺失 ->
//   解析方法对象类型 查结构体大小 miss = 「方法调用的对象类型未知」误诊
//   （冒烟 asm 断供；曾误归因 IR常量.cn 新增常量对，实为登记源结构性缺失）。
导入 容器::向量;
导入 映射集合;
导入 IR;         // 签名辅助 + 节点_*/T_*/IR_*/键位移/当前函数变量类型（原 IR签名+IR常量 合并目录包名）

公开:

// ==================== IR 数据结构（呈报①A 下沉，2026-09-05） ====================
// IR指令/函数IR 自 IR生成.cn 下沉至本模块：本模块（IR追加/建IR指令/发射容器
//   析构族）与其全部引用方（IR生成/代码生成/代码生成ARM64/代码生成共用/主）
//   的导入链均含本模块——登记源（语法分析 解析结构体声明 -> 登记结构体布局）
//   在任意冒烟子链上恒可达。程序IR 仍留 IR生成.cn（引用方链上恒含 IR生成）。
结构体 IR指令 {
    整64 操作码;
    整64 操作数1;
    整64 操作数2;
    整64 操作数3;
    整64 目标;
    整64 类型;
    整64 附加;
}

// ==================== 函数 IR ====================
// 每个函数：指令数组 + 局部槽表（名ID -> 槽索引）+ 参数槽表 + 返回类型码。
结构体 函数IR {
    向量<IR指令> 指令;
    映射<整64, 整64> 局部槽;
    映射<整64, 整64> 参数槽;
    整64 返回类型;
    整64 返回结构体ID;  // 用户函数返回结构体（2026-09-04，E2E 148）：非 0=返回
                        //   类型为该结构体——宿主 ABI 走隐藏 retbuf（位0 传入、
                        //   rax 返回）；被调方槽 1=retbuf 指针（调用方帧尾缓冲）
    整64 返回引用;      // 引用返回（2026-09-04 缺陷零容忍收口，宿主 P3-18 对齐）：
                        //   1=返回类型尾 '&'（-> 整64&）——返回语句发射被引用
                        //   左值地址（生成左值地址），调用方经指针加载读/指针
                        //   存储写（赋值目标/复合赋值）/直接绑定（引用初始化）
    整64 返回结果名ID;  // 71-a（2026-09-11 方案A 用户裁决）：返回类型为 结果/可选
                        //   合成名（结果$字符串$整32）的名ID——非 0=结果返回，与
                        //   返回结构体ID 同款 retbuf ABI（槽 1=retbuf 指针、位 0
                        //   装载、rax=retbuf；结果大小=结果大小(合成名)——结构体
                        //   表查不到 0，故独立字段不复用 ID）
    整32 名字;
    整64 块计数;        // P6b：块编号计数器（标签随建随取，嵌套安全）
    整64 当前块;        // P6b：当前块 ID（跳转目标；初始 0=函数入口块）
    整64 循环出口块;    // P6b：最近 当/循环 出口块（中断 跳转目标；0=无）
    整64 循环继续块;    // P6b：最近 当/循环 继续块（继续 跳转目标；0=无）
    整64 循环串基线;    // 73-a（2026-09-11 方案A 用户裁决）：进入最近循环体前的
                        //   字符串变量们 基线——中断/继续 跳出 drop-on-jump 的
                        //   释放范围起点（生成当 保存/恢复，嵌套循环自然正确）
    整64 循环容基线;    // 73-a：容器变量们 基线（同上）
    整64 循环字段基线;  // 73-a：容器字段局部们 基线（同上）
    整64 函数尾块;      // 缺陷A根治（2026-09-02）：函数尾块——IR_返回 后跳转至此，
                        //   标签在函数体末发射（epilogue 唯一，中途回退不再穿透）
    映射<整64, 整64> 变量类型;    // P7b：变量名ID -> 类型名ID（容器/结果成员访问与方法解析）
    向量<整64> 字符串变量们;     // plans/019 阶段4' 第二批：拥有型字符串局部名单（白名单判定后）
    映射<整64, 整64> 字符串污染们;  // plans/019 阶段4' 第二批：污染名ID -> 1（非拥有赋值/
                                //   下标借出——释放挂点一律跳过，宿主 stringTainted_ 同构）
    向量<整64> 容器变量们;        // P7b：容器变量名ID 列表（RAII 返回前析构遍历）
    向量<整64> 容器字段局部们;    // ②c B：含容器字段的结构体局部名ID（块出口级联析构）
    向量<整64> 容器字段结构体们;  // ②c B：对应结构体名ID（与 容器字段局部们 同下标）
    整64 retbuf字节数;    // ②b B6：本函数 retbuf 调用最大返回字节数（帧尺寸依据；
                        //   生成函数 出口自 当前retbuf字节数 回填）
    向量<整64> 参数槽序们;        // ②b B8：参数按声明序的基槽（多槽结构体参数=最大槽号）
    向量<整64> 参数拷贝字节们;    // ②b B8：参数按声明序的 prologue 拷贝字节数
                                //   （0=标量直存；>0=结构体按值：指针入参 -> 多槽拷贝）
    整64 零寄存器;        // 73-a（2026-09-11 方案A 用户裁决）：函数入口常量 0 的
                        //   寄存器号（预扫 无资源声明时为 0=未分配）——释放点
                        //   清零槽用（释放+清零幂等模型：跳出释放/块出口释放后
                        //   槽清零，函数级兜底再次经过时读 0=空安全跳过，杜绝
                        //   双释；宿主 72-a 同款）。该指令位于函数入口必经路径，
                        //   任何释放点的运行期路径都已执行过它。
}

// ==================== 方法返回形态 ====================
常量 容器返回_标量 = 0;     // 标量返回 rax（大小/元素/为空/包含/删除(K) 布尔）
常量 容器返回_结果空 = 1;   // 结果<空类型,整32>：隐藏返回指针，12 字节（追加/删除(i)/设置/插入/预留）
常量 容器返回_结果值 = 2;   // 结果<T,整32>：隐藏返回指针（读取/获取/弹出/栈顶/出队/队首）
常量 容器返回_空类型 = 3;   // 无返回值（清空）
常量 容器返回_结构体 = 4;   // ②b B2（2026-09-02）：T 为结构体的按值返回（元素(位置)->T）——
                           //   隐藏返回指针，调用后 rax/x0=缓冲地址即结构体地址（宿主
                           //   epilogue mov x0,x19 / win rax 同款），链式 .字段 以此为基址

// ==================== 实例实参再切分（②c A，2026-09-02） ====================
// $ 扁平合成名的实参串按基名元数贪婪再切分：向量$映射$整64$整64 -> ["映射$整64$整64"]、
//   映射$整64$整64 -> ["整64","整64"]。朴素 '$' 切分对嵌套实参必错（单参 T 被切成
//   首段 "映射"），方法符号（#参数串）与返回类型推导双双失真（对标宿主 AST 级
//   实例化——扁平串须按元数还原）。
函数 基名元数(字符串 基名) -> 整64 {
    如果 (字符串比较(基名, "映射") || 字符串比较(基名, "结果")) { 返回 2; }
    返回 1;
}

// 实例化基名（容器 + 结果/可选——参与实参段的递归消费）
函数 是实例化基名(字符串 名) -> 布尔 {
    返回 是容器基名(名) || 字符串比较(名, "结果") || 字符串比较(名, "可选");
}

// 解析 [位置..] 为一个实参段：标识符词（含数字——类型名 整64/浮32/整128 等）；
//   实例化基名递归消费其元数个实参段；尾缀 '*'/'&' 字节原样并入。位置 出参推进
//  （调用方保证 '$' 分隔已消费）。
不安全 函数 解析实参段(字符串 实参串, 整64* 位置) -> 字符串 {
    整64 i = 位置[0];
    整64 n = 字符串长度(实参串);
    字符串 词 = "";
    当 (i < n) {
        整64 字节 = 整64(实参串[i]) & 255;
        布尔 词字节 = 字节 >= 128 || (字节 >= 48 && 字节 <= 57) ||
                      (字节 >= 65 && 字节 <= 90) ||
                      (字节 >= 97 && 字节 <= 122) || 字节 == 95;
        如果 (词字节) {
            词 = 词 + 字符串子串(实参串, i, 1);
            i++;
        } 否则 {
            中断;
        }
    }
    如果 (字符串长度(词) == 0) { 返回 ""; }
    如果 (是实例化基名(词)) {
        整64 元 = 基名元数(词);
        整64 k = 0;
        当 (k < 元) {
            // 期望 '$' 分隔（防御：不足则停止）
            如果 (i < n) {
                整64 分隔 = 整64(实参串[i]) & 255;
                如果 (分隔 == 36) { i++; }
            }
            位置[0] = i;
            字符串 子段 = 解析实参段(实参串, 位置);
            如果 (字符串长度(子段) == 0) { 中断; }
            词 = 词 + "$" + 子段;
            i = 位置[0];
            k++;
        }
    }
    // 尾缀 '*'(42) / '&'(38) 原样并入（指针/引用形实参）
    当 (i < n) {
        整64 后缀 = 整64(实参串[i]) & 255;
        如果 (后缀 == 42 || 后缀 == 38) {
            词 = 词 + 字符串子串(实参串, i, 1);
            i++;
        } 否则 {
            中断;
        }
    }
    位置[0] = i;
    返回 词;
}

// 取实例实参们：跳过基名首段，按元数贪婪切分全部实参（返回向量）
函数 取实例实参们(字符串 合成名) -> 向量<字符串> {
    向量<字符串> 实参们 = 向量<字符串>();
    整64 首 = 首分段位置(合成名);
    如果 (首 < 0) { 返回 实参们; }
    整64 i = 首 + 1;
    整64 n = 字符串长度(合成名);
    当 (i < n) {
        整64 位置 = i;
        字符串 段 = 解析实参段(合成名, &位置);
        如果 (字符串长度(段) == 0) { 中断; }
        // A2：段 是循环内登记变量（返回块 RAII 释放末迭代值）——入容器显式
        //   复制，防向量元素悬垂（浅共享×源释放）。
        结果<空类型, 整32> 加段 = 实参们.追加(字符串复制(段));
        如果 (!加段.正常) { 运行时错误(4); }
        i = 位置;
        // 期望 '$' 分隔或结束
        如果 (i < n) {
            整64 分隔 = 整64(合成名[i]) & 255;
            如果 (分隔 == 36) { i++; }
        }
    }
    返回 实参们;
}

// ==================== 顶层静态声明表（②c C，2026-09-02） ====================
// 任务级生命周期：名ID -> 序号（IR 标识符解析）；名/类型平铺（入口构造注入）；
//   IR生成 入口收集（先清空，幂等）。存储=双后端 .data _cn_gstatic_<序号> 槽
//   （统一指针槽：容器=堆对象指针；标量=初始值——.data 直存折叠字面量）。
静态 映射<整64, 整64> 静态序号们;

// IR 层错误计数与统一诊断（2026-09-04，IR生成.cn 冒烟 [ir2] 纪律收口）：
//   [ir2] 级诊断=IR 不完整（形态不支持/目标未解析）——产物不可信。对齐
//   「语义错误即中止」（E2E 139 纪律）：主.cn 于 IR 生成后检查计数>0 即
//   中止（不产 asm）。单一归属本组件（IR生成/IR容器 诊断点全部经此计数）。
静态 整64 IR层错误计数 = 0;

函数 IR层诊断(字符串 消息) -> 空类型 {
    IR层错误计数 = IR层错误计数 + 1;
    IO::打印到错误("[ir2] " + 消息 + "\n");
}

函数 取IR层错误数() -> 整64 {
    返回 IR层错误计数;
}

函数 清空IR层错误计数() -> 空类型 {
    IR层错误计数 = 0;
}
静态 向量<整64> 静态名们;
静态 向量<整64> 静态类型们;

函数 清空静态表() -> 空类型 {
    静态序号们.清空();
    静态名们 = 向量<整64>();
    静态类型们 = 向量<整64>();
}

// 收集一个 程序 节点区间的全部静态声明（容器/标量通用——初始值折叠由 IR生成 完成）
函数 收集静态(向量<节点> 池, 整32 程序节点, 向量<整64>& 初始值们) -> 空类型 {
    节点 程序 = 池.元素(程序节点);
    整64 i = 整64(程序.子起点);
    当 (i < 整64(程序.子终点)) {
        节点 声明 = 池.元素(整32(i));
        如果 (声明.类型 == 节点_静态声明) {
            整64 序号 = 静态名们.大小();
            结果<空类型, 整32> 加名 = 静态名们.追加(整64(声明.文本));
            如果 (!加名.正常) { 运行时错误(4); }
            节点 类型节点 = 池.元素(整32(声明.附加));
            结果<空类型, 整32> 加类 = 静态类型们.追加(整64(类型节点.文本));
            如果 (!加类.正常) { 运行时错误(4); }
            结果<空类型, 整32> 设序 = 静态序号们.设置(整64(声明.文本), 序号);
            如果 (!设序.正常) { 运行时错误(4); }
            字符串 类型文本 = 字符串复制(驻留文本(整64(类型节点.文本)));
            如果 (是容器类(类型文本)) {
                // 容器静态：入口 NewObject+构造（初始值表达式同构，忽略）——
                //   .data 槽初值 0（文本 ID 形态——代码生成经 驻留文本 还原）
                结果<空类型, 整32> 加零 = 初始值们.追加(驻留("0"));
                如果 (!加零.正常) { 运行时错误(4); }
            } 否则 {
                // 标量静态：初始值折叠（空初始化按 0）
                整64 值ID = 驻留("0");
                如果 (声明.子起点 < 声明.子终点) {
                    整64 折叠 = 折叠常量值(池, 声明.子起点, 声明.子终点);
                    如果 (折叠 != 0) { 值ID = 折叠; }
                }
                结果<空类型, 整32> 加值 = 初始值们.追加(值ID);
                如果 (!加值.正常) { 运行时错误(4); }
            }
        }
        i++;
    }
}

// ==================== 符号合成（宿主 methodSymbolKey 对齐） ====================
// 无参构造符号：类$基名（向量$整64 -> 向量$整64$向量；宿主构造方法名=类名）
函数 构造符号(字符串 合成名) -> 字符串 {
    返回 合成名 + "$" + 合成名基名(合成名);
}

// 析构符号：类$~基名（向量$整64 -> 向量$整64$~向量）
函数 析构符号(字符串 合成名) -> 字符串 {
    返回 合成名 + "$~" + 合成名基名(合成名);
}

// 方法符号：类$方法[#参数串]（参数串空则无 #——对标宿主 signatureKey）
函数 方法符号(字符串 合成名, 字符串 方法名, 字符串 参数串) -> 字符串 {
    如果 (字符串长度(参数串) == 0) { 返回 合成名 + "$" + 方法名; }
    返回 合成名 + "$" + 方法名 + "#" + 参数串;
}

// ==================== 函数签名表（呈报③方案A：重载消歧，2026-09-06） ====================
// 规格书 §函数重载（plans/001:358）：同名函数按参数类型与个数区分（重载决议），
//   名称修饰按签名编码（附录C）。宿主权威 = signatureKey（semantic.cpp:546，
//   名#参数串，参数串空则无 '#'）——v2 原函数登记键=纯声明名，同名映射覆盖
//   （后吞前静默）+ 函数IR.名字=纯名（跨文件同名重载 asm 重复定义，第一轮
//   冒烟实测源码改名 生成函数W 规避）。本表为决议与消歧的数据基座：
//   键1 = 键基ID -> 候选数；键2 = 键基ID*键位移+候选序 -> 参数串ID。
//   签名键 = 驻留(键基文本 或 键基文本#参数串)——与 函数实参结构们/函数返回类型们
//   的签名键登记、调用点决议产物三方一致（同字符串驻留 = 同 ID）。
// plans/018 P6b 第 4 层（2026-09-07）：登记维度由纯名升级为「键基」（plans/018
//   工作流3 第 3/4 层，宿主 functionLinkKey 公式对齐）——键基 = 主模块（入口，
//   含单文件）纯名本身；其余模块 驻留(模块路径 + "$" + 名)。跨模块同名同签名
//   函数因此合法共存（链接符号天然隔离：非主模块 asm 符号=模块$名#参数串，
//   单文件/主模块形态逐字节不变=v2self 产物对拍硬基准）。登记源（幂等）：
//   语义分析.声明收集（主链+语义冒烟子链）、IR生成/IR生成多文件 入口（IR 冒烟
//   子链，清空后重收集=权威）——两处登记均按键基，同模块同签名重复登记被幂等
//   跳过，跨模块同名互不干扰。
静态 映射<整64, 整64> 函数签名个数们;
静态 映射<整64, 整64> 函数签名参数串们;

// ==================== 调用决议表（plans/018 第 4 层：语义驱动 IR） ====================
// 语义分析 检查表达式 调用分支完成三级名称解析（①本模块 > ②显式导入 >
//   ③glob+歧义诊断，宿主 resolvedSignature=注册键同构）后，把调用点的
//   键基决议结果写入本表（键 = 调用节点池索引 -> 键基ID）；IR 层
//   决议函数符号 据此锁定候选模块桶再做重载决议——IR 不重复名称解析、
//   不反向依赖语义组件（表在 IR容器 中立层，两侧已导入）。主模块/单文件
//   条目值=纯名 ID（与决议函数符号 旧纯名路径等价，行为不变）。
// 生命周期：语义分析/语义分析多文件 入口清空（检查阶段写）；IR 生成阶段只读。
静态 映射<整64, 整64> 调用决议键基们;

函数 调用决议登记(整64 调用节点索引, 整64 键基ID) -> 空类型 {
    结果<空类型, 整32> 设 = 调用决议键基们.设置(调用节点索引, 键基ID);
    如果 (!设.正常) { 运行时错误(4); }
}

函数 调用决议查询(整64 调用节点索引) -> 整64 {
    结果<整64, 整32> 查 = 调用决议键基们.获取(调用节点索引);
    如果 (查.正常) { 返回 查.值; }
    返回 -1;
}

函数 清空调用决议() -> 空类型 {
    调用决议键基们.清空();
}

// 函数参数串提取：遍历函数节点参数区间 [子起点, 块.子起点)（块 在 子终点=
//   块索引，收集函数实参结构 同款），逐参数 类型文本+后缀（类型节点 附加
//   1..255=指针层 '*'×层、>=256=引用 '&'——参数声明位类型文本无后缀，
//   后缀语义在附加），逗号连接。无参返回 空串。
函数 函数参数串(向量<节点> 池, 整32 函数节点) -> 字符串 {
    节点 函数声明 = 池.元素(函数节点);
    整64 参数终点 = 整64(函数声明.子终点);
    如果 (参数终点 < 整64(池.大小())) {
        节点 块节点 = 池.元素(整32(参数终点));
        参数终点 = 整64(块节点.子起点);
    }
    字符串 串 = "";
    整64 i = 整64(函数声明.子起点);
    当 (i < 参数终点) {
        节点 参数 = 池.元素(整32(i));
        如果 (参数.类型 == 节点_参数) {
            字符串 类型文本 = "";
            // 守卫 >= 0（lessons 池索引 0 合法——生成函数 同款）
            如果 (参数.附加 >= 0 && 参数.附加 < 整64(池.大小())) {
                节点 类型节点 = 池.元素(整32(参数.附加));
                如果 (类型节点.类型 == 节点_类型) {
                    类型文本 = 字符串复制(驻留文本(整64(类型节点.文本)));
                    如果 (类型节点.附加 >= 256) {
                        类型文本 = 类型文本 + "&";
                    } 否则 如果 (类型节点.附加 >= 1) {
                        整64 层 = 类型节点.附加;
                        当 (层 > 0) {
                            类型文本 = 类型文本 + "*";
                            层--;
                        }
                    }
                }
            }
            如果 (字符串长度(串) > 0) { 串 = 串 + ","; }
            串 = 串 + 类型文本;
        }
        i++;
    }
    返回 串;
}

// 签名键合成：参数串空 -> 纯名（无 '#'，对齐宿主 signatureKey/方法符号惯例）
函数 函数签名键(整64 名ID, 字符串 参数串) -> 整64 {
    如果 (字符串长度(参数串) == 0) { 返回 名ID; }
    返回 驻留(驻留文本(名ID) + "#" + 参数串);
}

// 登记单个函数签名（幂等：键基下既有候选同参数串 -> 跳过——重定义由语义层
//   声明收集 诊断，本表不重复计候选）。键基语义见上表注（plans/018：主模块
//   =纯名；其余模块=模块$名——跨模块同名同签名合法共存的数据基座）。
函数 登记函数签名K(向量<节点> 池, 整32 函数节点, 整64 键基ID) -> 空类型 {
    节点 函数声明 = 池.元素(函数节点);
    字符串 参数串 = 函数参数串(池, 函数节点);
    整64 键串 = 驻留(参数串);
    整64 候选数 = 0;
    结果<整64, 整32> 查数 = 函数签名个数们.获取(键基ID);
    如果 (查数.正常) { 候选数 = 查数.值; }
    整64 k = 0;
    当 (k < 候选数) {
        结果<整64, 整32> 查串 = 函数签名参数串们.获取(键基ID * 键位移 + k);
        如果 (查串.正常) {
            如果 (查串.值 == 键串) { 返回; }
        }
        k++;
    }
    结果<空类型, 整32> 设串 = 函数签名参数串们.设置(
        键基ID * 键位移 + 候选数, 键串);
    如果 (!设串.正常) { 运行时错误(4); }
    结果<空类型, 整32> 设数 = 函数签名个数们.设置(键基ID, 候选数 + 1);
    如果 (!设数.正常) { 运行时错误(4); }
}

// 收集一个 程序 节点区间的全部函数签名（IR生成/IR生成多文件 入口用；
//   模块路径 = 该文件所属模块（主.cn 加载器传入）——键基按此合成。
//   语义层 声明收集 逐声明调 登记函数签名K——同一机制两个登记面）
函数 收集函数签名(向量<节点> 池, 整32 程序节点, 字符串 模块路径) -> 空类型 {
    节点 程序 = 池.元素(程序节点);
    整64 位置 = 整64(程序.子起点);
    当 (位置 < 整64(程序.子终点)) {
        节点 声明 = 池.元素(整32(位置));
        如果 (声明.类型 == 节点_函数) {
            整64 键基i = 键基合成(模块路径, 整64(声明.文本));
            登记函数签名K(池, 整32(位置), 键基i);
        }
        位置++;
    }
}

// 清空（任务级生命周期惯例——语义分析/语义分析多文件 与 IR生成/IR生成多文件
//   入口清空；主链两段各清空后重收集，内容一致幂等）
函数 清空函数签名() -> 空类型 {
    函数签名个数们.清空();
    函数签名参数串们.清空();
}

// 结果<T,E> 类型字节大小（ABI 防御布局——宿主 typeSizeOf 结果分支）：
//   正常@0(i32)+联合@4(整32)/@8(整64/字符串)；空类型/整32 -> 12，整64/字符串 -> 16；
//   T=结构体（2026-09-06 根治：结果<符号,整32> 值 32B 实际 40B——原按 16 算
//   retbuf 帧区不足，被调方写越界毁栈，v2self 表查找类型ID rep movsb 源=垃圾
//   崩溃实证）-> 8 对齐 + 结构体大小
函数 结果大小(字符串 结果类型名) -> 整64 {
    字符串 值类型 = 段首(合成名首实参(结果类型名));
    如果 (字符串比较(值类型, "整32") || 字符串比较(值类型, "正32") ||
        字符串比较(值类型, "空类型")) { 返回 12; }
    整64 结构字节数 = 查结构体大小(驻留(值类型));
    如果 (结构字节数 != 0) {
        返回 (结构字节数 + 7) / 8 * 8 + 8;
    }
    返回 16;
}

// 结果变量槽位数（8 字节槽）：12/16 字节均占 2 槽；T=结构体按实际大小
//   （2026-09-06 根治：结果<符号> 40B=5 槽，原 2 槽=变量区越界写踩相邻变量）
函数 结果槽位数(字符串 结果类型名) -> 整64 {
    整64 总字节 = 结果大小(结果类型名);
    返回 (总字节 + 7) / 8;
}

// ==================== 类型判定 ====================
// 类基名白名单（stdlib 泛型容器类。注意：结果/可选 不在此列——它们是宿主
//   内置泛型（合成结构体，非堆对象），由 是结果类型 判定；混入白名单会把
//   结果 变量误判为容器（NewObject+构造——v2p 冒烟实测踩坑）。
//   构造调用合法性判定处（语义/IR）用 是容器类 || 是结果类型 组合。
函数 是容器基名(字符串 名) -> 布尔 {
    返回 字符串比较(名, "向量") || 字符串比较(名, "映射") ||
          字符串比较(名, "链表") || 字符串比较(名, "栈") ||
          字符串比较(名, "队列") || 字符串比较(名, "集合");
}

// 是容器类类型：$ 合成名 且 基名 ∈ 白名单（向量$整64；裸名"向量"非实例）
函数 是容器类(字符串 名) -> 布尔 {
    如果 (首分段位置(名) < 0) { 返回 假; }
    返回 是容器基名(合成名基名(名));
}

// 是结果类型：基名=结果/可选（结果$空类型$整32）
函数 是结果类型(字符串 名) -> 布尔 {
    如果 (首分段位置(名) < 0) { 返回 假; }
    字符串 基名 = 合成名基名(名);
    返回 字符串比较(基名, "结果") || 字符串比较(基名, "可选");
}

// ==================== 对象大小表（NewObject 分配字节数） ====================
// 对标宿主 computeClassLayout 按 stdlib 字段布局（指针/整64 各 8 字节）。
//   ⚠ 维护契约：stdlib 容器.cn/映射集合.cn 字段变更须同步本表。
函数 容器对象大小(字符串 合成名) -> 整64 {
    字符串 基名 = 合成名基名(合成名);
    如果 (字符串比较(基名, "向量")) { 返回 24; }   // T*数据+元素数量+数组容量
    如果 (字符串比较(基名, "链表")) { 返回 48; }   // 值表+下一索引+值容量+头+尾+元素数量
    如果 (字符串比较(基名, "栈")) { 返回 24; }     // 数据+元素数量+数组容量
    如果 (字符串比较(基名, "队列")) { 返回 48; }   // 值表+下一索引+值容量+头+尾+元素数量
    如果 (字符串比较(基名, "映射")) { 返回 56; }   // 键+值+链+桶四数组+桶数量+元素数量+数组容量
    如果 (字符串比较(基名, "集合")) { 返回 24; }   // 数据数组+元素数量+数组容量
    返回 8;
}

// ==================== 方法签名表 ====================
// 查表：类$合成名 + 方法名 + 实参数 → 参数类型串（T/K/V 已替换实例文本，
//   逗号连接——对标宿主 signatureKey）与返回形态。出参 值偏移=结果<T,E>.值
//   字节偏移（整32→4；整64/字符串/指针→8）。返回 假=方法未收录。
结构体 方法签名 {
    字符串 参数串;
    整64 返回形态;
    整64 值偏移;
    字符串 返回文本;    // ②b B5：替换后返回类型文本（链式成员 偏移/宽度 收口 + retbuf 尺寸用）
}

// 结果<T,E> 的 值 字节偏移：T=整32 -> 4（正常@0+联合@4）；其余（整64/字符串/指针）-> 8
函数 结果值偏移(字符串 值类型) -> 整64 {
    如果 (字符串比较(值类型, "整32")) { 返回 4; }
    如果 (字符串比较(值类型, "正32")) { 返回 4; }
    返回 8;
}

// 查方法签名（用户裁决项1：签名表查询 + 类型参数替换，替代硬编码 if 链——
//   stdlib 改签名/加方法 v2 自动跟随）。返回形态按替换后的返回类型通用判定：
//   结果$T$E -> 结果空（T=空类型）/结果值（+值偏移）；空类型 -> 无返回；
//   容器 $ 合成名 -> 容器返回_结构体（②c A：元素(i) 返回容器——宿主 typeSizeOf>8
//   隐藏返回指针拷贝对象字段，rax=缓冲地址即对象形基址，链式 .设置/.获取 this=此）；
//   其余 -> 标量（结构体返回亦走 结构体 形态）。未收录（表无此键）返回 假（调用方诊断）。
函数 查方法签名(字符串 合成名, 字符串 方法名, 整64 实参数, 方法签名* 出) -> 布尔 {
    字符串 基名 = 合成名基名(合成名);
    确保签名已加载();
    整64 键ID = 驻留(基名 + "." + 方法名 + "." + 整数转字符串(实参数));
    整64 查参 = 查签名参数串(键ID);
    整64 查返 = 查签名返回(键ID);
    如果 (查参 >= 0) {
        如果 (查返 >= 0) {
            // ②c A：实参替换改按元数切分的实参列表（朴素 '$' 切分对嵌套实参错）；
            //   类型参数序串经 类类型参数们 查取（基名 -> "T"/"K,V"）
            向量<字符串> 实参们 = 取实例实参们(合成名);
            字符串 序串 = "";
            整64 查序 = 查类类型参数(驻留(基名));
            如果 (查序 >= 0) { 序串 = 字符串复制(驻留文本(查序)); }
            // A2（2026-09-11 方案甲）：局部拥有串（归一结果名/替换 返回类型=字符串
            //   契约→登记 RAII→函数退出 free）存入结构体字段须显式复制——原浅存
            //   =字段悬垂（自举第二代实测：签.返回文本 悬垂→解析调用返回结构体
            //   驻留(垃圾)→结构体大小 0→45 个「成员字段偏移未知」；第一代堆未
            //   复用侥幸绿。「字符串入结构体须显式复制」纪律——容器 move 语义
            //   随后续批次）。
            出.参数串 = 字符串复制(替换类型参数带段们(驻留文本(查参), 序串, 实参们));
            字符串 返回文本 = 归一结果名(替换类型参数带段们(驻留文本(查返), 序串, 实参们));
            出.返回文本 = 字符串复制(返回文本);
            如果 (是结果类型(返回文本)) {
                字符串 值类型 = 段首(合成名首实参(返回文本));
                如果 (字符串比较(值类型, "空类型")) {
                    出.返回形态 = 容器返回_结果空;
                } 否则 {
                    出.返回形态 = 容器返回_结果值;
                    出.值偏移 = 结果值偏移(值类型);
                }
            } 否则 如果 (字符串比较(返回文本, "空类型")) {
                出.返回形态 = 容器返回_空类型;
            } 否则 {
                // ②b B2：T 为结构体 -> 隐藏返回指针形态（元素(位置)->T 按值返回 sret，
                //   链式 .字段 经 retbuf 基址访问）。T 为容器（类）不在结构体大小表 ->
                //   标量（ptr）：类元素 8 字节指针步长存储、rax 返回元素句柄。
                //   第 14 枚根治（2026-09-06，v2self 第 7 层）：「含容器字段的结构体 ->
                //   标量」旧判定撤销——它是 E2E 127 时代「供给.cn 类形态供给」的专属
                //   契约（主.cn 结构体声明 × 供给类实现 = 同名双 ABI），与宿主真语义
                //   分叉：宿主对 向量<词条>.元素(0)（词条=含容器字段结构体）发射
                //   rdi=retbuf/rsi=this/rdx=位置 三装载 sret（127 直编 asm 实证+
                //   运行 exit=0；v2p_rt 同款）。v2 旧判定发射 rdi=this/rsi=实参 ->
                //   this/实参整体错位（v2self 崩于 程序.函数们.元素(f)：this=0、
                //   位置=残留 0xffffffff -> 运行时错误3）。Rust 对齐：类型即布局、
                //   布局即 ABI——同名类型禁止双 ABI；大对象按值返回=sret 与
                //   Rust/LLVM codegen 一致，零额外开销。127 供给契约同步修
                //（供给.cn 词条 类->结构体，与本处配套消灭双 ABI）。
                整64 返回ID = 驻留(返回文本);
                如果 (查结构体大小(返回ID) != 0) {
                    出.返回形态 = 容器返回_结构体;
                } 否则 {
                    出.返回形态 = 容器返回_标量;
                }
            }
            返回 真;
        }
    }
    返回 假;
}

// 返回形态字节数（②b B6：retbuf 区按真实返回尺寸定帧——旧固定 2 槽=16 字节
//   对 ≥17 字节结构体返回越界踩顶变量槽，126 节点=24 字节实测踩中）。
//   结果空 12 / 结果值 结果大小 / 结构体 查结构体大小（②c A：容器返回=容器对象大小）；
//   标量/空类型 0=无 retbuf。
函数 签名返回字节数(方法签名* 签) -> 整64 {
    如果 (签.返回形态 == 容器返回_结果空) { 返回 12; }
    如果 (签.返回形态 == 容器返回_结果值) { 返回 结果大小(签.返回文本); }
    如果 (签.返回形态 == 容器返回_结构体) {
        如果 (是容器类(签.返回文本)) { 返回 容器对象大小(签.返回文本); }
        返回 查结构体大小(驻留(签.返回文本));
    }
    返回 0;
}

// 发射调用实参装载（参数区模式，用户裁决项3）：弹出们 为倒序（元素0=最后实参），
//   实参 j（0 起，第 j+1 个）位号=起始位+j，寄存器=弹出们[个数-1-j]。
//   IR_调用实参 为声明性指令（代码生成在 IR_调用参数化 统一展开装载）。
函数 发射调用实参们(向量<整64> 弹出们, 整64 起始位, 向量<IR指令>& 指令) -> 空类型 {
    整64 n = 弹出们.大小();
    整64 j = 0;
    当 (j < n) {
        IR追加(指令, 建IR指令(IR_调用实参, 弹出们.元素(n - 1 - j), 0, 0, 0, 起始位 + j, 0));
        j++;
    }
}

// ==================== 容器声明预扫与 RAII（P7b） ====================
// ②c B：含容器字段结构体局部 [起, 止) 的字段逆序级联析构（指针槽模型：取基槽地址
//   -> 字段地址 -> 指针加载 -> DeleteObject——空安全，裸声明零初始化保证跳过）。
//   局部逆序 + 字段逆序（后声明先释放）。局部声明在 生成语句 B1 分支登记。
不安全 函数 发射容器字段析构(函数IR& 函数信息, 映射<整64, 整64>& 局部槽, 整64* 寄存器计数,
                       整64 起, 整64 止, 整64 跳过名ID) -> 空类型 {
    整64 i = 止;
    当 (i > 起) {
        i--;
        整64 名ID = 函数信息.容器字段局部们.元素(i);
        // 2026-09-06 根治（T6 自举首踩）：返回语句所有权转移——被返回的含容器
        //   字段局部跳过析构（返回值已浅拷入 retbuf 共享堆指针，再析构=悬垂）
        如果 (名ID == 跳过名ID) { 继续; }
        整64 结构体ID = 函数信息.容器字段结构体们.元素(i);
        整64 槽 = 0;
        结果<整64, 整32> 找槽 = 局部槽.获取(名ID);
        如果 (找槽.正常) { 槽 = 找槽.值; }
        如果 (槽 != 0) {
            向量<整64> 字段们 = 向量<整64>();
            取容器字段们(结构体ID, 字段们);
            整64 f = 字段们.大小();
            当 (f > 0) {
                f -= 3;
                整64 字段类型ID = 字段们.元素(f + 1);
                整64 偏移 = 字段们.元素(f + 2);
                // 73-a：字段地址另存 地址reg（加载会把值寄存器指向对象，清零
                //   须回写字段槽本身）——释放+清零幂等模型（跳出释放不截断
                //   名单时，函数级兜底再次遍历到此字段读 0 空安全跳过）
                整64 地址reg = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(函数信息.指令, 建IR指令(IR_取地址, 槽, 0, 0, 地址reg, T_整64, 0));
                IR追加(函数信息.指令, 建IR指令(IR_字段地址, 地址reg, 0, 0, 地址reg, T_整64, 偏移));
                整64 基址reg = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(函数信息.指令, 建IR指令(IR_指针加载, 地址reg, 0, 0, 基址reg, T_对象, 0));
                IR追加(函数信息.指令, 建IR指令(IR_删除对象, 基址reg, 0, 0,
                                                     寄存器计数[0], 0, 字段类型ID));
                寄存器计数[0] = 寄存器计数[0] + 1;
                如果 (函数信息.零寄存器 != 0) {
                    IR追加(函数信息.指令, 建IR指令(IR_指针存储, 地址reg,
                                         函数信息.零寄存器, 0, 0, T_整64, 0));
                }
            }
        }
    }
}

// 块级作用域出口析构（用户裁决项2，生成块 调用）：对 容器变量们 在 基线 之后
//   新增的容器（本块声明的，逆序）发 RAII 析构并截断列表——块结束即释放；
//   ②c B：含容器字段结构体局部同款（字段基线 截断）。
//   plans/019 阶段4' 第二批：字符串基线同款——本块新增的拥有型字符串逆序
//   __cn_str_free 并截断（污染名跳过；块结束即释放——Rust 作用域 drop）。
// 73-a（2026-09-11 方案A 用户裁决）：新增 截断 参数——块出口（生成块）传 真
//   （释放并截断名单，保证外层块基线机制正确）；循环跳出 drop-on-jump 传 假
//   （同一块内的其他路径仍须发射自己的释放指令：如循环体内「如果{中断}」的
//   中断路径与自然结束路径互斥，若跳出时就截断名单，自然结束路径的块出口
//   析构将无变量可释放=该路径泄漏）。不截断模式下遍历用下标递减（不以名单
//   长度作循环条件，避免死循环）。
不安全 函数 块出口析构(函数IR& 函数信息, 映射<整64, 整64>& 局部槽, 整64* 寄存器计数,
                整64 作用域基线, 整64 字段基线, 整64 字符串基线, 布尔 截断) -> 空类型 {
    整64 串i = 函数信息.字符串变量们.大小();
    当 (串i > 字符串基线) {
        串i--;
        整64 串名ID = 函数信息.字符串变量们.元素(串i);
        结果<整64, 整32> 查污出 = 函数信息.字符串污染们.获取(串名ID);
        如果 (!查污出.正常 && !是已装箱名(串名ID)) {   // 71-a：装箱=move 转交跳过
            整64 串槽 = 0;
            结果<整64, 整32> 找串槽 = 局部槽.获取(串名ID);
            如果 (找串槽.正常) { 串槽 = 找串槽.值; } 否则 { 串槽 = 0; }
            如果 (串槽 != 0) {
                整64 串ptr = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(函数信息.指令, 建IR指令(IR_加载, 串槽, 0, 0, 串ptr, T_字符串, 0));
                IR追加(函数信息.指令, 建IR指令(IR_调用实参, 串ptr, 0, 0, 0, 0, 0));
                IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                     驻留("__cn_str_free")));
                // 73-a（幂等模型，宿主 72-a 同款）：释放后槽清零——块出口/跳出/
                //   函数级兜底多路径共享槽，清零后 __cn_str_free(nullptr) 空安全，
                //   重复经过的释放点不再二次释放（探针：容器跳出形态未清零时
                //   跳出释放 + 函数级兜底 = double free SIGSEGV 实证）
                如果 (函数信息.零寄存器 != 0) {
                    IR追加(函数信息.指令, 建IR指令(IR_存储, 函数信息.零寄存器, 0, 0,
                                         0, 0, 串槽));
                }
            }
        }
        如果 (截断) {
            结果<空类型, 整32> 删串 = 函数信息.字符串变量们.删除(
                函数信息.字符串变量们.大小() - 1);
            如果 (!删串.正常) { 运行时错误(4); }
        }
    }
    整64 容i = 函数信息.容器变量们.大小();
    当 (容i > 作用域基线) {
        容i--;
        整64 名ID = 函数信息.容器变量们.元素(容i);
        整64 槽 = 0;
        结果<整64, 整32> 找槽 = 局部槽.获取(名ID);
        如果 (找槽.正常) { 槽 = 找槽.值; }
        如果 (槽 != 0 && !是已装箱名(名ID)) {   // 71-a：装箱=move 转交跳过
            结果<整64, 整32> 查类型 = 函数信息.变量类型.获取(名ID);
            如果 (查类型.正常) {
                整64 ptr寄存器 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(函数信息.指令, 建IR指令(IR_加载, 槽, 0, 0, ptr寄存器, T_对象, 0));
                IR追加(函数信息.指令, 建IR指令(IR_删除对象, ptr寄存器, 0, 0,
                                                     寄存器计数[0], 0, 查类型.值));
                寄存器计数[0] = 寄存器计数[0] + 1;
                // 73-a（幂等模型）：释放后槽清零（IR_删除对象 空安全——
                //   代码生成 test/je 跳过；多释放点共享槽不再二次释放）
                如果 (函数信息.零寄存器 != 0) {
                    IR追加(函数信息.指令, 建IR指令(IR_存储, 函数信息.零寄存器, 0, 0,
                                         0, 0, 槽));
                }
            }
        }
        如果 (截断) {
            结果<空类型, 整32> 删容 = 函数信息.容器变量们.删除(
                函数信息.容器变量们.大小() - 1);
            如果 (!删容.正常) { 运行时错误(4); }
        }
    }
    如果 (函数信息.容器字段局部们.大小() > 字段基线) {
        发射容器字段析构(函数信息, 局部槽, 寄存器计数, 字段基线,
                          函数信息.容器字段局部们.大小(), 0);
        // 截断两条跟踪列表至基线（跳出模式不截断——同块其他路径仍须发射释放）
        如果 (截断) {
            当 (函数信息.容器字段局部们.大小() > 字段基线) {
                结果<空类型, 整32> 删局 = 函数信息.容器字段局部们.删除(
                    函数信息.容器字段局部们.大小() - 1);
                如果 (!删局.正常) { 运行时错误(4); }
                结果<空类型, 整32> 删构 = 函数信息.容器字段结构体们.删除(
                    函数信息.容器字段结构体们.大小() - 1);
                如果 (!删构.正常) { 运行时错误(4); }
            }
        }
    }
}

// 73-a（2026-09-11 方案A 用户裁决）：循环跳出（中断/继续）drop-on-jump——
//   按最近循环体的三个基线（生成当 进入体块前记录）释放本轮已声明资源，
//   编译期名单**不截断**。与宿主 72-a genJumpDestructFrom(stringBase, classBase)
//   同构（Rust：break/continue 前 drop 当前作用域内已初始化值）。
不安全 函数 循环跳出析构(函数IR& 函数信息, 映射<整64, 整64>& 局部槽,
                  整64* 寄存器计数) -> 空类型 {
    块出口析构(函数信息, 局部槽, 寄存器计数,
               函数信息.循环容基线, 函数信息.循环字段基线, 函数信息.循环串基线, 假);
}

// 释放名单追加去重（73-a）：生成期登记可能与已有项同名（v2 局部槽为函数级
//   映射，同名变量合槽；预扫 已有 判定同款）——重复登记会导致同名多次释放。
函数 名单追加去重(向量<整64>& 名单, 整64 名ID) -> 空类型 {
    整64 i = 0;
    当 (i < 名单.大小()) {
        如果 (名单.元素(i) == 名ID) { 返回; }
        i++;
    }
    结果<空类型, 整32> 加 = 名单.追加(名ID);
    如果 (!加.正常) { 运行时错误(4); }
}

// 预扫容器声明：函数体块区间一次线性扫描（嵌套块/条件体语句节点均含于函数体块
//   子区间——节点池顺序追加，体块节点最后入池），为全部容器变量：分配槽 +
//   入口零初始化（未执行声明路径的槽=确定性空指针，DeleteObject 空安全跳过）+
//   登记 变量类型/容器变量们。注：同名变量（不同块）合并同槽（v2 局部槽为
//   函数级映射——精确块级作用域析构留 P7c）。
不安全 函数 预扫容器声明(向量<节点> 池, 整32 块节点, 函数IR& 函数信息,
                  整64* 槽计数, 整64* 寄存器计数) -> 空类型 {
    整64 零寄存器 = 0;
    节点 块 = 池.元素(块节点);
    整64 i = 整64(块.子起点);
    当 (i < 整64(块.子终点)) {
        节点 声明 = 池.元素(整32(i));
        如果 (声明.类型 == 节点_变量声明) {
            节点 类型节点 = 池.元素(整32(声明.附加));
            字符串 类型文本 = 字符串复制(驻留文本(整64(类型节点.文本)));
            // 引用局部（2026-09-04 IR生成.cn 冒烟根治）：绑定不拥有——槽分配/
            //   绑定存储/引用槽登记由 生成语句 引用分支自管；此处若入 RAII 名单
            //   =返回前对绑定对象（字段地址当 this）双重析构（E2E 147 探针
            //   0xC0000374 堆损坏实证）。
            如果 (是容器类(类型文本) && 类型节点.附加 != 256) {
                结果<整64, 整32> 已有 = 函数信息.局部槽.获取(整64(声明.文本));
                如果 (!已有.正常) {
                    整64 槽 = 槽计数[0];
                    槽计数[0] = 槽计数[0] + 1;
                    结果<空类型, 整32> 设槽 = 函数信息.局部槽.设置(整64(声明.文本), 槽);
                    如果 (!设槽.正常) { 运行时错误(4); }
                    IR追加(函数信息.指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽));
                    // 入口零初始化（共享一个零寄存器）
                    如果 (零寄存器 == 0) {
                        零寄存器 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(函数信息.指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0,
                                             零寄存器, T_整64, 0));
                    }
                    IR追加(函数信息.指令, 建IR指令(IR_存储, 零寄存器, 0, 0, 0, 0, 槽));
                    结果<空类型, 整32> 设类型 = 函数信息.变量类型.设置(整64(声明.文本),
                                                              整64(类型节点.文本));
                    如果 (!设类型.正常) { 运行时错误(4); }
                    // ②c D：函数级变量类型权威表（跨函数同名异型根治）
                    登记当前函数变量类型(整64(声明.文本), 整64(类型节点.文本));
                    // 2026-09-06 根治（宿主对齐·视图语义）：初值末节点=调用且非构造
                    //   调用（返回接收）→ 不入 RAII 名单。宿主实证（vieww/retown 探针
                    //   asm）：接收 rax 直用——元素(i) 返回向量内联元素地址（视图共享
                    //   写可见）、函数返回新对象（转移）——接收方一律不析构；原「接收
                    //   转移=本槽拥有」假设对元素(i) 形态=对向量内部元素 DeleteObject
                    //   →double free/堆坏（vcopy 探针 SIGSEGV 实证=v2self 符号表崩溃
                    //   同根因）。槽保留（读取/传参用，出口零值空安全）。
                    // 73-a（2026-09-11 方案A 用户裁决）：**名单登记移至生成期**——
                    //   预扫是函数级一次性扫描、先于函数体生成，若在预扫登记则 生成块
                    //   入口取基线时名单已含本块变量、基线恒等于名单大小，块出口析构
                    //   永远无新增项可释放=v2 块级 RAII 从未生效（探针 89：20 万轮
                    //   循环体拥有串残留 199999 实证）。预扫职责自此收敛为槽分配 +
                    //   入口零初始化 + 类型登记；释放名单随生成顺序追加（生成容器
                    //   局部 非返回接收分支），基线机制方能生效（Rust 作用域 drop）。
                }
            }
            // plans/019 阶段4' 第二批（2026-09-11 方案A 用户裁决）：拥有型字符串局部
            //   预扫**判定**——与容器同模型：槽预分配（生成变量声明 复用）+ 入口零初始化
            //   （未执行声明路径的槽=确定性 0，__cn_str_free 空安全跳过）+ 白名单判定
            //   （宿主第一批同构）：无初值/字面量/标识符=拥有登记；调用=内置分配族八
            //   函数（复制/连接/拼接/子串/大写/小写/修剪/反转——返回恒堆）才登记，
            //   其余调用（驻留文本/用户函数——可能返回借用包装）与下标/成员等形态
            //   一律不登记（借用保守，宁可不自动释放保安全——单 字符串 类型静态
            //   无法区分拥有/借用返回）。登记后由 生成变量声明 拥有化初始化 +
            //   生成赋值语句 拥有化赋值/污染传播 + 发射字符串释放/块出口析构 释放。
            //   引用形态（附加==256）不入（绑定不拥有）。
            //   73-a（2026-09-11 方案A 用户裁决）：**名单登记**（字符串变量们.追加）
            //   移至生成期（生成变量声明 拥有化初始化后）——预扫只判定「是否预分配
            //   槽」；预扫登记会使块出口析构基线机制失效（预扫先于函数体生成）。
            如果 (整64(类型节点.文本) == 驻留("字符串") && 类型节点.附加 != 256) {
                结果<整64, 整32> 已有串 = 函数信息.局部槽.获取(整64(声明.文本));
                如果 (!已有串.正常) {
                    布尔 拥有初值 = 真;
                    如果 (声明.子起点 < 声明.子终点) {
                        节点 初末s = 池.元素(声明.子终点 - 1);
                        如果 (初末s.类型 == 节点_调用) {
                            // 调用初值：白名单八函数 ∪ 返回类型契约（A2 2026-09-11
                            //   方案甲）：被调者返回 字符串=拥有（内置表/签名表按纯名
                            //   查——重载族返回异型为诚实边界，对齐宿主首候选口径）；
                            //   驻留文本 已改 字符* 返回=借用不登记。
                            布尔 是白名单 = 假;
                            如果 (初末s.子起点 >= 0) {
                                节点 被调s = 池.元素(整32(初末s.子起点));
                                如果 (被调s.类型 == 节点_标识符) {
                                    整64 被调名s = 整64(被调s.文本);
                                    是白名单 = 被调名s == 驻留("字符串复制") ||
                                         被调名s == 驻留("字符串连接") ||
                                         被调名s == 驻留("字符串拼接") ||
                                         被调名s == 驻留("字符串子串") ||
                                         被调名s == 驻留("字符串大写") ||
                                         被调名s == 驻留("字符串小写") ||
                                         被调名s == 驻留("字符串修剪") ||
                                         被调名s == 驻留("字符串反转");
                                            如果 (!是白名单) {
                                        // 72-a（2026-09-11 第七十二轮）：键基回退版
                                        //   （纯名查跨模块 miss=契约失效，宿主同族根治）
                                        整64 查返s = 查函数返回回退(被调名s);
                                        如果 (查返s == 驻留("字符串")) { 是白名单 = 真; }
                                    }
                                }
                            }
                            拥有初值 = 是白名单;
                        } 否则 如果 (初末s.类型 == 节点_下标 ||
                                    初末s.类型 == 节点_成员 ||
                                    初末s.类型 == 节点_解引用) {
                            // 下标/成员/解引用初值=借用（元素借出/字段视图/指针指向）
                            //   ——宿主初始化位此形态未污染（潜在缺口，v2 侧保守不登记）
                            拥有初值 = 假;
                        }
                    }
                    如果 (拥有初值) {
                        整64 槽s = 槽计数[0];
                        槽计数[0] = 槽计数[0] + 1;
                        结果<空类型, 整32> 设槽s = 函数信息.局部槽.设置(整64(声明.文本), 槽s);
                        如果 (!设槽s.正常) { 运行时错误(4); }
                        IR追加(函数信息.指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽s));
                        // 入口零初始化（与容器共用 零寄存器）
                        如果 (零寄存器 == 0) {
                            零寄存器 = 寄存器计数[0];
                            寄存器计数[0] = 寄存器计数[0] + 1;
                            IR追加(函数信息.指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0,
                                                 零寄存器, T_整64, 0));
                        }
                        IR追加(函数信息.指令, 建IR指令(IR_存储, 零寄存器, 0, 0, 0, 0, 槽s));
                        // 73-a（2026-09-11 方案A 用户裁决）：名单登记移至生成期
                        //   （生成变量声明 拥有化初始化后）——预扫登记会使 生成块
                        //   基线机制失效（详见 预扫容器声明 头部说明）
                    }
                }
            }
        }
        i++;
    }
    // 73-a：零寄存器回填——释放点清零槽复用（指令已在函数入口发射，运行期
    //   任何释放点路径均已执行过它）；无资源声明时保持 0（无释放点，无需清零）
    函数信息.零寄存器 = 零寄存器;
}

// 发射容器析构（RAII）：对本函数全部容器局部 Load 槽 + IR_删除对象。
//   代码生成展开：test/je 空安全 + call ~类(this) + call __cn_object_delete(this)。
//   ②c B：含容器字段结构体局部随后按字段逆序级联析构（发射容器字段析构 全量）。
不安全 函数 发射容器析构(函数IR& 函数信息, 向量<IR指令>& 指令, 整64* 寄存器计数,
                  映射<整64, 整64>& 局部槽, 整64 跳过名ID) -> 空类型 {
    整64 i = 0;
    当 (i < 函数信息.容器变量们.大小()) {
        整64 名ID = 函数信息.容器变量们.元素(i);
        // 2026-09-06 根治：返回语句所有权转移——被返回的容器局部跳过析构
        // 71-a：装箱（正常/某些(容器局部)）=move 转交，同跳过
        如果 (名ID == 跳过名ID || 是已装箱名(名ID)) { i++; 继续; }
        整64 槽 = 0;
        结果<整64, 整32> 找槽 = 局部槽.获取(名ID);
        如果 (找槽.正常) { 槽 = 找槽.值; }
        如果 (槽 != 0) {
            结果<整64, 整32> 查类型 = 函数信息.变量类型.获取(名ID);
            如果 (查类型.正常) {
                整64 ptr寄存器 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                // 目标=标签唯一序号（代码生成 objdel_函数序号_目标 拼标签——
                //   多容器变量同函数多条删除指令，序号须唯一否则 MASM A2005）
                IR追加(指令, 建IR指令(IR_加载, 槽, 0, 0, ptr寄存器, T_对象, 0));
                IR追加(指令, 建IR指令(IR_删除对象, ptr寄存器, 0, 0, 寄存器计数[0], 0, 查类型.值));
                寄存器计数[0] = 寄存器计数[0] + 1;
            }
        }
        i++;
    }
    // ②c B：含容器字段结构体局部（全部——返回语句跨块跳出兜底，全量逆序）
    发射容器字段析构(函数信息, 局部槽, 寄存器计数, 0, 函数信息.容器字段局部们.大小(), 跳过名ID);
}

// plans/019 阶段4' 第二批（2026-09-11 方案A 用户裁决）：拥有型字符串 RAII——
//   与 发射容器析构 同模型：对 字符串变量们 名单（预扫白名单判定后）注入
//   __cn_str_free 直调（IR_调用实参+IR_调用参数化 两指令形态——__cn_str_concat
//   先例；代码生成 __cn_ 前缀直通；空安全：__cn_str_free(nullptr) 安全跳过）；
//   污染名（字符串污染们——非拥有赋值/下标借出）与跳过名（返回标识符=所有权
//   移出，与容器析构跳过同构）一律跳过。
不安全 函数 发射字符串释放(函数IR& 函数信息, 向量<IR指令>& 指令, 整64* 寄存器计数,
                  映射<整64, 整64>& 局部槽, 整64 跳过名ID) -> 空类型 {
    整64 i = 0;
    当 (i < 函数信息.字符串变量们.大小()) {
        整64 名ID = 函数信息.字符串变量们.元素(i);
        如果 (名ID == 跳过名ID || 是已装箱名(名ID)) { i++; 继续; }   // 71-a：装箱=move 转交跳过
        结果<整64, 整32> 查污 = 函数信息.字符串污染们.获取(名ID);
        如果 (查污.正常) { i++; 继续; } 否则 { }
        整64 槽 = 0;
        结果<整64, 整32> 找槽 = 局部槽.获取(名ID);
        如果 (找槽.正常) { 槽 = 找槽.值; } 否则 { 槽 = 0; }
        如果 (槽 != 0) {
            整64 ptr寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 槽, 0, 0, ptr寄存器, T_字符串, 0));
            IR追加(指令, 建IR指令(IR_调用实参, ptr寄存器, 0, 0, 0, 0, 0));
            IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                 驻留("__cn_str_free")));
        }
        i++;
    }
}

// ==================== 指令追加辅助 ====================
// 引用传递：按值传 向量 会共享数据指针，.追加 扩容释放旧数组 -> 调用方向量悬垂。
函数 IR追加(向量<IR指令>& 列表, IR指令 指令) -> 空类型 {
    结果<空类型, 整32> 加 = 列表.追加(指令);
    如果 (!加.正常) { 运行时错误(4); }
}
函数 建IR指令(整64 操作码, 整64 操作数1, 整64 操作数2, 整64 操作数3,
              整64 目标, 整64 类型, 整64 附加) -> IR指令 {
    IR指令 指令;
    指令.操作码 = 操作码;
    指令.操作数1 = 操作数1;
    指令.操作数2 = 操作数2;
    指令.操作数3 = 操作数3;
    指令.目标 = 目标;
    指令.类型 = 类型;
    指令.附加 = 附加;
    返回 指令;
}

// ==================== 类型名 -> IR 类型码 ====================
// 源码类型名（驻留文本）-> IR 类型码（T_*）。未知返回 T_未知。
函数 类型码(整64 类型名ID) -> 整64 {
    字符串 名 = 字符串复制(驻留文本(类型名ID));
    // CN 字符串 == 是指针比较（非内容）——须用 字符串比较
    如果 (字符串比较(名, "整32")) { 返回 T_整32; }
    如果 (字符串比较(名, "整64")) { 返回 T_整64; }
    如果 (字符串比较(名, "浮32")) { 返回 T_浮32; }
    如果 (字符串比较(名, "浮64")) { 返回 T_浮64; }
    如果 (字符串比较(名, "布尔")) { 返回 T_布尔; }
    如果 (字符串比较(名, "字符串")) { 返回 T_字符串; }
    如果 (字符串比较(名, "空类型")) { 返回 T_空类型; }
    // 46-f 无符号语义轮（2026-09-10 第五十轮）：正32/正64 独立类型码（原与
    //   整64 同码归并，运算层无从分派无符号）——寄存器类型登记/二元指令
    //   类型字段经此传播，三后端按码分派 div/shr/setb 族无符号指令
    如果 (字符串比较(名, "正32")) { 返回 T_正32; }
    如果 (字符串比较(名, "正64")) { 返回 T_正64; }
    如果 (字符串比较(名, "整8") || 字符串比较(名, "整16") ||
        字符串比较(名, "正8") || 字符串比较(名, "正16") ||
        字符串比较(名, "字符") || 字符串比较(名, "指针") ||
        字符串比较(名, "自动")) { 返回 T_整64; }
    // A2：字符* 借用视图=指针单槽，与 字符串 同码（打印/拼接按字符串消费；
    //   区别只在拥有性——语义层判定，类型码层等价）
    如果 (字符串比较(名, "字符*")) { 返回 T_字符串; }
    返回 T_未知;
}


// ==================== 跨子模块访问函数（千行拆分，2026-09-08） ====================
//   生成表达式/生成语句/生成函数/语义检查 子模块经下列函数访问
//   静态表/签名表（静态表=文件级私有，跨文件仅函数可见）
函数 查静态序号(整64 名ID) -> 整64 {
    结果<整64, 整32> 查 = 静态序号们.获取(名ID);
    如果 (查.正常) { 返回 查.值; }
    返回 0 - 1;
}

函数 取静态数() -> 整64 {
    返回 静态名们.大小();
}

函数 取静态类型(整64 序) -> 整64 {
    返回 静态类型们.元素(序);
}

函数 查函数签名个数(整64 键基) -> 整64 {
    结果<整64, 整32> 查 = 函数签名个数们.获取(键基);
    如果 (查.正常) { 返回 查.值; }
    返回 0 - 1;
}

函数 查函数签名参数串(整64 键) -> 整64 {
    结果<整64, 整32> 查 = 函数签名参数串们.获取(键);
    如果 (查.正常) { 返回 查.值; }
    返回 0 - 1;
}
