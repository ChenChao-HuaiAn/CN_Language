// CN 自举编译器 v2：容器类型 IR 辅助（自举重建 P7b，2026-09-01）
// 容器类型（向量/映射/链表/栈/队列/集合/结果）类型判定、对象大小表、
// 方法签名表——IR生成.cn 的容器实例化/方法调用据此合成宿主对齐符号
// （类$方法#参数串 → nameMangle，实现链接宿主编译 obj，rustc 预编译 std 模式）。
// 契约对标：宿主 generics.cpp（实例名 类名$实参 扁平 $ 连接）、semantic.cpp
//   signatureKey（方法名#参数类型1,参数类型2）、stdlib 容器.cn/映射集合.cn
//   （方法签名与字段布局）。
// 依赖说明：IR_* 操作码/T_* 类型码/常量表 由 IR常量.cn 定义（簇① A2 单一归属）；
//   IR 指令/函数 IR 数据结构（IR指令/函数IR 结构体）自 呈报①A 根治（2026-09-05）
//   起定义在本模块（见下）——原定义在 IR生成.cn 顶层，而本模块引用它 + IR生成
//   导入本模块 = 反向引用不可导；主链靠多文件合并全局可见掩盖，冒烟子链
//   （IR容器/语法分析/语义分析 入口——链上无 IR生成.cn）结构体登记缺失 ->
//   解析方法对象类型 查结构体大小 miss = 「方法调用的对象类型未知」误诊
//   （冒烟 asm 断供；曾误归因 IR常量.cn 新增常量对，实为登记源结构性缺失）。
导入 容器::向量;
导入 映射集合;
导入 IR;         // 签名辅助 + 节点_*/T_*/IR_*/键位移/当前函数变量类型（原 IR签名+IR常量 合并目录包名）

公开:

// ==================== IR 数据结构（呈报①A 下沉，2026-09-05） ====================
// IR指令/函数IR 自 IR生成.cn 下沉至本模块：本模块（IR追加/建IR指令/发射容器
//   析构族）与其全部引用方（IR生成/代码生成/代码生成ARM64/代码生成共用/主）
//   的导入链均含本模块——登记源（语法分析 解析结构体声明 -> 登记结构体布局）
//   在任意冒烟子链上恒可达。程序IR 仍留 IR生成.cn（引用方链上恒含 IR生成）。
结构体 IR指令 {
    整64 操作码;
    整64 操作数1;
    整64 操作数2;
    整64 操作数3;
    整64 目标;
    整64 类型;
    整64 附加;
}

// ==================== 函数 IR ====================
// 每个函数：指令数组 + 局部槽表（名ID -> 槽索引）+ 参数槽表 + 返回类型码。
结构体 函数IR {
    向量<IR指令> 指令;
    映射<整64, 整64> 局部槽;
    映射<整64, 整64> 参数槽;
    整64 返回类型;
    整64 返回结构体ID;  // 用户函数返回结构体（2026-09-04，E2E 148）：非 0=返回
                        //   类型为该结构体——宿主 ABI 走隐藏 retbuf（位0 传入、
                        //   rax 返回）；被调方槽 1=retbuf 指针（调用方帧尾缓冲）
    整64 返回引用;      // 引用返回（2026-09-04 缺陷零容忍收口，宿主 P3-18 对齐）：
                        //   1=返回类型尾 '&'（-> 整64&）——返回语句发射被引用
                        //   左值地址（生成左值地址），调用方经指针加载读/指针
                        //   存储写（赋值目标/复合赋值）/直接绑定（引用初始化）
    整64 返回结果名ID;  // 71-a（2026-09-11 方案A 用户裁决）：返回类型为 结果/可选
                        //   合成名（结果$字符串$整32）的名ID——非 0=结果返回，与
                        //   返回结构体ID 同款 retbuf ABI（槽 1=retbuf 指针、位 0
                        //   装载、rax=retbuf；结果大小=结果大小(合成名)——结构体
                        //   表查不到 0，故独立字段不复用 ID）
    整32 名字;
    整64 块计数;        // P6b：块编号计数器（标签随建随取，嵌套安全）
    整64 当前块;        // P6b：当前块 ID（跳转目标；初始 0=函数入口块）
    整64 循环出口块;    // P6b：最近 当/循环 出口块（中断 跳转目标；0=无）
    整64 循环继续块;    // P6b：最近 当/循环 继续块（继续 跳转目标；0=无）
    整64 循环串基线;    // 73-a（2026-09-11 方案A 用户裁决）：进入最近循环体前的
                        //   字符串变量们 基线——中断/继续 跳出 drop-on-jump 的
                        //   释放范围起点（生成当 保存/恢复，嵌套循环自然正确）
    整64 循环容基线;    // 73-a：容器变量们 基线（同上）
    整64 循环字段基线;  // 73-a：资源字段局部们 基线（同上）
    整64 函数尾块;      // 缺陷A根治（2026-09-02）：函数尾块——IR_返回 后跳转至此，
                        //   标签在函数体末发射（epilogue 唯一，中途回退不再穿透）
    映射<整64, 整64> 变量类型;    // P7b：变量名ID -> 类型名ID（容器/结果成员访问与方法解析）
    向量<整64> 字符串变量们;     // plans/019 阶段4' 第二批：拥有型字符串局部名单（白名单判定后）
    映射<整64, 整64> 字符串污染们;  // plans/019 阶段4' 第二批：污染名ID -> 1（非拥有赋值/
                                //   下标借出——释放挂点一律跳过，宿主 stringTainted_ 同构）
    向量<整64> 容器变量们;        // P7b：容器变量名ID 列表（RAII 返回前析构遍历）
    向量<整64> 资源字段局部们;    // ②c B：含容器字段的结构体局部名ID（块出口级联析构）
    向量<整64> 资源字段结构体们;  // ②c B：对应结构体名ID（与 资源字段局部们 同下标）
    整64 retbuf字节数;    // ②b B6：本函数 retbuf 调用最大返回字节数（帧尺寸依据；
                        //   生成函数 出口自 当前retbuf字节数 回填）
    向量<整64> 参数槽序们;        // ②b B8：参数按声明序的基槽（多槽结构体参数=最大槽号）
    向量<整64> 参数拷贝字节们;    // ②b B8：参数按声明序的 prologue 拷贝字节数
                                //   （0=标量直存；>0=结构体按值：指针入参 -> 多槽拷贝）
    整64 零寄存器;        // 73-a（2026-09-11 方案A 用户裁决）：函数入口常量 0 的
                        //   寄存器号（预扫 无资源声明时为 0=未分配）——释放点
                        //   清零槽用（释放+清零幂等模型：跳出释放/块出口释放后
                        //   槽清零，函数级兜底再次经过时读 0=空安全跳过，杜绝
                        //   双释；宿主 72-a 同款）。该指令位于函数入口必经路径，
                        //   任何释放点的运行期路径都已执行过它。
}

// ==================== 方法返回形态 ====================
常量 容器返回_标量 = 0;     // 标量返回 rax（大小/元素/为空/包含/删除(K) 布尔）
常量 容器返回_结果空 = 1;   // 结果<空类型,整32>：隐藏返回指针，12 字节（追加/删除(i)/设置/插入/预留）
常量 容器返回_结果值 = 2;   // 结果<T,整32>：隐藏返回指针（读取/获取/弹出/栈顶/出队/队首）
常量 容器返回_空类型 = 3;   // 无返回值（清空）
常量 容器返回_结构体 = 4;   // ②b B2（2026-09-02）：T 为结构体的按值返回（元素(位置)->T）——
                           //   隐藏返回指针，调用后 rax/x0=缓冲地址即结构体地址（宿主
                           //   epilogue mov x0,x19 / win rax 同款），链式 .字段 以此为基址

// ==================== 实例实参再切分（②c A，2026-09-02） ====================
// $ 扁平合成名的实参串按基名元数贪婪再切分：向量$映射$整64$整64 -> ["映射$整64$整64"]、
//   映射$整64$整64 -> ["整64","整64"]。朴素 '$' 切分对嵌套实参必错（单参 T 被切成
//   首段 "映射"），方法符号（#参数串）与返回类型推导双双失真（对标宿主 AST 级
//   实例化——扁平串须按元数还原）。
函数 基名元数(字符串 基名) -> 整64 {
    如果 (字符串比较(基名, "映射") || 字符串比较(基名, "结果")) { 返回 2; }
    返回 1;
}

// 实例化基名（容器 + 结果/可选——参与实参段的递归消费）
函数 是实例化基名(字符串 名) -> 布尔 {
    返回 是容器基名(名) || 字符串比较(名, "结果") || 字符串比较(名, "可选");
}

// 解析 [位置..] 为一个实参段：标识符词（含数字——类型名 整64/浮32/整128 等）；
//   实例化基名递归消费其元数个实参段；尾缀 '*'/'&' 字节原样并入。位置 出参推进
//  （调用方保证 '$' 分隔已消费）。
不安全 函数 解析实参段(字符串 实参串, 整64* 位置) -> 字符串 {
    整64 i = 位置[0];
    整64 n = 字符串长度(实参串);
    字符串 词 = "";
    当 (i < n) {
        整64 字节 = 整64(实参串[i]) & 255;
        布尔 词字节 = 字节 >= 128 || (字节 >= 48 && 字节 <= 57) ||
                      (字节 >= 65 && 字节 <= 90) ||
                      (字节 >= 97 && 字节 <= 122) || 字节 == 95;
        如果 (词字节) {
            词 = 词 + 字符串子串(实参串, i, 1);
            i++;
        } 否则 {
            中断;
        }
    }
    如果 (字符串长度(词) == 0) { 返回 ""; }
    如果 (是实例化基名(词)) {
        整64 元 = 基名元数(词);
        整64 k = 0;
        当 (k < 元) {
            // 期望 '$' 分隔（防御：不足则停止）
            如果 (i < n) {
                整64 分隔 = 整64(实参串[i]) & 255;
                如果 (分隔 == 36) { i++; }
            }
            位置[0] = i;
            字符串 子段 = 解析实参段(实参串, 位置);
            如果 (字符串长度(子段) == 0) { 中断; }
            词 = 词 + "$" + 子段;
            i = 位置[0];
            k++;
        }
    }
    // 尾缀 '*'(42) / '&'(38) 原样并入（指针/引用形实参）
    当 (i < n) {
        整64 后缀 = 整64(实参串[i]) & 255;
        如果 (后缀 == 42 || 后缀 == 38) {
            词 = 词 + 字符串子串(实参串, i, 1);
            i++;
        } 否则 {
            中断;
        }
    }
    位置[0] = i;
    返回 词;
}

// 取实例实参们：跳过基名首段，按元数贪婪切分全部实参（返回向量）
函数 取实例实参们(字符串 合成名) -> 向量<字符串> {
    向量<字符串> 实参们 = 向量<字符串>();
    整64 首 = 首分段位置(合成名);
    如果 (首 < 0) { 返回 实参们; }
    整64 i = 首 + 1;
    整64 n = 字符串长度(合成名);
    当 (i < n) {
        整64 位置 = i;
        字符串 段 = 解析实参段(合成名, &位置);
        如果 (字符串长度(段) == 0) { 中断; }
        // A2：段 是循环内登记变量（返回块 RAII 释放末迭代值）——入容器显式
        //   复制，防向量元素悬垂（浅共享×源释放）。
        结果<空类型, 整32> 加段 = 实参们.追加(字符串复制(段));
        如果 (!加段.正常) { 运行时错误(4); }
        i = 位置;
        // 期望 '$' 分隔或结束
        如果 (i < n) {
            整64 分隔 = 整64(合成名[i]) & 255;
            如果 (分隔 == 36) { i++; }
        }
    }
    返回 实参们;
}

// ==================== 顶层静态声明表（②c C，2026-09-02） ====================
// 任务级生命周期：名ID -> 序号（IR 标识符解析）；名/类型平铺（入口构造注入）；
//   IR生成 入口收集（先清空，幂等）。存储=双后端 .data _cn_gstatic_<序号> 槽
//   （统一指针槽：容器=堆对象指针；标量=初始值——.data 直存折叠字面量）。
静态 映射<整64, 整64> 静态序号们;

// IR 层错误计数与统一诊断（2026-09-04，IR生成.cn 冒烟 [ir2] 纪律收口）：
//   [ir2] 级诊断=IR 不完整（形态不支持/目标未解析）——产物不可信。对齐
//   「语义错误即中止」（E2E 139 纪律）：主.cn 于 IR 生成后检查计数>0 即
//   中止（不产 asm）。单一归属本组件（IR生成/IR容器 诊断点全部经此计数）。
静态 整64 IR层错误计数 = 0;

函数 IR层诊断(字符串 消息) -> 空类型 {
    IR层错误计数 = IR层错误计数 + 1;
    IO::打印到错误("[ir2] " + 消息 + "\n");
}

函数 取IR层错误数() -> 整64 {
    返回 IR层错误计数;
}

函数 清空IR层错误计数() -> 空类型 {
    IR层错误计数 = 0;
}
静态 向量<整64> 静态名们;
静态 向量<整64> 静态类型们;
// 87-a（2026-09-12 第八十七轮）：静态初值区间表（每静态 2 项：起点、终点；
//   无初值 = -1/-1）。结构体静态的初值不可 .data 直存（须入口注入逐字段构造/
//   整体拷贝），注入点在 生成函数 的主入口——须按序号回查 AST 初值区间。
静态 向量<整64> 静态初值起点们;
静态 向量<整64> 静态初值终点们;
// 87-a（2026-09-12 第八十七轮）：静态需注入表（1=初值不可 .data 直存，须入口
//   物化）。覆盖：结构体（逐字段构造/整体拷贝）、字符串（驻留/堆串）、以及
//   折叠失败的标量（布尔/浮点/字符字面量——折叠常量值 只认整数文本，原实现
//   静默落 .data 0 = 初值丢失，探针实证 布尔=假/浮=0）。容器类经 NewObject
//   注入（原路径），不入本表。
静态 向量<整64> 静态需注入们;

函数 清空静态表() -> 空类型 {
    静态序号们.清空();
    静态名们 = 向量<整64>();
    静态类型们 = 向量<整64>();
    静态初值起点们 = 向量<整64>();
    静态初值终点们 = 向量<整64>();
    静态需注入们 = 向量<整64>();
}

// 收集一个 程序 节点区间的全部静态声明（容器/标量通用——初始值折叠由 IR生成 完成）
函数 收集静态(向量<节点> 池, 整32 程序节点, 向量<整64>& 初始值们) -> 空类型 {
    节点 程序 = 池.元素(程序节点);
    整64 i = 整64(程序.子起点);
    当 (i < 整64(程序.子终点)) {
        节点 声明 = 池.元素(整32(i));
        如果 (声明.类型 == 节点_静态声明) {
            整64 序号 = 静态名们.大小();
            结果<空类型, 整32> 加名 = 静态名们.追加(整64(声明.文本));
            如果 (!加名.正常) { 运行时错误(4); }
            节点 类型节点 = 池.元素(整32(声明.附加));
            结果<空类型, 整32> 加类 = 静态类型们.追加(整64(类型节点.文本));
            如果 (!加类.正常) { 运行时错误(4); }
            结果<空类型, 整32> 设序 = 静态序号们.设置(整64(声明.文本), 序号);
            如果 (!设序.正常) { 运行时错误(4); }
            // 87-a：初值区间登记（有初值=声明子区间；无=-1/-1）
            整64 初起 = 0 - 1;
            整64 初终 = 0 - 1;
            如果 (声明.子起点 < 声明.子终点) {
                初起 = 整64(声明.子起点);
                初终 = 整64(声明.子终点);
            }
            结果<空类型, 整32> 加起 = 静态初值起点们.追加(初起);
            如果 (!加起.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加终 = 静态初值终点们.追加(初终);
            如果 (!加终.正常) { 运行时错误(4); }
            字符串 类型文本 = 字符串复制(驻留文本(整64(类型节点.文本)));
            整64 需注入v = 0;
            如果 (是容器类(类型文本)) {
                // 容器静态：入口 NewObject+构造（初始值表达式同构，忽略）——
                //   .data 槽初值 0（文本 ID 形态——代码生成经 驻留文本 还原）
                结果<空类型, 整32> 加零 = 初始值们.追加(驻留("0"));
                如果 (!加零.正常) { 运行时错误(4); }
            } 否则 {
                // 标量静态：初始值折叠（空初始化按 0）
                整64 值ID = 驻留("0");
                如果 (声明.子起点 < 声明.子终点) {
                    整64 折叠 = 折叠常量值(池, 声明.子起点, 声明.子终点);
                    如果 (折叠 != 0) { 值ID = 折叠; } 否则 { 需注入v = 1; }
                }
                结果<空类型, 整32> 加值 = 初始值们.追加(值ID);
               如果 (!加值.正常) { 运行时错误(4); }
            }
            // 87-a：结构体/字符串（不可 .data 直存）→ 需注入
            如果 (查结构体大小(整64(类型节点.文本)) > 0) { 需注入v = 1; }
            如果 (字符串比较(类型文本, "字符串")) { 需注入v = 1; }
            结果<空类型, 整32> 加注 = 静态需注入们.追加(需注入v);
            如果 (!加注.正常) { 运行时错误(4); }
        }
        i++;
    }
}

// ==================== 符号合成（宿主 methodSymbolKey 对齐） ====================
// 无参构造符号：类$基名（向量$整64 -> 向量$整64$向量；宿主构造方法名=类名）
函数 构造符号(字符串 合成名) -> 字符串 {
    返回 合成名 + "$" + 合成名基名(合成名);
}

// 析构符号：类$~基名（向量$整64 -> 向量$整64$~向量）
函数 析构符号(字符串 合成名) -> 字符串 {
    返回 合成名 + "$~" + 合成名基名(合成名);
}

// 方法符号：类$方法[#参数串]（参数串空则无 #——对标宿主 signatureKey）
函数 方法符号(字符串 合成名, 字符串 方法名, 字符串 参数串) -> 字符串 {
    如果 (字符串长度(参数串) == 0) { 返回 合成名 + "$" + 方法名; }
    返回 合成名 + "$" + 方法名 + "#" + 参数串;
}

// ==================== 函数签名表（呈报③方案A：重载消歧，2026-09-06） ====================
// 规格书 §函数重载（plans/001:358）：同名函数按参数类型与个数区分（重载决议），
//   名称修饰按签名编码（附录C）。宿主权威 = signatureKey（semantic.cpp:546，
//   名#参数串，参数串空则无 '#'）——v2 原函数登记键=纯声明名，同名映射覆盖
//   （后吞前静默）+ 函数IR.名字=纯名（跨文件同名重载 asm 重复定义，第一轮
//   冒烟实测源码改名 生成函数W 规避）。本表为决议与消歧的数据基座：
//   键1 = 键基ID -> 候选数；键2 = 键基ID*键位移+候选序 -> 参数串ID。
//   签名键 = 驻留(键基文本 或 键基文本#参数串)——与 函数实参结构们/函数返回类型们
//   的签名键登记、调用点决议产物三方一致（同字符串驻留 = 同 ID）。
// plans/018 P6b 第 4 层（2026-09-07）：登记维度由纯名升级为「键基」（plans/018
//   工作流3 第 3/4 层，宿主 functionLinkKey 公式对齐）——键基 = 主模块（入口，
//   含单文件）纯名本身；其余模块 驻留(模块路径 + "$" + 名)。跨模块同名同签名
//   函数因此合法共存（链接符号天然隔离：非主模块 asm 符号=模块$名#参数串，
//   单文件/主模块形态逐字节不变=v2self 产物对拍硬基准）。登记源（幂等）：
//   语义分析.声明收集（主链+语义冒烟子链）、IR生成/IR生成多文件 入口（IR 冒烟
//   子链，清空后重收集=权威）——两处登记均按键基，同模块同签名重复登记被幂等
//   跳过，跨模块同名互不干扰。
静态 映射<整64, 整64> 函数签名个数们;
静态 映射<整64, 整64> 函数签名参数串们;

// ==================== 调用决议表（plans/018 第 4 层：语义驱动 IR） ====================
// 语义分析 检查表达式 调用分支完成三级名称解析（①本模块 > ②显式导入 >
//   ③glob+歧义诊断，宿主 resolvedSignature=注册键同构）后，把调用点的
//   键基决议结果写入本表（键 = 调用节点池索引 -> 键基ID）；IR 层
//   决议函数符号 据此锁定候选模块桶再做重载决议——IR 不重复名称解析、
//   不反向依赖语义组件（表在 IR容器 中立层，两侧已导入）。主模块/单文件
//   条目值=纯名 ID（与决议函数符号 旧纯名路径等价，行为不变）。
// 生命周期：语义分析/语义分析多文件 入口清空（检查阶段写）；IR 生成阶段只读。
静态 映射<整64, 整64> 调用决议键基们;

函数 调用决议登记(整64 调用节点索引, 整64 键基ID) -> 空类型 {
    结果<空类型, 整32> 设 = 调用决议键基们.设置(调用节点索引, 键基ID);
    如果 (!设.正常) { 运行时错误(4); }
}

函数 调用决议查询(整64 调用节点索引) -> 整64 {
    结果<整64, 整32> 查 = 调用决议键基们.获取(调用节点索引);
    如果 (查.正常) { 返回 查.值; }
    返回 -1;
}

函数 清空调用决议() -> 空类型 {
    调用决议键基们.清空();
}

// 函数参数串提取：遍历函数节点参数区间 [子起点, 块.子起点)（块 在 子终点=
//   块索引，收集函数实参结构 同款），逐参数 类型文本+后缀（类型节点 附加
//   1..255=指针层 '*'×层、>=256=引用 '&'——参数声明位类型文本无后缀，
//   后缀语义在附加），逗号连接。无参返回 空串。
函数 函数参数串(向量<节点> 池, 整32 函数节点) -> 字符串 {
    节点 函数声明 = 池.元素(函数节点);
    整64 参数终点 = 整64(函数声明.子终点);
    如果 (参数终点 < 整64(池.大小())) {
        节点 块节点 = 池.元素(整32(参数终点));
        参数终点 = 整64(块节点.子起点);
    }
    字符串 串 = "";
    整64 i = 整64(函数声明.子起点);
    当 (i < 参数终点) {
        节点 参数 = 池.元素(整32(i));
        如果 (参数.类型 == 节点_参数) {
            字符串 类型文本 = "";
            // 守卫 >= 0（lessons 池索引 0 合法——生成函数 同款）
            如果 (参数.附加 >= 0 && 参数.附加 < 整64(池.大小())) {
                节点 类型节点 = 池.元素(整32(参数.附加));
                如果 (类型节点.类型 == 节点_类型) {
                    类型文本 = 字符串复制(驻留文本(整64(类型节点.文本)));
                    如果 (类型节点.附加 >= 256) {
                        类型文本 = 类型文本 + "&";
                    } 否则 如果 (类型节点.附加 >= 1) {
                        整64 层 = 类型节点.附加;
                        当 (层 > 0) {
                            类型文本 = 类型文本 + "*";
                            层--;
                        }
                    }
                }
            }
            如果 (字符串长度(串) > 0) { 串 = 串 + ","; }
            串 = 串 + 类型文本;
        }
        i++;
    }
    返回 串;
}

// 签名键合成：参数串空 -> 纯名（无 '#'，对齐宿主 signatureKey/方法符号惯例）
函数 函数签名键(整64 名ID, 字符串 参数串) -> 整64 {
    如果 (字符串长度(参数串) == 0) { 返回 名ID; }
    返回 驻留(驻留文本(名ID) + "#" + 参数串);
}

// 登记单个函数签名（幂等：键基下既有候选同参数串 -> 跳过——重定义由语义层
//   声明收集 诊断，本表不重复计候选）。键基语义见上表注（plans/018：主模块
//   =纯名；其余模块=模块$名——跨模块同名同签名合法共存的数据基座）。
函数 登记函数签名K(向量<节点> 池, 整32 函数节点, 整64 键基ID) -> 空类型 {
    节点 函数声明 = 池.元素(函数节点);
    字符串 参数串 = 函数参数串(池, 函数节点);
    整64 键串 = 驻留(参数串);
    整64 候选数 = 0;
    结果<整64, 整32> 查数 = 函数签名个数们.获取(键基ID);
    如果 (查数.正常) { 候选数 = 查数.值; }
    整64 k = 0;
    当 (k < 候选数) {
        结果<整64, 整32> 查串 = 函数签名参数串们.获取(键基ID * 键位移 + k);
        如果 (查串.正常) {
            如果 (查串.值 == 键串) { 返回; }
        }
        k++;
    }
    结果<空类型, 整32> 设串 = 函数签名参数串们.设置(
        键基ID * 键位移 + 候选数, 键串);
    如果 (!设串.正常) { 运行时错误(4); }
    结果<空类型, 整32> 设数 = 函数签名个数们.设置(键基ID, 候选数 + 1);
    如果 (!设数.正常) { 运行时错误(4); }
}

// 收集一个 程序 节点区间的全部函数签名（IR生成/IR生成多文件 入口用；
//   模块路径 = 该文件所属模块（主.cn 加载器传入）——键基按此合成。
//   语义层 声明收集 逐声明调 登记函数签名K——同一机制两个登记面）
函数 收集函数签名(向量<节点> 池, 整32 程序节点, 字符串 模块路径) -> 空类型 {
    节点 程序 = 池.元素(程序节点);
    整64 位置 = 整64(程序.子起点);
    当 (位置 < 整64(程序.子终点)) {
        节点 声明 = 池.元素(整32(位置));
        如果 (声明.类型 == 节点_函数) {
            整64 键基i = 键基合成(模块路径, 整64(声明.文本));
            登记函数签名K(池, 整32(位置), 键基i);
        }
        位置++;
    }
}

// 清空（任务级生命周期惯例——语义分析/语义分析多文件 与 IR生成/IR生成多文件
//   入口清空；主链两段各清空后重收集，内容一致幂等）
函数 清空函数签名() -> 空类型 {
    函数签名个数们.清空();
    函数签名参数串们.清空();
}

// 结果<T,E> 类型字节大小（ABI 防御布局——宿主 typeSizeOf 结果分支）：
//   正常@0(i32)+联合@4(整32)/@8(整64/字符串)；空类型/整32 -> 12，整64/字符串 -> 16；
//   T=结构体（2026-09-06 根治：结果<符号,整32> 值 32B 实际 40B——原按 16 算
//   retbuf 帧区不足，被调方写越界毁栈，v2self 表查找类型ID rep movsb 源=垃圾
//   崩溃实证）-> 8 对齐 + 结构体大小
函数 结果大小(字符串 结果类型名) -> 整64 {
    字符串 值类型 = 段首(合成名首实参(结果类型名));
    如果 (字符串比较(值类型, "整32") || 字符串比较(值类型, "正32") ||
        字符串比较(值类型, "空类型")) { 返回 12; }
    整64 结构字节数 = 查结构体大小(驻留(值类型));
    如果 (结构字节数 != 0) {
        返回 (结构字节数 + 7) / 8 * 8 + 8;
    }
    返回 16;
}

// 结果变量槽位数（8 字节槽）：12/16 字节均占 2 槽；T=结构体按实际大小
//   （2026-09-06 根治：结果<符号> 40B=5 槽，原 2 槽=变量区越界写踩相邻变量）
函数 结果槽位数(字符串 结果类型名) -> 整64 {
    整64 总字节 = 结果大小(结果类型名);
    返回 (总字节 + 7) / 8;
}

// ==================== 类型判定 ====================
// 类基名白名单（stdlib 泛型容器类。注意：结果/可选 不在此列——它们是宿主
//   内置泛型（合成结构体，非堆对象），由 是结果类型 判定；混入白名单会把
//   结果 变量误判为容器（NewObject+构造——v2p 冒烟实测踩坑）。
//   构造调用合法性判定处（语义/IR）用 是容器类 || 是结果类型 组合。
函数 是容器基名(字符串 名) -> 布尔 {
    返回 字符串比较(名, "向量") || 字符串比较(名, "映射") ||
          字符串比较(名, "链表") || 字符串比较(名, "栈") ||
          字符串比较(名, "队列") || 字符串比较(名, "集合");
}

// 是容器类类型：$ 合成名 且 基名 ∈ 白名单（向量$整64；裸名"向量"非实例）
函数 是容器类(字符串 名) -> 布尔 {
    如果 (首分段位置(名) < 0) { 返回 假; }
    返回 是容器基名(合成名基名(名));
}

// 是结果类型：基名=结果/可选（结果$空类型$整32）
函数 是结果类型(字符串 名) -> 布尔 {
    如果 (首分段位置(名) < 0) { 返回 假; }
    字符串 基名 = 合成名基名(名);
    返回 字符串比较(基名, "结果") || 字符串比较(基名, "可选");
}

// ==================== 对象大小表（NewObject 分配字节数） ====================
// 对标宿主 computeClassLayout 按 stdlib 字段布局（指针/整64 各 8 字节）。
//   ⚠ 维护契约：stdlib 容器.cn/映射集合.cn 字段变更须同步本表。
函数 容器对象大小(字符串 合成名) -> 整64 {
    字符串 基名 = 合成名基名(合成名);
    如果 (字符串比较(基名, "向量")) { 返回 24; }   // T*数据+元素数量+数组容量
    如果 (字符串比较(基名, "链表")) { 返回 64; }   // 值表+下一索引+值容量+头+尾+元素数量+空闲头+已用槽数（83-a）
    如果 (字符串比较(基名, "栈")) { 返回 24; }     // 数据+元素数量+数组容量
    如果 (字符串比较(基名, "队列")) { 返回 64; }   // 值表+下一索引+值容量+头+尾+元素数量+空闲头+已用槽数（83-a）
    如果 (字符串比较(基名, "映射")) { 返回 56; }   // 键+值+链+桶四数组+桶数量+元素数量+数组容量
    如果 (字符串比较(基名, "集合")) { 返回 24; }   // 数据数组+元素数量+数组容量
    返回 8;
}

// ==================== 74-a：容器元素串释放（2026-09-11 第七十四轮） ====================
// 移植来源：宿主 src/cn_compiler/ir/ir_oop_call.cpp::emitContainerElemFreeFor +
//   src/runtime/io_api.cpp::__cn_vector_free_strings / __cn_chain_free_strings。
// **移植清单两件套（plans/020 移植纪律 7）**：
//   机制主体 = 容器析构时按元素模型逐元素释放元素串（容器拥有元素所有权）。
//   依赖不变量 = ①**释放后元素槽清零**（幂等前提——块出口/跳出/函数级兜底/清空
//     多路径共享同一元素数组，清零后 cn_free_tracked(nullptr) 空安全；73-a 宿主
//     首版缺此不变量致 double free SIGSEGV 的同一形态）；②**链式容器按链游释放**
//     （链表/队列 的出队/删除头部把元素所有权转移给调用方，槽序号可能 < 元素数量
//     ——平铺释放会误释放已移交的串；宿主同款不变量）；③字面量元素=驻留常量，
//     cn_free_tracked 非在册(空安全)。
// 元素类型判定（恰为 字符串；嵌套容器元素不匹配——按嵌套形态以 char* 语义释放
//   容器对象指针会损坏堆）
//   76-a（2026-09-12 第七十六轮）：加 集合$字符串（探针 76-E/S1 实证：集合元素串
//   原无释放面——析构/清空路径泄漏；元素=独立平铺数组，模型同 向量/栈）
函数 是字符串元素容器(字符串 合成名) -> 布尔 {
    整64 位置 = 首分段位置(合成名);
    如果 (位置 < 0) { 返回 假; }
    字符串 基名 = 字符串子串(合成名, 0, 位置);
    如果 (!(字符串比较(基名, "向量") || 字符串比较(基名, "链表") ||
          字符串比较(基名, "栈") || 字符串比较(基名, "队列") ||
          字符串比较(基名, "集合"))) {
        返回 假;
    }
    返回 字符串比较(合成名首实参(合成名), "字符串");
}

// 76-a：字符串值映射判定（映射$K$字符串）——入容器位（设置 值实参=下标1）归一化用。
//   释放面随宿主编译供给 obj 生效（~映射/清空/删除/覆盖写/释放内部数组 注入），
//   故本判定只服务归一化（与宿主 isStringValuedMap 同款；不并入 是字符串元素容器
//   ——键/值两数组非单元素数组模型，不经 发射容器元素释放）。
//   背景（探针 76-F 实证）：映射释放侧假定值槽句柄恒为「容器独有或驻留常量」
//   （移植纪律 7 不变量①）——不归一化=借用来源句柄浅存 → 容器析构释放调用方串
//   （UAF，74-a 缺陷①在映射上的重演）。
函数 是字符串值映射(字符串 合成名) -> 布尔 {
    如果 (!字符串比较(合成名基名(合成名), "映射")) { 返回 假; }
    字符串 值段 = 段首(段余(合成名首实参(合成名)));   // 映射$K$V -> K$V -> V
    返回 字符串比较(值段, "字符串");
}

// 容器字段偏移（按 stdlib 容器.cn 字段序，与 容器对象大小 表同源维护）
//   向量/栈：数据@0 元素数量@8；集合：数据数组@0 元素数量@8；链表/队列：值表@0
//   下一索引@8 值容量@16 头索引@24 尾索引@32 元素数量@40
函数 容器元素释放参数们(字符串 合成名, 向量<整64>& 出) -> 空类型 {
    字符串 基名 = 合成名基名(合成名);
    如果 (字符串比较(基名, "向量") || 字符串比较(基名, "栈") ||
          字符串比较(基名, "集合")) {   // 76-a：集合=独立平铺数组（同 向量 模型）
        结果<空类型, 整32> 加0 = 出.追加(0);     // 数据偏移
        如果 (!加0.正常) { 运行时错误(4); }
        结果<空类型, 整32> 加1 = 出.追加(8);     // 元素数量偏移
        如果 (!加1.正常) { 运行时错误(4); }
        返回;
    }
    // 链表/队列（链式模型）
    结果<空类型, 整32> 加0c = 出.追加(0);        // 值表偏移
    如果 (!加0c.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加1c = 出.追加(8);        // 下一索引偏移
    如果 (!加1c.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加2c = 出.追加(24);       // 头索引偏移
    如果 (!加2c.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加3c = 出.追加(40);       // 元素数量偏移
    如果 (!加3c.正常) { 运行时错误(4); }
}

// 发射容器元素串释放：obj寄存器=容器对象指针；实参按模型分派
//   平铺（向量/栈/集合）：__cn_vector_free_strings(obj, 数据偏移, 元素数量偏移)
//   链式（链表/队列）：__cn_chain_free_strings(obj, 值表, 下一索引, 头索引, 元素数量)
// 调用形态与 发射字符串释放 同款（IR_调用实参×N + IR_调用参数化 收尾——
//   多参数调用零新指令，代码生成 __cn_ 前缀直通）。
不安全 函数 发射容器元素释放(函数IR& 函数信息, 整64* 寄存器计数,
                      整64 对象寄存器, 整64 容器类型ID) -> 空类型 {
    字符串 合成名 = 字符串复制(驻留文本(容器类型ID));
    如果 (!是字符串元素容器(合成名)) { 返回; }
    向量<整64> 参数们 = 向量<整64>();
    容器元素释放参数们(合成名, 参数们);
    如果 (参数们.大小() == 0) { 返回; }
    字符串 基名 = 合成名基名(合成名);
    布尔 链式 = 字符串比较(基名, "链表") || 字符串比较(基名, "队列");
    字符串 释放符号 = "__cn_vector_free_strings";
    如果 (链式) { 释放符号 = "__cn_chain_free_strings"; }
    // 位 0 = obj（自然落 rdi）；常量参数经 IR_常量整数 加载后按位发射
    整64 位 = 0;
    IR追加(函数信息.指令, 建IR指令(IR_调用实参, 对象寄存器, 0, 0, 0, 位, 0));
    位++;
    整64 i = 0;
    当 (i < 参数们.大小()) {
        整64 常reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(函数信息.指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(参数们.元素(i))),
                             0, 0, 常reg, T_整64, 0));
        IR追加(函数信息.指令, 建IR指令(IR_调用实参, 常reg, 0, 0, 0, 位, 0));
        位++;
        i++;
    }
    IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 位, 0, 0, 0, 0, 驻留(释放符号)));
}

// ==================== 74-a：入容器位所有权归一化（2026-09-11 第七十四轮） ====================
// 移植来源：宿主 ir_oop_call.cpp::buildCallArgsForMethod + normalizeContainerInsertArg。
// **移植清单两件套（plans/020 移植纪律 7）**：
//   机制主体 = 入容器位按实参来源分级归一化——字面量=驻留借用（零复制）；
//     转移(拥有局部)=真 move（句柄直存 + 源槽清零，零拷贝）；调用返回（拥有契约）
//     =直接接管；其余（标识符/成员/下标/借出）=__cn_str_copy 落堆。
//   依赖不变量 = ①**容器元素释放假定元素恒为堆串或驻留常量**（发射容器元素释放
//     逐元素 cn_free_tracked）——故借用来源必须复制，否则容器析构释放他人句柄
//     （宿主探针 74-L：跨函数 UAF 输出乱码）；②**真 move 分支源槽必须清零**——
//     源变量仍在 字符串变量们 名单内，出口 __cn_str_free 释放已移交句柄=元素悬垂
//     （宿主探针 74-J 同形态）。
// 时序不变量（v2 特有，实施中实证）：归一化调用须在 **this 的 IR_调用实参 之前**
//   发射——代码生成的调用展开是「收集 IR_调用实参，遇 IR_调用参数化 统一展开」，
//   若在 this/实参已声明之后插入独立调用，其 IR_调用参数化 会把前面收集的实参
//   一起展开（位数错乱、寄存器错位）。

// 入容器位方法名（stdlib/容器.cn 中「把值交给容器」的全部入口）
函数 是入容器方法(字符串 方法名) -> 布尔 {
    返回 字符串比较(方法名, "追加") || 字符串比较(方法名, "插入") ||
          字符串比较(方法名, "设置") || 字符串比较(方法名, "压入") ||
          字符串比较(方法名, "入队") || 字符串比较(方法名, "头部追加") ||
          字符串比较(方法名, "添加");
}

// 值实参正序下标：插入(位置,值)/设置(位置,值) 的值在 1；其余在 0。-1=非入容器位
函数 入容器值实参下标(字符串 方法名) -> 整64 {
    如果 (字符串比较(方法名, "插入") || 字符串比较(方法名, "设置")) { 返回 1; }
    如果 (是入容器方法(方法名)) { 返回 0; }
    返回 -1;
}

// 发射 __cn_str_copy(实参寄存器) -> 新寄存器（调用方须已登记调用序列未开始）
不安全 函数 发射字符串复制调用(向量<IR指令>& 指令, 整64* 寄存器计数,
                     整64 实参寄存器) -> 整64 {
    整64 copy寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_调用实参, 实参寄存器, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, copy寄存器, 0,
                         驻留("__cn_str_copy")));
    登记寄存器类型(copy寄存器, T_字符串);
    返回 copy寄存器;
}

// 源槽清零（75-a 真 move 不变量）：写 0 到槽——本函数拿不到 函数信息.零寄存器，
//   故现发一个常量 0 寄存器（IR_常量整数 + IR_存储，两者均非调用指令，不参与
//   调用实参收集展开，位置无时序约束）。
不安全 函数 发射槽清零(向量<IR指令>& 指令, 整64* 寄存器计数, 整64 槽) -> 空类型 {
    整64 零reg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零reg, T_整64, 0));
    IR追加(指令, 建IR指令(IR_存储, 零reg, 0, 0, 0, 0, 槽));
}

// 入容器位实参所有权归一化（方案A 核心；调用方在 发射调用实参们/this 声明之前调用）
//   池/调用节点：实参节点区间 [子起点+1, 子起点+1+附加)（正序）
//   弹出们：实参寄存器（倒序——弹出们[0]=末实参），值实参寄存器按下标原位替换
//   76-a（2026-09-12 第七十六轮）：映射（值侧字符串）同纳入——释放侧假定值槽
//   句柄恒为「容器独有或驻留常量」（移植纪律 7 不变量①），不归一化=借用来源
//   浅存 → 容器析构释放他人串（UAF，探针 76-F）
不安全 函数 归一化入容器实参(向量<节点> 池, 节点 调用节点, 整32 调用位置,
                    字符串 类名, 字符串 方法名, 向量<整64>& 弹出们,
                    映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                    向量<IR指令>& 指令, 整64* 寄存器计数) -> 空类型 {
    如果 (!(是字符串元素容器(类名) || 是字符串值映射(类名))) { 返回; }
    整64 值序 = 入容器值实参下标(方法名);
    如果 (值序 < 0 || 值序 >= 整64(调用节点.附加)) { 返回; }
    如果 (弹出们.大小() == 0) { 返回; }
    整64 弹下标 = 弹出们.大小() - 1 - 值序;
    如果 (弹下标 < 0 || 弹下标 >= 弹出们.大小()) { 返回; }
    // 实参根节点定位（v2 节点池=**后缀序**：子节点在前、根在后）。入容器位方法表
    //   （追加/压入/入队/头部追加/添加 值序0；插入/设置 值序1）的**值实参恒为最后
    //   一个实参**，故其根节点 = 调用节点前一位置（调用节点自身索引=调用位置）。
    //   **不可用 子起点+1+值序**——那是实参子树**起始**节点，复合实参（如
    //   追加(字符串复制(x))）时指向最内层子节点，判定失真（探针 74-H 实证：
    //   取到「字符串复制」标识符节点 → 误判借用 → 多一次复制 + 原值泄漏）。
    如果 (调用位置 <= 0) { 返回; }
    整64 实参根索引 = 整64(调用位置) - 1;
    如果 (实参根索引 >= 池.大小()) { 返回; }
    节点 实参节点 = 池.元素(整32(实参根索引));
    // ① 字面量：驻留借用（进程生命周期常量，释放侧非在册空安全，零复制开销）
    如果 (实参节点.类型 == 节点_字符串字面量) { 返回; }
    整64 实参寄存器 = 弹出们.元素(弹下标);
    // ①' 75-a（2026-09-12 方案甲 用户裁决）：**转移(拥有局部) = 真 move**
    //    （宿主 normalizeContainerInsertArg 分支③同款：句柄直存 + 源槽清零，
    //    零拷贝）。三重判定（全部命中才真 move，任一不满足回落 ③ 复制）：
    //     a. 实参形态确为 转移(标识符) 调用；
    //     b. 源名在 **局部槽** 命中（是局部变量）；
    //     c. 源名**不在 参数槽**（函数参数=借用视图，容器不得接管其句柄）；
    //     d. 源名不在 **污染镜像**（借用视图/非拥有初始化——容器接管即容器析构
    //        释放他人串=UAF，故此判定必须保守：不确定→复制）。
    //    不变量：真 move 分支须清源槽（否则源 RAII 出口 __cn_str_free 释放已
    //    移交句柄=元素悬垂，探针 74-J 宿主同形态）；清零用现发常量寄存器
    //    （本函数无 函数信息.零寄存器）。
    如果 (实参节点.类型 == 节点_调用 && 实参节点.子起点 > 0 &&
        整64(实参节点.附加) == 1) {
        节点 被调t = 池.元素(整32(实参节点.子起点));
        如果 (被调t.类型 == 节点_标识符 &&
             字符串比较(驻留文本(整64(被调t.文本)), "转移")) {
            节点 源节点 = 池.元素(整32(实参节点.子起点) + 1);
            如果 (源节点.类型 == 节点_标识符) {
                整64 源名ID = 整64(源节点.文本);
                结果<整64, 整32> 找源槽 = 局部槽.获取(源名ID);
                如果 (找源槽.正常) {
                    结果<整64, 整32> 找参槽 = 参数槽.获取(源名ID);
                    如果 (!找参槽.正常) {
                        如果 (!是当前串污染(源名ID)) {
                            发射槽清零(指令, 寄存器计数, 找源槽.值);
                            返回;   // 真 move：零拷贝（容器接管源句柄）
                        }
                    } 否则 { }
                } 否则 { }
            }
        }
    }
    // ② 裸调用（标识符被调：白名单内置族 / 返回 字符串 契约）：返回值归本函数，
    //    容器直接接管（零拷贝）。**方法调用（元素/读取/头部元素 等）不走此支**：
    //    其被调节点是成员形态（非标识符），元素访问返回的是容器内借出句柄——
    //    误判为拥有会导致「两容器共享同一元素句柄 = 双释放」（宿主 semantic_call
    //    对 T 来源返回同样保守不登记），故一律落入 ③ 复制。
    如果 (实参节点.类型 == 节点_调用 && 实参节点.子起点 > 0) {
        节点 被调c = 池.元素(整32(实参节点.子起点));
        如果 (被调c.类型 == 节点_标识符) {
            整64 被调名c = 整64(被调c.文本);
            布尔 白名单 = 被调名c == 驻留("字符串复制") ||
                          被调名c == 驻留("字符串连接") ||
                          被调名c == 驻留("字符串拼接") ||
                          被调名c == 驻留("字符串子串") ||
                          被调名c == 驻留("字符串大写") ||
                          被调名c == 驻留("字符串小写") ||
                          被调名c == 驻留("字符串修剪") ||
                          被调名c == 驻留("字符串反转");
            如果 (!白名单 && 查函数返回回退(被调名c) == 驻留("字符串")) {
                白名单 = 真;   // A2 契约：签名即契约（返回 字符串 即拥有）
            }
            如果 (白名单) { 返回; }   // 直接接管（零拷贝）
        }
    }
    // ③ 其余（标识符/转移/成员/下标/借出/借用返回）：__cn_str_copy 落堆
    //    （CN 值语义深拷贝——源照常拥有并释放，容器独立拥有；Rust push(s.clone())）
    //    注：`转移(拥有局部)` 真 move 已由 ①'（75-a 污染名单镜像三重判定）覆盖，
    //    走到此处者=借用来源（形参/污染名）或非转移形态——复制是安全方向。
    结果<空类型, 整32> 换实 = 弹出们.设置(
        弹下标, 发射字符串复制调用(指令, 寄存器计数, 实参寄存器));
    如果 (!换实.正常) { 运行时错误(4); }
}

// ==================== 方法签名表 ====================
// 查表：类$合成名 + 方法名 + 实参数 → 参数类型串（T/K/V 已替换实例文本，
//   逗号连接——对标宿主 signatureKey）与返回形态。出参 值偏移=结果<T,E>.值
//   字节偏移（整32→4；整64/字符串/指针→8）。返回 假=方法未收录。
结构体 方法签名 {
    字符串 参数串;
    整64 返回形态;
    整64 值偏移;
    字符串 返回文本;    // ②b B5：替换后返回类型文本（链式成员 偏移/宽度 收口 + retbuf 尺寸用）
}

// 结果<T,E> 的 值 字节偏移：T=整32 -> 4（正常@0+联合@4）；其余（整64/字符串/指针）-> 8
函数 结果值偏移(字符串 值类型) -> 整64 {
    如果 (字符串比较(值类型, "整32")) { 返回 4; }
    如果 (字符串比较(值类型, "正32")) { 返回 4; }
    返回 8;
}

// 查方法签名（用户裁决项1：签名表查询 + 类型参数替换，替代硬编码 if 链——
//   stdlib 改签名/加方法 v2 自动跟随）。返回形态按替换后的返回类型通用判定：
//   结果$T$E -> 结果空（T=空类型）/结果值（+值偏移）；空类型 -> 无返回；
//   容器 $ 合成名 -> 容器返回_结构体（②c A：元素(i) 返回容器——宿主 typeSizeOf>8
//   隐藏返回指针拷贝对象字段，rax=缓冲地址即对象形基址，链式 .设置/.获取 this=此）；
//   其余 -> 标量（结构体返回亦走 结构体 形态）。未收录（表无此键）返回 假（调用方诊断）。
函数 查方法签名(字符串 合成名, 字符串 方法名, 整64 实参数, 方法签名* 出) -> 布尔 {
    字符串 基名 = 合成名基名(合成名);
    确保签名已加载();
    整64 键ID = 驻留(基名 + "." + 方法名 + "." + 整数转字符串(实参数));
    整64 查参 = 查签名参数串(键ID);
    整64 查返 = 查签名返回(键ID);
    如果 (查参 >= 0) {
        如果 (查返 >= 0) {
            // ②c A：实参替换改按元数切分的实参列表（朴素 '$' 切分对嵌套实参错）；
            //   类型参数序串经 类类型参数们 查取（基名 -> "T"/"K,V"）
            向量<字符串> 实参们 = 取实例实参们(合成名);
            字符串 序串 = "";
            整64 查序 = 查类类型参数(驻留(基名));
            如果 (查序 >= 0) { 序串 = 字符串复制(驻留文本(查序)); }
            // A2（2026-09-11 方案甲）：局部拥有串（归一结果名/替换 返回类型=字符串
            //   契约→登记 RAII→函数退出 free）存入结构体字段须显式复制——原浅存
            //   =字段悬垂（自举第二代实测：签.返回文本 悬垂→解析调用返回结构体
            //   驻留(垃圾)→结构体大小 0→45 个「成员字段偏移未知」；第一代堆未
            //   复用侥幸绿。「字符串入结构体须显式复制」纪律——容器 move 语义
            //   随后续批次）。
            出.参数串 = 字符串复制(替换类型参数带段们(驻留文本(查参), 序串, 实参们));
            字符串 返回文本 = 归一结果名(替换类型参数带段们(驻留文本(查返), 序串, 实参们));
            出.返回文本 = 字符串复制(返回文本);
            如果 (是结果类型(返回文本)) {
                字符串 值类型 = 段首(合成名首实参(返回文本));
                如果 (字符串比较(值类型, "空类型")) {
                    出.返回形态 = 容器返回_结果空;
                } 否则 {
                    出.返回形态 = 容器返回_结果值;
                    出.值偏移 = 结果值偏移(值类型);
                }
            } 否则 如果 (字符串比较(返回文本, "空类型")) {
                出.返回形态 = 容器返回_空类型;
            } 否则 {
                // ②b B2：T 为结构体 -> 隐藏返回指针形态（元素(位置)->T 按值返回 sret，
                //   链式 .字段 经 retbuf 基址访问）。T 为容器（类）不在结构体大小表 ->
                //   标量（ptr）：类元素 8 字节指针步长存储、rax 返回元素句柄。
                //   第 14 枚根治（2026-09-06，v2self 第 7 层）：「含容器字段的结构体 ->
                //   标量」旧判定撤销——它是 E2E 127 时代「供给.cn 类形态供给」的专属
                //   契约（主.cn 结构体声明 × 供给类实现 = 同名双 ABI），与宿主真语义
                //   分叉：宿主对 向量<词条>.元素(0)（词条=含容器字段结构体）发射
                //   rdi=retbuf/rsi=this/rdx=位置 三装载 sret（127 直编 asm 实证+
                //   运行 exit=0；v2p_rt 同款）。v2 旧判定发射 rdi=this/rsi=实参 ->
                //   this/实参整体错位（v2self 崩于 程序.函数们.元素(f)：this=0、
                //   位置=残留 0xffffffff -> 运行时错误3）。Rust 对齐：类型即布局、
                //   布局即 ABI——同名类型禁止双 ABI；大对象按值返回=sret 与
                //   Rust/LLVM codegen 一致，零额外开销。127 供给契约同步修
                //（供给.cn 词条 类->结构体，与本处配套消灭双 ABI）。
                整64 返回ID = 驻留(返回文本);
                如果 (查结构体大小(返回ID) != 0) {
                    出.返回形态 = 容器返回_结构体;
                } 否则 {
                    出.返回形态 = 容器返回_标量;
                }
            }
            返回 真;
        }
    }
    返回 假;
}

// 返回形态字节数（②b B6：retbuf 区按真实返回尺寸定帧——旧固定 2 槽=16 字节
//   对 ≥17 字节结构体返回越界踩顶变量槽，126 节点=24 字节实测踩中）。
//   结果空 12 / 结果值 结果大小 / 结构体 查结构体大小（②c A：容器返回=容器对象大小）；
//   标量/空类型 0=无 retbuf。
函数 签名返回字节数(方法签名* 签) -> 整64 {
    如果 (签.返回形态 == 容器返回_结果空) { 返回 12; }
    如果 (签.返回形态 == 容器返回_结果值) { 返回 结果大小(签.返回文本); }
    如果 (签.返回形态 == 容器返回_结构体) {
        如果 (是容器类(签.返回文本)) { 返回 容器对象大小(签.返回文本); }
        返回 查结构体大小(驻留(签.返回文本));
    }
    返回 0;
}

// 发射调用实参装载（参数区模式，用户裁决项3）：弹出们 为倒序（元素0=最后实参），
//   实参 j（0 起，第 j+1 个）位号=起始位+j，寄存器=弹出们[个数-1-j]。
//   IR_调用实参 为声明性指令（代码生成在 IR_调用参数化 统一展开装载）。
函数 发射调用实参们(向量<整64> 弹出们, 整64 起始位, 向量<IR指令>& 指令) -> 空类型 {
    整64 n = 弹出们.大小();
    整64 j = 0;
    当 (j < n) {
        IR追加(指令, 建IR指令(IR_调用实参, 弹出们.元素(n - 1 - j), 0, 0, 0, 起始位 + j, 0));
        j++;
    }
}

// ==================== 容器声明预扫与 RAII（P7b） ====================
// ②c B：含容器字段结构体局部 [起, 止) 的字段逆序级联析构（指针槽模型：取基槽地址
//   -> 字段地址 -> 指针加载 -> DeleteObject——空安全，裸声明零初始化保证跳过）。
//   局部逆序 + 字段逆序（后声明先释放）。局部声明在 生成语句 B1 分支登记。
// 79-a（2026-09-12 第七十九轮）：资源字段于地址释放——按字段类型分派：
//   字符串字段 -> __cn_str_free(字段句柄) + 字段槽清零（幂等：多释放点共享槽）；
//   含资源字段的嵌套结构体 -> 递归（字段内联存储，基址=该字段地址）；
//   容器字段 -> 指针槽模型（LoadPtr -> 元素串释放 -> DeleteObject）+ 清槽。
//   与宿主 emitOwnedStrFieldFreesAt / emitFieldStringFreeAt 同构
//   （plans/020 移植纪律 7/8：机制主体+不变量 ①释放+清槽幂等；深度上限 4 防环）。
不安全 函数 发射资源字段释放于地址(函数IR& 函数信息, 整64* 寄存器计数,
                            整64 结构体ID, 整64 基址reg, 整64 深度) -> 空类型 {
    如果 (深度 > 4) { 返回; }
    // 79-a 特例：结果/可选（内置合成布局，非用户结构体）——值字段为字符串时
    //   条件释放：值/错误 共用联合体偏移（值@4/8，错误同槽），非「正常/有值」
    //   分支下值位是错误码整数（free 整数指针=崩）——与宿主 emitFieldStringFreeIf
    //   同构（IR 条件分支，零运行时辅助）。
    字符串 类型文本r = 字符串复制(驻留文本(结构体ID));
    如果 (是结果类型(类型文本r)) {
        字符串 值类型r = 段首(合成名首实参(类型文本r));
        如果 (字符串比较(值类型r, "字符串")) {
            整64 值偏移r = 结果值偏移("字符串");
            整64 条件地址 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_字段地址, 基址reg, 0, 0, 条件地址, T_整64, 0));
            整64 条件reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_指针加载, 条件地址, 0, 0, 条件reg, T_整32, 0));
            整64 释放块 = 新块(函数信息);
            整64 汇合块 = 新块(函数信息);
            发射条件跳转(函数信息, 条件reg, 释放块, 汇合块);
            切换块(函数信息, 释放块);
            发射块标签(函数信息, 释放块);
            整64 值地址r = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_字段地址, 基址reg, 0, 0, 值地址r, T_整64, 值偏移r));
            整64 值regr = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_指针加载, 值地址r, 0, 0, 值regr, T_字符串, 0));
            IR追加(函数信息.指令, 建IR指令(IR_调用实参, 值regr, 0, 0, 0, 0, 0));
            IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                 驻留("__cn_str_free")));
            如果 (函数信息.零寄存器 != 0) {
                IR追加(函数信息.指令, 建IR指令(IR_指针存储, 值地址r,
                                     函数信息.零寄存器, 0, 0, T_整64, 0));
            }
            发射跳转(函数信息, 汇合块);
            切换块(函数信息, 汇合块);
            发射块标签(函数信息, 汇合块);
        }
        返回;
    }
    向量<整64> 字段们 = 向量<整64>();
    取资源字段们(结构体ID, 字段们);
    整64 f = 字段们.大小();
    当 (f > 0) {
        f -= 3;
        整64 字段类型ID = 字段们.元素(f + 1);
        整64 偏移 = 字段们.元素(f + 2);
        // 73-a：字段地址另存 地址reg（加载会把值寄存器指向对象，清零须回写
        //   字段槽本身）——释放+清零幂等模型
        整64 地址reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(函数信息.指令, 建IR指令(IR_字段地址, 基址reg, 0, 0, 地址reg, T_整64, 偏移));
        如果 (字符串比较(驻留文本(字段类型ID), "字符串")) {
            整64 串reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_指针加载, 地址reg, 0, 0, 串reg, T_字符串, 0));
            IR追加(函数信息.指令, 建IR指令(IR_调用实参, 串reg, 0, 0, 0, 0, 0));
            IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                 驻留("__cn_str_free")));
            如果 (函数信息.零寄存器 != 0) {
                IR追加(函数信息.指令, 建IR指令(IR_指针存储, 地址reg,
                                     函数信息.零寄存器, 0, 0, T_整64, 0));
            }
        } 否则 如果 (资源字段数(字段类型ID) > 0) {
            // 嵌套含资源字段的结构体（值语义内联）——递归释放其字段
            发射资源字段释放于地址(函数信息, 寄存器计数, 字段类型ID, 地址reg,
                                深度 + 1);
        } 否则 如果 (查结构体大小(字段类型ID) > 0) {
            // 84-e：**纯标量结构体字段**（值语义内联、无堆资源）→ 跳过。
            //   原实现落下方「容器路径」：IR_指针加载(值当对象指针) + 发射容器元素
            //   释放 + **IR_删除对象**（生成 `call 类型$~类型`）→ 缺符号链接失败
            //   （E2E 190 `点$~点` / 241 `深B$~深B` 实证）。结构体字段=内联值，
            //   释放义务归其自身字段（无资源字段即无义务）。
        } 否则 {
            整64 基址reg2 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_指针加载, 地址reg, 0, 0, 基址reg2, T_对象, 0));
            // 74-a：容器字段元素串释放（宿主 emitContainerElemFreeFor 同款；
            //   与局部容器同一释放模型——plans/020 移植纪律 8 三路径对称核对）
            发射容器元素释放(函数信息, 寄存器计数, 基址reg2, 字段类型ID);
            IR追加(函数信息.指令, 建IR指令(IR_删除对象, 基址reg2, 0, 0,
                                                 寄存器计数[0], 0, 字段类型ID));
            寄存器计数[0] = 寄存器计数[0] + 1;
            如果 (函数信息.零寄存器 != 0) {
                IR追加(函数信息.指令, 建IR指令(IR_指针存储, 地址reg,
                                     函数信息.零寄存器, 0, 0, T_整64, 0));
            }
        }
    }
}

// 79-a（2026-09-12 第七十九轮）：串字段清旧（preFree）——目标聚合的字符串字段
//   逐字段 free+清槽（含嵌套结构体递归）。调用点=整体拷贝前（memcpy 会覆盖目标
//   槽，旧句柄必须先释放；未初始化槽=0 空安全）。仅串字段（容器字段非本面）。
不安全 函数 发射串字段清旧(函数IR& 函数信息, 整64* 寄存器计数,
                   整64 基址reg, 整64 结构体ID, 整64 深度) -> 空类型 {
    如果 (深度 > 4) { 返回; }
    向量<整64> 字段们 = 向量<整64>();
    取资源字段们(结构体ID, 字段们);
    整64 f = 字段们.大小();
    当 (f > 0) {
        f -= 3;
        整64 字段类型ID = 字段们.元素(f + 1);
        整64 偏移 = 字段们.元素(f + 2);
        整64 地址reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(函数信息.指令, 建IR指令(IR_字段地址, 基址reg, 0, 0, 地址reg, T_整64, 偏移));
        如果 (字符串比较(驻留文本(字段类型ID), "字符串")) {
            整64 串reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_指针加载, 地址reg, 0, 0, 串reg, T_字符串, 0));
            IR追加(函数信息.指令, 建IR指令(IR_调用实参, 串reg, 0, 0, 0, 0, 0));
            IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                 驻留("__cn_str_free")));
            如果 (函数信息.零寄存器 != 0) {
                IR追加(函数信息.指令, 建IR指令(IR_指针存储, 地址reg,
                                     函数信息.零寄存器, 0, 0, T_整64, 0));
            }
        } 否则 如果 (资源字段数(字段类型ID) > 0) {
            发射串字段清旧(函数信息, 寄存器计数, 地址reg, 字段类型ID, 深度 + 1);
        } 否则 如果 (查结构体大小(字段类型ID) > 0) {
            // 84-e：纯标量结构体字段（内联值、无串字段）→ 无可清旧
        }
    }
}

// 79-a：串字段深拷（postCopy）——memcpy 之后把目标串字段句柄替换为独立副本
//   （__cn_str_copy 落堆）：目标独立拥有、源保持拥有（值语义拷贝；Rust Clone
//   由编译器代写）。先复制后写（目标旧句柄已由 preFree 释放或为 memcpy 传入的
//   源句柄——不得再 free）。含嵌套结构体递归。
不安全 函数 发射串字段深拷(函数IR& 函数信息, 整64* 寄存器计数,
                   整64 目标基址, 整64 源基址, 整64 结构体ID, 整64 深度) -> 空类型 {
    如果 (深度 > 4) { 返回; }
    向量<整64> 字段们 = 向量<整64>();
    取资源字段们(结构体ID, 字段们);
    整64 f = 字段们.大小();
    当 (f > 0) {
        f -= 3;
        整64 字段类型ID = 字段们.元素(f + 1);
        整64 偏移 = 字段们.元素(f + 2);
        如果 (字符串比较(驻留文本(字段类型ID), "字符串")) {
            整64 源地址c = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_字段地址, 源基址, 0, 0, 源地址c, T_整64, 偏移));
            整64 目标地址c = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_字段地址, 目标基址, 0, 0, 目标地址c, T_整64, 偏移));
            整64 源值c = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_指针加载, 源地址c, 0, 0, 源值c, T_字符串, 0));
            整64 副本c = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_调用实参, 源值c, 0, 0, 0, 0, 0));
            IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 1, 0, 0, 副本c, 0,
                                 驻留("__cn_str_copy")));
            登记寄存器类型(副本c, T_字符串);
            IR追加(函数信息.指令, 建IR指令(IR_指针存储, 目标地址c, 副本c, 0, 0, T_整64, 0));
        } 否则 如果 (资源字段数(字段类型ID) > 0) {
            // 86-a：递归分支必须在「结构体跳过」**之前**——含串结构体同时满足
            //   「查结构体大小>0」与「资源字段数>0」，守卫若在前则递归恒不可达
            //   （84-e 插入顺序错误，P42 实证：嵌套整体赋值深拷失效 → 悬垂乱码）。
            //   与 发射资源字段释放于地址 / 发射串字段清旧 两处同序（资源字段判定在前）。
            整64 源内 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_字段地址, 源基址, 0, 0, 源内, T_整64, 偏移));
            整64 目标内 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_字段地址, 目标基址, 0, 0, 目标内, T_整64, 偏移));
            发射串字段深拷(函数信息, 寄存器计数, 目标内, 源内, 字段类型ID, 深度 + 1);
        } 否则 如果 (查结构体大小(字段类型ID) > 0) {
            // 84-e：纯标量结构体字段（内联值、无串字段）→ 无深拷义务
        }
    }
}

// 79-a：结构体整体拷贝（含串字段深拷）——preFree（先释放=真）+ memcpy + 深拷
//   （深拷=真）。深拷=假 用于「调用返回来源（retbuf）接管」：句柄唯一持有者转为
//   目标（被调方返回移出已跳过释放），零拷贝 move 语义。无资源字段类型零开销
//   （memcpy 与既有行为一致）。
不安全 函数 发射结构体整体拷贝(函数IR& 函数信息, 整64* 寄存器计数,
                      整64 目标地址, 整64 源地址, 整64 结构体ID,
                      布尔 深拷, 布尔 先释放) -> 空类型 {
    如果 (先释放) { 发射串字段清旧(函数信息, 寄存器计数, 目标地址, 结构体ID, 0); }
    IR追加(函数信息.指令, 建IR指令(IR_结构体拷贝, 源地址, 目标地址, 0, 0,
                         查结构体大小(结构体ID), 0));
    如果 (深拷) { 发射串字段深拷(函数信息, 寄存器计数, 目标地址, 源地址, 结构体ID, 0); }
}

// 资源字段名单是否含该局部（写入位 preFree 判据：仅拥有槽可释放旧字段值）
函数 在资源字段名单(函数IR& 函数信息, 整64 名ID) -> 布尔 {
    整64 i = 0;
    当 (i < 函数信息.资源字段局部们.大小()) {
        如果 (函数信息.资源字段局部们.元素(i) == 名ID) { 返回 真; }
        i++;
    }
    返回 假;
}

// ②c B（79-a 扩容）：含资源字段结构体局部 [起, 止) 的字段逆序级联析构
//   （字符串字段 free+清槽 / 容器字段 DeleteObject / 嵌套递归）。局部逆序 +
//   字段逆序（后声明先释放）。局部声明在 生成语句 B1 分支登记；
//   被返回的局部（跳过名ID）跳过释放=所有权转移给调用方（Rust move 出）。
不安全 函数 发射资源字段析构(函数IR& 函数信息, 映射<整64, 整64>& 局部槽, 整64* 寄存器计数,
                       整64 起, 整64 止, 整64 跳过名ID) -> 空类型 {
    整64 i = 止;
    当 (i > 起) {
        i--;
        整64 名ID = 函数信息.资源字段局部们.元素(i);
        // 2026-09-06 根治（T6 自举首踩）：返回语句所有权转移——被返回的含容器
        //   字段局部跳过析构（返回值已浅拷入 retbuf 共享堆指针，再析构=悬垂）
        如果 (名ID == 跳过名ID) { 继续; }
        // 79-a：入容器共享源（元素浅拷共享字段串——元素字段释放面未开=靶子）
        //   跳过字段串释放（否则元素悬垂；宁漏勿错，泄漏维持既有边界）。
        //   读镜像 当前串污染们（登记侧同经镜像——生成方法调用 作用域无 函数IR）
        如果 (是当前串污染(名ID)) { 继续; }
        整64 结构体ID = 函数信息.资源字段结构体们.元素(i);
        整64 槽 = 0;
        结果<整64, 整32> 找槽 = 局部槽.获取(名ID);
        如果 (找槽.正常) { 槽 = 找槽.值; }
        如果 (槽 != 0) {
            整64 基址reg0 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(函数信息.指令, 建IR指令(IR_取地址, 槽, 0, 0, 基址reg0, T_整64, 0));
            发射资源字段释放于地址(函数信息, 寄存器计数, 结构体ID, 基址reg0, 0);
        }
    }
}

// 块级作用域出口析构（用户裁决项2，生成块 调用）：对 容器变量们 在 基线 之后
//   新增的容器（本块声明的，逆序）发 RAII 析构并截断列表——块结束即释放；
//   ②c B：含容器字段结构体局部同款（字段基线 截断）。
//   plans/019 阶段4' 第二批：字符串基线同款——本块新增的拥有型字符串逆序
//   __cn_str_free 并截断（污染名跳过；块结束即释放——Rust 作用域 drop）。
// 73-a（2026-09-11 方案A 用户裁决）：新增 截断 参数——块出口（生成块）传 真
//   （释放并截断名单，保证外层块基线机制正确）；循环跳出 drop-on-jump 传 假
//   （同一块内的其他路径仍须发射自己的释放指令：如循环体内「如果{中断}」的
//   中断路径与自然结束路径互斥，若跳出时就截断名单，自然结束路径的块出口
//   析构将无变量可释放=该路径泄漏）。不截断模式下遍历用下标递减（不以名单
//   长度作循环条件，避免死循环）。
不安全 函数 块出口析构(函数IR& 函数信息, 映射<整64, 整64>& 局部槽, 整64* 寄存器计数,
                整64 作用域基线, 整64 字段基线, 整64 字符串基线, 布尔 截断) -> 空类型 {
    整64 串i = 函数信息.字符串变量们.大小();
    当 (串i > 字符串基线) {
        串i--;
        整64 串名ID = 函数信息.字符串变量们.元素(串i);
        结果<整64, 整32> 查污出 = 函数信息.字符串污染们.获取(串名ID);
        如果 (!查污出.正常 && !是已装箱名(串名ID)) {   // 71-a：装箱=move 转交跳过
            整64 串槽 = 0;
            结果<整64, 整32> 找串槽 = 局部槽.获取(串名ID);
            如果 (找串槽.正常) { 串槽 = 找串槽.值; } 否则 { 串槽 = 0; }
            如果 (串槽 != 0) {
                整64 串ptr = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(函数信息.指令, 建IR指令(IR_加载, 串槽, 0, 0, 串ptr, T_字符串, 0));
                IR追加(函数信息.指令, 建IR指令(IR_调用实参, 串ptr, 0, 0, 0, 0, 0));
                IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                     驻留("__cn_str_free")));
                // 73-a（幂等模型，宿主 72-a 同款）：释放后槽清零——块出口/跳出/
                //   函数级兜底多路径共享槽，清零后 __cn_str_free(nullptr) 空安全，
                //   重复经过的释放点不再二次释放（探针：容器跳出形态未清零时
                //   跳出释放 + 函数级兜底 = double free SIGSEGV 实证）
                如果 (函数信息.零寄存器 != 0) {
                    IR追加(函数信息.指令, 建IR指令(IR_存储, 函数信息.零寄存器, 0, 0,
                                         0, 0, 串槽));
                }
            }
        }
        如果 (截断) {
            结果<空类型, 整32> 删串 = 函数信息.字符串变量们.删除(
                函数信息.字符串变量们.大小() - 1);
            如果 (!删串.正常) { 运行时错误(4); }
        }
    }
    整64 容i = 函数信息.容器变量们.大小();
    当 (容i > 作用域基线) {
        容i--;
        整64 名ID = 函数信息.容器变量们.元素(容i);
        整64 槽 = 0;
        结果<整64, 整32> 找槽 = 局部槽.获取(名ID);
        如果 (找槽.正常) { 槽 = 找槽.值; }
        如果 (槽 != 0 && !是已装箱名(名ID)) {   // 71-a：装箱=move 转交跳过
            结果<整64, 整32> 查类型 = 函数信息.变量类型.获取(名ID);
            如果 (查类型.正常) {
                整64 ptr寄存器 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(函数信息.指令, 建IR指令(IR_加载, 槽, 0, 0, ptr寄存器, T_对象, 0));
                // 74-a（2026-09-11 第七十四轮）：容器元素串释放——容器拥有元素
                //   所有权（入容器位编译器接管），析构前逐元素释放（宿主
                //   emitContainerElemFreeFor 同款；原 v2 无此机制=容器元素串
                //   永不释放，探针 74-G 实证残留 2）。释放后元素槽清零在运行时
                //   辅助内完成（幂等不变量，与宿主共享同一运行时）。顺序=先元素
                //   后对象（宿主同序：元素数组先释放，再 DeleteObject 释放容器）。
                发射容器元素释放(函数信息, 寄存器计数, ptr寄存器, 查类型.值);
                IR追加(函数信息.指令, 建IR指令(IR_删除对象, ptr寄存器, 0, 0,
                                                     寄存器计数[0], 0, 查类型.值));
                寄存器计数[0] = 寄存器计数[0] + 1;
                // 73-a（幂等模型）：释放后槽清零（IR_删除对象 空安全——
                //   代码生成 test/je 跳过；多释放点共享槽不再二次释放）
                如果 (函数信息.零寄存器 != 0) {
                    IR追加(函数信息.指令, 建IR指令(IR_存储, 函数信息.零寄存器, 0, 0,
                                         0, 0, 槽));
                }
            }
        }
        如果 (截断) {
            结果<空类型, 整32> 删容 = 函数信息.容器变量们.删除(
                函数信息.容器变量们.大小() - 1);
            如果 (!删容.正常) { 运行时错误(4); }
        }
    }
    如果 (函数信息.资源字段局部们.大小() > 字段基线) {
        发射资源字段析构(函数信息, 局部槽, 寄存器计数, 字段基线,
                          函数信息.资源字段局部们.大小(), 0);
        // 截断两条跟踪列表至基线（跳出模式不截断——同块其他路径仍须发射释放）
        如果 (截断) {
            当 (函数信息.资源字段局部们.大小() > 字段基线) {
                结果<空类型, 整32> 删局 = 函数信息.资源字段局部们.删除(
                    函数信息.资源字段局部们.大小() - 1);
                如果 (!删局.正常) { 运行时错误(4); }
                结果<空类型, 整32> 删构 = 函数信息.资源字段结构体们.删除(
                    函数信息.资源字段结构体们.大小() - 1);
                如果 (!删构.正常) { 运行时错误(4); }
            }
        }
    }
}

// 73-a（2026-09-11 方案A 用户裁决）：循环跳出（中断/继续）drop-on-jump——
//   按最近循环体的三个基线（生成当 进入体块前记录）释放本轮已声明资源，
//   编译期名单**不截断**。与宿主 72-a genJumpDestructFrom(stringBase, classBase)
//   同构（Rust：break/continue 前 drop 当前作用域内已初始化值）。
不安全 函数 循环跳出析构(函数IR& 函数信息, 映射<整64, 整64>& 局部槽,
                  整64* 寄存器计数) -> 空类型 {
    块出口析构(函数信息, 局部槽, 寄存器计数,
               函数信息.循环容基线, 函数信息.循环字段基线, 函数信息.循环串基线, 假);
}

// 释放名单追加去重（73-a）：生成期登记可能与已有项同名（v2 局部槽为函数级
//   映射，同名变量合槽；预扫 已有 判定同款）——重复登记会导致同名多次释放。
函数 名单追加去重(向量<整64>& 名单, 整64 名ID) -> 空类型 {
    整64 i = 0;
    当 (i < 名单.大小()) {
        如果 (名单.元素(i) == 名ID) { 返回; }
        i++;
    }
    结果<空类型, 整32> 加 = 名单.追加(名ID);
    如果 (!加.正常) { 运行时错误(4); }
}

// 预扫容器声明：函数体块区间一次线性扫描（嵌套块/条件体语句节点均含于函数体块
//   子区间——节点池顺序追加，体块节点最后入池），为全部容器变量：分配槽 +
//   入口零初始化（未执行声明路径的槽=确定性空指针，DeleteObject 空安全跳过）+
//   登记 变量类型/容器变量们。注：同名变量（不同块）合并同槽（v2 局部槽为
//   函数级映射——精确块级作用域析构留 P7c）。
不安全 函数 预扫容器声明(向量<节点> 池, 整32 块节点, 函数IR& 函数信息,
                  整64* 槽计数, 整64* 寄存器计数) -> 空类型 {
    整64 零寄存器 = 0;
    节点 块 = 池.元素(块节点);
    整64 i = 整64(块.子起点);
    当 (i < 整64(块.子终点)) {
        节点 声明 = 池.元素(整32(i));
        如果 (声明.类型 == 节点_变量声明) {
            节点 类型节点 = 池.元素(整32(声明.附加));
            字符串 类型文本 = 字符串复制(驻留文本(整64(类型节点.文本)));
            // 引用局部（2026-09-04 IR生成.cn 冒烟根治）：绑定不拥有——槽分配/
            //   绑定存储/引用槽登记由 生成语句 引用分支自管；此处若入 RAII 名单
            //   =返回前对绑定对象（字段地址当 this）双重析构（E2E 147 探针
            //   0xC0000374 堆损坏实证）。
            如果 (是容器类(类型文本) && 类型节点.附加 != 256) {
                结果<整64, 整32> 已有 = 函数信息.局部槽.获取(整64(声明.文本));
                如果 (!已有.正常) {
                    整64 槽 = 槽计数[0];
                    槽计数[0] = 槽计数[0] + 1;
                    结果<空类型, 整32> 设槽 = 函数信息.局部槽.设置(整64(声明.文本), 槽);
                    如果 (!设槽.正常) { 运行时错误(4); }
                    IR追加(函数信息.指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽));
                    // 入口零初始化（共享一个零寄存器）
                    如果 (零寄存器 == 0) {
                        零寄存器 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(函数信息.指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0,
                                             零寄存器, T_整64, 0));
                    }
                    IR追加(函数信息.指令, 建IR指令(IR_存储, 零寄存器, 0, 0, 0, 0, 槽));
                    结果<空类型, 整32> 设类型 = 函数信息.变量类型.设置(整64(声明.文本),
                                                              整64(类型节点.文本));
                    如果 (!设类型.正常) { 运行时错误(4); }
                    // ②c D：函数级变量类型权威表（跨函数同名异型根治）
                    登记当前函数变量类型(整64(声明.文本), 整64(类型节点.文本));
                    // 2026-09-06 根治（宿主对齐·视图语义）：初值末节点=调用且非构造
                    //   调用（返回接收）→ 不入 RAII 名单。宿主实证（vieww/retown 探针
                    //   asm）：接收 rax 直用——元素(i) 返回向量内联元素地址（视图共享
                    //   写可见）、函数返回新对象（转移）——接收方一律不析构；原「接收
                    //   转移=本槽拥有」假设对元素(i) 形态=对向量内部元素 DeleteObject
                    //   →double free/堆坏（vcopy 探针 SIGSEGV 实证=v2self 符号表崩溃
                    //   同根因）。槽保留（读取/传参用，出口零值空安全）。
                    // 73-a（2026-09-11 方案A 用户裁决）：**名单登记移至生成期**——
                    //   预扫是函数级一次性扫描、先于函数体生成，若在预扫登记则 生成块
                    //   入口取基线时名单已含本块变量、基线恒等于名单大小，块出口析构
                    //   永远无新增项可释放=v2 块级 RAII 从未生效（探针 89：20 万轮
                    //   循环体拥有串残留 199999 实证）。预扫职责自此收敛为槽分配 +
                    //   入口零初始化 + 类型登记；释放名单随生成顺序追加（生成容器
                    //   局部 非返回接收分支），基线机制方能生效（Rust 作用域 drop）。
                }
            }
            // plans/019 阶段4' 第二批（2026-09-11 方案A 用户裁决）：拥有型字符串局部
            //   预扫**判定**——与容器同模型：槽预分配（生成变量声明 复用）+ 入口零初始化
            //   （未执行声明路径的槽=确定性 0，__cn_str_free 空安全跳过）+ 白名单判定
            //   （宿主第一批同构）：无初值/字面量/标识符=拥有登记；调用=内置分配族八
            //   函数（复制/连接/拼接/子串/大写/小写/修剪/反转——返回恒堆）才登记，
            //   其余调用（驻留文本/用户函数——可能返回借用包装）与下标/成员等形态
            //   一律不登记（借用保守，宁可不自动释放保安全——单 字符串 类型静态
            //   无法区分拥有/借用返回）。登记后由 生成变量声明 拥有化初始化 +
            //   生成赋值语句 拥有化赋值/污染传播 + 发射字符串释放/块出口析构 释放。
            //   引用形态（附加==256）不入（绑定不拥有）。
            //   73-a（2026-09-11 方案A 用户裁决）：**名单登记**（字符串变量们.追加）
            //   移至生成期（生成变量声明 拥有化初始化后）——预扫只判定「是否预分配
            //   槽」；预扫登记会使块出口析构基线机制失效（预扫先于函数体生成）。
            如果 (整64(类型节点.文本) == 驻留("字符串") && 类型节点.附加 != 256) {
                结果<整64, 整32> 已有串 = 函数信息.局部槽.获取(整64(声明.文本));
                如果 (!已有串.正常) {
                    布尔 拥有初值 = 真;
                    如果 (声明.子起点 < 声明.子终点) {
                        节点 初末s = 池.元素(声明.子终点 - 1);
                        如果 (初末s.类型 == 节点_调用) {
                            // 调用初值：白名单八函数 ∪ 返回类型契约（A2 2026-09-11
                            //   方案甲）：被调者返回 字符串=拥有（内置表/签名表按纯名
                            //   查——重载族返回异型为诚实边界，对齐宿主首候选口径）；
                            //   驻留文本 已改 字符* 返回=借用不登记。
                            布尔 是白名单 = 假;
                            如果 (初末s.子起点 >= 0) {
                                节点 被调s = 池.元素(整32(初末s.子起点));
                                如果 (被调s.类型 == 节点_标识符) {
                                    整64 被调名s = 整64(被调s.文本);
                                    是白名单 = 被调名s == 驻留("字符串复制") ||
                                         被调名s == 驻留("字符串连接") ||
                                         被调名s == 驻留("字符串拼接") ||
                                         被调名s == 驻留("字符串子串") ||
                                         被调名s == 驻留("字符串大写") ||
                                         被调名s == 驻留("字符串小写") ||
                                         被调名s == 驻留("字符串修剪") ||
                                         被调名s == 驻留("字符串反转");
                                            如果 (!是白名单) {
                                        // 72-a（2026-09-11 第七十二轮）：键基回退版
                                        //   （纯名查跨模块 miss=契约失效，宿主同族根治）
                                        整64 查返s = 查函数返回回退(被调名s);
                                        如果 (查返s == 驻留("字符串")) { 是白名单 = 真; }
                                    }
                                }
                            }
                            拥有初值 = 是白名单;
                        } 否则 如果 (初末s.类型 == 节点_下标 ||
                                    初末s.类型 == 节点_成员 ||
                                    初末s.类型 == 节点_解引用) {
                            // 下标/成员/解引用初值=借用（元素借出/字段视图/指针指向）
                            //   ——宿主初始化位此形态未污染（潜在缺口，v2 侧保守不登记）
                            拥有初值 = 假;
                        }
                    }
                    如果 (拥有初值) {
                        整64 槽s = 槽计数[0];
                        槽计数[0] = 槽计数[0] + 1;
                        结果<空类型, 整32> 设槽s = 函数信息.局部槽.设置(整64(声明.文本), 槽s);
                        如果 (!设槽s.正常) { 运行时错误(4); }
                        IR追加(函数信息.指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽s));
                        // 入口零初始化（与容器共用 零寄存器）
                        如果 (零寄存器 == 0) {
                            零寄存器 = 寄存器计数[0];
                            寄存器计数[0] = 寄存器计数[0] + 1;
                            IR追加(函数信息.指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0,
                                                 零寄存器, T_整64, 0));
                        }
                        IR追加(函数信息.指令, 建IR指令(IR_存储, 零寄存器, 0, 0, 0, 0, 槽s));
                        // 73-a（2026-09-11 方案A 用户裁决）：名单登记移至生成期
                        //   （生成变量声明 拥有化初始化后）——预扫登记会使 生成块
                        //   基线机制失效（详见 预扫容器声明 头部说明）
                    }
                }
            }
        }
        i++;
    }
    // 73-a：零寄存器回填——释放点清零槽复用（指令已在函数入口发射，运行期
    //   任何释放点路径均已执行过它）；无资源声明时保持 0（无释放点，无需清零）
    函数信息.零寄存器 = 零寄存器;
}

// 发射容器析构（RAII）：对本函数全部容器局部 Load 槽 + IR_删除对象。
//   代码生成展开：test/je 空安全 + call ~类(this) + call __cn_object_delete(this)。
//   ②c B：含容器字段结构体局部随后按字段逆序级联析构（发射资源字段析构 全量）。
不安全 函数 发射容器析构(函数IR& 函数信息, 向量<IR指令>& 指令, 整64* 寄存器计数,
                  映射<整64, 整64>& 局部槽, 整64 跳过名ID) -> 空类型 {
    整64 i = 0;
    当 (i < 函数信息.容器变量们.大小()) {
        整64 名ID = 函数信息.容器变量们.元素(i);
        // 2026-09-06 根治：返回语句所有权转移——被返回的容器局部跳过析构
        // 71-a：装箱（正常/某些(容器局部)）=move 转交，同跳过
        如果 (名ID == 跳过名ID || 是已装箱名(名ID)) { i++; 继续; }
        整64 槽 = 0;
        结果<整64, 整32> 找槽 = 局部槽.获取(名ID);
        如果 (找槽.正常) { 槽 = 找槽.值; }
        如果 (槽 != 0) {
            结果<整64, 整32> 查类型 = 函数信息.变量类型.获取(名ID);
            如果 (查类型.正常) {
                整64 ptr寄存器 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                // 目标=标签唯一序号（代码生成 objdel_函数序号_目标 拼标签——
                //   多容器变量同函数多条删除指令，序号须唯一否则 MASM A2005）
                IR追加(指令, 建IR指令(IR_加载, 槽, 0, 0, ptr寄存器, T_对象, 0));
                // 74-a：容器元素串释放（容器拥有元素所有权；宿主三处释放路径同款，
                //   与块出口析构同机制——plans/020 移植纪律 8「释放路径两侧对照」）
                发射容器元素释放(函数信息, 寄存器计数, ptr寄存器, 查类型.值);
                IR追加(指令, 建IR指令(IR_删除对象, ptr寄存器, 0, 0, 寄存器计数[0], 0, 查类型.值));
                寄存器计数[0] = 寄存器计数[0] + 1;
            }
        }
        i++;
    }
    // ②c B：含容器字段结构体局部（全部——返回语句跨块跳出兜底，全量逆序）
    发射资源字段析构(函数信息, 局部槽, 寄存器计数, 0, 函数信息.资源字段局部们.大小(), 跳过名ID);
}

// plans/019 阶段4' 第二批（2026-09-11 方案A 用户裁决）：拥有型字符串 RAII——
//   与 发射容器析构 同模型：对 字符串变量们 名单（预扫白名单判定后）注入
//   __cn_str_free 直调（IR_调用实参+IR_调用参数化 两指令形态——__cn_str_concat
//   先例；代码生成 __cn_ 前缀直通；空安全：__cn_str_free(nullptr) 安全跳过）；
//   污染名（字符串污染们——非拥有赋值/下标借出）与跳过名（返回标识符=所有权
//   移出，与容器析构跳过同构）一律跳过。
不安全 函数 发射字符串释放(函数IR& 函数信息, 向量<IR指令>& 指令, 整64* 寄存器计数,
                  映射<整64, 整64>& 局部槽, 整64 跳过名ID) -> 空类型 {
    整64 i = 0;
    当 (i < 函数信息.字符串变量们.大小()) {
        整64 名ID = 函数信息.字符串变量们.元素(i);
        如果 (名ID == 跳过名ID || 是已装箱名(名ID)) { i++; 继续; }   // 71-a：装箱=move 转交跳过
        结果<整64, 整32> 查污 = 函数信息.字符串污染们.获取(名ID);
        如果 (查污.正常) { i++; 继续; } 否则 { }
        整64 槽 = 0;
        结果<整64, 整32> 找槽 = 局部槽.获取(名ID);
        如果 (找槽.正常) { 槽 = 找槽.值; } 否则 { 槽 = 0; }
        如果 (槽 != 0) {
            整64 ptr寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 槽, 0, 0, ptr寄存器, T_字符串, 0));
            IR追加(指令, 建IR指令(IR_调用实参, ptr寄存器, 0, 0, 0, 0, 0));
            IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                 驻留("__cn_str_free")));
        }
        i++;
    }
}

// ==================== 指令追加辅助 ====================
// 引用传递：按值传 向量 会共享数据指针，.追加 扩容释放旧数组 -> 调用方向量悬垂。
函数 IR追加(向量<IR指令>& 列表, IR指令 指令) -> 空类型 {
    结果<空类型, 整32> 加 = 列表.追加(指令);
    如果 (!加.正常) { 运行时错误(4); }
}
函数 建IR指令(整64 操作码, 整64 操作数1, 整64 操作数2, 整64 操作数3,
              整64 目标, 整64 类型, 整64 附加) -> IR指令 {
    IR指令 指令;
    指令.操作码 = 操作码;
    指令.操作数1 = 操作数1;
    指令.操作数2 = 操作数2;
    指令.操作数3 = 操作数3;
    指令.目标 = 目标;
    指令.类型 = 类型;
    指令.附加 = 附加;
    返回 指令;
}

// ==================== 类型名 -> IR 类型码 ====================
// 源码类型名（驻留文本）-> IR 类型码（T_*）。未知返回 T_未知。
函数 类型码(整64 类型名ID) -> 整64 {
    字符串 名 = 字符串复制(驻留文本(类型名ID));
    // CN 字符串 == 是指针比较（非内容）——须用 字符串比较
    如果 (字符串比较(名, "整32")) { 返回 T_整32; }
    如果 (字符串比较(名, "整64")) { 返回 T_整64; }
    如果 (字符串比较(名, "浮32")) { 返回 T_浮32; }
    如果 (字符串比较(名, "浮64")) { 返回 T_浮64; }
    如果 (字符串比较(名, "布尔")) { 返回 T_布尔; }
    如果 (字符串比较(名, "字符串")) { 返回 T_字符串; }
    如果 (字符串比较(名, "空类型")) { 返回 T_空类型; }
    // 46-f 无符号语义轮（2026-09-10 第五十轮）：正32/正64 独立类型码（原与
    //   整64 同码归并，运算层无从分派无符号）——寄存器类型登记/二元指令
    //   类型字段经此传播，三后端按码分派 div/shr/setb 族无符号指令
    如果 (字符串比较(名, "正32")) { 返回 T_正32; }
    如果 (字符串比较(名, "正64")) { 返回 T_正64; }
    如果 (字符串比较(名, "整8") || 字符串比较(名, "整16") ||
        字符串比较(名, "正8") || 字符串比较(名, "正16") ||
        字符串比较(名, "字符") || 字符串比较(名, "指针") ||
        字符串比较(名, "自动")) { 返回 T_整64; }
    // A2：字符* 借用视图=指针单槽，与 字符串 同码（打印/拼接按字符串消费；
    //   区别只在拥有性——语义层判定，类型码层等价）
    如果 (字符串比较(名, "字符*")) { 返回 T_字符串; }
    返回 T_未知;
}


// ==================== 跨子模块访问函数（千行拆分，2026-09-08） ====================
//   生成表达式/生成语句/生成函数/语义检查 子模块经下列函数访问
//   静态表/签名表（静态表=文件级私有，跨文件仅函数可见）
函数 查静态序号(整64 名ID) -> 整64 {
    结果<整64, 整32> 查 = 静态序号们.获取(名ID);
    如果 (查.正常) { 返回 查.值; }
    返回 0 - 1;
}

函数 取静态数() -> 整64 {
    返回 静态名们.大小();
}

函数 取静态类型(整64 序) -> 整64 {
    返回 静态类型们.元素(序);
}

// 87-a：静态初值区间查询（无初值返回 -1）
函数 取静态初值起点(整64 序) -> 整64 {
    如果 (序 >= 静态初值起点们.大小()) { 返回 0 - 1; }
    返回 静态初值起点们.元素(序);
}

函数 取静态初值终点(整64 序) -> 整64 {
    如果 (序 >= 静态初值终点们.大小()) { 返回 0 - 1; }
    返回 静态初值终点们.元素(序);
}

// 87-a：静态初值是否需入口注入（结构体/字符串/折叠失败标量）
函数 取静态需注入(整64 序) -> 布尔 {
    如果 (序 >= 静态需注入们.大小()) { 返回 假; }
    返回 静态需注入们.元素(序) != 0;
}

函数 查函数签名个数(整64 键基) -> 整64 {
    结果<整64, 整32> 查 = 函数签名个数们.获取(键基);
    如果 (查.正常) { 返回 查.值; }
    返回 0 - 1;
}

函数 查函数签名参数串(整64 键) -> 整64 {
    结果<整64, 整32> 查 = 函数签名参数串们.获取(键);
    如果 (查.正常) { 返回 查.值; }
    返回 0 - 1;
}


// ==================== 81-a-v2：帧尾共享 retbuf 的「返回物化」与实参临时清理 ====================
// 立案（HANDOFF 下一轮第一优先，数据损坏级）：v2 的 retbuf 是**帧尾共享单缓冲**
//   （全部结构体/结果返回共用 `retbuf序号` 槽区，`累计retbuf字节数` 定尺寸）——
//   任何「返回值跨越另一次调用」的形态都被覆盖：
//     ① `表.追加(造盒())`（单实参）：返回句柄被外层调用的 retbuf 覆盖 → 泄漏；
//     ② `合并(造盒(1),造盒(2))`（双实参）：第二次返回覆盖第一次 → **数据损坏**
//        （实测宿主 1 / v2 0）。
//   宿主对照：宿主每次调用分配独立 `__retbufN` Alloca 槽（无共享），故无此问题。
//   Rust/LLVM 对照：sret 缓冲由**每次调用各自分配**（LLVM 语义）——本实现对齐之。
// 机制主体（甲案）= **结构体/结果返回调用发射后立即物化**：把 retbuf 内容拷进
//   「生成期临时槽」（独立槽 + 返回寄存器覆盖为槽地址）→ 每个返回值独立 ✓；
//   实参位置的消费者在外层调用发射后按登记表释放其串字段（清理调用实参临时）。
// 槽分配纪律（**独立于预扫预分配槽区**）：
//   ① 预扫（预扫容器声明/登记参数槽）分配：参数槽 + 变量槽（槽 1=retbuf 指针保留）；
//   ② 生成期新增槽（本机制的临时槽）**只用同一 `槽计数` 继续递增**——不回溯、
//      不复用已分配槽号、不与参数/变量槽区交错；
//   ③ retbuf 区由**代码生成动态计算**（`扫描函数` 的 `槽基数 = 最大槽`，retbuf 区在
//      其上）→ 任何 `IR_分配`（含本机制的临时槽）都会上移该区，两者**不可能重叠**；
//   ④ 计数器随函数生成结束即失效（无跨函数残留）；登记表在函数边界清空。
// 依赖不变量（plans/020 移植纪律 7）：
//   ①**只有真结构体**（`查结构体大小 != 0`）物化——结果/可选 合成布局与容器对象
//     返回不物化（其消费路径各异，见诚实边界）；
//   ②**匹配即删除**（实参清理）；登记表**函数边界清空**（防跨函数寄存器号误命中）；
//   ③释放只服务「纯串字段结构体」（无嵌套/结果/可选/容器字段）——越界形态留给
//     接收方接管（浅拷）或登记边界（宁漏勿错）。
静态 映射<整64, 整64> 结构体返回临时们;   // 物化后寄存器（=槽地址）→ 结构体ID

// 顺序可释放判定（84-c 扩容：字符串字段 + **嵌套结构体字段递归**）——无块结构版
//   释放（`发射串字段释放顺序`）的前提：结果/可选（联合体条件）/容器（DeleteObject）
//   字段=面外 → 整段不清理（宁漏勿错）。
//   原实现仅 `串字段数 == 资源字段数`（纯串字段结构体）→ 嵌套结构体元素（如
//   `外盒{ 内 = 内盒{ 名 = 串 } }`）判假 → 实参位置物化槽不清理（探针 P25② 泄漏）。
函数 是纯串字段结构体(整64 结构体ID) -> 布尔 {
    返回 可顺序释放结构体(整64(结构体ID), 0);
}

不安全 函数 可顺序释放结构体(整64 结构体ID, 整64 深度) -> 布尔 {
    如果 (深度 > 4) { 返回 假; }
    如果 (查结构体大小(结构体ID) == 0) { 返回 假; }
    如果 (资源字段数(结构体ID) <= 0) { 返回 假; }
    向量<整64> 字段们 = 向量<整64>();
    取资源字段们(结构体ID, 字段们);
    整64 f = 0;
    当 (f + 2 < 字段们.大小()) {
        整64 字段类型IDf = 字段们.元素(f + 1);
        字符串 类型文本f = 字符串复制(驻留文本(字段类型IDf));
        如果 (字符串比较(类型文本f, "字符串")) {
            // 串字段：可顺序释放 ✓
        } 否则 如果 (是容器类(类型文本f) || 是结果类型(类型文本f)) {
            返回 假;
        } 否则 如果 (查结构体大小(字段类型IDf) != 0) {
            如果 (!可顺序释放结构体(字段类型IDf, 深度 + 1)) { 返回 假; }
        } 否则 {
            返回 假;
        }
        f += 3;
    }
    返回 真;
}

// 82-a：把「返回类型名」限定到**被调函数的定义模块**——同名结构体的布局按模块
//   分桶独立（E2E 172：主模块 记录=4B vs 甲模块 记录=16B）；纯名在主模块上下文
//   解析会取到同名异布局类型（大小错 → 返回物化长度错，实测主侧 `甲::造甲` 的
//   返回大小被解析为 4 而非 16）。**不改返回类型表**（避免影响其它消费点）——
//   物化点单点限定：键文本含 "::" 时取模块前缀重查大小，命中才用限定名。
函数 子串位置(字符串 文本, 字符串 目标) -> 整64 {
    整64 n = 字符串长度(文本);
    整64 m = 字符串长度(目标);
    如果 (m <= 0 || m > n) { 返回 -1; }
    整64 i = 0;
    当 (i + m <= n) {
        如果 (字符串比较(字符串子串(文本, i, m), 目标)) { 返回 i; }
        i++;
    }
    返回 -1;
}

函数 限定返回类型ID(整64 函数符号, 整64 返回类型ID) -> 整64 {
    字符串 类型文本 = 字符串复制(驻留文本(返回类型ID));
    如果 (子串位置(类型文本, "::") >= 0) { 返回 返回类型ID; }
    // 函数键格式 = 键基#参数串（键基 = 模块$名 于非主模块 / 名 于主模块）——
    //   首个 '$' 之前 = 模块前缀（主模块函数无 '$' → 不限定）
    字符串 键文本 = 字符串复制(驻留文本(函数符号));
    整64 分位置 = 首分段位置(键文本);
    如果 (分位置 <= 0) { 返回 返回类型ID; }
    字符串 模块前缀 = 字符串子串(键文本, 0, 分位置);
    整64 限定ID = 驻留(字符串复制(模块前缀) + "::" + 类型文本);
    如果 (查结构体大小(限定ID) != 0) { 返回 限定ID; }
    返回 返回类型ID;
}

// 返回物化（调用发射后立即执行；独立槽=帧尾共享 retbuf 的替代）：
//   源=返回寄存器（=retbuf 地址）→ 新分配的生成期临时槽；**返回槽地址寄存器**
//   （调用方以它替换压栈的返回值——消费者/接收方拿到的是独立副本，与后续调用的
//   retbuf 无共享）。登记「槽地址寄存器 → 结构体ID」供实参位置清理消费。
//   Rust/LLVM 对照：sret 缓冲由每次调用各自分配（本实现以「每次返回调用一个新槽」
//   达成同一语义；槽号随槽计数递增，帧尺寸随之增长=正确性必要代价）。
不安全 函数 物化返回值到独立槽(向量<IR指令>& 指令, 整64* 寄存器计数,
                    整64* 槽计数, 整64 返回寄存器, 整64 结构体ID) -> 整64 {
    整64 大小 = 查结构体大小(结构体ID);
    如果 (大小 <= 0) { 返回 0; }
    整64 槽数m = (大小 + 7) / 8;
    整64 槽起 = 槽计数[0];
    槽计数[0] = 槽计数[0] + 槽数m;
    // 逐槽 IR_分配（②b B1 结构体局部同款）：扫描函数 按 附加 统计最大槽——
    //   只登记基槽会使帧尺寸少算，越界踩相邻槽
    整64 z = 0;
    当 (z < 槽数m) {
        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽起 + z));
        z++;
    }
    // **基址槽 = 槽起 + 槽数m - 1**（②b B1 约定：最大槽号=最低地址=结构体基址；
    //   槽偏移 = -(8*(最大寄存器+s)+8) 随槽号减小而升高——误用 槽起 当基址会把
    //   结构体写到相邻变量槽上（P20 实测：物化槽 -704 与 t 槽 -696 重叠 8 字节）
    整64 基槽 = 槽起 + 槽数m - 1;
    整64 槽地址reg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_取地址, 基槽, 0, 0, 槽地址reg, T_整64, 0));
    IR追加(指令, 建IR指令(IR_结构体拷贝, 返回寄存器, 槽地址reg, 0, 0, 大小, 0));
    结果<空类型, 整32> 设 = 结构体返回临时们.设置(槽地址reg, 结构体ID);
    如果 (!设.正常) { 运行时错误(4); }
    返回 槽地址reg;
}

// 顺序释放（无函数IR 上下文：不发射条件分支，不清槽——临时不再被读取）
不安全 函数 发射串字段释放顺序(向量<IR指令>& 指令, 整64* 寄存器计数,
                     整64 基址reg, 整64 结构体ID) -> 空类型 {
    向量<整64> 字段们 = 向量<整64>();
    取资源字段们(结构体ID, 字段们);
    整64 f = 0;
    当 (f + 2 < 字段们.大小()) {
        整64 偏移 = 字段们.元素(f + 2);
        整64 地址reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_字段地址, 基址reg, 0, 0, 地址reg, T_整64, 偏移));
        整64 字段类型IDs = 字段们.元素(f + 1);
        如果 (字符串比较(字符串复制(驻留文本(字段类型IDs)), "字符串")) {
            整64 串reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 地址reg, 0, 0, 串reg, T_字符串, 0));
            IR追加(指令, 建IR指令(IR_调用实参, 串reg, 0, 0, 0, 0, 0));
            IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0, 驻留("__cn_str_free")));
        } 否则 如果 (查结构体大小(字段类型IDs) != 0) {
            // 84-c：嵌套结构体字段（值语义内联）→ 以字段地址为基址递归释放
            发射串字段释放顺序(指令, 寄存器计数, 地址reg, 字段类型IDs);
        }
        f += 3;
    }
}

// 调用发射后清理本次调用的实参临时（实参寄存器命中登记表即清理，匹配即删除）
不安全 函数 清理调用实参临时(向量<整64>& 弹出们, 向量<IR指令>& 指令,
                   整64* 寄存器计数) -> 空类型 {
    整64 i = 0;
    当 (i < 弹出们.大小()) {
        整64 reg = 弹出们.元素(i);
        结果<整64, 整32> 查 = 结构体返回临时们.获取(reg);
        如果 (查.正常) {
            如果 (是纯串字段结构体(查.值)) {
                发射串字段释放顺序(指令, 寄存器计数, reg, 查.值);
            }
            布尔 删 = 结构体返回临时们.删除(reg);
        }
        i++;
    }
}
