// CN 自举编译器 v2：容器类型 IR 辅助（自举重建 P7b，2026-09-01）

// 容器类型（向量/映射/链表/栈/队列/集合/结果）类型判定、对象大小表、

// 方法签名表——IR生成.cn 的容器实例化/方法调用据此合成宿主对齐符号

// （类$方法#参数串 → nameMangle，实现链接宿主编译 obj，rustc 预编译 std 模式）。

// 契约对标：宿主 generics.cpp（实例名 类名$实参 扁平 $ 连接）、semantic.cpp

//   signatureKey（方法名#参数类型1,参数类型2）、stdlib 容器.cn/映射集合.cn

//   （方法签名与字段布局）。

// 依赖说明：IR_* 操作码/T_* 类型码/常量表 由 IR常量.cn 定义（簇① A2 单一归属）；

//   IR 指令/函数 IR 数据结构（IR指令/函数IR 结构体）自 呈报①A 根治（2026-09-05）

//   起定义在本模块（见下）——原定义在 IR生成.cn 顶层，而本模块引用它 + IR生成

//   导入本模块 = 反向引用不可导；主链靠多文件合并全局可见掩盖，冒烟子链

//   （IR容器/语法分析/语义分析 入口——链上无 IR生成.cn）结构体登记缺失 ->

//   解析方法对象类型 查结构体大小 miss = 「方法调用的对象类型未知」误诊

//   （冒烟 asm 断供；曾误归因 IR常量.cn 新增常量对，实为登记源结构性缺失）。

// 356 重构F1：本文件 IR容器签名、IR容器尾 已拆出至同目录新模块（函数体逐字搬移·零逻辑变化·声明见 包.cn）。
导入 容器::向量;

导入 映射集合;

导入 IR;         // 签名辅助 + 节点_*/T_*/IR_*/键位移/当前函数变量类型（原 IR签名+IR常量 合并目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包


公开:



// ==================== IR 数据结构（呈报①A 下沉，2026-09-05） ====================

// IR指令/函数IR 自 IR生成.cn 下沉至本模块：本模块（IR追加/建IR指令/发射容器

//   析构族）与其全部引用方（IR生成/代码生成/代码生成ARM64/代码生成共用/主）

//   的导入链均含本模块——登记源（语法分析 解析结构体声明 -> 登记结构体布局）

//   在任意冒烟子链上恒可达。程序IR 仍留 IR生成.cn（引用方链上恒含 IR生成）。

结构体 IR指令 {

    整64 操作码;

    整64 操作数1;

    整64 操作数2;

    整64 操作数3;

    整64 目标;

    整64 类型;

    整64 附加;

}



// ==================== 函数 IR ====================

// 每个函数：指令数组 + 局部槽表（名ID -> 槽索引）+ 参数槽表 + 返回类型码。

结构体 函数IR {

    向量<IR指令> 指令;

    映射<整64, 整64> 局部槽;

    映射<整64, 整64> 参数槽;

    整64 返回类型;

    整64 返回结构体ID;  // 用户函数返回结构体（2026-09-04，E2E 148）：非 0=返回

                        //   类型为该结构体——宿主 ABI 走隐藏 retbuf（位0 传入、

                        //   rax 返回）；被调方槽 1=retbuf 指针（调用方帧尾缓冲）

    整64 返回引用;      // 引用返回（2026-09-04 缺陷零容忍收口，宿主 P3-18 对齐）：

                        //   1=返回类型尾 '&'（-> 整64&）——返回语句发射被引用

                        //   左值地址（生成左值地址），调用方经指针加载读/指针

                        //   存储写（赋值目标/复合赋值）/直接绑定（引用初始化）

    整64 返回结果名ID;  // 71-a（2026-09-11 方案A 用户裁决）：返回类型为 结果/可选

                        //   合成名（结果$字符串$整32）的名ID——非 0=结果返回，与

                        //   返回结构体ID 同款 retbuf ABI（槽 1=retbuf 指针、位 0

                        //   装载、rax=retbuf；结果大小=结果大小(合成名)——结构体

                        //   表查不到 0，故独立字段不复用 ID）

    整64 返回128位;     // 810（053）：返回类型 整128/正128——1=整128/2=正128/0=非。
                        //   16 字节标量返回走 retbuf ABI（槽 1=retbuf 指针、返回
                        //   语句双半拷 16 字节、rax=retbuf·宿主 i128 sret 对齐）；
                        //   调用方 retbuf 16 字节分配+返回寄存器登记 T_整128/T_正128
                        //   （值=retbuf 地址·打印传址/赋值双半拷消费）。

    整64 返回数组字节;  // 087b（#087 余量·宿主 82984e4bbe 同构）：返回类型为数组
                        //   （"整32[3]"）——sret 第四形态（结构体/结果/128 之后）：
                        //   字节数=元素步进×长度（类型名宽度 967 折叠）、槽 1=
                        //   retbuf 指针、返回语句按字节整块拷、rax=retbuf（宿主
                        //   ir_decl sret 判定扩 isArray+structReturnSize 同面）。

    整64 返回窄宽码;    // 565 轮（T33 残余根治）：返回类型 整8/整16/正8/正16/整32/

                        //   正32 → 对应 IR 码（类型码() 对窄宽归 T_整64 不可用·

                        //   生成函数 初始化签名与返回字段 从返回类型文本登记）——

                        //   生成返回语句 标量返回按此规范化（0=非窄宽·直通）

    整32 名字;

    整64 块计数;        // P6b：块编号计数器（标签随建随取，嵌套安全）

    整64 当前块;        // P6b：当前块 ID（跳转目标；初始 0=函数入口块）

    整64 循环出口块;    // P6b：最近 当/循环 出口块（中断 跳转目标；0=无）

    整64 选择出口块;    // 376-a（D40）：最近 选择 出口块（中断 优先跳选择出口——
                        //   C break 同款：选择内 中断=跳出选择；0=不在选择内）

    整64 循环继续块;    // P6b：最近 当/循环 继续块（继续 跳转目标；0=无）

    整64 循环串基线;    // 73-a（2026-09-11 方案A 用户裁决）：进入最近循环体前的

                        //   字符串变量们 基线——中断/继续 跳出 drop-on-jump 的

                        //   释放范围起点（生成当 保存/恢复，嵌套循环自然正确）

    整64 循环容基线;    // 73-a：容器变量们 基线（同上）

    整64 循环字段基线;  // 73-a：资源字段局部们 基线（同上）

    整64 函数尾块;      // 缺陷A根治（2026-09-02）：函数尾块——IR_返回 后跳转至此，

                        //   标签在函数体末发射（epilogue 唯一，中途回退不再穿透）

    映射<整64, 整64> 变量类型;    // P7b：变量名ID -> 类型名ID（容器/结果成员访问与方法解析）

    映射<整64, 整64> 结果预扫基们;  // 1302：结果/可选 局部**声明身份键**（初值终索引）-> 预扫基槽。

                                //   身份键而非名键：同名重绑定后名键会指到他人槽（P0-1 实测

                                //   宿主42→v2 112/0）；身份键保证每个声明独立预扫槽，互不串扰。

                                //   预扫**不写** 局部槽/变量类型——绑定由声明生成点单点登记。

    向量<整64> 字符串变量们;     // plans/019 阶段4' 第二批：拥有型字符串局部名单（白名单判定后）

    映射<整64, 整64> 字符串污染们;  // plans/019 阶段4' 第二批：污染名ID -> 1（非拥有赋值/

                                //   下标借出——释放挂点一律跳过，宿主 stringTainted_ 同构）

    向量<整64> 容器变量们;        // P7b：容器变量名ID 列表（RAII 返回前析构遍历）

    向量<整64> 字符串数组变量们;  // 98-a（C9）：**字符串元素数组**局部名ID 列表——

                                //   块出口/跳出/函数尾逐元素 __cn_str_free（编译期

                                //   展开 N 次；元素槽释放+清零=幂等模型）。与

                                //   字符串变量们 同基线/截断纪律（块出口按基线截断）

    整64 循环数组串基线;          // 98-a：中断/继续 跳出 drop-on-jump 的数组串

                                //   释放范围起点（生成当 保存/恢复，同 循环串基线）

    // 1415（#1415 P1）：选择体基线四枚——选择内 中断（跳出选择）drop-on-jump
    //   的释放范围起点（生成选择语句 各 case/默认体块前记录·嵌套保存/恢复）。
    //   与循环基线分离：选择内中断只退选择、不退出循环，不得释放循环体资源。
    整64 选择串基线;

    整64 选择容基线;

    整64 选择字段基线;

    整64 选择数组串基线;

    向量<整64> 资源字段局部们;    // ②c B：含容器字段的结构体局部名ID（块出口级联析构）

    向量<整64> 资源字段结构体们;  // ②c B：对应结构体名ID（与 资源字段局部们 同下标）

    整64 retbuf字节数;    // ②b B6：本函数 retbuf 调用最大返回字节数（帧尺寸依据；

                        //   生成函数 出口自 当前retbuf字节数 回填）

    向量<整64> 参数槽序们;        // ②b B8：参数按声明序的基槽（多槽结构体参数=最大槽号）

    向量<整64> 参数拷贝字节们;    // ②b B8：参数按声明序的 prologue 拷贝字节数

                                //   （0=标量直存；>0=结构体按值：指针入参 -> 多槽拷贝）

    向量<整64> 参数类型们;        // 91-a（2026-09-13 第九十一轮）：参数按声明序的类型码

                                //   （T_* 标量码；引用/指针/结构体按值=地址传递标

                                //   T_整64）——序言参数装载按码分派寄存器类：

                                //   T_浮32/T_浮64 -> xmm/d 寄存器（SysV/AAPCS64 浮点

                                //   参数独立计数），其余 -> 整型寄存器。与宿主

                                //   emitParamSetup isFloatType 分派同构

    整64 零寄存器;        // 73-a（2026-09-11 方案A 用户裁决）：函数入口常量 0 的

                        //   寄存器号（预扫 无资源声明时为 0=未分配）——释放点

                        //   清零槽用（释放+清零幂等模型：跳出释放/块出口释放后

                        //   槽清零，函数级兜底再次经过时读 0=空安全跳过，杜绝

                        //   双释；宿主 72-a 同款）。该指令位于函数入口必经路径，

                        //   任何释放点的运行期路径都已执行过它。

}



// ==================== 方法返回形态 ====================

常量 容器返回_标量 = 0;     // 标量返回 rax（大小/元素/为空/包含/删除(K) 布尔）

常量 容器返回_结果空 = 1;   // 结果<空类型,整32>：隐藏返回指针，12 字节（追加/删除(i)/设置/插入/预留）

常量 容器返回_结果值 = 2;   // 结果<T,整32>：隐藏返回指针（读取/获取/弹出/栈顶/出队/队首）

常量 容器返回_空类型 = 3;   // 无返回值（清空）

常量 容器返回_结构体 = 4;   // ②b B2（2026-09-02）：T 为结构体的按值返回（元素(位置)->T）——

                           //   隐藏返回指针，调用后 rax/x0=缓冲地址即结构体地址（宿主

                           //   epilogue mov x0,x19 / win rax 同款），链式 .字段 以此为基址



// ==================== 实例实参再切分（②c A，2026-09-02） ====================

// $ 扁平合成名的实参串按基名元数贪婪再切分：向量$映射$整64$整64 -> ["映射$整64$整64"]、

//   映射$整64$整64 -> ["整64","整64"]。朴素 '$' 切分对嵌套实参必错（单参 T 被切成

//   首段 "映射"），方法符号（#参数串）与返回类型推导双双失真（对标宿主 AST 级

//   实例化——扁平串须按元数还原）。

函数 基名元数(字符串 基名) -> 整64 {

    如果 (字符串比较(基名, "映射") || 字符串比较(基名, "结果")) { 返回 2; }

    返回 1;

}



// 实例化基名（容器 + 结果/可选 + 字符串映射——参与实参段的递归消费）

// 1611（2026-10-25·1025 采样轮 d4/d5 实锚）：白名单补「字符串映射」——

//   131 甲' 新增泛型类（单参）未同步进 ②c A 实例实参再切分两表（是实例化

//   基名/基名元数），「结果$字符串映射$整32$整32」再切分得

//   [字符串映射,整32,整32] 三段（嵌套载荷「字符串映射$整32」被平拆）→

//   装箱 T/E 切分/方法接收者推导（107b）全链取到裸基名 → 拷贝构造/获取

//   接收者/析构 符号修饰缺实例段 → LNK2019×N。语法面 泛型基类参数个数

//   （查泛型基类参数序·解析泛型声明登记）本就含 字符串映射=两白名单不一致

//   即分叉源；剥实例参数段（克隆器）对 字符串映射 嵌套一直正确=定义侧符号

//   完整而调用侧缺段的双侧分叉铁证。

函数 是实例化基名(字符串 名) -> 布尔 {

    返回 是容器基名(名) || 字符串比较(名, "结果") || 字符串比较(名, "可选") ||

          字符串比较(名, "字符串映射");

}



// 解析 [位置..] 为一个实参段：标识符词（含数字——类型名 整64/浮32/整128 等）；

//   实例化基名递归消费其元数个实参段；尾缀 '*'/'&' 字节原样并入。位置 出参推进

//  （调用方保证 '$' 分隔已消费）。

不安全 函数 解析实参段(字符串 实参串, 整64* 位置) -> 字符串 {

    整64 i = 位置[0];

    整64 n = 字符串长度(实参串);

    // 872（074 波2）：逐字节词拼接 O(L²)→字符串构建器 O(L)（段拼接 k 小保留）
    整64 构建词 = 字符串构建器::新建();

    当 (i < n) {

        整64 字节 = 整64(实参串[i]) & 255;

        布尔 词字节 = 字节 >= 128 || (字节 >= 48 && 字节 <= 57) ||

                      (字节 >= 65 && 字节 <= 90) ||

                      (字节 >= 97 && 字节 <= 122) || 字节 == 95;

        如果 (词字节) {

            字符串构建器::追加字节(构建词, 字节);

            i++;

        } 否则 {

            中断;

        }

    }

    字符串 词 = 字符串构建器::完成(构建词);

    如果 (字符串长度(词) == 0) { 返回 ""; }

    如果 (是实例化基名(词)) {

        整64 元 = 基名元数(词);

        整64 k = 0;

        当 (k < 元) {

            // 期望 '$' 分隔（防御：不足则停止）

            如果 (i < n) {

                整64 分隔 = 整64(实参串[i]) & 255;

                如果 (分隔 == 36) { i++; }

            }

            位置[0] = i;

            字符串 子段 = 解析实参段(实参串, 位置);

            如果 (字符串长度(子段) == 0) { 中断; }

            词 = 词 + "$" + 子段;

            i = 位置[0];

            k++;

        }

    }

    // 尾缀 '*'(42) / '&'(38) 原样并入（指针/引用形实参）

    当 (i < n) {

        整64 后缀 = 整64(实参串[i]) & 255;

        如果 (后缀 == 42 || 后缀 == 38) {

            词 = 词 + 字符串子串(实参串, i, 1);

            i++;

        } 否则 {

            中断;

        }

    }

    位置[0] = i;

    返回 词;

}



// 取实例实参们：跳过基名首段，按元数贪婪切分全部实参（返回向量）

函数 取实例实参们(字符串 合成名) -> 向量<字符串> {

    向量<字符串> 实参们 = 向量<字符串>();

    // 720-a（713-a 平台覆盖缺口·linux/arm64 GAS 面补修）：剥合成名尾 '&'——
    //   引用接收者的类型文本带引用修饰（如 向量<映射<整64,符号>>&），直接切分时
    //   尾 '&' 被 解析实参段 的「尾缀并入」吃进末段实参（"映射$整64$符号&"）→
    //   类型实参替换后 参数串 带 '&' → 符号修饰多编码一个 'A'（追加_A_T vs
    //   追加__T）→ 调用点与克隆体定义点符号分叉 → cn_self 链接 undefined
    //   （79_v2/M4）。713-a 在 win 面以「符号修饰参数段剥 &」消解·linux/arm64
    //   GAS 后端未覆盖（且那层剥会连真引用参数段的 A 编码一并剥掉——宿主
    //   linux 实测 表压入（引用形参）=带 A、追加（按值形参）=无 A，须保留）。
    //   本修复=IR 层精确剥：实例身份不含引用修饰（713 ① 同源口径·循环剥多层
    //   防二级引用），切分前归一。
    字符串 干净名 = 字符串复制(合成名);

    整64 长g = 字符串长度(干净名);

    当 (长g > 1 && ((整64(干净名[整32(长g - 1)]) & 255) == 38)) {

        字符串 剥后 = 字符串子串(干净名, 0, 整32(长g - 1));

        干净名 = 剥后;

        长g--;

    }

    可选<整64> 首查 = 首分段位置(干净名);

    如果 (!首查.有值) { 返回 实参们; }

    整64 首 = 首查.值;

    整64 i = 首 + 1;

    整64 n = 字符串长度(干净名);

    当 (i < n) {

        整64 位置 = i;

        字符串 段 = 解析实参段(干净名, &位置);

        如果 (字符串长度(段) == 0) { 中断; }

        // A2：段 是循环内登记变量（返回块 RAII 释放末迭代值）——入容器显式

        //   复制，防向量元素悬垂（浅共享×源释放）。

        结果<空类型, 整32> 加段 = 实参们.追加(字符串复制(段));

        如果 (!加段.正常) { 运行时错误(4); }

        i = 位置;

        // 期望 '$' 分隔或结束

        如果 (i < n) {

            整64 分隔 = 整64(干净名[i]) & 255;

            如果 (分隔 == 36) { i++; }

        }

    }

    返回 实参们;

}



// ==================== 顶层静态声明表（②c C，2026-09-02） ====================

// 任务级生命周期：名ID -> 序号（IR 标识符解析）；名/类型平铺（入口构造注入）；

//   IR生成 入口收集（先清空，幂等）。存储=双后端 .data _cn_gstatic_<序号> 槽

//   （统一指针槽：容器=堆对象指针；标量=初始值——.data 直存折叠字面量）。

静态 映射<整64, 整64> 静态序号们;



// IR 层错误计数与统一诊断（2026-09-04，IR生成.cn 冒烟 [ir2] 纪律收口）：

//   [ir2] 级诊断=IR 不完整（形态不支持/目标未解析）——产物不可信。对齐

//   「语义错误即中止」（E2E 139 纪律）：主.cn 于 IR 生成后检查计数>0 即

//   中止（不产 asm）。单一归属本组件（IR生成/IR容器 诊断点全部经此计数）。

静态 整64 IR层错误计数 = 0;



不安全 函数 IR层诊断(字符串 消息) -> 空类型 {

    IR层错误计数 = IR层错误计数 + 1;

    IO::打印到错误("[ir2] " + 消息 + "\n");

}



函数 取IR层错误数() -> 整64 {

    返回 IR层错误计数;

}



不安全 函数 清空IR层错误计数() -> 空类型 {

    IR层错误计数 = 0;

}

静态 向量<整64> 静态名们;

静态 向量<整64> 静态类型们;

// 87-a（2026-09-12 第八十七轮）：静态初值区间表（每静态 2 项：起点、终点；

//   无初值 = -1/-1）。结构体静态的初值不可 .data 直存（须入口注入逐字段构造/

//   整体拷贝），注入点在 生成函数 的主入口——须按序号回查 AST 初值区间。

静态 向量<整64> 静态初值起点们;

静态 向量<整64> 静态初值终点们;

// 87-a（2026-09-12 第八十七轮）：静态需注入表（1=初值不可 .data 直存，须入口

//   物化）。覆盖：结构体（逐字段构造/整体拷贝）、字符串（驻留/堆串）、以及

//   折叠失败的标量（布尔/浮点/字符字面量——折叠常量值 只认整数文本，原实现

//   静默落 .data 0 = 初值丢失，探针实证 布尔=假/浮=0）。容器类经 NewObject

//   注入（原路径），不入本表。

静态 向量<整64> 静态需注入们;

// 852（2026-10-16·843 呈报）：静态守卫初始化表（1=函数内静态+非常量初值）——
//   运行期初始化由**声明所在函数的语句流守卫块**承担（首调经过声明点快照·
//   665 先例+001 §5.2a「经注入通道」）。原路径进主函数入口注入=在主函数
//   上下文求值初值——引用同函数局部名时查无此名→按未知名发射 _名 全局
//   符号=链接失败（S2/S7 探针·1006 用例实录）。

静态 向量<整64> 静态守卫标记们;



不安全 函数 清空静态表() -> 空类型 {

    静态序号们.清空();

    静态名们 = 向量<整64>();

    静态类型们 = 向量<整64>();

    静态初值起点们 = 向量<整64>();

    静态初值终点们 = 向量<整64>();

    静态需注入们 = 向量<整64>();

    静态守卫标记们 = 向量<整64>();

}



// 收集一个 程序 节点区间的全部静态声明（容器/标量通用——初始值折叠由 IR生成 完成）

// ==================== 070 波G（1026 深度机）：类静态字段 ====================
// 静态 字段=全类共享 .data 槽——**合成名「类$字段」注册顶层静态全链**（静态名们/
//   类型们/序号/初始值·与 收集静态 同构单追加）——静态地址/加载/存储/数据段发射
//   零改动复用。解析期登记 名/类型/初值文本（三表+序驱动向量）；IR生成 收集静态
//   后 补登类静态字段（序号接续顶层——槽布局一致）。
静态 映射<整64, 整64> 类静态字段合成名们;   // 类ID*键位移+字段ID -> 合成名ID（类$字段）
静态 映射<整64, 整64> 类静态字段类型们;     // 同键 -> 类型名ID
静态 映射<整64, 整64> 类静态字段初值们;     // 同键 -> 初值文本ID（0=无初值按 0）
静态 向量<整64> 类静态字段序们;             // 组合键（类ID*键位移+字段ID·解析序·补登遍历驱动）

不安全 函数 清空类静态字段表() -> 空类型 {
    类静态字段合成名们.清空();
    类静态字段类型们.清空();
    类静态字段初值们.清空();
    整64 n = 类静态字段序们.大小();
    当 (n > 0) {
        结果<空类型, 整32> 删 = 类静态字段序们.删除(n - 1);
        如果 (!删.正常) { 运行时错误(4); }
        n--;
    }
}

// 解析期登记（解析类声明 静态字段分支消费）——合成名注册+三表+序驱动
不安全 函数 登记类静态字段(整64 类名ID, 整64 字段名ID, 整64 类型名ID, 字符串 初值文本) -> 空类型 {
    字符串 合成 = 字符串复制(驻留文本(类名ID)) + "$" + 字符串复制(驻留文本(字段名ID));
    整64 合成ID = 驻留(合成);
    整64 组合键 = 类名ID * 键位移 + 字段名ID;
    结果<空类型, 整32> 设1 = 类静态字段合成名们.设置(组合键, 合成ID);
    如果 (!设1.正常) { 运行时错误(4); }
    结果<空类型, 整32> 设2 = 类静态字段类型们.设置(组合键, 类型名ID);
    如果 (!设2.正常) { 运行时错误(4); }
    结果<空类型, 整32> 设3 = 类静态字段初值们.设置(组合键, 驻留(初值文本));
    如果 (!设3.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加序 = 类静态字段序们.追加(组合键);
    如果 (!加序.正常) { 运行时错误(4); }
}

// 查类静态字段类型（未命中/非静态字段 → 错误通道·1240 结果化——静态序号补登在 IR 期不可依赖）
函数 查类静态字段类型(整64 类名ID, 整64 字段名ID) -> 结果<整64, 整32> {
    结果<整64, 整32> 查 = 类静态字段类型们.获取(类名ID * 键位移 + 字段名ID);
    如果 (查.正常) { 返回 正常(查.值); }
    // 静默豁免业务值: 查表 miss=错误通道（1360 批5 表轮·develop 存量显形补·PRE-1a）
    否则 { 返回 错误(1); }
}

// 查类静态字段合成名（未命中/非静态字段 → 错误通道）——类内裸名/类名.字段 两消费口径共用
函数 查类静态字段合成名(整64 类名ID, 整64 字段名ID) -> 结果<整64, 整32> {
    结果<整64, 整32> 查 = 类静态字段合成名们.获取(类名ID * 键位移 + 字段名ID);
    如果 (查.正常) { 返回 正常(查.值); }
    // 静默豁免业务值: 查表 miss=错误通道（1360 批5 表轮·develop 存量显形补·PRE-1a）
    否则 { 返回 错误(1); }
}

// 434（类名::静态字段 限定读写·#284 ::矩阵第五态）：限定复合名「类名::字段」
//   → 类静态字段类型（0=非限定形态/非用户类/非类静态字段）。宿主侧 `类名::成员`
//   与 `类名.成员` 同通道折叠 MemberExpr（语义/IR 零分叉锚：292/561 点号全绿），
//   v2 词法把限定名折成一个复合文本标识符——语义 5 处（读/写语句位/链式位/
//   自增/自减）经本判定统一回退，判定单一归属防各消费点口径漂移。
// （1240 结果化·9008：未命中 → 错误通道；1=非限定形态 / 2=非用户类 / 3=非类静态字段）
函数 查限定名静态字段类型(整64 名ID) -> 结果<整64, 整32> {
    字符串 限模t = "";
    字符串 限符t = "";
    如果 (拆限定名(字符串复制(驻留文本(名ID)), 限模t, 限符t) != 1) { 返回 错误(1); }
    整64 类IDt = 驻留(限模t);
    如果 (!是用户类_ID(类IDt)) { 返回 错误(2); }
    结果<整64, 整32> 合成t = 查类静态字段合成名(类IDt, 驻留(限符t));
    如果 (!合成t.正常) { 返回 错误(3); }
    返回 查类静态字段类型(类IDt, 驻留(限符t));
}

// 433（002 收口·lambda 值捕获结构体 701）：lambda 捕获形参类型跨层静态表——
//   语义检查lambda 的捕获类型回填写的是**层间按值池**（对 IR 层不可见·
//   生成声明 46-c 同款坑），IR 生成合成函数时捕获形参 附加=0＝无类型节点→
//   登记参数槽 按无类型标量单槽登记→闭包体 p.x 的 解析对象结构体ID miss
//   →「成员字段偏移未知: .x」。表：合成函数名ID*键位移+捕获名ID → 捕型ID
//   （语义回填时登记·登记参数槽 类型节点缺失时查表合成替身·46-c 跨层
//   静态表 同模式——推断声明类型表 先例）。
静态 映射<整64, 整64> lambda捕获参数类型们;

// 457（462-② 同键平行表）：lambda 捕获形参类型**附加位**跨层静态表——
//   433 主表只存捕型基名文本（符号类型ID=剥星基名·55-c 口径），指针层/
//   引用标记（附加=指针层 1..255·引用 256）丢失→指针捕获调用点/快照段
//   按基名误判（捕 点* 判结构体取快照槽地址·快照固化 T_整32 截断指针
//   SEGV·801c 实录）；替身/调用点/蹦床按本表恢复附加位（语义回填时同键
//   登记·解析类型 惯例：附加=指针层+引用×256）。
静态 映射<整64, 整64> lambda捕获参数附加们;

// 登记 lambda 捕获形参类型+附加位（语义检查lambda 回填时调用·IR 层
//   登记参数槽/调用点/蹦床 消费）
不安全 函数 登记lambda捕获参数类型(整64 合成函数名ID, 整64 捕获名ID, 整64 捕型ID,
                      整64 附加位457) -> 空类型 {
    结果<空类型, 整32> 加433 = lambda捕获参数类型们.设置(
        合成函数名ID * 键位移 + 捕获名ID, 捕型ID);
    如果 (!加433.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加附457 = lambda捕获参数附加们.设置(
        合成函数名ID * 键位移 + 捕获名ID, 附加位457);
    如果 (!加附457.正常) { 运行时错误(4); }
}

// 查 lambda 捕获形参类型（未登记/非 lambda 形态 → 错误通道·1238 兜底禁令/1240 替代）
函数 查lambda捕获参数类型(整64 合成函数名ID, 整64 捕获名ID) -> 结果<整64, 整32> {
    结果<整64, 整32> 查433 = lambda捕获参数类型们.获取(合成函数名ID * 键位移 + 捕获名ID);
    如果 (查433.正常) { 返回 正常(查433.值); }
    // 静默豁免业务值: 查表 miss=错误通道（1360 批5 表轮·develop 存量显形补·PRE-1a）
    否则 { 返回 错误(1); }
}

// 查 lambda 捕获形参附加位（未登记 → 错误通道；正常 0=值捕获标量·1..255=指针层·>=256=引用）
函数 查lambda捕获参数附加(整64 合成函数名ID, 整64 捕获名ID) -> 结果<整64, 整32> {
    结果<整64, 整32> 查附457 = lambda捕获参数附加们.获取(合成函数名ID * 键位移 + 捕获名ID);
    如果 (查附457.正常) { 返回 正常(查附457.值); }
    // 静默豁免业务值: 查表 miss=错误通道（1360 批5 表轮·develop 存量显形补·PRE-1a）
    否则 { 返回 错误(1); }
