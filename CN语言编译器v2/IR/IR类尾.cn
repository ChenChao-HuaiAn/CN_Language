// IR类尾（357 重构F2 自 IR类.cn 纯机械搬移·函数体逐字保留·零逻辑变化）

导入 映射集合;
导入 协议常量;   // 键位移（335：协议常量独立包）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

函数 克隆泛型函数节点(向量<节点> 池, 整32 函数节点索引, 整64 实例ID,
                   向量<整64>& 参数名ID们, 向量<整64>& 实参ID们) -> 整32 {
    节点 基函数节点c = 池.元素(函数节点索引);
    整64 旧起c = 整64(基函数节点c.子起点);
    整64 旧终c = 整64(基函数节点c.子终点);   // =块节点索引（单点）
    // 420-a 根治：克隆区间 **闭式含块**——原 [旧起, 旧终) 漏块节点→克隆体无
    //   体块→生成块 拿参数节点当块=空体（返回 长度 读 0/数组[0] 读垃圾 184
    //   实测）。函数节点.子终点=块索引 单点语义（区别于类节点的区间终点）。
    旧终c = 旧终c + 1;
    映射<整64, 整64> 索引映射c;
    整64 ic = 旧起c;
    当 (ic < 旧终c) {
        节点 nc = 池.元素(整32(ic));
        如果 (nc.类型 == 节点_类型) {
            字符串 原文本c = 字符串复制(驻留文本(整64(nc.文本)));
            字符串 新文本c = 替换实例类型文本(原文本c, 参数名ID们, 实参ID们);
            如果 (!字符串比较(新文本c, 原文本c)) {
                nc.文本 = 整32(驻留(新文本c));
            }
        }
        // 437（wt437·函数克隆器标识符位替换）：泛型函数体内**合成名标识符**
        //   （`向量<T>()` 构造调用被调=节点_标识符 文本=向量$T）原漏替换——
        //   克隆体调用 向量$T$向量/追加/~向量 未绑定符号 → 链接 LNK2019 三缺
        //   （421 ④单元素<整32> 实录；对照实验实证修复前 develop 同红=存量
        //   缺口非本任务回归）。对齐 克隆泛型类节点 421-a 标识符位替换分支
        //   （同款精确匹配 替换实例类型文本——仅命中参数名段，非泛型标识符
        //   零改动；裸参数名快照顶层伪实例照 423 判定跳过不受影响——克隆体
        //   内替换完成=真实展开）。
        如果 (nc.类型 == 节点_标识符) {
            字符串 原标识c = 字符串复制(驻留文本(整64(nc.文本)));
            字符串 新标识c = 替换实例类型文本(原标识c, 参数名ID们, 实参ID们);
            如果 (!字符串比较(新标识c, 原标识c)) {
                nc.文本 = 整32(驻留(新标识c));
            }
        }
        整64 新索引c = 池.大小();
        池追加(池, nc);
        结果<空类型, 整32> 设mc = 索引映射c.设置(ic, 新索引c);
        如果 (!设mc.正常) { 运行时错误(4); }
        ic++;
    }
    ic = 旧起c;
    当 (ic < 旧终c) {
        结果<整64, 整32> 查mc = 索引映射c.获取(ic);
        如果 (查mc.正常) {
        节点 n2c = 池.元素(整32(查mc.值));
        // 432-b 根治：函数克隆器遍 2 接共享 克隆节点修针（430-b 的替换误命中
        //   类克隆器新文本二次替换·本器漏改——raw-$T/绑定函数克隆体控制流
        //   文本/附加仍指基函数区=「向量类克隆野走」真身：野走宿主符号=类方法
        //   是静态残留假象，真走点=查找值位置$* 克隆体的如果条件混合区间）
        n2c = 克隆节点修针(索引映射c, n2c, 参数名ID们, 实参ID们);
        结果<空类型, 整32> 设w2c = 池.设置(整32(查mc.值), n2c);
        如果 (!设w2c.正常) { 运行时错误(4); }
        }
        否则 {
        }
        ic++;
    }
    // 实例函数节点（文本=实例合成名ID·附加=替换后返回类型·区间=克隆体）
    整64 原返c = 整64(基函数节点c.附加);
    整64 新返c = 0;
    如果 (原返c > 0) {
        字符串 返原c = 字符串复制(驻留文本(原返c));
        字符串 返新c = 替换实例类型文本(返原c, 参数名ID们, 实参ID们);
        新返c = 整64(驻留(返新c));
    }
    结果<整64, 整32> 查fc2 = 索引映射c.获取(旧起c);
    结果<整64, 整32> 查lc2 = 索引映射c.获取(旧终c - 1);
    整64 新起f2 = 0;
    如果 (查fc2.正常) { 新起f2 = 查fc2.值; } 否则 { }
    整64 新终l2 = 0;
    如果 (查lc2.正常) { 新终l2 = 查lc2.值; } 否则 { }
    节点 实例函数节点c;
    实例函数节点c.类型 = 节点_函数;
    实例函数节点c.文本 = 整32(实例ID);
    实例函数节点c.附加 = 整32(新返c);
    实例函数节点c.子起点 = 整32(新起f2);
    // 子终点=块节点索引（单点语义·非区间+1）——生成函数 按 块.子起点 定参数
    //   终点、按 块索引 取体块；+1 即指向垃圾节点=参数遍历区间错位+体块错
    //   （420-a gdb/asm 铁证：prologue 参数读 [rbp+288]·槽序错位 ~30）
    实例函数节点c.子终点 = 整32(新终l2);
    实例函数节点c.行 = 0;
    实例函数节点c.修饰 = 基函数节点c.修饰;
    整32 克隆索引c = 整32(池.大小());
    池追加(池, 实例函数节点c);
    返回 克隆索引c;
}

// 419-a：函数实例化总编排（IR生成多文件 收集阶段·实例类注册 后调用）：
//   逐实例（剥基名→泛型函数参数序命中=函数实例）→定位基函数节点→克隆→
//   函数节点平行表（生成期 生成遍历分派消费）。类实例由 实例化注册 处理
//   （剥基名查 用户类们——两编排互斥判定）。
不安全 函数 实例化函数注册(向量<节点> 池, 向量<整32> 程序节点们, 向量<字符串> 模块路径们) -> 空类型 {
    整64 n = 泛型实例们.大小();
    整64 i = 0;
    当 (i < n) {
        整64 实例IDr = 泛型实例们.元素(i);
        字符串 实例文本r = 字符串复制(驻留文本(实例IDr));
        字符串 基名r = 剥实例基名(实例文本r);
        整64 基名IDr = 整64(驻留(基名r));
        整64 参数序IDr = 查泛型基类参数序(基名IDr);
        如果 (参数序IDr == 0) { i++; 继续; }
        如果 (是用户类ID(基名IDr)) { i++; 继续; }   // 类实例=实例化注册 已处理
        // 参数名/实参段拆分
        向量<整64> 参数名们r2 = 向量<整64>();
        向量<整64> 实参们r2 = 向量<整64>();
        字符串 参数串文本r2 = 字符串复制(驻留文本(参数序IDr));
        整64 段起r2 = 0;
        整64 cr2 = 0;
        当 (cr2 <= 字符串长度(参数串文本r2)) {
            如果 (cr2 == 字符串长度(参数串文本r2) ||
                 ((整64(参数串文本r2[整32(cr2)]) & 255) == 44)) {
                如果 (cr2 > 段起r2) {
                    结果<空类型, 整32> 加nr2 = 参数名们r2.追加(整64(驻留(字符串子串(参数串文本r2, 整32(段起r2), 整32(cr2 - 段起r2)))));
                    如果 (!加nr2.正常) { 运行时错误(4); }
                }
                段起r2 = cr2 + 1;
            }
            cr2++;
        }
        剥实例参数段(实例文本r, 实参们r2);
        如果 (参数名们r2.大小() != 实参们r2.大小()) {
            IR层诊断("泛型函数实例实参与参数序不匹配: " + 实例文本r);
            运行时错误(6);
        }
        // 423（任务 421）：裸参数名实参=未绑定伪函数实例（恒等<T> 等形态）
        //   ——判定单一归属 是伪实例423（IR类.cn·审查 P1-1 去重），顶层
        //   零注册（防 T→T 自绑定→类型名宽度 无限自递归爆栈）。
        如果 (是伪实例423(实参们r2, 参数名们r2)) {
            i++;
            继续;
        }
        // 定位基函数节点
        整32 基函数索引r = 0 - 1;
        整64 基模块序1011 = 0;   // 1011（43）：基函数归属文件序（克隆签名键基/
        //   返回类型登记须用基函数所在模块——原恒主模块键基=跨模块泛型实例
        //   调用侧键基错位〔模块甲$最大值$浮64 vs 主$…〕→查返回类型 miss）
        整64 f = 0;
        当 (f < 程序节点们.大小() && 基函数索引r == 0 - 1) {
            节点 程序声明r = 池.元素(程序节点们.元素(整32(f)));
            整64 位置r = 整64(程序声明r.子起点);
            整64 终点r = 整64(程序声明r.子终点);
            当 (位置r < 终点r) {
                节点 声明r = 池.元素(整32(位置r));
                如果 (声明r.类型 == 节点_函数 && 整64(声明r.文本) == 基名IDr) {
                    基函数索引r = 整32(位置r);
                    基模块序1011 = f;
                    中断;
                }
                位置r++;
            }
            f++;
        }
        如果 (基函数索引r == 0 - 1) {
            i++; 继续;
        }
        // 415（wt415）：克隆首记录（嵌套泛型调用扫描区间下界——克隆体=池尾追加
        //   [克隆首,克隆索引] 闭式含函数节点）
        整64 克隆首415 = 池.大小();
        整32 克隆索引r = 克隆泛型函数节点(池, 基函数索引r, 实例IDr, 参数名们r2, 实参们r2);
        // 签名表登记（克隆体·替换后参数串）——调用侧 决议函数符号 与定义侧
        //   函数签名键 同公式同源（缺失=调用侧裸名 call vs 定义侧类型编码
        //   符号·链接 undefined 的根因）
        字符串 基模块路径1011 = 模块路径们.元素(整32(基模块序1011));
        登记函数签名K(池, 克隆索引r, 键基合成(基模块路径1011, 实例IDr));
        // 1011（43·跨模块浮点返回 rax 接收根治）：实例克隆体返回类型登记
        //   函数返回类型们——收集函数返回类型 只扫源码 节点_函数（克隆体
        //   不在源码）→调用侧 查函数返回类型 miss → IR_调用参数化 返回码 0
        //   → rax 接收（浮64 返回在 xmm0→读垃圾·打印 0.000000·linux 实锤；
        //   win「绿」=巧合：被调内 rax 残留恰为浮点位模式）。克隆体 附加=
        //   替换后返回类型（克隆泛型函数节点 已做 T→实参替换）。
        {
            节点 克隆声明1011 = 池.元素(克隆索引r);
            如果 (整64(克隆声明1011.附加) > 0) {
                整64 签名键1011 = 函数签名键(键基合成(基模块路径1011, 实例IDr),
                                             函数参数串(池, 克隆索引r));
                结果<空类型, 整32> 设返1011 = 函数返回类型们.设置(
                    签名键1011, 整64(克隆声明1011.附加));
                如果 (!设返1011.正常) { 运行时错误(4); }
                // 合成名纯名键（名 ID 直登——调用侧纯名/合成名决议回退键基 miss
                //   时按名 ID 查〔43 主.cn 纯名 最大值<浮64> 实测路径〕；实例
                //   合成名全局唯一=零歧义）
                结果<空类型, 整32> 设返名1011 = 函数返回类型们.设置(
                    实例IDr, 整64(克隆声明1011.附加));
                如果 (!设返名1011.正常) { 运行时错误(4); }
            }
        }
        // 421（070·wt421）：泛型函数实例的 128 位形参登记——克隆体不在源码
        //   程序节点区间，IR生成中 收集函数签名 伴随段（810·函数实参128位们）
        //   扫不到 → 调用点回扫 表 miss → 实参窄值直传、被调 prologue 按双槽
        //   地址 rep movsb 解引用（探针 M 泛直<整128>(600000000000)/I2
        //   泛应用$整128 处理(600000000000) fault=字面量值本身 实锤；泛型
        //   类方法实例同款登记段=IR生成 克隆类节点扫描·595-a/810 同构）。
        //   键=签名键+实例合成名纯名双键（IR生成中 同款·调用侧两决议面通吃）。
        //   415-r（P1-4 收口）：段体抽取为 登记克隆体128位形参（嵌套实例化登记
        //   段同构复用——单一函数化防再分叉）。
        //   425 融合（wt425·55_reference 实录）：引用形参位双键登记同并入该
        //   函数——主循环/嵌套实例化段 各调用点统一获得 128 位+引用双面登记。
        登记克隆体128位形参(池, 克隆索引r,
                        函数签名键(键基合成(基模块路径1011, 实例IDr),
                                   函数参数串(池, 克隆索引r)),
                        实例IDr);
        // 750 P0-A-5：模板体内调用的引用实参根名表项按偏移重映射到克隆体索引
        //   （克隆体不在源码区间·语义扫描只覆盖模板；与 128 位形参登记同点）
        重映射引用实参根750(池, 整64(池.元素(基函数索引r).子起点),
                        整64(基函数索引r), 克隆首415);
        结果<空类型, 整32> 加fr = 泛型实例函数节点们.追加(整64(克隆索引r));
        如果 (!加fr.正常) { 运行时错误(4); }
        // 415（wt415·421①面）：克隆体内嵌套泛型调用实例化（宿主 317-a 推断式
        //   单态化同构——两倍体内 恒等(值) 裸名 EXTERN 悬空=链接 undefined 实录）
        //   1470：+模块序（返回类型键基查询域=基函数归属模块·1011 同源）+累计
        //   平移（克隆首-基函数子起点·解析期实参末位表键换算基）——推导面扩容
        //   与类面挂载见 IR类嵌套推导.cn。
        实例化嵌套泛型调用(池, 克隆首415, 克隆索引r, 程序节点们, 模块路径们,
                       基模块序1011,
                       克隆首415 - 整64(池.元素(基函数索引r).子起点), 0);
        i++;
    }
    // 421-c：延迟绑定展开——函数实例实参=泛型参数名（T）→按类实例绑定展开
    //   （查找值位置$T 在 映射$整64$整64 内=查找值位置$整64·去重）。展开实例
    //   →克隆函数节点+函数节点表+签名登记（与直接实例同路径）。
    整64 i2 = 0;
    当 (i2 < n) {
        整64 延迟IDd = 泛型实例们.元素(i2);
        字符串 实例文本d = 字符串复制(驻留文本(延迟IDd));
        字符串 基名d = 剥实例基名(实例文本d);
        如果 (查泛型基类参数序(整64(驻留(基名d))) == 0) { i2++; 继续; }
        向量<整64> 函数实参们d = 向量<整64>();
        剥实例参数段(实例文本d, 函数实参们d);
        布尔 是延迟d = 假;
        整64 q = 0;
        当 (q < 函数实参们d.大小()) {
            如果 (是泛型参数名(函数实参们d.元素(q))) { 是延迟d = 真; }
            q++;
        }
        如果 (!是延迟d) { i2++; 继续; }
        可选<整32> 基函数索引查d = 定位泛型基函数(池, 程序节点们, 基名d);
        如果 (!基函数索引查d.有值) { i2++; 继续; }
        // 上行使 miss 提前继续；此处 0 仅占位（不可达·既有未命中语义）
        整32 基函数索引d = 0;
        如果 (基函数索引查d.有值) { 基函数索引d = 基函数索引查d.值; }
        // 函数参数名序（「T」拆段）
        向量<整64> 函数参数名们d = 向量<整64>();
        字符串 参数串文本d = 字符串复制(驻留文本(查泛型基类参数序(整64(驻留(基名d)))));
        整64 段起d = 0;
        整64 cd = 0;
        当 (cd <= 字符串长度(参数串文本d)) {
            布尔 尾cd = cd == 字符串长度(参数串文本d);
            如果 (尾cd || ((整64(参数串文本d[整32(cd)]) & 255) == 44)) {
                如果 (cd > 段起d) {
                    结果<空类型, 整32> 加nd = 函数参数名们d.追加(整64(驻留(字符串子串(参数串文本d, 整32(段起d), 整32(cd - 段起d)))));
                    如果 (!加nd.正常) { 运行时错误(4); }
                }
                段起d = cd + 1;
            }
            cd++;
        }
        // 遍历类实例（克隆类表）·绑定展开
        整64 cb = 0;
        当 (cb < 泛型实例类节点们.大小()) {
            节点 克隆类节点d = 池.元素(整32(泛型实例类节点们.元素(cb)));
            整64 类实例IDd = 整64(克隆类节点d.文本);
            字符串 类实例文本d = 字符串复制(驻留文本(类实例IDd));
            向量<整64> 类实参们d = 向量<整64>();
            剥实例参数段(类实例文本d, 类实参们d);
            // 函数实参段=类实参段 同位（T→类实参[位]）——组合实例文本
            字符串 组合文本d = 基名d;
            整64 q2 = 0;
            当 (q2 < 函数实参们d.大小()) {
                整64 段实参d = 函数实参们d.元素(q2);
                如果 (是泛型参数名(段实参d) && q2 < 类实参们d.大小()) {
                    段实参d = 类实参们d.元素(q2);
                }
                组合文本d = 字符串复制(组合文本d + "$" + 字符串复制(驻留文本(段实参d)));
                q2++;
            }
            整64 组合IDd = 整64(驻留(组合文本d));
            如果 (!是泛型实例(组合IDd)) {
                // 组合实例入表+克隆+签名登记（复用主循环逻辑·精简内联）
                结果<空类型, 整32> 加组 = 泛型实例们.追加(组合IDd);
                如果 (!加组.正常) { 运行时错误(4); }
                整64 克隆首d415 = 池.大小();
                整32 克隆索引d = 克隆泛型函数节点(池, 基函数索引d, 组合IDd, 函数参数名们d, 类实参们d);
                结果<空类型, 整32> 加fd = 泛型实例函数节点们.追加(整64(克隆索引d));
                如果 (!加fd.正常) { 运行时错误(4); }
                登记函数签名K(池, 克隆索引d, 键基合成(模块路径们.元素(0), 组合IDd));   // 1011：主循环键基=基函数归属模块（延迟组合实例同款）
                // 425 同轮补（55_reference 同族面·415-r 函数化融合）：组合实例
                //   的 128 位/引用形参位登记与主循环同源（引用面已并入
                //   登记克隆体128位形参）——延迟组合克隆体同样不在源码区间，
                //   漏登=调用点回扫 miss→引用实参按值直传段错误（同病同治）。
                登记克隆体128位形参(池, 克隆索引d,
                                函数签名键(键基合成(模块路径们.元素(0), 组合IDd),
                                           函数参数串(池, 克隆索引d)),
                                组合IDd);
                // 750 P0-A-5：克隆体引用实参根名表项重映射（同主循环）
                重映射引用实参根750(池, 整64(池.元素(基函数索引d).子起点),
                                整64(基函数索引d), 克隆首d415);
                // 415（wt415）：展开克隆体嵌套泛型调用同主循环实例面——1470：
                //   模块序=0（本面键基=主模块·既有口径同源）、累计平移同换算。
                实例化嵌套泛型调用(池, 克隆首d415, 克隆索引d, 程序节点们, 模块路径们,
                               0,
                               克隆首d415 - 整64(池.元素(基函数索引d).子起点),
                               0);
            }
            cb++;
        }
        i2++;
    }
}

// 421-c 辅助：定位泛型基函数节点（程序区间扫描·命中=某些(索引)/未找到=可选无值·1360 批5 结果化）
函数 定位泛型基函数(向量<节点> 池, 向量<整32> 程序节点们, 字符串 基名d) -> 可选<整32> {
    整64 基名IDd = 整64(驻留(基名d));
    整64 f = 0;
    当 (f < 程序节点们.大小()) {
        节点 程序声明d = 池.元素(程序节点们.元素(整32(f)));
        整64 位置d = 整64(程序声明d.子起点);
        整64 终点d = 整64(程序声明d.子终点);
        当 (位置d < 终点d) {
            节点 声明d = 池.元素(整32(位置d));
            如果 (声明d.类型 == 节点_函数 && 整64(声明d.文本) == 基名IDd) {
                返回 某些(整32(位置d));
            }
            位置d++;
        }
        f++;
    }
    返回 无;
}

// ==================== 415（wt415·421①面）：克隆体内嵌套泛型调用实例化 ====================
// 宿主 317-a 推断式单态化同构（泛型体内嵌套泛型调用 两倍(T 值){返回 恒等(值);}——
//   421 用例①实录：嵌套调用被调=裸名 恒等，克隆体 call 裸名符号 EXTERN 悬空
//   →链接 undefined）。基体=模板态（体内类型节点=参数名）无法推导；克隆体类型
//   节点已被 克隆泛型函数节点 替换为实例实参→克隆完成后扫克隆体调用点推导。
// 定位泛型基函数并输出归属模块序（签名键基 1011 同源；无值=未找到·1360 批5 结果化）
函数 定位泛型基序(向量<节点> 池, 向量<整32> 程序节点们, 字符串 基名415,
                 整64& 模块序出) -> 可选<整32> {
    整64 基名ID415 = 整64(驻留(基名415));
    整64 f415 = 0;
    当 (f415 < 程序节点们.大小()) {
        节点 程序声明415 = 池.元素(程序节点们.元素(整32(f415)));
        整64 位置415 = 整64(程序声明415.子起点);
        整64 终点415 = 整64(程序声明415.子终点);
        当 (位置415 < 终点415) {
            节点 声明415 = 池.元素(整32(位置415));
            如果 (声明415.类型 == 节点_函数 && 整64(声明415.文本) == 基名ID415) {
                模块序出 = f415;
                返回 某些(整32(位置415));
            }
            位置415++;
        }
        f415++;
    }
    返回 无;
}

// 415-r（P2 收口）：泛型参数序串拆段（"T"/"K,V" → 参数名 ID 们·470-a/主循环/
//   421-c 同构内联的单一函数化——语义检查表达式尾 同名版改调本函数）
函数 泛型参数序拆段(整64 参数序ID, 向量<整64>& 段名出) -> 空类型 {
    字符串 参数串s = 字符串复制(驻留文本(参数序ID));
    整64 段起s = 0;
    整64 扫s = 0;
    当 (扫s <= 字符串长度(参数串s)) {
        如果 (扫s == 字符串长度(参数串s) ||
             ((整64(参数串s[整32(扫s)]) & 255) == 44)) {
            如果 (扫s > 段起s) {
                结果<空类型, 整32> 加段s = 段名出.追加(
                    整64(驻留(字符串子串(参数串s, 整32(段起s), 整32(扫s - 段起s)))));
                如果 (!加段s.正常) { 运行时错误(4); }
            }
            段起s = 扫s + 1;
        }
        扫s++;
    }
}

// 415-r（P1-4 收口）：克隆体 128 位形参双键登记（签名键+实例纯名键·主循环
//   810 段同源抽取——嵌套实例化登记段同构补挂·421 fault 族嵌套面回归防线）
// 425 融合（wt425·55_reference 实录）：引用形参位双键登记同面并入——克隆体
//   不在源码程序节点区间，IR生成中 收集函数实参结构 伴随段（②c D·函数实参
//   引用们）扫不到 → 调用点 回扫结构体与引用实参 表 miss → 实参按值直传、
//   被调 prologue 引用通道把值当地址解引用（探针 引用交换<整64>(p,q)
//   fault=0x64=p 值本身·段错误实锤；432-b 收集实例方法实参引用 同构但只盖
//   类方法）。主循环/嵌套实例化段/延迟组合段 各调用点统一获得双面登记。
不安全 函数 登记克隆体128位形参(向量<节点> 池, 整32 克隆索引, 整64 签名键, 整64 纯名ID) -> 空类型 {
    节点 克隆声明m = 池.元素(克隆索引);
    整64 参数终点m = 整64(克隆声明m.子起点);
    如果 (克隆声明m.子终点 > 0 && 克隆声明m.子终点 < 池.大小()) {
        参数终点m = 整64(池.元素(整32(克隆声明m.子终点)).子起点);
    }
    整64 参数序m = 0;
    整64 参数位置m = 整64(克隆声明m.子起点);
    当 (参数位置m < 参数终点m) {
        节点 参数m = 池.元素(整32(参数位置m));
        如果 (参数m.类型 == 节点_参数) {
            如果 (参数m.附加 >= 0 && 参数m.附加 < 池.大小()) {
                节点 参数类型节点m = 池.元素(整32(参数m.附加));
                字符串 参类型名m = 字符串复制(驻留文本(整64(参数类型节点m.文本)));
                如果 (参数类型节点m.附加 == 0 &&
                     (字符串比较(参类型名m, "整128") ||
                      字符串比较(参类型名m, "正128"))) {
                    结果<空类型, 整32> 设键m = 函数实参128位们.设置(
                        签名键 * 键位移 + 参数序m, 1);
                    如果 (!设键m.正常) { 运行时错误(4); }
                    结果<空类型, 整32> 设名m = 函数实参128位们.设置(
                        纯名ID * 键位移 + 参数序m, 1);
                    如果 (!设名m.正常) { 运行时错误(4); }
                }
                // 799（变体C 实锤·形参 ABI 登记第三面）：**结构体按值实参**登记
                //   （双键同 128 位/引用面）——克隆体原只登 128 位+引用 → 形参=
                //   结构体/宽合成体/数组时调用侧 B8 回扫不取地址（直传首 8 字节
                //   值·被调 rep movsb 解引用 fault=5 实录）。判据与源码版 收集
                //   函数实参结构 逐字对齐（容器类/用户类=句柄直传不登·指针层
                //   附加≠0 不登·合成体宽>8（1011）/数组（087b）同登）。
                布尔 结形参登m = 参数类型节点m.附加 == 0 &&
                     (查结构体大小(整64(参数类型节点m.文本)) != 0 ||
                      (是结果类型(参类型名m) && 结果大小(参类型名m) > 8) ||
                      是数组类型文本(参类型名m)) &&
                     !是容器类(驻留文本(整64(参数类型节点m.文本))) &&
                     !是用户类ID(整64(参数类型节点m.文本));
                如果 (结形参登m) {
                    结果<空类型, 整32> 设结m = 函数实参结构们.设置(
                        签名键 * 键位移 + 参数序m, 1);
                    如果 (!设结m.正常) { 运行时错误(4); }
                    结果<空类型, 整32> 设结名m = 函数实参结构们.设置(
                        纯名ID * 键位移 + 参数序m, 1);
                    如果 (!设结名m.正常) { 运行时错误(4); }
                }
                如果 (参数类型节点m.附加 >= 256) {
                    结果<空类型, 整32> 设引键425 = 函数实参引用们.设置(
                        签名键 * 键位移 + 参数序m, 1);
                    如果 (!设引键425.正常) { 运行时错误(4); }
                    结果<空类型, 整32> 设引名425 = 函数实参引用们.设置(
                        纯名ID * 键位移 + 参数序m, 1);
                    如果 (!设引名425.正常) { 运行时错误(4); }
                }
            }
            // 421-e 修正同源：参数序只对 参数 节点递增（区间首可能含返回类型节点）
            参数序m++;
        }
        参数位置m++;
    }
}

// 克隆体形参类型表构建（名 ID / 类型文本 平行表——类型节点文本已=实例类型·
//   指针层/引用层自 附加 还原为尾缀：1..255=星·256=引用符）
函数 克隆体形参类型表(向量<节点> 池, 整32 克隆索引, 向量<整64>& 名表出,
                   向量<字符串>& 类型表出) -> 空类型 {
    节点 克隆声明p = 池.元素(克隆索引);
    整64 参数终点p = 整64(克隆声明p.子起点);
    如果 (克隆声明p.子终点 > 0 && 克隆声明p.子终点 < 池.大小()) {
        参数终点p = 整64(池.元素(整32(克隆声明p.子终点)).子起点);
    }
    整64 参数位置p = 整64(克隆声明p.子起点);
    当 (参数位置p < 参数终点p) {
        节点 参数p = 池.元素(整32(参数位置p));
        如果 (参数p.类型 == 节点_参数 && 参数p.附加 >= 0 && 参数p.附加 < 池.大小()) {
            节点 类型节点p = 池.元素(整32(参数p.附加));
            字符串 类型文本p = 字符串复制(驻留文本(整64(类型节点p.文本)));
            整64 星p = 整64(类型节点p.附加);
            当 (星p >= 1 && 星p <= 255) {
                类型文本p = 字符串复制(类型文本p + "*");
                星p--;
            }
            如果 (整64(类型节点p.附加) == 256) {
                类型文本p = 字符串复制(类型文本p + "&");
            }
            结果<空类型, 整32> 加名p = 名表出.追加(整64(参数p.文本));
            如果 (!加名p.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加型p = 类型表出.追加(类型文本p);
            如果 (!加型p.正常) { 运行时错误(4); }
        }
        参数位置p++;
    }
}


// ==================== 234（2026-10-06·91303）：类继承+虚表设施 ====================
// 职责：基名链/虚方法槽位/布局头 三表——与宿主 ClassInfo.baseName+vtableOrder
//   同构（布局口径对齐：沿链有虚函数才含 vtable 首槽·无虚类布局零变化=存量
//   78/79_v2 固定点不受扰）。登记点=解析期（解析类继承登记/解析方法体 虚拟修饰）；
//   消费点=布局收口（布局头/字段并入）/生成层（vtable 发射/构造序言/虚调用/析构链）。

// 登记类基名（解析类继承登记·要求基类已声明——诚实边界：前置声明/跨模块基不支）
不安全 函数 登记类基名(整64 类名ID, 整64 基名ID) -> 空类型 {
    结果<空类型, 整32> 设 = 类基名们.设置(类名ID, 基名ID);
    如果 (!设.正常) { 运行时错误(4); }
}

// 查类基名（0=无继承）
函数 查类基名(整64 类名ID) -> 整64 {
    如果 (类名ID <= 0) { 返回 0; }
    结果<整64, 整32> 查 = 类基名们.获取(类名ID);
    如果 (查.正常) { 返回 查.值; } 否则 { 返回 0; }
}

// 是否派生自（sub 沿链上溯含同类·基类链环由「基类须先声明」排除）
函数 是否派生自(整64 子名ID, 整64 基名ID) -> 布尔 {
    整64 当前c = 子名ID;
    整64 守卫d = 0;
    当 (当前c != 0 && 守卫d < 64) {
        如果 (当前c == 基名ID) { 返回 真; }
        当前c = 查类基名(当前c);
        守卫d++;
    }
    返回 假;
}

// 沿链查虚方法槽位（无值=非虚——子类重写命中子槽·未重写沿链命中父槽；1360 批5 结果化）
函数 沿链查虚槽(整64 类名ID, 整64 方法名ID) -> 可选<整64> {
    整64 当前c = 类名ID;
    整64 守卫d = 0;
    当 (当前c != 0 && 守卫d < 64) {
        结果<整64, 整32> 查 = 类虚方法槽们.获取(当前c * 键位移 + 方法名ID);
        如果 (查.正常) { 返回 某些(查.值); }
        当前c = 查类基名(当前c);
        守卫d++;
    }
    返回 无;
}

// 沿链最大槽数（新虚方法槽分配用——父链槽总数）
函数 沿链虚槽数(整64 类名ID) -> 整64 {
    整64 当前c = 类名ID;
    整64 最大m = 0;
    整64 守卫d = 0;
    当 (当前c != 0 && 守卫d < 64) {
        结果<整64, 整32> 查 = 类虚槽数们.获取(当前c);
        如果 (查.正常 && 查.值 > 最大m) { 最大m = 查.值; }
        当前c = 查类基名(当前c);
        守卫d++;
    }
    返回 最大m;
}

// 登记类虚方法（解析期·虚拟/重写 修饰方法）：重写命中沿链父槽（本类表写同槽
//   =覆盖语义）·新虚分配沿链最大槽；同步维护本类槽总数与槽→方法发射表
不安全 函数 登记类虚方法(整64 类名ID, 整64 方法名ID) -> 空类型 {
    可选<整64> 槽查v = 沿链查虚槽(类名ID, 方法名ID);
    // 未命中=新虚方法分配沿链最大槽（既有语义）
    整64 槽v = 沿链虚槽数(类名ID);
    如果 (槽查v.有值) { 槽v = 槽查v.值; }
    结果<空类型, 整32> 设槽m = 类虚方法槽们.设置(类名ID * 键位移 + 方法名ID, 槽v);
    如果 (!设槽m.正常) { 运行时错误(4); }
    结果<空类型, 整32> 设槽f = 类虚槽方法们.设置(类名ID * 键位移 + 槽v, 方法名ID);
    如果 (!设槽f.正常) { 运行时错误(4); }
    整64 总v = 槽v + 1;
    结果<整64, 整32> 查旧 = 类虚槽数们.获取(类名ID);
    如果 (查旧.正常 && 查旧.值 > 总v) { 总v = 查旧.值; }
    结果<空类型, 整32> 设数 = 类虚槽数们.设置(类名ID, 总v);
    如果 (!设数.正常) { 运行时错误(4); }
    有虚类清单追加(类名ID);
}

// 查虚方法槽位（无值=非虚·调用分派判定入口——本类表已含沿链继承合成结果：
//   父虚方法经 方法并入 复制进子表；1360 批5 结果化）
函数 查虚方法槽(整64 类名ID, 整64 方法名ID) -> 可选<整64> {
    结果<整64, 整32> 查 = 类虚方法槽们.获取(类名ID * 键位移 + 方法名ID);
    如果 (查.正常) { 返回 某些(查.值); }
    返回 无;
}

// 查虚槽方法名（vtable 数组发射·0=空槽）
函数 查虚槽方法名(整64 类名ID, 整64 槽) -> 整64 {
    结果<整64, 整32> 查 = 类虚槽方法们.获取(类名ID * 键位移 + 槽);
    如果 (查.正常) { 返回 查.值; } 否则 { 返回 0; }
}

// 方法继承=查询点沿链兜底（有类方法/查类方法返回/查类方法参数串/查类析构 沿基名链）——
//   等价宿主「表含继承并入」语义·稀疏表零枚举（234）。


// 本类 vtable 槽总数（0=无虚表——布局头判定/发射跳过）
