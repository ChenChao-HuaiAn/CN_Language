// CN 自举编译器 v2 · IR 组件·情况标签判定族（1160 新增·审查修复轮）
// 职责：选择语句情况标签的整数归一文本 / 承载判域 / 条件类型域判定单点——
//   对标宿主 1137 第二轮定稿（d9647b2b7）双侧同口径：
//     parser parseCaseIntLabel（操作数逐字面量承载判 + 无符号后缀族折叠判定）
//     semantic checkSwitchCaseLabel1137（条件类型域判·字符/枚举归并整32）
//   消费=语义层 检查选择（域判/去重）与 IR 生成层 生成选择语句（文本常量
//   发射 / 128 双半比较）——判定单一真源，禁第二份域表。
//   加载序：置于 IR容器尾 之后（依赖 常量末至十进制919〔IR常量求值〕、
//   拆符号919/规范919〔IR常量求值〕、字面量文本入域/字面量文本入域128_640/
//   数文本不超上界〔IR字面量域〕、字面量后缀类型ID〔语义检查字面量域〕、
//   字面量超128域〔IR容器尾〕全部先就绪）。
// 1193（枚举跨类型情况标签收口）：新增「裸枚举成员标签语义定向解析值表」——
//   语义层按**条件枚举类型**定向解析裸名（规范 03 §3.4 一致性约束「成员须存
//   在于条件枚举类型」·宿主 visitSwitchStmt enumValueOf(condType, ...) 同构），
//   解析结果登记于此供 IR 生成层裸名标签分支消费（替换原全局裸名表 958 直取：
//   跨枚举同名成员后者覆盖 → 按错误枚举取值 = 运行结果分叉源）。
导入 容器::向量;
导入 映射集合;
导入 协议常量;

公开:   // 全文件公开（语义/IR 双消费）

// 1160：情况标签归一十进制文本（对标宿主 CaseLabel.decValue）。
//   真=区间末节点可作常量整数求值（字面量 / ±负号链 / 全字面量 + - * / %
//   折叠——复用 919 常量求值单点；标识符/调用/成员/移位/位运算等非常量
//   形态返回假，交既有表达式通道）。
//   文本ID=规范十进制文本驻留 ID（"−0"→"0"）；文本ID=0=**超 u128 域显式
//   哨兵**（消费方按超语言承载族编译期拒——禁静默取默认值比较）。
函数 情况标签归一文本(向量<节点> 池, 整32 起, 整32 终, 整64& 文本ID) -> 布尔 {
    文本ID = 0;
    布尔 区间有效1160 = 起 >= 0 && 起 <= 整32(池.大小()) &&
                       终 > 起 && 终 <= 整32(池.大小());
    // 静默豁免业务值: 区间越界=显式谓词假（不可归一/不属本判据面·调用方按非常量通道分流），非默认值
    如果 (!区间有效1160) { 返回 假; }
    整64 求值ID = 0;
    // 静默豁免业务值: 非常量形态=919 求值谓词假（调用方按既有表达式通道分流），非默认值
    如果 (!常量末至十进制919(池, 终 - 1, 求值ID)) { 返回 假; }
    // 1160 显式哨兵: 求值ID=0 是 919 超 u128 域显式哨兵（超一切整型承载——原样交消费方按超域拒，非 miss 默认）
    如果 (求值ID == 0) {
        文本ID = 0;
        返回 真;
    }
    // 规范形收口（"-0"→"0"·去前导零）：语义域判/去重/IR 文本发射三面同形
    文本ID = 驻留(规范带符919(字符串复制(驻留文本(求值ID))));
    返回 真;
}

// 1160（审查修复 P1-2/P1-3）：字面量文本无符号族判定（宿主 literalTypeOf
//   后缀族口径：U/UL/ULL → 正32/正64/正128）——承载域按后缀符号族选择。
函数 情况标签无符号族1160(字符串 原文) -> 布尔 {
    整64 后ID = 字面量后缀类型ID(原文);
    如果 (后ID == 驻留("正32") || 后ID == 驻留("正64") ||
         后ID == 驻留("正128")) {
        返回 真;
    }
    返回 假;
}

// 1160（审查修复 P1-2）：单字面量操作数承载状态——0=域内 / 1=超整128 域 /
//   2=超正128 域（宿主 normalizeCaseIntText 的 integerLiteralRuntimeType 段）：
//   · 负号 + 无符号族（U/UL/ULL）= 超域（无符号族不承载负值·宿主 status=2）；
//   · 无符号族（非负）= 正128 域 [0,2^128-1]（宿主同族口径）；
//   · 其余（无后缀/整族）= 整128 域 ±2^127（负号并入文本判）。
函数 情况标签操作数承载状态1160(字符串 原文, 布尔 负号) -> 整64 {
    布尔 无符号族 = 情况标签无符号族1160(原文);
    如果 (负号 && 无符号族) { 返回 2; }
    如果 (!负号 && 无符号族) {
        // 1160 显式哨兵: 无符号族域内=正128 [0,2^128-1] 判定结果（假=超正128 域 status 2）
        如果 (字面量文本入域128_640(原文, "正128", 假)) { 返回 0; }
        返回 2;
    }
    如果 (负号) {
        // 1160 显式哨兵: 整族负号承载判定（假=域内 status 0／真=超整128 status 1）
        如果 (字面量超128域("-" + 原文)) { 返回 1; }
        返回 0;
    }
    // 1160 显式哨兵: 整族正形承载判定（假=域内 status 0／真=超整128 status 1）
    如果 (字面量超128域(原文)) { 返回 1; }
    返回 0;
}

// 1160（审查修复 P1-2/P1-3）：操作数区间形态承载状态——
//   0/1/2=同 情况标签操作数承载状态1160；-1=非「字面量/负号+字面量」形态
//   （调用方不收集后缀族，折叠结果按有符号域保守判）。
函数 情况标签操作数区间状态1160(向量<节点> 池, 整32 起, 整32 终) -> 整64 {
    布尔 区间有效1160 = 起 >= 0 && 起 <= 整32(池.大小()) &&
                       终 > 起 && 终 <= 整32(池.大小());
    // 静默豁免业务值: 区间越界=显式谓词假（非操作数形态·返回 -1 显式哨兵），非默认值
    如果 (!区间有效1160) { 返回 0 - 1; }
    整64 末 = 整64(终) - 1;
    节点 末节点 = 池.元素(整32(末));
    如果 (末节点.类型 == 节点_整数字面量 && 末 == 整64(起)) {
        返回 情况标签操作数承载状态1160(
            字符串复制(驻留文本(整64(末节点.文本))), 假);
    }
    如果 (末节点.类型 == 节点_负号 && 末 == 整64(起) + 1) {
        节点 首节点 = 池.元素(起);
        如果 (首节点.类型 == 节点_整数字面量) {
            返回 情况标签操作数承载状态1160(
                字符串复制(驻留文本(整64(首节点.文本))), 真);
        }
    }
    返回 0 - 1;
}

// 1160 审查修复 P1-2（负号+U 规则可绕过根治）：表达式树内**全部字面量操作数**
//   承载状态递归扫描（不止顶层 + -）——任何层级「负号+U 族」=2、无符号族超
//   正128=2、其余超整128=1；返回最高优先状态（2 > 1 > 0）。
函数 情况标签子树承载状态1160(向量<节点> 池, 整32 起, 整32 终) -> 整64 {
    布尔 区间有效1160 = 起 >= 0 && 起 <= 整32(池.大小()) &&
                       终 > 起 && 终 <= 整32(池.大小());
    // 静默豁免业务值: 区间越界=显式谓词假（不属本判据面·返回 0 域内哨兵），非默认值
    如果 (!区间有效1160) { 返回 0; }
    整64 末 = 整64(终) - 1;
    节点 n = 池.元素(整32(末));
    如果 (n.类型 == 节点_整数字面量) {
        如果 (末 == 整64(起)) {
            返回 情况标签操作数承载状态1160(
                字符串复制(驻留文本(整64(n.文本))), 假);
        }
        返回 0;
    }
    如果 (n.类型 == 节点_负号) {
        如果 (末 - 1 >= 整64(起) &&
             池.元素(整32(末 - 1)).类型 == 节点_整数字面量) {
            返回 情况标签操作数承载状态1160(
                字符串复制(驻留文本(整64(池.元素(整32(末 - 1)).文本))), 真);
        }
        如果 (末 > 整64(起)) {
            返回 情况标签子树承载状态1160(池, 起, 整32(末));
        }
        返回 0;
    }
    如果 (n.类型 == 节点_二元运算) {
        // 450 二元节点契约：附加=右操作数起点（左操作数末=附加-1；普通表达式
        //   子起点亦=附加——左区间起点取本子树起点 起，禁按 子起点 切）
        如果 (整64(n.附加) > 整64(起) && 整64(n.附加) < 末) {
            整64 左态 = 情况标签子树承载状态1160(
                池, 起, 整32(n.附加));
            整64 右态 = 情况标签子树承载状态1160(
                池, 整32(n.附加), 整32(末));
            // 1160 显式哨兵: 子树任一操作数超正128 优先上抛
            如果 (左态 == 2 || 右态 == 2) { 返回 2; }
            // 1160 显式哨兵: 子树任一操作数超整128 上抛
            如果 (左态 == 1 || 右态 == 1) { 返回 1; }
        }
    }
    返回 0;
}

// 1160 审查修复 P1-2：表达式树内是否存在**非负**无符号族字面量操作数
//   （负号直接包裹者不算——宿主 unsignedCarry1137「!neg && 无符号族」口径）。
函数 情况标签子树有无符号1160(向量<节点> 池, 整32 起, 整32 终) -> 布尔 {
    布尔 区间有效1160 = 起 >= 0 && 起 <= 整32(池.大小()) &&
                       终 > 起 && 终 <= 整32(池.大小());
    // 静默豁免业务值: 区间越界=显式谓词假（无无符号族·非默认值）
    如果 (!区间有效1160) { 返回 假; }
    整64 末 = 整64(终) - 1;
    节点 n = 池.元素(整32(末));
    如果 (n.类型 == 节点_整数字面量) {
        如果 (末 == 整64(起)) {
            返回 情况标签无符号族1160(字符串复制(驻留文本(整64(n.文本))));
        }
        返回 假;
    }
    如果 (n.类型 == 节点_负号) {
        如果 (末 - 1 >= 整64(起) &&
             池.元素(整32(末 - 1)).类型 == 节点_整数字面量) {
            返回 假;
        }
        如果 (末 > 整64(起)) {
            返回 情况标签子树有无符号1160(池, 起, 整32(末));
        }
        返回 假;
    }
    如果 (n.类型 == 节点_二元运算) {
        // 450 契约：附加=右操作数起点；左区间起点=本子树起点 起
        如果 (整64(n.附加) > 整64(起) && 整64(n.附加) < 末) {
            如果 (情况标签子树有无符号1160(池, 起, 整32(n.附加))) {
                返回 真;
            }
            返回 情况标签子树有无符号1160(池, 整32(n.附加), 整32(末));
        }
    }
    返回 假;
}

// 1160（审查修复 P1-2/P1-3）：情况标签承载状态（对标宿主 parseCaseIntLabel
//   第二轮定稿）——0=域内 / 1=超整128 / 2=超正128。规则：
//   · 表达式树内全部字面量操作数先经 子树承载状态 递归判（负号+U 族=超域·
//     嵌套 + - * / % 全覆盖）；
//   · 折叠结果：任一非负 U 后缀操作数 ⇒ 按正128 无符号域（负结果/超 u128=拒），
//     否则按整128 有符号域 ±2^127（宿主 unsignedCarry1137 同口径）；
//   · 非常量形态=0（表达式标签不在本判据面）。
函数 情况标签承载状态1160(向量<节点> 池, 整32 起, 整32 终) -> 整64 {
    布尔 区间有效1160 = 起 >= 0 && 起 <= 整32(池.大小()) &&
                       终 > 起 && 终 <= 整32(池.大小());
    // 静默豁免业务值: 区间越界=显式谓词假（不属本判据面·返回 0 域内哨兵），非默认值
    如果 (!区间有效1160) { 返回 0; }
    整64 子树态 = 情况标签子树承载状态1160(池, 起, 终);
    // 1160 显式哨兵: 子树态≠0=表达式树内操作数已超承载族（优先上抛）
    如果 (子树态 != 0) { 返回 子树态; }
    整64 末 = 整64(终) - 1;
    节点 n = 池.元素(整32(末));
    如果 (n.类型 == 节点_二元运算) {
        字符串 op = 字符串复制(驻留文本(整64(n.文本)));
        布尔 算术 = 字符串比较(op, "+") || 字符串比较(op, "-") ||
                    字符串比较(op, "*") || 字符串比较(op, "/") ||
                    字符串比较(op, "%");
        如果 (算术 && 整64(n.附加) > 整64(起) && 整64(n.附加) < 末) {
            布尔 无符折 = 情况标签子树有无符号1160(池, 起, 终);
            整64 结果ID = 0;
            如果 (情况标签归一文本(池, 起, 终, 结果ID)) {
                // 1160 显式哨兵: 结果ID=0 是 919 超 u128 域哨兵（折叠结果超一切承载——按族上抛）
                如果 (结果ID == 0) {
                    // 1160 显式哨兵: 无符折=无符号族折叠判定（真=正128 域/假=整128 域）
                    如果 (无符折) { 返回 2; }
                    返回 1;
                }
                字符串 结果文本 = 字符串复制(驻留文本(结果ID));
                如果 (无符折) {
                    字符串 数字 = "";
                    布尔 负 = 拆符号919(结果文本, 数字);
                    数字 = 规范919(数字);
                    // 1160 显式哨兵: 无符号族折叠结果负号=超正128 域 status 2
                    如果 (负) { 返回 2; }
                    // 1160 显式哨兵: 无符号族折叠结果上界判定（假=超正128 status 2）
                    如果 (!数文本不超上界(
                            数字, "340282366920938463463374607431768211455")) {
                        返回 2;
                    }
                    返回 0;
                }
                // 1160 显式哨兵: 有符号族折叠结果承载判定（真=超整128 status 1）
                如果 (字面量超128域(结果文本)) { 返回 1; }
                返回 0;
            }
        }
    }
    返回 0;
}

// 1160：条件类型域文本归一（宿主 checkSwitchCaseLabel1137 口径：
//   **字符/枚举归并 整32 存储域**（审查修复 P0-C 甲案·001 §3.7/§3.7b
//   整源→字符位模式互通；Unicode 标量语义=乙案待用户批准）；
//   「整数」别名=整32）。返回空串=非整数族/不可判——调用方跳过条件域判。
函数 情况标签条件域文本(整64 条件类型ID, 字符串 条件类型文本) -> 字符串 {
    如果 (条件类型ID > 0 && 条件类型ID <= 2147483647 && 是枚举名(条件类型ID)) { 返回 字符串复制("整32"); }
    如果 (字符串比较(条件类型文本, "字符")) { 返回 字符串复制("整32"); }
    如果 (字符串比较(条件类型文本, "整数")) { 返回 字符串复制("整32"); }
    如果 (字符串比较(条件类型文本, "整8") ||
         字符串比较(条件类型文本, "整16") ||
         字符串比较(条件类型文本, "整32") ||
         字符串比较(条件类型文本, "整64") ||
         字符串比较(条件类型文本, "整128") ||
         字符串比较(条件类型文本, "正8") ||
         字符串比较(条件类型文本, "正16") ||
         字符串比较(条件类型文本, "正32") ||
         字符串比较(条件类型文本, "正64") ||
         字符串比较(条件类型文本, "正128")) {
        返回 字符串复制(条件类型文本);
    }
    返回 字符串复制("");
}

// 1160：条件类型域判定（对标宿主 types::decTextFitsTypeDomain 单点）。
//   入参=归一十进制文本（可带 '-'）与域文本（情况标签条件域文本 输出）；
//   真=域内，假=超域（调用方按 #1076 口径编译期拒）。
//   域表复用 IR字面量域 单点：字面量文本入域（整8..整64/正8..正64）+
//   128 目标叠加 字面量文本入域128_640（±2^127 / 2^128-1）。
//   字符条件不自设码点域（甲案：域文本已归并整32）。
函数 情况标签在条件域内(字符串 归一文本, 字符串 域文本) -> 布尔 {
    字符串 数字 = "";
    布尔 负 = 拆符号919(归一文本, 数字);
    数字 = 规范919(数字);
    如果 (字符串比较(域文本, "整128") || 字符串比较(域文本, "正128")) {
        // 静默豁免业务值: 域判定谓词假=超域（调用方编译期拒·用户令 #1076），非默认值
        如果 (!字面量文本入域(数字, 域文本, 负)) { 返回 假; }
        返回 字面量文本入域128_640(数字, 域文本, 负);
    }
    返回 字面量文本入域(数字, 域文本, 负);
}

// ==================== 1193：裸枚举成员标签定向解析值表 ====================
// 键=情况标签节点池索引（节点索引全池唯一·语义分析多文件与 IR 生成多文件
//   共用同一池/程序节点们）；值=条件枚举成员常量值。
// 语义层 检查选择 按条件枚举类型定向查表命中后登记；IR 生成层 生成选择语句
//   裸名分支经 查裸名标签值1193 取值（miss=非枚举成员标识符标签·变量/常量
//   表达式既有豁免宽面 → 生成表达式通道分流，非静默默认值）。
// 生命周期=任务级：语义分析多文件 入口清空（与 清空顶层常量值表 同位）。
静态 映射<整64, 整64> 裸名标签值1193们;

不安全 函数 清空裸名标签值1193() -> 空类型 {
    裸名标签值1193们.清空();
}

不安全 函数 登记裸名标签值1193(整64 标签节点索引, 整64 成员值) -> 空类型 {
    结果<空类型, 整32> 设v1193 = 裸名标签值1193们.设置(标签节点索引, 成员值);
    如果 (!设v1193.正常) { 运行时错误(4); }
}

// 查裸名标签定向解析值：返回 -1=未登记（显式哨兵——语义层命中才登记；
//   生成层见 -1 报内部错误，禁静默取任意枚举成员值）。
函数 查裸名标签值1193(整64 标签节点索引) -> 整64 {
    结果<整64, 整32> 查v1193 = 裸名标签值1193们.获取(标签节点索引);
    如果 (查v1193.正常) { 返回 查v1193.值; }
    返回 0 - 1;
}
