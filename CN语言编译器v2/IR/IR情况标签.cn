// CN 自举编译器 v2 · IR 组件·情况标签判定族（1160 新增）
// 职责：选择语句情况标签的整数归一文本 / 承载判域 / 条件类型域判定单点——
//   对标宿主 1137 双侧同口径：
//     parser normalizeCaseIntText（归一十进制文本 + 整128/正128 承载判域）
//     semantic visitSwitchStmt（条件类型域判 types::decTextFitsTypeDomain）
//   消费=语义层 检查选择（域判/去重）与 IR 生成层 生成选择语句（文本常量
//   发射 / 128 双半比较）——判定单一真源，禁第二份域表（宿主单点纪律同款）。
//   加载序：置于 IR容器尾 之后（依赖 常量末至十进制919〔IR常量求值〕、
//   拆符号919/规范919〔IR常量求值〕、字面量文本入域/字面量文本入域128_640/
//   数文本不超上界〔IR字面量域〕、字面量超128域〔IR容器尾〕全部先就绪）。
导入 容器::向量;
导入 协议常量;

公开:   // 全文件公开（语义/IR 双消费）

// 1160：情况标签归一十进制文本（对标宿主 CaseLabel.decValue）。
//   真=区间末节点可作常量整数求值（字面量 / ±负号链 / 全字面量 + - * / %
//   折叠——复用 919 常量求值单点；标识符/调用/成员/移位/位运算等非常量
//   形态返回假，交既有表达式通道）。
//   文本ID=规范十进制文本驻留 ID（"−0"→"0"）；文本ID=0=**超 u128 域显式
//   哨兵**（消费方按超语言承载族编译期拒——禁静默取默认值比较）。
函数 情况标签归一文本(向量<节点> 池, 整32 起, 整32 终, 整64& 文本ID) -> 布尔 {
    文本ID = 0;
    布尔 区间有效1160 = 起 >= 0 && 起 <= 整32(池.大小()) &&
                       终 > 起 && 终 <= 整32(池.大小());
    // 静默豁免业务值: 区间越界=显式谓词假（不可归一/不属本判据面·调用方按非常量通道分流），非默认值
    如果 (!区间有效1160) { 返回 假; }
    整64 求值ID = 0;
    // 静默豁免业务值: 非常量形态=919 求值谓词假（调用方按既有表达式通道分流），非默认值
    如果 (!常量末至十进制919(池, 终 - 1, 求值ID)) { 返回 假; }
    // 1160 显式哨兵: 求值ID=0 是 919 超 u128 域显式哨兵（超一切整型承载——原样交消费方按超域拒，非 miss 默认）
    如果 (求值ID == 0) {
        文本ID = 0;
        返回 真;
    }
    // 规范形收口（"-0"→"0"·去前导零）：语义域判/去重/IR 文本发射三面同形
    文本ID = 驻留(规范带符919(字符串复制(驻留文本(求值ID))));
    返回 真;
}

// 1160：情况标签承载判域（对标宿主 normalizeCaseIntText 的
//   integerLiteralRuntimeType 段）——递归检查形态内**每个字面量的原始文本**
//   （含 L/U 后缀：无后缀=整128 族 ±2^127；U 后缀=正128 族 2^128-1）：
//   宿主 parser 对折叠操作数逐个判承载（`(2^127-2^127)` 也拒），折叠结果
//   再判一次。真=超承载族（调用方编译期拒·#1076 口径）。
//   非字面量/二元形态=假（不属本判据面——表达式标签由既有链管辖）。
函数 情况标签承载超域(向量<节点> 池, 整32 起, 整32 终) -> 布尔 {
    布尔 区间有效1160 = 起 >= 0 && 起 <= 整32(池.大小()) &&
                       终 > 起 && 终 <= 整32(池.大小());
    // 静默豁免业务值: 区间越界=显式谓词假（不可归一/不属本判据面·调用方按非常量通道分流），非默认值
    如果 (!区间有效1160) { 返回 假; }
    整64 末 = 整64(终) - 1;
    节点 n = 池.元素(整32(末));
    如果 (n.类型 == 节点_整数字面量) {
        返回 字面量超128域(字符串复制(驻留文本(整64(n.文本))));
    }
    如果 (n.类型 == 节点_负号) {
        // 单字面量负号形态 [字面量, 负号]：原文拼 '-'（-2^127 域内合法）
        如果 (末 - 1 >= 整64(起) &&
             池.元素(整32(末 - 1)).类型 == 节点_整数字面量) {
            节点 子 = 池.元素(整32(末 - 1));
            返回 字面量超128域("-" + 字符串复制(驻留文本(整64(子.文本))));
        }
        // 更外层负号：递归操作数区间（符号不传播——宿主扫描同口径：仅
        //   「|值| 恰等于负界限」与外壳符号相关，该边界按正形态判）
        返回 情况标签承载超域(池, 起, 整32(末));
    }
    如果 (n.类型 == 节点_二元运算) {
        // 折叠操作数逐个判（+ - 全递归；* / % 无后缀结果判在下方结果段）
        字符串 op = 字符串复制(驻留文本(整64(n.文本)));
        如果 (字符串比较(op, "+") || 字符串比较(op, "-")) {
            整64 左末 = 整64(n.附加) - 1;
            整64 右末 = 末 - 1;
            如果 (左末 >= 整64(起) && 右末 >= 整64(n.附加)) {
                如果 (情况标签承载超域(池, 整32(n.子起点), 整32(左末) + 1)) {
                    返回 真;
                }
                如果 (情况标签承载超域(池, 整32(n.附加), 整32(右末) + 1)) {
                    返回 真;
                }
            }
        }
        // 折叠结果承载（无后缀结果族 ±2^127；结果超 u128 由归一哨兵承担）
        整64 结果ID = 0;
        如果 (情况标签归一文本(池, 起, 终, 结果ID)) {
            // 1160 显式哨兵: 结果ID=0 是 919 超 u128 域显式哨兵（超一切整型承载——按超域拒，非 miss 默认）
            如果 (结果ID == 0) { 返回 真; }
            返回 字面量超128域(字符串复制(驻留文本(结果ID)));
        }
    }
    返回 假;
}

// 1160：条件类型域文本归一（宿主 semantic 口径：枚举归并 整32；「整数」
//   别名=整32）。返回空串=非整数族/不可判——调用方跳过条件域判（诚实
//   边界：生成层仍按值码发射正确比较；宿主对非整数条件亦不走域表）。
函数 情况标签条件域文本(整64 条件类型ID, 字符串 条件类型文本) -> 字符串 {
    如果 (条件类型ID > 0 && 条件类型ID <= 2147483647 && 是枚举名(条件类型ID)) { 返回 字符串复制("整32"); }
    如果 (字符串比较(条件类型文本, "整数")) { 返回 字符串复制("整32"); }
    如果 (字符串比较(条件类型文本, "整8") ||
         字符串比较(条件类型文本, "整16") ||
         字符串比较(条件类型文本, "整32") ||
         字符串比较(条件类型文本, "整64") ||
         字符串比较(条件类型文本, "整128") ||
         字符串比较(条件类型文本, "正8") ||
         字符串比较(条件类型文本, "正16") ||
         字符串比较(条件类型文本, "正32") ||
         字符串比较(条件类型文本, "正64") ||
         字符串比较(条件类型文本, "正128") ||
         字符串比较(条件类型文本, "字符")) {
        返回 字符串复制(条件类型文本);
    }
    返回 字符串复制("");
}

// 1160：条件类型域判定（对标宿主 types::decTextFitsTypeDomain 单点）。
//   入参=归一十进制文本（可带 '-'）与域文本（情况标签条件域文本 输出）；
//   真=域内，假=超域（调用方按 #1076 口径编译期拒）。
//   域表复用 IR字面量域 单点：字面量文本入域（整8..整64/正8..正64）+
//   128 目标叠加 字面量文本入域128_640（±2^127 / 2^128-1）；字符=规范
//   码点域 [0,0x10FFFF]（十进制 1114111·宿主 decTextFitsUnsignedRange）。
函数 情况标签在条件域内(字符串 归一文本, 字符串 域文本) -> 布尔 {
    字符串 数字 = "";
    布尔 负 = 拆符号919(归一文本, 数字);
    数字 = 规范919(数字);
    如果 (字符串比较(域文本, "字符")) {
        如果 (负) { 返回 假; }
        返回 数文本不超上界(数字, "1114111");
    }
    如果 (字符串比较(域文本, "整128") || 字符串比较(域文本, "正128")) {
        // 静默豁免业务值: 域判定谓词假=超域（调用方编译期拒·用户令 #1076），非默认值
        如果 (!字面量文本入域(数字, 域文本, 负)) { 返回 假; }
        返回 字面量文本入域128_640(数字, 域文本, 负);
    }
    返回 字面量文本入域(数字, 域文本, 负);
}
