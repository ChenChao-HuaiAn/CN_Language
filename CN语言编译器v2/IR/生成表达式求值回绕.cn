// 生成表达式求值回绕（1068 自 生成表达式求值中.cn 拆出·「先拆再加」纪律：
//   拆前 912 行越 900 警戒线——474 回绕内置 IR 展开发射族先拆后加 1068 域
//   对齐族）。474 段函数体逐字搬移零行为变化；1068 新增段见各函数注释。
//   依赖=容器/IR 包族/协议常量（节点池/IR 指令/寄存器表）；调用实参末位表
//   经 查调用实参末位474转发（T 生成表达式求值中.cn 同包薄转发）取值——
//   IR→语法 直调为 334 基线豁免存量面（13 处），本拆件经同包转发零新增
//   跨层依赖（check_layer_deps 冻结线只减不增）。
导入 容器::向量;
导入 映射集合;
导入 IR;         // IR_*/T_* 操作码 + IR常量 键位移（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 IR生成;     // 函数级变量类型权威表/重载决议/控制流辅助（同包幂等）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 1068（910 邻接·遗留收口）：字面量域名——字面量运行期类型单点（数学值域
//   提升链·宿主 types::integerLiteralRuntimeType 对称物）+ 形态提取。形态=
//   正字面量/负号+字面量（v2 负号独立节点·负号并入数学值判定）；非字面量
//   形态返回 0（调用方维持原契约——标识符/表达式实参走寄存器/解析链）。
//   v2 原链「无后缀纯十进制超整32域」判据对进制（0x/0b/0o）与后缀（L/U/
//   LL/UL/ULL）形态恒判整32 挂账口径——回绕乘(0x8000000000000000,1) 参与域
//   错位（应整128）；-9223372036854775808 装载 128 位（正文本恰 2^63 超
//   int64 上界触发 128 物化）而数学域=整64（同型普通算术按整64 域判溢出·
//   001 §3.7a 回绕同类型规则）。
函数 字面量域名1068(向量<节点> 池, 整64 末端) -> 整64 {
    如果 (末端 >= 0 && 末端 < 整64(池.大小())) {
        节点 末1068 = 池.元素(整32(末端));
        如果 (末1068.类型 == 节点_整数字面量) {
            返回 字面量运行期类型1068(字符串复制(驻留文本(整64(末1068.文本))), 假);
        }
        如果 (末1068.类型 == 节点_负号 && 末1068.子起点 > 0 &&
             末1068.子起点 < 整64(池.大小())) {
            节点 负子1068 = 池.元素(整32(末1068.子起点));
            如果 (负子1068.类型 == 节点_整数字面量) {
                返回 字面量运行期类型1068(字符串复制(驻留文本(整64(负子1068.文本))), 真);
            }
        }
    }
    返回 0;
}

// 1068：回绕实参升降域对齐——字面量实参装载域与数学值域不一致时经 IR 工具
//   换算：装载 128 位句柄而数学域 <128（唯一形态 -2^63 族）=降域（隐式窄化
//   到64 低半读取·814 通道）；装载 32/64 位值而数学域 128（LL/ULL 值域内
//   小值=恒定级 128）=升域（物化128位操作数·常量回扫按字面量文本拆半）。
//   其余形态原寄存器原样返回（零行为变化）。
不安全 函数 回绕实参对齐1068(整64 实参寄存器, 整64 末端, 向量<节点> 池,
                    向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数) -> 整64 {
    整64 域名1068 = 字面量域名1068(池, 末端);
    如果 (域名1068 != 0) {
        布尔 域128 = 域名1068 == 驻留("整128") || 域名1068 == 驻留("正128");
        // 1360 批5：未登记=类型未知（T_未知 兜底·既有业务语义），显式分流
        整64 装载码1068 = T_未知;
        可选<整64> 装载码1068查 = 查寄存器类型(实参寄存器);
        如果 (装载码1068查.有值) { 装载码1068 = 装载码1068查.值; }
        布尔 装载128 = 装载码1068 == T_整128 || 装载码1068 == T_正128;
        如果 (域128 && !装载128) {
            返回 物化128位操作数(实参寄存器, 装载码1068,
                                装载码1068 == T_正32 || 装载码1068 == T_正64 ? 0 : 1,
                                指令, 寄存器计数, 槽计数);
        }
        如果 (!域128 && 装载128) {
            // 降域=隐式窄化到64（IR_指针加载 低半读取——句柄指向低半槽，
            //   加载得 i64 位模式；插入值转换 128 源直拷读句柄槽本身=地址值
            //   非低半，禁用）；窄化不登记寄存器类型——补登记 T_整64 供下游
            //   回填链消费。
            整64 降域1068 = 隐式窄化到64(实参寄存器, 指令, 寄存器计数);
            登记寄存器类型(降域1068, T_整64);
            返回 降域1068;
        }
    }
    返回 实参寄存器;
}



// 1311 复审 P1：末端是否「无后缀非负整数字面量」（728s 随侧判据）——
//   算术/位面字面量按另一侧整数类型参与；负号字面量/带后缀字面量不随侧
//   （宿主 isUnsuffixedIntLiteral728 同构）。
函数 回绕末端无后缀非负474b(向量<节点> 池, 整64 末端) -> 布尔 {
    布尔 末有效474b = 末端 >= 0 && 末端 < 整64(池.大小());
    布尔 是字面474b = 假;
    如果 (末有效474b) { 是字面474b = 字面量域名1068(池, 末端) != 0; }
    布尔 无后缀非负474b = 假;
    如果 (是字面474b) {
        节点 字n474b = 池.元素(整32(末端));
        布尔 非负474b = 字n474b.类型 != 节点_负号;
        如果 (非负474b) {
            字符串 字文474b = "";
            如果 (字n474b.类型 == 节点_整数字面量) {
                字文474b = 字符串复制(驻留文本(整64(字n474b.文本)));
            }
            布尔 有后缀474b = 字面量后缀类型名ID(字文474b) != 0;
            无后缀非负474b = !有后缀474b;
        }
    }
    返回 无后缀非负474b;
}

// 1311 复审 P1：二元运算实参源码类型（语义 resolvedType 同序）——宿主 wrap
//   按语义类型 Cast；内层普通算术的 IR 结果码可能不同（宿主自身
//   整32(-1)+0U 的 IR=正32/语义=整32 双口径），v2 修前落 解析节点类型ID
//   无二元分支→0→寄存器码（正32）→ wrap 宽域分叉（4294967295 vs -1）。
//   规则与语义 推导二元类型ID 同序：
//   ①移位结果=左操作数类型（宿主 IR result=left.type）；
//   ②算术 + - * / %：285 窄+字面量拉窄 → 728s 无后缀字面量随另一侧；
//   ③位 & | ^：仅 728s；
//   ④整数族秩高者胜、同秩左优先（二元结果类型ID）。
函数 回绕二元源码类型474(向量<节点> 池, 整32 节点索引) -> 整64 {
    节点 n474b = 池.元素(节点索引);
    布尔 索引有效474b = 节点索引 >= 0;
    布尔 形态有效474b = n474b.类型 == 节点_二元运算 && n474b.附加 > 0 &&
        n474b.附加 <= 整32(池.大小()) && 索引有效474b && 节点索引 > 0;
    如果 (形态有效474b) {
        整64 左末474b = 整64(n474b.附加) - 1;
        整64 右末474b = 整64(节点索引) - 1;
        整64 左类474b = 回绕实参源码类型474(池, 左末474b);
        整64 右类474b = 回绕实参源码类型474(池, 右末474b);
        布尔 左可474b = 左类474b > 0;
        布尔 右可474b = 右类474b > 0;
        布尔 双侧可474b = 左可474b && 右可474b;
        如果 (双侧可474b) {
            字符串 op474b = 字符串复制(驻留文本(整64(n474b.文本)));
            // 比较/逻辑二元结果=布尔（宿主 checkExpr 同口径）——wrap 非整数
            //   实参面；语义守卫同判，本处防嵌套/旁路（IR 结果域不得按整数秩）。
            布尔 是布474b = 字符串比较(op474b, "==") || 字符串比较(op474b, "!=") ||
                字符串比较(op474b, "<") || 字符串比较(op474b, "<=") ||
                字符串比较(op474b, ">") || 字符串比较(op474b, ">=") ||
                字符串比较(op474b, "&&") || 字符串比较(op474b, "||");
            如果 (是布474b) { 返回 驻留("布尔"); }
            布尔 是移位474b = 字符串比较(op474b, "<<") || 字符串比较(op474b, ">>");
            如果 (是移位474b) { 返回 左类474b; }
            布尔 是算术474b = 字符串比较(op474b, "+") || 字符串比较(op474b, "-") ||
                字符串比较(op474b, "*") || 字符串比较(op474b, "/") ||
                字符串比较(op474b, "%");
            布尔 左字474b = 字面量域名1068(池, 左末474b) != 0;
            布尔 右字474b = 字面量域名1068(池, 右末474b) != 0;
            // 285（仅算术面·宿主同序）：一侧窄（秩1/2）+另一侧为字面量 →
            //   字面量侧按窄侧类型参与。
            如果 (是算术474b) {
                整64 左秩285 = 整数族类型秩474(左类474b);
                整64 右秩285 = 整数族类型秩474(右类474b);
                布尔 左窄285 = 左秩285 >= 1 && 左秩285 <= 2;
                布尔 右窄285 = 右秩285 >= 1 && 右秩285 <= 2;
                如果 (右窄285 && !左窄285 && 左字474b) { 左类474b = 右类474b; }
                否则 如果 (左窄285 && !右窄285 && 右字474b) { 右类474b = 左类474b; }
            }
            // 728s：无后缀非负字面量随另一侧（算术/位面；两侧均无后缀不互随）
            布尔 左无后缀474b = 回绕末端无后缀非负474b(池, 左末474b);
            布尔 右无后缀474b = 回绕末端无后缀非负474b(池, 右末474b);
            布尔 右整参474b = 整数族类型秩474(右类474b) > 0;
            布尔 左整参474b = 整数族类型秩474(左类474b) > 0;
            如果 (左无后缀474b && !右无后缀474b && 右整参474b) {
                左类474b = 右类474b;
            } 否则 如果 (右无后缀474b && !左无后缀474b && 左整参474b) {
                右类474b = 左类474b;
            }
            // 整数族秩高者胜、同秩左优先
            整64 左秩m474b = 整数族类型秩474(左类474b);
            整64 右秩m474b = 整数族类型秩474(右类474b);
            布尔 左秩有效m474b = 左秩m474b > 0;
            布尔 右秩有效m474b = 右秩m474b > 0;
            如果 (左秩有效m474b && 右秩有效m474b) {
                布尔 左胜m474b = 左秩m474b >= 右秩m474b;
                如果 (左胜m474b) { 返回 左类474b; }
                返回 右类474b;
            }
            返回 左类474b;
        }
    }
    返回 0;
}

// 1311（#1281 返工调查）：回绕实参**非字面量**源码类型名推导——显式转换调用
//   （节点_调用·被调=整数类型名）按转换目标类型（宿主 visitCastExpr 返回
//   target 同位）；用户/内置函数调用按 查函数返回回退（纯名+键基+内置返回
//   三级单点）；二元运算按 回绕二元源码类型474（语义 resolvedType 同序）；
//   其余形态原样落 解析节点类型ID（容器/结构体/标识符/成员/下标/三元链——
//   其调用分支只认容器/结构体返回）。修前转换调用经 查函数返回回退对类型名
//   恒 miss→源码 0→结果码落寄存器码兜底（语义侧同 miss 时更先登记整64 中止）。
//   白名单单点=IR包 是整数显式转换目标474（与语义 回绕实参侧类型474 共用）。
函数 回绕实参源码类型474(向量<节点> 池, 整64 末端) -> 整64 {
    如果 (末端 >= 0 && 末端 < 整64(池.大小())) {
        节点 末n474 = 池.元素(整32(末端));
        // 字面量（正/负号+字面量）：数学值域单点（1068）——二元实参递归面
        //   需要字面量参与域（主路径已在外层先行判定，此处补齐递归入口）。
        整64 字域474 = 字面量域名1068(池, 末端);
        如果 (字域474 != 0) { 返回 字域474; }
        布尔 调用形态474 = 末n474.类型 == 节点_调用 && 末n474.子起点 > 0 &&
            末n474.子起点 < 整64(池.大小());
        如果 (调用形态474) {
            节点 被调n474 = 池.元素(整32(末n474.子起点));
            如果 (被调n474.类型 == 节点_标识符) {
                字符串 名n474 = 字符串复制(驻留文本(整64(被调n474.文本)));
                // ①显式转换：目标类型（宿主 CastExpr 语义）
                如果 (是整数显式转换目标474(名n474)) { 返回 驻留(名n474); }
                // ②用户函数/内置函数返回类型（查函数返回回退=纯名+键基+内置
                //   返回三级单点；解析节点类型ID 的调用分支当前只认容器/结构体
                //   ——1186 标量返回第三级未并入本树，本处 wrap 面直接消费单点）
                整64 查返n474 = 查函数返回回退(整64(被调n474.文本));
                布尔 函数返有效474 = 查返n474 > 0;
                如果 (函数返有效474) { 返回 查返n474; }
            }
        }
        // ③二元运算：语义 resolvedType 同序推导（内层普通算术 IR 结果码可能
        //   与语义不同——见 回绕二元源码类型474 头注）
        如果 (末n474.类型 == 节点_二元运算) {
            返回 回绕二元源码类型474(池, 整32(末端));
        }
        整64 调返n474 = 解析节点类型ID(池, 整32(末端));
        返回 调返n474;
    }
    返回 0;
}

// 1311 P0：整数检查码→整数族秩（宿主 types::intRankOfName 同构；128 档=5）。
//   回绕结果域推导专用——禁复用 公共整型提升（其窄码宽 0→T_整64、同宽无符号
//   胜，与语义 回绕调用返回类型实现474 的秩规则分叉：整8+整32 应整32、
//   整8+整16 应整16、整32+正32 应左整32）。
函数 整数族检查码秩474(整64 码) -> 整64 {
    如果 (码 == T_整8 || 码 == T_正8) { 返回 1; }
    如果 (码 == T_整16 || 码 == T_正16) { 返回 2; }
    如果 (码 == T_整32 || 码 == T_正32) { 返回 3; }
    如果 (码 == T_整64 || 码 == T_正64) { 返回 4; }
    如果 (码 == T_整128 || 码 == T_正128) { 返回 5; }
    返回 0;
}

// 1311 P0：回绕实参参与码——名码优先；名码 miss 回寄存器码（128 族保留原码
//   ——溢出检查码映射表不含 128，直接丢弃会在结果域推导中漏秩 5）。
函数 回绕实参提码474(整64 名码, 整64 寄存器) -> 整64 {
    如果 (名码 != 0) { 返回 名码; }
    // 1360 批5：未登记=类型未知（T_未知 兜底·既有业务语义：交溢出检查码映射）
    整64 寄存码474p = T_未知;
    可选<整64> 寄存码474p查 = 查寄存器类型(寄存器);
    如果 (寄存码474p查.有值) { 寄存码474p = 寄存码474p查.值; }
    布尔 寄存128p = 寄存码474p == T_整128 || 寄存码474p == T_正128;
    如果 (寄存128p) { 返回 寄存码474p; }
    返回 溢出检查码自码474(寄存码474p);
}

// ==================== 474（运行期整数溢出·回绕逃生门） ====================
// 回绕加(a,b)/回绕减(a,b)/回绕乘(a,b) 三件套 IR 展开发射——两补码回绕语义
//   （错误码 8 溢出检查的显式豁免口·宿主同构）。发射形态：IR_加/减/乘 附加=
//   -(检查码)（回绕协议·代码生成共用.cn），类型字段=提升宽码（32 位出口截断
//   既有面），窄域结果经 插入值转换 回窄（377 乙案同款）。常量实参折叠=
//   -O1 优化层回绕折叠（附加<0·优化.cn 474 面）——O0 运行期回绕，结果一致。
//   返回 真=本形态已处理（消费 1 个位置）；假=非回绕函数（调用方继续分派）。
不安全 函数 生成回绕展开(向量<节点> 池, 节点 n, 整32 位置,
                   向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数,
                   向量<整64>& 表达式栈) -> 布尔 {
    如果 (n.子起点 <= 0) { 返回 假; }
    节点 被调474 = 池.元素(整32(n.子起点));
    如果 (被调474.类型 != 节点_标识符) { 返回 假; }
    字符串 被调名474 = 字符串复制(驻留文本(整64(被调474.文本)));
    整64 运算码474 = IR_加;
    如果 (字符串比较(被调名474, "回绕减")) { 运算码474 = IR_减; }
    否则 如果 (字符串比较(被调名474, "回绕乘")) { 运算码474 = IR_乘; }
    否则 如果 (!字符串比较(被调名474, "回绕加")) { 返回 假; }
    如果 (n.附加 != 2) {
        IR层诊断("回绕加/回绕减/回绕乘 恰需 2 个整型实参: " + 被调名474);
        运行时错误(6);
    }
    // 弹 2 实参（栈顶=右参先弹）+ 被调负占位（函数名兜底压栈·生成调用 主路径
    //   同款弹收——88-a 净栈契约：区间净增量恒 +1，漏弹=多压违规）
    整64 右474 = 0;
    整64 左474 = 0;
    如果 (表达式栈.大小() >= 2) {
        右474 = 表达式栈.元素(表达式栈.大小() - 1);
        结果<空类型, 整32> 删右474 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删右474.正常) { 运行时错误(4); }
        左474 = 表达式栈.元素(表达式栈.大小() - 1);
        结果<空类型, 整32> 删左474 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删左474.正常) { 运行时错误(4); }
    }
    如果 (表达式栈.大小() > 0) {
        结果<空类型, 整32> 删被调474 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删被调474.正常) { 运行时错误(4); }
    }
    // 结果码推导（377 同口径）：实参末位（查调用实参末位·解析层记录）→ 源码
    //   类型名（字面量/负号字面量=T_整32 参与·其余 解析节点类型ID）——双侧同窄
    //   →窄码；窄+对侧字面量→窄码；单侧窄→窄码（混合宽度左优先=提升语义）；
    //   宽名映射；寄存器提升码兜底；全 miss=T_整64。
    // 648 归档：末位表 miss=474 溢出检查 helper 对 IR 层合成调用（被调负占位·
    //   解析层无记录）的固有缺表推导链起点（设计预期路径·多层回填兜底自洽），
    //   非查表 miss 病面，不登记。
    整64 左末474 = 查调用实参末位474转发(整64(位置), 0);
    整64 右末474 = 查调用实参末位474转发(整64(位置), 1);
    // 1068：字面量实参源码类型=数学值域单点（原恒 T_整32 哨兵——进制/后缀
    //   超域形态装载码与数学值域不一致时错域：4294967296U 装载 T_正32 而
    //   数学域 正64）；128 族留哨兵（128 通道由下方寄存器码特判接管）。
    //   形态判定=显式节点检查（正字面量/负号+字面量），非字面量走原解析。
    整64 左源码474 = T_整32;
    布尔 左字面形态474 = 假;
    如果 (左末474 >= 0 && 左末474 < 整64(池.大小())) {
        整64 左域1068 = 字面量域名1068(池, 左末474);
        左字面形态474 = 左域1068 != 0;
        如果 (左字面形态474) {
            如果 (左域1068 != 驻留("整128") && 左域1068 != 驻留("正128")) {
                左源码474 = 左域1068;
            }
        }
        // 1068：非字面量形态=显式枚举第二分支（else 新规禁业务倒装）；
        //   1311：显式转换调用按转换目标类型（回绕实参源码类型474 单点）
        如果 (!左字面形态474) {
            左源码474 = 回绕实参源码类型474(池, 左末474);
        }
    }
    整64 右源码474 = T_整32;
    布尔 右字面形态474 = 假;
    如果 (右末474 >= 0 && 右末474 < 整64(池.大小())) {
        整64 右域1068 = 字面量域名1068(池, 右末474);
        右字面形态474 = 右域1068 != 0;
        如果 (右字面形态474) {
            如果 (右域1068 != 驻留("整128") && 右域1068 != 驻留("正128")) {
                右源码474 = 右域1068;
            }
        }
        // 1068：非字面量形态=显式枚举第二分支（else 新规禁业务倒装）；
        //   1311：显式转换调用按转换目标类型（回绕实参源码类型474 单点）
        如果 (!右字面形态474) {
            右源码474 = 回绕实参源码类型474(池, 右末474);
        }
    }
    // 1068：字面量实参升降域对齐（装载域 ≠ 数学值域——-2^63 族降域 /
    //   LL/ULL 值域内小值升域）；非字面量形态原寄存器原样（零行为变化）。
    左474 = 回绕实参对齐1068(左474, 左末474, 池, 指令, 寄存器计数, 槽计数);
    右474 = 回绕实参对齐1068(右474, 右末474, 池, 指令, 寄存器计数, 槽计数);
    // 结果码推导（377 同口径+字面量寄存器域回填·p5 探针教训：表达式实参的
    //   源码推导 miss 时须落寄存器提升域，禁误落字面量整32 标记域）
    整64 左名码474 = 检查码自类型名ID(左源码474);
    如果 (左名码474 == 0 && 左源码474 == T_整32) {
        // 1360 批5：未登记=类型未知（T_未知 兜底·既有业务语义：交溢出检查码映射）
        整64 左查码474 = T_未知;
        可选<整64> 左查码474r = 查寄存器类型(左474);
        如果 (左查码474r.有值) { 左查码474 = 左查码474r.值; }
        左名码474 = 溢出检查码自码474(左查码474);
        // 535：负号字面量数学值域内整32 时参与域压回整32——装载域按数字正文本
        //   超 int32 正域升整64（-2147483648 装载 T_整64），但同型普通算术
        //   （-2147483648 - 1）双侧编译期按整32 域判溢出=参与域整32（001 §3.7a
        //   回绕与算术同类型规则）；32 位域发射读低 32 位恰 INT32_MIN 位模式·
        //   回绕出口截断既有面承载。修前 64 位回绕出 -2147483649 vs 宿主
        //   2147483647（整32 回绕域反向分叉残存形态）。
        如果 (左名码474 == T_整64 && 左末474 >= 0 && 左末474 < 整64(池.大小())) {
            节点 左压节点474 = 池.元素(整32(左末474));
            如果 (左压节点474.类型 == 节点_负号 && 左压节点474.子起点 > 0 &&
                 池.元素(左压节点474.子起点).类型 == 节点_整数字面量 &&
                 负号字面量值入整32域(驻留文本(整64(
                     池.元素(左压节点474.子起点).文本)))) {
                左名码474 = T_整32;
            }
        }
    }
    整64 右名码474 = 检查码自类型名ID(右源码474);
    如果 (右名码474 == 0 && 右源码474 == T_整32) {
        // 1360 批5：未登记=类型未知（T_未知 兜底·既有业务语义：交溢出检查码映射）
        整64 右查码474 = T_未知;
        可选<整64> 右查码474r = 查寄存器类型(右474);
        如果 (右查码474r.有值) { 右查码474 = 右查码474r.值; }
        右名码474 = 溢出检查码自码474(右查码474);
        // 535：右实参同左（对称压回·判据见左分支注释）
        如果 (右名码474 == T_整64 && 右末474 >= 0 && 右末474 < 整64(池.大小())) {
            节点 右压节点474 = 池.元素(整32(右末474));
            如果 (右压节点474.类型 == 节点_负号 && 右压节点474.子起点 > 0 &&
                 池.元素(右压节点474.子起点).类型 == 节点_整数字面量 &&
                 负号字面量值入整32域(驻留文本(整64(
                     池.元素(右压节点474.子起点).文本)))) {
                右名码474 = T_整32;
            }
        }
    }
    布尔 右字面474 = 右字面形态474 || 右源码474 == T_整32;
    布尔 左字面474 = 左字面形态474 || 左源码474 == T_整32;
    // 1311 P0：参与码（名码优先，miss 回寄存器码；128 族保留原码）。
    整64 左提码474 = 回绕实参提码474(左名码474, 左474);
    整64 右提码474 = 回绕实参提码474(右名码474, 右474);
    // 535：字面量豁免捷径限窄域（285 面域=整8/整16/正8/正16）。
    布尔 左窄码474 = 左名码474 == T_整8 || 左名码474 == T_整16 ||
                 左名码474 == T_正8 || 左名码474 == T_正16;
    布尔 右窄码474 = 右名码474 == T_整8 || 右名码474 == T_整16 ||
                 右名码474 == T_正8 || 右名码474 == T_正16;
    整64 结果码474 = 0;
    如果 (左名码474 != 0 && 左名码474 == 右名码474) {
        结果码474 = 左名码474;
    } 否则 如果 (左名码474 != 0 && 右字面474 && 左窄码474) {
        结果码474 = 左名码474;
    } 否则 如果 (右名码474 != 0 && 左字面474 && 右窄码474) {
        结果码474 = 右名码474;
    }
    // 1311 P0：混合域=整数族秩高者胜·同秩左优先（宿主 commonNumericType
    //   rankA>=rankB ? a : b；语义 回绕调用返回类型实现474 同序）。禁止
    //   复用 公共整型提升——该单点按 32/64 位宽近似且同宽无符号胜，整8 与
    //   整32 同宽不同秩会误落整64/无符号。
    如果 (结果码474 == 0) {
        整64 左秩474 = 整数族检查码秩474(左提码474);
        整64 右秩474 = 整数族检查码秩474(右提码474);
        布尔 左秩有效474 = 左秩474 > 0;
        布尔 右秩有效474 = 右秩474 > 0;
        如果 (左秩有效474 && 右秩有效474) {
            布尔 左秩胜474 = 左秩474 >= 右秩474;
            如果 (左秩胜474) { 结果码474 = 左提码474; }
            布尔 右秩胜474 = !左秩胜474;
            如果 (右秩胜474) { 结果码474 = 右提码474; }
        } 否则 如果 (左秩有效474) {
            结果码474 = 左提码474;
        } 否则 如果 (右秩有效474) {
            结果码474 = 右提码474;
        }
    }
    // 474 收口追加（538）：整128/正128 实参面——回绕强制 128 位 helper 无检查
    //   版。1311 P1-2：若按 285 字面量豁免已得窄结果（如 整8 变量 + 128 域
    //   字面量），128 helper 不得抢先接管（否则宿主窄域回绕 vs v2 128 位回绕
    //   错值）——128 实参先取低 64 位（模 2^8/2^16 截断与先窄化等价），落
    //   常规 64 位回绕路径；非窄结果（含 32/64/128 公共域）保持 128 helper。
    // 1360 批5：未登记=类型未知（T_未知 兜底·既有业务语义：非 128 源）
    整64 左码128w = T_未知;
    可选<整64> 左码128w查 = 查寄存器类型(左474);
    如果 (左码128w查.有值) { 左码128w = 左码128w查.值; }
    整64 右码128w = T_未知;
    可选<整64> 右码128w查 = 查寄存器类型(右474);
    如果 (右码128w查.有值) { 右码128w = 右码128w查.值; }
    布尔 左有128w = 左码128w == T_整128 || 左码128w == T_正128;
    布尔 右有128w = 右码128w == T_整128 || 右码128w == T_正128;
    布尔 窄结果w474 = 结果码474 == T_整8 || 结果码474 == T_整16 ||
        结果码474 == T_正8 || 结果码474 == T_正16;
    如果 ((左有128w || 右有128w) && 窄结果w474) {
        如果 (左有128w) {
            // 128 句柄→低半值（IR_指针加载）；插入值转换 对 128 源直拷=地址
            //   值非低半（1068 对齐段同款教训），禁用。
            左474 = 隐式窄化到64(左474, 指令, 寄存器计数);
            登记寄存器类型(左474, T_整64);
        }
        如果 (右有128w) {
            右474 = 隐式窄化到64(右474, 指令, 寄存器计数);
            登记寄存器类型(右474, T_整64);
        }
    } 否则 如果 (左有128w || 右有128w) {
        如果 (发射128位二元运算(运算码474, 左474, 右474, 指令, 寄存器计数,
                                槽计数, 表达式栈, 1)) {
            返回 真;
        }
        // 538 通道失败=IR 内部契约破坏（加/减/乘 三码恒受支持）——显式登记
        //   中止，禁回落下方 64 位回绕把 128 句柄当地址相加（538 错值族）。
        登记内部未登记("回绕内置 128 位发射失败",
                       "节点" + 整数转字符串(整64(位置)), 整64(取当前诊断行()));
        返回 真;
    }
    // 1311 P0：结果域仍不可得=IR 推导链真 miss——显式登记中止（禁静默整64
    //   继续；语义侧同 miss 已先登记并中止，本行为纵深防线）。
    如果 (结果码474 == 0) {
        登记内部未登记("回绕内置结果域推导失败（IR 源码类型链 miss）",
                       "节点" + 整数转字符串(整64(位置)), 整64(取当前诊断行()));
        结果码474 = T_整64;
    }
    // 类型字段：32/64 位面=检查码本身（32 位出口截断既有面）；窄面=提升宽码
    //   （后端 64 位域回绕运算·窄规范化由下方 插入值转换 承担）
    整64 类型字段474 = T_整64;
    如果 (结果码474 == T_整32 || 结果码474 == T_正32 ||
         结果码474 == T_整64 || 结果码474 == T_正64) {
        类型字段474 = 结果码474;
    }
    整64 结果寄存器474 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(运算码474, 左474, 右474, 0, 结果寄存器474, 类型字段474,
                         0 - 结果码474));
    如果 (结果码474 == T_整8 || 结果码474 == T_整16 ||
         结果码474 == T_正8 || 结果码474 == T_正16) {
        结果寄存器474 = 插入值转换(结果寄存器474, 结果码474, 指令, 寄存器计数);
    }
    登记寄存器类型(结果寄存器474, 结果码474);
    结果<空类型, 整32> 加474 = 表达式栈.追加(结果寄存器474);
    如果 (!加474.正常) { 运行时错误(4); }
    返回 真;
}
