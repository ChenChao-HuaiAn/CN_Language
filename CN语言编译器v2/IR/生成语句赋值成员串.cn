// 生成语句赋值——成员串字段写入族（#2025 用户令「先拆再加」：赋值尾文件触
//   1000 冻结线，按族拆出本文件——纯搬移零语义变更 + 混合来源三元归一化）。
//   职责：成员字符串字段写入来源分级（字面量驻留/拥有接管/借用复制）+ 旧值
//   pre-free + #2025 三元拥有标志条件释放。
导入 容器::向量;
导入 映射集合;
导入 IR;
导入 协议常量;

公开:

// 成员字符串字段写入归一化发射面（172-a 自 生成成员解引用赋值 机械搬移；
//   172-a 前为 生成赋值语句 662~723 段；79-a/87-a 族）——返回写回后的值
//   寄存器（借用来源经 __cn_str_copy 落堆时换用 copy 寄存器）。
不安全 函数 发射成员串字段写入(向量<节点> 池, 节点 n, 节点 左末, 整64 地址寄存器,
                  整64 值寄存器, 函数IR& 函数信息, 向量<IR指令>& 指令,
                  整64* 寄存器计数) -> 整64 {
    如果 (地址寄存器 != 0 && 值寄存器 != 0 && 左末.类型 == 节点_成员) {
        整64 父链IDw = 0;
        可选<整64> 父链查w = 解析成员链结构体ID(池, 整32(左末.子起点));
        如果 (父链查w.有值) { 父链IDw = 父链查w.值; }
        如果 (父链IDw != 0) {
            可选<整64> 字段类型查w = 查字段类型ID(父链IDw, 整64(左末.文本));
            如果 (字段类型查w.有值) {
                整64 字段类型IDw = 字段类型查w.值;
                // #1700 乙案：手动释放<T> 字符串载荷字段同走来源归一化（新值
                //   复制落堆/接管——调用方拥有临时结算面不知槽已接管·浅直存=
                //   悬垂·宿主 memberStringFieldAssign strLikeField 同构），
                //   但 pre-free 跳过（覆盖即忘·001 §5.6 ③——忘旧责任随声明
                //   归用户，释放由 摘除(槽.值) 执行）。装载载荷类型后按原判据
                //   分派（字段类型IDw 局部重绑=载荷类型）。
                整64 载荷IDw = 手动释放载荷串载荷(字段类型IDw);
                布尔 有载荷w = 载荷IDw > 0;
                如果 (有载荷w) { 字段类型IDw = 载荷IDw; }
                如果 (字符串比较(驻留文本(字段类型IDw), "字符串")) {
                节点 右末w = 池.元素(n.子终点 - 1);
                布尔 需复制 = 真;
                布尔 三元条件释放w = 假;
                // #2025：成员串字段赋值位混合三元——恒拥有直取（零拷贝）；
                //   否则复制落堆 + 按拥有标志条件释放原值（拥有分支回收·
                //   借用分支零释放）。原三元恒复制=拥有分支产物孤儿。
                如果 (右末w.类型 == 节点_三元运算) {
                    布尔 恒有w = 三元恒拥有(池, 整32(n.子终点 - 1));
                    如果 (恒有w) { 需复制 = 假; }
                    如果 (!恒有w) { 需复制 = 真; 三元条件释放w = 真; }
                }
                如果 (右末w.类型 == 节点_字符串字面量) { 需复制 = 假; }
                否则 如果 (右末w.类型 == 节点_二元运算 &&
                          字符串比较(驻留文本(整64(右末w.文本)), "+")) {
                    // 861（732 同口径·零分叉）：二元连接（+）产物=新堆串——直存
                    //   接管不复制（对齐 发射拥有串赋值 ②「节点_二元运算」；宿主
                    //   normalizeStringValueSource ⑥ 定义点溯源同源）。原一律
                    //   copy=拼接产物线程孤儿（复合赋值 += 重析落成员链后每轮
                    //   净泄 1 个中间串——探针 p9②d 实录）。+ 守卫防指针算术误入。
                    需复制 = 假;
                }
                否则 如果 (右末w.类型 == 节点_调用 && 右末w.子起点 > 0) {   // 静默豁免闭集穷举: 调用形态守卫（非调用/无被调=非本分支·形态谓词）
                    节点 被调w = 池.元素(整32(右末w.子起点));
                    如果 (被调w.类型 == 节点_标识符) {
                        整64 被调名w = 整64(被调w.文本);
                        布尔 白名单w = 被调名w == 驻留("字符串复制") ||
                                      被调名w == 驻留("字符串连接") ||
                                      被调名w == 驻留("字符串拼接") ||
                                      被调名w == 驻留("字符串子串") ||
                                      被调名w == 驻留("字符串大写") ||
                                      被调名w == 驻留("字符串小写") ||
                                      被调名w == 驻留("字符串修剪") ||
                                      被调名w == 驻留("字符串反转");
                        如果 (!白名单w) {
                            // 1541 B2：无值=返回类型未知（原 0 判据等价）
                            可选<整64> 返回查w = 查函数返回回退(被调名w);
                            如果 (返回查w.有值) {
                                整64 返IDw = 返回查w.值;
                                如果 (返IDw == 驻留("字符串")) {
                                    白名单w = 真;   // A2 契约：签名即契约
                                }
                            }
                        }
                        需复制 = !白名单w;
                    }
                }
                整64 原值w = 值寄存器;
                如果 (需复制) {
                    值寄存器 = 发射字符串复制调用(指令, 寄存器计数, 值寄存器);
                }
                如果 (三元条件释放w) {
                    发射串临时条件释放(池, 整64(n.子终点) - 1, 原值w, 指令,
                                        寄存器计数, &函数信息.块计数);
                }
                // 静默豁免闭集穷举: 成员左值对象子节点存在性守卫（无对象子节点=非本面）
                如果 (左末.子起点 > 0) {
                    节点 对象w = 池.元素(整32(左末.子起点));
                    布尔 是拥有字段槽w = 假;
                    如果 (对象w.类型 == 节点_标识符) {
                        // 861（644-b 成员段对称补完）：变量（局部/参数/静态）
                        //   对象的字段槽恒拥有——字段独立拥有立法：重赋值须
                        //   drop 旧值（原判据仅「资源字段名单/静态结构体」=
                        //   标识符真子集：局部类对象字段长期漏释放——探针 p9②d
                        //   百轮旧值泄 100 实录）。对象为成员链/下标 place 的
                        //   形态维持保守不释放（宁漏勿错·与宿主同口径）。
                        //   87-a（2026-09-12 第八十七轮）：顶层静态结构体字段槽
                        //   ——槽长期存活恒拥有（局部按块出口 drop；静态无出口，
                        //   重复赋值必须当场 drop 旧串，否则每次赋值泄漏）。
                        是拥有字段槽w = 真;
                    }
                    // #1933：成员链接收者链宿主拥有判定（宿主
                    //   memberStringRecvPlaceOwned 同构）——上溯链根=标识符：
                    //   ①根∈容器变量们（类载荷盒·声明位经 盒拥有载荷 判定登记
                    //     =盒拥有载荷）→ 真——盒.值.名称 = 串 覆盖旧串前 drop
                    //     （修前每轮泄 1）；借用盒（不在名单=#1884 甲案盒不拥有
                    //     载荷）不命中=保守假（宁漏勿错防源槽析构双删）。
                    //   ②根∈资源字段局部们（结构体含串字段聚合局部·79-a 登记
                    //     同判据）→ 真——c.里.名 = 串 同根缝（修前同漏）。
                    //   ③其余链形态（下标/解引用/调用根·深度护栏越界）=假（保守
                    //     不释放）。现行标识符面（恒真）零变化。
                    否则 如果 (对象w.类型 == 节点_成员 &&
                         对象w.子起点 >= 1 &&
                         对象w.子起点 < 整32(池.大小())) {
                        整32 链根索引 = 整32(对象w.子起点);
                        布尔 链根命中 = 假;
                        整64 链根名 = 0;
                        整32 链深 = 0;
                        布尔 可续链 = 假;
                        当 (链深 <= 8 && !链根命中) {
                            节点 链根节点 = 池.元素(链根索引);
                            如果 (链根节点.类型 == 节点_标识符) {
                                链根名 = 整64(链根节点.文本);
                                链根命中 = 真;
                            }
                            如果 (!链根命中 &&
                                 链根节点.类型 == 节点_成员 &&
                                 链根节点.子起点 >= 1 &&
                                 链根节点.子起点 < 整32(池.大小())) {
                                链根索引 = 整32(链根节点.子起点);
                                可续链 = 真;
                            }
                            // 非标识符且非成员（下标/解引用/调用根）=断链保守假
                            如果 (!链根命中 && !可续链) { 中断; }
                            链深 = 链深 + 1;
                        }
                        如果 (链根命中) {
                            整64 名i盒链 = 0;
                            当 (名i盒链 < 函数信息.容器变量们.大小()) {
                                如果 (函数信息.容器变量们.元素(名i盒链) == 链根名) {
                                    是拥有字段槽w = 真;
                                }
                                名i盒链 = 名i盒链 + 1;
                            }
                            名i盒链 = 0;
                            当 (名i盒链 < 函数信息.资源字段局部们.大小()) {
                                如果 (函数信息.资源字段局部们.元素(名i盒链) == 链根名) {
                                    是拥有字段槽w = 真;
                                }
                                名i盒链 = 名i盒链 + 1;
                            }
                        }
                    }
                    // 644-b 构造内豁免（同口径公式）：构造体内字段=初始化语义
                    //   （拷贝构造 this 槽可能未初始化=栈槽/realloc 垃圾），
                    //   不 preFree（145-a 同规）。
                    布尔 构造内w = 假;
                    // 静默豁免闭集穷举: 方法类上下文守卫（无类上下文=非构造内·布尔判定）
                    如果 (当前方法类名ID > 0 &&
                         取当前方法名ID() == 驻留(合成名基名(
                             字符串复制(驻留文本(当前方法类名ID))))) {
                        构造内w = 真;
                    }
                    布尔 无载荷w = 载荷IDw == 0;
                如果 (是拥有字段槽w && !构造内w && 无载荷w) {
                        // #1700 乙案：手动释放<T> 目标槽旧值释放跳过（覆盖即忘）
                        整64 旧regw = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_指针加载, 地址寄存器, 0, 0, 旧regw, T_字符串, 0));
                        IR追加(指令, 建IR指令(IR_调用实参, 旧regw, 0, 0, 0, 0, 0));
                        IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                             驻留("__cn_str_free")));
                        如果 (函数信息.零寄存器 != 0) {
                            IR追加(指令, 建IR指令(IR_指针存储, 地址寄存器,
                                         函数信息.零寄存器, 0, 0, T_整64, 0));
                        }
                    }
                }
            }
        }
    }
    }
    返回 值寄存器;
}

// 698-b〔基准=019〕：类/容器元素槽写入=**拷贝构造深拷**（宿主 emitStructWholeAssign
//   类源 NewObject+拷贝构造/追加 asm rcx=元素槽 rdx=&值 call 拷贝构造·7178 实证同款）
//   ——原 IR_结构体拷贝 56B 浅字节拷共享指针字段（桶数组/键数组/链数组）→源 RAII
//   析构后元素槽悬垂（698-a 铁证：压入 的 层 析构 free 桶数组→元素0 桶数组=悬垂块
//   →拷贝构造读 BAADF00D→链查找 READ at -1 段错误）。装配：句柄槽 ← 源壳地址·
//   拷贝构造(自身=元素槽·其他=&句柄槽)——自身=内联接收一跳写、其他=T& 句柄两跳
//   （698-a 定案契约）。元素类无拷贝构造（查类构造参数串 miss=纯数据类）→返回 假
//   调用方按 IR_结构体拷贝收尾（POD 浅拷语义安全）。
//   边界：覆盖写场景元素槽旧值无 preFree（追加 末尾写=新槽无旧值·
//   覆盖写场景由 86-a 串 preFree 通道自理）——旧容器元素泄漏面登记 025 §1.9。
