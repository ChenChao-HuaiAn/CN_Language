// CN 自举编译器 v2 · 生成语句数组整体赋值（#2065 拆分单元）
//   职责：数组整体赋值通道（252 立法·E2E 630 双测门禁）——自 生成语句结构体
//   赋值.cn 迁出（该文件 940 行超 900 警戒线·先拆再加纪律；函数体逐字保留零
//   行为变更+静态分支补 #2065 深拷立法）。居消费方（生成语句结构体赋值）之前
//   加载。层依赖纪律：本文件只依赖 IR 同层（IR数组工具 的 发射数组元素级深拷
//   经包内合并全局池解析）。
//
//   #2065（2026-11-05 用户批准立法）：**顶层静态数组整体赋值=深拷**——顶层跟进
//   #1979 类静态槽深拷（发射类静态数组字段整块拷 同构），消除「同一整体赋值
//   语法写在顶层是浅拷、写在类字段是深拷」语义不一致（浅拷两侧共享句柄本体=
//   一侧释放另一侧悬垂=安全隐患面；宿主探针分配账目实证修前整块位拷增量=0）。
//   发射=IR_结构体拷贝 整块（元素步进×长度）+发射数组元素级深拷（#1880 设施
//   内部元素甄别显式枚举：字符串=__cn_str_copy 独立副本/容器类=拷贝构造/嵌套
//   数组递归到底；纯标量=位拷已正确零义务）。源域=同型数组标识符（252 守卫
//   同款·与宿主 emitGlobalStaticArrayDeepCopy 同域零分叉）；目标=顶层静态/
//   静态局部（静态槽即数组本体·静态槽长期存活恒拥有）与局部/参数基址槽（位拷
//   维持——值槽模型元素位拷已正确·非本件立法射程不扩战场）。

导入 容器::向量;
导入 映射集合;
导入 IR;         // IR指令/IR_*/T_* 操作码（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 252（2026-10-07·#252·E2E 630 双测门禁）：数组整体赋值（乙 = 甲·类型[N] 同型）
//   值语义整块拷——001 §3.5 数组=值聚合（赋值拷贝语义·087 形参 rep movsb /
//   087b 声明位 IR_结构体拷贝 同口径）。源=数组名退化基址（94-a 指针变量表
//   登记 → 生成表达式 即基址·087b 源 reg 同源）；目标=局部/参数基址槽（94-a
//   登记 槽起+槽数-1）IR_取地址·引用形参槽=槽存地址 IR_加载。位拷语义=元素
//   字符串/类句柄共享（与 087 形参同·85-a 域双侧一致不扩战场）。守卫：右值
//   仅同型数组标识符（非标识符/异型/目标槽 0=静态与字段面 让位普通通道=
//   既有诊断面·双侧行为一致性探针挂观察）。
//   #2065：静态目标分支=整块+元素级深拷（顶层跟进类静态槽·立法见文件头）。
不安全 函数 生成数组整体赋值(向量<节点> 池, 节点 n, 整64 目标槽,
                        映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                        函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                        向量<整64>& 表达式栈) -> 布尔 {
    整64 左名ID = 整64(n.文本);
    整64 左类型ID = 解析标识符类型ID(左名ID);
    如果 (左类型ID == 0) { 返回 假; }
    如果 (n.子终点 <= n.子起点) { 返回 假; }
    节点 右末 = 池.元素(整32(n.子终点 - 1));
    如果 (右末.类型 != 节点_标识符) { 返回 假; }
    // 同型守卫：类型节点 ID 相同（=同数组类型·比文本比较更强）
    整64 右类型ID = 解析标识符类型ID(整64(右末.文本));
    如果 (右类型ID != 左类型ID) { 返回 假; }
    // 自赋值（甲 = 甲）no-op——位拷自赋值恒无副作用（79-a 同判据）
    如果 (整64(右末.文本) == 左名ID) { 返回 真; }
    // 类型字节=元素步进×长度（类型大小与对齐 单点·宿主 typeSizeOf 同构）
    字符串 左类型文本 = 字符串复制(驻留文本(左类型ID));
    结果<整64, 整32> 步进查赋 = 数组元素步进(左类型文本);
    整64 字节数 = 0;
    如果 (步进查赋.正常) { 字节数 = 步进查赋.值 * 数组长度文本(左类型文本); } 否则 {
    }
    如果 (字节数 <= 0) { 返回 假; }
    // 源基址：数组名退化=元素指针（生成标识符加载=基址地址）
    整64 表达式栈前深度 = 表达式栈.大小();
    整64 源基址 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                              函数信息.指令, 寄存器计数, &函数信息.块计数,
                              槽计数, 表达式栈);
    当 (表达式栈.大小() > 表达式栈前深度) {
        结果<空类型, 整32> 删栈搬运 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈搬运.正常) { 运行时错误(4); }
    }
    // 259（2026-10-07·#259 静态数组）：目标=**顶层静态数组**（目标槽 0·查静态
    //   序号命中+静态类型是数组）——目标基址=IR_静态地址（静态槽即数组本体·
    //   259 数据段按元素×长度分配；宿主 assignToGlobalStatic 259 同款）。
    //   #2065：整块拷后**元素级深拷**（顶层跟进 #1979 类静态槽深拷立法——静态
    //   槽长期存活恒拥有，句柄型元素浅拷共享=一侧释放另一侧悬垂隐患面；静态
    //   局部数组同分支覆盖=同款深拷·与宿主 061-b 接线同域）。
    如果 (目标槽 == 0) {
        结果<整64, 整32> 查静态序号目 = 查静态序号含类(左名ID);
        // 静默豁免业务值: 静态表 miss=非静态目标·交回既有原路径（返假契约·1360 批5 结果化）
        如果 (!查静态序号目.正常) { 返回 假; }
        整64 静态序号目 = 查静态序号目.值;
        如果 (!是数组类型文本(驻留文本(取静态类型(静态序号目)))) { 返回 假; }
        整64 静态数组基址 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(函数信息.指令, 建IR指令(IR_静态地址, 0, 0, 0, 静态数组基址,
                                      T_整64, 静态序号目));
        IR追加(函数信息.指令, 建IR指令(IR_结构体拷贝, 源基址, 静态数组基址, 0, 0,
                                      字节数, 0));
        // #2065：元素句柄型逐元素深拷替换独立副本（#1880 发射数组元素级深拷
        //   设施·发射类静态数组字段整块拷 同一发射核心——纯标量元素=内部闭集
        //   穷举终点零义务·632 标量用例零发射行为不变）
        发射数组元素级深拷(函数信息.指令, 寄存器计数, 静态数组基址, 源基址,
                          左类型文本, 0);
        返回 真;
    }
    // 目标基址：引用形参槽=槽存被引数组地址（IR_加载）；普通基址槽=IR_取地址
    整64 目标基址 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    如果 (槽是引用(目标槽)) {
        IR追加(函数信息.指令, 建IR指令(IR_加载, 目标槽, 0, 0, 目标基址,
                                      T_整64, 0));
    } 否则 {
        IR追加(函数信息.指令, 建IR指令(IR_取地址, 目标槽, 0, 0, 目标基址,
                                      T_整64, 0));
    }
    IR追加(函数信息.指令, 建IR指令(IR_结构体拷贝, 源基址, 目标基址, 0, 0,
                                  字节数, 0));
    返回 真;
}
