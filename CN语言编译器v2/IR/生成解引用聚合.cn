// CN 自举编译器 v2 · 解引用聚合地址语义（#1878·宿主 #1720 同构）
// 职责：聚合（结构体/合成体/数组）所指指针的解引用辅助三件套——聚合判定谓词、
//   所指类型推导单点、地址语义发射。
// 语义（宿主 #1720 已确立·plans/001 指针解引用）：**聚合表达式的 IR 产物恒为
//   「对象地址」**（place 语义单点：标识符聚合/成员链/下标/结构体字面量同款），
//   解引用亦不例外——`*p` 的产物=指针值本身（所指对象地址），整块拷贝由消费者
//   按**声明宽度**执行（声明初值/整体赋值/成员与元素目标位/传参/返回）。标量
//   解引用维持读取（IR_指针加载）。
//   v2 修前一律 IR_指针加载：只读所指前 8 字节当**值**，聚合消费者按「聚合=地址」
//   把该值当地址 → 合成体/结构体初值自野地址整块拷；整变量赋值只写所指首 8
//   字节；成员/元素/类字段目标位落 8 字节标量写=**静默 0**（最危险面）。
// 消费面：解析节点类型ID（类型推导）、生成一元运算（发射）、声明初值与整体赋值
//   通道（源类型推导 + 聚合判定）。
导入 容器::向量;
导入 协议常量;   // 节点 结构体 + 节点_* 常量（335 中立归属·IR 层禁引 语法 包）
导入 IR;         // IR指令/IR_* 操作码（目录包名）
导入 IR生成;     // 权威表访问（同包幂等）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 聚合值类型判定（解引用产物语义分流单点）：真=产物为对象地址；假=按值读取。
//   判定面与宿主 ir_expr_unary 同构三层：合成体（结果/可选·逐声明布局）/
//   数组（元素退化·C 布局）/结构体（结构体大小表）。
//   排除①尾星：`可选<T>**` 的 *p 所指=指针值本体（8 字节句柄），剥一层星后
//     文本带尾星——若按聚合走地址语义会把指针值当对象地址（宿主 isStructType
//     对指针形态恒假·types::isPointer 分流同构）。
//   排除②容器/用户类：v2 容器/类=指针槽模型（槽存句柄），`&容器变量`=槽地址，
//     *p 须**按值读句柄**才得到对象（宿主 isStructType 不含类声明面·分叉点
//     在槽模型本身·不在本判定）。撤守卫态容器实例会入结构体大小表（423-b），
//     故须显式排除（与 生成结构体整体赋值 守卫同口径）。
函数 是聚合值类型ID(整64 类型ID) -> 布尔 {
    // 类型名 ID 有效域=驻留池下标闭区间 [1, i64 上界]（双边界——0/负数非驻留
    //   ID）；无效 ID=非聚合（消费点均已按 可选 有值 分流，本守卫防越界驻留文本）。
    布尔 ID有效 = 类型ID >= 1 && 类型ID <= 9223372036854775807;
    字符串 类型文本 = "";
    布尔 有尾星 = 假;
    如果 (ID有效) {
        类型文本 = 字符串复制(驻留文本(类型ID));
        // 尾星=指针值本体（8 字节句柄）：剥尾星基名 剥后 ID 变化即有尾星——
        //   `可选<T>**` 的 *p 所指=指针值，若按聚合走地址语义会把指针值当对象
        //   地址（宿主 isStructType 对指针形态恒假·types::isPointer 分流同构）。
        有尾星 = 剥尾星基名(类型ID) != 类型ID;
    }
    // 指针/容器/用户类=句柄值语义，非「对象地址」聚合（容器与类=指针槽模型：
    //   `&变量`的槽地址与 *p 的读句柄分属两层，见函数头注）。
    如果 (有尾星 || 是用户类(类型文本) || 是容器类(类型文本)) { 返回 假; }
    返回 是结果类型(类型文本) || 是数组类型文本(类型文本) ||
           是结构体大小非零(类型ID);
}

// 解引用节点所指类型ID（类型推导单一事实源）：
//   操作数取**末节点**（子终点-1·655 设计注记：成员链尾=字段节点·单节点形态
//   同首节点），推导交 解析所指类型（标识符指针变量表/成员链字段真类型/
//   调用返回/指针算术/一元递归全分支·与解引用发射同一单点）。
//   无值=不可推导（消费点各自显形：类型推导返回无、发射面 648 登记）。
函数 解引用节点所指类型ID(向量<节点> 池, 节点 解引用节点) -> 可选<整64> {
    如果 (解引用节点.子终点 <= 0) { 返回 无; }
    返回 解析所指类型(池, 整32(解引用节点.子终点 - 1));
}

// 解引用发射（生成一元运算 解引用分支唯一实现）：
//   聚合所指 → IR_字段地址 偏移 0 = 「判空（错误码 3）后回同一地址」的既有原语
//     （三后端 emitFieldAddr 同构·907）——保留判空，`点 q = *空针` 报错误码 3
//     而非段错误；标量所指 → IR_指针加载 按所指宽度读取（原路径零变化）。
//   产物寄存器类型登记：聚合=T_整64（地址句柄）；标量=所指宽度码（T_整64 默认
//   免登记·与原实现同）。
不安全 函数 发射解引用产物(向量<节点> 池, 节点 n, 整64 操作数寄存器,
                            整64 产物寄存器, 向量<IR指令>& 指令) -> 空类型 {
    可选<整64> 所指查 = 解引用节点所指类型ID(池, n);
    布尔 聚合所指 = 假;
    如果 (所指查.有值) { 聚合所指 = 是聚合值类型ID(所指查.值); }
    如果 (聚合所指) {
        IR追加(指令, 建IR指令(IR_字段地址, 操作数寄存器, 0, 0, 产物寄存器,
                              T_整64, 0));
        登记寄存器类型(产物寄存器, T_整64);
        返回;
    }
    整64 所指码 = 解引用所指宽度码(池, n);
    IR追加(指令, 建IR指令(IR_指针加载, 操作数寄存器, 0, 0, 产物寄存器,
                          所指码, 0));
    如果 (所指码 != T_整64) {
        登记寄存器类型(产物寄存器, 所指码);
    }
}
