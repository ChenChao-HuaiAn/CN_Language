// IR 生成·格式化调用展开（#1910·001 §10.6 编译期配对立法 2026-11-02·方案甲 64 位面）
// 职责：格式化 内置调用的完全接管发射——占位符扫描（中立层单点）+宽位改写
//   （%d64/%u64/%d128/%u128 → %s）+ 转字符串临时串注入（64 位走
//   __cn_str_from_int/uint 标量单槽、128 位走 __cn_str_from_i128/u128 双槽 ABI）
//   + 转串临时就地结算（合成寄存器非 AST 拥有串形态·617 AST 形态结算不覆盖，
//   __cn_format 只读消费毕就地释放=与宿主 emitFormatCallArgs ownedTemps 同构）。
//   语义层执法（语义检查格式化配对.cn）已拒全部可判违例；本层对「语义类型文本
//   miss 面」经寄存器类型码二次甄别——宽位种类配非宽位码=内部不一致显形中止
//   （运行时错误 4·禁静默错值，882 处置①）。
// 消费=生成表达式求值中.cn 生成打印与内置调用（格式化命中即接管·返回 1）。
// 诚实边界：不可达面断言借用 运行时错误(4) 通道=项目既有惯例（IR 层 754 处
//   同款·弹栈/追加失败同码）；错误码表无「内部错误」独立码=历史欠账（4 的
//   消息文案「内存分配失败」对断言位错位·呈报提及即立项）。
导入 容器::向量;
导入 协议常量;   // 扫描格式化占位符/T_*/查调用实参末位（中立层单点）

公开:

// 格式化调用完全接管发射。弹出们=倒序弹栈（弹出们[实参数-1-j] ↔ 实参 j），
//   实参 0=格式串。返回 1=已处理（表达式栈已压返回串寄存器）。
不安全 函数 生成格式化调用(向量<节点> 池, 向量<整64>& 弹出们,
                      向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数,
                      向量<整64>& 表达式栈, 整64 调用节点位) -> 整32 {
    整64 实参数 = 弹出们.大小();
    如果 (实参数 == 0) { 运行时错误(4); }   // 语义层已拒零实参（不可达面断言）

    // 实参 0（格式串）AST 定位——词法层已解码转义，驻留文本=纯内容格式串
    可选<整64> 串位查 = 查调用实参末位(调用节点位, 0);
    整64 串位 = 0 - 1;
    如果 (串位查.有值) { 串位 = 串位查.值; }
    如果 (串位 == 0 - 1 || 串位 >= 整64(池.大小())) { 运行时错误(4); }   // 定位表缺失（miss 哨兵判等）=内部不一致显形（非静默透传）
    节点 串节点 = 池.元素(整32(串位));
    如果 (串节点.类型 != 节点_字符串字面量) { 运行时错误(4); }   // 语义层已拒非字面量
    字符串 格式串 = 字符串复制(驻留文本(整64(串节点.文本)));

    // 占位符扫描：表外形态=语义层已拒（不可达面断言显形）
    向量<字符串> 种类们 = 向量<字符串>();
    字符串 改写串 = "";
    字符串 坏占位符 = "";
    如果 (!扫描格式化占位符(格式串, 种类们, 改写串, 坏占位符)) {
        运行时错误(4);
    }
    整64 坑数 = 整64(种类们.大小());
    如果 (坑数 + 1 != 实参数) { 运行时错误(4); }   // 语义层已拒个数违例（不可达断言）

    // 格式串改写（含宽位面时驻留新串替换实参 0 寄存器）
    整64 格式串弹位 = 实参数 - 1;
    如果 (!字符串比较(改写串, 格式串)) {
        整64 新串reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_常量字符串, 整64(驻留(改写串)), 0, 0,
                             新串reg, T_字符串, 0));
        登记寄存器类型(新串reg, T_字符串);
        结果<空类型, 整32> 设串 = 弹出们.设置(格式串弹位, 新串reg);
        如果 (!设串.正常) { 运行时错误(4); }
    }

    // 宽位实参转串注入（d64/u64/d128/u128 → %s + 转字符串调用）
    向量<整64> 转串临时们 = 向量<整64>();
    整64 位j = 0;
    当 (位j < 坑数) {
        字符串 种类j = 字符串复制(种类们.元素(整32(位j)));
        布尔 是宽位 = 字符串比较(种类j, "d64") || 字符串比较(种类j, "u64") ||
                     字符串比较(种类j, "d128") || 字符串比较(种类j, "u128");
        如果 (是宽位) {
            // 弹出们=倒序弹栈：弹出们[实参数-1]=格式串（实参 0），坑 j
            //   （0-based 数据坑）↔ 实参 j+1 ↔ 弹出们[实参数-2-j]
            整64 弹位j = 实参数 - 2 - 位j;
            整64 原reg = 弹出们.元素(弹位j);
            // 码面二次甄别：语义类型文本 miss 面（443 诚实边界放行）在此拦——
            //   宽位种类配非宽位码=语义/IR 不一致，显形中止（禁静默错值）。
            //   码源双级：寄存器类型表 → AST 节点类型（语义层权威·变量加载
            //   寄存器可能未登记类型）——双源皆 miss 才显形。
            可选<整64> 码查 = 查寄存器类型(原reg);
            整64 码 = 0;
            如果 (码查.有值) { 码 = 码查.值; }
            如果 (码 == 0) {
                可选<整64> 实参位查2 = 查调用实参末位(调用节点位, 位j + 1);
                如果 (实参位查2.有值) {
                    可选<整64> 节点型查 = 解析节点类型ID(
                        池, 整32(实参位查2.值));
                    如果 (节点型查.有值) { 码 = 类型码(节点型查.值); }
                }
            }
            如果 (码 == 0) { 运行时错误(4); }   // 双源皆 miss=内部不一致显形
            字符串 符号 = "";
            如果 (字符串比较(种类j, "d64")) {
                如果 (码 != T_整64) { 运行时错误(4); }
                符号 = "__cn_str_from_int";
            } 否则 如果 (字符串比较(种类j, "u64")) {
                如果 (码 != T_正64) { 运行时错误(4); }
                符号 = "__cn_str_from_uint";
            } 否则 如果 (字符串比较(种类j, "d128")) {
                如果 (码 != T_整128) { 运行时错误(4); }
                符号 = "__cn_str_from_i128";
            } 否则 如果 (字符串比较(种类j, "u128")) {
                如果 (码 != T_正128) { 运行时错误(4); }
                符号 = "__cn_str_from_u128";
            } 否则 {
                运行时错误(4);   // 宽位种类表外=不可达（是宽位判定先行）
            }
            向量<整64> 单实参 = 向量<整64>();
            结果<空类型, 整32> 加单 = 单实参.追加(原reg);
            如果 (!加单.正常) { 运行时错误(4); }
            整64 串reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            发射调用实参们(单实参, 0, 指令, 实参类型码们(单实参));
            IR追加(指令, 建IR指令(IR_调用参数化, 1, 类型码(T_字符串), 0,
                                 串reg, 0, 驻留(符号)));
            登记寄存器类型(串reg, T_字符串);
            结果<空类型, 整32> 设转 = 弹出们.设置(弹位j, 串reg);
            如果 (!设转.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加临 = 转串临时们.追加(串reg);
            如果 (!加临.正常) { 运行时错误(4); }
        }
        位j++;
    }

    // __cn_format 发射（串返回·消费族只读语义）
    发射调用实参们(弹出们, 0, 指令, 实参类型码们(弹出们));
    整64 返回寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_调用参数化, 实参数, 类型码(T_字符串), 0,
                         返回寄存器, 0, 驻留("__cn_format")));
    登记寄存器类型(返回寄存器, T_字符串);

    // 转串临时就地结算（__cn_format 只读消费毕；合成寄存器非 AST 拥有串
    //   形态·调用点 617 AST 形态结算不覆盖——释放权单点在本函数）
    整64 临k = 转串临时们.大小();
    当 (临k > 0) {
        发射串临时释放(转串临时们.元素(临k - 1), 指令, 寄存器计数);
        临k--;
    }

    结果<空类型, 整32> 加返回 = 表达式栈.追加(返回寄存器);
    如果 (!加返回.正常) { 运行时错误(4); }
    返回 1;
}
