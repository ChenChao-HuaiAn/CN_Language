// CN 自举编译器 v2 · IR 优化管线（345-a D33 首步：v2p 优化旗标接线，2026-09-18）
// 职责：级别驱动的函数级 IR 优化——常量折叠（含级联）+ 可物化零值的代数形态。
//   级别语义对齐宿主 cn_main -O 分级（-O1=折叠起步；-O2/-O3 预留后续 pass 分层）。
// 安全模型（345-a 六要素）：
//   ① 折叠产物**物化**为 IR_常量整数 指令（目标/类型承原指令）——v2 虚拟寄存器
//     =函数栈槽（代码生成 寄存器槽(目标)），物化后所有消费面（存储/调用实参/
//     返回/条件跳转等）经槽读值，天然无「未定义寄存器」风险；
//   ② 常量登记时按 常量指令.类型 一次性符号内嵌（32 位 wrap+符号化数学值·
//     265-a 公共提升保证算术产物类型=操作数公共类型，wrap 按产物类型=正确）；
//   ③ 比较折叠要求两操作数符号性一致（混符号=生成端宽松语义面·不折叠）；
// 保守边界：
//   ① 除/取余不折叠（除零运行时错误语义保持·INT_MIN/-1 边缘面外）；
//   ② 浮点不折叠（NaN/-0 语义陷阱）；
//   ③ 单块内值追踪（遇 标签/跳转/条件跳转 重置映射——跨块保守，Phi 场景安全）；
//   ④ 别名传播不做（v2 无寄存器拷贝操作码·丢弃定义指令会破坏非白名单消费面
//     ——x+0→x 类形态留后续 pass 配套操作码后启用）。
// 折叠表示：IR_常量整数 操作数1=值文本驻留ID——物化文本经 常量立即数文本/
//   字面量位模式（三后端·负值补码已有路径）发射，代码生成零感知。

导入 容器::向量;
导入 映射集合;
导入 IR;

公开:   // 主.cn 优化挂点经 导入 IR（包根聚合）解析本模块符号

// ==================== 级别入口（主.cn 代码生成前调用） ====================

函数 优化程序(向量<函数IR>& 函数表, 整64 级别) -> 空类型 {
    // 345-a 接手修正（三）：参数改 **向量引用**——v2 的结构体引用参数（程序IR&）
    //   按值拷贝处理：参数副本出作用域触发析构链（~向量<函数IR>→~向量<IR指令>）
    //   释放主程序共享数据 = UAF（gdb 崩栈铁证·-O0/-O3 产物相同=优化写在了副本上）。
    //   向量引用有效（收集静态 的 向量<整64>& 先例·自举链每日实证）。
    如果 (级别 <= 0) { 返回; }
    // 345-a 接手修正（四·定案）：v5=新函数表构建 + **向量整体赋值写回**
    //   （生成函数.cn:356 惯例）。历程：v1/v2（程序IR& 参数）=结构体引用按值
    //   拷贝→副本析构 UAF 崩；v3/v4（向量引用+元素(序) 原位/设置）=容器元素
    //   拷贝为**深拷**→写进副本数组、原表不变（产物相同）。v5 全部走既有
    //   成熟语义：局部向量重建 + 追加 + 向量赋值。
    向量<函数IR> 新函数表 = 向量<函数IR>();
    整64 i = 0;
    当 (i < 函数表.大小()) {
        函数IR 函数体 = 函数表.元素(i);
        优化函数(函数体, 级别);
        结果<空类型, 整32> 加 = 新函数表.追加(函数体);
        如果 (!加.正常) { 运行时错误(4); }
        i++;
    }
    函数表 = 新函数表;
}

// ==================== 函数级：原位单元素改写 ====================
// 345-a 接手修正（二）：弃「函数IR 副本重建+写回」整族方案——函数IR 含
//   向量/映射成员，按值拷贝=浅共享，任何「写回容器/出作用域赋值」都会触发
//   赋值位 preFree 或共享指针双重释放（gdb 铁证 free(0x671)·两版方案同崩）。
//   改为**原位单元素改写**：折叠=「指令→常量指令」的等价替换（**指令数不变**），
//   单条 IR指令=纯标量结构体（7×整64·无堆成员）→ 按值拷贝/写回完全安全；
//   `向量<IR指令>.设置` 为 stdlib 成熟路径（纯标量元素·析构被移除零注入）。
//   浅拷副本的 `.指令.设置(j,…)` 直接作用于共享底层数组=写穿到容器内元素。

// ==================== 常量定义登记 ====================

// ==================== 函数级：副本重建法（折叠=产物替代源指令·指令数不变） ====================

函数 优化函数(函数IR& 函数体, 整64 级别) -> 空类型 {
    向量<IR指令> 新表 = 向量<IR指令>();
    映射<整64, 整64> 折叠表 = 映射<整64, 整64>();
    映射<整64, 整64> 符号表 = 映射<整64, 整64>();
    整64 j = 0;
    当 (j < 函数体.指令.大小()) {
        IR指令 指令 = 函数体.指令.元素(j);
        // 块边界重置：控制流指令后映射全清（跨块保守）
        如果 (指令.操作码 == IR_标签 || 指令.操作码 == IR_跳转 ||
             指令.操作码 == IR_条件跳转) {
            折叠表 = 映射<整64, 整64>();
            符号表 = 映射<整64, 整64>();
            IR追加(新表, 指令);
            j++;
            继续;
        }
        // 常量定义登记（原生物化同路径）
        如果 (指令.操作码 == IR_常量整数) {
            登记常量定义(指令, 折叠表, 符号表);
            IR追加(新表, 指令);
            j++;
            继续;
        }
        // 折叠命中 → 物化常量指令替代源指令
        整64 折叠值 = 0;
        如果 (尝试折叠(指令, 折叠表, 符号表, 折叠值)) {
            IR指令 产物 = 建IR指令(IR_常量整数, 驻留(整数转字符串(折叠值)),
                                   0, 0, 指令.目标, 指令.类型, 0);
            IR追加(新表, 产物);
            击落定义(指令.目标, 折叠表, 符号表);
            整64 符号性 = (指令.类型 == T_正32 || 指令.类型 == T_正64) ? 0 : 1;
            落折叠表(指令.目标, 折叠值, 符号性, 折叠表, 符号表);
            j++;
            继续;
        }
        // 未折叠：定义寄存器 kill 旧映射（重定义防御）
        击落定义(指令.目标, 折叠表, 符号表);
        IR追加(新表, 指令);
        j++;
    }
    函数体.指令 = 新表;
}

函数 登记常量定义(IR指令 指令, 映射<整64, 整64>& 折叠表, 映射<整64, 整64>& 符号表) -> 空类型 {
    // 值文本解析（生成端常量文本=整数转字符串 十进制产物·可带负号）——
    //   私有解析不依赖代码生成包（frontend→ir→codegen 单向依赖纪律）
    整64 值 = 解析常量文本(驻留文本(指令.操作数1));
    整64 符号性 = (指令.类型 == T_正32 || 指令.类型 == T_正64) ? 0 : 1;
    落折叠表(指令.目标, 规范化(值, 指令.类型), 符号性, 折叠表, 符号表);
}

函数 解析常量文本(字符串 文本) -> 整64 {
    整64 结果值 = 0;
    整64 起 = 0;
    整64 符号 = 1;
    如果 (字符串长度(文本) > 0 && (整64(文本[0]) & 255) == 45) {
        起 = 1;
        符号 = 0 - 1;
    }
    整64 i = 起;
    当 (i < 字符串长度(文本)) {
        结果值 = 结果值 * 10 + ((整64(文本[i]) & 255) - 48);
        i++;
    }
    返回 符号 * 结果值;
}

函数 落折叠表(整64 寄存器, 整64 值, 整64 符号性, 映射<整64, 整64>& 折叠表,
              映射<整64, 整64>& 符号表) -> 空类型 {
    结果<空类型, 整32> 加常 = 折叠表.设置(寄存器, 值);
    如果 (!加常.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加符 = 符号表.设置(寄存器, 符号性);
    如果 (!加符.正常) { 运行时错误(4); }
}

函数 击落定义(整64 寄存器, 映射<整64, 整64>& 折叠表, 映射<整64, 整64>& 符号表) -> 空类型 {
    如果 (寄存器 == 0) { 返回; }
    如果 (折叠表.包含(寄存器)) { 折叠表.删除(寄存器); }
    如果 (符号表.包含(寄存器)) { 符号表.删除(寄存器); }
}

// ==================== 值规范化（位宽回绕+符号内嵌） ====================
// 32 位类型：wrap 后内嵌为可比较数学值（有符号 -2^31..2^31-1·无符号 0..2^32-1
//   ——两域非负段重叠无歧义：后续比较按符号性分派）；64 位类型：宿主机运算
//   天然回绕，位模式即值（无符号 64 位≥2^63 的位模式与负数学值同模——比较/
//   逻辑右移经 位模式序 转换处理，见 无符号序/逻辑右移64）。

函数 规范化(整64 值, 整64 类型) -> 整64 {
    如果 (类型 == T_整32) {
        整64 截断 = 值 & 4294967295;
        如果 (截断 >= 2147483648) { 返回 截断 - 4294967296; }
        返回 截断;
    }
    如果 (类型 == T_正32) { 返回 值 & 4294967295; }
    返回 值;
}

// ==================== 折叠分派 ====================

函数 尝试折叠(IR指令 指令, 映射<整64, 整64>& 折叠表, 映射<整64, 整64>& 符号表,
              整64& 折叠值) -> 布尔 {
    // 目标 0=无产物（存储/调用尾）；T_未知/浮点类型不折叠
    如果 (指令.目标 == 0 || 指令.类型 == T_未知) { 返回 假; }
    如果 (指令.类型 == T_浮32 || 指令.类型 == T_浮64) { 返回 假; }
    结果<整64, 整32> 查左 = 折叠表.获取(指令.操作数1);
    如果 (查左.正常) {
        整64 左值 = 查左.值;
        整64 产物 = 0;
        // 一元形态（只查左操作数）
        如果 (指令.操作码 == IR_负) {
            折叠值 = 规范化(0 - 左值, 指令.类型);
            返回 真;
        }
        如果 (指令.操作码 == IR_逻辑非) {
            折叠值 = (左值 == 0) ? 1 : 0;
            返回 真;
        }
        // 二元形态：右操作数须同为常量
        结果<整64, 整32> 查右 = 折叠表.获取(指令.操作数2);
        如果 (查右.正常) {
            如果 (折叠二元(指令, 左值, 查右.值, 折叠表, 符号表, 产物)) {
                折叠值 = 产物;
                返回 真;
            }
        }
    }
    返回 假;
}

// 二元折叠：算术/位运算/移位/比较（除/取余保守不折叠）。比较要求符号性一致。
函数 折叠二元(IR指令 指令, 整64 左值, 整64 右值, 映射<整64, 整64>& 折叠表,
              映射<整64, 整64>& 符号表, 整64& 产物) -> 布尔 {
    如果 (指令.操作码 == IR_加) { 产物 = 规范化(左值 + 右值, 指令.类型); 返回 真; }
    如果 (指令.操作码 == IR_减) { 产物 = 规范化(左值 - 右值, 指令.类型); 返回 真; }
    如果 (指令.操作码 == IR_乘) { 产物 = 规范化(左值 * 右值, 指令.类型); 返回 真; }
    如果 (指令.操作码 == IR_位与) { 产物 = 左值 & 右值; 返回 真; }
    如果 (指令.操作码 == IR_位或) { 产物 = 左值 | 右值; 返回 真; }
    如果 (指令.操作码 == IR_位异或) { 产物 = 左值 ^ 右值; 返回 真; }
    如果 (指令.操作码 == IR_左移) {
        产物 = 规范化(左值 << 移位量(右值, 指令.类型), 指令.类型);
        返回 真;
    }
    如果 (指令.操作码 == IR_右移) {
        产物 = 折叠右移(左值, 移位量(右值, 指令.类型), 指令.类型, 符号表, 指令.操作数1);
        返回 真;
    }
    如果 (是比较操作码(指令.操作码)) {
        结果<整64, 整32> 符左 = 符号表.获取(指令.操作数1);
        如果 (符左.正常) {
            结果<整64, 整32> 符右 = 符号表.获取(指令.操作数2);
            如果 (符右.正常) {
                // 符号性一致才折叠（混符号=生成端宽松语义面·不折叠）
                如果 (符左.值 == 符右.值) {
                    产物 = 比较真假(左值, 右值, 符左.值 == 1, 指令.操作码, 指令.类型);
                    返回 真;
                }
            }
        }
        返回 假;
    }
    返回 假;
}

// 移位量取模=左操作数类型位宽（规范 01b§5.4·生成端同款 C 语义）
函数 移位量(整64 量, 整64 类型) -> 整64 {
    如果 (类型 == T_整32 || 类型 == T_正32) { 返回 量 & 31; }
    返回 量 & 63;
}

// 右移折叠：有符号（T_整32/整64·值已符号内嵌）=算术右移；无符号 32 位=截断域
//   直接右移；无符号 64 位=位模式逻辑右移（逻辑右移64·防 MSB=1 位模式算术
//   填充污染）。T_正64 与 T_整64 同位模式域，符号性由 符号表 提供。
函数 折叠右移(整64 左值, 整64 量, 整64 类型, 映射<整64, 整64>& 符号表,
              整64 左寄存器) -> 整64 {
    如果 (类型 == T_正32) { 返回 (左值 & 4294967295) >> 量; }
    如果 (类型 == T_整32) { 返回 左值 >> 量; }
    如果 (类型 == T_正64) { 返回 逻辑右移64(左值, 量); }
    如果 (类型 == T_整64) {
        结果<整64, 整32> 符左 = 符号表.获取(左寄存器);
        如果 (符左.正常) {
            如果 (符左.值 == 0) { 返回 逻辑右移64(左值, 量); }
        }
        返回 左值 >> 量;
    }
    返回 左值 >> 量;
}

// 位模式逻辑右移（无符号语义·CN 整64 层实现）：算术右移后清 MSB 填充位；
//   n=0 恒等（1<<64 在 64 位域=0 的回绕陷阱特判）。
函数 逻辑右移64(整64 位模式, 整64 n) -> 整64 {
    如果 (n == 0) { 返回 位模式; }
    整64 掩码 = (1 << (64 - n)) - 1;
    返回 (位模式 >> n) & 掩码;
}

// 比较（32 位值经规范化已分域内嵌=直接 64 位数学比较；64 位无符号=位模式序
//   转换后比较——MSB 翻转把无符号序映射为有符号序·经典无符号比较技巧）。
函数 比较真假(整64 左值, 整64 右值, 布尔 有符号, 整64 操作码, 整64 类型) -> 整64 {
    如果 (!有符号 && (类型 == T_正64 || 类型 == T_整64)) {
        // flip MSB：无符号序→有符号序（0x8000000000000000 异或·分步合成防
        //   字面量 2^63 边界）
        整64 翻转 = 0 - 9223372036854775807 - 1;
        左值 = 左值 ^ 翻转;
        右值 = 右值 ^ 翻转;
    }
    布尔 真假 = 假;
    如果 (操作码 == IR_相等) { 真假 = 左值 == 右值; }
    否则 如果 (操作码 == IR_不等) { 真假 = 左值 != 右值; }
    否则 如果 (操作码 == IR_小于) { 真假 = 左值 < 右值; }
    否则 如果 (操作码 == IR_大于) { 真假 = 左值 > 右值; }
    否则 如果 (操作码 == IR_小于等于) { 真假 = 左值 <= 右值; }
    否则 { 真假 = 左值 >= 右值; }
    返回 真假 ? 1 : 0;
}

// ==================== 操作码分类判据 ====================

函数 是比较操作码(整64 操作码) -> 布尔 {
    返回 操作码 >= IR_相等 && 操作码 <= IR_大于等于;
}
