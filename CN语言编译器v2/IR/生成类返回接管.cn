// 生成类返回接管（544·458/438 同根族 先拆再加 自 生成类尾.cn 机械搬移·
//   纯搬移零行为变更 + 544 扩面）：类返回物「位拷物化接管」判定与发射——
//   ①声明位右值=复制(…)（438）②声明位右值=「返回类对象的调用」（458 普通调用
//   /544 方法调用·判定内聚于 是返回类调用_544）；消费方=生成类尾 发射类拷贝
//   构造初始化、生成语句赋值 544 赋值位分支。模块加载序居 生成类尾 之前
//   （依赖先解析——跨模块引用双向既有实证：生成类中→生成类尾 前向先例）。
导入 容器::向量;   // 向量 参数/局部（节点池）
导入 映射集合;     // 映射<整64, 整64>& 形参（局部槽/参数槽）
导入 IR;         // IR_*/T_* 操作码 + 类表/布局查询/符号合成
导入 协议常量;   // 335 重构B：节点 结构体/节点_* 常量/成员方法标记
导入 IR生成;     // 类型码/权威表/决议辅助（本族零 语法 包引用=不导入）

公开:

// 438 根治（423 族·284 形态④⑤·复制声明位在册泄漏 +2）：右值=复制(…)调用形态 →
//   产物=堆对象句柄，**接管直存**（82-a 返回接收接管同款语义）。
//   缺陷链（探针矩阵实证·宿主净 0/v2 残留 +2）：右值 复制(甲) 求值时 LUE 命中
//   （纯局部标识符+后向无读）→ 生成复制展开LUEmove 源槽清零（所有权移交）；原
//   拷贝构造初始化通道再拿该句柄当源 NewObject+拷贝构造深拷——复制语义与 move
//   语义混搭：乙=深拷新壳，甲 原壳（连同其字段容器与元素）因源槽已清零失去唯一
//   持有者成孤儿 → 块出口仅回收乙 深拷一方（任务行「深拷后块出口仅回收一方」
//   实录；活分配数 +2=原数据数组+原字符串，原壳/字段容器壳 calloc 不计数同泄漏）。
//   非 LUE 态（源后向有读）同泄漏形态：复制 内置 ③ 分支已 NewObject 独立深拷壳，
//   原通道再拷一次=双重深拷+临时壳孤儿（719 反证实证：撤修复 v2 退出码 9=②③两态
//   同红）。修复后两态皆句柄接管：LUE 态=move 接管（宿主 LUE 零拷贝对齐）、
//   非 LUE 态=消双重拷贝（③ 壳直存），块出口在册回收槽句柄一方、源方按各自语义
//   （LUE 已移交/非 LUE 保持拥有）回收——探针矩阵四形态双侧净 0。
//   返回 真=已接管直存终结（跳过 NewObject+拷贝构造主路径）；假=非复制形态落主路径。
不安全 函数 发射类复制声明接管(向量<节点> 池, 节点 n, 整64 类名ID, 整64 槽c,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    节点 复源末438 = 池.元素(n.子终点 - 1);
    如果 (!(复源末438.类型 == 节点_调用 && 复源末438.子起点 >= 0 &&
         整32(复源末438.子起点) < 整32(池.大小()))) { 返回 假; }
    节点 复被调438 = 池.元素(整32(复源末438.子起点));
    // 非 复制 形态（458 标识符普通调用 / 544 成员标记方法调用）→ 返回类调用接管
    如果 (复被调438.类型 != 节点_标识符 ||
         !字符串比较(驻留文本(整64(复被调438.文本)), "复制")) {
        // 458 扩面（438 同根）+544 扩面（成员标记）
        返回 发射返回类调用声明接管(池, n, 类名ID, 槽c, 局部槽, 参数槽,
                                   函数信息, 寄存器计数, 槽计数, 表达式栈);
    }
    // 完整求值右值（复制 展开：LUE 态=源槽清零+句柄移交/非 LUE 态=③ 独立深拷壳）
    整64 句柄438 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                               指令, 寄存器计数, &函数信息.块计数, 槽计数,
                               表达式栈);
    如果 (句柄438 != 0) {
        IR追加(指令, 建IR指令(IR_存储, 句柄438, 0, 0, 0, 0, 槽c));
    }
    当 (表达式栈.大小() > 0) {
        结果<空类型, 整32> 删栈438 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈438.正常) { 运行时错误(4); }
    }
    返回 真;
}

// 458 根治（438 同根扩面·414 段同款位拷物化）：右值=「返回类对象的普通调用」
//   ——声明位 货架 甲 = 造货架() 的接管。
//   缺陷链（817 复现矩阵·宿主净 0/v2 残留 +2）：右值经「发射类拷贝构造初始化」
//   深拷通道——调用按聚合返回 ABI 物化到调用方帧内独立槽（对象本体位拷贝），
//   拷贝构造从物化槽深拷出新壳入甲槽；被调函数内的**源壳**（局部类对象·返回位
//   跳过析构=移交语义）连同其字段资源失去唯一持有者成孤儿（残留 +2=源壳字段
//   容器数据数组+字符串；壳 __cn_object_new=calloc 不计数同泄漏不显）。宿主
//   语义=类返回句柄移交（rax=对象指针·调用点直存接管·零深拷零残留·探针实测）。
//   修法（判定从严·保持既有面不回归）：被调=标识符 && 决议函数符号命中 &&
//   返回类型**严格等于**声明位类（继承/限定名/引用返回形态维持原深拷路径，
//   不引入切片/布局错配风险）→ 位拷物化接管（414「运算符重载返回类对象」同款）；
//   544 扩面：被调=成员标记（对象.方法()·主仓 产()）同判据同接管（判定内聚于
//   是返回类调用_544·两形态共用）：
//   求值右值（=调用方帧内物化槽本体地址）→ NewObject 新壳 + IR_结构体拷贝
//   （本体→新壳位拷·字段句柄共享）→ IR_存储 直存声明槽。块出口在册回收声明槽
//   句柄一方（级联释放共享字段资源）；源壳成孤儿但字段资源所有权已随位拷转移
//   （源壳不再触达资源·零双释）。容器返回不走此路（容器声明位接收已是 生成容器
//   局部 同款位拷物化·全树稳态）；无拷贝构造类由本接管自然放行（宿主 move
//   语义同款·原深拷路径的克隆契约诊断面不变）。
//   返回 真=已接管直存终结；假=非该形态落 NewObject+拷贝构造主路径。
// 544（458 呈报·同根异面·两形态共用判定）：调用索引位=「返回类对象的调用」——
//   被调=标识符（普通调用·458 原判据：决议函数符号命中且返回类型**严格等于**
//   类名）或 被调=成员标记（方法调用·544 扩面：用户类接收者·类方法返回文本
//   原样严格等于类名——尾 & 引用返回/继承限定名自然不等=维持原深拷路径
//   保守面）。返回 真=产物经聚合返回 ABI 物化到调用方帧内（消费前须位拷
//   物化接管：声明位 发射返回类调用声明接管 / 赋值位 生成语句赋值 544 分支）。
函数 是返回类调用_544(向量<节点> 池, 整64 调用索引, 整64 类名ID) -> 布尔 {
    如果 (调用索引 <= 0 || 调用索引 >= 整64(池.大小())) { 返回 假; }
    节点 调用544 = 池.元素(整32(调用索引));
    如果 (调用544.类型 != 节点_调用 || 调用544.子起点 <= 0 ||
         整32(调用544.子起点) >= 整32(池.大小())) { 返回 假; }
    节点 被调544 = 池.元素(整32(调用544.子起点));
    如果 (被调544.类型 == 节点_标识符) {
        // 决议函数符号（重载裁决·与 生成调用 同源同表）→ 查返回类型登记——
        //   构造/内置调用 表 miss 自然排除（非用户函数）
        整64 键基544 = 0;
        整64 键串544 = 0;
        整64 段数544 = 0;
        整64 符号544 = 决议函数符号(池, 整64(被调544.文本), 整32(调用索引),
                                  键基544, 键串544, 段数544);
        如果 (符号544 == 0) { 返回 假; }
        返回 查函数返回类型(符号544) == 类名ID;
    }
    如果 (被调544.类型 == 节点_成员 && 被调544.附加 == 成员方法标记) {
        // 544 扩面：方法调用 主仓.产()——接收者=用户类（容器接收=元素/克隆族
        //   既有通道保持原路）；方法返回文本原样比较（尾 & 不剥=引用返回排除）
        整64 对象类544 = 解析节点类型ID(池, 整32(被调544.子起点));
        如果 (对象类544 == 0) { 返回 假; }
        字符串 接文本544 = 字符串复制(驻留文本(剥尾星基名(对象类544)));
        如果 (!是用户类(接文本544) || 是容器类(接文本544)) { 返回 假; }
        整64 方法返544 = 查类方法返回(整64(驻留(接文本544)), 整64(被调544.文本));
        如果 (方法返544 <= 1) { 返回 假; }
        返回 方法返544 == 类名ID;
    }
    返回 假;
}

不安全 函数 发射返回类调用声明接管(向量<节点> 池, 节点 n, 整64 类名ID, 整64 槽c,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    如果 (n.子终点 <= n.子起点) { 返回 假; }
    节点 调用458 = 池.元素(n.子终点 - 1);
    如果 (调用458.类型 != 节点_调用 || 调用458.子起点 <= 0 ||
         整32(调用458.子起点) >= 整32(池.大小())) { 返回 假; }
    // 被调形态+返回类型严格判定（458 标识符普通调用 / 544 成员标记方法调用）
    如果 (!是返回类调用_544(池, 整64(n.子终点 - 1), 类名ID)) { 返回 假; }
    // 类形守卫（枚举/结果/容器声明不得误入——容器接收为既有形态保持原路）
    如果 (!是用户类_ID(类名ID) || 是容器类_ID(类名ID)) { 返回 假; }
    整64 类尺寸458 = 查结构体大小(类名ID);
    如果 (类尺寸458 <= 0) { 返回 假; }
    // 求值右值（调用返回物化槽=调用方帧内对象本体地址——位拷源；与 414 段
    //   运算符重载返回类对象同款「NewObject+结构体拷贝」堆物化先例）
    整64 本体458 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                             指令, 寄存器计数, &函数信息.块计数, 槽计数,
                             表达式栈);
    如果 (本体458 != 0) {
        整64 新壳458 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新壳458, 类尺寸458, 类名ID));
        IR追加(指令, 建IR指令(IR_结构体拷贝, 本体458, 新壳458, 0, 0, 类尺寸458, 0));
        IR追加(指令, 建IR指令(IR_存储, 新壳458, 0, 0, 0, 0, 槽c));
    }
    当 (表达式栈.大小() > 0) {
        结果<空类型, 整32> 删栈458 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈458.正常) { 运行时错误(4); }
    }
    返回 真;
}

// 630（544 呈报·容器接收面·两形态）：容器元素类返回调用判定——「容器.方法(...)」
//   调用，接收者=容器类（非用户类）且容器方法签名返回文本（替换后）**严格等于**
//   目标类名（用户类）。命中=调用产物语义与 544 用户类接收面**不同**：容器方法
//   返回用户类元素（元素族·T=用户类）在 生成表达式求值中 容器分支被生成
//   「拷贝构造副本」（发射容器元素类副本630）——产物=**堆副本句柄**（对齐宿主
//   asm 权威：宿主元素() = NewObject+拷贝构造→rax=新副本句柄·plans/001 §052 甲
//   「元素(i) 返回副本·快照语义」）；消费=直存（声明位 生成类对象局部 630 分支）
//   /直存+旧值释放（赋值位 生成语句赋值 630 分支）——**不得**走 458/544 的
//   「本体位拷物化」（那以「产物=调用方帧内本体」为前提，对堆句柄会误拷）与
//   438 深拷主路径（对堆副本再拷贝构造=双重拷贝+首副本孤儿）。返回 假=非该形态
//   （接收者非容器/返回非目标类/签名 miss=保守面落原路径）。
函数 是容器元素类返回630(向量<节点> 池, 整64 调用索引, 整64 类名ID) -> 布尔 {
    如果 (类名ID == 0 || !是用户类_ID(类名ID) || 是容器类_ID(类名ID)) { 返回 假; }
    如果 (调用索引 <= 0 || 调用索引 >= 整64(池.大小())) { 返回 假; }
    节点 调用630 = 池.元素(整32(调用索引));
    如果 (调用630.类型 != 节点_调用 || 调用630.子起点 <= 0 ||
         整32(调用630.子起点) >= 整32(池.大小())) { 返回 假; }
    节点 被调630 = 池.元素(整32(调用630.子起点));
    如果 (被调630.类型 != 节点_成员 || 被调630.附加 != 成员方法标记) { 返回 假; }
    整64 对象类630 = 解析节点类型ID(池, 整32(被调630.子起点));
    如果 (对象类630 == 0) { 返回 假; }
    字符串 接文本630 = 字符串复制(驻留文本(剥尾星基名(对象类630)));
    如果 (!是容器类(接文本630)) { 返回 假; }
    方法签名 签630;
    如果 (!查方法签名(接文本630, 字符串复制(驻留文本(整64(被调630.文本))),
                     调用630.附加, &签630)) { 返回 假; }
    // 返回类型严格==目标类（结果/容器/标量/字符串/引用返回等自然不等=保守面）
    返回 字符串比较(签630.返回文本, 字符串复制(驻留文本(类名ID)));
}

// 630：容器方法返回用户类元素 → 拷贝构造副本发射（对齐宿主「元素() 返回副本」
//   值语义·快照〔基准=plans/001 §052 甲〕）：物化独立槽（槽内=元素对象句柄=
//   拷贝构造 T& 源约定「装着壳地址的槽」）→ NewObject 新壳 + 拷贝构造（深拷）→
//   返回堆副本句柄（消费方直存/直存+旧值释放）。返回 0=非该形态（非用户类/
//   容器类/无拷贝构造=维持原路径保守面/物化槽缺失）——调用方照旧走原分支。
不安全 函数 发射容器元素类副本630(字符串 返回文本, 整64 物化槽630,
                   向量<IR指令>& 指令, 整64* 寄存器计数) -> 整64 {
    如果 (物化槽630 == 0 || 字符串长度(返回文本) <= 0) { 返回 0; }
    如果 (!是用户类(返回文本) || 是容器类(返回文本)) { 返回 0; }
    整64 类ID630 = 驻留(返回文本);
    整64 拷贝串630 = 查类拷贝构造串(类ID630);
    如果 (拷贝串630 == 0) { 返回 0; }
    整64 新obj630 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新obj630,
         查结构体大小(类ID630), 类ID630));
    IR追加(指令, 建IR指令(IR_调用实参, 新obj630, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用实参, 物化槽630, 0, 0, 0, 1, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
         驻留(方法符号(返回文本, 剥实例基名(返回文本),
               字符串复制(驻留文本(拷贝串630))))));
    返回 新obj630;
}
