// 生成类返回接管（544·458/438 同根族 先拆再加 自 生成类尾.cn 机械搬移·
//   纯搬移零行为变更 + 544 扩面）：类返回物「位拷物化接管」判定与发射——
//   ①声明位右值=复制(…)（438）②声明位右值=「返回类对象的调用」（458 普通调用
//   /544 方法调用·判定内聚于 是返回类调用_544）；消费方=生成类尾 发射类拷贝
//   构造初始化、生成语句赋值 544 赋值位分支。模块加载序居 生成类尾 之前
//   （依赖先解析——跨模块引用双向既有实证：生成类中→生成类尾 前向先例）。
导入 容器::向量;   // 向量 参数/局部（节点池）
导入 映射集合;     // 映射<整64, 整64>& 形参（局部槽/参数槽）
导入 IR;         // IR_*/T_* 操作码 + 类表/布局查询/符号合成
导入 协议常量;   // 335 重构B：节点 结构体/节点_* 常量/成员方法标记
导入 IR生成;     // 类型码/权威表/决议辅助（本族零 语法 包引用=不导入）

公开:

// 438 根治（423 族·284 形态④⑤·复制声明位在册泄漏 +2）：右值=复制(…)调用形态 →
//   产物=堆对象句柄，**接管直存**（82-a 返回接收接管同款语义）。
//   缺陷链（探针矩阵实证·宿主净 0/v2 残留 +2）：右值 复制(甲) 求值时 LUE 命中
//   （纯局部标识符+后向无读）→ 生成复制展开LUEmove 源槽清零（所有权移交）；原
//   拷贝构造初始化通道再拿该句柄当源 NewObject+拷贝构造深拷——复制语义与 move
//   语义混搭：乙=深拷新壳，甲 原壳（连同其字段容器与元素）因源槽已清零失去唯一
//   持有者成孤儿 → 块出口仅回收乙 深拷一方（任务行「深拷后块出口仅回收一方」
//   实录；活分配数 +2=原数据数组+原字符串，原壳/字段容器壳 calloc 不计数同泄漏）。
//   非 LUE 态（源后向有读）同泄漏形态：复制 内置 ③ 分支已 NewObject 独立深拷壳，
//   原通道再拷一次=双重深拷+临时壳孤儿（719 反证实证：撤修复 v2 退出码 9=②③两态
//   同红）。修复后两态皆句柄接管：LUE 态=move 接管（宿主 LUE 零拷贝对齐）、
//   非 LUE 态=消双重拷贝（③ 壳直存），块出口在册回收槽句柄一方、源方按各自语义
//   （LUE 已移交/非 LUE 保持拥有）回收——探针矩阵四形态双侧净 0。
//   返回 真=已接管直存终结（跳过 NewObject+拷贝构造主路径）；假=非复制形态落主路径。
不安全 函数 发射类复制声明接管(向量<节点> 池, 节点 n, 整64 类名ID, 整64 槽c,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    节点 复源末438 = 池.元素(n.子终点 - 1);
    如果 (!(复源末438.类型 == 节点_调用 && 复源末438.子起点 >= 0 &&
         整32(复源末438.子起点) < 整32(池.大小()))) { 返回 假; }
    节点 复被调438 = 池.元素(整32(复源末438.子起点));
    // 非 复制 形态（458 标识符普通调用 / 544 成员标记方法调用）→ 返回类调用接管
    如果 (复被调438.类型 != 节点_标识符 ||
         !字符串比较(驻留文本(整64(复被调438.文本)), "复制")) {
        // 458 扩面（438 同根）+544 扩面（成员标记）
        返回 发射返回类调用声明接管(池, n, 类名ID, 槽c, 局部槽, 参数槽,
                                   函数信息, 寄存器计数, 槽计数, 表达式栈);
    }
    // 完整求值右值（复制 展开：LUE 态=源槽清零+句柄移交/非 LUE 态=③ 独立深拷壳）
    整64 句柄438 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                               指令, 寄存器计数, &函数信息.块计数, 槽计数,
                               表达式栈);
    如果 (句柄438 != 0) {
        IR追加(指令, 建IR指令(IR_存储, 句柄438, 0, 0, 0, 0, 槽c));
    }
    当 (表达式栈.大小() > 0) {
        结果<空类型, 整32> 删栈438 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈438.正常) { 运行时错误(4); }
    }
    返回 真;
}

// 458 根治（438 同根扩面·414 段同款位拷物化）：右值=「返回类对象的普通调用」
//   ——声明位 货架 甲 = 造货架() 的接管。
//   缺陷链（817 复现矩阵·宿主净 0/v2 残留 +2）：右值经「发射类拷贝构造初始化」
//   深拷通道——调用按聚合返回 ABI 物化到调用方帧内独立槽（对象本体位拷贝），
//   拷贝构造从物化槽深拷出新壳入甲槽；被调函数内的**源壳**（局部类对象·返回位
//   跳过析构=移交语义）连同其字段资源失去唯一持有者成孤儿（残留 +2=源壳字段
//   容器数据数组+字符串；壳 __cn_object_new=calloc 不计数同泄漏不显）。宿主
//   语义=类返回句柄移交（rax=对象指针·调用点直存接管·零深拷零残留·探针实测）。
//   修法（判定从严·保持既有面不回归）：被调=标识符 && 决议函数符号命中 &&
//   返回类型**严格等于**声明位类（继承/限定名/引用返回形态维持原深拷路径，
//   不引入切片/布局错配风险）→ 位拷物化接管（414「运算符重载返回类对象」同款）；
//   544 扩面：被调=成员标记（对象.方法()·主仓 产()）同判据同接管（判定内聚于
//   是返回类调用_544·两形态共用）：
//   求值右值（=调用方帧内物化槽本体地址）→ NewObject 新壳 + IR_结构体拷贝
//   （本体→新壳位拷·字段句柄共享）→ IR_存储 直存声明槽。块出口在册回收声明槽
//   句柄一方（级联释放共享字段资源）；源壳成孤儿但字段资源所有权已随位拷转移
//   （源壳不再触达资源·零双释）。容器返回不走此路（容器声明位接收已是 生成容器
//   局部 同款位拷物化·全树稳态）；无拷贝构造类由本接管自然放行（宿主 move
//   语义同款·原深拷路径的克隆契约诊断面不变）。
//   返回 真=已接管直存终结；假=非该形态落 NewObject+拷贝构造主路径。
// 544（458 呈报·同根异面·两形态共用判定）：调用索引位=「返回类对象的调用」——
//   被调=标识符（普通调用·458 原判据：决议函数符号命中且返回类型**严格等于**
//   类名）或 被调=成员标记（方法调用·544 扩面：用户类接收者·类方法返回文本
//   原样严格等于类名——尾 & 引用返回/继承限定名自然不等=维持原深拷路径
//   保守面）。返回 真=产物经聚合返回 ABI 物化到调用方帧内（消费前须位拷
//   物化接管：声明位 发射返回类调用声明接管 / 赋值位 生成语句赋值 544 分支）。
函数 是返回类调用_544(向量<节点> 池, 整64 调用索引, 整64 类名ID) -> 布尔 {
    如果 (调用索引 <= 0 || 调用索引 >= 整64(池.大小())) { 返回 假; }
    节点 调用544 = 池.元素(整32(调用索引));
    如果 (调用544.类型 != 节点_调用 || 调用544.子起点 <= 0 ||
         整32(调用544.子起点) >= 整32(池.大小())) { 返回 假; }
    节点 被调544 = 池.元素(整32(调用544.子起点));
    如果 (被调544.类型 == 节点_标识符) {
        // 决议函数符号（重载裁决·与 生成调用 同源同表）→ 查返回类型登记——
        //   构造/内置调用 表 miss 自然排除（非用户函数）
        整64 键基544 = 0;
        整64 键串544 = 0;
        整64 段数544 = 0;
        整64 符号544 = 决议函数符号(池, 整64(被调544.文本), 整32(调用索引),
                                  键基544, 键串544, 段数544);
        如果 (符号544 == 0) { 返回 假; }
        可选<整64> 返型查544 = 查函数返回类型(符号544);
        如果 (返型查544.有值 && 返型查544.值 == 类名ID) { 返回 真; }
        返回 假;
    }
    如果 (被调544.类型 == 节点_成员 && 被调544.附加 == 成员方法标记) {
        // 544 扩面：方法调用 主仓.产()——接收者=用户类（容器接收=元素/克隆族
        //   既有通道保持原路）；方法返回文本原样比较（尾 & 不剥=引用返回排除）
        可选<整64> 对象类查544 = 解析节点类型ID(池, 整32(被调544.子起点));
        如果 (!对象类查544.有值) { 返回 假; }
        整64 对象类544 = 0;
        如果 (对象类查544.有值) { 对象类544 = 对象类查544.值; }
        字符串 接文本544 = 字符串复制(驻留文本(剥尾星基名(对象类544)));
        如果 (!是用户类(接文本544) || 是容器类(接文本544)) { 返回 假; }
        // 1541 B2：无值=无此方法（原 !=0 判据）
        可选<整64> 方法返查544 = 查类方法返回(整64(驻留(接文本544)), 整64(被调544.文本));
        如果 (!方法返查544.有值) { 返回 假; }
        整64 方法返544 = 0;
        如果 (方法返查544.有值) { 方法返544 = 方法返查544.值; }
        如果 (方法返544 <= 1) { 返回 假; }
        返回 方法返544 == 类名ID;
    }
    返回 假;
}

不安全 函数 发射返回类调用声明接管(向量<节点> 池, 节点 n, 整64 类名ID, 整64 槽c,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    如果 (n.子终点 <= n.子起点) { 返回 假; }
    节点 调用458 = 池.元素(n.子终点 - 1);
    如果 (调用458.类型 != 节点_调用 || 调用458.子起点 <= 0 ||
         整32(调用458.子起点) >= 整32(池.大小())) { 返回 假; }
    // 被调形态+返回类型严格判定（458 标识符普通调用 / 544 成员标记方法调用）
    如果 (!是返回类调用_544(池, 整64(n.子终点 - 1), 类名ID)) { 返回 假; }
    // 类形守卫（枚举/结果/容器声明不得误入——容器接收为既有形态保持原路）
    如果 (!是用户类_ID(类名ID) || 是容器类_ID(类名ID)) { 返回 假; }
    // 879（980 红治理残余·p5/p7 实录）：原判据 尺寸<=0 返假把**空字段用户类**
    //   （合法 0 字节：NewObject 0 字节 + CopyStruct 0 字节）一并挡回主路径——
    //   有析构无拷贝构造=拒绝（p5）/有拷贝构造=深拷+析构 2 次（p7），与宿主
    //   「句柄移交/接管」（均 113322）分叉。查结构体大小 的 0=空类与未登记不可
    //   辨——miss 面已由上方 是用户类_ID 显式分流（非用户类必假），对用户类
    //   0 恒为合法空类（宿主 totalSize=0 空类同款走 NewObject|0）。
    // 求值右值（1818 丁案 R1 后：被调方返回位已副本（借用来源 NewObject 拷构/
    //   深拷）或移交句柄（拥有局部 LUE）——产物恒**唯一拥有句柄**，本通道退化为
    //   句柄接管直存（宿主 9a36199f8 注②「接收位零甄别：声明位兜底 Store 对
    //   唯一拥有产物皆正确」）。旧位拷物化（NewObject+本体尺寸结构体拷贝）随
    //   retbuf 本体通道退役：对句柄再位拷=双重拷贝+首副本孤儿（630 注同判据）。
    整64 本体458 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                             指令, 寄存器计数, &函数信息.块计数, 槽计数,
                             表达式栈);
    如果 (本体458 != 0) {
        IR追加(指令, 建IR指令(IR_存储, 本体458, 0, 0, 0, 0, 槽c));
    }
    当 (表达式栈.大小() > 0) {
        结果<空类型, 整32> 删栈458 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈458.正常) { 运行时错误(4); }
    }
    返回 真;
}

// 630（544 呈报·容器接收面·两形态）：容器元素类返回调用判定——「容器.方法(...)」
//   调用，接收者=容器类（非用户类）且容器方法签名返回文本（替换后）**严格等于**
//   目标类名（用户类）。命中=调用产物语义与 544 用户类接收面**不同**：容器方法
//   返回用户类元素（元素族·T=用户类）在 生成表达式求值中 容器分支被生成
//   「拷贝构造副本」（发射容器元素类副本630）——产物=**堆副本句柄**（对齐宿主
//   asm 权威：宿主元素() = NewObject+拷贝构造→rax=新副本句柄·plans/001 §052 甲
//   「元素(i) 返回副本·快照语义」）；消费=直存（声明位 生成类对象局部 630 分支）
//   /直存+旧值释放（赋值位 生成语句赋值 630 分支）——**不得**走 458/544 的
//   「本体位拷物化」（那以「产物=调用方帧内本体」为前提，对堆句柄会误拷）与
//   438 深拷主路径（对堆副本再拷贝构造=双重拷贝+首副本孤儿）。返回 假=非该形态
//   （接收者非容器/返回非目标类/签名 miss=保守面落原路径）。
函数 是容器元素类返回630(向量<节点> 池, 整64 调用索引, 整64 类名ID) -> 布尔 {
    如果 (类名ID == 0 || !是用户类_ID(类名ID) || 是容器类_ID(类名ID)) { 返回 假; }
    如果 (调用索引 <= 0 || 调用索引 >= 整64(池.大小())) { 返回 假; }
    节点 调用630 = 池.元素(整32(调用索引));
    如果 (调用630.类型 != 节点_调用 || 调用630.子起点 <= 0 ||
         整32(调用630.子起点) >= 整32(池.大小())) { 返回 假; }
    节点 被调630 = 池.元素(整32(调用630.子起点));
    如果 (被调630.类型 != 节点_成员 || 被调630.附加 != 成员方法标记) { 返回 假; }
    可选<整64> 对象类查630 = 解析节点类型ID(池, 整32(被调630.子起点));
    如果 (!对象类查630.有值) { 返回 假; }
    整64 对象类630 = 0;
    如果 (对象类查630.有值) { 对象类630 = 对象类查630.值; }
    字符串 接文本630 = 字符串复制(驻留文本(剥尾星基名(对象类630)));
    如果 (!是容器类(接文本630)) { 返回 假; }
    方法签名 签630;
    如果 (!查方法签名(接文本630, 字符串复制(驻留文本(整64(被调630.文本))),
                     调用630.附加, &签630)) { 返回 假; }
    // 返回类型严格==目标类（结果/容器/标量/字符串/引用返回等自然不等=保守面）
    返回 字符串比较(签630.返回文本, 字符串复制(驻留文本(类名ID)));
}

// 630：容器方法返回用户类元素 → 拷贝构造副本发射（对齐宿主「元素() 返回副本」
//   值语义·快照〔基准=plans/001 §052 甲〕）：物化独立槽（槽内=元素对象句柄=
//   拷贝构造 T& 源约定「装着壳地址的槽」）→ NewObject 新壳 + 拷贝构造（深拷）→
//   返回堆副本句柄（消费方直存/直存+旧值释放）。返回 0=非该形态（非用户类/
//   容器类/无拷贝构造=维持原路径保守面/物化槽缺失）——调用方照旧走原分支。
不安全 函数 发射容器元素类副本630(字符串 返回文本, 整64 物化槽630,
                   向量<IR指令>& 指令, 整64* 寄存器计数) -> 整64 {
    如果 (物化槽630 == 0 || 字符串长度(返回文本) <= 0) { 返回 0; }
    如果 (!是用户类(返回文本) || 是容器类(返回文本)) { 返回 0; }
    整64 类ID630 = 驻留(返回文本);
    可选<整64> 拷贝串查630 = 查类拷贝构造串(类ID630);
    如果 (!拷贝串查630.有值) { 返回 0; }
    // 上行无值已返回；此处 0 仅占位（不可达·既有未命中语义）
    整64 拷贝串630 = 0;
    如果 (拷贝串查630.有值) { 拷贝串630 = 拷贝串查630.值; }
    整64 新obj630 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    整64 类大小630 = 0;
    可选<整64> 类大小630查 = 查结构体大小(类ID630);
    如果 (类大小630查.有值) { 类大小630 = 类大小630查.值; }
    IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新obj630,
         类大小630, 类ID630));
    IR追加(指令, 建IR指令(IR_调用实参, 新obj630, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用实参, 物化槽630, 0, 0, 0, 1, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
         驻留(方法符号(返回文本, 剥实例基名(返回文本),
               字符串复制(驻留文本(拷贝串630))))));
    返回 新obj630;
}

// 922（#925 并入·p629i 形态）：容器目标 ←「返回容器的调用」产物（值返回）
//   判定——右值调用返回类型**严格等于**容器目标类型（用户类方法/自由函数
//   两形态）。区别于 633（引用返回=借用产物·不得释放旧值）与 630（容器方法
//   返回用户类元素=堆副本直存）：本判定命中=聚合返回 ABI sret 物化（容器壳
//   拷贝到调用方帧内栈槽）——消费方须先堆物化再入槽（见 赋值接管返回容器
//   调用922）。引用返回（方法/函数返回文本尾 &）与目标类型自然不等=保守面
//   排除；容器方法返回容器元素（接收者=容器·650-a 通道产物=堆句柄）由接收者
//   守卫排除；构造调用/内置调用 决议表 miss 自然排除。
//   返回 真=「值返回容器的调用」形态；假=非该形态（零行为变更）。
函数 是返回容器调用922(向量<节点> 池, 整64 调用索引, 整64 容器类型ID) -> 布尔 {
    如果 (容器类型ID <= 0 || !是容器类_ID(容器类型ID)) { 返回 假; }
    如果 (调用索引 <= 0 || 调用索引 >= 整64(池.大小())) { 返回 假; }
    节点 调用922 = 池.元素(整32(调用索引));
    如果 (调用922.类型 != 节点_调用 || 调用922.子起点 <= 0 ||
         整32(调用922.子起点) >= 整32(池.大小())) { 返回 假; }
    节点 被调922 = 池.元素(整32(调用922.子起点));
    如果 (被调922.类型 == 节点_标识符) {
        // 自由函数返回容器（构造/内置调用 决议表 miss 自然排除——非用户
        //   函数；与 是返回类调用_544 标识符面同源同表）
        整64 键基922 = 0;
        整64 键串922 = 0;
        整64 段数922 = 0;
        整64 符号922 = 决议函数符号(池, 整64(被调922.文本), 整32(调用索引),
                                  键基922, 键串922, 段数922);
        如果 (符号922 == 0) { 返回 假; }
        // 查函数返回类型 无值（miss）由 有值 守卫自然排除
        可选<整64> 返型查922 = 查函数返回类型(符号922);
        如果 (返型查922.有值 && 返型查922.值 == 容器类型ID) { 返回 真; }
        返回 假;
    }
    如果 (被调922.类型 == 节点_成员 && 被调922.附加 == 成员方法标记) {
        // 用户类方法返回容器（接收者=用户类·非容器——容器方法「元素()返回
        //   容器元素」=650-a 堆句柄通道保持原路；返回文本原样严格比较·尾 &
        //   引用返回自然不等排除）
        可选<整64> 对象类查922 = 解析节点类型ID(池, 整32(被调922.子起点));
        如果 (!对象类查922.有值) { 返回 假; }
        整64 对象类922 = 0;
        如果 (对象类查922.有值) { 对象类922 = 对象类查922.值; }
        字符串 接文本922 = 字符串复制(驻留文本(剥尾星基名(对象类922)));
// 接收者非用户类=非该通道形态（假=落原路径）
        如果 (!是用户类(接文本922) || 是容器类(接文本922)) { 返回 假; }
        可选<整64> 方法返查922 = 查类方法返回(整64(驻留(接文本922)), 整64(被调922.文本));
        如果 (!方法返查922.有值) { 返回 假; }
        整64 方法返922 = 0;
        如果 (方法返查922.有值) { 方法返922 = 方法返查922.值; }
        如果 (方法返922 <= 1) { 返回 假; }
        返回 方法返922 == 容器类型ID;
    }
    返回 假;
}

// 922（#925 并入）：容器标识符目标 ←「返回容器的调用」产物 赋值接管——
//   甲 = 厂.产（方法）/甲 = 造向量（自由函数）·甲=已声明容器变量。
//   缺陷链（922 探针矩阵双侧实证·9111/9112 双形态 C0000374）：被调方聚合
//   返回 ABI 把容器壳（24B：数据指针+元素数+容量·指针槽模型）rep movsb 到
//   调用方帧内槽（方法=retbuf/自由函数=物化独立槽·皆**栈地址**）——消费点
//   原落 472-a「右末=调用」分支 IR_存储 直存栈地址入目标槽：①块出口容器
//   RAII 按堆句柄 free 栈地址 → C0000374 堆损坏；②633 通道先求值 miss 后
//   472 二次求值=被调两次调用+物化① 数据数组孤儿（asm 双 call 铁证）。
//   宿主=调用产物已物化堆句柄（identifierClassCallProductAssign 直收=正确
//   基准）——v2 对齐声明位 091 堆物化：NewObject（容器对象大小）+ CopyStruct
//   壳（内部指针唯一性保持·被调拥有直移语义不变·零深拷）+**旧值释放**
//   （821 同款单发 DeleteObject·空句柄空安全·先求值后释放=自用右值安全）
//   + 句柄入槽（821 三分写回：静态/引用参数经指针/普通槽）。
//   求值单点（841-a 同款纪律）：挂 633 求值之前（命中即终结）——消灭 472-a
//   二次求值；判定从严：是返回容器调用922（被调两形态·返回类型严格等）∧
//   目标槽可定位（槽 0 且非静态=求值前返假交回原路径·零行为变更）。
//   返回 真=已接管直存终结；假=非该形态。
不安全 函数 赋值接管返回容器调用922(向量<节点> 池, 节点 n, 整64 目标槽,
                     整64 左名ID, 整64 左类型ID, 向量<IR指令>& 指令,
                     映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                     函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                     向量<整64>& 表达式栈) -> 布尔 {
    如果 (n.子终点 <= n.子起点) { 返回 假; }
// 非「值返回容器调用」形态（假=落原路径）
    如果 (!是返回容器调用922(池, 整64(n.子终点 - 1), 左类型ID)) { 返回 假; }
    布尔 静922 = 假;
    整64 静序922 = 0 - 1;
    结果<整64, 整32> 左静查922 = 查静态序号含类(左名ID);
    如果 (左静查922.正常) { 静序922 = 左静查922.值; } 否则 { }
    如果 (目标槽 == 0 && 左静查922.正常) { 静922 = 真; }
// 目标不可定位（方法字段形态）=交回原路径（841-a/472-a 同款守卫）
    如果 (目标槽 == 0 && !静922) { 返回 假; }
    整64 对象大小922 = 容器对象大小(字符串复制(驻留文本(左类型ID)));
    如果 (对象大小922 <= 0) { 返回 假; }
    // ① 源求值（单点：产物=被调方 sret 物化到本帧的容器壳栈槽地址）
    整64 前深度922 = 表达式栈.大小();
    整64 产物922 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽, 指令,
                             寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
    如果 (产物922 != 0) {
        // ② 堆物化（091 声明位同款：容器壳 → 新堆壳）
        整64 新壳922 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新壳922, 对象大小922,
                             左类型ID));
        IR追加(指令, 建IR指令(IR_结构体拷贝, 产物922, 新壳922, 0, 0,
                             对象大小922, 0));
        // ③ 旧值释放（先求值后释放·821 同款拥有型判定）
        发射重载产物旧值释放821(目标槽, 左名ID, 左类型ID, 静922, 指令,
                              函数信息, 寄存器计数);
        // ④ 句柄入槽（821 三分写回）
        如果 (静922) {
            IR追加(指令, 建IR指令(IR_静态存储, 新壳922, 0, 0, 0, T_整64,
                                 静序922));
        } 否则 如果 (槽是引用(目标槽)) {
            整64 写回922 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 写回922, T_整64, 0));
            IR追加(指令, 建IR指令(IR_指针存储, 写回922, 新壳922, 0, 0,
                                 T_整64, 0));
        } 否则 {
            IR追加(指令, 建IR指令(IR_存储, 新壳922, 0, 0, 0, 0, 目标槽));
        }
    }
    // 产物==0（求值失败信号）同 821/630：吞下已发射求值·弹栈返真（零双求值）
    表达式栈弹到深度(表达式栈, 前深度922);
    返回 真;
}

// 922 同批（841-a 同族·零双求值防线扩展）：类型文本尾 '&'＝引用返回特征
//   （829 起 IR签名保留后缀·IR 层唯一形态判据；长<=1=空/短文本非引用）。
函数 文本尾是引用922(字符串 文本) -> 布尔 {
    整64 长p922 = 字符串长度(文本);
    如果 (长p922 <= 1) { 返回 假; }
    返回 (整64(文本[整32(长p922 - 1)]) & 255) == 38;
}

// 922 同批（841-a 同族）：633 求值前形态预判——「非引用返回」调用=求值前
//   返假（633 把「求值」推迟给真正的消费通道：472-a/544/922 等）。
//   病根（922 矩阵 9114 实录·每轮泄漏 2）：633 的回扫判定（IR_指针加载
//   目标=产物）是**事后判定**——值返回调用（聚合返回/构造/容器元素返回）
//   被求值后弹栈丢弃：物化① 产物成孤儿（9114=「元素(0)」深拷副本数据数组
//   +字符串泄漏实录；9111/9112 同源=被调二次调用+物化① 孤儿，本轮 922
//   接管已消前两形态，9114/构造赋值等 633 残面靠本预判收口）。
//   预判语义=「可能引用返回」（保守）：
//   · 被调=标识符：决议函数符号 miss（构造/内置=非用户函数）→ 非引用返回；
//     命中 → 查函数返回类型 文本尾 &。查表 miss/异常=保守「可能」。
//   · 被调=成员标记：接收者用户类 → 查类方法返回 文本尾 &；接收者容器 →
//     查方法签名 返回文本 尾 &。miss/未解析=保守「可能」（继续原逻辑）。
//   · 其余被调形态（嵌套调用等）=保守「可能」（零行为变更）。
//   零行为变更论证：非尾 & 的返回不可能产生「IR_指针加载 目标=产物」的
//   引用返回读值指令（引用返回签名必带 &——829 口径），原逻辑对它们求值后
//   回扫亦必 miss=同落原通道；本预判仅把求值时机推迟、消灭物化①。
函数 调用可能引用返回922(向量<节点> 池, 整64 调用索引) -> 布尔 {
    // 索引无效=保守「可能」（交给原逻辑/诊断面）
    如果 (调用索引 <= 0 || 调用索引 >= 整64(池.大小())) { 返回 真; }
    节点 调用p922 = 池.元素(整32(调用索引));
    如果 (调用p922.类型 != 节点_调用 || 调用p922.子起点 <= 0 ||
         整32(调用p922.子起点) >= 整32(池.大小())) { 返回 真; }
    节点 被调p922 = 池.元素(整32(调用p922.子起点));
    如果 (被调p922.类型 == 节点_标识符) {
        整64 键基p922 = 0;
        整64 键串p922 = 0;
        整64 段数p922 = 0;
        整64 符号p922 = 决议函数符号(池, 整64(被调p922.文本), 整32(调用索引),
                                  键基p922, 键串p922, 段数p922);
        // 构造/内置调用（决议 miss=非用户函数）=非引用返回
        如果 (符号p922 == 0) { 返回 假; }
        可选<整64> 返查p922 = 查函数返回类型(符号p922);
        如果 (返查p922.有值) {
            返回 文本尾是引用922(字符串复制(驻留文本(返查p922.值)));
        }
        返回 假;
    }
    如果 (被调p922.类型 == 节点_成员 && 被调p922.附加 == 成员方法标记) {
        可选<整64> 对象类查p922 = 解析节点类型ID(池, 整32(被调p922.子起点));
        如果 (!对象类查p922.有值) { 返回 真; }
        整64 对象类p922 = 0;
        如果 (对象类查p922.有值) { 对象类p922 = 对象类查p922.值; }
        字符串 接文本p922 = 字符串复制(驻留文本(剥尾星基名(对象类p922)));
        如果 (是用户类(接文本p922) && !是容器类(接文本p922)) {
            可选<整64> 方法返查p922 = 查类方法返回(整64(驻留(接文本p922)),
                                             整64(被调p922.文本));
            如果 (!方法返查p922.有值) { 返回 真; }
            整64 方法返p922 = 0;
            如果 (方法返查p922.有值) { 方法返p922 = 方法返查p922.值; }
            如果 (方法返p922 <= 1) { 返回 真; }
            返回 文本尾是引用922(字符串复制(驻留文本(方法返p922)));
        }
        如果 (是容器类(接文本p922)) {
            方法签名 签p922;
            如果 (查方法签名(接文本p922,
                             字符串复制(驻留文本(整64(被调p922.文本))),
                             调用p922.附加, &签p922)) {
                返回 文本尾是引用922(签p922.返回文本);
            }
            返回 真;
        }
        返回 真;
    }
    返回 真;
}

// 633（632 同根·赋值位扩面·台账 #633 残面①；928 扩面：「返回引用参数」方法
//   纳入同口径）：类目标 ← 引用返回调用（甲 = 取货(源)·甲=已声明类变量）。
//   633 原修法（v2 引用返回 rax=对象指针本体的前提面）：①右值求值（默认读值
//   含 IR_指针加载）→ ②回扫丢弃「目标=产物」的 IR_指针加载 取操作数1（对象
//   指针本体）→ ③hold 槽物化（槽内=对象指针本体·拷贝构造 T& 约定「装着壳
//   地址的槽」）→ ④NewObject 新壳 + 拷贝构造深拷（无拷贝构造=位拷回退）→
//   ⑤旧值释放（472 同款拥有型判定）→ ⑥直存（静态/引用参数经指针/普通槽）。
//   928（#928·宿主 ABI 完全对齐→消除分流）：v2 生产端对齐后（顺序链标识符
//   地址 单段引用参数只 Load·函数/方法同口径），**引用返回调用 rax=被引用
//   左值地址**（宿主 genIdentifierLvalue 同款）：
//     · 普通函数读值=发射引用返回加载（IR_指针加载）→ ②回扫取 rax；
//     · 方法调用读值=rax 直传（T_对象 装载·不发 IR_指针加载）→ ②回扫 miss 面
//       按 是方法引用返回928 识别（成员方法+返回文本尾&+剥尾&严格==左类型）。
//     ③改 源地址=源指针直用（「方法直用/普通函数 hold」分档随前提消失撤销）；
//     ④位拷回退解一层得对象本体。判定 miss（值返回调用=聚合物化槽地址）→
//     清栈返假落原路径（472/544/630 既有通道），零行为变更。目标不可定位
//     （目标槽 0 且非静态）=返假交回。
不安全 函数 赋值接管引用返回类调用633(向量<节点> 池, 节点 n, 整64 目标槽,
                     整64 左名ID, 整64 左类型ID, 向量<IR指令>& 指令,
                     映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                     函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                     向量<整64>& 表达式栈) -> 布尔 {
    如果 (n.子终点 <= n.子起点) { 返回 假; }
    如果 (池.元素(整32(n.子终点 - 1)).类型 != 节点_调用) { 返回 假; }
    布尔 静633 = 假;
    整64 静序633 = 0 - 1;
    结果<整64, 整32> 左静查633 = 查静态序号含类(左名ID);
    如果 (左静查633.正常) { 静序633 = 左静查633.值; } 否则 { }
    如果 (目标槽 == 0 && 左静查633.正常) { 静633 = 真; }
    如果 (目标槽 == 0 && !静633) { 返回 假; }
    // 922（#922/#925）：容器目标 ←「返回容器的调用」（值返回=用户类方法/
    //   自由函数）——sret 壳栈物化升堆物化接管（判定/实现见 赋值接管返回
    //   容器调用922）。**须先于 633 求值**：633 对值返回调用求值后回扫
    //   miss 弹栈返假，若留 472-a 再求值=被调二次调用+物化① 孤儿（841-a
    //   同族·零双求值纪律）。命中即终结；非该形态（引用返回/容器元素/
    //   构造等）零行为变更落 633 原逻辑。
    如果 (赋值接管返回容器调用922(池, n, 目标槽, 左名ID, 左类型ID, 指令,
                局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈)) {
        返回 真;
    }
    // 922 同批（841-a 同族）：非引用返回调用=**求值前**返假（消 9114 物化①
    //   孤儿泄漏/构造赋值双重构造·详见 调用可能引用返回922）——633 的求值+
    //   回扫仅对尾 & 引用返回形态保留（唯一需要事后回扫取 rax 的形态）。
// 非引用返回形态=求值前返假（求值时机移交 472-a 消费通道）
    如果 (!调用可能引用返回922(池, 整64(n.子终点 - 1))) { 返回 假; }
    // 633（#633 残面④b·容器面）：目标=容器族（向量/栈/链表/队列/集合/映射）
    //   ——对象大小取容器对象大小（查结构体大小对容器=0 会误挡）；深拷走容器
    //   拷贝构造公式（生成容器拷贝构造 同源符号）。
    字符串 类文本633 = 字符串复制(驻留文本(左类型ID));
    布尔 左是容器633 = 是容器类(类文本633);
    整64 字节633 = 0;
    可选<整64> 字节633查 = 查结构体大小(左类型ID);
    如果 (字节633查.有值) { 字节633 = 字节633查.值; }
    如果 (左是容器633) { 字节633 = 容器对象大小(类文本633); }
    如果 (字节633 <= 0) { 返回 假; }
    // ① 右值求值（引用返回调用默认读值=IR_指针加载 多解一层）
    整64 前深度633 = 表达式栈.大小();
    整64 产物633 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽, 指令,
                             寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
    // ② 回扫取对象指针本体（632 同款：目标=产物 的 IR_指针加载 取操作数1）
    整64 源指针633 = 0;
    如果 (产物633 != 0) {
        整64 回633 = 指令.大小();
        当 (回633 > 0) {
            IR指令 回扫633 = 指令.元素(回633 - 1);
            如果 (回扫633.操作码 == IR_指针加载 && 回扫633.目标 == 产物633) {
                源指针633 = 回扫633.操作数1;
                中断;
            }
            回633--;
        }
    }
    // 928（#928·「返回引用参数」方法作右值·源识别补位）：方法调用读值=rax
    //   直传（发射用户类方法调用 引用返回按 T_对象 装载·不发 IR_指针加载）
    //   → 上方回扫天然 miss——miss 面按 是方法引用返回928（成员方法+返回文本
    //   尾&+剥尾&严格==左类型）识别：源指针=读值寄存器（=rax=被引用左值地址·
    //   与普通函数回扫结果同层·928 生产端对齐）。非本形态 miss（值返回调用=
    //   聚合物化槽地址）→ 原路径接管，零行为变更。
    如果 (源指针633 == 0 && 产物633 != 0 &&
        是方法引用返回928(池, 整64(n.子终点 - 1), 左类型ID)) {
        源指针633 = 产物633;
    }
    如果 (源指针633 == 0) {
        // 非引用返回形态（值返回调用等）——原路径接管，零行为变更
        表达式栈弹到深度(表达式栈, 前深度633);
        返回 假;
    }
    // 928：源地址=源指针（被引用左值地址）——拷贝构造 T& 源约定「装着壳地址
    //   的槽地址」直用（函数/方法统一口径）；633 原「方法直用/普通函数 hold
    //   槽物化」分档以「普通函数 rax=对象指针本体」为前提，928 生产端对齐
    //   后前提消失（hold=多包一层→拷贝构造读 [hold]=槽地址当对象指针）——
    //   撤销该分流（宿主 ABI 完全对齐·台账 #928 修向）。
    整64 源地址reg633 = 源指针633;
    // ④ NewObject + 拷贝构造（深拷）/ 无拷贝构造位拷回退
    整64 新obj633 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 新obj633, 字节633, 左类型ID));
    如果 (左是容器633) {
        // 容器深拷：符号=容器拷贝构造公式（生成容器拷贝构造 尾段同源单点）
        IR追加(指令, 建IR指令(IR_调用实参, 新obj633, 0, 0, 0, 0, 0));
        IR追加(指令, 建IR指令(IR_调用实参, 源地址reg633, 0, 0, 0, 1, 0));
        IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
             驻留(方法符号(类文本633, 合成名基名(类文本633),
                           类文本633 + "&"))));
        // 静默豁免业务值: 拷贝构造/位拷贝双分回退（768 既有语义·1541 B2 类型化后锚移位登记）
    } 否则 {
    可选<整64> 拷贝串查633 = 查类拷贝构造串(左类型ID);
    如果 (拷贝串查633.有值) {
        IR追加(指令, 建IR指令(IR_调用实参, 新obj633, 0, 0, 0, 0, 0));
        IR追加(指令, 建IR指令(IR_调用实参, 源地址reg633, 0, 0, 0, 1, 0));
        IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
             驻留(方法符号(类文本633, 剥实例基名(类文本633),
                   字符串复制(驻留文本(拷贝串查633.值))))));
    } 否则 {
        // 位拷回退（源=被引用左值地址·装着壳地址的槽——928 生产端对齐后
        //   函数/方法同口径）：解一层得对象本体 → 整块位拷（632 声明位 768
        //   同族保守面）
        整64 源本体933 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_指针加载, 源指针633, 0, 0, 源本体933,
                             T_对象, 0));
        IR追加(指令, 建IR指令(IR_结构体拷贝, 源本体933, 新obj633, 0, 0,
                             字节633, 0));
    }
    }
    // ⑤ 旧值释放（472 同款拥有型判定：静态恒拥有/RAII 名单；空句柄安全）
    布尔 拥有633 = 静633;
    // 922（#925 并入·引用参数面）：引用参数槽=调用方对象别名——「甲 = 新值」
    //   即 drop 旧值（宿主 isByRefCapture 同款·原判定漏·与 821 同点扩展）。
    如果 (!拥有633 && 槽是引用(目标槽)) { 拥有633 = 真; }
    如果 (!拥有633) {
        整64 名j633 = 0;
        当 (名j633 < 函数信息.容器变量们.大小()) {
            如果 (函数信息.容器变量们.元素(名j633) == 左名ID) {
                拥有633 = 真;
                中断;
            }
            名j633++;
        }
    }
    如果 (拥有633) {
        整64 旧obj633 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        如果 (静633) {
            IR追加(指令, 建IR指令(IR_静态加载, 0, 0, 0, 旧obj633, T_对象,
                                 静序633));
        } 否则 如果 (槽是引用(目标槽)) {
            整64 目标地633 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 目标地633, T_整64, 0));
            IR追加(指令, 建IR指令(IR_指针加载, 目标地633, 0, 0, 旧obj633,
                                 T_对象, 0));
        } 否则 {
            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 旧obj633, T_对象, 0));
        }
        IR追加(指令, 建IR指令(IR_删除对象, 旧obj633, 0, 0, 寄存器计数[0], 0,
                             左类型ID));
        寄存器计数[0] = 寄存器计数[0] + 1;
    }
    // ⑥ 直存（静态/引用参数经指针/普通槽）
    如果 (静633) {
        IR追加(指令, 建IR指令(IR_静态存储, 新obj633, 0, 0, 0, T_整64,
                             静序633));
    } 否则 如果 (槽是引用(目标槽)) {
        整64 写回633 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 写回633, T_整64, 0));
        IR追加(指令, 建IR指令(IR_指针存储, 写回633, 新obj633, 0, 0, T_整64, 0));
    } 否则 {
        IR追加(指令, 建IR指令(IR_存储, 新obj633, 0, 0, 0, 0, 目标槽));
    }
    表达式栈弹到深度(表达式栈, 前深度633);
    返回 真;
}

// 928（#928·633 分流消除·替换 是被调成员方法标记633+是类对象引用返回633）：
//   被调=用户类成员方法（成员方法标记）且**方法返回文本尾 &**（引用返回）且
//   剥尾& 后严格 == 目标类（类名ID）——方法调用读值=rax 直传（发射用户类
//   方法调用 引用返回按 T_对象 装载·不发 IR_指针加载）→ 调用侧「回扫
//   IR_指针加载 取操作数1」天然 miss；miss 面（633 赋值位/生成容器局部
//   返回接收）按本谓词识别补位：源=读值寄存器=rax=**被引用左值地址**（928
//   生产端对齐后与普通函数回扫结果、字段/引用参数形态同层）。尾 & 判定=
//   引用返回显式识别（值返回方法读值=sret 物化槽地址自然排除）；继承/
//   限定名/泛型返回文本不等=保守面（维持原路径）。接收者=容器类/非用户类
//   （容器方法返回值语义另路）自然排除。
函数 是方法引用返回928(向量<节点> 池, 整64 调用索引, 整64 类名ID) -> 布尔 {
    如果 (调用索引 <= 0 || 调用索引 >= 整64(池.大小())) { 返回 假; }
    如果 (类名ID == 0) { 返回 假; }
    节点 调用m9 = 池.元素(整32(调用索引));
    如果 (调用m9.类型 != 节点_调用 || 调用m9.子起点 <= 0 ||
         整32(调用m9.子起点) >= 整32(池.大小())) { 返回 假; }
    节点 被调m9 = 池.元素(整32(调用m9.子起点));
    如果 (被调m9.类型 != 节点_成员 || 被调m9.附加 != 成员方法标记) { 返回 假; }
    可选<整64> 对象类查9 = 解析节点类型ID(池, 整32(被调m9.子起点));
    如果 (!对象类查9.有值) { 返回 假; }
    整64 对象类9 = 0;
    如果 (对象类查9.有值) { 对象类9 = 对象类查9.值; }
    字符串 接文本9 = 字符串复制(驻留文本(剥尾星基名(对象类9)));
    如果 (!是用户类(接文本9) || 是容器类(接文本9)) { 返回 假; }
    可选<整64> 方法返查9 = 查类方法返回(整64(驻留(接文本9)), 整64(被调m9.文本));
    如果 (!方法返查9.有值) { 返回 假; }
    整64 方法返9 = 0;
    如果 (方法返查9.有值) { 方法返9 = 方法返查9.值; }
    如果 (方法返9 <= 1) { 返回 假; }
    字符串 返文本9 = 字符串复制(驻留文本(方法返9));
    整64 长9 = 字符串长度(返文本9);
    如果 (长9 <= 1 || (整64(返文本9[整32(长9 - 1)]) & 255) != 38) { 返回 假; }
    整64 基ID9 = 驻留(字符串子串(返文本9, 0, 整32(长9 - 1)));
    返回 剥尾星基名(基ID9) == 类名ID;
}
// 631（544 呈报·声明位形态）：转移接收——右值=转移(标识符)（拥有交接·
//   459-a/096/977 真 move 语义：源句柄加载 + 源槽清零）。
//   缺陷链（631 探针·双侧对照实证）：右值经「发射类拷贝构造初始化」深拷
//   通道——转移展开后句柄（源壳）+ NewObject 新壳 + 拷贝构造从源壳深拷；
//   接收方持有新壳（出口回收新壳一方），**源壳**（连同其字段容器数据数组
//   +字符串）失去唯一持有者成孤儿 → 泄漏（活动分配数残留 +2；源壳/字段
//   壳 __cn_object_new=calloc 不计数同泄漏不显）。宿主=全清零+句柄直存
//   （ir_stmt_decl_init tryGenTransferInit）残留 0=正确侧。
//   修法（与容器面 生成容器局部 是转移接收 分支同模型）：生成表达式求值
//   （生成转移展开=弹2压1+源槽清零）→ 句柄直存声明槽（零深拷零物化）；
//   接收方已在册（生成类对象局部 658② 无条件名单追加）=块出口释放唯一
//   持有者；源侧不必除名——源槽已清零，出口 DeleteObject 空句柄空安全跳过。
//   判定从严（保守面）：末=调用 ∧ 被调=标识符「转移」∧ 实参=标识符（转移
//   成员链 1011 形态/非标识符实参落原路径）。返回 真=已直存终结。
不安全 函数 转移接收类对象631(向量<节点> 池, 节点 n, 整64 类名ID, 整64 槽c,
                   映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                   函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                   向量<整64>& 表达式栈) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    如果 (n.子终点 <= n.子起点) { 返回 假; }
    节点 末631 = 池.元素(整32(n.子终点 - 1));
    如果 (末631.类型 != 节点_调用 || 末631.子起点 <= 0 ||
         整32(末631.子起点) >= 整32(池.大小())) { 返回 假; }
    节点 被调631 = 池.元素(整32(末631.子起点));
    如果 (被调631.类型 != 节点_标识符 ||
         !字符串比较(驻留文本(整64(被调631.文本)), "转移")) { 返回 假; }
    如果 (整32(末631.子起点) + 1 >= 整32(池.大小())) { 返回 假; }
    节点 实参631 = 池.元素(整32(末631.子起点) + 1);
    如果 (实参631.类型 != 节点_标识符) { 返回 假; }
    // 右值求值（转移展开：源句柄加载 + 源槽清零·纯编译期零额外指令）
    整64 句柄631 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                              指令, 寄存器计数, &函数信息.块计数, 槽计数,
                              表达式栈);
    如果 (句柄631 != 0 && 槽c != 0) {
        IR追加(指令, 建IR指令(IR_存储, 句柄631, 0, 0, 0, 0, 槽c));
    }
    当 (表达式栈.大小() > 0) {
        结果<空类型, 整32> 删631 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删631.正常) { 运行时错误(4); }
    }
    返回 真;
}

