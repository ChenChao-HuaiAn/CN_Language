// 族①：对象形态分桶三元组推导（原 100~145 段）——标识符/调用/成员链/下标
//   四形态分桶查 偏移/宽度/类型码 三元组（读写同源根治）。
//   ②b B5：调用对象（池.元素(i).字段）——方法返回结构体：分桶收口
//   偏移+宽度（语法层只能扁平回退查偏移——同名字段跨结构体必错）。
//   46-b 根治（2026-09-09 第四十八轮）：成员链中间跳（r.左上.x 的
//   .x——对象=成员节点）——语法层附加为扁平回退（按首对象 r 的
//   矩形查 .x 必 miss=-1），旧兜底 解析对象结构体ID 只认标识符。
//   经 解析成员链结构体ID 递归（矩形→左上→点）分桶查三元组。
//   94-a（2026-09-13 第九十四轮）：对象=下标表达式（结构体数组元素
//   `表[0].x` 右值）——元素结构体键经 解析成员链结构体ID（下标分支，
//   数组元素结构体表）分桶查三元组。
函数 解析字段三元组(向量<节点> 池, 节点 n, 节点 对象节点,
                  整64& 字段偏移量, 整64& 加载类型, 整64& 成员对象类型ID, 整64& 成员值码) -> 空类型 {
    如果 (对象节点.类型 == 节点_标识符) {
        // 658 伞批（2026-10-14·108 既有红根治·648-b 显形误伤面同 774 族）：
        //   **类名.静态字段**——对象=用户类名（非变量·93-a 判据）且静态字段表
        //   命中 → 本三元组查表无意义（静态不入实例布局=类布局字段类型表恒
        //   miss）→ 直接返回（下方 070 波G 静态槽读分支接管）。原顺序（先查表
        //   后静态判定）在 查字段宽度码 显形化（#648）后把存量静默面变硬错误
        //   （7b8c6132 二分实锤·v2p 编译 108 H7 rc=1）。
        整64 类名静读ID658 = 整64(对象节点.文本);
        结果<整64, 整32> 合成查658 = 查类静态字段合成名(类名静读ID658, 整64(n.文本));
        如果 (是用户类_ID(类名静读ID658) && 合成查658.正常) {
            返回;
        }
        成员对象类型ID = 解析标识符类型ID(整64(对象节点.文本));
        // 108（648 显形化收尾·108_H7 既有红）：对象=用户类名且字段为类静态字段
        //   （类名.静态字段 读）→ 实例字段三元组整段跳过——静态字段不入实例
        //   字段/宽度表，查宽度码=648 miss 实录（原静默 8 兜底恰为静态槽读的
        //   无用中间值·真值由下方 070 波G 静态读分支覆盖）。判据与 070 波G
        //   静态读分支同源（是用户类_ID + 静态字段合成名命中）——变量遮蔽类名
        //   的实例字段读不受影响（合成名 miss 即不跳过）。
        结果<整64, 整32> 合成查q = 查类静态字段合成名(整64(对象节点.文本), 整64(n.文本));
        布尔 是类名静态读q = 是用户类_ID(整64(对象节点.文本)) && 合成查q.正常;
        // 728r（648 显形化第二波·826 既有红）：对象=类实例且成员=类方法
        //   （对象.方法 作值=实例方法引用）→ 实例字段三元组整段跳过——方法
        //   非字段，查宽度码=648 miss（原静默 8 恰为无用中间值·真值由下方
        //   104/440 方法引用分支处理）。有类方法 命中即跳过。
        布尔 是方法引用q = 假;
        如果 (成员对象类型ID > 0 && 有类方法(成员对象类型ID, 整64(n.文本))) {
            是方法引用q = 真;
        }
        如果 (!是类名静态读q && !是方法引用q) {
            // ②b B5：标识符对象为结构体局部/参数 -> 分桶查字段宽度（读写同源根治）
            整64 结构体ID = 0;
            // 1541 B2：有值=对象结构体键基（原 !=0 判据等价）
            可选<整64> 结构体ID查 = 解析对象结构体ID(对象节点);
            如果 (结构体ID查.有值) { 结构体ID = 结构体ID查.值; }
            如果 (结构体ID != 0) {
                // 728h（594-b 读路径对称·2026-10-14）：权威偏移覆盖——语法层成员
                //   偏移标注 n.附加 会被「变量结构体表」跨函数同名局部变量残留
                //   串桶（对象推导命中残留类→附加=非负错值），IR 读路径原「偏移
                //   兜底仅 附加<0 时触发」被短路 → 静默读错偏移（728h p14b/p14f/
                //   p14g 实测：v2 读 [对象+0] 得 7·宿主正确 42·rc=0 零诊断）。
                //   权威推导（解析对象结构体ID=函数级变量类型遮蔽感知〔局部/参数
                //   ＞类字段登记〕+解析类字段类型）命中即覆盖（类型化>猜值·
                //   594-b 写路径同口径）；miss 保持语法层值（错名面由下方
                //   加载类型 宽度码 648 显形中止兜底·p18/p19 实证不静默）。
                //   类名对象守卫：类名.实例字段（用户错误·p5）不覆盖——保持落
                //   静态读判定/IR 诊断拒绝（宿主同判）。
                如果 (!是用户类_ID(整64(对象节点.文本))) {
                    可选<整64> 桶偏权威r查 = 查字段偏移(结构体ID, 整64(n.文本));
                    如果 (桶偏权威r查.有值) { 字段偏移量 = 桶偏权威r查.值; }
                }
                加载类型 = 查字段宽度码(结构体ID, 整64(n.文本));
                // ③ 第二波（方案A）：字段声明类型码（成员加载值登记用）
                可选<整64> 字段值查83 = 查字段类型ID(结构体ID, 整64(n.文本));
                如果 (字段值查83.有值) {
                    整64 字段值83 = 字段值查83.值;
                    成员值码 = 类型码(字段值83);
                }
            }
        }
    } 否则 如果 (对象节点.类型 == 节点_调用) {
        // 1014（链式访问根治）：回填对象类型 ID——结果/可选 合成体被下方
        //   查结构体大小 守卫挡回（合成体不走结构体布局桶），族② 合成布局
        //   兜底因 成员对象类型ID==0 前提不成立而跳过 → [ir2] 成员字段偏移
        //   未知（映射.获取(k).normal / 取结果(x).normal 实证）。回填后族②按
        //   结果$T$E 文本推导 .normal@0/.值/.错误 载荷（与标识符对象同款路径）；
        //   普通结构体族①桶查已命中时族②不进（字段偏移量>=0）——零行为面变化。
        整64 返回类型ID90 = 0;
        可选<整64> 返回类型查90 = 解析调用返回类型ID(池, 整32(n.子起点));
        如果 (返回类型查90.有值) { 返回类型ID90 = 返回类型查90.值; }
        成员对象类型ID = 返回类型ID90;
        整64 返回结构体ID = 0;
        可选<整64> 返回结构查90 = 解析调用返回结构体(池, 整32(n.子起点));
        如果 (返回结构查90.有值) { 返回结构体ID = 返回结构查90.值; }
        // 928 侦查注记（不修·呈报立项）：用户类/自由函数「引用返回调用」作
        //   成员链基座——解析调用返回结构体 对「货架&」形态恒 0（带 & 查
        //   布局恒 miss）→ 普通类字段链基座「成员字段偏移未知」IR 拒绝。
        //   对照：宿主编译放行但运行时同为缺陷面（refReturnAggInline 对类
        //   直传少一层：读方法=垃圾值 -9223…/写链=错误码3 崩·928probe6a/b/c
        //   双侧实录）——两侧根治（v2 基座补偿 + 宿主 refReturnAggInline 类
        //   分支剥离壳模型）随宿主同轮立项（台账 928 呈报），本任务面=四消费点
        //   （声明/赋值/绑定/容器接收）不扩链基座面。
        如果 (返回结构体ID != 0 && 查结构体大小(返回结构体ID) != 0) {
            可选<整64> 桶偏移查 = 查字段偏移(返回结构体ID, 整64(n.文本));
            如果 (桶偏移查.有值) { 字段偏移量 = 桶偏移查.值; }
            加载类型 = 查字段宽度码(返回结构体ID, 整64(n.文本));
            可选<整64> 字段值查112 = 查字段类型ID(返回结构体ID, 整64(n.文本));
            如果 (字段值查112.有值) {
                整64 字段值112 = 字段值查112.值;
                成员值码 = 类型码(字段值112);
            }
        }
    } 否则 如果 (对象节点.类型 == 节点_成员) {
        整64 链结构体ID48 = 0;
        可选<整64> 链结构查48 = 解析成员链结构体ID(池, 整32(n.子起点));
        如果 (链结构查48.有值) { 链结构体ID48 = 链结构查48.值; }
        如果 (链结构体ID48 != 0) {
            可选<整64> 桶偏移c查 = 查字段偏移(链结构体ID48, 整64(n.文本));
            如果 (桶偏移c查.有值) { 字段偏移量 = 桶偏移c查.值; }
            加载类型 = 查字段宽度码(链结构体ID48, 整64(n.文本));
            可选<整64> 字段值查122 = 查字段类型ID(链结构体ID48, 整64(n.文本));
            如果 (字段值查122.有值) {
                整64 字段值122 = 字段值查122.值;
                成员值码 = 类型码(字段值122);
            }
        }
        // 200：合成体成员对象回填——链末对象(b.内)的类型=合成体(结果$T$E)时
        //   填 成员对象类型ID(结果可选兜底前提·同下标分支)
        如果 (成员对象类型ID == 0) {
            可选<整64> 链类型查117 = 推导成员链类型ID(池, 整32(n.子起点));
            如果 (链类型查117.有值) { 成员对象类型ID = 链类型查117.值; }
        }
    } 否则 如果 (对象节点.类型 == 节点_下标) {
        整64 元素结构体ID94 = 0;
        可选<整64> 元素结构查94 = 解析成员链结构体ID(池, 整32(n.子起点));
        如果 (元素结构查94.有值) { 元素结构体ID94 = 元素结构查94.值; }
        如果 (元素结构体ID94 != 0) {
            可选<整64> 桶偏94查 = 查字段偏移(元素结构体ID94, 整64(n.文本));
            如果 (桶偏94查.有值) { 字段偏移量 = 桶偏94查.值; }
            加载类型 = 查字段宽度码(元素结构体ID94, 整64(n.文本));
            可选<整64> 字段值查138 = 查字段类型ID(元素结构体ID94, 整64(n.文本));
            如果 (字段值查138.有值) {
                整64 字段值138 = 字段值查138.值;
                成员值码 = 类型码(字段值138);
            }
        }
    } 否则 如果 (对象节点.类型 == 节点_二元运算 && 对象节点.子起点 > 1) {
        // 281（021 任务 281·#263 遗留缺口·09 实测 (名单+(n-1)).分数）：**指针
        //   算术成员访问**——对象=二元运算（指针+整数·266-a 步进糖）。203 教训：
        //   二元节点.子起点=**右操作数起点**（dbg 铁证 池.元素(子起点)=右操作数
        //   首节点 n）——左操作数标识符**紧邻其前**（子起点-1·单标识符左面；
        //   多级算术左面=面外登记观察）→指针变量表→所指结构体分桶查三元组
        //   （宿主 (p+(n-1)).分数 放行同款）。
        节点 左算281 = 池.元素(整32(对象节点.子起点 - 1));
        如果 (左算281.类型 == 节点_标识符) {
            可选<整64> 所指查281 = 查指针变量类型(整64(左算281.文本));
            如果 (所指查281.有值) {
                // 所指=结构体（查表）或**用户类**（类字段偏移同键同表〔234〕·
                //   类不在结构体名表→键=类名ID 直用·278 继承布局同款）
                整64 键281 = 查结构体类型(所指查281.值);
                如果 (键281 == 0 && 是用户类(字符串复制(驻留文本(所指查281.值)))) {
                    键281 = 所指查281.值;
                }
                如果 (键281 != 0 && (查结构体大小(键281) != 0 ||
                     是用户类(字符串复制(驻留文本(键281))))) {
                    可选<整64> 桶偏281查 = 查字段偏移(键281, 整64(n.文本));
                    如果 (桶偏281查.有值) { 字段偏移量 = 桶偏281查.值; }
                    加载类型 = 查字段宽度码(键281, 整64(n.文本));
                    可选<整64> 字段值查162 = 查字段类型ID(键281, 整64(n.文本));
                    如果 (字段值查162.有值) {
                        整64 字段值162 = 字段值查162.值;
                        成员值码 = 类型码(字段值162);
                    }
                    成员对象类型ID = 键281;
                }
            }
        }
    } 否则 如果 (对象节点.类型 == 节点_取地址 && 对象节点.子终点 > 对象节点.子起点) {
        // 448（2026-10-11·425 遗留①v2 同构·宿主 解析字段三元组 UnaryExpr
        //   取址分支对齐）：取址表达式成员（(&表[i]).x）——&表[i] 类型=下标
        //   元素类型，经 解析成员链结构体ID（448 取址分支：操作数区间末端
        //   下标节点→元素结构体键94/279/97f 三形态同盖）分桶查三元组。
        //   基址=取地址求值元素地址（生成一元运算→生成左值地址·栈顶复用，
        //   已正确）。原 miss → 字段偏移量 -1 →「成员字段偏移未知」IR 层
        //   拒绝（723 探针直读 3 处实录）。注：n.子起点=取址节点索引（P6c）；
        //   取址节点.子终点-1=操作数区间末端（下标节点）；n.子终点=对象
        //   类型ID 预标注（非索引，勿混）。
        整64 元素结构体ID448 = 0;
        可选<整64> 元素结构查448 = 解析成员链结构体ID(池, 整32(对象节点.子终点 - 1));
        如果 (元素结构查448.有值) { 元素结构体ID448 = 元素结构查448.值; }
        如果 (元素结构体ID448 != 0) {
            可选<整64> 桶偏448查 = 查字段偏移(元素结构体ID448, 整64(n.文本));
            如果 (桶偏448查.有值) { 字段偏移量 = 桶偏448查.值; }
            加载类型 = 查字段宽度码(元素结构体ID448, 整64(n.文本));
            可选<整64> 字段值查184 = 查字段类型ID(元素结构体ID448, 整64(n.文本));
            如果 (字段值查184.有值) {
                整64 字段值184 = 字段值查184.值;
                成员值码 = 类型码(字段值184);
            }
        }
    }
    // 233/200（z1 探针）：下标对象 合成体元素类型回填（分支外·三元组尾通用——
    //   结构体桶 miss 时 成员对象类型ID=下标元素类型 结果$T$E/可选$T·
    //   兜底按合成布局推导）
    // 964（920 呈报形态③根治·双消费点漏一）：入参=n.子起点=**下标节点自身**
    //   ——表达式类型推导须用 推导成员链类型ID（对下标节点=「数组→元素」语义：
    //   下标表达式本身的类型=元素）；原误用 推导下标元素类型ID（该函数语义=
    //   「入参是**数组对象**，剥一层取元素」→ 对下标表达式恒返 0）→ 下标对象
    //   的合成体链（直元[0].值 / 直元[0].正常）成员对象类型ID 恒 0 → 结果
    //   兜底/载荷结构体判定全 miss → 读链多一级解引用崩溃（rc139 实录）。
    //   同款修正先落族②函数头（200 实证），本条=同模式第二消费点（973 判例：
    //   统一查询双消费点须同轮对齐，防漂移复发）。
    如果 (成员对象类型ID == 0 && 对象节点.类型 == 节点_下标) {
        可选<整64> 下标链类型查184 = 推导成员链类型ID(池, 整32(n.子起点));
        如果 (下标链类型查184.有值) { 成员对象类型ID = 下标链类型查184.值; }
    }
}

// 族②：结果/可选 兜底（原 146~180 段）——字段偏移 <0 且有成员对象类型ID 时，
//   按结果/可选 合成布局推导（正常@0/.值/.错误 载荷分派/联合偏移取较宽）。
函数 解析结果可选兜底(向量<节点> 池, 节点 n, 节点 对象节点, 整64& 成员对象类型ID,
                  整64& 字段偏移量, 整64& 加载类型, 整64& 成员值码) -> 空类型 {
    // 200（z1 实证）：下标对象合成体元素类型自 deriv——推导成员链类型ID 对
    //   下标节点=「数组→元素」语义（下标表达式本身的类型=元素·正解）；
    //   原误用 推导下标元素类型ID（语义=X 是数组再剥一层→对下标表达式返 0）
    // 964（920 呈报形态③根治·参数契约）：成员对象类型ID 原为**值参数**——本段
    //   回填（对下标对象）传不回调用方（生成字段访问 的局部恒 0）→ 兜底体入口
    //   条件 成员对象类型ID!=0 恒假 → .值/.正常 全落标量取值路径。改 & 引用
    //   参数（与其余三输出参数同契约），回填对调用方可见。消费点唯一=生成
    //   表达式字段.cn 生成字段访问（零分叉面唯一调用方）。
    如果 (成员对象类型ID == 0 && 对象节点.类型 == 节点_下标) {
        可选<整64> 下标链类型查201 = 推导成员链类型ID(池, 整32(n.子起点));
        如果 (下标链类型查201.有值) { 成员对象类型ID = 下标链类型查201.值; }
    }
    如果 (字段偏移量 < 0 && 成员对象类型ID != 0) {
        字符串 对象类型文本 = 字符串复制(驻留文本(成员对象类型ID));
        如果 (是结果类型(对象类型文本)) {
            字符串 成员名文本 = 字符串复制(驻留文本(整64(n.文本)));
            如果 (字符串比较(成员名文本, "正常") || 字符串比较(成员名文本, "有值") ||
                 字符串比较(成员名文本, "是否某些")) {
                字段偏移量 = 0;
                加载类型 = T_布尔;
                成员值码 = T_布尔;
            } 否则 {
                // 79-a 缺陷根治（既有，基线复现）：.值/.错误 载荷类型须按成员名
                //   分派——.值 = 结果首实参（T）、.错误 = 次实参（E）。原实现
                //   一律取首实参：结果<字符串,整32>.错误 的类型码=T_字符串 ->
                //   打印/比较按字符串分派（错误码判别静默失效，探针 P10/P11
                //   两侧对照实证：宿主 5 / v2 空或垃圾）。
                // 067-003 补遗三（$ 形态双层砍·与 结果大小 同款）：可选 单参——
                //   载荷=首实参全串，原 段首 再砍一刀（「可选$盒子」→「可选」
                //   →类型码 T_未知→加载形态/偏移全坏·543 t1 实证）。结果 的
                //   二参切分歧义（T 含 $）另案；可选 恒单参去段首即正确。
                字符串 载荷类型 = 合成名首实参(对象类型文本);
                // 067-003 修复（68_generic_return 回归·结果二参切分）：结果 的
                //   首实参含 T+E 两段（「结果$字符串$整32」→首实参「字符串$整32」），
                //   .值 须再 段首 切 T、.错误 须 段余 切 E——原 067-003「去段首」
                //   对可选（单参）正确、对结果破坏类型码（T_未知→加载形态坏→
                //   读垃圾：词0=875391321984）。分流：结果 保段首/段余，可选 全串
                //   （嵌套可选「可选$可选$盒子」须保「可选$盒子」不被砍）。
                布尔 是结果形态r = 假;
                如果 (字符串长度(对象类型文本) >= 7) {
                    如果 (字符串比较(字符串子串(对象类型文本, 0, 7), "结果$") ||
                         字符串比较(字符串子串(对象类型文本, 0, 7), "结果<")) {
                        是结果形态r = 真;
                    }
                }
                如果 (是结果形态r) {
                    // 374（v17 六族对齐批）：段首/段余 $ 盲切对 T 含 $（嵌套合成体
                    //   可选$整32）必错——换 结果可选载荷374 最左合法边界深度切分
                    //   （IR容器判定 同名辅助·c359 嵌套探针「成员字段偏移未知」根治）
                    载荷类型 = 结果可选载荷374(对象类型文本, 成员名文本);
                }
                // 联合体偏移 = 较宽成员（T 或 E 为 整64/字符串/指针 -> 8）——
                //   原按 T 单侧定偏移，E 更宽时错位（登记边界，本轮取两者较宽）
                // 374：T/E 取值同换深度切分（嵌套 T 含 $ 时 段首 砍错偏移同步根治）
                整64 值偏移 = 结果值偏移(结果可选载荷374(对象类型文本, "值"));
                如果 (字符串比较(合成名基名(对象类型文本), "结果")) {
                    整64 错偏移 = 结果值偏移(结果可选载荷374(对象类型文本, "错误"));
                    如果 (错偏移 > 值偏移) { 值偏移 = 错偏移; }
                }
                字段偏移量 = 值偏移;
                // 71-a：加载宽度按载荷类型（整32/正32 载荷值四字节读——
                //   原 T_整64 八字节读拼垃圾高位，首个整32 载荷用例暴露）
                成员值码 = 类型码(驻留(载荷类型));
                如果 (成员值码 != T_未知) { 加载类型 = 成员值码; }
            }
        }
    }
}

// 族③：右值偏移兜底（原 181~213 段）——结果类型兜底后仍 -1 -> 三元对象/
//   解析对象结构体ID 分桶查；仍未知即 IR 层诊断拒绝发射（附加=-1 = 基址-1
//   毒地址，写穿相邻槽，[ir2] 产物不可信纪律）。
函数 解析右值偏移兜底(向量<节点> 池, 节点 n, 节点 对象节点,
                  整64& 字段偏移量, 整64& 加载类型, 整64& 成员值码) -> 空类型 {
    如果 (字段偏移量 < 0) {
        // 86-a（2026-09-12 复审缺陷①）：三元对象成员基（(条 ? 甲 : 乙).字段）
        //   ——对象类型经 解析节点类型ID（86-a 三元分支递归两分支）推导后
        //   查字段偏移/宽度（P47-v2 形八「成员字段偏移未知: .号」实证）。
        //   基址侧无需改动：三元聚合分支地址化后栈顶即选中 place 地址
        //   （与成员/解引用对象同款「非标识符即复用栈顶」分流）。
        如果 (对象节点.类型 == 节点_三元运算) {
            整64 三元对象ID = 0;
            可选<整64> 三元对象查272 = 解析节点类型ID(池, 整32(n.子起点));
            如果 (三元对象查272.有值) { 三元对象ID = 三元对象查272.值; }
            如果 (三元对象ID != 0) {
                可选<整64> 桶偏三查 = 查字段偏移(三元对象ID, 整64(n.文本));
                如果 (桶偏三查.有值) {
                    字段偏移量 = 桶偏三查.值;
                    加载类型 = 查字段宽度码(三元对象ID, 整64(n.文本));
                    可选<整64> 字段值查297 = 查字段类型ID(三元对象ID, 整64(n.文本));
                    如果 (字段值查297.有值) {
                        整64 字段值297 = 字段值查297.值;
                        成员值码 = 类型码(字段值297);
                    }
                }
            }
        }
        // 107（945·收窄）：链式中段成员（r.值.x 的 .值 对象——成员名 ∈ 值/错误
        //   且解析得合成体）——解析对象结构体ID 只认标识符→恒 0→偏移未知。
        整64 兜底结构体ID = 0;
        如果 (对象节点.类型 == 节点_成员) {
            字符串 中段名107 = 字符串复制(驻留文本(整64(对象节点.文本)));
            如果 (字符串比较(中段名107, "值") || 字符串比较(中段名107, "错误")) {
                整64 链类型107 = 0;
                可选<整64> 链类型查288 = 解析节点类型ID(池, 整32(n.子起点));
                如果 (链类型查288.有值) { 链类型107 = 链类型查288.值; }
                如果 (链类型107 != 0) {
                    // 1541 B2：无值=链类型非结构体（原 0 哨兵等价）
                    可选<整64> 兜底键107查 = 结构体布局键基(链类型107);
                    如果 (兜底键107查.有值) { 兜底结构体ID = 兜底键107查.值; }
                }
            }
        }
        // 507/537：单目重载结果对象（(-点(5)).x）——单目表达式形态经 解析单目
        //   重载结果类型ID 命中用户类后并入桶查（537 收口：与 方法接收者/成员
        //   左值写 三消费点共用单一事实源·宿主 465 exprSrcType UnaryExpr 同构）。
        如果 (兜底结构体ID == 0) { 兜底结构体ID = 解析单目重载结果类型ID(池, 整32(n.子起点)); }
        如果 (兜底结构体ID == 0 && 对象节点.类型 != 节点_成员) {
            // 598（2026-10-14）：换 统一入口 解析成员链结构体ID（原 解析对象
            //   结构体ID 只认变量域——标识符=方法内类字段裸名〔510-a 同前提〕
            //   miss 落偏移未知误拒；链版标识符分支 598 补类字段表回退）
            可选<整64> 兜底结构查302 = 解析成员链结构体ID(池, 整32(n.子起点));
            如果 (兜底结构查302.有值) { 兜底结构体ID = 兜底结构查302.值; }
        }
        如果 (兜底结构体ID != 0) {
            可选<整64> 桶偏右查 = 查字段偏移(兜底结构体ID, 整64(n.文本));
            如果 (桶偏右查.有值) {
                字段偏移量 = 桶偏右查.值;
                加载类型 = 查字段宽度码(兜底结构体ID, 整64(n.文本));
                可选<整64> 字段值查333 = 查字段类型ID(兜底结构体ID, 整64(n.文本));
                如果 (字段值查333.有值) {
                    整64 字段值333 = 字段值查333.值;
                    成员值码 = 类型码(字段值333);
                }
            }
        }
        // 诊断移至调用方 生成字段访问（104 方法引用分支须在诊断前拦截——
        //   IR 层错误即中止纪律：先诊断后拦截=方法引用命中仍计数中止·1022 实录）
    }
}
