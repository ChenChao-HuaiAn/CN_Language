// CN 自举编译器 v2 · 生成类静态数组字段写（#1979 拆分单元）
//   职责：类静态数组字段整体赋值的整块拷发射核心——自 生成语句赋值.cn（语句
//   形态 070 波G 段）与 生成语句赋值中.cn（表达式形态 070 波G 段）两通道同构
//   数组分支归纳为单一事实源（拆分动因=生成语句赋值.cn 破 1000 冻结线·先拆
//   再加纪律+重复归纳消除）。居消费方（生成语句赋值/生成语句赋值中）之前加载。
//   层依赖纪律：本文件只依赖 IR 同层（源形态守卫留在调用方——守卫需 节点/类型
//   解析=语法层，两调用方各自承担；发射核心=纯 IR 参数）。

导入 容器::向量;
导入 映射集合;
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// #1979（#1882 探针派生）：**类静态数组字段整体赋值**——整块拷（元素×长度
//   全部复制·259 顶层静态数组 252 生成数组整体赋值同款立法投影·001 §3.5
//   数组=值聚合）+发射数组元素级深拷（#1880 数组显式路同构：字符串=
//   __cn_str_copy 独立副本/容器类=拷贝构造/嵌套递归到底·静态槽长期存活恒
//   拥有——浅拷共享源局部句柄=源块退出 RAII 后目标悬垂·E2E 1743 实锤）。
//   原落 IR_指针存储 T_整64=只写槽首 8 字节且写入值=源栈基址（地址当数据·
//   双侧同病·E2E 1742 实锤）。
//   契约（调用方守卫·本函数前置条件）：静态槽类型=数组文本；源=同型数组
//   标识符（右末节点=标识符且类型 ID 与静态槽相等·252 守卫同款）；源基址=
//   源表达式求值产物（数组标识符退化=基址·94-a 指针变量表）；守卫失败=
//   调用方 IR层诊断+运行时错误(6) 显形（宿主 648 同域同拒）。
不安全 函数 发射类静态数组字段整块拷(整64 静态序, 整64 源基址,
                  函数IR& 函数信息, 整64* 寄存器计数,
                  向量<整64>& 表达式栈) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    字符串 数组文本 = 字符串复制(驻留文本(取静态类型(静态序)));
    // 整块字节数=元素步进×长度（类型大小与对齐 单点·宿主 typeSizeOf 同构）；
    // 步进查表 miss=显形中止（禁静默零写）；零长数组=乘积 0=零义务合法。
    整64 字节写 = 0;
    结果<整64, 整32> 步进写 = 数组元素步进(数组文本);
    如果 (步进写.正常) {
        字节写 = 步进写.值 * 数组长度文本(数组文本);
    } 否则 {
        IR层诊断("内部错误: 类静态数组字段整块拷元素步进查表 miss: " + 数组文本);
        运行时错误(6);
    }
    整64 静基址写 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静基址写, T_整64, 静态序));
    IR追加(指令, 建IR指令(IR_结构体拷贝, 源基址, 静基址写, 0, 0, 字节写, 0));
    // #1880 设施：整块后元素级深拷（内部四分派·纯标量终点零义务）
    发射数组元素级深拷(指令, 寄存器计数, 静基址写, 源基址, 数组文本, 0);
    当 (表达式栈.大小() > 0) {
        结果<空类型, 整32> 删栈写 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈写.正常) { 运行时错误(4); }
    }
}
