// CN 自举编译器 v2：容器类型 IR 辅助（自举重建 P7b，2026-09-01）
// 容器类型（向量/映射/链表/栈/队列/集合/结果）类型判定、对象大小表、
// 方法签名表——IR生成.cn 的容器实例化/方法调用据此合成宿主对齐符号
// （类$方法#参数串 → nameMangle，实现链接宿主编译 obj，rustc 预编译 std 模式）。
// 契约对标：宿主 generics.cpp（实例名 类名$实参 扁平 $ 连接）、semantic.cpp
//   signatureKey（方法名#参数类型1,参数类型2）、stdlib 容器.cn/映射集合.cn
//   （方法签名与字段布局）。
// 依赖说明：IR_* 操作码/T_* 类型码/常量表 由 IR常量.cn 定义（簇① A2 单一归属）；
//   IR 指令/函数 IR 数据结构（IR指令/函数IR 结构体）自 呈报①A 根治（2026-09-05）
//   起定义在本模块（见下）——原定义在 IR生成.cn 顶层，而本模块引用它 + IR生成
//   导入本模块 = 反向引用不可导；主链靠多文件合并全局可见掩盖，冒烟子链
//   （IR容器/语法分析/语义分析 入口——链上无 IR生成.cn）结构体登记缺失 ->
//   解析方法对象类型 查结构体大小 miss = 「方法调用的对象类型未知」误诊
//   （冒烟 asm 断供；曾误归因 IR常量.cn 新增常量对，实为登记源结构性缺失）。
导入 容器::向量;
导入 映射集合;
导入 IR;         // 签名辅助 + 节点_*/T_*/IR_*/键位移/当前函数变量类型（原 IR签名+IR常量 合并目录包名）

公开:
// D1 行数整改 124-a：自 IR容器.cn 按族拆出——容器/结果类型判定（结果大小 + 结果槽位数 + 是容器基名 + 是容器类 + 是结果类型 + 容器对象大小 + 是字符串元素容器 + 是字符串值映射 + 容器元素释放参数们 + 发射容器元素释放 + 是入容器方法 + 入容器值实参下标 + 发射字符串复制调用 + 发射槽清零 + 归一化入容器实参）（纯重构零行为变更）

// 结果<T,E> 类型字节大小（ABI 防御布局——宿主 typeSizeOf 结果分支）：
//   正常@0(i32)+联合@4(整32)/@8(整64/字符串)；空类型/整32 -> 12，整64/字符串 -> 16；
//   T=结构体（2026-09-06 根治：结果<符号,整32> 值 32B 实际 40B——原按 16 算
//   retbuf 帧区不足，被调方写越界毁栈，v2self 表查找类型ID rep movsb 源=垃圾
//   崩溃实证）-> 8 对齐 + 结构体大小
函数 结果大小(字符串 结果类型名) -> 整64 {
    字符串 值类型 = 段首(合成名首实参(结果类型名));
    // 268-a D35 拆波1：整32/正32/空类型 值面 12→16——错误槽实际发射偏移=8
    //   （错误访问 op=46 偏移 8·asm 铁证）+宽 8=需 16；原 12=错误槽@4 的旧
    //   模型与发射不一致→错误指针高 4 字节=retbuf 垃圾（320 段错误实锤：
    //   E=字符串 打印行 解引用崩）
    如果 (字符串比较(值类型, "整32") || 字符串比较(值类型, "正32") ||
        字符串比较(值类型, "空类型")) { 返回 16; }
    整64 结构字节数 = 查结构体大小(驻留(值类型));
    如果 (结构字节数 != 0) {
        返回 (结构字节数 + 7) / 8 * 8 + 8;
    }
    返回 16;
}

// 结果变量槽位数（8 字节槽）：12/16 字节均占 2 槽；T=结构体按实际大小
//   （2026-09-06 根治：结果<符号> 40B=5 槽，原 2 槽=变量区越界写踩相邻变量）
函数 结果槽位数(字符串 结果类型名) -> 整64 {
    整64 总字节 = 结果大小(结果类型名);
    返回 (总字节 + 7) / 8;
}

// ==================== 类型判定 ====================
// 类基名白名单（stdlib 泛型容器类。注意：结果/可选 不在此列——它们是宿主
//   内置泛型（合成结构体，非堆对象），由 是结果类型 判定；混入白名单会把
//   结果 变量误判为容器（NewObject+构造——v2p 冒烟实测踩坑）。
//   构造调用合法性判定处（语义/IR）用 是容器类 || 是结果类型 组合。
函数 是容器基名(字符串 名) -> 布尔 {
    返回 字符串比较(名, "向量") || 字符串比较(名, "映射") ||
          字符串比较(名, "链表") || 字符串比较(名, "栈") ||
          字符串比较(名, "队列") || 字符串比较(名, "集合");
}

// 是容器类类型：$ 合成名 且 基名 ∈ 白名单（向量$整64；裸名"向量"非实例）
函数 是容器类(字符串 名) -> 布尔 {
    如果 (首分段位置(名) < 0) { 返回 假; }
    返回 是容器基名(合成名基名(名));
}

// 是结果类型：基名=结果/可选（结果$空类型$整32）
函数 是结果类型(字符串 名) -> 布尔 {
    如果 (首分段位置(名) < 0) { 返回 假; }
    字符串 基名 = 合成名基名(名);
    返回 字符串比较(基名, "结果") || 字符串比较(基名, "可选");
}

// ==================== 对象大小表（NewObject 分配字节数） ====================
// 对标宿主 computeClassLayout 按 stdlib 字段布局（指针/整64 各 8 字节）。
//   ⚠ 维护契约：stdlib 容器.cn/映射集合.cn 字段变更须同步本表。
函数 容器对象大小(字符串 合成名) -> 整64 {
    字符串 基名 = 合成名基名(合成名);
    如果 (字符串比较(基名, "向量")) { 返回 24; }   // T*数据+元素数量+数组容量
    如果 (字符串比较(基名, "链表")) { 返回 64; }   // 值表+下一索引+值容量+头+尾+元素数量+空闲头+已用槽数（83-a）
    如果 (字符串比较(基名, "栈")) { 返回 24; }     // 数据+元素数量+数组容量
    如果 (字符串比较(基名, "队列")) { 返回 64; }   // 值表+下一索引+值容量+头+尾+元素数量+空闲头+已用槽数（83-a）
    如果 (字符串比较(基名, "映射")) { 返回 56; }   // 键+值+链+桶四数组+桶数量+元素数量+数组容量
    如果 (字符串比较(基名, "集合")) { 返回 24; }   // 数据数组+元素数量+数组容量
    返回 8;
}

// ==================== 74-a：容器元素串释放（2026-09-11 第七十四轮） ====================
// 移植来源：宿主 src/cn_compiler/ir/ir_oop_call.cpp::emitContainerElemFreeFor +
//   src/runtime/io_api.cpp::__cn_vector_free_strings / __cn_chain_free_strings。
// **移植清单两件套（plans/020 移植纪律 7）**：
//   机制主体 = 容器析构时按元素模型逐元素释放元素串（容器拥有元素所有权）。
//   依赖不变量 = ①**释放后元素槽清零**（幂等前提——块出口/跳出/函数级兜底/清空
//     多路径共享同一元素数组，清零后 cn_free_tracked(nullptr) 空安全；73-a 宿主
//     首版缺此不变量致 double free SIGSEGV 的同一形态）；②**链式容器按链游释放**
//     （链表/队列 的出队/删除头部把元素所有权转移给调用方，槽序号可能 < 元素数量
//     ——平铺释放会误释放已移交的串；宿主同款不变量）；③字面量元素=驻留常量，
//     cn_free_tracked 非在册(空安全)。
// 元素类型判定（恰为 字符串；嵌套容器元素不匹配——按嵌套形态以 char* 语义释放
//   容器对象指针会损坏堆）
//   76-a（2026-09-12 第七十六轮）：加 集合$字符串（探针 76-E/S1 实证：集合元素串
//   原无释放面——析构/清空路径泄漏；元素=独立平铺数组，模型同 向量/栈）
函数 是字符串元素容器(字符串 合成名) -> 布尔 {
    整64 位置 = 首分段位置(合成名);
    如果 (位置 < 0) { 返回 假; }
    字符串 基名 = 字符串子串(合成名, 0, 位置);
    如果 (!(字符串比较(基名, "向量") || 字符串比较(基名, "链表") ||
          字符串比较(基名, "栈") || 字符串比较(基名, "队列") ||
          字符串比较(基名, "集合"))) {
        返回 假;
    }
    返回 字符串比较(合成名首实参(合成名), "字符串");
}

// 76-a：字符串值映射判定（映射$K$字符串）——入容器位（设置 值实参=下标1）归一化用。
//   释放面随宿主编译供给 obj 生效（~映射/清空/删除/覆盖写/释放内部数组 注入），
//   故本判定只服务归一化（与宿主 isStringValuedMap 同款；不并入 是字符串元素容器
//   ——键/值两数组非单元素数组模型，不经 发射容器元素释放）。
//   背景（探针 76-F 实证）：映射释放侧假定值槽句柄恒为「容器独有或驻留常量」
//   （移植纪律 7 不变量①）——不归一化=借用来源句柄浅存 → 容器析构释放调用方串
//   （UAF，74-a 缺陷①在映射上的重演）。
函数 是字符串值映射(字符串 合成名) -> 布尔 {
    如果 (!字符串比较(合成名基名(合成名), "映射")) { 返回 假; }
    字符串 值段 = 段首(段余(合成名首实参(合成名)));   // 映射$K$V -> K$V -> V
    返回 字符串比较(值段, "字符串");
}

// 容器字段偏移（按 stdlib 容器.cn 字段序，与 容器对象大小 表同源维护）
//   向量/栈：数据@0 元素数量@8；集合：数据数组@0 元素数量@8；链表/队列：值表@0
//   下一索引@8 值容量@16 头索引@24 尾索引@32 元素数量@40
函数 容器元素释放参数们(字符串 合成名, 向量<整64>& 出) -> 空类型 {
    字符串 基名 = 合成名基名(合成名);
    如果 (字符串比较(基名, "向量") || 字符串比较(基名, "栈") ||
          字符串比较(基名, "集合")) {   // 76-a：集合=独立平铺数组（同 向量 模型）
        结果<空类型, 整32> 加0 = 出.追加(0);     // 数据偏移
        如果 (!加0.正常) { 运行时错误(4); }
        结果<空类型, 整32> 加1 = 出.追加(8);     // 元素数量偏移
        如果 (!加1.正常) { 运行时错误(4); }
        返回;
    }
    // 链表/队列（链式模型）
    结果<空类型, 整32> 加0c = 出.追加(0);        // 值表偏移
    如果 (!加0c.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加1c = 出.追加(8);        // 下一索引偏移
    如果 (!加1c.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加2c = 出.追加(24);       // 头索引偏移
    如果 (!加2c.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加3c = 出.追加(40);       // 元素数量偏移
    如果 (!加3c.正常) { 运行时错误(4); }
}

// 发射容器元素串释放：obj寄存器=容器对象指针；实参按模型分派
//   平铺（向量/栈/集合）：__cn_vector_free_strings(obj, 数据偏移, 元素数量偏移)
//   链式（链表/队列）：__cn_chain_free_strings(obj, 值表, 下一索引, 头索引, 元素数量)
// 调用形态与 发射字符串释放 同款（IR_调用实参×N + IR_调用参数化 收尾——
//   多参数调用零新指令，代码生成 __cn_ 前缀直通）。
不安全 函数 发射容器元素释放(函数IR& 函数信息, 整64* 寄存器计数,
                      整64 对象寄存器, 整64 容器类型ID) -> 空类型 {
    字符串 合成名 = 字符串复制(驻留文本(容器类型ID));
    如果 (!是字符串元素容器(合成名)) { 返回; }
    向量<整64> 参数们 = 向量<整64>();
    容器元素释放参数们(合成名, 参数们);
    如果 (参数们.大小() == 0) { 返回; }
    字符串 基名 = 合成名基名(合成名);
    布尔 链式 = 字符串比较(基名, "链表") || 字符串比较(基名, "队列");
    字符串 释放符号 = "__cn_vector_free_strings";
    如果 (链式) { 释放符号 = "__cn_chain_free_strings"; }
    // 位 0 = obj（自然落 rdi）；常量参数经 IR_常量整数 加载后按位发射
    整64 位 = 0;
    IR追加(函数信息.指令, 建IR指令(IR_调用实参, 对象寄存器, 0, 0, 0, 位, 0));
    位++;
    整64 i = 0;
    当 (i < 参数们.大小()) {
        整64 常reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(函数信息.指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(参数们.元素(i))),
                             0, 0, 常reg, T_整64, 0));
        IR追加(函数信息.指令, 建IR指令(IR_调用实参, 常reg, 0, 0, 0, 位, 0));
        位++;
        i++;
    }
    IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 位, 0, 0, 0, 0, 驻留(释放符号)));
}

// ==================== 74-a：入容器位所有权归一化（2026-09-11 第七十四轮） ====================
// 移植来源：宿主 ir_oop_call.cpp::buildCallArgsForMethod + normalizeContainerInsertArg。
// **移植清单两件套（plans/020 移植纪律 7）**：
//   机制主体 = 入容器位按实参来源分级归一化——字面量=驻留借用（零复制）；
//     转移(拥有局部)=真 move（句柄直存 + 源槽清零，零拷贝）；调用返回（拥有契约）
//     =直接接管；其余（标识符/成员/下标/借出）=__cn_str_copy 落堆。
//   依赖不变量 = ①**容器元素释放假定元素恒为堆串或驻留常量**（发射容器元素释放
//     逐元素 cn_free_tracked）——故借用来源必须复制，否则容器析构释放他人句柄
//     （宿主探针 74-L：跨函数 UAF 输出乱码）；②**真 move 分支源槽必须清零**——
//     源变量仍在 字符串变量们 名单内，出口 __cn_str_free 释放已移交句柄=元素悬垂
//     （宿主探针 74-J 同形态）。
// 时序不变量（v2 特有，实施中实证）：归一化调用须在 **this 的 IR_调用实参 之前**
//   发射——代码生成的调用展开是「收集 IR_调用实参，遇 IR_调用参数化 统一展开」，
//   若在 this/实参已声明之后插入独立调用，其 IR_调用参数化 会把前面收集的实参
//   一起展开（位数错乱、寄存器错位）。

// 入容器位方法名（stdlib/容器.cn 中「把值交给容器」的全部入口）
函数 是入容器方法(字符串 方法名) -> 布尔 {
    返回 字符串比较(方法名, "追加") || 字符串比较(方法名, "插入") ||
          字符串比较(方法名, "设置") || 字符串比较(方法名, "压入") ||
          字符串比较(方法名, "入队") || 字符串比较(方法名, "头部追加") ||
          字符串比较(方法名, "添加");
}

// 值实参正序下标：插入(位置,值)/设置(位置,值) 的值在 1；其余在 0。-1=非入容器位
函数 入容器值实参下标(字符串 方法名) -> 整64 {
    如果 (字符串比较(方法名, "插入") || 字符串比较(方法名, "设置")) { 返回 1; }
    如果 (是入容器方法(方法名)) { 返回 0; }
    返回 -1;
}

// 发射 __cn_str_copy(实参寄存器) -> 新寄存器（调用方须已登记调用序列未开始）
不安全 函数 发射字符串复制调用(向量<IR指令>& 指令, 整64* 寄存器计数,
                     整64 实参寄存器) -> 整64 {
    整64 copy寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_调用实参, 实参寄存器, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, copy寄存器, 0,
                         驻留("__cn_str_copy")));
    登记寄存器类型(copy寄存器, T_字符串);
    返回 copy寄存器;
}

// 源槽清零（75-a 真 move 不变量）：写 0 到槽——本函数拿不到 函数信息.零寄存器，
//   故现发一个常量 0 寄存器（IR_常量整数 + IR_存储，两者均非调用指令，不参与
//   调用实参收集展开，位置无时序约束）。
不安全 函数 发射槽清零(向量<IR指令>& 指令, 整64* 寄存器计数, 整64 槽) -> 空类型 {
    整64 零reg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零reg, T_整64, 0));
    IR追加(指令, 建IR指令(IR_存储, 零reg, 0, 0, 0, 0, 槽));
}

// 入容器位实参所有权归一化（方案A 核心；调用方在 发射调用实参们/this 声明之前调用）
//   池/调用节点：实参节点区间 [子起点+1, 子起点+1+附加)（正序）
//   弹出们：实参寄存器（倒序——弹出们[0]=末实参），值实参寄存器按下标原位替换
//   76-a（2026-09-12 第七十六轮）：映射（值侧字符串）同纳入——释放侧假定值槽
//   句柄恒为「容器独有或驻留常量」（移植纪律 7 不变量①），不归一化=借用来源
//   浅存 → 容器析构释放他人串（UAF，探针 76-F）
不安全 函数 归一化入容器实参(向量<节点> 池, 节点 调用节点, 整32 调用位置,
                    字符串 类名, 字符串 方法名, 向量<整64>& 弹出们,
                    映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                    向量<IR指令>& 指令, 整64* 寄存器计数) -> 空类型 {
    如果 (!(是字符串元素容器(类名) || 是字符串值映射(类名))) { 返回; }
    整64 值序 = 入容器值实参下标(方法名);
    如果 (值序 < 0 || 值序 >= 整64(调用节点.附加)) { 返回; }
    如果 (弹出们.大小() == 0) { 返回; }
    整64 弹下标 = 弹出们.大小() - 1 - 值序;
    如果 (弹下标 < 0 || 弹下标 >= 弹出们.大小()) { 返回; }
    // 实参根节点定位（v2 节点池=**后缀序**：子节点在前、根在后）。入容器位方法表
    //   （追加/压入/入队/头部追加/添加 值序0；插入/设置 值序1）的**值实参恒为最后
    //   一个实参**，故其根节点 = 调用节点前一位置（调用节点自身索引=调用位置）。
    //   **不可用 子起点+1+值序**——那是实参子树**起始**节点，复合实参（如
    //   追加(字符串复制(x))）时指向最内层子节点，判定失真（探针 74-H 实证：
    //   取到「字符串复制」标识符节点 → 误判借用 → 多一次复制 + 原值泄漏）。
    如果 (调用位置 <= 0) { 返回; }
    整64 实参根索引 = 整64(调用位置) - 1;
    如果 (实参根索引 >= 池.大小()) { 返回; }
    节点 实参节点 = 池.元素(整32(实参根索引));
    // ① 字面量：驻留借用（进程生命周期常量，释放侧非在册空安全，零复制开销）
    如果 (实参节点.类型 == 节点_字符串字面量) { 返回; }
    整64 实参寄存器 = 弹出们.元素(弹下标);
    // ①' 75-a（2026-09-12 方案甲 用户裁决）：**转移(拥有局部) = 真 move**
    //    （宿主 normalizeContainerInsertArg 分支③同款：句柄直存 + 源槽清零，
    //    零拷贝）。三重判定（全部命中才真 move，任一不满足回落 ③ 复制）：
    //     a. 实参形态确为 转移(标识符) 调用；
    //     b. 源名在 **局部槽** 命中（是局部变量）；
    //     c. 源名**不在 参数槽**（函数参数=借用视图，容器不得接管其句柄）；
    //     d. 源名不在 **污染镜像**（借用视图/非拥有初始化——容器接管即容器析构
    //        释放他人串=UAF，故此判定必须保守：不确定→复制）。
    //    不变量：真 move 分支须清源槽（否则源 RAII 出口 __cn_str_free 释放已
    //    移交句柄=元素悬垂，探针 74-J 宿主同形态）；清零用现发常量寄存器
    //    （本函数无 函数信息.零寄存器）。
    如果 (实参节点.类型 == 节点_调用 && 实参节点.子起点 > 0 &&
        整64(实参节点.附加) == 1) {
        节点 被调t = 池.元素(整32(实参节点.子起点));
        如果 (被调t.类型 == 节点_标识符 &&
             字符串比较(驻留文本(整64(被调t.文本)), "转移")) {
            节点 源节点 = 池.元素(整32(实参节点.子起点) + 1);
            如果 (源节点.类型 == 节点_标识符) {
                整64 源名ID = 整64(源节点.文本);
                结果<整64, 整32> 找源槽 = 局部槽.获取(源名ID);
                如果 (找源槽.正常) {
                    结果<整64, 整32> 找参槽 = 参数槽.获取(源名ID);
                    如果 (!找参槽.正常) {
                        如果 (!是当前串污染(源名ID)) {
                            发射槽清零(指令, 寄存器计数, 找源槽.值);
                            返回;   // 真 move：零拷贝（容器接管源句柄）
                        }
                    } 否则 { }
                } 否则 { }
            }
        }
    }
    // ② 裸调用（标识符被调：白名单内置族 / 返回 字符串 契约）：返回值归本函数，
    //    容器直接接管（零拷贝）。**方法调用（元素/读取/头部元素 等）不走此支**：
    //    其被调节点是成员形态（非标识符），元素访问返回的是容器内借出句柄——
    //    误判为拥有会导致「两容器共享同一元素句柄 = 双释放」（宿主 semantic_call
    //    对 T 来源返回同样保守不登记），故一律落入 ③ 复制。
    如果 (实参节点.类型 == 节点_调用 && 实参节点.子起点 > 0) {
        节点 被调c = 池.元素(整32(实参节点.子起点));
        如果 (被调c.类型 == 节点_标识符) {
            整64 被调名c = 整64(被调c.文本);
            布尔 白名单 = 被调名c == 驻留("字符串复制") ||
                          被调名c == 驻留("字符串连接") ||
                          被调名c == 驻留("字符串拼接") ||
                          被调名c == 驻留("字符串子串") ||
                          被调名c == 驻留("字符串大写") ||
                          被调名c == 驻留("字符串小写") ||
                          被调名c == 驻留("字符串修剪") ||
                          被调名c == 驻留("字符串反转");
            如果 (!白名单 && 查函数返回回退(被调名c) == 驻留("字符串")) {
                白名单 = 真;   // A2 契约：签名即契约（返回 字符串 即拥有）
            }
            如果 (白名单) { 返回; }   // 直接接管（零拷贝）
        }
    }
    // ③ 其余（标识符/转移/成员/下标/借出/借用返回）：__cn_str_copy 落堆
    //    （CN 值语义深拷贝——源照常拥有并释放，容器独立拥有；Rust push(s.clone())）
    //    注：`转移(拥有局部)` 真 move 已由 ①'（75-a 污染名单镜像三重判定）覆盖，
    //    走到此处者=借用来源（形参/污染名）或非转移形态——复制是安全方向。
    结果<空类型, 整32> 换实 = 弹出们.设置(
        弹下标, 发射字符串复制调用(指令, 寄存器计数, 实参寄存器));
    如果 (!换实.正常) { 运行时错误(4); }
}
