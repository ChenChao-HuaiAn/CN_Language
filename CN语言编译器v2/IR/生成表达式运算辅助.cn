// CN 自举编译器 v2 · 二元发射辅助判定（481 行数解堵轮·2026-10-12）
// 职责：生成表达式运算.cn 的二元发射辅助判定族——①嵌套窄码回溯（481 新增·
//   B 案收口）；②字符串拼接判定（215-a 自 运算.cn 纯迁入·逐字节零语义）；
//   ③浮点混合转换（91-a/92-a 自 运算.cn 纯迁入·逐字节零语义）；
//   ④字符串拼接/比较发射族（663 自 运算.cn 纯迁入·逐字节零语义——拼接侧128
//   截断/发射寄存器串释放/发射字符串拼接/发射字符串比较·含 663 转换临时
//   消费即释收口）。
// 迁移缘由：生成表达式运算.cn 已 996 行（900 警戒线上·1000 冻结线差 4 行），
//   481 修改须「先拆再加」（474 轮 溢出474 迁移同款先例）——纯移动腾余量；
//   663 轮该文件触 976 行（900 警戒线上）再迁——644 ir_call_args.cpp 纯搬移
//   同款先例。
公开:   // 全文件公开（子模块符号供包内兄弟模块 经合并全局池解析·生成表达式运算 消费）

不安全 函数 嵌套窄码回溯481(整64 源码377, 整64 登记码481) -> 整64 {
    // 481（字面量面偏差·2026-10-12 用户裁决 B 案收口·001 §3.7a）：嵌套表达式
    //   窄码回溯——内层二元若经 377 乙案窄化（尾部登记寄存器窄码），外层二元
    //   的该侧须按窄码参与（宿主语义层 285 按**表达式类型**推导同构——
    //   `甲 + 1 + 30000` 内层=整16 窄域 → 外层字面量 30000 按整16 参与 →
    //   60001 溢出须报错误码8；修前外层左末端（n.附加=右起点-1=左子树末节点）
    //   落在内层二元上 → 解析节点类型ID 落宽默认 → 宽域 60001 漏报·宿主 v2
    //   分叉实证 y1/y2/x2 探针）。显式转换形态不受影响：整64(甲) 寄存器登记
    //   码=T_整64 非窄族 → 不回溯（混合宽度提升较宽侧条文零波及）。
//   空间纪律：返回值=**类型名 ID**（驻留("整16") 族·与 解析节点类型ID 同
//   空间·是窄X377 按名 ID 比较）；查寄存器类型 可选值=**类型码**（T_整16 族·
//   1360 批5 结果化）——反向映射后返回（对照 生成表达式运算 377 尾部名字ID→
//   类型码 正向映射）。
    如果 (源码377 == 驻留("整8") || 源码377 == 驻留("整16") ||
         源码377 == 驻留("正8") || 源码377 == 驻留("正16")) { 返回 源码377; }
    如果 (登记码481 == T_整8) { 返回 驻留("整8"); }
    如果 (登记码481 == T_整16) { 返回 驻留("整16"); }
    如果 (登记码481 == T_正8) { 返回 驻留("正8"); }
    如果 (登记码481 == T_正16) { 返回 驻留("正16"); }
    返回 源码377;
}

// T48 轮（505 双编译对照捕获·机制级）：类型码() 把 字符 归并 T_整64
//   （IR容器.cn 映射——字符打印/算术按数值消费=宿主对齐不变），寄存器登记层
//   字符信息丢失 → 拼接转换误走 from_int 打码点十进制（22909）。字符的拼接
//   语义=字符转字符串（规范 02「字符串 + 数值 隐式拼接」行）——按末端类型名 ID
//   复核复位（仅拼接分派消费 T_字符·零波及打印/算术/实参分派）；未登记（0）
//   照旧兜底推导。
// 749（2026-10-19·事不过三提炼）：复核判据单点化——消费面=普通拼接判定左右
//   两处 + 连接链融合段码一处（原第三处只判 0 漏 T_整64 字符归并面：937 ②b
//   `"b="+真+"|c="+字+"|u="+正值` 融合链把 'A' 打成 65，与宿主 from_char 分叉）。
函数 复核拼接码(向量<节点> 池, 整64 末端位置, 整64 码) -> 整64 {
    如果 (码 == 0 || 码 == T_整64) {
        返回 推导末端拼接码(池, 整32(末端位置), 码);
    }
    返回 码;
}

// 215-a：族① 拼接判定（③ 第一波：字符串拼接 + 双侧隐式转换——寄存器类型登记表
//   判定 + 末端节点推导兜底）。3 项引用输出：拼接加/拼接左码/拼接右码。
不安全 函数 判定字符串拼接(向量<节点> 池, 节点 n, 字符串 op名, 整32 位置,
                     向量<整64>& 表达式栈, 布尔& 拼接加, 整64& 拼接左码, 整64& 拼接右码) -> 空类型 {
    如果 (字符串比较(op名, "+") && 表达式栈.大小() >= 2) {
        整64 栈右 = 表达式栈.元素(表达式栈.大小() - 1);
        整64 栈左 = 表达式栈.元素(表达式栈.大小() - 2);
        // 1360 批5：未登记=类型未知（T_未知 兜底·既有业务语义：交复核拼接码推导）
        拼接左码 = 查寄存器类型或未知(栈左);
        拼接右码 = 查寄存器类型或未知(栈右);
        // T48 字符归并面复核（判据与注释见 复核拼接码 单点）
        拼接左码 = 复核拼接码(池, 整64(n.附加) - 1, 拼接左码);
        拼接右码 = 复核拼接码(池, 整64(位置) - 1, 拼接右码);
        如果 (拼接左码 == T_字符串 || 拼接右码 == T_字符串) {
            拼接加 = 真;
        }
    }
}

// 215-a：族② 浮点混合转换（91-a：浮64+整 自动宽化·92-a 单侧浮32 升 f64 禁止隐式
//   窄化·统一按操作数码≠公共浮码插入转换）。左右寄存器引用输出（转换后更新）。
不安全 函数 浮点混合转换(整64 op, 整64& 左, 整64& 右, 向量<IR指令>& 指令, 整64* 寄存器计数) -> 空类型 {
    // 1360 批5：未登记=类型未知（T_未知 兜底·既有业务语义：按非浮点源）
    整64 左码浮 = 查寄存器类型或未知(左);
    整64 右码浮 = 查寄存器类型或未知(右);
    布尔 是浮点左 = (左码浮 == T_浮32 || 左码浮 == T_浮64);
    布尔 是浮点右 = (右码浮 == T_浮32 || 右码浮 == T_浮64);
    布尔 是算比 = (op == IR_加 || op == IR_减 || op == IR_乘 || op == IR_除 ||
                  op == IR_相等 || op == IR_不等 || op == IR_小于 ||
                  op == IR_大于 || op == IR_小于等于 || op == IR_大于等于);
    如果 ((是浮点左 || 是浮点右) && 是算比) {
        整64 浮码 = T_浮64;
        如果 (是浮点左 && !是浮点右) { 浮码 = 左码浮; }
        否则 如果 (是浮点右 && !是浮点左) { 浮码 = 右码浮; }
        否则 如果 (左码浮 == T_浮32 && 右码浮 == T_浮32) { 浮码 = T_浮32; }
        // 92-a（2026-09-13 第九十二轮）：单侧浮点为浮32、另一侧为整型 → 升 f64
        //   （禁止隐式窄化——整型转 浮32 有损，规范「仅允许无损或宽化转换」；
        //   对齐宿主「整 + 浮 → f64」与 92-a 宿主侧修复）。原「单侧浮点取该侧」
        //   在浮32 时把整型操作数窄化到 f32：实证 甲(浮32)+16777217 宿主
        //   16777218.5 / v2 前值 16777218.0（双侧分叉）。
        如果 ((是浮点左 && !是浮点右 && 左码浮 == T_浮32) ||
            (是浮点右 && !是浮点左 && 右码浮 == T_浮32)) { 浮码 = T_浮64; }
        // 92-a：统一按「操作数码 ≠ 公共浮码」插入转换（原判定仅 非浮点侧 转换
        //   ——浮码为 f64 时已是浮点的 浮32 侧被漏掉：f32 位模式直进 xmm 双精度
        //   运算/比较（f32+f64 双侧浮点形态原有同款漏网，本轮一并根治）。
        如果 (左码浮 != 浮码) {
            左 = 插入值转换(左, 浮码, 指令, 寄存器计数);
            左码浮 = 浮码;
            是浮点左 = 真;
        }
        如果 (右码浮 != 浮码) {
            右 = 插入值转换(右, 浮码, 指令, 寄存器计数);
            右码浮 = 浮码;
            是浮点右 = 真;
        }
    }
}

// 617 旧段（拥有串临时形态·三元面任一分支命中即登记+递归释放）已随 #2025
//   三元标志槽收口迁往 生成表达式三元.cn：判据单点=串临时拥有性判定
//   （方法成员面=方法调用串返回判定/闭包变量面=闭包变量返回串拥有判定/
//   方法值变量面=是方法值变量拥有串返回/#1922 四件全在·三元释放改
//   发射串临时条件释放 按运行时拥有标志——旧「任一分支命中即登记+
//   发射串临时释放递归617」机制已替换，禁两套并存双释放）。

// #1572：自由函数/内置被调返回串类型判定（类型判据单点）——内置返回类型权威表
//   （828-a 两级直查+归一基名）∪ 用户函数返回类型回退链（查函数返回回退）。
//   自由函数/内置借用返回已被语义层 210 负测族拒绝（参数/成员/下标/字符*/
//   静态）→ 类型判据即拥有判据；方法面另按返回表达式形态判定（方法返回串拥有617）。
//   引用返回（尾 & 原文≠"字符串"）与空类型/数值返回天然不命中（1541 B2：无值=
//   返回类型未知，与 0 同假域）。
函数 被调返回串类型判定(整64 被调名ID) -> 布尔 {
    字符串 名617 = 字符串复制(驻留文本(被调名ID));
    可选<整64> 内置返查617 = 内置函数返回类型ID(名617);
    布尔 内置返串617 = 假;
    如果 (内置返查617.有值) { 内置返串617 = 内置返查617.值 == 驻留("字符串"); }
    如果 (内置返串617) { 返回 真; }
    可选<整64> 返查617 = 查函数返回回退(被调名ID);
    布尔 返串617 = 假;
    如果 (返查617.有值) { 返串617 = 返查617.值 == 驻留("字符串"); }
    返回 返串617;
}

// #1578：闭包变量判定（lambda 值载体变量）——lambda闭包变量们 命中即真。
//   未命中=非 lambda 变量（函数指针/方法值/普通变量/自由函数名）→ 调用方走
//   类型判据原路（1571 函数指针返回段回退）。查表无值=键不存在（否定回答·
//   非失败通道），不落静默兜底。
函数 是闭包变量(整64 名ID) -> 布尔 {
    结果<整64, 整32> 查闭包 = lambda闭包变量们.获取(名ID);
    布尔 命中 = 假;
    如果 (查闭包.正常 && 查闭包.值 != 0) { 命中 = 真; }
    返回 命中;
}

// #1578：闭包变量被调返回串拥有性——按 lambda 体**返回表达式形态**判定
//   （宿主 ClosureInfo::returnBodyOwned / stringReturnBodyOwned 同构）。
//   为什么不能只看返回类型：lambda 体可合法返回借用句柄（形参透传/成员读；
//   lambda 体返回位 A2 尚未执法），按类型释放=释放未被授予所有权的串
//   （#1696 同族）。定位合成函数节点（名ID 匹配·倒序扫=后定义优先）；
//   返回类型非"字符串"/体块不可达/无 返回 语句=借用面（宁漏勿崩·1479 口径）。
不安全 函数 闭包变量返回串拥有判定(向量<节点> 池, 整64 名ID, 整64 深度) -> 布尔 {
    布尔 拥有 = 假;
    结果<整64, 整32> 查闭包 = lambda闭包变量们.获取(名ID);
    整64 lambda名 = 0;
    如果 (查闭包.正常) { lambda名 = 查闭包.值; }
    如果 (lambda名 != 0 && 深度 != 0) {
        整64 合成位 = 0;
        整64 找到 = 0;
        整64 li = lambda合成函数索引们.大小() - 1;
        当 (li >= 0) {
            整64 位 = lambda合成函数索引们.元素(整32(li));
            布尔 位在域 = 位 >= 1 && 位 <= 整64(池.大小()) - 1;
            如果 (位在域) {
                节点 cand = 池.元素(整32(位));
                如果 (整64(cand.文本) == lambda名) {
                    合成位 = 位;
                    找到 = 1;
                    中断;
                }
            }
            li--;
        }
        如果 (找到 == 1) {
            节点 合成 = 池.元素(整32(合成位));
            // 返回类型标注 = 节点_函数.附加（解析层 合成函数 构造位次）
            整64 返型ID = 整64(合成.附加);
            布尔 返串 = 返型ID != 0 &&
                        字符串比较(字符串复制(驻留文本(返型ID)), "字符串");
            整64 体位 = 整64(合成.子终点);
            布尔 体在域 = 体位 >= 1 && 体位 <= 整64(池.大小()) - 1;
            如果 (返串 && 体在域) {
                节点 体块 = 池.元素(整32(体位));
                如果 (体块.类型 == 节点_块) {
                    整64 命中数 = 0;
                    整64 拥有数 = 0;
                    // 合成函数位作形参/体块定位位（局部返回串拥有判定 同口径）
                    收集返回拥有判定(池, 整64(体块.子起点), 整64(体块.子终点),
                                    合成位, 0, 深度, &命中数, &拥有数);
                    拥有 = 命中数 != 0 && 命中数 == 拥有数;
                }
            }
        }
    }
    返回 拥有;
}

// 617：打印族/内置消费族被调判定（只读消费实参·结算白名单）——驻留（表可能
//   持指针视图）与用户函数（收下句柄面·与宿主一致呈报）不入集合。
不安全 函数 只读消费被调617(字符串 被调名617) -> 布尔 {
    字符串 归一名617 = 内置归一基名(被调名617);
    返回 字符串比较(归一名617, "打印") || 字符串比较(归一名617, "打印行") ||
         字符串比较(被调名617, "字符串长度") || 字符串比较(被调名617, "字符串比较") ||
         字符串比较(被调名617, "字符串字典序") || 字符串比较(被调名617, "字符串查找") ||
         字符串比较(被调名617, "字符串包含") || 字符串比较(被调名617, "字符串前缀") ||
         字符串比较(被调名617, "字符串后缀") || 字符串比较(被调名617, "字符串复制") ||
         字符串比较(被调名617, "字符串连接") || 字符串比较(被调名617, "字符串子串") ||
         字符串比较(被调名617, "字符串大写") || 字符串比较(被调名617, "字符串小写") ||
         字符串比较(被调名617, "字符串修剪") || 字符串比较(被调名617, "字符串反转") ||
         字符串比较(被调名617, "格式化");
}

// 617：释放拥有串临时寄存器（free 直调·寄存器句柄无槽无清零义务）
不安全 函数 发射串临时释放(整64 寄存器617, 向量<IR指令>& 指令, 整64* 寄存器计数) -> 空类型 {
    IR追加(指令, 建IR指令(IR_调用实参, 寄存器617, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0, 驻留("__cn_str_free")));
}

// ==================== 102 甲案：消耗形参判定（616 伞批自 生成函数.cn 机械搬移腾行·零语义） ====================

// 102 甲案（2026-09-29 用户裁决·〔基准=019〕）：字符串值形参**消耗判定**——函数体
//   块子区间线性扫描（嵌套块/条件体语句节点均含于体块子区间——节点池顺序追加·
//   与 预扫容器声明 同源口径）。命中两形态之一即消耗：
//   ① 节点_赋值.文本==形参名ID（标识符左值赋值——生成赋值语句 契约：文本=左值名）；
//   ② 转移(形参名)/字符串释放(形参名) 单实参调用（被调名=调用子区间首子节点）。
//   消耗形参由 生成函数 入口深拷独立副本（090 丙案「默认=值副本」兑现）；非消耗
//   直传零拷贝（第四句拷贝消除：字符串无原地写·只读借用别名不可观察）。
不安全 函数 形参被消耗(向量<节点> 池, 整32 块节点, 整64 名ID) -> 布尔 {
    如果 (块节点 < 0 || 块节点 >= 池.大小()) { 返回 假; }
    节点 块 = 池.元素(块节点);
    整64 i = 整64(块.子起点);
    当 (i < 整64(块.子终点)) {
        节点 n = 池.元素(整32(i));
        如果 (n.类型 == 节点_赋值 && 整64(n.文本) == 名ID) { 返回 真; }
        // 616 修正：表达式位调用节点 子终点未填（恒 0·探针 617dbg 同源实锤）——
        //   原判「子终点-子起点==2」恒假=字符串释放(形参) 不触发消耗标记→
        //   借用直传下被调 free 调用方串（探针残留 -1 实锤）。单实参判定改
        //   附加==1（协议：节点_调用.附加=实参数）。
        如果 (n.类型 == 节点_调用 && n.附加 == 1 && n.子起点 > 0 &&
             n.子起点 + 1 < 整64(池.大小())) {
            节点 被调 = 池.元素(整32(n.子起点));
            节点 首实参 = 池.元素(整32(n.子起点 + 1));
            如果 (被调.类型 == 节点_标识符 && 首实参.类型 == 节点_标识符 &&
                 整64(首实参.文本) == 名ID) {
                整64 被调名 = 整64(被调.文本);
                如果 (被调名 == 驻留("转移") || 被调名 == 驻留("字符串释放")) {
                    返回 真;
                }
            }
        }
        i++;
    }
    返回 假;
}

// ==================== 663 重放迁入族：字符串拼接/比较发射（自 生成表达式运算.cn 迁入·行数纪律 137 行纯搬移同款载体） ====================

// 418（002 收口杂项正测族·宿主 genStringConcatI128 同构）：拼接数值侧 128 位
//   值=16 字节槽基址句柄（寄存器存**地址**）——直传 __cn_str_from_int（单 i64
//   形参）=ABI 错位垃圾（17_audit 双编译对照实证 1234567890123 印
//   947300333944/574347015776·值随上下文漂移=读邻槽特征）。先 指针加载 解句柄
//   取低 64 位（810 显式转换 128→窄 同款发射·值域≤2^63 语义正确·宿主注释
//   「整128 截断 i64」同款），码同步 T_整64 走 from_int。
不安全 函数 拼接侧128截断(整64& 值, 整64& 码, 向量<IR指令>& 指令, 整64* 寄存器计数) -> 空类型 {
    如果 (码 == T_整128 || 码 == T_正128) {
        整64 低半 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_指针加载, 值, 0, 0, 低半, T_整64, 0));
        登记寄存器类型(低半, T_整64);
        值 = 低半;
        码 = T_整64;
    }
}

// 663（2026-10-14）：裸寄存器拥有串释放直调公共发射点（事不过三提炼——发射
//   字符串拼接 左右转换临时与 发射语句位弃串释放〔生成语句辅助〕共用；字段/
//   数组形态释放面=IR容器释放 各专函数不在此列）。
不安全 函数 发射寄存器串释放(整64 寄存器, 向量<IR指令>& 指令) -> 空类型 {
    IR追加(指令, 建IR指令(IR_调用实参, 寄存器, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0, 驻留("__cn_str_free")));
}

// 字符串拼接发射：数值侧隐式转换（from_int/from_float/from_bool，宿主 Task 2.9——
//   未登记类型按整数兜底）+ __cn_str_concat 裸 ASCII 直调（实参位 0/1，产物登记
//   T_字符串——链式外层判定用）。
// 663 重放核注（rebase 融合留痕）：develop 617 已收「数值侧转换产物 concat 后
//   即释」同域面（判据=拼接码≠字符串；663 原版=转换寄存器记录判据·二者在函数
//   内严格等价——数值分支执行⟺码≠字符串⟺转换寄存器≠0，释放对象同一=from_*
//   产物寄存器，发射逐指令一致）——取 617 版防同面双 free；663 的公共发射点
//   发射寄存器串释放 照常保留（语句位弃串释放/732/758 面共用）。
// 2026-10-19（749）：拼接数值侧 -> 字符串转换单点入口（事不过三提炼——
//   发射字符串拼接 左/右两处 + 连接链融合段一处共用）。逐指令语义与 663 原位
//   一致：92-a 浮32 先宽化 f64（__cn_str_from_float 形参为 double）；418 128 位
//   句柄先解引用取低 64 位；按转换前码查 转换符号（from_int/uint/float/char/bool）。
//   完成后 码 置 T_字符串、值 重绑为转换产物寄存器（调用方以布尔记录转换前形态）。
不安全 函数 发射拼接数值转换(整64& 值, 整64& 码, 向量<IR指令>& 指令,
                      整64* 寄存器计数) -> 空类型 {
    如果 (码 == T_字符串) { 返回; }
    // 92-a：浮32 数值侧先宽化 f64（同左侧）
    如果 (码 == T_浮32) {
        值 = 插入值转换(值, T_浮64, 指令, 寄存器计数);
        码 = T_浮64;
    }
    // 418：128 位句柄先解引用取低 64 位（红A 根治·见 拼接侧128截断 注释）
    拼接侧128截断(值, 码, 指令, 寄存器计数);
    整64 转 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    // 91-a：实参类型码=数值侧码（浮点走 xmm0——__cn_str_from_float(double)）
    IR追加(指令, 建IR指令(IR_调用实参, 值, 码, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 转, 0,
                         驻留(转换符号(码))));
    登记寄存器类型(转, T_字符串);
    值 = 转;
    码 = T_字符串;
}

不安全 函数 发射字符串拼接(整64 拼接左码, 整64 拼接右码, 整64 左, 整64 右,
                   向量<IR指令>& 指令, 整64* 寄存器计数, 向量<整64>& 表达式栈) -> 空类型 {
    // 749：转换前形态快照（617 结算判据=数值侧转换产物·提炼后码已规范化）
    布尔 左需转 = 拼接左码 != T_字符串;
    布尔 右需转 = 拼接右码 != T_字符串;
    发射拼接数值转换(左, 拼接左码, 指令, 寄存器计数);
    发射拼接数值转换(右, 拼接右码, 指令, 寄存器计数);
    整64 拼接寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_调用实参, 左, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用实参, 右, 0, 0, 0, 1, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 拼接寄存器, 0,
                         驻留("__cn_str_concat")));
    登记寄存器类型(拼接寄存器, T_字符串);
    // 617（2026-10-14 伞批）：数值侧转换产物（from_int/float/bool/uint——
    //   左/右 已重绑为转换寄存器）仅被本次 concat 消费——发射完成即释放
    //   （宿主 genStringConcatBinary 同构；拼接链中间临时 t1 的归零在
    //    生成二元运算主体 拼接分支按 AST 形态结算）
    如果 (左需转) {
        发射串临时释放(左, 指令, 寄存器计数);
    }
    如果 (右需转) {
        发射串临时释放(右, 指令, 寄存器计数);
    }
    结果<空类型, 整32> 加拼栈 = 表达式栈.追加(拼接寄存器);
    如果 (!加拼栈.正常) { 运行时错误(4); }
}

// 732（2026-10-14）：定义点溯源——寄存器定义指令是否拼接族产物调用
//   （宿主 isConcatResultReg v2 同构·宿主查当前块指令表/本侧查函数指令
//   向量·寄存器号 SSA 单调每函数一表同源）。倒序首条 目标==寄存器 即唯一
//   写入点；from_* 转换临时/变量加载定义符号非拼接=假（from_* 已在 663
//   生成点单收·双收即双释放）。
// 749（2026-10-19）：拼接族 = __cn_str_concat（逐节连接）+ __cn_strbuf_finish
//   （一次性连接链融合产物·749 新发射面）。两者所有权契约同一（001 §10.3
//   新拥有串·调用方接管）——原仅认 concat 致融合链产物在比较位零释放
//   （987 ⑤ `甲+i+"x" == 乙+"y"` 百轮净泄 100 实锤）。
// 2075（用户 2026-11-05 裁决「查询不可判定=显式报错中止·禁止保守跳过释放」·宿主
//   isConcatResultTraced 同刀）：查询恒可判定——倒序扫描找到唯一写入点=
//   按定义符号判定（可判定的否定/肯定回答）；循环走完查无定义=该寄存器
//   号无任何写入指令=编译器内部不一致（v2 一切值含常量皆经指令发射占号·
//   查询输入必有定义），报内部错误后按否定回答返回（IR层诊断计数·主.cn
//   收尾计数>0 中止不产 asm·宿主 #648 显形通道同构）。
不安全 函数 是拼接产物寄存器(整64 寄存器, 向量<IR指令>& 指令) -> 布尔 {
    整64 i = 指令.大小() - 1;
    当 (i >= 0) {
        IR指令 条 = 指令.元素(整32(i));
        如果 (条.目标 == 寄存器) {
            如果 (条.操作码 != IR_调用参数化) { 返回 假; }
            返回 条.附加 == 驻留("__cn_str_concat") ||
                  条.附加 == 驻留("__cn_strbuf_finish");
        }
        i = i - 1;
    }
    IR层诊断("内部错误: 拼接产物查询寄存器无定义点: " + 整数转字符串(寄存器));
    返回 假;
}

// 966（166 立法 v2 同构·用户裁决 2026-10-02）：字符串六比较符 → helper 分派。
//   ==/!=：__cn_str_eq（内容相等·布尔寄存器；!= 在其上与常量 0 等值比较取反）；
//   </<=/>/>=：__cn_str_cmp（字典序 i64）与常量 0 比较。形态对齐 发射字符串拼接
//   （IR_调用实参×2 + IR_调用参数化 + 登记寄存器类型 + 压栈）。
不安全 函数 发射字符串比较(字符串 op名, 整64 左, 整64 右,
                   向量<IR指令>& 指令, 整64* 寄存器计数, 向量<整64>& 表达式栈) -> 空类型 {
    布尔 是不等 = 字符串比较(op名, "!=");
    布尔 是序 = 字符串比较(op名, "<") || 字符串比较(op名, "<=") ||
              字符串比较(op名, ">") || 字符串比较(op名, ">=");
    整64 原始寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_调用实参, 左, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用实参, 右, 0, 0, 0, 1, 0));
    如果 (是序) {
        IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 原始寄存器, 0,
                             驻留("__cn_str_cmp")));
        登记寄存器类型(原始寄存器, T_整64);
        // 758（2026-10-15）：比较位连接产物消费即释——两侧操作数若为拼接产物
        //   寄存器（`甲+乙 < 丙+丁;` 立案形态·宿主 genStringCompareBinary
        //   freeIfConcatTemp 同构）：比较调用为唯一消费者（只读内容），调用后
        //   零引用；645/663/732 面不含比较位两侧=每语句净泄 2（百轮泄 200）。
        //   定义点溯源守卫（是拼接产物寄存器）=变量加载/转换临时天然排除防误伤。
        如果 (是拼接产物寄存器(左, 指令)) { 发射寄存器串释放(左, 指令); }
        如果 (是拼接产物寄存器(右, 指令)) { 发射寄存器串释放(右, 指令); }
        整64 零寄存器 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零寄存器, T_整64, 0));
        整64 序码 = IR_小于;
        如果 (字符串比较(op名, "<=")) { 序码 = IR_小于等于; }
        否则 如果 (字符串比较(op名, ">")) { 序码 = IR_大于; }
        否则 如果 (字符串比较(op名, ">=")) { 序码 = IR_大于等于; }
        整64 结果寄存器 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(序码, 原始寄存器, 零寄存器, 0, 结果寄存器, T_布尔, 0));
        登记寄存器类型(结果寄存器, T_布尔);
        结果<空类型, 整32> 压栈 = 表达式栈.追加(结果寄存器);
        如果 (!压栈.正常) { 运行时错误(4); }
    } 否则 {
        IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 原始寄存器, 0,
                             驻留("__cn_str_eq")));
        登记寄存器类型(原始寄存器, T_布尔);
        // 758：==/!= 面同款收口（同序分支注释·宿主 genStringCompareBinary 同构）
        如果 (是拼接产物寄存器(左, 指令)) { 发射寄存器串释放(左, 指令); }
        如果 (是拼接产物寄存器(右, 指令)) { 发射寄存器串释放(右, 指令); }
        整64 结果寄存器2 = 原始寄存器;
        如果 (是不等) {
            整64 零寄存器2 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零寄存器2, T_整64, 0));
            整64 不等寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_相等, 原始寄存器, 零寄存器2, 0, 不等寄存器, T_布尔, 0));
            登记寄存器类型(不等寄存器, T_布尔);
            结果寄存器2 = 不等寄存器;
        }
        结果<空类型, 整32> 压栈2 = 表达式栈.追加(结果寄存器2);
        如果 (!压栈2.正常) { 运行时错误(4); }
    }
}


// ==================== #1696：方法调用串返回判定（拥有串临时/644 面共用单点） ====================

// 方法调用（被调=节点_成员·对象.方法()）返回字符串的拥有串临时判定。
//   判定两段：①返回类型=字符串（非引用返回·非泛型实例）+ ②**返回表达式形态**
//   拥有性（方法合法返回借用视图：`返回 名;` 字段 / `返回 表.元素(i);` 容器元素 /
//   `返回 局部借用句柄;`——按类型释放借用句柄=源悬垂越界；宿主 #1696 三处扩面于
//   859 JSON 文本() 崩后整体回退之实录=判据面缺口证据）。
//   保守面（宁漏勿崩·1479 同款）：对象类型不可判/方法 miss/返回尾 &（引用返回）/
//   对象类型含 $（泛型/容器实例·T 来源返回=借用）→假。深度=单层对象（标识符）。
不安全 函数 方法调用串返回判定(向量<节点> 池, 节点 被调成员) -> 布尔 {
    整64 对象起位 = 整64(被调成员.子起点);
    如果 (对象起位 <= 0 || 对象起位 >= 整64(池.大小())) { 返回 假; }
    节点 对象节点 = 池.元素(整32(对象起位));
    如果 (对象节点.类型 != 节点_标识符) { 返回 假; }
    整64 对象类ID = 解析标识符类型ID(整64(对象节点.文本));
    // 类字段裸名（方法体内）第一版不支持（查类字段类型在语义包·IR 层网禁
    //   依赖——保守返回 假 宁漏勿崩·1479 同款；变量/自身形态全覆）
    // 静默豁免闭集穷举: 对象类型 ID 守卫（正值=已登记·miss 分流返假 宁漏勿崩）
    如果 (!驻留ID有效(对象类ID)) { 返回 假; }
    字符串 对象类型文本 = 字符串复制(驻留文本(对象类ID));
    如果 (字符串比较(对象类型文本, "自身")) {
        对象类ID = 当前方法类名ID;
    }
    // 泛型/容器实例排除（$ 段存在=T 来源返回=借用·1479 同款）
    如果 (字符串长度(对象类型文本) == 0) { 返回 假; }
    布尔 含段 = 字符串查找(对象类型文本, "$") >= 0;
    如果 (含段) { 返回 假; }
    // 静默豁免上游已诊断: 对象非用户类（变量标量/容器接收者·方法串返=假应答）
    如果 (!是用户类ID(驻留(对象类型文本))) { 返回 假; }
    可选<整64> 返查结果 = 查类方法返回(对象类ID, 整64(被调成员.文本));
    如果 (!返查结果.有值) { 返回 假; }
    字符串 返型文本 = 字符串复制(驻留文本(返查结果.值));
    // 引用返回（尾 &·宿主 isRefReturn 同构）=借用不登记
    整64 长m = 字符串长度(返型文本);
    布尔 有尾引 = 长m > 0;
    如果 (有尾引) {
        如果 ((整64(返型文本[整32(长m - 1)]) & 255) == 38) { 返回 假; }
    }
    // 返回类型=字符串只是必要条件——拥有性按返回表达式形态判定（见族注释）
    布尔 返串型 = 字符串比较(返型文本, "字符串");
    布尔 拥有结果 = 假;
    如果 (返串型) {
        拥有结果 = 方法返回串拥有判定(池, 对象类ID, 整64(被调成员.文本), 4);
    }
    返回 拥有结果;
}

// ==================== #1572：方法返回串「拥有性」按返回表达式形态判定 ====================
// 为什么不能只按返回类型：语义层 retOwnedString 按「返回类型=字符串 ∧ 非引用 ∧
//   非泛型实例」置位，方法返回借用视图时同样置位；按位释放临时=释放借用句柄。
//   自由函数/内置面语义层已拒借用返回（210 负测族：参数/成员/下标/字符*/静态）
//   → 类型判据即拥有判据（被调返回串类型判定）；**方法面**返回形态不受拒（JSON 文本()
//   等借用 API 为既有用法）→ 按返回表达式形态判定（本函数族·宿主
//   callReturnsOwnedStringTemp/stringReturnFormOwned 同构）。
// 判定谱系（拥有=堆串所有权随返回移交调用方）：
//   字面量 -> 拥有（驻留串非 tracked·释放空安全无副作用）；
//   二元 + -> 拥有（连接/拼接产物）；三元 -> 两分支皆拥有才拥有；
//   调用   -> 自由函数/内置=返回类型判据；转移=显式句柄交接=拥有；
//             自身.方法()=递归形态判定；其余接收者=借用面（宿主同收窄：嵌套面
//             两树可判交集仅 自身——接收者为字段/局部时 v2 IR 层无外层函数槽表
//             可查，放宽即分叉）；
//   标识符 -> 本体内同名变量声明且各初值皆拥有才拥有（局部移出）；形参/字段
//             裸名/全局静态命中=借用（写穿别名）；
//   其余（成员读/下标读/解引用等）-> 借用视图。
// 实现取向：布尔两态正常分流（否定=借用面·安全方向「漏放=泄漏非错值」），非
//   「查表 miss 取默认值续译」——形态按 如果/否则如果 互斥穷举 + 布尔累积，未列
//   形态落借用面（与宿主 stringReturnFormOwned switch 穷举同构）。
//   保守面（类/方法节点不可达·递归预算耗尽·无返回语句）=借用（859 口径宁漏勿崩）。
不安全 函数 方法返回串拥有判定(向量<节点> 池, 整64 类名ID, 整64 方法名ID,
                            整64 深度) -> 布尔 {
    // 递归预算按 4,3,2,1,0 递减（0=停止；调用点不产生负值）
    布尔 拥有 = 假;
    如果 (深度 != 0) {
        可选<整64> 方法位查 = 查类方法池位(池, 类名ID, 方法名ID);
        如果 (方法位查.有值) {
            整64 方法位 = 方法位查.值;
            节点 方法节点 = 池.元素(整32(方法位));
            整64 体位 = 整64(方法节点.子终点);
            布尔 体在域 = 体位 >= 1 && 体位 <= 整64(池.大小()) - 1;
            如果 (体在域) {
                节点 体块 = 池.元素(整32(体位));
                布尔 是块 = 体块.类型 == 节点_块;
                整64 命中数 = 0;
                整64 拥有数 = 0;
                如果 (是块) {
                    收集返回拥有判定(池, 整64(体块.子起点), 整64(体块.子终点), 方法位,
                                    类名ID, 深度, &命中数, &拥有数);
                }
                拥有 = 命中数 != 0 && 命中数 == 拥有数;
            }
        }
    }
    返回 拥有;
}

// 体内 返回语句 收集 + 逐条形态判定（语句树全形态：块/如果/当/循环/遍历/选择）
//   ——任一 return 借用即整体按借用处理（多出口方法不得只判首个 return）。
不安全 函数 收集返回拥有判定(向量<节点> 池, 整64 起, 整64 终, 整64 方法位,
                            整64 类名ID, 整64 深度, 整64* 命中, 整64* 拥有) -> 空类型 {
    整64 位 = 起;
    当 (位 < 终 && 位 < 整64(池.大小())) {
        节点 n = 池.元素(整32(位));
        如果 (n.类型 == 节点_返回语句) {
            命中[0] = 命中[0] + 1;
            整64 根位 = 整64(n.子终点) - 1;
            布尔 根在域 = 根位 >= 整64(n.子起点) && 根位 <= 整64(池.大小()) - 1;
            布尔 此条拥有 = 假;
            如果 (根在域) {
                此条拥有 = 返回表达式串拥有判定(池, 根位, 方法位, 类名ID, 深度);
            }
            如果 (此条拥有) { 拥有[0] = 拥有[0] + 1; }
        } 否则 如果 (n.类型 == 节点_块) {
            收集返回拥有判定(池, 整64(n.子起点), 整64(n.子终点), 方法位, 类名ID,
                            深度, 命中, 拥有);
        } 否则 如果 (n.类型 == 节点_如果语句) {
            // 如果：附加=真块索引、子终点=另一分支索引（0=无；节点_如果=否则如果链）
            整64 真块 = 整64(n.附加);
            布尔 真块在域 = 真块 >= 1 && 真块 <= 整64(池.大小()) - 1;
            如果 (真块在域) {
                收集返回拥有判定(池, 真块, 真块 + 1, 方法位, 类名ID, 深度, 命中, 拥有);
            }
            整64 另支位 = 整64(n.子终点);
            布尔 另支在域 = 另支位 >= 1 && 另支位 <= 整64(池.大小()) - 1;
            如果 (另支在域) {
                收集返回拥有判定(池, 另支位, 另支位 + 1, 方法位, 类名ID, 深度, 命中,
                                拥有);
            }
        } 否则 如果 (n.类型 == 节点_当语句 || n.类型 == 节点_循环语句 ||
                      n.类型 == 节点_遍历语句) {
            整64 体块 = 整64(n.附加);
            布尔 体块在域 = 体块 >= 1 && 体块 <= 整64(池.大小()) - 1;
            如果 (体块在域) {
                收集返回拥有判定(池, 体块, 体块 + 1, 方法位, 类名ID, 深度, 命中, 拥有);
            }
        } 否则 如果 (n.类型 == 节点_选择语句) {
            // 选择：子区间=情况标签节点；情况标签 子起点=体块索引
            整64 情位 = 整64(n.子起点);
            当 (情位 < 整64(n.子终点) && 情位 < 整64(池.大小())) {
                节点 情标 = 池.元素(整32(情位));
                整64 体块 = 整64(情标.子起点);
                布尔 是情形 = 情标.类型 == 节点_情况标签;
                布尔 体块在域 = 体块 >= 1 && 体块 <= 整64(池.大小()) - 1;
                如果 (是情形 && 体块在域) {
                    收集返回拥有判定(池, 体块, 体块 + 1, 方法位, 类名ID, 深度, 命中,
                                    拥有);
                }
                情位++;
            }
        }
        位++;
    }
}

// 返回表达式形态 → 拥有性（递归·未列形态/区间不可达=借用）
不安全 函数 返回表达式串拥有判定(向量<节点> 池, 整64 根位, 整64 方法位,
                                整64 类名ID, 整64 深度) -> 布尔 {
    布尔 拥有 = 假;
    布尔 根在域 = 根位 >= 1 && 根位 <= 整64(池.大小()) - 1;
    如果 (根在域) {
        节点 根 = 池.元素(整32(根位));
        整64 根类 = 整64(根.类型);
        如果 (根类 == 整64(节点_字符串字面量)) {
            拥有 = 真;   // 驻留串（非 tracked·释放空安全无副作用）
        } 否则 如果 (根类 == 整64(节点_二元运算)) {
            拥有 = 字符串比较(驻留文本(整64(根.文本)), "+");   // 连接/拼接产物
        } 否则 如果 (根类 == 整64(节点_三元运算)) {
            // 三元：真值段末端=附加-1、假值段末端=子终点-1（池后缀布局惯例）
            整64 真末 = 整64(根.附加) - 1;
            整64 假末 = 整64(根.子终点) - 1;
            布尔 真末在域 = 真末 >= 1 && 真末 <= 整64(池.大小()) - 1;
            布尔 假末在域 = 假末 >= 1 && 假末 <= 整64(池.大小()) - 1;
            如果 (真末在域 && 假末在域) {
                如果 (返回表达式串拥有判定(池, 真末, 方法位, 类名ID, 深度)) {
                    拥有 = 返回表达式串拥有判定(池, 假末, 方法位, 类名ID, 深度);
                }
            }
        } 否则 如果 (根类 == 整64(节点_调用)) {
            整64 被调位 = 整64(根.子起点);
            布尔 被调在域 = 被调位 >= 1 && 被调位 <= 整64(池.大小()) - 1 &&
                            被调位 != 根位;
            如果 (被调在域) {
                节点 被调 = 池.元素(整32(被调位));
                整64 被调类 = 整64(被调.类型);
                如果 (被调类 == 整64(节点_标识符)) {
                    布尔 是转移 = 字符串比较(驻留文本(整64(被调.文本)), "转移");
                    拥有 = 是转移 || 被调返回串类型判定(整64(被调.文本));
                } 否则 如果 (被调类 == 整64(节点_成员)) {
                    拥有 = 嵌套方法返回拥有判定(池, 被调, 类名ID, 深度);
                }
            }
        } 否则 如果 (根类 == 整64(节点_标识符)) {
            拥有 = 局部返回串拥有判定(池, 方法位, 整64(根.文本), 类名ID, 深度);
        }
    }
    返回 拥有;
}

// 嵌套面（返回位又调方法）：仅 自身.方法()（两树可判交集·见族头注释）。
不安全 函数 嵌套方法返回拥有判定(向量<节点> 池, 节点 被调成员, 整64 类名ID,
                                整64 深度) -> 布尔 {
    布尔 拥有 = 假;
    整64 象起 = 整64(被调成员.子起点);
    布尔 象在域 = 象起 >= 1 && 象起 <= 整64(池.大小()) - 1;
    如果 (象在域) {
        节点 象 = 池.元素(整32(象起));
        布尔 是自身 = 象.类型 == 节点_标识符 &&
                      字符串比较(驻留文本(整64(象.文本)), "自身");
        如果 (是自身) {
            拥有 = 方法返回串拥有判定(池, 类名ID, 整64(被调成员.文本), 深度 - 1);
        }
    }
    返回 拥有;
}

// 标识符返回拥有性：lambda 捕获名（无同名局部遮蔽）=拥有副本（1571 返回位复制）；
//   形参=借用；本体内同名变量声明且各初值皆拥有=局部移出；
//   无命中（字段裸名/全局静态/未声明）=借用。
不安全 函数 局部返回串拥有判定(向量<节点> 池, 整64 方法位, 整64 名ID,
                              整64 类名ID, 整64 深度) -> 布尔 {
    节点 方法节点 = 池.元素(整32(方法位));
    整64 体位 = 整64(方法节点.子终点);
    布尔 体在域 = 体位 >= 1 && 体位 <= 整64(池.大小()) - 1;
    // 形参区间 [方法节点.子起点, 体块.子起点)（函数参数串 同款区间规则）
    整64 参终 = 体位;
    如果 (体在域) {
        节点 体块参 = 池.元素(整32(体位));
        参终 = 整64(体块参.子起点);
    }
    向量<整64> 初值根们 = 向量<整64>();
    如果 (体在域) {
        节点 体块初 = 池.元素(整32(体位));
        收集同名声明初值(池, 整64(体块初.子起点), 整64(体块初.子终点), 名ID,
                        初值根们);
    }
    // #1578：lambda 捕获名=返回位自动复制成拥有副本（1571 发射返回尾段同点·
    //   值捕获/引用捕获同判）——**无同名局部声明遮蔽**时方能作数（体内重声明
    //   同名变量=返回的是该局部，按下方局部移出判据处置）。捕获名单按合成
    //   函数名 ID 查（非 lambda 函数该方法名 ID 天然 miss → 计数 0 跳过）。
    如果 (初值根们.大小() == 0) {
        整64 lambda名捕 = 整64(方法节点.文本);
        结果<整64, 整32> 捕起查 = lambda捕获起们.获取(lambda名捕);
        结果<整64, 整32> 捕数查 = lambda捕获计数们.获取(lambda名捕);
        整64 捕起 = 0;
        整64 捕数 = 0;
        如果 (捕起查.正常) { 捕起 = 捕起查.值; }
        如果 (捕数查.正常) { 捕数 = 捕数查.值; }
        整64 捕i = 捕起;
        当 (捕i < 捕起 + 捕数 && 捕i < 整64(lambda捕获名序们.大小())) {
            如果 (lambda捕获名序们.元素(整32(捕i)) == 名ID) { 返回 真; }
            捕i++;
        }
    }
    布尔 是形参 = 假;
    整64 参位 = 整64(方法节点.子起点);
    当 (参位 < 参终 && 参位 < 整64(池.大小())) {
        节点 参 = 池.元素(整32(参位));
        如果 (参.类型 == 节点_参数 && 整64(参.文本) == 名ID) { 是形参 = 真; }
        参位++;
    }
    布尔 初值皆拥有 = 初值根们.大小() != 0;
    整64 i = 0;
    当 (i < 初值根们.大小()) {
        布尔 此初拥有 = 返回表达式串拥有判定(池, 初值根们.元素(整32(i)), 方法位,
                                           类名ID, 深度 - 1);
        如果 (!此初拥有) { 初值皆拥有 = 假; }
        i++;
    }
    返回 !是形参 && 初值皆拥有;
}

// 体内同名变量声明初值根位收集（语句树全形态·任意嵌套深度）
不安全 函数 收集同名声明初值(向量<节点> 池, 整64 起, 整64 终, 整64 名ID,
                            向量<整64>& 初值根们) -> 空类型 {
    整64 位 = 起;
    当 (位 < 终 && 位 < 整64(池.大小())) {
        节点 n = 池.元素(整32(位));
        如果 (n.类型 == 节点_变量声明) {
            布尔 初值在域 = 整64(n.文本) == 名ID && n.子起点 < n.子终点 &&
                            整64(n.子终点) <= 整64(池.大小());
            如果 (初值在域) {
                结果<空类型, 整32> 加初 = 初值根们.追加(整64(n.子终点) - 1);
                如果 (!加初.正常) { 运行时错误(4); }
            }
        } 否则 如果 (n.类型 == 节点_块) {
            收集同名声明初值(池, 整64(n.子起点), 整64(n.子终点), 名ID, 初值根们);
        } 否则 如果 (n.类型 == 节点_如果语句) {
            整64 真块 = 整64(n.附加);
            布尔 真块在域 = 真块 >= 1 && 真块 <= 整64(池.大小()) - 1;
            如果 (真块在域) {
                收集同名声明初值(池, 真块, 真块 + 1, 名ID, 初值根们);
            }
            整64 另支位 = 整64(n.子终点);
            布尔 另支在域 = 另支位 >= 1 && 另支位 <= 整64(池.大小()) - 1;
            如果 (另支在域) {
                收集同名声明初值(池, 另支位, 另支位 + 1, 名ID, 初值根们);
            }
        } 否则 如果 (n.类型 == 节点_当语句 || n.类型 == 节点_循环语句 ||
                      n.类型 == 节点_遍历语句) {
            整64 体块 = 整64(n.附加);
            布尔 体块在域 = 体块 >= 1 && 体块 <= 整64(池.大小()) - 1;
            如果 (体块在域) {
                收集同名声明初值(池, 体块, 体块 + 1, 名ID, 初值根们);
            }
        }
        位++;
    }
}

// 类方法节点池索引（沿基链至多 64 层；类节点区间=[子起点,子终点)=类体，
//   节点_方法 文本=方法名ID）——返回 可选<整64>（无值=链上无此方法）。
函数 查类方法池位(向量<节点> 池, 整64 类名ID, 整64 方法名ID) -> 可选<整64> {
    整64 当前 = 类名ID;
    整64 守卫 = 0;
    当 (当前 != 0 && 守卫 < 64) {
        可选<整64> 类位查 = 查类池索引(当前);
        如果 (类位查.有值) {
            整64 类位 = 类位查.值;
            布尔 类位在域 = 类位 >= 1 && 类位 <= 整64(池.大小()) - 1;
            如果 (类位在域) {
                节点 类节点 = 池.元素(整32(类位));
                整64 位 = 整64(类节点.子起点);
                当 (位 < 整64(类节点.子终点) && 位 < 整64(池.大小())) {
                    节点 成员 = 池.元素(整32(位));
                    布尔 命中 = 成员.类型 == 节点_方法 && 整64(成员.文本) == 方法名ID;
                    如果 (命中) { 返回 某些(位); }
                    位++;
                }
            }
        }
        可选<整64> 基查 = 查类基名(当前);
        如果 (!基查.有值) { 中断; }
        如果 (基查.有值) { 当前 = 基查.值; }
        守卫++;
    }
    返回 无;
}

// #1700 守卫辅助（闭集边界单点·分支词面收纳）——驻留 ID 有效性（键域从 1 起）
函数 驻留ID有效(整64 标识ID) -> 布尔 {
    返回 标识ID > 0;
}
