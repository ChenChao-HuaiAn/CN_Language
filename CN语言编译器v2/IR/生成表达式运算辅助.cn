// CN 自举编译器 v2 · 二元发射辅助判定（481 行数解堵轮·2026-10-12）
// 职责：生成表达式运算.cn 的二元发射辅助判定族——①嵌套窄码回溯（481 新增·
//   B 案收口）；②字符串拼接判定（215-a 自 运算.cn 纯迁入·逐字节零语义）；
//   ③浮点混合转换（91-a/92-a 自 运算.cn 纯迁入·逐字节零语义）；
//   ④字符串拼接/比较发射族（663 自 运算.cn 纯迁入·逐字节零语义——拼接侧128
//   截断/发射寄存器串释放/发射字符串拼接/发射字符串比较·含 663 转换临时
//   消费即释收口）。
// 迁移缘由：生成表达式运算.cn 已 996 行（900 警戒线上·1000 冻结线差 4 行），
//   481 修改须「先拆再加」（474 轮 溢出474 迁移同款先例）——纯移动腾余量；
//   663 轮该文件触 976 行（900 警戒线上）再迁——644 ir_call_args.cpp 纯搬移
//   同款先例。
公开:   // 全文件公开（子模块符号供包内兄弟模块 经合并全局池解析·生成表达式运算 消费）

不安全 函数 嵌套窄码回溯481(整64 源码377, 整64 登记码481) -> 整64 {
    // 481（字面量面偏差·2026-10-12 用户裁决 B 案收口·001 §3.7a）：嵌套表达式
    //   窄码回溯——内层二元若经 377 乙案窄化（尾部登记寄存器窄码），外层二元
    //   的该侧须按窄码参与（宿主语义层 285 按**表达式类型**推导同构——
    //   `甲 + 1 + 30000` 内层=整16 窄域 → 外层字面量 30000 按整16 参与 →
    //   60001 溢出须报错误码8；修前外层左末端（n.附加=右起点-1=左子树末节点）
    //   落在内层二元上 → 解析节点类型ID 落宽默认 → 宽域 60001 漏报·宿主 v2
    //   分叉实证 y1/y2/x2 探针）。显式转换形态不受影响：整64(甲) 寄存器登记
    //   码=T_整64 非窄族 → 不回溯（混合宽度提升较宽侧条文零波及）。
//   空间纪律：返回值=**类型名 ID**（驻留("整16") 族·与 解析节点类型ID 同
//   空间·是窄X377 按名 ID 比较）；查寄存器类型 可选值=**类型码**（T_整16 族·
//   1360 批5 结果化）——反向映射后返回（对照 生成表达式运算 377 尾部名字ID→
//   类型码 正向映射）。
    如果 (源码377 == 驻留("整8") || 源码377 == 驻留("整16") ||
         源码377 == 驻留("正8") || 源码377 == 驻留("正16")) { 返回 源码377; }
    如果 (登记码481 == T_整8) { 返回 驻留("整8"); }
    如果 (登记码481 == T_整16) { 返回 驻留("整16"); }
    如果 (登记码481 == T_正8) { 返回 驻留("正8"); }
    如果 (登记码481 == T_正16) { 返回 驻留("正16"); }
    返回 源码377;
}

// T48 轮（505 双编译对照捕获·机制级）：类型码() 把 字符 归并 T_整64
//   （IR容器.cn 映射——字符打印/算术按数值消费=宿主对齐不变），寄存器登记层
//   字符信息丢失 → 拼接转换误走 from_int 打码点十进制（22909）。字符的拼接
//   语义=字符转字符串（规范 02「字符串 + 数值 隐式拼接」行）——按末端类型名 ID
//   复核复位（仅拼接分派消费 T_字符·零波及打印/算术/实参分派）；未登记（0）
//   照旧兜底推导。
// 749（2026-10-19·事不过三提炼）：复核判据单点化——消费面=普通拼接判定左右
//   两处 + 连接链融合段码一处（原第三处只判 0 漏 T_整64 字符归并面：937 ②b
//   `"b="+真+"|c="+字+"|u="+正值` 融合链把 'A' 打成 65，与宿主 from_char 分叉）。
函数 复核拼接码(向量<节点> 池, 整64 末端位置, 整64 码) -> 整64 {
    如果 (码 == 0 || 码 == T_整64) {
        返回 推导末端拼接码(池, 整32(末端位置), 码);
    }
    返回 码;
}

// 215-a：族① 拼接判定（③ 第一波：字符串拼接 + 双侧隐式转换——寄存器类型登记表
//   判定 + 末端节点推导兜底）。3 项引用输出：拼接加/拼接左码/拼接右码。
不安全 函数 判定字符串拼接(向量<节点> 池, 节点 n, 字符串 op名, 整32 位置,
                     向量<整64>& 表达式栈, 布尔& 拼接加, 整64& 拼接左码, 整64& 拼接右码) -> 空类型 {
    如果 (字符串比较(op名, "+") && 表达式栈.大小() >= 2) {
        整64 栈右 = 表达式栈.元素(表达式栈.大小() - 1);
        整64 栈左 = 表达式栈.元素(表达式栈.大小() - 2);
        // 1360 批5：未登记=类型未知（T_未知 兜底·既有业务语义：交复核拼接码推导）
        拼接左码 = 查寄存器类型或未知(栈左);
        拼接右码 = 查寄存器类型或未知(栈右);
        // T48 字符归并面复核（判据与注释见 复核拼接码 单点）
        拼接左码 = 复核拼接码(池, 整64(n.附加) - 1, 拼接左码);
        拼接右码 = 复核拼接码(池, 整64(位置) - 1, 拼接右码);
        如果 (拼接左码 == T_字符串 || 拼接右码 == T_字符串) {
            拼接加 = 真;
        }
    }
}

// 215-a：族② 浮点混合转换（91-a：浮64+整 自动宽化·92-a 单侧浮32 升 f64 禁止隐式
//   窄化·统一按操作数码≠公共浮码插入转换）。左右寄存器引用输出（转换后更新）。
不安全 函数 浮点混合转换(整64 op, 整64& 左, 整64& 右, 向量<IR指令>& 指令, 整64* 寄存器计数) -> 空类型 {
    // 1360 批5：未登记=类型未知（T_未知 兜底·既有业务语义：按非浮点源）
    整64 左码浮 = 查寄存器类型或未知(左);
    整64 右码浮 = 查寄存器类型或未知(右);
    布尔 是浮点左 = (左码浮 == T_浮32 || 左码浮 == T_浮64);
    布尔 是浮点右 = (右码浮 == T_浮32 || 右码浮 == T_浮64);
    布尔 是算比 = (op == IR_加 || op == IR_减 || op == IR_乘 || op == IR_除 ||
                  op == IR_相等 || op == IR_不等 || op == IR_小于 ||
                  op == IR_大于 || op == IR_小于等于 || op == IR_大于等于);
    如果 ((是浮点左 || 是浮点右) && 是算比) {
        整64 浮码 = T_浮64;
        如果 (是浮点左 && !是浮点右) { 浮码 = 左码浮; }
        否则 如果 (是浮点右 && !是浮点左) { 浮码 = 右码浮; }
        否则 如果 (左码浮 == T_浮32 && 右码浮 == T_浮32) { 浮码 = T_浮32; }
        // 92-a（2026-09-13 第九十二轮）：单侧浮点为浮32、另一侧为整型 → 升 f64
        //   （禁止隐式窄化——整型转 浮32 有损，规范「仅允许无损或宽化转换」；
        //   对齐宿主「整 + 浮 → f64」与 92-a 宿主侧修复）。原「单侧浮点取该侧」
        //   在浮32 时把整型操作数窄化到 f32：实证 甲(浮32)+16777217 宿主
        //   16777218.5 / v2 前值 16777218.0（双侧分叉）。
        如果 ((是浮点左 && !是浮点右 && 左码浮 == T_浮32) ||
            (是浮点右 && !是浮点左 && 右码浮 == T_浮32)) { 浮码 = T_浮64; }
        // 92-a：统一按「操作数码 ≠ 公共浮码」插入转换（原判定仅 非浮点侧 转换
        //   ——浮码为 f64 时已是浮点的 浮32 侧被漏掉：f32 位模式直进 xmm 双精度
        //   运算/比较（f32+f64 双侧浮点形态原有同款漏网，本轮一并根治）。
        如果 (左码浮 != 浮码) {
            左 = 插入值转换(左, 浮码, 指令, 寄存器计数);
            左码浮 = 浮码;
            是浮点左 = 真;
        }
        如果 (右码浮 != 浮码) {
            右 = 插入值转换(右, 浮码, 指令, 寄存器计数);
            右码浮 = 浮码;
            是浮点右 = 真;
        }
    }
}

// ==================== 617（2026-10-14 伞批）：拥有串临时判定与结算 ====================

// 617（宿主 argIsOwnedStringTemp 同构）：表达式根节点是否「拥有型字符串临时」
//   ——内置分配族/数字转换族/格式化调用产物（堆串）、用户函数返回字符串产物
//   （返回=所有权移交调用方·查 函数返回类型们）或字符串拼接表达式（+ 产物=
//   连接产物堆串）。标识符（调用方变量自有 RAII）/字面量（只读段 free 即崩）/
//   驻留 等借用视图调用不命中。打印族/消费族实参临时结算与拼接链中间临时
//   归零共用判据（调用完成后调用方释放）。
不安全 函数 拥有串临时形态(向量<节点> 池, 节点 根617) -> 布尔 {
    如果 (根617.类型 == 节点_二元运算) {
        返回 字符串比较(字符串复制(驻留文本(整64(根617.文本))), "+");
    }
    // 662（617 三元面补全·宿主 argIsOwnedStringTemp 三元递归同构）：三元结果
    //   「潜在拥有」——任一分支命中即登记，释放侧经 发射串临时释放递归617
    //   按选中分支条件释放（选中字面量/标识符借用分支无条件 free=只读段崩）；
    //   两分支皆借用不命中。分支根=子区间末端-1（池后缀布局末端=根——生成
    //   表达式尾.cn 同款惯例）；区间非法=内部结构异常（miss 不可静默）。
    如果 (根617.类型 == 节点_三元运算) {
        如果 (根617.文本 > 0 && 根617.附加 > 根617.文本 &&
            根617.子终点 > 根617.附加 && 根617.子终点 <= 整64(池.大小())) {
            如果 (拥有串临时形态(池, 池.元素(整32(整64(根617.附加) - 1)))) {
                返回 真;
            }
            返回 拥有串临时形态(池, 池.元素(整32(整64(根617.子终点) - 1)));
        }
        运行时错误(4);
    }
    如果 (根617.类型 == 节点_调用 && 根617.子起点 > 0) {
        节点 被调617 = 池.元素(整32(根617.子起点));
        如果 (被调617.类型 != 节点_标识符) { 返回 假; }
        字符串 名617 = 字符串复制(驻留文本(整64(被调617.文本)));
        // 905（2026-10-18·与 644 段同判据·644-c 判定面同族根治）：内置返回
        //   字符串判定=权威表 内置函数返回类型ID（828-a 两级直查+归一基名）——
        //   原 14 项硬编码白名单漏 字符串构建器::完成/IO::读取行/文件::读取
        //   文件行/时间::格式化时间（905 探针形态G：打印行(字符串构建器::完成
        //   (乙)) v2 残留 1 vs 宿主 0）。宿主 argIsOwnedStringTemp retCanon 链同判。
        可选<整64> 内置返查617 = 内置函数返回类型ID(名617);
        布尔 内置返串617 = 假;
        如果 (内置返查617.有值) { 内置返串617 = 内置返查617.值 == 驻留("字符串"); }
        如果 (内置返串617) { 返回 真; }
        // 617 对齐补（接棒审查 2026-10-14）：用户函数返回字符串临时——内置
        //   面 miss 后查 函数返回类型们（查函数返回回退 键基回退链·
        //   IR生成中 收集先于全部生成），宿主 funcReturnTypeOf 同构（原 v2
        //   白名单缺用户函数面：打印(造串()) 形态 v2 残留 1/宿主 0=分叉）。
        //   引用返回（尾 & 原文≠"字符串"）与空类型/数值返回天然不命中。
        // 1541 B2：无值=返回类型未知（原 0 判据等价·非字符串不命中）
        可选<整64> 返查617 = 查函数返回回退(整64(被调617.文本));
        布尔 返串617 = 假;
        如果 (返查617.有值) { 返串617 = 返查617.值 == 驻留("字符串"); }
        返回 返串617;
    }
    返回 假;
}

// 617：打印族/内置消费族被调判定（只读消费实参·结算白名单）——驻留（表可能
//   持指针视图）与用户函数（收下句柄面·与宿主一致呈报）不入集合。
不安全 函数 只读消费被调617(字符串 被调名617) -> 布尔 {
    字符串 归一名617 = 内置归一基名(被调名617);
    返回 字符串比较(归一名617, "打印") || 字符串比较(归一名617, "打印行") ||
         字符串比较(被调名617, "字符串长度") || 字符串比较(被调名617, "字符串比较") ||
         字符串比较(被调名617, "字符串字典序") || 字符串比较(被调名617, "字符串查找") ||
         字符串比较(被调名617, "字符串包含") || 字符串比较(被调名617, "字符串前缀") ||
         字符串比较(被调名617, "字符串后缀") || 字符串比较(被调名617, "字符串复制") ||
         字符串比较(被调名617, "字符串连接") || 字符串比较(被调名617, "字符串子串") ||
         字符串比较(被调名617, "字符串大写") || 字符串比较(被调名617, "字符串小写") ||
         字符串比较(被调名617, "字符串修剪") || 字符串比较(被调名617, "字符串反转") ||
         字符串比较(被调名617, "格式化");
}

// 617：释放拥有串临时寄存器（free 直调·寄存器句柄无槽无清零义务）
不安全 函数 发射串临时释放617(整64 寄存器617, 向量<IR指令>& 指令, 整64* 寄存器计数) -> 空类型 {
    IR追加(指令, 建IR指令(IR_调用实参, 寄存器617, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0, 驻留("__cn_str_free")));
}

// ==================== 662（617 三元面补全）：三元临时条件释放设施 ====================
// 宿主 emitOwnedTempReleaseRec617 同构：三元实参的拥有性运行时才定（惰性求值·
//   选中分支产堆）——按编译期两分支形态判定 + 条件跳转保证只释放真正产堆的
//   一方（选中字面量/标识符借用分支 free=只读段崩）。嵌套三元逐层递归展开
//   （「无块计数上下文残余」清偿：块计数上下文随调用链穿透至拼接/打印/消费族/
//   语句位全部结算点）。登记表按三元根节点池位索引、倒序查（后登记先命中——
//   池位跨文件复用安全：结算即时发生于本文件编译期，后续文件同池位覆盖不影响
//   已结算项）。递归释放的池位参数=三元根节点池位（初始调用=消费点已知根位；
//   内层递归=分支根池位 附加-1/子终点-1）。

静态 向量<整64> 三元串临时位们;
静态 向量<整64> 三元串临时条件们;

// 662：三元实参寄存器登记（644 传参位扩展）——三元实参「潜在拥有」在 生成调用
//   644 段登记（寄存器+池位配对·宿主 pendingArgCleanups_ 三元项同构），外层
//   调用发射后 清理调用实参临时 按寄存器倒序查、条件释放（选中借用分支不得
//   free）。消费族结算命中同项时同步删除（释放权单点·防双释放）。
静态 向量<整64> 三元实参寄存器们;
静态 向量<整64> 三元实参池位们;

不安全 函数 三元实参登记662(整64 寄存器c, 整64 池位c) -> 空类型 {
    结果<空类型, 整32> 加r662 = 三元实参寄存器们.追加(寄存器c);
    如果 (!加r662.正常) { 运行时错误(4); }
    加r662 = 三元实参池位们.追加(池位c);
    如果 (!加r662.正常) { 运行时错误(4); }
}

// 662：三元实参登记删除（寄存器键·倒序命中即删；消费族结算与 清理调用实参
//   临时 双侧命中面共用——释放权单点：命中者释放并删除，防双释放）。
不安全 函数 三元实参删除662(整64 寄存器c) -> 布尔 {
    整64 删k662 = 三元实参寄存器们.大小();
    当 (删k662 > 0) {
        删k662--;
        如果 (三元实参寄存器们.元素(删k662) == 寄存器c) {
            结果<空类型, 整32> 删r662 = 三元实参寄存器们.删除(删k662);
            如果 (!删r662.正常) { 运行时错误(4); }
            删r662 = 三元实参池位们.删除(删k662);
            如果 (!删r662.正常) { 运行时错误(4); }
            返回 真;
        }
    }
    返回 假;
}

// 662：三元实参查发（寄存器键·倒序查）——命中返回池位（写引用输出）、未命中
//   池位=0。结算点分流判定用。
不安全 函数 三元实参查位662(整64 寄存器c, 整64& 池位出) -> 布尔 {
    整64 查k662 = 三元实参寄存器们.大小();
    当 (查k662 > 0) {
        查k662--;
        如果 (三元实参寄存器们.元素(查k662) == 寄存器c) {
            池位出 = 三元实参池位们.元素(查k662);
            返回 真;
        }
    }
    返回 假;
}

// 662：三元串临时登记（生成三元运算 汇合后调用）——真/假分支拥有性编译期
//   判定（分支根=子区间末端-1）；两分支皆非拥有=不登记（无堆产物无需结算）。
//   区间非法=内部结构异常终态（miss 不可静默·648 立法）——运行时错误显形。
不安全 函数 三元串临时登记662(向量<节点> 池, 整64 池位c, 整64 条件c) -> 空类型 {
    如果 (池位c <= 0 || 池位c >= 整64(池.大小())) { 运行时错误(4); }
    节点 n662 = 池.元素(整32(池位c));
    如果 (n662.类型 != 节点_三元运算) { 运行时错误(4); }
    整64 真终662 = 整64(n662.附加);
    整64 假终662 = 整64(n662.子终点);
    如果 (真终662 <= 1 || 假终662 <= 真终662 || 假终662 > 整64(池.大小())) {
        运行时错误(4);
    }
    布尔 真有662 = 拥有串临时形态(池, 池.元素(整32(真终662 - 1)));
    布尔 假有662 = 拥有串临时形态(池, 池.元素(整32(假终662 - 1)));
    如果 (真有662 || 假有662) {
        结果<空类型, 整32> 加位662 = 三元串临时位们.追加(池位c);
        如果 (!加位662.正常) { 运行时错误(4); }
        加位662 = 三元串临时条件们.追加(条件c);
        如果 (!加位662.正常) { 运行时错误(4); }
    }
}

// 662：递归条件释放（宿主 emitOwnedTempReleaseRec617 同构）——非三元：判据
//   命中即无条件释放；三元：两分支皆「直接拥有」（非嵌套三元且判据命中）时
//   结果必为堆串=无条件 free（快径）；否则查条件寄存器、条件跳转分块（真块
//   递归释放真分支、假块递归释放假分支——选中分支的最终值即消费点值寄存器）。
//   查表 miss=生成器内部缺陷（登记点漏位）——运行时错误显形不静默（648 立法）。
不安全 函数 发射串临时释放递归662(向量<节点> 池, 整64 池位c, 整64 值寄存器,
                    向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数) -> 空类型 {
    如果 (池位c <= 0 || 池位c >= 整64(池.大小())) { 运行时错误(4); }
    节点 根662 = 池.元素(整32(池位c));
    如果 (根662.类型 != 节点_三元运算) {
        如果 (拥有串临时形态(池, 根662)) {
            发射串临时释放617(值寄存器, 指令, 寄存器计数);
        }
        返回;
    }
    整64 真终662 = 整64(根662.附加);
    整64 假终662 = 整64(根662.子终点);
    如果 (真终662 <= 1 || 假终662 <= 真终662 || 假终662 > 整64(池.大小())) {
        运行时错误(4);
    }
    节点 真分支662 = 池.元素(整32(真终662 - 1));
    节点 假分支662 = 池.元素(整32(假终662 - 1));
    布尔 真有662 = 拥有串临时形态(池, 真分支662);
    布尔 假有662 = 拥有串临时形态(池, 假分支662);
    如果 (!真有662 && !假有662) { 返回; }
    如果 (真有662 && 假有662 &&
        真分支662.类型 != 节点_三元运算 && 假分支662.类型 != 节点_三元运算) {
        发射串临时释放617(值寄存器, 指令, 寄存器计数);
        返回;
    }
    整64 条件r662 = 0; 布尔 命中662 = 假;
    整64 查k662 = 三元串临时位们.大小();
    当 (查k662 > 0) {
        查k662--;
        如果 (三元串临时位们.元素(查k662) == 池位c) {
            条件r662 = 三元串临时条件们.元素(查k662);
            命中662 = 真;
            中断;
        }
    }
    如果 (!命中662) { 运行时错误(4); }   // miss 不可静默：登记点漏位=内部缺陷
    整64 真块662 = 块计数[0] + 1;
    整64 假块662 = 块计数[0] + 2;
    整64 结束块662 = 块计数[0] + 3;
    块计数[0] = 块计数[0] + 3;
    IR追加(指令, 建IR指令(IR_条件跳转, 条件r662, 真块662, 假块662, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 真块662));
    发射串临时释放递归662(池, 真终662 - 1, 值寄存器, 指令, 寄存器计数, 块计数);
    IR追加(指令, 建IR指令(IR_跳转, 0, 0, 0, 0, 0, 结束块662));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 假块662));
    发射串临时释放递归662(池, 假终662 - 1, 值寄存器, 指令, 寄存器计数, 块计数);
    IR追加(指令, 建IR指令(IR_跳转, 0, 0, 0, 0, 0, 结束块662));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 结束块662));
}

// ==================== 102 甲案：消耗形参判定（616 伞批自 生成函数.cn 机械搬移腾行·零语义） ====================

// 102 甲案（2026-09-29 用户裁决·〔基准=019〕）：字符串值形参**消耗判定**——函数体
//   块子区间线性扫描（嵌套块/条件体语句节点均含于体块子区间——节点池顺序追加·
//   与 预扫容器声明 同源口径）。命中两形态之一即消耗：
//   ① 节点_赋值.文本==形参名ID（标识符左值赋值——生成赋值语句 契约：文本=左值名）；
//   ② 转移(形参名)/字符串释放(形参名) 单实参调用（被调名=调用子区间首子节点）。
//   消耗形参由 生成函数 入口深拷独立副本（090 丙案「默认=值副本」兑现）；非消耗
//   直传零拷贝（第四句拷贝消除：字符串无原地写·只读借用别名不可观察）。
不安全 函数 形参被消耗(向量<节点> 池, 整32 块节点, 整64 名ID) -> 布尔 {
    如果 (块节点 < 0 || 块节点 >= 池.大小()) { 返回 假; }
    节点 块 = 池.元素(块节点);
    整64 i = 整64(块.子起点);
    当 (i < 整64(块.子终点)) {
        节点 n = 池.元素(整32(i));
        如果 (n.类型 == 节点_赋值 && 整64(n.文本) == 名ID) { 返回 真; }
        // 616 修正：表达式位调用节点 子终点未填（恒 0·探针 617dbg 同源实锤）——
        //   原判「子终点-子起点==2」恒假=字符串释放(形参) 不触发消耗标记→
        //   借用直传下被调 free 调用方串（探针残留 -1 实锤）。单实参判定改
        //   附加==1（协议：节点_调用.附加=实参数）。
        如果 (n.类型 == 节点_调用 && n.附加 == 1 && n.子起点 > 0 &&
             n.子起点 + 1 < 整64(池.大小())) {
            节点 被调 = 池.元素(整32(n.子起点));
            节点 首实参 = 池.元素(整32(n.子起点 + 1));
            如果 (被调.类型 == 节点_标识符 && 首实参.类型 == 节点_标识符 &&
                 整64(首实参.文本) == 名ID) {
                整64 被调名 = 整64(被调.文本);
                如果 (被调名 == 驻留("转移") || 被调名 == 驻留("字符串释放")) {
                    返回 真;
                }
            }
        }
        i++;
    }
    返回 假;
}

// ==================== 663 重放迁入族：字符串拼接/比较发射（自 生成表达式运算.cn 迁入·行数纪律 137 行纯搬移同款载体） ====================

// 418（002 收口杂项正测族·宿主 genStringConcatI128 同构）：拼接数值侧 128 位
//   值=16 字节槽基址句柄（寄存器存**地址**）——直传 __cn_str_from_int（单 i64
//   形参）=ABI 错位垃圾（17_audit 双编译对照实证 1234567890123 印
//   947300333944/574347015776·值随上下文漂移=读邻槽特征）。先 指针加载 解句柄
//   取低 64 位（810 显式转换 128→窄 同款发射·值域≤2^63 语义正确·宿主注释
//   「整128 截断 i64」同款），码同步 T_整64 走 from_int。
不安全 函数 拼接侧128截断(整64& 值, 整64& 码, 向量<IR指令>& 指令, 整64* 寄存器计数) -> 空类型 {
    如果 (码 == T_整128 || 码 == T_正128) {
        整64 低半 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_指针加载, 值, 0, 0, 低半, T_整64, 0));
        登记寄存器类型(低半, T_整64);
        值 = 低半;
        码 = T_整64;
    }
}

// 663（2026-10-14）：裸寄存器拥有串释放直调公共发射点（事不过三提炼——发射
//   字符串拼接 左右转换临时与 发射语句位弃串释放〔生成语句辅助〕共用；字段/
//   数组形态释放面=IR容器释放 各专函数不在此列）。
不安全 函数 发射寄存器串释放(整64 寄存器, 向量<IR指令>& 指令) -> 空类型 {
    IR追加(指令, 建IR指令(IR_调用实参, 寄存器, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0, 驻留("__cn_str_free")));
}

// 字符串拼接发射：数值侧隐式转换（from_int/from_float/from_bool，宿主 Task 2.9——
//   未登记类型按整数兜底）+ __cn_str_concat 裸 ASCII 直调（实参位 0/1，产物登记
//   T_字符串——链式外层判定用）。
// 663 重放核注（rebase 融合留痕）：develop 617 已收「数值侧转换产物 concat 后
//   即释」同域面（判据=拼接码≠字符串；663 原版=转换寄存器记录判据·二者在函数
//   内严格等价——数值分支执行⟺码≠字符串⟺转换寄存器≠0，释放对象同一=from_*
//   产物寄存器，发射逐指令一致）——取 617 版防同面双 free；663 的公共发射点
//   发射寄存器串释放 照常保留（语句位弃串释放/732/758 面共用）。
// 2026-10-19（749）：拼接数值侧 -> 字符串转换单点入口（事不过三提炼——
//   发射字符串拼接 左/右两处 + 连接链融合段一处共用）。逐指令语义与 663 原位
//   一致：92-a 浮32 先宽化 f64（__cn_str_from_float 形参为 double）；418 128 位
//   句柄先解引用取低 64 位；按转换前码查 转换符号（from_int/uint/float/char/bool）。
//   完成后 码 置 T_字符串、值 重绑为转换产物寄存器（调用方以布尔记录转换前形态）。
不安全 函数 发射拼接数值转换(整64& 值, 整64& 码, 向量<IR指令>& 指令,
                      整64* 寄存器计数) -> 空类型 {
    如果 (码 == T_字符串) { 返回; }
    // 92-a：浮32 数值侧先宽化 f64（同左侧）
    如果 (码 == T_浮32) {
        值 = 插入值转换(值, T_浮64, 指令, 寄存器计数);
        码 = T_浮64;
    }
    // 418：128 位句柄先解引用取低 64 位（红A 根治·见 拼接侧128截断 注释）
    拼接侧128截断(值, 码, 指令, 寄存器计数);
    整64 转 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    // 91-a：实参类型码=数值侧码（浮点走 xmm0——__cn_str_from_float(double)）
    IR追加(指令, 建IR指令(IR_调用实参, 值, 码, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 转, 0,
                         驻留(转换符号(码))));
    登记寄存器类型(转, T_字符串);
    值 = 转;
    码 = T_字符串;
}

不安全 函数 发射字符串拼接(整64 拼接左码, 整64 拼接右码, 整64 左, 整64 右,
                   向量<IR指令>& 指令, 整64* 寄存器计数, 向量<整64>& 表达式栈) -> 空类型 {
    // 749：转换前形态快照（617 结算判据=数值侧转换产物·提炼后码已规范化）
    布尔 左需转 = 拼接左码 != T_字符串;
    布尔 右需转 = 拼接右码 != T_字符串;
    发射拼接数值转换(左, 拼接左码, 指令, 寄存器计数);
    发射拼接数值转换(右, 拼接右码, 指令, 寄存器计数);
    整64 拼接寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_调用实参, 左, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用实参, 右, 0, 0, 0, 1, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 拼接寄存器, 0,
                         驻留("__cn_str_concat")));
    登记寄存器类型(拼接寄存器, T_字符串);
    // 617（2026-10-14 伞批）：数值侧转换产物（from_int/float/bool/uint——
    //   左/右 已重绑为转换寄存器）仅被本次 concat 消费——发射完成即释放
    //   （宿主 genStringConcatBinary 同构；拼接链中间临时 t1 的归零在
    //    生成二元运算主体 拼接分支按 AST 形态结算）
    如果 (左需转) {
        发射串临时释放617(左, 指令, 寄存器计数);
    }
    如果 (右需转) {
        发射串临时释放617(右, 指令, 寄存器计数);
    }
    结果<空类型, 整32> 加拼栈 = 表达式栈.追加(拼接寄存器);
    如果 (!加拼栈.正常) { 运行时错误(4); }
}

// 732（2026-10-14）：定义点溯源——寄存器定义指令是否拼接族产物调用
//   （宿主 isConcatResultReg v2 同构·宿主查当前块指令表/本侧查函数指令
//   向量·寄存器号 SSA 单调每函数一表同源）。倒序首条 目标==寄存器 即唯一
//   写入点；查无定义=假=保守不释放（漏放不误放）；from_* 转换临时/变量加载
//   定义符号非拼接=假（from_* 已在 663 生成点单收·双收即双释放）。
// 749（2026-10-19）：拼接族 = __cn_str_concat（逐节连接）+ __cn_strbuf_finish
//   （一次性连接链融合产物·749 新发射面）。两者所有权契约同一（001 §10.3
//   新拥有串·调用方接管）——原仅认 concat 致融合链产物在比较位零释放
//   （987 ⑤ `甲+i+"x" == 乙+"y"` 百轮净泄 100 实锤）。
不安全 函数 是拼接产物寄存器(整64 寄存器, 向量<IR指令>& 指令) -> 布尔 {
    整64 i = 指令.大小() - 1;
    当 (i >= 0) {
        IR指令 条 = 指令.元素(整32(i));
        如果 (条.目标 == 寄存器) {
            如果 (条.操作码 != IR_调用参数化) { 返回 假; }
            返回 条.附加 == 驻留("__cn_str_concat") ||
                  条.附加 == 驻留("__cn_strbuf_finish");
        }
        i = i - 1;
    }
    返回 假;
}

// 966（166 立法 v2 同构·用户裁决 2026-10-02）：字符串六比较符 → helper 分派。
//   ==/!=：__cn_str_eq（内容相等·布尔寄存器；!= 在其上与常量 0 等值比较取反）；
//   </<=/>/>=：__cn_str_cmp（字典序 i64）与常量 0 比较。形态对齐 发射字符串拼接
//   （IR_调用实参×2 + IR_调用参数化 + 登记寄存器类型 + 压栈）。
不安全 函数 发射字符串比较(字符串 op名, 整64 左, 整64 右,
                   向量<IR指令>& 指令, 整64* 寄存器计数, 向量<整64>& 表达式栈) -> 空类型 {
    布尔 是不等 = 字符串比较(op名, "!=");
    布尔 是序 = 字符串比较(op名, "<") || 字符串比较(op名, "<=") ||
              字符串比较(op名, ">") || 字符串比较(op名, ">=");
    整64 原始寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_调用实参, 左, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用实参, 右, 0, 0, 0, 1, 0));
    如果 (是序) {
        IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 原始寄存器, 0,
                             驻留("__cn_str_cmp")));
        登记寄存器类型(原始寄存器, T_整64);
        // 758（2026-10-15）：比较位连接产物消费即释——两侧操作数若为拼接产物
        //   寄存器（`甲+乙 < 丙+丁;` 立案形态·宿主 genStringCompareBinary
        //   freeIfConcatTemp 同构）：比较调用为唯一消费者（只读内容），调用后
        //   零引用；645/663/732 面不含比较位两侧=每语句净泄 2（百轮泄 200）。
        //   定义点溯源守卫（是拼接产物寄存器）=变量加载/转换临时天然排除防误伤。
        如果 (是拼接产物寄存器(左, 指令)) { 发射寄存器串释放(左, 指令); }
        如果 (是拼接产物寄存器(右, 指令)) { 发射寄存器串释放(右, 指令); }
        整64 零寄存器 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零寄存器, T_整64, 0));
        整64 序码 = IR_小于;
        如果 (字符串比较(op名, "<=")) { 序码 = IR_小于等于; }
        否则 如果 (字符串比较(op名, ">")) { 序码 = IR_大于; }
        否则 如果 (字符串比较(op名, ">=")) { 序码 = IR_大于等于; }
        整64 结果寄存器 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(序码, 原始寄存器, 零寄存器, 0, 结果寄存器, T_布尔, 0));
        登记寄存器类型(结果寄存器, T_布尔);
        结果<空类型, 整32> 压栈 = 表达式栈.追加(结果寄存器);
        如果 (!压栈.正常) { 运行时错误(4); }
    } 否则 {
        IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 原始寄存器, 0,
                             驻留("__cn_str_eq")));
        登记寄存器类型(原始寄存器, T_布尔);
        // 758：==/!= 面同款收口（同序分支注释·宿主 genStringCompareBinary 同构）
        如果 (是拼接产物寄存器(左, 指令)) { 发射寄存器串释放(左, 指令); }
        如果 (是拼接产物寄存器(右, 指令)) { 发射寄存器串释放(右, 指令); }
        整64 结果寄存器2 = 原始寄存器;
        如果 (是不等) {
            整64 零寄存器2 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0, 零寄存器2, T_整64, 0));
            整64 不等寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_相等, 原始寄存器, 零寄存器2, 0, 不等寄存器, T_布尔, 0));
            登记寄存器类型(不等寄存器, T_布尔);
            结果寄存器2 = 不等寄存器;
        }
        结果<空类型, 整32> 压栈2 = 表达式栈.追加(结果寄存器2);
        如果 (!压栈2.正常) { 运行时错误(4); }
    }
}

