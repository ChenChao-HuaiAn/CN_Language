// IR类中（357 重构F2 自 IR类.cn 纯机械搬移·函数体逐字保留·零逻辑变化）

导入 映射集合;
导入 协议常量;   // 键位移（335：协议常量独立包）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

函数 是泛型实例(整64 实例ID) -> 布尔 {
    整64 n = 泛型实例们.大小();
    整64 i = 0;
    当 (i < n) {
        如果 (泛型实例们.元素(i) == 实例ID) { 返回 真; }
        i++;
    }
    返回 假;
}

// 收集一个类型文本（含 '$' 且剥基名命中 用户类们→登记实例）
//   消费点=线性扫池内 节点_类型 节点（收集泛型实例）——容器/结果合成名被
//   生成期前置分派自过滤（是容器类/是结果类型 先于 是用户类），此处仅按
//   「基名是用户类」过滤——stdlib 容器基名不在 用户类们（登记用户类 仅类声明）。
函数 收集泛型实例文本(整64 类型名ID) -> 空类型 {
    字符串 文本g = 字符串复制(驻留文本(类型名ID));
    如果 (字符串长度(文本g) == 0) { 返回; }
    // 713（708-e 上游收口）：& 化后形参类型节点文本带 & 尾缀（`向量<映射<
    //   整64, 符号>>&`）——按原文登记=与干净实例（无 &）各建克隆体，构造/
    //   析构/方法符号经 方法符号 剥层后同名 → A2005 重定义（fix_p.asm 实锤
    //   21606/24330 双 PROC）。引用透明：实例身份不含引用修饰（宿主 stripRef
    //   同款）——登记前剥尾 &（循环剥多层），带 & 请求合并到干净实例。
    整64 长g = 字符串长度(文本g);
    当 (长g > 1 && ((整64(文本g[整32(长g - 1)]) & 255) == 38)) {
        文本g = 字符串子串(文本g, 0, 整32(长g - 1));
        长g--;
    }
    // 无 '$' = 非泛型形态（纯类名/基础类型）——提前返回（防非泛型类误收集）
    布尔 含合成符g = 假;
    整64 扫g = 0;
    当 (扫g < 字符串长度(文本g)) {
        如果 (((整64(文本g[整32(扫g)]) & 255) == 36)) { 含合成符g = 真; }
        扫g++;
    }
    如果 (!含合成符g) { 返回; }
    字符串 基名g = 剥实例基名(文本g);
    如果 (字符串长度(基名g) == 0) { 返回; }
    // 419-a：类实例（基名∈用户类们）∪ 函数实例（基名∈泛型函数参数序表）
    如果 (!是用户类(基名g) && 查泛型基类参数序(驻留(基名g)) == 0) { 返回; }
    整64 实例IDg = 整64(驻留(文本g));
    如果 (!是泛型实例(实例IDg)) {
        结果<空类型, 整32> 加g = 泛型实例们.追加(实例IDg);
        如果 (!加g.正常) { 运行时错误(4); }
    }
}

// 线性扫程序区间全部 节点_类型 节点→收集实例（IR生成多文件 收集阶段调用·O(池)）
函数 收集泛型实例(向量<节点> 池, 向量<整32> 程序节点们) -> 空类型 {
    整64 f = 0;
    当 (f < 程序节点们.大小()) {
        节点 程序声明 = 池.元素(程序节点们.元素(整32(f)));
        整64 位置 = 整64(程序声明.子起点);
        整64 终点 = 整64(程序声明.子终点);
        当 (位置 < 终点) {
            节点 n = 池.元素(整32(位置));
            如果 (n.类型 == 节点_类型) {
                收集泛型实例文本(整64(n.文本));
            }
            如果 (n.类型 == 节点_调用 && n.子起点 > 0) {
                // 419-a：泛型函数显式实例化调用点（callee=名$实参合成名——
                //   被调标识符在 子起点·调用节点自身 文本=0）
                节点 被调c = 池.元素(整32(n.子起点));
                如果 (被调c.类型 == 节点_标识符) {
                    收集泛型实例文本(整64(被调c.文本));
                }
            }
            位置++;
        }
        f++;
    }
}

// 注册实例布局（从克隆类节点字段·字段类型已替换）：偏移/对齐重算+三表登记
//   （算法=解析类字段/布局收口 同款·键=实例ID）
函数 实例化布局登记(向量<节点> 池, 整32 克隆类节点索引) -> 空类型 {
    节点 类节点k = 池.元素(克隆类节点索引);
    整64 实例IDk = 整64(类节点k.文本);
    整64 字段偏移k = 0;
    整64 最大对齐k = 1;
    整64 位置k = 整64(类节点k.子起点);
    当 (位置k < 整64(类节点k.子终点)) {
        节点 成员k = 池.元素(整32(位置k));
        如果 (成员k.类型 == 节点_类字段) {
            // 克隆体 类字段.附加=克隆类型节点索引（克隆器已修针）
            节点 类型节点k = 池.元素(整32(成员k.附加));
            字符串 字段类型文本k = 字符串复制(驻留文本(整64(类型节点k.文本)));
            整64 字段大小k = 8;
            整64 字段对齐k = 8;
            // 435-b 根治：指针字段布局规范化——类型节点附加=指针层 1..255 时
            //   槽大小/对齐恒 8（指针槽存 8 字节地址；所指宽度只属下标读写字段）
            //   +类型文本补 '*'（与 登记类字段类型们 同步）——原按所指类型算
            //   大小（整32*=4 字节）→后续全字段偏移错位→预留/设置 解引用坏址
            //   （390 撤守卫 SEGV·r10=0x55802d0=堆指针低 32 位 实测）
            如果 (类型节点k.附加 >= 1 && 类型节点k.附加 <= 255) {
                字符串 星串k = "";
                整64 星i = 0;
                当 (星i < 类型节点k.附加) {
                    星串k = 字符串复制(星串k + "*");
                    星i++;
                }
                字段类型文本k = 字符串复制(字段类型文本k + 星串k);
                字段大小k = 8;
                字段对齐k = 8;
            }
            类型大小与对齐(字段类型文本k, &字段大小k, &字段对齐k);
            如果 (类型节点k.附加 >= 1 && 类型节点k.附加 <= 255) {
                字段大小k = 8;
                字段对齐k = 8;
            }
            整64 余k = 字段偏移k % 字段对齐k;
            如果 (余k != 0) { 字段偏移k = 字段偏移k + (字段对齐k - 余k); }
            整64 分桶键k = 实例IDk * 键位移 + 整64(成员k.文本);
            登记字段类型(分桶键k, 整64(驻留(字段类型文本k)));   // 435-b：星号规范化同步
            // 217（027 波2a·001 §5.8a）：全字段表旁路登记（字段类型文本k 已含星号）
            结果<空类型, 整32> 加217a = 结构体全字段表们.追加(实例IDk);
            如果 (!加217a.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加217b = 结构体全字段表们.追加(整64(成员k.文本));
            如果 (!加217b.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加217c = 结构体全字段表们.追加(整64(驻留(字段类型文本k)));
            如果 (!加217c.正常) { 运行时错误(4); }
            登记字段偏移(分桶键k, 字段偏移k);
            如果 (字段对齐k > 最大对齐k) { 最大对齐k = 字段对齐k; }
            字段偏移k = 字段偏移k + 字段大小k;
        }
        位置k++;
    }
    整64 尾余k = 字段偏移k % 最大对齐k;
    如果 (尾余k != 0) { 字段偏移k = 字段偏移k + (最大对齐k - 尾余k); }
    // 423-b 根治（族②）：**裸键直设**（实例ID 直键·绕过 登记结构体布局 的
    //   键基合成）——收集阶段 取当前模块路径() 残留≠生成期查询模块路径→键基
    //   合成键 miss。查询侧 结构体布局键基 查2 直查（主模块）返回 实例ID→
    //   字段偏移/类型 分桶键一致 ✓。
    结果<空类型, 整32> 设大k = 结构体大小表.设置(实例IDk, 字段偏移k);
    如果 (!设大k.正常) { 运行时错误(4); }
    结果<空类型, 整32> 设对k = 结构体对齐表.设置(实例IDk, 最大对齐k);
    如果 (!设对k.正常) { 运行时错误(4); }
    // 候选表补全（非主模块生成期的 结构体布局键基 候选判定域——公开=1）
    结果<空类型, 整32> 设数k = 结构体候选数们.设置(实例IDk, 1);
    如果 (!设数k.正常) { 运行时错误(4); }
    结果<空类型, 整32> 设键k = 结构体候选键基们.设置(实例IDk * 键位移, 实例IDk);
    如果 (!设键k.正常) { 运行时错误(4); }
    结果<空类型, 整32> 设公k = 结构体候选公开们.设置(实例IDk * 键位移, 1);
    如果 (!设公k.正常) { 运行时错误(4); }
}

// 克隆修针单节点（430-b 提取·类/函数两克隆器共用）：遍 2 指针字段按节点类型
//   重映射。字段语义全集（消费点=生成语句/生成表达式/生成当/生成如果/生成循环/
//   生成选择语句/生成成员解引用赋值）：
//   - 通用区间节点（块/表达式语句/调用/下标/一元…）：子起点=段起点（直映射）、
//     子终点=段终点（独占→映射[旧-1]+1）
//   - 如果语句：文本=条件起点/子起点=条件终点/附加=真块索引/子终点=否则链索引（单点）
//   - 当语句：文本=条件起点/子起点=条件终点/附加=体块索引
//   - 循环语句：文本=init 起点/子起点=cond 起点/子终点=step 起点/附加=体块索引
//   - 选择语句：文本=值表达式起点/附加=值表达式终点/子起·子终=情况段区间
//   - 三元运算：子起点=条件段起点/文本=真值段起点/附加=假值段起点/子终点=段末+1
//   - 赋值（复合左值形态）：附加=左值段起点/子起点=左值段终点/子终点=右值段终点
//   漏修后果（429-b 前历轮「其他」×276/装箱语境/下标左值/编译器越界崩溃 全族
//   根因）：克隆体控制流/左值指针仍指基类区——条件区间野生成+体块递归基类体。
// 523-a（D1 行数滚动·纯机械拆分零行为变更·2026-09-20）：克隆节点修针 138 行 →
//   分派器+十子函数——逻辑逐字迁移注释逐字保留（行号切片+27 条边界断言）。
//   执行顺序敏感点（侦查捕获）：兜底回填对方法/类字段/参数类型先行执行——
//   兜底分支不返回·声明族检查在其后原序保留；7 语句族提前返回=后续类型检查必假等价。
//   等价红线=新旧 v2p 编译同一改前 v2 树 asm 逐字节 md5 一致（/tmp/p523 双对拍）。
函数 修针如果语句槽位(映射<整64, 整64>& 索引映射, 节点 n2c) -> 节点 {
    如果 (n2c.文本 > 0) {
        结果<整64, 整32> 查tc = 索引映射.获取(整64(n2c.文本));
        如果 (查tc.正常) { n2c.文本 = 整32(查tc.值); }
    }
    如果 (n2c.子起点 > 0) {
        结果<整64, 整32> 查sc2 = 索引映射.获取(整64(n2c.子起点) - 1);
        如果 (查sc2.正常) { n2c.子起点 = 整32(查sc2.值) + 1; }
    }
    如果 (n2c.附加 > 0) {
        结果<整64, 整32> 查bc = 索引映射.获取(n2c.附加);
        如果 (查bc.正常) { n2c.附加 = 查bc.值; }
    }
    如果 (n2c.子终点 > 0) {
        结果<整64, 整32> 查ec2 = 索引映射.获取(整64(n2c.子终点));
        如果 (查ec2.正常) { n2c.子终点 = 整32(查ec2.值); }
    }
    返回 n2c;
}
