函数 修针二元运算槽位(映射<整64, 整64>& 索引映射, 节点 n2c) -> 节点 {
    // 432-b 根治（野走第二族）：二元——子起点=左操作数段起点（索引·直映射）/
    //   附加=右操作数段起点（索引·直映射·生成短路求值 左=[子起,附加) 右=[附加,子终)
    //   契约）/子终点=自身索引（段末+1 语义→dance）。漏修实证=&&/|| 克隆体右段
    //   从基区 raw 附加起野走（[439,4482) 实测）→类型大小 T ×10＋基方法体
    //   被当表达式生成（宿主符号=类方法为静态残留假象）。
    如果 (n2c.子起点 > 0) {
        结果<整64, 整32> 查sc8 = 索引映射.获取(整64(n2c.子起点));
        如果 (查sc8.正常) { n2c.子起点 = 整32(查sc8.值); }
    }
    如果 (n2c.附加 > 0) {
        结果<整64, 整32> 查bc7 = 索引映射.获取(n2c.附加);
        如果 (查bc7.正常) { n2c.附加 = 查bc7.值; }
    }
    如果 (n2c.子终点 > 0) {
        结果<整64, 整32> 查ec8 = 索引映射.获取(整64(n2c.子终点) - 1);
        如果 (查ec8.正常) { n2c.子终点 = 整32(查ec8.值) + 1; }
    }
    返回 n2c;
}
