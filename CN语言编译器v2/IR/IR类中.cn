函数 修针选择语句槽位(映射<整64, 整64>& 索引映射, 节点 n2c) -> 节点 {
    如果 (n2c.文本 > 0) {
        结果<整64, 整32> 查tc3 = 索引映射.获取(整64(n2c.文本));
        如果 (查tc3.正常) { n2c.文本 = 整32(查tc3.值); }
    }
    如果 (n2c.附加 > 0) {
        结果<整64, 整32> 查bc3 = 索引映射.获取(整64(n2c.附加) - 1);
        如果 (查bc3.正常) { n2c.附加 = 查bc3.值; }
    }
    如果 (n2c.子起点 > 0) {
        结果<整64, 整32> 查sc4 = 索引映射.获取(整64(n2c.子起点));
        如果 (查sc4.正常) { n2c.子起点 = 整32(查sc4.值); }
    }
    如果 (n2c.子终点 > 0) {
        结果<整64, 整32> 查ec4 = 索引映射.获取(整64(n2c.子终点) - 1);
        如果 (查ec4.正常) { n2c.子终点 = 整32(查ec4.值) + 1; }
    }
    返回 n2c;
}
函数 修针兜底回填槽位(映射<整64, 整64>& 索引映射, 节点 n2c) -> 节点 {
    如果 (n2c.子起点 > 0) {
        结果<整64, 整32> 查sc = 索引映射.获取(整64(n2c.子起点));
        如果 (查sc.正常) { n2c.子起点 = 整32(查sc.值); }
    }
    如果 (n2c.子终点 > 0) {
        结果<整64, 整32> 查ec = 索引映射.获取(整64(n2c.子终点) - 1);
        如果 (查ec.正常) { n2c.子终点 = 整32(查ec.值) + 1; }
    }
    返回 n2c;
}
函数 修针类字段参数槽位(映射<整64, 整64>& 索引映射, 节点 n2c) -> 节点 {
    如果 (n2c.附加 > 0) {
        结果<整64, 整32> 查ac = 索引映射.获取(n2c.附加);
        如果 (查ac.正常) { n2c.附加 = 查ac.值; }
    }
    返回 n2c;
}
函数 修针方法槽位(映射<整64, 整64>& 索引映射, 节点 n2c, 向量<整64>& 参数名ID们, 向量<整64>& 实参ID们) -> 节点 {
    如果 (n2c.附加 > 0) {
        字符串 返原c = 字符串复制(驻留文本(n2c.附加));
        字符串 返新c = 替换实例类型文本(返原c, 参数名ID们, 实参ID们);
        如果 (!字符串比较(返新c, 返原c)) { n2c.附加 = 整64(驻留(返新c)); }
    }
    返回 n2c;
}

函数 克隆节点修针(映射<整64, 整64>& 索引映射, 节点 n2c,
                 向量<整64>& 参数名ID们, 向量<整64>& 实参ID们) -> 节点 {
    如果 (n2c.类型 == 节点_如果语句) { 返回 修针如果语句槽位(索引映射, n2c); }
    否则 如果 (n2c.类型 == 节点_当语句) { 返回 修针当语句槽位(索引映射, n2c); }
    否则 如果 (n2c.类型 == 节点_循环语句) { 返回 修针循环语句槽位(索引映射, n2c); }
    否则 如果 (n2c.类型 == 节点_三元运算) { 返回 修针三元运算槽位(索引映射, n2c); }
    否则 如果 (n2c.类型 == 节点_二元运算) { 返回 修针二元运算槽位(索引映射, n2c); }
    否则 如果 (n2c.类型 == 节点_赋值) { 返回 修针赋值槽位(索引映射, n2c); }
    否则 如果 (n2c.类型 == 节点_选择语句) { 返回 修针选择语句槽位(索引映射, n2c); }
    否则 { n2c = 修针兜底回填槽位(索引映射, n2c); }
    如果 (n2c.类型 == 节点_类字段 || n2c.类型 == 节点_参数) { 返回 修针类字段参数槽位(索引映射, n2c); }
    如果 (n2c.类型 == 节点_方法) { 返回 修针方法槽位(索引映射, n2c, 参数名ID们, 实参ID们); }
    返回 n2c;
}

// 克隆泛型类节点为实例类节点（两遍法：①区间内逐节点值拷贝+索引映射·
//   节点_类型 文本替换；②修针=子区间平移（>0 才平移·0=空保持——池索引 0 哨兵
//   纪律）/类字段与参数的附加（类型节点索引）映射/方法附加（返回类型ID）替换）。
//   节点_方法.子终点=块单点索引——开区间映射公式（映射[旧终点-1]+1）天然兼容。
// 返回 克隆类节点池索引。
函数 克隆泛型类节点(向量<节点> 池, 整32 类节点索引, 整64 实例ID,
                 向量<整64>& 参数名ID们, 向量<整64>& 实参ID们) -> 整32 {
    节点 基类节点c = 池.元素(类节点索引);
    整64 旧起c = 整64(基类节点c.子起点);
    整64 旧终c = 整64(基类节点c.子终点);
    映射<整64, 整64> 索引映射c;
    // 遍 1：原样复制（类型文本替换）+映射
    整64 ic = 旧起c;
    当 (ic < 旧终c) {
        节点 nc = 池.元素(整32(ic));
        如果 (nc.类型 == 节点_类型) {
            字符串 原文本c = 字符串复制(驻留文本(整64(nc.文本)));
            字符串 新文本c = 替换实例类型文本(原文本c, 参数名ID们, 实参ID们);
            如果 (!字符串比较(新文本c, 原文本c)) {
                nc.文本 = 整32(驻留(新文本c));
            }
        }
        // 421-a（族①）：标识符位替换——类型大小(K) 系内置的 K 实参/表达式位
        //   类型名（越界放行边界同波 1·精确匹配）
        如果 (nc.类型 == 节点_标识符) {
            字符串 原标识c = 字符串复制(驻留文本(整64(nc.文本)));
            字符串 新标识c = 替换实例类型文本(原标识c, 参数名ID们, 实参ID们);
            如果 (!字符串比较(新标识c, 原标识c)) {
                nc.文本 = 整32(驻留(新标识c));
            }
        }
        整64 新索引c = 池.大小();
        池追加(池, nc);
        结果<空类型, 整32> 设mc = 索引映射c.设置(ic, 新索引c);
        如果 (!设mc.正常) { 运行时错误(4); }
        ic++;
    }
    // 遍 2：修针（共享 克隆节点修针——430-b 类型感知全集·写回池.设置值语义）
    ic = 旧起c;
    当 (ic < 旧终c) {
        结果<整64, 整32> 查mc = 索引映射c.获取(ic);
        如果 (查mc.正常) {
        节点 n2c = 池.元素(整32(查mc.值));
        n2c = 克隆节点修针(索引映射c, n2c, 参数名ID们, 实参ID们);
        结果<空类型, 整32> 设w2c = 池.设置(整32(查mc.值), n2c);
        如果 (!设w2c.正常) { 运行时错误(4); }
        }
        ic++;
    }
    // 实例类节点（文本=实例合成名ID·区间=克隆体首尾）
    结果<整64, 整32> 查fc = 索引映射c.获取(旧起c);
    结果<整64, 整32> 查lc = 索引映射c.获取(旧终c - 1);
    整64 新起f = 0;
    如果 (查fc.正常) { 新起f = 查fc.值; }
    整64 新终l = 0;
    如果 (查lc.正常) { 新终l = 查lc.值; }
    节点 实例类节点c;
    实例类节点c.类型 = 节点_类;
    实例类节点c.文本 = 整32(实例ID);
    实例类节点c.附加 = 0;
    实例类节点c.子起点 = 整32(新起f);
    实例类节点c.子终点 = 整32(新终l + 1);
    实例类节点c.行 = 0;
    实例类节点c.修饰 = 0;
    整32 克隆索引c = 整32(池.大小());
    池追加(池, 实例类节点c);
    返回 克隆索引c;
}

// 实例方法表登记（从克隆类节点·参数串从克隆方法节点参数区拼·返回/参数类型
//   已被克隆器替换——登记格式与语义收集类方法 同款：构造=方法名==类名/析构=
//   ~类名 前缀/普通方法）
函数 实例化方法表登记(向量<节点> 池, 整32 克隆类节点索引) -> 空类型 {
    节点 类节点m = 池.元素(克隆类节点索引);
    整64 实例IDm = 整64(类节点m.文本);
    整64 位置m = 整64(类节点m.子起点);
    当 (位置m < 整64(类节点m.子终点)) {
        节点 成员m = 池.元素(整32(位置m));
        如果 (成员m.类型 == 节点_方法) {
            字符串 参数串m = 函数参数串(池, 整32(位置m));
            整64 方法名IDm = 整64(成员m.文本);
            整64 返回类型IDm = 整64(成员m.附加);
            如果 (返回类型IDm == 0) { 返回类型IDm = 整64(驻留("空类型")); }
            // 432-b 根治：克隆方法节点的方法名仍是**基类名**（克隆器只替换
            //   类型文本/标识符位，方法名=类名 的构造器名不改）——原检测
            //   方法名==实例合成名 恒假=实例构造器零登记（用户类无构造器）。
            //   补基名匹配：方法名==剥实例基名(实例ID) 即构造器。
            整64 基名IDm = 整64(驻留(剥实例基名(字符串复制(驻留文本(实例IDm)))));
            如果 (方法名IDm == 实例IDm || 方法名IDm == 基名IDm) {
                登记类构造(实例IDm, 参数串m);
            } 否则 如果 (字符串比较(字符串子串(驻留文本(方法名IDm), 0, 1), "~")) {
                登记类析构(实例IDm);
            } 否则 {
                登记类方法(实例IDm, 方法名IDm, 返回类型IDm, 参数串m);
            }
        }
        位置m++;
    }
}

// 实例化总编排（IR生成多文件 收集阶段·生成主循环之前调用）：
//   逐实例→剥基名/实参段→取基类参数序→定位基类类节点→克隆→布局登记→
//   方法表登记→克隆索引表（生成期 生成类方法们 分派消费）。
函数 实例化注册(向量<节点> 池, 向量<整32> 程序节点们) -> 空类型 {
    整64 n = 泛型实例们.大小();
    整64 i = 0;
    当 (i < n) {
        整64 实例IDr = 泛型实例们.元素(i);
        字符串 实例文本r = 字符串复制(驻留文本(实例IDr));
        字符串 基名r = 剥实例基名(实例文本r);
        整64 基名IDr = 整64(驻留(基名r));
        整64 参数序IDr = 查泛型基类参数序(基名IDr);
        如果 (参数序IDr == 0) {
            i++;
            继续;   // 非泛型基类的 $ 名（防御·零注册）
        }
        向量<整64> 参数名们r = 向量<整64>();
        向量<整64> 实参们r = 向量<整64>();
        // 参数名串（逗号分隔）拆段
        字符串 参数串文本r = 字符串复制(驻留文本(参数序IDr));
        整64 段起r = 0;
        整64 cr = 0;
        当 (cr <= 字符串长度(参数串文本r)) {
            布尔 尾r = cr == 字符串长度(参数串文本r);
            如果 (尾r || ((整64(参数串文本r[整32(cr)]) & 255) == 44)) {
                如果 (cr > 段起r) {
                    结果<空类型, 整32> 加nr = 参数名们r.追加(整64(驻留(字符串子串(参数串文本r, 整32(段起r), 整32(cr - 段起r)))));
                    如果 (!加nr.正常) { 运行时错误(4); }
                }
                段起r = cr + 1;
            }
            cr++;
        }
        剥实例参数段(实例文本r, 实参们r);
        如果 (参数名们r.大小() != 实参们r.大小()) {
            IR层诊断("泛型实例实参与基类参数序不匹配: " + 实例文本r);
            运行时错误(6);
        }
        // 定位基类类节点（程序区间扫描）
        整32 基类索引r = 0 - 1;
        整64 f = 0;
        当 (f < 程序节点们.大小() && 基类索引r == 0 - 1) {
            节点 程序声明r = 池.元素(程序节点们.元素(整32(f)));
            整64 位置r = 整64(程序声明r.子起点);
            整64 终点r = 整64(程序声明r.子终点);
            当 (位置r < 终点r) {
                节点 声明r = 池.元素(整32(位置r));
                如果 (声明r.类型 == 节点_类 && 整64(声明r.文本) == 基名IDr) {
                    基类索引r = 整32(位置r);
                    中断;
                }
                位置r++;
            }
            f++;
        }
        如果 (基类索引r == 0 - 1) {
            i++;
            继续;   // 基类不在本编译单元（跨模块=波3 面·静默零注册）
        }
        // 注册为完整用户类（对象声明/方法调用分派链入口——是用户类(实例合成名)）
        登记用户类(实例IDr);
        // 421-c（族②）：变量结构体表登记（三级解析 查结构体类型 的标记命中——
        //   方法体 this 字段偏移/成员链对象解析链路的数据源）
        登记变量结构体(实例IDr, 1);
        // 432-b 根治：自引用类型对（基名→实例合成名）追加进替换对——拷贝构造
        //   参数 `向量& 其他` 等类名自引用类型须单态化为 `向量$整64&`（Rust
        //   Self→具体型同构），否则定义侧符号=基参数串、调用侧（复制 展开/
        //   发射用户类构造）=实例参数串——链接 undefined。
        结果<空类型, 整32> 加自r = 参数名们r.追加(基名IDr);
        如果 (!加自r.正常) { 运行时错误(4); }
        结果<空类型, 整32> 加自2r = 实参们r.追加(实例IDr);
        如果 (!加自2r.正常) { 运行时错误(4); }
        整32 克隆索引r = 克隆泛型类节点(池, 基类索引r, 实例IDr, 参数名们r, 实参们r);
        实例化布局登记(池, 克隆索引r);
        实例化方法表登记(池, 克隆索引r);
        结果<空类型, 整32> 加cr = 泛型实例类节点们.追加(整64(克隆索引r));
        如果 (!加cr.正常) { 运行时错误(4); }
        i++;
    }
}

// 419-a（D42 波 3）：克隆泛型函数节点为实例函数节点（两遍法同 克隆泛型类节点——
//   区间=函数节点子区间（参数区+体块）+函数节点本身（文本=实例合成名ID·
//   附加=返回类型ID 替换）。返回 克隆函数节点池索引。
