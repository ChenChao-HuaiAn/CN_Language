// CN 自举编译器 v2 · IR 生成表达式下标——下标访问/越界检查/下标左值族
//   （1036 拆分：自 生成表达式求值尾.cn 按族机械搬移——原文件 >900 警戒线且
//   1036 引用返回修复后贴 1000 冻结线，先拆再加纪律；族 = 生成下标访问 + 发射
//   数组越界检查94-a + 发射字符串越界检查T4 + 生成下标左值标识符分支〔259 族·
//   964 自 生成表达式字段.cn 再迁——纯搬运零行为变更，函数体逐字保留〕）。
//   消费方：生成表达式中.cn 下标形态（生成下标访问）·生成表达式字段.cn /
//   生成表达式尾.cn 左值链越界面（发射数组越界检查/下标左值地址）。
//   声明序：包.cn 置于 生成表达式求值尾 之后、生成表达式 之前（消费方其后加载）。

导入 容器::向量;
导入 映射集合;
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码 + IR常量 键位移（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 IR生成;     // 函数级变量类型权威表/重载决议/控制流辅助（同包幂等）

公开:

// 下标访问：字符串[i] 逐字节（T_字节 符号扩展）/指针对象 p[i] 元素宽度步进
//   （③ 第三波）。弹 下标与对象值，地址=对象+缩放步进，加载宽度按元素码登记。
不安全 函数 生成下标访问(向量<节点> 池, 节点 n, 向量<IR指令>& 指令,
                  整64* 寄存器计数, 整64* 块计数,
                  向量<整64>& 表达式栈) -> 空类型 {
        // ③ 第二波：字符串[i] 逐字节 O(1) 访问（宿主 A-1 对齐，plans/004）：
        //   UTF-8 字节视图步进 1，LoadPtr i8 有符号扩展（双后端 movsx/ldrsb——
        //   与 C 的 s[i] 一致，65 用例 字节和=-376 实证），越界由调用方按
        //   字符串长度 约束；结果类型 字符（符号扩展字节值按整数消费）。
        //   弹 下标（栈顶）与 对象（字符串指针值——标识符/成员/调用产物均可），
        //   地址 = 对象 + 下标（IR_加 步进 1），IR_指针加载 T_字节（1 字节符号
        //   扩展——独立宽度码，B5 字段 T_字符 零扩展模型互不影响）。
        // ③ 第三波：指针对象 p[i] ≡ *(p + i)（宿主 ir_expr.cpp:1555 对齐）——
        //   步进=所指元素宽度（类型名宽度；步进1 免乘），加载宽度=元素宽度码，
        //   结果登记元素类型码（打印分派/拼接消费）。对象须为指针变量（语义层
        //   白名单保证；未命中走字符串路径——两白名单互斥不误伤）。
        // 94-a/97-a：对象元素类型 + 数组长度统一经推导 helper（标识符数组变量 /
        //   指针变量 / **结构体字段数组**（成员对象，97-a C8）三形态同源）
        整64 所指ID = 0;
        整64 数组长度下 = 0;
        如果 (n.子起点 > 0) {
            所指ID = 推导下标元素类型ID(池, 整32(n.子起点));
            数组长度下 = 推导下标数组长度(池, 整32(n.子起点));
        }
        整64 下标值 = 0;
        如果 (表达式栈.大小() >= 1) {
            下标值 = 表达式栈.元素(表达式栈.大小() - 1);
            结果<空类型, 整32> 删下 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删下.正常) { 运行时错误(4); }
        }
        整64 对象值 = 0;
        如果 (表达式栈.大小() >= 1) {
            对象值 = 表达式栈.元素(表达式栈.大小() - 1);
            结果<空类型, 整32> 删对 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删对.正常) { 运行时错误(4); }
        }
        如果 (所指ID != 0) {
            // 94-a：数组下标越界检查（宿主 ir.cpp 同构：下标 >= 长度 → 运行时
            //   错误(1)）——数组对象有静态长度（数组长度下 > 0 才发射；指针
            //   对象无长度信息=既有边界）。安全性：越界读/写挡在运行期入口。
            如果 (数组长度下 > 0) {
                发射数组越界检查(下标值, 数组长度下, 指令, 寄存器计数, 块计数);
            }
            // 961（数组限界·948 口径分流）：**数组**（栈/字段数组·数组长度
            //   非零）元素=内联对象体（923/1052 模型）→ 步进=数组元素布局宽
            //   （用户类=本体宽·查结构体大小）；**指针数据区**（容器 raw 缓冲·
            //   数组长度为 0·948 链容器「元素槽步进=类型名宽度」口径）→ 步进=
            //   类型名宽度（用户类恒 8=句柄槽域）。全量布局宽替换曾致容器族/
            //   链游回归（118 跨模块「类数组元素布局宽」miss/1370 链表析构序 12）。
            整64 步进 = 类型名宽度(所指ID);
            如果 (数组长度下 != 0) { 步进 = 数组元素布局宽(所指ID); }
            整64 缩放值 = 下标值;
            如果 (步进 != 1) {
                整64 步进常量 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留(整数转字符串(步进))), 0, 0,
                                     步进常量, T_整64, 0));
                整64 缩放寄存器 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_乘, 下标值, 步进常量, 0, 缩放寄存器, T_整64, 0));
                缩放值 = 缩放寄存器;
            }
            整64 元素地址 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加, 对象值, 缩放值, 0, 元素地址, T_整64, 0));
            // 94-a（2026-09-13 第九十四轮）：元素为**结构体**（查结构体大小 != 0）
            //   ——表达式值 = **元素地址**（不加载）：与 87-a 静态结构体/结构体局部/
            //   86-a 三元聚合同款「结构体表达式值=地址」约定；成员访问（表[0].x）
            //   基址侧复用栈顶、整体拷贝、作实参全链零拷贝消费。
            // 1011（537·合成体元素读侧对齐）：结果/可选类合成体元素同款地址语义
            //   ——写侧（下标整体写 结果大小=16）与读侧（地址+整体拷）对称；原落
            //   IR_指针加载 8 字节=把「标志+值打包」当地址/句柄解引用（fault=
            //   0x0500000001=正常(5) 打包值被解引用·537 A 段实锤）。
            // 472（2026-10-11）：128 位标量元素读=地址语义（值=句柄）——
            //   v2 全链 128 位值约定为「寄存器=16 字节槽地址」（810 转换分派/
            //   打印 __cn_print_i128 传址/赋值双半拷贝按句柄解引用）。原落
            //   IR_指针加载 8 字节装载值却登记 T_整128 → 下游按句柄再解引用
            //   （整64(表[0]) 值 7 被当地址→fault=07 段错误·宿主绿分叉实证）。
            //   与下方结构体/结果类型地址语义分支同构，登记 128 码（句柄消费
            //   面按 查寄存器类型==T_整128/正128 判定）。
            整64 元素码472 = 类型码(所指ID);
            如果 (元素码472 == T_整128 || 元素码472 == T_正128) {
                登记寄存器类型(元素地址, 元素码472);
                结果<空类型, 整32> 加元地128 = 表达式栈.追加(元素地址);
                如果 (!加元地128.正常) { 运行时错误(4); }
                返回;
            }
            如果 (查结构体大小(所指ID) != 0 || 是结果类型_ID(所指ID)) {
                登记寄存器类型(元素地址, T_对象);
                结果<空类型, 整32> 加元地 = 表达式栈.追加(元素地址);
                如果 (!加元地.正常) { 运行时错误(4); }
                返回;
            }
            整64 元素值寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 元素地址, 0, 0, 元素值寄存器,
                                 类型宽度码(驻留文本(所指ID)), 0));
            登记寄存器类型(元素值寄存器, 类型码(所指ID));
            结果<空类型, 整32> 加元素 = 表达式栈.追加(元素值寄存器);
            如果 (!加元素.正常) { 运行时错误(4); }
            返回;
        }
        // T4（311-a=306-b 波次2 v2 侧·2026-09-17）：字符串下标越界检查（运行时
        //   长度版——对齐宿主 emitStrBoundsCheck/__cn_str_len；错误码 2 与 94-a
        //   数组防线对称）。原「越界由调用方按字符串长度约束」=防线不对称（数组
        //   有检查而字符串无=越界读 UB）。字符* 指针视图走 所指ID!=0 指针路径
        //   （无长度信息·既有边界）=天然不误伤（与宿主三读路径插桩同覆盖：
        //   对象值=标识符/成员/调用产物均可）。
        // #1310（2026-10-23）：对象为字符串字面量/顶层字符串常量时长度编译期
        //   已知（推导字符串下标已知长度），以常量比较替代 __cn_str_len 调用
        //   ——与宿主 knownStringObjectLen 快路径同构（可证明的重复 strlen 消除）；
        //   变量/字段/调用返回等未知形态 -1 → 原运行时 strlen 路径（显式分流）。
        可选<整64> 已知长度s = 无;
        如果 (n.子起点 > 0 && n.子起点 < 整32(池.大小())) {
            已知长度s = 推导字符串下标已知长度(池, 整32(n.子起点));
        }
        发射字符串越界检查(下标值, 对象值, 指令, 寄存器计数, 块计数, 已知长度s);
        整64 下标地址 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_加, 对象值, 下标值, 0, 下标地址, T_整64, 0));
        整64 字节值寄存器 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_指针加载, 下标地址, 0, 0, 字节值寄存器, T_字节, 0));
        登记寄存器类型(字节值寄存器, T_整64);
        结果<空类型, 整32> 加字 = 表达式栈.追加(字节值寄存器);
        如果 (!加字.正常) { 运行时错误(4); }
}

// 94-a（2026-09-13 第九十四轮）：数组下标越界检查发射（宿主 ir.cpp 同构：下标
//   >= 长度 → 运行时错误(1)；上界有符号比较——数组长度为正常量，负数下标
//   属宿主同款既有边界）。形态：长度常量 + IR_大于等于 + 条件跳转（越界块调
//   __cn_runtime_error，不返回）+ 继续块标签；非数组（长度 0）调用方不发射。
不安全 函数 发射数组越界检查(整64 下标值, 整64 数组长度, 向量<IR指令>& 指令,
                          整64* 寄存器计数, 整64* 块计数) -> 空类型 {
    如果 (数组长度 <= 0) { 返回; }
    整64 长度常量x = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留(整数转字符串(数组长度))), 0, 0,
                          长度常量x, T_整64, 0));
    整64 越界布尔x = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_大于等于, 下标值, 长度常量x, 0, 越界布尔x, T_布尔, 0));
    登记寄存器类型(越界布尔x, T_布尔);
    整64 越界块x = 块计数[0] + 1;
    整64 继续块x = 块计数[0] + 2;
    块计数[0] = 块计数[0] + 2;
    IR追加(指令, 建IR指令(IR_条件跳转, 越界布尔x, 越界块x, 继续块x, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 越界块x));
    整64 错误码x = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    // 错误码 2=数组越界（runtime 契约表：1=除零 2=数组越界——
    //   src/runtime/runtime.cpp 同源；宿主 ir.cpp 越界检查同码）
    IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("2")), 0, 0, 错误码x, T_整64, 0));
    IR追加(指令, 建IR指令(IR_调用实参, 错误码x, 0, 0, 0, 0, 0));
    可选<字符串> 符号查运x = 内置函数符号("运行时错误");
    字符串 符号运x = "";
    如果 (符号查运x.有值) { 符号运x = 字符串复制(符号查运x.值); }
    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                         驻留(符号运x)));
    IR追加(指令, 建IR指令(IR_跳转, 0, 0, 0, 0, 0, 继续块x));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 继续块x));
}

// T4（311-a=306-b 波次2 v2 侧·2026-09-17）：字符串下标越界检查发射（运行时
//   长度版——对齐宿主 306-a emitStrBoundsCheck：调 __cn_str_len(对象) 得运行时
//   长度，下标 >= 长度 → 运行时错误(2)（错误码与数组防线对称·不返回）；上界
//   有符号比较——负数下标与数组版同属既有边界）。对象=字符串指针值（字符串
//   路径专属——字符* 指针视图走 所指ID!=0 指针路径不经此=不误伤）。
// #1310（2026-10-23）：①已知长度快路径——字面量/顶层字符串常量的字节长度编译期
//   可知（推导字符串下标已知长度·可选<整64> 与宿主 cn::Optional 同构），直接
//   常量比较、不调 __cn_str_len；无值=未知→原运行时 strlen 路径（显式分流，
//   未知不猜测）。②负下标防线与宿主 emitStrBoundsCheck 的 ltZero 对齐——原 v2
//   仅上界比较=负数下标静默放行（宿主 rc=2 / v2 放行=零分叉红线），本条补齐：
//   下标 <0 与 >=长度 同走错误码 2。
不安全 函数 发射字符串越界检查(整64 下标值, 整64 对象值, 向量<IR指令>& 指令,
                            整64* 寄存器计数, 整64* 块计数, 可选<整64> 已知长度) -> 空类型 {
    // ① 长度来源：显式二态枚举（非 else 兜底）——已知长度（有值）=常量寄存器；
    //   未知（无值）=运行时 __cn_str_len(对象) 原路径。
    整64 长度寄存器 = 0;
    如果 (已知长度.有值) {
        长度寄存器 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留(整数转字符串(已知长度.值))),
                              0, 0, 长度寄存器, T_整64, 0));
        登记寄存器类型(长度寄存器, T_整64);
    } 否则 如果 (!已知长度.有值) {
        // 运行时长度：__cn_str_len(对象) ——实参=对象（字符串指针值）
        IR追加(指令, 建IR指令(IR_调用实参, 对象值, T_对象, 0, 0, 0, 0));
        长度寄存器 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        可选<字符串> 符号查长 = 内置函数符号("字符串长度");
        字符串 符号长 = "";
        如果 (符号查长.有值) { 符号长 = 字符串复制(符号查长.值); }
        IR追加(指令, 建IR指令(IR_调用参数化, 1, T_整64, 0, 长度寄存器, 0,
                             驻留(符号长)));
        登记寄存器类型(长度寄存器, T_整64);
    }
    // ② 下标 < 0 → 越界块（对齐宿主 ltZero 防线；负数下标=越界错误码 2）
    整64 零寄存器s = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("0")), 0, 0, 零寄存器s, T_整64, 0));
    整64 负布尔s = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_小于, 下标值, 零寄存器s, 0, 负布尔s, T_布尔, 0));
    登记寄存器类型(负布尔s, T_布尔);
    // ③ 下标 >= 长度 → 越界块（错误码 2 ·与 94-a 数组版同码）
    整64 越界布尔s = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_大于等于, 下标值, 长度寄存器, 0, 越界布尔s, T_布尔, 0));
    登记寄存器类型(越界布尔s, T_布尔);
    // 块布局：越界块(错误码2)→检查块(上界判定)→继续块
    整64 越界块s = 块计数[0] + 1;
    整64 检查块s = 块计数[0] + 2;
    整64 继续块s = 块计数[0] + 3;
    块计数[0] = 块计数[0] + 3;
    IR追加(指令, 建IR指令(IR_条件跳转, 负布尔s, 越界块s, 检查块s, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 检查块s));
    IR追加(指令, 建IR指令(IR_条件跳转, 越界布尔s, 越界块s, 继续块s, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 越界块s));
    整64 错误码s = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("2")), 0, 0, 错误码s, T_整64, 0));
    IR追加(指令, 建IR指令(IR_调用实参, 错误码s, 0, 0, 0, 0, 0));
    可选<字符串> 符号查运s = 内置函数符号("运行时错误");
    字符串 符号运s = "";
    如果 (符号查运s.有值) { 符号运s = 字符串复制(符号查运s.值); }
    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                         驻留(符号运s)));
    IR追加(指令, 建IR指令(IR_跳转, 0, 0, 0, 0, 0, 继续块s));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 继续块s));
}

// #1310：类字段裸名遮蔽判据（P0-1/P1-2·与宿主 classFieldType 同构）——
//   当前方法类及其基类链上存在同名实例/静态字段 → 读点是字段槽（可被赋值/
//   方法调用改写；继承静态字段读路径另有既有符号解析缺陷，本任务只保证回落
//   运行时 strlen 不崩）。查字段类型ID=类布局字段类型表；查类静态字段合成名=
//   静态字段表；两表合起来覆盖实例/静态，循环沿 查类基名 覆盖继承。
函数 字段裸名遮蔽1310(整64 名ID) -> 布尔 {
    整64 类ID = 当前方法类名ID;
    整64 守卫 = 0;
    当 (类ID != 0 && 守卫 < 64) {
        // 实例字段仅非静态方法参与（静态方法无 this——宿主 !currentMethodStatic_）
        如果 (!当前方法静态标记) {
            如果 (查字段类型ID(类ID, 名ID) != 0) { 返回 真; }
        }
        结果<整64, 整32> 静查 = 查类静态字段合成名(类ID, 名ID);
        如果 (静查.正常) { 返回 真; }
        类ID = 查类基名(类ID);
        守卫 = 守卫 + 1;
    }
    返回 假;
}

// #1310：字符串下标对象的编译期已知长度（与宿主 knownStringObjectLen 同构）：
//   ① 字符串字面量 → 驻留文本（词法层已解码）的 UTF-8 字节数；NUL 口径=v2
//      字符串即 C 串，驻留文本在首个 NUL 截断，字符串长度(strlen) 与运行期
//      __cn_str_len 同口径（宿主侧 decodeString 可含 NUL，故宿主显式回落）。
//   ② 标识符 → 顶层常量表命中且值为折叠串（938 判定·双引号包裹）→ 剥引号
//      内容的字节数；
//   ③ 其余一切形态（变量/类字段/调用返回/未命中常量/非字符串常量）→ 无值，
//      调用方走运行时 __cn_str_len 原路径（显式分流，不猜测、不静默取 0）。
//   安全前置（584-a 遮蔽）：当前函数局部/参数/静态变量与常量同名时读点是**变量槽**
//   （可被赋值/引用捕获改写）；类字段（实例/静态/继承）同款——均不套常量长度。
函数 推导字符串下标已知长度(向量<节点> 池, 整32 对象节点位) -> 可选<整64> {
    节点 对象节点 = 池.元素(对象节点位);
    如果 (对象节点.类型 == 节点_字符串字面量) {
        返回 某些(字符串长度(驻留文本(整64(对象节点.文本))));
    }
    如果 (对象节点.类型 == 节点_标识符) {
        // 正向推导（非「miss→返默认」形态）：仅当「非本函数变量 && 非静态
        //   同名 && 非类字段裸名 && 常量命中 && 折叠串」全真才返回内容长度。
        布尔 可推导 = 真;
        如果 (查当前函数变量类型(整64(对象节点.文本)) != -1) { 可推导 = 假; }
        结果<整64, 整32> 静查长291 = 查静态序号含类(整64(对象节点.文本));
        如果 (静查长291.正常) { 可推导 = 假; }
        如果 (字段裸名遮蔽1310(整64(对象节点.文本))) { 可推导 = 假; }
        如果 (可推导) {
            结果<整64, 整32> 常查 = 查常量值(整64(对象节点.文本));
            如果 (常查.正常) {
                如果 (是折叠串值938(常查.值)) {
                    返回 某些(字符串长度(折叠串内容938(常查.值)));
                }
            }
        }
    }
    返回 无;
}

// ==================== 生成下标左值标识符分支（259 族·964 迁移自 生成表达式字段.cn） ====================
// 259（2026-10-07·#259 静态数组）：生成下标左值标识符分支 自 生成表达式.cn 机械
//   搬移；964 再迁本文件（先拆再加：生成表达式字段.cn 已越 900 警戒线——下标左值族
//   归属 生成表达式下标.cn，与 生成下标访问/越界检查 同族同源）。纯搬运零行为变更
//   （函数体逐字保留）。含 259 顶层静态数组下标左值分支。消费方=生成表达式尾.cn
//   （生成左值地址 下标形态·包序本文件先于消费方加载·前向引用不可达纪律满足）。
不安全 函数 生成下标左值标识符分支(向量<节点> 池, 节点 末节点, 节点 下标对象左值, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽, 向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数, 向量<整64>& 表达式栈) -> 整64 {
        // 259（2026-10-07·#259 静态数组）：**顶层静态数组下标左值**——基址=
        //   IR_静态地址（静态槽即数组本体·259 数据段按元素×长度分配）；步进/
        //   越界经 推导下标元素类型ID/推导下标数组长度（推导成员链 259 已认
        //   静态数组）。原 查指针变量类型 miss → 落「下标左值对象未支持」。
        整64 找静左 = 0 - 1;
        结果<整64, 整32> 找静左查 = 查静态序号含类(整64(下标对象左值.文本));
        如果 (找静左查.正常) { 找静左 = 找静左查.值; } 否则 { }
        如果 (找静左 >= 0) {
            字符串 静类型左 = 字符串复制(驻留文本(取静态类型(找静左)));
            如果 (是数组类型文本(静类型左)) {
                整64 静基址左 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静基址左, T_整64,
                                     找静左));
                整64 前深度左259 = 表达式栈.大小();
                整64 下标值左259 = 生成表达式(池, 末节点.子起点 + 1, 末节点.子终点,
                                            局部槽, 参数槽, 指令, 寄存器计数,
                                            块计数, 槽计数, 表达式栈);
                当 (表达式栈.大小() > 前深度左259) {
                    结果<空类型, 整32> 删栈左259 = 表达式栈.删除(表达式栈.大小() - 1);
                    如果 (!删栈左259.正常) { 运行时错误(4); }
                }
                整64 长度左259 = 数组长度文本(静类型左);
                可选<字符串> 元素类型左259查 = 数组元素文本(静类型左);
                字符串 元素类型左259 = "";
                如果 (元素类型左259查.有值) { 元素类型左259 = 字符串复制(元素类型左259查.值); }
                整64 步进左259 = 8;
                如果 (字符串长度(元素类型左259) > 0) {
                    整64 元素ID左259 = 驻留(元素类型左259);
                    // 961（数组限界）：数组（长度非零）=内联体布局宽；指针形态
                    //   （长度 0）= 类型名宽度（948 口径·对用户类恒 8）
                    步进左259 = 类型名宽度(元素ID左259);
                    如果 (长度左259 != 0) {
                        步进左259 = 数组元素布局宽(元素ID左259);
                    }
                    如果 (步进左259 <= 0) { 步进左259 = 8; }
                }
                如果 (长度左259 > 0) {
                    发射数组越界检查(下标值左259, 长度左259, 指令, 寄存器计数,
                                    块计数);
                }
                整64 缩放左259 = 下标值左259;
                如果 (步进左259 != 1) {
                    整64 步进常量左259 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_常量整数,
                                         整64(驻留(整数转字符串(步进左259))), 0, 0,
                                         步进常量左259, T_整64, 0));
                    整64 缩放寄存器左259 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_乘, 下标值左259, 步进常量左259, 0,
                                         缩放寄存器左259, T_整64, 0));
                    缩放左259 = 缩放寄存器左259;
                }
                整64 元素地址左259 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_加, 静基址左, 缩放左259, 0, 元素地址左259,
                                     T_整64, 0));
                返回 元素地址左259;
            }
        }
        整64 查所指左 = 查指针变量类型(整64(下标对象左值.文本));
        如果 (查所指左 >= 0) {
            // 对象指针值：槽 Load（局部/参数——指针参数为普通值槽非引用）
            整64 对象槽下 = 0;
            结果<整64, 整32> 找局下 = 局部槽.获取(整64(下标对象左值.文本));
            如果 (找局下.正常) { 对象槽下 = 找局下.值; } 否则 { }
            如果 (对象槽下 == 0) {
                结果<整64, 整32> 找参下 = 参数槽.获取(整64(下标对象左值.文本));
                如果 (找参下.正常) { 对象槽下 = 找参下.值; } 否则 { }
            }
            如果 (对象槽下 != 0) {
                整64 指针值 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                // 94-a（2026-09-13）：数组对象下标左值——基址=**槽地址**（数组名
                //   退化为元素指针；数组槽里是元素数据而非指针，Load 会取首 8 字节
                //   数据当指针 → 段错误〈探针 arr1 实证：r10=0x200000009=数组内容〉）。
                //   判定=当前函数变量类型是数组文本；非数组（真指针变量）保持 Load。
                布尔 数组对象左A = 假;
                整64 对象数组类型A = 查当前函数变量类型(整64(下标对象左值.文本));
                如果 (对象数组类型A >= 0) {
                    如果 (是数组类型文本_ID(对象数组类型A)) {
                        数组对象左A = 真;
                    }
                }
                如果 (数组对象左A) {
                    IR追加(指令, 建IR指令(IR_取地址, 对象槽下, 0, 0, 指针值,
                                          T_整64, 0));
                } 否则 {
                    IR追加(指令, 建IR指令(IR_加载, 对象槽下, 0, 0, 指针值, T_整64, 0));
                }
                // 下标表达式区间 [子起点+1, 子终点)（子起点=对象单节点）；
                //   只弹到进入前深度（&p[i] 作调用实参等嵌套形态）
                整64 下标前深度 = 表达式栈.大小();
                整64 下标值左 = 生成表达式(池, 末节点.子起点 + 1, 末节点.子终点,
                                            局部槽, 参数槽, 指令, 寄存器计数,
                                            块计数, 槽计数, 表达式栈);
                当 (表达式栈.大小() > 下标前深度) {
                    结果<空类型, 整32> 删栈下 = 表达式栈.删除(表达式栈.大小() - 1);
                    如果 (!删栈下.正常) { 运行时错误(4); }
                }
                // 961（数组限界·上方数组对象左A 同源判据）：数组=布局宽（内联
                //   体）；指针数据区=类型名宽度（948 口径）
                整64 步进左 = 类型名宽度(查所指左);
                如果 (数组对象左A) { 步进左 = 数组元素布局宽(查所指左); }
                // 908（任务 092·与读侧 94-a 发射数组越界检查对称）：数组下标**写**
                //   越界检查（下标 >= 长度 → 运行时错误(2)·错误码与读侧/宿主同码）——
                //   长度经 读侧同款推导 helper（标识符数组变量/结构体字段数组同源）；
                //   指针对象无长度信息（长度 0）=不发射（读侧同口径·既有边界）。
                整64 数组长度写a = 推导下标数组长度(池, 整32(末节点.子起点));
                如果 (数组长度写a > 0) {
                    发射数组越界检查(下标值左, 数组长度写a, 指令, 寄存器计数, 块计数);
                }
                整64 缩放值左 = 下标值左;
                如果 (步进左 != 1) {
                    整64 步进常量左 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_常量整数,
                                         整64(驻留(整数转字符串(步进左))), 0, 0,
                                         步进常量左, T_整64, 0));
                    整64 缩放寄存器左 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_乘, 下标值左, 步进常量左, 0,
                                         缩放寄存器左, T_整64, 0));
                    缩放值左 = 缩放寄存器左;
                }
                整64 元素地址左 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_加, 指针值, 缩放值左, 0, 元素地址左, T_整64, 0));
                返回 元素地址左;
            }
        }
    返回 0;
}
