                寄存器计数[0] = 寄存器计数[0] + 1;
                整64 静类型码g = T_整64;
                如果 (静址g < 寄存器计数[0]) { }
                如果 (静类型名g.正常) { 静类型码g = 类型码(静类型名g.值); } 否则 {
                }
                IR追加(指令, 建IR指令(IR_指针加载, 静址g, 0, 0, 静值g, 静类型码g, 0));
                登记寄存器类型(静值g, 静类型码g);
