// CN 自举编译器 v2 · 生成表达式——字段访问族（生成方法接收者 + 生成字段访问 + 发射成员取值 + 重取成员对象基址 + 对象槽是类对象 + 成员载荷是结构体）（D1 行数整改 120-a：自 生成表达式.cn 按族拆出）
//   纯重构零行为变更（同包「多文件合并全局可见」——函数跨文件互调无障碍；
//   与主模块函数互调经包内合并池解析，见 公开: 注释同款纪律）。
导入 容器::向量;
导入 语法;
导入 IR;
导入 协议常量;   // 335 重构B：协议常量独立包

导入 IR生成;
导入 生成表达式求值;

公开:

// 成员访问两形态（R3 提取，2026-09-08）：方法接收者（P7b [this, 方法标记] 压栈）
// 104/440（070 波C）：最近方法引用静态槽（方法引用分支写·生成声明 消费登记
//   闭包变量绑定后清零——覆盖写单槽·宿主 lastLambda*_ 惯性变量同构）
静态 整64 最近方法引用符号 = 0;   // 方法符号串ID（0=无）
静态 整64 最近方法引用对象 = 0;   // 被绑定对象变量名ID
静态 整64 最近方法引用返回码 = 0; // 方法返回类型码（闭包调用返回装载用）
// 闭包变量绑定表（生成声明 消费登记·调用位展开消费——变量名ID 键）
静态 映射<整64, 整64> 方法引用符号们;
静态 映射<整64, 整64> 方法引用对象们;
静态 映射<整64, 整64> 方法引用返回码们;
// #276 波1：lambda 值捕获闭包绑定表（生成声明 消费登记·调用位展开消费——
//   变量名ID -> lambda合成名ID·宿主 closureInfo_ 表同构）
静态 映射<整64, 整64> lambda闭包变量们;

不安全 函数 生成方法接收者(向量<节点> 池, 节点 n, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                   向量<IR指令>& 指令, 整64* 寄存器计数, 向量<整64>& 表达式栈) -> 空类型 {
    // P7b 方法调用接收者（表.追加(x) 的 表.追加 部分）：弹对象值
    //   （容器变量 Load 值=堆对象指针即 this），压 [this, 方法标记]
        // P7b 方法调用接收者（表.追加(x) 的 表.追加 部分）：弹对象值
        //   （容器变量 Load 值=堆对象指针即 this），压 [this, 方法标记]
        // ②c B：对象为结构体的容器字段（b.表.追加）——接收者=字段槽首 8 字节的
        //   堆对象指针：标识符对象取槽地址/调用对象用结果基址（retbuf/视图地址），
        //   经 字段地址+指针加载 取载（指针槽模型）
        节点 对象节点m = 池.元素(整32(n.子起点));
        整64 字段取载偏移 = -1;
        整64 字段取载基址 = 0;
        如果 (对象节点m.类型 == 节点_标识符) {
            整64 结构体IDm = 解析对象结构体ID(对象节点m);
            如果 (结构体IDm != 0) {
                可选<整64> 桶偏移m查 = 查字段偏移(结构体IDm, 整64(n.文本));
                如果 (桶偏移m查.有值) {
                    字段取载偏移 = 桶偏移m查.值;
                    // 标识符对象：取结构体基槽地址（调用方/局部 多槽基址=最大槽号）
                    整64 对象槽m = 0;
                    结果<整64, 整32> 找局m = 局部槽.获取(整64(对象节点m.文本));
                    如果 (找局m.正常) { 对象槽m = 找局m.值; } 否则 { }
                    如果 (对象槽m == 0) {
                        结果<整64, 整32> 找参m = 参数槽.获取(整64(对象节点m.文本));
                        如果 (找参m.正常) { 对象槽m = 找参m.值; } 否则 { }
                    }
                    如果 (对象槽m != 0) {
                        整64 基址reg = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        // ②c D：结构体& 引用参数——槽内容即基址（Load 槽），非槽地址
                        如果 (槽是引用(对象槽m)) {
                            IR追加(指令, 建IR指令(IR_加载, 对象槽m, 0, 0, 基址reg, T_整64, 0));
                        } 否则 {
                            IR追加(指令, 建IR指令(IR_取地址, 对象槽m, 0, 0, 基址reg, T_整64, 0));
                        }
                        字段取载基址 = 基址reg;
                    }
                }
            }
        } 否则 如果 (对象节点m.类型 == 节点_调用) {
            // 调用对象：返回结构体的容器字段（词池.元素(0).表.追加）——
            //   弹出的调用结果寄存器（retbuf/视图地址）即基址
            整64 返回结构体IDm = 解析调用返回结构体(池, 整32(n.子起点));
            如果 (返回结构体IDm != 0 && 查结构体大小(返回结构体IDm) != 0) {
                可选<整64> 桶偏移m2查 = 查字段偏移(返回结构体IDm, 整64(n.文本));
                如果 (桶偏移m2查.有值) {
                    字段取载偏移 = 桶偏移m2查.值;
                    字段取载基址 = -1;   // 栈顶（弹出的对象值）即基址
                }
            }
        }
        // 040（082①·001 §5.8 甲案·2026-10-05）：成员被调=结构体 fnptr 字段 →
        //   仅压 fnptr 字段值（不压方法标记）——调用分派 被调>=0 走 T69
        //   发射间接调用480；原恒方法框架=方法表 miss 垃圾目标（probe603 实证
        //   打印(结构体.fnptr(...)) 实参=函数地址）。栈形：弹已压对象值后压值。
        // 491（742d 面外·宿主同形态全过=零分叉收口）：对象形态扩三路——
        //   ①标识符（局部/参数槽·原逻辑）②标识符且静态结构体（IR_静态地址·
        //   87-a 地址语义）③调用返回（造包裹().fn(...)——栈顶对象值即基址）。
        //   原只认①：②走方法框架运行时跳伪地址 C0000005（probe491_p_n 实录）、
        //   ③编译期「方法调用对象类型未解析」（probe491_p_m 实录）。
        如果 (字段取载偏移 >= 0 &&
             (对象节点m.类型 == 节点_标识符 || 对象节点m.类型 == 节点_调用)) {
            整64 结构体IDf480 = 0;
            整64 静态序f480 = 0 - 1;
            如果 (对象节点m.类型 == 节点_标识符) {
                // ②静态结构体对象：静态序号查询独立先行（局部/参数槽 miss 才
                //   落静态；解析对象结构体ID 经变量结构体表可能已命中静态名，
                //   故静态序不依赖其 miss 与否——probe491_p_n 首版顺序误致 miss）
                结果<整64, 整32> 静查f480 = 查静态序号含类(整64(对象节点m.文本));
                如果 (静查f480.正常) { 静态序f480 = 静查f480.值; } 否则 { }
                如果 (静态序f480 < 0 && 当前方法类名ID != 0) {
                    // 070 波G：类内静态字段裸名（合成名槽）
                    结果<整64, 整32> 合成f480 = 查类静态字段合成名(
                        当前方法类名ID, 整64(对象节点m.文本));
                    如果 (合成f480.正常) {
                        结果<整64, 整32> 静查f480b = 查静态序号含类(合成f480.值);
                        如果 (静查f480b.正常) { 静态序f480 = 静查f480b.值; } 否则 { }
                    } 否则 {
                    }
                }
                结构体IDf480 = 解析对象结构体ID(对象节点m);
                如果 (结构体IDf480 == 0 && 静态序f480 >= 0) {
                    结构体IDf480 = 查结构体类型(取静态类型(静态序f480));
                }
            } 否则 {
                结构体IDf480 = 解析调用返回结构体(池, 整32(n.子起点));
            }
            整64 字段类型f480 = 0;
            如果 (结构体IDf480 != 0) { 字段类型f480 = 查字段类型ID(结构体IDf480, 整64(n.文本)); }
            如果 (字段类型f480 > 0 &&
                 字符串长度(驻留文本(字段类型f480)) >= 16 &&
                 字符串比较(字符串子串(驻留文本(字段类型f480), 0, 13), "函数指针<")) {
                // 基址三路**先预判后弹栈**（净栈契约零违反——未就绪不弹）：
                //   ③调用返回=栈顶对象值（复用作基址）；①局部/参数对象槽；
                //   ②静态序号（IR_静态地址 87-a）
                整64 基址f480 = 0;
                布尔 基址就绪480 = 假;
                整64 对象槽f480 = 0;
                布尔 槽引用f480 = 假;
                如果 (对象节点m.类型 == 节点_调用) {
                    如果 (表达式栈.大小() >= 1) {
                        基址f480 = 表达式栈.元素(表达式栈.大小() - 1);
                        基址就绪480 = 真;
                    }
                } 否则 {
                    结果<整64, 整32> 找局f480 = 局部槽.获取(整64(对象节点m.文本));
                    如果 (找局f480.正常) { 对象槽f480 = 找局f480.值; } 否则 { }
                    如果 (对象槽f480 == 0) {
                        结果<整64, 整32> 找参f480 = 参数槽.获取(整64(对象节点m.文本));
                        如果 (找参f480.正常) { 对象槽f480 = 找参f480.值; } 否则 { }
                    }
                    如果 (对象槽f480 != 0) {
                        槽引用f480 = 槽是引用(对象槽f480);
                        基址就绪480 = 真;
                    } 否则 如果 (静态序f480 >= 0) {
                        基址就绪480 = 真;
                    }
                }
                如果 (!基址就绪480) {
                    // 不可达形态显形（miss 不可静默）：字段类型已判 fnptr 而基址
                    //   三路全 miss（对象槽/静态序/栈顶值均无）=编译器缺陷面，
                    //   IR 层错误中止产物。栈面保持原状（未弹——净栈契约零违反，
                    //   下方公共路径按原「方法框架」处理）。
                    IR层诊断("成员被调结构体基址未解析: ." +
                            驻留文本(整64(n.文本)));
                } 否则 {
                    // 就绪：弹掉对象值（③=已复用作基址；①/②=对象表达式产物丢弃）
                    如果 (表达式栈.大小() >= 1) {
                        结果<空类型, 整32> 删对f480 = 表达式栈.删除(表达式栈.大小() - 1);
                        如果 (!删对f480.正常) { 运行时错误(4); }
                    }
                    如果 (对象节点m.类型 == 节点_标识符 && 对象槽f480 == 0) {
                        // ②静态：IR_静态地址（就地物化为基址寄存器）
                        整64 静址f480 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静址f480, T_整64,
                                             静态序f480));
                        基址f480 = 静址f480;
                    } 否则 如果 (对象节点m.类型 == 节点_标识符) {
                        // ①局部/参数槽：引用=加载（槽内容即基址）/否则槽地址
                        整64 槽基址f480 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        如果 (槽引用f480) {
                            IR追加(指令, 建IR指令(IR_加载, 对象槽f480, 0, 0,
                                                 槽基址f480, T_整64, 0));
                        } 否则 {
                            IR追加(指令, 建IR指令(IR_取地址, 对象槽f480, 0, 0,
                                                 槽基址f480, T_整64, 0));
                        }
                        基址f480 = 槽基址f480;
                    }
                    整64 字段地址f480 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_字段地址, 基址f480, 0, 0, 字段地址f480, T_整64, 字段取载偏移));
                    整64 值f480 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_指针加载, 字段地址f480, 0, 0, 值f480, T_整64, 0));
                    结果<空类型, 整32> 加值f480 = 表达式栈.追加(值f480);
                    如果 (!加值f480.正常) { 运行时错误(4); }
                    返回;
                }
            }
        }
        整64 对象值 = 0;
        如果 (表达式栈.大小() >= 1) {
            对象值 = 表达式栈.元素(表达式栈.大小() - 1);
            结果<空类型, 整32> 删对 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删对.正常) { 运行时错误(4); }
        }
        如果 (字段取载偏移 >= 0 && (字段取载基址 > 0 || 字段取载基址 == -1)) {
            // 字段首 8 字节的堆对象指针 -> this
            整64 基址值 = 对象值;
            如果 (字段取载基址 > 0) { 基址值 = 字段取载基址; }
            整64 字段地址reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_字段地址, 基址值, 0, 0, 字段地址reg, T_整64, 字段取载偏移));
            整64 对象指针reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 字段地址reg, 0, 0, 对象指针reg, T_对象, 0));
            对象值 = 对象指针reg;
        }
        结果<空类型, 整32> 加对 = 表达式栈.追加(对象值);
        如果 (!加对.正常) { 运行时错误(4); }
        结果<空类型, 整32> 加标 = 表达式栈.追加(0 - (1000000 + 整64(n.文本)));
        如果 (!加标.正常) { 运行时错误(4); }
}

// 字段访问右值（.字段/.->字段）：三源分桶布局判定+结果/可选 兜底+取值发射
// 615（2026-10-16）：尾追加 成员索引（成员节点池索引——链层级公式 k 计数用；
//   调用点唯一=生成表达式主循环传当前位置）
不安全 函数 生成字段访问(向量<节点> 池, 节点 n, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                 向量<IR指令>& 指令, 整64* 寄存器计数, 向量<整64>& 表达式栈,
                 整64 成员索引) -> 空类型 {
    节点 对象节点 = 池.元素(n.子起点);  // 子起点=对象节点索引（P6c 解析时记录）
    整64 基址寄存器 = 0;
    // 195-a：本函数 164 行按「三元组推导→结果/可选 兜底→右值偏移兜底」
    //   提取为 3 个族子方法（纯搬运零行为变更——多重集核验先行于构建）。
    // P7b：对象是 结果/可选 变量 -> 字段偏移按合成布局（正常@0 布尔宽度；
    //   值/错误@联合偏移 4/8——IR容器.结果值偏移）。对象类型取语法层
    //   预标注（节点.子终点=对象类型ID，语法分析 解析后缀链 登记）
    整64 字段偏移量 = n.附加;
    整64 加载类型 = T_整64;
    整64 成员对象类型ID = 0;
    整64 成员值码 = T_未知;
    解析字段三元组(池, n, 对象节点, 字段偏移量, 加载类型, 成员对象类型ID, 成员值码);
    解析结果可选兜底(池, n, 对象节点, 成员对象类型ID, 字段偏移量, 加载类型, 成员值码);
    // 第17枚根治·右值偏移兜底（2026-09-06）：结果类型兜底后仍 -1 -> 分桶查
    //   （解析对象结构体ID——指针参数经权威表同样命中）；仍未知即 IR 层诊断
    //   拒绝发射（附加=-1 = 基址-1 毒地址，写穿相邻槽，[ir2] 产物不可信纪律）
    解析右值偏移兜底(池, n, 对象节点, 字段偏移量, 加载类型, 成员值码);
    // 104/440（070 波C·1022 深度机）：实例方法引用（对象.方法 作值·宿主
    //   ir_oop_field.cpp P3-23 补完同构）——字段表 miss 后查类方法表：命中
    //   =方法引用（绑定 this 闭包）→ 写 最近方法引用* 静态槽（生成声明 消费
    //   登记闭包变量绑定）+发射 IR_函数地址(方法符号)（表达式值=方法链接符号
    //   ·宿主 lastExpr_ FuncAddr 同款）；调用位展开=生成表达式求值
    //   方法引用闭包调用展开（this=对象槽+用户实参直调方法符号）。
    如果 (字段偏移量 < 0 && 对象节点.类型 == 节点_标识符) {
        // 070 波G：类名.静态字段读——对象=用户类名（非变量遮蔽·93-a 判据同构）
        //   且 类静态字段表命中 → 静态槽读（IR_静态地址+指针加载·合成名「类$字段」）
        整64 类名读IDg = 整64(对象节点.文本);
        如果 (是用户类_ID(类名读IDg)) {
            结果<整64, 整32> 合成读g = 查类静态字段合成名(类名读IDg, 整64(n.文本));
            整64 序读g = 0 - 1;
            如果 (合成读g.正常) {
                结果<整64, 整32> 序读gr = 查静态序号含类(合成读g.值);
                如果 (序读gr.正常) { 序读g = 序读gr.值; } 否则 { }
            } 否则 {
            }
            如果 (序读g >= 0) {
                // 弹掉对象表达式栈顶（类名 Load miss=负占位垃圾·丢弃）
                如果 (表达式栈.大小() >= 1) {
                    结果<空类型, 整32> 删类名g = 表达式栈.删除(表达式栈.大小() - 1);
                    如果 (!删类名g.正常) { 运行时错误(4); }
                }
                整64 静址g = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 静址g, T_整64, 序读g));
                // 642（2026-10-16）：128 位类静态字段——值=**槽地址**（与顶层
                //   静态 128 引用 810 语义同款：消费点按 T_整128/T_正128 直接
                //   以地址传参/打印）；原落下方 指针加载=8 字节半槽读（打印
                //   __cn_print_i128 得半槽值+脏高位·m642b 探针产物崩溃
                //   0xC0000005 实锚）。≤64 位标量维持 指针加载 按类型宽度。
                结果<整64, 整32> 静类型名g = 查类静态字段类型(类名读IDg, 整64(n.文本));
                如果 (静类型名g.正常 &&
                    (字符串比较(字符串复制(驻留文本(静类型名g.值)), "整128") ||
                     字符串比较(字符串复制(驻留文本(静类型名g.值)), "正128"))) {
                    登记寄存器类型(静址g, 类型码(静类型名g.值));
                    结果<空类型, 整32> 加静值g128 = 表达式栈.追加(静址g);
                    如果 (!加静值g128.正常) { 运行时错误(4); }
