        如果 (!删.正常) { 运行时错误(4); }
    }
    // 203（021 任务 203·宿主 flushPendingArgCleanups 同构）：基址=容器/函数
    //   调用返回物化临时（结构体返回临时们 命中）且被本字段链中间跳消费——
    //   登记 表达式物化临时们（外层调用发射完成后释放其串字段副本）。
    //   赋值位接收（盒子 读=表.元素(0)）不经本路径·82-b 浅拷接管语义不受影响；
    //   命中即登记不删原表条目——975 实参清理（若该 reg 后续直接作实参）幂等。
    如果 (基址寄存器 != 0) {
        结果<整64, 整32> 查物化203 = 结构体返回临时们.获取(基址寄存器);
        如果 (查物化203.正常) {
            结果<空类型, 整32> 加物203 = 表达式物化临时们.追加(基址寄存器);
            如果 (!加物203.正常) { 运行时错误(4); }
            加物203 = 表达式物化临时们.追加(查物化203.值);
            如果 (!加物203.正常) { 运行时错误(4); }
        }
        否则 {
        }
    }
    如果 (对象节点.类型 == 节点_标识符) {
        // 标识符对象：栈顶是 Load 值，需重新取槽地址（结构体存于槽）。
        //   ②c D：结构体& 引用参数/指针参数——栈顶即基址，不再取槽地址（R3 提取）
        基址寄存器 = 重取成员对象基址(池, 对象节点, 基址寄存器, 局部槽, 参数槽,
                                        指令, 寄存器计数,
                                        整64(n.子起点), 成员索引);
    }
    整64 寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    // 991（008 挂账②·094 空安全）：串字段=串空安全专发（IR_串字段地址=
    //   字段地址判空豁免形态·串句柄 0=空串·运行时串函数已容错）——
    //   非串字段维持 IR_字段地址（判空=真悬垂防御）
    如果 (加载类型 == T_字符串) {
        IR追加(指令, 建IR指令(IR_串字段地址, 基址寄存器, 0, 0, 寄存器, T_整64, 字段偏移量));
    } 否则 {
        IR追加(指令, 建IR指令(IR_字段地址, 基址寄存器, 0, 0, 寄存器, T_整64, 字段偏移量));
    }
    // 成员访问作为右值：字段地址 -> 立即取值（压值；赋值左值走专用路径）。
    //   2026-09-06 根治（v2self 表查找类型ID 崩溃）：对象为 结果/可选 且
    //   成员为 值/错误 且载荷=结构体（查.值——符号 32B）——压**字段地址**
    //   不 LoadPtr（原无条件取 8 字节=载荷首字段值当地址，结构体拷贝源=
    //   小整数（47=名ID）-> SIGSEGV；注释 2134 声明的语义至此真正实现）
    布尔 载荷是结构体 = 成员载荷是结构体(池, n, 对象节点, 成员对象类型ID);
    // 97-a（2026-09-13 第九十七轮 C8）：结构体**字段数组**——压字段地址**不加载**
    //   （宿主 ir_oop「数组字段退化：返回地址（供 字段[i] 下标访问）」同款；
    //   成员链 记录.分数[0] 的下标基址消费）。原实现按元素宽度加载首元素值
    //   当地址 -> 后续下标解引用垃圾地址。
    布尔 字段是数组97 = 假;
    // 658① 读侧（2026-10-14·#658）：**字段=合成体（可选/结果）**——压字段地址
    //   不取值（内联值槽 place 链·与写侧 尝试成员合成体整体写/出口级联释放
    //   同一内联模型）。原 IR_指针加载 8B 把 tag+载荷半当句柄压栈=指针槽侥幸读
    //   （与写侧「临时槽基址直存」配对自洽·但栈临时地址进堆对象=悬垂+级联
    //   释放 miss·904 形二三 56≠120 实锤）；第二层成员（.正常/.值/.错误）经
    //   解析结果可选兜底 内联偏移读取（局部合成体同款）。
    布尔 字段合成体658 = 假;
    如果 (字段偏移量 >= 0) {
        整64 字段结构体97 = 解析成员链结构体ID(池, 整32(n.子起点));
        如果 (字段结构体97 != 0) {
            整64 字段类型97 = 查字段类型ID(字段结构体97, 整64(n.文本));
            如果 (字段类型97 != 0) {
                字符串 字段文97 = 字符串复制(驻留文本(字段类型97));
                如果 (是数组类型文本(字段文97)) {
                    字段是数组97 = 真;
                } 否则 如果 (是结果类型(字段文97) || 是可选类型(字段文97)) {
                    字段合成体658 = 真;
                }
            }
        }
    }
    发射成员取值(指令, 寄存器计数, 寄存器, 加载类型, 成员值码,
                 载荷是结构体 || 字段是数组97 || 字段合成体658, 表达式栈);
}

// 912（重复归纳·值发射单点）：静态方法引用**值发射**——IR_函数地址(方法符号
//   类$名[参数串]) 压栈+类型登记（静态无 this 绑定=纯函数地址；**不写** 最近
//   方法引用* 槽——静态引用不登记闭包绑定，声明位按普通函数指针初值直通）。
//   消费点三处：生成标识符加载 :: 限定值（生成表达式.cn 070 波G 余波 1026 与
//   1007 两分支·912 归纳收口）+ 生成字段访问 点号形态（912 新增·对象=用户类名
//   分流）。符号公式与调用位静态直调（生成方法调用 070 波G）/宿主 P3-23 静态
//   作值 FuncAddr 单一同源。
不安全 函数 发射静态方法引用值(整64 类名ID, 整64 方法名ID,
                   向量<IR指令>& 指令, 整64* 寄存器计数,
                   向量<整64>& 表达式栈) -> 空类型 {
    整64 参数串ID = 查类方法参数串(类名ID, 方法名ID);
    字符串 参数串 = "";
    如果 (参数串ID != 0) { 参数串 = 字符串复制(驻留文本(参数串ID)); }
    字符串 方法符号串 = 方法符号(字符串复制(驻留文本(类名ID)),
                                  字符串复制(驻留文本(方法名ID)),
                                  参数串);
    整64 函址寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_函数地址, 0, 0, 0, 函址寄存器, T_整64,
                         驻留(方法符号串)));
    登记寄存器类型(函址寄存器, T_整64);
    结果<空类型, 整32> 加函址 = 表达式栈.追加(函址寄存器);
    如果 (!加函址.正常) { 运行时错误(4); }
}

// ==================== 195-a 族子方法（原 生成字段访问 100~213 段） ====================

// 491（先拆再加）：族①/②/③ 三子方法（解析字段三元组·解析结果可选兜底·
//   解析右值偏移兜底）已纯机械搬移「生成表达式字段解析.cn」（函数体逐字
//   保留·零逻辑变化——本文件贴 1000 冻结线，491 改动触发拆分）。


// 成员取值发射：结果/可选 结构体载荷（.值/.错误 且载荷=结构体）压字段地址
//   不取值（2026-09-06 根治：LoadPtr 取 8 字节=载荷首字段值当地址 -> SIGSEGV）；
//   普通字段 IR_指针加载 + ③ 第二波 类型登记（字段声明类型/结果载荷类型——
//   缺陷①同族根治：字符串字段未登记 -> print_int 打指针值）。
不安全 函数 发射成员取值(向量<IR指令>& 指令, 整64* 寄存器计数, 整64 字段地址寄存器, 整64 加载类型,
                 整64 成员值码, 布尔 载荷是结构体, 向量<整64>& 表达式栈) -> 空类型 {
    如果 (载荷是结构体) {
        结果<空类型, 整32> 加m = 表达式栈.追加(字段地址寄存器);
        如果 (!加m.正常) { 运行时错误(4); }
        返回;
    }
    // 810（053）：128 位字段取值——值=**字段地址**（16 字节槽整块可寻址·不
    //   取 8 字节值），登记 T_整128/T_正128——打印传址/赋值双半拷/实参物化
    //   全消费点按「值=地址」语义（同「载荷是结构体」模式；原 8 字节装载+
    //   类型登记 T_整128 → 打印当句柄读垃圾·420-③ 乙.值 实证）。
    如果 (成员值码 == T_整128 || 成员值码 == T_正128) {
        登记寄存器类型(字段地址寄存器, 成员值码);
        结果<空类型, 整32> 加m128 = 表达式栈.追加(字段地址寄存器);
        如果 (!加m128.正常) { 运行时错误(4); }
        返回;
    }
    整64 值寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 字段地址寄存器, 0, 0, 值寄存器, 加载类型, 0));
    如果 (成员值码 != T_未知) {
        登记寄存器类型(值寄存器, 成员值码);
    }
    结果<空类型, 整32> 加 = 表达式栈.追加(值寄存器);
    如果 (!加.正常) { 运行时错误(4); }
}

// 标识符对象的字段基址重取：栈顶是 Load 值，需取槽地址（结构体存于槽）。
//   ②c D：结构体& 引用参数——槽内容即调用方结构体基址（已按引用发射），栈顶即基址；
//   指针参数 p.字段——栈顶=装载的指针值（≡(*p).字段），同不取槽地址。返回 新基址。
不安全 函数 重取成员对象基址(向量<节点> 池, 节点 对象节点, 整64 弹出基址, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                     向量<IR指令>& 指令, 整64* 寄存器计数,
                     整64 对象索引R, 整64 成员索引R) -> 整64 {
    整64 基址寄存器 = 弹出基址;
    整64 对象槽 = 0;
    结果<整64, 整32> 找局 = 局部槽.获取(整64(对象节点.文本));
    如果 (找局.正常) { 对象槽 = 找局.值; } 否则 { }
    如果 (对象槽 == 0) {
        结果<整64, 整32> 找参 = 参数槽.获取(整64(对象节点.文本));
        如果 (找参.正常) { 对象槽 = 找参.值; } 否则 { }
    }
    // 293-a（T34 第二缺口·2026-09-17）：方法体成员链根「自身」——镜像顺序链
    //   标识符地址 的同名特判：局部/参数全 miss 且在方法体内→栈顶（标识符段
    //   已加载 this 槽值）即对象基址。原实现 fall-through 尾端 IR_取地址(哨兵
    //   槽)=成员读垃圾值（50 读取() asm 铁证：返回 自身.计数 读方法帧槽）。
    如果 (对象槽 == 0 && 当前方法类名ID != 0 &&
         整64(对象节点.文本) == 整64(驻留("自身"))) {
        返回 基址寄存器;
    }
    // 87-a（2026-09-12 第八十七轮）：顶层静态结构体对象——标识符读取已生成
    //   IR_静态地址（**值即地址**），栈顶即基址，不再取槽地址。原实现落尾端
    //   兜底「取对象槽 0 地址」——静态成员读写出垃圾基址（探针 P50b v2 实证：
    //   甲.名 读库符号串）。与 引用参数/指针参数「栈顶即基址」同款分流。
    如果 (对象槽 == 0) {
        整64 找静基 = 0 - 1;
        结果<整64, 整32> 找静基查 = 查静态序号含类(整64(对象节点.文本));
        如果 (找静基查.正常) { 找静基 = 找静基查.值; } 否则 { }
        如果 (找静基 >= 0 && 查结构体大小(取静态类型(找静基)) > 0) {
            返回 基址寄存器;
        }
        // 890-a（002 攻族·537 C 段根治）：**静态合成体**（结果/可选）成员基址
        //   ——标识符读取已发 IR_静态加载（槽内容=对象指针·值即地址），栈顶即
        //   基址（类/容器静态同款指针槽模型）。原判据只认结构体 → 落尾端
        //   「取地址 槽0」=未初始化帧槽：`全局缓存.值` 读该帧槽+偏移（537 C 段
        //   v2 值=0·888 层⑨登记实证）。
        如果 (找静基 >= 0 &&
             是结果类型(字符串复制(驻留文本(取静态类型(找静基))))) {
            返回 基址寄存器;
        }
        // 972：静态类/容器——基址寄存器=IR_静态加载产物（槽内容=句柄），
        //   直接复用（与合成体同款：装载即基址）。
        如果 (找静基 >= 0) {
            字符串 静类文本972 = 字符串复制(驻留文本(取静态类型(找静基)));
            如果 (是用户类(静类文本972)) {
                返回 基址寄存器;
            }
        }
    }
    // 510-a（T80·v2 侧·与 293-a「自身」特判同族）：方法体内**类字段名裸标识符**
    //   作成员链基址（`内.y`·字段类型=结构体）——基址=this 槽加载+字段偏移
    //   （发射类字段地址）；原落尾端兜底「取对象槽 0 地址」→ 成员读垃圾
    //   （探针 `盒{点 内; 读(){ 返回 内.y; }}` 产物 `lea r10,[rbp-128]`+8 实证）。
    // 381 第三层（2026-10-10·深度机）：**类指针字段**作链根（`树.键们.追加`·
    //   树 字段类型=JSON树*）——基址=**字段槽内容**（所指对象指针），非槽地址；
    //   原 510-a 对指针字段同样发射槽地址 → 下一跳偏移加在 &this.树 上 →
    //   load this+0x20+0x30 越界垃圾（解析对象 `树.键们.追加` 段错误·asm 铁证
    //   rep movsb 源=垃圾 0x400000006）。判星=查字段类型ID 尾字符（与 346-a
    //   381 排除段同写法）；结构体字段（无星·值语义内嵌）维持槽地址原行为。
    如果 (对象槽 == 0 && 当前方法类名ID != 0) {
        可选<整64> 字段偏移m510查 = 当前方法字段偏移(整64(对象节点.文本));
        如果 (字段偏移m510查.有值) {
            整64 字段偏移m510 = 字段偏移m510查.值;
            整64 字段址m510 = 发射类字段地址(字段偏移m510, 指令, 寄存器计数);
            布尔 字段带星m510 = 假;
            整64 声明类型m510 = 查字段类型ID(当前方法类名ID, 整64(对象节点.文本));
            如果 (声明类型m510 != 0) {
                字符串 声明文本m510 = 字符串复制(驻留文本(声明类型m510));
                如果 (字符串长度(声明文本m510) > 1 &&
                     (整64(声明文本m510[字符串长度(声明文本m510) - 1]) & 255) == 42) {
                    字段带星m510 = 真;
                }
                // 914 回归修复（2026-10-18·932 段F 双编译对照红）：**用户类字段
                //   与指针字段同解引语义**——用户类字段=8 字节堆句柄槽（838/843
                //   指针槽模型·左值面 847②b/594 同口径），成员链基址须装载槽
                //   内容；原只排「带星」→ 用户类字段返回槽地址（内联值语义
                //   残留）→ 链偏移加在壳基址上：932 段F 方法内 `内嵌.b` 读
                //   [壳+8] 越界堆垃圾（对照宿主 [句柄+8]=0）。结构体字段
                //   （无星·值语义内嵌）维持槽地址原行为（零行为变更）。
                如果 (字段带星m510 == 假 && 是用户类(声明文本m510)) {
                    字段带星m510 = 真;
                }
            }
            如果 (字段带星m510) {
                整64 指针m510 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_指针加载, 字段址m510, 0, 0, 指针m510, T_对象, 0));
                返回 指针m510;
            }
            返回 字段址m510;
        }
    }
    如果 (对象槽 != 0 && 槽是引用(对象槽)) {
        // 引用参数：弹栈时 基址寄存器 已持有槽内容（=调用方结构体基址）
        // 067-003 历史注记（543 t1 修复·2026-09-28）：本处曾加「用户类引用形参成员
        //   基址 +1 层 PtrLoad」（`引用参数是类引用` 判据）——当时 v2 与宿主 058-ⅡA
        //   类引用两级 load 对齐所需。**847 四件套（A 被调侧+B 调用侧）统一「引用
        //   参数实参=对象指针」后，本层多余**（撤除实测 543/545 仍 PASS）→ 按
        //   「不保留半截机制」删除；判据函数 引用参数是类引用 同步删除（IR生成.cn）。
    } 否则 如果 (对象槽 != 0 && (槽是指针参数(对象槽) ||
                             局部真指针87(整64(对象节点.文本)))) {
        // 第17枚根治：指针参数 p.字段——栈顶=标识符读取装载的指针值，不再取槽地址
        // 871-a（070·G-N·870 修复·134 前置）：**局部指针变量** q.字段 同款——
        //   栈顶=标识符读取装载的指针值（对象地址）即基址；原落尾端取槽地址兜底
        //   → 字段地址=栈槽地址+偏移 → 读到字段值附近 → VEH fault=0x140000000A
        //   （字段值被当地址解引用·134 段一实锤）。
        // 615（2026-10-16·882 回归修正）：**层级公式统一**——读路径总数=min(N,
        //   k+1)（N=变量指针层数、k=链区间 [对象索引R+1, 成员索引R) 显式解引用
        //   段数：哨兵=被归一的显式 * 段 + 存活解引用节点数——与写路径
        //   顺序链标识符地址 同款计数）。标识符读取已解 1 层，本段补
        //   min(N,k+1)-1 次指针加载（N=1/k=0 零补=既有行为不变）。
        //   推导：`.x` 基址=«显式 k 层后仍为指针时自动再解一级»=min(k+1, N) 层
        //   （k=N-1 自动层存在；k=N 直接字段）；合法面（语义层 N-k>=2 已拦）
        //   恰好 k∈{N-1,N}。修前按 N 全量补=多补（(**pp).字段 会过解一层）。
        // 615：读路径补层公式（882 回归修正·顺序标尺实证）——主循环对链上
        //   **存活解引用段**已各解 1 层（生成一元运算·norm 后外层被哨兵化），
        //   栈顶=«读值 1 + 存活段数»层；正确基址=min(k+1, N) 层
        //   （k=哨兵+存活段数）。补=min(k+1,N)-(1+存活数)；k=0（直接 q.x）
        //   与「非指针对象」零补=既有行为不变。
        整64 补R615 = 0;
        可选<整64> NR查615 = 查指针变量层数(整64(对象节点.文本));
        如果 (NR查615.有值 && NR查615.值 >= 1 && NR查615.值 <= 255) {
            整64 kR615 = 0;
            整64 存活R615 = 0;
            整64 扫R615 = 对象索引R + 1;
            当 (扫R615 < 成员索引R) {
                节点 段R615 = 池.元素(整32(扫R615));
                如果 (段R615.类型 == 节点_哨兵) {
                    kR615++;
                } 否则 如果 (段R615.类型 == 节点_解引用) {
                    kR615++;
                    存活R615++;
                }
                扫R615++;
            }
            如果 (kR615 >= 1) {
                整64 正确R615 = kR615 + 1;
                如果 (NR查615.值 < 正确R615) { 正确R615 = NR查615.值; }
                补R615 = 正确R615 - 1 - 存活R615;
                如果 (补R615 < 0) { 补R615 = 0; }
            }
        }
        整64 基M615 = 基址寄存器;
        整64 iR615 = 0;
        当 (iR615 < 补R615) {
            整64 下一R615 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 基M615, 0, 0, 下一R615,
                                 T_对象, 0));
            基M615 = 下一R615;
            iR615++;
        }
        基址寄存器 = 基M615;
    } 否则 如果 (对象槽 != 0 && 对象槽是类对象(整64(对象节点.文本))) {
        // 第七十八轮（2026-09-12）：用户类对象成员访问——槽内容=堆对象指针
        //   （对象语义同容器：Load 即基址；结构体值语义走 取地址 槽。原路径
        //   取槽地址=传栈地址给字段访问/方法 this=段错误实证——228 用例）
        整64 指针寄存器2 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_加载, 对象槽, 0, 0, 指针寄存器2, T_对象, 0));
        基址寄存器 = 指针寄存器2;
    } 否则 {
        整64 地址寄存器2 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_取地址, 对象槽, 0, 0, 地址寄存器2, T_整64, 0));
        基址寄存器 = 地址寄存器2;
    }
    返回 基址寄存器;
}

// 标识符名字是否为用户类对象（权威表类型 -> 用户类判定——成员基址指针语义分派用）
函数 对象槽是类对象(整64 名ID) -> 布尔 {
    可选<整64> 类型IDc查 = 查当前函数变量类型(名ID);
    // 无值=非本函数变量（原 ==0 判据漏 -1——统一按「非用户类对象」处置）
    如果 (!类型IDc查.有值) { 返回 假; }
    整64 类型IDc = 类型IDc查.值;
    如果 (类型IDc == 0) { 返回 假; }
    返回 是用户类_ID(类型IDc);
}

// 结果/可选 载荷成员（.值/.错误）且载荷为结构体时，成员访问压字段地址不取值
//   （2026-09-06 根治：载荷结构体若 LoadPtr 取 8 字节=载荷首字段值当地址 -> SIGSEGV）
函数 成员载荷是结构体(向量<节点> 池, 节点 n, 节点 对象节点, 整64 成员对象类型ID) -> 布尔 {
    // 964（920 呈报形态②③根治·判据单点）：对象形态门槛撤销——合成体判定
    //   数据源=成员对象类型ID（解析字段三元组 对 标识符/成员链/下标/调用 四
    //   形态同源回填：标识符=变量类型；成员链=推导成员链类型ID；下标=元素
    //   类型 200/233）。原只认标识符 → 链中间合成体（甲.值槽.值 / 直元[0].值）
    //   不判「载荷是结构体」→ IR_指针加载 8B 把内联载荷首 8B 当**标量值**压栈
    //   （tag+载荷混读）→ 下一跳基址=该值再解引用=多一级（920 呈报实录：
    //   RAX=载荷值当指针 C0000005/rc139）。非结果对象形态落下方第二分支=
    //   原行为零变化（成员对象类型ID=普通结构体/类 ID 时 是结果类型 恒假）。
    如果 (成员对象类型ID != 0) {
        字符串 对象类型文本2 = 字符串复制(驻留文本(成员对象类型ID));
        如果 (是结果类型(对象类型文本2)) {
            字符串 成员名文本2 = 字符串复制(驻留文本(整64(n.文本)));
            如果 (字符串比较(成员名文本2, "正常") || 字符串比较(成员名文本2, "有值") ||
                 字符串比较(成员名文本2, "是否某些")) { 返回 假; }
            字符串 载荷类型 = 合成名首实参(对象类型文本2);
            // 194 修①（114 实锤·v2 C0000005 读违例·asm 对位铁证）：与
            //   解析结果可选兜底（067-003 切分歧义修复）同款分流——结果 的
            //   首实参含 T+E 两段（「结果$符号$整32」→首实参「符号$整32」），
            //   裸首实参查结构体大小=0 → 误判「载荷非结构体」走取值路径压值
            //   → 外层链把值当地址再解引用（114：load [&查+8]=名ID 5 →
            //   [5] 崩）。分流：.值=段首 切 T、.错误=段余 切 E；可选 单参
            //   全串（嵌套可选保「可选$盒子」整段）。
            布尔 是结果形态c = 假;
            如果 (字符串长度(对象类型文本2) >= 7) {
                如果 (字符串比较(字符串子串(对象类型文本2, 0, 7), "结果$") ||
                     字符串比较(字符串子串(对象类型文本2, 0, 7), "结果<")) {
                    是结果形态c = 真;
                }
            }
            如果 (是结果形态c) {
                如果 (字符串比较(成员名文本2, "错误")) {
                    载荷类型 = 段余(载荷类型);
                } 否则 {
                    载荷类型 = 段首(载荷类型);
                }
            }
            // 067-003 第 7 面（类载荷恒 load·058-ⅡA 同构）：类在结构体大小表
            //   非零——查结构体大小 命中会误判「结构体载荷压地址」（543 t1
            //   内.值 实证包槽多一层）。类载荷=句柄语义恒 load。
            如果 (是用户类(载荷类型)) { 返回 假; }
            // 067-003 补：合成体载荷（嵌套可选/结果）=值语义数据本体——须压地址
            //   位拷（16B），原落「加载 8B 句柄」→ 把载荷数据当句柄解引用
            //   （544 双层 VEH：0x101 指针加载→垃圾句柄崩）。
            如果 (是结果类型(载荷类型)) { 返回 真; }
            返回 查结构体大小(驻留(载荷类型)) != 0;
        }
    }
    // 46-a 根治（2026-09-09 第四十八轮）：成员字段类型是结构体即压地址不取值
    //   （v2 结构体值以地址传递的既定约定，与 实参通道 回扫字段地址形态/容器
    //   类字段指针读 三方一致）。原仅 结果.值 特判：普通结构体成员（点 t =
    //   r.左上）被 LoadPtr 取 8 字节值——声明位把该值当源地址结构体拷贝=
    //   解引用垃圾地址段错误（win 0xC0000005/linux rc=139 实锤）。对象解析经
    //   解析成员链结构体ID（186 根治产物）统一覆盖 标识符/成员链/调用 三形态。
    整64 成员链结构体ID = 解析成员链结构体ID(池, 整32(n.子起点));
    如果 (成员链结构体ID != 0) {
        整64 字段类型ID48 = 查字段类型ID(成员链结构体ID, 整64(n.文本));
        // 585-a（撤守卫收口·容器字段=句柄载荷）：撤守卫后 stdlib 容器类经
        //   解析类声明 入类/布局表，查结构体类型 对容器实例合成名（向量$整64）
        //   命中 → 容器字段被误判「结构体载荷」压地址不取值 → 方法调用
        //   this=字段槽地址而非堆对象指针（441 A3 盒.项.大小() 读垃圾=0+
        //   越界实测；生产态容器=内置合成名不在表→load 路径正确）。容器/结果
        //   字段=句柄语义（字段槽存堆对象指针）恒 load。
        如果 (是容器类_ID(字段类型ID48)) { 返回 假; }
        // 847（指针槽语义四件套之②·右值面）：用户类字段=指针槽（838/843 模型）
        //   同款句柄语义——用户类经 类/布局表 查结构体类型命中 → 被误判「结构体
        //   载荷」压地址不取值 → 成员链中间跳（a.内.表.方法()/a.内.表 取值）基址
        //   错位为外层字段地址（少一次指针加载）→ 容器/类方法作用于外层对象
        //   （V5 铁证：a.内.表.追加 的 重新分配 实参=外层盒子对象）。
        //   067-003 同判据独立实证（543 t1 内.值：读地址低 4 字节垃圾·826 轮）——
        //   两轮同点（代码恒等），注释合并保留 847 表述。
        如果 (是用户类_ID(字段类型ID48)) { 返回 假; }
        // 321（v16 b2/w4+a1 形态 A asm 铁证·2026-10-09·句柄字段第三例）：
        //   指针字段（尾 '*'）=地址值单槽句柄——查结构体类型 对「节点*」剥星
        //   命中节点结构体 → 误判「结构体载荷」压地址不取值 → p = p.下一个
        //   存进字段地址非字段值（链表遍历/赋值 v2 全断）。与 585-a 容器字段/
        //   847 用户类字段同族——句柄语义恒 load。
        字符串 字段类型文本321 = 字符串复制(驻留文本(字段类型ID48));
        如果 (字符串长度(字段类型文本321) > 1 &&
             (整64(字段类型文本321[字符串长度(字段类型文本321) - 1]) & 255) == 42) {
            返回 假;
        }
        返回 (查结构体类型(字段类型ID48) != 0);
    }
    返回 假;
}

// ==================== 表达式后缀求值 ====================
// 遍历 池[起点, 终点) 内表达式节点（后缀栈），生成指令到 目标 指令数组。
// 返回表达式结果寄存器 ID（0=无）。
// 栈：表达式寄存器栈（向量<整64>）。
// 栈值编码：正数=寄存器；负数 -(名ID)=函数符号；-(1000000+名ID)=成员方法标记（P7b）。
//   方法标记下压着对象值（this=容器槽 Load 值=堆对象指针）。
// 缺陷B根治（2026-09-02）：新增 块计数/槽计数 指针——短路求值（规范 930）需
//   在表达式内建块（条件跳转/标签）与临时槽（两分支值汇合）。mangled 核算：
//   两 整64* 标量参数 +8 字符（约 213 < 247，MASM 符号限制安全）。
// ==================== 净栈契约出口校验（88-b，2026-09-12 第八十九轮） ====================
// 契约（单一事实源：IR生成.cn「表达式栈净栈契约」节 + 本函数唯一校验实现）：
//   净栈增量 ∈ {0, +1}——+1=有值形态（结果=栈顶）；0=void 无值形态（如返回
//   空类型的方法调用——「void 不压栈」设计，生成表达式求值.cn 明确）。
//   两类违反当场诊断（IR 层错误即中止纪律：主.cn 检查计数>0 止于产 asm）：
