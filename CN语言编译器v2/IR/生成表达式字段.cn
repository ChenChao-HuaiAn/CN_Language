// CN 自举编译器 v2 · 生成表达式——字段访问族（生成方法接收者 + 生成字段访问 + 发射成员取值 + 重取成员对象基址 + 对象槽是类对象 + 成员载荷是结构体）（D1 行数整改 120-a：自 生成表达式.cn 按族拆出）
//   纯重构零行为变更（同包「多文件合并全局可见」——函数跨文件互调无障碍；
//   与主模块函数互调经包内合并池解析，见 公开: 注释同款纪律）。
导入 容器::向量;
导入 语法;
导入 IR;
导入 IR生成;
导入 生成表达式求值;

公开:

// 成员访问两形态（R3 提取，2026-09-08）：方法接收者（P7b [this, 方法标记] 压栈）
不安全 函数 生成方法接收者(向量<节点> 池, 节点 n, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                   向量<IR指令>& 指令, 整64* 寄存器计数, 向量<整64>& 表达式栈) -> 空类型 {
    // P7b 方法调用接收者（表.追加(x) 的 表.追加 部分）：弹对象值
    //   （容器变量 Load 值=堆对象指针即 this），压 [this, 方法标记]
        // P7b 方法调用接收者（表.追加(x) 的 表.追加 部分）：弹对象值
        //   （容器变量 Load 值=堆对象指针即 this），压 [this, 方法标记]
        // ②c B：对象为结构体的容器字段（b.表.追加）——接收者=字段槽首 8 字节的
        //   堆对象指针：标识符对象取槽地址/调用对象用结果基址（retbuf/视图地址），
        //   经 字段地址+指针加载 取载（指针槽模型）
        节点 对象节点m = 池.元素(整32(n.子起点));
        整64 字段取载偏移 = -1;
        整64 字段取载基址 = 0;
        如果 (对象节点m.类型 == 节点_标识符) {
            整64 结构体IDm = 解析对象结构体ID(对象节点m);
            如果 (结构体IDm != 0) {
                整64 桶偏移m = 查字段偏移(结构体IDm, 整64(n.文本));
                如果 (桶偏移m >= 0) {
                    字段取载偏移 = 桶偏移m;
                    // 标识符对象：取结构体基槽地址（调用方/局部 多槽基址=最大槽号）
                    整64 对象槽m = 0;
                    结果<整64, 整32> 找局m = 局部槽.获取(整64(对象节点m.文本));
                    如果 (找局m.正常) { 对象槽m = 找局m.值; }
                    如果 (对象槽m == 0) {
                        结果<整64, 整32> 找参m = 参数槽.获取(整64(对象节点m.文本));
                        如果 (找参m.正常) { 对象槽m = 找参m.值; }
                    }
                    如果 (对象槽m != 0) {
                        整64 基址reg = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        // ②c D：结构体& 引用参数——槽内容即基址（Load 槽），非槽地址
                        如果 (槽是引用(对象槽m)) {
                            IR追加(指令, 建IR指令(IR_加载, 对象槽m, 0, 0, 基址reg, T_整64, 0));
                        } 否则 {
                            IR追加(指令, 建IR指令(IR_取地址, 对象槽m, 0, 0, 基址reg, T_整64, 0));
                        }
                        字段取载基址 = 基址reg;
                    }
                }
            }
        } 否则 如果 (对象节点m.类型 == 节点_调用) {
            // 调用对象：返回结构体的容器字段（词池.元素(0).表.追加）——
            //   弹出的调用结果寄存器（retbuf/视图地址）即基址
            整64 返回结构体IDm = 解析调用返回结构体(池, 整32(n.子起点));
            如果 (返回结构体IDm != 0 && 查结构体大小(返回结构体IDm) != 0) {
                整64 桶偏移m2 = 查字段偏移(返回结构体IDm, 整64(n.文本));
                如果 (桶偏移m2 >= 0) {
                    字段取载偏移 = 桶偏移m2;
                    字段取载基址 = -1;   // 栈顶（弹出的对象值）即基址
                }
            }
        }
        整64 对象值 = 0;
        如果 (表达式栈.大小() >= 1) {
            对象值 = 表达式栈.元素(表达式栈.大小() - 1);
            结果<空类型, 整32> 删对 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删对.正常) { 运行时错误(4); }
        }
        如果 (字段取载偏移 >= 0 && (字段取载基址 > 0 || 字段取载基址 == -1)) {
            // 字段首 8 字节的堆对象指针 -> this
            整64 基址值 = 对象值;
            如果 (字段取载基址 > 0) { 基址值 = 字段取载基址; }
            整64 字段地址reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_字段地址, 基址值, 0, 0, 字段地址reg, T_整64, 字段取载偏移));
            整64 对象指针reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 字段地址reg, 0, 0, 对象指针reg, T_对象, 0));
            对象值 = 对象指针reg;
        }
        结果<空类型, 整32> 加对 = 表达式栈.追加(对象值);
        如果 (!加对.正常) { 运行时错误(4); }
        结果<空类型, 整32> 加标 = 表达式栈.追加(0 - (1000000 + 整64(n.文本)));
        如果 (!加标.正常) { 运行时错误(4); }
}

// 字段访问右值（.字段/.->字段）：三源分桶布局判定+结果/可选 兜底+取值发射
不安全 函数 生成字段访问(向量<节点> 池, 节点 n, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                 向量<IR指令>& 指令, 整64* 寄存器计数, 向量<整64>& 表达式栈) -> 空类型 {
    节点 对象节点 = 池.元素(n.子起点);  // 子起点=对象节点索引（P6c 解析时记录）
    整64 基址寄存器 = 0;
    // 195-a：本函数 164 行按「三元组推导→结果/可选 兜底→右值偏移兜底」
    //   提取为 3 个族子方法（纯搬运零行为变更——多重集核验先行于构建）。
    // P7b：对象是 结果/可选 变量 -> 字段偏移按合成布局（正常@0 布尔宽度；
    //   值/错误@联合偏移 4/8——IR容器.结果值偏移）。对象类型取语法层
    //   预标注（节点.子终点=对象类型ID，语法分析 解析后缀链 登记）
    整64 字段偏移量 = n.附加;
    整64 加载类型 = T_整64;
    整64 成员对象类型ID = 0;
    整64 成员值码 = T_未知;
    解析字段三元组(池, n, 对象节点, 字段偏移量, 加载类型, 成员对象类型ID, 成员值码);
    解析结果可选兜底(n, 对象节点, 成员对象类型ID, 字段偏移量, 加载类型, 成员值码);
    // 第17枚根治·右值偏移兜底（2026-09-06）：结果类型兜底后仍 -1 -> 分桶查
    //   （解析对象结构体ID——指针参数经权威表同样命中）；仍未知即 IR 层诊断
    //   拒绝发射（附加=-1 = 基址-1 毒地址，写穿相邻槽，[ir2] 产物不可信纪律）
    解析右值偏移兜底(池, n, 对象节点, 字段偏移量, 加载类型, 成员值码);
    // 无论对象形态，先弹掉表达式栈顶（标识符=Load 值丢弃；解引用/成员=地址复用）
    如果 (表达式栈.大小() >= 1) {
        基址寄存器 = 表达式栈.元素(表达式栈.大小() - 1);
        结果<空类型, 整32> 删 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删.正常) { 运行时错误(4); }
    }
    如果 (对象节点.类型 == 节点_标识符) {
        // 标识符对象：栈顶是 Load 值，需重新取槽地址（结构体存于槽）。
        //   ②c D：结构体& 引用参数/指针参数——栈顶即基址，不再取槽地址（R3 提取）
        基址寄存器 = 重取成员对象基址(对象节点, 基址寄存器, 局部槽, 参数槽, 指令, 寄存器计数);
    }
    整64 寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 基址寄存器, 0, 0, 寄存器, T_整64, 字段偏移量));
    // 成员访问作为右值：字段地址 -> 立即取值（压值；赋值左值走专用路径）。
    //   2026-09-06 根治（v2self 表查找类型ID 崩溃）：对象为 结果/可选 且
    //   成员为 值/错误 且载荷=结构体（查.值——符号 32B）——压**字段地址**
    //   不 LoadPtr（原无条件取 8 字节=载荷首字段值当地址，结构体拷贝源=
    //   小整数（47=名ID）-> SIGSEGV；注释 2134 声明的语义至此真正实现）
    布尔 载荷是结构体 = 成员载荷是结构体(池, n, 对象节点, 成员对象类型ID);
    // 97-a（2026-09-13 第九十七轮 C8）：结构体**字段数组**——压字段地址**不加载**
    //   （宿主 ir_oop「数组字段退化：返回地址（供 字段[i] 下标访问）」同款；
    //   成员链 记录.分数[0] 的下标基址消费）。原实现按元素宽度加载首元素值
    //   当地址 -> 后续下标解引用垃圾地址。
    布尔 字段是数组97 = 假;
    如果 (字段偏移量 >= 0) {
        整64 字段结构体97 = 解析成员链结构体ID(池, 整32(n.子起点));
        如果 (字段结构体97 != 0) {
            整64 字段类型97 = 查字段类型ID(字段结构体97, 整64(n.文本));
            如果 (字段类型97 != 0) {
                如果 (是数组类型文本(
                          字符串复制(驻留文本(字段类型97)))) {
                    字段是数组97 = 真;
                }
            }
        }
    }
    发射成员取值(指令, 寄存器计数, 寄存器, 加载类型, 成员值码,
                 载荷是结构体 || 字段是数组97, 表达式栈);
}

// ==================== 195-a 族子方法（原 生成字段访问 100~213 段） ====================

// 族①：对象形态分桶三元组推导（原 100~145 段）——标识符/调用/成员链/下标
//   四形态分桶查 偏移/宽度/类型码 三元组（读写同源根治）。
//   ②b B5：调用对象（池.元素(i).字段）——方法返回结构体：分桶收口
//   偏移+宽度（语法层只能扁平回退查偏移——同名字段跨结构体必错）。
//   46-b 根治（2026-09-09 第四十八轮）：成员链中间跳（r.左上.x 的
//   .x——对象=成员节点）——语法层附加为扁平回退（按首对象 r 的
//   矩形查 .x 必 miss=-1），旧兜底 解析对象结构体ID 只认标识符。
//   经 解析成员链结构体ID 递归（矩形→左上→点）分桶查三元组。
//   94-a（2026-09-13 第九十四轮）：对象=下标表达式（结构体数组元素
//   `表[0].x` 右值）——元素结构体键经 解析成员链结构体ID（下标分支，
//   数组元素结构体表）分桶查三元组。
函数 解析字段三元组(向量<节点> 池, 节点 n, 节点 对象节点,
                  整64& 字段偏移量, 整64& 加载类型, 整64& 成员对象类型ID, 整64& 成员值码) -> 空类型 {
    如果 (对象节点.类型 == 节点_标识符) {
        成员对象类型ID = 解析标识符类型ID(整64(对象节点.文本));
        // ②b B5：标识符对象为结构体局部/参数 -> 分桶查字段宽度（读写同源根治）
        整64 结构体ID = 解析对象结构体ID(对象节点);
        如果 (结构体ID != 0) {
            加载类型 = 查字段宽度码(结构体ID, 整64(n.文本));
            // ③ 第二波（方案A）：字段声明类型码（成员加载值登记用）
            成员值码 = 类型码(查字段类型ID(结构体ID, 整64(n.文本)));
        }
    } 否则 如果 (对象节点.类型 == 节点_调用) {
        整64 返回结构体ID = 解析调用返回结构体(池, 整32(n.子起点));
        如果 (返回结构体ID != 0 && 查结构体大小(返回结构体ID) != 0) {
            整64 桶偏移 = 查字段偏移(返回结构体ID, 整64(n.文本));
            如果 (桶偏移 >= 0) { 字段偏移量 = 桶偏移; }
            加载类型 = 查字段宽度码(返回结构体ID, 整64(n.文本));
            成员值码 = 类型码(查字段类型ID(返回结构体ID, 整64(n.文本)));
        }
    } 否则 如果 (对象节点.类型 == 节点_成员) {
        整64 链结构体ID48 = 解析成员链结构体ID(池, 整32(n.子起点));
        如果 (链结构体ID48 != 0) {
            整64 桶偏移c = 查字段偏移(链结构体ID48, 整64(n.文本));
            如果 (桶偏移c >= 0) { 字段偏移量 = 桶偏移c; }
            加载类型 = 查字段宽度码(链结构体ID48, 整64(n.文本));
            成员值码 = 类型码(查字段类型ID(链结构体ID48, 整64(n.文本)));
        }
    } 否则 如果 (对象节点.类型 == 节点_下标) {
        整64 元素结构体ID94 = 解析成员链结构体ID(池, 整32(n.子起点));
        如果 (元素结构体ID94 != 0) {
            整64 桶偏94 = 查字段偏移(元素结构体ID94, 整64(n.文本));
            如果 (桶偏94 >= 0) { 字段偏移量 = 桶偏94; }
            加载类型 = 查字段宽度码(元素结构体ID94, 整64(n.文本));
            成员值码 = 类型码(查字段类型ID(元素结构体ID94, 整64(n.文本)));
        }
    }
}

// 族②：结果/可选 兜底（原 146~180 段）——字段偏移 <0 且有成员对象类型ID 时，
//   按结果/可选 合成布局推导（正常@0/.值/.错误 载荷分派/联合偏移取较宽）。
函数 解析结果可选兜底(节点 n, 节点 对象节点, 整64 成员对象类型ID,
                  整64& 字段偏移量, 整64& 加载类型, 整64& 成员值码) -> 空类型 {
    如果 (字段偏移量 < 0 && 成员对象类型ID != 0) {
        字符串 对象类型文本 = 字符串复制(驻留文本(成员对象类型ID));
        如果 (是结果类型(对象类型文本)) {
            字符串 成员名文本 = 字符串复制(驻留文本(整64(n.文本)));
            如果 (字符串比较(成员名文本, "正常") || 字符串比较(成员名文本, "有值") ||
                 字符串比较(成员名文本, "是否某些")) {
                字段偏移量 = 0;
                加载类型 = T_布尔;
                成员值码 = T_布尔;
            } 否则 {
                // 79-a 缺陷根治（既有，基线复现）：.值/.错误 载荷类型须按成员名
                //   分派——.值 = 结果首实参（T）、.错误 = 次实参（E）。原实现
                //   一律取首实参：结果<字符串,整32>.错误 的类型码=T_字符串 ->
                //   打印/比较按字符串分派（错误码判别静默失效，探针 P10/P11
                //   两侧对照实证：宿主 5 / v2 空或垃圾）。
                字符串 载荷类型 = 段首(合成名首实参(对象类型文本));
                如果 (字符串比较(成员名文本, "错误")) {
                    载荷类型 = 段首(段余(合成名首实参(对象类型文本)));
                }
                // 联合体偏移 = 较宽成员（T 或 E 为 整64/字符串/指针 -> 8）——
                //   原按 T 单侧定偏移，E 更宽时错位（登记边界，本轮取两者较宽）
                整64 值偏移 = 结果值偏移(段首(合成名首实参(对象类型文本)));
                如果 (字符串比较(合成名基名(对象类型文本), "结果")) {
                    整64 错偏移 = 结果值偏移(
                        段首(段余(合成名首实参(对象类型文本))));
                    如果 (错偏移 > 值偏移) { 值偏移 = 错偏移; }
                }
                字段偏移量 = 值偏移;
                // 71-a：加载宽度按载荷类型（整32/正32 载荷值四字节读——
                //   原 T_整64 八字节读拼垃圾高位，首个整32 载荷用例暴露）
                成员值码 = 类型码(驻留(载荷类型));
                如果 (成员值码 != T_未知) { 加载类型 = 成员值码; }
            }
        }
    }
}

// 族③：右值偏移兜底（原 181~213 段）——结果类型兜底后仍 -1 -> 三元对象/
//   解析对象结构体ID 分桶查；仍未知即 IR 层诊断拒绝发射（附加=-1 = 基址-1
//   毒地址，写穿相邻槽，[ir2] 产物不可信纪律）。
函数 解析右值偏移兜底(向量<节点> 池, 节点 n, 节点 对象节点,
                  整64& 字段偏移量, 整64& 加载类型, 整64& 成员值码) -> 空类型 {
    如果 (字段偏移量 < 0) {
        // 86-a（2026-09-12 复审缺陷①）：三元对象成员基（(条 ? 甲 : 乙).字段）
        //   ——对象类型经 解析节点类型ID（86-a 三元分支递归两分支）推导后
        //   查字段偏移/宽度（P47-v2 形八「成员字段偏移未知: .号」实证）。
        //   基址侧无需改动：三元聚合分支地址化后栈顶即选中 place 地址
        //   （与成员/解引用对象同款「非标识符即复用栈顶」分流）。
        如果 (对象节点.类型 == 节点_三元运算) {
            整64 三元对象ID = 解析节点类型ID(池, 整32(n.子起点));
            如果 (三元对象ID != 0) {
                整64 桶偏三 = 查字段偏移(三元对象ID, 整64(n.文本));
                如果 (桶偏三 >= 0) {
                    字段偏移量 = 桶偏三;
                    加载类型 = 查字段宽度码(三元对象ID, 整64(n.文本));
                    成员值码 = 类型码(查字段类型ID(三元对象ID, 整64(n.文本)));
                }
            }
        }
        整64 兜底结构体ID = 解析对象结构体ID(对象节点);
        如果 (兜底结构体ID != 0) {
            整64 桶偏右 = 查字段偏移(兜底结构体ID, 整64(n.文本));
            如果 (桶偏右 >= 0) {
                字段偏移量 = 桶偏右;
                加载类型 = 查字段宽度码(兜底结构体ID, 整64(n.文本));
                成员值码 = 类型码(查字段类型ID(兜底结构体ID, 整64(n.文本)));
            }
        }
        如果 (字段偏移量 < 0) {
            IR层诊断("成员字段偏移未知: ." + 驻留文本(整64(n.文本)));
        }
    }
}

// 成员取值发射：结果/可选 结构体载荷（.值/.错误 且载荷=结构体）压字段地址
//   不取值（2026-09-06 根治：LoadPtr 取 8 字节=载荷首字段值当地址 -> SIGSEGV）；
//   普通字段 IR_指针加载 + ③ 第二波 类型登记（字段声明类型/结果载荷类型——
//   缺陷①同族根治：字符串字段未登记 -> print_int 打指针值）。
不安全 函数 发射成员取值(向量<IR指令>& 指令, 整64* 寄存器计数, 整64 字段地址寄存器, 整64 加载类型,
                 整64 成员值码, 布尔 载荷是结构体, 向量<整64>& 表达式栈) -> 空类型 {
    如果 (载荷是结构体) {
        结果<空类型, 整32> 加m = 表达式栈.追加(字段地址寄存器);
        如果 (!加m.正常) { 运行时错误(4); }
        返回;
    }
    整64 值寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 字段地址寄存器, 0, 0, 值寄存器, 加载类型, 0));
    如果 (成员值码 != T_未知) {
        登记寄存器类型(值寄存器, 成员值码);
    }
    结果<空类型, 整32> 加 = 表达式栈.追加(值寄存器);
    如果 (!加.正常) { 运行时错误(4); }
}

// 标识符对象的字段基址重取：栈顶是 Load 值，需取槽地址（结构体存于槽）。
//   ②c D：结构体& 引用参数——槽内容即调用方结构体基址（已按引用发射），栈顶即基址；
//   指针参数 p.字段——栈顶=装载的指针值（≡(*p).字段），同不取槽地址。返回 新基址。
不安全 函数 重取成员对象基址(节点 对象节点, 整64 弹出基址, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                     向量<IR指令>& 指令, 整64* 寄存器计数) -> 整64 {
    整64 基址寄存器 = 弹出基址;
    整64 对象槽 = 0;
    结果<整64, 整32> 找局 = 局部槽.获取(整64(对象节点.文本));
    如果 (找局.正常) { 对象槽 = 找局.值; }
    如果 (对象槽 == 0) {
        结果<整64, 整32> 找参 = 参数槽.获取(整64(对象节点.文本));
        如果 (找参.正常) { 对象槽 = 找参.值; }
    }
    // 293-a（T34 第二缺口·2026-09-17）：方法体成员链根「自身」——镜像顺序链
    //   标识符地址 的同名特判：局部/参数全 miss 且在方法体内→栈顶（标识符段
    //   已加载 this 槽值）即对象基址。原实现 fall-through 尾端 IR_取地址(哨兵
    //   槽)=成员读垃圾值（50 读取() asm 铁证：返回 自身.计数 读方法帧槽）。
    如果 (对象槽 == 0 && 当前方法类名ID != 0 &&
         整64(对象节点.文本) == 整64(驻留("自身"))) {
        返回 基址寄存器;
    }
    // 87-a（2026-09-12 第八十七轮）：顶层静态结构体对象——标识符读取已生成
    //   IR_静态地址（**值即地址**），栈顶即基址，不再取槽地址。原实现落尾端
    //   兜底「取对象槽 0 地址」——静态成员读写出垃圾基址（探针 P50b v2 实证：
    //   甲.名 读库符号串）。与 引用参数/指针参数「栈顶即基址」同款分流。
    如果 (对象槽 == 0) {
        整64 找静基 = 查静态序号(整64(对象节点.文本));
        如果 (找静基 >= 0 && 查结构体大小(取静态类型(找静基)) > 0) {
            返回 基址寄存器;
        }
    }
    // 510-a（T80·v2 侧·与 293-a「自身」特判同族）：方法体内**类字段名裸标识符**
    //   作成员链基址（`内.y`·字段类型=结构体）——基址=this 槽加载+字段偏移
    //   （发射类字段地址）；原落尾端兜底「取对象槽 0 地址」→ 成员读垃圾
    //   （探针 `盒{点 内; 读(){ 返回 内.y; }}` 产物 `lea r10,[rbp-128]`+8 实证）。
    如果 (对象槽 == 0 && 当前方法类名ID != 0) {
        整64 字段偏移m510 = 当前方法字段偏移(整64(对象节点.文本));
        如果 (字段偏移m510 >= 0) {
            返回 发射类字段地址(字段偏移m510, 指令, 寄存器计数);
        }
    }
    如果 (对象槽 != 0 && 槽是引用(对象槽)) {
        // 引用参数：弹栈时 基址寄存器 已持有槽内容（=调用方结构体基址）
    } 否则 如果 (对象槽 != 0 && 槽是指针参数(对象槽)) {
        // 第17枚根治：指针参数 p.字段——栈顶=标识符读取装载的指针值，不再取槽地址
    } 否则 如果 (对象槽 != 0 && 对象槽是类对象(整64(对象节点.文本))) {
        // 第七十八轮（2026-09-12）：用户类对象成员访问——槽内容=堆对象指针
        //   （对象语义同容器：Load 即基址；结构体值语义走 取地址 槽。原路径
        //   取槽地址=传栈地址给字段访问/方法 this=段错误实证——228 用例）
        整64 指针寄存器2 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_加载, 对象槽, 0, 0, 指针寄存器2, T_对象, 0));
        基址寄存器 = 指针寄存器2;
    } 否则 {
        整64 地址寄存器2 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_取地址, 对象槽, 0, 0, 地址寄存器2, T_整64, 0));
        基址寄存器 = 地址寄存器2;
    }
    返回 基址寄存器;
}

// 标识符名字是否为用户类对象（权威表类型 -> 用户类判定——成员基址指针语义分派用）
函数 对象槽是类对象(整64 名ID) -> 布尔 {
    整64 类型IDc = 查当前函数变量类型(名ID);
    如果 (类型IDc == 0) { 返回 假; }
    返回 是用户类(字符串复制(驻留文本(类型IDc)));
}

// 结果/可选 载荷成员（.值/.错误）且载荷为结构体时，成员访问压字段地址不取值
//   （2026-09-06 根治：载荷结构体若 LoadPtr 取 8 字节=载荷首字段值当地址 -> SIGSEGV）
函数 成员载荷是结构体(向量<节点> 池, 节点 n, 节点 对象节点, 整64 成员对象类型ID) -> 布尔 {
    如果 (对象节点.类型 == 节点_标识符 && 成员对象类型ID != 0) {
        字符串 对象类型文本2 = 字符串复制(驻留文本(成员对象类型ID));
        如果 (是结果类型(对象类型文本2)) {
            字符串 成员名文本2 = 字符串复制(驻留文本(整64(n.文本)));
            如果 (字符串比较(成员名文本2, "正常") || 字符串比较(成员名文本2, "有值") ||
                 字符串比较(成员名文本2, "是否某些")) { 返回 假; }
            字符串 载荷类型 = 段首(合成名首实参(对象类型文本2));
            返回 查结构体大小(驻留(载荷类型)) != 0;
        }
    }
    // 46-a 根治（2026-09-09 第四十八轮）：成员字段类型是结构体即压地址不取值
    //   （v2 结构体值以地址传递的既定约定，与 实参通道 回扫字段地址形态/容器
    //   类字段指针读 三方一致）。原仅 结果.值 特判：普通结构体成员（点 t =
    //   r.左上）被 LoadPtr 取 8 字节值——声明位把该值当源地址结构体拷贝=
    //   解引用垃圾地址段错误（win 0xC0000005/linux rc=139 实锤）。对象解析经
    //   解析成员链结构体ID（186 根治产物）统一覆盖 标识符/成员链/调用 三形态。
    整64 成员链结构体ID = 解析成员链结构体ID(池, 整32(n.子起点));
    如果 (成员链结构体ID != 0) {
        整64 字段类型ID48 = 查字段类型ID(成员链结构体ID, 整64(n.文本));
        返回 查结构体类型(字段类型ID48) != 0;
    }
    返回 假;
}

// ==================== 表达式后缀求值 ====================
// 遍历 池[起点, 终点) 内表达式节点（后缀栈），生成指令到 目标 指令数组。
// 返回表达式结果寄存器 ID（0=无）。
// 栈：表达式寄存器栈（向量<整64>）。
// 栈值编码：正数=寄存器；负数 -(名ID)=函数符号；-(1000000+名ID)=成员方法标记（P7b）。
//   方法标记下压着对象值（this=容器槽 Load 值=堆对象指针）。
// 缺陷B根治（2026-09-02）：新增 块计数/槽计数 指针——短路求值（规范 930）需
//   在表达式内建块（条件跳转/标签）与临时槽（两分支值汇合）。mangled 核算：
//   两 整64* 标量参数 +8 字符（约 213 < 247，MASM 符号限制安全）。
// ==================== 净栈契约出口校验（88-b，2026-09-12 第八十九轮） ====================
// 契约（单一事实源：IR生成.cn「表达式栈净栈契约」节 + 本函数唯一校验实现）：
//   净栈增量 ∈ {0, +1}——+1=有值形态（结果=栈顶）；0=void 无值形态（如返回
//   空类型的方法调用——「void 不压栈」设计，生成表达式求值.cn 明确）。
//   两类违反当场诊断（IR 层错误即中止纪律：主.cn 检查计数>0 止于产 asm）：
