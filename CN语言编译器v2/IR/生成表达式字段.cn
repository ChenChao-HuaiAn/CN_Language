            }
        }
    }
    // 912（806 相邻面·点号静态方法作值·宿主 P3-23 零分叉对齐）：类名.静态方法
    //   作值（实参/声明/返回位）——对象=用户类名（非变量遮蔽·93-a 判据同构）+
    //   类静态方法表命中 → 静态方法引用值（发射静态方法引用值 单点·与 :: 限定
    //   形态同符号；静态无 this 绑定=纯函数地址）。原缺此分流：字段/静态字段/
    //   变量派生类 全 miss → 落下方「成员字段偏移未知」IR 层误拒（v2 反向分叉·
    //   宿主放行——p912a/b/d/e 双侧实录）。
    如果 (字段偏移量 < 0 && 对象节点.类型 == 节点_标识符) {
        整64 类名静方ID912 = 整64(对象节点.文本);
        如果 (是用户类_ID(类名静方ID912) &&
             是类静态方法(类名静方ID912, 整64(n.文本))) {
            // 弹掉对象表达式栈顶（类名 Load miss=负占位垃圾·丢弃·070 波G 同款）
            如果 (表达式栈.大小() >= 1) {
                结果<空类型, 整32> 删类名912 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删类名912.正常) { 运行时错误(4); }
            }
            发射静态方法引用值(类名静方ID912, 整64(n.文本), 指令, 寄存器计数,
                              表达式栈);
            返回;
        }
    }
    如果 (字段偏移量 < 0 && 对象节点.类型 == 节点_标识符) {
        整64 对象名ID = 整64(对象节点.文本);
        可选<整64> 类名查 = 查当前函数变量类型(对象名ID);
        如果 (类名查.有值 && 有类方法(类名查.值, 整64(n.文本))) {
            整64 类名ID = 类名查.值;
            整64 参数串ID104 = 查类方法参数串(类名ID, 整64(n.文本));
            字符串 参数串104 = "";
            如果 (参数串ID104 != 0) { 参数串104 = 字符串复制(驻留文本(参数串ID104)); }
            字符串 方法符号串104 = 方法符号(字符串复制(驻留文本(类名ID)),
                                         字符串复制(驻留文本(整64(n.文本))),
                                         参数串104);
            // 943（绑定方法值赋值位合法化·宿主 ensureMethodValueTrap943 对称）：
            //   值改发**蹦床闭包地址**——原发放裸方法符号（签名含隐藏 this）经
            //   fnptr 形参转发=丢绑定段错误 rc139（p82d 探针）；蹦床签名=用户
            //   签名、体自带"对象槽取 this + 直调方法符号"，转发/拷贝安全。
            //   对象表达式栈顶值=被绑定对象指针（标识符 Load）→ 本站点静态槽
            //   固化（IR_静态存储）；同函数直调仍走 方法引用闭包调用展开 快径
            //   （绑定对象同为赋值位固化·语义等价）。
            整64 对象值943 = 0;
            如果 (表达式栈.大小() >= 1) {
                对象值943 = 表达式栈.元素(表达式栈.大小() - 1);
                结果<空类型, 整32> 删方943 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删方943.正常) { 运行时错误(4); }
            }
            整64 返回类型ID104 = 查类方法返回(类名ID, 整64(n.文本));
            整64 蹦床名943 = 新方法值蹦床名943();
            整64 槽键943 = 驻留(方法值对象槽键943(蹦床名943));
            结果<整64, 整32> 查槽943 = 静态序号们.获取(槽键943);
            如果 (!查槽943.正常) {
                整64 新槽序943 = 静态名们.大小();
                结果<空类型, 整32> 加名943 = 静态名们.追加(槽键943);
                如果 (!加名943.正常) { 运行时错误(4); }
                结果<空类型, 整32> 加型943 = 静态类型们.追加(驻留("整64"));
                如果 (!加型943.正常) { 运行时错误(4); }
                结果<空类型, 整32> 设序943 = 静态序号们.设置(槽键943, 新槽序943);
                如果 (!设序943.正常) { 运行时错误(4); }
                结果<空类型, 整32> 加起943 = 静态初值起点们.追加(0 - 1);
                如果 (!加起943.正常) { 运行时错误(4); }
                结果<空类型, 整32> 加终943 = 静态初值终点们.追加(0 - 1);
                如果 (!加终943.正常) { 运行时错误(4); }
            }
            结果<整64, 整32> 槽序实查943 = 查静态序号(槽键943);
            // 槽键上文刚登记/已存在（静态槽登记单点）——miss=编译器内部不一致
            如果 (槽序实查943.正常) {
                整64 槽序实943 = 槽序实查943.值;
                IR追加(指令, 建IR指令(IR_静态存储, 对象值943, 0, 0, 0, 0, 槽序实943));
                字符串 参数串b943 = "";
                如果 (参数串ID104 != 0) { 参数串b943 = 字符串复制(驻留文本(参数串ID104)); }
                整64 trap键943 = 合成方法值蹦床943(参数串b943, 返回类型ID104,
                                                 方法符号串104, 蹦床名943, 槽序实943);
                整64 方法地址寄存器104 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_函数地址, 0, 0, 0,
                                     方法地址寄存器104, T_整64, trap键943));
                登记寄存器类型(方法地址寄存器104, T_整64);
                最近方法引用符号 = 驻留(方法符号串104);
                最近方法引用对象 = 对象名ID;
                最近方法引用返回码 = 0;
                如果 (返回类型ID104 != 0) { 最近方法引用返回码 = 类型码(返回类型ID104); }
                结果<空类型, 整32> 加方104 = 表达式栈.追加(方法地址寄存器104);
                如果 (!加方104.正常) { 运行时错误(4); }
                返回;
            } 否则 {
                运行时错误(4);
            }
        }
    }
    如果 (字段偏移量 < 0) {
        IR层诊断("成员字段偏移未知: ." + 驻留文本(整64(n.文本)));
    }
    // 无论对象形态，先弹掉表达式栈顶（标识符=Load 值丢弃；解引用/成员=地址复用）
    如果 (表达式栈.大小() >= 1) {
        基址寄存器 = 表达式栈.元素(表达式栈.大小() - 1);
