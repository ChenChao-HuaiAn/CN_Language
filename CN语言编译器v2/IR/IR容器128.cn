// IR容器128（1538 轮拆分·自 IR容器尾.cn 纯机械搬移·函数体逐字保留·零逻辑变化）：
//   128 位值通道共用件（810 轮·053 批次 E）——双半搬运/操作数物化/字面量域/
//   窄化/字面量物化/二元运算。拆分依据=AGENTS「先拆再加」体量红线（源文件
//   957 行超 900 警戒线·1538 轮新增释放甄别前先拆）；搬移段与「容器/释放器」
//   职责无耦合（128 位标量值通道独立面）。
导入 容器::向量;
导入 映射集合;
导入 IR;         // 节点_*/T_*/IR_*/键位移（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:

// ==================== 128 位双半搬运（810 轮·053 值通道共用件） ====================

// 源句柄寄存器（值=16 字节槽地址）→ 目标槽对双半拷贝。基址槽=低地址
//   （低 64 半·对象首地址）、次槽=高地址（高 64 半）——T96c emitCopy 双半
//   模式的 IR 层等价形态，声明初值/赋值/传参副本/返回缓冲 四消费点共用。
不安全 函数 发射128位双半拷贝(整64 源句柄, 整64 基址槽, 整64 次槽,
                   向量<IR指令>& 指令, 整64* 寄存器计数) -> 空类型 {
    整64 低半寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 源句柄, 0, 0, 低半寄存器, T_整64, 0));
    IR追加(指令, 建IR指令(IR_存储, 低半寄存器, 0, 0, 0, 0, 基址槽));
    整64 高源地址 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 源句柄, 0, 0, 高源地址, T_整64, 8));
    整64 高半寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 高源地址, 0, 0, 高半寄存器, T_整64, 0));
    IR追加(指令, 建IR指令(IR_存储, 高半寄存器, 0, 0, 0, 0, 次槽));
}

// ==================== 128 位二元运算（810 轮·053 批次 E） ====================

// 64 位值操作数 → 128 位槽对物化（提升·返回基址句柄寄存器）。低半=值 64 位
//   补码直存基址槽；高半=符号性分派——有符号码算术右移 63（sar 符号扩展·
//   宿主 movslq+sar 形态对齐）、无符号码/未登记零扩展（常量 0）。
不安全 函数 物化128位操作数(整64 值寄存器, 整64 值码, 整64 有符号,
                   向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数) -> 整64 {
    // 418（002 收口杂项正测族·宿主 emitCastFloatFamily「浮→整128 向零截断」
    //   语义对齐）：浮源（浮32/浮64）先 IR_类型转换 截断到 整64（cvttss2si/
    //   cvttsd2si 既有发射）再物化。原直落 IR_存储 按寄存器槽位模式搬运：
    //   整128(3.75) 输出 double 位模式 4615626668101337088（17_audit 双编译
    //   对照实证），宿主=3。|值|≥2^63 域 cvttsd2si 64 位饱和，全宽转换需
    //   __cn_f64_to_i128(xmm0,rdx) 专用 ABI（通用展开浮点独立计数 out 落 rcx
    //   与 C 函数形参序不合——缺口独立立案不扩线）。
    如果 (值码 == T_浮32 || 值码 == T_浮64) {
        // 464（浮→128 全宽域收口·#464 分叉根治·418 缺口立案本轮回收）：浮源
        //   不再截断到 整64——|值|≥2^63 域 cvttsd2si/fcvtzs 仅 64 位饱和出垃圾
        //   （整128(1e19) 输出 -9223372036854775808 实锚·宿主全宽正确）。改发
        //   全宽专用通道：分配双槽 + IR_取地址 低槽（out 指针·操作数3 数据依赖）
        //   + IR_类型转换(浮源→T_整128)——三后端代码生成特判发射
        //   __cn_f64_to_i128 专用 ABI（win: xmm0+rdx 按位置编号·linux: xmm0+rdi
        //   SysV·arm64: d0/s0+x0 AAPCS64——通用调用展开浮点独立计数 out 落 rcx
        //   与 C 函数形参序不合，禁走通用通道）。#475 饱和化语义随宿主运行时
        //   同步（NaN→0·超域→边界·域内向零截断）。
        //   528（475 甲案收族·464 轮呈报面回收）：正128 目标改发 T_正128——
        //   三后端特判随之切 __cn_f64_to_u128 无符号专用辅助（原固定 T_整128
        //   同调有符号辅助·位模式锁定对齐，宿主本轮同步切换）。
        整64 槽起f = 槽计数[0];
        槽计数[0] = 槽计数[0] + 2;
        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽起f));
        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽起f + 1));
        整64 out地址f = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_取地址, 槽起f + 1, 0, 0, out地址f, T_整64, 0));
        整64 目标码f = (有符号 == 1) ? T_整128 : T_正128;
        整64 转换寄存器f = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_类型转换, 值寄存器, 值码, out地址f,
                             转换寄存器f, 目标码f, 0));
        登记寄存器类型(转换寄存器f, 目标码f);
        返回 转换寄存器f;
    }
    整64 槽起 = 槽计数[0];
    槽计数[0] = 槽计数[0] + 2;
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽起));
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽起 + 1));
    // 814（053-001）：字面量回扫拆半——值寄存器来源=IR_常量整数 时按**字面量
    //   文本**双半分解（支持 >2^64 大字面量/LL 后缀/负号·解析128位初值文本），
    //   替代 64 位寄存器路径（原大字面量在 IR_常量整数 发射层 movabs 截断——
    //   高半丢失错误值）。回扫未命中（变量/表达式产物）落下方符号扩展路径。
    整64 回物 = 指令.大小();
    当 (回物 > 0) {
        IR指令 回物i = 指令.元素(回物 - 1);
        如果 (回物i.操作码 == IR_常量整数 && 回物i.目标 == 值寄存器) {
            整64 低拆 = 0;
            整64 高拆 = 0;
            如果 (解析128位初值文本(字符串复制(驻留文本(回物i.操作数1)),
                                      低拆, 高拆)) {
                整64 低拆reg = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(低拆)), 0, 0,
                                     低拆reg, T_整64, 0));
                IR追加(指令, 建IR指令(IR_存储, 低拆reg, 0, 0, 0, 0, 槽起 + 1));
                整64 高拆reg = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(高拆)), 0, 0,
                                     高拆reg, T_整64, 0));
                IR追加(指令, 建IR指令(IR_存储, 高拆reg, 0, 0, 0, 0, 槽起));
                整64 拆句柄 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_取地址, 槽起 + 1, 0, 0, 拆句柄,
                                     T_整64, 0));
                登记寄存器类型(拆句柄, 有符号 == 1 ? T_整128 : T_正128);
                返回 拆句柄;
            }
            中断;
        }
        回物--;
    }
    IR追加(指令, 建IR指令(IR_存储, 值寄存器, 0, 0, 0, 0, 槽起 + 1));
    整64 高寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    如果 (有符号 == 1) {
        // 算术右移 63 = 符号扩展（v2 IR_右移=有符号算术右移·sar）
        整64 移量寄存器 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_常量整数, 驻留("63"), 0, 0,
                             移量寄存器, T_整64, 0));
        IR追加(指令, 建IR指令(IR_右移, 值寄存器, 移量寄存器, 0,
                             高寄存器, T_整64, 0));
    } 否则 {   // 静默豁免闭集穷举: 有符号两态完备（1=sar 符号扩展/否则=零扩展）
        IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0,
                             高寄存器, T_整64, 0));
    }
    IR追加(指令, 建IR指令(IR_存储, 高寄存器, 0, 0, 0, 0, 槽起));
    整64 句柄 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_取地址, 槽起 + 1, 0, 0, 句柄, T_整64, 0));
    登记寄存器类型(句柄, 有符号 == 1 ? T_整128 : T_正128);
    返回 句柄;
}

// 818（064）：整数字面量「超 整128 域」判定（宿主 ir_expr.cpp parseInt128InitText
//   前判据同构=剥符号/进制约/后缀→数字串，正/负各一限串做「位数+字典序」比较；
//   非十进制按位数上限预判+拆半判）。超域 → 调用侧诊断拒绝（宿主文案对齐
//   「整数字面量超出整128（2^127-1）范围」）。负号限串=2^127（-2^127 域内合法）。
函数 字面量超128域(字符串 文本) -> 布尔 {
    整64 长 = 字符串长度(文本);
    整64 起 = 0;
    当 (起 < 长 && (静字节值(文本, 起) == 32 || 静字节值(文本, 起) == 9)) { 起++; }
    布尔 负 = 假;
    如果 (起 < 长 && 静字节值(文本, 起) == 45) { 负 = 真; 起++; }
    如果 (起 >= 长) { 返回 假; }
    // 进制约
    整64 进制 = 10;
    // 静默豁免闭集穷举: 0x/0X 前缀形态判定（长度界 2·十六/十进制两态闭集）
    如果 (长 - 起 > 2 && 静字节值(文本, 起) == 48) {
        整64 次b = 静字节值(文本, 起 + 1);
        如果 (次b == 120 || 次b == 88) { 进制 = 16; 起 = 起 + 2; }
        否则 如果 (次b == 98 || 次b == 66) { 进制 = 2; 起 = 起 + 2; }
        否则 如果 (次b == 111 || 次b == 79) { 进制 = 8; 起 = 起 + 2; }
    }
    // 数字串长度（至后缀/尾空白）
    整64 位数 = 0;
    整64 i = 起;
    当 (i < 长) {
        可选<整64> 数查d = 静数字字节值(静字节值(文本, i));
        如果 (数查d.有值 && 数查d.值 < 进制) {
            位数++;
            i++;
            继续;
        }
        中断;
    }
    // 910：去前导零（宿主 normalizeIntLiteralToDecimal 同构）——原「位数」含
    //   前导零，长前导零文本（0x000…01）误判超域 / 十进制 40 位前导零同病。
    整64 首p = 起;
    当 (首p < 起 + 位数 && 静字节值(文本, 首p) == 48) { 首p++; }
    整64 实位 = 起 + 位数 - 首p;
    如果 (实位 == 0) { 返回 假; }     // 全零：值 0 域内
    // 478（473 采样轮）：U 结尾后缀（U/UL/ULL→正32/正64/正128）按无符号域
    //   正限 2^128-1 判（宿主 visitIntegerLiteral literalTypeOf 后缀推断
    //   isSigned=假 同构）——原恒按有符号域把 …ULL 极值误拒（宿主放行
    //   =分叉·正128 =u128::MAX ULL 三通道实锚）。负号形态维持有符号限。
    布尔 无符号后缀 = 假;
    整64 尾478 = 起 + 位数;
    当 (尾478 < 长) {
        整64 尾字节 = 静字节值(文本, 尾478);
        如果 (尾字节 == 85 || 尾字节 == 117) { 无符号后缀 = 真; }
        否则 如果 (尾字节 != 76 && 尾字节 != 108) { 中断; }
        尾478++;
    }
    // 910（超64域口径收口·759 探针实锚）：进制面精确化——原仅「位数超上限」
    //   粗判（32 位 hex/42 位 oct/128 位 bin 档内超有符号界的形态漏判：
    //   0xFF…F（32 位）无后缀定级整128 → 2^128-1 超 2^127-1 应拒·原放行=
    //   v2 分叉源；负号恰 -2^127 应放行亦漏判）。界选择：负号 → 2^127；
    //   无符号后缀 → 2^128-1；否则 2^127-1。判定委托 进制值不超界910
    //  （单点·与转换面/静态面同真源）。
    如果 (进制 == 16 || 进制 == 8 || 进制 == 2) {
        整64 界s = 0;
        如果 (负) { 界s = 1; }
        否则 如果 (无符号后缀) { 界s = 2; }
        返回 !进制值不超界910(文本, 首p, 起 + 位数, 进制, 界s);
    }
    // 十进制：位数+字典序（正限 2^127-1·负限 2^127）——实位与 39（u128 十进制
    //   位长）三段互补分档：>39 必超域／<39 必域内／==39 逐位字典序细判
    // 静默豁免闭集穷举: 三段互补分档（>39 必超/<39 必域内/==39 逐位细判·上方注释）
    如果 (实位 > 39) { 返回 真; }
    如果 (实位 < 39) { 返回 假; }   // 静默豁免闭集穷举: 三段互补分档中段（<39 必域内）
    字符串 数字串 = 字符串子串(文本, 首p, 整32(实位));
    字符串 限串 = 负 ? "170141183460469231731687303715884105728"
                    : (无符号后缀 ? "340282366920938463463374607431768211455"
                                  : "170141183460469231731687303715884105727");
    整64 k = 0;
    当 (k < 39) {
        整64 a = 静字节值(数字串, k);
        整64 b = 静字节值(限串, k);
        如果 (a > b) { 返回 真; }
        如果 (a < b) { 返回 假; }
        k++;
    }
    返回 假;
}

// 814（053-001）：隐式窄化——64 位目标上下文收到 128 位值（地址句柄）时装载
//   低半（宿主 emitCast 隐式截断同款·规范 218 提升链的回落）。挂点=声明初值/
//   赋值/实参等 64 位消费点（超域字面量经 生成字面量 物化为 128 位后，64 位
//   上下文须窄化——446/447 的 `整64 a64 = -9223372036854775808` 句柄直存
//   实证）。
不安全 函数 隐式窄化到64(整64 值寄存器, 向量<IR指令>& 指令,
                    整64* 寄存器计数) -> 整64 {
    // 1360 批5：未登记=类型未知（T_未知 兜底·既有业务语义），显式分流后供多处判定
    整64 窄码 = 查寄存器类型或未知(值寄存器);
    如果 (窄码 == T_整128 || 窄码 == T_正128) {
        整64 低半reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_指针加载, 值寄存器, 0, 0, 低半reg, T_整64, 0));
        返回 低半reg;
    }
    返回 值寄存器;
}

// 814（053-001）：已知拆半值的 128 位字面量物化（生成字面量 大字面量分支用）
//   ——2 槽+双半常量整数直存+基址句柄+登记 T_整128（无后缀超 整64 域字面量
//   按规范 218 提升链归 整128）。
不安全 函数 物化字面量128位(整64 拆低, 整64 拆高, 向量<IR指令>& 指令,
                   整64* 寄存器计数, 整64* 槽计数) -> 整64 {
    整64 槽起 = 槽计数[0];
    槽计数[0] = 槽计数[0] + 2;
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽起));
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽起 + 1));
    整64 低reg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(拆低)), 0, 0,
                         低reg, T_整64, 0));
    IR追加(指令, 建IR指令(IR_存储, 低reg, 0, 0, 0, 0, 槽起 + 1));
    整64 高reg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(拆高)), 0, 0,
                         高reg, T_整64, 0));
    IR追加(指令, 建IR指令(IR_存储, 高reg, 0, 0, 0, 0, 槽起));
    整64 句柄 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_取地址, 槽起 + 1, 0, 0, 句柄, T_整64, 0));
    登记寄存器类型(句柄, T_整128);
    返回 句柄;
}

// 128 位二元运算主体（算术五算子+比较六算子·辅助函数路线）。操作数=地址
//   句柄（64 位值操作数经 物化128位操作数 提升）；结果=2 槽临时基址句柄
//   （算术）或 T_布尔（比较·__cn_cmp_i128/u128 返回 -1/0/1 与 0 二次比较）。
//   返回 真=已处理；假=非 128 位运算（调用方走原路径）。
不安全 函数 发射128位二元运算(整64 op, 整64 左, 整64 右,
                   向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 槽计数,
                   向量<整64>& 表达式栈, 整64 强制回绕474) -> 布尔 {
    // 474 收口追加（538）：强制回绕474=1 时加/减强制调无检查版 helper（回绕加/
    //   回绕减 的 i128 面语义=恒回绕·不受 不安全474 选调影响）；0=按选调
    // 1360 批5：未登记=类型未知（T_未知 兜底·既有业务语义），显式分流后供多处判定
    整64 左码 = 查寄存器类型或未知(左);
    整64 右码 = 查寄存器类型或未知(右);
    布尔 左128 = 左码 == T_整128 || 左码 == T_正128;
    布尔 右128 = 右码 == T_整128 || 右码 == T_正128;
    // 静默豁免业务值: 非 128 操作数=面外否定分流（返回 假=非本通道·调用方落标量路）
    如果 (!左128 && !右128) { 返回 假; }
    布尔 有符号 = 左码 != T_正128;   // 混合符号取左（宽松·与 46-f 混宽语义一致）
    // 提升：64 位侧物化（按其自身符号性扩展）
    整64 左句柄 = 左;
    整64 右句柄 = 右;
    如果 (!左128) {
        左句柄 = 物化128位操作数(左, 左码, 左码 == T_正32 || 左码 == T_正64 ? 0 : 1,
                                 指令, 寄存器计数, 槽计数);
    }
    如果 (!右128) {
        右句柄 = 物化128位操作数(右, 右码, 右码 == T_正32 || 右码 == T_正64 ? 0 : 1,
                                 指令, 寄存器计数, 槽计数);
    }
    // 比较六算子：__cn_cmp_i128/u128(a, b) → rc(-1/0/1) → 与 0 二次比较
    如果 (op == IR_相等 || op == IR_不等 || op == IR_小于 || op == IR_大于 ||
         op == IR_小于等于 || op == IR_大于等于) {
        整64 比较寄存器 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        字符串 比较符号 = 有符号 ? "__cn_cmp_i128" : "__cn_cmp_u128";
        IR追加(指令, 建IR指令(IR_调用实参, 左句柄, 0, 0, 0, 0, 0));
        IR追加(指令, 建IR指令(IR_调用实参, 右句柄, 0, 0, 1, 0, 0));
        IR追加(指令, 建IR指令(IR_调用参数化, 2, T_整32, 0,
                             比较寄存器, 0, 驻留(比较符号)));
        // rc 与 0 的二次比较（产物=T_布尔·原比较算子直用 64 位通道）
        整64 零寄存器 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0,
                             零寄存器, T_整32, 0));
        整64 产物寄存器 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(op, 比较寄存器, 零寄存器, 0,
                             产物寄存器, T_整32, 0));
        登记寄存器类型(产物寄存器, T_布尔);
        结果<空类型, 整32> 加比较 = 表达式栈.追加(产物寄存器);
        如果 (!加比较.正常) { 运行时错误(4); }
        返回 真;
    }
    // 814（053-001）：移位 << >>（128 位左移/算术右移）——runtime __cn_shl_i128/
    //   __cn_shr_i128(左句柄, 移位量64位值, dst地址)（无检查版=掩码 &0x7f 回绕）。
    // 474 收口接线（1103·原「掩码 &0x7f 语义在运行时实现」注记=474 前旧语义残留）：
    //   安全函数选调 _chk 版（移位量 ∉ [0,128) → 错误码 8·与宿主三后端内联
    //   cmp 128 + jae/b.hs 检查同域同 rc）；不安全 函数/回绕面维持无检查版
    //   （掩码回绕豁免·与 __cn_add_i128_chk 选调同构）。仅左=128 走本通道。
    如果 (op == IR_左移 || op == IR_右移) {
        // 移位须左=128（右=移位量）；左非 128（64 位值移 128 位量）面外回退
        // 静默豁免业务值: 左非 128=面外否定分流（64 位值移位落标量路·上方注释）
        如果 (!左128) { 返回 假; }
        字符串 移符号474 = "__cn_shl_i128";
        如果 (op == IR_右移) { 移符号474 = "__cn_shr_i128"; }
        如果 (强制回绕474 == 0 && !读当前生成函数不安全474()) {
            移符号474 = 移符号474 + "_chk";
        }
        整64 移量寄存器 = 右;
        如果 (右码 == T_整128 || 右码 == T_正128) {
            移量寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 右句柄, 0, 0, 移量寄存器, T_整64, 0));
        }
        整64 移槽起 = 槽计数[0];
        槽计数[0] = 槽计数[0] + 2;
        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 移槽起));
        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 移槽起 + 1));
        整64 移dst = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_取地址, 移槽起 + 1, 0, 0, 移dst, T_整64, 0));
        整64 移调用 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_调用实参, 左句柄, 0, 0, 0, 0, 0));
        IR追加(指令, 建IR指令(IR_调用实参, 移量寄存器, 0, 0, 1, 0, 0));
        IR追加(指令, 建IR指令(IR_调用实参, 移dst, 0, 0, 2, 0, 0));
        IR追加(指令, 建IR指令(IR_调用参数化, 3, 0, 0, 移调用, 0,
                             驻留(移符号474)));
        整64 移句柄 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_取地址, 移槽起 + 1, 0, 0, 移句柄, T_整64, 0));
        登记寄存器类型(移句柄, 有符号 ? T_整128 : T_正128);
        结果<空类型, 整32> 加移 = 表达式栈.追加(移句柄);
        如果 (!加移.正常) { 运行时错误(4); }
        返回 真;
    }
    // 814（053-001）：位运算 & | ^（双半独立内联·无进位）——低/高半各自 op 后
    //   写 dst 槽对；产物=基址句柄。
    如果 (op == IR_位与 || op == IR_位或 || op == IR_位异或) {
        整64 位槽起 = 槽计数[0];
        槽计数[0] = 槽计数[0] + 2;
        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 位槽起));
        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 位槽起 + 1));
        整64 半i = 0;
        当 (半i < 2) {
            整64 偏 = 半i * 8;
            整64 左半地址 = 左句柄;
            整64 右半地址 = 右句柄;
            如果 (半i == 1) {
                左半地址 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_字段地址, 左句柄, 0, 0, 左半地址, T_整64, 8));
                右半地址 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_字段地址, 右句柄, 0, 0, 右半地址, T_整64, 8));
            }
            整64 左半 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 左半地址, 0, 0, 左半, T_整64, 0));
            整64 右半 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 右半地址, 0, 0, 右半, T_整64, 0));
            整64 半果 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(op, 左半, 右半, 0, 半果, T_整64, 0));
            IR追加(指令, 建IR指令(IR_存储, 半果, 0, 0, 0, 0,
                                 半i == 0 ? 位槽起 + 1 : 位槽起));
            半i++;
        }
        整64 位句柄 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_取地址, 位槽起 + 1, 0, 0, 位句柄, T_整64, 0));
        登记寄存器类型(位句柄, 有符号 ? T_整128 : T_正128);
        结果<空类型, 整32> 加位 = 表达式栈.追加(位句柄);
        如果 (!加位.正常) { 运行时错误(4); }
        返回 真;
    }
    // 算术五算子：__cn_add/sub/mul/div/mod_i128|u128(a, b, dst)——dst=2 槽
    //   临时基址；产物=基址句柄（T_整128/T_正128·打印传址/再运算/赋值消费）。
    //   add/sub 无符号与有符号位模式等价（模 2^128）→ 正128 复用 i128 版。
    整64 结果槽起 = 槽计数[0];
    槽计数[0] = 槽计数[0] + 2;
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 结果槽起));
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 结果槽起 + 1));
    整64 结果基址 = 结果槽起 + 1;
    // 474 收口接线：加/减按 当前生成函数不安全474 选调——安全函数调 chk 版
    //   （溢出→__cn_runtime_error(8)·与宿主直发检查行为同构·双实现路径属
    //   编排裁决）；不安全 函数维持无检查版（回绕豁免）。乘法维持回绕
    //   （双侧口径不变·474 裁决）；除/余运行时面照旧。
    字符串 辅助符号 = "__cn_add_i128";
    如果 (op == IR_加) {
        辅助符号 = "__cn_add_i128";
        如果 (强制回绕474 == 0 && !读当前生成函数不安全474()) {
            辅助符号 = "__cn_add_i128_chk";
        }
    } 否则 如果 (op == IR_减) {
        辅助符号 = "__cn_sub_i128";
        如果 (强制回绕474 == 0 && !读当前生成函数不安全474()) {
            辅助符号 = "__cn_sub_i128_chk";
        }
    } 否则 如果 (op == IR_乘) { 辅助符号 = 有符号 ? "__cn_mul_i128" : "__cn_mul_u128"; }
    否则 如果 (op == IR_除) { 辅助符号 = 有符号 ? "__cn_div_i128" : "__cn_div_u128"; }
    否则 如果 (op == IR_取余) { 辅助符号 = 有符号 ? "__cn_mod_i128" : "__cn_mod_u128"; }
    否则 { 返回 假; }   // 静默豁免闭集穷举: 运算符枚举终点（加减乘除取余显式枚举后·非本通道否定回答）
    // dst 实参=结果槽基址**地址寄存器**（IR_取地址 先于 call——IR_调用实参
    //   操作数1=寄存器号，槽号直传=发射层读垃圾地址·t4 段错误实证修正）
    整64 dst寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_取地址, 结果基址, 0, 0, dst寄存器, T_整64, 0));
    整64 调用寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_调用实参, 左句柄, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用实参, 右句柄, 0, 0, 1, 0, 0));
    IR追加(指令, 建IR指令(IR_调用实参, dst寄存器, 0, 0, 2, 0, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 3, 0, 0,
                         调用寄存器, 0, 驻留(辅助符号)));
    整64 产物句柄 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_取地址, 结果基址, 0, 0, 产物句柄, T_整64, 0));
    登记寄存器类型(产物句柄, 有符号 ? T_整128 : T_正128);
    结果<空类型, 整32> 加算术 = 表达式栈.追加(产物句柄);
    如果 (!加算术.正常) { 运行时错误(4); }
    返回 真;
}
