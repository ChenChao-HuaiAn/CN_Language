// CN 自举编译器 v2 · 生成声明（R3 千行拆分，2026-09-08）
// 职责：语句级变量声明 IR 生成——自 生成语句.cn 机械搬移（零逻辑变化）：
//   指针/引用登记 → 引用局部 / 容器（构造/返回接收/标识符拷贝）/ 结果 /
//   结构体 分派 → 普通标量。原分支出口 位置++;继续; 由 生成语句 主循环统一。
// 模块路径=生成声明（新键基）；仅被 生成语句 消费。
导入 容器::向量;
导入 语法;       // Token/AST 节点池
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 IR生成;     // 生成表达式/生成左值地址 + 权威表访问函数

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

公开:   // 全文件公开（子模块符号供包内兄弟模块经合并全局池解析）

// ==================== 396-a（D36·块新名清单栈·352-b 设计） ====================
// 扁平模型：块名清单平铺+边界栈（出块按边界恢复局部槽绑定·D36 遮蔽语义根治）
// 584-a（011 覆盖型）：平行 块名旧槽平铺 记录登记时被遮蔽的旧绑定——删除型=0-1
//   （出块 删除）、覆盖型=旧槽值（出块 设置 恢复外层绑定，505 锚：嵌套同名
//   标量出块读外层值而非块内残值）。两向量严格同步 push/pop。
静态 向量<整64> 块名清单平铺;
静态 向量<整64> 块名旧槽平铺;
静态 向量<整64> 块边界栈;

函数 块清单入栈() -> 空类型 {
    整64 当前尾 = 块名清单平铺.大小();
    结果<空类型, 整32> 加 = 块边界栈.追加(当前尾);
    如果 加.正常 {
    } 否则 {
        运行时错误(4);
    }
}

函数 块清单登记(整64 名ID) -> 空类型 {
    如果 (块边界栈.大小() == 0) { 返回; }
    结果<空类型, 整32> 加 = 块名清单平铺.追加(名ID);
    如果 加.正常 {
    } 否则 {
        运行时错误(4);
    }
    结果<空类型, 整32> 加旧 = 块名旧槽平铺.追加(0 - 1);
    如果 加旧.正常 {
    } 否则 {
        运行时错误(4);
    }
}

// 584-a（011 覆盖型）：块内同名遮蔽重声明——新槽已由调用方分配并 设置，
//   此处登记「名 + 被遮蔽旧槽」→出块时 设置 恢复外层绑定（非删除）。
函数 块清单登记遮蔽(整64 名ID, 整64 旧槽) -> 空类型 {
    如果 (块边界栈.大小() == 0) { 返回; }
    结果<空类型, 整32> 加 = 块名清单平铺.追加(名ID);
    如果 加.正常 {
    } 否则 {
        运行时错误(4);
    }
    结果<空类型, 整32> 加旧 = 块名旧槽平铺.追加(旧槽);
    如果 加旧.正常 {
    } 否则 {
        运行时错误(4);
    }
}

不安全 函数 块清单出栈恢复(映射<整64, 整64>& 局部槽) -> 空类型 {
    如果 (块边界栈.大小() == 0) { 返回; }
    整64 末边界 = 块边界栈.元素(块边界栈.大小() - 1);
    整64 i = 块名清单平铺.大小() - 1;
    当 (i >= 末边界) {
        整64 名ID = 块名清单平铺.元素(整32(i));
        整64 旧槽 = 块名旧槽平铺.元素(整32(i));
        如果 (旧槽 >= 0) {
            // 覆盖型：恢复外层绑定（块内遮蔽声明的新槽弃用）
            结果<空类型, 整32> 设回 = 局部槽.设置(名ID, 旧槽);
            如果 (!设回.正常) { 运行时错误(4); }
        } 否则 {
            // 映射.删除 返回 布尔（stdlib/映射集合 签名）——语句式调用（布尔丢弃
            //   不触发结果检查防线·出块删除的名必在=本函数内分配）
            局部槽.删除(名ID);
        }
        结果<空类型, 整32> 删平 = 块名清单平铺.删除(整32(i));
        如果 删平.正常 {
        } 否则 {
            运行时错误(4);
        }
        结果<空类型, 整32> 删旧 = 块名旧槽平铺.删除(整32(i));
        如果 删旧.正常 {
        } 否则 {
            运行时错误(4);
        }
        i--;
    }
    结果<空类型, 整32> 删边 = 块边界栈.删除(块边界栈.大小() - 1);
    如果 删边.正常 {
    } 否则 {
        运行时错误(4);
    }
}

// 变量声明语句分派：类型附加位 1..255=指针（登记后继续走具体类型路径）、
//   256=引用局部；容器/结果/结构体 各专用布局；兜底=普通标量单槽。
不安全 函数 生成变量声明(向量<节点> 池, 节点 n,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) {
    向量<IR指令>& 指令 = 函数信息.指令;
    节点 类型节点 = 池.元素(整32(n.附加));
    字符串 类型文本 = 字符串复制(驻留文本(整64(类型节点.文本)));
    // 46-c 推断声明（2026-09-10 第四十九轮）：类型节点文本=空串哨兵——查
    //   推断声明类型表（语义层推导登记，IR布局 跨层表）回填类型（后续指针
    //   登记/容器/结果/结构体/标量分派全按回填类型走既有通道）。miss=IR 层
    //   可见诊断 fail fast（语义层兜底整64 已登记，miss 仅语义/IR 不同步时
    //   触发——绝不静默降级）。
    如果 (整64(类型节点.文本) == 整64(驻留(""))) {
        整64 推断回填ID = 查推断声明类型(整64(n.文本));
        如果 (推断回填ID == 0) {
            IR层诊断("推断声明类型未登记: " + 驻留文本(整64(n.文本)));
        }
        类型文本 = 字符串复制(驻留文本(推断回填ID));
        // 单字段回填（标量通道）——类型节点 = 建节点(...) 整体赋值位右值=调用
        //   形态会被第四十八轮结构体整体拷贝拦截诊断（右值白名单：标识符/成员/
        //   构造字面量）；类型节点 为池.元素 副本，附加位恒 0（解析层推断
        //   类型节点建节点(节点_类型, ..., 0, 0, 0)）无需重建。
        类型节点.文本 = 整32(推断回填ID);
    }
    // ③ 第三波：指针局部登记（附加=指针层数 1..255，同参数约定——
    //   整32* p = &t.甲 形态，下标读写步进按所指元素宽度）
    如果 (类型节点.附加 >= 1 && 类型节点.附加 < 256) {
        登记指针变量类型(整64(n.文本), 整64(类型节点.文本));
    }
    如果 (类型节点.附加 == 256) {
        生成引用局部(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈);
        返回;
    }
    // 第七十八轮（2026-09-12）：用户类对象局部（对象指针语义——分配+构造+RAII，
    //   与容器同模型；判定先于容器/结果/结构体分派）
    // 589-a（005 甲案 v2 同构）：指针层数判定——`点* p2 = &p1` 解析层建为
    //   类型文本="点"+附加=1（指针层数），原判定未查附加 → 类指针声明误入
    //   类对象构造路径（拷贝初始化拒绝·050 双测实锤）。加 附加==0：类指针
    //   声明落指针局部登记+通用初始化路径（= &类变量 经 589 取地址同构产
    //   对象地址·与宿主语义对齐）。该形态此前编译拒绝=纯新增支持面零回归。
    // 595-a（001-001 双模收敛·判定面单点化）：容器判定前移至用户类之前——
    //   撤守卫态 stdlib 源码级加载后容器实例同时登记 用户类们+结构体大小表
    //   （IR类.cn 实例化注册），原「用户类先于容器」分派令容器局部被
    //    生成类对象局部 抢道（预扫槽双分配/返回接收 RAII 误登记/构造要求
    //   不匹配·侦察根因1）。容器实例恒走 生成容器局部（句柄模型·与宿主
    //   具名类实例局部同构）；生产态容器实例不在用户类表=顺序无关零变化。
    如果 (是容器类(类型文本)) {
        生成容器局部(池, n, 类型节点, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈);
        返回;
    }
    如果 (类型节点.附加 == 0 && 是用户类(类型文本)) {
        生成类对象局部(池, n, 类型节点, 局部槽, 参数槽, 函数信息, 寄存器计数,
                       槽计数, 表达式栈);
        返回;
    }
    // 884-a（070·G-N·537 前置）：**数组判定先行**——`结果<整32, 整32>[2] 组;`
    //   （合成体数组）类型文本=`结果$整32$整32[2]`，原**结果类型分支在前**把数组
    //   形态吞掉（生成结果局部·未登记数组名退化）→ 下标左值「对象未支持」（537 A
    //   段实锤）；数组判定=尾部 `[N]` 与结果前缀正交，先判数组语义正确（元素=结果）。
    //   94-a（2026-09-13 第九十四轮）：数组局部（规格书 3.5 `类型[长度] 名`）——
    //   判定须先于结构体分派（数组类型文本含 '[' 不含结构体登记）
    如果 (是数组类型文本(类型文本)) {
        生成数组局部(池, n, 类型节点, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈);
        返回;
    }
    如果 (是结果类型(类型文本)) {
        生成结果局部(池, n, 类型节点, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈);
        返回;
    }
    // 589-a（005 甲案 v2 同构）：指针层数排除——类在结构体大小表有登记（复用
    //   布局），`点* p2` 的 类型文本="点" 会误入结构体局部路径（整体初始化拒绝
    //   ·050 双测第二层实锤）。附加==0 才走结构体；类指针落通用指针槽路径
    //   （8 字节槽+初值 Store——与宿主指针声明语义对齐）。
    如果 (类型节点.附加 == 0 && 查结构体大小(整64(类型节点.文本)) != 0) {
        生成结构体局部(池, n, 类型节点, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈);
        返回;
    }
    // 变量声明：分配槽；若有初值（子起点<子终点），生成初值表达式 + 存储。
    //   46-f 第五十轮：正32 目标存储前截断（wrapping mod 2^32——对齐宿主 u32
    //   4 字节槽天然截断；4000000000+4000000000 存槽须=3705032704 非 8000000000）
    //   plans/019 阶段4' 第二批：拥有型字符串槽由 预扫容器声明 预分配（含
    //   IR_分配+入口零初始化）——此处获取优先复用（容器局部同款；非字符串
    //   标量预扫不分配，miss 走原路径零行为变化）。
    整64 槽 = 0;
    布尔 预扫已分配 = 假;
    // 200-a（2026-09-15 第两百轮，D1 行数整改）：标量通道三段提取（程序化切片+双名单差集审计·
    //   预防 183/184/185）——分配标量声明槽（槽/预扫已分配 引用输出）/生成标量声明初值/
    //   登记声明字符串RAII（73-a 名单登记）。前置类型解析+六形态分派链留主函数。
    分配标量声明槽(n, 类型节点, 局部槽, 函数信息, 槽计数, 槽, 预扫已分配);
    // 040（001 §5.8 子案 A·2026-10-05 用户裁决）：无初值函数指针声明=确定性零值
    //   ——零存储打底（原零发射=栈垃圾→判零防线假阴性·call 0xA 脏崩实锤；
    //   宿主 BSS 零语义对齐·空调用判零走错误码3 确定性失败）
    如果 (n.子起点 >= n.子终点 &&
         字符串长度(类型文本) >= 16 &&
         字符串比较(字符串子串(类型文本, 0, 13), "函数指针<")) {
        整64 零regf480 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("0")), 0, 0,
                             零regf480, T_整64, 0));
        IR追加(指令, 建IR指令(IR_存储, 零regf480, 0, 0, 0, 0, 槽));
    }
    生成标量声明初值(池, n, 类型节点, 类型文本, 槽, 预扫已分配, 局部槽, 参数槽,
                     函数信息, 寄存器计数, 槽计数, 表达式栈);
    登记声明字符串RAII(n, 类型节点, 预扫已分配, 函数信息);
}

// 200-a：族① 标量声明槽分配（预扫复用/新分配 + 嵌套同名污染防御 + 权威表登记 + 分配发射）。
//   槽/预扫已分配=引用输出（预防 177：写语义必须引用参数）。
不安全 函数 分配标量声明槽(节点 n, 节点 类型节点, 映射<整64, 整64>& 局部槽, 函数IR& 函数信息, 整64* 槽计数,
                  整64& 槽, 布尔& 预扫已分配) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    // 810 轮（053）：128 位标量=16 字节 2 槽（栈向下生长·基址槽=槽起+槽数-1
    //   低地址·与 94-a 数组「基址槽=槽起+槽数-1」同规）——局部槽映射登记
    //   基址槽（IR_取地址 基址=对象首地址）。槽尺寸分派单点（本函数），
    //   初值生成（生成标量声明初值 128 位分支）与标识符求值（128 位取地址）
    //   按类型码 T_整128/T_正128 协同。
    布尔 是128标量w = 整64(类型节点.文本) == 驻留("整128") ||
                       整64(类型节点.文本) == 驻留("正128");
    整64 标量槽宽w = 1;
    如果 (是128标量w) { 标量槽宽w = 2; }
    结果<整64, 整32> 找槽v = 局部槽.获取(整64(n.文本));
    如果 (找槽v.正常) {
        // 584-a（011 覆盖型·505 锚）：块上下文中的同名命中=遮蔽重声明——分配
        //   新槽（不与外层同名合槽：合槽使块内写污染外层值）+旧绑定入块清单
        //   （出块 设置 恢复）。字符串除外=可能有函数级预扫槽（预扫复用不是
        //   遮蔽）；嵌套同名字符串标量的合槽残余=诚实边界（021 011 行登记）。
        如果 (整64(类型节点.文本) != 驻留("字符串")) {
            槽 = 槽计数[0];
            槽计数[0] = 槽计数[0] + 标量槽宽w;
            整64 基址槽w = 槽 + 标量槽宽w - 1;
            结果<空类型, 整32> 设槽 = 局部槽.设置(整64(n.文本), 基址槽w);
            如果 (!设槽.正常) { 运行时错误(4); }
            块清单登记遮蔽(整64(n.文本), 找槽v.值);
            预扫已分配 = 假;
        } 否则 {
            槽 = 找槽v.值;
            预扫已分配 = 真;
        }
    } 否则 {
        槽 = 槽计数[0];
        槽计数[0] = 槽计数[0] + 标量槽宽w;
        整64 基址槽w2 = 槽 + 标量槽宽w - 1;
        结果<空类型, 整32> 设槽 = 局部槽.设置(整64(n.文本), 基址槽w2);
        如果 (!设槽.正常) { 运行时错误(4); }
        // 396-a（D36）：新分配=本块新名→入当前块清单
        块清单登记(整64(n.文本));
    }
    // plans/019 阶段4' 第二批防御：嵌套同名异类型声明复用字符串槽（v2 局部槽
    //   =函数级映射同名合槽）——槽值被非字符串覆盖后返回块 free=悬垂，污染名单
    //   退出 RAII（不在字符串名单的名污染登记无副作用——释放挂点双查名单）
    如果 (预扫已分配 && 整64(类型节点.文本) != 驻留("字符串")) {
        登记串污染(函数信息, 整64(n.文本));   // 75-a：唯一入口（镜像同步）
    }
    // ③ 缺陷①根治：标量局部（字符串/浮点/布尔/整数）入函数级变量类型
    //   权威表（打印分派/拼接转换经 寄存器类型登记 消费——与容器/结果/
    //   结构体局部同表，权威表自此完整覆盖本函数全部局部）
    登记当前函数变量类型(整64(n.文本), 整64(类型节点.文本));
    如果 (!预扫已分配) {
        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽));
        // 810（053）：128 位标量=2 槽——次槽（高地址）同样零初始化分配
        如果 (是128标量w) {
            IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽 + 1));
        }
    }
}

// 200-a：族② 标量声明初值生成（初值表达式 + 字符串拥有化〔白名单八函数∪返回类型契约〕+
//   正32 截断/浮点宽化 + 存储；无初值声明零发射直达族③）。
不安全 函数 生成标量声明初值(向量<节点> 池, 节点 n, 节点 类型节点, 字符串 类型文本, 整64 槽,
                   布尔 预扫已分配, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                   函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                   向量<整64>& 表达式栈) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    // 810 轮（053）：128 位声明初值——三形态分派（先于通用路径）：
    //   ① 源=128 位表达式（值=地址句柄·变量/静态/调用返回/算术结果缓冲）→
    //      发射128位双半拷贝 到槽对（值语义独立副本·消费点深拷）；
    //   ② 源=整数字面量 → 解析128位初值文本 拆半（64 位域内/大值统一·
    //      two's complement·与静态槽 .data 双 quad 同源逻辑）→ 低/高半
    //      IR_常量整数 分存基址槽/次槽；
    //   ③ 其余形态 → IR 层诊断拒绝（宁严勿松——批次 E 算术/负号完成后
    //      产物均为地址句柄，本态不可达；诊断防漏网形态静默错值）。
    //   槽对约定=分配标量声明槽：基址槽=局部槽登记值（低地址·低半）、次槽=基址槽-1（高地址·高半）。
    如果 (整64(类型节点.文本) == 驻留("整128") ||
         整64(类型节点.文本) == 驻留("正128")) {
        整64 基址槽128 = 槽 + 1;
        整64 次槽128 = 槽;
        如果 (n.子起点 < n.子终点) {
            节点 初末128 = 池.元素(n.子终点 - 1);
            // 810（053）：负字面量形态（节点_负号 包裹 整数字面量·324 的
            //   -999999999999999999LL 实证）——文本前置 '-' 后统一拆半
            //   （解析128位初值文本 ② 符号段处理 two's complement）
            字符串 初值文本128 = "";
            布尔 是初值字面量128 = 假;
            如果 (初末128.类型 == 节点_整数字面量) {
                初值文本128 = 字符串复制(驻留文本(整64(初末128.文本)));
                是初值字面量128 = 真;
            } 否则 如果 (初末128.类型 == 节点_负号 && 初末128.子起点 > 0) {
                节点 负子128 = 池.元素(整32(初末128.子起点));
                如果 (负子128.类型 == 节点_整数字面量) {
                    初值文本128 = "-" + 字符串复制(驻留文本(整64(负子128.文本)));
                    是初值字面量128 = 真;
                }
            }
            如果 (是初值字面量128) {
                整64 低半128 = 0;
                整64 高半128 = 0;
                IO::打印到错误("[dbg1022w] 128声明 文本=" + 初值文本128 + "\n");
                // 818（064）：超 整128 域先判拒（宿主 parse 判据同构）
                如果 (字面量超128域(初值文本128)) {
                    IR层诊断("整数字面量超出整128（2^127-1）范围: " + 初值文本128);
                } 否则 如果 (!解析128位初值文本(初值文本128, 低半128, 高半128)) {
                    IR层诊断("128 位字面量初值非法或超域: " + 初值文本128);
                }
                IO::打印到错误("[dbg1022w] 拆半 低=" + 整数转字符串(低半128) +
                               " 高=" + 整数转字符串(高半128) + "\n");
                整64 低寄存器128 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(低半128)), 0, 0,
                                     低寄存器128, T_整64, 0));
                IR追加(指令, 建IR指令(IR_存储, 低寄存器128, 0, 0, 0, 0, 基址槽128));
                整64 高寄存器128 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(高半128)), 0, 0,
                                     高寄存器128, T_整64, 0));
                IR追加(指令, 建IR指令(IR_存储, 高寄存器128, 0, 0, 0, 0, 次槽128));
            } 否则 {
                整64 值寄存器128 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                              指令, 寄存器计数, &函数信息.块计数,
                                              槽计数, 表达式栈);
                整64 源码128 = 查寄存器类型(值寄存器128);
                如果 (源码128 == T_整128 || 源码128 == T_正128) {
                    发射128位双半拷贝(值寄存器128, 基址槽128, 次槽128,
                                      指令, 寄存器计数);
                } 否则 {
                    // 545/546（070 波D-二·1022 深度机·任务 077 通道窄半）：窄整/
                    //   64 位初值 → 128 符号性提升物化（宿主 emitCast「普通整数
                    //   →128」同语义）——物化128位操作数 双半槽对（字面量回扫拆
                    //   半/符号扩展 sar 63）+拷贝入声明槽。未知码=整数类兜底
                    //   （二元算术产物不登记·既有惯例→按有符号整64 物化；正32/正64 源=零扩展）。
                    整64 物化码128b = 源码128;
                    整64 有符号128b = 1;
                    如果 (源码128 == T_未知) { 物化码128b = T_整64; }
                    如果 (源码128 == T_正32 || 源码128 == T_正64) {
                        有符号128b = 0;
                    }
                    整64 句柄128b = 物化128位操作数(值寄存器128, 物化码128b, 有符号128b,
                                              指令, 寄存器计数, 槽计数);
                    发射128位双半拷贝(句柄128b, 基址槽128, 次槽128,
                                      指令, 寄存器计数);
                }
            }
        }
        返回;
    }
    如果 (n.子起点 < n.子终点) {
        整64 值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                     指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
        // T69（480-a 深度机）：声明初始化位函数名收口——`整32(*f)(整32) = 加一;`
        //   初值=函数名（负占位）→ IR_函数地址（宿主语义：函数名作值=函数指针）
        值寄存器 = 值位函数名收口480(值寄存器, 指令, 寄存器计数);
        // 104/440（070 波C）：方法引用闭包登记（宿主 genVarDecl closureInfo_
        //   同构）——初值生成期间方法引用分支写了最近槽+初值末节点=成员 →
        //   变量名绑定闭包（调用位 方法引用闭包调用展开 消费）+清最近槽。
        如果 (最近方法引用符号 != 0 && 整64(n.子终点) > 整64(n.子起点)) {
            节点 初值末104 = 池.元素(整32(整64(n.子终点) - 1));
            如果 (初值末104.类型 == 节点_成员) {
                结果<空类型, 整32> 设闭包104 = 方法引用符号们.设置(
                    整64(n.文本), 最近方法引用符号);
                如果 (!设闭包104.正常) { 运行时错误(4); }
                结果<空类型, 整32> 设闭包对象104 = 方法引用对象们.设置(
                    整64(n.文本), 最近方法引用对象);
                如果 (!设闭包对象104.正常) { 运行时错误(4); }
                结果<空类型, 整32> 设闭包码104 = 方法引用返回码们.设置(
                    整64(n.文本), 最近方法引用返回码);
                如果 (!设闭包码104.正常) { 运行时错误(4); }
                最近方法引用符号 = 0;
                最近方法引用对象 = 0;
                最近方法引用返回码 = 0;
            }
        }
        如果 (值寄存器 != 0) {            // plans/019 阶段4' 第二批：拥有型字符串初始化拥有化（宿主第一批
            //   同构，Rust "x".to_string() 同款）——名单内且未污染时：字面量
            //   （只读驻留指针）/标识符拷贝（浅共享指针）经 __cn_str_copy 落堆
            //   （变量一律拥有堆串，返回块/块出口释放安全）；白名单八函数调用
            //   返回恒堆直存（预扫已判定）；其余形态（非白名单调用/下标/成员
            //   等——嵌套块同名借用声明的值覆盖场景）污染退出 RAII（旧拥有值
            //   泄漏不崩——保守安全，宿主 stringTainted_ 同构）。
            如果 (整64(类型节点.文本) == 驻留("字符串") && 预扫已分配) {
                结果<整64, 整32> 查污初 = 函数信息.字符串污染们.获取(整64(n.文本));
                如果 (!查污初.正常) {
                    节点 初末o = 池.元素(n.子终点 - 1);
                    如果 (初末o.类型 == 节点_字符串字面量 ||
                         初末o.类型 == 节点_标识符) {
                        整64 copy寄存器 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_调用实参, 值寄存器, 0, 0, 0, 0, 0));
                        IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, copy寄存器, 0,
                                             驻留("__cn_str_copy")));
                        登记寄存器类型(copy寄存器, T_字符串);
                        值寄存器 = copy寄存器;
                    } 否则 如果 (初末o.类型 != 节点_调用) {
                        // 非调用非字面量非标识符（下标/成员/解引用/二元等）：
                        //   借用形态——污染退出（白名单调用不经此分支）
                        登记串污染(函数信息, 整64(n.文本));   // 75-a：唯一入口
                    } 否则 {
                        // 调用形态：白名单八函数（预扫已登记）=拥有直存；其余
                        //   =借用——污染退出（嵌套同名防御）
                        节点 被调o = 池.元素(整32(初末o.子起点));
                        布尔 白o = 假;
                        如果 (被调o.类型 == 节点_标识符) {
                            整64 被调名o = 整64(被调o.文本);
                            白o = 被调名o == 驻留("字符串复制") ||
                                 被调名o == 驻留("字符串连接") ||
                                 被调名o == 驻留("字符串拼接") ||
                                 被调名o == 驻留("字符串子串") ||
                                 被调名o == 驻留("字符串大写") ||
                                 被调名o == 驻留("字符串小写") ||
                                 被调名o == 驻留("字符串修剪") ||
                                 被调名o == 驻留("字符串反转");
                            // A2（方案甲）：返回类型契约——被调者返回 字符串 即拥有（白名单∪返回类型，驻留文本=字符* 不入）。
                            // 72-a（2026-09-11 第七十二轮）：查函数返回回退
                            //   （键基回退版）——纯名查跨模块 miss，导入模块函数
                            //   返回字符串的契约会整体失效（宿主同族根治）。
                            如果 (!白o && 查函数返回回退(被调名o) == 驻留("字符串")) {
                                白o = 真;
                            }
                        }
                        如果 (!白o) {
                            登记串污染(函数信息, 整64(n.文本));   // 75-a：唯一入口
                        }
                    }
                }
            }
            // 565 轮（T33 残余根治）：窄宽真标量（指针层 附加==0·指针/引用声明
            //   落穿本路径且类型文本=基类型——附加>=1 时值=地址，按窄值规范化=
            //   截断地址→段错误（194 正8* q 实锤），必须跳过）
            如果 (类型节点.附加 == 0) {
                值寄存器 = 窄宽值规范化(窄宽码自文本(类型文本), 值寄存器, 指令, 寄存器计数);
            }
            值寄存器 = 浮点宽化存储(类型文本, 值寄存器, 指令, 寄存器计数);
            // 814（053-001）：64 位目标初值收到 128 位值（超域字面量物化句柄）→
            //   隐式窄化低半（宿主 emitCast 同款——446 `整64 a64=-2^63` 实证）
            值寄存器 = 隐式窄化到64(值寄存器, 指令, 寄存器计数);
            IR追加(指令, 建IR指令(IR_存储, 值寄存器, 0, 0, 0, 0, 槽));
        }
    }
}

// 200-a：族③ 拥有型字符串 RAII 名单生成期登记（73-a 块级 RAII 生效要件；污染名不登记）。
