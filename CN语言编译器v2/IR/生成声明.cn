// CN 自举编译器 v2 · 生成声明（R3 千行拆分，2026-09-08）
// 职责：语句级变量声明 IR 生成——自 生成语句.cn 机械搬移（零逻辑变化）：
//   指针/引用登记 → 引用局部 / 容器（构造/返回接收/标识符拷贝）/ 结果 /
//   结构体 分派 → 普通标量。原分支出口 位置++;继续; 由 生成语句 主循环统一。
// 模块路径=生成声明（新键基）；仅被 生成语句 消费。
导入 容器::向量;
导入 语法;       // Token/AST 节点池
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 IR生成;     // 生成表达式/生成左值地址 + 权威表访问函数

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

公开:   // 全文件公开（子模块符号供包内兄弟模块经合并全局池解析）

// ==================== 396-a（D36·块新名清单栈·352-b 设计） ====================
// 扁平模型：块名清单平铺+边界栈（出块按边界恢复局部槽绑定·D36 遮蔽语义根治）
// 584-a（011 覆盖型）：平行 块名旧槽平铺 记录登记时被遮蔽的旧绑定——删除型=0-1
//   （出块 删除）、覆盖型=旧槽值（出块 设置 恢复外层绑定，505 锚：嵌套同名
//   标量出块读外层值而非块内残值）。两向量严格同步 push/pop。
静态 向量<整64> 块名清单平铺;
静态 向量<整64> 块名旧槽平铺;
静态 向量<整64> 块边界栈;

函数 块清单入栈() -> 空类型 {
    整64 当前尾 = 块名清单平铺.大小();
    结果<空类型, 整32> 加 = 块边界栈.追加(当前尾);
    如果 加.正常 {
    } 否则 {
        运行时错误(4);
    }
}

函数 块清单登记(整64 名ID) -> 空类型 {
    如果 (块边界栈.大小() == 0) { 返回; }
    结果<空类型, 整32> 加 = 块名清单平铺.追加(名ID);
    如果 加.正常 {
    } 否则 {
        运行时错误(4);
    }
    结果<空类型, 整32> 加旧 = 块名旧槽平铺.追加(0 - 1);
    如果 加旧.正常 {
    } 否则 {
        运行时错误(4);
    }
}

// 584-a（011 覆盖型）：块内同名遮蔽重声明——新槽已由调用方分配并 设置，
//   此处登记「名 + 被遮蔽旧槽」→出块时 设置 恢复外层绑定（非删除）。
函数 块清单登记遮蔽(整64 名ID, 整64 旧槽) -> 空类型 {
    如果 (块边界栈.大小() == 0) { 返回; }
    结果<空类型, 整32> 加 = 块名清单平铺.追加(名ID);
    如果 加.正常 {
    } 否则 {
        运行时错误(4);
    }
    结果<空类型, 整32> 加旧 = 块名旧槽平铺.追加(旧槽);
    如果 加旧.正常 {
    } 否则 {
        运行时错误(4);
    }
}

不安全 函数 块清单出栈恢复(映射<整64, 整64>& 局部槽) -> 空类型 {
    如果 (块边界栈.大小() == 0) { 返回; }
    整64 末边界 = 块边界栈.元素(块边界栈.大小() - 1);
    整64 i = 块名清单平铺.大小() - 1;
    当 (i >= 末边界) {
        整64 名ID = 块名清单平铺.元素(整32(i));
        整64 旧槽 = 块名旧槽平铺.元素(整32(i));
        如果 (旧槽 >= 0) {
            // 覆盖型：恢复外层绑定（块内遮蔽声明的新槽弃用）
            结果<空类型, 整32> 设回 = 局部槽.设置(名ID, 旧槽);
            如果 (!设回.正常) { 运行时错误(4); }
        } 否则 {
            // 映射.删除 返回 布尔（stdlib/映射集合 签名）——语句式调用（布尔丢弃
            //   不触发结果检查防线·出块删除的名必在=本函数内分配）
            局部槽.删除(名ID);
        }
        结果<空类型, 整32> 删平 = 块名清单平铺.删除(整32(i));
        如果 删平.正常 {
        } 否则 {
            运行时错误(4);
        }
        结果<空类型, 整32> 删旧 = 块名旧槽平铺.删除(整32(i));
        如果 删旧.正常 {
        } 否则 {
            运行时错误(4);
        }
        i--;
    }
    结果<空类型, 整32> 删边 = 块边界栈.删除(块边界栈.大小() - 1);
    如果 删边.正常 {
    } 否则 {
        运行时错误(4);
    }
}

// 变量声明语句分派：类型附加位 1..255=指针（登记后继续走具体类型路径）、
//   256=引用局部；容器/结果/结构体 各专用布局；兜底=普通标量单槽。
不安全 函数 生成变量声明(向量<节点> 池, 节点 n,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) {
    向量<IR指令>& 指令 = 函数信息.指令;
    节点 类型节点 = 池.元素(整32(n.附加));
    字符串 类型文本 = 字符串复制(驻留文本(整64(类型节点.文本)));
    // 46-c 推断声明（2026-09-10 第四十九轮）：类型节点文本=空串哨兵——查
    //   推断声明类型表（语义层推导登记，IR布局 跨层表）回填类型（后续指针
    //   登记/容器/结果/结构体/标量分派全按回填类型走既有通道）。miss=IR 层
    //   可见诊断 fail fast（语义层兜底整64 已登记，miss 仅语义/IR 不同步时
    //   触发——绝不静默降级）。
    如果 (整64(类型节点.文本) == 整64(驻留(""))) {
        整64 推断回填ID = 查推断声明类型(整64(n.文本));
        如果 (推断回填ID == 0) {
            IR层诊断("推断声明类型未登记: " + 驻留文本(整64(n.文本)));
        }
        类型文本 = 字符串复制(驻留文本(推断回填ID));
        // 单字段回填（标量通道）——类型节点 = 建节点(...) 整体赋值位右值=调用
        //   形态会被第四十八轮结构体整体拷贝拦截诊断（右值白名单：标识符/成员/
        //   构造字面量）；类型节点 为池.元素 副本，附加位恒 0（解析层推断
        //   类型节点建节点(节点_类型, ..., 0, 0, 0)）无需重建。
        类型节点.文本 = 整32(推断回填ID);
    }
    // ③ 第三波：指针局部登记（附加=指针层数 1..255，同参数约定——
    //   整32* p = &t.甲 形态，下标读写步进按所指元素宽度）
    // 615：层数实参=类型节点附加位（成员链对象段加载次数消费）
    如果 (类型节点.附加 >= 1 && 类型节点.附加 < 256) {
        登记指针变量类型(整64(n.文本), 整64(类型节点.文本),
                          整64(类型节点.附加));
    }
    如果 (类型节点.附加 == 256) {
        生成引用局部(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈);
        返回;
    }
    // 416（002 收口·579）：数组判定**上移至全部实例分支之前**（884-a 彼轮只
    //   挪过结果分支——容器/用户类分支仍在数组前：容器实例化注册把 向量$整32
    //   登入用户类们且 是用户类 基名判定对 向量$整32[3] 宽松误真→579 实证
    //   「向量<整32>[3] 槽」走用户类分支=类对象局部·无数组退化指针表→下标
    //   左值「对象未支持」）。数组语义与元素类型正交（884-a 口径推广）：容器/
    //   用户类/结果/结构体 的 [N] 形态统一先落 数组局部（94-a 退化指针表）。
    如果 (是数组类型文本(类型文本)) {
        生成数组局部(池, n, 类型节点, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈);
        返回;
    }
    // 第七十八轮（2026-09-12）：用户类对象局部（对象指针语义——分配+构造+RAII，
    //   与容器同模型；判定先于容器/结果/结构体分派）
    // 589-a（005 甲案 v2 同构）：指针层数判定——`点* p2 = &p1` 解析层建为
    //   类型文本="点"+附加=1（指针层数），原判定未查附加 → 类指针声明误入
    //   类对象构造路径（拷贝初始化拒绝·050 双测实锤）。加 附加==0：类指针
    //   声明落指针局部登记+通用初始化路径（= &类变量 经 589 取地址同构产
    //   对象地址·与宿主语义对齐）。该形态此前编译拒绝=纯新增支持面零回归。
    // 595-a（001-001 双模收敛·判定面单点化）：容器判定前移至用户类之前——
    //   撤守卫态 stdlib 源码级加载后容器实例同时登记 用户类们+结构体大小表
    //   （IR类.cn 实例化注册），原「用户类先于容器」分派令容器局部被
    //    生成类对象局部 抢道（预扫槽双分配/返回接收 RAII 误登记/构造要求
    //   不匹配·侦察根因1）。容器实例恒走 生成容器局部（句柄模型·与宿主
    //   具名类实例局部同构）；生产态容器实例不在用户类表=顺序无关零变化。
    如果 (是容器类(类型文本)) {
        生成容器局部(池, n, 类型节点, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈);
        返回;
    }
    如果 (类型节点.附加 == 0 && 是用户类(类型文本)) {
        生成类对象局部(池, n, 类型节点, 局部槽, 参数槽, 函数信息, 寄存器计数,
                       槽计数, 表达式栈);
        返回;
    }
    如果 (是结果类型(类型文本)) {
        生成结果局部(池, n, 类型节点, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈);
        返回;
    }
    // 589-a（005 甲案 v2 同构）：指针层数排除——类在结构体大小表有登记（复用
    //   布局），`点* p2` 的 类型文本="点" 会误入结构体局部路径（整体初始化拒绝
    //   ·050 双测第二层实锤）。附加==0 才走结构体；类指针落通用指针槽路径
    //   （8 字节槽+初值 Store——与宿主指针声明语义对齐）。
    如果 (类型节点.附加 == 0 && 查结构体大小(整64(类型节点.文本)) != 0) {
        生成结构体局部(池, n, 类型节点, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈);
        返回;
    }
    // 变量声明：分配槽；若有初值（子起点<子终点），生成初值表达式 + 存储。
    //   46-f 第五十轮：正32 目标存储前截断（wrapping mod 2^32——对齐宿主 u32
    //   4 字节槽天然截断；4000000000+4000000000 存槽须=3705032704 非 8000000000）
    //   plans/019 阶段4' 第二批：拥有型字符串槽由 预扫容器声明 预分配（含
    //   IR_分配+入口零初始化）——此处获取优先复用（容器局部同款；非字符串
    //   标量预扫不分配，miss 走原路径零行为变化）。
    整64 槽 = 0;
    布尔 预扫已分配 = 假;
    // 200-a（2026-09-15 第两百轮，D1 行数整改）：标量通道三段提取（程序化切片+双名单差集审计·
    //   预防 183/184/185）——分配标量声明槽（槽/预扫已分配 引用输出）/生成标量声明初值/
    //   登记声明字符串RAII（73-a 名单登记）。前置类型解析+六形态分派链留主函数。
    分配标量声明槽(n, 类型节点, 局部槽, 函数信息, 槽计数, 槽, 预扫已分配);
    // 040（001 §5.8 子案 A·2026-10-05 用户裁决）：无初值函数指针声明=确定性零值
    //   ——零存储打底（原零发射=栈垃圾→判零防线假阴性·call 0xA 脏崩实锤；
    //   宿主 BSS 零语义对齐·空调用判零走错误码3 确定性失败）
    // 426（2026-10-11·001 §3.9 换防条文）：扩展至**全部指针层声明**（类型节点
    //   附加>=1·数据/类/数组指针同族）——def-init 豁免的前提=声明点零初始化，
    //   宿主汇编实证 mov $0→槽（判空恒零态）；v2 原缺补零=运行期栈垃圾与宿主
    //   分叉（533 形态⑦实证：宿主判空走 0 支·v2 垃圾走 1 支）
    如果 (n.子起点 >= n.子终点 &&
         (类型节点.附加 >= 1 ||
          (字符串长度(类型文本) >= 16 &&
           字符串比较(字符串子串(类型文本, 0, 13), "函数指针<")))) {
        整64 零regf480 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("0")), 0, 0,
                             零regf480, T_整64, 0));
        IR追加(指令, 建IR指令(IR_存储, 零regf480, 0, 0, 0, 0, 槽));
    }
    生成标量声明初值(池, n, 类型节点, 类型文本, 槽, 预扫已分配, 局部槽, 参数槽,
                     函数信息, 寄存器计数, 槽计数, 表达式栈);
    登记声明字符串RAII(n, 类型节点, 预扫已分配, 函数信息);
}

// 200-a：族① 标量声明槽分配（预扫复用/新分配 + 嵌套同名污染防御 + 权威表登记 + 分配发射）。
//   槽/预扫已分配=引用输出（预防 177：写语义必须引用参数）。
不安全 函数 分配标量声明槽(节点 n, 节点 类型节点, 映射<整64, 整64>& 局部槽, 函数IR& 函数信息, 整64* 槽计数,
                  整64& 槽, 布尔& 预扫已分配) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    // 810 轮（053）：128 位标量=16 字节 2 槽（栈向下生长·基址槽=槽起+槽数-1
    //   低地址·与 94-a 数组「基址槽=槽起+槽数-1」同规）——局部槽映射登记
    //   基址槽（IR_取地址 基址=对象首地址）。槽尺寸分派单点（本函数），
    //   初值生成（生成标量声明初值 128 位分支）与标识符求值（128 位取地址）
    //   按类型码 T_整128/T_正128 协同。
    // 472（2026-10-11）：附加==0 排除指针/引用层（附加=指针层数+引用*256·解析
    //   表达式尾 50）——`整128* p` 文本=剥星基名 "整128"，原判定命中 128 标量
    //   →2 槽分配+初值物化（sar 63 句柄）+标识符按 128 槽地址求值 → p[0] 读到
    //   的是 p 槽内容（指针值本身）非所指元素（0xc60bfff3d8 实测·宿主绿分叉）。
    //   指针层落通用指针路径（1 槽+初值 Store——589-a 同款判据）。
    布尔 是128标量w = 类型节点.附加 == 0 &&
                       (整64(类型节点.文本) == 驻留("整128") ||
                        整64(类型节点.文本) == 驻留("正128"));
    整64 标量槽宽w = 1;
    如果 (是128标量w) { 标量槽宽w = 2; }
    结果<整64, 整32> 找槽v = 局部槽.获取(整64(n.文本));
    如果 (找槽v.正常) {
        // 584-a（011 覆盖型·505 锚）：块上下文中的同名命中=遮蔽重声明——分配
        //   新槽（不与外层同名合槽：合槽使块内写污染外层值）+旧绑定入块清单
        //   （出块 设置 恢复）。字符串除外=可能有函数级预扫槽（预扫复用不是
        //   遮蔽）；嵌套同名字符串标量的合槽残余=诚实边界（021 011 行登记）。
        如果 (整64(类型节点.文本) != 驻留("字符串")) {
            槽 = 槽计数[0];
            槽计数[0] = 槽计数[0] + 标量槽宽w;
            整64 基址槽w = 槽 + 标量槽宽w - 1;
            结果<空类型, 整32> 设槽 = 局部槽.设置(整64(n.文本), 基址槽w);
            如果 (!设槽.正常) { 运行时错误(4); }
            块清单登记遮蔽(整64(n.文本), 找槽v.值);
            预扫已分配 = 假;
        } 否则 {
            槽 = 找槽v.值;
            预扫已分配 = 真;
        }
    } 否则 {
        槽 = 槽计数[0];
        槽计数[0] = 槽计数[0] + 标量槽宽w;
        整64 基址槽w2 = 槽 + 标量槽宽w - 1;
        结果<空类型, 整32> 设槽 = 局部槽.设置(整64(n.文本), 基址槽w2);
        如果 (!设槽.正常) { 运行时错误(4); }
        // 396-a（D36）：新分配=本块新名→入当前块清单
        块清单登记(整64(n.文本));
    }
    // plans/019 阶段4' 第二批防御：嵌套同名异类型声明复用字符串槽（v2 局部槽
    //   =函数级映射同名合槽）——槽值被非字符串覆盖后返回块 free=悬垂，污染名单
    //   退出 RAII（不在字符串名单的名污染登记无副作用——释放挂点双查名单）
    如果 (预扫已分配 && 整64(类型节点.文本) != 驻留("字符串")) {
        登记串污染(函数信息, 整64(n.文本));   // 75-a：唯一入口（镜像同步）
    }
    // ③ 缺陷①根治：标量局部（字符串/浮点/布尔/整数）入函数级变量类型
    //   权威表（打印分派/拼接转换经 寄存器类型登记 消费——与容器/结果/
    //   结构体局部同表，权威表自此完整覆盖本函数全部局部）
    登记当前函数变量类型(整64(n.文本), 整64(类型节点.文本));
    如果 (!预扫已分配) {
        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽));
        // 810（053）：128 位标量=2 槽——次槽（高地址）同样零初始化分配
        如果 (是128标量w) {
            IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽 + 1));
        }
    }
}

// 816（655 返工遗留乙·宿主 propagateLambdaCopyBinding816 同构）：方法值拷贝
//   传递——初值末节点=标识符且该名在 方法引用符号们（变量 cb2 = cb;）→ 三表
//   整体传给新名（调用位 方法引用闭包调用展开 与来源同方法符号同 this 对象：
//   this=对象名 ID 调用点重解槽=引用捕获语义保持）。缺此传递时拷贝调用掉进
//   T69 间接调用只发用户实参=被调方把首实参当 this 解引用（1002-⑥ v2 侧
//   C0000005 fault=6 实锤·宿主侧同缺陷已同轮修）。lambda 拷贝（来源在
//   lambda闭包变量们）不在此传递——快照槽名按「变量名$cap$捕获名」规则绑定
//   登记名，键复制后调用点反查落空；v2 现行 T69 蹦床通道行为正确（1002 dual
//   tA/tC/tD PASS 实证），传递化=随快照槽规则改造另行立项。查询 miss=「来源
//   非方法值变量」的语义本身（集合成员判定·非查表兜底）。
不安全 函数 传递方法值拷贝绑定816(向量<节点> 池, 节点 n) -> 空类型 {
    如果 (n.子终点 <= n.子起点) { 返回; }
    节点 初值末816 = 池.元素(整32(整64(n.子终点) - 1));
    如果 (初值末816.类型 != 节点_标识符 ||
          文本前缀217(驻留文本(整64(初值末816.文本)), "?")) { 返回; }
    // v2 结果纪律：结果.值 只能肯定分支内访问——固化局部变量（方法引用闭包
    //   调用展开 同款嵌套肯定式）
    整64 方法符号816 = 0;
    整64 对象名816 = 0;
    整64 返回码816 = 0;
    结果<整64, 整32> 查符号816 = 方法引用符号们.获取(整64(初值末816.文本));
    如果 (查符号816.正常) {
        如果 (查符号816.值 != 0) {
            结果<整64, 整32> 查对象816 = 方法引用对象们.获取(整64(初值末816.文本));
            如果 (查对象816.正常) {
                结果<整64, 整32> 查码816 = 方法引用返回码们.获取(整64(初值末816.文本));
                如果 (查码816.正常) {
                    方法符号816 = 查符号816.值;
                    对象名816 = 查对象816.值;
                    返回码816 = 查码816.值;
                }
            }
        }
    }
    如果 (方法符号816 == 0) { 返回; }
    结果<空类型, 整32> 设符号816 = 方法引用符号们.设置(整64(n.文本), 方法符号816);
    如果 (!设符号816.正常) { 运行时错误(4); }
    结果<空类型, 整32> 设对象816 = 方法引用对象们.设置(整64(n.文本), 对象名816);
    如果 (!设对象816.正常) { 运行时错误(4); }
    结果<空类型, 整32> 设码816 = 方法引用返回码们.设置(整64(n.文本), 返回码816);
    如果 (!设码816.正常) { 运行时错误(4); }
}

// 200-a：族② 标量声明初值生成（初值表达式 + 字符串拥有化〔白名单八函数∪返回类型契约〕+
//   正32 截断/浮点宽化 + 存储；无初值声明零发射直达族③）。
不安全 函数 生成标量声明初值(向量<节点> 池, 节点 n, 节点 类型节点, 字符串 类型文本, 整64 槽,
                   布尔 预扫已分配, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                   函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                   向量<整64>& 表达式栈) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    // 810 轮（053）：128 位声明初值——三形态分派（先于通用路径）：
    //   ① 源=128 位表达式（值=地址句柄·变量/静态/调用返回/算术结果缓冲）→
    //      发射128位双半拷贝 到槽对（值语义独立副本·消费点深拷）；
    //   ② 源=整数字面量 → 解析128位初值文本 拆半（64 位域内/大值统一·
    //      two's complement·与静态槽 .data 双 quad 同源逻辑）→ 低/高半
    //      IR_常量整数 分存基址槽/次槽；
    //   ③ 其余形态 → IR 层诊断拒绝（宁严勿松——批次 E 算术/负号完成后
    //      产物均为地址句柄，本态不可达；诊断防漏网形态静默错值）。
    //   槽对约定=分配标量声明槽：基址槽=局部槽登记值（低地址·低半）、次槽=基址槽-1（高地址·高半）。
    // 472（2026-10-11）：附加==0 同款排除指针/引用层（`整128* p` 初值须落通用
    //   指针 Store 路径——与 分配标量声明槽 472 判定成对，缺一则槽宽/初值错位）。
    如果 (类型节点.附加 == 0 &&
         (整64(类型节点.文本) == 驻留("整128") ||
          整64(类型节点.文本) == 驻留("正128"))) {
        整64 基址槽128 = 槽 + 1;
        整64 次槽128 = 槽;
        如果 (n.子起点 < n.子终点) {
            节点 初末128 = 池.元素(n.子终点 - 1);
            // 810（053）：负字面量形态（节点_负号 包裹 整数字面量·324 的
            //   -999999999999999999LL 实证）——文本前置 '-' 后统一拆半
            //   （解析128位初值文本 ② 符号段处理 two's complement）
            字符串 初值文本128 = "";
            布尔 是初值字面量128 = 假;
            如果 (初末128.类型 == 节点_整数字面量) {
                初值文本128 = 字符串复制(驻留文本(整64(初末128.文本)));
                是初值字面量128 = 真;
            } 否则 如果 (初末128.类型 == 节点_负号 && 初末128.子起点 > 0) {
                节点 负子128 = 池.元素(整32(初末128.子起点));
                如果 (负子128.类型 == 节点_整数字面量) {
                    初值文本128 = "-" + 字符串复制(驻留文本(整64(负子128.文本)));
                    是初值字面量128 = 真;
                }
            }
            如果 (是初值字面量128) {
                整64 低半128 = 0;
                整64 高半128 = 0;
                // 818（064）：超 整128 域先判拒（宿主 parse 判据同构）
                // 478（473 采样轮）：撤 1022 波J 的 [dbg1022w] 探针打印两行
                //   （机制级顺手修·插桩使命已尽——stderr 噪音污染 v2p 输出面）
                如果 (字面量超128域(初值文本128)) {
                    IR层诊断("整数字面量超出整128（2^127-1）范围: " + 初值文本128);
                } 否则 如果 (!解析128位初值文本(初值文本128, 低半128, 高半128)) {
                    IR层诊断("128 位字面量初值非法或超域: " + 初值文本128);
                }
                整64 低寄存器128 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(低半128)), 0, 0,
                                     低寄存器128, T_整64, 0));
                IR追加(指令, 建IR指令(IR_存储, 低寄存器128, 0, 0, 0, 0, 基址槽128));
                整64 高寄存器128 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(高半128)), 0, 0,
                                     高寄存器128, T_整64, 0));
                IR追加(指令, 建IR指令(IR_存储, 高寄存器128, 0, 0, 0, 0, 次槽128));
            } 否则 {
                整64 值寄存器128 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                              指令, 寄存器计数, &函数信息.块计数,
                                              槽计数, 表达式栈);
                整64 源码128 = 查寄存器类型(值寄存器128);
                如果 (源码128 == T_整128 || 源码128 == T_正128) {
                    发射128位双半拷贝(值寄存器128, 基址槽128, 次槽128,
                                      指令, 寄存器计数);
                } 否则 {
                    // 545/546（070 波D-二·1022 深度机·任务 077 通道窄半）：窄整/
                    //   64 位初值 → 128 符号性提升物化（宿主 emitCast「普通整数
                    //   →128」同语义）——物化128位操作数 双半槽对（字面量回扫拆
                    //   半/符号扩展 sar 63）+拷贝入声明槽。未知码=整数类兜底
                    //   （二元算术产物不登记·既有惯例→按有符号整64 物化；正32/正64 源=零扩展）。
                    // 648 归档：T_未知 兜底源=「二元算术产物不登记」既有惯例
                    //   （查寄存器类型 0=高频合法值面·见该函数归档注释），非查
                    //   表 miss 病面，不登记。
                    整64 物化码128b = 源码128;
                    整64 有符号128b = 1;
                    如果 (源码128 == T_未知) { 物化码128b = T_整64; }
                    如果 (源码128 == T_正32 || 源码128 == T_正64) {
                        有符号128b = 0;
                    }
                    整64 句柄128b = 物化128位操作数(值寄存器128, 物化码128b, 有符号128b,
                                              指令, 寄存器计数, 槽计数);
                    发射128位双半拷贝(句柄128b, 基址槽128, 次槽128,
                                      指令, 寄存器计数);
                }
            }
        }
        返回;
    }
    如果 (n.子起点 < n.子终点) {
        整64 值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                     指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
        // T69（480-a 深度机）：声明初始化位函数名收口——`整32(*f)(整32) = 加一;`
        //   初值=函数名（负占位）→ IR_函数地址（宿主语义：函数名作值=函数指针）
        值寄存器 = 值位函数名收口480(值寄存器, 指令, 寄存器计数);
        // 104/440（070 波C）：方法引用闭包登记（宿主 genVarDecl closureInfo_
        //   同构）——初值生成期间方法引用分支写了最近槽+初值末节点=成员 →
        //   变量名绑定闭包（调用位 方法引用闭包调用展开 消费）+清最近槽。
        如果 (最近方法引用符号 != 0 && 整64(n.子终点) > 整64(n.子起点)) {
            节点 初值末104 = 池.元素(整32(整64(n.子终点) - 1));
            如果 (初值末104.类型 == 节点_成员) {
                结果<空类型, 整32> 设闭包104 = 方法引用符号们.设置(
                    整64(n.文本), 最近方法引用符号);
                如果 (!设闭包104.正常) { 运行时错误(4); }
                结果<空类型, 整32> 设闭包对象104 = 方法引用对象们.设置(
                    整64(n.文本), 最近方法引用对象);
                如果 (!设闭包对象104.正常) { 运行时错误(4); }
                结果<空类型, 整32> 设闭包码104 = 方法引用返回码们.设置(
                    整64(n.文本), 最近方法引用返回码);
                如果 (!设闭包码104.正常) { 运行时错误(4); }
                最近方法引用符号 = 0;
                最近方法引用对象 = 0;
                最近方法引用返回码 = 0;
            }
        }
        // 816：方法值拷贝传递登记（独立函数·本函数存量超百行不再增重·见函数头注）
        传递方法值拷贝绑定816(池, n);
        // #276 波1：lambda 值捕获登记+定义处快照（宿主 registerClosureIfNeeded
        //   同构·「值捕获=捕获时复制」spec 04-一D）——初值末节点=?lambdaN →
        //   变量名绑定（lambda闭包变量们·调用位 lambda闭包调用展开 消费）+
        //   逐捕获快照槽（标量/字符串 Load→Store·字符串不可变浅拷=值语义；
        //   结构体捕获=波1.5 随批立案·快照深拷随结构体赋值通道）。快照槽名
        //   规则化「变量名$cap$捕获名」（局部槽登记·调用点反查同函数共享）。
        如果 (整64(n.子终点) > 整64(n.子起点)) {
            节点 初值末276 = 池.元素(整32(整64(n.子终点) - 1));
            如果 (初值末276.类型 == 节点_标识符) {
                如果 (文本前缀217(驻留文本(整64(初值末276.文本)), "?")) {
                    整64 lambda名276 = 整64(初值末276.文本);
                    结果<空类型, 整32> 登闭包276 = lambda闭包变量们.设置(整64(n.文本), lambda名276);
                    如果 (!登闭包276.正常) { 运行时错误(4); }
                    整64 形态276 = 0;
                    结果<整64, 整32> 查形276 = lambda捕获形态们.获取(lambda名276);
                    如果 (查形276.正常) { 形态276 = 查形276.值; }
                    // #276 波2：形态3=[&] 引用捕获同走快照段（快照源=变量槽地址）
                        结果<整64, 整32> 查起276 = lambda捕获起们.获取(lambda名276);
                        结果<整64, 整32> 查数276 = lambda捕获计数们.获取(lambda名276);
                        整64 起276 = 0;
                        整64 数276 = 0;
                        如果 (查起276.正常) {
                            如果 (查数276.正常) {
                                起276 = 查起276.值;
                                数276 = 查数276.值;
                            }
                        }
                        // 合成函数节点查找（参数区间=捕获类型载体·lambda合成类型 同款倒序）
                        节点 合成276;
                        整64 找到276 = 0;
                        整64 li276 = lambda合成函数索引们.大小() - 1;
                        当 (li276 >= 0) {
                            节点 cand276 = 池.元素(整32(lambda合成函数索引们.元素(整32(li276))));
                            如果 (整64(cand276.文本) == lambda名276) {
                                合成276 = cand276;
                                找到276 = 1;
                                中断;
                            }
                            li276--;
                        }
                        如果 (找到276 == 1) {
                            字符串 变量文本276 = 字符串复制(驻留文本(整64(n.文本)));
                            整64 cap276 = 0;
                            当 (cap276 < 数276) {
                                整64 捕名276 = lambda捕获名序们.元素(整32(起276 + cap276));
                                // 457：语义回填噪声名哨兵（名序位=0）跳过——剔除位
                                //   无快照槽（合成参数区间按 节点_参数 扫·哨兵不占形参位）
                                如果 (捕名276 == 0) { cap276++; 继续; }
                                字符串 快照名276 = 变量文本276 + "$cap$" + 驻留文本(捕名276);
                                // 外层捕获变量槽（局部/参数·定义处当前值=快照源）
                                整64 源槽276 = 0;
                                结果<整64, 整32> 查局276 = 局部槽.获取(捕名276);
                                如果 (查局276.正常) { 源槽276 = 查局276.值; }
                                如果 (源槽276 == 0) {
                                    结果<整64, 整32> 查参276 = 参数槽.获取(捕名276);
                                    如果 (查参276.正常) { 源槽276 = 查参276.值; }
                                }
                                如果 (源槽276 != 0) {
                                    // 捕获类型（合成参数区间 附加=类型节点索引·回填后有效）
                                    节点 捕获参数276 = 池.元素(整32(整64(合成276.子起点) + cap276));
                                    整64 捕型276 = 0;
                                    整64 快照大小276 = 0;
                                    整64 捕附加276 = 0;   // 457：类型节点附加（指针层/引用）
                                    如果 (整64(捕获参数276.附加) > 0 &&
                                         整64(捕获参数276.附加) < 整64(池.大小())) {
                                        节点 类型节点276 = 池.元素(整32(捕获参数276.附加));
                                        捕型276 = 整64(类型节点276.文本);
                                        捕附加276 = 整64(类型节点276.附加);
                                        // #428：结构体值捕获判定——与调用点 生成表达式
                                        //   求值尾 捕是结构体 同条件同构（大小>0 且非容器/
                                        //   用户类）；指针层排除=附加==0（174 行结构体局部
                                        //   同款·指针捕获按标量单槽）
                                        如果 (形态276 != 3 && 整64(类型节点276.附加) == 0 &&
                                             查结构体大小(捕型276) > 0 &&
                                             !是容器类(驻留文本(捕型276)) &&
                                             !是用户类_ID(捕型276)) {
                                            快照大小276 = 查结构体大小(捕型276);
                                        }
                                    }
                                    // 捕获快照槽分派三路（428+418 融合）：
                                    //   ① 结构体值捕获（#428）=多槽（槽数=(大小+7)/8·
                                    //     结构体局部同款·登记最高槽=基址——调用点取
                                    //     基址地址+合成函数 prologue 按参型大小整块拷贝）
                                    //   ② 128 位捕获（#418）=2 槽（810 槽对约定同规·
                                    //     登记值=快照槽+1=低半·次槽=高半）——原单槽
                                    //     IR_加载(捕码=T_整128) 只搬 8 字节低半、高半
                                    //     垃圾；调用展开传址后 prologue 按 16 字节拷贝
                                    //     读垃圾高半=C0000005（18_缺陷修复 实录）
                                    //   ③ 标量/字符串/引用捕获=单槽原样（#276 波1）
                                    整64 捕码276 = 类型码(捕型276);
                                    // 457（462-②）：指针捕获（附加=指针层 1..255·
                                    //   语义回填恢复）快照=单槽 64 位指针值——捕码按
                                    //   基名 T_整32 装载=截断指针 SEGV（801c 实录）·
                                    //   恢复整64；形态3 引用捕获=地址（下方分支先行）。
                                    如果 (形态276 != 3 && 捕附加276 >= 1 &&
                                         捕附加276 < 256) {
                                        捕码276 = T_整64;
                                    }
                                    布尔 捕是128a = 捕码276 == T_整128 || 捕码276 == T_正128;
                                    整64 快照槽276 = 0;
                                    整64 快照基址b = 0;
                                    如果 (快照大小276 > 0) {
                                        整64 快照槽数276 = (快照大小276 + 7) / 8;
                                        快照槽276 = 槽计数[0] + 快照槽数276 - 1;
                                        槽计数[0] = 槽计数[0] + 快照槽数276;
                                        快照基址b = 快照槽276;
                                    } 否则 如果 (捕是128a) {
                                        快照槽276 = 槽计数[0];
                                        槽计数[0] = 槽计数[0] + 2;
                                        快照基址b = 快照槽276 + 1;
                                    } 否则 {
                                        快照槽276 = 槽计数[0];
                                        槽计数[0] = 槽计数[0] + 1;
                                        快照基址b = 快照槽276;
                                    }
                                    结果<空类型, 整32> 登槽276 = 局部槽.设置(驻留(快照名276), 快照基址b);
                                    如果 (!登槽276.正常) { 运行时错误(4); }
                                    // 快照写分派三路（428+418 融合）：
                                    //   ① 结构体（#428）=定义处整体深拷快照（宿主
                                    //     __capstruct+CopyStruct 同构·spec 04-一D 捕获时
                                    //     复制）——IR_取地址×2+IR_结构体拷贝 位拷=生成语句
                                    //     结构体赋值通道同款（原单槽 Load/Store 只拷首
                                    //     8 字节·433 挂账残余面）
                                    //   ② 形态3=[&] 引用捕获（#276 波2）=快照=变量槽地址
                                    //     （IR_取地址·宿主 AddrOf 同构·读最新/写穿载体）
                                    //   ③ 128 位值捕获（#418）=低半（基址=源槽276）/高半
                                    //     （次槽=源槽276-1）两对 Load→Store（快照槽对
                                    //     布局同上）；标量=Load→Store（spec 04-一D 捕获
                                    //     时复制）
                                    如果 (快照大小276 > 0) {
                                        整64 源址276 = 寄存器计数[0];
                                        寄存器计数[0] = 寄存器计数[0] + 1;
                                        整64 目标址276 = 寄存器计数[0];
                                        寄存器计数[0] = 寄存器计数[0] + 1;
                                        IR追加(指令, 建IR指令(IR_取地址, 源槽276, 0, 0,
                                                             源址276, T_整64, 0));
                                        IR追加(指令, 建IR指令(IR_取地址, 快照槽276, 0, 0,
                                                             目标址276, T_整64, 0));
                                        IR追加(指令, 建IR指令(IR_结构体拷贝, 源址276,
                                                             目标址276, 0, 0,
                                                             快照大小276, 0));
                                    } 否则 {
                                        整64 读寄存器276 = 寄存器计数[0];
                                        寄存器计数[0] = 寄存器计数[0] + 1;
                                        如果 (形态276 == 3) {
                                            IR追加(指令, 建IR指令(IR_取地址, 源槽276, 0, 0,
                                                                 读寄存器276, T_整64, 0));
                                            IR追加(指令, 建IR指令(IR_存储, 读寄存器276, 0, 0,
                                                                 0, 0, 快照基址b));
                                        } 否则 如果 (捕是128a) {
                                            IR追加(指令, 建IR指令(IR_加载, 源槽276, 0, 0,
                                                                 读寄存器276, T_整64, 0));
                                            IR追加(指令, 建IR指令(IR_存储, 读寄存器276, 0, 0,
                                                                 0, 0, 快照槽276 + 1));
                                            整64 高读276 = 寄存器计数[0];
                                            寄存器计数[0] = 寄存器计数[0] + 1;
                                            IR追加(指令, 建IR指令(IR_加载, 源槽276 - 1, 0, 0,
                                                                 高读276, T_整64, 0));
                                            IR追加(指令, 建IR指令(IR_存储, 高读276, 0, 0,
                                                                 0, 0, 快照槽276));
                                        } 否则 {
                                            IR追加(指令, 建IR指令(IR_加载, 源槽276, 0, 0,
                                                                 读寄存器276, 捕码276, 0));
                                            IR追加(指令, 建IR指令(IR_存储, 读寄存器276, 0, 0,
                                                                 0, 0, 快照基址b));
                                        }
                                    }
                                }
                                cap276++;
                            }
                        }

                }
            }
        }
        // 482（#482 多实例独立快照）：扫描声明初值位载体处理——初值末=调用
        //   （返回来源已知）建载体槽+共享->载体快照；初值末=?lambdaN（定义点
        //   段已写载体槽·此处幂等）；初值末=已登记变量=拷贝链独立快照；
        //   来源未知=清除陈旧登记。fnptr 值声明（函数指针）唯一消费面。
        如果 (值寄存器 != 0 && 整64(n.子终点) > 整64(n.子起点)) {
            处理载体点482(池, 整32(整64(n.子终点) - 1), 整64(n.文本),
                         局部槽, 参数槽, 指令, 寄存器计数, 槽计数);
        }
        如果 (值寄存器 != 0) {            // plans/019 阶段4' 第二批：拥有型字符串初始化拥有化（宿主第一批
            //   同构，Rust "x".to_string() 同款）——名单内且未污染时：字面量
            //   （只读驻留指针）/标识符拷贝（浅共享指针）经 __cn_str_copy 落堆
            //   （变量一律拥有堆串，返回块/块出口释放安全）；白名单八函数∪返回
            //   类型契约调用返回恒堆直存（预扫已判定·748：内建裸名经 查函数
            //   返回回退 内置兜底同入契约面）；其余形态（非白名单调用/下标/成员
            //   等——嵌套块同名借用声明的值覆盖场景）污染退出 RAII（旧拥有值
            //   泄漏不崩——保守安全，宿主 stringTainted_ 同构）。
            如果 (整64(类型节点.文本) == 驻留("字符串") && 预扫已分配) {
                结果<整64, 整32> 查污初 = 函数信息.字符串污染们.获取(整64(n.文本));
                如果 (!查污初.正常) {
                    节点 初末o = 池.元素(n.子终点 - 1);
                    如果 (初末o.类型 == 节点_字符串字面量 ||
                         初末o.类型 == 节点_标识符) {
                        整64 copy寄存器 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_调用实参, 值寄存器, 0, 0, 0, 0, 0));
                        IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, copy寄存器, 0,
                                             驻留("__cn_str_copy")));
                        登记寄存器类型(copy寄存器, T_字符串);
                        值寄存器 = copy寄存器;
                    } 否则 如果 (初末o.类型 != 节点_调用) {
                        // 非调用非字面量非标识符（下标/成员/解引用/二元等）：
                        //   借用形态——污染退出（白名单调用不经此分支）
                        登记串污染(函数信息, 整64(n.文本));   // 75-a：唯一入口
                    } 否则 {
                        // 调用形态：白名单八函数（预扫已登记）=拥有直存；其余
                        //   =借用——污染退出（嵌套同名防御）
                        节点 被调o = 池.元素(整32(初末o.子起点));
                        布尔 白o = 假;
                        如果 (被调o.类型 == 节点_标识符) {
                            整64 被调名o = 整64(被调o.文本);
                            白o = 被调名o == 驻留("字符串复制") ||
                                 被调名o == 驻留("字符串连接") ||
                                 被调名o == 驻留("字符串拼接") ||
                                 被调名o == 驻留("字符串子串") ||
                                 被调名o == 驻留("字符串大写") ||
                                 被调名o == 驻留("字符串小写") ||
                                 被调名o == 驻留("字符串修剪") ||
                                 被调名o == 驻留("字符串反转");
                            // A2（方案甲）：返回类型契约——被调者返回 字符串 即拥有（白名单∪返回类型，驻留文本=字符* 不入）。
                            // 72-a（2026-09-11 第七十二轮）：查函数返回回退
                            //   （键基回退版）——纯名查跨模块 miss，导入模块函数
                            //   返回字符串的契约会整体失效（宿主同族根治）。
                            如果 (!白o && 查函数返回回退(被调名o) == 驻留("字符串")) {
                                白o = 真;
                            }
                        }
                        如果 (!白o) {
                            登记串污染(函数信息, 整64(n.文本));   // 75-a：唯一入口
                        }
                    }
                }
            }
            // 565 轮（T33 残余根治）：窄宽真标量（指针层 附加==0·指针/引用声明
            //   落穿本路径且类型文本=基类型——附加>=1 时值=地址，按窄值规范化=
            //   截断地址→段错误（194 正8* q 实锤），必须跳过）
            如果 (类型节点.附加 == 0) {
                值寄存器 = 窄宽值规范化(窄宽码自文本(类型文本), 值寄存器, 指令, 寄存器计数);
            }
            值寄存器 = 浮点宽化存储(类型文本, 值寄存器, 指令, 寄存器计数);
            // 814（053-001）：64 位目标初值收到 128 位值（超域字面量物化句柄）→
            //   隐式窄化低半（宿主 emitCast 同款——446 `整64 a64=-2^63` 实证）
            值寄存器 = 隐式窄化到64(值寄存器, 指令, 寄存器计数);
            IR追加(指令, 建IR指令(IR_存储, 值寄存器, 0, 0, 0, 0, 槽));
        }
    }
}

// 200-a：族③ 拥有型字符串 RAII 名单生成期登记（73-a 块级 RAII 生效要件；污染名不登记）。
