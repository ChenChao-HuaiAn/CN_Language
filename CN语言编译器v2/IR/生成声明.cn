// CN 自举编译器 v2 · 生成声明（R3 千行拆分，2026-09-08）
// 职责：语句级变量声明 IR 生成——自 生成语句.cn 机械搬移（零逻辑变化）：
//   指针/引用登记 → 引用局部 / 容器（构造/返回接收/标识符拷贝）/ 结果 /
//   结构体 分派 → 普通标量。原分支出口 位置++;继续; 由 生成语句 主循环统一。
// 模块路径=生成声明（新键基）；仅被 生成语句 消费。
导入 容器::向量;
导入 语法;       // Token/AST 节点池
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码（目录包名）
导入 IR生成;     // 生成表达式/生成左值地址 + 权威表访问函数

公开:   // 全文件公开（子模块符号供包内兄弟模块经合并全局池解析）

// 变量声明语句分派：类型附加位 1..255=指针（登记后继续走具体类型路径）、
//   256=引用局部；容器/结果/结构体 各专用布局；兜底=普通标量单槽。
不安全 函数 生成变量声明(向量<节点> 池, 节点 n,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) {
    向量<IR指令>& 指令 = 函数信息.指令;
    节点 类型节点 = 池.元素(整32(n.附加));
    字符串 类型文本 = 字符串复制(驻留文本(整64(类型节点.文本)));
    // 46-c 推断声明（2026-09-10 第四十九轮）：类型节点文本=空串哨兵——查
    //   推断声明类型表（语义层推导登记，IR布局 跨层表）回填类型（后续指针
    //   登记/容器/结果/结构体/标量分派全按回填类型走既有通道）。miss=IR 层
    //   可见诊断 fail fast（语义层兜底整64 已登记，miss 仅语义/IR 不同步时
    //   触发——绝不静默降级）。
    如果 (整64(类型节点.文本) == 整64(驻留(""))) {
        整64 推断回填ID = 查推断声明类型(整64(n.文本));
        如果 (推断回填ID == 0) {
            IR层诊断("推断声明类型未登记: " + 驻留文本(整64(n.文本)));
        }
        类型文本 = 字符串复制(驻留文本(推断回填ID));
        // 单字段回填（标量通道）——类型节点 = 建节点(...) 整体赋值位右值=调用
        //   形态会被第四十八轮结构体整体拷贝拦截诊断（右值白名单：标识符/成员/
        //   构造字面量）；类型节点 为池.元素 副本，附加位恒 0（解析层推断
        //   类型节点建节点(节点_类型, ..., 0, 0, 0)）无需重建。
        类型节点.文本 = 整32(推断回填ID);
    }
    // ③ 第三波：指针局部登记（附加=指针层数 1..255，同参数约定——
    //   整32* p = &t.甲 形态，下标读写步进按所指元素宽度）
    如果 (类型节点.附加 >= 1 && 类型节点.附加 < 256) {
        登记指针变量类型(整64(n.文本), 整64(类型节点.文本));
    }
    如果 (类型节点.附加 == 256) {
        生成引用局部(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈);
        返回;
    }
    // 第七十八轮（2026-09-12）：用户类对象局部（对象指针语义——分配+构造+RAII，
    //   与容器同模型；判定先于容器/结果/结构体分派）
    如果 (是用户类(类型文本)) {
        生成类对象局部(池, n, 类型节点, 局部槽, 参数槽, 函数信息, 寄存器计数,
                       槽计数, 表达式栈);
        返回;
    }
    如果 (是容器类(类型文本)) {
        生成容器局部(池, n, 类型节点, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈);
        返回;
    }
    如果 (是结果类型(类型文本)) {
        生成结果局部(池, n, 类型节点, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈);
        返回;
    }
    // 94-a（2026-09-13 第九十四轮）：数组局部（规格书 3.5 `类型[长度] 名`）——
    //   判定须先于结构体分派（数组类型文本含 '[' 不含结构体登记）
    如果 (是数组类型文本(类型文本)) {
        生成数组局部(池, n, 类型节点, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈);
        返回;
    }
    如果 (查结构体大小(整64(类型节点.文本)) != 0) {
        生成结构体局部(池, n, 类型节点, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈);
        返回;
    }
    // 变量声明：分配槽；若有初值（子起点<子终点），生成初值表达式 + 存储。
    //   46-f 第五十轮：正32 目标存储前截断（wrapping mod 2^32——对齐宿主 u32
    //   4 字节槽天然截断；4000000000+4000000000 存槽须=3705032704 非 8000000000）
    //   plans/019 阶段4' 第二批：拥有型字符串槽由 预扫容器声明 预分配（含
    //   IR_分配+入口零初始化）——此处获取优先复用（容器局部同款；非字符串
    //   标量预扫不分配，miss 走原路径零行为变化）。
    整64 槽 = 0;
    布尔 预扫已分配 = 假;
    // 200-a（2026-09-15 第两百轮，D1 行数整改）：标量通道三段提取（程序化切片+双名单差集审计·
    //   预防 183/184/185）——分配标量声明槽（槽/预扫已分配 引用输出）/生成标量声明初值/
    //   登记声明字符串RAII（73-a 名单登记）。前置类型解析+六形态分派链留主函数。
    分配标量声明槽(n, 类型节点, 局部槽, 函数信息, 槽计数, 槽, 预扫已分配);
    生成标量声明初值(池, n, 类型节点, 类型文本, 槽, 预扫已分配, 局部槽, 参数槽,
                     函数信息, 寄存器计数, 槽计数, 表达式栈);
    登记声明字符串RAII(n, 类型节点, 预扫已分配, 函数信息);
}

// 200-a：族① 标量声明槽分配（预扫复用/新分配 + 嵌套同名污染防御 + 权威表登记 + 分配发射）。
//   槽/预扫已分配=引用输出（预防 177：写语义必须引用参数）。
不安全 函数 分配标量声明槽(节点 n, 节点 类型节点, 映射<整64, 整64>& 局部槽, 函数IR& 函数信息, 整64* 槽计数,
                  整64& 槽, 布尔& 预扫已分配) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    结果<整64, 整32> 找槽v = 局部槽.获取(整64(n.文本));
    如果 (找槽v.正常) {
        槽 = 找槽v.值;
        预扫已分配 = 真;
    } 否则 {
        槽 = 槽计数[0];
        槽计数[0] = 槽计数[0] + 1;
        结果<空类型, 整32> 设槽 = 局部槽.设置(整64(n.文本), 槽);
        如果 (!设槽.正常) { 运行时错误(4); }
    }
    // plans/019 阶段4' 第二批防御：嵌套同名异类型声明复用字符串槽（v2 局部槽
    //   =函数级映射同名合槽）——槽值被非字符串覆盖后返回块 free=悬垂，污染名单
    //   退出 RAII（不在字符串名单的名污染登记无副作用——释放挂点双查名单）
    如果 (预扫已分配 && 整64(类型节点.文本) != 驻留("字符串")) {
        登记串污染(函数信息, 整64(n.文本));   // 75-a：唯一入口（镜像同步）
    }
    // ③ 缺陷①根治：标量局部（字符串/浮点/布尔/整数）入函数级变量类型
    //   权威表（打印分派/拼接转换经 寄存器类型登记 消费——与容器/结果/
    //   结构体局部同表，权威表自此完整覆盖本函数全部局部）
    登记当前函数变量类型(整64(n.文本), 整64(类型节点.文本));
    如果 (!预扫已分配) {
        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽));
    }
}

// 200-a：族② 标量声明初值生成（初值表达式 + 字符串拥有化〔白名单八函数∪返回类型契约〕+
//   正32 截断/浮点宽化 + 存储；无初值声明零发射直达族③）。
不安全 函数 生成标量声明初值(向量<节点> 池, 节点 n, 节点 类型节点, 字符串 类型文本, 整64 槽,
                   布尔 预扫已分配, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                   函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                   向量<整64>& 表达式栈) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
    如果 (n.子起点 < n.子终点) {
        整64 值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                     指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
        如果 (值寄存器 != 0) {            // plans/019 阶段4' 第二批：拥有型字符串初始化拥有化（宿主第一批
            //   同构，Rust "x".to_string() 同款）——名单内且未污染时：字面量
            //   （只读驻留指针）/标识符拷贝（浅共享指针）经 __cn_str_copy 落堆
            //   （变量一律拥有堆串，返回块/块出口释放安全）；白名单八函数调用
            //   返回恒堆直存（预扫已判定）；其余形态（非白名单调用/下标/成员
            //   等——嵌套块同名借用声明的值覆盖场景）污染退出 RAII（旧拥有值
            //   泄漏不崩——保守安全，宿主 stringTainted_ 同构）。
            如果 (整64(类型节点.文本) == 驻留("字符串") && 预扫已分配) {
                结果<整64, 整32> 查污初 = 函数信息.字符串污染们.获取(整64(n.文本));
                如果 (!查污初.正常) {
                    节点 初末o = 池.元素(n.子终点 - 1);
                    如果 (初末o.类型 == 节点_字符串字面量 ||
                         初末o.类型 == 节点_标识符) {
                        整64 copy寄存器 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_调用实参, 值寄存器, 0, 0, 0, 0, 0));
                        IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, copy寄存器, 0,
                                             驻留("__cn_str_copy")));
                        登记寄存器类型(copy寄存器, T_字符串);
                        值寄存器 = copy寄存器;
                    } 否则 如果 (初末o.类型 != 节点_调用) {
                        // 非调用非字面量非标识符（下标/成员/解引用/二元等）：
                        //   借用形态——污染退出（白名单调用不经此分支）
                        登记串污染(函数信息, 整64(n.文本));   // 75-a：唯一入口
                    } 否则 {
                        // 调用形态：白名单八函数（预扫已登记）=拥有直存；其余
                        //   =借用——污染退出（嵌套同名防御）
                        节点 被调o = 池.元素(整32(初末o.子起点));
                        布尔 白o = 假;
                        如果 (被调o.类型 == 节点_标识符) {
                            整64 被调名o = 整64(被调o.文本);
                            白o = 被调名o == 驻留("字符串复制") ||
                                 被调名o == 驻留("字符串连接") ||
                                 被调名o == 驻留("字符串拼接") ||
                                 被调名o == 驻留("字符串子串") ||
                                 被调名o == 驻留("字符串大写") ||
                                 被调名o == 驻留("字符串小写") ||
                                 被调名o == 驻留("字符串修剪") ||
                                 被调名o == 驻留("字符串反转");
                            // A2（方案甲）：返回类型契约——被调者返回 字符串
                            //   即拥有（白名单∪返回类型，驻留文本=字符* 不入）。
                            // 72-a（2026-09-11 第七十二轮）：查函数返回回退
                            //   （键基回退版）——纯名查跨模块 miss，导入模块函数
                            //   返回字符串的契约会整体失效（宿主同族根治）。
                            如果 (!白o && 查函数返回回退(被调名o) == 驻留("字符串")) {
                                白o = 真;
                            }
                        }
                        如果 (!白o) {
                            登记串污染(函数信息, 整64(n.文本));   // 75-a：唯一入口
                        }
                    }
                }
            }
            值寄存器 = 正32存储截断(类型文本, 值寄存器, 指令, 寄存器计数);
            值寄存器 = 浮点宽化存储(类型文本, 值寄存器, 指令, 寄存器计数);
            IR追加(指令, 建IR指令(IR_存储, 值寄存器, 0, 0, 0, 0, 槽));
        }
    }
}

// 200-a：族③ 拥有型字符串 RAII 名单生成期登记（73-a 块级 RAII 生效要件；污染名不登记）。
不安全 函数 登记声明字符串RAII(节点 n, 节点 类型节点, 布尔 预扫已分配, 函数IR& 函数信息) -> 空类型 {
    // 73-a（2026-09-11 方案A 用户裁决）：拥有型字符串 RAII 名单**生成期登记**
    //   ——原实现由预扫登记，但预扫先于函数体生成（函数级一次性扫描），登记
    //   发生在 生成块 取基线之前，基线恒等于名单大小=块出口析构永远无新增项，
    //   v2 块级 RAII 从未生效（探针 89：20 万轮循环体拥有串残留 199999）。
    //   登记条件与预扫判定同源（预扫 已分配槽 ⇔ 拥有初值判定通过），污染名
    //   不登记（借用形态：下标/成员/非白名单调用——其释放由源持有）；无初值
    //   声明同样登记（槽零初始化，后续 生成赋值语句 拥有化赋值维护拥有链）。
    //   登记时机=值已入槽之后（释放指令届时读槽有效）；块出口基线机制自此
    //   与宿主同构（Rust 作用域 drop 按声明顺序逆序 drop）。
    如果 (预扫已分配 && 整64(类型节点.文本) == 驻留("字符串")) {
        结果<整64, 整32> 查污登 = 函数信息.字符串污染们.获取(整64(n.文本));
        如果 (!查污登.正常) {
            名单追加去重(函数信息.字符串变量们, 整64(n.文本));
        }
    }
}


// 正32 存储截断（46-f 第五十轮 wrapping 语义，单一事实源——生成变量声明/
//   生成赋值语句 两存储点共用）：目标类型文本=正32 时存储前 IR_位与
//   0xFFFFFFFF（mod 2^32，对齐宿主 u32 4 字节槽截断）；其余类型零开销直通。
//   截断寄存器登记 T_正32（后续消费符号性保持）。
不安全 函数 正32存储截断(字符串 目标类型文本, 整64 值寄存器, 向量<IR指令>& 指令,
                  整64* 寄存器计数) -> 整64 {
    如果 (!字符串比较(目标类型文本, "正32")) { 返回 值寄存器; }
    整64 掩码寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(4294967295)), 0, 0,
                          掩码寄存器, T_整64, 0));
    整64 截断寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_位与, 值寄存器, 掩码寄存器, 0, 截断寄存器, T_正32, 0));
    登记寄存器类型(截断寄存器, T_正32);
    返回 截断寄存器;
}

// 92-a（2026-09-13 第九十二轮）：浮点隐式宽化存储适配——目标声明类型为 浮64
//   而值寄存器为 浮32 时插入 IR_类型转换（cvtss2sd；IEEE754 单->双无损，
//   规范「仅允许无损或宽化」）。原缺：f32 位模式直进 8 字节槽，按 f64 读得
//   极小非规格化数（≈0）——`浮64 宽 = 浮32(1.5);` 读回 0 实证（宿主侧正确=
//   双侧分叉）。非浮64 目标/同码零开销直通（生成声明初始化 + 生成赋值语句
//   两存储点共用，与 正32存储截断 同款单一事实源）。
不安全 函数 浮点宽化存储(字符串 目标类型文本, 整64 值寄存器, 向量<IR指令>& 指令,
                  整64* 寄存器计数) -> 整64 {
    如果 (!字符串比较(目标类型文本, "浮64")) { 返回 值寄存器; }
    如果 (查寄存器类型(值寄存器) != T_浮32) { 返回 值寄存器; }
    返回 插入值转换(值寄存器, T_浮64, 指令, 寄存器计数);
}

// 引用局部（泛型引用绑定）：单槽存绑定对象左值地址——与引用参数槽完全同构
//   （读取分流/成员基址/赋值写回/再传引用实参数据流复用 全套机制）。
不安全 函数 生成引用局部(向量<节点> 池, 节点 n,
                  映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                  函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                  向量<整64>& 表达式栈) {
    // 引用局部（泛型引用绑定，2026-09-04 IR生成.cn 冒烟 96 错根治）：
    //   单槽存绑定对象左值地址——与引用参数槽完全同构（读取分流/成员
    //   基址/赋值写回/再传引用实参数据流复用 引用参数槽们/类型们 全套
    //   机制）。绑定=初始化区间按 生成左值地址（成员/标识符——不走
    //   生成表达式，避免成员取值）。不入 RAII 名单：引用不拥有对象
    //   （绑定字段归宿主结构体所有，出口析构=双重释放必错）。
    //   语义层已拒无初始化/非左值形态（防御双保险，此处再守一道）。
    向量<IR指令>& 指令 = 函数信息.指令;
    节点 类型节点 = 池.元素(整32(n.附加));
    字符串 类型文本 = 字符串复制(驻留文本(整64(池.元素(整32(n.附加)).文本)));
    如果 (n.子起点 >= n.子终点) {
        IR层诊断("引用声明必须初始化: " + 类型文本);
    }
    整64 槽y = 槽计数[0];
    槽计数[0] = 槽计数[0] + 1;
    结果<空类型, 整32> 设槽y = 局部槽.设置(整64(n.文本), 槽y);
    如果 (!设槽y.正常) { 运行时错误(4); }
    // 容器/结果类型入双表（方法调用对象类型解析——与容器参数同款）
    如果 (是容器类(类型文本) || 是结果类型(类型文本)) {
        结果<空类型, 整32> 设类y = 函数信息.变量类型.设置(整64(n.文本),
                                                整64(类型节点.文本));
        如果 (!设类y.正常) { 运行时错误(4); }
    }
    登记当前函数变量类型(整64(n.文本), 整64(类型节点.文本));
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽y));
    登记引用参数槽(槽y);
    登记引用参数类型(槽y, 整64(类型节点.文本));
    如果 (n.子起点 < n.子终点) {
        整64 绑定地址 = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                     指令, 寄存器计数, &函数信息.块计数,
                                     槽计数, 表达式栈);
        如果 (绑定地址 != 0) {
            IR追加(指令, 建IR指令(IR_存储, 绑定地址, 0, 0, 0, 0, 槽y));
        }
    }
}

// P7b 容器变量：槽已由预扫分配（入口零初始化）；此处 NewObject +
//   无参构造 + Store（H7 同款：无初始化器也默认构造）；
//   初值三形态（2026-09-04，IR生成.cn 冒烟 [ir2] 收口）：
//   ①构造调用（= 向量$T()）——NewObject+构造；
//   ②函数调用返回（= 取实例实参们(x)）——接收转移：不 NewObject，
//     被调方构造对象所有权移交本槽（RAII 出口析构恰一次）；
//   ③标识符拷贝（静态/局部源）——深拷贝构造（2026-09-06 宿主对齐，见 拷贝构造）。
不安全 函数 生成容器局部(向量<节点> 池, 节点 n, 节点 类型节点,
                       映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                       函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                       向量<整64>& 表达式栈) {
    向量<IR指令>& 指令 = 函数信息.指令;
    字符串 类型文本 = 字符串复制(驻留文本(整64(类型节点.文本)));
    布尔 是构造调用 = 假;
    布尔 是返回接收 = 假;
    布尔 是标识符拷贝 = 假;
    如果 (n.子起点 < n.子终点) {
        节点 首节点 = 池.元素(n.子起点);
        节点 末节点c = 池.元素(n.子终点 - 1);
        如果 (首节点.类型 == 节点_标识符 && 首节点.文本 == 类型节点.文本 &&
             末节点c.类型 == 节点_调用) {
            是构造调用 = 真;
        } 否则 如果 (末节点c.类型 == 节点_调用) {
            是返回接收 = 真;
        } 否则 如果 (末节点c.类型 == 节点_标识符) {
            是标识符拷贝 = 真;
        } 否则 {
            IR层诊断("容器初始化仅支持构造/调用返回/标识符拷贝: " +
                          类型文本);
        }
    }
    整64 槽c = 0;
    结果<整64, 整32> 找槽c = 局部槽.获取(整64(n.文本));
    如果 (找槽c.正常) { 槽c = 找槽c.值; }
    // 73-a（2026-09-11 方案A 用户裁决）：RAII 名单生成期登记——预扫不再登记
    //   （预扫先于函数体生成，登记会让块出口析构基线恒等=块级 RAII 失效）。
    //   返回接收形态（rax 直用=视图/转移，接收方不拥有）不登记（2026-09-06
    //   宿主对齐裁定，判定自预扫原样搬移至此）；其余形态登记（构造/标识符拷贝=
    //   本槽拥有对象，块出口析构）。登记在槽/对象建立之前——释放列表与生成
    //   顺序一致，块出口基线机制据此成立。
    如果 (!是返回接收) {
        名单追加去重(函数信息.容器变量们, 整64(n.文本));
    }
    如果 (是返回接收) {
        // 接收转移：调用返回（rax=对象指针）直接入槽
        整64 返回值reg = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                     指令, 寄存器计数, &函数信息.块计数,
                                     槽计数, 表达式栈);
        如果 (返回值reg != 0 && 槽c != 0) {
            IR追加(指令, 建IR指令(IR_存储, 返回值reg, 0, 0, 0, 0, 槽c));
        }
        当 (表达式栈.大小() > 0) {
            结果<空类型, 整32> 删栈c = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈c.正常) { 运行时错误(4); }
        }
        返回;
    }
    如果 (是标识符拷贝) {
        生成容器拷贝构造(池, n, 类型节点, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 槽c);
        返回;
    }
    整64 obj寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, obj寄存器,
                         容器对象大小(类型文本), 整64(类型节点.文本)));
    // 参数区模式（项3）：this 经 IR_调用实参(64) 声明装载，63 只存总位数
    IR追加(指令, 建IR指令(IR_调用实参, obj寄存器, 0, 0, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                         驻留(构造符号(类型文本))));
    如果 (槽c != 0) {
        IR追加(指令, 建IR指令(IR_存储, obj寄存器, 0, 0, 0, 0, 槽c));
    }
}

// 容器标识符拷贝（2026-09-06 根治·宿主对齐·深拷贝构造）：宿主实证（alias 探针
//   asm）`映射 B = A` 发射 NewObject+拷贝构造（符号 类$基名#类型，独立对象出口
//   析构）；原浅共享 IR_存储 与宿主分叉——源局部+接收双析构=double free、写穿
//   共享与宿主深拷贝语义矛盾。源指针装载：局部/参数槽 IR_加载、静态 IR_静态加载。
不安全 函数 生成容器拷贝构造(向量<节点> 池, 节点 n, 节点 类型节点,
                       映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                       函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                       向量<整64>& 表达式栈, 整64 槽c) {
    向量<IR指令>& 指令 = 函数信息.指令;
    字符串 类型文本 = 字符串复制(驻留文本(整64(类型节点.文本)));
    // 2026-09-06 根治（宿主对齐·深拷贝构造）：宿主实证（alias 探针
    //   asm）`映射 B = A` 发射 NewObject+拷贝构造（符号 类$基名#类型，
    //   独立对象出口析构）；原浅共享 IR_存储 与宿主分叉——源局部+
    //   接收双析构=double free、写穿共享与宿主深拷贝语义矛盾。
    //   源指针装载：局部/参数槽 IR_加载、静态 IR_静态加载。
    节点 源节点 = 池.元素(n.子终点 - 1);
    整64 源槽c = 0;
    结果<整64, 整32> 找源局 = 局部槽.获取(整64(源节点.文本));
    如果 (找源局.正常) { 源槽c = 找源局.值; }
    如果 (源槽c == 0) {
        结果<整64, 整32> 找源参 = 参数槽.获取(整64(源节点.文本));
        如果 (找源参.正常) { 源槽c = 找源参.值; }
    }
    整64 源指针reg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    布尔 源已解析 = 真;
    如果 (源槽c != 0) {
        // 拷贝构造源=T&（引用位传左值地址——宿主 ABI 实证：被调方
        //   (%rsi) 解引用取对象指针）；槽是引用（绑定对象）则槽内容
        //   即左值地址直接加载（回扫实参取地址 引用分支同款）
        如果 (槽是引用(源槽c)) {
            IR追加(指令, 建IR指令(IR_加载, 源槽c, 0, 0, 源指针reg, T_对象, 0));
        } 否则 {
            IR追加(指令, 建IR指令(IR_取地址, 源槽c, 0, 0, 源指针reg, T_整64, 0));
        }
    } 否则 {
        整64 找源静 = 查静态序号(整64(源节点.文本));
        如果 (找源静 >= 0) {
            // 静态容器源（取走惯用法：向量 模块列表 = 导入模块们）：
            //   拷贝构造 T& 传静态槽左值地址（lea .data 槽）
            IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 源指针reg,
                                 T_对象, 找源静));
        } 否则 {
            源已解析 = 假;
            IR层诊断("容器拷贝源未解析: " +
                          驻留文本(整64(源节点.文本)));
        }
    }
    如果 (源已解析) {
        整64 拷贝objreg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 拷贝objreg,
                             容器对象大小(类型文本),
                             整64(类型节点.文本)));
        // this=位0、源=位1（拷贝构造 T& 按引用位传对象指针）
        IR追加(指令, 建IR指令(IR_调用实参, 拷贝objreg, 0, 0, 0, 0, 0));
        IR追加(指令, 建IR指令(IR_调用实参, 源指针reg, 0, 0, 0, 1, 0));
        // 拷贝构造签名=构造(T&)——参数串带 &（asm 符号 _A+类型编码，
        //   alias.o 宿主实例 _...映射_A_T... 实证对齐）
        IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                             驻留(方法符号(类型文本,
                                    合成名基名(类型文本),
                                    类型文本 + "&"))));
        如果 (槽c != 0) {
            IR追加(指令, 建IR指令(IR_存储, 拷贝objreg, 0, 0, 0, 0, 槽c));
        }
    }
}

// P7b 结果/可选 变量：2 槽内联布局（12/16 字节）+ 变量类型登记；
//   初值 = 容器方法调用（retbuf 地址）-> IR_结构体拷贝 到本变量槽
不安全 函数 生成结果局部(向量<节点> 池, 节点 n, 节点 类型节点,
                       映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                       函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                       向量<整64>& 表达式栈) {
    向量<IR指令>& 指令 = 函数信息.指令;
    字符串 类型文本 = 字符串复制(驻留文本(整64(类型节点.文本)));
    // 多槽变量数据基址=低地址槽（高槽号）：槽号越大地址越低（8*(R+s)+8），
    //   结果字节从基址向上写——若取低槽号（高地址），写入越界覆盖
    //   槽号更小的相邻变量（表对象指针被污染 -> SIGSEGV，实测踩坑）。
    //   2026-09-06 根治（freg 探针/v2self 表注册 崩溃）：T=结构体时
    //   结果>16 字节（结果<符号>=24/40）——原硬编码 2 槽+基槽 槽r+1，
    //   24 字节拷贝自基槽向上覆盖相邻变量槽（顶层容器槽被清零 ->
    //   后续方法调用 this=null 判空 fail）。按 结果槽位数 逐槽分配，
    //   基槽=最大槽号（低地址）。
    整64 槽r = 槽计数[0];
    整64 结果槽数 = 结果槽位数(类型文本);
    槽计数[0] = 槽计数[0] + 结果槽数;
    结果<空类型, 整32> 设r = 局部槽.设置(整64(n.文本), 槽r + 结果槽数 - 1);
    如果 (!设r.正常) { 运行时错误(4); }
    结果<空类型, 整32> 设类r = 函数信息.变量类型.设置(整64(n.文本), 整64(类型节点.文本));
    如果 (!设类r.正常) { 运行时错误(4); }
    登记当前函数变量类型(整64(n.文本), 整64(类型节点.文本));
    整64 槽i = 0;
    当 (槽i < 结果槽数) {
        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽r + 槽i));
        槽i++;
    }
    如果 (n.子起点 < n.子终点) {
        // 限定名内置直调初值（2026-09-06 根治，T6 自举首踩）：文件::/IO::
        //   限定名内置返回裸指针（char*/FILE*，null=EOF/失败）——旧实现
        //   把返回寄存器当「16 字节结果结构体地址」IR_结构体拷贝（读字符串
        //   内容当结构体，v2 编译 v2 自身 读源文件 段错误实证）。改合成构造：
        //   判空 -> 正常@0、指针 -> 值@8（对齐 结果 ABI 防御布局）
        布尔 限定内置 = 假;
        节点 首节点 = 池.元素(整32(n.子起点));
        // 池顺序：调用表达式的被调标识符先入池（P6f 调用节点.子起点=被调
        //   索引的镜像约定）——变量声明.子起点 即被调标识符（限定名内置
        //   形态=「标识符(」无成员/后缀前缀）
        如果 (首节点.类型 == 节点_标识符) {
            字符串 被调名v = 字符串复制(驻留文本(整64(首节点.文本)));
            // 限定名判定（含 ':'，IO::/文件::）——字节位置 在 代码生成共用.cn
            //   （IR生成 不导入=依赖环），此处内联首冒号扫描
            布尔 含冒号 = 假;
            整64 ci = 0;
            当 (ci < 字符串长度(被调名v)) {
                整64 cb = 整64(被调名v[ci]) & 255;
                如果 (cb == 58) { 含冒号 = 真; 中断; }
                ci++;
            }
            如果 (字符串长度(内置函数符号(被调名v)) != 0 && 含冒号) {
                限定内置 = 真;
            }
        }
        如果 (限定内置) {
            整64 指针reg = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                       指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
            如果 (指针reg != 0) {
                // 零初始化两槽（值@8=槽r、正常@0=槽r+1——基址槽=大槽号低地址）
                整64 零reg = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("0")), 0, 0, 零reg, T_整64, 0));
                IR追加(指令, 建IR指令(IR_存储, 零reg, 0, 0, 0, 0, 槽r));
                IR追加(指令, 建IR指令(IR_存储, 零reg, 0, 0, 0, 0, 槽r + 结果槽数 - 1));
                // 值槽 = 裸指针
                IR追加(指令, 建IR指令(IR_存储, 指针reg, 0, 0, 0, 0, 槽r));
                // 正常槽 = 指针 != 0
                整64 正常reg = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_不等, 指针reg, 零reg, 0, 正常reg, T_布尔, 0));
                IR追加(指令, 建IR指令(IR_存储, 正常reg, 0, 0, 0, 0, 槽r + 结果槽数 - 1));
            }
        } 否则 如果 (池.元素(n.子终点 - 1).类型 == 节点_整数字面量) {
            // 107-a（H6 同族）：可选局部 = 无（语法层把「无」解析为 节点_整数字面量
            //   值 0）零初始化全部结果槽（原走下方「生成表达式」路径把 0 当结构体
            //   地址 -> 自 NULL 读；语义层同步放行可选「无」，两侧与宿主同构）
            整64 零regv = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("0")), 0, 0,
                                 零regv, T_整64, 0));
            整64 zv = 0;
            当 (zv < 结果槽数) {
                IR追加(指令, 建IR指令(IR_存储, 零regv, 0, 0, 0, 0, 槽r + zv));
                zv++;
            }
        } 否则 {
            整64 源地址 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                     指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
            如果 (源地址 != 0) {
                整64 目标地址 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_取地址, 槽r + 结果槽数 - 1, 0, 0, 目标地址, T_整64, 0));
                IR追加(指令, 建IR指令(IR_结构体拷贝, 源地址, 目标地址, 0, 0,
                                     结果大小(类型文本), 0));
            }
        }
        当 (表达式栈.大小() > 0) {
            结果<空类型, 整32> 删栈r = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈r.正常) { 运行时错误(4); }
        }
    }
    // 79-a（2026-09-12 第七十九轮）：结果/可选 值字段为字符串 -> 资源字段释放
    //   名单（块出口/跳出/函数尾条件释放值字段）。结果/可选 局部为「调用返回
    //   接收」——宿主 70-a 装箱 move 语义：值所有权随装箱转入本变量（源槽清零/
    //   被调方返回移出），本变量登记释放即唯一持有者（零泄漏零悬垂）。
    如果 (字符串比较(段首(合成名首实参(类型文本)), "字符串")) {
        结果<空类型, 整32> 加局r = 函数信息.资源字段局部们.追加(整64(n.文本));
        如果 (!加局r.正常) { 运行时错误(4); }
        结果<空类型, 整32> 加构r = 函数信息.资源字段结构体们.追加(整64(类型节点.文本));
        如果 (!加构r.正常) { 运行时错误(4); }
    }
}

// ②b B1（2026-09-02）：结构体局部变量——多槽布局（槽数=ceil(大小/8)，
//   基址槽=最大槽号=最低地址，多槽向上写不越界）+ 零初始化（安全：
//   字符串字段垃圾指针析构即崩——对齐宿主类局部入口零初始化防御）。
//   整体初始化（= 表达式）暂不支持（诊断）；字段赋值走成员路径。
不安全 函数 生成结构体局部(向量<节点> 池, 节点 n, 节点 类型节点,
                       映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                       函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                       向量<整64>& 表达式栈) {
    向量<IR指令>& 指令 = 函数信息.指令;
    整64 结构大小 = 查结构体大小(整64(类型节点.文本));
    整64 槽数 = (结构大小 + 7) / 8;
    整64 槽起 = 槽计数[0];
    槽计数[0] = 槽计数[0] + 槽数;
    结果<空类型, 整32> 设槽s = 局部槽.设置(整64(n.文本), 槽起 + 槽数 - 1);
    如果 (!设槽s.正常) { 运行时错误(4); }
    // ②c D：结构体局部入函数级变量类型权威表（成员偏移/宽度/方法对象解析）
    登记当前函数变量类型(整64(n.文本), 整64(类型节点.文本));
    整64 z = 0;
    当 (z < 槽数) {
        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽起 + z));
        z++;
    }
    // 零初始化：常量 0 -> 各槽
    整64 零寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("0")), 0, 0, 零寄存器, T_整64, 0));
    z = 0;
    当 (z < 槽数) {
        IR追加(指令, 建IR指令(IR_存储, 零寄存器, 0, 0, 0, 0, 槽起 + z));
        z++;
    }
    // ②c B：含容器字段的结构体局部——登记 RAII 跟踪（块出口/返回按字段
    //   逆序级联析构：字段地址->指针加载->DeleteObject，空安全）
    //   第 15 枚豁免（2026-09-06，v2self 第 8 层）：初值末节点=调用
    //   （非构造——结构体无构造调用）-> 不登记——sret 浅拷贝自调用方
    //   容器元素（收集字符串常量 实证：函数IR 扫函数 = 程序.函数们.
    //   元素(f) 出口级联析构=free 调用方 程序.函数们[f].指令 数据 ->
    //   后续迭代读/再析构已释放内存 -> invalid free SIGABRT）；宿主
    //   语义=调用返回接收不析构（泄漏对齐现状），与第 9 枚「容器变量
    //   调用返回初值不入 RAII」同款豁免。
    布尔 结构体返回接收 = 假;
    如果 (n.子起点 < n.子终点) {
        节点 首节点s = 池.元素(n.子起点);
        节点 末节点s = 池.元素(n.子终点 - 1);
        如果 (末节点s.类型 == 节点_调用 &&
            !(首节点s.类型 == 节点_标识符 && 首节点s.文本 == 类型节点.文本)) {
            结构体返回接收 = 真;
        }
    }
    // 79-a：登记拆分为两类判定——①容器字段（资源字段数 - 串字段数）：返回
    //   接收（sret 浅拷共享对象指针）豁免登记（既有防双释放语义）；②字符串
    //   字段：返回接收=被调方返回移出 + 调用方接管唯一持有者，登记安全
    //   （与宿主 79-a 对齐）。
    如果 ((资源字段数(整64(类型节点.文本)) - 串字段数(整64(类型节点.文本)) > 0 &&
          !结构体返回接收) ||
        串字段数(整64(类型节点.文本)) > 0) {
        结果<空类型, 整32> 加字段局部 = 函数信息.资源字段局部们.追加(整64(n.文本));
        如果 (!加字段局部.正常) { 运行时错误(4); }
        结果<空类型, 整32> 加字段结构体 = 函数信息.资源字段结构体们.追加(整64(类型节点.文本));
        如果 (!加字段结构体.正常) { 运行时错误(4); }
    }
    如果 (n.子起点 < n.子终点) {
        // 结构体初始化三形态（2026-09-04 E2E 148 两形态 + 呈报①A 冒烟
        //   暴露第三形态 2026-09-05——v2 自举刚需）：
        //   ①调用返回（IR指令 项 = 建IR指令(...)）：rax=结构体地址
        //     （被调 retbuf）-> IR_结构体拷贝 入本变量基槽；
        //   ②标识符拷贝（节点 参数类型节点 = 参数——生成函数 参数循环
        //     实测形态）：源=标识符左值地址（局部/参数基槽）-> 拷贝；
        //   ③成员字段（符号 找到 = 查.值——结果<T>.值 整体接收，语义分析.cn
        //     冒烟踩出）：生成表达式 成员分支压字段地址（结果值字段=结构体
        //     值语义不 LoadPtr）-> 拷贝。字面量等其他形态保持诊断（诚实边界）。
        节点 初始化末s = 池.元素(n.子终点 - 1);
        如果 (初始化末s.类型 == 节点_调用 || 初始化末s.类型 == 节点_标识符 ||
             初始化末s.类型 == 节点_成员 || 初始化末s.类型 == 节点_三元运算) {
            整64 源地址 = 0;
            如果 (初始化末s.类型 == 节点_调用 || 初始化末s.类型 == 节点_成员 ||
                初始化末s.类型 == 节点_三元运算) {
                // 86-a（2026-09-12 复审缺陷①）第四形态：三元聚合初值——生成
                //   表达式 经 生成三元运算（86-a 聚合分支地址化）得出**选中
                //   place 地址**（地址透传，与成员第三形态同款消费）。
                //   原无此形态 → 「结构体整体初始化暂不支持」IR 层拒绝
                //   （P46 v2 实证）。源非调用 → 深拷（两个候选 place 均为
                //   局部拥有，接收方独立副本，候选源保持拥有）。
                源地址 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                     指令, 寄存器计数, &函数信息.块计数,
                                     槽计数, 表达式栈);
            } 否则 {
                源地址 = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                       指令, 寄存器计数, &函数信息.块计数,
                                       槽计数, 表达式栈);
            }
            如果 (源地址 != 0) {
                整64 目标地址 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_取地址, 槽起 + 槽数 - 1, 0, 0,
                                     目标地址, T_整64, 0));
                // 79-a：含串字段结构体的局部初始化——源为标识符/成员（值语义
                //   拷贝）=深拷（源保持拥有，目标独立副本）；源为调用返回
                //   （retbuf，被调方返回移出已跳过释放）=浅拷接管（零拷贝，句柄
                //   唯一持有者转为目标——深拷会造成副本泄漏）。目标刚声明零初始化。
                布尔 源是调用 = 初始化末s.类型 == 节点_调用;
                发射结构体整体拷贝(函数信息, 寄存器计数, 目标地址, 源地址,
                                 整64(类型节点.文本), !源是调用, 假);
            }
            当 (表达式栈.大小() > 0) {
                结果<空类型, 整32> 删栈s = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删栈s.正常) { 运行时错误(4); }
            }
        } 否则 {
            IR层诊断("结构体整体初始化暂不支持（字段赋值可用）");
        }
    }
}

// 94-a（2026-09-13 第九十四轮）：数组局部变量——C 布局多槽（槽数=ceil(元素大小×
//   长度/8)，基址槽=最大槽号=最低地址，逐槽 IR_分配）+ 零初始化 + 可选初始化列表
//   （逐元素 store 到 基址+序号×元素步进；余下元素保零=宿主「部分初始化补零」同构）。
//   对齐宿主：ir.cpp registerVarSlots 数组分支（槽数按 C 总大小 ceil(元素大小×长度/8)）
//   + 数组名退化（标识符值=元素指针=基址地址，见 生成表达式.生成标识符加载）。
//   槽分配纪律（82-a 四条）：基址槽=槽起+槽数-1（低地址）/逐槽分配/零初始化先行/
//   临时寄存器只递增不复用。
不安全 函数 生成数组局部(向量<节点> 池, 节点 n, 节点 类型节点,
                       映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                       函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                       向量<整64>& 表达式栈) {
    向量<IR指令>& 指令 = 函数信息.指令;
    字符串 类型文本 = 字符串复制(驻留文本(整64(类型节点.文本)));
    整64 元素步进A = 数组元素步进(类型文本);
    整64 长度A = 数组长度文本(类型文本);
    如果 (元素步进A <= 0 || 长度A <= 0) {
        IR层诊断("数组类型元素/长度未知: " + 类型文本);
        返回;
    }
    整64 槽数A = (元素步进A * 长度A + 7) / 8;
    整64 槽起A = 槽计数[0];
    槽计数[0] = 槽计数[0] + 槽数A;
    结果<空类型, 整32> 设槽A = 局部槽.设置(整64(n.文本), 槽起A + 槽数A - 1);
    如果 (!设槽A.正常) { 运行时错误(4); }
    登记当前函数变量类型(整64(n.文本), 整64(类型节点.文本));
    // 94-a：数组名退化为元素指针——登记**指针变量表**（名 -> 元素类型ID）：
    //   下标读（生成下标访问）/下标左值写（生成下标左值地址）全链复用既有指针
    //   路径（步进=元素宽度/加载宽度=元素宽度码/结果类型=元素类型码）——零新增
    //   下标分支（宿主「数组名引用为元素指针」语义同构）。元素=结构体/字符串
    //   同样成立（宽度经 类型名宽度/查结构体大小 单点）。
    登记指针变量类型(整64(n.文本), 驻留(数组元素文本(类型文本)));
    // 98-a（C9）：字符串元素数组登记（块出口/跳出/函数尾逐元素 __cn_str_free；
    //   元素槽释放+清零=幂等模型。宿主同款靶子面「数组元素残留 2」双侧收口）
    如果 (字符串比较(数组元素文本(类型文本), "字符串")) {
        名单追加去重(函数信息.字符串数组变量们, 整64(n.文本));
    }
    整64 zA = 0;
    当 (zA < 槽数A) {
        IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽起A + zA));
        zA++;
    }
    整64 零寄存器A = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("0")), 0, 0, 零寄存器A, T_整64, 0));
    zA = 0;
    当 (zA < 槽数A) {
        IR追加(指令, 建IR指令(IR_存储, 零寄存器A, 0, 0, 0, 0, 槽起A + zA));
        zA++;
    }
    如果 (n.子起点 >= n.子终点) { 返回; }
    节点 初末A = 池.元素(n.子终点 - 1);
    如果 (初末A.类型 != 节点_数组初始化) { 返回; }
    整64 基址寄存器A = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_取地址, 槽起A + 槽数A - 1, 0, 0, 基址寄存器A,
                          T_整64, 0));
    整64 元素序A = 0;
    整64 iA = 整64(初末A.子起点);
    当 (iA < 整64(初末A.子终点)) {
        节点 包装A = 池.元素(整32(iA));
        如果 (包装A.类型 == 节点_数组元素) {
            如果 (元素序A >= 长度A) {
                IR层诊断("数组初始化元素数超出长度: " + 类型文本);
                返回;
            }
            整64 元素前深度A = 表达式栈.大小();
            整64 元素寄存器A = 生成表达式(池, 整32(包装A.子起点),
                                           整32(包装A.子终点), 局部槽, 参数槽,
                                           指令, 寄存器计数, &函数信息.块计数,
                                           槽计数, 表达式栈);
            表达式栈弹到深度(表达式栈, 元素前深度A);
            如果 (元素寄存器A != 0) {
                整64 元素地址A = 基址寄存器A;
                如果 (元素序A > 0) {
                    整64 偏移常量A = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_常量整数,
                                          整64(驻留(整数转字符串(元素序A * 元素步进A))),
                                          0, 0, 偏移常量A, T_整64, 0));
                    整64 元素地址新A = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_加, 基址寄存器A, 偏移常量A, 0,
                                          元素地址新A, T_整64, 0));
                    元素地址A = 元素地址新A;
                }
                IR追加(指令, 建IR指令(IR_指针存储, 元素地址A, 元素寄存器A, 0, 0,
                                      类型宽度码(数组元素文本(类型文本)), 0));
            }
            元素序A++;
        }
        iA++;
    }
}
