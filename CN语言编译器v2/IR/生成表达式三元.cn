// CN 自举编译器 v2 · 生成表达式——三元族（#2025 用户令「先拆再加」：混合来源
//   三元拥有标志条件释放收口，生成表达式运算.cn/生成表达式运算辅助.cn 触 1000
//   冻结线，按族拆出本文件——纯搬移零语义变更 + #2025 新增标志槽设施）。
// 职责：①串临时拥有性判定（唯一单点·位置敏感：字符串拥有/字符串&·字符串@·
//   字符*借用/字段变量字面量借用）；②三元「恒拥有」静态判定（零拷贝快径）；
//   ③三元拥有标志槽登记/分支旗值/条件释放（消费位单点）；④生成三元运算
//   （汇合槽 + 拥有标志槽 + 汇合类型显式查表·禁 T_整64 默认）。
// 依赖序：本文件居 生成表达式运算辅助 后、生成表达式连接 前加载（消费方在其后）。
导入 容器::向量;
导入 IR;
导入 协议常量;

导入 IR生成;
导入 生成表达式求值;

公开:

// ==================== 617/#2025（2026-10-14 伞批·本轮判据收口）：拥有串临时判定 ====================

// 串临时拥有性判定（**判据唯一单点**·位置敏感——禁用散写形态表）：
//   任务 #2025 用户硬规则：拥有/借用判定按**位置**分——
//   · `字符串` 返回位/拼接产物/拥有返回调用产物 = 拥有（本帧可释放的独立堆串）；
//   · `字符串&`=可写借用、`字符串@`=只读借用（#2043 立法·@ 尚未实现，仅注释面）
//     → 零释放（借用句柄归来源）；
//   · `字符*`=C 指针（驻留文本/FFI 视图）→ 不参与拥有性判定（恒借用）；
//   · 字段/变量/字面量/下标/解引用 = 借用视图 → 零释放。
// 形态分派（全部收敛于本函数）：
//   二元 `+`=拼接产物（__cn_str_concat 新堆串）→ 拥有；
//   调用=**返回类型恰为「字符串」**才拥有（内置返回类型表/用户函数返回登记链/
//     方法 A2 契约/闭包体返回形态/方法值变量 A2 契约【#1922 件2·融合补】；
//     引用返回/容器借出/字符* 经类型闸与形态闸双重排除）；
//   三元=任一分支潜在拥有（真/假分支根=子区间末端-1，递归）；
//   其余形态（字面量/标识符/成员/下标/解引用）=借用。
// 池索引越界/三元区间非法=编译器内部结构异常——[内部错误] 当场中止（禁静默）。
函数 串临时拥有性判定(向量<节点> 池, 整32 根索引) -> 布尔 {
    如果 (根索引 <= 0 || 根索引 >= 整32(池.大小())) {
        IR层诊断("[内部错误] 串临时拥有性判定池索引越界: " +
                 整数转字符串(整64(根索引)));
        运行时错误(4);
    }
    节点 根节点 = 池.元素(根索引);
    // ① 借用视图形态（位置判据表的否定面）：变量/字面量/字段/下标/解引用——
    //   不论类型文本是否「字符串」，值都是他人拥有的句柄视图，零释放。
    如果 (根节点.类型 == 节点_字符串字面量 || 根节点.类型 == 节点_标识符 ||
        根节点.类型 == 节点_成员 || 根节点.类型 == 节点_下标 ||
        根节点.类型 == 节点_解引用) {
        返回 假;
    }
    如果 (根节点.类型 == 节点_二元运算) {
        返回 字符串比较(字符串复制(驻留文本(整64(根节点.文本))), "+");
    }
    // 662（617 三元面补全·宿主 argIsOwnedStringTemp 三元递归同构）：三元结果
    //   「潜在拥有」——任一分支命中即拥有；区间非法=内部结构异常（miss 不可静默）。
    如果 (根节点.类型 == 节点_三元运算) {
        布尔 区间有效 = 根节点.文本 > 0 && 根节点.附加 > 根节点.文本 &&
                           根节点.子终点 > 根节点.附加 &&
                           根节点.子终点 <= 整64(池.大小());
        如果 (!区间有效) {
            IR层诊断("[内部错误] 三元分支区间非法（池位=" +
                     整数转字符串(整64(根索引)) + "）");
            运行时错误(4);
        }
        如果 (串临时拥有性判定(池, 整32(根节点.附加 - 1))) { 返回 真; }
        返回 串临时拥有性判定(池, 整32(根节点.子终点 - 1));
    }
    // 静默豁免闭集穷举: 被调形态守卫（类型非调用/无被调子节点=非本判据面·
    //   形态谓词否定回答·非业务数值区间）
    如果 (根节点.类型 == 节点_调用 && 根节点.子起点 > 0) {
        // ② 类型层显式闸（位置敏感）：返回类型不是精确「字符串」（含
        //   字符串&/字符串@/字符*/非串）→ 借用视图，零释放。类型可解析时
        //   先行否定；不可解析=落下方形态判据（方法/闭包/自由函数各自闸门）。
        可选<整64> 返回类型查 = 解析调用返回类型ID(池, 根索引);
        如果 (返回类型查.有值) {
            字符串 返回类型文 = 字符串复制(驻留文本(返回类型查.值));
            // 静默豁免业务值: 返回类型非精确「字符串」（字符串&/字符串@/字符*/非串）
            //   =借用视图的谓词否定回答（判据输出布尔·非失败通道·#1360 谓词除外）
            如果 (!字符串比较(返回类型文, "字符串")) { 返回 假; }
        }
        节点 被调节点 = 池.元素(整32(根节点.子起点));
        // #1572：方法调用（被调=成员）返回拥有串——此前此处一律 返回 假，
        //   逐节拼接保守路径每段净泄 1（探针：2 段方法调用拼接 M 次残留 M），
        //   且融合路径 结算连接链段 共用本判据 → v2 融合链同样不结算（宿主
        //   融合路径 chainCallReturnsString 认 A2 契约=两侧结论不一致）。
        //   判据单点=方法调用串返回判定（用户类非泛型接收者·排除引用返回），
        //   与 644 方法面登记同一函数（所有权归属而非调用形态）。
        如果 (被调节点.类型 == 节点_成员) {
            返回 方法调用串返回判定(池, 被调节点);
        }
        如果 (被调节点.类型 != 节点_标识符) { 返回 假; }
        // #1578（宿主 callReturnsOwnedStringTemp 变量面同构）：**闭包变量被调**——
        //   lambda 体可合法返回借用句柄（形参透传/成员读；lambda 体返回位 A2 尚未
        //   执法），按返回类型释放=释放未被授予所有权的串（#1696 同族误释面，
        //   探针实测源串变空）。拥有性按**定义处登记的体返回形态**判定；捕获名
        //   返回已由返回位复制成拥有副本（1571）=拥有。闭包登记不可达=借用面
        //   （不释放未确权串·1479 同款方向：漏释放显形为泄漏可观测·误释放即错值）。
        如果 (是闭包变量(整64(被调节点.文本))) {
            返回 闭包变量返回串拥有判定(池, 整64(被调节点.文本), 4);
        }
        // #1922 件2：方法值变量调用（`打印(cb())`）返回串=A2 拥有契约临时——
        //   被调=变量名，内置表/函数返回类型表 双 miss，修前每参净泄 1
        //   （alloc8 探针双侧同步）。判定单点=是方法值变量拥有串返回
        //   （IR调用返回谓词·方法值类型文本内嵌返回段）。三元交叉形态
        //   （`条件 ? cb() : 已有串`）分支旗值与消费位条件释放共用本判定
        //   ——#2025 标志槽机制的分支拥有性判据即本单点（融合原则：三元
        //   分支根=方法值调用时按 A2 契约认拥有，与 644 实参面同判据）。
        如果 (是方法值变量拥有串返回(整64(被调节点.文本))) { 返回 真; }
        // 905（2026-10-18·与 644 段同判据·644-c 判定面同族根治）：内置返回
        //   字符串判定=权威表 内置函数返回类型ID（828-a 两级直查+归一基名）——
        //   原 14 项硬编码白名单漏 字符串构建器::完成/IO::读取行/文件::读取
        //   文件行/时间::格式化时间（905 探针形态G：打印行(字符串构建器::完成
        //   (乙)) v2 残留 1 vs 宿主 0）。宿主 argIsOwnedStringTemp retCanon 链同判。
        // 617 对齐补（接棒审查 2026-10-14）：用户函数返回字符串临时——内置
        //   面 miss 后查 函数返回类型们（按被调名查函数返回登记·沿基类链归一·
        //   IR生成中 收集先于全部生成），宿主 funcReturnTypeOf 同构（原 v2
        //   白名单缺用户函数面：打印(造串()) 形态 v2 残留 1/宿主 0=分叉）。
        //   引用返回（尾 & 原文≠"字符串"）与空类型/数值返回天然不命中。
        // 判定单点=被调返回串类型判定（#1572 提取：自由函数/内置面判据与
        //   返回表达式形态判定共用同一函数）。
        返回 被调返回串类型判定(整64(被调节点.文本));
    }
    返回 假;
}

// #2025：三元「恒拥有」静态判定——无论选中哪一分支，结果都必然是独立堆串
//   （拥有、可移交）。恒拥有=两分支皆恒拥有（嵌套三元递归）；任一侧为借用
//   视图即不恒拥有（消费位须走「复制 + 拥有标志条件释放」归一化）。
//   用途：赋值/声明/返回位的**零拷贝快径**——恒拥有直取句柄（move），
//   其余形态复制落堆后再按标志释放原拥有分支（借用分支零释放）。
//   区间非法=编译器内部结构异常——[内部错误] 当场中止（禁静默）。
函数 三元恒拥有(向量<节点> 池, 整32 三元索引) -> 布尔 {
    如果 (三元索引 <= 0 || 三元索引 >= 整32(池.大小())) {
        IR层诊断("[内部错误] 三元恒拥有池索引越界: " +
                 整数转字符串(整64(三元索引)));
        运行时错误(4);
    }
    节点 根恒 = 池.元素(三元索引);
    如果 (根恒.类型 != 节点_三元运算) {
        返回 串临时拥有性判定(池, 三元索引);
    }
    布尔 区间有效恒 = 根恒.文本 > 0 && 根恒.附加 > 根恒.文本 &&
                      根恒.子终点 > 根恒.附加 &&
                      根恒.子终点 <= 整64(池.大小());
    如果 (!区间有效恒) {
        IR层诊断("[内部错误] 三元恒拥有区间非法（池位=" +
                 整数转字符串(整64(三元索引)) + "）");
        运行时错误(4);
    }
    整32 真根位恒 = 整32(根恒.附加 - 1);
    整32 假根位恒 = 整32(根恒.子终点 - 1);
    节点 真根恒 = 池.元素(真根位恒);
    节点 假根恒 = 池.元素(假根位恒);
    布尔 真恒有 = 假;
    如果 (真根恒.类型 == 节点_三元运算) {
        真恒有 = 三元恒拥有(池, 真根位恒);
    }
    如果 (真根恒.类型 != 节点_三元运算) {
        真恒有 = 串临时拥有性判定(池, 真根位恒);
    }
    布尔 假恒有 = 假;
    如果 (假根恒.类型 == 节点_三元运算) {
        假恒有 = 三元恒拥有(池, 假根位恒);
    }
    如果 (假根恒.类型 != 节点_三元运算) {
        假恒有 = 串临时拥有性判定(池, 假根位恒);
    }
    返回 真恒有 && 假恒有;
}


// 662：三元实参寄存器登记（644 传参位扩展·#2025 起无条件登记）——三元实参
//   在 生成调用 644 段登记（寄存器+池位配对·宿主 pendingArgCleanups_ 三元项
//   同构），外层调用发射后 清理调用实参临时 按寄存器倒序查、按拥有标志条件
//   释放（借用分支零释放）。消费族结算命中同项时同步删除（释放权单点·防双释放）。
静态 向量<整64> 三元实参寄存器们;
静态 向量<整64> 三元实参池位们;

不安全 函数 三元实参登记(整64 寄存器c, 整64 池位c) -> 空类型 {
    结果<空类型, 整32> 加项 = 三元实参寄存器们.追加(寄存器c);
    如果 (!加项.正常) { 运行时错误(4); }
    加项 = 三元实参池位们.追加(池位c);
    如果 (!加项.正常) { 运行时错误(4); }
}

// 662：三元实参登记删除（寄存器键·倒序命中即删；消费族结算与 清理调用实参
//   临时 双侧命中面共用——释放权单点：命中者释放并删除，防双释放）。
不安全 函数 三元实参删除(整64 寄存器c) -> 布尔 {
    整64 删序号 = 三元实参寄存器们.大小();
    当 (删序号 > 0) {
        删序号--;
        如果 (三元实参寄存器们.元素(删序号) == 寄存器c) {
            结果<空类型, 整32> 删项 = 三元实参寄存器们.删除(删序号);
            如果 (!删项.正常) { 运行时错误(4); }
            删项 = 三元实参池位们.删除(删序号);
            如果 (!删项.正常) { 运行时错误(4); }
            返回 真;
        }
    }
    返回 假;
}

// 662：三元实参查发（寄存器键·倒序查）——命中返回池位（写引用输出）、未命中
//   池位=0。结算点分流判定用。
不安全 函数 三元实参查位(整64 寄存器c, 整64& 池位出) -> 布尔 {
    整64 查序号 = 三元实参寄存器们.大小();
    当 (查序号 > 0) {
        查序号--;
        如果 (三元实参寄存器们.元素(查序号) == 寄存器c) {
            池位出 = 三元实参池位们.元素(查序号);
            返回 真;
        }
    }
    返回 假;
}

// ==================== 617/#2025：三元临时「拥有标志」条件释放设施 ====================
// #2025（用户 2026-11-04 硬规则·混合来源收口）：三元两分支来源混合时
//   （一分支=拼接产物/拥有调用=拥有，另一分支=字段/变量/字面量=借用视图），
//   「按分支形态禁盲登记」=干脆不登记会让拥有分支的产物无人释放（每轮净泄 1）；
//   统一无条件登记又会误释放借用句柄。修法=**三元汇合时另存拥有标志槽**：
//   真分支执行时写 1（拥有）/0（借用），假分支同；消费位按标志位条件释放。
//   标志槽随三元一次性分配（槽计数），嵌套三元把内层标志槽值转入外层标志槽
//   ——消费点只需查一次外层标志，无需递归条件链。
//   标志=三元节点池位 → 本函数槽号（函数级生命周期·清空函数级槽表 复位）。
//   查表 miss=生成器内部缺陷（登记点漏位）——[内部错误] 当场中止（禁静默）。

静态 映射<整64, 整64> 三元拥有标志槽们;

// #2025：三元拥有标志登记（生成三元运算 汇合后调用·无条件登记——不再按
//   分支形态「禁盲登记」；两分支皆借用时标志恒 0，消费位条件释放为 no-op）。
不安全 函数 三元拥有标志登记(整64 池位c, 整64 标志槽c) -> 空类型 {
    结果<空类型, 整32> 设标 = 三元拥有标志槽们.设置(池位c, 标志槽c);
    如果 (!设标.正常) { 运行时错误(4); }
}

// #2025：三元分支拥有标志值寄存器——分支根为嵌套三元时转抄内层标志槽
//   （运行时值），否则按 串临时拥有性判定 编译期定常量 1/0。返回值=刚分配的
//   寄存器（标志位 整64 域），供调用方 IR_存储 到本三元标志槽。
不安全 函数 三元分支旗值(向量<节点> 池, 整32 分支根索引,
                    向量<IR指令>& 指令, 整64* 寄存器计数) -> 整64 {
    如果 (分支根索引 <= 0 || 分支根索引 >= 整32(池.大小())) {
        IR层诊断("[内部错误] 三元分支旗值池索引越界: " +
                 整数转字符串(整64(分支根索引)));
        运行时错误(4);
    }
    节点 分支根旗 = 池.元素(分支根索引);
    整64 旗寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    如果 (分支根旗.类型 == 节点_三元运算) {
        结果<整64, 整32> 内槽查 = 三元拥有标志槽们.获取(整64(分支根索引));
        整64 内槽号 = 0;
        如果 (内槽查.正常) {
            内槽号 = 内槽查.值;
        } 否则 {
            IR层诊断("[内部错误] 嵌套三元拥有标志槽未登记（池位=" +
                     整数转字符串(整64(分支根索引)) + "）");
            运行时错误(4);
        }
        IR追加(指令, 建IR指令(IR_加载, 内槽号, 0, 0, 旗寄存器, T_整64, 0));
    }
    如果 (分支根旗.类型 != 节点_三元运算) {
        // 标志按 串临时拥有性判定 单点（与消费位释放判据同源·零散写）
        整64 旗值 = 0;
        如果 (串临时拥有性判定(池, 分支根索引)) { 旗值 = 1; }
        IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(旗值)), 0, 0,
                             旗寄存器, T_整64, 0));
    }
    登记寄存器类型(旗寄存器, T_整64);
    返回 旗寄存器;
}

// #2025：条件释放（消费位单点）——非三元：判据命中即无条件释放；三元：
//   加载拥有标志槽，标志≠0 才释放（借用分支/字面量/变量句柄零释放）。
//   miss（标志槽未登记）=生成器内部缺陷——[内部错误] 当场中止（禁静默）。
不安全 函数 发射串临时条件释放(向量<节点> 池, 整64 池位c, 整64 值寄存器,
                    向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数) -> 空类型 {
    如果 (池位c <= 0 || 池位c >= 整64(池.大小())) {
        IR层诊断("[内部错误] 三元条件释放池位越界: " + 整数转字符串(池位c));
        运行时错误(4);
    }
    整32 根位 = 整32(池位c);
    节点 根节点释放 = 池.元素(根位);
    如果 (根节点释放.类型 != 节点_三元运算) {
        如果 (串临时拥有性判定(池, 根位)) {
            发射串临时释放(值寄存器, 指令, 寄存器计数);
        }
        返回;
    }
    结果<整64, 整32> 标志槽查 = 三元拥有标志槽们.获取(池位c);
    整64 标志槽号 = 0;
    如果 (标志槽查.正常) {
        标志槽号 = 标志槽查.值;
    } 否则 {
        IR层诊断("[内部错误] 三元拥有标志槽未登记（池位=" +
                 整数转字符串(池位c) + "）");
        运行时错误(4);
    }
    整64 标志寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 标志槽号, 0, 0, 标志寄存器,
                         T_整64, 0));
    登记寄存器类型(标志寄存器, T_整64);
    整64 释放块 = 块计数[0] + 1;
    整64 结束块 = 块计数[0] + 2;
    块计数[0] = 块计数[0] + 2;
    IR追加(指令, 建IR指令(IR_条件跳转, 标志寄存器, 释放块, 结束块,
                         0, 0, 0));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 释放块));
    发射串临时释放(值寄存器, 指令, 寄存器计数);
    IR追加(指令, 建IR指令(IR_跳转, 0, 0, 0, 0, 0, 结束块));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 结束块));
}


// 三元条件（③ 第六波，规范 01b 5.8）——惰性求值：条件跳转分派，仅选中分支
//   求值。复用短路方案：临时槽（IR_分配 帧登记）汇合两分支值，三块（真/假/汇合）。
//   栈平衡：各段递归后弹到进入前深度再压汇合结果（一元模式——净 +1，中间残留
//   全清，防「下标弹2取到残留」同族缺陷）。汇合类型=真分支寄存器登记类型
//   （语义层已保证两分支可合并；未登记=内部错误当场中止·禁 T_整64 默认）
//   86-a：聚合分支经 区间末为聚合左值 改走左值地址（地址透传，宿主同款）。
不安全 函数 生成三元运算(向量<节点> 池, 节点 n, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                 向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数,
                 向量<整64>& 表达式栈, 整64 三元池位c) -> 空类型 {
    整64 三元前深度 = 表达式栈.大小();
    整64 条件寄存器 = 生成表达式(池, n.子起点, n.文本, 局部槽, 参数槽,
                                指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    当 (表达式栈.大小() > 三元前深度) {
        结果<空类型, 整32> 删条 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删条.正常) { 运行时错误(4); }
    }
    整64 临时槽 = 槽计数[0];
    槽计数[0] = 槽计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 临时槽));
    // #2025（用户 2026-11-04 硬规则）：**拥有标志槽**——三元两分支来源混合
    //   （拼接产物=拥有 / 字段·变量·字面量=借用视图）时，分支敏感禁盲登记
    //   会让拥有分支产物无人释放（50 轮探针净泄 26）；无条件登记又误释放借用
    //   句柄。修法=汇合时另存标志：真分支执行写 1/0、假分支同；消费位按标志
    //   条件释放（发射串临时条件释放）。槽随三元一次性分配（函数帧内）。
    整64 标志槽 = 槽计数[0];
    槽计数[0] = 槽计数[0] + 1;
    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 标志槽));
    整64 真块 = 块计数[0] + 1;
    整64 假块 = 块计数[0] + 2;
    整64 汇合块 = 块计数[0] + 3;
    块计数[0] = 块计数[0] + 3;
    IR追加(指令, 建IR指令(IR_条件跳转, 条件寄存器, 真块, 假块, 0, 0, 0));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 真块));
    整64 真寄存器 = 0;
    布尔 真聚合左 = 区间末为聚合左值(池, 整32(n.文本), 整32(n.附加));
    如果 (真聚合左) {
        真寄存器 = 生成左值地址(池, 整32(n.文本), 整32(n.附加), 局部槽, 参数槽,
                                指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    }
    如果 (!真聚合左) {
        真寄存器 = 生成表达式(池, 整32(n.文本), 整32(n.附加), 局部槽, 参数槽,
                              指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    }
    当 (表达式栈.大小() > 三元前深度) {
        结果<空类型, 整32> 删真 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删真.正常) { 运行时错误(4); }
    }
    // 816（253 根治）：三元分支值位函数名收口——分支值=函数名（生成标识符加载
    //   对函数名产生负占位 0-名ID）时还原为函数地址 IR_函数地址（480 值位收口族：
    //   声明初始化/赋值右值/返回/实参位既有·三元真/假分支位原漏网）。负占位
    //   直入 IR_存储 被后端当寄存器号：win 992 守卫「非法寄存器槽号 -26」中止 /
    //   linux 正偏移 [rbp+N] 越界读垃圾→函数指针=垃圾→间接调用跳栈段错误
    //   （p1006_05 三元挑 fnptr 实证）。聚合左值路径返回值=地址寄存器恒非负=
    //   收口 no-op（聚合语义不受影响）。
    真寄存器 = 值位函数名收口(真寄存器, 指令, 寄存器计数);
    // #2025：真分支拥有标志写入（嵌套三元转抄内层标志；否则按判据常量 1/0）
    整64 真旗寄存器 = 三元分支旗值(池, 整32(n.附加 - 1), 指令, 寄存器计数);
    IR追加(指令, 建IR指令(IR_存储, 真旗寄存器, 0, 0, 0, 0, 标志槽));
    IR追加(指令, 建IR指令(IR_存储, 真寄存器, 0, 0, 0, 0, 临时槽));
    IR追加(指令, 建IR指令(IR_跳转, 0, 0, 0, 0, 0, 汇合块));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 假块));
    整64 假寄存器 = 0;
    布尔 假聚合左 = 区间末为聚合左值(池, 整32(n.附加), n.子终点);
    如果 (假聚合左) {
        假寄存器 = 生成左值地址(池, 整32(n.附加), n.子终点, 局部槽, 参数槽,
                                指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    }
    如果 (!假聚合左) {
        假寄存器 = 生成表达式(池, 整32(n.附加), n.子终点, 局部槽, 参数槽,
                              指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
    }
    当 (表达式栈.大小() > 三元前深度) {
        结果<空类型, 整32> 删假 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删假.正常) { 运行时错误(4); }
    }
    // 816（253 根治）：假分支值位收口（真分支同款注释见上方 真寄存器 处）
    假寄存器 = 值位函数名收口(假寄存器, 指令, 寄存器计数);
    // #2025：假分支拥有标志写入（与真分支同构）
    整64 假旗寄存器 = 三元分支旗值(池, 整32(n.子终点 - 1), 指令, 寄存器计数);
    IR追加(指令, 建IR指令(IR_存储, 假旗寄存器, 0, 0, 0, 0, 标志槽));
    IR追加(指令, 建IR指令(IR_存储, 假寄存器, 0, 0, 0, 0, 临时槽));
    IR追加(指令, 建IR指令(IR_跳转, 0, 0, 0, 0, 0, 汇合块));
    IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 汇合块));
    // #2025（用户 2026-11-04 硬规则·静默默认禁令）：汇合类型=真分支寄存器类型，
    //   查表 miss=生成器内部缺陷（分支求值必登记类型）——[内部错误] 当场中止，
    //   删除原「==0 → T_整64」静默默认（T_未知=0 与未登记同域不可分）。
    //   聚合三元例外（86-a/263①）：分支值=选中 place/物化槽**地址**，语义类型
    //   恒 T_对象（AST 聚合形态单点判定·非默认值）；标量面仍要求寄存器类型登记。
    布尔 真聚合调用d = 区间末为聚合调用返回(池, 整32(n.文本), 整32(n.附加));
    布尔 假聚合调用d = 区间末为聚合调用返回(池, 整32(n.附加), n.子终点);
    布尔 任聚合d = 整64(n.文本) < 整64(n.附加) &&
                  (区间末为聚合左值(池, 整32(n.文本), 整32(n.附加)) ||
                   区间末为聚合左值(池, 整32(n.附加), n.子终点) ||
                   真聚合调用d || 假聚合调用d);
    整64 汇合类型 = 0;
    如果 (任聚合d) {
        汇合类型 = T_对象;
    }
    如果 (!任聚合d) {
        可选<整64> 汇合类型查 = 查寄存器类型(真寄存器);
        如果 (汇合类型查.有值) {
            汇合类型 = 汇合类型查.值;
        } 否则 {
            IR层诊断("[内部错误] 三元汇合类型未登记（真寄存器=" +
                     整数转字符串(真寄存器) + "·真分支未登记类型码·模块=" +
                     取当前模块路径() + "）");
            运行时错误(4);
        }
    }
    整64 载入寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 临时槽, 0, 0, 载入寄存器, 汇合类型, 0));
    登记寄存器类型(载入寄存器, 汇合类型);
    // 86-a：聚合地址化三元——汇合值即「选中 place 地址」（T_对象 标记：值=地址，
    //   非值装载）。消费面契约：实参回扫（回扫实参取地址）对 T_对象 实参跳过
    //   「把值装载改取槽地址」的改写——否则会把「临时槽地址」当结构体基址传给
    //   被调方（P47-v2/t5_3 实证乱码：拷了临时槽 8 字节+垃圾）。
    //   263①：聚合调用返回形态并入（区间末为聚合调用返回·分支值=物化独立槽
    //   地址——错值面）。泄漏面：纯调用形态（两分支都是聚合调用返回）时把
    //   物化临时身份转移到汇合载入寄存器（结构体返回临时们.设置）——原登记在
    //   真块/假块各自的物化槽地址寄存器上，而弹出项=汇合载入寄存器 → 975
    //   清理调用实参临时 匹配失败=物化临时（整盒含串·独立副本）无人回收；
    //   转移后调用发射完 975 按弹出项命中、以载入寄存器**运行时值**（被选分支
    //   写入的合法槽地址）释放——未选块未执行=无堆分配=零泄漏·无垃圾基址释放
    //   （9263tmp_d 1000 轮泄漏实锤同源）。混合形态（左值×调用）只修错值不转移
    //   登记——左值分支汇合值=局部变量地址，登记后清理会把局部串 free=毁源
    //   （局部由 RAII 块出口管辖·既有语义）；其泄漏面（若有）独立观察。
    布尔 真聚合调用d2 = 区间末为聚合调用返回(池, 整32(n.文本), 整32(n.附加));
    布尔 假聚合调用d2 = 区间末为聚合调用返回(池, 整32(n.附加), n.子终点);
    如果 (任聚合d) {
        登记寄存器类型(载入寄存器, T_对象);
        如果 (真聚合调用d2 && 假聚合调用d2) {
            整64 汇合结构IDd = 0; 可选<整64> 汇合查d = 解析节点类型ID(池, 整32(n.附加) - 1);
            如果 (汇合查d.有值) { 汇合结构IDd = 汇合查d.值; }
            如果 (汇合结构IDd == 0) {
                可选<整64> 汇合查d2 = 解析节点类型ID(池, 整32(n.子终点) - 1);
                如果 (汇合查d2.有值) { 汇合结构IDd = 汇合查d2.值; }
            }
            如果 (汇合结构IDd != 0) {
                结果<空类型, 整32> 设汇d = 结构体返回临时们.设置(载入寄存器, 汇合结构IDd);
                如果 (!设汇d.正常) { 运行时错误(4); }
            }
        }
    }
    结果<空类型, 整32> 加汇 = 表达式栈.追加(载入寄存器);
    如果 (!加汇.正常) { 运行时错误(4); }
    // #2025：三元拥有标志登记——**无条件登记**（不再按分支形态禁盲登记）；
    //   两分支皆借用时标志恒 0，消费位条件释放为 no-op。消费位（赋值/实参/
    //   打印/拼接/返回/语句）统一经 发射串临时条件释放 按标志释放。
    三元拥有标志登记(三元池位c, 标志槽);
}

