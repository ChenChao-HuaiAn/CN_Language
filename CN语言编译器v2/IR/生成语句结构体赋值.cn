// CN 自举编译器 v2 · 生成语句（千行拆分子模块，2026-09-08 用户裁决阶段目录包）
// 职责：语句遍历（生成语句）+ 块遍历与控制流生成（生成块/生成如果/生成当）
//   ——自 IR生成.cn 机械搬移；寄存器/引用参数等权威表经 公开: 访问函数
//   （IR生成 主干）；模块路径=生成语句（新键基）。
导入 容器::向量;
导入 语法;       // Token/AST 节点池（原 导入 语法分析，目录包名）
导入 IR;         // IR容器 判定/符号合成 + IR_*/T_* 操作码（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 IR生成;     // 控制流辅助/变量类型权威表（同包幂等）
导入 生成声明;    // 语句级变量声明分派（R3 拆分，同包）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）
// D1 行数整改 121-a：自 生成语句.cn 按族拆出——结构体整体赋值（发射结构体目标地址 + 生成结构体整体赋值——87-a 单一事实源）（纯重构零行为变更）
// D1 行数整改 199-a：生成结构体整体赋值（原 170 行）按右值六形态拆 6 族分支方法（守卫链留主函数，体纯搬运零改写·程序化切片+深度断言·lessons 预防 179/180）

// 87-a（2026-09-12 第八十七轮）：结构体整体赋值/写入位**目标地址**解析（单一事实源）。
//   三级形态（与 生成左值地址 同约定）：
//     ① 目标槽==0 且命中顶层静态序号 → .data 符号地址（IR_静态地址，extra=序号）；
//     ② 引用参数槽（槽是引用）→ 槽内存「被引用对象地址」，加载即目标地址；
//     ③ 普通局部/参数槽 → IR_取地址（槽本体地址）。
//   原实现只有 ②③（目标槽必为局部/参数）——静态目标在赋值位被当「目标槽 0」
//   静默丢弃（探针 P50b v2 实证：`静态 盒 乙; 乙 = 盒{...}` 静态槽零写）。
不安全 函数 发射结构体目标地址(整64 目标槽, 整64 左名ID, 向量<IR指令>& 指令,
                          整64* 寄存器计数) -> 整64 {
    整64 目标地址 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    如果 (目标槽 == 0) {
        结果<整64, 整32> 找静目查 = 查静态序号含类(左名ID);
        如果 (找静目查.正常) {
            IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 目标地址, T_整64, 找静目查.值));
            返回 目标地址;
        }
    }
    如果 (槽是引用(目标槽)) {
        IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 目标地址, T_整64, 0));
    } 否则 {
        IR追加(指令, 建IR指令(IR_取地址, 目标槽, 0, 0, 目标地址, T_整64, 0));
    }
    返回 目标地址;
}

// 1651/1652 零填单点 发射聚合零填 已移至 生成语句辅助.cn（居消费方前加载·本文件控制体量）。

// 第18枚根治（2026-09-06，v2self 引用参数槽们 登记全 miss 根因）：
//   结构体变量整体赋值 甲 = 乙——旧实现无条件走 生成表达式
//   IR_加载/IR_存储 单槽 8 字节浅拷（24B 节点只拷 类型+文本 首
//   槽，附加 等后续字段原值残留——宿主为整结构体字节拷贝，编译器
//   分叉实锤）。对齐宿主/Rust POD Copy 语义：IR_结构体拷贝 整体
//   拷贝（源/目标地址按 引用槽→装载槽内容（绑定对象地址）、其余
//   →取槽地址 分流，与 生成左值地址 同约定）；非同型变量标识符
//   形态 fail fast 诊断拒绝（绝不静默浅拷=错误产物）。
// 87-a（2026-09-12）：目标/右值形态扩展——目标加静态（发射结构体目标地址
//   ①级）、右值加**结构体字面量**（物化槽 → 整体拷贝；原诊断拒绝=静默丢值）。
// 199-a：主函数保留 前置计算（左名/左类型/静态/先释放/自赋值 no-op）+ 右值六形态分派链（体迁 6 族分支方法）+ 公共尾段（表达式栈清空防御）——分派调用统一 13 参签名。
不安全 函数 生成结构体整体赋值(向量<节点> 池, 节点 n, 整64 目标槽,
                        映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                        函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                        向量<整64>& 表达式栈) -> 布尔 {
    整64 左名ID = 整64(n.文本);
    整64 左类型ID = 解析标识符类型ID(左名ID);
    // 111（919 轮）：**结构体指针目标分流**——`p = 无` 形态（p=结构体指针
    //   变量·右值=无 字面量）原被本通道抢道（查结构体大小 对 容器/用户类
    //   布局≠0）走「右值须为同型变量标识符」诊断（整64* 同形态健康=结构体
    //   指针专属缺口·555 头注登记）。指针变量=8 字节句柄：让位 普通赋值
    //   通道（生成表达式 无=0 值 → Store 槽=空指针·宿主同款语义）。
    // 252（2026-10-07·E2E 630/p1006_02 双测实录）：数组整体赋值拦截——须在
    //   指针让位守卫之前（94-a 数组名登记指针变量表·查指针变量类型≥0 会先
    //   让位）。原让位普通通道=退化基址 IR_存储 写基址槽首 8 字节（乙[1]/乙[2]
    //   保持初值=双侧同构病·宿主 asm 直证 movsxd 写乙[0]）。同型标识符右值 →
    //   IR_结构体拷贝 元素步进×长度 整块值拷（001 §3.5 数组=值聚合·087 形参
    //   rep movsb 同口径·087b 声明位表达式初值通道同款发射）。
    如果 (左类型ID > 0 && 是数组类型文本(驻留文本(左类型ID))) {
        返回 生成数组整体赋值(池, n, 目标槽, 局部槽, 参数槽, 函数信息,
                              寄存器计数, 槽计数, 表达式栈);
    }
    //   判据=查指针变量类型（生成声明 ③第三波 登记·IR生成 表）有值。
    可选<整64> 指针查体 = 查指针变量类型(左名ID);
    如果 (指针查体.有值) {
        返回 假;
    }
    // 466-a（T70 面②'·348-a 宿主教训 v2 侧同款）：容器/用户类目标放行既有
    //   深拷/接管通道（生成容器对象整体赋值）——撤守卫态下容器实例布局登记
    //   （423-b 裸键直设）使 查结构体大小≠0·本通道误抢容器赋值（生产态无
    //   实例布局=天然 0·零回归）。
    如果 (是容器类(驻留文本(整64(左类型ID))) || 是用户类(驻留文本(整64(左类型ID)))) {
        返回 假;
    }
    // 静默豁免业务值: 非结构体→非整体赋值通道早退假（原 ==0 判据同义·1541 B2 否定形态）
    // 静默豁免上游已诊断: 手动释放<T>=8 字节句柄槽（非合成体/结构体·串槽
    //   通道）——误入本通道→调用返回串 右值被拒（1586 锁面实锤·否定应答分流）
    如果 (!是结构体大小非零(左类型ID) || 是手动释放类型(驻留文本(整64(左类型ID)))) {
        返回 假;
    }
    // 508-a（T70 B1 三层④·同族第二缺口）：**类字段（结构体类型）目标让位方法体
    //   字段左值通道**（生成标识符赋值 的字段分支）——本通道目标地址按「局部/
    //   参数槽」解析（发射结构体目标地址 ③级 取槽本体地址），而字段名裸标识符在
    //   方法体内目标槽恒 0（局部槽表无此项）→ 产物 op=43 `lea r10, [rbp-32]`
    //   （**槽 0 地址**而非 this+字段偏移）→ 字段整体赋值写错位置/段错误（探针
    //   `盒$设(p){ 内 = p; }` 产物实证·修前同态）；让位后由字段分支按
    //   发射类字段地址（this 槽加载+字段偏移）整体拷贝。
    //   判据：目标槽 0（非局部/参数）∧ 命中当前方法字段偏移表。
    可选<整64> 左字段偏查 = 当前方法字段偏移(左名ID);
    如果 (目标槽 == 0 && 左字段偏查.有值) {
        返回 假;
    }
    // 87-a：目标为顶层静态（目标槽 0 + 命中静态序号）——静态槽长期存活，重复
    //   赋值须 preFree 释放旧字段串（与局部块出口释放等效的 drop glue，79-a）。
    布尔 目标是静态 = 假;
    结果<整64, 整32> 目标静查 = 查静态序号含类(左名ID);
    如果 (目标槽 == 0 && 目标静查.正常) { 目标是静态 = 真; }
    // 87-a：目标先释放（preFree）预计算——静态槽长期存活恒拥有；局部按资源
    //   字段名单。预计算=性能选择（一次求值供下方多个 发射结构体整体拷贝 调用点
    //   复用）；原「实参位短路不可用」约束已由 88-a 根治（语法层二元链左起点 +
    //   IR 层净栈契约归位；E2E 248 门禁），此处保留预计算形态不依赖实参位短路。
    布尔 目标先释放 = 在资源字段名单(函数信息, 左名ID);
    如果 (目标是静态) { 目标先释放 = 真; }
        节点 右末 = 池.元素(整32(n.子终点 - 1));
        // 79-a：自赋值（甲 = 甲）no-op——preFree 会先释放目标串字段，memcpy 把
        //   已释放句柄拷回、深拷再复制已释放内存（UAF）；值语义自赋值恒无副作用。
        如果 (右末.类型 == 节点_标识符 && 整64(右末.文本) == 左名ID) {
            返回 真;
        }
        // 936（#936 同族·运算符重载返回结构体·821 类对象面同款判据）：右末=
        //   二元/单目节点且重载命中（产物类型==左类型）→ 并入调用返回通道
        //   （发射侧 发射运算符重载二元/一元 复用 发射用户类方法调用 ABI：
        //   真结构体聚合返回物化壳+结构体返回临时们 登记 → 调用分支的
        //   浅拷接管/1013 资源处置消费成立）。
        布尔 右末重载形态936 = (右末.类型 == 节点_二元运算 ||
                                右末.类型 == 节点_负号 ||
                                右末.类型 == 节点_逻辑非 ||
                                右末.类型 == 节点_位非);
        布尔 右末重载命中936 = 假;
        如果 (右末重载形态936) {
            可选<整64> 重载查936s = 解析重载节点类型ID(池, 整32(n.子终点 - 1));
            如果 (重载查936s.有值) {
                整64 重载ID936s = 0;
                如果 (重载查936s.有值) { 重载ID936s = 重载查936s.值; }
                右末重载命中936 = 重载ID936s == 左类型ID;
            }
        }
        布尔 右末是重载936 = 右末重载形态936 && 右末重载命中936;
        如果 (右末.类型 == 节点_结构体构造) {
            生成结构体赋值构造分支(池, n, 左名ID, 左类型ID, 目标槽, 局部槽, 参数槽,
                              函数信息, 寄存器计数, 槽计数, 表达式栈, 目标先释放,
                              目标是静态);
        } 否则 如果 (右末是重载936) {
            生成结构体赋值调用分支(池, n, 左名ID, 左类型ID, 目标槽, 局部槽, 参数槽,
                              函数信息, 寄存器计数, 槽计数, 表达式栈, 目标先释放,
                              目标是静态);
        } 否则 如果 (右末.类型 != 节点_标识符 && 右末.类型 != 节点_成员 &&
             右末.类型 != 节点_调用 && 右末.类型 != 节点_三元运算) {
            生成结构体赋值形态诊断分支(池, n, 左名ID, 左类型ID, 目标槽, 局部槽, 参数槽,
                              函数信息, 寄存器计数, 槽计数, 表达式栈, 目标先释放,
                              目标是静态);
        } 否则 如果 (右末.类型 == 节点_调用) {
            生成结构体赋值调用分支(池, n, 左名ID, 左类型ID, 目标槽, 局部槽, 参数槽,
                              函数信息, 寄存器计数, 槽计数, 表达式栈, 目标先释放,
                              目标是静态);
        } 否则 如果 (右末.类型 == 节点_三元运算) {
            生成结构体赋值三元分支(池, n, 左名ID, 左类型ID, 目标槽, 局部槽, 参数槽,
                              函数信息, 寄存器计数, 槽计数, 表达式栈, 目标先释放,
                              目标是静态);
        } 否则 如果 (右末.类型 == 节点_成员) {
            生成结构体赋值成员分支(池, n, 左名ID, 左类型ID, 目标槽, 局部槽, 参数槽,
                              函数信息, 寄存器计数, 槽计数, 表达式栈, 目标先释放,
                              目标是静态);
        } 否则 {
            生成结构体赋值标识符分支(池, n, 右末, 左名ID, 左类型ID, 目标槽, 局部槽, 参数槽,
                              函数信息, 寄存器计数, 槽计数, 表达式栈, 目标先释放,
                              目标是静态);
        }
        // 清空表达式栈（结构体赋值不走 生成表达式——保持与分支出口
        //   同构防御）
        当 (表达式栈.大小() > 0) {
            结果<空类型, 整32> 删栈构 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈构.正常) { 运行时错误(4); }
        }
    返回 真;
}

// 199-a（2026-09-15 第一百九十九轮，D1 行数整改）：分支① 字面量右值（守卫：右末.类型 == 节点_结构体构造）。
不安全 函数 生成结构体赋值构造分支(向量<节点> 池, 节点 n, 整64 左名ID, 整64 左类型ID,
                          整64 目标槽, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                          函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                          向量<整64>& 表达式栈, 布尔 目标先释放, 布尔 目标是静态) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
            // 87-a（2026-09-12 第八十七轮）：**字面量右值**（`乙 = 盒{ 名 = ..., 号 = ... }`）
            //   ——生成表达式物化临时槽（84-a 生成结构体构造：逐字段写 + 字段串
            //   归一化落堆）→ 目标地址（局部/参数/静态）+ 整体拷贝（深拷=真：
            //   源槽为栈临时、其字段串在构造时已归一化/驻留，源随块退出释放）。
            //   原实现落「右值须为同型变量标识符」诊断分支 → **目标静默丢值**
            //   （探针 P50b v2 实证：静态目标静态槽零写、读取读垃圾）。
            生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽, 指令, 寄存器计数,
                     &函数信息.块计数, 槽计数, 表达式栈);
            整64 源地址字 = 0;
            如果 (表达式栈.大小() > 0) {
                源地址字 = 表达式栈.元素(表达式栈.大小() - 1);
                结果<空类型, 整32> 删源字 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删源字.正常) { 运行时错误(4); }
            }
            整64 目标地址字 = 发射结构体目标地址(目标槽, 左名ID, 指令, 寄存器计数);
            发射结构体整体拷贝(函数信息, 寄存器计数, 目标地址字, 源地址字, 左类型ID,
                              真, 目标是静态);
}

// 199-a：分支② 形态守卫诊断（守卫：右末.类型 ∉ {标识符, 成员, 调用, 三元运算}）。
不安全 函数 生成结构体赋值形态诊断分支(向量<节点> 池, 节点 n, 整64 左名ID, 整64 左类型ID,
                          整64 目标槽, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                          函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                          向量<整64>& 表达式栈, 布尔 目标先释放, 布尔 目标是静态) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
            IR层诊断("结构体赋值右值须为同型变量标识符: " +
                      驻留文本(整64(n.文本)));
}

// 199-a：分支③ 调用返回右值（守卫：右末.类型 == 节点_调用；82-b 浅拷接管）。
不安全 函数 生成结构体赋值调用分支(向量<节点> 池, 节点 n, 整64 左名ID, 整64 左类型ID,
                          整64 目标槽, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                          函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                          向量<整64>& 表达式栈, 布尔 目标先释放, 布尔 目标是静态) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
            // 82-b：结构体赋值右值=**调用返回**（`盒子 甲; 甲 = 造盒(9);`）——
            //   原 fail fast 诊断拒绝（宿主支持）。实现：求值右值表达式序列
            //   （实参 + 调用 + 82-a 返回物化 → 表达式栈顶=物化槽地址），
            //   目标=左槽地址，**浅拷接管**（深拷=假）：物化槽为一次性返回值、
            //   求值后不再被引用，句柄所有权移交目标（零拷贝；与声明位
            //   「返回接收接管」同语义，79-a）。同型校验用物化登记表
            //   （结构体返回临时们：源寄存器 → 结构体 ID）。
            整64 消费数c = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                   指令, 寄存器计数, &函数信息.块计数, 槽计数,
                                   表达式栈);
            如果 (消费数c == 0) {
                IR层诊断("结构体赋值右值（调用返回）求值失败: " +
                          驻留文本(整64(n.文本)));
            } 否则 {
                整64 源寄存器c = 0;
                如果 (表达式栈.大小() > 0) {
                    源寄存器c = 表达式栈.元素(表达式栈.大小() - 1);
                    结果<空类型, 整32> 删源c = 表达式栈.删除(表达式栈.大小() - 1);
                    如果 (!删源c.正常) { 运行时错误(4); }
                }
                结果<整64, 整32> 查源c = 结构体返回临时们.获取(源寄存器c);
                如果 (查源c.正常) {
                    整64 源类型IDc = 查源c.值;
                    如果 (源类型IDc != 左类型ID) {
                        IR层诊断("结构体赋值左右类型不同: " +
                                  驻留文本(整64(n.文本)));
                    } 否则 {
                        整64 目标地址c = 发射结构体目标地址(目标槽, 左名ID, 指令, 寄存器计数);
                        // 浅拷接管（源=一次性物化槽）+ 目标拥有槽先释放旧字段串
                        发射结构体整体拷贝(函数信息, 寄存器计数, 目标地址c, 源寄存器c,
                                         左类型ID, 假, 目标先释放);
                        // 1013 批八续（79_v2 根治配对·〔基准=019〕）：物化壳已深拷
                        //   （81-a-v2 对含资源字段结构体返回）→ move 接管后目标=
                        //   独立副本唯一拥有者 → 左值（局部拥有槽）补 RAII 登记
                        //   （防泄漏·与生成声明 接收配对）+ 删除临时登记（拥有移交）。
                        //   目标=参数/静态等非拥有位不登记（宁漏勿错·既有边界）。
                        布尔 判左局部1013 = 假;
                        如果 (目标槽 != 0) {
                            结果<整64, 整32> 找左1013 = 局部槽.获取(左名ID);
                            判左局部1013 = 找左1013.正常;
                        }
                        // 成对纪律（IR容器.cn 资源字段结构体们 注：与局部们**同下标**）：
                        //   名单追加去重 对两表分别去重会在两表历史不同步时错位
                        //   （自举树 [ir2] 成员字段偏移未知 实证）——改「先查在册
                        //   不在才成对追加」。
                        如果 (资源字段数(左类型ID) > 0 && 判左局部1013 &&
                             !在资源字段名单(函数信息, 左名ID)) {
                            结果<空类型, 整32> 加局1013 = 函数信息.资源字段局部们.追加(左名ID);
                            如果 (!加局1013.正常) { 运行时错误(4); }
                            结果<空类型, 整32> 加构1013 = 函数信息.资源字段结构体们.追加(左类型ID);
                            如果 (!加构1013.正常) { 运行时错误(4); }
                        }
                        如果 (判左局部1013) {
                            布尔 删临c1013 = 结构体返回临时们.删除(源寄存器c);
                        }
                    }
                } 否则 {
                    IR层诊断("结构体赋值右值（调用返回）非结构体返回值: " +
                              驻留文本(整64(n.文本)));
                }
            }
}

// 199-a：分支④ 三元右值（守卫：右末.类型 == 节点_三元运算；86-a 地址透传）。
不安全 函数 生成结构体赋值三元分支(向量<节点> 池, 节点 n, 整64 左名ID, 整64 左类型ID,
                          整64 目标槽, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                          函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                          向量<整64>& 表达式栈, 布尔 目标先释放, 布尔 目标是静态) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
            // 86-a（2026-09-12 复审缺陷①）：三元右值（`丙 = (真 ? 甲 : 乙);`）——
            //   生成表达式 经 生成三元运算（86-a 聚合分支地址化）得**选中 place
            //   地址**（地址透传，与成员形态同款消费）。原白名单不含三元 →
            //   「结构体赋值右值须为同型变量标识符」诊断拒绝（P46 v2 实证）。
            //   同型校验=右末节点类型（标识符/成员经 解析节点类型ID；防御性——
            //   两分支与左同型由语义层保证）。源为候选局部（保持拥有）→ 深拷；
            //   目标拥有槽 preFree（同标识符形态）。
            整64 右类型IDt = 0;
            可选<整64> 右类型查t = 解析节点类型ID(池, 整32(n.子终点 - 1));
            如果 (右类型查t.有值) { 右类型IDt = 右类型查t.值; }
            整64 右大小t = 0;
            可选<整64> 右大小t查 = 查结构体大小(右类型IDt);
            如果 (右大小t查.有值) { 右大小t = 右大小t查.值; }
            整64 左大小t = 0;
            可选<整64> 左大小t查 = 查结构体大小(左类型ID);
            如果 (左大小t查.有值) { 左大小t = 左大小t查.值; }
            如果 (右大小t != 左大小t) {
                IR层诊断("结构体赋值左右类型不同/右值非结构体: " +
                          驻留文本(整64(n.文本)));
            } 否则 {
                整64 源地址t = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                       指令, 寄存器计数, &函数信息.块计数, 槽计数,
                                       表达式栈);
                整64 目标地址t = 发射结构体目标地址(目标槽, 左名ID, 指令, 寄存器计数);
                发射结构体整体拷贝(函数信息, 寄存器计数, 目标地址t, 源地址t,
                                 左类型ID, 真, 目标先释放);
            }
}

// 199-a：分支⑤ 成员链右值（守卫：右末.类型 == 节点_成员；46-a 根治）。
不安全 函数 生成结构体赋值成员分支(向量<节点> 池, 节点 n, 整64 左名ID, 整64 左类型ID,
                          整64 目标槽, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                          函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                          向量<整64>& 表达式栈, 布尔 目标先释放, 布尔 目标是静态) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
            // 46-a 根治（2026-09-09 第四十八轮）：成员链右值（u = r.左上）——
            //   原右值限定标识符可见失败。右类型ID=右末节点自身类型经
            //   解析成员链结构体ID（递归解父链 r→矩形→左上→点），源地址=
            //   生成左值地址（顺序链，不 LoadPtr——结构体右值地址语义）；
            //   同型校验后 IR_结构体拷贝。
            整64 右类型IDm = 0;
            可选<整64> 右类型查m = 解析成员链结构体ID(池, 整32(n.子终点 - 1));
            如果 (右类型查m.有值) { 右类型IDm = 右类型查m.值; }
            整64 右大小m = 0;
            可选<整64> 右大小m查 = 查结构体大小(右类型IDm);
            如果 (右大小m查.有值) { 右大小m = 右大小m查.值; }
            整64 左大小m = 0;
            可选<整64> 左大小m查 = 查结构体大小(左类型ID);
            如果 (左大小m查.有值) { 左大小m = 左大小m查.值; }
            如果 (右大小m != 左大小m) {
                IR层诊断("结构体赋值左右类型不同/右值非结构体: " +
                          驻留文本(整64(n.文本)));
            } 否则 {
                整64 源地址m = 生成左值地址(池, n.子起点, n.子终点, 局部槽,
                                             参数槽, 指令, 寄存器计数,
                                             &函数信息.块计数, 槽计数,
                                             表达式栈);
                整64 目标地址m = 发射结构体目标地址(目标槽, 左名ID, 指令, 寄存器计数);
                // 79-a：串字段深拷（成员源=值语义拷贝：源保持拥有，目标独立副本；
                //   目标为字段/元素——非拥有槽，不做 preFree（宁漏勿错））
                发射结构体整体拷贝(函数信息, 寄存器计数, 目标地址m, 源地址m,
                                 左类型ID, 真, 假);
            }
}

// 199-a：分支⑥ 标识符右值（守卫：否则——同型变量槽深拷）。
//   右末=主函数已求值的末节点（体内标识符形态引用——参数传入避免重复求值）。
不安全 函数 生成结构体赋值标识符分支(向量<节点> 池, 节点 n, 节点 右末, 整64 左名ID, 整64 左类型ID,
                          整64 目标槽, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                          函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                          向量<整64>& 表达式栈, 布尔 目标先释放, 布尔 目标是静态) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令;
            整64 右类型ID = 解析标识符类型ID(整64(右末.文本));
            整64 右大小z = 0;
            可选<整64> 右大小z查 = 查结构体大小(右类型ID);
            如果 (右大小z查.有值) { 右大小z = 右大小z查.值; }
            整64 左大小z = 0;
            可选<整64> 左大小z查 = 查结构体大小(左类型ID);
            如果 (左大小z查.有值) { 左大小z = 左大小z查.值; }
            如果 (右大小z != 左大小z) {
                IR层诊断("结构体赋值左右类型不同/右值非结构体: " +
                          驻留文本(整64(n.文本)));
            } 否则 {
                整64 右槽 = 0;
                结果<整64, 整32> 找右局部 = 局部槽.获取(整64(右末.文本));
                // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
                如果 (找右局部.正常) { 右槽 = 找右局部.值; } 否则 { }
                如果 (右槽 == 0) {
                    结果<整64, 整32> 找右参 = 参数槽.获取(整64(右末.文本));
                    // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
                    如果 (找右参.正常) { 右槽 = 找右参.值; } 否则 { }
                }
                如果 (右槽 == 0) {
                    IR层诊断("结构体赋值右值未找到变量槽: " +
                              驻留文本(整64(右末.文本)));
                } 否则 {
                    整64 源地址 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    如果 (槽是引用(右槽)) {
                        IR追加(指令, 建IR指令(IR_加载, 右槽, 0, 0,
                                             源地址, T_整64, 0));
                    } 否则 {
                        IR追加(指令, 建IR指令(IR_取地址, 右槽, 0, 0,
                                             源地址, T_整64, 0));
                    }
                    整64 目标地址 = 发射结构体目标地址(目标槽, 左名ID, 指令, 寄存器计数);
                    // 79-a：串字段深拷 + 目标拥有槽 preFree（旧字段串先释放，
                    //   幂等清槽——目标为函数局部且登记在资源字段名单时；87-a：
                    //   静态目标恒 preFree——静态槽长期存活，重复赋值须 drop 旧值）
                    发射结构体整体拷贝(函数信息, 寄存器计数, 目标地址, 源地址,
                                     左类型ID, 真, 目标先释放);
                }
            }
}

// 965（002·30 号·合成体整体赋值根治）：`读取结果 = 数据.读取(99);`——对已声明
//   结果/可选 变量的赋值语句。原路径缺陷：生成结构体整体赋值 守卫 查结构体大小
//   ==0（合成体不登记结构体布局表）→ 落普通 生成表达式 → IR_存储 8 字节只把
//   sret retbuf 指针写进基址槽 → 后续 .正常/.错误/.值 按内联布局读槽=读指针
//   自身字节（E2E 30「读取[99]未报错」+探针十跑一次「越界: 32764」=读指针+4
//   处栈地址字节·ASLR 漂移错值实证）。修复对齐 生成结果局部 初值通道（87-a
//   范本）：源地址（调用=sret retbuf·三元=聚合地址透传 86-a·构造=物化临时
//   84-a）或 place 地址（标识符/成员·生成左值地址）→ IR_取地址 基址槽 →
//   IR_结构体拷贝 结果大小 字节。所有权：右值=调用=move 接收（retbuf 移出·
//   位拷安全·70-a 同款）；右值=标识符（拥有局部）=move（位拷+源槽组清零——
//   防 double free）；右值=参数/成员（借用来源）且载荷=资源型（字符串/用户类）
//   =显式诊断（借用深拷未实施·宁拒绝勿悬垂）；标量载荷借用来源位拷安全。
//   旧值释放（对齐 79-a/946 出口登记面·零误伤）：类载荷（容器变量们在册）
//   发射盒类值载荷摘删；字符串载荷（资源字段局部们在册）发射资源字段析构
//   单名区间（释放后清零幂等模型不变·名单保留块出口兜底空安全）。
不安全 函数 生成合成体整体赋值(向量<节点> 池, 节点 n, 整64 目标槽,
                        映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                        函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                        向量<整64>& 表达式栈) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    整64 左名ID965 = 整64(n.文本);
    整64 左类型ID965 = 解析标识符类型ID(左名ID965);
    如果 (左类型ID965 == 0) { 返回 假; }
    字符串 左类型文本965 = 字符串复制(驻留文本(左类型ID965));
    如果 (!是结果类型(左类型文本965)) { 返回 假; }
    // 指针层让位（双轨坑 B 同源）：类字段/局部指针登记文本=剥星基名+尾星
    //   （生成类.cn 指针层补星/生成声明 ③）——「向量<结果<..>> 的 T* 数据」
    //   字段基名=结果$..* → 是结果类型 基名判定命中=误伤（537 实证「数据 =
    //   新数据」指针赋值被吞）。尾部含 *=指针槽 8 字节句柄 → 让位原 IR_存储。
    如果 (字符串长度(左类型文本965) > 0 &&
         整64(左类型文本965[字符串长度(左类型文本965) - 1]) == 42) { 返回 假; }
    // 目标=基址槽（生成结果局部 登记局部/参数槽=基址槽〔大槽号低地址·tag@0
    //   值@8〕）；目标槽 0（静态/方法体字段形态）=让位原通道（维持既有行为·
    //   首版面=局部/参数——静态/字段合成体整体赋值登记为 002 后续边界）
    如果 (目标槽 == 0) { 返回 假; }
    节点 右末965 = 池.元素(整32(n.子终点 - 1));
    // 自赋值 no-op（79-a 同款：preFree+拷贝交织=UAF；值语义自赋值恒无副作用）
    如果 (右末965.类型 == 节点_标识符 && 整64(右末965.文本) == 左名ID965) { 返回 真; }
    // 1651：**合成体局部 = 无**（空可选）——旧载荷按 tag 守卫条件释放 + 判别位 0
    //   /载荷零；原落下方源发射通道（生成表达式(无)=常量 0）→ 源类型无法解析
    //   显形中止 / 若放行则从地址 0 整块拷贝（C0000005 fault=0）。
    如果 (右末965.类型 == 节点_整数字面量 && 右末965.附加 == 1) {
        整64 目标地址无965 = 发射结构体目标地址(目标槽, 左名ID965, 指令,
                                             寄存器计数);
        发射结果可选值字段释放于地址(函数信息, 寄存器计数, 左类型ID965,
                                    目标地址无965);
        发射聚合零填(指令, 寄存器计数, 目标地址无965,
                     结果大小(左类型文本965));
        当 (表达式栈.大小() > 0) {
            结果<空类型, 整32> 删栈无965 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈无965.正常) { 运行时错误(4); }
        }
        返回 真;
    }
    // 载荷资源性判定（字符串/用户类载荷=句柄字段·借用来源须拒绝）
    字符串 载荷965 = 段首(合成名首实参(左类型文本965));
    布尔 载荷资源965 = 字符串比较(载荷965, "字符串") || 是用户类(载荷965);
    布尔 右借用965 = 假;
    如果 (右末965.类型 == 节点_成员) { 右借用965 = 真; }
    如果 (右末965.类型 == 节点_标识符) {
        结果<整64, 整32> 查参965 = 参数槽.获取(整64(右末965.文本));
        如果 (查参965.正常) { 右借用965 = 真; } 否则 { }
    }
    如果 (右借用965 && 载荷资源965) {
        IR层诊断("合成体赋值右值为借用来源（参数/成员）且载荷为资源型（字符串/类）——借用深拷未实施·让位原通道: " +
                 驻留文本(左名ID965));
        返回 假;
    }
    // 旧值释放（登记面精确一致：声明时 946/79-a 登记·标量载荷零登记零释放）
    整64 ci965 = 0;
    当 (ci965 < 函数信息.容器变量们.大小()) {
        如果 (函数信息.容器变量们.元素(ci965) == 左名ID965) {
            布尔 摘删965 = 发射盒类值载荷摘删(函数信息, 寄存器计数, 目标槽,
                                               左类型ID965);
            如果 (!摘删965) {
                IR层诊断("合成体赋值旧值摘删失败（类载荷在册但形态不符）: " +
                         驻留文本(左名ID965));
            }
            中断;
        }
        ci965++;
    }
    整64 ri965 = 0;
    当 (ri965 < 函数信息.资源字段局部们.大小()) {
        如果 (函数信息.资源字段局部们.元素(ri965) == 左名ID965) {
            发射资源字段析构(函数信息, 局部槽, 寄存器计数, ri965, ri965 + 1, 0);
            中断;
        }
        ri965++;
    }
    // 源发射（348-a 形态分流）：标识符/成员=place 地址；调用/三元/构造=求值产物
    整64 源地址965 = 0;
    整64 源基槽965 = 0;
    如果 (右末965.类型 == 节点_标识符 || 右末965.类型 == 节点_成员) {
        源地址965 = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽, 指令,
                                 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
        如果 (右末965.类型 == 节点_标识符) {
            结果<整64, 整32> 找源槽965 = 局部槽.获取(整64(右末965.文本));
            // 静默豁免业务值: 查表 miss=键不存在·显式哨兵（1241 显式化）
            如果 (找源槽965.正常) { 源基槽965 = 找源槽965.值; } 否则 { }
        }
    } 否则 {
        源地址965 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽, 指令,
                               寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
    }
    如果 (源地址965 != 0) {
        // #1682（2026-10-27）：目标地址发射收口 发射结构体目标地址（87-a 单一
        //   事实源·三级形态与 生成结构体整体赋值 同约定）——引用形参/引用局部
        //   左值（`可选<整64>& 引用` 形参 `引用 = 某些(3)`）槽存「被引用左值
        //   地址」→ IR_加载 得目标地址；原 IR_取地址(引用槽)=把合成体拷进引用
        //   槽本体 9 字节（写穿相邻槽+绑定对象零写·1591 探针 fault=0x1 实录）。
        //   1651 无 分支已用本单点（上方），主路径同步收口。
        整64 目标地址965 = 发射结构体目标地址(目标槽, 左名ID965, 指令,
                                             寄存器计数);
        // 1589/1592：同型=整块拷贝；异型（语义层放行的 结果<A,B>→结果<C,D>）
        //   =逐字段值保真转换（原无条件按目标大小整块搬→源窄载荷高位残留，
        //   乙.值=708669603847 实证）
        布尔 已拷965 = 发射合成体初值拷贝(池, 右末965, 整64(n.子终点 - 1),
                                        源地址965, 目标地址965, 左类型文本965,
                                        函数信息, 寄存器计数);
        // 1605（965 值语义定夺·001 整体赋值=值语义·显式 转移() 才 move）：撤
        //   原源槽组清零（越权 move——未判 last-use 即清零，源名后续使用=读零，
        //   与宿主值语义分叉·965 注释所称「借用检查防线在语义层」从未实施）。
        //   标识符拥有局部源=位拷共享句柄，须补载荷条件深拷（T/E 独立副本·
        //   宿主 emitOwnedStrFieldPostCopy 同构）；调用/构造临时源=retbuf
        //   move 接管位拷安全（深拷浪费+临时句柄无人释放），不深拷。
        如果 (已拷965 && 右末965.类型 == 节点_标识符 && 源基槽965 != 0) {
            发射合成体载荷深拷1605(函数信息, 寄存器计数, 目标地址965,
                                源地址965, 左类型文本965);
        }
    }
    当 (表达式栈.大小() > 0) {
        结果<空类型, 整32> 删栈965 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈965.正常) { 运行时错误(4); }
    }
    返回 真;
}

// #1683（2026-10-27）：三元双分支=结果/可选 构造器调用判定——声明初值
//   `果 = 选 ? 某些(11) : 某些(22)` 形态（发射合成体初值拷贝 源类型豁免判据）。
//   分支区间参照 解析节点类型ID 86-a 三元分支：真=[n.文本, n.附加)、
//   假=[n.附加, n.子终点)，末节点=区间尾。双分支全构造=真；任一非构造=假
//   （调用方不豁免·落解析 miss 显形，禁静默按目标同型错拷）。
函数 是构造调用节点1683(向量<节点> 池, 节点 末) -> 布尔 {
    如果 (末.类型 != 节点_调用 || 末.子起点 <= 0 ||
         末.子起点 >= 整64(池.大小())) { 返回 假; }
    节点 被调1683 = 池.元素(整32(末.子起点));
    如果 (被调1683.类型 != 节点_标识符) { 返回 假; }
    字符串 被调名1683 = 字符串复制(驻留文本(整64(被调1683.文本)));
    返回 字符串比较(被调名1683, "正常") || 字符串比较(被调名1683, "错误") ||
          字符串比较(被调名1683, "某些");
}
函数 三元双分支构造调用1683(向量<节点> 池, 节点 三) -> 布尔 {
    如果 (三.类型 != 节点_三元运算) { 返回 假; }
    // 静默豁免闭集穷举: 区间结构谓词（形态不符=调用方不豁免·落源类型解析 miss 显形中止·非静默取默认继续）
    如果 (!(三.文本 < 三.附加 && 三.附加 < 三.子终点)) { 返回 假; }
    节点 真末1683 = 池.元素(整32(三.附加 - 1));
    // 静默豁免闭集穷举: 构造调用谓词（非构造分支=不豁免·同上显形通道·#1683 诚实边界）
    如果 (!是构造调用节点1683(池, 真末1683)) { 返回 假; }
    节点 假末1683 = 池.元素(整32(三.子终点 - 1));
    返回 是构造调用节点1683(池, 假末1683);
}

// ==================== 1589/1592：合成体（结果/可选）异型隐式转换 ====================
// 语义层放行 结果<A,B> -> 结果<C,D>（A→C 且 B→D 可转·可选<T> -> 可选<U> 同理），
// 但旧实现两处（生成合成体整体赋值 / 生成结果局部 初值）无条件
// IR_结构体拷贝(结果大小(目标))：按**目标**大小从源整块搬——源载荷窄于目标时
// 高位残留（实测 结果<整32,整32> -> 结果<整64,整32>：乙.值=708669603847；
// 可选面 140698833649673），负值 4 字节载荷高位零=值域丢失（宿主 4294967295
// 同族，本任务双侧根治）。本族=逐字段值保真转换：
//   ① 类型键（去空白+尖括号归 $）相同或载荷对完全相同 -> 整块拷贝（零开销）；
//   ② 异型 -> 读判别位@0（T_整32 4B·装箱写侧同宽）+ 按 tag 分支：
//      正常支 T1→T2、错误支 E1→E2（可选无错误支）；载荷读按**源**类型码
//      （整32 有符号 movsxd/正32 零扩展由后端分派）、IR_类型转换 桥接、
//      写按**目标**类型码（窄写截断）。数值一律值保真（整32(-1)→整64 == -1）。
// 禁静默：非标量载荷（结构体/容器/字符串异型/128 宽型）语义层不会放行——
// 到达即编译器内部口径不一致，IR层诊断显形中止（绝不按 8 字节错拷）。

// 1589/1592：类型文本去空白——源码形态「结果<整64, 整32>」的逗号后空格使
//   归一结果名 产出「结果$整64$ 整32」（逗号→$、空格保留）与登记形态不齐。
函数 去类型空白(字符串 文本) -> 字符串 {
    字符串 出 = "";
    整64 i = 0;
    当 (i < 字符串长度(文本)) {
        整64 b = 整64(文本[i]) & 255;
        如果 (b != 32 && b != 9) { 出 = 出 + 字符串子串(文本, i, 1); }
        i++;
    }
    返回 出;
}

// 1589/1592：合成体类型键——去空白 + 尖括号归一到 $ 形态（结果<整32,整32>
//   与 结果$整32$整32 同键）。
函数 合成体类型键(字符串 类型文本) -> 字符串 {
    字符串 键 = 归一结果名(去类型空白(类型文本));
    // 尖括号归一残留：归一结果名 把 '>' 也换 '$'——「结果<空类型, 整32>」→
    //   「结果$空类型$整32$」（尾多 $）。实镜=容器方法返回类型文本经插件面
    //   到达（`结果<空类型, 整32> 加 = 表.追加(...)`：源键带尾 $、目标键不带
    //   → 误判异型 + 载荷切出「整32$」→ 非标量显形误报 245/641）。剥尾 $ 归一。
    当 (字符串长度(键) > 0 && (整64(键[整32(字符串长度(键) - 1)]) & 255) == 36) {
        键 = 字符串子串(键, 0, 整32(字符串长度(键) - 1));
    }
    返回 键;
}

// 1589/1592：合成体初值/赋值源类型文本（按右末节点形态分派）：
//   标识符=解析标识符类型ID；调用=解析调用返回类型ID（结果/可选 不走结构体
//   布局桶·1014 专用通道）；其余（成员/三元/解引用）=解析节点类型ID。
//   空串=无法解析（调用方 IR层诊断显形·禁静默）。
函数 合成体源类型文本(向量<节点> 池, 节点 右末, 整64 右索引) -> 字符串 {
    如果 (右末.类型 == 节点_标识符) {
        整64 标型ID = 解析标识符类型ID(整64(右末.文本));
        如果 (标型ID != 0) { 返回 字符串复制(驻留文本(标型ID)); }
        返回 "";
    }
    如果 (右末.类型 == 节点_调用) {
        可选<整64> 调型查 = 解析调用返回类型ID(池, 整32(右索引));
        如果 (调型查.有值) { 返回 字符串复制(驻留文本(调型查.值)); }
        // 1526/641 实镜：解析调用返回类型ID 对**用户类方法**要求成员方法标记/
        //   对象类型链——JSON树.新节点 等面 miss（结果化返回类型表已在类方法
        //   表登记）→ 结果变量初值「源类型无法解析」误中止。宽松回退=同上
        //   判据但成员标记不设门（类方法返回表 / 容器签名表 双源）。
        可选<整64> 宽查 = 合成体调用返回类型ID(池, 整32(右索引));
        如果 (宽查.有值) { 返回 字符串复制(驻留文本(宽查.值)); }
        返回 "";
    }
    可选<整64> 节型查 = 解析节点类型ID(池, 整32(右索引));
    如果 (节型查.有值) { 返回 字符串复制(驻留文本(节型查.值)); }
    返回 "";
}

// 1589/1592：调用返回类型宽松解析（合成体源类型专用）——不设「成员方法标记」
//   门：①标识符被调=用户类名/函数返回回退；②成员被调=对象类型 → 类方法返回表
//   →（容器）方法签名表剥尾 &。空=不可解析（调用方显形）。
函数 合成体调用返回类型ID(向量<节点> 池, 整32 调用索引) -> 可选<整64> {
    如果 (调用索引 < 0 || 调用索引 >= 池.大小()) { 返回 无; }
    节点 调 = 池.元素(调用索引);
    如果 (调.类型 != 节点_调用 || 调.子起点 <= 0) { 返回 无; }
    节点 被调 = 池.元素(整32(调.子起点));
    如果 (被调.类型 == 节点_标识符) {
        如果 (是用户类_ID(整64(被调.文本))) { 返回 某些(整64(被调.文本)); }
        可选<整64> 函返查 = 查函数返回回退(整64(被调.文本));
        如果 (函返查.有值) { 返回 函返查; }
        // #1592 回归修复（云端预验 32/35/38/1039 实锚）：限定调用
        //   模块::函数（算法::二分查找整32）——返回类型表键为裸名/本模块键基，
        //   限定文本直查恒 miss → 源类型空 → 误报内部错误中止 v2 编译。
        //   剥限定段后按裸名重查（与 检查限定调用 语义面同口径）。
        字符串 调文本1592 = 字符串复制(驻留文本(整64(被调.文本)));
        字符串 限段1592 = ""; 字符串 符段1592 = "";
        如果 (拆限定名(调文本1592, 限段1592, 符段1592) == 1) {
            可选<整64> 符返查1592 = 查函数返回回退(整64(驻留(符段1592)));
            如果 (符返查1592.有值) { 返回 符返查1592; }
        }
        返回 无;
    }
    如果 (被调.类型 != 节点_成员) { 返回 无; }
    可选<整64> 对型查 = 解析节点类型ID(池, 整32(被调.子起点));
    如果 (!对型查.有值) { 返回 无; }
    整64 类IDc = 对型查.值;
    // 1526 实镜：对象类型经变量类型表到达为**指针形态**（JSON树*·类=指针槽
    //   模型）——类方法返回表键=剥星基名（JSON树）→ 原直查恒 miss。
    整64 类ID基c = 剥尾星基名(类IDc);
    可选<整64> 类返查 = 查类方法返回(类ID基c, 整64(被调.文本));
    如果 (类返查.有值) { 返回 类返查; }
    字符串 类名c = 字符串复制(驻留文本(类ID基c));
    如果 (是容器类(类名c)) {
        方法签名 签c;
        如果 (查方法签名(类名c, 驻留文本(整64(被调.文本)), 调.附加, &签c)) {
            字符串 返文c = 字符串复制(签c.返回文本);
            整64 长c1589 = 字符串长度(返文c);
            如果 (长c1589 != 0 &&
                (整64(返文c[整32(长c1589 - 1)]) & 255) == 38) {
                返文c = 字符串子串(返文c, 0, 整32(长c1589 - 1));
            }
            如果 (字符串长度(返文c) != 0) { 返回 某些(驻留(返文c)); }
        }
    }
    返回 无;
}

// 1589/1592：合成体单侧载荷类型文本（类型键须已归一 $ 形态）。
函数 合成体载荷类型文本(字符串 类型键, 布尔 取错误) -> 字符串 {
    字符串 成员名 = "值";
    如果 (取错误) { 成员名 = "错误"; }
    字符串 载荷 = 去类型空白(结果可选载荷374(类型键, 成员名));
    // 归一残留防御（同 合成体类型键：尖括号 '>' → '$'）
    当 (字符串长度(载荷) > 0 && (整64(载荷[整32(字符串长度(载荷) - 1)]) & 255) == 36) {
        载荷 = 字符串子串(载荷, 0, 整32(字符串长度(载荷) - 1));
    }
    返回 载荷;
}

// 1589/1592：载荷转换（源/目标载荷地址已按 结果值偏移 算好）：
//   同类型码=按码读+写（宽度/符号与装箱写/成员读同源）；异类型码=读源码 →
//   IR_类型转换（浮点面以 操作数2 传源码·整型面以类型字段为目标宽规范化）→
//   写目标码（窄写截断）。T_未知/T_整128/T_正128 异型=内部口径不一致显形。
不安全 函数 发射合成体载荷转换(整64 源载荷, 整64 目标载荷,
                          字符串 源载荷类型, 字符串 目标载荷类型,
                          函数IR& 函数信息, 整64* 寄存器计数) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    整64 源码 = 类型码(驻留(源载荷类型));
    整64 目标码 = 类型码(驻留(目标载荷类型));
    布尔 源浮 = (源码 == T_浮32 || 源码 == T_浮64);
    布尔 目标浮 = (目标码 == T_浮32 || 目标码 == T_浮64);
    布尔 源宽型 = (源码 == T_整128 || 源码 == T_正128);
    布尔 目标宽型 = (目标码 == T_整128 || 目标码 == T_正128);
    如果 (源码 == T_未知 || 目标码 == T_未知 || 源宽型 || 目标宽型) {
        // 1611（2026-10-25·1542 实锚）：**模板态载荷**（V/T/K 泛型参数名·
        //   克隆体语境类型推导漏替换面）非真异型——1592 守卫只拦具体类型间
        //   真异型非标量转换；模板态按守卫前原行为同型整块拷贝（结果载荷
        //   字节单点·字符串映射<V> 实例获取返回 结果<V,整32> 克隆生成实锚）。
        如果 (是泛型参数名(驻留(源载荷类型)) ||
            是泛型参数名(驻留(目标载荷类型))) {
            整64 字节1611 = 结果载荷字节(源载荷类型);
            IR追加(指令, 建IR指令(IR_结构体拷贝, 源载荷, 目标载荷, 0, 0,
                                 字节1611, 0));
            返回 真;
        }
        如果 (字符串比较(源载荷类型, 目标载荷类型)) {
            // 同型聚合/宽载荷：按载荷字节整拷（128=16 内联值、结构体=圆整、
            //   容器/类/指针/字符串=8——结果载荷字节 单点）
            整64 字节 = 结果载荷字节(源载荷类型);
            IR追加(指令, 建IR指令(IR_结构体拷贝, 源载荷, 目标载荷, 0, 0,
                                 字节, 0));
            返回 真;
        }
        IR层诊断("合成体载荷隐式转换不支持（非标量载荷）: " + 源载荷类型 +
                 " -> " + 目标载荷类型);
        返回 假;
    }
    如果 (源码 == 目标码 && !源浮) {
        整64 值reg同 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_指针加载, 源载荷, 0, 0, 值reg同, 源码, 0));
        IR追加(指令, 建IR指令(IR_指针存储, 目标载荷, 值reg同, 0, 0,
                             目标码, 0));
        返回 真;
    }
    整64 值reg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 源载荷, 0, 0, 值reg, 源码, 0));
    整64 源码传 = 0;
    如果 (源浮 || 目标浮) { 源码传 = 源码; }
    整64 转换reg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_类型转换, 值reg, 源码传, 0, 转换reg, 目标码, 0));
    IR追加(指令, 建IR指令(IR_指针存储, 目标载荷, 转换reg, 0, 0, 目标码, 0));
    返回 真;
}

// 1589/1592：合成体初值/赋值发射（源地址→目标地址）。返回 真=已发射
//   （同型整块拷贝或异型逐字段转换）；假=源类型无法解析/非合成体（已诊断，
//   调用方不得再补发射整块拷贝——禁静默错拷）。
不安全 函数 发射合成体初值拷贝(向量<节点> 池, 节点 右末, 整64 右索引,
                          整64 源地址, 整64 目标地址, 字符串 目标类型文本,
                          函数IR& 函数信息, 整64* 寄存器计数) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    字符串 目标键 = 合成体类型键(目标类型文本);
    整64 目标大 = 结果大小(目标类型文本);
    字符串 源类型文本 = 合成体源类型文本(池, 右末, 右索引);
    如果 (字符串长度(源类型文本) == 0) {
        // 内置构造器 正常/错误/某些 不在函数签名表（装箱构造按目标类型物化·
        //   产物即目标合成体类型）——源类型=目标类型（同型整块拷贝）；其余
        //   解析失败=真 miss（显形中止，禁静默按目标大小错拷）
        布尔 构造调用 = 假;
        如果 (右末.类型 == 节点_调用 && 右末.子起点 != 0) {
            节点 被调节 = 池.元素(整32(右末.子起点));
            如果 (被调节.类型 == 节点_标识符) {
                字符串 被调名 = 字符串复制(驻留文本(整64(被调节.文本)));
                如果 (字符串比较(被调名, "正常") || 字符串比较(被调名, "错误") ||
                    字符串比较(被调名, "某些")) {
                    构造调用 = 真;
                }
            }
        }
        如果 (构造调用) {
            源类型文本 = 目标类型文本;
        } 否则 如果 (右末.类型 == 节点_三元运算 &&
                    三元双分支构造调用1683(池, 右末)) {
            // #1683（2026-10-27）：声明初值=三元构造器（`果 = 选 ? 某些(11) :
            //   某些(22)`）——双分支=内置构造器调用（无签名表·类型由目标物化）
            //   → 合成体源类型文本 经 解析节点类型ID 三元递归（86-a）在构造
            //   调用处恒 miss → 「源类型无法解析」误中止（宿主 check/run 绿·
            //   存量）。三元求值=选中分支聚合地址透传（86-a·分支类型由目标
            //   同型物化）→ 源=目标同型整块拷贝。混入非构造分支=不豁免
            //   （落下方解析 miss 显形·禁静默）。
            // 静默豁免闭集穷举: 双构造分支按目标同型物化（构造器无签名=类型由目标决定·与上方构造调用豁免同规·语义层保证双分支与目标同型）
            源类型文本 = 目标类型文本;
        } 否则 {
            IR层诊断("合成体初值/赋值源类型无法解析: " + 目标类型文本);
            返回 假;
        }
    }
    字符串 源键 = 合成体类型键(源类型文本);
    如果 (是结果类型(源键) == 假) {
        // 源类型登记口径不可靠面（结果返回的**跨模块**函数：函数返回类型们 存
        //   声明.附加=类型节点池索引，文本落首实参「整64」——143 导入项实镜）
        //   → 按目标类型同型处理（=旧行为整块拷贝）；异型调用的可判定形态
        //   （主模块函数/类方法/容器方法）由上方解析覆盖。诚实边界：真异型且
        //   本口径 miss 时仍为旧整块拷贝（与修复前一致·非新增静默面）。
        // 静默豁免闭集穷举: 源类型登记口径不可靠面回退（跨模块返回类型表缺·旧行为整块拷贝·存量镜像·1589 注释自白在案）
        源类型文本 = 目标类型文本;
        源键 = 目标键;
    }
    布尔 目标可选 = 字符串比较(合成名基名(目标键), "可选");
    布尔 源可选 = 字符串比较(合成名基名(源键), "可选");
    字符串 源T = 合成体载荷类型文本(源键, 假);
    字符串 目标T = 合成体载荷类型文本(目标键, 假);
    字符串 源E = "";
    字符串 目标E = "";
    如果 (!源可选) { 源E = 合成体载荷类型文本(源键, 真); }
    如果 (!目标可选) { 目标E = 合成体载荷类型文本(目标键, 真); }
    // 等价（同型）：整块拷贝（原路径零开销）
    如果 (源可选 == 目标可选 && 字符串比较(源T, 目标T) &&
        (源可选 || 字符串比较(源E, 目标E))) {
        IR追加(指令, 建IR指令(IR_结构体拷贝, 源地址, 目标地址, 0, 0, 目标大, 0));
        返回 真;
    }
    // 逐字段转换：判别位@0（T_整32 4B·装箱写侧同宽）+ 载荷@8
    整64 标reg = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 源地址, 0, 0, 标reg, T_整32, 0));
    IR追加(指令, 建IR指令(IR_指针存储, 目标地址, 标reg, 0, 0, T_整32, 0));
    整64 源载荷 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 源地址, 0, 0, 源载荷, T_整64,
                          结果值偏移(源T)));
    整64 目标载荷 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_字段地址, 目标地址, 0, 0, 目标载荷, T_整64,
                          结果值偏移(目标T)));
    整64 正常块 = 新块(函数信息);
    整64 错误块 = 新块(函数信息);
    整64 汇合块 = 新块(函数信息);
    发射条件跳转(函数信息, 标reg, 正常块, 错误块);
    切换块(函数信息, 正常块);
    发射块标签(函数信息, 正常块);
    发射合成体载荷转换(源载荷, 目标载荷, 源T, 目标T, 函数信息, 寄存器计数);
    发射跳转(函数信息, 汇合块);
    切换块(函数信息, 错误块);
    发射块标签(函数信息, 错误块);
    如果 (!目标可选) {
        发射合成体载荷转换(源载荷, 目标载荷, 源E, 目标E, 函数信息, 寄存器计数);
    }
    发射跳转(函数信息, 汇合块);
    切换块(函数信息, 汇合块);
    发射块标签(函数信息, 汇合块);
    返回 真;
}

// 252（2026-10-07·#252·E2E 630 双测门禁）：数组整体赋值（乙 = 甲·类型[N] 同型）
//   值语义整块拷——001 §3.5 数组=值聚合（赋值拷贝语义·087 形参 rep movsb /
//   087b 声明位 IR_结构体拷贝 同口径）。源=数组名退化基址（94-a 指针变量表
//   登记 → 生成表达式 即基址·087b 源 reg 同源）；目标=局部/参数基址槽（94-a
//   登记 槽起+槽数-1）IR_取地址·引用形参槽=槽存地址 IR_加载。位拷语义=元素
//   字符串/类句柄共享（与 087 形参同·85-a 域双侧一致不扩战场）。守卫：右值
//   仅同型数组标识符（非标识符/异型/目标槽 0=静态与字段面 让位普通通道=
//   既有诊断面·双侧行为一致性探针挂观察）。
不安全 函数 生成数组整体赋值(向量<节点> 池, 节点 n, 整64 目标槽,
                        映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                        函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
                        向量<整64>& 表达式栈) -> 布尔 {
    整64 左名ID = 整64(n.文本);
    整64 左类型ID = 解析标识符类型ID(左名ID);
    如果 (左类型ID == 0) { 返回 假; }
    如果 (n.子终点 <= n.子起点) { 返回 假; }
    节点 右末 = 池.元素(整32(n.子终点 - 1));
    如果 (右末.类型 != 节点_标识符) { 返回 假; }
    // 同型守卫：类型节点 ID 相同（=同数组类型·比文本比较更强）
    整64 右类型ID = 解析标识符类型ID(整64(右末.文本));
    如果 (右类型ID != 左类型ID) { 返回 假; }
    // 自赋值（甲 = 甲）no-op——位拷自赋值恒无副作用（79-a 同判据）
    如果 (整64(右末.文本) == 左名ID) { 返回 真; }
    // 类型字节=元素步进×长度（类型大小与对齐 单点·宿主 typeSizeOf 同构）
    字符串 左类型文本 = 字符串复制(驻留文本(左类型ID));
    结果<整64, 整32> 步进查赋 = 数组元素步进(左类型文本);
    整64 字节数 = 0;
    如果 (步进查赋.正常) { 字节数 = 步进查赋.值 * 数组长度文本(左类型文本); } 否则 {
    }
    如果 (字节数 <= 0) { 返回 假; }
    // 源基址：数组名退化=元素指针（生成标识符加载=基址地址）
    整64 前深度252 = 表达式栈.大小();
    整64 源基址 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                              函数信息.指令, 寄存器计数, &函数信息.块计数,
                              槽计数, 表达式栈);
    当 (表达式栈.大小() > 前深度252) {
        结果<空类型, 整32> 删栈252 = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈252.正常) { 运行时错误(4); }
    }
    // 259（2026-10-07·#259 静态数组）：目标=**顶层静态数组**（目标槽 0·查静态
    //   序号命中+静态类型是数组）——目标基址=IR_静态地址（静态槽即数组本体·
    //   259 数据段按元素×长度分配；宿主 assignToGlobalStatic 259 同款）。
    如果 (目标槽 == 0) {
        结果<整64, 整32> 找静目259查 = 查静态序号含类(左名ID);
        // 静默豁免业务值: 静态表 miss=非静态目标·交回既有原路径（返假契约·1360 批5 结果化）
        如果 (!找静目259查.正常) { 返回 假; }
        整64 找静目259 = 找静目259查.值;
        如果 (!是数组类型文本(驻留文本(取静态类型(找静目259)))) { 返回 假; }
        整64 静基址259 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(函数信息.指令, 建IR指令(IR_静态地址, 0, 0, 0, 静基址259,
                                      T_整64, 找静目259));
        IR追加(函数信息.指令, 建IR指令(IR_结构体拷贝, 源基址, 静基址259, 0, 0,
                                      字节数, 0));
        返回 真;
    }
    // 目标基址：引用形参槽=槽存被引数组地址（IR_加载）；普通基址槽=IR_取地址
    整64 目标基址 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    如果 (槽是引用(目标槽)) {
        IR追加(函数信息.指令, 建IR指令(IR_加载, 目标槽, 0, 0, 目标基址,
                                      T_整64, 0));
    } 否则 {
        IR追加(函数信息.指令, 建IR指令(IR_取地址, 目标槽, 0, 0, 目标基址,
                                      T_整64, 0));
    }
    IR追加(函数信息.指令, 建IR指令(IR_结构体拷贝, 源基址, 目标基址, 0, 0,
                                  字节数, 0));
    返回 真;
}
