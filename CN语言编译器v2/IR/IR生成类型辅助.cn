// CN 自举编译器 v2：IR 生成类型辅助（436 轮冻结线拆分·自 IR生成类型.cn 机械
//   搬移·纯搬运零行为变更——309 类构造默认参数族与 263④ 类型宽度码段整段
//   迁入·静态表随族同迁=文件自洽；消费点经包内合并全局池解析零改动。
//   1737 任务轮：309 登记表族（默认数们/默认根们/默认区起们+登记/三查）
//   随体迁 IR默认参数.cn（同族聚合·本文件 992 行破线拆分·纯搬移零行为
//   变更）——查类构造放宽/补类构造默认实参 消费点经包内合并解析零改动）

导入 容器::向量;
导入 IR;         // IR常量 键位移（目录包名）

公开:


// 构造默认参数放宽查询（精确 miss 时扫更大段数的构造·宿主重载决议
//   「实参个数+可补全匹配」同构）：可补全=该段数构造存在且 默认数>0 且
//   实参数 ∈ [段数-默认数, 段数)。出参=选中构造段数；1541 B2 可选化：有值=
//   该段数构造参数串ID；无值=无可补全构造。多候选=歧义诊断（fail fast·宿主
//   ambiguous 同语义·诊断后同为无值）。
函数 查类构造放宽(整64 类名IDc, 整64 实参数c, 整64& 段数出c) -> 可选<整64> {
    段数出c = 0;
    整64 命中串c = 0;
    整64 命中数c = 0;
    整64 m = 实参数c;
    当 (m < 64) {
        m++;
        整64 串m = 0;
        // 1541 B2：无值=该段数无构造（原 ==0 判据）→ 继续
        可选<整64> 串查m = 查类构造参数串(类名IDc, m);
        如果 (!串查m.有值) { 继续; }
        // 上行无值已继续；此处 0 仅占位（不可达·既有未命中语义）
        如果 (串查m.有值) { 串m = 串查m.值; }
        整64 默m = 查类构造默认数(类名IDc, m);
        如果 (默m > 0 && 实参数c >= m - 默m) {
            命中串c = 串m;
            段数出c = m;
            命中数c++;
        }
    }
    如果 (命中数c > 1) {
        IR层诊断("类构造重载决议歧义（默认参数可补全候选 " +
                 整数转字符串(命中数c) + " 个）: " + 驻留文本(类名IDc));
        返回 无;
    }
    如果 (命中串c == 0) { 返回 无; }
    返回 某些(命中串c);
}

// ==================== 类型宽度码（263④ 轮自 IR布局.cn 机械搬移·纯搬运零行为
//   变更——超标冻结文件腾行·263① 生成语句辅助 同款） ====================
// 按字段类型文本返回 指针加载/存储 宽度标注（T_* 码）。窄宽码 T_整8/T_整16/
//   T_字符 由 IR生成 定义（纯名引用——合并后全局可见，同 IR追加 先例）；
//   其余（整64/字符串/指针/嵌套结构体）默认 8 字节。
// 46-f（2026-09-10 第五十轮）：正32 独立码 T_正32——字段 4 字节读回零扩展
//   （movzx/ldr w32）而非符号扩展（movsxd）：4000000000 位模式读回须=原值。
函数 类型宽度码(字符串 类型文本) -> 整64 {
    // 94-a：数组类型——读/写宽度按**元素类型**（宿主 mapType(数组)=mapType(元素)
    //   同构；数组元素 p[i] 的加载/存储宽度即元素宽度）
    如果 (是数组类型文本(类型文本)) {
        可选<字符串> 元素w查 = 数组元素文本(类型文本);
        字符串 元素w = "";
        如果 (元素w查.有值) { 元素w = 字符串复制(元素w查.值); }
        如果 (字符串长度(元素w) > 0) { 返回 类型宽度码(元素w); }
    }
    如果 (字符串比较(类型文本, "布尔")) { 返回 T_布尔; }
    如果 (字符串比较(类型文本, "字符")) { 返回 T_字符; }
    // 347-a（T33 残余根治·同族旁路穷尽）：原「整8/正8 归并 T_整8」「整16/正16
    //   归并 T_整16」**丢失符号性** → 结构体字段/数组元素/指针解引用路径的无符号
    //   窄类型被当有符号读（探针 p24：正8 字段 200 读回 -56；正16 60000 读回 -5536）；
    //   反向：整8/整16 负值被零扩展（p23：-426 读回 65110）。拆分为独立码——
    //   三后端已完整支持 T_正8/T_正16 零扩展语义（2026-09-04 收口设施·
    //   转换/装载面分派齐备），指针加载/存储分派本轮补齐。
    如果 (字符串比较(类型文本, "整8")) { 返回 T_整8; }
    如果 (字符串比较(类型文本, "正8")) { 返回 T_正8; }
    如果 (字符串比较(类型文本, "整16")) { 返回 T_整16; }
    如果 (字符串比较(类型文本, "正16")) { 返回 T_正16; }
    如果 (字符串比较(类型文本, "正32")) { 返回 T_正32; }
    如果 (字符串比较(类型文本, "整32")) { 返回 T_整32; }
    // 1033（857 同族·读写宽度消费点根治·与 IR布局.类型大小与对齐 4/4 配套）：
    //   浮32→T_浮32（4 字节读写·449 已备三后端 IR_指针加载/存储 dword 分派与
    //   引用参数存储码同档·宿主 LoadPtr/StorePtr f32 movss 4 字节同宽）——原
    //   miss 落尾部 T_整64（8 字节）：结构体/类浮32 字段/浮32 数组元素/解引用
    //   读写恒宽 8 字节，与布局 4/4 修正后的偏移步进耦合=过写 4 字节踩相邻字段/
    //   元素。装载面协同：读 mov eax 读位模式清高 32（消费侧 movss 取低 32 位·
    //   8 字节标量槽模型下 f32 值在低位·449 读侧先例）；写 dword 位模式截断。
    如果 (字符串比较(类型文本, "浮32")) { 返回 T_浮32; }
    // 263④（021 任务 263·探针 646 实证）：128 位标量宽度码——成员字段写
    //   （生成语句赋值 存储宽度 命中 545 双半写通道·自带拆半零发射层依赖）与
    //   下标/解引用宽度分派消费。读侧字段 128 由 生成表达式字段 810 地址语义
    //   通道（成员值码 拦截）先行返回不经本码装载。
    如果 (字符串比较(类型文本, "整128")) { 返回 T_整128; }
    如果 (字符串比较(类型文本, "正128")) { 返回 T_正128; }
    // 279：枚举类型字段/元素=T_整32（4 字节读写·布局 4/4 配套——C 枚举=int）
    如果 (是枚举名(驻留(类型文本))) { 返回 T_整32; }
    // 990（008 挂账·094 空安全语义）：字符串字段 加载类型=T_字符串——codegen
    //   对 T_字符串 的指针加载**跳过判空**（0 句柄=空串·运行时串函数已容错
    //   __cn_str_len(0)=0/__cn_str_eq 容错——宽度仍 8 字节句柄·与 T_整64 等宽
    //   零行为差异面=仅判空豁免）
    如果 (字符串比较(类型文本, "字符串")) { 返回 T_字符串; }
    // 648 归档（豁免边界声明）：终态 T_整64=8 字节合法主路径（函数头契约
    //   「整64/字符串/指针/嵌套结构体默认 8 字节」）；泛型模板结构体名常态
    //   到达（词条 等单态化前无布局·L2 127 实证——首记 648 曾登记后回撤），
    //   兜底=单态化前定义期占位，实例化产物经单态化重编走精确宽度。
    返回 T_整64;
}

// ==================== 方法调用对象类型解析族（537 轮自 IR生成类型.cn 机械
//   搬移·纯搬运零行为变更——本文件 940 行超 900 警戒线腾行（309/263④ 同款
//   先例）；搬移后 解析方法对象类型扩展 补 537 单目重载分支） ====================
// 方法调用对象类型解析（表.追加 / b.表.追加 / 元素(0).设置 / 词池.元素(0).表.大小）：
//   经 解析节点类型ID 推导对象类型——容器直用；结构体则查方法名对应字段的容器类型。
// 返回容器合成类名ID；1541 B2 可选化：有值=容器类名ID（恒 >0）；无值=未知。
函数 解析方法对象类型(向量<节点> 池, 整32 调用索引) -> 可选<整64> {
    节点 调用节点 = 池.元素(调用索引);
    如果 (调用节点.类型 != 节点_调用 || 调用节点.子起点 <= 0) { 返回 无; }
    节点 被调成员 = 池.元素(整32(调用节点.子起点));
    如果 (被调成员.类型 != 节点_成员) { 返回 无; }
    // 381 第二层：字段类型表存真类型（带星）后指针字段接收者剥尾星取基名
    //   （接收者=所指对象·自动解引用；带星判 是容器类/是用户类 假=分派丢失）。
    整64 对象类型ID = 0;
    可选<整64> 对象类型查p = 解析节点类型ID(池, 整32(被调成员.子起点));
    如果 (对象类型查p.有值) { 对象类型ID = 剥尾星基名(对象类型查p.值); }
    // #751 P1-1/P0：再导出限定类型名归一基名（非再导出限定名=不归一·原类型保留）
    结果<整64, 整32> 归751 = 类型基名归一751(对象类型ID);
    如果 (归751.正常) { 对象类型ID = 归751.值; } 否则 {
    }
    如果 (对象类型ID != 0) {
        如果 (是容器类(驻留文本(对象类型ID))) { 返回 某些(对象类型ID); }
        如果 (是结构体大小非零(对象类型ID)) {
            可选<整64> 字段类型查p = 查字段类型ID(对象类型ID, 整64(被调成员.文本));
            如果 (字段类型查p.有值) {
                整64 字段类型ID = 字段类型查p.值;
                如果 (是容器类(驻留文本(字段类型ID))) { 返回 某些(字段类型ID); }
            }
        }
    }
    返回 无;
}

// 方法调用对象类型解析·扩展版（第七十八轮，2026-09-12）：与 解析方法对象类型
//   同构，但对象类型不限于容器类——用户类对象同样返回（生成方法调用 的用户类
//   分派依据）。容器消费点（解析调用返回容器 等）保持用容器专版，行为不变。
//   1541 B2 可选化：有值=对象类名ID（恒 >0）；无值=未知。
函数 解析方法对象类型扩展(向量<节点> 池, 整32 调用索引) -> 可选<整64> {
    节点 调用节点 = 池.元素(调用索引);
    如果 (调用节点.类型 != 节点_调用 || 调用节点.子起点 <= 0) { 返回 无; }
    节点 被调成员 = 池.元素(整32(调用节点.子起点));
    如果 (被调成员.类型 != 节点_成员) { 返回 无; }
    // 328（2026-10-09·002·21）：父类限定（方法体上下文·C++ Base::method 同款）
    //   ——对象位标识符「父类」→返回基类名ID：方法表/定义类 walk-up 按基类
    //   解析=直调基类实现符号（发射侧 虚槽强制静态·328 尾参配套）
    如果 (当前方法类名ID != 0) {
        节点 对象位p = 池.元素(整32(被调成员.子起点));
        如果 (对象位p.类型 == 节点_标识符 &&
             字符串比较(驻留文本(整64(对象位p.文本)), "父类")) {
            可选<整64> 基查p = 查类基名(当前方法类名ID);
            如果 (基查p.有值) {
                整64 基名IDp = 0;
                如果 (基查p.有值) { 基名IDp = 基查p.值; }
                返回 某些(基名IDp);
            }
        }
    }
    // 381 第二层：同上出口剥尾星（指针字段接收者自动解引用·带星=分派丢失）。
    整64 对象类型ID = 0;
    可选<整64> 对象类型查x = 解析节点类型ID(池, 整32(被调成员.子起点));
    如果 (对象类型查x.有值) { 对象类型ID = 剥尾星基名(对象类型查x.值); }
    // #751 P1-1/P0：再导出限定类型名归一基名（非再导出限定名=不归一·原类型保留）
    结果<整64, 整32> 归751 = 类型基名归一751(对象类型ID);
    如果 (归751.正常) { 对象类型ID = 归751.值; } 否则 {
    }
    // 537（2026-10-13）：单目重载结果对象作方法调用接收者（(-点(5)).取()——
    //   对象位=单目表达式形态（负号/逻辑非/位非））——经 解析单目重载结果类型ID
    //   推导重载结果类型（507 判定收口·宿主 exprSrcType UnaryExpr 同构；原
    //   miss=类名空 →「方法调用对象类型未解析」诊断终止）。
    如果 (对象类型ID == 0) {
        可选<整64> 单目ID查x = 解析单目重载结果类型ID(池, 整32(被调成员.子起点));
        如果 (单目ID查x.有值) { 对象类型ID = 剥尾星基名(单目ID查x.值); }
    }
    如果 (对象类型ID != 0) {
        字符串 对象文本x = 字符串复制(驻留文本(对象类型ID));
        // 413：接口类型对象出口（接口变量/接口参数——生成方法调用 接口分派依据）
        如果 (是容器类(对象文本x) || 是用户类(对象文本x) || 是接口名(对象文本x)) {
            返回 某些(对象类型ID);
        }
        如果 (是结构体大小非零(对象类型ID)) {
            可选<整64> 字段类型查x = 查字段类型ID(对象类型ID, 整64(被调成员.文本));
            如果 (字段类型查x.有值) {
                整64 字段类型IDx = 字段类型查x.值;
                字符串 字段文本x = 字符串复制(驻留文本(字段类型IDx));
                如果 (是容器类(字段文本x) || 是用户类(字段文本x)) {
                    返回 某些(字段类型IDx);
                }
            }
        }
    }
    返回 无;
}

// ==================== 309：类构造默认参数补缺（655 自 生成函数.cn 机械搬移·
//   冻结线拆分：该文件 1009 行破冻结线·同族聚合=查类构造三查同文件·
//   纯搬移零逻辑变更——648 ir_call_args.cpp 拆分同款） ====================
// 309（2026-10-09）：类构造默认参数补缺（377/568·宿主 emitCtorInvoke D23
//   语义层选中+IR 层补全 同构）——被调=类名ID 且 精确段数构造 miss 且
//   查类构造放宽 命中时，缺段根（查类构造默认根）在调用点上下文升序求值
//   （宿主 defaults 收集序同构）后按声明序倒序头插 弹出们（倒序表语义·
//   补默认参数实参 309 合弹修正同款）。非类名/精确命中/放宽 miss/根登记缺
//   四态零介入（后续路径按原语义走）。返回无值——补缺结果体现在 弹出们。
不安全 函数 补类构造默认实参(向量<节点> 池, 节点 n, 向量<整64>& 弹出们,
                     整64 类名IDx, 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                     向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数,
                     整64* 槽计数, 向量<整64>& 表达式栈) -> 空类型 {
    整64 实参数x = 整64(n.附加);
    如果 (弹出们.大小() != 实参数x) { 返回; }   // 异常形态不介入
    // 1541 B2：有值=精确段数构造命中（原 !=0 判据）
    可选<整64> 精确查x = 查类构造参数串(类名IDx, 实参数x);
    如果 (精确查x.有值) { 返回; }   // 精确命中零介入
    整64 段数x = 0;
    可选<整64> 放宽查x = 查类构造放宽(类名IDx, 实参数x, 段数x);
    如果 (!放宽查x.有值) { 返回; }   // 无可补全构造
    向量<整64> 补弹x;
    整64 ox = 实参数x;
    当 (ox < 段数x) {
        可选<整64> 根查x = 查类构造默认根(类名IDx, 段数x, ox);
        // 655 实证归档（648 余量⑤·「诊断由下游发」注释属实性核验）：
        //   本返回路径的下游诊断真实存在且为终态拦截——补缺静默返回后
        //   弹出们 保持原实参数，生成转换或构造调用 → 发射用户类构造
        //   （生成类中.cn）按**原实参数**查 构造串ID=0 → 走「用户类无构造器」
        //   或「构造调用实参数不匹配（期望 N 个）」IR层诊断 + 运行时错误(6)
        //   （278 分支守卫后=真不可匹配形态必达）。且本 miss 本身为内部
        //   不一致态：放宽命中前提=该段数 默认数>0 已登记（默认数们/默认根们
        //   同循环登记·查类构造放宽 段数域与 默认根们 键公式一致）——正常
        //   源码不可达，可达即登记面缺陷，下游诊断=正确的 fail fast。
        如果 (!根查x.有值) { 返回; }   // 登记缺=保守回退原路径（诊断由下游发）
        整64 根x = 0;
        如果 (根查x.有值) { 根x = 根查x.值; }
        // 1737（任务 1737·2026-10-27）：求值区间=[区起, 根+1) **全区间**——
        //   与 补默认参数实参（生成函数.cn）同病同修：根=表达式末节点（后缀
        //   池布局），多节点默认表达式只求值根节点 → 操作数槽=寄存器计数初始
        //   0 → [992守卫] 中止。区起 miss 退单节点区间=原行为逐字保留。
        整64 区起x = 根x;
        可选<整64> 区起查x = 查类构造默认区起(类名IDx, 段数x, ox);
        如果 (区起查x.有值 && 区起查x.值 <= 根x) { 区起x = 区起查x.值; }
        生成表达式(池, 整32(区起x), 整32(根x + 1), 局部槽, 参数槽, 指令,
                   寄存器计数, 块计数, 槽计数, 表达式栈);
        结果<空类型, 整32> 加补x = 补弹x.追加(表达式栈.元素(表达式栈.大小() - 1));
        如果 (!加补x.正常) { 运行时错误(4); }
        结果<空类型, 整32> 删栈x = 表达式栈.删除(表达式栈.大小() - 1);
        如果 (!删栈x.正常) { 运行时错误(4); }
        ox++;
    }
    向量<整64> 合弹x;
    整64 ix = 补弹x.大小();
    当 (ix > 0) {
        ix--;
        结果<空类型, 整32> 加合x = 合弹x.追加(补弹x.元素(ix));
        如果 (!加合x.正常) { 运行时错误(4); }
    }
    ix = 0;
    当 (ix < 弹出们.大小()) {
        结果<空类型, 整32> 加原x = 合弹x.追加(弹出们.元素(ix));
        如果 (!加原x.正常) { 运行时错误(4); }
        ix++;
    }
    弹出们 = 合弹x;
}

// ==================== 813（2026-10-16）：解引用/自增 所指类型推导 ====================
// 宿主 pointerPointeeSrcType（ir.cpp:341）同构单点：成员链指针解引用读（*b.游标）/
//   解引用写（*b.游标 = v）/指针字段自增步进（b.游标++）共用。修前 生成一元运算
//   解引用分支只认 首节点标识符——成员链操作数恒兜底 T_整64 8 字节宽读写（探针
//   992b 实锤 *b.游标=38654705672=池[1]|池[2] 两字段拼接宽读；自增成员链步进恒 1·
//   宿主 ptrElemStride=所指元素宽）。655 设计注记：解引用子区间操作数取**末节点**
//   （子终点-1）——成员链尾=字段节点；单节点操作数（*p）末节点=首节点=同现行。
// 分支对齐宿主：标识符（指针变量表）/成员链（598 统一入口+字段类型表 321 真类型）/
//   二元加减（指针算术 *(p+1)·递归左右）/取地址·解引用（递归操作数）。
// 返回所指/元素类型名ID；1541 B2 可选化：有值=所指/元素类型名ID（恒 >0）；
//   无值=未解析（消费点 648 显形——登记内部未登记+兜底保留=
//   中止前路径控制流零变更·静默整64 兜底废除）。
// #1480：剥星改「**恰好一层**」（宿主 types::pointeeOf 逐层同构·原 剥尾星基名
//   剥**全部**尾星）：类型表值域两类——①带星真类型文本（字段类型 321 规范化/
//   调用返回/借用视图合成名「字符*」）=剥一层即所指；②指针变量表已剥基名
//   （星层另存 指针变量层数们）=按 层数 补回 (层数-1) 个星=剩余指针层。
//   宿主 pointeeOf("整32**")="整32*"——原全剥对多级指针按基类型窄宽读/写
//   （整32** 的 *p 4 字节、字符** 的 *p 靠 字符 豁免碰巧 8 字节），#1480 同轮
//   对齐为剩余层文本（消费点宽度码/结构体键各自按文本分派）。
函数 剥层取所指(整64 类型名ID, 整64 指针层数) -> 可选<整64> {
    字符串 类型文本 = 字符串复制(驻留文本(类型名ID));
    // 数组类型（整32[3] 等）——下标/解引用消费=元素类型（宿主 arrayElemOf·
    //   425 数组名退化同源）
    如果 (是数组类型文本(类型文本)) {
        可选<字符串> 元素查 = 数组元素文本(类型文本);
        字符串 元素文 = "";
        如果 (元素查.有值) { 元素文 = 字符串复制(元素查.值); }
        如果 (字符串长度(元素文) == 0) { 返回 无; }
        整64 元素名ID = 驻留(元素文);
        如果 (元素名ID == 0) { 返回 无; }
        返回 某些(元素名ID);
    }
    // 剥**恰好一层**尾星：先数尾星（循环头），基名=去掉全部尾星，再把
    //   (尾星数-1) 层补回——净效果=少剥一层（多剥=丢剩余指针层；"*" 单字符
    //   不构成类型名=基名为空→无值）。
    整64 尾星数 = 0;
    整64 尾查位 = 字符串长度(类型文本);
    当 (尾查位 > 0 && (整64(类型文本[整32(尾查位 - 1)]) & 255) == 42) {
        尾星数++;
        尾查位--;
    }
    类型文本 = 字符串复制(字符串子串(类型文本, 0, 整32(尾查位)));
    如果 (字符串长度(类型文本) == 0) { 返回 无; }
    // 剩余层=(尾星数-1)+(指针层数-1)：带星文本域 指针层数 恒 1（剥掉即所指），
    //   指针变量表域 尾星数=0（星层在 指针层数）
    整64 余层数 = 指针层数 - 1;
    如果 (尾星数 != 0) { 余层数 = 余层数 + 尾星数 - 1; }
    当 (余层数 > 0) {
        类型文本 = 类型文本 + "*";
        余层数--;
    }
    整64 所指名ID = 驻留(类型文本);
    如果 (所指名ID == 0) { 返回 无; }
    返回 某些(所指名ID);
}

// 标识符所指类型（813 标识符分支单点·#1480 抽出守函数体量）：指针变量表 →
//   数组名退化 → A2 借用视图回退；无值=未解析（消费点 813 显形）。
//   ① 指针变量表命中（附加>=1 登记）：值=已剥基名、层数=指针变量层数们——
//     数组名退化（94-a）所指=元素类型本体原样（宿主 arrayElemOf 同构）；
//     真指针剥一层并补回剩余层（多级指针 整32** 的 *p=整32*）。
//   ② 表 miss 且声明类型文本**带尾星**（A2 借用视图：`字符*` 由解析层合成类型名
//      「字符*」且指针层=0·261 C1——不入指针变量表）：剥一层即所指（宿主
//      lookupSrcType→pointeeOf 同构）。无星声明=非指针变量（`*非指针` 上游语义层
//      已拒），返回无值交 813 显形，绝不静默把标量当指针。
函数 解析变量所指类型(节点 变量节点) -> 可选<整64> {
    整64 变量名ID = 整64(变量节点.文本);
    可选<整64> 指针查 = 查指针变量类型(变量名ID);
    如果 (指针查.有值) {
        整64 指针基名 = 指针查.值;
        // 615 层数表（与类型表由 登记指针变量类型 三参单点成对写入）——类型命中
        //   而层数缺失=表不变量失守（真内部缺陷）：显形登记，不静默按单层兜底。
        可选<整64> 层数查 = 查指针变量层数(变量名ID);
        如果 (!层数查.有值) {
            登记内部未登记("指针变量层数", 字符串复制(驻留文本(变量名ID)), 0);
            返回 无;
        }
        整64 层数值 = 层数查.值;
        // 94-a 数组名退化：数组局部/数组形参登记值=元素类型本体（生成声明尾 573 /
        //   生成函数 626）——所指=元素类型原样，不剥星不补星（原全剥对 整32*[3]
        //   的元素指针按 整32 4 字节读/字符*[2] 的元素视图丢一层星）。
        可选<整64> 声明类型查 = 查当前函数变量类型(变量名ID);
        如果 (声明类型查.有值) {
            整64 声明类型值 = 声明类型查.值;
            如果 (声明类型值 != 0 &&
                是数组类型文本(字符串复制(驻留文本(声明类型值)))) {
                返回 某些(指针基名);
            }
        }
        返回 剥层取所指(指针基名, 层数值);
    }
    可选<整64> 视图声明查 = 查当前函数变量类型(变量名ID);
    如果 (!视图声明查.有值) { 返回 无; }
    整64 视图声明值 = 视图声明查.值;
    如果 (视图声明值 == 0) { 返回 无; }
    字符串 视图声明文 = 字符串复制(驻留文本(视图声明值));
    整64 视图声明长 = 字符串长度(视图声明文);
    如果 (视图声明长 == 0) { 返回 无; }
    如果 ((整64(视图声明文[整32(视图声明长 - 1)]) & 255) != 42) { 返回 无; }
    返回 剥层取所指(视图声明值, 1);
}

// 成员链字段真类型（带星不剥·指针步进判定面用）；1541 B2 可选化：有值=
//   字段真类型名ID（恒 >0）；无值=未解析（消费点 648 显形）
函数 解析成员链字段类型813(向量<节点> 池, 整32 成员索引) -> 可选<整64> {
    如果 (成员索引 <= 0) { 返回 无; }
    节点 n813f = 池.元素(成员索引);
    如果 (n813f.类型 != 节点_成员 || n813f.子起点 <= 0) { 返回 无; }
    可选<整64> 对象结构查813f = 解析成员链结构体ID(池, 整32(n813f.子起点));
    如果 (!对象结构查813f.有值) { 返回 无; }
    整64 对象结构813f = 0;
    如果 (对象结构查813f.有值) { 对象结构813f = 对象结构查813f.值; }
    可选<整64> 字段类型查813f = 查字段类型ID(对象结构813f, 整64(n813f.文本));
    如果 (!字段类型查813f.有值) { 返回 无; }
    整64 字段类型813f = 字段类型查813f.值;
    返回 某些(字段类型813f);
}

// 1541 B2 可选化：有值=所指类型名ID（恒 >0）；无值=未解析。
函数 解析所指类型813(向量<节点> 池, 整32 节点索引) -> 可选<整64> {
    如果 (节点索引 <= 0) { 返回 无; }
    节点 当前节点 = 池.元素(节点索引);
    // 标识符：指针变量类型们（键=名ID·值=所指类型名ID）+ A2 借用视图回退
    如果 (当前节点.类型 == 节点_标识符) {
        返回 解析变量所指类型(当前节点);
    }
    // 成员链（b.游标 / 嵌套 b.q.游标）：解析成员链结构体ID（598 统一入口·
    //   含指针中间跳剥星）→ 查字段类型ID（带星真类型·键基域幂等）
    如果 (当前节点.类型 == 节点_成员) {
        可选<整64> 字段查813 = 解析成员链字段类型813(池, 节点索引);
        如果 (!字段查813.有值) { 返回 无; }
        整64 字段类型813 = 字段查813.值;
        返回 剥层取所指(字段类型813, 1);
    }
    // 调用返回指针（*容器.元素(0) / *造指针()——144_v2 云端红归因根治）：
    //   返回类型经 解析调用返回类型ID（1014 无守卫版：标识符被调=查函数返回
    //   回退/容器方法=查方法签名/用户类方法=查类方法返回）→ 所指基型剥星。
    //   修前（813 首版）无调用分支→显形中止（退出码 1）——更前 v2 兜底 T_整64
    //   对 整64* 返回**碰巧宽度正确**（144 群④ 实证）；宿主 pointerPointee
    //   SrcType 同轮补 CallExpr 分支（exprSrcType CallExpr 分支对称）零分叉。
    如果 (当前节点.类型 == 节点_调用) {
        可选<整64> 返回类型查813 = 解析调用返回类型ID(池, 节点索引);
        如果 (!返回类型查813.有值) { 返回 无; }
        整64 返回类型813 = 返回类型查813.值;
        返回 剥层取所指(返回类型813, 1);
    }
    // 指针算术 *(p+1) / *(1+p)：递归左右取先命中侧（宿主 BinaryExpr Add/Subtract
    //   同构——左 miss 递归右）。普通二元节点域（解析表达式中:343）：子起点=左
    //   操作数起点、附加=右操作数起点、**子终点恒 0**（与短路区分）——池序=左
    //   节点们+右节点们+本节点，故右操作数末节点=本节点索引-1（子终点-1 落
    //   0 哨兵恒 miss·613 三形态红实录）。
    如果 (当前节点.类型 == 节点_二元运算) {
        字符串 运算符文本 = 字符串复制(驻留文本(整64(当前节点.文本)));
        // 左末锚=附加-1：池序恒=左操作数节点们+右操作数节点们+本节点——右末=
        //   本节点索引-1、右起=附加（解析层建节点约定）→左末=附加-1。子起点
        //   （左起点链）经括号递归实证错位（*(p+0) 调试：子起点=附加=10 而 p
        //   实际在 9·左起点参数链括号层多计 1——不可靠故不取）。
        如果 (字符串比较(运算符文本, "+") || 字符串比较(运算符文本, "-")) {
            可选<整64> 左所指查 = 解析所指类型813(池, 整32(当前节点.附加 - 1));
            如果 (左所指查.有值) {
                整64 左所指ID = 左所指查.值;
                返回 某些(左所指ID);
            }
            返回 解析所指类型813(池, 整32(节点索引 - 1));
        }
        返回 无;
    }
    // &x / *x 一元递归（宿主 UnaryExpr AddressOf/Deref 同构——子起点=操作数）
    如果 (当前节点.类型 == 节点_取地址 || 当前节点.类型 == 节点_解引用) {
        返回 解析所指类型813(池, 整32(当前节点.子起点));
    }
    返回 无;
}

// 解引用操作数所指宽度码（读/写/自增三消费点共用单点·事不过三提炼）：
//   末节点推导（子终点-1·655 设计注记）+字符字节视图（所指=字符 时单字节·
//   #1480）+类型宽度码。未解析=登记内部未登记（648/813 显形）后返回
//   T_整64 兜底（中止前路径控制流零变更——收尾守卫统一中止不产 asm）。
函数 解引用所指宽度码813(向量<节点> 池, 节点 解引用节点) -> 整64 {
    如果 (解引用节点.子终点 > 解引用节点.子起点) {
        节点 操作数节点 = 池.元素(整32(解引用节点.子终点 - 1));
        可选<整64> 所指查得 = 解析所指类型813(池, 整32(解引用节点.子终点 - 1));
        如果 (所指查得.有值) {
            整64 所指类型ID = 所指查得.值;
            如果 (字符串比较(驻留文本(所指类型ID), "字符")) {
                // #1480（A2 修订·D30 字节视图同族）：字符 标量本身=4 字节
                //   Unicode 标量值，但 所指=字符 的**唯一**来源=字符* 借用视图
                //   （261 C1：视图指向 UTF-8 字节流）——视图解引用=**单字节
                //   有符号**读/写（plans/001「字符串[i] 结果类型 整8（带符号
                //   字节值）」字节视图口径同源；宿主 pointeeIRTypeOverride
                //   单点同映射）。
                //   原豁免返回 T_字符串=8 字节指针宽读（「整串句柄非单字符」
                //   旧口径）——"hi" 解引用读出池[0..7] 打包值（宿主同族 4 字节
                //   打包读=30817·D30 类，双侧同轮按字节修正零分叉）。
                //   字符** 的 *p（所指=字符* 视图）经 剥层取所指 层数补星落
                //   类型宽度码("字符*")=T_字符串 8 字节，不达本分支。
                返回 T_整8;
            }
            返回 类型宽度码(字符串复制(驻留文本(所指类型ID)));
        }
        登记内部未登记("解引用所指类型",
                       字符串复制(驻留文本(整64(操作数节点.文本))), 0);
    } 否则 {
        登记内部未登记("解引用所指类型", "<空操作数>", 0);
    }
    返回 T_整64;
}


// ==================== 933：引用返回字符串调用判定（值接收/赋值位/返回位
//   深拷落堆共用单点·任务 933 双侧零分叉） ====================
// 判定=调用节点被调者返回类型**尾 '&'**（引用返回）且剥 '&' 后=「字符串」。
//   来源分派：被调=标识符（自由函数，键基回退 查函数返回回退——72-a 跨模块
//   契约同款）；被调=成员（用户类方法，对象类型经 解析方法对象类型扩展 +
//   定义类 walk-up（279）后 查类方法返回）。
//   诚实边界（不静默面声明）：容器内置方法（元素引用 等——无池节点方法表，
//   签名表在语义层）与其他形态=返回假（不经本通道→保持既有污染/借用路径，
//   非静默默认值：判据语义=「是否触达 933 深拷面」的形态判定，miss=不适用
//   本通道，与 632/948 形态判定同族）；静态方法面（类名.静态方法）同理。
函数 是引用返回字符串调用933(向量<节点> 池, 整32 调用索引) -> 布尔 {
    如果 (调用索引 < 0 || 调用索引 >= 整32(池.大小())) { 返回 假; }
    节点 调用933 = 池.元素(调用索引);
    如果 (调用933.类型 != 节点_调用 || 调用933.子起点 <= 0) { 返回 假; }
    节点 被调933 = 池.元素(整32(调用933.子起点));
    字符串 返回文933 = "";
    如果 (被调933.类型 == 节点_标识符) {
        可选<整64> 返IDf933查 = 查函数返回回退(整64(被调933.文本));
        // 1541 B2：无值=返回类型未知（原 !=0 判据等价）
        如果 (返IDf933查.有值) {
            整64 返IDf933 = 返IDf933查.值;
            返回文933 = 字符串复制(驻留文本(返IDf933));
        }
    } 否则 如果 (被调933.类型 == 节点_成员) {
        可选<整64> 类查933 = 解析方法对象类型扩展(池, 调用索引);
        如果 (类查933.有值) {
            整64 类ID933 = 0;
            如果 (类查933.有值) { 类ID933 = 类查933.值; }
            整64 定义933 = 类ID933;
            可选<整64> 定义查933 = 查类方法定义层(类ID933, 整64(被调933.文本));
            如果 (定义查933.有值) { 定义933 = 定义查933.值; }
            // 1541 B2：无值=无此方法（原 !=0 判据）
            可选<整64> 返IDm查933 = 查类方法返回(定义933, 整64(被调933.文本));
            如果 (返IDm查933.有值) { 返回文933 = 字符串复制(驻留文本(返IDm查933.值)); }
        }
    }
    如果 (字符串长度(返回文933) == 0) { 返回 假; }
    如果 (((整64(返回文933[字符串长度(返回文933) - 1]) & 255) != 38)) { 返回 假; }
    返回 字符串比较(字符串子串(返回文933, 0, 字符串长度(返回文933) - 1),
                     "字符串");
}

// 1175（泛型实例指针三形态·根因 c）：**泛型角括号类型文本 -> 实例合成名（$）**。
//   泛型类克隆体的字段类型单态化=文本替换（`节点<T>*` --T=整32--> `节点<整32>*`），
//   而实例身份/实例布局登记键=解析类型文本 的合成形态 `节点$整32`——两文本域在
//   成员链类型解析处不互通：尾星剥星后 查结构体类型(节点<整32>) 恒 miss →
//   多级链/宽载荷链「成员字段偏移未知」/显式解引用链偏移未知。本函数只做
//   **miss 兜底**的文本归一（与 解析类型文本 合成规则逐字一致：'<'/',' → '$'、
//   去 '>'），命中面零改动。无 '<' 返回 0=非泛型形态（调用方保持原 miss 行为，
//   不静默造名——miss 不可静默：归一后仍 miss 由各消费点既有诊断显形）。
//   性能：仅 miss 路径调用，类型文本短于 64 字节（无额外 IR 指令/临时槽）。
函数 泛型角括号归一1175(整64 类型名ID) -> 整64 {
    如果 (类型名ID == 0) { 返回 0; }
    字符串 文本1175 = 字符串复制(驻留文本(类型名ID));
    整64 长1175 = 字符串长度(文本1175);
    布尔 有角1175 = 假;
    字符串 出1175 = "";
    整64 i1175 = 0;
    当 (i1175 < 长1175) {
        整64 码1175 = 整64(文本1175[整32(i1175)]) & 255;
        // else 新规（AGENTS §3）：逐字节映射用互斥正条件分支，不用 else 兜底
        //   业务赋值（'<'/',' -> '$'；'>'/空白丢弃；其余原样追加）。
        如果 (码1175 == 60) {
            出1175 = 出1175 + "$";
            有角1175 = 真;
        }
        如果 (码1175 == 44) {
            出1175 = 出1175 + "$";
        }
        布尔 原样1175 = 码1175 != 60 && 码1175 != 44 &&
                        码1175 != 62 && 码1175 != 32;
        如果 (原样1175) {
            出1175 = 出1175 + 字符串子串(文本1175, 整32(i1175), 1);
        }
        i1175++;
    }
    // 无角括号=非泛型形态（0=不适用哨兵·调用方按 !=0 命中才归一）
    如果 (!有角1175) { 返回 0; }
    返回 整64(驻留(出1175));
}

// 1175（泛型实例指针三形态·根因 c 单点）：类型 ID -> 结构体键——先常规查表，
//   miss 后角括号实例文本归一（节点<整32> -> 节点$整32）再查；实例身份在
//   变量结构体表=标记 1（登记变量结构体(实例ID,1)）而键基合成(模块,实例ID)
//   无登记 → 查结构体类型 仍 0，落 结构体布局键基（实例化布局登记 裸键直设）。
//   非泛型形态（泛型角括号归一1175=0）保持原 miss=0，不静默造名。
函数 泛型实例键1175(整64 类型名ID) -> 整64 {
    // 1637：查结构体类型 可选化——无值=未登记（实例键基 保持 0 契约·逐点等价）
    整64 实例键基 = 0;
    可选<整64> 常规键查 = 查结构体类型(类型名ID);
    如果 (常规键查.有值) { 实例键基 = 常规键查.值; }
    如果 (实例键基 == 0) {
        整64 归1175 = 泛型角括号归一1175(类型名ID);
        如果 (归1175 != 0) {
            可选<整64> 归一键查 = 查结构体类型(归1175);
            如果 (归一键查.有值) { 实例键基 = 归一键查.值; }
            如果 (实例键基 == 0) {
                // 1541 B2：无值=实例布局键基未登记（原 0 哨兵等价·实例键基 保持 0）
                可选<整64> 实例键1175查 = 结构体布局键基(归1175);
                如果 (实例键1175查.有值) { 实例键基 = 实例键1175查.值; }
            }
        }
    }
    返回 实例键基;
}

// 1175（根因 b/c 配套）：解引用对象的结构体键——前缀节点操作数=**区间**，
//   类型取区间**末节点**（子终点-1·655 设计注记）：(*甲.下) 的末节点=.下
//   （首节点 甲 只是链根，其类型≠表达式类型）；单节点（*p）末节点=首节点。
//   所指类型经 解析所指类型813 逐层解链（标识符指针表/成员链字段真类型/
//   调用返回/指针算术/一元递归——814/1036 同款通道）。1541 B2 可选化：有值=
//   结构体键（恒 >0）；无值=所指未解析（交调用方既有「偏移未知」显形·
//   不静默取默认键）。
函数 解引用对象结构体键1175(向量<节点> 池, 节点 对象节点) -> 可选<整64> {
    如果 (对象节点.子终点 > 对象节点.子起点) {
        可选<整64> 所指查1175 = 解析所指类型813(池, 整32(对象节点.子终点 - 1));
        如果 (所指查1175.有值) {
            整64 所指1175 = 0;
            如果 (所指查1175.有值) { 所指1175 = 所指查1175.值; }
            整64 键1175 = 泛型实例键1175(所指1175);
            如果 (键1175 == 0) { 返回 无; }
            返回 某些(键1175);
        }
    } 否则 {
        // 1303 三期（882 处置①）：操作数区间非空=解析层构造不变量（解析表达式
        //   前缀路径先递归解析操作数再入前缀节点，合法操作数必至少追加一节点；
        //   空区间=畸形程序且语义期已按复合操作数形态登记显形中止，本态到达=
        //   语义/IR 两期不变量失守=编译器内部缺陷），报内部错误显形（主流程
        //   收尾 内部未登记数>0 中止产物），返回无值维持调用方既有诊断路径。
        登记内部未登记("解引用对象空区间", "前缀解引用结构体键1175", 0);
    }
    返回 无;
}

// 1175（泛型实例指针三形态·返回位）：**调用返回类型 -> 成员链对象结构体键**。
//   语义=`.` 左侧指针自动解引用**一级**（001 §4.4）：返回 `T*` 剥一层尾 '*'
//   （多级指针不继续解引用=1016 锁面；剥多层会把 `T**` 误当 `T` 放行）、
//   引用返回 `T&` 同款剥一层（118/244 既有口径）。剥后经 泛型实例键1175 归一
//   （节点<整32> / 节点$整32 两文本域），`查结构体大小` 守卫保持——非结构体
//   返回（整64* / 字符串 等）无值交调用方既有 miss 诊断。
//   修前：`透32(&甲).值`（自由函数返回 节点<整32>*）返回类型文本带星 →
//   查结构体大小 恒 0 → 链式 [ir2] 偏移未知（宿主同形态放行=r2 探针实录）。
//   1541 B2 可选化：有值=结构体键（恒 >0）；无值=非结构体/不可解析。
函数 调用返回结构体键1175(整64 返回类型ID) -> 可选<整64> {
    如果 (返回类型ID == 0) { 返回 无; }
    字符串 返回文1175 = 字符串复制(驻留文本(返回类型ID));
    整64 长1175 = 字符串长度(返回文1175);
    //   是指针/引用形态）——无值交调用方既有诊断，非业务默认值。
    如果 (长1175 > 1) {
        整64 尾1175 = 整64(返回文1175[整32(长1175 - 1)]) & 255;
        如果 (尾1175 == 42 || 尾1175 == 38) {
            返回文1175 = 字符串子串(返回文1175, 0, 整32(长1175 - 1));
        }
    }
    整64 键1175 = 泛型实例键1175(整64(驻留(返回文1175)));
    如果 (键1175 != 0 && 是结构体大小非零(键1175)) { 返回 某些(键1175); }
    //   分支显形/回退，非查表默认值）。
    返回 无;
}

// 91-a（2026-09-13 第九十一轮）：实参寄存器列表 -> 类型码向量（与 弹出们 同序）
//   ——发射调用实参们 前置（IR_调用实参.操作数2 编码；调用点寄存器类分派）。
函数 实参类型码们(向量<整64> 弹出们) -> 向量<整64> {
    向量<整64> 码们 = 向量<整64>();
    整64 i = 0;
    当 (i < 弹出们.大小()) {
        // 1360 批5：未登记=类型未知（T_未知 兜底·既有业务语义）
        整64 码i = 查寄存器类型或未知(弹出们.元素(i));
        结果<空类型, 整32> 加码 = 码们.追加(码i);
        如果 (!加码.正常) { 运行时错误(4); }
        i++;
    }
    返回 码们;
}

// 数值/布尔/字符 -> 字符串 转换符号（拼接隐式转换用；宿主 ir_call 对齐。
//   未登记/整数一律 from_int；浮32 场景 v2 浮点面未开（③ 后续），先归 float）
//   T48 轮顺带根治（505 双编译对照捕获·机制级）：字符拼接原落 from_int 打
//   码点十进制（22909），违反规范 02「字符拼接等价 字符转字符串」——补 T_字符
//   分支走 __cn_str_from_char（码点 UTF-8 编码·宿主 320-a T40 同源）
函数 转换符号(整64 码) -> 字符串 {
    如果 (码 == T_浮32 || 码 == T_浮64) { 返回 "__cn_str_from_float"; }
    如果 (码 == T_布尔) { 返回 "__cn_str_from_bool"; }
    如果 (码 == T_字符) { 返回 "__cn_str_from_char"; }
    // 232（91311 同族）：正64 拼接走无符号转换（from_int 有符号=2^63 以上印负）
    如果 (码 == T_正64) { 返回 "__cn_str_from_uint"; }
    返回 "__cn_str_from_int";
}

// 标识符类型解析（函数级权威 -> 解析期容器表 -> 顶层静态表 -> 解析期结构体表）；
//   返回类型名ID（容器合成名/结构体名/结果名）；0=未知
函数 解析标识符类型ID(整64 名ID) -> 整64 {
    可选<整64> 查本函数查 = 查当前函数变量类型(名ID);
    如果 (查本函数查.有值) { 返回 查本函数查.值; }
    // 1637：容器表/结构体表 存在性可选化——消费点显式分流（无值=本表 miss·
    //   落下一级；值域恒 >0 与 0=未知 终态分离）
    可选<整64> 容器查 = 查容器类型(名ID);
    如果 (容器查.有值) { 返回 容器查.值; }
    // 87-a（2026-09-12 第八十七轮）：顶层静态变量——静态表类型（结构体静态的
    //   类型解析入口：整体赋值/成员链/实参位移轴）。原缺此级 → 静态结构体的
    //   整体赋值 查结构体大小==0 提前返回假（静态槽静默零写，探针 P50b 实证）。
    结果<整64, 整32> 找静类 = 查静态序号含类(名ID);
    如果 (找静类.正常) { 返回 取静态类型(找静类.值); }
    可选<整64> 结构查 = 查结构体类型(名ID);
    如果 (结构查.有值) { 返回 结构查.值; }
    返回 0;
}

函数 推导实参类型文本(向量<节点> 池, 整32 节点索引) -> 字符* {
    节点 n = 池.元素(节点索引);
    // 231 甄别实录：本函数返回 字符*——字面量直返（返回 "浮64"）跨函数后
    //   指向失效临时（调用方实段=空→通配→假歧义·dbg 三段铁证）——改驻留
    //   稳定文本（驻留文本(驻留(...))）。
    如果 (n.类型 == 节点_整数字面量) {
        // 1263/1264：带后缀字面量按后缀标记域推导（1160 定级单点·宿主
        //   literalTypeOf 同款）——挂账清偿（下方 无后缀十进制超i32域 注「带
        //   后缀超域字面量重载决议面」）：4000000000L→整64·对整32 参段段级=
        //   窄化不匹配→该候选淘汰（原恒整32=精确匹配截断重载·静默错值实录）；
        //   无后缀保持 910 值域判定既有面。
        整64 后缀ID1263 = 字面量后缀类型ID(驻留文本(整64(n.文本)));
        如果 (后缀ID1263 != 0) { 返回 驻留文本(后缀ID1263); }
        如果 (无后缀十进制超i32域(驻留文本(整64(n.文本)))) { 返回 驻留文本(驻留("整64")); }
        返回 驻留文本(驻留("整32"));
    }
    如果 (n.类型 == 节点_浮点字面量) {
        // 浮点字面量按尾缀 f/F 分型定级（浮点字面量类型ID 单点·宿主
        //   literalTypeOf(raw,true) 同构）——1.5f→浮32 / 2.5→浮64：修前
        //   一律浮64=重载决议选错分支（述(1.5f) 宿主浮32 分支 vs v2 浮64
        //   分支）+负号面按浮64 ABI 传浮32 位模式读出 0（探针 B-f64:0.000000
        //   vs 宿主 A-f32:-1.500000 实锚）。
        返回 驻留文本(浮点字面量类型ID(驻留文本(整64(n.文本))));
    }
    如果 (n.类型 == 节点_布尔字面量) { 返回 驻留文本(驻留("布尔")); }
    如果 (n.类型 == 节点_字符串字面量) { 返回 驻留文本(驻留("字符串")); }
    如果 (n.类型 == 节点_负号 && n.子终点 > n.子起点) {
        // 负号+浮点字面量形态：操作数（区间末节点）按浮点定级单点分型——
        //   -1.5f→浮32 / -2.5→浮64（宿主 -1.5f 源类型=literalTypeOf("-1.5f",
        //   true)=浮32 同构）。操作数非浮点字面量（负整数/负变量）维持空段
        //   既有面（负整数决议现状对拍绿·不扩面）。
        节点 负操作数 = 池.元素(整32(n.子终点 - 1));
        如果 (负操作数.类型 == 节点_浮点字面量) {
            返回 驻留文本(浮点字面量类型ID(驻留文本(整64(负操作数.文本))));
        }
        返回 "";
    }
    如果 (n.类型 == 节点_标识符) {
        整64 类型ID = 解析标识符类型ID(整64(n.文本));
        如果 (类型ID != 0) { 返回 驻留文本(类型ID); }
        返回 "";
    }
    如果 (n.类型 == 节点_成员 || n.类型 == 节点_调用) {
        可选<整64> 类型查605 = 解析节点类型ID(池, 节点索引);
        如果 (类型查605.有值) { 返回 驻留文本(类型查605.值); }
        返回 "";
    }
    返回 "";
}

// 段匹配级（231·2026-10-06·91323 歧义实锤）：返回转换级距供决议择优——
//   0=精确相等 1=整字面量→整族宽化+浮32→浮64 浮点族宽化 2=隐式跨族（整→浮·
//   浮64→浮32）99=不匹配；空段（推导失败）=1 保守通配。原布尔版把「整字面量
//   →整族」与「整字面量→浮族」记同级宽匹配→印(7) 对 印(整64)/印(浮64) 双宽=
//   假歧义（宿主 conversionLevel 级距 1 vs 2 择优同构）。
函数 实参段匹配级(字符串 实段, 字符串 参段) -> 整64 {
    如果 (字符串长度(实段) == 0) { 返回 1; }
    如果 (字符串比较(实段, 参段)) { 返回 0; }
    如果 (字符串比较(实段, "整32")) {
        如果 (字符串比较(参段, "整64") || 字符串比较(参段, "整8") ||
             字符串比较(参段, "整16") || 字符串比较(参段, "正8") ||
             字符串比较(参段, "正16") || 字符串比较(参段, "正32") ||
             字符串比较(参段, "正64")) { 返回 1; }
        如果 (字符串比较(参段, "浮32") || 字符串比较(参段, "浮64") ||
             字符串比较(参段, "字符")) { 返回 2; }
    }
    如果 (字符串比较(实段, "浮64") && 字符串比较(参段, "浮32")) { 返回 2; }
    // 浮32→浮64=浮点族宽化级1（宿主 conversionLevel 浮点族「浮32→浮64=1」
    //   同构）——f 后缀字面量推导浮32 后对 浮64 参候选的宽化面：概(1.5f)
    //   单浮64 候选形态（宿主宽化放行）修前=99 无候选诊断分叉。
    如果 (字符串比较(实段, "浮32") && 字符串比较(参段, "浮64")) { 返回 1; }
    返回 99;
}

// 兼容入口（布尔·存量消费点=级<99）
函数 实参段匹配(字符串 实段, 字符串 参段) -> 布尔 {
    返回 实参段匹配级(实段, 参段) < 99;
}


// ==================== 1611（2026-10-25·1025 采样轮 d4/d5 实锚）：结果/可选
//   载荷提取**元数感知单点**（107b 解析节点类型ID/107 解析成员链结构体ID/
//   946 盒摘删与登记/205 资源谓词 四消费点收口——文件归属=本辅助文件·先拆
//   再加纪律：IR生成类型.cn 已贴 1000 冻结线） ====================
// 病根：段首/段余 平铺 '$' 切分对嵌套实例载荷砍段——「可选$字符串映射<整32>
//   实例名」的 值 被 砍成裸基名（丢实例段）→ 方法调用接收者/析构/拷贝构造
//   符号修饰缺段（宿主 isClassType 同族缺口的 v2 面·1542 LNK2019×4 实锚；
//   543m4 嵌套结果 载荷误判非结构体=取值/拷贝通道错配 C0000005 同根）。
// 契约：实参表完整（错误=2 段/值=非空）→ 元数切取；残缺（数组 T 形态·797
//   注记）→ 平铺回退（develop 基线行为·零回归）。残缺形态枚举判定（== 完整
//   段数）——单边守卫与 else 业务双红规避（分支无 else·比较无开区间）。
函数 结果可选载荷元数提取1611(字符串 盒文本1611, 字符串 成员名1611) -> 字符串 {
    // 入口归一：声明文本形态（结果<字符串映射<整32>,整32>·尖括号）→ $ 合成名
    //   （归一结果名 平转与 取实例实参们 元数切分恰可逆·合法泛型文本域）；
    //   合成体类型键=归一+去空白+剥尾 $（1592 同款单点）。
    字符串 盒键1611 = 合成体类型键(盒文本1611);
    向量<字符串> 实参们1611 = 取实例实参们(盒键1611);
    字符串 载荷1611 = 段首(合成名首实参(盒键1611));
    如果 (字符串比较(成员名1611, "错误")) {
        载荷1611 = 段余(合成名首实参(盒键1611));
    }
    如果 (字符串比较(成员名1611, "错误")) {
        如果 (实参们1611.大小() == 2) {
            载荷1611 = 字符串复制(实参们1611.元素(1));
        }
    }
    如果 (!字符串比较(成员名1611, "错误")) {
        如果 (实参们1611.大小() != 0) {
            载荷1611 = 字符串复制(实参们1611.元素(0));
        }
    }
    // 出口物化：载荷=泛型文本（字符串映射<整32>）→ 实例名（字符串映射$整32）
    //   ——文本形态下游 isClassType/方法表按 $ 实例名查表恒 miss（宿主
    //   resolveGenericInstanceType 同构；1542 甲.值.获取 接收者实锚）。
    返回 类型文本物化1611(载荷1611);
}

// 1611：泛型类型文本物化（尖括号文本→$ 实例名·幂等）——归一结果名 平转
//   （< > , → $）对合法泛型文本与元数切分可逆；非泛型/已物化原样。
函数 类型文本物化1611(字符串 文本1611) -> 字符串 {
    字符串 键1611 = 归一结果名(去类型空白(文本1611));
    当 (字符串长度(键1611) > 0 &&
        (整64(键1611[整32(字符串长度(键1611) - 1)]) & 255) == 36) {
        键1611 = 字符串子串(键1611, 0, 整32(字符串长度(键1611) - 1));
    }
    返回 键1611;
}

// #1322（2026-10-26·244 同构补齐·与 #1615 同族「内置白名单对用户泛型类不认」
//   异拦截点）：用户类方法被调返回类型解析——解析调用返回结构体 原 容器守卫
//   只认容器类（用户泛型类实例 盒$盒$整32 恒拒）→ 方法链第二跳 解析节点类型ID
//   → 守卫拒 → [ir2] 方法调用对象类型未解析: .取（外.取().取()·盒<盒<整32>>
//   实测复现）。经 查类方法返回（实例克隆体方法表·登记类方法 按实例ID 登记·
//   返回=克隆体替换后返回类型）解析（剥尾 & 与 118 同款）——与 1014 版 244
//   通道同构补齐；>1 判定同 244（布尔/空类型返回不入结构体键域）。
//   随体自 IR生成类型.cn（基线 1000 贴线·先拆再加）。
函数 解析用户类方法返回结构体1322(整64 对象类型ID, 整64 方法名ID) -> 可选<整64> {
    可选<整64> 用户方法返回查1322 = 查类方法返回(对象类型ID, 方法名ID);
    如果 (用户方法返回查1322.有值) {
        // 显式文本白名单（244 意图显形化：布尔/空类型返回不入结构体键域——
        //   原存量 >1 词面改写·互斥正条件枚举·#1322 修复面）
        字符串 返文1322 = 字符串复制(驻留文本(用户方法返回查1322.值));
        布尔 真类型返回1322 = !字符串比较(返文1322, "空类型") &&
                             !字符串比较(返文1322, "布尔");
        如果 (真类型返回1322) {
            // 静默豁免闭集穷举: 剥尾 '&' 守卫（长度>1 才可能尾 '&' 字节·118/1014 存量同构形态镜像）
            如果 (字符串长度(返文1322) > 1 &&
                 ((整64(返文1322[整32(字符串长度(返文1322) - 1)]) & 255) == 38)) {
                返文1322 = 字符串子串(返文1322, 0, 整32(字符串长度(返文1322) - 1));
            }
            返回 某些(整64(驻留(返文1322)));
        }
    }
    返回 无;
}

// ==================== 字面量值域判定族（1615 冻结线拆分自 IR生成类型.cn·纯机械搬移零行为变更） ====================

// 实参类型文本推导（静态单节点）：字面量按语义层口径（整数字面量=整32）、
//   标识符走 解析标识符类型ID（权威表含标量/结构体/容器/参数）、成员/调用走
//   解析节点类型ID。未知形态返回 空串（决议时按通配处理）。
// A2（2026-09-11 方案甲）：返回 字符串->字符*——字面量分支只读段借用+驻留分支
//   驻留表借用，全分支借用视图零拷贝（调用方持有须 字符串复制 落堆）。
// 231（2026-10-06·91313）：无后缀十进制整数字面量值域判定——超 整32 正域
//   （2147483647）按 整64 参与重载决议（值保真·Rust 字面量推断惯例·宿主
//   adjustLiteralArgTypes 同构）。非纯十进制（0x/L/U 后缀形态）不判=维持
//   整32（挂账：带后缀超域字面量重载决议面）。
函数 无后缀十进制超i32域(字符串 rawz) -> 布尔 {
    整64 长z = 字符串长度(rawz);
    如果 (长z == 0) { 返回 假; }
    整64 iz = 0;
    当 (iz < 长z) {
        整64 cz = 整64(rawz[iz]) & 255;
        如果 (cz < 48 || cz > 57) { 返回 假; }
        iz++;
    }
    // 静默豁免闭集穷举: 位数>10 必超整32 正域（长度结构守卫·1615 拆分原样搬迁）
    如果 (长z > 10) { 返回 真; }
    // 静默豁免闭集穷举: 位数<10 必域内（长度守卫对偶·1615 拆分原样搬迁）
    如果 (长z < 10) { 返回 假; }
    字符串 上界z = "2147483647";
    整64 bz = 0;
    当 (bz < 10) {
        整64 crz = 整64(rawz[bz]) & 255;
        整64 cbz = 整64(上界z[bz]) & 255;
        如果 (crz > cbz) { 返回 真; }
        如果 (crz < cbz) { 返回 假; }
        bz++;
    }
    返回 假;
}

// 535：负号字面量数学值是否落在整32 域内（数字文本 ≤ 2147483648——取负后
//   ≥ -2147483648=int32MIN）。与 无后缀十进制超i32域 同族但判据错位互补：正域
//   判据（>2147483647）对负号形态失真——-2147483648 数字超正域（装载升整64）
//   但数学值恰域内；同型普通算术（-2147483648 - 1）双侧编译期按整32 域判溢出
//   （001 §3.7a 回绕与算术同类型规则→回绕参与域须整32）。非纯十进制（后缀/
//   十六进制形态）=假（维持装载域·诚实边界同 231 挂账口径）。
函数 负号字面量值入整32域(字符串 文本535) -> 布尔 {
    整64 长535 = 字符串长度(文本535);
    如果 (长535 == 0) { 返回 假; }
    整64 i535 = 0;
    当 (i535 < 长535) {
        整64 c535 = 整64(文本535[i535]) & 255;
        如果 (c535 < 48 || c535 > 57) { 返回 假; }
        i535++;
    }
    // 静默豁免闭集穷举: 位数<10 必域内（负号域长度守卫·1615 拆分原样搬迁）
    如果 (长535 < 10) { 返回 真; }
    // 静默豁免闭集穷举: 位数>10 必超域（长度守卫对偶·1615 拆分原样搬迁）
    如果 (长535 > 10) { 返回 假; }
    字符串 界535 = "2147483648";
    整64 b535 = 0;
    当 (b535 < 10) {
        整64 cr535 = 整64(文本535[b535]) & 255;
        整64 cb535 = 整64(界535[b535]) & 255;
        如果 (cr535 > cb535) { 返回 假; }
        如果 (cr535 < cb535) { 返回 真; }
        b535++;
    }
    返回 真;
}

