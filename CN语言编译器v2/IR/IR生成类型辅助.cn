// CN 自举编译器 v2：IR 生成类型辅助（436 轮冻结线拆分·自 IR生成类型.cn 机械
//   搬移·纯搬运零行为变更——309 类构造默认参数族与 263④ 类型宽度码段整段
//   迁入·静态表随族同迁=文件自洽；消费点经包内合并全局池解析零改动）

导入 容器::向量;
导入 IR;         // IR常量 键位移（目录包名）

公开:

// ==================== 309（2026-10-09）：类构造默认参数登记/放宽查询 ====================
// 病理（377/568 实测）：类构造走 类构造参数串们（键=类名ID*键位移+参数段个数）
//   精确匹配通道——构造带默认参数时 0/少参调用 miss：发射用户类构造 掉 278
//   「隐式默认构造（仅分配）」分支=字段全 0（377「缺省: 0」·有构造器被误判无
//   构造器）；注入父构造调用 报 234（568「空参列表靠父默认参」形态·宿主 D23
//   已支持）。宿主同构=语义层 funcDefaultArgs_+emitCtorInvoke 按选中构造补全。
// 键公式（段数≤63·序<64·积<4096 不撞键位移段）：类名ID*键位移+段数*64+参数序。
静态 映射<整64, 整64> 类构造默认数们;   // 类名ID*键位移+构造段数 -> 默认参数数（尾连续）
静态 映射<整64, 整64> 类构造默认根们;   // 类名ID*键位移+构造段数*64+参数序 -> 默认值根节点池索引

// 登记类构造默认参数（语义收集面 收集类方法 构造分支调用·方法节点与函数节点
//   同构：子起点=参数区间·块节点子起点修正式同 登记函数默认参数）。参数序=
//   声明序逐参数递增（309 顶层函数面同款修——无默认同样占序）。
函数 登记类构造默认参数(向量<节点> 池, 整32 方法节点, 整64 类名IDc, 整64 构造段数c) -> 空类型 {
    节点 方法声明c = 池.元素(方法节点);
    整64 参数终点c = 整64(方法声明c.子终点);
    如果 (参数终点c < 整64(池.大小())) {
        节点 体块c = 池.元素(整32(参数终点c));
        参数终点c = 整64(体块c.子起点);
    }
    整64 默认数c = 0;
    整64 参数序c = 0;
    整64 ic = 整64(方法声明c.子起点);
    当 (ic < 参数终点c && 参数序c < 构造段数c) {
        节点 参数c = 池.元素(整32(ic));
        如果 (参数c.类型 == 节点_参数) {
            如果 (参数c.子起点 != 0) {
                整64 设数键c = 类名IDc * 键位移 + 构造段数c;
                结果<空类型, 整32> 设数c = 类构造默认数们.设置(设数键c, 默认数c + 1);
                如果 (!设数c.正常) { 运行时错误(4); }
                整64 设根键c = 类名IDc * 键位移 + 构造段数c * 64 + 参数序c;
                结果<空类型, 整32> 设根c = 类构造默认根们.设置(设根键c, 参数c.子起点);
                如果 (!设根c.正常) { 运行时错误(4); }
                默认数c++;
            }
            参数序c++;
        }
        ic++;
    }
}

// 查类构造默认参数个数（0=无默认·放宽匹配消费）
函数 查类构造默认数(整64 类名IDc, 整64 构造段数c) -> 整64 {
    结果<整64, 整32> 查 = 类构造默认数们.获取(类名IDc * 键位移 + 构造段数c);
    如果 (查.正常) { 返回 查.值; }
    返回 0;
}

// 查类构造默认参数根（0=未登记）
函数 查类构造默认根(整64 类名IDc, 整64 构造段数c, 整64 参数序c) -> 整64 {
    结果<整64, 整32> 查 = 类构造默认根们.获取(
        类名IDc * 键位移 + 构造段数c * 64 + 参数序c);
    如果 (查.正常) { 返回 查.值; }
    返回 0;
}

// 构造默认参数放宽查询（精确 miss 时扫更大段数的构造·宿主重载决议
//   「实参个数+可补全匹配」同构）：可补全=该段数构造存在且 默认数>0 且
//   实参数 ∈ [段数-默认数, 段数)。出参=选中构造段数；返回=该段数构造参数串ID
//   （0=无可补全构造）。多候选=歧义诊断（fail fast·宿主 ambiguous 同语义）。
函数 查类构造放宽(整64 类名IDc, 整64 实参数c, 整64& 段数出c) -> 整64 {
    段数出c = 0;
    整64 命中串c = 0;
    整64 命中数c = 0;
    整64 m = 实参数c;
    当 (m < 64) {
        m++;
        整64 串m = 查类构造参数串(类名IDc, m);
        如果 (串m == 0) { 继续; }
        整64 默m = 查类构造默认数(类名IDc, m);
        如果 (默m > 0 && 实参数c >= m - 默m) {
            命中串c = 串m;
            段数出c = m;
            命中数c++;
        }
    }
    如果 (命中数c > 1) {
        IR层诊断("类构造重载决议歧义（默认参数可补全候选 " +
                 整数转字符串(命中数c) + " 个）: " + 驻留文本(类名IDc));
        返回 0;
    }
    返回 命中串c;
}

// ==================== 类型宽度码（263④ 轮自 IR布局.cn 机械搬移·纯搬运零行为
//   变更——超标冻结文件腾行·263① 生成语句辅助 同款） ====================
// 按字段类型文本返回 指针加载/存储 宽度标注（T_* 码）。窄宽码 T_整8/T_整16/
//   T_字符 由 IR生成 定义（纯名引用——合并后全局可见，同 IR追加 先例）；
//   其余（整64/字符串/指针/嵌套结构体）默认 8 字节。
// 46-f（2026-09-10 第五十轮）：正32 独立码 T_正32——字段 4 字节读回零扩展
//   （movzx/ldr w32）而非符号扩展（movsxd）：4000000000 位模式读回须=原值。
函数 类型宽度码(字符串 类型文本) -> 整64 {
    // 94-a：数组类型——读/写宽度按**元素类型**（宿主 mapType(数组)=mapType(元素)
    //   同构；数组元素 p[i] 的加载/存储宽度即元素宽度）
    如果 (是数组类型文本(类型文本)) {
        字符串 元素w = 数组元素文本(类型文本);
        如果 (字符串长度(元素w) > 0) { 返回 类型宽度码(元素w); }
    }
    如果 (字符串比较(类型文本, "布尔")) { 返回 T_布尔; }
    如果 (字符串比较(类型文本, "字符")) { 返回 T_字符; }
    // 347-a（T33 残余根治·同族旁路穷尽）：原「整8/正8 归并 T_整8」「整16/正16
    //   归并 T_整16」**丢失符号性** → 结构体字段/数组元素/指针解引用路径的无符号
    //   窄类型被当有符号读（探针 p24：正8 字段 200 读回 -56；正16 60000 读回 -5536）；
    //   反向：整8/整16 负值被零扩展（p23：-426 读回 65110）。拆分为独立码——
    //   三后端已完整支持 T_正8/T_正16 零扩展语义（2026-09-04 收口设施·
    //   转换/装载面分派齐备），指针加载/存储分派本轮补齐。
    如果 (字符串比较(类型文本, "整8")) { 返回 T_整8; }
    如果 (字符串比较(类型文本, "正8")) { 返回 T_正8; }
    如果 (字符串比较(类型文本, "整16")) { 返回 T_整16; }
    如果 (字符串比较(类型文本, "正16")) { 返回 T_正16; }
    如果 (字符串比较(类型文本, "正32")) { 返回 T_正32; }
    如果 (字符串比较(类型文本, "整32")) { 返回 T_整32; }
    // 263④（021 任务 263·探针 646 实证）：128 位标量宽度码——成员字段写
    //   （生成语句赋值 存储宽度 命中 545 双半写通道·自带拆半零发射层依赖）与
    //   下标/解引用宽度分派消费。读侧字段 128 由 生成表达式字段 810 地址语义
    //   通道（成员值码 拦截）先行返回不经本码装载。
    如果 (字符串比较(类型文本, "整128")) { 返回 T_整128; }
    如果 (字符串比较(类型文本, "正128")) { 返回 T_正128; }
    // 279：枚举类型字段/元素=T_整32（4 字节读写·布局 4/4 配套——C 枚举=int）
    如果 (是枚举名(驻留(类型文本))) { 返回 T_整32; }
    // 990（008 挂账·094 空安全语义）：字符串字段 加载类型=T_字符串——codegen
    //   对 T_字符串 的指针加载**跳过判空**（0 句柄=空串·运行时串函数已容错
    //   __cn_str_len(0)=0/__cn_str_eq 容错——宽度仍 8 字节句柄·与 T_整64 等宽
    //   零行为差异面=仅判空豁免）
    如果 (字符串比较(类型文本, "字符串")) { 返回 T_字符串; }
    // 648 归档（豁免边界声明）：终态 T_整64=8 字节合法主路径（函数头契约
    //   「整64/字符串/指针/嵌套结构体默认 8 字节」）；泛型模板结构体名常态
    //   到达（词条 等单态化前无布局·L2 127 实证——首记 648 曾登记后回撤），
    //   兜底=单态化前定义期占位，实例化产物经单态化重编走精确宽度。
    返回 T_整64;
}

// ==================== 方法调用对象类型解析族（537 轮自 IR生成类型.cn 机械
//   搬移·纯搬运零行为变更——本文件 940 行超 900 警戒线腾行（309/263④ 同款
//   先例）；搬移后 解析方法对象类型扩展 补 537 单目重载分支） ====================
// 方法调用对象类型解析（表.追加 / b.表.追加 / 元素(0).设置 / 词池.元素(0).表.大小）：
//   经 解析节点类型ID 推导对象类型——容器直用；结构体则查方法名对应字段的容器类型。
// 返回容器合成类名ID；0=未知。
函数 解析方法对象类型(向量<节点> 池, 整32 调用索引) -> 整64 {
    节点 调用节点 = 池.元素(调用索引);
    如果 (调用节点.类型 != 节点_调用 || 调用节点.子起点 <= 0) { 返回 0; }
    节点 被调成员 = 池.元素(整32(调用节点.子起点));
    如果 (被调成员.类型 != 节点_成员) { 返回 0; }
    // 381 第二层：字段类型表存真类型（带星）后指针字段接收者剥尾星取基名
    //   （接收者=所指对象·自动解引用；带星判 是容器类/是用户类 假=分派丢失）。
    整64 对象类型ID = 剥尾星基名(解析节点类型ID(池, 整32(被调成员.子起点)));
    如果 (对象类型ID != 0) {
        如果 (是容器类(驻留文本(对象类型ID))) { 返回 对象类型ID; }
        如果 (查结构体大小(对象类型ID) != 0) {
            整64 字段类型ID = 查字段类型ID(对象类型ID, 整64(被调成员.文本));
            如果 (字段类型ID != 0 && 是容器类(驻留文本(字段类型ID))) { 返回 字段类型ID; }
        }
    }
    返回 0;
}

// 方法调用对象类型解析·扩展版（第七十八轮，2026-09-12）：与 解析方法对象类型
//   同构，但对象类型不限于容器类——用户类对象同样返回（生成方法调用 的用户类
//   分派依据）。容器消费点（解析调用返回容器 等）保持用容器专版，行为不变。
函数 解析方法对象类型扩展(向量<节点> 池, 整32 调用索引) -> 整64 {
    节点 调用节点 = 池.元素(调用索引);
    如果 (调用节点.类型 != 节点_调用 || 调用节点.子起点 <= 0) { 返回 0; }
    节点 被调成员 = 池.元素(整32(调用节点.子起点));
    如果 (被调成员.类型 != 节点_成员) { 返回 0; }
    // 328（2026-10-09·002·21）：父类限定（方法体上下文·C++ Base::method 同款）
    //   ——对象位标识符「父类」→返回基类名ID：方法表/定义类 walk-up 按基类
    //   解析=直调基类实现符号（发射侧 虚槽强制静态·328 尾参配套）
    如果 (当前方法类名ID != 0) {
        节点 对象位p = 池.元素(整32(被调成员.子起点));
        如果 (对象位p.类型 == 节点_标识符 &&
             字符串比较(驻留文本(整64(对象位p.文本)), "父类")) {
            整64 基名p = 查类基名(当前方法类名ID);
            如果 (基名p != 0) { 返回 基名p; }
        }
    }
    // 381 第二层：同上出口剥尾星（指针字段接收者自动解引用·带星=分派丢失）。
    整64 对象类型ID = 剥尾星基名(解析节点类型ID(池, 整32(被调成员.子起点)));
    // 537（2026-10-13）：单目重载结果对象作方法调用接收者（(-点(5)).取()——
    //   对象位=单目表达式形态（负号/逻辑非/位非））——经 解析单目重载结果类型ID
    //   推导重载结果类型（507 判定收口·宿主 exprSrcType UnaryExpr 同构；原
    //   miss=类名空 →「方法调用对象类型未解析」诊断终止）。
    如果 (对象类型ID == 0) {
        对象类型ID = 剥尾星基名(解析单目重载结果类型ID(池, 整32(被调成员.子起点)));
    }
    如果 (对象类型ID != 0) {
        字符串 对象文本x = 字符串复制(驻留文本(对象类型ID));
        // 413：接口类型对象出口（接口变量/接口参数——生成方法调用 接口分派依据）
        如果 (是容器类(对象文本x) || 是用户类(对象文本x) || 是接口名(对象文本x)) {
            返回 对象类型ID;
        }
        如果 (查结构体大小(对象类型ID) != 0) {
            整64 字段类型IDx = 查字段类型ID(对象类型ID, 整64(被调成员.文本));
            如果 (字段类型IDx != 0) {
                字符串 字段文本x = 字符串复制(驻留文本(字段类型IDx));
                如果 (是容器类(字段文本x) || 是用户类(字段文本x)) {
                    返回 字段类型IDx;
                }
            }
        }
    }
    返回 0;
}

