// CN 自举编译器 v2：结构化语法分析器（自举重建 P3，2026-08-25）
// 性能最优架构第二层：AST 用节点池（向量<节点>，arena 语义），节点间索引引用。
// 输入：P2 词法器 Token 数组；输出：节点池 AST。
// 规范依据：cn-language-spec 03/04/05。
导入 容器::向量;
导入 映射集合;
导入 词法分析;
导入 IR容器;    // P7b：容器/结果 合成名判定（变量容器表 登记与成员预标注）
导入 IR常量;    // 簇①根治·A2：节点_*/键位移 常量（跨组件协议常量单一归属）

公开:

// P6e（2026-08-30）：字段偏移表按结构体分桶根治——扁平 字段名->偏移 单映射
//   在两个结构体同名字段（点.x 与 矩形.x）时串偏移（用户批评的正确性隐患）。
//   方案：键 = 结构体名ID * 键位移 + 字段名ID（单映射，无嵌套依赖）；
//   成员访问时经 变量结构体表（变量名ID -> 结构体名ID）推导对象所属结构体。
//   键位移常量值见 IR常量.cn（A2 单一归属）。
静态 映射<整64, 整64> 变量结构体表;

// P6h（2026-08-31）：多源文件支持——本文件 导入 语句登记的模块名列表。
//   加载器（主.cn）每解析完一个文件调用 取走导入模块们 消费并清空。
静态 向量<整32> 导入模块们;
静态 整64 语法错误数 = 0;   // plans/015 方案B（2026-09-04）：语句终结分号缺失计数（主链 语义分析前检查中止）

// P7b（2026-09-01）：变量容器表——容器/结果 变量名ID -> $合成类型名ID。
//   成员解析时预标注到 节点_成员.子终点（对象类型ID）：方法调用（附加=-2）与
//   结果字段访问（.正常/.值）IR 层据此直接取对象类型——生成表达式 无需携带
//   类型表参数（宿主 nameMangle 符号长度限制 247：多一个映射参数即超限，
//   PROC 符号注册失败导致 bb 标签泄漏全局连锁 A2005——实测踩坑）。
//   跨文件保留（同 变量结构体表 模式），清空 由加载器任务开始前调用。
静态 映射<整64, 整64> 变量容器表;

// 簇①根治·A2（2026-09-04）：节点_*/键位移 常量区整体下沉 IR常量.cn（跨组件
//   协议常量单一归属——IR容器 引用 语法分析 不可导=循环；原定义在本文件顶层，
//   冒烟 IR容器 入口 14 错）。常量值与逐项注释见 IR常量.cn「AST 节点类型」区。

结构体 节点 {
    整32 类型;
    整32 文本;
    整64 附加;
    整32 子起点;
    整32 子终点;
}

函数 池追加(向量<节点> 池, 节点 n) -> 整32 {
    结果<空类型, 整32> 加 = 池.追加(n);
    如果 (!加.正常) { 运行时错误(4); }
    返回 整32(池.大小() - 1);
}

函数 建节点(整32 类型, 整32 文本, 整64 附加, 整32 子起点, 整32 子终点) -> 节点 {
    节点 n;
    n.类型 = 类型;
    n.文本 = 文本;
    n.附加 = 附加;
    n.子起点 = 子起点;
    n.子终点 = 子终点;
    返回 n;
}

函数 当前类型(向量<Token> 记号, 整64 位置) -> 整32 {
    如果 (位置 >= 记号.大小()) { 返回 令牌_文件结束; }
    Token 当前 = 记号.元素(位置);
    返回 整32(当前.类型);
}
函数 当前ID(向量<Token> 记号, 整64 位置) -> 整32 {
    如果 (位置 >= 记号.大小()) { 返回 0; }
    Token 当前 = 记号.元素(位置);
    返回 整32(当前.文本);
}
函数 当前文本(向量<Token> 记号, 整64 位置) -> 字符串 {
    返回 驻留文本(整64(当前ID(记号, 位置)));
}
函数 是关键(向量<Token> 记号, 整64 位置, 字符串 关键字) -> 布尔 {
    返回 当前类型(记号, 位置) == 令牌_关键字 && 当前ID(记号, 位置) == 整32(驻留(关键字));
}

// 解析原子表达式：字面量/标识符/括号。返回结束位置；节点入池。
函数 解析原子(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    整32 t = 当前类型(记号, 位置);
    如果 (t == 令牌_整数字面量) {
        池追加(池, 建节点(节点_整数字面量, 当前ID(记号, 位置), 0, 0, 0));
        返回 位置 + 1;
    }
    如果 (t == 令牌_浮点字面量) {
        池追加(池, 建节点(节点_浮点字面量, 当前ID(记号, 位置), 0, 0, 0));
        返回 位置 + 1;
    }
    如果 (t == 令牌_字符串字面量) {
        池追加(池, 建节点(节点_字符串字面量, 当前ID(记号, 位置), 0, 0, 0));
        返回 位置 + 1;
    }
    如果 (t == 令牌_标识符) {
        // P7b 构造调用：名<实参>( —— 合成 $ 实例名标识符（向量$整64）入池，
        //   后随 '()' 走既有 调用 节点（IR 层据标识符文本是容器实例名判定构造）
        如果 (是构造调用(记号, 位置)) {
            整64 名位置 = 位置;
            字符串 合成名 = 解析类型文本(记号, &名位置, 假);
            池追加(池, 建节点(节点_标识符, 整32(驻留(合成名)), 0, 0, 0));
            返回 名位置;
        }
        池追加(池, 建节点(节点_标识符, 当前ID(记号, 位置), 0, 0, 0));
        返回 位置 + 1;
    }
    // ③ 第五波（2026-09-03）：布尔/空指针字面量 真/假/无（规范 02——词法关键字表
    //   已有，解析层此前零分支=谓词含 真/假 的源码必截断）。
    // 灰色点①根治（2026-09-04）：真/假 独立 节点_布尔字面量（文本=1/0 值）——
    //   语义推导 布尔、IR 登记 T_布尔（打印/拼接分派自动 print_bool/from_bool，
    //   对齐宿主 __cn_print_bool 输出 真/假；原复用整数字面量输出 1/0 两侧分叉）。
    //   无 保持整数字面量 0（空指针语义，与 指针/字符串 的 == 比较走指针语义，
    //   宿主 字符串==无 判空同款；133 EOF 判空载体）。
    如果 (t == 令牌_关键字 && 当前ID(记号, 位置) == 整32(驻留("真"))) {
        池追加(池, 建节点(节点_布尔字面量, 整32(驻留("1")), 0, 0, 0));
        返回 位置 + 1;
    }
    如果 (t == 令牌_关键字 && 当前ID(记号, 位置) == 整32(驻留("假"))) {
        池追加(池, 建节点(节点_布尔字面量, 整32(驻留("0")), 0, 0, 0));
        返回 位置 + 1;
    }
    如果 (t == 令牌_关键字 && 当前ID(记号, 位置) == 整32(驻留("无"))) {
        池追加(池, 建节点(节点_整数字面量, 整32(驻留("0")), 0, 0, 0));
        返回 位置 + 1;
    }
    如果 (t == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("("))) {
        位置++;
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(")"))) { 位置++; }
        返回 位置;
    }
    返回 位置;
}

// 后缀节点类型（P3b 常量）——先在此定义，与实际使用同步
常量 节点_调用 = 17;
常量 节点_成员 = 18;
常量 节点_下标 = 19;
// P7b（2026-09-01）：成员节点附加=方法标记——成员名后紧跟 '('（方法调用形态
//   表.追加(x)）时附加记 -2，IR 层据此走方法调用（this+方法符号），不做字段访问。
//   -1=未命中字段偏移（未知字段）；>=0=字段字节偏移。
常量 成员方法标记 = -2;

// ==================== 复合赋值五形态（③ 第二波，方案A 裁决 2026-09-03） ====================
// += -= *= /= %=（词法双字符 token）。原解析层无分支：+= 不消费 -> 解析块循环保护
//   静默中断 -> 块内后续语句丢弃（词法分析.cn 分词 被截断的假绿冒烟根因，探针实锤）。
函数 是复合赋值符(整32 符号ID) -> 布尔 {
    字符串 文本 = 驻留文本(整64(符号ID));
    返回 字符串比较(文本, "+=") || 字符串比较(文本, "-=") ||
           字符串比较(文本, "*=") || 字符串比较(文本, "/=") || 字符串比较(文本, "%=");
}

// 复合赋值符 -> 对应二元运算符（a op= r ≡ a = a op r 的 op）
函数 复合二元符号(整32 符号ID) -> 整32 {
    字符串 文本 = 驻留文本(整64(符号ID));
    如果 (字符串比较(文本, "+=")) { 返回 整32(驻留("+")); }
    如果 (字符串比较(文本, "-=")) { 返回 整32(驻留("-")); }
    如果 (字符串比较(文本, "*=")) { 返回 整32(驻留("*")); }
    如果 (字符串比较(文本, "/=")) { 返回 整32(驻留("/")); }
    返回 整32(驻留("%"));
}

// 表达式入口：一元前缀（! / -）+ 原子 + 后缀（调用/成员/下标）链
函数 解析表达式(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    // 表达式首节点起点（三元包装时作条件段起点回填）
    整64 起始 = 池.大小();
    // 一元前缀（!/-/&/*）只在此处（表达式首 token）判定；操作数紧绑定——层5
    //   （原子+后缀链，嵌套前缀递归同覆，对齐 C 一元优先级 12）。原「递归
    //   解析表达式」把后随 ? 与低层二元吞进操作数（!x ? a : b 变 !(x?a:b)、
    //   !x + 1 变 !(x+1)）——三元接入（优先级 1.5 低于一元）后该语义缺陷
    //   可见化，统一改紧绑定（③ 第六波）：二元/三元由尾段统一处理
    整32 前缀类型 = 0;
    如果 (当前类型(记号, 位置) == 令牌_运算符) {
        整64 查前缀符号 = 整64(当前ID(记号, 位置));
        如果 (查前缀符号 == 驻留("!")) { 前缀类型 = 节点_逻辑非; }
        否则 如果 (查前缀符号 == 驻留("-")) { 前缀类型 = 节点_负号; }
        否则 如果 (查前缀符号 == 驻留("&")) { 前缀类型 = 节点_取地址; }
        否则 如果 (查前缀符号 == 驻留("*")) { 前缀类型 = 节点_解引用; }
    }
    如果 (前缀类型 != 0) {
        位置++;
        位置 = 解析层_子(记号, 位置, 池, 5, 字段偏移表, 真);
        池追加(池, 建节点(前缀类型, 0, 0, 整32(起始), 整32(池.大小())));
    } 否则 {
        位置 = 解析原子(记号, 位置, 池, 字段偏移表);
        位置 = 解析后缀链(记号, 位置, 池, 字段偏移表);
    }
    // P6c：仅当当前位置是二元运算符才进二元链（避免误解析后续标识符为左操作数）
    如果 (当前类型(记号, 位置) == 令牌_运算符) {
        整64 符号 = 整64(当前ID(记号, 位置));
        如果 (符号 == 驻留("+") || 符号 == 驻留("-") || 符号 == 驻留("*") || 符号 == 驻留("/") ||
             符号 == 驻留("%") || 符号 == 驻留("==") || 符号 == 驻留("!=") || 符号 == 驻留("<") ||
             符号 == 驻留(">") || 符号 == 驻留("<=") || 符号 == 驻留(">=") || 符号 == 驻留("&&") ||
             符号 == 驻留("||")) {
            位置 = 解析二元链(记号, 位置, 池, 字段偏移表);
        }
    }
    // 三元条件包装（③ 第六波，规范 01b 5.8）：条件段 = [起始, 池.大小())（本
    //   表达式前段已解析的全部节点——含前缀/原子/后缀链/二元链）。真值/假值
    //   均为完整表达式（递归含嵌套三元——假值递归实现右结合：
    //   a?b:c?d:e = a?b:(c?d:e)）。':' 缺失不消费（防御惯例：上层块循环保护
    //   中断、stderr 可见化——B6）；v2 无后缀错误传播 '?'，'?' 一律三元
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("?"))) {
        位置++;
        整64 真值起点 = 池.大小();
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(":"))) {
            位置++;
        }
        整64 假值起点 = 池.大小();
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        池追加(池, 建节点(节点_三元运算, 整32(真值起点), 假值起点, 整32(起始), 整32(池.大小())));
    }
    返回 位置;
}

// 解析后缀链：连续消费 调用/成员/下标（P6c 提取，供 表达式/二元操作数 复用）
函数 解析后缀链(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    整64 延续 = 1;
    当 (延续 == 1) {
        延续 = 0;
        如果 (当前类型(记号, 位置) == 令牌_运算符) {
            整64 符号 = 整64(当前ID(记号, 位置));
            如果 (符号 == 驻留("(")) {
                整64 参数起点 = 池.大小();
                整64 实参数 = 0;
                位置++;
                如果 (!(当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(")")))) {
                    当 (真) {
                        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
                        实参数++;
                        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(","))) { 位置++; 继续; }
                        中断;
                    }
                }
                如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(")"))) { 位置++; }
                // 簇②根治·B1（2026-09-04 用户裁决）：裸名调用命中 导入项们 →
                //   被调标识符（参数起点前一个节点——与 节点_调用.子起点 同位）
                //   原地改写合成限定名（导入 文件::打开文件 后裸调 打开文件(...)
                //   ≡ 文件::打开文件(...)——第五波限定名机制同构，局部副本+设置
                //   回写；语义白名单/IR 符号映射零改动即通）
                如果 (参数起点 > 0 && 参数起点 <= 池.大小()) {
                    节点 被调对象 = 池.元素(参数起点 - 1);
                    如果 (被调对象.类型 == 节点_标识符) {
                        结果<整64, 整32> 查项 = 导入项们.获取(整64(被调对象.文本));
                        如果 (查项.正常) {
                            被调对象.文本 = 整32(查项.值);
                            结果<空类型, 整32> 设被调 = 池.设置(参数起点 - 1, 被调对象);
                            如果 (!设被调.正常) { 运行时错误(4); }
                        }
                    }
                }
                // 实参数 存 附加（后缀求值 弹实参数量用；子区间=实参表达式节点数≠实参数）
                // P6g（2026-08-30）：子起点=被调标识符节点索引（参数起点前一个节点——
                //   后缀链原子标识符先入池；语义层据此识别 类型转换/函数调用）
                池追加(池, 建节点(节点_调用, 0, 实参数, 整32(参数起点 - 1), 0));
                延续 = 1;
            } 否则 如果 (符号 == 驻留(".")) {
                整32 成员名 = 当前ID(记号, 位置 + 1);
                位置 += 2;
                // P6e（2026-08-30）：字段偏移按结构体分桶——先经 变量结构体表 推导
                //   对象所属结构体（对象若是标识符），再按 结构体名ID*键位移+字段名ID
                //   查偏移。根治扁平表同名字段串偏移。v2.1（2026-09-03 用户裁决）：
                //   -> 成员访问废除——成员访问统一 .（对象为指针即自动解引用一级，
                //   p.字段 ≡ (*p).字段，原 ./-> 本就同路径同语义，语义/IR 零改动）。
                整64 偏移 = -1;
                整64 对象结构体ID = 0;
                节点 对象节点 = 池.元素(整64(池.大小()) - 1);
                如果 (对象节点.类型 == 节点_标识符) {
                    结果<整64, 整32> 查结构体 = 变量结构体表.获取(整64(对象节点.文本));
                    如果 (查结构体.正常) {
                        // 值=结构体名ID（1=结构体名标记，非对象结构体）
                        如果 (查结构体.值 != 1) {
                            对象结构体ID = 查结构体.值;
                        }
                    }
                }
                如果 (对象结构体ID != 0) {
                    结果<整64, 整32> 偏移查 = 字段偏移表.获取(对象结构体ID * 键位移 + 整64(成员名));
                    如果 (偏移查.正常) { 偏移 = 偏移查.值; }
                } 否则 {
                    // 回退：对象非标识符/未登记——按旧扁平键查（兼容链式 成员.字段）
                    结果<整64, 整32> 偏移查2 = 字段偏移表.获取(整64(成员名));
                    如果 (偏移查2.正常) { 偏移 = 偏移查2.值; }
                }
                // P7b：方法调用形态（成员名后紧跟 '('，如 表.追加(x)）——附加记
                //   方法标记，IR 层走容器方法调用；否则保持字段偏移（含 -1=未知）
                整64 附加值 = 偏移;
                如果 (当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留("("))) {
                    附加值 = 成员方法标记;
                }
                // 子起点=对象节点索引（池中对象在成员前，池大小-1）；子终点恒 0——
                //   对象的容器/结果类型经 查容器类型（变量容器表）查询，不占节点字段
                //   （曾存 子终点=类型ID——语义层把 [子起点,子终点) 当子表达式区间
                //   跨节点提前检查未注册标识符 -> 误报「未声明」，实测踩坑）
                池追加(池, 建节点(节点_成员, 成员名, 附加值, 整32(池.大小()) - 1, 0));
                延续 = 1;
            } 否则 如果 (符号 == 驻留("->")) {
                // v2.1（2026-09-03 用户裁决）：-> 成员访问已废除（统一 .，指针自动
                //   解引用一级）——后缀位 -> 为硬错误（行为与宿主对齐：拒绝+非零退出；
                //   宿主侧承载富迁移提示「请改用 .」，v2 自举组件按行号码面包屑惯例）。
                //   注意：-> 记号仍用于函数返回类型箭头（上方声明位分支，与本处无关）。
                //   硬错误无法进程内自检（会终止 v2p 自身），拒绝能力由宿主 E2E 135
                //   锚定 + v2 全源码零 -> 用法（E2E 128 链）双覆盖。
                运行时错误(302);
                延续 = 0;
            } 否则 如果 (符号 == 驻留("::")) {
                // ③ 第五波（2026-09-03）：限定名内置调用 IO::打印到错误(...) /
                //   文件::打开文件(...)（宿主 ir_call.cpp:217~235 权威——限定名
                //   内置全局可见无需导入，IR 映射裸 ASCII 符号直调）。仅支持
                //   「标识符::标识符(」调用形态（限定名无字段/无非调用形态）：
                //   把池尾对象标识符原地改写为合成限定名（"IO::打印到错误"），
                //   随后 '(' 分支自然形成 节点_调用（被调=限定标识符）——与容器
                //   构造合成名（向量$整64）同构，语义/IR 复用内置函数表，零新节点类型。
                布尔 限定命中 = 假;
                如果 (池.大小() > 0) {
                    节点 限定对象 = 池.元素(池.大小() - 1);
                    如果 (限定对象.类型 == 节点_标识符 &&
                         当前类型(记号, 位置 + 1) == 令牌_标识符 &&
                         位置 + 2 < 记号.大小() &&
                         当前类型(记号, 位置 + 2) == 令牌_运算符 &&
                         当前ID(记号, 位置 + 2) == 整32(驻留("("))) {
                        字符串 限定名 = 驻留文本(整64(限定对象.文本)) + "::" +
                                      当前文本(记号, 位置 + 1);
                        // 局部副本改写 + 设置 回写（元素(i) 是值视图——链式字段写
                        //   非宿主支持形态，124/126 实证：读=返地址、写=设置）
                        限定对象.文本 = 整32(驻留(限定名));
                        结果<空类型, 整32> 设限定 = 池.设置(池.大小() - 1, 限定对象);
                        如果 (!设限定.正常) { 运行时错误(4); }
                        位置 += 2;
                        限定命中 = 真;
                    }
                }
                如果 (限定命中) {
                    延续 = 1;
                } 否则 {
                    // 非「标识符::标识符(」形态（如 导入语句残留/未声明模块限定）：
                    //   中断后缀链（位置不推进）——上层按既有兜底处理，错误路径
                    //   由语义诊断/解析中断诊断可见化（静默丢弃家族防线）
                    延续 = 0;
                }
            } 否则 如果 (符号 == 驻留("[")) {
                // ③ 第二波：下标对象节点 = [ 前池末节点（后缀链对象先入池）；
                //   子区间 [子起点, 子终点) = 对象+下标表达式（不含本节点）——
                //   语义层据此检查对象形态（字符串白名单），IR 层弹对象+下标两值。
                //   （原建节点全 0 字段——子区间信息丢失，语义/IR 两层无从消费）
                整64 下标对象索引 = 整64(池.大小()) - 1;
                位置++;
                位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
                如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("]"))) { 位置++; }
                池追加(池, 建节点(节点_下标, 0, 0, 整32(下标对象索引), 整32(池.大小())));
                延续 = 1;
            }
        }
    }
    返回 位置;
}

// ==================== 二元运算（P3b） ====================
常量 节点_二元运算 = 15;

// 解析二元链：4 层优先级（P6b 扩展，对标规范 01b 优先级）
//   1=逻辑或 ||；2=逻辑与 &&；3=比较 == != < > <= >=；4=加减 + -；5=乘除 * / %
// 左结合；每层循环贪婪消费本层运算符。
函数 解析二元链(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    // 顶层链入口传 假：调用点（解析表达式 尾段）位置在二元运算符上——左操作数
    //   已由前段解析（空左操作数设计），不做一元前缀判定
    返回 解析二元层(记号, 位置, 池, 1, 字段偏移表, 假);
}

// 解析层_子：层5 -> 解析原子（操作数位含一元前缀）；其余 -> 下一层（操作数位贯通）。
//   操作数位=真：当前位置必为操作数起点（二元链右操作数——运算符已消费），
//   一元前缀（!/-/&/*）判定无二元歧义；=假：二元链入口（位置可能恰在运算符上
//   ——左操作数已由 解析表达式 前段解析的「空左操作数」设计），不做前缀判定
//   （消融实证：入口位判定把二元 -/* 误当前缀——减法/乘法全灭，123/129/130
//   回归实证：`0 - 28` 变 [0,负号(28)]、`f() * 10000` 变 解引用(10000)）。
//   前缀操作数紧绑定（本层递归=原子+后缀链，嵌套前缀同覆，对齐 C 一元优先级）；
//   表达式入口的全表达式贪婪语义保持不变（解析表达式 前缀段），两路径互不干扰。
函数 解析层_子(向量<Token> 记号, 整64 位置, 向量<节点> 池, 整64 层, 映射<整64, 整64>& 字段偏移表, 布尔 操作数位) -> 整64 {
    如果 (层 == 5) {
        如果 (操作数位 && 当前类型(记号, 位置) == 令牌_运算符) {
            整64 查前缀 = 整64(当前ID(记号, 位置));
            整32 前缀类型 = 0;
            如果 (查前缀 == 驻留("!")) { 前缀类型 = 节点_逻辑非; }
            否则 如果 (查前缀 == 驻留("-")) { 前缀类型 = 节点_负号; }
            否则 如果 (查前缀 == 驻留("&")) { 前缀类型 = 节点_取地址; }
            否则 如果 (查前缀 == 驻留("*")) { 前缀类型 = 节点_解引用; }
            如果 (前缀类型 != 0) {
                位置++;
                整64 操作数起点 = 池.大小();
                位置 = 解析层_子(记号, 位置, 池, 5, 字段偏移表, 真);
                池追加(池, 建节点(前缀类型, 0, 0, 整32(操作数起点), 整32(池.大小())));
                返回 位置;
            }
        }
        位置 = 解析原子(记号, 位置, 池, 字段偏移表);
        返回 解析后缀链(记号, 位置, 池, 字段偏移表);
    }
    返回 解析二元层(记号, 位置, 池, 层 + 1, 字段偏移表, 操作数位);
}

// 解析二元层：先子层，再循环本层运算符（左结合）
函数 解析二元层(向量<Token> 记号, 整64 位置, 向量<节点> 池, 整64 层, 映射<整64, 整64>& 字段偏移表, 布尔 操作数位) -> 整64 {
    // 短路层（1=|| 2=&&）记录左操作数首节点——操作数区间标注用（短路求值）。
    //   入口子调用传 假：二元链入口位置可能恰在运算符上（空左操作数设计——
    //   左操作数由 解析表达式 前段解析），此处不做一元前缀判定（防二元 -/* 误判）
    整64 左起点 = 池.大小();
    // 入口子调用贯通 操作数位：本层由 子(上层, 操作数位) 下降而来时入口即外层
    //   右操作数位（前缀该判）；顶层链入口（解析二元链）已显式传 假（运算符位）
    位置 = 解析层_子(记号, 位置, 池, 层, 字段偏移表, 操作数位);
    位置 = 解析二元循环(记号, 位置, 池, 层, 字段偏移表, 左起点);
    返回 位置;
}

// 本层循环：贪婪消费本层运算符（层匹配）
函数 解析二元循环(向量<Token> 记号, 整64 位置, 向量<节点> 池, 整64 层, 映射<整64, 整64>& 字段偏移表, 整64 左起点) -> 整64 {
    如果 (当前类型(记号, 位置) != 令牌_运算符) { 返回 位置; }
    整64 符号 = 整64(当前ID(记号, 位置));
    整64 层匹配 = 0;
    如果 (符号 == 驻留("||")) { 层匹配 = 1; }
    否则 如果 (符号 == 驻留("&&")) { 层匹配 = 2; }
    否则 如果 (符号 == 驻留("==") || 符号 == 驻留("!=") || 符号 == 驻留("<") ||
              符号 == 驻留(">") || 符号 == 驻留("<=") || 符号 == 驻留(">=")) { 层匹配 = 3; }
    否则 如果 (符号 == 驻留("+") || 符号 == 驻留("-")) { 层匹配 = 4; }
    否则 如果 (符号 == 驻留("*") || 符号 == 驻留("/") || 符号 == 驻留("%")) { 层匹配 = 5; }
    如果 (层匹配 == 0 || 层匹配 != 层) { 返回 位置; }
    整32 op符号 = 当前ID(记号, 位置);
    位置++;
    整64 右起点 = 池.大小();
    // ③ 第五波：右操作数子调用传 真（运算符已消费——当前位置必为操作数起点，
    //   一元前缀判定无二元歧义；`X || !f(...)`/`a * -b` 右操作数前缀由此支持）
    位置 = 解析层_子(记号, 位置, 池, 层, 字段偏移表, 真);
    如果 (层 <= 2) {
        // 短路运算符（||/&&）标注操作数后缀区间（缺陷B根治，2026-09-02）：
        //   [子起点, 子终点) = 左右操作数节点区间（不含本节点），附加 = 右操作数
        //   起点。IR 生成据此延迟求值右操作数（规范 930：短路求值语义）。
        池追加(池, 建节点(节点_二元运算, op符号, 右起点, 整32(左起点), 整32(池.大小())));
    } 否则 {
        // ③ 第二波（方案A）：普通二元同样标注 子起点=左起点/附加=右起点（子终点
        //   恒 0 与短路区分——预扫以 子终点!=0 且 op 名双条件识别短路）。IR 生成
        //   拼接左侧末端节点推导兜底据此定位左操作数末节点（右末端=位置-1 已有）。
        池追加(池, 建节点(节点_二元运算, op符号, 右起点, 整32(左起点), 0));
    }
    返回 解析二元循环(记号, 位置, 池, 层, 字段偏移表, 左起点);
}


// 解析函数声明：函数 名(参数...) -> 返回类型 { 体 }
函数 解析函数声明(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    如果 (是关键(记号, 位置, "函数")) { 位置++; }
    整32 名ID = 当前ID(记号, 位置);
    位置++;
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("("))) { 位置++; }
    整64 参数起点 = 池.大小();
    如果 (!(当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(")")))) {
        当 (真) {
            位置 = 解析参数(记号, 位置, 池);
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(","))) { 位置++; 继续; }
            中断;
        }
    }
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(")"))) { 位置++; }
    整32 返回类型ID = 0;
    // 返回类型箭头：词法 P6b 已合并为单 token "->"（兼容旧双 token 判断）
    //   P7b：泛型返回类型（如 -> 向量<整32>）经 解析类型文本 合成 $ 实例名
    //   2026-09-04 缺陷零容忍收口：返回类型引用后缀（-> 整64&，宿主 P3-18
    //   引用返回对齐）——解析类型文本 外层位不消费 &，此处显式并入类型名
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("->"))) {
        位置++;
        整64 类型位置 = 位置;
        字符串 返回类型名 = 解析类型文本(记号, &类型位置, 假);
        如果 (字符串长度(返回类型名) > 0) {
            位置 = 类型位置;
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("&"))) {
                返回类型名 = 返回类型名 + "&";
                位置++;
            }
            返回类型ID = 整32(驻留(返回类型名));
        } 否则 {
            返回类型ID = 当前ID(记号, 位置);
            位置++;
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("&"))) {
                位置++;
            }
        }
    } 否则 如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("-")) && 位置 + 1 < 记号.大小() && 当前ID(记号, 位置 + 1) == 整32(驻留(">"))) {
        位置 += 2;
        返回类型ID = 当前ID(记号, 位置);
        位置++;
    }
    整64 块起点 = 池.大小();
    位置 = 解析块(记号, 位置, 池, 字段偏移表);
    整32 块索引 = 整32(池.大小()) - 1;
    池追加(池, 建节点(节点_函数, 名ID, 整64(返回类型ID), 整32(参数起点), 块索引));
    返回 位置;
}

// 解析结构体声明：结构体 名 { 类型 字段... }
函数 解析结构体声明(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    如果 (是关键(记号, 位置, "结构体")) { 位置++; }
    整32 名ID = 当前ID(记号, 位置);
    位置++;
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("{"))) { 位置++; }
    整64 字段起点 = 池.大小();
    // ②b B1（2026-09-02）：字段按真实类型大小+自然对齐布局（对齐宿主 typeSizeOf——
    //   旧 8 字节平铺对 整32 字段错误）。结构体大小/对齐入静态表（元素步长/拷贝
    //   大小/结构体局部多槽/字段级析构注入 用）。
    整64 字段偏移 = 0;
    整64 最大对齐 = 1;
    当 (真) {
        如果 (当前类型(记号, 位置) == 令牌_文件结束) { 中断; }
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("}"))) { 位置++; 中断; }
        整64 类型节点 = 池.大小();
        位置 = 解析类型(记号, 位置, 池);
        如果 (当前类型(记号, 位置) == 令牌_标识符) {
            整64 字段大小 = 8;
            整64 字段对齐 = 8;
            节点 类型节点值 = 池.元素(整32(类型节点));
            类型大小与对齐(驻留文本(整64(类型节点值.文本)), &字段大小, &字段对齐);
            整64 余 = 字段偏移 % 字段对齐;
            如果 (余 != 0) { 字段偏移 = 字段偏移 + (字段对齐 - 余); }
            // P6e：字段偏移按结构体分桶——键 = 结构体名ID*键位移+字段名ID，
            //   根治扁平 字段名->偏移 单映射的同名字段串偏移（点.x 与 矩形.x）。
            整64 分桶键 = 整64(名ID) * 键位移 + 整64(当前ID(记号, 位置));
            结果<空类型, 整32> 加表 = 字段偏移表.设置(分桶键, 字段偏移);
            如果 (!加表.正常) { 运行时错误(4); }
            // B4 预置：字段类型登记（资源字段析构注入用；表在 IR容器——避免导入环）
            登记字段类型(分桶键, 整64(类型节点值.文本));
            // ②c B：容器字段登记（指针槽模型——RAII 级联析构/字段读 LoadPtr->this/
            //   方法对象类型推导 用；四元组：结构体/字段名/字段容器类型/偏移）
            字符串 字段类型文本 = 驻留文本(整64(类型节点值.文本));
            如果 (是容器类(字段类型文本)) {
                登记容器字段(整64(名ID), 整64(当前ID(记号, 位置)), 整64(类型节点值.文本), 字段偏移);
            }
            // ②b B5：字段偏移分桶登记（IR 层链式成员 池.元素(i).字段 偏移收口用——
            //   语法层 解析后缀链 对调用对象只能扁平回退，同名字段跨结构体必错）
            登记字段偏移(分桶键, 字段偏移);
            如果 (字段对齐 > 最大对齐) { 最大对齐 = 字段对齐; }
            字段偏移 = 字段偏移 + 字段大小;
            池追加(池, 建节点(节点_参数, 当前ID(记号, 位置), 整64(类型节点), 0, 0));
            位置++;
        }
        // plans/015（2026-09-04）：字段间分号宽松消费——全库迁移后结构体字段带
        //   分号，原循环不消费 ';' 会零消费死循环（127 用例 v2p 编译卡死实证）；
        //   声明体成员分隔保持宽松语义（不强制不诊断，与宿主 match 同款）
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(";"))) { 位置++; }
    }
    // 结构体大小 = 尾部对齐到 最大对齐（自然对齐，对齐宿主 typeSizeOf）
    整64 尾余 = 字段偏移 % 最大对齐;
    如果 (尾余 != 0) { 字段偏移 = 字段偏移 + (最大对齐 - 尾余); }
    登记结构体布局(整64(名ID), 字段偏移, 最大对齐);
    // P6e：登记结构体名标记（变量结构体表：结构体名ID -> 1），供变量声明/参数
    //   识别"类型是结构体"（查表命中即结构体类型，登记 变量名ID -> 结构体名ID）
    结果<空类型, 整32> 加名 = 变量结构体表.设置(整64(名ID), 1);
    如果 (!加名.正常) { 运行时错误(4); }
    池追加(池, 建节点(节点_结构体, 名ID, 0, 整32(字段起点), 整32(池.大小())));
    返回 位置;
}

// ==================== 导入扫描与模块登记（P6h 多源文件） ====================
// 簇②根治·B1（2026-09-04 用户裁决：导入项登记+裸名改写）：`导入 路径::项` 的
//   项名 -> 限定名 映射（打开文件 -> 文件::打开文件）。语义层此前对导入语句
//   零登记——裸名 打开文件(...) 调用查表失败（冒烟簇② 4 错：标识符+函数双报）。
//   调用形成时（解析后缀链 '(' 分支）池尾被调标识符命中本表 → 原地改写合成
//   限定名（第五波 IO::/文件:: 机制同构复用），语义白名单/IR 符号映射零改动。
//   文件作用域：扫描导入 入口清空（加载器每文件先 扫描导入 后 解析程序——
//   跨文件残留会让未导入文件裸调也被改写，违反规范 08 导入项绑定本文件）。
//   诚实边界：通配符 导入 路径::* 不登记（全项展开需 stdlib 符号清单，v2 组件
//   未用此形态）；同名项多来源先到先得（设置 不覆盖——首登记胜出）。
静态 映射<整64, 整64> 导入项们;

// 登记导入项（项名ID -> 限定名ID；首登记胜出，不覆盖）
函数 导入项登记(整64 项名ID, 整64 限定名ID) -> 空类型 {
    结果<整64, 整32> 已有 = 导入项们.获取(项名ID);
    如果 (已有.正常) { 返回; }
    结果<空类型, 整32> 加项 = 导入项们.设置(项名ID, 限定名ID);
    如果 (!加项.正常) { 运行时错误(4); }
}

// 登记导入模块名（去重；扫描导入 与 解析程序 顶层 均调用，幂等）
函数 模块登记(整32 模块名ID) -> 空类型 {
    整64 i = 0;
    当 (i < 导入模块们.大小()) {
        如果 (导入模块们.元素(i) == 模块名ID) { 返回; }
        i++;
    }
    结果<空类型, 整32> 加 = 导入模块们.追加(模块名ID);
    如果 (!加.正常) { 运行时错误(4); }
}

// 取走本文件导入模块列表（消费后清空；主.cn 每解析完一个文件调用，
//   据此递归加载模块文件——依赖模块须先解析，结构体偏移推导才正确）
函数 取走导入模块们() -> 向量<整32> {
    向量<整32> 模块列表 = 导入模块们;
    导入模块们 = 向量<整32>();
    返回 模块列表;
}

// 簇②根治·B1：登记导入项们（项名 -> 限定名；路径::项 / ::{项列表} / 项 作为 别名
//   三形态；通配 * 不登记——见 导入项们 边界注释）。不清空（调用方负责）。
//   时序纪律：登记必须紧贴本文件 解析程序——加载器「依赖先解析」会穿插其他文件
//   的扫描+解析，若在 扫描导入 清空+登记，本文件项会被依赖文件的登记窗口抹掉
//   （IR签名 登记 打开文件 → 词法分析 递归清空 → 回到 IR签名 解析时已丢——
//   实测 4 错残留即此）。故 解析程序 入口 清空+重扫 为权威登记点。
函数 登记导入项们(向量<Token> 记号) -> 空类型 {
    整64 位置 = 0;
    当 (位置 < 记号.大小()) {
        如果 (当前类型(记号, 位置) == 令牌_关键字 && 当前ID(记号, 位置) == 整32(驻留("导入"))) {
            位置++;
            如果 (!(位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_标识符)) { 位置++; 继续; }
            // 显式保存路径首段（模块名）——限定名构造一律用它，不按位置偏移
            //   反查（花括号形态 位置-2 会取到 :: 而非模块名——E2E 143 首跑
            //   「::::文件存在」6 错实证）
            字符串 模块名 = 当前文本(记号, 位置);
            位置++;
            如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == 整32(驻留("::"))) {
                位置++;
                如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留("{"))) {
                    // 导入 路径::{项, 项}：逐项登记（限定名=模块名+::+项名）
                    位置++;
                    当 (位置 < 记号.大小() &&
                         !(当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("}")))) {
                        如果 (当前类型(记号, 位置) == 令牌_标识符) {
                            字符串 限定名 = 模块名 + "::" + 当前文本(记号, 位置);
                            导入项登记(整64(当前ID(记号, 位置)), 驻留(限定名));
                            位置++;
                            // 项 作为 别名：别名也登记同限定名
                            如果 (位置 + 1 < 记号.大小() && 当前类型(记号, 位置) == 令牌_标识符 &&
                                 当前ID(记号, 位置) == 整32(驻留("作为"))) {
                                位置++;
                                如果 (当前类型(记号, 位置) == 令牌_标识符) {
                                    导入项登记(整64(当前ID(记号, 位置)), 驻留(限定名));
                                    位置++;
                                }
                            }
                            继续;
                        }
                        位置++;
                    }
                } 否则 {
                    // 导入 路径::符号 或 导入 路径::*：符号登记（通配跳过）
                    如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_标识符) {
                        字符串 限定名 = 模块名 + "::" + 当前文本(记号, 位置);
                        导入项登记(整64(当前ID(记号, 位置)), 驻留(限定名));
                        位置++;
                        // 符号 作为 别名
                        如果 (位置 + 1 < 记号.大小() && 当前类型(记号, 位置) == 令牌_标识符 &&
                             当前ID(记号, 位置) == 整32(驻留("作为"))) {
                            位置++;
                            如果 (当前类型(记号, 位置) == 令牌_标识符) {
                                导入项登记(整64(当前ID(记号, 位置)), 驻留(限定名));
                                位置++;
                            }
                        }
                    } 否则 {
                        位置++;
                    }
                }
            }
            继续;
        }
        位置++;
    }
}

// P6h：轻量预扫描 Token 流中的 导入 语句（登记模块名，供加载器在解析前
//   得知依赖）。规范（08 模块系统）：导入 路径 [作为 标识符] / 导入 路径::{项}
//   / 导入 路径::*——路径首段为模块名（容器/文件/词法分析…），std 模块跳过加载。
//   簇②根治·B1：项登记在此顺带执行（幂等），但**权威登记点在 解析程序 入口**
//   （清空+重扫）——见 登记导入项们 时序纪律注释。
函数 扫描导入(向量<Token> 记号) -> 空类型 {
    登记导入项们(记号);
    整64 位置 = 0;
    当 (位置 < 记号.大小()) {
        如果 (当前类型(记号, 位置) == 令牌_关键字 && 当前ID(记号, 位置) == 整32(驻留("导入"))) {
            位置++;
            如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_标识符) {
                模块登记(当前ID(记号, 位置));
                位置++;
            }
            如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
                 当前ID(记号, 位置) == 整32(驻留("::"))) {
                位置++;
                如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
                     当前ID(记号, 位置) == 整32(驻留("{"))) {
                    // 导入 路径::{项}：跳到 } 之后
                    当 (位置 < 记号.大小() &&
                         !(当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("}")))) {
                        位置++;
                    }
                } 否则 {
                    // 导入 路径::符号 或 导入 路径::*：跳过符号/通配符
                    位置++;
                }
            } 否则 如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_标识符 &&
                         当前ID(记号, 位置) == 整32(驻留("作为"))) {
                // 导入 路径 作为 别名：跳过别名
                位置 += 2;
            }
            继续;
        }
        位置++;
    }
}

// P6h：多文件下 变量结构体表 跨文件保留（字段偏移推导须看到全部结构体声明），
//   清空 由加载器在每次编译任务开始前显式调用（原先 解析程序 内清空 已移除）
函数 清空变量结构体表() -> 空类型 {
    变量结构体表.清空();
}

// P7b：清空变量容器表（与 清空变量结构体表 同位调用——加载器任务开始前）
函数 清空变量容器表() -> 空类型 {
    变量容器表.清空();
}

// P7b：查变量容器类型（IR 层成员访问/方法调用经此查对象类型；0=非容器/结果变量）
函数 查容器类型(整64 名ID) -> 整64 {
    结果<整64, 整32> 查 = 变量容器表.获取(名ID);
    如果 (查.正常) { 返回 查.值; }
    返回 0;
}

// ②b B5：查变量结构体类型（IR 层成员访问宽度解析用；0=非结构体变量。
//   值=1 是结构体名标记（解析结构体声明 登记），非对象类型——过滤）
函数 查结构体类型(整64 名ID) -> 整64 {
    结果<整64, 整32> 查 = 变量结构体表.获取(名ID);
    如果 (查.正常) {
        如果 (查.值 != 1) { 返回 查.值; }
    }
    返回 0;
}

// 解析常量声明（P7a，2026-09-01）：常量 名 = 表达式（类型推断，规范 5.2）。
//   节点字段：文本=名ID，子区间=初始化表达式（整数字面量 或 负号字面量——
//   负数经 解析表达式 一元前缀自然成 [字面量, 负号] 区间，IR 层折叠识别）。
//   显式类型形式（常量 整64 名 = 值）本轮不解析——v2 组件源码全部为推断式。
函数 解析常量声明(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    如果 (是关键(记号, 位置, "常量")) { 位置++; }
    整32 名ID = 当前ID(记号, 位置);
    位置++;
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("="))) { 位置++; }
    整64 值起点 = 池.大小();
    位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
    池追加(池, 建节点(节点_常量声明, 名ID, 0, 整32(值起点), 整32(池.大小())));
    返回 吃分号(记号, 位置);
}

// 解析静态声明（②c C，2026-09-02，规范 03-一）：静态 类型 名 [= 表达式]。
//   容器静态裸声明（E2E 121 形状——入口 NewObject+构造）；标量静态初始值
//   IR 层折叠直存 .data。容器/结构体静态在此登记 变量容器表/变量结构体表
//   （跨文件保留——成员/方法解析与局部变量同路）。
函数 解析静态声明(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    如果 (是关键(记号, 位置, "静态")) { 位置++; }
    整64 类型节点 = 池.大小();
    位置 = 解析类型(记号, 位置, 池);
    整32 名ID = 当前ID(记号, 位置);
    位置++;
    节点 类型节点值 = 池.元素(类型节点);
    字符串 类型文本 = 驻留文本(整64(类型节点值.文本));
    // 容器静态登记 变量容器表（方法调用对象类型解析：池.追加 ——跨函数可见）
    如果 (是容器类(类型文本) || 是结果类型(类型文本)) {
        结果<空类型, 整32> 加静态容器 = 变量容器表.设置(整64(名ID), 整64(类型节点值.文本));
        如果 (!加静态容器.正常) { 运行时错误(4); }
    } 否则 {
        // 结构体静态登记 变量结构体表（值形态才可能是结构体对象）
        如果 (类型节点值.附加 == 0) {
            结果<整64, 整32> 查名 = 变量结构体表.获取(整64(类型节点值.文本));
            如果 (查名.正常) {
                结果<空类型, 整32> 加静态结构 = 变量结构体表.设置(整64(名ID), 整64(类型节点值.文本));
                如果 (!加静态结构.正常) { 运行时错误(4); }
            }
        }
    }
    整64 值起点 = 池.大小();
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("="))) {
        位置++;
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
    }
    池追加(池, 建节点(节点_静态声明, 名ID, 整64(类型节点), 整32(值起点), 整32(池.大小())));
    返回 吃分号(记号, 位置);
}

// 解析完整程序：顶层声明序列（函数/结构体/常量/导入——导入 由 扫描导入 先行登记）
//   簇②根治·B1：入口 清空+重扫 导入项们（权威登记点——紧贴本文件解析，
//   防依赖文件的扫描/解析窗口抹掉本文件登记，见 登记导入项们 时序纪律注释）
函数 解析程序(向量<Token> 记号, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    导入项们.清空();
    登记导入项们(记号);
    整64 位置 = 0;
    整64 程序起点 = 池.大小();
    当 (位置 < 记号.大小()) {
        如果 (当前类型(记号, 位置) == 令牌_文件结束) { 中断; }
        如果 (是关键(记号, 位置, "函数")) {
            位置 = 解析函数声明(记号, 位置, 池, 字段偏移表);
        } 否则 如果 (是关键(记号, 位置, "结构体")) {
            位置 = 解析结构体声明(记号, 位置, 池, 字段偏移表);
        } 否则 如果 (是关键(记号, 位置, "常量")) {
            位置 = 解析常量声明(记号, 位置, 池, 字段偏移表);
        } 否则 如果 (是关键(记号, 位置, "静态")) {
            // ②c C：顶层静态声明（静态 向量<整64> 池——v2 组件遍布此形态，③ 前置）
            位置 = 解析静态声明(记号, 位置, 池, 字段偏移表);
        } 否则 {
            位置++;
        }
    }
    池追加(池, 建节点(节点_程序, 0, 0, 整32(程序起点), 整32(池.大小())));
    返回 位置;
}

// ==================== 泛型类型支持（P7b，2026-09-01） ====================
// 合成实例类型名（对标宿主 resolveGenericTypeName/instantiateGeneric）：
//   名<实参1,实参2> -> 名$实参1$实参2（嵌套实参先递归实例化再拼入——扁平 $ 连接，
//   宿主 generics.cpp:346 同款；映射<整64,整64> -> 映射$整64$整64）。
//   v2 全链路（语法/语义/IR/代码生成）统一使用 $ 合成名，生成表达式零转换。

// 泛型角括号约束扫描：从 位置（须为 '<'）平衡扫描找闭合 '>'；
//   尖括号内只允许 标识符/','/'*'/'&'/'<'/'>'（类型形态）——遇其他 token（如
//   比较表达式 a<b && c>d 的 '&&'）返回 -1（非泛型形态）。返回闭合 '>' 的位置。
函数 泛型闭合位置(向量<Token> 记号, 整64 位置) -> 整64 {
    如果 (!(位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
           当前ID(记号, 位置) == 整32(驻留("<")))) { 返回 -1; }
    整64 深度 = 0;
    整64 i = 位置;
    当 (i < 记号.大小()) {
        整32 t = 当前类型(记号, i);
        整64 id = 整64(当前ID(记号, i));
        如果 (t == 令牌_运算符 && id == 整64(驻留("<"))) {
            深度++;
        } 否则 如果 (t == 令牌_运算符 && id == 整64(驻留(">"))) {
            深度--;
            如果 (深度 == 0) { 返回 i; }
        } 否则 如果 (t == 令牌_标识符) {
            // 类型名/类型参数（Token 白名单）
        } 否则 如果 (t == 令牌_运算符 && (id == 整64(驻留(",")) ||
                   id == 整64(驻留("*")) || id == 整64(驻留("&")))) {
            // 逗号分隔 / 指针 / 引用后缀
        } 否则 {
            返回 -1;
        }
        i++;
    }
    返回 -1;
}

// 解析类型文本（P7b）：递归合成 $ 实例名；位置 出参推进。
//   非类型形态返回 空串（位置不动）。参数 是实参：真=泛型实参递归位——后缀
//   `*`/`&` 由本函数消费并入合成名（对齐宿主 canonical 保留尾 `*` 的约定）；
//   假=外层类型位——后缀留给 解析类型 的指针层/引用登记循环（797 区，抢吃会
//   使 整64* 指针层数归零、变量结构体表失配）。
//   簇④根治（2026-09-04，语法分析.cn 冒烟簇②再分诊揪出）：原递归实参只析出
//   裸名（空类型* 只取 空类型），星号留在 token 流使 `结果<空类型*, 整32> 名 = ...`
//   整条声明错位解析（`,` `整32` `>` 成孤儿 token 切成垃圾语句——赋值左值错位
//   报「可写左值」+ 声明名吞掉级联未声明；A/B 探针实证：无星号 0 错/星号 3 错）。
函数 解析类型文本(向量<Token> 记号, 整64* 位置, 布尔 是实参) -> 字符串 {
    如果 (当前类型(记号, 位置[0]) != 令牌_标识符) { 返回 ""; }
    字符串 名 = 驻留文本(整64(当前ID(记号, 位置[0])));
    位置[0] = 位置[0] + 1;
    // 泛型实参：类型位置 '<' 无比较歧义（泛型闭合位置 约束扫描防御）
    如果 (当前类型(记号, 位置[0]) == 令牌_运算符 &&
         当前ID(记号, 位置[0]) == 整32(驻留("<"))) {
        整64 闭合 = 泛型闭合位置(记号, 位置[0]);
        如果 (闭合 == -1) { 返回 名; }  // 非泛型形态：按裸名（防御，正常不达）
        位置[0] = 位置[0] + 1;  // 吃 '<'
        当 (真) {
            字符串 实参 = 解析类型文本(记号, 位置, 真);
            如果 (字符串长度(实参) > 0) { 名 = 名 + "$" + 实参; }
            如果 (当前类型(记号, 位置[0]) == 令牌_运算符 &&
                 当前ID(记号, 位置[0]) == 整32(驻留(","))) {
                位置[0] = 位置[0] + 1;
                继续;
            }
            中断;
        }
        如果 (当前类型(记号, 位置[0]) == 令牌_运算符 &&
             当前ID(记号, 位置[0]) == 整32(驻留(">"))) { 位置[0] = 位置[0] + 1; }
    }
    // 簇④根治：仅实参位消费后缀 `*`/`&` 并入合成名（空类型* -> 名 + "*"，可多层）
    如果 (是实参) {
        当 (当前类型(记号, 位置[0]) == 令牌_运算符 &&
             (当前ID(记号, 位置[0]) == 整32(驻留("*")) ||
              当前ID(记号, 位置[0]) == 整32(驻留("&")))) {
            名 = 名 + 驻留文本(整64(当前ID(记号, 位置[0])));
            位置[0] = 位置[0] + 1;
        }
    }
    返回 名;
}

// 是泛型声明（P7b）：标识符 <类型实参> 标识符 —— 局部变量/参数声明前瞻
//   （防 a<b 比较表达式误判：约束扫描 + 闭合后必须是标识符=变量名）。
//   IR生成.cn 冒烟 96 错根治（2026-09-04）：闭合后 '& 标识符' 同认——泛型
//   引用局部声明 `向量<IR指令>& 指令 = 函数信息.指令;`（引用后缀留给
//   解析类型 的引用登记循环，与指针层同机制）。裸类型引用（类型& 名）宿主
//   parser 亦不支持——双侧一致边界，不引入。
函数 是泛型声明(向量<Token> 记号, 整64 位置) -> 布尔 {
    如果 (当前类型(记号, 位置) != 令牌_标识符) { 返回 假; }
    如果 (位置 + 1 >= 记号.大小()) { 返回 假; }
    整64 闭合 = 泛型闭合位置(记号, 位置 + 1);
    如果 (闭合 == -1) { 返回 假; }
    如果 (当前类型(记号, 闭合 + 1) == 令牌_标识符) { 返回 真; }
    // 泛型引用声明：闭合后 '&' 且其后是标识符=变量名（解析类型 消费 '&' 置
    //   引用标记 附加=256）
    返回 当前类型(记号, 闭合 + 1) == 令牌_运算符 &&
           当前ID(记号, 闭合 + 1) == 整32(驻留("&")) &&
           闭合 + 2 < 记号.大小() &&
           当前类型(记号, 闭合 + 2) == 令牌_标识符;
}

// 是构造调用（P7b）：标识符 <类型实参> ( —— 如 向量<整64>()。
//   闭合后是 '(' 才认定（防 比较/移位误判）。
函数 是构造调用(向量<Token> 记号, 整64 位置) -> 布尔 {
    如果 (当前类型(记号, 位置) != 令牌_标识符) { 返回 假; }
    如果 (位置 + 1 >= 记号.大小()) { 返回 假; }
    整64 闭合 = 泛型闭合位置(记号, 位置 + 1);
    如果 (闭合 == -1) { 返回 假; }
    如果 (闭合 + 1 >= 记号.大小()) { 返回 假; }
    返回 当前类型(记号, 闭合 + 1) == 令牌_运算符 &&
           当前ID(记号, 闭合 + 1) == 整32(驻留("("));
}

// 解析类型：类型前置，支持 类型* 指针（P6c）/ 泛型实参（P7b）/ & 引用（P7b 登记）
// 节点_类型：文本=$合成类型名ID（向量$整64）或裸名ID；附加=指针层数 + 引用*256
函数 解析类型(向量<Token> 记号, 整64 位置, 向量<节点> 池) -> 整64 {
    如果 (当前类型(记号, 位置) == 令牌_标识符) {
        整64 类型位置 = 位置;
        字符串 合成名 = 解析类型文本(记号, &类型位置, 假);
        如果 (字符串长度(合成名) == 0) { 返回 位置; }
        位置 = 类型位置;
        整32 类型名ID = 整32(驻留(合成名));
        整64 指针层 = 0;
        整64 引用 = 0;
        当 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("*"))) {
            指针层++;
            位置++;
        }
        如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("&"))) {
            引用 = 1;
            位置++;
        }
        池追加(池, 建节点(节点_类型, 类型名ID, 指针层 + 引用 * 256, 0, 0));
        返回 位置;
    }
    返回 位置;
}

// 解析参数：类型 名
函数 解析参数(向量<Token> 记号, 整64 位置, 向量<节点> 池) -> 整64 {
    整64 类型节点 = 池.大小();
    位置 = 解析类型(记号, 位置, 池);
    如果 (当前类型(记号, 位置) == 令牌_标识符) {
        整32 参数名ID = 当前ID(记号, 位置);
        // P6e：参数若是结构体类型（值语义），登记 变量名ID -> 结构体名ID，
        //   成员访问（位置.x）据此推导对象所属结构体、查分桶字段偏移。
        //   ②c D：引用形态（附加=256）同样登记——b.编号 成员基址=槽内容（调用方
        //   结构体地址），IR 层按 引用参数槽们 单独处理基址来源。
        节点 类型节点值 = 池.元素(类型节点);
        如果 (类型节点值.附加 == 0 || 类型节点值.附加 == 256) {
            结果<整64, 整32> 查名 = 变量结构体表.获取(整64(类型节点值.文本));
            如果 (查名.正常) {  // 类型名是已声明结构体
                结果<空类型, 整32> 加参 = 变量结构体表.设置(整64(参数名ID), 整64(类型节点值.文本));
                如果 (!加参.正常) { 运行时错误(4); }
            }
        }
        // P7b：容器/结果 参数登记 变量容器表（被调内成员调用预标注；引用参数同）
        字符串 参数类型文本 = 驻留文本(整64(类型节点值.文本));
        如果 (是容器类(参数类型文本) || 是结果类型(参数类型文本)) {
            结果<空类型, 整32> 加参数容器 = 变量容器表.设置(整64(参数名ID), 整64(类型节点值.文本));
            如果 (!加参数容器.正常) { 运行时错误(4); }
        }
        池追加(池, 建节点(节点_参数, 参数名ID, 整64(类型节点), 0, 0));
        返回 位置 + 1;
    }
    池追加(池, 建节点(节点_参数, 0, 整64(类型节点), 0, 0));
    返回 位置;
}

// 吃分号（plans/015 方案B 强制分号，2026-09-04 用户裁决）：语句必须 ';' 终结——
//   缺失即 stderr 诊断+语法错误数 计数（错误即诊断，块截断静默家族整体消亡）；
//   不推进位置（解析块 循环继续解析下条语句，一次编译报全量缺分号位置——
//   对齐宿主 consumeSemicolon 纪律）。行号取当前 token（下一语句起点）。
函数 吃分号(向量<Token> 记号, 整64 位置) -> 整64 {
    如果 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 &&
         当前ID(记号, 位置) == 整32(驻留(";"))) {
        返回 位置 + 1;
    }
    语法错误数++;
    整64 行号 = 0;
    如果 (记号.大小() > 0) {
        // 行号取前一 token（语句结尾 token）——对齐宿主 consumeSemicolon
        //   诊断位置纪律（缺陷③连带：原取下一语句起点行，偏 +1）
        整64 取行位置 = 位置 - 1;
        如果 (取行位置 < 0) { 取行位置 = 0; }
        如果 (取行位置 >= 记号.大小()) { 取行位置 = 记号.大小() - 1; }
        行号 = 整64(记号.元素(取行位置).行);
    }
    IO::打印到错误("[parse] 语句缺少分号 ';'（行=" + 整数转字符串(行号) + "）\n");
    返回 位置;
}
// 解析语句
函数 解析语句(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    // ②b B4（2026-09-02）：裸块语句 { ... }（块级作用域——126 ④a RAII 载体）。
    //   旧版无此分支：解析块 遇 { 落入表达式兜底不消费 -> 循环保护中断，
    //   块内及后续全部语句静默丢失（实测 126 返回 0 丢失 -> 垃圾退出码 20）。
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("{"))) {
        返回 解析块(记号, 位置, 池, 字段偏移表);
    }
    如果 (是关键(记号, 位置, "返回")) {
        位置++;
        整64 值起点 = 池.大小();
        // 灰色点②方案A（2026-09-04）：字符串 != 字面量 原按驻留地址比较（依赖
        //   驻留恒等的实现细节，宿主已显式拒绝）——改 字符串比较 内容判定
        如果 (当前类型(记号, 位置) != 令牌_运算符 || !字符串比较(当前文本(记号, 位置), "}")) {
            位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        }
        池追加(池, 建节点(节点_返回语句, 0, 0, 整32(值起点), 整32(池.大小())));
        返回 吃分号(记号, 位置);
    }
    如果 (是关键(记号, 位置, "如果")) {
        位置++;
        整64 条件起点 = 池.大小();
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        整64 条件终点 = 池.大小();
        位置 = 解析块(记号, 位置, 池, 字段偏移表);
        整64 真块索引 = 整64(池.大小()) - 1;   // 解析块 最后追加 块 节点
        // 否则链：否则 如果 ... / 否则 { ... }（P6b）
        整64 否则索引 = 0;
        如果 (是关键(记号, 位置, "否则")) {
            位置++;
            如果 (是关键(记号, 位置, "如果")) {
                // 否则 如果 -> 递归解析为 嵌套 如果语句，子区间含条件+块
                位置 = 解析语句(记号, 位置, 池, 字段偏移表);
                否则索引 = 整64(池.大小()) - 1;
            } 否则 {
                位置 = 解析块(记号, 位置, 池, 字段偏移表);
                否则索引 = 整64(池.大小()) - 1;
            }
        }
        // 节点字段（P6b）：文本=条件起点，子起点=条件终点，附加=真块索引，子终点=否则索引（0=无）
        池追加(池, 建节点(节点_如果语句, 整32(条件起点), 整64(真块索引), 整32(条件终点), 整32(否则索引)));
        返回 位置;
    }
    如果 (是关键(记号, 位置, "当")) {
        位置++;
        整64 条件起点 = 池.大小();
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        整64 条件终点 = 池.大小();
        位置 = 解析块(记号, 位置, 池, 字段偏移表);
        整64 体块索引 = 整64(池.大小()) - 1;   // 解析块 最后追加 块 节点
        // 节点字段（P6b）：文本=条件起点，附加=体块索引，子起点=条件终点
        池追加(池, 建节点(节点_当语句, 整32(条件起点), 整64(体块索引), 整32(条件终点), 0));
        返回 位置;
    }
    如果 (是关键(记号, 位置, "中断")) { 位置++; 池追加(池, 建节点(节点_中断语句, 0, 0, 0, 0)); 返回 吃分号(记号, 位置); }
    如果 (是关键(记号, 位置, "继续")) { 位置++; 池追加(池, 建节点(节点_继续语句, 0, 0, 0, 0)); 返回 吃分号(记号, 位置); }
    // P7a 局部常量：常量 名 = 表达式——按 整64 局部变量处理（合成 节点_类型(整64)；
    //   v2 语义层不区分只读性，自举组件源码仅用顶层常量，此分支防新关键字停滞解析）
    如果 (是关键(记号, 位置, "常量")) {
        位置++;
        整64 类型节点 = 池.大小();
        池追加(池, 建节点(节点_类型, 整32(驻留("整64")), 0, 0, 0));
        整32 名ID = 当前ID(记号, 位置);
        位置++;
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("="))) {
            位置++;
            整64 值起点 = 池.大小();
            位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
            池追加(池, 建节点(节点_变量声明, 名ID, 整64(类型节点), 整32(值起点), 整32(池.大小())));
        } 否则 {
            池追加(池, 建节点(节点_变量声明, 名ID, 整64(类型节点), 0, 0));
        }
        返回 吃分号(记号, 位置);
    }
    // 变量声明检测：标识符 标识符（值）或 标识符 * 标识符（指针类型，P6c）
    //   或 标识符 & 标识符 =（裸类型引用，2026-09-04 缺陷零容忍收口——宿主 parser
    //   形式6 typeRefVar 对齐；后随 '=' 前置消歧：引用声明必须初始化（语义层
    //   同款纪律），a & b 位与形态无 '=' 不误判——较宿主 a*b 同款惯例更严）
    //   或 标识符 <实参> 标识符（泛型类型，P7b——是泛型声明 前瞻防 a<b 比较误判）
    如果 ((当前类型(记号, 位置) == 令牌_标识符 && 位置 + 1 < 记号.大小() &&
         ((当前类型(记号, 位置 + 1) == 令牌_标识符) ||
          (当前类型(记号, 位置 + 1) == 令牌_运算符 &&
           当前ID(记号, 位置 + 1) == 整32(驻留("*")) &&
           位置 + 2 < 记号.大小() && 当前类型(记号, 位置 + 2) == 令牌_标识符) ||
          (当前类型(记号, 位置 + 1) == 令牌_运算符 &&
           当前ID(记号, 位置 + 1) == 整32(驻留("&")) &&
           位置 + 2 < 记号.大小() && 当前类型(记号, 位置 + 2) == 令牌_标识符 &&
           位置 + 3 < 记号.大小() &&
           当前类型(记号, 位置 + 3) == 令牌_运算符 &&
           当前ID(记号, 位置 + 3) == 整32(驻留("="))))) ||
         是泛型声明(记号, 位置)) {
        整64 类型节点 = 池.大小();
        位置 = 解析类型(记号, 位置, 池);
        整32 名ID = 当前ID(记号, 位置);
        // P6e：局部变量若是结构体类型（值语义），登记 变量名ID -> 结构体名ID
        //   （引用形态 附加=256 同样登记——对齐参数位惯例：q.值 成员基址=槽内容）
        节点 类型节点值 = 池.元素(类型节点);
        如果 (类型节点值.附加 == 0 || 类型节点值.附加 == 256) {
            结果<整64, 整32> 查名 = 变量结构体表.获取(整64(类型节点值.文本));
            如果 (查名.正常) {
                结果<空类型, 整32> 加变 = 变量结构体表.设置(整64(名ID), 整64(类型节点值.文本));
                如果 (!加变.正常) { 运行时错误(4); }
            }
        }
        // P7b：容器/结果 变量登记 变量容器表（成员预标注用；引用形态 附加=256 同样登记）
        字符串 声明类型文本 = 驻留文本(整64(类型节点值.文本));
        如果 (是容器类(声明类型文本) || 是结果类型(声明类型文本)) {
            结果<空类型, 整32> 加容器 = 变量容器表.设置(整64(名ID), 整64(类型节点值.文本));
            如果 (!加容器.正常) { 运行时错误(4); }
        }
        位置++;
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("="))) {
            位置++;
            整64 值起点 = 池.大小();
            位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
            池追加(池, 建节点(节点_变量声明, 名ID, 整64(类型节点), 整32(值起点), 整32(池.大小())));
        } 否则 {
            池追加(池, 建节点(节点_变量声明, 名ID, 整64(类型节点), 0, 0));
        }
        返回 吃分号(记号, 位置);
    }
    // P6b 赋值语句：标识符 = 表达式（左值 -> 右值）
    如果 (当前类型(记号, 位置) == 令牌_标识符 && 位置 + 1 < 记号.大小() &&
         当前类型(记号, 位置 + 1) == 令牌_运算符 && 当前ID(记号, 位置 + 1) == 整32(驻留("="))) {
        整32 左值ID = 当前ID(记号, 位置);
        位置 += 2;
        整64 右值起点 = 池.大小();
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        池追加(池, 建节点(节点_赋值, 左值ID, 0, 整32(右值起点), 整32(池.大小())));
        返回 吃分号(记号, 位置);
    }
    // P6c 解引用左值赋值：*指针 = 表达式（节点_赋值 文本=0、附加=左值起点）
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("*"))) {
        整64 左值起点 = 池.大小();
        整64 语句起点 = 位置;
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("="))) {
            // 左值区间 = [左值起点, 表达式末节点+1)；表达式末节点即 解引用/成员 根
            整64 左值终点 = 整64(池.大小());
            位置++;
            整64 右值起点 = 池.大小();
            位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
            池追加(池, 建节点(节点_赋值, 0, 整64(左值起点), 整32(右值起点), 整32(池.大小())));
            返回 吃分号(记号, 位置);
        }
        // 灰色点③根治（2026-09-04 用户裁决立案·缺陷零容忍）：解引用复合赋值
        //   *p op= r（方案A 对齐兜底复合分支——L op= R ≡ L = L op R）。原本分支
        //   只认 '='：*p += 1 走「非赋值」路径仅消费 *p，'+= 1' 成孤儿 token →
        //   下条语句零消费触发块循环保护中断 → 块内后续语句（含 返回）全部丢弃
        //   而 asm 仍生成=残缺产物（宿主分号语境支持 *p += 1，两侧行为分叉）。
        //   回退重析左值作右值首操作数，合成 二元(op)+赋值（子终点=1 合成标记，
        //   语义层据此做非数值操作数拒绝——与标识符/成员/下标形态完全同款）
        如果 (位置 > 语句起点 && 池.大小() > 左值起点 &&
             当前类型(记号, 位置) == 令牌_运算符 && 是复合赋值符(当前ID(记号, 位置))) {
            整32 复合符 = 当前ID(记号, 位置);
            整64 右值起点 = 池.大小();
            位置 = 语句起点;
            位置 = 解析表达式(记号, 位置, 池, 字段偏移表);   // 左值副本（右值首操作数）
            位置++;                                        // 复合符（重析后再到此处）
            整64 右操作数起点 = 池.大小();
            位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
            池追加(池, 建节点(节点_二元运算, 复合二元符号(复合符),
                              右操作数起点, 整32(右值起点), 1));
            池追加(池, 建节点(节点_赋值, 0, 左值起点, 整32(右值起点), 整32(池.大小())));
            返回 吃分号(记号, 位置);
        }
        // 非赋值：*表达式 作为表达式语句——包 节点_表达式语句 根（缺陷②分诊根治：
        //   原裸节点无根——语义层靠块级裸派发兜底（双重处理根源），IR 语句派发
        //   对裸节点零分支静默跳过=死代码。根节点统一后语义/IR 各走语句根一次）
        池追加(池, 建节点(节点_表达式语句, 0, 0, 整32(左值起点), 整32(池.大小())));
        返回 吃分号(记号, 位置);
    }
    // P6b 自增语句：前缀 ++ 变量 或 后缀 变量 ++（P6b 仅语句级）
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("++")) &&
         位置 + 1 < 记号.大小() && 当前类型(记号, 位置 + 1) == 令牌_标识符) {
        位置++;
        整32 自增名ID = 当前ID(记号, 位置);
        位置++;
        池追加(池, 建节点(节点_自增, 自增名ID, 0, 0, 0));
        返回 吃分号(记号, 位置);
    }
    如果 (当前类型(记号, 位置) == 令牌_标识符 && 位置 + 1 < 记号.大小() &&
         当前类型(记号, 位置 + 1) == 令牌_运算符 && 当前ID(记号, 位置 + 1) == 整32(驻留("++"))) {
        整32 后缀名ID = 当前ID(记号, 位置);
        位置 += 2;
        池追加(池, 建节点(节点_自增, 后缀名ID, 0, 0, 0));
        返回 吃分号(记号, 位置);
    }
    // 簇③根治·自减全链 C1（2026-09-04 用户裁决）：前缀 -- 变量 / 后缀 变量 --
    //   ——与 节点_自增 分支完全对称（v2 仅语句级，前/后缀同语义）。词法补 --
    //   后若无本分支，-- token 成孤儿触发块截断静默家族（lessons 复合赋值假绿同族）
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("--")) &&
         位置 + 1 < 记号.大小() && 当前类型(记号, 位置 + 1) == 令牌_标识符) {
        位置++;
        整32 自减名ID = 当前ID(记号, 位置);
        位置++;
        池追加(池, 建节点(节点_自减, 自减名ID, 0, 0, 0));
        返回 吃分号(记号, 位置);
    }
    如果 (当前类型(记号, 位置) == 令牌_标识符 && 位置 + 1 < 记号.大小() &&
         当前类型(记号, 位置 + 1) == 令牌_运算符 && 当前ID(记号, 位置 + 1) == 整32(驻留("--"))) {
        整32 后缀减名ID = 当前ID(记号, 位置);
        位置 += 2;
        池追加(池, 建节点(节点_自减, 后缀减名ID, 0, 0, 0));
        返回 吃分号(记号, 位置);
    }
    整64 值起点 = 池.大小();
    整64 语句起点 = 位置;
    位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
    // ③ 第二波（方案A 裁决）：复合赋值 L op= R ≡ L = L op R（标识符/成员/解引用
    //   左值统一）。回退重析左值作右值首操作数（成员偏移解析期重标注，两份独立
    //   正确），合成 二元(op) + 节点_赋值（左值区间=首份，右值区间=副本+R+二元）
    //   ——赋值/IR 两层零改动。
    如果 (位置 > 语句起点 && 池.大小() > 值起点 &&
         当前类型(记号, 位置) == 令牌_运算符 && 是复合赋值符(当前ID(记号, 位置))) {
        整32 复合符 = 当前ID(记号, 位置);
        整64 右值起点 = 池.大小();
        位置 = 语句起点;
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);   // 左值副本（右值首操作数）
        位置++;                                        // 复合符（重析后再到此处）
        整64 右操作数起点 = 池.大小();
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        // 子终点=1：复合赋值合成标记（与手写 名 = 名 + "乙" 可区分——语义层据此
        //   做非数值操作数拒绝；&&/|| 预扫按 子终点!=0+op 名双条件识别，不受影响）
        池追加(池, 建节点(节点_二元运算, 复合二元符号(复合符),
                          右操作数起点, 整32(右值起点), 1));
        池追加(池, 建节点(节点_赋值, 0, 值起点, 整32(右值起点), 整32(池.大小())));
        返回 吃分号(记号, 位置);
    }
    // P6c：成员/解引用左值赋值（位置.x = 7 / *指针 = 10）：表达式后遇 =
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("="))) {
        位置++;
        整64 右值起点 = 池.大小();
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表);
        池追加(池, 建节点(节点_赋值, 0, 整64(值起点), 整32(右值起点), 整32(池.大小())));
        返回 吃分号(记号, 位置);
    }
    池追加(池, 建节点(节点_表达式语句, 0, 0, 整32(值起点), 整32(池.大小())));
    返回 吃分号(记号, 位置);
}

// 解析代码块
函数 解析块(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("{"))) { 位置++; }
    整64 块起点 = 池.大小();
    整64 循环保护 = 0;
    当 (真) {
        如果 (当前类型(记号, 位置) == 令牌_文件结束) { 中断; }
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("}"))) { 位置++; 中断; }
        // plans/015 方案B 后此分支为裸分号防御（语句分号已由 吃分号 消费）
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(";"))) { 位置++; 继续; }
        整64 旧位置 = 位置;
        位置 = 解析语句(记号, 位置, 池, 字段偏移表);
        循环保护++;
        如果 (位置 == 旧位置 || 循环保护 > 100000) {
            // 静默中断可见化（缺陷②分诊连带，B6/+= 语句级静默中断家族）：语句零
            //   消费=存在不可解析 token（如 *p += 1 的复合符、悬空运算符）——原静默
            //   中断吞掉块内后续全部语句（含 返回），产物行为不可预测。stderr 诊断
            //   使截断可见（E2E .expected 子串匹配不受额外行影响）
            IO::打印到错误("[parse] 语句解析中断于不可解析 token，块内后续语句被丢弃（位置=" +
                          整数转字符串(位置) + "）\n");
            中断;
        }
    }
    池追加(池, 建节点(节点_块, 0, 0, 整32(块起点), 整32(池.大小())));
    返回 位置;
}
