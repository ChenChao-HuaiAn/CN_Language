// CN 自举编译器 v2：结构化语法分析器（自举重建 P3，2026-08-25）
// 性能最优架构第二层：AST 用节点池（向量<节点>，arena 语义），节点间索引引用。
// 输入：P2 词法器 Token 数组；输出：节点池 AST。
// 规范依据：cn-language-spec 03/04/05。
导入 容器::向量
导入 词法分析

公开:

常量 节点_整数字面量 = 11
常量 节点_浮点字面量 = 12
常量 节点_字符串字面量 = 13
常量 节点_标识符 = 10

结构体 节点 {
    整32 类型
    整32 文本
    整64 附加
    整32 子起点
    整32 子终点
}

函数 池追加(向量<节点> 池, 节点 n) -> 整32 {
    结果<空类型, 整32> 加 = 池.追加(n)
    如果 (!加.正常) { 运行时错误(4) }
    返回 整32(池.大小() - 1)
}

函数 建节点(整32 类型, 整32 文本, 整64 附加) -> 节点 {
    节点 n
    n.类型 = 类型
    n.文本 = 文本
    n.附加 = 附加
    n.子起点 = 0
    n.子终点 = 0
    返回 n
}

函数 当前类型(向量<Token> 记号, 整64 位置) -> 整32 {
    如果 (位置 >= 记号.大小()) { 返回 令牌_文件结束 }
    返回 记号.元素(位置).类型
}
函数 当前ID(向量<Token> 记号, 整64 位置) -> 整32 {
    如果 (位置 >= 记号.大小()) { 返回 0 }
    返回 记号.元素(位置).文本
}
函数 当前文本(向量<Token> 记号, 整64 位置) -> 字符串 {
    返回 驻留文本(整64(当前ID(记号, 位置)))
}
函数 是关键(向量<Token> 记号, 整64 位置, 字符串 关键字) -> 布尔 {
    返回 当前类型(记号, 位置) == 令牌_关键字 && 当前ID(记号, 位置) == 整32(驻留(关键字))
}

// 解析原子表达式：字面量/标识符/括号。返回结束位置；节点入池。
函数 解析原子(向量<Token> 记号, 整64 位置, 向量<节点> 池) -> 整64 {
    整32 t = 当前类型(记号, 位置)
    如果 (t == 令牌_整数字面量) {
        池追加(池, 建节点(节点_整数字面量, 当前ID(记号, 位置), 0))
        返回 位置 + 1
    }
    如果 (t == 令牌_浮点字面量) {
        池追加(池, 建节点(节点_浮点字面量, 当前ID(记号, 位置), 0))
        返回 位置 + 1
    }
    如果 (t == 令牌_字符串字面量) {
        池追加(池, 建节点(节点_字符串字面量, 当前ID(记号, 位置), 0))
        返回 位置 + 1
    }
    如果 (t == 令牌_标识符) {
        池追加(池, 建节点(节点_标识符, 当前ID(记号, 位置), 0))
        返回 位置 + 1
    }
    如果 (t == 令牌_运算符 && 当前文本(记号, 位置) == "(") {
        位置++
        位置 = 解析表达式(记号, 位置, 池)
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前文本(记号, 位置) == ")") { 位置++ }
        返回 位置
    }
    返回 位置
}

// 后缀节点类型（P3b 常量）——先在此定义，与实际使用同步
常量 节点_调用 = 17
常量 节点_成员 = 18
常量 节点_下标 = 19

// 表达式入口：原子 + 后缀（调用/成员/下标）链
函数 解析表达式(向量<Token> 记号, 整64 位置, 向量<节点> 池) -> 整64 {
    位置 = 解析原子(记号, 位置, 池)
    // 后缀链：连续消费 调用/成员/下标，每项建一个节点
    整64 延续 = 1
    当 (延续 == 1) {
        延续 = 0
        如果 (当前类型(记号, 位置) == 令牌_运算符) {
            字符串 符号 = 当前文本(记号, 位置)
            如果 (符号 == "(") {
                整64 参数起点 = 池.大小()
                位置++
                如果 (!(当前类型(记号, 位置) == 令牌_运算符 && 当前文本(记号, 位置) == ")")) {
                    当 (真) {
                        位置 = 解析表达式(记号, 位置, 池)
                        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前文本(记号, 位置) == ",") { 位置++; 继续 }
                        中断
                    }
                }
                如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前文本(记号, 位置) == ")") { 位置++ }
                池追加(池, 建节点(节点_调用, 0, 0))
                延续 = 1
            } 否则 如果 (符号 == "." || 符号 == "->" || 符号 == "::") {
                整32 成员名 = 当前ID(记号, 位置 + 1)
                位置 += 2
                池追加(池, 建节点(节点_成员, 成员名, 0))
                延续 = 1
            } 否则 如果 (符号 == "[") {
                位置++
                位置 = 解析表达式(记号, 位置, 池)
                如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前文本(记号, 位置) == "]") { 位置++ }
                池追加(池, 建节点(节点_下标, 0, 0))
                延续 = 1
            }
        }
    }
    返回 解析二元链(记号, 位置, 池)
}

// ==================== 二元运算（P3b） ====================
常量 节点_二元运算 = 15

// 解析二元链：两级优先级（1=加减，2=乘除）；左结合
函数 解析二元链(向量<Token> 记号, 整64 位置, 向量<节点> 池) -> 整64 {
    返回 解析二元层(记号, 位置, 池, 1)
}

// 解析层_子：层2 -> 解析原子；层1 -> 层2
函数 解析层_子(向量<Token> 记号, 整64 位置, 向量<节点> 池, 整64 层) -> 整64 {
    如果 (层 == 2) { 返回 解析原子(记号, 位置, 池) }
    返回 解析二元层(记号, 位置, 池, 2)
}

// 解析二元层：先子层，再循环本层运算符（左结合）
函数 解析二元层(向量<Token> 记号, 整64 位置, 向量<节点> 池, 整64 层) -> 整64 {
    位置 = 解析层_子(记号, 位置, 池, 层)
    位置 = 解析二元循环(记号, 位置, 池, 层)
    返回 位置
}

// 本层循环：贪婪消费 * / %（层2）或 + -（层1）
函数 解析二元循环(向量<Token> 记号, 整64 位置, 向量<节点> 池, 整64 层) -> 整64 {
    如果 (当前类型(记号, 位置) != 令牌_运算符) { 返回 位置 }
    字符串 符号 = 当前文本(记号, 位置)
    整64 层匹配 = 0
    如果 (符号 == "*" || 符号 == "/" || 符号 == "%") { 层匹配 = 2 }
    否则 如果 (符号 == "+" || 符号 == "-") { 层匹配 = 1 }
    如果 (层匹配 == 0 || 层匹配 != 层) { 返回 位置 }
    整32 op符号 = 当前ID(记号, 位置)
    位置++
    位置 = 解析层_子(记号, 位置, 池, 层)
    池追加(池, 建节点(节点_二元运算, op符号, 0))
    返回 解析二元循环(记号, 位置, 池, 层)
}

