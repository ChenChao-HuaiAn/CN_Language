// CN 自举编译器 v2：结构化语法分析器（自举重建 P3，2026-08-25）
// 性能最优架构第二层：AST 用节点池（向量<节点>，arena 语义），节点间索引引用。
// 输入：P2 词法器 Token 数组；输出：节点池 AST。
// 规范依据：cn-language-spec 03/04/05。
导入 容器::向量
导入 映射集合
导入 词法分析

公开:

// P6e（2026-08-30）：字段偏移表按结构体分桶根治——扁平 字段名->偏移 单映射
//   在两个结构体同名字段（点.x 与 矩形.x）时串偏移（用户批评的正确性隐患）。
//   方案：键 = 结构体名ID * 键位移 + 字段名ID（单映射，无嵌套依赖）；
//   成员访问时经 变量结构体表（变量名ID -> 结构体名ID）推导对象所属结构体。
//   键位移 = 2^20：字段名 ID 远小于 1048576（字符串驻留 ID 递增小整数），无碰撞。
常量 键位移 = 1048576
静态 映射<整64, 整64> 变量结构体表

常量 节点_整数字面量 = 11
常量 节点_浮点字面量 = 12
常量 节点_字符串字面量 = 13
常量 节点_标识符 = 10
常量 节点_程序 = 1
常量 节点_函数 = 2
常量 节点_参数 = 3
常量 节点_块 = 4
常量 节点_变量声明 = 5
常量 节点_返回语句 = 6
常量 节点_表达式语句 = 7
常量 节点_如果语句 = 8
常量 节点_当语句 = 9
常量 节点_结构体 = 21
常量 节点_类型 = 22
// P6b 控制流新增节点（2026-08-30）
常量 节点_赋值 = 23        // 赋值语句/表达式：子起点=左值，子终点=右值表达式
常量 节点_自增 = 24        // 自增语句（++ 变量）：附加=目标变量名ID
常量 节点_逻辑非 = 25      // 前缀 ! 一元：子起点=操作数表达式
常量 节点_负号 = 26        // 前缀 - 一元：子起点=操作数表达式
常量 节点_中断语句 = 27    // 中断
常量 节点_继续语句 = 28    // 继续
// P6c 指针/字段访问新增节点（2026-08-30）
常量 节点_取地址 = 29      // & 取地址：子起点=操作数表达式
常量 节点_解引用 = 30      // * 解引用：子起点=操作数表达式

结构体 节点 {
    整32 类型
    整32 文本
    整64 附加
    整32 子起点
    整32 子终点
}

函数 池追加(向量<节点> 池, 节点 n) -> 整32 {
    结果<空类型, 整32> 加 = 池.追加(n)
    如果 (!加.正常) { 运行时错误(4) }
    返回 整32(池.大小() - 1)
}

函数 建节点(整32 类型, 整32 文本, 整64 附加, 整32 子起点, 整32 子终点) -> 节点 {
    节点 n
    n.类型 = 类型
    n.文本 = 文本
    n.附加 = 附加
    n.子起点 = 子起点
    n.子终点 = 子终点
    返回 n
}

函数 当前类型(向量<Token> 记号, 整64 位置) -> 整32 {
    如果 (位置 >= 记号.大小()) { 返回 令牌_文件结束 }
    Token 当前 = 记号.元素(位置)
    返回 整32(当前.类型)
}
函数 当前ID(向量<Token> 记号, 整64 位置) -> 整32 {
    如果 (位置 >= 记号.大小()) { 返回 0 }
    Token 当前 = 记号.元素(位置)
    返回 整32(当前.文本)
}
函数 当前文本(向量<Token> 记号, 整64 位置) -> 字符串 {
    返回 驻留文本(整64(当前ID(记号, 位置)))
}
函数 是关键(向量<Token> 记号, 整64 位置, 字符串 关键字) -> 布尔 {
    返回 当前类型(记号, 位置) == 令牌_关键字 && 当前ID(记号, 位置) == 整32(驻留(关键字))
}

// 解析原子表达式：字面量/标识符/括号。返回结束位置；节点入池。
函数 解析原子(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    整32 t = 当前类型(记号, 位置)
    如果 (t == 令牌_整数字面量) {
        池追加(池, 建节点(节点_整数字面量, 当前ID(记号, 位置), 0, 0, 0))
        返回 位置 + 1
    }
    如果 (t == 令牌_浮点字面量) {
        池追加(池, 建节点(节点_浮点字面量, 当前ID(记号, 位置), 0, 0, 0))
        返回 位置 + 1
    }
    如果 (t == 令牌_字符串字面量) {
        池追加(池, 建节点(节点_字符串字面量, 当前ID(记号, 位置), 0, 0, 0))
        返回 位置 + 1
    }
    如果 (t == 令牌_标识符) {
        池追加(池, 建节点(节点_标识符, 当前ID(记号, 位置), 0, 0, 0))
        返回 位置 + 1
    }
    如果 (t == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("("))) {
        位置++
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表)
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(")"))) { 位置++ }
        返回 位置
    }
    返回 位置
}

// 后缀节点类型（P3b 常量）——先在此定义，与实际使用同步
常量 节点_调用 = 17
常量 节点_成员 = 18
常量 节点_下标 = 19

// 表达式入口：一元前缀（! / -）+ 原子 + 后缀（调用/成员/下标）链
函数 解析表达式(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    // 一元前缀只在此处（表达式首 token）解析，避免与二元 - 混淆
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("!"))) {
        位置++
        整64 操作数起点 = 池.大小()
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表)
        池追加(池, 建节点(节点_逻辑非, 0, 0, 整32(操作数起点), 整32(池.大小())))
        返回 位置
    }
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("-"))) {
        位置++
        整64 操作数起点 = 池.大小()
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表)
        池追加(池, 建节点(节点_负号, 0, 0, 整32(操作数起点), 整32(池.大小())))
        返回 位置
    }
    // P6c 取地址 & / 解引用 *（表达式入口，与一元同级）
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("&"))) {
        位置++
        整64 操作数起点 = 池.大小()
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表)
        池追加(池, 建节点(节点_取地址, 0, 0, 整32(操作数起点), 整32(池.大小())))
        返回 位置
    }
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("*"))) {
        位置++
        整64 操作数起点 = 池.大小()
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表)
        池追加(池, 建节点(节点_解引用, 0, 0, 整32(操作数起点), 整32(池.大小())))
        返回 位置
    }
    位置 = 解析原子(记号, 位置, 池, 字段偏移表)
    位置 = 解析后缀链(记号, 位置, 池, 字段偏移表)
    // P6c：仅当当前位置是二元运算符才进二元链（避免误解析后续标识符为左操作数）
    如果 (当前类型(记号, 位置) == 令牌_运算符) {
        整64 符号 = 整64(当前ID(记号, 位置))
        如果 (符号 == 驻留("+") || 符号 == 驻留("-") || 符号 == 驻留("*") || 符号 == 驻留("/") ||
             符号 == 驻留("%") || 符号 == 驻留("==") || 符号 == 驻留("!=") || 符号 == 驻留("<") ||
             符号 == 驻留(">") || 符号 == 驻留("<=") || 符号 == 驻留(">=") || 符号 == 驻留("&&") ||
             符号 == 驻留("||")) {
            返回 解析二元链(记号, 位置, 池, 字段偏移表)
        }
    }
    返回 位置
}

// 解析后缀链：连续消费 调用/成员/下标（P6c 提取，供 表达式/二元操作数 复用）
函数 解析后缀链(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    整64 延续 = 1
    当 (延续 == 1) {
        延续 = 0
        如果 (当前类型(记号, 位置) == 令牌_运算符) {
            整64 符号 = 整64(当前ID(记号, 位置))
            如果 (符号 == 驻留("(")) {
                整64 参数起点 = 池.大小()
                整64 实参数 = 0
                位置++
                如果 (!(当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(")")))) {
                    当 (真) {
                        位置 = 解析表达式(记号, 位置, 池, 字段偏移表)
                        实参数++
                        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(","))) { 位置++; 继续 }
                        中断
                    }
                }
                如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(")"))) { 位置++ }
                // 实参数 存 附加（后缀求值 弹实参数量用；子区间=实参表达式节点数≠实参数）
                池追加(池, 建节点(节点_调用, 0, 实参数, 0, 0))
                延续 = 1
            } 否则 如果 (符号 == 驻留(".") || 符号 == 驻留("->") || 符号 == 驻留("::")) {
                整32 成员名 = 当前ID(记号, 位置 + 1)
                位置 += 2
                // P6e（2026-08-30）：字段偏移按结构体分桶——先经 变量结构体表 推导
                //   对象所属结构体（对象若是标识符），再按 结构体名ID*键位移+字段名ID
                //   查偏移。根治扁平表同名字段串偏移。
                整64 偏移 = -1
                整64 对象结构体ID = 0
                节点 对象节点 = 池.元素(整64(池.大小()) - 1)
                如果 (对象节点.类型 == 节点_标识符) {
                    结果<整64, 整32> 查结构体 = 变量结构体表.获取(整64(对象节点.文本))
                    如果 (查结构体.正常) {
                        // 值=结构体名ID（1=结构体名标记，非对象结构体）
                        如果 (查结构体.值 != 1) {
                            对象结构体ID = 查结构体.值
                        }
                    }
                }
                如果 (对象结构体ID != 0) {
                    结果<整64, 整32> 偏移查 = 字段偏移表.获取(对象结构体ID * 键位移 + 整64(成员名))
                    如果 (偏移查.正常) { 偏移 = 偏移查.值 }
                } 否则 {
                    // 回退：对象非标识符/未登记——按旧扁平键查（兼容链式 成员.字段）
                    结果<整64, 整32> 偏移查2 = 字段偏移表.获取(整64(成员名))
                    如果 (偏移查2.正常) { 偏移 = 偏移查2.值 }
                }
                // 子起点=对象节点索引（池中对象在成员前，池大小-1）
                池追加(池, 建节点(节点_成员, 成员名, 偏移, 整32(池.大小()) - 1, 0))
                延续 = 1
            } 否则 如果 (符号 == 驻留("[")) {
                位置++
                位置 = 解析表达式(记号, 位置, 池, 字段偏移表)
                如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("]"))) { 位置++ }
                池追加(池, 建节点(节点_下标, 0, 0, 0, 0))
                延续 = 1
            }
        }
    }
    返回 位置
}

// ==================== 二元运算（P3b） ====================
常量 节点_二元运算 = 15

// 解析二元链：4 层优先级（P6b 扩展，对标规范 01b 优先级）
//   1=逻辑或 ||；2=逻辑与 &&；3=比较 == != < > <= >=；4=加减 + -；5=乘除 * / %
// 左结合；每层循环贪婪消费本层运算符。
函数 解析二元链(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    返回 解析二元层(记号, 位置, 池, 1, 字段偏移表)
}

// 解析层_子：层5 -> 解析原子；其余 -> 下一层
函数 解析层_子(向量<Token> 记号, 整64 位置, 向量<节点> 池, 整64 层, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    如果 (层 == 5) {
        位置 = 解析原子(记号, 位置, 池, 字段偏移表)
        返回 解析后缀链(记号, 位置, 池, 字段偏移表)
    }
    返回 解析二元层(记号, 位置, 池, 层 + 1, 字段偏移表)
}

// 解析二元层：先子层，再循环本层运算符（左结合）
函数 解析二元层(向量<Token> 记号, 整64 位置, 向量<节点> 池, 整64 层, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    位置 = 解析层_子(记号, 位置, 池, 层, 字段偏移表)
    位置 = 解析二元循环(记号, 位置, 池, 层, 字段偏移表)
    返回 位置
}

// 本层循环：贪婪消费本层运算符（层匹配）
函数 解析二元循环(向量<Token> 记号, 整64 位置, 向量<节点> 池, 整64 层, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    如果 (当前类型(记号, 位置) != 令牌_运算符) { 返回 位置 }
    整64 符号 = 整64(当前ID(记号, 位置))
    整64 层匹配 = 0
    如果 (符号 == 驻留("||")) { 层匹配 = 1 }
    否则 如果 (符号 == 驻留("&&")) { 层匹配 = 2 }
    否则 如果 (符号 == 驻留("==") || 符号 == 驻留("!=") || 符号 == 驻留("<") ||
              符号 == 驻留(">") || 符号 == 驻留("<=") || 符号 == 驻留(">=")) { 层匹配 = 3 }
    否则 如果 (符号 == 驻留("+") || 符号 == 驻留("-")) { 层匹配 = 4 }
    否则 如果 (符号 == 驻留("*") || 符号 == 驻留("/") || 符号 == 驻留("%")) { 层匹配 = 5 }
    如果 (层匹配 == 0 || 层匹配 != 层) { 返回 位置 }
    整32 op符号 = 当前ID(记号, 位置)
    位置++
    位置 = 解析层_子(记号, 位置, 池, 层, 字段偏移表)
    池追加(池, 建节点(节点_二元运算, op符号, 0, 0, 0))
    返回 解析二元循环(记号, 位置, 池, 层, 字段偏移表)
}


// 解析函数声明：函数 名(参数...) -> 返回类型 { 体 }
函数 解析函数声明(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    如果 (是关键(记号, 位置, "函数")) { 位置++ }
    整32 名ID = 当前ID(记号, 位置)
    位置++
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("("))) { 位置++ }
    整64 参数起点 = 池.大小()
    如果 (!(当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(")")))) {
        当 (真) {
            位置 = 解析参数(记号, 位置, 池)
            如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(","))) { 位置++; 继续 }
            中断
        }
    }
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(")"))) { 位置++ }
    整32 返回类型ID = 0
    // 返回类型箭头：词法 P6b 已合并为单 token "->"（兼容旧双 token 判断）
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("->"))) {
        位置++
        返回类型ID = 当前ID(记号, 位置)
        位置++
    } 否则 如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("-")) && 位置 + 1 < 记号.大小() && 当前ID(记号, 位置 + 1) == 整32(驻留(">"))) {
        位置 += 2
        返回类型ID = 当前ID(记号, 位置)
        位置++
    }
    整64 块起点 = 池.大小()
    位置 = 解析块(记号, 位置, 池, 字段偏移表)
    整32 块索引 = 整32(池.大小()) - 1
    池追加(池, 建节点(节点_函数, 名ID, 整64(返回类型ID), 整32(参数起点), 块索引))
    返回 位置
}

// 解析结构体声明：结构体 名 { 类型 字段... }
函数 解析结构体声明(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    如果 (是关键(记号, 位置, "结构体")) { 位置++ }
    整32 名ID = 当前ID(记号, 位置)
    位置++
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("{"))) { 位置++ }
    整64 字段起点 = 池.大小()
    整64 字段偏移 = 0
    当 (真) {
        如果 (当前类型(记号, 位置) == 令牌_文件结束) { 中断 }
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("}"))) { 位置++; 中断 }
        整64 类型节点 = 池.大小()
        位置 = 解析类型(记号, 位置, 池)
        如果 (当前类型(记号, 位置) == 令牌_标识符) {
            // P6e（2026-08-30）：字段偏移按结构体分桶——键 = 结构体名ID*键位移+字段名ID，
            //   根治扁平 字段名->偏移 单映射的同名字段串偏移（点.x 与 矩形.x）。
            整64 分桶键 = 整64(名ID) * 键位移 + 整64(当前ID(记号, 位置))
            结果<空类型, 整32> 加表 = 字段偏移表.设置(分桶键, 字段偏移)
            如果 (!加表.正常) { 运行时错误(4) }
            字段偏移 = 字段偏移 + 8
            池追加(池, 建节点(节点_参数, 当前ID(记号, 位置), 整64(类型节点), 0, 0))
            位置++
        }
    }
    // P6e：登记结构体名标记（变量结构体表：结构体名ID -> 1），供变量声明/参数
    //   识别"类型是结构体"（查表命中即结构体类型，登记 变量名ID -> 结构体名ID）
    结果<空类型, 整32> 加名 = 变量结构体表.设置(整64(名ID), 1)
    如果 (!加名.正常) { 运行时错误(4) }
    池追加(池, 建节点(节点_结构体, 名ID, 0, 整32(字段起点), 整32(池.大小())))
    返回 位置
}

// 解析完整程序：顶层声明序列（函数/结构体）
函数 解析程序(向量<Token> 记号, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    // P6e：静态 变量结构体表 跨调用残留（主.cn 对 正确程序+错误程序 各调一次）
    变量结构体表.清空()
    整64 位置 = 0
    整64 程序起点 = 池.大小()
    当 (位置 < 记号.大小()) {
        如果 (当前类型(记号, 位置) == 令牌_文件结束) { 中断 }
        如果 (是关键(记号, 位置, "函数")) {
            位置 = 解析函数声明(记号, 位置, 池, 字段偏移表)
        } 否则 如果 (是关键(记号, 位置, "结构体")) {
            位置 = 解析结构体声明(记号, 位置, 池, 字段偏移表)
        } 否则 {
            位置++
        }
    }
    池追加(池, 建节点(节点_程序, 0, 0, 整32(程序起点), 整32(池.大小())))
    返回 位置
}

// 解析类型：类型前置，支持 类型* 指针（P6c）
// 节点_类型：文本=类型名ID，附加=指针层数（0=值类型，1+=指针）
函数 解析类型(向量<Token> 记号, 整64 位置, 向量<节点> 池) -> 整64 {
    如果 (当前类型(记号, 位置) == 令牌_标识符) {
        整32 类型名ID = 当前ID(记号, 位置)
        位置++
        整64 指针层 = 0
        当 (位置 < 记号.大小() && 当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("*"))) {
            指针层++
            位置++
        }
        池追加(池, 建节点(节点_类型, 类型名ID, 指针层, 0, 0))
        返回 位置
    }
    返回 位置
}

// 解析参数：类型 名
函数 解析参数(向量<Token> 记号, 整64 位置, 向量<节点> 池) -> 整64 {
    整64 类型节点 = 池.大小()
    位置 = 解析类型(记号, 位置, 池)
    如果 (当前类型(记号, 位置) == 令牌_标识符) {
        整32 参数名ID = 当前ID(记号, 位置)
        // P6e：参数若是结构体类型（值语义），登记 变量名ID -> 结构体名ID，
        //   成员访问（位置.x）据此推导对象所属结构体、查分桶字段偏移。
        节点 类型节点值 = 池.元素(类型节点)
        如果 (类型节点值.附加 == 0) {  // 指针层 0：值类型参数才可能是结构体对象
            结果<整64, 整32> 查名 = 变量结构体表.获取(整64(类型节点值.文本))
            如果 (查名.正常) {  // 类型名是已声明结构体
                结果<空类型, 整32> 加参 = 变量结构体表.设置(整64(参数名ID), 整64(类型节点值.文本))
                如果 (!加参.正常) { 运行时错误(4) }
            }
        }
        池追加(池, 建节点(节点_参数, 参数名ID, 整64(类型节点), 0, 0))
        返回 位置 + 1
    }
    池追加(池, 建节点(节点_参数, 0, 整64(类型节点), 0, 0))
    返回 位置
}

// 解析语句
函数 解析语句(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    如果 (是关键(记号, 位置, "返回")) {
        位置++
        整64 值起点 = 池.大小()
        如果 (当前类型(记号, 位置) != 令牌_运算符 || 当前文本(记号, 位置) != "}") {
            位置 = 解析表达式(记号, 位置, 池, 字段偏移表)
        }
        池追加(池, 建节点(节点_返回语句, 0, 0, 整32(值起点), 整32(池.大小())))
        返回 位置
    }
    如果 (是关键(记号, 位置, "如果")) {
        位置++
        整64 条件起点 = 池.大小()
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表)
        整64 条件终点 = 池.大小()
        位置 = 解析块(记号, 位置, 池, 字段偏移表)
        整64 真块索引 = 整64(池.大小()) - 1   // 解析块 最后追加 块 节点
        // 否则链：否则 如果 ... / 否则 { ... }（P6b）
        整64 否则索引 = 0
        如果 (是关键(记号, 位置, "否则")) {
            位置++
            如果 (是关键(记号, 位置, "如果")) {
                // 否则 如果 -> 递归解析为 嵌套 如果语句，子区间含条件+块
                位置 = 解析语句(记号, 位置, 池, 字段偏移表)
                否则索引 = 整64(池.大小()) - 1
            } 否则 {
                位置 = 解析块(记号, 位置, 池, 字段偏移表)
                否则索引 = 整64(池.大小()) - 1
            }
        }
        // 节点字段（P6b）：文本=条件起点，子起点=条件终点，附加=真块索引，子终点=否则索引（0=无）
        池追加(池, 建节点(节点_如果语句, 整32(条件起点), 整64(真块索引), 整32(条件终点), 整32(否则索引)))
        返回 位置
    }
    如果 (是关键(记号, 位置, "当")) {
        位置++
        整64 条件起点 = 池.大小()
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表)
        整64 条件终点 = 池.大小()
        位置 = 解析块(记号, 位置, 池, 字段偏移表)
        整64 体块索引 = 整64(池.大小()) - 1   // 解析块 最后追加 块 节点
        // 节点字段（P6b）：文本=条件起点，附加=体块索引，子起点=条件终点
        池追加(池, 建节点(节点_当语句, 整32(条件起点), 整64(体块索引), 整32(条件终点), 0))
        返回 位置
    }
    如果 (是关键(记号, 位置, "中断")) { 位置++; 池追加(池, 建节点(节点_中断语句, 0, 0, 0, 0)); 返回 位置 }
    如果 (是关键(记号, 位置, "继续")) { 位置++; 池追加(池, 建节点(节点_继续语句, 0, 0, 0, 0)); 返回 位置 }
    // 变量声明检测：标识符 标识符（值）或 标识符 * 标识符（指针类型，P6c）
    如果 (当前类型(记号, 位置) == 令牌_标识符 && 位置 + 1 < 记号.大小() &&
         ((当前类型(记号, 位置 + 1) == 令牌_标识符) ||
          (当前类型(记号, 位置 + 1) == 令牌_运算符 && 当前ID(记号, 位置 + 1) == 整32(驻留("*")) &&
           位置 + 2 < 记号.大小() && 当前类型(记号, 位置 + 2) == 令牌_标识符))) {
        整64 类型节点 = 池.大小()
        位置 = 解析类型(记号, 位置, 池)
        整32 名ID = 当前ID(记号, 位置)
        // P6e：局部变量若是结构体类型（值语义），登记 变量名ID -> 结构体名ID
        节点 类型节点值 = 池.元素(类型节点)
        如果 (类型节点值.附加 == 0) {
            结果<整64, 整32> 查名 = 变量结构体表.获取(整64(类型节点值.文本))
            如果 (查名.正常) {
                结果<空类型, 整32> 加变 = 变量结构体表.设置(整64(名ID), 整64(类型节点值.文本))
                如果 (!加变.正常) { 运行时错误(4) }
            }
        }
        位置++
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("="))) {
            位置++
            整64 值起点 = 池.大小()
            位置 = 解析表达式(记号, 位置, 池, 字段偏移表)
            池追加(池, 建节点(节点_变量声明, 名ID, 整64(类型节点), 整32(值起点), 整32(池.大小())))
        } 否则 {
            池追加(池, 建节点(节点_变量声明, 名ID, 整64(类型节点), 0, 0))
        }
        返回 位置
    }
    // P6b 赋值语句：标识符 = 表达式（左值 -> 右值）
    如果 (当前类型(记号, 位置) == 令牌_标识符 && 位置 + 1 < 记号.大小() &&
         当前类型(记号, 位置 + 1) == 令牌_运算符 && 当前ID(记号, 位置 + 1) == 整32(驻留("="))) {
        整32 左值ID = 当前ID(记号, 位置)
        位置 += 2
        整64 右值起点 = 池.大小()
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表)
        池追加(池, 建节点(节点_赋值, 左值ID, 0, 整32(右值起点), 整32(池.大小())))
        返回 位置
    }
    // P6c 解引用左值赋值：*指针 = 表达式（节点_赋值 文本=0、附加=左值起点）
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("*"))) {
        整64 左值起点 = 池.大小()
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表)
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("="))) {
            // 左值区间 = [左值起点, 表达式末节点+1)；表达式末节点即 解引用/成员 根
            整64 左值终点 = 整64(池.大小())
            位置++
            整64 右值起点 = 池.大小()
            位置 = 解析表达式(记号, 位置, 池, 字段偏移表)
            池追加(池, 建节点(节点_赋值, 0, 整64(左值起点), 整32(右值起点), 整32(池.大小())))
            返回 位置
        }
        // 非赋值：*表达式 作为表达式语句（已有节点入池，直接返回）
        返回 位置
    }
    // P6b 自增语句：前缀 ++ 变量 或 后缀 变量 ++（P6b 仅语句级）
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("++")) &&
         位置 + 1 < 记号.大小() && 当前类型(记号, 位置 + 1) == 令牌_标识符) {
        位置++
        整32 自增名ID = 当前ID(记号, 位置)
        位置++
        池追加(池, 建节点(节点_自增, 自增名ID, 0, 0, 0))
        返回 位置
    }
    如果 (当前类型(记号, 位置) == 令牌_标识符 && 位置 + 1 < 记号.大小() &&
         当前类型(记号, 位置 + 1) == 令牌_运算符 && 当前ID(记号, 位置 + 1) == 整32(驻留("++"))) {
        整32 后缀名ID = 当前ID(记号, 位置)
        位置 += 2
        池追加(池, 建节点(节点_自增, 后缀名ID, 0, 0, 0))
        返回 位置
    }
    整64 值起点 = 池.大小()
    位置 = 解析表达式(记号, 位置, 池, 字段偏移表)
    // P6c：成员/解引用左值赋值（位置.x = 7 / *指针 = 10）：表达式后遇 =
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("="))) {
        位置++
        整64 右值起点 = 池.大小()
        位置 = 解析表达式(记号, 位置, 池, 字段偏移表)
        池追加(池, 建节点(节点_赋值, 0, 整64(值起点), 整32(右值起点), 整32(池.大小())))
        返回 位置
    }
    池追加(池, 建节点(节点_表达式语句, 0, 0, 整32(值起点), 整32(池.大小())))
    返回 位置
}

// 解析代码块
函数 解析块(向量<Token> 记号, 整64 位置, 向量<节点> 池, 映射<整64, 整64>& 字段偏移表) -> 整64 {
    如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("{"))) { 位置++ }
    整64 块起点 = 池.大小()
    整64 循环保护 = 0
    当 (真) {
        如果 (当前类型(记号, 位置) == 令牌_文件结束) { 中断 }
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留("}"))) { 位置++; 中断 }
        // P6c：可选分号终止符（CN 规范：分号可选，有就吃）
        如果 (当前类型(记号, 位置) == 令牌_运算符 && 当前ID(记号, 位置) == 整32(驻留(";"))) { 位置++; 继续 }
        整64 旧位置 = 位置
        位置 = 解析语句(记号, 位置, 池, 字段偏移表)
        循环保护++
        如果 (位置 == 旧位置 || 循环保护 > 100000) {
            中断
        }
    }
    池追加(池, 建节点(节点_块, 0, 0, 整32(块起点), 整32(池.大小())))
    返回 位置
}
