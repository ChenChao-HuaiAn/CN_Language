// CN 自举编译器 v2：容器类型 IR 辅助（自举重建 P7b，2026-09-01）
// 容器类型（向量/映射/链表/栈/队列/集合/结果）类型判定、对象大小表、
// 方法签名表——IR生成.cn 的容器实例化/方法调用据此合成宿主对齐符号
// （类$方法#参数串 → nameMangle，实现链接宿主编译 obj，rustc 预编译 std 模式）。
// 契约对标：宿主 generics.cpp（实例名 类名$实参 扁平 $ 连接）、semantic.cpp
//   signatureKey（方法名#参数类型1,参数类型2）、stdlib 容器.cn/映射集合.cn
//   （方法签名与字段布局）。
// 依赖说明：IR追加/建IR指令/IR_* 操作码/T_* 类型码/常量表 等由 IR生成.cn 定义，
//   此处纯名引用（不写 导入——IR生成 导入 语法分析、语法分析 导入 本模块，
//   写导入会成环：IR容器->IR生成->语法分析->IR容器；多文件合并后全局可见）。
导入 容器::向量
导入 映射集合
导入 IR签名    // 分段辅助/签名表扫描/类型参数替换（P7b 项1：解析 stdlib 建表）

公开:

// ==================== 方法返回形态 ====================
常量 容器返回_标量 = 0     // 标量返回 rax（大小/元素/为空/包含/删除(K) 布尔）
常量 容器返回_结果空 = 1   // 结果<空类型,整32>：隐藏返回指针，12 字节（追加/删除(i)/设置/插入/预留）
常量 容器返回_结果值 = 2   // 结果<T,整32>：隐藏返回指针（读取/获取/弹出/栈顶/出队/队首）
常量 容器返回_空类型 = 3   // 无返回值（清空）
常量 容器返回_结构体 = 4   // ②b B2（2026-09-02）：T 为结构体的按值返回（元素(位置)->T）——
                           //   隐藏返回指针，调用后 rax/x0=缓冲地址即结构体地址（宿主
                           //   epilogue mov x0,x19 / win rax 同款），链式 .字段 以此为基址

// ==================== 结构体布局表（②b B1，2026-09-02） ====================
// 语法分析 解析结构体声明 登记（字段按真实大小+自然对齐，对齐宿主 typeSizeOf）；
//   表置 IR容器 避免 语法分析->IR容器->语法分析 导入环。IR生成 查询：结构体局部
//   多槽/元素步长/拷贝大小/实参传地址判定/返回形态分类。
静态 映射<整64, 整64> 结构体大小表
静态 映射<整64, 整64> 结构体对齐表
静态 映射<整64, 整64> 字段类型表

// 类型大小/对齐（对齐宿主 typeSizeOf；容器 $ 合成名按对象大小表——②c A/B：
//   嵌套容器与容器字段布局精确化，消灭 8/8 兜底；结构体递归查表——须先声明后
//   使用，多文件依赖先解析保证；未知类型防御 8/8）
函数 类型大小与对齐(字符串 类型文本, 整64* 大小, 整64* 对齐) -> 空类型 {
    大小[0] = 8
    对齐[0] = 8
    如果 (字符串比较(类型文本, "布尔") || 字符串比较(类型文本, "字符") ||
        字符串比较(类型文本, "整8") || 字符串比较(类型文本, "正8")) {
        大小[0] = 1
        对齐[0] = 1
        返回
    }
    如果 (字符串比较(类型文本, "整16") || 字符串比较(类型文本, "正16")) {
        大小[0] = 2
        对齐[0] = 2
        返回
    }
    如果 (字符串比较(类型文本, "整32") || 字符串比较(类型文本, "正32")) {
        大小[0] = 4
        对齐[0] = 4
        返回
    }
    // ②c B：容器 $ 合成名——字段区按容器对象大小保留（指针槽模型：首 8 字节存
    //   堆对象指针，与宿主 typeSizeOf(容器) 布局对齐）
    如果 (是容器类(类型文本)) {
        大小[0] = 容器对象大小(类型文本)
        对齐[0] = 8
        返回
    }
    // 整64/正64/字符串/指针：8/8；结构体递归查表
    结果<整64, 整32> 查大小 = 结构体大小表.获取(驻留(类型文本))
    如果 (查大小.正常) {
        大小[0] = 查大小.值
        结果<整64, 整32> 查对齐 = 结构体对齐表.获取(驻留(类型文本))
        如果 (查对齐.正常) { 对齐[0] = 查对齐.值 }
    }
}

// 登记结构体布局（大小/对齐）——语法分析 解析结构体声明 尾部调用
函数 登记结构体布局(整64 结构体名ID, 整64 大小, 整64 对齐) -> 空类型 {
    结果<空类型, 整32> 加大小 = 结构体大小表.设置(结构体名ID, 大小)
    如果 (!加大小.正常) { 运行时错误(4) }
    结果<空类型, 整32> 加对齐 = 结构体对齐表.设置(结构体名ID, 对齐)
    如果 (!加对齐.正常) { 运行时错误(4) }
}

// 登记字段类型（分桶键=结构体名ID*键位移+字段名ID，由语法分析计算）——B4 用
函数 登记字段类型(整64 分桶键, 整64 字段类型名ID) -> 空类型 {
    结果<空类型, 整32> 加 = 字段类型表.设置(分桶键, 字段类型名ID)
    如果 (!加.正常) { 运行时错误(4) }
}

// 查结构体大小（0=非结构体/未登记——结构体性判定依据）
函数 查结构体大小(整64 类型名ID) -> 整64 {
    结果<整64, 整32> 查 = 结构体大小表.获取(类型名ID)
    如果 (查.正常) { 返回 查.值 }
    返回 0
}

// 查字段类型名ID（0=未登记；B4 资源字段析构注入用）
函数 查字段类型ID(整64 分桶键) -> 整64 {
    结果<整64, 整32> 查 = 字段类型表.获取(分桶键)
    如果 (查.正常) { 返回 查.值 }
    返回 0
}

// ==================== 字段偏移/宽度（②b B5，2026-09-02） ====================
// 分桶偏移表（键 = 结构体名ID*键位移+字段名ID——与 字段类型表 同键）：
//   语法层 解析后缀链 对调用对象（池.元素(i).字段）只能扁平回退查偏移（仅按
//   字段名——同名字段跨结构体必错，③ 自举必踩）；IR 层经方法签名返回类型
//   分桶收口，本表供查询。键位移 由语法分析定义（纯名引用——合并后全局可见）。
静态 映射<整64, 整64> 字段偏移表们

// 登记字段偏移（解析结构体声明 每字段调用——与 登记字段类型 同键同点）
函数 登记字段偏移(整64 分桶键, 整64 偏移) -> 空类型 {
    结果<空类型, 整32> 加 = 字段偏移表们.设置(分桶键, 偏移)
    如果 (!加.正常) { 运行时错误(4) }
}

// 查字段偏移（-1=未登记）
函数 查字段偏移(整64 分桶键) -> 整64 {
    结果<整64, 整32> 查 = 字段偏移表们.获取(分桶键)
    如果 (查.正常) { 返回 查.值 }
    返回 -1
}

// 类型宽度类型码：按字段类型文本返回 指针加载/存储 宽度标注（T_* 码）。
//   窄宽码 T_整8/T_整16/T_字符 由 IR生成 定义（纯名引用——合并后全局可见，
//   同 IR追加 先例）；其余（整64/字符串/指针/嵌套结构体）默认 8 字节。
函数 类型宽度码(字符串 类型文本) -> 整64 {
    如果 (字符串比较(类型文本, "布尔")) { 返回 T_布尔 }
    如果 (字符串比较(类型文本, "字符")) { 返回 T_字符 }
    如果 (字符串比较(类型文本, "整8") || 字符串比较(类型文本, "正8")) { 返回 T_整8 }
    如果 (字符串比较(类型文本, "整16") || 字符串比较(类型文本, "正16")) { 返回 T_整16 }
    如果 (字符串比较(类型文本, "整32") || 字符串比较(类型文本, "正32")) { 返回 T_整32 }
    返回 T_整64
}

// 查字段宽度码（结构体名ID+字段名ID 分桶；未登记返回 T_整64——防御默认 8 字节，
//   与旧行为一致）。根治：字段按统一 8 字节读/写——末字段越界清零相邻槽（126
//   段① i 槽被 子终点 8 字节写击穿 -> 当循环死循环 -> 堆 OOM SIGKILL，实测）。
函数 查字段宽度码(整64 结构体名ID, 整64 字段名ID) -> 整64 {
    整64 字段类型ID = 查字段类型ID(结构体名ID * 键位移 + 字段名ID)
    如果 (字段类型ID == 0) { 返回 T_整64 }
    返回 类型宽度码(驻留文本(字段类型ID))
}

// 多文件任务级生命周期：清空结构体布局表（主.cn 与 变量结构体表 同步调用）
函数 清空结构体布局表() -> 空类型 {
    结构体大小表.清空()
    结构体对齐表.清空()
    字段类型表.清空()
    字段偏移表们.清空()
    容器字段表们 = 向量<整64>()
    结构体容器字段数.清空()
}


// ==================== 实例实参再切分（②c A，2026-09-02） ====================
// $ 扁平合成名的实参串按基名元数贪婪再切分：向量$映射$整64$整64 -> ["映射$整64$整64"]、
//   映射$整64$整64 -> ["整64","整64"]。朴素 '$' 切分对嵌套实参必错（单参 T 被切成
//   首段 "映射"），方法符号（#参数串）与返回类型推导双双失真（对标宿主 AST 级
//   实例化——扁平串须按元数还原）。
函数 基名元数(字符串 基名) -> 整64 {
    如果 (字符串比较(基名, "映射") || 字符串比较(基名, "结果")) { 返回 2 }
    返回 1
}

// 实例化基名（容器 + 结果/可选——参与实参段的递归消费）
函数 是实例化基名(字符串 名) -> 布尔 {
    返回 是容器基名(名) || 字符串比较(名, "结果") || 字符串比较(名, "可选")
}

// 解析 [位置..] 为一个实参段：标识符词（含数字——类型名 整64/浮32/整128 等）；
//   实例化基名递归消费其元数个实参段；尾缀 '*'/'&' 字节原样并入。位置 出参推进
//  （调用方保证 '$' 分隔已消费）。
函数 解析实参段(字符串 实参串, 整64* 位置) -> 字符串 {
    整64 i = 位置[0]
    整64 n = 字符串长度(实参串)
    字符串 词 = ""
    当 (i < n) {
        整64 字节 = 整64(实参串[i])
        如果 (字节 < 0) { 字节 = 字节 + 256 }
        布尔 词字节 = 字节 >= 128 || (字节 >= 48 && 字节 <= 57) ||
                      (字节 >= 65 && 字节 <= 90) ||
                      (字节 >= 97 && 字节 <= 122) || 字节 == 95
        如果 (词字节) {
            词 = 词 + 字符串子串(实参串, i, 1)
            i++
        } 否则 {
            中断
        }
    }
    如果 (字符串长度(词) == 0) { 返回 "" }
    如果 (是实例化基名(词)) {
        整64 元 = 基名元数(词)
        整64 k = 0
        当 (k < 元) {
            // 期望 '$' 分隔（防御：不足则停止）
            如果 (i < n) {
                整64 分隔 = 整64(实参串[i])
                如果 (分隔 < 0) { 分隔 = 分隔 + 256 }
                如果 (分隔 == 36) { i++ }
            }
            位置[0] = i
            字符串 子段 = 解析实参段(实参串, 位置)
            如果 (字符串长度(子段) == 0) { 中断 }
            词 = 词 + "$" + 子段
            i = 位置[0]
            k++
        }
    }
    // 尾缀 '*'(42) / '&'(38) 原样并入（指针/引用形实参）
    当 (i < n) {
        整64 后缀 = 整64(实参串[i])
        如果 (后缀 < 0) { 后缀 = 后缀 + 256 }
        如果 (后缀 == 42 || 后缀 == 38) {
            词 = 词 + 字符串子串(实参串, i, 1)
            i++
        } 否则 {
            中断
        }
    }
    位置[0] = i
    返回 词
}

// 取实例实参们：跳过基名首段，按元数贪婪切分全部实参（返回向量）
函数 取实例实参们(字符串 合成名) -> 向量<字符串> {
    向量<字符串> 实参们 = 向量<字符串>()
    整64 首 = 首分段位置(合成名)
    如果 (首 < 0) { 返回 实参们 }
    整64 i = 首 + 1
    整64 n = 字符串长度(合成名)
    当 (i < n) {
        整64 位置 = i
        字符串 段 = 解析实参段(合成名, &位置)
        如果 (字符串长度(段) == 0) { 中断 }
        结果<空类型, 整32> 加段 = 实参们.追加(段)
        如果 (!加段.正常) { 运行时错误(4) }
        i = 位置
        // 期望 '$' 分隔或结束
        如果 (i < n) {
            整64 分隔 = 整64(合成名[i])
            如果 (分隔 < 0) { 分隔 = 分隔 + 256 }
            如果 (分隔 == 36) { i++ }
        }
    }
    返回 实参们
}

// ==================== 结构体容器字段表（②c B，2026-09-02） ====================
// 指针槽模型：字段区按 容器对象大小 保留、首 8 字节存堆对象指针。语法层
//   解析结构体声明 登记（四元组：结构体ID/字段名ID/字段容器类型ID/字段偏移），
//   IR 层据此发射：字段构造赋值后读（LoadPtr->this）/块出口与返回的字段级联析构。
静态 向量<整64> 容器字段表们        // 四元组平铺：[结构体ID, 字段名ID, 字段类型ID, 偏移]
静态 映射<整64, 整64> 结构体容器字段数  // 结构体ID -> 该结构体容器字段个数（登记时累计）

// 登记一个容器字段（解析结构体声明 内调用）
函数 登记容器字段(整64 结构体名ID, 整64 字段名ID, 整64 字段类型ID, 整64 偏移) -> 空类型 {
    结果<空类型, 整32> 加1 = 容器字段表们.追加(结构体名ID)
    如果 (!加1.正常) { 运行时错误(4) }
    结果<空类型, 整32> 加2 = 容器字段表们.追加(字段名ID)
    如果 (!加2.正常) { 运行时错误(4) }
    结果<空类型, 整32> 加3 = 容器字段表们.追加(字段类型ID)
    如果 (!加3.正常) { 运行时错误(4) }
    结果<空类型, 整32> 加4 = 容器字段表们.追加(偏移)
    如果 (!加4.正常) { 运行时错误(4) }
    整64 已有 = 0
    结果<整64, 整32> 查数 = 结构体容器字段数.获取(结构体名ID)
    如果 (查数.正常) { 已有 = 查数.值 }
    结果<空类型, 整32> 设数 = 结构体容器字段数.设置(结构体名ID, 已有 + 1)
    如果 (!设数.正常) { 运行时错误(4) }
}

// 结构体是否含容器字段（0=无；>0=个数——RAII 跟踪与析构注入依据）
函数 容器字段数(整64 结构体名ID) -> 整64 {
    结果<整64, 整32> 查 = 结构体容器字段数.获取(结构体名ID)
    如果 (查.正常) { 返回 查.值 }
    返回 0
}

// 取结构体全部容器字段四元组（写入出参向量：[字段名ID, 字段类型ID, 偏移] 三元组平铺）
函数 取容器字段们(整64 结构体名ID, 向量<整64>& 出) -> 空类型 {
    整64 i = 0
    当 (i + 3 <= 容器字段表们.大小()) {
        如果 (容器字段表们.元素(i) == 结构体名ID) {
            结果<空类型, 整32> 加名 = 出.追加(容器字段表们.元素(i + 1))
            如果 (!加名.正常) { 运行时错误(4) }
            结果<空类型, 整32> 加类 = 出.追加(容器字段表们.元素(i + 2))
            如果 (!加类.正常) { 运行时错误(4) }
            结果<空类型, 整32> 加偏 = 出.追加(容器字段表们.元素(i + 3))
            如果 (!加偏.正常) { 运行时错误(4) }
        }
        i += 4
    }
}

// ==================== 顶层静态声明表（②c C，2026-09-02） ====================
// 任务级生命周期：名ID -> 序号（IR 标识符解析）；名/类型平铺（入口构造注入）；
//   IR生成 入口收集（先清空，幂等）。存储=双后端 .data _cn_gstatic_<序号> 槽
//   （统一指针槽：容器=堆对象指针；标量=初始值——.data 直存折叠字面量）。
静态 映射<整64, 整64> 静态序号们
静态 向量<整64> 静态名们
静态 向量<整64> 静态类型们

函数 清空静态表() -> 空类型 {
    静态序号们.清空()
    静态名们 = 向量<整64>()
    静态类型们 = 向量<整64>()
}

// 收集一个 程序 节点区间的全部静态声明（容器/标量通用——初始值折叠由 IR生成 完成）
函数 收集静态(向量<节点> 池, 整32 程序节点, 向量<整64>& 初始值们) -> 空类型 {
    节点 程序 = 池.元素(程序节点)
    整64 i = 整64(程序.子起点)
    当 (i < 整64(程序.子终点)) {
        节点 声明 = 池.元素(整32(i))
        如果 (声明.类型 == 节点_静态声明) {
            整64 序号 = 静态名们.大小()
            结果<空类型, 整32> 加名 = 静态名们.追加(整64(声明.文本))
            如果 (!加名.正常) { 运行时错误(4) }
            节点 类型节点 = 池.元素(整32(声明.附加))
            结果<空类型, 整32> 加类 = 静态类型们.追加(整64(类型节点.文本))
            如果 (!加类.正常) { 运行时错误(4) }
            结果<空类型, 整32> 设序 = 静态序号们.设置(整64(声明.文本), 序号)
            如果 (!设序.正常) { 运行时错误(4) }
            字符串 类型文本 = 驻留文本(整64(类型节点.文本))
            如果 (是容器类(类型文本)) {
                // 容器静态：入口 NewObject+构造（初始值表达式同构，忽略）——
                //   .data 槽初值 0（文本 ID 形态——代码生成经 驻留文本 还原）
                结果<空类型, 整32> 加零 = 初始值们.追加(驻留("0"))
                如果 (!加零.正常) { 运行时错误(4) }
            } 否则 {
                // 标量静态：初始值折叠（空初始化按 0）
                整64 值ID = 驻留("0")
                如果 (声明.子起点 < 声明.子终点) {
                    整64 折叠 = 折叠常量值(池, 声明.子起点, 声明.子终点)
                    如果 (折叠 != 0) { 值ID = 折叠 }
                }
                结果<空类型, 整32> 加值 = 初始值们.追加(值ID)
                如果 (!加值.正常) { 运行时错误(4) }
            }
        }
        i++
    }
}

// ==================== 符号合成（宿主 methodSymbolKey 对齐） ====================
// 无参构造符号：类$基名（向量$整64 -> 向量$整64$向量；宿主构造方法名=类名）
函数 构造符号(字符串 合成名) -> 字符串 {
    返回 合成名 + "$" + 合成名基名(合成名)
}

// 析构符号：类$~基名（向量$整64 -> 向量$整64$~向量）
函数 析构符号(字符串 合成名) -> 字符串 {
    返回 合成名 + "$~" + 合成名基名(合成名)
}

// 方法符号：类$方法[#参数串]（参数串空则无 #——对标宿主 signatureKey）
函数 方法符号(字符串 合成名, 字符串 方法名, 字符串 参数串) -> 字符串 {
    如果 (字符串长度(参数串) == 0) { 返回 合成名 + "$" + 方法名 }
    返回 合成名 + "$" + 方法名 + "#" + 参数串
}

// 结果<T,E> 类型字节大小（ABI 防御布局——宿主 typeSizeOf 结果分支）：
//   正常@0(i32)+联合@4(整32)/@8(整64/字符串)；空类型/整32 -> 12，整64/字符串 -> 16
函数 结果大小(字符串 结果类型名) -> 整64 {
    字符串 值类型 = 段首(合成名首实参(结果类型名))
    如果 (字符串比较(值类型, "整32") || 字符串比较(值类型, "正32") ||
        字符串比较(值类型, "空类型")) { 返回 12 }
    返回 16
}

// 结果变量槽位数（8 字节槽）：12/16 字节均占 2 槽
函数 结果槽位数(字符串 结果类型名) -> 整64 {
    返回 2
}

// ==================== 类型判定 ====================
// 类基名白名单（stdlib 泛型容器类。注意：结果/可选 不在此列——它们是宿主
//   内置泛型（合成结构体，非堆对象），由 是结果类型 判定；混入白名单会把
//   结果 变量误判为容器（NewObject+构造——v2p 冒烟实测踩坑）。
//   构造调用合法性判定处（语义/IR）用 是容器类 || 是结果类型 组合。
函数 是容器基名(字符串 名) -> 布尔 {
    返回 字符串比较(名, "向量") || 字符串比较(名, "映射") ||
          字符串比较(名, "链表") || 字符串比较(名, "栈") ||
          字符串比较(名, "队列") || 字符串比较(名, "集合")
}

// 是容器类类型：$ 合成名 且 基名 ∈ 白名单（向量$整64；裸名"向量"非实例）
函数 是容器类(字符串 名) -> 布尔 {
    如果 (首分段位置(名) < 0) { 返回 假 }
    返回 是容器基名(合成名基名(名))
}

// 是结果类型：基名=结果/可选（结果$空类型$整32）
函数 是结果类型(字符串 名) -> 布尔 {
    如果 (首分段位置(名) < 0) { 返回 假 }
    字符串 基名 = 合成名基名(名)
    返回 字符串比较(基名, "结果") || 字符串比较(基名, "可选")
}

// ==================== 对象大小表（NewObject 分配字节数） ====================
// 对标宿主 computeClassLayout 按 stdlib 字段布局（指针/整64 各 8 字节）。
//   ⚠ 维护契约：stdlib 容器.cn/映射集合.cn 字段变更须同步本表。
函数 容器对象大小(字符串 合成名) -> 整64 {
    字符串 基名 = 合成名基名(合成名)
    如果 (字符串比较(基名, "向量")) { 返回 24 }   // T*数据+元素数量+数组容量
    如果 (字符串比较(基名, "链表")) { 返回 48 }   // 值表+下一索引+值容量+头+尾+元素数量
    如果 (字符串比较(基名, "栈")) { 返回 24 }     // 数据+元素数量+数组容量
    如果 (字符串比较(基名, "队列")) { 返回 48 }   // 值表+下一索引+值容量+头+尾+元素数量
    如果 (字符串比较(基名, "映射")) { 返回 56 }   // 键+值+链+桶四数组+桶数量+元素数量+数组容量
    如果 (字符串比较(基名, "集合")) { 返回 24 }   // 数据数组+元素数量+数组容量
    返回 8
}

// ==================== 方法签名表 ====================
// 查表：类$合成名 + 方法名 + 实参数 → 参数类型串（T/K/V 已替换实例文本，
//   逗号连接——对标宿主 signatureKey）与返回形态。出参 值偏移=结果<T,E>.值
//   字节偏移（整32→4；整64/字符串/指针→8）。返回 假=方法未收录。
结构体 方法签名 {
    字符串 参数串
    整64 返回形态
    整64 值偏移
    字符串 返回文本    // ②b B5：替换后返回类型文本（链式成员 偏移/宽度 收口 + retbuf 尺寸用）
}

// 结果<T,E> 的 值 字节偏移：T=整32 -> 4（正常@0+联合@4）；其余（整64/字符串/指针）-> 8
函数 结果值偏移(字符串 值类型) -> 整64 {
    如果 (字符串比较(值类型, "整32")) { 返回 4 }
    如果 (字符串比较(值类型, "正32")) { 返回 4 }
    返回 8
}

// 查方法签名（用户裁决项1：签名表查询 + 类型参数替换，替代硬编码 if 链——
//   stdlib 改签名/加方法 v2 自动跟随）。返回形态按替换后的返回类型通用判定：
//   结果$T$E -> 结果空（T=空类型）/结果值（+值偏移）；空类型 -> 无返回；
//   容器 $ 合成名 -> 容器返回_结构体（②c A：元素(i) 返回容器——宿主 typeSizeOf>8
//   隐藏返回指针拷贝对象字段，rax=缓冲地址即对象形基址，链式 .设置/.获取 this=此）；
//   其余 -> 标量（结构体返回亦走 结构体 形态）。未收录（表无此键）返回 假（调用方诊断）。
函数 查方法签名(字符串 合成名, 字符串 方法名, 整64 实参数, 方法签名* 出) -> 布尔 {
    字符串 基名 = 合成名基名(合成名)
    确保签名已加载()
    整64 键ID = 驻留(基名 + "." + 方法名 + "." + 整数转字符串(实参数))
    结果<整64, 整32> 查参 = 签名参数串们.获取(键ID)
    结果<整64, 整32> 查返 = 签名返回们.获取(键ID)
    如果 (查参.正常) {
        如果 (查返.正常) {
            // ②c A：实参替换改按元数切分的实参列表（朴素 '$' 切分对嵌套实参错）；
            //   类型参数序串经 类类型参数们 查取（基名 -> "T"/"K,V"）
            向量<字符串> 实参们 = 取实例实参们(合成名)
            字符串 序串 = ""
            结果<整64, 整32> 查序 = 类类型参数们.获取(驻留(基名))
            如果 (查序.正常) { 序串 = 驻留文本(查序.值) }
            出.参数串 = 替换类型参数带段们(驻留文本(查参.值), 序串, 实参们)
            字符串 返回文本 = 归一结果名(替换类型参数带段们(驻留文本(查返.值), 序串, 实参们))
            出.返回文本 = 返回文本
            如果 (是结果类型(返回文本)) {
                字符串 值类型 = 段首(合成名首实参(返回文本))
                如果 (字符串比较(值类型, "空类型")) {
                    出.返回形态 = 容器返回_结果空
                } 否则 {
                    出.返回形态 = 容器返回_结果值
                    出.值偏移 = 结果值偏移(值类型)
                }
            } 否则 如果 (字符串比较(返回文本, "空类型")) {
                出.返回形态 = 容器返回_空类型
            } 否则 {
                // ②b B2：T 为纯结构体 -> 隐藏返回指针形态（元素(位置)->T 链式 .字段 视图）。
                //   ②c A 实测修正（E2E 118 asm 实证）：① T 为容器（类）-> 标量（ptr）——
                //   类元素 8 字节指针步长存储、rax 返回元素指针；② T 为含容器字段的
                //   结构体 -> 亦标量——供给契约（HANDOFF B）：拥有式结构体以类形态
                //   供给（H8-⑤ 深拷贝 + Feature2 级联），宿主同按类元素 ptr 存储
                //（127 B4 段错误根因：误入 结构体 形态致 this/实参错位）
                整64 返回ID = 驻留(返回文本)
                如果 (查结构体大小(返回ID) != 0 && 容器字段数(返回ID) == 0) {
                    出.返回形态 = 容器返回_结构体
                } 否则 {
                    出.返回形态 = 容器返回_标量
                }
            }
            返回 真
        }
    }
    返回 假
}

// 返回形态字节数（②b B6：retbuf 区按真实返回尺寸定帧——旧固定 2 槽=16 字节
//   对 ≥17 字节结构体返回越界踩顶变量槽，126 节点=24 字节实测踩中）。
//   结果空 12 / 结果值 结果大小 / 结构体 查结构体大小（②c A：容器返回=容器对象大小）；
//   标量/空类型 0=无 retbuf。
函数 签名返回字节数(方法签名* 签) -> 整64 {
    如果 (签.返回形态 == 容器返回_结果空) { 返回 12 }
    如果 (签.返回形态 == 容器返回_结果值) { 返回 结果大小(签.返回文本) }
    如果 (签.返回形态 == 容器返回_结构体) {
        如果 (是容器类(签.返回文本)) { 返回 容器对象大小(签.返回文本) }
        返回 查结构体大小(驻留(签.返回文本))
    }
    返回 0
}

// 发射调用实参装载（参数区模式，用户裁决项3）：弹出们 为倒序（元素0=最后实参），
//   实参 j（0 起，第 j+1 个）位号=起始位+j，寄存器=弹出们[个数-1-j]。
//   IR_调用实参 为声明性指令（代码生成在 IR_调用参数化 统一展开装载）。
函数 发射调用实参们(向量<整64> 弹出们, 整64 起始位, 向量<IR指令>& 指令) -> 空类型 {
    整64 n = 弹出们.大小()
    整64 j = 0
    当 (j < n) {
        IR追加(指令, 建IR指令(IR_调用实参, 弹出们.元素(n - 1 - j), 0, 0, 0, 起始位 + j, 0))
        j++
    }
}

// ==================== 容器声明预扫与 RAII（P7b） ====================
// ②c B：含容器字段结构体局部 [起, 止) 的字段逆序级联析构（指针槽模型：取基槽地址
//   -> 字段地址 -> 指针加载 -> DeleteObject——空安全，裸声明零初始化保证跳过）。
//   局部逆序 + 字段逆序（后声明先释放）。局部声明在 生成语句 B1 分支登记。
函数 发射容器字段析构(函数IR& 函数信息, 映射<整64, 整64>& 局部槽, 整64* 寄存器计数,
                       整64 起, 整64 止) -> 空类型 {
    整64 i = 止
    当 (i > 起) {
        i--
        整64 名ID = 函数信息.容器字段局部们.元素(i)
        整64 结构体ID = 函数信息.容器字段结构体们.元素(i)
        整64 槽 = 0
        结果<整64, 整32> 找槽 = 局部槽.获取(名ID)
        如果 (找槽.正常) { 槽 = 找槽.值 }
        如果 (槽 != 0) {
            向量<整64> 字段们 = 向量<整64>()
            取容器字段们(结构体ID, 字段们)
            整64 f = 字段们.大小()
            当 (f > 0) {
                f -= 3
                整64 字段类型ID = 字段们.元素(f + 1)
                整64 偏移 = 字段们.元素(f + 2)
                整64 基址reg = 寄存器计数[0]
                寄存器计数[0] = 寄存器计数[0] + 1
                IR追加(函数信息.指令, 建IR指令(IR_取地址, 槽, 0, 0, 基址reg, T_整64, 0))
                IR追加(函数信息.指令, 建IR指令(IR_字段地址, 基址reg, 0, 0, 基址reg, T_整64, 偏移))
                IR追加(函数信息.指令, 建IR指令(IR_指针加载, 基址reg, 0, 0, 基址reg, T_对象, 0))
                IR追加(函数信息.指令, 建IR指令(IR_删除对象, 基址reg, 0, 0,
                                                     寄存器计数[0], 0, 字段类型ID))
                寄存器计数[0] = 寄存器计数[0] + 1
            }
        }
    }
}

// 块级作用域出口析构（用户裁决项2，生成块 调用）：对 容器变量们 在 基线 之后
//   新增的容器（本块声明的，逆序）发 RAII 析构并截断列表——块结束即释放；
//   ②c B：含容器字段结构体局部同款（字段基线 截断）。
函数 块出口析构(函数IR& 函数信息, 映射<整64, 整64>& 局部槽, 整64* 寄存器计数,
                整64 作用域基线, 整64 字段基线) -> 空类型 {
    当 (函数信息.容器变量们.大小() > 作用域基线) {
        整64 最后 = 函数信息.容器变量们.大小() - 1
        整64 名ID = 函数信息.容器变量们.元素(最后)
        整64 槽 = 0
        结果<整64, 整32> 找槽 = 局部槽.获取(名ID)
        如果 (找槽.正常) { 槽 = 找槽.值 }
        如果 (槽 != 0) {
            结果<整64, 整32> 查类型 = 函数信息.变量类型.获取(名ID)
            如果 (查类型.正常) {
                整64 ptr寄存器 = 寄存器计数[0]
                寄存器计数[0] = 寄存器计数[0] + 1
                IR追加(函数信息.指令, 建IR指令(IR_加载, 槽, 0, 0, ptr寄存器, T_对象, 0))
                IR追加(函数信息.指令, 建IR指令(IR_删除对象, ptr寄存器, 0, 0,
                                                     寄存器计数[0], 0, 查类型.值))
                寄存器计数[0] = 寄存器计数[0] + 1
            }
        }
        结果<空类型, 整32> 删容 = 函数信息.容器变量们.删除(最后)
        如果 (!删容.正常) { 运行时错误(4) }
    }
    如果 (函数信息.容器字段局部们.大小() > 字段基线) {
        发射容器字段析构(函数信息, 局部槽, 寄存器计数, 字段基线,
                          函数信息.容器字段局部们.大小())
        // 截断两条跟踪列表至基线
        当 (函数信息.容器字段局部们.大小() > 字段基线) {
            结果<空类型, 整32> 删局 = 函数信息.容器字段局部们.删除(
                函数信息.容器字段局部们.大小() - 1)
            如果 (!删局.正常) { 运行时错误(4) }
            结果<空类型, 整32> 删构 = 函数信息.容器字段结构体们.删除(
                函数信息.容器字段结构体们.大小() - 1)
            如果 (!删构.正常) { 运行时错误(4) }
        }
    }
}

// 预扫容器声明：函数体块区间一次线性扫描（嵌套块/条件体语句节点均含于函数体块
//   子区间——节点池顺序追加，体块节点最后入池），为全部容器变量：分配槽 +
//   入口零初始化（未执行声明路径的槽=确定性空指针，DeleteObject 空安全跳过）+
//   登记 变量类型/容器变量们。注：同名变量（不同块）合并同槽（v2 局部槽为
//   函数级映射——精确块级作用域析构留 P7c）。
函数 预扫容器声明(向量<节点> 池, 整32 块节点, 函数IR& 函数信息,
                  整64* 槽计数, 整64* 寄存器计数) -> 空类型 {
    整64 零寄存器 = 0
    节点 块 = 池.元素(块节点)
    整64 i = 整64(块.子起点)
    当 (i < 整64(块.子终点)) {
        节点 声明 = 池.元素(整32(i))
        如果 (声明.类型 == 节点_变量声明) {
            节点 类型节点 = 池.元素(整32(声明.附加))
            字符串 类型文本 = 驻留文本(整64(类型节点.文本))
            如果 (是容器类(类型文本)) {
                结果<整64, 整32> 已有 = 函数信息.局部槽.获取(整64(声明.文本))
                如果 (!已有.正常) {
                    整64 槽 = 槽计数[0]
                    槽计数[0] = 槽计数[0] + 1
                    结果<空类型, 整32> 设槽 = 函数信息.局部槽.设置(整64(声明.文本), 槽)
                    如果 (!设槽.正常) { 运行时错误(4) }
                    IR追加(函数信息.指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽))
                    // 入口零初始化（共享一个零寄存器）
                    如果 (零寄存器 == 0) {
                        零寄存器 = 寄存器计数[0]
                        寄存器计数[0] = 寄存器计数[0] + 1
                        IR追加(函数信息.指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0,
                                             零寄存器, T_整64, 0))
                    }
                    IR追加(函数信息.指令, 建IR指令(IR_存储, 零寄存器, 0, 0, 0, 0, 槽))
                    结果<空类型, 整32> 设类型 = 函数信息.变量类型.设置(整64(声明.文本),
                                                              整64(类型节点.文本))
                    如果 (!设类型.正常) { 运行时错误(4) }
                    // ②c D：函数级变量类型权威表（跨函数同名异型根治）
                    结果<空类型, 整32> 设权威 = 当前函数变量类型.设置(整64(声明.文本),
                                                              整64(类型节点.文本))
                    如果 (!设权威.正常) { 运行时错误(4) }
                    结果<空类型, 整32> 加容器 = 函数信息.容器变量们.追加(整64(声明.文本))
                    如果 (!加容器.正常) { 运行时错误(4) }
                }
            }
        }
        i++
    }
}

// 发射容器析构（RAII）：对本函数全部容器局部 Load 槽 + IR_删除对象。
//   代码生成展开：test/je 空安全 + call ~类(this) + call __cn_object_delete(this)。
//   ②c B：含容器字段结构体局部随后按字段逆序级联析构（发射容器字段析构 全量）。
函数 发射容器析构(函数IR& 函数信息, 向量<IR指令>& 指令, 整64* 寄存器计数,
                  映射<整64, 整64>& 局部槽) -> 空类型 {
    整64 i = 0
    当 (i < 函数信息.容器变量们.大小()) {
        整64 名ID = 函数信息.容器变量们.元素(i)
        整64 槽 = 0
        结果<整64, 整32> 找槽 = 局部槽.获取(名ID)
        如果 (找槽.正常) { 槽 = 找槽.值 }
        如果 (槽 != 0) {
            结果<整64, 整32> 查类型 = 函数信息.变量类型.获取(名ID)
            如果 (查类型.正常) {
                整64 ptr寄存器 = 寄存器计数[0]
                寄存器计数[0] = 寄存器计数[0] + 1
                // 目标=标签唯一序号（代码生成 objdel_函数序号_目标 拼标签——
                //   多容器变量同函数多条删除指令，序号须唯一否则 MASM A2005）
                IR追加(指令, 建IR指令(IR_加载, 槽, 0, 0, ptr寄存器, T_对象, 0))
                IR追加(指令, 建IR指令(IR_删除对象, ptr寄存器, 0, 0, 寄存器计数[0], 0, 查类型.值))
                寄存器计数[0] = 寄存器计数[0] + 1
            }
        }
        i++
    }
    // ②c B：含容器字段结构体局部（全部——返回语句跨块跳出兜底，全量逆序）
    发射容器字段析构(函数信息, 局部槽, 寄存器计数, 0, 函数信息.容器字段局部们.大小())
}

// ==================== 指令追加辅助 ====================
// 引用传递：按值传 向量 会共享数据指针，.追加 扩容释放旧数组 -> 调用方向量悬垂。
函数 IR追加(向量<IR指令>& 列表, IR指令 指令) -> 空类型 {
    结果<空类型, 整32> 加 = 列表.追加(指令)
    如果 (!加.正常) { 运行时错误(4) }
}
函数 建IR指令(整64 操作码, 整64 操作数1, 整64 操作数2, 整64 操作数3,
              整64 目标, 整64 类型, 整64 附加) -> IR指令 {
    IR指令 指令
    指令.操作码 = 操作码
    指令.操作数1 = 操作数1
    指令.操作数2 = 操作数2
    指令.操作数3 = 操作数3
    指令.目标 = 目标
    指令.类型 = 类型
    指令.附加 = 附加
    返回 指令
}

// ==================== 类型名 -> IR 类型码 ====================
// 源码类型名（驻留文本）-> IR 类型码（T_*）。未知返回 T_未知。
函数 类型码(整64 类型名ID) -> 整64 {
    字符串 名 = 驻留文本(类型名ID)
    // CN 字符串 == 是指针比较（非内容）——须用 字符串比较
    如果 (字符串比较(名, "整32")) { 返回 T_整32 }
    如果 (字符串比较(名, "整64")) { 返回 T_整64 }
    如果 (字符串比较(名, "浮32")) { 返回 T_浮32 }
    如果 (字符串比较(名, "浮64")) { 返回 T_浮64 }
    如果 (字符串比较(名, "布尔")) { 返回 T_布尔 }
    如果 (字符串比较(名, "字符串")) { 返回 T_字符串 }
    如果 (字符串比较(名, "空类型")) { 返回 T_空类型 }
    如果 (字符串比较(名, "整8") || 字符串比较(名, "整16") ||
        字符串比较(名, "正8") || 字符串比较(名, "正16") ||
        字符串比较(名, "正32") || 字符串比较(名, "正64") ||
        字符串比较(名, "字符") || 字符串比较(名, "指针") ||
        字符串比较(名, "自动")) { 返回 T_整64 }
    返回 T_未知
}

// ==================== 顶层常量收集（P7a，2026-09-01） ====================
// 常量表：常量名ID -> 值文本ID（十进制文本）。代码生成 IR_常量整数 直接经
//   驻留文本(操作数1) 还原为立即数（负值为 "-N" 文本，mov rax, -N 合法），
//   故折叠全程零数值解析——正值复用字面量 Symbol ID，负值拼接后驻留一次。
//   收集在 IR生成/IR生成多文件 入口进行（先清空，幂等；多文件全部 程序 节点
//   依次收集，跨文件常量引用天然可见）。
静态 映射<整64, 整64> 常量表

// 折叠常量初始化区间 [起点, 终点)：整数字面量，或 [字面量, 负号]（负数）。
//   返回值文本ID；不可折叠（非字面量形态）返回 0。
函数 折叠常量值(向量<节点> 池, 整32 起点, 整32 终点) -> 整64 {
    如果 (终点 - 起点 == 1) {
        节点 值节点 = 池.元素(起点)
        如果 (值节点.类型 == 节点_整数字面量) {
            返回 整64(值节点.文本)
        }
    }
    如果 (终点 - 起点 == 2) {
        节点 值节点2 = 池.元素(起点)
        节点 负号节点 = 池.元素(起点 + 1)
        如果 (值节点2.类型 == 节点_整数字面量 && 负号节点.类型 == 节点_负号) {
            返回 驻留("-" + 驻留文本(整64(值节点2.文本)))
        }
    }
    返回 0
}

// 收集一个 程序 节点顶层区间的全部常量声明（登记进 常量表）。
//   非字面量初始化（如 常量 X = 1+2）：打印诊断且不登记——引用处将落入
//   函数名兜底路径（自举组件源码 84 处全部为整数字面量，不触发）。
函数 收集常量(向量<节点> 池, 整32 程序节点) -> 空类型 {
    节点 程序 = 池.元素(程序节点)
    整64 i = 整64(程序.子起点)
    当 (i < 整64(程序.子终点)) {
        节点 声明 = 池.元素(整32(i))
        如果 (声明.类型 == 节点_常量声明) {
            整64 值文本 = 折叠常量值(池, 声明.子起点, 声明.子终点)
            如果 (值文本 != 0) {
                结果<空类型, 整32> 设常 = 常量表.设置(整64(声明.文本), 值文本)
                如果 (!设常.正常) { 运行时错误(4) }
            } 否则 {
                IO::打印到错误("[ir2] 常量初始化须为整数字面量: " +
                              驻留文本(整64(声明.文本)) + "\n")
            }
        }
        i++
    }
}

// ==================== 内置函数表（③ 自举第一波，2026-09-03） ====================
// 宿主 ir_call.cpp 名称映射对齐；ABI 权威=宿主 asm 实证（内置函数为裸 ASCII 符号
// 直调：bl __cn_intern，v2p_linux.s 实查）。覆盖面=v2 组件自身用面（9 组件统计：
// 驻留209/运行时错误143/字符串比较134/驻留文本69/整数转字符串63/字符串长度52/
// 字符串子串36/类型大小7）+ 字符串连接（拼接 + 的展开目标，亦可独立调用）。
// 表驱动扩表：后续组件踩到新内置（IO::/文件:: 限定名等）按行追加即可。
函数 内置函数符号(字符串 名) -> 字符串 {
    如果 (字符串比较(名, "驻留")) { 返回 "__cn_intern" }
    如果 (字符串比较(名, "驻留文本")) { 返回 "__cn_intern_text" }
    如果 (字符串比较(名, "驻留计数")) { 返回 "__cn_intern_count" }
    如果 (字符串比较(名, "字符串长度")) { 返回 "__cn_str_len" }
    如果 (字符串比较(名, "字符串比较")) { 返回 "__cn_str_eq" }
    如果 (字符串比较(名, "字符串子串")) { 返回 "__cn_str_sub" }
    如果 (字符串比较(名, "字符串连接")) { 返回 "__cn_str_concat" }
    如果 (字符串比较(名, "整数转字符串")) { 返回 "__cn_str_from_int" }
    如果 (字符串比较(名, "运行时错误")) { 返回 "__cn_runtime_error" }
    // ③ 第五波（2026-09-03）：限定名内置（宿主 ir_call.cpp:217~235 对齐——限定名
    //   全局注册无需导入，IR 映射裸 ASCII 运行时符号直调）。IO::=stderr 诊断通道
    //   （v2 组件 全量在用）；文件::=v2 驱动器 源码读/asm 写 命脉（file_api.cpp）。
    如果 (字符串比较(名, "IO::读取行")) { 返回 "__cn_read_line" }
    如果 (字符串比较(名, "IO::读取整数")) { 返回 "__cn_read_int" }
    如果 (字符串比较(名, "IO::读取浮点")) { 返回 "__cn_read_float" }
    如果 (字符串比较(名, "IO::打印到错误")) { 返回 "__cn_print_err" }
    如果 (字符串比较(名, "文件::打开文件")) { 返回 "__cn_file_open" }
    如果 (字符串比较(名, "文件::读取文件")) { 返回 "__cn_file_read" }
    如果 (字符串比较(名, "文件::写入文件")) { 返回 "__cn_file_write" }
    如果 (字符串比较(名, "文件::读取文件行")) { 返回 "__cn_file_read_line" }
    如果 (字符串比较(名, "文件::文件大小")) { 返回 "__cn_file_size" }
    如果 (字符串比较(名, "文件::关闭文件")) { 返回 "__cn_file_close" }
    如果 (字符串比较(名, "文件::文件存在")) { 返回 "__cn_file_exists" }
    返回 ""
}

// 内置函数返回类型ID（语义层白名单 / IR 表达式类型推导共用）；0=非内置。
//   返回形态全为标量（整64/布尔）或指针（字符串）——单槽，无 sret/retbuf 复杂度。
//   限定名返回形态对齐宿主 semantic.cpp regIoFn/regFileFn（1226~1257 行）；
//   空类型* 按指针单槽记 整64（v2 无裸指针类型码——T_整64 载体）。
函数 内置函数返回类型ID(字符串 名) -> 整64 {
    如果 (字符串比较(名, "驻留文本") || 字符串比较(名, "字符串子串") ||
         字符串比较(名, "字符串连接") || 字符串比较(名, "整数转字符串")) {
        返回 驻留("字符串")
    }
    如果 (字符串比较(名, "字符串比较")) { 返回 驻留("布尔") }
    如果 (字符串比较(名, "驻留") || 字符串比较(名, "驻留计数") ||
         字符串比较(名, "字符串长度") || 字符串比较(名, "运行时错误") ||
         字符串比较(名, "打印") || 字符串比较(名, "打印行")) {
        返回 驻留("整64")
    }
    // 限定名内置：字符串/布尔/浮点/整64/空类型（打印分派与拼接判定消费）
    如果 (字符串比较(名, "IO::读取行") || 字符串比较(名, "文件::读取文件行")) {
        返回 驻留("字符串")
    }
    如果 (字符串比较(名, "文件::文件存在")) { 返回 驻留("布尔") }
    如果 (字符串比较(名, "IO::读取浮点")) { 返回 驻留("浮64") }
    如果 (字符串比较(名, "IO::打印到错误") || 字符串比较(名, "文件::关闭文件")) {
        返回 驻留("空类型")
    }
    如果 (字符串比较(名, "IO::读取整数") || 字符串比较(名, "文件::打开文件") ||
         字符串比较(名, "文件::读取文件") || 字符串比较(名, "文件::写入文件") ||
         字符串比较(名, "文件::文件大小")) {
        返回 驻留("整64")
    }
    返回 0
}

// 类型名宽度（类型大小(类型) 编译期折叠，规格 02-六B）：原始类型宽度表 +
//   结构体布局表（②b B1）；0=未知类型。对齐宿主 typeSizeOf（字符串=8 指针）。
函数 类型名宽度(整64 类型名ID) -> 整64 {
    字符串 名 = 驻留文本(类型名ID)
    如果 (字符串比较(名, "整8") || 字符串比较(名, "正8") ||
         字符串比较(名, "布尔") || 字符串比较(名, "字符")) { 返回 1 }
    如果 (字符串比较(名, "整16") || 字符串比较(名, "正16")) { 返回 2 }
    如果 (字符串比较(名, "整32") || 字符串比较(名, "正32") ||
         字符串比较(名, "浮32")) { 返回 4 }
    如果 (字符串比较(名, "整64") || 字符串比较(名, "正64") ||
         字符串比较(名, "浮64") || 字符串比较(名, "字符串")) { 返回 8 }
    如果 (字符串比较(名, "整128") || 字符串比较(名, "正128")) { 返回 16 }
    返回 查结构体大小(类型名ID)
}
