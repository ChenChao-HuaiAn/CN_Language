// CN 自举编译器 v2：容器类型 IR 辅助（自举重建 P7b，2026-09-01）
// 容器类型（向量/映射/链表/栈/队列/集合/结果）类型判定、对象大小表、
// 方法签名表——IR生成.cn 的容器实例化/方法调用据此合成宿主对齐符号
// （类$方法#参数串 → nameMangle，实现链接宿主编译 obj，rustc 预编译 std 模式）。
// 契约对标：宿主 generics.cpp（实例名 类名$实参 扁平 $ 连接）、semantic.cpp
//   signatureKey（方法名#参数类型1,参数类型2）、stdlib 容器.cn/映射集合.cn
//   （方法签名与字段布局）。
// 依赖说明：IR追加/建IR指令/IR_* 操作码/T_* 类型码/常量表 等由 IR生成.cn 定义，
//   此处纯名引用（不写 导入——IR生成 导入 语法分析、语法分析 导入 本模块，
//   写导入会成环：IR容器->IR生成->语法分析->IR容器；多文件合并后全局可见）。
导入 容器::向量
导入 映射集合
导入 IR签名    // 分段辅助/签名表扫描/类型参数替换（P7b 项1：解析 stdlib 建表）

公开:

// ==================== 方法返回形态 ====================
常量 容器返回_标量 = 0     // 标量返回 rax（大小/元素/为空/包含/删除(K) 布尔）
常量 容器返回_结果空 = 1   // 结果<空类型,整32>：隐藏返回指针，12 字节（追加/删除(i)/设置/插入/预留）
常量 容器返回_结果值 = 2   // 结果<T,整32>：隐藏返回指针（读取/获取/弹出/栈顶/出队/队首）
常量 容器返回_空类型 = 3   // 无返回值（清空）


// ==================== 符号合成（宿主 methodSymbolKey 对齐） ====================
// 无参构造符号：类$基名（向量$整64 -> 向量$整64$向量；宿主构造方法名=类名）
函数 构造符号(字符串 合成名) -> 字符串 {
    返回 合成名 + "$" + 合成名基名(合成名)
}

// 析构符号：类$~基名（向量$整64 -> 向量$整64$~向量）
函数 析构符号(字符串 合成名) -> 字符串 {
    返回 合成名 + "$~" + 合成名基名(合成名)
}

// 方法符号：类$方法[#参数串]（参数串空则无 #——对标宿主 signatureKey）
函数 方法符号(字符串 合成名, 字符串 方法名, 字符串 参数串) -> 字符串 {
    如果 (字符串长度(参数串) == 0) { 返回 合成名 + "$" + 方法名 }
    返回 合成名 + "$" + 方法名 + "#" + 参数串
}

// 结果<T,E> 类型字节大小（ABI 防御布局——宿主 typeSizeOf 结果分支）：
//   正常@0(i32)+联合@4(整32)/@8(整64/字符串)；空类型/整32 -> 12，整64/字符串 -> 16
函数 结果大小(字符串 结果类型名) -> 整64 {
    字符串 值类型 = 段首(合成名首实参(结果类型名))
    如果 (字符串比较(值类型, "整32") || 字符串比较(值类型, "正32") ||
        字符串比较(值类型, "空类型")) { 返回 12 }
    返回 16
}

// 结果变量槽位数（8 字节槽）：12/16 字节均占 2 槽
函数 结果槽位数(字符串 结果类型名) -> 整64 {
    返回 2
}

// ==================== 类型判定 ====================
// 类基名白名单（stdlib 泛型容器类。注意：结果/可选 不在此列——它们是宿主
//   内置泛型（合成结构体，非堆对象），由 是结果类型 判定；混入白名单会把
//   结果 变量误判为容器（NewObject+构造——v2p 冒烟实测踩坑）。
//   构造调用合法性判定处（语义/IR）用 是容器类 || 是结果类型 组合。
函数 是容器基名(字符串 名) -> 布尔 {
    返回 字符串比较(名, "向量") || 字符串比较(名, "映射") ||
          字符串比较(名, "链表") || 字符串比较(名, "栈") ||
          字符串比较(名, "队列") || 字符串比较(名, "集合")
}

// 是容器类类型：$ 合成名 且 基名 ∈ 白名单（向量$整64；裸名"向量"非实例）
函数 是容器类(字符串 名) -> 布尔 {
    如果 (首分段位置(名) < 0) { 返回 假 }
    返回 是容器基名(合成名基名(名))
}

// 是结果类型：基名=结果/可选（结果$空类型$整32）
函数 是结果类型(字符串 名) -> 布尔 {
    如果 (首分段位置(名) < 0) { 返回 假 }
    字符串 基名 = 合成名基名(名)
    返回 字符串比较(基名, "结果") || 字符串比较(基名, "可选")
}

// ==================== 对象大小表（NewObject 分配字节数） ====================
// 对标宿主 computeClassLayout 按 stdlib 字段布局（指针/整64 各 8 字节）。
//   ⚠ 维护契约：stdlib 容器.cn/映射集合.cn 字段变更须同步本表。
函数 容器对象大小(字符串 合成名) -> 整64 {
    字符串 基名 = 合成名基名(合成名)
    如果 (字符串比较(基名, "向量")) { 返回 24 }   // T*数据+元素数量+数组容量
    如果 (字符串比较(基名, "链表")) { 返回 48 }   // 值表+下一索引+值容量+头+尾+元素数量
    如果 (字符串比较(基名, "栈")) { 返回 24 }     // 数据+元素数量+数组容量
    如果 (字符串比较(基名, "队列")) { 返回 48 }   // 值表+下一索引+值容量+头+尾+元素数量
    如果 (字符串比较(基名, "映射")) { 返回 56 }   // 键+值+链+桶四数组+桶数量+元素数量+数组容量
    如果 (字符串比较(基名, "集合")) { 返回 24 }   // 数据数组+元素数量+数组容量
    返回 8
}

// ==================== 方法签名表 ====================
// 查表：类$合成名 + 方法名 + 实参数 → 参数类型串（T/K/V 已替换实例文本，
//   逗号连接——对标宿主 signatureKey）与返回形态。出参 值偏移=结果<T,E>.值
//   字节偏移（整32→4；整64/字符串/指针→8）。返回 假=方法未收录。
结构体 方法签名 {
    字符串 参数串
    整64 返回形态
    整64 值偏移
}

// 结果<T,E> 的 值 字节偏移：T=整32 -> 4（正常@0+联合@4）；其余（整64/字符串/指针）-> 8
函数 结果值偏移(字符串 值类型) -> 整64 {
    如果 (字符串比较(值类型, "整32")) { 返回 4 }
    如果 (字符串比较(值类型, "正32")) { 返回 4 }
    返回 8
}

// 查方法签名（用户裁决项1：签名表查询 + 类型参数替换，替代硬编码 if 链——
//   stdlib 改签名/加方法 v2 自动跟随）。返回形态按替换后的返回类型通用判定：
//   结果$T$E -> 结果空（T=空类型）/结果值（+值偏移）；空类型 -> 无返回；其余 -> 标量。
//   未收录（表无此键）返回 假（调用方诊断）。
函数 查方法签名(字符串 合成名, 字符串 方法名, 整64 实参数, 方法签名* 出) -> 布尔 {
    IO::打印到错误("[dbg] 入口: 方法名=[" + 方法名 + "] 合成名=[" + 合成名 + "] 实参数=" +
                  整数转字符串(实参数) + "\n")
    字符串 基名 = 合成名基名(合成名)
    确保签名已加载()
    IO::打印到错误("[dbg] 加载后: 方法名=[" + 方法名 + "]" + "\n")
    整64 键ID = 驻留(基名 + "." + 方法名 + "." + 整数转字符串(实参数))
    IO::打印到错误("[dbg] 驻留后: 方法名=[" + 方法名 + "]" + "\n")
    结果<整64, 整32> 查参 = 签名参数串们.获取(键ID)
    IO::打印到错误("[dbg] 取参后: 方法名=[" + 方法名 + "]" + "\n")
    结果<整64, 整32> 查返 = 签名返回们.获取(键ID)
    如果 (查参.正常) {
        如果 (查返.正常) {
            出->参数串 = 替换类型参数(驻留文本(查参.值), 基名, 合成名)
            字符串 返回文本 = 替换类型参数(驻留文本(查返.值), 基名, 合成名)
            如果 (是结果类型(返回文本)) {
                字符串 值类型 = 段首(合成名首实参(返回文本))
                如果 (字符串比较(值类型, "空类型")) {
                    出->返回形态 = 容器返回_结果空
                } 否则 {
                    出->返回形态 = 容器返回_结果值
                    出->值偏移 = 结果值偏移(值类型)
                }
            } 否则 如果 (字符串比较(返回文本, "空类型")) {
                出->返回形态 = 容器返回_空类型
            } 否则 {
                出->返回形态 = 容器返回_标量
            }
            返回 真
        }
    }
    // 签名表未命中（或签名扫描缺陷未根治期：表空）——回退内置表
    //（用户裁决项1 过渡态：字符串参数跨调用 UB 缺陷根治后移除，见 plans/014）
    返回 查方法签名内置(合成名, 方法名, 实参数, 出)
}

函数 查方法签名内置(字符串 合成名, 字符串 方法名, 整64 实参数, 方法签名* 出) -> 布尔 {
    字符串 基名 = 合成名基名(合成名)
    字符串 T = 合成名首实参(合成名)
    // ---- 向量<T> ----
    如果 (字符串比较(基名, "向量")) {
        如果 (字符串比较(方法名, "大小") && 实参数 == 0) {
            出->参数串 = ""
            出->返回形态 = 容器返回_标量
            返回 真
        }
        如果 (字符串比较(方法名, "为空") && 实参数 == 0) {
            出->参数串 = ""
            出->返回形态 = 容器返回_标量
            返回 真
        }
        如果 (字符串比较(方法名, "容量") && 实参数 == 0) {
            出->参数串 = ""
            出->返回形态 = 容器返回_标量
            返回 真
        }
        如果 (字符串比较(方法名, "元素") && 实参数 == 1) {
            出->参数串 = "整64"
            出->返回形态 = 容器返回_标量
            返回 真
        }
        如果 (字符串比较(方法名, "追加") && 实参数 == 1) {
            出->参数串 = T
            出->返回形态 = 容器返回_结果空
            返回 真
        }
        如果 (字符串比较(方法名, "插入") && 实参数 == 2) {
            出->参数串 = "整64," + T
            出->返回形态 = 容器返回_结果空
            返回 真
        }
        如果 (字符串比较(方法名, "设置") && 实参数 == 2) {
            出->参数串 = "整64," + T
            出->返回形态 = 容器返回_结果空
            返回 真
        }
        如果 (字符串比较(方法名, "读取") && 实参数 == 1) {
            出->参数串 = "整64"
            出->返回形态 = 容器返回_结果值
            出->值偏移 = 结果值偏移(T)
            返回 真
        }
        如果 (字符串比较(方法名, "删除") && 实参数 == 1) {
            出->参数串 = "整64"
            出->返回形态 = 容器返回_结果空
            返回 真
        }
        如果 (字符串比较(方法名, "预留") && 实参数 == 1) {
            出->参数串 = "整64"
            出->返回形态 = 容器返回_结果空
            返回 真
        }
        如果 (字符串比较(方法名, "清空") && 实参数 == 0) {
            出->参数串 = ""
            出->返回形态 = 容器返回_空类型
            返回 真
        }
        返回 假
    }
    // ---- 映射<K,V> ----
    如果 (字符串比较(基名, "映射")) {
        字符串 K = 段首(T)
        字符串 V = 段余(T)
        如果 (字符串比较(方法名, "大小") && 实参数 == 0) {
            出->参数串 = ""
            出->返回形态 = 容器返回_标量
            返回 真
        }
        如果 (字符串比较(方法名, "为空") && 实参数 == 0) {
            出->参数串 = ""
            出->返回形态 = 容器返回_标量
            返回 真
        }
        如果 (字符串比较(方法名, "设置") && 实参数 == 2) {
            出->参数串 = K + "," + V
            出->返回形态 = 容器返回_结果空
            返回 真
        }
        如果 (字符串比较(方法名, "获取") && 实参数 == 1) {
            出->参数串 = K
            出->返回形态 = 容器返回_结果值
            出->值偏移 = 结果值偏移(V)
            返回 真
        }
        如果 (字符串比较(方法名, "删除") && 实参数 == 1) {
            出->参数串 = K
            出->返回形态 = 容器返回_标量
            返回 真
        }
        如果 (字符串比较(方法名, "包含") && 实参数 == 1) {
            出->参数串 = K
            出->返回形态 = 容器返回_标量
            返回 真
        }
        如果 (字符串比较(方法名, "清空") && 实参数 == 0) {
            出->参数串 = ""
            出->返回形态 = 容器返回_空类型
            返回 真
        }
        返回 假
    }
    // ---- 链表<T> ----
    如果 (字符串比较(基名, "链表")) {
        如果 (字符串比较(方法名, "大小") && 实参数 == 0) {
            出->参数串 = ""
            出->返回形态 = 容器返回_标量
            返回 真
        }
        如果 (字符串比较(方法名, "为空") && 实参数 == 0) {
            出->参数串 = ""
            出->返回形态 = 容器返回_标量
            返回 真
        }
        如果 (字符串比较(方法名, "追加") && 实参数 == 1) {
            出->参数串 = T
            出->返回形态 = 容器返回_结果空
            返回 真
        }
        如果 (字符串比较(方法名, "头部追加") && 实参数 == 1) {
            出->参数串 = T
            出->返回形态 = 容器返回_结果空
            返回 真
        }
        如果 (字符串比较(方法名, "删除头部") && 实参数 == 0) {
            出->参数串 = ""
            出->返回形态 = 容器返回_结果空
            返回 真
        }
        如果 (字符串比较(方法名, "删除尾部") && 实参数 == 0) {
            出->参数串 = ""
            出->返回形态 = 容器返回_结果空
            返回 真
        }
        如果 (字符串比较(方法名, "读取头部") && 实参数 == 0) {
            出->参数串 = ""
            出->返回形态 = 容器返回_结果值
            出->值偏移 = 结果值偏移(T)
            返回 真
        }
        如果 (字符串比较(方法名, "读取尾部") && 实参数 == 0) {
            出->参数串 = ""
            出->返回形态 = 容器返回_结果值
            出->值偏移 = 结果值偏移(T)
            返回 真
        }
        如果 (字符串比较(方法名, "头部元素") && 实参数 == 0) {
            出->参数串 = ""
            出->返回形态 = 容器返回_标量
            返回 真
        }
        如果 (字符串比较(方法名, "清空") && 实参数 == 0) {
            出->参数串 = ""
            出->返回形态 = 容器返回_空类型
            返回 真
        }
        返回 假
    }
    // ---- 栈<T> ----
    如果 (字符串比较(基名, "栈")) {
        如果 (字符串比较(方法名, "压入") && 实参数 == 1) {
            出->参数串 = T
            出->返回形态 = 容器返回_结果空
            返回 真
        }
        如果 (字符串比较(方法名, "弹出") && 实参数 == 0) {
            出->参数串 = ""
            出->返回形态 = 容器返回_结果值
            出->值偏移 = 结果值偏移(T)
            返回 真
        }
        如果 (字符串比较(方法名, "栈顶") && 实参数 == 0) {
            出->参数串 = ""
            出->返回形态 = 容器返回_结果值
            出->值偏移 = 结果值偏移(T)
            返回 真
        }
        如果 (字符串比较(方法名, "大小") && 实参数 == 0) {
            出->参数串 = ""
            出->返回形态 = 容器返回_标量
            返回 真
        }
        如果 (字符串比较(方法名, "为空") && 实参数 == 0) {
            出->参数串 = ""
            出->返回形态 = 容器返回_标量
            返回 真
        }
        返回 假
    }
    // ---- 队列<T> ----
    如果 (字符串比较(基名, "队列")) {
        如果 (字符串比较(方法名, "入队") && 实参数 == 1) {
            出->参数串 = T
            出->返回形态 = 容器返回_结果空
            返回 真
        }
        如果 (字符串比较(方法名, "出队") && 实参数 == 0) {
            出->参数串 = ""
            出->返回形态 = 容器返回_结果值
            出->值偏移 = 结果值偏移(T)
            返回 真
        }
        如果 (字符串比较(方法名, "队首") && 实参数 == 0) {
            出->参数串 = ""
            出->返回形态 = 容器返回_结果值
            出->值偏移 = 结果值偏移(T)
            返回 真
        }
        如果 (字符串比较(方法名, "大小") && 实参数 == 0) {
            出->参数串 = ""
            出->返回形态 = 容器返回_标量
            返回 真
        }
        如果 (字符串比较(方法名, "为空") && 实参数 == 0) {
            出->参数串 = ""
            出->返回形态 = 容器返回_标量
            返回 真
        }
        如果 (字符串比较(方法名, "清空") && 实参数 == 0) {
            出->参数串 = ""
            出->返回形态 = 容器返回_空类型
            返回 真
        }
        返回 假
    }
    // ---- 集合<T> ----
    如果 (字符串比较(基名, "集合")) {
        如果 (字符串比较(方法名, "添加") && 实参数 == 1) {
            出->参数串 = T
            出->返回形态 = 容器返回_结果空
            返回 真
        }
        如果 (字符串比较(方法名, "包含") && 实参数 == 1) {
            出->参数串 = T
            出->返回形态 = 容器返回_标量
            返回 真
        }
        如果 (字符串比较(方法名, "删除") && 实参数 == 1) {
            出->参数串 = T
            出->返回形态 = 容器返回_标量
            返回 真
        }
        如果 (字符串比较(方法名, "大小") && 实参数 == 0) {
            出->参数串 = ""
            出->返回形态 = 容器返回_标量
            返回 真
        }
        如果 (字符串比较(方法名, "为空") && 实参数 == 0) {
            出->参数串 = ""
            出->返回形态 = 容器返回_标量
            返回 真
        }
        如果 (字符串比较(方法名, "清空") && 实参数 == 0) {
            出->参数串 = ""
            出->返回形态 = 容器返回_空类型
            返回 真
        }
        返回 假
    }
    返回 假
}


// 发射调用实参装载（参数区模式，用户裁决项3）：弹出们 为倒序（元素0=最后实参），
//   实参 j（0 起，第 j+1 个）位号=起始位+j，寄存器=弹出们[个数-1-j]。
//   IR_调用实参 为声明性指令（代码生成在 IR_调用参数化 统一展开装载）。
函数 发射调用实参们(向量<整64> 弹出们, 整64 起始位, 向量<IR指令>& 指令) -> 空类型 {
    整64 n = 弹出们.大小()
    整64 j = 0
    当 (j < n) {
        IR追加(指令, 建IR指令(IR_调用实参, 弹出们.元素(n - 1 - j), 0, 0, 0, 起始位 + j, 0))
        j++
    }
}

// ==================== 容器声明预扫与 RAII（P7b） ====================
// 块级作用域出口析构（用户裁决项2，生成块 调用）：对 容器变量们 在 基线 之后
//   新增的容器（本块声明的，逆序）发 RAII 析构并截断列表——块结束即释放。
函数 块出口析构(函数IR& 函数信息, 映射<整64, 整64>& 局部槽, 整64* 寄存器计数,
                整64 作用域基线) -> 空类型 {
    当 (函数信息.容器变量们.大小() > 作用域基线) {
        整64 最后 = 函数信息.容器变量们.大小() - 1
        整64 名ID = 函数信息.容器变量们.元素(最后)
        整64 槽 = 0
        结果<整64, 整32> 找槽 = 局部槽.获取(名ID)
        如果 (找槽.正常) { 槽 = 找槽.值 }
        如果 (槽 != 0) {
            结果<整64, 整32> 查类型 = 函数信息.变量类型.获取(名ID)
            如果 (查类型.正常) {
                整64 ptr寄存器 = 寄存器计数[0]
                寄存器计数[0] = 寄存器计数[0] + 1
                IR追加(函数信息.指令, 建IR指令(IR_加载, 槽, 0, 0, ptr寄存器, T_对象, 0))
                IR追加(函数信息.指令, 建IR指令(IR_删除对象, ptr寄存器, 0, 0,
                                                     寄存器计数[0], 0, 查类型.值))
                寄存器计数[0] = 寄存器计数[0] + 1
            }
        }
        结果<空类型, 整32> 删容 = 函数信息.容器变量们.删除(最后)
        如果 (!删容.正常) { 运行时错误(4) }
    }
}

// 预扫容器声明：函数体块区间一次线性扫描（嵌套块/条件体语句节点均含于函数体块
//   子区间——节点池顺序追加，体块节点最后入池），为全部容器变量：分配槽 +
//   入口零初始化（未执行声明路径的槽=确定性空指针，DeleteObject 空安全跳过）+
//   登记 变量类型/容器变量们。注：同名变量（不同块）合并同槽（v2 局部槽为
//   函数级映射——精确块级作用域析构留 P7c）。
函数 预扫容器声明(向量<节点> 池, 整32 块节点, 函数IR& 函数信息,
                  整64* 槽计数, 整64* 寄存器计数) -> 空类型 {
    整64 零寄存器 = 0
    节点 块 = 池.元素(块节点)
    整64 i = 整64(块.子起点)
    当 (i < 整64(块.子终点)) {
        节点 声明 = 池.元素(整32(i))
        如果 (声明.类型 == 节点_变量声明) {
            节点 类型节点 = 池.元素(整32(声明.附加))
            字符串 类型文本 = 驻留文本(整64(类型节点.文本))
            如果 (是容器类(类型文本)) {
                结果<整64, 整32> 已有 = 函数信息.局部槽.获取(整64(声明.文本))
                如果 (!已有.正常) {
                    整64 槽 = 槽计数[0]
                    槽计数[0] = 槽计数[0] + 1
                    结果<空类型, 整32> 设槽 = 函数信息.局部槽.设置(整64(声明.文本), 槽)
                    如果 (!设槽.正常) { 运行时错误(4) }
                    IR追加(函数信息.指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽))
                    // 入口零初始化（共享一个零寄存器）
                    如果 (零寄存器 == 0) {
                        零寄存器 = 寄存器计数[0]
                        寄存器计数[0] = 寄存器计数[0] + 1
                        IR追加(函数信息.指令, 建IR指令(IR_常量整数, 驻留("0"), 0, 0,
                                             零寄存器, T_整64, 0))
                    }
                    IR追加(函数信息.指令, 建IR指令(IR_存储, 零寄存器, 0, 0, 0, 0, 槽))
                    结果<空类型, 整32> 设类型 = 函数信息.变量类型.设置(整64(声明.文本),
                                                              整64(类型节点.文本))
                    如果 (!设类型.正常) { 运行时错误(4) }
                    结果<空类型, 整32> 加容器 = 函数信息.容器变量们.追加(整64(声明.文本))
                    如果 (!加容器.正常) { 运行时错误(4) }
                }
            }
        }
        i++
    }
}

// 发射容器析构（RAII）：对本函数全部容器局部 Load 槽 + IR_删除对象。
//   代码生成展开：test/je 空安全 + call ~类(this) + call __cn_object_delete(this)。
函数 发射容器析构(函数IR& 函数信息, 向量<IR指令>& 指令, 整64* 寄存器计数,
                  映射<整64, 整64>& 局部槽) -> 空类型 {
    整64 i = 0
    当 (i < 函数信息.容器变量们.大小()) {
        整64 名ID = 函数信息.容器变量们.元素(i)
        整64 槽 = 0
        结果<整64, 整32> 找槽 = 局部槽.获取(名ID)
        如果 (找槽.正常) { 槽 = 找槽.值 }
        如果 (槽 != 0) {
            结果<整64, 整32> 查类型 = 函数信息.变量类型.获取(名ID)
            如果 (查类型.正常) {
                整64 ptr寄存器 = 寄存器计数[0]
                寄存器计数[0] = 寄存器计数[0] + 1
                // 目标=标签唯一序号（代码生成 objdel_函数序号_目标 拼标签——
                //   多容器变量同函数多条删除指令，序号须唯一否则 MASM A2005）
                IR追加(指令, 建IR指令(IR_加载, 槽, 0, 0, ptr寄存器, T_对象, 0))
                IR追加(指令, 建IR指令(IR_删除对象, ptr寄存器, 0, 0, 寄存器计数[0], 0, 查类型.值))
                寄存器计数[0] = 寄存器计数[0] + 1
            }
        }
        i++
    }
}

// ==================== 指令追加辅助 ====================
// 引用传递：按值传 向量 会共享数据指针，.追加 扩容释放旧数组 -> 调用方向量悬垂。
函数 IR追加(向量<IR指令>& 列表, IR指令 指令) -> 空类型 {
    结果<空类型, 整32> 加 = 列表.追加(指令)
    如果 (!加.正常) { 运行时错误(4) }
}
函数 建IR指令(整64 操作码, 整64 操作数1, 整64 操作数2, 整64 操作数3,
              整64 目标, 整64 类型, 整64 附加) -> IR指令 {
    IR指令 指令
    指令.操作码 = 操作码
    指令.操作数1 = 操作数1
    指令.操作数2 = 操作数2
    指令.操作数3 = 操作数3
    指令.目标 = 目标
    指令.类型 = 类型
    指令.附加 = 附加
    返回 指令
}

// ==================== 类型名 -> IR 类型码 ====================
// 源码类型名（驻留文本）-> IR 类型码（T_*）。未知返回 T_未知。
函数 类型码(整64 类型名ID) -> 整64 {
    字符串 名 = 驻留文本(类型名ID)
    // CN 字符串 == 是指针比较（非内容）——须用 字符串比较
    如果 (字符串比较(名, "整32")) { 返回 T_整32 }
    如果 (字符串比较(名, "整64")) { 返回 T_整64 }
    如果 (字符串比较(名, "浮32")) { 返回 T_浮32 }
    如果 (字符串比较(名, "浮64")) { 返回 T_浮64 }
    如果 (字符串比较(名, "布尔")) { 返回 T_布尔 }
    如果 (字符串比较(名, "字符串")) { 返回 T_字符串 }
    如果 (字符串比较(名, "空类型")) { 返回 T_空类型 }
    如果 (字符串比较(名, "整8") || 字符串比较(名, "整16") ||
        字符串比较(名, "正8") || 字符串比较(名, "正16") ||
        字符串比较(名, "正32") || 字符串比较(名, "正64") ||
        字符串比较(名, "字符") || 字符串比较(名, "指针") ||
        字符串比较(名, "自动")) { 返回 T_整64 }
    返回 T_未知
}

// ==================== 顶层常量收集（P7a，2026-09-01） ====================
// 常量表：常量名ID -> 值文本ID（十进制文本）。代码生成 IR_常量整数 直接经
//   驻留文本(操作数1) 还原为立即数（负值为 "-N" 文本，mov rax, -N 合法），
//   故折叠全程零数值解析——正值复用字面量 Symbol ID，负值拼接后驻留一次。
//   收集在 IR生成/IR生成多文件 入口进行（先清空，幂等；多文件全部 程序 节点
//   依次收集，跨文件常量引用天然可见）。
静态 映射<整64, 整64> 常量表

// 折叠常量初始化区间 [起点, 终点)：整数字面量，或 [字面量, 负号]（负数）。
//   返回值文本ID；不可折叠（非字面量形态）返回 0。
函数 折叠常量值(向量<节点> 池, 整32 起点, 整32 终点) -> 整64 {
    如果 (终点 - 起点 == 1) {
        节点 值节点 = 池.元素(起点)
        如果 (值节点.类型 == 节点_整数字面量) {
            返回 整64(值节点.文本)
        }
    }
    如果 (终点 - 起点 == 2) {
        节点 值节点2 = 池.元素(起点)
        节点 负号节点 = 池.元素(起点 + 1)
        如果 (值节点2.类型 == 节点_整数字面量 && 负号节点.类型 == 节点_负号) {
            返回 驻留("-" + 驻留文本(整64(值节点2.文本)))
        }
    }
    返回 0
}

// 收集一个 程序 节点顶层区间的全部常量声明（登记进 常量表）。
//   非字面量初始化（如 常量 X = 1+2）：打印诊断且不登记——引用处将落入
//   函数名兜底路径（自举组件源码 84 处全部为整数字面量，不触发）。
函数 收集常量(向量<节点> 池, 整32 程序节点) -> 空类型 {
    节点 程序 = 池.元素(程序节点)
    整64 i = 整64(程序.子起点)
    当 (i < 整64(程序.子终点)) {
        节点 声明 = 池.元素(整32(i))
        如果 (声明.类型 == 节点_常量声明) {
            整64 值文本 = 折叠常量值(池, 声明.子起点, 声明.子终点)
            如果 (值文本 != 0) {
                结果<空类型, 整32> 设常 = 常量表.设置(整64(声明.文本), 值文本)
                如果 (!设常.正常) { 运行时错误(4) }
            } 否则 {
                IO::打印到错误("[ir2] 常量初始化须为整数字面量: " +
                              驻留文本(整64(声明.文本)) + "\n")
            }
        }
        i++
    }
}
