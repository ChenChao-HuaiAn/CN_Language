导入 容器::向量
导入 词法分析
导入 语法分析

函数 主() -> 整32 {
    字符串 源码 = "函数 加(整32 a, 整32 b) -> 整32 { 返回 a + b }"
    向量<Token> 记号 = 向量<Token>()
    分词(源码, 记号)
    向量<节点> 池 = 向量<节点>()
    整64 结束 = 解析程序(记号, 池)
    打印("解析结束=", 结束, " 节点池=", 池.大小())
    整64 i = 0
    当 (i < 池.大小()) {
        节点 n = 池.元素(i)
        字符串 文本 = 驻留文本(整64(n.文本))
        打印("节点", i, ": 类型=", n.类型, " 文本=", 文本, " 子=", n.子起点, "-", n.子终点)
        i++
    }
    返回 0
}