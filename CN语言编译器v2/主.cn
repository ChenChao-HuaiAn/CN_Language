导入 容器::向量
导入 词法分析
导入 语法分析
导入 语义分析

函数 主() -> 整32 {
    字符串 源码 = "函数 加(整32 a, 整32 b) -> 整32 { 返回 a + b }"
    向量<Token> 记号 = 向量<Token>()
    分词(源码, 记号)
    向量<节点> 池 = 向量<节点>()
    整64 忽略 = 解析程序(记号, 池)
    向量<字符串> 诊断 = 向量<字符串>()
    整64 err = 语义分析(池, 整32(池.大小() - 1), 诊断)
    打印("正确程序 错误数=", err)
    // 错误程序：使用未声明变量 x
    字符串 源码2 = "函数 坏() -> 整32 { 返回 x + 1 }"
    向量<Token> 记号2 = 向量<Token>()
    分词(源码2, 记号2)
    向量<节点> 池2 = 向量<节点>()
    整64 忽略2 = 解析程序(记号2, 池2)
    向量<字符串> 诊断2 = 向量<字符串>()
    整64 err2 = 语义分析(池2, 整32(池2.大小() - 1), 诊断2)
    打印("错误程序 错误数=", err2)
    整64 i = 0
    当 (i < 诊断2.大小()) {
        打印("诊断2[", i, "]: ", 诊断2.元素(i))
        i++
    }
    返回 0
}