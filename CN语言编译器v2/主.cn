导入 容器::向量
导入 词法分析
导入 语法分析

函数 主() -> 整32 {
    字符串 源码 = "a + b * 2"
    向量<Token> 记号 = 向量<Token>()
    分词(源码, 记号)
    Token 首个 = 记号.元素(0)
    打印("首个 token 类型=", 首个.类型, " 文本=", 驻留文本(整64(首个.文本)))
    整32 t = 当前类型(记号, 0)
    打印("当前类型(0)=", t)
    向量<节点> 池 = 向量<节点>()
    整64 结束 = 解析表达式(记号, 0, 池)
    打印("表达式结束位置=", 结束, " 节点池大小=", 池.大小())
    整64 i = 0
    当 (i < 池.大小()) {
        节点 n = 池.元素(i)
        字符串 文本 = 驻留文本(整64(n.文本))
        打印("节点", i, ": 类型=", n.类型, " 文本=", 文本)
        i++
    }
    返回 0
}