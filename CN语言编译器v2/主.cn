// CN 自举编译器 v2：编译器驱动器（自举重建 P1，2026-08-25）
// 职责：真实编译器驱动器——读取 入口文件（命令行参数 1，默认 target/v2src.cn）
//   并自动加载其 导入 模块文件（多源文件支持 P6h，2026-08-31）：
//     文件 -> 源码 -> 分词 -> 扫描导入 -> 递归加载依赖（依赖先解析，结构体
//     偏移推导顺序正确）-> 解析（共享节点池/字段偏移表）-> 语义（多文件全局
//     符号表）-> IR（多文件合并）-> 代码生成 -> target/v2asm.asm
//   链接环境（P6h）：代码生成 将 主 -> cn_main（宿主运行时 entry 经
//     __cn_cache_argv 后调用）；v2asm 用宿主链接命令（/ENTRY:WinMainCRTStartup
//     + 运行时 obj）链接运行由 E2E 119 验证。
导入 容器::向量;
导入 文件::打开文件;
导入 文件::读取文件行;
导入 文件::写入文件;
导入 文件::关闭文件;
导入 词法分析;
导入 语法分析;
导入 语义分析;
导入 IR生成;
导入 IR容器;
导入 IR签名;
导入 代码生成;
导入 代码生成ARM64;

// 冒烟打印函数 IR 指令（操作码/操作数/结果）
函数 打印函数IR(函数IR 函数信息) -> 空类型 {
    IO::打印到错误("[ir1] 函数: " + 驻留文本(整64(函数信息.名字)) +
                   " 返回类型码=" + 整数转字符串(函数信息.返回类型) + "\n");
    整64 i = 0;
    当 (i < 函数信息.指令.大小()) {
        IR指令 指令 = 函数信息.指令.元素(i);
        IO::打印到错误("[ir1]  op=" + 整数转字符串(指令.操作码) +
                       " o1=" + 整数转字符串(指令.操作数1) +
                       " o2=" + 整数转字符串(指令.操作数2) +
                       " o3=" + 整数转字符串(指令.操作数3) +
                       " 目标=" + 整数转字符串(指令.目标) +
                       " 类型=" + 整数转字符串(指令.类型) +
                       " 附加=" + 整数转字符串(指令.附加) + "\n");
        i++;
    }
}

// ==================== 多文件驱动辅助（P6h，2026-08-31） ====================
// 标准库模块名（宿主提供编译产物，不加载 .cn 文件）
函数 是标准库模块(字符串 名) -> 布尔 {
    返回 字符串比较(名, "容器") || 字符串比较(名, "映射集合") ||
          字符串比较(名, "文件") || 字符串比较(名, "IO") ||
          字符串比较(名, "字符串扩展") || 字符串比较(名, "核心") ||
          字符串比较(名, "数学") || 字符串比较(名, "时间") ||
          字符串比较(名, "算法") || 字符串比较(名, "系统");
}

// 读源文件全文（打开模式 1=读 + 读取文件行 拼接）；失败返回 空串
函数 读源文件(字符串 路径) -> 字符串 {
    字符串 内容 = "";
    结果<空类型*, 整32> 打开 = 打开文件(路径, 1);
    如果 (打开.正常) {
        当 (真) {
            结果<字符串, 整32> 行 = 文件::读取文件行(打开.值);
            如果 (行.正常) {
                内容 = 内容 + 行.值 + "\n";
            } 否则 {
                中断;  // EOF/错误
            }
        }
        关闭文件(打开.值);
    }
    返回 内容;
}

// 取路径的目录部分（最后一个 / 或 \ 之前；无分隔符返回 空串）
函数 路径目录(字符串 路径) -> 字符串 {
    整64 长 = 字符串长度(路径);
    整64 最后斜杠 = -1;
    整64 i = 0;
    当 (i < 长) {
        整64 字节 = 整64(路径[i]);
        如果 (字节 < 0) { 字节 = 字节 + 256; }
        如果 (字节 == 47 || 字节 == 92) { 最后斜杠 = i; }  // '/' '\'
        i++;
    }
    如果 (最后斜杠 < 0) { 返回 ""; }
    返回 字符串子串(路径, 0, 最后斜杠);
}

// 递归编译一个源文件（依赖先解析）：
//   读文件 -> 分词 -> 扫描导入 -> 递归加载依赖模块（标准库跳过；已加载去重防循环）
//   -> 解析（追加进共享节点池）-> 记录本文件 程序 节点索引。
// 返回 1=成功；0=打开失败（调用方回退内置回归源码冒烟）。
函数 编译文件(字符串 路径, 字符串 目录, 向量<节点> 池, 映射<整64, 整64> 字段偏移表,
              映射<整64, 整64>& 已加载, 向量<整32> 程序节点们) -> 整64 {
    // 已加载表：键=文件路径驻留 ID（防循环导入/重复加载）
    整64 路径ID = 驻留(路径);
    结果<整64, 整32> 查已加载 = 已加载.获取(路径ID);
    如果 (查已加载.正常) { 返回 1; }
    结果<空类型, 整32> 加载标记 = 已加载.设置(路径ID, 1);
    如果 (!加载标记.正常) { 运行时错误(4); }
    // 读文件
    字符串 源码 = 读源文件(路径);
    如果 (字符串长度(源码) == 0) {
        IO::打印到错误("[p6h] 打开失败: " + 路径 + "\n");
        返回 0;
    }
    // 分词 -> 扫描导入 -> 递归加载依赖（依赖先解析）
    向量<Token> 记号 = 向量<Token>();
    分词(源码, 记号);
    扫描导入(记号);
    向量<整32> 模块们 = 取走导入模块们();
    整64 m = 0;
    当 (m < 模块们.大小()) {
        字符串 模块名 = 驻留文本(整64(模块们.元素(m)));
        如果 (!是标准库模块(模块名)) {
            整64 忽略 = 编译文件(目录 + "/" + 模块名 + ".cn", 目录, 池,
                                 字段偏移表, 已加载, 程序节点们);
        }
        m++;
    }
    // 解析本文件（共享池/字段偏移表；程序 节点最后入池 = 池尾）
    整64 忽略2 = 解析程序(记号, 池, 字段偏移表);
    结果<空类型, 整32> 加节点 = 程序节点们.追加(整32(池.大小() - 1));
    如果 (!加节点.正常) { 运行时错误(4); }
    IO::打印到错误("[p6h] 已解析: " + 路径 + " 节点=" +
                  整数转字符串(池.大小() - 1) + "\n");
    返回 1;
}

// 写 asm 行列表到文件（双后端共用；[cg1] 诊断对齐既有格式）
函数 写asm文件(向量<字符串>& asm行, 字符串 路径) -> 空类型 {
    IO::打印到错误("[cg1] asm 行数=" + 整数转字符串(asm行.大小()) + "\n");
    结果<空类型*, 整32> 写文件句柄 = 打开文件(路径, 2);
    如果 (写文件句柄.正常) {
        整64 a = 0;
        当 (a < asm行.大小()) {
            结果<整64, 整32> 写 = 写入文件(写文件句柄.值, asm行.元素(a) + "\n");
            a++;
        }
        关闭文件(写文件句柄.值);
        IO::打印到错误("[cg1] asm 已写 " + 路径 + "\n");
    } 否则 {
        IO::打印到错误("[cg1] asm 写文件失败\n");
    }
}

函数 主() -> 整32 {
    // 纯映射自检（放最前）：排除 解析/语义 破坏
    映射<整64, 整64> 自检表 = 映射<整64, 整64>();
    结果<空类型, 整32> 自检设 = 自检表.设置(1, 100);
    IO::打印到错误("[ir1] 自检设置: " + 整数转字符串(自检表.大小()) + "\n");
    结果<整64, 整32> 自检取 = 自检表.获取(1);
    IO::打印到错误("[ir1] 自检获取后\n");
    如果 (自检取.正常) {
        IO::打印到错误("[ir1] 自检获取: " + 整数转字符串(自检取.值) + "\n");
    }
    // P6h（2026-08-31）：多源文件驱动——入口文件 = 命令行参数 1
    //   （如 v2p target/v2src119/主.cn），默认 target/v2src.cn（单文件回归冒烟）
    字符串 入口路径 = "target/v2src.cn";
    如果 (系统::参数个数() >= 2) {
        字符串 参数值 = 系统::参数(1);
        如果 (参数值 != 无) {
            入口路径 = 参数值;
        }
    }
    // 阶段A（2026-09-02）：目标平台 = 命令行参数 2（默认 win-x64——既有行为不变；
    //   linux-arm64 分派 GAS 后端，输出 target/v2asm.s）
    字符串 目标平台 = "win-x64";
    如果 (系统::参数个数() >= 3) {
        字符串 目标值 = 系统::参数(2);
        如果 (目标值 != 无) {
            目标平台 = 目标值;
        }
    }
    布尔 用ARM64 = 字符串比较(目标平台, "linux-arm64");
    IO::打印到错误("[p6h] 入口: " + 入口路径 + "\n");
    IO::打印到错误("[cga] 目标平台: " + 目标平台 + "\n");
    字符串 目录 = 路径目录(入口路径);
    向量<节点> 池 = 向量<节点>();
    映射<整64, 整64> 字段偏移表 = 映射<整64, 整64>();
    映射<整64, 整64> 已加载表 = 映射<整64, 整64>();
    向量<整32> 程序节点们 = 向量<整32>();
    清空变量结构体表();  // 本任务全部文件共享 变量结构体表（跨文件字段偏移推导）
    清空变量容器表();    // P7b：容器/结果 变量类型表同样任务级生命周期
    清空结构体布局表();  // ②b B1：结构体大小/对齐/字段类型表任务级生命周期
    整64 编译结果 = 编译文件(入口路径, 目录, 池, 字段偏移表, 已加载表, 程序节点们);
    如果 (编译结果 == 0) {
        // 入口打不开：回退 内置回归源码（指针/字段访问冒烟，单文件）
        IO::打印到错误("[p6f] 打开失败，用内置回归源码\n");
        字符串 源码 = "结构体 点 { 整64 x; 整64 y; }" +
              " 函数 主() -> 整32 { 点 位置; 位置.x = 7; 位置.y = 9; 整64* 指针 = &位置.x; *指针 = 10; 返回 位置.x + 位置.y; }";
        向量<Token> 记号 = 向量<Token>();
        分词(源码, 记号);
        整64 忽略回退 = 解析程序(记号, 池, 字段偏移表);
        结果<空类型, 整32> 加回退 = 程序节点们.追加(整32(池.大小() - 1));
        如果 (!加回退.正常) { 运行时错误(4); }
    }
    // 语义（多文件：全部文件 声明收集 -> 逐文件检查）
    // plans/015 方案B（2026-09-04 用户裁决）：语法错误即中止——缺分号等语法层
    //   错误（语法错误数，语法分析.cn 统计）不再无条件继续语义/IR/代码生成
    //   （对齐宿主 diagnostics.hasErrors 构建失败纪律与语义错误即中止同族）
    如果 (语法错误数 > 0) {
        IO::打印到错误("[parse] 语法错误 " + 整数转字符串(语法错误数) +
                      " 个，中止编译（不产 IR/asm）\n");
        返回 1;
    }

    向量<字符串> 诊断 = 向量<字符串>();
    整64 err = 语义分析多文件(池, 程序节点们, 诊断);
    IO::打印到错误("[sem5] 正确程序 错误数=" + 整数转字符串(err) + "\n");
    整64 诊断i = 0;
    当 (诊断i < 诊断.大小()) {
        IO::打印到错误("[sem5] 正确诊断: " + 诊断.元素(诊断i) + "\n");
        诊断i++;
    }
    // 灰色点⑤根治（2026-09-04 用户裁决立案·缺陷零容忍）：语义错误即中止——
    //   原无条件继续 IR 生成/代码生成（错误程序仍产 asm 可被链接=错误产物，
    //   对齐宿主 driver 纪律：语义错误构建失败、不产任何产物）。err>0 打印
    //   诊断后返回 1（不产 IR/asm；尾部组件自检仅在入口干净时运行——既有
    //   E2E 用例 err=0 输出流不变）
    如果 (err > 0) {
        IO::打印到错误("[sem5] 语义错误 " + 整数转字符串(err) +
                       " 个，中止 IR 生成与代码生成（退出码 1）\n");
        返回 1;
    }
    // IR 生成（多文件：全部 程序 节点合并）
    程序IR 程序 = IR生成多文件(池, 程序节点们);
    IO::打印到错误("[ir1] IR生成调用后 函数数=" + 整数转字符串(程序.函数们.大小()) + "\n");
    整64 f = 0;
    当 (f < 程序.函数们.大小()) {
        打印函数IR(程序.函数们.元素(f));
        f++;
    }
    // P6 代码生成：程序IR -> asm 行 -> 写文件（阶段A：按目标平台分派双后端）
    如果 (用ARM64) {
        向量<字符串> asm行a = 代码生成ARM64(程序);
        写asm文件(asm行a, "target/v2asm.s");
    } 否则 {
        向量<字符串> asm行w = 代码生成(程序);
        写asm文件(asm行w, "target/v2asm.asm");
    }
    // 错误程序：未声明 x
    字符串 源码2 = "函数 坏() -> 整32 { 返回 x + 1 }";
    向量<Token> 记号2 = 向量<Token>();
    分词(源码2, 记号2);
    向量<节点> 池2 = 向量<节点>();
    映射<整64, 整64> 字段偏移表2 = 映射<整64, 整64>();
    整64 忽略2 = 解析程序(记号2, 池2, 字段偏移表2);
    向量<字符串> 诊断2 = 向量<字符串>();
    整64 err2 = 语义分析(池2, 整32(池2.大小() - 1), 诊断2);
    IO::打印到错误("[sem5] 错误程序 错误数=" + 整数转字符串(err2) + "\n");
    整64 i = 0;
    当 (i < 诊断2.大小()) {
        IO::打印到错误("[sem5] 诊断: " + 诊断2.元素(i) + "\n");
        i++;
    }
    // ③ 第二波（用户裁决 2026-09-03）：复合赋值非数值负测自检——字符串参数 +=
    //   须被语义层拒绝（宿主判定对齐：整系/浮点系通过，字符串/布尔/字符拒绝）
    字符串 源码3 = "函数 坏2(字符串 名) -> 整32 { 名 += 名 返回 0 }";
    向量<Token> 记号3 = 向量<Token>();
    分词(源码3, 记号3);
    向量<节点> 池3 = 向量<节点>();
    映射<整64, 整64> 字段偏移表3 = 映射<整64, 整64>();
    整64 忽略3 = 解析程序(记号3, 池3, 字段偏移表3);
    向量<字符串> 诊断3 = 向量<字符串>();
    整64 err3 = 语义分析(池3, 整32(池3.大小() - 1), 诊断3);
    如果 (err3 >= 1) {
        IO::打印到错误("[sem5] 复合赋值负测通过 错误数=" + 整数转字符串(err3) + "\n");
    } 否则 {
        IO::打印到错误("[sem5] 复合赋值负测失败（字符串 += 未被拒绝）\n");
    }
    // ③ 第三波（2026-09-03）：指针下标两负测自检——① 整64 变量下标（白名单外
    //   对象）须拒绝；② 字符串下标写左值（只读）须拒绝（每次编译自证拒绝能力）
    字符串 源码4 = "函数 坏3(整64 数) -> 整32 { 返回 数[0] }";
    向量<Token> 记号4 = 向量<Token>();
    分词(源码4, 记号4);
    向量<节点> 池4 = 向量<节点>();
    映射<整64, 整64> 字段偏移表4 = 映射<整64, 整64>();
    整64 忽略4 = 解析程序(记号4, 池4, 字段偏移表4);
    向量<字符串> 诊断4 = 向量<字符串>();
    整64 err4 = 语义分析(池4, 整32(池4.大小() - 1), 诊断4);
    如果 (err4 >= 1) {
        IO::打印到错误("[sem5] 指针下标负测通过 错误数=" + 整数转字符串(err4) + "\n");
    } 否则 {
        IO::打印到错误("[sem5] 指针下标负测失败（整64 下标未被拒绝）\n");
    }
    字符串 源码5 = "函数 坏4(字符串 s) -> 整32 { s[0] = 65 返回 0 }";
    向量<Token> 记号5 = 向量<Token>();
    分词(源码5, 记号5);
    向量<节点> 池5 = 向量<节点>();
    映射<整64, 整64> 字段偏移表5 = 映射<整64, 整64>();
    整64 忽略5 = 解析程序(记号5, 池5, 字段偏移表5);
    向量<字符串> 诊断5 = 向量<字符串>();
    整64 err5 = 语义分析(池5, 整32(池5.大小() - 1), 诊断5);
    如果 (err5 >= 1) {
        IO::打印到错误("[sem5] 字符串下标写负测通过 错误数=" + 整数转字符串(err5) + "\n");
    } 否则 {
        IO::打印到错误("[sem5] 字符串下标写负测失败（字符串下标写未被拒绝）\n");
    }
    // 缺陷②（2026-09-03 用户裁决立案）：非左值/常量赋值两负测自检——每次编译
    //   自证拒绝能力（宿主 visitAssignmentExpr 白名单对齐：Rust E0070 同款；
    //   132 用例 主.expected 固化这两行）
    字符串 源码6 = "函数 坏5(整64 a) -> 整32 { a + 1 = 7 返回 0 }";
    向量<Token> 记号6 = 向量<Token>();
    分词(源码6, 记号6);
    向量<节点> 池6 = 向量<节点>();
    映射<整64, 整64> 字段偏移表6 = 映射<整64, 整64>();
    整64 忽略6 = 解析程序(记号6, 池6, 字段偏移表6);
    向量<字符串> 诊断6 = 向量<字符串>();
