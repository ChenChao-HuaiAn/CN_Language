// CN 自举编译器 v2：编译器驱动器（自举重建 P1，2026-08-25）
// 职责：真实编译器驱动器——读取 入口文件（命令行参数 1，默认 target/v2src.cn）
//   并自动加载其 导入 模块文件（多源文件支持 P6h，2026-08-31）：
//     文件 -> 源码 -> 分词 -> 扫描导入 -> 递归加载依赖（依赖先解析，结构体
//     偏移推导顺序正确）-> 解析（共享节点池/字段偏移表）-> 语义（多文件全局
//     符号表）-> IR（多文件合并）-> 代码生成 -> target/v2asm.asm
//   链接环境（P6h）：代码生成 将 主 -> cn_main（宿主运行时 entry 经
//     __cn_cache_argv 后调用）；v2asm 用宿主链接命令（/ENTRY:WinMainCRTStartup
//     + 运行时 obj）链接运行由 E2E 119 验证。
导入 容器::向量;
导入 文件::打开文件;
导入 文件::读取文件行;
导入 文件::写入文件;
导入 文件::关闭文件;
// 阶段目录包形态（2026-09-08 千行拆分轮，用户裁决）：组件按编译阶段入目录
//   （词法/语法/语义/IR/代码生成/货舱解析——宿主 src/cn_compiler 顶层组织对齐），
//   导入一律用目录包名；包.cn 库包根聚合声明子模块（模块路径=原组件名逐字节
//   不变——键基/mangling 零变化）
导入 词法;
导入 IR;         // 语法/语义 依赖 IR 的布局/判定——IR 先于语法加载（依赖先解析）
导入 语法;
导入 语义;
导入 代码生成;
导入 货舱解析;

// 冒烟打印函数 IR 指令（操作码/操作数/结果）
// 呈报③方案A 后 函数IR.名字=签名键（名#参数串，asm 符号消歧用）；自检行打
//   源码声明名（人类可读归真，2026-09-06 用户裁决方案A）——剥首个 # 后缀
//   （签名键格式=名#参数串，CN 标识符无 #，剥离安全）
函数 自检显示名(整64 名ID) -> 字符串 {
    字符串 名 = 字符串复制(驻留文本(名ID));
    整64 i = 0;
    当 (i < 字符串长度(名)) {
        如果 (字符串比较(字符串子串(名, 整32(i), 1), "#")) {
            返回 字符串子串(名, 0, 整32(i));
        }
        i++;
    }
    返回 名;
}

函数 打印函数IR(函数IR 函数信息) -> 空类型 {
    IO::打印到错误("[ir1] 函数: " + 自检显示名(整64(函数信息.名字)) +
                   " 返回类型码=" + 整数转字符串(函数信息.返回类型) + "\n");
    整64 i = 0;
    当 (i < 函数信息.指令.大小()) {
        IR指令 指令 = 函数信息.指令.元素(i);
        IO::打印到错误("[ir1]  op=" + 整数转字符串(指令.操作码) +
                       " o1=" + 整数转字符串(指令.操作数1) +
                       " o2=" + 整数转字符串(指令.操作数2) +
                       " o3=" + 整数转字符串(指令.操作数3) +
                       " 目标=" + 整数转字符串(指令.目标) +
                       " 类型=" + 整数转字符串(指令.类型) +
                       " 附加=" + 整数转字符串(指令.附加) + "\n");
        i++;
    }
}

// ==================== 多文件驱动辅助（P6h，2026-08-31） ====================
