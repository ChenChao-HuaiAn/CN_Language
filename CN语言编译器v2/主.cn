//   48+字段偏移 72+装箱语境 12·plans/025 §2.70〕=421-a 攻坚面；枚举/泛型
//   函数/函数单态化前置已齐）。
函数 是标准库模块(字符串 名) -> 布尔 {
    // TEMP 618-A/B 实验（禁止提交·收工还原）
    返回 假;
}

// 读源文件全文（打开模式 1=读 + 读取文件行 拼接）；失败返回 空串
函数 读源文件(字符串 路径) -> 字符串 {
    字符串 内容 = "";
    结果<空类型*, 整32> 打开 = 打开文件(路径, 1);
    如果 (打开.正常) {
        当 (真) {
            结果<字符串, 整32> 行 = 文件::读取文件行(打开.值);
            如果 (行.正常) {
                // 缺陷③根治（2026-09-04 用户裁决 C1）：读取文件行 契约=含换行（fgets 语义）——
                //   原拼接再补换行致每行双换行、词法行号翻倍（146 用例 行=2n+1 实证）；
                //   行尾已有换行直接拼接，无（文件末行）才补
                整64 行长 = 字符串长度(行.值);
                如果 (行长 > 0 && 字节值(行.值, 行长 - 1) == 10) {
                    内容 = 内容 + 行.值;
                } 否则 {
                    内容 = 内容 + 行.值 + "\n";
                }
            } 否则 {
                中断;  // EOF/错误
            }
        }
        关闭文件(打开.值);
    }
    返回 内容;
}

// 路径分隔符归一（2026-09-09 用户裁决，Rust std::path 分隔符等价同构，lessons
//   权重6「路径身份判定必须归一分隔符」）：win 反斜杠 argv 形态与 v2 内部构造的
//   正斜杠路径文本失配=包上下文恢复失配/已加载去重失效双载歧义 183 错（第四十一
//   轮挂账③）。入口单点归一 '\'->'/'，下游全部字符串路径身份自然一致（v2 内部
//   构造路径已统一 '/'）。快路径无反斜杠原样返回（linux 常态零分配零拷贝）。
函数 归一路径分隔符(字符串 路径) -> 字符串 {
    整64 长 = 字符串长度(路径);
    整64 i = 0;
    当 (i < 长) {
        如果 ((整64(路径[i]) & 255) == 92) { 中断; }   // '\\'
        i++;
    }
    如果 (i >= 长) { 返回 字符串复制(路径); }
    字符串 归一文 = 字符串子串(路径, 0, i);
    当 (i < 长) {
        如果 ((整64(路径[i]) & 255) == 92) {
            归一文 = 归一文 + "/";
        } 否则 {
            归一文 = 归一文 + 字符串子串(路径, i, 1);
        }
        i++;
    }
    返回 归一文;
}

// 取路径的目录部分（最后一个 / 或 \ 之前；无分隔符返回 空串）
函数 路径目录(字符串 路径) -> 字符串 {
    整64 长 = 字符串长度(路径);
    整64 最后斜杠 = -1;
    整64 i = 0;
    当 (i < 长) {
        整64 字节 = 整64(路径[i]) & 255;
        如果 (字节 == 47 || 字节 == 92) { 最后斜杠 = i; }  // '/' '\'
        i++;
    }
    如果 (最后斜杠 < 0) { 返回 ""; }
    返回 字符串子串(路径, 0, 最后斜杠);
}

// 取文件主干名（最后 '/' 后、最后 '.' 前；无 '.' 取到尾）——父挂子加载路径用
函数 取文件主干(字符串 路径) -> 字符串 {
    整64 起点 = 0;
    整64 i = 整64(字符串长度(路径) - 1);
    当 (i >= 0) {
        整64 字节 = 整64(路径[i]) & 255;
        如果 (字节 == 47 || 字节 == 92) { 起点 = i + 1; i = -1; }  // 命中分隔符后停
        i--;
    }
    字符串 文件名 = 字符串子串(路径, 起点, 字符串长度(路径) - 起点);
    整64 点位 = -1;
    整64 j = 整64(字符串长度(文件名) - 1);
    当 (j >= 0) {
        整64 字节2 = 整64(文件名[j]) & 255;
        如果 (字节2 == 46) { 点位 = j; j = -1; }  // '.'=46
        j--;
    }
    如果 (点位 > 0) { 返回 字符串子串(文件名, 0, 点位); }
    返回 文件名;
}

// 递归编译一个源文件（依赖先解析）：
//   读文件 -> 分词 -> 扫描导入 -> 递归加载依赖模块（标准库跳过；已加载去重防循环）
//   -> 加载 模块 声明挂载（plans/018 P6b：包根同级聚合/父挂子，自动加载强语义）
//   -> 解析（追加进共享节点池）-> 记录本文件 程序 节点索引。
// 是包根：入口文件/库包根（包.cn）=1（模块 声明挂载按同级聚合解析）；
//   普通依赖文件=0（挂载按父挂子 <本文件主干>/X.cn 解析——定位收紧，规格08-二）。
// 货舱：货舱.toml 解析结果（依赖查找链用；未发现货舱时 依赖们 为空）。
// 返回 1=成功；0=打开失败（调用方回退内置回归源码冒烟）。
// plans/018 P6b 第 3 层（2026-09-07）：本模块路径 参数——模块树归属链：
//   入口="主"；同目录依赖/货舱依赖=名；库包根 包.cn="包"；挂载成员=父路径
//   同级聚合（主/包）或 父路径::名（父挂子）——与宿主 driver_module 模块名
//   规则对齐（相对入口目录路径主干/外部模块主干名）。每文件解析后收集
//   模块路径+导入项平铺+公开平铺 快照（组件级静态，与 程序节点们
//   平行——依赖先解析序=语义/IR 消费序）。
//   平铺形态纪律：嵌套容器（向量<向量>/向量<映射>）静态与临时值追加构造非
//   成熟路径（lessons 15 枚同族=句柄悬垂）——跨组件快照传输一律标量平铺，
//   边界向量 [f]=文件 f 起始偏移（段=[边界[f], 边界[f+1] 或 总表尾)）。
静态 向量<字符串> 模块路径们;
静态 向量<整64> 导入项平铺总表;
静态 向量<整64> 导入项边界们;
静态 向量<整64> 公开平铺总表;

// 340-f：路径规范化（双斜杠折叠）——递归候选拼接可产生 `x//y` 形态，
//   同一物理文件多键=已加载 去重/循环判定失准（自举树 24 误伤实证）。
函数 折叠双斜杠(字符串 路径) -> 字符串 {
    字符串 出 = "";
    整64 i = 0;
    整64 长 = 字符串长度(路径);
    整64 前斜杠 = 0;
    当 (i < 长) {
        字符串 c = 字符串子串(路径, i, 1);
        如果 (字符串比较(c, "/")) {
            如果 (前斜杠 == 0) { 出 = 出 + c; }
            前斜杠 = 1;
        } 否则 {
            出 = 出 + c;
            前斜杠 = 0;
        }
        i++;
    }
    返回 出;
}

函数 编译文件(字符串 路径, 字符串 目录, 向量<节点> 池, 映射<整64, 整64> 字段偏移表,
              映射<整64, 整64>& 已加载, 向量<整32> 程序节点们, 整64 是包根,
              向量<货舱依赖>& 货舱, 字符串 本模块路径) -> 整64 {
    // 340-a（D38 批3b·325）：已加载 值编码=1 完成 / 2 加载中——原实现递归前
    //   即置 1（完成），循环依赖（甲→乙→甲）命中去重静默返回=该拒不拒。
    //   现区分：值 2=在途再入=循环依赖诊断（宿主「模块循环依赖」对齐）；
    //   值 1=已完成=正常去重。流程尾（含失败路径）置 1 出栈。
    // 340-f：入口路径规范化（双斜杠折叠——同物理文件同键）
    路径 = 折叠双斜杠(路径);
    整64 路径ID = 驻留(路径);
    结果<整64, 整32> 查已加载 = 已加载.获取(路径ID);
    如果 (查已加载.正常) {
        如果 (查已加载.值 == 2) {
            // 340-g：目录包聚合回引判定——目标目录存在 名/包.cn（目录包形态）
            //   时在途再入=聚合回引（v2 树包模式惯例·宿主绿）静默放行；
            //   无包.cn 的平铺互引=真循环拒（325·宿主「模块循环依赖」）。
            整64 尾斜杠 = 0 - 1;
            整64 扫i = 字符串长度(路径) - 1;
            当 (扫i >= 0) {
                如果 (字符串比较(字符串子串(路径, 扫i, 1), "/")) { 尾斜杠 = 扫i; 中断; }
                扫i--;
            }
            整64 点位 = 0 - 1;
            整64 扫j = 字符串长度(路径) - 1;
            当 (扫j > 尾斜杠) {
                如果 (字符串比较(字符串子串(路径, 扫j, 1), ".")) { 点位 = 扫j; 中断; }
                扫j--;
            }
            布尔 是聚合回引 = 假;
            如果 (尾斜杠 >= 0 && 点位 > 尾斜杠) {
                字符串 模块主干 = 字符串子串(路径, 尾斜杠 + 1, 点位 - 尾斜杠 - 1);
                字符串 目录v = 字符串子串(路径, 0, 尾斜杠);
                字符串 目标包 = 目录v + "/包.cn";
                如果 (字符串长度(读源文件(目标包)) > 0) { 是聚合回引 = 真; }
            }
            如果 (!是聚合回引) {
                IO::打印到错误("[parse] 模块循环依赖: " + 路径 + "\n");
                语法错误加一();
                返回 0;
            }
            返回 1;
        }
        返回 1;
    }
    结果<空类型, 整32> 加载标记 = 已加载.设置(路径ID, 2);
    如果 (!加载标记.正常) { 运行时错误(4); }
    // 读文件
    字符串 源码 = 读源文件(路径);
    如果 (字符串长度(源码) == 0) {
        IO::打印到错误("[p6h] 打开失败: " + 路径 + "\n");
        结果<空类型, 整32> 出栈失败 = 已加载.设置(路径ID, 1);
        如果 (!出栈失败.正常) { 运行时错误(4); }
        返回 0;
    }
    // 分词 -> 扫描导入 -> 递归加载依赖（依赖先解析）
    // 546-a D12：词法预处理（规范 4.7 条件编译裁剪）——分词前逐行裁剪，
    //   指令行不产 token、行号经空白替换保持一致（宿主 lexer.cpp 先裁后切同构）
    源码 = 预处理裁剪(源码);
    向量<Token> 记号 = 向量<Token>();
    分词(源码, 记号);
    扫描导入(记号);
    向量<整32> 模块们 = 取走导入模块们();
    加载导入依赖(路径, 目录, 池, 字段偏移表, 已加载, 程序节点们, 货舱, 模块们);
    加载挂载声明(路径, 目录, 池, 字段偏移表, 已加载, 程序节点们, 货舱, 是包根, 本模块路径);
    // 解析本文件（共享池/字段偏移表；程序 节点最后入池 = 池尾）。
    // plans/018 类型/常量分桶（2026-09-08）：解析窗口设 当前模块路径（IR容器
    //   静态——解析结构体声明 布局/候选登记键基的数据源；依赖先解析=递归返回
    //   后本文件重设，窗口无交错）
    设当前模块路径(本模块路径);
    整64 忽略2 = 解析程序(记号, 池, 字段偏移表);
    // 解析程序 会再次登记本文件挂载名（双点登记）——取走丢弃防残留污染
    //   下一文件的挂载清单（时序同 导入项们 消费纪律）
    取走模块声明们();
    // plans/018 第 3 层：本文件快照收集（模块路径+导入项平铺+公开平铺——
    //   与 程序节点们 平行，语义分桶/三级解析/IR 链接键的数据源；标量平铺+
    //   边界向量，嵌套容器禁用见上注）
    收集文件快照(本模块路径, 池, 程序节点们);
    IO::打印到错误("[p6h] 已解析: " + 路径 + " 节点=" +
                  整数转字符串(池.大小() - 1) + "\n");
    结果<空类型, 整32> 出栈完成 = 已加载.设置(路径ID, 1);
    如果 (!出栈完成.正常) { 运行时错误(4); }
    返回 1;
}

// ==================== 编译文件 拆分函数（R3，2026-09-08 机械搬移） ====================

// 导入依赖递归加载（R3 拆分）：候选1 入口同目录 <名>.cn → 候选1b 目录包
//   <名>/包.cn → 候选2b 当前目录上溯链 → 候选3 货舱 [依赖]（对齐宿主 driver
//   候选序，规格 09 六）。全部候选缺失 = 依赖缺失诊断 + 语法错误中止通道。
函数 加载导入依赖(字符串 路径, 字符串 目录, 向量<节点> 池, 映射<整64, 整64> 字段偏移表,
                  映射<整64, 整64>& 已加载, 向量<整32> 程序节点们, 向量<货舱依赖>& 货舱,
                  向量<整32> 模块们) -> 空类型 {
    整64 m = 0;
    当 (m < 模块们.大小()) {
        字符串 模块名 = 字符串复制(驻留文本(整64(模块们.元素(m))));
        如果 (!是标准库模块(模块名)) {
        字符串 候选1 = 目录 + "/" + 模块名 + ".cn";
        字符串 候选源码 = 读源文件(候选1);
        如果 (字符串长度(候选源码) > 0) {
            整64 忽略 = 编译文件(候选1, 目录, 池, 字段偏移表,
                                 已加载, 程序节点们, 0, 货舱, 模块名);
        } 否则 {
            // plans/018 千行拆分轮（2026-09-08 阶段目录包）：候选1b=入口目录
            //   子目录包 <名>/包.cn——库包根（是包根=1）聚合声明子模块；包内
            //   模块 声明按 包目录 同级聚合（挂载通道 目录 参数=包目录）。
            //   与宿主 driver_module 候选2b 目录包同款语义（零 C++ 改动）。
            字符串 包目录 = 目录 + "/" + 模块名;
            字符串 候选1b = 包目录 + "/包.cn";
            字符串 候选1b源码 = 读源文件(候选1b);
            如果 (字符串长度(候选1b源码) > 0) {
                // 340-b：目录包聚合回引豁免——子组件「导入 包根」时 包根 若在途
                //   （值 2）=聚合回引（v2 树包模式惯例·既有静默语义）非循环；
                //   平铺候选在途再入仍由 编译文件 内部判循环拒（325）。
                结果<整64, 整32> 查包回引 = 已加载.获取(驻留(候选1b));
                布尔 包回引在途 = 假;
                如果 (查包回引.正常) {
                    如果 (查包回引.值 == 2) { 包回引在途 = 真; }
                }
                如果 (!包回引在途) {
                    整64 忽略1b = 编译文件(候选1b, 包目录, 池, 字段偏移表,
                                              已加载, 程序节点们, 1, 货舱, 模块名);
                }
            } 否则 {
            // 候选2b：当前文件目录逐级上溯（对齐宿主候选2b 2026-09-08 归正——
            //   起点必须是当前文件目录而非入口目录：包成员引用兄弟包
            //   （阶段目录包形态）时兄弟包在成员目录的祖先链上；每级试
            //   <up>/<名>.cn 与 <up>/<名>/包.cn，上溯至项目根（空前缀=
            //   相对 cwd），守卫 32 级。
            整64 已处理2b = 上溯查找依赖(路径, 模块名, 池, 字段偏移表, 已加载, 程序节点们, 货舱);
            如果 (已处理2b == 0) {
                货舱依赖加载(目录, 模块名, 池, 字段偏移表, 已加载, 程序节点们, 货舱);
            }
            }
        }
    }
        m++;
    }
}

// 候选2b：当前文件目录逐级上溯查找依赖（R3 拆分）。返回 1=已加载；0=未命中。
函数 上溯查找依赖(字符串 路径, 字符串 模块名, 向量<节点> 池, 映射<整64, 整64> 字段偏移表,
                  映射<整64, 整64>& 已加载, 向量<整32> 程序节点们, 向量<货舱依赖>& 货舱) -> 整64 {
    整64 已处理2b = 0;
    字符串 上溯 = 路径目录(路径);
    整64 守卫 = 0;
    当 (已处理2b == 0 && 守卫 < 32) {
        字符串 前缀 = "";
        如果 (字符串长度(上溯) > 0) { 前缀 = 上溯 + "/"; }
        字符串 试平铺 = 前缀 + 模块名 + ".cn";
        字符串 试平铺源码 = 读源文件(试平铺);
        如果 (字符串长度(试平铺源码) > 0) {
            // 340-h（修 340-e 过宽）：试平铺在途豁免**仅目录包形态**——
            //   上溯目录存在 名/包.cn（目录包）→聚合回引静默（v2 树代码生成包）；
            //   纯平铺互引（325·无包.cn）→编译文件 内部循环拒。
            结果<整64, 整32> 查回引2a = 已加载.获取(驻留(试平铺));
            布尔 回引在途2a = 假;
            如果 (查回引2a.正常) {
                如果 (查回引2a.值 == 2) { 回引在途2a = 真; }
            }
            如果 (回引在途2a) {
                字符串 目标包2a = 上溯 + "/" + 模块名 + "/包.cn";
                如果 (字符串长度(读源文件(目标包2a)) > 0) {
                    已处理2b = 1;
                } 否则 {
                整64 忽略2a = 编译文件(试平铺, 上溯, 池, 字段偏移表,
                                      已加载, 程序节点们, 0, 货舱, 模块名);
                已处理2b = 1;
                }
            } 否则 {
            整64 忽略2a = 编译文件(试平铺, 上溯, 池, 字段偏移表,
                                  已加载, 程序节点们, 0, 货舱, 模块名);
            已处理2b = 1;
            }
        } 否则 {
            字符串 试包 = 前缀 + 模块名 + "/包.cn";
            字符串 试包源码 = 读源文件(试包);
            如果 (字符串长度(试包源码) > 0) {
                字符串 试包目录 = 前缀 + 模块名;
                // 340-d：试包（包.cn）在途豁免——同候选1b 聚合回引惯例
                //   （子组件经上溯试到在途包根=聚合回引非循环·v2 树包模式）。
                结果<整64, 整32> 查包回引2b = 已加载.获取(驻留(试包));
                布尔 包回引在途2b = 假;
                如果 (查包回引2b.正常) {
                    如果 (查包回引2b.值 == 2) { 包回引在途2b = 真; }
                }
                如果 (包回引在途2b) {
                    已处理2b = 1;
                } 否则 {
                整64 忽略2b = 编译文件(试包, 试包目录, 池, 字段偏移表,
                                      已加载, 程序节点们, 1, 货舱, 模块名);
                已处理2b = 1;
                }
            }
        }
        如果 (已处理2b == 0) {
            如果 (字符串长度(上溯) == 0) { 中断; }
            上溯 = 路径目录(上溯);
            守卫++;
        }
    }
    返回 已处理2b;
}

// 候选3：货舱 [依赖] 加载（R3 拆分）——版本 "内置"=stdlib 跳过；其他=本地
//   依赖/<名>/<名>.cn 或 /包.cn（库 crate 根）。未声明 = 依赖缺失诊断中止。
函数 货舱依赖加载(字符串 目录, 字符串 模块名, 向量<节点> 池, 映射<整64, 整64> 字段偏移表,
                  映射<整64, 整64>& 已加载, 向量<整32> 程序节点们, 向量<货舱依赖>& 货舱) -> 空类型 {
        字符串 版本 = 货舱查找依赖(货舱, 模块名);
        整64 已处理 = 0;
        如果 (字符串长度(版本) > 0) {
            如果 (字符串比较(版本, "内置")) {
                已处理 = 1;   // 内置依赖=编译器 stdlib（标准库表外显式声明形态）
            } 否则 {
                字符串 依赖根 = 目录 + "/依赖/" + 模块名 + "/";
                字符串 候选3a = 依赖根 + 模块名 + ".cn";
                字符串 候选3a源码 = 读源文件(候选3a);
                如果 (字符串长度(候选3a源码) > 0) {
                    整64 忽略3a = 编译文件(候选3a, 目录, 池, 字段偏移表,
                                           已加载, 程序节点们, 0, 货舱, 模块名);
                    已处理 = 1;
                } 否则 {
                    字符串 候选3b = 依赖根 + "包.cn";
                    字符串 候选3b源码 = 读源文件(候选3b);
                    如果 (字符串长度(候选3b源码) > 0) {
                        整64 忽略3b = 编译文件(候选3b, 依赖根, 池, 字段偏移表,
                                               已加载, 程序节点们, 1, 货舱, "包");
                        已处理 = 1;
                    }
                }
            }
        }
        如果 (已处理 == 0) {
            // 276-a（D29①·2026-09-17）：候选4 stdlib 兜底（宿主 driver_module.cpp:64
            //   对齐——「未声明依赖但 stdlib 存在」即加载编译）。路径口径与
            //   IR签名.cn 签名扫描同源=相对 cwd 的 stdlib/（E2E runner v2work
            //   目录已软链 stdlib→项目根）。stdlib 新模块（随机数/正则等）
            //   名单外→由此兜底加载编译进产物；名单内模块（容器/核心等）不经
            //   此路（加载导入依赖 的 是标准库模块 守卫已跳过=链接期符号供给）。
            字符串 候选4 = "stdlib/" + 模块名 + ".cn";
            字符串 候选4源码 = 读源文件(候选4);
            如果 (字符串长度(候选4源码) > 0) {
                整64 忽略4 = 编译文件(候选4, "stdlib", 池, 字段偏移表,
                                       已加载, 程序节点们, 0, 货舱, 模块名);
                已处理 = 1;
            }
        }
        如果 (已处理 == 0) {
            IO::打印到错误("[p6b] 无法打开依赖模块: " + 目录 + "/" + 模块名 + ".cn" +
                           "（货舱.toml [依赖] 亦未声明，规格 09 六）\n");
            语法错误加一();
        }
}

// 模块 声明挂载加载（R3 拆分）：包根声明 → 同级 <X>.cn（聚合）；普通文件声明 →
//   父挂子 <本文件主干>/<X>.cn；挂载点不存在 = 定位诊断（规格08-二）。
函数 加载挂载声明(字符串 路径, 字符串 目录, 向量<节点> 池, 映射<整64, 整64> 字段偏移表,
                  映射<整64, 整64>& 已加载, 向量<整32> 程序节点们, 向量<货舱依赖>& 货舱,
                  整64 是包根, 字符串 本模块路径) -> 空类型 {
    向量<整32> 挂载们 = 取走模块声明们();
    字符串 本文件主干 = 取文件主干(路径);
    整64 k = 0;
    当 (k < 挂载们.大小()) {
        字符串 挂载名 = 字符串复制(驻留文本(整64(挂载们.元素(k))));
        字符串 挂载路径 = "";
        // plans/018 第 3 层：挂载成员的模块路径——包根聚合（主/包）=挂载名
        //   （宿主外部模块主干名对齐）；父挂子=本模块路径::挂载名（完整路径）
        字符串 挂载模块路径 = 挂载名;
        如果 (是包根 == 1) {
            挂载路径 = 目录 + "/" + 挂载名 + ".cn";
        } 否则 {
            挂载路径 = 目录 + "/" + 本文件主干 + "/" + 挂载名 + ".cn";
            如果 (!字符串比较(本模块路径, "主")) {
                挂载模块路径 = 本模块路径 + "::" + 挂载名;
            }
        }
        字符串 挂载源码 = 读源文件(挂载路径);
        如果 (字符串长度(挂载源码) == 0) {
            IO::打印到错误("[p6b] 模块声明 '" + 挂载名 + "' 非当前模块 '" +
                           本文件主干 + "' 的子模块（模块 声明仅限 包根成员聚合/父模块挂子模块，规格08-二）\n");
            语法错误加一();
        } 否则 {
            整64 忽略挂载 = 编译文件(挂载路径, 目录, 池, 字段偏移表,
                                     已加载, 程序节点们, 0, 货舱, 挂载模块路径);
        }
        k++;
    }
}

// 本文件快照收集（R3 拆分）：模块路径 + 导入项平铺 + 公开平铺 + 程序节点索引
//   （与 程序节点们 平行；标量平铺+边界向量——嵌套容器禁用见 编译文件 注）。
函数 收集文件快照(字符串 本模块路径, 向量<节点> 池, 向量<整32> 程序节点们) -> 空类型 {
    // A2（2026-09-11 方案甲）：字符串入容器须显式复制——向量追加为指针浅共享，
    //   本模块路径 是编译文件参数（借用），源随调用方作用域消亡；快照为跨阶段
    //   静态存储，复制落堆保证独立生命周期（字符串→容器 move 语义随后续批次）。
    结果<空类型, 整32> 加路径 = 模块路径们.追加(字符串复制(本模块路径));
    如果 (!加路径.正常) { 运行时错误(4); }
    向量<整64> 本导入平铺 = 取走导入项平铺();
    结果<空类型, 整32> 加边1 = 导入项边界们.追加(导入项平铺总表.大小());
    如果 (!加边1.正常) { 运行时错误(4); }
    整64 pi = 0;
    当 (pi < 本导入平铺.大小()) {
        结果<空类型, 整32> 加p = 导入项平铺总表.追加(本导入平铺.元素(pi));
        如果 (!加p.正常) { 运行时错误(4); }
        pi++;
    }
    向量<整64> 本公开平铺 = 取走顶层公开平铺();
    整64 ki = 0;
    当 (ki < 本公开平铺.大小()) {
        结果<空类型, 整32> 加k = 公开平铺总表.追加(本公开平铺.元素(ki));
        如果 (!加k.正常) { 运行时错误(4); }
        ki++;
    }
    结果<空类型, 整32> 加节点 = 程序节点们.追加(整32(池.大小() - 1));
    如果 (!加节点.正常) { 运行时错误(4); }
}

// 写 asm 行列表到文件（双后端共用；[cg1] 诊断对齐既有格式——进度行受
//   详细诊断开关（R2），失败行=错误路径不受开关）
函数 写asm文件(向量<字符串>& asm行, 字符串 路径) -> 空类型 {
    如果 (详细诊断开启()) {
        IO::打印到错误("[cg1] asm 行数=" + 整数转字符串(asm行.大小()) + "\n");
    }
    结果<空类型*, 整32> 写文件句柄 = 打开文件(路径, 2);
    如果 (写文件句柄.正常) {
        整64 a = 0;
        当 (a < asm行.大小()) {
            结果<整64, 整32> 写 = 写入文件(写文件句柄.值, asm行.元素(a) + "\n");
            a++;
        }
        关闭文件(写文件句柄.值);
        如果 (详细诊断开启()) {
            IO::打印到错误("[cg1] asm 已写 " + 路径 + "\n");
        }
    } 否则 {
        IO::打印到错误("[cg1] asm 写文件失败\n");
    }
}

函数 主() -> 整32 {
    //   （如 v2p target/v2src119/主.cn），默认 target/v2src.cn（单文件回归冒烟）
    字符串 入口路径 = "target/v2src.cn";
    布尔 显式入口 = 假;
    如果 (系统::参数个数() >= 2) {
        // 70-a（2026-09-11 方案A 补完）：系统::参数 已改 字符*（argv=CRT 持有
        //   借用）——按借用接收；传入 字符串 形参须显式 复制 落堆（A2 收紧）
        字符* 参数值 = 系统::参数(1);
        如果 (参数值 != 无) {
            入口路径 = 归一路径分隔符(字符串复制(参数值));   // 路径身份归一（第四十一轮挂账③根治）
            显式入口 = 真;
        }
    }
    // 阶段A（2026-09-02）：目标平台 = 命令行参数 2（默认 win-x64——既有行为不变；
    // 阶段A（2026-09-02）：目标平台 = 命令行参数 2（默认 win-x64——既有行为不变；
    //   linux-arm64 分派 GAS 后端，输出 target/v2asm.s）
    // 345-a D33 根治：优化级别旗标扫描（-O0/-O1/-O2/-O3 枚举·宿主 cn_main
    //   同构）——原 CLI 传 -O 被静默忽略=优化管线级别固定（D33 立案面）；
    //   级别 0（默认）=无优化零行为变化，级别>0 时代码生成前跑 优化程序
    //   （IR/优化.cn）。-O 形态但非法（如 -O9）=编译错误退出（宿主对齐=拒绝）。
    整64 优化级别 = 扫描优化级别();
    如果 (优化级别 < 0) { 返回 1; }   // 非法 -O 形态已诊断（扫描函数内）
    // 546-a D12：-D 注入宏登记（词法预处理·宿主 options.macros 同语义）
    如果 (!扫描定义旗标()) { 返回 1; }   // -D 缺宏名已诊断（扫描函数内）
    字符串 目标平台 = 解析目标平台();
    如果 (字符串长度(目标平台) == 0) { 返回 1; }   // 未知平台已诊断（plans/017 T2）
    布尔 用ARM64 = 字符串比较(目标平台, "linux-arm64");
    布尔 用X64L = 字符串比较(目标平台, "linux-x86_64");    // plans/017 第三后端
    如果 (详细诊断开启()) {
        IO::打印到错误("[p6h] 入口: " + 入口路径 + "\n");
        IO::打印到错误("[cga] 目标平台: " + 目标平台 + "\n");
    }
    字符串 目录 = 路径目录(入口路径);
    向量<节点> 池 = 向量<节点>();
    // 池索引 0 哨兵（第80轮 2026-09-12 根治）：首元素占位，真实节点索引恒 >= 1
    //   ——「子起点/附加/子终点 > 0」全树成为无歧义的有效引用判据。修复前索引 0
    //   是合法节点位：入口文件首个入池节点落索引 0 时（如首个函数体首条语句的
    //   被调标识符——实参可为字面量/类型名故无前置依赖，是唯一可达形态），
    //   语义与 IR 的 `> 0` 守卫误判「无被调」——构造器 正常/错误/某些 静默退化
    //   为普通调用（未定义符号链接失败）、转移/类型大小 特判失效。Rust NodeId 0
    //   保留同款（rustc CRATE_NODE_ID=1）；哨兵类型 0=未使用，按类型分派全部
    //   跳过，零运行时开销（纯解析期占位）。
    池追加(池, 建节点(节点_哨兵, 0, 0, 0, 0));
    映射<整64, 整64> 字段偏移表 = 映射<整64, 整64>();
    映射<整64, 整64> 已加载表 = 映射<整64, 整64>();
    向量<整32> 程序节点们 = 向量<整32>();
    // 返回值必须消费（挂账1 轮次内实证根治 2026-09-08）：初始化并编译入口
    //   返回非0=入口打开失败中止（rc=2，缺陷零容忍方案A）/货舱解析失败（rc=1）
    //   ——此前返回值丢弃（变量名即 忽略编译），主() 空跑语义/IR/代码生成
    //   产出空程序 asm 且 rc=0 假绿（违背「不产任何产物」纪律；139/141 负
    //   路径仅覆盖语法/语义错误中止路径，入口不存在分支无 E2E 锚定故漏网）。
    整64 入口结果 = 初始化并编译入口(入口路径, 目录, 显式入口, 池, 字段偏移表, 已加载表, 程序节点们);
    如果 (入口结果 != 0) { 返回 整32(入口结果); }
    // 语义（多文件：全部文件 声明收集 -> 逐文件检查）
    // plans/015 方案B（2026-09-04 用户裁决）：语法错误即中止——缺分号等语法层
    //   错误（语法错误数，语法分析.cn 统计）不再无条件继续语义/IR/代码生成
    //   （对齐宿主 diagnostics.hasErrors 构建失败纪律与语义错误即中止同族）
    如果 (语法错误数 > 0) {
        IO::打印到错误("[parse] 语法错误 " + 整数转字符串(语法错误数) +
                      " 个，中止编译（不产 IR/asm）\n");
        返回 1;
    }
    // 280-a（T5 v2 拒绝面·2026-09-17）：词法错误聚合守卫——\u{} 三态等词法
    //   错误（词法分析.cn 词法错误计数·分派处已出诊断行）与语法错误同族，
    //   任一非零即中止（不产 IR/asm·错误产物纪律同族）。聚合后清零防跨
    //   编译轮残留（对齐 导入项们 消费清空惯例）。
    如果 (取词法错误数() > 0) {
        IO::打印到错误("[词法] 词法错误 " + 整数转字符串(取词法错误数()) +
                      " 个，中止编译（不产 IR/asm）\n");
        清零词法错误数();
        返回 1;
    }
    // 546-a D12（规范 4.7 v2 侧）：预处理错误聚合守卫——未知指令/缺宏名/未
    //   闭合条件块（词法/预处理.cn 计数·分派处已出诊断行）与词法错误同族
    //   中止（不产 IR/asm·错误产物纪律同族）。聚合后清零防跨编译轮残留。
    如果 (取预处理错误数() > 0) {
        IO::打印到错误("[预处理] 预处理错误 " + 整数转字符串(取预处理错误数()) +
                      " 个，中止编译（不产 IR/asm）\n");
        清零预处理错误数();
        返回 1;
    }
    // T3（311-a=306-b 波次2 v2 侧·2026-09-17）：结构体字段引用未登记聚合守卫——
    //   值字段递归环（直接/间接·无穷大小类型）与「先声明后使用」违规在此全量
    //   判定中止（检查未登记引用 已出逐条诊断行）；合法程序零 miss 零误报。
    //   对齐宿主 306-a T3 拒绝语义（computeLayout visiting 栈）；聚合后清空防
    //   跨编译轮残留。
    如果 (未登记引用数() > 0) {
        整64 布局违规数 = 检查未登记引用();
        如果 (布局违规数 > 0) {
            清空未登记引用();
            返回 1;
        }
        清空未登记引用();
    }

    整64 err = 语义检查阶段(池, 程序节点们);
    // 灰色点⑤根治（2026-09-04 用户裁决立案·缺陷零容忍）：语义错误即中止——
    //   原无条件继续 IR 生成/代码生成（错误程序仍产 asm 可被链接=错误产物，
    //   对齐宿主 driver 纪律：语义错误构建失败、不产任何产物）。err>0 打印
    //   诊断后返回 1（不产 IR/asm；尾部组件自检仅在入口干净时运行——既有
    //   E2E 用例 err=0 输出流不变）
    如果 (err > 0) {
        IO::打印到错误("[sem5] 语义错误 " + 整数转字符串(err) +
                       " 个，中止 IR 生成与代码生成（退出码 1）\n");
        返回 1;
    }
    // IR 生成（多文件：全部 程序 节点合并；模块路径们——定义侧链接键 plans/018 第 4 层）
    程序IR 程序 = IR生成多文件(池, 程序节点们, 模块路径们);
    // [ir1] 函数 IR dump（每函数头+每指令行=自举最大输出税）——受详细诊断开关（R2）
    如果 (详细诊断开启()) {
        IO::打印到错误("[ir1] IR生成调用后 函数数=" + 整数转字符串(程序.函数们.大小()) + "\n");
        整64 f = 0;
        当 (f < 程序.函数们.大小()) {
            打印函数IR(程序.函数们.元素(f));
            f++;
        }
    }
    // IR 层错误即中止（2026-09-04，对齐 139 语义错误即中止纪律）：[ir2] 级诊断
    //   =IR 不完整（形态不支持/目标未解析），残缺 asm 可被链接=错误产物——
    //   计数>0 打印中止诊断后返回 1（不产 asm；IR生成.cn 冒烟 [ir2] 819→0
    //   收口后正路径不受影响，负路径防残缺产物回归）
    如果 (取IR层错误数() > 0) {
        IO::打印到错误("[ir2] IR 层错误 " + 整数转字符串(取IR层错误数()) +
                       " 个，中止代码生成（退出码 1）\n");
        返回 1;
    }
    // 345-a 优化管线挂点（D33 首步）：级别>0 时对合并后 IR 跑常量折叠——
    //   位置=IR 层错误检查之后、代码生成之前（宿主 driver 优化阶段同位）；
    //   产物物化为常量指令，三后端零感知
    如果 (优化级别 > 0) { 优化程序(程序.函数们, 优化级别); }
    // P6 代码生成：程序IR -> asm 行 -> 写文件（按目标平台分派三后端——plans/017）
    如果 (用ARM64) {
        向量<字符串> asm行a = 代码生成ARM64(程序);
        写asm文件(asm行a, "target/v2asm.s");
    } 否则 如果 (用X64L) {
        向量<字符串> asm行x = 代码生成X64Linux(程序);
        写asm文件(asm行x, "target/v2asm.s");
    } 否则 {
        向量<字符串> asm行w = 代码生成(程序);
        写asm文件(asm行w, "target/v2asm.asm");
    }
    返回 0;
}

// -D 注入宏旗标扫描（546-a D12·宿主 cn_main -D 同构：`-D 宏名` 空格分隔
//   两参数·可多次）：命中即 驻留 登记 注入宏们（词法/预处理.cn 全局态）。
//   形态=`-D` 后跟宏名参数；缺宏名参数=诊断+返回 假（调用方退出 1——宿主
//   「选项 -D 缺少宏名参数」同款拒绝语义）；非 -D 参数忽略（各安其位）。
函数 扫描定义旗标() -> 布尔 {
    整64 序 = 1;
    当 (序 < 系统::参数个数()) {
        字符* 参数文本 = 系统::参数(序);
        如果 (参数文本 != 无) {
            字符串 值 = 字符串复制(参数文本);   // 借用→显式复制（A2 收紧）
            如果 (字符串比较(值, "-D")) {
                如果 (序 + 1 >= 系统::参数个数()) {
                    IO::打印到错误("错误: 选项 -D 缺少宏名参数\n");
                    返回 假;
                }
                字符* 宏文本 = 系统::参数(序 + 1);
                如果 (宏文本 == 无) {
                    IO::打印到错误("错误: 选项 -D 缺少宏名参数\n");
                    返回 假;
                }
                设注入宏(驻留(字符串复制(宏文本)));
                序++;
            }
        }
        序++;
    }
    返回 真;
}

// 优化级别旗标扫描（345-a D33 根治·宿主 cn_main -O 枚举同构）：扫全部命令行
//   参数，识别 -O0/-O1/-O2/-O3；-O 形态但非法（-O9/-Ox/单独 -O）=诊断+返回 -1
//   （调用方退出 1——宿主对「多余参数」报错同款拒绝语义）；非 -O 参数忽略
//   （入口/平台/--verbose 各安其位）。返回 0~3=级别；-1=非法形态（已诊断）。
函数 扫描优化级别() -> 整64 {
    整64 级别 = 0;
    整64 序 = 1;
    当 (序 < 系统::参数个数()) {
        字符* 参数文本 = 系统::参数(序);
        如果 (参数文本 != 无) {
            字符串 值 = 字符串复制(参数文本);   // 借用→显式复制（A2 收紧）
            如果 (字符串长度(值) >= 2) {
                字符串 前缀 = 字符串子串(值, 0, 2);
                如果 (字符串比较(前缀, "-O")) {
                    如果 (字符串长度(值) == 3) {
                        整64 级别字节 = 整64(值[2]) & 255;
                        如果 (级别字节 >= 48 && 级别字节 <= 51) {
                            级别 = 级别字节 - 48;   // '0'..'3'
                        } 否则 {
                            IO::打印到错误("错误: 非法优化级别旗标 " + 值 +
                                           "（支持 -O0/-O1/-O2/-O3）\n");
                            返回 -1;
                        }
                    } 否则 {
                        IO::打印到错误("错误: 非法优化级别旗标 " + 值 +
                                       "（支持 -O0/-O1/-O2/-O3）\n");
                        返回 -1;
                    }
                }
            }
        }
        序++;
    }
    返回 级别;
}

// 目标平台解析与校验（R3 拆分）：参数 2 平台 + 未知平台显式报错（plans/017 T2）
//   + 参数 3 --verbose 诊断分级开关（R2）。校验失败返回 空串（主干退出 1）。
函数 解析目标平台() -> 字符串 {
    字符串 目标平台 = "win-x64";
    如果 (系统::参数个数() >= 3) {
        // 70-a：系统::参数=字符* 借用——赋入 字符串 变量须显式 复制（A2 收紧）
        字符* 目标值 = 系统::参数(2);
        如果 (目标值 != 无) {
            目标平台 = 字符串复制(目标值);
        }
    }
// 目标平台校验（plans/017 T2）：未知平台显式报错退出——防静默落 win 分支产错目标产物
如果 (!字符串比较(目标平台, "linux-arm64") && !字符串比较(目标平台, "linux-x86_64") &&
     !字符串比较(目标平台, "win-x64")) {
    IO::打印到错误("[cga] 未知目标平台: " + 目标平台 +
                   "（应为 win-x64 / linux-arm64 / linux-x86_64），中止编译\n");
    返回 "";
}
// R2 诊断分级（2026-09-08）：第 3 参数 --verbose 开启内部进度诊断——默认
//   静默（零输出税）；错误路径诊断不受开关（对外契约）
如果 (系统::参数个数() >= 4) {
    // 70-a：系统::参数=字符* 借用（字符串比较 同码按字符串消费）
    字符* 诊断值 = 系统::参数(3);
    如果 (诊断值 != 无 && 字符串比较(诊断值, "--verbose")) {
        设详细诊断(真);
    }
}
    返回 目标平台;
}

// 包上下文恢复（挂账1 根治，2026-09-08；宿主 restorePackageContext CN 同构）：
//   单文件入口若是项目内目录包成员——所在目录 包.cn 声明了入口文件主干名的
//   模块 挂载——则编译包根聚合（兄弟成员补入编译集）。背景：包内兄弟符号经
//   合并全局池解析（无显式 导入），入口绕过包根挂载链单独编译时兄弟文件不
//   在编译集——「未声明函数: 取语义诊断」等 137 错（第三十七轮挂账实证，
//   v2p/cn_self 编译 语义检查.cn 等组件成员入口复现）。
//   时序：入口先编译（模块路径=主）→ 包根后编译——入口同文件经 已加载
//   路径去重跳过（编译文件 幂等，不双载）。成员判定精确：包根未声明入口
//   主干挂载（入口只是恰好位于包目录的非成员文件）不触发，防误载无关包
//   符号；入口自身即 包.cn 时主干=「包」不与挂载名相同，天然跳过。
//   返回 0=成功/不适用；非0=包根编译失败。
函数 恢复包上下文(字符串 入口路径, 字符串 目录, 向量<节点> 池, 映射<整64, 整64> 字段偏移表,
                  映射<整64, 整64>& 已加载, 向量<整32> 程序节点们,
                  向量<货舱依赖>& 货舱) -> 整64 {
    字符串 包路径 = 目录 + "/包.cn";
    字符串 包源码 = 读源文件(包路径);
    如果 (字符串长度(包源码) == 0) { 返回 0; }  // 所在目录无包根：非包成员
    // 只取包根 模块 声明清单（分词+扫描导入；不解析不进共享池）。
    //   导入模块清单一并取走丢弃——防登记窗口残留污染后续 编译文件。
    // 546-a D12：包.cn 同过预处理（无 # 行=裁剪幂等零变更·管线一致性）
    包源码 = 预处理裁剪(包源码);
    向量<Token> 记号 = 向量<Token>();
    分词(包源码, 记号);
    扫描导入(记号);
    向量<整32> 忽略导入 = 取走导入模块们();
    向量<整32> 挂载们 = 取走模块声明们();
    字符串 主干 = 取文件主干(入口路径);
    // 包根模块路径 = 目录尾段（与 加载导入依赖 候选1b 包名同源）
    字符串 包名 = 目录;
    整64 i = 整64(字符串长度(目录) - 1);
    当 (i >= 0) {
        整64 字节 = 整64(目录[i]) & 255;
        如果 (字节 == 47 || 字节 == 92) {
            包名 = 字符串子串(目录, i + 1, 字符串长度(目录) - i - 1);
            i = -1;
        }
        i--;
    }
    整64 k = 0;
    当 (k < 挂载们.大小()) {
        // 字符串比较 真=相等（主() --verbose 判定同款）——主干==挂载名 即入口
        //   是包成员（此前误加 ! 变「不等即触发」，全部入口误编译包根，rc=1
        //   假失败实测：词法/包.cn 无诊断退出）
        如果 (字符串比较(主干, 驻留文本(整64(挂载们.元素(k))))) {
            整64 包编译 = 编译文件(包路径, 目录, 池, 字段偏移表, 已加载, 程序节点们,
                                   1, 货舱, 包名);
            // 编译文件 契约转换：0=失败 1=成功 → 本函数契约 0=成功/不适用 非0=失败
            如果 (包编译 == 0) { 返回 1; }
            返回 0;
        }
        k++;
    }
    返回 0;  // 包根未挂载入口主干：非包成员文件
}

// 入口初始化与编译（R3 拆分）：任务级表清空 + 货舱.toml 发现解析 + 编译文件
//   （入口=包根，模块路径="主"）+ 打开失败显式入口中止/无参内置回退（缺陷零容忍方案A）。
函数 初始化并编译入口(字符串 入口路径, 字符串 目录, 布尔 显式入口, 向量<节点> 池,
                      映射<整64, 整64> 字段偏移表, 映射<整64, 整64>& 已加载表,
                      向量<整32> 程序节点们) -> 整64 {
    清空变量结构体表();  // 本任务全部文件共享 变量结构体表（跨文件字段偏移推导）
    清空变量容器表();    // P7b：容器/结果 变量类型表同样任务级生命周期
    清空推断声明类型表(); // 46-c：推断声明类型表任务级生命周期（语义层推导登记
                         //   -> IR 生成查表回填；跨文件保留同 变量结构体表 时序）
    清空结构体布局表();  // ②b B1：结构体大小/对齐/字段类型表任务级生命周期
    清空类表();          // 第七十八轮：用户类元数据表（类名/方法/构造/析构）
                         //   任务级生命周期（与结构体布局表同步）
    清空泛型参数名们();  // 414-a（D42 波1）：泛型类类型参数名平铺表任务级生命周期
    清空泛型实例们();    // 416-a（D42 波2）：泛型实例/基类参数序/克隆类节点索引表任务级生命周期
    // plans/018 P6b：货舱.toml 发现与解析（入口同目录；缺省=无货舱配置）。
    //   依赖表用容器构造初始化（向量<货舱依赖>() 成熟路径——含容器字段结构体
    //   聚合形态的裸声明不触发容器构造，见 货舱解析.cn 实施注记）
    向量<货舱依赖> 货舱 = 向量<货舱依赖>();
    字符串 货舱包名 = "";
    字符串 货舱包版 = "";
    字符串 货舱内容 = 读源文件(目录 + "/货舱.toml");
    如果 (字符串长度(货舱内容) > 0) {
        整64 货舱错 = 解析货舱(货舱内容, 货舱包名, 货舱包版, 货舱);
        如果 (货舱错 > 0) {
            IO::打印到错误("[p6b] 货舱.toml 解析失败（第 " + 整数转字符串(货舱错) +
                           " 行节头不闭合），中止编译\n");
            返回 1;
        }
        IO::打印到错误("[p6b] 货舱.toml 已加载: " + 货舱包名 + " v" +
                       货舱包版 + "（依赖 " + 整数转字符串(货舱.大小()) + " 项）\n");
    }
    // 入口=包根（模块 声明挂载按同级聚合解析，plans/018 定位收紧）；模块路径="主"
    整64 编译结果 = 编译文件(入口路径, 目录, 池, 字段偏移表, 已加载表, 程序节点们, 1, 货舱, "主");
    // 包上下文恢复（挂账1 根治 2026-09-08）：入口是项目内目录包成员时聚合
    //   包根（兄弟成员补入编译集；入口文件经 已加载 路径去重不双载）
    如果 (编译结果 != 0) {
        整64 恢复结果 = 恢复包上下文(入口路径, 目录, 池, 字段偏移表, 已加载表,
                                     程序节点们, 货舱);
        如果 (恢复结果 != 0) { 返回 1; }
    }
    如果 (编译结果 == 0) {
        // 缺陷零容忍根治（2026-09-07 第二十八轮，用户裁决方案A·Rust fail fast）：
        //   显式指定的入口打开失败=编排错误，立即中止（返回 2，不产 IR/asm）——
        //   对齐 rustc「入口不存在=编译失败退出」绝不静默编译别的源码；此前
        //   无条件回退内置源码，编排路径错被掩盖成 rc=0 假成功（第二十七轮亲踩）。
        //   仅无参自检模式（默认 target/v2src.cn）保留内置回退（设计特性）
        如果 (显式入口) {
            IO::打印到错误("[p6f] 打开失败: " + 入口路径 +
                           "（显式指定的入口不存在），中止编译\n");
            返回 2;
        }
        // 入口打不开：回退 内置回归源码（指针/字段访问冒烟，单文件）
        IO::打印到错误("[p6f] 打开失败，用内置回归源码\n");
        字符串 源码 = "结构体 点 { 整64 x; 整64 y; }" +
              " 函数 主() -> 整32 { 点 位置; 位置.x = 7; 位置.y = 9; 整64* 指针 = &位置.x; *指针 = 10; 返回 位置.x + 位置.y; }";
        向量<Token> 记号 = 向量<Token>();
        分词(预处理裁剪(源码), 记号);
        设当前模块路径("主");   // plans/018 类型/常量分桶：回退源码=主模块单文件
        整64 忽略回退 = 解析程序(记号, 池, 字段偏移表);
        结果<空类型, 整32> 加回退 = 程序节点们.追加(整32(池.大小() - 1));
        如果 (!加回退.正常) { 运行时错误(4); }
        // 回退源码视为主模块单文件——四快照须配对收集（切片防越界，同 编译文件）
        结果<空类型, 整32> 加r路径 = 模块路径们.追加("主");
        如果 (!加r路径.正常) { 运行时错误(4); }
        结果<空类型, 整32> 加r边1 = 导入项边界们.追加(0);
        如果 (!加r边1.正常) { 运行时错误(4); }
    }
    // 返回值契约重整（2026-09-08）：0=成功（含内置回退成功）；1=货舱解析失败；
    //   2=显式入口不存在（fail fast）。此前尾部 返回 编译结果（编译文件 契约
    //   1=成功 0=失败）与本函数返回值契约冲突——返回值长期不被主() 消费
    //   （「忽略编译」假绿掩盖），主() 消费修复后即暴露（v2p 编译 v2 假失败
    //   rc=1 实测）。
    返回 0;
}

// 语义阶段（R3 拆分）：语义分析多文件 + [sem5] 诊断打印（正确程序错误数受
//   详细诊断开关 R2）。返回 err；语法错误数检查留 主()（先于本函数）。
函数 语义检查阶段(向量<节点> 池, 向量<整32> 程序节点们) -> 整64 {
    向量<字符串> 诊断 = 向量<字符串>();
    // plans/018 第 3 层：语义分桶+三级解析（每文件模块路径与 ②③ 导入/公开平铺）
    整64 err = 语义分析多文件(池, 程序节点们, 模块路径们, 导入项平铺总表,
                              导入项边界们, 公开平铺总表, 诊断);
    如果 (详细诊断开启()) {
        IO::打印到错误("[sem5] 正确程序 错误数=" + 整数转字符串(err) + "\n");
    }
    整64 诊断i = 0;
    当 (诊断i < 诊断.大小()) {
        IO::打印到错误("[sem5] 正确诊断: " + 诊断.元素(诊断i) + "\n");
        诊断i++;
    }
    返回 err;
}
