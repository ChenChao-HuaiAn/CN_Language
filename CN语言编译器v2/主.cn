导入 容器::向量
导入 文件::打开文件
导入 文件::写入文件
导入 文件::关闭文件
导入 词法分析
导入 语法分析
导入 语义分析
导入 IR生成
导入 代码生成

// 冒烟打印函数 IR 指令（操作码/操作数/结果）
函数 打印函数IR(函数IR 函数信息) -> 空类型 {
    IO::打印到错误("[ir1] 函数: " + 驻留文本(整64(函数信息.名字)) +
                   " 返回类型码=" + 整数转字符串(函数信息.返回类型) + "\n")
    整64 i = 0
    当 (i < 函数信息.指令.大小()) {
        IR指令 指令 = 函数信息.指令.元素(i)
        IO::打印到错误("[ir1]  op=" + 整数转字符串(指令.操作码) +
                       " o1=" + 整数转字符串(指令.操作数1) +
                       " o2=" + 整数转字符串(指令.操作数2) +
                       " o3=" + 整数转字符串(指令.操作数3) +
                       " 目标=" + 整数转字符串(指令.目标) +
                       " 类型=" + 整数转字符串(指令.类型) +
                       " 附加=" + 整数转字符串(指令.附加) + "\n")
        i++
    }
}

函数 主() -> 整32 {
    // 纯映射自检（放最前）：排除 解析/语义 破坏
    映射<整64, 整64> 自检表 = 映射<整64, 整64>()
    结果<空类型, 整32> 自检设 = 自检表.设置(1, 100)
    IO::打印到错误("[ir1] 自检设置: " + 整数转字符串(自检表.大小()) + "\n")
    结果<整64, 整32> 自检取 = 自检表.获取(1)
    IO::打印到错误("[ir1] 自检获取后\n")
    如果 (自检取.正常) {
        IO::打印到错误("[ir1] 自检获取: " + 整数转字符串(自检取.值) + "\n")
    }
    字符串 源码 = "函数 加(整32 a, 整32 b) -> 整32 { 返回 a + b }"
    向量<Token> 记号 = 向量<Token>()
    分词(源码, 记号)
    向量<节点> 池 = 向量<节点>()
    整64 忽略 = 解析程序(记号, 池)
    向量<字符串> 诊断 = 向量<字符串>()
    整64 err = 语义分析(池, 整32(池.大小() - 1), 诊断)
    IO::打印到错误("[sem5] 正确程序 错误数=" + 整数转字符串(err) + "\n")
    // IR 生成冒烟：程序节点 = 池.大小()-1（程序 节点在池尾）
    IO::打印到错误("[ir1] IR生成调用前\n")
    程序IR 程序 = IR生成(池, 整32(池.大小() - 1))
    IO::打印到错误("[ir1] IR生成调用后 函数数=" + 整数转字符串(程序.函数们.大小()) + "\n")
    整64 f = 0
    当 (f < 程序.函数们.大小()) {
        打印函数IR(程序.函数们.元素(f))
        f++
    }
    // P6 代码生成：程序IR -> asm 行 -> 写文件
    向量<字符串> asm行 = 代码生成(程序)
    IO::打印到错误("[cg1] asm 行数=" + 整数转字符串(asm行.大小()) + "\n")
    结果<空类型*, 整32> 打开 = 打开文件("target/v2asm.asm", 2)
    如果 (打开.正常) {
        整64 a = 0
        当 (a < asm行.大小()) {
            结果<整64, 整32> 写 = 写入文件(打开.值, asm行.元素(a) + "\n")
            a++
        }
        关闭文件(打开.值)
        IO::打印到错误("[cg1] asm 已写 target/v2asm.asm\n")
    } 否则 {
        IO::打印到错误("[cg1] asm 写文件失败\n")
    }
    // 错误程序：未声明 x
    字符串 源码2 = "函数 坏() -> 整32 { 返回 x + 1 }"
    向量<Token> 记号2 = 向量<Token>()
    分词(源码2, 记号2)
    向量<节点> 池2 = 向量<节点>()
    整64 忽略2 = 解析程序(记号2, 池2)
    向量<字符串> 诊断2 = 向量<字符串>()
    整64 err2 = 语义分析(池2, 整32(池2.大小() - 1), 诊断2)
    IO::打印到错误("[sem5] 错误程序 错误数=" + 整数转字符串(err2) + "\n")
    整64 i = 0
    当 (i < 诊断2.大小()) {
        IO::打印到错误("[sem5] 诊断: " + 诊断2.元素(i) + "\n")
        i++
    }
    返回 0
}