导入 容器::向量
导入 词法分析

函数 主() -> 整32 {
    字符串 源码 = "函数 主() -> 整32 { 返回 0 }"
    向量<Token> 记号 = 向量<Token>()
    分词(源码, 记号)
    打印("Token 总数=", 记号.大小(), " 驻留计数=", 驻留计数())
    整64 i = 0
    当 (i < 记号.大小()) {
        Token t = 记号.元素(i)
        字符串 文本 = 驻留文本(整64(t.文本))
        打印("t", i, " 类型=", t.类型, " ID=", t.文本, " 文本=", 文本, " 行=", t.行)
        i++
    }
    返回 0
}