// 语义检查·内置函数参数个数闭集核对（#1911·零分叉缺口根治 2026-11-02）
// 职责：内置函数调用的实参个数闭集核对——修前 v2 内置分支查到内置名即直返
//   返回类型（实参个数零检查：整数转字符串(a, b) 两实参静默放行），宿主
//   重载决议个数不符拒「未找到匹配的函数 'X'（参数个数或类型不匹配）」
//   =零分叉缺口。本文件补：①内置函数参数个数闭集表（键集合与 IR 布局尾
//   内置函数返回类型直查 逐键一一对应·个数来源=宿主 semantic_builtins.cpp
//   注册表 paramTypes 长度）；②检查内置实参个数 主检查（挂点=语义检查
//   表达式.cn 检查调用表达式 内置分支首行·检查变参打印实参 443 之前）。
//   **新增内置函数须同步登记个数表（与返回类型表双表同批）——miss=内部
//   错误显形（表漂移=编译器 bug·882 处置①）**，见 内置函数参数个数直查。
// 依赖经合并全局池（同包兄弟：表诊断）；显式导入限跨包（IR=内置归一基名）。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_* 常量（目录包名）
导入 IR;         // 内置归一基名（限定名归一两级查找协议·与内置函数返回类型ID 同款）
导入 协议常量;   // 驻留/驻留文本（中立层）

公开:   // 全文件公开（包内兄弟模块消费）

// ==================== 内置函数参数个数闭集表 ====================

// 变参标记：登记值 = 0 - 1（打印/打印行/格式化 个数不限——宿主 variadic=true
//   立法面·001 §10.6；格式化零实参另有 #1910 格式串缺位执法）。标记是显式
//   分类值非失败哨兵：查表 miss 走 可选 无值通道（内部错误显形），两域不重叠。
静态 整64 变参标记 = 0 - 1;

// 裸名键个数表（键集合=内置函数返回类型直查 裸名段逐键对应·个数=宿主
//   semantic_builtins.cpp 注册 paramTypes 长度）
函数 内置参数个数直查裸名(字符串 名) -> 可选<整64> {
    如果 (字符串比较(名, "驻留文本")) { 返回 某些(1); }
    如果 (字符串比较(名, "字符串子串")) { 返回 某些(3); }
    如果 (字符串比较(名, "字符串连接")) { 返回 某些(2); }
    如果 (字符串比较(名, "字符串复制")) { 返回 某些(1); }
    如果 (字符串比较(名, "整数转字符串")) { 返回 某些(1); }
    如果 (字符串比较(名, "字符转字符串")) { 返回 某些(1); }
    如果 (字符串比较(名, "字符串比较")) { 返回 某些(2); }
    如果 (字符串比较(名, "字符串大写")) { 返回 某些(1); }
    如果 (字符串比较(名, "字符串小写")) { 返回 某些(1); }
    如果 (字符串比较(名, "字符串修剪")) { 返回 某些(1); }
    如果 (字符串比较(名, "字符串反转")) { 返回 某些(1); }
    如果 (字符串比较(名, "浮点转字符串")) { 返回 某些(1); }
    如果 (字符串比较(名, "布尔转字符串")) { 返回 某些(1); }
    如果 (字符串比较(名, "正数转字符串")) { 返回 某些(1); }
    如果 (字符串比较(名, "格式化")) { 返回 某些(变参标记); }
    如果 (字符串比较(名, "字符串查找")) { 返回 某些(2); }
    如果 (字符串比较(名, "字符串字典序")) { 返回 某些(2); }
    如果 (字符串比较(名, "字符串前缀")) { 返回 某些(2); }
    如果 (字符串比较(名, "字符串后缀")) { 返回 某些(2); }
    如果 (字符串比较(名, "字符串包含")) { 返回 某些(2); }
    如果 (字符串比较(名, "字符串释放")) { 返回 某些(1); }
    如果 (字符串比较(名, "摘除")) { 返回 某些(1); }   // #1674 甲案：摘除 检查在其自身挂点（1674）先行·本表登记=闭集完备
    如果 (字符串比较(名, "分配")) { 返回 某些(1); }
    如果 (字符串比较(名, "重新分配")) { 返回 某些(2); }
    如果 (字符串比较(名, "复制内存")) { 返回 某些(3); }
    如果 (字符串比较(名, "置零内存")) { 返回 某些(2); }
    如果 (字符串比较(名, "释放")) { 返回 某些(1); }
    如果 (字符串比较(名, "驻留")) { 返回 某些(1); }
    如果 (字符串比较(名, "驻留计数")) { 返回 某些(0); }
    如果 (字符串比较(名, "字符串长度")) { 返回 某些(1); }
    如果 (字符串比较(名, "运行时错误")) { 返回 某些(1); }
    如果 (字符串比较(名, "打印")) { 返回 某些(变参标记); }
    如果 (字符串比较(名, "打印行")) { 返回 某些(变参标记); }
    返回 无;
}

// 限定名/点号变体键个数表（键集合=内置函数返回类型直查 限定名段逐键对应·
//   线程/解析/内存 族含旧点号形态——v2 返回表两形态并存·个数表同批登记）
函数 内置参数个数直查限定名(字符串 名) -> 可选<整64> {
    如果 (字符串比较(名, "字符串构建器::新建")) { 返回 某些(0); }
    如果 (字符串比较(名, "字符串构建器::完成")) { 返回 某些(1); }
    如果 (字符串比较(名, "字符串构建器::追加")) { 返回 某些(2); }
    如果 (字符串比较(名, "字符串构建器::追加字节")) { 返回 某些(2); }
    如果 (字符串比较(名, "字符串构建器::弃置")) { 返回 某些(1); }
    如果 (字符串比较(名, "IO::读取行")) { 返回 某些(0); }
    如果 (字符串比较(名, "文件::读取文件行")) { 返回 某些(1); }
    如果 (字符串比较(名, "文件::文件存在")) { 返回 某些(1); }
    如果 (字符串比较(名, "文件::创建目录")) { 返回 某些(1); }
    如果 (字符串比较(名, "IO::读取浮点")) { 返回 某些(1); }
    如果 (字符串比较(名, "IO::打印到错误")) { 返回 某些(1); }
    如果 (字符串比较(名, "文件::关闭文件")) { 返回 某些(1); }
    如果 (字符串比较(名, "IO::读取整数")) { 返回 某些(1); }
    如果 (字符串比较(名, "文件::打开文件")) { 返回 某些(2); }
    如果 (字符串比较(名, "文件::读取文件")) { 返回 某些(3); }
    如果 (字符串比较(名, "文件::写入文件")) { 返回 某些(2); }
    如果 (字符串比较(名, "文件::文件大小")) { 返回 某些(1); }
    如果 (字符串比较(名, "系统::参数个数")) { 返回 某些(0); }
    如果 (字符串比较(名, "系统::参数")) { 返回 某些(1); }
    如果 (字符串比较(名, "数学::平方根")) { 返回 某些(1); }
    如果 (字符串比较(名, "数学::幂")) { 返回 某些(2); }
    如果 (字符串比较(名, "数学::正弦")) { 返回 某些(1); }
    如果 (字符串比较(名, "数学::余弦")) { 返回 某些(1); }
    如果 (字符串比较(名, "数学::正切")) { 返回 某些(1); }
    如果 (字符串比较(名, "数学::绝对值")) { 返回 某些(1); }
    如果 (字符串比较(名, "数学::向上取整")) { 返回 某些(1); }
    如果 (字符串比较(名, "数学::向下取整")) { 返回 某些(1); }
    如果 (字符串比较(名, "内存::活动分配数") ||
         字符串比较(名, "内存.活动分配数")) { 返回 某些(0); }
    如果 (字符串比较(名, "内存::总分配次数")) { 返回 某些(0); }
    如果 (字符串比较(名, "内存::竞技场分配")) { 返回 某些(1); }
    如果 (字符串比较(名, "内存::竞技场重置")) { 返回 某些(0); }
    如果 (字符串比较(名, "内存::竞技场活动字节")) { 返回 某些(0); }
    如果 (字符串比较(名, "内存::释放全部")) { 返回 某些(0); }
    如果 (字符串比较(名, "内存::总分配字节") ||
         字符串比较(名, "内存.总分配字节")) { 返回 某些(0); }
    如果 (字符串比较(名, "时间::当前时间戳")) { 返回 某些(0); }
    如果 (字符串比较(名, "时间::单调时钟毫秒")) { 返回 某些(0); }
    如果 (字符串比较(名, "时间::格式化时间")) { 返回 某些(2); }
    如果 (字符串比较(名, "线程::新") || 字符串比较(名, "线程.新")) { 返回 某些(2); }
    如果 (字符串比较(名, "线程::互斥锁新建") ||
         字符串比较(名, "线程.互斥锁新建")) { 返回 某些(0); }
    如果 (字符串比较(名, "线程::并入") || 字符串比较(名, "线程.并入")) { 返回 某些(1); }
    如果 (字符串比较(名, "线程::上锁") || 字符串比较(名, "线程.上锁")) { 返回 某些(1); }
    如果 (字符串比较(名, "线程::解锁") || 字符串比较(名, "线程.解锁")) { 返回 某些(1); }
    如果 (字符串比较(名, "线程::互斥锁释放") ||
         字符串比较(名, "线程.互斥锁释放")) { 返回 某些(1); }
    如果 (字符串比较(名, "解析::转整数") || 字符串比较(名, "解析.转整数")) { 返回 某些(2); }
    如果 (字符串比较(名, "解析::转浮点") || 字符串比较(名, "解析.转浮点")) { 返回 某些(2); }
    如果 (字符串比较(名, "解析::转布尔") || 字符串比较(名, "解析.转布尔")) { 返回 某些(2); }
    返回 无;
}

// 内置函数参数个数直查主入口（两级表分流·键不相交：裸名表查 miss 落限定名表）
//   **闭集约束：新增内置函数必须同步登记（返回类型表与个数表双表同批·漏登
//   =消费面内部错误显形）**
函数 内置函数参数个数直查(字符串 名) -> 可选<整64> {
    可选<整64> 裸名查个数 = 内置参数个数直查裸名(名);
    如果 (裸名查个数.有值) { 返回 裸名查个数; }
    返回 内置参数个数直查限定名(名);
}

// ==================== 主检查（挂点=检查调用表达式 内置分支首行） ====================

// 内置调用实参个数核对（#1911）：两级查找协议与 内置函数返回类型ID 逐字同构
//   （直查 miss 后对 归一基名 再查——限定名改写产物 IO::打印 等经归一命中
//   裸名键）。个数不符=表诊断（文案逐字对齐宿主 resolveOverload 决议失败面
//   「未找到匹配的函数 'X'（参数个数或类型不匹配）」·宿主 semantic_sig.cpp
//   bestKey 空分支同串）后由挂点方继续 返回 正常(内置返回)——宿主 fallback
//   恢复兼容面同构（诊断已计数·编译收尾中止），诊断条数两侧一致。
//   表漂移（返回表命中而本表两级 miss）=[内部错误] 显形（882 处置①·编译必败
//   ——非用户错误面·禁静默放行）。
函数 检查内置实参个数(向量<节点> 池, 节点 n, 整32 调用节点索引,
                    向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    // 443/1910 同款防护（负子起点=解析器不产形态；被调位须为标识符——
    //   内置分支入口已被 内置函数返回类型ID(被调文本) 同源判定保证）
    如果 (n.子起点 == 0 || 整64(n.子起点) >= 池.大小()) { 返回; }
    节点 被调配 = 池.元素(整32(n.子起点));
    如果 (被调配.类型 != 节点_标识符) { 返回; }
    字符串 被调名个数 = 字符串复制(驻留文本(整64(被调配.文本)));

    // 两级查找（直查 + 归一基名·与 内置函数返回类型ID 协议一致）
    可选<整64> 个数查 = 内置函数参数个数直查(被调名个数);
    如果 (!个数查.有值) {
        字符串 归一名个数 = 内置归一基名(被调名个数);
        如果 (!字符串比较(归一名个数, 被调名个数)) {
            个数查 = 内置函数参数个数直查(归一名个数);
        }
    }
    // 表漂移显形：返回类型表命中而个数表两级均 miss=新增内置未同步登记
    如果 (!个数查.有值) {
        表诊断(诊断, "[内部错误] 内置函数 '" + 被调名个数 +
              "' 未登记参数个数（内置函数参数个数表与内置函数返回类型表漂移·新增内置须双表同批登记）");
        返回;
    }
    整64 登记个数 = 个数查.值;
    // 变参内置（打印/打印行/格式化）：个数不限=宿主 variadic=true 立法面放行
    如果 (登记个数 == 变参标记) { 返回; }
    // 个数闭集核对：实参个数（节点 附加=实参个数·418/474 同源协议）不符=编译期拒
    如果 (整64(n.附加) != 登记个数) {
        表诊断(诊断, "[错误] 未找到匹配的函数 '" + 被调名个数 +
              "'（参数个数或类型不匹配）");
    }
}
