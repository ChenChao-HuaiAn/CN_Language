// CN 自举编译器 v2 · 语义检查初始化复合键1684（#1684 拆分·自 语义检查初始化.cn
//   机械搬移·1124 行超千行红线先拆再加纪律·函数体逐字保留零逻辑变化）
// 职责：def-init 叶级键面+复合下标查读/写置位/place 合成族——
//   ①下标对象基语境（读/置下标基语境1684·宿主 inAddrBaseCtx_ 同构）
//   ②下标检查去重+结果缓存（标记下标检查1684/登记下标结果1684/取下标缓存1684/
//     清空已查下标节点1684·函数级生命周期）
//   ③多维数组维长序列（状态数组维长们·三消费点单一事实源）+叶号区间线性化
//     （状态叶号区间1684·行主序·读/写复合判定单一事实源）
//   ④复合下标查读（状态查读下标复合·宿主 defInitCheckReadPlace 同构）/写置位
//     （状态写置位下标复合·宿主 defInitMarkInitPlace 同构）+place 诊断文本合成
//     （状态合成place文本1684）+下标读判定统一入口（状态下标读判定复合1684）
//   ⑤链式左值基底解析（状态链基底·#1684 复合化改造面·宿主 defInitPlaceOf 同构）
// 依赖：语义检查初始化（状态读赋值目标中/状态声明层/状态构造键/状态查键/状态删键/
//   状态删前缀/状态删位/取常量下标值/未初始化键们）/语义分析中（表查找类型ID）/
//   语义分析尾（表诊断）/协议常量（回绕加64/位模式取负474）/语法（节点_*）/
//   IR（数组长度文本/数组元素文本）——语义包内合并池解析。
// 消费=语义检查类（检查下标表达式）/语义检查初始化（状态链基底复合消费面）/
//   语义检查赋值（写点置位）等。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_* 常量（目录包名）
导入 IR;         // 数组长度文本/数组元素文本（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包（回绕加64/位模式取负474）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// #1684（2026-10-26·嵌套下标读写全链）：**下标对象基语境**（宿主 visitIndexExpr
//   inAddrBaseCtx_ 同构）：嵌套 m[1][2] 的外层检查递归内层 m[1] 时置位——内层
//   作为外层的**地址基**，其 def-init 读判定抑制（宿主对象侧同款；判定只发生
//   在最外层节点=place 复合后缀完整处）。写语境抑制（状态赋值目标中）独立
//   存在，两抑制面正交。
静态 布尔 状态下标基语境1684 = 假;

函数 状态读下标基语境1684() -> 布尔 {
    返回 状态下标基语境1684;
}

不安全 函数 状态置下标基语境1684(布尔 值) -> 空类型 {
    状态下标基语境1684 = 值;
}

// #1684（2026-10-26·嵌套下标读写全链）：下标节点**检查去重+结果缓存**——
//   v2 语句区间遍历对复合表达式的中间后缀节点逐个独立检查（宿主 AST 递归
//   只到根·内层仅经 checkExpr(object) 递归到达一次），嵌套 m[1][2] 的内层
//   m[1] 因此被查两遍（区间独立一遍+外层嵌套分支递归一遍）→ 越界/def-init
//   双诊断（s2 实录：m[2][0]=1 报两条越界·宿主 1 条）。报过即记（节点索引
//   →结果），重复到达直取缓存（926 标记成员检查 同款纪律）；函数级生命周期
//   （检查函数/检查方法 入口清空·与 926 同点）。
//   缓存值：结果=正常(类型ID/0) 原样；错误(1)=已诊断拒绝（重复到达透传
//   错误(1) 不重报）。平行数组：已查下标节点1684=节点索引、
//   已查下标结果1684=正常(值)·错误(1)。
静态 向量<整64> 已查下标节点1684;
静态 向量<整64> 已查下标结果1684;   // >=0=正常(值)；-1=错误(已诊断)

// 标记并返回「此前未查」（真=首次·完整检查；假=重复·取缓存）
不安全 函数 标记下标检查1684(整64 节点索引) -> 布尔 {
    整64 i = 0;
    当 (i < 已查下标节点1684.大小()) {
        如果 (已查下标节点1684.元素(整32(i)) == 节点索引) { 返回 假; }
        i++;
    }
    结果<空类型, 整32> 加1684 = 已查下标节点1684.追加(节点索引);
    如果 (!加1684.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加果 = 已查下标结果1684.追加(0 - 2);
    如果 (!加果.正常) { 运行时错误(4); }   // -2=检查中哨兵（递归重入防御·不可达面）
    返回 真;
}

// 回写缓存结果（首次检查出口调用）
不安全 函数 登记下标结果1684(整64 节点索引, 整64 结果值) -> 空类型 {
    整64 i = 0;
    当 (i < 已查下标节点1684.大小()) {
        如果 (已查下标节点1684.元素(整32(i)) == 节点索引) {
            结果<空类型, 整32> 设果 = 已查下标结果1684.设置(整32(i), 结果值);
            如果 (!设果.正常) { 运行时错误(4); }
            返回;
        }
        i++;
    }
}

// 取缓存结果（重复到达·返回 结果<整64,整32>：正常(值)/错误(1)）
函数 取下标缓存1684(整64 节点索引) -> 结果<整64, 整32> {
    整64 i = 0;
    当 (i < 已查下标节点1684.大小()) {
        如果 (已查下标节点1684.元素(整32(i)) == 节点索引) {
            整64 值 = 已查下标结果1684.元素(整32(i));
            如果 (值 < 0) { 返回 错误(1); }   // 静默豁免业务值: 单边守卫早退——缓存哨兵 -1=已诊断拒绝（重复到达透传错误不重报），失败即显式返回
            返回 正常(值);
        }
        i++;
    }
    返回 错误(1);   // 不可达（先经 标记下标检查1684 判假才到）——显形面
}

不安全 函数 清空已查下标节点1684() -> 空类型 {
    已查下标节点1684.清空();
    已查下标结果1684.清空();
}

// #1684：数组**维长序列**（外→内）——"整32[2][3]" → [2,3]；"整32[5]" → [5]；
//   非数组 → 空序列。逐层数组长度文本（第一维）+ 数组元素文本（剥第一维）。
//   消费：状态登记声明（叶键面）+ 状态查读下标复合/状态写置位下标复合（叶号
//   线性化）——三消费点单一事实源防分叉。
函数 状态数组维长们(字符串 类型文本) -> 向量<整64> {
    向量<整64> 维长们 = 向量<整64>();
    字符串 剩余 = 字符串复制(类型文本);
    整64 守卫1684 = 0;
    当 (守卫1684 < 16) {
        守卫1684++;
        整64 维长 = 数组长度文本(剩余);
        // 静默豁免业务值: 单边守卫早退——非数组/长度不可求值=维序列终止（数组长度文本 miss 显形面），失败即显式返回
        如果 (维长 <= 0) { 返回 维长们; }   // 非数组/长度不可求值：序列到此为止
        结果<空类型, 整32> 加维 = 维长们.追加(维长);
        如果 (!加维.正常) { 运行时错误(4); }
        可选<字符串> 剩查 = 数组元素文本(剩余);
        如果 (!剩查.有值) { 返回 维长们; }   // '[' 形态不匹配（miss 显形）：序列止
        剩余 = 字符串复制(剩查.值);
    }
    返回 维长们;
}

// #1684：叶号区间计算核心（行主序线性化·读/写复合判定单一事实源）——
//   序列们=外→内层下标常量值（-1=非常量段·宿主 "[]" 段同构）；维长们=外→内。
//   正向（第一维=序列首段起）霍纳累计前缀叶号；首个非常量段（或序列耗尽而
//   维长未耗尽=尾维自由，如 m[1] 中间 place）起全部自由：自由乘积=该段起到
//   末段维长乘积。出口：叶号1684=前缀叶号 P、自由乘积=M——全常量时
//   M=1（叶号=完整叶号）；叶键区间=[P×M? 归约后 P 已含 ×M 前 乘积——出口
//   区间=[叶号, 叶号+M)。维长短于序列（不可达·语义层拦越维下标）取 1。
// #1684：叶号区间计算核心（行主序线性化·读/写复合判定单一事实源）——
//   序列们=**外→内**层下标常量值（-1=非常量段·宿主 "[]" 段同构；链基底沿
//   链下钻先遇最外层=最后一维，故序列末段=第一维）；维长们=**首→末维**
//   （数组文本剥层序·维长们[0]=第一维）。反向对齐：第 k 段（从第一维数·
//   k=0 起）取 序列们[段数-1-k] 与 维长们[k]，正向（第一维起）霍纳累计前缀
//   叶号；首个非常量段（或序列耗尽而维长未耗尽=尾维自由，如 m[1] 中间
//   place）起全部自由：自由乘积=该段起到末段维长乘积。出口：叶号1684=区间
//   基（全常量=完整叶号·非常量=前缀升权后基）、自由乘积=M（全常量=1）——
//   叶键区间=[叶号, 叶号+M)。维长短于序列（不可达·语义层拦越维下标）取 1。
函数 状态叶号区间1684(向量<整64>& 序列们, 向量<整64>& 维长们,
                    整64& 叶号1684, 整64& 自由乘积) -> 空类型 {
    叶号1684 = 0;
    自由乘积 = 1;
    布尔 有非常量1684 = 假;
    整64 段数1684 = 序列们.大小();
    整64 总段1684 = 段数1684;
    如果 (总段1684 < 整64(维长们.大小())) { 总段1684 = 维长们.大小(); }   // 尾维自由（m[1] 中间 place）
    整64 k1684 = 0;
    当 (k1684 < 总段1684) {
        // 第 k 段（从第一维数）：序列取反向（末段=第一维）、维长取正向
        整64 段值1684 = 0 - 1;
        如果 (k1684 < 段数1684) { 段值1684 = 序列们.元素(整32(段数1684 - 1 - k1684)); }
        整64 段维长1684 = 1;
        如果 (k1684 < 整64(维长们.大小())) { 段维长1684 = 维长们.元素(整32(k1684)); }
        // 静默豁免业务值: 单边哨兵判定——段值 -1=非常量下标段（解析链约定哨兵），非业务区间判定
        如果 (段值1684 < 0) { 有非常量1684 = 真; }
        如果 (!有非常量1684) { 叶号1684 = 叶号1684 * 段维长1684 + 段值1684; }
        如果 (有非常量1684) { 自由乘积 = 自由乘积 * 段维长1684; }
        k1684++;
    }
    如果 (有非常量1684) {
        // 前缀叶号升权：叶号当前=前段部分值，自由段起叶号区间=[叶号×M, (叶号+1)×M)
        叶号1684 = 叶号1684 * 自由乘积;
    } 否则 如果 (!有非常量1684) {
        自由乘积 = 1;   // 全常量=精确单叶（否则分支显式条件=全常量·else 新规）
    }
}

// #1684：读判定（下标链复合版·宿主 defInitCheckReadPlace 同构）——全常量=
//   行主序叶号精确查键（诊断合成实际 place 文本「m[1][2]」与宿主逐字）；含
//   非常量段=该段前缀区间扫描任一叶键在表=拒（保守·诊断「m[1][…]」宿主逐字）。
//   维长空（声明非数组·指针对象面）=维长缺省 1 退化（行为与旧单段函数逐位
//   等价：常量查键(1+v)/非常量单键区间扫）。
函数 状态查读下标复合(向量<映射<整64, 符号>>& 符号表, 整64 名ID,
                    向量<整64>& 序列们, 向量<整64>& 维长们,
                    向量<字符串>& 诊断) -> 空类型 {
    可选<整64> 层查 = 状态声明层(符号表, 名ID);
    如果 (!层查.有值) { 返回; }
    整64 层 = 层查.值;
    整64 叶号1684 = 0;
    整64 自由乘积 = 1;
    状态叶号区间1684(序列们, 维长们, 叶号1684, 自由乘积);
    // 静默豁免业务值: 单边守卫早退——叶号域界（1+叶号须<999999999 哨兵·登记面同界自洽），失败即显式返回
    如果 (叶号1684 + 自由乘积 > 999999999) { 返回; }   // 叶号域外=登记面未达（同界自洽）
    如果 (自由乘积 == 1) {
        // 精确读：查叶键（诊断 place=实际复合文本·宿主逐字）
        如果 (状态查键(状态构造键(层, 名ID, 1 + 叶号1684))) {
            表诊断(诊断, "[错误] 变量 '" + 状态合成place文本1684(名ID, 序列们, 0) +
                          "' 未初始化，不能读取（声明后须先赋值——Rust E0381 对照编译期拒绝）");
        }
        返回;
    }
    // 保守读：区间 [1+叶号, 1+叶号+M) 任一叶键在表=拒（宿主前缀扫描同构）
    整64 区间起1684 = 状态构造键(层, 名ID, 1 + 叶号1684);
    整64 i = 0;
    当 (i < 未初始化键们.大小()) {
        整64 键 = 未初始化键们.元素(整32(i));
        整64 后缀 = 回绕加64(键, 位模式取负474(区间起1684));
        如果 (键 >= 区间起1684 && 后缀 < 自由乘积) {
            表诊断(诊断, "[错误] 变量 '" + 状态合成place文本1684(名ID, 序列们, 1) +
                          "' 可能未初始化，不能读取（非常量下标按保守判定——Rust E0381 对照）");
            返回;
        }
        i++;
    }
}

// #1684：写置位（下标链复合版·宿主 defInitMarkInitPlace 同构）——全常量=
//   精确删叶键；首个非常量段=该段前缀区间全删（m[i][2] 写=整表置位、m[1][j]
//   写=第一维元素 1 置位——比旧「非常量即整体置位」窄=宿主前缀删对齐）。
//   序列空=调用方分流整体置位（语义检查赋值 写点·纯成员链面）。
函数 状态写置位下标复合(向量<映射<整64, 符号>>& 符号表, 整64 名ID,
                      向量<整64>& 序列们, 向量<整64>& 维长们) -> 空类型 {
    可选<整64> 层查 = 状态声明层(符号表, 名ID);
    如果 (!层查.有值) { 返回; }
    整64 层 = 层查.值;
    如果 (维长们.大小() == 0) {
        // 非数组声明（指针 p[i]/结构体字段链 t.两行[1]·登记面外）：退旧单段
        //   口径（常量=精确删键 miss·非常量=整体置位）——键面行为与退役的
        //   状态写置位下标 逐位一致（宿主登记面外=无键无操作·v2 剥星基名
        //   残留单键面的既有行为保持零变化）
        布尔 单常量段1684 = (序列们.大小() == 1 && 序列们.元素(0) >= 0);
        如果 (单常量段1684) {
            状态删键(状态构造键(层, 名ID, 1 + 序列们.元素(0)));
        } 否则 如果 (!单常量段1684) {
            // #1774 循环填充例外（001 §3.9）：非常量下标写=基数整体置位·外溢生效
            循环填充记基数(符号表, 名ID);
            状态删前缀(层, 名ID);   // 序列空/首段非常量=前缀整体置位（否则分支显式条件=取反·else 新规）
        }
        返回;
    }
    整64 叶号1684 = 0;
    整64 自由乘积 = 1;
    状态叶号区间1684(序列们, 维长们, 叶号1684, 自由乘积);
    // #1774 循环填充例外（001 §3.9）：含非常量段（≠1）=区间置位·基数外溢
    //   生效记录；全常量（=1·精确删单叶）不记录=循环外仍保守拒（1615 锁面）
    如果 (自由乘积 != 1) { 循环填充记基数(符号表, 名ID); }
    // 静默豁免业务值: 单边守卫早退——叶号域界（1+叶号须<999999999 哨兵·登记面同界自洽），失败即显式返回
    如果 (叶号1684 + 自由乘积 > 999999999) { 返回; }   // 叶号域外=登记面未达（同界自洽）
    // 删后缀 ∈ [1+叶号, 1+叶号+M)（M=1=精确删单键）
    整64 区间起1684 = 状态构造键(层, 名ID, 1 + 叶号1684);
    整64 i = 0;
    当 (i < 未初始化键们.大小()) {
        整64 键 = 未初始化键们.元素(整32(i));
        整64 后缀 = 回绕加64(键, 位模式取负474(区间起1684));
        如果 (键 >= 区间起1684 && 后缀 < 自由乘积) {
            状态删位(整32(i));
        } 否则 如果 (键 < 区间起1684 || 后缀 >= 自由乘积) {
            i++;   // 未命中区间=保留该键并前进（else 侧条件显式枚举·else 新规）
        }
    }
}

// #1684：复合 place 诊断文本合成——「名[1][2]」（全常量·精确读）/
//   「名[1][…]」（首个非常量段或缺失尾维截断·保守读·宿主
//   suffix.substr(0,dynIdx)+"[…]" 同构）。序列们=外→内（末段=第一维），
//   文本按 place 序（第一维在前）=**倒序**遍历序列。非常量模式=1：遇 -1 段
//   以「…]」收；序列全常量（自由=缺失尾维）末尾补「[…]」。
函数 状态合成place文本1684(整64 名ID, 向量<整64>& 序列们, 整64 非常量模式) -> 字符串 {
    字符串 place1684 = 字符串复制(驻留文本(名ID));
    整64 反向i1684 = 序列们.大小();
    当 (反向i1684 > 0) {
        反向i1684--;
        整64 段值1684 = 序列们.元素(整32(反向i1684));
        place1684 = place1684 + "[";
        // 静默豁免业务值: 单边哨兵判定——段值 -1=非常量段以「…]」收（place 文本合成约定），非业务区间判定
        如果 (非常量模式 == 1 && 段值1684 < 0) {
            place1684 = place1684 + "…]";
            返回 place1684;
        }
        place1684 = place1684 + 整数转字符串(段值1684) + "]";
    }
    如果 (非常量模式 == 1) { place1684 = place1684 + "[…]"; }
    返回 place1684;
}

// #1684：下标读判定**统一入口**（宿主 visitIndexExpr 数组分支 def-init 挂点
//   同构）——写目标语境/下标对象基语境双抑制（宿主 assignmentTargetDepth_>0
//   / inAddrBaseCtx_ 同款）；链基底复合解析（对象=标识符 一段·嵌套下标 全链）
//   + 链基声明类型剥维 + 状态查读下标复合。消费=检查下标表达式（94-a/259/
//   嵌套分支三站点单点化防分叉）。
函数 状态下标读判定复合1684(向量<节点> 池, 整32 节点索引,
                         向量<映射<整64, 符号>>& 符号表,
                         向量<字符串>& 诊断) -> 空类型 {
    如果 (状态读赋值目标中() || 状态读下标基语境1684()) { 返回; }
    整64 链基名 = 0;
    向量<整64> 序列们1684 = 向量<整64>();
    如果 (状态链基底(池, 节点索引, 链基名, 序列们1684) != 1) { 返回; }   // 调用返回/解引用基=无未初始化概念（宿主同口径）
    整64 声明类型1684 = 0;
    可选<整64> 声明类型查1684 = 表查找类型ID(符号表, 链基名);
    如果 (声明类型查1684.有值) { 声明类型1684 = 声明类型查1684.值; }
    向量<整64> 维长们1684 = 状态数组维长们(字符串复制(驻留文本(声明类型1684)));
    // 中间 place 跳过（#1684）：链下标段数 < 声明维数（如 m[1] 独立到达·
    //   区间遍历中间节点）=place 不完整——宿主对中间 place 的精确查键恒
    //   miss（键面=叶级）同果不报；判定只发生在最外层（段数=维数·place 完整）。
    // 静默豁免业务值: 容器非空守卫早退——段数<维数=中间 place 跳过（维数空=非数组面无判定·见上注），失败即显式返回
    如果 (序列们1684.大小() < 维长们1684.大小() && 维长们1684.大小() > 0) { 返回; }
    // #1774：取地址=初始化通道（001 §3.9·宿主 !inAddrOfCtx_ 守卫同语义）——
    //   &槽[i] 后的元素读放行（取址位置<本节点位·源序敏感）；通道生效即基数
    //   整体置位+循环体内记录（填充例外含取地址通道）
    如果 (状态取址放行(符号表, 链基名, 整64(节点索引))) { 返回; }
    状态查读下标复合(符号表, 链基名, 序列们1684, 维长们1684, 诊断);
}

// 链式左值基底解析（宿主 defInitPlaceOf 同构）：沿成员/下标链向下找基底
//   标识符；**下标序列**=链中各下标段常量值外→内收集（-1=非常量段——宿主
//   "[]" 段同构），空序列=链无下标（纯成员链）。返回 1=成功；0=不可解析
//   （调用返回/解引用基底）。
// #1684 复合化：原「首下标=首个（最外层）下标常量值」单值口径在嵌套 m[1][2]
//   下取到第二维（2）而键面=第一维粒度→写点置位错键（实证：m[1][2]=6 后读
//   m[1][2] 误报未初始化）。复合序列+叶级键面（状态登记声明/状态查读下标复合/
//   状态写置位下标复合）为宿主 defInitPlaceOf 完整 place 链的同构对齐。
函数 状态链基底(向量<节点> 池, 整32 索引, 整64& 名ID, 向量<整64>& 序列们) -> 整32 {
    整32 当前 = 索引;
    名ID = 0;
    整64 守卫 = 0;
    当 (守卫 < 64) {
        守卫++;
        节点 n = 池.元素(当前);
        如果 (n.类型 == 节点_标识符) {
            名ID = 整64(n.文本);
            返回 1;
        }
        如果 (n.类型 == 节点_成员) {
            // 静默豁免业务值: 单边守卫早退——子起点=0 即无父段（place 链终止哨兵·非业务区间判定）
            如果 (n.子起点 <= 0) { 返回 0; }
            当前 = 整32(n.子起点);
        } 否则 如果 (n.类型 == 节点_下标) {
            // 静默豁免业务值: 单边守卫早退——子起点=0 即无父段（place 链终止哨兵·非业务区间判定）
            如果 (n.子起点 <= 0) { 返回 0; }
            // 115：文本取值（附加 字段被 153-a 复用恒 0 不可作值源）；区间无
            //   下标表达式（子终点<=子起点+1·不可达形态）按非常量 -1 记
            整64 值q = 0 - 1;
            布尔 有常量值q = (n.子终点 > n.子起点 + 1 &&
                          取常量下标值(池, 整32(n.子起点 + 1), 整32(n.子终点), 值q));
            如果 (有常量值q) {
                结果<空类型, 整32> 加段 = 序列们.追加(值q);
                如果 (!加段.正常) { 运行时错误(4); }
            } 否则 如果 (!有常量值q) {
                // 常量下标取值失败/区间缺失段=记 -1（place 链哨兵·否则分支显式条件=取反·else 新规）
                结果<空类型, 整32> 加段负 = 序列们.追加(0 - 1);
                如果 (!加段负.正常) { 运行时错误(4); }
            }
            当前 = 整32(n.子起点);
                    // 静默豁免业务值: 三类型枚举兜尾守卫（其余节点类型=非常量模式·报错性终止非业务路径）
        } 否则 {
            返回 0;
        }
    }
    返回 0;
}
