// CN 自举编译器 v2 · 语义检查赋值左值（#1591 拆分·先拆再加）
// 职责：赋值左值检查族——自 语义检查赋值.cn 机械搬移（函数体逐字保留·
//   零语义变化·原文件 999 行贴 1000 硬红线）：检查标识符左值赋值（未声明/
//   常量/已转移/常量引用/静态写/B10/A2 借用收紧）+ 检查下标左值形态
//   （字符串下标只读/指针下标写/字段数组元素）。185-a 族子方法原样归位。
// 消费=语义检查赋值.检查赋值语句。导入面与源文件一致（同包各模块经合并
//   全局池解析）。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（目录包名）
导入 IR;         // 容器/结果 合成名判定 + 节点_*/键位移 常量（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 借出检查;    // 第七十七轮 A21：借出视图生命周期检查（函数级调用）
导入 语义检查逃逸;   // 435：lambda 引用捕获逃逸检查（赋值位·包内兄弟）

公开:   // 全文件公开（左值检查族供 语义检查赋值.检查赋值语句 消费）

// ==================== 185-a 族子方法（原 检查赋值语句 287~410 段） ====================

// 族①：标识符左值赋值检查（原 287~329 段）——未声明/常量/已转移/常量引用/
//   B10 可变静态变量写/A2 字符* 借用收紧。
// 返回=目标名未声明（#1926：调用方 检查赋值语句 据此抑制复合赋值合成读值份
//   的级联重查——宿主复合赋值位仅「赋值目标未声明」1 条）。
函数 检查标识符左值赋值(向量<节点> 池, 整32 节点索引, 节点 n,
                  向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 布尔 {
    布尔 左名未声明 = 假;
    如果 (n.文本 != 0) {
        整64 左类型 = 0;
        布尔 左类型有效 = 假;
        可选<整64> 左类型查 = 表查找类型ID(符号表, 整64(n.文本));
        如果 (左类型查.有值) {
            左类型 = 左类型查.值;
            左类型有效 = 真;
        }
        // 1007（002 OOP 波1·561 转批实测）：类内裸名静态字段回退——1022 波G
        //   语义回退覆盖 自增表达式位/语句位两处，复合赋值（+=/-=）左值同走
        //   本检查（检查标识符左值赋值·复合赋值脱糖后落标识符赋值）漏此=
        //   「赋值目标未声明: 总数」误拒（561 实录）。命中=类型=登记静态类型。
        // 1637：可选化双调用归并单局部（守卫+取值·映射读取幂等零行为差·
        //   形态对齐 语义检查 查当前检查类ID 消费点）
        可选<整64> 当前类写查 = 取当前检查类ID();
        如果 (!左类型查.有值 && 当前类写查.有值) {
            结果<整64, 整32> 查类写t = 查类静态字段类型(当前类写查.值, 整64(n.文本));
            如果 (查类写t.正常) {
                左类型 = 查类写t.值;
                左类型有效 = 真;
            } 否则 { }
        }
        // 434（类名::静态字段 限定写·#284 ::矩阵第五态）：限定复合名「类名::字段」
        //   回退——宿主 :: 与点号同语义折叠 MemberExpr（写位=AssignmentExpr 左值
        //   同通道·292 探针实锤），v2 复合文本在此取 查限定名静态字段类型 单点
        //   分派（B10 顶层静态写拦截不命中=类静态字段写非 B10 面·宿主同口径）。
        如果 (!左类型有效) {
            结果<整64, 整32> 限定类查434 = 查限定名静态字段类型(整64(n.文本));
            如果 (限定类查434.正常) {
                左类型 = 限定类查434.值;
                左类型有效 = 真;
            } 否则 { }
        }
        如果 (!左类型有效) {
            表诊断(诊断, "[错误] 赋值目标未声明: " + 驻留文本(整64(n.文本)));
            左名未声明 = 真;
        }
        // 缺陷②（2026-09-03 用户裁决立案）：常量初始化后不可修改（[03] 规范
        //   语义；宿主 isConstVarName 对齐）——顶层常量经 声明收集 登记为
        //   符号_常量，内层同名变量遮蔽时 表查找种类 命中内层=放行
        // #1678：局部 常量（修饰位=2）注册 符号_常量 后同受本执法点覆盖；
        //   诊断文本宿主逐字（semantic_expr_op.cpp 同款）
        可选<整64> 左种类查 = 表查找种类(符号表, 整64(n.文本));
        如果 (左种类查.有值 && 左种类查.值 == 符号_常量) {
            表诊断(诊断, "[错误] 不能给常量 '" + 驻留文本(整64(n.文本)) +
                              "' 赋值（常量初始化后不可修改）");
        }
        // 982 赋值复活（001 条文⑥·用户裁决甲·对齐宿主 981 同构）：**简单赋值**
        //   目标不再因已转移拒绝——写不读旧值=复活点（尾部 表标记转移 0 清位）；
        //   原「已转移不可作赋值目标」拦截随条文修正移除（复合赋值拦在下方
        //   复合合成标识符分支补挂）。
        // plans/019 阶段3（2026-09-10）：常量引用参数是只读借用——不可作赋值
        //   目标（宿主 currentConstRefParams_ 对齐；传可变/互斥面 v2 随实参
        //   边界记录另轮=诚实边界）
        如果 (是常量引用参数(整64(n.文本))) {
            表诊断(诊断, "[错误] 常量引用参数是只读借用，不能赋值: " +
                          驻留文本(整64(n.文本)));
        }
        // 155-a（B10 v2 挂点）：**可变静态变量写**（顶层静态赋值——与宿主 B10
        //   「静态变量写」同族；读安全=plans/023 §四 B10 的 CN 裁剪）。
        // 1337/1338（遮蔽写路径错位·P1）：加「非静态局部命中」豁免（命中非静态
        //   局部1337 单点判据）——普通局部/参数遮蔽全局时名字直查误拦合法局部
        //   直写（v2 面同样病·1456 v2 侧行 37 实证）；静态局部自身保持拦截。
        // 任务1864（f02/f03 锁面双侧对拍实录）：判据补 **函数内静态局部**
        //   （是静态局部名·480 名集合·赋值目标经解析层 865-a 静态名归一已统一
        //   改写为合成名）——修前只锁顶层静态，函数内 `静态 整32 计数 = 100;
        //   计数 = 计数 + 1;` 宿主拒「[安全区边界] 静态变量写应在 不安全 函数
        //   内（静态变量赋值）」v2 放行且运行真写（E2E 1006「静态写 不安全
        //   执法」立法在案·794 轮只修元素/成员写面漏标量直写面）；判据与自增
        //   位（语义检查中 480 挂点）/链式赋值（复合赋值 1613 挂点）全集合
        //   口径一致，不安全 函数内豁免（错误不安全边界 内建）。
        如果 ((是全局静态名(整64(n.文本)) || 是静态局部名(整64(n.文本))) &&
             !命中非静态局部(符号表, 整64(n.文本))) {
            错误不安全边界(诊断, "静态变量写", "静态变量赋值");
        }
        // 188-a（D6·plans/023 B11 变量常量传播）：赋值位恒空登记——候选=指针
        //   （指针变量表命中）或 字符串；RHS 形态分级（`无` 字面量=种子／标识符=
        //   传播边／其余〔复合赋值/调用/运算…〕=失格）
        布尔 恒空候选188 = 假;
        可选<整64> 恒空指针查188 = 查语义指针变量(整64(n.文本));
        如果 (恒空指针查188.有值) {
            恒空候选188 = 真;
        } 否则 如果 (左类型 == 驻留("字符串")) {
            恒空候选188 = 真;
        }
        如果 (恒空候选188 && n.子终点 > n.子起点 &&
              整64(n.子终点 - 1) < 池.大小()) {
            节点 恒空右a = 池.元素(n.子终点 - 1);
            如果 (恒空右a.类型 == 节点_整数字面量 && 恒空右a.附加 == 1) {
                登记恒空种子(整64(n.文本));
            } 否则 如果 (恒空右a.类型 == 节点_标识符) {
                登记恒空边(整64(n.文本), 整64(恒空右a.文本));
            } 否则 {
                登记恒空失格(整64(n.文本));
            }
        }
        // 548（编译期除零·常量传播）：赋值位零值登记（整数族·宿主
        //   visitAssignmentExpr noteZeroAssign 同构）——RHS 形态分级同 188-a
        //   （折叠零值=种子／标识符=传播边／其余=失格·登记零值右值548 单点
        //   分派）。v2 复合赋值经脱糖重析合成二元到达本位=右值为含目标自身的
        //   二元节点 → 折叠失败且非标识符 → 失格（`甲 += 0` 不误种子·宿主
        //   显式复合赋值失格分支同口径）。
        如果 (是整数类型文本548(字符串复制(驻留文本(左类型))) &&
             n.子终点 > n.子起点 && 整64(n.子终点 - 1) < 池.大小()) {
            登记零值右值548(池, 整64(n.文本), 整32(n.子终点 - 1), 符号表);
        }
        // plans/019 阶段4' A2（2026-09-11 方案甲）：赋值位字符* 借用收紧——
        //   字符串（拥有）变量赋值 字符* 调用返回（驻留文本/借用返回函数）
        //   须显式 字符串复制（与初始化位同款；借用→拥有显式）。
        如果 (左类型 == 驻留("字符串") && n.子终点 > n.子起点) {
            节点 赋值右末A2 = 池.元素(n.子终点 - 1);
            如果 (赋值右末A2.类型 == 节点_调用 && 赋值右末A2.子起点 >= 0) {
                节点 被调赋A2 = 池.元素(整32(赋值右末A2.子起点));
                可选<整64> 返型查赋A2 = 查函数返回类型(整64(被调赋A2.文本));
                // 任务1865：内置函数返回类型接通——查函数返回类型（用户函数表）
                //   miss 时查 IR 内置返回类型表（驻留文本 等内置返回 字符*·
                //   修前内置 miss=赋值面静默放行 vs 宿主 A2 赋值位拒=分叉）。
                如果 (!返型查赋A2.有值) {
                    返型查赋A2 = 内置函数返回类型ID(
                        字符串复制(驻留文本(整64(被调赋A2.文本))));
                }
                如果 (被调赋A2.类型 == 节点_标识符) {
                    如果 (返型查赋A2.有值) {
                        整64 返型赋A2 = 返型查赋A2.值;
                        如果 (返型赋A2 == 驻留("字符*")) {
                            表诊断(诊断, "[错误] 字符串（拥有）变量不能以字符* 借用视图隐式赋值——须 字符串复制(...) 显式落堆拥有化（借用→拥有显式；拥有→借用自动）");
                        }
                    }
                }
            }
        }
    }
    返回 左名未声明;
}

// 族②：下标左值形态检查（原 338~385 段）——字符串下标只读拒/指针下标写
//   （B10 挂点+数组对象豁免）/字段数组元素可写（97-a）。
函数 检查下标左值形态(向量<节点> 池, 节点 n, 节点 左值末,
                  向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
        如果 (左值末.类型 == 节点_下标) {
            布尔 是指针下标左值 = 假;
            // #1978：类内裸名静态**标量/其他非可写**字段下标左值——写面甄别
            //   命中后不叠 618 误报文案（「字符串下标只读」对整64=牛头不对马嘴）
            //   交读面既有拒（「下标对象须为字符串或指针」）——单条对齐宿主读面
            //   单条形态（visitIndexExpr 类型判定报错·写面无第二报）。
            布尔 裸名静态标量交读面 = 假;
            如果 (左值末.子起点 > 0) {
                节点 下标对象左 = 池.元素(整32(左值末.子起点));
                如果 (下标对象左.类型 == 节点_下标) {
                    // #1684（2026-10-26·嵌套下标读写全链）：下标对象=下标节点
                    //   （m[1][2] = 6 的内层 m[1]）——**无条件放行**：字符串写
                    //   执法面（字符串数组元素再下标 表[0][1] = x）已由检查
                    //   嵌套下标表达式1684 写语境单点拒（宿主 596 写面同构·
                    //   objectType 递归 checkExpr 的字符串分支），此处再判=
                    //   双报；数组面放行交 IR 左值链（生成下标左值成员下标
                    //   分支·链根重建既有通道）。
                    是指针下标左值 = 真;
                    返回;
                }
                如果 (下标对象左.类型 == 节点_标识符) {
                    // 259（2026-10-07·#259 静态数组）：顶层静态数组下标写放行
                    //   （对象类型=符号表静态登记·数组文本→按 157-a 数组对象同款
                    //   豁免；写安全=宿主「静态变量写不安全域」既有防线承担
                    //   ——检查赋值语句 B10 对 赋值文本=静态名 已报·下标元素写
                    //   与宿主口径一致=不安全 函数 内合法）。
                    可选<整64> 静对象声明类型查 = 表查找类型ID(符号表, 整64(下标对象左.文本));
                    如果 (静对象声明类型查.有值 &&
                         是数组类型文本(驻留文本(静对象声明类型查.值))) {
                        是指针下标左值 = 真;
                        返回;
                    }
                    可选<整64> 查左指针查 = 查语义指针变量(整64(下标对象左.文本));
                    // #1992（2026-11-03·1103 采样轮）：类字段指针下标写回退——
                    //   构造器/成员函数内裸字段名（整32* p 字段的 p[0] = v）经
                    //   登记类字段符号 进局部符号表（类型文本=「整32*」），不入
                    //   语义指针变量表 → 查语义指针变量 miss → 原落 618 判定：
                    //   基座类型非字符串 → 既有短文「下标左值赋值未支持（字符串
                    //   下标只读）」误拒+诊断错位（宿主 checkIndexMemberAssign-
                    //   Target 同点位 lookupVar+isPointer 报「指针下标写」不安全
                    //   边界·不安全 函数 内豁免绿=x_x2 实录分叉）。回退=符号表
                    //   登记类型文本尾星判定（读位 947 剥尾星同源口径），命中=
                    //   并入下方指针下标写路径（数组豁免/A2 面同款逐字）；
                    //   数组文本字段已由 259 豁免分支先行放行不达此处；字符串
                    //   字段（尾星=0）不命中 → 618 长文拒绝语义保持不变。
                    // （#1978 重放合并：本回退**先判**——局部符号表登记的指针
                    //   字段命中即置 查左指针查=某些(...)，短路下方静态字段分流
                    //   的 `!查左指针查.有值` 条件；两回退符号源不同=表查找类型ID
                    //   （局部符号表）vs 查类静态字段类型（类静态字段表·沿基类链）
                    //   ——指针字段不被静态分流吞并·静态字段不落尾星判定·互不吞并）
                    如果 (!查左指针查.有值) {
                        可选<整64> 字段登记类型左查 = 表查找类型ID(符号表,
                                                        整64(下标对象左.文本));
                        如果 (字段登记类型左查.有值 &&
                             是指针类型文本(字符串复制(驻留文本(字段登记类型左查.值)))) {
                            查左指针查 = 某些(字段登记类型左查.值);
                        }
                    }
                    // #1978（#1445 第二形态·语义写面对称）：类内裸名静态字段
                    //   下标左值——局部符号表 miss（裸名非变量·修前落 618 误报
                    //   「字符串下标只读」=合法程序被拒，#1882 只修类外全名通道
                    //   漏类内裸名预置通道）+指针 miss 后查类静态字段类型（当前
                    //   检查类·沿基类链=继承面同覆盖·与族① 1007/读面 #1445 回退
                    //   同源口径）。三分流穷举合法形态：
                    //   ①数组文本 → 放行（IR 写侧 生成下标左值标识符分支 259 段
                    //     经 查静态序号含类 1007 回退发射·与顶层静态数组同款）；
                    //   ②字符串 → 不放行（618·112 甲正当拒——618 基座判定本轮
                    //     补全后=全文案带尾与宿主同串）；
                    //   ③标量/其他 → 交读面拒（读面 检查下标表达式 #1445 回退后
                    //     既有报「下标对象须为字符串或指针」——写面不再叠误报）。
                    // （#1978 重放合并：**判于 #1992 回退之后**——裸名静态字段
                    //   不入局部符号表，上方 回退的 表查找类型ID 同表必 miss
                    //   → 查左指针查 保持 miss → 本条件三项全真进入；类内裸名
                    //   静态数组命中置 是指针下标左值=真 但 查左指针查 仍 miss
                    //   → 不进下方指针段（无 A2 不安全边界报·数组放行语义不变））
                    可选<整64> 当前类裸查 = 取当前检查类ID();
                    如果 (!静对象声明类型查.有值 && !查左指针查.有值 && 当前类裸查.有值) {
                        结果<整64, 整32> 裸静字段查 = 查类静态字段类型(
                            当前类裸查.值, 整64(下标对象左.文本));
                        如果 (裸静字段查.正常) {
                            字符串 裸静类型文 = 字符串复制(驻留文本(裸静字段查.值));
                            布尔 裸静是数组 = 是数组类型文本(裸静类型文);
                            布尔 裸静是字符串 = 字符串比较(裸静类型文, "字符串");
                            // ①数组 → 放行（与顶层静态数组 259 同款）
                            如果 (裸静是数组) {
                                是指针下标左值 = 真;
                            }
                            // ②字符串 → 无动作（保持 !是指针下标左值 落 618 段
                            //   正当拒·112 甲；带尾全文案由 618 基座判定补全）
                            // ③标量/其他 → 标量态交读面（读面既有拒单条对齐）
                            如果 (!裸静是数组 && !裸静是字符串) {
                                裸名静态标量交读面 = 真;
                            }
                        } 否则 {
                        }
                    }
                    如果 (查左指针查.有值) {
                        是指针下标左值 = 真;
                        // 155-a（A2 v2 挂点）：**裸指针下标写**（p[i] = x 经裸指针
                        //   偏移写=可越界；与宿主 A2「指针下标写」同族——读面由
                        //   B8 在 检查下标表达式 单报，此处写面无重复）
                        // 157-a（收口前置缺陷修复，253 双编译对照实证）：**数组
                        //   对象豁免**——栈数组下标写（整32[3] 表; 表[0] = 10）是
                        //   安全操作（宿主 A2 已豁免；v2 缺失=155-a 误报）。判定
                        //   与 B8 数组豁免同款（声明类型文本是数组）。
                        布尔 数组对象左 = 假;
                        可选<整64> 对象声明类型左查 = 表查找类型ID(符号表,
                                                        整64(下标对象左.文本));
                        如果 (对象声明类型左查.有值) {
                            如果 (是数组类型文本_ID(对象声明类型左查.值)) {
                                数组对象左 = 真;
                            }
                        }
                        如果 (!数组对象左) {
                            // #1868：明细改「变量名[i] = ...」（宿主
                            //   semantic_expr_op.cpp checkIndexMemberAssignTarget
                            //   同构=对象名+[i] = ...；修前传硬编码「指针下标写
                            //   （p[i] = ...）」被 错误不安全边界 再包类别层=
                            //   「指针下标写（指针下标写（…））」重复前缀）
                            错误不安全边界(诊断, "指针下标写",
                                           驻留文本(整64(下标对象左.文本)) + "[i] = ...");
                        }
                    }
                } 否则 如果 (下标对象左.类型 == 节点_成员) {
                    // 97-a（2026-09-13 第九十七轮 C8）：结构体**字段数组**元素下标
                    //   左值（r.分数[0] = v；嵌套链 t.两行[1].分数[2] = v）——字段
                    //   类型可判定且**非数组**时拒绝（字符串字段下标仍只读=既有语义）；
                    //   不可判定（嵌套成员链 推导成员类型ID 面外）放行交 IR 层判定
                    //   （IR 推导下标元素类型ID=0 即「下标左值对象未支持」可见失败——
                    //   半实现纪律：不放行静默，只是判定点后移）
                    布尔 可写97 = 真;
                    // #1912：静默包装（诊断吞弃 + 去重标零副作用）
                    可选<整64> 字段类型左97查 = 静默推导成员类型(池, 整32(左值末.子起点),
                                                        符号表);
                    整64 字段类型左97 = 0;
                    如果 (字段类型左97查.有值) { 字段类型左97 = 字段类型左97查.值; }
                    // #1882（#1445 第二形态·语义写面）：成员推导 miss 且成员基座=
                    //   用户类名（`类名.静态字段[i] = v` 形态）→ 查类静态字段类型
                    //   （沿基类链·#1445 口径）——命中=**字符串** → 不可写（落下方
                    //   618 拒·112 甲同文案）。原推导 miss 恒放行=落 IR 层「下标左
                    //   值对象未支持」显错中止（层次分叉：宿主语义层拒/文案同 618）。
                    //   数组命中不在此扩（静态数组元素写=本任务放行面·可写97 保持
                    //   真）；未命中（真非静态字段）=既有半实现纪律放行交 IR 判定。
                    // 池索引双边界闭区间（单边禁令·1739 同款）：子起点 ∈ [1, 池大小)
                    如果 (!字段类型左97查.有值 && 下标对象左.类型 == 节点_成员 &&
                         下标对象左.子起点 >= 1 &&
                         下标对象左.子起点 < 整32(池.大小())) {
                        // 基座=成员节点的对象（`类名.字段` 的 类名 标识符）
                        节点 类名基座 = 池.元素(整32(下标对象左.子起点));
                        如果 (类名基座.类型 == 节点_标识符 &&
                             是用户类_ID(整64(类名基座.文本))) {
                            结果<整64, 整32> 基座静态字段查 = 查类静态字段类型(
                                整64(类名基座.文本), 整64(下标对象左.文本));
                            如果 (基座静态字段查.正常) {
                                如果 (字符串比较(字符串复制(驻留文本(基座静态字段查.值)), "字符串")) {
                                    可写97 = 假;
                                }
                            } 否则 {
                            }
                        }
                    }
                    如果 (字段类型左97 > 0) {
                        字符串 字段文本左97 = 字符串复制(驻留文本(字段类型左97));
                        // #1666：字段**指针**元素可写（`架.针[i] = v`）——原判定
                        //   只放行字段数组、指针字段落 618 拒面误报「字符串下标
                        //   只读」；宿主 checkIndexMemberAssignTarget 对成员基座
                        //   的指针下标写放行（A2 仅标识符指针对象告警）同口径。
                        布尔 数组字段97 = 是数组类型文本(字段文本左97);
                        布尔 指针字段97 = 尾星数615(字段文本左97) != 0;
                        如果 (!数组字段97 && !指针字段97) { 可写97 = 假; }
                    }
                    如果 (可写97) { 是指针下标左值 = 真; }
                }
            }
            如果 (!是指针下标左值) {
                // #1978：裸名静态标量/其他非可写形态——交读面（读面既有报
                //   「下标对象须为字符串或指针」）写面不叠 618 文案
                如果 (裸名静态标量交读面) { 返回; }
                // 618（910/596 执法面收口·双侧逐字同文）：字符串基对象下标左值
                //   ——诊断正文对齐宿主 910（标识符形态·带 : s[i] = ... 尾巴）与
                //   596（非标识符形态·无尾巴）。字符串判定=标识符基座（表类型=
                //   字符串）/字符串字面量基座/成员基座（推导类型=字符串）；判定
                //   不出（诚实边界·类型推导面外）保持存量短文不动（语义仍拒）。
                布尔 基座是字符串 = 假;
                布尔 诊断带尾 = 假;
                字符串 诊断基座名 = "";
                如果 (左值末.子起点 > 0) {
                    节点 基座节点 = 池.元素(整32(左值末.子起点));
                    如果 (基座节点.类型 == 节点_标识符) {
                        可选<整64> 基座声明类型查 = 表查找类型ID(符号表, 整64(基座节点.文本));
                        如果 (基座声明类型查.有值 && 基座声明类型查.值 == 驻留("字符串")) {
                            基座是字符串 = 真;
                            诊断带尾 = 真;
                            诊断基座名 = 字符串复制(驻留文本(整64(基座节点.文本)));
                        }
                        // #1978：类内裸名静态**字符串**字段基座——局部符号表 miss
                        //   后查类静态字段类型（对称 #1882 成员基座判定·沿基类链）
                        //   命中=字符串 → 618 全文案带尾（宿主 910 类内探针同串
                        //   「: 名[i] = ...」）。
                        如果 (!基座声明类型查.有值) {
                            可选<整64> 当前类基查 = 取当前检查类ID();
                            如果 (当前类基查.有值) {
                                结果<整64, 整32> 基静字段查 = 查类静态字段类型(
                                    当前类基查.值, 整64(基座节点.文本));
                                如果 (基静字段查.正常) {
                                    如果 (字符串比较(字符串复制(驻留文本(基静字段查.值)), "字符串")) {
                                        基座是字符串 = 真;
                                        诊断带尾 = 真;
                                        诊断基座名 = 字符串复制(驻留文本(整64(基座节点.文本)));
                                    }
                                } 否则 {
                                }
                            }
                        }
                    } 否则 如果 (基座节点.类型 == 节点_字符串字面量) {
                        基座是字符串 = 真;
                    } 否则 如果 (基座节点.类型 == 节点_成员) {
                        // #1912：静默包装（诊断吞弃 + 去重标零副作用）
                        可选<整64> 基座类型查 = 静默推导成员类型(池, 整32(左值末.子起点),
                                                            符号表);
                        如果 (基座类型查.有值 && 基座类型查.值 == 驻留("字符串")) {
                            基座是字符串 = 真;
                        }
                        // #1882（#1445 第二形态·语义写面）：成员基座=用户类名且静默
                        //   推导 miss——查类静态字段类型（沿基类链）命中=字符串 →
                        //   618 全文案（与实例字符串字段/字符串变量同口径·宿主
                        //   checkIndexMemberAssignTarget 112 甲同拒）。
                        // 池索引双边界闭区间（单边禁令·1739 同款）：子起点 ∈ [1, 池大小)
                        如果 (!基座类型查.有值 && 基座节点.子起点 >= 1 &&
                             基座节点.子起点 < 整32(池.大小())) {
                            节点 成员基座对象 = 池.元素(整32(基座节点.子起点));
                            如果 (成员基座对象.类型 == 节点_标识符 &&
                                 是用户类_ID(整64(成员基座对象.文本))) {
                                结果<整64, 整32> 基座静态字段类型查 = 查类静态字段类型(
                                    整64(成员基座对象.文本), 整64(基座节点.文本));
                                如果 (基座静态字段类型查.正常) {
                                    如果 (字符串比较(字符串复制(驻留文本(基座静态字段类型查.值)), "字符串")) {
                                        基座是字符串 = 真;
                                    }
                                } 否则 {
                                }
                            }
                        }
                    }
                }
                如果 (基座是字符串) {
                    如果 (诊断带尾) {
                        表诊断(诊断, "[错误] 下标左值赋值未支持（字符串下标只读）——字符串为不可变拥有型，原地修改请用 字符 数组或不安全区指针（112 甲）: " + 诊断基座名 + "[i] = ...");
                    } 否则 {
                        表诊断(诊断, "[错误] 下标左值赋值未支持（字符串下标只读）——字符串为不可变拥有型，原地修改请用 字符 数组或不安全区指针（112 甲）");
                    }
                } 否则 {
                    表诊断(诊断, "[错误] 下标左值赋值未支持（字符串下标只读）");
                }
            }
        }
}
