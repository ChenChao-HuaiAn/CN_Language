// CN 自举编译器 v2 · 语义检查——运算符重载面（#414·宿主三族同构·审查修复轮）
// 对齐宿主：semantic_expr_binary.cpp checkClassOperatorOverload（二元决议·
//   算术五算子+比较六算子拦截集）/ semantic_expr_unary.cpp
//   checkUnaryOperatorOverload+visitUnaryExpr 内置面 / class_resolver_access.cpp
//   resolveOperatorOverload（左操作数类型沿继承链查成员·参数个数与类型校验）。
// 重载决议顺序（001 §4.6）：① 优先精确匹配内置运算符（调用方既有守卫在前，
//   顺序不变）；② 无内置匹配时按左操作数类型查成员「运算符X」——本文件职责；
//   ③ 仍无匹配报「类型不兼容」——二元面由 检查二元运算表达式 的左类未命中
//   分支报宿主同文案（P1-2），一元面由 检查一元重载使用点 报宿主内置文案。
// 使用点两道校验（P0-2·宿主 resolveOperatorOverload 逐字同构）：
//   个数（「重载期望 N 个右操作数，实际提供 M 个」·不符仍按命中返回返回类型=
//   宿主 return mi 防级联）+右操作数隐式转换（「第 i 个右操作数无法将 'A'
//   隐式转换为 'B'」·复用 隐式转换合法 谓词）。个数/类型校验仅挂权威诊断面
//   （检查二元运算表达式/检查表达式·语句遍历单遍单报）；推导面
//   （推导二元类型ID/表达式类型ID）静默命中即返回（174 教训：二次推导诊断吞弃）。
// 方法名约定：类体解析层组合名「运算符X」（语法/解析类.cn 组合运算符重载名或
//   拒绝·放行），语义收集（语义分析尾 收集类方法）按普通方法登记 → 类方法表
//   方法名=「运算符X」；单目 0 右参、双目 1 右参（收集侧 241-a 对齐校验）。
// P0-3（审查·分叉消解）：~ 表达式解析层不再脱糖（原 x^(0-1) 下沉至 IR 生成层
//   未命中展开）——树中 节点_位非 恢复出现，类「运算符~」命中走重载面、未命中
//   走宿主内置文案（「'~'按位非要求整数操作数」），定义/使用两侧一致。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_* 常量与 Token
导入 IR;         // 是用户类ID/查类方法定义层/查类方法返回/查类方法参数串/参数段个数/取参数段
导入 协议常量;   // 驻留/驻留文本（中立层）

公开:

// 二元重载决议拦截集（宿主 checkClassOperatorOverload opSym 映射同款——位运算
//   五算子不在宿主 IR operatorSymText 映射面=类位运算走内置守卫拒，对齐不扩权）
函数 是二元重载符号(字符串 op名) -> 布尔 {
    返回 字符串比较(op名, "+") || 字符串比较(op名, "-") ||
          字符串比较(op名, "*") || 字符串比较(op名, "/") ||
          字符串比较(op名, "%") || 字符串比较(op名, "==") ||
          字符串比较(op名, "!=") || 字符串比较(op名, "<") ||
          字符串比较(op名, ">") || 字符串比较(op名, "<=") ||
          字符串比较(op名, ">=");
}

// 二元重载命中与返回类型推导（重载决议顺序②·静默面）：左操作数末端类型为
//   用户类 且沿继承链命中成员「运算符X」→ 返回重载方法返回类型名ID（宿主
//   lastType_ = mi->type 同构）；未命中/推导不可靠面返回 -1（调用方回退既有
//   路径——诚实边界同纪律）。索引口径（970）：子起点=左操作数起点、附加=
//   右操作数起点 → 左末端=附加-1、右末端=节点索引-1。
函数 二元重载返回ID(向量<节点> 池, 整32 节点索引,
                  向量<映射<整64, 符号>>& 符号表) -> 整64 {
    节点 n = 池.元素(节点索引);
    字符串 op名 = 字符串复制(驻留文本(整64(n.文本)));
    如果 (!是二元重载符号(op名)) { 返回 -1; }
    如果 (n.附加 <= 0 || n.附加 > 整32(池.大小())) { 返回 -1; }
    // 418 预验红根治：左末端推导用 推导源类型ID静默（可靠面·标识符/字面量/
    //   成员/枚举/比较短路——不递归二元复合面）。原 表达式类型ID 递归放大：
    //   前置重载分支×原左右递归=子树双遍·深嵌套编译指数爆炸（418 600s 超时
    //   实测·禁用前置即恢复）。可靠面外=不判定（诚实边界·与 411 同纪律）；
    //   链式 (甲+乙)+丙 的重载命中由生成层 解析重载节点类型ID 递归覆盖。
    整64 左ID = 推导源类型ID静默(池, 整32(n.附加) - 1, 符号表);
    如果 (左ID <= 0 || !是用户类ID(左ID)) { 返回 -1; }
    整64 方法名ID = 整64(驻留("运算符" + op名));
    整64 定义层 = 查类方法定义层(左ID, 方法名ID);
    如果 (定义层 == 0) { 返回 -1; }
    返回 查类方法返回(定义层, 方法名ID);
}

// 一元重载命中与返回类型推导（宿主 checkUnaryOperatorOverload 同构·静默面）：
//   单目集 = - ! ~（P0-3 起树中 恢复 节点_位非）。操作数末端 = 子终点-1。
//   命中返回重载方法返回类型名ID；否则 -1。
函数 一元重载返回ID(向量<节点> 池, 整32 节点索引,
                  向量<映射<整64, 符号>>& 符号表) -> 整64 {
    节点 n = 池.元素(节点索引);
    字符串 op名 = "";
    如果 (n.类型 == 节点_负号) { op名 = "-"; }
    否则 如果 (n.类型 == 节点_逻辑非) { op名 = "!"; }
    否则 如果 (n.类型 == 节点_位非) { op名 = "~"; }
    否则 { 返回 -1; }
    如果 (n.子终点 <= n.子起点 || n.子终点 > 整32(池.大小())) { 返回 -1; }
    整64 操作数ID = 推导源类型ID静默(池, 整32(n.子终点) - 1, 符号表);
    如果 (操作数ID <= 0 || !是用户类ID(操作数ID)) { 返回 -1; }
    整64 方法名ID = 整64(驻留("运算符" + op名));
    整64 定义层 = 查类方法定义层(操作数ID, 方法名ID);
    如果 (定义层 == 0) { 返回 -1; }
    返回 查类方法返回(定义层, 方法名ID);
}

// P0-2（审查·宿主 resolveOperatorOverload 逐字同构）：二元重载使用点两道校验
//   ——个数（期望 N/实际 1·不符仍按命中返回返回类型=宿主 return mi 防级联）+
//   右操作数隐式转换（隐式转换合法 谓词·源检不出放行=诚实边界·文案逐字对齐）。
//   未命中返回 -1（不兼容诊断由 411 守卫面左类未命中分支负责·P1-2）。
//   权威诊断面专用（检查二元运算表达式·语句遍历单遍单报）。
函数 检查二元重载使用点(向量<节点> 池, 整32 节点索引,
                    向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    字符串 op名 = 字符串复制(驻留文本(整64(n.文本)));
    如果 (!是二元重载符号(op名)) { 返回 -1; }
    如果 (n.附加 <= 0 || n.附加 > 整32(池.大小())) { 返回 -1; }
    整64 左ID = 推导源类型ID静默(池, 整32(n.附加) - 1, 符号表);
    如果 (左ID <= 0 || !是用户类ID(左ID)) { 返回 -1; }
    整64 方法名ID = 整64(驻留("运算符" + op名));
    整64 定义层 = 查类方法定义层(左ID, 方法名ID);
    如果 (定义层 == 0) { 返回 -1; }
    整64 返回ID414 = 查类方法返回(定义层, 方法名ID);
    // 第一道：参数个数（宿主 paramTypes.size() != rightArgTypes.size() 同构——
    //   参数串段数=右参数个数，不含 this）
    整64 参数串ID = 查类方法参数串(定义层, 方法名ID);
    字符串 参数串 = "";
    如果 (参数串ID != 0) { 参数串 = 字符串复制(驻留文本(参数串ID)); }
    整64 期望 = 参数段个数(参数串);
    如果 (期望 != 1) {
        表诊断(诊断, "[错误] 运算符 '" + op名 + "' 重载期望 " + 整数转字符串(期望) +
                    " 个右操作数，实际提供 1 个");
        返回 返回ID414;
    }
    // 第二道：右操作数隐式转换（宿主 canConvertType(右, 参数) 同构——
    //   复用 隐式转换合法（池末端索引·目标类型ID 谓词·字面量值域同款纪律）；
    //   右类型检不出（≤0）放行=诚实边界 55-c 同款）
    整64 右末端索引 = 整32(节点索引) - 1;
    整64 右ID = 推导源类型ID静默(池, 整32(右末端索引), 符号表);
    如果 (右ID > 0) {
        字符串 段文本 = 取参数段(参数串, 0);
        整64 参数类型ID = 整64(驻留(段文本));
        如果 (参数类型ID > 0 &&
             !隐式转换合法(池, 整32(右末端索引), 参数类型ID, 符号表)) {
            表诊断(诊断, "[错误] 运算符 '" + op名 + "' 第 1 个右操作数无法将 '" +
                        驻留文本(右ID) + "' 隐式转换为 '" + 段文本 + "'");
        }
    }
    返回 返回ID414;
}

// P0-2（审查·宿主 checkUnaryOperatorOverload 个数校验+visitUnaryExpr 内置面
//   同构）：一元重载使用点校验（权威诊断面·检查表达式 挂点）。
//   命中（类有「运算符X」）：个数校验（单目期望 0 右参·不符诊断仍返回返回
//   类型=宿主 return mi 同构）。
//   未命中：宿主落内置校验——v2 既有诚实边界=一元内置面无操作数校验（负号/
//   逻辑非对非类操作数维持放行·独立缺口不在本面扩）；**类操作数未命中**报
//   宿主逐字文案（P0-3 的「定义侧放行使用侧必拒」矛盾在此消解）；
//   位非面全量校验（原脱糖 x^(0-1) 走 ^ 位守卫拒浮点·下沉后本函数接管=零回归）。
//   返回：命中=重载返回类型；未命中=位非/负号→操作数类型（宿主 lastType_=
//   operandType）、逻辑非→布尔；检不出=-1。
函数 检查一元重载使用点(向量<节点> 池, 整32 节点索引,
                    向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    字符串 op名 = "";
    如果 (n.类型 == 节点_负号) { op名 = "-"; }
    否则 如果 (n.类型 == 节点_逻辑非) { op名 = "!"; }
    否则 如果 (n.类型 == 节点_位非) { op名 = "~"; }
    否则 { 返回 -1; }
    如果 (n.子终点 <= n.子起点 || n.子终点 > 整32(池.大小())) { 返回 -1; }
    整64 操作数末端 = 整32(n.子终点) - 1;
    整64 操作数ID = 推导源类型ID静默(池, 整32(操作数末端), 符号表);
    整64 方法名ID = 整64(驻留("运算符" + op名));
    如果 (操作数ID > 0 && 是用户类ID(操作数ID)) {
        整64 定义层 = 查类方法定义层(操作数ID, 方法名ID);
        如果 (定义层 != 0) {
            // 命中：个数校验（单目期望 0 个右操作数）
            整64 返回ID414 = 查类方法返回(定义层, 方法名ID);
            整64 参数串ID = 查类方法参数串(定义层, 方法名ID);
            字符串 参数串 = "";
            如果 (参数串ID != 0) { 参数串 = 字符串复制(驻留文本(参数串ID)); }
            整64 期望 = 参数段个数(参数串);
            如果 (期望 != 0) {
                表诊断(诊断, "[错误] 运算符 '" + op名 + "' 重载期望 " + 整数转字符串(期望) +
                            " 个右操作数，实际提供 0 个");
            }
            返回 返回ID414;
        }
        // 未命中（类操作数）：宿主内置校验逐字同构（类操作数形态限定——
        //   非类操作数维持 v2 一元内置面既有放行=独立缺口不扩线）
        字符串 类文本414 = 字符串复制(驻留文本(操作数ID));
        如果 (n.类型 == 节点_负号) {
            表诊断(诊断, "[错误] 一元负号要求数值操作数，实际为 '" + 类文本414 + "'");
            返回 操作数ID;
        }
        如果 (n.类型 == 节点_逻辑非) {
            表诊断(诊断, "[错误] '!'逻辑非要求布尔操作数，实际为 '" + 类文本414 + "'");
            返回 驻留("布尔");
        }
        表诊断(诊断, "[错误] '~'按位非要求整数操作数，实际为 '" + 类文本414 + "'");
        返回 操作数ID;
    }
    // 位非面全量整数校验（宿主 Tilde 内置同构——原脱糖 x^(0-1) 的 ^ 位守卫
    //   拒浮点语义由本分支接管；操作数可靠推导非整数=拒·检不出放行）
    如果 (n.类型 == 节点_位非 && 操作数ID > 0) {
        字符串 操作数文本 = 字符串复制(驻留文本(操作数ID));
        布尔 是整数面414 = 字符串比较(操作数文本, "整8") ||
                      字符串比较(操作数文本, "整16") ||
                      字符串比较(操作数文本, "整32") ||
                      字符串比较(操作数文本, "整64") ||
                      字符串比较(操作数文本, "整128") ||
                      字符串比较(操作数文本, "正8") ||
                      字符串比较(操作数文本, "正16") ||
                      字符串比较(操作数文本, "正32") ||
                      字符串比较(操作数文本, "正64") ||
                      字符串比较(操作数文本, "正128");
        如果 (!是整数面414) {
            表诊断(诊断, "[错误] '~'按位非要求整数操作数，实际为 '" + 操作数文本 + "'");
        }
    }
    如果 (n.类型 == 节点_逻辑非) { 返回 驻留("布尔"); }
    如果 (操作数ID > 0) { 返回 操作数ID; }
    返回 -1;
}
