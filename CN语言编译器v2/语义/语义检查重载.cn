// CN 自举编译器 v2 · 语义检查——运算符重载面（#414·宿主三族同构）
// 对齐宿主：semantic_expr_binary.cpp checkClassOperatorOverload（二元决议·
//   算术五算子+比较六算子拦截集）/ semantic_expr_unary.cpp
//   checkUnaryOperatorOverload（单目 ! ~ -）/ class_resolver_access.cpp
//   resolveOperatorOverload（左操作数类型沿继承链查成员·参数个数与类型校验）。
// 重载决议顺序（001 §4.6）：① 优先精确匹配内置运算符（调用方既有守卫在前，
//   顺序不变）；② 无内置匹配时按左操作数类型查成员「运算符X」——本文件职责；
//   ③ 仍无匹配报「类型不兼容」——由调用方既有数值/位守卫兜底（类类型未命中
//   重载 = 不豁免守卫 = 照旧诊断），本文件不重复报错。
// 方法名约定：类体解析层组合名「运算符X」（语法/解析类.cn 组合运算符重载名或
//   拒绝·放行），语义收集（语义分析尾 收集类方法）按普通方法登记 → 类方法表
//   方法名=「运算符X」；单目 0 右参、双目 1 右参（收集侧 241-a 对齐校验）。
// v2 边界：~ 表达式解析期已脱糖为 x ^ (0-1)（解析层 位非脱糖）——树中无
//   节点_位非，类 ~ 重载面随脱糖机制走 ^ 内置（与宿主分叉·随重载树完善收口）。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_* 常量与 Token
导入 IR;         // 是用户类ID/查类方法定义层/查类方法返回（类表）
导入 协议常量;   // 驻留/驻留文本（中立层）

公开:

// 二元重载决议拦截集（宿主 checkClassOperatorOverload opSym 映射同款——位运算
//   五算子不在宿主 IR operatorSymText 映射面=类位运算走内置守卫拒，对齐不扩权）
函数 是二元重载符号(字符串 op名) -> 布尔 {
    返回 字符串比较(op名, "+") || 字符串比较(op名, "-") ||
          字符串比较(op名, "*") || 字符串比较(op名, "/") ||
          字符串比较(op名, "%") || 字符串比较(op名, "==") ||
          字符串比较(op名, "!=") || 字符串比较(op名, "<") ||
          字符串比较(op名, ">") || 字符串比较(op名, "<=") ||
          字符串比较(op名, ">=");
}

// 二元重载命中与返回类型推导（重载决议顺序②）：左操作数末端类型为用户类 且
//   沿继承链命中成员「运算符X」→ 返回重载方法返回类型名ID（宿主 lastType_ =
//   mi->type 同构）；未命中/推导不可靠面返回 -1（调用方回退既有路径——诚实
//   边界同纪律）。索引口径（970）：子起点=左操作数起点、附加=右操作数起点 →
//   左末端=附加-1、右末端=节点索引-1（右操作数类型不参与查找——宿主同款按
//   左操作数决议，参数类型校验面=收集侧与生成层实参匹配管辖）。
函数 二元重载返回ID(向量<节点> 池, 整32 节点索引,
                  向量<映射<整64, 符号>>& 符号表) -> 整64 {
    节点 n = 池.元素(节点索引);
    字符串 op名 = 字符串复制(驻留文本(整64(n.文本)));
    如果 (!是二元重载符号(op名)) { 返回 -1; }
    如果 (n.附加 <= 0 || n.附加 > 整32(池.大小())) { 返回 -1; }
    向量<字符串> 静默诊断414 = 向量<字符串>();
    整64 左ID = 表达式类型ID(池, 整32(n.附加) - 1, 符号表, 静默诊断414);
    如果 (左ID <= 0 || !是用户类ID(左ID)) { 返回 -1; }
    整64 方法名ID = 整64(驻留("运算符" + op名));
    整64 定义层 = 查类方法定义层(左ID, 方法名ID);
    如果 (定义层 == 0) { 返回 -1; }
    返回 查类方法返回(定义层, 方法名ID);
}

// 一元重载命中与返回类型推导（宿主 checkUnaryOperatorOverload 同构）：单目集 =
//   - !（负号/逻辑非——~ 已脱糖见文件头）。操作数末端 = 子终点-1（前缀一元
//   子区间 [子起点, 子终点) 单操作数）。命中返回重载方法返回类型名ID；否则 -1。
函数 一元重载返回ID(向量<节点> 池, 整32 节点索引,
                  向量<映射<整64, 符号>>& 符号表) -> 整64 {
    节点 n = 池.元素(节点索引);
    字符串 op名 = "";
    如果 (n.类型 == 节点_负号) { op名 = "-"; }
    否则 如果 (n.类型 == 节点_逻辑非) { op名 = "!"; }
    否则 { 返回 -1; }
    如果 (n.子终点 <= n.子起点 || n.子终点 > 整32(池.大小())) { 返回 -1; }
    向量<字符串> 静默诊断414 = 向量<字符串>();
    整64 操作数ID = 表达式类型ID(池, 整32(n.子终点) - 1, 符号表, 静默诊断414);
    如果 (操作数ID <= 0 || !是用户类ID(操作数ID)) { 返回 -1; }
    整64 方法名ID = 整64(驻留("运算符" + op名));
    整64 定义层 = 查类方法定义层(操作数ID, 方法名ID);
    如果 (定义层 == 0) { 返回 -1; }
    返回 查类方法返回(定义层, 方法名ID);
}
