// CN 自举编译器 v2 · 语义检查·类切片拒绝族（拆分：自 语义检查转换推导.cn
//   机械搬移·函数体逐字保留零逻辑变化——原文件 924 行越 900 警戒线而位运算
//   结果类型防御面须扩口，「先拆再加」纪律执行·443/474/1591 拆分先例同款）。
// 职责：869（#234 切片 v2 侧残余面补齐）——基类值形态编译期拒绝（防切片）
//   五面共用判定与诊断（声明/赋值/返回/实参/数组元素）+ 指针派生链面 +
//   类源类型推导（切片判定源面）。
// 消费=语义检查语句/语义检查赋值/语义检查赋值左值/语义检查中（声明初始化/
//   赋值/返回面 检查切片拒绝 挂点）与 语义检查实参（是切片形态）。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（目录包名）
导入 IR;         // 用户类表/方法返回/派生链（目录包名）
导入 协议常量;   // 驻留/驻留文本（中立层）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// ==================== 869（#234 切片 v2 侧残余面补齐）====================
// 立法背景：001 §8.6 / 234（2026-10-06 用户批准甲案）「基类值形态编译期拒绝
//   （防切片）——值拷贝会截掉派生类字段（C++ 经典事故源），专用诊断提示改用
//   基类指针/引用」。宿主 reportSliceReject（semantic_sig.cpp）执法面（869 收口
//   后）=声明初始化/赋值/返回/数组元素四面；v2 侧 801/617 只落地声明初始化
//   标识符/转移形态——构造调用（`形状 s = 方(1);`）、赋值面（`s = a;`）、
//   返回面（`返回 a;`）、实参面（`取形状(a)`）、数组初始化列表形态原放行
//   （且 768 位拷贝回退通道按基类大小截断=切片事故本体·869 探针矩阵实录）。
//   本族=确认缝合：三函数供多面消费（声明/赋值/返回/数组元素面调
//   检查切片拒绝；实参面 1819（1784 丁案实施④）宿主决议失败路径同步升级
//   专用切片诊断〔诊断指路 T&·条文 R4〕——原「未找到匹配的函数」=869 轮
//   对齐宿主决议面的中间态·1087 用例 expected 随轮翻转；容器/用户类方法/
//   接口/静态四路经 逐实参转换检查907 与 入容器拷构守卫共用本族），
//   专用诊断文案逐字对齐宿主 reportSliceReject（617 既有文案原样）。

// 切片形态判定（五面共用·宿主 reportSliceReject 判定链同构）：源类型ID=派生
//   类值 且 目标类型ID=基类值 → 真。排除面（宿主 isPointer/isReference/
//   isInterfaceType 前置同构）：指针 '*'/引用 '&' 目标=同地址语义零拷贝
//   （001 §8.6 合法通道·616 正测零误伤）——经用户类表 ID 判定天然排除
//   （指针/引用形态 ID 非注册类名，是用户类_ID 落假·与宿主前置排除等价）；
//   同类（源==目标）非切片=768 位拷贝合法面。
//   结构=命名布尔正向判定（882 三红门禁：比较式归入命名布尔·条件位全布尔名·
//   末尾裸返回非 miss 判定形态——852 赋值位先例同款）。
函数 是切片形态(整64 源类型ID, 整64 目标类型ID) -> 布尔 {
    布尔 目标类形 = 是用户类_ID(目标类型ID);
    可选<整64> 源类查 = 剥引用取用户类(源类型ID);
    布尔 源类形 = 源类查.有值;
    整64 源类 = 0;
    如果 (源类查.有值) { 源类 = 源类查.值; }
    布尔 异类 = 源类形 && 源类 != 目标类型ID;
    布尔 切片 = 假;
    如果 (目标类形 && 源类形 && 异类) {
        切片 = 是否派生自(源类, 目标类型ID);
    }
    返回 切片;
}

// 切片拒绝专用诊断（声明初始化/赋值/返回/数组元素四面共用）：形态成立即报
//   专用消息（文案逐字对齐宿主 reportSliceReject）。
函数 检查切片拒绝(整64 源类型ID, 整64 目标类型ID, 向量<字符串>& 诊断) -> 空类型 {
    布尔 切片 = 是切片形态(源类型ID, 目标类型ID);
    如果 (切片) {
        可选<整64> 源类查 = 剥引用取用户类(源类型ID);
        // 切片成立（是切片形态 已过 源类形）⇒ 剥引用取用户类 必有值；未取到时
        //   保留 0（诊断文本面·不可达路径），不改变诊断触发条件
        整64 源类 = 0;
        如果 (源类查.有值) { 源类 = 源类查.值; }
        字符串 目标文本 = 字符串复制(驻留文本(目标类型ID));
        表诊断(诊断, "[错误] 禁止类切片：'" + 字符串复制(驻留文本(源类)) +
                      "' 不能隐式转换为基类值 '" + 目标文本 +
                      "'——值形态会截掉派生类字段（立法 234·防切片）；请用基类指针 '" +
                      目标文本 + "*' 或引用同地址持有");
    }
}

// 869（#234 指针派生链面·探针15 实锤）：指针形态派生链判定——源/目标均
//   单层指针（尾 '*'）且基名间 是否派生自 → 真。派生类指针 → 基类指针=
//   同地址上行转换合法（001 §8.6「派生类对象/指针可隐式转换为其基类链上
//   任一祖先类的指针或引用形态」；宿主 canConvertType 指针段 pointeeOf
//   逐层判定同构——多级指针基名含星非用户类=不放行，宿主 isClassType
//   对「形状*」同判假=零分叉）。消费=实参面 652 取址判定 ③ 分支
//   （&a〔方*〕传 形状* 形参原逐字比较拒=v2 过拒分叉）。
//   结构=命名布尔正向判定（882 门禁同 是切片形态）。
函数 指针派生链合法(字符串 源文本, 字符串 目标文本) -> 布尔 {
    整64 源长 = 字符串长度(源文本);
    整64 标长 = 字符串长度(目标文本);
    布尔 双非空 = 源长 > 0 && 标长 > 0;
    布尔 尾星 = 假;
    如果 (双非空) {
        整64 源尾 = 整64(源文本[整32(源长 - 1)]) & 255;
        整64 标尾 = 整64(目标文本[整32(标长 - 1)]) & 255;
        尾星 = 源尾 == 42 && 标尾 == 42;
    }
    布尔 派生链 = 假;
    如果 (尾星) {
        字符串 源基 = 字符串子串(源文本, 0, 整32(源长 - 1));
        字符串 标基 = 字符串子串(目标文本, 0, 整32(标长 - 1));
        布尔 同基 = 字符串比较(源基, 标基);
        如果 (同基) {
            派生链 = 真;   // 同型指针（逐字比较已放行·冗余保险）
        }
        布尔 双类 = 是用户类(源基) && 是用户类(标基);
        布尔 异基双类 = !同基 && 双类;
        如果 (异基双类) {
            派生链 = 是否派生自(驻留(源基), 驻留(标基));
        }
    }
    返回 派生链;
}

// 类源类型推导（切片判定源面·声明/赋值/返回三面共用）：右值末节点 → 类型ID。
//   覆盖面=标识符（含引用变量读出·剥引用由 是切片形态 承担）/转移(标识符)
//   （963 同构识别·附加==1=单实参）/构造调用（被调=用户类名·413/951「构造
//   调用返回类名自身」同源）/普通函数调用返回（调用源返回类型ID静默·772
//   单候选零副作用面）/方法调用返回（查类方法返回·实例基名剥回退·741 段
//   同款识别）。返回 -1=不可推导或非类形态（字面量/算术/成员/下标等——非类
//   右值不可能构成切片）。与 741 段推导的形态差：741 段为拷贝构造检查服务
//   （构造调用须排除——返回槽构造非拷贝·p11 实证），本函数为切片判定服务
//   （构造调用须纳入）——目的不同非复制疏漏（741 段注释互指）。
//   结构=命名布尔正向判定+结果变量收口（882 门禁同 是切片形态；869 拆子
//   两辅助=嵌套 ≤3 层与函数单屏纪律·调用源上标识符/调用源上成员）。
函数 推导类源类型(向量<节点> 池, 整32 源末索引,
                    向量<映射<整64, 符号>>& 符号表) -> 整64 {
    整64 结果类型 = 0 - 1;
    布尔 索引有效 = 源末索引 >= 0 && 源末索引 < 整32(池.大小());
    如果 (索引有效) {
        节点 源末 = 池.元素(源末索引);
        布尔 标识符形 = 源末.类型 == 节点_标识符;
        如果 (标识符形) {
            可选<整64> 结果查 = 表查找类型ID(符号表, 整64(源末.文本));
            // miss 保持 -1（本函数「不可推导」契约·消费方 >0 判定同假）
            如果 (结果查.有值) { 结果类型 = 结果查.值; }
        }
        布尔 调用形 = 源末.类型 == 节点_调用;
        布尔 调用索引 = 整64(源末.子起点) >= 0 &&
                          整64(源末.子起点) < 整64(池.大小());
        布尔 调用可查 = 调用形 && 调用索引;
        如果 (调用可查) {
            节点 被调 = 池.元素(整32(源末.子起点));
            布尔 标识符被调 = 被调.类型 == 节点_标识符;
            如果 (标识符被调) {
                结果类型 = 调用源上标识符(池, 源末, 被调, 符号表);
            }
            布尔 成员被调 = 被调.类型 == 节点_成员;
            如果 (成员被调) {
                结果类型 = 调用源上成员(池, 被调, 符号表);
            }
        }
    }
    返回 结果类型;
}

// 869 子：被调=标识符 的调用源类型（转移/构造调用/普通函数调用返回三形态）
//   ——附加=实参个数（协议常量 节点_调用 约定）；转移=显式转移标记（963）。
函数 调用源上标识符(向量<节点> 池, 节点 源末, 节点 被调,
                      向量<映射<整64, 符号>>& 符号表) -> 整64 {
    整64 被调名 = 整64(被调.文本);
    布尔 单实参 = 源末.附加 == 1;
    布尔 实参在池 = 整64(源末.子起点) + 1 < 整64(池.大小());
    布尔 是转移 = 字符串比较(驻留文本(被调名), "转移");
    布尔 转移形 = 单实参 && 实参在池 && 是转移;
    整64 结果类型 = 0 - 1;
    如果 (转移形) {
        节点 实参 = 池.元素(整32(源末.子起点) + 1);
        布尔 实参标识符 = 实参.类型 == 节点_标识符;
        如果 (实参标识符) {
            可选<整64> 结果查2 = 表查找类型ID(符号表, 整64(实参.文本));
            // miss 保持 -1（本函数「不可推导」契约·消费方 >0 判定同假）
            如果 (结果查2.有值) { 结果类型 = 结果查2.值; }
        }
    }
    布尔 构造形 = !转移形 && 是用户类_ID(被调名);
    如果 (构造形) {
        结果类型 = 被调名;   // 构造调用=类名自身（413/951 立法）
    }
    布尔 普通调用 = !转移形 && !构造形;
    如果 (普通调用) {
        可选<整64> 调用源查 = 调用源返回类型ID静默(池, 源末, 符号表);   // 772 单候选面
        如果 (调用源查.有值) { 结果类型 = 调用源查.值; }
    }
    返回 结果类型;
}

// 869 子：被调=成员 的方法调用返回类型（对象=标识符：自身/变量查表类名直查
//   回退——741 段同款识别）。
函数 调用源上成员(向量<节点> 池, 节点 被调,
                    向量<映射<整64, 符号>>& 符号表) -> 整64 {
    整64 结果类型 = 0 - 1;
    布尔 有对象 = 被调.子起点 > 0;
    如果 (有对象) {
        节点 调对象 = 池.元素(整32(被调.子起点));
        布尔 对象标识符 = 调对象.类型 == 节点_标识符;
        如果 (对象标识符) {
            整64 对象类型ID = 0 - 1;
            字符串 对象名 = 字符串复制(驻留文本(整64(调对象.文本)));
            布尔 是自身形态 = 字符串比较(对象名, "自身");
            如果 (是自身形态) {
                // 1637：可选显式分流——无值=非类上下文（落 0 同原哨兵·
                //   下游 ==0/<0 未知与不可推导分判契约不变）
                可选<整64> 自身类查 = 取当前检查类ID();
                // 静默豁免<存量变量>: 对象类型ID 为函数既有承接变量·此处新增赋值两行·改名随 1755 存量轮
                如果 (自身类查.有值) { 对象类型ID = 自身类查.值; }
                如果 (!自身类查.有值) { 对象类型ID = 0; }
            }
            布尔 变量形 = !是自身形态;
            如果 (变量形) {
                可选<整64> 对象查 = 表查找类型ID(符号表, 整64(调对象.文本));
                // miss 保持 -1（本函数「不可推导」契约）·原 <=0 判定含 0 当未知
                如果 (对象查.有值) { 对象类型ID = 对象查.值; }
                布尔 名查miss = !对象查.有值 || 对象类型ID == 0;
                如果 (名查miss) {
                    对象类型ID = 整64(调对象.文本);   // 名 miss 回退类名直查
                }
            }
            结果类型 = 方法返回沿链(对象类型ID, 整64(被调.文本));
        }
    }
    返回 结果类型;
}

// 869 子：方法返回类型沿链（查类方法返回 + 泛型实例基名剥回退）。
函数 方法返回沿链(整64 对象类型ID, 整64 方法名) -> 整64 {
    整64 结果类型 = 0 - 1;
    布尔 对象有效 = 对象类型ID > 0;
    如果 (对象有效) {
        // 1541 B2：无值=无此方法（原 0 承接·下游 >0 判不可推导同判）
        可选<整64> 返查 = 查类方法返回(对象类型ID, 方法名);
        布尔 无返回 = !返查.有值;
        如果 (返查.有值) { 结果类型 = 返查.值; }
        如果 (无返回) {
            字符串 实例文 = 字符串复制(驻留文本(对象类型ID));
            字符串 基文 = 剥实例基名(实例文);
            布尔 有基文 = !字符串比较(基文, 实例文);
            如果 (有基文) {
                可选<整64> 基返查 = 查类方法返回(驻留(基文), 方法名);
                如果 (基返查.有值) { 结果类型 = 基返查.值; }
            }
        }
    }
    返回 结果类型;
}
