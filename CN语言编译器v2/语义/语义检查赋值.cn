                        节点 调对象741 = 池.元素(整32(被调741.子起点));
                        如果 (调对象741.类型 == 节点_标识符) {
                            整64 对象741 = 0;
                            字符串 对象名741 = 字符串复制(驻留文本(整64(调对象741.文本)));
                            布尔 是自身741 = 字符串比较(对象名741, "自身");
                            如果 (是自身741) {
