                    // miss 保持 0（下方 >0 判定与原 -1 哨兵同假·880 批5）
                    如果 (源类型741查.有值) { 源类型741 = 源类型741查.值; }
                } 否则 如果 (右末741.类型 == 节点_调用 && 右末741.子起点 >= 0 &&
                            整64(右末741.子起点) + 1 < 整64(池.大小())) {
                    节点 被调741 = 池.元素(整32(右末741.子起点));
                    节点 实参741 = 池.元素(整32(右末741.子起点) + 1);
                    如果 (被调741.类型 == 节点_标识符 && 右末741.附加 == 1 &&
                         实参741.类型 == 节点_标识符 &&
                         字符串比较(驻留文本(整64(被调741.文本)), "转移")) {
                        // 转移(标识符)（963 同构识别·附加==1=单实参·p4 对齐）：
