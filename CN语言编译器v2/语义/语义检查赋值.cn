        }
    }
    // 040/204①②：函数指针来源封口（左=fnptr 文本时右值来源白名单·204 实锤
    //   v2 曾静默接受 整32/空类型* 伪造=call 任意地址）
    如果 (左类型名ID >= 0 && n.子终点 > n.子起点) {
        字符串 左文本480 = 字符串复制(驻留文本(左类型名ID));
        如果 (字符串长度(左文本480) >= 16 &&
             字符串比较(字符串子串(左文本480, 0, 13), "函数指针<")) {
            检查函数指针来源封口(池, 整32(n.子终点 - 1), 左文本480, 符号表, 诊断);
        }
    }
    // 476-a（D46 第三段）：赋值位构造名裸名拒绝——`r = 正常;`（p10 探针实锤·
    //   宿主拒/v2 曾静默）——474-a 返回语句位/475-a 声明初始化位同族第三位
    //   （语句级单点·零 callee 混淆：`r = 正常(5);`=节点_调用不入判定）。
    //   集合={正常,错误}：「某些」裸名=可选枚举值语义·宿主放行先例。
    如果 (n.子终点 > n.子起点) {
        节点 赋值右值末476 = 池.元素(n.子终点 - 1);
        如果 (赋值右值末476.类型 == 节点_标识符) {
            字符串 裸名文本476 = 字符串复制(驻留文本(整64(赋值右值末476.文本)));
            如果 (字符串比较(裸名文本476, "正常") || 字符串比较(裸名文本476, "错误")) {
                表诊断(诊断, "[错误] 构造名裸名须带参调用: " + 裸名文本476 +
                            "（ 正常(值) / 错误(码) ）");
            }
        }
    }
    // plans/019 阶段2（2026-09-10）：局部地址逃逸——右值=取地址(局部标识符)
    //   且左值为非局部（全局/静态层）标识符时拒绝（悬垂防线前移；宿主
    //   visitAssignmentExpr 同构。成员/下标目标位与引用局部/指针指向跟踪
    //   v2 随引用面扩大对齐=诚实边界——树内预审零命中）
    如果 (n.子终点 > n.子起点 && n.文本 != 0) {
        节点 逃逸右值末 = 池.元素(n.子终点 - 1);
        如果 (逃逸右值末.类型 == 节点_取地址 && 逃逸右值末.子起点 >= 0) {
            节点 逃逸操作数 = 池.元素(整32(逃逸右值末.子起点));
            如果 (逃逸操作数.类型 == 节点_标识符 &&
                 是局部名(符号表, 整64(逃逸操作数.文本)) &&
                 !是局部名(符号表, 整64(n.文本)) &&
                 表查找类型ID(符号表, 整64(n.文本)) != -1) {
                表诊断(诊断, "[错误] 不能将局部变量的地址存入静态/全局存储（比其寿命长，将成悬垂）: " +
                              驻留文本(整64(逃逸操作数.文本)));
            }
        }
    }
    // 435：赋值位逃逸检查（右值含 [&] 非空捕获 lambda/传播表变量：目标局部→
    //   传播入表；全局/字段/成员/下标→拒·宿主 checkAssign 同构=语义检查逃逸.cn）
    检查赋值位lambda逃逸(池, n, 符号表, 诊断, 引用lambda变量们);  // 486：主表
    // 884-a（070·G-N·537）：**下标左值赋值位的装箱语境**——`组[0] = 正常(5)`
    //   （结果/可选 数组元素赋值·537 A 段）须与声明位/返回位同款放行构造器
    //   （71-a 语境机制复用）：左值末=下标 且 元素类型（变量类型文本为数组→
    //   数组元素文本）为 结果/可选 → 设 装箱语境类型ID=元素类型ID；右值检查后复位。
    布尔 下标语境884 = 假;
    如果 (n.文本 == 0 && n.子起点 > 0) {
        节点 左值末884 = 池.元素(n.子起点 - 1);
        如果 (左值末884.类型 == 节点_下标 && 左值末884.子起点 > 0) {
            节点 下标对象884 = 池.元素(整32(左值末884.子起点));
            整64 元素类型ID884 = 0;
            如果 (下标对象884.类型 == 节点_标识符) {
                整64 变量类型884 = 表查找类型ID(符号表, 整64(下标对象884.文本));
                如果 (变量类型884 > 0) {
                    字符串 变量类型文本884 = 字符串复制(驻留文本(变量类型884));
                    如果 (是数组类型文本(变量类型文本884)) {
                        可选<字符串> 元素文本884查 = 数组元素文本(变量类型文本884);
                        字符串 元素文本884 = "";
                        如果 (元素文本884查.有值) { 元素文本884 = 字符串复制(元素文本884查.值); }
                        如果 (字符串长度(元素文本884) > 0) {
                            元素类型ID884 = 整64(驻留(元素文本884));
                        }
                    }
                }
            }
            如果 (元素类型ID884 > 0 && 是结果类型_ID(元素类型ID884)) {
                设装箱语境884(元素类型ID884);
                下标语境884 = 真;
            }
        }
        // 234/200（2026-10-07·p2 面·合成体字段成员左值）：成员链左值赋值位
        //   装箱语境——`b.内 = 正常(7)`（盒.内 字段类型=合成体）与下标左值同款
        //   放行构造器（71-a 语境机制复用）：左值末=成员 且 字段类型ID 为
        //   结果/可选 → 设 装箱语境类型ID=字段类型ID。
        如果 (n.文本 == 0 && n.子起点 > 0) {
            节点 左值末234 = 池.元素(n.子起点 - 1);
            如果 (左值末234.类型 == 节点_成员 && 左值末234.子起点 > 0) {
                节点 成员对象234 = 池.元素(整32(左值末234.子起点));
                如果 (成员对象234.类型 == 节点_标识符) {
                    整64 对象键基234 = 查结构体类型(整64(成员对象234.文本));
                    // 571（2026-10-14·#571 双侧同案）：对象=**类实例**（查结构体
                    //   类型 miss）——变量声明类型=类名 → 类字段类型表查字段
                    //   （类字段同入 字段类型表·IR/类中.cn 145 登记点）：`甲.名称
                    //   = 某些(...)` 类字段赋值位构造器装箱语境——宿主支持/
                    //   v2 原保守拒绝=单侧分叉（106 轮 234 面结构体位已修·类位
                    //   同款补齐·与 884-a 下标位同机制）。
                    如果 (对象键基234 == 0) {
                        整64 变量类型c571 = 表查找类型ID(符号表, 整64(成员对象234.文本));
                        如果 (变量类型c571 > 0) { 对象键基234 = 变量类型c571; }
                    }
                    如果 (对象键基234 != 0) {
                        整64 字段类型ID234 = 查字段类型ID(对象键基234, 整64(左值末234.文本));
                        如果 (字段类型ID234 > 0 &&
                             (是结果类型_ID(字段类型ID234) || 是可选类型_ID(字段类型ID234))) {
                            设装箱语境884(字段类型ID234);
                        }
                    }
                }
            }
        }
    }
    整64 i = 整64(标注起点);
    当 (i < 整64(n.子终点)) {
        整64 忽略2 = 检查表达式(池, 整32(i), 符号表, 诊断);
        如果 (忽略2 == -1) { }
        i++;
    }
    // 884-a：下标装箱语境复位（右值检查后）
    如果 (下标语境884) { 设装箱语境884(0); }
    // 010（def-init）：写点置位——右值检查后左值 place 初始化（复合赋值=先读
    //   后写，读判定面=v2 第一刀诚实边界·树内预审零形态）
    如果 (n.文本 != 0) {
        状态写置位(符号表, 整64(n.文本));
    }
    如果 (n.文本 == 0 && n.子起点 > 0) {
        节点 左值末q = 池.元素(n.子起点 - 1);
        如果 (左值末q.类型 == 节点_下标 || 左值末q.类型 == 节点_成员) {
            // 010：链式左值（行[0].语文=… / s.横=… / 表[0]=…）——链基底解析
            整64 基名q = 0;
            整64 首下q = 0 - 1;
            整32 见下q = 0;
            如果 (状态链基底(池, 整32(n.子起点 - 1), 基名q, 首下q, 见下q) == 1) {
                如果 (见下q == 1 && 首下q >= 0) {
                    状态写置位下标(符号表, 基名q, 首下q);
                } 否则 {
                    状态写置位(符号表, 基名q);
                }
            }
        } 否则 如果 (左值末q.类型 == 节点_标识符) {
            状态写置位(符号表, 整64(左值末q.文本));
        }
    }
    // 982 赋值复活（001 条文⑥·用户裁决甲·对齐宿主 981 reviveMovedVar 同构）：
    //   **简单赋值**（文本!=0=左名ID）成功路径尾部清除已转移位（表标记转移 0
    //   =未转移）——写不读旧值=复活点（Rust assign-to-move 同款）；v2 赋值
    //   目标 moved 本不拦+生成层写槽=行为天然复活，此处补语义位清除根除
    //   「复活后再读假阳性」。复合赋值（文本==0）左值末=读旧值不复活。
    如果 (n.文本 != 0) {
        表标记转移(符号表, 整64(n.文本), 0);
    }
    // 730/301 第五面（宿主 visitExprStmt 赋值守卫失效同构·安全闭环）：赋值清除
    //   左值结果已查标——730 延续守卫标存活到块尾，无此清除=重赋值后旧「已检查」
    //   误留漏报（宿主 301 批 p301c 负例实测拦下的同款缺陷）；复合赋值同口径
    //   （需读旧值即依赖检查，一并失效）。失效时机=右值表达式检查之后（宿主
    //   checkExpr 先行同序——复合赋值读旧值面守卫仍在=合规）。失效键=裸标识符
    //   （045b 守卫键面=标识符 only·成员/下标链键 v2 未同构=既有诚实边界）。
    如果 (n.文本 != 0) {
        清除结果已查(整64(n.文本));
    } 否则 如果 (n.子起点 > 0) {
        节点 左值末730 = 池.元素(n.子起点 - 1);
        如果 (左值末730.类型 == 节点_标识符) {
            清除结果已查(整64(左值末730.文本));
        }
    }
    状态置赋值左值区间926(旧左值起926, 旧左值止926);   // 926：左值区间恢复（外层）
    状态置赋值目标中(假);  // 010：写目标语境收尾
    返回;
    // 963：赋值位转移标志复位（值区间检查后）
    如果 (本赋值位转移963) { 置声明位转移标志963(假); }
}

// ==================== 185-a 族子方法（原 检查赋值语句 287~410 段） ====================

// 族①：标识符左值赋值检查（原 287~329 段）——未声明/常量/已转移/常量引用/
//   B10 可变静态变量写/A2 字符* 借用收紧。
函数 检查标识符左值赋值(向量<节点> 池, 整32 节点索引, 节点 n,
                  向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    如果 (n.文本 != 0) {
        整64 左类型 = 表查找类型ID(符号表, 整64(n.文本));
        // 1007（002 OOP 波1·561 转批实测）：类内裸名静态字段回退——1022 波G
        //   语义回退覆盖 自增表达式位/语句位两处，复合赋值（+=/-=）左值同走
        //   本检查（检查标识符左值赋值·复合赋值脱糖后落标识符赋值）漏此=
        //   「赋值目标未声明: 总数」误拒（561 实录）。命中=类型=登记静态类型。
        如果 (左类型 == -1 && 取当前检查类ID() > 0) {
            结果<整64, 整32> 查类写t = 查类静态字段类型(取当前检查类ID(), 整64(n.文本));
            如果 (查类写t.正常) { 左类型 = 查类写t.值; }
        }
        // 434（类名::静态字段 限定写·#284 ::矩阵第五态）：限定复合名「类名::字段」
        //   回退——宿主 :: 与点号同语义折叠 MemberExpr（写位=AssignmentExpr 左值
        //   同通道·292 探针实锤），v2 复合文本在此取 查限定名静态字段类型 单点
        //   分派（B10 顶层静态写拦截不命中=类静态字段写非 B10 面·宿主同口径）。
        如果 (左类型 == -1) {
            结果<整64, 整32> 限定类查434 = 查限定名静态字段类型(整64(n.文本));
            如果 (限定类查434.正常) { 左类型 = 限定类查434.值; }
        }
        如果 (左类型 == -1) {
            表诊断(诊断, "[错误] 赋值目标未声明: " + 驻留文本(整64(n.文本)));
        }
        // 缺陷②（2026-09-03 用户裁决立案）：常量初始化后不可修改（[03] 规范
        //   语义；宿主 isConstVarName 对齐）——顶层常量经 声明收集 登记为
        //   符号_常量，内层同名变量遮蔽时 表查找种类 命中内层=放行
        如果 (表查找种类(符号表, 整64(n.文本)) == 符号_常量) {
            表诊断(诊断, "[错误] 不能给常量赋值（常量初始化后不可修改）: " +
                          驻留文本(整64(n.文本)));
        }
        // 982 赋值复活（001 条文⑥·用户裁决甲·对齐宿主 981 同构）：**简单赋值**
        //   目标不再因已转移拒绝——写不读旧值=复活点（尾部 表标记转移 0 清位）；
        //   原「已转移不可作赋值目标」拦截随条文修正移除（复合赋值拦在下方
        //   复合合成标识符分支补挂）。
        // plans/019 阶段3（2026-09-10）：常量引用参数是只读借用——不可作赋值
        //   目标（宿主 currentConstRefParams_ 对齐；传可变/互斥面 v2 随实参
        //   边界记录另轮=诚实边界）
        如果 (是常量引用参数(整64(n.文本))) {
            表诊断(诊断, "[错误] 常量引用参数是只读借用，不能赋值: " +
                          驻留文本(整64(n.文本)));
        }
        // 155-a（B10 v2 挂点）：**可变静态变量写**（顶层静态赋值——与宿主 B10
        //   「静态变量写」同族；读安全=plans/023 §四 B10 的 CN 裁剪）。
        如果 (是全局静态名(整64(n.文本))) {
            错误不安全边界(诊断, "静态变量写", "静态变量赋值");
        }
        // 188-a（D6·plans/023 B11 变量常量传播）：赋值位恒空登记——候选=指针
        //   （指针变量表命中）或 字符串；RHS 形态分级（`无` 字面量=种子／标识符=
        //   传播边／其余〔复合赋值/调用/运算…〕=失格）
        布尔 恒空候选188 = 假;
        如果 (查语义指针变量(整64(n.文本)) >= 0) {
            恒空候选188 = 真;
        } 否则 如果 (左类型 == 驻留("字符串")) {
            恒空候选188 = 真;
        }
        如果 (恒空候选188 && n.子终点 > n.子起点 &&
              整64(n.子终点 - 1) < 池.大小()) {
            节点 恒空右a = 池.元素(n.子终点 - 1);
            如果 (恒空右a.类型 == 节点_整数字面量 && 恒空右a.附加 == 1) {
                登记恒空种子(整64(n.文本));
            } 否则 如果 (恒空右a.类型 == 节点_标识符) {
                登记恒空边(整64(n.文本), 整64(恒空右a.文本));
            } 否则 {
                登记恒空失格(整64(n.文本));
            }
        }
        // 548（编译期除零·常量传播）：赋值位零值登记（整数族·宿主
        //   visitAssignmentExpr noteZeroAssign 同构）——RHS 形态分级同 188-a
        //   （折叠零值=种子／标识符=传播边／其余=失格·登记零值右值548 单点
        //   分派）。v2 复合赋值经脱糖重析合成二元到达本位=右值为含目标自身的
        //   二元节点 → 折叠失败且非标识符 → 失格（`甲 += 0` 不误种子·宿主
        //   显式复合赋值失格分支同口径）。
        如果 (是整数类型文本548(字符串复制(驻留文本(左类型))) &&
             n.子终点 > n.子起点 && 整64(n.子终点 - 1) < 池.大小()) {
            登记零值右值548(池, 整64(n.文本), 整32(n.子终点 - 1), 符号表);
        }
        // plans/019 阶段4' A2（2026-09-11 方案甲）：赋值位字符* 借用收紧——
        //   字符串（拥有）变量赋值 字符* 调用返回（驻留文本/借用返回函数）
        //   须显式 字符串复制（与初始化位同款；借用→拥有显式）。
        如果 (左类型 == 驻留("字符串") && n.子终点 > n.子起点) {
            节点 赋值右末A2 = 池.元素(n.子终点 - 1);
            如果 (赋值右末A2.类型 == 节点_调用 && 赋值右末A2.子起点 >= 0) {
                节点 被调赋A2 = 池.元素(整32(赋值右末A2.子起点));
                如果 (被调赋A2.类型 == 节点_标识符 &&
                     查函数返回类型(整64(被调赋A2.文本)) == 驻留("字符*")) {
                    表诊断(诊断, "[错误] 字符串（拥有）变量不能以字符* 借用视图隐式赋值——须 字符串复制(...) 显式落堆拥有化（借用→拥有显式；拥有→借用自动）");
                }
            }
        }
    }
}

// 族②：下标左值形态检查（原 338~385 段）——字符串下标只读拒/指针下标写
//   （B10 挂点+数组对象豁免）/字段数组元素可写（97-a）。
函数 检查下标左值形态(向量<节点> 池, 节点 n, 节点 左值末,
                  向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
        如果 (左值末.类型 == 节点_下标) {
            布尔 是指针下标左值 = 假;
            如果 (左值末.子起点 > 0) {
                节点 下标对象左 = 池.元素(整32(左值末.子起点));
                如果 (下标对象左.类型 == 节点_标识符) {
                    // 259（2026-10-07·#259 静态数组）：顶层静态数组下标写放行
                    //   （对象类型=符号表静态登记·数组文本→按 157-a 数组对象同款
                    //   豁免；写安全=宿主「静态变量写不安全域」既有防线承担
                    //   ——检查赋值语句 B10 对 赋值文本=静态名 已报·下标元素写
                    //   与宿主口径一致=不安全 函数 内合法）。
                    整64 静对象类型259 = 表查找类型ID(符号表, 整64(下标对象左.文本));
                    如果 (静对象类型259 >= 0 &&
                         是数组类型文本(驻留文本(静对象类型259))) {
                        是指针下标左值 = 真;
                        返回;
                    }
                    整64 查左指针 = 查语义指针变量(整64(下标对象左.文本));
                    如果 (查左指针 >= 0) {
                        是指针下标左值 = 真;
                        // 155-a（A2 v2 挂点）：**裸指针下标写**（p[i] = x 经裸指针
                        //   偏移写=可越界；与宿主 A2「指针下标写」同族——读面由
                        //   B8 在 检查下标表达式 单报，此处写面无重复）
                        // 157-a（收口前置缺陷修复，253 双编译对照实证）：**数组
                        //   对象豁免**——栈数组下标写（整32[3] 表; 表[0] = 10）是
                        //   安全操作（宿主 A2 已豁免；v2 缺失=155-a 误报）。判定
                        //   与 B8 数组豁免同款（声明类型文本是数组）。
                        布尔 数组对象左 = 假;
                        整64 对象声明类型左 = 表查找类型ID(符号表, 整64(下标对象左.文本));
                        如果 (对象声明类型左 >= 0) {
                            如果 (是数组类型文本_ID(对象声明类型左)) {
                                数组对象左 = 真;
                            }
                        }
                        如果 (!数组对象左) {
                            错误不安全边界(诊断, "指针下标写", "指针下标写（p[i] = ...）");
                        }
                    }
                } 否则 如果 (下标对象左.类型 == 节点_成员) {
                    // 97-a（2026-09-13 第九十七轮 C8）：结构体**字段数组**元素下标
                    //   左值（r.分数[0] = v；嵌套链 t.两行[1].分数[2] = v）——字段
                    //   类型可判定且**非数组**时拒绝（字符串字段下标仍只读=既有语义）；
                    //   不可判定（嵌套成员链 推导成员类型ID 面外）放行交 IR 层判定
                    //   （IR 推导下标元素类型ID=0 即「下标左值对象未支持」可见失败——
                    //   半实现纪律：不放行静默，只是判定点后移）
                    布尔 可写97 = 真;
                    向量<字符串> 静默诊断97 = 向量<字符串>();
                    整64 字段类型左97 = 推导成员类型ID(池, 整32(左值末.子起点),
                                                        符号表, 静默诊断97);
                    如果 (字段类型左97 > 0) {
                        字符串 字段文本左97 = 字符串复制(驻留文本(字段类型左97));
                        如果 (!是数组类型文本(字段文本左97)) { 可写97 = 假; }
                    }
                    如果 (可写97) { 是指针下标左值 = 真; }
                }
            }
            如果 (!是指针下标左值) {
                // 618（910/596 执法面收口·双侧逐字同文）：字符串基对象下标左值
                //   ——诊断正文对齐宿主 910（标识符形态·带 : s[i] = ... 尾巴）与
                //   596（非标识符形态·无尾巴）。字符串判定=标识符基座（表类型=
                //   字符串）/字符串字面量基座/成员基座（推导类型=字符串）；判定
                //   不出（诚实边界·类型推导面外）保持存量短文不动（语义仍拒）。
                布尔 是串618 = 假;
                布尔 带尾618 = 假;
                字符串 名618 = "";
                如果 (左值末.子起点 > 0) {
                    节点 基618 = 池.元素(整32(左值末.子起点));
                    如果 (基618.类型 == 节点_标识符) {
                        如果 (表查找类型ID(符号表, 整64(基618.文本)) == 驻留("字符串")) {
                            是串618 = 真;
                            带尾618 = 真;
                            名618 = 字符串复制(驻留文本(整64(基618.文本)));
                        }
                    } 否则 如果 (基618.类型 == 节点_字符串字面量) {
                        是串618 = 真;
                    } 否则 如果 (基618.类型 == 节点_成员) {
                        向量<字符串> 静串618 = 向量<字符串>();
                        整64 基类型618 = 推导成员类型ID(池, 整32(左值末.子起点),
                                                            符号表, 静串618);
                        如果 (基类型618 == 驻留("字符串")) { 是串618 = 真; }
                    }
                }
                如果 (是串618) {
                    如果 (带尾618) {
                        表诊断(诊断, "[错误] 下标左值赋值未支持（字符串下标只读）——字符串为不可变拥有型，原地修改请用 字符 数组或不安全区指针（112 甲）: " + 名618 + "[i] = ...");
                    } 否则 {
                        表诊断(诊断, "[错误] 下标左值赋值未支持（字符串下标只读）——字符串为不可变拥有型，原地修改请用 字符 数组或不安全区指针（112 甲）");
                    }
                } 否则 {
                    表诊断(诊断, "[错误] 下标左值赋值未支持（字符串下标只读）");
                }
            }
        }
}
