// CN 自举编译器 v2 · 语义检查赋值（546 千行拆分·自 语义检查语句.cn 机械搬移）
// 职责：赋值语句检查族（检查赋值语句 + 检查标识符左值赋值 + 检查下标左值形态）
//   ——纯机械搬移零行为变更；546 先拆再加纪律
//   （语义检查语句.cn 999 行警戒线，声明面数组列表检查加挂前先拆赋值族；
//   声明族【检查推断声明语句/检查变量声明语句/检查声明类型节点/检查函数指针
//   来源封口/检查静态声明初值884/登记跳过区间】留原文件）。
//   检查复合赋值操作数 不入本文件：86 轮已先行拆至 语义检查复合赋值.cn
//   （含 86 拼接放行+868-a 形态自取·rebase 收口取 develop 版防双定义），
//   本文件 检查赋值语句 经包内跨模块调用消费之。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（目录包名）
导入 IR;         // 容器/结果 合成名判定 + 节点_*/键位移 常量（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 借出检查;    // 第七十七轮 A21：借出视图生命周期检查（函数级调用）
导入 语义检查逃逸;   // 435：lambda 引用捕获逃逸检查（赋值位·包内兄弟）

公开:   // 全文件公开（检查语句族供 语义检查中 分派消费）

// 1039（1037 采样轮 D2）：类型文本补指针层数星——符号表对指针/数组名登记
//   剥星基名或数组全文（55-c/94-a），指针分型检查的判定与诊断须还原规范
//   指针文本（剥星基名 + 层数星，与宿主 canConvertType 指针段含星口径对齐）。
//   入参=元素类型文本 + 层数（调用侧已经 指针变量表/指针层数表 双查命中）；
//   <1 层按 1 兜底（登记面恒 >=1·此支防未来直调误用）。
函数 指针文本补星1039(字符串 基文本, 整64 层数) -> 字符串 {
    字符串 果1039 = 剥尾星615(字符串复制(基文本));
    整64 层1039 = 层数 >= 1 ? 层数 : 1;
    整64 添1039 = 0;
    当 (添1039 < 层1039) {
        果1039 = 果1039 + "*";
        添1039++;
    }
    返回 果1039;
}

// 1039/880 批5（#1507 同规）：指针层数查询（可选→诊断文本层数）——配对不变量：
//   指针变量表命中 ⇒ 层数表必命中（登记语义指针变量 单点双写）；缺登记或层数
//   越界（<1）=两表不一致（编译器内部缺陷）→ 登记内部未登记显形，显式保守取
//   最低指针层 1 维持诊断文本（不静默取默认值继续语义判定）。
函数 指针层数补星1039(整64 名ID) -> 整64 {
    可选<整64> 层查1039 = 查语义指针层数(名ID);
    如果 (层查1039.有值) { 返回 层查1039.值; }
    登记内部未登记("指针层数表与指针变量表登记不一致（1039 指针文本补星）",
                   字符串复制(驻留文本(名ID)), 0);
    返回 1;
}

// 791（569 采样 H4·001 §747-8 执法扩面·双侧同构）：写目标「下标/成员」链
//   根对象名解析——沿 子起点 链下降至链首（表[0]/原点.甲/矩阵[0][1] 的根=
//   表/原点/矩阵）。根为标识符返回其名ID；根非标识符（解引用/调用/字面量等）
//   返回 0=不判定（合法不判定面声明：集合键=标识符名，非标识符根不可能命中
//   「全局静态名集合」——写责任留既有条款〔解引用写/指针下标写族〕，非静默
//   默认）。链下降上限 256：节点池由解析器构造为无环链（子起点恒指向更早
//   节点），上限语义上不可达——仅防构造期异常下的死循环，达限按「根非
//   标识符」显式分流。宿主同构=semantic_staticguard::writeTargetRootName。
//   916 复用：方法调用接收者链 原点.桶.追加()/表[0].追加() 的根名解析——
//   同一「沿 子起点 链下降至链首」语义，调用方传接收者表达式节点。
函数 写目标根名791(向量<节点> 池, 节点 左值末) -> 整64 {
    节点 cur = 左值末;
    整64 防环791 = 0;
    当 (防环791 < 256) {
        如果 (cur.类型 != 节点_成员 && cur.类型 != 节点_下标) { 中断; }
        如果 (cur.子起点 < 0 || 整64(cur.子起点) >= 池.大小()) { 返回 0; }
        cur = 池.元素(整32(cur.子起点));
        防环791++;
    }
    如果 (cur.类型 == 节点_标识符) { 返回 整64(cur.文本); }
    返回 0;
}

// 916（791 派生·P1 安全面·001 §747-8 通用全局写执法·双侧同构）：容器写
//   方法名白名单——「方法调用形态」的全局写执法判定用（接收者根对象∈可变
//   全局集合 + 被调方法名∈本表 → 与 791 赋值链同规则拦截）。清单来源=
//   stdlib/容器.cn + 映射集合.cn 实际 API 逐一核对（「宁全勿漏」：写方法含
//   内部注入挂点）：
//     向量<T>：追加/插入/删除/设置/清空/预留/析构元素/析构被移除/移动元素
//     链表<T>：追加/头部追加/删除头部/删除尾部/清空/取空闲槽/归还槽
//     栈<T>：压入/弹出          队列<T>：入队/出队/清空/取空闲槽/归还槽
//     映射/字符串映射：设置/删除/清空/释放内部数组/析构键值/析构值
//     集合<T>：添加/删除/清空/析构被移除/移动元素/数组前移
//   读方法（大小/容量/为空/读取/元素/元素引用/获取/包含/桶索引/栈顶/队首/
//   头部元素/读取头部/读取尾部）不入表=不拦。宿主同构=semantic_staticguard
//   ::isContainerWriteMethod（零分叉·同表同序同判）。
函数 是容器写方法916(字符串 方法名) -> 布尔 {
    如果 (字符串比较(方法名, "追加") || 字符串比较(方法名, "插入") ||
        字符串比较(方法名, "删除") || 字符串比较(方法名, "设置") ||
        字符串比较(方法名, "清空") || 字符串比较(方法名, "预留") ||
        字符串比较(方法名, "析构元素") || 字符串比较(方法名, "析构被移除") ||
        字符串比较(方法名, "移动元素") || 字符串比较(方法名, "头部追加") ||
        字符串比较(方法名, "删除头部") || 字符串比较(方法名, "删除尾部") ||
        字符串比较(方法名, "取空闲槽") || 字符串比较(方法名, "归还槽") ||
        字符串比较(方法名, "压入") || 字符串比较(方法名, "弹出") ||
        字符串比较(方法名, "入队") || 字符串比较(方法名, "出队") ||
        字符串比较(方法名, "释放内部数组") || 字符串比较(方法名, "析构键值") ||
        字符串比较(方法名, "析构值") || 字符串比较(方法名, "添加") ||
        字符串比较(方法名, "数组前移")) {
        返回 真;
    }
    返回 假;
}

// 791：894-a 自增表达式位（语义检查.cn「节点_自增表达式」分支调用·实现外移
//   承担 语义检查.cn 警戒线纪律）——下标/成员 链 写目标 根对象∈可变全局
//   静态集合（顶层静态/裸全局/函数内静态局部）→ 安全区边界拦截，文案与
//   标识符自增位既有形态一致（静态变量自增自减）；宿主 checkIncDecUnary
//   （semantic_expr_unary.cpp 791 挂点）同构同文案（零分叉）。
函数 检查自增位静态写791(向量<节点> 池, 节点 左末,
                     向量<映射<整64, 符号>>& 符号表,
                     向量<字符串>& 诊断) -> 空类型 {
    如果 (左末.类型 == 节点_下标 || 左末.类型 == 节点_成员) {
        整64 根名z791 = 写目标根名791(池, 左末);
        // 1337/1338：同款「非静态局部命中」豁免（根名遮蔽形态）。
        如果 (根名z791 != 0 && !命中非静态局部1337(符号表, 根名z791) &&
             (是全局静态名(根名z791) || 是静态局部名(根名z791))) {
            错误不安全边界(诊断, "静态变量写", "静态变量自增自减");
        }
    }
}

// 618（001 §4.4 字符串下标语义·T48/112 甲·与宿主 currentIncDecOperand_ 身份
//   比较同构）：894-a 自增表达式位**左值区间检查**（自 语义检查.cn 外移——
//   该文件超 900 行警戒线·先拆再加精神·同 791 先例）。区间检查前登记写目标
//   下标节点索引（池索引=节点身份）——检查下标表达式 字符串面出口（字符串
//   下标结果618）据此在语义层显式拒绝（字符串为不可变拥有型，下标只读）；
//   嵌套下标读（s[t[0]]++ 中 t[0]）索引不同不误判；嵌套自增经保存/恢复外层
//   登记值不串扰。
函数 检查自增表达式区间618(向量<节点> 池, 节点 n,
                         向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    整64 旧写目标618 = 状态读自增写目标下标618();
    状态置自增写目标下标618(整64(n.子终点) - 1);
    整64 检z = 整64(n.子起点);
    当 (检z < 整64(n.子终点)) {
        可选<整64> 忽略z = 检查表达式(池, 整32(检z), 符号表, 诊断);
        检z++;
    }
    状态置自增写目标下标618(旧写目标618);
}

// 赋值语句检查（R3 拆分）：左值声明/常量拒 + 下标左值白名单 + 可写左值形态 +
//   复合赋值数值操作数（经 检查复合赋值操作数）+ 成员偏移标注 + 表达式检查。
函数 检查赋值语句(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    节点 n = 池.元素(节点索引);
    状态置赋值目标中(真);  // 010（def-init）：写目标语境（区间遍历重入抑制）
    // 926（指针成员访问 B9·宿主 assignmentTargetDepth_ 同构）：赋值左值链
    //   区间登记（成员写 p.x = 5 / 复合/自增合成）——写目标链内成员不报
    //   读判定；右值读不在区间照报。保存/恢复外层值（嵌套防御）。
    //   882 门禁注记：无区间默认（-1/-1=读路径）先置，条件覆盖（去 else）；
    //   索引守卫/合成判据/区间扩展 比较式归入命名布尔（条件外显）。
    整32 旧左值起926 = 状态读赋值左值起926();
    整32 旧左值止926 = 状态读赋值左值止926();
    // 1471（安全区对齐·组合形态 (*p).x 执法缺口）：左值末索引+自增合成标记
    //   写位判派数据源（宿主 B7 直写面/IncDec 读面对齐）——保存/恢复外层值
    //   与 926 区间同生命周期同惯例。
    整32 旧左值末1471 = 状态读赋值左值末1471();
    布尔 旧自增合成1471 = 状态读赋值自增合成1471();
    整32 旧止快照1471 = 状态读赋值止快照1471();
    整32 起926 = 0 - 1;
    整32 止926 = 0 - 1;
    布尔 成员左值926 = n.文本 == 0 && n.子起点 != 0;
    如果 (成员左值926) {
        止926 = n.子起点 - 1;
        // 复合赋值合成（右值末=二元且 子终点==1·解析语句中.cn 合成标记）：
        //   右值副本链（第一份区间尾起至右操作数起点前）同属写目标引用——
        //   止扩至 二元.附加-1（宿主单份 target 无副本=等价抑制口径）。自增
        //   合成（子终点==2·894-a）不扩——自增形态宿主 target 非赋值目标
        //   （B9 照报 1 次），副本区间由节点级去重（标记成员检查926）兜底。
        布尔 区间有右值926 = n.子终点 != n.子起点 &&
                            整64(n.子终点) <= 池.大小();
        布尔 是自增合成1471 = 假;
        如果 (区间有右值926) {
            节点 右末926 = 池.元素(整32(n.子终点) - 1);
            布尔 是复合合成926 = 右末926.类型 == 节点_二元运算 &&
                                右末926.子终点 == 1 && 右末926.附加 != 0;
            // 1471：自增合成标记（右值末=二元且 子终点==2·解析语句中.cn 894-a
            //   专用标记）——写位判派据此把第一份左值链按读位报（宿主 IncDec
            //   操作数 depth=0 B6 照报·j/L 探针双侧实录）、副本链静默。
            是自增合成1471 = 右末926.类型 == 节点_二元运算 &&
                            右末926.子终点 == 2;
            整32 右附末926 = 整32(右末926.附加 - 1);
            布尔 区间可扩926 = 右附末926 >= 止926;   // 只扩不回缩
            如果 (是复合合成926 && 区间可扩926) {
                止926 = 右附末926;
            }
        }
        起926 = 整32(n.附加);
        // 1471：左值末索引=子起点-1（恒·不随复合扩区间变——写直写位判据）
        状态置赋值左值末1471(整32(n.子起点 - 1));
        状态置赋值自增合成1471(是自增合成1471);
    }
    如果 (!成员左值926) {
        // 1471：简单赋值（文本!=0 标识符左值）/无复合左值=无链末（防外层残留）
        状态置赋值左值末1471(0 - 1);
        状态置赋值自增合成1471(假);
    }
    // 1471：止快照（判派取值单点写·跨模块无参访问器自举解析不达）
    状态置赋值止快照1471(止926);
    状态置赋值左值区间926(起926, 止926);
    // 963（008 总攻·v2 转移扩面）：赋值位转移放行——值末=转移(单标识符) 时置
    //   声明位转移中（检查调用表达式 分级 2 据此放行·与声明位同通道）。
    //   对照宿主 933：赋值位=拥有资源显式交接（Rust `b = a` move 对照）。
    布尔 本赋值位转移963 = 假;
    如果 (n.子终点 > n.子起点 && n.子终点 < 整64(池.大小())) {
        节点 赋值末963 = 池.元素(整32(n.子终点 - 1));
        如果 (赋值末963.类型 == 节点_调用 && 赋值末963.附加 == 1 &&
             赋值末963.子起点 >= 0) {
            节点 赋值被调963 = 池.元素(整32(赋值末963.子起点));
            节点 赋值实参963 = 池.元素(整32(赋值末963.子起点) + 1);
            如果 (赋值被调963.类型 == 节点_标识符 &&
                 赋值实参963.类型 == 节点_标识符 &&
                 字符串比较(驻留文本(整64(赋值被调963.文本)), "转移")) {
                置声明位转移标志963(真);
                本赋值位转移963 = 真;
            }
        }
    }

    // 575-a（T100·299 对齐宿主 checkConstMethodMemberAssign）：常量成员函数内
    //   修改类字段拒绝——字段判定经 查字段类型ID（读借出检查类=当前类·检查方法
    //   已设）；局部变量非字段不受影响（宿主同口径）。两形态：裸字段/自身.字段。
    如果 (读当前方法常量() && 读借出检查类() > 0) {
        如果 (n.文本 != 0) {
            可选<整64> 字段查c = 查字段类型ID(读借出检查类(), 整64(n.文本));
            如果 (字段查c.有值) {
                表诊断(诊断, "[错误] 常量成员函数内不能修改成员: " +
                              驻留文本(整64(n.文本)));
            }
        } 否则 如果 (n.子起点 > 0) {
            节点 左值末c = 池.元素(n.子起点 - 1);
            如果 (左值末c.类型 == 节点_成员 && 左值末c.子起点 > 0) {
                节点 对象c = 池.元素(左值末c.子起点 - 1);
                如果 (对象c.类型 == 节点_标识符 &&
                     字符串比较(字符串复制(驻留文本(整64(对象c.文本))), "自身")) {
                    可选<整64> 字段查c2 = 查字段类型ID(读借出检查类(), 整64(左值末c.文本));
                    如果 (字段查c2.有值) {
                        表诊断(诊断, "[错误] 常量成员函数内不能修改成员: 自身." +
                                      驻留文本(整64(左值末c.文本)));
                    }
                }
            }
        }
    }
    // 185-a：本函数 178 行按「左值形态」提取为 2 个族子方法（纯搬运零行为
    //   变更——多重集核验先行于构建）。
    // 左值（标识符）须已声明；右值表达式检查；解引用左值（文本=0）跳过左名检查
    如果 (n.文本 != 0) {
        检查标识符左值赋值(池, 节点索引, n, 符号表, 诊断);
    }
    如果 (n.文本 == 0 && n.子起点 > 0) {
        节点 左值末 = 池.元素(n.子起点 - 1);
        // 下标左值形态检查（字符串下标只读拒/指针下标放行/字段数组元素）
        检查下标左值形态(池, n, 左值末, 符号表, 诊断);
