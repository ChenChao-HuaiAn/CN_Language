// CN 自举编译器 v2 · 语义检查调用内置（#1855 千行拆分轮·纯机械搬移零逻辑变化）
// 职责：标识符内置终态族——71-a 装箱构造 / 155-a 裸释放 / 217 新线程可搬运 / 019 转移 /
//   206-c 复制 / P7b 容器构造 / 强转类型名白名单 / 474 回绕 / 内置直调（930 让位+个数/变参/格式化/析构释放执法接线）/
//   376+967 类型大小（参数清单拒绝+编译期折叠改写）。
//   自 语义检查表达式.cn 检查调用表达式 机械搬移（段体逐字保留·原嵌套缩进
//   不重排=逐字节零差异证据）；消费=语义检查表达式 检查调用表达式 分派骨架。
// 依赖经合并全局池（同包兄弟）；显式导入限跨包。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（目录包名）
导入 IR;         // 容器/结果/签名 层面公开函数（目录包名）
导入 协议常量;   // 驻留/驻留文本（中立层）

公开:   // 全文件公开（子模块符号供包内兄弟模块经合并全局池解析）


// 71-a 段命中体（装箱构造 正常/错误/某些——外层分派条件留在骨架）
        // 71-a（2026-09-11 方案A 用户裁决）：内置构造器 正常()/错误()/某些()
        //   （规范 07-五，编译器预置）——合法仅当装箱语境为 结果/可选（返回位
        //   =函数返回类型、声明位=声明目标类型，语境由检查方设置）；推导类型
        //   写入调用节点.文本（#1872 迁槽·解析期恒 0=空闲位），IR 层构造器特判读取发射。
        //   实参区间由语句根区间线性遍历先序检查（返回语句/变量声明 循环先于
        //   本节点=线性顺序）；构造器名恒走本分支（预置符号表语义，重定义被
        //   遮蔽=第一版边界）。宿主 handleResultCtor 同构（返回类型上下文优先）。

函数 检查装箱构造调用(向量<节点> 池, 节点 n, 整32 节点索引,
                   向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断,
                   字符串 被调文本) -> 结果<整64, 整32> {

            // B2（#1543）：结果透传——正常=类型ID；错误=构造器已诊断→原错误(2)
            结果<整64, 整32> 构造果203 = 检查构造器调用旧出口203(池, n, 节点索引, 符号表, 诊断, 被调文本);
            如果 (构造果203.正常) { 整64 构造型203 = 构造果203.值; 返回 正常(构造型203); } 否则 { }
            返回 错误(2);
}


// 155-a 段（裸释放）+217 段（新线程 实参位可搬运）——继续链面（不终态）
函数 检查标识符副作用内置(向量<节点> 池, 节点 n, 整32 节点索引,
                     向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断,
                     字符串 被调文本) -> 空类型 {

        // 155-a（A5 v2 挂点）：**裸释放**（释放(指针)——与宿主 A5「裸释放」同族）。
        //   判定=名「释放」+ 实参为指针变量（查语义指针变量≥0）；容器等拥有对象
        //   的同名释放语义由容器析构承担（宿主按实参形态区分 call 分派）——v2
        //   第一版按名+指针实参判定（未覆盖形态=诚实边界）。
        如果 (字符串比较(被调文本, "释放")) {
                检查裸释放调用(池, n, 诊断);
            }
        // 217（027 波2a·001 §5.8a）：新线程 实参位可搬运检查（§1.1a① 编译期
        //   硬错误·宿主 checkDirectCall 同构）。实参根定位=解析期登记表
        //   （查调用实参末位·借出检查 同款接口·-1/越界放行）；实参类型=标识符
        //   place 形态 表查找（推导不可靠面一律放行·本函数 1514 诚实边界同
        //   口径）；顶层 空类型*=内置豁免窗口（sunset=218）。诊断锚
        //   「不可跨线程搬运」与宿主逐字一致（608 dual 判据）。
        如果 ((字符串比较(被调文本, "新线程") || 字符串比较(被调文本, "线程::新线程") ||
              字符串比较(被调文本, "线程::新") || 字符串比较(被调文本, "线程.新")) &&
             整64(n.附加) >= 2) {
            整64 实参2位217 = 0 - 1; 可选<整64> 实参2位217查 = 查调用实参末位(整64(节点索引), 1);
            // miss（原 -1 哨兵）同假——下方原 >=0 判定逐字保留
            如果 (实参2位217查.有值) { 实参2位217 = 实参2位217查.值; }
            如果 (实参2位217 >= 0 && 实参2位217 < 整64(池.大小())) {
                节点 实参2节点 = 池.元素(整32(实参2位217));
                如果 (实参2节点.类型 == 节点_标识符) {
                    整64 实参类型217 = 0; 可选<整64> 实参类型217查 = 表查找类型ID(符号表, 整64(实参2节点.文本));
                    // miss 保持 0（下方 >0 判定与原 -1 哨兵同假·880 批5）
                    如果 (实参类型217查.有值) { 实参类型217 = 实参类型217查.值; }
                    如果 (实参类型217 > 0) {
                        字符串 类型文本217 = 字符串复制(驻留文本(实参类型217));
                        // 217：指针变量补星（符号类型ID=基名·指针层语义在
                        //   语义指针变量表——星号形态在此重建·顶层指针实参面）
                        可选<整64> 指针查217 = 查语义指针变量(整64(实参2节点.文本));
                        如果 (指针查217.有值) {
                            类型文本217 = 类型文本217 + "*";
                        }
                        // 218 sunset 收窄：顶层 空类型* 豁免仅限 不安全 函数体内
                        //   （001 §5.8b·§1.1a④·安全区传裸指针值=同拦）
                        布尔 窗口豁免217 = 字符串比较(类型文本217, "空类型*") &&
                                          读当前函数不安全();
                        如果 (!窗口豁免217 &&
                             !字符串比较(类型文本217, "空类型") &&
                             !字符串比较(类型文本217, "未知")) {
                            字符串 链217 = "";
                            如果 (!可搬运判定(驻留(类型文本217), 0, 链217)) {
                                表诊断(诊断, "[错误] 类型 '" + 类型文本217 +
                                    "' 含裸指针字段 '" + 链217 +
                                    "'，不可跨线程搬运（001 §5.8a；如确需跨线程请声明 不安全 可搬运）");
                            }
                        }
                    }
                }
            }
        }
}


// 019 转移 / 206-c 复制 / P7b 容器构造 / 强转类型名白名单——命中即终态
//   返回 有值=终态 正常(类型ID)；无值=继续主链（原 fall-through）
函数 检查标识符终态内置(向量<节点> 池, 节点 n, 整32 节点索引,
                   整64 调用起点, 向量<映射<整64, 符号>>& 符号表,
                   向量<字符串>& 诊断, 整64 被调名, 字符串 被调文本) -> 可选<整64> {

        // plans/019 阶段1（2026-09-10）：显式转移 转移(变量) 特判——实参须为
        //   变量标识符；分级：标量拒绝（复制语义）/指针与字符串放行（值交接，
        //   标记已转移+返回实参类型）/拥有资源类型（容器/类/结果等）v2 第一版
        //   暂不支持（宿主声明初始化位已锚定，v2 容器位随阶段3 浅拷贝对齐）。
        //   实参首查先于调用节点（线性顺序）=首次转移不误报，此处标记后
        //   区间后段任何使用经 检查标识符表达式 拒绝。
        如果 (字符串比较(被调文本, "转移")) {
                返回 某些(检查转移调用(池, n, 调用起点, 符号表, 诊断));
            }
        // 206-c（波 4·plans/020 第七十二节）：复制(表达式) 泛型克隆内置——
        //   与 转移(x) 构成显式「复制/移动」双内置（C++ copy/move 对照物，
        //   Rust Clone::clone 同构）。返回类型=实参类型（泛型内置无法固定
        //   签名注册 → 调用处特判）；类型 ID 写入调用节点.文本（#1872 迁槽）供 IR 层
        //   生成复制展开 按类型分派发射。
        如果 (字符串比较(被调文本, "复制")) {
                返回 某些(检查复制调用(池, n, 节点索引, 调用起点, 符号表, 诊断));
            }
        // P7b：容器类构造调用（向量<整64>() 语法层已合成 向量$整64 被调标识符）
        //   合法——返回类型=被调实例名自身（1181·2026-10-20：原「暂按 整64
        //   （对象指针）兜底」=静默默认值（110 案同族）：显式声明位不消费该
        //   返回值（声明类型已知）故存量不可见；推断声明位（变量 v = 向量<整32>()
        //   ·46-c 通道）消费它 → 推断类型=整64 → IR 层标量单槽+类型权威表
        //   挂整64 → v.追加() 方法调用对象类型三分派全 miss（ir2 显形中止）。
        //   宿主 checkExpr 对构造调用返回构造类名同构对齐；装箱构造
        //   （正常/错误/某些）类型=外部语境载荷，不落本分支（先行拦截）。
        如果 (是容器类(被调文本)) {
            返回 某些(被调名);
        }
        // 灰色点④根治（2026-09-04 用户裁决立案·缺陷零容忍）：强转类型名
        //   白名单补 整8/整16（宿主窄宽强转已支持——整8(300)=44；原白名单
        //   九名缺失时落「未声明函数: 整8」）。
        //   2026-09-04 缺陷零容忍收口：正8/正16 补入（原「显式拒绝」系
        //   无符号语义缺位搁置——违反尽善尽美；现 IR 层 T_正8/T_正16
        //   零扩展标注+双后端 movzx/uxtb 落地，正8(200)=200 语义正确）
        如果 (字符串比较(被调文本, "整32") || 字符串比较(被调文本, "整64") ||
             字符串比较(被调文本, "浮32") || 字符串比较(被调文本, "浮64") ||
             字符串比较(被调文本, "布尔") || 字符串比较(被调文本, "字符") ||
             字符串比较(被调文本, "字符串") || 字符串比较(被调文本, "正32") ||
             字符串比较(被调文本, "正64") || 字符串比较(被调文本, "整8") ||
             字符串比较(被调文本, "整16") || 字符串比较(被调文本, "正8") ||
             字符串比较(被调文本, "正16") ||
             // 967（002·053 复工）：128 位强转（整128(1)/正128(999)——409/419
             //   转换构造族；IR 层 810 双半通道既有）
             字符串比较(被调文本, "整128") || 字符串比较(被调文本, "正128") ||
             // 418（002 收口杂项正测族）：指针(整数) 强转（spec 04-一C 指针↔整数
             //   同权·类型码层 指针=T_整64 单槽直通）——原缺席报「未声明函数: 指针」
             //   （16_function_extra 行58 实录）
             字符串比较(被调文本, "指针")) {
            // 329-a（D38 批2·343）：显式转换实参类型检查（单实参形态）——
            //   布尔目标仅收布尔源/字符串与结构体源拒/数值互转含窄化放行
            如果 (n.附加 == 1) {
                检查显式转换实参(池, n, 节点索引, 被调文本, 符号表, 诊断);
            }
            返回 某些(被调名);
        }
    返回 无;
}


// 474 段（回绕加/减/乘——两补码回绕语义·外层分派条件留在骨架）
        // 474（运行期整数溢出·回绕逃生门）：回绕加/回绕减/回绕乘 三件套——
        //   两补码回绕语义（错误码 8 溢出检查的显式豁免口·宿主同构）。类型规则
        //   与算术运算符一致（窄域保持窄域·结果=第一实参域）。IR 层经
        //   生成回绕展开 发射（附加<0 回绕协议·不走运行时符号直调）。

函数 检查回绕调用(向量<节点> 池, 节点 n, 整32 节点索引,
                向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断)
                -> 结果<整64, 整32> {

            如果 (n.附加 != 2) {
                表诊断(诊断, "[错误] 回绕加/回绕减/回绕乘 恰需 2 个整型实参");
                返回 错误(1);   // 已诊断错误（原 0 直接中止面）
            }
            // 1311 P1-1：整数操作数守卫（宿主 checkWrapBuiltinCall 同文案——
            //   字符串/布尔/浮点等非整数实参双侧一致拒绝；0=推导 miss 不误报）。
            //   守卫失败=诊断已出，返回 0（语义错误计数使编译中止）。
            布尔 整数实参有效474 = 检查回绕整数实参474(池, 节点索引, 符号表, 诊断);
            如果 (整数实参有效474) {
                返回 正常(回绕调用返回类型474(池, 节点索引, 符号表));
            }
            返回 错误(1);   // 守卫失败=诊断已出（原 0·语义错误计数使编译中止）
}


// 内置直调面（内置函数返回类型ID 查询+930 限定名让位+四个执法接线）
//   返回 有值=内置直调已终态 正常(内置返回)；无值=非内置/模块函数让位（继续主链）
函数 检查内置直调(向量<节点> 池, 节点 n, 整32 节点索引,
                向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断,
                字符串 被调文本) -> 可选<整64> {

        可选<整64> 内置返回查 = 内置函数返回类型ID(被调文本);   // 1541 B2：无值=非内置
        // 930（930 批 linux-v2 SIGSEGV 根治）：限定名内置让位模块公开函数——
        //   导入驱动加载的模块源码（模$符 签名存在）优先于内置直调（宿主
        //   rewriteQualifiedCall userFuncExists && moduleLoaded 等价形态；
        //   自模块包装自引用豁免见 模块函数优先930）。让位后落入下方 检查限定
        //   调用（776）决议到模块函数——返回类型=模块函数真实签名（结果<...>），
        //   与宿主零分叉。无源码内置（无导入形态）零变化。
        如果 (内置返回查.有值 && !模块函数优先930(被调文本)) {
            整64 内置返回 = 内置返回查.值;
            检查内置实参个数(池, n, 节点索引, 符号表, 诊断);   // #1911：内置参数个数闭集核对（宿主重载决议个数不符同拒·文案逐字一致·语义检查内置个数.cn·变参内部早退）
            检查变参打印实参(池, n, 节点索引, 符号表, 诊断);   // 443/539：变参内置（打印/打印行/格式化）实参类型检查（宿主 checkVariadicBuiltinCall 同构·非变参内部早退）
            检查格式化占位符配对(池, n, 节点索引, 符号表, 诊断);   // #1910：格式化占位符配对执法（个数+逐位类型·七形态诊断与宿主 tryEmitFormatCall 逐字对齐·非格式化内部早退）
            执法析构手动释放1674(池, n, 节点索引, 符号表, 诊断);   // #1674 丙案：析构体内对资源字段手动 字符串释放 拒（宿主 semantic_call 同构）
            返回 某些(内置返回);   // 1891：转字符串族 128 位实参编译期拒面已撤销（1283 拒面转正·整128/正128 重载落地=全精度合法面·IR 层按实参码分派 __cn_str_from_i128/u128）
        }
    返回 无;
}


// 376+967 类型大小主分派（参数清单拒绝面+编译期折叠改写面）
//   返回 有值=终态 正常(整64)；无值=非「类型大小」被调（继续主链）
函数 检查类型大小调用(向量<节点> 池, 节点 n, 整32 节点索引,
                  整64 调用起点, 向量<映射<整64, 符号>>& 符号表,
                  向量<字符串>& 诊断, 字符串 被调文本) -> 可选<整64> {

        如果 (字符串比较(被调文本, "类型大小")) {
            // 376（v17 六族对齐批·001 02§六B 参数清单）：类型大小 参数清单=
            //   基础类型/结构体/数组/指针/限定类型/泛型实参——结果/可选 未列，
            //   友好拒绝（宿主 visitSizeofExpr 同款文案；宿主修前=内部错误
            //   形态违反诊断纪律·v2 修前=合成体尺寸放行超立法面——c359 实证）。
            //   类型名实参与下标形实参（元素为盒）两形态同拦。
            可选<整64> 盒拒果 = 类型大小盒参拒(池, n, 节点索引, 调用起点, 诊断, 被调文本);   // 376：参数清单拒绝面（接线·实现=本文件下方）
            如果 (盒拒果.有值) { 返回 某些(盒拒果.值); }
            可选<整64> 折叠果 = 类型大小折叠改写(池, n, 节点索引, 调用起点, 符号表, 被调文本);   // 967：编译期折叠改写面（接线）
            如果 (折叠果.有值) { 返回 某些(折叠果.值); }

            // 1960：非单实参形态（附加!=1）保留原通道（本八处裁决面外·零变更）。
            返回 某些(驻留("整64"));
        }
    返回 无;
}


// 376 段（类型大小 参数清单拒绝面——结果/可选 未列友好拒绝+登记显形）
函数 类型大小盒参拒(向量<节点> 池, 节点 n, 整32 节点索引,
                 整64 调用起点, 向量<字符串>& 诊断, 字符串 被调文本) -> 可选<整64> {

            如果 (n.附加 == 1 && 调用起点 > 0 && 节点索引 >= 2) {
                节点 段末x376 = 池.元素(节点索引 - 1);
                整64 盒名x376 = 0;
                如果 (段末x376.类型 == 节点_标识符) {
                    如果 (是结果类型(字符串复制(驻留文本(整64(段末x376.文本))))) {
                        盒名x376 = 整64(段末x376.文本);
                    }
                } 否则 如果 (段末x376.类型 == 节点_下标 && 段末x376.子起点 > 0) {
                    节点 基名x376 = 池.元素(整32(段末x376.子起点));
                    如果 (基名x376.类型 == 节点_标识符 &&
                         是结果类型(字符串复制(驻留文本(整64(基名x376.文本))))) {
                        盒名x376 = 整64(基名x376.文本);
                    }
                }
                如果 (盒名x376 > 0) {
                    表诊断(诊断, "[错误] 类型大小: 参数类型不支持 '" +
                                字符串复制(驻留文本(盒名x376)) +
                                "'（02 §六B 参数清单=基础类型/结构体/数组/指针/限定类型/泛型实参）");
                    // 1960（执法一·2026-11-02）：错误路径终态占位=分派面形态未
                    //   登记（#1958 B1 同族·用户级诊断已显形，登记为内部面补显
                    //   形+占位继续·主收尾统一中止——891/947 泛型面 648 改造先例）
                    登记内部未登记("类型大小不支持类型终态占位", 被调文本,
                                   整64(取当前诊断行()));
                    返回 某些(驻留("整64"));
                }
            }
    返回 无;
}


// 967 段（类型大小 编译期折叠改写面——调用节点改写整数字面量+占位清空）
            // 967（002·57 转批）：**语义层整体折叠**——类型大小(类型) 单实参
            //   调用节点改写为整数字面量（文本=宽度），实参段（含被调标识符）
            //   各节点改 节点_参数 占位（生成层主循环不处理=跳过·零残留压栈）。
            //   宽度支持：基本/容器/结果/结构体（类型名宽度 单点·含数组文本
            //   「整64[5]」=元素宽×长度分支）；下标形实参（类型大小(整64[5])）
            //   段末=下标根→基名×长度解析。宽度 0（未知/指针形）→不改写落
            //   IR 层原路径（折叠诊断/原语义）。

函数 类型大小折叠改写(向量<节点> 池, 节点 n, 整32 节点索引,
                  整64 调用起点, 向量<映射<整64, 符号>>& 符号表,
                  字符串 被调文本) -> 可选<整64> {

            如果 (n.附加 == 1 && 调用起点 > 0 && 节点索引 >= 2) {
                节点 段末967 = 池.元素(节点索引 - 1);
                整64 宽度967 = 0;
                如果 (段末967.类型 == 节点_标识符) {
                    // 1960（云端预验修复·2026-11-02）：折叠宽推导收敛单点
                    //   类型大小折叠宽推导（语义检查推导.cn·推导族归属）——
                    //   覆盖类型文本形态（类型名宽度 原表+930b 用户类对象实宽
                    //   覆盖·681 同源）+变量形态（149_v2 预验误伤实证 `类型大小
                    //   (变量)`=308d 系收变量·661 锚定·指针类型文本槽宽 8）；
                    //   返回 0=不可折叠→落下方 1960 显形守卫（真未登记形态
                    //   维持显形·不放宽）。
                    宽度967 = 类型大小折叠宽推导(池, 节点索引 - 1, 符号表);
                } 否则 如果 (段末967.类型 == 节点_下标 && 段末967.子起点 > 0) {
                    节点 基名967 = 池.元素(整32(段末967.子起点));
                    节点 长度967 = 池.元素(整32(段末967.子终点 - 1));
                    如果 (基名967.类型 == 节点_标识符 &&
                         长度967.类型 == 节点_整数字面量 &&
                         段末967.子终点 - 段末967.子起点 == 2) {
                        // 930b：数组元素为用户类时同取对象实宽（默认原表·覆盖式）
                        整64 元素宽967 = 类型名宽度(整64(基名967.文本));
                        字符串 元名967c = 字符串复制(驻留文本(整64(基名967.文本)));
                        如果 (是用户类(元名967c) && !是容器类(元名967c)) {
                            可选<整64> 元素宽967查 = 查结构体大小(驻留(元名967c)); 如果 (元素宽967查.有值) { 元素宽967 = 元素宽967查.值; }
                        }
                        整64 长度值967 = 0;
                        字符串 长度文本967 = 字符串复制(驻留文本(整64(长度967.文本)));
                        整64 li967 = 0;
                        布尔 合法967 = 字符串长度(长度文本967) > 0;
                        当 (li967 < 字符串长度(长度文本967)) {
                            整64 字节967 = 整64(长度文本967[整32(li967)]) & 255;
                            如果 (字节967 < 48 || 字节967 > 57) { 合法967 = 假; 中断; }
                            // 474：>18 位有效数字=必超域宽（防中间值溢出·自举安全）
                            如果 (li967 > 18) { 合法967 = 假; 中断; }
                            长度值967 = 长度值967 * 10 + (字节967 - 48);
                            li967++;
                        }
                        如果 (元素宽967 > 0 && 合法967 && 长度值967 > 0) {
                            宽度967 = 元素宽967 * 长度值967;
                        }
                    }
                }
                如果 (宽度967 > 0) {
                    整64 占i967 = 调用起点;
                    当 (占i967 < 节点索引) {
                        节点 占位967 = 池.元素(整32(占i967));
                        占位967.类型 = 节点_参数;
                        占位967.子起点 = 0;
                        占位967.子终点 = 0;
                        占位967.附加 = 0;
                        结果<空类型, 整32> 设占967 = 池.设置(整32(占i967), 占位967);
                        如果 (!设占967.正常) { 运行时错误(4); }
                        占i967++;
                    }
                    节点 折叠节点967 = 池.元素(节点索引);
                    折叠节点967.类型 = 节点_整数字面量;
                    折叠节点967.文本 = 整32(驻留(整数转字符串(宽度967)));
                    折叠节点967.子起点 = 0;
                    折叠节点967.子终点 = 0;
                    折叠节点967.附加 = 0;
                    结果<空类型, 整32> 设折967 = 池.设置(节点索引, 折叠节点967);
                    如果 (!设折967.正常) { 运行时错误(4); }
                    // 1960（执法一·2026-11-02）：折叠成功（宽度>0）返回 整64=
                    //   类型大小 语义返回类型（非 miss·合法终态保留）；宽度 0
                    //   （类型文本形态未登记·下方）=分派面 miss 通道——登记显形。
                    返回 某些(驻留("整64"));
                }
                // 1960（执法一·2026-11-02）：宽度 0=类型名宽度单点判定链对
                //   该类型文本形态未登记（#1958 B1 同族）——原静默返回整64占位
                //   落 IR 层原路径（类型截断静默传播）。登记显形（891/947 泛型面
                //   648 改造先例·登记后占位继续·主收尾统一中止）。
                登记内部未登记("类型大小折叠宽度未登记", 被调文本,
                               整64(取当前诊断行()));
                返回 某些(驻留("整64"));
            }
    返回 无;
}
