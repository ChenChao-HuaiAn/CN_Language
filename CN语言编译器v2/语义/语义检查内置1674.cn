// CN 自举编译器 v2 · 语义检查内置1674（#1674 甲/丙案·2026-10-26 用户批）
// 职责：①摘除(槽) 内置检查（甲案——宿主 checkRemoveBuiltinCall 同构）；
//   ②析构函数体内对资源字段手动 字符串释放 执法（丙案·宿主 semantic_call
//   字符串释放 分支执法同构·诊断文案双侧逐字一致）。另承载自 语义检查
//   表达式.cn 机械搬入的 检查泛型调用借用纪律1030（该文件 999 行触警戒线——
//   「先拆再加」纪律迁入·内置调用检查族归属）。导出函数清单同 HEAD。
// 依赖经合并全局池（同包兄弟：表查找类型ID/查类字段沿链907/读当前函数析构中
//   1674/检查变参打印实参）；显式导入仅限跨包模块。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_* 常量（目录包名）
导入 IR;         // 类表/判定族（是用户类_ID/查类节点索引/查类基名）
导入 协议常量;   // 驻留/驻留文本（中立层）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// ==================== #1674 甲案：摘除 内置检查 ====================

// 摘除(槽)（001 §5.6 ①）：实参=拥有槽左值（变量/形参/类字段·成员链），槽类型=
//   字符串或类类型。语义=释放旧值+清槽——摘除后槽=null，析构级联读到空槽空安全
//   跳过，手动放手与自动级联幂等组合，双释放机械杜绝。数组元素/右值=编译期拒
//   （无槽可清或内联元素析构面另立）；裸指针不纳入（无拥有契约·走 释放+不安全
//   函数）。有值=已处理（返回值=空类型ID）；无值=非摘除调用（调用方续走原链）。
函数 检查摘除内置1674(向量<节点> 池, 节点 n, 整32 节点索引,
                    向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断)
                    -> 可选<整64> {
    // 被调名守卫（调用点在 回绕 内置分支后——被调文本已提取过，此处独立重取
    // 保持函数自含·与宿主 checkRemoveBuiltinCall 同判据）
    如果 (n.子起点 <= 0 || 整64(n.子起点) >= 池.大小()) { 返回 无; }
    节点 被调1674 = 池.元素(整32(n.子起点));
    如果 (被调1674.类型 != 节点_标识符) { 返回 无; }
    如果 (!字符串比较(字符串复制(驻留文本(整64(被调1674.文本))), "摘除")) {
        返回 无;
    }
    如果 (n.附加 != 1) {
        表诊断(诊断, "[错误] 摘除 须恰为一个拥有槽实参：摘除(槽)");
        返回 某些(驻留("空类型"));
    }
    // 实参节点（查调用实参末位 表·418 同款设施——#1872 后子终点=区间不再当空闲位）
    可选<整64> 末位1674查 = 查调用实参末位(整64(节点索引), 0);
    如果 (!末位1674查.有值) {
        表诊断(诊断, "[错误] 摘除 实参须为拥有槽左值（变量/单层字段）——数组元素/嵌套链/右值不支持");
        返回 某些(驻留("空类型"));
    }
    整64 末位1674 = 末位1674查.值;
    如果 (末位1674 < 0 || 末位1674 >= 整64(池.大小())) {
        表诊断(诊断, "[错误] 摘除 实参须为拥有槽左值（变量/单层字段）——数组元素/嵌套链/右值不支持");
        返回 某些(驻留("空类型"));
    }
    节点 实参摘1674 = 池.元素(整32(末位1674));
    布尔 左值形态1674 = 实参摘1674.类型 == 节点_标识符 ||
                        实参摘1674.类型 == 节点_成员;
    如果 (!左值形态1674) {
        表诊断(诊断, "[错误] 摘除 实参须为拥有槽左值（变量/单层字段）——数组元素/嵌套链/右值不支持");
        返回 某些(驻留("空类型"));
    }
    字符串 槽类型1674 = 摘除槽类型文本1674(池, 实参摘1674, 符号表, 诊断);
    布尔 串槽1674 = 字符串比较(槽类型1674, "字符串");
    布尔 类槽1674 = 字符串长度(槽类型1674) > 0 && !串槽1674 &&
                    (是用户类ID(驻留(槽类型1674)) || 是容器类_ID(驻留(槽类型1674)));
    如果 (!串槽1674 && !类槽1674) {
        表诊断(诊断, "[错误] 摘除 仅支持 字符串/类类型 拥有槽（裸指针请用 释放+不安全 函数）：实际为 '" +
                    槽类型1674 + "'");
        返回 某些(驻留("空类型"));
    }
    返回 某些(驻留("空类型"));
}

// 摘除实参槽类型推导（单一事实源=符号表+类/结构体字段表）：
//   标识符=表查找类型ID（miss=类字段裸名·宿主 lookupSrcType miss→classFieldType
//   同判据——当前类上下文 读借出检查类() 字段类型遍历）；成员=对象类型→字段类型
//   （对象=自身/类变量→类字段；结构体变量→结构体字段区间）。空串=不可判定。
函数 摘除槽类型文本1674(向量<节点> 池, 节点 实参摘,
                       向量<映射<整64, 符号>>& 符号表,
                       向量<字符串>& 诊断) -> 字符串 {
    如果 (实参摘.类型 == 节点_标识符) {
        整64 名ID1674 = 整64(实参摘.文本);
        可选<整64> 类型查1674 = 表查找类型ID(符号表, 名ID1674);
        如果 (类型查1674.有值) { 返回 字符串复制(驻留文本(类型查1674.值)); }
        // 类字段裸名（方法体内·表 miss=非局部）——当前类上下文字段类型
        整64 类上下文1674 = 读借出检查类();
        如果 (驻留ID有效1674(类上下文1674)) {
            返回 类字段类型文本1674(池, 类上下文1674, 名ID1674);
        }
        返回 "";
    }
    如果 (实参摘.类型 != 节点_成员) { 返回 ""; }
    // 成员：对象=标识符（自身/变量）或嵌套成员链（自身.缓存.值）——嵌套走
    //   推导成员类型ID 现成链（#1700 乙案：包装基座剥壳见下）
    整64 对象起点1674 = 整64(实参摘.子起点);
    // 静默豁免闭集穷举: 成员对象节点池界守卫（双边界·miss=空串诚实边界·调用方已分流）
    如果 (池界外1674(对象起点1674, 池)) { 返回 ""; }
    节点 对象摘1674 = 池.元素(整32(对象起点1674));
    如果 (对象摘1674.类型 == 节点_成员) {
        // #1700 乙案：嵌套链（摘除(自身.缓存.值) 的 .缓存 中段）——对象类型
        //   =推导成员类型ID（现成·包装槽返回载荷类型）→中段=包装且本段=值
        //   →载荷（透明单载荷·宿主 removeSlotSrcType 嵌套分支同构）
        可选<整64> 中段查1674 = 推导成员类型ID(池, 整32(对象起点1674), 符号表, 诊断);
        如果 (!中段查1674.有值) { 返回 ""; }
        字符串 中段载荷1674 = 手动释放载荷剥壳(
            字符串复制(驻留文本(中段查1674.值)));
        如果 (字符串长度(中段载荷1674) == 0) { 返回 ""; }
        如果 (整64(实参摘.文本) != 整64(驻留("值"))) { 返回 ""; }
        返回 中段载荷1674;
    }
    如果 (对象摘1674.类型 != 节点_标识符) { 返回 ""; }
    整64 对象名1674 = 整64(对象摘1674.文本);
    可选<整64> 对象类型查1674 = 表查找类型ID(符号表, 对象名1674);
    如果 (!对象类型查1674.有值) { 返回 ""; }
    字符串 对象类型1674 = 字符串复制(驻留文本(对象类型查1674.值));
    整64 对象类型ID1674 = 驻留(对象类型1674);
    // #1700 乙案：包装变量.值（手动释放<T> s; 摘除(s.值)）——对象类型=
    //   手动释放<T>（非类/结构体）→ .值=载荷（透明单载荷）
    {
        字符串 变量载荷1674 = 手动释放载荷剥壳(对象类型1674);
        如果 (非空串内置1674(变量载荷1674)) {
            如果 (整64(实参摘.文本) != 整64(驻留("值"))) { 返回 ""; }
            返回 变量载荷1674;
        }
    }
    字符串 字段类型1674 = "";
    布尔 是类接收1674 = 字符串比较(对象类型1674, "自身") || 是用户类ID(对象类型ID1674);
    如果 (是类接收1674) {
        // 类实例字段（自身.字段 / 类变量.字段）
        字段类型1674 = 类字段类型文本1674(池, 对象类型ID1674, 整64(实参摘.文本));
    }
    如果 (!是类接收1674) {
        // 结构体变量.字段：结构体字段区间（节点_结构体 子区间=字段声明序列）
        字段类型1674 = 结构体字段类型文本1674(池, 对象类型ID1674, 整64(实参摘.文本));
    }
    // #1700 乙案：包装字段（自身.缓存.值 的单层形态/包装变量.值）——字段=
    //   手动释放<T> 且本段=值 → 载荷（透明单载荷）
    如果 (非空串内置1674(字段类型1674)) {
        字符串 载荷1674 = 手动释放载荷剥壳(字段类型1674);
        如果 (非空串内置1674(载荷1674)) {
            如果 (整64(实参摘.文本) != 整64(驻留("值"))) { 返回 ""; }
            返回 载荷1674;
        }
    }
    返回 字段类型1674;
}

// 类字段类型文本（沿基链·查类字段沿链907 的类型版——扫描形态同构）：
//   类节点子区间 遍历 节点_类字段（文本=字段名ID·附加=类型节点索引）→
//   命中=类型节点.文本。空串=沿链 miss（诚实边界）。
函数 类字段类型文本1674(向量<节点> 池, 整64 类名ID, 整64 字段名ID) -> 字符串 {
    整64 当前类1674 = 类名ID;
    整64 守卫1674 = 0;
    当 (当前类1674 != 0 && 守卫1674 < 64) {
        可选<整64> 类节点查1674 = 查类节点索引(当前类1674);
        如果 (类节点查1674.有值) {
            整64 类节点1674 = 类节点查1674.值;
            如果 (类节点1674 >= 0 && 类节点1674 < 整64(池.大小())) {
                节点 类值1674 = 池.元素(整32(类节点1674));
                整64 扫1674 = 整64(类值1674.子起点);
                当 (扫1674 < 整64(类值1674.子终点)) {
                    节点 成员1674 = 池.元素(整32(扫1674));
                    如果 (成员1674.类型 == 节点_类字段 &&
                          整64(成员1674.文本) == 字段名ID &&
                          成员1674.附加 > 0 && 成员1674.附加 < 整64(池.大小())) {
                        节点 类型节点1674 = 池.元素(整32(成员1674.附加));
                        返回 字符串复制(驻留文本(整64(类型节点1674.文本)));
                    }
                    扫1674++;
                }
            }
        }
        可选<整64> 基查1674 = 查类基名(当前类1674);
        如果 (!基查1674.有值) { 中断; }   // 链终止（显式否定拦截·#1674 甲案）
        如果 (基查1674.有值) { 当前类1674 = 基查1674.值; }
        守卫1674++;
    }
    返回 "";   // 静默豁免闭集穷举: 沿链 miss=空串诚实边界（调用方已分流）
}

// 结构体字段类型文本（结构体节点子区间遍历——字段声明=节点_参数·文本=名ID·
//   附加=类型节点索引·与类字段同布局协议）。空串=miss（诚实边界）。
函数 结构体字段类型文本1674(向量<节点> 池, 整64 结构体名ID, 整64 字段名ID) -> 字符串 {
    可选<整64> 结点查1674 = 查类节点索引(结构体名ID);
    如果 (!结点查1674.有值) { 返回 ""; }
    整64 结点1674 = 结点查1674.值;
    如果 (池界外1674(结点1674, 池)) { 返回 ""; }
    节点 结值1674 = 池.元素(整32(结点1674));
    整64 扫1674 = 整64(结值1674.子起点);
    当 (扫1674 < 整64(结值1674.子终点)) {
        节点 成员1674 = 池.元素(整32(扫1674));
        如果 (成员1674.类型 == 节点_参数 &&
              整64(成员1674.文本) == 字段名ID &&
              成员1674.附加 > 0 && 成员1674.附加 < 整64(池.大小())) {
            节点 类型节点1674 = 池.元素(整32(成员1674.附加));
            返回 字符串复制(驻留文本(整64(类型节点1674.文本)));
        }
        扫1674++;
    }
    返回 "";
}

// ==================== #1674 丙案：析构体内 手动 字符串释放 执法 ====================

// 析构函数体内对资源字段手动 字符串释放 = 编译期拒——字段级联将再 free 同句柄
//   =双释放（手动释放不清槽）。正路=摘除(字段) 提前放手，或字段改裸指针类型+
//   析构函数标 不安全 函数 自行管理。局部字符串变量不拦（用户自有槽）。字段
//   形态=成员访问（嵌套深度不限——字符串字段拥有者=对象）或裸字段名（当前类
//   实例字段·宿主 isCurrentClassFieldName 同判据）。宿主 semantic_call.cpp
//   字符串释放 分支执法同构（零分叉）。
函数 执法析构手动释放1674(向量<节点> 池, 节点 n, 整32 节点索引,
                        向量<映射<整64, 符号>>& 符号表,
                        向量<字符串>& 诊断) -> 空类型 {
    如果 (!读当前函数析构中1674()) { 返回; }
    如果 (调用被调无效1674(池, n)) { 返回; }
    节点 被调丙1674 = 池.元素(整32(n.子起点));
    如果 (被调丙1674.类型 != 节点_标识符) { 返回; }
    如果 (!字符串比较(字符串复制(驻留文本(整64(被调丙1674.文本))), "字符串释放")) {
        返回;
    }
    如果 (调用无实参1674(n)) { 返回; }
    可选<整64> 末位丙查 = 查调用实参末位(整64(节点索引), 0);
    如果 (!末位丙查.有值) { 返回; }
    整64 末位丙 = 末位丙查.值;
    如果 (末位丙 < 0 || 末位丙 >= 整64(池.大小())) { 返回; }
    节点 实参丙 = 池.元素(整32(末位丙));
    布尔 资源字段形态 = 假;
    如果 (实参丙.类型 == 节点_成员) {
        资源字段形态 = 真;   // 成员访问=字符串字段的拥有者是对（任）对象
    } 否则 如果 (实参丙.类型 == 节点_标识符) {
        // 裸名=当前类实例字段（局部/形参已有消耗标记放行路径·不在此拦）
        整64 类上下文丙 = 读借出检查类();
        如果 (驻留ID有效1674(类上下文丙)) {
            资源字段形态 = 查类字段沿链907(池, 类上下文丙, 整64(实参丙.文本));
        }
    }
    如果 (资源字段形态) {
        表诊断(诊断, "[错误] 析构函数体内禁止对资源字段手动 字符串释放：该字段由编译器级联自动释放（手动释放将导致二次释放）——请改用 摘除(字段) 提前放手，或将字段改为裸指针类型并在 不安全 函数 内自行管理");
    }
    返回;
}

// ==================== T69（480-a 深度机）函数指针调用检查 ====================
// 宿主 semantic_call.cpp:353-382 checkFuncPtrCall 同构：实参个数须与签名参数表
//   严格相等（宿主 359-366 个数不符即诊断）+ 结果类型=签名返回类型（宿主 378）。
//   逐参类型转换检查（宿主 canConvertWithLiteral 368-377）：v2 侧实参类型推导面
//   （表达式类型ID）覆盖面有限——本轮以「个数严格 + 返回类型正确」为编译期防线，
//   逐参类型精确转换=诚实边界（与 v2 语义推导完善同步收口）；ABI 正确性由三后端
//   参数位装载 + 双编译对照用例（09_integration/318/99/40）运行级锚定。

// 1030（1017 采样轮 p19 同族·v08 形态）：泛型实例调用借用纪律——被调=实例
//   合成名（名$实参）剥基名→全池扫基函数节点（与 738 显式实例分支扫描同构
//   重复·待归纳；894-a 同款同名唯一）→取参数借位（取方法参数借位们 区间布局
//   对自由函数通用）→借用位扫描202。调用点=语义检查表达式 检查调用表达式 推导
//   早退处与显式实例分支（两处同源）；无引用位/个数不符/基函数 miss=诚实边界
//   零检查（对齐构造/方法/普通函数三面·防误伤）。
//   位置迁注（#1674 轮）：原落 语义检查表达式.cn，该文件 999 行触警戒线——
//   「先拆再加」纪律迁入本文件（内置调用检查族），纯机械搬移零语义变化。
函数 检查泛型调用借用纪律1030(向量<节点> 池, 整32 调用节点索引,
                         字符串 被调文本, 向量<映射<整64, 符号>>& 符号表,
                         向量<字符串>& 诊断) -> 空类型 {
    节点 n1030g = 池.元素(调用节点索引);
    整64 实参数1030g = 整64(n1030g.附加);
    如果 (实参数1030g == 0) { 返回; }   // 1030：无实参=零引用位面（==0 显式枚举·非单边区间）
    字符串 基名1030g = 剥实例基名(被调文本);
    如果 (字符串长度(基名1030g) == 0) { 返回; }
    整64 基名ID1030g = 整64(驻留(基名1030g));
    整64 扫1030g = 0;
    当 (扫1030g < 整64(池.大小())) {
        节点 函1030g = 池.元素(整32(扫1030g));
        如果 (函1030g.类型 == 节点_函数 &&
             整64(函1030g.文本) == 基名ID1030g &&
             函1030g.子起点 < 函1030g.子终点) {
            向量<整64> 引位1030g = 向量<整64>();
            向量<整64> 常位1030g = 向量<整64>();
            整64 个数1030g = 取方法参数借位们(池, 扫1030g, 引位1030g, 常位1030g);
            如果 (个数1030g == 实参数1030g) {
                借用位扫描202(池, 调用节点索引, 实参数1030g, 引位1030g,
                            常位1030g, 符号表, 诊断);
            }
            返回;
        }
        扫1030g++;
    }
}

// ==================== #1674 守卫辅助（闭集边界单点·分支词面收纳） ====================

// 驻留 ID 守卫：类型/类名 ID 非零=已登记（驻留表键域从 1 起）
函数 驻留ID有效1674(整64 标识ID) -> 布尔 {
    返回 标识ID > 0;
}

// 池界守卫：节点索引双边界闭区间（0 起始·大小 上限）
函数 池界外1674(整64 索引, 向量<节点> 池) -> 布尔 {
    返回 索引 < 0 || 索引 >= 整64(池.大小());
}

// 调用节点守卫：被调子起点池界
函数 调用被调无效1674(向量<节点> 池, 节点 n) -> 布尔 {
    返回 n.子起点 <= 0 || 整64(n.子起点) >= 池.大小();
}

// 实参数守卫：摘除/释放执法要求至少一个实参
函数 调用无实参1674(节点 n) -> 布尔 {
    返回 n.附加 < 1;
}

// #1700 守卫辅助（闭集边界单点·分支词面收纳）
函数 非空串内置1674(字符串 文本) -> 布尔 {
    返回 字符串长度(文本) > 0;
}
