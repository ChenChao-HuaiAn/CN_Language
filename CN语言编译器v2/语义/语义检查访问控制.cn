// CN 自举编译器 v2 · 语义检查·类成员访问控制族（1029 新增拆分：1017 采样轮
//   p06 族「v2 访问控制零执法」根治——探针 n/q/s 三形态（外部读私有字段/
//   外部写私有字段/外部调私有方法）宿主全拒而 v2 全放行=零分叉铁律缺陷。
//   根因双源：①解析层类缺省段=公开（与宿主「类缺省私有」分叉——探针三形态
//   全部落在缺省段）；②判定逻辑内联分散且「保护」段编码缺失（私有/保护同值）。
//   本族为单点归属实现：沿继承链定位成员定义类 + 段值判定（公开/私有/保护
//   三态）+ 同类/派生类/友元函数豁免 + 宿主逐字文案。消费方=检查成员访问表达式
//   （字段读/写两态·语义检查.cn 340-a 升级点）与 检查调用表达式（实例方法
//   调用·语义检查表达式.cn 575-a 升级点）。
// 「先拆再加」纪律落点：判定实现不入 语义检查.cn（909 行已越 900 警戒线）·
//   新功能随族独立成文件（拆文件三件套=导入区块/公开:/包.cn 加载位）。
// 数据源：字段段=节点_类字段.子起点（0 私有/1 公开/2 保护·解析类.cn 建节点）；
//   方法段=节点_方法.修饰段位（4 公开〔位2〕/32 保护〔位5〕/0 私有——保护
//   不可用「段×4」直乘：位3=8 被静态方法修饰占用，见 解析类.cn 段修饰位1029）。
// 宿主对齐（src/cn_compiler/semantic/class_resolver_access.cpp checkAccess）：
//   公开任意可访问；私有仅同类（contextClass==owner）；保护同类+派生类；
//   友元函数授权豁免（友元类面 v2 解析未支持=诚实边界）；诊断文案
//   「无法访问 成员/方法 'x'（甲 的私有/保护成员）」与宿主逐字同构。

导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量
导入 IR;         // 查类基名/是否派生自/查友元授权 + 节点_* 常量
导入 协议常量;   // 335 协议常量独立包

公开:   // 全文件公开（供 语义检查/语义检查表达式 包内兄弟经合并全局池消费）

// 1029：方法修饰→段值（0 私有/1 公开/2 保护）。
//   段位编码：公开=位2（4）；保护=位5（32）——位3（8）被静态方法修饰占用
//   （生成类.cn 静态判定 /8%2），保护段值不可「段×4」直乘（2×4=8 静触静态位）。
//   其余修饰位（不安全1/常量2/友元16/虚拟64/重写128/抽象256）与 4/32 无交集，
//   本函数仅提取段位（解析期段编码闭集三态：0/4/32——前两支已枚举 1/2）。
函数 方法段值1029(整64 修饰值) -> 整64 {
    如果 ((修饰值 / 4) % 2 == 1) { 返回 1; }
    如果 ((修饰值 / 32) % 2 == 1) { 返回 2; }
    // 段位 4/32 均未置=私有段（段编码闭集 0/4/32·0 为缺省段位）
    返回 0;
}

// 1029：类成员可见性检查单点（字段与实例方法同判）——
//   沿继承链定位成员定义类（字段=节点_类字段/方法=节点_方法），段可见性仅
//   公开放行；私有=同类豁免（宿主 contextClass==owner.name）；保护=同类+
//   派生类豁免（是否派生自 沿链上溯含同类）；友元函数授权豁免（查友元授权·
//   宿主 friendFuncs 面）。未命中=成员不存在之情形——存在性诊断归属成员解析
//   检查与 IR 层各自通道（本函数不重复报·340-a 原件同口径）。
//   诚实边界：对象形态筛选（标识符对象）由调用方前置（340-a/575-a 同款）。
函数 检查成员可见性1029(向量<节点> 池, 整64 类名ID, 整64 成员名ID,
                       布尔 是方法请求, 向量<字符串>& 诊断) -> 空类型 {
    整64 归属类 = 类名ID;
    整64 守卫l = 0;
    当 (归属类 != 0 && 守卫l < 64) {
        可选<整64> 类节点l查 = 查类节点索引(归属类);
        整64 类节点l = 0 - 1;
        如果 (类节点l查.有值) { 类节点l = 类节点l查.值; }
        布尔 类节点有效l = 类节点l >= 0 && 类节点l < 整64(池.大小());
        如果 (类节点有效l) {
            节点 类值l = 池.元素(整32(类节点l));
            整64 扫l = 整64(类值l.子起点);
            当 (扫l < 整64(类值l.子终点)) {
                节点 成员l = 池.元素(整32(扫l));
                布尔 命中l = 假;
                如果 (是方法请求 && 成员l.类型 == 节点_方法 &&
                    整64(成员l.文本) == 成员名ID) { 命中l = 真; }
                如果 (!是方法请求 && 成员l.类型 == 节点_类字段 &&
                    整64(成员l.文本) == 成员名ID) { 命中l = 真; }
                如果 (命中l) {
                    整64 段l = 整64(成员l.子起点);
                    如果 (是方法请求) { 段l = 方法段值1029(整64(成员l.修饰)); }
                    如果 (段l == 1) { 返回; }
                    // 1637：可选显式分流——无值=非类上下文（当前类l 保持 0·
                    //   下方豁免 !=0 门契约不变）
                    整64 当前类l = 0;
                    可选<整64> 当前类l查 = 取当前检查类ID();
                    如果 (当前类l查.有值) { 当前类l = 当前类l查.值; }
                    布尔 豁免l = 假;
                    // 同类豁免（宿主 contextClass==owner.name）：私有/保护均放行
                    如果 (当前类l != 0 && 当前类l == 归属类) { 豁免l = 真; }
                    // 派生类豁免（宿主子类沿链·仅保护段；是否派生自 含同类）
                    如果 (段l == 2 && 当前类l != 0 &&
                        是否派生自(当前类l, 归属类)) { 豁免l = 真; }
                    // 友元函数豁免（宿主 friendFuncs——当前函数名∈归属类授权表）
                    布尔 友元l = 查友元授权(归属类, 查当前语义函数名());
                    如果 (!豁免l && 友元l) { 豁免l = 真; }
                    如果 (豁免l) { 返回; }
                    字符串 段名l = "私有";
                    如果 (段l == 2) { 段名l = "保护"; }
                    字符串 能指l = "成员";
                    如果 (是方法请求) { 能指l = "方法"; }
                    表诊断(诊断, "[错误] 无法访问 " + 能指l + " '" +
                                  驻留文本(成员名ID) + "'（" + 驻留文本(归属类) +
                                  " 的" + 段名l + "成员）");
                    返回;
                }
                扫l++;
            }
        }
        // 1541 B2：无值=链到此为止（原 0 终止循环·中断同效）
        可选<整64> 基查l = 查类基名(归属类);
        如果 (!基查l.有值) { 中断; }
        如果 (基查l.有值) { 归属类 = 基查l.值; }
        守卫l++;
    }
}
