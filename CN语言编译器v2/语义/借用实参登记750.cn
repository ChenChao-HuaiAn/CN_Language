// CN 自举编译器 v2 · 借用实参根登记（750 复审 P0-A·语义层辅助）
// 职责：把「引用实参隐式取址」的两种语义层事实登记到 IR 中立表（借用实参根
//   750.cn）：
//   ① 接口方法调用引用位扫描（P0-A-2）：接口方法无池节点池方法表，借用位扫描202
//      的类/构造入口覆盖不到——按接口方法参数串段尾 '&' 解析引用位后复用
//      借用位扫描202（引用位 × 实参根标识符 权威扫描 + 已扫描标记）；
//   ② 成员链接收者保守登记（P0-A-4）：`对象.内层.记(s)` 等接收者非标识符/类型
//      推导失败的调用——静态不可追踪，按 fail-closed 登记该调用全部标识符实参
//      根（少优化但绝不错值），并标记已扫描（安全网放行依据）。
// 归属：语义层辅助（依赖 语法/IR 中立表），与 语义检查实参 同包。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 查调用实参末位
导入 IR;         // 登记引用实参根/标记引用实参扫描（借用实参根750）
导入 协议常量;   // 驻留/驻留文本/参数段工具
导入 借出检查;   // 追加64
导入 语义检查实参;   // 借用位扫描202（同包兄弟·前向引用合并全局池解析）

公开:

// 登记调用全部标识符实参根（成员链/推导失败保守面·fail-closed）
不安全 函数 登记标识符实参根们750(向量<节点> 池, 整64 调用索引,
                          整64 实参数) -> 空类型 {
    整64 i = 0;
    当 (i < 实参数) {
        可选<整64> 末位查 = 查调用实参末位(调用索引, i);
        整64 末位 = 0 - 1;   // 1360 批5 结果化：miss=无值→-1 哨兵（下方合法判定同源）
        如果 (末位查.有值) { 末位 = 末位查.值; }
        布尔 末位合法 = 末位 >= 0 && 末位 < 整64(池.大小());
        如果 (末位合法) {
            节点 末 = 池.元素(整32(末位));
            如果 (末.类型 == 节点_标识符) {
                登记引用实参根(调用索引, i, 整64(末.文本));
            } 否则 如果 (末.类型 == 节点_成员 || 末.类型 == 节点_下标 ||
                         末.类型 == 节点_解引用) {
                // P1-2（750 复审5 零分叉）：成员/下标/解引用实参根不可追踪
                //   （外.内.记(槽.名)）→ 未登记哨兵（消费端整函数拒绝·
                //   与宿主取地址非标识符 hasAlias 同口径）；字面量/纯算术放行
                标记引用实参未登记750(调用索引);
            }
        }
        如果 (!末位合法) {
            // P2（750 复审5）：实参末位表 miss（解析层区间异常）→ 同置哨兵
            //   （fail-closed 与注释声称对齐）
            标记引用实参未登记750(调用索引);
        }
        i++;
    }
    标记引用实参扫描(调用索引);
}

// 成员链接收者借用位（P1-A·750 复审6）：`外.内.取(…)`——接收者非标识符时先按
//   接收者类型推导（容器方法接收者类型 支持成员链）+ 查类方法节点沿链 + 取方法
//   参数借位，得引用位后交 借用位扫描202 精确处理（值形参不抑制·引用位实参
//   根非标识符→未登记哨兵）；仅类型/方法/个数解析失败时整函数保守
//   （登记标识符实参根们750 = 标识符根登记 + 成员/下标/解引用哨兵）。
不安全 函数 成员链接收者借用位750(向量<节点> 池, 节点 被调, 整64 调用索引,
                           整64 实参数,
                           向量<映射<整64, 符号>>& 符号表,
                           向量<字符串>& 诊断) -> 空类型 {
    整64 接收者类型 = 容器方法接收者类型(池, 被调, 符号表);
    布尔 有类型 = 接收者类型 > 0;
    整64 类型 = 0;
    如果 (有类型) { 类型 = 成员方法剥星(接收者类型); }
    布尔 用户类面 = 有类型 && 是用户类_ID(类型);
    整64 方法节点 = 0 - 1;
    如果 (用户类面) {
        可选<整64> 方法节点查 = 查类方法节点沿链(池, 类型, 整64(被调.文本));
        // 1360 批5 结果化：miss=无值→-1 哨兵（有方法判定同源）
        如果 (方法节点查.有值) { 方法节点 = 方法节点查.值; }
    }
    布尔 有方法 = 用户类面 && 方法节点 >= 0;
    向量<整64> 引用位们 = 向量<整64>();
    向量<整64> 常量位们 = 向量<整64>();
    整64 个数 = 0;
    如果 (有方法) { 个数 = 取方法参数借位们(池, 方法节点, 引用位们, 常量位们); }
    布尔 精确 = 有方法 && 个数 == 实参数;
    如果 (精确) {
        借用位扫描202(池, 整32(调用索引), 实参数, 引用位们, 常量位们, 符号表, 诊断);
    } 否则 如果 (!精确) {
        // 签名/类型/个数解析失败 → 整函数保守（等价原行为）
        登记标识符实参根们750(池, 调用索引, 实参数);
    }
}

// 接口方法引用位扫描（参数串段尾 '&'=引用位 → 借用位扫描202 + 已扫描标记）
不安全 函数 接口方法引用位扫描750(向量<节点> 池, 整64 调用索引, 整64 实参数,
                           字符串 参数串,
                           向量<映射<整64, 符号>>& 符号表,
                           向量<字符串>& 诊断) -> 空类型 {
    向量<整64> 引用位们 = 向量<整64>();
    向量<整64> 常量位们 = 向量<整64>();
    整64 段数 = 参数段个数(参数串);
    整64 i = 0;
    当 (i < 段数) {
        整64 段ID = 函数指针参数段文本(参数串, i);
        整64 位 = 0;
        如果 (段ID != 0) {
            字符串 段名 = 字符串复制(驻留文本(段ID));
            布尔 有段名 = 字符串长度(段名) > 0;
            如果 (有段名) {
                整64 尾 = 整64(段名[整32(字符串长度(段名) - 1)]) & 255;
                如果 (尾 == 38) { 位 = 1; } 否则 { }
            } 否则 { }
        } 否则 { }
        追加64(引用位们, 位);
        // 接口参数串语法不支持 常量 引用（常量引用仅函数/方法形参语法）——常量位
        // 恒 0=不可达（本扫描只登记引用位不判互斥；若未来语法支持须按段文本附加
        // 257 取常量位，见 语义分析尾 参数借用位 附加>=256 口径）
        追加64(常量位们, 0);
        i++;
    }
    布尔 个数相符 = 段数 == 实参数;
    // 静默豁免上游已诊断: 个数不符已由 检查接口方法调用907 表诊断拒绝（本扫描不重复报·对位扫描仅在个数相符时进行）
    如果 (个数相符) {
        借用位扫描202(池, 整32(调用索引), 实参数, 引用位们, 常量位们,
                    符号表, 诊断);
    } 否则 { }
}
