// CN 自举编译器 v2 · 语义检查——调用实参转换检查（549）
// 职责：传参面「实参→形参」隐式转换合法性检查（宿主 semantic_call.cpp
//   checkDirectCall 逐参判定同构移植·442 实施轮呈报缺口收口）——单候选普通
//   函数调用（裸标识符被调·签名表唯一候选）逐实参判定：窄化/浮→整/混合
//   符号/字符·布尔·字符串源跨族等非法转换编译期拒绝。
// 根因（442 实施轮实证·195 注释「传参面随实参边界记录另轮」已知面）：v2
//   语义层对单候选调用不做实参→形参转换检查（全放行），宿主正确拒绝——
//   探针 442pd/442ph/442pj：吃整128(正64变量)（混合符号）/吃整32(浮64)
//   （浮→整）/吃整32(整64)（窄化）宿主 rc=1，v2 修前 rc=0 放行（运行出
//   错值/垃圾/窄化值）。
// 判定来源=宿主口径（不发明新规则）：
//   ① 变量面=宿主 model/type_system.cpp canConvert 标量矩阵——同符号严格
//      宽化放行/窄化拒；跨符号一律拒（55-c 方案A·Rust E0308）；128→64 同
//      符号窄化特例放行（方案C 2026-08-14）；字符↔整数互通；整→浮、浮32→
//      浮64 放行；浮→整/浮64→浮32 拒；字符*↔字符串放行；布尔·字符串源
//      仅同型；字符源→浮点拒（宿主 canConvert 实测 h1 拒）。
//   ② 字面量面=宿主 canConvertWithLiteral+canConvertArgNarrow——整数族双端
//      字面量按值域豁免（域内放行〔565 整字面量入域〕），整8/整16/正8/正16
//      目标一律放行（285·001 §3.7a 窄回绕豁免）；浮字面量按 f 后缀分型；
//      布尔/字符串字面量仅同型；字符字面量→整数/字符（→浮点宿主拒）。
// 诚实边界（检不出放行·防误伤）：成员/调用/下标/二元等表达式实参
//   （推导不可靠面·宿主类型全推导=v2 随推导完善收口）；指针/数组/引用变量
//   源；泛型参数名（模板态）；常量实参（v2 常量表恒登记整64 宽松口径）；
//   非标量目标（容器/类/结构体/接口/指针/引用/枚举名/函数指针/泛型名）——
//   该等面转换规则由各自通道（接口 413-b/引用包装等）承担；多候选（重载）
//   调用面（IR 层精确决议·语义层不细判）；负号+变量的推导不可靠面。
//   652（2026-10-16）例外：显式取址实参（节点_取地址）面独立判定（引用形参/
//   标量目标/指针目标三分支——宿主决议层 conversionLevel/canConvert 同构），
//   见主循环 652 条款注；推导界外（复合操作数）维持放行（诚实边界）。
// 挂点=检查调用表达式 普通函数直调/签名回退两路径（宿主 checkDirectCall
//   同面）；方法/构造/函数指针调用面由各自检查通道承担（本轮不收口）。

导入 容器::向量;
导入 映射集合;
导入 借出检查;   // 806/202：追加64（向量追加辅助）；检查函数级借用族同包兄弟
导入 语法;       // 节点_*/查调用实参末位（解析表达式中）
导入 IR;         // 查函数签名个数/查函数签名参数串/是枚举名/转换类型位宽等价面
导入 协议常量;   // 驻留/驻留文本（中立层）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 无防重表设计说明（549 实证）：本检查同时被「静默推导通道」到达——声明位/
//   赋值位对调用初值的类型推导（表达式类型ID 族）会先以静默诊断缓冲调用
//   检查调用表达式（诊断被吞弃·174 惯例）；权威线性遍历随后再到达。
//   若加「已查调用点」防重表，静默通道先行登记会把**权威通道的诊断一并
//   挡掉**（b/d 探针实录：rc=0 但语义错误丢失）。判定本体幂等（只读池+
//   按值判定），各通道各自判定即安全——静默通道诊断被吞、权威通道可见，
//   零双报（返回位单通道·声明位/表达式语句位静默+权威两通道均单报实测）。

// 目标类型文本是否本检查判定面（宿主 canConvert 标量矩阵）——非标量目标
//   （容器/类/结构体/接口/指针/引用/枚举名/泛型名等）一律放行（诚实边界）
函数 是实参标量目标文本(字符串 目标文本) -> 布尔 {
    如果 (是转换整数族文本(目标文本) || 是转换浮点族文本(目标文本)) { 返回 真; }
    返回 字符串比较(目标文本, "布尔") || 字符串比较(目标文本, "字符") ||
           字符串比较(目标文本, "字符串");
}

// 字符串含后缀/结构字节判定（& * [ < > 任一——引用/指针/数组/泛型截断段
//   形态非纯标量名，放行防误伤）
函数 文本含非标量字节(字符串 文本) -> 布尔 {
    整64 i = 0;
    当 (i < 字符串长度(文本)) {
        整64 字节 = 整64(文本[整32(i)]) & 255;
        如果 (字节 == 38 || 字节 == 42 || 字节 == 91 || 字节 == 60 || 字节 == 62) {
            返回 真;
        }
        i++;
    }
    返回 假;
}

// 整数字面量末端→窄整数目标回绕豁免（宿主 canConvertArgNarrow 语义·
//   285·001 §3.7a：仅整8/整16/正8/正16 目标放行）
函数 是窄回绕豁免目标(字符串 目标文本) -> 布尔 {
    返回 字符串比较(目标文本, "整8") || 字符串比较(目标文本, "整16") ||
           字符串比较(目标文本, "正8") || 字符串比较(目标文本, "正16");
}

// 字面量实参转换非法判定（宿主 canConvertWithLiteral+canConvertArgNarrow
//   口径；源末=整/负号/浮/布尔/字符串/字符字面量族节点）
函数 字面量实参转换非法(向量<节点> 池, 整32 源末索引, 节点 源末,
                       字符串 目标文本, 整64 目标类型ID,
                       向量<映射<整64, 符号>>& 符号表) -> 布尔 {
    布尔 目标整数 = 是转换整数族文本(目标文本);
    布尔 目标浮点 = 是转换浮点族文本(目标文本);
    如果 (源末.类型 == 节点_整数字面量 || 源末.类型 == 节点_负号) {
        // 590（2026-10-16）：入口形态判定补多重负号链（负号链至字面量）——
        //   链形态与单层字面量形态同走值域通道（隐式转换合法 已链化；
        //   宿主解析期负号折叠等价）；修前链落下方 740 推导（-1 或常量级
        //   类型）与宿主折叠形态判定错位。
        如果 (是整数字面量末端(池, 源末索引) || 负号链至字面量(池, 源末索引)) {
            如果 (目标整数) {
                // 宿主 canConvertType 侧（同符号宽化/同型）由隐式转换合法 承担；
                //   字面量值域豁免（565 入域）同通道；域外窄目标落 285 回绕豁免
                如果 (隐式转换合法(池, 源末索引, 目标类型ID, 符号表)) { 返回 假; }
                返回 !是窄回绕豁免目标(目标文本);
            }
            如果 (目标浮点 || 字符串比较(目标文本, "字符")) { 返回 假; }   // 整→浮/字符 放行
            返回 真;   // 布尔/字符串目标：宿主拒（canConvert 整数→布尔/字符串 假）
        }
        // 740：负号+非字面量（-整32变量）→推导负号结果类型（可靠面·转换推导
        //   族 740 新增负号分支）后按数值矩阵判定——修前「检不出放行」=实参位
        //   负号表达式静默截断分叉（宿主 -乙32 实参拒·v2 放行·U 探针族实录）
        整64 负源740 = 推导源类型ID静默(池, 源末索引, 符号表);
        如果 (负源740 <= 0) { 返回 假; }
        返回 数值源实参矩阵非法(字符串复制(驻留文本(负源740)), 目标文本);
    }
    如果 (源末.类型 == 节点_浮点字面量) {
        如果 (目标浮点) { 返回 !隐式转换合法(池, 源末索引, 目标类型ID, 符号表); }
        返回 真;   // 浮→整/字符/布尔/字符串：宿主拒
    }
    如果 (源末.类型 == 节点_布尔字面量) { 返回 !字符串比较(目标文本, "布尔"); }
    如果 (源末.类型 == 节点_字符串字面量) { 返回 !字符串比较(目标文本, "字符串"); }
    如果 (源末.类型 == 节点_字符字面量) {
        // 字符→整数/字符放行（字符↔整数互通）；字符→浮点宿主拒（h1 实测面）
        返回 !(目标整数 || 字符串比较(目标文本, "字符"));
    }
    返回 假;   // 非字面量族防御（调用方已分类）
}

// 变量实参转换非法判定（宿主 canConvert 标量矩阵同构·标识符纯标量面）
函数 变量实参转换非法(向量<节点> 池, 整32 源末索引, 节点 源末,
                     字符串 目标文本, 整64 目标类型ID,
                     向量<映射<整64, 符号>>& 符号表) -> 布尔 {
    整64 源名 = 整64(源末.文本);
    整64 指针所指 = 查语义指针变量(源名);
    如果 (指针所指 != -1) {
        // 指针变量源（查语义指针变量 返回所指元素类型名）：仅「字符*」（所指
        //   =字符）参与标量目标判定——宿主 canConvert 字符*↔字符串 明文互通，
        //   字符*→标量拒绝（h7 探针 字符*→整32 宿主拒）；其余指针源（整32* 等）
        //   =诚实边界放行（指针层判定不越过指针变量表语义）
        如果 (!字符串比较(字符串复制(驻留文本(指针所指)), "字符")) { 返回 假; }
        返回 !字符串比较(目标文本, "字符串");
    }
    如果 (表查找种类(符号表, 源名) == 符号_常量) { 返回 假; }   // 常量实参放行（宽松口径）
    整64 源类型ID = 表查找类型ID(符号表, 源名);
    如果 (源类型ID <= 0) { 返回 假; }
    如果 (是泛型参数名(源类型ID)) { 返回 假; }   // 模板态 T/K/V 放行（宿主模板态同款）
    字符串 源文本 = 字符串复制(驻留文本(源类型ID));
    如果 (字符串长度(源文本) == 0) { 返回 假; }
    如果 (字符串比较(源文本, "未知") || 字符串比较(源文本, "空类型")) { 返回 假; }
    // 字符* 源（引用/借用视图）：宿主 canConvert 字符*↔字符串 明文互通——
    //   字符串目标放行；其余标量目标拒（h7 探针 字符*→整32 宿主拒）
    如果 (字符串比较(源文本, "字符*")) { 返回 !字符串比较(目标文本, "字符串"); }
    如果 (文本含非标量字节(源文本)) { 返回 假; }   // 引用/指针/数组/泛型截断段
    如果 (字符串比较(源文本, 目标文本)) { 返回 假; }   // 同型
    布尔 目标整数 = 是转换整数族文本(目标文本);
    布尔 目标浮点 = 是转换浮点族文本(目标文本);
    // 枚举源：宿主 canConvert 枚举→整数族放行（C 风格整32 常量源）；其余标量目标拒
    如果 (是枚举名(源类型ID)) { 返回 !目标整数; }
    布尔 源整数 = 是转换整数族文本(源文本);
    布尔 源浮点 = 是转换浮点族文本(源文本);
    如果 (源整数 && 目标整数) {
        // 55-c 方案A：跨符号（同秩/异秩）一律拒绝隐式——混合符号静默改值语义
        如果 (是无符号类型ID(驻留(源文本)) != 是无符号类型ID(驻留(目标文本))) {
            返回 真;
        }
        // 方案C（2026-08-14）：128→64 同符号窄化特例放行（宿主 canConvert 明文）
        如果 ((字符串比较(源文本, "整128") || 字符串比较(源文本, "正128")) &&
            (字符串比较(目标文本, "整64") || 字符串比较(目标文本, "正64"))) {
            返回 假;
        }
        // 严格宽化放行（宿主 rankFrom < rankTo）；同宽/窄化拒
        返回 转换类型位宽(源文本) >= 转换类型位宽(目标文本);
    }
    如果 (源整数 && (目标浮点 || 字符串比较(目标文本, "字符"))) { 返回 假; }   // 整→浮/字符放行
    如果 (源浮点 && 目标浮点) {
        如果 (字符串比较(源文本, "浮32") && 字符串比较(目标文本, "浮64")) { 返回 假; }
        返回 真;   // 浮64→浮32 窄化：宿主拒
    }
    如果 (字符串比较(源文本, "字符")) {
        // 字符源：→整数/字符放行；→浮点/布尔/字符串拒（宿主字符族规则）
        返回 !(目标整数 || 字符串比较(目标文本, "字符"));
    }
    // 布尔/字符串/类/结构体/容器/函数指针等其余源 → 标量目标：宿主 canConvert 假
    返回 真;
}

// 单实参转换非法判定（字面量族/标识符变量族两分类·其余节点=推导不可靠面放行）
函数 实参转换非法(向量<节点> 池, 整32 源末索引, 整64 目标类型ID,
                  向量<映射<整64, 符号>>& 符号表) -> 布尔 {
    如果 (目标类型ID <= 0) { 返回 假; }
    字符串 目标文本 = 字符串复制(驻留文本(目标类型ID));
    如果 (!是实参标量目标文本(目标文本)) { 返回 假; }
    如果 (源末索引 < 0 || 源末索引 >= 整32(池.大小())) { 返回 假; }
    节点 源末 = 池.元素(源末索引);
    // 919-final（2026-10-18 用户裁决「字面量单点判域·Rust 口径」）：区间
    //   子树扫描先于形态分派——含变量二元/三元/嵌套等一切实参形态内任一
    //   整数字面量超形参目标域 → 非法拒（单点判域；修前二元分支落 740
    //   数值矩阵的 128→64 特例面放行/三元落诚实边界放行=双侧分叉；宿主
    //   canConvertWithLiteral 单点扫描已拒·双侧对齐）。
    如果 (是转换整数族文本(目标文本) &&
        区间含超域字面量919(池, 源末索引, 目标文本)) { 返回 真; }
    如果 (源末.类型 == 节点_整数字面量 || 源末.类型 == 节点_负号 ||
        源末.类型 == 节点_浮点字面量 || 源末.类型 == 节点_布尔字面量 ||
        源末.类型 == 节点_字符串字面量 || 源末.类型 == 节点_字符字面量) {
        返回 字面量实参转换非法(池, 源末索引, 源末, 目标文本, 目标类型ID, 符号表);
    }
    如果 (源末.类型 == 节点_标识符) {
        返回 变量实参转换非法(池, 源末索引, 源末, 目标文本, 目标类型ID, 符号表);
    }
    如果 (源末.类型 == 节点_二元运算) {
        // 740：算术/位二元表达式实参（`吃8(乙32 + 丙32)`）——推导二元结果
        //   类型（转换推导族 740 新增·可靠面）后按数值矩阵判定。修前「推导
        //   不可靠面放行」=实参位静默截断分叉（宿主拒「未找到匹配的函数」·
        //   v2 放行产码·M 探针实录）；推导不出（调用/成员操作数）=既有诚实
        //   边界放行不变。
        整64 表达源740 = 推导源类型ID静默(池, 源末索引, 符号表);
        如果 (表达源740 <= 0) { 返回 假; }
        返回 数值源实参矩阵非法(字符串复制(驻留文本(表达源740)), 目标文本);
    }
    返回 假;   // 成员/调用/下标/取地址/三元等=推导不可靠面放行（诚实边界）
}

// 740：数值源实参标量矩阵（二元/负号表达式推导源专用·宿主 canConvert 数值
//   矩阵同构）——同型/同符号宽化/128→64 特例放行；窄化/窄浮/浮→整/跨符号拒。
函数 数值源实参矩阵非法(字符串 源文本, 字符串 目标文本) -> 布尔 {
    如果 (字符串比较(源文本, 目标文本)) { 返回 假; }   // 同型
    布尔 源整数740 = 是转换整数族文本(源文本);
    布尔 目标整数740 = 是转换整数族文本(目标文本);
    布尔 源浮点740 = 是转换浮点族文本(源文本);
    布尔 目标浮点740 = 是转换浮点族文本(目标文本);
    如果 (源整数740 && 目标整数740) {
        // 55-c 方案A：跨符号一律拒绝（混合符号面同构）
        如果 (是无符号类型ID(驻留(源文本)) != 是无符号类型ID(驻留(目标文本))) {
            返回 真;
        }
        // 方案C（2026-08-14）：128→64 同符号窄化特例放行
        如果 ((字符串比较(源文本, "整128") || 字符串比较(源文本, "正128")) &&
            (字符串比较(目标文本, "整64") || 字符串比较(目标文本, "正64"))) {
            返回 假;
        }
        // 严格宽化放行；同宽/窄化拒
        返回 转换类型位宽(源文本) >= 转换类型位宽(目标文本);
    }
    如果 (源整数740 && (目标浮点740 || 字符串比较(目标文本, "字符"))) { 返回 假; }
    如果 (源浮点740 && 目标浮点740) {
        如果 (字符串比较(源文本, "浮32") && 字符串比较(目标文本, "浮64")) { 返回 假; }
        返回 真;   // 浮64→浮32 窄化：宿主拒
    }
    返回 真;   // 浮→整/布尔/字符串等：宿主拒
}

// 诊断用源类型文本（标识符=表查找类型；字面量=推导源类型文本 565 同款；
//   不可推导回退形参文本占位）
函数 实参源类型文本(向量<节点> 池, 整32 源末索引,
                  向量<映射<整64, 符号>>& 符号表, 字符串 回退) -> 字符串 {
    如果 (源末索引 >= 0 && 源末索引 < 整32(池.大小())) {
        节点 源末 = 池.元素(源末索引);
        如果 (源末.类型 == 节点_标识符) {
            整64 源类型ID = 表查找类型ID(符号表, 整64(源末.文本));
            如果 (源类型ID > 0) { 返回 字符串复制(驻留文本(源类型ID)); }
        }
    }
    返回 推导源类型文本(池, 源末索引, 符号表, 回退);
}

// ==================== 挂点主入口 ====================
// 检查调用实参转换（检查调用表达式 普通函数直调/签名回退两路径调用）——
//   仅裸标识符被调+签名表唯一候选（单候选面=任务缺口精确面；重载多候选=
//   IR 层精确决议域诚实边界）；形参表=签名表参数串（声明收集 登记·跨模块
//   同源），深度切段取位；文案对齐宿主「函数 'X' 第 i 个参数无法将 'A'
//   隐式转换为 'B'」（semantic_call.cpp checkDirectCall 报告原文）。
函数 检查调用实参转换(向量<节点> 池, 整32 节点索引,
                    向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    如果 (节点索引 < 0 || 节点索引 >= 整32(池.大小())) { 返回; }
    节点 n = 池.元素(节点索引);
    如果 (n.类型 != 节点_调用 || n.附加 < 1 || n.子起点 <= 0) { 返回; }
    如果 (整64(n.子起点) >= 整64(池.大小())) { 返回; }
    节点 被调节点 = 池.元素(整32(n.子起点));
    如果 (被调节点.类型 != 节点_标识符) { 返回; }   // 方法/限定面另通道
    整64 实参数 = 整64(n.附加);
    整64 被调名 = 整64(被调节点.文本);
    整64 键基 = 三级键基查找(符号表, 被调名, 实参数);
    如果 (键基 < 0) { 返回; }
    整64 候选数 = 查函数签名个数(键基);
    如果 (候选数 != 1) { 返回; }   // 单候选面（多候选/非函数=诚实边界）
    整64 参数串ID = 查函数签名参数串(键基 * 键位移);
    如果 (参数串ID < 0) { 返回; }
    字符串 参数串 = 字符串复制(驻留文本(参数串ID));
    如果 (字符串长度(参数串) == 0) { 返回; }
    如果 (参数串段数(参数串) < 实参数) { 返回; }   // 个数不符面另通道（防双报）
    字符串 被调文本 = 字符串复制(驻留文本(被调名));
    整64 i = 0;
    当 (i < 实参数) {
        整64 源末 = 查调用实参末位(整64(节点索引), i);
        如果 (源末 >= 0 && 源末 < 整64(池.大小())) {
            字符串 形参文本 = 取参数段(参数串, i);
            如果 (字符串长度(形参文本) > 0) {
                // 652（2026-10-16·623 邻接既存分叉根治）：**取地址实参判定面**——
                //   修前 549 对取地址实参整体诚实边界放行，而 表达式类型ID 对
                //   &x 兜底整64 → 「&x 传引用/标量形参」全路径放行=调用面以为
                //   类型匹配 → IR 层对 &x 再取址=传地址整数值给引用槽=被调方按
                //   垃圾地址解引用（运行期写飞·安全缺陷；探针 target/probe652：
                //   宿主 rc=1/v2p 修前 rc=0）。修①（语义检查取址解引用.cn 652
                //   块）已让 &X 推导=真实指针类型（整64* 等），本条款=实参匹配
                //   面联动（宿主决议层 conversionLevel/canConvert 判定同构）：
                //   ①引用形参（段尾 '&'·可变与常量引用统一）=须绑定同类型左值
                //     ——&x 是整64* 指针非整64 左值 → 拒（宿主 resolveOverload
                //     「未找到匹配的函数」逐字对齐；显式 &左值在 623 左值面=H3
                //     幂等放行〔宿主同判〕，本条款在类型面补拒·单诊断不双报）。
                //   ②标量形参目标（整数族/浮点/布尔/字符/字符串）=指针 ≠ 标量
                //     → 拒（宿主同拒实证）；特例=&字符变量（字符*）传 字符串
                //     形参=宿主 canConvert 字符*↔字符串 明文互通 → 放行。
                //   ③纯指针形参目标（文本尾 '*'）=推导文本逐字比较（整64*→
                //     整64* 放行/整64**→整64* 拒）；推导界外（复合操作数）维持
                //     放行（诚实边界）。非标量其他目标（类/结构体等）=既有
                //     诚实边界放行。
                节点 源末652 = 池.元素(整32(源末));
                如果 (源末652.类型 == 节点_取地址) {
                    整64 形参尾652 = 整64(形参文本[整32(字符串长度(形参文本) - 1)]) & 255;
                    字符串 取址源652 = 推导检查类型文本(池, 整32(源末), 符号表);
                    布尔 取址拒652 = 假;
                    如果 (形参尾652 == 38) {
                        取址拒652 = 真;
                    } 否则 如果 (是实参标量目标文本(形参文本)) {
                        如果 (!(字符串比较(形参文本, "字符串") &&
                              字符串比较(取址源652, "字符*"))) {
                            取址拒652 = 真;
                        }
                    } 否则 如果 (!字符串比较(取址源652, "") &&
                              ((整64(形参文本[整32(字符串长度(形参文本) - 1)]) & 255) == 42)) {
                        取址拒652 = !字符串比较(取址源652, 形参文本);
                        // 869（#234 指针派生链面·探针15 实锤）：派生类指针实参 →
                        //   基类指针形参（&a〔方*〕传 形状*）=同地址上行转换合法
                        //   （001 §8.6 指针段·宿主 canConvertType 放行=探针15
                        //   宿主 rc=0 锚）；v2 原逐字比较拒=234 指针面残余分叉
                        //   （616 正测面同族）。
                        如果 (取址拒652 &&
                            指针派生链合法869(取址源652, 形参文本)) {
                            取址拒652 = 假;
                        }
                    }
                    如果 (取址拒652) {
                        表诊断(诊断, "[错误] 未找到匹配的函数 '" + 被调文本 +
                                       "'（参数个数或类型不匹配）");
                    }
                }
                // 非取址实参=常规转换检查（与 652 取址判定互斥·显式双分流——
                //   取址分支内已自报不重查；882 门禁 else 业务清偿=正向双 if）
                如果 (源末652.类型 != 节点_取地址) {
                    整64 目标ID = 驻留(形参文本);
                    // 869（#234 切片 v2 侧残余面补齐）：类切片实参（派生类值 →
                    //   基类值形参）——宿主编译器决议层 conversionLevel 对值形态
                    //   判不可转换 → 决议失败报「未找到匹配的函数」（逐参文案
                    //   不报·resolveOverload bestKey 空早退）；本处对齐该行为与
                    //   文案（v2 修前静默放行且传参按基类大小截断拷贝=切片事故
                    //   本体）。引用/指针形参 = 同地址合法面，是切片形态234 尾
                    //   字符前置放行（616 正测零误伤）。
                    布尔 切片实参869 = 是切片形态234(
                        推导类源类型869(池, 整32(源末), 符号表), 目标ID);
                    如果 (切片实参869) {
                        表诊断(诊断, "[错误] 未找到匹配的函数 '" + 被调文本 +
                                      "'（参数个数或类型不匹配）");
                    } 否则 如果 (!切片实参869 &&
                               实参转换非法(池, 整32(源末), 目标ID, 符号表)) {
                        表诊断(诊断, "[错误] 函数 '" + 被调文本 + "' 第 " +
                                       整数转字符串(i + 1) + " 个参数无法将 '" +
                                       实参源类型文本(池, 整32(源末), 符号表, 形参文本) +
                                       "' 隐式转换为 '" + 形参文本 + "'");
                    }
                }
            }
        }
        i++;
    }
}

// ==================== 623（v2 引用实参须左值·宿主 wrapRefArgs 同判据对齐） ====================
// 568 实施轮呈报既存分叉（466 时代）：引用形参传非左值实参（字面量/纯右值）——
//   宿主 wrapRefArgs 编译期拒（语义层单一归属·普通函数/构造/实例/静态/接口
//   五路径一致），v2 全路径放行（IR 层物化临时槽取地址=右值无处取址语义缺口，
//   被调方写参落临时槽=静默丢写·Rust &mut 同判编译错误）。修法=本检查
//   （语义层只读判定·v2 实参取地址归 IR 层 回扫实参取地址，职责不迁移）。
//   规范依据=plans/001 §参数传递语义（056 甲）：T& 引用参数=编译器取实参
//   左值地址的引用传递；「物化临时槽」豁免仅限类类型按值形参，引用形参无豁免。

// 调用参数串ID623（按被调形态分派取签名参数串；0=取不到 → 诚实边界放行）：
//   ① 被调=标识符：结果/可选构造内置（正常/错误/某些·无引用形参面）放行；
//      「类名::方法」=静态方法（宿主族C4 wrapRefArgs 同面）；「模块::函数」=
//      模块成员键基（检查限定调用 同源）；用户类名裸调=构造（构造路径
//      wrapRefArgs 同面）；其余=普通函数直调（三级键基唯一候选——多候选
//      重载/泛型实例签名表取不到=549 同款诚实边界放行）。
//   ② 被调=成员（实例方法 对象.方法 / 接口方法 接口变量.方法）：对象须为
//      标识符（成员链/调用返回对象面=诚实边界）；对象类型=接口名 → 接口方法
//      参数串（接口路径 wrapRefArgs 同面）；否则类方法参数串（miss 时剥泛型
//      实例基名重试·936 导入类回退同口径）。
//   ③ 其他被调形态（函数指针 480 等）→ 放行（宿主 fnptr 调用路径无
//      wrapRefArgs·同放行口径零分叉）。
函数 调用参数串ID623(向量<节点> 池, 节点 调用n623,
                  向量<映射<整64, 符号>>& 符号表) -> 整64 {
    节点 被调p623 = 池.元素(整32(调用n623.子起点));
    整64 实参数p623 = 整64(调用n623.附加);
    // ① 被调=标识符（普通函数直调/构造/限定静态/结果构造内置）
    如果 (被调p623.类型 == 节点_标识符) {
        字符串 被调文本p623 = 字符串复制(驻留文本(整64(被调p623.文本)));
        如果 (字符串比较(被调文本p623, "正常") || 字符串比较(被调文本p623, "错误") ||
             字符串比较(被调文本p623, "某些")) {
            返回 0;   // 结果/可选构造内置：形参全值面·无引用形参
        }
        字符串 限定段q623 = "";
        字符串 符号段q623 = "";
        如果 (拆限定名(被调文本p623, 限定段q623, 符号段q623) == 1) {
            如果 (是用户类(限定段q623) &&
                 是类静态方法(整64(驻留(限定段q623)), 整64(驻留(符号段q623)))) {
                整64 静串q623 = 查类方法参数串(整64(驻留(限定段q623)),
                                          整64(驻留(符号段q623)));
                如果 (静串q623 > 0) { 返回 静串q623; }
                返回 0;
            }
            整64 限键基q623 = 查模块成员键基(整64(驻留(限定段q623)),
                                        整64(驻留(符号段q623)));
            如果 (限键基q623 >= 0) {
                整64 限串q623 = 查函数签名参数串(限键基q623 * 键位移);
                如果 (限串q623 > 0) { 返回 限串q623; }
            }
            返回 0;
        }
        如果 (是用户类(被调文本p623)) {
            整64 构造串p623 = 查类构造参数串(整64(驻留(被调文本p623)), 实参数p623);
            如果 (构造串p623 > 0) { 返回 构造串p623; }
            返回 0;
        }
        整64 键基p623 = 三级键基查找(符号表, 整64(被调p623.文本), 实参数p623);
        如果 (键基p623 < 0) { 返回 0; }
        如果 (查函数签名个数(键基p623) != 1) { 返回 0; }
        整64 签串p623 = 查函数签名参数串(键基p623 * 键位移);
        如果 (签串p623 > 0) { 返回 签串p623; }
        返回 0;
    }
    // ② 被调=成员（实例方法/接口方法——宿主实例/接口路径 wrapRefArgs 同面）
    如果 (被调p623.类型 == 节点_成员 && 被调p623.子起点 > 0) {
        节点 对象p623 = 池.元素(整32(被调p623.子起点));
        如果 (对象p623.类型 != 节点_标识符) { 返回 0; }
        整64 对象类型p623 = 表查找类型ID(符号表, 整64(对象p623.文本));
        如果 (对象类型p623 <= 0) {
            对象类型p623 = 整64(对象p623.文本);   // 936 导入类回退同口径（miss 下方查询自证）
        }
        字符串 类型文本p623 = 字符串复制(驻留文本(对象类型p623));
        整64 方法名p623 = 整64(被调p623.文本);
        如果 (是接口名ID(驻留(类型文本p623))) {
            整64 接串p623 = 查接口方法参数串(驻留(类型文本p623), 方法名p623);
            如果 (接串p623 > 0) { 返回 接串p623; }
            返回 0;
        }
        整64 类串p623 = 查类方法参数串(驻留(类型文本p623), 方法名p623);
        如果 (类串p623 <= 0) {
            字符串 基名p623 = 剥实例基名(类型文本p623);
            如果 (字符串长度(基名p623) > 0 && !字符串比较(基名p623, 类型文本p623)) {
                类串p623 = 查类方法参数串(驻留(基名p623), 方法名p623);
            }
        }
        如果 (类串p623 > 0) { 返回 类串p623; }
        返回 0;
    }
    返回 0;
}

// 检查引用实参左值（623）：引用形参（段尾 '&'）的实参须为左值——宿主
//   SemanticAnalyzer::wrapRefArgs 左值判据逐字对齐：
//     显式 &左值=放行（宿主 H3 幂等同判）；标识符=符号种类∈{变量,参数,常量}
//     （宿主 lookupVar 判据——函数/结构体名 miss 同拒）；成员/下标/解引用=
//     左值（宿主 Index/Member/SelfExpr+Deref 同判；「自身」裸标识符检查类
//     方法时已注册为变量→标识符分支覆盖）。其余形态（字面量/调用/算术/
//     三元/结构体构造等）=右值 → 编译期拒绝。
//   挂点=检查调用表达式 统一入口（五路径全覆盖）；幂等只读池（不改写节点
//     ——v2 实参取地址归 IR 层 回扫实参取地址；静默通道先到诊断被吞弃、
//     权威通道可见=549 零双报惯例）。
//   诊断文案与宿主 semantic_call.cpp wrapRefArgs 逐字一致（dual 负测锚·
//     诊断一致性=零分叉的一部分）。
函数 检查引用实参左值(向量<节点> 池, 整32 节点索引,
                  向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    如果 (节点索引 < 0 || 节点索引 >= 整32(池.大小())) { 返回; }
    节点 n = 池.元素(节点索引);
    如果 (n.类型 != 节点_调用 || n.附加 < 1 || n.子起点 <= 0 ||
         整64(n.子起点) >= 整64(池.大小())) { 返回; }
    整64 参数串ID623 = 调用参数串ID623(池, n, 符号表);
    如果 (参数串ID623 <= 0) { 返回; }
    字符串 参数串623 = 字符串复制(驻留文本(参数串ID623));
    如果 (字符串长度(参数串623) == 0) { 返回; }
    整64 实参数623 = 整64(n.附加);
    如果 (参数串段数(参数串623) < 实参数623) { 返回; }   // 个数错位面另通道（防双报·549 同款）
    整64 i623 = 0;
    当 (i623 < 实参数623) {
        字符串 形参段623 = 取参数段(参数串623, i623);
        整64 段尾位623 = 整64(字符串长度(形参段623)) - 1;
        // 引用形参判据=段文本尾字节 38='&'（宿主 isReference 同判·432-b/552 单一归属同源）
        如果 (段尾位623 >= 0 &&
             ((整64(形参段623[整32(段尾位623)]) & 255) == 38)) {
            整64 末位623 = 查调用实参末位(整64(节点索引), i623);
            如果 (末位623 >= 0 && 末位623 < 整64(池.大小())) {
                节点 实参623 = 池.元素(整32(末位623));
                布尔 是左值623 = 假;
                如果 (实参623.类型 == 节点_取地址) {
                    是左值623 = 真;   // 显式 &左值——宿主 H3 幂等同判（不再报错）
                } 否则 如果 (实参623.类型 == 节点_标识符) {
                    整64 种类623 = 表查找种类(符号表, 整64(实参623.文本));
                    是左值623 = (种类623 == 符号_变量 || 种类623 == 符号_参数 ||
                              种类623 == 符号_常量);
                } 否则 如果 (实参623.类型 == 节点_成员 || 实参623.类型 == 节点_下标 ||
                          实参623.类型 == 节点_解引用) {
                    是左值623 = 真;
                }
                如果 (!是左值623) {
                    表诊断(诊断, "[错误] 引用参数要求左值实参（不能对常量/字面量/临时值取地址）");
                }
            }
        }
        i623++;
    }
}

// ==================== 806：实例方法作值直接作调用实参拒绝（宿主 argIsBoundMethodValue 同规则） ====================
// 现象（801 轮激活 107 用例暴露）：宿主拒「实例方法作值（对象.实例方法）直接作为
//   裸 fnptr 实参」（诊断「须先赋值给变量」），v2P 曾 rc=0 放行=放行分叉。
// 规则来源=plans/001 §5.8 方法作值（P3-23/D2）：实例方法作值为「绑定 this 的
//   闭包」——裸 fnptr 槽无法携带 this，直接作实参属静默错行为，须先赋值给变量
//   （自动 cb = 对象.方法; cb(实参)）经闭包通道调用（e2e 104 合法形态；本检查
//   只在「直接作调用实参」处拦——赋值给变量再传的合法形态实参=标识符不受影响）。
// 判定（宿主 semantic_expr_access.cpp 置 isMethodValue + semantic_decl.cpp
//   argIsBoundMethodValue 同构）：实参末节点=节点_成员；对象=标识符且非类名
//   （类名.实例成员=93-a 拒通道，本判定返回假防双报）；对象类型（剥指针尾星，
//   . 自动解引用同款）命中用户类节点；类方法表（沿基链）命中成员名；排除静态
//   方法（类名.静态方法 作值=合法来源·1007 面）；命中=「有参方法 ∪ 构造 ∪ 析构」
//   （宿主置位条件 !paramTypes.empty() || isConstructor || isDestructor 同构）。
// 诚实边界（检不出放行）：对象为成员链/调用/自身等复合形态（宿主类型全推导=
//   v2 随推导完善收口）；对象类型不可推导（未声明/容器/接口）；泛型实例类节点
//   （IR 阶段克隆·语义检查期未登记）——双侧全覆盖面=标识符实例对象。

// 202/806：类方法节点沿链定位（本类→基名链；-1=miss）。扫描形态与
//   575-a 私有可见性/936 方法返回 逐处内联扫描同构——本函数为方法判定族
//   单一归属实现（新代码不再复制类节点方法扫描循环）。
函数 查类方法节点沿链(向量<节点> 池, 整64 类名ID, 整64 方法名ID) -> 整64 {
    整64 当前类 = 类名ID;
    整64 守卫h = 0;
    当 (当前类 != 0 && 守卫h < 64) {
        整64 类节点 = 查类节点索引(当前类);
        如果 (类节点 >= 0 && 类节点 < 整64(池.大小())) {
            节点 类值 = 池.元素(整32(类节点));
            整64 扫 = 整64(类值.子起点);
            当 (扫 < 整64(类值.子终点)) {
                节点 成员 = 池.元素(整32(扫));
                如果 (成员.类型 == 节点_方法 && 整64(成员.文本) == 方法名ID) {
                    返回 扫;
                }
                扫++;
            }
        }
        当前类 = 查类基名(当前类);
        守卫h++;
    }
    返回 -1;
}

// 202：类方法参数借用位就地扫描（方法节点参数区间正扫——函数参数串 同款布局：
//   [子起点, 块.子起点) 逐 节点_参数，类型节点附加>=256=引用、==257=常量引用；
//   同时统计参数个数）。返回参数个数；引用位/常量位经出参向量回填。
函数 取方法参数借位们(向量<节点> 池, 整64 方法节点索引,
                   向量<整64>& 引用位们, 向量<整64>& 常量位们) -> 整64 {
    节点 方 = 池.元素(整32(方法节点索引));
    整64 参数终点 = 整64(方.子终点);
    如果 (参数终点 < 整64(池.大小())) {
        节点 块 = 池.元素(整32(参数终点));
        参数终点 = 整64(块.子起点);
    }
    整64 个数 = 0;
    整64 i = 整64(方.子起点);
    当 (i < 参数终点 && i < 整64(池.大小())) {
        节点 p = 池.元素(整32(i));
        如果 (p.类型 == 节点_参数) {
            整64 引位 = 0;
            整64 常位 = 0;
            如果 (p.附加 >= 0 && p.附加 < 整64(池.大小())) {
                节点 类型节点p = 池.元素(整32(p.附加));
                如果 (类型节点p.类型 == 节点_类型) {
                    如果 (类型节点p.附加 >= 256) { 引位 = 1; }
                    如果 (类型节点p.附加 == 257) { 常位 = 1; }
                }
            }
            追加64(引用位们, 引位);
            追加64(常量位们, 常位);
            个数++;
        }
        i++;
    }
    返回 个数;
}

函数 实参是绑定方法值806(向量<节点> 池, 整32 实参末索引,
                       向量<映射<整64, 符号>>& 符号表) -> 布尔 {
    如果 (实参末索引 < 0 || 实参末索引 >= 整32(池.大小())) { 返回 假; }
    节点 a806 = 池.元素(实参末索引);
    如果 (a806.类型 != 节点_成员 || a806.子起点 <= 0) { 返回 假; }
    如果 (整64(a806.子起点) >= 池.大小()) { 返回 假; }
    节点 对象806 = 池.元素(整32(a806.子起点));
    如果 (对象806.类型 != 节点_标识符) { 返回 假; }
    整64 对象名806 = 整64(对象806.文本);
    // 类名.成员 形态（93-a 检查类名成员访问 通道）不在此判——防双报
    如果 (是用户类ID(对象名806)) {
        整64 种类806 = 表查找种类(符号表, 对象名806);
        如果 (种类806 != 符号_变量 && 种类806 != 符号_参数) { 返回 假; }
    }
    整64 对象类型806 = 表查找类型ID(符号表, 对象名806);
    如果 (对象类型806 <= 0) { 返回 假; }   // 诚实边界：类型不可推导
    字符串 类型文本806 = 字符串复制(驻留文本(对象类型806));
    整64 长806 = 字符串长度(类型文本806);
    如果 (长806 > 0 && ((整64(类型文本806[整32(长806 - 1)]) & 255) == 42)) {
        // 剥指针尾星（. 自动解引用一级——V2.1 成员访问统一语义）
        对象类型806 = 驻留(字符串子串(类型文本806, 0, 整32(长806 - 1)));
    }
    整64 方法节点806 = 查类方法节点沿链(池, 对象类型806, 整64(a806.文本));
    如果 (方法节点806 < 0) { 返回 假; }   // 非用户类方法（字段/容器/接口=诚实边界）
    如果 (是类静态方法(对象类型806, 整64(a806.文本))) { 返回 假; }   // 静态方法作值=合法来源
    字符串 方法名文本806 = 字符串复制(驻留文本(整64(a806.文本)));
    布尔 是构造806 = (整64(a806.文本) == 对象类型806);
    布尔 是析构806 = (字符串长度(方法名文本806) > 0 &&
                     ((整64(方法名文本806[0]) & 255) == 126));
    如果 (字符串长度(函数参数串(池, 整32(方法节点806))) > 0 ||
         是构造806 || 是析构806) {
        返回 真;
    }
    返回 假;
}

// ==================== 943：绑定方法值位置守卫（宿主 semantic_method_value_943 同构） ====================
// 现象（#943·用户质询收口）：实例方法作值（对象.实例方法）赋 fnptr 变量后经
//   函数参数转发调用=段错误 rc139（裸方法符号丢绑定 this·p82d 探针）。
//   修复=赋值位 IR 合成蹦床闭包（值自带绑定对象指针静态槽·转发安全）；同时
//   位置收口：方法值仅可作「变量声明初值 / 标识符变量赋值右值」（IR 固化点），
//   其余位置（返回位/字段/容器/下标/语句位等·宿主探针 p943d/p943k 段错误实录）
//   =绑定对象无处固化=悬垂/脏崩 → 编译拒绝（§1.1a② 宁拒不放行）。
// 判定复用 806 谓词 实参是绑定方法值806（同一识别面·防双份口径漂移）；
//   诊断文案=位置守卫与 806 实参检查共用单点（宿主同文本·双侧逐字一致）；
//   单诊断：实参位归 806 检查报（守卫经位置集合跳过实参末位·等价宿主去重标记）。
// 深度=0（非绑定位置）挂点=检查成员访问表达式（表达式位公共面·宿主
//   语义 visitMemberExpr 挂点同构）；深度置位=检查语句（声明/标识符赋值）。
整64 方法值绑定深度943 = 0;
// 943：调用位置集合（惰性一次全池扫描——两集合值恒 1）：
//   ①被调位=方法*调用*的 callee 节点（`对象.方法(实参)` 的被调节点非方法值，
//     守卫须跳过——否则每个方法调用都被误判·p943s 双误报实录）；
//   ②实参末位=调用实参表达式末节点（实参位由 806 检查负责——守卫跳过防同节点
//     双诊断；两通道同文案·单报口径与宿主 943 去重标记等价）。
//   注：不加「已报到」状态表——549 立法（本文件头）：静默推导通道先行会把权威
//   通道诊断挡掉（p107/p108 实录 rc=0 丢错）；本处纯位置集合与通道无关=安全。
映射<整64, 整64> 方法调用被调位943;
映射<整64, 整64> 方法值实参末位943;
整64 被调位已扫943 = 0;

不安全 函数 扫描方法调用被调位943(向量<节点> 池) -> 空类型 {
    如果 (被调位已扫943 != 0) { 返回; }
    被调位已扫943 = 1;
    整64 i943 = 0;
    当 (i943 < 整64(池.大小())) {
        节点 n943 = 池.元素(整32(i943));
        如果 (n943.类型 == 节点_调用 && n943.子起点 >= 0 &&
            n943.子起点 < 整32(池.大小())) {
            结果<空类型, 整32> 设被调943 = 方法调用被调位943.设置(整64(n943.子起点), 1);
            如果 (!设被调943.正常) { 运行时错误(4); }
            整64 实参i943 = 0;
            当 (实参i943 < 整64(n943.附加)) {
                整64 末位i943 = 查调用实参末位(整64(i943), 实参i943);
                如果 (末位i943 >= 0 && 末位i943 < 整64(池.大小())) {
                    结果<空类型, 整32> 设末943 = 方法值实参末位943.设置(末位i943, 1);
                    如果 (!设末943.正常) { 运行时错误(4); }
                }
                实参i943++;
            }
        }
        i943++;
    }
}

// 943：统一诊断文案（宿主 语义 method_value_943::positionDiag 逐字一致）。
函数 方法值位置文案943() -> 字符串 {
    返回 "实例方法作值不能作为函数指针值使用（绑定 this 无处安放）——改用闭包捕获：变量 闭 = [对象](...) { 返回 对象.方法(...); }; 或先绑定变量：变量 cb = 对象.方法; cb(实参)";
}

// 943：位置守卫（非绑定位置=深度 0 出现方法值 → 报诊断；调用被调位/实参末位
//   由 扫描方法调用被调位943 集合跳过——各位置单点归属·防双报）。
不安全 函数 方法值位置守卫943(向量<节点> 池, 整32 节点索引,
                            向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    如果 (方法值绑定深度943 != 0) { 返回; }
    扫描方法调用被调位943(池);
    // v2 映射 获取缺失键=正常真 值0（无错误）——存在性判据一律用 值!=0
    整64 被调位值943 = 0;
    结果<整64, 整32> 查被调位943 = 方法调用被调位943.获取(整64(节点索引));
    如果 (查被调位943.正常) { 被调位值943 = 查被调位943.值; }
    如果 (被调位值943 != 0) { 返回; }
    整64 实参位值943 = 0;
    结果<整64, 整32> 查实参位943 = 方法值实参末位943.获取(整64(节点索引));
    如果 (查实参位943.正常) { 实参位值943 = 查实参位943.值; }
    如果 (实参位值943 != 0) { 返回; }
    如果 (!实参是绑定方法值806(池, 节点索引, 符号表)) { 返回; }
    表诊断(诊断, "[错误] " + 方法值位置文案943());
}

// 806：调用实参位绑定方法值扫描（挂点=检查调用表达式 统一入口——覆盖宿主
//   collectCallArgTypes 三面：普通函数 semantic_call.cpp / 方法 semantic_call_member
//   / 构造 semantic_call_ctor）。诊断文案与宿主逐字一致（943 起=方法值位置文案943
//   单点·同节点与位置守卫单诊断去重）。
不安全 函数 检查绑定方法值实参806(向量<节点> 池, 整32 调用节点索引,
                         向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    节点 n806 = 池.元素(调用节点索引);
    如果 (n806.附加 < 1) { 返回; }
    整64 i806 = 0;
    当 (i806 < 整64(n806.附加)) {
        整64 末位806 = 查调用实参末位(整64(调用节点索引), i806);
        如果 (末位806 >= 0 && 末位806 < 整64(池.大小())) {
            如果 (实参是绑定方法值806(池, 整32(末位806), 符号表)) {
                表诊断(诊断, "[错误] " + 方法值位置文案943());
            }
        }
        i806++;
    }
}

// ==================== 202：同一调用中双可变借用互斥（宿主 checkConstRefBorrowDiscipline 阶段3b 同规则） ====================
// 现象（801 轮 202 用例暴露）：宿主拒「同一调用中同一变量被可变借用两次」
//   （别名可变冲突），v2P 曾 rc=0 放行=放行分叉。
// 规则来源=plans/019 §3b（宿主 semantic.cpp checkConstRefBorrowDiscipline 独立
//   接入）：Rust 借用检查同款——&mut x 与 &mut x 不得同存（别名可变冲突）；
//   判定精度=限**单次调用实参序列内**，跨语句先后可变借用不重叠=合法。
// 公共扫描202：调用方按被调形态预填「引用位/常量位」两向量（普通函数面=函数
//   签名借用位表 查函数参数引用位/常量位；类构造/方法面=方法节点参数区类型
//   节点附加 256/257），本扫描逐参判定：
//   ①实参为当前函数常量（只读）引用参数而形参可变引用=只读借出可变拒（既有）；
//   ②同调用同变量两次可变借用=「被可变借用两次」拒（202 新增·宿主同文案）；
//   ③同调用同变量 可变×只读=互斥拒（既有·语句级第一版）。
//   报后返回=宿主 checkConstRefBorrowDiscipline 同句 return 对齐（错误程序
//   编译中止——err>0 不产 IR，后续实参不再检查）。
//   实参形态=标识符 ∪ &标识符（取地址 unwrap——宿主 AddressOf unwrap 同构）；
//   其余形态=诚实边界（宿主「其余形态不参与第一版判定」同口径）。
函数 借用位扫描202(向量<节点> 池, 整32 调用节点索引, 整64 实参数,
                 向量<整64>& 引用位们, 向量<整64>& 常量位们,
                 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    整64 首个可变基础名 = -1;
    整64 i = 0;
    当 (i < 实参数) {
        如果 (i >= 引用位们.大小()) { 中断; }
        如果 (引用位们.元素(i) != 1) { i++; 继续; }
        整64 末位 = 查调用实参末位(整64(调用节点索引), i);
        如果 (末位 >= 0 && 末位 < 整64(池.大小())) {
            节点 实参末 = 池.元素(整32(末位));
            // &左值 unwrap（宿主 AddressOf 取操作数同构）
            如果 (实参末.类型 == 节点_取地址 && 实参末.子起点 >= 0 &&
                 整64(实参末.子起点) < 池.大小()) {
                实参末 = 池.元素(整32(实参末.子起点));
            }
            如果 (实参末.类型 == 节点_标识符) {
                整64 实参名 = 整64(实参末.文本);
                // 188-a/548：引用实参=别名逃逸（被调方可能改写该变量）——
                //   恒空/零值判定失格（保守，防假阳性；既有登记语义不动）
                登记恒空失格(实参名);
                登记零值失格(实参名);
                布尔 是只读位 = (i < 常量位们.大小() && 常量位们.元素(i) == 1);
                如果 (是只读位) {
                    如果 (首个可变基础名 == 实参名) {
                        表诊断(诊断, "[错误] 同一调用中变量的可变借用与只读借用互斥: " +
                                      驻留文本(实参名));
                        返回;
                    }
                } 否则 {
                    如果 (是常量引用参数(实参名)) {
                        表诊断(诊断, "[错误] 常量引用参数是只读借用，不能再作为可变引用传参: " +
                                      驻留文本(实参名));
                    }
                    如果 (首个可变基础名 == 实参名) {
                        表诊断(诊断, "[错误] 同一调用中变量 '" + 驻留文本(实参名) +
                                       "' 被可变借用两次（别名可变冲突）");
                        返回;
                    }
                    如果 (首个可变基础名 == -1) { 首个可变基础名 = 实参名; }
                }
            }
        }
        i++;
    }
}

// 202：普通函数面借用纪律（原 语义检查表达式.cn 检查调用借用纪律 迁入——与
//   实参检查族同文件；行为=原实现逐字 + 双可变判定经 借用位扫描202 统一）。
//   被调键基取签名表首候选（重载族精确决议在 IR 层=诚实边界）。
函数 检查调用借用纪律(向量<节点> 池, 整32 调用节点索引, 整64 被调键基,
                    向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    节点 调用n = 池.元素(调用节点索引);
    整64 实参数 = 调用n.附加;
    如果 (实参数 <= 0 || 被调键基 < 0) { 返回; }
    整64 查串 = 查函数签名参数串(被调键基 * 键位移);
    如果 (查串 < 0) { 返回; }
    整64 签名键 = 函数签名键(被调键基, 驻留文本(查串));
    向量<整64> 引用位们 = 向量<整64>();
    向量<整64> 常量位们 = 向量<整64>();
    整64 i = 0;
    当 (i < 实参数) {
        追加64(引用位们, 查函数参数引用位(签名键, i));
        追加64(常量位们, 查函数参数常量位(签名键, i));
        i++;
    }
    借用位扫描202(池, 调用节点索引, 实参数, 引用位们, 常量位们, 符号表, 诊断);
}

// 202：类构造调用面借用纪律（宿主 semantic_call_ctor.cpp checkConstRefBorrowDiscipline
//   同面）：构造方法节点定位=本类区间扫「方法名==类名 且 参数串全等（查类构造
//   参数串 权威选择）」→取位→公共扫描。诚实边界：类节点未登记（泛型实例克隆体
//   =IR 阶段）/构造串 miss（个数错=另通道诊断）→放行防双报。
函数 检查构造借用纪律202(向量<节点> 池, 节点 调用n202, 整32 调用节点索引,
                       整64 类名ID, 向量<映射<整64, 符号>>& 符号表,
                       向量<字符串>& 诊断) -> 空类型 {
    整64 实参数 = 整64(调用n202.附加);
    如果 (实参数 < 1) { 返回; }
    整64 类节点 = 查类节点索引(类名ID);
    如果 (类节点 < 0 || 类节点 >= 整64(池.大小())) { 返回; }
    整64 构造串ID = 查类构造参数串(类名ID, 实参数);
    如果 (构造串ID <= 0) { 返回; }
    字符串 构造串 = 字符串复制(驻留文本(构造串ID));
    节点 类值 = 池.元素(整32(类节点));
    整64 扫 = 整64(类值.子起点);
    当 (扫 < 整64(类值.子终点)) {
        节点 成员 = 池.元素(整32(扫));
        如果 (成员.类型 == 节点_方法 && 整64(成员.文本) == 类名ID) {
            如果 (字符串比较(函数参数串(池, 整32(扫)), 构造串)) {
                向量<整64> 引用位们 = 向量<整64>();
                向量<整64> 常量位们 = 向量<整64>();
                整64 个数 = 取方法参数借位们(池, 扫, 引用位们, 常量位们);
                如果 (个数 == 实参数) {
                    借用位扫描202(池, 调用节点索引, 实参数, 引用位们, 常量位们,
                                符号表, 诊断);
                }
                返回;
            }
        }
        扫++;
    }
}

// 202：成员方法调用面借用纪律（宿主 checkInstanceMethodCall → checkConstRefBorrowDiscipline
//   同面）：对象=标识符（成员链对象=诚实边界放行，与 575-a/623 同口径）；
//   对象类型剥指针尾星后沿链定位方法节点；静态方法=返回（类名.静态方法 另归）。
函数 检查方法借用纪律202(向量<节点> 池, 节点 调用n202, 整32 调用节点索引,
                       节点 被调202, 向量<映射<整64, 符号>>& 符号表,
                       向量<字符串>& 诊断) -> 空类型 {
    整64 实参数 = 整64(调用n202.附加);
    如果 (实参数 < 1) { 返回; }
    如果 (被调202.类型 != 节点_成员 || 被调202.子起点 <= 0) { 返回; }
    如果 (整64(被调202.子起点) >= 池.大小()) { 返回; }
    节点 对象202 = 池.元素(整32(被调202.子起点));
    如果 (对象202.类型 != 节点_标识符) { 返回; }
    整64 对象名202 = 整64(对象202.文本);
    整64 对象类型202 = 表查找类型ID(符号表, 对象名202);
    如果 (对象类型202 <= 0) {
        如果 (是用户类ID(对象名202)) { 对象类型202 = 对象名202; } 否则 { 返回; }
    }
    字符串 类型文本202 = 字符串复制(驻留文本(对象类型202));
    整64 长202 = 字符串长度(类型文本202);
    如果 (长202 > 0 && ((整64(类型文本202[整32(长202 - 1)]) & 255) == 42)) {
        对象类型202 = 驻留(字符串子串(类型文本202, 0, 整32(长202 - 1)));
    }
    整64 方法节点202 = 查类方法节点沿链(池, 对象类型202, 整64(被调202.文本));
    如果 (方法节点202 < 0) { 返回; }   // 容器/接口/导入类 miss=诚实边界
    如果 (是类静态方法(对象类型202, 整64(被调202.文本))) { 返回; }
    向量<整64> 引用位们 = 向量<整64>();
    向量<整64> 常量位们 = 向量<整64>();
    整64 个数 = 取方法参数借位们(池, 方法节点202, 引用位们, 常量位们);
    如果 (个数 == 实参数) {
        借用位扫描202(池, 调用节点索引, 实参数, 引用位们, 常量位们, 符号表, 诊断);
    }
}

// 202：类调用面分派（挂点=检查调用表达式 统一入口）——构造面（被调=用户类名
//   标识符·变量遮蔽除外）与成员方法面（被调=节点_成员）。
函数 检查类调用借用纪律202(向量<节点> 池, 整32 调用节点索引,
                        向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    节点 n202 = 池.元素(调用节点索引);
    整64 调用起点 = 整64(n202.子起点);
    如果 (调用起点 <= 0 || 调用起点 >= 整64(池.大小())) { 返回; }
    节点 被调202 = 池.元素(整32(调用起点));
    如果 (被调202.类型 == 节点_标识符) {
        字符串 被调文本202 = 字符串复制(驻留文本(整64(被调202.文本)));
        如果 (!是用户类(被调文本202)) { 返回; }
        整64 被调名202 = 整64(被调202.文本);
        整64 种类202 = 表查找种类(符号表, 被调名202);
        如果 (种类202 == 符号_变量 || 种类202 == 符号_参数) { 返回; }
        检查构造借用纪律202(池, n202, 调用节点索引, 被调名202, 符号表, 诊断);
        返回;
    }
    如果 (被调202.类型 == 节点_成员) {
        检查方法借用纪律202(池, n202, 调用节点索引, 被调202, 符号表, 诊断);
    }
}
