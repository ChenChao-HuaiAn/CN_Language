// CN 自举编译器 v2 · 语义检查调用被调形态（#1855 千行拆分轮·纯机械搬移零逻辑变化）
// 职责：被调节点形态族——101 外部函数不安全边界 / 491+1976 成员被调函数指针字段与字段当方法调 /
//   927 复合被调 / 575-a 方法调用面（272 入容器拷构+1029 可见性+602 返回推导+907 不存在诊断）。
//   自 语义检查表达式.cn 检查调用表达式 机械搬移（段体逐字保留·原嵌套缩进
//   不重排=逐字节零差异证据）；消费=语义检查表达式 检查调用表达式 分派骨架。
// 依赖经合并全局池（同包兄弟）；显式导入限跨包。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（目录包名）
导入 IR;         // 容器/结果/签名 层面公开函数（目录包名）
导入 协议常量;   // 驻留/驻留文本（中立层）

公开:   // 全文件公开（子模块符号供包内兄弟模块经合并全局池解析）


// 101 段（外部函数调用不安全边界）
函数 检查外部函数边界(节点 被调节点, 向量<字符串>& 诊断) -> 空类型 {

        // 101（1023·plans/023 §八 A4 v2 挂点补齐·008 序②）：**外部函数调用**
        //   （FFI=C 边界·类型安全不保证·Rust extern 块同 unsafe-only）——被调
        //   名∈外部函数名集合（957 通道解析期登记）。文案与宿主逐字一致。
        如果 (被调节点.类型 == 节点_标识符 &&
              是外部函数名957(整64(被调节点.文本))) {
            错误不安全边界(诊断, "外部函数调用",
                         字符串复制(驻留文本(整64(被调节点.文本))));
        }
}


// 491+1976 段（成员被调——函数指针字段返回推导+字段当方法调拒绝）
//   返回 有值=本形态已终态（正常(类型ID)）；无值=继续主链（原 fall-through）
函数 检查成员被调函数指针(向量<节点> 池, 节点 n, 整32 节点索引,
                     整64 调用起点, 节点 被调节点,
                     向量<映射<整64, 符号>>& 符号表,
                     向量<字符串>& 诊断) -> 可选<整64> {

        // 491（742d 面外·宿主同形态全过=零分叉收口）：**成员被调**（对象.字段
        //   ——结构体函数指针字段，001 §5.8 甲案声明位全集④）返回类型推导——
        //   字段类型（推导成员类型ID 父链：标识符/成员/调用 对象形态）为函数
        //   指针形态时按 fnptr 签名返回（IR 层 查被调函数指针签名480 成员扩展
        //   同源对齐·宿主 ir_call.cpp funcPtrTypeOfCallee 成员面）。原缺=推断
        //   声明「变量 r = w.fn(3, 4)」类型未登记 → 下方 r.x 字段偏移 -1 崩
        //   （probe491_p_c 实录：IR 层「成员字段偏移未知: .x」中止）。静默
        //   诊断副本吸收推导过程的指针成员访问边界诊断（不重复报）。
        如果 (被调节点.类型 == 节点_成员) {
            向量<字符串> 静默推导副本 = 向量<字符串>(); 可选<整64> 字段推导类型ID查 = 推导成员类型ID(池, 整32(调用起点), 符号表, 静默推导副本); 整64 字段推导类型ID = 0;
            如果 (字段推导类型ID查.有值) { 字段推导类型ID = 字段推导类型ID查.值; }
            布尔 字段推导已取 = 字段推导类型ID > 0;
            如果 (字段推导已取 &&
                是函数指针类型文本(字符串复制(驻留文本(字段推导类型ID)))) {
                返回 某些(检查函数指针调用480(池, n, 节点索引, 诊断,
                    字符串复制(驻留文本(整64(被调节点.文本))),
                    字符串复制(驻留文本(字段推导类型ID))));
            }
            // 1976（双侧诊断伞批·件1 零分叉）：字段当方法调（对象.字段()——
            //   成员是字段非方法）语义级拒绝（宿主 semantic_call.cpp 同串）——
            //   判定本体在 语义检查字段方法调.cn（先拆再加·本文件拆前 1059 行
            //   破千行红线）；已诊断=某些(未知ID) 同宿主 lastType_ 错误恢复。
            可选<整64> 字段判定果 = 检查字段当方法调(
                池, 整32(调用起点), 整64(被调节点.文本),
                整32(被调节点.子起点), 符号表, 诊断);
            如果 (字段判定果.有值) { 返回 某些(字段判定果.值); }
        }
    返回 无;
}


// 927 段（复合被调——被调=调用表达式结果·内层返回 fnptr 再被调）
函数 检查复合被调函数指针(向量<节点> 池, 节点 n, 整32 节点索引,
                      节点 被调节点, 向量<映射<整64, 符号>>& 符号表,
                      向量<字符串>& 诊断) -> 可选<整64> {

        // 927（复合被调 造句柄()(3,4)·491 同构延伸·001 §5.8 间接调用被调=
        //   任意 fnptr 表达式）：**被调=调用表达式结果**（内层调用返回函数指针
        //   再被调）——内层被调=标识符时其符号表类型ID=函数返回类型（函数返回
        //   fnptr 时=函数指针文本·432 同源）→ 按 fnptr 调用推导返回（检查函数
        //   指针调用480 同构消费·IR 层 查被调函数指针签名480 调用分支同源
        //   对齐·宿主 ir.cpp funcPtrTypeOfCallee 调用节点分支）。原缺=推断声明
        //   「变量 r = 造句柄()(3,4)」类型未登记 → r.x 字段偏移 -1 崩
        //   （p927s 实录：[ir2] 成员字段偏移未知: .x/.y）。内层被调=成员/下标
        //   等更深形态维持诚实边界（零行为变化）。
        //   882 门禁注记：索引守卫/表命中比较归入命名布尔（条件外显·非阈值）。
        布尔 被调是调用927 = 被调节点.类型 == 节点_调用; 布尔 内被调位有效927 = 被调节点.子起点 != 0 && 整32(被调节点.子起点) < 整32(池.大小());
        如果 (被调是调用927 && 内被调位有效927) {
            节点 内被调927 = 池.元素(整32(被调节点.子起点));
            如果 (内被调927.类型 == 节点_标识符) {
                整64 内类型927 = 0; 可选<整64> 内类型927查 = 表查找类型ID(符号表, 整64(内被调927.文本));
                // miss 保持 0（下方 >0 判定与原 -1 哨兵同假·880 批5）
                如果 (内类型927查.有值) { 内类型927 = 内类型927查.值; }
                布尔 内是函数指针927 = 内类型927 > 0 && 是函数指针类型文本(字符串复制(驻留文本(内类型927)));
                如果 (内是函数指针927) {
                    返回 某些(检查函数指针调用480(池, n, 节点索引, 诊断,
                        字符串复制(驻留文本(整64(内被调927.文本))),
                        字符串复制(驻留文本(内类型927))));
                }
            }
        }
    返回 无;
}


// 575-a 段主分派（方法调用面——对象类型定位+入容器拷构+可见性/返回推导接线）
函数 检查方法调用面(向量<节点> 池, 节点 n, 整32 节点索引,
                  整64 调用起点, 节点 被调节点,
                  向量<映射<整64, 符号>>& 符号表,
                  向量<字符串>& 诊断) -> 可选<整64> {

        // 575-a（T100·81 对齐 340-a 字段面/宿主 checkAccess）：方法调用面可见性
        //   挂点——被调=成员（对象.方法）且对象类型=类（类节点命中）→ 可见性
        //   判定经单点实现 检查成员可见性1029（语义检查访问控制.cn：1029 起
        //   沿链定位定义类+段三态+同类/派生/友元豁免+宿主逐字文案；原内联
        //   扫描二态判据撤除）。
        如果 (被调节点.类型 == 节点_成员 && 被调节点.子起点 > 0) {
            // 936（002·81 根治）：成员节点.子起点=对象表达式起点（池布局实证：
            //   子起点=计（标识符）·-1 位=类型节点 22）——原 -1 取位永指错节点=
            //   本检查自 575-a 立项以来从未生效（宽松放行）
            节点 调对象 = 池.元素(被调节点.子起点);
            如果 (调对象.类型 == 节点_标识符) {
                整64 调对象类型 = 0; 可选<整64> 调对象类型查 = 表查找类型ID(符号表, 整64(调对象.文本));
                如果 (调对象类型查.有值) { 调对象类型 = 调对象类型查.值; }
                // 原 <=0 判定：miss 与登记值 0 同走类名直查回退（880 批5 显式保留）
                如果 (!调对象类型查.有值 || 调对象类型 == 0) {
                    // 936（002·81 根治②）：导入类的类型不经符号表登记（声明位与
                    //   表达式位两套查询不同源）——回退类名直查（类表键=纯名）
                    调对象类型 = 整64(调对象.文本);
                }
                如果 (调对象类型 > 0) {
            检查入容器拷构(池, n, 节点索引, 调对象类型, 被调节点, 符号表, 诊断);   // 272：入容器位 无拷贝构造类 拒绝（接线·实现=本文件下方）
            可选<整64> 方法可见果 = 检查方法可见性与返回(池, 节点索引, 调对象类型, 调对象, 被调节点, 符号表, 诊断);   // 1029/602/907：可见性+方法返回推导+不存在诊断（接线）
            如果 (方法可见果.有值) { 返回 某些(方法可见果.值); }

                }
            }
        }
    返回 无;
}


// 272 段（入容器位 无拷贝构造类 拒绝）
函数 检查入容器拷构(向量<节点> 池, 节点 n, 整32 节点索引,
                 整64 调对象类型, 节点 被调节点,
                 向量<映射<整64, 符号>>& 符号表,
                 向量<字符串>& 诊断) -> 空类型 {

                    // 272（021 任务 272）：入容器位 无拷贝构造类 拒绝——stdlib 容器
                    //   元素整写要求独立拥有（宿主元素写=深拷·无拷贝构造类拒绝
                    //   「未定义拷贝构造，无法 复制」）·v2 原宽松放行→浅柄共享
                    //   →弹出/析构双释放（探针 s3b rc=134 实证·116/182 口径域）。
                    //   诊断文本与宿主逐字对齐（dual 负测锚）。守卫=基名∈{向量,
                    //   栈,链表,队列,集合}（映射值面宿主连声明都拒=另域·映射<类>
                    //   声明分叉挂 272 行注记）·方法∈入容器白名单·实参=标识符
                    //   形态（表达式/三元实参=推导不可靠面放行·217 诚实边界同款）。
                    字符串 容器基名 = 合成名基名(字符串复制(驻留文本(调对象类型)));
                    布尔 是入容器基类 = 字符串比较(容器基名, "向量") || 字符串比较(容器基名, "栈") || 字符串比较(容器基名, "链表") || 字符串比较(容器基名, "队列") || 字符串比较(容器基名, "集合");
                    如果 (是入容器基类 &&
                         是入容器方法(字符串复制(驻留文本(整64(被调节点.文本))))) {
                        // 1360 批5：入容器值实参下标 结果化——前置不变量=是入容器方法
                        //   已判真，此处显式分流（无值=不命中本守卫分支）
                        可选<整64> 值参数位查 = 入容器值实参下标(
                            字符串复制(驻留文本(整64(被调节点.文本))));
                        如果 (值参数位查.有值) {
                            整64 值参数位 = 值参数位查.值; 整64 值参数末位 = 0;
                            可选<整64> 值参数末位查 = 查调用实参末位(整64(节点索引), 值参数位);
                            // miss（原 -1 哨兵）与 0 同假——原 >0 判定逐字保留
                            如果 (值参数末位查.有值) { 值参数末位 = 值参数末位查.值; }
                            如果 (值参数末位 > 0 && 值参数末位 < 整64(池.大小())) {
                                节点 值参数节点 = 池.元素(整32(值参数末位));
                                如果 (值参数节点.类型 == 节点_标识符) {
                                    整64 值变量类型 = 0;
                                    可选<整64> 值变量类型查 = 表查找类型ID(符号表,
                                                        整64(值参数节点.文本));
                                    // miss 保持 0（下方 >0 判定与原 -1 哨兵同假·880 批5）
                                    如果 (值变量类型查.有值) { 值变量类型 = 值变量类型查.值; }
                                    // 0=表查找合法登记值（880 批5·非 miss）——可解析判据=非 0
                                    //   （原 >0 逐字等价·1819 改名随轮 882 命名布尔化）
                                    布尔 值变量可解析 = 值变量类型 > 0;
                                    如果 (值变量可解析) {
                                        字符串 值变量类型文本 = 字符串复制(驻留文本(值变量类型)); 可选<整64> 值类拷构查 = 查类拷贝构造串(驻留(值变量类型文本));   // 1541 B2：无值=无拷贝构造（原 ==0 判据）
                                        如果 (是用户类(值变量类型文本) && !值类拷构查.有值) {
                                            // 1819（1784 丁案实施④）：切片成立（派生类实参
                                            //   → 容器基类元素值槽）=切片专用诊断已由 907 面
                                            //   报出（本面让位·宿主单诊断对齐——1650 实录 v2
                                            //   切片+拷构双报 vs 宿主切片单报=诊断面分叉）。
                                            //   元素类型=合成名首实参（向量$基 → 基·入容器
                                            //   基类守卫已保证有 $ 分段）。
                                            字符串 容器元素名 = 合成名首实参(
                                                字符串复制(驻留文本(调对象类型)));
                                            布尔 入容器切片 = 是切片形态(
                                                值变量类型, 驻留(容器元素名));
                                            如果 (!入容器切片) {
                                                表诊断(诊断, "[错误] 类型 '" +
                                                    值变量类型文本 + "' 未定义拷贝构造，无法 复制");
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
}


// 1029/602/907 段（方法可见性+方法返回推导+方法不存在诊断）
//   返回 有值=方法命中已终态（602 正常(方法返回)）；无值=继续主链
函数 检查方法可见性与返回(向量<节点> 池, 整32 节点索引,
                      整64 调对象类型, 节点 调对象, 节点 被调节点,
                      向量<映射<整64, 符号>>& 符号表,
                      向量<字符串>& 诊断) -> 可选<整64> {

                    // 648 归档：容器实例面（查类节点索引 miss=内置容器无池节点）
                    //   成员方法返回类型=IR 层内置表精确决议（语义层整64 簿记不被
                    //   终态消费·恢复路径非 miss）——专项=语义层容器方法类型表。
                    可选<整64> 调类节点查 = 查类节点索引(调对象类型); 整64 调类节点 = 0 - 1;
                    如果 (调类节点查.有值) { 调类节点 = 调类节点查.值; }
                    如果 (调类节点 >= 0 && 调类节点 < 整64(池.大小())) {
                        // 1029（1017 采样轮 p06 族·零分叉边界）：类名访问豁免——
                        //   对象=类名（「类名.静态方法」形态）不经实例访问通道：
                        //   宿主静态成员分支先于 checkAccess 返回（类名.静态方法
                        //   含私有段=宿主放行·c1 探针实测），可见性拦截须跳过
                        //   （拦截=新分叉）；类名.实例成员由 检查类名成员访问
                        //   另行拒绝（宿主同款首诊断）。
                        可选<整64> 调对象种类81查 =
                            表查找种类(符号表, 整64(调对象.文本));
                        // miss（原 -1 哨兵）→ 非变量/参数形（类名访问面）
                        布尔 调对象是变量形81 = 假;
                        如果 (调对象种类81查.有值) { 调对象是变量形81 = (调对象种类81查.值 == 符号_变量 || 调对象种类81查.值 == 符号_参数); }
                        布尔 类名对象81 = 是用户类ID(整64(调对象.文本)) && !调对象是变量形81;
                        // 1029（1017 采样轮 p06 族）：方法可见性判定外移单点实现
                        //   （语义检查访问控制.cn 检查成员可见性1029——沿链定位
                        //   定义类+段三态+同类/派生/友元豁免+宿主「方法」文案；
                        //   原内联扫描「(修饰/4)%2==0 即私有」仅二态且无派生豁免）。
                        如果 (!类名对象81) {
                            检查成员可见性1029(池, 调对象类型,
                                              整64(被调节点.文本), 真, 诊断);
                        }
                        // 602-a（T100·123 规则1 前置）：方法命中——返回方法返回
                        //   类型（节点_方法.附加=返回类型 ID），替代整64 兜底
                        //   （结果 返回值丢弃检查 Rules1 的成员调用推导前置·
                        //   592-b 参数固化 005 行）。方法定位复用 查类方法节点沿链
                        //   （方法判定族单一归属·重复归纳纪律——原内联扫描撤除）。
                        可选<整64> 方法节点602查 = 查类方法节点沿链(池, 调对象类型, 整64(被调节点.文本)); 整64 方法节点602 = 0 - 1;
                        如果 (方法节点602查.有值) { 方法节点602 = 方法节点602查.值; }
                        布尔 方法命中602 = 方法节点602 >= 0 &&
                            方法节点602 < 整64(池.大小());
                        如果 (方法命中602) {
                            整64 方法返回602 = 整64(池.元素(整32(方法节点602)).附加);
                            如果 (方法返回602 == 0) { 方法返回602 = 驻留("空类型"); }
                            返回 某些(方法返回602);
                        }
                        // 648 归档（豁免边界声明）：用户类方法扫描未命中=常态
                        //   回退通道（跨模块类指针字段成员链 L2 671 实证·对象类
                        //   型经语义指针表/字段剥星后才可达，方法返回在 IR 层
                        //   调用面精确决议）——首记 648 曾登记后回撤；原整64
                        //   兜底保留。110 同构显形面在 泛型显式实例 两态登记。
                        // 907（同族收口·855 呈报 312 探查）：方法名沿基类链查 miss
                        //   =真不存在——「[ir2] 用户类无此方法（含基类链）」崩式
                        //   终止面语义层前置为宿主同级诊断（宿主实测报告原文：本类
                        //   名形态=构造函数引导诊断〔semantic_expr_access.cpp:249〕
                        //   / 其余=「类 'X' 没有成员 'Y'」〔:246〕）；沿链判定=
                        //   查类方法节点沿链（202/806 方法判定族单一归属·与 IR 层
                        //   「含基类链」判据同源）——继承/跨模块合法调用沿链命中
                        //   零误伤（L 继承探针双侧绿实证）。返回类型推导维持原
                        //   兜底路径（仅追加诊断·不改控制流）。
                        字符串 对象名907 = 字符串复制(驻留文本(调对象类型)); 字符串 成员名907 = 字符串复制(驻留文本(整64(被调节点.文本)));
                        可选<整64> 方法节点907查 = 查类方法节点沿链(池, 调对象类型, 整64(被调节点.文本));
                        布尔 方法存在907 = 方法节点907查.有值;
                        如果 (!方法存在907) {
                            布尔 构造名907 = 字符串比较(对象名907, 成员名907);
                            如果 (构造名907) {
                                表诊断(诊断, "[错误] 构造函数 '" + 成员名907 +
                                     "' 不能经成员访问调用——父类构造须经初始化列表（: " +
                                     成员名907 + "(实参)）调用");
                            } 否则 {
                                表诊断(诊断, "[错误] 类 '" + 对象名907 +
                                     "' 没有成员 '" + 成员名907 + "'");
                            }
                        }
                    }
    返回 无;
}
