// CN 自举编译器 v2 · 借出视图生命周期检查（A21，2026-09-12 第七十七轮 + 后续扩展）
// 职责：字符串元素容器「借出视图 × 容器移除 / 容器先亡」的编译期拦截
//   （plans/019 阶段3 扩展；plans/020 矩阵 A21 格靶子；宿主 semantic_borrowview.cpp
//   的 v2 侧对齐实现——移植纪律 10：两侧同缺一次修全）。
// 语义模型：借出视图 = 容器内元素句柄的**浅拷**（字符串元素容器的 元素/读取/
//   栈顶/队首/头部元素/读取头部/读取尾部/获取 返回值）；容器失效方法释放该元素
//   （按容器头分派：向量 删除/设置；集合 删除；链表 删除头部/删除尾部/清空；
//   队列 出队/清空；栈 弹出；映射 删除/设置/清空/释放内部数组）或容器先亡
//   （作用域结束析构释放元素）后，借出视图悬垂。
// 判据 = NLL 顺序近似（Rust 非词法生命周期：引用活跃区间=绑定→最后一次使用）；
//   v2 节点无行号 → 以**节点索引序**代替源码时序（节点池后缀序：同一函数体内
//   语句序保持递增，块区间 [子起点,子终点) 天然可用）。
// 三形态：
//   ①同作用域失效（失效点索引落在绑定与最后使用之间）；
//   ②跨作用域逃逸（使用点不在容器声明所在块区间内=容器先亡——仅标识符容器）；
//   ③调用点同源互斥（77-a 扩展①：同一调用中「容器 C」与其借出视图实参并存 →
//     保守拒绝；Rust 借用检查器对 f(&mut v, &v[0]) 同类拒绝）。
// 接收者形态（77-a 扩展②）：标识符与**成员链**（`架.表`——键=基础名.成员路径，
//   类型经 查结构体类型/查字段类型ID 逐层推导）；下标/解引用/调用接收者不登记
//   （诚实边界）。成员链不可推导类型时保守不登记（漏检方向，不误报）。
// 检查面：自由函数体（v2 语义检查同口径——类方法体不经本检查，诚实边界与
//   既有 v2 检查面一致）。
// 性能：预扫描+主扫描各一遍函数体区间（总量 O(池节点数)），结算 O(借出×失效)。
导入 容器::向量;
导入 语法;       // 节点_*/键位移 常量
导入 IR;         // 容器合成名判定（是字符串元素容器/是字符串值映射/合成名基名）
导入 语义分析;    // 表诊断（诊断缓冲）

公开:

// ---- 状态（函数级：检查借出视图生命周期 入口清空）----
静态 向量<整64> 借出名们;        // 借出视图变量名ID
静态 向量<字符串> 借出容器们;    // 来源容器引用键（标识符=名；成员链=路径文本）
静态 向量<整64> 借出容器基础名们;  // 容器基础名ID（成员链=链首名；简单名=名ID）
静态 向量<整64> 借出容器简单们;    // 1=简单标识符接收者（参与容器先亡判定）
静态 向量<整64> 借出绑定们;      // 绑定节点索引
静态 向量<整64> 借出使用们;      // 最后使用节点索引
静态 向量<整64> 借出已报们;      // 已报标志（0=未报 1=已报）
静态 向量<字符串> 失效容器们;    // 失效点容器引用键
静态 向量<整64> 失效方法们;      // 失效方法名ID
静态 向量<整64> 失效位置们;      // 失效点节点索引
静态 向量<整64> 块起们;          // 块区间表（预扫描：节点_块 子起点）
静态 向量<整64> 块终们;          // 块区间表（节点_块 子终点）
静态 向量<整64> 声明名们;        // 本函数变量/参数声明名ID
静态 向量<整64> 声明类型们;      // 声明类型名ID（-1=未归一）
静态 向量<整64> 声明位置们;      // 声明节点索引
// 第七十八轮（2026-09-12）：当前检查的类（方法体扫描单元——字段裸名解析用；
//   0=自由函数体。检查方法 设置/复位，语义检查.cn 检查函数 路径恒 0）
静态 整64 借出检查类名ID = 0;

函数 设置借出检查类(整64 类名ID) -> 空类型 {
    借出检查类名ID = 类名ID;
}

函数 清空借出检查() -> 空类型 {
    借出名们 = 向量<整64>();
    借出容器们 = 向量<字符串>();
    借出容器基础名们 = 向量<整64>();
    借出容器简单们 = 向量<整64>();
    借出绑定们 = 向量<整64>();
    借出使用们 = 向量<整64>();
    借出已报们 = 向量<整64>();
    失效容器们 = 向量<字符串>();
    失效方法们 = 向量<整64>();
    失效位置们 = 向量<整64>();
    块起们 = 向量<整64>();
    块终们 = 向量<整64>();
    声明名们 = 向量<整64>();
    声明类型们 = 向量<整64>();
    声明位置们 = 向量<整64>();
}

函数 追加64(向量<整64>& 表, 整64 值) -> 空类型 {
    结果<空类型, 整32> 加 = 表.追加(值);
    如果 (!加.正常) { 运行时错误(4); }
}

函数 设置64(向量<整64>& 表, 整64 位置, 整64 值) -> 空类型 {
    结果<空类型, 整32> 设 = 表.设置(位置, 值);
    如果 (!设.正常) { 运行时错误(4); }
}

函数 追加串(向量<字符串>& 表, 字符串 值) -> 空类型 {
    结果<空类型, 整32> 加 = 表.追加(值);
    如果 (!加.正常) { 运行时错误(4); }
}

函数 设置串(向量<字符串>& 表, 整64 位置, 字符串 值) -> 空类型 {
    结果<空类型, 整32> 设 = 表.设置(位置, 值);
    如果 (!设.正常) { 运行时错误(4); }
}

// 借出方法名判定（容器内元素句柄读出接口）
函数 是借出方法名(字符串 名) -> 布尔 {
    返回 字符串比较(名, "元素") || 字符串比较(名, "读取") ||
           字符串比较(名, "栈顶") || 字符串比较(名, "队首") ||
           字符串比较(名, "头部元素") || 字符串比较(名, "读取头部") ||
           字符串比较(名, "读取尾部") || 字符串比较(名, "获取");
}

// 容器失效方法判定（按容器头分派——同名 清空 语义按容器区分：链表/队列/映射
//   清空=全量释放；向量 清空=仅计数归零不释放，不入面；扩容类 追加/压入/入队/
//   头部追加/添加 不入面——字符串句柄指向独立堆块，槽位搬移不使其失效）
函数 是失效方法(字符串 容器类型, 字符串 方法名) -> 布尔 {
    字符串 基名 = 合成名基名(容器类型);
    如果 (字符串比较(基名, "向量")) {
        返回 字符串比较(方法名, "删除") || 字符串比较(方法名, "设置");
    }
    如果 (字符串比较(基名, "集合")) { 返回 字符串比较(方法名, "删除"); }
    如果 (字符串比较(基名, "链表")) {
        返回 字符串比较(方法名, "删除头部") || 字符串比较(方法名, "删除尾部") ||
               字符串比较(方法名, "清空");
    }
    如果 (字符串比较(基名, "队列")) {
        返回 字符串比较(方法名, "出队") || 字符串比较(方法名, "清空");
    }
    如果 (字符串比较(基名, "栈")) { 返回 字符串比较(方法名, "弹出"); }
    如果 (字符串比较(基名, "映射")) {
        返回 字符串比较(方法名, "删除") || 字符串比较(方法名, "设置") ||
               字符串比较(方法名, "清空") || 字符串比较(方法名, "释放内部数组");
    }
    返回 假;
}

// 方法调用解剖：调用节点 { 子起点=被调节点；被调=_节点_成员{文本=方法名, 子起点=对象} }
//   接索引 = 接收者表达式节点索引（标识符或成员链；77-a 扩展②）
函数 解剖方法调用(向量<节点> 池, 整32 调用索引, 整64& 接索引,
                整64& 方法名ID) -> 布尔 {
    接索引 = 0 - 1;
    方法名ID = 0 - 1;
    如果 (调用索引 < 0 || 调用索引 >= 池.大小()) { 返回 假; }
    节点 n = 池.元素(调用索引);
    如果 (n.类型 != 节点_调用) { 返回 假; }
    如果 (n.子起点 <= 0) { 返回 假; }
    节点 被调 = 池.元素(n.子起点);
    如果 (被调.类型 != 节点_成员) { 返回 假; }
    如果 (被调.子起点 <= 0) { 返回 假; }
    节点 对象 = 池.元素(被调.子起点);
    如果 (对象.类型 != 节点_标识符 && 对象.类型 != 节点_成员) { 返回 假; }
    接索引 = 整64(被调.子起点);
    方法名ID = 整64(被调.文本);
    返回 真;
}

// 接收者路径文本（标识符=名；成员链=父路径.成员名；下标/解引用/调用=空串不支持）
//   基础名ID 回填链首标识符名（成员链的容器身份基础）
函数 路径文本递归(向量<节点> 池, 整64 索引, 整64& 基础名ID) -> 字符串 {
    如果 (索引 < 0 || 索引 >= 整64(池.大小())) { 返回 ""; }
    节点 n = 池.元素(整32(索引));
    如果 (n.类型 == 节点_标识符) {
        基础名ID = 整64(n.文本);
        返回 字符串复制(驻留文本(整64(n.文本)));
    }
    如果 (n.类型 == 节点_成员) {
        字符串 父 = 路径文本递归(池, 整64(n.子起点), 基础名ID);
        如果 (字符串长度(父) == 0) { 返回 ""; }
        返回 父 + "." + 字符串复制(驻留文本(整64(n.文本)));
    }
    返回 "";
}

// 接收者类型名ID（标识符=声明类型表；成员链=逐层字段类型：查结构体类型 ->
//   查字段类型ID；-1=不可推导——保守不登记，漏检方向不误报）
函数 接收者类型名ID(向量<节点> 池, 整64 索引, 整64& 基础名ID) -> 整64 {
    如果 (索引 < 0 || 索引 >= 整64(池.大小())) { 返回 -1; }
    节点 n = 池.元素(整32(索引));
    如果 (n.类型 == 节点_标识符) {
        基础名ID = 整64(n.文本);
        返回 查声明类型(整64(n.文本));
    }
    如果 (n.类型 == 节点_成员) {
        整64 父类型 = 接收者类型名ID(池, 整64(n.子起点), 基础名ID);
        如果 (父类型 < 0) { 返回 -1; }
        整64 键基 = 查结构体类型(父类型);
        如果 (键基 <= 0) { 返回 -1; }
        返回 查字段类型ID(键基, 整64(n.文本));
    }
    返回 -1;
}

// 类型节点/类型名 ID 归一（声明节点附加语义同 检查变量声明语句：附加若为
//   类型节点索引则取其文本=类型名ID）
函数 归一类型名(向量<节点> 池, 整64 类型ID) -> 整64 {
    如果 (类型ID >= 0 && 类型ID < 整64(池.大小())) {
        节点 类型节点值 = 池.元素(整32(类型ID));
        如果 (类型节点值.类型 == 节点_类型) { 返回 整64(类型节点值.文本); }
    }
    返回 类型ID;
}

// 名字 → 本函数声明类型名ID（-1=未命中）。
// 第七十八轮（2026-09-12）：类方法体扩展——声明表 miss 后查本类字段类型
//   （字段裸名与局部标识符同语义；借出检查类名ID 由 检查方法 设置，0=自由函数）。
//   字段无「声明位置」（查声明位置 miss）——容器先亡判定对字段自然不适用。
函数 查声明类型(整64 名ID) -> 整64 {
    整64 i = 0;
    当 (i < 声明名们.大小()) {
        如果 (声明名们.元素(i) == 名ID) { 返回 声明类型们.元素(i); }
        i++;
    }
    如果 (借出检查类名ID != 0) {
        整64 字段类型IDb = 查字段类型ID(借出检查类名ID, 名ID);
        如果 (字段类型IDb != 0) { 返回 字段类型IDb; }
    }
    返回 0 - 1;
}

// 名字 → 声明节点索引（-1=未命中）
函数 查声明位置(整64 名ID) -> 整64 {
    整64 i = 0;
    当 (i < 声明名们.大小()) {
        如果 (声明名们.元素(i) == 名ID) { 返回 声明位置们.元素(i); }
        i++;
    }
    返回 0 - 1;
}

// 视图变量名 → 借出登记序（-1=未命中；同名=最后一次绑定）
函数 查借出登记序(整64 名ID) -> 整64 {
    整64 找到 = 0 - 1;
    整64 i = 0;
    当 (i < 借出名们.大小()) {
        如果 (借出名们.元素(i) == 名ID) { 找到 = i; }
        i++;
    }
    返回 找到;
}

// 节点索引 → 所属最内层块区间；未命中（不在任何块内）返回 起=-1
函数 查所属块(整64 索引, 整64& 出起, 整64& 出终) -> 空类型 {
    出起 = 0 - 1;
    出终 = 0 - 1;
    整64 最窄 = 0 - 1;
    整64 i = 0;
    当 (i < 块起们.大小()) {
        整64 b起 = 块起们.元素(i);
        整64 b终 = 块终们.元素(i);
        如果 (b起 <= 索引 && 索引 < b终) {
            整64 宽 = b终 - b起;
            如果 (最窄 < 0 || 宽 < 最窄) {
                最窄 = 宽;
                出起 = b起;
                出终 = b终;
            }
        }
        i++;
    }
}

// 借出绑定登记（声明初始化位/赋值位；同视图名=重新绑定：活跃区间从新绑定重新计）
//   接收者形态：标识符（简单）/成员链（键=路径文本、类型=逐层字段推导）
函数 登记借出绑定(向量<节点> 池, 整32 表达式末, 整64 视图名ID, 整64 绑定索引) -> 空类型 {
    整64 接索引 = 0 - 1;
    整64 方法名ID = 0 - 1;
    如果 (!解剖方法调用(池, 表达式末, 接索引, 方法名ID)) { 返回; }
    如果 (!是借出方法名(驻留文本(方法名ID))) { 返回; }
    整64 基础名ID = 0 - 1;
    整64 容器类型名 = 接收者类型名ID(池, 接索引, 基础名ID);
    如果 (容器类型名 < 0) { 返回; }
    字符串 容器类型文本 = 字符串复制(驻留文本(容器类型名));
    如果 (!(是字符串元素容器(容器类型文本) || 是字符串值映射(容器类型文本))) {
        返回;
    }
    整64 基础名2 = 0 - 1;
    字符串 键 = 路径文本递归(池, 接索引, 基础名2);
    如果 (字符串长度(键) == 0) { 返回; }
    整64 简单 = 0;
    如果 (接索引 >= 0 && 接索引 < 整64(池.大小())) {
        节点 接节点 = 池.元素(整32(接索引));
        如果 (接节点.类型 == 节点_标识符) { 简单 = 1; }
    }
    整64 找到 = 查借出登记序(视图名ID);
    如果 (找到 >= 0) {
        设置串(借出容器们, 找到, 键);
        设置64(借出容器基础名们, 找到, 基础名2);
        设置64(借出容器简单们, 找到, 简单);
        设置64(借出绑定们, 找到, 绑定索引);
        设置64(借出使用们, 找到, 0);
        设置64(借出已报们, 找到, 0);
        返回;
    }
    追加64(借出名们, 视图名ID);
    追加串(借出容器们, 键);
    追加64(借出容器基础名们, 基础名2);
    追加64(借出容器简单们, 简单);
    追加64(借出绑定们, 绑定索引);
    追加64(借出使用们, 0);
    追加64(借出已报们, 0);
}

// 失效点登记（字符串元素容器/字符串值映射的失效方法调用）
函数 登记失效点(向量<节点> 池, 整32 调用索引) -> 空类型 {
    整64 接索引 = 0 - 1;
    整64 方法名ID = 0 - 1;
    如果 (!解剖方法调用(池, 调用索引, 接索引, 方法名ID)) { 返回; }
    整64 基础名ID = 0 - 1;
    整64 容器类型名 = 接收者类型名ID(池, 接索引, 基础名ID);
    如果 (容器类型名 < 0) { 返回; }
    字符串 容器类型文本 = 字符串复制(驻留文本(容器类型名));
    如果 (!(是字符串元素容器(容器类型文本) || 是字符串值映射(容器类型文本))) {
        返回;
    }
    如果 (!是失效方法(容器类型文本, 驻留文本(方法名ID))) { 返回; }
    整64 基础名2 = 0 - 1;
    字符串 键 = 路径文本递归(池, 接索引, 基础名2);
    如果 (字符串长度(键) == 0) { 返回; }
    追加串(失效容器们, 键);
    追加64(失效方法们, 方法名ID);
    追加64(失效位置们, 整64(调用索引));
}

// 借出视图使用登记（标识符出现=使用：活跃区间右端取最大节点索引）
函数 登记借出使用(整64 名ID, 整64 索引) -> 空类型 {
    整64 k = 0;
    当 (k < 借出名们.大小()) {
        如果 (借出名们.元素(k) == 名ID && 借出使用们.元素(k) < 索引) {
            设置64(借出使用们, k, 索引);
        }
        k++;
    }
}

// 调用点同源互斥（77-a 扩展①，跨函数别名窄面）：同一调用的实参列表中，
//   「容器引用键 = C」与「来源为 C 的借出视图实参」并存 → 拒绝。
//   实参定位=解析期「调用实参末位表」（键=调用节点索引*键位移+序号）；
//   容器实参的类型不重复判定（键相同 + 借出登记已隐含容器语义）。
//   覆盖面=实参标识符已登记为借出视图；内联形态与结构体/全局中转列诚实边界。
函数 检查调用同源互斥(向量<节点> 池, 整32 调用索引, 向量<字符串> 诊断) -> 空类型 {
    节点 n = 池.元素(调用索引);
    如果 (n.附加 < 2) { 返回; }
    整64 实参数 = n.附加;
    整64 i = 0;
    当 (i < 实参数) {
        整64 末位 = 查调用实参末位(整64(调用索引), i);
        如果 (末位 >= 0 && 末位 < 整64(池.大小())) {
            节点 末 = 池.元素(整32(末位));
            如果 (末.类型 == 节点_标识符) {
                整64 视图名ID = 整64(末.文本);
                整64 查序 = 查借出登记序(视图名ID);
                如果 (查序 >= 0 && 借出已报们.元素(查序) == 0) {
                    整64 j = 0;
                    当 (j < 实参数) {
                        如果 (j != i) {
                            整64 末位2 = 查调用实参末位(整64(调用索引), j);
                            如果 (末位2 >= 0 && 末位2 < 整64(池.大小())) {
                                整64 基础名j = 0 - 1;
                                字符串 键j = 路径文本递归(池, 末位2, 基础名j);
                                如果 (字符串长度(键j) > 0 &&
                                    字符串比较(键j, 借出容器们.元素(查序))) {
                                    设置64(借出已报们, 查序, 1);
                                    表诊断(诊断, "[错误] 实参 " +
                                        字符串复制(驻留文本(视图名ID)) +
                                        " 是容器 " + 借出容器们.元素(查序) +
                                        " 的借出视图，与该容器同时作为实参传入——" +
                                        "被调函数若修改容器该视图即悬垂；须先 " +
                                        "字符串复制(...) 取拥有副本" +
                                        "（Rust 借用检查器同类拒绝：同调用容器与其视图不可并存）");
                                }
                            }
                        }
                        j++;
                    }
                }
            }
        }
        i++;
    }
}

// 借出视图生命周期检查主入口（检查函数 尾部调用；函数节点区间：
//   参数区 [函数体.子起点, 函数体.子终点)，体块 = 池.元素(函数体.子终点)）
不安全 函数 检查借出视图生命周期(向量<节点> 池, 整32 函数节点,
                          向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 空类型 {
    清空借出检查();
    如果 (函数节点 < 0 || 函数节点 >= 池.大小()) { 返回; }
    节点 函数体节点 = 池.元素(函数节点);
    如果 (整64(函数体节点.子终点) >= 整64(池.大小())) { 返回; }
    节点 体块 = 池.元素(整32(函数体节点.子终点));
    如果 (体块.类型 != 节点_块) { 返回; }
    整64 扫描起 = 整64(体块.子起点);
    整64 扫描终 = 整64(体块.子终点);
    如果 (扫描起 < 0 || 扫描终 > 整64(池.大小()) || 扫描起 >= 扫描终) { 返回; }
    // ① 预扫描：块区间表 + 声明表（局部变量 + 参数）
    整64 i = 整64(函数体节点.子起点);
    当 (i < 整64(函数体节点.子终点)) {
        节点 参数 = 池.元素(整32(i));
        如果 (参数.类型 == 节点_参数) {
            追加64(声明名们, 整64(参数.文本));
            追加64(声明类型们, 归一类型名(池, 整64(参数.附加)));
            追加64(声明位置们, i);
        }
        i++;
    }
    i = 扫描起;
    当 (i < 扫描终) {
        节点 n = 池.元素(整32(i));
        如果 (n.类型 == 节点_块) {
            追加64(块起们, 整64(n.子起点));
            追加64(块终们, 整64(n.子终点));
        } 否则 如果 (n.类型 == 节点_变量声明) {
            追加64(声明名们, 整64(n.文本));
            追加64(声明类型们, 归一类型名(池, 整64(n.附加)));
            追加64(声明位置们, i);
        }
        i++;
    }
    // ② 主扫描：借出绑定（声明位/赋值位）/ 失效点 / 使用登记 / 调用点同源互斥
    i = 扫描起;
    当 (i < 扫描终) {
        节点 n = 池.元素(整32(i));
        如果 (n.类型 == 节点_变量声明) {
            如果 (n.子终点 > n.子起点) {
                登记借出绑定(池, n.子终点 - 1, 整64(n.文本), i);
            }
        } 否则 如果 (n.类型 == 节点_赋值) {
            // 赋值节点字段（解析语句.cn 建节点）：文本=左值名ID（0=成员/下标
            //   左值形态——不入面），子起点=右值区间起点、子终点=右值区间终（独占）
            如果 (n.子终点 > n.子起点 && n.文本 != 0) {
                登记借出绑定(池, n.子终点 - 1, 整64(n.文本), i);
            }
        } 否则 如果 (n.类型 == 节点_调用) {
            登记失效点(池, 整32(i));
            检查调用同源互斥(池, 整32(i), 诊断);
        } 否则 如果 (n.类型 == 节点_标识符) {
            登记借出使用(整64(n.文本), i);
        }
        i++;
    }
    // ③ 结算：①同作用域失效（失效点 ∈ (绑定, 最后使用)）
    //          ②跨作用域逃逸（使用点不在容器声明所在块区间内=容器先亡；仅简单名）
    整64 k = 0;
    当 (k < 借出名们.大小()) {
        如果 (借出已报们.元素(k) == 0) {
            整64 视图名 = 借出名们.元素(k);
            整64 绑定 = 借出绑定们.元素(k);
            整64 使用 = 借出使用们.元素(k);
            如果 (使用 > 绑定) {
                字符串 视图文本 = 字符串复制(驻留文本(视图名));
                字符串 容器文本 = 借出容器们.元素(k);
                布尔 已报 = 假;
                整64 m = 0;
                当 (m < 失效容器们.大小()) {
                    如果 (!已报 && 字符串比较(失效容器们.元素(m), 容器文本)) {
                        整64 失效位 = 失效位置们.元素(m);
                        如果 (失效位 > 绑定 && 失效位 < 使用) {
                            表诊断(诊断, "[错误] 借出视图 " + 视图文本 +
                                          "（来源容器 " + 容器文本 +
                                          "）在容器失效点（" +
                                          字符串复制(驻留文本(失效方法们.元素(m))) +
                                          "）之后仍被使用——该元素已被释放/移出（悬垂）；" +
                                          "须先 字符串复制(...) 取拥有副本，或调整使用顺序");
                            设置64(借出已报们, k, 1);
                            已报 = 真;
                        }
                    }
                    m++;
                }
                如果 (!已报 && 借出容器简单们.元素(k) == 1) {
                    整64 容器声明位 = 查声明位置(借出容器基础名们.元素(k));
                    如果 (容器声明位 >= 0) {
                        整64 容块起 = 0 - 1;
                        整64 容块终 = 0 - 1;
                        查所属块(容器声明位, 容块起, 容块终);
                        如果 (容块起 >= 0 && !(容块起 <= 使用 && 使用 < 容块终)) {
                            表诊断(诊断, "[错误] 借出视图 " + 视图文本 +
                                          "（来源容器 " + 容器文本 +
                                          "）在容器作用域结束后仍被使用——容器析构已释放" +
                                          "该元素（容器先亡=悬垂）；须在容器作用域内 " +
                                          "字符串复制(...) 取拥有副本");
                            设置64(借出已报们, k, 1);
                        }
                    }
                }
            }
        }
        k++;
    }
}
