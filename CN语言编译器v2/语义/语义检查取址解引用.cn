// CN 自举编译器 v2 · 语义检查——取地址/解引用检查族（652 轮拆分：自
//   语义检查.cn 机械搬移〔原「族②：取地址/解引用检查」段·原 394~430 段〕
//   ——先拆再加纪律：语义检查.cn 996 行贴 1000 冻结线，652 取址真实类型
//   推导增强须先拆后加；本文件行数余量充足）。
// 职责：188-a 取地址=恒空/零值判定失格+初始化通道置位 + 76-a 解引用返回
//   真实指向类型（查语义指针变量）+ 153-a 常量空指针解引用硬错误 +
//   154-a B6/B7 裸指针解引用警告 + 188-a 恒空使用点登记 + **652 取地址返回
//   真实指针类型**（推导检查类型文本 取地址分支同源·宿主 checkAddressOfUnary
//   lastType_=操作数+"*" 同构——修前恒整64 兜底致「显式取址实参传引用形参」
//   v2 放行/宿主拒分叉=IR 层二次取址传地址整数值进引用槽·运行期写飞）。
// 返回 整64 兜底（推导界外形态=诚实边界）。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（目录包名）
导入 IR;         // 容器/结果 合成名判定 + 节点_*/键位移 常量（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 族②：取地址/解引用检查（652 轮机械搬移·零行为变更）——188-a 取地址=
//   恒空判定失格 + 76-a 解引用返回真实指向类型（查语义指针变量）+ 153-a
//   常量空指针解引用硬错误 + 154-a B6/B7 裸指针解引用警告 + 188-a 恒空
//   使用点登记。返回 整64 兜底（推导界外形态=诚实边界）。
函数 检查取地址解引用表达式(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    // 188-a（D6·plans/023 B11 变量常量传播）：取地址=别名逃逸（外部可经别名
    //   改写该变量）→ 恒空判定失格（保守，防假阳性）
    如果 (n.类型 == 节点_取地址 && n.子起点 >= 0 && n.子起点 < 池.大小()) {
        节点 取址操作数188 = 池.元素(整32(n.子起点));
        如果 (取址操作数188.类型 == 节点_标识符) {
            登记恒空失格(整64(取址操作数188.文本));
            // 548（编译期除零·常量传播）：取地址=别名逃逸同款零值失格（外部
            //   可经别名改写零初值变量·保守防假阳性——宿主 noteZeroDisqual 同构）
            登记零值失格(整64(取址操作数188.文本));
            // 010（def-init）：取地址=初始化通道（地址逃逸=可能被写——Rust
            //   &mut maybe-init 同款；查方法签名(&签) 出参形态铁证）——整体置位
            状态置位标识符(符号表, 整64(取址操作数188.文本));
        }
    }
    // 652（2026-10-16·623 邻接既存分叉根治·修法甲）：取地址返回**真实指针
    //   类型**——&X 类型=操作数类型文本+"*"（宿主 checkAddressOfUnary
    //   lastType_=操作数+"*" 同构·76-a 解引用返回真实指向类型的镜像；Rust
    //   &x 类型即基类型指针）。修前恒返回整64 兜底 → 表达式类型ID 对 &x
    //   推导整64 → 调用面以为与引用形参匹配 → IR 层对 &x 再取址=传地址整数
    //   值给引用槽=被调方按垃圾地址解引用（运行期写飞·安全缺陷；探针
    //   target/probe652 实录：宿主 rc=1「未找到匹配的函数」/v2p 修前 rc=0
    //   放行）。推导经 推导检查类型文本（443 值位推导单一归属——其取地址
    //   分支：指针变量按符号登记基名补星得变量自身类型/数组操作数退化元素
    //   类型/函数名=函数指针文本/引用参数=基名→&r=基名+"*" 恰为 T*〔C++
    //   同款〕/字符变量→字符*；复合操作数〔成员/下标〕=界外空串）——界外
    //   落下方整64 兜底（诚实边界·随 v2 类型推导长线收口）。消费面=
    //   表达式类型ID 全检查面 + 549 实参转换（语义检查实参.cn 652 条款）。
    如果 (n.类型 == 节点_取地址) {
        字符串 取址文本652 = 推导检查类型文本(池, 节点索引, 符号表);
        // 非空=推导成功（882 门禁：「长度>0」单边开区间形态清偿→等价非空判定）
        如果 (!字符串比较(取址文本652, "")) { 返回 驻留(取址文本652); }
    }
    // 76-a 后续（2026-09-12，用户裁决方案甲）：解引用返回**真实指向类型**——
    //   操作数为标识符且登记在指针变量表（查语义指针变量，指针下标 p[i] 路径
    //   同款机制）时返回所指类型；否则维持 整64 兜底（复合形态=诚实边界）。
    //   修复前恒返回 整64（「暂标量」）→ 一切经 表达式类型ID 的检查面
    //   （混合符号赋值/二元运算等）对解引用形态拿到 整64（有符号）→ 与 正8
    //   等无符号真实类型混合时漏检（实证：返回 *q; 宿主拒绝 / v2p 编译成功；
    //   修复后两侧一致拒绝——E2E 222/222_v2 锚定）
    如果 (n.类型 == 节点_解引用 && n.子起点 >= 0 && n.子起点 < 池.大小()) {
        节点 操作数d = 池.元素(整32(n.子起点));            // 153-a（plans/023 B11 v2 挂点）：**常量空指针解引用**（编译期硬错误）——
        //   操作数为「无」字面量（节点_整数字面量 附加==1，解析层标记）时确定性
        //   错误（宿主同构：*无 →「编译期常量空指针解引用」Error）。
        如果 (操作数d.类型 == 节点_整数字面量 && 操作数d.附加 == 1) {
            表诊断(诊断, "[错误] 编译期常量空指针解引用（确定性错误；plans/023 B11）");
        }
        如果 (操作数d.类型 == 节点_标识符) {
            可选<整64> 所指类型d查 = 查语义指针变量(整64(操作数d.文本));
            // 652 拆分轮：原「>= 0」单边开区间形态清偿→可选有值等价改写
            //   （查语义指针变量 契约：无值=未登记·有值=所指类型ID）
            如果 (所指类型d查.有值) {
                // 154-a（B6/B7 v2 挂点）+1471 文本对齐：裸指针解引用读/写按位
                //   分派（宿主 checkDerefUnary B6「裸指针解引用读…（指针解引用
                //   （*p））」/ checkUnaryCallAssignTarget B7「裸指针解引用写…
                //   （指针解引用写（*p = x））」逐字同构；写目标链中/副本链=
                //   宿主 assignmentTargetDepth_ 抑制面静默——位判派单点
                //   解引用写位判派1471）。字符* 单级=字符串视图豁免（宿主
                //   isStringSemanticType 同构）。
                //   报文走**事件表登记**（登记解引用事件1471·节点级去重·函数
                //   收尾 判报解引用事件1471 单点报文）——显式解引用节点多通道
                //   重复到达（静默副本通道先行+894-a 自增双遍），到达即报会双
                //   报/被副本吃（t1/l/m 探针实证）·事件表天然免疫。
                整32 写位d1471 = 解引用写位判派1471(整32(节点索引));
                可选<整64> 层数d查1471 = 查语义指针层数(整64(操作数d.文本));
                布尔 单级d1471 = 假;
                如果 (层数d查1471.有值) {
                    整64 层数d1471 = 层数d查1471.值;
                    如果 (层数d1471 == 1) { 单级d1471 = 真; }
                }
                // 字符串语义豁免判据=**符号表声明类型**（宿主 isStringSemanticType
                //   (operandType=声明类型文本) 同源——209 实证：`字符* p = &名单[1]`
                //   指针表登记所指=数组元素类型「字符串」（94-a）≠声明基名「字符」，
                //   按所指判则漏豁免=与宿主条数分叉）——基名「字符」∧单级=「字符*」
                //   借用字符串视图（解引用取首字符=字符串语义面·非裸指针危险操作）。
                布尔 字符视图d1471 = 假;
                如果 (单级d1471) {
                    可选<整64> 声明基d查 = 表查找类型ID(符号表, 整64(操作数d.文本));
                    // 882 门禁清偿：表查找契约命名布尔（有值=已登记·无值=未登记=
                    //   不豁免交既有报面·另一端显式）——926 指针表命中同款
                    布尔 声明基有效d1471 = 声明基d查.有值;
                    如果 (声明基d查.有值) {
                        整64 声明基d1471 = 声明基d查.值;
                        // 符号表登记类型文本=基名+尾星（926 剥尾星615 同源）——
                        //   剥星后比基名（「字符*」→「字符」）
                        字符视图d1471 = 字符串比较(
                            剥尾星615(字符串复制(驻留文本(声明基d1471))), "字符");
                    }
                }
                如果 (!字符视图d1471) {
                    布尔 直写位d1471 = 写位d1471 == 1;
                    布尔 读位d1471 = 写位d1471 == 0;
                    如果 (读位d1471 || 直写位d1471) {
                        // 读=0 写直写=1 入表；位==2（写目标链中/副本链）=宿主
                        // assignmentTargetDepth_ 抑制面·不登记（同面静默）
                        登记解引用事件1471(整64(节点索引), 整64(取当前诊断行()),
                                          整64(写位d1471));
                    }
                }
                // 188-a（D6 B11 变量常量传播）：恒空候选使用点登记（面=解引用）
                //   ——门外·重复到达仍登记（登记自带 名×行×面 去重）
                登记恒空使用点(整64(操作数d.文本), 整64(取当前诊断行()), 1);
                返回 所指类型d查.值;
            } 否则 {
                // 648 归档（豁免边界声明）：解引用操作数不在语义指针变量表=
                //   常态面（泛型/参数指针等未入表形态·L2 144 指针们 实证——
                //   首记 648 曾登记后回撤）；原整64 兜底保留，所指类型精确
                //   推导面随指针类型推导专项。
            }
        }
        // 648：miss 不可静默——解引用复合操作数形态（非标识符·指向类型查询未
        //   覆盖）=真 miss 显形（无 字面量面已由 153-a 上游诊断=恢复路径不重复；
        //   显形经 IR 包收集表·登记处出诊断行·主收尾统一中止），原整64 兜底
        //   保留（中止前路径）
        如果 (操作数d.类型 != 节点_标识符 && 操作数d.类型 != 节点_整数字面量) {
            登记内部未登记("解引用指向类型不可推导（复合操作数形态）",
                           "节点" + 整数转字符串(整64(节点索引)), 整64(取当前诊断行()));
        }
    }
    // 648+652 后本函数返回口径：取地址（推导可靠面）=操作数类型+*（真实指针
    //   类型·见上方 652 注）；解引用（指针变量表命中）=真实指向类型（76-a）；
    //   其余形态（复合操作数/推导界外）=整64 兜底（诚实边界）。
    返回 驻留("整64");
}
