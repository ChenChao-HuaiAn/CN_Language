// CN 自举编译器 v2 · 语义检查——容器方法调用三段检查（907·855 呈报 312 收口）
// 职责：容器实例（$ 合成名·判据=IR容器判定 是容器类 单点）成员方法调用的语义层
//   检查三段（宿主 checkMemberCallCore/checkInstanceMethodCall 同面）：
//   ①方法名不存在 -> 「类 'X' 没有成员 'Y'」（宿主实测同文案）；
//   ②方法名存在但实参个数不符 -> 「方法 'X' 期望 N 个实参，实际提供 M 个」
//     （宿主 checkInstanceMethodCall 原文逐字）；
//   ③实参个数符但实参类型不可隐式转换 -> 「方法 'X' 第 i 个实参无法将 'A'
//     隐式转换为 'B'」（宿主原文逐字·canConvertWithLiteral/canConvertArgNarrow
//     口径经 实参转换非法 复用——与 检查调用实参转换 同源判定）。
// 背景（907 探查实证·312 用例三形态）：v2 语义层对容器实例成员方法调用零检查——
//   方法名 miss（表.推入("文字")）/实参个数错（表.追加()）走到 IR 层
//   「[ir2] 容器方法未收录」+运行时错误(6) 崩溃式拒绝；实参类型错
//   （表.追加("文字")）甚至 rc=0 放行（真・零分叉缺口）。宿主同源分别给
//   「没有成员」/「期望 N 个实参」/「第 i 个实参无法将…」三类语义诊断。
// 判据来源=IR签名 签名表（键=基名.方法名.参数个数·stdlib 容器.cn/映射集合.cn
//   源码级扫描登记）与 IR容器签名 查方法签名（泛型实参替换后的形参串）；
//   新增 查方法名参数个数（IR签名）区分「方法名不存在」与「实参数不符」两形态
//   （单键 miss 无法区分二者）。实参转换判定复用 实参转换非法/实参源类型文本
//   （语义检查实参.cn——549 族判定本体，本文件不重复实现）。
// 诚实边界（检不出放行·防误伤）：对象形态非 标识符/成员链（调用返回/下标/
//   解引用对象等推导不可靠面）；接收者类型推导 miss；非容器实例（用户类/接口/
//   结果可选——各自检查通道承担）；形参非标量目标（指针/引用/类/容器/结构体/
//   泛型名——实参转换非法 内建同款诚实边界）；重载多版本（期望个数取登记值·
//   stdlib 容器类现无同名多参数版本）。
// 写码风格（882 三红门禁）：区间比较归入命名布尔、条件位全布尔名；否则分支
//   仅报错调用（else 降格非法输入拦截）。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/查调用实参末位（解析表达式中）
导入 IR;         // 是容器类_ID/合成名基名/确保签名已加载/查方法签名/查方法名参数个数/取参数段
导入 协议常量;   // 驻留/驻留文本（中立层）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 接收者类型解析（调用节点 被调=成员 形态）：标识符对象=符号表类型；成员链
//   对象=语义成员链推导（语义分析.cn 推导语义成员链类型——890/609 先例同口径）；
//   其余对象形态（调用/下标/解引用等）=0（诚实边界）。返回 0=不可解析。
函数 容器方法接收者类型(向量<节点> 池, 节点 被调,
                       向量<映射<整64, 符号>>& 符号表) -> 整64 {
    布尔 子起点有效 = 被调.子起点 > 0 && 整64(被调.子起点) < 整64(池.大小());
    布尔 成员形 = 被调.类型 == 节点_成员;
    如果 (!成员形 || !子起点有效) { 返回 0; }
    节点 对象 = 池.元素(整32(被调.子起点));
    如果 (对象.类型 == 节点_标识符) {
        返回 表查找类型ID(符号表, 整64(对象.文本));
    }
    如果 (对象.类型 == 节点_成员) {
        返回 推导语义成员链类型(池, 整32(被调.子起点), 符号表);
    }
    返回 0;
}

// 检查容器方法调用（挂点=检查调用表达式 入口——与 检查调用实参转换/检查引用
//   实参左值 同列）。诊断经 诊断 向量（静默通道被吞弃·权威通道可见=549
//   零双报惯例）。
函数 检查容器方法调用(向量<节点> 池, 整32 节点索引,
                    向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    如果 (节点索引 < 0 || 节点索引 >= 整32(池.大小())) { 返回; }
    节点 n = 池.元素(节点索引);
    布尔 调用形 = n.类型 == 节点_调用;
    布尔 子起点有效 = n.子起点 > 0 && 整64(n.子起点) < 整64(池.大小());
    如果 (!调用形 || !子起点有效) { 返回; }
    节点 被调 = 池.元素(整32(n.子起点));
    整64 接收者类型 = 容器方法接收者类型(池, 被调, 符号表);
    布尔 类型有效 = 接收者类型 > 0;
    如果 (!类型有效) { 返回; }          // 推到不可解析面=诚实边界
    如果 (!是容器类_ID(接收者类型)) { 返回; }   // 非容器实例面=各自检查通道
    字符串 合成名 = 字符串复制(驻留文本(接收者类型));
    字符串 基名 = 合成名基名(合成名);
    字符串 方法名 = 字符串复制(驻留文本(整64(被调.文本)));
    整64 实参数 = 整64(n.附加);
    确保签名已加载();
    方法签名 签;
    如果 (!查方法签名(合成名, 方法名, 实参数, &签)) {
        // 单键 miss：按方法名存在性分流两类诊断（907·与宿主两文案对齐）
        整64 期望个数 = 查方法名参数个数(基名, 方法名);
        布尔 名存在 = 期望个数 >= 0;     // 返回域闭集 {-1} ∪ [0,∞)（IR签名 登记约定）
        如果 (!名存在) {
            表诊断(诊断, "[错误] 类 '" + 合成名 + "' 没有成员 '" + 方法名 + "'");
        } 否则 {
            表诊断(诊断, "[错误] 方法 '" + 方法名 + "' 期望 " +
                          整数转字符串(期望个数) + " 个实参，实际提供 " +
                          整数转字符串(实参数) + " 个");
        }
        返回;
    }
    // 命中=方法存在且个数相符——逐实参隐式转换检查（标量目标面·实参转换非法
    //   内建非标量目标放行）。907 同族归纳（纪律二）：循环提炼为 逐实参转换
    //   检查907（语义检查实例方法.cn 单点归属·三步措辞前缀共用），本处消费之。
    逐实参转换检查907(池, 整64(节点索引), 实参数, 签.参数串, 方法名, "方法",
                    符号表, 诊断);
}
