// 语义检查·格式化占位符配对执法（#1910·001 §10.6 编译期配对立法 2026-11-02）
// 职责：格式化 变参内置调用的占位符逐位配对核验（个数相等+类型匹配），违例
//   编译期拒绝（诊断文案与宿主 tryEmitFormatCall·ir_call_builtin.cpp 逐字对齐
//   ——七形态：整128配%d/正128配%u/整64配%d〔64 位专用占位符待立法过渡拒〕/
//   实参无坑〔{} 花括号形态主诉〕/坑无实参/未知占位符/格式串非字面量）。
//   宿主侧执法点=IR 层（实参求值后类型就绪）；v2 侧=语义层（推导检查类型文本
//   443 设施同源）——执法层级错位但文案/行为零分叉（dual 各锚各的通道）。
//   扫描/配对表/指路文案=中立层单点（协议常量/格式化占位符.cn·语义/IR 双面共用）。
//   128 位改写发射面（%d128/%u128 → %s+转串调用）在 IR 层 生成表达式求值中.cn
//   内置通道（1100 窄化豁免同 1891 转串族形态）。
// 消费=语义检查表达式.cn 检查调用表达式（检查变参打印实参 443 挂点之后单行）。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_* 常量（目录包名）
导入 IR;         // 结果 合成名判定（目录包名）
导入 协议常量;   // 扫描格式化占位符/查调用实参末位（中立层）

公开:   // 全文件公开（包内兄弟模块消费）

// 主检查：格式化 调用的占位符配对执法（挂点=检查调用表达式·检查变参打印实参
//   443 之后——443 值面/串面对 整128 放行，本函数做逐位精配）。非格式化早退。
//   实参定位表 miss=放行（443 同款诚实边界：查调用实参末位 仅覆盖已登记形态，
//   复杂实参形态类型文本空串同 443 口径放行——上游已诊断/既有边界，非新增静默）。
函数 检查格式化占位符配对(向量<节点> 池, 节点 n, 整32 调用节点索引,
                    向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    // 443 同款防护（443 原款 <=0 收窄判等：负子起点=解析器不产形态）
    如果 (n.子起点 == 0 || 整64(n.子起点) >= 池.大小()) { 返回; }
    节点 被调配 = 池.元素(整32(n.子起点));
    如果 (被调配.类型 != 节点_标识符) { 返回; }
    字符串 被调名配 = 字符串复制(驻留文本(整64(被调配.文本)));
    如果 (!字符串比较(被调名配, "格式化")) { 返回; }

    // 格式串实参缺位：变参零实参调用（连格式串都没有）
    如果 (整64(n.附加) == 0) {
        表诊断(诊断, "[错误] 格式化须提供格式串实参");
        返回;
    }
    // 实参 0（格式串）定位与字面量判定
    可选<整64> 串位查 = 查调用实参末位(整64(调用节点索引), 0);
    如果 (!串位查.有值) { 返回; }   // 实参定位表 miss=443 同款诚实边界放行
    整64 串位 = 串位查.值;
    如果 (串位 < 0 || 串位 >= 整64(池.大小())) { 返回; }
    节点 串节点 = 池.元素(整32(串位));
    如果 (串节点.类型 != 节点_字符串字面量) {
        表诊断(诊断, "[错误] 格式化格式串须为字符串字面量（占位符须编译期配对核验）");
        返回;
    }
    // 词法层已解码转义（词法分析 解码字符串内容）——驻留文本=纯内容格式串
    字符串 格式串 = 字符串复制(驻留文本(整64(串节点.文本)));

    // 占位符扫描：表外形态即拒
    向量<字符串> 种类们 = 向量<字符串>();
    字符串 改写串 = "";
    字符串 坏占位符 = "";
    如果 (!扫描格式化占位符(格式串, 种类们, 改写串, 坏占位符)) {
        表诊断(诊断, "[错误] 未知占位符 " + 坏占位符 +
              "（占位符表：%%/%d/%u/%f/%s/%c/%x/%X/%o/%p/%d64/%u64/%d128/%u128）");
        返回;
    }

    // 个数执法（双向·静默丢参/读栈垃圾双拦）
    整64 坑数 = 整64(种类们.大小());
    整64 实参数 = 整64(n.附加) - 1;
    如果 (坑数 != 实参数) {
        如果 (实参数 > 坑数) {
            表诊断(诊断, "[错误] 实参 " + 整数转字符串(坑数 + 1) +
                  " 无占位符消费（占位符 " + 整数转字符串(坑数) +
                  " 个·实参 " + 整数转字符串(实参数) + " 个）");
        } 否则 {
            表诊断(诊断, "[错误] 占位符 " + 整数转字符串(实参数 + 1) +
                  " 无实参可供（占位符 " + 整数转字符串(坑数) +
                  " 个·实参 " + 整数转字符串(实参数) + " 个）");
        }
        返回;
    }

    // 逐位类型配对执法：任一位不配即拒（首错即止=宿主同口径）
    整64 位 = 0;
    当 (位 < 实参数) {
        可选<整64> 实参位查 = 查调用实参末位(整64(调用节点索引), 位 + 1);
        如果 (实参位查.有值) {
            整64 实参位 = 实参位查.值;
            // 末位表命中值=池索引恒非负（表契约）——只查上界
            如果 (实参位 < 整64(池.大小())) {
                字符串 实参类型 = 推导检查类型文本(
                    池, 整32(实参位), 符号表);
                // 静默豁免上游已诊断: 类型文本 miss（空串）跳过配对=443 既有
                //   诚实边界；宽位面由 IR 层码面二次甄别兜底显形（残窗=呈报项）
                如果 (字符串长度(实参类型) != 0) {
                    字符串 种类 = 字符串复制(种类们.元素(整32(位)));
                    如果 (!格式化占位符配实参合法(种类, 实参类型)) {
                        表诊断(诊断, "[错误] 占位符 %" + 种类 +
                              " 与实参 " + 整数转字符串(位 + 1) + " 类型 " +
                              格式化类型显示文本(实参类型) + " 不匹配" +
                              格式化配对指路(种类, 实参类型));
                        返回;
                    }
                }
            }
        }
        位++;
    }
}
