// CN 自举编译器 v2：结构化语义分析器（自举重建 P4 重做，2026-08-25，第6版）
// 符号表 = 向量<映射<整64, 符号>> 真嵌套作用域栈——每层独立 O(1) 哈希映射。
// 相比第5版「单映射 + 每符号深度 + 延迟删除」：弹出真正移除该层符号（查找
// 无深度遮蔽检查、无残留符号），对标 rustc/LLVM 作用域栈。
// 依赖（宿主根治）：H8-5 容器持有类对象所有权——向量 追加 类元素深拷贝独立、
// 绑定元素为非拥有式视图（不触发 RAII 双释放）；Feature 2 完整版 向量 删除/
// ~向量 自动销毁有析构类元素（编译器级注入，弹出无需显式 释放内部数组()）。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（原 语法分析，阶段目录包名）
导入 IR;         // 容器/结果 合成名判定 + 节点_*/键位移 常量（原 IR容器+IR常量 合并目录包名）

公开:

常量 符号_变量 = 1;
常量 符号_参数 = 2;
常量 符号_函数 = 3;
常量 符号_结构体 = 4;
常量 符号_常量 = 5;     // P7a：顶层常量（类型按字面量记 整64；值内联在 IR 层完成）

结构体 符号 {
    整64 名ID;
    整64 类型ID;
    整64 种类;
    整64 附加;
    整64 已转移;   // plans/019 阶段1：转移(变量) 后源变量禁用（E0382 对标）；
                  //   0=未转移（表注册 显式清零——结构体局部无零初始化纪律）
}

// ==================== 模块分桶（plans/018 P6b 第 3 层，2026-09-07） ====================
// 名称解析三级模型（plans/001 §5.9.7，Rust item > named use > glob 对齐）：
//   ① 本模块显式声明（模块成员键基们）＞ ② 显式导入（文件导入键基们，构建期
//   解析+可见性/E0255 检查）＞ ③ 通配（导入模块路径们 遍历，公开成员、使用点
//   歧义 E0659）。①遮蔽③ 合法；①×② / ②×② 同名=编译错误。
// 全局符号表键升级为「键基」（IR容器.键基合成：主模块=纯名、其余=模块$名）——
//   跨模块同名同签名合法共存（原「先收集文件赢」静默/硬错误 面根治）；单文件
//   与主模块形态键=纯名，行为逐字节不变（v2self 产物对拍硬基准）。
// 静态上下文为「当前检查文件」维度：语义分析多文件 第二趟逐文件由
//   构建文件导入上下文 重设；三级决议结果缓存（三级键基缓存们）同窗口生命周期。
静态 映射<整64, 整64> 模块成员键基们;   // 模块路径ID*键位移+名ID -> 键基ID
静态 映射<整64, 整64> 模块成员公开们;   // 同键 -> 1=公开（公开: 标签；缺省私有）
静态 映射<整64, 整64> 文件导入键基们;   // 绑定名ID -> 键基ID（② 构建期解析产物）
静态 向量<整64> 已加载模块ID们;         // ③ 合并全局可见的遍历范围=加载树全部模块（宿主事实标准对齐）
静态 整64 当前模块路径ID = 0;           // 当前检查文件的模块路径 驻留 ID
静态 映射<整64, 整64> 三级键基缓存们;   // 名ID -> 键基ID / -1 未命中 / -2 歧义（文件级）
静态 向量<字符串> 语义诊断缓冲;         // 查找链路歧义诊断缓冲（主流程末尾合入）

// 诊断缓冲追加（查找函数无诊断参数——歧义诊断经缓冲在 语义分析多文件 末尾
//   合入主诊断表，错误计数不漏）
函数 缓冲诊断(字符串 消息) -> 空类型 {
    结果<空类型, 整32> 加 = 语义诊断缓冲.追加(消息);
    如果 (!加.正常) { 运行时错误(4); }
}

// 成员索引键：模块路径ID*键位移+名ID（键位移 复用 IR常量 复合键惯例）
// （是标准库模块名/拆限定名 下沉 IR容器 中立层——IR 生成消费，避免 ir→frontend
//   反向依赖；两函数属通用符号设施）
函数 模块成员键(整64 模块ID, 整64 名ID) -> 整64 {
    返回 模块ID * 键位移 + 名ID;
}

// 三级键基决议（缓存版）：返回 键基ID / -1 未命中 / -2 歧义（首次经诊断缓冲
//   报 E0659，缓存后同名重复使用不再重复报）。实参数 >= 0 时③多命中按签名
//   个数消歧（宿主签名决议对齐：同名不同签名=重载共存合法，实参数可辨则选
//   其桶；实参数 <0=非调用裸名，同签名多模块才真歧义）。消费点：表查找类型ID/
//   表查找种类 的全局层、检查表达式 标识符与调用的签名回退、调用决议登记。
函数 三级键基查找(向量<映射<整64, 符号>> 符号表, 整64 名ID, 整64 实参数) -> 整64 {
    结果<整64, 整32> 查缓存 = 三级键基缓存们.获取(名ID);
    如果 (查缓存.正常) { 返回 查缓存.值; }
    整64 结果键基 = -1;
    // ① 本模块（成员索引=声明收集 登记）
    结果<整64, 整32> 查一 = 模块成员键基们.获取(模块成员键(当前模块路径ID, 名ID));
    如果 (查一.正常) {
        结果键基 = 查一.值;
    } 否则 {
        // ② 显式导入（构建文件导入上下文 解析：可见性/E0255 已在该处诊断）
        结果<整64, 整32> 查二 = 文件导入键基们.获取(名ID);
        如果 (查二.正常) {
            结果键基 = 查二.值;
        } 否则 {
            // ③ 合并全局可见（宿主事实标准对齐——加载树全部模块的公开符号，
            //   传递依赖可见：IR生成 用 IR签名 的 段首 经 IR容器 传递加载实证）。
            //   同名多命中按签名消歧：同签名多模块=真歧义 E0659（决议失败绝不
            //   静默）；不同签名=重载共存（实参数可辨选其桶，否则首候选——跨桶
            //   重载部分支持，诚实边界随 plans/018 注记）
            整64 候选键基 = -1;
            整64 首参串标 = -1;
            整64 真歧义 = 0;
            整64 命中数 = 0;
            字符串 来源们 = "";
            整64 g = 0;
            当 (g < 已加载模块ID们.大小()) {
                整64 m = 已加载模块ID们.元素(g);
                如果 (m != 当前模块路径ID) {
                    结果<整64, 整32> 查g = 模块成员键基们.获取(模块成员键(m, 名ID));
                    如果 (查g.正常) {
                        整64 键基g = 查g.值;   // 正向分支内提取（宿主 结果 流敏感检查惯例）
                        结果<整64, 整32> 查公 = 模块成员公开们.获取(模块成员键(m, 名ID));
                        如果 (查公.正常) {
                            // 该桶首个签名候选的参数串（签名消歧键；非函数=-1）
                            整64 参串标 = -1;
                            整64 查数g = 查函数签名个数(键基g);
                            如果 (查数g >= 0) {
                                如果 (查数g > 0) {
                                    整64 查串g = 查函数签名参数串(键基g * 键位移);
                                    如果 (查串g >= 0) { 参串标 = 查串g; }
                                }
                            }
                            如果 (命中数 == 0) {
                                命中数 = 1;
                                候选键基 = 键基g;
                                首参串标 = 参串标;
                                来源们 = 字符串复制(驻留文本(m));
                            } 否则 如果 (参串标 == 首参串标) {
                                // 同签名多模块=真歧义（且已锁定首候选可能不唯一）
                                真歧义 = 1;
                                来源们 = 来源们 + "/" + 驻留文本(m);
                            } 否则 {
                                // 不同签名=重载共存：实参数可辨则按参数个数选桶
                                如果 (实参数 >= 0) {
                                    整64 选桶 = 按实参数选桶(名ID, 实参数);
                                    如果 (选桶 >= 0) { 候选键基 = 选桶; }
                                }
                            }
                        }
                    }
                }
                g++;
            }
            如果 (真歧义 == 1) {
                缓冲诊断("[错误] 符号歧义: " + 驻留文本(名ID) + "（来自 " +
                              来源们 + "——须以 模块::符号 限定消歧，规格08-三）");
                结果键基 = -2;
            } 否则 {
                结果键基 = 候选键基;
            }
        }
    }
    结果<空类型, 整32> 设缓存 = 三级键基缓存们.设置(名ID, 结果键基);
    如果 (!设缓存.正常) { 运行时错误(4); }
    返回 结果键基;
}

// ③多命中不同签名的桶选择：按「签名候选参数个数=实参数」过滤各命中桶，
//   唯一匹配返回其键基；无/多匹配返回 -1（调用方保留首候选）。签名候选经
//   函数签名表（键基维度）逐桶查询；参数个数=逗号数+1 真数（决议函数符号 同款）
函数 按实参数选桶(整64 名ID, 整64 实参数) -> 整64 {
    整64 选中 = -1;
    整64 匹配数 = 0;
    整64 g = 0;
    当 (g < 已加载模块ID们.大小()) {
        整64 m = 已加载模块ID们.元素(g);
        如果 (m != 当前模块路径ID) {
            结果<整64, 整32> 查g = 模块成员键基们.获取(模块成员键(m, 名ID));
            如果 (查g.正常) {
                结果<整64, 整32> 查公 = 模块成员公开们.获取(模块成员键(m, 名ID));
                如果 (查公.正常) {
                    整64 桶键基 = 查g.值;   // 正向分支内提取（宿主 结果 流敏感检查惯例）
                    整64 查数 = 查函数签名个数(桶键基);
                    如果 (查数 >= 0) {
                        整64 k = 0;
                        当 (k < 查数) {
                            整64 查串 = 查函数签名参数串(桶键基 * 键位移 + k);
                            如果 (查串 >= 0) {
                                字符串 参数串文本 = 字符串复制(驻留文本(查串));
                                整64 参数个数 = 0;
                                如果 (字符串长度(参数串文本) > 0) {
                                    参数个数 = 1;
                                    整64 ci = 0;
                                    当 (ci < 字符串长度(参数串文本)) {
                                        整64 cb = 整64(参数串文本[ci]) & 255;
                                        如果 (cb == 44) { 参数个数++; }
                                        ci++;
                                    }
                                }
                                如果 (参数个数 == 实参数) {
                                    匹配数++;
                                    如果 (匹配数 == 1) { 选中 = 桶键基; }
                                }
                            }
                            k++;
                        }
                    }
                }
            }
        }
        g++;
    }
    如果 (匹配数 == 1) { 返回 选中; }
    返回 0 - 1;
}

// 清空模块解析表（语义分析/语义分析多文件 入口——任务级生命周期惯例）
不安全 函数 清空模块解析表() -> 空类型 {
    模块成员键基们.清空();
    模块成员公开们.清空();
    文件导入键基们.清空();
    已加载模块ID们 = 向量<整64>();
    三级键基缓存们.清空();
    语义诊断缓冲 = 向量<字符串>();
    当前模块路径ID = 0;
}

// 登记调用点决议键基（语义驱动 IR——plans/018 第 4 层）：三级决议命中且该
//   键基下有签名候选（=用户函数，非类型转换/构造/内置）时，把键基写入
//   调用决议键基们（IR容器 静态表，键=调用节点池索引）。IR 层 决议函数符号
//   据此锁定候选模块桶后重载决议——IR 不重复名称解析、无反向依赖。
函数 登记调用决议(向量<映射<整64, 符号>> 符号表, 整64 名ID, 整64 调用节点索引) -> 空类型 {
    整64 键基r = 三级键基查找(符号表, 名ID, 0 - 1);
    如果 (键基r < 0) { 返回; }
    整64 查数r = 查函数签名个数(键基r);
    如果 (查数r >= 0) {
        如果 (查数r > 0) {
            调用决议登记(调用节点索引, 键基r);
        }
    }
}

// 全局层直查类型ID（签名键/键基等复合键专用——不经三级解析；签名键含 '#'
//   非纯名，三级成员索引按纯名登记，直查全局层才是其正确消费形态）
函数 全局层查类型(向量<映射<整64, 符号>> 符号表, 整64 键) -> 整64 {
    如果 (符号表.大小() == 0) { 返回 -1; }
    映射<整64, 符号> 全局层 = 符号表.元素(0);
    结果<符号, 整32> 查 = 全局层.获取(键);
    如果 (查.正常) {
        符号 找到s = 查.值;   // 逐步提取（链式成员 查.值.类型ID 踩 v2 成员链
        返回 找到s.类型ID;    //   字段偏移半实现边界——[ir2] 拒发，非链式惯例）
    }
    返回 -1;
}

// ③ 第三波（2026-09-03）：指针变量表——名ID -> 所指元素类型名ID。参数/局部
//   声明时按类型节点 附加=指针层数 1..255 登记（与 引用>=256 互斥）；下标
//   白名单与左值放行判定用。检查函数 开头清空（函数级生命周期——跨函数
//   同名不串；块级遮蔽同 变量结构体表 约定的既有边界）。顶层静态无初始化
//   ——宿主 P3-8 指针槽模型入口自动构造。
静态 映射<整64, 整64> 指针变量表;

// ③ 第三波：指针下标所指类型白名单（IR 指针加载宽度分支覆盖面）：整系/正系/
//   布尔/字符/字符串；浮点（v2 指针加载无浮点分支）/结构体/容器/结果（元素
//   语义须返回地址而非加载值）显式拒绝——半实现纪律：未覆盖形态不放行。
函数 指针下标所指合法(字符串 名) -> 布尔 {
    返回 字符串比较(名, "整8") || 字符串比较(名, "整16") ||
           字符串比较(名, "整32") || 字符串比较(名, "整64") ||
           字符串比较(名, "正8") || 字符串比较(名, "正16") ||
           字符串比较(名, "正32") || 字符串比较(名, "正64") ||
           字符串比较(名, "布尔") || 字符串比较(名, "字符") ||
           字符串比较(名, "字符串");
}

// 引用返回调用判定（2026-09-04 缺陷零容忍收口，宿主 P3-18 对齐）：调用节点
//   的被调为标识符且符号表返回类型名尾 '&'（-> 整64&）——该调用结果=被引用
//   左值地址，可作赋值目标/复合赋值/引用初始化绑定。
函数 是引用返回调用(向量<节点> 池, 整32 调用节点索引, 向量<映射<整64, 符号>> 符号表) -> 布尔 {
    节点 调用节点 = 池.元素(调用节点索引);
    如果 (调用节点.类型 != 节点_调用 || 调用节点.子起点 <= 0) { 返回 假; }
    节点 被调r = 池.元素(整32(调用节点.子起点));
    如果 (被调r.类型 != 节点_标识符) { 返回 假; }
    整64 返回类型IDr = 表查找类型ID(符号表, 整64(被调r.文本));
    如果 (返回类型IDr == -1) { 返回 假; }
    字符串 返回名r = 字符串复制(驻留文本(返回类型IDr));
    如果 (字符串长度(返回名r) == 0) { 返回 假; }
    返回 字符串比较(字符串子串(返回名r, 字符串长度(返回名r) - 1, 1), "&");
}

// 压入作用域：追加一个空映射（追加 深拷贝独立——H8-5 容器持有类对象）
函数 表压入(向量<映射<整64, 符号>> 符号表) -> 空类型 {
    映射<整64, 符号> 层 = 映射<整64, 符号>();
    结果<空类型, 整32> 加 = 符号表.追加(层);
    如果 (!加.正常) { 运行时错误(4); }
}

// 弹出作用域：删除 自动销毁顶层映射元素（Feature 2 完整版——向量 删除 对
//   有析构类元素自动调用析构 ~映射 释放内部数组；真删除无残留遮蔽）
函数 表弹出(向量<映射<整64, 符号>> 符号表) -> 空类型 {
    如果 (符号表.大小() == 0) { 返回; }
    结果<空类型, 整32> 删 = 符号表.删除(符号表.大小() - 1);
    如果 (!删.正常) { 运行时错误(4); }
}

// 注册符号：同作用域重名 -> 0；否则设置（O(1) 哈希）
函数 表注册(向量<映射<整64, 符号>> 符号表, 整64 名ID, 整64 类型ID, 整64 种类, 整64 附加) -> 整64 {
    如果 (符号表.大小() == 0) { 返回 0; }
    映射<整64, 符号> 顶层 = 符号表.元素(符号表.大小() - 1);
    结果<符号, 整32> 已有 = 顶层.获取(名ID);
    如果 (已有.正常) { 返回 0; }
    符号 s;
    s.名ID = 名ID;
    s.类型ID = 类型ID;
    s.种类 = 种类;
    s.附加 = 附加;
    s.已转移 = 0;   // plans/019 阶段1：新声明=新变量（遮蔽语义天然正确）
    结果<空类型, 整32> 加 = 顶层.设置(名ID, s);
    如果 (!加.正常) { 返回 0; }
    返回 1;
}

// ==================== plans/019 阶段1（2026-09-10）：显式转移 已转移标记 ====================
// 标记源变量已转移（与 表查找 同序：从栈顶向下找到名ID 所在局部层——内层
//   同名新声明在新层，外层标记不污染内层=遮蔽语义正确；全局层键为键基非名ID，
//   全局变量转移第一版不支持（局部转移为主场景））。返回 1=标记成功 0=未找到。
函数 表标记转移(向量<映射<整64, 符号>> 符号表, 整64 名ID, 整64 行) -> 整64 {
    整64 i = 符号表.大小();
    当 (i > 1) {
        i--;
        映射<整64, 符号> 层 = 符号表.元素(i);
        结果<符号, 整32> 查 = 层.获取(名ID);
        如果 (查.正常) {
            符号 找到 = 查.值;
            找到.已转移 = 行;
            结果<空类型, 整32> 写 = 层.设置(名ID, 找到);
            如果 (!写.正常) { 返回 0; }
            返回 1;
        }
    }
    返回 0;
}

// plans/019 阶段2（2026-09-10）：名字是否绑定在函数局部层（符号表索引 >=1
//   =函数参数层/块层；[0]=全局层）——逃逸检查的「局部」判定（参数随栈帧
//   消亡亦属局部）。
函数 是局部名(向量<映射<整64, 符号>> 符号表, 整64 名ID) -> 布尔 {
    整64 i = 符号表.大小();
    当 (i > 1) {
        i--;
        映射<整64, 符号> 层 = 符号表.元素(i);
        结果<符号, 整32> 查 = 层.获取(名ID);
        如果 (查.正常) { 返回 真; }
    }
    如果 (i == 1) {
        映射<整64, 符号> 层1 = 符号表.元素(1);
        结果<符号, 整32> 查1 = 层1.获取(名ID);
        如果 (查1.正常) { 返回 真; }
    }
    返回 假;
}

// 名字在作用域链解析处是否已转移（与 表查找类型ID 同序）；返回转移行号，
//   0=未转移（已转移登记行号恒 >0）。
函数 表查已转移(向量<映射<整64, 符号>> 符号表, 整64 名ID) -> 整64 {
    整64 i = 符号表.大小();
    当 (i > 1) {
        i--;
        映射<整64, 符号> 层 = 符号表.元素(i);
        结果<符号, 整32> 查 = 层.获取(名ID);
        如果 (查.正常) {
            符号 找到 = 查.值;
            返回 找到.已转移;
        }
    }
    返回 0;
}

// plans/019 阶段1：转移实参类型分级（与宿主 transferArgKind 对齐）——
//   1=标量（复制语义拒绝）；0=指针/字符串（任意表达式位放行）；2=拥有资源
//   类型（容器/类/结构体/结果/可选——仅声明初始化位，表达式位拒绝随阶段3）。
//   名ID 参与：指针变量的符号类型ID=基类型名（「整64* q」登记 整64），标量名
//   误判由 语义指针变量表（名ID 登记）先行排除。
函数 转移实参分级(整64 类型ID, 整64 名ID) -> 整64 {
    如果 (查语义指针变量(名ID) != -1) { 返回 0; }
    字符串 类型文本 = 字符串复制(驻留文本(类型ID));
    如果 (字符串比较(类型文本, "整8") || 字符串比较(类型文本, "整16") ||
         字符串比较(类型文本, "整32") || 字符串比较(类型文本, "整64") ||
         字符串比较(类型文本, "整128") || 字符串比较(类型文本, "正8") ||
         字符串比较(类型文本, "正16") || 字符串比较(类型文本, "正32") ||
         字符串比较(类型文本, "正64") || 字符串比较(类型文本, "正128") ||
         字符串比较(类型文本, "浮32") || 字符串比较(类型文本, "浮64") ||
         字符串比较(类型文本, "布尔") || 字符串比较(类型文本, "字符")) {
        返回 1;
    }
    如果 (字符串比较(类型文本, "字符串")) { 返回 0; }
    // 指针：语义指针变量表登记形态（类型节点附加=层数，符号类型ID=基名）——
    //   基名非标量非字符串即按指针处置（指针/拥有类型由调用位分级）
    返回 2;
}

// 查找符号：从栈顶向下（内层遮蔽外层）；返回类型ID（-1=未找到）
// plans/018 第 3 层：全局层（栈底 i==0）查询升级三级解析——① 本模块 ② 显式
//   导入 ③ 通配（歧义 E0659 在 三级键基查找 内经诊断缓冲报告）；局部层（i>0）
//   纯名键路径不变（性能与行为零差）。主模块键基=纯名——单文件行为逐字节不变。
函数 表查找类型ID(向量<映射<整64, 符号>> 符号表, 整64 名ID) -> 整64 {
    整64 i = 符号表.大小();
    当 (i > 1) {
        i--;
        映射<整64, 符号> 层 = 符号表.元素(i);
        结果<符号, 整32> 查 = 层.获取(名ID);
        如果 (查.正常) {
            符号 找到 = 查.值;
            返回 找到.类型ID;
        }
    }
    如果 (i == 1) {
        整64 键基t = 三级键基查找(符号表, 名ID, 0 - 1);
        如果 (键基t >= 0) {
            映射<整64, 符号> 全局层 = 符号表.元素(0);
            结果<符号, 整32> 查键 = 全局层.获取(键基t);
            如果 (查键.正常) {
                符号 找到键 = 查键.值;
                返回 找到键.类型ID;
            }
        }
    }
    返回 -1;
}

// 查找符号种类：从栈顶向下（内层遮蔽外层）；返回 种类（-1=未找到）
// 缺陷②（2026-09-03 用户裁决立案）：赋值/自增目标常量判定用——局部变量遮蔽
//   外层常量按内层解析（种类=变量，放行），与 表查找类型ID 同走查序保证一致。
// plans/018 第 3 层：全局层同升三级解析（顶层常量分桶后经 ①②③ 决议）。
函数 表查找种类(向量<映射<整64, 符号>> 符号表, 整64 名ID) -> 整64 {
    整64 i = 符号表.大小();
    当 (i > 1) {
        i--;
        映射<整64, 符号> 层 = 符号表.元素(i);
        结果<符号, 整32> 查 = 层.获取(名ID);
        如果 (查.正常) {
            符号 找到 = 查.值;
            返回 找到.种类;
        }
    }
    如果 (i == 1) {
        整64 键基z = 三级键基查找(符号表, 名ID, 0 - 1);
        如果 (键基z >= 0) {
            映射<整64, 符号> 全局层 = 符号表.元素(0);
            结果<符号, 整32> 查键 = 全局层.获取(键基z);
            如果 (查键.正常) {
                符号 找到键 = 查键.值;
                返回 找到键.种类;
            }
        }
    }
    返回 -1;
}

// ==================== 类型引用三级解析与诊断（plans/018 类型/常量分桶，2026-09-08） ====================
// 宿主 A-2 类型 crate 分桶 + E0659 对齐：变量/参数/返回类型的结构体类型引用
//   三级解析（① 本模块 ＞ ② 显式导入 ＞ ③ 合并全局公开候选），存在性/私有/
//   歧义 fail fast 诊断——此前类型引用零检查（未声明结构体静默 8 字节兜底，
//   跨模块同名布局串桶静默错位，探针实测 sret ABI 级错乱）。
// 与 三级键基查找 的差异：③ 段不做函数签名表过滤（类型键基不在签名表——
//   结构体/常量/函数成员统一候选）；①② 段同构（成员索引/文件导入表 符号维度通用）。
函数 是基础类型文本(字符串 名) -> 布尔 {
    返回 字符串比较(名, "整8") || 字符串比较(名, "整16") ||
          字符串比较(名, "整32") || 字符串比较(名, "整64") ||
          字符串比较(名, "整128") || 字符串比较(名, "正8") ||
          字符串比较(名, "正16") || 字符串比较(名, "正32") ||
          字符串比较(名, "正64") || 字符串比较(名, "布尔") ||
          字符串比较(名, "字符") || 字符串比较(名, "字符串") ||
          字符串比较(名, "浮32") || 字符串比较(名, "浮64") ||
          字符串比较(名, "空类型") || 字符串比较(名, "指针");
}

// 类型键基三级查找：返回 键基ID / -1 未命中 / -2 歧义（宿主 E0659 同款三维度）
函数 类型键基查找(整64 名ID) -> 整64 {
    结果<整64, 整32> 查一 = 模块成员键基们.获取(模块成员键(当前模块路径ID, 名ID));
    如果 (查一.正常) { 返回 查一.值; }
    结果<整64, 整32> 查二 = 文件导入键基们.获取(名ID);
    如果 (查二.正常) { 返回 查二.值; }
    整64 候选键基t = -1;
    整64 候选数t = 0;
    整64 g = 0;
    当 (g < 已加载模块ID们.大小()) {
        整64 m = 已加载模块ID们.元素(g);
        如果 (m != 当前模块路径ID) {
            结果<整64, 整32> 查g = 模块成员键基们.获取(模块成员键(m, 名ID));
            如果 (查g.正常) {
                整64 键基g = 查g.值;   // 正向分支内提取（宿主 结果 流敏感惯例）
                结果<整64, 整32> 查公开g = 模块成员公开们.获取(模块成员键(m, 名ID));
                整64 公开g = 0;
                如果 (查公开g.正常) { 公开g = 查公开g.值; }
                如果 (公开g == 1) {
                    如果 (候选数t == 0) { 候选键基t = 键基g; }
                    候选数t = 候选数t + 1;
                }
            }
        }
        g++;
    }
    如果 (候选数t > 1) { 返回 0 - 2; }
    返回 候选键基t;
}

// 检查一个类型引用（类型文本ID）：内置/容器合成名（含 '$'）放行；限定文本
//   拆分直查成员索引；纯名三级。诊断：未声明的类型 / 类型是私有的 /
//   在多个模块中定义（宿主同款消息形态）。
函数 检查类型引用(向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断, 整64 类型文本ID) -> 空类型 {
    // 414-a（D42 甲案波 1）：泛型类类型参数名放行（T/K/V...）——驻留ID 直比
    //   （声明登记表 泛型参数名们·零字符串操作）。单态化实例绑定=波2；越界
    //   放行边界（类外同名标识符作类型名不诊断）=波1 诚实边界（收工回填）。
    如果 (是泛型参数名(类型文本ID)) { 返回; }
    字符串 文本x = 字符串复制(驻留文本(类型文本ID));
    整64 长x = 字符串长度(文本x);
    如果 (长x == 0) { 返回; }
    // 引用/指针后缀剥离（E2E 150 误报根治）：裸类型引用/泛型实参位消费 '&'
    //   并入合成名（"整64&"）——剥尾部 '&'/'*' 后再判（指针层语义在节点附加，
    //   文本后缀仅合成名实参位形态；剥空=纯后缀异常形态放行）
    当 (长x > 0) {
        字符串 尾 = 字符串子串(文本x, 整32(长x - 1), 1);
        如果 (字符串比较(尾, "&") || 字符串比较(尾, "*")) {
            文本x = 字符串子串(文本x, 0, 整32(长x - 1));
            长x = 长x - 1;
        } 否则 {
            中断;
        }
    }
    如果 (长x == 0) { 返回; }
    如果 (是基础类型文本(文本x)) { 返回; }
    // 94-a：数组类型（"整32[5]"）——剥 [长度] 后缀取元素类型递归检查
    //   （元素存在性/公开性/歧义照常诊断；长度已在语法层限定纯数字形态）
    如果 (是数组类型文本(文本x)) {
        字符串 元素x94 = 数组元素文本(文本x);
        如果 (字符串长度(元素x94) > 0) {
            检查类型引用(符号表, 诊断, 驻留(元素x94));
        }
        返回;
    }
    // 容器/结果 $ 合成名（向量$整64）泛型实参已扁平化，非用户结构体引用
    整64 含合成符 = 0;
    整64 ci = 0;
    当 (ci < 长x) {
        如果 (字符串比较(字符串子串(文本x, 整32(ci), 1), "$")) { 含合成符 = 1; }
        ci++;
    }
    如果 (含合成符 == 1) { 返回; }
    字符串 模块x = "";
    字符串 符号x = "";
    如果 (拆限定名(文本x, 模块x, 符号x) == 1) {
        如果 (是标准库模块名(模块x)) { 返回; }
        整64 来源模块x = 驻留(模块x);
        整64 符号名x = 驻留(符号x);
        结果<整64, 整32> 查成员x = 模块成员键基们.获取(模块成员键(来源模块x, 符号名x));
        如果 (!查成员x.正常) {
            表诊断(诊断, "[错误] 未声明的类型: " + 文本x);
            返回;
        }
        结果<整64, 整32> 查公开x = 模块成员公开们.获取(模块成员键(来源模块x, 符号名x));
        整64 公开x = 0;
        如果 (查公开x.正常) { 公开x = 查公开x.值; }
        如果 (公开x == 0 && 来源模块x != 当前模块路径ID) {
            表诊断(诊断, "[错误] 类型 '" + 符号x + "' 是私有的（模块 " + 模块x + "）");
        }
        返回;
    }
    整64 键基t = 类型键基查找(类型文本ID);
    如果 (键基t == 0 - 2) {
        表诊断(诊断, "[错误] 类型 '" + 文本x + "' 在多个模块中定义（调用存在歧义）");
        返回;
    }
    如果 (键基t < 0) {
        表诊断(诊断, "[错误] 未声明的类型: " + 文本x);
        返回;
    }
    // 命中：校验符号种类确为结构体（防类型位误引用函数/常量名）
    如果 (符号表.大小() > 0) {
        映射<整64, 符号> 全局层t = 符号表.元素(0);
        结果<符号, 整32> 查符号t = 全局层t.获取(键基t);
        如果 (查符号t.正常) {
            符号 找到t = 查符号t.值;
            如果 (找到t.种类 != 符号_结构体) {
                表诊断(诊断, "[错误] 未声明的类型: " + 文本x);
            }
        } 否则 {
            表诊断(诊断, "[错误] 未声明的类型: " + 文本x);
        }
    }
}

// ==================== 文件导入上下文构建（plans/018 第 3 层） ====================
// 每文件检查/生成前调用：设 当前模块路径ID、构建 ② 显式导入目标表（键基）、
//   ③ glob 模块路径列表；E0255 同款冲突检查（①×② 本地定义与显式导入同名、
//   ②×② 多次显式导入同名——宿主 checkImportLocalConflicts 语义对齐：
//   同源重复导入幂等合法、自导入豁免、私有符号导入拒绝）。轻量=真：跳过
//   E0255 与私有诊断（IR 生成阶段复用——诊断仅语义阶段一份）。
不安全 函数 构建文件导入上下文(字符串 模块路径, 向量<整64> 导入项平铺, 向量<整64> 全部模块ID们,
                        向量<字符串> 诊断, 布尔 轻量) -> 空类型 {
    当前模块路径ID = 驻留(模块路径);
    文件导入键基们.清空();
    已加载模块ID们 = 向量<整64>();
    三级键基缓存们.清空();
    // ---- ② 显式导入解析（平铺 = 交替 [绑定名ID, 限定名ID, ...]）----
    整64 p = 0;
    当 (p + 1 < 导入项平铺.大小()) {
        整64 绑定名 = 导入项平铺.元素(p);
        整64 限定名ID = 导入项平铺.元素(p + 1);
        p += 2;
        字符串 模块路径s = "";
        字符串 符号名s = "";
        如果 (拆限定名(驻留文本(限定名ID), 模块路径s, 符号名s) == 0) {
            // 单段（无 ::）= 模块整体导入形态（③ 层，语法层不进 导入项们）——
            //   防御：不构成绑定
            继续;
        }
        // 自导入豁免（宿主 B 裁决：来源首段 == 归属模块——不引入新绑定名，
        //   本地定义恒 ① 优先，仅启用限定自引用）
        如果 (字符串比较(模块路径s, 模块路径)) { 继续; }
        // stdlib 来源：符号不在 v2 加载树——B1 已改写限定名走内置表，不登记
        //   （键基 miss → 三级 miss → 内置兜底，行为不变）
        如果 (是标准库模块名(模块路径s)) { 继续; }
        整64 来源模块ID = 驻留(模块路径s);
        整64 符号名ID = 驻留(符号名s);
        // 可见性 + 存在性（宿主 3.6：跨模块引用只认公开成员；fail fast——
        //   导入不存在的符号=编译错误，绝不静默空绑定）。
        //   结果 流敏感检查惯例：正向分支内提取 .值 到局部变量
        整64 成员键基b = 0;
        结果<整64, 整32> 查成员 = 模块成员键基们.获取(模块成员键(来源模块ID, 符号名ID));
        如果 (查成员.正常) {
            成员键基b = 查成员.值;
        } 否则 {
            如果 (!轻量) {
                表诊断(诊断, "[错误] 导入的符号不存在: " + 模块路径s + "::" + 符号名s);
            }
            继续;
        }
        结果<整64, 整32> 查公开 = 模块成员公开们.获取(模块成员键(来源模块ID, 符号名ID));
        如果 (!查公开.正常) {
            如果 (!轻量) {
                表诊断(诊断, "[错误] 符号 '" + 符号名s + "' 为模块 '" + 模块路径s +
                              "' 私有（未以 公开: 标注），不可导入（规格08 5.9.3）");
            }
            继续;
        }
        // ①×②：与本地定义同名 = 编译错误（宿主 E0255 对齐——按纯名维度，
        //   不分种类；签名不同的重载族同名同判）
        结果<整64, 整32> 查本地 = 模块成员键基们.获取(模块成员键(当前模块路径ID, 绑定名));
        如果 (查本地.正常) {
            如果 (!轻量) {
                表诊断(诊断, "[错误] 导入与本地定义同名: " + 驻留文本(绑定名) +
                              "（导入自 " + 模块路径s + "——E0255，改名或删其一）");
            }
            继续;
        }
        // ②×②：不同来源的同名显式导入 = 编译错误；同源重复导入幂等合法
        结果<整64, 整32> 查已绑 = 文件导入键基们.获取(绑定名);
        如果 (查已绑.正常) {
            整64 已绑键基 = 查已绑.值;
            如果 (已绑键基 != 成员键基b && !轻量) {
                表诊断(诊断, "[错误] 多次显式导入同名: " + 驻留文本(绑定名) +
                              "（规格08-三 名称解析）");
            }
            继续;
        }
        结果<空类型, 整32> 设绑定 = 文件导入键基们.设置(绑定名, 成员键基b);
        如果 (!设绑定.正常) { 运行时错误(4); }
    }
    // ---- ③ 合并全局可见：全部已加载模块 ID 登记（stdlib 不在成员索引天然
    //    miss；歧义在三级决议使用点判定）----
    已加载模块ID们 = 全部模块ID们;
}

// 诊断记录
// 103-a（D2）：当前诊断行（语句根回填的行；0=未知→输出不带行号=存量兼容）
静态 整32 当前诊断行103 = 0;

不安全 函数 设当前诊断行(整32 行) -> 空类型 {
    当前诊断行103 = 行;
}

函数 取当前诊断行() -> 整32 {
    返回 当前诊断行103;
}

函数 表诊断(向量<字符串> 诊断, 字符串 消息) -> 空类型 {
    // 103-a（D2）：诊断输出追加「（行=N）」（行>0 时；对齐语法层 打印到错误
    //   的（行=）后缀格式）。行=0=未知→原样输出（存量兼容）。
    如果 (当前诊断行103 > 0) {
        结果<空类型, 整32> 加行 = 诊断.追加(
            消息 + "（行=" + 整数转字符串(整64(当前诊断行103)) + "）");
        如果 (!加行.正常) { 运行时错误(4); }
        返回;
    }
    结果<空类型, 整32> 加 = 诊断.追加(消息);
    如果 (!加.正常) { 运行时错误(4); }
}
// ==================== 声明收集（第一趟：函数/结构体签名） ====================
// 呈报③方案A（2026-09-06）：函数登记键=签名键 名#参数串（宿主 signatureKey
//   对齐）——同名不同参数串=重载共存（多键）；同名同参数串=重定义诊断
//   （原纯名键注册失败被静默吞：`如果 (忽略 == 0) { }`——静默覆盖家族）。
//   同步登记函数签名表（语义层未声明检查回退用；IR生成入口清空重收集=权威）。
//   双键补登记（2026-09-06 用户裁决方案A）：纯名键同名唯一时补——既有纯名
//   查函数消费点（是引用返回调用 等）零回归（E2E 150 解锁暴露回归根因）。
// ==================== plans/019 阶段3b 残余（2026-09-10 第六十五轮） ====================
// 函数参数借用位表：签名键*键位移+参数序 -> 1=引用形参（类型节点附加>=256）/
//   常量引用形参（附加==257）——声明收集 登记，检查调用表达式 借用纪律消费。
静态 映射<整64, 整64> 函数参数引用位们;
静态 映射<整64, 整64> 函数参数常量位们;

函数 查函数参数引用位(整64 签名键, 整64 参数序) -> 整64 {
    结果<整64, 整32> 查 = 函数参数引用位们.获取(签名键 * 键位移 + 参数序);
    如果 (查.正常) { 返回 查.值; }
    返回 0;
}

函数 查函数参数常量位(整64 签名键, 整64 参数序) -> 整64 {
    结果<整64, 整32> 查 = 函数参数常量位们.获取(签名键 * 键位移 + 参数序);
    如果 (查.正常) { 返回 查.值; }
    返回 0;
}

函数 声明收集(向量<节点> 池, 整32 程序节点, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断,
              字符串 模块路径, 映射<整64, 整64>& 公开表) -> 空类型 {
    整64 本模块ID = 驻留(模块路径);
    节点 程序 = 池.元素(程序节点);
    整64 i = 整64(程序.子起点);
    当 (i < 整64(程序.子终点)) {
        节点 声明 = 池.元素(整32(i));
        // 可见性（plans/018 第 3 层：公开: 标签块——语法层 顶层公开们 快照；
        //   缺省私有。符号.附加=1 公开——跨模块 ②②③ 解析只认公开成员）
        整64 是否公开 = 0;
        结果<整64, 整32> 查公开 = 公开表.获取(整64(i));
        如果 (查公开.正常) { 是否公开 = 1; }
        // 192-a：本函数 171 行按「声明类型」提取为 5 个收集族子方法（纯搬运
        //   零行为变更——多重集核验先行于构建）。
        如果 (声明.类型 == 节点_函数) {
            收集函数声明(池, 整32(i), 符号表, 诊断, 模块路径, 本模块ID, 是否公开);
        }
        如果 (声明.类型 == 节点_结构体) {
            收集结构体声明(池, 整32(i), 符号表, 诊断, 模块路径, 本模块ID, 是否公开);
        }
        如果 (声明.类型 == 节点_类) {
            收集类声明(池, 整32(i), 符号表, 诊断, 模块路径, 本模块ID, 是否公开);
        }
        如果 (声明.类型 == 节点_常量声明) {
            收集常量声明(池, 整32(i), 符号表, 诊断, 模块路径, 本模块ID, 是否公开);
        }
        如果 (声明.类型 == 节点_静态声明) {
            收集静态声明(池, 整32(i), 符号表, 诊断, 模块路径, 本模块ID, 是否公开);
        }
        i++;
    }
}


// ==================== 192-a 收集族子方法（原 声明收集 707~862 段） ====================

函数 收集函数声明(向量<节点> 池, 整32 声明索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断,
              字符串 模块路径, 整64 本模块ID, 整64 是否公开) -> 空类型 {
    节点 声明 = 池.元素(声明索引);
// 族①：函数声明收集（原 707~768 段）——参数串/链接键/签名键/参数借用位
//   （引用位/常量位）/重定义诊断/模块成员索引/公开标记/主模块双键登记。
            字符串 参数串 = 函数参数串(池, 整32(声明索引));
            // plans/018 第 3/4 层：登记键升级为链接键（键基#参数串）——键基=
            //   主模块纯名（行为不变）/其余 模块$名（跨模块同名合法共存）
            整64 键基i = 键基合成(模块路径, 整64(声明.文本));
            登记函数签名K(池, 整32(声明索引), 键基i);
            整64 签名键 = 函数签名键(键基i, 参数串);
            整64 忽略 = 表注册(符号表, 签名键, 整64(声明.附加), 符号_函数, 是否公开);
            // plans/019 阶段3b：参数借用位登记（引用位/常量位——类型节点附加
            //   >=256=引用、==257=常量引用；无类型节点参数跳过）
            整64 参数序 = 0;
            整64 参数游标 = 整64(声明.子起点);
            当 (参数游标 < 整64(声明.子终点)) {
                节点 参数节点p = 池.元素(整32(参数游标));
                如果 (参数节点p.类型 == 节点_参数) {
                    如果 (参数节点p.附加 >= 0 && 参数节点p.附加 < 整64(池.大小())) {
                        节点 参数类型节点p = 池.元素(整32(参数节点p.附加));
                        如果 (参数类型节点p.类型 == 节点_类型) {
                            如果 (参数类型节点p.附加 >= 256) {
                                结果<空类型, 整32> 设引用位 = 函数参数引用位们.设置(
                                    签名键 * 键位移 + 参数序, 1);
                                如果 (!设引用位.正常) { 运行时错误(4); }
                            }
                            如果 (参数类型节点p.附加 == 257) {
                                结果<空类型, 整32> 设常量位 = 函数参数常量位们.设置(
                                    签名键 * 键位移 + 参数序, 1);
                                如果 (!设常量位.正常) { 运行时错误(4); }
                            }
                        }
                    }
                    参数序++;
                }
                参数游标++;
            }
            如果 (忽略 == 0) {
                // 同模块同签名重复=重定义（跨模块同名键不同——不再误报）
                表诊断(诊断, "[错误] 函数重定义: " + 模块路径 + "::" +
                              驻留文本(整64(声明.文本)) + "(" + 参数串 + ")");
            }
            // 模块成员索引（三级解析 ①③ 数据源；纯名维度——重载族共享条目，
            //   值=首登记键基）
            结果<空类型, 整32> 设成员 = 模块成员键基们.设置(
                模块成员键(本模块ID, 整64(声明.文本)), 键基i);
            如果 (!设成员.正常) { 运行时错误(4); }
            如果 (是否公开 == 1) {
                结果<空类型, 整32> 设公开 = 模块成员公开们.设置(
                    模块成员键(本模块ID, 整64(声明.文本)), 1);
                如果 (!设公开.正常) { 运行时错误(4); }
            }
            // 双键登记（2026-09-06 缺陷零容忍）：纯名键——仅主模块（键基=纯名，
            //   行为不变）。非主模块纯名查找经三级解析（①成员索引）覆盖，不再
            //   平铺（平铺=跨模块同名遮蔽/先收集赢 的旧静默语义，已废止）。
            如果 (是主模块路径(模块路径)) {
                整64 查纯名候选 = 查函数签名个数(键基i);
                如果 (查纯名候选 >= 0) {
                    如果 (查纯名候选 == 1) {
                        整64 纯名忽略 = 表注册(符号表, 键基i, 整64(声明.附加), 符号_函数, 是否公开);
                        如果 (纯名忽略 == 0) { }
                    }
                }
            }
        }

函数 收集结构体声明(向量<节点> 池, 整32 声明索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断,
              字符串 模块路径, 整64 本模块ID, 整64 是否公开) -> 空类型 {
    节点 声明 = 池.元素(声明索引);
// 族②：结构体声明收集（原 770~804 段）——含 164-a A4 联合体成员类型限定
//   （「手动释放」标注豁免，对标 Rust union 成员须 Copy）。
            整64 键基s = 键基合成(模块路径, 整64(声明.文本));
            整64 忽略2 = 表注册(符号表, 键基s, 0, 符号_结构体, 是否公开);
            如果 (忽略2 == 0) { }
            // 164-a（A4 方案A·plans/023 §十二）：联合体成员类型限定（宿主
            //   isTriviallyCopyable 同构）——成员须可平凡复制；「手动释放」标注
            //   成员豁免（方案D 逃生舱，对标 Rust ManuallyDrop<T>）
            如果 (是联合体键基(键基s)) {
                整64 游标u = 整64(声明.子起点);
                当 (游标u < 整64(声明.子终点)) {
                    节点 成员u = 池.元素(整32(游标u));
                    如果 (成员u.类型 == 节点_参数) {
                        字符串 成员类型u = 字符串复制(
                            驻留文本(整64(池.元素(整32(成员u.附加)).文本)));
                        整64 分桶键u = 键基s * 键位移 + 整64(成员u.文本);
                        如果 (!是手动释放成员(分桶键u) && !可平凡复制v2(成员类型u)) {
                            表诊断(诊断, "[A4] 联合体 '" +
                                         字符串复制(驻留文本(整64(声明.文本))) +
                                          "' 成员 '" +
                                         字符串复制(驻留文本(整64(成员u.文本))) +
                                          "' 的类型 '" + 成员类型u +
                                          "' 为拥有型——联合体成员须可平凡复制（对标 Rust union 成员须 Copy）；如需手动管理请标注「手动释放」（责任移交 不安全 函数 内显式释放）");
                        }
                    }
                    游标u++;
                }
            }
            结果<空类型, 整32> 设成员s = 模块成员键基们.设置(
                模块成员键(本模块ID, 整64(声明.文本)), 键基s);
            如果 (!设成员s.正常) { 运行时错误(4); }
            如果 (是否公开 == 1) {
                结果<空类型, 整32> 设公开s = 模块成员公开们.设置(
                    模块成员键(本模块ID, 整64(声明.文本)), 1);
                如果 (!设公开s.正常) { 运行时错误(4); }
            }
        }

函数 收集类声明(向量<节点> 池, 整32 声明索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断,
              字符串 模块路径, 整64 本模块ID, 整64 是否公开) -> 空类型 {
    节点 声明 = 池.元素(声明索引);
// 族③：类声明收集（原 806~821 段）——用户类登记（类型符号=符号_结构体，
//   全链复用结构体设施）+方法签名入 IR类 类表。
            // 第七十八轮（2026-09-12）：用户类登记——类型符号=符号_结构体
            //   （类型引用检查/变量结构体登记/字段访问全链复用结构体设施）；
            //   方法签名入 IR类 类表（构造/析构/普通方法分派）
            整64 键基cls = 键基合成(模块路径, 整64(声明.文本));
            整64 忽略cls = 表注册(符号表, 键基cls, 0, 符号_结构体, 是否公开);
            如果 (忽略cls == 0) { }
            结果<空类型, 整32> 设成员cls = 模块成员键基们.设置(
                模块成员键(本模块ID, 整64(声明.文本)), 键基cls);
            如果 (!设成员cls.正常) { 运行时错误(4); }
            如果 (是否公开 == 1) {
                结果<空类型, 整32> 设公开cls = 模块成员公开们.设置(
                    模块成员键(本模块ID, 整64(声明.文本)), 1);
                如果 (!设公开cls.正常) { 运行时错误(4); }
            }
            收集类方法(池, 整32(声明索引));
            // 340-a（347）：类节点索引登记（.设置 惯例=静态方法调用·329-a 同款）
            结果<空类型, 整32> 设节点索引 = 类节点索引表.设置(整64(声明.文本), 整64(声明索引));
            如果 (!设节点索引.正常) { 运行时错误(4); }
        }

函数 收集常量声明(向量<节点> 池, 整32 声明索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断,
              字符串 模块路径, 整64 本模块ID, 整64 是否公开) -> 空类型 {
    节点 声明 = 池.元素(声明索引);
// 族④：常量声明收集（原 823~837 段）——P7a 顶层常量登记（类型ID 记 整64
//   名ID；分桶后跨模块常量引用经三级解析）。
            // P7a：顶层常量登记（类型ID 记 整64 名ID——v2 整数字面量统一按 整64）；
            //   多文件两趟结构下第一趟全文件收集——分桶后跨模块常量引用经
            //   三级解析（②③ 须公开；① 同模块直查）
            整64 键基c = 键基合成(模块路径, 整64(声明.文本));
            整64 忽略3 = 表注册(符号表, 键基c, 驻留("整64"), 符号_常量, 是否公开);
            如果 (忽略3 == 0) { }
            结果<空类型, 整32> 设成员c = 模块成员键基们.设置(
                模块成员键(本模块ID, 整64(声明.文本)), 键基c);
            如果 (!设成员c.正常) { 运行时错误(4); }
            如果 (是否公开 == 1) {
                结果<空类型, 整32> 设公开c = 模块成员公开们.设置(
                    模块成员键(本模块ID, 整64(声明.文本)), 1);
                如果 (!设公开c.正常) { 运行时错误(4); }
            }
        }

函数 收集静态声明(向量<节点> 池, 整32 声明索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断,
              字符串 模块路径, 整64 本模块ID, 整64 是否公开) -> 空类型 {
    节点 声明 = 池.元素(声明索引);
// 族⑤：静态声明收集（原 839~862 段）——②c C 顶层静态登记（符号_变量）+
//   155-a B10 静态名集合追加（检查赋值语句 报「静态变量写」用）。
            // ②c C：顶层静态登记（符号_变量，全局作用域——跨函数标识符解析；
            //   类型ID 取声明附加的类型节点文本）
            // 155-a（B10）：静态名集合追加（检查赋值语句 报「静态变量写」用）
            结果<空类型, 整32> 加静态nB10 = 全局静态名ID们.追加(整64(声明.文本));
            如果 (!加静态nB10.正常) { 运行时错误(4); }
            整64 静态类型ID = 驻留("整64");
            // 守卫 >= 0（池索引 0 合法——IR生成 同款 lessons）：首静态声明的类型
            //   节点恰在池 0 时原 > 0 漏登记，类型退回 整64 默认
            如果 (声明.附加 >= 0 && 声明.附加 < 池.大小()) {
                节点 类型节点 = 池.元素(整32(声明.附加));
                静态类型ID = 整64(类型节点.文本);
            }
            整64 键基st = 键基合成(模块路径, 整64(声明.文本));
            整64 忽略4 = 表注册(符号表, 键基st, 静态类型ID, 符号_变量, 是否公开);
            如果 (忽略4 == 0) { }
            结果<空类型, 整32> 设成员st = 模块成员键基们.设置(
                模块成员键(本模块ID, 整64(声明.文本)), 键基st);
            如果 (!设成员st.正常) { 运行时错误(4); }
            如果 (是否公开 == 1) {
                结果<空类型, 整32> 设公开st = 模块成员公开们.设置(
                    模块成员键(本模块ID, 整64(声明.文本)), 1);
                如果 (!设公开st.正常) { 运行时错误(4); }
            }
        }




// 类方法登记（第七十八轮，2026-09-12）：遍历类区间 节点_方法 → IR类 类表——
//   构造（方法名==类名 → 构造参数串）/析构（名="~类名" → 析构存在位）/普通
//   方法（名+返回类型+参数串）。构造/析构返回类型按 空类型 归一（节点附加=0）。
//   参数串经 函数参数串（方法节点与函数节点同布局：[子起点, 块.子起点) 参数区）。
// 329-a（D38 批2·109）：类构造统计（语义侧·重载感知）——IR类 构造参数串表为
//   单串覆盖式（同名构造互相覆盖），无法表达多构造并存；裸声明无默认构造判定
//   需「构造个数>0 且无零参构造」双条件（宿主 w07 双构造放行/t30 单带参拒）。
静态 映射<整64, 整64> 类构造个数表;
静态 映射<整64, 整64> 类构造零参位表;
// 340-a（D38 批3b·347）：类节点索引表（类名ID → 类节点池索引）——成员访问
//   可见性设防现场扫类节点子区间（节点_类字段.子起点=段可见性）的数据源
静态 映射<整64, 整64> 类节点索引表;

函数 收集类方法(向量<节点> 池, 整32 类节点索引) -> 空类型 {
    节点 类节点 = 池.元素(类节点索引);
    整64 类名ID = 整64(类节点.文本);
    字符串 类名文本 = 字符串复制(驻留文本(类名ID));
    字符串 析构名 = "~" + 类名文本;
    整64 位置 = 整64(类节点.子起点);
    当 (位置 < 整64(类节点.子终点)) {
        节点 成员 = 池.元素(整32(位置));
        如果 (成员.类型 == 节点_方法) {
            字符串 参数串 = 函数参数串(池, 整32(位置));
            整64 方法名ID = 整64(成员.文本);
            整64 返回类型ID = 整64(成员.附加);
            如果 (返回类型ID == 0) { 返回类型ID = 驻留("空类型"); }
            如果 (方法名ID == 类名ID) {
                登记类构造(类名ID, 参数串);
                // 329-a：重载感知统计（个数累加·零参存在位置位）
                整64 旧数109 = 0;
                结果<整64, 整32> 查数109 = 类构造个数表.获取(类名ID);
                如果 (查数109.正常) { 旧数109 = 查数109.值; }
                结果<空类型, 整32> 设数109 = 类构造个数表.设置(类名ID, 旧数109 + 1);
                如果 (!设数109.正常) { 运行时错误(4); }
                如果 (字符串长度(参数串) == 0) {
                    结果<空类型, 整32> 设零109 = 类构造零参位表.设置(类名ID, 1);
                    如果 (!设零109.正常) { 运行时错误(4); }
                }
            } 否则 如果 (字符串比较(驻留文本(方法名ID), 析构名)) {
                登记类析构(类名ID);
            } 否则 {
                登记类方法(类名ID, 方法名ID, 返回类型ID, 参数串);
            }
        }
        位置++;
    }
}

// 329-a：类构造统计查询（109 裸声明判定用——同包 语义检查语句 消费）
函数 查类构造个数(整64 类名ID) -> 整64 {
    结果<整64, 整32> 查 = 类构造个数表.获取(类名ID);
    如果 (查.正常) { 返回 查.值; }
    返回 0;
}

函数 类有零参构造(整64 类名ID) -> 布尔 {
    结果<整64, 整32> 查 = 类构造零参位表.获取(类名ID);
    如果 (查.正常) { 返回 查.值 == 1; }
    返回 假;
}

// 340-a（347）：类节点索引查询（-1=非类或未登记）
函数 查类节点索引(整64 类名ID) -> 整64 {
    结果<整64, 整32> 查 = 类节点索引表.获取(类名ID);
    如果 (查.正常) { 返回 查.值; }
    返回 0 - 1;
}

// 语义诊断缓冲访问（语义检查 主流程聚合用——千行拆分，2026-09-08）
函数 取语义诊断数() -> 整64 {
    返回 语义诊断缓冲.大小();
}

函数 取语义诊断(整64 序) -> 字符串 {
    // 70-a（2026-09-11 方案A 补完）：容器元素=借用（Rust Vec::get -> &T）——
    //   返回类型 字符串（A2 拥有契约）下调用方 free=缓冲元素悬垂；B 类显式
    //   复制 落堆（货舱查找依赖 同款，A2 呈报 B 类字段借出面补完）
    返回 字符串复制(语义诊断缓冲.元素(序));
}

不安全 函数 清空语义诊断缓冲() -> 空类型 {
    语义诊断缓冲 = 向量<字符串>();
}

// ==================== 跨子模块访问函数（千行拆分，2026-09-08） ====================
//   语义检查 子模块经下列函数访问模块分桶表/指针变量表
//   （静态表=文件级私有，跨文件仅函数可见；查询未命中返回 -1 哨兵）
函数 查模块成员键基(整64 模块ID, 整64 名ID) -> 整64 {
    结果<整64, 整32> 查 = 模块成员键基们.获取(模块成员键(模块ID, 名ID));
    如果 (查.正常) { 返回 查.值; }
    返回 0 - 1;
}

函数 查模块成员公开(整64 模块ID, 整64 名ID) -> 整64 {
    结果<整64, 整32> 查 = 模块成员公开们.获取(模块成员键(模块ID, 名ID));
    如果 (查.正常) { 返回 查.值; }
    返回 0 - 1;
}

函数 登记语义指针变量(整64 名ID, 整64 类型ID) -> 空类型 {
    结果<空类型, 整32> 设 = 指针变量表.设置(名ID, 类型ID);
    如果 (!设.正常) { 运行时错误(4); }
}

函数 查语义指针变量(整64 名ID) -> 整64 {
    结果<整64, 整32> 查 = 指针变量表.获取(名ID);
    如果 (查.正常) { 返回 查.值; }
    返回 0 - 1;
}

函数 清空语义指针变量表() -> 空类型 {
    指针变量表.清空();
}
