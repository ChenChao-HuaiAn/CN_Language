// CN 自举编译器 v2：结构化语义分析器（自举重建 P4 重做，2026-08-25，第6版）
// 符号表 = 向量<映射<整64, 符号>> 真嵌套作用域栈——每层独立 O(1) 哈希映射。
// 相比第5版「单映射 + 每符号深度 + 延迟删除」：弹出真正移除该层符号（查找
// 无深度遮蔽检查、无残留符号），对标 rustc/LLVM 作用域栈。
// 依赖（宿主根治）：H8-5 容器持有类对象所有权——向量 追加 类元素深拷贝独立、
// 绑定元素为非拥有式视图（不触发 RAII 双释放）；Feature 2 完整版 向量 删除/
// ~向量 自动销毁有析构类元素（编译器级注入，弹出无需显式 释放内部数组()）。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（原 语法分析，阶段目录包名）
导入 IR;         // 容器/结果 合成名判定 + 节点_*/键位移 常量（原 IR容器+IR常量 合并目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

公开:

常量 符号_变量 = 1;
常量 符号_参数 = 2;
常量 符号_函数 = 3;
常量 符号_结构体 = 4;
常量 符号_常量 = 5;     // P7a：顶层常量（类型按字面量记 整64；值内联在 IR 层完成）

结构体 符号 {
    整64 名ID;
    整64 类型ID;
    整64 种类;
    整64 附加;
    整64 已转移;   // plans/019 阶段1：转移(变量) 后源变量禁用（E0382 对标）；
                  //   0=未转移（表注册 显式清零——结构体局部无零初始化纪律）
}

// 1011（#751 P1-1）：成员键基查询含再导出转发——导入项/限定类型/常量/限定
//   调用共用；miss 查转发表，命中提升登记返回正常，未命中返回错误（分流）。
不安全 函数 查模块成员键基含转发1011(整64 模块ID, 整64 名ID) -> 结果<整64, 整32> {
    可选<整64> 直键1011查 = 查模块成员键基(模块ID, 名ID);
    如果 (直键1011查.有值) { 返回 正常(直键1011查.值); }
    结果<整64, 整32> 查源1011 = 查再导出转发1011(模块ID, 名ID);
    字符串 转源模块1011 = "";
    字符串 转源符号1011 = "";
    布尔 转发有效1011 = 假;
    如果 (查源1011.正常) {
        如果 (拆限定名(驻留文本(查源1011.值), 转源模块1011, 转源符号1011) == 1) {
            转发有效1011 = 真;
        }
    }
    否则 {
    }
    如果 (!转发有效1011) { 返回 错误(1); }
    整64 转源模块ID1011 = 驻留(转源模块1011);
    整64 转源符号ID1011 = 驻留(转源符号1011);
    可选<整64> 转源键基1011查 = 查模块成员键基(转源模块ID1011, 转源符号ID1011);
    如果 (!转源键基1011查.有值) { 返回 错误(3); }
    整64 转源键基1011 = 转源键基1011查.值;
    结果<空类型, 整32> 提键1011 = 模块成员键基们.设置(
        模块成员键(模块ID, 名ID), 转源键基1011);
    如果 (!提键1011.正常) { 运行时错误(4); }
    结果<空类型, 整32> 提公1011 = 模块成员公开们.设置(
        模块成员键(模块ID, 名ID), 1);
    如果 (!提公1011.正常) { 运行时错误(4); }
    返回 正常(转源键基1011);
}

// ==================== 模块分桶（plans/018 P6b 第 3 层，2026-09-07） ====================
// 名称解析三级模型（plans/001 §5.9.7，Rust item > named use > glob 对齐）：
//   ① 本模块显式声明（模块成员键基们）＞ ② 显式导入（文件导入键基们，构建期
//   解析+可见性/E0255 检查）＞ ③ 通配（导入模块路径们 遍历，公开成员、使用点
//   歧义 E0659）。①遮蔽③ 合法；①×② / ②×② 同名=编译错误。
// 全局符号表键升级为「键基」（IR容器.键基合成：主模块=纯名、其余=模块$名）——
//   跨模块同名同签名合法共存（原「先收集文件赢」静默/硬错误 面根治）；单文件
//   与主模块形态键=纯名，行为逐字节不变（v2self 产物对拍硬基准）。
// 静态上下文为「当前检查文件」维度：语义分析多文件 第二趟逐文件由
//   构建文件导入上下文 重设；三级决议结果缓存（三级键基缓存们）同窗口生命周期。
静态 映射<整64, 整64> 模块成员键基们;   // 模块路径ID*键位移+名ID -> 键基ID
静态 映射<整64, 整64> 模块成员公开们;   // 同键 -> 1=公开（公开: 标签；缺省私有）
静态 映射<整64, 整64> 文件导入键基们;   // 绑定名ID -> 键基ID（② 构建期解析产物）
静态 向量<整64> 已加载模块ID们;         // ③ 合并全局可见的遍历范围=加载树全部模块（宿主事实标准对齐）
静态 整64 当前模块路径ID = 0;           // 当前检查文件的模块路径 驻留 ID
静态 映射<整64, 整64> 三级键基缓存们;   // 名ID -> 键基ID / -1 未命中 / -2 歧义（文件级）
静态 向量<字符串> 语义诊断缓冲;         // 查找链路歧义诊断缓冲（主流程末尾合入）

// 诊断缓冲追加（查找函数无诊断参数——歧义诊断经缓冲在 语义分析多文件 末尾
//   合入主诊断表，错误计数不漏）
不安全 函数 缓冲诊断(字符串 消息) -> 空类型 {
    结果<空类型, 整32> 加 = 语义诊断缓冲.追加(消息);
    如果 (!加.正常) { 运行时错误(4); }
}

// 成员索引键：模块路径ID*键位移+名ID——#751 P1-1 下沉 IR布局.cn（转发表
//   与 IR 布局归一共用同一公式；本文件及语义兄弟模块经包合并全局引用）。

// 三级键基决议（缓存版）：返回 键基ID / -1 未命中 / -2 歧义（首次经诊断缓冲
//   报 E0659，缓存后同名重复使用不再重复报）。实参数 >= 0 时③多命中按签名
//   个数消歧（宿主签名决议对齐：同名不同签名=重载共存合法，实参数可辨则选
//   其桶；实参数 <0=非调用裸名，同签名多模块才真歧义）。消费点：表查找类型ID/
//   表查找种类 的全局层、检查表达式 标识符与调用的签名回退、调用决议登记。
不安全 函数 三级键基查找(向量<映射<整64, 符号>>& 符号表, 整64 名ID, 整64 实参数) -> 整64 {
    结果<整64, 整32> 查缓存 = 三级键基缓存们.获取(名ID);
    如果 (查缓存.正常) { 返回 查缓存.值; } 否则 { }
    整64 结果键基 = -1;
    // ① 本模块（成员索引=声明收集 登记）
    结果<整64, 整32> 查一 = 模块成员键基们.获取(模块成员键(当前模块路径ID, 名ID));
    如果 (查一.正常) {
        结果键基 = 查一.值;
    } 否则 {
        // ② 显式导入（构建文件导入上下文 解析：可见性/E0255 已在该处诊断）
        结果<整64, 整32> 查二 = 文件导入键基们.获取(名ID);
        如果 (查二.正常) {
            结果键基 = 查二.值;
        } 否则 {
            // ③ 合并全局可见（宿主事实标准对齐——加载树全部模块的公开符号，
            //   传递依赖可见：IR生成 用 IR签名 的 段首 经 IR容器 传递加载实证）。
            //   同名多命中按签名消歧：同签名多模块=真歧义 E0659（决议失败绝不
            //   静默）；不同签名=重载共存（实参数可辨选其桶，否则首候选——跨桶
            //   重载部分支持，诚实边界随 plans/018 注记）
            整64 候选键基 = -1;
            整64 首参串标 = -1;
            整64 真歧义 = 0;
            整64 命中数 = 0;
            字符串 来源们 = "";
            整64 g = 0;
            当 (g < 已加载模块ID们.大小()) {
                整64 m = 已加载模块ID们.元素(g);
                如果 (m != 当前模块路径ID) {
                    结果<整64, 整32> 查g = 模块成员键基们.获取(模块成员键(m, 名ID));
                    如果 (查g.正常) {
                        整64 键基g = 查g.值;   // 正向分支内提取（宿主 结果 流敏感检查惯例）
                        结果<整64, 整32> 查公 = 模块成员公开们.获取(模块成员键(m, 名ID));
                        如果 (查公.正常) {
                            // 该桶首个签名候选的参数串（签名消歧键；非函数=-1）
                            整64 参串标 = -1;
                            结果<整64, 整32> 查数g = 查函数签名个数(键基g);
                            如果 (查数g.正常) {
                                // 命中即有候选（计数登记恒 ≥1·.正常 即原 >0 判定）
                                结果<整64, 整32> 查串g = 查函数签名参数串(键基g * 键位移);
                                如果 (查串g.正常) { 参串标 = 查串g.值; }
                            }
                            如果 (命中数 == 0) {
                                命中数 = 1;
                                候选键基 = 键基g;
                                首参串标 = 参串标;
                                来源们 = 字符串复制(驻留文本(m));
                            } 否则 如果 (参串标 == 首参串标) {
                                // 同签名多模块=真歧义（且已锁定首候选可能不唯一）
                                真歧义 = 1;
                                来源们 = 来源们 + "/" + 驻留文本(m);
                            }
                            // 不同签名=重载共存：实参数可辨则按参数个数选桶
                            // （独立分支替代原裸 否则——else 降格为非法输入拦截分支）
                            如果 (命中数 != 0 && 参串标 != 首参串标) {
                                如果 (实参数 >= 0) {
                                    可选<整64> 选桶查 = 按实参数选桶(名ID, 实参数);
                                    如果 (选桶查.有值) { 候选键基 = 选桶查.值; }
                                }
                            }
                        }
                        否则 {
                        }
                    }
                    否则 {
                    }
                }
                g++;
            }
            如果 (真歧义 == 1) {
                缓冲诊断("[错误] 符号歧义: " + 驻留文本(名ID) + "（来自 " +
                              来源们 + "——须以 模块::符号 限定消歧，规格08-三）");
                结果键基 = -2;
            } 否则 {
                结果键基 = 候选键基;
            }
        }
    }
    结果<空类型, 整32> 设缓存 = 三级键基缓存们.设置(名ID, 结果键基);
    如果 (!设缓存.正常) { 运行时错误(4); }
    返回 结果键基;
}

// ③多命中不同签名的桶选择：按「签名候选参数个数=实参数」过滤各命中桶，
//   唯一匹配返回其键基 可选值；无/多匹配返回 无（调用方保留首候选）。
//   签名候选经函数签名表（键基维度）逐桶查询；参数个数=逗号数+1 真数
//   （决议函数符号 同款）。880 批5：原 -1 哨兵→可选（miss 不再与键基值域重叠）。
函数 按实参数选桶(整64 名ID, 整64 实参数) -> 可选<整64> {
    整64 选中键基 = 0;
    布尔 有选中 = 假;
    整64 匹配数 = 0;
    整64 g = 0;
    当 (g < 已加载模块ID们.大小()) {
        整64 m = 已加载模块ID们.元素(g);
        如果 (m != 当前模块路径ID) {
            结果<整64, 整32> 查g = 模块成员键基们.获取(模块成员键(m, 名ID));
            如果 (查g.正常) {
                结果<整64, 整32> 查公 = 模块成员公开们.获取(模块成员键(m, 名ID));
                如果 (查公.正常) {
                    整64 桶键基 = 查g.值;   // 正向分支内提取（宿主 结果 流敏感检查惯例）
                    结果<整64, 整32> 查数 = 查函数签名个数(桶键基);
                    如果 (查数.正常) {
                        整64 候选数 = 查数.值;
                        整64 k = 0;
                        当 (k < 候选数) {
                            结果<整64, 整32> 查串 = 查函数签名参数串(桶键基 * 键位移 + k);
                            如果 (查串.正常) {
                                字符串 参数串文本 = 字符串复制(驻留文本(查串.值));
                                // T69（480-a）：参数个数=参数串段数（深度感知）
                                整64 参数个数 = 参数串段数(参数串文本);
                                如果 (参数个数 == 实参数) {
                                    匹配数++;
                                    如果 (匹配数 == 1) { 选中键基 = 桶键基; 有选中 = 真; }
                                }
                            }
                            k++;
                        }
                    }
                }
                否则 {
                }
            }
            否则 {
            }
        }
        g++;
    }
    如果 (匹配数 == 1) {
        如果 (有选中) { 返回 某些(选中键基); }
    }
    返回 无;
}

// 清空模块解析表（语义分析/语义分析多文件 入口——任务级生命周期惯例）
不安全 函数 清空模块解析表() -> 空类型 {
    模块成员键基们.清空();
    模块成员公开们.清空();
    文件导入键基们.清空();
    已加载模块ID们 = 向量<整64>();
    三级键基缓存们.清空();
    语义诊断缓冲 = 向量<字符串>();
    当前模块路径ID = 0;
}

// 登记调用点决议键基（语义驱动 IR——plans/018 第 4 层）：三级决议命中且该
//   键基下有签名候选（=用户函数，非类型转换/构造/内置）时，把键基写入
//   调用决议键基们（IR容器 静态表，键=调用节点池索引）。IR 层 决议函数符号
//   据此锁定候选模块桶后重载决议——IR 不重复名称解析、无反向依赖。
函数 登记调用决议(向量<映射<整64, 符号>>& 符号表, 整64 名ID, 整64 调用节点索引) -> 空类型 {
    整64 键基r = 三级键基查找(符号表, 名ID, 0 - 1);
    如果 (键基r < 0) { 返回; }
    结果<整64, 整32> 查数r = 查函数签名个数(键基r);
    // 命中即有候选（计数登记恒 ≥1·.正常 即原 >0 判定）
    如果 (查数r.正常) {
        调用决议登记(调用节点索引, 键基r);
    }
}

// 全局层直查类型ID（签名键/键基等复合键专用——不经三级解析；签名键含 '#'
//   非纯名，三级成员索引按纯名登记，直查全局层才是其正确消费形态）。
//   返回 可选（无值=全局层无此键）；类型ID 0=登记但无类型名（合法值·
//   880 批5 结果化——原 -1 哨兵与 0 合法值域边界显式化）。
函数 全局层查类型(向量<映射<整64, 符号>>& 符号表, 整64 键) -> 可选<整64> {
    如果 (符号表.大小() == 0) { 返回 无; }
    结果<符号, 整32> 查 = 符号表.元素引用(0).获取(键);
    如果 (查.正常) {
        符号 找到s = 查.值;   // 逐步提取（链式成员 查.值.类型ID 踩 v2 成员链
        返回 某些(找到s.类型ID);    //   字段偏移半实现边界——[ir2] 拒发，非链式惯例）
    }
    返回 无;
}

// ③ 第三波（2026-09-03）：指针变量表——名ID -> 所指元素类型名ID。参数/局部
//   声明时按类型节点 附加=指针层数 1..255 登记（与 引用>=256 互斥）；下标
//   白名单与左值放行判定用。检查函数 开头清空（函数级生命周期——跨函数
//   同名不串；块级遮蔽同 变量结构体表 约定的既有边界）。顶层静态无初始化
//   ——宿主 P3-8 指针槽模型入口自动构造。
静态 映射<整64, 整64> 指针变量表;

// 615（2026-10-16）：指针层数并行表——名ID -> 指针层数（1..255）。
//   背景：指针变量表值=剥星基名（55-c 口径），层数在类型节点附加位不入表——
//   而「多级指针成员访问拦截」（001 §4.4：「.」左侧指针自动解引用仅一级、
//   多级指针不继续解引用报错）须当场核层数≥2。与 指针变量表 同生命周期：
//   登记语义指针变量 单点成对写、清空语义指针变量表 单点成对清（防漏改）。
静态 映射<整64, 整64> 指针层数表;


// 引用返回调用判定（2026-09-04 缺陷零容忍收口，宿主 P3-18 对齐）：调用节点
//   的被调为标识符且符号表返回类型名尾 '&'（-> 整64&）——该调用结果=被引用
//   左值地址，可作赋值目标/复合赋值/引用初始化绑定。
// 118（929·任务 118）：扩被调=成员（方法调用）形态——容器类经 IR签名 签名表
//   （键=基名.方法名.实参数·查签名返回 保留尾 '&'——829 修复·语义检查 表达式
//   语句丢弃面同款回退先例）；用户类经 查类方法返回（方法表返回类型名 ID
//   来自解析层 节点_方法.附加——类型文本分支已并入 '&'）。覆盖
//   v.元素引用(i) = x 写穿放行（829 立法写通道）；v.元素(i)（按值副本访问器）
//   签名无 '&' 仍拒——001 §5.3 三形态正交。
// 1012（79_v2 批四b·链式对象类型推导）：语义层成员链类型——标识符段=表查找；
//   成员段=父类型结构体的字段类型（查字段类型ID 消费与 检查表达式 下标对象
//   分支同源先例）。供 是引用返回调用 的链式对象形态（程序.函数们.元素引用(f)）。
// 880 批5：原 -1（标识符查表 miss）/0（成员链不可推导）双哨兵→可选<整64>
//   ——合法域=类型名 ID>0；两哨兵全部消费点均以 <=0/>0 同一分流（无任何消费方
//   区分 -1 与 0），故属 miss/不可推导 A 类而非多态状态码。
不安全 函数 推导语义成员链类型(向量<节点> 池, 整32 链节点索引,
                             向量<映射<整64, 符号>>& 符号表) -> 可选<整64> {
    节点 链n = 池.元素(链节点索引);
    如果 (链n.类型 == 节点_标识符) {
        可选<整64> 查链n = 表查找类型ID(符号表, 整64(链n.文本));
        如果 (查链n.有值) { 返回 查链n; }
        返回 无;
    }
    如果 (链n.类型 == 节点_成员 && 链n.子起点 > 0) {
        可选<整64> 父类型查c = 推导语义成员链类型(池, 整32(链n.子起点), 符号表);
        如果 (!父类型查c.有值) { 返回 无; }
        整64 父类型c = 父类型查c.值;
        // 812：数组父先剥一层元素再查字段（班级[2] 的 .成绩 链）——与 IR 层
        //   推导成员链类型ID「父类型是数组则先取元素」逐句同构（语义版原缺
        //   =数组父字段链必 miss 面）；宿主 memberObjStructType arrayElemOf
        //   同构。剥一层=剥一层数组后缀375（剥最后一层 [..]·多维正确）。
        字符串 父文本812 = 字符串复制(驻留文本(父类型c));
        如果 (是数组类型文本(父文本812)) {
            父类型c = 驻留(剥一层数组后缀375(父文本812));
        }
        整64 字段类型c = 查字段类型ID(父类型c, 整64(链n.文本));
        // 字段类型 0=未登记（查字段类型ID 契约）——与不可推导同面归无值
        布尔 字段有效c = 字段类型c > 0;
        如果 (字段有效c) { 返回 某些(字段类型c); }
        返回 无;
    }
    返回 无;
}

函数 是引用返回调用(向量<节点> 池, 整32 调用节点索引, 向量<映射<整64, 符号>>& 符号表) -> 布尔 {
    节点 调用节点 = 池.元素(调用节点索引);
    如果 (调用节点.类型 != 节点_调用 || 调用节点.子起点 <= 0) { 返回 假; }
    节点 被调r = 池.元素(整32(调用节点.子起点));
    如果 (被调r.类型 == 节点_标识符) {
        可选<整64> 返回类型IDr查 = 表查找类型ID(符号表, 整64(被调r.文本));
        如果 (!返回类型IDr查.有值) { 返回 假; }
        整64 返回类型IDr = 返回类型IDr查.值;
        字符串 返回名r = 字符串复制(驻留文本(返回类型IDr));
        如果 (字符串长度(返回名r) == 0) { 返回 假; }
        返回 ((整64(返回名r[字符串长度(返回名r) - 1]) & 255) == 38);
    }
    // 118：被调=成员（方法调用）——对象=标识符（首版形态面；链式对象后续波）
    // 1012（79_v2 批四b·链式对象形态）：对象可为成员链（程序.函数们.元素引用(f)
    //   的对象=「程序.函数们」成员节点——原只认标识符被拒「引用初始化非可绑定
    //   左值」）——链式时逐段推导类型：标识符段=表查找；成员段=父类型结构体
    //   的字段类型（语义层推导·与 IR 层 推导成员链类型ID 同构）。
    // 733（#733 探针副产品）：原入口带「实参数 > 0」门槛——零参成员方法引用
    //   返回调用被挡在判定外（`字符串& 别 = b.读名();` 报引用初始化非左值=
    //   宿主放行/v2 拒分叉实锤 q2 探针）。实参数仅用于容器签名键合成（附加=0
    //   键合法）；用户类查 查类方法返回 不依赖实参数——放宽入口，命中面仍由
    //   尾 '&' 判定把守。
    如果 (被调r.类型 == 节点_成员 && 被调r.子起点 > 0) {
        节点 对象m = 池.元素(整32(被调r.子起点));
        可选<整64> 对象类型m查 = 无;
        如果 (对象m.类型 == 节点_标识符) {
            对象类型m查 = 表查找类型ID(符号表, 整64(对象m.文本));
        } 否则 如果 (对象m.类型 == 节点_成员) {
            对象类型m查 = 推导语义成员链类型(池, 整32(被调r.子起点), 符号表);
        }
        // miss 保持 0（下方 <=0 判定与原 -1/0 双哨兵同真·880 批5）
        整64 对象类型m = 0;
        如果 (对象类型m查.有值) { 对象类型m = 对象类型m查.值; }
        如果 (对象类型m <= 0) { 返回 假; }
        字符串 对象名m = 字符串复制(驻留文本(对象类型m));
        字符串 方法名m = 字符串复制(驻留文本(整64(被调r.文本)));
        // 容器类（$ 合成名）：签名表回退（键=基名.方法名.实参数）
        字符串 基名m = 合成名基名(对象名m);
        如果 (字符串长度(基名m) > 0 && !字符串比较(基名m, 对象名m)) {
            确保签名已加载();
            整64 键m = 驻留(基名m + "." + 方法名m + "." +
                           整数转字符串(整64(调用节点.附加)));
            可选<整64> 查返m = 查签名返回(键m);
            如果 (查返m.有值) {
                字符串 返文m = 字符串复制(驻留文本(查返m.值));
                如果 (字符串长度(返文m) > 0) {
                    返回 ((整64(返文m[字符串长度(返文m) - 1]) & 255) == 38);
                }
            }
            返回 假;
        }
        // 用户类：类方法表（返回类型名 ID 尾 '&'）
        如果 (是用户类(对象名m)) {
            整64 返IDu = 查类方法返回(驻留(对象名m), 整64(被调r.文本));
            如果 (返IDu > 0) {
                字符串 返文u = 字符串复制(驻留文本(返IDu));
                如果 (字符串长度(返文u) > 0) {
                    返回 ((整64(返文u[字符串长度(返文u) - 1]) & 255) == 38);
                }
            }
        }
    }
    返回 假;
}

// 933（任务 933·双侧零分叉）：引用返回字符串调用判定（字符串特化版）——
//   与 是引用返回调用 同构（三段来源：标识符=表查找类型；容器=签名表；用户类=
//   类方法表），叠加「剥尾 '&' 后=字符串」。**用途**=比较/下标等消费点的读值
//   类型归一（用户类方法调用在 检查表达式/检查调用表达式 面=「整64 兜底」——
//   648 归档：方法返回在 IR 层调用面精确决议；消费点直判绕开兜底）。
//   ⚠ IR 层同名谓词 是引用返回字符串调用933（IR生成类型辅助.cn·IR 表）——
//   跨层不可复用（IR 包不得依赖语义包·334 层序），双份为层隔离代价（与
//   宿主 isRefReturnClassValueCall / v2 侧既有双份判定同族）。
函数 是引用返回字符串调用933语义(向量<节点> 池, 整32 调用节点索引,
                    向量<映射<整64, 符号>>& 符号表) -> 布尔 {
    节点 调用节点933 = 池.元素(调用节点索引);
    如果 (调用节点933.类型 != 节点_调用 || 调用节点933.子起点 <= 0) { 返回 假; }
    节点 被调933 = 池.元素(整32(调用节点933.子起点));
    字符串 返回文933 = "";
    如果 (被调933.类型 == 节点_标识符) {
        可选<整64> 返IDf933查 = 表查找类型ID(符号表, 整64(被调933.文本));
        如果 (返IDf933查.有值 && 返IDf933查.值 != 0) {
            返回文933 = 字符串复制(驻留文本(返IDf933查.值));
        }
    } 否则 如果 (被调933.类型 == 节点_成员 && 被调933.子起点 > 0) {
        节点 对象933 = 池.元素(整32(被调933.子起点));
        可选<整64> 对象类型933查 = 无;
        如果 (对象933.类型 == 节点_标识符) {
            对象类型933查 = 表查找类型ID(符号表, 整64(对象933.文本));
        } 否则 如果 (对象933.类型 == 节点_成员) {
            对象类型933查 = 推导语义成员链类型(池, 整32(被调933.子起点), 符号表);
        }
        // miss 保持 0（下方 >0 判定与原 -1/0 双哨兵同假·880 批5）
        整64 对象类型933 = 0;
        如果 (对象类型933查.有值) { 对象类型933 = 对象类型933查.值; }
        如果 (对象类型933 > 0) {
            字符串 对象名933 = 字符串复制(驻留文本(对象类型933));
            字符串 基名933 = 合成名基名(对象名933);
            如果 (字符串长度(基名933) > 0 && !字符串比较(基名933, 对象名933)) {
                确保签名已加载();
                整64 键933 = 驻留(基名933 + "." +
                                  字符串复制(驻留文本(整64(被调933.文本))) + "." +
                                  整数转字符串(整64(调用节点933.附加)));
                可选<整64> 查返933 = 查签名返回(键933);
                如果 (查返933.有值) { 返回文933 = 字符串复制(驻留文本(查返933.值)); }
            } 否则 如果 (是用户类(对象名933)) {
                整64 返IDu933 = 查类方法返回(驻留(对象名933),
                                               整64(被调933.文本));
                如果 (返IDu933 > 0) {
                    返回文933 = 字符串复制(驻留文本(返IDu933));
                }
            }
        }
    }
    如果 (字符串长度(返回文933) == 0) { 返回 假; }
    如果 (((整64(返回文933[字符串长度(返回文933) - 1]) & 255) != 38)) { 返回 假; }
    返回 字符串比较(字符串子串(返回文933, 0, 字符串长度(返回文933) - 1),
                     "字符串");
}

// 压入作用域：追加一个空映射（追加 深拷贝独立——H8-5 容器持有类对象）
函数 表压入(向量<映射<整64, 符号>>& 符号表) -> 空类型 {
    映射<整64, 符号> 层 = 映射<整64, 符号>();
    结果<空类型, 整32> 加 = 符号表.追加(层);
    如果 (!加.正常) { 运行时错误(4); }
}

// 弹出作用域：删除 自动销毁顶层映射元素（Feature 2 完整版——向量 删除 对
//   有析构类元素自动调用析构 ~映射 释放内部数组；真删除无残留遮蔽）
函数 表弹出(向量<映射<整64, 符号>>& 符号表) -> 空类型 {
    如果 (符号表.大小() == 0) { 返回; }
    结果<空类型, 整32> 删 = 符号表.删除(符号表.大小() - 1);
    如果 (!删.正常) { 运行时错误(4); }
}

// 注册符号：同作用域重名 -> 0；否则设置（O(1) 哈希）
函数 表注册(向量<映射<整64, 符号>>& 符号表, 整64 名ID, 整64 类型ID, 整64 种类, 整64 附加) -> 整64 {
    如果 (符号表.大小() == 0) { 返回 0; }
    // 829（065 A 账）：元素引用原地写——元素(顶层) 值副本深拷 + 743-a 的
    //   「复制(顶层) 写回」两步并一步（引用接收者上 设置 直接改层·宿主 P3-18 /
    //   v2 生成语句 族① 引用返回对齐）。语义与「副本改后整体替换层」等价。
    结果<符号, 整32> 已有 = 符号表.元素引用(符号表.大小() - 1).获取(名ID);
    如果 (已有.正常) { 返回 0; } 否则 { }
    符号 s;
    s.名ID = 名ID;
    s.类型ID = 类型ID;
    s.种类 = 种类;
    s.附加 = 附加;
    s.已转移 = 0;   // plans/019 阶段1：新声明=新变量（遮蔽语义天然正确）
    结果<空类型, 整32> 加 = 符号表.元素引用(符号表.大小() - 1).设置(名ID, s);
    如果 (!加.正常) { 返回 0; }
    返回 1;
}

// ==================== plans/019 阶段1（2026-09-10）：显式转移 已转移标记 ====================
// 标记源变量已转移（与 表查找 同序：从栈顶向下找到名ID 所在局部层——内层
//   同名新声明在新层，外层标记不污染内层=遮蔽语义正确；全局层键为键基非名ID，
//   全局变量转移第一版不支持（局部转移为主场景））。返回 1=标记成功 0=未找到。
函数 表标记转移(向量<映射<整64, 符号>>& 符号表, 整64 名ID, 整64 行) -> 整64 {
    整64 i = 符号表.大小();
    当 (i > 1) {
        i--;
        // 829（065 A 账）：元素引用原地读写——原「层副本改后 复制(层) 写回」
        //   两步并一步（798 的写回义务随副本消亡：引用接收者上 设置 直接改层）。
        结果<符号, 整32> 查 = 符号表.元素引用(i).获取(名ID);
        如果 (查.正常) {
            符号 找到 = 查.值;
            找到.已转移 = 行;
            结果<空类型, 整32> 写 = 符号表.元素引用(i).设置(名ID, 找到);
            如果 (!写.正常) { 返回 0; }
            // 982 转移集分支合流：活跃集镜像同步（快照/恢复/合流消费——
            //   本函数=已转移位唯一写点·镜像恒同步）
            转移活跃记录(名ID, 行);
            // 829（065 A 账）：783/798 的副本+写回（743-a 同款形态）已由
            //   元素引用原地写取代——层槽地址稳定，设置内部扩容只改层字段，
            //   标记直接落层，不再随副本消亡丢失（197_v2 漏检形态不复存在）。
            返回 1;
        }
        否则 {
        }
    }
    返回 0;
}

// plans/019 阶段2（2026-09-10）：名字是否绑定在函数局部层（符号表索引 >=1
//   =函数参数层/块层；[0]=全局层）——逃逸检查的「局部」判定（参数随栈帧
//   消亡亦属局部）。

// #1252：继承位父类裸名多模块同名歧义诊断（001 §5.9.7 名称解析——① 本模块
//   显式定义项优先=合法遮蔽；③×③ 同名=使用点歧义错误；决议失败绝不静默）。
//   数据源=节点_类.附加（基名ID·解析类声明回填；0=无继承）+ 模块成员键基们
//   （模块感知成员索引）+ 用户类键基们（仅类可作父类，函数/结构体同名不计）。
//   规则与宿主 resolveBaseClass 同构：派生类所在模块有同名类=声明模块优先，
//   不诊断；其余加载模块同名类 ≥2=歧义诊断。限定名恒明确不在此面。
函数 检查继承基名歧义(整64 类名ID, 整64 基名ID, 整64 本模块ID,
                       向量<整64>& 全部模块ID们, 向量<字符串>& 诊断) -> 空类型 {
    如果 (基名ID == 0) { 返回; }
    字符串 基文本 = 字符串复制(驻留文本(基名ID));
    字符串 模块x = "";
    字符串 符号x = "";
    如果 (拆限定名(基文本, 模块x, 符号x) == 1) { 返回; }
    // 声明模块优先：派生类所在模块有同名类=唯一绑定（001 优先级① 遮蔽 ③）
    结果<整64, 整32> 查本 = 模块成员键基们.获取(模块成员键(本模块ID, 基名ID));
    如果 (查本.正常) {
        如果 (是用户类键基(查本.值)) { 返回; }
    }
    否则 {
    }
    整64 命中数 = 0;
    字符串 模块串 = "";
    整64 i = 0;
    当 (i < 全部模块ID们.大小()) {
        整64 模块m = 全部模块ID们.元素(整32(i));
        结果<整64, 整32> 查g = 模块成员键基们.获取(模块成员键(模块m, 基名ID));
        如果 (查g.正常) {
            如果 (是用户类键基(查g.值)) {
                // 可见性：跨模块裸名只经 ③ glob 引入公开项（001 §5.9.7）——本模块
                //   已有同名类时上方已优先返回；此处只统计**他模块公开类**。
                //   私有同名类不参与歧义（宿主 classes_ 按模块可见性过滤后无此项）。
                结果<整64, 整32> 查公g = 模块成员公开们.获取(
                    模块成员键(模块m, 基名ID));
                如果 (查公g.正常 && 查公g.值 == 1) {
                    命中数++;
                    // 首个候选直接落串，后续以 "/" 分隔（单边开区间禁令：双边界枚举）
                    如果 (命中数 == 1) {
                        模块串 = 字符串复制(驻留文本(模块m));
                    } 否则 如果 (命中数 >= 2 && 命中数 <= 全部模块ID们.大小()) {
                        模块串 = 字符串复制(模块串 + "/" + 字符串复制(驻留文本(模块m)));
                    }
                }
            }
        }
        否则 {
        }
        i++;
    }
    如果 (命中数 >= 2 && 命中数 <= 全部模块ID们.大小()) {
        表诊断(诊断, "[错误] 类 '" + 字符串复制(驻留文本(类名ID)) +
                     "' 的父类 '" + 基文本 + "' 在多个模块中定义（" + 模块串 +
                     "），无法确定父类——请将派生类声明在父类所在模块，或重命名父类");
    }
}
