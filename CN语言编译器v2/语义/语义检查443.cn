// 语义检查 443/539 族（#443 一元内置拒面 + #539 三件呈报收口——414 先例：
//   拒面族专用文件）：值位类型文本推导（函数名作值/指针补星/取地址）+变参
//   内置实参类型检查。宿主基准=checkFunctionNameValue/visitUnaryExpr 内置面/
//   checkVariadicBuiltinCall；消费方=语义检查重载.cn 检查一元重载使用点、
//   语义检查中.cn 检查三元运算表达式（经 检查条件布尔）、语义检查表达式.cn
//   检查调用表达式（内置返回挂点）。本文件原驻 语义检查表达式尾.cn（443/539
//   轮迁出防单文件超千行红线）。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（目录包名）
导入 IR;         // 容器/结果 合成名判定（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 443/539（414 审查呈报收口·宿主 checkFunctionNameValue 同构）：**函数名作值**
//   类型文本合成——标识符=函数名（签名表键基命中）=「函数指针<返回>(参数串)」
//   （480-a 合成约定·签名参数串逗号拼接无括号）；非函数名/无签名返回 ""。
//   值位口径唯一归属：表查找类型ID 对函数名给出的是返回类型（签名表把函数按
//   返回类型登记），值位推导不得复用（宿主 checkExpr 对函数名标识符走
//   checkFunctionNameValue 返回函数指针文本——253/539 拒绝面文案对齐依赖）。
函数 函数名指针文本(向量<映射<整64, 符号>>& 符号表, 整64 名ID) -> 字符串 {
    整64 键基443 = 三级键基查找(符号表, 名ID, 0 - 1);
    // 键基无效（-1 miss/-2 歧义）时签名表查询恒 miss=错误通道分流（无需前置 >=0 判定）
    结果<整64, 整32> 查数443 = 查函数签名个数(键基443);
    如果 (查数443.正常) {
        结果<整64, 整32> 签串443 = 查函数签名参数串(键基443 * 键位移);
        如果 (签串443.正常) {
            可选<整64> 签类型443查 = 全局层查类型(符号表,
                函数签名键(键基443, 驻留文本(签串443.值)));
            如果 (签类型443查.有值) {
                返回 "函数指针<" + 驻留文本(签类型443查.值) + ">(" +
                       驻留文本(签串443.值) + ")";
            }
        }
    }
    返回 "";
}

// 443/539：检查用「表达式类型文本」推导——宿主 checkExpr 类型名口径扩展：
//   标识符=函数名（签名表命中）→ 函数指针文本（函数名指针文本 先行）；指针
//   变量在 推导源类型文本 结果上补星（217 同款：符号表登记元素类型基名·
//   宿主 checkExpr 对指针标识符给出「整32*」——拒绝面文案对齐所需）；其余经
//   推导源类型文本（字面量精确/推导静默）。空串=检不出放行（诚实边界，
//   调用方判长度）。
函数 推导检查类型文本(向量<节点> 池, 整32 源末索引,
                  向量<映射<整64, 符号>>& 符号表) -> 字符串 {
    如果 (源末索引 < 0 || 源末索引 >= 整32(池.大小())) { 返回 ""; }
    节点 源末 = 池.元素(源末索引);
    如果 (源末.类型 == 节点_标识符) {
        字符串 fp文本443 = 函数名指针文本(符号表, 整64(源末.文本));
        如果 (字符串长度(fp文本443) > 0) { 返回 fp文本443; }
        字符串 标识文本443 = 推导源类型文本(池, 源末索引, 符号表, "");
        可选<整64> 指针查443 = 查语义指针变量(整64(源末.文本));
        // 独立布尔先行（调用形态在本句完成语义检查/决议登记——避免条件链内
        //   可选.有值 使后续调用操作数漏检致返回类型未登记）
        布尔 标识非数组443 = !是数组类型文本(标识文本443);
        如果 (字符串长度(标识文本443) > 0 &&
            指针查443.有值 &&
            标识非数组443 &&
            !字符串比较(字符串子串(标识文本443, 整32(字符串长度(标识文本443) - 1), 1), "*")) {
            标识文本443 = 字符串复制(标识文本443 + "*");
        }
        返回 标识文本443;
    }
    如果 (源末.类型 == 节点_取地址 && 源末.子终点 > 源末.子起点) {
        // 443：取地址 &x 结果=操作数类型+*（宿主 checkAddressOfUnary 同构；
        //   数组操作数沿 217/415 退化=元素类型+*；推导失败=空·诚实边界）
        字符串 基文本443 = 推导检查类型文本(池, 整32(源末.子终点 - 1), 符号表);
        如果 (字符串长度(基文本443) > 0) {
            如果 (是数组类型文本(基文本443)) {
                可选<字符串> 元素查443 = 数组元素文本(基文本443);
                如果 (元素查443.有值) { 基文本443 = 字符串复制(元素查443.值); }
            }
            返回 字符串复制(基文本443 + "*");
        }
        返回 "";
    }
    返回 推导源类型文本(池, 源末索引, 符号表, "");
}

// 443/539：调用位返回类型文本（条件检查调用分支用）——函数名指针文本 切出
//   返回段（"函数指针<返回>(参数)"：13 字节前缀 + 首个 '>' 前的字节扫描收口）。
//   判定安全：嵌套返回（结果<...>）切出文本非「布尔」=照拒（宿主同拒）；
//   非函数名/无签名返回 ""（调用方放行=诚实边界）。
函数 调用返回类型文本443(向量<映射<整64, 符号>>& 符号表, 整64 名ID) -> 字符串 {
    字符串 fp文本443 = 函数名指针文本(符号表, 名ID);
    如果 (字符串长度(fp文本443) == 0) { 返回 ""; }
    整64 长443 = 字符串长度(fp文本443);
    整64 扫443 = 13;
    当 (扫443 < 长443) {
        如果 ((整64(fp文本443[整32(扫443)]) & 255) == 62) { 中断; }   // '>'
        扫443++;
    }
    如果 (扫443 < 长443 && 扫443 > 13) {
        返回 字符串子串(fp文本443, 13, 整32(扫443 - 13));
    }
    返回 "";
}

// 443/539（253 呈报收口）：变参内置函数（打印/打印行/格式化）实参类型检查
//   ——宿主 checkVariadicBuiltinCall 同构（放行面 字符串/字符*/字符串* 与
//   数值族/布尔/字符/枚举；其余类型拒·诊断文案宿主逐字「打印行 参数类型不支持」
//   ——宿主对三内置共用该函数=同文案）。被调名判定在本函数内（非三内置即返·
//   调用方挂点保持单行）。实参类型经 推导检查类型文本（函数名=函数指针文本）；
//   空串=检不出放行（诚实边界·窄于宿主 checkExpr 全覆盖）。实参末位经
//   查调用实参末位 表（调用节点 子终点 恒 0 空闲位·343 同款）。
函数 检查变参打印实参(向量<节点> 池, 节点 n, 整32 调用节点索引,
                    向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    如果 (n.子起点 <= 0 || 整64(n.子起点) >= 池.大小()) { 返回; }
    节点 被调443 = 池.元素(整32(n.子起点));
    如果 (被调443.类型 != 节点_标识符) { 返回; }
    字符串 被调文本443 = 字符串复制(驻留文本(整64(被调443.文本)));
    如果 (!(字符串比较(被调文本443, "打印") || 字符串比较(被调文本443, "打印行") ||
          字符串比较(被调文本443, "格式化"))) { 返回; }
    整64 实参序443 = 0;
    当 (实参序443 < 整64(n.附加)) {
        整64 末位443 = 查调用实参末位(整64(调用节点索引), 实参序443);
        如果 (末位443 >= 0 && 末位443 < 整64(池.大小())) {
            字符串 实参文本443 = 推导检查类型文本(池, 整32(末位443), 符号表);
            如果 (字符串长度(实参文本443) > 0) {
                布尔 串面443 = 字符串比较(实参文本443, "字符串") ||
                              字符串比较(实参文本443, "字符*") ||
                              字符串比较(实参文本443, "字符串*");
                布尔 值面443 = 是宿主数值文本443(实参文本443) ||
                              字符串比较(实参文本443, "布尔") ||
                              字符串比较(实参文本443, "字符") ||
                              是枚举名(驻留(实参文本443));
                如果 (!串面443 && !值面443) {
                    表诊断(诊断, "[错误] 打印行 参数类型不支持：'" + 实参文本443 + "'");
                }
            }
        }
        实参序443++;
    }
}

// 553（#443 呈报分叉②·宿主 checkExpr 内置调用返回类型同构）：条件位内置函数
//   返回类型文本——`如果/当/循环/三元` 条件检查的用户签名表 miss 补查面。
//   数据源=IR 层 内置函数返回类型ID（828-a 起与宿主 semantic_builtins.cpp
//   regXxxFn 注册表逐字对齐·两级直查+标准库前缀归一基名）；仅覆盖其
//   「空类型/空类型* 按 整64 占位」项（IR 装载口径惯例·见 IR布局尾.cn 注释）：
//   宿主口径为空类型的 8 项 + 空类型* 的 1 项按宿主逐字返回（清单=宿主
//   semantic_builtins.cpp 对照：打印/打印行/运行时错误/内存::竞技场重置/
//   内存::释放全部/字符串构建器::追加/追加字节/弃置 → 空类型；内存::竞技场分配
//   → 空类型*）——条件文案与宿主零分叉（`如果(打印("x"))` 宿主拒「实际为
//   '空类型'」）。清单按**归一基名**判定（字符串构建器::追加 归一为 追加、
//   IO::打印 归一为 打印——导入改写产物与裸名同判）；该判定仅经
//   「内置函数返回类型ID 命中」后的名字（裸名 追加 等直查 miss 早退不达）。
//   空串=非内置（调用方放行=诚实边界）。
函数 内置条件返回文本553(整64 名ID) -> 字符串 {
    字符串 名553 = 字符串复制(驻留文本(名ID));
    整64 类型ID553 = 内置函数返回类型ID(名553);
    如果 (类型ID553 == 0) { 返回 ""; }
    字符串 归名553 = 内置归一基名(名553);
    如果 (字符串比较(归名553, "打印") || 字符串比较(归名553, "打印行") ||
         字符串比较(归名553, "运行时错误") ||
         字符串比较(归名553, "内存::竞技场重置") ||
         字符串比较(归名553, "内存::释放全部") ||
         字符串比较(归名553, "追加") ||
         字符串比较(归名553, "追加字节") ||
         字符串比较(归名553, "弃置")) {
        返回 "空类型";
    }
    如果 (字符串比较(归名553, "内存::竞技场分配")) { 返回 "空类型*"; }
    返回 字符串复制(驻留文本(类型ID553));
}

// 553（#443 呈报分叉①配套）：被调变量是否方法值变量（初始化来源追踪）——
//   宿主 genVarDecl 对「变量 cb = 对象.实例方法」登记 closureInfo_ 后
//   checkExpr 以可调用形态放行（1002/440 合法形态）；v2 方法值变量类型登记=
//   方法**返回类型**（480 fnptr 判定 miss）→ 553 非函数被调检查须按初始化
//   来源识别豁免。判据=全池扫描目标索引前**最近**同名 节点_变量声明（源码
//   顺序=池序·同域遮蔽近者胜；跨函数同名天然被「声明索引 < 目标索引」过滤
//   ——先定义函数先入池，后函数体内声明的干扰者只可能在前者域内且索引更小，
//   而后者域内有自己的声明必在调用点之前=近者命中）：
//   初始化末端=节点_成员 → 复用 实参是绑定方法值806（宿主 argIsBoundMethodValue
//   同构判据——用户类实例方法且有参∪构造∪析构；无参方法作值宿主不置位=
//   照拒·p23 实证同文）；初始化末端=标识符 → 递归（拷贝链「变量 cb2 = cb」
//   1002 ⑥形态·深度上限 8 防环）。无声明/其余初值形态=假（照报「无法调用
//   非函数类型」——分叉①坏样本面不受影响）。
函数 是方法值变量553(向量<节点> 池, 整64 名ID, 整64 目标索引,
                向量<映射<整64, 符号>>& 符号表, 整64 深度553) -> 布尔 {
    如果 (深度553 > 8) { 返回 假; }
    整64 命中位553 = 0 - 1;
    整64 扫553 = 0;
    当 (扫553 < 整64(池.大小()) && 扫553 < 目标索引) {
        节点 d553 = 池.元素(整32(扫553));
        如果 (d553.类型 == 节点_变量声明 && 整64(d553.文本) == 名ID &&
            整64(d553.子终点) > 整64(d553.子起点)) {
            命中位553 = 扫553;   // 取目标之前最近者
        }
        扫553++;
    }
    如果 (命中位553 < 0) { 返回 假; }
    节点 d553 = 池.元素(整32(命中位553));
    整64 初末位553 = 整64(d553.子终点) - 1;
    如果 (初末位553 < 0 || 初末位553 >= 整64(池.大小())) { 返回 假; }
    节点 初末553 = 池.元素(整32(初末位553));
    如果 (初末553.类型 == 节点_成员) {
        返回 实参是绑定方法值806(池, 整32(初末位553), 符号表);
    }
    如果 (初末553.类型 == 节点_标识符) {
        返回 是方法值变量553(池, 整64(初末553.文本), 命中位553, 符号表,
                          深度553 + 1);
    }
    返回 假;
}


