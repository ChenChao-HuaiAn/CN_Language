// CN 自举编译器 v2 · 语义检查溢出474（L2 冻结线拆分·自 语义检查中.cn 纯机械搬移·
//   零语义变化：三函数体=原内联块逐字迁移·调用点=语义检查中 检查二元运算表达式 薄委托）
// 职责：编译期常量检查族——①常量除零（575-a 原面·T100/422 对齐宿主 T8）
//   ②474 常量算术溢出预演（宿主 checkConstIntExprSafety 同构·含 MIN/-1 除法面）
//   ③474 常量移位量超宽（宿主 checkShiftConstWidth 同构·值∉[0,左域位宽) 全拒；
//   1185 左宽推导三通道单点 移位左操作数位宽474——语义类型主路径全形态闭合
//   六族缺口〔三元/函数调用/下标/成员/方法调用/算术嵌成员〕+词法白名单/窗口
//   双兜底）。
// 依赖：语义检查初始化（取常量下标值）/语义分析中（表查找类型ID）/协议常量
//   （位模式取负474）/语法（节点_*）——语义包内合并池解析。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（目录包名）
导入 IR;         // 容器/结果 合成名判定 + 节点_*/键位移 常量（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包（位模式取负474）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 582（604 并案）：编译期溢出诊断「字面量参与域」提示句——481 立法
//   （001 §3.7/§3.7a）后字面量恒按另一侧操作数类型参与·与赋值目标域解耦
//   （`整32 和 = 甲 + 1`/`整64 大 = 2147483647 + 1` 新手困惑「1 明明按更宽
//   域算」而实报字面量恒定级域）。本函数在 INT_MIN÷-1 与通用溢出四处消费；
//   宿主 semantic_expr_binary.cpp kLiteralDomainHint582 逐字同源（零分叉）。
函数 溢出字面量参与域提示582() -> 字符串 {
    返回 "。字面量按另一侧操作数类型参与·与赋值目标域解耦（001 §3.7/§3.7a）";
}

// 505（G1·501 采样轮）：子树常量折叠递归——后序池根索引驱动（宿主
//   foldConstIntExpr505 同构·预演面专用纯函数零副作用）。
//   背景：预演三函数旧取值通道只认 ≤2 节点字面量窗（取常量下标值），嵌套折叠
//   形态 ((30000+30000)*30000000)、甲<<(700+66)、折叠零 10/(5-5)、负零 10/(-0)
//   双侧一致漏编译期检查（运行期错误码 8 兜底）——预演发生在折叠之前。
//   修法=子树先递归折叠出常量闭包再按域预演（检查提前+精确·不改变运行期
//   兜底语义：折叠失败〔变量/中间溢出/除零/移位越域〕返回 假=保持现状走
//   运行期错误码；错误形态由该子表达式自身节点的预演报告——检查二元运算
//   表达式 逐节点递归遍历，无遗漏面）。
//   根索引驱动（484 实证契约·勿用 子起点=左起点 旧述——普通面 附加=子起点=
//   右起点两口径等价，左区间起点无字段可靠记录）：二元节点 附加=右起点、
//   右子树根=自身索引-1、左子树根=附加-1、子终点恒 0（短路标注 子终点≠0
//   区分）；负号节点 操作数区间=[子起点, 子终点)、子终点=自身索引
//   （协议常量.cn 节点注释·解析层_子 建节点契约）。
函数 折叠子树值505(向量<节点> 池, 整32 根索引, 整64& 值, 整32 深度) -> 布尔 {
        如果 (深度 > 64 || 根索引 <= 0 || 根索引 >= 整32(池.大小())) { 返回 假; }
        节点 根n505 = 池.元素(根索引);
        // 叶：字面量（复用 取常量下标值 单点解析——含 18+ 位巨字面量保护）
        如果 (根n505.类型 == 节点_整数字面量) {
            返回 取常量下标值(池, 根索引, 根索引 + 1, 值);
        }
        // 一元负：操作数根=自身索引-1（子终点=自身索引·解析契约；子起点=操作数起点作守卫）
        如果 (根n505.类型 == 节点_负号) {
            整64 操作数505 = 0;
            如果 (根n505.子起点 <= 0 || 根n505.子终点 != 根索引 ||
                 !折叠子树值505(池, 根索引 - 1, 操作数505, 深度 + 1)) { 返回 假; }
            值 = 位模式取负474(操作数505);   // 两补码回绕（MIN 取负=自身·宿主同口径）
            返回 真;
        }
        // 普通二元（子终点恒 0 与短路区分）：右子树根=自身-1、左子树根=附加-1
        如果 (根n505.类型 == 节点_二元运算 && 根n505.子终点 == 0) {
            字符串 op505 = 字符串复制(驻留文本(整64(根n505.文本)));
            布尔 是折叠符505 = 字符串比较(op505, "+") || 字符串比较(op505, "-") ||
                           字符串比较(op505, "*") || 字符串比较(op505, "/") ||
                           字符串比较(op505, "%") || 字符串比较(op505, "<<") ||
                           字符串比较(op505, ">>");
            如果 (!是折叠符505) { 返回 假; }
            整64 左值505 = 0;
            整64 右值505 = 0;
            如果 (根n505.附加 <= 0 || 根n505.附加 >= 整64(根索引)) { 返回 假; }
            如果 (!折叠子树值505(池, 整32(根n505.附加) - 1, 左值505,
                                深度 + 1)) { 返回 假; }
            如果 (!折叠子树值505(池, 根索引 - 1, 右值505, 深度 + 1)) { 返回 假; }
            返回 折叠二元应用505(op505, 左值505, 右值505, 值);
        }
        返回 假;
}

// 505：折叠二元应用（int64 安全闭包——宿主 foldConstIntExpr505 运算面同构）：
//   中间溢出/除零/INT_MIN÷-1/移位量越 [0,63] 域/负值左移=假（不可折叠——
//   这些形态各自的节点级编译期检查〔除零/INT_MIN÷-1 溢出/移位量超宽〕已按
//   现状口径覆盖，折叠不与之竞争）。溢出条件检测（hi-vR 技巧）保证过检后
//   普通运算良定义。
函数 折叠二元应用505(字符串 op505, 整64 左值505, 整64 右值505, 整64& 值) -> 布尔 {
        如果 (字符串比较(op505, "+")) {
            如果 ((右值505 > 0 && 左值505 > 9223372036854775807 - 右值505) ||
                 (右值505 < 0 && 左值505 < 0 - 9223372036854775807 - 1 - 右值505)) {
                返回 假;
            }
            值 = 回绕加64(左值505, 右值505);
            返回 真;
        }
        如果 (字符串比较(op505, "-")) {
            如果 ((右值505 < 0 && 左值505 > 9223372036854775807 + 右值505) ||
                 (右值505 > 0 && 左值505 < 0 - 9223372036854775807 - 1 + 右值505)) {
                返回 假;
            }
            值 = 左值505 - 右值505;
            返回 真;
        }
        如果 (字符串比较(op505, "*")) {
            // 乘预演：绝对值按正64 域（位模式取负474 处理 MIN 补码·474 同款）
            正64 绝左505 = 左值505 >= 0 ? 正64(左值505) : 正64(位模式取负474(左值505));
            正64 绝右505 = 右值505 >= 0 ? 正64(右值505) : 正64(位模式取负474(右值505));
            正64 域绝505 = 9223372036854775807;
            如果 (左值505 < 0 != 右值505 < 0) {
                域绝505 = 正64(位模式取负474(0 - 9223372036854775807 - 1));  // |MIN|=2^63
            }
            如果 (绝左505 != 0 && 绝右505 != 0 &&
                 (绝左505 > 域绝505 / 绝右505 || 绝左505 * 绝右505 > 域绝505)) {
                返回 假;
            }
            值 = 左值505 * 右值505;
            返回 真;
        }
        如果 (字符串比较(op505, "/") || 字符串比较(op505, "%")) {
            如果 (右值505 == 0) { 返回 假; }
            如果 (左值505 == 0 - 9223372036854775807 - 1 && 右值505 == 0 - 1) { 返回 假; }
            如果 (字符串比较(op505, "/")) { 值 = 左值505 / 右值505; } 否则 { 值 = 左值505 % 右值505; }
            返回 真;
        }
        如果 (字符串比较(op505, "<<")) {
            如果 (左值505 < 0 || 右值505 < 0 || 右值505 > 62) { 返回 假; }
            // 左值≥0 守卫已过：整64 同符号比较（防 正64×整64 混合符号拒）
            如果 (左值505 > (9223372036854775807 >> 右值505)) { 返回 假; }
            值 = 左值505 << 右值505;
            返回 真;
        }
        如果 (字符串比较(op505, ">>")) {
            如果 (右值505 < 0 || 右值505 > 63) { 返回 假; }
            值 = 左值505 >> 右值505;
            返回 真;
        }
        返回 假;
}

// 1185（2026-10-20·1020 采样轮）：类型名文本→位宽映射单一归属（自 标识符
//   类型位宽474 拆出）——语义类型主路径（表达式类型ID 产物）与词法兜底通道
//   （表查找产物）共用本映射，防两处漂移。整数族五档 8/16/32/64/128（布尔=8
//   既有口径）；类型未登记（空文本）=无值推不出；非整数族（指针/容器/浮点等·
//   移位面语义层 412 守卫另拒）=某些(64) 保既有族外口径（闭集穷举：整数族五档 +
//   族外兜底=既有验收行为·非新 miss 面）。1541 B2：结果化——有值=位宽/无值=空文本。
函数 类型文本位宽474(字符串 名474) -> 可选<整64> {
    如果 (字符串长度(名474) == 0) { 返回 无; }
    如果 (字符串比较(名474, "整8") || 字符串比较(名474, "正8") ||
        字符串比较(名474, "布尔")) { 返回 某些(8); }
    如果 (字符串比较(名474, "整16") || 字符串比较(名474, "正16")) { 返回 某些(16); }
    如果 (字符串比较(名474, "整32") || 字符串比较(名474, "正32")) { 返回 某些(32); }
    如果 (字符串比较(名474, "整64") || 字符串比较(名474, "正64")) { 返回 某些(64); }
    如果 (字符串比较(名474, "整128") || 字符串比较(名474, "正128")) {
        返回 某些(128);   // 474 验收：128 位域真实位宽（原回落 64=542 dual 红根治）
    }
    返回 某些(64);   // 非整数族兜底（指针/字符串等移位面语义层另拒）
}

// 580（定形·636 同族漏网）：标识符声明类型→位宽——查符号表类型ID 后经
//   类型文本位宽474 映射（宿主 checkShiftConstWidth width 提取闭集同构）；
//   未找到（-1·未声明面其它通道报）=无值表示推不出；1185 起映射段单点化
//   （与语义主路径共用·防两处映射漂移）。1541 B2：结果化（有值=位宽）。
函数 标识符类型位宽474(向量<映射<整64, 符号>>& 符号表, 整64 名字ID) -> 可选<整64> {
    整64 类型ID474 = 0;
    可选<整64> 类型ID474查 = 表查找类型ID(符号表, 名字ID);
    如果 (类型ID474查.有值) { 类型ID474 = 类型ID474查.值; }
    // 原 <=0 判定：miss 与登记值 0 同走「推不出」路径（880 批5 显式保留）
    如果 (!类型ID474查.有值 || 类型ID474 == 0) { 返回 无; }
    返回 类型文本位宽474(字符串复制(驻留文本(类型ID474)));
}

// 1185（2026-10-20·1020 采样轮）：移位左操作数位宽推导单点（自 检查常量移位
//   超宽474 内联左宽块机械抽出·函数 ≤100 行纪律·三通道单一归属）。
//   ①主路径=语义类型：表达式类型ID（语义期表达式类型权威推导·宿主
//   visitBinaryExpr 首行 checkExpr(left) 递归产物 leftType 同位）——成员/二元
//   走专用推导、负号/位非保型递归、调用/下标/三元经 检查表达式 精确推导=
//   全形态可得。修前左宽=词法形态白名单（折叠子树类型宽474：整数字面量/
//   标识符/负号/位非/二元算术位运算五形态）——白名单外形态实测六族（三元/
//   函数调用/下标/成员/方法调用/算术嵌成员）递归返 0、窗口通道亦不可辨 →
//   左宽 0 整条跳过放行，宿主按语义类型全形态可判=放行分叉（1020 采样轮·
//   CN-Smith 20261019+20261020 两轮连中 (条件?甲:乙)>>33 同一样本·宿主错误
//   码 8 编译期拒 vs v2 rc=0）。诊断经静默缓冲吸收（174 教训惯例：二次推导
//   诊断吞弃·语句根区间遍历=权威诊断点·609/414 同款先例）。
//   ②词法白名单兜底（636 折叠子树类型宽474 递归）：语义推导 miss 面的现状
//   行为零变化；③窗口通道（502 循环左扩字面量/标识符/负号链）：再兜底。
//   三通道序不变既有验收口径：共同覆盖面（五白名单形态）位宽与修前一致
//   （字面量后缀定级/标识符查表映射同构单点），六族缺口由主路径闭合。
函数 移位左操作数位宽474(向量<节点> 池, 节点 n, 整32 节点索引,
                   向量<映射<整64, 符号>>& 符号表) -> 可选<整64> {
    整64 左宽474 = 0;
    // ①1185 主路径：语义类型推导（命中即定宽——整数族真实位宽/非整数族 64
    //   族外既有口径）
    如果 (n.附加 > 0 && n.附加 < 整64(节点索引)) {
        向量<字符串> 静默诊断1185 = 向量<字符串>();
        可选<整64> 左类查1185 = 表达式类型ID(池, 整32(n.附加 - 1), 符号表, 静默诊断1185);
        // 880 批5：结果化两态分流（有值=类型 ID——原 0/-1 miss 哨兵统一归无值）
        如果 (左类查1185.有值) {
            // 1541 B2：`.值` 先落普通整64 局部（CN 强制：.值 只在 .有值 语句真分支）
            整64 左类1185 = 左类查1185.值;
            可选<整64> 位宽查1185 = 类型文本位宽474(字符串复制(驻留文本(左类1185)));
            如果 (位宽查1185.有值) { 左宽474 = 位宽查1185.值; }
        }
    }
    // 位宽判定：0=本通道推不出落下一通道·非 0=定宽即返回消费（位宽恒非负）
    如果 (左宽474 != 0) { 返回 某些(左宽474); }
    // ②636：左宽推=折叠子树**类型宽**后序递归；580 起标识符叶可推（表查找
    //   声明类型位宽）——变量参与的复合子树（(甲+乙)/负号链/嵌套）整体可推；
    //   推不出（未声明/非整数族递归失败）=0 落窗口通道。1185 起降格语义
    //   miss 兜底（词法白名单五形态近似——白名单外形态已由主路径闭合）。
    整64 左宽推636 = 0;
    如果 (n.附加 > 0 && n.附加 < 整64(节点索引)) {
        可选<整64> 左宽推636查 = 折叠子树类型宽474(池, 整32(n.附加) - 1, 0, 符号表);
        如果 (左宽推636查.有值) { 左宽推636 = 左宽推636查.值; }
    }
    如果 (左宽推636 > 0) {
        // 636：左宽=折叠子树类型宽——对齐宿主 checkShiftConstWidth 的
        //   leftType 语义类型口径（字面量后缀恒定级·无后缀恒整32 /
        //   负号保型 / 二元两操作数公共类型取较宽）。
        返回 某些(左宽推636);
    }
    // ③窗口通道（502 审查 P1-1）：窗起节点仍为负号则继续左扩直到取到实
    //   节点——-(-5)<<100 池布局 5,内负,外负,<<,100，首轮单步左扩取到内层
    //   负号（非字面量非标识符）→ 左宽 0 跳过放行。580 收口后本通道服务
    //   纯字面量/标识符/负号链形态（①②双 miss 后的兜底互补）。
    整64 左末索引474 = 整64(n.附加) - 1;
    如果 (左末索引474 > 0 && 左末索引474 < 整64(池.大小())) {
        整64 左窗起s474 = 左末索引474;
        当 (左窗起s474 > 0 &&
            池.元素(整32(左窗起s474)).类型 == 节点_负号) {
            左窗起s474 = 左窗起s474 - 1;
        }
        如果 (左窗起s474 > 0 && 左窗起s474 < 整64(池.大小())) {
            节点 左实s474 = 池.元素(整32(左窗起s474));
            如果 (左实s474.类型 == 节点_整数字面量) {
                // 后缀定宽（502 审查 P1-2·宿主 literalTypeOf 同构）
                左宽474 = 字面量后缀位宽474(
                    字符串复制(驻留文本(整64(左实s474.文本))));
            } 否则 如果 (左实s474.类型 == 节点_标识符) {
                // 580：位宽映射收敛 标识符类型位宽474（单一归属）；miss=无值
                // 跳过（未声明面其它通道报）。
                可选<整64> 左宽查s474 = 标识符类型位宽474(符号表, 整64(左实s474.文本));
                如果 (左宽查s474.有值) { 左宽474 = 左宽查s474.值; }
            }
        }
    }
    // 上游已诊断：三通道全 miss=左操作数类型语义期未推导（未声明
    //   标识符等畸形面·检查标识符表达式上游已报错，诊断收尾中止不产物）——
    //   移位检查跳过不构成放行新面（宿主 leftType=="未知" 同口径跳过）。
    返回 无;
}

// 636（2026-10-14·505 折叠通道左宽定宽口径对齐宿主·636 修复）：折叠子树
//   「类型宽」后序递归推导——返回位宽（32/64/128）或 0（推不出）。
//   背景：宿主 checkShiftConstWidth 左宽取自**语义类型**（visitIntegerLiteral
//   恒后缀恒定级·无后缀恒整32；表达式面 commonNumericType 宽化；移位结果
//   类型=左操作数类型）。505 折叠通道原对无后缀超域字面量/折叠形态按折叠值
//   提升定宽（超 int32 域→64）——3000000000>>40 宿主按语义类型整32 拒
//   （40≥32）而 v2 按折叠值 64 放行（40<64）=实测放行分叉（636 探针矩阵：
//   正/负/折叠加零/左移/右移五形态）。修法=本函数与宿主左类型推导逐形同构：
//   字面量→后缀恒定级（无后缀/U=32·L/UL=64·LL/ULL=128）；负号/位非→操作数
//   （一元保型·宿主 semantic_expr_unary Subtract/Tilde 节 lastType_=operandType
//   同构）；二元（算术/位
//   运算/移位）→两操作数取较宽侧（宿主 checkBitwiseBinary/commonNumericType
//   「两操作数公共整数类型」实读同构——★移位亦为公共类型非左操作数：
//   (3000000000<<2L)>>40 宿主按公共整64 放行，取左会误拒·e15 实测）；
//   其余（比较/逻辑/非常量形态）→ 0（落窗口通道=诚实边界）。指针结构与
//   折叠子树值505 同构（二元 附加=右起点·右根=自身-1·左根=附加-1；
//   负号 子终点=自身索引·操作数根=自身-1）。
// 580（2026-10-15·核验 p580 定形）：标识符分支补齐——「一元负号+括号复合」
//   形态 (-(甲+乙))<<40 原递归止于复合子树的标识符叶（无分支→0）→落窗口通道
//   （左扩停于运算符节点→左宽 0）→整体放行，而宿主按语义类型（变量声明整32）
//   拒=放行分叉（运行期硬件取模 40&31 静默错值 -2048 实录）。修=标识符→
//   表查找类型ID→位宽（标识符类型位宽474 单一归属）——(甲+乙)/负号链/嵌套
//   复合全形态经递归自然覆盖；查不到类型仍落 0=诚实边界（未声明面其它通道报）。
函数 折叠子树类型宽474(向量<节点> 池, 整32 根索引, 整32 深度,
                 向量<映射<整64, 符号>>& 符号表) -> 可选<整64> {
        如果 (深度 > 64 || 根索引 <= 0 || 根索引 >= 整32(池.大小())) { 返回 无; }
        节点 根t636 = 池.元素(根索引);
        如果 (根t636.类型 == 节点_整数字面量) {
            返回 某些(字面量后缀位宽474(字符串复制(驻留文本(整64(根t636.文本)))));
        }
        // 580：标识符→声明类型位宽（符号表查询；miss=无值 推不出）
        如果 (根t636.类型 == 节点_标识符) {
            返回 标识符类型位宽474(符号表, 整64(根t636.文本));
        }
        如果 (根t636.类型 == 节点_负号) {
            如果 (根t636.子起点 <= 0 || 根t636.子终点 != 根索引) { 返回 无; }
            返回 折叠子树类型宽474(池, 根索引 - 1, 深度 + 1, 符号表);
        }
        // 580 同族收口：位非→操作数保型（宿主 semantic_expr_unary Tilde 节
        //   lastType_=operandType 同构·「'~'按位非要求整数」守卫后不再分叉）
        //   ——(~(甲+乙))<<40 原同族漏网（宿主按保型整32 拒 / v2 止于位非叶
        //   放行·运行期硬件取模静默错值）。
        如果 (根t636.类型 == 节点_位非) {
            如果 (根t636.子起点 <= 0 || 根t636.子终点 != 根索引) { 返回 无; }
            返回 折叠子树类型宽474(池, 根索引 - 1, 深度 + 1, 符号表);
        }
        如果 (根t636.类型 == 节点_二元运算 && 根t636.子终点 == 0) {
            如果 (根t636.附加 <= 0 || 根t636.附加 >= 整64(根索引)) { 返回 无; }
            可选<整64> 左宽查t636 = 折叠子树类型宽474(池, 整32(根t636.附加) - 1,
                                                    深度 + 1, 符号表);
            整64 左宽t636 = 0;
            如果 (左宽查t636.有值) { 左宽t636 = 左宽查t636.值; }
            如果 (!左宽查t636.有值 || 左宽t636 == 0) { 返回 无; }
            字符串 opt636 = 字符串复制(驻留文本(整64(根t636.文本)));
            如果 (字符串比较(opt636, "+") || 字符串比较(opt636, "-") ||
                字符串比较(opt636, "*") || 字符串比较(opt636, "/") ||
                字符串比较(opt636, "%") || 字符串比较(opt636, "<<") ||
                字符串比较(opt636, ">>") || 字符串比较(opt636, "&") ||
                字符串比较(opt636, "|") || 字符串比较(opt636, "^")) {
                可选<整64> 右宽查t636 = 折叠子树类型宽474(池, 根索引 - 1, 深度 + 1,
                                                        符号表);
                整64 右宽t636 = 0;
                如果 (右宽查t636.有值) { 右宽t636 = 右宽查t636.值; }
                如果 (!右宽查t636.有值 || 右宽t636 == 0) { 返回 无; }
                返回 某些(左宽t636 > 右宽t636 ? 左宽t636 : 右宽t636);   // 宽化取较宽侧
            }
            返回 无;   // 比较/逻辑等非整型结果（移位面整型守卫另拒）
        }
        返回 无;
}

// 548 辅助：整数族类型文本判定（宿主 types::isInteger 同构）——548 零值种子表
//   登记面类型前提（浮点/布尔/指针等不参与除零定性面）。
函数 是整数类型文本548(字符串 类型文本548) -> 布尔 {
    返回 字符串比较(类型文本548, "整8") || 字符串比较(类型文本548, "正8") ||
         字符串比较(类型文本548, "整16") || 字符串比较(类型文本548, "正16") ||
         字符串比较(类型文本548, "整32") || 字符串比较(类型文本548, "正32") ||
         字符串比较(类型文本548, "整数") || 字符串比较(类型文本548, "整64") ||
         字符串比较(类型文本548, "正64") || 字符串比较(类型文本548, "整128") ||
         字符串比较(类型文本548, "正128");
}

// 548（编译期除零·常量传播面·宿主 cnFoldConstIntExpr505 常量名解析参数同构）：
//   折叠子树值505 的常量名感知版——节点_标识符 分支经符号表种类判定（==符号_常量）
//   查顶层常量值表（语义层登记设施·查顶层常量值）折叠为整值；变量/未知=不可折叠。
//   遮蔽守卫天然成立：表查找种类 按作用域查序（内层先）——局部变量遮蔽顶层常量
//   时种类=变量≠常量→不折叠（宿主 resolveConstNameValue 584-a 守卫同口径）。
//   仅服务除零定性通道（检查常量除零474·548 变量零初值登记位）——溢出预演/
//   移位量通道维持 505 旧口径不扩面（宿主同款：折叠器常量名解析仅除零通道开启）。
//   多义/前向引用常量=查值失败=不可折叠放行（保守漏报·宿主同口径）。
函数 折叠子树值548(向量<节点> 池, 整32 根索引, 整64& 值, 整32 深度,
                向量<映射<整64, 符号>>& 符号表) -> 布尔 {
    如果 (深度 > 64 || 根索引 <= 0 || 根索引 >= 整32(池.大小())) { 返回 假; }
    节点 根n548 = 池.元素(根索引);
    // 叶：字面量（复用 取常量下标值 单点解析——含 18+ 位巨字面量保护）
    如果 (根n548.类型 == 节点_整数字面量) {
        返回 取常量下标值(池, 根索引, 根索引 + 1, 值);
    }
    // 548 叶：常量名（符号表种类=常量 且 值表命中 → 整值；否则不可折叠）
    如果 (根n548.类型 == 节点_标识符) {
        可选<整64> 根种548查 = 表查找种类(符号表, 整64(根n548.文本));
        如果 (根种548查.有值 && 根种548查.值 == 符号_常量) {
            返回 查顶层常量值(整64(根n548.文本), 值);
        }
        返回 假;
    }
    // 一元负：操作数根=自身索引-1（子终点=自身索引·解析契约；子起点=操作数起点作守卫）
    如果 (根n548.类型 == 节点_负号) {
        整64 操作数548 = 0;
        如果 (根n548.子起点 <= 0 || 根n548.子终点 != 根索引 ||
             !折叠子树值548(池, 根索引 - 1, 操作数548, 深度 + 1, 符号表)) { 返回 假; }
        值 = 位模式取负474(操作数548);   // 两补码回绕（MIN 取负=自身·宿主同口径）
        返回 真;
    }
    // 普通二元（子终点恒 0 与短路区分）：右子树根=自身-1、左子树根=附加-1
    如果 (根n548.类型 == 节点_二元运算 && 根n548.子终点 == 0) {
        字符串 op548 = 字符串复制(驻留文本(整64(根n548.文本)));
        布尔 是折叠符548 = 字符串比较(op548, "+") || 字符串比较(op548, "-") ||
                       字符串比较(op548, "*") || 字符串比较(op548, "/") ||
                       字符串比较(op548, "%") || 字符串比较(op548, "<<") ||
                       字符串比较(op548, ">>");
        如果 (!是折叠符548) { 返回 假; }
        整64 左值548 = 0;
        整64 右值548 = 0;
        如果 (根n548.附加 <= 0 || 根n548.附加 >= 整64(根索引)) { 返回 假; }
        如果 (!折叠子树值548(池, 整32(根n548.附加) - 1, 左值548,
                            深度 + 1, 符号表)) { 返回 假; }
        如果 (!折叠子树值548(池, 根索引 - 1, 右值548, 深度 + 1, 符号表)) { 返回 假; }
        返回 折叠二元应用505(op548, 左值548, 右值548, 值);
    }
    返回 假;
}

// 548：写位右值分级登记（宿主 noteZeroAssign 同构·声明位/赋值位共用）——
//   折叠成功（含常量名解析）→ 值==0 种子／值!=0 失格；标识符变量=传播边；
//   其余（调用/非常量运算）=失格。v2 复合赋值经脱糖重析合成二元到达赋值位=
//   右值为二元节点（含目标自身）→ 折叠失败且非标识符 → 失格（宿主显式
//   复合赋值失格分支同口径·`甲 += 0` 不误种子）。
不安全 函数 登记零值右值548(向量<节点> 池, 整64 名ID, 整32 右值索引,
                     向量<映射<整64, 符号>>& 符号表) -> 空类型 {
    如果 (右值索引 < 0 || 右值索引 >= 整32(池.大小())) { 返回; }
    整64 折值548 = 0;
    如果 (折叠子树值548(池, 右值索引, 折值548, 0, 符号表)) {
        如果 (折值548 == 0) {
            登记零值种子(名ID);
        } 否则 {
            登记零值失格(名ID);
        }
        返回;
    }
    节点 右末548 = 池.元素(右值索引);
    如果 (右末548.类型 == 节点_标识符) {
        登记零值边(名ID, 整64(右末548.文本));
        返回;
    }
    登记零值失格(名ID);
}

// 常量除零（575-a·T100·422 对齐宿主 T8）：除/余 右操作数折叠为零 编译期拒绝
//   548 扩面（签名加符号表）：①折叠通道升级为 折叠子树值548（常量名参与——
//   顶层常量名/常量名折叠式均进定性面·001 §1.1a① 常量传播后续波）；②右子树
//   折叠失败且为裸标识符变量 → 零值使用点登记（零值种子表收尾统一判定）。
函数 检查常量除零474(向量<节点> 池, 节点 n, 整32 节点索引, 字符串 op文本,
                向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
        // 575-a（T100·422 对齐宿主 T8）：编译期常量除零——除/余 右操作数
        //   折叠为零时编译期拒绝（宿主 checkConstIntExprSafety 折叠通道同款；
        //   负测 422 锚）。右操作数窗口=[附加, 本节点索引)（970 布局契约）。
        //   505：取值通道升级——旧 右末端字面量直判（单字面量 0 形态）扩为
        //   递归窗口折叠（折叠零 10/(5-5)/负零 10/(-0) 由此覆盖；单字面量 0
        //   走折叠同报=旧口径零回归；折叠失败=非常量除数→保持现状走运行期
        //   运行时错误 1 兜底）。
        如果 (字符串比较(op文本, "/") || 字符串比较(op文本, "%")) {
            整64 右除值505 = 0;
            如果 (节点索引 >= 2 &&
                 折叠子树值548(池, 节点索引 - 1, 右除值505, 0, 符号表) &&
                 右除值505 == 0) {
                表诊断(诊断, "[错误] 编译期除零：常量表达式除数为零（运行期除零已有运行时错误 1）");
            } 否则 如果 (节点索引 >= 2) {
                // 548：变量零初值面——右子树裸标识符且非常量名（折叠失败）→
                //   使用点登记（是否恒零由种子表收尾不动点统一判定·宿主同构）
                节点 右末548 = 池.元素(节点索引 - 1);
                可选<整64> 右种548查 = 表查找种类(符号表, 整64(右末548.文本));
                // miss（原 -1 哨兵）≠ 符号_常量 → 按「非常量」登记（显式默认）
                布尔 右末非常量548 = 真;
                如果 (右种548查.有值) {
                    右末非常量548 = 右种548查.值 != 符号_常量;
                }
                如果 (右末548.类型 == 节点_标识符 && 右末非常量548) {
                    整64 符548 = 1;
                    如果 (字符串比较(op文本, "%")) { 符548 = 2; }
                    登记零值使用点(整64(右末548.文本), 整64(取当前诊断行()), 符548);
                }
            }
        }
}

// 503（宿主 semantic_expr_binary.cpp constIntFoldValue503 同构）：编译期整数
//   折叠求值——根驱动递归（后缀池）：整数字面量（十进制/0x/负前导文本·
//   取常量下标值 单节点窗解析）/负号（子区间 [子起点, 子终点) 根递归取负·
//   解析层 前缀负号 建节点契约）/**二元运算 + - * / %**（左根=附加-1·右根=
//   本索引-1·递归折叠）。域=整64 全域；加减乘中途溢出、除零中途、整MIN/-1、
//   MIN 一元取负、超深嵌套=不可折叠（返回 假——消费点放行交运行期错误 1
//   兜底·诚实边界同宿主）。常量名/变量常量初值=常量传播面（001 §1.1a①
//   「随常量折叠后续波」·另案立项）不在此面。仅服务除零定性（值==0 判定）。
函数 折叠整值503(向量<节点> 池, 整32 根索引, 整64& 值, 整32 深度) -> 布尔 {
    值 = 0;
    如果 (深度 > 64) { 返回 假; }
    如果 (根索引 < 0 || 根索引 >= 整32(池.大小())) { 返回 假; }
    节点 根503 = 池.元素(根索引);
    如果 (根503.类型 == 节点_整数字面量) {
        返回 取常量下标值(池, 根索引, 整32(根索引 + 1), 值);
    }
    如果 (根503.类型 == 节点_负号) {
        // 前缀负号建节点契约：子起点=操作数起点、子终点=操作数末+1
        如果 (根503.子起点 <= 0 || 根503.子终点 <= 根503.子起点 ||
             根503.子终点 > 整32(池.大小())) { 返回 假; }
        整64 操作数503 = 0;
        如果 (!折叠整值503(池, 整32(根503.子终点 - 1), 操作数503, 深度 + 1)) { 返回 假; }
        如果 (操作数503 == 0 - 9223372036854775807 - 1) { 返回 假; }  // MIN 取负域外不折叠
        值 = 0 - 操作数503;
        返回 真;
    }
    如果 (根503.类型 == 节点_二元运算) {
        字符串 op503 = 字符串复制(驻留文本(整64(根503.文本)));
        布尔 认算503 = 字符串比较(op503, "+") || 字符串比较(op503, "-") ||
                    字符串比较(op503, "*") || 字符串比较(op503, "/") ||
                    字符串比较(op503, "%");
        如果 (!认算503) { 返回 假; }
        // 后缀池二元契约：右根=本索引-1（紧邻）·左根=附加-1（附加=右操作数起点）
        整32 右根503 = 根索引 - 1;
        整32 左根503 = 整32(根503.附加) - 1;
        如果 (右根503 < 0 || 左根503 < 0 || 左根503 >= 右根503) { 返回 假; }
        整64 左值503 = 0;
        整64 右值503 = 0;
        如果 (!折叠整值503(池, 左根503, 左值503, 深度 + 1)) { 返回 假; }
        如果 (!折叠整值503(池, 右根503, 右值503, 深度 + 1)) { 返回 假; }
        如果 (字符串比较(op503, "+")) {
            如果 ((右值503 > 0 && 左值503 > 9223372036854775807 - 右值503) ||
                 (右值503 < 0 && 左值503 < 0 - 9223372036854775807 - 1 - 右值503)) {
                返回 假;   // 域外不折叠（溢出面由对称预演/运行期承载）
            }
            值 = 左值503 + 右值503;
            返回 真;
        }
        如果 (字符串比较(op503, "-")) {
            如果 ((右值503 < 0 && 左值503 > 9223372036854775807 + 右值503) ||
                 (右值503 > 0 && 左值503 < 0 - 9223372036854775807 - 1 + 右值503)) {
                返回 假;
            }
            值 = 左值503 - 右值503;
            返回 真;
        }
        如果 (字符串比较(op503, "*")) {
            如果 (左值503 == 0 || 右值503 == 0) { 值 = 0; 返回 真; }
            布尔 负果503 = (左值503 < 0) != (右值503 < 0);
            正64 绝左503 = 左值503 < 0 ? 正64(位模式取负474(左值503)) : 正64(左值503);
            正64 绝右503 = 右值503 < 0 ? 正64(位模式取负474(右值503)) : 正64(右值503);
            正64 域绝503 = 负果503 ? 正64(位模式取负474(0 - 9223372036854775807 - 1))
                                : 正64(9223372036854775807);
            // 先除后乘防中间溢出（首条件假 ⇒ 绝左*绝右 ≤ 域绝 必不溢出）
            如果 (绝左503 > 域绝503 / 绝右503 || 绝左503 * 绝右503 > 域绝503) { 返回 假; }
            // 负果取负用位模式（0-积 在积=2^63〔=整MIN 位模式〕时溢出面·503 修）
            正64 积503 = 绝左503 * 绝右503;
            如果 (负果503) { 值 = 位模式取负474(整64(积503)); } 否则 { 值 = 整64(积503); }
            返回 真;
        }
        // 除/余：除零=消费点定性对象（不折叠交外层拦）·整MIN/-1 域外放行
        如果 (右值503 == 0) { 返回 假; }
        如果 (右值503 == 0 - 1 && 左值503 == 0 - 9223372036854775807 - 1) { 返回 假; }
        如果 (字符串比较(op503, "/")) { 值 = 左值503 / 右值503; } 否则 { 值 = 左值503 % 右值503; }
        返回 真;
    }
    返回 假;
}

// 728s：预演域类型推导辅助（宿主 reportConstOverflow promotedType +
//   commonNumericType 链同构）——左右操作数定级：
//   ①字面量形态（含负号字面量）→ 字面量后缀类型ID（L→整64 等·0=无后缀）；
//   ②无后缀字面量/非字面量折叠树 → 按折叠值提升（|v| 超 int32 域 → 整64）。
//   合并经 二元结果类型ID（秩高者/同秩取左·宿主 commonNumericType 同构）；
//   返回 整32/整64=可预演有符号域；0=跳过（正32/正64/正128/整128 无符号/128
//   域宽于 int64 承载，或不可合并——宿主 rangeOf miss「不误报」同口径）。
//   现象锚：`2147483647U+1U`（宿主放行 2147483648）修复前 v2 按值域误报
//   编译期溢出=零分叉违例；后缀定级后合类型=正32 → 跳过。
函数 溢出面域类型474(向量<节点> 池, 节点 n, 整32 节点索引, 整64 值左, 整64 值右) -> 整64 {
    整64 类左 = 溢出面操作数类型474(池, 整32(n.附加) - 1, 值左);
    整64 类右 = 溢出面操作数类型474(池, 节点索引 - 1, 值右);
    // 728s 对称化（2026-10-15 用户裁决批乙）：域预演与结果类型推导同规则
    //   （无后缀字面量随另一侧——推导二元类型ID 同调用）——`2147483647 + 1U`
    //   域=正32（无符号域不预演·跳过放行）、原按整32 域误报编译期溢出
    //   （949 q6c 形态）；`4294967295 + 1U` 同域=正32（与 4294967295U+1U
    //   无符号回绕口径同）；双侧无后缀/带后缀形态不触发（420 按值提升链
    //   既有行为零变化）。宿主 reportConstOverflow effL/effR 同构。
    随侧无后缀字面量728(池, 整32(n.附加) - 1, 节点索引 - 1, 类左, 类右);
    整64 合 = 二元结果类型ID(类左, 类右);
    如果 (合 == 驻留("整32") || 合 == 驻留("整64")) { 返回 合; }
    返回 0;
}

// 728s：单侧操作数预演域类型——字面量后缀优先（宿主 promotedType 字面量
//   分支「带后缀：按后缀类型」同构）；无后缀/非字面量按值提升（宿主「无后缀
//   按值提升」同构）。
函数 溢出面操作数类型474(向量<节点> 池, 整32 末端索引, 整64 折叠值) -> 整64 {
    如果 (末端索引 >= 0 && 末端索引 < 整32(池.大小())) {
        节点 末 = 池.元素(末端索引);
        整64 字面名ID = 0;
        如果 (末.类型 == 节点_整数字面量) { 字面名ID = 整64(末.文本); }
        否则 如果 (末.类型 == 节点_负号 && 末.子起点 > 0 &&
                  末.子起点 < 整32(池.大小()) &&
                  池.元素(整32(末.子起点)).类型 == 节点_整数字面量) {
            字面名ID = 整64(池.元素(整32(末.子起点)).文本);
        }
        如果 (字面名ID != 0) {
            整64 后缀ID = 字面量后缀类型ID(驻留文本(字面名ID));
            如果 (后缀ID > 0) { 返回 后缀ID; }
        }
    }
    如果 (折叠值 > 2147483647 || 折叠值 < 0 - 2147483648) { 返回 驻留("整64"); }
    返回 驻留("整32");
}

// 474 常量算术溢出预演（宿主 checkConstIntExprSafety 同构）：+/−/* 结果超域=
//   编译期拒绝；INT_MIN / -1 =除法唯一溢出形态同面；无符号/整128 域宽于
//   int64 预演承载跳过（不误报·宿主同口径）
函数 检查常量算术溢出预演474(向量<节点> 池, 节点 n, 整32 节点索引, 字符串 op文本,
                     布尔 是算术位符, 向量<字符串>& 诊断) -> 空类型 {
        // 474 对齐宿主 checkConstIntExprSafety：常量算术溢出编译期硬错误——
        //   双侧可折叠为常量（505 递归窗口折叠：字面量/一元负/嵌套常量子树）
        //   按提升域预演：+/−/* 结果超域=编译期拒绝（Rust debug 溢出检查对齐·
        //   变量面回绕语义由运行时通道承载）；INT_MIN / -1（与 % -1）=除法唯一
        //   溢出形态同面编译期拒绝；无符号/整128 域宽于 int64 预演承载跳过
        //   （不误报·宿主同口径）。
        如果 (是算术位符 && 字符串比较(op文本, "+") == 假 &&
             字符串比较(op文本, "-") == 假 &&
             字符串比较(op文本, "*") == 假 &&
             字符串比较(op文本, "/") == 假 &&
             字符串比较(op文本, "%") == 假) {
            // 非五算术算子（位运算面）不预演——直通下方移位检查
        } 否则 如果 (节点索引 >= 2) {
            整64 值左474 = 0;
            整64 值右474 = 0;
            // 505：取值通道升级——旧 ≤2 节点字面量窗（取常量下标值+负形左扩）
            //   扩为根索引驱动子树折叠（嵌套形态 ((30000+30000)*30000000) 由此
            //   进预演；折叠失败=非常量/中间溢出→保持现状不预演走运行期错误码
            //   兜底）。左末=附加-1、右末=自身-1（484 实证契约）
            布尔 常左474 = n.附加 > 0 && n.附加 < 整64(节点索引) &&
                          折叠子树值505(池, 整32(n.附加) - 1, 值左474, 0);
            布尔 常右474 = 常左474 &&
                          折叠子树值505(池, 节点索引 - 1, 值右474, 0);
            如果 (常右474) {
                // 728s（宿主 reportConstOverflow 链同构）：域判定改按**操作数
                //   定级类型**（字面量后缀优先/无后缀按值提升——见 溢出面域类型474），
                //   合并经 二元结果类型ID；合类型非 {整32,整64} 有符号域 →
                //   跳过预演（无符号/128 域宽于 int64 承载·宿主 rangeOf miss
                //   「不误报」同口径）——`2147483647U+1U` 放行对齐宿主。
                //   本函数预演面=唯一出口，跳过即返回（无后续逻辑）。
                整64 域合474 = 溢出面域类型474(池, n, 节点索引, 值左474, 值右474);
                如果 (域合474 == 0) { 返回; }
                整64 域上474 = 2147483647;
                整64 域下474 = 0 - 2147483648;
                如果 (域合474 == 驻留("整64")) {
                    域上474 = 9223372036854775807;
                    域下474 = 0 - 9223372036854775807 - 1;
                }
                如果 (字符串比较(op文本, "/") &&
                     值右474 == 0 - 1 && 值左474 == 域下474) {
                    // 474 立法澄清（001 §3.7a）：守卫只属除法——INT_MIN % -1 ≡ 0
                    //   恒良定义不报（常量 % -1 = 0 合法折叠·取余非溢出面）
                    表诊断(诊断, "[错误] 编译期整数溢出：INT_MIN / -1 结果超出类型范围（除法唯一溢出形态·任务 474 错误码 8 对齐）" + 溢出字面量参与域提示582());
                } 否则 如果 (字符串比较(op文本, "+")) {
                    如果 ((值右474 > 0 && 值左474 > 域上474 - 值右474) ||
                         (值右474 < 0 && 值左474 < 域下474 - 值右474)) {
                        表诊断(诊断, "[错误] 编译期整数溢出：常量表达式结果超出类型范围（Rust debug 溢出检查对齐·变量面回绕由运行时错误 8 承载）" + 溢出字面量参与域提示582());
                    }
                } 否则 如果 (字符串比较(op文本, "-")) {
                    如果 ((值右474 < 0 && 值左474 > 域上474 + 值右474) ||
                         (值右474 > 0 && 值左474 < 域下474 + 值右474)) {
                        表诊断(诊断, "[错误] 编译期整数溢出：常量表达式结果超出类型范围（Rust debug 溢出检查对齐·变量面回绕由运行时错误 8 承载）" + 溢出字面量参与域提示582());
                    }
                } 否则 如果 (字符串比较(op文本, "*")) {
                    // 乘预演：绝对值按正64 域（位模式取负474 处理 MIN 补码）
                    正64 绝左474 = 值左474 >= 0 ? 正64(值左474) : 正64(位模式取负474(值左474));
                    正64 绝右474 = 值右474 >= 0 ? 正64(值右474) : 正64(位模式取负474(值右474));
                    正64 域绝474 = 0;
                    如果 (值左474 < 0 != 值右474 < 0) {
                        // |lo|：位模式取负（域下=MIN 时 0-域下 自身溢出面·474 安全形态）
                        域绝474 = 正64(位模式取负474(域下474));
                    } 否则 {
                        域绝474 = 正64(域上474);
                    }
                    如果 (绝左474 != 0 && 绝右474 != 0 &&
                         (绝左474 > 域绝474 / 绝右474 || 绝左474 * 绝右474 > 域绝474)) {
                        表诊断(诊断, "[错误] 编译期整数溢出：常量表达式结果超出类型范围（Rust debug 溢出检查对齐·变量面回绕由运行时错误 8 承载）" + 溢出字面量参与域提示582());
                    }
                }
            }
        }
}

// 474 常量移位量超宽（宿主 checkShiftConstWidth 同构）：值∉[0, 左域位宽) 全拒
函数 检查常量移位超宽474(向量<节点> 池, 节点 n, 整32 节点索引, 字符串 op文本,
                    向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
        // 474（运行期整数溢出·错误码 8）：常量移位量超宽编译期硬错误——
        //   移位量 k ≥ 左操作数声明位宽 → 编译期拒绝（宿主同构；运行期同面
        //   已由三后端移位检查兜错误码 8）。左宽：移位左操作数位宽474 三通道
        //   推导（1185 主路径=语义类型全形态·636 词法白名单兜底·502 窗口
        //   再兜底——修前「其余形态推导 -1 跳过（检不出=诚实边界）」注释面
        //   与宿主 checkShiftConstWidth 语义类型全形态已实现检查冲突=分叉
        //   放行非诚实边界，1185 随六族缺口闭合废止）。k 预检有效位 >18 位
        //   =必超任何域宽（10^18 < 2^63——免编译器自身解析溢出·474 自举
        //   安全面）。502 补左负形窗口/审查 P1-2 后缀定宽等左宽通道史注记
        //   随左宽块迁 移位左操作数位宽474（本函数只留主干）。
        如果 (字符串比较(op文本, "<<") || 字符串比较(op文本, ">>")) {
            // 1185：左宽推导单点化（三通道·详注=移位左操作数位宽474）
            可选<整64> 左宽查474 = 移位左操作数位宽474(池, n, 节点索引, 符号表);
            如果 (左宽查474.有值 && 节点索引 != 0) {
                整64 左宽474 = 左宽查474.值;
                整64 移量474 = 0;
                布尔 常量移474 = 假;
                // 505：移位量先走根索引驱动子树折叠（折叠形态 甲<<(700+66) 由此
                //   覆盖——宿主 checkShiftConstWidth 折叠通道同构；右末=自身-1；
                //   单字面量/负字面量子树折叠=旧通道同值）
                如果 (节点索引 >= 2 &&
                     折叠子树值505(池, 节点索引 - 1, 移量474, 0)) {
                    常量移474 = 真;
                } 否则 {
                    // 505 回退通道（现状口径保留）：折叠失败时右末端字面量
                    //   预检+18 位巨字面量超任一域宽硬错误（现状行为零回归——
                    //   巨字面量宿主 parseIntValue 溢出静默 0 与本通道分叉系
                    //   存量面·非 505 引入，汇报点名待立项）
                    节点 右移474 = 池.元素(整32(节点索引 - 1));
                    布尔 右负形s474 = 右移474.类型 == 节点_负号;
                    整64 右窗起s474 = 右负形s474 ? 节点索引 - 2 : 节点索引 - 1;
                    节点 右字面s474 = 池.元素(整32(右窗起s474));
                    如果 (右字面s474.类型 == 节点_整数字面量) {
                        // 预检：有效十进制位 >18（含 0x 十六进制展开位更多）=必超域宽
                        字符串 移文本474 = 字符串复制(驻留文本(整64(右字面s474.文本)));
                        整64 有效位474 = 字符串长度(移文本474);
                        如果 (有效位474 > 2 && (整64(移文本474[0]) & 255) == 48 &&
                             ((整64(移文本474[1]) & 255) == 120 || (整64(移文本474[1]) & 255) == 88)) {
                            有效位474 = 有效位474 - 2;
                        }
                        如果 (有效位474 > 18) {
                            表诊断(诊断, "[错误] 编译期移位溢出：常量移位量超任一整型域宽（左操作数位宽 " +
                                        整数转字符串(左宽474) + "）");
                            常量移474 = 假;   // 已诊断·不再取值
                        } 否则 {
                            常量移474 = 取常量下标值(池, 整32(右窗起s474), 整32(节点索引), 移量474);
                        }
                    }
                }
                如果 (常量移474 && (移量474 < 0 || 移量474 >= 左宽474)) {
                    // 474 对齐宿主 checkShiftConstWidth：值∉[0, 左域位宽) 全拒
                    //   （负移位量同编译期硬错误）
                    表诊断(诊断, "[错误] 编译期移位溢出：常量移位量 " + 整数转字符串(移量474) +
                                " ∉ [0, " + 整数转字符串(左宽474) +
                                ")（左操作数域位宽·运行期移位超宽已有运行时错误 8）");
                }
            }
        }
}

// 502 审查 P1-2 辅助：整数字面量文本按后缀定宽（宿主 literalTypeOf 同构·
//   type_system.cpp:412）——后缀收集=从文本尾连续 L/l/U/u 字节保序前插
//   大写化（宿主逐字 toupper 前插同构）；精确匹配宿主集合：L=64（整64）/
//   LL=128（整128）/ U=32（正32）/ UL=64（正64）/ ULL=128（正128）；
//   无后缀=32（整32 默认·285 口径）；其余组合（如 LU）=宿主 literalTypeOf
//   空串→visitIntegerLiteral 防御回退整32 同口径 32。0x/0b/0o 进制前缀
//   无碍（F 不属后缀字符集·宿主 stripLiteralSuffix 同理）；v2 词法整数形态
//   不消费 f/F（浮点形态专属·338-a），整数字面量文本无浮点后缀面。
函数 字面量后缀位宽474(字符串 字面文本474) -> 整64 {
    字符串 后缀474 = "";
    整64 尾474 = 字符串长度(字面文本474);
    当 (尾474 > 0) {
        整64 字节474 = 整64(字面文本474[尾474 - 1]) & 255;
        如果 (字节474 == 76 || 字节474 == 108) {          // 'L'/'l'
            后缀474 = 字符串复制("L" + 后缀474);
        } 否则 如果 (字节474 == 85 || 字节474 == 117) {   // 'U'/'u'
            后缀474 = 字符串复制("U" + 后缀474);
        } 否则 {
            中断;
        }
        尾474 = 尾474 - 1;
    }
    如果 (字符串比较(后缀474, "L")) { 返回 64; }
    如果 (字符串比较(后缀474, "LL")) { 返回 128; }
    如果 (字符串比较(后缀474, "U")) { 返回 32; }
    如果 (字符串比较(后缀474, "UL")) { 返回 64; }
    如果 (字符串比较(后缀474, "ULL")) { 返回 128; }
    返回 32;   // 无后缀=整32 默认；其余组合=宿主空串防御回退整32 同口径
}


// ==================== 474（运行期整数溢出·回绕逃生门·自 语义检查表达式尾.cn
//   纯机械搬移·L2 冻结线同族聚合·零语义变化：函数体逐字迁移·调用点
//   语义检查表达式 调用检查位经 回绕调用返回类型474 薄委托解析） ====================

// ==================== 474（运行期整数溢出·回绕逃生门） ====================
// 回绕加/回绕减/回绕乘 三件套返回类型实现——与宿主 checkWrapBuiltinCall 类型
//   规则逐步同构：①实参类型经 checkExpr 递归推导（标识符/字面量/调用/转换原
//   样取值）；②285 窄域字面量豁免（对侧窄+本侧字面量→按窄域参与）；③其余按
//   整数族秩高者胜（commonNumericType 整数分支 rankA>=rankB ? a : b）。
//   实参末位经 查调用实参末位（解析层记录·415 推导同源）；推导失败→整64 兜底
//   仅作 648 显形中止前的路径保留（登记内部未登记→收尾统一中止，非静默继续）。
// 回绕实参侧类型（无值=推导失败）：标识符→表查找类型ID；字面量→按数学值域
//   单点 字面量运行期类型1068（778/535 逐代收口→1068 对齐宿主
//   wrapLiteralOperandType 切 types::integerLiteralRuntimeType——进制/后缀/
//   超承载全形态提升链：入整32 域=整32·超 int32=整64·超 int64=整128）；
//   负号字面量→同款单点含负号（-2^63=整64 域内）；嵌套回绕调用→递推
//   回绕调用返回类型474（宿主 checkExpr 递归推导同构·修前 0=双盲 648 显形
//   中止 stdlib/随机数.cn 实录）；一般调用→①用户函数语义符号表返回类型
//   ②内置函数返回类型 ③查函数返回回退（728f·宿主 checkExpr 全形态递归同构）；
//   1311：显式转换调用（节点_调用·被调=整数类型名）→转换目标类型（宿主
//   visitCastExpr lastType_=target 同位）；其余 无。1541 B2：结果化——有值=
//   类型ID/无值=不可推导（0 哨兵退场）。
函数 回绕实参侧类型474(向量<节点> 池, 整32 节点索引,
                   向量<映射<整64, 符号>>& 符号表, 整64 实参序) -> 可选<整64> {
    整64 末474 = 0 - 1;
    可选<整64> 末474查 = 查调用实参末位(整64(节点索引), 实参序);
    // miss（原 -1 哨兵）同走「不可推导」返回 无——原判定逐字保留
    如果 (末474查.有值) { 末474 = 末474查.值; }
    如果 (末474 < 0 || 末474 >= 整64(池.大小())) { 返回 无; }
    节点 根474 = 池.元素(整32(末474));
    如果 (根474.类型 == 节点_标识符) {
        整64 类型ID474 = 0;
        可选<整64> 类型ID474查 = 表查找类型ID(符号表, 整64(根474.文本));
        // miss 保持 0（下方 >0 判定与原 -1 哨兵同假·880 批5）
        如果 (类型ID474查.有值) { 类型ID474 = 类型ID474查.值; }
        布尔 类型有效474i = 类型ID474 > 0;
        如果 (类型有效474i) { 返回 某些(类型ID474); }
        // miss（如类方法体内裸字段名隐式 自身.字段）=落末尾一般推导
    }
    如果 (根474.类型 == 节点_整数字面量) {
        // 778 → 1068：参与域判定收口 字面量运行期类型1068 单点（宿主
        //   types::integerLiteralRuntimeType 对称物）——进制（0x/0b/0o）/
        //   后缀（L/U/LL/UL/ULL）/超承载全形态数学值域提升；原「无后缀纯
        //   十进制超整32 域」判据对进制/后缀形态恒判整32（231 挂账口径收口）
        //   =与宿主切单点后分叉。
        返回 某些(字面量运行期类型1068(字符串复制(驻留文本(整64(根474.文本))), 假));
    }
    // 778 ①负号字面量（[字面量,负号] 区间末位=负号节点·协议常量建节点契约）：
    //   数字文本入整32 域（≤2147483648·535 判据）=整32 参与；超域=整64——
    //   宿主 -7046029254386353131 值提升整64 同构·IR 发射面 535 压回判据同源
    如果 (根474.类型 == 节点_负号 && 根474.子起点 > 0 &&
         根474.子起点 < 整64(池.大小())) {
        节点 负子474 = 池.元素(整32(根474.子起点));
        如果 (负子474.类型 == 节点_整数字面量) {
            // 1068：负号并入数学值域（-2^63=整64 域内→整64·64 位回绕；原链
            //   「负号字面量值入整32域」只分 32/64 两档=回绕减
            //   (-9223372036854775808,1) 与宿主切单点后 128 位回绕错域分叉）
            返回 某些(字面量运行期类型1068(字符串复制(驻留文本(整64(负子474.文本))), 真));
        }
        // 非字面量负号（-x 等）=落末尾一般推导（表达式类型ID 保型递归）
    }
    // 778 ②+728f+1311 嵌套/一般调用（实参末位=内层调用节点·被调标识符=
    //   调用节点.子起点 同位）。通道序：
    //   ①被调=回绕加/减/乘 → 递推 回绕调用返回类型474（内层调用在语义遍历序
    //     上先行·类型可推导；树深有限天然终止）——778；
    //   ②1311：显式转换（被调=整数类型名）→转换目标类型——宿主把 `整8(x)`
    //     解析为 CastExpr 并直接返回目标类型（visitCastExpr），v2 转换=节点_
    //     调用，修前只落 ③④ 的查函数链、类型名恒 miss →双盲整64 登记；
    //   ③用户函数→语义符号表返回类型（种类=函数；检查调用表达式 596 同源，
    //     语义遍历期唯一已填充权威）+ 查函数返回回退（728f·IR 期键基表兜底；
    //     纯名键仅主模块登记——stdlib 内函数纯名恒 miss 须键基回退）；
    //   ④内置函数→内置返回类型（645/828 单点表；宿主 checkExpr 返回内置
    //     返回类型同构）。非整数返回不属回绕合法操作数面（宿主整数守卫另拒）。
    //   无值=落 648 登记显形路径不变（658 已归档接口级合法 miss 面）。
    如果 (根474.类型 == 节点_调用 && 根474.子起点 > 0 &&
         根474.子起点 < 整64(池.大小())) {
        节点 被调474b = 池.元素(整32(根474.子起点));
        如果 (被调474b.类型 == 节点_标识符) {
            字符串 被调名474b = 字符串复制(驻留文本(整64(被调474b.文本)));
            如果 (字符串比较(被调名474b, "回绕加") || 字符串比较(被调名474b, "回绕减") ||
                 字符串比较(被调名474b, "回绕乘")) {
                返回 某些(回绕调用返回类型474(池, 整32(末474), 符号表));
            }
            // 1311：显式转换目标类型（整数族白名单单点=IR包 是整数显式转换目标474）
            如果 (是整数显式转换目标474(被调名474b)) { 返回 某些(驻留(被调名474b)); }
            // 1311：用户函数返回类型（语义符号表权威；非函数名不按返回类型消费）
            整64 符号类474 = 0;
            可选<整64> 符号类474查 = 表查找类型ID(符号表, 整64(被调474b.文本));
            // miss 保持 0（下方 >0 判定与原 -1 哨兵同假·880 批5）
            如果 (符号类474查.有值) { 符号类474 = 符号类474查.值; }
            布尔 符号类型有效474 = 符号类474 > 0;
            可选<整64> 符号种类474查 = 表查找种类(符号表, 整64(被调474b.文本));
            如果 (符号种类474查.有值) {
                整64 符号种类474 = 符号种类474查.值;
                如果 (符号种类474 == 符号_函数 && 符号类型有效474) {
                    返回 某些(符号类474);
                }
            }
            // 1311：内置函数返回类型（非整数返回也如实返回——由调用点整数
            //   守卫按宿主同文案拒绝；原仅整数族返回则落 查函数返回回退旁路，
            //   字符串/布尔/浮点内置返回被静默放行=宿主拒绝面分叉）
            可选<整64> 内建类474查 = 内置函数返回类型ID(被调名474b);
            // 1541 B2：有值=内置返回类型可解析（原 >0 判据等价）
            如果 (内建类474查.有值) {
                整64 内建类474 = 内建类474查.值;
                返回 某些(内建类474);
            }
            可选<整64> 返类728f查 = 查函数返回回退(整64(被调474b.文本));
            如果 (返类728f查.有值) {
                整64 返类728f = 返类728f查.值;
                返回 某些(返类728f);
            }
        }
        // 推导链全 miss（方法/间接调用/重载等）=落末尾一般推导（表达式类型ID
        //   经 检查表达式 全形态解析）；仍 miss 由调用点登记中止（P2-1）。
    }
    // 1311 P2-1：其余一般表达式形态（二元/三元/下标/成员/取址等）经
    //   表达式类型ID 静默推导（1185 移位左宽同款惯例：二次推导诊断吞弃，
    //   语句根为权威诊断点）；仍无值由调用点登记中止（禁静默取对侧）。
    向量<字符串> 静默1311 = 向量<字符串>();
    可选<整64> 末类查1311 = 表达式类型ID(池, 整32(末474), 符号表, 静默1311);
    // 880 批5：无值=推导 miss（本函数 无值=不可推导契约·调用点登记中止）
    如果 (末类查1311.有值) {
        整64 末类1311 = 末类查1311.值;
        返回 某些(末类1311);
    }
    返回 无;
}

// 1311：实参是否字面量形态（整数字面量 / 负号+整数字面量）——285 窄域字面量
//   豁免判据（宿主 isIntLiteralExpr 同构：IntegerLiteral 或 -<IntegerLiteral>）。
//   原实现以「对侧类型==整32」近似字面量 → 整32 变量/显式转换被误当字面量
//   窄化（宿主 commonNumericType 按秩取整32 的形态 v2 返回窄域=零分叉缺陷）。
函数 回绕实参是字面量474(向量<节点> 池, 整32 节点索引, 整64 实参序) -> 布尔 {
    整64 末474 = 0 - 1;
    可选<整64> 末474查 = 查调用实参末位(整64(节点索引), 实参序);
    // miss（原 -1 哨兵）同走「非字面量」——原判定逐字保留
    如果 (末474查.有值) { 末474 = 末474查.值; }
    布尔 末位有效474 = 末474 >= 0 && 末474 < 整64(池.大小());
    如果 (末位有效474) {
        节点 根474 = 池.元素(整32(末474));
        如果 (根474.类型 == 节点_整数字面量) { 返回 真; }
        // 882：负号形态=子起点有效且子节点为整数字面量（协议常量建节点契约）
        布尔 负号有效474 = 根474.类型 == 节点_负号 && 根474.子起点 > 0 &&
            根474.子起点 < 整64(池.大小());
        如果 (负号有效474) {
            如果 (池.元素(整32(根474.子起点)).类型 == 节点_整数字面量) { 返回 真; }
        }
    }
    返回 假;
}

// 1311 P1-1：回绕内置整数操作数守卫迁 语义检查运算.cn（运算检查族·文件
//   900 行警戒线先拆再加；本文件保留回绕类型推导族）。

函数 回绕调用返回类型实现474(向量<节点> 池, 整32 节点索引,
                    向量<映射<整64, 符号>>& 符号表) -> 整64 {
    // 双侧类型推导（宿主 checkWrapBuiltinCall 类型规则同构：①同名提升；
    //   ②窄+字面量→窄域保持；③混合=整数族秩高者胜）。返回类型=语义面簿记
    //   （IR 层 生成回绕展开 按同规则独立推导发射面）。
    //   1541 B2：无值=该侧推导失败（原 0 哨兵·下方 >0 判据逐点保持）
    整64 左类474 = 0;
    可选<整64> 左类474查 = 回绕实参侧类型474(池, 节点索引, 符号表, 0);
    如果 (左类474查.有值) { 左类474 = 左类474查.值; }
    整64 右类474 = 0;
    可选<整64> 右类474查 = 回绕实参侧类型474(池, 节点索引, 符号表, 1);
    如果 (右类474查.有值) { 右类474 = 右类474查.值; }
    如果 (左类474 > 0 && 左类474 == 右类474) { 返回 左类474; }
    // 285 窄域字面量豁免（宿主同序）：一侧窄 + 另一侧**字面量** → 字面量按
    //   窄侧类型参与。判据必须是字面量形态本身（1311 收口——原「对侧==整32」
    //   类型近似把整32 变量/显式转换误当字面量）。
    布尔 左窄474 = 左类474 == 驻留("整8") || 左类474 == 驻留("整16") ||
                 左类474 == 驻留("正8") || 左类474 == 驻留("正16");
    布尔 右窄474 = 右类474 == 驻留("整8") || 右类474 == 驻留("整16") ||
                 右类474 == 驻留("正8") || 右类474 == 驻留("正16");
    如果 (左窄474 && 回绕实参是字面量474(池, 节点索引, 1)) { 返回 左类474; }
    如果 (右窄474 && 回绕实参是字面量474(池, 节点索引, 0)) { 返回 右类474; }
    // 混合：整数族秩高者胜（宿主 commonNumericType 整数分支 rankA>=rankB ? a : b
    //   ——同秩正域胜=左优先；整8 与整32 同宽不同秩，不可按位宽近似）
    整64 左秩474 = 整数族类型秩474(左类474);
    整64 右秩474 = 整数族类型秩474(右类474);
    布尔 左秩有效474 = 左秩474 > 0;
    布尔 右秩有效474 = 右秩474 > 0;
    如果 (左秩有效474 && 右秩有效474) {
        如果 (左秩474 >= 右秩474) { 返回 左类474; }
        返回 右类474;
    }
    // 1311 P2-1：单侧推导失败禁静默取对侧（宿主 checkExpr 必有类型；推不出=
    //   推导链缺口）——显式登记中止，同双盲面收尾统一中止，禁静默继续。
    布尔 左类有效474 = 左类474 > 0;
    布尔 右类有效474 = 右类474 > 0;
    布尔 双侧有效474 = 左类有效474 && 右类有效474;
    如果 (!双侧有效474) {
        登记内部未登记("回绕内置实参类型推导失败（单/双侧）",
                       "节点" + 整数转字符串(整64(节点索引)),
                       整64(取当前诊断行()));
        返回 驻留("整64");
    }
    // 648：miss 不可静默——回绕内置双侧实参类型推导全失败（实参=表达式形态
    //   非标识符/字面量/可推导调用）仍静默整64=宽回绕语义替换窄域回绕（静默
    //   语义改变面·486 注释诚实边界）；显形经 IR 包收集表（登记处出诊断行·
    //   主收尾统一中止），原整64 兜底保留（中止前路径）
    登记内部未登记("回绕内置双侧实参类型推导失败（兜底整64 宽回绕）",
                   "节点" + 整数转字符串(整64(节点索引)), 整64(取当前诊断行()));
    返回 驻留("整64");
}
