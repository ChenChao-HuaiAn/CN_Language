// CN 自举编译器 v2 · 语义检查 lambda 族（#276 波1·405 轮警戒线拆分）：
//   lambda合成类型（070 波B 挪入）+ 捕获形态/类型回填/体扫描收集（波1 新增）。
//   归属=语义包（lambda 合成函数签名推导与捕获语义·单一归属）。
导入 容器::向量;
导入 映射集合;
导入 语法;
导入 协议常量;
导入 IR;         // 648：登记内部未登记（miss 不可静默收集表·登记/计数/清空）
导入 语义检查逃逸;   // 486：合成体逃逸检查遍（返回/声明/赋值/实参位·包内兄弟）

公开:   // 全文件公开（lambda 族供 语义检查表达式 等兄弟模块经合并全局池解析）

// #439 附属面（721 解锁暴露）：lambda 合成体内**推断声明**类型登记——合成体
//   跳过主遍历全量检查（688 立法：主遍历无参作用域查体=全局键基碰撞错诊断），
//   体内 `变量 x = 初值` 的推断声明类型从未登记→IR 生成变量声明 查推断声明
//   类型表 miss fail fast（「推断声明类型未登记」）。此前被捕获收集器误收面
//   掩盖（体内名全被误收捕获→语义层先拒编译）。宿主 visitLambdaExpr 对体内
//   checkBlock 全量检查=推断声明正常登记（零分叉基准）。本函数=**最小登记面**
//   （非全量检查：只回填 IR 布局分派所需类型数据·与 登记lambda捕获参数类型
//   跨层静态表同模式）；块树递归（如果真块/否则链/当体/裸块/情况体）；显式
//   类型声明不涉（类型节点非空哨兵·直走显式路径）。同名推断声明跨 lambda
//   扁平互踩=推断声明类型表既有架构（46-c 扁平表·普通函数同债务）零新增。
//   有界边界：选择语句的值表达式混排段不递归（情况体经 节点_情况标签.子起点
//   已覆盖·段内裸语句面=极罕见形态留 462 同域后续）。
函数 登记lambda体推断声明(向量<节点> 池, 整64 块索引,
                       向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    节点 块 = 池.元素(整32(块索引));
    整64 si = 整64(块.子起点);
    当 (si < 整64(块.子终点)) {
        节点 语句 = 池.元素(整32(si));
        如果 (语句.类型 == 节点_变量声明) {
            // 推断形态判定（检查推断声明语句 同款：类型节点文本=空串哨兵）；
            //   显式类型声明=类型节点文本即类型。**两形态都做体内可见性表注册**
            //   （宿主 checkBlock declareVar 同位——合成体跳过全量检查后体内
            //   声明符号不可见=后续语句引用（含推断初值引用先前局部）全不可
            //   解析·721 实录第二层）。
            整64 声明类型ID = 0;
            整64 预类型ID = 整64(语句.附加);
            如果 (预类型ID >= 0 && 预类型ID < 池.大小()) {
                节点 预类型节点 = 池.元素(整32(预类型ID));
                如果 (预类型节点.类型 == 节点_类型) {
                    如果 (整64(预类型节点.文本) == 整64(驻留(""))) {
                        可选<整64> 推断查 = 表达式类型ID(池, 整32(整64(语句.子终点) - 1),
                                                      符号表, 诊断);
                        整64 推断ID = 0;
                        如果 (推断查.有值) { 推断ID = 推断查.值; }
                        如果 (推断ID <= 0) { 推断ID = 驻留("整64"); }
                        登记推断声明类型(整64(语句.文本), 推断ID);
                        声明类型ID = 推断ID;
                    } 否则 {
                        声明类型ID = 整64(预类型节点.文本);
                    }
                }
            }
            整64 忽略reg = 表注册(符号表, 整64(语句.文本), 声明类型ID, 符号_变量, 0);
            如果 (忽略reg == 0) { }
        } 否则 如果 (语句.类型 == 节点_如果语句) {
            // 附加=真块索引；子终点=否则链（链节点=如果语句[递归真块]或
            //   否则块）——生成语句 扫描控制流体块 同构链游
            登记lambda体推断声明(池, 整64(语句.附加), 符号表, 诊断);
            整64 链游 = 整64(语句.子终点);
            当 (链游 != 0) {
                节点 链节 = 池.元素(整32(链游));
                如果 (链节.类型 == 节点_如果语句) {
                    登记lambda体推断声明(池, 整64(链节.附加), 符号表, 诊断);
                    链游 = 整64(链节.子终点);
                } 否则 {
                    如果 (链节.类型 == 节点_块) {
                        登记lambda体推断声明(池, 链游, 符号表, 诊断);
                    }
                    链游 = 0;
                }
            }
        } 否则 如果 (语句.类型 == 节点_当语句) {
            登记lambda体推断声明(池, 整64(语句.附加), 符号表, 诊断);
        } 否则 如果 (语句.类型 == 节点_块) {
            登记lambda体推断声明(池, si, 符号表, 诊断);
        } 否则 如果 (语句.类型 == 节点_情况标签) {
            登记lambda体推断声明(池, 整64(语句.子起点), 符号表, 诊断);
        }
        si++;
    }
}

// 070 波B（1022）：lambda 合成函数类型推导——名ID → 函数指针<返回>(参数…)。
//   合成函数节点：文本=?lambdaN·类型位=返回类型ID（0=无标注待推导）·
//   子起点=参数节点区间起·子终点=体块索引（参数区间=[子起点, 子终点)）。
// 880 批5：原 -1 哨兵→可选<整64>（无值=非 lambda 合成名·调用方保持 -1 契约）。
不安全 函数 lambda合成类型(整64 名ID, 向量<节点> 池, 向量<映射<整64, 符号>>& 符号表,
                   向量<字符串>& 诊断) -> 可选<整64> {
    整64 合成索引 = -1;
    整64 li = lambda合成函数索引们.大小() - 1;
    当 (li >= 0) {
        整64 cand = lambda合成函数索引们.元素(li);
        节点 cand节点 = 池.元素(整32(cand));
        如果 (整64(cand节点.文本) == 名ID) { 合成索引 = cand; 中断; }
        li--;
    }
    如果 (合成索引 < 0) { 返回 无; }
    节点 合成 = 池.元素(整32(合成索引));
    // #276 波1：捕获参数类型回填+存在性校验（宿主 visitLambdaExpr 捕获分析
    //   同位）——捕获参数节点（补解析头插·附加=0 类型占位）查外层变量类型
    //   回填（池尾追加类型节点·附加=其索引·参数区间消费惯例同构）；显式捕获
    //   未声明=诊断（361 负测锚·宿主同语「lambda 捕获的变量 'x' 未声明」）。
    //   回填在推导前：参数注册循环按 附加>0 自动含捕获名（体内可见=捕获参数
    //   槽·690 隐式捕获空捕获面同修）。类型序不经平铺表——捕获参数节点附加
    //   即类型载体（调用点/IR 层池读·零特判）。
    整64 捕获形态 = 0;
    结果<整64, 整32> 查回填形态 = lambda捕获形态们.获取(名ID);
    如果 (查回填形态.正常) { 捕获形态 = 查回填形态.值; } 否则 { }
    整64 捕获数 = 0;
    如果 (捕获形态 != 9) {   // 0/1/2/3 全回填（3=[&] 引用·波2）
        结果<整64, 整32> 查起 = lambda捕获起们.获取(名ID);
        结果<整64, 整32> 查数 = lambda捕获计数们.获取(名ID);
        整64 起v = 0;
        整64 数v = 0;
        如果 (查起.正常) {
            如果 (查数.正常) {
                起v = 查起.值;
                数v = 查数.值;
            }
            否则 {
            }
        }
        否则 {
        }
        捕获数 = 数v;
        整64 ci = 起v;
        当 (ci < 起v + 数v) {
            整64 捕名 = lambda捕获名序们.元素(整32(ci));
            // 457（461/462-① 同族·隐式收集噪声名分类根治）：隐式收集（0/1/3）
            //   =体**标识符 token 级**近似——类静态访问「类名.成员/类名::成员」的
            //   类名（类型限定）与静态成员名、体内被调的用户函数名（439 只排
            //   内置·801b/801d 实录：误收→捕获参数区间膨胀→蹦床还原槽 miss
            //   传参缺位/用户实参错位/函数名被捕获参数遮蔽 call 垃圾 SEGV）。
            //   Rust 同形：路径段不捕获·宿主 collectLambdaCaptures AST 级只认
            //   变量引用=天然排除（零分叉唯一裁决）。修法=**语义层哨兵化剔除**
            //   （语法层无符号表）：非变量名（种类∉{变量,参数}·类静态成员名
            //   局部表 miss 同剔）→ 捕获名序该位写 0+参数节点改 节点_哨兵
            //   （区间长度不变=各层定位零位移·下游快照/固化/还原/参数串全链
            //   遇哨兵跳过·合成循环按节点类型分派自动不登记参数槽）。
            //   形态2=[变量] 显式承诺名单不剔（miss→361 锚诊断原路）。
            如果 (捕获形态 != 2) {
                可选<整64> 捕种类457查 = 表查找种类(符号表, 捕名);
                // miss（原 -1 哨兵）与非法种类同走剔除分支——显式否定回答保持
                布尔 捕是变量名457 = 假;
                如果 (捕种类457查.有值) {
                    捕是变量名457 = (捕种类457查.值 == 符号_变量 ||
                                    捕种类457查.值 == 符号_参数);
                }
                如果 (!捕是变量名457) {
                    结果<空类型, 整32> 设哨457 = lambda捕获名序们.设置(整32(ci), 0);
                    如果 (!设哨457.正常) { 运行时错误(4); }
                    整64 参数位457 = 整64(合成.子起点) + (ci - 起v);
                    结果<空类型, 整32> 设空457 = 池.设置(整32(参数位457),
                        建节点(节点_哨兵, 0, 0, 0, 0));
                    如果 (!设空457.正常) { 运行时错误(4); }
                    ci++;
                    继续;
                }
            }
            // 外层查型（栈顶向下·表查找类型ID 现成）——捕型>0 即捕获（函数名
            //   误收=函数指针值快照·调用语义等价；无值=未声明→361 锚诊断+
            //   整32 占位防雪崩·宿主诊断后继续检查同形）。
            可选<整64> 捕型查 = 表查找类型ID(符号表, 捕名);
            整64 捕型 = 0;
            如果 (捕型查.有值) { 捕型 = 捕型查.值; }
            如果 (!捕型查.有值) {
                // 418（002 收口杂项正测族·宿主 visitLambdaExpr 捕获分析对齐）：
                //   显式捕获（形态 2=[变量]）名单=程序员承诺，未声明→361 锚诊断
                //   +整32 占位防雪崩（原行为）；隐式收集（0=[] /1=[=] /3=[&]）
                //   名单=体**标识符 token 级**近似，非外层变量的噪声名（成员名/
                //   局部声明名漏网）查无=预期形态——静默按整32 占位走原链（体内
                //   真引用该名时由常规标识符检查报未声明），不诊断。原全形态一律
                //   诊断：18_缺陷修复 实录「'x' 未声明」（复点.x 成员名）×2+
                //   「'内层' 未声明」（嵌套 lambda 体内局部声明名）×2 误报。
                如果 (捕获形态 == 2) {
                    字符串 报文 = 字符串复制("lambda 捕获的变量 '");
                    报文 = 报文 + 驻留文本(捕名);
                    报文 = 报文 + "' 未声明";
                    结果<空类型, 整32> 登诊 = 诊断.追加(报文);
                    如果 (!登诊.正常) { 运行时错误(4); }
                } 否则 {
                    // 648：miss 不可静默——隐式捕获种类已判 变量/参数（上方过滤
                    //   剔除非变量名）而查型 miss=符号表内部不一致，显形；显式
                    //   捕获面=上游已诊断的恢复路径（648 归档：418 已裁决 整32
                    //   占位防雪崩）。原整32 占位保留（中止前路径）。
                    登记内部未登记("lambda 隐式捕获查型 miss",
                                   字符串复制(驻留文本(捕名)),
                                   整64(取当前诊断行()));
                }
                捕型 = 驻留("整32");
            }
            // 池尾追加类型节点（文本=类型ID·声明区间外=主循环不遍历）+
            //   回填捕获参数节点 附加=其索引
            整64 类型节点索引 = 池.大小();
            // 类型节点=节点_类型（生成函数 373 行按类型分派——波1 实录=
            //   节点_标识符 走 fallback 恰好对标量绿=侥幸·波2 起正规化）
            //   附加=引用标记：0=值捕获·256=引用捕获（[&] 槽存地址读解引用）
            整64 引用标记 = 0;
            如果 (捕获形态 == 3) { 引用标记 = 256; }
            // 457（462-②）：指针捕获层恢复——符号类型ID=剥星基名（55-c 口径·
            //   指针层语义在 语义指针变量表），回填不恢复→快照固化 捕码=类型码
            //   (基名) T_整32 截断 64 位指针→还原后体内解引用 SEGV（801c 实录）；
            //   捕 结构体* 时快照段/蹦床固化查结构体大小>0 误走深拷多槽（指针
            //   位模式+相邻垃圾整块拷）。查 指针变量表 恢复（解析类型 惯例：
            //   附加=指针层+引用×256 **共存编码**——形态3 引用捕获指针=257·
            //   下游 附加>=256 引用判定/>=1 带星合成均兼容）。
            可选<整64> 指针查捕 = 查语义指针变量(捕名);
            如果 (指针查捕.有值) { 引用标记 = 引用标记 + 1; }
            池追加(池, 建节点(节点_类型, 整32(捕型), 引用标记, 0, 0));
            整64 参数位 = 整64(合成.子起点) + (ci - 起v);
            节点 捕获参数节点 = 池.元素(整32(参数位));
            捕获参数节点.附加 = 类型节点索引;
            结果<空类型, 整32> 设参 = 池.设置(整32(参数位), 捕获参数节点);
            如果 (!设参.正常) { 运行时错误(4); }
            // 433（701）：池回填**层间按值传递对 IR 层不可见**（生成声明 46-c
            //   同款坑）——补跨层静态表登记（IR 层 登记参数槽 对无类型节点
            //   的捕获形参查表合成类型替身：结构体多槽/变量类型权威表/类型码
            //   分派全链生效）；457 起同步登记附加位（指针层/引用标记·平行表）
            登记lambda捕获参数类型(整64(合成.文本), 捕名, 捕型, 引用标记);
            ci++;
        }
    }
    // 418（002 收口杂项正测族·439 融合说明）：嵌套 lambda 推断声明（`变量 内层
    //   = ?lambda2`）的类型登记原由本函数内专项扫体承担（18_缺陷修复 实录
    //   「推断声明类型未登记: 内层」）——439 的 登记lambda体推断声明 公共路径
    //   已完整覆盖（块树递归·表达式类型ID 对 ?名 标识符经 ?前缀豁免触发
    //   lambda合成类型=完整「函数指针<返回>(参数…)」签名同源·并补体内声明
    //   可见性表注册），专项段撤销消重复触发（lambda合成类型 重复调用的捕获
    //   回填重跑会向池尾累积类型节点垃圾）。
    // 函数节点字段约定（语法分析.cn:251 建节点先例）：文本=名ID·**附加=返回
    //   类型ID**·子起点=参数区间起·子终点=体块索引——返回类型读 附加 位。
    //   #439 附属面：参数作用域压栈+参数注册+体内推断声明登记提为**公共路径**
    //   （原先整段锁在 返回ID==0 分支内——带返回标注 `-> 整32` 的合成体整段
    //   跳过=体内推断声明无登记/体内声明符号不可见/捕获参数不可解析·721
    //   `[]() -> 整32 { 变量 局部 = 30; … }` 实录）。返回**推导**仍仅无标注时。
    整64 返回ID = 整64(合成.附加);
    // 压 lambda 参数作用域（宿主 visitLambdaExpr pushScope 同构——587 实录：
    //   无作用域层=推导体内参数引用全报「未声明标识符」），参数类型ID=参数
    //   类型节点文本（解析参数 建节点 惯例·附加=类型节点索引）。
    表压入(符号表);
    整64 参数遍 = 整64(合成.子起点);
    当 (参数遍 < 整64(合成.子终点)) {
        节点 参数节点 = 池.元素(整32(参数遍));
        如果 (参数节点.类型 == 节点_参数 && 整64(参数节点.附加) > 0 &&
             整64(参数节点.附加) < 池.大小()) {
            节点 参数类型节点 = 池.元素(整32(参数节点.附加));
            整64 忽略reg = 表注册(符号表, 整64(参数节点.文本),
                                 整64(参数类型节点.文本), 符号_变量, 0);
            如果 (忽略reg == 0) { }
        }
        参数遍++;
    }
    // #439 附属面：合成体内推断声明类型登记+体内声明可见性（参数作用域已压·
    //   捕获参数已注册=体内引用可解析；IR 布局分派所需·详见函数注释）
    登记lambda体推断声明(池, 整64(合成.子终点), 符号表, 诊断);
    如果 (返回ID == 0) {
        // 返回推导：扫体块语句区间找 返回语句（宿主单一返回推导同语义）——
        //   恰一个带表达式 返回 → 表达式类型；无返回语句 → 空类型；
        //   推导成功写回池（IR 生成合成函数读类型位·103-a 池.设置 先例）。
        节点 体块 = 池.元素(整32(合成.子终点));
        整64 推断ID = 0;
        整64 返回数 = 0;
        整64 si = 整64(体块.子起点);
        当 (si < 整64(体块.子终点)) {
            节点 语句 = 池.元素(整32(si));
            如果 (语句.类型 == 节点_返回语句 && 整64(语句.子终点) > 整64(语句.子起点)) {
                返回数++;
                可选<整64> 推查 = 表达式类型ID(池, 整32(整64(语句.子终点) - 1), 符号表, 诊断);
                整64 推 = 0;
                如果 (推查.有值) { 推 = 推查.值; }
                如果 (推 > 0) { 推断ID = 推; }
            }
            si++;
        }
        如果 (返回数 == 0) { 推断ID = 驻留("空类型"); }
        如果 (推断ID > 0) {
            返回ID = 推断ID;
            合成.附加 = 推断ID;
            结果<空类型, 整32> 设推 = 池.设置(整32(合成索引), 合成);
            如果 (!设推.正常) { 运行时错误(4); }
        } 否则 {
            返回ID = 驻留("空类型");
        }
    }
    // #486（2026-10-13）：合成体逃逸检查遍——体内语句的 435 全族挂点同查
    //   （返回/声明/赋值/实参位·宿主 semantic_lambda_escape 去短路同轮对齐）。
    //   挂载点=返回推导后（返回ID 已定）+参数作用域已压+体内声明已登记
    //   （体内名解析走合成体自身作用域链·688 立法「主遍历无参作用域查体=
    //   全局键基碰撞」动机不受影响）；防重卫在 检查合成体逃逸 入口。
    检查合成体逃逸(池, 合成索引, 符号表, 诊断);
    // #1692（2026-10-26）：显式捕获执法遍——形态 2=[变量] 层体内引用未捕获
    //   外层局部=编译期拒（宿主 #1677 semantic_lambda_escape 同构·实现见
    //   本文件尾 检查合成体显捕）。挂载点与逃逸遍同位（体内声明已登记+
    //   参数作用域已压·表弹出前）。
    检查合成体显捕(池, 合成索引, 整64(合成.文本), 符号表, 诊断);
    表弹出(符号表);
    // 参数类型串拼函数指针类型文本：函数指针<返回>(p1,p2)（T69 480-a 合成约定
    //   IR布局.cn:566 同款——是函数指针类型文本 前缀判定的合法形态）。
    //   #276 波1：跳过捕获参数（区间头 捕获数 个）——签名口径=用户形参
    //   （调用检查实参数比对/与宿主变量类型文本对齐；捕获实参由调用点展开）。
    字符串 类型串 = 字符串复制("函数指针<");
    类型串 = 类型串 + 驻留文本(返回ID);
    类型串 = 类型串 + ">(";
    整64 pi = 整64(合成.子起点) + 捕获数;
    整64 参数数 = 0;
    当 (pi < 整64(合成.子终点)) {
        节点 参数节点 = 池.元素(整32(pi));
        如果 (参数节点.类型 == 节点_参数) {
            如果 (参数数 > 0) { 类型串 = 类型串 + ","; }
            节点 参数类型节点 = 池.元素(整32(参数节点.附加));
            类型串 = 类型串 + 驻留文本(整64(参数类型节点.文本));
            参数数++;
        }
        pi++;
    }
    类型串 = 类型串 + ")";
    返回 某些(驻留(类型串));
}

// plans/018 第 3 层：限定合成名（工具库::版本）——语句根区间线性检查会
//   把调用被调标识符当裸标识符送达本分支（检查块 语句根派发惯例：每节点
//   恰在其作用域访问一次）。stdlib 限定已由上方内置表命中；此处解析用户

// #276 波1：lambda 合成函数名判定（?前缀·主遍历体检查跳过用）——合成函数
//   语义=lambda合成类型 推导扫描专属（参数/捕获作用域内）；主遍历无参作用域
//   查体=体内名落全局三级键基碰撞（688 实录：x→「模块」错诊断）。
函数 是lambda合成函数名(整64 名ID) -> 布尔 {
    字符串 名 = 字符串复制(驻留文本(名ID));
    如果 (字符串长度(名) > 0) {
        如果 ((整64(名[0]) & 255) == 整64('?')) { 返回 真; }
    }
    返回 假;
}

// ==================== #1692（2026-10-26）：lambda 显式捕获执法 ====================
// 宿主 #1677 同构（src/cn_compiler/semantic/semantic_lambda_escape.cpp
//   enterLambdaFrame/exitLambdaFrame/checkExplicitCaptureRead）：显式捕获
//   [x] lambda 体内引用未捕获的外层局部=编译期拒——IR 层该名不在捕获集=
//   闭包野读外层栈槽，运行输出垃圾值（h5 探针实证）/ v2 侧匿名函数符号体外
//   直引致链接 LNK2019。口径逐字对齐宿主：
//   ①仅捕获形态 2=[变量] 显式层拦；[=]/[&]/[] 层保持隐式收集既有语义放行
//     （宿主「非 Explicit 层读位执法放行」同语义）。
//   ②命中层 0=全局作用域（顶层常量折叠/静态/全局变量·三级键基）免捕放行。
//   ③命中层 ≥ 参数层索引=本层参数/捕获参数/体内推断声明放行（v2 压栈后
//     顶层=参数层，登记lambda体推断声明 已先行注册体内声明——与宿主
//     hitDepth >= bodyScopeDepth-1 判定同构）。
//   ④显式捕获列表命中放行；miss=诊断（文本与宿主 checkExplicitCaptureRead
//     逐字一致），诊断后继续扫描=宿主「报错照常回类型·最小级联」同语义。
// v2 结构性同构差异：宿主=单遍 checkBlock 全量检查流（visitIdentifierExpr
//   全局读位挂点+帧栈辨属层），v2=688 立法「主遍历无参作用域查体」→ 合成体
//   分层检查（lambda合成类型 专属遍·嵌套 lambda 各自递归推导）——每合成体
//   的执法遍天然只扫本层体块（嵌套体内不在本合成体池区间），「最近一层为
//   Explicit 时拦」宿主帧栈语义天然成立，零帧栈。

// 防重卫（名ID -> 1）：lambda合成类型 经类型解析可多次触发——每合成体本轮
//   编译仅查一遍（防重复诊断·同 合成体逃逸已查们 模式·独立表不与逃逸检查互扰）
静态 映射<整64, 整64> 合成体显捕已查们;

// 变量读位命中层（宿主 defInitLookupDepth+lookupVar 同构·栈顶向下第一命中）：
//   有值=命中层索引（0=全局层三级键基；1..n=局部层）且该行种类∈{变量,参数}
//   （宿主 scopes_ 只存变量同语义）；同层命中非变量/参数名（函数/常量/结构体
//   名——v2 符号表混合种类与宿主 scopes_/函数表分离的结构差）跳过继续向浅层
//   找（遮蔽语义对齐宿主：变量解析不被同名函数/常量登记挡）；无值=未命中
//   变量（非执法面——未声明诊断由既有路径承担，此处零动作）。
不安全 函数 显捕变量命中层(向量<映射<整64, 符号>>& 符号表, 整64 名ID) -> 可选<整64> {
    整64 i1692 = 符号表.大小();
    当 (i1692 > 1) {
        i1692--;
        结果<符号, 整32> 查1692 = 符号表.元素引用(i1692).获取(名ID);
        如果 (查1692.正常) {
            如果 (查1692.值.种类 == 符号_变量 || 查1692.值.种类 == 符号_参数) {
                返回 某些(i1692);
            }
        }
        否则 {
        }
    }
    // 全局层（栈底·三级键基解析同 表查找种类 尾段）——命中即全局作用域，
    //   种类不再分流（函数/常量/全局变量全放行=宿主 hitDepth<=0 同语义）
    整64 键基1692 = 三级键基查找(符号表, 名ID, 0 - 1);
    // 静默豁免业务值: 单边守卫——全局层键存在性判定（-1=未命中·三级键基查找契约哨兵），非业务区间判定
    如果 (键基1692 >= 0) {
        结果<符号, 整32> 查键1692 = 符号表.元素引用(0).获取(键基1692);
        如果 (查键1692.正常) { 返回 某些(0); }
        否则 {
        }
    }
    返回 无;
}

// 单名读位执法（宿主 checkExplicitCaptureRead 同构）：未捕获外层局部=报诊断。
//   参数层索引=执法遍运行时 符号表.大小()-1（本层参数/捕获参数/体内推断声明
//   注册层）；捕获区间=[捕获起, 捕获起+捕获数)（lambda捕获名序们·声明序）。
不安全 函数 显捕判读位(向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断,
                 整64 名ID, 整64 参数层索引, 整64 捕获起, 整64 捕获数) -> 空类型 {
    可选<整64> 层查1692 = 显捕变量命中层(符号表, 名ID);
    如果 (!层查1692.有值) { 返回; }
    整64 层1692 = 层查1692.值;
    如果 (层1692 == 0) { 返回; }           // 全局作用域：免捕放行
    如果 (层1692 >= 参数层索引) { 返回; }  // 本层参数/捕获参数/体内声明：合法
    整64 wi1692 = 捕获起;
    当 (wi1692 < 捕获起 + 捕获数) {
        如果 (lambda捕获名序们.元素(整32(wi1692)) == 名ID) { 返回; }
        wi1692++;
    }
    // 诊断文本与宿主逐字一致：列表=声明序 ", " 连接；空列表=「空」
    字符串 列表串1692 = 字符串复制("");
    整64 li1692 = 捕获起;
    当 (li1692 < 捕获起 + 捕获数) {
        如果 (li1692 > 捕获起) { 列表串1692 = 列表串1692 + ", "; }
        列表串1692 = 列表串1692 + 字符串复制(驻留文本(lambda捕获名序们.元素(整32(li1692))));
        li1692++;
    }
    如果 (字符串长度(列表串1692) == 0) { 列表串1692 = 字符串复制("空"); }
    表诊断(诊断, "lambda 体内引用了未捕获的变量 '" +
                 字符串复制(驻留文本(名ID)) + "'（显式捕获列表：" + 列表串1692 +
                 "）——显式捕获须逐一列出（或改用 [=]/[&] 默认捕获）");
}

// 表达式区间标识符扫描（池扁平后缀序·线性扫即全表达式覆盖）：标识符=读位
//   执法面（含调用被调位——宿主间接调用 checkExpr(callee) 同查，普通函数名
//   经 显捕变量命中层 种类过滤放行）；区间内 节点_赋值=表达式内嵌赋值，其纯
//   标识符左值在文本位（池位在左值链·区间外）补判；?前缀合成名跳过（嵌套
//   lambda 引用位·其体内由该 lambda 自身执法遍负责）。
不安全 函数 显捕扫区间(向量<节点> 池, 整64 起, 整64 止,
                  向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断,
                  整64 参数层索引, 整64 捕获起, 整64 捕获数) -> 空类型 {
    整64 i1692 = 起;
    当 (i1692 >= 0 && i1692 < 止 && i1692 < 池.大小()) {
        节点 n1692 = 池.元素(整32(i1692));
        如果 (n1692.类型 == 节点_标识符) {
            如果 (!是lambda合成函数名(整64(n1692.文本))) {
                显捕判读位(符号表, 诊断, 整64(n1692.文本),
                           参数层索引, 捕获起, 捕获数);
            }
        } 否则 如果 (n1692.类型 == 节点_赋值) {
            如果 (整64(n1692.文本) != 0) {
                显捕判读位(符号表, 诊断, 整64(n1692.文本),
                           参数层索引, 捕获起, 捕获数);
            }
        }
        i1692++;
    }
}

// 体块树递归（登记lambda体推断声明/检查合成体块逃逸 同款覆盖）：块语句序
//   线性扫+如果/当/情况体递归。字段约定=解析层构造惯例（同 #486 遍）：如果
//   语句 文本=条件起点·子起点=条件终点·附加=真块索引·子终点=否则链节点索引；
//   当语句 文本=条件起点·子起点=条件终点·附加=体块索引；情况标签 文本=值
//   起点（否则标签=0）·子起点=体块索引；赋值 文本=纯标识符左值名·附加=复合
//   左值链起点（文本==0 恒带链起·闭集）·子起点=右值区间起；调用语句根
//   子起点=被调索引·[子起点, 本语句池位)=被调+实参连续区间（后缀序）。
不安全 函数 检查合成体块显捕(向量<节点> 池, 整64 块索引,
                       向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断,
                       整64 参数层索引, 整64 捕获起, 整64 捕获数) -> 空类型 {
    如果 (块索引 < 0 || 块索引 >= 池.大小()) { 返回; }
    节点 块1692 = 池.元素(整32(块索引));
    整64 si1692 = 整64(块1692.子起点);
    当 (si1692 < 整64(块1692.子终点)) {
        节点 语句1692 = 池.元素(整32(si1692));
        整64 st1692 = 语句1692.类型;
        如果 (st1692 == 节点_变量声明 || st1692 == 节点_返回语句 ||
             st1692 == 节点_表达式语句) {
            显捕扫区间(池, 整64(语句1692.子起点), 整64(语句1692.子终点),
                     符号表, 诊断, 参数层索引, 捕获起, 捕获数);
        } 否则 如果 (st1692 == 节点_赋值) {
            如果 (整64(语句1692.文本) != 0) {   // 纯标识符左值：文本位补判
                显捕判读位(符号表, 诊断, 整64(语句1692.文本),
                           参数层索引, 捕获起, 捕获数);
            }
            // 静默豁免业务值: 单边守卫——复合左值链附加段存在性判定（0=无链·节点池下标哨兵），非业务区间判定
            如果 (整64(语句1692.附加) > 0) {    // 复合左值链=[附加, 右值起)
                显捕扫区间(池, 整64(语句1692.附加), 整64(语句1692.子起点),
                         符号表, 诊断, 参数层索引, 捕获起, 捕获数);
            }
            显捕扫区间(池, 整64(语句1692.子起点), 整64(语句1692.子终点),
                     符号表, 诊断, 参数层索引, 捕获起, 捕获数);
        } 否则 如果 (st1692 == 节点_调用) {
            显捕扫区间(池, 整64(语句1692.子起点), si1692,
                     符号表, 诊断, 参数层索引, 捕获起, 捕获数);
        } 否则 如果 (st1692 == 节点_如果语句) {
            显捕扫区间(池, 整64(语句1692.文本), 整64(语句1692.子起点),
                     符号表, 诊断, 参数层索引, 捕获起, 捕获数);
            检查合成体块显捕(池, 整64(语句1692.附加), 符号表, 诊断,
                           参数层索引, 捕获起, 捕获数);
            整64 链游1692 = 整64(语句1692.子终点);
            当 (链游1692 != 0 && 链游1692 > 0 && 链游1692 < 池.大小()) {
                节点 链节1692 = 池.元素(整32(链游1692));
                如果 (链节1692.类型 == 节点_如果语句) {
                    显捕扫区间(池, 整64(链节1692.文本), 整64(链节1692.子起点),
                             符号表, 诊断, 参数层索引, 捕获起, 捕获数);
                    检查合成体块显捕(池, 整64(链节1692.附加), 符号表, 诊断,
                                   参数层索引, 捕获起, 捕获数);
                    链游1692 = 整64(链节1692.子终点);
                } 否则 如果 (链节1692.类型 == 节点_块) {
                    检查合成体块显捕(池, 链游1692, 符号表, 诊断,
                                   参数层索引, 捕获起, 捕获数);
                    链游1692 = 0;
                } 否则 如果 (链节1692.类型 != 节点_如果语句) {
                    // 链上其余节点（非如果语句/非块）=链尾终止（否则分支显式条件枚举·else 新规）
                    链游1692 = 0;
                }
            }
        } 否则 如果 (st1692 == 节点_当语句) {
            显捕扫区间(池, 整64(语句1692.文本), 整64(语句1692.子起点),
                     符号表, 诊断, 参数层索引, 捕获起, 捕获数);
            检查合成体块显捕(池, 整64(语句1692.附加), 符号表, 诊断,
                           参数层索引, 捕获起, 捕获数);
        } 否则 如果 (st1692 == 节点_情况标签) {
            // 情况值段=[文本, 体块内容起)：解析序=值段→体块内容段→体块节点
            //   →标签节点（标签 子起点=体块节点索引）——体块内容由下方递归
            //   查，此处上界取体块节点的内容起点（防体块段重复扫描=重复诊断）
            // 静默豁免业务值: 单边守卫——情况值段存在性判定（0=无值段·解析序哨兵），非业务区间判定
            如果 (整64(语句1692.文本) > 0) {
                节点 体块1692 = 池.元素(整32(语句1692.子起点));
                显捕扫区间(池, 整64(语句1692.文本), 整64(体块1692.子起点),
                         符号表, 诊断, 参数层索引, 捕获起, 捕获数);
            }
            检查合成体块显捕(池, 整64(语句1692.子起点), 符号表, 诊断,
                           参数层索引, 捕获起, 捕获数);
        } 否则 如果 (st1692 == 节点_块) {
            检查合成体块显捕(池, si1692, 符号表, 诊断,
                           参数层索引, 捕获起, 捕获数);
        }
        si1692++;
    }
}

// #1692 入口（lambda合成类型 挂载·逃逸遍之后·表弹出前）：形态 2 显式层执法。
//   形态/起/数 三表由语法层 解析lambda原子 对每个 lambda 恒登记（形态 miss=
//   符号表内部不一致→648 显形不中断·起/数在形态==2 分支恒登记同理）。
不安全 函数 检查合成体显捕(向量<节点> 池, 整64 合成索引, 整64 名ID,
                      向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    结果<整64, 整32> 查重1692 = 合成体显捕已查们.获取(名ID);
    如果 (查重1692.正常) { 返回; } 否则 { }
    结果<空类型, 整32> 登查1692 = 合成体显捕已查们.设置(名ID, 1);
    如果 (!登查1692.正常) { 运行时错误(4); }
    结果<整64, 整32> 查形1692 = lambda捕获形态们.获取(名ID);
    如果 (!查形1692.正常) {
        登记内部未登记("lambda 显捕执法捕获形态 miss",
                       字符串复制(驻留文本(名ID)), 整64(取当前诊断行()));
        返回;
    }
    如果 (查形1692.值 != 2) { 返回; }   // 非 [变量] 显式层=隐式收集既有语义放行
    结果<整64, 整32> 查起1692 = lambda捕获起们.获取(名ID);
    结果<整64, 整32> 查数1692 = lambda捕获计数们.获取(名ID);
    整64 起v1692 = 0;
    整64 数v1692 = 0;
    如果 (查起1692.正常) {
        如果 (查数1692.正常) {
            起v1692 = 查起1692.值;
            数v1692 = 查数1692.值;
        } 否则 {
            登记内部未登记("lambda 显捕执法捕获计数 miss",
                           字符串复制(驻留文本(名ID)), 整64(取当前诊断行()));
        }
    } 否则 {
        登记内部未登记("lambda 显捕执法捕获起 miss",
                       字符串复制(驻留文本(名ID)), 整64(取当前诊断行()));
    }
    // 体块索引=合成函数节点 子终点（语法层 解析lambda延后段们 构造惯例）
    节点 合成1692 = 池.元素(整32(合成索引));
    整64 参数层索引1692 = 符号表.大小() - 1;
    检查合成体块显捕(池, 整64(合成1692.子终点), 符号表, 诊断,
                   参数层索引1692, 起v1692, 数v1692);
}
