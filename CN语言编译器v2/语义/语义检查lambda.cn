// CN 自举编译器 v2 · 语义检查 lambda 族（#276 波1·405 轮警戒线拆分）：
//   lambda合成类型（070 波B 挪入）+ 捕获形态/类型回填/体扫描收集（波1 新增）。
//   归属=语义包（lambda 合成函数签名推导与捕获语义·单一归属）。
导入 容器::向量;
导入 映射集合;
导入 语法;
导入 协议常量;

公开:   // 全文件公开（lambda 族供 语义检查表达式 等兄弟模块经合并全局池解析）

// 070 波B（1022）：lambda 合成函数类型推导——名ID → 函数指针<返回>(参数…)。
//   合成函数节点：文本=?lambdaN·类型位=返回类型ID（0=无标注待推导）·
//   子起点=参数节点区间起·子终点=体块索引（参数区间=[子起点, 子终点)）。
函数 lambda合成类型(整64 名ID, 向量<节点> 池, 向量<映射<整64, 符号>>& 符号表,
                   向量<字符串>& 诊断) -> 整64 {
    整64 合成索引 = -1;
    整64 li = lambda合成函数索引们.大小() - 1;
    当 (li >= 0) {
        整64 cand = lambda合成函数索引们.元素(li);
        节点 cand节点 = 池.元素(整32(cand));
        如果 (整64(cand节点.文本) == 名ID) { 合成索引 = cand; 中断; }
        li--;
    }
    如果 (合成索引 < 0) { 返回 -1; }
    节点 合成 = 池.元素(整32(合成索引));
    // #276 波1：捕获参数类型回填+存在性校验（宿主 visitLambdaExpr 捕获分析
    //   同位）——捕获参数节点（补解析头插·附加=0 类型占位）查外层变量类型
    //   回填（池尾追加类型节点·附加=其索引·参数区间消费惯例同构）；显式捕获
    //   未声明=诊断（361 负测锚·宿主同语「lambda 捕获的变量 'x' 未声明」）。
    //   回填在推导前：参数注册循环按 附加>0 自动含捕获名（体内可见=捕获参数
    //   槽·690 隐式捕获空捕获面同修）。类型序不经平铺表——捕获参数节点附加
    //   即类型载体（调用点/IR 层池读·零特判）。
    整64 捕获形态 = 0;
    结果<整64, 整32> 查回填形态 = lambda捕获形态们.获取(名ID);
    如果 (查回填形态.正常) { 捕获形态 = 查回填形态.值; }
    整64 捕获数 = 0;
    如果 (捕获形态 != 3) {   // 0/1/2：[] 隐式与 [=]/[变量] 同回填
        结果<整64, 整32> 查起 = lambda捕获起们.获取(名ID);
        结果<整64, 整32> 查数 = lambda捕获计数们.获取(名ID);
        整64 起v = 0;
        整64 数v = 0;
        如果 (查起.正常) {
            如果 (查数.正常) {
                起v = 查起.值;
                数v = 查数.值;
            }
        }
        捕获数 = 数v;
        整64 ci = 起v;
        当 (ci < 起v + 数v) {
            整64 捕名 = lambda捕获名序们.元素(整32(ci));
            // 外层查型（栈顶向下·表查找类型ID 现成）——捕型>0 即捕获（函数名
            //   误收=函数指针值快照·调用语义等价；-1=未声明→361 锚诊断+
            //   整32 占位防雪崩·宿主诊断后继续检查同形）。
            整64 捕型 = 表查找类型ID(符号表, 捕名);
            如果 (捕型 < 0) {
                字符串 报文 = 字符串复制("lambda 捕获的变量 '");
                报文 = 报文 + 驻留文本(捕名);
                报文 = 报文 + "' 未声明";
                结果<空类型, 整32> 登诊 = 诊断.追加(报文);
                如果 (!登诊.正常) { 运行时错误(4); }
                捕型 = 驻留("整32");
            }
            // 池尾追加类型节点（文本=类型ID·声明区间外=主循环不遍历）+
            //   回填捕获参数节点 附加=其索引
            整64 类型节点索引 = 池.大小();
            池追加(池, 建节点(节点_标识符, 整32(捕型), 0, 0, 0));
            整64 参数位 = 整64(合成.子起点) + (ci - 起v);
            节点 捕获参数节点 = 池.元素(整32(参数位));
            捕获参数节点.附加 = 类型节点索引;
            结果<空类型, 整32> 设参 = 池.设置(整32(参数位), 捕获参数节点);
            如果 (!设参.正常) { 运行时错误(4); }
            // 433（701）：池回填**层间按值传递对 IR 层不可见**（生成声明 46-c
            //   同款坑）——补跨层静态表登记（IR 层 登记参数槽 对无类型节点
            //   的捕获形参查表合成类型替身：结构体多槽/变量类型权威表/类型码
            //   分派全链生效）
            登记lambda捕获参数类型(整64(合成.文本), 捕名, 捕型);
            ci++;
        }
    }
    // 函数节点字段约定（语法分析.cn:251 建节点先例）：文本=名ID·**附加=返回
    //   类型ID**·子起点=参数区间起·子终点=体块索引——返回类型读 附加 位。
    整64 返回ID = 整64(合成.附加);
    如果 (返回ID == 0) {
        // 返回推导：扫体块语句区间找 返回语句（宿主单一返回推导同语义）——
        //   恰一个带表达式 返回 → 表达式类型；无返回语句 → 空类型；
        //   推导成功写回池（IR 生成合成函数读类型位·103-a 池.设置 先例）。
        //   扫体前压 lambda 参数作用域（宿主 visitLambdaExpr pushScope 同构——
        //   587 实录：无作用域层=推导体内参数引用全报「未声明标识符」），
        //   参数类型ID=参数类型节点文本（解析参数 建节点 惯例·附加=类型节点索引）。
        表压入(符号表);
        整64 参数遍 = 整64(合成.子起点);
        当 (参数遍 < 整64(合成.子终点)) {
            节点 参数节点 = 池.元素(整32(参数遍));
            如果 (参数节点.类型 == 节点_参数 && 整64(参数节点.附加) > 0 &&
                 整64(参数节点.附加) < 池.大小()) {
                节点 参数类型节点 = 池.元素(整32(参数节点.附加));
                整64 忽略reg = 表注册(符号表, 整64(参数节点.文本),
                                     整64(参数类型节点.文本), 符号_变量, 0);
                如果 (忽略reg == 0) { }
            }
            参数遍++;
        }
        节点 体块 = 池.元素(整32(合成.子终点));
        整64 推断ID = 0;
        整64 返回数 = 0;
        整64 si = 整64(体块.子起点);
        当 (si < 整64(体块.子终点)) {
            节点 语句 = 池.元素(整32(si));
            如果 (语句.类型 == 节点_返回语句 && 整64(语句.子终点) > 整64(语句.子起点)) {
                返回数++;
                整64 推 = 表达式类型ID(池, 整32(整64(语句.子终点) - 1), 符号表, 诊断);
                如果 (推 > 0) { 推断ID = 推; }
            }
            si++;
        }
        表弹出(符号表);
        如果 (返回数 == 0) { 推断ID = 驻留("空类型"); }
        如果 (推断ID > 0) {
            返回ID = 推断ID;
            合成.附加 = 推断ID;
            结果<空类型, 整32> 设推 = 池.设置(整32(合成索引), 合成);
            如果 (!设推.正常) { 运行时错误(4); }
        } 否则 {
            返回ID = 驻留("空类型");
        }
    }
    // 参数类型串拼函数指针类型文本：函数指针<返回>(p1,p2)（T69 480-a 合成约定
    //   IR布局.cn:566 同款——是函数指针类型文本 前缀判定的合法形态）。
    //   #276 波1：跳过捕获参数（区间头 捕获数 个）——签名口径=用户形参
    //   （调用检查实参数比对/与宿主变量类型文本对齐；捕获实参由调用点展开）。
    字符串 类型串 = 字符串复制("函数指针<");
    类型串 = 类型串 + 驻留文本(返回ID);
    类型串 = 类型串 + ">(";
    整64 pi = 整64(合成.子起点) + 捕获数;
    整64 参数数 = 0;
    当 (pi < 整64(合成.子终点)) {
        节点 参数节点 = 池.元素(整32(pi));
        如果 (参数节点.类型 == 节点_参数) {
            如果 (参数数 > 0) { 类型串 = 类型串 + ","; }
            节点 参数类型节点 = 池.元素(整32(参数节点.附加));
            类型串 = 类型串 + 驻留文本(整64(参数类型节点.文本));
            参数数++;
        }
        pi++;
    }
    类型串 = 类型串 + ")";
    返回 驻留(类型串);
}

// plans/018 第 3 层：限定合成名（工具库::版本）——语句根区间线性检查会
//   把调用被调标识符当裸标识符送达本分支（检查块 语句根派发惯例：每节点
//   恰在其作用域访问一次）。stdlib 限定已由上方内置表命中；此处解析用户

// #276 波1：lambda 合成函数名判定（?前缀·主遍历体检查跳过用）——合成函数
//   语义=lambda合成类型 推导扫描专属（参数/捕获作用域内）；主遍历无参作用域
//   查体=体内名落全局三级键基碰撞（688 实录：x→「模块」错诊断）。
函数 是lambda合成函数名(整64 名ID) -> 布尔 {
    字符串 名 = 字符串复制(驻留文本(名ID));
    如果 (字符串长度(名) > 0) {
        如果 ((整64(名[0]) & 255) == 整64('?')) { 返回 真; }
    }
    返回 假;
}
