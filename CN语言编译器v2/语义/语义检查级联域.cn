// CN 自举编译器 v2 · 语义检查级联域（#1943 拆分新增·语义检查.cn 越警戒线先
//   拆再加外移·926/1029/546 先例同款）
// 职责：结构体域外类字段访问编译期拒绝（001 §3.9 结构体面·宿主
//   semantic_expr_access visitMemberExpr 同构·双侧零分叉）——级联闭合域=
//   有析构+拷贝构造+无参构造三链齐（与 IR 生成声明尾 860-a 级联注入同判据）；
//   域外字段=零初始化空句柄，句柄访问原行为=运行期「运行时错误(错误码3)」
//   空指针解引用——前置编译期显式拒绝（读拒=禁崩溃；写活句柄同拒=整体拷贝
//   浅共享双主 UAF 口子关闭·安全红线）。闭合域内字段不受影响。
//   消费=语义检查.cn 检查成员访问表达式（成员读全路径公共面单点分派）。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（目录包名）
导入 IR;         // 类有析构/查类拷贝构造串/查类构造参数串/是用户类/查字段类型ID
导入 协议常量;   // 335 重构B：协议常量独立包

公开:

函数 检查级联域(向量<节点> 池, 节点 n,
                 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    //   对象形态=标识符直访（链中段/下标形态=诚实边界·与 375 联合体扩面同
    //   口径存量）；诊断文本与宿主逐字一致。
    //   可选消费=有值检查后立即提取局部（v2 可选执法标记不跨嵌套·全包同模式）；
    //   正类型ID 判定入布尔变量（条件位无数值比较·单边比较禁令清偿形态）。
    布尔 有对象基 = n.子起点 > 0 && 整64(n.子起点) < 池.大小();
    如果 (有对象基) {
        节点 成员对象 = 池.元素(整32(n.子起点));
        如果 (成员对象.类型 == 节点_标识符) {
            可选<整64> 对象类型查 = 表查找类型ID(符号表, 整64(成员对象.文本));
            如果 (对象类型查.有值) {
                整64 对象类型 = 对象类型查.值;
                // 正类型ID 才是登记类型（0=占位非类型·1029 同款布尔包装）
                布尔 对象有型 = 对象类型 > 0;
                如果 (对象有型) {
                    字符串 对象文本 = 字符串复制(驻留文本(对象类型));
                    整64 对象文本长 = 字符串长度(对象文本);
                    // 剥指针尾星（101 联合体检查同款·指针对象自动解引用一级）
                    布尔 带星尾 = 对象文本长 > 0 &&
                        (整64(对象文本[整32(对象文本长 - 1)]) & 255) == 42;
                    如果 (带星尾) {
                        对象文本 = 字符串子串(对象文本, 0,
                                              整32(对象文本长 - 1));
                    }
                    可选<整64> 结构键查 = 查结构体类型(驻留(对象文本));
                    如果 (结构键查.有值) {
                        整64 结构键 = 结构键查.值;
                        // 类排除（宿主 findStruct 对类恒 miss 同构）：类对象的
                        //   类字段有级联默认构造承诺（001 §3.9 类面），域检查
                        //   只管结构体面（类布局同登结构体表·须显式排除防误拦）
                        可选<整64> 类节点查 = 查类节点索引(对象类型);
                        如果 (!类节点查.有值) {
                            可选<整64> 字段类型查 =
                                查字段类型ID(结构键, 整64(n.文本));
                            如果 (字段类型查.有值) {
                                整64 字段类型 = 字段类型查.值;
                                字符串 字段文本 =
                                    字符串复制(驻留文本(字段类型));
                                如果 (是用户类(字段文本)) {
                                    // 1541 B2：有值=拷贝构造/无参构造已登记（原 !=0 判据）
                                    布尔 域内 = 类有析构(字段类型) &&
                                                    查类拷贝构造串(字段类型).有值 &&
                                                    查类构造参数串(字段类型, 0).有值;
                                    如果 (!域内) {
                                        表诊断(诊断, "[错误] 结构体 '" + 对象文本 +
                                            "' 的类字段 '" +
                                            字符串复制(驻留文本(整64(n.文本))) +
                                            "'（类 '" + 字段文本 +
                                            "'）未级联构造（级联闭合域=有析构+拷贝构造+默认构造）：字段类须补全三构造入闭合域，或改用类外层承载");
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
