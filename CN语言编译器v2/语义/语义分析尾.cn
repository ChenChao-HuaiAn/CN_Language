// 语义分析尾（357 重构F2 自 语义分析.cn 纯机械搬移·函数体逐字保留·零逻辑变化）

导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（原 语法分析，阶段目录包名）
导入 IR;         // 容器/结果 合成名判定 + 节点_*/键位移 常量（原 IR容器+IR常量 合并目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

不安全 函数 设当前诊断行(整32 行) -> 空类型 {
    当前诊断行103 = 行;
}

函数 取当前诊断行() -> 整32 {
    返回 当前诊断行103;
}

函数 表诊断(向量<字符串>& 诊断, 字符串 消息) -> 空类型 {
    // 103-a（D2）：诊断输出追加「（行=N）」（行>0 时；对齐语法层 打印到错误
    //   的（行=）后缀格式）。行=0=未知→原样输出（存量兼容）。
    如果 (当前诊断行103 > 0) {
        结果<空类型, 整32> 加行 = 诊断.追加(
            消息 + "（行=" + 整数转字符串(整64(当前诊断行103)) + "）");
        如果 (!加行.正常) { 运行时错误(4); }
        返回;
    }
    结果<空类型, 整32> 加 = 诊断.追加(消息);
    如果 (!加.正常) { 运行时错误(4); }
}
// ==================== 声明收集（第一趟：函数/结构体签名） ====================
// 呈报③方案A（2026-09-06）：函数登记键=签名键 名#参数串（宿主 signatureKey
//   对齐）——同名不同参数串=重载共存（多键）；同名同参数串=重定义诊断
//   （原纯名键注册失败被静默吞：`如果 (忽略 == 0) { }`——静默覆盖家族）。
//   同步登记函数签名表（语义层未声明检查回退用；IR生成入口清空重收集=权威）。
//   双键补登记（2026-09-06 用户裁决方案A）：纯名键同名唯一时补——既有纯名
//   查函数消费点（是引用返回调用 等）零回归（E2E 150 解锁暴露回归根因）。
// ==================== plans/019 阶段3b 残余（2026-09-10 第六十五轮） ====================
// 函数参数借用位表：签名键*键位移+参数序 -> 1=引用形参（类型节点附加>=256）/
//   常量引用形参（附加==257）——声明收集 登记，检查调用表达式 借用纪律消费。
静态 映射<整64, 整64> 函数参数引用位们;
静态 映射<整64, 整64> 函数参数常量位们;

函数 查函数参数引用位(整64 签名键, 整64 参数序) -> 整64 {
    结果<整64, 整32> 查 = 函数参数引用位们.获取(签名键 * 键位移 + 参数序);
    如果 (查.正常) { 返回 查.值; }
    返回 0;
}

函数 查函数参数常量位(整64 签名键, 整64 参数序) -> 整64 {
    结果<整64, 整32> 查 = 函数参数常量位们.获取(签名键 * 键位移 + 参数序);
    如果 (查.正常) { 返回 查.值; }
    返回 0;
}

不安全 函数 声明收集(向量<节点> 池, 整32 程序节点, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断,
              字符串 模块路径, 映射<整64, 整64>& 公开表) -> 空类型 {
    整64 本模块ID = 驻留(模块路径);
    节点 程序 = 池.元素(程序节点);
    整64 i = 整64(程序.子起点);
    当 (i < 整64(程序.子终点)) {
        节点 声明 = 池.元素(整32(i));
        // 可见性（plans/018 第 3 层：公开: 标签块——语法层 顶层公开们 快照；
        //   缺省私有。符号.附加=1 公开——跨模块 ②②③ 解析只认公开成员）
        整64 是否公开 = 0;
        结果<整64, 整32> 查公开 = 公开表.获取(整64(i));
        如果 (查公开.正常) { 是否公开 = 1; }
        // 192-a：本函数 171 行按「声明类型」提取为 5 个收集族子方法（纯搬运
        //   零行为变更——多重集核验先行于构建）。
        如果 (声明.类型 == 节点_函数) {
            收集函数声明(池, 整32(i), 符号表, 诊断, 模块路径, 本模块ID, 是否公开);
        }
        如果 (声明.类型 == 节点_结构体) {
            收集结构体声明(池, 整32(i), 符号表, 诊断, 模块路径, 本模块ID, 是否公开);
        }
        如果 (声明.类型 == 节点_枚举) {
            // 418-a（D40 细分）：枚举收集——模块成员键基/公开登记（三级决议
            //   跨模块 导入 模块::枚举名 校验消费）
            收集枚举声明(池, 整32(i), 模块路径, 本模块ID, 是否公开);
        }
        如果 (声明.类型 == 节点_类) {
            收集类声明(池, 整32(i), 符号表, 诊断, 模块路径, 本模块ID, 是否公开);
        }
        如果 (声明.类型 == 节点_接口声明) {
            // 413（2026-10-11）：接口收集——类型符号登记（符号_结构体 口径复用：
            //   类型引用检查/变量声明「未声明的类型」放行；接口不可实例化由
            //   构造面缺签名天然拒绝——宿主 isInterfaceType 同为类型域成员）
            收集接口声明(池, 整32(i), 符号表, 模块路径, 本模块ID, 是否公开);
        }
        如果 (声明.类型 == 节点_常量声明) {
            收集常量声明(池, 整32(i), 符号表, 诊断, 模块路径, 本模块ID, 是否公开);
        }
        如果 (声明.类型 == 节点_静态声明) {
            收集静态声明(池, 整32(i), 符号表, 诊断, 模块路径, 本模块ID, 是否公开);
        }
        i++;
    }
    // 984（002·309·953 工单根治）：内建编译期常量 调试模式 收集期注入——
    //   规格书 3.8/宿主 239-a（默认调试构建=真·布尔·用户同名常量优先）。
    //   953 旧注入=检查趟 表注册(符号表, 纯名)——但全局层查询走 三级键基
    //   （模块成员索引域）·纯名键永不命中=未声明（表查找类型ID i==1 分支
    //   键域错位实锤）——改 收集族同款通道：复合键基+成员索引+公开三登记。
    整64 名984 = 驻留("调试模式");
    结果<整64, 整32> 查重984 = 模块成员键基们.获取(模块成员键(本模块ID, 名984));
    如果 (!查重984.正常) {
        整64 键基984 = 键基合成(模块路径, 名984);
        整64 忽略984 = 表注册(符号表, 键基984, 驻留("布尔"), 符号_常量, 1);
        如果 (忽略984 == 0) { }
        // 1011（353·v2 语义同拒）：补纯名注册到当前（全局）层——984 原只登记
        //   复合键基（三级解析/声明检查可见），纯名查询路径（推导源类型ID静默
        //   的 表查找类型ID）查不到 → 布尔常量赋 字符串 目标时源类型推导 -1
        //   放行（宿主拒绝 v2 宽松·353 负测双测红）。纯名与键基双注册后：局部
        //   层同名用户变量仍按表查找「从顶向下」先命中（遮蔽语义天然正确）。
        整64 忽略984纯 = 表注册(符号表, 名984, 驻留("布尔"), 符号_常量, 1);
        如果 (忽略984纯 == 0) { }
        结果<空类型, 整32> 设984 = 模块成员键基们.设置(
            模块成员键(本模块ID, 名984), 键基984);
        如果 (!设984.正常) { 运行时错误(4); }
        结果<空类型, 整32> 设公984 = 模块成员公开们.设置(
            模块成员键(本模块ID, 名984), 1);
        如果 (!设公984.正常) { 运行时错误(4); }
    }
}


// ==================== 192-a 收集族子方法（原 声明收集 707~862 段） ====================

// 418-a（D40 细分）：枚举收集——模块成员键基/公开登记（三级解析 ①③ 数据源；
//   导入 工具::错误码 校验消费）。成员常量值表由语法层 解析枚举声明 登记
//   （枚举表·驻留 ID 全局唯一=跨模块直查）。
不安全 函数 收集枚举声明(向量<节点> 池, 整32 声明索引, 字符串 模块路径, 整64 本模块ID, 整64 是否公开) -> 空类型 {
    节点 声明 = 池.元素(声明索引);
    整64 键基e = 键基合成(模块路径, 整64(声明.文本));
    结果<空类型, 整32> 设成员e = 模块成员键基们.设置(
        模块成员键(本模块ID, 整64(声明.文本)), 键基e);
    如果 (!设成员e.正常) { 运行时错误(4); }
    如果 (是否公开 == 1) {
        结果<空类型, 整32> 设公开e = 模块成员公开们.设置(
            模块成员键(本模块ID, 整64(声明.文本)), 1);
        如果 (!设公开e.正常) { 运行时错误(4); }
    }
}

// 592-a（D40·原型声明覆盖语义）：原型函数键集合——无体原型（空块）登记键=1；
//   同名有体定义到达时=覆盖（移出豁免·值改 2）——宿主 C++ 前向声明同款：
//   原型与定义共存合法，真体取代原型。
静态 映射<整64, 整32> 原型函数键们;


不安全 函数 收集函数声明(向量<节点> 池, 整32 声明索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断,
              字符串 模块路径, 整64 本模块ID, 整64 是否公开) -> 空类型 {
    节点 声明 = 池.元素(声明索引);
// 族①：函数声明收集（原 707~768 段）——参数串/链接键/签名键/参数借用位
//   （引用位/常量位）/重定义诊断/模块成员索引/公开标记/主模块双键登记。
            字符串 参数串 = 函数参数串(池, 整32(声明索引));
            // 593（2026-10-14 任务593）：返回类型「元素数组」=返回值形态实例化
            //   面（宿主 checkFunctionBody 593 同构·specs/06 §八·193 数组形态
            //   漏网根治）。挂收集期=原型与有体定义统一覆盖（声明面即实例化
            //   承诺面）；附加=返回类型名ID（0=无返回——守卫 >0）；文本含
            //   &/* 后缀（解析层显式并入）时 helper 判非数组自然放行=引用/
            //   指针返回不实例化（193 口径）。
            如果 (声明.附加 > 0) {
                如果 (报抽象数组声明诊断593(字符串复制(驻留文本(整64(声明.附加))), 诊断)) { }
                // 746（2026-10-14 任务746）：单值返回=按值复制实例化面（宿主
                //   checkFunctionBody 746 同构·与 593 并列互斥分工——数组归上
                //   helper·单值归下·引用/指针后缀文本查表自然 miss=193 口径）。
                如果 (报抽象单值声明诊断746(字符串复制(驻留文本(整64(声明.附加))),
                        "按值返回", 假, 诊断)) { }
            }
            // plans/018 第 3/4 层：登记键升级为链接键（键基#参数串）——键基=
            //   主模块纯名（行为不变）/其余 模块$名（跨模块同名合法共存）
            整64 键基i = 键基合成(模块路径, 整64(声明.文本));
            登记函数签名K(池, 整32(声明索引), 键基i);
            整64 签名键 = 函数签名键(键基i, 参数串);
            整64 忽略 = 表注册(符号表, 签名键, 整64(声明.附加), 符号_函数, 是否公开);
            // plans/019 阶段3b：参数借用位登记（引用位/常量位——类型节点附加
            //   >=256=引用、==257=常量引用；无类型节点参数跳过）
            整64 参数序 = 0;
            整64 参数游标 = 整64(声明.子起点);
            当 (参数游标 < 整64(声明.子终点)) {
                节点 参数节点p = 池.元素(整32(参数游标));
                如果 (参数节点p.类型 == 节点_参数) {
                    如果 (参数节点p.附加 >= 0 && 参数节点p.附加 < 整64(池.大小())) {
                        节点 参数类型节点p = 池.元素(整32(参数节点p.附加));
                        如果 (参数类型节点p.类型 == 节点_类型) {
                            // 593：数组值形参=逐元素默认构造实例化面（宿主
                            //   checkFunctionBody 593 同构）。附加==0 纯值形态
                            //   守卫（引用 256/常量引用 257/指针层 1..255 不经
                            //   此——指针数组 图形*[3] 附加=0 但元素=「图形*」
                            //   helper 查表自然 miss 放行=193 口径双侧一致）。
                            如果 (参数类型节点p.附加 == 0) {
                                如果 (报抽象数组声明诊断593(
                                        字符串复制(驻留文本(整64(参数类型节点p.文本))),
                                        诊断)) { }
                                // 746：单值形参=按值复制实例化面（宿主 746 同构·
                                //   与 593 并列互斥·附加==0 纯值同守卫）。
                                如果 (报抽象单值声明诊断746(
                                        字符串复制(驻留文本(整64(参数类型节点p.文本))),
                                        "按值形参", 假, 诊断)) { }
                            }
                            如果 (参数类型节点p.附加 >= 256) {
                                结果<空类型, 整32> 设引用位 = 函数参数引用位们.设置(
                                    签名键 * 键位移 + 参数序, 1);
                                如果 (!设引用位.正常) { 运行时错误(4); }
                            }
                            如果 (参数类型节点p.附加 == 257) {
                                结果<空类型, 整32> 设常量位 = 函数参数常量位们.设置(
                                    签名键 * 键位移 + 参数序, 1);
                                如果 (!设常量位.正常) { 运行时错误(4); }
                            }
                        }
                    }
                    参数序++;
                }
                参数游标++;
            }
            // 592-a（D40·原型覆盖语义）：当前声明体判定——函数.子终点=块索引；
            //   空块（子起点==子终点）=无体原型。
            节点 声明块节点592 = 池.元素(整64(声明.子终点));
            布尔 当前无体592 = 假;
            如果 (整64(声明.子终点) < 池.大小() &&
                 声明块节点592.类型 == 节点_块 &&
                 声明块节点592.子起点 == 声明块节点592.子终点) {
                当前无体592 = 真;
            }
            如果 (忽略 == 0) {
                // 592-a（D40·原型覆盖语义）：同名同签名=「无体原型 vs 有体定义」
                //   共存 → 真体覆盖原型（宿主 C++ 前向声明同款）不诊断；
                //   两者皆有体=真重定义 → 诊断（既有）。
                // 575-b 宿主规则3 对齐：.值 访问须在 结果.正常 检查的真分支内
                //   （内联 && 组合形态不被跟踪——231 同族约束）
                整32 原型标记592 = 0;
                布尔 原型在册592 = 假;
                结果<整32, 整32> 查原型键592 = 原型函数键们.获取(签名键);
                如果 (查原型键592.正常) {
                    原型标记592 = 查原型键592.值;
                    原型在册592 = 真;
                }
                如果 (原型在册592 && 当前无体592) {
                    // 无体原型重复声明：静默豁免
                } 否则 如果 (原型在册592 && 原型标记592 == 1 && !当前无体592) {
                    // 有体定义覆盖原型：集合值改 2（已覆盖）
                    结果<空类型, 整32> 覆盖原型592 = 原型函数键们.设置(签名键, 2);
                    如果 (!覆盖原型592.正常) { 运行时错误(4); }
                } 否则 {
                    表诊断(诊断, "[错误] 函数重定义: " + 模块路径 + "::" +
                                  驻留文本(整64(声明.文本)) + "(" + 参数串 + ")");
                }
            } 否则 如果 (当前无体592) {
                // 592-a：首次登记的无体原型 → 入集合（值 1）
                结果<空类型, 整32> 登原型592 = 原型函数键们.设置(签名键, 1);
                如果 (!登原型592.正常) { 运行时错误(4); }
            }
            // 模块成员索引（三级解析 ①③ 数据源；纯名维度——重载族共享条目，
            //   值=首登记键基）
            结果<空类型, 整32> 设成员 = 模块成员键基们.设置(
                模块成员键(本模块ID, 整64(声明.文本)), 键基i);
            如果 (!设成员.正常) { 运行时错误(4); }
            如果 (是否公开 == 1) {
                结果<空类型, 整32> 设公开 = 模块成员公开们.设置(
                    模块成员键(本模块ID, 整64(声明.文本)), 1);
                如果 (!设公开.正常) { 运行时错误(4); }
            }
            // 双键登记（2026-09-06 缺陷零容忍）：纯名键——仅主模块（键基=纯名，
            //   行为不变）。非主模块纯名查找经三级解析（①成员索引）覆盖，不再
            //   平铺（平铺=跨模块同名遮蔽/先收集赢 的旧静默语义，已废止）。
            如果 (是主模块路径(模块路径)) {
                整64 查纯名候选 = 查函数签名个数(键基i);
                如果 (查纯名候选 >= 0) {
                    如果 (查纯名候选 == 1) {
                        整64 纯名忽略 = 表注册(符号表, 键基i, 整64(声明.附加), 符号_函数, 是否公开);
                        如果 (纯名忽略 == 0) { }
                    }
                }
            }
        }

不安全 函数 收集结构体声明(向量<节点> 池, 整32 声明索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断,
              字符串 模块路径, 整64 本模块ID, 整64 是否公开) -> 空类型 {
    节点 声明 = 池.元素(声明索引);
// 族②：结构体声明收集（原 770~804 段）——含 164-a A4 联合体成员类型限定
//   （「手动释放」标注豁免，对标 Rust union 成员须 Copy）。
            整64 键基s = 键基合成(模块路径, 整64(声明.文本));
            整64 忽略2 = 表注册(符号表, 键基s, 0, 符号_结构体, 是否公开);
            如果 (忽略2 == 0) { }
            // 164-a（A4 方案A·plans/023 §十二）：联合体成员类型限定（宿主
            //   isTriviallyCopyable 同构）——成员须可平凡复制；「手动释放」标注
            //   成员豁免（方案D 逃生舱，对标 Rust ManuallyDrop<T>）
            如果 (是联合体键基(键基s)) {
                整64 游标u = 整64(声明.子起点);
                当 (游标u < 整64(声明.子终点)) {
                    节点 成员u = 池.元素(整32(游标u));
                    如果 (成员u.类型 == 节点_参数) {
                        字符串 成员类型u = 字符串复制(
                            驻留文本(整64(池.元素(整32(成员u.附加)).文本)));
                        整64 分桶键u = 键基s * 键位移 + 整64(成员u.文本);
                        如果 (!是手动释放成员(分桶键u) && !可平凡复制v2(成员类型u)) {
                            表诊断(诊断, "[A4] 联合体 '" +
                                         字符串复制(驻留文本(整64(声明.文本))) +
                                          "' 成员 '" +
                                         字符串复制(驻留文本(整64(成员u.文本))) +
                                          "' 的类型 '" + 成员类型u +
                                          "' 为拥有型——联合体成员须可平凡复制（对标 Rust union 成员须 Copy）；如需手动管理请标注「手动释放」（责任移交 不安全 函数 内显式释放）");
                        }
                    }
                    游标u++;
                }
            }
            结果<空类型, 整32> 设成员s = 模块成员键基们.设置(
                模块成员键(本模块ID, 整64(声明.文本)), 键基s);
            如果 (!设成员s.正常) { 运行时错误(4); }
            如果 (是否公开 == 1) {
                结果<空类型, 整32> 设公开s = 模块成员公开们.设置(
                    模块成员键(本模块ID, 整64(声明.文本)), 1);
                如果 (!设公开s.正常) { 运行时错误(4); }
            }
        }

不安全 函数 收集类声明(向量<节点> 池, 整32 声明索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断,
              字符串 模块路径, 整64 本模块ID, 整64 是否公开) -> 空类型 {
    节点 声明 = 池.元素(声明索引);
// 族③：类声明收集（原 806~821 段）——用户类登记（类型符号=符号_结构体，
//   全链复用结构体设施）+方法签名入 IR类 类表。
            // 第七十八轮（2026-09-12）：用户类登记——类型符号=符号_结构体
            //   （类型引用检查/变量结构体登记/字段访问全链复用结构体设施）；
            //   方法签名入 IR类 类表（构造/析构/普通方法分派）
            整64 键基cls = 键基合成(模块路径, 整64(声明.文本));
            整64 忽略cls = 表注册(符号表, 键基cls, 0, 符号_结构体, 是否公开);
            如果 (忽略cls == 0) { }
            结果<空类型, 整32> 设成员cls = 模块成员键基们.设置(
                模块成员键(本模块ID, 整64(声明.文本)), 键基cls);
            如果 (!设成员cls.正常) { 运行时错误(4); }
            如果 (是否公开 == 1) {
                结果<空类型, 整32> 设公开cls = 模块成员公开们.设置(
                    模块成员键(本模块ID, 整64(声明.文本)), 1);
                如果 (!设公开cls.正常) { 运行时错误(4); }
            }
            收集类方法(池, 整32(声明索引), 诊断);
            // 193（2026-10-13 任务193）：抽象类标志收口——此刻本类方法已登记
            //   （收集类方法→类方法返回们 表）且父类先收集先收口（声明序=父先
            //   子后·立法「基类须先于派生类声明」同线）：查类方法定义层 命中
            //   本类=有体重写出集，父未实现集沿链传播（specs/06 §八·宿主
            //   class_resolver isAbstract 并入传播同构）。原挂解析期=方法表
            //   未登记全 miss→859 具体类误杀（时序实录）。
            收口类抽象性(整64(声明.文本));
            // 340-a（347）：类节点索引登记（.设置 惯例=静态方法调用·329-a 同款）
            //   ★登记时序纪律（1024 根因修复）：必须先于下方 校验接口实现齐全——
            //   该检查（方法定义层是虚修饰）经 查类节点索引 定位定义层类节点；
            //   原序=本登记挂 收集类声明 尾部（检查之后）→ 「同本类实现」（定义层
            //   =自身·最常见形态）恒查表 miss → 修饰检查恒走兜底返回真 = fail-open
            //   死路径（1024 实录三形态 v2 全放行 vs 宿主全拒）；继承实现形态
            //   （定义层=先收集的基类）本就命中——本序仅对齐自身面，语义零变化。
            结果<空类型, 整32> 设节点索引 = 类节点索引表.设置(整64(声明.文本), 整64(声明索引));
            如果 (!设节点索引.正常) { 运行时错误(4); }
            // 413（2026-10-11）：接口实现齐全性校验（宿主 verifyInterfaceImpl
            //   同构——类须沿链实现所声明接口的全部方法；缺失=显式诊断）。
            //   纪律：接口先于实现类声明（收集序=声明序·与基类「须先声明」同线）
            校验接口实现齐全(池, 整64(声明.文本), 诊断);
            // 593（2026-10-14 任务593）：类成员「抽象类/接口元素数组」值形态
            //   拦截（宿主 resolveClass 抽象标记后复查同构）——字段（实例布局
            //   逐元素默认构造实例化）与方法签名（按值形参/返回=实例化面）。
            //   挂收口类抽象性之后：自引用元素数组（抽象类自身作自身成员数组
            //   元素）亦覆盖；他类元素沿声明序立法（先声明后使用）此刻已收口。
            //   类型节点 附加==0 纯值守卫（指针/引用形态不实例化=193 口径；
            //   指针数组元素带 * 查表自然 miss）。
            整64 成员游标593 = 整64(声明.子起点);
            当 (成员游标593 < 整64(声明.子终点)) {
                节点 成员593 = 池.元素(整32(成员游标593));
                如果 (成员593.类型 == 节点_类字段 &&
                     成员593.附加 >= 0 && 成员593.附加 < 整64(池.大小())) {
                    节点 字段类型593 = 池.元素(整32(成员593.附加));
                    // 031（#1075）：放置骨架——方法值类型不可作类字段（R3 语法面）
                    如果 (字段类型593.类型 == 节点_类型) {
                        如果 (是方法值类型文本(字符串复制(驻留文本(整64(字段类型593.文本))))) {
                            表诊断(诊断, "[错误] " + 方法值放置文案1075("类字段"));
                        }
                    }
                    如果 (字段类型593.类型 == 节点_类型 && 字段类型593.附加 == 0) {
                        如果 (报抽象数组声明诊断593(
                                字符串复制(驻留文本(整64(字段类型593.文本))),
                                诊断)) { }
                        // 746：单值字段=实例布局成员复制构造（宿主 resolveClass
                        //   746 同构·与 593 并列互斥）。
                        如果 (报抽象单值声明诊断746(
                                字符串复制(驻留文本(整64(字段类型593.文本))),
                                "按值字段", 真, 诊断)) { }
                    }
                }
                如果 (成员593.类型 == 节点_方法) {
                    // 方法返回（附加=返回类型名ID·0=构造/析构归 空类型不判）
                    如果 (成员593.附加 > 0) {
                        如果 (报抽象数组声明诊断593(
                                字符串复制(驻留文本(整64(成员593.附加))),
                                诊断)) { }
                        // 746：单值方法返回（构造/析构 附加=0 归空类型不判·同 593）
                        如果 (报抽象单值声明诊断746(
                                字符串复制(驻留文本(整64(成员593.附加))),
                                "按值返回", 假, 诊断)) { }
                    }
                    // 方法形参（参数区=[子起点, 块.子起点)·函数参数串 同布局）
                    整64 参数终点593 = 整64(成员593.子终点);
                    如果 (参数终点593 >= 0 && 参数终点593 < 整64(池.大小())) {
                        节点 方法块593 = 池.元素(整32(参数终点593));
                        参数终点593 = 整64(方法块593.子起点);
                    }
                    整64 参数游标593 = 整64(成员593.子起点);
                    当 (参数游标593 < 参数终点593) {
                        节点 方法参数593 = 池.元素(整32(参数游标593));
                        如果 (方法参数593.类型 == 节点_参数 &&
                             方法参数593.附加 >= 0 &&
                             方法参数593.附加 < 整64(池.大小())) {
                            节点 方法参数类型593 = 池.元素(整32(方法参数593.附加));
                            如果 (方法参数类型593.类型 == 节点_类型 &&
                                 方法参数类型593.附加 == 0) {
                                如果 (报抽象数组声明诊断593(
                                        字符串复制(驻留文本(
                                            整64(方法参数类型593.文本))),
                                        诊断)) { }
                                // 746：单值方法形参（附加==0 纯值同守卫·宿主 746 同构）
                                如果 (报抽象单值声明诊断746(
                                        字符串复制(驻留文本(
                                            整64(方法参数类型593.文本))),
                                        "按值形参", 假, 诊断)) { }
                            }
                        }
                        参数游标593++;
                    }
                }
                成员游标593++;
            }
            // 593（类静态字段面）：静态字段走解析期合成「类$字段」登记（无
            //   节点_类字段 AST）——语义期按 类静态字段序们 序表遍历本类静态
            //   字段补判（静态存储期对象=逐元素默认构造实例化面·宿主
            //   collectClassMembers isStatic 同拦）。指针静态字段解析期登记
            //   文本不含 *（既有行为）→ helper 判非数组自然放行=既有边界。
            整64 静态序593 = 0;
            当 (静态序593 < 类静态字段序们.大小()) {
                整64 组合593 = 类静态字段序们.元素(整32(静态序593));
                如果 (组合593 / 键位移 == 整64(声明.文本)) {
                    整64 字段名593 = 组合593 - 整64(声明.文本) * 键位移;
                    整64 静态类型593 = 查类静态字段类型(整64(声明.文本), 字段名593);
                    如果 (静态类型593 > 0) {
                        如果 (报抽象数组声明诊断593(
                                字符串复制(驻留文本(静态类型593)), 诊断)) { }
                        // 746：单值类静态字段=静态存储期对象复制构造（宿主
                        //   resolveClass 746 同拦·与 593 并列互斥）。
                        如果 (报抽象单值声明诊断746(
                                字符串复制(驻留文本(静态类型593)),
                                "按值静态字段", 真, 诊断)) { }
                    }
                }
                静态序593++;
            }
        }

不安全 函数 收集常量声明(向量<节点> 池, 整32 声明索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断,
              字符串 模块路径, 整64 本模块ID, 整64 是否公开) -> 空类型 {
    节点 声明 = 池.元素(声明索引);
// 族④：常量声明收集（原 823~837 段）——P7a 顶层常量登记（类型ID 记 整64
//   名ID；分桶后跨模块常量引用经三级解析）。
            // P7a：顶层常量登记（类型ID 记 整64 名ID——v2 整数字面量统一按 整64）；
            //   多文件两趟结构下第一趟全文件收集——分桶后跨模块常量引用经
            //   三级解析（②③ 须公开；① 同模块直查）
            整64 键基c = 键基合成(模块路径, 整64(声明.文本));
            // 953/938：常量类型按初值推导——布尔字面量→布尔（953 先例）；
            //   字符串初值（字面量/前序常量引用/拼接）→字符串（938·宿主
            //   checkConstIdentifier 值文本判类型同构）；其余整64 兼容口径。
            //   推导实现落 548 常量域文件（本文件超 900 警戒线：新增逻辑
            //   外移·先拆再加精神；938 判定与 IR 折叠串面同形态覆盖）。
            整64 常量类型c953 = 推导常量类型953(池, 声明索引, 符号表, 模块路径);
            整64 忽略3 = 表注册(符号表, 键基c, 常量类型c953, 符号_常量, 是否公开);
            如果 (忽略3 == 0) { }
            // 548（编译期除零·常量传播）：顶层常量值登记（语义层值设施·宿主
            //   globalConstValues_ 机制对称——修前 v2 值内联仅 IR 层·语义阶段
            //   不可达=548 立案分叉种子）。初值子树经 折叠子树值548 求值（常量
            //   名引用已登记前序常量=链式常量可折叠·声明序单调；前向引用/浮点/
            //   布尔/字符串折叠失败不登记=除零面保守放行·宿主 registerConstValues
            //   顺序注册同口径）。多模块同名值不同由 登记顶层常量值 多义守卫。
            如果 (声明.子终点 > 声明.子起点 && 整64(声明.子终点 - 1) < 池.大小()) {
                整64 常量值548 = 0;
                如果 (折叠子树值548(池, 整32(声明.子终点 - 1), 常量值548, 0, 符号表)) {
                    登记顶层常量值(整64(声明.文本), 常量值548);
                }
            }
            结果<空类型, 整32> 设成员c = 模块成员键基们.设置(
                模块成员键(本模块ID, 整64(声明.文本)), 键基c);
            如果 (!设成员c.正常) { 运行时错误(4); }
            如果 (是否公开 == 1) {
                结果<空类型, 整32> 设公开c = 模块成员公开们.设置(
                    模块成员键(本模块ID, 整64(声明.文本)), 1);
                如果 (!设公开c.正常) { 运行时错误(4); }
            }
        }

// 615（2026-10-16·639 修复引出面）：静态指针层数表——名ID（声明文本=引用点
//   文本：顶层静态原名／函数内静态合成名（865-a 静态名归一86 单入口改写））
//   -> 指针层数（登记 >=1 指针面·消费=多级指针成员访问拦截（>=2 支）+926
//   指针成员访问安全区边界（>=1 支：静态单级 g.x 读拦截——宿主机指针面
//   同拒））。键域与 全局静态名ID们 同款（名ID·跨模块同名撞为既有惯例口径）；
//   本模块收集时登记（收集静态声明 单点）、无清空（模块级累积——与 全局静态
//   名ID们 同生命周期）。背景：修 639 后顶层 `点** g;` 声明放行，`g.x` 若不入
//   本表=多级拦截 miss 放行（宿主/语义拒 = 零分叉违例·探针 m25/m26 实测口径）。
//   926 扩展（>=2→>=1）：单级静态指针（点* g）的成员读 B9 拦截同需层数数据
//   （原仅多级登记 → 单级 miss=暗面漏拦）。
静态 映射<整64, 整64> 静态指针层数表;

不安全 函数 登记静态指针层数615(整64 名ID, 整64 层数) -> 空类型 {
    结果<空类型, 整32> 设615 = 静态指针层数表.设置(名ID, 层数);
    如果 (!设615.正常) { 运行时错误(4); }
}

// -1=非静态/非多级（调用方放行面）
函数 查静态指针层数615(整64 名ID) -> 整64 {
    结果<整64, 整32> 查615 = 静态指针层数表.获取(名ID);
    如果 (查615.正常) { 返回 查615.值; }
    返回 0 - 1;
}

不安全 函数 收集静态声明(向量<节点> 池, 整32 声明索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断,
              字符串 模块路径, 整64 本模块ID, 整64 是否公开) -> 空类型 {
    节点 声明 = 池.元素(声明索引);
// 族⑤：静态声明收集（原 839~862 段）——②c C 顶层静态登记（符号_变量）+
//   155-a B10 静态名集合追加（检查赋值语句 报「静态变量写」用）。
            // ②c C：顶层静态登记（符号_变量，全局作用域——跨函数标识符解析；
            //   类型ID 取声明附加的类型节点文本）
            // 155-a（B10）：静态名集合追加（检查赋值语句 报「静态变量写」用）
            //   865-a：原「函数内静态局部免检」随 480 整族执法收口——函数内静态
            //   与顶层静态同属静态存储期变量（473 p9 整族逃逸），改入独立集合
            //   静态局部名ID们（写位三检查点报「静态变量写」·与宿主 staticguard
            //   记账同构）；顶层静态仍入 全局静态名ID们（原语义不变）。
            如果 (声明.修饰 != 1) {
                // 569 e 款（2026-10-14 用户裁决·001 §5.2a）：顶层裸全局默认
                //   外部可见（C 式）——修饰=2 时无视 公开: 标签强制公开
                //   （对照：顶层静态保持默认私有·公开: 显式放行原语义不变）。
                如果 (声明.修饰 == 2) { 是否公开 = 1; }
                // 569 e 款查重（裸全局方向·宿主 mergeModules 合并面查重对称）：
                //   跨文件同名裸全局 / 与既有顶层静态同名 = 重定义编译错误。
                //   存量口径不动：顶层静态同名仍静默首定义（零回归面）。
                如果 (声明.修饰 == 2 &&
                     (是裸全局名569(整64(声明.文本)) || 是全局静态名(整64(声明.文本)))) {
                    表诊断(诊断, "[错误] 顶层全局变量 '" +
                                 字符串复制(驻留文本(整64(声明.文本))) +
                                 "' 重复定义（与既有声明冲突——001 §5.2a）");
                }
                如果 (声明.修饰 == 2) {
                    结果<空类型, 整32> 加裸569 = 裸全局名ID们.追加(整64(声明.文本));
                    如果 (!加裸569.正常) { 运行时错误(4); }
                }
                结果<空类型, 整32> 加静态nB10 = 全局静态名ID们.追加(整64(声明.文本));
                如果 (!加静态nB10.正常) { 运行时错误(4); }
            } 否则 {
                结果<空类型, 整32> 加静局480 = 静态局部名ID们.追加(整64(声明.文本));
                如果 (!加静局480.正常) { 运行时错误(4); }
            }
            整64 静态类型ID = 驻留("整64");
            // 守卫 >= 0（池索引 0 合法——IR生成 同款 lessons）：首静态声明的类型
            //   节点恰在池 0 时原 > 0 漏登记，类型退回 整64 默认
            如果 (声明.附加 >= 0 && 声明.附加 < 池.大小()) {
                节点 类型节点 = 池.元素(整32(声明.附加));
                静态类型ID = 整64(类型节点.文本);
                // 615：多级指针静态登记（成员访问拦截数据源——顶层静态/函数内
                //   静态同点；声明.文本=引用点文本：顶层=原名、函数内=合成名
                //   （865-a 静态名归一86 已在标识符构造点改写））
                // 926：登记面 >=2→>=1（单级静态指针的 B9 成员访问拦截同需——
                //   多级支条件 N-k>=2 对 1 天然零命中=多级拦截行为不变）
                如果 (类型节点.附加 >= 1 && 类型节点.附加 < 256) {
                    登记静态指针层数615(整64(声明.文本), 整64(类型节点.附加));
                }
                // 593：静态数组「元素数组」=静态存储期对象逐元素默认构造实例
                //   化面（宿主 visitVarDecl isStatic 路径同拦·顶层静态与类静态
                //   字段合成「类$字段」两形态统一覆盖）。附加==0 纯值守卫。
                如果 (类型节点.类型 == 节点_类型 && 类型节点.附加 == 0) {
                    如果 (报抽象数组声明诊断593(
                            字符串复制(驻留文本(整64(静态类型ID))), 诊断)) { }
                    // 746：单值顶层静态=零初始化静态存储实例化面（宿主
                    //   registerGlobalConstsAndStatics 746 同位同构——593 注
                    //   「宿主 visitVarDecl isStatic 路径同拦」系不实自述·宿主
                    //   顶层静态不走 visitVarDecl·746 宿主补齐后两侧对齐）。
                    如果 (报抽象单值声明诊断746(
                            字符串复制(驻留文本(整64(静态类型ID))),
                            "按值静态存储", 真, 诊断)) { }
                }
            }
            整64 键基st = 键基合成(模块路径, 整64(声明.文本));
            整64 忽略4 = 表注册(符号表, 键基st, 静态类型ID, 符号_变量, 是否公开);
            // 569 e 款：同文件裸全局重复（同键基注册失败）显式诊断——
            //   存量静态同名静默首定义行为不变（仅 修饰=2 新诊断面）
            如果 (忽略4 == 0) {
                如果 (声明.修饰 == 2) {
                    表诊断(诊断, "[错误] 顶层全局变量 '" +
                                 字符串复制(驻留文本(整64(声明.文本))) +
                                 "' 重复定义（同模块重复声明——001 §5.2a）");
                }
            }
            结果<空类型, 整32> 设成员st = 模块成员键基们.设置(
                模块成员键(本模块ID, 整64(声明.文本)), 键基st);
            如果 (!设成员st.正常) { 运行时错误(4); }
            如果 (是否公开 == 1) {
                结果<空类型, 整32> 设公开st = 模块成员公开们.设置(
                    模块成员键(本模块ID, 整64(声明.文本)), 1);
                如果 (!设公开st.正常) { 运行时错误(4); }
