        }




// 类方法登记（第七十八轮，2026-09-12）：遍历类区间 节点_方法 → IR类 类表——
//   构造（方法名==类名 → 构造参数串）/析构（名="~类名" → 析构存在位）/普通
//   方法（名+返回类型+参数串）。构造/析构返回类型按 空类型 归一（节点附加=0）。
//   参数串经 函数参数串（方法节点与函数节点同布局：[子起点, 块.子起点) 参数区）。
// 329-a（D38 批2·109）：类构造统计（语义侧·重载感知）——IR类 构造参数串表为
//   单串覆盖式（同名构造互相覆盖），无法表达多构造并存；裸声明无默认构造判定
//   需「构造个数>0 且无零参构造」双条件（宿主 w07 双构造放行/t30 单带参拒）。
静态 映射<整64, 整64> 类构造个数表;
静态 映射<整64, 整64> 类构造零参位表;
// 340-a（D38 批3b·347）：类节点索引表（类名ID → 类节点池索引）——成员访问
//   可见性设防现场扫类节点子区间（节点_类字段.子起点=段可见性）的数据源
静态 映射<整64, 整64> 类节点索引表;

// 414 P2：重载方法名判定——「运算符」前缀 + 后缀恰为可重载集合符号（20 符号
//   ·001 §4.6 收窄后）。防「运算符们」等普通标识符误入重载判重/校验通道。
函数 是运算符重载方法名414(整64 方法名ID) -> 布尔 {
    字符串 方法名 = 字符串复制(驻留文本(方法名ID));
    整64 前缀字节 = 字符串长度("运算符");
    如果 (字符串长度(方法名) <= 前缀字节) { 返回 假; }
    如果 (!字符串比较(字符串子串(方法名, 0, 前缀字节), "运算符")) { 返回 假; }
    字符串 符号 = 字符串子串(方法名, 前缀字节, 字符串长度(方法名) - 前缀字节);
    返回 字符串比较(符号, "!") || 字符串比较(符号, "~") ||
          字符串比较(符号, "+") || 字符串比较(符号, "-") ||
          字符串比较(符号, "*") || 字符串比较(符号, "/") ||
          字符串比较(符号, "%") || 字符串比较(符号, "==") ||
          字符串比较(符号, "!=") || 字符串比较(符号, "<") ||
          字符串比较(符号, ">") || 字符串比较(符号, "<=") ||
          字符串比较(符号, ">=") || 字符串比较(符号, "&&") ||
          字符串比较(符号, "||") || 字符串比较(符号, "&") ||
          字符串比较(符号, "|") || 字符串比较(符号, "^") ||
          字符串比较(符号, "<<") || 字符串比较(符号, ">>");
}

// 414 241-a 对齐（宿主 collectClassMembers 运算符重载参数个数校验同构·审查
//   P1-3 集合取齐）：方法名「运算符X」（解析层组合名·语法层已拦集合外符号与
//   [] / () 收窄面）。单目仅（! ~）0 个右参数；双目仅（* / % == != < <= > >=
//   && ||）恰 1 个右参数——宿主 binaryOnly 的 [] += -= *= /= 为 304 收窄后不可
//   达残留、& | ^ << >> 宿主本就不校验个数（取齐=不校验）；+ 与 - 双义（单目
//   负号/双目加）0 或 1 皆合法。校验失败=诊断+返回 假（调用方跳过登记——半
//   初始化方法表不出产物，宿主 continue 同款）。P2：仅后缀∈可重载集合才算
//   重载名（防「运算符们」等普通标识符误入判重）。注意 v2 字符串长度/子串按
//   字节（「运算符」UTF-8 9 字节·函数指针< 13 字节同例）。
函数 校验运算符重载参数414(整64 方法名ID, 字符串 参数串, 向量<字符串>& 诊断) -> 布尔 {
    如果 (!是运算符重载方法名414(方法名ID)) { 返回 真; }
    字符串 方法名 = 字符串复制(驻留文本(方法名ID));
    字符串 符号 = 字符串子串(方法名, 字符串长度("运算符"),
                            字符串长度(方法名) - 字符串长度("运算符"));
    整64 参数个数 = 参数段个数(参数串);
    布尔 单目仅 = 字符串比较(符号, "!") || 字符串比较(符号, "~");
    // P1-3：与宿主 class_resolver.cpp 241-a 现行有效集合取齐——& | ^ << >>
    //   宿主不校验个数（原 v2 多校=新增分叉）
    布尔 双目仅 = 字符串比较(符号, "*") || 字符串比较(符号, "/") ||
                 字符串比较(符号, "%") || 字符串比较(符号, "==") ||
                 字符串比较(符号, "!=") || 字符串比较(符号, "<") ||
                 字符串比较(符号, "<=") || 字符串比较(符号, ">") ||
                 字符串比较(符号, ">=") || 字符串比较(符号, "&&") ||
                 字符串比较(符号, "||");
    布尔 个数错 = (单目仅 && 参数个数 != 0) || (双目仅 && 参数个数 != 1) ||
                ((字符串比较(符号, "+") || 字符串比较(符号, "-")) && 参数个数 > 1);
    如果 (个数错) {
        表诊断(诊断, "[错误] 运算符 '" + 符号 + "' 重载参数个数错误（单目 0 个、双目 1 个右参数）");
        返回 假;
    }
    返回 真;
}

不安全 函数 收集类方法(向量<节点> 池, 整32 类节点索引, 向量<字符串>& 诊断) -> 空类型 {
    节点 类节点 = 池.元素(类节点索引);
    整64 类名ID = 整64(类节点.文本);
    字符串 类名文本 = 字符串复制(驻留文本(类名ID));
    字符串 析构名 = "~" + 类名文本;
    整64 位置 = 整64(类节点.子起点);
    当 (位置 < 整64(类节点.子终点)) {
        节点 成员 = 池.元素(整32(位置));
        如果 (成员.类型 == 节点_方法) {
            字符串 参数串 = 函数参数串(池, 整32(位置));
            整64 方法名ID = 整64(成员.文本);
            整64 返回类型ID = 整64(成员.附加);
            如果 (返回类型ID == 0) { 返回类型ID = 驻留("空类型"); }
            如果 (方法名ID == 类名ID) {
                登记类构造(类名ID, 参数串);
                // 309（2026-10-09）：构造默认参数登记（377/568·宿主 D23 语义层
                //   funcDefaultArgs_ 收集同构）——发射用户类构造/注入父构造调用
                //   的放宽补缺消费；拷贝构造（类名& 形态）参数无默认值=自然零登记。
                登记类构造默认参数(池, 整32(位置), 类名ID, 整64(参数段个数(参数串)));
                // 329-a：重载感知统计（个数累加·零参存在位置位）
                整64 旧数109 = 0;
                结果<整64, 整32> 查数109 = 类构造个数表.获取(类名ID);
                如果 (查数109.正常) { 旧数109 = 查数109.值; }
                结果<空类型, 整32> 设数109 = 类构造个数表.设置(类名ID, 旧数109 + 1);
                如果 (!设数109.正常) { 运行时错误(4); }
                如果 (字符串长度(参数串) == 0) {
                    结果<空类型, 整32> 设零109 = 类构造零参位表.设置(类名ID, 1);
                    如果 (!设零109.正常) { 运行时错误(4); }
                }
            } 否则 如果 (字符串比较(驻留文本(方法名ID), 析构名)) {
                登记类析构(类名ID);
            } 否则 {
                // 414（241-a 对齐·宿主 collectClassMembers 同款）：运算符重载
                //   参数个数校验 + 重复定义拒绝（v2 类方法表=同名覆盖式，不判则
                //   后者静默吞前者——宿主「重复定义运算符」诊断对齐）；校验失败
                //   跳过登记（半初始化方法表不出产物）。
                如果 (校验运算符重载参数414(方法名ID, 参数串, 诊断)) {
                    // P0-1（审查·宿主 collectClassMembers methods.find 同构）：
                    //   判重改本类级键（查本类方法有）——原 查类方法定义层 沿基名
                    //   链返回首个命中层，子类定义同名运算符=误报「重复定义」并
                    //   丢子类重写；宿主逐类收集只查本类表，子类覆盖合法。
                    // P2：后缀须∈可重载集合才算重载名（防「运算符们」普通标识符
                    //   误入判重——是运算符重载方法名414 前缀+后缀集合同口径）。
                    布尔 是重载名414 = 是运算符重载方法名414(方法名ID);
                    如果 (是重载名414 && 查本类方法有(类名ID, 方法名ID)) {
                        表诊断(诊断, "[错误] 类 '" + 类名文本 + "' 重复定义运算符 '" +
                                      字符串子串(驻留文本(方法名ID), 字符串长度("运算符"),
                                                  字符串长度(驻留文本(方法名ID))) + "'");
                    } 否则 {
                        登记类方法(类名ID, 方法名ID, 返回类型ID, 参数串);
                    }
                }
            }
        }
        位置++;
    }
}

// 329-a：类构造统计查询（109 裸声明判定用——同包 语义检查语句 消费）
函数 查类构造个数(整64 类名ID) -> 整64 {
    结果<整64, 整32> 查 = 类构造个数表.获取(类名ID);
    如果 (查.正常) { 返回 查.值; }
    返回 0;
}

// 741 族子：变量类型ID 剥引用后缀（尾 '&'·宿主 canonical 剥 & 同构）后取
//   用户类ID——用户类（含泛型实例合成名·416-a 注册为完整用户类）返回其驻留
//   ID；非用户类/剥空/非正 ID=0 -1（741 两挂点共用：p13 实证引用变量读出=
//   拷贝宿主照拦，故引用后缀须剥净再判）。
函数 剥引用取用户类741(整64 类型ID) -> 整64 {
    如果 (类型ID <= 0) { 返回 0 - 1; }
    字符串 文本741 = 字符串复制(驻留文本(类型ID));
    整64 长741 = 字符串长度(文本741);
    当 (长741 > 0 && (整64(文本741[整32(长741 - 1)]) & 255) == 38) {
        文本741 = 字符串子串(文本741, 0, 整32(长741 - 1));
        长741 = 长741 - 1;
    }
    如果 (长741 > 0 && 是用户类(文本741)) { 返回 驻留(文本741); }
    返回 0 - 1;
}

// 741（2026-10-14·宿主 class_resolver.cpp:216 方案A 强制规则 v2 语义层对齐）：
//   有析构类按值拷贝须有拷贝构造（函数 类名(类名& 其他) 深拷贝）——浅拷贝
//   裸指针字段级联析构双释放 0xC0000374（C++ rule-of-three 同款·安全红线）。
//   v2 原语义层放行：声明初始化面=IR 层「类对象初始化仅支持构造调用」+
//   运行时错误(6) 错位红（诊断阶段/文案双不一致）、赋值面（标识符/成员/
//   调用返回）=静默放行→发射拷贝构造调用→链接期 LNK2019 悬空外部符号
//   （728z 探针实证）。挂点=声明初始化（语义检查语句 显式+推断两路）与赋值
//   （语义检查赋值）的标识符拷贝出现面；判定=析构沿链有（宿主类方法表并入
//   基类析构=沿链效果·p15 探针实证：子类无析构基类有→拦）∧ 拷贝构造沿链无
//   （宿主 findCopyConstructor 每层只认自有·无才上溯）。文案逐字对齐宿主
//   （E2E 112_v2 双侧同锚）。豁免面与宿主实测一致：无析构类（728x 位拷贝
//   面不受影响）/有拷贝构造（本类或基类）/引用绑定声明/指针/按值传参/
//   构造调用与调用返回初始化（声明面·返回槽构造非拷贝）。
函数 检查有析构按值拷贝741(向量<字符串>& 诊断, 整64 类名ID) -> 空类型 {
    如果 (类名ID <= 0 || !是用户类_ID(类名ID)) { 返回; }
    如果 (!类有析构(类名ID)) { 返回; }
    如果 (查类拷贝构造沿链(类名ID) != 0) { 返回; }
    字符串 类名741 = 字符串复制(驻留文本(类名ID));
    表诊断(诊断, "[错误] 有析构类 '" + 类名741 + "' 按值拷贝须有拷贝构造（函数 " +
                  类名741 + "(" + 类名741 + "& 其他)）");
}

函数 类有零参构造(整64 类名ID) -> 布尔 {
    结果<整64, 整32> 查 = 类构造零参位表.获取(类名ID);
    如果 (查.正常) { 返回 查.值 == 1; }
    返回 假;
