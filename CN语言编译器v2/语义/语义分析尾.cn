// 语义诊断缓冲访问（语义检查 主流程聚合用——千行拆分，2026-09-08）
函数 取语义诊断数() -> 整64 {
    返回 语义诊断缓冲.大小();
}

函数 取语义诊断(整64 序) -> 字符串 {
    // 70-a（2026-09-11 方案A 补完）：容器元素=借用（Rust Vec::get -> &T）——
    //   返回类型 字符串（A2 拥有契约）下调用方 free=缓冲元素悬垂；B 类显式
    //   复制 落堆（货舱查找依赖 同款，A2 呈报 B 类字段借出面补完）
    返回 字符串复制(语义诊断缓冲.元素(序));
}

不安全 函数 清空语义诊断缓冲() -> 空类型 {
    语义诊断缓冲 = 向量<字符串>();
}

// ==================== 跨子模块访问函数（千行拆分，2026-09-08） ====================
//   语义检查 子模块经下列函数访问模块分桶表/指针变量表
//   （静态表=文件级私有，跨文件仅函数可见；查询未命中返回 -1 哨兵）
函数 查模块成员键基(整64 模块ID, 整64 名ID) -> 整64 {
    结果<整64, 整32> 查 = 模块成员键基们.获取(模块成员键(模块ID, 名ID));
    如果 (查.正常) { 返回 查.值; }
    返回 0 - 1;
}

函数 查模块成员公开(整64 模块ID, 整64 名ID) -> 整64 {
    结果<整64, 整32> 查 = 模块成员公开们.获取(模块成员键(模块ID, 名ID));
    如果 (查.正常) { 返回 查.值; }
    返回 0 - 1;
}

// 615（2026-10-16）：登记签名扩三参——层数（类型节点附加位 1..255）单点成对
//   写入 指针层数表（与 指针变量表 同生命周期·同清空点）。原两参调用点全部
//   机械补层数实参（局部=类型节点附加/参数=参数类型节点附加/数组名退化=1）。
不安全 函数 登记语义指针变量(整64 名ID, 整64 类型ID, 整64 层数) -> 空类型 {
    结果<空类型, 整32> 设 = 指针变量表.设置(名ID, 类型ID);
    如果 (!设.正常) { 运行时错误(4); }
    结果<空类型, 整32> 设层 = 指针层数表.设置(名ID, 层数);
    如果 (!设层.正常) { 运行时错误(4); }
}

函数 查语义指针变量(整64 名ID) -> 整64 {
    结果<整64, 整32> 查 = 指针变量表.获取(名ID);
    如果 (查.正常) { 返回 查.值; }
    返回 0 - 1;
}

// 615：指针层数查询（1..255；-1=非指针/未登记）——多级指针成员访问拦截
//   （检查成员访问表达式）消费。语义指针变量表 miss 时返回 -1（调用方放行面）。
函数 查语义指针层数(整64 名ID) -> 整64 {
    结果<整64, 整32> 查 = 指针层数表.获取(名ID);
    如果 (查.正常) { 返回 查.值; }
    返回 0 - 1;
}

// 615：类型文本尾星数（数组元素带星登记——元素为 T* 时数组名=指向指针的指针，
//   层数=1+尾星数）。仅数尾部连续 '*'（ASCII 42）；剥星基名/无尾星=0。
函数 尾星数615(字符串 文本) -> 整64 {
    整64 长615 = 字符串长度(文本);
    整64 数615 = 0;
    当 (数615 < 长615 &&
          ((整64(文本[整32(长615 - 1 - 数615)]) & 255) == 42)) { 数615++; }
    返回 数615;
}

// 615：类型文本剥尾星（多级指针诊断文本重建：基名+层数星拼装——普通指针登记值
//   已是剥星基名（尾星 0 原样返回）；数组名登记值=元素文本可能带星，须先剥）。
函数 剥尾星615(字符串 文本) -> 字符串 {
    整64 长615 = 字符串长度(文本);
    整64 尾615 = 长615;
    当 (尾615 > 0 && ((整64(文本[整32(尾615 - 1)]) & 255) == 42)) { 尾615--; }
    如果 (尾615 == 长615) { 返回 字符串复制(文本); }
    返回 字符串子串(文本, 0, 整32(尾615));
}

不安全 函数 清空语义指针变量表() -> 空类型 {
    指针变量表.清空();
    指针层数表.清空();
}


// ==================== 413：接口收集（2026-10-11 接口语法族） ====================

// 接口类型符号登记（收集期·与 收集类声明 同款三登记——键基/模块成员/公开）：
//   接口名可作类型（变量声明/参数/返回——「未声明的类型」检查放行）。
不安全 函数 收集接口声明(向量<节点> 池, 整32 声明索引, 向量<映射<整64, 符号>>& 符号表,
              字符串 模块路径, 整64 本模块ID, 整64 是否公开) -> 空类型 {
    节点 声明 = 池.元素(声明索引);
    整64 键基if = 键基合成(模块路径, 整64(声明.文本));
    整64 忽略if = 表注册(符号表, 键基if, 0, 符号_结构体, 是否公开);
    如果 (忽略if == 0) { }
    结果<空类型, 整32> 设成员if = 模块成员键基们.设置(
        模块成员键(本模块ID, 整64(声明.文本)), 键基if);
    如果 (!设成员if.正常) { 运行时错误(4); }
    如果 (是否公开 == 1) {
        结果<空类型, 整32> 设公开if = 模块成员公开们.设置(
            模块成员键(本模块ID, 整64(声明.文本)), 1);
        如果 (!设公开if.正常) { 运行时错误(4); }
    }
}

// 接口实现齐全性校验（宿主 verifyInterfaceImpl 诊断文本对齐）：遍历接口方法
//   全局序，类实现接口沿链 命中的 (接口,方法) 须在类方法表（沿链定义层非 0）
//   且定义方法须 虚拟(位6)/重写(位7) 修饰（宿主同款强制——接口方法虚调用面）。
//   缺失=「类 'X' 未实现接口 'Y' 的方法 'Z'」；非虚=「类 'X' 实现接口方法 'Z'
//   时须用 虚拟 或 重写 修饰」；签名不一致=「类 'X' 实现接口 'Y' 的方法 'Z'
//   签名不一致」（宿主 verifyInterfaceImpl 三段同构——返回类型+参数串文本
//   比对·不一致程序静默错位/截断 vs 宿主拒=分叉，413-b 审查 P1 补齐）。
// 接口方法签名一致性（宿主 verifyInterfaceImpl 签名段同构）：定义层方法的
//   返回类型文本/参数串 vs 接口表登记文本（沿链定义层取——重写实现与接口
//   声明逐字比对）。
函数 接口方法签名一致(整64 定义层ID, 整64 方法IDv, 整64 接口IDv) -> 布尔 {
    整64 类返回v = 查类方法返回(定义层ID, 方法IDv);
    整64 接口返回v = 查接口方法返回(接口IDv, 方法IDv);
    如果 (类返回v != 接口返回v) { 返回 假; }
    整64 类串v = 查类方法参数串(定义层ID, 方法IDv);
    整64 接口串v = 查接口方法参数串(接口IDv, 方法IDv);
    返回 类串v == 接口串v;
}

// 413-b（1024 根因修复）：方法定义层是虚修饰——定义层类体扫描匹配 节点_方法
//   （类区间=[子起点,子终点)·扫描源=收集类方法 同款），修饰位6=虚拟(64)/
//   位7=重写(128) 任一置位=真；宿主 verifyInterfaceImpl 判据同构
//   （!isVirtual && !isOverride=拒）。定义层类节点经 查类节点索引 定位——
//   ★时序依赖：类节点索引表 登记须先于本消费（收集类声明 内已锁·见该处登记
//   注释；原序 miss=恒 fail-open 死路径·1024 实录三形态 v2 全放行 vs 宿主全拒）。
//   未命中=内部不一致（定义层方法既已入 类方法返回们（收集类方法 与本体同源
//   扫描），则其 节点_方法 必在同池类体）——报内部错误诊断显形（648 ①·编译
//   必败），返回真=跳过用户面修饰诊断（防内部错误+用户面双诊断误导）。
函数 方法定义层是虚修饰(向量<节点> 池, 整64 定义类IDv, 整64 方法IDv,
                    向量<字符串>& 诊断) -> 布尔 {
    整64 类索引v = 查类节点索引(定义类IDv);
    布尔 类节点有效 = 类索引v >= 0 && 类索引v < 整64(池.大小());
    // 静默豁免闭集穷举: 登记时序已锁（收集类声明 先于本检查登记）——查表 miss 不可达；报内部错误显形（648 ①）
    如果 (!类节点有效) {
        表诊断(诊断, "[内部错误] 接口实现修饰检查未定位类节点 '" +
                      驻留文本(定义类IDv) + "'");
        返回 真;
    }
    节点 类节点v = 池.元素(整32(类索引v));
    整64 位置v = 整64(类节点v.子起点);
    当 (位置v < 整64(类节点v.子终点)) {
        节点 成员v = 池.元素(整32(位置v));
        如果 (成员v.类型 == 节点_方法 && 整64(成员v.文本) == 方法IDv) {
            返回 ((整64(成员v.修饰) & 192) != 0);   // 位6=虚拟(64)/位7=重写(128)
        }
        位置v++;
    }
    // 同源扫描不可达（收集类方法 登记自同一类体扫描）——内部错误显形（648 ①·编译必败）
    表诊断(诊断, "[内部错误] 接口实现修饰检查未定位方法节点 '" +
                  驻留文本(方法IDv) + "'（定义层 '" + 驻留文本(定义类IDv) + "'）");
    返回 真;
}

// 1024：三段检查改宿主同款顺序独立判定（原 否则如果 链=多违规只报首段 vs 宿主
//   每段独立可并报（class_resolver.cpp verifyInterfaceImpl 三段顺序 if）——
//   修饰段复活后链式首段遮蔽效应显形，收口为零分叉：未实现（定义层 0）=
//   跳后两段（宿主 continue 同构）；非虚与签名不一致=各自独立判报）。
函数 校验接口实现齐全(向量<节点> 池, 整64 类名IDv, 向量<字符串>& 诊断) -> 空类型 {
    整64 序v = 0;
    当 (序v < 接口方法序数()) {
        整64 接口IDv = 接口槽取接口(序v);
        整64 方法IDv = 接口槽取方法(序v);
        如果 (类实现接口沿链(类名IDv, 接口IDv)) {
            整64 定义层v = 查类方法定义层(类名IDv, 方法IDv);
            如果 (定义层v == 0) {
                表诊断(诊断, "[错误] 类 '" + 驻留文本(类名IDv) + "' 未实现接口 '" +
                            驻留文本(接口IDv) + "' 的方法 '" + 驻留文本(方法IDv) + "'");
            }
            如果 (定义层v != 0 && !方法定义层是虚修饰(池, 定义层v, 方法IDv, 诊断)) {
                表诊断(诊断, "[错误] 类 '" + 驻留文本(定义层v) + "' 实现接口方法 '" +
                            驻留文本(方法IDv) + "' 时须用 虚拟 或 重写 修饰");
            }
            如果 (定义层v != 0 && !接口方法签名一致(定义层v, 方法IDv, 接口IDv)) {
                表诊断(诊断, "[错误] 类 '" + 驻留文本(类名IDv) + "' 实现接口 '" +
                            驻留文本(接口IDv) + "' 的方法 '" + 驻留文本(方法IDv) +
                            "' 签名不一致");
            }
        }
        序v++;
    }
}
