// CN 自举编译器 v2 · 语义检查逃逸（435·2026-10-11）
// 职责：返回面/逃逸族语义检查——
//   ①检查返回借用A2 + 检查返回局部地址（210-a 自 语义检查中.cn 机械搬移·
//     零逻辑变化——该文件 1000 行红线腾余量·宿主 semantic_stmt.cpp 同位族）；
//   ②lambda 引用捕获逃逸检查（435·001「[&] 引用捕获逃逸限制」条文执行面·
//     宿主 src/cn_compiler/semantic/semantic_lambda_escape.cpp 同构）：引用
//     捕获（形态3=[&] 且捕获集非空）的 lambda 持有定义帧局部变量地址，闭包
//     逃逸定义帧即悬垂——保守值集分析：能证明不逃逸（局部变量持有+同帧调用）
//     才放行；检出逃逸形态（返回位/长寿命载体赋值位/实参位及传播链）=编译
//     错误指路改写；不确定面按逃逸拒绝（永不静默放行）；不安全 函数 内定义
//     豁免（责任上移·Rust unsafe 同款哲学）。
// 模块路径=语义检查逃逸（新键基）；消费方=检查语句（返回位）/检查赋值语句
//   （赋值位）/检查调用表达式（实参位）/检查变量声明语句（声明位传播）/
//   检查函数（入口清空）/语义检查（链式赋值表达式位）。
// #486（2026-10-13）：lambda 合成体检查面建设——五挂点传播表参数化（主遍历传
//   引用lambda变量们 主表·合成体遍传体内表=主表拷贝丢弃），新增 检查合成体逃逸
//   块树递归遍（lambda合成类型 尾挂载·防重卫）：体内语句的返回/声明/赋值/实参
//   位同查（宿主 semantic_lambda_escape.cpp 快照栈+去短路同轮对齐·435 立法
//   「体内上下文跳过」妥协面退役——001 条文无体内豁免·宁严勿松）。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/lambda捕获形态们（语法模块静态·合并全局池）
导入 协议常量;

公开:   // 全文件公开（逃逸族供包内兄弟模块经合并全局池解析）

// ==================== 210-a 机械搬移面（自 语义检查中.cn·零逻辑变化） ====================

// 210-a：族① 返回面借用检查（plans/019 阶段4' A2 拥有契约）——返回类型 字符串=拥有，
//   借用形态返回拒绝：下标/成员借出、字符* 调用返回、参数/非局部标识符（借用）；
//   局部拥有标识符/字面量/拼接放行（宿主 visitReturnStmt 同构）。
不安全 函数 检查返回借用A2(向量<节点> 池, 节点 n, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
        // plans/019 阶段4' A2（2026-09-11 方案甲 用户批准）：返回位拥有契约——
        //   返回类型 字符串=拥有（调用方登记 RAII 释放），借用形态返回拒绝：
        //   下标/成员借出、字符* 调用返回（驻留文本 等）、参数标识符（借用）。
        //   局部拥有标识符/字面量/拼接放行（宿主 visitReturnStmt 同构；
        //   v2 语法面无栈数组，借出载体=指针下标/成员）。
        如果 (n.子终点 > n.子起点 && 当前函数返回类型 == 驻留("字符串")) {
            节点 返回末A2 = 池.元素(整32(n.子终点 - 1));
            布尔 借用返回A2 = 假;
            如果 (返回末A2.类型 == 节点_下标 || 返回末A2.类型 == 节点_成员) {
                借用返回A2 = 真;
            } 否则 如果 (返回末A2.类型 == 节点_调用 && 返回末A2.子起点 >= 0) {
                节点 被调A2 = 池.元素(整32(返回末A2.子起点));
                如果 (被调A2.类型 == 节点_标识符 &&
                     查函数返回类型(整64(被调A2.文本)) == 驻留("字符*")) {
                    借用返回A2 = 真;
                }
            } 否则 如果 (返回末A2.类型 == 节点_标识符) {
                // 参数=借用（局部=拥有移出放行；非局部=静态/全局借用）
                整64 返回名A2 = 整64(返回末A2.文本);
                // 符号_参数=借用；非局部（静态/全局）=借用（局部=拥有移出放行）
                如果 (表查找种类(符号表, 返回名A2) == 符号_参数 ||
                     !是局部名(符号表, 返回名A2)) {
                    借用返回A2 = 真;
                }
            }
            如果 (借用返回A2) {
                表诊断(诊断, "[错误] 函数返回类型 '字符串'=拥有契约，不能返回借用" +
                             "——须 字符串复制(...) 显式落堆，或改返回类型为 '字符*'（借用视图）");
            }
        }
}

// 210-a：族② 返回局部地址检查（plans/019 阶段2）——返回类型为指针/引用且返回末节点
//   为 取地址(局部标识符) 时拒绝（栈帧消亡悬垂；引用参数指向调用方存储豁免——
//   宿主 isRefParamForCurrentFn 对齐；v2 第一版不含经指针转接形态=诚实边界）。
不安全 函数 检查返回局部地址(向量<节点> 池, 节点 n, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
        // plans/019 阶段2（2026-09-10）：返回局部变量的地址——返回类型为指针
        //   或引用（名文本尾 * 或 &）且返回末节点为 取地址(局部标识符) 时拒绝
        //   （栈帧消亡悬垂；宿主 visitReturnStmt 指针返回检查同构——v2 第一版
        //   不含经指针转接形态=诚实边界）
        如果 (n.子终点 > n.子起点 && 当前函数返回类型 >= 0) {
            字符串 返回类型文本 = 字符串复制(驻留文本(当前函数返回类型));
            整64 返回类型长度 = 字符串长度(返回类型文本);
            布尔 返回是指针或引用 = 假;
            如果 (返回类型长度 > 0) {
                整64 尾字符 = 整64(返回类型文本[返回类型长度 - 1]) & 255;
                如果 (尾字符 == 42 || 尾字符 == 38) {
                    返回是指针或引用 = 真;
                }
            }
            如果 (返回是指针或引用) {
                节点 返回末 = 池.元素(整32(n.子终点 - 1));
                如果 (返回末.类型 == 节点_取地址 && 返回末.子起点 >= 0) {
                    节点 取地址操作数 = 池.元素(整32(返回末.子起点));
                    如果 (取地址操作数.类型 == 节点_标识符 &&
                         是局部名(符号表, 整64(取地址操作数.文本)) &&
                         !是当前引用参数(整64(取地址操作数.文本))) {
                        // 宿主 isRefParamForCurrentFn 对齐：引用参数指向调用方
                        //   存储（非本栈帧）——返回 &引用参数 合法豁免
                        表诊断(诊断, "[错误] 返回局部变量的地址（栈帧消亡将成悬垂）: " +
                                      驻留文本(整64(取地址操作数.文本)));
                    }
                }
                // 329-a（D38 批2·103）：引用返回（仅 & 尾）裸标识符/成员链形态——
                //   返回局部变量本体=引用绑定隐式取地址，同悬垂（宿主「引用返回
                //   不能返回局部变量的地址」对齐·t01/t04/t05 实测；引用参数豁免
                //   指向调用方存储·t02；全局豁免·t03；指针返回（尾 *）裸标识符=
                //   指针值拷贝不属本面）。成员链只判父对象一层（嵌套链=诚实边界
                //   同 推导成员类型ID 粒度）。
                如果 (((整64(返回类型文本[返回类型长度 - 1]) & 255) == 38)) {
                    // 尾字符 判定块内重算（原 尾字符 声明于上方 若 长度>0 块内·块外不可见）
                    整64 局部名103 = 0;
                    布尔 返回局部103 = 假;
                    如果 (返回末.类型 == 节点_标识符 &&
                         是局部名(符号表, 整64(返回末.文本)) &&
                         !是当前引用参数(整64(返回末.文本))) {
                        返回局部103 = 真;
                        局部名103 = 整64(返回末.文本);
                    } 否则 如果 (返回末.类型 == 节点_成员 && 返回末.子起点 > 0) {
                        节点 父对象103 = 池.元素(整32(返回末.子起点));
                        如果 (父对象103.类型 == 节点_标识符 &&
                             是局部名(符号表, 整64(父对象103.文本)) &&
                             !是当前引用参数(整64(父对象103.文本))) {
                            返回局部103 = 真;
                            局部名103 = 整64(父对象103.文本);
                        }
                    }
                    如果 (返回局部103) {
                        表诊断(诊断, "[错误] 引用返回不能返回局部变量的地址（'" +
                                      驻留文本(局部名103) + "'）");
                    }
                }
            }
        }
}

// ==================== 435 lambda 引用捕获逃逸检查（宿主同构面） ====================

// 当前函数「引用闭包持有变量」传播表（保守值集分析·宿主 g_refLambdaVars 同构）：
//   变量名ID -> 1=该局部变量声明/赋值位初始化器含 [&] 非空捕获闭包——后续
//   返回/实参/长寿命载体位扫描命中即判逃逸。函数入口清空（跨函数互不污染）。
静态 映射<整64, 整64> 引用lambda变量们;

// 函数检查入口清空（检查函数 挂点·宿主 noteFunctionEntry 同构）——与
//   清空语义指针变量表/清空恒空表 等函数级清空族同位同语义
不安全 函数 清引用lambda变量们() -> 空类型 {
    引用lambda变量们.清空();
}

// 引用捕获 lambda 节点判定（宿主 isRefLambda 同构）：节点=?lambdaN 合成名
//   标识符 且 捕获形态==3（[&]）且 捕获数>0（空捕获/值捕获/显式捕获=快照
//   语义无悬垂面·001 条文④不受限）
函数 是引用lambda节点(向量<节点> 池, 整32 节点索引) -> 布尔 {
    节点 n = 池.元素(节点索引);
    如果 (n.类型 != 节点_标识符) { 返回 假; }
    如果 (!是lambda合成函数名(整64(n.文本))) { 返回 假; }
    结果<整64, 整32> 查形435 = lambda捕获形态们.获取(整64(n.文本));
    如果 (查形435.正常) {
        如果 (查形435.值 == 3) {
            结果<整64, 整32> 查数435 = lambda捕获计数们.获取(整64(n.文本));
            如果 (查数435.正常) {
                如果 (查数435.值 > 0) { 返回 真; }
            }
        }
    }
    返回 假;
}

// 表达式区间含引用捕获 lambda / 传播表变量？（宿主 treeContainsRefLambda 同构）
//   v2 池=扁平后缀序：表达式全部子节点线性排在区间内——线性扫即全覆盖；
//   ★两遍扫：第一遍收集区间内 节点_调用 的被调位（子起点·含嵌套调用）——
//   被调名不作判定面（同帧调用/调用闭包持有变量=合法面·706/707 权料；宿主
//   CallExpr 跳过 callee 子树同构——`打印(改y())` 的 改y 不触发·t737 实录）；
//   第二遍标识符判定跳过被调位。嵌套 lambda 体不在表达式区间（合成函数节点
//   在池尾）=天然排除，体内语句由语句挂点同一套覆盖。
函数 表达式区间含引用lambda(向量<节点> 池, 整32 起, 整32 止,
                          向量<映射<整64, 符号>>& 符号表,
                          映射<整64, 整64>& 传播表) -> 布尔 {
    向量<整64> 被调位们 = 向量<整64>();
    整64 收i = 整64(起);
    当 (收i < 整64(止)) {
        节点 收n = 池.元素(整32(收i));
        如果 (收n.类型 == 节点_调用 && 整64(收n.子起点) >= 整64(起) &&
             整64(收n.子起点) < 整64(止)) {
            结果<空类型, 整32> 登被调 = 被调位们.追加(整64(收n.子起点));
            如果 (!登被调.正常) { 运行时错误(4); }
        }
        收i++;
    }
    整64 i = 整64(起);
    当 (i < 整64(止)) {
        节点 n = 池.元素(整32(i));
        如果 (n.类型 == 节点_标识符) {
            布尔 是被调位 = 假;
            整64 k = 0;
            当 (k < 被调位们.大小()) {
                如果 (被调位们.元素(整32(k)) == i) { 是被调位 = 真; 中断; }
                k++;
            }
            如果 (!是被调位) {
                如果 (是lambda合成函数名(整64(n.文本))) {
                    // lambda 表达式节点（?前缀）——引用形态+捕获非空=真
                    结果<整64, 整32> 查形L = lambda捕获形态们.获取(整64(n.文本));
                    如果 (查形L.正常) {
                        如果 (查形L.值 == 3) {
                            结果<整64, 整32> 查数L = lambda捕获计数们.获取(整64(n.文本));
                            如果 (查数L.正常) {
                                如果 (查数L.值 > 0) { 返回 真; }
                            }
                        }
                    }
                } 否则 {
                    // 普通标识符：传播表命中=闭包持有变量（保守值集）
                    结果<整64, 整32> 查传435 = 传播表.获取(整64(n.文本));
                    如果 (查传435.正常) {
                        如果 (查传435.值 == 1) { 返回 真; }
                    }
                }
            }
        }
        i++;
    }
    返回 假;
}

// 逃逸诊断统一文案（宿主 reportEscape 同构·指路改写=裁决第 2 条）
函数 报lambda逃逸(向量<字符串>& 诊断, 整64 名ID435, 字符串 语境435) -> 空类型 {
    字符串 报文435 = 字符串复制("[错误] [&] 引用捕获的 lambda 逃逸当前栈帧（");
    报文435 = 报文435 + 语境435;
    如果 (名ID435 > 0) {
        报文435 = 报文435 + " '" + 字符串复制(驻留文本(名ID435)) + "'";
    }
    报文435 = 报文435 + "）——闭包寿命长于被捕获局部变量=悬垂引用；改用 [=] 值捕获快照，或在不安全 函数 内定义（责任自担豁免）";
    表诊断(诊断, 报文435);
}

// 返回位检查（检查语句 节点_返回语句 分支挂点·宿主 checkReturn 同构）：
//   返回值表达式含引用捕获 lambda / 传播表变量 → 逃逸编译错误。
//   不安全 函数 豁免（读当前函数不安全·责任上移）。
//   #486：传播表参数化（主遍历=主表·合成体遍=体内表）。
不安全 函数 检查返回位lambda逃逸(向量<节点> 池, 节点 n, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断,
                            映射<整64, 整64>& 传播表) -> 空类型 {
    如果 (读当前函数不安全()) { 返回; }
    如果 (n.子终点 > n.子起点 &&
         表达式区间含引用lambda(池, 整32(n.子起点), 整32(n.子终点), 符号表, 传播表)) {
        报lambda逃逸(诊断, 0, 字符串复制("作为返回值"));
    }
}

// 赋值位检查（检查赋值语句 挂点·宿主 checkAssign 同构）：右值区间含引用
//   捕获 lambda / 传播表变量——目标=本函数局部标识符 → 传播入表（局部→局部
//   保守值集）；目标=非局部标识符（全局/静态/类字段）或成员/下标/解引用
//   （长寿命载体或寿命不可证）→ 逃逸编译错误。
//   赋值节点布局（963/575-a 惯例）：文本!=0=标识符左值（名在文本位·区间外）；
//   文本==0=复合左值（末节点=子起点-1）·右值区间=[子起点, 子终点)。
不安全 函数 检查赋值位lambda逃逸(向量<节点> 池, 节点 n, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断,
                            映射<整64, 整64>& 传播表) -> 空类型 {
    如果 (读当前函数不安全()) { 返回; }
    如果 (n.子终点 <= n.子起点) { 返回; }
    如果 (!表达式区间含引用lambda(池, 整32(n.子起点), 整32(n.子终点), 符号表, 传播表)) { 返回; }
    如果 (n.文本 != 0) {
        // 标识符左值：局部=传播入表；非局部（全局/静态/字段）=逃逸拒
        如果 (表查找种类(符号表, 整64(n.文本)) == 符号_变量 &&
             是局部名(符号表, 整64(n.文本))) {
            结果<空类型, 整32> 登传435 = 传播表.设置(整64(n.文本), 1);
            如果 (!登传435.正常) { 运行时错误(4); }
            返回;
        }
        报lambda逃逸(诊断, 整64(n.文本), 字符串复制("赋给全局/静态变量"));
        返回;
    }
    // 复合左值（文本==0）：末节点=子起点-1
    如果 (n.子起点 > 0) {
        节点 左值末435 = 池.元素(整32(n.子起点 - 1));
        如果 (左值末435.类型 == 节点_成员 || 左值末435.类型 == 节点_下标) {
            报lambda逃逸(诊断, 0, 字符串复制("存入对象字段/容器元素等长寿命载体"));
            返回;
        }
    }
    // 解引用等目标形态：指向存储寿命不可证——不确定面按逃逸拒绝（001 条文③）
    报lambda逃逸(诊断, 0, 字符串复制("存入无法证明栈内寿命的载体"));
}

// 链式赋值表达式位检查（语义检查.cn 节点_赋值 表达式分支挂点·宿主
//   visitAssignmentExpr 赋值位同构）：表达式位赋值（`变量 y = x = [&]{...}`
//   内层）——目标分类同 检查赋值位lambda逃逸；布局：左值=文本（标识符）或
//   子起点-1（复合·894-a），右值区间=[子起点, 子终点)。
不安全 函数 检查链式赋值lambda逃逸(向量<节点> 池, 节点 n, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断,
                              映射<整64, 整64>& 传播表) -> 空类型 {
    如果 (读当前函数不安全()) { 返回; }
    如果 (n.子终点 <= n.子起点) { 返回; }
    如果 (!表达式区间含引用lambda(池, 整32(n.子起点), 整32(n.子终点), 符号表, 传播表)) { 返回; }
    如果 (n.文本 != 0) {
        如果 (表查找种类(符号表, 整64(n.文本)) == 符号_变量 &&
             是局部名(符号表, 整64(n.文本))) {
            结果<空类型, 整32> 登传c = 传播表.设置(整64(n.文本), 1);
            如果 (!登传c.正常) { 运行时错误(4); }
            返回;
        }
        报lambda逃逸(诊断, 整64(n.文本), 字符串复制("赋给全局/静态变量"));
        返回;
    }
    如果 (n.子起点 > 0) {
        节点 左值末c = 池.元素(整32(n.子起点 - 1));
        如果 (左值末c.类型 == 节点_成员 || 左值末c.类型 == 节点_下标) {
            报lambda逃逸(诊断, 0, 字符串复制("存入对象字段/容器元素等长寿命载体"));
            返回;
        }
    }
    报lambda逃逸(诊断, 0, 字符串复制("存入无法证明栈内寿命的载体"));
}

// 调用实参位检查（检查调用表达式 挂点·宿主 checkCallArgs 同构）：逐实参区间
//   扫描（实参区间含引用捕获 lambda / 传播表变量 → 逃逸编译错误）。
//   ★调用节点布局（解析表达式中 解析调用后缀）：子起点=被调节点索引·**子终点=0
//   空闲**·附加=实参数——实参末位经 语法层 调用实参末位们 表定位（418 先例·
//   键=调用节点索引*键位移+序），实参 i 区间=[前末位+1, 本末位]（后缀序·
//   首实参前界=被调位）。被调位不扫描——同帧调用/立即调用合法面（706/707）。
//   末位表 miss=诚实边界跳过（418 同款守卫）。
不安全 函数 检查调用实参lambda逃逸(向量<节点> 池, 节点 n, 整32 调用节点索引,
                              向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断,
                              映射<整64, 整64>& 传播表) -> 空类型 {
    如果 (读当前函数不安全()) { 返回; }
    整64 实参数 = 整64(n.附加);
    整64 前末 = 整64(n.子起点);
    整64 序 = 0;
    当 (序 < 实参数) {
        整64 末位 = 查调用实参末位(整64(调用节点索引), 序);
        如果 (末位 < 0) { 中断; }
        如果 (末位 > 前末 &&
             表达式区间含引用lambda(池, 整32(前末 + 1), 整32(末位 + 1), 符号表, 传播表)) {
            报lambda逃逸(诊断, 0, 字符串复制("作为函数实参传出"));
            返回;
        }
        前末 = 末位;
        序++;
    }
}

// 声明初始化位传播登记（检查变量声明语句 挂点·宿主 noteDeclInit 同构·
//   推断声明与显式声明共用——文本=变量名ID·初值区间=[子起点, 子终点)）：
//   初值含引用捕获 lambda → 变量名入传播表；否则出表（同名再声明遮蔽修正·
//   防传播链误报）。须在初值区间检查后调用（捕获计数已回填）。
不安全 函数 登记声明位lambda逃逸(向量<节点> 池, 节点 n, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断,
                            映射<整64, 整64>& 传播表) -> 空类型 {
    布尔 删传435 = 传播表.删除(整64(n.文本));
    如果 (!删传435) { }
    如果 (n.子终点 > n.子起点 &&
         表达式区间含引用lambda(池, 整32(n.子起点), 整32(n.子终点), 符号表, 传播表)) {
        结果<空类型, 整32> 登传435 = 传播表.设置(整64(n.文本), 1);
        如果 (!登传435.正常) { 运行时错误(4); }
    }
}

// ==================== #486 lambda 合成体检查面（2026-10-13·双侧同查轮） ====================

// 合成体逃逸检查防重卫（名ID -> 1）：lambda合成类型 经类型解析可多次触发
//   （同 ?名 多处引用/推导重放）——每合成体本轮编译仅查一遍（诊断单点+区间
//   扫零重复；防重卫只拦检查遍·捕获回填/返回推导既有路径不受影响）。
静态 映射<整64, 整64> 合成体逃逸已查们;

// 表达式区间内 节点_调用 逐个挂实参位（#486 合成体辅助·主遍历实参挂点在
//   检查调用表达式 表达式级触发——合成体遍语句根不递归表达式，嵌套调用实参
//   逃逸经本辅助等价覆盖：池扁平后缀序·调用节点线性排区间内）。v2 池区间
//   内无嵌套 lambda 子树（合成函数节点在池尾）=零误入体内体。
不安全 函数 检查合成体区间调用们(向量<节点> 池, 整64 起, 整64 止,
                            向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断,
                            映射<整64, 整64>& 传播表) -> 空类型 {
    整64 ci = 起;
    当 (ci >= 0 && ci < 止 && ci < 池.大小()) {
        节点 子 = 池.元素(整32(ci));
        如果 (子.类型 == 节点_调用) {
            检查调用实参lambda逃逸(池, 子, 整32(ci), 符号表, 诊断, 传播表);
        }
        ci++;
    }
}

// 合成体内单语句逃逸检查（#486·四挂点体内等价面）：按语句类型挂 435 挂点
//   （传合成体传播表）+表达式子区间调用扫（嵌套调用实参逃逸）。
//   语句区间约定（解析层惯例）：变量声明/返回语句=[子起点,子终点)=初值/值
//   表达式区间；赋值=右值区间（左值标识符在文本位/复合左值末=子起点-1·
//   左值非调用不扫）；表达式语句=[子起点,子终点)=表达式区间；调用语句根
//   （子终点=0 空闲·418 惯例）经 实参末位表 挂点自覆盖（含实参子树）。
不安全 函数 检查合成体语句逃逸(向量<节点> 池, 整64 语句索引,
                          向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断,
                          映射<整64, 整64>& 传播表) -> 空类型 {
    节点 语句 = 池.元素(整32(语句索引));
    如果 (语句.类型 == 节点_变量声明) {
        登记声明位lambda逃逸(池, 语句, 符号表, 诊断, 传播表);
    } 否则 如果 (语句.类型 == 节点_返回语句) {
        检查返回位lambda逃逸(池, 语句, 符号表, 诊断, 传播表);
    } 否则 如果 (语句.类型 == 节点_赋值) {
        检查赋值位lambda逃逸(池, 语句, 符号表, 诊断, 传播表);
    } 否则 如果 (语句.类型 == 节点_调用) {
        // 调用语句根：实参区间挂点已含实参子树（嵌套调用同区间扫）
        检查调用实参lambda逃逸(池, 语句, 整32(语句索引), 符号表, 诊断, 传播表);
        返回;
    }
    // 表达式子区间调用扫（声明初值/返回值/赋值右值/表达式语句的嵌套调用）
    如果 (语句.类型 == 节点_变量声明 || 语句.类型 == 节点_返回语句 ||
         语句.类型 == 节点_赋值 || 语句.类型 == 节点_表达式语句) {
        检查合成体区间调用们(池, 整64(语句.子起点), 整64(语句.子终点),
                            符号表, 诊断, 传播表);
    }
}

// 合成体块树递归遍（#486·登记lambda体推断声明 同款块树覆盖）：块语句序
//   线性扫+如果/当/情况体递归+条件表达式区间调用扫。字段约定=解析层构造
//   惯例：如果语句 文本=条件起点·子起点=条件终点·附加=真块索引·子终点=
//   否则链节点索引（链节点=如果语句[递归]或否则块）；当语句 文本=条件起点·
//   子起点=条件终点·附加=体块索引；情况标签 子起点=体块索引。
不安全 函数 检查合成体块逃逸(向量<节点> 池, 整64 块索引,
                         向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断,
                         映射<整64, 整64>& 传播表) -> 空类型 {
    如果 (块索引 < 0 || 块索引 >= 池.大小()) { 返回; }
    节点 块 = 池.元素(整32(块索引));
    整64 si = 整64(块.子起点);
    当 (si < 整64(块.子终点)) {
        节点 语句 = 池.元素(整32(si));
        检查合成体语句逃逸(池, si, 符号表, 诊断, 传播表);
        如果 (语句.类型 == 节点_如果语句) {
            检查合成体区间调用们(池, 整64(语句.文本), 整64(语句.子起点),
                                符号表, 诊断, 传播表);
            检查合成体块逃逸(池, 整64(语句.附加), 符号表, 诊断, 传播表);
            整64 链游 = 整64(语句.子终点);
            当 (链游 != 0 && 链游 > 0 && 链游 < 池.大小()) {
                节点 链节 = 池.元素(整32(链游));
                如果 (链节.类型 == 节点_如果语句) {
                    检查合成体区间调用们(池, 整64(链节.文本), 整64(链节.子起点),
                                        符号表, 诊断, 传播表);
                    检查合成体块逃逸(池, 整64(链节.附加), 符号表, 诊断, 传播表);
                    链游 = 整64(链节.子终点);
                } 否则 {
                    如果 (链节.类型 == 节点_块) {
                        检查合成体块逃逸(池, 链游, 符号表, 诊断, 传播表);
                    }
                    链游 = 0;
                }
            }
        } 否则 如果 (语句.类型 == 节点_当语句) {
            检查合成体区间调用们(池, 整64(语句.文本), 整64(语句.子起点),
                                符号表, 诊断, 传播表);
            检查合成体块逃逸(池, 整64(语句.附加), 符号表, 诊断, 传播表);
        } 否则 如果 (语句.类型 == 节点_情况标签) {
            检查合成体块逃逸(池, 整64(语句.子起点), 符号表, 诊断, 传播表);
        }
        si++;
    }
}

// lambda 合成体逃逸检查入口（#486·lambda合成类型 返回推导后挂载）：体内
//   传播表=主表拷贝（外层传播链体内可见=宿主 enterLambdaBody 快照同语义；
//   体内登记写体内表·检查完随作用域丢弃=零主表污染·宿主 exitLambdaBody
//   快照恢复同构）。435 挂点全族（返回/声明/赋值/实参位）体内同查；不安全
//   豁免由各挂点内部 读当前函数不安全() 承担（合成体检查时机=定义处所在
//   外层函数检查流内=豁免语义「不安全 函数 内定义豁免」精确对齐）。
//   688 立法原始动机（主遍历无参作用域查体=全局键基碰撞错诊断）不受影响：
//   本遍只在 lambda合成类型 的参数作用域已压+体内声明已登记后运行
//   （语义检查lambda.cn 挂载点），体内名解析走合成体自身作用域链。
不安全 函数 检查合成体逃逸(向量<节点> 池, 整64 合成索引,
                       向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    如果 (合成索引 < 0 || 合成索引 >= 池.大小()) { 返回; }
    节点 合成 = 池.元素(整32(合成索引));
    整64 名ID486 = 整64(合成.文本);
    结果<整64, 整32> 查重486 = 合成体逃逸已查们.获取(名ID486);
    如果 (查重486.正常) { 返回; }
    结果<空类型, 整32> 登查486 = 合成体逃逸已查们.设置(名ID486, 1);
    如果 (!登查486.正常) { 运行时错误(4); }
    映射<整64, 整64> 体内表486 = 引用lambda变量们;
    检查合成体块逃逸(池, 整64(合成.子终点), 符号表, 诊断, 体内表486);
}
