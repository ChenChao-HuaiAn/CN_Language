                    //   诊断文本与宿主逐字对齐（dual 负测锚）。守卫=基名∈{向量,
                    //   栈,链表,队列,集合}（映射值面宿主连声明都拒=另域·映射<类>
                    //   声明分叉挂 272 行注记）·方法∈入容器白名单·实参=标识符
                    //   形态（表达式/三元实参=推导不可靠面放行·217 诚实边界同款）。
                    字符串 基名272 = 合成名基名(字符串复制(驻留文本(调对象类型)));
                    布尔 容器守卫272 = 字符串比较(基名272, "向量") ||
                        字符串比较(基名272, "栈") || 字符串比较(基名272, "链表") ||
                        字符串比较(基名272, "队列") || 字符串比较(基名272, "集合");
                    如果 (容器守卫272 &&
