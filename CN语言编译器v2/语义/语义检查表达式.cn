        //   「不可跨线程搬运」与宿主逐字一致（608 dual 判据）。
        如果 ((字符串比较(被调文本, "新线程") || 字符串比较(被调文本, "线程::新线程") ||
              字符串比较(被调文本, "线程::新") || 字符串比较(被调文本, "线程.新")) &&
