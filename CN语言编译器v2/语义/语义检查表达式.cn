                    }
                }
            }
        }
        // plans/019 阶段1（2026-09-10）：显式转移 转移(变量) 特判——实参须为
        //   变量标识符；分级：标量拒绝（复制语义）/指针与字符串放行（值交接，
        //   标记已转移+返回实参类型）/拥有资源类型（容器/类/结果等）v2 第一版
        //   暂不支持（宿主声明初始化位已锚定，v2 容器位随阶段3 浅拷贝对齐）。
        //   实参首查先于调用节点（线性顺序）=首次转移不误报，此处标记后
        //   区间后段任何使用经 检查标识符表达式 拒绝。
        如果 (字符串比较(被调文本, "转移")) {
                返回 检查转移调用(池, n, 调用起点, 符号表, 诊断);
            }
        // 206-c（波 4·plans/020 第七十二节）：复制(表达式) 泛型克隆内置——
        //   与 转移(x) 构成显式「复制/移动」双内置（C++ copy/move 对照物，
        //   Rust Clone::clone 同构）。返回类型=实参类型（泛型内置无法固定
        //   签名注册 → 调用处特判）；类型 ID 写入调用节点.子终点 供 IR 层
        //   生成复制展开 按类型分派发射。
        如果 (字符串比较(被调文本, "复制")) {
                返回 检查复制调用(池, n, 节点索引, 调用起点, 符号表, 诊断);
            }
        // P7b：容器类构造调用（向量<整64>() 语法层已合成 向量$整64 被调标识符）
        //   合法——返回类型=被调实例名自身（1181·2026-10-20：原「暂按 整64
        //   （对象指针）兜底」=静默默认值（110 案同族）：显式声明位不消费该
        //   返回值（声明类型已知）故存量不可见；推断声明位（变量 v = 向量<整32>()
        //   ·46-c 通道）消费它 → 推断类型=整64 → IR 层标量单槽+类型权威表
        //   挂整64 → v.追加() 方法调用对象类型三分派全 miss（ir2 显形中止）。
        //   宿主 checkExpr 对构造调用返回构造类名同构对齐；装箱构造
        //   （正常/错误/某些）类型=外部语境载荷，不落本分支（先行拦截）。
        如果 (是容器类(被调文本)) {
            返回 被调名;
        }
        // 灰色点④根治（2026-09-04 用户裁决立案·缺陷零容忍）：强转类型名
        //   白名单补 整8/整16（宿主窄宽强转已支持——整8(300)=44；原白名单
        //   九名缺失时落「未声明函数: 整8」）。
        //   2026-09-04 缺陷零容忍收口：正8/正16 补入（原「显式拒绝」系
        //   无符号语义缺位搁置——违反尽善尽美；现 IR 层 T_正8/T_正16
        //   零扩展标注+双后端 movzx/uxtb 落地，正8(200)=200 语义正确）
        如果 (字符串比较(被调文本, "整32") || 字符串比较(被调文本, "整64") ||
             字符串比较(被调文本, "浮32") || 字符串比较(被调文本, "浮64") ||
             字符串比较(被调文本, "布尔") || 字符串比较(被调文本, "字符") ||
             字符串比较(被调文本, "字符串") || 字符串比较(被调文本, "正32") ||
             字符串比较(被调文本, "正64") || 字符串比较(被调文本, "整8") ||
             字符串比较(被调文本, "整16") || 字符串比较(被调文本, "正8") ||
             字符串比较(被调文本, "正16") ||
             // 967（002·053 复工）：128 位强转（整128(1)/正128(999)——409/419
             //   转换构造族；IR 层 810 双半通道既有）
             字符串比较(被调文本, "整128") || 字符串比较(被调文本, "正128") ||
             // 418（002 收口杂项正测族）：指针(整数) 强转（spec 04-一C 指针↔整数
             //   同权·类型码层 指针=T_整64 单槽直通）——原缺席报「未声明函数: 指针」
             //   （16_function_extra 行58 实录）
             字符串比较(被调文本, "指针")) {
            // 329-a（D38 批2·343）：显式转换实参类型检查（单实参形态）——
            //   布尔目标仅收布尔源/字符串与结构体源拒/数值互转含窄化放行
            如果 (n.附加 == 1) {
                检查显式转换实参(池, n, 节点索引, 被调文本, 符号表, 诊断);
            }
            返回 被调名;
        }
        // 函数调用：查符号表（符号_函数 附加=返回类型ID）
        // plans/018 第 3 层：表查找类型ID 内部已三级化（①②③）——命中
        //   用户函数时把决议键基写入 调用决议键基们（语义驱动 IR：第 4 层
        //   决议函数符号 据此锁定候选模块桶，宿主 resolvedSignature 同构）
        // T69（480-a 深度机）：函数指针间接调用——被调标识符声明类型是函数指针
        //   时优先于「函数调用」分支（宿主 semantic_call.cpp:185-204 先直接函数名、
        //   失败后 checkExpr(callee)→checkFuncPtrCall 同序）；否则指针变量会被
        //   当普通函数登记决议键基（错决议）。结果类型=签名返回类型。
        // 193（2026-10-13 任务193）：抽象类/接口构造调用 形状()/可叫() 语义层
        //   拒绝——与变量裸声明检查同族（宿主 checkCtorCall 193 同构·specs/06
        //   §八·C++ cannot instantiate abstract class 同款）。原缺陷=接口名
        //   静默落后续链放行、抽象类落 951 分支按无构造类默认构造放行（IR 层
        //   无体跳过=空洞对象）。诊断后返回 被调名（继续链·单诊断口径）。
        // 728j（2026-10-14）：抽象类诊断补未实现方法名清单（多层继承指路·
        //   宿主 semantic_call_ctor.cpp 同文案逐字一致）。
        如果 (是接口名ID(驻留(被调文本))) {
            表诊断(诊断, "[错误] 不能实例化接口 '" + 字符串复制(被调文本) +
                          "'（接口无实现体）——请以实现类实例初始化接口变量");
            返回 被调名;
        }
        如果 (是抽象类ID(驻留(被调文本))) {
            表诊断(诊断, "[错误] 不能实例化抽象类 '" + 字符串复制(被调文本) +
                          "'（未实现抽象方法：" + 未实现抽象顿号串(驻留(被调文本)) +
                          "）——请实例化具体派生类");
            返回 被调名;
        }
        // 951（002·B 类推断面·485/104 族）：用户类构造调用（计数器()）——
        //   类名不注册符号表（类表独立）→函数查找/签名回退/内置链全 miss→
        //   推断声明「初值类型未知」误拒；对齐容器类分支（返回整64 指针兜底）
        //   之前的真实类型：构造调用返回类名自身（对象指针语义·布局层按类名
        //   分派 NewObject）
        如果 (是用户类(被调文本)) {
            登记调用决议(符号表, 被调名, 整64(节点索引));
            返回 被调名;
        }
        // 415（wt415·658 面）：泛型实参隐式推导（宿主 303 场景②同构）——被调=
        //   裸名命中泛型函数参数序表→实参可靠面逐位推导→被调文本改写为实例
        //   合成名（名$实参）→复用显式 <> 全链（IR 收集/克隆/签名/决议）。
        //   返回=实例返回类型（T 替换后）；0=未改写（不可靠面→原链现状）；
        //   -1=可靠面推导失败（1030·诊断拒绝见下）。
        //   先于函数指针/签名表分支——泛型基函数本体不生成（IR 生成分派跳过），
        //   裸名+参数序表命中时改写为实例调用=唯一正确通路（无抢占问题）。
        如果 (被调节点.类型 == 节点_标识符) {
            整64 推导返回415 = 推导改写泛型隐式调用(池, 节点索引, 符号表);
            // 1030：哨兵判定用显式枚举（域=0 未改写 / 0-1 失败 / 正=实例返回
            //   类型 ID）——非单边开区间形态，对齐 check_miss_gate 机械判据。
            如果 (推导返回415 != 0 && 推导返回415 != 0 - 1) {
                // 1030（v08 形态·宿主「同一调用中变量被可变借用两次」对齐）：
                //   隐式推导成功=本路径早退（738 显式分支面为 <> 形态抽查点）
                //   ——借用纪律须在此早退点执行：原 202 检查仅达 找到类型/
                //   签名回退面，泛型实例调用别名可变冲突（加倍(a,a)）漏检
                //   （宿主拒 v2 放行实录）。
                检查泛型调用借用纪律1030(池, 节点索引, 被调文本, 符号表, 诊断);
                返回 推导返回415;
            }
            // 1030（1017 采样轮探针 p19 同族·静默禁令）：0-1=泛型基函数调用
            //   且实参全可靠面推导失败（类型冲突/形参形态不匹配/未约束）——
            //   原静默放行致 IR 按基函数形参造符号（_名_A_T54_A_T54）链接
            //   undefined（_交换_T_T 双实参位零诊断缺符号实录）；与宿主
            //   「未声明的标识符」诚实拒绝面同轴（双侧同拒·文案 v2 指路化）。
            如果 (推导返回415 == 0 - 1) {
                表诊断(诊断, "[错误] 无法推导泛型函数 '" + 被调文本 +
                              "' 的类型实参（实参类型不一致或与形参形态不匹配）");
                返回 -1;
            }
        }
        整64 间接类型480 = 表查找类型ID(符号表, 被调名);
        // 432（#276 波3）：**函数符号优先于函数指针变量调用**——函数返回类型
        //   为函数指针类型文本时（`函数 造加倍() -> 整32(*)(整32)`），符号表
        //   该名的类型ID=返回类型串，原判定误入 480 分支把零实参函数调用按
        //   fnptr 签名查参（731 实弹：「需 1 个实参，实给 0 个」误拒·与宿主
        //   semantic_call.cpp 先直接函数名后 fnptr 同序对齐）。种类=函数 →
        //   落下方函数调用分支（种类查询与类型查询同走查序·遮蔽一致）。
        如果 (间接类型480 != -1 &&
             表查找种类(符号表, 被调名) != 符号_函数 &&
             是函数指针类型文本(字符串复制(驻留文本(间接类型480)))) {
            返回 检查函数指针调用480(池, n, 节点索引, 诊断, 被调文本,
                                    字符串复制(驻留文本(间接类型480)));
        }
        整64 找到类型 = 表查找类型ID(符号表, 被调名);
        如果 (找到类型 != -1) {
            // 553（#443 呈报分叉①·宿主 semantic_call.cpp:238-253 同构）：
            //   **非函数被调**检查——被调名符号非函数（结构体名/变量/类对象/
            //   顶层常量）且无同名函数签名登记时，宿主 checkExpr(callee) 推导
            //   类型后报「无法调用非函数类型 'X'」：结构体名/类名 → 名文本
            //   自身（宿主 checkExpr 结构体名标识符给出类型名）、变量 → 类型
            //   文本（指针变量补星）。原 v2 命中即放行=非法放行落码（结构体名
            //   点(1,2) 链 LNK2019「?点@@Y」实录·v2 侧链到目标文件仍产 asm）。
            //   豁免=同名函数存在时宿主 hasFunctionName 先行（函数调用形态·
            //   含局部变量遮蔽全局函数名）——不误伤（p9 函数同名形态）；
            //   fnptr 变量调用（480 分支）已先行；类名构造/接口/抽象类/容器名
            //   各分支均已先行，到达此处的 符号_结构体 恒为结构体名（宿主
            //   checkCtorCall 对结构体名不认=落「无法调用非函数类型」）。
            整64 种类553 = 表查找种类(符号表, 被调名);
            布尔 豁免553 = 种类553 == 符号_函数;
            如果 (!豁免553) {
                整64 键基553 = 三级键基查找(符号表, 被调名, 0 - 1);
                如果 (键基553 >= 0 && 查函数签名个数(键基553) > 0) {
                    豁免553 = 真;
                }
            }
            // 553：方法值变量豁免（1002 ⑥/440 回归误伤根治）——「变量 cb =
            //   对象.方法」（用户类实例方法绑定值·有参∪构造∪析构）及其拷贝链
            //   变量被调：宿主 genVarDecl closureInfo_ 登记放行；v2 类型登记=
            //   方法返回类型（480 miss）须按初始化来源识别（实现=语义检查443.cn
            //   是方法值变量553·806 判据复用）。不识别（普通变量/字面量初值）
            //   =照报——分叉①坏样本面不受影响。
            如果 (!豁免553) {
                如果 (是方法值变量553(池, 被调名, 整64(节点索引), 符号表, 0)) {
                    豁免553 = 真;
                }
            }
            // 031（#1075）：方法值类型变量/形参调用豁免——被调变量类型文本=
            //   方法值< 前缀（宿主 semantic_call.cpp「方法值变量调用」分支
            //   checkMethodValueCall 同面：静态类型驱动零新语法·cb(实参)）。
            //   推断声明（推导改判后）与形参（本类型语法）双形态覆盖。
            如果 (!豁免553) {
                如果 (找到类型 > 0 &&
                    是方法值类型文本(字符串复制(驻留文本(找到类型)))) {
                    豁免553 = 真;
                }
            }
            如果 (!豁免553) {
                字符串 实际文本553 = "";
                如果 (找到类型 == 0 || 种类553 == 符号_结构体) {
                    实际文本553 = 字符串复制(驻留文本(被调名));
                } 否则 {
                    实际文本553 = 推导检查类型文本(池, 整32(调用起点), 符号表);
                    如果 (字符串长度(实际文本553) == 0) {
                        实际文本553 = 字符串复制(驻留文本(找到类型));
                    }
                }
                表诊断(诊断, "[错误] 无法调用非函数类型 '" + 实际文本553 + "'");
                返回 找到类型;
            }
            登记调用决议(符号表, 被调名, 整64(节点索引));
            // plans/019 阶段3b：调用借用纪律（主路径——键基近似=被调名）
            检查调用借用纪律(池, 节点索引, 被调名, 符号表, 诊断);
            // 549：实参→形参转换检查（单候选普通函数·宿主 checkDirectCall 判定同构）
            检查调用实参转换(池, 节点索引, 符号表, 诊断);
            返回 找到类型;
        }
            // 呈报③方案A（2026-09-06）：签名键改造后纯名查不到——按签名表同名候选回退
            //   （精确决议在 IR 层）；plans/018 第 3 层：回退键基化（三级决议）。
            //   203-a：段提取为 检查签名键回退（-1=未决议哨兵，主函数继续内置/限定/未声明链）。
            整64 回退类型 = 检查签名键回退(池, n, 节点索引, 符号表, 诊断, 被调名);
            如果 (回退类型 != -1) {
                // 549：实参→形参转换检查（签名回退面·同上）
                检查调用实参转换(池, 节点索引, 符号表, 诊断);
                返回 回退类型;
            }
        // ③ 第一波（2026-09-03）：内置函数调用（驻留/字符串族/运行时错误——
        //   IR 层映射 ASCII 运行时符号直调）；类型大小(类型) 编译期折叠 -> 整64
        // 474（运行期整数溢出·回绕逃生门）：回绕加/回绕减/回绕乘 三件套——
        //   两补码回绕语义（错误码 8 溢出检查的显式豁免口·宿主同构）。类型规则
        //   与算术运算符一致（窄域保持窄域·结果=第一实参域）。IR 层经
        //   生成回绕展开 发射（附加<0 回绕协议·不走运行时符号直调）。
        如果 (字符串比较(被调文本, "回绕加") || 字符串比较(被调文本, "回绕减") ||
             字符串比较(被调文本, "回绕乘")) {
            如果 (n.附加 != 2) {
                表诊断(诊断, "[错误] 回绕加/回绕减/回绕乘 恰需 2 个整型实参");
                返回 0;
            }
            // 1311 P1-1：整数操作数守卫（宿主 checkWrapBuiltinCall 同文案——
            //   字符串/布尔/浮点等非整数实参双侧一致拒绝；0=推导 miss 不误报）。
            //   守卫失败=诊断已出，返回 0（语义错误计数使编译中止）。
            布尔 整数实参有效474 = 检查回绕整数实参474(池, 节点索引, 符号表, 诊断);
            如果 (整数实参有效474) {
                返回 回绕调用返回类型474(池, 节点索引, 符号表);
            }
            返回 0;
        }
        整64 内置返回 = 内置函数返回类型ID(被调文本);
        // 930（930 批 linux-v2 SIGSEGV 根治）：限定名内置让位模块公开函数——
        //   导入驱动加载的模块源码（模$符 签名存在）优先于内置直调（宿主
        //   rewriteQualifiedCall userFuncExists && moduleLoaded 等价形态；
        //   自模块包装自引用豁免见 模块函数优先930）。让位后落入下方 检查限定
        //   调用（776）决议到模块函数——返回类型=模块函数真实签名（结果<...>），
        //   与宿主零分叉。无源码内置（无导入形态）零变化。
        如果 (内置返回 != 0 && !模块函数优先930(被调文本)) {
            检查变参打印实参(池, n, 节点索引, 符号表, 诊断);   // 443/539：变参内置（打印/打印行/格式化）实参类型检查（宿主 checkVariadicBuiltinCall 同构·非变参内部早退）
            返回 内置返回;
        }
        如果 (字符串比较(被调文本, "类型大小")) {
            // 376（v17 六族对齐批·001 02§六B 参数清单）：类型大小 参数清单=
            //   基础类型/结构体/数组/指针/限定类型/泛型实参——结果/可选 未列，
            //   友好拒绝（宿主 visitSizeofExpr 同款文案；宿主修前=内部错误
            //   形态违反诊断纪律·v2 修前=合成体尺寸放行超立法面——c359 实证）。
            //   类型名实参与下标形实参（元素为盒）两形态同拦。
            如果 (n.附加 == 1 && 调用起点 > 0 && 节点索引 >= 2) {
                节点 段末x376 = 池.元素(节点索引 - 1);
                整64 盒名x376 = 0;
                如果 (段末x376.类型 == 节点_标识符) {
                    如果 (是结果类型(字符串复制(驻留文本(整64(段末x376.文本))))) {
                        盒名x376 = 整64(段末x376.文本);
                    }
                } 否则 如果 (段末x376.类型 == 节点_下标 && 段末x376.子起点 > 0) {
                    节点 基名x376 = 池.元素(整32(段末x376.子起点));
                    如果 (基名x376.类型 == 节点_标识符 &&
                         是结果类型(字符串复制(驻留文本(整64(基名x376.文本))))) {
                        盒名x376 = 整64(基名x376.文本);
                    }
                }
                如果 (盒名x376 > 0) {
                    表诊断(诊断, "[错误] 类型大小: 参数类型不支持 '" +
                                字符串复制(驻留文本(盒名x376)) +
                                "'（02 §六B 参数清单=基础类型/结构体/数组/指针/限定类型/泛型实参）");
                    返回 驻留("整64");
                }
            }
            // 967（002·57 转批）：**语义层整体折叠**——类型大小(类型) 单实参
            //   调用节点改写为整数字面量（文本=宽度），实参段（含被调标识符）
            //   各节点改 节点_参数 占位（生成层主循环不处理=跳过·零残留压栈）。
            //   宽度支持：基本/容器/结果/结构体（类型名宽度 单点·含数组文本
            //   「整64[5]」=元素宽×长度分支）；下标形实参（类型大小(整64[5])）
            //   段末=下标根→基名×长度解析。宽度 0（未知/指针形）→不改写落
            //   IR 层原路径（折叠诊断/原语义）。
            如果 (n.附加 == 1 && 调用起点 > 0 && 节点索引 >= 2) {
                节点 段末967 = 池.元素(节点索引 - 1);
                整64 宽度967 = 0;
                如果 (段末967.类型 == 节点_标识符) {
                    // 930b（681 偶发红根治·宿主 typeSizeOf 对齐）：类型大小(用户类)
                    //   =**对象实宽**（实例布局字节数）——类型名宽度 用户类分支=8
                    //   （句柄槽口径·221 修⑮ 变量/拷贝面）不适用 sizeof 语义：修前
                    //   折叠 8 → 分配(类型大小(类)) 只给 8 字节 → 字段写越界撞相邻
                    //   块（681 win 侧偶发 堆:值=21/22·develop 顶同斑=既有缺陷）。
                    //   形态=默认原表 + 用户类非容器覆盖（容器/结果/数组/标量/
                    //   结构体同源不变；宿主 typeSizeOf 同口径）。
                    宽度967 = 类型名宽度(整64(段末967.文本));
                    字符串 类967c = 字符串复制(驻留文本(整64(段末967.文本)));
                    如果 (是用户类(类967c) && !是容器类(类967c)) {
                        宽度967 = 查结构体大小(驻留(类967c));
                    }
                } 否则 如果 (段末967.类型 == 节点_下标 && 段末967.子起点 > 0) {
                    节点 基名967 = 池.元素(整32(段末967.子起点));
                    节点 长度967 = 池.元素(整32(段末967.子终点 - 1));
                    如果 (基名967.类型 == 节点_标识符 &&
                         长度967.类型 == 节点_整数字面量 &&
                         段末967.子终点 - 段末967.子起点 == 2) {
                        // 930b：数组元素为用户类时同取对象实宽（默认原表·覆盖式）
                        整64 元素宽967 = 类型名宽度(整64(基名967.文本));
                        字符串 元名967c = 字符串复制(驻留文本(整64(基名967.文本)));
                        如果 (是用户类(元名967c) && !是容器类(元名967c)) {
                            元素宽967 = 查结构体大小(驻留(元名967c));
                        }
                        整64 长度值967 = 0;
                        字符串 长度文本967 = 字符串复制(驻留文本(整64(长度967.文本)));
                        整64 li967 = 0;
                        布尔 合法967 = 字符串长度(长度文本967) > 0;
                        当 (li967 < 字符串长度(长度文本967)) {
                            整64 字节967 = 整64(长度文本967[整32(li967)]) & 255;
                            如果 (字节967 < 48 || 字节967 > 57) { 合法967 = 假; 中断; }
                            // 474：>18 位有效数字=必超域宽（防中间值溢出·自举安全）
                            如果 (li967 > 18) { 合法967 = 假; 中断; }
                            长度值967 = 长度值967 * 10 + (字节967 - 48);
                            li967++;
                        }
                        如果 (元素宽967 > 0 && 合法967 && 长度值967 > 0) {
                            宽度967 = 元素宽967 * 长度值967;
                        }
                    }
                }
                如果 (宽度967 > 0) {
                    整64 占i967 = 调用起点;
                    当 (占i967 < 节点索引) {
                        节点 占位967 = 池.元素(整32(占i967));
                        占位967.类型 = 节点_参数;
                        占位967.子起点 = 0;
                        占位967.子终点 = 0;
                        占位967.附加 = 0;
                        结果<空类型, 整32> 设占967 = 池.设置(整32(占i967), 占位967);
                        如果 (!设占967.正常) { 运行时错误(4); }
                        占i967++;
                    }
                    节点 折叠节点967 = 池.元素(节点索引);
                    折叠节点967.类型 = 节点_整数字面量;
                    折叠节点967.文本 = 整32(驻留(整数转字符串(宽度967)));
                    折叠节点967.子起点 = 0;
                    折叠节点967.子终点 = 0;
                    折叠节点967.附加 = 0;
                    结果<空类型, 整32> 设折967 = 池.设置(节点索引, 折叠节点967);
                    如果 (!设折967.正常) { 运行时错误(4); }
                }
            }
            返回 驻留("整64");
        }
    整64 限调类型 = 检查限定调用(池, 节点索引, 符号表, 诊断);
    如果 (限调类型 != -2) {
        返回 限调类型;
    }
        // 419-a（D42 波 3）：泛型函数显式实例化调用（名<实参>(...)——合成名
        //   名$实参·基名命中 泛型基类参数序（函数共用表）→放行（单态化生成
        //   供给定义）
        // 419-a 修正（越界归因）：放行必须返回**真实类型 ID**（-1 哨兵会被上层
        //   当类型索引进向量=数组越界）
        // 415（wt415）：返回类型=T 替换后的实例返回类型（原 MVP=整32——整64/
        //   浮64 返回实例语义标注错·421 只读大小<整32>->整64 打印面实录）。基
        //   函数定位（全池扫 节点_函数·894-a 同款）miss 时保守 整32（原型缺失
        //   面·不回退）；返回位指针层已并文本·克隆体登记段同源。
        如果 (字符串长度(剥实例基名(被调文本)) > 0 &&
             !字符串比较(剥实例基名(被调文本), 被调文本) &&
             查泛型基类参数序(驻留(剥实例基名(被调文本))) != 0) {
            // 766：泛型**类**显式构造调用（类名<实参>(...)——基名∈用户类们）
            //   先于函数基函数扫描分流：类与函数共用 泛型基类参数序表（417-a），
            //   原路径对类构造直落下方全池 节点_函数 扫描（基名是类非函数=
            //   必然 miss）→「泛型显式实例基函数定位 miss '盒子$整32'」误中止
            //   （26_generics 行83/42 用例基线红实录·宿主绿 v2 红分叉）。
            //   修法对齐 951 构造通道（用户类构造调用返回类名自身·对象指针
            //   语义）：返回=实例合成名ID（盒子$整32）——声明类型/初值类型
            //   同名同源；IR 层实例化注册已把克隆体登记为完整用户类（登记
            //   用户类(实例ID)·IR类中），生成转换或构造调用 的 是用户类 判定
            //   自然命中 → 发射用户类构造（分配对象+构造符号 实例$基名），
            //   调用位实例收集由 收集泛型实例 调用位分支既有覆盖（419-a）。
            如果 (是用户类(剥实例基名(被调文本))) {
                返回 驻留(被调文本);
            }
            整64 显式返回415 = 驻留("整32");
            布尔 命中基函648 = 假;
            {
                整64 扫e415 = 0;
                当 (扫e415 < 整64(池.大小())) {
                    节点 函e415 = 池.元素(整32(扫e415));
                    如果 (函e415.类型 == 节点_函数 &&
                         整64(函e415.文本) == 驻留(剥实例基名(被调文本)) &&
                         函e415.子起点 < 函e415.子终点) {
                        命中基函648 = 真;
                        // 1030（v08 形态）：显式/改写实例调用面借用纪律（公共实现
                        //   检查泛型调用借用纪律1030·隐式推导早退处同调用）
                        检查泛型调用借用纪律1030(池, 节点索引, 被调文本, 符号表, 诊断);
                        如果 (整64(函e415.附加) > 0) {
                            // T→实例实参替换（参数序表拆段×剥实例参数段）
                            向量<整64> 参数名e415 = 向量<整64>();
                            泛型参数序拆段(查泛型基类参数序(驻留(剥实例基名(被调文本))), 参数名e415);
                            向量<整64> 实参e415 = 向量<整64>();
                            剥实例参数段(被调文本, 实参e415);
                            如果 (参数名e415.大小() == 实参e415.大小() &&
                                 参数名e415.大小() > 0) {
                                字符串 替换返回415 = 替换实例类型文本(
                                    字符串复制(驻留文本(整64(函e415.附加))),
                                    参数名e415, 实参e415);
                                显式返回415 = 驻留(替换返回415);
                            }
                        } 否则 {
                            // 648：miss 不可静默——基函数定位命中但无返回类型标注
                            //   （附加<=0·与 110 案同构）；显形经 IR 包收集表
                            //   （登记处出诊断行·主收尾统一中止），原整32 兜底
                            //   保留（中止前路径）
                            登记内部未登记("泛型显式实例基函数无返回标注", 被调文本,
                                           整64(取当前诊断行()));
                        }
                        中断;
                    }
                    扫e415++;
                }
            }
            如果 (!命中基函648) {
                // 770（#800）：泛型类构造调用（被调文本=类实例名·池中有同名类节点）
                //   ——类构造无「基函数」，返回类型=实例类型文本本身。容器族
                //   （向量/链表/栈/队列）由前置容器面决议不流经此；字符串映射
                //   过渡止血类等非容器泛型类的构造调用此前落此 miss（648 显形·
                //   arm64 档每头必红实锤）。
                如果 (查类节点索引(驻留(剥实例基名(被调文本))) != 0 - 1) {
                    返回 驻留(被调文本);
                }
                // 648：miss 不可静默——泛型显式实例基函数定位 miss（110 案完全
                //   同构·全池扫无 节点_函数 文本匹配=原型缺失面）；显形经 IR 包
                //   收集表（登记处出诊断行·主收尾统一中止），原整32 兜底保留
                //   （中止前路径）
                登记内部未登记("泛型显式实例基函数定位 miss", 被调文本,
                               整64(取当前诊断行()));
            }
            返回 显式返回415;
        }
        // -2 = 使用点歧义（E0659 已在三级决议内经缓冲诊断）——不重复报
        如果 (三级键基查找(符号表, 被调名, 0 - 1) != -2) {
            表诊断(诊断, "[错误] 未声明函数: " + 被调文本);
        }
        返回 -1;
    }
    }
    // 648 归档（豁免边界声明）：调用表达式终态兜底=常态回退通道（方法调用/
    //   容器面在成员路径与 IR 层调用面精确决议后仍流经此终态·L2 123/125/126/
    //   127/129/147/156/203/216/441/442 十一用例实证）——首记 648 曾登记后
    //   回撤；110 同构显形面在 泛型显式实例 两态登记（命中基函648）。
    返回 驻留("整64");
}


// ==================== T69（480-a 深度机）函数指针调用检查 ====================
// 宿主 semantic_call.cpp:353-382 checkFuncPtrCall 同构：实参个数须与签名参数表
//   严格相等（宿主 359-366 个数不符即诊断）+ 结果类型=签名返回类型（宿主 378）。
//   逐参类型转换检查（宿主 canConvertWithLiteral 368-377）：v2 侧实参类型推导面
//   （表达式类型ID）覆盖面有限——本轮以「个数严格 + 返回类型正确」为编译期防线，
//   逐参类型精确转换=诚实边界（与 v2 语义推导完善同步收口）；ABI 正确性由三后端
//   参数位装载 + 双编译对照用例（09_integration/318/99/40）运行级锚定。

// 1030（1017 采样轮 p19 同族·v08 形态）：泛型实例调用借用纪律——被调=实例
//   合成名（名$实参）剥基名→全池扫基函数节点（与 738 显式实例分支扫描同构
//   重复·待归纳；894-a 同款同名唯一）→取参数借位（取方法参数借位们 区间布局
//   对自由函数通用）→借用位扫描202。调用点=本文件 检查调用表达式 推导早退处
//   与显式实例分支（两处同源）；无引用位/个数不符/基函数 miss=诚实边界零检查
//   （对齐构造/方法/普通函数三面·防误伤）。
函数 检查泛型调用借用纪律1030(向量<节点> 池, 整32 调用节点索引,
                         字符串 被调文本, 向量<映射<整64, 符号>>& 符号表,
                         向量<字符串>& 诊断) -> 空类型 {
    节点 n1030g = 池.元素(调用节点索引);
    整64 实参数1030g = 整64(n1030g.附加);
    如果 (实参数1030g == 0) { 返回; }   // 1030：无实参=零引用位面（==0 显式枚举·非单边区间）
    字符串 基名1030g = 剥实例基名(被调文本);
    如果 (字符串长度(基名1030g) == 0) { 返回; }
    整64 基名ID1030g = 整64(驻留(基名1030g));
    整64 扫1030g = 0;
    当 (扫1030g < 整64(池.大小())) {
        节点 函1030g = 池.元素(整32(扫1030g));
        如果 (函1030g.类型 == 节点_函数 &&
             整64(函1030g.文本) == 基名ID1030g &&
             函1030g.子起点 < 函1030g.子终点) {
            向量<整64> 引位1030g = 向量<整64>();
            向量<整64> 常位1030g = 向量<整64>();
            整64 个数1030g = 取方法参数借位们(池, 扫1030g, 引位1030g, 常位1030g);
            如果 (个数1030g == 实参数1030g) {
                借用位扫描202(池, 调用节点索引, 实参数1030g, 引位1030g,
                            常位1030g, 符号表, 诊断);
            }
            返回;
        }
        扫1030g++;
    }
}

// ==================== 933：引用返回调用读值类型归一辅助（调用分派消费） ====================
// 引用返回调用（T&）读值类型归一——表达式值类型=剥尾 '&'（值语义·宿主 986
//   起调用表达式消费面同口径）。原样返回「字符串&」致消费点把引用返回调用当
//   非字符串（933 探针：`b.读名() == "盒名"` 误拒「指针只能与……」、
//   `b.读名()[0]` 误拒「下标访问要求数组或指针」——宿主均放行=双侧分叉）。
//   左值语义通道（引用绑定/赋值目标/是引用返回调用 判定）不消费本返回值，
//   天然不受剥影响；-1（不可推导）/空=原样。⚠ 用户类方法调用面 检查调用表达式
//   推导=「整64 兜底」（见 :648 归档注）——剥无从施行，比较/下标消费点另有
//   直判（是引用返回字符串调用933语义）；本函数覆盖自由函数等可推导面。
//   位置迁注（933）：原落 语义检查.cn，该文件 909 行超警戒线——「先拆再加」
//   纪律迁入本文件（表达式检查族）。
函数 剥引用尾归933(整64 类型ID) -> 整64 {
    如果 (类型ID <= 0) { 返回 类型ID; }
    字符串 t = 字符串复制(驻留文本(类型ID));
    如果 (字符串长度(t) > 0 && ((整64(t[字符串长度(t) - 1]) & 255) == 38)) {
        返回 驻留(字符串子串(t, 0, 字符串长度(t) - 1));
    }
    返回 类型ID;
}
