// CN 自举编译器 v2 · 语义检查表达式（R3 千行拆分，2026-09-08）
// 职责：检查表达式 的三大分支族——标识符（含限定名解析）/下标/调用
//   （含限定调用）——自 语义检查.cn 机械搬移（零逻辑变化），检查表达式
//   主干（字面量/成员/取地址解引用/二元/三元）留原文件并分派至此。
// 模块路径=语义检查表达式（新键基）；仅被 语义检查 消费。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（目录包名）
导入 IR;         // 容器/结果 合成名判定（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 语义检查逃逸;   // 435：lambda 引用捕获逃逸检查（返回/赋值/实参/声明位·包内兄弟）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

公开:   // 全文件公开（检查族供 语义检查 分派消费）



// 调用表达式检查（P6g 调用/类型转换 + P7b 容器构造 + 三级决议 + 内置）：
//   被调标识符节点索引在 子起点（语法层后缀链记录）。
// plans/019 阶段3b 残余（2026-09-10 第六十五轮）：调用借用纪律——①实参为
//   当前函数常量（只读）引用参数而形参为可变引用=只读借出可变拒；②同调用
//   可变引用位与常量引用位实参同基础名=互斥（语句级第一版）。被调键基取
//   签名表首候选（重载族精确决议在 IR 层=诚实边界）。
函数 检查调用借用纪律(向量<节点> 池, 整32 调用节点索引, 整64 被调键基,
                      向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    节点 调用n = 池.元素(调用节点索引);
    整64 实参数 = 调用n.附加;
    如果 (实参数 <= 0 || 被调键基 < 0) { 返回; }
    整64 查串 = 查函数签名参数串(被调键基 * 键位移);
    如果 (查串 < 0) { 返回; }
    整64 签名键 = 函数签名键(被调键基, 驻留文本(查串));
    整64 首个可变基础名 = -1;
    整64 i = 0;
    当 (i < 实参数) {
        整64 引用位 = 查函数参数引用位(签名键, i);
        整64 常量位 = 查函数参数常量位(签名键, i);
        整64 末位 = 查调用实参末位(调用节点索引, i);
        如果 (引用位 == 1 && 末位 >= 0 && 末位 < 整64(池.大小())) {
            节点 实参末 = 池.元素(整32(末位));
            如果 (实参末.类型 == 节点_标识符) {
                整64 实参名 = 整64(实参末.文本);
                // 188-a（D6·plans/023 B11 变量常量传播）：引用实参=别名逃逸
                //   （被调方可能改写该变量）→ 恒空判定失格（保守，防假阳性）
                登记恒空失格(实参名);
                如果 (常量位 == 1) {
                    如果 (首个可变基础名 == 实参名) {
                        表诊断(诊断, "[错误] 同一调用中变量的可变借用与只读借用互斥: " +
                                      驻留文本(实参名));
                    }
                } 否则 {
                    如果 (是常量引用参数(实参名)) {
                        表诊断(诊断, "[错误] 常量引用参数是只读借用，不能再作为可变引用传参: " +
                                      驻留文本(实参名));
                    }
                    如果 (首个可变基础名 == -1) { 首个可变基础名 = 实参名; }
                }
            }
        }
        i++;
    }
}

// plans/019 阶段3b（2026-09-10）：声明位转移中标志——检查变量声明语句 识别
//   声明初始化位 转移(容器/类) 时置位（区间检查期间），检查调用表达式 的
//   「拥有资源类型仅声明位」分级据此放行（v2 豁免模型浅交接：IR 生成层
//   调用特判=实参值压栈+生成声明 按值 Store=句柄拷贝+调用初值 RAII 豁免
//   ——零 IR 改动即浅交接）
静态 布尔 声明位转移中 = 假;

// 71-a（2026-09-11 方案A 用户裁决）：内置构造器 正常/错误/某些（规范 07-五，
//   编译器预置、用户不可重定义）的装箱语境类型ID——返回位（检查语句 返回语句
//   分支：当前函数返回类型）与声明位（检查变量声明语句：声明目标类型）由检查
//   方设置，区间检查后复位；检查调用表达式 构造器分支读取并写入调用节点.子终点
//   （节点_调用 解析期子终点恒 0=空闲——字段访问「子终点=对象类型ID」预标注
//   同款模式），IR 生成调用 构造器特判直读（语义驱动 IR 同构）。
// 203-a（2026-09-15 第两百零三轮，D1 行数整改）：被调文本分派骨架——构造器/裸释放/
//   转移/签名键回退 四段提取为族方法（程序化切片+双名单差集审计+单文件快验）；
//   装箱语境类型ID 为本文件静态（族① 直接访问）；签名键回退失败以 -1 哨兵返回主函数
//   继续内置/限定/未声明链（与原落空语义等价）。
// 884-a（070·G-N·537）：装箱语境经**映射承载**（键 0）——原「静态 整64」直接
//   赋值受安全区边界（静态变量写须在 不安全 函数内）限制，导致**安全函数**
//   （检查赋值语句·下标赋值位语境）无法设置；映射.设置/获取 为方法调用不受限
//   （865 映射承载同款先例）。
静态 映射<整64, 整64> 装箱语境映射884;

函数 设装箱语境884(整64 类型ID) -> 空类型 {
    结果<空类型, 整32> 设884 = 装箱语境映射884.设置(0, 类型ID);
    如果 (!设884.正常) { 运行时错误(4); }
}

函数 取装箱语境884() -> 整64 {
    结果<整64, 整32> 取884 = 装箱语境映射884.获取(0);
    如果 (取884.正常) { 返回 取884.值; }
    返回 0;
}

// 894-a（070·G-N 特性波3）：实参位期望回取——构造器节点（索引 i）为紧邻
//   后继调用根（i+1）的末实参（池布局惯例：末实参根=调用节点-1）且被调为
//   普通函数（被调节点=标识符）→ 全池扫描该函数定义取末形参类型 ID；末形参
//   非 结果/可选 返回 0。Rust 对照=期望类型下推（Expectation::ExpectHasType
//   (形参)）的**实参侧实现**——语义线性遍历内层构造器先于外层调用根（884-a
//   幂等复用的姊妹时机），外层设语境来不及、由内层自取期望；外层调用根随后
//   的 890/894 覆盖段仍修正「语境已设但类型非末形参」形态（声明位语境兜底面）。
//   成员方法面（被调=成员·容器实例）已有 890 外层覆盖+声明位语境兜底；
//   无语境成员面（`obj.方法(正常(x))` 裸语句）原登记诚实边界（无存量用例）。
//   106（890 残余·泛型方法实参面清偿）：②成员方法支路补齐——被调=成员
//   （对象为标识符）时经 成员方法期望类型106（类定义池扫 + 类头类型参数序
//   实例替换 + 末顶层参数段·415 泛型基础设施）回取期望类型。宿主对照
//   （D14/H2/H3 全绿）：实参位构造器按期望类型下推，不要求声明位语境。
函数 实参位期望类型894(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表) -> 整64 {
    如果 (整64(节点索引) + 1 >= 整64(池.大小())) { 返回 0; }
    节点 后继894 = 池.元素(节点索引 + 1);
    如果 (后继894.类型 != 节点_调用 || 后继894.子起点 <= 0) { 返回 0; }
    节点 后继被调894 = 池.元素(整32(后继894.子起点));
    // 106：成员方法面（对象.方法(构造器)——原诚实边界清偿）
    如果 (后继被调894.类型 == 节点_成员) {
        返回 成员方法期望类型106(池, 后继被调894, 符号表);
    }
    如果 (后继被调894.类型 != 节点_标识符) { 返回 0; }
    // 全池扫描函数定义（池=解析完成全树·无前向引用限制；CN 无重载·同名唯一）
    整64 扫894 = 0;
    当 (扫894 < 整64(池.大小())) {
        节点 函894 = 池.元素(整32(扫894));
        如果 (函894.类型 == 节点_函数 &&
             整64(函894.文本) == 整64(后继被调894.文本) &&
             函894.子起点 < 函894.子终点) {
            // 参数序列正扫（子起点起连续 节点_类型/节点_参数 对·遇首个语句
            //   节点停——单语句体不入块直接续排〔t6 实测·子终点-1 可为返回
            //   语句〕，倒取不可靠）：末 节点_参数 的 附加=类型节点索引
            整64 末参索引894 = 0 - 1;
            整64 扫参894 = 整64(函894.子起点);
            当 (扫参894 < 整64(函894.子终点)) {
                节点 参段894 = 池.元素(整32(扫参894));
                如果 (参段894.类型 == 节点_参数) {
                    末参索引894 = 扫参894;
                } 否则 如果 (参段894.类型 != 节点_类型) {
                    中断;   // 首个非〔类型/参数〕节点=体语句起点
                }
                扫参894++;
            }
            如果 (末参索引894 >= 整64(函894.子起点)) {
                节点 末参894 = 池.元素(整32(末参索引894));
                如果 (末参894.附加 > 0 &&
                     末参894.附加 < 整64(池.大小())) {
                    节点 类型节点894 = 池.元素(整32(末参894.附加));
                    整64 类型ID894 = 整64(类型节点894.文本);
                    如果 (是结果类型_ID(类型ID894)) { 返回 类型ID894; }
                }
            }
            返回 0;
        }
        扫894++;
    }
    返回 0;
}

函数 检查调用表达式(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    // 418（002 收口杂项正测族·def-init 数组输出参语义对齐宿主）：数组名实参=
    //   退化指针传递（宿主传址·被调方可写）——def-init 状态表整体置位（可能
    //   被写·保守）。原缺：分割("…", ",", 片段, 4) 输出参填充后 片段[0] 读取
    //   误报「未初始化，不能读取」（35_string_ext 行127/38_tool 行266 双编译
    //   对照实录·宿主同源同绿）。置于入口=覆盖用户/导入/内置/签名回退全被调面。
    如果 (n.附加 >= 1) {
        整64 实参i418 = 0;
        当 (实参i418 < 整64(n.附加)) {
            整64 末位418 = 查调用实参末位(整64(节点索引), 实参i418);
            如果 (末位418 >= 0 && 末位418 < 整64(池.大小())) {
                节点 实参末418 = 池.元素(整32(末位418));
                如果 (实参末418.类型 == 节点_标识符) {
                    整64 实参类型418 = 表查找类型ID(符号表, 整64(实参末418.文本));
                    如果 (实参类型418 > 0 &&
                         数组长度文本(驻留文本(实参类型418)) > 0) {
                        状态写置位(符号表, 整64(实参末418.文本));
                    }
                }
            }
            实参i418++;
        }
    }
    // 435：lambda 引用捕获逃逸——调用实参位检查（逐实参区间扫描·实参末位经
    //   语法层定位表——调用节点 子终点=0 空闲须查表（418 先例）；被调位排除=
    //   同帧调用合法面·706/707。宿主 checkCallArgs 同构，实现=语义检查逃逸.cn）
    检查调用实参lambda逃逸(池, n, 节点索引, 符号表, 诊断, 引用lambda变量们);  // 486：主表
    整64 调用起点 = 整64(n.子起点);
    如果 (调用起点 > 0) {
        节点 被调节点 = 池.元素(整32(调用起点));
        // 101（1023·plans/023 §八 A4 v2 挂点补齐·008 序②）：**外部函数调用**
        //   （FFI=C 边界·类型安全不保证·Rust extern 块同 unsafe-only）——被调
        //   名∈外部函数名集合（957 通道解析期登记）。文案与宿主逐字一致。
        如果 (被调节点.类型 == 节点_标识符 &&
              是外部函数名957(整64(被调节点.文本))) {
            错误不安全边界(诊断, "外部函数调用",
                         字符串复制(驻留文本(整64(被调节点.文本))));
        }
        // 890-a（002 攻族·537 D 段根治）：**方法调用实参位构造器语境校正**——
        //   实参=紧邻构造器调用（后缀池布局：实参根节点=调用节点索引-1）且被调
        //   方法**末形参**类型（实例化替换后）为 结果/可选 时，按末形参类型
        //   **覆盖**该构造器节点标注（n.子终点）。原缺口=实参位构造器继承外层
        //   语境（声明位/返回位=外层类型）：537 D 段 `表.追加(正常(31))` 中
        //   正常(31) 被标为 结果$空类型$整32（=追加 的**返回**类型）而非形参
        //   T=结果$整32$整32 → 装箱载荷偏移错（值写@+8 应@+4）→ 元素(0).值
        //   读错位。Rust 对照=实参期望类型下推（Expectation::ExpectHasType(形参)）。
        //   时机：外层调用节点（索引大）在实参构造器（索引小）**之后**被线性
        //   遍历 → 此处覆盖；IR 生成装箱构造 生成期读标注消费（节点标注幂等
        //   复用机制不受影响·887-a）。签名表/实例名设施=语义层既有先例（609
        //   判定 确保签名已加载/查签名返回 同源·IR签名/IR容器 公开函数）。
        如果 (被调节点.类型 == 节点_成员 && 被调节点.子起点 > 0 &&
             n.附加 >= 1 && 整64(节点索引) > 1) {
            节点 对象d890 = 池.元素(整32(被调节点.子起点));
            如果 (对象d890.类型 == 节点_标识符) {
                整64 对象类型d890 = 表查找类型ID(符号表, 整64(对象d890.文本));
                如果 (对象类型d890 > 0) {
                    字符串 对象类型名d890 = 字符串复制(驻留文本(对象类型d890));
                    字符串 基名d890 = 合成名基名(对象类型名d890);
                    // 基名 != 全名 = 实例合成名（$ 段存在）——仅容器实例面
                    如果 (字符串长度(基名d890) > 0 &&
                         !字符串比较(基名d890, 对象类型名d890)) {
                        确保签名已加载();
                        整64 键d890 = 驻留(基名d890 + "." +
                                      字符串复制(驻留文本(整64(被调节点.文本))) +
                                      "." + 整数转字符串(整64(n.附加)));
                        整64 参串d890 = 查签名参数串(键d890);
                        如果 (参串d890 >= 0) {
                            向量<字符串> 实参们d890 = 取实例实参们(对象类型名d890);
                            字符串 序串d890 = "";
                            整64 序IDd890 = 查类类型参数(驻留(基名d890));
                            如果 (序IDd890 >= 0) {
                                序串d890 = 字符串复制(驻留文本(序IDd890));
                            }
                            字符串 实例参串d890 = 替换类型参数带段们(
                                字符串复制(驻留文本(参串d890)), 序串d890, 实参们d890);
                            // 末形参提取（右起首个逗号后段——紧邻调用节点的
                            //   实参根=最后一个实参·替换后 $ 段形态无内嵌逗号）
                            整64 长e890 = 字符串长度(实例参串d890);
                            整64 逗位e890 = 0 - 1;
                            整64 扫e890 = 长e890 - 1;
                            当 (扫e890 >= 0) {
                                如果 ((整64(实例参串d890[整32(扫e890)]) & 255) == 44) {
                                    逗位e890 = 扫e890;
                                    中断;
                                }
                                扫e890--;
                            }
                            字符串 末形参d890 = 实例参串d890;
                            如果 (逗位e890 >= 0) {
                                末形参d890 = 字符串子串(实例参串d890,
                                    整32(逗位e890 + 1), 整32(长e890 - 逗位e890 - 1));
                            }
                            如果 (是结果类型(末形参d890)) {
                                节点 实参根d890 = 池.元素(节点索引 - 1);
                                如果 (实参根d890.类型 == 节点_调用 &&
                                     实参根d890.子起点 > 0) {
                                    节点 实参被调d890 = 池.元素(
                                        整32(实参根d890.子起点));
                                    如果 (实参被调d890.类型 == 节点_标识符) {
                                        字符串 实参名d890 = 字符串复制(
                                            驻留文本(整64(实参被调d890.文本)));
                                        如果 (字符串比较(实参名d890, "正常") ||
                                             字符串比较(实参名d890, "错误") ||
                                             字符串比较(实参名d890, "某些")) {
                                            实参根d890.子终点 = 整32(驻留(末形参d890));
                                            结果<空类型, 整32> 设标d890 =
                                                池.设置(节点索引 - 1, 实参根d890);
                                            如果 (!设标d890.正常) { 运行时错误(4); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        // 894-a（070·G-N 特性波3）：**普通函数**实参位构造器语境覆盖（408 u6
        //   `取值(正常(41))`——890 容器实例面的姊妹段·其诚实边界「实参位语境
        //   通用化」本波清偿）：被调=裸标识符函数名 → **全池扫描** 节点_函数
        //   （池=解析完成全树·无前向引用限制）取末形参类型文本，末实参根=
        //   调用节点-1（紧邻·池布局惯例）为 正常/错误/某些 构造调用时按末
        //   形参覆盖装箱标注（Rust Expectation::ExpectHasType(形参) 对照·
        //   载荷偏移随类型定·原继承外层语境=890 同族错位根因）。
        如果 (被调节点.类型 == 节点_标识符 && n.附加 >= 1 && 整64(节点索引) > 1) {
            整64 扫f894 = 0;
            当 (扫f894 < 整64(池.大小())) {
                节点 函f894 = 池.元素(整32(扫f894));
                如果 (函f894.类型 == 节点_函数 &&
                     整64(函f894.文本) == 整64(被调节点.文本) &&
                     函f894.子起点 < 函f894.子终点) {
                    // 末形参类型（参数区间=[子起点,子终点)·末参数.附加=类型节点索引）
                    节点 末参f894 = 池.元素(整32(函f894.子终点 - 1));
                    如果 (末参f894.类型 == 节点_参数 && 末参f894.附加 > 0 &&
                         末参f894.附加 < 整64(池.大小())) {
                        节点 末参类型节点f894 = 池.元素(整32(末参f894.附加));
                        字符串 末形参f894 = 字符串复制(
                            驻留文本(整64(末参类型节点f894.文本)));
                        如果 (是结果类型(末形参f894)) {
                            节点 实参根f894 = 池.元素(节点索引 - 1);
                            如果 (实参根f894.类型 == 节点_调用 &&
                                 实参根f894.子起点 > 0) {
                                节点 实参被调f894 = 池.元素(
                                    整32(实参根f894.子起点));
                                如果 (实参被调f894.类型 == 节点_标识符) {
                                    字符串 实参名f894 = 字符串复制(
                                        驻留文本(整64(实参被调f894.文本)));
                                    如果 (字符串比较(实参名f894, "正常") ||
                                         字符串比较(实参名f894, "错误") ||
                                         字符串比较(实参名f894, "某些")) {
                                        实参根f894.子终点 = 整32(驻留(末形参f894));
                                        结果<空类型, 整32> 设标f894 =
                                            池.设置(节点索引 - 1, 实参根f894);
                                        如果 (!设标f894.正常) { 运行时错误(4); }
                                    }
                                }
                            }
                        }
                    }
                    中断;   // 同名函数唯一（CN 无重载）——命中即止
                }
                扫f894++;
            }
        }
        // 413-b（审查 P1-2）：实参传参面「类→接口」转换检查（被调=裸标识符
        //   函数形态——成员方法面随逐参诚实边界后续统一收口）
        如果 (被调节点.类型 == 节点_标识符 && n.附加 >= 1) {
            检查接口形参实参转换(池, 节点索引, 符号表, 诊断);
        }
        // 575-a（T100·81 对齐 340-a 字段面/宿主 checkAccess）：方法调用面私有
        //   可见性——被调=成员（对象.方法）且对象类型=类 → 类节点扫 节点_方法：
        //   命中方法名且 (修饰/4)%2==1（私有位·解析层段可见性编码 574 系）→
        //   当前检查类豁免（本类方法体内 自身.方法 合法）→ 拒（340-a 措辞对齐；
        //   同模块类外私有调用同面顺带收口=340-a 方法面诚实边界清偿）。
        如果 (被调节点.类型 == 节点_成员 && 被调节点.子起点 > 0) {
            // 936（002·81 根治）：成员节点.子起点=对象表达式起点（池布局实证：
            //   子起点=计（标识符）·-1 位=类型节点 22）——原 -1 取位永指错节点=
            //   本检查自 575-a 立项以来从未生效（宽松放行）
            节点 调对象 = 池.元素(被调节点.子起点);
            如果 (调对象.类型 == 节点_标识符) {
                整64 dbg类型 = 表查找类型ID(符号表, 整64(调对象.文本));
                整64 dbg类节点 = 查类节点索引(dbg类型);
                整64 调对象类型 = 表查找类型ID(符号表, 整64(调对象.文本));
                如果 (调对象类型 <= 0) {
                    // 936（002·81 根治②）：导入类的类型不经符号表登记（声明位与
                    //   表达式位两套查询不同源）——回退类名直查（类表键=纯名）
                    调对象类型 = 整64(调对象.文本);
                }
                如果 (调对象类型 > 0) {
                    // 272（021 任务 272）：入容器位 无拷贝构造类 拒绝——stdlib 容器
                    //   元素整写要求独立拥有（宿主元素写=深拷·无拷贝构造类拒绝
                    //   「未定义拷贝构造，无法 复制」）·v2 原宽松放行→浅柄共享
                    //   →弹出/析构双释放（探针 s3b rc=134 实证·116/182 口径域）。
                    //   诊断文本与宿主逐字对齐（dual 负测锚）。守卫=基名∈{向量,
                    //   栈,链表,队列,集合}（映射值面宿主连声明都拒=另域·映射<类>
                    //   声明分叉挂 272 行注记）·方法∈入容器白名单·实参=标识符
                    //   形态（表达式/三元实参=推导不可靠面放行·217 诚实边界同款）。
                    字符串 基名272 = 合成名基名(字符串复制(驻留文本(调对象类型)));
                    布尔 容器守卫272 = 字符串比较(基名272, "向量") ||
                        字符串比较(基名272, "栈") || 字符串比较(基名272, "链表") ||
                        字符串比较(基名272, "队列") || 字符串比较(基名272, "集合");
                    如果 (容器守卫272 &&
                         是入容器方法(字符串复制(驻留文本(整64(被调节点.文本))))) {
                        整64 值位272 = 入容器值实参下标(
                            字符串复制(驻留文本(整64(被调节点.文本))));
                        整64 值位末272 = 查调用实参末位(整64(节点索引), 值位272);
                        如果 (值位末272 > 0 && 值位末272 < 整64(池.大小())) {
                            节点 值节点272 = 池.元素(整32(值位末272));
                            如果 (值节点272.类型 == 节点_标识符) {
                                整64 值类型272 = 表查找类型ID(符号表,
                                                    整64(值节点272.文本));
                                如果 (值类型272 > 0) {
                                    字符串 值类型文本272 = 字符串复制(
                                        驻留文本(值类型272));
                                    如果 (是用户类(值类型文本272) &&
                                         查类拷贝构造串(驻留(值类型文本272)) == 0) {
                                        表诊断(诊断, "[错误] 类型 '" +
                                            值类型文本272 + "' 未定义拷贝构造，无法 复制");
                                    }
                                }
                            }
                        }
                    }
                    // 648 归档：容器实例面（查类节点索引 miss=内置容器无池节点）
                    //   成员方法返回类型=IR 层内置表精确决议（语义层整64 簿记不被
                    //   终态消费·恢复路径非 miss）——专项=语义层容器方法类型表。
                    整64 调类节点 = 查类节点索引(调对象类型);
                    如果 (调类节点 >= 0 && 调类节点 < 整64(池.大小())) {
                        节点 调类值 = 池.元素(整32(调类节点));
                        整64 mm81 = 整64(调类值.子起点);
                        当 (mm81 < 整64(调类值.子终点)) {
                            节点 成员m81 = 池.元素(整32(mm81));
                            如果 (成员m81.类型 == 节点_方法 &&
                                 整64(成员m81.文本) == 整64(被调节点.文本) &&
                                 (成员m81.修饰 / 4) % 2 == 0) {
                                // 936（002·81 根治③）：段可见性编码=公开:1/私有:保护:0
                                //   （解析类.cn:312）——原判 ==1 查的是公开位（注释写
                                //   私有·位语义弄反·叠加取位 -1 偏移双错互抵=从未生效）
                                如果 (取当前检查类ID() != 调对象类型) {
                                    表诊断(诊断, "[错误] 无法访问 成员 '" +
                                                  驻留文本(整64(被调节点.文本)) + "'（" +
                                                  驻留文本(调对象类型) + " 的私有成员）");
                                }
                                // 602-a（T100·123 规则1 前置）：方法命中——返回
                                //   方法返回类型（节点_方法.附加=返回类型 ID），
                                //   替代整64 兜底（结果 返回值丢弃检查 Rules1 的
                                //   成员调用推导前置·592-b 参数固化 005 行）。
                                整64 方法返回602 = 整64(成员m81.附加);
                                如果 (方法返回602 == 0) { 方法返回602 = 驻留("空类型"); }
                                返回 方法返回602;
                            }
                            mm81++;
                        }
                        // 648 归档（豁免边界声明）：用户类方法扫描未命中=常态
                        //   回退通道（跨模块类指针字段成员链 L2 671 实证·对象类
                        //   型经语义指针表/字段剥星后才可达，方法返回在 IR 层
                        //   调用面精确决议）——首记 648 曾登记后回撤；原整64
                        //   兜底保留。110 同构显形面在 泛型显式实例 两态登记。
                    }
                }
            }
        }
        如果 (被调节点.类型 == 节点_标识符) {
            整64 被调名 = 整64(被调节点.文本);
            字符串 被调文本 = 字符串复制(驻留文本(被调名));
        // 71-a（2026-09-11 方案A 用户裁决）：内置构造器 正常()/错误()/某些()
        //   （规范 07-五，编译器预置）——合法仅当装箱语境为 结果/可选（返回位
        //   =函数返回类型、声明位=声明目标类型，语境由检查方设置）；推导类型
        //   写入调用节点.子终点（解析期恒 0=空闲位），IR 层构造器特判读取发射。
        //   实参区间由语句根区间线性遍历先序检查（返回语句/变量声明 循环先于
        //   本节点=线性顺序）；构造器名恒走本分支（预置符号表语义，重定义被
        //   遮蔽=第一版边界）。宿主 handleResultCtor 同构（返回类型上下文优先）。
        如果 (字符串比较(被调文本, "正常") || 字符串比较(被调文本, "错误") ||
             字符串比较(被调文本, "某些")) {
                返回 检查构造器调用(池, n, 节点索引, 符号表, 诊断, 被调文本);
            }
        // 155-a（A5 v2 挂点）：**裸释放**（释放(指针)——与宿主 A5「裸释放」同族）。
        //   判定=名「释放」+ 实参为指针变量（查语义指针变量≥0）；容器等拥有对象
        //   的同名释放语义由容器析构承担（宿主按实参形态区分 call 分派）——v2
        //   第一版按名+指针实参判定（未覆盖形态=诚实边界）。
        如果 (字符串比较(被调文本, "释放")) {
                检查裸释放调用(池, n, 诊断);
            }
        // 217（027 波2a·001 §5.8a）：新线程 实参位可搬运检查（§1.1a① 编译期
        //   硬错误·宿主 checkDirectCall 同构）。实参根定位=解析期登记表
        //   （查调用实参末位·借出检查 同款接口·-1/越界放行）；实参类型=标识符
        //   place 形态 表查找（推导不可靠面一律放行·本函数 1514 诚实边界同
        //   口径）；顶层 空类型*=内置豁免窗口（sunset=218）。诊断锚
        //   「不可跨线程搬运」与宿主逐字一致（608 dual 判据）。
        如果 ((字符串比较(被调文本, "新线程") || 字符串比较(被调文本, "线程::新线程") ||
              字符串比较(被调文本, "线程::新") || 字符串比较(被调文本, "线程.新")) &&
             整64(n.附加) >= 2) {
            整64 实参2位217 = 查调用实参末位(整64(节点索引), 1);
            如果 (实参2位217 >= 0 && 实参2位217 < 整64(池.大小())) {
                节点 实参2节点 = 池.元素(整32(实参2位217));
                如果 (实参2节点.类型 == 节点_标识符) {
                    整64 实参类型217 = 表查找类型ID(符号表, 整64(实参2节点.文本));
                    如果 (实参类型217 > 0) {
                        字符串 类型文本217 = 字符串复制(驻留文本(实参类型217));
                        // 217：指针变量补星（符号类型ID=基名·指针层语义在
                        //   语义指针变量表——星号形态在此重建·顶层指针实参面）
                        如果 (查语义指针变量(整64(实参2节点.文本)) != -1) {
                            类型文本217 = 类型文本217 + "*";
                        }
                        // 218 sunset 收窄：顶层 空类型* 豁免仅限 不安全 函数体内
                        //   （001 §5.8b·§1.1a④·安全区传裸指针值=同拦）
                        布尔 窗口豁免217 = 字符串比较(类型文本217, "空类型*") &&
                                          读当前函数不安全();
                        如果 (!窗口豁免217 &&
                             !字符串比较(类型文本217, "空类型") &&
                             !字符串比较(类型文本217, "未知")) {
                            字符串 链217 = "";
                            如果 (!可搬运判定(驻留(类型文本217), 0, 链217)) {
                                表诊断(诊断, "[错误] 类型 '" + 类型文本217 +
                                    "' 含裸指针字段 '" + 链217 +
                                    "'，不可跨线程搬运（001 §5.8a；如确需跨线程请声明 不安全 可搬运）");
                            }
                        }
                    }
                }
            }
        }
        // plans/019 阶段1（2026-09-10）：显式转移 转移(变量) 特判——实参须为
        //   变量标识符；分级：标量拒绝（复制语义）/指针与字符串放行（值交接，
        //   标记已转移+返回实参类型）/拥有资源类型（容器/类/结果等）v2 第一版
        //   暂不支持（宿主声明初始化位已锚定，v2 容器位随阶段3 浅拷贝对齐）。
        //   实参首查先于调用节点（线性顺序）=首次转移不误报，此处标记后
        //   区间后段任何使用经 检查标识符表达式 拒绝。
        如果 (字符串比较(被调文本, "转移")) {
                返回 检查转移调用(池, n, 调用起点, 符号表, 诊断);
            }
        // 206-c（波 4·plans/020 第七十二节）：复制(表达式) 泛型克隆内置——
        //   与 转移(x) 构成显式「复制/移动」双内置（C++ copy/move 对照物，
        //   Rust Clone::clone 同构）。返回类型=实参类型（泛型内置无法固定
        //   签名注册 → 调用处特判）；类型 ID 写入调用节点.子终点 供 IR 层
        //   生成复制展开 按类型分派发射。
        如果 (字符串比较(被调文本, "复制")) {
                返回 检查复制调用(池, n, 节点索引, 调用起点, 符号表, 诊断);
            }
        // P7b：容器类构造调用（向量<整64>() 语法层已合成 向量$整64 被调标识符）
        //   合法——返回类型暂按 整64（对象指针）兜底
        如果 (是容器类(被调文本)) {
            返回 驻留("整64");
        }
        // 灰色点④根治（2026-09-04 用户裁决立案·缺陷零容忍）：强转类型名
        //   白名单补 整8/整16（宿主窄宽强转已支持——整8(300)=44；原白名单
        //   九名缺失时落「未声明函数: 整8」）。
        //   2026-09-04 缺陷零容忍收口：正8/正16 补入（原「显式拒绝」系
        //   无符号语义缺位搁置——违反尽善尽美；现 IR 层 T_正8/T_正16
        //   零扩展标注+双后端 movzx/uxtb 落地，正8(200)=200 语义正确）
        如果 (字符串比较(被调文本, "整32") || 字符串比较(被调文本, "整64") ||
             字符串比较(被调文本, "浮32") || 字符串比较(被调文本, "浮64") ||
             字符串比较(被调文本, "布尔") || 字符串比较(被调文本, "字符") ||
             字符串比较(被调文本, "字符串") || 字符串比较(被调文本, "正32") ||
             字符串比较(被调文本, "正64") || 字符串比较(被调文本, "整8") ||
             字符串比较(被调文本, "整16") || 字符串比较(被调文本, "正8") ||
             字符串比较(被调文本, "正16") ||
             // 967（002·053 复工）：128 位强转（整128(1)/正128(999)——409/419
             //   转换构造族；IR 层 810 双半通道既有）
             字符串比较(被调文本, "整128") || 字符串比较(被调文本, "正128") ||
             // 418（002 收口杂项正测族）：指针(整数) 强转（spec 04-一C 指针↔整数
             //   同权·类型码层 指针=T_整64 单槽直通）——原缺席报「未声明函数: 指针」
             //   （16_function_extra 行58 实录）
             字符串比较(被调文本, "指针")) {
            // 329-a（D38 批2·343）：显式转换实参类型检查（单实参形态）——
            //   布尔目标仅收布尔源/字符串与结构体源拒/数值互转含窄化放行
            如果 (n.附加 == 1) {
                检查显式转换实参(池, n, 节点索引, 被调文本, 符号表, 诊断);
            }
            返回 被调名;
        }
        // 函数调用：查符号表（符号_函数 附加=返回类型ID）
        // plans/018 第 3 层：表查找类型ID 内部已三级化（①②③）——命中
        //   用户函数时把决议键基写入 调用决议键基们（语义驱动 IR：第 4 层
        //   决议函数符号 据此锁定候选模块桶，宿主 resolvedSignature 同构）
        // T69（480-a 深度机）：函数指针间接调用——被调标识符声明类型是函数指针
        //   时优先于「函数调用」分支（宿主 semantic_call.cpp:185-204 先直接函数名、
        //   失败后 checkExpr(callee)→checkFuncPtrCall 同序）；否则指针变量会被
        //   当普通函数登记决议键基（错决议）。结果类型=签名返回类型。
        // 193（2026-10-13 任务193）：抽象类/接口构造调用 形状()/可叫() 语义层
        //   拒绝——与变量裸声明检查同族（宿主 checkCtorCall 193 同构·specs/06
        //   §八·C++ cannot instantiate abstract class 同款）。原缺陷=接口名
        //   静默落后续链放行、抽象类落 951 分支按无构造类默认构造放行（IR 层
        //   无体跳过=空洞对象）。诊断后返回 被调名（继续链·单诊断口径）。
        如果 (是接口名ID(驻留(被调文本))) {
            表诊断(诊断, "[错误] 不能实例化接口 '" + 字符串复制(被调文本) +
                          "'（接口无实现体）——请以实现类实例初始化接口变量");
            返回 被调名;
        }
        如果 (是抽象类ID(驻留(被调文本))) {
            表诊断(诊断, "[错误] 不能实例化抽象类 '" + 字符串复制(被调文本) +
                          "'（含未实现抽象方法）——请实例化具体派生类");
            返回 被调名;
        }
        // 951（002·B 类推断面·485/104 族）：用户类构造调用（计数器()）——
        //   类名不注册符号表（类表独立）→函数查找/签名回退/内置链全 miss→
        //   推断声明「初值类型未知」误拒；对齐容器类分支（返回整64 指针兜底）
        //   之前的真实类型：构造调用返回类名自身（对象指针语义·布局层按类名
        //   分派 NewObject）
        如果 (是用户类(被调文本)) {
            登记调用决议(符号表, 被调名, 整64(节点索引));
            返回 被调名;
        }
        // 415（wt415·658 面）：泛型实参隐式推导（宿主 303 场景②同构）——被调=
        //   裸名命中泛型函数参数序表→实参可靠面逐位推导→被调文本改写为实例
        //   合成名（名$实参）→复用显式 <> 全链（IR 收集/克隆/签名/决议）。
        //   返回=实例返回类型（T 替换后）；0=未改写（不可靠面/冲突→原链现状）。
        //   先于函数指针/签名表分支——泛型基函数本体不生成（IR 生成分派跳过），
        //   裸名+参数序表命中时改写为实例调用=唯一正确通路（无抢占问题）。
        如果 (被调节点.类型 == 节点_标识符) {
            整64 推导返回415 = 推导改写泛型隐式调用(池, 节点索引, 符号表);
            如果 (推导返回415 > 0) { 返回 推导返回415; }
        }
        整64 间接类型480 = 表查找类型ID(符号表, 被调名);
        // 432（#276 波3）：**函数符号优先于函数指针变量调用**——函数返回类型
        //   为函数指针类型文本时（`函数 造加倍() -> 整32(*)(整32)`），符号表
        //   该名的类型ID=返回类型串，原判定误入 480 分支把零实参函数调用按
        //   fnptr 签名查参（731 实弹：「需 1 个实参，实给 0 个」误拒·与宿主
        //   semantic_call.cpp 先直接函数名后 fnptr 同序对齐）。种类=函数 →
        //   落下方函数调用分支（种类查询与类型查询同走查序·遮蔽一致）。
        如果 (间接类型480 != -1 &&
             表查找种类(符号表, 被调名) != 符号_函数 &&
             是函数指针类型文本(字符串复制(驻留文本(间接类型480)))) {
            返回 检查函数指针调用480(池, n, 节点索引, 诊断, 被调文本,
                                    字符串复制(驻留文本(间接类型480)));
        }
        整64 找到类型 = 表查找类型ID(符号表, 被调名);
        如果 (找到类型 != -1) {
            登记调用决议(符号表, 被调名, 整64(节点索引));
            // plans/019 阶段3b：调用借用纪律（主路径——键基近似=被调名）
            检查调用借用纪律(池, 节点索引, 被调名, 符号表, 诊断);
            // 549：实参→形参转换检查（单候选普通函数·宿主 checkDirectCall 判定同构）
            检查调用实参转换(池, 节点索引, 符号表, 诊断);
            返回 找到类型;
        }
            // 呈报③方案A（2026-09-06）：签名键改造后纯名查不到——按签名表同名候选回退
            //   （精确决议在 IR 层）；plans/018 第 3 层：回退键基化（三级决议）。
            //   203-a：段提取为 检查签名键回退（-1=未决议哨兵，主函数继续内置/限定/未声明链）。
            整64 回退类型 = 检查签名键回退(池, n, 节点索引, 符号表, 诊断, 被调名);
            如果 (回退类型 != -1) {
                // 549：实参→形参转换检查（签名回退面·同上）
                检查调用实参转换(池, 节点索引, 符号表, 诊断);
                返回 回退类型;
            }
        // ③ 第一波（2026-09-03）：内置函数调用（驻留/字符串族/运行时错误——
        //   IR 层映射 ASCII 运行时符号直调）；类型大小(类型) 编译期折叠 -> 整64
        // 474（运行期整数溢出·回绕逃生门）：回绕加/回绕减/回绕乘 三件套——
        //   两补码回绕语义（错误码 8 溢出检查的显式豁免口·宿主同构）。类型规则
        //   与算术运算符一致（窄域保持窄域·结果=第一实参域）。IR 层经
        //   生成回绕展开 发射（附加<0 回绕协议·不走运行时符号直调）。
        如果 (字符串比较(被调文本, "回绕加") || 字符串比较(被调文本, "回绕减") ||
             字符串比较(被调文本, "回绕乘")) {
            如果 (n.附加 != 2) {
                表诊断(诊断, "[错误] 回绕加/回绕减/回绕乘 恰需 2 个整型实参");
            }
            返回 回绕调用返回类型474(池, 节点索引, 符号表);
        }
        整64 内置返回 = 内置函数返回类型ID(被调文本);
        如果 (内置返回 != 0) {
            检查变参打印实参(池, n, 节点索引, 符号表, 诊断);   // 443/539：变参内置（打印/打印行/格式化）实参类型检查（宿主 checkVariadicBuiltinCall 同构·非变参内部早退）
            返回 内置返回;
        }
        如果 (字符串比较(被调文本, "类型大小")) {
            // 376（v17 六族对齐批·001 02§六B 参数清单）：类型大小 参数清单=
            //   基础类型/结构体/数组/指针/限定类型/泛型实参——结果/可选 未列，
            //   友好拒绝（宿主 visitSizeofExpr 同款文案；宿主修前=内部错误
            //   形态违反诊断纪律·v2 修前=合成体尺寸放行超立法面——c359 实证）。
            //   类型名实参与下标形实参（元素为盒）两形态同拦。
            如果 (n.附加 == 1 && 调用起点 > 0 && 节点索引 >= 2) {
                节点 段末x376 = 池.元素(节点索引 - 1);
                整64 盒名x376 = 0;
                如果 (段末x376.类型 == 节点_标识符) {
                    如果 (是结果类型(字符串复制(驻留文本(整64(段末x376.文本))))) {
                        盒名x376 = 整64(段末x376.文本);
                    }
                } 否则 如果 (段末x376.类型 == 节点_下标 && 段末x376.子起点 > 0) {
                    节点 基名x376 = 池.元素(整32(段末x376.子起点));
                    如果 (基名x376.类型 == 节点_标识符 &&
                         是结果类型(字符串复制(驻留文本(整64(基名x376.文本))))) {
                        盒名x376 = 整64(基名x376.文本);
                    }
                }
                如果 (盒名x376 > 0) {
                    表诊断(诊断, "[错误] 类型大小: 参数类型不支持 '" +
                                字符串复制(驻留文本(盒名x376)) +
                                "'（02 §六B 参数清单=基础类型/结构体/数组/指针/限定类型/泛型实参）");
                    返回 驻留("整64");
                }
            }
            // 967（002·57 转批）：**语义层整体折叠**——类型大小(类型) 单实参
            //   调用节点改写为整数字面量（文本=宽度），实参段（含被调标识符）
            //   各节点改 节点_参数 占位（生成层主循环不处理=跳过·零残留压栈）。
            //   宽度支持：基本/容器/结果/结构体（类型名宽度 单点·含数组文本
            //   「整64[5]」=元素宽×长度分支）；下标形实参（类型大小(整64[5])）
            //   段末=下标根→基名×长度解析。宽度 0（未知/指针形）→不改写落
            //   IR 层原路径（折叠诊断/原语义）。
            如果 (n.附加 == 1 && 调用起点 > 0 && 节点索引 >= 2) {
                节点 段末967 = 池.元素(节点索引 - 1);
                整64 宽度967 = 0;
                如果 (段末967.类型 == 节点_标识符) {
                    宽度967 = 类型名宽度(整64(段末967.文本));
                } 否则 如果 (段末967.类型 == 节点_下标 && 段末967.子起点 > 0) {
                    节点 基名967 = 池.元素(整32(段末967.子起点));
                    节点 长度967 = 池.元素(整32(段末967.子终点 - 1));
                    如果 (基名967.类型 == 节点_标识符 &&
                         长度967.类型 == 节点_整数字面量 &&
                         段末967.子终点 - 段末967.子起点 == 2) {
                        整64 元素宽967 = 类型名宽度(整64(基名967.文本));
                        整64 长度值967 = 0;
                        字符串 长度文本967 = 字符串复制(驻留文本(整64(长度967.文本)));
                        整64 li967 = 0;
                        布尔 合法967 = 字符串长度(长度文本967) > 0;
                        当 (li967 < 字符串长度(长度文本967)) {
                            整64 字节967 = 整64(长度文本967[整32(li967)]) & 255;
                            如果 (字节967 < 48 || 字节967 > 57) { 合法967 = 假; 中断; }
                            // 474：>18 位有效数字=必超域宽（防中间值溢出·自举安全）
                            如果 (li967 > 18) { 合法967 = 假; 中断; }
                            长度值967 = 长度值967 * 10 + (字节967 - 48);
                            li967++;
                        }
                        如果 (元素宽967 > 0 && 合法967 && 长度值967 > 0) {
                            宽度967 = 元素宽967 * 长度值967;
                        }
                    }
                }
                如果 (宽度967 > 0) {
                    整64 占i967 = 调用起点;
                    当 (占i967 < 节点索引) {
                        节点 占位967 = 池.元素(整32(占i967));
                        占位967.类型 = 节点_参数;
                        占位967.子起点 = 0;
                        占位967.子终点 = 0;
                        占位967.附加 = 0;
                        结果<空类型, 整32> 设占967 = 池.设置(整32(占i967), 占位967);
                        如果 (!设占967.正常) { 运行时错误(4); }
                        占i967++;
                    }
                    节点 折叠节点967 = 池.元素(节点索引);
                    折叠节点967.类型 = 节点_整数字面量;
                    折叠节点967.文本 = 整32(驻留(整数转字符串(宽度967)));
                    折叠节点967.子起点 = 0;
                    折叠节点967.子终点 = 0;
                    折叠节点967.附加 = 0;
                    结果<空类型, 整32> 设折967 = 池.设置(节点索引, 折叠节点967);
                    如果 (!设折967.正常) { 运行时错误(4); }
                }
            }
            返回 驻留("整64");
        }
    整64 限调类型 = 检查限定调用(池, 节点索引, 符号表, 诊断);
    如果 (限调类型 != -2) {
        返回 限调类型;
    }
        // 419-a（D42 波 3）：泛型函数显式实例化调用（名<实参>(...)——合成名
        //   名$实参·基名命中 泛型基类参数序（函数共用表）→放行（单态化生成
        //   供给定义）
        // 419-a 修正（越界归因）：放行必须返回**真实类型 ID**（-1 哨兵会被上层
        //   当类型索引进向量=数组越界）
        // 415（wt415）：返回类型=T 替换后的实例返回类型（原 MVP=整32——整64/
        //   浮64 返回实例语义标注错·421 只读大小<整32>->整64 打印面实录）。基
        //   函数定位（全池扫 节点_函数·894-a 同款）miss 时保守 整32（原型缺失
        //   面·不回退）；返回位指针层已并文本·克隆体登记段同源。
        如果 (字符串长度(剥实例基名(被调文本)) > 0 &&
             !字符串比较(剥实例基名(被调文本), 被调文本) &&
             查泛型基类参数序(驻留(剥实例基名(被调文本))) != 0) {
            整64 显式返回415 = 驻留("整32");
            布尔 命中基函648 = 假;
            {
                整64 扫e415 = 0;
                当 (扫e415 < 整64(池.大小())) {
                    节点 函e415 = 池.元素(整32(扫e415));
                    如果 (函e415.类型 == 节点_函数 &&
                         整64(函e415.文本) == 驻留(剥实例基名(被调文本)) &&
                         函e415.子起点 < 函e415.子终点) {
                        命中基函648 = 真;
                        如果 (整64(函e415.附加) > 0) {
                            // T→实例实参替换（参数序表拆段×剥实例参数段）
                            向量<整64> 参数名e415 = 向量<整64>();
                            泛型参数序拆段(查泛型基类参数序(驻留(剥实例基名(被调文本))), 参数名e415);
                            向量<整64> 实参e415 = 向量<整64>();
                            剥实例参数段(被调文本, 实参e415);
                            如果 (参数名e415.大小() == 实参e415.大小() &&
                                 参数名e415.大小() > 0) {
                                字符串 替换返回415 = 替换实例类型文本(
                                    字符串复制(驻留文本(整64(函e415.附加))),
                                    参数名e415, 实参e415);
                                显式返回415 = 驻留(替换返回415);
                            }
                        } 否则 {
                            // 648：miss 不可静默——基函数定位命中但无返回类型标注
                            //   （附加<=0·与 110 案同构）；显形经 IR 包收集表
                            //   （登记处出诊断行·主收尾统一中止），原整32 兜底
                            //   保留（中止前路径）
                            登记内部未登记("泛型显式实例基函数无返回标注", 被调文本,
                                           整64(取当前诊断行()));
                        }
                        中断;
                    }
                    扫e415++;
                }
            }
            如果 (!命中基函648) {
                // 648：miss 不可静默——泛型显式实例基函数定位 miss（110 案完全
                //   同构·全池扫无 节点_函数 文本匹配=原型缺失面）；显形经 IR 包
                //   收集表（登记处出诊断行·主收尾统一中止），原整32 兜底保留
                //   （中止前路径）
                登记内部未登记("泛型显式实例基函数定位 miss", 被调文本,
                               整64(取当前诊断行()));
            }
            返回 显式返回415;
        }
        // -2 = 使用点歧义（E0659 已在三级决议内经缓冲诊断）——不重复报
        如果 (三级键基查找(符号表, 被调名, 0 - 1) != -2) {
            表诊断(诊断, "[错误] 未声明函数: " + 被调文本);
        }
        返回 -1;
    }
    }
    // 648 归档（豁免边界声明）：调用表达式终态兜底=常态回退通道（方法调用/
    //   容器面在成员路径与 IR 层调用面精确决议后仍流经此终态·L2 123/125/126/
    //   127/129/147/156/203/216/441/442 十一用例实证）——首记 648 曾登记后
    //   回撤；110 同构显形面在 泛型显式实例 两态登记（命中基函648）。
    返回 驻留("整64");
}


// ==================== T69（480-a 深度机）函数指针调用检查 ====================
// 宿主 semantic_call.cpp:353-382 checkFuncPtrCall 同构：实参个数须与签名参数表
//   严格相等（宿主 359-366 个数不符即诊断）+ 结果类型=签名返回类型（宿主 378）。
//   逐参类型转换检查（宿主 canConvertWithLiteral 368-377）：v2 侧实参类型推导面
//   （表达式类型ID）覆盖面有限——本轮以「个数严格 + 返回类型正确」为编译期防线，
//   逐参类型精确转换=诚实边界（与 v2 语义推导完善同步收口）；ABI 正确性由三后端
//   参数位装载 + 双编译对照用例（09_integration/318/99/40）运行级锚定。
