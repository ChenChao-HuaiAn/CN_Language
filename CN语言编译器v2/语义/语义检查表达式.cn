// CN 自举编译器 v2 · 语义检查表达式（R3 千行拆分，2026-09-08）
// 职责：检查表达式 的三大分支族——标识符（含限定名解析）/下标/调用
//   （含限定调用）——自 语义检查.cn 机械搬移（零逻辑变化），检查表达式
//   主干（字面量/成员/取地址解引用/二元/三元）留原文件并分派至此。
// 模块路径=语义检查表达式（新键基）；仅被 语义检查 消费。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（目录包名）
导入 IR;         // 容器/结果 合成名判定（目录包名）

公开:   // 全文件公开（检查族供 语义检查 分派消费）

// 标识符表达式检查（自 检查表达式 标识符分支机械搬移）：符号表直查 →
//   容器/结果合成名 → 类型名白名单 → 内置函数名 → 用户模块限定名 →
//   签名表同名候选回退 → 未声明诊断。
函数 检查标识符表达式(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
整64 找到类型 = 表查找类型ID(符号表, 整64(n.文本));
如果 (找到类型 != -1) {
    // plans/019 阶段1（2026-09-10）：已转移变量使用拒绝（E0382 对标）——读值
    //   根拦截点（表达式/实参/返回/操作数经此；转移调用实参的首次检查先于
    //   调用节点标记=线性顺序天然不误报）
    如果 (表查已转移(符号表, 整64(n.文本)) > 0) {
        表诊断(诊断, "[错误] 变量已转移，不能继续使用（显式转移后源变量禁用）: " +
                      驻留文本(整64(n.文本)));
    }
    返回 找到类型;
}
// P7b（2026-09-01）：容器/结果 合成名（向量$整64/结果$空类型$整32）合法——
//   构造调用 向量<整64>() 的被调标识符（语法层已合成 $ 实例名）。
如果 (是容器类(驻留文本(整64(n.文本))) || 是结果类型(驻留文本(整64(n.文本)))) {
    返回 整64(n.文本);
}
// P6g（2026-08-30）：类型名（整32/整64/浮64/布尔/字符串）作标识符合法——
//   类型转换 整32(x) 的被调标识符；不作为函数/变量时报未声明。
字符串 名文本 = 字符串复制(驻留文本(整64(n.文本)));
如果 (字符串比较(名文本, "整32") || 字符串比较(名文本, "整64") ||
     字符串比较(名文本, "浮32") || 字符串比较(名文本, "浮64") ||
     字符串比较(名文本, "布尔") || 字符串比较(名文本, "字符") ||
     字符串比较(名文本, "字符串") || 字符串比较(名文本, "正32") ||
     字符串比较(名文本, "正64") || 字符串比较(名文本, "整8") ||
     字符串比较(名文本, "整16") || 字符串比较(名文本, "正8") ||
     字符串比较(名文本, "正16")) {
    返回 整64(n.文本);
}
// ③ 第一波（2026-09-03）：内置函数名作标识符合法（调用的被调标识符子节点
//   先经此处检查）；类型大小 编译期折叠（返回 整64）。
如果 (内置函数返回类型ID(名文本) != 0) { 返回 内置函数返回类型ID(名文本); }
如果 (字符串比较(名文本, "类型大小")) { 返回 驻留("整64"); }
// plans/019 阶段1：显式转移 转移(变量) 的被调标识符合法（调用节点特判检查；
//   此处仅放行名字——返回类型占位不被消费）
如果 (字符串比较(名文本, "转移")) { 返回 驻留("整64"); }
// 206-c（波 4·plans/020 第七十二节）：复制(表达式) 泛型克隆内置的被调标识符
//   合法（调用节点特判检查；此处仅放行名字——返回类型占位不被消费，转移 同款）
如果 (字符串比较(名文本, "复制")) { 返回 驻留("整64"); }
// 71-a（2026-09-11 方案A 用户裁决）：内置构造器 正常/错误/某些 的被调标识符
//   合法（调用节点构造器分支特判检查+装箱语境推导；此处仅放行名字——
//   返回类型占位不被消费，转移 同款）。
//   475-a 实测定案：本路径同时服务 callee 位与裸名位（无语境可分·24 族
//   callee 位回归实证）——**59 行维持放行不动**；裸名拒绝=语句级单点
//   （474-a 返回语句位+本 475-a 声明初始化/赋值位·语义检查.cn）。
如果 (字符串比较(名文本, "正常") || 字符串比较(名文本, "错误") ||
     字符串比较(名文本, "某些")) { 返回 驻留("整64"); }
    整64 限标识类型 = 检查限定标识符(池, 节点索引, 符号表, 诊断);
    如果 (限标识类型 != -2) {
        返回 限标识类型;
    }
// 呈报③方案A（2026-09-06）：函数登记键=签名键（名#参数串）——纯名查不到
//   合法函数，按签名表同名候选回退（返回类型取首个候选；精确决议在 IR 层）
//   plans/018 第 3 层：回退键基化（非主模块函数键=模块$名——三级决议）；
//   签名键直查全局层（复合键不经三级）
整64 标识键基 = 三级键基查找(符号表, 整64(n.文本), 0 - 1);
如果 (标识键基 >= 0) {
    整64 查标识签数 = 查函数签名个数(标识键基);
    如果 (查标识签数 >= 0) {
        如果 (查标识签数 > 0) {
            整64 查标识签串 = 查函数签名参数串(标识键基 * 键位移);
            如果 (查标识签串 >= 0) {
                整64 标识签键 = 函数签名键(标识键基, 驻留文本(查标识签串));
                整64 标识签类型 = 全局层查类型(符号表, 标识签键);
                如果 (标识签类型 != -1) { 返回 标识签类型; }
            }
        }
    }
}
// -2 = 使用点歧义（E0659 已在三级决议内经缓冲诊断）——不再重复报未声明
如果 (标识键基 != -2) {
    // 418-a（D40 细分）：枚举名裸标识符（成员链基名 颜色.绿/类型位 颜色 c）——
    //   枚举表命中=合法·值域=整32（C 风格枚举）
    如果 (是枚举名(整64(n.文本))) { 返回 整64(驻留("整32")); }
    // 464-a（T70 面⑥）：stdlib 模块名根（源码级加载的 stdlib 内部实现调内置
    //   成员，如 IO.cn 行 44 `IO.打印到错误(消息)`——根=内置模块名 IO）——
    //   模块名根放行（类型占位 -1 不被消费；成员决议=IR 内置表·生产态
    //   stdlib 源码不编译=零触发·对齐「内置走限定名直调」设计注释）。
    如果 (是标准库模块名(名文本)) { 返回 -1; }
    // 419-a（D42 波 3）：泛型函数实例合成名（名$实参）——基名命中参数序表放行
    如果 (字符串长度(剥实例基名(名文本)) > 0 &&
         !字符串比较(剥实例基名(名文本), 名文本) &&
         查泛型基类参数序(驻留(剥实例基名(名文本))) != 0) {
        返回 -1;
    }
    表诊断(诊断, "[错误] 未声明标识符: " + 名文本);
}
返回 -1;
}

// plans/018 第 3 层：限定合成名（工具库::版本）——语句根区间线性检查会
//   把调用被调标识符当裸标识符送达本分支（检查块 语句根派发惯例：每节点
//   恰在其作用域访问一次）。stdlib 限定已由上方内置表命中；此处解析用户
//   模块限定（成员索引+公开强制）——限定调用恒明确不参与遮蔽，规格 5.9.7
// 返回：-2=非限定形态（调用方继续走签名表回退）；否则=类型ID（含 -1 已诊断）。
函数 检查限定标识符(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    字符串 名文本 = 字符串复制(驻留文本(整64(n.文本)));
字符串 标限模块s = "";
字符串 标限符号s = "";
如果 (拆限定名(名文本, 标限模块s, 标限符号s) == 1 &&
     !是标准库模块名(标限模块s)) {
    整64 标源ID = 驻留(标限模块s);
    整64 标符ID = 驻留(标限符号s);
    整64 标键基 = 0;
    整64 查标限 = 查模块成员键基(标源ID, 标符ID);
    如果 (查标限 >= 0) {
        标键基 = 查标限;
    } 否则 {
        表诊断(诊断, "[错误] 未声明的标识符: " + 名文本 +
                      "（模块 " + 标限模块s + " 无符号 " + 标限符号s + "）");
        返回 -1;
    }
    布尔 标自模块 = 字符串比较(标限模块s, 驻留文本(当前模块路径ID));
    如果 (!标自模块) {
        整64 查标公 = 查模块成员公开(标源ID, 标符ID);
        如果 (查标公 < 0) {
            表诊断(诊断, "[错误] 符号 '" + 标限符号s + "' 为模块 '" + 标限模块s +
                          "' 私有（未以 公开: 标注），不可限定调用（规格08 5.9.3）");
            返回 -1;
        }
    }
    // 返回类型：签名表首个候选（重载精确决议在 IR 层）或符号表键基条目
    //   （候选数提取——结果 流敏感检查惯例）
    整64 标类型 = -1;
    整64 标候选数 = 0;
    整64 查标数 = 查函数签名个数(标键基);
    如果 (查标数 >= 0) {
        标候选数 = 查标数;
    }
    如果 (标候选数 > 0) {
        整64 查标串 = 查函数签名参数串(标键基 * 键位移);
        如果 (查标串 >= 0) {
            标类型 = 全局层查类型(符号表, 函数签名键(标键基, 驻留文本(查标串)));
        }
    }
    如果 (标类型 == -1) {
        标类型 = 全局层查类型(符号表, 标键基);
    }
    返回 标类型;
}
    返回 -2;
}

// 下标表达式检查（③ 第二/三波：字符串[i] 逐字节 / 指针对象 p[i] 按元素宽度）——
//   对象白名单外的形态显式拒绝（半实现纪律：错误放行=静默垃圾地址）。
函数 检查下标表达式(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
// ③ 第二波（2026-09-03）：字符串[i] 逐字节访问（宿主 A-1 对齐：步进 1、
//   结果类型 字符）。对象白名单=字符串标识符（局部/参数）/字符串成员字段；
// ③ 第三波：指针对象 p[i]（宿主 ir_expr.cpp:1555 对齐——p[i] ≡ *(p+i)
//   步进按所指元素大小，元素类型=所指类型）。其余对象形态（字面量/调用/
//   解引用/容器/结构体/指针字段…）显式拒绝——半实现纪律：未覆盖形态
//   错误放行=静默错误代码（IR 层按指针值+步进生成，非白名单对象必产
//   垃圾地址）。
如果 (n.子起点 > 0) {
    节点 对象节点x = 池.元素(整32(n.子起点));
    // 188-a（D6·plans/023 B11 变量常量传播）：`无[i]` 字面量形态（对象=无 标记）
    //   ——编译期常量空指针下标访问 硬错误（原实现只报「下标对象形态未支持」间接错误）
    如果 (对象节点x.类型 == 节点_整数字面量 && 对象节点x.附加 == 1) {
        表诊断(诊断, "[错误] 编译期常量空指针下标访问（确定性错误；plans/023 B11）");
        返回 -1;
    }
    如果 (对象节点x.类型 == 节点_标识符) {
        // 指针对象先行（指针变量表命中即返回所指类型；与符号表字符串
        //   判定无交集——指针登记以类型节点指针层数为准，互不误伤）。
        //   所指类型白名单（IR 加载宽度覆盖面）外的显式拒绝。
        整64 查指针x = 查语义指针变量(整64(对象节点x.文本));
        如果 (查指针x >= 0) {
            // 188-a（D6 B11 变量常量传播）：恒空候选使用点登记（面=下标访问）
            登记恒空使用点(整64(对象节点x.文本), 整64(取当前诊断行()), 3);
            // 94-a（2026-09-13 第九十四轮）：数组对象（登记=元素类型）——元素类型
            //   不受指针下标白名单限制（宿主数组元素任意类型：浮点/结构体/字符串
            //   均可；元素地址=基址+i×元素步进，加载宽度=元素宽度码）。判定=
            //   声明类型文本是数组（元素类型登记与指针登记同表，据声明文本区分）。
            布尔 数组对象x94 = 假;
            整64 对象声明类型x = 表查找类型ID(符号表, 整64(对象节点x.文本));
            如果 (对象声明类型x >= 0) {
                如果 (是数组类型文本(字符串复制(驻留文本(对象声明类型x)))) {
                    数组对象x94 = 真;
                }
            }
            如果 (数组对象x94) { 返回 查指针x; }
            // 154-a（B8 v2 挂点）：**裸指针下标**（p[i]——读/写单报；数组对象
            //   已豁免——与宿主 B8「指针下标读」同族，宿主在写场景抑制读判）
            错误不安全边界(诊断, "指针下标", "指针下标（p[i]）");
            字符串 所指文本x = 字符串复制(驻留文本(查指针x));
            // 470-a：T 元素类型静态不可判定（泛型基类体重放语境·波2 单态化
            //   收口）——所指=类型参数名时豁免（对齐宿主重放诊断回滚效果）
            如果 (!指针下标所指合法(所指文本x) && !取重放豁免安全区()) {
                表诊断(诊断, "[错误] 指针下标所指类型未支持（须标量/字符串）: " + 所指文本x);
                返回 -1;
            }
            返回 查指针x;
        }
        整64 对象类型x = 表查找类型ID(符号表, 整64(对象节点x.文本));
        如果 (对象类型x == 驻留("字符串")) {
            // 188-a（D6 B11 变量常量传播）：字符串视图下标=恒空候选使用点（面=下标访问）
            登记恒空使用点(整64(对象节点x.文本), 整64(取当前诊断行()), 3);
            // T48 裁决甲（2026-09-20）：下标=按 UTF-8 字节索引·结果 整8
            //   （宿主 semantic_expr_access 对齐；原 字符 与「字符=Unicode
            //   标量值」矛盾=规范空白——生成层 i8 符号扩展装载不变）
            返回 驻留("整8");
        }
        如果 (对象类型x != -1) {
            表诊断(诊断, "[错误] 下标对象须为字符串或指针: " + 驻留文本(整64(对象节点x.文本)));
        }
        // -1=未声明：对象标识符节点自身检查已诊断（语句层线性遍历先到）
        返回 -1;
    }
    如果 (对象节点x.类型 == 节点_成员) {
        // 成员对象：经 变量结构体表 推导对象结构体 -> 字段类型（字符串字段才可下标）
        如果 (对象节点x.子起点 > 0) {
            节点 成员对象x = 池.元素(整32(对象节点x.子起点));
            如果 (成员对象x.类型 == 节点_标识符) {
                整64 查结构体x = 查变量结构体键(整64(成员对象x.文本));
                如果 (查结构体x >= 0) {
                    // 值=结构体名ID（1=结构体名标记，非对象结构体）
                    如果 (查结构体x != 1) {
                        整64 字段类型x = 查字段类型ID(查结构体x, 整64(对象节点x.文本));
                        如果 (字段类型x == 驻留("字符串")) {
                            // T48 裁决甲（2026-09-20）：字符串字段下标=字节·结果 整8
                            //   （与字符串变量分支同口径·宿主对齐）
                            返回 驻留("整8");
                        }
                        // 97-a（2026-09-13 第九十七轮 C8）：结构体**字段数组**——
                        //   字段类型是数组 -> 元素类型（宿主结构体数组字段支持=对齐；
                        //   原仅字符串字段放行 -> 「下标对象须为字符串或指针」误拒）
                        字符串 字段文本x = 字符串复制(驻留文本(字段类型x));
                        如果 (是数组类型文本(字段文本x)) {
                            字符串 元素字段x = 数组元素文本(字段文本x);
                            如果 (字符串长度(元素字段x) > 0) { 返回 驻留(元素字段x); }
                        }
                        如果 (字段类型x != 0) {
                            表诊断(诊断, "[错误] 下标对象须为字符串或指针: ." + 驻留文本(整64(对象节点x.文本)));
                        }
                    }
                }
            }
        }
        返回 -1;
    }
    表诊断(诊断, "[错误] 下标对象形态未支持（须字符串变量/字符串字段/指针变量）");
    返回 -1;
}
返回 -1;
    返回 -1;
}

// 调用表达式检查（P6g 调用/类型转换 + P7b 容器构造 + 三级决议 + 内置）：
//   被调标识符节点索引在 子起点（语法层后缀链记录）。
// plans/019 阶段3b 残余（2026-09-10 第六十五轮）：调用借用纪律——①实参为
//   当前函数常量（只读）引用参数而形参为可变引用=只读借出可变拒；②同调用
//   可变引用位与常量引用位实参同基础名=互斥（语句级第一版）。被调键基取
//   签名表首候选（重载族精确决议在 IR 层=诚实边界）。
函数 检查调用借用纪律(向量<节点> 池, 整32 调用节点索引, 整64 被调键基,
                      向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 空类型 {
    节点 调用n = 池.元素(调用节点索引);
    整64 实参数 = 调用n.附加;
    如果 (实参数 <= 0 || 被调键基 < 0) { 返回; }
    整64 查串 = 查函数签名参数串(被调键基 * 键位移);
    如果 (查串 < 0) { 返回; }
    整64 签名键 = 函数签名键(被调键基, 驻留文本(查串));
    整64 首个可变基础名 = -1;
    整64 i = 0;
    当 (i < 实参数) {
        整64 引用位 = 查函数参数引用位(签名键, i);
        整64 常量位 = 查函数参数常量位(签名键, i);
        整64 末位 = 查调用实参末位(调用节点索引, i);
        如果 (引用位 == 1 && 末位 >= 0 && 末位 < 整64(池.大小())) {
            节点 实参末 = 池.元素(整32(末位));
            如果 (实参末.类型 == 节点_标识符) {
                整64 实参名 = 整64(实参末.文本);
                // 188-a（D6·plans/023 B11 变量常量传播）：引用实参=别名逃逸
                //   （被调方可能改写该变量）→ 恒空判定失格（保守，防假阳性）
                登记恒空失格(实参名);
                如果 (常量位 == 1) {
                    如果 (首个可变基础名 == 实参名) {
                        表诊断(诊断, "[错误] 同一调用中变量的可变借用与只读借用互斥: " +
                                      驻留文本(实参名));
                    }
                } 否则 {
                    如果 (是常量引用参数(实参名)) {
                        表诊断(诊断, "[错误] 常量引用参数是只读借用，不能再作为可变引用传参: " +
                                      驻留文本(实参名));
                    }
                    如果 (首个可变基础名 == -1) { 首个可变基础名 = 实参名; }
                }
            }
        }
        i++;
    }
}

// plans/019 阶段3b（2026-09-10）：声明位转移中标志——检查变量声明语句 识别
//   声明初始化位 转移(容器/类) 时置位（区间检查期间），检查调用表达式 的
//   「拥有资源类型仅声明位」分级据此放行（v2 豁免模型浅交接：IR 生成层
//   调用特判=实参值压栈+生成声明 按值 Store=句柄拷贝+调用初值 RAII 豁免
//   ——零 IR 改动即浅交接）
静态 布尔 声明位转移中 = 假;

// 71-a（2026-09-11 方案A 用户裁决）：内置构造器 正常/错误/某些（规范 07-五，
//   编译器预置、用户不可重定义）的装箱语境类型ID——返回位（检查语句 返回语句
//   分支：当前函数返回类型）与声明位（检查变量声明语句：声明目标类型）由检查
//   方设置，区间检查后复位；检查调用表达式 构造器分支读取并写入调用节点.子终点
//   （节点_调用 解析期子终点恒 0=空闲——字段访问「子终点=对象类型ID」预标注
//   同款模式），IR 生成调用 构造器特判直读（语义驱动 IR 同构）。
// 203-a（2026-09-15 第两百零三轮，D1 行数整改）：被调文本分派骨架——构造器/裸释放/
//   转移/签名键回退 四段提取为族方法（程序化切片+双名单差集审计+单文件快验）；
//   装箱语境类型ID 为本文件静态（族① 直接访问）；签名键回退失败以 -1 哨兵返回主函数
//   继续内置/限定/未声明链（与原落空语义等价）。
静态 整64 装箱语境类型ID = 0;

函数 检查调用表达式(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    整64 调用起点 = 整64(n.子起点);
    如果 (调用起点 > 0) {
        节点 被调节点 = 池.元素(整32(调用起点));
        // 575-a（T100·81 对齐 340-a 字段面/宿主 checkAccess）：方法调用面私有
        //   可见性——被调=成员（对象.方法）且对象类型=类 → 类节点扫 节点_方法：
        //   命中方法名且 (修饰/4)%2==1（私有位·解析层段可见性编码 574 系）→
        //   当前检查类豁免（本类方法体内 自身.方法 合法）→ 拒（340-a 措辞对齐；
        //   同模块类外私有调用同面顺带收口=340-a 方法面诚实边界清偿）。
        如果 (被调节点.类型 == 节点_成员 && 被调节点.子起点 > 0) {
            节点 调对象 = 池.元素(被调节点.子起点 - 1);
            如果 (调对象.类型 == 节点_标识符) {
                整64 调对象类型 = 表查找类型ID(符号表, 整64(调对象.文本));
                如果 (调对象类型 > 0) {
                    整64 调类节点 = 查类节点索引(调对象类型);
                    如果 (调类节点 >= 0 && 调类节点 < 整64(池.大小())) {
                        节点 调类值 = 池.元素(整32(调类节点));
                        整64 mm81 = 整64(调类值.子起点);
                        当 (mm81 < 整64(调类值.子终点)) {
                            节点 成员m81 = 池.元素(整32(mm81));
                            如果 (成员m81.类型 == 节点_方法 &&
                                 整64(成员m81.文本) == 整64(被调节点.文本) &&
                                 (成员m81.修饰 / 4) % 2 == 1) {
                                如果 (取当前检查类ID() != 调对象类型) {
                                    表诊断(诊断, "[错误] 无法访问 成员 '" +
                                                  驻留文本(整64(被调节点.文本)) + "'（" +
                                                  驻留文本(调对象类型) + " 的私有成员）");
                                }
                                中断;
                            }
                            mm81++;
                        }
                    }
                }
            }
        }
        如果 (被调节点.类型 == 节点_标识符) {
            整64 被调名 = 整64(被调节点.文本);
            字符串 被调文本 = 字符串复制(驻留文本(被调名));
        // 71-a（2026-09-11 方案A 用户裁决）：内置构造器 正常()/错误()/某些()
        //   （规范 07-五，编译器预置）——合法仅当装箱语境为 结果/可选（返回位
        //   =函数返回类型、声明位=声明目标类型，语境由检查方设置）；推导类型
        //   写入调用节点.子终点（解析期恒 0=空闲位），IR 层构造器特判读取发射。
        //   实参区间由语句根区间线性遍历先序检查（返回语句/变量声明 循环先于
        //   本节点=线性顺序）；构造器名恒走本分支（预置符号表语义，重定义被
        //   遮蔽=第一版边界）。宿主 handleResultCtor 同构（返回类型上下文优先）。
        如果 (字符串比较(被调文本, "正常") || 字符串比较(被调文本, "错误") ||
             字符串比较(被调文本, "某些")) {
                返回 检查构造器调用(池, n, 节点索引, 诊断, 被调文本);
            }
        // 155-a（A5 v2 挂点）：**裸释放**（释放(指针)——与宿主 A5「裸释放」同族）。
        //   判定=名「释放」+ 实参为指针变量（查语义指针变量≥0）；容器等拥有对象
        //   的同名释放语义由容器析构承担（宿主按实参形态区分 call 分派）——v2
        //   第一版按名+指针实参判定（未覆盖形态=诚实边界）。
        如果 (字符串比较(被调文本, "释放")) {
                检查裸释放调用(池, n, 诊断);
            }
        // plans/019 阶段1（2026-09-10）：显式转移 转移(变量) 特判——实参须为
        //   变量标识符；分级：标量拒绝（复制语义）/指针与字符串放行（值交接，
        //   标记已转移+返回实参类型）/拥有资源类型（容器/类/结果等）v2 第一版
        //   暂不支持（宿主声明初始化位已锚定，v2 容器位随阶段3 浅拷贝对齐）。
        //   实参首查先于调用节点（线性顺序）=首次转移不误报，此处标记后
        //   区间后段任何使用经 检查标识符表达式 拒绝。
        如果 (字符串比较(被调文本, "转移")) {
                返回 检查转移调用(池, n, 调用起点, 符号表, 诊断);
            }
        // 206-c（波 4·plans/020 第七十二节）：复制(表达式) 泛型克隆内置——
        //   与 转移(x) 构成显式「复制/移动」双内置（C++ copy/move 对照物，
        //   Rust Clone::clone 同构）。返回类型=实参类型（泛型内置无法固定
        //   签名注册 → 调用处特判）；类型 ID 写入调用节点.子终点 供 IR 层
        //   生成复制展开 按类型分派发射。
        如果 (字符串比较(被调文本, "复制")) {
                返回 检查复制调用(池, n, 节点索引, 调用起点, 符号表, 诊断);
            }
        // P7b：容器类构造调用（向量<整64>() 语法层已合成 向量$整64 被调标识符）
        //   合法——返回类型暂按 整64（对象指针）兜底
        如果 (是容器类(被调文本)) {
            返回 驻留("整64");
        }
        // 灰色点④根治（2026-09-04 用户裁决立案·缺陷零容忍）：强转类型名
        //   白名单补 整8/整16（宿主窄宽强转已支持——整8(300)=44；原白名单
        //   九名缺失时落「未声明函数: 整8」）。
        //   2026-09-04 缺陷零容忍收口：正8/正16 补入（原「显式拒绝」系
        //   无符号语义缺位搁置——违反尽善尽美；现 IR 层 T_正8/T_正16
        //   零扩展标注+双后端 movzx/uxtb 落地，正8(200)=200 语义正确）
        如果 (字符串比较(被调文本, "整32") || 字符串比较(被调文本, "整64") ||
             字符串比较(被调文本, "浮32") || 字符串比较(被调文本, "浮64") ||
             字符串比较(被调文本, "布尔") || 字符串比较(被调文本, "字符") ||
             字符串比较(被调文本, "字符串") || 字符串比较(被调文本, "正32") ||
             字符串比较(被调文本, "正64") || 字符串比较(被调文本, "整8") ||
             字符串比较(被调文本, "整16") || 字符串比较(被调文本, "正8") ||
             字符串比较(被调文本, "正16")) {
            // 329-a（D38 批2·343）：显式转换实参类型检查（单实参形态）——
            //   布尔目标仅收布尔源/字符串与结构体源拒/数值互转含窄化放行
            如果 (n.附加 == 1) {
                检查显式转换实参(池, n, 节点索引, 被调文本, 符号表, 诊断);
            }
            返回 被调名;
        }
        // 函数调用：查符号表（符号_函数 附加=返回类型ID）
        // plans/018 第 3 层：表查找类型ID 内部已三级化（①②③）——命中
        //   用户函数时把决议键基写入 调用决议键基们（语义驱动 IR：第 4 层
        //   决议函数符号 据此锁定候选模块桶，宿主 resolvedSignature 同构）
        整64 找到类型 = 表查找类型ID(符号表, 被调名);
        如果 (找到类型 != -1) {
            登记调用决议(符号表, 被调名, 整64(节点索引));
            // plans/019 阶段3b：调用借用纪律（主路径——键基近似=被调名）
            检查调用借用纪律(池, 节点索引, 被调名, 符号表, 诊断);
            返回 找到类型;
        }
            // 呈报③方案A（2026-09-06）：签名键改造后纯名查不到——按签名表同名候选回退
            //   （精确决议在 IR 层）；plans/018 第 3 层：回退键基化（三级决议）。
            //   203-a：段提取为 检查签名键回退（-1=未决议哨兵，主函数继续内置/限定/未声明链）。
            整64 回退类型 = 检查签名键回退(池, n, 节点索引, 符号表, 诊断, 被调名);
            如果 (回退类型 != -1) {
                返回 回退类型;
            }
        // ③ 第一波（2026-09-03）：内置函数调用（驻留/字符串族/运行时错误——
        //   IR 层映射 ASCII 运行时符号直调）；类型大小(类型) 编译期折叠 -> 整64
        整64 内置返回 = 内置函数返回类型ID(被调文本);
        如果 (内置返回 != 0) { 返回 内置返回; }
        如果 (字符串比较(被调文本, "类型大小")) { 返回 驻留("整64"); }
    整64 限调类型 = 检查限定调用(池, 节点索引, 符号表, 诊断);
    如果 (限调类型 != -2) {
        返回 限调类型;
    }
        // 419-a（D42 波 3）：泛型函数显式实例化调用（名<实参>(...)——合成名
        //   名$实参·基名命中 泛型基类参数序（函数共用表）→放行（单态化生成
        //   供给定义·类型推导=整32 诚实边界·实参位标量场景）
        // 419-a 修正（越界归因）：放行必须返回**真实类型 ID**（-1 哨兵会被上层
        //   当类型索引进向量=数组越界）——泛型函数实例调用返回类型 MVP=整32
        //   （T 返回的精确推导=实例化克隆体语义·419 后续/登记边界）
        如果 (字符串长度(剥实例基名(被调文本)) > 0 &&
             !字符串比较(剥实例基名(被调文本), 被调文本) &&
             查泛型基类参数序(驻留(剥实例基名(被调文本))) != 0) {
            返回 整64(驻留("整32"));
        }
        // -2 = 使用点歧义（E0659 已在三级决议内经缓冲诊断）——不重复报
        如果 (三级键基查找(符号表, 被调名, 0 - 1) != -2) {
            表诊断(诊断, "[错误] 未声明函数: " + 被调文本);
        }
        返回 -1;
    }
    }
// 无被调信息：整64 兜底
返回 驻留("整64");
}


// 203-a：族① 构造器调用检查（71-a 方案A：正常()/错误()/某些() 合法仅当装箱语境为
//   结果/可选——推导类型写回调用节点.子终点，IR 层构造器特判直读；被调文本=主函数
//   已判定三分支名之一；装箱语境类型ID=本文件静态直接访问）。
函数 检查构造器调用(向量<节点> 池, 节点 n, 整32 节点索引, 向量<字符串> 诊断, 字符串 被调文本) -> 整64 {
            如果 (n.附加 > 1) {
                表诊断(诊断, "[错误] 构造器 " + 被调文本 + " 至多一个实参");
                返回 -1;
            }
            如果 (装箱语境类型ID == 0) {
                表诊断(诊断, "[错误] 构造器 " + 被调文本 +
                             " 须用于 结果/可选 语境（返回位或 结果/可选 变量声明初始化位）");
                返回 -1;
            }
            n.子终点 = 整32(装箱语境类型ID);
            结果<空类型, 整32> 设箱n = 池.设置(节点索引, n);
            如果 (!设箱n.正常) { 运行时错误(4); }
            返回 装箱语境类型ID;
}

// 203-a：族② 裸释放检查（155-a A5 挂点：释放(指针) 报不安全边界；非终结分支——
//   检查后主函数继续后续分派）。
函数 检查裸释放调用(向量<节点> 池, 节点 n, 向量<字符串> 诊断) -> 空类型 {
            如果 (n.附加 == 1 && n.子终点 > n.子起点) {
                节点 释放实参 = 池.元素(整32(n.子终点 - 1));
                如果 (释放实参.类型 == 节点_标识符) {
                    如果 (查语义指针变量(整64(释放实参.文本)) >= 0) {
                        错误不安全边界(诊断, "裸释放", "释放(指针)");
                    }
                }
            }
}

// 203-a：族③ 转移调用检查（plans/019 阶段1 显式转移：实参变量分级+声明位约束+
//   已转移拒绝+标记；成功返回实参类型）。
函数 检查转移调用(向量<节点> 池, 节点 n, 整64 调用起点, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 整64 {
            如果 (n.附加 != 1) {
                表诊断(诊断, "[错误] 转移() 须恰好一个实参");
                返回 驻留("整64");
            }
            节点 转实参 = 池.元素(整32(调用起点) + 1);
            如果 (转实参.类型 != 节点_标识符) {
                表诊断(诊断, "[错误] 转移目标须为变量（标识符）");
                返回 驻留("整64");
            }
            整64 转实参类型 = 表查找类型ID(符号表, 整64(转实参.文本));
            如果 (转实参类型 == -1) {
                表诊断(诊断, "[错误] 未声明的标识符: " + 驻留文本(整64(转实参.文本)));
                返回 驻留("整64");
            }
            如果 (表查已转移(符号表, 整64(转实参.文本)) > 0) {
                表诊断(诊断, "[错误] 变量已转移，不能继续使用（显式转移后源变量禁用）: " +
                              驻留文本(整64(转实参.文本)));
                返回 驻留("整64");
            }
            整64 转分级 = 转移实参分级(转实参类型, 整64(转实参.文本));
            如果 (转分级 == 1) {
                表诊断(诊断, "[错误] 变量具有复制语义，无需转移: " +
                              驻留文本(整64(转实参.文本)));
                返回 驻留("整64");
            }
            如果 (转分级 == 2 && !声明位转移中) {
                表诊断(诊断, "[错误] 拥有资源类型的转移仅支持声明初始化位"
                              + "（类型 名 = 转移(变量);）: " +
                              驻留文本(整64(转实参.文本)));
                返回 驻留("整64");
            }
            表标记转移(符号表, 整64(转实参.文本), 1);
            返回 转实参类型;
}

// 206-c（波 4·plans/020 第七十二节 §二）：族⑤ 复制调用检查——复制(表达式)
//   泛型克隆内置（与 转移(x) 显式「复制/移动」双内置；C++ copy/move、Rust
//   Clone::clone 同构）。实参恰 1 个；返回类型=实参类型（泛型内置无法固定
//   签名注册 → 调用处特判）；类型 ID 写回调用节点.子终点（解析期空闲位，
//   71-a 装箱特判同款）供 IR 层 生成复制展开 按类型分派发射。
//   实参类型推导=**静默优先**：标识符/成员/下标 属 place 形态（stdlib 四容器
//   拷贝构造切换全需求），且已由语句根区间线性遍历先序检查——此处重复检查
//   会重复诊断，并重复触发借用纪律/转移标记副作用（`复制(转移(x))` 二次
//   标记后误报「变量已转移」）；故 place 形态走丢弃诊断静默推导（副作用面
//   =类型推导，无状态变更），其余形态（调用返回/字面量）回落 检查表达式。
函数 检查复制调用(向量<节点> 池, 节点 n, 整32 节点索引, 整64 调用起点, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 整64 {
    如果 (n.附加 != 1) {
        表诊断(诊断, "[错误] 复制(表达式) 恰好接收 1 个实参");
        返回 驻留("整64");
    }
    整32 复参索引 = 整32(调用起点) + 1;
    节点 复实参 = 池.元素(复参索引);
    向量<字符串> 静默诊断 = 向量<字符串>();
    整64 复类型 = 0 - 1;
    如果 (复实参.类型 == 节点_标识符) {
        复类型 = 表查找类型ID(符号表, 整64(复实参.文本));
    } 否则 如果 (复实参.类型 == 节点_下标 || 复实参.类型 == 节点_成员) {
        复类型 = 检查表达式(池, 复参索引, 符号表, 静默诊断);
    } 否则 {
        复类型 = 检查表达式(池, 复参索引, 符号表, 诊断);
    }
    如果 (复类型 <= 0) { 返回 驻留("整64"); }
    n.子终点 = 整32(复类型);
    结果<空类型, 整32> 设复 = 池.设置(节点索引, n);
    如果 (!设复.正常) { 运行时错误(4); }
    返回 复类型;
}

// 203-a：族④ 签名键回退决议（呈报③方案A：签名表同名候选回退+plans/018 键基化三级决议；
//   决议成功=登记调用决议+借用纪律+返回类型；失败返回 -1 哨兵=主函数继续后续链）。
函数 检查签名键回退(向量<节点> 池, 节点 n, 整32 节点索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断, 整64 被调名) -> 整64 {
        整64 调键基 = 三级键基查找(符号表, 被调名, 整64(n.附加));
        如果 (调键基 >= 0) {
            整64 查调签数 = 查函数签名个数(调键基);
            如果 (查调签数 >= 0) {
                如果 (查调签数 > 0) {
                    整64 查调签串 = 查函数签名参数串(调键基 * 键位移);
                    如果 (查调签串 >= 0) {
                        整64 调签键 = 函数签名键(调键基, 驻留文本(查调签串));
                        整64 调签类型 = 全局层查类型(符号表, 调签键);
                        如果 (调签类型 != -1) {
                            登记调用决议(符号表, 被调名, 整64(节点索引));
                            // plans/019 阶段3b：调用借用纪律（回退段——键基精确）
                            检查调用借用纪律(池, 节点索引, 调键基, 符号表, 诊断);
                            返回 调签类型;
                        }
                    }
                }
            }
        }
    // 203-a：未决议路径显式 -1 哨兵（原落空语义=主函数继续内置/限定/未声明链）
    返回 -1;
}

// plans/018 第 4 层：用户模块限定调用 m::x（限定调用恒明确、不参与遮蔽，
//   规格 5.9.7）——B1 改写产物与显式限定同形态；模块已加载即可用（宿主呈报
//   一B「限定调用按已加载放行」对齐），但符号须存在且（跨模块时）公开；
//   stdlib 前面内置表已兜底，此处仅用户模块。
// 返回：-2=非限定形态（调用方报未声明函数）；否则=类型ID（含 -1 已诊断）。
函数 检查限定调用(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    整64 调用起点 = 整64(n.子起点);
    如果 (调用起点 <= 0) { 返回 -2; }
    节点 被调节点 = 池.元素(整32(调用起点));
    如果 (被调节点.类型 != 节点_标识符) { 返回 -2; }
    字符串 被调文本 = 字符串复制(驻留文本(整64(被调节点.文本)));
字符串 限定模块s = "";
字符串 限定符号s = "";
如果 (拆限定名(被调文本, 限定模块s, 限定符号s) == 1 &&
     !是标准库模块名(限定模块s)) {
    整64 限源ID = 驻留(限定模块s);
    整64 限符ID = 驻留(限定符号s);
    整64 限键基 = 0;
    整64 查限 = 查模块成员键基(限源ID, 限符ID);
    如果 (查限 >= 0) {
        限键基 = 查限;
    } 否则 {
        表诊断(诊断, "[错误] 未声明的标识符: " + 被调文本 +
                      "（模块 " + 限定模块s + " 无符号 " + 限定符号s + "）");
        返回 -1;
    }
    布尔 限自模块 = 字符串比较(限定模块s, 驻留文本(当前模块路径ID));
    如果 (!限自模块) {
        整64 查限公 = 查模块成员公开(限源ID, 限符ID);
        如果 (查限公 < 0) {
            表诊断(诊断, "[错误] 符号 '" + 限定符号s + "' 为模块 '" +
                          限定模块s + "' 私有（未以 公开: 标注），不可限定调用（规格08 5.9.3）");
            返回 -1;
        }
    }
    // 候选数提取（结果 流敏感检查惯例）
    整64 限候选数 = 0;
    整64 查限数 = 查函数签名个数(限键基);
    如果 (查限数 >= 0) {
        限候选数 = 查限数;
    }
    如果 (限候选数 > 0) {
        调用决议登记(整64(节点索引), 限键基);
    }
    // 返回类型：签名表首个候选（重载精确决议在 IR 层）或符号表键基条目
    整64 限类型 = -1;
    如果 (限候选数 > 0) {
        整64 查限串 = 查函数签名参数串(限键基 * 键位移);
        如果 (查限串 >= 0) {
            限类型 = 全局层查类型(符号表, 函数签名键(限键基, 驻留文本(查限串)));
        }
    }
    如果 (限类型 == -1) {
        限类型 = 全局层查类型(符号表, 限键基);
    }
    返回 限类型;
}
    返回 -2;
}

// ==================== 混合符号二元运算拒绝（2026-09-10 第五十一轮 方案A） ====================
// 规范 plans/001 §3.7（2026-09-10 用户裁决方案A，Rust 对齐）：有符号（整N）与
//   无符号（正M）的「变量间」比较/算术/位运算编译期拒绝，须显式 类型名(表达式)
//   构造转换——隐式宽化在混合符号下静默改变值语义（探针实证 target/p50x64l/
//   mixed_cmp：正64(2^63) vs 整64(-1) 比较值域反转；正32 vs 整64 负值形态宿主
//   rc=9 / v2 rc=11 / 数学真值 13 双侧分叉）。字面量豁免（含 -1 形态）——按
//   另一侧类型参与（Rust 字面量推断惯例，191「大 > 100」锚保留）。类型推导 -1
//   （成员/嵌套二元等半实现面）跳过=检不出，随 v2 语义类型推导完善收口（与
//   字符串比较拒绝检查同款诚实边界）。

// 整数族类型ID 判定（整8~整128/正8~正128）——混合符号检查用
函数 是整数族类型ID(整64 类型ID) -> 布尔 {
    字符串 t = 字符串复制(驻留文本(类型ID));
    返回 字符串比较(t, "整8") || 字符串比较(t, "整16") || 字符串比较(t, "整32") ||
          字符串比较(t, "整64") || 字符串比较(t, "整128") ||
          字符串比较(t, "正8") || 字符串比较(t, "正16") || 字符串比较(t, "正32") ||
          字符串比较(t, "正64") || 字符串比较(t, "正128");
}

// 无符号类型ID 判定（正8~正128）——混合符号检查用
函数 是无符号类型ID(整64 类型ID) -> 布尔 {
    字符串 t = 字符串复制(驻留文本(类型ID));
    返回 字符串比较(t, "正8") || 字符串比较(t, "正16") || 字符串比较(t, "正32") ||
          字符串比较(t, "正64") || 字符串比较(t, "正128");
}

// 操作数末端节点是否整数字面量形态（整数字面量，或 负号 作用于整数字面量
//   如 -1——区间末=表达式根惯例；负号操作数根=其 子终点-1）
函数 是整数字面量末端(向量<节点> 池, 整32 末端索引) -> 布尔 {
    如果 (末端索引 < 0 || 末端索引 >= 整32(池.大小())) { 返回 假; }
    节点 末端 = 池.元素(末端索引);
    如果 (末端.类型 == 节点_整数字面量) { 返回 真; }
    如果 (末端.类型 == 节点_负号 && 末端.子终点 > 0) {
        节点 操作数根 = 池.元素(整32(末端.子终点 - 1));
        返回 操作数根.类型 == 节点_整数字面量;
    }
    返回 假;
}

// 混合符号二元运算检查（宿主 semantic_expr.cpp visitBinaryExpr 同构）：
//   左右类型均可推导且均为整数族、符号相异、双侧均非字面量形态时诊断拒绝。
//   比较/算术/位运算共用；左末端=子起点-1、右末端=本节点索引-1（调用侧约定）。
//   类型经 表达式类型ID 推导族 + 静默诊断缓冲——检查表达式 有诊断副作用非幂等，
//   操作数已由语句根区间线性遍历权威检查（174 教训：二次递归=未声明重复报），
//   本处推导产生的诊断一律吞弃，仅取类型值；-1（不可推导）跳过=检不出诚实边界。
函数 检查混合符号二元(向量<节点> 池, 整32 左末端索引, 整32 右末端索引,
                    向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 空类型 {
    向量<字符串> 静默诊断 = 向量<字符串>();
    整64 左类型 = 表达式类型ID(池, 左末端索引, 符号表, 静默诊断);
    整64 右类型 = 表达式类型ID(池, 右末端索引, 符号表, 静默诊断);
    如果 (左类型 == -1 || 右类型 == -1) { 返回; }
    如果 (!是整数族类型ID(左类型) || !是整数族类型ID(右类型)) { 返回; }
    如果 (是无符号类型ID(左类型) == 是无符号类型ID(右类型)) { 返回; }
    如果 (是整数字面量末端(池, 左末端索引) || 是整数字面量末端(池, 右末端索引)) { 返回; }
    表诊断(诊断, "[错误] 混合符号二元运算禁止：'" + 驻留文本(左类型) + "' 与 '" +
           驻留文本(右类型) + "' —— 须显式转换（如 整64(表达式)/正64(表达式)）；字面量豁免（Rust 对齐，2026-09-10 方案A）");
}


// 混合符号赋值检查（55-c 方案A，2026-09-10 第五十六轮 用户裁决，Rust E0308 对齐，
//   宿主 canConvert 跨符号拒绝+canConvertWithLiteral 字面量豁免同构）：赋值
//   初始化/赋值/返回面的「变量间」混合符号隐式转换拒绝（§3.7 条文扩展——
//   第五十一轮只拦二元运算面）。左类型=赋值目标类型名ID（声明类型/左值类型/
//   函数返回类型，调用方已知——节点_函数.附加/表查找类型ID/推导成员类型ID）；
//   右末端=值表达式末端节点索引（区间末惯例）。右值类型经 表达式类型ID 推导族
//   +静默诊断缓冲（174 教训：二次推导诊断吞弃，语句根线性遍历=权威诊断点）；
//   右值为整数字面量形态（含 -1）豁免——字面量按目标类型参与（Rust 推断惯例，
//   `正64 大 = 9223372036854775808` 等初始化形态保留）；左类型非整数族/引用
//   后缀名/右类型不可推导/-1 时跳过=检不出诚实边界（随 v2 类型推导完善收口）。
函数 检查混合符号赋值(向量<节点> 池, 整64 左类型名ID, 整32 右末端索引,
                    向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 空类型 {
    如果 (!是整数族类型ID(左类型名ID)) { 返回; }
    // 取地址右值跳过（&x 产物为指针，类型推导兜底 整64 与真整64 不可区分——
    //   指针赋值面（正8* q = &p.窄 等）不属整数混合符号语义）
    如果 (右末端索引 >= 0 && 右末端索引 < 整32(池.大小()) &&
         池.元素(右末端索引).类型 == 节点_取地址) { 返回; }
    向量<字符串> 静默诊断 = 向量<字符串>();
    整64 右类型 = 表达式类型ID(池, 右末端索引, 符号表, 静默诊断);
    如果 (右类型 == -1) { 返回; }
    如果 (!是整数族类型ID(右类型)) { 返回; }
    如果 (是无符号类型ID(左类型名ID) == 是无符号类型ID(右类型)) { 返回; }
    如果 (是整数字面量末端(池, 右末端索引)) { 返回; }
    表诊断(诊断, "[错误] 混合符号赋值禁止：'" + 驻留文本(左类型名ID) + "' 与 '" +
           驻留文本(右类型) + "' —— 须显式转换（如 整64(表达式)/正64(表达式)）；字面量豁免（Rust 对齐，2026-09-10 方案A）");
}

// ==================== D38 批2 v2 负测防线语义层（329-a·2026-09-18） ====================
// 43 形态宿主行为矩阵实测对齐（target/p320a/d38b2_matrix*.py 三轮·宿主 check 逐
//   形态实跑）：隐式转换仅宽化放行/浮字面量按 f 后缀分型/布尔与字符串源仅同型/
//   目标=字符特殊放行/复合赋值面不拦（宿主 w19 放行）/条件严格布尔（整数也拒）/
//   显式转换布尔目标仅收布尔源。源类型推导走 静默诊断缓冲（本文件 665 同款惯例
//   ——174 教训：二次推导诊断吞弃）。

// 整数族文本（布尔/字符不属本族——族判定与 类型可合并 的整数族〔含布尔字符〕
//   刻意区分：转换规则里布尔目标与字符目标各有专门条款）
函数 是转换整数族文本(字符串 t) -> 布尔 {
    返回 字符串比较(t, "整8") || 字符串比较(t, "整16") ||
          字符串比较(t, "整32") || 字符串比较(t, "整64") ||
          字符串比较(t, "正8") || 字符串比较(t, "正16") ||
          字符串比较(t, "正32") || 字符串比较(t, "正64") ||
          // 340-m（153 实证）：整128/正128 缺席致显式转换误拒
          字符串比较(t, "整128") || 字符串比较(t, "正128");
}

// 浮点族文本
函数 是转换浮点族文本(字符串 t) -> 布尔 {
    返回 字符串比较(t, "浮32") || 字符串比较(t, "浮64");
}

// 同族宽窄比较位宽：整族/字符=1/2/4/8；浮32=4、浮64=8（跨族不使用）
函数 转换类型位宽(字符串 t) -> 整64 {
    如果 (字符串比较(t, "整8") || 字符串比较(t, "正8") || 字符串比较(t, "字符")) { 返回 1; }
    如果 (字符串比较(t, "整16") || 字符串比较(t, "正16")) { 返回 2; }
    如果 (字符串比较(t, "整32") || 字符串比较(t, "正32") || 字符串比较(t, "浮32")) { 返回 4; }
    如果 (字符串比较(t, "整128") || 字符串比较(t, "正128")) { 返回 16; }
    返回 8;   // 整64/正64/浮64
}

// 源表达式类型零副作用推导（**只走可靠面·329-a 收紧**）：字面量节点由
//   隐式转换合法 直判不经此处；本函数精确处理 标识符（表查找·常量豁免）与
//   比较/短路二元（产物=布尔·宿主 w14 对齐）。调用/成员/下标/其余二元=
//   **推导不可靠面一律 -1 放行**——检查调用表达式 对无被调信息/签名回退失败
//   有「整64 兜底」、容器方法（元素/删除/大小 等）与拼接产物无精确推导，防线
//   消费兜底会误伤自举树（38 处实证：整32 = 当前ID()/布尔 = 映射.删除()/
//   字符串 = 输出.元素()/前缀类型 = 节点常量）——随 v2 语义推导完善收口
//   （D 族长线），六用例防线不依赖不可靠面。
函数 推导源类型ID静默(向量<节点> 池, 整32 源末索引,
                    向量<映射<整64, 符号>> 符号表) -> 整64 {
    如果 (源末索引 < 0 || 源末索引 >= 整32(池.大小())) { 返回 -1; }
    节点 n = 池.元素(源末索引);
    如果 (n.类型 == 节点_二元运算) {
        字符串 op文本 = 字符串复制(驻留文本(整64(n.文本)));
        如果 (字符串比较(op文本, "==") || 字符串比较(op文本, "!=") ||
             字符串比较(op文本, "<") || 字符串比较(op文本, ">") ||
             字符串比较(op文本, "<=") || 字符串比较(op文本, ">=") ||
             字符串比较(op文本, "&&") || 字符串比较(op文本, "||")) {
            返回 驻留("布尔");
        }
        返回 -1;   // 算术/位/拼接=操作数推导污染面·放行
    }
    如果 (n.类型 == 节点_标识符) {
        // 常量豁免（符号_常量 类型ID 记 整64 名ID·收集常量声明 惯例——
        //   整32 变量 = 节点常量 是 v2 树高频合法形态）
        如果 (表查找种类(符号表, 整64(n.文本)) == 符号_常量) { 返回 -1; }
        返回 表查找类型ID(符号表, 整64(n.文本));
    }
    返回 -1;   // 调用/成员/下标/一元/三元=不可靠面·放行
}

// 隐式转换合法性核心判定（宿主 semantic 隐式转换矩阵同构·43 形态实测）：
//   真=放行；假=调用方须诊断。目标非内置标量（容器/结果/类/结构体合成名）=
//   拷贝/构造语义不做标量检查；目标/源不可推导=检不出诚实边界放行。
函数 隐式转换合法(向量<节点> 池, 整32 源末索引, 整64 目标类型ID,
                 向量<映射<整64, 符号>> 符号表) -> 布尔 {
    如果 (目标类型ID <= 0) { 返回 真; }
    字符串 目标文本 = 字符串复制(驻留文本(目标类型ID));
    布尔 目标整数 = 是转换整数族文本(目标文本);
    布尔 目标浮点 = 是转换浮点族文本(目标文本);
    布尔 目标字符 = 字符串比较(目标文本, "字符");
    布尔 目标布尔 = 字符串比较(目标文本, "布尔");
    布尔 目标字符串 = 字符串比较(目标文本, "字符串");
    如果 (!(目标整数 || 目标浮点 || 目标字符 || 目标布尔 || 目标字符串)) { 返回 真; }
    如果 (源末索引 < 0 || 源末索引 >= 整32(池.大小())) { 返回 真; }
    节点 源末 = 池.元素(源末索引);
    // 字面量形态（节点类型直判——检查表达式 对整字面量恒返整32 无后缀信息）
    如果 (源末.类型 == 节点_整数字面量) {
        // 565 轮（T36 v2 面·宿主 319-a 统一严格同口径）：整字面量→窄宽目标
        //   值域检查——域内放行/域外拒（g1 整16=40000 / g5 正8=300 / h6
        //   正32=5000000000 宿主拒·v2 曾放行）；整32/整64/正64 目标不检
        //   （h1/h5 宿主任意字面量放行+运行回绕实测定案）。浮/字符目标维持
        //   适配放行（w01/w06/w15/w12）；→布尔 拒（w28）不变。
        如果 (目标整数 && !整字面量入域(源末, 池, 目标文本, 假)) {
            返回 假;
        }
        返回 目标整数 || 目标浮点 || 目标字符;
    }
    如果 (源末.类型 == 节点_负号) {
        // 565 轮（T36 v2 面·负号+字面量形态）：`整8 甲=-200` / `正8 甲=-1`
        //   （g9/g10 宿主拒·v2 曾放行）——负号节点 子起点=操作数表达式·操
        //   作数为整字面量时按负值入域判定；操作数非字面量=检不出放行（既有
        //   诚实边界·55-c 同款）。→浮/字符适配放行维持。
        如果 (目标整数) {
            返回 整字面量入域(源末, 池, 目标文本, 真);
        }
        返回 目标整数 || 目标浮点 || 目标字符;
    }
    如果 (源末.类型 == 节点_浮点字面量) {
        // 浮字面量按文本尾 f 分浮32/浮64（w11 `1.5f`→浮32 过 vs w05 `1.5`→浮32 拒）
        字符串 字面文本 = 字符串复制(驻留文本(整64(源末.文本)));
        整64 文本长 = 字符串长度(字面文本);
        如果 (文本长 > 1 && 字符串比较(字符串子串(字面文本, 文本长 - 1, 1), "f")) {
            返回 目标浮点;   // 浮32字面量→浮32/浮64（w11）
        }
        返回 字符串比较(目标文本, "浮64");   // 浮64字面量仅浮64（w05 窄浮拒）
    }
    如果 (源末.类型 == 节点_布尔字面量) { 返回 目标布尔; }   // t12 真→整32 拒
    如果 (源末.类型 == 节点_字符串字面量) { 返回 目标字符串; }   // t11
    如果 (源末.类型 == 节点_字符字面量) { 返回 目标整数 || 目标浮点 || 目标字符; }
    // 变量/表达式形态：源类型经静默推导
    整64 源类型ID = 推导源类型ID静默(池, 源末索引, 符号表);
    如果 (源类型ID <= 0) { 返回 真; }   // 检不出放行（诚实边界·55-c 同款）
    字符串 源文本 = 字符串复制(驻留文本(源类型ID));
    如果 (字符串比较(源文本, 目标文本)) { 返回 真; }   // 同型
    如果 (字符串比较(源文本, "布尔") || 字符串比较(源文本, "字符串")) { 返回 假; }
    布尔 源整数 = 是转换整数族文本(源文本) || 字符串比较(源文本, "字符");
    布尔 源浮点 = 是转换浮点族文本(源文本);
    如果 (!(源整数 || 源浮点)) { 返回 假; }   // 结构体/类/容器源→标量目标拒
    如果 (源整数 && 目标字符) { 返回 真; }   // w29 整变量→字符放行（宿主实测）
    如果 (源整数 && 目标整数) { 返回 转换类型位宽(源文本) <= 转换类型位宽(目标文本); }
    如果 (源整数 && 目标浮点) { 返回 真; }   // 整→浮宽化（t14/w15/w23）
    如果 (源浮点 && 目标浮点) { 返回 转换类型位宽(源文本) <= 转换类型位宽(目标文本); }
    返回 假;   // 浮→整（t18/t23/w27）、其余跨族
}

// 565 轮（T36 v2 面）：整数字面量文本→值（十进制·负号由 形参 并入）——值域
//   检查专用。非全数字/空文本=失败置 假（调用方检不出放行兜底）；位数 >10
//   必然越出全部受检目标上界（正32 上界 4294967295 恰 10 位·防 整64 溢出假
//   域内，直接判域外不再解析）。
函数 整数字面量文本值(字符串 字面文本, 布尔 负号, 布尔& 成功) -> 整64 {
    整64 长度l = 字符串长度(字面文本);
    成功 = 长度l > 0 && 长度l <= 10;
    整64 值v = 0;
    整64 i = 0;
    当 (i < 长度l && 成功) {
        整64 字节b = 字节值(字面文本, i);
        如果 (字节b < 48 || 字节b > 57) {
            成功 = 假;
        } 否则 {
            值v = 值v * 10 + (字节b - 48);
        }
        i++;
    }
    如果 (负号) { 值v = 0 - 值v; }
    返回 值v;
}

// 565 轮（T36 v2 面）：整字面量值域判定——宿主 T36·319-a「域内字面量保留
//   豁免、域外拒绝」同口径。受检目标与值域（宿主 g/g/h 系探针实测定案）：
//   整8 [-128,127]／正8 [0,255]／整16 [-32768,32767]／正16 [0,65535]／
//   正32 [0,4294967295]；**整32/整64/正64 不检**（h1 整32=4000000000、
//   h5 整32=6000000000、h2/h3 整64±2^63 宿主全放行+运行回绕）。负号+字面量
//   形态（节点_负号·子起点=操作数）按负值判定（g9 整8=-200/g10 正8=-1 宿主拒）；
//   文本解析失败=放行（检不出诚实边界·55-c 同款）。
函数 整字面量入域(节点 源末, 向量<节点> 池, 字符串 目标文本, 布尔 负号) -> 布尔 {
    整64 字面名IDl = 0;
    如果 (源末.类型 == 节点_整数字面量) {
        字面名IDl = 整64(源末.文本);
    } 否则 如果 (源末.类型 == 节点_负号 && 负号 &&
                源末.子起点 >= 0 && 源末.子起点 < 整32(池.大小())) {
        节点 操作数l = 池.元素(源末.子起点);
        如果 (操作数l.类型 == 节点_整数字面量) {
            字面名IDl = 整64(操作数l.文本);
        }
    }
    如果 (字面名IDl == 0) { 返回 真; }   // 非字面量/形态不合=检不出放行
    布尔 成功l = 假;
    整64 值l = 整数字面量文本值(字符串复制(驻留文本(字面名IDl)), 负号, 成功l);
    如果 (!成功l) { 返回 真; }   // 解析失败（超 10 位/非数字）=检不出放行
    如果 (字符串比较(目标文本, "整8")) { 返回 值l >= 0 - 128 && 值l <= 127; }
    如果 (字符串比较(目标文本, "正8")) { 返回 值l >= 0 && 值l <= 255; }
    如果 (字符串比较(目标文本, "整16")) { 返回 值l >= 0 - 32768 && 值l <= 32767; }
    如果 (字符串比较(目标文本, "正16")) { 返回 值l >= 0 && 值l <= 65535; }
    如果 (字符串比较(目标文本, "正32")) { 返回 值l >= 0 && 值l <= 4294967295; }
    返回 真;   // 整32/整64/正64 目标不检（宿主实测定案）
}

// 标量隐式转换检查（声明初始化/赋值/返回 三面共用·D38 批2 350+305）：
//   不合法即诊断。语境措辞：声明/赋值面="隐式转换为 '目标'"（宿主 350 原文）、
//   返回面="隐式转换为返回类型 '目标'"（宿主 305 原文）。
函数 检查标量隐式转换(向量<节点> 池, 整32 源末索引, 整64 目标类型ID,
                    向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断,
                    布尔 返回面) -> 空类型 {
    如果 (目标类型ID <= 0) { 返回; }
    字符串 目标文本 = 字符串复制(驻留文本(目标类型ID));
    如果 (!隐式转换合法(池, 源末索引, 目标类型ID, 符号表)) {
        如果 (返回面) {
            表诊断(诊断, "[错误] 无法将 '" + 推导源类型文本(池, 源末索引, 符号表, 目标文本) +
                          "' 隐式转换为返回类型 '" + 目标文本 + "'");
        } 否则 {
            表诊断(诊断, "[错误] 无法将 '" + 推导源类型文本(池, 源末索引, 符号表, 目标文本) +
                          "' 隐式转换为 '" + 目标文本 + "'");
        }
    }
}

// 诊断措辞用源类型文本（字面量节点直判文本；不可推导回退目标文本占位）
函数 推导源类型文本(向量<节点> 池, 整32 源末索引,
                  向量<映射<整64, 符号>> 符号表, 字符串 回退文本) -> 字符串 {
    如果 (源末索引 < 0 || 源末索引 >= 整32(池.大小())) { 返回 字符串复制(回退文本); }
    节点 源末 = 池.元素(源末索引);
    如果 (源末.类型 == 节点_整数字面量) { 返回 "整32"; }
    如果 (源末.类型 == 节点_浮点字面量) {
        字符串 字面文本 = 字符串复制(驻留文本(整64(源末.文本)));
        整64 文本长 = 字符串长度(字面文本);
        如果 (文本长 > 1 && 字符串比较(字符串子串(字面文本, 文本长 - 1, 1), "f")) {
            返回 "浮32";
        }
        返回 "浮64";
    }
    如果 (源末.类型 == 节点_布尔字面量) { 返回 "布尔"; }
    如果 (源末.类型 == 节点_字符串字面量) { 返回 "字符串"; }
    如果 (源末.类型 == 节点_字符字面量) { 返回 "字符"; }
    整64 源类型ID = 推导源类型ID静默(池, 源末索引, 符号表);
    如果 (源类型ID <= 0) { 返回 字符串复制(回退文本); }
    返回 字符串复制(驻留文本(源类型ID));
}

// 341：如果/当 条件严格布尔检查（宿主 t06/t07/t08 实测——整/浮条件均拒·
//   C 风格非零真不适用 CN）。布尔判定零副作用：比较/短路二元（op 文本）、
//   逻辑非、布尔字面量直判；标识符 表查找类型ID；调用 查函数返回类型；
//   其余形态=检不出放行（诚实边界）。
函数 检查条件布尔(向量<节点> 池, 整32 条件末索引, 字符串 关键字,
                向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 空类型 {
    如果 (条件末索引 < 0 || 条件末索引 >= 整32(池.大小())) { 返回; }
    节点 n = 池.元素(条件末索引);
    布尔 条件合法 = 假;
    字符串 实际文本 = "";
    如果 (n.类型 == 节点_二元运算) {
        字符串 op文本 = 字符串复制(驻留文本(整64(n.文本)));
        条件合法 = 字符串比较(op文本, "==") || 字符串比较(op文本, "!=") ||
                  字符串比较(op文本, "<") || 字符串比较(op文本, ">") ||
                  字符串比较(op文本, "<=") || 字符串比较(op文本, ">=") ||
                  字符串比较(op文本, "&&") || 字符串比较(op文本, "||");
        如果 (条件合法) {
            实际文本 = "布尔";
        } 否则 {
            // 算术二元作条件：实际类型按操作数推导（取左·推导二元类型ID 粒度）
            实际文本 = 推导源类型文本(池, 条件末索引, 符号表, "未知");
        }
    } 否则 如果 (n.类型 == 节点_逻辑非) {
        条件合法 = 真;
        实际文本 = "布尔表达式";
    } 否则 如果 (n.类型 == 节点_布尔字面量) {
        条件合法 = 真;
        实际文本 = "布尔";
    } 否则 如果 (n.类型 == 节点_整数字面量) {
        实际文本 = "整32";
    } 否则 如果 (n.类型 == 节点_浮点字面量) {
        实际文本 = "浮64";
    } 否则 如果 (n.类型 == 节点_字符串字面量) {
        实际文本 = "字符串";
    } 否则 如果 (n.类型 == 节点_标识符) {
        整64 类型ID = 表查找类型ID(符号表, 整64(n.文本));
        条件合法 = 类型ID == 驻留("布尔");
        如果 (类型ID > 0) { 实际文本 = 字符串复制(驻留文本(类型ID)); } 否则 { 条件合法 = 真; }
    } 否则 如果 (n.类型 == 节点_调用 && n.子起点 > 0) {
        节点 被调 = 池.元素(整32(n.子起点));
        如果 (被调.类型 == 节点_标识符) {
            整64 返回类型 = 查函数返回类型(整64(被调.文本));
            如果 (返回类型 == 驻留("布尔")) {
                条件合法 = 真;
                实际文本 = "布尔";
            } 否则 如果 (返回类型 > 0) {
                实际文本 = 字符串复制(驻留文本(返回类型));
            } 否则 {
                条件合法 = 真;   // 返回类型不可推导=放行（诚实边界）
            }
        } 否则 {
            条件合法 = 真;
        }
    } 否则 {
        条件合法 = 真;   // 成员/三元/下标等=检不出放行（诚实边界）
    }
    如果 (!条件合法 && 字符串长度(实际文本) > 0) {
        表诊断(诊断, "[错误] '" + 关键字 + "'条件必须为布尔类型，实际为 '" + 实际文本 + "'");
    }
}

// 343：显式转换 类型(x) 实参类型检查（检查调用表达式 类型名白名单分支挂点·
//   单实参形态）。规则=宿主矩阵实测：布尔目标仅收布尔源（t28 布尔(1) 拒）；
//   字符串源拒（t26）；结构体/类源拒（t24/t25）；数值↔数值（含窄化 w03/w13）
//   与 布尔→数值（t27）与 整→字符（t29）放行；源不可推导放行。
//   实参末位经 查调用实参末位 表（调用节点 子终点 解析期恒 0=空闲位，
//   不能作区间末——解析调用后缀 实参末位表 同款）。
函数 检查显式转换实参(向量<节点> 池, 节点 n, 整32 调用节点索引, 字符串 被调文本,
                    向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 空类型 {
    如果 (n.附加 != 1) { 返回; }
    整64 实参末位 = 查调用实参末位(整64(调用节点索引), 0);
    如果 (实参末位 < 0 || 实参末位 >= 整64(池.大小())) { 返回; }
    整32 实参末索引 = 整32(实参末位);
    整64 目标ID = 驻留(被调文本);
    字符串 实际文本 = 推导源类型文本(池, 实参末索引, 符号表, 被调文本);
    布尔 放行 = 假;
    如果 (字符串比较(被调文本, "布尔")) {
        // 布尔目标仅收布尔源（t28 布尔(1) 拒）——字面量直判（推导不可靠面外
        //   仍可精确判定的形态）；调用/标识符源走推导（-1 放行=诚实边界）
        节点 实参末 = 池.元素(实参末索引);
        如果 (实参末.类型 == 节点_布尔字面量) {
            放行 = 真;
        } 否则 如果 (实参末.类型 == 节点_整数字面量 ||
                    实参末.类型 == 节点_浮点字面量 ||
                    实参末.类型 == 节点_字符串字面量 ||
                    实参末.类型 == 节点_字符字面量) {
            放行 = 假;
        } 否则 {
            整64 源ID = 推导源类型ID静默(池, 实参末索引, 符号表);
            放行 = 源ID == 驻留("布尔") || 源ID <= 0;
        }
    } 否则 {
        // 数值/字符/字符串目标：源须为数值族/布尔/字符（字符串目标仅收字符串源）
        节点 实参末 = 池.元素(实参末索引);
        布尔 源是标量值 = 假;
        如果 (实参末.类型 == 节点_整数字面量 || 实参末.类型 == 节点_浮点字面量 ||
             实参末.类型 == 节点_布尔字面量 || 实参末.类型 == 节点_字符字面量) {
            源是标量值 = 真;
        } 否则 如果 (实参末.类型 == 节点_字符串字面量) {
            源是标量值 = 假;   // 字符串字面量→数值拒（t26）
        } 否则 {
            整64 源ID = 推导源类型ID静默(池, 实参末索引, 符号表);
            如果 (源ID <= 0) {
                源是标量值 = 真;   // 检不出放行（诚实边界）
            } 否则 {
                字符串 源文本 = 字符串复制(驻留文本(源ID));
                源是标量值 = 是转换整数族文本(源文本) || 是转换浮点族文本(源文本) ||
                            字符串比较(源文本, "字符") || 字符串比较(源文本, "布尔") ||
                            字符串比较(源文本, "字符串") ||
                            // 418-a（D40 细分）：枚举类型源=标量族（C 风格枚举值域整32）
                            是枚举名(驻留(源文本));
                // 源=字符串 且 目标=字符串：同型构造放行；源=字符串 且 目标=数值：
                //   宿主 t26 拒——本分支 源是标量值=真 会放行，特判收紧
                如果 (字符串比较(源文本, "字符串") && !字符串比较(被调文本, "字符串")) {
                    源是标量值 = 假;
                }
            }
        }
        放行 = 源是标量值;
    }
    如果 (!放行) {
        表诊断(诊断, "[错误] 无法将 '" + 实际文本 + "' 显式转换为 '" + 被调文本 + "'");
    }
}
