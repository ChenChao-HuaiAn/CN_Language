        //   扫描二态判据撤除）。
        如果 (被调节点.类型 == 节点_成员 && 被调节点.子起点 > 0) {
            // 936（002·81 根治）：成员节点.子起点=对象表达式起点（池布局实证：
            //   子起点=计（标识符）·-1 位=类型节点 22）——原 -1 取位永指错节点=
            //   本检查自 575-a 立项以来从未生效（宽松放行）
            节点 调对象 = 池.元素(被调节点.子起点);
            如果 (调对象.类型 == 节点_标识符) {
                整64 dbg类型 = 表查找类型ID(符号表, 整64(调对象.文本));
                整64 dbg类节点 = 查类节点索引(dbg类型);
