// CN 自举编译器 v2 · 语义检查表达式（R3 千行拆分，2026-09-08）
// 职责：检查表达式 的三大分支族——标识符（含限定名解析）/下标/调用
//   （含限定调用）——自 语义检查.cn 机械搬移（零逻辑变化），检查表达式
//   主干（字面量/成员/取地址解引用/二元/三元）留原文件并分派至此。
// #1855 千行拆分（2026-11-03）：检查调用表达式 段体按职责拆四兄弟模块——
//   语义检查调用语境（418/890-a/916/894-a 入口语境族）/语义检查调用被调形态
//   （101/491+1976/927/575-a 被调形态族）/语义检查调用内置（71-a/155-a/217/
//   019/206-c/P7b/强转/474/内置直调/376+967 终态内置族）/语义检查调用决议
//   （193+951/415/432/553 主链/419-a 决议族）——纯机械搬移零逻辑变化（段体
//   逐字节保留·接线行新写），本文件收敛为分派骨架。
// 模块路径=语义检查表达式（新键基）；仅被 语义检查 消费。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（目录包名）
导入 IR;         // 容器/结果 合成名判定（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 语义检查逃逸;   // 435：lambda 引用捕获逃逸检查（返回/赋值/实参/声明位·包内兄弟）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

公开:   // 全文件公开（检查族供 语义检查 分派消费）

// 调用表达式检查（P6g 调用/类型转换 + P7b 容器构造 + 三级决议 + 内置）：
//   被调标识符节点索引在 子起点（语法层后缀链记录）。
// plans/019 阶段3b 残余（2026-09-10 第六十五轮）：调用借用纪律——①实参为
//   当前函数常量（只读）引用参数而形参为可变引用=只读借出可变拒；②同调用
//   可变引用位与常量引用位实参同基础名=互斥（语句级第一版）；③同调用同变量
//   双可变借用=别名可变冲突拒（202·宿主阶段3b 同规则）。被调键基取签名表首
//   候选（重载族精确决议在 IR 层=诚实边界）。
// 实现=语义检查实参.cn 检查调用借用纪律＋借用位扫描202（806/202 轮迁移——
//   实参检查族单一归属；原实现逐字迁入，双可变判定经公共扫描统一）。

// plans/019 阶段3b（2026-09-10）：声明位转移中标志——检查变量声明语句 识别
//   声明初始化位 转移(容器/类) 时置位（区间检查期间），检查调用表达式 的
//   「拥有资源类型仅声明位」分级据此放行（v2 豁免模型浅交接：IR 生成层
//   调用特判=实参值压栈+生成声明 按值 Store=句柄拷贝+调用初值 RAII 豁免
//   ——零 IR 改动即浅交接）
静态 布尔 声明位转移中 = 假;

// 491：装箱语境+构造器期望类型族（设/取装箱语境884·函数末形参类型ID570·
//   构造器自然类型570·泛型函数实参期望类型570·实参位期望类型894）已纯机械
//   搬移「语义检查表达式中.cn」头部（函数体逐字保留·零逻辑变化——目标文件
//   内消费点之前放置，本文件已超 900 行警戒线先拆再加纪律执行）。

// B2（#1360 结果化）：返回 结果<整64, 整32>——正常(类型ID)=推导成功（终态
//   驻留("整64") 常态近似仍正常）；错误(1)=已诊断错误（原 0 路径·直接中止面）；
//   错误(2)=未声明/已诊断拒绝（原 -1 路径·上层按未知类型继续面）。
函数 检查调用表达式(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 结果<整64, 整32> {
    节点 n = 池.元素(节点索引);
    检查调用实参数组置位(池, n, 节点索引, 符号表);   // 418：数组名实参=退化指针·def-init 状态表置位（实现=语义检查调用语境.cn）
    // 435：lambda 引用捕获逃逸——调用实参位检查（逐实参区间扫描·实参末位经
    //   语法层定位表——实参定位走表（418 先例·#1872 后子终点=参数段末区间）；被调位排除=
    //   同帧调用合法面·706/707。宿主 checkCallArgs 同构，实现=语义检查逃逸.cn）
    检查调用实参lambda逃逸(池, n, 节点索引, 符号表, 诊断, 引用lambda变量们);  // 486：主表
    检查引用实参左值(池, 节点索引, 符号表, 诊断);   // 623：引用实参须左值（宿主 wrapRefArgs 同判据·五路径统一入口·实现=语义检查实参.cn）
    检查绑定方法值实参806(池, 节点索引, 符号表, 诊断);   // 806：实例方法作值不可直接作调用实参（宿主 argIsBoundMethodValue 同面·普通/方法/构造三面覆盖）
    检查容器方法调用(池, 节点索引, 符号表, 诊断);   // 907：容器实例成员方法三段检查（方法名不存在/实参个数不符/实参类型不可隐式转换——宿主 checkMemberCallCore/checkInstanceMethodCall 同面·实现=语义检查容器方法.cn）
    检查实例方法调用907(池, 节点索引, 符号表, 诊断);   // 907 同族收口：用户类/接口实例方法三段检查+实例.静态方法()/接口名.方法() 两纪律（宿主 checkInstanceMethodCall/checkInterfaceMethodCall 同面·崩溃式拒绝与静默放行面根治·实现=语义检查实例方法.cn）
    检查类调用借用纪律202(池, 节点索引, 符号表, 诊断);   // 202：同调用双可变借用互斥·构造/成员方法面（宿主 checkConstRefBorrowDiscipline 阶段3b 同面；普通函数面=检查调用借用纪律 覆盖）
    整64 调用起点 = 整64(n.子起点);
    如果 (调用起点 > 0) {
        节点 被调节点 = 池.元素(整32(调用起点));
        检查外部函数边界(被调节点, 诊断);   // 101：外部函数调用不安全边界（实现=语义检查调用被调形态.cn）
        检查方法实参构造器语境(池, n, 节点索引, 被调节点, 符号表, 诊断);   // 890-a：方法调用实参位构造器语境校正（实现=语义检查调用语境.cn）
        检查容器写方法全局写(池, 被调节点, 符号表, 诊断);   // 916：方法调用形态全局写执法（实现=语义检查调用语境.cn）
        检查函数实参构造器语境(池, n, 节点索引, 被调节点, 诊断);   // 894-a：普通函数实参位构造器语境覆盖（实现=语义检查调用语境.cn）
        // 413-b（审查 P1-2）：实参传参面「类→接口」转换检查（被调=裸标识符
        //   函数形态——成员方法面随逐参诚实边界后续统一收口）
        如果 (被调节点.类型 == 节点_标识符 && n.附加 >= 1) {
            检查接口形参实参转换(池, 节点索引, 符号表, 诊断);
        }
        如果 (被调节点.类型 == 节点_成员) {   // 491/1976：成员被调函数指针字段+字段当方法调（实现=语义检查调用被调形态.cn）
            可选<整64> 成员被调果 = 检查成员被调函数指针(池, n, 节点索引, 调用起点, 被调节点, 符号表, 诊断);
            如果 (成员被调果.有值) { 返回 正常(成员被调果.值); }
        }
        可选<整64> 复合被调果 = 检查复合被调函数指针(池, n, 节点索引, 被调节点, 符号表, 诊断);   // 927：复合被调（内层调用返回 fnptr·实现=语义检查调用被调形态.cn）
        如果 (复合被调果.有值) { 返回 正常(复合被调果.值); }
        可选<整64> 方法面果 = 检查方法调用面(池, n, 节点索引, 调用起点, 被调节点, 符号表, 诊断);   // 575-a/936/272/1029/602/907：方法调用面（实现=语义检查调用被调形态.cn）
        如果 (方法面果.有值) { 返回 正常(方法面果.值); }
        如果 (被调节点.类型 == 节点_标识符) {
            整64 被调名 = 整64(被调节点.文本); 字符串 被调文本 = 字符串复制(驻留文本(被调名));
        // 71-a：装箱构造 正常()/错误()/某些()——实现=语义检查调用内置.cn 检查装箱构造调用
        如果 (字符串比较(被调文本, "正常") || 字符串比较(被调文本, "错误") ||
             字符串比较(被调文本, "某些")) {
            结果<整64, 整32> 构造出口果 = 检查装箱构造调用(池, n, 节点索引, 符号表, 诊断, 被调文本);
            如果 (构造出口果.正常) { 整64 构造型203 = 构造出口果.值; 返回 正常(构造型203); } 否则 { }
            返回 错误(2);
        }
        检查标识符副作用内置(池, n, 节点索引, 符号表, 诊断, 被调文本);   // 155-a 裸释放+217 新线程可搬运（继续链·实现=语义检查调用内置.cn）
        可选<整64> 终态内置果 = 检查标识符终态内置(池, n, 节点索引, 调用起点, 符号表, 诊断, 被调名, 被调文本);   // 019 转移/206-c 复制/P7b 容器/强转白名单（命中即终态·实现=语义检查调用内置.cn）
        如果 (终态内置果.有值) { 返回 正常(终态内置果.值); }
        // 函数调用：查符号表（符号_函数 附加=返回类型ID）
        // plans/018 第 3 层：表查找类型ID 内部已三级化（①②③）——命中
        //   用户函数时把决议键基写入 调用决议键基们（语义驱动 IR：第 4 层
        //   决议函数符号 据此锁定候选模块桶，宿主 resolvedSignature 同构）
        // T69（480-a 深度机）：函数指针间接调用——被调标识符声明类型是函数指针
        //   时优先于「函数调用」分支（宿主 semantic_call.cpp:185-204 先直接函数名、
        //   失败后 checkExpr(callee)→checkFuncPtrCall 同序）；否则指针变量会被
        //   当普通函数登记决议键基（错决议）。结果类型=签名返回类型。
        可选<整64> 类型名调用果 = 检查标识符类型名调用(n, 节点索引, 符号表, 诊断, 被调名, 被调文本);   // 193 接口/抽象类构造拒+951 用户类构造（实现=语义检查调用决议.cn）
        如果 (类型名调用果.有值) { 返回 正常(类型名调用果.值); }
        结果<整64, 整32> 泛型隐式果 = 检查泛型隐式推导调用(池, n, 节点索引, 被调节点, 符号表, 诊断, 被调文本);   // 415 泛型隐式推导（正常(0)=未改写继续·实现=语义检查调用决议.cn）
        如果 (泛型隐式果.正常) {
            整64 推导返回415 = 泛型隐式果.值;
            如果 (推导返回415 != 0) { 返回 正常(推导返回415); }
        } 否则 { 返回 错误(2); }   // 错误(1)=实参全可靠面推导失败（已诊断拒绝·原文 627 同面）
        可选<整64> 间接被调果 = 检查函数指针间接被调(池, n, 节点索引, 符号表, 诊断, 被调名, 被调文本);   // 432：函数符号优先于函数指针变量（实现=语义检查调用决议.cn）
        如果 (间接被调果.有值) { 返回 正常(间接被调果.值); }
        可选<整64> 决议链果 = 检查函数决议链(池, n, 节点索引, 调用起点, 符号表, 诊断, 被调名, 被调文本);   // 553 非函数被调+决议登记+借用纪律+549 实参转换（实现=语义检查调用决议.cn）
        如果 (决议链果.有值) { 返回 正常(决议链果.值); }
            // 呈报③方案A（2026-09-06）：签名键改造后纯名查不到——按签名表同名候选回退
            //   （精确决议在 IR 层）；plans/018 第 3 层：回退键基化（三级决议）。
            //   203-a：段提取为 检查签名键回退（-1=未决议哨兵，主函数继续内置/限定/未声明链）。
            可选<整64> 回退类型查 = 检查签名键回退(池, n, 节点索引, 符号表, 诊断, 被调名);
            如果 (回退类型查.有值) {
                // 549：实参→形参转换检查（签名回退面·同上）
                检查调用实参转换(池, 节点索引, 符号表, 诊断);
                整64 回退类型553 = 回退类型查.值;
                返回 正常(回退类型553);
            }
        // ③ 第一波（2026-09-03）：内置函数调用（驻留/字符串族/运行时错误——
        //   IR 层映射 ASCII 运行时符号直调）；类型大小(类型) 编译期折叠 -> 整64
        如果 (字符串比较(被调文本, "回绕加") || 字符串比较(被调文本, "回绕减") ||
             字符串比较(被调文本, "回绕乘")) {
            结果<整64, 整32> 回绕果 = 检查回绕调用(池, n, 节点索引, 符号表, 诊断);   // 474：回绕内置终态（实现=语义检查调用内置.cn）
            如果 (回绕果.正常) { 返回 正常(回绕果.值); } 否则 { 返回 错误(回绕果.错误); }
        }
        // #1674 甲案：摘除 内置（拥有槽释放+清槽·宿主 checkRemoveBuiltinCall
        //   同构——有值=已处理返回 空类型；无值=非摘除调用续走原链）
        可选<整64> 摘除类型查1674 = 检查摘除内置1674(池, n, 节点索引, 符号表, 诊断);
        如果 (摘除类型查1674.有值) { 返回 正常(摘除类型查1674.值); }
        可选<整64> 内置直调果 = 检查内置直调(池, n, 节点索引, 符号表, 诊断, 被调文本);   // 内置返回+930 限定名让位+个数/变参/格式化/析构释放执法接线（实现=语义检查调用内置.cn）
        如果 (内置直调果.有值) { 返回 正常(内置直调果.值); }
        可选<整64> 类型大小果 = 检查类型大小调用(池, n, 节点索引, 调用起点, 符号表, 诊断, 被调文本);   // 376+967：类型大小参数清单拒+编译期折叠（实现=语义检查调用内置.cn）
        如果 (类型大小果.有值) { 返回 正常(类型大小果.值); }
    结果<整64, 整32> 限调果 = 检查限定调用(池, 节点索引, 符号表, 诊断);
    如果 (限调果.正常) { 整64 限调类型 = 限调果.值; 返回 正常(限调类型); } 否则 { }
    如果 (!限调果.正常) { 整32 限调错 = 限调果.错误; 如果 (限调错 == 2 || 限调错 == 3) { 返回 错误(2); } }   // 错误(1)=非限定分流→继续泛型链；错误(2)/(3) 原 -1 出口（内部已登记不降级）
        // 419-a（D42 波 3）：泛型函数显式实例化调用（名<实参>(...)——合成名
        //   名$实参·基名命中 泛型基类参数序（函数共用表）→放行（单态化生成
        //   供给定义）
        // 419-a 修正（越界归因）：放行必须返回**真实类型 ID**（-1 哨兵会被上层
        //   当类型索引进向量=数组越界）
        // 415（wt415）：返回类型=T 替换后的实例返回类型（原 MVP=整32——整64/
        //   浮64 返回实例语义标注错·421 只读大小<整32>->整64 打印面实录）。基
        //   函数定位（全池扫 节点_函数·894-a 同款）miss 时保守 整32（原型缺失
        //   面·不回退）；返回位指针层已并文本·克隆体登记段同源。
        可选<整64> 泛序查exp = 查泛型基类参数序(驻留(剥实例基名(被调文本))); 整64 泛序IDexp = 0; 如果 (泛序查exp.有值) { 泛序IDexp = 泛序查exp.值; }   // 1541 B2：有值=泛型基函数（原 !=0 判据）
        如果 (字符串长度(剥实例基名(被调文本)) > 0 &&
             !字符串比较(剥实例基名(被调文本), 被调文本) && 泛序查exp.有值) {
            结果<整64, 整32> 泛型显式果 = 检查泛型显式实例(池, 节点索引, 符号表, 诊断, 被调文本, 泛序IDexp);   // 419-a/415/766/770：泛型显式实例化（实现=语义检查调用决议.cn）
            如果 (泛型显式果.正常) { 整64 显式类型 = 泛型显式果.值; 返回 正常(显式类型); }   // 子函数全路正常（纯搬移不变式）
        }
        // -2 = 使用点歧义（E0659 已在三级决议内经缓冲诊断）——不重复报
        如果 (三级键基查找(符号表, 被调名, 0 - 1) != -2) {
            表诊断(诊断, "[错误] 未声明函数: " + 被调文本);
        }
        返回 错误(2);   // 未声明/歧义（原 -1·上层按未知类型继续面）
    }
    }
    // 1960（执法一·2026-11-02）：调用终态整64兜底废除面已拆
    //   语义检查表达式终态.cn（先拆再加·本文件拆前 1183 行超 1000 冻结线）——
    //   终态前多面精确推导（容器签名表/接口表/类方法表+泛型基名回退/内置模块
    //   限定/类字段链直查/fnptr 下标被调）+推导 miss 登记内部未登记+占位继续
    //   （主收尾统一中止）=检查调用终态 单点。
    结果<整64, 整32> 终态结果 = 检查调用终态(池, 节点索引, 符号表);
    返回 终态结果;
}