// CN 自举编译器 v2 · 语义检查表达式（R3 千行拆分，2026-09-08）
// 职责：检查表达式 的三大分支族——标识符（含限定名解析）/下标/调用
//   （含限定调用）——自 语义检查.cn 机械搬移（零逻辑变化），检查表达式
//   主干（字面量/成员/取地址解引用/二元/三元）留原文件并分派至此。
// 模块路径=语义检查表达式（新键基）；仅被 语义检查 消费。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（目录包名）
导入 IR;         // 容器/结果 合成名判定（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 语义检查逃逸;   // 435：lambda 引用捕获逃逸检查（返回/赋值/实参/声明位·包内兄弟）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

公开:   // 全文件公开（检查族供 语义检查 分派消费）



// 调用表达式检查（P6g 调用/类型转换 + P7b 容器构造 + 三级决议 + 内置）：
//   被调标识符节点索引在 子起点（语法层后缀链记录）。
// plans/019 阶段3b 残余（2026-09-10 第六十五轮）：调用借用纪律——①实参为
//   当前函数常量（只读）引用参数而形参为可变引用=只读借出可变拒；②同调用
//   可变引用位与常量引用位实参同基础名=互斥（语句级第一版）；③同调用同变量
//   双可变借用=别名可变冲突拒（202·宿主阶段3b 同规则）。被调键基取签名表首
//   候选（重载族精确决议在 IR 层=诚实边界）。
// 实现=语义检查实参.cn 检查调用借用纪律＋借用位扫描202（806/202 轮迁移——
//   实参检查族单一归属；原实现逐字迁入，双可变判定经公共扫描统一）。

// plans/019 阶段3b（2026-09-10）：声明位转移中标志——检查变量声明语句 识别
//   声明初始化位 转移(容器/类) 时置位（区间检查期间），检查调用表达式 的
//   「拥有资源类型仅声明位」分级据此放行（v2 豁免模型浅交接：IR 生成层
//   调用特判=实参值压栈+生成声明 按值 Store=句柄拷贝+调用初值 RAII 豁免
//   ——零 IR 改动即浅交接）
静态 布尔 声明位转移中 = 假;

// 491：装箱语境+构造器期望类型族（设/取装箱语境884·函数末形参类型ID570·
//   构造器自然类型570·泛型函数实参期望类型570·实参位期望类型894）已纯机械
//   搬移「语义检查表达式中.cn」头部（函数体逐字保留·零逻辑变化——目标文件
//   内消费点之前放置，本文件已超 900 行警戒线先拆再加纪律执行）。


函数 检查调用表达式(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    // 418（002 收口杂项正测族·def-init 数组输出参语义对齐宿主）：数组名实参=
    //   退化指针传递（宿主传址·被调方可写）——def-init 状态表整体置位（可能
    //   被写·保守）。原缺：分割("…", ",", 片段, 4) 输出参填充后 片段[0] 读取
    //   误报「未初始化，不能读取」（35_string_ext 行127/38_tool 行266 双编译
    //   对照实录·宿主同源同绿）。置于入口=覆盖用户/导入/内置/签名回退全被调面。
    如果 (n.附加 >= 1) {
        整64 实参i418 = 0;
        当 (实参i418 < 整64(n.附加)) {
            整64 末位418 = 查调用实参末位(整64(节点索引), 实参i418);
            如果 (末位418 >= 0 && 末位418 < 整64(池.大小())) {
                节点 实参末418 = 池.元素(整32(末位418));
                如果 (实参末418.类型 == 节点_标识符) {
                    整64 实参类型418 = 表查找类型ID(符号表, 整64(实参末418.文本));
                    如果 (实参类型418 > 0 &&
                         数组长度文本(驻留文本(实参类型418)) > 0) {
                        状态写置位(符号表, 整64(实参末418.文本));
                    }
                }
            }
            实参i418++;
        }
    }
    // 435：lambda 引用捕获逃逸——调用实参位检查（逐实参区间扫描·实参末位经
    //   语法层定位表——调用节点 子终点=0 空闲须查表（418 先例）；被调位排除=
    //   同帧调用合法面·706/707。宿主 checkCallArgs 同构，实现=语义检查逃逸.cn）
    检查调用实参lambda逃逸(池, n, 节点索引, 符号表, 诊断, 引用lambda变量们);  // 486：主表
    检查引用实参左值(池, 节点索引, 符号表, 诊断);   // 623：引用实参须左值（宿主 wrapRefArgs 同判据·五路径统一入口·实现=语义检查实参.cn）
    检查绑定方法值实参806(池, 节点索引, 符号表, 诊断);   // 806：实例方法作值不可直接作调用实参（宿主 argIsBoundMethodValue 同面·普通/方法/构造三面覆盖）
    检查容器方法调用(池, 节点索引, 符号表, 诊断);   // 907：容器实例成员方法三段检查（方法名不存在/实参个数不符/实参类型不可隐式转换——宿主 checkMemberCallCore/checkInstanceMethodCall 同面·实现=语义检查容器方法.cn）
    检查实例方法调用907(池, 节点索引, 符号表, 诊断);   // 907 同族收口：用户类/接口实例方法三段检查+实例.静态方法()/接口名.方法() 两纪律（宿主 checkInstanceMethodCall/checkInterfaceMethodCall 同面·崩溃式拒绝与静默放行面根治·实现=语义检查实例方法.cn）
    检查类调用借用纪律202(池, 节点索引, 符号表, 诊断);   // 202：同调用双可变借用互斥·构造/成员方法面（宿主 checkConstRefBorrowDiscipline 阶段3b 同面；普通函数面=检查调用借用纪律 覆盖）
    整64 调用起点 = 整64(n.子起点);
    如果 (调用起点 > 0) {
        节点 被调节点 = 池.元素(整32(调用起点));
        // 101（1023·plans/023 §八 A4 v2 挂点补齐·008 序②）：**外部函数调用**
        //   （FFI=C 边界·类型安全不保证·Rust extern 块同 unsafe-only）——被调
        //   名∈外部函数名集合（957 通道解析期登记）。文案与宿主逐字一致。
        如果 (被调节点.类型 == 节点_标识符 &&
              是外部函数名957(整64(被调节点.文本))) {
            错误不安全边界(诊断, "外部函数调用",
                         字符串复制(驻留文本(整64(被调节点.文本))));
        }
        // 890-a（002 攻族·537 D 段根治）：**方法调用实参位构造器语境校正**——
        //   实参=紧邻构造器调用（后缀池布局：实参根节点=调用节点索引-1）且被调
        //   方法**末形参**类型（实例化替换后）为 结果/可选 时，按末形参类型
        //   **覆盖**该构造器节点标注（n.子终点）。原缺口=实参位构造器继承外层
        //   语境（声明位/返回位=外层类型）：537 D 段 `表.追加(正常(31))` 中
        //   正常(31) 被标为 结果$空类型$整32（=追加 的**返回**类型）而非形参
        //   T=结果$整32$整32 → 装箱载荷偏移错（值写@+8 应@+4）→ 元素(0).值
        //   读错位。Rust 对照=实参期望类型下推（Expectation::ExpectHasType(形参)）。
        //   时机：外层调用节点（索引大）在实参构造器（索引小）**之后**被线性
        //   遍历 → 此处覆盖；IR 生成装箱构造 生成期读标注消费（节点标注幂等
        //   复用机制不受影响·887-a）。签名表/实例名设施=语义层既有先例（609
        //   判定 确保签名已加载/查签名返回 同源·IR签名/IR容器 公开函数）。
        如果 (被调节点.类型 == 节点_成员 && 被调节点.子起点 > 0 &&
             n.附加 >= 1 && 整64(节点索引) > 1) {
            节点 对象d890 = 池.元素(整32(被调节点.子起点));
            如果 (对象d890.类型 == 节点_标识符) {
                整64 对象类型d890 = 表查找类型ID(符号表, 整64(对象d890.文本));
                如果 (对象类型d890 > 0) {
                    字符串 对象类型名d890 = 字符串复制(驻留文本(对象类型d890));
                    字符串 基名d890 = 合成名基名(对象类型名d890);
                    // 基名 != 全名 = 实例合成名（$ 段存在）——仅容器实例面
                    如果 (字符串长度(基名d890) > 0 &&
                         !字符串比较(基名d890, 对象类型名d890)) {
                        确保签名已加载();
                        整64 键d890 = 驻留(基名d890 + "." +
                                      字符串复制(驻留文本(整64(被调节点.文本))) +
                                      "." + 整数转字符串(整64(n.附加)));
                        整64 参串d890 = 查签名参数串(键d890);
                        如果 (参串d890 >= 0) {
                            向量<字符串> 实参们d890 = 取实例实参们(对象类型名d890);
                            字符串 序串d890 = "";
                            整64 序IDd890 = 查类类型参数(驻留(基名d890));
                            如果 (序IDd890 >= 0) {
                                序串d890 = 字符串复制(驻留文本(序IDd890));
                            }
                            字符串 实例参串d890 = 替换类型参数带段们(
                                字符串复制(驻留文本(参串d890)), 序串d890, 实参们d890);
                            // 末形参提取（右起首个逗号后段——紧邻调用节点的
                            //   实参根=最后一个实参·替换后 $ 段形态无内嵌逗号）
                            整64 长e890 = 字符串长度(实例参串d890);
                            整64 逗位e890 = 0 - 1;
                            整64 扫e890 = 长e890 - 1;
                            当 (扫e890 >= 0) {
                                如果 ((整64(实例参串d890[整32(扫e890)]) & 255) == 44) {
                                    逗位e890 = 扫e890;
                                    中断;
                                }
                                扫e890--;
                            }
                            字符串 末形参d890 = 实例参串d890;
                            如果 (逗位e890 >= 0) {
                                末形参d890 = 字符串子串(实例参串d890,
                                    整32(逗位e890 + 1), 整32(长e890 - 逗位e890 - 1));
                            }
                            如果 (是结果类型(末形参d890)) {
                                节点 实参根d890 = 池.元素(节点索引 - 1);
                                如果 (实参根d890.类型 == 节点_调用 &&
                                     实参根d890.子起点 > 0) {
                                    节点 实参被调d890 = 池.元素(
                                        整32(实参根d890.子起点));
                                    如果 (实参被调d890.类型 == 节点_标识符) {
                                        字符串 实参名d890 = 字符串复制(
                                            驻留文本(整64(实参被调d890.文本)));
                                        如果 (字符串比较(实参名d890, "正常") ||
                                             字符串比较(实参名d890, "错误") ||
                                             字符串比较(实参名d890, "某些")) {
                                            实参根d890.子终点 = 整32(驻留(末形参d890));
                                            结果<空类型, 整32> 设标d890 =
                                                池.设置(节点索引 - 1, 实参根d890);
                                            如果 (!设标d890.正常) { 运行时错误(4); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        // 916（791 派生·P1 安全面·001 §747-8 通用全局写执法·双侧同构）：
        //   **方法调用形态**的全局写——接收者根对象∈可变全局集合（顶层静态/
        //   裸全局=全局静态名ID们；函数内静态局部=静态局部名ID们）且被调
        //   方法∈容器写方法白名单（追加/设置/清空/删除/插入/弹出…·stdlib/
        //   容器.cn+映射集合.cn 实际 API 逐一对表·宁全勿漏）→ 与 791 赋值链
        //   同规则拦截（791 只锁 下标/成员 赋值链=方法调用这一非赋值链写法
        //   静默绕过·运行真写实证；实现=语义检查赋值.cn 兄弟模块 是容器写
        //   方法916/写目标根名791·本文件 900 行警戒线：新增功能外移纪律）。
        //   读方法（大小/容量/元素/读取/获取/包含…）不入表=不拦；局部链/
        //   形参链根名不命中天然放行，不安全 函数内豁免（错误不安全边界
        //   内建）。接收者根名解析复用 写目标根名791（标识符/下标/成员链
        //   同语义——原点.桶.追加()/表[0].追加() 根=原点/表）。宿主
        //   semantic_call.cpp 916 挂点同表同文案（零分叉）。
        如果 (被调节点.类型 == 节点_成员 && 被调节点.子起点 > 0 &&
            是容器写方法916(字符串复制(驻留文本(整64(被调节点.文本))))) {
            整64 根916 = 写目标根名791(池, 池.元素(整32(被调节点.子起点)));
            如果 (根916 != 0 &&
                (是全局静态名(根916) || 是静态局部名(根916))) {
                错误不安全边界(诊断, "静态变量写", "静态变量赋值");
            }
        }
        // 894-a（070·G-N 特性波3）：**普通函数**实参位构造器语境覆盖（408 u6
        //   `取值(正常(41))`——890 容器实例面的姊妹段·其诚实边界「实参位语境
        //   通用化」本波清偿）：被调=裸标识符函数名 → **全池扫描** 节点_函数
        //   （池=解析完成全树·无前向引用限制）取末形参类型文本，末实参根=
        //   调用节点-1（紧邻·池布局惯例）为 正常/错误/某些 构造调用时按末
        //   形参覆盖装箱标注（Rust Expectation::ExpectHasType(形参) 对照·
        //   载荷偏移随类型定·原继承外层语境=890 同族错位根因）。
        如果 (被调节点.类型 == 节点_标识符 && n.附加 >= 1 && 整64(节点索引) > 1) {
            整64 扫f894 = 0;
            当 (扫f894 < 整64(池.大小())) {
                节点 函f894 = 池.元素(整32(扫f894));
                如果 (函f894.类型 == 节点_函数 &&
                     整64(函f894.文本) == 整64(被调节点.文本) &&
                     函f894.子起点 < 函f894.子终点) {
                    // 末形参类型（762 正扫根治：参数区间=子起点起连续
                    //   节点_类型/节点_参数·遇首个体语句节点停——原「子终点-1
                    //   直取末参」在体非空布局（单语句体不入块直接续排·t6）
                    //   下命中体末语句→静默放弃覆盖=判别3 同族区间错位。
                    //   570 分支 函数末形参类型ID570 同款判定·同构降合并冲突）
                    整64 末参位894 = 0 - 1;
                    整64 扫参894 = 整64(函f894.子起点);
                    当 (扫参894 < 整64(函f894.子终点) && 扫参894 < 整64(池.大小())) {
                        节点 参段894 = 池.元素(整32(扫参894));
                        如果 (参段894.类型 != 节点_参数 && 参段894.类型 != 节点_类型) { 中断; }
                        如果 (参段894.类型 == 节点_参数) { 末参位894 = 扫参894; }
                        扫参894++;
                    }
                    // 守卫前置（569 同族防线）：无参数命中（末参位=-1）禁池索引
                    如果 (末参位894 >= 0) {
                        节点 末参f894 = 池.元素(整32(末参位894));
                        如果 (末参f894.类型 == 节点_参数 && 末参f894.附加 > 0 &&
                             末参f894.附加 < 整64(池.大小())) {
                        节点 末参类型节点f894 = 池.元素(整32(末参f894.附加));
                        字符串 末形参f894 = 字符串复制(
                            驻留文本(整64(末参类型节点f894.文本)));
                        如果 (是结果类型(末形参f894)) {
                            节点 实参根f894 = 池.元素(节点索引 - 1);
                            如果 (实参根f894.类型 == 节点_调用 &&
                                 实参根f894.子起点 > 0) {
                                节点 实参被调f894 = 池.元素(
                                    整32(实参根f894.子起点));
                                如果 (实参被调f894.类型 == 节点_标识符) {
                                    字符串 实参名f894 = 字符串复制(
                                        驻留文本(整64(实参被调f894.文本)));
                                    如果 (字符串比较(实参名f894, "正常") ||
                                         字符串比较(实参名f894, "错误") ||
                                         字符串比较(实参名f894, "某些")) {
                                        实参根f894.子终点 = 整32(驻留(末形参f894));
                                        结果<空类型, 整32> 设标f894 =
                                            池.设置(节点索引 - 1, 实参根f894);
                                        如果 (!设标f894.正常) { 运行时错误(4); }
                                    }
                                }
                            }
                        }
                        }
                    }
                    中断;   // 同名函数唯一（CN 无重载）——命中即止
                }
                扫f894++;
            }
        }
        // 413-b（审查 P1-2）：实参传参面「类→接口」转换检查（被调=裸标识符
        //   函数形态——成员方法面随逐参诚实边界后续统一收口）
        如果 (被调节点.类型 == 节点_标识符 && n.附加 >= 1) {
            检查接口形参实参转换(池, 节点索引, 符号表, 诊断);
        }
        // 491（742d 面外·宿主同形态全过=零分叉收口）：**成员被调**（对象.字段
        //   ——结构体函数指针字段，001 §5.8 甲案声明位全集④）返回类型推导——
        //   字段类型（推导成员类型ID 父链：标识符/成员/调用 对象形态）为函数
        //   指针形态时按 fnptr 签名返回（IR 层 查被调函数指针签名480 成员扩展
        //   同源对齐·宿主 ir_call.cpp funcPtrTypeOfCallee 成员面）。原缺=推断
        //   声明「变量 r = w.fn(3, 4)」类型未登记 → 下方 r.x 字段偏移 -1 崩
        //   （probe491_p_c 实录：IR 层「成员字段偏移未知: .x」中止）。静默
        //   诊断副本吸收推导过程的指针成员访问边界诊断（不重复报）。
        如果 (被调节点.类型 == 节点_成员) {
            向量<字符串> 静默491 = 向量<字符串>();
            整64 字段类型ID491 = 推导成员类型ID(池, 整32(调用起点), 符号表,
                                                 静默491);
            如果 (字段类型ID491 > 0 &&
                是函数指针类型文本(字符串复制(驻留文本(字段类型ID491)))) {
                返回 检查函数指针调用480(池, n, 节点索引, 诊断,
                    字符串复制(驻留文本(整64(被调节点.文本))),
                    字符串复制(驻留文本(字段类型ID491)));
            }
        }
        // 927（复合被调 造句柄()(3,4)·491 同构延伸·001 §5.8 间接调用被调=
        //   任意 fnptr 表达式）：**被调=调用表达式结果**（内层调用返回函数指针
        //   再被调）——内层被调=标识符时其符号表类型ID=函数返回类型（函数返回
        //   fnptr 时=函数指针文本·432 同源）→ 按 fnptr 调用推导返回（检查函数
        //   指针调用480 同构消费·IR 层 查被调函数指针签名480 调用分支同源
        //   对齐·宿主 ir.cpp funcPtrTypeOfCallee 调用节点分支）。原缺=推断声明
        //   「变量 r = 造句柄()(3,4)」类型未登记 → r.x 字段偏移 -1 崩
        //   （p927s 实录：[ir2] 成员字段偏移未知: .x/.y）。内层被调=成员/下标
        //   等更深形态维持诚实边界（零行为变化）。
        //   882 门禁注记：索引守卫/表命中比较归入命名布尔（条件外显·非阈值）。
        布尔 被调是调用927 = 被调节点.类型 == 节点_调用;
        布尔 内被调位有效927 = 被调节点.子起点 != 0 &&
                              整32(被调节点.子起点) < 整32(池.大小());
        如果 (被调是调用927 && 内被调位有效927) {
            节点 内被调927 = 池.元素(整32(被调节点.子起点));
            如果 (内被调927.类型 == 节点_标识符) {
