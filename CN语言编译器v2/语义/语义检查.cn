// CN 自举编译器 v2 · 语义检查（千行拆分子模块，2026-09-08 用户裁决阶段目录包）
// 职责：逐节点语义检查（成员偏移标注/检查表达式/检查语句/检查块/检查如果/
//   检查当/检查函数）——自 语义分析.cn 机械搬移；符号表经参数传递，模块
//   解析表经 公开: 访问函数（语义分析 主干）；模块路径=语义检查（新键基）。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（原 导入 语法分析，目录包名）
导入 IR;         // 容器/结果 合成名判定 + 节点_*/键位移 常量（目录包名）
导入 借出检查;    // 第七十七轮 A21：借出视图生命周期检查（函数级调用）

公开:   // 全文件公开（检查族+主流程供 包/主.cn 消费）

// 55-c 方案A（2026-09-10 第五十六轮 用户裁决，Rust E0308 对齐）：返回面混合
//   符号检查的当前函数返回类型名ID（节点_函数.附加，解析层经 驻留(返回类型名)
//   登记；引用后缀名「整64&」非整数族自动跳过）。检查函数 进入时设置/返回时
//   复位 -1；文件级静态——检查函数 与 检查语句 同文件（R3 拆分纪律）。
静态 整64 当前函数返回类型 = 0 - 1;
// plans/019 阶段2：当前函数引用参数名集（返回逃逸检查的豁免判定——引用参数
//   指向调用方存储，返回 &引用参数 合法；宿主 isRefParamForCurrentFn 对齐）
静态 向量<整64> 当前函数引用参数们;
// plans/019 阶段3：当前函数 常量 只读引用参数名集（赋值面只读纪律）
静态 向量<整64> 当前函数常量引用们;
// 153-a（plans/023 §八 v2 挂点基础设施）：**当前函数不安全修饰**——真=本函数为
//   不安全 函数（节点_函数.修饰==1，解析层回填）；检查函数 进入时设置/返回时复位。
//   9 类安全区边界挂点（指针算术/解引用读/解引用写/指针下标读/指针下标写/指针成员
//   访问/联合体字段/静态变量写/外部函数调用/裸释放）在 不安全 函数内豁免——与宿主
//   warnUnsafeBoundary 的 currentFnUnsafe_ 同构（plans/023 §八.2 双侧同构）。
静态 布尔 当前函数不安全 = 假;

// 155-a（plans/023 §八 B10 v2 挂点）：**顶层静态变量名ID集**——声明收集
//   （语义分析.cn 节点_静态声明 分支）追加；检查赋值语句 据此报「静态变量写」
//   （静态登记种类=符号_变量与普通变量同款，种类不可区分——名集合单点事实源）。
静态 向量<整64> 全局静态名ID们;
// 155-a：名ID 是否顶层静态（B10 判定）
函数 是全局静态名(整64 名ID) -> 布尔 {
    整64 i = 0;
    当 (i < 全局静态名ID们.大小()) {
        如果 (全局静态名ID们.元素(整32(i)) == 名ID) { 返回 真; }
        i++;
    }
    返回 假;
}

// 156-a（plans/023 §八）：**当前函数不安全 设置访问器**——静态变量文件级私有，
//   语义检查类.cn（类方法检查）跨文件经本访问器设置（检查方法 读 节点_方法.修饰）。
不安全 函数 设当前函数不安全(布尔 值) -> 空类型 {
    当前函数不安全 = 值;
}

// 575-a（T100·299）：当前方法常量槽——常量 成员函数内修改成员检查上下文
//   （语义检查类.cn 检查方法 设/清；检查赋值语句 消费）。静态变量文件级
//   私有·访问器同 设当前函数不安全 惯例。
静态 布尔 当前方法常量 = 假;

不安全 函数 设当前方法常量(布尔 值) -> 空类型 {
    当前方法常量 = 值;
}

不安全 函数 读当前方法常量() -> 布尔 {
    返回 当前方法常量;
}

// 155-a（A1 v2 挂点）：是否**裸指针类型文本**（以 * 结尾）——`字符*` 是
//   字符串视图（波 1 教训：isStringSemanticType 同族）排除；数组类型文本
//   （X[N]）不以 * 结尾天然不命中。
函数 是裸指针类型文本(字符串 类型文本) -> 布尔 {
    整64 长 = 字符串长度(类型文本);
    如果 (长 <= 0) { 返回 假; }
    如果 (字符串比较(类型文本, "字符*")) { 返回 假; }
    字符 末c = 类型文本[长 - 1];
    返回 末c == '*';
}

// 154-a（plans/023 §八 v2 挂点）/ 157-a（§十 步骤 5 收口）：**安全区边界错误**
//   ——宿主 reportUnsafeBoundary 的 v2 同构（当前函数不安全 时零诊断；文案
//   与宿主逐字一致=双侧同构；收口后=硬错误，观察期字样已删）。
函数 错误不安全边界(向量<字符串>& 诊断, 字符串 类别, 字符串 明细) -> 空类型 {
    如果 (当前函数不安全) { 返回; }
    // 470-a：泛型基类体重放语境豁免——T* 形态安全性取决于实参类型（静态不可
    //   判定）·对齐宿主重放诊断回滚效果（455 T* 下标先例·波2 单态化收口）
    如果 (取重放豁免安全区()) { 返回; }
    表诊断(诊断, "[安全区边界] " + 类别 + "应在 不安全 函数 内（" + 明细 + "）");
}

// ==================== 188-a（D6·plans/023 B11 变量常量传播）恒空指针判定表 ====================
//   背景：B11 原判据=操作数为 `无` 字面量；plans/023 §九 已批准定义含「编译期
//   常量」形态（`整64* p = 无; 整64 v = *p;`）——本表把它落实（宿主 semantic
//   nullSeeded_/nullDisqualified_/nullAssignEdges_/nullUseSites_ 同构）。
//   判定（保守·零假阳性）：变量 v 判「恒空」⇔ ① 至少一次以 `无` 字面量初始化/
//   赋值（种子，含经初始化/赋值传播自另一恒空变量——边不动点）∧ ② 全函数内无
//   任何其他写入（失格：非 `无` 赋值/复合赋值/自增自减/取地址/引用参数实参）。
//   使用点延迟登记，函数/方法体检查收尾统一判定并报硬错误（编译期零运行期开销；
//   Rust deref_nullptr lint 同构）。表为文件级静态 + 访问器跨子模块共享。
静态 向量<整64> 恒空种子们;
静态 向量<整64> 恒空失格们;
静态 向量<整64> 恒空边目标们;
静态 向量<整64> 恒空边源们;
静态 向量<整64> 恒空使用点名们;
静态 向量<整64> 恒空使用点行们;
静态 向量<整64> 恒空使用点面们;   // 1=解引用 2=成员访问 3=下标访问

函数 恒空名含(向量<整64> 名们, 整64 名ID) -> 布尔 {
    整64 i = 0;
    当 (i < 整64(名们.大小())) {
        如果 (名们.元素(整32(i)) == 名ID) { 返回 真; }
        i++;
    }
    返回 假;
}

函数 是恒空候选类型文本(字符串 类型文本) -> 布尔 {
    // 指针（尾 *：含 整64*/字符*/多级指针）或 字符串（视图含空值）——恒空判定面
    整64 长 = 字符串长度(类型文本);
    如果 (长 <= 0) { 返回 假; }
    字符 末c = 类型文本[长 - 1];
    如果 (末c == '*') { 返回 真; }
    如果 (字符串比较(类型文本, "字符串")) { 返回 真; }
    返回 假;
}

不安全 函数 登记恒空种子(整64 名ID) -> 空类型 {
    如果 (恒空名含(恒空种子们, 名ID)) { 返回; }
    结果<空类型, 整32> 加 = 恒空种子们.追加(名ID);
    如果 (!加.正常) { 运行时错误(4); }
}

不安全 函数 登记恒空失格(整64 名ID) -> 空类型 {
    如果 (恒空名含(恒空失格们, 名ID)) { 返回; }
    结果<空类型, 整32> 加 = 恒空失格们.追加(名ID);
    如果 (!加.正常) { 运行时错误(4); }
}

不安全 函数 登记恒空边(整64 目标名ID, 整64 源名ID) -> 空类型 {
    结果<空类型, 整32> 加目 = 恒空边目标们.追加(目标名ID);
    如果 (!加目.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加源 = 恒空边源们.追加(源名ID);
    如果 (!加源.正常) { 运行时错误(4); }
}

不安全 函数 登记恒空使用点(整64 名ID, 整64 行, 整64 面) -> 空类型 {
    // 去重（同 名×行×面 视作同一使用点）：v2 语句区间线性遍历对同一 AST 节点
    //   可能二次到达（外层检查 + 区间扫描），宿主单遍无此问题——重复登记会让
    //   收尾判定同点双报（实证：d2/i2/p4 探针各报两次）
    整64 d = 0;
    当 (d < 整64(恒空使用点名们.大小())) {
        如果 (恒空使用点名们.元素(整32(d)) == 名ID &&
              恒空使用点行们.元素(整32(d)) == 行 &&
              恒空使用点面们.元素(整32(d)) == 面) {
            返回;
        }
        d++;
    }
    结果<空类型, 整32> 加名 = 恒空使用点名们.追加(名ID);
    如果 (!加名.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加行 = 恒空使用点行们.追加(行);
    如果 (!加行.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加面 = 恒空使用点面们.追加(面);
    如果 (!加面.正常) { 运行时错误(4); }
}

不安全 函数 清空恒空表() -> 空类型 {
    恒空种子们.清空();
    恒空失格们.清空();
    恒空边目标们.清空();
    恒空边源们.清空();
    恒空使用点名们.清空();
    恒空使用点行们.清空();
    恒空使用点面们.清空();
}

// 函数/方法体检查收尾：边不动点（p = q 且 q 恒空 → p 恒空）→ 使用点逐点判定 →
//   报 B11 硬错误（文案与字面量形态同族；面 1/2/3 → 解引用/成员访问/下标访问）。
不安全 函数 判定恒空报错(向量<字符串>& 诊断) -> 空类型 {
    布尔 变化 = 真;
    当 (变化) {
        变化 = 假;
        整64 e = 0;
        当 (e < 整64(恒空边目标们.大小())) {
            整64 目标e = 恒空边目标们.元素(整32(e));
            整64 源e = 恒空边源们.元素(整32(e));
            如果 (恒空名含(恒空失格们, 源e)) {
            } 否则 如果 (恒空名含(恒空种子们, 源e)) {
                如果 (!恒空名含(恒空种子们, 目标e)) {
                    结果<空类型, 整32> 加 = 恒空种子们.追加(目标e);
                    如果 (!加.正常) { 运行时错误(4); }
                    变化 = 真;
                }
            }
            e++;
        }
    }
    整32 保存行 = 取当前诊断行();
    整64 u = 0;
    当 (u < 整64(恒空使用点名们.大小())) {
        整64 名u = 恒空使用点名们.元素(整32(u));
        如果 (!恒空名含(恒空失格们, 名u)) {
            如果 (恒空名含(恒空种子们, 名u)) {
                设当前诊断行(整32(恒空使用点行们.元素(整32(u))));
                整64 面u = 恒空使用点面们.元素(整32(u));
                如果 (面u == 1) {
                    表诊断(诊断, "[错误] 编译期常量空指针解引用（确定性错误；plans/023 B11）");
                } 否则 如果 (面u == 2) {
                    表诊断(诊断, "[错误] 编译期常量空指针成员访问（确定性错误；plans/023 B11）");
                } 否则 {
                    表诊断(诊断, "[错误] 编译期常量空指针下标访问（确定性错误；plans/023 B11）");
                }
            }
        }
        u++;
    }
    设当前诊断行(保存行);
}

// plans/019 阶段2：名字是否当前函数引用参数（指向调用方存储——返回逃逸
//   豁免用；集合由 检查函数 收集，宿主 isRefParamForCurrentFn 对齐）
函数 是当前引用参数(整64 名ID) -> 布尔 {
    整64 i = 0;
    当 (i < 当前函数引用参数们.大小()) {
        如果 (当前函数引用参数们.元素(i) == 名ID) { 返回 真; }
        i++;
    }
    返回 假;
}

函数 清空当前引用参数() -> 空类型 {
    当前函数引用参数们.清空();
    当前函数常量引用们.清空();
}

// 55-c 当前函数返回类型 访问器（跨子模块读写——第七十八轮 类支持：语义检查类.cn
//   的 检查方法 需设置/复位同一静态；原为文件级私有直写）
不安全 函数 设当前函数返回类型(整64 类型ID) -> 空类型 {
    当前函数返回类型 = 类型ID;
}

函数 取当前函数返回类型() -> 整64 {
    返回 当前函数返回类型;
}

// plans/019 阶段3：名字是否当前函数常量（只读）引用参数
函数 是常量引用参数(整64 名ID) -> 布尔 {
    整64 i = 0;
    当 (i < 当前函数常量引用们.大小()) {
        如果 (当前函数常量引用们.元素(i) == 名ID) { 返回 真; }
        i++;
    }
    返回 假;
}

// ==================== 成员访问偏移标注（P6c） ====================
// 后缀栈遍历表达式区间 [起点, 终点)：标识符/字面量压类型；节点_成员 弹对象类型
//   查结构体字段偏移并写入节点.附加（IR 生成直接用）；节点_取地址/解引用 弹压类型。
// 返回 0=成功；-1=失败（类型未知/字段不存在）。
函数 标注成员偏移(向量<节点> 池, 整32 起点, 整32 终点,
                   向量<映射<整64, 符号>>& 符号表, 向量<字符串> 诊断) -> 整64 {
    向量<整64> 类型栈 = 向量<整64>();
    整32 位置 = 起点;
    当 (位置 < 终点) {
        节点 n = 池.元素(位置);
        如果 (n.类型 == 节点_标识符) {
            整64 类型ID = 表查找类型ID(符号表, 整64(n.文本));
            如果 (类型ID == -1) { 返回 -1; }
            结果<空类型, 整32> 加 = 类型栈.追加(类型ID);
            如果 (!加.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_整数字面量) {
            结果<空类型, 整32> 加 = 类型栈.追加(驻留("整32"));
            如果 (!加.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_布尔字面量) {
            // 灰色点①根治（2026-09-04）：真/假 独立节点——类型栈压 布尔
            结果<空类型, 整32> 加布 = 类型栈.追加(驻留("布尔"));
            如果 (!加布.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_浮点字面量) {
            结果<空类型, 整32> 加 = 类型栈.追加(驻留("浮64"));
            如果 (!加.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_字符串字面量) {
            结果<空类型, 整32> 加 = 类型栈.追加(驻留("字符串"));
            如果 (!加.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_成员) {
            // 成员访问：偏移已由语法层写入 n.附加；字段类型暂按 整64
            结果<空类型, 整32> 加2 = 类型栈.追加(驻留("整64"));
            如果 (!加2.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_取地址) {
            // & 对象：类型不变（地址即 整64 槽）
            结果<空类型, 整32> 加3 = 类型栈.追加(驻留("整64"));
            如果 (!加3.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_解引用) {
            // * 指针：弹指针 -> 压 整64（暂标量）
            如果 (类型栈.大小() >= 1) {
                结果<空类型, 整32> 删2 = 类型栈.删除(类型栈.大小() - 1);
                如果 (!删2.正常) { 运行时错误(4); }
            }
            结果<空类型, 整32> 加4 = 类型栈.追加(驻留("整64"));
            如果 (!加4.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_二元运算 || n.类型 == 节点_调用 || n.类型 == 节点_下标) {
            // 二元/下标：弹2压1；调用：弹实参+被调，压 整64（暂）
            如果 (n.类型 == 节点_二元运算 || n.类型 == 节点_下标) {
                如果 (类型栈.大小() >= 2) {
                    结果<空类型, 整32> 删3 = 类型栈.删除(类型栈.大小() - 1);
                    如果 (!删3.正常) { 运行时错误(4); }
                    结果<空类型, 整32> 删4 = 类型栈.删除(类型栈.大小() - 1);
                    如果 (!删4.正常) { 运行时错误(4); }
                }
            } 否则 {
                整64 弹数 = n.附加 + 1;  // 实参 + 被调
                当 (弹数 > 0 && 类型栈.大小() > 0) {
                    结果<空类型, 整32> 删5 = 类型栈.删除(类型栈.大小() - 1);
                    如果 (!删5.正常) { 运行时错误(4); }
                    弹数--;
                }
            }
            结果<空类型, 整32> 加5 = 类型栈.追加(驻留("整64"));
            如果 (!加5.正常) { 运行时错误(4); }
        }
        位置++;
    }
    返回 0;
}

// ③ 第六波（2026-09-03）：三元两分支类型可合并判定——同ID 或同类数值族宽化
//   （整数族：整8/16/32/64、正8/16/32/64、布尔、字符 互通——真/假=1/0 字面量
//   语义、字符=零扩展整数，槽统一 8 字节 Load 整64 无损；浮点族：浮32/64 互通）。
//   跨类（整 vs 浮：位模式不同 / 字符串 vs 整数：指针槽 vs 数值槽）拒绝——
//   Rust if 表达式同款纪律（无隐式跨类转换）
函数 类型可合并(整64 类型A, 整64 类型B) -> 布尔 {
    如果 (类型A == 类型B) { 返回 真; }
    字符串 名A = 字符串复制(驻留文本(类型A));
    字符串 名B = 字符串复制(驻留文本(类型B));
    布尔 A整数 = 字符串比较(名A, "整8") || 字符串比较(名A, "整16") ||
                  字符串比较(名A, "整32") || 字符串比较(名A, "整64") ||
                  字符串比较(名A, "正8") || 字符串比较(名A, "正16") ||
                  字符串比较(名A, "正32") || 字符串比较(名A, "正64") ||
                  字符串比较(名A, "布尔") || 字符串比较(名A, "字符");
    布尔 B整数 = 字符串比较(名B, "整8") || 字符串比较(名B, "整16") ||
                  字符串比较(名B, "整32") || 字符串比较(名B, "整64") ||
                  字符串比较(名B, "正8") || 字符串比较(名B, "正16") ||
                  字符串比较(名B, "正32") || 字符串比较(名B, "正64") ||
                  字符串比较(名B, "布尔") || 字符串比较(名B, "字符");
    如果 (A整数 && B整数) { 返回 真; }
    布尔 A浮点 = 字符串比较(名A, "浮32") || 字符串比较(名A, "浮64");
    布尔 B浮点 = 字符串比较(名B, "浮32") || 字符串比较(名B, "浮64");
    如果 (A浮点 && B浮点) { 返回 真; }
    返回 假;
}

// 93-a（2026-09-13 第九十三轮）：类名.成员 拒绝——用户类名直接访问实例成员。
//   宿主 93-a 同款纪律（semantic_call/semantic_expr：类名.实例方法()/类名.实例
//   字段 编译期拒绝，Rust「类名.成员 仅静态成员合法」对齐）；v2 类支持第一版
//   无静态成员（IR类.cn 第一版范围），故「用户类名.成员」任何形态皆非法——须经
//   实例（`实例.成员`）。修复前 IR 层按对象=未声明标识符退化生成（探针 M1/M3/M4
//   实证：读垃圾值 / 静默写入）。判定：对象=标识符 且 是用户类 且 非变量遮蔽
//   （变量遮蔽时按实例语义——与宿主 receiverIsTypeName 判定同款）。遮蔽判据=
//   符号种类 ∈ {符号_变量, 符号_参数}：类名自身在符号表登记为 符号_结构体
//   （种类 4——探针调试实证；若按 表查找类型ID != -1 判定会把类名自身误判为
//   变量，检查永不命中）。
//   命中即诊断（调用方继续既有路径，诊断令主链中止——不产 IR/asm）。返回 真=命中。
函数 检查类名成员访问(向量<节点> 池, 整32 成员节点索引,
                        向量<映射<整64, 符号>>& 符号表, 向量<字符串> 诊断) -> 布尔 {
    节点 m = 池.元素(成员节点索引);
    如果 (m.子起点 <= 0 || 整64(m.子起点) >= 池.大小()) { 返回 假; }
    节点 对象m = 池.元素(整32(m.子起点));
    如果 (对象m.类型 != 节点_标识符) { 返回 假; }
    如果 (!是用户类ID(整64(对象m.文本))) { 返回 假; }
    整64 种类m = 表查找种类(符号表, 整64(对象m.文本));
    如果 (种类m == 符号_变量 || 种类m == 符号_参数) { 返回 假; }
    表诊断(诊断, "[错误] 类名不能直接访问实例成员: " +
                  驻留文本(整64(对象m.文本)) + "." + 驻留文本(整64(m.文本)) +
                  "（须经实例；类名仅静态成员可直接访问——v2 类支持第一版无静态成员）");
    返回 真;
}

// 检查表达式：返回类型ID（-1=未知）；未声明标识符 -> 诊断。
//   R3 拆分（2026-09-08）：标识符/下标/调用 三大分支族分派至 语义检查表达式
//   模块（语义检查表达式.cn），本函数保留字面量/成员/取地址解引用/二元/三元。
函数 检查表达式(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串> 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    如果 (n.类型 == 节点_整数字面量) { 返回 驻留("整32"); }
    // 灰色点①根治（2026-09-04）：真/假 独立节点——类型推导 布尔（三元分支
    //   类型可合并判定 布尔∈整数族 互通不变）
    如果 (n.类型 == 节点_布尔字面量) { 返回 驻留("布尔"); }
    如果 (n.类型 == 节点_浮点字面量) { 返回 驻留("浮64"); }
    如果 (n.类型 == 节点_字符串字面量) { 返回 驻留("字符串"); }
    // 95-a（2026-09-13 第九十五轮）：字符字面量——类型 字符（值=Unicode 码点）
    如果 (n.类型 == 节点_字符字面量) { 返回 驻留("字符"); }
    如果 (n.类型 == 节点_标识符) {
        返回 检查标识符表达式(池, 节点索引, 符号表, 诊断);
    }
    如果 (n.类型 == 节点_成员) {
        返回 检查成员访问表达式(池, 节点索引, 符号表, 诊断);
    }
    如果 (n.类型 == 节点_下标) {
        返回 检查下标表达式(池, 节点索引, 符号表, 诊断);
    }
    如果 (n.类型 == 节点_取地址 || n.类型 == 节点_解引用) {
        返回 检查取地址解引用表达式(池, 节点索引, 符号表, 诊断);
    }
    如果 (n.类型 == 节点_调用) {
        返回 检查调用表达式(池, 节点索引, 符号表, 诊断);
    }
    如果 (n.类型 == 节点_二元运算) {
        返回 检查二元运算表达式(池, 节点索引, 符号表, 诊断);
    }
    如果 (n.类型 == 节点_三元运算) {
        返回 检查三元运算表达式(池, 节点索引, 符号表, 诊断);
    }
    如果 (n.类型 == 节点_错误传播) {
        返回 检查错误传播表达式(池, 节点索引, 符号表, 诊断);
    }
    返回 -1;
}

// ==================== 296-a（D35 波B·2026-09-17）错误传播检查 ====================

// 后缀错误传播 表达式? 检查（宿主 visitUnaryExpr Operator::Propagate 同构）：
//   ①操作数类型须 结果<T,E>/可选<T>（表达式类型ID 经操作数段末节点推导；
//     推导失败 -1 跳过=级联防不误伤）；②当前函数返回类型须 结果/可选（顶层
//     常量等语境 -1 跳过）；③回填 IR 标注：n.附加=操作数类型合成名ID、
//   n.文本=函数返回类型合成名ID（生成错误传播 直读——装箱构造 子终点 标注
//   同款「语义驱动 IR」模式）。返回 值类型（操作数实参1=T）名ID。
函数 检查错误传播表达式(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串> 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    // 操作数段=[子起点, 子终点)（子终点=本节点自身索引·三元同款），末节点=子终点-1
    整64 操作数类型 = -1;
    如果 (n.子终点 > n.子起点) {
        操作数类型 = 表达式类型ID(池, 整32(n.子终点 - 1), 符号表, 诊断);
    }
    如果 (操作数类型 > 0 &&
         !是结果类型(字符串复制(驻留文本(操作数类型)))) {
        表诊断(诊断, "[错误] 错误传播 ? 操作数须为 结果/可选 类型: " +
                      字符串复制(驻留文本(操作数类型)));
    }
    // 当前函数返回类型检查（-1=顶层常量等无函数语境，跳过=级联防）
    整64 返回类型ctx = 当前函数返回类型;
    如果 (返回类型ctx >= 0) {
        如果 (!是结果类型(字符串复制(驻留文本(返回类型ctx)))) {
            表诊断(诊断, "[错误] 错误传播 ? 须在返回 结果/可选 的函数中使用");
        }
    } 否则 {
        返回类型ctx = 0;
    }
    如果 (操作数类型 <= 0 || 返回类型ctx <= 0) {
        // 推导失败（级联错误语境）不标注——IR 层按缺标注诊断 fail fast
        如果 (操作数类型 > 0) { 返回 操作数类型; }
        返回 -1;
    }
    n.附加 = 整32(操作数类型);
    n.文本 = 整32(返回类型ctx);
    结果<空类型, 整32> 设传n = 池.设置(节点索引, n);
    如果 (!设传n.正常) { 运行时错误(4); }
    // 表达式值类型 = 操作数 T（实参1）——声明位同型校验消费
    返回 驻留(段首(合成名首实参(字符串复制(驻留文本(操作数类型)))));
}

// ==================== 197-a 类型分支族子方法（原 检查表达式 371~526 段） ====================

// 族①：成员访问检查（原 371~390 段）——93-a 类名.成员 拒绝 +
//   188-a（D6 B11 变量常量传播）编译期常量空指针成员访问硬错误 +
//   指针对象的变量形态使用点登记（面=成员访问）。返回 整64。
// 340-j：当前检查类ID 槽（检查类方法们 设/清·成员访问可见性豁免消费）
静态 映射<整64, 整64> 当前检查类槽;

函数 设当前检查类ID(整64 类名ID) -> 空类型 {
    结果<空类型, 整32> 设 = 当前检查类槽.设置(0, 类名ID);
    如果 (!设.正常) { 运行时错误(4); }
}

函数 取当前检查类ID() -> 整64 {
    结果<整64, 整32> 查 = 当前检查类槽.获取(0);
    如果 (查.正常) { 返回 查.值; }
    返回 0;
}

函数 检查成员访问表达式(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串> 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    // 成员访问：偏移已标注到附加；字段类型暂 整64
    // 93-a：类名.成员 拒绝（用户类名直接访问实例成员——宿主同款纪律；
    //   修复前按未声明标识符退化生成=读垃圾/静默写，探针 M3/M4 实证）
    布尔 命中类名 = 检查类名成员访问(池, 节点索引, 符号表, 诊断);
    如果 (命中类名) { }
    // 188-a（D6·plans/023 B11 变量常量传播）：`无.字段` 字面量形态（编译期
    //   常量空指针成员访问）硬错误 + 指针对象的变量形态使用点登记（面=成员访问）
    如果 (n.子起点 > 0 && 整64(n.子起点) < 池.大小()) {
        节点 对象y188 = 池.元素(整32(n.子起点));
        如果 (对象y188.类型 == 节点_整数字面量 && 对象y188.附加 == 1) {
            表诊断(诊断, "[错误] 编译期常量空指针成员访问（确定性错误；plans/023 B11）");
        } 否则 如果 (对象y188.类型 == 节点_标识符) {
            如果 (查语义指针变量(整64(对象y188.文本)) >= 0) {
                登记恒空使用点(整64(对象y188.文本), 整64(取当前诊断行()), 2);
            }
        }
    }
    // 340-a（D38 批3b·347）：类私有成员可见性设防——对象类型=类（类节点索引
    //   命中）时扫类节点子区间 节点_类字段：命中成员且 子起点=0（私有/保护段）
    //   → 拒（宿主「无法访问 成员 'x'（甲 的私有成员）」措辞对齐）。类方法体内
    //   裸名访问不经成员访问=零豁免需求（p1 实证）；方法可见性=诚实边界
    //   （347 目标形态=字段面）。
    如果 (n.子起点 > 0 && 整64(n.子起点) < 池.大小()) {
        节点 对象v = 池.元素(整32(n.子起点));
        如果 (对象v.类型 == 节点_标识符) {
            整64 对象类型v = 表查找类型ID(符号表, 整64(对象v.文本));
            如果 (对象类型v > 0) {
                整64 类节点v = 查类节点索引(对象类型v);
                如果 (类节点v >= 0 && 类节点v < 整64(池.大小())) {
                    节点 类节点值v = 池.元素(整32(类节点v));
                    整64 mv = 整64(类节点值v.子起点);
                    当 (mv < 整64(类节点值v.子终点)) {
                        节点 成员v = 池.元素(整32(mv));
                        如果 (成员v.类型 == 节点_类字段 &&
                             整64(成员v.文本) == 整64(n.文本) &&
                             整64(成员v.子起点) == 0) {
                            // 340-j：类上下文豁免——本类方法体内经 自身. 访问
                            //   私有字段=合法（50_class_private 宿主绿实证）
                            如果 (取当前检查类ID() == 对象类型v) { 中断; }
                            表诊断(诊断, "[错误] 无法访问 成员 '" +
                                          驻留文本(整64(n.文本)) + "'（" +
                                          驻留文本(对象类型v) + " 的私有成员）");
                            中断;
                        }
                        mv++;
                    }
                }
            }
        }
    }
    返回 驻留("整64");
}

// 族②：取地址/解引用检查（原 394~430 段）——188-a 取地址=恒空判定失格 +
//   76-a 解引用返回真实指向类型（查语义指针变量）+ 153-a 常量空指针解引用
//   硬错误 + 154-a B6/B7 裸指针解引用警告 + 188-a 恒空使用点登记。
//   返回 整64 兜底（复合形态=诚实边界）。
函数 检查取地址解引用表达式(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串> 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    // 188-a（D6·plans/023 B11 变量常量传播）：取地址=别名逃逸（外部可经别名
    //   改写该变量）→ 恒空判定失格（保守，防假阳性）
    如果 (n.类型 == 节点_取地址 && n.子起点 >= 0 && n.子起点 < 池.大小()) {
        节点 取址操作数188 = 池.元素(整32(n.子起点));
        如果 (取址操作数188.类型 == 节点_标识符) {
            登记恒空失格(整64(取址操作数188.文本));
            // 010（def-init）：取地址=初始化通道（地址逃逸=可能被写——Rust
            //   &mut maybe-init 同款；查方法签名(&签) 出参形态铁证）——整体置位
            状态置位标识符(符号表, 整64(取址操作数188.文本));
        }
    }
    // 76-a 后续（2026-09-12，用户裁决方案甲）：解引用返回**真实指向类型**——
    //   操作数为标识符且登记在指针变量表（查语义指针变量，指针下标 p[i] 路径
    //   同款机制）时返回所指类型；否则维持 整64 兜底（复合形态=诚实边界）。
    //   修复前恒返回 整64（「暂标量」）→ 一切经 表达式类型ID 的检查面
    //   （混合符号赋值/二元运算等）对解引用形态拿到 整64（有符号）→ 与 正8
    //   等无符号真实类型混合时漏检（实证：返回 *q; 宿主拒绝 / v2p 编译成功；
    //   修复后两侧一致拒绝——E2E 222/222_v2 锚定）
    如果 (n.类型 == 节点_解引用 && n.子起点 >= 0 && n.子起点 < 池.大小()) {
        节点 操作数d = 池.元素(整32(n.子起点));            // 153-a（plans/023 B11 v2 挂点）：**常量空指针解引用**（编译期硬错误）——
        //   操作数为「无」字面量（节点_整数字面量 附加==1，解析层标记）时确定性
        //   错误（宿主同构：*无 →「编译期常量空指针解引用」Error）。
        如果 (操作数d.类型 == 节点_整数字面量 && 操作数d.附加 == 1) {
            表诊断(诊断, "[错误] 编译期常量空指针解引用（确定性错误；plans/023 B11）");
        }
        如果 (操作数d.类型 == 节点_标识符) {
            整64 所指类型d = 查语义指针变量(整64(操作数d.文本));
            如果 (所指类型d >= 0) {
                // 154-a（B6/B7 v2 挂点）：裸指针解引用（读/写单报——plans/023
                //   §六.2「避免重复」；写面在赋值链不再二次报）
                错误不安全边界(诊断, "裸指针解引用", "指针解引用（*p）");
                // 188-a（D6 B11 变量常量传播）：恒空候选使用点登记（面=解引用）
                登记恒空使用点(整64(操作数d.文本), 整64(取当前诊断行()), 1);
                返回 所指类型d;
            }
        }
    }
    返回 驻留("整64");
}

// 族③：二元运算检查（原 434~506 段）——字符串比较拒绝（灰色点②方案A）+
//   混合符号二元拒绝（第五十一轮 方案A）+ 157-a V3 指针算术 A1 挂点全覆盖。
//   返回 -1（比较产物类型不参与下游推导）。
函数 检查二元运算表达式(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串> 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    // 灰色点②方案A（2026-09-04 用户裁决）：字符串比较运算符显式拒绝——
    //   规范 plans/001 Task 2.8（比较运算符仅整型/浮点变体，字符串不参与
    //   运算符比较；等价能力 字符串比较（相等）/字符串字典序（全序））。
    //   原按指针地址放行=同内容异地址 ==/!= 恒假（拼接产物静默陷阱）。
    //   操作数类型经区间末端节点递归推导（三元同款技巧）：普通/短路二元
    //   统一 子起点=右操作数起点、附加=左操作数起点——左末=子起点-1、
    //   右末=本节点索引-1。字面量/标识符形态可靠推导；拼接产物/成员字段
    //   推导 -1/整64 兜底=检不出（v2 类型推导既有半实现面，诚实边界——
    //   随 v2 语义类型推导完善收口，宿主侧已全形态覆盖）。返回 -1（比较
    //   产物类型不参与下游推导；三元末端为二元时原亦 -1 跳过，无回归）
    字符串 op文本 = 字符串复制(驻留文本(整64(n.文本)));
    布尔 是比较符 = 字符串比较(op文本, "==") || 字符串比较(op文本, "!=") ||
                   字符串比较(op文本, "<") || 字符串比较(op文本, ">") ||
                   字符串比较(op文本, "<=") || 字符串比较(op文本, ">=");
    // 混合符号二元运算拒绝（2026-09-10 第五十一轮 方案A 用户裁决，Rust
    //   对齐；规范 plans/001 §3.7）：检查范围自比较符扩至算术/位运算符——
    //   「变量间」整N vs 正M 诊断拒绝（检查混合符号二元，语义检查表达式
    //   模块；字面量豁免含 -1 形态；类型 -1 跳过=检不出诚实边界同上）。
    布尔 是算术位符 = 字符串比较(op文本, "+") || 字符串比较(op文本, "-") ||
                    字符串比较(op文本, "*") || 字符串比较(op文本, "/") ||
                    字符串比较(op文本, "%") || 字符串比较(op文本, "&") ||
                    字符串比较(op文本, "|") || 字符串比较(op文本, "^") ||
                    字符串比较(op文本, "<<") || 字符串比较(op文本, ">>");
    如果 ((是比较符 || 是算术位符) && n.子起点 > 0) {
        // 带诊断操作数递归限定比较符（灰色点②既有行为——诊断双报形态已
        //   被 174 等负测 expected 固化，不得扩面）；算术/位运算符的混合
        //   符号检查由 检查混合符号二元 静默自推导（零诊断副作用）
        如果 (是比较符) {
            整64 左类型比 = 检查表达式(池, 整32(n.子起点 - 1), 符号表, 诊断);
            整64 右类型比 = 检查表达式(池, 整32(节点索引 - 1), 符号表, 诊断);
            如果 (左类型比 == 驻留("字符串") && 右类型比 == 驻留("字符串")) {
                表诊断(诊断, "[错误] 字符串不支持 ==/!=/</> 比较运算符（按地址比较而非内容）——相等用 字符串比较(a,b)，全序用 字符串字典序(a,b)");
            }
        }
        检查混合符号二元(池, 整32(n.子起点 - 1), 整32(节点索引 - 1),
                        符号表, 诊断);
        // 157-a（V3 缺陷修复——A1 v2 挂点全覆盖）：**指针算术**（裸指针
        //   ± 整数）——155-a 的 A1 挂点仅在 推导二元类型ID（指针变量经
        //   类型ID 推导返 -1=全路径失效，实测声明/赋值皆零命中）；本处改
        //   用 表查找类型ID（声明类型文本）+ 是裸指针类型文本 判定——与
        //   B8/A2 判定机制同族，声明/赋值/表达式全路径覆盖。
        // 575-a（T100·422 对齐宿主 T8）：编译期常量除零——除/余 右操作数为
        //   字面量 0 时编译期拒绝（宿主 semantic_expr_op.cpp:91 同款；负测
        //   422 锚）。右操作数末端节点=本节点索引-1（既有推导惯例）。
        如果 (字符串比较(op文本, "/") || 字符串比较(op文本, "%")) {
            节点 右除 = 池.元素(整32(节点索引 - 1));
            如果 (右除.类型 == 节点_整数字面量) {
                如果 (字符串比较(字符串复制(驻留文本(整64(右除.文本))), "0")) {
                    表诊断(诊断, "[错误] 编译期除零：常量表达式除数为零（运行期除零已有运行时错误 1）");
                }
            }
        }
        如果 (字符串比较(op文本, "+") || 字符串比较(op文本, "-")) {
            布尔 左指针a1 = 假;
            布尔 右指针a1 = 假;
            节点 左a1 = 池.元素(整32(n.子起点 - 1));
            如果 (左a1.类型 == 节点_标识符) {
                // v2 符号登记语义：指针变量登记**所指类型**（B8 同款注释：
                //   「指针变量表命中即返回所指类型」）——故判定用 查语义
                //   指针变量（非 表查找类型ID，后者对 整64* q 返 整64）。
                整64 查左a1 = 查语义指针变量(整64(左a1.文本));
                如果 (查左a1 >= 0) {
                    如果 (!字符串比较(字符串复制(驻留文本(查左a1)), "字符")) {
                        左指针a1 = 真;   // 字符* 排除（字符串视图=波 1 同族）
                    }
                }
            }
            节点 右a1 = 池.元素(整32(节点索引 - 1));
            如果 (右a1.类型 == 节点_标识符) {
                整64 查右a1 = 查语义指针变量(整64(右a1.文本));
                如果 (查右a1 >= 0) {
                    如果 (!字符串比较(字符串复制(驻留文本(查右a1)), "字符")) {
                        右指针a1 = 真;
                    }
                }
            }
            如果 (左指针a1 || 右指针a1) {
                错误不安全边界(诊断, "指针算术", "指针 +/- 整数");
            }
        }
        // 609-a（T100·425 对齐宿主 visitBinaryExpr 空类型面·Rust () 同款）：
        //   空类型调用结果参与运算拒绝。类型经 表达式类型ID 推导族+静默诊断
        //   缓冲（174 教训惯例：二次推导诊断吞弃·语句根区间遍历=权威诊断点）；
        //   语句级单独调用不入本判定=合法（打印(x); 同族）。方向词对齐宿主
        //   visitBinaryExpr（左/右 操作数是空类型调用结果）。
        整64 空类型609 = 驻留("空类型");
        向量<字符串> 静默诊断609 = 向量<字符串>();
        整64 左类型609 = 0 - 1;
        整64 右类型609 = 0 - 1;
        如果 (!是副作用内置被调(池, 整32(n.子起点 - 1))) {
            左类型609 = 表达式类型ID(池, 整32(n.子起点 - 1), 符号表, 静默诊断609);
        }
        如果 (!是副作用内置被调(池, 整32(节点索引 - 1))) {
            右类型609 = 表达式类型ID(池, 整32(节点索引 - 1), 符号表, 静默诊断609);
        }
        //   调用形态限定：空类型表达式只能来自调用（文案即「调用结果」）——
        //   指针变量（空类型* p）经 表查找类型ID 返回**所指类型**裸「空类型」
        //   （符号登记语义·34_file `写句柄 != 无` 全量实锤误伤面）——非调用
        //   末端一律不判，杜绝该族误伤。
        如果 (左类型609 == 空类型609 &&
             池.元素(整32(n.子起点 - 1)).类型 == 节点_调用) {
            表诊断(诊断, "[错误] 空类型（无返回值）不能参与运算：左 操作数是空类型调用结果（Rust () 同款——无返回值却有值违反类型安全；如需值请改函数返回类型）");
        }
        如果 (右类型609 == 空类型609 &&
             池.元素(整32(节点索引 - 1)).类型 == 节点_调用) {
            表诊断(诊断, "[错误] 空类型（无返回值）不能参与运算：右 操作数是空类型调用结果（Rust () 同款——无返回值却有值违反类型安全；如需值请改函数返回类型）");
        }
    }
    返回 -1;
}

// 族④：三元运算检查（原 507~526 段）——③ 第六波：三元两分支类型一致性
//   （表达式类型ID 推导·86-a 复审缺陷①：成员/二元精确推导）+ 类型可合并
//   判定 + 返回真值类型（IR 汇合槽按真分支类型读）。
函数 检查三元运算表达式(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串> 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    // ③ 第六波：三元两分支类型一致性——段末端节点递归推导（真值末端=附加-1、
    //   假值末端=子终点-1）；未知(-1)任一侧跳过（级联防）。条件段类型不强制
    //   （条件跳转按非零判——同 如果/当 惯例）；三段标识符检查由语句根区间
    //   线性遍历覆盖（同二元惯例）。返回真值类型（IR 汇合槽按真分支类型读）
    // 86-a（2026-09-12 复审缺陷①）：改用 表达式类型ID（成员经 推导成员类型ID
    //   精确推导、二元经 推导二元类型ID）——原 检查表达式 对成员恒 整64 兜底
    //   → 聚合分支（乙箱.内盒）与 标识符分支（甲=盒）误报「两分支类型不一致」
    //   （P47/t5 实证）。推导失败 -1 仍跳过（级联防不误伤）。
    整64 真类型 = 表达式类型ID(池, 整32(n.附加 - 1), 符号表, 诊断);
    整64 假类型 = 表达式类型ID(池, 整32(n.子终点 - 1), 符号表, 诊断);
    如果 (真类型 != -1 && 假类型 != -1) {
        如果 (!类型可合并(真类型, 假类型)) {
            表诊断(诊断, "[错误] 三元两分支类型不一致: " + 驻留文本(真类型) +
                   " 与 " + 驻留文本(假类型));
        }
    }
    如果 (真类型 != -1) { 返回 真类型; }
    返回 假类型;
}

// ==================== 46-c 推断声明类型推导（2026-09-10 第四十九轮） ====================
// 推断声明的类型权威推导（单点；IR 层经 推断声明类型表 查表消费）：
//   表达式类型ID——区间末节点=表达式根（线性化约定，检查表达式 二元/三元
//   同款技巧）：成员/二元走专用推导（检查表达式 对两者恒 整64/-1 半实现，
//   推断声明不可静默降级——成员误推整64 会让结构体值截断进 8 字节槽=46-a
//   家族静默错误代码）；其余（字面量/标识符/调用/下标/三元）经 检查表达式
//   既有精确推导。-1=不可推导（调用方可见诊断，语义错误即中止兜底）。
函数 表达式类型ID(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串> 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    如果 (n.类型 == 节点_成员) { 返回 推导成员类型ID(池, 节点索引, 符号表, 诊断); }
    如果 (n.类型 == 节点_二元运算) { 返回 推导二元类型ID(池, 节点索引, 符号表, 诊断); }
    返回 检查表达式(池, 节点索引, 符号表, 诊断);
}

// 成员读类型推导（46-a 家族同源机制，同构 IR生成 解析成员链结构体ID 范本——
//   父链三形态：标识符（变量结构体表 键基直查>1；标量/容器走符号表类型名归一）/
//   成员（递归）/调用（返回类型名归一））。返回字段类型名ID；-1=不可推导。
函数 推导成员类型ID(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串> 诊断) -> 整64 {
    节点 m = 池.元素(节点索引);
    整64 父键基 = 0;
    如果 (m.子起点 >= 0 && m.子起点 < 池.大小()) {
        节点 对象m = 池.元素(整32(m.子起点));
        如果 (对象m.类型 == 节点_标识符) {
            // 变量结构体表：值>1=键基（结构体对象直查）；1=结构体名标记/
            //   0/-1=非结构体——标量/容器走符号表类型名（字符串字段等非
            //   结构体成员经 查结构体类型 归一 miss=-1 可见）
            整64 键v = 查变量结构体键(整64(对象m.文本));
            如果 (键v > 1) {
                父键基 = 键v;
            } 否则 {
                整64 对象类型ID = 检查标识符表达式(池, 整32(m.子起点), 符号表, 诊断);
                如果 (对象类型ID > 0) { 父键基 = 查结构体类型(对象类型ID); }
            }
            // 154-a（B9 v2 挂点）：**裸指针成员访问**（p.字段——CN 的 . 自动解引用
            //   一级；与宿主 B9 同族）。判定=指针变量表命中；字符串语义（字符*/
            //   字符串）在宿主经 isStringSemanticType 豁免——v2 树已全量迁移
            //   （不安全 修饰），存量零警告；用户侧从严（波 6 与宿主统一）。
            整64 查指针m = 查语义指针变量(整64(对象m.文本));
            如果 (查指针m >= 0) {
                错误不安全边界(诊断, "指针成员访问", "指针成员访问（p.字段）");
            }
        } 否则 如果 (对象m.类型 == 节点_成员) {
            整64 父字段ID = 推导成员类型ID(池, 整32(m.子起点), 符号表, 诊断);
            如果 (父字段ID > 0) { 父键基 = 查结构体类型(父字段ID); }
        } 否则 如果 (对象m.类型 == 节点_调用) {
            整64 返回类型ID = 检查调用表达式(池, 整32(m.子起点), 符号表, 诊断);
            如果 (返回类型ID > 0) { 父键基 = 查结构体类型(返回类型ID); }
        }
    }
    如果 (父键基 <= 0) { 返回 -1; }
    整64 字段ID = 查字段类型ID(父键基, 整64(m.文本));
    如果 (字段ID == 0) { 返回 -1; }
    返回 字段ID;
}

// 二元运算类型推导（左右操作数区间末节点递归+同族可合并取左——检查表达式
//   二元节点布局约定：子起点=右操作数起点、左末=子起点-1、右末=本索引-1）。
//   任一侧不可推导/跨族=整体 -1（绝不静默降级整64——推断声明类型错误是
//   静默错误代码温床）。返回操作数类型名ID；-1=不可推导。
函数 推导二元类型ID(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串> 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    如果 (n.子起点 <= 0) { 返回 -1; }
    整64 左ID = 表达式类型ID(池, 整32(n.子起点 - 1), 符号表, 诊断);
    整64 右ID = 表达式类型ID(池, 整32(节点索引 - 1), 符号表, 诊断);
    // 155-a A1 挂点原位于此（推导二元类型ID）——157-a 实测失效（表达式类型ID
    //   对指针变量返 -1）已移除；A1 判定统一下沉 检查表达式 二元分支
    //   （查语义指针变量 判定，声明/赋值/表达式全路径覆盖）。
    如果 (左ID <= 0 || 右ID <= 0) { 返回 -1; }
    如果 (!类型可合并(左ID, 右ID)) { 返回 -1; }
    返回 左ID;
}

不安全 函数 检查语句(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串> 诊断) -> 空类型 {
    节点 n = 池.元素(节点索引);
    // 103-a（D2）：设当前诊断行=语句根行（解析块 单点回填；0=未知→表诊断
    //   不带行号，存量兼容）——语义诊断自此带源码行号（对齐语法层（行=）格式）
    设当前诊断行(n.行);
    如果 (n.类型 == 节点_返回语句) {
        // 71-a：返回位装箱语境——当前函数返回类型为 结果/可选 时设置（构造器
        //   正常/错误/某些 的类型推导依据；区间检查后复位）
        布尔 返回位语境71 = 假;
        如果 (n.子终点 > n.子起点 && 当前函数返回类型 >= 0) {
            如果 (是结果类型(字符串复制(驻留文本(当前函数返回类型)))) {
                装箱语境类型ID = 当前函数返回类型;
                返回位语境71 = 真;
            }
        }
        // 474-a（D46）：结果/可选构造名裸名拒绝——`返回 正常;` 裸标识符形态。
        //   71-a 的被调标识符放行=调用位 callee 专属（语义检查表达式 59）·裸名
        //   位经同一路径静默过→生成层产物垃圾（p8 探针双侧实锤：宿主 check
        //   rc=1 拒绝〔函数指针转换形态〕·v2 rc=0 静默）——构造须带参调用
        //   正常(值)/错误(码)/某些(值)。仅返回语句位单点（表达式位裸名=同族
        //   残余·021 D46 行登记）；`返回 正常(5);`=节点_调用 不入此判定不误伤。
        如果 (n.子终点 > n.子起点) {
            节点 返回表达式474 = 池.元素(整32(n.子终点 - 1));
            如果 (返回表达式474.类型 == 节点_标识符) {
                字符串 裸名文本474 = 字符串复制(驻留文本(整64(返回表达式474.文本)));
                如果 (字符串比较(裸名文本474, "正常") || 字符串比较(裸名文本474, "错误") ||
                     字符串比较(裸名文本474, "某些")) {
                    表诊断(诊断, "[错误] 构造名裸名须带参调用: " + 裸名文本474 +
                                "（ 正常(值) / 错误(码) / 某些(值) ）");
                }
            }
        }
        整64 i = 整64(n.子起点);
        当 (i < 整64(n.子终点)) {
            整64 忽略 = 检查表达式(池, 整32(i), 符号表, 诊断);
            如果 (忽略 == -1) { }
            i++;
        }
        如果 (返回位语境71) { 装箱语境类型ID = 0; }   // 71-a：语境复位
        // 55-c 方案A（2026-09-10 第五十六轮 用户裁决）：返回面混合符号拒绝——
        //   返回类型（当前函数返回类型名ID）与返回值表达式类型「变量间」跨符号
        //   拒绝；字面量豁免（检查混合符号赋值，语义检查表达式 模块）。
        //   顶层静态声明初始化不经 返回语句；无返回值（子终点==子起点）跳过。
        如果 (n.子终点 > n.子起点 && 当前函数返回类型 >= 0) {
            检查混合符号赋值(池, 当前函数返回类型, n.子终点 - 1, 符号表, 诊断);
        }
        // 329-a（D38 批2·305/350）：返回面标量隐式转换检查——隐式转换仅宽化
        //   （字符串→整32 t11/布尔→整32 t12/整64→整32 窄化 t13 拒；整→浮/整→整
        //   宽化放行）。结果/可选/容器/类结构体目标=装箱与拷贝构造语义在
        //   隐式转换合法 内跳过；指针/引用返回类型文本非标量亦跳过（103 面管辖）。
        如果 (n.子终点 > n.子起点 && 当前函数返回类型 >= 0) {
            检查标量隐式转换(池, 整32(n.子终点 - 1), 当前函数返回类型, 符号表, 诊断, 真);
        }
        // 210-a（2026-09-15 第两百一十轮，D1 行数整改）：返回面借用检查两段迁族——
        //   检查返回借用A2（阶段4' A2 拥有契约）+检查返回局部地址（阶段2 悬垂拒绝），
        //   守卫（返回类型字符串/指针引用 + 有返回值）随族走——纯检查零行为变更。
        检查返回借用A2(池, n, 符号表, 诊断);
        检查返回局部地址(池, n, 符号表, 诊断);
        返回;
    }
    如果 (n.类型 == 节点_变量声明) {
        检查变量声明语句(池, 节点索引, 符号表, 诊断);
        返回;
    }
    如果 (n.类型 == 节点_赋值) {
        检查赋值语句(池, 节点索引, 符号表, 诊断);
        返回;
    }
    如果 (n.类型 == 节点_自增) {
        整64 目标类型 = 表查找类型ID(符号表, 整64(n.文本));
        // 188-a（D6 B11 变量常量传播）：自增=隐式非空写入 → 恒空判定失格
        登记恒空失格(整64(n.文本));
        如果 (目标类型 == -1) {
            表诊断(诊断, "[错误] 自增目标未声明: " + 驻留文本(整64(n.文本)));
        }
        // 缺陷②同族（2026-09-03 用户裁决立案）：自增是隐式赋值——常量不可自增
        //   （宿主 visitUnaryExpr ++/-- 常量拒绝对齐；v2 解析器仅支持 ++标识符/
        //   标识符++，结构性无歧义，仅需常量检查）
        如果 (表查找种类(符号表, 整64(n.文本)) == 符号_常量) {
            表诊断(诊断, "[错误] 不能对常量自增（常量初始化后不可修改）: " +
                          驻留文本(整64(n.文本)));
        }
        返回;
    }
    // 簇③根治·自减全链 C1（2026-09-04 用户裁决）：与 节点_自增 完全对称——
    //   未声明诊断 + 常量拒绝（自减同为隐式赋值）
    如果 (n.类型 == 节点_自减) {
        整64 目标类型减 = 表查找类型ID(符号表, 整64(n.文本));
        // 188-a（D6 B11 变量常量传播）：自减=隐式非空写入 → 恒空判定失格
        登记恒空失格(整64(n.文本));
        如果 (目标类型减 == -1) {
            表诊断(诊断, "[错误] 自减目标未声明: " + 驻留文本(整64(n.文本)));
        }
        如果 (表查找种类(符号表, 整64(n.文本)) == 符号_常量) {
            表诊断(诊断, "[错误] 不能对常量自减（常量初始化后不可修改）: " +
                          驻留文本(整64(n.文本)));
        }
        返回;
    }
    如果 (n.类型 == 节点_中断语句 || n.类型 == 节点_继续语句) {
        返回;
    }
    // 609-a（T100·003 123 规则1 对齐宿主 checkResultDiscard·规范07 四）：
    //   结果<T,E> 返回值被丢弃未检查 -> 错误（表达式语句根区间末端=调用形态，
    //   如 `字典.设置(3,300);`）。赋值/声明接收不入本判定=宿主同口径（变量
    //   随后可检查·未检查访问 .值 由规则3 面拦截）；普通表达式（结果.正常
    //   读取）非调用节点不拦。类型经静默诊断缓冲推导（174 教训惯例）。
    //   stdlib 容器方法面：通用推导对池外类（stdlib 类不在编译池）整64 兜底
    //   ——604-a 只覆盖池内用户类——被调=成员 且对象类型=$ 合成名 时经
    //   IR签名 签名表回退（键=合成名基名(接收者).方法名.实参数·n.附加·
    //   IR 层同款·确保签名已加载 幂等）；返回原文（泛型替换前 `结果<空类型,整32>`
    //   形态）以 结果</可选< 前缀判定（是结果类型 只认 $ 合成名·原文不适用
    //   ——精确实例化文本由 IR 层 查方法签名 替换既有）。回退面收窄于本
    //   判定单点（原文类型 ID 不进通用推导——防声明位隐式转换误伤）。
    如果 (n.类型 == 节点_表达式语句 && n.子终点 > n.子起点) {
        节点 表达式语句末609 = 池.元素(整32(n.子终点 - 1));
        如果 (表达式语句末609.类型 == 节点_调用 &&
             !是副作用内置被调(池, 整32(n.子终点 - 1))) {
            向量<字符串> 静默r1 = 向量<字符串>();
            整64 语句末类型609 = 表达式类型ID(池, 整32(n.子终点 - 1), 符号表, 静默r1);
            布尔 是结果609 = 语句末类型609 > 0 &&
                          是结果类型(字符串复制(驻留文本(语句末类型609)));
            如果 (!是结果609 && 表达式语句末609.子起点 > 0) {
                节点 被调r1 = 池.元素(整32(表达式语句末609.子起点));
                如果 (被调r1.类型 == 节点_成员 && 被调r1.子起点 > 0) {
                    节点 对象r1 = 池.元素(整32(被调r1.子起点));
                    如果 (对象r1.类型 == 节点_标识符) {
                        整64 对象类型r1 = 表查找类型ID(符号表, 整64(对象r1.文本));
                        如果 (对象类型r1 > 0) {
                            字符串 基名r1 = 合成名基名(字符串复制(驻留文本(对象类型r1)));
                            如果 (字符串长度(基名r1) > 0 &&
                                 整64(表达式语句末609.附加) > 0) {
                                确保签名已加载();
                                整64 键r1 = 驻留(基名r1 + "." +
                                              字符串复制(驻留文本(整64(被调r1.文本))) +
                                              "." + 整数转字符串(整64(表达式语句末609.附加)));
                                整64 查返r1 = 查签名返回(键r1);
                                如果 (查返r1 >= 0) {
                                    字符串 返原文r1 = 字符串复制(驻留文本(查返r1));
                                    如果 (字符串长度(返原文r1) >= 7 &&
                                         (字符串比较(字符串子串(返原文r1, 0, 7), "结果<") ||
                                          字符串比较(字符串子串(返原文r1, 0, 7), "可选<"))) {
                                        是结果609 = 真;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            如果 (是结果609) {
                表诊断(诊断, "[错误] 结果<正常,错误> 返回值被丢弃未检查（须用 结果.正常 检查后处理两个分支）");
            }
        }
    }
    // 一元（逻辑非/负号/取地址/解引用）裸节点分支已删除（缺陷②分诊根治）：
    //   检查块 现仅派发语句根节点——裸一元节点的操作数由所属语句根的区间检查
    //   统一覆盖（原分支=块级裸派发兜底，双重处理/前向引用误报根源）
    // P6c：成员偏移标注（通用表达式区间）
    整64 标4 = 标注成员偏移(池, n.子起点, n.子终点, 符号表, 诊断);
    如果 (标4 == -1) { }
    整64 i = 整64(n.子起点);
    当 (i < 整64(n.子终点)) {
        整64 忽略 = 检查表达式(池, 整32(i), 符号表, 诊断);
        如果 (忽略 == -1) { }
        i++;
    }
}


// 210-a：族① 返回面借用检查（plans/019 阶段4' A2 拥有契约）——返回类型 字符串=拥有，
//   借用形态返回拒绝：下标/成员借出、字符* 调用返回、参数/非局部标识符（借用）；
//   局部拥有标识符/字面量/拼接放行（宿主 visitReturnStmt 同构）。
不安全 函数 检查返回借用A2(向量<节点> 池, 节点 n, 向量<映射<整64, 符号>>& 符号表, 向量<字符串> 诊断) -> 空类型 {
        // plans/019 阶段4' A2（2026-09-11 方案甲 用户批准）：返回位拥有契约——
        //   返回类型 字符串=拥有（调用方登记 RAII 释放），借用形态返回拒绝：
        //   下标/成员借出、字符* 调用返回（驻留文本 等）、参数标识符（借用）。
        //   局部拥有标识符/字面量/拼接放行（宿主 visitReturnStmt 同构；
        //   v2 语法面无栈数组，借出载体=指针下标/成员）。
        如果 (n.子终点 > n.子起点 && 当前函数返回类型 == 驻留("字符串")) {
            节点 返回末A2 = 池.元素(整32(n.子终点 - 1));
            布尔 借用返回A2 = 假;
            如果 (返回末A2.类型 == 节点_下标 || 返回末A2.类型 == 节点_成员) {
                借用返回A2 = 真;
            } 否则 如果 (返回末A2.类型 == 节点_调用 && 返回末A2.子起点 >= 0) {
                节点 被调A2 = 池.元素(整32(返回末A2.子起点));
                如果 (被调A2.类型 == 节点_标识符 &&
                     查函数返回类型(整64(被调A2.文本)) == 驻留("字符*")) {
                    借用返回A2 = 真;
                }
            } 否则 如果 (返回末A2.类型 == 节点_标识符) {
                // 参数=借用（局部=拥有移出放行；非局部=静态/全局借用）
                整64 返回名A2 = 整64(返回末A2.文本);
                // 符号_参数=借用；非局部（静态/全局）=借用（局部=拥有移出放行）
                如果 (表查找种类(符号表, 返回名A2) == 符号_参数 ||
                     !是局部名(符号表, 返回名A2)) {
                    借用返回A2 = 真;
                }
            }
            如果 (借用返回A2) {
                表诊断(诊断, "[错误] 函数返回类型 '字符串'=拥有契约，不能返回借用" +
                             "——须 字符串复制(...) 显式落堆，或改返回类型为 '字符*'（借用视图）");
            }
        }
}

// 210-a：族② 返回局部地址检查（plans/019 阶段2）——返回类型为指针/引用且返回末节点
//   为 取地址(局部标识符) 时拒绝（栈帧消亡悬垂；引用参数指向调用方存储豁免——
//   宿主 isRefParamForCurrentFn 对齐；v2 第一版不含经指针转接形态=诚实边界）。
不安全 函数 检查返回局部地址(向量<节点> 池, 节点 n, 向量<映射<整64, 符号>>& 符号表, 向量<字符串> 诊断) -> 空类型 {
        // plans/019 阶段2（2026-09-10）：返回局部变量的地址——返回类型为指针
        //   或引用（名文本尾 * 或 &）且返回末节点为 取地址(局部标识符) 时拒绝
        //   （栈帧消亡悬垂；宿主 visitReturnStmt 指针返回检查同构——v2 第一版
        //   不含经指针转接形态=诚实边界）
        如果 (n.子终点 > n.子起点 && 当前函数返回类型 >= 0) {
            字符串 返回类型文本 = 字符串复制(驻留文本(当前函数返回类型));
            整64 返回类型长度 = 字符串长度(返回类型文本);
            布尔 返回是指针或引用 = 假;
            如果 (返回类型长度 > 0) {
                字符串 尾字符 = 字符串子串(返回类型文本, 返回类型长度 - 1, 1);
                如果 (字符串比较(尾字符, "*") || 字符串比较(尾字符, "&")) {
                    返回是指针或引用 = 真;
                }
            }
            如果 (返回是指针或引用) {
                节点 返回末 = 池.元素(整32(n.子终点 - 1));
                如果 (返回末.类型 == 节点_取地址 && 返回末.子起点 >= 0) {
                    节点 取地址操作数 = 池.元素(整32(返回末.子起点));
                    如果 (取地址操作数.类型 == 节点_标识符 &&
                         是局部名(符号表, 整64(取地址操作数.文本)) &&
                         !是当前引用参数(整64(取地址操作数.文本))) {
                        // 宿主 isRefParamForCurrentFn 对齐：引用参数指向调用方
                        //   存储（非本栈帧）——返回 &引用参数 合法豁免
                        表诊断(诊断, "[错误] 返回局部变量的地址（栈帧消亡将成悬垂）: " +
                                      驻留文本(整64(取地址操作数.文本)));
                    }
                }
                // 329-a（D38 批2·103）：引用返回（仅 & 尾）裸标识符/成员链形态——
                //   返回局部变量本体=引用绑定隐式取地址，同悬垂（宿主「引用返回
                //   不能返回局部变量的地址」对齐·t01/t04/t05 实测；引用参数豁免
                //   指向调用方存储·t02；全局豁免·t03；指针返回（尾 *）裸标识符=
                //   指针值拷贝不属本面）。成员链只判父对象一层（嵌套链=诚实边界
                //   同 推导成员类型ID 粒度）。
                如果 (字符串比较(字符串子串(返回类型文本, 返回类型长度 - 1, 1), "&")) {
                    // 尾字符 判定块内重算（原 尾字符 声明于上方 若 长度>0 块内·块外不可见）
                    整64 局部名103 = 0;
                    布尔 返回局部103 = 假;
                    如果 (返回末.类型 == 节点_标识符 &&
                         是局部名(符号表, 整64(返回末.文本)) &&
                         !是当前引用参数(整64(返回末.文本))) {
                        返回局部103 = 真;
                        局部名103 = 整64(返回末.文本);
                    } 否则 如果 (返回末.类型 == 节点_成员 && 返回末.子起点 > 0) {
                        节点 父对象103 = 池.元素(整32(返回末.子起点));
                        如果 (父对象103.类型 == 节点_标识符 &&
                             是局部名(符号表, 整64(父对象103.文本)) &&
                             !是当前引用参数(整64(父对象103.文本))) {
                            返回局部103 = 真;
                            局部名103 = 整64(父对象103.文本);
                        }
                    }
                    如果 (返回局部103) {
                        表诊断(诊断, "[错误] 引用返回不能返回局部变量的地址（'" +
                                      驻留文本(局部名103) + "'）");
                    }
                }
            }
        }
}



// 检查块（新作用域：压入/弹出）
// ③ 第二波根治（2026-09-03）：父层区间原始遍历会先处理嵌套块（当体/如果体/裸块）
//   的语句、随后控制节点递归再处理一遍——嵌套声明泄漏注册到父层作用域（块级遮蔽
//   检查被自注册误触发，126/127 无真实遮蔽也误报；符号作用域语义错误）。修复：
//   预收集全部嵌套体块区间，主循环跳过——嵌套语句只在递归作用域内处理一次。
函数 检查块(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串> 诊断) -> 空类型 {
    表压入(符号表);
    节点 块 = 池.元素(节点索引);
    向量<整64> 跳过区间们 = 向量<整64>();
    整64 预扫i = 整64(块.子起点);
    当 (预扫i < 整64(块.子终点)) {
        节点 预节点 = 池.元素(整32(预扫i));
        如果 (预节点.类型 == 节点_块) {
            // 裸块：语句区间 [块.子起点, 块节点自身)——块节点由主循环派发递归
            登记跳过区间(跳过区间们, 整64(预节点.子起点), 预扫i);
        } 否则 如果 (预节点.类型 == 节点_当语句) {
            // 当：体块@附加，区间 [体块.子起点, 体块节点]（含体块节点——检查当 递归）
            节点 当体块 = 池.元素(预节点.附加);
            登记跳过区间(跳过区间们, 整64(当体块.子起点), 整64(预节点.附加) + 1);
        } 否则 如果 (预节点.类型 == 节点_循环语句) {
            // 357-a（D39）：三段式循环——前置段（init/cond/step/step包装，
            //   区间 [循环节点+1, 体块索引)）与体块节点@附加，区间
            //   [循环节点+1, 附加+1)（不含循环节点本身——主循环派发 检查循环）
            登记跳过区间(跳过区间们, 整64(预扫i) + 1, 整64(预节点.附加) + 1);
        } 否则 如果 (预节点.类型 == 节点_如果语句) {
            // 如果：真块@附加，区间 [真块.子起点, 真块节点]（含——检查如果 递归）；
            //   否则链节点（块/如果）在区间内会被预扫另行收集（否则块按裸块、否则
            //   如果按本分支），条件表达式区间不跳（检查如果/主循环双查幂等无害）
            节点 真块 = 池.元素(预节点.附加);
            登记跳过区间(跳过区间们, 整64(真块.子起点), 整64(预节点.附加) + 1);
        }
        预扫i++;
    }
    整64 i = 整64(块.子起点);
    当 (i < 整64(块.子终点)) {
        // 跳过嵌套体块区间（其语句由递归作用域处理）
        布尔 在跳过 = 假;
        整64 跳i = 0;
        当 (跳i < 跳过区间们.大小()) {
            如果 (i >= 跳过区间们.元素(跳i) && i < 跳过区间们.元素(跳i + 1)) {
                在跳过 = 真;
                中断;
            }
            跳i += 2;
        }
        如果 (在跳过) { i++; 继续; }
        节点 子 = 池.元素(整32(i));
        // 语句根节点才派发（缺陷②分诊根治，2026-09-03）：块区间线性包含各语句
        //   的全部内部节点（RHS 裸标识符/一元/成员…先于语句根入池）——原实现逐
        //   节点派发使裸一元节点（取地址/解引用/负号/逻辑非）在**声明根注册名
        //   字之前**先查操作数区间：自引用/前向引用误报「未声明」+ 同一错误双
        //   诊断（&q 前向引用探针实证报两次）。裸节点一律由所属语句根的区间
        //   检查统一覆盖（每节点恰在其作用域访问一次，rustc 对齐）
        如果 (子.类型 == 节点_块 || 子.类型 == 节点_如果语句 || 子.类型 == 节点_当语句 ||
             子.类型 == 节点_循环语句 || 子.类型 == 节点_选择语句 ||
             子.类型 == 节点_变量声明 || 子.类型 == 节点_赋值 || 子.类型 == 节点_自增 ||
             子.类型 == 节点_自减 ||
             子.类型 == 节点_返回语句 || 子.类型 == 节点_表达式语句 ||
             子.类型 == 节点_中断语句 || 子.类型 == 节点_继续语句) {
            如果 (子.类型 == 节点_块) {
                检查块(池, 整32(i), 符号表, 诊断);
            } 否则 如果 (子.类型 == 节点_如果语句) {
                检查如果(池, 整32(i), 符号表, 诊断);
            } 否则 如果 (子.类型 == 节点_当语句) {
                检查当(池, 整32(i), 符号表, 诊断);
            } 否则 如果 (子.类型 == 节点_循环语句) {
                检查循环(池, 整32(i), 符号表, 诊断);
            } 否则 如果 (子.类型 == 节点_选择语句) {
                检查选择(池, 整32(i), 符号表, 诊断);
            } 否则 {
                检查语句(池, 整32(i), 符号表, 诊断);
            }
        }
        i++;
    }
    表弹出(符号表);
    状态出块清理(符号表.大小());  // 010（def-init）：出块清理该层未初始化键
}

// 413-a（D44 正体收口）：检查选择语句——值表达式区间 + 各情况值表达式 + 体块。
//   节点字段：文本=值起点、附加=值终点、子起点=第一情况索引、子终点=情况段终点；
//   情况标签：文本/附加=值区间（默认=[0,0)）、子起点=体块索引、子终点=字符串标记。
//   诚实边界：情况值常量性未限定（规范 755 口径=常量——v2 现接受表达式·生成期
//   自然支持整型表达式比较；与宿主「编译期常量」口径的收窄面登记待定项）。
函数 检查选择(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串> 诊断) -> 空类型 {
    节点 选择节点 = 池.元素(节点索引);
    // 选择值表达式区间
    整64 值i = 整64(选择节点.文本);
    当 (值i < 整64(选择节点.附加)) {
        整64 忽略s = 检查表达式(池, 整32(值i), 符号表, 诊断);
        如果 (忽略s == -1) { }
        值i++;
    }
    // 情况段：值表达式 + 体块（新作用域·检查块 递归）
    // 657-a（02_control 阻塞面真根因·机制级）：**类型过滤=节点_情况标签**——
    //   情况段区间 [子起点,子终点) 含情况值表达式/体语句/体块/标签全部节点
    //   （解析层子起点=吃 `{` 后池位置·值与体语句在标签前入池·413-a 设计如此，
    //   生成层 生成语句.cn 两处消费点均有同款过滤）——原实现无过滤把区间内
    //   任意「子起≠0」节点当情况节点：如果/当节点字段 [文本,附加)=[条件区+真块]
    //   被整体当「值表达式区间」在**外层作用域**检查（嵌套块局部声明伪报
    //   「未声明标识符」·探针 p2/p2b 实锤·02_control 第 7 段正中）。
    整64 况i = 整64(选择节点.子起点);
    当 (况i < 整64(选择节点.子终点)) {
        节点 情况节点 = 池.元素(整32(况i));
        如果 (情况节点.类型 == 节点_情况标签) {
            // 情况值表达式区间（默认=空值区间 [0,0) 自然空转）
            如果 (情况节点.子起点 != 0) {
                整64 况值i = 整64(情况节点.文本);
                当 (况值i < 整64(情况节点.附加)) {
                    整64 忽略c = 检查表达式(池, 整32(况值i), 符号表, 诊断);
                    如果 (忽略c == -1) { }
                    况值i++;
                }
            }
            检查块(池, 整32(情况节点.子起点), 符号表, 诊断);
        }
        况i++;
    }
}

// 检查如果语句：条件表达式 + 真块（新作用域）+ 否则链（否则 如果 递归）
函数 检查如果(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串> 诊断) -> 空类型 {
    节点 如果节点 = 池.元素(节点索引);
    // 节点字段：文本=条件起点，子起点=条件终点，附加=真块索引，子终点=否则索引
    整64 条件起点 = 整64(如果节点.文本);
    整64 条件终点 = 整64(如果节点.子起点);
    整64 i = 条件起点;
    当 (i < 条件终点) {
        整64 忽略 = 检查表达式(池, 整32(i), 符号表, 诊断);
        如果 (忽略 == -1) { }
        i++;
    }
    // 329-a（D38 批2·341）：条件严格布尔检查——宿主 t06/t07/t08 实测整/浮条件
    //   均拒（C 风格非零真不适用 CN）；比较/短路二元与 逻辑非/布尔字面量/布尔
    //   类型放行；检不出形态放行=诚实边界。
    如果 (条件终点 > 条件起点) {
        检查条件布尔(池, 整32(条件终点 - 1), "如果", 符号表, 诊断);
    }
    // 010（def-init）：分支状态传播——基线压栈→真支→快照→恢复基线→否则支→
    //   并集归并（must analysis·宿主 defInitCheckIf 同构）；无否则=恢复进入态
    //   636-a 重构：快照走静态备份区+层号（原 向量<整64> 按值传参=v2 句柄
    //   语义下实参悬垂 UAF·cn_self fix_s 段错误根因——详 语义检查初始化.cn 头）
    整64 状态基线i = 状态压栈();
    检查块(池, 整32(如果节点.附加), 符号表, 诊断);
    整64 真支后i = 状态压栈();
    状态恢复到(状态基线i);
    // 否则链：子终点=否则节点索引（0=无；嵌套 否则 如果 亦为 节点_如果语句）
    整64 否则索引 = 如果节点.子终点;
    如果 (否则索引 != 0) {
        节点 否则节点 = 池.元素(整32(否则索引));
        如果 (否则节点.类型 == 节点_如果语句) {
            检查如果(池, 整32(否则索引), 符号表, 诊断);
        } 否则 {
            检查块(池, 整32(否则索引), 符号表, 诊断);
        }
        // 010：终止支豁免+并集归并（宿主 stmtGuaranteesReturn 同构）——
        //   终止支的出口状态不参与汇合约束（路径不可达）
        布尔 真支终止i = 状态必然返回(池, 整32(如果节点.附加));
        布尔 否则终止i = 状态必然返回(池, 整32(否则索引));
        如果 (真支终止i && 否则终止i) {
            状态恢复到(状态基线i);
        } 否则 如果 (否则终止i) {
            状态恢复到(真支后i);
        } 否则 如果 (!真支终止i) {
            状态归并到(真支后i);
        }
        // 真支终止且否则未终止：静态表当前=否则支后 ✓ 无操作
    }
    状态弹栈清(状态基线i);   // 636-a：本如果快照全弃（嵌套残留同截兜底）
}

// 检查当语句：条件表达式 + 循环体块（新作用域）
函数 检查当(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串> 诊断) -> 空类型 {
    节点 当节点 = 池.元素(节点索引);
    // 节点字段：文本=条件起点，子起点=条件终点，附加=体块索引
    整64 条件起点 = 整64(当节点.文本);
    整64 条件终点 = 整64(当节点.子起点);
    整64 i = 条件起点;
    当 (i < 条件终点) {
        整64 忽略 = 检查表达式(池, 整32(i), 符号表, 诊断);
        如果 (忽略 == -1) { }
        i++;
    }
    // 329-a（D38 批2·341）：当条件严格布尔检查（宿主 t07 实测·与 如果 同款）
    如果 (条件终点 > 条件起点) {
        检查条件布尔(池, 整32(条件终点 - 1), "当", 符号表, 诊断);
    }
    // 010（def-init）：循环体状态不外溢（可能 0 次+回边保守）——636-a 压栈形态
    整64 当基线 = 状态压栈();
    检查块(池, 整32(当节点.附加), 符号表, 诊断);
    状态恢复到(当基线);
    状态弹栈清(当基线);   // 636-a：快照收尾
}

// 357-a（D39）：三段式循环检查——init 段语句（循环头作用域：声明随循环）、
//   cond 表达式+严格布尔、step 表达式、体块（新作用域递归）。节点字段：
//   文本=init 起点、子起点=cond 起点、子终点=step 起点、附加=体块索引
//   （step 包装=附加-1 的 节点_表达式语句）。
函数 检查循环(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串> 诊断) -> 空类型 {
    // 循环头作用域（init 声明随循环）
    表压入(符号表);
    节点 循环节点 = 池.元素(节点索引);
    // init 段：语句根逐条（声明登记/赋值/表达式）
    整64 i = 整64(循环节点.文本);
    当 (i < 整64(循环节点.子起点)) {
        节点 子 = 池.元素(整32(i));
        如果 (子.类型 == 节点_变量声明 || 子.类型 == 节点_赋值 || 子.类型 == 节点_自增 ||
             子.类型 == 节点_自减 || 子.类型 == 节点_表达式语句 ||
             子.类型 == 节点_返回语句 || 子.类型 == 节点_中断语句 || 子.类型 == 节点_继续语句) {
            检查语句(池, 整32(i), 符号表, 诊断);
        }
        i++;
    }
    // cond 段：表达式检查+严格布尔
    i = 整64(循环节点.子起点);
    当 (i < 整64(循环节点.子终点)) {
        整64 忽略 = 检查表达式(池, 整32(i), 符号表, 诊断);
        如果 (忽略 == -1) { }
        i++;
    }
    如果 (循环节点.子终点 > 循环节点.子起点) {
        检查条件布尔(池, 整32(循环节点.子终点 - 1), "循环", 符号表, 诊断);
    }
    // step 段：语句根/表达式逐节点检查（区间 [子终点, 体块节点.子起点)——
    //   块节点在体子语句后追加·step 终点须读块节点字段）
    节点 循环体块 = 池.元素(整32(循环节点.附加));
    i = 整64(循环节点.子终点);
    当 (i < 整64(循环体块.子起点)) {
        节点 步进节点 = 池.元素(整32(i));
        如果 (步进节点.类型 == 节点_自增 || 步进节点.类型 == 节点_自减 ||
             步进节点.类型 == 节点_赋值 || 步进节点.类型 == 节点_表达式语句) {
            检查语句(池, 整32(i), 符号表, 诊断);
        } 否则 {
            整64 忽略 = 检查表达式(池, 整32(i), 符号表, 诊断);
            如果 (忽略 == -1) { }
        }
        i++;
    }
    // 体块（新作用域递归）——010（def-init）：循环体状态不外溢——636-a 压栈形态
    整64 循环基线 = 状态压栈();
    检查块(池, 整32(循环节点.附加), 符号表, 诊断);
    状态恢复到(循环基线);
    状态弹栈清(循环基线);   // 636-a：快照收尾
    表弹出(符号表);
}

// 函数参数登记（第七十八轮 类支持 R3 提取：检查函数/检查方法 两类作用域单元
//   共用）——参数类型归一 + 类型引用诊断 + 指针/引用参数收集 + 符号注册。
//   自 检查函数 机械搬移（行为零变化）。
函数 登记函数参数们(向量<节点> 池, 整32 函数节点, 向量<映射<整64, 符号>>& 符号表,
                     向量<字符串>& 诊断) -> 空类型 {
    节点 函数体 = 池.元素(函数节点);
    整64 i = 整64(函数体.子起点);
    当 (i < 整64(函数体.子终点)) {
        节点 参数 = 池.元素(整32(i));
        如果 (参数.类型 == 节点_参数) {
            // ③ 第二波（方案A）：参数 类型ID 同样归一为类型名ID（统一符号约定）
            整64 参数类型ID = 整64(参数.附加);
            如果 (参数类型ID >= 0 && 参数类型ID < 池.大小()) {
                节点 参数类型节点值 = 池.元素(整32(参数类型ID));
                如果 (参数类型节点值.类型 == 节点_类型) {
                    参数类型ID = 整64(参数类型节点值.文本);
                    // 477-a（D10 波2）：重放环境映射——T 参数→实参类型（体内
                    //   源 的运算/传递落真实类型）
                    如果 (泛型重放环境.大小() > 0) {
                        整64 映射参数477 = 查重放环境(参数类型ID);
                        如果 (映射参数477 != 0) { 参数类型ID = 映射参数477; }
                    }
                    // plans/018 类型分桶：参数类型存在性/公开性/歧义诊断（fail fast）
                    检查类型引用(符号表, 诊断, 参数类型ID);
                    // ③ 第三波：指针参数登记（附加=指针层数 1..255；引用 >=256 不入）
                    如果 (参数类型节点值.附加 >= 1 && 参数类型节点值.附加 < 256) {
                        登记语义指针变量(整64(参数.文本), 参数类型ID);
                    }
                    // plans/019 阶段2：引用参数收集（附加==256）
                    如果 (参数类型节点值.附加 == 256) {
                        结果<空类型, 整32> 加引用参数 = 当前函数引用参数们.追加(整64(参数.文本));
                        如果 (!加引用参数.正常) { 运行时错误(4); }
                    }
                    // plans/019 阶段3：常量（只读）引用参数收集（附加==257——
                    //   解析参数 常量 前缀改标）
                    如果 (参数类型节点值.附加 == 257) {
                        结果<空类型, 整32> 加常量引用 = 当前函数常量引用们.追加(整64(参数.文本));
                        如果 (!加常量引用.正常) { 运行时错误(4); }
                    }
                }
            }
            整64 忽略 = 表注册(符号表, 整64(参数.文本), 参数类型ID, 符号_参数, 0);
            如果 (忽略 == 0) { }
        }
        i++;
    }
}

// 检查函数：函数作用域（参数 + 函数体）
不安全 函数 检查函数(向量<节点> 池, 整32 函数节点, 向量<映射<整64, 符号>>& 符号表, 向量<字符串> 诊断) -> 空类型 {
    清空语义指针变量表();  // ③ 第三波：函数级生命周期
    清空恒空表();          // 188-a（D6）：函数级恒空判定表同款（函数间互不污染）
    状态清空表();          // 010（def-init）：初始化状态表函数级清空（参数=已初始化）
    表压入(符号表);
    节点 函数体 = 池.元素(函数节点);
    // 477-a（D10 波2）：重放环境映射——T 返回类型→实参类型（返回比对落真实
    //   类型·p2' 实弹=「返回 "文本"; vs T=整32」编译期拒绝）；非重放路径环境
    //   恒空=直通。
    整64 返回类型ID477 = 整64(函数体.附加);
    如果 (泛型重放环境.大小() > 0) {
        整64 映射返回477 = 查重放环境(返回类型ID477);
        如果 (映射返回477 != 0) { 返回类型ID477 = 映射返回477; }
    }
    当前函数返回类型 = 返回类型ID477;  // 55-c：返回面混合符号检查取类型用
    当前函数不安全 = (函数体.修饰 % 2 == 1);   // 153-a：不安全修饰（位 0·9 类挂点豁免·575-a 位掩码兼容）
    清空当前引用参数();
    登记函数参数们(池, 函数节点, 符号表, 诊断);
    如果 (整64(函数体.子终点) < 池.大小()) {
        检查块(池, 函数体.子终点, 符号表, 诊断);
    }
    // 188-a（D6 B11 变量常量传播）：函数体检查收尾统一判定（恒空指针使用点报硬
    //   错误）——须在体块检查之后（全函数视角的不动点判定）
    判定恒空报错(诊断);
    // 第七十七轮（A21，plans/020 矩阵 A21 格靶子）：借出视图生命周期检查——
    //   字符串元素容器借出视图（元素/读取/栈顶/队首/头部元素/读取头部/读取尾部/
    //   获取）在容器失效点/容器先亡之后仍被使用=悬垂（NLL 顺序近似；宿主
    //   semantic_borrowview.cpp 同款——移植纪律 10 两侧同缺一次修全）。
    //   在体块检查后调用（独立节点扫描，不依赖符号表时刻状态）。
    检查借出视图生命周期(池, 函数节点, 符号表, 诊断);
    当前函数返回类型 = 0 - 1;  // 55-c：函数检查结束复位（防跨函数污染）
    当前函数不安全 = 假;        // 153-a：修饰标志复位（防跨函数污染）
    清空当前引用参数();
    表弹出(符号表);
}

// ==================== 主流程 ====================
// 输入节点池+程序根；输出诊断列表；返回 错误数
// 单文件 = 主模块形态包装（键基=纯名、无导入——行为与分桶前逐字节一致；
//   主.cn 负测自检序列沿用本入口）。快照参数传空平铺（标量向量局部构造——
//   成熟路径；嵌套容器/临时值追加禁用，lessons 15 枚同族）
函数 语义分析(向量<节点> 池, 整32 程序节点, 向量<字符串>& 诊断) -> 整64 {
    向量<整32> 单节点们 = 向量<整32>();
    结果<空类型, 整32> 加n = 单节点们.追加(程序节点);
    如果 (!加n.正常) { 运行时错误(4); }
    向量<字符串> 单路径们 = 向量<字符串>();
    结果<空类型, 整32> 加p = 单路径们.追加("主");
    如果 (!加p.正常) { 运行时错误(4); }
    向量<整64> 空平铺 = 向量<整64>();
    向量<整64> 空边1 = 向量<整64>();
    向量<整64> 空公开 = 向量<整64>();
    // 边界向量与程序节点们平行（每文件一项=该文件在总表中的起始偏移）——
    //   单文件形态须配对传入（切片段 边界们.元素(j) 防越界）
    结果<空类型, 整32> 加b1 = 空边1.追加(0);
    如果 (!加b1.正常) { 运行时错误(4); }
    返回 语义分析多文件(池, 单节点们, 单路径们, 空平铺, 空边1, 空公开, 诊断);
}

// ==================== 主流程（多文件 P6h + 模块分桶 plans/018 第 3 层） ====================
// 多源文件：程序节点们 = 各文件 程序 节点索引（加载器按依赖先解析的顺序收集）；
//   模块路径们 = 每文件模块路径；导入项平铺总表/导入模块总表 = 全部文件 ②③
//   快照拼接（边界们[f]=文件 f 起始偏移，段=[边界[f], 边界[f+1] 或 总表尾)）；
//   公开平铺总表 = 全部文件 公开: 标签快照拼接（交替 [声明节点索引, 1]——
//   节点索引全池唯一，无需边界）。
// 第一趟：全部文件 声明收集（链接键分桶登记+模块成员索引+可见性）；
// 第二趟：逐文件 构建文件导入上下文（② 导入目标+E0255+③ glob 清单）后检查
//   函数体（三级解析）。返回 诊断数（含查找链路诊断缓冲合入）。
函数 语义分析多文件(向量<节点> 池, 向量<整32> 程序节点们,
                    向量<字符串>& 模块路径们,
                    向量<整64>& 导入项平铺总表, 向量<整64>& 导入项边界们,
                    向量<整64>& 公开平铺总表,
                    向量<字符串>& 诊断) -> 整64 {
    向量<映射<整64, 符号>> 符号表 = 向量<映射<整64, 符号>>();
    表压入(符号表);  // 全局作用域（全部文件 函数/结构体 声明）
    清空调用决议();   // plans/018 第 4 层：调用决议表任务级生命周期
    清空模块解析表(); // 模块成员索引/导入上下文/三级缓存 任务级生命周期
    清空函数签名();  // 呈报③方案A：函数签名表任务级生命周期（入口清空）
    清空重放检查状态();  // 470-a（D10 v2 面）：已重放函数实例表任务级生命周期
    // 公开表构建（平铺 -> 映射点查：声明收集 按节点索引查可见性）
    映射<整64, 整64> 公开表 = 映射<整64, 整64>();
    整64 oi = 0;
    当 (oi + 1 < 公开平铺总表.大小()) {
        结果<空类型, 整32> 设公 = 公开表.设置(公开平铺总表.元素(oi), 1);
        如果 (!设公.正常) { 运行时错误(4); }
        oi += 2;
    }
    整64 i = 0;
    当 (i < 程序节点们.大小()) {
        声明收集(池, 程序节点们.元素(整32(i)), 符号表, 诊断,
                 模块路径们.元素(整32(i)), 公开表);
        i++;
    }
    // ③ 合并全局可见的遍历范围=加载树全部模块 ID（stdlib 不在成员索引天然 miss）。
    //   模块集合去重（plans/018 v2self 锚定轮根治，宿主 findModule 模块表唯一化对齐）：
    //   模块路径们 是文件级快照（每文件一条）——目录包根与撞名成员共享模块路径
    //   （候选1b 包根本模块路径=模块名，成员 代码生成.cn 挂载名同为「代码生成」；
    //   货舱解析 同款），重复条目使 ③ 遍历对同一模块双计数：同签名第二命中
    //   参串标==首参串标 恒真 -> 同名纯名调用假报 E0659 歧义（来源们=自拼接
    //   「货舱解析/货舱解析」，v2self 实测）。映射 O(1) 查重=模块集合语义归一。
    向量<整64> 全部模块ID们 = 向量<整64>();
    映射<整64, 整64> 已见模块集合 = 映射<整64, 整64>();
    整64 mi2 = 0;
    当 (mi2 < 模块路径们.大小()) {
        整64 模块IDg = 驻留(模块路径们.元素(整32(mi2)));
        结果<整64, 整32> 查见g = 已见模块集合.获取(模块IDg);
        如果 (!查见g.正常) {
            结果<空类型, 整32> 加g2 = 全部模块ID们.追加(模块IDg);
            如果 (!加g2.正常) { 运行时错误(4); }
            结果<空类型, 整32> 设见g = 已见模块集合.设置(模块IDg, 1);
            如果 (!设见g.正常) { 运行时错误(4); }
        }
        mi2++;
    }
    整64 j = 0;
    当 (j < 程序节点们.大小()) {
        // 每文件检查前：从总表切本文件 ② 段（局部标量向量）+构建导入上下文
        //   （E0255/私有/存在性诊断仅此一处）
        整64 平铺起 = 导入项边界们.元素(整32(j));
        整64 平铺终 = 导入项平铺总表.大小();
        如果 (j + 1 < 导入项边界们.大小()) { 平铺终 = 导入项边界们.元素(整32(j + 1)); }
        向量<整64> 本平铺段 = 向量<整64>();
        整64 si = 平铺起;
        当 (si < 平铺终) {
            结果<空类型, 整32> 加s = 本平铺段.追加(导入项平铺总表.元素(整32(si)));
            如果 (!加s.正常) { 运行时错误(4); }
            si++;
        }
        构建文件导入上下文(模块路径们.元素(整32(j)), 本平铺段, 全部模块ID们, 诊断, 假);
        节点 程序 = 池.元素(程序节点们.元素(整32(j)));
        整64 k = 整64(程序.子起点);
        当 (k < 整64(程序.子终点)) {
            节点 声明 = 池.元素(整32(k));
            如果 (声明.类型 == 节点_函数) {
                // plans/018 类型分桶：返回类型诊断（声明.附加=返回类型名ID）
                检查类型引用(符号表, 诊断, 整64(声明.附加));
                // 417-a（D42 波 3）：泛型函数体检查延后——基类 AST 的 T 表达式位
                //   无真实类型（rustc 同构=实例化后按克隆体检查·418 轮挂接）；
                //   签名登记（收集阶段）不受影响。
                如果 (查泛型基类参数序(整64(声明.文本)) == 0) {
                    检查函数(池, 整32(k), 符号表, 诊断);
                }
            }
            如果 (声明.类型 == 节点_类) {
                // 第七十八轮（2026-09-12）：类方法体检查——第三类函数级作用域
                //   单元（字段裸名解析 + 参数登记 + 借出检查挂载，见 语义检查类）
                // 417-a（D42 波 3）：泛型基类方法体检查延后（同上·实例克隆体为
                //   真实类型载体——波 2 生成链已按克隆体产出）
                如果 (查泛型基类参数序(整64(声明.文本)) == 0) {
                    检查类方法们(池, 整32(k), 符号表, 诊断);
                }
            }
            k++;
        }
        j++;
    }
    // 470-a（D10 v2 面·泛型函数实例体重放语义检查）：417-a「检查延后」欠账
    //   根治——实例体获得与非泛型体同级检查（未声明调用/返回类型误用编译期
    //   拒绝·此前静默到链接期爆/产物垃圾）。放 表弹出 前=全局符号层可用；
    //   诊断直达（check 期即拒·rustc instantiate+check 同构）。
    重放检查泛型函数实例(池, 程序节点们, 符号表, 诊断);
    表弹出(符号表);  // 释放全局作用域
    // 查找链路诊断缓冲合入（三级歧义 E0659——查找函数无诊断参数，缓冲聚合）
    整64 bi = 0;
    当 (bi < 取语义诊断数()) {
        表诊断(诊断, 取语义诊断(bi));
        bi++;
    }
    清空语义诊断缓冲();
    // 339-a（D38 批3a·304/372/374）：入口函数签名检查（宿主矩阵 z01/z02 定规·
    //   自包含现场扫描=零静态写·避 安全区边界 传染）
    检查入口函数签名(池, 程序节点们, 诊断);
// 157-a（plans/023 §十 步骤 5 收口）：诊断无分级——列表全量=语义错误数
//   （154-a 的「观察期警告不计入」排除已随收口删除：安全区边界=硬错误，
//   任何残留命中都必须计数并中止，观察期语义已结束）。
返回 诊断.大小();
}

// 339-a：结果<T,E> 退出码合法性（合成名 结果$T$E——$ 分割取 T/E 段·均须整数族
//   （退出码截断语义·344 wrapper 对齐）；格式异常=假（拒）
函数 结果退出码合法(字符串 合成名) -> 布尔 {
    整64 长 = 字符串长度(合成名);
    整64 第一 = 0 - 1;
    整64 第二 = 0 - 1;
    整64 i = 0;
    当 (i < 长) {
        如果 (字符串比较(字符串子串(合成名, i, 1), "$")) {
            如果 (第一 == 0 - 1) { 第一 = i; } 否则 如果 (第二 == 0 - 1) { 第二 = i; 中断; }
        }
        i++;
    }
    如果 (第一 == 0 - 1 || 第二 == 0 - 1) { 返回 假; }
    字符串 t段 = 字符串子串(合成名, 第一 + 1, 第二 - 第一 - 1);
    字符串 e段 = 字符串子串(合成名, 第二 + 1, 长 - 第二 - 1);
    返回 是转换整数族文本(t段) && 是转换整数族文本(e段);
}

// 339-a（D38 批3a·304/372/374）：入口函数签名检查（自包含现场扫描——静态写
//   须 不安全 函数=会沿收集链传染，故聚合点直接扫 顶层声明区）。规则=宿主矩阵
//   实测：①无 主 → 拒（304·宿主「未定义入口函数 主」对齐）；②主 参数非空 →
//   拒（372·入口约定无参·v2 编译期拒=优于宿主链接期）；③主 返回白名单=整32 ∨
//   结果<T,E>（T/E 均整数族·wrapper 退出码语义 344 对齐·z01 整64 拒/z02 过；
//   374 结果<字符串,整32> 拒）。多模块同名 主 取首个=诚实边界（主模块单一惯例）。
函数 检查入口函数签名(向量<节点> 池, 向量<整32> 程序节点们, 向量<字符串>& 诊断) -> 空类型 {
    布尔 主存在 = 假;
    字符串 主参数串 = "";
    整64 主返回 = 0;
    整64 文件序 = 0;
    当 (文件序 < 程序节点们.大小()) {
        整32 程序节点 = 程序节点们.元素(文件序);
        如果 (程序节点 >= 0 && 程序节点 < 整32(池.大小())) {
            节点 程序 = 池.元素(程序节点);
            整64 k = 整64(程序.子起点);
            当 (k < 整64(程序.子终点)) {
                节点 声明 = 池.元素(整32(k));
                如果 (声明.类型 == 节点_函数 && 整64(声明.文本) == 驻留("主") && !主存在) {
                    主存在 = 真;
                    主参数串 = 字符串复制(函数参数串(池, 整32(k)));
                    主返回 = 整64(声明.附加);
                }
                k++;
            }
        }
        文件序++;
    }
    如果 (!主存在) {
        表诊断(诊断, "[错误] 未定义入口函数 主");
        返回;
    }
    如果 (字符串长度(主参数串) > 0) {
        表诊断(诊断, "[错误] 入口函数 主 不能带参数（入口约定无参）");
    }
    布尔 主返回合法 = 主返回 == 驻留("整32");
    如果 (!主返回合法 && 主返回 > 0) {
        字符串 主返回文本 = 字符串复制(驻留文本(主返回));
        如果 (是结果类型(主返回文本) && 结果退出码合法(主返回文本)) {
            主返回合法 = 真;
        }
    }
    如果 (!主返回合法) {
        表诊断(诊断, "[错误] 入口 ABI 仅支持 整32 与 结果<T, E>——退出码=正常取 .值/错误取 .错误 码");
    }
}


// ==================== 470-a（D10 v2 面·泛型函数实例体重放语义检查） ====================
// 417-a「检查延后」欠账根治（D10）：泛型函数基类体在语义阶段从未被检查
//   （延后分支）——体内未声明调用/返回类型误用静默过→链接期爆或产物垃圾
//   （双侧同族实弹：非泛型同形态编译期拒绝〔p0 探针〕·泛型静默——检查缺口
//   非泛型专属语义）。宿主 317-a 重放=IR 生成阶段注记刷新（诊断快照回滚·
//   build 期）；本侧=语义阶段重放·诊断直达（check 期即拒·rustc typeck
//   instantiate+check 一体同构）。
// 重放语境=T 豁免（零环境映射）：类型参数名放行（语义分析 检查类型引用）+
//   返回比对拿 T 原文——抓 与 T 无关错误（未声明调用/标识符/结构性）与
//   返回字面量 vs T 误用；T 映射实参后可见的错误（T 值成员调用等）=波 2
//   单态化面（诚实边界·登记 plans/021）。
// 收集口径=模块区间扫 节点_调用 被调标识符（对齐 IR类 收集泛型实例·区间=
//   解析序平铺全段）；去重=实例合成名 ID 已重放表；构造调用 callee（类实
//   例合成名）剥基名无 节点_函数 命中自然跳过（类方法版=登记边界）。

静态 映射<整64, 整64> 已重放函数实例表;
静态 整64 重放豁免安全区 = 0;   // 470-a：重放语境 安全区边界 豁免标志
静态 映射<整64, 整64> 泛型重放环境;  // 477-a（D10 波2）：参数名ID→实参类型文本ID

不安全 函数 清空重放检查状态() -> 空类型 {
    已重放函数实例表.清空();
    重放豁免安全区 = 0;
    泛型重放环境.清空();
}

// 477-a：环境查映射（0=非环境键·非重放路径环境恒空=零开销直通）
函数 查重放环境(整64 类型名ID) -> 整64 {
    结果<整64, 整32> 查e = 泛型重放环境.获取(类型名ID);
    如果 (查e.正常) { 返回 查e.值; }
    返回 0;
}

函数 取重放豁免安全区() -> 布尔 {
    返回 重放豁免安全区 == 1;
}

不安全 函数 重放检查泛型函数实例(向量<节点> 池, 向量<整32> 程序节点们,
                        向量<映射<整64, 符号>>& 符号表, 向量<字符串> 诊断) -> 空类型 {
    // ① 基函数表（平行向量：基名ID / 节点索引）——顶层 节点_函数 且 名∈参数序表
    向量<整64> 基名表 = 向量<整64>();
    向量<整32> 基索引表 = 向量<整32>();
    整64 f = 0;
    当 (f < 程序节点们.大小()) {
        节点 程序声明 = 池.元素(程序节点们.元素(整32(f)));
        整64 位置 = 整64(程序声明.子起点);
        整64 终点 = 整64(程序声明.子终点);
        当 (位置 < 终点) {
            节点 n = 池.元素(整32(位置));
            如果 (n.类型 == 节点_函数 && 查泛型基类参数序(整64(n.文本)) != 0) {
                结果<空类型, 整32> 加b = 基名表.追加(整64(n.文本));
                如果 (!加b.正常) { 运行时错误(4); }
                结果<空类型, 整32> 加d = 基索引表.追加(整32(位置));
                如果 (!加d.正常) { 运行时错误(4); }
            }
            位置++;
        }
        f++;
    }
    如果 (基名表.大小() == 0) { 返回; }
    // ② 全池扫调用点（体内子树节点同在池·顶层区间只含顶层声明）→实例合成名
    //   →去重→对基类节点重放 检查函数
    整64 位置m = 0;
    当 (位置m < 池.大小()) {
        {
            节点 c = 池.元素(整32(位置m));
            如果 (c.类型 == 节点_调用 && c.子起点 > 0) {
                节点 被调 = 池.元素(整32(c.子起点));
                如果 (被调.类型 == 节点_标识符) {
                    字符串 被调文本 = 字符串复制(驻留文本(整64(被调.文本)));
                    字符串 基名 = 剥实例基名(被调文本);
                    如果 (!字符串比较(基名, 被调文本)) {
                        // 含 '$'（实例合成名·非裸名调用）
                        整64 基名ID = 整64(驻留(基名));
                        整64 bi = 0;
                        当 (bi < 基名表.大小()) {
                            如果 (基名ID == 基名表.元素(整32(bi))) {
                                整64 实例ID = 整64(被调.文本);
                                结果<整64, 整32> 查重 = 已重放函数实例表.获取(实例ID);
                                如果 (!查重.正常) {
                                    // 首见实例：登记去重表+对基类节点重放检查
                                    //   （T* 形态安全区豁免=静态不可判定·波2 收口）
                                    结果<空类型, 整32> 加r = 已重放函数实例表.设置(实例ID, 1);
                                    如果 (!加r.正常) { 运行时错误(4); }
                                    // 477-a（D10 波2）：环境构建——参数序表拆段×
                                    //   实参段逐对映射（T→整32 等·464-a 递归拆段复用）
                                    整64 参数序ID477 = 查泛型基类参数序(基名ID);
                                    字符串 参数串477 = 字符串复制(驻留文本(参数序ID477));
                                    向量<整64> 参数名们477 = 向量<整64>();
                                    整64 段起477 = 0;
                                    整64 cc477 = 0;
                                    当 (cc477 <= 字符串长度(参数串477)) {
                                        如果 (cc477 == 字符串长度(参数串477) ||
                                             字符串比较(字符串子串(参数串477, 整32(cc477), 1), ",")) {
                                            如果 (cc477 > 段起477) {
                                                结果<空类型, 整32> 加n477 = 参数名们477.追加(整64(驻留(字符串子串(参数串477, 整32(段起477), 整32(cc477 - 段起477)))));
                                                如果 (!加n477.正常) { 运行时错误(4); }
                                            }
                                            段起477 = cc477 + 1;
                                        }
                                        cc477++;
                                    }
                                    向量<整64> 实参们477 = 向量<整64>();
                                    剥实例参数段(被调文本, 实参们477);
                                    整64 对477 = 0;
                                    当 (对477 < 参数名们477.大小() && 对477 < 实参们477.大小()) {
                                        结果<空类型, 整32> 设e477 = 泛型重放环境.设置(参数名们477.元素(整32(对477)), 实参们477.元素(整32(对477)));
                                        如果 (!设e477.正常) { 运行时错误(4); }
                                        对477++;
                                    }
                                    重放豁免安全区 = 1;
                                    检查函数(池, 基索引表.元素(整32(bi)), 符号表, 诊断);
                                    重放豁免安全区 = 0;
                                    泛型重放环境.清空();   // 477-a：环境随实例重放结束复位
                                }
                                中断;
                            }
                            bi++;
                        }
                    }
                }
            }
            位置m++;
        }
    }
}
