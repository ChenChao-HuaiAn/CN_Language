// CN 自举编译器 v2 · 语义检查（千行拆分子模块，2026-09-08 用户裁决阶段目录包）
// 职责：逐节点语义检查（成员偏移标注/检查表达式/检查语句/检查块/检查如果/
//   检查当/检查函数）——自 语义分析.cn 机械搬移；符号表经参数传递，模块
//   解析表经 公开: 访问函数（语义分析 主干）；模块路径=语义检查（新键基）。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（原 导入 语法分析，目录包名）
导入 IR;         // 容器/结果 合成名判定 + 节点_*/键位移 常量（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 借出检查;    // 第七十七轮 A21：借出视图生命周期检查（函数级调用）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

公开:   // 全文件公开（检查族+主流程供 包/主.cn 消费）

// 55-c 方案A（2026-09-10 第五十六轮 用户裁决，Rust E0308 对齐）：返回面混合
//   符号检查的当前函数返回类型名ID（节点_函数.附加，解析层经 驻留(返回类型名)
//   登记；引用后缀名「整64&」非整数族自动跳过）。检查函数 进入时设置/返回时
//   复位 -1；文件级静态——检查函数 与 检查语句 同文件（R3 拆分纪律）。
静态 整64 当前函数返回类型 = 0 - 1;
// plans/019 阶段2：当前函数引用参数名集（返回逃逸检查的豁免判定——引用参数
//   指向调用方存储，返回 &引用参数 合法；宿主 isRefParamForCurrentFn 对齐）
静态 向量<整64> 当前函数引用参数们;
// plans/019 阶段3：当前函数 常量 只读引用参数名集（赋值面只读纪律）
静态 向量<整64> 当前函数常量引用们;
// 153-a（plans/023 §八 v2 挂点基础设施）：**当前函数不安全修饰**——真=本函数为
//   不安全 函数（节点_函数.修饰==1，解析层回填）；检查函数 进入时设置/返回时复位。
//   9 类安全区边界挂点（指针算术/解引用读/解引用写/指针下标读/指针下标写/指针成员
//   访问/联合体字段/静态变量写/外部函数调用/裸释放）在 不安全 函数内豁免——与宿主
//   warnUnsafeBoundary 的 currentFnUnsafe_ 同构（plans/023 §八.2 双侧同构）。
静态 布尔 当前函数不安全 = 假;

// 155-a（plans/023 §八 B10 v2 挂点）：**顶层静态变量名ID集**——声明收集
//   （语义分析.cn 节点_静态声明 分支）追加；检查赋值语句 据此报「静态变量写」
//   （静态登记种类=符号_变量与普通变量同款，种类不可区分——名集合单点事实源）。
静态 向量<整64> 全局静态名ID们;
// 155-a：名ID 是否顶层静态（B10 判定）
函数 是全局静态名(整64 名ID) -> 布尔 {
    整64 i = 0;
    当 (i < 全局静态名ID们.大小()) {
        如果 (全局静态名ID们.元素(整32(i)) == 名ID) { 返回 真; }
        i++;
    }
    返回 假;
}

// 156-a（plans/023 §八）：**当前函数不安全 设置访问器**——静态变量文件级私有，
//   语义检查类.cn（类方法检查）跨文件经本访问器设置（检查方法 读 节点_方法.修饰）。
不安全 函数 设当前函数不安全(布尔 值) -> 空类型 {
    当前函数不安全 = 值;
}

// 218（027 波2b·001 §5.8b sunset 收窄）：当前函数不安全 读取——检查调用表达式
//   新线程 实参位 顶层 空类型* 豁免的 不安全 区条件（§1.1a④）
不安全 函数 读当前函数不安全() -> 布尔 {
    返回 当前函数不安全;
}

// 575-a（T100·299）：当前方法常量槽——常量 成员函数内修改成员检查上下文
//   （语义检查类.cn 检查方法 设/清；检查赋值语句 消费）。静态变量文件级
//   私有·访问器同 设当前函数不安全 惯例。
静态 布尔 当前方法常量 = 假;

不安全 函数 设当前方法常量(布尔 值) -> 空类型 {
    当前方法常量 = 值;
}

不安全 函数 读当前方法常量() -> 布尔 {
    返回 当前方法常量;
}

// 155-a（A1 v2 挂点）：是否**裸指针类型文本**（以 * 结尾）——`字符*` 是
//   字符串视图（波 1 教训：isStringSemanticType 同族）排除；数组类型文本
//   （X[N]）不以 * 结尾天然不命中。
函数 是裸指针类型文本(字符串 类型文本) -> 布尔 {
    整64 长 = 字符串长度(类型文本);
    如果 (长 <= 0) { 返回 假; }
    如果 (字符串比较(类型文本, "字符*")) { 返回 假; }
    字符 末c = 类型文本[长 - 1];
    返回 末c == '*';
}

// 154-a（plans/023 §八 v2 挂点）/ 157-a（§十 步骤 5 收口）：**安全区边界错误**
//   ——宿主 reportUnsafeBoundary 的 v2 同构（当前函数不安全 时零诊断；文案
//   与宿主逐字一致=双侧同构；收口后=硬错误，观察期字样已删）。
函数 错误不安全边界(向量<字符串>& 诊断, 字符串 类别, 字符串 明细) -> 空类型 {
    如果 (当前函数不安全) { 返回; }
    // 470-a：泛型基类体重放语境豁免——T* 形态安全性取决于实参类型（静态不可
    //   判定）·对齐宿主重放诊断回滚效果（455 T* 下标先例·波2 单态化收口）
    如果 (取重放豁免安全区()) { 返回; }
    表诊断(诊断, "[安全区边界] " + 类别 + "应在 不安全 函数 内（" + 明细 + "）");
}

// ==================== 188-a（D6·plans/023 B11 变量常量传播）恒空指针判定表 ====================
//   背景：B11 原判据=操作数为 `无` 字面量；plans/023 §九 已批准定义含「编译期
//   常量」形态（`整64* p = 无; 整64 v = *p;`）——本表把它落实（宿主 semantic
//   nullSeeded_/nullDisqualified_/nullAssignEdges_/nullUseSites_ 同构）。
//   判定（保守·零假阳性）：变量 v 判「恒空」⇔ ① 至少一次以 `无` 字面量初始化/
//   赋值（种子，含经初始化/赋值传播自另一恒空变量——边不动点）∧ ② 全函数内无
//   任何其他写入（失格：非 `无` 赋值/复合赋值/自增自减/取地址/引用参数实参）。
//   使用点延迟登记，函数/方法体检查收尾统一判定并报硬错误（编译期零运行期开销；
//   Rust deref_nullptr lint 同构）。表为文件级静态 + 访问器跨子模块共享。
静态 向量<整64> 恒空种子们;
静态 向量<整64> 恒空失格们;
静态 向量<整64> 恒空边目标们;
静态 向量<整64> 恒空边源们;
静态 向量<整64> 恒空使用点名们;
静态 向量<整64> 恒空使用点行们;
静态 向量<整64> 恒空使用点面们;   // 1=解引用 2=成员访问 3=下标访问

函数 恒空名含(向量<整64> 名们, 整64 名ID) -> 布尔 {
    整64 i = 0;
    当 (i < 整64(名们.大小())) {
        如果 (名们.元素(整32(i)) == 名ID) { 返回 真; }
        i++;
    }
    返回 假;
}

函数 是恒空候选类型文本(字符串 类型文本) -> 布尔 {
    // 指针（尾 *：含 整64*/字符*/多级指针）或 字符串（视图含空值）——恒空判定面
    整64 长 = 字符串长度(类型文本);
    如果 (长 <= 0) { 返回 假; }
    字符 末c = 类型文本[长 - 1];
    如果 (末c == '*') { 返回 真; }
    如果 (字符串比较(类型文本, "字符串")) { 返回 真; }
    返回 假;
}

不安全 函数 登记恒空种子(整64 名ID) -> 空类型 {
    如果 (恒空名含(恒空种子们, 名ID)) { 返回; }
    结果<空类型, 整32> 加 = 恒空种子们.追加(名ID);
    如果 (!加.正常) { 运行时错误(4); }
}

不安全 函数 登记恒空失格(整64 名ID) -> 空类型 {
    如果 (恒空名含(恒空失格们, 名ID)) { 返回; }
    结果<空类型, 整32> 加 = 恒空失格们.追加(名ID);
    如果 (!加.正常) { 运行时错误(4); }
}

不安全 函数 登记恒空边(整64 目标名ID, 整64 源名ID) -> 空类型 {
    结果<空类型, 整32> 加目 = 恒空边目标们.追加(目标名ID);
    如果 (!加目.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加源 = 恒空边源们.追加(源名ID);
    如果 (!加源.正常) { 运行时错误(4); }
}

不安全 函数 登记恒空使用点(整64 名ID, 整64 行, 整64 面) -> 空类型 {
    // 去重（同 名×行×面 视作同一使用点）：v2 语句区间线性遍历对同一 AST 节点
    //   可能二次到达（外层检查 + 区间扫描），宿主单遍无此问题——重复登记会让
    //   收尾判定同点双报（实证：d2/i2/p4 探针各报两次）
    整64 d = 0;
    当 (d < 整64(恒空使用点名们.大小())) {
        如果 (恒空使用点名们.元素(整32(d)) == 名ID &&
              恒空使用点行们.元素(整32(d)) == 行 &&
              恒空使用点面们.元素(整32(d)) == 面) {
            返回;
        }
        d++;
    }
    结果<空类型, 整32> 加名 = 恒空使用点名们.追加(名ID);
    如果 (!加名.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加行 = 恒空使用点行们.追加(行);
    如果 (!加行.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加面 = 恒空使用点面们.追加(面);
    如果 (!加面.正常) { 运行时错误(4); }
}

不安全 函数 清空恒空表() -> 空类型 {
    恒空种子们.清空();
    恒空失格们.清空();
    恒空边目标们.清空();
    恒空边源们.清空();
    恒空使用点名们.清空();
    恒空使用点行们.清空();
    恒空使用点面们.清空();
}

// 函数/方法体检查收尾：边不动点（p = q 且 q 恒空 → p 恒空）→ 使用点逐点判定 →
//   报 B11 硬错误（文案与字面量形态同族；面 1/2/3 → 解引用/成员访问/下标访问）。
不安全 函数 判定恒空报错(向量<字符串>& 诊断) -> 空类型 {
    布尔 变化 = 真;
    当 (变化) {
        变化 = 假;
        整64 e = 0;
        当 (e < 整64(恒空边目标们.大小())) {
            整64 目标e = 恒空边目标们.元素(整32(e));
            整64 源e = 恒空边源们.元素(整32(e));
            如果 (恒空名含(恒空失格们, 源e)) {
            } 否则 如果 (恒空名含(恒空种子们, 源e)) {
                如果 (!恒空名含(恒空种子们, 目标e)) {
                    结果<空类型, 整32> 加 = 恒空种子们.追加(目标e);
                    如果 (!加.正常) { 运行时错误(4); }
                    变化 = 真;
                }
            }
            e++;
        }
    }
    整32 保存行 = 取当前诊断行();
    整64 u = 0;
    当 (u < 整64(恒空使用点名们.大小())) {
        整64 名u = 恒空使用点名们.元素(整32(u));
        如果 (!恒空名含(恒空失格们, 名u)) {
            如果 (恒空名含(恒空种子们, 名u)) {
                设当前诊断行(整32(恒空使用点行们.元素(整32(u))));
                整64 面u = 恒空使用点面们.元素(整32(u));
                如果 (面u == 1) {
                    表诊断(诊断, "[错误] 编译期常量空指针解引用（确定性错误；plans/023 B11）");
                } 否则 如果 (面u == 2) {
                    表诊断(诊断, "[错误] 编译期常量空指针成员访问（确定性错误；plans/023 B11）");
                } 否则 {
                    表诊断(诊断, "[错误] 编译期常量空指针下标访问（确定性错误；plans/023 B11）");
                }
            }
        }
        u++;
    }
    设当前诊断行(保存行);
}

// plans/019 阶段2：名字是否当前函数引用参数（指向调用方存储——返回逃逸
//   豁免用；集合由 检查函数 收集，宿主 isRefParamForCurrentFn 对齐）
函数 是当前引用参数(整64 名ID) -> 布尔 {
    整64 i = 0;
    当 (i < 当前函数引用参数们.大小()) {
        如果 (当前函数引用参数们.元素(i) == 名ID) { 返回 真; }
        i++;
    }
    返回 假;
}

函数 清空当前引用参数() -> 空类型 {
    当前函数引用参数们.清空();
    当前函数常量引用们.清空();
}

// 55-c 当前函数返回类型 访问器（跨子模块读写——第七十八轮 类支持：语义检查类.cn
//   的 检查方法 需设置/复位同一静态；原为文件级私有直写）
不安全 函数 设当前函数返回类型(整64 类型ID) -> 空类型 {
    当前函数返回类型 = 类型ID;
}

函数 取当前函数返回类型() -> 整64 {
    返回 当前函数返回类型;
}

// plans/019 阶段3：名字是否当前函数常量（只读）引用参数
函数 是常量引用参数(整64 名ID) -> 布尔 {
    整64 i = 0;
    当 (i < 当前函数常量引用们.大小()) {
        如果 (当前函数常量引用们.元素(i) == 名ID) { 返回 真; }
        i++;
    }
    返回 假;
}

// ==================== 成员访问偏移标注（P6c） ====================
// 后缀栈遍历表达式区间 [起点, 终点)：标识符/字面量压类型；节点_成员 弹对象类型
//   查结构体字段偏移并写入节点.附加（IR 生成直接用）；节点_取地址/解引用 弹压类型。
// 返回 0=成功；-1=失败（类型未知/字段不存在）。
函数 标注成员偏移(向量<节点> 池, 整32 起点, 整32 终点,
                   向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 整64 {
    向量<整64> 类型栈 = 向量<整64>();
    整32 位置 = 起点;
    当 (位置 < 终点) {
        节点 n = 池.元素(位置);
        如果 (n.类型 == 节点_标识符) {
            整64 类型ID = 表查找类型ID(符号表, 整64(n.文本));
            如果 (类型ID == -1) { 返回 -1; }
            结果<空类型, 整32> 加 = 类型栈.追加(类型ID);
            如果 (!加.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_整数字面量) {
            结果<空类型, 整32> 加 = 类型栈.追加(驻留("整32"));
            如果 (!加.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_布尔字面量) {
            // 灰色点①根治（2026-09-04）：真/假 独立节点——类型栈压 布尔
            结果<空类型, 整32> 加布 = 类型栈.追加(驻留("布尔"));
            如果 (!加布.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_浮点字面量) {
            结果<空类型, 整32> 加 = 类型栈.追加(驻留("浮64"));
            如果 (!加.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_字符串字面量) {
            结果<空类型, 整32> 加 = 类型栈.追加(驻留("字符串"));
            如果 (!加.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_成员) {
            // 成员访问：偏移已由语法层写入 n.附加；字段类型暂按 整64
            结果<空类型, 整32> 加2 = 类型栈.追加(驻留("整64"));
            如果 (!加2.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_取地址) {
            // & 对象：类型不变（地址即 整64 槽）
            结果<空类型, 整32> 加3 = 类型栈.追加(驻留("整64"));
            如果 (!加3.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_解引用) {
            // * 指针：弹指针 -> 压 整64（暂标量）
            如果 (类型栈.大小() >= 1) {
                结果<空类型, 整32> 删2 = 类型栈.删除(类型栈.大小() - 1);
                如果 (!删2.正常) { 运行时错误(4); }
            }
            结果<空类型, 整32> 加4 = 类型栈.追加(驻留("整64"));
            如果 (!加4.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_二元运算 || n.类型 == 节点_调用 || n.类型 == 节点_下标) {
            // 二元/下标：弹2压1；调用：弹实参+被调，压 整64（暂）
            如果 (n.类型 == 节点_二元运算 || n.类型 == 节点_下标) {
                如果 (类型栈.大小() >= 2) {
                    结果<空类型, 整32> 删3 = 类型栈.删除(类型栈.大小() - 1);
                    如果 (!删3.正常) { 运行时错误(4); }
                    结果<空类型, 整32> 删4 = 类型栈.删除(类型栈.大小() - 1);
                    如果 (!删4.正常) { 运行时错误(4); }
                }
            } 否则 {
                整64 弹数 = n.附加 + 1;  // 实参 + 被调
                当 (弹数 > 0 && 类型栈.大小() > 0) {
                    结果<空类型, 整32> 删5 = 类型栈.删除(类型栈.大小() - 1);
                    如果 (!删5.正常) { 运行时错误(4); }
                    弹数--;
                }
            }
            结果<空类型, 整32> 加5 = 类型栈.追加(驻留("整64"));
            如果 (!加5.正常) { 运行时错误(4); }
        }
        位置++;
    }
    返回 0;
}

// ③ 第六波（2026-09-03）：三元两分支类型可合并判定——同ID 或同类数值族宽化
//   （整数族：整8/16/32/64、正8/16/32/64、布尔、字符 互通——真/假=1/0 字面量
//   语义、字符=零扩展整数，槽统一 8 字节 Load 整64 无损；浮点族：浮32/64 互通）。
//   跨类（整 vs 浮：位模式不同 / 字符串 vs 整数：指针槽 vs 数值槽）拒绝——
//   Rust if 表达式同款纪律（无隐式跨类转换）
函数 类型可合并(整64 类型A, 整64 类型B) -> 布尔 {
    如果 (类型A == 类型B) { 返回 真; }
    字符串 名A = 字符串复制(驻留文本(类型A));
    字符串 名B = 字符串复制(驻留文本(类型B));
    布尔 A整数 = 字符串比较(名A, "整8") || 字符串比较(名A, "整16") ||
                  字符串比较(名A, "整32") || 字符串比较(名A, "整64") ||
                  字符串比较(名A, "整128") ||
                  字符串比较(名A, "正8") || 字符串比较(名A, "正16") ||
                  字符串比较(名A, "正32") || 字符串比较(名A, "正64") ||
                  字符串比较(名A, "正128") ||
                  字符串比较(名A, "布尔") || 字符串比较(名A, "字符");
    布尔 B整数 = 字符串比较(名B, "整8") || 字符串比较(名B, "整16") ||
                  字符串比较(名B, "整32") || 字符串比较(名B, "整64") ||
                  字符串比较(名B, "整128") ||
                  字符串比较(名B, "正8") || 字符串比较(名B, "正16") ||
                  字符串比较(名B, "正32") || 字符串比较(名B, "正64") ||
                  字符串比较(名B, "正128") ||
                  字符串比较(名B, "布尔") || 字符串比较(名B, "字符");
    如果 (A整数 && B整数) { 返回 真; }
    布尔 A浮点 = 字符串比较(名A, "浮32") || 字符串比较(名A, "浮64");
    布尔 B浮点 = 字符串比较(名B, "浮32") || 字符串比较(名B, "浮64");
    如果 (A浮点 && B浮点) { 返回 真; }
    返回 假;
}

// 93-a（2026-09-13 第九十三轮）：类名.成员 拒绝——用户类名直接访问实例成员。
//   宿主 93-a 同款纪律（semantic_call/semantic_expr：类名.实例方法()/类名.实例
//   字段 编译期拒绝，Rust「类名.成员 仅静态成员合法」对齐）；v2 类支持第一版
//   无静态成员（IR类.cn 第一版范围），故「用户类名.成员」任何形态皆非法——须经
//   实例（`实例.成员`）。修复前 IR 层按对象=未声明标识符退化生成（探针 M1/M3/M4
//   实证：读垃圾值 / 静默写入）。判定：对象=标识符 且 是用户类 且 非变量遮蔽
//   （变量遮蔽时按实例语义——与宿主 receiverIsTypeName 判定同款）。遮蔽判据=
//   符号种类 ∈ {符号_变量, 符号_参数}：类名自身在符号表登记为 符号_结构体
//   （种类 4——探针调试实证；若按 表查找类型ID != -1 判定会把类名自身误判为
//   变量，检查永不命中）。
//   命中即诊断（调用方继续既有路径，诊断令主链中止——不产 IR/asm）。返回 真=命中。
函数 检查类名成员访问(向量<节点> 池, 整32 成员节点索引,
                        向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 布尔 {
    节点 m = 池.元素(成员节点索引);
    如果 (m.子起点 <= 0 || 整64(m.子起点) >= 池.大小()) { 返回 假; }
    节点 对象m = 池.元素(整32(m.子起点));
    如果 (对象m.类型 != 节点_标识符) { 返回 假; }
    如果 (!是用户类ID(整64(对象m.文本))) { 返回 假; }
    整64 种类m = 表查找种类(符号表, 整64(对象m.文本));
    如果 (种类m == 符号_变量 || 种类m == 符号_参数) { 返回 假; }
    // 070 波G（1026）：静态成员放行——类名.静态方法（类静态方法表）∪ 类名.
    //   静态字段（类静态字段合成名表）→ 不诊断（后续路径按静态语义消费——
    //   静态方法调用/静态字段读写·IR 层对应生成见 生成方法调用/生成字段访问）
    如果 (是类静态方法(整64(对象m.文本), 整64(m.文本))) { 返回 假; }
    如果 (查类静态字段合成名(整64(对象m.文本), 整64(m.文本)) != 0) { 返回 假; }
    表诊断(诊断, "[错误] 类名不能直接访问实例成员: " +
                  驻留文本(整64(对象m.文本)) + "." + 驻留文本(整64(m.文本)) +
                  "（须经实例；类名仅静态成员可直接访问——v2 类支持第一版无静态成员）");
    返回 真;
}

// 检查表达式：返回类型ID（-1=未知）；未声明标识符 -> 诊断。
//   R3 拆分（2026-09-08）：标识符/下标/调用 三大分支族分派至 语义检查表达式
//   模块（语义检查表达式.cn），本函数保留字面量/成员/取地址解引用/二元/三元。
函数 检查表达式(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    如果 (n.类型 == 节点_整数字面量) { 返回 驻留("整32"); }
    // 灰色点①根治（2026-09-04）：真/假 独立节点——类型推导 布尔（三元分支
    //   类型可合并判定 布尔∈整数族 互通不变）
    如果 (n.类型 == 节点_布尔字面量) { 返回 驻留("布尔"); }
    如果 (n.类型 == 节点_浮点字面量) { 返回 驻留("浮64"); }
    如果 (n.类型 == 节点_字符串字面量) { 返回 驻留("字符串"); }
    // 95-a（2026-09-13 第九十五轮）：字符字面量——类型 字符（值=Unicode 码点）
    如果 (n.类型 == 节点_字符字面量) { 返回 驻留("字符"); }
    如果 (n.类型 == 节点_标识符) {
        返回 检查标识符表达式(池, 节点索引, 符号表, 诊断);
    }
    如果 (n.类型 == 节点_成员) {
        返回 检查成员访问表达式(池, 节点索引, 符号表, 诊断);
    }
    如果 (n.类型 == 节点_下标) {
        返回 检查下标表达式(池, 节点索引, 符号表, 诊断);
    }
    如果 (n.类型 == 节点_取地址 || n.类型 == 节点_解引用) {
        返回 检查取地址解引用表达式(池, 节点索引, 符号表, 诊断);
    }
    如果 (n.类型 == 节点_调用) {
        返回 检查调用表达式(池, 节点索引, 符号表, 诊断);
    }
    如果 (n.类型 == 节点_二元运算) {
        返回 检查二元运算表达式(池, 节点索引, 符号表, 诊断);
    }
    如果 (n.类型 == 节点_三元运算) {
        返回 检查三元运算表达式(池, 节点索引, 符号表, 诊断);
    }
    如果 (n.类型 == 节点_错误传播) {
        返回 检查错误传播表达式(池, 节点索引, 符号表, 诊断);
    }
    // 894-a（070·G-N 特性波3）：自增/自减**表达式位**（407）——左值区间逐节点
    //   检查 + 标识符左值声明性/常量拒绝（语句位 节点_自增 核心守卫同构）+
    //   返回左值类型（表达式类型=左值类型）。恒空失格登记（自增=隐式写入）。
    如果 (n.类型 == 节点_自增表达式) {
        整64 检z = 整64(n.子起点);
        当 (检z < 整64(n.子终点)) {
            整64 忽略z = 检查表达式(池, 整32(检z), 符号表, 诊断);
            检z++;
        }
        节点 左末z = 池.元素(整32(n.子终点 - 1));
        如果 (左末z.类型 == 节点_标识符) {
            登记恒空失格(整64(左末z.文本));
            整64 左类型z = 表查找类型ID(符号表, 整64(左末z.文本));
            如果 (左类型z == -1 && 查当前检查类ID() != 0 &&
                 查类静态字段类型(查当前检查类ID(), 整64(左末z.文本)) != 0) {
                左类型z = 查类静态字段类型(查当前检查类ID(), 整64(左末z.文本));
            }
            如果 (左类型z == -1) {
                表诊断(诊断, "[错误] 自增目标未声明: " + 驻留文本(整64(左末z.文本)));
            }
            如果 (表查找种类(符号表, 整64(左末z.文本)) == 符号_常量) {
                表诊断(诊断, "[错误] 不能对常量自增（常量初始化后不可修改）: " +
                              驻留文本(整64(左末z.文本)));
            }
            返回 左类型z;
        }
        返回 -1;
    }
    // 894-a（070·G-N 特性波3）：链式赋值表达式位（287 `整32 y = x = 5;` 的
    //   内层赋值根）——左值声明性/常量拒绝（语句位 检查赋值语句 核心守卫
    //   同构）+右值区间递归检查（外层表达式逐节点检查不重复消费赋值根）
    //   +返回**左值类型**（赋值表达式类型=左值类型·宿主 AssignmentExpr 同构）
    如果 (n.类型 == 节点_赋值) {
        如果 (n.文本 != 0) {
            整64 左类型c = 表查找类型ID(符号表, 整64(n.文本));
            如果 (左类型c == -1 && 查当前检查类ID() != 0 &&
                 查类静态字段类型(查当前检查类ID(), 整64(n.文本)) != 0) {
                // 070 波G：类内静态字段裸名赋值（同 自增 口径）
                左类型c = 查类静态字段类型(查当前检查类ID(), 整64(n.文本));
            }
            如果 (左类型c == -1) {
                表诊断(诊断, "[错误] 赋值目标未声明: " + 驻留文本(整64(n.文本)));
            }
            如果 (表查找种类(符号表, 整64(n.文本)) == 符号_常量) {
                表诊断(诊断, "[错误] 不能对常量赋值（常量初始化后不可修改）: " +
                              驻留文本(整64(n.文本)));
            }
            整64 检i = 整64(n.子起点);
            当 (检i < 整64(n.子终点)) {
                整64 忽略c = 检查表达式(池, 整32(检i), 符号表, 诊断);
                检i++;
            }
            返回 左类型c;
        }
        返回 -1;
    }
    返回 -1;
}

// ==================== 296-a（D35 波B·2026-09-17）错误传播检查 ====================

// 后缀错误传播 表达式? 检查（宿主 visitUnaryExpr Operator::Propagate 同构）：
//   ①操作数类型须 结果<T,E>/可选<T>（表达式类型ID 经操作数段末节点推导；
//     推导失败 -1 跳过=级联防不误伤）；②当前函数返回类型须 结果/可选（顶层
//     常量等语境 -1 跳过）；③回填 IR 标注：n.附加=操作数类型合成名ID、
//   n.文本=函数返回类型合成名ID（生成错误传播 直读——装箱构造 子终点 标注
//   同款「语义驱动 IR」模式）。返回 值类型（操作数实参1=T）名ID。
函数 检查错误传播表达式(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    // 操作数段=[子起点, 子终点)（子终点=本节点自身索引·三元同款），末节点=子终点-1
    整64 操作数类型 = -1;
    如果 (n.子终点 > n.子起点) {
        操作数类型 = 表达式类型ID(池, 整32(n.子终点 - 1), 符号表, 诊断);
    }
    如果 (操作数类型 > 0 &&
         !是结果类型_ID(操作数类型)) {
        表诊断(诊断, "[错误] 错误传播 ? 操作数须为 结果/可选 类型: " +
                      字符串复制(驻留文本(操作数类型)));
    }
    // 当前函数返回类型检查（-1=顶层常量等无函数语境，跳过=级联防）
    整64 返回类型ctx = 当前函数返回类型;
    如果 (返回类型ctx >= 0) {
        如果 (!是结果类型_ID(返回类型ctx)) {
            表诊断(诊断, "[错误] 错误传播 ? 须在返回 结果/可选 的函数中使用");
        }
    } 否则 {
        返回类型ctx = 0;
    }
    如果 (操作数类型 <= 0 || 返回类型ctx <= 0) {
        // 推导失败（级联错误语境）不标注——IR 层按缺标注诊断 fail fast
        如果 (操作数类型 > 0) { 返回 操作数类型; }
        返回 -1;
    }
    n.附加 = 整32(操作数类型);
    n.文本 = 整32(返回类型ctx);
    结果<空类型, 整32> 设传n = 池.设置(节点索引, n);
    如果 (!设传n.正常) { 运行时错误(4); }
    // 表达式值类型 = 操作数 T（实参1）——声明位同型校验消费
    返回 驻留(段首(合成名首实参(字符串复制(驻留文本(操作数类型)))));
}

// ==================== 197-a 类型分支族子方法（原 检查表达式 371~526 段） ====================

// 族①：成员访问检查（原 371~390 段）——93-a 类名.成员 拒绝 +
//   188-a（D6 B11 变量常量传播）编译期常量空指针成员访问硬错误 +
//   指针对象的变量形态使用点登记（面=成员访问）。返回 整64。
// 340-j：当前检查类ID 槽（检查类方法们 设/清·成员访问可见性豁免消费）
静态 映射<整64, 整64> 当前检查类槽;

函数 设当前检查类ID(整64 类名ID) -> 空类型 {
    结果<空类型, 整32> 设 = 当前检查类槽.设置(0, 类名ID);
    如果 (!设.正常) { 运行时错误(4); }
}

// 070 波G：查当前检查类ID（0=非类方法体上下文——类内静态字段裸名回退消费）
函数 查当前检查类ID() -> 整64 {
    结果<整64, 整32> 查 = 当前检查类槽.获取(0);
    如果 (查.正常) { 返回 查.值; }
    返回 0;
}

// 070 波H：当前语义函数名槽（友元豁免判定——友元函数体内私有访问授权）
静态 整64 当前语义函数名槽 = 0;
//   不安全 函数=静态槽写（安全区边界观察期口径·与 当前检查类槽 同族）
不安全 函数 设当前语义函数名(整64 函数名ID) -> 空类型 {
    当前语义函数名槽 = 函数名ID;
}

函数 查当前语义函数名() -> 整64 {
    返回 当前语义函数名槽;
}

函数 取当前检查类ID() -> 整64 {
    结果<整64, 整32> 查 = 当前检查类槽.获取(0);
    如果 (查.正常) { 返回 查.值; }
    返回 0;
}

// 375 辅助：下标/成员链根类型ID——下标（子起点=数组对象节点）递归/成员
//   （推导成员类型ID·46-a 精确推导）/标识符（表查找类型ID）。返回链根类型
//   名ID；-1=不可推导（调用方跳过=诚实边界）。联合体安全区下标链执法消费。
函数 推导链根类型ID375(向量<节点> 池, 整32 节点索引,
                     向量<映射<整64, 符号>>& 符号表,
                     向量<字符串>& 诊断) -> 整64 {
    如果 (节点索引 < 0 || 节点索引 >= 整32(池.大小())) { 返回 0 - 1; }
    节点 n = 池.元素(节点索引);
    如果 (n.类型 == 节点_下标 && n.子起点 > 0) {
        返回 推导链根类型ID375(池, 整32(n.子起点), 符号表, 诊断);
    }
    如果 (n.类型 == 节点_成员) {
        返回 推导成员类型ID(池, 节点索引, 符号表, 诊断);
    }
    如果 (n.类型 == 节点_标识符) {
        返回 表查找类型ID(符号表, 整64(n.文本));
    }
    返回 0 - 1;
}

// 375 辅助：类型文本剥一层数组后缀 `基名[N]` → `基名`（ASCII 91='[' 93=']'——
//   UTF-8 中文类型名多字节序列高字节 ≥0x80 不受影响）。无后缀原样返回。
函数 剥一层数组后缀375(字符串 类型文本) -> 字符串 {
    整64 长v375 = 字符串长度(类型文本);
    如果 (长v375 > 0 && ((整64(类型文本[整32(长v375 - 1)]) & 255) == 93)) {
        整64 i375 = 长v375 - 1;
        当 (i375 >= 0 && ((整64(类型文本[整32(i375)]) & 255) != 91)) {
            i375--;
        }
        如果 (i375 >= 0) { 返回 字符串子串(类型文本, 0, 整32(i375)); }
    }
    返回 字符串复制(类型文本);
}

函数 检查成员访问表达式(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    // 成员访问：偏移已标注到附加；字段类型暂 整64
    // 93-a：类名.成员 拒绝（用户类名直接访问实例成员——宿主同款纪律；
    //   修复前按未声明标识符退化生成=读垃圾/静默写，探针 M3/M4 实证）
    布尔 命中类名 = 检查类名成员访问(池, 节点索引, 符号表, 诊断);
    如果 (命中类名) { }
    // 188-a（D6·plans/023 B11 变量常量传播）：`无.字段` 字面量形态（编译期
    //   常量空指针成员访问）硬错误 + 指针对象的变量形态使用点登记（面=成员访问）
    如果 (n.子起点 > 0 && 整64(n.子起点) < 池.大小()) {
        节点 对象y188 = 池.元素(整32(n.子起点));
        如果 (对象y188.类型 == 节点_整数字面量 && 对象y188.附加 == 1) {
            表诊断(诊断, "[错误] 编译期常量空指针成员访问（确定性错误；plans/023 B11）");
        } 否则 如果 (对象y188.类型 == 节点_标识符) {
            如果 (查语义指针变量(整64(对象y188.文本)) >= 0) {
                登记恒空使用点(整64(对象y188.文本), 整64(取当前诊断行()), 2);
            }
        }
    }
    // 101（1023·plans/023 §八 A3 v2 挂点补齐·008 序②）：**联合体字段访问**——
    //   共享内存无 tag=类型安全结构性缺口（Rust union 同为 unsafe-only）——
    //   接收者类型名∈联合体键基们（46-e 解析登记·键基合成(当前模块, 类型名)
    //   同公式·指针接收者剥尾星=宿主 probeType 同构；跨模块导入联合体=诚实
    //   边界·v2 树/stdlib 存量双零）。文案与宿主逐字一致（157-a 同构纪律）。
    //   正位说明：主表达式面=本函数（检查表达式 分派·成员读全路径）——023 §八
    //   原载 推导成员类型ID=推断声明专用面（诊断多被静默丢弃·1019 实测零触发）。
    如果 (n.子起点 > 0 && 整64(n.子起点) < 池.大小()) {
        节点 对象v101 = 池.元素(整32(n.子起点));
        如果 (对象v101.类型 == 节点_标识符) {
            整64 对象类型v101 = 表查找类型ID(符号表, 整64(对象v101.文本));
            如果 (对象类型v101 > 0) {
                字符串 类型文本v101 = 字符串复制(驻留文本(对象类型v101));
                整64 长v101 = 字符串长度(类型文本v101);
                如果 (长v101 > 0 &&
                     (整64(类型文本v101[整32(长v101 - 1)]) & 255) == 42) {
                    类型文本v101 = 字符串子串(类型文本v101, 0,
                                              整32(长v101 - 1));
                }
                如果 (字符串长度(类型文本v101) > 0 &&
                     是联合体键基(键基合成(取当前模块路径(),
                                          驻留(类型文本v101)))) {
                    错误不安全边界(诊断, "联合体字段访问",
                                 类型文本v101 + "." +
                                 字符串复制(驻留文本(整64(n.文本))));
                }
            }
        } 否则 如果 (对象v101.类型 == 节点_下标) {
        // 375（v17 六族对齐批·001 §739 第7类）：联合体安全区执法扩**下标/成员
        //   链形态**——对象=节点_下标（表[1].i）或成员链末端（b.表[1].i）时，
        //   链根类型剥一层数组后缀命中联合体键基同拒（宿主 visitMemberExpr
        //   probeType=arrayElemOf 同构·剥一层对齐宿主单层 arrayElemOf——多层
        //   联合体数组宿主亦 miss 放行=同口径诚实边界）。v2 修前只拦联合体
        //   变量直访——c359 build_err+结构体内嵌探针实证。文案与直访逐字一致。
            向量<字符串> 静默诊断375 = 向量<字符串>();
            整64 链根类型375 = 推导链根类型ID375(池, 整32(n.子起点), 符号表, 静默诊断375);
            如果 (链根类型375 > 0) {
                字符串 链根文本375 = 字符串复制(驻留文本(链根类型375));
                整64 长尾375 = 字符串长度(链根文本375);
                // 剥指针尾星（直访形态 598 同款）再剥一层 数组后缀 `[...]`
                如果 (长尾375 > 0 && ((整64(链根文本375[整32(长尾375 - 1)]) & 255) == 42)) {
                    链根文本375 = 字符串子串(链根文本375, 0, 整32(长尾375 - 1));
                    长尾375 = 字符串长度(链根文本375);
                }
                如果 (长尾375 > 0 && ((整64(链根文本375[整32(长尾375 - 1)]) & 255) == 93)) {
                    链根文本375 = 剥一层数组后缀375(链根文本375);
                }
                如果 (字符串长度(链根文本375) > 0 &&
                     是联合体键基(键基合成(取当前模块路径(),
                                          驻留(链根文本375)))) {
                    错误不安全边界(诊断, "联合体字段访问",
                                 链根文本375 + "." +
                                 字符串复制(驻留文本(整64(n.文本))));
                }
            }
        }
    }
    // 340-a（D38 批3b·347）：类私有成员可见性设防——对象类型=类（类节点索引
    //   命中）时扫类节点子区间 节点_类字段：命中成员且 子起点=0（私有/保护段）
    //   → 拒（宿主「无法访问 成员 'x'（甲 的私有成员）」措辞对齐）。类方法体内
    //   裸名访问不经成员访问=零豁免需求（p1 实证）；方法可见性=诚实边界
    //   （347 目标形态=字段面）。
    如果 (n.子起点 > 0 && 整64(n.子起点) < 池.大小()) {
        节点 对象v = 池.元素(整32(n.子起点));
        如果 (对象v.类型 == 节点_标识符) {
            整64 对象类型v = 表查找类型ID(符号表, 整64(对象v.文本));
            如果 (对象类型v > 0) {
                整64 类节点v = 查类节点索引(对象类型v);
                如果 (类节点v >= 0 && 类节点v < 整64(池.大小())) {
                    节点 类节点值v = 池.元素(整32(类节点v));
                    整64 mv = 整64(类节点值v.子起点);
                    当 (mv < 整64(类节点值v.子终点)) {
                        节点 成员v = 池.元素(整32(mv));
                        如果 (成员v.类型 == 节点_类字段 &&
                             整64(成员v.文本) == 整64(n.文本) &&
                             整64(成员v.子起点) == 0) {
                            // 340-j：类上下文豁免——本类方法体内经 自身. 访问
                            //   私有字段=合法（50_class_private 宿主绿实证）
                            如果 (取当前检查类ID() == 对象类型v) { 中断; }
                            // 070 波H：友元豁免——当前函数 ∈ 该类友元授权表 →
                            //   私有访问合法（宿主 friend 语义·28 友元函数经
                            //   账户* 参数访问私有余额）
                            如果 (查友元授权(对象类型v, 查当前语义函数名())) { 中断; }
                            表诊断(诊断, "[错误] 无法访问 成员 '" +
                                          驻留文本(整64(n.文本)) + "'（" +
                                          驻留文本(对象类型v) + " 的私有成员）");
                            中断;
                        }
                        mv++;
                    }
                }
            }
        }
    }
    // 045b（丙案·2026-10-05·三销合一升格）：规则3 错误级——结果/可选 分族检查
    //   （宿主 checkResultMember 逐字同构·001 §07 规则3 定「错误」级实现无权
    //   降级）——结果 .值 须 正常 标/.错误 须 错误 标；可选 .值 须 有值 标。
    //   守卫识别先行+选择情况段跳过+条件区标语境内检查（检查如果 重构）后，
    //   双查语境已同标（观察期警告退役·1028 甲案撤除=T63 分叉销账）。
    //   类别判定按族（不跨族兼容）：结果变量只打 正常/错误 标，可选只打 有值
    //   标；跨族键碰撞由遮蔽声明 kill 消解（592 口径）。
    如果 (n.子起点 > 0 && 整64(n.子起点) < 池.大小()) {
        节点 对象r3v = 池.元素(整32(n.子起点));
        如果 (对象r3v.类型 == 节点_标识符) {
            整64 对象类型r3v = 表查找类型ID(符号表, 整64(对象r3v.文本));
            整64 成员名r3v = 整64(n.文本);
            如果 (对象类型r3v > 0 && 是结果类型_ID(对象类型r3v) &&
                 !是可选类型_ID(对象类型r3v)) {
                整64 已查r3v = 查结果已查(整64(对象r3v.文本));
                如果 (成员名r3v == 整64(驻留("值"))) {
                    如果 (已查r3v != 整64(驻留("正常"))) {
                        表诊断(诊断, "[错误] 访问 结果.值 前必须检查 结果.正常（在 如果 真分支内访问）");
                    }
                } 否则 如果 (成员名r3v == 整64(驻留("错误"))) {
                    如果 (已查r3v != 整64(驻留("错误"))) {
                        表诊断(诊断, "[错误] 访问 结果.错误 前必须检查 结果.正常（在 否则 分支内访问）");
                    }
                }
            } 否则 如果 (对象类型r3v > 0 && 是可选类型_ID(对象类型r3v)) {
                整64 已查o = 查结果已查(整64(对象r3v.文本));
                如果 (成员名r3v == 整64(驻留("值"))) {
                    如果 (已查o != 整64(驻留("有值"))) {
                        表诊断(诊断, "[错误] 访问 可选.值 前必须检查 可选.有值（在 如果 真分支内访问）");
                    }
                }
            }
        }
    }
    返回 驻留("整64");
}

// 族②：取地址/解引用检查（原 394~430 段）——188-a 取地址=恒空判定失格 +
//   76-a 解引用返回真实指向类型（查语义指针变量）+ 153-a 常量空指针解引用
//   硬错误 + 154-a B6/B7 裸指针解引用警告 + 188-a 恒空使用点登记。
//   返回 整64 兜底（复合形态=诚实边界）。
函数 检查取地址解引用表达式(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    // 188-a（D6·plans/023 B11 变量常量传播）：取地址=别名逃逸（外部可经别名
    //   改写该变量）→ 恒空判定失格（保守，防假阳性）
    如果 (n.类型 == 节点_取地址 && n.子起点 >= 0 && n.子起点 < 池.大小()) {
        节点 取址操作数188 = 池.元素(整32(n.子起点));
        如果 (取址操作数188.类型 == 节点_标识符) {
            登记恒空失格(整64(取址操作数188.文本));
            // 010（def-init）：取地址=初始化通道（地址逃逸=可能被写——Rust
            //   &mut maybe-init 同款；查方法签名(&签) 出参形态铁证）——整体置位
            状态置位标识符(符号表, 整64(取址操作数188.文本));
        }
    }
    // 76-a 后续（2026-09-12，用户裁决方案甲）：解引用返回**真实指向类型**——
    //   操作数为标识符且登记在指针变量表（查语义指针变量，指针下标 p[i] 路径
    //   同款机制）时返回所指类型；否则维持 整64 兜底（复合形态=诚实边界）。
    //   修复前恒返回 整64（「暂标量」）→ 一切经 表达式类型ID 的检查面
    //   （混合符号赋值/二元运算等）对解引用形态拿到 整64（有符号）→ 与 正8
    //   等无符号真实类型混合时漏检（实证：返回 *q; 宿主拒绝 / v2p 编译成功；
    //   修复后两侧一致拒绝——E2E 222/222_v2 锚定）
    如果 (n.类型 == 节点_解引用 && n.子起点 >= 0 && n.子起点 < 池.大小()) {
        节点 操作数d = 池.元素(整32(n.子起点));            // 153-a（plans/023 B11 v2 挂点）：**常量空指针解引用**（编译期硬错误）——
        //   操作数为「无」字面量（节点_整数字面量 附加==1，解析层标记）时确定性
        //   错误（宿主同构：*无 →「编译期常量空指针解引用」Error）。
        如果 (操作数d.类型 == 节点_整数字面量 && 操作数d.附加 == 1) {
            表诊断(诊断, "[错误] 编译期常量空指针解引用（确定性错误；plans/023 B11）");
        }
        如果 (操作数d.类型 == 节点_标识符) {
            整64 所指类型d = 查语义指针变量(整64(操作数d.文本));
            如果 (所指类型d >= 0) {
                // 154-a（B6/B7 v2 挂点）：裸指针解引用（读/写单报——plans/023
                //   §六.2「避免重复」；写面在赋值链不再二次报）
                错误不安全边界(诊断, "裸指针解引用", "指针解引用（*p）");
                // 188-a（D6 B11 变量常量传播）：恒空候选使用点登记（面=解引用）
                登记恒空使用点(整64(操作数d.文本), 整64(取当前诊断行()), 1);
                返回 所指类型d;
            }
        }
    }
    返回 驻留("整64");
}

// 族③：二元运算检查（原 434~506 段）——字符串比较拒绝（灰色点②方案A）+
//   混合符号二元拒绝（第五十一轮 方案A）+ 157-a V3 指针算术 A1 挂点全覆盖。
//   返回 -1（比较产物类型不参与下游推导）。
