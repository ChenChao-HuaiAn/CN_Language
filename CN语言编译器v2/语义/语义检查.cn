// CN 自举编译器 v2 · 语义检查（千行拆分子模块，2026-09-08 用户裁决阶段目录包）
// 职责：逐节点语义检查（成员偏移标注/检查表达式/检查语句/检查块/检查如果/
//   检查当/检查函数）——自 语义分析.cn 机械搬移；符号表经参数传递，模块
//   解析表经 公开: 访问函数（语义分析 主干）；模块路径=语义检查（新键基）。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（原 导入 语法分析，目录包名）
导入 IR;         // 容器/结果 合成名判定 + 节点_*/键位移 常量（目录包名）
导入 借出检查;    // 第七十七轮 A21：借出视图生命周期检查（函数级调用）

公开:   // 全文件公开（检查族+主流程供 包/主.cn 消费）

// 55-c 方案A（2026-09-10 第五十六轮 用户裁决，Rust E0308 对齐）：返回面混合
//   符号检查的当前函数返回类型名ID（节点_函数.附加，解析层经 驻留(返回类型名)
//   登记；引用后缀名「整64&」非整数族自动跳过）。检查函数 进入时设置/返回时
//   复位 -1；文件级静态——检查函数 与 检查语句 同文件（R3 拆分纪律）。
静态 整64 当前函数返回类型 = 0 - 1;
// plans/019 阶段2：当前函数引用参数名集（返回逃逸检查的豁免判定——引用参数
//   指向调用方存储，返回 &引用参数 合法；宿主 isRefParamForCurrentFn 对齐）
静态 向量<整64> 当前函数引用参数们;
// plans/019 阶段3：当前函数 常量 只读引用参数名集（赋值面只读纪律）
静态 向量<整64> 当前函数常量引用们;
// 153-a（plans/023 §八 v2 挂点基础设施）：**当前函数不安全修饰**——真=本函数为
//   不安全 函数（节点_函数.修饰==1，解析层回填）；检查函数 进入时设置/返回时复位。
//   9 类安全区边界挂点（指针算术/解引用读/解引用写/指针下标读/指针下标写/指针成员
//   访问/联合体字段/静态变量写/外部函数调用/裸释放）在 不安全 函数内豁免——与宿主
//   warnUnsafeBoundary 的 currentFnUnsafe_ 同构（plans/023 §八.2 双侧同构）。
静态 布尔 当前函数不安全 = 假;

// 155-a（plans/023 §八 B10 v2 挂点）：**顶层静态变量名ID集**——声明收集
//   （语义分析.cn 节点_静态声明 分支）追加；检查赋值语句 据此报「静态变量写」
//   （静态登记种类=符号_变量与普通变量同款，种类不可区分——名集合单点事实源）。
静态 向量<整64> 全局静态名ID们;
// 155-a：名ID 是否顶层静态（B10 判定）
函数 是全局静态名(整64 名ID) -> 布尔 {
    整64 i = 0;
    当 (i < 全局静态名ID们.大小()) {
        如果 (全局静态名ID们.元素(整32(i)) == 名ID) { 返回 真; }
        i++;
    }
    返回 假;
}

// 156-a（plans/023 §八）：**当前函数不安全 设置访问器**——静态变量文件级私有，
//   语义检查类.cn（类方法检查）跨文件经本访问器设置（检查方法 读 节点_方法.修饰）。
不安全 函数 设当前函数不安全(布尔 值) -> 空类型 {
    当前函数不安全 = 值;
}

// 155-a（A1 v2 挂点）：是否**裸指针类型文本**（以 * 结尾）——`字符*` 是
//   字符串视图（波 1 教训：isStringSemanticType 同族）排除；数组类型文本
//   （X[N]）不以 * 结尾天然不命中。
函数 是裸指针类型文本(字符串 类型文本) -> 布尔 {
    整64 长 = 字符串长度(类型文本);
    如果 (长 <= 0) { 返回 假; }
    如果 (字符串比较(类型文本, "字符*")) { 返回 假; }
    字符 末c = 类型文本[长 - 1];
    返回 末c == '*';
}

// 154-a（plans/023 §八 v2 挂点）/ 157-a（§十 步骤 5 收口）：**安全区边界错误**
//   ——宿主 reportUnsafeBoundary 的 v2 同构（当前函数不安全 时零诊断；文案
//   与宿主逐字一致=双侧同构；收口后=硬错误，观察期字样已删）。
函数 错误不安全边界(向量<字符串> 诊断, 字符串 类别, 字符串 明细) -> 空类型 {
    如果 (当前函数不安全) { 返回; }
    表诊断(诊断, "[安全区边界] " + 类别 + "应在 不安全 函数 内（" + 明细 + "）");
}

// plans/019 阶段2：名字是否当前函数引用参数（指向调用方存储——返回逃逸
//   豁免用；集合由 检查函数 收集，宿主 isRefParamForCurrentFn 对齐）
函数 是当前引用参数(整64 名ID) -> 布尔 {
    整64 i = 0;
    当 (i < 当前函数引用参数们.大小()) {
        如果 (当前函数引用参数们.元素(i) == 名ID) { 返回 真; }
        i++;
    }
    返回 假;
}

函数 清空当前引用参数() -> 空类型 {
    当前函数引用参数们.清空();
    当前函数常量引用们.清空();
}

// 55-c 当前函数返回类型 访问器（跨子模块读写——第七十八轮 类支持：语义检查类.cn
//   的 检查方法 需设置/复位同一静态；原为文件级私有直写）
不安全 函数 设当前函数返回类型(整64 类型ID) -> 空类型 {
    当前函数返回类型 = 类型ID;
}

函数 取当前函数返回类型() -> 整64 {
    返回 当前函数返回类型;
}

// plans/019 阶段3：名字是否当前函数常量（只读）引用参数
函数 是常量引用参数(整64 名ID) -> 布尔 {
    整64 i = 0;
    当 (i < 当前函数常量引用们.大小()) {
        如果 (当前函数常量引用们.元素(i) == 名ID) { 返回 真; }
        i++;
    }
    返回 假;
}

// ==================== 成员访问偏移标注（P6c） ====================
// 后缀栈遍历表达式区间 [起点, 终点)：标识符/字面量压类型；节点_成员 弹对象类型
//   查结构体字段偏移并写入节点.附加（IR 生成直接用）；节点_取地址/解引用 弹压类型。
// 返回 0=成功；-1=失败（类型未知/字段不存在）。
函数 标注成员偏移(向量<节点> 池, 整32 起点, 整32 终点,
                   向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 整64 {
    向量<整64> 类型栈 = 向量<整64>();
    整32 位置 = 起点;
    当 (位置 < 终点) {
        节点 n = 池.元素(位置);
        如果 (n.类型 == 节点_标识符) {
            整64 类型ID = 表查找类型ID(符号表, 整64(n.文本));
            如果 (类型ID == -1) { 返回 -1; }
            结果<空类型, 整32> 加 = 类型栈.追加(类型ID);
            如果 (!加.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_整数字面量) {
            结果<空类型, 整32> 加 = 类型栈.追加(驻留("整32"));
            如果 (!加.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_布尔字面量) {
            // 灰色点①根治（2026-09-04）：真/假 独立节点——类型栈压 布尔
            结果<空类型, 整32> 加布 = 类型栈.追加(驻留("布尔"));
            如果 (!加布.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_浮点字面量) {
            结果<空类型, 整32> 加 = 类型栈.追加(驻留("浮64"));
            如果 (!加.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_字符串字面量) {
            结果<空类型, 整32> 加 = 类型栈.追加(驻留("字符串"));
            如果 (!加.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_成员) {
            // 成员访问：偏移已由语法层写入 n.附加；字段类型暂按 整64
            结果<空类型, 整32> 加2 = 类型栈.追加(驻留("整64"));
            如果 (!加2.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_取地址) {
            // & 对象：类型不变（地址即 整64 槽）
            结果<空类型, 整32> 加3 = 类型栈.追加(驻留("整64"));
            如果 (!加3.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_解引用) {
            // * 指针：弹指针 -> 压 整64（暂标量）
            如果 (类型栈.大小() >= 1) {
                结果<空类型, 整32> 删2 = 类型栈.删除(类型栈.大小() - 1);
                如果 (!删2.正常) { 运行时错误(4); }
            }
            结果<空类型, 整32> 加4 = 类型栈.追加(驻留("整64"));
            如果 (!加4.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_二元运算 || n.类型 == 节点_调用 || n.类型 == 节点_下标) {
            // 二元/下标：弹2压1；调用：弹实参+被调，压 整64（暂）
            如果 (n.类型 == 节点_二元运算 || n.类型 == 节点_下标) {
                如果 (类型栈.大小() >= 2) {
                    结果<空类型, 整32> 删3 = 类型栈.删除(类型栈.大小() - 1);
                    如果 (!删3.正常) { 运行时错误(4); }
                    结果<空类型, 整32> 删4 = 类型栈.删除(类型栈.大小() - 1);
                    如果 (!删4.正常) { 运行时错误(4); }
                }
            } 否则 {
                整64 弹数 = n.附加 + 1;  // 实参 + 被调
                当 (弹数 > 0 && 类型栈.大小() > 0) {
                    结果<空类型, 整32> 删5 = 类型栈.删除(类型栈.大小() - 1);
                    如果 (!删5.正常) { 运行时错误(4); }
                    弹数--;
                }
            }
            结果<空类型, 整32> 加5 = 类型栈.追加(驻留("整64"));
            如果 (!加5.正常) { 运行时错误(4); }
        }
        位置++;
    }
    返回 0;
}

// ③ 第六波（2026-09-03）：三元两分支类型可合并判定——同ID 或同类数值族宽化
//   （整数族：整8/16/32/64、正8/16/32/64、布尔、字符 互通——真/假=1/0 字面量
//   语义、字符=零扩展整数，槽统一 8 字节 Load 整64 无损；浮点族：浮32/64 互通）。
//   跨类（整 vs 浮：位模式不同 / 字符串 vs 整数：指针槽 vs 数值槽）拒绝——
//   Rust if 表达式同款纪律（无隐式跨类转换）
函数 类型可合并(整64 类型A, 整64 类型B) -> 布尔 {
    如果 (类型A == 类型B) { 返回 真; }
    字符串 名A = 字符串复制(驻留文本(类型A));
    字符串 名B = 字符串复制(驻留文本(类型B));
    布尔 A整数 = 字符串比较(名A, "整8") || 字符串比较(名A, "整16") ||
                  字符串比较(名A, "整32") || 字符串比较(名A, "整64") ||
                  字符串比较(名A, "正8") || 字符串比较(名A, "正16") ||
                  字符串比较(名A, "正32") || 字符串比较(名A, "正64") ||
                  字符串比较(名A, "布尔") || 字符串比较(名A, "字符");
    布尔 B整数 = 字符串比较(名B, "整8") || 字符串比较(名B, "整16") ||
                  字符串比较(名B, "整32") || 字符串比较(名B, "整64") ||
                  字符串比较(名B, "正8") || 字符串比较(名B, "正16") ||
                  字符串比较(名B, "正32") || 字符串比较(名B, "正64") ||
                  字符串比较(名B, "布尔") || 字符串比较(名B, "字符");
    如果 (A整数 && B整数) { 返回 真; }
    布尔 A浮点 = 字符串比较(名A, "浮32") || 字符串比较(名A, "浮64");
    布尔 B浮点 = 字符串比较(名B, "浮32") || 字符串比较(名B, "浮64");
    如果 (A浮点 && B浮点) { 返回 真; }
    返回 假;
}

// 93-a（2026-09-13 第九十三轮）：类名.成员 拒绝——用户类名直接访问实例成员。
//   宿主 93-a 同款纪律（semantic_call/semantic_expr：类名.实例方法()/类名.实例
//   字段 编译期拒绝，Rust「类名.成员 仅静态成员合法」对齐）；v2 类支持第一版
//   无静态成员（IR类.cn 第一版范围），故「用户类名.成员」任何形态皆非法——须经
//   实例（`实例.成员`）。修复前 IR 层按对象=未声明标识符退化生成（探针 M1/M3/M4
//   实证：读垃圾值 / 静默写入）。判定：对象=标识符 且 是用户类 且 非变量遮蔽
//   （变量遮蔽时按实例语义——与宿主 receiverIsTypeName 判定同款）。遮蔽判据=
//   符号种类 ∈ {符号_变量, 符号_参数}：类名自身在符号表登记为 符号_结构体
//   （种类 4——探针调试实证；若按 表查找类型ID != -1 判定会把类名自身误判为
//   变量，检查永不命中）。
//   命中即诊断（调用方继续既有路径，诊断令主链中止——不产 IR/asm）。返回 真=命中。
函数 检查类名成员访问(向量<节点> 池, 整32 成员节点索引,
                        向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 布尔 {
    节点 m = 池.元素(成员节点索引);
    如果 (m.子起点 <= 0 || 整64(m.子起点) >= 池.大小()) { 返回 假; }
    节点 对象m = 池.元素(整32(m.子起点));
    如果 (对象m.类型 != 节点_标识符) { 返回 假; }
    如果 (!是用户类ID(整64(对象m.文本))) { 返回 假; }
    整64 种类m = 表查找种类(符号表, 整64(对象m.文本));
    如果 (种类m == 符号_变量 || 种类m == 符号_参数) { 返回 假; }
    表诊断(诊断, "[错误] 类名不能直接访问实例成员: " +
                  驻留文本(整64(对象m.文本)) + "." + 驻留文本(整64(m.文本)) +
                  "（须经实例；类名仅静态成员可直接访问——v2 类支持第一版无静态成员）");
    返回 真;
}

// 检查表达式：返回类型ID（-1=未知）；未声明标识符 -> 诊断。
//   R3 拆分（2026-09-08）：标识符/下标/调用 三大分支族分派至 语义检查表达式
//   模块（语义检查表达式.cn），本函数保留字面量/成员/取地址解引用/二元/三元。
函数 检查表达式(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    如果 (n.类型 == 节点_整数字面量) { 返回 驻留("整32"); }
    // 灰色点①根治（2026-09-04）：真/假 独立节点——类型推导 布尔（三元分支
    //   类型可合并判定 布尔∈整数族 互通不变）
    如果 (n.类型 == 节点_布尔字面量) { 返回 驻留("布尔"); }
    如果 (n.类型 == 节点_浮点字面量) { 返回 驻留("浮64"); }
    如果 (n.类型 == 节点_字符串字面量) { 返回 驻留("字符串"); }
    // 95-a（2026-09-13 第九十五轮）：字符字面量——类型 字符（值=Unicode 码点）
    如果 (n.类型 == 节点_字符字面量) { 返回 驻留("字符"); }
    如果 (n.类型 == 节点_标识符) {
        返回 检查标识符表达式(池, 节点索引, 符号表, 诊断);
    }
    如果 (n.类型 == 节点_成员) {
        // 成员访问：偏移已标注到附加；字段类型暂 整64
        // 93-a：类名.成员 拒绝（用户类名直接访问实例成员——宿主同款纪律；
        //   修复前按未声明标识符退化生成=读垃圾/静默写，探针 M3/M4 实证）
        布尔 命中类名 = 检查类名成员访问(池, 节点索引, 符号表, 诊断);
        如果 (命中类名) { }
        返回 驻留("整64");
    }
    如果 (n.类型 == 节点_下标) {
        返回 检查下标表达式(池, 节点索引, 符号表, 诊断);
    }
    如果 (n.类型 == 节点_取地址 || n.类型 == 节点_解引用) {
        // 76-a 后续（2026-09-12，用户裁决方案甲）：解引用返回**真实指向类型**——
        //   操作数为标识符且登记在指针变量表（查语义指针变量，指针下标 p[i] 路径
        //   同款机制）时返回所指类型；否则维持 整64 兜底（复合形态=诚实边界）。
        //   修复前恒返回 整64（「暂标量」）→ 一切经 表达式类型ID 的检查面
        //   （混合符号赋值/二元运算等）对解引用形态拿到 整64（有符号）→ 与 正8
        //   等无符号真实类型混合时漏检（实证：返回 *q; 宿主拒绝 / v2p 编译成功；
        //   修复后两侧一致拒绝——E2E 222/222_v2 锚定）
        如果 (n.类型 == 节点_解引用 && n.子起点 >= 0 && n.子起点 < 池.大小()) {
            节点 操作数d = 池.元素(整32(n.子起点));
            // 153-a（plans/023 B11 v2 挂点）：**常量空指针解引用**（编译期硬错误）——
            //   操作数为「无」字面量（节点_整数字面量 附加==1，解析层标记）时确定性
            //   错误（宿主同构：*无 →「编译期常量空指针解引用」Error）。
            如果 (操作数d.类型 == 节点_整数字面量 && 操作数d.附加 == 1) {
                表诊断(诊断, "[错误] 编译期常量空指针解引用（确定性错误；plans/023 B11）");
            }
            如果 (操作数d.类型 == 节点_标识符) {
                整64 所指类型d = 查语义指针变量(整64(操作数d.文本));
                如果 (所指类型d >= 0) {
                    // 154-a（B6/B7 v2 挂点）：裸指针解引用（读/写单报——plans/023
                    //   §六.2「避免重复」；写面在赋值链不再二次报）
                    错误不安全边界(诊断, "裸指针解引用", "指针解引用（*p）");
                    返回 所指类型d;
                }
            }
        }
        返回 驻留("整64");
    }
    如果 (n.类型 == 节点_调用) {
        返回 检查调用表达式(池, 节点索引, 符号表, 诊断);
    }
    如果 (n.类型 == 节点_二元运算) {
        // 灰色点②方案A（2026-09-04 用户裁决）：字符串比较运算符显式拒绝——
        //   规范 plans/001 Task 2.8（比较运算符仅整型/浮点变体，字符串不参与
        //   运算符比较；等价能力 字符串比较（相等）/字符串字典序（全序））。
        //   原按指针地址放行=同内容异地址 ==/!= 恒假（拼接产物静默陷阱）。
        //   操作数类型经区间末端节点递归推导（三元同款技巧）：普通/短路二元
        //   统一 子起点=右操作数起点、附加=左操作数起点——左末=子起点-1、
        //   右末=本节点索引-1。字面量/标识符形态可靠推导；拼接产物/成员字段
        //   推导 -1/整64 兜底=检不出（v2 类型推导既有半实现面，诚实边界——
        //   随 v2 语义类型推导完善收口，宿主侧已全形态覆盖）。返回 -1（比较
        //   产物类型不参与下游推导；三元末端为二元时原亦 -1 跳过，无回归）
        字符串 op文本 = 字符串复制(驻留文本(整64(n.文本)));
        布尔 是比较符 = 字符串比较(op文本, "==") || 字符串比较(op文本, "!=") ||
                       字符串比较(op文本, "<") || 字符串比较(op文本, ">") ||
                       字符串比较(op文本, "<=") || 字符串比较(op文本, ">=");
        // 混合符号二元运算拒绝（2026-09-10 第五十一轮 方案A 用户裁决，Rust
        //   对齐；规范 plans/001 §3.7）：检查范围自比较符扩至算术/位运算符——
        //   「变量间」整N vs 正M 诊断拒绝（检查混合符号二元，语义检查表达式
        //   模块；字面量豁免含 -1 形态；类型 -1 跳过=检不出诚实边界同上）。
        布尔 是算术位符 = 字符串比较(op文本, "+") || 字符串比较(op文本, "-") ||
                        字符串比较(op文本, "*") || 字符串比较(op文本, "/") ||
                        字符串比较(op文本, "%") || 字符串比较(op文本, "&") ||
                        字符串比较(op文本, "|") || 字符串比较(op文本, "^") ||
                        字符串比较(op文本, "<<") || 字符串比较(op文本, ">>");
        如果 ((是比较符 || 是算术位符) && n.子起点 > 0) {
            // 带诊断操作数递归限定比较符（灰色点②既有行为——诊断双报形态已
            //   被 174 等负测 expected 固化，不得扩面）；算术/位运算符的混合
            //   符号检查由 检查混合符号二元 静默自推导（零诊断副作用）
            如果 (是比较符) {
                整64 左类型比 = 检查表达式(池, 整32(n.子起点 - 1), 符号表, 诊断);
                整64 右类型比 = 检查表达式(池, 整32(节点索引 - 1), 符号表, 诊断);
                如果 (左类型比 == 驻留("字符串") && 右类型比 == 驻留("字符串")) {
                    表诊断(诊断, "[错误] 字符串不支持 ==/!=/</> 比较运算符（按地址比较而非内容）——相等用 字符串比较(a,b)，全序用 字符串字典序(a,b)");
                }
            }
            检查混合符号二元(池, 整32(n.子起点 - 1), 整32(节点索引 - 1),
                            符号表, 诊断);
            // 157-a（V3 缺陷修复——A1 v2 挂点全覆盖）：**指针算术**（裸指针
            //   ± 整数）——155-a 的 A1 挂点仅在 推导二元类型ID（指针变量经
            //   类型ID 推导返 -1=全路径失效，实测声明/赋值皆零命中）；本处改
            //   用 表查找类型ID（声明类型文本）+ 是裸指针类型文本 判定——与
            //   B8/A2 判定机制同族，声明/赋值/表达式全路径覆盖。
            如果 (字符串比较(op文本, "+") || 字符串比较(op文本, "-")) {
                布尔 左指针a1 = 假;
                布尔 右指针a1 = 假;
                节点 左a1 = 池.元素(整32(n.子起点 - 1));
                如果 (左a1.类型 == 节点_标识符) {
                    // v2 符号登记语义：指针变量登记**所指类型**（B8 同款注释：
                    //   「指针变量表命中即返回所指类型」）——故判定用 查语义
                    //   指针变量（非 表查找类型ID，后者对 整64* q 返 整64）。
                    整64 查左a1 = 查语义指针变量(整64(左a1.文本));
                    如果 (查左a1 >= 0) {
                        如果 (!字符串比较(字符串复制(驻留文本(查左a1)), "字符")) {
                            左指针a1 = 真;   // 字符* 排除（字符串视图=波 1 同族）
                        }
                    }
                }
                节点 右a1 = 池.元素(整32(节点索引 - 1));
                如果 (右a1.类型 == 节点_标识符) {
                    整64 查右a1 = 查语义指针变量(整64(右a1.文本));
                    如果 (查右a1 >= 0) {
                        如果 (!字符串比较(字符串复制(驻留文本(查右a1)), "字符")) {
                            右指针a1 = 真;
                        }
                    }
                }
                如果 (左指针a1 || 右指针a1) {
                    错误不安全边界(诊断, "指针算术", "指针 +/- 整数");
                }
            }
        }
        返回 -1;
    }
    如果 (n.类型 == 节点_三元运算) {
        // ③ 第六波：三元两分支类型一致性——段末端节点递归推导（真值末端=附加-1、
        //   假值末端=子终点-1）；未知(-1)任一侧跳过（级联防）。条件段类型不强制
        //   （条件跳转按非零判——同 如果/当 惯例）；三段标识符检查由语句根区间
        //   线性遍历覆盖（同二元惯例）。返回真值类型（IR 汇合槽按真分支类型读）
        // 86-a（2026-09-12 复审缺陷①）：改用 表达式类型ID（成员经 推导成员类型ID
        //   精确推导、二元经 推导二元类型ID）——原 检查表达式 对成员恒 整64 兜底
        //   → 聚合分支（乙箱.内盒）与 标识符分支（甲=盒）误报「两分支类型不一致」
        //   （P47/t5 实证）。推导失败 -1 仍跳过（级联防不误伤）。
        整64 真类型 = 表达式类型ID(池, 整32(n.附加 - 1), 符号表, 诊断);
        整64 假类型 = 表达式类型ID(池, 整32(n.子终点 - 1), 符号表, 诊断);
        如果 (真类型 != -1 && 假类型 != -1) {
            如果 (!类型可合并(真类型, 假类型)) {
                表诊断(诊断, "[错误] 三元两分支类型不一致: " + 驻留文本(真类型) +
                       " 与 " + 驻留文本(假类型));
            }
        }
        如果 (真类型 != -1) { 返回 真类型; }
        返回 假类型;
    }
    返回 -1;
}

// ==================== 46-c 推断声明类型推导（2026-09-10 第四十九轮） ====================
// 推断声明的类型权威推导（单点；IR 层经 推断声明类型表 查表消费）：
//   表达式类型ID——区间末节点=表达式根（线性化约定，检查表达式 二元/三元
//   同款技巧）：成员/二元走专用推导（检查表达式 对两者恒 整64/-1 半实现，
//   推断声明不可静默降级——成员误推整64 会让结构体值截断进 8 字节槽=46-a
//   家族静默错误代码）；其余（字面量/标识符/调用/下标/三元）经 检查表达式
//   既有精确推导。-1=不可推导（调用方可见诊断，语义错误即中止兜底）。
函数 表达式类型ID(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    如果 (n.类型 == 节点_成员) { 返回 推导成员类型ID(池, 节点索引, 符号表, 诊断); }
    如果 (n.类型 == 节点_二元运算) { 返回 推导二元类型ID(池, 节点索引, 符号表, 诊断); }
    返回 检查表达式(池, 节点索引, 符号表, 诊断);
}

// 成员读类型推导（46-a 家族同源机制，同构 IR生成 解析成员链结构体ID 范本——
//   父链三形态：标识符（变量结构体表 键基直查>1；标量/容器走符号表类型名归一）/
//   成员（递归）/调用（返回类型名归一））。返回字段类型名ID；-1=不可推导。
函数 推导成员类型ID(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 整64 {
    节点 m = 池.元素(节点索引);
    整64 父键基 = 0;
    如果 (m.子起点 >= 0 && m.子起点 < 池.大小()) {
        节点 对象m = 池.元素(整32(m.子起点));
        如果 (对象m.类型 == 节点_标识符) {
            // 变量结构体表：值>1=键基（结构体对象直查）；1=结构体名标记/
            //   0/-1=非结构体——标量/容器走符号表类型名（字符串字段等非
            //   结构体成员经 查结构体类型 归一 miss=-1 可见）
            整64 键v = 查变量结构体键(整64(对象m.文本));
            如果 (键v > 1) {
                父键基 = 键v;
            } 否则 {
                整64 对象类型ID = 检查标识符表达式(池, 整32(m.子起点), 符号表, 诊断);
                如果 (对象类型ID > 0) { 父键基 = 查结构体类型(对象类型ID); }
            }
            // 154-a（B9 v2 挂点）：**裸指针成员访问**（p.字段——CN 的 . 自动解引用
            //   一级；与宿主 B9 同族）。判定=指针变量表命中；字符串语义（字符*/
            //   字符串）在宿主经 isStringSemanticType 豁免——v2 树已全量迁移
            //   （不安全 修饰），存量零警告；用户侧从严（波 6 与宿主统一）。
            整64 查指针m = 查语义指针变量(整64(对象m.文本));
            如果 (查指针m >= 0) {
                错误不安全边界(诊断, "指针成员访问", "指针成员访问（p.字段）");
            }
        } 否则 如果 (对象m.类型 == 节点_成员) {
            整64 父字段ID = 推导成员类型ID(池, 整32(m.子起点), 符号表, 诊断);
            如果 (父字段ID > 0) { 父键基 = 查结构体类型(父字段ID); }
        } 否则 如果 (对象m.类型 == 节点_调用) {
            整64 返回类型ID = 检查调用表达式(池, 整32(m.子起点), 符号表, 诊断);
            如果 (返回类型ID > 0) { 父键基 = 查结构体类型(返回类型ID); }
        }
    }
    如果 (父键基 <= 0) { 返回 -1; }
    整64 字段ID = 查字段类型ID(父键基, 整64(m.文本));
    如果 (字段ID == 0) { 返回 -1; }
    返回 字段ID;
}

// 二元运算类型推导（左右操作数区间末节点递归+同族可合并取左——检查表达式
//   二元节点布局约定：子起点=右操作数起点、左末=子起点-1、右末=本索引-1）。
//   任一侧不可推导/跨族=整体 -1（绝不静默降级整64——推断声明类型错误是
//   静默错误代码温床）。返回操作数类型名ID；-1=不可推导。
函数 推导二元类型ID(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    如果 (n.子起点 <= 0) { 返回 -1; }
    整64 左ID = 表达式类型ID(池, 整32(n.子起点 - 1), 符号表, 诊断);
    整64 右ID = 表达式类型ID(池, 整32(节点索引 - 1), 符号表, 诊断);
    // 155-a A1 挂点原位于此（推导二元类型ID）——157-a 实测失效（表达式类型ID
    //   对指针变量返 -1）已移除；A1 判定统一下沉 检查表达式 二元分支
    //   （查语义指针变量 判定，声明/赋值/表达式全路径覆盖）。
    如果 (左ID <= 0 || 右ID <= 0) { 返回 -1; }
    如果 (!类型可合并(左ID, 右ID)) { 返回 -1; }
    返回 左ID;
}

不安全 函数 检查语句(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 空类型 {
    节点 n = 池.元素(节点索引);
    // 103-a（D2）：设当前诊断行=语句根行（解析块 单点回填；0=未知→表诊断
    //   不带行号，存量兼容）——语义诊断自此带源码行号（对齐语法层（行=）格式）
    设当前诊断行(n.行);
    如果 (n.类型 == 节点_返回语句) {
        // 71-a：返回位装箱语境——当前函数返回类型为 结果/可选 时设置（构造器
        //   正常/错误/某些 的类型推导依据；区间检查后复位）
        布尔 返回位语境71 = 假;
        如果 (n.子终点 > n.子起点 && 当前函数返回类型 >= 0) {
            如果 (是结果类型(字符串复制(驻留文本(当前函数返回类型)))) {
                装箱语境类型ID = 当前函数返回类型;
                返回位语境71 = 真;
            }
        }
        整64 i = 整64(n.子起点);
        当 (i < 整64(n.子终点)) {
            整64 忽略 = 检查表达式(池, 整32(i), 符号表, 诊断);
            如果 (忽略 == -1) { }
            i++;
        }
        如果 (返回位语境71) { 装箱语境类型ID = 0; }   // 71-a：语境复位
        // 55-c 方案A（2026-09-10 第五十六轮 用户裁决）：返回面混合符号拒绝——
        //   返回类型（当前函数返回类型名ID）与返回值表达式类型「变量间」跨符号
        //   拒绝；字面量豁免（检查混合符号赋值，语义检查表达式 模块）。
        //   顶层静态声明初始化不经 返回语句；无返回值（子终点==子起点）跳过。
        如果 (n.子终点 > n.子起点 && 当前函数返回类型 >= 0) {
            检查混合符号赋值(池, 当前函数返回类型, n.子终点 - 1, 符号表, 诊断);
        }
        // plans/019 阶段4' A2（2026-09-11 方案甲 用户批准）：返回位拥有契约——
        //   返回类型 字符串=拥有（调用方登记 RAII 释放），借用形态返回拒绝：
        //   下标/成员借出、字符* 调用返回（驻留文本 等）、参数标识符（借用）。
        //   局部拥有标识符/字面量/拼接放行（宿主 visitReturnStmt 同构；
        //   v2 语法面无栈数组，借出载体=指针下标/成员）。
        如果 (n.子终点 > n.子起点 && 当前函数返回类型 == 驻留("字符串")) {
            节点 返回末A2 = 池.元素(整32(n.子终点 - 1));
            布尔 借用返回A2 = 假;
            如果 (返回末A2.类型 == 节点_下标 || 返回末A2.类型 == 节点_成员) {
                借用返回A2 = 真;
            } 否则 如果 (返回末A2.类型 == 节点_调用 && 返回末A2.子起点 >= 0) {
                节点 被调A2 = 池.元素(整32(返回末A2.子起点));
                如果 (被调A2.类型 == 节点_标识符 &&
                     查函数返回类型(整64(被调A2.文本)) == 驻留("字符*")) {
                    借用返回A2 = 真;
                }
            } 否则 如果 (返回末A2.类型 == 节点_标识符) {
                // 参数=借用（局部=拥有移出放行；非局部=静态/全局借用）
                整64 返回名A2 = 整64(返回末A2.文本);
                // 符号_参数=借用；非局部（静态/全局）=借用（局部=拥有移出放行）
                如果 (表查找种类(符号表, 返回名A2) == 符号_参数 ||
                     !是局部名(符号表, 返回名A2)) {
                    借用返回A2 = 真;
                }
            }
            如果 (借用返回A2) {
                表诊断(诊断, "[错误] 函数返回类型 '字符串'=拥有契约，不能返回借用" +
                             "——须 字符串复制(...) 显式落堆，或改返回类型为 '字符*'（借用视图）");
            }
        }
        // plans/019 阶段2（2026-09-10）：返回局部变量的地址——返回类型为指针
        //   或引用（名文本尾 * 或 &）且返回末节点为 取地址(局部标识符) 时拒绝
        //   （栈帧消亡悬垂；宿主 visitReturnStmt 指针返回检查同构——v2 第一版
        //   不含经指针转接形态=诚实边界）
        如果 (n.子终点 > n.子起点 && 当前函数返回类型 >= 0) {
            字符串 返回类型文本 = 字符串复制(驻留文本(当前函数返回类型));
            整64 返回类型长度 = 字符串长度(返回类型文本);
            布尔 返回是指针或引用 = 假;
            如果 (返回类型长度 > 0) {
                字符串 尾字符 = 字符串子串(返回类型文本, 返回类型长度 - 1, 1);
                如果 (字符串比较(尾字符, "*") || 字符串比较(尾字符, "&")) {
                    返回是指针或引用 = 真;
                }
            }
            如果 (返回是指针或引用) {
                节点 返回末 = 池.元素(整32(n.子终点 - 1));
                如果 (返回末.类型 == 节点_取地址 && 返回末.子起点 >= 0) {
                    节点 取地址操作数 = 池.元素(整32(返回末.子起点));
                    如果 (取地址操作数.类型 == 节点_标识符 &&
                         是局部名(符号表, 整64(取地址操作数.文本)) &&
                         !是当前引用参数(整64(取地址操作数.文本))) {
                        // 宿主 isRefParamForCurrentFn 对齐：引用参数指向调用方
                        //   存储（非本栈帧）——返回 &引用参数 合法豁免
                        表诊断(诊断, "[错误] 返回局部变量的地址（栈帧消亡将成悬垂）: " +
                                      驻留文本(整64(取地址操作数.文本)));
                    }
                }
            }
        }
        返回;
    }
    如果 (n.类型 == 节点_变量声明) {
        检查变量声明语句(池, 节点索引, 符号表, 诊断);
        返回;
    }
    如果 (n.类型 == 节点_赋值) {
        检查赋值语句(池, 节点索引, 符号表, 诊断);
        返回;
    }
    如果 (n.类型 == 节点_自增) {
        整64 目标类型 = 表查找类型ID(符号表, 整64(n.文本));
        如果 (目标类型 == -1) {
            表诊断(诊断, "[错误] 自增目标未声明: " + 驻留文本(整64(n.文本)));
        }
        // 缺陷②同族（2026-09-03 用户裁决立案）：自增是隐式赋值——常量不可自增
        //   （宿主 visitUnaryExpr ++/-- 常量拒绝对齐；v2 解析器仅支持 ++标识符/
        //   标识符++，结构性无歧义，仅需常量检查）
        如果 (表查找种类(符号表, 整64(n.文本)) == 符号_常量) {
            表诊断(诊断, "[错误] 不能对常量自增（常量初始化后不可修改）: " +
                          驻留文本(整64(n.文本)));
        }
        返回;
    }
    // 簇③根治·自减全链 C1（2026-09-04 用户裁决）：与 节点_自增 完全对称——
    //   未声明诊断 + 常量拒绝（自减同为隐式赋值）
    如果 (n.类型 == 节点_自减) {
        整64 目标类型减 = 表查找类型ID(符号表, 整64(n.文本));
        如果 (目标类型减 == -1) {
            表诊断(诊断, "[错误] 自减目标未声明: " + 驻留文本(整64(n.文本)));
        }
        如果 (表查找种类(符号表, 整64(n.文本)) == 符号_常量) {
            表诊断(诊断, "[错误] 不能对常量自减（常量初始化后不可修改）: " +
                          驻留文本(整64(n.文本)));
        }
        返回;
    }
    如果 (n.类型 == 节点_中断语句 || n.类型 == 节点_继续语句) {
        返回;
    }
    // 一元（逻辑非/负号/取地址/解引用）裸节点分支已删除（缺陷②分诊根治）：
    //   检查块 现仅派发语句根节点——裸一元节点的操作数由所属语句根的区间检查
    //   统一覆盖（原分支=块级裸派发兜底，双重处理/前向引用误报根源）
    // P6c：成员偏移标注（通用表达式区间）
    整64 标4 = 标注成员偏移(池, n.子起点, n.子终点, 符号表, 诊断);
    如果 (标4 == -1) { }
    整64 i = 整64(n.子起点);
    当 (i < 整64(n.子终点)) {
        整64 忽略 = 检查表达式(池, 整32(i), 符号表, 诊断);
        如果 (忽略 == -1) { }
        i++;
    }
}


// 检查块（新作用域：压入/弹出）
// ③ 第二波根治（2026-09-03）：父层区间原始遍历会先处理嵌套块（当体/如果体/裸块）
//   的语句、随后控制节点递归再处理一遍——嵌套声明泄漏注册到父层作用域（块级遮蔽
//   检查被自注册误触发，126/127 无真实遮蔽也误报；符号作用域语义错误）。修复：
//   预收集全部嵌套体块区间，主循环跳过——嵌套语句只在递归作用域内处理一次。
函数 检查块(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 空类型 {
    表压入(符号表);
    节点 块 = 池.元素(节点索引);
    向量<整64> 跳过区间们 = 向量<整64>();
    整64 预扫i = 整64(块.子起点);
    当 (预扫i < 整64(块.子终点)) {
        节点 预节点 = 池.元素(整32(预扫i));
        如果 (预节点.类型 == 节点_块) {
            // 裸块：语句区间 [块.子起点, 块节点自身)——块节点由主循环派发递归
            登记跳过区间(跳过区间们, 整64(预节点.子起点), 预扫i);
        } 否则 如果 (预节点.类型 == 节点_当语句) {
            // 当：体块@附加，区间 [体块.子起点, 体块节点]（含体块节点——检查当 递归）
            节点 当体块 = 池.元素(预节点.附加);
            登记跳过区间(跳过区间们, 整64(当体块.子起点), 整64(预节点.附加) + 1);
        } 否则 如果 (预节点.类型 == 节点_如果语句) {
            // 如果：真块@附加，区间 [真块.子起点, 真块节点]（含——检查如果 递归）；
            //   否则链节点（块/如果）在区间内会被预扫另行收集（否则块按裸块、否则
            //   如果按本分支），条件表达式区间不跳（检查如果/主循环双查幂等无害）
            节点 真块 = 池.元素(预节点.附加);
            登记跳过区间(跳过区间们, 整64(真块.子起点), 整64(预节点.附加) + 1);
        }
        预扫i++;
    }
    整64 i = 整64(块.子起点);
    当 (i < 整64(块.子终点)) {
        // 跳过嵌套体块区间（其语句由递归作用域处理）
        布尔 在跳过 = 假;
        整64 跳i = 0;
        当 (跳i < 跳过区间们.大小()) {
            如果 (i >= 跳过区间们.元素(跳i) && i < 跳过区间们.元素(跳i + 1)) {
                在跳过 = 真;
                中断;
            }
            跳i += 2;
        }
        如果 (在跳过) { i++; 继续; }
        节点 子 = 池.元素(整32(i));
        // 语句根节点才派发（缺陷②分诊根治，2026-09-03）：块区间线性包含各语句
        //   的全部内部节点（RHS 裸标识符/一元/成员…先于语句根入池）——原实现逐
        //   节点派发使裸一元节点（取地址/解引用/负号/逻辑非）在**声明根注册名
        //   字之前**先查操作数区间：自引用/前向引用误报「未声明」+ 同一错误双
        //   诊断（&q 前向引用探针实证报两次）。裸节点一律由所属语句根的区间
        //   检查统一覆盖（每节点恰在其作用域访问一次，rustc 对齐）
        如果 (子.类型 == 节点_块 || 子.类型 == 节点_如果语句 || 子.类型 == 节点_当语句 ||
             子.类型 == 节点_变量声明 || 子.类型 == 节点_赋值 || 子.类型 == 节点_自增 ||
             子.类型 == 节点_自减 ||
             子.类型 == 节点_返回语句 || 子.类型 == 节点_表达式语句 ||
             子.类型 == 节点_中断语句 || 子.类型 == 节点_继续语句) {
            如果 (子.类型 == 节点_块) {
                检查块(池, 整32(i), 符号表, 诊断);
            } 否则 如果 (子.类型 == 节点_如果语句) {
                检查如果(池, 整32(i), 符号表, 诊断);
            } 否则 如果 (子.类型 == 节点_当语句) {
                检查当(池, 整32(i), 符号表, 诊断);
            } 否则 {
                检查语句(池, 整32(i), 符号表, 诊断);
            }
        }
        i++;
    }
    表弹出(符号表);
}

// 检查如果语句：条件表达式 + 真块（新作用域）+ 否则链（否则 如果 递归）
函数 检查如果(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 空类型 {
    节点 如果节点 = 池.元素(节点索引);
    // 节点字段：文本=条件起点，子起点=条件终点，附加=真块索引，子终点=否则索引
    整64 条件起点 = 整64(如果节点.文本);
    整64 条件终点 = 整64(如果节点.子起点);
    整64 i = 条件起点;
    当 (i < 条件终点) {
        整64 忽略 = 检查表达式(池, 整32(i), 符号表, 诊断);
        如果 (忽略 == -1) { }
        i++;
    }
    // 真块：附加=真块节点索引
    检查块(池, 整32(如果节点.附加), 符号表, 诊断);
    // 否则链：子终点=否则节点索引（0=无；嵌套 否则 如果 亦为 节点_如果语句）
    整64 否则索引 = 如果节点.子终点;
    如果 (否则索引 != 0) {
        节点 否则节点 = 池.元素(整32(否则索引));
        如果 (否则节点.类型 == 节点_如果语句) {
            检查如果(池, 整32(否则索引), 符号表, 诊断);
        } 否则 {
            检查块(池, 整32(否则索引), 符号表, 诊断);
        }
    }
}

// 检查当语句：条件表达式 + 循环体块（新作用域）
函数 检查当(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 空类型 {
    节点 当节点 = 池.元素(节点索引);
    // 节点字段：文本=条件起点，子起点=条件终点，附加=体块索引
    整64 条件起点 = 整64(当节点.文本);
    整64 条件终点 = 整64(当节点.子起点);
    整64 i = 条件起点;
    当 (i < 条件终点) {
        整64 忽略 = 检查表达式(池, 整32(i), 符号表, 诊断);
        如果 (忽略 == -1) { }
        i++;
    }
    检查块(池, 整32(当节点.附加), 符号表, 诊断);
}

// 函数参数登记（第七十八轮 类支持 R3 提取：检查函数/检查方法 两类作用域单元
//   共用）——参数类型归一 + 类型引用诊断 + 指针/引用参数收集 + 符号注册。
//   自 检查函数 机械搬移（行为零变化）。
函数 登记函数参数们(向量<节点> 池, 整32 函数节点, 向量<映射<整64, 符号>> 符号表,
                     向量<字符串> 诊断) -> 空类型 {
    节点 函数体 = 池.元素(函数节点);
    整64 i = 整64(函数体.子起点);
    当 (i < 整64(函数体.子终点)) {
        节点 参数 = 池.元素(整32(i));
        如果 (参数.类型 == 节点_参数) {
            // ③ 第二波（方案A）：参数 类型ID 同样归一为类型名ID（统一符号约定）
            整64 参数类型ID = 整64(参数.附加);
            如果 (参数类型ID >= 0 && 参数类型ID < 池.大小()) {
                节点 参数类型节点值 = 池.元素(整32(参数类型ID));
                如果 (参数类型节点值.类型 == 节点_类型) {
                    参数类型ID = 整64(参数类型节点值.文本);
                    // plans/018 类型分桶：参数类型存在性/公开性/歧义诊断（fail fast）
                    检查类型引用(符号表, 诊断, 参数类型ID);
                    // ③ 第三波：指针参数登记（附加=指针层数 1..255；引用 >=256 不入）
                    如果 (参数类型节点值.附加 >= 1 && 参数类型节点值.附加 < 256) {
                        登记语义指针变量(整64(参数.文本), 参数类型ID);
                    }
                    // plans/019 阶段2：引用参数收集（附加==256）
                    如果 (参数类型节点值.附加 == 256) {
                        结果<空类型, 整32> 加引用参数 = 当前函数引用参数们.追加(整64(参数.文本));
                        如果 (!加引用参数.正常) { 运行时错误(4); }
                    }
                    // plans/019 阶段3：常量（只读）引用参数收集（附加==257——
                    //   解析参数 常量 前缀改标）
                    如果 (参数类型节点值.附加 == 257) {
                        结果<空类型, 整32> 加常量引用 = 当前函数常量引用们.追加(整64(参数.文本));
                        如果 (!加常量引用.正常) { 运行时错误(4); }
                    }
                }
            }
            整64 忽略 = 表注册(符号表, 整64(参数.文本), 参数类型ID, 符号_参数, 0);
            如果 (忽略 == 0) { }
        }
        i++;
    }
}

// 检查函数：函数作用域（参数 + 函数体）
不安全 函数 检查函数(向量<节点> 池, 整32 函数节点, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 空类型 {
    清空语义指针变量表();  // ③ 第三波：函数级生命周期
    表压入(符号表);
    节点 函数体 = 池.元素(函数节点);
    当前函数返回类型 = 整64(函数体.附加);  // 55-c：返回面混合符号检查取类型用
    当前函数不安全 = (函数体.修饰 == 1);   // 153-a：不安全修饰（9 类挂点豁免）
    清空当前引用参数();
    登记函数参数们(池, 函数节点, 符号表, 诊断);
    如果 (整64(函数体.子终点) < 池.大小()) {
        检查块(池, 函数体.子终点, 符号表, 诊断);
    }
    // 第七十七轮（A21，plans/020 矩阵 A21 格靶子）：借出视图生命周期检查——
    //   字符串元素容器借出视图（元素/读取/栈顶/队首/头部元素/读取头部/读取尾部/
    //   获取）在容器失效点/容器先亡之后仍被使用=悬垂（NLL 顺序近似；宿主
    //   semantic_borrowview.cpp 同款——移植纪律 10 两侧同缺一次修全）。
    //   在体块检查后调用（独立节点扫描，不依赖符号表时刻状态）。
    检查借出视图生命周期(池, 函数节点, 符号表, 诊断);
    当前函数返回类型 = 0 - 1;  // 55-c：函数检查结束复位（防跨函数污染）
    当前函数不安全 = 假;        // 153-a：修饰标志复位（防跨函数污染）
    清空当前引用参数();
    表弹出(符号表);
}

// ==================== 主流程 ====================
// 输入节点池+程序根；输出诊断列表；返回 错误数
// 单文件 = 主模块形态包装（键基=纯名、无导入——行为与分桶前逐字节一致；
//   主.cn 负测自检序列沿用本入口）。快照参数传空平铺（标量向量局部构造——
//   成熟路径；嵌套容器/临时值追加禁用，lessons 15 枚同族）
函数 语义分析(向量<节点> 池, 整32 程序节点, 向量<字符串> 诊断) -> 整64 {
    向量<整32> 单节点们 = 向量<整32>();
    结果<空类型, 整32> 加n = 单节点们.追加(程序节点);
    如果 (!加n.正常) { 运行时错误(4); }
    向量<字符串> 单路径们 = 向量<字符串>();
    结果<空类型, 整32> 加p = 单路径们.追加("主");
    如果 (!加p.正常) { 运行时错误(4); }
    向量<整64> 空平铺 = 向量<整64>();
    向量<整64> 空边1 = 向量<整64>();
    向量<整64> 空公开 = 向量<整64>();
    // 边界向量与程序节点们平行（每文件一项=该文件在总表中的起始偏移）——
    //   单文件形态须配对传入（切片段 边界们.元素(j) 防越界）
    结果<空类型, 整32> 加b1 = 空边1.追加(0);
    如果 (!加b1.正常) { 运行时错误(4); }
    返回 语义分析多文件(池, 单节点们, 单路径们, 空平铺, 空边1, 空公开, 诊断);
}

// ==================== 主流程（多文件 P6h + 模块分桶 plans/018 第 3 层） ====================
// 多源文件：程序节点们 = 各文件 程序 节点索引（加载器按依赖先解析的顺序收集）；
//   模块路径们 = 每文件模块路径；导入项平铺总表/导入模块总表 = 全部文件 ②③
//   快照拼接（边界们[f]=文件 f 起始偏移，段=[边界[f], 边界[f+1] 或 总表尾)）；
//   公开平铺总表 = 全部文件 公开: 标签快照拼接（交替 [声明节点索引, 1]——
//   节点索引全池唯一，无需边界）。
// 第一趟：全部文件 声明收集（链接键分桶登记+模块成员索引+可见性）；
// 第二趟：逐文件 构建文件导入上下文（② 导入目标+E0255+③ glob 清单）后检查
//   函数体（三级解析）。返回 诊断数（含查找链路诊断缓冲合入）。
函数 语义分析多文件(向量<节点> 池, 向量<整32> 程序节点们,
                    向量<字符串>& 模块路径们,
                    向量<整64>& 导入项平铺总表, 向量<整64>& 导入项边界们,
                    向量<整64>& 公开平铺总表,
                    向量<字符串> 诊断) -> 整64 {
    向量<映射<整64, 符号>> 符号表 = 向量<映射<整64, 符号>>();
    表压入(符号表);  // 全局作用域（全部文件 函数/结构体 声明）
    清空调用决议();   // plans/018 第 4 层：调用决议表任务级生命周期
    清空模块解析表(); // 模块成员索引/导入上下文/三级缓存 任务级生命周期
    清空函数签名();  // 呈报③方案A：函数签名表任务级生命周期（入口清空）
    // 公开表构建（平铺 -> 映射点查：声明收集 按节点索引查可见性）
    映射<整64, 整64> 公开表 = 映射<整64, 整64>();
    整64 oi = 0;
    当 (oi + 1 < 公开平铺总表.大小()) {
        结果<空类型, 整32> 设公 = 公开表.设置(公开平铺总表.元素(oi), 1);
        如果 (!设公.正常) { 运行时错误(4); }
        oi += 2;
    }
    整64 i = 0;
    当 (i < 程序节点们.大小()) {
        声明收集(池, 程序节点们.元素(整32(i)), 符号表, 诊断,
                 模块路径们.元素(整32(i)), 公开表);
        i++;
    }
    // ③ 合并全局可见的遍历范围=加载树全部模块 ID（stdlib 不在成员索引天然 miss）。
    //   模块集合去重（plans/018 v2self 锚定轮根治，宿主 findModule 模块表唯一化对齐）：
    //   模块路径们 是文件级快照（每文件一条）——目录包根与撞名成员共享模块路径
    //   （候选1b 包根本模块路径=模块名，成员 代码生成.cn 挂载名同为「代码生成」；
    //   货舱解析 同款），重复条目使 ③ 遍历对同一模块双计数：同签名第二命中
    //   参串标==首参串标 恒真 -> 同名纯名调用假报 E0659 歧义（来源们=自拼接
    //   「货舱解析/货舱解析」，v2self 实测）。映射 O(1) 查重=模块集合语义归一。
    向量<整64> 全部模块ID们 = 向量<整64>();
    映射<整64, 整64> 已见模块集合 = 映射<整64, 整64>();
    整64 mi2 = 0;
    当 (mi2 < 模块路径们.大小()) {
        整64 模块IDg = 驻留(模块路径们.元素(整32(mi2)));
        结果<整64, 整32> 查见g = 已见模块集合.获取(模块IDg);
        如果 (!查见g.正常) {
            结果<空类型, 整32> 加g2 = 全部模块ID们.追加(模块IDg);
            如果 (!加g2.正常) { 运行时错误(4); }
            结果<空类型, 整32> 设见g = 已见模块集合.设置(模块IDg, 1);
            如果 (!设见g.正常) { 运行时错误(4); }
        }
        mi2++;
    }
    整64 j = 0;
    当 (j < 程序节点们.大小()) {
        // 每文件检查前：从总表切本文件 ② 段（局部标量向量）+构建导入上下文
        //   （E0255/私有/存在性诊断仅此一处）
        整64 平铺起 = 导入项边界们.元素(整32(j));
        整64 平铺终 = 导入项平铺总表.大小();
        如果 (j + 1 < 导入项边界们.大小()) { 平铺终 = 导入项边界们.元素(整32(j + 1)); }
        向量<整64> 本平铺段 = 向量<整64>();
        整64 si = 平铺起;
        当 (si < 平铺终) {
            结果<空类型, 整32> 加s = 本平铺段.追加(导入项平铺总表.元素(整32(si)));
            如果 (!加s.正常) { 运行时错误(4); }
            si++;
        }
        构建文件导入上下文(模块路径们.元素(整32(j)), 本平铺段, 全部模块ID们, 诊断, 假);
        节点 程序 = 池.元素(程序节点们.元素(整32(j)));
        整64 k = 整64(程序.子起点);
        当 (k < 整64(程序.子终点)) {
            节点 声明 = 池.元素(整32(k));
            如果 (声明.类型 == 节点_函数) {
                // plans/018 类型分桶：返回类型诊断（声明.附加=返回类型名ID）
                检查类型引用(符号表, 诊断, 整64(声明.附加));
                检查函数(池, 整32(k), 符号表, 诊断);
            }
            如果 (声明.类型 == 节点_类) {
                // 第七十八轮（2026-09-12）：类方法体检查——第三类函数级作用域
                //   单元（字段裸名解析 + 参数登记 + 借出检查挂载，见 语义检查类）
                检查类方法们(池, 整32(k), 符号表, 诊断);
            }
            k++;
        }
        j++;
    }
    表弹出(符号表);  // 释放全局作用域
    // 查找链路诊断缓冲合入（三级歧义 E0659——查找函数无诊断参数，缓冲聚合）
    整64 bi = 0;
    当 (bi < 取语义诊断数()) {
        表诊断(诊断, 取语义诊断(bi));
        bi++;
    }
    清空语义诊断缓冲();
// 157-a（plans/023 §十 步骤 5 收口）：诊断无分级——列表全量=语义错误数
//   （154-a 的「观察期警告不计入」排除已随收口删除：安全区边界=硬错误，
//   任何残留命中都必须计数并中止，观察期语义已结束）。
返回 诊断.大小();
}
