// CN 自举编译器 v2 · 语义检查——用户类/接口实例方法调用三段检查（907 同族收口）
// 职责：接收者类型∈{用户类, 接口} 的 对象.方法(实参) 调用语义层三段检查
//   （宿主 semantic_call_member.cpp checkInstanceMethodCall /
//   checkInterfaceMethodCall / checkMemberCallCore 静态纪律 同面移植）：
//   ①方法名沿基链不存在 -> 用户类「类 'X' 没有成员 'Y'」（构造名形态=父构造
//     引导文案）；接口「接口 'X' 没有成员 'Y'」；
//   ②实参个数不符 -> 「方法 'X' 期望 N 个实参，实际提供 M 个」（接口面前缀
//     「接口方法」）；
//   ③实参类型不可隐式转换 -> 「方法 'X' 第 i 个实参无法将 'A' 隐式转换为 'B'」。
//   另收两纪律：实例.静态方法() 非法（宿主 checkMemberCallCore 段）与
//   接口名.方法() 非法（宿主 checkInterfaceMethodCall 首段）。
// 背景（907 同族扫描实地探针 B/D/E/F/G/J/K/L 双侧实录）：v2 语义层对用户类/
//   接口实例方法调用零检查——实参个数错走 IR 层「[ir2] 方法调用实参数不匹配」/
//   「[ir2] 接口方法调用实参数不匹配」+运行时错误(6) 崩溃式拒绝；接口方法名
//   miss 走「[ir2] 接口无此方法」/接口名直调走「[ir2] 方法调用对象类型未解析」；
//   实参类型错（用户类/接口两侧）与 实例.静态方法() 甚至 rc=0 静默放行产码。
//   宿主同源分别给语义诊断（三段+两纪律文案逐字对齐）。
// 数据源=IR 类表/接口表（声明收集期已登记·623 调用参数串ID623 同源消费）：
//   查类方法定义层（沿基链·0=无）/查类方法参数串（沿链·0=无参）/是类静态方法/
//   查接口方法槽/查接口方法参数串。实参转换判定复用 实参转换非法/实参源类型
//   文本（语义检查实参.cn 549 族判定本体——标量目标面·取地址实参与非标量目标
//   内建放行）。方法名 miss 判据=定义层 0 且 类字段沿链 miss（函数指针字段
//   调用面让位）。
// 接收者解析=容器方法接收者类型（907 容器文件共用·标识符=符号表类型/成员链=
//   语义成员链推导）+ 成员方法剥星（尾星剥一级·先按全名判定命中——泛型实参
//   尾星是实例名一部分·簇⑥根治先例·宿主 canonicalType/pointeeOf 同构）。
// 诚实边界（检不出放行·防误伤）：接收者=自身/父类/调用返回/下标/解引用对象
//   （推导不可靠面）；接收者类型推导 miss；泛型实例合成名（IR 阶段克隆·语义期
//   类表未登记——是用户类_ID 恒假天然放行）；用户类方法名 miss 的标识符接收者
//   面=语义检查表达式 907 块承担（防双报·本文件承担成员链接收者与接口面报告）；
//   形参非标量目标（指针/引用/类/结构体/接口/容器——实参转换非法 内建同款边界）。
// 写码风格（882 三红门禁）：条件位全命名布尔；否则分支仅报错调用+返回；
//   字面量区间比较入命名布尔（if 条件无单边无限区间）。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/查调用实参末位（解析表达式中）
导入 IR;         // 用户类/接口判定·类方法表·接口方法槽·参数串切段·参数段个数
导入 协议常量;   // 驻留/驻留文本（中立层）
导入 借用实参登记750;   // 750 P0-A：接口方法引用位扫描（语义层辅助）

公开:

// ==================== 907 同族：接收者类型与辅助判定 ====================

// 成员接收者类型剥指针尾星一级：先按全名判定命中（泛型实参尾星如 盒子$整64*
//   是实例名一部分——簇⑥根治先例）；未命中且尾字节 '*' 才剥；剥后为空（"*"
//   孤星形态）原样返回=上层判定天然 miss（诚实边界）。
函数 成员方法剥星(整64 类型ID) -> 整64 {
    布尔 入参有效 = 类型ID > 0;
    如果 (!入参有效) { 返回 类型ID; }
    布尔 直接命中 = 是用户类_ID(类型ID) || 是接口名ID(类型ID) || 是容器类_ID(类型ID);
    如果 (直接命中) { 返回 类型ID; }
    字符串 文本 = 字符串复制(驻留文本(类型ID));
    整64 长 = 字符串长度(文本);
    布尔 有尾星 = 长 > 0 && ((整64(文本[整32(长 - 1)]) & 255) == 42);
    如果 (!有尾星) { 返回 类型ID; }
    字符串 剥后 = 字符串子串(文本, 0, 整32(长 - 1));
    布尔 剥后非空 = 字符串长度(剥后) > 0;
    如果 (!剥后非空) { 返回 类型ID; }
    返回 驻留(剥后);
}

// 类字段沿基链命中判定（节点_类字段 文本=字段名·扫描形态与 查类方法节点沿链/
//   575-a 私有可见性扫描同构）——方法名 miss 报告前守卫：字段命中=该成员存在
//   （函数指针字段调用面），不属「没有成员」面（字段面检查=各自通道）。
函数 查类字段沿链907(向量<节点> 池, 整64 类名ID, 整64 字段名ID) -> 布尔 {
    整64 当前类 = 类名ID;
    整64 守卫h = 0;
    布尔 命中 = 假;
    当 (!命中 && 当前类 != 0 && 守卫h < 64) {
        可选<整64> 类节点查 = 查类节点索引(当前类);
        整64 类节点 = 0 - 1;
        如果 (类节点查.有值) { 类节点 = 类节点查.值; }
        布尔 节点有效 = 类节点 >= 0 && 类节点 < 整64(池.大小());
        如果 (节点有效) {
            节点 类值 = 池.元素(整32(类节点));
            整64 扫 = 整64(类值.子起点);
            当 (!命中 && 扫 < 整64(类值.子终点)) {
                节点 成员 = 池.元素(整32(扫));
                布尔 是命名字段 = 成员.类型 == 节点_类字段 &&
                                  整64(成员.文本) == 字段名ID;
                如果 (是命名字段) { 命中 = 真; }
                扫++;
            }
        }
        // 1541 B2：无值=链到此为止（原 0 终止循环·中断同效）
        可选<整64> 基查h = 查类基名(当前类);
        如果 (!基查h.有值) { 中断; }
        如果 (基查h.有值) { 当前类 = 基查h.值; }
        守卫h++;
    }
    返回 命中;
}

// ==================== 907：逐实参隐式转换检查（共用体） ====================

// 逐实参转换检查（标量目标面·实参转换非法 内建非标量/取地址放行）：诊断前缀=
//   被调描述（用户类「方法」/接口「接口方法」/容器「方法」——宿主三路文案）。
//   归纳说明（纪律二·事不过三）：第 2 处消费点出现即提炼为本函数——容器检查
//   原内联循环改经本函数（907 同轮归纳·单点判定防两路措辞分叉）。
函数 逐实参转换检查907(向量<节点> 池, 整64 节点索引, 整64 实参数,
                    字符串 参数串, 字符串 方法名文本, 字符串 前缀,
                    向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    整64 i = 0;
    当 (i < 实参数) {
        字符串 形参文本 = 取参数段(参数串, i);
        可选<整64> 末位查 = 查调用实参末位(节点索引, i);
        布尔 参段有效 = 字符串长度(形参文本) > 0;
        布尔 末位有效 = 假;
        整64 末位 = 0 - 1;
        // 可选值访问形态：.值 只在 .有值 单条件真分支内提取为普通局部
        如果 (末位查.有值) {
            整64 末位值 = 末位查.值;
            如果 (末位值 >= 0 && 末位值 < 整64(池.大小())) {
                末位有效 = 真;
                末位 = 末位值;
            }
        }
        如果 (参段有效 && 末位有效) {
            // 1819（1784 丁案实施④·多态禁切片）：值形态类切片（派生类实参 →
            //   基类值形参）=专用切片诊断（报切片专用诊断 单点·逐字对齐宿主
            //   reportSliceReject；容器/用户类方法/接口/静态四路共用本函数=
            //   一点全覆盖）。修前 实参转换非法 对类形参诚实边界放行 → 容器入
            //   派生实例宿主拒 v2 放行=分叉（1650 实录）；引用/指针形参=同地址
            //   合法面（是类切片形态 经用户类表 ID 天然排除·616 零误伤）。
            报切片专用诊断(推导右值类源类型(池, 整32(末位), 符号表),
                            驻留(形参文本), 诊断);
        }
        如果 (参段有效 && 末位有效 &&
            实参转换非法(池, 整32(末位), 驻留(形参文本), 符号表)) {
            表诊断(诊断, "[错误] " + 前缀 + " '" + 方法名文本 + "' 第 " +
                         整数转字符串(i + 1) + " 个实参无法将 '" +
                         实参源类型文本(池, 整32(末位), 符号表, 形参文本) +
                         "' 隐式转换为 '" + 形参文本 + "'");
        }
        i++;
    }
}

// ==================== 907：用户类实例方法调用检查 ====================

// 用户类三段+静态纪律。miss 分流：构造名（成员名=类名）=父构造引导文案（907
//   块同款·标识符接收者面 907 块对构造节点扫描命中不报 miss，本文件为唯一报
//   出口——两方判定输入不同源但互斥，无双报）；标识符接收者其余 miss=907 块
//   承担；成员链接收者 miss=本文件报告。
函数 检查用户类方法调用907(向量<节点> 池, 整64 类型ID, 整64 调用索引,
                       节点 被调, 节点 n, 布尔 接收者是标识符,
                       向量<映射<整64, 符号>>& 符号表,
                       向量<字符串>& 诊断) -> 空类型 {
    字符串 类名文本 = 字符串复制(驻留文本(类型ID));
    整64 方法名ID = 整64(被调.文本);
    字符串 方法名文本 = 字符串复制(驻留文本(方法名ID));
    整64 实参数 = 整64(n.附加);
    // 1541 B2：无值=沿基链无此方法（原 0 判据）
    可选<整64> 定义查907 = 查类方法定义层(类型ID, 方法名ID);
    布尔 方法存在 = 定义查907.有值;
    整64 定义层 = 0;
    如果 (定义查907.有值) { 定义层 = 定义查907.值; }
    如果 (!方法存在) {
        布尔 是构造名 = 字符串比较(方法名文本, 类名文本);
        布尔 字段存在 = 查类字段沿链907(池, 类型ID, 方法名ID);
        如果 (字段存在) { 返回; }        // 字段面（含函数指针字段调用）=另域
        如果 (是构造名) {
            表诊断(诊断, "[错误] 构造函数 '" + 方法名文本 +
                "' 不能经成员访问调用——父类构造须经初始化列表（: " +
                方法名文本 + "(实参)）调用");
            返回;
        }
        如果 (接收者是标识符) { 返回; }   // 标识符 miss=907 块报告（防双报）
        表诊断(诊断, "[错误] 类 '" + 类名文本 + "' 没有成员 '" + 方法名文本 + "'");
        返回;
    }
    布尔 静态方法 = 是类静态方法(定义层, 方法名ID);
    如果 (静态方法) {
        // 接收者来自符号表类型解析=实例形态（类名.静态方法 合法形态由 93-a/
        // 限定调用通道承担·此处不触发）
        表诊断(诊断, "[错误] 实例.静态方法() 非法：静态方法 '" + 方法名文本 +
            "' 须经类名调用（" + 字符串复制(驻留文本(定义层)) + "." +
            方法名文本 + "）");
        返回;
    }
    // 1541 B2：无值=方法表未登记参数串→空参数串（原 0→空串逐点等价）
    字符串 参数串 = "";
    可选<整64> 参数串查 = 查类方法参数串(类型ID, 方法名ID);
    布尔 有参数串 = 参数串查.有值;
    如果 (参数串查.有值) { 参数串 = 字符串复制(驻留文本(参数串查.值)); }
    整64 期望个数 = 参数段个数(参数串);
    布尔 个数相符 = 期望个数 == 实参数;
    如果 (!个数相符) {
        表诊断(诊断, "[错误] 方法 '" + 方法名文本 + "' 期望 " +
            整数转字符串(期望个数) + " 个实参，实际提供 " +
            整数转字符串(实参数) + " 个");
        返回;
    }
    逐实参转换检查907(池, 调用索引, 实参数, 参数串, 方法名文本, "方法",
                    符号表, 诊断);
}

// ==================== 907：接口实例方法调用检查 ====================

// 接口三段（宿主 checkInterfaceMethodCall 同面）：槽 miss=没有成员；个数不符=
//   接口方法期望 N；逐实参转换=接口方法第 i 个。接口无继承表结构（接口方法槽
//   精确键·v2 接口面单层），槽查=全量。
函数 检查接口方法调用907(向量<节点> 池, 整64 接口ID, 整64 调用索引,
                      节点 被调, 节点 n,
                      向量<映射<整64, 符号>>& 符号表,
                      向量<字符串>& 诊断) -> 空类型 {
    字符串 接口名文本 = 字符串复制(驻留文本(接口ID));
    整64 方法名ID = 整64(被调.文本);
    字符串 方法名文本 = 字符串复制(驻留文本(方法名ID));
    整64 实参数 = 整64(n.附加);
    可选<整64> 槽查 = 查接口方法槽(接口ID, 方法名ID);
    如果 (!槽查.有值) {
        表诊断(诊断, "[错误] 接口 '" + 接口名文本 + "' 没有成员 '" +
            方法名文本 + "'");
        返回;
    }
    整64 参数串ID = 0;
    可选<整64> 参数串查 = 查接口方法参数串(接口ID, 方法名ID);
    如果 (参数串查.有值) { 参数串ID = 参数串查.值; }
    字符串 参数串 = "";
    布尔 有参数串 = 参数串ID > 0;
    如果 (有参数串) { 参数串 = 字符串复制(驻留文本(参数串ID)); }
    整64 期望个数 = 参数段个数(参数串);
    // P0-A-2（750 复审）：接口方法引用位扫描——接口方法无类方法节点表，借用位
    //   扫描202 类/构造入口覆盖不到；按参数串段尾 '&' 解析引用位后复用（登记
    //   引用实参根 + 已扫描标记）。
    如果 (有参数串) {
        接口方法引用位扫描750(池, 调用索引, 实参数, 参数串, 符号表, 诊断);
    } 否则 { }
    布尔 个数相符 = 期望个数 == 实参数;
    如果 (!个数相符) {
        表诊断(诊断, "[错误] 接口方法 '" + 方法名文本 + "' 期望 " +
            整数转字符串(期望个数) + " 个实参，实际提供 " +
            整数转字符串(实参数) + " 个");
        返回;
    }
    逐实参转换检查907(池, 调用索引, 实参数, 参数串, 方法名文本, "接口方法",
                    符号表, 诊断);
}

// ==================== #1593：静态方法实参检查（点号+限定两形态共用） ====================

// #1593（#1588 审计相邻面·零分叉）：类名.静态方法(...) 与 类名::静态方法(...)
//   的实参个数+逐位类型检查——宿主 checkStaticMethodCall 单点（两形态同走）。
//   v2 原状：:: 形态只有个数检查（无类型检查）；点号形态接收者类型解析 miss
//   即早退=个数/类型双零检查静默放行（探针 工具.取整("字符串")/工具.取整()
//   双侧实证）。本函数为两形态单一判定点（纪律二·防措辞分叉）。
//   参数串=查类方法参数串（沿链·445 限定通道同源）；逐位复用 实参转换非法。
函数 检查静态方法调用1593(向量<节点> 池, 整64 调用索引, 字符串 类名文本,
                       字符串 方法名文本,
                       向量<映射<整64, 符号>>& 符号表,
                       向量<字符串>& 诊断) -> 空类型 {
    节点 n1593 = 池.元素(整32(调用索引));
    字符串 参数串1593 = "";
    可选<整64> 参数串查1593 = 查类方法参数串(整64(驻留(类名文本)),
                                         整64(驻留(方法名文本)));
    布尔 串非空1593 = 假;
    如果 (参数串查1593.有值) {
        参数串1593 = 字符串复制(驻留文本(参数串查1593.值));
        串非空1593 = 字符串长度(参数串1593) > 0;
    }
    // 串非空=形参表非空（逗号切段）；空串=无参方法（1541 B2 口径·与 445 同源）
    整64 期望数1593 = 0;
    如果 (串非空1593) { 期望数1593 = 参数段个数(参数串1593); }
    整64 实参数1593 = 整64(n1593.附加);
    布尔 个数相符1593 = 实参数1593 == 期望数1593;
    如果 (!个数相符1593) {
        表诊断(诊断, "[错误] 静态方法 '" + 方法名文本 + "' 期望 " +
                      整数转字符串(期望数1593) + " 个实参，实际提供 " +
                      整数转字符串(实参数1593) + " 个");
        返回;
    }
    如果 (串非空1593) {
        逐实参转换检查907(池, 调用索引, 实参数1593, 参数串1593, 方法名文本,
                        "静态方法", 符号表, 诊断);
    }
}

// ==================== 907：挂点入口 ====================

// 检查实例方法调用（挂点=检查调用表达式 入口——与 检查容器方法调用 同列）：
//   接口名.方法() 非法面（宿主按接收者名字判定）-> 接收者类型解析（容器方法
//   接收者类型+剥星）-> 容器面让位（容器文件承担）-> 用户类/接口两路分派。
函数 检查实例方法调用907(向量<节点> 池, 整32 节点索引,
                      向量<映射<整64, 符号>>& 符号表,
                      向量<字符串>& 诊断) -> 空类型 {
    布尔 索引有效 = 节点索引 >= 0 && 节点索引 < 整32(池.大小());
    如果 (!索引有效) { 返回; }
    节点 n = 池.元素(节点索引);
    布尔 调用形 = n.类型 == 节点_调用;
    布尔 被调位有效 = n.子起点 > 0 && 整64(n.子起点) < 整64(池.大小());
    如果 (!调用形 || !被调位有效) { 返回; }
    节点 被调 = 池.元素(整32(n.子起点));
    布尔 被调是成员 = 被调.类型 == 节点_成员;
    布尔 成员对象有效 = 被调.子起点 > 0 && 整64(被调.子起点) < 整64(池.大小());
    如果 (!被调是成员 || !成员对象有效) { 返回; }
    节点 对象 = 池.元素(整32(被调.子起点));
    字符串 方法名文本 = 字符串复制(驻留文本(整64(被调.文本)));
    布尔 对象是标识符 = 对象.类型 == 节点_标识符;
    字符串 对象名文本 = "";
    如果 (对象是标识符) { 对象名文本 = 字符串复制(驻留文本(整64(对象.文本))); }
    布尔 对象是接口名 = 对象是标识符 && 是接口名(对象名文本);
    如果 (对象是接口名) {
        表诊断(诊断, "[错误] 接口名.方法() 非法：接口方法 '" + 方法名文本 +
             "' 须经接口对象调用（接口类型名无实例）");
        返回;
    }
    // #1593：类名.静态方法 点号形态——实参个数+类型检查（宿主 checkStaticMethodCall
    //   单点覆盖两形态；v2 原该形态接收者类型解析 miss 即早退=零检查）。遮蔽判据
    //   同 检查类名成员访问：局部/参数与类名同名时按实例语义走下方通道。
    布尔 类名静态面1593 = 对象是标识符 && 是用户类(对象名文本) &&
                           是类静态方法(整64(对象.文本), 整64(被调.文本));
    如果 (类名静态面1593) {
        可选<整64> 种查1593 = 表查找种类(符号表, 整64(对象.文本));
        布尔 被遮蔽1593 = 假;
        如果 (种查1593.有值) {
            如果 (种查1593.值 == 符号_变量 || 种查1593.值 == 符号_参数) {
                被遮蔽1593 = 真;
            }
        }
        如果 (被遮蔽1593) { 类名静态面1593 = 假; }
    }
    如果 (类名静态面1593) {
        检查静态方法调用1593(池, 整64(节点索引), 对象名文本, 方法名文本,
                          符号表, 诊断);
        返回;
    }
    // 1541 B2：有值=接收者类型可解析（原 >0 判据）
    可选<整64> 接收者查 = 容器方法接收者类型(池, 被调, 符号表);
    如果 (!接收者查.有值) { 返回; }
    整64 接收者类型 = 0;
    如果 (接收者查.有值) { 接收者类型 = 接收者查.值; }
    整64 类型907 = 成员方法剥星(接收者类型);
    布尔 容器面 = 是容器类_ID(类型907);
    如果 (容器面) { 返回; }              // 容器三段=语义检查容器方法.cn 承担
    布尔 用户类面 = 是用户类_ID(类型907);
    如果 (用户类面) {
        检查用户类方法调用907(池, 类型907, 整64(节点索引), 被调, n,
                          对象是标识符, 符号表, 诊断);
        返回;
    }
    布尔 接口面 = 是接口名ID(类型907);
    如果 (接口面) {
        检查接口方法调用907(池, 类型907, 整64(节点索引), 被调, n,
                          符号表, 诊断);
        返回;
    }
    返回;
}
