// CN 自举编译器 v2 · 语义检查·遍历语句族（812 拆分：自 语义检查中.cn 机械搬移
//   检查遍历894——该文件 997 行撞 900 警戒线且本任务需增行，「先拆再加」纪律；
//   按族拆文件先例=语义检查赋值/复合赋值/lambda）。
// 职责：检查遍历894（遍历...中每个 语义检查·C-2）+ 推导遍历对象类型ID（812 新增：
//   迭代对象成员/下标形态语义层精确类型推导——61 云端红根治）。
// 812 缘起：61_range_for v2 侧行 77/85 `遍历 班.成绩 中 每个 成绩`——成员形态
//   迭代对象经 检查成员访问表达式 恒得 整64（「字段类型暂 整64」占位·648 归档），
//   元素类型不可推导→兜底分支 648 显形中止（宿主绿=checkExpr 返回字段真实类型
//   后 desugarRangeForIterable arrayElemOf）。本族补语义层精确推导面：成员链=
//   1012 推导语义成员链类型（812 起数组父剥层）+下标末端=父数组剥一层/尾星取
//   所指；推不出仍走 648 显形（miss 非静默）。

导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_* 常量
导入 IR;         // 数组元素文本/是容器类/登记内部未登记 + 节点_* 常量
导入 协议常量;   // 335 协议常量独立包

公开:   // 检查遍历894 / 推导遍历对象类型ID 供包内兄弟（语义检查中 语句分派）经合并全局池消费

// 894-a（070·G-N 特性波3·61/97）：检查遍历语句——迭代对象区间检查 + 类型
//   推导（数组→元素类型=数组元素文本/类容器→元素类型=合成名首实参·宿主
//   visitRangeForStmt 降级判据同构）+ 迭代变量登记（所在层·表弹出自然清）
//   + 体块递归（新作用域）。非数组非类容器=显式诊断（宁严勿松）。
// 812：成员/下标形态迭代对象检查后叠加 推导遍历对象类型ID 精确类型覆盖——
//   检查成员访问表达式/检查下标表达式 保留全部检查副作用（可见性/联合体/
//   编译期越界面），仅遍历推导点把 整64 占位/-1 换成精确类型；其余消费面
//   零变化。不可推导（精确值<=0）维持原值走下方 648 显形路径。
函数 检查遍历894(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    节点 n = 池.元素(节点索引);
    设当前诊断行(n.行);
    // 迭代对象区间检查
    整64 检q = 整64(n.文本);
    当 (检q < 整64(n.子起点)) {
        可选<整64> 忽略q = 检查表达式(池, 整32(检q), 符号表, 诊断);
        检q++;
    }
    // 类型推导（标识符直查；成员链/下标=复用语义层检查函数推导——61 结构体
    //   字段数组 `遍历 班.成绩 中` 形态）
    整64 对象类型ID = 0;
    如果 (n.子起点 > n.文本) {
        节点 对象末q = 池.元素(整32(n.子起点 - 1));
        如果 (对象末q.类型 == 节点_标识符) {
            可选<整64> 对象类型ID查 = 表查找类型ID(符号表, 整64(对象末q.文本));
            // miss 保持 0（下方 >0 判定与原 -1 哨兵同假·880 批5）
            如果 (对象类型ID查.有值) { 对象类型ID = 对象类型ID查.值; }
        } 否则 如果 (对象末q.类型 == 节点_成员) {
            对象类型ID = 检查成员访问表达式(池, 整32(n.子起点 - 1), 符号表, 诊断);
            // 812：检查成员访问表达式 恒返 整64（「字段类型暂」占位·648 归档）
            //   ——遍历推导点叠加语义层精确类型（成员链=1012 推导语义成员链
            //   类型·宿主 visitMemberExpr 真实字段类型返回对齐）
            //   1541 B2：有值=精确类型（原 >0 判据）
            可选<整64> 精确812查 = 推导遍历对象类型ID(池, 整32(n.子起点 - 1), 符号表);
            如果 (精确812查.有值) { 对象类型ID = 精确812查.值; }
        } 否则 如果 (对象末q.类型 == 节点_下标) {
            // 1543（#1543 结果化）：正常=类型ID（0=不可判）；错误(1)=已诊断拒绝
            结果<整64, 整32> 下标果1543 = 检查下标表达式(池, 整32(n.子起点 - 1), 符号表, 诊断);
            如果 (下标果1543.正常) { 对象类型ID = 下标果1543.值; } 否则 { }
            // 812：同上——数组对象本返登记元素类型；白名单外形态 0/整64
            //   占位，遍历推导点换精确类型（父数组剥一层/尾星指针取所指）
            可选<整64> 精确d812查 = 推导遍历对象类型ID(池, 整32(n.子起点 - 1), 符号表);
            如果 (精确d812查.有值) { 对象类型ID = 精确d812查.值; }
        } 否则 如果 (对象末q.类型 == 节点_调用) {
            // 913-b（070-001 收口②·97）：迭代对象=函数调用返回容器——类型=被调
            //   返回类型（检查调用表达式 复用；宿主「非名称式迭代对象先求值为
            //   隐藏临时变量再经 大小()/元素() 遍历」同构语义）
            // B2（#1360 结果化）：错误同原 0/-1——对象类型ID 保持初值 0（>0 判据恒假）
            结果<整64, 整32> 调用果913 = 检查调用表达式(池, 整32(n.子起点 - 1), 符号表, 诊断);
            如果 (调用果913.正常) {
                对象类型ID = 调用果913.值;
            } 否则 {
                // 错误同原 0/-1——类型未知（对象类型ID 保持初值 0·下游 >0 跳过）
            }
        }
    }
    字符串 元素类型文本q = "";
    字符串 对象类型文本q = "";
    如果 (对象类型ID > 0) {
        对象类型文本q = 字符串复制(驻留文本(对象类型ID));
        可选<字符串> 数组元素q查 = 数组元素文本(对象类型文本q);
        字符串 数组元素q = "";
        如果 (数组元素q查.有值) { 数组元素q = 字符串复制(数组元素q查.值); }
        如果 (字符串长度(数组元素q) > 0) {
            元素类型文本q = 数组元素q;   // 数组：整32[5] -> 整32
        } 否则 如果 (是容器类(对象类型文本q)) {
            元素类型文本q = 合成名首实参(对象类型文本q);   // 向量$整32$ -> 整32
        }
    }
    如果 (字符串长度(元素类型文本q) == 0) {
        节点 对象末w = 池.元素(整32(n.子起点 - 1));
        如果 (对象末w.类型 == 节点_成员 || 对象末w.类型 == 节点_下标) {
            // 812 后本分支=推导遍历对象类型ID 不可推导的真 miss 面（成员链根
            //   未登记/字段表 miss/下标父非数组非指针等）——648：miss 不可静默，
            //   显形经 IR 包收集表（登记处出诊断行·主收尾统一中止）；
            //   整64 登记保留（中止前路径·保体内声明性检查继续）。
            登记内部未登记("遍历迭代元素类型语义层不可推导（成员/下标形态兜底整64）",
                           "节点" + 整数转字符串(整64(节点索引)), 整64(取当前诊断行()));
            整64 忽略兜 = 表注册(符号表, 整64(n.子终点), 驻留("整64"), 符号_变量, 0);
            检查块(池, 整32(n.附加), 符号表, 诊断);
            返回;
        }
        表诊断(诊断, "[错误] '遍历...中每个' 迭代对象须为数组或类容器（向量<T> 等）" +
                      (字符串长度(对象类型文本q) > 0 ? "，实际为 '" + 对象类型文本q + "'" : ""));
        返回;
    }
    // 迭代变量登记（类型=元素类型·体块内可见；所在层弹出自然清）
    整64 忽略注 = 表注册(符号表, 整64(n.子终点), 驻留(元素类型文本q), 符号_变量, 0);
    // 体块递归（新作用域）
    检查块(池, 整32(n.附加), 符号表, 诊断);
}

// 812：遍历迭代对象语义层类型推导（成员/下标形态）——有值=类型名ID
//   （无值=不可推导·调用方维持 648 显形中止=miss 非静默）。
//   宿主对齐：visitRangeForStmt checkExpr(iterable)=迭代对象真实类型返回。
//   形态：①标识符/成员链=1012 推导语义成员链类型（数组父剥层随 1012 补齐）；
//   ②下标末端=父类型数组剥一层元素（剥一层数组后缀375）/尾星指针取所指
//   （宿主 visitIndexExpr 所指类型同构）。纯推导零诊断零登记（检查副作用
//   已由调用方 检查表达式 区间检查承担）。1541 B2：结果化——有值=类型ID/
//   无值=不可推导（0 哨兵退场）。
函数 推导遍历对象类型ID(向量<节点> 池, 整32 节点索引,
                      向量<映射<整64, 符号>>& 符号表) -> 可选<整64> {
    节点 n = 池.元素(节点索引);
    如果 (n.类型 == 节点_下标 && n.子起点 > 0 &&
         整64(n.子起点) < 池.大小()) {
        可选<整64> 父类型查812 = 推导遍历对象类型ID(池, 整32(n.子起点), 符号表);
        整64 父类型812 = 0;
        如果 (父类型查812.有值) { 父类型812 = 父类型查812.值; }
        如果 (父类型812 <= 0) { 返回 无; }
        字符串 父文本812 = 字符串复制(驻留文本(父类型812));
        // 数组对象：剥一层元素（矩阵[0] -> 整32[3]·宿主 visitIndexExpr 同构）
        如果 (是数组类型文本(父文本812)) {
            返回 某些(驻留(剥一层数组后缀375(父文本812)));
        }
        // 尾星指针对象：所指类型（p[i] ≡ *(p+i)·语义层下标白名单面同源）
        整64 长812 = 字符串长度(父文本812);
        如果 (长812 > 1 && ((整64(父文本812[整32(长812 - 1)]) & 255) == 42)) {
            返回 某些(驻留(字符串子串(父文本812, 0, 整32(长812 - 1))));
        }
        返回 无;
    }
    // 880 批5：成员链推导结果化——无值/0=不可推导（本函数 有值=可推导契约，
    //   调用方 有值 判据逐点保持）
    可选<整64> 链类型查812 = 推导语义成员链类型(池, 节点索引, 符号表);
    如果 (链类型查812.有值) {
        整64 链类型812 = 链类型查812.值;
        如果 (链类型812 != 0) { 返回 某些(链类型812); }
    }
    返回 无;
}
