// CN 自举编译器 v2 · 语义检查（千行拆分子模块，2026-09-08 用户裁决阶段目录包）
// 职责：逐节点语义检查（成员偏移标注/检查表达式/检查语句/检查块/检查如果/
//   检查当/检查函数）——自 语义分析.cn 机械搬移；符号表经参数传递，模块
//   解析表经 公开: 访问函数（语义分析 主干）；模块路径=语义检查（新键基）。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（原 导入 语法分析，目录包名）
导入 IR;         // 容器/结果 合成名判定 + 节点_*/键位移 常量（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 借出检查;    // 第七十七轮 A21：借出视图生命周期检查（函数级调用）
导入 语义检查逃逸;   // 435：lambda 引用捕获逃逸检查（返回/赋值/实参/声明位·包内兄弟）

公开:   // 全文件公开（检查族+主流程供 包/主.cn 消费）
// D1 行数整改 122-a：自 语义检查.cn 按族拆出——语句类检查（检查推断声明语句 + 检查变量声明语句 + 检查赋值语句 + 检查复合赋值操作数 + 登记跳过区间；纯重构零行为变更；本族不直接访问文件级静态）

// 变量声明语句检查（R3 拆分，2026-09-08 自 检查语句 机械搬移）：类型引用诊断 +
//   指针/引用局部纪律 + 嵌套块同名容器遮蔽拒 + 结果/容器字面量初始化拒 +
//   成员偏移标注 + 初始化区间表达式检查。
// 推断声明检查（46-c，2026-09-10 第四十九轮）：类型节点文本=空串哨兵——
//   推断类型经 表达式类型ID 推导（字面量/标识符/调用/下标/三元/成员/二元）。
//   成功：登记推断声明类型表（IR 层生成变量声明 查表回填布局分派——主.cn
//   层间池按值传递，语义层回填对 IR 层不可见，跨层静态表与 变量结构体表
//   同模式）+符号表按推断类型登记（后续引用检查正常）+容器类同款嵌套块
//   遮蔽拒。失败：可见诊断+整64 兜底登记（err>0 语义错误即中止，兜底类型
//   无产物级静默风险）。返回 真=推断形态已处理；假=非推断（走显式类型路径）。
函数 检查推断声明语句(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 布尔 {
    节点 n = 池.元素(节点索引);
    整64 预类型ID = 整64(n.附加);
    布尔 是推断 = 假;
    如果 (预类型ID >= 0 && 预类型ID < 池.大小()) {
        节点 预类型节点 = 池.元素(整32(预类型ID));
        如果 (预类型节点.类型 == 节点_类型 && 整64(预类型节点.文本) == 整64(驻留(""))) {
            是推断 = 真;
        }
    }
    如果 (!是推断) { 返回 假; }
    如果 (n.子起点 >= n.子终点) {
        表诊断(诊断, "[错误] 推断声明必须初始化（变量 名 = 表达式）: " +
                      驻留文本(整64(n.文本)));
        返回 真;
    }
    可选<整64> 推断查 = 表达式类型ID(池, 整32(n.子终点 - 1), 符号表, 诊断);
    整64 推断ID = 0;
    如果 (推断查.有值) { 推断ID = 推断查.值; }
    如果 (推断ID <= 0) {
        表诊断(诊断, "[错误] 推断声明初值类型未知（可推导面：字面量/标识符/调用/下标/三元/成员/二元）: " + 驻留文本(整64(n.文本)));
        推断ID = 驻留("整64");
    }
    // 741（宿主 p17 探针实证：推断声明 变量 乙 = 甲 同拦——visitVarDecl 方案A
    //   检查对推断回填后类类型同样命中）：推断类型=用户类 且 初值末=标识符
    //   （或 转移(标识符)·p3 同构）→ 有析构类须有拷贝构造。调用返回初始化
    //   放行（宿主声明面只拦标识符形态·p11 实证）。
    如果 (推断ID > 0 && n.子终点 > n.子起点) {
        节点 推初末741 = 池.元素(n.子终点 - 1);
        整64 推源741 = 0;
        如果 (推初末741.类型 == 节点_标识符) {
            可选<整64> 推源741查 = 表查找类型ID(符号表, 整64(推初末741.文本));
            // miss 保持 0（下方 >0 判定与原 -1 哨兵同假·880 批5）
            如果 (推源741查.有值) { 推源741 = 推源741查.值; }
        } 否则 如果 (推初末741.类型 == 节点_调用 && 推初末741.附加 == 1 &&
                    推初末741.子起点 >= 0 &&
                    整64(推初末741.子起点) + 1 < 整64(池.大小())) {
            节点 推被调741 = 池.元素(整32(推初末741.子起点));
            节点 推实参741 = 池.元素(整32(推初末741.子起点) + 1);
            如果 (推被调741.类型 == 节点_标识符 && 推实参741.类型 == 节点_标识符 &&
                 字符串比较(驻留文本(整64(推被调741.文本)), "转移")) {
                可选<整64> 推源741查2 = 表查找类型ID(符号表, 整64(推实参741.文本));
                如果 (推源741查2.有值) { 推源741 = 推源741查2.值; }
            }
        }
        可选<整64> 推断类741查 = 剥引用取用户类741(推断ID);
        可选<整64> 推源类741查 = 剥引用取用户类741(推源741);
        布尔 推源可推741 = 推源741 > 0;
        如果 (推断类741查.有值) {
            整64 推断类741 = 推断类741查.值;
            如果 (推源可推741 && 推源类741查.有值) {
                检查有析构按值拷贝741(诊断, 推断类741);
            }
        }
    }
    检查推断面字面量值域(池, 整32(n.子终点 - 1), 推断ID, 诊断);   // 558/506甲：推断面字面量值域自洽检查（c506 实锤面·实现=语义检查表达式尾）
    登记推断声明类型(整64(n.文本), 推断ID);
    整64 忽略推 = 表注册(符号表, 整64(n.文本), 推断ID, 符号_变量, 0);
    如果 (忽略推 == 0) { }
    // 容器类推断（= 构造调用形态）：嵌套块同名容器遮蔽拒（与显式声明同款——
    //   v2 局部槽同名合槽，遮蔽会泄漏/双释，P7c 前不支持）
    字符串 推断文本 = 字符串复制(驻留文本(推断ID));
    如果 (是容器类(推断文本) && 符号表.大小() >= 3) {
        整64 层 = 符号表.大小() - 2;
        当 (层 >= 2) {
            结果<符号, 整32> 外层查 = 符号表.元素引用(层).获取(整64(n.文本));
            如果 (外层查.正常) {
                表诊断(诊断, "[错误] 嵌套块同名容器变量遮蔽暂不支持（P7c 前置）: " +
                              驻留文本(整64(n.文本)));
                中断;
            }
            否则 {
            }
            层--;
        }
    }
    // 尾段：成员偏移标注+初值区间检查（与显式类型路径尾段同款）
    结果<空类型, 整32> 标推 = 标注成员偏移(池, n.子起点, n.子终点, 符号表, 诊断);
    如果 (!标推.正常) {
        // 648/B1（#1360 结果化）：原空分支静默零消费——登记显形
        登记内部未登记("成员偏移标注区间非法（内部不变量违例）",
                       字符串复制(驻留文本(整64(n.文本))), 整64(取当前诊断行()));
    }
    整64 i推 = 整64(n.子起点);
    当 (i推 < 整64(n.子终点)) {
        可选<整64> 忽略推2 = 检查表达式(池, 整32(i推), 符号表, 诊断);
        i推++;
    }
    返回 真;
}

不安全 函数 检查变量声明语句(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    节点 n = 池.元素(节点索引);
    // plans/019 阶段3b（2026-09-10）：声明位转移中置位（拥有资源类型声明位
    //   放行通道——检查调用表达式 分级 2 据此放行）；初始化末=转移(单标识符)
    //   时置位，区间检查后复位。推断声明（变量 u = 转移(v)）路径同受益。
    // 184-a：本函数 180 行按「识别管线」提取为 2 个族子方法（纯搬运零行为
    //   变更——多重集核验先行于构建）：检测声明位转移 + 检查声明类型节点。
    布尔 本声明位转移 = 检测声明位转移(池, 节点索引);
    // 435：声明位传播登记（初值含 [&] 非空捕获 lambda → 名入传播表·否则出表
    //   遮蔽修正；推断早退前·宿主 noteDeclInit 同构·实现=语义检查逃逸.cn）
    登记声明位lambda逃逸(池, n, 符号表, 诊断, 引用lambda变量们);  // 486：主表
    // 46-c：推断声明形态先拦（类型节点文本=空串哨兵）——显式类型路径不感知
    如果 (检查推断声明语句(池, 节点索引, 符号表, 诊断)) {
        如果 (本声明位转移) { 声明位转移中 = 假; }
        返回;
    }
    整64 类型ID = 整64(n.附加);
    // 426：归一前的原始池下标（归一把 类型ID 改写为基名驻留键·不可再池.元素）
    整64 类型池下标 = 类型ID;
    // 55-c 方案A：声明初始化面混合符号检查的声明类型名ID（守卫块内自类型节点
    //   归一；-1=类型节点缺失的异常形态，跳过检查）
    整64 声明类型名ID = 0 - 1;
    // 184-a：类型节点检查体（55-c 声明类型名ID 归一/检查类型引用/94-a 数组
    //   元素登记/引用局部纪律/A1 字符串借出拒绝/A2 字符* 收紧）提取为
    //   检查声明类型节点（声明类型名ID 为输出参数——混合符号检查用）。
    如果 (类型ID >= 0 && 类型ID < 池.大小()) {
        节点 类型节点值 = 池.元素(整32(类型ID));
        如果 (类型节点值.类型 == 节点_类型) {
            检查声明类型节点(池, n, 类型ID, 符号表, 诊断, 声明类型名ID);
        }
    }
    // 031（#1075）：放置骨架——全局变量位方法值类型拒绝（R3 语法面·宿主
    //   checkPlacement 同构·文案逐字）；局部变量/形参前缀形态=合法持有位
    //   放行。符号表层数：<=1=顶层（全局）；>=2=函数/块内（局部）。
    如果 (符号表.大小() <= 1 && 声明类型名ID >= 0 &&
        是方法值类型文本(字符串复制(驻留文本(声明类型名ID)))) {
        表诊断(诊断, "[错误] " + 方法值放置文案1075("全局变量"));
    }
    // 1028（#045 切片1·规则3·060 同口径）：结果 变量遮蔽声明 kill 检查标记
    //   ——外层同名 结果 已查标记对内层新变量必然失效（宿主 visitVarDecl
    //   errorCheckState_.erase 同构·Rust 遮蔽语义；声明类型名ID=归一后基名）
    如果 (声明类型名ID > 0 && 是结果类型_ID(声明类型名ID)) {
        清除结果已查(整64(n.文本));
    }
    // 329-a（D38 批2·109）：类类型变量裸声明无默认构造拒绝（宿主 H7 对齐·
    //   仅带参构造类须显式 类名(实参) 构造）。判定=构造个数>0 且无零参构造
    //   （重载感知统计表·w07 双构造放行/t30 单带参拒；结构体与无构造类个数=0
    //   不适用）。判定键=声明类型名ID（55-c 输出参：附加==0 的基类型名ID；
    //   -1=指针/引用/缺失自动排除）。顶层静态类实例不经本路径=诚实边界。
    如果 (声明类型名ID >= 0 && n.子起点 >= n.子终点) {
        如果 (查类构造个数(声明类型名ID) > 0 && !类有零参构造(声明类型名ID)) {
            表诊断(诊断, "[错误] 类类型变量 '" + 驻留文本(整64(n.文本)) +
                          "' 无默认构造（类 '" + 字符串复制(驻留文本(声明类型名ID)) +
                          "' 仅声明带参构造），裸声明须可默认构造");
        }
        // 193（2026-10-13 任务193）：抽象类/接口类型变量裸声明=值形态直接实例化，
        //   语义层拒绝（宿主 visitVarDecl 193 检查同构·specs/06 §八「含抽象成员
        //   的类不可直接实例化」+接口同族·C++ cannot instantiate abstract class
        //   同款）。判定键=声明类型名ID（指针/引用/缺失 -1 自动排除=值形态守卫
        //   与 329-a 同源）；有初始化器形态=接口合法赋值面（413 检查）不经此。
        //   诊断后继续登记链（单诊断口径·与 324 宿主先例对齐）。
        // 593（2026-10-14 任务593）：「元素数组」裸声明=数组值形态逐元素默认
        //   构造实例化，同点拒绝（宿主 visitVarDecl 593 同构·193 数组形态漏网
        //   根治）。同一裸声明守卫（无初始化器=子区间空）挂 helper 剥数组后缀
        //   判元素；非数组形态 helper 恒 假 直通零成本。
        如果 (报抽象数组声明诊断593(字符串复制(驻留文本(声明类型名ID)), 诊断)) { }
        // 728j（2026-10-14）：诊断补未实现方法名清单（多层继承指路·宿主
        //   semantic_decl.cpp 同文案逐字一致）。
        如果 (是抽象类ID(声明类型名ID)) {
            表诊断(诊断, "[错误] 不能实例化抽象类 '" + 字符串复制(驻留文本(声明类型名ID)) +
                          "'（未实现抽象方法：" + 未实现抽象顿号串(声明类型名ID) +
                          "）——请实例化具体派生类");
        }
        如果 (是接口名ID(声明类型名ID)) {
            表诊断(诊断, "[错误] 不能实例化接口 '" + 字符串复制(驻留文本(声明类型名ID)) +
                          "'（接口无实现体）——请以实现类实例初始化接口变量");
        }
    }
    // 413（2026-10-11）：接口类型变量初始化「类→接口」隐式转换检查（宿主
    //   visitVarDecl canConvertType 接口段同构）——声明类型=接口 且 初值可
    //   静默推导为用户类 → 须 类实现接口沿链；否则诊断（文本与宿主对齐——
    //   101 负例诊断锚）。检不出（-1 可靠面外）=诚实边界放行。
    如果 (声明类型名ID > 0 && n.子终点 > n.子起点 && 是接口名ID(声明类型名ID)) {
        可选<整64> 右ID413查 = 推导源类型ID静默(池, 整32(n.子终点 - 1), 符号表);
        整64 右ID413 = 0 - 1;
        如果 (右ID413查.有值) { 右ID413 = 右ID413查.值; }
        如果 (右ID413 > 0 && 是用户类_ID(右ID413) &&
             !类实现接口沿链(右ID413, 声明类型名ID)) {
            表诊断(诊断, "[错误] 无法将 '" + 驻留文本(右ID413) +
                          "' 隐式转换为 '" + 驻留文本(声明类型名ID) + "'");
        }
    }
    // 843（2026-10-15·零分叉）：数组类型声明 × 非数组初值表达式——宿主
    //   visitVarDecl 隐式转换（canConvertType 数组段）拒「无法将 '整32'
    //   隐式转换为 '整32[3]'」，v2 原无此类型检查=放行产码（探针 S5 实锤）。
    //   边界（宿主同构实测锚）：初值根=数组初始化列表（{...}·94-a 节点 45）
    //   或数组类型表达式（同型数组变量——符号表登记保留「整32[3]」全文本
    //   943 面·S6 双绿；函数调用返回数组·597 造窄() 实录）放行。
    //   ★源类型判据限定「可靠形态」（843 预验 597 误伤根治）：字面量族（类型
    //   恒定）+标识符（符号表登记文本直查）；其余形态（调用/成员/二元等·
    //   表达式类型ID 推导存在数组返回面局限：597 造窄() 返回整32[2] 误推
    //   整64 实录）=诚实边界放行（宿主对调用返回数组放行·597 rc=0 锚）。
    如果 (n.子终点 > n.子起点 && 类型ID > 0) {
        字符串 类型文本843v = 字符串复制(驻留文本(类型ID));
        如果 (是数组类型文本(类型文本843v)) {
            节点 初根843v = 池.元素(整32(整64(n.子终点) - 1));
            如果 (初根843v.类型 != 节点_数组初始化) {
                字符串 源文本843v = "";
                如果 (初根843v.类型 == 节点_整数字面量) { 源文本843v = "整32"; }
                否则 如果 (初根843v.类型 == 节点_浮点字面量) { 源文本843v = "浮64"; }
                否则 如果 (初根843v.类型 == 节点_字符串字面量) { 源文本843v = "字符串"; }
                否则 如果 (初根843v.类型 == 节点_布尔字面量) { 源文本843v = "布尔"; }
                否则 如果 (初根843v.类型 == 节点_字符字面量) { 源文本843v = "字符"; }
                否则 如果 (初根843v.类型 == 节点_标识符) {
                    整64 源类型843v = 0;
                    可选<整64> 源类型843v查 = 表查找类型ID(符号表, 整64(初根843v.文本));
                    // miss 保持 0（下方 >0 判定与原 -1 哨兵同假·880 批5）
