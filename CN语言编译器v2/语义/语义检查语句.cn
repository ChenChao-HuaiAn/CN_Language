// CN 自举编译器 v2 · 语义检查（千行拆分子模块，2026-09-08 用户裁决阶段目录包）
// 职责：逐节点语义检查（成员偏移标注/检查表达式/检查语句/检查块/检查如果/
//   检查当/检查函数）——自 语义分析.cn 机械搬移；符号表经参数传递，模块
//   解析表经 公开: 访问函数（语义分析 主干）；模块路径=语义检查（新键基）。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（原 导入 语法分析，目录包名）
导入 IR;         // 容器/结果 合成名判定 + 节点_*/键位移 常量（目录包名）
导入 借出检查;    // 第七十七轮 A21：借出视图生命周期检查（函数级调用）

公开:   // 全文件公开（检查族+主流程供 包/主.cn 消费）
// D1 行数整改 122-a：自 语义检查.cn 按族拆出——语句类检查（检查推断声明语句 + 检查变量声明语句 + 检查赋值语句 + 检查复合赋值操作数 + 登记跳过区间；纯重构零行为变更；本族不直接访问文件级静态）

// 变量声明语句检查（R3 拆分，2026-09-08 自 检查语句 机械搬移）：类型引用诊断 +
//   指针/引用局部纪律 + 嵌套块同名容器遮蔽拒 + 结果/容器字面量初始化拒 +
//   成员偏移标注 + 初始化区间表达式检查。
// 推断声明检查（46-c，2026-09-10 第四十九轮）：类型节点文本=空串哨兵——
//   推断类型经 表达式类型ID 推导（字面量/标识符/调用/下标/三元/成员/二元）。
//   成功：登记推断声明类型表（IR 层生成变量声明 查表回填布局分派——主.cn
//   层间池按值传递，语义层回填对 IR 层不可见，跨层静态表与 变量结构体表
//   同模式）+符号表按推断类型登记（后续引用检查正常）+容器类同款嵌套块
//   遮蔽拒。失败：可见诊断+整64 兜底登记（err>0 语义错误即中止，兜底类型
//   无产物级静默风险）。返回 真=推断形态已处理；假=非推断（走显式类型路径）。
函数 检查推断声明语句(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 布尔 {
    节点 n = 池.元素(节点索引);
    整64 预类型ID = 整64(n.附加);
    布尔 是推断 = 假;
    如果 (预类型ID >= 0 && 预类型ID < 池.大小()) {
        节点 预类型节点 = 池.元素(整32(预类型ID));
        如果 (预类型节点.类型 == 节点_类型 && 整64(预类型节点.文本) == 整64(驻留(""))) {
            是推断 = 真;
        }
    }
    如果 (!是推断) { 返回 假; }
    如果 (n.子起点 >= n.子终点) {
        表诊断(诊断, "[错误] 推断声明必须初始化（变量 名 = 表达式）: " +
                      驻留文本(整64(n.文本)));
        返回 真;
    }
    整64 推断ID = 表达式类型ID(池, 整32(n.子终点 - 1), 符号表, 诊断);
    如果 (推断ID <= 0) {
        表诊断(诊断, "[错误] 推断声明初值类型未知（可推导面：字面量/标识符/调用/下标/三元/成员/二元）: " + 驻留文本(整64(n.文本)));
        推断ID = 驻留("整64");
    }
    登记推断声明类型(整64(n.文本), 推断ID);
    整64 忽略推 = 表注册(符号表, 整64(n.文本), 推断ID, 符号_变量, 0);
    如果 (忽略推 == 0) { }
    // 容器类推断（= 构造调用形态）：嵌套块同名容器遮蔽拒（与显式声明同款——
    //   v2 局部槽同名合槽，遮蔽会泄漏/双释，P7c 前不支持）
    字符串 推断文本 = 字符串复制(驻留文本(推断ID));
    如果 (是容器类(推断文本) && 符号表.大小() >= 3) {
        整64 层 = 符号表.大小() - 2;
        当 (层 >= 2) {
            映射<整64, 符号> 外层 = 符号表.元素(层);
            结果<符号, 整32> 外层查 = 外层.获取(整64(n.文本));
            如果 (外层查.正常) {
                表诊断(诊断, "[错误] 嵌套块同名容器变量遮蔽暂不支持（P7c 前置）: " +
                              驻留文本(整64(n.文本)));
                中断;
            }
            层--;
        }
    }
    // 尾段：成员偏移标注+初值区间检查（与显式类型路径尾段同款）
    整64 标推 = 标注成员偏移(池, n.子起点, n.子终点, 符号表, 诊断);
    如果 (标推 == -1) { }
    整64 i推 = 整64(n.子起点);
    当 (i推 < 整64(n.子终点)) {
        整64 忽略推2 = 检查表达式(池, 整32(i推), 符号表, 诊断);
        如果 (忽略推2 == -1) { }
        i推++;
    }
    返回 真;
}

不安全 函数 检查变量声明语句(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 空类型 {
    节点 n = 池.元素(节点索引);
    // plans/019 阶段3b（2026-09-10）：声明位转移中置位（拥有资源类型声明位
    //   放行通道——检查调用表达式 分级 2 据此放行）；初始化末=转移(单标识符)
    //   时置位，区间检查后复位。推断声明（变量 u = 转移(v)）路径同受益。
    布尔 本声明位转移 = 假;
    如果 (n.子终点 > n.子起点) {
        节点 声明位末 = 池.元素(n.子终点 - 1);
        如果 (声明位末.类型 == 节点_调用 && 声明位末.附加 == 1 &&
             声明位末.子起点 >= 0) {
            节点 声明位被调 = 池.元素(整32(声明位末.子起点));
            节点 声明位实参 = 池.元素(整32(声明位末.子起点) + 1);
            如果 (声明位被调.类型 == 节点_标识符 && 声明位实参.类型 == 节点_标识符 &&
                 字符串比较(驻留文本(整64(声明位被调.文本)), "转移")) {
                声明位转移中 = 真;
                本声明位转移 = 真;
            }
        }
    }
    // 46-c：推断声明形态先拦（类型节点文本=空串哨兵）——显式类型路径不感知
    如果 (检查推断声明语句(池, 节点索引, 符号表, 诊断)) {
        如果 (本声明位转移) { 声明位转移中 = 假; }
        返回;
    }
    // ③ 第二波（方案A）：符号 类型ID 统一为类型名ID——原存类型节点索引，与
    //   顶层静态/常量/函数的名ID 约定不一致（消费端无从分辨，下标对象白名单
    //   判定须按名ID 比较）；顺带根治块级遮蔽检查 驻留文本(节点索引) 取错文本
    整64 类型ID = 整64(n.附加);
    // 55-c 方案A：声明初始化面混合符号检查的声明类型名ID（守卫块内自类型节点
    //   归一；-1=类型节点缺失的异常形态，跳过检查）
    整64 声明类型名ID = 0 - 1;
    // 守卫用 >=0：池索引 0 是合法类型节点位（>0 会漏归一首个声明——实测
    //   变体 a 裸块容器因此按节点索引 0 查 驻留文本 取垃圾文本）
    如果 (类型ID >= 0 && 类型ID < 池.大小()) {
        节点 类型节点值 = 池.元素(整32(类型ID));
        如果 (类型节点值.类型 == 节点_类型) {
            类型ID = 整64(类型节点值.文本);
            // 55-c：仅非指针/引用声明参与（附加>=1=指针层、>=256=引用——文本
            //   为基类型名，指针声明（正8* q）按基名误入整数族会误报取地址右值）
            如果 (类型节点值.附加 == 0) { 声明类型名ID = 类型ID; }
            // plans/018 类型分桶：变量类型存在性/公开性/歧义诊断（fail fast）
            检查类型引用(符号表, 诊断, 类型ID);
            // ③ 第三波：指针局部登记（同参数约定：附加=指针层数 1..255）
            如果 (类型节点值.附加 >= 1 && 类型节点值.附加 < 256) {
                登记语义指针变量(整64(n.文本), 类型ID);
            }
            // 94-a（2026-09-13 第九十四轮）：数组声明——登记**元素类型**到语义
            //   指针变量表（数组名退化为元素指针；下标检查 p[i] 路径/左值写/
            //   作实参全链复用——IR 层 生成数组局部 同款登记）。元素类型白名单
            //   经 指针下标所指合法 既有判定（标量/字符串/结构体）。
            字符串 声明文本94 = 字符串复制(驻留文本(类型ID));
            如果 (是数组类型文本(声明文本94)) {
                字符串 元素94 = 数组元素文本(声明文本94);
                如果 (字符串长度(元素94) > 0) {
                    登记语义指针变量(整64(n.文本), 驻留(元素94));
                }
            }
            // 引用局部纪律（2026-09-04，IR生成.cn 冒烟 96 错根治配套）：
            //   C++ 同款——必须初始化 + 初始化须为可绑定左值形态（标识符/
            //   成员/解引用/下标（指针下标 p[i]——IR 生成左值地址 已支持）/
            //   引用返回调用（取值(p)——宿主 P3-18 白名单对齐）——绑定右值=
            //   普通调用结果/二元运算/字面量拒绝，防空引用与静默错误代码。
            如果 (类型节点值.附加 == 256) {
                如果 (n.子起点 >= n.子终点) {
                    表诊断(诊断, "[错误] 引用声明必须初始化（绑定既有对象）: " +
                                  驻留文本(整64(n.文本)));
                } 否则 {
                    节点 初始化末y = 池.元素(n.子终点 - 1);
                    布尔 初始化是引用调用 = 假;
                    如果 (初始化末y.类型 == 节点_调用) {
                        初始化是引用调用 = 是引用返回调用(池, n.子终点 - 1, 符号表);
                    }
                    如果 (初始化末y.类型 != 节点_标识符 && 初始化末y.类型 != 节点_成员 &&
                         初始化末y.类型 != 节点_解引用 && 初始化末y.类型 != 节点_下标 &&
                         !初始化是引用调用) {
                        表诊断(诊断, "[错误] 引用初始化必须是可绑定左值（变量/成员/下标/解引用/引用返回调用）: " +
                                      驻留文本(整64(n.文本)));
                    }
                }
            }
            // plans/019 阶段4' A1（2026-09-11 方案A 用户批准）：字符串借出初始化
            //   拒绝——下标/成员/解引用初值=借用视图（数组元素/字段/指向），隐式
            //   装入拥有变量=释放挂点对他人指针行使所有权（宿主实测 UAF：s=名单[0]
            //   后重新赋值→free 旧堆串→数组元素悬垂读取乱码）。拥有化须显式
            //   字符串复制(...)；字符* 借用视图随第三批 A2。推断声明（472 提前
            //   返回）不在此拦——与宿主同边界，随 A2 一并收口。
            如果 (类型ID == 驻留("字符串") && 类型节点值.附加 == 0 &&
                 n.子起点 < n.子终点) {
                节点 借出末A1 = 池.元素(n.子终点 - 1);
                如果 (借出末A1.类型 == 节点_下标 || 借出末A1.类型 == 节点_成员 ||
                     借出末A1.类型 == 节点_解引用) {
                    表诊断(诊断, "[错误] 字符串变量 '" + 驻留文本(整64(n.文本)) +
                                  "' 不能以下标/成员/解引用借出隐式初始化——须 字符串复制(...) 显式落堆拥有化（字符* 借用视图随 plans/019 第三批）");
                }
                // A2（2026-09-11 方案甲）：字符* 借用视图装入拥有变量收紧——
                //   调用初值返回 字符*（如 驻留文本/借用返回函数）拒绝，
                //   须显式 字符串复制（借用→拥有显式；拥有→借用自动）。
                如果 (借出末A1.类型 == 节点_调用 && 借出末A1.子起点 >= 0) {
                    节点 被调A2d = 池.元素(整32(借出末A1.子起点));
                    如果 (被调A2d.类型 == 节点_标识符 &&
                         查函数返回类型(整64(被调A2d.文本)) == 驻留("字符*")) {
                        表诊断(诊断, "[错误] 字符串变量 '" + 驻留文本(整64(n.文本)) +
                                      "' 不能以字符* 借用视图隐式初始化——须 字符串复制(...) 显式落堆拥有化（借用→拥有显式；拥有→借用自动）");
                    }
                }
            }
        }
    }
    // 块级作用域析构防护（用户裁决项2 配套）：嵌套块同名容器变量遮蔽——
    //   v2 局部槽同名合槽（预扫），遮蔽会泄漏/双释，P7c 完整块上下文前不支持
    如果 (符号表.大小() >= 3) {  // 全局+函数 之外还有块层（嵌套块内）
        字符串 声明类型文本 = 字符串复制(驻留文本(类型ID));
        如果 (是容器类(声明类型文本)) {
            整64 层 = 符号表.大小() - 2;   // 跳过当前块层，从外层块向上查
            当 (层 >= 2) {
                映射<整64, 符号> 外层 = 符号表.元素(层);
                结果<符号, 整32> 外层查 = 外层.获取(整64(n.文本));
                如果 (外层查.正常) {
                    表诊断(诊断, "[错误] 嵌套块同名容器变量遮蔽暂不支持（P7c 前置）: " +
                                  驻留文本(整64(n.文本)));
                    中断;
                }
                层--;
            }
        }
    }
    整64 忽略 = 表注册(符号表, 整64(n.文本), 类型ID, 符号_变量, 0);
    如果 (忽略 == 0) { }
    // 簇⑤根治（2026-09-04，E2E 144 探针矩阵揪出·132 半实现纪律）：结果/容器
    //   类型声明的**字面量**初始化（= 无 / = "串" / = 123——探针 P2 运行期
    //   SIGSEGV：IR 按结构体拷贝瞎发射、字面量槽越界读+垃圾解引用；宿主同款
    //   源码显式拒绝）显式拒绝。诚实边界：非调用非字面量形态（容器标识符
    //   拷贝 = 导入模块们 / 内置直调 = 打开文件(...))仍放行——拷贝的 IR 支持
    //   由 IR 层 [ir2] 诊断可见化（P7c）、直调契约错位属 B1a 裁决边界
    //   （plans/014 灰色点，stdlib 并入专项收口），运行期错位不新增静默面。
    字符串 声明文本5 = 字符串复制(驻留文本(类型ID));
    如果 ((是结果类型(声明文本5) || 是容器类(声明文本5)) &&
         n.子起点 > 0 && n.子终点 > n.子起点) {
        节点 初始化末 = 池.元素(n.子终点 - 1);
        // 107-a（H6 同族）：可选类型局部 = 无（语法层把「无」解析为 节点_整数字面量
        //   值 0）为合法空值初始化（宿主支持实证；IR 层零初始化）——结果类型/容器
        //   不放行（宿主同拒；结果用 错误() 构造）。无歧义实证：宿主对
        //   `可选<整64> r = 0;` 报「无法隐式转换」→ 合法源码该位字面量只可能是「无」。
        布尔 可选无H6 = 字符串比较(合成名基名(声明文本5), "可选") &&
                        初始化末.类型 == 节点_整数字面量;
        如果 (!可选无H6 &&
            (初始化末.类型 == 节点_整数字面量 || 初始化末.类型 == 节点_浮点字面量 ||
             初始化末.类型 == 节点_字符串字面量 || 初始化末.类型 == 节点_布尔字面量)) {
            表诊断(诊断, "[错误] 结果/容器类型不支持字面量初始化（须为构造/方法/"
                          + "函数调用或同类型拷贝）: " + 驻留文本(整64(n.文本)));
        }
    }
    // P6c：成员偏移标注
    整64 标1 = 标注成员偏移(池, n.子起点, n.子终点, 符号表, 诊断);
    如果 (标1 == -1) { }
    // 55-c 方案A（2026-09-10 第五十六轮 用户裁决）：声明初始化面混合符号拒绝——
    //   声明类型与初值表达式类型「变量间」跨符号拒绝；字面量豁免（含 -1 形态，
    //   `正64 大 = 9223372036854775808` 等初始化惯用形态保留——检查混合符号赋值，
    //   语义检查表达式 模块；右类型推导 -1 跳过=检不出诚实边界同二元面）
    如果 (声明类型名ID >= 0 && n.子终点 > n.子起点) {
        检查混合符号赋值(池, 声明类型名ID, n.子终点 - 1, 符号表, 诊断);
    }
    // 71-a：声明位装箱语境——声明类型为 结果/可选 且有初始化时设置（构造器
    //   正常/错误/某些 的类型推导依据；初始化区间检查后复位）
    布尔 声明位语境71 = 假;
    如果 (n.子起点 < n.子终点 && 类型ID >= 0 &&
         是结果类型(字符串复制(驻留文本(类型ID)))) {
        装箱语境类型ID = 类型ID;
        声明位语境71 = 真;
    }
    整64 i = 整64(n.子起点);
    当 (i < 整64(n.子终点)) {
        整64 忽略2 = 检查表达式(池, 整32(i), 符号表, 诊断);
        如果 (忽略2 == -1) { }
        i++;
    }
    如果 (声明位语境71) { 装箱语境类型ID = 0; }   // 71-a：语境复位
    如果 (本声明位转移) { 声明位转移中 = 假; }   // plans/019 阶段3b：标志复位
    返回;
}

// 赋值语句检查（R3 拆分）：左值声明/常量拒 + 下标左值白名单 + 可写左值形态 +
//   复合赋值数值操作数（经 检查复合赋值操作数）+ 成员偏移标注 + 表达式检查。
函数 检查赋值语句(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 空类型 {
    节点 n = 池.元素(节点索引);
    // 左值（标识符）须已声明；右值表达式检查；解引用左值（文本=0）跳过左名检查
    如果 (n.文本 != 0) {
        整64 左类型 = 表查找类型ID(符号表, 整64(n.文本));
        如果 (左类型 == -1) {
            表诊断(诊断, "[错误] 赋值目标未声明: " + 驻留文本(整64(n.文本)));
        }
        // 缺陷②（2026-09-03 用户裁决立案）：常量初始化后不可修改（[03] 规范
        //   语义；宿主 isConstVarName 对齐）——顶层常量经 声明收集 登记为
        //   符号_常量，内层同名变量遮蔽时 表查找种类 命中内层=放行
        如果 (表查找种类(符号表, 整64(n.文本)) == 符号_常量) {
            表诊断(诊断, "[错误] 不能给常量赋值（常量初始化后不可修改）: " +
                          驻留文本(整64(n.文本)));
        }
        // plans/019 阶段1（2026-09-10）：已转移变量不可作赋值目标（赋值=使用）
        如果 (表查已转移(符号表, 整64(n.文本)) > 0) {
            表诊断(诊断, "[错误] 变量已转移，不能继续使用（显式转移后源变量禁用）: " +
                          驻留文本(整64(n.文本)));
        }
        // plans/019 阶段3（2026-09-10）：常量引用参数是只读借用——不可作赋值
        //   目标（宿主 currentConstRefParams_ 对齐；传可变/互斥面 v2 随实参
        //   边界记录另轮=诚实边界）
        如果 (是常量引用参数(整64(n.文本))) {
            表诊断(诊断, "[错误] 常量引用参数是只读借用，不能赋值: " +
                          驻留文本(整64(n.文本)));
        }
        // 155-a（B10 v2 挂点）：**可变静态变量写**（顶层静态赋值——与宿主 B10
        //   「静态变量写」同族；读安全=plans/023 §四 B10 的 CN 裁剪）。
        如果 (是全局静态名(整64(n.文本))) {
            警告不安全边界(诊断, "静态变量写", "静态变量赋值");
        }
        // plans/019 阶段4' A2（2026-09-11 方案甲）：赋值位字符* 借用收紧——
        //   字符串（拥有）变量赋值 字符* 调用返回（驻留文本/借用返回函数）
        //   须显式 字符串复制（与初始化位同款；借用→拥有显式）。
        如果 (左类型 == 驻留("字符串") && n.子终点 > n.子起点) {
            节点 赋值右末A2 = 池.元素(n.子终点 - 1);
            如果 (赋值右末A2.类型 == 节点_调用 && 赋值右末A2.子起点 >= 0) {
                节点 被调赋A2 = 池.元素(整32(赋值右末A2.子起点));
                如果 (被调赋A2.类型 == 节点_标识符 &&
                     查函数返回类型(整64(被调赋A2.文本)) == 驻留("字符*")) {
                    表诊断(诊断, "[错误] 字符串（拥有）变量不能以字符* 借用视图隐式赋值——须 字符串复制(...) 显式落堆拥有化（借用→拥有显式；拥有→借用自动）");
                }
            }
        }
    }
    如果 (n.文本 == 0 && n.子起点 > 0) {
        // ③ 第二波：下标左值赋值（s[0] = x / s[0] += x）显式拒绝——字符串下标
        //   只读（宿主 A-1 语义）；IR 左值地址生成无下标分支，错误放行=静默
        //   错误代码（写错地址）。半实现纪律：未覆盖形态显式拒绝。
        // ③ 第三波：指针对象下标左值放行（位置[0] = 位置[0] + 1 出参写回、
        //   p[i] = v 写透形态——宿主 ir_expr.cpp:981~1003 对齐：地址计算+
        //   StorePtr，目标类型=所指元素类型）。
        节点 左值末 = 池.元素(n.子起点 - 1);
        如果 (左值末.类型 == 节点_下标) {
            布尔 是指针下标左值 = 假;
            如果 (左值末.子起点 > 0) {
                节点 下标对象左 = 池.元素(整32(左值末.子起点));
                如果 (下标对象左.类型 == 节点_标识符) {
                    整64 查左指针 = 查语义指针变量(整64(下标对象左.文本));
                    如果 (查左指针 >= 0) {
                        是指针下标左值 = 真;
                        // 155-a（A2 v2 挂点）：**裸指针下标写**（p[i] = x 经裸指针
                        //   偏移写=可越界；与宿主 A2「指针下标写」同族——读面由
                        //   B8 在 检查下标表达式 单报，此处写面无重复）
                        警告不安全边界(诊断, "指针下标写", "指针下标写（p[i] = ...）");
                    }
                } 否则 如果 (下标对象左.类型 == 节点_成员) {
                    // 97-a（2026-09-13 第九十七轮 C8）：结构体**字段数组**元素下标
                    //   左值（r.分数[0] = v；嵌套链 t.两行[1].分数[2] = v）——字段
                    //   类型可判定且**非数组**时拒绝（字符串字段下标仍只读=既有语义）；
                    //   不可判定（嵌套成员链 推导成员类型ID 面外）放行交 IR 层判定
                    //   （IR 推导下标元素类型ID=0 即「下标左值对象未支持」可见失败——
                    //   半实现纪律：不放行静默，只是判定点后移）
                    布尔 可写97 = 真;
                    向量<字符串> 静默诊断97 = 向量<字符串>();
                    整64 字段类型左97 = 推导成员类型ID(池, 整32(左值末.子起点),
                                                        符号表, 静默诊断97);
                    如果 (字段类型左97 > 0) {
                        字符串 字段文本左97 = 字符串复制(驻留文本(字段类型左97));
                        如果 (!是数组类型文本(字段文本左97)) { 可写97 = 假; }
                    }
                    如果 (可写97) { 是指针下标左值 = 真; }
                }
            }
            如果 (!是指针下标左值) {
                表诊断(诊断, "[错误] 下标左值赋值未支持（字符串下标只读）");
            }
        }
        // 缺陷②（2026-09-03 用户裁决立案）：可写左值白名单——非下标形态须为
        //   标识符（复合赋值合成形态 名+=值）/成员/解引用 之一；其余（二元
        //   运算结果/字面量/负号/逻辑非/取地址/调用/嵌套赋值…）硬错误
        //   （Rust E0070 同款）。语法分析.cn 解析语句 兜底分支「任意表达式+`=`」
        //   都造赋值节点=本检查主战场——原检查缺失时 a+1=7 / 5=a 静默放行，
        //   IR 按左值地址生成存储=写垃圾地址（半实现纪律：未覆盖形态不放行）
        如果 (左值末.类型 != 节点_下标) {
            如果 (左值末.类型 == 节点_标识符) {
                // 复合赋值标识符形态：常量同拒（与 文本!=0 简单赋值分支同款）
                如果 (表查找种类(符号表, 整64(左值末.文本)) == 符号_常量) {
                    表诊断(诊断, "[错误] 不能给常量赋值（常量初始化后不可修改）: " +
                                  驻留文本(整64(左值末.文本)));
                }
            } 否则 如果 (左值末.类型 == 节点_调用) {
                // 2026-09-04 缺陷零容忍收口：引用返回调用作赋值目标（宿主
                //   P3-18 对齐：取值(p) = 42 / += 8——调用结果=被引用左值
                //   地址）；非引用返回调用仍硬拒（普通调用返回右值）
                如果 (!是引用返回调用(池, 整32(n.子起点 - 1), 符号表)) {
                    表诊断(诊断, "[错误] 赋值目标必须是可写左值（变量/成员/下标/解引用/引用返回调用）");
                }
            } 否则 如果 (左值末.类型 != 节点_成员 && 左值末.类型 != 节点_解引用) {
                表诊断(诊断, "[错误] 赋值目标必须是可写左值（变量/成员/下标/解引用）");
            }
        }
            检查复合赋值操作数(池, n, 左值末, 符号表, 诊断);
    }
    // P6c：成员偏移标注（解引用左值：区间 [附加, 子终点) 含左值表达式）
    整64 标注起点 = n.文本 != 0 ? n.子起点 : 整32(n.附加);
    整64 标2 = 标注成员偏移(池, 整32(标注起点), n.子终点, 符号表, 诊断);
    如果 (标2 == -1) { }
    // 55-c 方案A（2026-09-10 第五十六轮 用户裁决）：赋值面混合符号拒绝——
    //   左值类型三形态：简单赋值（文本=左名ID→表查找类型ID）/复合合成标识符
    //   （左值末.文本→表查找类型ID）/成员左值（推导成员类型ID）；解引用/下标/
    //   引用返回调用左值类型推导复杂=检不出诚实边界（宿主已全形态覆盖）。
    //   右末端=区间末（合成形态 L op R 的根=二元节点在区间末）。字面量豁免
    //   （检查混合符号赋值，语义检查表达式 模块）
    整64 左类型名ID = 0 - 1;
    如果 (n.文本 != 0) {
        左类型名ID = 表查找类型ID(符号表, 整64(n.文本));
    } 否则 如果 (n.子起点 > 0) {
        节点 左值末f = 池.元素(n.子起点 - 1);
        如果 (左值末f.类型 == 节点_标识符) {
            左类型名ID = 表查找类型ID(符号表, 整64(左值末f.文本));
        } 否则 如果 (左值末f.类型 == 节点_成员) {
            向量<字符串> 静默诊断f = 向量<字符串>();
            左类型名ID = 推导成员类型ID(池, n.子起点 - 1, 符号表, 静默诊断f);
        }
    }
    如果 (左类型名ID >= 0 && n.子终点 > n.子起点) {
        检查混合符号赋值(池, 左类型名ID, n.子终点 - 1, 符号表, 诊断);
    }
    // plans/019 阶段2（2026-09-10）：局部地址逃逸——右值=取地址(局部标识符)
    //   且左值为非局部（全局/静态层）标识符时拒绝（悬垂防线前移；宿主
    //   visitAssignmentExpr 同构。成员/下标目标位与引用局部/指针指向跟踪
    //   v2 随引用面扩大对齐=诚实边界——树内预审零命中）
    如果 (n.子终点 > n.子起点 && n.文本 != 0) {
        节点 逃逸右值末 = 池.元素(n.子终点 - 1);
        如果 (逃逸右值末.类型 == 节点_取地址 && 逃逸右值末.子起点 >= 0) {
            节点 逃逸操作数 = 池.元素(整32(逃逸右值末.子起点));
            如果 (逃逸操作数.类型 == 节点_标识符 &&
                 是局部名(符号表, 整64(逃逸操作数.文本)) &&
                 !是局部名(符号表, 整64(n.文本)) &&
                 表查找类型ID(符号表, 整64(n.文本)) != -1) {
                表诊断(诊断, "[错误] 不能将局部变量的地址存入静态/全局存储（比其寿命长，将成悬垂）: " +
                              驻留文本(整64(逃逸操作数.文本)));
            }
        }
    }
    整64 i = 整64(标注起点);
    当 (i < 整64(n.子终点)) {
        整64 忽略2 = 检查表达式(池, 整32(i), 符号表, 诊断);
        如果 (忽略2 == -1) { }
        i++;
    }
    返回;
}

    // ③ 第二波（用户裁决 2026-09-03）：复合赋值非数值操作数显式拒绝——
    //   宿主判定对齐（实测：字符串/布尔/字符 += 均报「复合赋值要求数值
    //   操作数」，整系/浮点系通过；显式 名 = 名 + "乙" 拼接赋值合法不受
    //   影响——合成二元节点 子终点=1 标记区分，读右值末节点）。左值类型
    //   白名单=数值。
函数 检查复合赋值操作数(向量<节点> 池, 节点 n, 节点 左值末, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 空类型 {
    如果 (n.附加 <= 0) { 返回; }
    节点 右值末c = 池.元素(n.子终点 - 1);
    如果 (右值末c.类型 == 节点_二元运算 && 右值末c.子终点 == 1) {
        // 左值类型取左值区间**末**节点：变量=标识符；成员链（名片.计数）
        //   =成员节点（取首节点会把对象结构体当操作数类型误拒）
        整64 左值类型IDc = -1;
        如果 (左值末.类型 == 节点_标识符) {
            左值类型IDc = 表查找类型ID(符号表, 整64(左值末.文本));
        } 否则 如果 (左值末.类型 == 节点_下标 && 左值末.子起点 > 0) {
            // ③ 第三波：下标左值（p[0] += 1）——操作数类型=所指元素
            //   类型（指针变量表；非指针已上方拒绝，此处防御 -1 放行）
            节点 下标对象c = 池.元素(整32(左值末.子起点));
            如果 (下标对象c.类型 == 节点_标识符) {
                整64 查复指 = 查语义指针变量(整64(下标对象c.文本));
                如果 (查复指 >= 0) { 左值类型IDc = 查复指; }
            }
        } 否则 如果 (左值末.类型 == 节点_成员 && 左值末.子起点 > 0) {
            // 成员左值：字段类型（名片.计数 += 2 —— 计数 整64 合法）
            节点 成员对象c = 池.元素(整32(左值末.子起点));
            如果 (成员对象c.类型 == 节点_标识符) {
                整64 查结构体c = 查变量结构体键(整64(成员对象c.文本));
                如果 (查结构体c >= 0) {
                    如果 (查结构体c != 1) {
                        左值类型IDc = 查字段类型ID(查结构体c, 整64(左值末.文本));
                    }
                }
            }
        }
        如果 (左值类型IDc > 0) {
            字符串 左类型文本c = 字符串复制(驻留文本(左值类型IDc));
            布尔 是数值c = 字符串比较(左类型文本c, "整32") || 字符串比较(左类型文本c, "整64") ||
                           字符串比较(左类型文本c, "整8") || 字符串比较(左类型文本c, "整16") ||
                           字符串比较(左类型文本c, "正8") || 字符串比较(左类型文本c, "正16") ||
                           字符串比较(左类型文本c, "正32") || 字符串比较(左类型文本c, "正64") ||
                           字符串比较(左类型文本c, "浮32") || 字符串比较(左类型文本c, "浮64");
            如果 (!是数值c) {
                表诊断(诊断, "[错误] 复合赋值要求数值操作数: " + 左类型文本c);
            }
        }
    }
}

// 区间登记辅助（③ 第二波根治 检查块 双重处理）：偶数位=起点/奇数位=终点（不含）
函数 登记跳过区间(向量<整64>& 区间们, 整64 起, 整64 终) -> 空类型 {
    结果<空类型, 整32> 加a = 区间们.追加(起);
    如果 (!加a.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加b = 区间们.追加(终);
    如果 (!加b.正常) { 运行时错误(4); }
}
