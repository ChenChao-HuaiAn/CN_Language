            }
        }
    }
    // 475-a（D46 残余收口）：声明初始化位构造名裸名拒绝——`结果<...> r = 正常;`
    //   （p9 探针实锤·宿主拒/v2 曾静默）——474-a 返回语句位同族扩展（语句级
    //   单点·零 callee 混淆：`正常(5)`=节点_调用不入判定）。59 行放行=callee/
    //   裸名共用路径**实测定案维持不动**（24 族 callee 位回归实证）；赋值位/
    //   实参位=诚实边界继续登记（赋值节点左值区间结构·独立轮）。集合={正常,
    //   错误}：「某些」裸名=可选枚举值语义·宿主放行先例（24 族实证）。
    如果 (n.子终点 > n.子起点) {
        节点 初值末475 = 池.元素(n.子终点 - 1);
        如果 (初值末475.类型 == 节点_标识符) {
            字符串 裸名文本475 = 字符串复制(驻留文本(整64(初值末475.文本)));
            如果 (字符串比较(裸名文本475, "正常") || 字符串比较(裸名文本475, "错误")) {
                表诊断(诊断, "[错误] 构造名裸名须带参调用: " + 裸名文本475 +
                            "（ 正常(值) / 错误(码) ）");
            }
        }
    }
    // 71-a：声明位装箱语境——声明类型为 结果/可选 且有初始化时设置（构造器
    //   正常/错误/某些 的类型推导依据；初始化区间检查后复位）
    布尔 声明位语境71 = 假;
    如果 (n.子起点 < n.子终点 && 类型ID >= 0 &&
         是结果类型_ID(类型ID)) {
        // #1591：声明位语境单点（持有型盒目标 / 数组初始化列表=元素类型语境）
        声明位语境71 = 设声明位语境1591(池, n, 类型ID);
    }
    整64 i = 整64(n.子起点);
    当 (i < 整64(n.子终点)) {
        可选<整64> 忽略2 = 检查表达式(池, 整32(i), 符号表, 诊断);
        i++;
    }
    如果 (声明位语境71) { 设装箱语境884(0); }   // 71-a：语境复位
    如果 (本声明位转移) { 声明位转移中 = 假; }   // plans/019 阶段3b：标志复位
    返回;
}
// ==================== 184-a 族子方法（原 检查变量声明语句 78~183 段） ====================

// 族①：声明位转移检测（原 82~94 段）——初始化末=转移(单标识符) 时置位。
//   声明位转移中 为全局放行标志（调用方负责检查后复位）。写全局静态=不安全。
不安全 函数 置声明位转移标志963(布尔 值) -> 空类型 {
    声明位转移中 = 值;
}

不安全 函数 检测声明位转移(向量<节点> 池, 整32 节点索引) -> 布尔 {
    布尔 本声明位转移 = 假;
    节点 n = 池.元素(节点索引);
    如果 (n.子终点 > n.子起点) {
        节点 声明位末 = 池.元素(n.子终点 - 1);
        如果 (声明位末.类型 == 节点_调用 && 声明位末.附加 == 1 &&
             声明位末.子起点 >= 0) {
            节点 声明位被调 = 池.元素(整32(声明位末.子起点));
            节点 声明位实参 = 池.元素(整32(声明位末.子起点) + 1);
            如果 (声明位被调.类型 == 节点_标识符 && 声明位实参.类型 == 节点_标识符 &&
                 字符串比较(驻留文本(整64(声明位被调.文本)), "转移")) {
                声明位转移中 = 真;
                本声明位转移 = 真;
            }
        }
    }
    返回 本声明位转移;
}

// 族②：声明类型节点检查（原 109~183 段；前置守卫 类型节点值.类型==节点_类型
//   由调用方承载）——55-c 声明类型名ID 归一/检查类型引用/94-a 数组元素登记/
//   引用局部纪律/A1 字符串借出拒绝/A2 字符* 收紧。
//   声明类型名ID 为输出参数（55-c：附加==0 的基类型名ID；-1 缺省由调用方初始化）。
不安全 函数 检查声明类型节点(向量<节点> 池, 节点 n, 整64& 类型ID,
                  向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断,
                  整64& 声明类型名ID) -> 空类型 {
    如果 (类型ID >= 0 && 类型ID < 池.大小()) {
        节点 类型节点值 = 池.元素(整32(类型ID));
        如果 (类型节点值.类型 == 节点_类型) {
            类型ID = 整64(类型节点值.文本);
            // 55-c：仅非指针/引用声明参与（附加>=1=指针层、>=256=引用——文本
            //   为基类型名，指针声明（正8* q）按基名误入整数族会误报取地址右值）
            如果 (类型节点值.附加 == 0) { 声明类型名ID = 类型ID; }
            // plans/018 类型分桶：变量类型存在性/公开性/歧义诊断（fail fast）
            检查类型引用(符号表, 诊断, 类型ID);
            // 548（编译期除零·常量传播）：声明初始化位零值登记（整数族基类型·
            //   宿主 visitVarDecl noteZeroAssign 同构）——RHS 形态分级（折叠零值=
            //   种子／标识符=传播边／其余=失格·登记零值右值548 单点分派）。局部
            //   常量声明同位覆盖（P7a 局部常量按整64 变量合成·初值可折叠零即种子，
            //   写被常量拦截恒不失格=安全传播面）。指针/引用声明（附加!=0）不参与。
            如果 (类型节点值.附加 == 0 && 是整数类型文本548(字符串复制(驻留文本(类型ID))) &&
                 n.子终点 > n.子起点 && 整64(n.子终点 - 1) < 池.大小()) {
                登记零值右值548(池, 整64(n.文本), 整32(n.子终点 - 1), 符号表);
            }
            // ③ 第三波：指针局部登记（同参数约定：附加=指针层数 1..255）
            // 615：层数实参=类型节点附加位（多级指针成员访问拦截数据源）
            如果 (类型节点值.附加 >= 1 && 类型节点值.附加 < 256) {
                登记语义指针变量(整64(n.文本), 类型ID, 整64(类型节点值.附加));
                // 188-a（D6·plans/023 B11 变量常量传播）：声明初始化位恒空登记——
                //   形态分级（`无` 字面量=种子〔整数字面量 附加==1 标记〕／标识符=
                //   传播边／其余=失格）；无初始化（子起点==子终点）不登记
                如果 (n.子终点 > n.子起点 && 整64(n.子终点 - 1) < 池.大小()) {
                    节点 恒空右y = 池.元素(n.子终点 - 1);
                    如果 (恒空右y.类型 == 节点_整数字面量 && 恒空右y.附加 == 1) {
                        登记恒空种子(整64(n.文本));
                    } 否则 如果 (恒空右y.类型 == 节点_标识符) {
                        登记恒空边(整64(n.文本), 整64(恒空右y.文本));
                    } 否则 {
                        登记恒空失格(整64(n.文本));
                    }
                }
            }
            // 94-a（2026-09-13 第九十四轮）：数组声明——登记**元素类型**到语义
            //   指针变量表（数组名退化为元素指针；下标检查 p[i] 路径/左值写/
            //   作实参全链复用——IR 层 生成数组局部 同款登记）。元素类型白名单
            //   经 指针下标所指合法 既有判定（标量/字符串/结构体）。
            字符串 声明文本94 = 字符串复制(驻留文本(类型ID));
            如果 (是数组类型文本(声明文本94)) {
                可选<字符串> 元素94查 = 数组元素文本(声明文本94);
                字符串 元素94 = "";
                如果 (元素94查.有值) { 元素94 = 字符串复制(元素94查.值); }
                如果 (字符串长度(元素94) > 0) {
                    // 615：数组名作指针表达式的层数=1（数组退化）+元素尾星数
                    //   （元素为 T* 时数组名实为 T**——元素带星登记与宿主拒面
                    //   方向一致；元素无星=1 层，多级拦截零命中=既有行为不变）
                    登记语义指针变量(整64(n.文本), 驻留(元素94),
                                     1 + 尾星数615(元素94));
                }
            }
            // 引用局部纪律（2026-09-04，IR生成.cn 冒烟 96 错根治配套）：
            //   C++ 同款——必须初始化 + 初始化须为可绑定左值形态（标识符/
            //   成员/解引用/下标（指针下标 p[i]——IR 生成左值地址 已支持）/
            //   引用返回调用（取值(p)——宿主 P3-18 白名单对齐）——绑定右值=
            //   普通调用结果/二元运算/字面量拒绝，防空引用与静默错误代码。
            如果 (类型节点值.附加 == 256) {
                如果 (n.子起点 >= n.子终点) {
                    表诊断(诊断, "[错误] 引用声明必须初始化（绑定既有对象）: " +
                                  驻留文本(整64(n.文本)));
                } 否则 {
                    节点 初始化末y = 池.元素(n.子终点 - 1);
                    布尔 初始化是引用调用 = 假;
                    如果 (初始化末y.类型 == 节点_调用) {
                        初始化是引用调用 = 是引用返回调用(池, n.子终点 - 1, 符号表);
                    }
                    如果 (初始化末y.类型 != 节点_标识符 && 初始化末y.类型 != 节点_成员 &&
                         初始化末y.类型 != 节点_解引用 && 初始化末y.类型 != 节点_下标 &&
                         !初始化是引用调用) {
                        表诊断(诊断, "[错误] 引用初始化必须是可绑定左值（变量/成员/下标/解引用/引用返回调用）: " +
                                      驻留文本(整64(n.文本)));
                    }
                }
            }
            // plans/019 阶段4' A1（2026-09-11 方案A 用户批准）：字符串借出初始化
            //   拒绝——下标/成员/解引用初值=借用视图（数组元素/字段/指向），隐式
            //   装入拥有变量=释放挂点对他人指针行使所有权（宿主实测 UAF：s=名单[0]
            //   后重新赋值→free 旧堆串→数组元素悬垂读取乱码）。拥有化须显式
            //   字符串复制(...)；字符* 借用视图随第三批 A2。推断声明（472 提前
            //   返回）不在此拦——与宿主同边界，随 A2 一并收口。
            如果 (类型ID == 驻留("字符串") && 类型节点值.附加 == 0 &&
                 n.子起点 < n.子终点) {
                节点 借出末A1 = 池.元素(n.子终点 - 1);
                如果 (借出末A1.类型 == 节点_下标 || 借出末A1.类型 == 节点_成员 ||
                     借出末A1.类型 == 节点_解引用) {
                    表诊断(诊断, "[错误] 字符串变量 '" + 驻留文本(整64(n.文本)) +
                                  "' 不能以下标/成员/解引用借出隐式初始化——须 字符串复制(...) 显式落堆拥有化（字符* 借用视图随 plans/019 第三批）");
                }
                // A2（2026-09-11 方案甲）：字符* 借用视图装入拥有变量收紧——
                //   调用初值返回 字符*（如 驻留文本/借用返回函数）拒绝，
                //   须显式 字符串复制（借用→拥有显式；拥有→借用自动）。
                如果 (借出末A1.类型 == 节点_调用 && 借出末A1.子起点 >= 0) {
                    节点 被调A2d = 池.元素(整32(借出末A1.子起点));
                    可选<整64> 返型查A2d = 查函数返回类型(整64(被调A2d.文本));
                    如果 (被调A2d.类型 == 节点_标识符) {
                        如果 (返型查A2d.有值) {
                            整64 返型A2d = 返型查A2d.值;
                            如果 (返型A2d == 驻留("字符*")) {
                                表诊断(诊断, "[错误] 字符串变量 '" + 驻留文本(整64(n.文本)) +
                                              "' 不能以字符* 借用视图隐式初始化——须 字符串复制(...) 显式落堆拥有化（借用→拥有显式；拥有→借用自动）");
                            }
                        }
                    }
                }
            }
        }
    }
}


// 040/204①②（001 §5.8 来源封口·2026-10-05 用户裁决）：函数指针来源封口——
//   左类型=函数指针<...> 时右值合法来源仅 ①函数名（签名表登记·函数名衰减）
//   ②同签名函数指针/同文本 fnptr 数组元素（规范化文本全等）。整数字面量/
//   空类型* 等其他类型=编译期硬错误（§1.1a①·宿主 604/605 同文案对齐；
//   Rust 对照=safe Rust 无 transmute 不可伪造 fn pointer）。右类型不可推导
//   形态（成员链/复杂表达式/复合赋值合成根）=诚实边界放行（检出面随类型
//   推导扩面；宿主 canConvertType 全形态覆盖=既有）。
函数 检查函数指针来源封口(向量<节点> 池, 整32 右末索引, 字符串 左文本480,
                      向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    节点 右末480 = 池.元素(右末索引);
    // 031（#1075·负例 11）：方法值→fnptr 全形态拒绝（宿主 reportConvertReject
    //   同构）——右值=对象.实例方法作值（绑定对象无处安放）→ 专用文案；声明
    //   初始化位与赋值位两调用点同覆盖（#943 旧过渡路径由放行改拒）。
    如果 (实参是绑定方法值806(池, 右末索引, 符号表)) {
        表诊断(诊断, "[错误] " + 方法值转换文案1075());
        返回;
    }
    字符串 右文本480 = "";
    布尔 右可判480 = 假;
    布尔 右合法480 = 假;
    如果 (右末480.类型 == 节点_标识符) {
        // 040 修订：函数名判定**先行**——签名表会把函数名以其返回类型登记进
        //   符号表（487 实证：`回调 = 减一` 走变量分支误报 '整32'），变量类型
        //   判定必须在签名表 miss 后兜底
        整64 键基480 = 三级键基查找(符号表, 整64(右末480.文本), 0 - 1);
        布尔 是函数名480 = 假;   // 签名表命中（结果 流敏感检查惯例）
        // 键基无效（-1 miss/-2 歧义）时签名表查询恒 miss=错误通道分流
        结果<整64, 整32> 查数480 = 查函数签名个数(键基480);
        如果 (查数480.正常) { 是函数名480 = 真; }
        如果 (是函数名480) {
            // 函数名衰减（合法来源①）：规范化类型=函数指针<返回>(参数)
            //   （480-a 合成约定·签名参数串=逗号拼接无括号·文本全等=精确匹配）
            右可判480 = 真;
            右合法480 = 真;
            结果<整64, 整32> 签串查480 = 查函数签名参数串(键基480 * 键位移);
            如果 (签串查480.正常) {
                整64 签串480 = 签串查480.值;
                可选<整64> 签类型480查 = 全局层查类型(符号表,
                    函数签名键(键基480, 驻留文本(签串480)));
                如果 (签类型480查.有值) {
                    右文本480 = "函数指针<" + 驻留文本(签类型480查.值) + ">(" +
                               驻留文本(签串480) + ")";
                    右合法480 = 字符串比较(右文本480, 左文本480);
                }
            }
        } 
        // 非函数名面（独立分支替代原裸 否则——else 降格为非法输入拦截分支）
        布尔 不是函数名480 = !是函数名480;
        如果 (不是函数名480) {
            可选<整64> 右类型480查 = 表查找类型ID(符号表, 整64(右末480.文本));
            如果 (右类型480查.有值) {
                右文本480 = 字符串复制(驻留文本(右类型480查.值));
                右可判480 = 真;
                右合法480 = (字符串长度(右文本480) >= 16 &&
                            字符串比较(字符串子串(右文本480, 0, 13), "函数指针<") &&
                            字符串比较(右文本480, 左文本480));
            } 否则 {
                右可判480 = 假;  // 未知名（诊断由 检查标识符左值赋值/表达式链 补报）
            }
        }
    } 否则 如果 (右末480.类型 == 节点_下标 && 右末480.子起点 > 0) {
        节点 下标对象480 = 池.元素(整32(右末480.子起点));
        如果 (下标对象480.类型 == 节点_标识符) {
            可选<整64> 对象类型480查 = 表查找类型ID(符号表, 整64(下标对象480.文本));
            如果 (对象类型480查.有值) {
                字符串 对象文本480 = 字符串复制(驻留文本(对象类型480查.值));
                如果 (是数组类型文本(对象文本480)) {
                    可选<字符串> 元素查480 = 数组元素文本(对象文本480);
                    如果 (元素查480.有值) { 右文本480 = 字符串复制(元素查480.值); }
                    右可判480 = 真;
                    右合法480 = (字符串长度(右文本480) >= 16 &&
                                字符串比较(字符串子串(右文本480, 0, 13), "函数指针<") &&
                                字符串比较(右文本480, 左文本480));
                }
            }
        }
    } 否则 如果 (右末480.类型 == 节点_整数字面量 || 右末480.类型 == 节点_浮点字面量) {
        右文本480 = 字符串复制("整数字面量");
        右可判480 = 真;
        右合法480 = 假;
    } 否则 如果 (右末480.类型 == 节点_调用 && 右末480.子起点 >= 0) {
        // 工厂调用 `回调 = 挑加法(1)`——被调首签名返回类型文本判定
        节点 被调480 = 池.元素(整32(右末480.子起点));
        如果 (被调480.类型 == 节点_标识符) {
            整64 调键基480 = 三级键基查找(符号表, 整64(被调480.文本), 0 - 1);
            // 键基无效（-1 miss/-2 歧义）时签名表查询恒 miss=错误通道分流
            结果<整64, 整32> 调数480 = 查函数签名个数(调键基480);
            如果 (调数480.正常) {
                结果<整64, 整32> 调签串查480 = 查函数签名参数串(调键基480 * 键位移);
                如果 (调签串查480.正常) {
                    整64 调签串480 = 调签串查480.值;
                    可选<整64> 调签类型480查 = 全局层查类型(符号表,
                        函数签名键(调键基480, 驻留文本(调签串480)));
                    如果 (调签类型480查.有值) {
                        右文本480 = 字符串复制(驻留文本(调签类型480查.值));
                        右可判480 = 真;
                        右合法480 = (字符串长度(右文本480) >= 16 &&
                                    字符串比较(字符串子串(右文本480, 0, 13), "函数指针<") &&
                                    字符串比较(右文本480, 左文本480));
                    }
                }
            }
        }
    }
    如果 (右可判480 && !右合法480) {
        表诊断(诊断, "[错误] 无法将 '" + 右文本480 + "' 隐式转换为 '" + 左文本480 +
                    "'（函数指针来源封口：合法来源仅 函数名衰减/同签名函数指针）");
    }
    返回;
}

// 884-a（070·G-N·537 B/C）：静态声明初值检查（装箱语境+类型检查）——
//   节点_静态声明 约定：文本=名ID、附加=类型节点索引、子区间=初值。声明类型为
//   结果/可选 时设装箱语境（与声明位 71-a 同款），初值区间逐个检查表达式后复位。
不安全 函数 检查静态声明初值884(向量<节点> 池, 节点 n,
                       向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    整64 类型ID884s = 0;
    如果 (n.附加 >= 0 && n.附加 < 池.大小()) {
        节点 类型节点884s = 池.元素(整32(n.附加));
        类型ID884s = 整64(类型节点884s.文本);
    }
    // 031（#1075）：放置骨架——静态变量位方法值类型拒绝（R3 语法面·顶层/
    //   函数内静态双路径同本函数=单挂点·宿主 checkPlacement 同构·文案逐字）
    如果 (类型ID884s > 0 &&
        是方法值类型文本(字符串复制(驻留文本(类型ID884s)))) {
        // 位置词按声明修饰区分（宿主 checkPlacement 位词逐字）：修饰==2=
        //   顶层裸全局（569）→「全局变量」；否则（顶层静态/函数内静态）→
        //   「静态变量」。
        字符串 位词884s = "静态变量";
        如果 (n.修饰 == 2) { 位词884s = "全局变量"; }
        表诊断(诊断, "[错误] " + 方法值放置文案1075(位词884s));
    }
    布尔 语境884s = 假;
    如果 (n.子起点 < n.子终点 && 类型ID884s > 0 && 是结果类型_ID(类型ID884s)) {
        // #1591：静态声明语境单点（与函数内声明位同口径）
        语境884s = 设声明位语境1591(池, n, 类型ID884s);
    }
    整64 i884s = 整64(n.子起点);
    当 (i884s < 整64(n.子终点)) {
        可选<整64> 忽略884s = 检查表达式(池, 整32(i884s), 符号表, 诊断);
        i884s++;
    }
    如果 (语境884s) { 设装箱语境884(0); }
}

// 569 d 款（2026-10-14 用户裁决·001 §5.2a·constinit 思路）：顶层裸全局变量
//   （语法层 修饰=2 标记）初始化器仅限常量表达式——防初始化顺序 fiasco。
//   判据（与宿主 cnEvalConstExpr 面对齐·零分叉）：单节点字面量（整/浮/字符串/
//   布尔/字符）∨ 递归常量折叠（整域字面量/负号/五算术/移位 + 常量名标识符·
//   函数 裸全局初值可折叠569 与 474 折叠子树值505 同构+常量名分支）∨
//   常量名标识符（表查找种类=符号_常量·全局层三级解析兜底含跨模块导入常量）。
//   函数调用/构造调用/运行期表达式=编译错误（挂点=语义检查尾顶层遍历·
//   check 命令即拒·全局符号层可用保证常量已收集）。无初值=零初始化放行。
函数 裸全局初值常量性569(向量<节点> 池, 节点 n,
                      向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    如果 (n.修饰 != 2) { 返回; }
    如果 (整64(n.子起点) >= 整64(n.子终点)) { 返回; }
    // 单节点形态：字面量直过；常量名引用按种类判
    如果 (整64(n.子终点) - 整64(n.子起点) == 1) {
        节点 值569 = 池.元素(整32(n.子起点));
        如果 (值569.类型 == 节点_整数字面量 || 值569.类型 == 节点_浮点字面量 ||
             值569.类型 == 节点_字符串字面量 || 值569.类型 == 节点_布尔字面量 ||
             值569.类型 == 节点_字符字面量) { 返回; }
        可选<整64> 值种类569查 = 表查找种类(符号表, 整64(值569.文本));
        如果 (值569.类型 == 节点_标识符) {
            如果 (值种类569查.有值) {
                整64 值种类569 = 值种类569查.值;
                如果 (值种类569 == 符号_常量) { 返回; }
            }
        }
    }
    // 递归折叠可判（整域：字面量/常量名/负号/五算术/移位）
    整64 折值569 = 0;
    如果 (裸全局初值可折叠569(池, 整32(整64(n.子终点) - 1), 符号表, 折值569, 0, 真)) { 返回; }
    表诊断(诊断, "[错误] 顶层全局变量 '" + 字符串复制(驻留文本(整64(n.文本))) +
                 "' 初始值必须是常量表达式（字面量/常量引用/常量算术——001 §5.2a " +
                 "防初始化顺序问题；运行期初始化请改用 静态 或在函数内赋值）");
}

// 569：初始化器递归常量折叠判定（474 折叠子树值505 同构+常量名标识符分支——
//   505 只认纯字面量子树，`系数 * 2 + 1` 常量名参与算术形态由本函数承载；
//   后缀序契约同 505：负号操作数根=自身索引-1、二元右根=自身-1·左根=附加-1）
函数 裸全局初值可折叠569(向量<节点> 池, 整32 根索引,
                      向量<映射<整64, 符号>>& 符号表, 整64& 值, 整32 深度,
                      布尔 纯负链) -> 布尔 {
    如果 (深度 > 64 || 根索引 <= 0 || 根索引 >= 整32(池.大小())) { 返回 假; }
    节点 根n569 = 池.元素(根索引);
    // 叶：整数字面量（取常量下标值 单点解析·含巨字面量保护——505 同源）
    如果 (根n569.类型 == 节点_整数字面量) {
        返回 取常量下标值(池, 根索引, 根索引 + 1, 值);
    }
    // 叶：常量名标识符（表查找种类 三级解析兜底·跨模块导入常量可判）
    如果 (根n569.类型 == 节点_标识符) {
        可选<整64> 根种类569查 = 表查找种类(符号表, 整64(根n569.文本));
        // miss（原 -1 哨兵）≠ 符号_常量 → 非常量叶（显式默认）
        布尔 根是常量569 = 假;
        如果 (根种类569查.有值) { 根是常量569 = 根种类569查.值 == 符号_常量; }
        如果 (!根种类569查.有值 || !根是常量569) { 返回 假; }
        // 常量值=类型ID 记 名ID 惯例（收集常量声明 953 口径）——值文本经
        // IR 常量表，语义期只判「是常量」即放行（值正确性由 IR 折叠保证）
        值 = 1;
        返回 真;
    }
    // 一元负：操作数根=自身索引-1（子终点=自身索引·解析契约；同 505）
    如果 (根n569.类型 == 节点_负号) {
        整64 操作数569 = 0;
        如果 (根n569.子起点 <= 0 || 根n569.子终点 != 根索引 ||
             !裸全局初值可折叠569(池, 根索引 - 1, 符号表, 操作数569, 深度 + 1, 纯负链)) {
            // 790/1016（569 采样轮 H1 对齐·探针实锚）：int64 最小界特例——子叶
            //   magnitude 恰 2^63 时递归单节点窗按 int64 正上界承载失败（宿主
            //   文本保真放行）。把 [操作数, 负号] 两节点窗交 取常量下标值 负号
            //   通道单点判定（790 十进制 9223372036854775808；1016 扩全进制
            //   hex 8000000000000000／oct 1+21 零／bin 1+63 零→INT64_MIN——十六
            //   进制裸全局 -0x8000000000000000 原误拒 rc=1 实锚）。单一真源=
            //   不在此重复文本比对（防两处判据分叉）。
            如果 (取常量下标值(池, 根索引 - 1, 根索引 + 1, 值)) { 返回 真; }
            // 1016（三轮审查 P1-1）：128 槽负号巨字面量（-0xFFFFFFFFFFFFFFFF
            //   等）常量性放行——仅限**纯负号链**（初始化器根=负号链起点；
            //   负号递归继承标志、二元操作数递归清除）。二元表达式内的负号
            //   子节点回父提交行为=拒（-0xFFFFFFFFFFFFFFFF - 1 宿主 1/v2 曾
            //   误放行 0）；-(-0xFFFFFFFFFFFFFFFF) 纯负链=放行（宿主 0）。
            如果 (纯负链 && 负号巨字面量常量1016(池, 整32(根索引 - 1))) {
                值 = 0;
                返回 真;
            }
            返回 假;
        }
        值 = 位模式取负474(操作数569);
        返回 真;
    }
    // 普通二元（子终点恒 0 与短路区分）：右子树根=自身-1、左子树根=附加-1（同 505）
    如果 (根n569.类型 == 节点_二元运算 && 根n569.子终点 == 0) {
        字符串 op569 = 字符串复制(驻留文本(整64(根n569.文本)));
        布尔 是折叠符569 = 字符串比较(op569, "+") || 字符串比较(op569, "-") ||
                        字符串比较(op569, "*") || 字符串比较(op569, "/") ||
                        字符串比较(op569, "%") || 字符串比较(op569, "<<") ||
                        字符串比较(op569, ">>");
        如果 (!是折叠符569) { 返回 假; }
        整64 左值569 = 0;
        整64 右值569 = 0;
        如果 (根n569.附加 <= 0 || 根n569.附加 >= 整64(根索引)) { 返回 假; }
        如果 (!裸全局初值可折叠569(池, 整32(根n569.附加) - 1, 符号表, 左值569,
                                深度 + 1, 假)) { 返回 假; }
        如果 (!裸全局初值可折叠569(池, 根索引 - 1, 符号表, 右值569, 深度 + 1, 假)) { 返回 假; }
        返回 折叠二元应用505(op569, 左值569, 右值569, 值);
    }
    返回 假;
}


// 区间登记辅助（③ 第二波根治 检查块 双重处理）：偶数位=起点/奇数位=终点（不含）
函数 登记跳过区间(向量<整64>& 区间们, 整64 起, 整64 终) -> 空类型 {
    结果<空类型, 整32> 加a = 区间们.追加(起);
    如果 (!加a.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加b = 区间们.追加(终);
    如果 (!加b.正常) { 运行时错误(4); }
}

// 593（2026-10-14 任务593）：抽象类/接口「元素数组」值形态声明拦截——数组
//   声明（变量/形参/返回/字段）=逐元素默认构造实例化（specs/06 §八「含抽象
//   成员的类不可直接实例化」+接口同族·193 数组形态漏网根治·宿主
//   reportAbstractArrayValueDecl 同构）。原缺口=是抽象类ID/是接口名ID 按
//   **全文本**精确查表，「图形[3]」含数组后缀恒 miss 静默放行（v2 接口数组
//   实测 rc=0；抽象数组被 IR 宽度表偶然兜住=诊断错位，与宿主静默产 exe=分叉
//   双向实锤）。剥数组后缀取元素类型走同一抽象检查：嵌套数组循环剥至元素；
//   指针后缀形态（图形*[3] 元素=「图形*」查表自然 miss）不拦——193 口径：
//   指针/引用不发生值形态实例化。文案对齐 193 注明数组形态（与宿主逐字
//   一致·零分叉纪律）。非数组=恒 假（调用方零成本直通）。
函数 报抽象数组声明诊断593(字符串 类型文本, 向量<字符串>& 诊断) -> 布尔 {
    如果 (!是数组类型文本(类型文本)) { 返回 假; }
    字符串 元素593 = 字符串复制(类型文本);
    布尔 可判593 = 真;
    当 (是数组类型文本(元素593)) {
        可选<字符串> 上层593查 = 数组元素文本(元素593);
        字符串 上层593 = "";
        如果 (上层593查.有值) { 上层593 = 字符串复制(上层593查.值); }
        如果 (字符串长度(上层593) == 0) { 可判593 = 假; 中断; }
        元素593 = 字符串复制(上层593);
    }
    如果 (!可判593) { 返回 假; }
    整64 元素ID593 = 驻留(元素593);
    如果 (是抽象类ID(元素ID593)) {
        表诊断(诊断, "[错误] 不能实例化抽象类 '" + 字符串复制(元素593) +
                      "'（含未实现抽象方法·数组 '" + 字符串复制(类型文本) +
                      "' 元素为值形态默认构造）——请实例化具体派生类");
        返回 真;
    }
    如果 (是接口名ID(元素ID593)) {
        表诊断(诊断, "[错误] 不能实例化接口 '" + 字符串复制(元素593) +
                      "'（接口无实现体·数组 '" + 字符串复制(类型文本) +
                      "' 元素为值形态默认构造）——请以实现类实例初始化接口变量");
        返回 真;
    }
    返回 假;
}

// 746（2026-10-14 任务746）：抽象类/接口「单值」按值签名/字段/静态存储声明拦截
//   ——非数组纯值形态 按值形参/返回/字段/静态存储=按值复制实例化面（宿主
//   reportAbstractValueDecl 同构·593 数组形态同族收口·specs/06 §八+接口同族）。
//   原缺口=193 裸声明检查与 593 数组 helper 之间的单值签名/成员面 双侧恒静默
//   放行（修前探针 rc=0 实锤）。与 593 helper 互斥分工：数组形态（是数组类型
//   文本）归 593 报（本函数恒 假 直通·防双报）；指针/引用后缀文本（解析层显式
//   并入）按全文本查表自然 miss 不拦=193 口径（不发生值形态实例化）。文案与
//   宿主逐字一致（除 [错误] 前缀惯例·面 由调用方注入：按值形参/按值返回/
//   按值字段/按值静态字段/按值静态存储）。
函数 报抽象单值声明诊断746(字符串 类型文本, 字符串 面文本, 布尔 拦接口, 向量<字符串>& 诊断) -> 布尔 {
    如果 (是数组类型文本(类型文本)) { 返回 假; }
    如果 (字符串长度(类型文本) == 0) { 返回 假; }
    整64 类型ID746 = 驻留(类型文本);
    如果 (是抽象类ID(类型ID746)) {
        表诊断(诊断, "[错误] 不能实例化抽象类 '" + 字符串复制(类型文本) +
                      "'（含未实现抽象方法·" + 字符串复制(面文本) +
                      "为值形态复制构造）——请实例化具体派生类");
        返回 真;
    }
    如果 (是接口名ID(类型ID746)) {
        // 746 收窄（105 回归红实证裁定·宿主同构）：接口单值形参/返回=A1 同
        //   地址语义引用句柄传递（不实例化·specs/06 §六·plans/006 P3-19 C2
        //   立法面 105_接口参数多态 锁面）——拦接口=假 时放行。字段/静态
        //   存储无实参绑定来源=未绑定引用面（193 接口裸声明拒同构）仍拦。
        如果 (!拦接口) { 返回 假; }
        表诊断(诊断, "[错误] 不能实例化接口 '" + 字符串复制(类型文本) +
                      "'（接口无实现体·" + 字符串复制(面文本) +
                      "为值形态复制构造）——请以实现类实例初始化");
        返回 真;
    }
    返回 假;
}
