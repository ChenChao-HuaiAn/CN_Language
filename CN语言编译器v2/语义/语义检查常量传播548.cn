// CN 自举编译器 v2 · 语义检查常量传播548（L2 冻结线拆分·自 语义检查.cn 纯机械搬移·
//   函数体逐字保留·零语义变化：548 编译期除零常量传播面全套设施——零值种子表
//   （188-a 恒空表机制级同构推广）+顶层常量值表（宿主 globalConstValues_ 机制对称）
//   +收尾判定。消费=检查常量除零474（使用点登记/常量名折叠）/检查函数（清空+收尾）/
//   声明/赋值/取址/引用实参/自增自减登记位/收集常量声明（值表登记）——包内合并池解析）
// 立法锚：001 §1.1a①「常量传播面（变量持有常量初值作下标/除数）随常量折叠后续波」。

导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（目录包名）
导入 IR;         // 容器/结果 合成名判定 + 节点_*/键位移 常量（目录包名）
导入 协议常量;   // 驻留/驻留文本（中立层）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// ==================== 548（编译期除零·常量传播面·001 §1.1a①「随常量折叠后续波」） ====================
//   宿主 ZeroPropState548（semantic.hpp zp548_）同构：188-a 恒空表机制级推广到
//   整数除零域——种子=以编译期可折叠零（字面量/常量名/折叠式）写入；失格=其他
//   写入（非常量/非零常量/复合赋值/自增自减/调用）与别名逃逸（取地址/引用实参）；
//   边=右值为标识符变量的传播；使用点=除/余右操作数裸标识符变量（检查常量除零474
//   登记位）。函数收尾 判定零值除零报错 统一不动点判定（流不敏感保守零假阳性——
//   任何非零值写入/别名逃逸即失格=漏报不误报；全函数视角同 B11 已验收口径）。
静态 向量<整64> 零值种子们;
静态 向量<整64> 零值失格们;
静态 向量<整64> 零值边目标们;
静态 向量<整64> 零值边源们;
静态 向量<整64> 零值使用名们;
静态 向量<整64> 零值使用行们;
静态 向量<整64> 零值使用符们;   // 1=除 2=余（宿主 const char* op 同构）

// 顶层常量值表（548 语义层登记设施·宿主 globalConstValues_ 机制对称——修前 v2
//   现值表仅 IR 层·语义阶段不可达=548 立案分叉种子）。收集常量声明时经
//   折叠子树值548 求值登记（声明序单调=前向引用不登记保守漏报·宿主
//   registerConstValues 同口径）；多模块同名值不同=多义不可折叠（保守放行防
//   误拦）。任务级生命周期（语义分析多文件 入口清空）。
静态 映射<整64, 整64> 顶层常量值们;
静态 向量<整64> 顶层常量多义们;

函数 零值名含(向量<整64> 名们, 整64 名ID) -> 布尔 {
    整64 i = 0;
    当 (i < 整64(名们.大小())) {
        如果 (名们.元素(整32(i)) == 名ID) { 返回 真; }
        i++;
    }
    返回 假;
}

不安全 函数 登记零值种子(整64 名ID) -> 空类型 {
    如果 (零值名含(零值种子们, 名ID)) { 返回; }
    结果<空类型, 整32> 加 = 零值种子们.追加(名ID);
    如果 (!加.正常) { 运行时错误(4); }
}

不安全 函数 登记零值失格(整64 名ID) -> 空类型 {
    如果 (零值名含(零值失格们, 名ID)) { 返回; }
    结果<空类型, 整32> 加 = 零值失格们.追加(名ID);
    如果 (!加.正常) { 运行时错误(4); }
}

不安全 函数 登记零值边(整64 目标名ID, 整64 源名ID) -> 空类型 {
    结果<空类型, 整32> 加目 = 零值边目标们.追加(目标名ID);
    如果 (!加目.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加源 = 零值边源们.追加(源名ID);
    如果 (!加源.正常) { 运行时错误(4); }
}

不安全 函数 登记零值使用点(整64 名ID, 整64 行, 整64 符) -> 空类型 {
    // 去重（同 名×行×符 视作同一使用点——v2 语句区间线性遍历可能二次到达，
    //   188-a 使用点去重同款防收尾同点双报）
    整64 d = 0;
    当 (d < 整64(零值使用名们.大小())) {
        如果 (零值使用名们.元素(整32(d)) == 名ID &&
              零值使用行们.元素(整32(d)) == 行 &&
              零值使用符们.元素(整32(d)) == 符) {
            返回;
        }
        d++;
    }
    结果<空类型, 整32> 加名 = 零值使用名们.追加(名ID);
    如果 (!加名.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加行 = 零值使用行们.追加(行);
    如果 (!加行.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加符 = 零值使用符们.追加(符);
    如果 (!加符.正常) { 运行时错误(4); }
}

不安全 函数 清空零值表() -> 空类型 {
    零值种子们.清空();
    零值失格们.清空();
    零值边目标们.清空();
    零值边源们.清空();
    零值使用名们.清空();
    零值使用行们.清空();
    零值使用符们.清空();
}

// 函数/方法体检查收尾：边不动点（乙 = 甲 且 甲 持零 → 乙 持零）→ 使用点逐点
//   判定 → 报编译期除零（诊断与 503 字面量形态同锚「编译期除零」子串·817 兼容；
//   宿主 reportZeroConstUses 同构）。
不安全 函数 判定零值除零报错(向量<字符串>& 诊断) -> 空类型 {
    布尔 变化 = 真;
    当 (变化) {
        变化 = 假;
        整64 e = 0;
        当 (e < 整64(零值边目标们.大小())) {
            整64 目标e = 零值边目标们.元素(整32(e));
            整64 源e = 零值边源们.元素(整32(e));
            如果 (零值名含(零值失格们, 源e)) {
            } 否则 如果 (零值名含(零值种子们, 源e)) {
                如果 (!零值名含(零值种子们, 目标e)) {
                    结果<空类型, 整32> 加 = 零值种子们.追加(目标e);
                    如果 (!加.正常) { 运行时错误(4); }
                    变化 = 真;
                }
            }
            e++;
        }
    }
    整32 保存行548 = 取当前诊断行();
    整64 u = 0;
    当 (u < 整64(零值使用名们.大小())) {
        整64 名u = 零值使用名们.元素(整32(u));
        如果 (!零值名含(零值失格们, 名u)) {
            如果 (零值名含(零值种子们, 名u)) {
                设当前诊断行(整32(零值使用行们.元素(整32(u))));
                字符串 符u = 字符串复制("除数");
                如果 (零值使用符们.元素(整32(u)) == 2) { 符u = 字符串复制("取余除数"); }
                表诊断(诊断, "[错误] 编译期除零：变量 '" + 字符串复制(驻留文本(名u)) +
                              "' 持有常量零初值作" + 符u +
                              "（常量传播面·001 §1.1a①；运行期除零已有运行时错误 1）");
            }
        }
        u++;
    }
    设当前诊断行(保存行548);
}

// ---- 548 顶层常量值表访问器（语义阶段唯一权威值源·收集期写/检查期读） ----

不安全 函数 登记顶层常量值(整64 名ID, 整64 值) -> 空类型 {
    // 多义检测：已登记且值不同 → 入多义名单（查值恒失败=不可折叠保守放行——
    //   多模块同名常量值异时按名ID 直查无模块上下文·宁可漏报不误拦）
    如果 (顶层常量值们.包含(名ID)) {
        结果<整64, 整32> 旧548 = 顶层常量值们.获取(名ID);
        如果 (旧548.正常 && 旧548.值 != 值 && !零值名含(顶层常量多义们, 名ID)) {
            结果<空类型, 整32> 加 = 顶层常量多义们.追加(名ID);
            如果 (!加.正常) { 运行时错误(4); }
        }
        返回;
    }
    结果<空类型, 整32> 设548 = 顶层常量值们.设置(名ID, 值);
    如果 (!设548.正常) { 运行时错误(4); }
}

函数 查顶层常量值(整64 名ID, 整64& 值) -> 布尔 {
    如果 (零值名含(顶层常量多义们, 名ID)) { 返回 假; }
    如果 (!顶层常量值们.包含(名ID)) { 返回 假; }
    结果<整64, 整32> 取548 = 顶层常量值们.获取(名ID);
    如果 (!取548.正常) { 返回 假; }
    值 = 取548.值;
    返回 真;
}

不安全 函数 清空顶层常量值表() -> 空类型 {
    顶层常量值们.清空();
    顶层常量多义们.清空();
}

// 548：比较参与=零值判定失格（宿主 checkComparisonBinary 同构）——零初值变量
//   进入比较即进入除零防视野（短路守卫惯用形 `除数 != 0 && 10/除数`·125/137
//   短路语义锁形态），其除法使用点保守放行交运行期兜底（检查序=左子树先于右：
//   比较失格先于右侧除法使用点登记·收尾判定正确）。左末=附加-1、右末=自身-1
//   （970 布局契约·调用方=检查二元运算表达式 比较符分支）。
函数 登记零值比较失格548(向量<节点> 池, 整32 左末端索引, 整32 节点索引,
                    向量<映射<整64, 符号>>& 符号表) -> 空类型 {
    如果 (左末端索引 < 0 || 节点索引 < 1 ||
         左末端索引 >= 整32(池.大小()) || 节点索引 > 整32(池.大小())) { 返回; }
    节点 左末548 = 池.元素(左末端索引);
    如果 (左末548.类型 == 节点_标识符 &&
         表查找种类(符号表, 整64(左末548.文本)) != 符号_常量) {
        登记零值失格(整64(左末548.文本));
    }
    节点 右末548 = 池.元素(节点索引 - 1);
    如果 (右末548.类型 == 节点_标识符 &&
         表查找种类(符号表, 整64(右末548.文本)) != 符号_常量) {
        登记零值失格(整64(右末548.文本));
    }
}
