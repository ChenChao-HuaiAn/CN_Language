// CN 自举编译器 v2 · 语义检查·成员存在性检查族（#1951 新增拆分·2026-11-01）
// 职责：对象.成员 的成员存在性语义检查单面（#1741 拒因归一）——对象=标识符
//   且类型=用户类/结构体/容器 的 字段表+方法表双 miss 面由语义层报用户诊断
//   （宿主逐字文案·k1/k5/k6 探针实测），修前放行到 IR 层 查字段宽度码 内部
//   #648 通道（写入/读取=内部错误形态 vs 宿主「没有成员」用户诊断=拒因签名
//   分叉；内部错误通道禁当用户面）。
// 「先拆再加」纪律落点：实现不入 语义检查.cn（1000 行红线先拆再加·与 1029
//   访问控制同款三件套=导入区块/公开:/包.cn 加载位）——消费=语义检查.cn
//   检查成员访问表达式（成员读/写两态公共面·1029 段之后单挂）。
// 豁免面：①被调位（对象.方法(...)）=方法面由 907/容器方法通道承担（防双报·
//   该通道已报同文案 k3 实测）；②合成体/接口对象=载荷/接口通道既有（合成体
//   含 $ 不入三判）；③推导 miss=诚实边界放行（检不出≠检错·-1 哨兵通道同款
//   纪律）；④成员链/下标对象形态=既有 [ir2] 拒（双侧同属拒绝非放行分叉·
//   615 同款诚实边界）。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量
导入 IR;         // 是容器类_ID/查类节点索引/查结构体类型/查字段类型ID/查泛型基类参数序/是容器基名
导入 协议常量;   // 驻留/驻留文本（中立层）

公开:   // 全文件公开（供 语义检查 包内兄弟经合并全局池消费）

// #1951 诊断显示辅助（#1741 拒因归一·2026-11-01）：$ 合成名无歧义面重组
//   尖括号源形态（向量$整32 → 向量<整32>）——用户诊断中类型文本对齐宿主
//   源形态显示（k6 探针：宿主「向量<整32>」vs v2 原样合成名）。切分与
//   语义分析中 回查合成名实参1949 同款头感知（容器白名单映射=2 参其余=1/
//   结果=2 可选=1/泛型类=参数名串 ',' 切段数）；歧义面（段数≠实参数·嵌套
//   实参二义）/头名三族不命中/无 '$' =原样返回（禁猜切分）。
函数 合成名显示文本(字符串 合成名) -> 字符串 {
    整64 首元 = 0 - 1;
    整64 i = 0;
    当 (i < 字符串长度(合成名)) {
        如果 (((整64(合成名[整32(i)]) & 255) == 36)) { 首元 = i; 中断; }
        i++;
    }
    如果 (首元 == 0 - 1 || 首元 == 0) { 返回 字符串复制(合成名); }
    字符串 头名 = 字符串子串(合成名, 0, 整32(首元));
    字符串 余段 = 字符串子串(合成名, 整32(首元 + 1),
                           整32(字符串长度(合成名) - 首元 - 1));
    向量<字符串> 段们 = 向量<字符串>();
    整64 段起 = 0;
    整64 j = 0;
    当 (j <= 字符串长度(余段)) {
        布尔 末位j = j == 字符串长度(余段);
        整64 字j = 0 - 1;
        如果 (!末位j) { 字j = 整64(余段[整32(j)]) & 255; }
        如果 (末位j || 字j == 36) {
            结果<空类型, 整32> 加段 = 段们.追加(字符串子串(余段, 整32(段起),
                                        整32(j - 段起)));
            如果 (!加段.正常) { 运行时错误(4); }
            段起 = j + 1;
        }
        j++;
    }
    整64 实参数 = 0 - 1;
    布尔 头容器 = 是容器基名(头名);
    布尔 头映射 = 字符串比较(头名, "映射");
    布尔 头结果 = 字符串比较(头名, "结果");
    布尔 头可选 = 字符串比较(头名, "可选");
    如果 (头映射) { 实参数 = 2; }
    如果 (头容器 && 头映射 == 假) { 实参数 = 1; }
    如果 (头结果) { 实参数 = 2; }
    如果 (头可选) { 实参数 = 1; }
    如果 (头容器 == 假 && 头结果 == 假 && 头可选 == 假) {
        可选<整64> 序查 = 查泛型基类参数序(驻留(头名));
        如果 (序查.有值) {
            字符串 序串 = 字符串复制(驻留文本(序查.值));
            实参数 = 1;
            整64 k = 0;
            当 (k < 字符串长度(序串)) {
                如果 (((整64(序串[整32(k)]) & 255) == 44)) { 实参数++; }
                k++;
            }
        }
    }
    布尔 无歧义 = 实参数 != 0 - 1 && 实参数 != 0 &&
                  整64(段们.大小()) == 实参数;
    如果 (无歧义 == 假) {
        返回 字符串复制(合成名);   // 歧义面/头未知=原样（禁猜切分）
    }
    字符串 重组 = 头名 + "<";
    整64 m = 0;
    当 (m < 整64(段们.大小())) {
        如果 (m != 0) { 重组 = 重组 + ", "; }
        重组 = 重组 + 字符串复制(段们.元素(整32(m)));
        m++;
    }
    返回 重组 + ">";
}

// #1951：成员存在性检查单点（细则/豁免面见文件头）——
//   消费=语义检查.cn 检查成员访问表达式（n=成员节点·读/写两态公共面）。
函数 检查成员存在(向量<节点> 池, 整32 节点索引,
                  向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    节点 n = 池.元素(节点索引);
    如果 (n.子起点 != 0 - 1 && 整64(n.子起点) < 池.大小()) {
        节点 声明对象节点 = 池.元素(整32(n.子起点));
        布尔 被调位命中 = 假;
        // 被调位判定=成员池位后窗内「节点_调用 且 子起点==本成员索引」——
        //   语句位直调（对象.方法(...)）调用节点紧随成员后（894 同款 +1 判据）；
        //   嵌套实参位（打印(对象.方法(...))）成员后隔实参区间才是内层调用
        //   节点（k3 探针 +1 判据漏豁免=907 通道双报实录）→ 窗 64 池位扫描。
        //   子起点==本成员索引 的调用=被调唯一指向本成员（恒正确无误豁免）。
        整64 扫描窗位 = 整64(节点索引) + 1;
        整64 窗尾界 = 整64(节点索引) + 64;
        如果 (窗尾界 > 整64(池.大小())) { 窗尾界 = 整64(池.大小()); }
        当 (!被调位命中 && 扫描窗位 < 窗尾界) {
            节点 窗内节点 = 池.元素(整32(扫描窗位));
            如果 (窗内节点.类型 == 节点_调用 &&
                整64(窗内节点.子起点) == 整64(节点索引)) {
                被调位命中 = 真;
            }
            扫描窗位++;
        }
        布尔 可查位 = 声明对象节点.类型 == 节点_标识符 && !被调位命中;
        如果 (可查位) {
            整64 接收者类型 = 0;
            可选<整64> 接收者类型查 = 表查找类型ID(符号表, 整64(声明对象节点.文本));
            如果 (接收者类型查.有值) { 接收者类型 = 接收者类型查.值; }
            // 指针接收者剥尾星一级（成员方法剥星·先按全名判定命中同构）
            接收者类型 = 成员方法剥星(接收者类型);
            字符串 成员名p = 字符串复制(驻留文本(整64(n.文本)));
            布尔 用户类命中 = 接收者类型 != 0 && 查类节点索引(接收者类型).有值;
            布尔 容器命中 = 接收者类型 != 0 && 是容器类_ID(接收者类型);
            整64 父结构键基 = 0;
            如果 (接收者类型 != 0) {
                可选<整64> 父结构键基查 = 查结构体类型(接收者类型);
                如果 (父结构键基查.有值) { 父结构键基 = 父结构键基查.值; }
            }
            如果 (用户类命中) {
                布尔 字段命中 = 查类字段沿链(池, 接收者类型, 整64(n.文本));
                布尔 方法命中 = 查类方法节点沿链(池, 接收者类型, 整64(n.文本)).有值;
                如果 (字段命中 == 假 && 方法命中 == 假) {
                    表诊断(诊断, "[错误] 类 '" + 字符串复制(驻留文本(接收者类型)) +
                                  "' 没有成员 '" + 成员名p + "'");
                }
            } 否则 如果 (容器命中) {
                表诊断(诊断, "[错误] 类型 '" + 合成名显示文本(字符串复制(驻留文本(接收者类型))) +
                              "' 不是结构体/联合体/类类型，无法访问成员 '" +
                              成员名p + "'");
            } 否则 如果 (父结构键基 != 0) {
                可选<整64> 字段类型查 = 查字段类型ID(父结构键基, 整64(n.文本));
                如果 (字段类型查.有值 == 假) {
                    表诊断(诊断, "[错误] 结构体 '" +
                                  字符串复制(驻留文本(接收者类型)) +
                                  "' 没有成员 '" + 成员名p + "'");
                }
            }
        }
    }
}
