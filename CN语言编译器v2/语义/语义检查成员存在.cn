// CN 自举编译器 v2 · 语义检查·成员存在性检查族（#1951 新增拆分·2026-11-01）
// 职责：对象.成员 的成员存在性语义检查单面（#1741 拒因归一）——用户类/接口/
//   结构体/联合体/容器/结果/可选/手动释放/枚举/标量 的成员存在性由语义层报
//   用户诊断（宿主 semantic_expr_access.cpp visitMemberExpr 逐字文案），修前
//   放行到 IR 层 查字段宽度码 内部 #648 通道（写入/读取=内部错误形态 vs 宿主
//   「没有成员」用户诊断=拒因签名分叉；内部错误通道禁当用户面）。
// 「先拆再加」纪律落点：实现不入 语义检查.cn（1000 行红线先拆再加·与 1029
//   访问控制同款三件套=导入区块/公开:/包.cn 加载位）——消费=语义检查.cn
//   检查成员访问表达式（成员读/写两态公共面·1029 段之后单挂）。
// 豁免面（每条均有实跑证据·见下方 #2011 返工段与 ⑧ 段）：①被调位
//   （对象.方法(...)）=方法面由 907/容器方法/接口通道承担（防双报·该通道已报
//   同文案 k3 实测）；②守卫对象类型ID 无值（本层推导不出接收者类型）=本层
//   不判，交 IR 布局层判定（IR miss=显式内部错误即中止·#648 静默通路已废除）；
//   ③指针尾星=多级指针/安全区专属文案归 615/926 通道（本层不报·防双报）。
// #2011（2026-11-04 1103 采样轮）：原对象面仅「标识符」+三类型族——成员链/
//   下标/调用对象形态与 结果/可选/手动释放/枚举/标量 类型族整体漏检（可选<
//   可选<整32>> 甲; 甲.值.无此成员 = 静默放行落盘产物=安全红线实锤）；现对象
//   形态与类型族全面补齐，分族决策=成员存在分族 单点。
// #2011 返工（2026-11-04 云端预验 636 红根治）：结构体/联合体族的**链式接收者**
//   （对象=成员链/下标/调用/解引用）不在此报，交回 IR 布局层 #648 通道——机械
//   证据（v2p 实跑，非注释断言）：①写形态 甲.丙.未知 → 「[内部错误] 字段宽度码·
//   字段未登记 '未知'」+「[ir2] 成员左值字段偏移未知: 未知」+ 退出码 1 中止；
//   ②读形态 甲.丙.无此成员 / 结构体数组元素 表[0].无此成员 / 调用返回链
//   取点().无此成员 → 「[ir2] 成员字段偏移未知」+ 中止；③#648 静默兜底已废除，
//   IR 侧 miss 恒为显式内部错误即中止（无「静默放行」通路）。语义阶段只做
//   存在性复判、不新增拒绝面；且 636_嵌套初始化器未知字段负测 冻结 v2 该形态
//   拒因签名=上述 [ir2] 行（既有 .expected 禁擅改）——语义层抢先报即契约漂移。
//   对象=标识符 的结构体/联合体面（变量/参数/指针剥星）保持原语义层报法不变。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量
导入 IR;         // 是容器类_ID/是结果类型_ID/是可选类型_ID/是手动释放类型/是枚举名/
                 // 查枚举成员值/是接口名ID/查接口方法槽/查类节点索引/查结构体类型/
                 // 查字段类型ID/是标量类型文本/查泛型基类参数序/是容器基名
导入 协议常量;   // 驻留/驻留文本（中立层）

公开:   // 全文件公开（供 语义检查 包内兄弟经合并全局池消费）

// #1951 诊断显示辅助（#1741 拒因归一·2026-11-01）：$ 合成名无歧义面重组
//   尖括号源形态（向量$整32 → 向量<整32>）——用户诊断中类型文本对齐宿主
//   源形态显示（k6 探针：宿主「向量<整32>」vs v2 原样合成名）。切分与
//   语义分析中 回查合成名实参1949 同款头感知（容器白名单映射=2 参其余=1/
//   结果=2 可选=1/泛型类=参数名串 ',' 切段数）；歧义面（段数≠实参数·嵌套
//   实参二义）/头名三族不命中/无 '$' =原样返回（禁猜切分）。
函数 合成名显示文本(字符串 合成名) -> 字符串 {
    整64 首元 = 0 - 1;
    整64 i = 0;
    当 (i < 字符串长度(合成名)) {
        如果 (((整64(合成名[整32(i)]) & 255) == 36)) { 首元 = i; 中断; }
        i++;
    }
    如果 (首元 == 0 - 1 || 首元 == 0) { 返回 字符串复制(合成名); }
    字符串 头名 = 字符串子串(合成名, 0, 整32(首元));
    字符串 余段 = 字符串子串(合成名, 整32(首元 + 1),
                           整32(字符串长度(合成名) - 首元 - 1));
    向量<字符串> 段们 = 向量<字符串>();
    整64 段起 = 0;
    整64 j = 0;
    当 (j <= 字符串长度(余段)) {
        布尔 末位j = j == 字符串长度(余段);
        整64 字j = 0 - 1;
        如果 (!末位j) { 字j = 整64(余段[整32(j)]) & 255; }
        如果 (末位j || 字j == 36) {
            结果<空类型, 整32> 加段 = 段们.追加(字符串子串(余段, 整32(段起),
                                        整32(j - 段起)));
            如果 (!加段.正常) { 运行时错误(4); }
            段起 = j + 1;
        }
        j++;
    }
    整64 实参数 = 0 - 1;
    布尔 头容器 = 是容器基名(头名);
    布尔 头映射 = 字符串比较(头名, "映射");
    布尔 头结果 = 字符串比较(头名, "结果");
    布尔 头可选 = 字符串比较(头名, "可选");
    如果 (头映射) { 实参数 = 2; }
    如果 (头容器 && 头映射 == 假) { 实参数 = 1; }
    如果 (头结果) { 实参数 = 2; }
    如果 (头可选) { 实参数 = 1; }
    如果 (头容器 == 假 && 头结果 == 假 && 头可选 == 假) {
        可选<整64> 序查 = 查泛型基类参数序(驻留(头名));
        如果 (序查.有值) {
            字符串 序串 = 字符串复制(驻留文本(序查.值));
            实参数 = 1;
            整64 k = 0;
            当 (k < 字符串长度(序串)) {
                如果 (((整64(序串[整32(k)]) & 255) == 44)) { 实参数++; }
                k++;
            }
        }
    }
    布尔 无歧义 = 实参数 != 0 - 1 && 实参数 != 0 &&
                  整64(段们.大小()) == 实参数;
    如果 (无歧义 == 假) {
        返回 字符串复制(合成名);   // 歧义面/头未知=原样（禁猜切分）
    }
    字符串 重组 = 头名 + "<";
    整64 m = 0;
    当 (m < 整64(段们.大小())) {
        如果 (m != 0) { 重组 = 重组 + ", "; }
        重组 = 重组 + 字符串复制(段们.元素(整32(m)));
        m++;
    }
    返回 重组 + ">";
}

// #1951：成员存在性检查单点（细则/豁免面见文件头）——
//   消费=语义检查.cn 检查成员访问表达式（n=成员节点·读/写两态公共面）。
// #2011（1103 采样轮·v2 末端成员存在性校验根治）：对象类型面扩展——
//   原仅「对象=标识符」可查位，成员链/下标/调用对象形态整体落到 IR 层
//   [ir2]/查字段宽度码内部 #648 通道；而 可选/结果 链形态更因
//   推导语义成员链类型 对合成体短路（甲.值 类型不可推导）而**静默放行**
//   （p01/p02/p03 实测 rc=0 落盘产物=安全红线）。现：
//   ①对象=标识符 → 符号表类型；其余形态（成员链/下标/调用/解引用）→
//     守卫对象类型ID（纯推导零诊断·无值=不可推导=不判·检不出≠检错）；
//   ②按接收者类型分族报宿主逐字文案（宿主 semantic_expr_access.cpp
//     visitMemberExpr 分支序）：结果/可选 →「结果/可选 类型没有成员 'X'」；
//     手动释放 → 专属文案；枚举（标识符对象）→「枚举 'X' 没有成员 'Y'」；
//     用户类 →「类 'X' 没有成员 'Y'」；接口 →「接口 'X' 没有成员 'Y'」；
//     结构体/联合体 →「结构体 'X' 没有成员 'Y'」；其余（标量/数组/容器
//     合成名/函数指针等）→「类型 'X' 不是结构体/联合体/类类型，无法访问
//     成员 'Y'」；
//   ③被调位（对象.方法(...)）豁免**前置**到对象形态无关——方法面由 907/
//     容器方法/接口通道承担（链式对象方法调用 甲.值.大小() 正例不误报）；
//   ④指针尾星面不在此兜底报（多级指针专属文案归 615 通道·防双报）。
函数 检查成员存在(向量<节点> 池, 整32 节点索引,
                  向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    节点 n = 池.元素(节点索引);
    如果 (n.子起点 != 0 - 1 && 整64(n.子起点) < 池.大小()) {
        节点 声明对象节点 = 池.元素(整32(n.子起点));
        布尔 被调位命中 = 假;
        // 被调位判定=成员池位后窗内「节点_调用 且 子起点==本成员索引」——
        //   语句位直调（对象.方法(...)）调用节点紧随成员后（894 同款 +1 判据）；
        //   嵌套实参位（打印(对象.方法(...))）成员后隔实参区间才是内层调用
        //   节点（k3 探针 +1 判据漏豁免=907 通道双报实录）→ 窗 64 池位扫描。
        //   子起点==本成员索引 的调用=被调唯一指向本成员（恒正确无误豁免）。
        整64 扫描窗位 = 整64(节点索引) + 1;
        整64 窗尾界 = 整64(节点索引) + 64;
        如果 (窗尾界 > 整64(池.大小())) { 窗尾界 = 整64(池.大小()); }
        当 (!被调位命中 && 扫描窗位 < 窗尾界) {
            节点 窗内节点 = 池.元素(整32(扫描窗位));
            如果 (窗内节点.类型 == 节点_调用 &&
                整64(窗内节点.子起点) == 整64(节点索引)) {
                被调位命中 = 真;
            }
            扫描窗位++;
        }
        如果 (!被调位命中) {
            布尔 对象是标识符 = 声明对象节点.类型 == 节点_标识符;
            // 接收者类型面：标识符对象查符号表类型登记；成员链/下标/调用/解引用
            //   对象走 守卫对象类型ID 纯推导（零诊断）；两路均以 可选 透传接收者
            //   类型（无值=本层不知类型：未声明标识符已由上游诊断；泛型占位/
            //   待实例化/布局未登记面见 ⑦⑧ 段证据）→ 本层不判，IR 布局层判定。
            如果 (对象是标识符) {
                可选<整64> 标识符类型查 = 表查找类型ID(符号表, 整64(声明对象节点.文本));
                如果 (标识符类型查.有值) {
                    成员存在判族(池, n, 标识符类型查.值, 对象是标识符, 诊断);
                }
            }
            如果 (!对象是标识符) {
                可选<整64> 链类型查 = 守卫对象类型ID(池, 整32(n.子起点), 符号表);
                如果 (链类型查.有值) {
                    成员存在判族(池, n, 链类型查.值, 对象是标识符, 诊断);
                }
            }
        }
    }
}

// 接收者类型判族入口（#2011 单点）——剥指针尾星一级后交 成员存在分族：
//   入参 类型ID 经 可选 透传（调用方已证有值·无哨兵默认值通路）。
//   0=空类型/无类型占位（表查找类型ID 输出契约的合法登记值）：空类型接收者
//   成员访问实跑证据=IR「[ir2] 成员字段偏移未知」+ 退出码 1 中止（w01 探针·
//   本层无类型名文本可报，故不入分族）。
函数 成员存在判族(向量<节点> 池, 节点 n, 整64 类型ID,
                  布尔 对象是标识符, 向量<字符串>& 诊断) -> 空类型 {
    整64 接收者类型 = 成员方法剥星(类型ID);
    如果 (接收者类型 != 0) {
        成员存在分族(池, n, 接收者类型, 对象是标识符, 诊断);
    }
}

// 成员存在性分族（#2011 单点·宿主 visitMemberExpr 类型分支序逐族对齐）：
//   接收者类型=已剥指针尾星一层的类型名 ID（合法域 >0·调用方保证）。
//   每族命中即判定并返回（族间互斥：结果/可选 合成体不入类/结构体表；
//   枚举名不入用户类表）；末族=可分类面文案（容器合成名/标量）。
//   结构体/联合体族按对象形态分流：标识符对象=语义层报；链/下标/调用/解引用
//   对象=交 IR #648 通道（显式内部错误即中止·636 冻结该形态拒因签名）。
//   指针尾星形态不在末族报（多级指针专属文案归 615·防双报）。
函数 成员存在分族(向量<节点> 池, 节点 n, 整64 接收者类型,
                  布尔 对象是标识符, 向量<字符串>& 诊断) -> 空类型 {
    字符串 成员名p = 字符串复制(驻留文本(整64(n.文本)));
    字符串 接收者文本 = 字符串复制(驻留文本(接收者类型));
    // ①结果/可选（宿主 Task 3.5 规则2/3 成员集：结果={正常,值,错误}·可选={有值,值}）
    如果 (是结果类型_ID(接收者类型)) {
        布尔 可选族 = 是可选类型_ID(接收者类型);
        布尔 合法成员 = 字符串比较(成员名p, "值");
        如果 (!可选族 && 字符串比较(成员名p, "正常")) { 合法成员 = 真; }
        如果 (!可选族 && 字符串比较(成员名p, "错误")) { 合法成员 = 真; }
        如果 (可选族 && 字符串比较(成员名p, "有值")) { 合法成员 = 真; }
        如果 (合法成员 == 假) {
            表诊断(诊断, "[错误] 结果/可选 类型没有成员 '" + 成员名p + "'");
        }
        返回;
    }
    // ②手动释放<T>（宿主 manuallyDroppedPayloadOf 分支·透明单载荷唯一成员 .值）
    如果 (是手动释放类型(接收者文本)) {
        如果 (!字符串比较(成员名p, "值")) {
            表诊断(诊断, "[错误] 手动释放<T> 类型只有成员 '值'（透明单载荷）：没有成员 '" +
                         成员名p + "'");
        }
        返回;
    }
    // ③枚举值引用（宿主 isEnumType 分支·仅 枚举名.成员 标识符对象形态——
    //   变量.枚举成员 同面走此判定；链式对象二进制文本不解析枚举名）
    布尔 枚举命中 = 对象是标识符 && 是枚举名(接收者类型);
    如果 (枚举命中) {
        结果<整64, 整32> 枚值查 = 查枚举成员值(接收者类型, 整64(n.文本));
        如果 (!枚值查.正常) {
            表诊断(诊断, "[错误] 枚举 '" + 接收者文本 +
                          "' 没有成员 '" + 成员名p + "'");
        }
        返回;
    }
    // ④用户类（宿主 findClass 分支·字段表+方法表双 miss 报「没有成员」）
    如果 (查类节点索引(接收者类型).有值) {
        布尔 字段命中 = 查类字段沿链(池, 接收者类型, 整64(n.文本));
        布尔 方法命中 = 查类方法节点沿链(池, 接收者类型, 整64(n.文本)).有值;
        如果 (字段命中 == 假 && 方法命中 == 假) {
            表诊断(诊断, "[错误] 类 '" + 接收者文本 +
                          "' 没有成员 '" + 成员名p + "'");
        }
        返回;
    }
    // ⑤接口（宿主 findInterface 分支·接口无字段=方法槽存在性判定）
    如果 (是接口名ID(接收者类型)) {
        如果 (查接口方法槽(接收者类型, 整64(n.文本)).有值 == 假) {
            表诊断(诊断, "[错误] 接口 '" + 接收者文本 +
                          "' 没有成员 '" + 成员名p + "'");
        }
        返回;
    }
    // ⑥结构体/联合体（宿主 findStruct 分支·字段存在性）——对象形态分流：
    //   对象=标识符（变量/参数/指针变量剥星）→ 语义层报（#1951 既有面·k1/k5/k6
    //   实证）；对象=成员链/下标/调用/解引用 → 交 IR 布局层 #648 通道（写=
    //   [ir2] 成员左值字段偏移未知 / 读=[ir2] 成员字段偏移未知·均显式内部错误
    //   即中止；636 冻结该形态拒因签名·细则见文件头 #2011 返工段）。
    可选<整64> 父结构键基查 = 查结构体类型(接收者类型);
    如果 (父结构键基查.有值) {
        如果 (对象是标识符) {
            可选<整64> 字段类型查 = 查字段类型ID(父结构键基查.值, 整64(n.文本));
            如果 (字段类型查.有值 == 假) {
                表诊断(诊断, "[错误] 结构体 '" + 接收者文本 +
                              "' 没有成员 '" + 成员名p + "'");
            }
        }
        返回;
    }
    // ⑦泛型实例合成名（盒子$整32=盒子<整32>）：语义检查阶段实例未登记类/结构体表
    //   （两表在 IR 生成期实例化扫描才登记·#1629 同注）——成员存在性移交 IR 层
    //   精确判定（修前本形态落入末族=把泛型参数化类型当标量误报，1726 实测回归）。
    //   容器实例（向量$整32）不在此列——容器对象成员访问宿主报末族文案（上文已判）。
    //   证据（v2p 实跑）：盒子<整32> 甲; 甲.无此成员 → 「[内部错误] 字段宽度码·
    //   字段未登记 '无此成员'」+「[ir2] 成员字段偏移未知: .无此成员」+ 退出码 1
    //   中止；同族正例 甲.内容 → rc=0（无误报）。
    字符串 基名实例 = 合成名基名(接收者文本);
    布尔 实例形态 = 字符串长度(基名实例) != 0 &&
                     !字符串比较(基名实例, 接收者文本);
    如果 (实例形态 && !是容器类_ID(接收者类型)) {
        布尔 基名类命中 = 查类节点索引(驻留(基名实例)).有值;
        布尔 基名结构命中 = 查结构体类型(驻留(基名实例)).有值;
        如果 (基名类命中 || 基名结构命中) { 返回; }
    }
    // ⑧末族（仅**可分类**面）：容器实例合成名与基本标量类型 → 宿主同文案
    //   「类型 'X' 不是结构体/联合体/类类型，无法访问成员 'Y'」。其余类型文本
    //   （泛型参数占位 T/数组类型文本/函数指针/本阶段声明表未登记名）不在此报。
    //   证据（v2p 实跑·均为显式内部错误即中止，非静默放行）：
    //   ①泛型参数接收者（泛型类内 内容.无此成员·T 待实例化）→「[ir2] 成员字段
    //     偏移未知」+ 中止——001 泛型单态化语义下成员集在实例化点才确定，语义
    //     阶段对 T 判存在性无定义（u02 实跑）；
    //   ②数组类型文本（整32[4] 数组; 数组.无此成员）→ 同款 [ir2] 中止（u01）；
    //   ③不可分类名（语义阶段声明表未见）→ IR 布局表按全量声明精确判定，miss
    //     即「[ir2] 成员字段偏移未知」中止；#648 静默兜底已废除，IR 无静默通路。
    //   无差别报会误伤 v2 自举 1.3 万条合法跨包/泛型成员访问（T/合成名/跨包名
    //   均落此面）——可报告面收窄为语义阶段可判定的标量/容器白名单。
    布尔 容器兜底 = 是容器类_ID(接收者类型);
    布尔 标量兜底 = 是标量类型文本(接收者文本);
    字符串 显示文本 = 合成名显示文本(接收者文本);
    整64 显示长 = 字符串长度(接收者文本);
    布尔 尾星 = 显示长 != 0 && ((整64(接收者文本[整32(显示长 - 1)]) & 255) == 42);
    如果 ((容器兜底 || 标量兜底) && !尾星) {
        表诊断(诊断, "[错误] 类型 '" + 显示文本 +
                      "' 不是结构体/联合体/类类型，无法访问成员 '" + 成员名p + "'");
    }
}
