// 语义检查表达式中（357 重构F2 自 语义检查表达式.cn 纯机械搬移·函数体逐字保留·零逻辑变化）

导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（目录包名）
导入 IR;         // 容器/结果 合成名判定（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// ==================== 491（语义检查表达式.cn 900 行警戒线拆分搬入·置头部） ====================
// 「装箱语境 + 构造器期望类型族」——自 语义检查表达式.cn 纯机械搬移（函数体
//   逐字保留·零逻辑变化；本文件内 检查构造器调用 消费 取装箱语境884/
//   实参位期望类型894——「同文件后置定义失效」570 轮实录约束=须置消费点前，
//   故整族置本文件头部）。消费方清单：检查调用表达式/检查构造器调用/检查语句
//   返回分支（设装箱语境884·复位）/检查赋值语句（元素/字段语境）/检查表达式
//   泛型隐式推导（构造器自然类型570·表达式尾）——全部同包经合并全局池解析。
// 71-a（2026-09-11 方案A 用户裁决）：内置构造器 正常/错误/某些（规范 07-五，
//   编译器预置、用户不可重定义）的装箱语境类型ID——返回位（检查语句 返回语句
//   分支：当前函数返回类型）与声明位（检查变量声明语句：声明目标类型）由检查
//   方设置，区间检查后复位；检查调用表达式 构造器分支读取并写入调用节点.子终点
//   （节点_调用 解析期子终点恒 0=空闲——字段访问「子终点=对象类型ID」预标注
//   同款模式），IR 生成调用 构造器特判直读（语义驱动 IR 同构）。
// 203-a（2026-09-15 第两百零三轮，D1 行数整改）：被调文本分派骨架——构造器/裸释放/
//   转移/签名键回退 四段提取为族方法（程序化切片+双名单差集审计+单文件快验）；
//   装箱语境类型ID 为本文件静态（族① 直接访问）；签名键回退失败以 -1 哨兵返回主函数
//   继续内置/限定/未声明链（与原落空语义等价）。
// 884-a（070·G-N·537）：装箱语境经**映射承载**（键 0）——原「静态 整64」直接
//   赋值受安全区边界（静态变量写须在 不安全 函数内）限制，导致**安全函数**
//   （检查赋值语句·下标赋值位语境）无法设置；映射承载（865 同款先例）——916
//   起方法调用写同样受 §747-8 执法（映射 设置 属写方法白名单），设装箱语境884
//   已随 916 合法化标 不安全（映射承载保留·键 0 槽语义不变）。
静态 映射<整64, 整64> 装箱语境映射884;

不安全 函数 设装箱语境884(整64 类型ID) -> 空类型 {
    结果<空类型, 整32> 设884 = 装箱语境映射884.设置(0, 类型ID);
    如果 (!设884.正常) { 运行时错误(4); }
}

函数 取装箱语境884() -> 整64 {
    结果<整64, 整32> 取884 = 装箱语境映射884.获取(0);
    如果 (取884.正常) { 返回 取884.值; } 否则 { 返回 0; }
}

// 570（894 参数正扫提取归一）：函数定义的末形参类型文本 ID——参数区间正扫
//   （子起点起连续 节点_类型/节点_参数 对·遇首个语句节点停——单语句体不入块
//   直接续排〔t6 实测·子终点-1 可为返回语句〕，倒取不可靠）：末 节点_参数 的
//   附加=类型节点索引。**勿用 基函数形参类型们（415 设施）**——其参数终点判定
//   「池.元素(子终点).子起点」在体非空布局取错区间（935 判别3 实锤：体空绿/
//   体有 返回 值; 即红）。**定义置于消费点（894/泛型函数实参期望类型570）之前**
//   ——570 轮实测：同文件**后置**定义的函数取返回值调用失效（894→函数末形参
//   类型ID570·894→泛型函数实参期望类型570·570→构造器自然类型570 三案实录·
//   立案 762 核查），本包内新函数一律先定义后消费。返回 0=无末形参。
函数 函数末形参类型ID570(向量<节点> 池, 整32 函数节点索引) -> 整64 {
    节点 函570 = 池.元素(函数节点索引);
    整64 末参索引570 = 0 - 1;
    整64 扫参570 = 整64(函570.子起点);
    当 (扫参570 < 整64(函570.子终点)) {
        节点 参段570 = 池.元素(整32(扫参570));
        如果 (参段570.类型 == 节点_参数) {
            末参索引570 = 扫参570;
        } 否则 如果 (参段570.类型 != 节点_类型) {
            中断;   // 首个非〔类型/参数〕节点=体语句起点
        }
        扫参570++;
    }
    如果 (末参索引570 >= 整64(函570.子起点)) {
        节点 末参570 = 池.元素(整32(末参索引570));
        如果 (末参570.附加 > 0 &&
             末参570.附加 < 整64(池.大小())) {
            节点 类型节点570 = 池.元素(整32(末参570.附加));
            返回 整64(类型节点570.文本);
        }
    }
    返回 0;
}

// 570：内置构造器自然类型推导（某些/正常/错误·宿主 checkBuiltinCtorCall 无语境
//   自然推导同构：某些(v)=可选<typeof(v)>·正常(v)=结果<typeof(v),整32>·
//   错误(v)=结果<整32,typeof(v)>——缺省位=宿主 整32 同款；正常() 无参载荷=
//   空类型）。构造器节点=索引 i；载荷根=i-1（紧邻后缀池布局·890/894 覆盖段
//   同款）。载荷可靠面=字面量/标识符（415 同哲学——嵌套调用等复杂形态返回 0=
//   不猜测）。类型文本=$ 合成形（解析层 解析类型文本 同款）。消费方=415
//   泛型隐式推导改写（实参=构造器调用的类型推导面·语义检查表达式尾·跨文件
//   前置合法）；泛型函数实参期望类型570 内同判据内联（同文件前置纪律·见
//   函数末形参类型ID570 头注）。返回 0=不可推导。
函数 构造器自然类型570(向量<节点> 池, 整32 节点索引,
                   向量<映射<整64, 符号>>& 符号表) -> 整64 {
    如果 (整64(节点索引) <= 0) { 返回 0; }
    节点 自身570 = 池.元素(节点索引);
    如果 (自身570.子起点 <= 0) { 返回 0; }
    字符串 构造器名570 = 字符串复制(
        驻留文本(整64(池.元素(整32(自身570.子起点)).文本)));
    如果 (!字符串比较(构造器名570, "某些") &&
         !字符串比较(构造器名570, "正常") &&
         !字符串比较(构造器名570, "错误")) { 返回 0; }
    // 载荷类型推导（字面量/标识符可靠面）
    字符串 载荷570 = "";
    整64 实参数570 = 整64(自身570.附加);
    如果 (实参数570 == 1 && 整64(节点索引) > 0) {
        节点 载荷根570 = 池.元素(节点索引 - 1);
        如果 (载荷根570.类型 == 节点_整数字面量) {
            载荷570 = 字符串复制("整32");
        } 否则 如果 (载荷根570.类型 == 节点_浮点字面量) {
            载荷570 = 字符串复制("浮64");
        } 否则 如果 (载荷根570.类型 == 节点_字符串字面量) {
            载荷570 = 字符串复制("字符串");
        } 否则 如果 (载荷根570.类型 == 节点_标识符) {
            整64 载荷类型570 = 0;
            可选<整64> 载荷类型570查 = 表查找类型ID(符号表, 整64(载荷根570.文本));
            // miss 保持 0（下方 >0 判定与原 -1 哨兵同假·880 批5）
            如果 (载荷类型570查.有值) { 载荷类型570 = 载荷类型570查.值; }
            如果 (载荷类型570 > 0) {
                载荷570 = 字符串复制(驻留文本(载荷类型570));
            }
        }
    } 否则 如果 (实参数570 == 0) {
        载荷570 = 字符串复制("空类型");   // 正常() 无参形态（宿主同款）
    }
    如果 (字符串长度(载荷570) == 0) { 返回 0; }   // 不可靠面=放弃（415 同哲学）
    // 自然类型合成（$ 形）
    字符串 期望570 = "";
    如果 (字符串比较(构造器名570, "某些")) {
        期望570 = 字符串复制("可选$" + 载荷570);
    } 否则 如果 (字符串比较(构造器名570, "正常")) {
        期望570 = 字符串复制("结果$" + 载荷570 + "$整32");
    } 否则 如果 (字符串比较(构造器名570, "错误")) {
        期望570 = 字符串复制("结果$整32$" + 载荷570);
    }
    如果 (字符串长度(期望570) == 0) { 返回 0; }
    返回 整64(驻留(期望570));
}

// 570（106 函数支路清偿）：泛型函数实参位构造器期望类型——构造器节点（索引 i）
//   为紧邻后继调用根（i+1）的实参、被调=裸名泛型函数（417-a 参数序表·函数名
//   ID 键）且末形参剥 */& 后=泛型参数名 → 按构造器**自然类型**回取期望（宿主
//   checkBuiltinCtorCall 无语境自然推导同构）。类型文本=$ 合成形（解析层
//   解析类型文本 同款·IR 生成装箱构造 按合成名切段消费）。106 已修成员方法面
//   （成员方法期望类型106·替换源=对象实例），本函数=自由函数面（无对象实例·
//   替换源=实参自身自然推导·载荷推导与 构造器自然类型570 同判据内联——同文件
//   前置纪律见 函数末形参类型ID570 头注）。**定义置于消费点 894 之前**。
// 返回 0=未取。
函数 泛型函数实参期望类型570(向量<节点> 池, 整32 节点索引,
                        向量<映射<整64, 符号>>& 符号表) -> 整64 {
    如果 (整64(节点索引) + 1 >= 整64(池.大小()) || 整64(节点索引) <= 0) { 返回 0; }
    节点 自身570 = 池.元素(节点索引);
    节点 后继570 = 池.元素(节点索引 + 1);
    如果 (后继570.类型 != 节点_调用 || 后继570.子起点 <= 0) { 返回 0; }
    节点 被调570 = 池.元素(整32(后继570.子起点));
    如果 (被调570.类型 != 节点_标识符) { 返回 0; }
    字符串 被调文本570 = 字符串复制(驻留文本(整64(被调570.文本)));
    // 570（415 内联改写共存面）：被调=裸名或**实例合成名**（检查调用表达式 731
    //   的 415 隐式推导改写先于区间遍历构造器检查·改写产物含 $ 段）一律剥实例
    //   基名取纯名——回取对基函数定义进行，两形态同链成立（显式 419-a 形态的
    //   末形参替换后仍=T·自然类型=实例实参·判据自洽）。
    字符串 纯名570 = 剥实例基名(被调文本570);
    如果 (字符串长度(纯名570) == 0) { 返回 0; }
    整64 序ID570 = 查泛型基类参数序(整64(驻留(纯名570)));
    如果 (序ID570 == 0) { 返回 0; }
    // 基函数定位（全池扫·同名唯一——894 同构）
    整32 基函数索引570 = 0 - 1;
    整64 扫f570 = 0;
    当 (扫f570 < 整64(池.大小())) {
        节点 函f570 = 池.元素(整32(扫f570));
        如果 (函f570.类型 == 节点_函数 &&
             整64(函f570.文本) == 整64(驻留(纯名570)) &&
             函f570.子起点 < 函f570.子终点) {
            基函数索引570 = 整32(扫f570);
            中断;
        }
        扫f570++;
    }
    如果 (基函数索引570 == 0 - 1) { 返回 0; }
    // 末形参类型（函数末形参类型ID570 正扫·勿用 基函数形参类型们——体非空
    //   布局区间判定错位·见该函数头注释 935 判别3 实锤）
    整64 末形参ID570 = 函数末形参类型ID570(池, 基函数索引570);
    如果 (末形参ID570 <= 0) { 返回 0; }
    字符串 末形参基570 = 字符串复制(驻留文本(末形参ID570));
    当 (字符串长度(末形参基570) > 0) {
        整64 尾码570 = 整64(末形参基570[整32(字符串长度(末形参基570) - 1)]) & 255;
        如果 (尾码570 == 42 || 尾码570 == 38) {
            末形参基570 = 字符串子串(末形参基570, 0, 整32(字符串长度(末形参基570) - 1));
        } 否则 { 中断; }
    }
    如果 (!是泛型参数名(整64(驻留(末形参基570)))) { 返回 0; }
    // 载荷推导+自然类型合成（构造器自然类型570 同判据内联——同文件前置纪律）
    如果 (自身570.子起点 <= 0) { 返回 0; }
    字符串 构造器名570 = 字符串复制(
        驻留文本(整64(池.元素(整32(自身570.子起点)).文本)));
    字符串 载荷570 = "";
    整64 实参数570 = 整64(自身570.附加);
    如果 (实参数570 == 1 && 整64(节点索引) > 0) {
        节点 载荷根570 = 池.元素(节点索引 - 1);
        如果 (载荷根570.类型 == 节点_整数字面量) {
            载荷570 = 字符串复制("整32");
        } 否则 如果 (载荷根570.类型 == 节点_浮点字面量) {
            载荷570 = 字符串复制("浮64");
        } 否则 如果 (载荷根570.类型 == 节点_字符串字面量) {
            载荷570 = 字符串复制("字符串");
        } 否则 如果 (载荷根570.类型 == 节点_标识符) {
            整64 载荷类型570 = 0;
            可选<整64> 载荷类型570查 = 表查找类型ID(符号表, 整64(载荷根570.文本));
            // miss 保持 0（下方 >0 判定与原 -1 哨兵同假·880 批5）
            如果 (载荷类型570查.有值) { 载荷类型570 = 载荷类型570查.值; }
            如果 (载荷类型570 > 0) {
                载荷570 = 字符串复制(驻留文本(载荷类型570));
            }
        }
    } 否则 如果 (实参数570 == 0) {
        载荷570 = 字符串复制("空类型");   // 正常() 无参形态（宿主同款）
    }
    如果 (字符串长度(载荷570) == 0) { 返回 0; }   // 不可靠面=放弃（415 同哲学）
    字符串 期望570 = "";
    如果 (字符串比较(构造器名570, "某些")) {
        期望570 = 字符串复制("可选$" + 载荷570);
    } 否则 如果 (字符串比较(构造器名570, "正常")) {
        期望570 = 字符串复制("结果$" + 载荷570 + "$整32");
    } 否则 如果 (字符串比较(构造器名570, "错误")) {
        期望570 = 字符串复制("结果$整32$" + 载荷570);
    }
    如果 (字符串长度(期望570) == 0) { 返回 0; }
    返回 整64(驻留(期望570));
}

// 894-a（070·G-N 特性波3）：实参位期望回取——构造器节点（索引 i）为紧邻
//   后继调用根（i+1）的末实参（池布局惯例：末实参根=调用节点-1）且被调为
//   普通函数（被调节点=标识符）→ 全池扫描该函数定义取末形参类型 ID；末形参
//   非 结果/可选 返回 0。Rust 对照=期望类型下推（Expectation::ExpectHasType
//   (形参)）的**实参侧实现**——语义线性遍历内层构造器先于外层调用根（884-a
//   幂等复用的姊妹时机），外层设语境来不及、由内层自取期望；外层调用根随后
//   的 890/894 覆盖段仍修正「语境已设但类型非末形参」形态（声明位语境兜底面）。
//   成员方法面（被调=成员·容器实例）已有 890 外层覆盖+声明位语境兜底；
//   无语境成员面（`obj.方法(正常(x))` 裸语句）原登记诚实边界（无存量用例）。
//   106（890 残余·泛型方法实参面清偿）：②成员方法支路补齐——被调=成员
//   （对象为标识符）时经 成员方法期望类型106（类定义池扫 + 类头类型参数序
//   实例替换 + 末顶层参数段·415 泛型基础设施）回取期望类型。宿主对照
//   （D14/H2/H3 全绿）：实参位构造器按期望类型下推，不要求声明位语境。
函数 实参位期望类型894(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表) -> 整64 {
    如果 (整64(节点索引) + 1 >= 整64(池.大小())) { 返回 0; }
    节点 后继894 = 池.元素(节点索引 + 1);
    如果 (后继894.类型 != 节点_调用 || 后继894.子起点 <= 0) { 返回 0; }
    节点 后继被调894 = 池.元素(整32(后继894.子起点));
    // 106：成员方法面（对象.方法(构造器)——原诚实边界清偿）
    如果 (后继被调894.类型 == 节点_成员) {
        返回 成员方法期望类型106(池, 后继被调894, 符号表);
    }
    如果 (后继被调894.类型 != 节点_标识符) { 返回 0; }
    // 570（415 内联改写共存面）：被调文本可能已是**实例合成名**（名$实参——
    //   检查调用表达式 731 的 415 隐式推导改写先于区间遍历的构造器检查·改写
    //   产物被调文本含 $ 段）——匹配键一律剥实例基名（裸名剥回自身·与 570
    //   内部同款）；包装$可选$整32 的回取=对基函数「包装」取末形参 T 判泛型。
    字符串 后继被调文本894 = 剥实例基名(字符串复制(
        驻留文本(整64(后继被调894.文本))));
    // 全池扫描函数定义（池=解析完成全树·无前向引用限制；CN 无重载·同名唯一）
    整64 扫894 = 0;
    当 (扫894 < 整64(池.大小())) {
        节点 函894 = 池.元素(整32(扫894));
        如果 (函894.类型 == 节点_函数 &&
             整64(函894.文本) == 整64(驻留(后继被调文本894)) &&
             函894.子起点 < 函894.子终点) {
            // 末形参类型（570 归一：894 参数正扫提取公共函数·单一实现）
            整64 类型ID894 = 函数末形参类型ID570(池, 整32(扫894));
            如果 (类型ID894 > 0 && 是结果类型_ID(类型ID894)) { 返回 类型ID894; }
            // 570（106 函数支路清偿·H3 泛型函数实参位构造器）：末形参=泛型参数
            //   名（泛型函数·417-a 参数序表）→ 构造器自然类型作期望（宿主无语境
            //   自然推导同构）；非泛型函数形态返回 0=维持原拒（回取语义不变）
            整64 泛期望570 = 泛型函数实参期望类型570(池, 节点索引, 符号表);
            如果 (泛期望570 > 0) { 返回 泛期望570; }
            返回 0;
        }
        扫894++;
    }
    返回 0;
}


函数 检查函数指针调用480(向量<节点> 池, 节点 n, 整32 节点索引, 向量<字符串> 诊断,
                      字符串 被调文本, 字符串 类型文本) -> 整64 {
    可选<字符串> 返回查fp480 = 函数指针返回文本(类型文本);
    字符串 返回fp480 = "";
    如果 (返回查fp480.有值) { 返回fp480 = 字符串复制(返回查fp480.值); }
    整64 期望个数480 = 函数指针参数个数(类型文本);
    如果 (整64(n.附加) != 期望个数480) {
        表诊断(诊断, "[错误] 函数指针调用实参个数不匹配: '" + 被调文本 +
                      "'（签名 " + 类型文本 + "）需 " + 整数转字符串(期望个数480) +
                      " 个实参，实给 " + 整数转字符串(整64(n.附加)) + " 个");
    }
    如果 (字符串长度(返回fp480) == 0) {
        // 648：miss 不可静默——函数指针签名返回文本解析为空仍静默整32（110 案
        //   同构·类型标注失真面）。注意本函数 诊断 为按值传参（表诊断进不了
        //   通道）——显形走 IR 包收集表（登记处出诊断行·主收尾统一中止）；
        //   原整32 兜底保留（中止前路径）
        登记内部未登记("函数指针签名返回文本解析为空·签名 " + 类型文本,
                       被调文本, 整64(取当前诊断行()));
        返回 驻留("整32");
    }
    返回 驻留(返回fp480);
}

// 203-a：族① 构造器调用检查（71-a 方案A：正常()/错误()/某些() 合法仅当装箱语境为
//   结果/可选——推导类型写回调用节点.子终点，IR 层构造器特判直读；被调文本=主函数
//   已判定三分支名之一；装箱语境类型ID=本文件静态直接访问）。
// B1（#1360 结果化）：返回 结果<整64, 整32>——正常(类型ID)=装箱语境/标注类型；
//   错误(1)=已诊断错误（实参超限/无语境）。原 -1 哨兵废除。
// 826（067-003）：装箱语境设置辅助——静态变量写须在 不安全 函数内（安全区边界
//   检查）；递归下推的语境保存/恢复经此单点。
不安全 函数 设置装箱语境(整64 语境ID) -> 空类型 {
    设装箱语境884(语境ID);
}

函数 检查构造器调用(向量<节点> 池, 节点 n, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断, 字符串 被调文本) -> 结果<整64, 整32> {
            // 826（067-003 治本·211_v2/543 双满足）：**已修正标注复用**——
            //   标注 == 当前语境 ⇒ 已修正（递归下推后内层标注=载荷语境）或本就
            //   属本层 → 复用；标注 != 语境 ⇒ 尚未修正（如内层先被遍历时按外层
            //   语境标过 可选$可选$盒子）→ 继续，由递归下推覆盖为自身类型。
            如果 (n.子终点 > 0 && 整64(n.子终点) == 取装箱语境884()) {
                返回 正常(整64(n.子终点));
            }
            // 884-a（070·G-N·537 ⑥ 根治）：**已标注 + 无语境 = 幂等复用**——
            //   同一构造器可能被检查两次（如 静态声明初值检查 已按声明类型标注后，
            //   函数体常规遍历再遇），两次之间语境已复位（复位点=初次检查完整结束）
            //   → 原实现落「须用于…语境」误报（537 B 段·插桩序列铁证：设215→3读→
            //   复位→再读=0→报错）。标注=语义层一次性决定（节点属性），重复遍历
            //   不应要求重新推导（Rust 对照：类型标注幂等）。有语境时仍走下方推导/
            //   递归下推（826 语义不变）。
            如果 (n.子终点 > 0 && 取装箱语境884() == 0) {
                返回 正常(整64(n.子终点));
            }
            如果 (n.附加 > 1) {
                表诊断(诊断, "[错误] 构造器 " + 被调文本 + " 至多一个实参");
                返回 错误(1);
            }
            如果 (取装箱语境884() == 0) {
                // 894-a：实参位期望回取（408 u6/探针 t6——`取值(正常(41))`
                //   构造器直接作实参·外层无声明位语境）——回取成功=按末形参
                //   标注（合法·与语境路径同构）；失败维持原拒绝
                //   106：符号表随传（成员方法面对象类型查询需要）
                整64 回取894 = 实参位期望类型894(池, 节点索引, 符号表);
                如果 (回取894 > 0) {
                    n.子终点 = 整32(回取894);
                    结果<空类型, 整32> 设箱回894 = 池.设置(节点索引, n);
                    如果 (!设箱回894.正常) { 运行时错误(4); }
                } 否则 {
                    表诊断(诊断, "[错误] 构造器 " + 被调文本 +
                                 " 须用于 结果/可选 语境（返回位或 结果/可选 变量声明初始化位）");
                    返回 错误(1);
                }
            } 否则 {
                n.子终点 = 整32(取装箱语境884());
                结果<空类型, 整32> 设箱n = 池.设置(节点索引, n);
                如果 (!设箱n.正常) { 运行时错误(4); }
            }
            // 任务 094 v2 同构（2026-09-29·008 树波 4）：装箱 move 实参源禁用——
            //   正常/某些(标识符) 且实参类型=字符串 → 表标记转移（v2 已装箱名模型=
            //   所有权转交装箱值·出口释放跳过；源再赋值会 free 旧句柄=盒内悬垂，
            //   Rust Ok(s)/Some(s) 对 String 即 move·编译期源禁用与宿主
            //   markMovedVar 同判据=T63 对齐·双测负例锚「已转移，不能继续使用」
            //   共用）。错误() 不标记（浅共享既有边界·与宿主 IR 清零限面一致）。
            //   v2 无借用污染名单等价——借用装箱（污染源）后用源在宿主为合法
            //   （q1/q3 锚定），v2 首版一律标记；该形态 v2 树存量零暴露（全量
            //   验证兜底），污染名单同构随 008 波 4 v2 侧轮次补齐。
            如果 ((字符串比较(被调文本, "正常") || 字符串比较(被调文本, "某些")) &&
                  n.附加 == 1 && 整64(节点索引) > 0) {
                节点 箱实参n = 池.元素(节点索引 - 1);
                如果 (箱实参n.类型 == 节点_标识符) {
                    整64 箱实参类型 = 0;
                    可选<整64> 箱实参类型查 = 表查找类型ID(符号表, 整64(箱实参n.文本));
                    // miss 保持 0（下方 >0 判定与原 -1 哨兵同假·880 批5）
                    如果 (箱实参类型查.有值) { 箱实参类型 = 箱实参类型查.值; }
                    如果 (箱实参类型 > 0 && 字符串比较(驻留文本(箱实参类型), "字符串") &&
                          表查已转移(符号表, 整64(箱实参n.文本)) == 0) {
                        表标记转移(符号表, 整64(箱实参n.文本), 1);
                    }
                }
            }
            // 107→182（1019 裁决·asm 对位证伪撤销）：类值装箱 LUE 标记**撤除**
            //   ——1018 初版依据「宿主 551 s 形态=move 不析构」实施，asm 精确
            //   对位证伪：宿主 s=深拷+正常析构（call@531+delete@535·输出第 5 行）
            //   初判的「s 不析构」实为 r 盒无析构面的缺位错账。宿主模型=889 恒
            //   深拷+源照常析构（019 第一句）·无类值 LUE——v2 同构撤标记，某
            //   些(s) 恢复深拷+源析构（盒亡面由 182 变量级名单双侧闭环）。字符
            //   串实参维持 094 转移标记既有通道。
            // 826（067-003 治本）：**递归下推**——实参若为构造器调用，其自身类型
            //   = 本层语境的**载荷**（可选$T→T；结果$T$E→T），递归标注。原实现
            //   把嵌套内层一并标成外层语境（可选$可选$盒子）→ IR 层载荷判成
            //   结果类型 → CopyStruct 16B（543/546 fault=5 崩）。AST 后缀式：
            //   实参位 = 节点索引-1。语境经静态保存/恢复传递。
            如果 (n.附加 == 1 && 整64(节点索引) > 1) {
                节点 实参n = 池.元素(节点索引 - 1);
                如果 (实参n.类型 == 节点_调用 && 整64(实参n.子起点) > 0) {
                    字符串 实参被调 = 字符串复制(
                        驻留文本(整64(池.元素(整32(实参n.子起点)).文本)));
                    如果 (字符串比较(实参被调, "正常") || 字符串比较(实参被调, "错误") ||
                         字符串比较(实参被调, "某些")) {
                        字符串 语境名 = 字符串复制(驻留文本(取装箱语境884()));
                        字符串 语境载荷 = 合成名首实参(语境名);
                        如果 (字符串比较(合成名基名(语境名), "结果")) {
                            // 结果$T$E → T = 首实参**去尾段**（尾 `$` 后为 E；
                            //   T 自身含 `$` 时（结果$结果$整32$整32$整32）段首
                            //   只取到「结果」——结果嵌套 543 ④ 实证）。
                            字符串 首段3 = 语境载荷;
                            整64 长3 = 字符串长度(首段3);
                            整64 尾刀3 = 0 - 1;
                            整64 扫3 = 0;
                            当 (扫3 < 长3) {
                                如果 ((整64(首段3[扫3]) & 255) == 36) { 尾刀3 = 扫3; }
                                扫3++;
                            }
                            如果 (尾刀3 > 0) {
                                语境载荷 = 字符串子串(首段3, 0, 整32(尾刀3));
                            }
                        }
                        如果 (字符串长度(语境载荷) > 0) {
                            整64 旧语境 = 取装箱语境884();
                            设置装箱语境(驻留(语境载荷));
                            节点 实参n2 = 池.元素(节点索引 - 1);
                            // B1（#1360 结果化）：自递归返回值按 .正常 消费——
                            //   内层失败=已诊断（实参超限/无语境），上层不再以
                            //   语境值伪装成功，透传 错误(1)（诊断不重复）
                            结果<整64, 整32> 内层果826 = 检查构造器调用(
                                池, 实参n2, 节点索引 - 1, 符号表, 诊断, 实参被调);
                            设置装箱语境(旧语境);
                            如果 (!内层果826.正常) {
                                返回 错误(1);
                            }
                        }
                    }
                }
            }
            返回 正常(取装箱语境884());
}

// B1（#1360 结果化）：检查构造器调用 整64 旧出口适配——语义检查表达式.cn
//   调用点（1000 行冻结点禁新增行）的解包单点：正常→类型ID；错误(1)=已诊断
//   错误→原 -1 哨兵出口（调用方诊断/返回语义逐点等价）。
函数 检查构造器调用旧出口203(向量<节点> 池, 节点 n, 整32 节点索引,
                            向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断,
                            字符串 被调文本) -> 整64 {
    结果<整64, 整32> 构造果203 = 检查构造器调用(池, n, 节点索引, 符号表, 诊断, 被调文本);
    如果 (构造果203.正常) {
        整64 构造型203 = 构造果203.值;
        返回 构造型203;
    } 否则 {
        返回 -1;
    }
}

// 203-a：族② 裸释放检查（155-a A5 挂点：释放(指针) 报不安全边界；非终结分支——
//   检查后主函数继续后续分派）。
函数 检查裸释放调用(向量<节点> 池, 节点 n, 向量<字符串>& 诊断) -> 空类型 {
            如果 (n.附加 == 1 && n.子终点 > n.子起点) {
                节点 释放实参 = 池.元素(整32(n.子终点 - 1));
                如果 (释放实参.类型 == 节点_标识符) {
                    可选<整64> 指针查释 = 查语义指针变量(整64(释放实参.文本));
                    如果 (指针查释.有值) {
                        错误不安全边界(诊断, "裸释放", "释放(指针)");
                    }
                }
            }
}

// 203-a：族③ 转移调用检查（plans/019 阶段1 显式转移：实参变量分级+声明位约束+
//   已转移拒绝+标记；成功返回实参类型）。
函数 检查转移调用(向量<节点> 池, 节点 n, 整64 调用起点, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 整64 {
            如果 (n.附加 != 1) {
                表诊断(诊断, "[错误] 转移() 须恰好一个实参");
                返回 驻留("整64");
            }
            节点 转实参 = 池.元素(整32(调用起点) + 1);
            // 986（008 挂账②·对齐宿主 959）：**成员源放行**（转移(h.字段)）——
            //   类型=推导成员类型ID（静默·成员链基座检查已由语句根遍历完成）；
            //   语义不标记（旧名禁用按成员路径在生成层成员槽清零后推导·编译期
            //   成员拦截=诚实边界随 LUE 精确化轮）；下标/解引用形态仍拒（宿主同面）。
            // 987 修正（985 探针实锤）：成员源池形态=**两节点平铺**〔标识符(对象)+
            //   成员(字段)·成员.子起点=对象索引〕——986 版单节点判定落空（实参节点
            //   =基座标识符→落到标识符分支误标记基座=假阳性 3）。组合形态判定：
            布尔 成员源987 = 假;
            整32 成员节点索引987 = 0;
            如果 (转实参.类型 == 节点_成员) {
                成员源987 = 真;
                成员节点索引987 = 整32(调用起点) + 1;
            } 否则 如果 (转实参.类型 == 节点_标识符 &&
                        整32(调用起点) + 2 < 整32(池.大小())) {
                节点 后继987 = 池.元素(整32(调用起点) + 2);
                如果 (后继987.类型 == 节点_成员 && 后继987.子起点 == 整32(调用起点) + 1) {
                    成员源987 = 真;
                    成员节点索引987 = 整32(调用起点) + 2;
                }
            }
            如果 (成员源987) {
                向量<字符串> 静默诊断987 = 向量<字符串>();
                可选<整64> 成员类型987查 = 推导成员类型ID(池, 成员节点索引987, 符号表, 静默诊断987);
                如果 (!成员类型987查.有值) {
                    表诊断(诊断, "[错误] 转移目标成员类型无法解析");
                    返回 驻留("整64");
                }
                返回 成员类型987查.值;
            }
            如果 (转实参.类型 != 节点_标识符) {
                表诊断(诊断, "[错误] 转移目标须为变量（标识符）或成员");
                返回 驻留("整64");
            }
            可选<整64> 转实参类型查 = 表查找类型ID(符号表, 整64(转实参.文本));
            如果 (!转实参类型查.有值) {
                表诊断(诊断, "[错误] 未声明的标识符: " + 驻留文本(整64(转实参.文本)));
                返回 驻留("整64");
            }
            整64 转实参类型 = 转实参类型查.值;
            如果 (表查已转移(符号表, 整64(转实参.文本)) > 0) {
                表诊断(诊断, "[错误] 变量已转移，不能继续使用（显式转移后源变量禁用）: " +
                              驻留文本(整64(转实参.文本)));
                返回 驻留("整64");
            }
            整64 转分级 = 转移实参分级(转实参类型, 整64(转实参.文本));
            如果 (转分级 == 1) {
                表诊断(诊断, "[错误] 变量具有复制语义，无需转移: " +
                              驻留文本(整64(转实参.文本)));
                返回 驻留("整64");
            }
            // 977（008 总攻·576·对齐宿主 plans/022 波4 459-a/206-d）：拥有资源
            //   类型表达式位转移**放行**——「仅声明初始化位」拒绝解除（963 赋值位
            //   通道已先行·本补全实参位/返回位）。IR 层生成转移展开 同步升级=
            //   句柄直拷/结构体副本+源槽清零（真槽位交接·moved-from 旧名禁用）。
            //   〔基准=019〕第二句：显式放弃安全=显式获得性能（零拷贝交接）。
            
            表标记转移(符号表, 整64(转实参.文本), 1);
            返回 转实参类型;
}

// 206-c（波 4·plans/020 第七十二节 §二）：族⑤ 复制调用检查——复制(表达式)
//   泛型克隆内置（与 转移(x) 显式「复制/移动」双内置；C++ copy/move、Rust
//   Clone::clone 同构）。实参恰 1 个；返回类型=实参类型（泛型内置无法固定
//   签名注册 → 调用处特判）；类型 ID 写回调用节点.子终点（解析期空闲位，
//   71-a 装箱特判同款）供 IR 层 生成复制展开 按类型分派发射。
//   实参类型推导=**静默优先**：标识符/成员/下标 属 place 形态（stdlib 四容器
//   拷贝构造切换全需求），且已由语句根区间线性遍历先序检查——此处重复检查
//   会重复诊断，并重复触发借用纪律/转移标记副作用（`复制(转移(x))` 二次
//   标记后误报「变量已转移」）；故 place 形态走丢弃诊断静默推导（副作用面
//   =类型推导，无状态变更），其余形态（调用返回/字面量）回落 检查表达式。
函数 检查复制调用(向量<节点> 池, 节点 n, 整32 节点索引, 整64 调用起点, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 整64 {
    如果 (n.附加 != 1) {
        表诊断(诊断, "[错误] 复制(表达式) 恰好接收 1 个实参");
        返回 驻留("整64");
    }
    整32 复参索引 = 整32(调用起点) + 1;
    节点 复实参 = 池.元素(复参索引);
    向量<字符串> 静默诊断 = 向量<字符串>();
    整64 复类型 = 0;
    如果 (复实参.类型 == 节点_标识符) {
        可选<整64> 复类型查 = 表查找类型ID(符号表, 整64(复实参.文本));
        // miss 保持 0（下方 <=0 判定与原 -1 哨兵同真·880 批5）
        如果 (复类型查.有值) { 复类型 = 复类型查.值; }
    } 否则 如果 (复实参.类型 == 节点_下标 || 复实参.类型 == 节点_成员) {
        复类型 = 检查表达式(池, 复参索引, 符号表, 静默诊断);
    } 否则 {
        复类型 = 检查表达式(池, 复参索引, 符号表, 诊断);
    }
    如果 (复类型 <= 0) { 返回 驻留("整64"); }
    // 423（任务 284·宿主 checkCopyBuiltinCall 同构）：类实参须有拷贝构造
    //   （克隆契约——复制 语义要求独立拥有，浅柄共享违背契约）——无拷贝
    //   构造类拒绝，诊断文本与宿主逐字对齐（dual 负测锚）。stdlib 容器
    //   实例豁免（容器拷贝构造符号经 方法符号 合成·基类登记不落实例键）。
    {
        字符串 复类型文本423 = 字符串复制(驻留文本(复类型));
        如果 (是用户类(复类型文本423) && !是容器类(复类型文本423) &&
             查类拷贝构造串(复类型) == 0) {
            表诊断(诊断, "[错误] 类型 '" + 复类型文本423 + "' 未定义拷贝构造，无法 复制");
        }
    }
    // 854 LUE（任务 054 波1·〔基准=019〕第四句 (a)「对『源在拷贝后不再被使用』的
    //   拷贝自动降级为转移」）：实参=纯局部标识符 且 池后向（至函数边界）无同名
    //   标识符出现（读或写·极保守：不确定即不消除）→ 实参节点.修饰=1——生成层
    //   生成复制展开 据此走 move 发射（句柄直取+源槽清零·族②③④跳过深拷）。
    //   值语义不变：无后续读 → 清源槽无观察差异（NRVO 同构·零新诊断面）。
    //   已转移变量跳过（转移链既有语义优先）；非局部（全局/静态·跨函数可读）跳过。
    如果 (复实参.类型 == 节点_标识符) {
        整64 复名ID = 整64(复实参.文本);
        如果 (表查已转移(符号表, 复名ID) == 0 && 是局部名(符号表, 复名ID)) {
            布尔 是LUE = 真;
            整32 扫索引 = 节点索引 + 1;
            当 (扫索引 < 整32(池.大小())) {
                节点 扫点 = 池.元素(扫索引);
                如果 (扫点.类型 == 节点_函数 || 扫点.类型 == 节点_参数) { 中断; }
                如果 (扫点.类型 == 节点_标识符 && 整64(扫点.文本) == 复名ID) {
                    是LUE = 假;
                    中断;
                }
                扫索引++;
            }
            // 874 回边健全性（循环跨迭代保守·〔基准=019〕第四句 (a)）：复制点被
            //   循环包围时后续迭代会重复执行该复制——源须在**最内层包围循环体块内
            //   声明**（每轮重新初始化），否则回边后下一轮读到已清零槽（实证：
            //   循环体外声明+体内复制 → 二轮起源槽=0·静默错值）。不确定即不消除。
            如果 (是LUE) {
                整32 最内起点 = -1;
                整32 内层体起 = 0;
                整32 内层体终 = 0;
                整32 循索引 = 0;
                当 (循索引 < 整32(池.大小())) {
                    节点 循点 = 池.元素(循索引);
                    如果 (循点.类型 == 节点_当语句 || 循点.类型 == 节点_循环语句) {
                        整32 循起点 = 整32(循点.文本);
                        节点 块点 = 池.元素(整32(循点.附加));
                        如果 (节点索引 >= 循起点 && 节点索引 < 块点.子终点) {
                            如果 (循起点 > 最内起点) {
                                最内起点 = 循起点;
                                内层体起 = 块点.子起点;
                                内层体终 = 块点.子终点;
                            }
                        }
                    }
                    循索引++;
                }
                如果 (最内起点 >= 0) {
                    布尔 源在体内声明 = 假;
                    整32 查索引 = 内层体起;
                    当 (查索引 < 内层体终) {
                        节点 查点 = 池.元素(查索引);
                        如果 (查点.类型 == 节点_变量声明 && 整64(查点.文本) == 复名ID) {
                            源在体内声明 = 真;
                            中断;
                        }
                        查索引++;
                    }
                    如果 (!源在体内声明) { 是LUE = 假; }
                }
            }
            如果 (是LUE) {
                节点 标记实参 = 复实参;
                标记实参.修饰 = 1;
                结果<空类型, 整32> 设标 = 池.设置(复参索引, 标记实参);
                如果 (!设标.正常) { 运行时错误(4); }
            }
        }
    }
    n.子终点 = 整32(复类型);
    结果<空类型, 整32> 设复 = 池.设置(节点索引, n);
    如果 (!设复.正常) { 运行时错误(4); }
    返回 复类型;
}

// 203-a：族④ 签名键回退决议（呈报③方案A：签名表同名候选回退+plans/018 键基化三级决议；
//   决议成功=登记调用决议+借用纪律+返回类型；失败返回 -1 哨兵=主函数继续后续链）。

// 106（890 残余·泛型方法实参面）：成员方法实参位期望类型回取——对象（标识符）
//   类型经符号表查得；基名池扫类定义（节点_类）命中 节点_方法（名匹配）→
//   参数串（函数参数串·模板态）；对象类型为实例合成名（$ 段存在）时先做类型
//   参数替换（序=查泛型基类参数序·实参=取实例实参们——解析期登记/IR 基础设施
//   语义阶段均已就绪），再取末**顶层**参数段；是结果/可选 → 返回其类型 ID。
//   宿主对照（D14/H2/H3 全绿）：实参位构造器按期望类型下推·不要求声明位语境；
//   890 覆盖标注面=容器实例（签名表登记），本函数清偿「用户（泛型）类/普通类
//   方法+条件位/裸语句无语境」面（890/894 注释登记的诚实边界）。
函数 成员方法期望类型106(向量<节点> 池, 节点 成员节点106,
                        向量<映射<整64, 符号>>& 符号表) -> 整64 {
    如果 (成员节点106.子起点 <= 0) { 返回 0; }
    节点 对象106 = 池.元素(整32(成员节点106.子起点));
    如果 (对象106.类型 != 节点_标识符) { 返回 0; }
    整64 对象类型ID106 = 0;
    可选<整64> 对象类型ID106查 = 表查找类型ID(符号表, 整64(对象106.文本));
    // miss 保持 0（下方 <=0 判定与原 -1 哨兵同真·880 批5）
    如果 (对象类型ID106查.有值) { 对象类型ID106 = 对象类型ID106查.值; }
    如果 (对象类型ID106 <= 0) { 返回 0; }
    字符串 对象类型名106 = 字符串复制(驻留文本(对象类型ID106));
    字符串 基名106 = 合成名基名(对象类型名106);
    如果 (字符串长度(基名106) == 0) { 返回 0; }
    布尔 实例形态106 = !字符串比较(基名106, 对象类型名106);
    整64 扫类106 = 0;
    当 (扫类106 < 整64(池.大小())) {
        节点 类106 = 池.元素(整32(扫类106));
        如果 (类106.类型 == 节点_类 &&
             整64(类106.文本) == 驻留(基名106)) {
            整64 位置106 = 整64(类106.子起点);
            当 (位置106 < 整64(类106.子终点)) {
                节点 成员106 = 池.元素(整32(位置106));
                如果 (成员106.类型 == 节点_方法 &&
                     整64(成员106.文本) == 整64(成员节点106.文本)) {
                    字符串 参数串106 = 函数参数串(池, 整32(位置106));
                    如果 (实例形态106 && 字符串长度(参数串106) > 0) {
                        整64 序ID106 = 查泛型基类参数序(驻留(基名106));
                        如果 (序ID106 != 0) {
                            向量<字符串> 实参们106 = 取实例实参们(对象类型名106);
                            参数串106 = 替换类型参数带段们(参数串106,
                                字符串复制(驻留文本(序ID106)), 实参们106);
                        }
                    }
                    字符串 末形参106 = 末参数段106(参数串106);
                    如果 (字符串长度(末形参106) > 0 &&
                         是结果类型(末形参106)) {
                        返回 驻留(末形参106);
                    }
                    返回 0;
                }
                位置106++;
            }
            返回 0;
        }
        扫类106++;
    }
    返回 0;
}

// 106：参数串取末段（右起**顶层**逗号切分——模板文本形态内嵌 <...> 逗号
//   不参与切分（末参=结果<整32, 整32> 形态）；$ 实例形态无内嵌逗号自然兼容。
//   空串/无顶层逗号=原串返回。
函数 末参数段106(字符串 参数串106) -> 字符串 {
    整64 长106 = 字符串长度(参数串106);
    整64 深106 = 0;
    整64 扫106 = 长106 - 1;
    当 (扫106 >= 0) {
        整64 字节106 = 整64(参数串106[整32(扫106)]) & 255;
        如果 (字节106 == 62) {
            深106++;
        } 否则 如果 (字节106 == 60) {
            深106--;
        } 否则 如果 (字节106 == 44 && 深106 <= 0) {
            返回 字符串子串(参数串106, 整32(扫106 + 1),
                            整32(长106 - 扫106 - 1));
        }
        扫106--;
    }
    返回 字符串复制(参数串106);
}
