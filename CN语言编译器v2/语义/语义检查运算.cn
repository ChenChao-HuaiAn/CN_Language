// CN 自举编译器 v2 · 语义检查·运算表达式检查族（767 拆分：自 语义检查中.cn
//   机械搬移·函数体逐字保留·零逻辑变化——该文件 997 行贴死 1000 冻结线
//   （651 整-浮推断窄改再净增即破线），「先拆再加」纪律执行·357/546 拆分先例同款）
// 1610 拆分：指针边界族（926/615/1175/1311回绕辅助/1471——原 429~999 行段）
//   机械搬移至 语义检查指针边界.cn（本文件 999 行贴死 1000 冻结线·1610 新增
//   位/逻辑混写类型域执法须先拆再加·函数体逐字保留零逻辑变化）。
// 职责：二元/三元运算表达式检查族——检查二元运算表达式（操作数递归限定+969
//   混合比较检出+484 混合符号/除零/溢出/移位挂点+157-a 指针算术+空类型/411
//   守卫族）+ 是数值类型文本411/是整数类型文本411（算术/位运算总守卫专用谓词）
//   + 是可靠操作数末端1610（411 守卫可靠形态白名单单点·1610 扩二元形态）
//   + 检查逻辑运算操作数1610（逻辑运算符 && || 操作数严格布尔·宿主
//   checkLogicalBinary 逐字对齐）+ 检查三元运算表达式（443/539 条件严格布尔
//   +86-a 两分支类型一致性）。
//   推导族（表达式类型ID/推导成员类型ID/推导二元类型ID）与 497 字面量域定宽、
//   检查块/检查遍历894 留 语义检查中.cn——651/764 在途分支正改 推导二元类型ID，
//   本拆分零触碰该函数（合并零冲突面）。消费=语义检查表达式尾/语义检查语句 等
//   （同包跨模块经合并全局池解析·本模块反消费 表达式类型ID/类型可合并/检查条件布尔）。

导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（目录包名）
导入 IR;         // 容器/结果 合成名判定（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 880 批5：原恒 -1 返回值无人消费——改 空类型（唯一调用点 检查表达式 二元分支
//   自身返回 -1，比较产物类型不参与下游推导）。
函数 检查二元运算表达式(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    节点 n = 池.元素(节点索引);
    // 灰色点②方案A（2026-09-04 用户裁决）：字符串比较运算符显式拒绝——
    //   规范 plans/001 Task 2.8（比较运算符仅整型/浮点变体，字符串不参与
    //   运算符比较；等价能力 字符串比较（相等）/字符串字典序（全序））。
    //   原按指针地址放行=同内容异地址 ==/!= 恒假（拼接产物静默陷阱）。
    //   操作数类型经区间末端节点递归推导（三元同款技巧）：二元节点布局契约
    //   （970/450/469 同口径·原注「子起点=右起点」系旧错述一并纠正）=
    //   附加=右操作数起点（全构建形态不变量）——左末=附加-1、
    //   右末=本节点索引-1。字面量/标识符形态可靠推导；拼接产物/成员字段
    //   推导 -1/整64 兜底=检不出（v2 类型推导既有半实现面，诚实边界——
    //   随 v2 语义类型推导完善收口，宿主侧已全形态覆盖）。返回 -1（比较
    //   产物类型不参与下游推导；三元末端为二元时原亦 -1 跳过，无回归）
    字符串 op文本 = 字符串复制(驻留文本(整64(n.文本)));
    布尔 是比较符 = 字符串比较(op文本, "==") || 字符串比较(op文本, "!=") ||
                   字符串比较(op文本, "<") || 字符串比较(op文本, ">") ||
                   字符串比较(op文本, "<=") || 字符串比较(op文本, ">=");
    // 混合符号二元运算拒绝（2026-09-10 第五十一轮 方案A 用户裁决，Rust
    //   对齐；规范 plans/001 §3.7）：检查范围自比较符扩至算术/位运算符——
    //   「变量间」整N vs 正M 诊断拒绝（检查混合符号二元，语义检查表达式
    //   模块；字面量豁免含 -1 形态；类型 -1 跳过=检不出诚实边界同上）。
    布尔 是算术位符 = 字符串比较(op文本, "+") || 字符串比较(op文本, "-") ||
                    字符串比较(op文本, "*") || 字符串比较(op文本, "/") ||
                    字符串比较(op文本, "%") || 字符串比较(op文本, "&") ||
                    字符串比较(op文本, "|") || 字符串比较(op文本, "^") ||
                    字符串比较(op文本, "<<") || 字符串比较(op文本, ">>");
    // 484（469 同轮·守卫同步对齐）：进块守卫 子起点>0 → 附加>0&&附加<=池大小
    //   （469 形态取反·下方 414 面守卫同款）——守卫口径与左末索引口径（附加-1）
    //   一致，兼收越界防御（旧 子起点>0 不保证 附加 有效）。
    如果 ((是比较符 || 是算术位符) && n.附加 > 0 && n.附加 <= 整32(池.大小())) {
        // 带诊断操作数递归限定比较符（灰色点②既有行为——诊断双报形态已
        //   被 174 等负测 expected 固化，不得扩面）；算术/位运算符的混合
        //   符号检查由 检查混合符号二元 静默自推导（零诊断副作用）
        // 966（166 立法 v2 同构·用户裁决 2026-10-02）：字符串×字符串 比较符
        //   放行为内容/字典序比较（宿主 962 同轮对齐——001 §比较语义修订版）。
        //   原「灰色点②方案A 显式拒绝」废止；生成层分派 __cn_str_eq/__cn_str_cmp
        //   （生成表达式运算.cn 发射字符串比较）。子表达式递归检查保留（诊断
        //   副作用）。
        // 969（166-001 根治·用户质询立案）：混合比较形态检出——比较符双侧末端
        //   推导均有效（非 -1）时按宿主同款拒绝（semantic_expr_op 指针/数值
        //   混合诊断）：一侧 字符串/字符* 且另一侧非 字符串/字符*/空类型*（数值
        //   等）→ 拒。双侧字符串=966 放行；判空 s==无（推导 -1 或 空类型*）两态
        //   均不触拒绝=保留（宿主 Task 6.2 通道）。推导 -1 兜底=检不出（既有
        //   半实现面·与字面量/变量主踩坑面正交）。
        如果 (是比较符) {
            // 970（168 根治·索引口径修正）：比较节点池布局=子起点存左操作数
            //   **起点**、附加存右操作数**起点**（解析二元循环 普通二元契约）——
            //   左操作数**末端** = 附加-1（右起点前一节点）；原 子起点-1 = 左
            //   操作数之前节点（`x && a == b` 取到 x → 把 a==b 误读 x==b →
            //   969 检出报 布尔×字符串＝168 立案的现象层；旧 966 前代码同错
            //   但只致漏报）。右末端=节点索引-1 不变（右操作数紧邻本节点前）。
            整64 左末端索引 = 整64(n.附加) - 1;
            登记零值比较失格548(池, 整32(左末端索引), 节点索引, 符号表);   // 548 比较参与=零值失格
            可选<整64> 左类型比查 = 检查表达式(池, 整32(左末端索引), 符号表, 诊断);
            可选<整64> 右类型比查 = 检查表达式(池, 整32(节点索引 - 1), 符号表, 诊断);
            // #1542：下游仍消费 -1 哨兵（969 双侧有效判据）——有值还原 .值，无值保持 0-1
            整64 左类型比 = 0 - 1;
            如果 (左类型比查.有值) { 左类型比 = 左类型比查.值; }
            整64 右类型比 = 0 - 1;
            如果 (右类型比查.有值) { 右类型比 = 右类型比查.值; }
            // 933（任务 933·双侧零分叉）：引用返回字符串调用读值归一——用户类
            //   方法调用在 检查表达式 面=「整64 兜底」（648 归档：方法返回在 IR
            //   层调用面精确决议；语义层扫描面=常态回退）——直判单点=语义层
            //   是引用返回字符串调用933语义（标识符/容器签名/用户类方法表三源）。
            //   原 `b.读名() == "盒名"` 左类型=整64 → 969 混合拒（宿主放行）=
            //   双侧分叉；归一后双侧字符串 → 966 放行内容比较。
            如果 (左类型比 != 驻留("字符串") &&
                是引用返回字符串调用933语义(池, 整32(左末端索引), 符号表)) {
                左类型比 = 驻留("字符串");
            }
            如果 (右类型比 != 驻留("字符串") &&
                是引用返回字符串调用933语义(池, 整32(节点索引 - 1), 符号表)) {
                右类型比 = 驻留("字符串");
            }
            // 969 补（全量 20 例误伤根治）：「无」=节点_整数字面量·附加=1（153-a
            //   空指针字面量标记）·检查表达式 走整数字面量分支直返 整32——判空
            //   通道必须按 AST 末端节点直判（推导值无法区分 无 与真实整数）。
            节点 右末端 = 池.元素(整32(节点索引 - 1));
            布尔 右是无 = 右末端.类型 == 节点_整数字面量 && 右末端.附加 == 1;
            节点 左末端 = 池.元素(整32(左末端索引));
            布尔 左是无 = 左末端.类型 == 节点_整数字面量 && 左末端.附加 == 1;
            布尔 左串侧 = 左类型比 == 驻留("字符串") || 左类型比 == 驻留("字符*");
            布尔 右串侧 = 右类型比 == 驻留("字符串") || 右类型比 == 驻留("字符*");
            布尔 左空 = 左类型比 == 驻留("空类型*") || 左是无;
            布尔 右空 = 右类型比 == 驻留("空类型*") || 右是无;
            布尔 双侧有效 = 左类型比 != -1 && 右类型比 != -1;
            如果 (双侧有效 && ((左串侧 && !右串侧 && !右空) || (右串侧 && !左串侧 && !左空))) {
                // #1741 文案逐字对齐宿主 semantic_expr_binary.cpp:552（带左右
                //   实际类型·1027 采样轮 #1679 拒因判据显形面——原 v2 补充括号
                //   措辞「（字符串/字符* 不能与数值等非指针类型比较）——字符串内容
                //   比较请两侧均为 字符串 类型」宿主无此段）。
                表诊断(诊断, "[错误] 指针只能与指针或空指针比较，实际为 '" +
                            字符串复制(驻留文本(左类型比)) + "' 与 '" +
                            字符串复制(驻留文本(右类型比)) + "'");
            }
        }
        // 484（450 同族第五轮·左末口径统一 子起点-1→附加-1）：混合符号左末端
        //   取 附加-1（全构建形态契约：附加=右操作数起点→左操作数末端=附加-1；
        //   970/450/469 同口径）。探针实证（484 修前修后对照）：普通面 附加=子起
        //   点=右起点两口径等价；复合赋值/自增合成二元（解析表达式兜底语句 建节
        //   点·回退重析池不删）子起点-1=首次解析左值末节点、附加-1=左值副本末
        //   节点——两者**同文本同形态**（重析=同 token 重放）→推导同型·差分被
        //   吸收（pa 拒/pb 拒/pc 放行 修前修后三态全同=零回归）。
        检查混合符号二元(池, 整32(n.附加 - 1), 整32(节点索引 - 1),
                        符号表, 诊断);
        // 157-a（V3 缺陷修复——A1 v2 挂点全覆盖）：**指针算术**（裸指针
        //   ± 整数）——155-a 的 A1 挂点仅在 推导二元类型ID（指针变量经
        //   类型ID 推导返 -1=全路径失效，实测声明/赋值皆零命中）；本处改
        //   用 表查找类型ID（声明类型文本）+ 是裸指针类型文本 判定——与
        //   B8/A2 判定机制同族，声明/赋值/表达式全路径覆盖。
        检查常量除零474(池, n, 节点索引, op文本, 符号表, 诊断);
        检查常量算术溢出预演474(池, n, 节点索引, op文本, 是算术位符, 诊断);
        检查常量移位超宽474(池, n, 节点索引, op文本, 符号表, 诊断);
        如果 (字符串比较(op文本, "+") || 字符串比较(op文本, "-")) {
            布尔 左指针a1 = 假; 布尔 右指针a1 = 假;
            // 484（450 同族第五轮·左末口径统一 子起点-1→附加-1）：A1 左末端
            //   取 附加-1=左值副本末节点（同型吸收论证同上 检查混合符号二元 调用
            //   位·pa 探针修前修后同拒实证）。
            节点 左a1 = 池.元素(整32(n.附加 - 1));
            如果 (左a1.类型 == 节点_标识符) {
                // v2 符号登记语义：指针变量登记**所指类型**（B8 同款注释：
                //   「指针变量表命中即返回所指类型」）——故判定用 查语义
                //   指针变量（非 表查找类型ID，后者对 整64* q 返 整64）。
                可选<整64> 查左a1 = 查语义指针变量(整64(左a1.文本));
                如果 (查左a1.有值) {
                    如果 (!字符串比较(字符串复制(驻留文本(查左a1.值)), "字符")) {
                        左指针a1 = 真;   // 字符* 排除（字符串视图=波 1 同族）
                    }
                }
            } 否则 如果 (左a1.类型 == 节点_二元运算) {
                // 1064（#1040 派生·表达式操作数扩展）：(p+1) 等 ± 链同判——
                //   宿主 reportUnsafeBoundary 按操作数类型 isPointer 全形态
                //   触发（(p+1)-(p+2) 外层节点亦报），此行对齐表达式面。
                整64 层左a1 = 0; 可选<整64> 左元a1查 = 指针值表达式元素1064(池, 整32(n.附加 - 1), 层左a1); 左指针a1 = 左元a1查.有值;
            }
            节点 右a1 = 池.元素(整32(节点索引 - 1));
            如果 (右a1.类型 == 节点_标识符) {
                可选<整64> 查右a1 = 查语义指针变量(整64(右a1.文本));
                如果 (查右a1.有值) {
                    如果 (!字符串比较(字符串复制(驻留文本(查右a1.值)), "字符")) { 右指针a1 = 真; }
                }
            } 否则 如果 (右a1.类型 == 节点_二元运算) { 整64 层右a1 = 0; 可选<整64> 右元a1查 = 指针值表达式元素1064(池, 整32(节点索引 - 1), 层右a1); 右指针a1 = 右元a1查.有值; }
            如果 (左指针a1 || 右指针a1) {
                错误不安全边界(诊断, "指针算术", "指针 +/- 整数");
            }
        }
        // 609-a（T100·425 对齐宿主 visitBinaryExpr 空类型面·Rust () 同款）：
        //   空类型调用结果参与运算拒绝。类型经 表达式类型ID 推导族+静默诊断
        //   缓冲（174 教训惯例：二次推导诊断吞弃·语句根区间遍历=权威诊断点）；
        //   语句级单独调用不入本判定=合法（打印(x); 同族）。方向词对齐宿主
        //   visitBinaryExpr（左/右 操作数是空类型调用结果）。
        整64 空类型609 = 驻留("空类型"); 向量<字符串> 静默诊断609 = 向量<字符串>();
        可选<整64> 左类型查609 = 无; 可选<整64> 右类型查609 = 无;
        // 484（450 同族第五轮·左末口径统一 子起点-1→附加-1）：609 左操作数
        //   末端取 附加-1（同型吸收论证同上·合成面 左值副本与首次解析左值同型
        //   →推导同型零变化；左值类型恒非「空类型」（空类型无变量/字段）·差分
        //   双重吸收=零回归）。
        如果 (!是副作用内置被调(池, 整32(n.附加 - 1))) {
            左类型查609 = 表达式类型ID(池, 整32(n.附加 - 1), 符号表, 静默诊断609);
        }
        如果 (!是副作用内置被调(池, 整32(节点索引 - 1))) {
            右类型查609 = 表达式类型ID(池, 整32(节点索引 - 1), 符号表, 静默诊断609);
        }
        // 880 批5：无值=不可推导（miss 保持 0·下方 == 空类型 判定与原同假）
        整64 左类型609 = 0;
        如果 (左类型查609.有值) { 左类型609 = 左类型查609.值; }
        整64 右类型609 = 0;
        如果 (右类型查609.有值) { 右类型609 = 右类型查609.值; }
        //   调用形态限定：空类型表达式只能来自调用（文案即「调用结果」）——
        //   指针变量（空类型* p）经 表查找类型ID 返回**所指类型**裸「空类型」
        //   （符号登记语义·34_file `写句柄 != 无` 全量实锤误伤面）——非调用
        //   末端一律不判，杜绝该族误伤。
        如果 (左类型609 == 空类型609 &&
             池.元素(整32(n.附加 - 1)).类型 == 节点_调用) {
            表诊断(诊断, "[错误] 空类型（无返回值）不能参与运算：左 操作数是空类型调用结果（Rust () 同款——无返回值却有值违反类型安全；如需值请改函数返回类型）");
        }
        如果 (右类型609 == 空类型609 &&
             池.元素(整32(节点索引 - 1)).类型 == 节点_调用) {
            表诊断(诊断, "[错误] 空类型（无返回值）不能参与运算：右 操作数是空类型调用结果（Rust () 同款——无返回值却有值违反类型安全；如需值请改函数返回类型）");
        }
    }
    // 414 P0-2/P1-2（审查·权威诊断面单点·外层级=比较符+算术位符全覆盖）：命中=
    //   两道使用点校验（个数+右参隐式转换·宿主 resolveOperatorOverload 逐字同构）；
    //   左操作数为类且未命中重载=报宿主「不兼容」文案（P1-2·替代原「要求数值
    //   操作数」分叉文案）。op∉二元重载符号集（位运算五算子）或左推导不可靠=
    //   不进本块（内置守卫照旧）。重载面411/左类未命中414 供下方算术位符守卫豁免。
    布尔 重载面411 = 假; 布尔 左类未命中414 = 假;
    如果 (是二元重载符号(op文本) && n.附加 > 0 && n.附加 <= 整32(池.大小())) {
        向量<字符串> 静默L414 = 向量<字符串>(); 可选<整64> 左类查414 = 表达式类型ID(池, 整32(n.附加) - 1, 符号表, 静默L414);
        整64 左ID414 = 0;
        如果 (左类查414.有值) { 左ID414 = 左类查414.值; }
        如果 (左ID414 > 0 && 是用户类ID(左ID414)) {
            整64 方法名ID414 = 整64(驻留("运算符" + op文本));
            // 1541 B2：有值=沿链命中「运算符」重载（原 !=0 判据）
            可选<整64> 重载定义查414 = 查类方法定义层(左ID414, 方法名ID414);
            如果 (重载定义查414.有值) {
                重载面411 = 真;
                检查二元重载使用点(池, 节点索引, 符号表, 诊断);
            } 否则 {
                左类未命中414 = 真;
                表诊断(诊断, "[错误] 运算符 '" + op文本 + "' 与类型 '" +
                            驻留文本(左ID414) +
                            "' 不兼容（无内置匹配且类无对应运算符重载）");
            }
        }
    }
    // 411/412（406 采样轮·算术/位运算操作数总守卫·宿主 checkArithmeticBinary/
        //   checkBitwiseBinary 同构·文案逐字对齐）：拼接/指针算术（A1 挂点）等
        //   合法特判之外，四则操作数须数值（整N/正M/浮N/字符——979 字符四字节
        //   窄整语义·'a'+1=98 合法面 690 用例锚）、位运算操作数须整数（001 §4.4
        //   ——修前浮点位运算 v2 放行宿主拒=412 分叉·布尔四则布尔化/字符串减法/
        //   枚举算术=411 三族双侧同病）。类型经 推导源类型文本（字面量直判+
        //   标识符符号表+枚举成员·本批收口）；「未知」=检不出放行（诚实边界·
        //   推导源类型ID静默 同纪律）；「空类型」面=指针算术 A1 挂点已管辖（安全
        //   区拒/不安全区放行）本守卫跳过防误伤 FFI 形态。
        如果 (是算术位符) {
            // 425 左末索引根治（2026-10-11·09_integration 实录）：二元节点契约=
            //   子起点=左操作数**首**节点、附加=右操作数起点（解析表达式中 339
            //   建节点）→ 左末端=附加-1。原 子起点-1=左首前一节点（错位·970 同
            //   族）：本例 `p < 名单 + 人数` 内层 + 的左末被取成条件左端 p——
            //   误报「'学生' 与 '整32'」；而真左末 名单（学生[5]）走指针算术
            //   豁免放行（宿主 visitBinaryExpr 数组退化同语义）。
            字符串 左类型411 = 推导源类型文本(池, 整32(n.附加 - 1), 符号表, "未知");
            字符串 右类型411 = 推导源类型文本(池, 整32(节点索引 - 1), 符号表, "未知");
            布尔 双侧有效411 = !字符串比较(左类型411, "未知") && !字符串比较(右类型411, "未知");
            布尔 空类型面411 = 字符串比较(左类型411, "空类型") || 字符串比较(右类型411, "空类型");
            布尔 取余411 = 字符串比较(op文本, "%");
            布尔 位运算412 = 字符串比较(op文本, "&") || 字符串比较(op文本, "|") || 字符串比较(op文本, "^") || 字符串比较(op文本, "<<") || 字符串比较(op文本, ">>");
            // 拼接豁免（宿主 checkStringConcatAndPtrArithmetic 提前 return 同构·
            //   79_v2 自举树误伤根治）：+ 且左操作数 字符串/字符* =拼接语境
            //   （§253 左串触发右数值/布尔/枚举隐式转字符串）——宿主经拼接分支
            //   return 不进总守卫，v2 无 return 机制须内建豁免；v2 树诊断文案
            //   构造「文本+值」遍地·漏豁免=自举链全红实证。
            // 末端节点可靠形态限定（79_v2 自举树误伤根治·推导源类型ID静默 同
            //   诚实边界纪律）：白名单单点=是可靠操作数末端1610（标识符/五族
            //   字面量/成员——1610 扩面+二元运算：比较/短路符→布尔直判精确，
            //   算术/位→推导二元结果类型ID 740 递归可靠面；索引口径已 425/450
            //   统一为 附加-1（970 同族错位根治），二元末端纳入不再有旧
            //   子起点-1 错位面；调用等复合形态仍不判——宿主全形态守卫在位·
            //   v2 可靠面执法不退步）。
            节点 左末411 = 池.元素(整32(n.附加 - 1)); 节点 右末411 = 池.元素(整32(节点索引 - 1));
            布尔 左可靠411 = 是可靠操作数末端1610(左末411);
            布尔 右可靠411 = 是可靠操作数末端1610(右末411);
            布尔 拼接面411 = 字符串比较(op文本, "+") && (字符串比较(左类型411, "字符串") || 字符串比较(左类型411, "字符*"));
            // 425（wt425·09_integration 实录·宿主 checkStringConcatAndPtrArithmetic
            //   指针算术分支同构）：+/- 且某侧命中指针值面 → 指针算术面——
            //   不进数值性总守卫（宿主对指针算术提前 return 同语义；不安全边界
            //   由上方 A1 挂点管辖·不安全函数内合法）。真指针 ± 指针/整数在左
            //   的拒绝面按宿主文案单独执法。
            // 1064（#1040 派生缺口·表达式操作数扩展）：指针值面=①标识符命中
            //   语义指针变量表（94-a：指针声明与数组名退化都登记此表；字符*
            //   借用视图豁免与 A1 挂点同款）；②二元 ± 链——指针值表达式元素
            //   1064 推导（(p+1)/(p+n) 等·丢星族收口面）。两侧元素/层数一并
            //   捕获（左元425/左层425 等），1040 同型判定对两形态统一消费。
            布尔 左指针面425 = 假; 布尔 右指针面425 = 假;
            整64 左元425 = 0; 整64 右元425 = 0; 整64 左层425 = 0; 整64 右层425 = 0;
            如果 (字符串比较(op文本, "+") || 字符串比较(op文本, "-")) {
                如果 (左末411.类型 == 节点_标识符) {
                    可选<整64> 查左425查 = 查语义指针变量(整64(左末411.文本));
                    如果 (查左425查.有值 &&
                        !字符串比较(字符串复制(驻留文本(查左425查.值)), "字符")) {
                        可选<整64> 左层425查 = 查语义指针层数(整64(左末411.文本));
                        // 配对不变量：指针变量表命中 ⇒ 层数表必命中（登记语义指针变量
                        //   单点双写）。缺登记=内部缺陷 → 登记显形且保守不置指针面
                        //   （不静默取默认层数·#1507 同规）。
                        如果 (左层425查.有值) {
                            左指针面425 = 真; 左元425 = 查左425查.值; 左层425 = 左层425查.值;
                        }
                        如果 (!左层425查.有值) {
                            登记内部未登记("指针层数表与指针变量表登记不一致（425 左）",
                                           字符串复制(驻留文本(整64(左末411.文本))), 0);
                        }
                    }
                } 否则 如果 (左末411.类型 == 节点_二元运算) {
                    可选<整64> 左元425查 = 指针值表达式元素1064(池, 整32(n.附加 - 1), 左层425); 如果 (左元425查.有值) { 左元425 = 左元425查.值; }
                    左指针面425 = 左元425 > 0;
                }
                如果 (右末411.类型 == 节点_标识符) {
                    可选<整64> 查右425查 = 查语义指针变量(整64(右末411.文本));
                    如果 (查右425查.有值 &&
                        !字符串比较(字符串复制(驻留文本(查右425查.值)), "字符")) {
                        可选<整64> 右层425查 = 查语义指针层数(整64(右末411.文本));
                        // 配对不变量：指针变量表命中 ⇒ 层数表必命中（登记语义指针变量
                        //   单点双写）。缺登记=内部缺陷 → 登记显形且保守不置指针面
                        //   （不静默取默认层数·#1507 同规）。
                        如果 (右层425查.有值) {
                            右指针面425 = 真; 右元425 = 查右425查.值; 右层425 = 右层425查.值;
                        }
                        如果 (!右层425查.有值) {
                            登记内部未登记("指针层数表与指针变量表登记不一致（425 右）",
                                           字符串复制(驻留文本(整64(右末411.文本))), 0);
                        }
                    }
                } 否则 如果 (右末411.类型 == 节点_二元运算) {
                    可选<整64> 右元425查 = 指针值表达式元素1064(池, 整32(节点索引 - 1), 右层425); 如果 (右元425查.有值) { 右元425 = 右元425查.值; }
                    右指针面425 = 右元425 > 0;
                }
            }
            布尔 指针算术面425 = 左指针面425 || 右指针面425;
            // 1064：可判面=可靠形态（既有）或二元 ± 链（推导族 1064 补星接通
            //   的表达式面——本文件单边面零新增，条件全用命名布尔）。
            布尔 左可判425 = 左可靠411 || 左末411.类型 == 节点_二元运算;
            布尔 右可判425 = 右可靠411 || 右末411.类型 == 节点_二元运算;
            如果 (双侧有效411 && 左可判425 && 右可判425 && 指针算术面425 &&
                 左指针面425 && 右指针面425) {
                // 1040（2026-10-18 任务 1040 用户批甲·001 §5.3 清单 #1 扩充）：
                //   同型指针差（尾-首）＝不安全函数内合法（结果=有符号整64
                //   元素个数·IR 发射 (字节差)/元素宽）——宿主
                //   checkStringConcatAndPtrArithmetic 同判零分叉。
                //   同型=元素类型ID与指针层数双等（425 面已排除「字符」元素=
                //   字符串/字符* 视图不适用指针差）；op 必须「-」；「+」与异型
                //   拒绝面保留/新增（文案与宿主逐字一致）。1064：同型判定改经
                //   捕获值（左元425/左层425——标识符/表达式两形态统一）。
                布尔 同型指针差1040 = 假; 布尔 减面1040 = 字符串比较(op文本, "-");
                如果 (减面1040) {
                    同型指针差1040 = 左元425 > 0 && 左元425 == 右元425 && 左层425 == 右层425;
                }
                如果 (!同型指针差1040) {
                    如果 (减面1040) {
                        表诊断(诊断, "[错误] 指针差要求两个指针同型");
                    } 否则 {
                        表诊断(诊断, "[错误] 两个指针不能做算术运算");
                    }
                }
            }
            如果 (双侧有效411 && 左可判425 && 右可判425 && 指针算术面425 &&
                 !左指针面425 && 右指针面425) {
                表诊断(诊断, "[错误] 整数不能与指针做算术运算（仅支持 指针 ± 整数）");
            }
            如果 (双侧有效411 && 左可判425 && 右可判425 && 指针算术面425 &&
                 左指针面425 && !右指针面425 && !是整数类型文本411(右类型411)) {
                表诊断(诊断, "[错误] 指针算术要求整型偏移，实际为 '" + 右类型411 + "'");
            }
            如果 (双侧有效411 && 左可靠411 && 右可靠411 && !空类型面411 && !拼接面411 && !重载面411 && !左类未命中414 && !指针算术面425 && 取余411 &&
                 (!是整数类型文本411(左类型411) || !是整数类型文本411(右类型411))) {
                表诊断(诊断, "[错误] '%'取余运算要求整数操作数");
            }
            如果 (双侧有效411 && 左可靠411 && 右可靠411 && !空类型面411 && !拼接面411 && !重载面411 && !左类未命中414 && !指针算术面425 && 位运算412 &&
                 (!是整数类型文本411(左类型411) || !是整数类型文本411(右类型411))) {
                表诊断(诊断, "[错误] 位运算要求整数操作数，实际为 '" + 左类型411 +
                            "' 与 '" + 右类型411 + "'");
            }
            如果 (双侧有效411 && 左可靠411 && 右可靠411 && !空类型面411 && !拼接面411 && !重载面411 && !左类未命中414 && !指针算术面425 && !取余411 && !位运算412 &&
                 (!是数值类型文本411(左类型411) || !是数值类型文本411(右类型411))) {
                表诊断(诊断, "[错误] 算术运算符要求数值操作数，实际为 '" + 左类型411 +
                            "' 与 '" + 右类型411 + "'");
            }
    }
    // 1610 挂点：逻辑运算符（&& ||）操作数域检查（位/逻辑混写采样缺口·见函数头注）
    检查逻辑运算操作数1610(池, 节点索引, 符号表, 诊断);
    返回;
}

// 1610（2026-10-25 采样轮）：二元操作数末端形态可靠判定（411 守卫可靠面白名单
//   单点提炼·原两行内联表达式归纳——本轮起 位运算/取余/算术三面与逻辑面共用）。
//   1610 扩面：+ 节点_二元运算——其类型推导精确可靠（比较/短路符→布尔直判
//   推导源类型ID静默；算术/位→推导二元结果类型ID 740 递归可靠面；操作数含
//   调用/成员等不可推导面→整体「未知」→双侧有效假=放行诚实边界不变）。
//   修前白名单不含二元形态：o4 形态 `4 & (1==0)`（001 优先级 相等(7)>位与(6)）
//   布尔右元漏检放行（v2p rc=0 静默产 0·宿主拒「位运算要求整数操作数」分叉）。
//   零误伤论证：宿主对布尔/字符串等参与算术位运算全形态已拒·v2 树源码每轮过
//   宿主编译=宿主拒的形态 v2 树必无——扩面收敛至宿主同判对合法程序零新增拒绝
//   （78_v2 自举链 E2E 机械验证）。
函数 是可靠操作数末端1610(节点 末端1610) -> 布尔 {
    返回 末端1610.类型 == 节点_标识符 || 末端1610.类型 == 节点_整数字面量 ||
          末端1610.类型 == 节点_浮点字面量 || 末端1610.类型 == 节点_字符串字面量 ||
          末端1610.类型 == 节点_布尔字面量 || 末端1610.类型 == 节点_字符字面量 ||
          末端1610.类型 == 节点_成员 || 末端1610.类型 == 节点_二元运算;
}

// 1610（2026-10-25 采样轮·位/逻辑混写类型域执法收口）：逻辑运算符（&& ||）
//   操作数严格布尔（001 §3.7 强类型域·宿主 semantic_expr_binary.cpp
//   checkLogicalBinary 逐字对齐）——修前 v2 仅条件位 检查条件布尔443（如果/
//   当/循环/三元），值位（打印实参/赋值右元/返回式等）逻辑运算零操作数检查=
//   o5 形态 `1 | 2 && 0`（001 优先级 位或(4)>逻辑与(3) → (1|2)&&0）整数左元
//   放行静默产「假」（宿主拒「逻辑运算符要求布尔操作数」分叉）。类型经
//   推导源类型文本+是可靠操作数末端1610 白名单（「未知」=检不出放行·诚实
//   边界同 411 纪律）；诊断文案与宿主逐字一致（行锚=表诊断调用位惯例）。
函数 检查逻辑运算操作数1610(向量<节点> 池, 整32 节点索引,
                向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    节点 n1610 = 池.元素(节点索引);
    字符串 op1610 = 字符串复制(驻留文本(整64(n1610.文本)));
    布尔 是逻辑符1610 = 字符串比较(op1610, "&&") || 字符串比较(op1610, "||");
    // 区间守卫同 484 口径：附加=右操作数起点（全构建形态不变量）——
    //   左末=附加-1、右末=本节点索引-1（450 契约）。
    如果 (!是逻辑符1610 || n1610.附加 <= 0 || n1610.附加 > 整32(池.大小())) { 返回; }
    字符串 左类型1610 = 推导源类型文本(池, 整32(n1610.附加) - 1, 符号表, "未知");
    字符串 右类型1610 = 推导源类型文本(池, 整32(节点索引) - 1, 符号表, "未知");
    节点 左末1610 = 池.元素(整32(n1610.附加) - 1);
    节点 右末1610 = 池.元素(整32(节点索引) - 1);
    布尔 双侧有效1610 = !字符串比较(左类型1610, "未知") && !字符串比较(右类型1610, "未知");
    布尔 左可靠1610 = 是可靠操作数末端1610(左末1610);
    布尔 右可靠1610 = 是可靠操作数末端1610(右末1610);
    如果 (双侧有效1610 && 左可靠1610 && 右可靠1610 &&
         (!字符串比较(左类型1610, "布尔") || !字符串比较(右类型1610, "布尔"))) {
        表诊断(诊断, "[错误] 逻辑运算符要求布尔操作数，实际为 '" + 左类型1610 +
                    "' 与 '" + 右类型1610 + "'");
    }
}

// 411/412 数值/整数类型文本判定（算术/位运算总守卫专用·宿主 isNumeric/isInteger
//   同构）：数值=整N/正M/浮N 全族+字符（979 字符窄整·四则合法面）；整数=整N/
//   正M 全族（位运算/取余面——字符不算·宿主 isInteger("字符")=假·字符&1 拒
//   实测对齐）。全名枚举比较（中文类型名 UTF-8 首字节同值不可前缀判·直白零歧义）。
函数 是数值类型文本411(字符串 类型文本411) -> 布尔 {
    返回 字符串比较(类型文本411, "整8") || 字符串比较(类型文本411, "整16") ||
          字符串比较(类型文本411, "整32") || 字符串比较(类型文本411, "整64") ||
          字符串比较(类型文本411, "整128") ||
          字符串比较(类型文本411, "正8") || 字符串比较(类型文本411, "正16") ||
          字符串比较(类型文本411, "正32") || 字符串比较(类型文本411, "正64") ||
          字符串比较(类型文本411, "正128") ||
          字符串比较(类型文本411, "浮32") || 字符串比较(类型文本411, "浮64") ||
          字符串比较(类型文本411, "字符");
}

函数 是整数类型文本411(字符串 类型文本411) -> 布尔 {
    返回 字符串比较(类型文本411, "整8") || 字符串比较(类型文本411, "整16") ||
          字符串比较(类型文本411, "整32") || 字符串比较(类型文本411, "整64") ||
          字符串比较(类型文本411, "整128") ||
          字符串比较(类型文本411, "正8") || 字符串比较(类型文本411, "正16") ||
          字符串比较(类型文本411, "正32") || 字符串比较(类型文本411, "正64") ||
          字符串比较(类型文本411, "正128");
}

// 族④：三元运算检查（原 507~526 段）——③ 第六波：三元两分支类型一致性
//   （表达式类型ID 推导·86-a 复审缺陷①：成员/二元精确推导）+ 类型可合并
//   判定 + 返回真值类型（IR 汇合槽按真分支类型读）。443/539：条件段严格
//   布尔检查（宿主 visitTernaryExpr checkCondition 同构）。
函数 检查三元运算表达式(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    // 443/539（253 呈报收口）：条件段严格布尔检查（宿主 visitTernaryExpr
    //   checkCondition(ctx="三元表达式")——整/浮/字符串/字符/函数指针/类/枚举
    //   条件均拒「三元表达式条件必须为布尔类型，实际为 'X'」；原 v2 条件段
    //   类型不强制=拒绝面分叉）。条件段=[子起点, 文本)（文本=真值起点·解析
    //   构建 建节点(节点_三元运算, 真值起点, 假值起点, 起始, 池尾) 布局），
    //   条件末端=文本-1。
    如果 (n.文本 > n.子起点) {
        检查条件布尔(池, 整32(n.文本) - 1, "三元表达式", 符号表, 诊断);
    }
    // ③ 第六波：三元两分支类型一致性——段末端节点递归推导（真值末端=附加-1、
    //   假值末端=子终点-1）；未知(-1)任一侧跳过（级联防）。三段标识符检查由
    //   语句根区间线性遍历覆盖（同二元惯例）。返回真值类型（IR 汇合槽按真分支类型读）
    // 86-a（2026-09-12 复审缺陷①）：改用 表达式类型ID（成员经 推导成员类型ID
    //   精确推导、二元经 推导二元类型ID）——原 检查表达式 对成员恒 整64 兜底
    //   → 聚合分支（乙箱.内盒）与 标识符分支（甲=盒）误报「两分支类型不一致」
    //   （P47/t5 实证）。推导失败（无值）仍跳过（级联防不误伤）。
    可选<整64> 真类型查 = 表达式类型ID(池, 整32(n.附加 - 1), 符号表, 诊断);
    可选<整64> 假类型查 = 表达式类型ID(池, 整32(n.子终点 - 1), 符号表, 诊断);
    // 880 批5：无值=不可推导（原 -1/0 miss 同面）——任一侧无值跳过级联判定
    整64 真类型 = 0;
    如果 (真类型查.有值) { 真类型 = 真类型查.值; }
    整64 假类型 = 0;
    如果 (假类型查.有值) { 假类型 = 假类型查.值; }
    布尔 真可推 = 真类型查.有值; 布尔 假可推 = 假类型查.有值;
    如果 (真可推 && 假可推) {
        如果 (!类型可合并(真类型, 假类型)) {
            表诊断(诊断, "[错误] 三元两分支类型不一致: " + 驻留文本(真类型) +
                   " 与 " + 驻留文本(假类型));
        }
    }
    如果 (真可推) { 返回 真类型; }
    返回 假类型;
}

