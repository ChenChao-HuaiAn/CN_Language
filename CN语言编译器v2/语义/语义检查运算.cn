// CN 自举编译器 v2 · 语义检查·运算表达式检查族（767 拆分：自 语义检查中.cn
//   机械搬移·函数体逐字保留·零逻辑变化——该文件 997 行贴死 1000 冻结线
//   （651 整-浮推断窄改再净增即破线），「先拆再加」纪律执行·357/546 拆分先例同款）
// 职责：二元/三元运算表达式检查族——检查二元运算表达式（操作数递归限定+969
//   混合比较检出+484 混合符号/除零/溢出/移位挂点+157-a 指针算术+空类型/411
//   守卫族）+ 是数值类型文本411/是整数类型文本411（算术/位运算总守卫专用谓词）
//   + 检查三元运算表达式（443/539 条件严格布尔+86-a 两分支类型一致性）。
//   推导族（表达式类型ID/推导成员类型ID/推导二元类型ID）与 497 字面量域定宽、
//   检查块/检查遍历894 留 语义检查中.cn——651/764 在途分支正改 推导二元类型ID，
//   本拆分零触碰该函数（合并零冲突面）。消费=语义检查表达式尾/语义检查语句 等
//   （同包跨模块经合并全局池解析·本模块反消费 表达式类型ID/类型可合并/检查条件布尔）。

导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（目录包名）
导入 IR;         // 容器/结果 合成名判定（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）


函数 检查二元运算表达式(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    // 灰色点②方案A（2026-09-04 用户裁决）：字符串比较运算符显式拒绝——
    //   规范 plans/001 Task 2.8（比较运算符仅整型/浮点变体，字符串不参与
    //   运算符比较；等价能力 字符串比较（相等）/字符串字典序（全序））。
    //   原按指针地址放行=同内容异地址 ==/!= 恒假（拼接产物静默陷阱）。
    //   操作数类型经区间末端节点递归推导（三元同款技巧）：二元节点布局契约
    //   （970/450/469 同口径·原注「子起点=右起点」系旧错述一并纠正）=
    //   附加=右操作数起点（全构建形态不变量）——左末=附加-1、
    //   右末=本节点索引-1。字面量/标识符形态可靠推导；拼接产物/成员字段
    //   推导 -1/整64 兜底=检不出（v2 类型推导既有半实现面，诚实边界——
    //   随 v2 语义类型推导完善收口，宿主侧已全形态覆盖）。返回 -1（比较
    //   产物类型不参与下游推导；三元末端为二元时原亦 -1 跳过，无回归）
    字符串 op文本 = 字符串复制(驻留文本(整64(n.文本)));
    布尔 是比较符 = 字符串比较(op文本, "==") || 字符串比较(op文本, "!=") ||
                   字符串比较(op文本, "<") || 字符串比较(op文本, ">") ||
                   字符串比较(op文本, "<=") || 字符串比较(op文本, ">=");
    // 混合符号二元运算拒绝（2026-09-10 第五十一轮 方案A 用户裁决，Rust
    //   对齐；规范 plans/001 §3.7）：检查范围自比较符扩至算术/位运算符——
    //   「变量间」整N vs 正M 诊断拒绝（检查混合符号二元，语义检查表达式
    //   模块；字面量豁免含 -1 形态；类型 -1 跳过=检不出诚实边界同上）。
    布尔 是算术位符 = 字符串比较(op文本, "+") || 字符串比较(op文本, "-") ||
                    字符串比较(op文本, "*") || 字符串比较(op文本, "/") ||
                    字符串比较(op文本, "%") || 字符串比较(op文本, "&") ||
                    字符串比较(op文本, "|") || 字符串比较(op文本, "^") ||
                    字符串比较(op文本, "<<") || 字符串比较(op文本, ">>");
    // 484（469 同轮·守卫同步对齐）：进块守卫 子起点>0 → 附加>0&&附加<=池大小
    //   （469 形态取反·下方 414 面守卫同款）——守卫口径与左末索引口径（附加-1）
    //   一致，兼收越界防御（旧 子起点>0 不保证 附加 有效）。
    如果 ((是比较符 || 是算术位符) && n.附加 > 0 && n.附加 <= 整32(池.大小())) {
        // 带诊断操作数递归限定比较符（灰色点②既有行为——诊断双报形态已
        //   被 174 等负测 expected 固化，不得扩面）；算术/位运算符的混合
        //   符号检查由 检查混合符号二元 静默自推导（零诊断副作用）
        // 966（166 立法 v2 同构·用户裁决 2026-10-02）：字符串×字符串 比较符
        //   放行为内容/字典序比较（宿主 962 同轮对齐——001 §比较语义修订版）。
        //   原「灰色点②方案A 显式拒绝」废止；生成层分派 __cn_str_eq/__cn_str_cmp
        //   （生成表达式运算.cn 发射字符串比较）。子表达式递归检查保留（诊断
        //   副作用）。
        // 969（166-001 根治·用户质询立案）：混合比较形态检出——比较符双侧末端
        //   推导均有效（非 -1）时按宿主同款拒绝（semantic_expr_op 指针/数值
        //   混合诊断）：一侧 字符串/字符* 且另一侧非 字符串/字符*/空类型*（数值
        //   等）→ 拒。双侧字符串=966 放行；判空 s==无（推导 -1 或 空类型*）两态
        //   均不触拒绝=保留（宿主 Task 6.2 通道）。推导 -1 兜底=检不出（既有
        //   半实现面·与字面量/变量主踩坑面正交）。
        如果 (是比较符) {
            // 970（168 根治·索引口径修正）：比较节点池布局=子起点存左操作数
            //   **起点**、附加存右操作数**起点**（解析二元循环 普通二元契约）——
            //   左操作数**末端** = 附加-1（右起点前一节点）；原 子起点-1 = 左
            //   操作数之前节点（`x && a == b` 取到 x → 把 a==b 误读 x==b →
            //   969 检出报 布尔×字符串＝168 立案的现象层；旧 966 前代码同错
            //   但只致漏报）。右末端=节点索引-1 不变（右操作数紧邻本节点前）。
            整64 左末端索引 = 整64(n.附加) - 1;
            登记零值比较失格548(池, 整32(左末端索引), 节点索引, 符号表);   // 548 比较参与=零值失格
            整64 左类型比 = 检查表达式(池, 整32(左末端索引), 符号表, 诊断);
            整64 右类型比 = 检查表达式(池, 整32(节点索引 - 1), 符号表, 诊断);
            // 933（任务 933·双侧零分叉）：引用返回字符串调用读值归一——用户类
            //   方法调用在 检查表达式 面=「整64 兜底」（648 归档：方法返回在 IR
            //   层调用面精确决议；语义层扫描面=常态回退）——直判单点=语义层
            //   是引用返回字符串调用933语义（标识符/容器签名/用户类方法表三源）。
            //   原 `b.读名() == "盒名"` 左类型=整64 → 969 混合拒（宿主放行）=
            //   双侧分叉；归一后双侧字符串 → 966 放行内容比较。
            如果 (左类型比 != 驻留("字符串") &&
                是引用返回字符串调用933语义(池, 整32(左末端索引), 符号表)) {
                左类型比 = 驻留("字符串");
            }
            如果 (右类型比 != 驻留("字符串") &&
                是引用返回字符串调用933语义(池, 整32(节点索引 - 1), 符号表)) {
                右类型比 = 驻留("字符串");
            }
            // 969 补（全量 20 例误伤根治）：「无」=节点_整数字面量·附加=1（153-a
            //   空指针字面量标记）·检查表达式 走整数字面量分支直返 整32——判空
            //   通道必须按 AST 末端节点直判（推导值无法区分 无 与真实整数）。
            节点 右末端 = 池.元素(整32(节点索引 - 1));
            布尔 右是无 = 右末端.类型 == 节点_整数字面量 && 右末端.附加 == 1;
            节点 左末端 = 池.元素(整32(左末端索引));
            布尔 左是无 = 左末端.类型 == 节点_整数字面量 && 左末端.附加 == 1;
            布尔 左串侧 = 左类型比 == 驻留("字符串") || 左类型比 == 驻留("字符*");
            布尔 右串侧 = 右类型比 == 驻留("字符串") || 右类型比 == 驻留("字符*");
            布尔 左空 = 左类型比 == 驻留("空类型*") || 左是无;
            布尔 右空 = 右类型比 == 驻留("空类型*") || 右是无;
            布尔 双侧有效 = 左类型比 != -1 && 右类型比 != -1;
            如果 (双侧有效 && ((左串侧 && !右串侧 && !右空) || (右串侧 && !左串侧 && !左空))) {
                表诊断(诊断, "[错误] 指针只能与指针或空指针比较（字符串/字符* 不能与数值等非指针类型比较）——字符串内容比较请两侧均为 字符串 类型");
            }
        }
        // 484（450 同族第五轮·左末口径统一 子起点-1→附加-1）：混合符号左末端
        //   取 附加-1（全构建形态契约：附加=右操作数起点→左操作数末端=附加-1；
        //   970/450/469 同口径）。探针实证（484 修前修后对照）：普通面 附加=子起
        //   点=右起点两口径等价；复合赋值/自增合成二元（解析表达式兜底语句 建节
        //   点·回退重析池不删）子起点-1=首次解析左值末节点、附加-1=左值副本末
        //   节点——两者**同文本同形态**（重析=同 token 重放）→推导同型·差分被
        //   吸收（pa 拒/pb 拒/pc 放行 修前修后三态全同=零回归）。
        检查混合符号二元(池, 整32(n.附加 - 1), 整32(节点索引 - 1),
                        符号表, 诊断);
        // 157-a（V3 缺陷修复——A1 v2 挂点全覆盖）：**指针算术**（裸指针
        //   ± 整数）——155-a 的 A1 挂点仅在 推导二元类型ID（指针变量经
        //   类型ID 推导返 -1=全路径失效，实测声明/赋值皆零命中）；本处改
        //   用 表查找类型ID（声明类型文本）+ 是裸指针类型文本 判定——与
        //   B8/A2 判定机制同族，声明/赋值/表达式全路径覆盖。
        检查常量除零474(池, n, 节点索引, op文本, 符号表, 诊断);
        检查常量算术溢出预演474(池, n, 节点索引, op文本, 是算术位符, 诊断);
        检查常量移位超宽474(池, n, 节点索引, op文本, 符号表, 诊断);
        如果 (字符串比较(op文本, "+") || 字符串比较(op文本, "-")) {
            布尔 左指针a1 = 假;
            布尔 右指针a1 = 假;
            // 484（450 同族第五轮·左末口径统一 子起点-1→附加-1）：A1 左末端
            //   取 附加-1=左值副本末节点（同型吸收论证同上 检查混合符号二元 调用
            //   位·pa 探针修前修后同拒实证）。
            节点 左a1 = 池.元素(整32(n.附加 - 1));
            如果 (左a1.类型 == 节点_标识符) {
                // v2 符号登记语义：指针变量登记**所指类型**（B8 同款注释：
                //   「指针变量表命中即返回所指类型」）——故判定用 查语义
                //   指针变量（非 表查找类型ID，后者对 整64* q 返 整64）。
                整64 查左a1 = 查语义指针变量(整64(左a1.文本));
                如果 (查左a1 >= 0) {
                    如果 (!字符串比较(字符串复制(驻留文本(查左a1)), "字符")) {
                        左指针a1 = 真;   // 字符* 排除（字符串视图=波 1 同族）
                    }
                }
            } 否则 如果 (左a1.类型 == 节点_二元运算) {
                // 1064（#1040 派生·表达式操作数扩展）：(p+1) 等 ± 链同判——
                //   宿主 reportUnsafeBoundary 按操作数类型 isPointer 全形态
                //   触发（(p+1)-(p+2) 外层节点亦报），此行对齐表达式面。
                整64 层左a1 = 0;
                左指针a1 = 指针值表达式元素1064(池, 整32(n.附加 - 1), 层左a1) > 0;
            }
            节点 右a1 = 池.元素(整32(节点索引 - 1));
            如果 (右a1.类型 == 节点_标识符) {
                整64 查右a1 = 查语义指针变量(整64(右a1.文本));
                如果 (查右a1 >= 0) {
                    如果 (!字符串比较(字符串复制(驻留文本(查右a1)), "字符")) {
                        右指针a1 = 真;
                    }
                }
            } 否则 如果 (右a1.类型 == 节点_二元运算) {
                整64 层右a1 = 0;
                右指针a1 = 指针值表达式元素1064(池, 整32(节点索引 - 1), 层右a1) > 0;
            }
            如果 (左指针a1 || 右指针a1) {
                错误不安全边界(诊断, "指针算术", "指针 +/- 整数");
            }
        }
        // 609-a（T100·425 对齐宿主 visitBinaryExpr 空类型面·Rust () 同款）：
        //   空类型调用结果参与运算拒绝。类型经 表达式类型ID 推导族+静默诊断
        //   缓冲（174 教训惯例：二次推导诊断吞弃·语句根区间遍历=权威诊断点）；
        //   语句级单独调用不入本判定=合法（打印(x); 同族）。方向词对齐宿主
        //   visitBinaryExpr（左/右 操作数是空类型调用结果）。
        整64 空类型609 = 驻留("空类型");
        向量<字符串> 静默诊断609 = 向量<字符串>();
        整64 左类型609 = 0 - 1;
        整64 右类型609 = 0 - 1;
        // 484（450 同族第五轮·左末口径统一 子起点-1→附加-1）：609 左操作数
        //   末端取 附加-1（同型吸收论证同上·合成面 左值副本与首次解析左值同型
        //   →推导同型零变化；左值类型恒非「空类型」（空类型无变量/字段）·差分
        //   双重吸收=零回归）。
        如果 (!是副作用内置被调(池, 整32(n.附加 - 1))) {
            左类型609 = 表达式类型ID(池, 整32(n.附加 - 1), 符号表, 静默诊断609);
        }
        如果 (!是副作用内置被调(池, 整32(节点索引 - 1))) {
            右类型609 = 表达式类型ID(池, 整32(节点索引 - 1), 符号表, 静默诊断609);
        }
        //   调用形态限定：空类型表达式只能来自调用（文案即「调用结果」）——
        //   指针变量（空类型* p）经 表查找类型ID 返回**所指类型**裸「空类型」
        //   （符号登记语义·34_file `写句柄 != 无` 全量实锤误伤面）——非调用
        //   末端一律不判，杜绝该族误伤。
        如果 (左类型609 == 空类型609 &&
             池.元素(整32(n.附加 - 1)).类型 == 节点_调用) {
            表诊断(诊断, "[错误] 空类型（无返回值）不能参与运算：左 操作数是空类型调用结果（Rust () 同款——无返回值却有值违反类型安全；如需值请改函数返回类型）");
        }
        如果 (右类型609 == 空类型609 &&
             池.元素(整32(节点索引 - 1)).类型 == 节点_调用) {
            表诊断(诊断, "[错误] 空类型（无返回值）不能参与运算：右 操作数是空类型调用结果（Rust () 同款——无返回值却有值违反类型安全；如需值请改函数返回类型）");
        }
    }
    // 414 P0-2/P1-2（审查·权威诊断面单点·外层级=比较符+算术位符全覆盖）：命中=
    //   两道使用点校验（个数+右参隐式转换·宿主 resolveOperatorOverload 逐字同构）；
    //   左操作数为类且未命中重载=报宿主「不兼容」文案（P1-2·替代原「要求数值
    //   操作数」分叉文案）。op∉二元重载符号集（位运算五算子）或左推导不可靠=
    //   不进本块（内置守卫照旧）。重载面411/左类未命中414 供下方算术位符守卫豁免。
    布尔 重载面411 = 假;
    布尔 左类未命中414 = 假;
    如果 (是二元重载符号(op文本) && n.附加 > 0 && n.附加 <= 整32(池.大小())) {
        向量<字符串> 静默L414 = 向量<字符串>();
        整64 左ID414 = 表达式类型ID(池, 整32(n.附加) - 1, 符号表, 静默L414);
        如果 (左ID414 > 0 && 是用户类ID(左ID414)) {
            整64 方法名ID414 = 整64(驻留("运算符" + op文本));
            如果 (查类方法定义层(左ID414, 方法名ID414) != 0) {
                重载面411 = 真;
                检查二元重载使用点(池, 节点索引, 符号表, 诊断);
            } 否则 {
                左类未命中414 = 真;
                表诊断(诊断, "[错误] 运算符 '" + op文本 + "' 与类型 '" +
                            驻留文本(左ID414) +
                            "' 不兼容（无内置匹配且类无对应运算符重载）");
            }
        }
    }
    // 411/412（406 采样轮·算术/位运算操作数总守卫·宿主 checkArithmeticBinary/
        //   checkBitwiseBinary 同构·文案逐字对齐）：拼接/指针算术（A1 挂点）等
        //   合法特判之外，四则操作数须数值（整N/正M/浮N/字符——979 字符四字节
        //   窄整语义·'a'+1=98 合法面 690 用例锚）、位运算操作数须整数（001 §4.4
        //   ——修前浮点位运算 v2 放行宿主拒=412 分叉·布尔四则布尔化/字符串减法/
        //   枚举算术=411 三族双侧同病）。类型经 推导源类型文本（字面量直判+
        //   标识符符号表+枚举成员·本批收口）；「未知」=检不出放行（诚实边界·
        //   推导源类型ID静默 同纪律）；「空类型」面=指针算术 A1 挂点已管辖（安全
        //   区拒/不安全区放行）本守卫跳过防误伤 FFI 形态。
        如果 (是算术位符) {
            // 425 左末索引根治（2026-10-11·09_integration 实录）：二元节点契约=
            //   子起点=左操作数**首**节点、附加=右操作数起点（解析表达式中 339
            //   建节点）→ 左末端=附加-1。原 子起点-1=左首前一节点（错位·970 同
            //   族）：本例 `p < 名单 + 人数` 内层 + 的左末被取成条件左端 p——
            //   误报「'学生' 与 '整32'」；而真左末 名单（学生[5]）走指针算术
            //   豁免放行（宿主 visitBinaryExpr 数组退化同语义）。
            字符串 左类型411 = 推导源类型文本(池, 整32(n.附加 - 1), 符号表, "未知");
            字符串 右类型411 = 推导源类型文本(池, 整32(节点索引 - 1), 符号表, "未知");
            布尔 双侧有效411 = !字符串比较(左类型411, "未知") &&
                             !字符串比较(右类型411, "未知");
            布尔 空类型面411 = 字符串比较(左类型411, "空类型") ||
                             字符串比较(右类型411, "空类型");
            布尔 取余411 = 字符串比较(op文本, "%");
            布尔 位运算412 = 字符串比较(op文本, "&") ||
                           字符串比较(op文本, "|") || 字符串比较(op文本, "^") ||
                           字符串比较(op文本, "<<") || 字符串比较(op文本, ">>");
            // 拼接豁免（宿主 checkStringConcatAndPtrArithmetic 提前 return 同构·
            //   79_v2 自举树误伤根治）：+ 且左操作数 字符串/字符* =拼接语境
            //   （§253 左串触发右数值/布尔/枚举隐式转字符串）——宿主经拼接分支
            //   return 不进总守卫，v2 无 return 机制须内建豁免；v2 树诊断文案
            //   构造「文本+值」遍地·漏豁免=自举链全红实证。
            // 末端节点可靠形态限定（79_v2 自举树误伤根治·推导源类型ID静默 同
            //   诚实边界纪律）：操作数末端为 标识符/字面量/成员 时类型推导可靠
            //   （三族命中面 真+真/甲-乙/色.红 全在可靠面内）；末端=二元/调用等
            //   复合形态时 子起点-1 索引可能错位取到前表达式节点（970 同族·左末
            //   被推导成前语句比较式的「布尔」·自举树 200/209/214/286 四处实证）
            //   ——不判（宿主全形态守卫在位·v2 可靠面执法不退步）。
            节点 左末411 = 池.元素(整32(n.附加 - 1));
            节点 右末411 = 池.元素(整32(节点索引 - 1));
            布尔 左可靠411 = 左末411.类型 == 节点_标识符 ||
                           左末411.类型 == 节点_整数字面量 ||
                           左末411.类型 == 节点_浮点字面量 ||
                           左末411.类型 == 节点_字符串字面量 ||
                           左末411.类型 == 节点_布尔字面量 ||
                           左末411.类型 == 节点_字符字面量 ||
                           左末411.类型 == 节点_成员;
            布尔 右可靠411 = 右末411.类型 == 节点_标识符 ||
                           右末411.类型 == 节点_整数字面量 ||
                           右末411.类型 == 节点_浮点字面量 ||
                           右末411.类型 == 节点_字符串字面量 ||
                           右末411.类型 == 节点_布尔字面量 ||
                           右末411.类型 == 节点_字符字面量 ||
                           右末411.类型 == 节点_成员;
            布尔 拼接面411 = 字符串比较(op文本, "+") &&
                           (字符串比较(左类型411, "字符串") ||
                            字符串比较(左类型411, "字符*"));
            // 425（wt425·09_integration 实录·宿主 checkStringConcatAndPtrArithmetic
            //   指针算术分支同构）：+/- 且某侧命中指针值面 → 指针算术面——
            //   不进数值性总守卫（宿主对指针算术提前 return 同语义；不安全边界
            //   由上方 A1 挂点管辖·不安全函数内合法）。真指针 ± 指针/整数在左
            //   的拒绝面按宿主文案单独执法。
            // 1064（#1040 派生缺口·表达式操作数扩展）：指针值面=①标识符命中
            //   语义指针变量表（94-a：指针声明与数组名退化都登记此表；字符*
            //   借用视图豁免与 A1 挂点同款）；②二元 ± 链——指针值表达式元素
            //   1064 推导（(p+1)/(p+n) 等·丢星族收口面）。两侧元素/层数一并
            //   捕获（左元425/左层425 等），1040 同型判定对两形态统一消费。
            布尔 左指针面425 = 假;
            布尔 右指针面425 = 假;
            整64 左元425 = 0;
            整64 右元425 = 0;
            整64 左层425 = 0;
            整64 右层425 = 0;
            如果 (字符串比较(op文本, "+") || 字符串比较(op文本, "-")) {
                如果 (左末411.类型 == 节点_标识符) {
                    整64 查左425 = 查语义指针变量(整64(左末411.文本));
                    如果 (查左425 >= 0 &&
                         !字符串比较(字符串复制(驻留文本(查左425)), "字符")) {
                        左指针面425 = 真;
                        左元425 = 查左425;
                        左层425 = 查语义指针层数(整64(左末411.文本));
                    }
                } 否则 如果 (左末411.类型 == 节点_二元运算) {
                    左元425 = 指针值表达式元素1064(池, 整32(n.附加 - 1), 左层425);
                    左指针面425 = 左元425 > 0;
                }
                如果 (右末411.类型 == 节点_标识符) {
                    整64 查右425 = 查语义指针变量(整64(右末411.文本));
                    如果 (查右425 >= 0 &&
                         !字符串比较(字符串复制(驻留文本(查右425)), "字符")) {
                        右指针面425 = 真;
                        右元425 = 查右425;
                        右层425 = 查语义指针层数(整64(右末411.文本));
                    }
                } 否则 如果 (右末411.类型 == 节点_二元运算) {
                    右元425 = 指针值表达式元素1064(池, 整32(节点索引 - 1), 右层425);
                    右指针面425 = 右元425 > 0;
                }
            }
            布尔 指针算术面425 = 左指针面425 || 右指针面425;
            // 1064：可判面=可靠形态（既有）或二元 ± 链（推导族 1064 补星接通
            //   的表达式面——本文件单边面零新增，条件全用命名布尔）。
            布尔 左可判425 = 左可靠411 || 左末411.类型 == 节点_二元运算;
            布尔 右可判425 = 右可靠411 || 右末411.类型 == 节点_二元运算;
            如果 (双侧有效411 && 左可判425 && 右可判425 && 指针算术面425 &&
                 左指针面425 && 右指针面425) {
                // 1040（2026-10-18 任务 1040 用户批甲·001 §5.3 清单 #1 扩充）：
                //   同型指针差（尾-首）＝不安全函数内合法（结果=有符号整64
                //   元素个数·IR 发射 (字节差)/元素宽）——宿主
                //   checkStringConcatAndPtrArithmetic 同判零分叉。
                //   同型=元素类型ID与指针层数双等（425 面已排除「字符」元素=
                //   字符串/字符* 视图不适用指针差）；op 必须「-」；「+」与异型
                //   拒绝面保留/新增（文案与宿主逐字一致）。1064：同型判定改经
                //   捕获值（左元425/左层425——标识符/表达式两形态统一）。
                布尔 同型指针差1040 = 假;
                布尔 减面1040 = 字符串比较(op文本, "-");
                如果 (减面1040) {
                    同型指针差1040 = 左元425 > 0 && 左元425 == 右元425 &&
                        左层425 == 右层425;
                }
                如果 (!同型指针差1040) {
                    如果 (减面1040) {
                        表诊断(诊断, "[错误] 指针差要求两个指针同型");
                    } 否则 {
                        表诊断(诊断, "[错误] 两个指针不能做算术运算");
                    }
                }
            }
            如果 (双侧有效411 && 左可判425 && 右可判425 && 指针算术面425 &&
                 !左指针面425 && 右指针面425) {
                表诊断(诊断, "[错误] 整数不能与指针做算术运算（仅支持 指针 ± 整数）");
            }
            如果 (双侧有效411 && 左可判425 && 右可判425 && 指针算术面425 &&
                 左指针面425 && !右指针面425 && !是整数类型文本411(右类型411)) {
                表诊断(诊断, "[错误] 指针算术要求整型偏移，实际为 '" + 右类型411 + "'");
            }
            如果 (双侧有效411 && 左可靠411 && 右可靠411 && !空类型面411 && !拼接面411 && !重载面411 && !左类未命中414 && !指针算术面425 && 取余411 &&
                 (!是整数类型文本411(左类型411) || !是整数类型文本411(右类型411))) {
                表诊断(诊断, "[错误] '%'取余运算要求整数操作数");
            }
            如果 (双侧有效411 && 左可靠411 && 右可靠411 && !空类型面411 && !拼接面411 && !重载面411 && !左类未命中414 && !指针算术面425 && 位运算412 &&
                 (!是整数类型文本411(左类型411) || !是整数类型文本411(右类型411))) {
                表诊断(诊断, "[错误] 位运算要求整数操作数，实际为 '" + 左类型411 +
                            "' 与 '" + 右类型411 + "'");
            }
            如果 (双侧有效411 && 左可靠411 && 右可靠411 && !空类型面411 && !拼接面411 && !重载面411 && !左类未命中414 && !指针算术面425 && !取余411 && !位运算412 &&
                 (!是数值类型文本411(左类型411) || !是数值类型文本411(右类型411))) {
                表诊断(诊断, "[错误] 算术运算符要求数值操作数，实际为 '" + 左类型411 +
                            "' 与 '" + 右类型411 + "'");
            }
    }
    返回 -1;
}

// 411/412 数值/整数类型文本判定（算术/位运算总守卫专用·宿主 isNumeric/isInteger
//   同构）：数值=整N/正M/浮N 全族+字符（979 字符窄整·四则合法面）；整数=整N/
//   正M 全族（位运算/取余面——字符不算·宿主 isInteger("字符")=假·字符&1 拒
//   实测对齐）。全名枚举比较（中文类型名 UTF-8 首字节同值不可前缀判·直白零歧义）。
函数 是数值类型文本411(字符串 类型文本411) -> 布尔 {
    返回 字符串比较(类型文本411, "整8") || 字符串比较(类型文本411, "整16") ||
          字符串比较(类型文本411, "整32") || 字符串比较(类型文本411, "整64") ||
          字符串比较(类型文本411, "整128") ||
          字符串比较(类型文本411, "正8") || 字符串比较(类型文本411, "正16") ||
          字符串比较(类型文本411, "正32") || 字符串比较(类型文本411, "正64") ||
          字符串比较(类型文本411, "正128") ||
          字符串比较(类型文本411, "浮32") || 字符串比较(类型文本411, "浮64") ||
          字符串比较(类型文本411, "字符");
}

函数 是整数类型文本411(字符串 类型文本411) -> 布尔 {
    返回 字符串比较(类型文本411, "整8") || 字符串比较(类型文本411, "整16") ||
          字符串比较(类型文本411, "整32") || 字符串比较(类型文本411, "整64") ||
          字符串比较(类型文本411, "整128") ||
          字符串比较(类型文本411, "正8") || 字符串比较(类型文本411, "正16") ||
          字符串比较(类型文本411, "正32") || 字符串比较(类型文本411, "正64") ||
          字符串比较(类型文本411, "正128");
}

// 族④：三元运算检查（原 507~526 段）——③ 第六波：三元两分支类型一致性
//   （表达式类型ID 推导·86-a 复审缺陷①：成员/二元精确推导）+ 类型可合并
//   判定 + 返回真值类型（IR 汇合槽按真分支类型读）。443/539：条件段严格
//   布尔检查（宿主 visitTernaryExpr checkCondition 同构）。
函数 检查三元运算表达式(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    // 443/539（253 呈报收口）：条件段严格布尔检查（宿主 visitTernaryExpr
    //   checkCondition(ctx="三元表达式")——整/浮/字符串/字符/函数指针/类/枚举
    //   条件均拒「三元表达式条件必须为布尔类型，实际为 'X'」；原 v2 条件段
    //   类型不强制=拒绝面分叉）。条件段=[子起点, 文本)（文本=真值起点·解析
    //   构建 建节点(节点_三元运算, 真值起点, 假值起点, 起始, 池尾) 布局），
    //   条件末端=文本-1。
    如果 (n.文本 > n.子起点) {
        检查条件布尔(池, 整32(n.文本) - 1, "三元表达式", 符号表, 诊断);
    }
    // ③ 第六波：三元两分支类型一致性——段末端节点递归推导（真值末端=附加-1、
    //   假值末端=子终点-1）；未知(-1)任一侧跳过（级联防）。三段标识符检查由
    //   语句根区间线性遍历覆盖（同二元惯例）。返回真值类型（IR 汇合槽按真分支类型读）
    // 86-a（2026-09-12 复审缺陷①）：改用 表达式类型ID（成员经 推导成员类型ID
    //   精确推导、二元经 推导二元类型ID）——原 检查表达式 对成员恒 整64 兜底
    //   → 聚合分支（乙箱.内盒）与 标识符分支（甲=盒）误报「两分支类型不一致」
    //   （P47/t5 实证）。推导失败 -1 仍跳过（级联防不误伤）。
    整64 真类型 = 表达式类型ID(池, 整32(n.附加 - 1), 符号表, 诊断);
    整64 假类型 = 表达式类型ID(池, 整32(n.子终点 - 1), 符号表, 诊断);
    如果 (真类型 != -1 && 假类型 != -1) {
        如果 (!类型可合并(真类型, 假类型)) {
            表诊断(诊断, "[错误] 三元两分支类型不一致: " + 驻留文本(真类型) +
                   " 与 " + 驻留文本(假类型));
        }
    }
    如果 (真类型 != -1) { 返回 真类型; }
    返回 假类型;
}

// ==================== 926/615：指针成员访问安全区边界判定（外移） ====================
// 926（宿主 semantic_expr_access.cpp visitMemberExpr B9 同构·154-a v2 挂点自
//   推断面迁主面）：**指针成员访问安全区边界**——. 左侧（显式解引用抵销后的
//   层数 N-k）仍是指针（>=1）→ 非 不安全 函数内报（错误不安全边界 内建豁免）。
//   宿主判定=isDerefAccess(对象指针) ∧ 非赋值目标（assignmentTargetDepth_==0）
//   ∧ 非字符串语义 ∧ 非 自身.字段——本面逐条同构：①N-k>=1（k=链区间显式解引用
//   段数；`(*p).x` 抵销后非指针=宿主放行面）②写目标链（赋值左值区间 926）
//   不报（宿主 depth>0 抑制）③字符*（字符串视图·N-k==1 且基名=字符）豁免
//   （宿主 isStringSemanticType）④数组名（符号类型文本数组形态=宿主
//   isPointer(数组文本)=假）排除⑤自身 不入指针层数表天然 N=0 放行（宿主
//   thisMemberAccess 等价）。多级（N-k>=2）在同门内续报（宿主 B9+多级双报
//   同序——修前 v2 单报=诊断面分叉同轮收口）。数据源=615 层数表/显解层数
//   单点复用。节点级去重（标记成员检查926）：894-a 自增表达式双重遍历
//   （表达式语句外层区间遍历+检查自增表达式区间618 内层遍历）会重复到达同一
//   节点——宿主单遍=1 诊断（r12 实录 v2 曾 2 条）；首次门=「已报即跳过」，
//   双报形态（pp.x++）首遍 B9+多级、重复遍零报，与宿主单遍双诊断同口径。
//   诚实边界：对象=成员/下标/调用链形态（层数表仅标识符键）不在本面——与 615
//   多级拦截同口径（该形态宿主语义诊断/v2 [ir2] 双拒面，非放行分叉）。
// 实现外移（语义检查.cn 撞 1000 冻结线·「先拆再加」纪律·767 拆分同款）：
//   归属=本文件指针边界族（A1 指针算术挂点同文件）。n=成员节点（诊断文案取
//   n.文本）；对象615/显解层数615=调用方链区间扫描结果。
// 1175（安全区对齐）：类型文本尾连续 '*' 层数（0=非指针；引用 '&' 不计）。
//   消费=检查指针成员边界926 链对象面——成员字段真类型（含星）判层；
//   双边界=0..255（指针层上限，超出=畸形文本按 0 层不报，交既有类型诊断）。
函数 尾星层数1175(字符串 文本1175x) -> 整64 {
    整64 长1175x = 字符串长度(文本1175x);
    整64 星1175x = 0;
    当 (星1175x < 长1175x) {
        整64 位1175x = 整64(文本1175x[整32(长1175x - 1 - 星1175x)]) & 255;
        如果 (位1175x != 42) { 中断; }
        星1175x++;
    }
    返回 星1175x;
}

// 1175（安全区对齐·声明链类型文本）：按**声明**解析链节点类型文本（含尾星）——
//   标识符: 符号表类型文本；成员: 父链文本 → 基名（剥 '$'/'<' 实例实参）→
//   先结构体字段表（非泛型/已登记）后类声明扫描（泛型基类=语义期实例布局未
//   登记·语法期字段类型节点 附加 低 8 位=指针层）。非声明链（调用/下标/一元
//   等）返回空串=不适用本回退（交既有边界）；空串/0 层=不可判定不报告。
函数 链类型文本1175(向量<节点> 池, 整32 节点索引,
                    向量<映射<整64, 符号>>& 符号表) -> 字符串 {
    节点 链节点1175 = 池.元素(节点索引);
    如果 (链节点1175.类型 == 节点_标识符) {
        整64 类型ID = 0;
        可选<整64> 类型ID查 = 表查找类型ID(符号表, 整64(链节点1175.文本));
        如果 (类型ID查.有值) { 类型ID = 类型ID查.值; }
        // 原 <=0 判定：miss 与登记值 0 同走「不适用」空串（880 批5 显式保留）
        如果 (!类型ID查.有值 || 类型ID == 0) {
            返回 "";
        }
        返回 字符串复制(驻留文本(类型ID));
    }
    //   =不适用，非业务默认值）。
    如果 (链节点1175.类型 != 节点_成员) { 返回 ""; }
    整64 父索引 = 整64(链节点1175.子起点);
    如果 (父索引 < 0 || 父索引 >= 整64(池.大小())) { 返回 ""; }
    字符串 父文 = 链类型文本1175(池, 整32(父索引), 符号表);
    如果 (字符串长度(父文) == 0) { 返回 ""; }
    // 基名=首个 '$'（实例合成）或 '<'（模板文本）之前。
    整64 切 = 0 - 1;
    整64 扫i = 0;
    当 (扫i < 字符串长度(父文)) {
        整64 位i = 整64(父文[整32(扫i)]) & 255;
        布尔 是切点 = 位i == 36 || 位i == 60;
        如果 (切 == 0 - 1 && 是切点) { 切 = 扫i; }
        扫i++;
    }
    字符串 基文 = 父文;
    如果 (切 > 0) { 基文 = 字符串子串(父文, 0, 整32(切)); }
    整64 基ID = 驻留(基文);
    整64 字段ID = 查字段类型ID(基ID, 整64(链节点1175.文本));
    如果 (字段ID > 0) { 返回 字符串复制(驻留文本(字段ID)); }
    整64 类索引 = 查类节点索引(基ID);
    如果 (类索引 < 0) {
        返回 "";
    }
    节点 类值 = 池.元素(整32(类索引));
    整64 扫 = 整64(类值.子起点);
    当 (扫 < 整64(类值.子终点)) {
        节点 声明 = 池.元素(整32(扫));
        布尔 命中字段 = 声明.类型 == 节点_类字段 &&
                        整64(声明.文本) == 整64(链节点1175.文本) &&
                        声明.附加 > 0 &&
                        整64(声明.附加) < 整64(池.大小());
        如果 (命中字段) {
            节点 类型节点 = 池.元素(整32(声明.附加));
            整64 星层 = 整64(类型节点.附加) & 255;   // 低 8 位=指针层
            字符串 文 = 字符串复制(驻留文本(整64(类型节点.文本)));
            整64 星i = 0;
            当 (星i < 星层) {
                文 = 文 + "*";
                星i++;
            }
            返回 文;
        }
        扫++;
    }
    返回 "";
}

// 1175（安全区对齐·链对象指针层）：对象成员（甲.下 的 .下）**声明类型**的
//   指针层数（0=非指针/不可判定）。消费=检查指针成员边界926 链对象面；
//   语义阶段在 IR 实例化之前（语义检查→IR 生成），实例布局/字段类型表尚未
//   登记——查字段类型ID(节点$整32,下) 恒 miss，故回退语法期声明（链类型
//   文本1175 递归：标识符→结构体字段表→泛型基类字段声明扫描）。
函数 链成员指针层1175(向量<节点> 池, 整32 对象成员索引,
                     向量<映射<整64, 符号>>& 符号表, 字符串& 基名出) -> 整64 {
    节点 成员 = 池.元素(对象成员索引);
    如果 (成员.类型 != 节点_成员) { 返回 0; }
    字符串 对象文 = 链类型文本1175(池, 对象成员索引, 符号表);
    如果 (字符串长度(对象文) == 0) { 返回 0; }
    整64 星层 = 尾星层数1175(对象文);
    如果 (星层 >= 1 && 星层 <= 255) {
        基名出 = 剥尾星615(对象文);
    }
    返回 星层;
}

函数 检查指针成员边界926(向量<节点> 池, 整32 节点索引, 节点 n,
                   节点 对象615, 整64 显解层数615,
                   向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    整64 层数615 = 0 - 1;
    // 1175（安全区对齐·926 链对象扩面）：对象=**成员链**（甲.下.值 的 .下）——
    //   原函数对非标识符对象直接返回：1175 前该形态由 IR 链断兜底拒绝（宿主
    //   语义诊断/v2 [ir2] 双拒）；1175 打通泛型实例链后 v2 会静默放行安全函数
    //   内的指针成员访问（g02e 探针：宿主拒/v2 运行空指针错码 3=安全裂缝）。
    //   扩面=对象成员经 推导成员类型ID 取真类型文本，尾连续 '*' 层数入判定；
    //   引用/值/数组形态 0 层不报告（与标识符面同口径；静默诊断向量吸收
    //   推断过程诊断，防与主检查面双报）。
    字符串 基名链926 = "";
    布尔 链对象926 = 假;
    如果 (对象615.类型 == 节点_标识符) {
        层数615 = 查语义指针层数(整64(对象615.文本));
        // 615：静态（顶层/函数内）多级指针——指针层数表（函数级生命周期）
        //   miss/单级时回退静态表（模块级累积·收集静态声明 单点登记；
        //   修 639 后顶层 `点** g;` 放行而 g.x 若不回退=漏拦放行）
        // 926：回退**只增不减**——原无条件覆盖把局部单级指针的 1 覆盖为
        //   静态表 miss 的 -1 → B9（N-k>=1）对局部单级指针整体漏拦
        //   （r1 探针实录）。层静 > 层数 才采纳（局部 1 保持·静态多级补齐）。
        // 882 登记制（门禁四面对照注记）：本函数各阈值为语义阈值判定（层数差分/
        //   表命中/形态判定），非缺省取值类静默面；比较式统一归入命名布尔
        //   （条件外显·另一端各有显式处置：不报告=放行面·见各分支）。
        布尔 需静态回退615 = 层数615 < 2;
        如果 (需静态回退615) {
            整64 层静615 = 查静态指针层数615(整64(对象615.文本));
            布尔 层静更高615 = 层静615 > 层数615;
            如果 (层静更高615) { 层数615 = 层静615; }
        }
    } 否则 如果 (对象615.类型 == 节点_成员 &&
                  整64(n.子起点) < 池.大小()) {
        向量<字符串> 静默926 = 向量<字符串>();
        整64 对象类型926 = 推导成员类型ID(池, 整32(n.子起点), 符号表, 静默926);
        如果 (对象类型926 > 0) {
            字符串 对象文926 = 字符串复制(驻留文本(对象类型926));
            整64 星926 = 尾星层数1175(对象文926);
            如果 (星926 >= 1 && 星926 <= 255) {
                层数615 = 星926;
                基名链926 = 剥尾星615(对象文926);
                链对象926 = 真;
            }
        }
        // 泛型实例面回退（语义阶段实例布局未登记→推导 miss）：按基类声明字段
        //   类型节点的指针层判定（链成员指针层1175·语法期声明单一数据源）。
        如果 (!链对象926) {
            字符串 基名回926 = "";
            整64 回退层926 = 链成员指针层1175(池, 整32(n.子起点), 符号表,
                                                基名回926);
            如果 (回退层926 >= 1 && 回退层926 <= 255) {
                层数615 = 回退层926;
                基名链926 = 基名回926;
                链对象926 = 真;
            }
        }
    }
    整64 差层615 = 层数615 - 显解层数615;   // N-k：. 左侧剩余指针层数
    布尔 报告指针访问926 = 差层615 >= 1;    // B9 条件（左侧仍是指针）
    布尔 报告多级615 = 差层615 >= 2;        // 615 多级拦截条件
    // 926 红修（云端 linux-x86_64 预验 fbe6f0e537：105 接口参数多态/106 接口
    //   去虚拟化 v2 误拦）：**方法调用形态（附加=成员方法标记 -2）单级跳过**
    //   ——「对象.方法()」在宿主 AST 走 semantic_call_member 方法分派（类/接口
    //   单级指针/值对象均成功分派），**不经 visitMemberExpr**（B9/多级不触发·
    //   105/106 宿主 rc=0 + 插桩实测 `图形.面积()`/`cp.取()` 零 visit 行）。
    //   但**多级指针对象的方法调用**（`cpp.取()`——对象仍多级）宿主分派失败
    //   回落 visitMemberExpr → 照报 B9+多级（m3 探针双侧实录）。v2 判定=
    //   方法调用形态仅多级（分派失败面）进入报告；单级跳过（成功分派面）。
    //   字段访问不受影响（附加=字段偏移）。
    布尔 方法调用形态926 = n.附加 == 成员方法标记;
    如果 (方法调用形态926 && !报告多级615) { 返回; }
    如果 (报告指针访问926 && 标记成员检查926(整64(节点索引))) {
        字符串 基名926 = 基名链926;
        整64 全型926 = 0;
        布尔 表型可用926 = 假;
        如果 (!链对象926) {
            整64 基名ID926 = 查语义指针变量(整64(对象615.文本));
            布尔 指针表命中926 = 基名ID926 >= 0;
            如果 (指针表命中926) {
                基名926 = 剥尾星615(字符串复制(驻留文本(基名ID926)));
            }
            可选<整64> 全型926查 = 表查找类型ID(符号表, 整64(对象615.文本));
            // miss 保持 0（下方 >0 判定与原 -1 哨兵同假·880 批5）
            如果 (全型926查.有值) { 全型926 = 全型926查.值; }
            表型可用926 = 全型926 > 0;
            布尔 无基名926 = 字符串长度(基名926) == 0;
            如果 (无基名926 && 表型可用926) {
                基名926 = 剥尾星615(字符串复制(驻留文本(全型926)));
            }
        }
        布尔 单级左侧926 = 差层615 == 1;
        布尔 字符视图926 = 单级左侧926 && 字符串比较(基名926, "字符");
        布尔 数组名926 = 假;
        如果 (表型可用926) {
            数组名926 = 是数组类型文本(字符串复制(驻留文本(全型926)));
        }
        布尔 非写目标926 = !状态在赋值左值区间926(节点索引);
        如果 (!字符视图926 && !数组名926 && 非写目标926) {
            错误不安全边界(诊断, "指针成员访问", "指针成员访问（p.字段）");
        }
        // 615：拦截条件=N-k>=2（. 左侧层数仍多级——与宿主「自动解引用仅
        //   一级」判定同构；显式解引用段 k 已从链区间核出）
        如果 (报告多级615) {
            字符串 基名615 = 基名链926;
            如果 (!链对象926) {
                整64 基名ID615 = 查语义指针变量(整64(对象615.文本));
                布尔 指针表命中615 = 基名ID615 >= 0;
                如果 (指针表命中615) {
                    基名615 = 剥尾星615(字符串复制(驻留文本(基名ID615)));
                }
                布尔 无基名615 = 字符串长度(基名615) == 0;
                如果 (无基名615) {
                    整64 表型615 = 0;
                    可选<整64> 表型615查 = 表查找类型ID(符号表, 整64(对象615.文本));
                    // miss 保持 0（下方 >0 判定与原 -1 哨兵同假·880 批5）
                    如果 (表型615查.有值) { 表型615 = 表型615查.值; }
                    布尔 表型615可用 = 表型615 > 0;
                    如果 (表型615可用) {
                        基名615 = 剥尾星615(字符串复制(驻留文本(表型615)));
                    }
                }
            }
            字符串 星串615 = "";
            整64 星i615 = 0;
            // 615：诊断类型文本=«. 左侧类型»（N-k 星——宿主 objectType 同源；
            //   直访 k=0 时=N 星逐字同构 p615c「点**」锚）
            当 (星i615 < 差层615) {
                星串615 = 星串615 + "*";
                星i615++;
            }
            表诊断(诊断, "多级指针 '" + 基名615 + 星串615 +
                        "' 不自动解引用：请显式 * 解引用一级后再访问成员 '" +
                        字符串复制(驻留文本(整64(n.文本))) + "'");
        }
    }
}

// ==================== 1311 P1-1：回绕内置整数操作数守卫 ====================
// 宿主 checkWrapBuiltinCall 同文案：回绕加/减/乘 两侧 checkExpr 后要求整数
//   （isInteger 秩>0）；字符串/布尔/浮点/指针/容器等非整数实参拒绝。
//   v2 修前只查实参数=2，字符串实参放行后运行期 C0000005、布尔按 0/1、浮点
//   按位模式回绕=与宿主拒绝面分叉。0=推导 miss 不在此误报（由
//   回绕调用返回类型实现474 登记中止——P2-1 禁静默取对侧）。
// 指针实参文本（""=非指针/非标识符）——宿主 checkExpr 指针变量返回带星
//   文本（整32*），isInteger 拒；v2 符号表类型=基类型（秩>0）会误放行，
//   故按 基名+层数星 构造文本供守卫双侧一致拒绝（诊断文案同构）。
函数 回绕指针类型文本474(向量<节点> 池, 整32 节点索引, 整64 实参序,
                    向量<映射<整64, 符号>>& 符号表) -> 字符串 {
    整64 末474p = 查调用实参末位(整64(节点索引), 实参序);
    布尔 末有效474p = 末474p >= 0 && 末474p < 整64(池.大小());
    如果 (末有效474p) {
        节点 根474p = 池.元素(整32(末474p));
        如果 (根474p.类型 == 节点_标识符) {
            布尔 是指针474p = 查语义指针变量(整64(根474p.文本)) >= 0;
            如果 (是指针474p) {
                整64 基ID474p = 0;
                字符串 针文474p = "";
                可选<整64> 基ID474p查 = 表查找类型ID(符号表, 整64(根474p.文本));
                // miss 保持 0（下方 >0 判定与原 -1 哨兵同假·880 批5）
                如果 (基ID474p查.有值) { 基ID474p = 基ID474p查.值; }
                布尔 基有效474p = 基ID474p > 0;
                如果 (基有效474p) { 针文474p = 字符串复制(驻留文本(基ID474p)); }
                整64 层474p = 查语义指针层数(整64(根474p.文本));
                布尔 层有效474p = 层474p >= 1;
                如果 (!层有效474p) { 层474p = 1; }
                整64 星i474p = 0;
                当 (星i474p < 层474p) {
                    针文474p = 针文474p + "*";
                    星i474p++;
                }
                返回 针文474p;
            }
        }
    }
    返回 "";
}

// 比较/逻辑二元表达式实参=布尔（宿主 checkExpr 同口径；语义 推导二元类型ID
//   为推断声明域、比较面不返回布尔，故守卫侧单点识别）。
函数 回绕末端比较布尔474(向量<节点> 池, 整32 节点索引, 整64 实参序) -> 布尔 {
    整64 末474c = 查调用实参末位(整64(节点索引), 实参序);
    布尔 末有效474c = 末474c >= 0 && 末474c < 整64(池.大小());
    布尔 是布474c = 假;
    如果 (末有效474c) {
        节点 根474c = 池.元素(整32(末474c));
        如果 (根474c.类型 == 节点_二元运算) {
            字符串 op474c = 字符串复制(驻留文本(整64(根474c.文本)));
            是布474c = 字符串比较(op474c, "==") || 字符串比较(op474c, "!=") ||
                字符串比较(op474c, "<") || 字符串比较(op474c, "<=") ||
                字符串比较(op474c, ">") || 字符串比较(op474c, ">=") ||
                字符串比较(op474c, "&&") || 字符串比较(op474c, "||");
        }
    }
    返回 是布474c;
}

函数 检查回绕整数实参474(向量<节点> 池, 整32 节点索引,
                    向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 布尔 {
    整64 左类474g = 回绕实参侧类型474(池, 节点索引, 符号表, 0);
    整64 右类474g = 回绕实参侧类型474(池, 节点索引, 符号表, 1);
    字符串 左针474g = 回绕指针类型文本474(池, 节点索引, 0, 符号表);
    字符串 右针474g = 回绕指针类型文本474(池, 节点索引, 1, 符号表);
    布尔 左布474g = 回绕末端比较布尔474(池, 节点索引, 0);
    布尔 右布474g = 回绕末端比较布尔474(池, 节点索引, 1);
    布尔 左是针474g = 字符串长度(左针474g) > 0;
    布尔 右是针474g = 字符串长度(右针474g) > 0;
    布尔 左有型474g = 左类474g > 0;
    布尔 右有型474g = 右类474g > 0;
    布尔 左知474g = 左有型474g || 左布474g || 左是针474g;
    布尔 右知474g = 右有型474g || 右布474g || 右是针474g;
    如果 (左知474g && 右知474g) {
        整64 左秩474g = 整数族类型秩474(左类474g);
        整64 右秩474g = 整数族类型秩474(右类474g);
        如果 (左是针474g || 左布474g) { 左秩474g = 0; }
        如果 (右是针474g || 右布474g) { 右秩474g = 0; }
        布尔 非整数474g = 左秩474g == 0 || 右秩474g == 0;
        如果 (非整数474g) {
            字符串 左文474g = "未知";
            字符串 右文474g = "未知";
            如果 (左有型474g) { 左文474g = 字符串复制(驻留文本(左类474g)); }
            如果 (右有型474g) { 右文474g = 字符串复制(驻留文本(右类474g)); }
            如果 (左是针474g) { 左文474g = 字符串复制(左针474g); }
            如果 (右是针474g) { 右文474g = 字符串复制(右针474g); }
            如果 (左布474g) { 左文474g = "布尔"; }
            如果 (右布474g) { 右文474g = "布尔"; }
            表诊断(诊断, "[错误] 回绕内置要求整数操作数，实际为 '" +
                         左文474g + "' 与 '" + 右文474g + "'");
            返回 假;
        }
    }
    返回 真;
}

// ==================== 1471（安全区对齐·#1471 组合形态执法缺口） ====================
// 缺陷（采样轮 #1467 命中·探针矩阵 a~p 双侧实录）：871-a 解析归一把 `(*p).x`
//   的外层解引用节点**哨兵化**（成员对象改指根标识符·链区间留哨兵计显解层
//   数）——76-a 解引用读挂点（只认存活 节点_解引用·单级形态恰是被哨兵化的
//   那个）与 926 指针成员访问判定（差层=N-k=1-1=0）双 miss → 安全区
//   `(*pb).名()` v2 放行 rc=0·宿主拒「[安全区边界] 裸指针解引用读应在 不安全
//   函数 内（指针解引用（*p））」（零分叉红线）。修复=组合挂点：成员节点链
//   区间显解层数>=1 且对象标识符层数>=1 且读位 → 按宿主 checkDerefUnary B6
//   同文报。写位分派对齐宿主（位判派见下）。
// 状态族（检查赋值语句 同步置位/恢复·与 926 区间同生命周期同惯例）：
//   赋值左值末索引（n.子起点-1·恒不随复合扩区间变；-1=无复合左值）+
//   自增合成标记（右值末二元 子终点==2·894-a 脱糖）。
静态 整32 状态赋值左值末1471 = 0 - 1;
静态 布尔 状态赋值自增合成1471 = 假;
// 止快照（=926 区间止·检查赋值语句 置位时同步写入）：判派函数取值用——
//   跨模块无参访问器（状态读赋值止926）自举解析不达（1471 构建实录未声明），
//   快照单点写（赋值.cn 置/恢复两处）避免跨模块读。
静态 整32 状态赋值止快照1471 = 0 - 1;

函数 状态读赋值左值末1471() -> 整32 {
    返回 状态赋值左值末1471;
}

不安全 函数 状态置赋值左值末1471(整32 值1471s) -> 空类型 {
    状态赋值左值末1471 = 值1471s;
}

函数 状态读赋值自增合成1471() -> 布尔 {
    返回 状态赋值自增合成1471;
}

不安全 函数 状态置赋值自增合成1471(布尔 值1471s) -> 空类型 {
    状态赋值自增合成1471 = 值1471s;
}

函数 状态读赋值止快照1471() -> 整32 {
    返回 状态赋值止快照1471;
}

不安全 函数 状态置赋值止快照1471(整32 值1471s) -> 空类型 {
    状态赋值止快照1471 = 值1471s;
}

// 1471 **事件表**（安全区解引用段·节点级去重·函数级收尾单点报文）：显式解
//   引用节点会被**多通道重复到达**——静默副本通道先行（声明初始化类型校验的
//   静默遍历·其 push 的诊断被丢弃）+ 894-a 自增双重遍历（表达式语句外层区间
//   遍历+检查自增表达式区间618 内层遍历）——到达即报文会双报/漏报（t1/l/m
//   探针实证）。故 76-a（存活解引用节点面）与 1471（哨兵化显解段·成员挂点）
//   两挂点到达时**只登记**（键=节点索引·首登真·行号/写位固化入表），检查
//   函数/检查方法 **收尾**（判定恒空报错 同址·全函数视角）判报解引用事件1471
//   单点报文（诊断行回写=行号固化对齐宿主行锚）——报文通道恒为收尾主诊断
//   向量=副本通道天然免疫；同节点多到达被键去重天然免疫。条数语义=每个显式
//   解引用段 1 条（宿主 checkDerefUnary B6/B7 逐段单报对齐）。
静态 向量<整64> 事件解引用节点1471;
静态 向量<整64> 事件解引用行1471;
静态 向量<整64> 事件解引用位1471;   // 0=读（宿主 B6）1=写直写（宿主 B7）

// 登记（返回真=首登事件入表；假=重复到达跳过）——行号固化（收尾报文行锚）
不安全 函数 登记解引用事件1471(整64 节点索引, 整64 行1471e, 整64 位1471e) -> 布尔 {
    整64 i1471e = 0;
    当 (i1471e < 事件解引用节点1471.大小()) {
        如果 (事件解引用节点1471.元素(整32(i1471e)) == 节点索引) { 返回 假; }
        i1471e++;
    }
    结果<空类型, 整32> 加节1471 = 事件解引用节点1471.追加(节点索引);
    如果 (!加节1471.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加行1471 = 事件解引用行1471.追加(行1471e);
    如果 (!加行1471.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加位1471 = 事件解引用位1471.追加(位1471e);
    如果 (!加位1471.正常) { 运行时错误(4); }
    返回 真;
}

// 收尾单点报文（检查函数/检查方法 函数体检查收尾调用·判定恒空报错 同址同
//   视角——当前函数不安全/重放豁免由 错误不安全边界 收尾时判定=同面豁免）。
//   报序=**行号升序稳定排序**（同行保持登记序·稳定冒泡·事件量=函数内显式
//   解引用段数恒小）——体块检查即时报的诊断（指针算术/静态写等）在向量前段
//   依源序在先·事件报按行插序对齐宿主源序（265_v2 探针矩阵：读 13/写 14 须
//   排在算术 15 之前=宿主输出序）。
不安全 函数 判报解引用事件1471(向量<字符串>& 诊断) -> 空类型 {
    整64 数1471p = 事件解引用节点1471.大小();
    整64 a1471p = 0;
    当 (a1471p < 数1471p) {
        整64 b1471p = 0;
        当 (b1471p < 数1471p - 1 - a1471p) {
            布尔 需换1471p = 事件解引用行1471.元素(整32(b1471p)) >
                           事件解引用行1471.元素(整32(b1471p + 1));
            如果 (需换1471p) {
                整64 节t = 事件解引用节点1471.元素(整32(b1471p));
                整64 行t = 事件解引用行1471.元素(整32(b1471p));
                整64 位t = 事件解引用位1471.元素(整32(b1471p));
                结果<空类型, 整32> 设节 = 事件解引用节点1471.设置(
                    整32(b1471p), 事件解引用节点1471.元素(整32(b1471p + 1)));
                结果<空类型, 整32> 设行 = 事件解引用行1471.设置(
                    整32(b1471p), 事件解引用行1471.元素(整32(b1471p + 1)));
                结果<空类型, 整32> 设位 = 事件解引用位1471.设置(
                    整32(b1471p), 事件解引用位1471.元素(整32(b1471p + 1)));
                结果<空类型, 整32> 设节2 = 事件解引用节点1471.设置(
                    整32(b1471p + 1), 节t);
                结果<空类型, 整32> 设行2 = 事件解引用行1471.设置(
                    整32(b1471p + 1), 行t);
                结果<空类型, 整32> 设位2 = 事件解引用位1471.设置(
                    整32(b1471p + 1), 位t);
                如果 (!设节.正常 || !设行.正常 || !设位.正常 ||
                     !设节2.正常 || !设行2.正常 || !设位2.正常) { 运行时错误(4); }
            }
            b1471p++;
        }
        a1471p++;
    }
    整64 i1471p = 0;
    当 (i1471p < 事件解引用节点1471.大小()) {
        设当前诊断行(整32(事件解引用行1471.元素(i1471p)));
        如果 (事件解引用位1471.元素(i1471p) == 1) {
            错误不安全边界(诊断, "裸指针解引用写",
                           "指针解引用写（*p = x）");
        } 否则 {
            错误不安全边界(诊断, "裸指针解引用读",
                           "指针解引用（*p）");
        }
        i1471p++;
    }
    清空解引用事件1471();
}

不安全 函数 清空解引用事件1471() -> 空类型 {
    事件解引用节点1471.清空();
    事件解引用行1471.清空();
    事件解引用位1471.清空();
}

// 1471 写位判派（宿主 assignmentTargetDepth_ 抑制语义的 v2 落点·三态）：
//   0=读位（报「裸指针解引用读」）；1=赋值左值末解引用直写（76-a 面报
//   「裸指针解引用写」=宿主 B7 checkUnaryCallAssignTarget）；2=写目标链中/
//   复合赋值副本链/自增合成副本链（宿主 depth>0 抑制面·静默——宿主 AST
//   单份 target 无副本=等价抑制口径）。单点供 76-a（存活解引用节点）与
//   1471（哨兵化显解段·成员挂点）共用。
// 882 门禁注记：三态=写位差分判定（区间命中/链末身份/合成标记），无缺省
//   取值继续编译的静默面；2 态=显式抑制语义（宿主同面静默·非漏判）。
函数 解引用写位判派1471(整32 节点索引) -> 整32 {
    如果 (!状态在赋值左值区间926(节点索引)) {
        // 区间外：自增合成副本链（宿主 AST 无副本面·静默）；其余=读位
        布尔 自增中1471 = 状态读赋值自增合成1471();
        整32 止值1471 = 状态读赋值止快照1471();
        布尔 止有效1471 = 止值1471 >= 0;
        布尔 越止1471 = 节点索引 > 止值1471;
        如果 (自增中1471 && 止有效1471 && 越止1471) { 返回 2; }
        返回 0;
    }
    布尔 自增首份1471 = 状态读赋值自增合成1471();
    如果 (自增首份1471) { 返回 0; }   // 自增第一份链=宿主 IncDec 操作数 depth=0 读面照报
    布尔 链末直写1471 = 节点索引 == 状态读赋值左值末1471();
    如果 (链末直写1471) { 返回 1; }   // 左值末解引用直写=宿主 B7 面
    返回 2;   // 左值链中/复合赋值扩区间副本=宿主 assignmentTargetDepth_ 抑制
}

// 1471 组合读挂点：显式解引用段（哨兵化/存活合计 k>=1）安全区执法——
//   76-a 对存活解引用节点报·本函数对**被哨兵化的那段显式解引用**报（单级
//   组合形态 `(*p).x` 的解引用恰被 871-a 哨兵化=唯一报点；多级 `(**q).x`
//   内层存活走 76-a·本函数补外层=条数与宿主 B6 逐层报一致）。判定条件与
//   宿主 checkDerefUnary 逐条对齐：操作数是指针（层数表+静态回退=926 同源）·
//   读位·非字符* 字符串视图（isStringSemanticType 豁免）·节点级去重。
//   对象=成员/调用/下标链折叠形态=层数表界外诚实边界（926/615 同口径·该
//   形态两侧各有既有拒面非放行分叉）。
函数 检查显式解引用读边界1471(整32 节点索引, 节点 对象615, 整64 显解层数615,
                   向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    布尔 有显解1471 = 显解层数615 >= 1;
    如果 (!有显解1471) { 返回; }   // 无显式解引用段（纯 p.x 自动面=926 管辖）
    布尔 对象标识符1471 = 对象615.类型 == 节点_标识符;
    如果 (!对象标识符1471) { 返回; }   // 复合基=层数表界外（926/615 同口径诚实边界）
    整64 层1471 = 查语义指针层数(整64(对象615.文本));
    // 926 同款静态回退（只增不减）：顶层静态/函数内静态指针在静态层数表
    布尔 需静态回退1471 = 层1471 < 2;
    如果 (需静态回退1471) {
        整64 层静1471 = 查静态指针层数615(整64(对象615.文本));
        布尔 层静更高1471 = 层静1471 > 层1471;
        如果 (层静更高1471) { 层1471 = 层静1471; }
    }
    布尔 操作数指针1471 = 层1471 >= 1;
    如果 (!操作数指针1471) { 返回; }   // 操作数非指针=既有类型检查面管辖
    整32 位1471 = 解引用写位判派1471(节点索引);
    布尔 读位1471 = 位1471 == 0;
    如果 (!读位1471) { 返回; }   // 写直写=B7 由 76-a 面单报；链中/副本=宿主抑制
    布尔 字符视图1471 = 假;
    如果 (层1471 == 1) {
        // 字符串语义豁免=符号表声明类型（宿主 isStringSemanticType 同源·209
        //   同款——指针表所指=数组元素类型≠声明基名·见 76-a 面同注）
        // 882 门禁清偿：表查找契约命名布尔（>0=已登记·<=0 未登记=不豁免交
        //   既有报面·另一端显式）——926 指针表命中同款
        整64 声明基1471 = 表查找类型ID(符号表, 整64(对象615.文本));
        布尔 声明基有效1471 = 声明基1471 > 0;
        如果 (声明基有效1471) {
            字符视图1471 = 字符串比较(
                剥尾星615(字符串复制(驻留文本(声明基1471))), "字符");
        }
    }
    如果 (字符视图1471) { 返回; }   // 宿主 isStringSemanticType 字符串视图豁免
    // 事件表登记（节点级去重·收尾单点报文——多通道重复到达免疫·见事件表注）
    登记解引用事件1471(整64(节点索引), 整64(取当前诊断行()), 0);
}

// 926+1471 组合入口（语义检查.cn 检查成员访问表达式 单点调用·语义检查.cn
//   已超 900 行警戒线——改名接线 1 行·判定体全留本文件指针边界族）。
函数 检查指针边界926与1471(向量<节点> 池, 整32 节点索引, 节点 n,
                   节点 对象615, 整64 显解层数615,
                   向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    检查指针成员边界926(池, 节点索引, n, 对象615, 显解层数615, 符号表, 诊断);
    检查显式解引用读边界1471(节点索引, 对象615, 显解层数615, 符号表, 诊断);
}
