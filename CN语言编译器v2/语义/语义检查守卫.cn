// 语义检查守卫（#1584·2026-10-24）：结果/可选 成员访问守卫（plans/001 §5.4
//   规则3「可选<T> 类型的值在访问 .值 前必须检查 .有值」）的**条件树求值顺序**
//   检查——统一宿主与 v2 判据，修复 v2 只认「单守卫/顶层 && 左守卫」、对
//   多守卫链与嵌套短路误拒（与宿主分叉）的缺陷。
//
// 判据（按短路求值语义显式枚举，禁「其余情况放行」兜底）：
//   ① `X.有值`（可选）/`X.正常`（结果）在条件区求值后，真语境证明 X 已检查；
//   ② `A && B`：A 先求值（入口保证集）；B 在「A 为真」保证下求值；整体真保证
//      = A真 ∪ B真（链式左结合任意深度递归同一判据）；真分支继承整体真保证；
//   ③ `A || B`：B 在「A 为假」保证下求值（`!X.有值 || X.值` 惯用法由此合法）；
//      整体真不传导（无法确定哪侧为真）；
//   ④ `!E`：仅「直接守卫/嵌套取反」按真假保证互换（`!X.正常` 真=错误分支，
//      等价宿主 trackIfCheck 取反款）；复合操作数按普通表达式检查=显式不传导
//      （保守；宿主 visitIfStmt 同判据）；
//   ⑤ 三元：条件区按短路求值检查，真/假支按普通表达式检查=显式不传导
//      （保守；宿主 visitTernaryExpr 同判据——三元整体真无法唯一确定状态）；
//   ⑥ 其他形态（比较/调用/字面量/下标等）：普通表达式检查，无传导。
//   范围：仅 如果 条件位（宿主 visitIfStmt 同面）；当/循环条件不传导
//   （双侧同判据·未在规范条文承诺面内，保持现状零分叉）。
//
// 标记回滚：条件树各分支的真/假保证用撤标栈（打标记录旧类别，回滚恢复）——
//   等价宿主 errorCheckState_ 快照/恢复；不复制整张映射，自举树规模下零热路径。
//   类别 0=「原本无标」显式哨兵（驻留类别ID 从 1 起·消费点即本文件回滚恢复）。

导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量
导入 IR;         // 是结果类型_ID/是可选类型_ID（容器判定）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:   // 全文件公开（检查族供 语义检查尾.检查如果 消费）

// ==================== 结果/可选 已查标记表（#1584 自 语义检查尾.cn 迁入） ====================
// 变量名ID -> 类别ID（驻留("正常"/"错误"/"有值")）。.值/.错误 访问检查点
//   （语义检查.cn）与条件树传导共用同一张表——单点归属防双份漂移。
// 1028（#045 切片1·规则3 检查状态机·宿主 checkResultMember/isChecked 同构）。
静态 映射<整64, 整64> 结果已查标记们;

不安全 函数 标记结果已查(整64 名ID, 整64 类别ID) -> 空类型 {
    如果 (名ID == 0) { 返回; }
    结果<空类型, 整32> 设 = 结果已查标记们.设置(名ID, 类别ID);
    如果 (!设.正常) { 运行时错误(4); }
}

不安全 函数 清除结果已查(整64 名ID) -> 空类型 {
    如果 (名ID == 0) { 返回; }
    布尔 删 = 结果已查标记们.删除(名ID);   // 映射.删除 返回 布尔（键不在=假·无害）
    如果 (删) { }
}

// 函数边界清空（301 第三面·宿主 checkFunctionBody errorCheckState_.clear()
//   同构）：730 延续标存活到块尾不清，跨函数同名串扰由此截断。
不安全 函数 清空结果已查() -> 空类型 {
    结果已查标记们.清空();
}

// 查已查类别（无值=无标记；1541 B2 结果化：有值=类别ID，0 哨兵退场）
函数 查结果已查(整64 名ID) -> 可选<整64> {
    如果 (名ID == 0) { 返回 无; }
    结果<整64, 整32> 查 = 结果已查标记们.获取(名ID);
    如果 (查.正常) {
        整64 类别 = 查.值;
        返回 某些(类别);
    }
    返回 无;
}

// 守卫撤标栈：打标时记录（名ID, 旧类别ID），回滚按下标逆序恢复。
//   旧类别 0=无标（显式哨兵·类别ID 由 驻留("正常"/"有值"/"错误") 取得恒 >0）。
静态 向量<整64> 守卫撤名栈;
静态 向量<整64> 守卫撤旧栈;

// 作用域基线（栈大小）——调用方记录入口深度，分支结束回滚至此。
函数 守卫基线() -> 整64 {
    返回 整64(守卫撤名栈.大小());
}

// 打标并登记旧值（可回滚）。名ID 0=非可跟踪形态（上游已判·不登记）。
不安全 函数 守卫打标可回滚(整64 名ID, 整64 类别ID) -> 空类型 {
    如果 (名ID == 0) { 返回; }
    整64 旧类别 = 0;
    可选<整64> 旧查 = 查结果已查(名ID);
    如果 (旧查.有值) { 旧类别 = 旧查.值; }
    结果<空类型, 整32> 加名 = 守卫撤名栈.追加(名ID);
    如果 (!加名.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加旧 = 守卫撤旧栈.追加(旧类别);
    如果 (!加旧.正常) { 运行时错误(4); }
    标记结果已查(名ID, 类别ID);
}

// 回滚到基线：逆序恢复旧类别（0=无标→清除），随后栈缩回基线。
不安全 函数 守卫恢复到(整64 基线) -> 空类型 {
    当 (整64(守卫撤名栈.大小()) > 基线) {
        整64 末位 = 整64(守卫撤名栈.大小()) - 1;
        整64 名ID = 守卫撤名栈.元素(整32(末位));
        整64 旧类别 = 守卫撤旧栈.元素(整32(末位));
        结果<空类型, 整32> 删名 = 守卫撤名栈.删除(末位);
        如果 (!删名.正常) { 运行时错误(4); }
        结果<空类型, 整32> 删旧 = 守卫撤旧栈.删除(末位);
        如果 (!删旧.正常) { 运行时错误(4); }
        如果 (旧类别 == 0) {
            清除结果已查(名ID);
        }
        如果 (旧类别 != 0) {
            标记结果已查(名ID, 旧类别);
        }
    }
}

// 区间有效性（池索引 0=哨兵·条件区间非空）——显式双边界判定，越界=无检查面。
函数 守卫区间有效(向量<节点> 池, 整64 起, 整64 根) -> 布尔 {
    布尔 有效 = 起 >= 0 && 起 < 整64(池.大小()) && 起 != 0 &&
                 根 >= 起 && 根 < 整64(池.大小());
    返回 有效;
}

// ==================== #1598 守卫对象路径键（对象面双侧对齐） ====================
// 守卫身份从「标识符名ID」扩为**结构稳定对象路径键**：由 AST 池结构计算
//   （基标识符名ID + 成员名ID 序列 + 下标文本），经 驻留 归一为整64 ID——
//   同一结构路径恒同键，不依赖行号/源文本哈希等易漂移信息。
//   键形态与宿主 objectVarName 逐字同构：
//     ①标识符 -> 名ID（存量键不变，标识符面行为零变化）；
//     ②成员链 -> 父键文本 + "." + 成员名文本；
//     ③下标   -> 父键文本 + "[" + 下标文本 + "]"。
//   下标段只接受**单节点**标识符/整数字面量（含单层负号折叠 [-N]）——宿主
//   indexKeyText 同判据；调用/二元/嵌套下标等形态=无值（不可跟踪·宁严勿松）。
//   节点_整数字面量 附加==1（无 字面量·[无]）排除：宿主 NullLiteral 不跟踪，
//   若按文本 "0" 跟踪会与 [0] 键伪同构（比宿主松）。
//   无值=该对象不参与守卫跟踪（访问侧按未守卫处置=报错）。miss 无静默默认值。
函数 对象路径键(向量<节点> 池, 整32 节点索引) -> 可选<整64> {
    如果 (整64(节点索引) <= 0 || 整64(节点索引) >= 整64(池.大小())) { 返回 无; }
    节点 n = 池.元素(节点索引);
    如果 (n.类型 == 节点_标识符) {
        整64 名ID = 整64(n.文本);
        如果 (名ID == 0) { 返回 无; }
        返回 某些(名ID);
    }
    // 成员链/下标共用：父键可递归（组[0].字段 / 乙.们[0].字段 任意深度）
    可选<整64> 基查 = 无;
    如果 (n.类型 == 节点_成员) {
        如果 (整64(n.子起点) <= 0 || 整64(n.子起点) >= 整64(池.大小())) { 返回 无; }
        如果 (整64(n.文本) == 0) { 返回 无; }
        基查 = 对象路径键(池, n.子起点);
        如果 (!基查.有值) { 返回 无; }
        整64 基键m = 基查.值;
        返回 某些(驻留(字符串复制(驻留文本(基键m)) + "." +
                       字符串复制(驻留文本(整64(n.文本)))));
    }
    如果 (n.类型 == 节点_下标) {
        如果 (整64(n.子起点) <= 0 || 整64(n.子起点) >= 整64(池.大小())) { 返回 无; }
        整64 段起 = 整64(n.子起点) + 1;
        整64 段止 = 整64(n.子终点);
        如果 (段止 < 段起 || 段止 > 整64(池.大小())) { 返回 无; }
        整64 段长 = 段止 - 段起;
        整64 下标文本ID = 0;
        如果 (段长 == 1) {
            节点 下标n = 池.元素(整32(段起));
            如果 (下标n.类型 == 节点_标识符) { 下标文本ID = 整64(下标n.文本); }
            如果 (下标n.类型 == 节点_整数字面量 && 下标n.附加 == 0) {
                下标文本ID = 整64(下标n.文本);
            }
        }
        // 单层负号折叠（宿主 parser_expr 323 负字面量折叠同构：raw="-N"）
        字符串 负前缀 = "";
        如果 (段长 == 2) {
            节点 首n = 池.元素(整32(段起));
            节点 次n = 池.元素(整32(段起 + 1));
            如果 (首n.类型 == 节点_整数字面量 && 首n.附加 == 0 &&
                次n.类型 == 节点_负号) {
                下标文本ID = 整64(首n.文本);
                负前缀 = "-";
            }
        }
        如果 (下标文本ID == 0) { 返回 无; }
        基查 = 对象路径键(池, n.子起点);
        如果 (!基查.有值) { 返回 无; }
        整64 基键i = 基查.值;
        返回 某些(驻留(字符串复制(驻留文本(基键i)) + "[" + 负前缀 +
                       字符串复制(驻留文本(下标文本ID)) + "]"));
    }
    返回 无;
}

// 守卫接收者静态类型（.值/.错误/.有值/.正常 所属对象）：标识符/成员/下标/
//   解引用 走 推导遍历对象类型ID（语义层纯推导·零诊断），调用按返回类型推导
//   （自由函数=调用源返回类型ID静默；成员方法=用户类方法表/容器签名表）。
//   无值=不可推导——访问侧不做规则3判定（与存量行为同面·不新增误伤）。
//   miss 无静默默认值：无值显式分流，调用方按「不可证明」处置。
函数 守卫对象类型ID(向量<节点> 池, 整32 节点索引,
                     向量<映射<整64, 符号>>& 符号表) -> 可选<整64> {
    如果 (整64(节点索引) <= 0 || 整64(节点索引) >= 整64(池.大小())) { 返回 无; }
    节点 n = 池.元素(节点索引);
    如果 (n.类型 == 节点_调用) {
        返回 调用返回类型ID1598(池, n, 符号表);
    }
    // 解引用接收者（(*p).值）：操作数类型剥一层指针（宿主观 DerefExpr 同构）
    如果 (n.类型 == 节点_解引用 && 整64(n.子起点) >= 1 &&
         整64(n.子起点) < 整64(池.大小())) {
        可选<整64> 内查 = 守卫对象类型ID(池, n.子起点, 符号表);
        整64 内类型 = 0;
        如果 (内查.有值) { 内类型 = 内查.值; }
        如果 (内类型 <= 0) { 返回 无; }
        字符串 内文本 = 字符串复制(驻留文本(内类型));
        整64 内长 = 字符串长度(内文本);
        如果 (内长 != 0 && 内长 != 1 && ((整64(内文本[整32(内长 - 1)]) & 255) == 42)) {
            返回 某些(驻留(字符串子串(内文本, 0, 整32(内长 - 1))));
        }
        返回 无;
    }
    // 标识符/成员/下标：语义层链类型推导（数组剥层/指针所指/字段表）
    返回 推导遍历对象类型ID(池, 节点索引, 符号表);
}

// 调用表达式返回类型（守卫接收者面）：自由函数=调用源静默推导（重载/泛型/
//   函数指针等不确定面=无值）；成员方法=用户类方法表（查类方法返回）→
//   容器实例签名表回退（基名.方法名.实参数）。与 语义分析.cn 是引用返回调用
//   同源设施；无值=不可推导（访问侧维持存量行为）。
函数 调用返回类型ID1598(向量<节点> 池, 节点 调用n,
                        向量<映射<整64, 符号>>& 符号表) -> 可选<整64> {
    如果 (整64(调用n.子起点) <= 0 || 整64(调用n.子起点) >= 整64(池.大小())) { 返回 无; }
    节点 被调 = 池.元素(整32(调用n.子起点));
    如果 (被调.类型 == 节点_标识符) {
        返回 调用源返回类型ID静默(池, 调用n, 符号表);
    }
    如果 (被调.类型 == 节点_成员 && 整64(被调.子起点) >= 1 &&
         整64(被调.子起点) < 整64(池.大小())) {
        可选<整64> 对象类型查 = 守卫对象类型ID(池, 被调.子起点, 符号表);
        整64 对象类型 = 0;
        如果 (对象类型查.有值) { 对象类型 = 对象类型查.值; }
        如果 (对象类型 <= 0) { 返回 无; }
        字符串 对象名 = 字符串复制(驻留文本(对象类型));
        // 用户类实例方法：类方法表（沿链继承·查类方法返回 内部处理）
        如果 (是用户类(对象名)) {
            返回 查类方法返回(驻留(对象名), 整64(被调.文本));
        }
        // 容器实例（$ 合成名）：签名表回退（键=基名.方法名.实参数）
        字符串 基名 = 合成名基名(对象名);
        如果 (字符串长度(基名) != 0 && !字符串比较(基名, 对象名)) {
            确保签名已加载();
            整64 键 = 驻留(基名 + "." +
                          字符串复制(驻留文本(整64(被调.文本))) + "." +
                          整数转字符串(整64(调用n.附加)));
            返回 查签名返回(键);
        }
    }
    返回 无;
}

// 守卫成员形态判定：X.正常（结果族）/X.有值（可选族），对象=任意可跟踪
//   路径（标识符/下标/成员链/混合链）。出参 键ID/类别ID；返回 真=命中。
//   类型查 miss（无值/0）=无法证明守卫族 → 返回 假（不传导·显式分流，
//   非静默默认）；对象路径键 miss（复杂下标/调用等）同此显式不传导。
不安全 函数 守卫成员类别(向量<节点> 池, 整64 根,
                          向量<映射<整64, 符号>>& 符号表,
                          整64* 名ID, 整64* 类别ID) -> 布尔 {
    如果 (!守卫区间有效(池, 根, 根)) { 运行时错误(4); }
    布尔 成员命中 = 假;
    节点 n = 池.元素(整32(根));
    如果 (n.类型 == 节点_成员 &&
        整64(n.子起点) >= 1 && 整64(n.子起点) < 整64(池.大小())) {
        整64 成员名 = 整64(n.文本);
        布尔 是正常 = 成员名 == 整64(驻留("正常"));
        布尔 是有值 = 成员名 == 整64(驻留("有值"));
        如果 (是正常 || 是有值) {
            整64 类型ID = 0;
            可选<整64> 类型查 = 守卫对象类型ID(池, n.子起点, 符号表);
            如果 (类型查.有值) { 类型ID = 类型查.值; }
            整64 键 = 0;
            可选<整64> 键查 = 对象路径键(池, n.子起点);
            如果 (键查.有值) { 键 = 键查.值; }
            布尔 键有效 = 键 != 0;
            如果 (是正常 && 类型ID != 0 && 是结果类型_ID(类型ID) &&
                !是可选类型_ID(类型ID) && 键有效) {
                名ID[0] = 键; 类别ID[0] = 驻留("正常");
                成员命中 = 真;
            }
            如果 (是有值 && 类型ID != 0 && 是可选类型_ID(类型ID) && 键有效) {
                名ID[0] = 键; 类别ID[0] = 驻留("有值");
                成员命中 = 真;
            }
        }
    }
    返回 成员命中;
}

// 结果/可选 成员访问守卫检查（规则3 单点·宿主 checkResultMember 同面）：
//   对象面=标识符/下标/成员链/混合链（对象路径键）——未守卫 .值/.错误 报错；
//   .正常/.有值 读取本身即检查（放行）。对象类型不可推导=显式不判定（存量
//   行为面）；类型可推导为结果/可选而键不可跟踪（调用/复杂下标）=按未守卫拒
//   （宿主 objectVarName 无键同拒）。诊断文案与宿主逐字一致。
不安全 函数 检查结果成员访问(向量<节点> 池, 整32 节点索引,
                          向量<映射<整64, 符号>>& 符号表,
                          向量<字符串>& 诊断) -> 空类型 {
    如果 (整64(节点索引) <= 0 || 整64(节点索引) >= 整64(池.大小())) { 返回; }
    节点 n = 池.元素(节点索引);
    如果 (n.类型 != 节点_成员) { 返回; }
    如果 (整64(n.子起点) <= 0 || 整64(n.子起点) >= 整64(池.大小())) { 返回; }
    整64 成员名 = 整64(n.文本);
    如果 (成员名 != 整64(驻留("值")) && 成员名 != 整64(驻留("错误"))) { 返回; }
    整64 对象类型 = 0;
    可选<整64> 对象类型查 = 守卫对象类型ID(池, n.子起点, 符号表);
    如果 (对象类型查.有值) { 对象类型 = 对象类型查.值; }
    // 类型名 ID 合法域恒 >0；==0 即不可推导（闭区间 ==0 写法避免单边区间）
    如果 (对象类型 >= 0 && 对象类型 <= 0) { 返回; }
    布尔 是结果 = 是结果类型_ID(对象类型) && !是可选类型_ID(对象类型);
    布尔 是可选 = 是可选类型_ID(对象类型);
    如果 (!是结果 && !是可选) { 返回; }
    整64 键 = 0;
    可选<整64> 键查 = 对象路径键(池, n.子起点);
    如果 (键查.有值) { 键 = 键查.值; }
    整64 已查 = 0;
    可选<整64> 已查查 = 查结果已查(键);
    如果 (已查查.有值) { 已查 = 已查查.值; }
    如果 (是结果) {
        如果 (成员名 == 整64(驻留("值"))) {
            如果 (已查 != 整64(驻留("正常"))) {
                表诊断(诊断, "[错误] 访问 结果.值 前必须检查 结果.正常（在 如果 真分支内访问）");
            }
        } 否则 {
            如果 (已查 != 整64(驻留("错误"))) {
                表诊断(诊断, "[错误] 访问 结果.错误 前必须检查 结果.正常（在 否则 分支内访问）");
            }
        }
    }
    如果 (是可选 && 成员名 == 整64(驻留("值"))) {
        如果 (已查 != 整64(驻留("有值"))) {
            表诊断(诊断, "[错误] 访问 可选.值 前必须检查 可选.有值（在 如果 真分支内访问）");
        }
    }
}

// 纯守卫形态（真/假保证可互换面）：守卫成员 或 嵌套取反 `!纯守卫`。
//   复合短路/三元/其他=假（保证互换无定义·显式枚举）。
函数 守卫纯形态(向量<节点> 池, 整64 根,
                向量<映射<整64, 符号>>& 符号表) -> 布尔 {
    如果 (!守卫区间有效(池, 根, 根)) { 运行时错误(4); }
    节点 n = 池.元素(整32(根));
    如果 (n.类型 == 节点_成员) {
        整64 名 = 0; 整64 类别 = 0;
        返回 守卫成员类别(池, 根, 符号表, &名, &类别);
    }
    如果 (n.类型 == 节点_逻辑非 && 根 != 0) {
        返回 守卫纯形态(池, 根 - 1, 符号表);
    }
    返回 假;
}

// 施加「表达式为真」的保证（调用前该表达式已检查）：
//   X.有值/X.正常 → 标对应类别；`!纯守卫` → 取反（真=操作数为假）；
//   `A && B` → 左右真保证合并（&& 真 = 两侧皆真）；其他 → 无。
不安全 函数 施加真保证(向量<节点> 池, 整64 根,
                       向量<映射<整64, 符号>>& 符号表) -> 空类型 {
    如果 (!守卫区间有效(池, 根, 根)) { 运行时错误(4); }
    节点 n = 池.元素(整32(根));
    如果 (n.类型 == 节点_成员) {
        整64 名 = 0; 整64 类别 = 0;
        如果 (守卫成员类别(池, 根, 符号表, &名, &类别)) {
            守卫打标可回滚(名, 类别);
        }
        返回;
    }
    如果 (n.类型 == 节点_逻辑非) {
        如果 (根 != 0 && 守卫纯形态(池, 根 - 1, 符号表)) {
            施加假保证(池, 根 - 1, 符号表);   // !E 真 = E 假
        }
        返回;
    }
    如果 (n.类型 == 节点_二元运算 && 整64(n.文本) == 整64(驻留("&&")) &&
        n.附加 > n.子起点 && 整64(n.附加) <= 根) {
        施加真保证(池, 整64(n.附加) - 1, 符号表);   // 左真
        施加真保证(池, 根 - 1, 符号表);              // 右真
    }
}

// 施加「表达式为假」的保证：
//   结果 X.正常 为假 ⇒ X 已错误（.错误 可访问）；可选 X.有值 为假=无值（无成员可访问）；
//   `!纯守卫` → 取反；`A || B` 为假 ⇒ 两侧皆假（合并）；`A && B` 为假可能
//   任一侧（显式无传导）；三元/其他 → 无（显式枚举）。
不安全 函数 施加假保证(向量<节点> 池, 整64 根,
                       向量<映射<整64, 符号>>& 符号表) -> 空类型 {
    如果 (!守卫区间有效(池, 根, 根)) { 运行时错误(4); }
    节点 n = 池.元素(整32(根));
    如果 (n.类型 == 节点_成员) {
        整64 名 = 0; 整64 类别 = 0;
        如果 (守卫成员类别(池, 根, 符号表, &名, &类别)) {
            // 可选 .有值 为假=无值：无 .值 可访问 —— 显式无标
            如果 (类别 == 整64(驻留("正常"))) {
                守卫打标可回滚(名, 驻留("错误"));
            }
        }
        返回;
    }
    如果 (n.类型 == 节点_逻辑非) {
        如果 (根 != 0 && 守卫纯形态(池, 根 - 1, 符号表)) {
            施加真保证(池, 根 - 1, 符号表);   // !E 假 = E 真
        }
        返回;
    }
    如果 (n.类型 == 节点_二元运算 && 整64(n.文本) == 整64(驻留("||")) &&
        n.附加 > n.子起点 && 整64(n.附加) <= 根) {
        施加假保证(池, 整64(n.附加) - 1, 符号表);   // 左假
        施加假保证(池, 根 - 1, 符号表);              // 右假
    }
}

// 条件树检查（按短路求值顺序·区间 [起, 根] 的根=根节点）：
//   进入时全局标记=入口保证集；返回时标记=入口集 ∪ 本表达式真保证
//   （`||`/三元回滚到入口=整体真不传导；`!` 施加操作数假保证）。
函数 检查条件树(向量<节点> 池, 整64 起, 整64 根,
                向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    如果 (!守卫区间有效(池, 起, 根)) { 返回; }
    节点 根n = 池.元素(整32(根));
    // 短路与：左→（左真）→右→（左真∪右真）
    如果 (根n.类型 == 节点_二元运算 && 整64(根n.文本) == 整64(驻留("&&")) &&
        根n.附加 > 根n.子起点 && 整64(根n.附加) <= 根) {
        检查条件树(池, 整64(根n.子起点), 整64(根n.附加) - 1, 符号表, 诊断);
        检查条件树(池, 整64(根n.附加), 根 - 1, 符号表, 诊断);
        可选<整64> 根类型 = 检查表达式(池, 整32(根), 符号表, 诊断);
        返回;
    }
    // 短路或：左→回滚→（左假）→右→回滚（整体真不传导）
    如果 (根n.类型 == 节点_二元运算 && 整64(根n.文本) == 整64(驻留("||")) &&
        根n.附加 > 根n.子起点 && 整64(根n.附加) <= 根) {
        整64 基 = 守卫基线();
        检查条件树(池, 整64(根n.子起点), 整64(根n.附加) - 1, 符号表, 诊断);
        守卫恢复到(基);
        施加假保证(池, 整64(根n.附加) - 1, 符号表);
        检查条件树(池, 整64(根n.附加), 根 - 1, 符号表, 诊断);
        守卫恢复到(基);
        可选<整64> 根类型 = 检查表达式(池, 整32(根), 符号表, 诊断);
        返回;
    }
    // 取反：操作数为复合形态时不传导（显式枚举·逐节点普通检查）；
    //   纯守卫/嵌套取反 → 施加操作数假保证（!E 真 = E 假）
    如果 (根n.类型 == 节点_逻辑非) {
        整64 j = 整64(根n.子起点);
        当 (j < 根) {
            可选<整64> 忽略 = 检查表达式(池, 整32(j), 符号表, 诊断);
            j++;
        }
        可选<整64> 根类型 = 检查表达式(池, 整32(根), 符号表, 诊断);
        施加假保证(池, 根 - 1, 符号表);
        返回;
    }
    // 三元：整树显式不传导（条件/真/假支统一普通检查——宿主 visitTernaryExpr
    //   同判据；三元整体真无法唯一确定状态，条件区内部亦不做短路传导=保守）
    如果 (根n.类型 == 节点_三元运算) {
        整64 j = 整64(根n.子起点);
        当 (j < 根) {
            可选<整64> 忽略 = 检查表达式(池, 整32(j), 符号表, 诊断);
            j++;
        }
        可选<整64> 根类型 = 检查表达式(池, 整32(根), 符号表, 诊断);
        返回;
    }
    // 其他形态：区间逐节点普通检查后，按纯守卫形态施加真保证
    整64 i = 起;
    当 (i <= 根) {
        可选<整64> 忽略 = 检查表达式(池, 整32(i), 符号表, 诊断);
        i++;
    }
    施加真保证(池, 根, 符号表);
}
