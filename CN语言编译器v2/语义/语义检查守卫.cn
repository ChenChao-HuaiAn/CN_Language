// 语义检查守卫（#1584·2026-10-24）：结果/可选 成员访问守卫（plans/001 §5.4
//   规则3「可选<T> 类型的值在访问 .值 前必须检查 .有值」）的**条件树求值顺序**
//   检查——统一宿主与 v2 判据，修复 v2 只认「单守卫/顶层 && 左守卫」、对
//   多守卫链与嵌套短路误拒（与宿主分叉）的缺陷。
//
// 判据（按短路求值语义显式枚举，禁「其余情况放行」兜底）：
//   ① `X.有值`（可选）/`X.正常`（结果）在条件区求值后，真语境证明 X 已检查；
//   ② `A && B`：A 先求值（入口保证集）；B 在「A 为真」保证下求值；整体真保证
//      = A真 ∪ B真（链式左结合任意深度递归同一判据）；真分支继承整体真保证；
//   ③ `A || B`：B 在「A 为假」保证下求值（`!X.有值 || X.值` 惯用法由此合法）；
//      整体真不传导（无法确定哪侧为真）；
//   ④ `!E`：仅「直接守卫/嵌套取反」按真假保证互换（`!X.正常` 真=错误分支，
//      等价宿主 trackIfCheck 取反款）；复合操作数按普通表达式检查=显式不传导
//      （保守；宿主 visitIfStmt 同判据）；
//   ⑤ 三元：条件区按短路求值检查，真/假支按普通表达式检查=显式不传导
//      （保守；宿主 visitTernaryExpr 同判据——三元整体真无法唯一确定状态）；
//   ⑥ 其他形态（比较/调用/字面量/下标等）：普通表达式检查，无传导。
//   范围：仅 如果 条件位（宿主 visitIfStmt 同面）；当/循环条件不传导
//   （双侧同判据·未在规范条文承诺面内，保持现状零分叉）。
//
// 标记回滚：条件树各分支的真/假保证用撤标栈（打标记录旧类别，回滚恢复）——
//   等价宿主 errorCheckState_ 快照/恢复；不复制整张映射，自举树规模下零热路径。
//   类别 0=「原本无标」显式哨兵（驻留类别ID 从 1 起·消费点即本文件回滚恢复）。

导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量
导入 IR;         // 是结果类型_ID/是可选类型_ID（容器判定）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:   // 全文件公开（检查族供 语义检查尾.检查如果 消费）

// ==================== 结果/可选 已查标记表（#1584 自 语义检查尾.cn 迁入） ====================
// 变量名ID -> 类别ID（驻留("正常"/"错误"/"有值")）。.值/.错误 访问检查点
//   （语义检查.cn）与条件树传导共用同一张表——单点归属防双份漂移。
// 1028（#045 切片1·规则3 检查状态机·宿主 checkResultMember/isChecked 同构）。
静态 映射<整64, 整64> 结果已查标记们;

不安全 函数 标记结果已查(整64 名ID, 整64 类别ID) -> 空类型 {
    如果 (名ID == 0) { 返回; }
    结果<空类型, 整32> 设 = 结果已查标记们.设置(名ID, 类别ID);
    如果 (!设.正常) { 运行时错误(4); }
}

不安全 函数 清除结果已查(整64 名ID) -> 空类型 {
    如果 (名ID == 0) { 返回; }
    布尔 删 = 结果已查标记们.删除(名ID);   // 映射.删除 返回 布尔（键不在=假·无害）
    如果 (删) { }
}

// 函数边界清空（301 第三面·宿主 checkFunctionBody errorCheckState_.clear()
//   同构）：730 延续标存活到块尾不清，跨函数同名串扰由此截断。
不安全 函数 清空结果已查() -> 空类型 {
    结果已查标记们.清空();
}

// 查已查类别（无值=无标记；1541 B2 结果化：有值=类别ID，0 哨兵退场）
函数 查结果已查(整64 名ID) -> 可选<整64> {
    如果 (名ID == 0) { 返回 无; }
    结果<整64, 整32> 查 = 结果已查标记们.获取(名ID);
    如果 (查.正常) {
        整64 类别 = 查.值;
        返回 某些(类别);
    }
    返回 无;
}

// 守卫撤标栈：打标时记录（名ID, 旧类别ID），回滚按下标逆序恢复。
//   旧类别 0=无标（显式哨兵·类别ID 由 驻留("正常"/"有值"/"错误") 取得恒 >0）。
静态 向量<整64> 守卫撤名栈;
静态 向量<整64> 守卫撤旧栈;

// 作用域基线（栈大小）——调用方记录入口深度，分支结束回滚至此。
函数 守卫基线() -> 整64 {
    返回 整64(守卫撤名栈.大小());
}

// 打标并登记旧值（可回滚）。名ID 0=非可跟踪形态（上游已判·不登记）。
不安全 函数 守卫打标可回滚(整64 名ID, 整64 类别ID) -> 空类型 {
    如果 (名ID == 0) { 返回; }
    整64 旧类别 = 0;
    可选<整64> 旧查 = 查结果已查(名ID);
    如果 (旧查.有值) { 旧类别 = 旧查.值; }
    结果<空类型, 整32> 加名 = 守卫撤名栈.追加(名ID);
    如果 (!加名.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加旧 = 守卫撤旧栈.追加(旧类别);
    如果 (!加旧.正常) { 运行时错误(4); }
    标记结果已查(名ID, 类别ID);
}

// 回滚到基线：逆序恢复旧类别（0=无标→清除），随后栈缩回基线。
不安全 函数 守卫恢复到(整64 基线) -> 空类型 {
    当 (整64(守卫撤名栈.大小()) > 基线) {
        整64 末位 = 整64(守卫撤名栈.大小()) - 1;
        整64 名ID = 守卫撤名栈.元素(整32(末位));
        整64 旧类别 = 守卫撤旧栈.元素(整32(末位));
        结果<空类型, 整32> 删名 = 守卫撤名栈.删除(末位);
        如果 (!删名.正常) { 运行时错误(4); }
        结果<空类型, 整32> 删旧 = 守卫撤旧栈.删除(末位);
        如果 (!删旧.正常) { 运行时错误(4); }
        如果 (旧类别 == 0) {
            清除结果已查(名ID);
        }
        如果 (旧类别 != 0) {
            标记结果已查(名ID, 旧类别);
        }
    }
}

// 区间有效性（池索引 0=哨兵·条件区间非空）——显式双边界判定，越界=无检查面。
函数 守卫区间有效(向量<节点> 池, 整64 起, 整64 根) -> 布尔 {
    布尔 有效 = 起 >= 0 && 起 < 整64(池.大小()) && 起 != 0 &&
                 根 >= 起 && 根 < 整64(池.大小());
    返回 有效;
}

// 守卫成员形态判定：X.正常（结果族）/X.有值（可选族），对象=标识符。
//   出参 名ID/类别ID；返回 真=命中。类型查 miss（无值/0）=无法证明守卫族 →
//   返回 假（不传导·显式分流，非静默默认）。
不安全 函数 守卫成员类别(向量<节点> 池, 整64 根,
                          向量<映射<整64, 符号>>& 符号表,
                          整64* 名ID, 整64* 类别ID) -> 布尔 {
    如果 (!守卫区间有效(池, 根, 根)) { 运行时错误(4); }
    布尔 成员命中 = 假;
    节点 n = 池.元素(整32(根));
    如果 (n.类型 == 节点_成员) {
        如果 (守卫区间有效(池, 整64(n.子起点), 整64(n.子起点))) {
            节点 对象 = 池.元素(n.子起点);
            如果 (对象.类型 == 节点_标识符) {
                整64 名 = 整64(对象.文本);
                整64 成员名 = 整64(n.文本);
                整64 类型ID = 0;
                可选<整64> 类型查 = 表查找类型ID(符号表, 名);
                如果 (类型查.有值) { 类型ID = 类型查.值; }
                如果 (类型ID != 0 && 成员名 == 整64(驻留("正常")) &&
                    是结果类型_ID(类型ID) && !是可选类型_ID(类型ID)) {
                    名ID[0] = 名; 类别ID[0] = 驻留("正常");
                    成员命中 = 真;
                }
                如果 (类型ID != 0 && 成员名 == 整64(驻留("有值")) &&
                    是可选类型_ID(类型ID)) {
                    名ID[0] = 名; 类别ID[0] = 驻留("有值");
                    成员命中 = 真;
                }
            }
        }
    }
    返回 成员命中;
}

// 纯守卫形态（真/假保证可互换面）：守卫成员 或 嵌套取反 `!纯守卫`。
//   复合短路/三元/其他=假（保证互换无定义·显式枚举）。
函数 守卫纯形态(向量<节点> 池, 整64 根,
                向量<映射<整64, 符号>>& 符号表) -> 布尔 {
    如果 (!守卫区间有效(池, 根, 根)) { 运行时错误(4); }
    节点 n = 池.元素(整32(根));
    如果 (n.类型 == 节点_成员) {
        整64 名 = 0; 整64 类别 = 0;
        返回 守卫成员类别(池, 根, 符号表, &名, &类别);
    }
    如果 (n.类型 == 节点_逻辑非 && 根 != 0) {
        返回 守卫纯形态(池, 根 - 1, 符号表);
    }
    返回 假;
}

// 施加「表达式为真」的保证（调用前该表达式已检查）：
//   X.有值/X.正常 → 标对应类别；`!纯守卫` → 取反（真=操作数为假）；
//   `A && B` → 左右真保证合并（&& 真 = 两侧皆真）；其他 → 无。
不安全 函数 施加真保证(向量<节点> 池, 整64 根,
                       向量<映射<整64, 符号>>& 符号表) -> 空类型 {
    如果 (!守卫区间有效(池, 根, 根)) { 运行时错误(4); }
    节点 n = 池.元素(整32(根));
    如果 (n.类型 == 节点_成员) {
        整64 名 = 0; 整64 类别 = 0;
        如果 (守卫成员类别(池, 根, 符号表, &名, &类别)) {
            守卫打标可回滚(名, 类别);
        }
        返回;
    }
    如果 (n.类型 == 节点_逻辑非) {
        如果 (根 != 0 && 守卫纯形态(池, 根 - 1, 符号表)) {
            施加假保证(池, 根 - 1, 符号表);   // !E 真 = E 假
        }
        返回;
    }
    如果 (n.类型 == 节点_二元运算 && 整64(n.文本) == 整64(驻留("&&")) &&
        n.附加 > n.子起点 && 整64(n.附加) <= 根) {
        施加真保证(池, 整64(n.附加) - 1, 符号表);   // 左真
        施加真保证(池, 根 - 1, 符号表);              // 右真
    }
}

// 施加「表达式为假」的保证：
//   结果 X.正常 为假 ⇒ X 已错误（.错误 可访问）；可选 X.有值 为假=无值（无成员可访问）；
//   `!纯守卫` → 取反；`A || B` 为假 ⇒ 两侧皆假（合并）；`A && B` 为假可能
//   任一侧（显式无传导）；三元/其他 → 无（显式枚举）。
不安全 函数 施加假保证(向量<节点> 池, 整64 根,
                       向量<映射<整64, 符号>>& 符号表) -> 空类型 {
    如果 (!守卫区间有效(池, 根, 根)) { 运行时错误(4); }
    节点 n = 池.元素(整32(根));
    如果 (n.类型 == 节点_成员) {
        整64 名 = 0; 整64 类别 = 0;
        如果 (守卫成员类别(池, 根, 符号表, &名, &类别)) {
            // 可选 .有值 为假=无值：无 .值 可访问 —— 显式无标
            如果 (类别 == 整64(驻留("正常"))) {
                守卫打标可回滚(名, 驻留("错误"));
            }
        }
        返回;
    }
    如果 (n.类型 == 节点_逻辑非) {
        如果 (根 != 0 && 守卫纯形态(池, 根 - 1, 符号表)) {
            施加真保证(池, 根 - 1, 符号表);   // !E 假 = E 真
        }
        返回;
    }
    如果 (n.类型 == 节点_二元运算 && 整64(n.文本) == 整64(驻留("||")) &&
        n.附加 > n.子起点 && 整64(n.附加) <= 根) {
        施加假保证(池, 整64(n.附加) - 1, 符号表);   // 左假
        施加假保证(池, 根 - 1, 符号表);              // 右假
    }
}

// 条件树检查（按短路求值顺序·区间 [起, 根] 的根=根节点）：
//   进入时全局标记=入口保证集；返回时标记=入口集 ∪ 本表达式真保证
//   （`||`/三元回滚到入口=整体真不传导；`!` 施加操作数假保证）。
函数 检查条件树(向量<节点> 池, 整64 起, 整64 根,
                向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    如果 (!守卫区间有效(池, 起, 根)) { 返回; }
    节点 根n = 池.元素(整32(根));
    // 短路与：左→（左真）→右→（左真∪右真）
    如果 (根n.类型 == 节点_二元运算 && 整64(根n.文本) == 整64(驻留("&&")) &&
        根n.附加 > 根n.子起点 && 整64(根n.附加) <= 根) {
        检查条件树(池, 整64(根n.子起点), 整64(根n.附加) - 1, 符号表, 诊断);
        检查条件树(池, 整64(根n.附加), 根 - 1, 符号表, 诊断);
        可选<整64> 根类型 = 检查表达式(池, 整32(根), 符号表, 诊断);
        返回;
    }
    // 短路或：左→回滚→（左假）→右→回滚（整体真不传导）
    如果 (根n.类型 == 节点_二元运算 && 整64(根n.文本) == 整64(驻留("||")) &&
        根n.附加 > 根n.子起点 && 整64(根n.附加) <= 根) {
        整64 基 = 守卫基线();
        检查条件树(池, 整64(根n.子起点), 整64(根n.附加) - 1, 符号表, 诊断);
        守卫恢复到(基);
        施加假保证(池, 整64(根n.附加) - 1, 符号表);
        检查条件树(池, 整64(根n.附加), 根 - 1, 符号表, 诊断);
        守卫恢复到(基);
        可选<整64> 根类型 = 检查表达式(池, 整32(根), 符号表, 诊断);
        返回;
    }
    // 取反：操作数为复合形态时不传导（显式枚举·逐节点普通检查）；
    //   纯守卫/嵌套取反 → 施加操作数假保证（!E 真 = E 假）
    如果 (根n.类型 == 节点_逻辑非) {
        整64 j = 整64(根n.子起点);
        当 (j < 根) {
            可选<整64> 忽略 = 检查表达式(池, 整32(j), 符号表, 诊断);
            j++;
        }
        可选<整64> 根类型 = 检查表达式(池, 整32(根), 符号表, 诊断);
        施加假保证(池, 根 - 1, 符号表);
        返回;
    }
    // 三元：整树显式不传导（条件/真/假支统一普通检查——宿主 visitTernaryExpr
    //   同判据；三元整体真无法唯一确定状态，条件区内部亦不做短路传导=保守）
    如果 (根n.类型 == 节点_三元运算) {
        整64 j = 整64(根n.子起点);
        当 (j < 根) {
            可选<整64> 忽略 = 检查表达式(池, 整32(j), 符号表, 诊断);
            j++;
        }
        可选<整64> 根类型 = 检查表达式(池, 整32(根), 符号表, 诊断);
        返回;
    }
    // 其他形态：区间逐节点普通检查后，按纯守卫形态施加真保证
    整64 i = 起;
    当 (i <= 根) {
        可选<整64> 忽略 = 检查表达式(池, 整32(i), 符号表, 诊断);
        i++;
    }
    施加真保证(池, 根, 符号表);
}
