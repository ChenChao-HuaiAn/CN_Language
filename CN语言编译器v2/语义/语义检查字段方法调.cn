// CN 自举编译器 v2 · 语义检查——字段当方法调（对象.字段()）语义级拒绝
// 职责：成员被调（对象.字段()——成员是字段非方法，如 可选.有值()/结果.正常()）
//   的语义层用户面诊断单点（宿主 semantic_call.cpp 尾部「无法调用非函数类型」
//   同串·主里/泛型体内同款）。
// 1976（双侧诊断伞批）：修前 v2 落终态兜底「调用表达式终态类型兜底」内部
//   错误通道（错误程序触发内部错误+双侧拒因分叉）；修后语义级拒绝同串。
// 拆分（先拆再加纪律）：自 语义检查表达式.cn 检查调用表达式 491 面拆出——
//   该文件拆前 1059 行破千行红线；本判定 ~66 行迁此薄委托。
// 判定面（零误伤边界）：对象非方法接收者（容器/用户类/接口/标准库模块——
//   方法调用让位既有通道）且成员可推导为非 fnptr 确定字段类型（结构体字段/
//   合成体布尔位 有值/正常）才报；fnptr 字段调用走 491 面 fnptr 通道不触；
//   对象=标识符/成员链两形态覆盖（调用基座形态=诚实边界放行）。
// 诊断后返回「未知」类型ID——宿主 lastType_="未知" 错误恢复同构（返回
//   语句面同报「无法将'未知'」衍生诊断）。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（目录包名）
导入 IR;         // 容器/结果/可选 判定（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包（驻留/驻留文本）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 字段当方法调判定主入口：被调成员（名ID+子起点）→ 已诊断=某些(未知ID)；
//   非字段形态=无值（调用方走原链·调用基座对象形态=诚实边界）。
函数 检查字段当方法调(向量<节点> 池, 整32 调用起点, 整64 被调名ID,
                   整32 被调子起点, 向量<映射<整64, 符号>>& 符号表,
                   向量<字符串>& 诊断) -> 可选<整64> {
    布尔 被调子位有效 = 被调子起点 > 0;
    如果 (!被调子位有效) { 返回 无; }
    节点 方法对象位 = 池.元素(被调子起点);
    布尔 方法对象形态可推 = 方法对象位.类型 == 节点_标识符 ||
        方法对象位.类型 == 节点_成员;
    如果 (!方法对象形态可推) { 返回 无; }
    向量<字符串> 静默名副本 = 向量<字符串>();
    整64 方法对象类型ID = 0;
    如果 (方法对象位.类型 == 节点_标识符) {
        结果<整64, 整32> 方法对象类型果 = 检查标识符表达式(
            池, 被调子起点, 符号表, 静默名副本);
        如果 (方法对象类型果.正常) {
            布尔 方法对象类型非占位 = 方法对象类型果.值 > 0;
            如果 (方法对象类型非占位) {
                方法对象类型ID = 方法对象类型果.值;
            }
        }
    }
    如果 (方法对象位.类型 == 节点_成员) {
        可选<整64> 方法对象链类型查 = 推导成员类型ID(
            池, 被调子起点, 符号表, 静默名副本);
        如果 (方法对象链类型查.有值) { 方法对象类型ID = 方法对象链类型查.值; }
    }
    布尔 方法对象类型已取 = 方法对象类型ID > 0;
    如果 (!方法对象类型已取) { 返回 无; }
    字符串 方法对象文本 = 字符串复制(驻留文本(方法对象类型ID));
    布尔 是方法调用接收者 = 是容器类(方法对象文本) ||
        是用户类_ID(方法对象类型ID) ||
        是接口名ID(方法对象类型ID) ||
        是标准库模块名(方法对象文本);
    如果 (是方法调用接收者) { 返回 无; }
    向量<字符串> 静默字段副本 = 向量<字符串>();
    可选<整64> 判定字段类型查 = 推导成员类型ID(
        池, 调用起点, 符号表, 静默字段副本);
    整64 判定字段类型ID = 0;
    如果 (判定字段类型查.有值) { 判定字段类型ID = 判定字段类型查.值; }
    如果 (判定字段类型ID == 0) {
        // 合成体布尔位成员（有值/正常）——载荷单点只认 值/错误，布尔位在
        //   字段登记面外（宿主 visitMemberExpr 布尔字段同语义·o.有值() 实锚）。
        布尔 对象是合成体 = 是结果类型(方法对象文本) ||
            是可选类型(方法对象文本);
        布尔 是布尔位成员名 =
            被调名ID == 整64(驻留("有值")) ||
            被调名ID == 整64(驻留("正常"));
        如果 (对象是合成体 && 是布尔位成员名) {
            判定字段类型ID = 驻留("布尔");
        }
    }
    布尔 是确定字段类型 = 判定字段类型ID > 0 &&
        !是函数指针类型文本(字符串复制(驻留文本(判定字段类型ID)));
    如果 (是确定字段类型) {
        表诊断(诊断, "[错误] 无法调用非函数类型 '" +
            字符串复制(驻留文本(判定字段类型ID)) + "'");
        返回 某些(驻留("未知"));
    }
    返回 无;
}
