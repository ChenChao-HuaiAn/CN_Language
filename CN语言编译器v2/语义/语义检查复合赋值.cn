// CN 自举编译器 v2 · 语义检查·复合赋值操作数族（86 拆分：自 语义检查语句.cn
//   机械搬移——该文件 1034 行撞 1000 冻结线，「先拆再加」纪律；纯搬移+本任务
//   86 拼接放行，零其他行为变更）
// 职责：检查复合赋值操作数——左值类型数值白名单（§86 拼接放行：复合符为 + 且
//   左值=字符串/字符* 且右值可拼接=二元 + 立法面同组合·宿主
//   rewriteStringConcatCompoundAssign 同构零分叉）+ 形态自取（纯标识符/表达式
//   左值统一入口·868-a）。
公开:   // 检查复合赋值操作数 供 语义检查语句（检查赋值语句 主流程）调用

函数 检查复合赋值操作数(向量<节点> 池, 节点 n, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    // 868-a：①早退判据改「右值区间非空」——原 `n.附加 <= 0` 依赖「文本=0」旧形态
    //   （附加=左值起点>0）；纯标识符复合赋值新形态=文本=名ID/附加=0（对齐普通
    //   赋值·426 写面修复）→ 原判据早退漏检诊断（174_v2 实锤）。②左值类型改
    //   **形态自取**（删 左值末 参数）：文本≠0（纯标识符形态）经符号表直查；
    //   文本=0（表达式左值形态）取左值区间末节点（原逻辑）。
    如果 (n.子终点 <= n.子起点) { 返回; }
    节点 右值末c = 池.元素(n.子终点 - 1);
    // 任务1864（f 系锁面双侧对拍实录·宿主 checkCompoundAssign 全形态拦截同构）：
    //   复合赋值位静态写执法——**旧合成形态**（文本=0 且左值末=标识符·868-a
    //   「文本=0（表达式左值形态）」遗留解析面）查 可变静态集合（顶层静态=
    //   全局静态名ID们·函数内静态局部=静态局部名ID们·合成名 865-a）；纯标识符
    //   新形态（文本=名ID）不入本挂点=检查标识符左值赋值 B10 挂点已查（双挂点
    //   同判会双报·宿主 1 条实证口径）；下标/成员链左值不入=791 链挂点已查
    //   （同防）；文案「静态变量赋值」与直写面一致（宿主实测复合赋值与简单
    //   赋值同文案）；不安全 函数内豁免（错误不安全边界 内建）。
    // 926：子终点=1（复合赋值合成）∪ 2（871-a 自增合成专用标记）——两类
    //   合成同走本操作数检查（自增形态原经 1 命中·标记专化后并认保持）
    // 882 门禁：比较式归入命名布尔（条件位全布尔名·单边比较词面不入 如果 位）
    布尔 旧合成无名形态写位 = n.文本 == 0 && n.子起点 > 0;
    布尔 右值合成二元写位 = 右值末c.类型 == 节点_二元运算 &&
        (右值末c.子终点 == 1 || 右值末c.子终点 == 2);
    如果 (旧合成无名形态写位 && 右值合成二元写位) {
        节点 复合左值末写位 = 池.元素(n.子起点 - 1);
        布尔 复合左名是标识符写位 = 复合左值末写位.类型 == 节点_标识符;
        整64 复合左名写位 = 0;
        如果 (复合左名是标识符写位) {
            复合左名写位 = 整64(复合左值末写位.文本);
        }
        布尔 复合左是静态写位 = 复合左名是标识符写位 &&
            复合左名写位 != 0 &&
            (是全局静态名(复合左名写位) || 是静态局部名(复合左名写位)) &&
            !命中非静态局部(符号表, 复合左名写位);
        如果 (复合左是静态写位) {
            错误不安全边界(诊断, "静态变量写", "静态变量赋值");
        }
    }
    // 926：子终点=1（复合赋值合成）∪ 2（871-a 自增合成专用标记）——两类
    //   合成同走本操作数检查（自增形态原经 1 命中·标记专化后并认保持）
    如果 (右值末c.类型 == 节点_二元运算 &&
        (右值末c.子终点 == 1 || 右值末c.子终点 == 2)) {
        整64 左值类型IDc = 0;
        如果 (n.文本 != 0) {
            可选<整64> 左值类型IDc查 = 表查找类型ID(符号表, 整64(n.文本));
            // miss 保持 0（下方 >0 判定与原 -1 哨兵同假·880 批5）
            如果 (左值类型IDc查.有值) { 左值类型IDc = 左值类型IDc查.值; }
        } 否则 如果 (n.子起点 > 0) {
        节点 左值末 = 池.元素(n.子起点 - 1);
        // 左值类型取左值区间**末**节点：变量=标识符；成员链（名片.计数）
        //   =成员节点（取首节点会把对象结构体当操作数类型误拒）
        如果 (左值末.类型 == 节点_标识符) {
            可选<整64> 左值类型IDc查2 = 表查找类型ID(符号表, 整64(左值末.文本));
            如果 (左值类型IDc查2.有值) { 左值类型IDc = 左值类型IDc查2.值; }
        } 否则 如果 (左值末.类型 == 节点_下标 && 左值末.子起点 > 0) {
            // ③ 第三波：下标左值（p[0] += 1）——操作数类型=所指元素
            //   类型（指针变量表；非指针已上方拒绝，此处防御 -1 放行）
            节点 下标对象c = 池.元素(整32(左值末.子起点));
            如果 (下标对象c.类型 == 节点_标识符) {
                可选<整64> 查复指 = 查语义指针变量(整64(下标对象c.文本));
                如果 (查复指.有值) { 左值类型IDc = 查复指.值; }
            }
        } 否则 如果 (左值末.类型 == 节点_成员 && 左值末.子起点 > 0) {
            // 成员左值：字段类型（名片.计数 += 2 —— 计数 整64 合法）
            节点 成员对象c = 池.元素(整32(左值末.子起点));
            如果 (成员对象c.类型 == 节点_标识符) {
                可选<整64> 查结构体c = 查变量结构体键(整64(成员对象c.文本));
                如果 (查结构体c.有值) {
                    如果 (查结构体c.值 != 1) {
                        可选<整64> 字段查c = 查字段类型ID(查结构体c.值, 整64(左值末.文本));
                        如果 (字段查c.有值) { 左值类型IDc = 字段查c.值; }
                    }
                }
            }
        }
        }
        如果 (左值类型IDc > 0) {
            字符串 左类型文本c = 字符串复制(驻留文本(左值类型IDc));
            布尔 是数值c = 字符串比较(左类型文本c, "整32") || 字符串比较(左类型文本c, "整64") ||
                           字符串比较(左类型文本c, "整8") || 字符串比较(左类型文本c, "整16") ||
                           字符串比较(左类型文本c, "正8") || 字符串比较(左类型文本c, "正16") ||
                           字符串比较(左类型文本c, "正32") || 字符串比较(左类型文本c, "正64") ||
                           // 822（053-002）：128 位族补全（宿主接受 整128 += 1·q3 探针实证）
                           字符串比较(左类型文本c, "整128") || 字符串比较(左类型文本c, "正128") ||
                           字符串比较(左类型文本c, "浮32") || 字符串比较(左类型文本c, "浮64");
            如果 (!是数值c) {
                // 86（001 §3.7 第④族「复合赋值等价展开 甲 = 甲 + X」条文 +
                //   §3.7 拼接立法 §253/Task2.5/2.9）：字符串拼接复合赋值放行——
                //   甲 += X 语法层已回退重析 甲 = 甲 + X（合成二元），+ 拼接
                //   已立法 → 二元 + 支持的组合 += 必须同支持（宿主
                //   checkCompoundAssign 糖展开 rewriteStringConcatCompoundAssign
                //   同构·零分叉；修前双侧同拒「要求数值操作数」=与二元拼接
                //   语义不一致）。放行条件与宿主同条件：复合符为 + 且左值=
                //   字符串/字符* 且右值类型可拼接（字符串/字符*/数值族/布尔/
                //   字符/枚举——推导源类型ID静默；检不出=-1 诚实边界放行，
                //   二元面 411 拼接豁免/算术总守卫可靠面兜底执法）。其余复合符
                //   （-= 等）与不可拼接右值维持拒绝（复合赋值文案与宿主逐字
                //   一致；752/753 混合符号数值面执法不受影响）。
                布尔 放行拼接86 = 假;
                如果 (字符串比较(字符串复制(驻留文本(整64(右值末c.文本))), "+") &&
                     n.子终点 >= n.子起点 + 3) {
                    布尔 左串86 = 字符串比较(左类型文本c, "字符串") ||
                                 字符串比较(左类型文本c, "字符*");
                    如果 (左串86) {
                        // 右值末节点=合成二元前一节点=右操作数表达式根
                        //   （合成二元恒为赋值子区间末；右操作数解析节点在前）
                        可选<整64> 右ID86查 = 推导源类型ID静默(池, 整32(n.子终点 - 2), 符号表);
                        整64 右ID86 = 0 - 1;
                        如果 (右ID86查.有值) { 右ID86 = 右ID86查.值; }
                        如果 (右ID86 < 0) {
                            放行拼接86 = 真;   // 检不出=诚实边界放行（同拼接守卫口径）
                        } 否则 {
                            字符串 右文本86 = 字符串复制(驻留文本(右ID86));
                            放行拼接86 = 字符串比较(右文本86, "字符串") ||
                                         字符串比较(右文本86, "字符*") ||
                                         字符串比较(右文本86, "布尔") ||
                                         是枚举名(右ID86) ||
                                         是数值类型文本411(右文本86);
                        }
                    }
                }
                如果 (!放行拼接86) {
                    表诊断(诊断, "[错误] 复合赋值要求数值操作数: " + 左类型文本c);
                }
            }
        }
    }
}

// 1613（2026-10-25·#1613 链式复合赋值右结合）：链式赋值表达式位检查（894-a
//   块自 语义检查.cn 机械搬移——该文件恰 1000 行撞冻结线，「先拆再加」纪律；
//   纯搬移零行为变更）。复合赋值链内层赋值根（解析复合赋值链尾 脱糖·表达式
//   位）经 检查表达式 右值区间递归到达本函数：其右值=脱糖普通二元（`b = b-2`
//   同构）——操作数检查由二元面 411 算术总守卫承接（宿主复合赋值文案差异=
//   负测面·诚实边界随 v2 诊断对齐收口）。
// 职责：287 `整32 y = x = 5;` 内层赋值根——左值声明性/常量/静态拒绝（语句位
//   检查赋值语句 核心守卫同构）+右值区间递归检查（外层表达式逐节点检查不
//   重复消费赋值根）+返回左值类型（赋值表达式类型=左值类型·宿主
//   AssignmentExpr 同构）。
函数 检查链式赋值表达式位1613(向量<节点> 池, 节点 n, 向量<映射<整64, 符号>>& 符号表,
                          向量<字符串>& 诊断) -> 可选<整64> {
    如果 (n.文本 != 0) {
        可选<整64> 左类型c查 = 表查找类型ID(符号表, 整64(n.文本));
        整64 左类型c = 0;
        布尔 左类型c回退 = 假;
        如果 (左类型c查.有值) { 左类型c = 左类型c查.值; }
        // 1637：可选化双调用归并单局部（守卫+取值·幂等查询）
        可选<整64> 当前类c查 = 查当前检查类ID();
        如果 (!左类型c查.有值 && 当前类c查.有值) {
            // 070 波G：类内静态字段裸名赋值（同 自增 口径）
            结果<整64, 整32> 查类静c = 查类静态字段类型(当前类c查.值, 整64(n.文本));
            如果 (查类静c.正常) {
                左类型c = 查类静c.值;
                左类型c回退 = 真;
            } 否则 { }
        }
        // 434（类名::静态字段 限定写·#284 ::矩阵第五态）：链式赋值表达式位
        //   限定复合名回退（语句位 检查标识符左值赋值 同款单点分派——宿主
        //   链式 `类名::字段 = 类名::字段 = 值` 与点号同语义放行）
        如果 (!左类型c查.有值 && !左类型c回退) {
            结果<整64, 整32> 限定链查434 = 查限定名静态字段类型(整64(n.文本));
            如果 (限定链查434.正常) {
                左类型c = 限定链查434.值;
                左类型c回退 = 真;
            } 否则 { }
        }
        如果 (!左类型c查.有值 && !左类型c回退) {
            表诊断(诊断, "[错误] 赋值目标未声明: " + 驻留文本(整64(n.文本)));
        }
        可选<整64> 左种类c查 = 表查找种类(符号表, 整64(n.文本));
        如果 (左种类c查.有值 && 左种类c查.值 == 符号_常量) {
            // #1678：诊断文本宿主逐字（semantic_expr_op.cpp 赋值位同款）
            表诊断(诊断, "[错误] 不能给常量 '" + 驻留文本(整64(n.文本)) +
                              "' 赋值（常量初始化后不可修改）");
        }
        // 480（473 p9 整族执法·零分叉补点）：链式赋值表达式位静态写——
        //   宿主 visitAssignmentExpr 对嵌套内层经 checkIdentifierAssignTarget
        //   同覆盖（探针实证 `x = (静态甲 = 5)` 宿主拦），v2 原缺位=分叉；
        //   顶层静态/函数内静态局部同受 §747-8 约束，不安全 函数内豁免。
        如果 (是全局静态名(整64(n.文本)) || 是静态局部名(整64(n.文本))) {
            错误不安全边界(诊断, "静态变量写", "静态变量赋值");
        }
        整64 检i = 整64(n.子起点);
        当 (检i < 整64(n.子终点)) {
            可选<整64> 忽略c = 检查表达式(池, 整32(检i), 符号表, 诊断);
            检i++;
        }
        // 435：lambda 引用捕获逃逸——链式赋值表达式位（`变量 y = x = [&]{…}`
        //   内层赋值根·宿主 visitAssignmentExpr 赋值位同构；实现=语义检查
        //   逃逸.cn）。右值区间检查后调用=捕获计数已回填。
        检查链式赋值lambda逃逸(池, n, 符号表, 诊断, 引用lambda变量们);  // 486：主表
        如果 (!左类型c查.有值 && !左类型c回退) { 返回 无; }
        返回 某些(左类型c);
    }
    返回 无;
}
