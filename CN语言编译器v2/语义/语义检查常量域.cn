// 语义检查默认参数常量性（#1814 乙案·001 §5.3 默认参数条文 2026-10-29 裁决·
//   自 语义分析尾 拆出——1040 冻结线先拆再加纪律）。
// 默认值须为编译期常量表达式（字面量/常量算式/顶层常量）；引用前形参、
//   变量、函数调用等运行期表达式编译期拒绝（诊断指路条文）。
// 结构：收集函数声明 参数循环调 登记默认值待验（有默认值=子起点≠0·233 契约）
//   记入待验表；声明收集 主循环后调 校验默认值常量性 统一判定——顶层常量值表
//   此刻已收齐（防声明顺序误拒：函数先于常量声明时即时查表会漏登记），
//   校验后清空。
// 区间扫描口径：参数节点 子起点=默认表达式根索引、子终点=表达式区间起点
//   （解析参数默认值 233 契约·区间=[子终点, 子起点] 含端点）——出现
//   节点_调用=拒；节点_标识符 非顶层常量（查顶层常量值 548 设施未命中·
//   前形参/普通变量同面）=拒；其余（字面量/算符节点）放行。
// 值域门槛（2026-10-30·窄整超域直赋面收口·宿主 checkDefaultParams 同构）：
//   常量性通过后补目标类型值域判（默认值通道无局部变量通道的隐式转换接力
//   链——整32 = 3000000000 原常量性放行后静默 32 位截断回绕=同字面量局部
//   变量通道已拒=同库分裂）。判据单点=IR 字面量域族（整字面量入域 字面量/
//   负号链面·区间含超域字面量919 子树超承载面·常量末至十进制919 常量算式
//   文本级求值面+字面量文本入域 域表——与局部变量 T36/535 静态槽同一张表，
//   禁第二份判据）。顶层常量名引用（548 值表命中）值文本归一后同表判域
//   （常量本身超目标域同拒）。非整数目标（浮点/字符串/布尔参数）不经本判域；
//   显式转换 整32(值) 位模式语义不受影响（CastExpr 不入默认值常量域·1814）。

导入 IO;
导入 容器::向量;
导入 语法;
导入 协议常量;
导入 语义;       // 表诊断/查顶层常量值（548 设施·语义包内兄弟模块）
导入 IR;         // 字面量文本入域/区间含超域字面量919/常量末至十进制919（域表单一真源）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 有默认值参数节点索引平铺（校验后清空——声明收集 每模块每趟一次）
静态 向量<整64> 默认值待验参数们;
// 平行：待验参数归属函数名ID（值域诊断「函数 'x' 参数 'y'」文案要素·同序登记
//   同序消费同序清空）
静态 向量<整64> 默认值待验函数名们;

// 登记待验（收集函数声明 参数循环消费）
不安全 函数 登记默认值待验(整64 参数节点索引, 整64 函数名ID) -> 空类型 {
    结果<空类型, 整32> 追加结果 = 默认值待验参数们.追加(参数节点索引);
    如果 (!追加结果.正常) { 运行时错误(4); }
    结果<空类型, 整32> 追加名结果 = 默认值待验函数名们.追加(函数名ID);
    如果 (!追加名结果.正常) { 运行时错误(4); }
}

// 默认值超目标域判定（值域门槛单点·宿主 checkDefaultParams 判域段同构）：
//   常量性通过后的默认表达式按参数目标类型值域判。三形态同拦（与局部变量
//   通道 T36 面同一张 IR 域表·禁第二份判据）：
//   ①字面量/一元负号链=整字面量入域（负号形态按数学负值判·-2147483648=
//     整32::MIN 域内合法）+负号壳补口（链下钻检不出·如 -(3000000000+0)=
//     常量末至十进制919 求值面同判——宿主 fits 后求值补口同构）；
//   ②常量算式=区间含超域字面量919 子树超承载面 + 常量末至十进制919 文本级
//     求值结果面（3000000000+0 同拦——默认值通道无局部变量通道的隐式转换
//     接力链；域内算式 3+4 恒放行）；
//   ③顶层常量名引用=548 值表值文本归一后同表判域（常量本身超目标域同拒）。
//   显式转换 整32(值) 位模式语义不受影响（CastExpr 不入默认值常量域·1814）。
不安全 函数 默认值超目标类型域(向量<节点> 池, 节点 待验参数, 字符串 参数类型文本) -> 布尔 {
    节点 默认值末 = 池.元素(整32(整64(待验参数.子起点)));
    如果 (默认值末.类型 == 节点_整数字面量 || 默认值末.类型 == 节点_负号) {
        // 命名豁免用例编号: 复用既有 919 立法链设施（整字面量入域·非新造带号名）
        如果 (!整字面量入域(默认值末, 池, 参数类型文本,
                          默认值末.类型 == 节点_负号)) {
            返回 真;
        }
        // 负号壳补口（宿主 checkDefaultParams fits 后 cnEvalConstIntExprText919
        //   补口同构·1860）：负号链下钻检不出（底层=常量算式·如
        //   -(3000000000+0)）时整字面量入域 放行——默认值通道无隐式转换
        //   接力链，此处补文本级求值域判（常量末至十进制919 负号节点递归
        //   取负）；纯字面量链求值同值=行为一致，非常量形态（含变量）交
        //   既有链。
        如果 (默认值末.类型 == 节点_负号) {
            整64 链常量文本ID = 0;
            // 命名豁免用例编号: 复用既有 919 立法链设施（常量末至十进制919·非新造带号名）
            如果 (常量末至十进制919(池, 整32(整64(待验参数.子起点)),
                                  链常量文本ID)) {
                如果 (链常量文本ID == 0) { 返回 真; }   // 超 u128 域哨兵（910 口径）
                字符串 链常量值d = 字符串复制(驻留文本(链常量文本ID));
                字符串 链常量数d = "";
                // 命名豁免用例编号: 复用既有 919 立法链设施（拆符号919/规范919·非新造带号名）
                布尔 链常负d = 拆符号919(链常量值d, 链常量数d);
                // 命名豁免用例编号: 复用既有 919 立法链设施（规范919·非新造带号名）
                链常量数d = 规范919(链常量数d);
                返回 !字面量文本入域(链常量数d, 参数类型文本, 链常负d);
            }
        }
        返回 假;   // 域内字面量/负号链（或求值交既有链）=放行
    }
    如果 (默认值末.类型 == 节点_二元运算) {
        // 命名豁免用例编号: 复用既有 919 立法链设施（区间含超域字面量919·非新造带号名）
        如果 (区间含超域字面量919(池, 整32(整64(待验参数.子起点)),
                                参数类型文本)) {
            返回 真;
        }
        整64 常量文本ID = 0;
        // 命名豁免用例编号: 复用既有 919 立法链设施（常量末至十进制919·非新造带号名）
        如果 (常量末至十进制919(池, 整32(整64(待验参数.子起点)), 常量文本ID)) {
            如果 (常量文本ID == 0) { 返回 真; }   // 超 u128 域哨兵（910 空串口径）
            字符串 常量值d = 字符串复制(驻留文本(常量文本ID));
            字符串 常量数d = "";
            // 命名豁免用例编号: 复用既有 919 立法链设施（拆符号919/规范919·非新造带号名）
            布尔 常负d = 拆符号919(常量值d, 常量数d);
            // 命名豁免用例编号: 复用既有 919 立法链设施（规范919·非新造带号名）
            常量数d = 规范919(常量数d);
            返回 !字面量文本入域(常量数d, 参数类型文本, 常负d);
        }
        返回 假;   // 非常量算术（混合变量等）=常量性段已拦/交既有链
    }
    如果 (默认值末.类型 == 节点_标识符) {
        整64 常量值槽d = 0;
        // 命名豁免用例编号: 复用既有 919 立法链设施（拆符号919/规范919·非新造带号名）
        如果 (查顶层常量值(整64(默认值末.文本), 常量值槽d)) {
            字符串 常量值d = 整数转字符串(常量值槽d);
            字符串 常量数d = "";
            // 命名豁免用例编号: 复用既有 919 立法链设施（拆符号919/规范919·非新造带号名）
            布尔 常负d = 拆符号919(常量值d, 常量数d);
            // 命名豁免用例编号: 复用既有 919 立法链设施（规范919·非新造带号名）
            常量数d = 规范919(常量数d);
            返回 !字面量文本入域(常量数d, 参数类型文本, 常负d);
        }
    }
    返回 假;   // 其余形态（布尔/字符串字面量等）不经整型值域判
}

// 统一校验（声明收集 主循环后消费）：逐待验参数区间扫描，非常量默认值
//   推诊断（文案与宿主 semantic_builtins 逐字一致·零分叉含文案 1027 先例）；
//   常量性通过后补目标类型值域判（超域拒·诊断与宿主 #1860 执法文案逐字
//   一致——双侧同拒同文）。
不安全 函数 校验默认值常量性(向量<节点> 池, 向量<字符串>& 诊断) -> 空类型 {
    整64 待验序号 = 0;
    当 (待验序号 < 默认值待验参数们.大小()) {
        整64 待验参数槽 = 默认值待验参数们.元素(整32(待验序号));
        节点 待验参数 = 池.元素(整32(待验参数槽));
        整64 函数名IDd = 默认值待验函数名们.元素(整32(待验序号));
        整64 表达式游标 = 整64(待验参数.子终点);
        布尔 默认值是常量 = 真;
        当 (表达式游标 <= 整64(待验参数.子起点) && 默认值是常量) {
            节点 表达式节点 = 池.元素(整32(表达式游标));
            如果 (表达式节点.类型 == 节点_调用) {
                默认值是常量 = 假;
            } 否则 如果 (表达式节点.类型 == 节点_标识符) {
                整64 常量值槽 = 0;
                如果 (!查顶层常量值(整64(表达式节点.文本), 常量值槽)) {
                    默认值是常量 = 假;
                }
            }
            表达式游标++;
        }
        如果 (!默认值是常量) {
            表诊断(诊断, "[错误] 默认值须为编译期常量表达式（字面量/常量算式/顶层常量）——引用前形参、变量或调用不支持（001 §5.3 默认参数·裁决 #1814）");
        } 否则 {
            // 值域门槛（宿主 checkDefaultParams 同构·常量性通过后判）：
            //   参数类型文本（类型节点文本·「整数」别名→整32 归一=宿主
            //   canonical 同口径）整数族才判——非整数目标不经本判域。
            // 静默豁免业务值: 参数类型节点索引越界守卫（越界=不判域交既有链·解析层类型
            //   节点契约保证命中·非静默丢值）——单边比较 词面扫描显形登记
            如果 (待验参数.附加 > 0 && 整64(待验参数.附加) < 池.大小()) {
                节点 类型节点d = 池.元素(待验参数.附加);
                字符串 参数类型文本 = 字符串复制(驻留文本(整64(类型节点d.文本)));
                如果 (字符串比较(参数类型文本, "整数")) {
                    参数类型文本 = 字符串复制("整32");
                }
                如果 (是转换整数族文本(参数类型文本) &&
                     默认值超目标类型域(池, 待验参数, 参数类型文本)) {
                    表诊断(诊断, "[错误] 函数 '" + 驻留文本(函数名IDd) +
                                  "' 参数 '" + 驻留文本(整64(待验参数.文本)) +
                                  "' 默认值超出 '" + 参数类型文本 +
                                  "' 值域——默认值直赋通道须为值域内字面量" +
                                  "（T36/#506甲·788⑤）；如确需位模式截断请显式" +
                                  "转换（如 " + 参数类型文本 +
                                  "(值)）；确需回绕语义请走显式回绕函数" +
                                  "（回绕加/回绕减/回绕乘）");
                }
            }
        }
        待验序号++;
    }
    默认值待验参数们.清空();
    默认值待验函数名们.清空();
}

不安全 函数 收集常量声明(向量<节点> 池, 整32 声明索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断,
              字符串 模块路径, 整64 本模块ID, 整64 是否公开) -> 空类型 {
    节点 声明 = 池.元素(声明索引);
// 族④：常量声明收集（原 823~837 段）——P7a 顶层常量登记（类型ID 记 整64
//   名ID；分桶后跨模块常量引用经三级解析）。
            // P7a：顶层常量登记（类型ID 记 整64 名ID——v2 整数字面量统一按 整64）；
            //   多文件两趟结构下第一趟全文件收集——分桶后跨模块常量引用经
            //   三级解析（②③ 须公开；① 同模块直查）
            整64 键基c = 键基合成(模块路径, 整64(声明.文本));
            // 953/938：常量类型按初值推导——布尔字面量→布尔（953 先例）；
            //   字符串初值（字面量/前序常量引用/拼接）→字符串（938·宿主
            //   checkConstIdentifier 值文本判类型同构）；其余整64 兼容口径。
            //   推导实现落 548 常量域文件（本文件超 900 警戒线：新增逻辑
            //   外移·先拆再加精神；938 判定与 IR 折叠串面同形态覆盖）。
            // 命名豁免<纯搬移>: 推导常量声明类型 定义于 548 模块·迁入代码非新增命名
            整64 常量类型 = 推导常量声明类型(池, 声明索引, 符号表, 模块路径);
            整64 忽略3 = 表注册(符号表, 键基c, 常量类型, 符号_常量, 是否公开);
            如果 (忽略3 == 0) { }
            // 548（编译期除零·常量传播）：顶层常量值登记（语义层值设施·宿主
            //   globalConstValues_ 机制对称——修前 v2 值内联仅 IR 层·语义阶段
            //   不可达=548 立案分叉种子）。初值子树经 折叠表达式子树值 求值（常量
            //   名引用已登记前序常量=链式常量可折叠·声明序单调；前向引用/浮点/
            //   布尔/字符串折叠失败不登记=除零面保守放行·宿主 registerConstValues
            //   顺序注册同口径）。多模块同名值不同由 登记顶层常量值 多义守卫。
            如果 (声明.子终点 > 声明.子起点 && 整64(声明.子终点 - 1) < 池.大小()) {
                整64 常量值 = 0;
                // 命名豁免<纯搬移>: 折叠表达式子树值 定义于 548 模块·迁入代码非新增命名
                如果 (折叠表达式子树值(池, 整32(声明.子终点 - 1), 常量值, 0, 符号表)) {
                    登记顶层常量值(整64(声明.文本), 常量值);
                }
            }
            结果<空类型, 整32> 设成员c = 模块成员键基们.设置(
                模块成员键(本模块ID, 整64(声明.文本)), 键基c);
            如果 (!设成员c.正常) { 运行时错误(4); }
            如果 (是否公开 == 1) {
                结果<空类型, 整32> 设公开c = 模块成员公开们.设置(
                    模块成员键(本模块ID, 整64(声明.文本)), 1);
                如果 (!设公开c.正常) { 运行时错误(4); }
            }
        }
