// 语义检查默认参数常量性（#1814 乙案·001 §5.3 默认参数条文 2026-10-29 裁决·
//   自 语义分析尾 拆出——1040 冻结线先拆再加纪律）。
// 默认值须为编译期常量表达式（字面量/常量算式/顶层常量）；引用前形参、
//   变量、函数调用等运行期表达式编译期拒绝（诊断指路条文）。
// 结构：收集函数声明 参数循环调 登记默认值待验（有默认值=子起点≠0·233 契约）
//   记入待验表；声明收集 主循环后调 校验默认值常量性 统一判定——顶层常量值表
//   此刻已收齐（防声明顺序误拒：函数先于常量声明时即时查表会漏登记），
//   校验后清空。
// 区间扫描口径：参数节点 子起点=默认表达式根索引、子终点=表达式区间起点
//   （解析参数默认值 233 契约·区间=[子终点, 子起点] 含端点）——出现
//   节点_调用=拒；节点_标识符 非顶层常量（查顶层常量值 548 设施未命中·
//   前形参/普通变量同面）=拒；其余（字面量/算符节点）放行。

导入 IO;
导入 容器::向量;
导入 语法;
导入 协议常量;
导入 语义;       // 表诊断/查顶层常量值（548 设施·语义包内兄弟模块）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 有默认值参数节点索引平铺（校验后清空——声明收集 每模块每趟一次）
静态 向量<整64> 默认值待验参数们;

// 登记待验（收集函数声明 参数循环消费）
不安全 函数 登记默认值待验(整64 参数节点索引) -> 空类型 {
    结果<空类型, 整32> 追加结果 = 默认值待验参数们.追加(参数节点索引);
    如果 (!追加结果.正常) { 运行时错误(4); }
}

// 统一校验（声明收集 主循环后消费）：逐待验参数区间扫描，非常量默认值
//   推诊断（文案与宿主 semantic_builtins 逐字一致·零分叉含文案 1027 先例）。
不安全 函数 校验默认值常量性(向量<节点> 池, 向量<字符串>& 诊断) -> 空类型 {
    整64 待验序号 = 0;
    当 (待验序号 < 默认值待验参数们.大小()) {
        整64 待验参数槽 = 默认值待验参数们.元素(整32(待验序号));
        节点 待验参数 = 池.元素(整32(待验参数槽));
        整64 表达式游标 = 整64(待验参数.子终点);
        布尔 默认值是常量 = 真;
        当 (表达式游标 <= 整64(待验参数.子起点) && 默认值是常量) {
            节点 表达式节点 = 池.元素(整32(表达式游标));
            如果 (表达式节点.类型 == 节点_调用) {
                默认值是常量 = 假;
            } 否则 如果 (表达式节点.类型 == 节点_标识符) {
                整64 常量值槽 = 0;
                如果 (!查顶层常量值(整64(表达式节点.文本), 常量值槽)) {
                    默认值是常量 = 假;
                }
            }
            表达式游标++;
        }
        如果 (!默认值是常量) {
            表诊断(诊断, "[错误] 默认值须为编译期常量表达式（字面量/常量算式/顶层常量）——引用前形参、变量或调用不支持（001 §5.3 默认参数·裁决 #1814）");
        }
        待验序号++;
    }
    默认值待验参数们.清空();
}

不安全 函数 收集常量声明(向量<节点> 池, 整32 声明索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断,
              字符串 模块路径, 整64 本模块ID, 整64 是否公开) -> 空类型 {
    节点 声明 = 池.元素(声明索引);
// 族④：常量声明收集（原 823~837 段）——P7a 顶层常量登记（类型ID 记 整64
//   名ID；分桶后跨模块常量引用经三级解析）。
            // P7a：顶层常量登记（类型ID 记 整64 名ID——v2 整数字面量统一按 整64）；
            //   多文件两趟结构下第一趟全文件收集——分桶后跨模块常量引用经
            //   三级解析（②③ 须公开；① 同模块直查）
            整64 键基c = 键基合成(模块路径, 整64(声明.文本));
            // 953/938：常量类型按初值推导——布尔字面量→布尔（953 先例）；
            //   字符串初值（字面量/前序常量引用/拼接）→字符串（938·宿主
            //   checkConstIdentifier 值文本判类型同构）；其余整64 兼容口径。
            //   推导实现落 548 常量域文件（本文件超 900 警戒线：新增逻辑
            //   外移·先拆再加精神；938 判定与 IR 折叠串面同形态覆盖）。
            // 命名豁免<纯搬移>: 推导常量声明类型 定义于 548 模块·迁入代码非新增命名
            整64 常量类型 = 推导常量声明类型(池, 声明索引, 符号表, 模块路径);
            整64 忽略3 = 表注册(符号表, 键基c, 常量类型, 符号_常量, 是否公开);
            如果 (忽略3 == 0) { }
            // 548（编译期除零·常量传播）：顶层常量值登记（语义层值设施·宿主
            //   globalConstValues_ 机制对称——修前 v2 值内联仅 IR 层·语义阶段
            //   不可达=548 立案分叉种子）。初值子树经 折叠表达式子树值 求值（常量
            //   名引用已登记前序常量=链式常量可折叠·声明序单调；前向引用/浮点/
            //   布尔/字符串折叠失败不登记=除零面保守放行·宿主 registerConstValues
            //   顺序注册同口径）。多模块同名值不同由 登记顶层常量值 多义守卫。
            如果 (声明.子终点 > 声明.子起点 && 整64(声明.子终点 - 1) < 池.大小()) {
                整64 常量值 = 0;
                // 命名豁免<纯搬移>: 折叠表达式子树值 定义于 548 模块·迁入代码非新增命名
                如果 (折叠表达式子树值(池, 整32(声明.子终点 - 1), 常量值, 0, 符号表)) {
                    登记顶层常量值(整64(声明.文本), 常量值);
                }
            }
            结果<空类型, 整32> 设成员c = 模块成员键基们.设置(
                模块成员键(本模块ID, 整64(声明.文本)), 键基c);
            如果 (!设成员c.正常) { 运行时错误(4); }
            如果 (是否公开 == 1) {
                结果<空类型, 整32> 设公开c = 模块成员公开们.设置(
                    模块成员键(本模块ID, 整64(声明.文本)), 1);
                如果 (!设公开c.正常) { 运行时错误(4); }
            }
        }
