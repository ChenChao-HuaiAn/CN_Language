// CN 自举编译器 v2 · 语义检查·转换语境源类型推导族（740 拆分+扩口·2026-10-14）
// 1064 增强（2026-10-18·#1040 派生缺口·丢星族 1039/872 同源根治）：二元指针
//   结果推导——指针 ± 整数 → 补星指针文本（元素文本+层数星）；指针 - 指针
//   → 整64（1040 立法差结果类型）；实现面=指针值表达式元素1064（标识符+
//   ± 链可靠面）+ 推导二元结果类型ID 指针面优先块。判据镜像=宿主 checkExpr
//   lastType_ / isJudgedPtrDiffOperand1040 / 宿主 IR ptrOperandSrcType。
// 788 增强（2026-10-15·745 轮 q1~q16 探针矩阵实证）：整数字面量**后缀定级**
//   接入推导族（修前恒 0 豁免标记/整32 文案=带 L/LL/U/UL/ULL 字面量在算术
//   二元恒 -1/整32 放行 vs 宿主定级参与拒——q1 `甲=3000000000L+0` 十二形态
//   分叉）+ 285 窄域适配同构（窄伴侣豁免带后缀字面量·q16 面·宿主
//   checkArithmeticBinary 同序 285→随侧→合并；位/移位面无 285 宿主同构）+
//   推导源类型文本 后缀定级文案（q4/q13 文案错位面）。三分法=无后缀→豁免
//   标记随侧（既有）；窄伴侣+字面量→285 拉窄（宿主放行面）；其余→后缀定级
//   参与（宿主拒面）。
// 拆分：自 语义检查表达式尾 机械搬移 推导源类型ID静默/推导源类型文本——该文件
//   870 行近 900 冻结警戒线而 740 须扩口，「先拆再加」纪律（86/443/字面量域
//   拆分先例同构）；跨模块可见性同包成立（消费方 语句/赋值/复合赋值 已跨模块
//   调用 表达式尾 族函数）。
// 职责：声明初始化/赋值/返回/实参/复合赋值转换检查语境的**源表达式类型零副作用
//   推导**（检查标量隐式转换/隐式转换合法/413 接口面/86 拼接面消费）+ 740 窄化
//   分叉根治面——算术/位二元与一元负号的结果类型推导（001 §3.7 隐式转换白名单
//   封闭〔窄化不在列〕+§3.7a #285 同宽窄保持窄域+#481 字面量按另一侧参与·
//   宿主 commonNumericType 同构）+ 772 调用源收口——普通函数调用源经签名表
//   零副作用查询精确推导（探针T 实锤：`整8 甲 = 出32();` 宿主拒 vs v2 修前
//   -1 放行静默截断；泛型基函数/方法/限定/内置/函数指针变量维持诚实边界
//   -1·豁免边界见 调用源返回类型ID静默 头注）。
公开:   // 推导源类型ID静默 / 推导源类型文本 / 调用源返回类型ID静默（转换检查语境消费）

// 772（2026-10-15·D 族调用源收口·探针T 实锤面）：调用源返回类型**零副作用**
//   签名查询——被调=纯名标识符且符号表种类=符号_函数 → 表查找类型ID（内部
//   三级化与 检查调用表达式 主路径同机制·宿主 resolvedSignature 同构）命中>0
//   即返回（符号_函数 条目 附加=返回类型ID·收集函数声明 登记惯例）。
//   miss 豁免边界声明（诚实边界·查表域外合法输入常态到达·非静默兜底——
//   110 纪律「合法 miss 面=查表接口须注释声明豁免边界」）：
//   ①被调非纯名（限定调用 模块.函数/方法调用 对象.方法=成员节点）——成员面
//     D 族另案（740 同轮定性「调用/成员维持 -1」之成员半边）；
//   ②泛型基函数（查泛型基类参数序>0·417-a 函数共用类表）——返回类型含类型
//     参数（T 系）实例化后才可知，零副作用面不推导（415 主路径改写实例名后
//     推断声明面已精确）；
//   ③内置与类型转换调用（不进符号表·种类≠符号_函数）；
//   ④函数指针变量调用（种类≠符号_函数·主路径 480 分支辖区）；
//   ⑤跨模块签名键回退 miss 面（检查签名键回退 有诊断副作用不入静默面）。
//   收紧零新增拒绝数学保证（740 同款）：凡「函数返回类型→目标不接受」形态
//   宿主必拒（§3.7 白名单封闭），v2 树源码每轮经宿主编译必无此形态——
//   精确推导对自举树零新增拒绝（772 备注「整64 兜底误伤 38 处」系走 检查
//   调用表达式 有副作用主路径之误，本查询纯只读不涉）。引用返回类型（尾 '&')
//   剥被引类型后返回=右值读语义（150 回归锚·宿主同构）。
函数 调用源返回类型ID静默(向量<节点> 池, 节点 调用节点772,
                        向量<映射<整64, 符号>>& 符号表) -> 整64 {
    如果 (调用节点772.子起点 <= 0 ||
         整64(调用节点772.子起点) >= 整64(池.大小())) { 返回 -1; }
    节点 被调772 = 池.元素(整32(调用节点772.子起点));
    如果 (被调772.类型 != 节点_标识符) { 返回 -1; }   // ①限定/方法被调=成员节点
    整64 被调名772 = 整64(被调772.文本);
    // ②泛型基函数：返回类型含类型参数（实例化后才可知·零副作用面不推导）
    如果 (查泛型基类参数序(被调名772) > 0) { 返回 -1; }
    // ③④内置/类型转换/函数指针变量：种类≠符号_函数 一并挡出
    可选<整64> 被调种772查 = 表查找种类(符号表, 被调名772);
    // miss（原 -1 哨兵）≠ 符号_函数 → 挡出（显式默认）
    布尔 被调是函数772 = 假;
    如果 (被调种772查.有值) { 被调是函数772 = 被调种772查.值 == 符号_函数; }
    如果 (!被调种772查.有值 || !被调是函数772) { 返回 -1; }
    // 752（16_function_extra dual 每头红根治）：**重载（多候选）排除**——与
    //   549 实参检查「多候选=诚实边界」同款判据（三级键基查找 + 候选数==1）：
    //   纯名键在重载族下=首登记候选残留（候选数==1 才登记、后续重载不登记
    //   亦无撤销）——按名取类型会拿到与调用点重载解析不一致的返回类型
    //   （16 实证：加("中","国") 被推成整32 版返回 → 赋值位误报「无法将
    //   '整32' 隐式转换为 '字符串'」；772 前该形态落尾 -1 诚实放行故绿）。
    //   候选数!=1（重载/键基不可知）→ -1 诚实放行。
    整64 键基752 = 三级键基查找(符号表, 被调名772, 整64(调用节点772.附加));
    如果 (键基752 < 0) { 返回 -1; }
    结果<整64, 整32> 查数752 = 查函数签名个数(键基752);
    整64 候选数752 = 0;   // 候选数提取（结果 流敏感检查惯例；0=无签名登记）
    如果 (查数752.正常) { 候选数752 = 查数752.值; }
    如果 (候选数752 != 1) { 返回 -1; }   // 非唯一候选=-1 诚实放行（调用方契约）
    整64 返回类型772 = 0;
    可选<整64> 返回类型772查 = 表查找类型ID(符号表, 被调名772);
    // miss 保持 0（下方 >0 判定与原 -1 哨兵同假·880 批5）
    如果 (返回类型772查.有值) { 返回类型772 = 返回类型772查.值; }
    如果 (返回类型772 > 0) {
        // 150 回归锚（L2 实锤·引用返回类型）：返回类型文本尾 '&'（-> 整64&）
        //   ——调用表达式作为转换检查源=左值→右值读=**被引类型**（宿主
        //   visitCallExpr 同构·150 行29 `整64 a = 取值(p);` 宿主放行实证）——
        //   剥引用后缀再返回（是引用返回调用 同款尾 '&'==38 判定先例·
        //   引用绑定/写穿面仍由 829/118 专用通道管辖不受影响）。
        字符串 返回文本772 = 字符串复制(驻留文本(返回类型772));
        整64 文长772 = 字符串长度(返回文本772);
        如果 (文长772 > 1 &&
             ((整64(返回文本772[整32(文长772 - 1)]) & 255) == 38)) {
            返回 驻留(字符串子串(返回文本772, 0, 整32(文长772 - 1)));
        }
        返回 返回类型772;
    }
    返回 -1;   // ⑤签名键回退 miss 面
}

// 源表达式类型零副作用推导（**只走可靠面·329-a 收紧**）：字面量节点由
//   隐式转换合法 直判不经此处；本函数精确处理 标识符（表查找·常量豁免）、
//   比较/短路二元（产物=布尔·宿主 w14 对齐）与普通函数调用源（772·签名表
//   零副作用查询·豁免边界见 调用源返回类型ID静默）。成员/下标=
//   **推导不可靠面一律 -1 放行**——容器方法（元素/删除/大小 等）与拼接产物
//   无精确推导（成员面须结构体字段表·D 族另案），防线消费兜底会误伤自举树
//   （38 处实证：整32 = 当前ID()/布尔 = 映射.删除()/字符串 = 输出.元素()/
//   前缀类型 = 节点常量）——随 v2 语义推导完善收口（D 族长线），六用例防线
//   不依赖不可靠面。
函数 推导源类型ID静默(向量<节点> 池, 整32 源末索引,
                    向量<映射<整64, 符号>>& 符号表) -> 整64 {
    如果 (源末索引 < 0 || 源末索引 >= 整32(池.大小())) { 返回 -1; }
    节点 n = 池.元素(源末索引);
    // 411（406 采样轮·枚举成员类型收口）：基名=枚举名（是枚举名·IR 枚举表
    //   418-a 数据源）→成员表达式类型=枚举名——修前成员面 -1 不可推导，算术
    //   总守卫（语义检查中 411 块）对枚举算术检不出放行（宿主 isNumeric(枚举)
    //   =假 拦·零分叉违例）。非枚举成员维持 -1（结构体成员=推导成员类型ID 面
    //   ·不在本静默面扩）。消费方=372 拼接推导/守卫类型文本（拼接语境左串
    //   直返字符串不看右·枚举成员出「枚举名」不破坏拼接放行）。
    如果 (n.类型 == 节点_成员 && n.子起点 > 0) {
        节点 基名411 = 池.元素(整32(n.子起点));
        如果 (基名411.类型 == 节点_标识符 && 是枚举名(整64(基名411.文本))) {
            返回 整64(基名411.文本);
        }
    }
    如果 (n.类型 == 节点_二元运算) {
        字符串 op文本 = 字符串复制(驻留文本(整64(n.文本)));
        如果 (字符串比较(op文本, "==") || 字符串比较(op文本, "!=") ||
             字符串比较(op文本, "<") || 字符串比较(op文本, ">") ||
             字符串比较(op文本, "<=") || 字符串比较(op文本, ">=") ||
             字符串比较(op文本, "&&") || 字符串比较(op文本, "||")) {
            返回 驻留("布尔");
        }
        // 372（v17 六族对齐批·001 §3.7/02§七）：+ 拼接面方向推导——数值→字符串
        //   隐式转换仅 + 拼接且**左操作数为字符串**时触发。左串（字符串/字符*）=
        //   拼接产物 字符串；左数值+右串=返回左类型（宿主 commonNumericType 回退
        //   同构——canConvert 无 整→字符串 规则→声明/赋值面拒·文案同宿主「无法
        //   将 '整32' 隐式转换为 '字符串'」。v2 修前污染面 -1 放行输出 '7日'——
        //   c359 实证）。末端字面量直判+标识符/嵌套二元递归=可靠面；其余仍 -1
        //   （污染面纪律不变·调用/成员不递归）。
        如果 (字符串比较(op文本, "+") && n.附加 > 0) {
            // 450（425 同族第三轮·左末索引口径统一）：二元节点**全构建形态统一
            //   契约**=附加=右操作数起点 → 左操作数**末端**=附加-1（970 比较面/
            //   425 算术总守卫/418 重载面 同口径）。构建点实测（450 探针池 dump
            //   实证）：①普通表达式二元（解析表达式中 建节点）=附加=子起点=右操
            //   作数起点（88-a 空左操作数设计：层3+ 下降时 左起点 重置为池尾，
            //   故 子起点-1 与 附加-1 **等价**——修前普通面行为本就对）；②复合
            //   赋值合成二元（`L += R` ≡ L=L+R·解析语句中/语句尾/语句/语句中兜底
            //   四处建节点）=附加=右操作数起点、子起点=左值副本起点——子起点-1
            //   取到左值副本**前一节点**（前语句根·错位·本处同族），附加-1 才是
            //   左值副本末节点=真左操作数末。差分当前被「-1 放行」诚实边界吸收
            //   （错位节点恒为前段根节点→推导 -1→放行导向），但契约必须统一——
            //   三轮同族错位（970 段/425 守卫/450 静默推导面）至此全语义面归一。
            整64 左末372 = 整64(n.附加) - 1;
            整64 右末372 = 整64(源末索引) - 1;
            如果 (左末372 >= 0 && 右末372 >= 0 &&
                 左末372 < 整64(池.大小()) && 右末372 < 整64(池.大小())) {
                节点 左末n372 = 池.元素(整32(左末372));
                节点 右末n372 = 池.元素(整32(右末372));
                整64 左ID372 = 0 - 1;
                如果 (左末n372.类型 == 节点_整数字面量) {
                    // 788：带后缀按后缀定级（宿主 checkExpr 定级同构——
                    //   `3000000000L+"日"` 右串回左ID 面宿主算术守卫文案出
                    //   '整64'）；无后缀=整32 恒定级（既有契约不动）
                    整64 拼左后缀788 = 字面量后缀类型ID(
                        字符串复制(驻留文本(整64(左末n372.文本))));
                    如果 (拼左后缀788 > 0) {
                        左ID372 = 拼左后缀788;
                    } 否则 {
                        左ID372 = 驻留("整32");
                    }
                } 否则 如果 (左末n372.类型 == 节点_浮点字面量) {
                    左ID372 = 驻留("浮64");
                } 否则 如果 (左末n372.类型 == 节点_字符串字面量) {
                    左ID372 = 驻留("字符串");
                } 否则 {
                    左ID372 = 推导源类型ID静默(池, 整32(左末372), 符号表);
                }
                整64 右ID372 = 0 - 1;
                如果 (右末n372.类型 == 节点_字符串字面量) {
                    右ID372 = 驻留("字符串");
                } 否则 如果 (右末n372.类型 == 节点_标识符) {
                    右ID372 = 推导源类型ID静默(池, 整32(右末372), 符号表);
                }
                布尔 左串372 = 左ID372 == 驻留("字符串") || 左ID372 == 驻留("字符*");
                布尔 右串372 = 右ID372 == 驻留("字符串") || 右ID372 == 驻留("字符*");
                如果 (左串372) { 返回 驻留("字符串"); }
                如果 (右串372 && 左ID372 > 0) { 返回 左ID372; }
            }
        }
        // 740（2026-10-14·001 §3.7 白名单封闭+§3.7a #285/#481）：算术/位二元
        //   结果类型推导（可靠面）——修前恒 -1 放行=「整32 表达式赋窄变量」
        //   全通道静默截断分叉（宿主拒·rc=1 vs v2 rc=0 产码·572 探针副产
        //   实锤面：声明/赋值/数组元素/字段/返回/实参/复合赋值七通道全中）。
        //   操作数只走可靠面（字面量标记/标识符表查/嵌套算术二元递归）——
        //   调用/成员操作数维持不可靠 -1（329-a 收紧纪律·自举树 38 处兜底
        //   面不误伤：凡宿主拒的形态 v2 树源码必无〔v2 树每轮经宿主编译〕，
        //   收紧至宿主同判对自举树零新增拒绝）。
        返回 推导二元结果类型ID(池, 源末索引, 符号表);
    }
    如果 (n.类型 == 节点_标识符) {
        // 常量豁免（符号_常量 类型ID 记 整64 名ID·收集常量声明 惯例——
        //   整32 变量 = 节点常量 是 v2 树高频合法形态）
        // 1011（353·v2 语义同拒·78_v2 回归修正）：豁免收窄仅限**强类型常量**
        //   （布尔/字符串——984 调试模式=布尔、953 布尔推导常量等真实注册
        //   形态）——布尔→字符串 等跨族赋值两侧同拒；整/浮族维持 -1 豁免
        //   （收集常量声明 对数值常量恒登记 整64 宽松口径——常量值按字面量
        //   值域适配任何整型目标〔`整32 x = 常量` 高频合法〕，收窄会让窄化
        //   检查对 v2 树全量误报〔78_v2 实锤〕）。
        可选<整64> 常量种类1011查 = 表查找种类(符号表, 整64(n.文本));
        如果 (常量种类1011查.有值 && 常量种类1011查.值 == 符号_常量) {
            整64 常量类型1011 = 0;
            可选<整64> 常量类型1011查 = 表查找类型ID(符号表, 整64(n.文本));
            // miss 保持 0（下方 >0 判定与原 -1 哨兵同假·880 批5）
            如果 (常量类型1011查.有值) { 常量类型1011 = 常量类型1011查.值; }
            如果 (常量类型1011 > 0) {
                字符串 常量类型文本1011 = 字符串复制(驻留文本(常量类型1011));
                如果 (字符串比较(常量类型文本1011, "布尔") ||
                     字符串比较(常量类型文本1011, "字符串")) {
                    返回 常量类型1011;
                }
            }
            返回 -1;
        }
        可选<整64> 源类型1011查 = 表查找类型ID(符号表, 整64(n.文本));
        如果 (源类型1011查.有值) { 返回 源类型1011查.值; }
        返回 -1;
    }
    // 413（2026-10-11）：构造调用类型=类名自身（951 立法语义——「构造调用返回
    //   类名自身」·用户类构造调用分支同源）——供接口变量初始化「类→接口」
    //   隐式转换检查推导初值类型（101 负例面·零分叉）。
    如果 (n.类型 == 节点_调用 && n.子起点 > 0 && 整64(n.子起点) < 整64(池.大小())) {
        节点 被调413 = 池.元素(整32(n.子起点));
        如果 (被调413.类型 == 节点_标识符 && 是用户类_ID(整64(被调413.文本))) {
            返回 整64(被调413.文本);
        }
    }
    // 772（2026-10-15·D 族调用源收口）：普通函数调用源精确推导——探针T 实锤
    //   面（`整8 甲 = 出32();` 宿主拒「无法将 '整32' 隐式转换为 '整8'」vs v2
    //   修前调用源 -1 放行静默截断产码）。零副作用签名查询·豁免边界与零新增
    //   拒绝数学保证见 调用源返回类型ID静默 头注。
    如果 (n.类型 == 节点_调用) {
        整64 调用源772 = 调用源返回类型ID静默(池, n, 符号表);
        如果 (调用源772 > 0) { 返回 调用源772; }
    }
    // 740：一元负号结果=操作数类型（宿主 checkExpr 对 -乙 给操作数类型同构）
    //   ——操作数可靠（整字面量=恒定级整32/标识符=表查）才推导；其余 -1。
    //   消费面：`整8 甲 = -乙32变量`（宿主拒「无法将 '整32' 隐式转换为
    //   '整8'」·v2 修前 -1 放行静默截断=同族分叉）。
    // 772：负号+调用操作数接通（`整8 甲 = -出32();` 宿主拒 vs v2 修前 -1
    //   放行——miss 不可静默纪律：同轮对齐不留同族静默终态）。
    如果 (n.类型 == 节点_负号 && n.子终点 > n.子起点) {
        节点 负操作数740 = 池.元素(整32(n.子终点 - 1));
        // 590（2026-10-16）：多重负号链下钻——一元负逐层保型（宿主解析期
        //   负号折叠等价语义：-(-X) 链结果类型=底层 X 类型），操作数仍为负号
        //   时继续取操作数根（子终点-1 契约），直到字面量/标识符/调用实节点；
        //   修前链形态立即 -1 放行（-(-2147483648) 诊断/实参面漏检同族根因）。
        //   守卫=深度上限 64 防病态环 + 子终点区间校验防越界。
        整64 深740 = 0;
        当 (深740 < 64 && 负操作数740.类型 == 节点_负号 &&
             负操作数740.子终点 > 0 &&
             负操作数740.子终点 <= 整32(池.大小())) {
            负操作数740 = 池.元素(整32(负操作数740.子终点) - 1);
            深740++;
        }
        如果 (负操作数740.类型 == 节点_整数字面量) {
            // 788：带后缀按后缀定级（宿主 visitUnaryExpr 给操作数定级类型同构
            //   ·与 二元操作数类型ID 负号分支同口径）；无后缀=整32 恒定级
            整64 负源后缀788 = 字面量后缀类型ID(
                字符串复制(驻留文本(整64(负操作数740.文本))));
            如果 (负源后缀788 > 0) { 返回 负源后缀788; }
            返回 驻留("整32");
        }
        如果 (负操作数740.类型 == 节点_标识符) {
            可选<整64> 负操作数740查 = 表查找类型ID(符号表, 整64(负操作数740.文本));
            如果 (负操作数740查.有值) { 返回 负操作数740查.值; }
            返回 -1;
        }
        如果 (负操作数740.类型 == 节点_调用) {
            返回 调用源返回类型ID静默(池, 负操作数740, 符号表);
        }
        返回 -1;
    }
    返回 -1;   // 成员/下标/三元=不可靠面·放行（成员面 D 族另案）
}

// 740：二元操作数类型零副作用推导（只走可靠面·供 推导二元结果类型ID）。
//   返回 0=整数字面量形态标记（#285/#481「字面量按另一侧类型参与」·移位面
//   例外见 推导二元结果类型ID；值域不在此查——运行期错误码8面/常量折叠面
//   各司其职）；>0=类型名ID；-1=不可靠/不可推导。
// 772：调用操作数接通（`整8 甲 = 出32() + 0;` 宿主拒——修前调用/成员/下标
//   恒 -1 放行=同族静默终态残留·miss 不可静默纪律同轮对齐不留）；成员/下标
//   维持 -1（成员面 D 族另案·诚实边界同前）。
函数 二元操作数类型ID(向量<节点> 池, 整32 操作数末索引,
                    向量<映射<整64, 符号>>& 符号表) -> 整64 {
    如果 (操作数末索引 < 0 || 操作数末索引 >= 整32(池.大小())) { 返回 -1; }
    节点 n = 池.元素(操作数末索引);
    如果 (n.类型 == 节点_整数字面量) {
        // 788（2026-10-15·宿主 checkExpr→visitIntegerLiteral→literalTypeOf
        //   定级同构·745 轮 q1/q2/q3 探针实证面）：带后缀字面量按后缀定级
        //   参与（`甲32+1L` 宿主推整64 拒「无法将 '整64' 隐式转换为 '整32'」
        //   vs 修前恒 0 豁免标记随侧放行=静默截断分叉）；负号形态（323 解析期
        //   折叠 raw 首字符 '-'·如 -1）=整32 恒定级**不随侧**（宿主
        //   isUnsuffixedIntLiteral728 排除负号+literalTypeOf("-1")=整32 同构）；
        //   无后缀非负维持 0=豁免标记（#285/#481「字面量按另一侧类型参与」
        //   ·随侧归一在 推导二元结果类型ID 788 块）。
        整64 后缀ID788 = 字面量后缀类型ID(字符串复制(驻留文本(整64(n.文本))));
        如果 (后缀ID788 > 0) { 返回 后缀ID788; }
        字符串 字面文本788 = 字符串复制(驻留文本(整64(n.文本)));
        如果 (字符串长度(字面文本788) > 0 &&
             (整64(字面文本788[0]) & 255) == 45) {
            返回 驻留("整32");   // 负号折叠形态=整32 恒定级（不随侧·宿主同构）
        }
        返回 0;
    }
    如果 (n.类型 == 节点_负号 && n.子终点 > n.子起点) {
        // 负号+整字面量（未折叠形态）：带后缀按后缀定级（宿主 visitUnaryExpr
        //   给操作数定级类型同构）；无后缀=整32 恒定级不随侧（修前 0 标记随侧
        //   与宿主 728s 负号口径不对称·788 一并收口）；负号+标识符=标识符类型
        节点 负根740 = 池.元素(整32(n.子终点 - 1));
        如果 (负根740.类型 == 节点_整数字面量) {
            整64 负后缀ID788 = 字面量后缀类型ID(
                字符串复制(驻留文本(整64(负根740.文本))));
            如果 (负后缀ID788 > 0) { 返回 负后缀ID788; }
            返回 驻留("整32");
        }
        如果 (负根740.类型 == 节点_标识符) {
            可选<整64> 负根740查 = 表查找类型ID(符号表, 整64(负根740.文本));
            如果 (负根740查.有值) { 返回 负根740查.值; }
            返回 -1;
        }
        // 772：负号+调用 同构接通
        如果 (负根740.类型 == 节点_调用) {
            返回 调用源返回类型ID静默(池, 负根740, 符号表);
        }
        返回 -1;
    }
    如果 (n.类型 == 节点_浮点字面量) {
        // f 后缀分型（推导源类型文本 同口径·诊断文案与宿主逐字一致）
        字符串 字面文本740 = 字符串复制(驻留文本(整64(n.文本)));
        整64 文本长740 = 字符串长度(字面文本740);
        如果 (文本长740 > 1 && ((整64(字面文本740[文本长740 - 1]) & 255) == 102)) {
            返回 驻留("浮32");
        }
        返回 驻留("浮64");
    }
    如果 (n.类型 == 节点_标识符) {
        // 1011 同款常量豁免（548 锁面 912 撞出·与 推导源类型ID静默 标识符分支
        //   逐字同构=通道一致性）：P7a 顶层常量登记 类型ID 恒记 整64（收集常量
        //   声明 惯例「v2 整数字面量统一按 整64」）——740 二元面修前直查表把
        //   数值常量当 整64 操作数→混宽提升误抬（`整32 商 = 甲 / 非零;` 宿主
        //   放行 vs v2 拒「无法将 '整64' 隐式转换为 '整32'」=分叉实锤）。数值族
        //   常量 -1（值域适配任何整型目标·任一侧 -1 整体放行既有纪律）；布尔/
        //   字符串强类型常量返回真实类型（984/953 真实注册形态·1011 口径原样）。
        可选<整64> 常量种类548查 = 表查找种类(符号表, 整64(n.文本));
        如果 (常量种类548查.有值 && 常量种类548查.值 == 符号_常量) {
            整64 常量类型548 = 0;
            可选<整64> 常量类型548查 = 表查找类型ID(符号表, 整64(n.文本));
            // miss 保持 0（下方 >0 判定与原 -1 哨兵同假·880 批5）
            如果 (常量类型548查.有值) { 常量类型548 = 常量类型548查.值; }
            如果 (常量类型548 > 0) {
                字符串 常量类型文本548 = 字符串复制(驻留文本(常量类型548));
                如果 (字符串比较(常量类型文本548, "布尔") ||
                     字符串比较(常量类型文本548, "字符串")) {
                    返回 常量类型548;
                }
            }
            返回 -1;
        }
        可选<整64> 源类型548查 = 表查找类型ID(符号表, 整64(n.文本));
        如果 (源类型548查.有值) { 返回 源类型548查.值; }
        返回 -1;
    }
    如果 (n.类型 == 节点_调用) {
        // 772：调用操作数精确推导（豁免边界见 调用源返回类型ID静默 头注；
        //   非数值返回类型文本落 推导二元结果类型ID 非整浮出口 -1 放行=
        //   既有边界不动·无新增拒绝面）
        返回 调用源返回类型ID静默(池, n, 符号表);
    }
    如果 (n.类型 == 节点_二元运算) {
        返回 推导二元结果类型ID(池, 操作数末索引, 符号表);
    }
    返回 -1;   // 成员/下标=不可靠面（诚实边界·成员面 D 族另案）
}

// 788：285 窄族ID判定（宿主 checkArithmeticBinary isNarrow280 同构：整8/整16/
//   正8/正16）。0/-1=字面量豁免标记/不可推导恒非窄（字面量定级永不落窄族）。
//   〔重复标记：与 语义检查推导.cn 46-c 面 788 块「整型秩名∈{1,2}」同构异形
//   ——该面无 0 标记语义·两处判定域相同，跨文件归一随 D 族推导统一〕
函数 是窄整ID788(整64 类型ID788) -> 布尔 {
    如果 (类型ID788 <= 0) { 返回 假; }
    字符串 名788 = 字符串复制(驻留文本(类型ID788));
    返回 字符串比较(名788, "整8") || 字符串比较(名788, "整16") ||
          字符串比较(名788, "正8") || 字符串比较(名788, "正16");
}

// 1064（#1040 派生缺口·丢星族收口·1039/872 同源）：指针值表达式元素推导——
//   末节点为「二元 ± 链」时判定该表达式结果是否为指针值（宿主 checkExpr
//   lastType_ 面同构·1040 立法收窄的实现面扩展）：左指针 ± 非指针偏移 →
//   结果=指针（元素=左元素·层数=左层数——p±n 链层数不变）；指针 - 指针 →
//   结果=整（1040 立法差结果=整64·非指针）；其余形态=不可判。返回元素类型
//   ID（>0=指针值·0=非指针/不可判）；层数出=指针层数（0=非指针）。
//   可靠面=标识符（语义指针变量表命中·字符元素=字符串语义视图豁免同 425
//   面）与 ± 链递归；调用/成员/下标/取地址等复合形态维持不可判（诚实边界·
//   D 族另案）。三处同构镜像：宿主 isJudgedPtrDiffOperand1040 / 宿主 IR
//   ptrOperandSrcType / 本函数。
//   miss 豁免边界声明（110 纪律·648 显形面）：①查语义指针变量 未命中=-1=
//   非指针变量（表 miss 语义·非静默默认值·调用方恒以 >0 为准）；②查语义
//   指针层数 与 指针变量表 由 615 登记点（登记语义指针变量）成对双写——
//   命中即 >=1，层<1 仅防御面（成对不变量被破坏），按非指针显式返回 0，
//   不取默认层数继续语义判定。
函数 指针值表达式元素1064(向量<节点> 池, 整32 末索引1064, 整64& 层数出1064) -> 整64 {
    层数出1064 = 0;
    布尔 索引在界1064 = 末索引1064 >= 0 && 末索引1064 < 整32(池.大小());
    如果 (!索引在界1064) { 返回 0; }
    节点 末1064 = 池.元素(末索引1064);
    如果 (末1064.类型 == 节点_标识符) {
        整64 元1064 = 查语义指针变量(整64(末1064.文本));
        布尔 元素命中1064 = 元1064 > 0;
        布尔 非字符元素1064 = 元素命中1064 &&
             !字符串比较(字符串复制(驻留文本(元1064)), "字符");
        整64 层1064 = 查语义指针层数(整64(末1064.文本));
        布尔 层登记1064 = 层1064 > 0;
        布尔 指针值1064 = 非字符元素1064 && 层登记1064;
        如果 (!指针值1064) { 返回 0; }
        层数出1064 = 层1064;
        返回 元1064;
    }
    如果 (末1064.类型 != 节点_二元运算) { 返回 0; }
    字符串 op1064 = 字符串复制(驻留文本(整64(末1064.文本)));
    布尔 加减面1064 = 字符串比较(op1064, "+") || 字符串比较(op1064, "-");
    如果 (!加减面1064) { 返回 0; }
    布尔 附加在界1064 = 末1064.附加 >= 1 && 末1064.附加 <= 整32(池.大小());
    如果 (!附加在界1064) { 返回 0; }
    // 线性化节点池（操作数恒在算子之前）——递归沿 附加-1/自身索引-1 严格
    //   下行，无环（同 425 面左末/右末口径 450 契约）。
    整64 层左1064 = 0;
    整64 左元1064 = 指针值表达式元素1064(池, 整32(整64(末1064.附加) - 1), 层左1064);
    布尔 左指针值1064 = 左元1064 > 0;
    如果 (!左指针值1064) { 返回 0; }
    整64 层右1064 = 0;
    整64 右元1064 = 指针值表达式元素1064(池, 整32(整64(末索引1064) - 1), 层右1064);
    布尔 右指针值1064 = 右元1064 > 0;
    布尔 差形1064 = 右指针值1064 && 字符串比较(op1064, "-");
    布尔 非指针链1064 = 差形1064 || 右指针值1064;   // 指针差=整（1040）/ 指针+指针=非法（425 面执法）
    如果 (非指针链1064) { 返回 0; }
    层数出1064 = 层左1064;
    返回 左元1064;
}

// 740：转换语境二元算术/位结果类型推导（宿主 commonNumericType+#285/#481
//   同构·比较/短路二元已由 推导源类型ID静默 上游直判布尔不落此处；+ 拼接面
//   已于 372 分支收口不落此处）。规则：
//   ①算术/位面（+ - * / % & | ^）：一侧整字面量（含负号字面量）→字面量按
//     另一侧类型参与（结果=另一侧·#481 实测锚 P/Q：甲8+1/甲8+300 均同型
//     放行）；双侧整字面量→恒定级 整32（无后缀·宿主 literalTypeOf 同构·
//     实测锚 N/N2：100+200 赋整8 拒）。
//   ②移位面（<< >>）：右操作数**不豁免**（字面量按恒定级整32 参与·宿主
//     实测锚 AD：甲8<<2 赋整8 拒「无法将 '整32' 隐式转换为 '整8'」——
//     与算术面字面量豁免不同域）。
//   ③双侧变量/表达式：整数族/浮点族同族合并取位宽较宽者（同秩取左）——
//     同宽窄族自然保持窄域〔#285·实测锚 R/AC/AE：甲8+乙8/甲8&乙8/甲8<<乙8
//     赋整8 放行〕；混宽提升较宽侧〔实测锚 S/AA/AB：甲8+乙32/甲8<<乙32/
//     甲8&乙32 赋整8 拒〕；整浮混合取浮（宿主 commonNumericType 同款）。
//   ④异符号：本函数不查符号（分层与宿主 commonNumericType 同构——混合符号
//     由 检查混合符号二元/检查混合符号赋值 辖区执法·实测锚 X 双侧已拦）。
//   ⑤任一侧 -1（成员/下标/泛型基调用等不可靠面）=整体 -1 放行（329-a 纪律
//     不变·调用源已于 772 接通精确推导）；字符/布尔/枚举参与=不可靠面 -1
//     放行（字符↔整数互通/枚举算术既有边界不动·宿主字符参与
//     commonNumericType 回退整32 面随 D 族收口）。
//   ⑥1064 指针面优先（丢星族收口）：指针 ± 整数 → 补星指针文本；指针 -
//     指针 → 整64（1040）——见函数体 1064 块注释；不可判落 ①~⑤ 既有通道。
函数 推导二元结果类型ID(向量<节点> 池, 整32 节点索引,
                    向量<映射<整64, 符号>>& 符号表) -> 整64 {
    如果 (节点索引 < 0 || 节点索引 >= 整32(池.大小())) { 返回 -1; }
    节点 n = 池.元素(节点索引);
    // 450 契约：附加=右操作数起点 → 左末=附加-1、右末=本索引-1
    如果 (n.附加 <= 0 || n.附加 > 整32(池.大小())) { 返回 -1; }
    // 1064（#1040 派生缺口·丢星族 1039/872 同源根治）：**指针面优先**——v2
    //   推导器原对指针 ± 整数丢星（操作数经符号表=剥星基名 整32 → 合并推
    //   「整32」，`整64 甲 = p + 1;` 误拒 / `整32 窄 = q - p;` 误放=双侧
    //   分叉全族）。判定=指针值表达式元素1064（无副作用·可靠面同 425 面）：
    //   ①左指针 ± 非指针偏移 → 指针（元素文本+层数星·指针文本补星1039 单一
    //   格式化）；②指针 - 指针 → 整64（1040 立法差结果类型·异型为错误恢复
    //   值与宿主 lastType_ 整64 同）；③左非指针右指针 → 右指针文本（整数±
    //   指针错误恢复=宿主 lastType_=rightType 同）。不可判（0）落既有 740
    //   通道零变化（诚实边界保持）。镜像=宿主 checkExpr lastType_ 面。
    字符串 op1064 = 字符串复制(驻留文本(整64(n.文本)));
    如果 (字符串比较(op1064, "+") || 字符串比较(op1064, "-")) {
        整64 层左1064 = 0;
        整64 左元1064 = 指针值表达式元素1064(池, 整32(整64(n.附加) - 1), 层左1064);
        布尔 左指针值1064 = 左元1064 > 0;
        如果 (左指针值1064) {
            整64 层右1064 = 0;
            整64 右元1064 = 指针值表达式元素1064(池, 整32(整64(节点索引) - 1), 层右1064);
            布尔 右指针值1064 = 右元1064 > 0;
            布尔 差结果1064 = 右指针值1064 && 字符串比较(op1064, "-");
            如果 (差结果1064) {
                返回 驻留("整64");
            }
            返回 驻留(指针文本补星1039(字符串复制(驻留文本(左元1064)), 层左1064));
        }
        整64 层右他1064 = 0;
        整64 右元他1064 = 指针值表达式元素1064(池, 整32(整64(节点索引) - 1), 层右他1064);
        布尔 右指针值他1064 = 右元他1064 > 0;
        如果 (右指针值他1064) {
            返回 驻留(指针文本补星1039(字符串复制(驻留文本(右元他1064)), 层右他1064));
        }
    }
    整64 左ID = 二元操作数类型ID(池, 整32(整64(n.附加) - 1), 符号表);
    整64 右ID = 二元操作数类型ID(池, 整32(整64(节点索引) - 1), 符号表);
    如果 (左ID == -1 || 右ID == -1) { 返回 -1; }
    // 移位面：字面量标记 0 直译恒定级整32（右操作数不豁免·锚 AD）
    字符串 op740 = 字符串复制(驻留文本(整64(n.文本)));
    布尔 是移位740 = 字符串比较(op740, "<<") || 字符串比较(op740, ">>");
    // 788：算术面判定（宿主 isArithmeticOp 同构·285 窄域适配仅此面——
    //   位/移位面走 checkBitwiseBinary 无 285·p32 实测 `甲8&1L` 宿主拒整64）
    布尔 是算术788 = 字符串比较(op740, "+") || 字符串比较(op740, "-") ||
                   字符串比较(op740, "*") || 字符串比较(op740, "/") ||
                   字符串比较(op740, "%");
    如果 (是移位740) {
        如果 (左ID == 0) { 左ID = 驻留("整32"); }
        如果 (右ID == 0) { 右ID = 驻留("整32"); }
    } 否则 {
        // 788（宿主 checkArithmeticBinary 285 窄域适配同构·**先于字面量随侧**
        //   宿主同序）：一侧窄整+另一侧非窄+非窄侧末端=整数字面量形态（含负号
        //   ·宿主 isIntLiteralExpr 同构·是整数字面量末端 复用）→ 字面量侧按
        //   窄侧参与。q16 实证面：`甲8+1L` 宿主 285 拉窄放行 vs 修前 0 豁免/
        //   纯后缀定级接入均分叉（前者放行错类型、后者推整64 误拒=反向）。
        //   p28/p29/p31 实证（甲16+2ULL/甲8+2U/丙U8+1L 宿主放行）。前提=双侧
        //   整数参与（宿主 isInteger 双侧同构：0 标记=整字面量恒整数族·定级侧
        //   判整数族文本；浮点/字符/布尔/枚举定级不进 285）。
        如果 (是算术788) {
            布尔 左整参与788 = 左ID == 0 ||
                            (左ID > 0 && 是转换整数族文本(字符串复制(驻留文本(左ID))));
            布尔 右整参与788 = 右ID == 0 ||
                            (右ID > 0 && 是转换整数族文本(字符串复制(驻留文本(右ID))));
            如果 (左整参与788 && 右整参与788) {
                布尔 左窄788 = 是窄整ID788(左ID);
                布尔 右窄788 = 是窄整ID788(右ID);
                如果 (右窄788 && !左窄788 &&
                     是整数字面量末端(池, 整32(整64(n.附加) - 1))) {
                    左ID = 右ID;
                } 否则 如果 (左窄788 && !右窄788 &&
                     是整数字面量末端(池, 整32(整64(节点索引) - 1))) {
                    右ID = 左ID;
                }
            }
        }
        // 算术/位面：字面量按另一侧类型参与（#285/#481）
        如果 (左ID == 0 && 右ID == 0) { 返回 驻留("整32"); }   // 双整字面量恒定级
        如果 (左ID == 0) { 返回 右ID; }
        如果 (右ID == 0) { 返回 左ID; }
    }
    // 双侧均变量/表达式（或移位面已直译的字面量）：同族合并取较宽（同秩取左）
    字符串 左文本 = 字符串复制(驻留文本(左ID));
    字符串 右文本 = 字符串复制(驻留文本(右ID));
    布尔 左整 = 是转换整数族文本(左文本);
    布尔 右整 = 是转换整数族文本(右文本);
    布尔 左浮 = 是转换浮点族文本(左文本);
    布尔 右浮 = 是转换浮点族文本(右文本);
    如果 (左整 && 右整) {
        如果 (转换类型位宽(左文本) >= 转换类型位宽(右文本)) { 返回 左ID; }
        返回 右ID;
    }
    如果 (左浮 && 右浮) {
        如果 (转换类型位宽(左文本) >= 转换类型位宽(右文本)) { 返回 左ID; }
        返回 右ID;
    }
    如果 ((左整 || 左浮) && (右整 || 右浮)) {
        // 整浮混合→浮（宿主 commonNumericType 同构·含 浮32+浮64→浮64）
        如果 (左浮) { 返回 左ID; }
        返回 右ID;
    }
    返回 -1;   // 字符/布尔/枚举参与=不可靠面放行（既有边界不动）
}

// 诊断措辞用源类型文本（字面量节点直判文本；不可推导回退目标文本占位）
函数 推导源类型文本(向量<节点> 池, 整32 源末索引,
                  向量<映射<整64, 符号>>& 符号表, 字符串 回退文本) -> 字符串 {
    如果 (源末索引 < 0 || 源末索引 >= 整32(池.大小())) { 返回 字符串复制(回退文本); }
    节点 源末 = 池.元素(源末索引);
    如果 (源末.类型 == 节点_整数字面量) {
        // 788：后缀定级文案（宿主 literalTypeOf 同构·745 轮 q4/q13 探针实证：
        //   `整32 甲=3000000000L` 宿主诊断「无法将 '整64' 隐式转换为 '整32'」
        //   vs 修前恒 '整32' 文案错位——411 守卫文案数值源同此）；无后缀=整32
        //   （p22 无后缀超域宿主值域文案同 '整32'）
        整64 文后缀ID788 = 字面量后缀类型ID(
            字符串复制(驻留文本(整64(源末.文本))));
        如果 (文后缀ID788 > 0) { 返回 字符串复制(驻留文本(文后缀ID788)); }
        返回 "整32";
    }
    如果 (源末.类型 == 节点_浮点字面量) {
        字符串 字面文本 = 字符串复制(驻留文本(整64(源末.文本)));
        整64 文本长 = 字符串长度(字面文本);
        如果 (文本长 > 1 && ((整64(字面文本[文本长 - 1]) & 255) == 102)) {
            返回 "浮32";
        }
        返回 "浮64";
    }
    如果 (源末.类型 == 节点_布尔字面量) { 返回 "布尔"; }
    如果 (源末.类型 == 节点_字符串字面量) { 返回 "字符串"; }
    如果 (源末.类型 == 节点_字符字面量) { 返回 "字符"; }
    整64 源类型ID = 推导源类型ID静默(池, 源末索引, 符号表);
    如果 (源类型ID <= 0) { 返回 字符串复制(回退文本); }
    返回 字符串复制(驻留文本(源类型ID));
}

// ==================== 869（#234 切片 v2 侧残余面补齐）====================
// 立法背景：001 §8.6 / 234（2026-10-06 用户批准甲案）「基类值形态编译期拒绝
//   （防切片）——值拷贝会截掉派生类字段（C++ 经典事故源），专用诊断提示改用
//   基类指针/引用」。宿主 reportSliceReject（semantic_sig.cpp）执法面（869 收口
//   后）=声明初始化/赋值/返回/数组元素四面；v2 侧 801/617 只落地声明初始化
//   标识符/转移形态——构造调用（`形状 s = 方(1);`）、赋值面（`s = a;`）、
//   返回面（`返回 a;`）、实参面（`取形状(a)`）、数组初始化列表形态原放行
//   （且 768 位拷贝回退通道按基类大小截断=切片事故本体·869 探针矩阵实录）。
//   本族=确认缝合：三函数供五面消费（声明/赋值/返回面调 检查切片拒绝234；
//   实参面调 是切片形态234 报「未找到匹配的函数」对齐宿主决议失败文案），
//   专用诊断文案逐字对齐宿主 reportSliceReject（617 既有文案原样）。

// 切片形态判定（五面共用·宿主 reportSliceReject 判定链同构）：源类型ID=派生
//   类值 且 目标类型ID=基类值 → 真。排除面（宿主 isPointer/isReference/
//   isInterfaceType 前置同构）：指针 '*'/引用 '&' 目标=同地址语义零拷贝
//   （001 §8.6 合法通道·616 正测零误伤）——经用户类表 ID 判定天然排除
//   （指针/引用形态 ID 非注册类名，是用户类_ID 落假·与宿主前置排除等价）；
//   同类（源==目标）非切片=768 位拷贝合法面。
//   结构=命名布尔正向判定（882 三红门禁：比较式归入命名布尔·条件位全布尔名·
//   末尾裸返回非 miss 判定形态——852 赋值位先例同款）。
函数 是切片形态234(整64 源类型ID, 整64 目标类型ID) -> 布尔 {
    布尔 目标类形234 = 是用户类_ID(目标类型ID);
    整64 源类234 = 剥引用取用户类741(源类型ID);
    布尔 源类形234 = 源类234 > 0;
    布尔 异类234 = 源类234 != 目标类型ID;
    布尔 切片234 = 假;
    如果 (目标类形234 && 源类形234 && 异类234) {
        切片234 = 是否派生自(源类234, 目标类型ID);
    }
    返回 切片234;
}

// 切片拒绝专用诊断（声明初始化/赋值/返回/数组元素四面共用）：形态成立即报
//   专用消息（文案逐字对齐宿主 reportSliceReject）。
函数 检查切片拒绝234(整64 源类型ID, 整64 目标类型ID, 向量<字符串>& 诊断) -> 空类型 {
    布尔 切片234 = 是切片形态234(源类型ID, 目标类型ID);
    如果 (切片234) {
        整64 源类234 = 剥引用取用户类741(源类型ID);
        字符串 目标文本234 = 字符串复制(驻留文本(目标类型ID));
        表诊断(诊断, "[错误] 禁止类切片：'" + 字符串复制(驻留文本(源类234)) +
                      "' 不能隐式转换为基类值 '" + 目标文本234 +
                      "'——值形态会截掉派生类字段（立法 234·防切片）；请用基类指针 '" +
                      目标文本234 + "*' 或引用同地址持有");
    }
}

// 869（#234 指针派生链面·探针15 实锤）：指针形态派生链判定——源/目标均
//   单层指针（尾 '*'）且基名间 是否派生自 → 真。派生类指针 → 基类指针=
//   同地址上行转换合法（001 §8.6「派生类对象/指针可隐式转换为其基类链上
//   任一祖先类的指针或引用形态」；宿主 canConvertType 指针段 pointeeOf
//   逐层判定同构——多级指针基名含星非用户类=不放行，宿主 isClassType
//   对「形状*」同判假=零分叉）。消费=实参面 652 取址判定 ③ 分支
//   （&a〔方*〕传 形状* 形参原逐字比较拒=v2 过拒分叉）。
//   结构=命名布尔正向判定（882 门禁同 是切片形态234）。
函数 指针派生链合法869(字符串 源文本869, 字符串 目标文本869) -> 布尔 {
    整64 源长869 = 字符串长度(源文本869);
    整64 标长869 = 字符串长度(目标文本869);
    布尔 双非空869 = 源长869 > 0 && 标长869 > 0;
    布尔 尾星869 = 假;
    如果 (双非空869) {
        整64 源尾869 = 整64(源文本869[整32(源长869 - 1)]) & 255;
        整64 标尾869 = 整64(目标文本869[整32(标长869 - 1)]) & 255;
        尾星869 = 源尾869 == 42 && 标尾869 == 42;
    }
    布尔 派生链869 = 假;
    如果 (尾星869) {
        字符串 源基869 = 字符串子串(源文本869, 0, 整32(源长869 - 1));
        字符串 标基869 = 字符串子串(目标文本869, 0, 整32(标长869 - 1));
        布尔 同基869 = 字符串比较(源基869, 标基869);
        如果 (同基869) {
            派生链869 = 真;   // 同型指针（逐字比较已放行·冗余保险）
        }
        布尔 双类869 = 是用户类(源基869) && 是用户类(标基869);
        布尔 异基双类869 = !同基869 && 双类869;
        如果 (异基双类869) {
            派生链869 = 是否派生自(驻留(源基869), 驻留(标基869));
        }
    }
    返回 派生链869;
}

// 类源类型推导（切片判定源面·声明/赋值/返回三面共用）：右值末节点 → 类型ID。
//   覆盖面=标识符（含引用变量读出·剥引用由 是切片形态234 承担）/转移(标识符)
//   （963 同构识别·附加==1=单实参）/构造调用（被调=用户类名·413/951「构造
//   调用返回类名自身」同源）/普通函数调用返回（调用源返回类型ID静默·772
//   单候选零副作用面）/方法调用返回（查类方法返回·实例基名剥回退·741 段
//   同款识别）。返回 -1=不可推导或非类形态（字面量/算术/成员/下标等——非类
//   右值不可能构成切片）。与 741 段推导的形态差：741 段为拷贝构造检查服务
//   （构造调用须排除——返回槽构造非拷贝·p11 实证），本函数为切片判定服务
//   （构造调用须纳入）——目的不同非复制疏漏（741 段注释互指）。
//   结构=命名布尔正向判定+结果变量收口（882 门禁同 是切片形态234；869 拆子
//   两辅助=嵌套 ≤3 层与函数单屏纪律·调用源上标识符869/调用源上成员869）。
函数 推导类源类型869(向量<节点> 池, 整32 源末索引,
                    向量<映射<整64, 符号>>& 符号表) -> 整64 {
    整64 结果869 = 0 - 1;
    布尔 索引有效869 = 源末索引 >= 0 && 源末索引 < 整32(池.大小());
    如果 (索引有效869) {
        节点 源末869 = 池.元素(源末索引);
        布尔 标识符形869 = 源末869.类型 == 节点_标识符;
        如果 (标识符形869) {
            可选<整64> 结果869查 = 表查找类型ID(符号表, 整64(源末869.文本));
            // miss 保持 -1（本函数「不可推导」契约·消费方 >0 判定同假）
            如果 (结果869查.有值) { 结果869 = 结果869查.值; }
        }
        布尔 调用形869 = 源末869.类型 == 节点_调用;
        布尔 调用索引869 = 整64(源末869.子起点) >= 0 &&
                          整64(源末869.子起点) < 整64(池.大小());
        布尔 调用可查869 = 调用形869 && 调用索引869;
        如果 (调用可查869) {
            节点 被调869 = 池.元素(整32(源末869.子起点));
            布尔 标识符被调869 = 被调869.类型 == 节点_标识符;
            如果 (标识符被调869) {
                结果869 = 调用源上标识符869(池, 源末869, 被调869, 符号表);
            }
            布尔 成员被调869 = 被调869.类型 == 节点_成员;
            如果 (成员被调869) {
                结果869 = 调用源上成员869(池, 被调869, 符号表);
            }
        }
    }
    返回 结果869;
}

// 869 子：被调=标识符 的调用源类型（转移/构造调用/普通函数调用返回三形态）
//   ——附加=实参个数（协议常量 节点_调用 约定）；转移=显式转移标记（963）。
函数 调用源上标识符869(向量<节点> 池, 节点 源末869, 节点 被调869,
                      向量<映射<整64, 符号>>& 符号表) -> 整64 {
    整64 被调名869 = 整64(被调869.文本);
    布尔 单实参869 = 源末869.附加 == 1;
    布尔 实参在池869 = 整64(源末869.子起点) + 1 < 整64(池.大小());
    布尔 是转移869 = 字符串比较(驻留文本(被调名869), "转移");
    布尔 转移形869 = 单实参869 && 实参在池869 && 是转移869;
    整64 结果869 = 0 - 1;
    如果 (转移形869) {
        节点 实参869 = 池.元素(整32(源末869.子起点) + 1);
        布尔 实参标识符869 = 实参869.类型 == 节点_标识符;
        如果 (实参标识符869) {
            可选<整64> 结果869查2 = 表查找类型ID(符号表, 整64(实参869.文本));
            // miss 保持 -1（本函数「不可推导」契约·消费方 >0 判定同假）
            如果 (结果869查2.有值) { 结果869 = 结果869查2.值; }
        }
    }
    布尔 构造形869 = !转移形869 && 是用户类_ID(被调名869);
    如果 (构造形869) {
        结果869 = 被调名869;   // 构造调用=类名自身（413/951 立法）
    }
    布尔 普通调用869 = !转移形869 && !构造形869;
    如果 (普通调用869) {
        结果869 = 调用源返回类型ID静默(池, 源末869, 符号表);   // 772 单候选面
    }
    返回 结果869;
}

// 869 子：被调=成员 的方法调用返回类型（对象=标识符：自身/变量查表类名直查
//   回退——741 段同款识别）。
函数 调用源上成员869(向量<节点> 池, 节点 被调869,
                    向量<映射<整64, 符号>>& 符号表) -> 整64 {
    整64 结果869 = 0 - 1;
    布尔 有对象869 = 被调869.子起点 > 0;
    如果 (有对象869) {
        节点 调对象869 = 池.元素(整32(被调869.子起点));
        布尔 对象标识符869 = 调对象869.类型 == 节点_标识符;
        如果 (对象标识符869) {
            整64 对象869 = 0 - 1;
            字符串 对象名869 = 字符串复制(驻留文本(整64(调对象869.文本)));
            布尔 自身869 = 字符串比较(对象名869, "自身");
            如果 (自身869) {
                对象869 = 取当前检查类ID();
            }
            布尔 变量形869 = !自身869;
            如果 (变量形869) {
                可选<整64> 对象869查 = 表查找类型ID(符号表, 整64(调对象869.文本));
                // miss 保持 -1（本函数「不可推导」契约）·原 <=0 判定含 0 当未知
                如果 (对象869查.有值) { 对象869 = 对象869查.值; }
                布尔 名查miss869 = !对象869查.有值 || 对象869 == 0;
                如果 (名查miss869) {
                    对象869 = 整64(调对象869.文本);   // 名 miss 回退类名直查
                }
            }
            结果869 = 方法返回沿链869(对象869, 整64(被调869.文本));
        }
    }
    返回 结果869;
}

// 869 子：方法返回类型沿链（查类方法返回 + 泛型实例基名剥回退）。
函数 方法返回沿链869(整64 对象869, 整64 方法名869) -> 整64 {
    整64 结果869 = 0 - 1;
    布尔 对象有效869 = 对象869 > 0;
    如果 (对象有效869) {
        结果869 = 查类方法返回(对象869, 方法名869);
        布尔 无返回869 = 结果869 <= 0;
        如果 (无返回869) {
            字符串 实例文869 = 字符串复制(驻留文本(对象869));
            字符串 基文869 = 剥实例基名(实例文869);
            布尔 有基文869 = !字符串比较(基文869, 实例文869);
            如果 (有基文869) {
                结果869 = 查类方法返回(驻留(基文869), 方法名869);
            }
        }
    }
    返回 结果869;
}
