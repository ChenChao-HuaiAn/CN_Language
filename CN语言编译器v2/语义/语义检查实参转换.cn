// CN 自举编译器 v2 · 语义检查实参转换（#1591 拆分·先拆再加）
// 职责：调用实参转换判定族——自 语义检查实参.cn 机械搬移（函数体逐字保留·
//   零语义变化·原文件 998 行贴 1000 硬红线）：标量目标分类 + 字面量/变量/
//   表达式实参转换非法判定 + 数值源实参矩阵 + 诊断源类型文本。
//   本轮 #1591 内置构造器载荷兼容检查复用 数值源实参矩阵非法（宿主
//   types::canConvert 标量矩阵同构）——先拆再加纪律落点。
//   实参转换目标类型全显式分派族（非标量目标实参判定/实参源文本推导/
//   指针目标实参判定/值形态实参判定）：非标量目标（类/结构体/容器/接口/
//   指针/引用/泛型）原「白名单外一律放行」默认通道删除（用户令 2026-11-02
//   「必须删掉默认通道，不认识的分支必须显式报错」·#1854+#1966 立法）——
//   改目标类型全显式分派（宿主 conversionLevel/canConvertType 全矩阵逐条
//   同构），判拒文案由消费点自报（直调面=「未找到匹配的函数」对齐宿主决议
//   失败面；方法面=「无法将」对齐宿主逐参面）；目标形态未识别=编译期显式
//   错误（禁「查不到当拒/当放」两方向兜底）。
// 消费=语义检查实参（检查调用实参转换）、语义检查容器方法/语义检查实例方法
//   （实参转换非法/实参源类型文本/非标量目标实参判定）、语义检查构造器
//   （数值源实参矩阵非法）。
// 导入=容器::向量/映射集合（形态）+ 语法（节点_*）+ IR（枚举/指针/转换判定）
//   + 协议常量（驻留/驻留文本）。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/查调用实参末位（解析表达式中）
导入 IR;         // 查函数签名个数/查函数签名参数串/是枚举名/转换类型位宽等价面
导入 协议常量;   // 驻留/驻留文本（中立层）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 目标类型文本是否本检查标量判定面（宿主 canConvert 标量矩阵白名单）——
//   仅分类判定用：标量目标走 既有标量矩阵通道；白名单外（容器/类/结构体/
//   接口/指针/引用/枚举名/泛型名等）由 非标量目标实参判定 全显式分派承担
//   （默认通道已删·不再「白名单外一律放行」）
函数 是实参标量目标文本(字符串 目标文本) -> 布尔 {
    如果 (是转换整数族文本(目标文本) || 是转换浮点族文本(目标文本)) { 返回 真; }
    返回 字符串比较(目标文本, "布尔") || 字符串比较(目标文本, "字符") ||
           字符串比较(目标文本, "字符串");
}

// 字符串含后缀/结构字节判定（& * [ < > 任一——引用/指针/数组/泛型截断段
//   形态非纯标量名，放行防误伤）
函数 文本含非标量字节(字符串 文本) -> 布尔 {
    整64 i = 0;
    当 (i < 字符串长度(文本)) {
        整64 字节 = 整64(文本[整32(i)]) & 255;
        如果 (字节 == 38 || 字节 == 42 || 字节 == 91 || 字节 == 60 || 字节 == 62) { 返回 真; }
        i++;
    }
    返回 假;
}

// 整数字面量末端→窄整数目标回绕豁免（宿主 canConvertArgNarrow 语义·
//   285·001 §3.7a：仅整8/整16/正8/正16 目标放行）
函数 是窄回绕豁免目标(字符串 目标文本) -> 布尔 {
    返回 字符串比较(目标文本, "整8") || 字符串比较(目标文本, "整16") ||
           字符串比较(目标文本, "正8") || 字符串比较(目标文本, "正16");
}

// 字面量实参转换非法判定（宿主 canConvertWithLiteral+canConvertArgNarrow
//   口径；源末=整/负号/浮/布尔/字符串/字符字面量族节点）
函数 字面量实参转换非法(向量<节点> 池, 整32 源末索引, 节点 源末,
                       字符串 目标文本, 整64 目标类型ID,
                       向量<映射<整64, 符号>>& 符号表) -> 布尔 {
    布尔 目标整数 = 是转换整数族文本(目标文本); 布尔 目标浮点 = 是转换浮点族文本(目标文本);
    如果 (源末.类型 == 节点_整数字面量 || 源末.类型 == 节点_负号) {
        // #1773：空指针字面量 无（整数字面量 文本=0+附加==1·153-a）→ 标量
        //   形参一律拒（001 §3.7 闭集：空类型* → 整数/浮点/字符/布尔/字符串
        //   均无隐式转换规则；宿主决议失败「未找到匹配的函数」）。修前 失真
        //   为 0 整32 走字面量豁免偷放行（吃(无) 当 0 传=静默错值分叉）。
        //   指针/可选形参不进本函数（是实参标量目标文本 已分流=合法面零误伤）。
        如果 (源末.类型 == 节点_整数字面量 && 源末.附加 == 1) { 返回 真; }
        // 590（2026-10-16）：入口形态判定补多重负号链（负号链至字面量）——
        //   链形态与单层字面量形态同走值域通道（隐式转换合法 已链化；
        //   宿主解析期负号折叠等价）；修前链落下方 740 推导（-1 或常量级
        //   类型）与宿主折叠形态判定错位。
        如果 (是整数字面量末端(池, 源末索引) || 负号链至字面量(池, 源末索引)) {
            如果 (目标整数) {
                // 宿主 canConvertType 侧（同符号宽化/同型）由隐式转换合法 承担；
                //   字面量值域豁免（565 入域）同通道；域外窄目标落 285 回绕豁免
                如果 (隐式转换合法(池, 源末索引, 目标类型ID, 符号表)) { 返回 假; }
                返回 !是窄回绕豁免目标(目标文本);
            }
            如果 (目标浮点 || 字符串比较(目标文本, "字符")) { 返回 假; }   // 整→浮/字符 放行
            返回 真;   // 布尔/字符串目标：宿主拒（canConvert 整数→布尔/字符串 假）
        }
        // 740：负号+非字面量（-整32变量）→推导负号结果类型（可靠面·转换推导
        //   族 740 新增负号分支）后按数值矩阵判定——修前「检不出放行」=实参位
        //   负号表达式静默截断分叉（宿主 -乙32 实参拒·v2 放行·U 探针族实录）
        可选<整64> 负源740查 = 推导源类型ID静默(池, 源末索引, 符号表);
        整64 负源740 = 0 - 1;
        如果 (负源740查.有值) { 负源740 = 负源740查.值; }
        如果 (负源740 <= 0) { 返回 假; }
        返回 数值源实参矩阵非法(字符串复制(驻留文本(负源740)), 目标文本);
    }
    如果 (源末.类型 == 节点_浮点字面量) {
        如果 (目标浮点) { 返回 !隐式转换合法(池, 源末索引, 目标类型ID, 符号表); }
        返回 真;   // 浮→整/字符/布尔/字符串：宿主拒
    }
    如果 (源末.类型 == 节点_布尔字面量) { 返回 !字符串比较(目标文本, "布尔"); }
    如果 (源末.类型 == 节点_字符串字面量) { 返回 !字符串比较(目标文本, "字符串"); }
    如果 (源末.类型 == 节点_字符字面量) {
        // 字符→整数/字符放行（字符↔整数互通）；字符→浮点宿主拒（h1 实测面）
        返回 !(目标整数 || 字符串比较(目标文本, "字符"));
    }
    返回 假;   // 非字面量族防御（调用方已分类）
}

// 变量实参转换非法判定（宿主 canConvert 标量矩阵同构·标识符纯标量面）
函数 变量实参转换非法(向量<节点> 池, 整32 源末索引, 节点 源末,
                     字符串 目标文本, 整64 目标类型ID,
                     向量<映射<整64, 符号>>& 符号表) -> 布尔 {
    整64 源名 = 整64(源末.文本);
    可选<整64> 指针所指查 = 查语义指针变量(源名);
    如果 (指针所指查.有值) {
        // 指针变量源（查语义指针变量 返回所指元素类型名）：字符*↔字符串
        //   宿主 canConvert 明文互通放行（h7 同面）；其余指针源→标量目标
        //   宿主 canConvert 指针段无规则全拒（修前「诚实边界放行」=静默
        //   分叉·实参转换目标全显式分派源侧收口）
        布尔 指源字符针 = 字符串比较(字符串复制(驻留文本(指针所指查.值)), "字符");
        返回 !(指源字符针 && 字符串比较(目标文本, "字符串"));
    }
    可选<整64> 源种类查 = 表查找种类(符号表, 源名);
    如果 (源种类查.有值 && 源种类查.值 == 符号_常量) { 返回 假; }   // 常量实参放行（宽松口径）
    整64 源类型ID = 0;
    可选<整64> 源类型ID查 = 表查找类型ID(符号表, 源名);
    如果 (源类型ID查.有值) { 源类型ID = 源类型ID查.值; }
    // 原 <=0 判定：miss 与登记值 0 同走「不可判」放行（880 批5 显式保留）
    如果 (!源类型ID查.有值 || 源类型ID == 0) { 返回 假; }
    如果 (是泛型参数名(源类型ID)) { 返回 假; }   // 模板态 T/K/V 放行（宿主模板态同款）
    字符串 源文本 = 字符串复制(驻留文本(源类型ID));
    如果 (字符串长度(源文本) == 0) { 返回 假; }
    如果 (字符串比较(源文本, "未知") || 字符串比较(源文本, "空类型")) { 返回 假; }
    // 字符* 源（引用/借用视图）：宿主 canConvert 字符*↔字符串 明文互通——
    //   字符串目标放行；其余标量目标拒（h7 探针 字符*→整32 宿主拒）
    如果 (字符串比较(源文本, "字符*")) { 返回 !字符串比较(目标文本, "字符串"); }
    // 引用变量源剥 &（宿主 canonicalType 剥引用同构——整32& →整32 形参=
    //   同型放行面；剥后仍非标量（猫 等）落矩阵末行拒=宿主同拒）
    整64 源长尾 = 字符串长度(源文本);
    布尔 源引用尾v = 假;
    // 静默豁免闭集穷举: 文本长度守卫（空文本跳过剥尾·条件假落下一显式分支无默认值）
    如果 (源长尾 > 0 &&
         ((整64(源文本[整32(源长尾 - 1)]) & 255) == 38)) {
        源引用尾v = 真;
        源文本 = 字符串子串(源文本, 0, 整32(源长尾 - 1));
    }
    // 指针/数组/容器$/模板文本< 等非标量源→标量目标：宿主 canConvert 无规则
    //   全拒（修前「文本含非标量字节放行」=静默分叉·目标全显式分派源侧收口；
    //   引用尾已剥不再入此分支——剥后形态交下方矩阵按宿主口径判定）
    // 静默豁免闭集穷举: 非标量源→标量目标=宿主 canConvert 无规则闭集显式判拒
    //   （消费点报诊断显形·非静默默认值）
    如果 (!源引用尾v && 文本含非标量字节(源文本)) { 返回 真; }
    如果 (字符串比较(源文本, 目标文本)) { 返回 假; }   // 同型
    布尔 目标整数 = 是转换整数族文本(目标文本); 布尔 目标浮点 = 是转换浮点族文本(目标文本);
    // 枚举源：宿主 canConvert 枚举→整数族放行（C 风格整32 常量源）；其余标量目标拒
    如果 (是枚举名(源类型ID)) { 返回 !目标整数; }
    布尔 源整数 = 是转换整数族文本(源文本); 布尔 源浮点 = 是转换浮点族文本(源文本);
    如果 (源整数 && 目标整数) {
        // 55-c 方案A：跨符号（同秩/异秩）一律拒绝隐式——混合符号静默改值语义
        如果 (是无符号类型ID(驻留(源文本)) != 是无符号类型ID(驻留(目标文本))) { 返回 真; }
        // 方案C（2026-08-14）：128→64 同符号窄化特例放行（宿主 canConvert 明文）
        如果 ((字符串比较(源文本, "整128") || 字符串比较(源文本, "正128")) &&
            (字符串比较(目标文本, "整64") || 字符串比较(目标文本, "正64"))) {
            返回 假;
        }
        // 严格宽化放行（宿主 rankFrom < rankTo）；同宽/窄化拒
        返回 转换类型位宽(源文本) >= 转换类型位宽(目标文本);
    }
    如果 (源整数 && (目标浮点 || 字符串比较(目标文本, "字符"))) { 返回 假; }   // 整→浮/字符放行
    如果 (源浮点 && 目标浮点) {
        如果 (字符串比较(源文本, "浮32") && 字符串比较(目标文本, "浮64")) { 返回 假; }
        返回 真;   // 浮64→浮32 窄化：宿主拒
    }
    如果 (字符串比较(源文本, "字符")) {
        // 字符源：→整数/字符放行；→浮点/布尔/字符串拒（宿主字符族规则）
        返回 !(目标整数 || 字符串比较(目标文本, "字符"));
    }
    // 布尔/字符串/类/结构体/容器/函数指针等其余源 → 标量目标：宿主 canConvert 假
    返回 真;
}

// 单实参转换非法判定（字面量族/标识符变量族两分类·其余节点=推导不可靠面放行）
函数 实参转换非法(向量<节点> 池, 整32 源末索引, 整64 目标类型ID,
                  向量<映射<整64, 符号>>& 符号表) -> 布尔 {
    如果 (目标类型ID <= 0) { 返回 假; }
    字符串 目标文本 = 字符串复制(驻留文本(目标类型ID));
    // 非标量目标不在本函数判定面（消费点经 是实参标量目标文本 分流给
    //   非标量目标实参判定 全显式分派——原「白名单外一律放行」默认通道已删；
    //   本函数保留标量目标面，闸行为幂等防线·消费点双保险）
    如果 (!是实参标量目标文本(目标文本)) { 返回 假; }
    如果 (源末索引 < 0 || 源末索引 >= 整32(池.大小())) { 返回 假; }
    节点 源末 = 池.元素(源末索引);
    // 919-final（2026-10-18 用户裁决「字面量单点判域·Rust 口径」）：区间
    //   子树扫描先于形态分派——含变量二元/三元/嵌套等一切实参形态内任一
    //   整数字面量超形参目标域 → 非法拒（单点判域；修前二元分支落 740
    //   数值矩阵的 128→64 特例面放行/三元落诚实边界放行=双侧分叉；宿主
    //   canConvertWithLiteral 单点扫描已拒·双侧对齐）。
    如果 (是转换整数族文本(目标文本) &&
        区间含超域字面量919(池, 源末索引, 目标文本)) { 返回 真; }
    如果 (源末.类型 == 节点_整数字面量 || 源末.类型 == 节点_负号 ||
        源末.类型 == 节点_浮点字面量 || 源末.类型 == 节点_布尔字面量 ||
        源末.类型 == 节点_字符串字面量 || 源末.类型 == 节点_字符字面量) {
        返回 字面量实参转换非法(池, 源末索引, 源末, 目标文本, 目标类型ID, 符号表);
    }
    如果 (源末.类型 == 节点_标识符) { 返回 变量实参转换非法(池, 源末索引, 源末, 目标文本, 目标类型ID, 符号表); }
    如果 (源末.类型 == 节点_二元运算) {
        // 740：算术/位二元表达式实参（`吃8(乙32 + 丙32)`）——推导二元结果
        //   类型（转换推导族 740 新增·可靠面）后按数值矩阵判定。修前「推导
        //   不可靠面放行」=实参位静默截断分叉（宿主拒「未找到匹配的函数」·
        //   v2 放行产码·M 探针实录）；推导不出（调用/成员操作数）=既有诚实
        //   边界放行不变。
        可选<整64> 表达源740查 = 推导源类型ID静默(池, 源末索引, 符号表);
        整64 表达源740 = 0 - 1;
        如果 (表达源740查.有值) { 表达源740 = 表达源740查.值; }
        如果 (表达源740 <= 0) { 返回 假; }
        返回 数值源实参矩阵非法(字符串复制(驻留文本(表达源740)), 目标文本);
    }
    返回 假;   // 成员/调用/下标/取地址/三元等=推导不可靠面放行（诚实边界）
}

// 740：数值源实参标量矩阵（二元/负号表达式推导源专用·宿主 canConvert 数值
//   矩阵同构）——同型/同符号宽化/128→64 特例放行；窄化/窄浮/浮→整/跨符号拒。
函数 数值源实参矩阵非法(字符串 源文本, 字符串 目标文本) -> 布尔 {
    如果 (字符串比较(源文本, 目标文本)) { 返回 假; }   // 同型
    布尔 源整数740 = 是转换整数族文本(源文本); 布尔 目标整数740 = 是转换整数族文本(目标文本);
    布尔 源浮点740 = 是转换浮点族文本(源文本); 布尔 目标浮点740 = 是转换浮点族文本(目标文本);
    如果 (源整数740 && 目标整数740) {
        // 55-c 方案A：跨符号一律拒绝（混合符号面同构）
        如果 (是无符号类型ID(驻留(源文本)) != 是无符号类型ID(驻留(目标文本))) { 返回 真; }
        // 方案C（2026-08-14）：128→64 同符号窄化特例放行
        如果 ((字符串比较(源文本, "整128") || 字符串比较(源文本, "正128")) &&
            (字符串比较(目标文本, "整64") || 字符串比较(目标文本, "正64"))) {
            返回 假;
        }
        // 严格宽化放行；同宽/窄化拒
        返回 转换类型位宽(源文本) >= 转换类型位宽(目标文本);
    }
    如果 (源整数740 && (目标浮点740 || 字符串比较(目标文本, "字符"))) { 返回 假; }
    如果 (源浮点740 && 目标浮点740) {
        如果 (字符串比较(源文本, "浮32") && 字符串比较(目标文本, "浮64")) { 返回 假; }
        返回 真;   // 浮64→浮32 窄化：宿主拒
    }
    返回 真;   // 浮→整/布尔/字符串等：宿主拒
}

// 诊断用源类型文本（标识符=表查找类型；字面量=推导源类型文本 565 同款；
//   不可推导回退形参文本占位）
函数 实参源类型文本(向量<节点> 池, 整32 源末索引,
                  向量<映射<整64, 符号>>& 符号表, 字符串 回退) -> 字符串 {
    如果 (源末索引 >= 0 && 源末索引 < 整32(池.大小())) {
        节点 源末 = 池.元素(源末索引);
        如果 (源末.类型 == 节点_标识符) {
            整64 源类型ID = 0; 可选<整64> 源类型ID查 = 表查找类型ID(符号表, 整64(源末.文本));
            // miss 保持 0（下方 >0 判定与原 -1 哨兵同假·880 批5）
            如果 (源类型ID查.有值) { 源类型ID = 源类型ID查.值; }
            如果 (源类型ID > 0) { 返回 字符串复制(驻留文本(源类型ID)); }
        }
    }
    返回 推导源类型文本(池, 源末索引, 符号表, 回退);
}

// ==================== 实参转换目标类型全显式分派族 ====================
// 立法（用户令 2026-11-02·「必须删掉默认通道，不认识的分支必须显式报错！
//   指针/引用/容器/接口/泛型——一并实施」）：原 是实参标量目标文本 白名单外
//   一律放行（诚实边界）=未判定静默放行通道，删除。非标量目标改全显式分派：
//   ①泛型形参名目标=模板态放行（宿主 conversionLevel 模板态同款）
//   ②指针目标=同基/派生→基 upcast（指针派生链合法 单点）/空类型* 双向/
//     字符串·字符* 互通/数组退化（宿主 canConvertType 指针段逐条同构）
//   ③引用目标=剥 & 后值形态判定（宿主 conversionLevel A-1 剥 & 同构）
//   ④值形态=同型/归一同型（归一化类型文本 单点）+类→基类值放行（234
//     值形态=切片·上层 检查切片拒绝 专用诊断专报·本层放行防双报）+其余委托
//     载荷可转换（构造器载荷面已实现宿主 canConvertType 值矩阵同构——
//     类→接口/结构体/枚举/容器归一/结果可选递归/标量矩阵·单点复用）
//   ⑤方法值/函数指针族=专用通道承担（806 位置守卫/1075 转换文案/943 立法
//     单点）——方法值源显式豁免不越权（防 806 专用文案双报）
//   拒文案由消费点自报：直调面=「未找到匹配的函数 'X'（参数个数或类型不
//   匹配）」（对齐宿主 resolveOverload 决议失败面·869 同构）；方法面=「无法
//   将」逐参文案（对齐宿主 checkInstanceMethodCall 面·1330/1339 锁面同文）。
//   形态未识别（穷举形态谓词全不命中）=编译期显式错误「实参转换判定未覆盖
//   目标类型」——禁「查不到当拒/当放」两方向兜底（同令第 3 条）。

// 实参文本尾字节判定（星=指针·和=引用）——形态判定专用（闭集两值·
//   非业务数值区间·单边开区间禁令不适用）
函数 实参文本尾星(字符串 文本) -> 布尔 {
    整64 长x = 字符串长度(文本);
    // 静默豁免闭集穷举: 空文本无尾字节=闭集否定（返回假·非默认值继续）
    如果 (长x <= 0) { 返回 假; }
    返回 (整64(文本[整32(长x - 1)]) & 255) == 42;
}

函数 实参文本尾引(字符串 文本) -> 布尔 {
    整64 长y = 字符串长度(文本);
    // 静默豁免闭集穷举: 空文本无尾字节=闭集否定（返回假·非默认值继续）
    如果 (长y <= 0) { 返回 假; }
    返回 (整64(文本[整32(长y - 1)]) & 255) == 38;
}

// 实参文本剥尾一字节（& 或 *——引用/指针形态剥壳）
函数 实参文本剥尾(字符串 文本) -> 字符串 {
    整64 长b = 字符串长度(文本);
    // 静默豁免闭集穷举: 空文本无可剥字节=原样返回契约（非 miss 默认）
    如果 (长b <= 0) { 返回 字符串复制(文本); }
    返回 字符串复制(字符串子串(文本, 0, 整32(长b - 1)));
}

// 实参源文本推导（空串=不可判·消费方可见契约值非哨兵）：字符串字面量=
//   字符*（宿主字符串字面量类型口径）/布尔·字符字面量恒定/构造调用=类名
//   （413/951 立法）/标识符=符号表类型ID（指针变量=所指+尾*）/其余=推导源
//   类型ID静默 可靠面+推导类源类型（调用返回类对象·切片判定源面单点复用）。
函数 实参源文本推导(向量<节点> 池, 整32 源末索引, 节点 源末,
                  向量<映射<整64, 符号>>& 符号表) -> 字符串 {
    如果 (源末.类型 == 节点_字符串字面量) { 返回 "字符*"; }
    如果 (源末.类型 == 节点_布尔字面量) { 返回 "布尔"; }
    如果 (源末.类型 == 节点_字符字面量) { 返回 "字符"; }
    // 静默豁免闭集穷举: 调用节点子起点守卫（越界=非构造形态落后续推导分支）
    如果 (源末.类型 == 节点_调用 && 源末.子起点 > 0 &&
         整64(源末.子起点) < 整64(池.大小())) {
        节点 被调推 = 池.元素(整32(源末.子起点));
        如果 (被调推.类型 == 节点_标识符 && 是用户类_ID(整64(被调推.文本))) {
            返回 字符串复制(驻留文本(整64(被调推.文本)));
        }
    }
    如果 (源末.类型 == 节点_标识符) {
        整64 名推 = 整64(源末.文本);
        可选<整64> 所指查推 = 查语义指针变量(名推);
        如果 (所指查推.有值) {
            返回 字符串复制(驻留文本(所指查推.值)) + "*";
        }
        // 函数名实参（宿主 collectCallArgTypes 同构：函数名实参类型=C 风格
        //   fnptr 签名文本「返型(*)(参们)」——772 惯例 符号_函数 条目附加=
        //   返回类型ID，须扫池取签名构造全形；1075 调用形参是方法值 同款扫池）
        可选<整64> 种类函查 = 表查找种类(符号表, 名推);
        如果 (种类函查.有值 && 种类函查.值 == 符号_函数) {
            返回 函数名fnptr文本(池, 字符串复制(驻留文本(名推)));
        }
        可选<整64> 源查推 = 表查找类型ID(符号表, 名推);
        // 静默豁免闭集穷举: 符号表 miss=源不可判契约（空串返回·消费方显式放行面）
        如果 (源查推.有值 && 源查推.值 > 0) {
            返回 字符串复制(驻留文本(源查推.值));
        }
        返回 "";
    }
    可选<整64> 静默查推 = 推导源类型ID静默(池, 源末索引, 符号表);
    // 静默豁免闭集穷举: 推导 miss 落下方类源推导（多级显式回退链·非静默默认）
    如果 (静默查推.有值 && 静默查推.值 > 0) {
        返回 字符串复制(驻留文本(静默查推.值));
    }
    整64 类源推 = 推导类源类型(池, 源末索引, 符号表);
    // 静默豁免闭集穷举: 类源推导 miss=源不可判契约（空串返回·消费方显式放行面）
    如果 (类源推 > 0) { 返回 字符串复制(驻留文本(类源推)); }
    返回 "";
}

// 函数名→C 风格 fnptr 签名文本（宿主 collectCallArgTypes 同构）：扫池定位
//   节点_函数（1075 调用形参是方法值 同款扫池）→参数串+返回类型（查函数返回
//   类型·签名键同源）构造「返型(*)(参们)」——与形参段文本同形态同串比较=
//   宿主 canConvertType isFuncPtr 精确同串段对齐（异签名=拒·宿主同拒）。
//   miss（无此函数/返回未登记）=空串（源不可判契约·消费方显式放行面）。
函数 函数名fnptr文本(向量<节点> 池, 字符串 名文) -> 字符串 {
    整64 扫函 = 0;
    当 (扫函 < 整64(池.大小())) {
        节点 候函 = 池.元素(整32(扫函));
        如果 (候函.类型 == 节点_函数 &&
             字符串比较(字符串复制(驻留文本(整64(候函.文本))), 名文)) {
            字符串 参串函 = 函数参数串(池, 整32(扫函));
            可选<整64> 返查函 = 查函数返回类型(
                函数签名键(驻留(名文), 参串函));
            // 静默豁免闭集穷举: 返回类型 miss=构造失败落空串不可判契约（消费方显式放行面）
            如果 (返查函.有值 && 返查函.值 > 0) {
                返回 字符串复制(驻留文本(返查函.值)) + "(*" + 名文 +
                       ")(" + 参串函 + ")";
            }
            返回 "";
        }
        扫函++;
    }
    返回 "";
}

// 是C风格函数指针文本（宿主 isFuncPtr 形态同构）：含「)(」序列（返型(*名)
//   (参们) 的辨识字节对 41+40）——与「函数指针<」模板形态两态并立。
函数 是C风格函数指针文本(字符串 文本) -> 布尔 {
    整64 长c = 字符串长度(文本);
    // 静默豁免闭集穷举: 短文本无「)(」序列=闭集否定（形态谓词·非默认值继续）
    如果 (长c < 2) { 返回 假; }
    整64 i行 = 0;
    当 (i行 < 长c - 1) {
        如果 ((整64(文本[整32(i行)]) & 255) == 41 &&
             (整64(文本[整32(i行 + 1)]) & 255) == 40) { 返回 真; }
        i行++;
    }
    返回 假;
}

// 指针目标实参判定（真=拒·假=放行；宿主 canConvertType 指针段逐条同构）：
//   同串放行（宿主 from==to 早退）；空类型* 双向；字符串·字符*→字符* 互通；
//   派生链 upcast（指针派生链合法 单点）；数组退化同元素；其余拒。
函数 指针目标实参判定(字符串 源文本, 字符串 目标文本) -> 布尔 {
    如果 (字符串比较(源文本, 目标文本)) { 返回 假; }
    如果 (字符串比较(源文本, "空类型*")) { 返回 假; }
    如果 (字符串比较(目标文本, "空类型*")) { 返回 !实参文本尾星(源文本); }
    如果 ((字符串比较(源文本, "字符串") || 字符串比较(源文本, "字符*")) &&
         字符串比较(目标文本, "字符*")) { 返回 假; }
    如果 (指针派生链合法(源文本, 目标文本)) { 返回 假; }
    // 实现类（值或指针）→接口指针形参（宿主 canConvertType P3-19 指针形态：
    //   toIface=pointeeOf(to) 是接口·fromBase=isPointer(from)?pointeeOf(from):
    //   from 实现该接口→放行）
    字符串 源基接 = 源文本;
    如果 (实参文本尾星(源文本)) { 源基接 = 实参文本剥尾(源文本); }
    如果 (是用户类(源基接) && 是接口名(实参文本剥尾(目标文本)) &&
         类实现接口沿链(驻留(源基接),
                      驻留(实参文本剥尾(目标文本)))) { 返回 假; }
    // 派生类值→基类指针形参（宿主 canConvertType 234 段：fromBase=值源本体
    //   直接 isDerivedFrom 放行——616 实锚面·值→指针槽=编译器取地址语义）
    如果 (!实参文本尾星(源文本) && 是用户类(源文本)) {
        字符串 目标基值 = 实参文本剥尾(目标文本);
        如果 (是用户类(目标基值) &&
             是否派生自(驻留(源文本), 驻留(目标基值))) { 返回 假; }
    }
    如果 (是数组类型文本(源文本)) {
        可选<字符串> 元素查指 = 数组元素文本(源文本);
        如果 (元素查指.有值) {
            字符串 目标基指 = 实参文本剥尾(目标文本);
            如果 (字符串比较(字符串复制(元素查指.值), 目标基指)) { 返回 假; }
        }
    }
    返回 真;   // 无关指针/标量源→指针/类值→指针：宿主 canConvertType 同拒
}

// 值形态形态识别（穷举谓词·宿主 canConvertType 分段域同构）：真=命中已知
//   形态域（标量/用户类/接口/结构体/枚举/容器·泛型实例$/模板文本</数组/
//   函数指针/方法值/空类型族/未知）。全不命中=未覆盖形态（消费方报显式错误）。
函数 是已知值形态文本(字符串 文本) -> 布尔 {
    如果 (是实参标量目标文本(文本)) { 返回 真; }
    如果 (字符串比较(文本, "空类型") || 字符串比较(文本, "未知")) { 返回 真; }
    整64 文本ID形 = 驻留(文本);
    如果 (是用户类_ID(文本ID形) || 是接口名ID(文本ID形) ||
         是枚举名(文本ID形)) { 返回 真; }
    如果 (查结构体类型(文本ID形).有值) { 返回 真; }
    如果 (是数组类型文本(文本)) { 返回 真; }
    如果 (文本前缀(文本, "函数指针<") || 文本前缀(文本, "方法值<")) {
        返回 真;
    }
    如果 (是C风格函数指针文本(文本)) { 返回 真; }   // C 风格 fnptr 形态域
    // 容器/泛型实例：$ 实例名或 < 模板文本字节面（归一化域——向量$整64/
    // 向量<整64> 两态）
    整64 i形 = 0;
    当 (i形 < 字符串长度(文本)) {
        整64 字节形 = 整64(文本[整32(i形)]) & 255;
        如果 (字节形 == 36 || 字节形 == 60) { 返回 真; }
        i形++;
    }
    如果 (文本含非标量字节(文本)) { 返回 真; }   // * [ > 字节面（指针基名/数组）
    返回 假;
}

// 值形态实参判定（真=拒·假=放行）——宿主 canConvertType 值矩阵同构：
//   同型/归一同型→放行；模板态 T/K/V→放行；未知/空类型源→放行（上游已诊断
//   恢复面·语义检查实参.cn 549 立法）；方法值族→放行（806/1075 专用通道
//   承担·防专用文案双报）；函数指针同串已命中异串拒（宿主 isFuncPtr 精确
//   同串）；类→基类值→放行（234 切片·上层检查切片拒绝专报）；其余委托
//   载荷可转换；两侧任一未识别形态=编译期显式错误+拒（禁兜底两方向）。
函数 值形态实参判定(字符串 源文本, 字符串 目标文本,
                  向量<字符串>& 诊断) -> 布尔 {
    // 剥引用尾（宿主 conversionLevel A-1 同构：按值/按引用双方剥 & 后比较
    //   形状——猫& 变量传 猫 值形参=同型放行面）
    如果 (实参文本尾引(源文本)) { 源文本 = 实参文本剥尾(源文本); }
    如果 (实参文本尾引(目标文本)) { 目标文本 = 实参文本剥尾(目标文本); }
    如果 (字符串比较(源文本, 目标文本)) { 返回 假; }
    如果 (字符串比较(归一化类型文本(源文本), 归一化类型文本(目标文本))) {
        返回 假;
    }
    如果 (是泛型参数名(驻留(源文本)) || 是泛型参数名(驻留(目标文本))) {
        返回 假;   // 模板态（宿主 conversionLevel 模板态同款）
    }
    // 静默豁免上游已诊断: 未知/空类型源=上游推导失败或无值调用产物（已报
    //   错误恢复面·549 立法）——放行非查表 miss 默认
    如果 (字符串比较(源文本, "未知") || 字符串比较(源文本, "空类型")) {
        返回 假;
    }
    // 方法值族=806 位置守卫/1075 转换文案单点（943 立法「单点归属·防双报」）
    //   ——异串方法值面随 031 通道收口，本判定不越权
    // 静默豁免待裁决: 方法值源放行=806/1075 专用文案单点承担中（031 面
    //   异串方法值→fnptr 文案分叉面在案·随 031 通道收口清偿）
    如果 (文本前缀(源文本, "方法值<") || 文本前缀(目标文本, "方法值<")) {
        返回 假;
    }
    如果 (文本前缀(源文本, "函数指针<") || 文本前缀(目标文本, "函数指针<")) {
        返回 真;   // 同串已上方命中；异签名/单侧=宿主 isFuncPtr 精确同串外全拒
    }
    // C 风格 fnptr 文本（宿主 isFuncPtr 同构形态·函数名实参经 实参源文本推导
    //   构造全形签名同串比较）：同串已上方命中；异签名/单侧=宿主同拒
    如果 (是C风格函数指针文本(源文本) || 是C风格函数指针文本(目标文本)) {
        返回 真;
    }
    // 数组名退化语义面（宿主 canConvertType 数组段镜像）：数组变量经语义指针
    //   表推导=「元素类型*」（数组名=首元素地址·V2.1），目标是该元素的数组
    //   文本（整32[4] 等·宿主源=完整数组文本同串放行的 v2 形态映射）
    // 静默豁免待裁决: 数组名→数组值形参=数组文本推导缺失面（数组变量登记
    //   为元素指针语义·真数组文本不可推导）——宿主同串放行面·随数组类型
    //   文本推导完善收口
    如果 (是数组类型文本(目标文本) && 实参文本尾星(源文本)) {
        可选<字符串> 元素查组 = 数组元素文本(目标文本);
        如果 (元素查组.有值) {
            字符串 源基组 = 实参文本剥尾(源文本);
            如果 (字符串比较(字符串复制(元素查组.值), 源基组)) { 返回 假; }
        }
    }
    // 234 值形态类→基类：上层 检查切片拒绝 专用诊断专报（1819）——本层放行
    //   防双报（宿主决议面同形态走 reportSliceReject 非通用文案）
    如果 (是用户类_ID(驻留(源文本)) && 是用户类_ID(驻留(目标文本)) &&
         是否派生自(驻留(源文本), 驻留(目标文本))) { 返回 假; }
    // 类→接口上转（宿主 canConvertType P3-19 同条：接口类型可持有任何实现类
    //   对象——413 赋值面同判定单点 类实现接口沿链）
    如果 (是用户类_ID(驻留(源文本)) && 是接口名ID(驻留(目标文本)) &&
         类实现接口沿链(驻留(源文本), 驻留(目标文本))) { 返回 假; }
    // 形态穷举：任一侧未识别=判域缺失（显式报错·禁当拒/当放）
    // 静默豁免闭集穷举: 穷举谓词全不命中=显式错误诊断+拦（用户令「不认识的
    //   分支必须显式报错」·判拒显形非静默）
    如果 (!是已知值形态文本(源文本) || !是已知值形态文本(目标文本)) {
        表诊断(诊断, "[错误] 实参转换判定未覆盖目标类型 '" + 目标文本 +
                      "'——待后续任务添加确定道路");
        返回 真;
    }
    // 其余全型委托宿主 canConvertType 值矩阵同构（1591 单点·末形态=拒）
    返回 !载荷可转换(源文本, 目标文本);
}

// 非标量目标实参判定（总分派·真=拒·假=放行）：①泛型形参名目标=模板态放行
//   ②源不可判=源侧诚实边界放行（显式契约值空串·549 立法——宿主类型全推导
//   渐进面）③指针目标分派 ④引用目标=剥 & 后值形态（宿主 conversionLevel
//   A-1 同构）⑤值形态分派。消费点按返回真自报拒文案（面各自对齐宿主）。
函数 非标量目标实参判定(向量<节点> 池, 整32 源末索引, 节点 源末,
                      字符串 目标文本, 整64 目标类型ID,
                      向量<映射<整64, 符号>>& 符号表,
                      向量<字符串>& 诊断) -> 布尔 {
    如果 (是泛型参数名(目标类型ID)) { 返回 假; }
    字符串 源文本非 = 实参源文本推导(池, 源末索引, 源末, 符号表);
    如果 (字符串长度(源文本非) == 0) { 返回 假; }   // 源侧诚实边界（549 立法）
    如果 (实参文本尾星(目标文本)) {
        返回 指针目标实参判定(源文本非, 目标文本);
    }
    如果 (实参文本尾引(目标文本)) {
        字符串 源剥引 = 源文本非;
        如果 (实参文本尾引(源文本非)) { 源剥引 = 实参文本剥尾(源文本非); }
        返回 值形态实参判定(源剥引, 实参文本剥尾(目标文本), 诊断);
    }
    返回 值形态实参判定(源文本非, 目标文本, 诊断);
}
