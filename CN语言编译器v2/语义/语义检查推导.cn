// CN 自举编译器 v2 · 语义组件·推断声明类型推导族（728s 拆分·先拆再加纪律）
// 职责：46-c 推断声明类型权威推导（表达式类型ID/推导成员类型ID/推导二元类型ID）
//   ——自 语义检查中.cn 机械搬移（该文件邻近千行红线·242 冻结线先拆再加先例
//   同款）·函数体逐字迁移零语义变化·调用点经合并全局池解析不变。
// 901/627 扩展（560 rebase 合并移植）：表达式类型ID 标识符分支函数名先行
//   （函数名作值=函数指针文本·宿主 checkFunctionNameValue 同构）+?前缀豁免
//   （?lambdaN 合成名落既有 lambda 通道·771 实录防空返回段误合成）。
// 728s 增强（零分叉·582 轮侦察派生）：字面量后缀定级（字面量后缀类型ID·宿主
//   literalTypeOf 同构）——表达式类型ID 的字面量分支先取后缀（L/LL/U/UL/ULL
//   定级）；推导二元类型ID 合并改经 二元结果类型ID（秩高者胜/同秩取左·宿主
//   commonNumericType 逐字同构）——对齐宿主 `1U+2U`/`1UL+2UL`/`1U+2`/
//   `1+2UL` 全族行为（修复前 v2 字面量恒整32 二元推导出整32 → 赋值面混合符号
//   误拒 `正32 丙 = 1U + 2U;` 全族；745 同根）。
// 638 对齐（rebase develop·2026-10-14 用户裁决甲案「一种语言不该有歧义」）：
//   原 497 无后缀字面量真值域改判链（十进制文本超上界/推断字面量域ID 两函数 +
//   表达式类型ID 的 497 分支）随「推断通道一律拒」裁决废止——无后缀字面量推断
//   恒走 检查表达式 既有整32 定级（宿主 inferredLiteralWidthType 撤销同构），
//   超域由 检查推断面字面量值域（语义检查字面量域.cn）编译期拒；develop 已删
//   两函数，本文件不迁（防复活死代码）。
// 依赖=协议常量（节点_*/符号）·检查表达式（语义检查.cn）·检查标识符表达式
//   （语义检查表达式标识符.cn）·检查调用表达式（语义检查表达式.cn）·类型可合并
//   （语义检查.cn）·字面量后缀类型ID（语义检查字面量域.cn）·查变量结构体键/
//   查语义指针变量/查字段类型ID/查类节点索引（IR/语义表族）·错误不安全边界。
// 声明序：包.cn 置于 语义检查中 之前（依赖先解析惯例）。

导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（目录包名）
导入 IR;         // 容器/结果 合成名判定（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// ==================== 728s：二元结果类型合并（宿主 commonNumericType 同构） ====================
// 整型位宽秩（宿主 intRankTable 同构：整8/正8=1 … 整128/正128=5）；非整数族=0。
函数 整型秩名(整64 类型ID) -> 整64 {
    如果 (类型ID <= 0) { 返回 0; }
    字符串 名 = 字符串复制(驻留文本(类型ID));
    如果 (字符串比较(名, "整8") || 字符串比较(名, "正8")) { 返回 1; }
    如果 (字符串比较(名, "整16") || 字符串比较(名, "正16")) { 返回 2; }
    如果 (字符串比较(名, "整32") || 字符串比较(名, "正32")) { 返回 3; }
    如果 (字符串比较(名, "整64") || 字符串比较(名, "正64")) { 返回 4; }
    如果 (字符串比较(名, "整128") || 字符串比较(名, "正128")) { 返回 5; }
    返回 0;
}

// 728s（修复前 推导二元类型ID 恒「取左」）：二元结果类型合并——同为整数族且
//   秩不同→**秩高者胜**（`1 + 2UL` 结果=正64·宿主 commonNumericType
//   「rankA >= rankB ? a : b」同构）；秩相等→取左（`1U + 2` 结果=正32、
//   `1 + 2U` 结果=整32——宿主实测同序敏感，见任务 728s 报告「顺序敏感性」
//   证据性说明）；非整数族（布尔/字符等）保持既有「类型可合并→取左」行为
//   （错误程序面由算术总守卫先拦，不在本轮扩面）。返回 0=不可合并（调用方
//   映射 -1）。浮点混合面沿用既有取左（不在本轮扩面）。
函数 二元结果类型ID(整64 左ID, 整64 右ID) -> 整64 {
    如果 (左ID <= 0 || 右ID <= 0) { 返回 0; }
    如果 (!类型可合并(左ID, 右ID)) { 返回 0; }
    整64 秩左 = 整型秩名(左ID);
    整64 秩右 = 整型秩名(右ID);
    如果 (秩左 > 0 && 秩右 > 0 && 秩左 != 秩右) {
        如果 (秩左 > 秩右) { 返回 左ID; }
        返回 右ID;
    }
    返回 左ID;   // 同秩取左（宿主同口径）与非整数族既有行为
}

// 728s 对称化（2026-10-15 用户裁决批乙·#728s「宿主字面量二元算式结果类型
//   『顺序敏感』（1+2U 拒/1U+2 放行）是否对称化」→ 批乙：对称化·Rust 真对齐）：
//   无后缀字面量随另一侧替换（左优先·单侧触发——两侧均无后缀时不替换，杜绝
//   互随顺序敏感）。规则=一侧无后缀非负字面量、另一侧「有定级」（非无后缀
//   字面量）且整数族时，字面量侧按另一侧类型参与（1 + 2U → 正32、2U + 1 →
//   正32 双向对称；另一侧变量/成员/调用同规则——001 §3.7「字面量按另一侧
//   类型参与」）。边界：负号字面量不随侧（无符号域不承载负值·Rust 同口径
//   -1 + 2U 维持拒绝）；另一侧非整数族（浮点/字符等）不触发。宿主
//   unifyUnsuffixedLiteralOperand728 逐字同构（语义+域预演双点共用）。
//   无返回值（经引用出参回写左ID/右ID）；消费=推导二元类型ID 与 溢出面域类型474。
函数 随侧无后缀字面量728(向量<节点> 池, 整32 左末端, 整32 右末端,
                        整64& 左ID, 整64& 右ID) -> 空类型 {
    布尔 左无后缀728 = 是无后缀非负字面量末端(池, 左末端);
    布尔 右无后缀728 = 是无后缀非负字面量末端(池, 右末端);
    如果 (左无后缀728 && !右无后缀728 && 是整数族类型ID(右ID)) {
        左ID = 右ID;
        返回;
    }
    如果 (右无后缀728 && !左无后缀728 && 是整数族类型ID(左ID)) {
        右ID = 左ID;
        返回;
    }
}

// ==================== 46-c 推断声明类型推导（2026-09-10 第四十九轮） ====================
// 推断声明的类型权威推导（单点；IR 层经 推断声明类型表 查表消费）：
//   表达式类型ID——区间末节点=表达式根（线性化约定，检查表达式 二元/三元
//   同款技巧）：成员/二元走专用推导（检查表达式 对两者恒 整64/-1 半实现，
//   推断声明不可静默降级——成员误推整64 会让结构体值截断进 8 字节槽=46-a
//   家族静默错误代码）；其余（字面量/标识符/调用/下标/三元）经 检查表达式
//   既有精确推导。-1=不可推导（调用方可见诊断，语义错误即中止兜底）。
函数 表达式类型ID(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    如果 (n.类型 == 节点_成员) {
        // 1068 回归根治（869 轮·方法值推断截断；1019 承接落地 win-x64 存量红）：
        //   值位形=真——成员作值（对象.方法 非调用被调）经方法回退合成函数指针
        //   文本；调用被调面（491 面直接消费）/左值面等经默认假维持原语义零变化。
        返回 推导成员类型ID(池, 节点索引, 符号表, 诊断, 真);
    }
    如果 (n.类型 == 节点_二元运算) { 返回 推导二元类型ID(池, 节点索引, 符号表, 诊断); }
    // 901/627 同族（2026-10-14·宿主 checkFunctionNameValue 同构）：推断声明
    //   初值=函数名（`变量 f = 造点;`）——函数名作值=函数指针文本
    //   （443 值位口径唯一归属：检查标识符表达式 的签名回退给出的是函数
    //   **返回类型**，值位推导不得复用——原缺陷：f 被推成结构体「点」→
    //   IR 层走结构体局部通道、初值恒 0 → 经 fnptr 返回/调用即空指针崩溃
    //   （901tmpd/901tmpc 实锤·宿主同源全过=分叉）。先行命中即返回合成文本，
    //   miss 落下方既有路径零变化。
    //   ?前缀豁免（560 rebase 771 实录 2026-10-15）：?lambdaN=解析层脱糖合成
    //   匿名函数名（检查标识符表达式 ?豁免同判据·首字节 63）——无返回标注的
    //   合成函数其签名返回类型登记=0，函数名指针文本 会合成空返回段
    //   「函数指针<>(…)」抢在 检查表达式 ?豁免 → lambda合成类型 返回推导之前
    //   （771 形态②③实锤·宿主 checkFunctionNameValue 不及 ?名故无此面）；
    //   ?名跳过先行落既有 lambda 通道，返回推导完成后经 lambda合成类型 合成
    //   完整「函数指针<返回>(参数)」签名。
    如果 (n.类型 == 节点_标识符) {
        字符串 名文本901 = 字符串复制(驻留文本(整64(n.文本)));
        如果 (字符串长度(名文本901) > 0 && (整64(名文本901[0]) & 255) != 63) {
            字符串 函数名值901 = 函数名指针文本(符号表, 整64(n.文本));
            如果 (字符串长度(函数名值901) > 0) { 返回 驻留(函数名值901); }
        }
    }
    // 728s：整数字面量**先经后缀定级**（宿主 literalTypeOf 同构——L→整64／
    //   LL→整128／U→正32／UL→正64／ULL→正128；负号字面量=323 解析期折叠
    //   整数字面量 raw 带 '-'，后缀收集在尾部同样命中）——修复前恒整32 致
    //   推断声明带后缀误拒（745 p1=`变量 甲=3000000000L;` 报『无法将 整32
    //   隐式转换为 整32』）。无后缀落 检查表达式 既有整32 恒定级（638 甲案：
    //   推断通道无后缀大字面量不设真值域改判·超域由推断面值域检查编译期拒）。
    如果 (n.类型 == 节点_整数字面量) {
        整64 后ID728 = 字面量后缀类型ID(驻留文本(整64(n.文本)));
        如果 (后ID728 > 0) { 返回 后ID728; }
    }
    // 638（甲案·2026-10-14 用户裁决「一种语言不该有歧义」）：原 497 推断面
    //   真值域改判块（节点_整数字面量/节点_负号字面量 → 推断字面量域ID 改判
    //   整64/整128 放行）随「推断通道一律拒」裁决废止——整数字面量推断恒走
    //   检查表达式 既有整32 定级（宿主 inferredLiteralWidthType 撤销同构），
    //   超域由 检查推断面字面量值域（语义检查字面量域）编译期拒+引导显式写
    //   类型；显式目标场景字面量解析能力不动（提升链适用面=表达式求值与显式
    //   目标类型·001 §3.7a 条文 638 收窄）。
    // 414（#414·宿主 checkUnaryOperatorOverload 同构）：单目 - ! ~ 操作数为类
    //   实例且命中「运算符X」（0 右参）→ 返回重载方法返回类型。P0-3 起位非
    //   不再解析期脱糖（树中恢复 节点_位非）。未命中回退=宿主内置产物面：
    //   负号/位非→操作数类型、逻辑非→布尔（检不出 -1 落下方既有路径）。
    如果 (n.类型 == 节点_负号 || n.类型 == 节点_逻辑非 || n.类型 == 节点_位非) {
        整64 一元ID414 = 一元重载返回ID(池, 节点索引, 符号表);
        如果 (一元ID414 > 0) { 返回 一元ID414; }
        如果 (n.类型 == 节点_逻辑非) { 返回 驻留("布尔"); }
        如果 (n.子终点 > n.子起点 && n.子终点 <= 整32(池.大小())) {
            向量<字符串> 静默U414 = 向量<字符串>();
            整64 操作数ID414 = 表达式类型ID(池, 整32(n.子终点) - 1, 符号表, 静默U414);
            如果 (操作数ID414 > 0) { 返回 操作数ID414; }
        }
    }
    // 951（002·B 类推断面·183/484 族）：结构体构造字面量（名{ 字段 = 值 }）
    //   ——类型=结构体名自身（节点_结构体构造.文本=结构体名 ID·解析层 84-a）
    如果 (n.类型 == 节点_结构体构造) { 返回 整64(n.文本); }
    返回 检查表达式(池, 节点索引, 符号表, 诊断);
}

// 成员读类型推导（46-a 家族同源机制，同构 IR生成 解析成员链结构体ID 范本——
//   父链三形态：标识符（变量结构体表 键基直查>1；标量/容器走符号表类型名归一）/
//   成员（递归）/调用（返回类型名归一））。返回字段类型名ID；-1=不可推导。
//   值位形869（默认 假·调用/左值面原语义）：值位语境（成员作值——表达式类型ID
//   成员分支传 真）方法回退返回函数指针文本（1068 回归根治·见 951 分支注释）。
函数 推导成员类型ID(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断,
                    布尔 值位形869 = 假) -> 整64 {
    节点 m = 池.元素(节点索引);
    整64 父键基 = 0;
    如果 (m.子起点 >= 0 && m.子起点 < 池.大小()) {
        节点 对象m = 池.元素(整32(m.子起点));
        如果 (对象m.类型 == 节点_标识符) {
            // 变量结构体表：值>1=键基（结构体对象直查）；1=结构体名标记/
            //   0/-1=非结构体——标量/容器走符号表类型名（字符串字段等非
            //   结构体成员经 查结构体类型 归一 miss=-1 可见）
            整64 键v = 查变量结构体键(整64(对象m.文本));
            如果 (键v > 1) {
                父键基 = 键v;
            } 否则 {
                整64 对象类型ID = 检查标识符表达式(池, 整32(m.子起点), 符号表, 诊断);
                如果 (对象类型ID > 0) { 父键基 = 查结构体类型(对象类型ID); }
            }
            // 926：154-a「指针成员访问」推断面挂点**退位**——原挂点（指针变量表
            //   命中即报）与主面（检查成员访问表达式 B9）双报实锤（r10 探针：
            //   推断声明「变量 r = p.x」报 2 条 vs 宿主 1 条——推断面推断消费方
            //   用真实诊断）。主面已覆盖全部语句区间遍历路径（615 多级拦截同款
            //   单面先例），推断面删除防双报；B9 判定（层数/显解/字符*/数组/
            //   赋值左值区间）统一归主面单点。
        } 否则 如果 (对象m.类型 == 节点_成员) {
            整64 父字段ID = 推导成员类型ID(池, 整32(m.子起点), 符号表, 诊断);
            如果 (父字段ID > 0) { 父键基 = 查结构体类型(父字段ID); }
        } 否则 如果 (对象m.类型 == 节点_调用) {
            整64 返回类型ID = 检查调用表达式(池, 整32(m.子起点), 符号表, 诊断);
            如果 (返回类型ID > 0) { 父键基 = 查结构体类型(返回类型ID); }
        }
    }
    如果 (父键基 <= 0) { 返回 -1; }
    整64 字段ID = 查字段类型ID(父键基, 整64(m.文本));
    如果 (字段ID == 0) {
        // 951（002·B 类·104 族）：成员=类**方法引用**（对象.方法 作值——字段
        //   表 miss 后按类方法表回退：父链结构体名→查类节点→扫 节点_方法
        //   命中名→返回方法返回类型 ID（节点_方法.附加）；实例方法引用是
        //   函数指针形态（宿主 funcFirstSigKey 同族））。
        // 1068 回归根治（869 轮·值位形869；1019 承接落地 win-x64 存量红）：
        //   **值位语境**（成员作值·非调用被调——表达式类型ID 成员分支传 真）
        //   改返回函数指针文本「函数指针<方法返回类型>(参数串)」——原恒返回
        //   方法返回类型致值位消费（推断声明 `变量 cb = 对象.双倍;`）把蹦床
        //   地址按返回类型（整32）窄化存储（op54 mov eax+movsxd 截断实锤·
        //   经 fnptr 转发调垃圾指针 C0000005=1068 崩；平台面：linux E2E
        //   -no-pie 基址 0x400000 地址<2^31 截断无损=侥幸绿——win 基址
        //   0x140000000 截断丢位必崩=win 特有存量红，1019 本机 -pie 重链
        //   复现 RAX=RCX=5 与 win 全量报告逐值一致）；调用面 491/左值面等
        //   消费方维持默认 假=返回方法返回类型（语义零变化）。参数串=类方法
        //   参数串（登记类方法 同点两表·沿链继承）——串 miss=不可推导 -1
        //   （不落静默窄化·miss 不可静默纪律）。类键=类节点.文本（类名 ID·
        //   零歧义）。
        整64 类节点951 = 查类节点索引(父键基);
        如果 (类节点951 >= 0 && 类节点951 < 池.大小()) {
            节点 类值951 = 池.元素(整32(类节点951));
            整64 扫951 = 整64(类值951.子起点);
            当 (扫951 < 整64(类值951.子终点)) {
                节点 成员m951 = 池.元素(整32(扫951));
                如果 (成员m951.类型 == 节点_方法 &&
                     整64(成员m951.文本) == 整64(m.文本) &&
                     成员m951.附加 > 0) {
                    如果 (值位形869) {
                        整64 串FP869 = 查类方法参数串(整64(类值951.文本),
                                                      整64(m.文本));
                        布尔 串有效869 = 串FP869 > 0;
                        如果 (串有效869) {
                            返回 驻留("函数指针<" +
                                      字符串复制(驻留文本(整64(成员m951.附加))) +
                                      ">(" +
                                      字符串复制(驻留文本(串FP869)) + ")");
                        }
                        返回 -1;
                    }
                    返回 整64(成员m951.附加);
                }
                扫951++;
            }
        }
        返回 -1;
    }
    返回 字段ID;
}

// 二元运算类型推导（左右操作数区间末节点递归+合并——检查表达式
//   二元节点布局约定：附加=右操作数起点、左末=附加-1、右末=本索引-1〔469〕）。
//   任一侧不可推导/跨族=整体 -1（绝不静默降级整64——推断声明类型错误是
//   静默错误代码温床）。返回合并类型名ID（728s 起经 二元结果类型ID：
//   秩高者胜/同秩取左——宿主 commonNumericType 同构）；-1=不可推导。
函数 推导二元类型ID(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    // 414（#414 运算符重载·宿主 checkClassOperatorOverload 同构）：重载决议
    //   顺序②——左操作数为用户类且沿链命中「运算符X」→ 返回重载方法返回类型
    //   （先于内置合并推导；未命中 -1 落回下方既有推导=顺序③守卫兜底）
    整64 重载ID414 = 二元重载返回ID(池, 节点索引, 符号表);
    如果 (重载ID414 > 0) { 返回 重载ID414; }
    // 469（450 同族第四轮·左末口径统一 子起点-1→附加-1）：全构建形态契约=
    //   附加=右操作数起点→左操作数**末端**=附加-1（970/425/418/450 同口径；
    //   复合赋值/自增自减合成二元 子起点=左值副本起点 错位面·详注=450 面）。
    如果 (n.附加 <= 0 || n.附加 > 整32(池.大小())) { 返回 -1; }
    整64 左ID = 表达式类型ID(池, 整32(n.附加 - 1), 符号表, 诊断);
    整64 右ID = 表达式类型ID(池, 整32(节点索引 - 1), 符号表, 诊断);
    // 155-a A1 挂点原位于此（推导二元类型ID）——157-a 实测失效（表达式类型ID
    //   对指针变量返 -1）已移除；A1 判定统一下沉 检查表达式 二元分支
    //   （查语义指针变量 判定，声明/赋值/表达式全路径覆盖）。
    如果 (左ID <= 0 || 右ID <= 0) { 返回 -1; }
    // 728s 对称化（2026-10-15 用户裁决批乙）：无后缀字面量随另一侧定级——
    //   正32 同秩场景 `1 + 2U` 原落「同秩取左=整32」与 `2U + 1`=正32 不对称
    //   （编译期混合符号误拒非对称），判决=双向放行（Rust 真对齐）。另一侧
    //   整数族（含变量/带后缀字面量/成员/调用推导）时字面量侧按另一侧参与；
    //   两侧均无后缀=无定级对象（不替换·杜绝互随顺序敏感）；负号字面量
    //   不随侧（Rust 同口径）。**移位（<< >>）不随侧**：右操作数不参与结果
    //   类型（740 推导二元结果类型ID 移位面「字面量直译整32」锚同口径·
    //   宿主实测 `整8 甲 = 甲8 << 2` 拒「无法将 '整32' 隐式转换为 '整8'」·
    //   Rust/C 结果=左操作数）；算术/位运算（& | ^）随侧。宿主
    //   unifyUnsuffixedLiteralOperand728 + checkBitwiseBinary 移位守卫同构。
    字符串 op728 = 字符串复制(驻留文本(整64(n.文本)));
    布尔 是移位728 = 字符串比较(op728, "<<") || 字符串比较(op728, ">>");
    如果 (!是移位728) {
        // 788（2026-10-15·宿主 checkArithmeticBinary 285 窄域适配同构·仅算术
        //   面·**先于 728s 随侧**宿主同序）：一侧窄整（整8/整16/正8/正16=
        //   秩∈{1,2}）+另一侧非窄整数族+非窄侧末端=整数字面量形态（含负号·
        //   宿主 isIntLiteralExpr 同构·是整数字面量末端 复用）→ 字面量侧按
        //   窄侧参与。实证=p28/p29/p31（`甲16+2ULL`/`甲8+2U`/`丙U8+1L` 宿主
        //   285 拉窄+字面量豁免混合符号放行 vs v2 修前推宽（正128/正32/整64）
        //   拒=反向分叉）。前提=双侧整数族（宿主 isInteger 双侧同构·
        //   整型秩名>0——字符/布尔/浮点秩 0 不进）；位面（& | ^）不加（宿主
        //   checkBitwiseBinary 无 285·p32 实测 `甲8&1L` 宿主拒整64）。
        如果 (字符串比较(op728, "+") || 字符串比较(op728, "-") ||
             字符串比较(op728, "*") || 字符串比较(op728, "/") ||
             字符串比较(op728, "%")) {
            如果 (整型秩名(左ID) > 0 && 整型秩名(右ID) > 0) {
                布尔 左窄788 = 整型秩名(左ID) <= 2;
                布尔 右窄788 = 整型秩名(右ID) <= 2;
                如果 (右窄788 && !左窄788 &&
                     是整数字面量末端(池, 整32(n.附加 - 1))) {
                    左ID = 右ID;
                } 否则 如果 (左窄788 && !右窄788 &&
                     是整数字面量末端(池, 整32(节点索引 - 1))) {
                    右ID = 左ID;
                }
            }
        }
        随侧无后缀字面量728(池, 整32(n.附加 - 1), 整32(节点索引 - 1), 左ID, 右ID);
    }
    // 728s：合并改经 二元结果类型ID（原恒「取左」——`1 + 2UL` 误推 整32、
    //   `1UL + 2` 误推 整32=正64 目标全误拒；秩合并后与宿主 commonNumericType
    //   对齐：异秩秩高者胜/同秩取左）。
    整64 合ID728 = 二元结果类型ID(左ID, 右ID);
    如果 (合ID728 == 0) { 返回 -1; }
    返回 合ID728;
}
