// 语义检查表达式终态（1960 执法一轮·2026-11-02·先拆再加：自 语义检查表达式.cn
//   拆出调用终态整64兜底废除面——该文件拆前 1183 行超 1000 冻结线）。
// 职责：检查调用表达式 终态（分派链全 miss 后）的返回类型决议——
//   ①终态前多面精确推导（容器签名表/接口表/类方法表+泛型基名回退/内置模块
//   限定/类字段链直查·各面消费与 IR 层决议同源数据）；
//   ②推导仍 miss=真未登记形态 → 登记内部未登记（891/947 泛型面 648 改造
//   先例·登记后占位继续·主收尾统一中止）——十二条款①②执法面。

导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（目录包名）
导入 IR;         // 签名表/接口表/类方法表/物化归一（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 数组后缀剥离（1960 终态辅助·fnptr 数组面）：类型文本尾「[N]」段截断
//   （「函数指针<整32>(整32)[2]」→「函数指针<整32>(整32)」·1484 族）——
//   无 '[' 原样返回（幂等）。
函数 剥数组后缀1960(字符串 文本1960) -> 字符串 {
    整64 长1960 = 字符串长度(文本1960);
    整64 括位1960 = 0 - 1;
    整64 扫1960 = 0;
    当 (扫1960 < 长1960) {
        如果 ((整64(文本1960[整32(扫1960)]) & 255) == 91) { 括位1960 = 扫1960; 中断; }
        扫1960++;
    }
    // 静默豁免业务值: 单边守卫——括位>=0=数组后缀存在（-1=无数组段哨兵·原样返回）非业务区间判定（1960 剥后缀守卫）
    如果 (括位1960 >= 0) {
        返回 字符串子串(文本1960, 0, 整32(括位1960));
    }
    返回 字符串复制(文本1960);
}

// 指针尾星剥离一级（1960 终态辅助·001 §3 立法「. 左侧指针自动解引用一级」）：
//   「盒*」→「盒」；无尾星原样（幂等）。
函数 剥尾星1960(字符串 文本1960) -> 字符串 {
    整64 长1960 = 字符串长度(文本1960);
    // 静默豁免业务值: 单边守卫——长度>0 且尾字节=42（'*' ASCII）=指针形态哨兵·非业务区间判定（1960 剥星守卫）
    如果 (长1960 > 0 && (整64(文本1960[整32(长1960 - 1)]) & 255) == 42) {
        返回 字符串子串(文本1960, 0, 整32(长1960 - 1));
    }
    返回 字符串复制(文本1960);
}

// 限定名纯名剥离（1960 终态辅助·跨模块类面·93 实证）：「模块甲::计数器」→
//   「计数器」（类方法表键=模块内纯名·声明收集登记域）；无 "::" 原样（幂等）。
函数 剥限定前缀1960(字符串 文本1960) -> 字符串 {
    整64 长1960 = 字符串长度(文本1960);
    整64 双冒位1960 = 0 - 1;
    整64 扫1960 = 0;
    当 (扫1960 < 长1960) {
        如果 ((整64(文本1960[整32(扫1960)]) & 255) == 58 &&
             扫1960 + 1 < 长1960 &&
             (整64(文本1960[整32(扫1960 + 1)]) & 255) == 58) {
            双冒位1960 = 扫1960;
            中断;
        }
        扫1960++;
    }
    // 静默豁免业务值: 单边守卫——双冒位>=0=限定名形态（-1=纯名哨兵·原样返回）非业务区间判定（1960 剥前缀守卫）
    如果 (双冒位1960 >= 0) {
        返回 字符串子串(文本1960, 整32(双冒位1960 + 2),
                         整32(长1960 - 双冒位1960 - 2));
    }
    返回 字符串复制(文本1960);
}

// 调用终态类型决议（1960 执法一·十二条款①②落地·2026-11-02）：调用表达式
//   终态整64兜底废除面。原豁免边界（L2 十一用例常态回退通道·首记 648 曾登记
//   后回撤）本轮终止：终态前补多面精确推导分支，推导仍 miss=真未登记形态
//   → 登记内部未登记+占位继续（主收尾统一中止）。
//   （终态在 调用起点>0 如果外·被调节点/被调文本 作用域不可见——经 n.子起点
//   现场重取·语义检查表达式 64 行注释同源池布局。）
//   推导面序（各面 miss 即落下一面·全 miss 登记显形）：
//   ①内置模块根对象（stdlib 源码级加载面·156_v2 实证 IO.打印到错误）；
//   ②静默推导/静默检查包装（成员链对象·127_v2 实证 b.表.追加）；
//   ③类字段链池节点直查（顺序无关·1035 实证 甲.记录.追加——检查面类字段
//     推导存在检查顺序敏感时序·试验D 主前置即绿）；
//   ④接口表（100_接口多态 实证 接收者=接口名）；
//   ⑤容器签名表+1611 物化归一（合成名面·1064 实证 造向量().大小()）；
//   ⑥类方法表沿链+泛型基名回退（26_generics 实证 盒A.获取——实例条目 IR
//     生成期注册·语义期按基名查原型 T→实参替换·415 同款设施）；
//   ⑦内置模块限定两级归一（对象类型=模块名根面·同①数据源）。
函数 检查调用终态1960(向量<节点> 池, 整32 节点索引,
                      向量<映射<整64, 符号>>& 符号表) -> 结果<整64, 整32> {
    节点 n = 池.元素(节点索引);
    字符串 被调文本终态 = "<调用>";
    // 1960 签名表就绪前置（1035 快筛时序实证·2026-11-02）：查方法签名 的
    //   stdlib 容器签名=惰性加载（首次 miss 触发·确保签名已加载 幂等）——
    //   早期函数检查时加载未触发面=查方法签名 恒 miss（试验D 主前置即绿=
    //   主内调用先触发加载）。终态推导链开头显式前置加载（幂等·零重复成本）
    //   ——消除「推导面读未就绪表」的检查顺序敏感。
    确保签名已加载();
    // 静默豁免业务值: 单边守卫——子起点>0=池布局有效性（0=无被调子节点·节点池哨兵）非业务区间判定（1960 终态显形面守卫）
    如果 (n.子起点 > 0) {
        节点 被调节点终态 = 池.元素(整32(整64(n.子起点)));
        如果 (被调节点终态.类型 == 节点_标识符 || 被调节点终态.类型 == 节点_成员) {
            被调文本终态 = 字符串复制(驻留文本(整64(被调节点终态.文本)));
        }
        // 1960 fnptr 下标被调面（1484/603/625/629 快筛误伤实证 `表[0](5)`·
        //   2026-11-02）：被调=下标（函数指针数组元素调用）——修前终态整64
        //   占位静默（IR 层 fnptr 决议）。数组名类型文本「函数指针<返回>(参数)[N]」
        //   经 剥数组后缀1960+函数指针返回文本 单点提取返回段直返。
        // 静默豁免业务值: 单边守卫——子起点>0=下标根子节点存在性（池下标哨兵）非业务区间判定（1960 fnptr 下标被调面守卫）
        如果 (被调节点终态.类型 == 节点_下标 && 被调节点终态.子起点 > 0) {
            节点 下标根 = 池.元素(整32(被调节点终态.子起点));
            如果 (下标根.类型 == 节点_标识符) {
                可选<整64> 数组类型查 = 表查找类型ID(符号表, 整64(下标根.文本));
                如果 (数组类型查.有值) {
                    字符串 数组文本 = 剥数组后缀1960(
                        字符串复制(驻留文本(数组类型查.值)));
                    // 静默豁免业务值: 单边守卫——是函数指针类型文本=形态命中哨兵（假=非 fnptr 数组·落通用链）非业务区间判定（1960 fnptr 面守卫）
                    如果 (是函数指针类型文本(数组文本)) {
                        可选<字符串> 返段查 = 函数指针返回文本(数组文本);
                        如果 (返段查.有值) {
                            返回 正常(驻留(返段查.值));
                        }
                    }
                }
            }
        }
        // 静默豁免业务值: 单边守卫——子起点>0=成员对象子节点存在性（池下标哨兵）非业务区间判定（1960 终态显形面守卫）
        如果 (被调节点终态.类型 == 节点_成员 && 被调节点终态.子起点 > 0) {
            节点 对象终态 = 池.元素(整32(被调节点终态.子起点));
            整64 对象类型终态 = 0;
            字符串 模块根名终态 = "";
            如果 (对象终态.类型 == 节点_标识符) {
                可选<整64> 对象类型终态查 = 表查找类型ID(符号表, 整64(对象终态.文本));
                如果 (对象类型终态查.有值) { 对象类型终态 = 对象类型终态查.值; }
                // 1960 类名静态方法面（JSON 族快筛误伤实证 `JSON树.新节点(...)`·
                //   2026-11-02）：对象=**类名**（静态方法调用的接收者）——类名
                //   不入变量符号表（表查找恒 miss·类表独立）——类表命中即按类
                //   名 ID 进判定链（查类方法返回=静态方法返回类型·93 同源）。
                如果 (对象类型终态 == 0) {
                    字符串 类名查终态 = 字符串复制(驻留文本(整64(对象终态.文本)));
                    如果 (是用户类ID(驻留(类名查终态))) {
                        对象类型终态 = 驻留(类名查终态);
                    }
                }
                // 1960 内置模块根对象面（156_v2 快筛实证 stdlib/IO.cn 行44
                //   `IO.打印到错误(消息)`·2026-11-02）：对象=标准库模块名根——
                //   模块名根无类型 ID（检查标识符表达式 178 行 错误(3) 通道·
                //   464-a 设计口径），推导恒无值。此处按根名直查内置限定表
                //   （stdlib 源码级加载面·导入即编译=非零触发）。
                如果 (对象类型终态 == 0) {
                    字符串 根名查终态 = 字符串复制(驻留文本(整64(对象终态.文本)));
                    如果 (是标准库模块名(根名查终态)) {
                        模块根名终态 = 根名查终态;
                    }
                }
            }
            // 静默豁免业务值: 单边守卫——根名非空=标准库模块名根命中哨兵（空=非模块根形态）非业务区间判定（1960 内置限定面守卫）
            如果 (字符串长度(模块根名终态) > 0) {
                字符串 方法名根终态 = 字符串复制(
                    驻留文本(整64(被调节点终态.文本)));
                可选<整64> 内置点查 = 内置函数返回类型ID(
                    模块根名终态 + "." + 方法名根终态);
                如果 (内置点查.有值) { 返回 正常(内置点查.值); }
                可选<整64> 内置双冒查 = 内置函数返回类型ID(
                    模块根名终态 + "::" + 方法名根终态);
                如果 (内置双冒查.有值) { 返回 正常(内置双冒查.值); }
            }
            // 1960 类体裸字段名面（1445 JSON 族快筛实证 `子头们.设置(...)`·
            //   2026-11-02）：对象=标识符·变量表 miss·非模块根=**当前检查类**
            //   的字段裸名（类方法体内直书字段·001 §3）——查当前检查类ID→
            //   类字段类型文本IR1674 直查（顺序无关同上）。
            如果 (对象类型终态 == 0 && 对象终态.类型 == 节点_标识符 &&
                 字符串长度(模块根名终态) == 0) {
                可选<整64> 当前类查 = 查当前检查类ID();
                如果 (当前类查.有值) {
                    字符串 字段类型查 = 类字段类型文本IR1674(
                        池, 当前类查.值, 整64(对象终态.文本));
                    // 静默豁免业务值: 单边守卫——字段类型非空=当前类字段沿链命中（空=字段不存在诚实边界·非查表默认值）判定（1960 类体裸字段名面守卫）
                    如果 (字符串长度(字段类型查) > 0) {
                        对象类型终态 = 驻留(类型文本物化1611(字段类型查));
                    }
                }
            }

            // 1960 推导缺口补（127_v2 实证 `b.表.追加`·2026-11-02）：对象=
            //   成员/调用/下标等表达式形态（或标识符表查找 miss）——静默推导
            //   包装单点取对象类型（609 面同款通道·诊断吞弃+去重副作用抑制）
            //   ——成员链对象（b.表）经 推导成员类型ID 递归得容器实例合成名。
            //   1035 快筛实证补（类字段链 `甲.记录.追加`·货架=类）：推导面
            //   （推导成员类型ID）只认结构体表——类字段在**检查面**（检查成员
            //   访问表达式·类表精确）——推导 miss 再走 静默检查表达式类型
            //   （105 行包装·同吞弃+抑制保证）。
            // 1960 类字段链顺序无关直查（1035 快筛时序实证·2026-11-02）：静默
            //   检查面（检查成员访问表达式）对类字段链存在检查顺序敏感时序
            //   （试验D 主前置即绿=前置检查触发某全局状态；文件序检查=首函数
            //   推导 miss）——改走**类池节点直查**（类字段类型文本IR1674·沿基
            //   链扫类体·声明收集期即就绪·顺序无关·**前置于静默层**——1552
            //   复筛实证静默层先行会以垃圾值抢占顺序无关面）：链根=标识符类型
            //   为用户类（**或下标链基座**——1052 实证 `表[0].记录.大小`·基座
            //   经容器元素签名直查）→逐段类字段直查（类型文本经 1611 物化幂等
            //   归一·指针字段段剥星一级〔001 §3·781 实证〕·段 miss=诚实中断
            //   →落静默层/终态登记显形）。
            如果 (对象类型终态 == 0 && 对象终态.类型 == 节点_成员) {
                节点 链游标 = 对象终态;
                向量<字符串> 链段名们 = 向量<字符串>();
                整64 链根类型直查 = 0;
                布尔 链可解析 = 真;
                当 (链可解析) {
                    布尔 游标是成员 = 链游标.类型 == 节点_成员;
                    布尔 游标是标识符 = 链游标.类型 == 节点_标识符;
                    布尔 游标是下标 = 链游标.类型 == 节点_下标;
                    如果 (游标是成员) {
                        结果<空类型, 整32> 段加 = 链段名们.追加(字符串复制(驻留文本(整64(链游标.文本))));
                        如果 (!段加.正常) { 运行时错误(4); }
                        // 静默豁免业务值: 单边守卫——子起点>0=链上游节点存在性（池下标哨兵）非业务区间判定（1960 类字段链直查守卫）
                        布尔 链上游有效 = 链游标.子起点 > 0 &&
                                          链游标.子起点 < 整32(池.大小());
                        如果 (链上游有效) {
                            链游标 = 池.元素(整32(链游标.子起点));
                        }
                        如果 (!链上游有效) { 链可解析 = 假; }
                    }
                    如果 (游标是标识符) {
                        可选<整64> 链根查 = 表查找类型ID(符号表, 整64(链游标.文本));
                        如果 (链根查.有值) {
                            // 1960 链根剥星（1445 JSON 族快筛实证 `树.数值们.设置`
                            //   ·树=JSON树* 指针形参·2026-11-02）：链根=指针类型
                            //   文本「JSON树*」→物化+剥尾星=「JSON树」（001 §3 接
                            //   收者自动解引用·类字段在所指类上）。
                            链根类型直查 = 驻留(类型文本物化1611(
                                剥尾星1960(字符串复制(驻留文本(链根查.值)))));
                        }
                        中断;
                    }
                    // 1960 下标链基座面（1052 快筛实证 `表[0].记录.大小`·
                    //   2026-11-02）：链下钻遇 下标节点（容器元素成员链基座）——
                    //   基座=标识符容器实例 → 查方法签名(容器,元素,1) 返回文本=T
                    //   （泛型实参替换同源·1611 物化）→ 链根=T 继续字段段。
                    // 静默豁免业务值: 单边守卫——游标=下标=链基座形态哨兵（容器元素成员链基座·其余形态落形态未知假）非业务区间判定（1960 下标链基座守卫）
                    如果 (游标是下标) {
                        // 静默豁免业务值: 单边守卫——子起点>0=下标基座子节点存在性（池下标哨兵）非业务区间判定（1960 下标链基座守卫）
                        如果 (链游标.子起点 > 0 &&
                             链游标.子起点 < 整32(池.大小())) {
                            节点 下标基座c = 池.元素(整32(链游标.子起点));
                            如果 (下标基座c.类型 == 节点_标识符) {
                                可选<整64> 容器类型查c = 表查找类型ID(符号表, 整64(下标基座c.文本));
                                如果 (容器类型查c.有值) {
                                    字符串 容器文本c = 字符串复制(驻留文本(容器类型查c.值));
                                    字符串 基名c = 合成名基名(容器文本c);
                                    // 静默豁免业务值: 单边守卫——基名非空且异于全名=容器实例合成名哨兵·非业务区间判定（1960 下标链基座守卫）
                                    如果 (字符串长度(基名c) > 0 &&
                                         !字符串比较(基名c, 容器文本c)) {
                                        方法签名 签元素c;
                                        如果 (查方法签名(容器文本c, "元素", 1, &签元素c)) {
                                            链根类型直查 = 驻留(
                                                类型文本物化1611(签元素c.返回文本));
                                        }
                                    }
                                    // 1960 CN 数组声明基座面（1052 快筛实证
                                    //   `货架[2] 表`·2026-11-02）：数组文本形态
                                    //   「货架[2]」（非容器合成名·基名==全名不走
                                    //   签名表）——元素类型=「[」前基名段直取。
                                    如果 (链根类型直查 == 0) {
                                        字符串 剥后c = 剥数组后缀1960(容器文本c);
                                        如果 (!字符串比较(剥后c, 容器文本c)) {
                                            链根类型直查 = 驻留(剥后c);
                                        }
                                    }
                                }
                            }
                        }
                        中断;
                    }
                    布尔 游标形态未知 = !游标是成员 && !游标是标识符 && !游标是下标;
                    如果 (游标形态未知) { 链可解析 = 假; }
                }
                // 静默豁免业务值: 单边守卫——链根类型>0=合法类型登记值（0=无类型占位）与段数>0=链段收集非空（哨兵）非业务区间判定（1960 类字段链直查守卫）
                如果 (链可解析 && 链根类型直查 > 0 && 链段名们.大小() > 0) {
                    整64 当前类直查 = 链根类型直查;
                    整64 段序 = 链段名们.大小();
                    当 (段序 > 0 && 当前类直查 > 0) {
                        段序--;
                        字符串 段类型 = 类字段类型文本IR1674(
                            池, 当前类直查, 驻留(链段名们.元素(整32(段序))));
                        // 静默豁免业务值: 单边守卫——段类型非空=类字段沿链命中（空=沿链 miss 诚实边界·非查表默认值）判定（1960 类字段链直查守卫）
                        布尔 段类型命中 = 字符串长度(段类型) > 0;
                        如果 (段类型命中) {
                            // 1960 指针段剥星一级（781 快筛误伤实证 `甲.子.读值`·
                            //   2026-11-02）：段类型「盒*」→剥尾星=「盒」（001 §3
                            //   「. 左侧指针自动解引用一级」·下一级类字段/方法在
                            //   所指类上）。
                            当前类直查 = 驻留(类型文本物化1611(
                                剥尾星1960(段类型)));
                        }
                        如果 (!段类型命中) { 当前类直查 = 0; }
                    }
                    // 静默豁免业务值: 单边守卫——直查结果>0=全链类型解析成功（0=链上 miss·诚实边界）非业务区间判定（1960 类字段链直查守卫）
                    如果 (当前类直查 > 0) { 对象类型终态 = 当前类直查; }
                }
            }

            如果 (对象类型终态 == 0) {
                可选<整64> 对象推导查 = 静默推导表达式类型(
                    池, 整32(被调节点终态.子起点), 符号表);
                如果 (对象推导查.有值) { 对象类型终态 = 对象推导查.值; }
            }
            如果 (对象类型终态 == 0) {
                可选<整64> 对象检查查 = 静默检查表达式类型(
                    池, 整32(被调节点终态.子起点), 符号表);
                如果 (对象检查查.有值) { 对象类型终态 = 对象检查查.值; }
            }
            // 1960 下标对象面（1052 快筛实证 `表[0].记录.大小()`·2026-11-02）：
            //   对象=下标（容器元素/函数指针数组元素的成员链基座）——静默检查
            //   面 miss 时（检查面下标推导的顺序敏感同 1035 根因）按容器元素
            //   签名直查（查方法签名(容器合成名,元素,1) 返回文本=T·泛型实参
            //   替换同源·1611 物化归一）。
            // 静默豁免业务值: 单边守卫——子起点>0=下标对象子节点存在性（池下标哨兵）非业务区间判定（1960 下标对象面守卫）
            如果 (对象类型终态 == 0 && 对象终态.类型 == 节点_下标 &&
                 对象终态.子起点 > 0) {
                节点 下标根c = 池.元素(整32(对象终态.子起点));
                如果 (下标根c.类型 == 节点_标识符) {
                    可选<整64> 容器类型查c = 表查找类型ID(符号表, 整64(下标根c.文本));
                    如果 (容器类型查c.有值) {
                        字符串 容器文本c = 字符串复制(驻留文本(容器类型查c.值));
                        字符串 基名c = 合成名基名(容器文本c);
                        // 静默豁免业务值: 单边守卫——基名非空且≠全名=容器实例合成名哨兵·非业务区间判定（1960 下标对象面守卫）
                        如果 (字符串长度(基名c) > 0 &&
                             !字符串比较(基名c, 容器文本c)) {
                            方法签名 签元素c;
                            如果 (查方法签名(容器文本c, "元素", 1, &签元素c)) {
                                对象类型终态 = 驻留(
                                    类型文本物化1611(签元素c.返回文本));
                            }
                        }
                    }
                }
            }
            // 静默豁免业务值: 单边守卫——类型ID>0=合法类型登记值（0=无类型占位·880 批5 同域哨兵）非业务区间判定（1960 终态显形面守卫）
            如果 (对象类型终态 > 0) {
                // 1960 接口面推导（100_接口多态 快筛误伤实证·2026-11-02）：对象
                //   类型=接口名——查接口方法返回 单点（IR 接口表·语义检查实例
                //   方法907 同源数据）；有值=精确返回类型文本 ID 直返；无值=接口
                //   无此方法（907 面已诊断=显形面·落终态登记双显形一致拒绝）。
                如果 (是接口名ID(对象类型终态)) {
                    可选<整64> 接口返回查 = 查接口方法返回(
                        对象类型终态, 整64(被调节点终态.文本));
                    如果 (接口返回查.有值) { 返回 正常(接口返回查.值); }
                }
                // 1611 物化归一（1064 快筛实证 `造向量().大小()`·2026-11-02）：
                //   查函数返回/推导面返回的容器文本=角括号模板形态（向量<整64>
                //   ·宿主 845 同源分叉）——合成名判定/签名表键全 miss。物化幂等
                //   单点（非泛型/已物化原样·零行为变更）后进判定链。
                字符串 对象文本终态 = 类型文本物化1611(
                    字符串复制(驻留文本(对象类型终态)));
                字符串 基名终态 = 合成名基名(对象文本终态);
                // 静默豁免业务值: 单边守卫——基名非空=合成名解析成功哨兵（空=非合成名形态）非业务区间判定（1960 终态显形面守卫·609 面同款）
                如果 (字符串长度(基名终态) > 0 &&
                     !字符串比较(基名终态, 对象文本终态)) {
                    方法签名 签终态;
                    如果 (查方法签名(对象文本终态, 被调文本终态,
                                     整64(n.附加), &签终态)) {
                        返回 正常(驻留(签终态.返回文本));
                    }
                }
                // 1960 用户类面推导（跨模块/池外类方法调用·快筛实证面）：IR 类
                //   方法表沿链查（声明收集期登记·623 同源数据·查类方法返回 含
                //   基类链 64 层守卫）——键=物化+剥星+剥限定前缀后文本 ID（与 IR
                //   实例化注册键同域·模板形态经物化归一·指针接收者经 001 §3 剥
                //   星·跨模块限定名经纯名剥离 93 实证）——有值=精确返回类型名 ID
                //   直返；无值=方法真不存在（907 面已诊断=落终态登记双显形·一致
                //   拒绝）。
                字符串 接收者纯名终态 = 剥限定前缀1960(剥尾星1960(对象文本终态));
                可选<整64> 类方法返回查 = 查类方法返回(
                    驻留(接收者纯名终态), 整64(被调节点终态.文本));
                如果 (类方法返回查.有值) { 返回 正常(类方法返回查.值); }
                // 1960 泛型实例基名回退（26_generics 快筛实证 `盒A.获取`·
                //   2026-11-02）：泛型实例类方法表条目=IR 生成期实例化注册
                //   （语义检查期只有泛型基类原型·键=基名）——物化名 miss 时按
                //   基名查原型返回文本 → 415 显式实例面同款 T→实参替换（泛型
                //   参数序拆段×剥实例参数段×替换实例类型文本）→ 精确实例返回。
                如果 (!字符串比较(基名终态, 对象文本终态) &&
                     !类方法返回查.有值) {
                    可选<整64> 原型返回查 = 查类方法返回(
                        驻留(基名终态), 整64(被调节点终态.文本));
                    如果 (原型返回查.有值) {
                        字符串 原型文本 = 字符串复制(驻留文本(原型返回查.值));
                        可选<整64> 序ID查g = 查类类型参数(驻留(基名终态));
                        如果 (序ID查g.有值) {
                            向量<整64> 参数名g = 向量<整64>();
                            向量<整64> 实参g = 向量<整64>();
                            泛型参数序拆段(序ID查g.值, 参数名g);
                            剥实例参数段(对象文本终态, 实参g);
                            // 静默豁免业务值: 单边守卫——参数名/实参个数相等且>0=替换前置不变量（0=无类型参数·哨兵）非业务区间判定（1960 泛型基名回退守卫·415 面同源）
                            如果 (参数名g.大小() == 实参g.大小() &&
                                 参数名g.大小() > 0) {
                                返回 正常(驻留(替换实例类型文本(原型文本, 参数名g, 实参g)));
                            }
                        }
                        返回 正常(原型返回查.值);
                    }
                }
                // 1960 内置模块限定面推导（156_v2 快筛实证 `IO.打印到错误`·
                //   2026-11-02）：对象=标准库模块名根（检查标识符表达式 178 行
                //   标识符面同源判定）——限定名两形态（点号/双冒号）经
                //   内置函数返回类型ID 两级归一单点查（IR 布局尾白名单·IR 层
                //   生成面同源）；无值=非内置限定调用（落终态登记显形）。
                如果 (是标准库模块名(对象文本终态)) {
                    可选<整64> 内置点查 = 内置函数返回类型ID(
                        对象文本终态 + "." + 被调文本终态);
                    如果 (内置点查.有值) { 返回 正常(内置点查.值); }
                    可选<整64> 内置双冒查 = 内置函数返回类型ID(
                        对象文本终态 + "::" + 被调文本终态);
                    如果 (内置双冒查.有值) { 返回 正常(内置双冒查.值); }
                }
            }
        }
    }
    登记内部未登记("调用表达式终态类型兜底", 被调文本终态,
                   整64(取当前诊断行()));
    返回 正常(驻留("整64"));
}
