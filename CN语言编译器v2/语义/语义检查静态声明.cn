// 语义检查静态声明（2051 拆分 自 语义检查语句.cn：943 行 >900 警戒线
//   「先拆再加」纪律——静态/顶层全局声明初值检查族独立成模块·先例=
//   语义检查初始化数组.cn #1769 拆分同构。纯搬移+数组初始化列表校验新增：
//   ①884 静态声明列表=个数/维度校验（检查多维数组列表逐维 同函数接静态面）
//   ②569 裸全局列表=逐元素常量性递归判定（列表全常量·宿主
//     cnIsConstArrayInitList 同语义））
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量
导入 IR;         // 是数组类型文本/数组元素文本/数组长度文本（数组工具）
导入 协议常量;
导入 语义检查初始化数组;   // 2051：检查多维数组列表逐维（个数/维度校验·包内兄弟）

公开:   // 全文件公开（供 语义检查语句.cn / 语义检查尾.cn 消费）

不安全 函数 检查静态声明初值(向量<节点> 池, 节点 n,
                       向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    整64 声明类型ID = 0;
    如果 (n.附加 >= 0 && n.附加 < 池.大小()) {
        节点 声明类型节点 = 池.元素(整32(n.附加));
        声明类型ID = 整64(声明类型节点.文本);
    }
    // 031（#1075）：放置骨架——静态变量位方法值类型拒绝（R3 语法面·顶层/
    //   函数内静态双路径同本函数=单挂点·宿主 checkPlacement 同构·文案逐字）
    如果 (声明类型ID > 0 &&  // 静默豁免业务值: ID 存在性判据（0=未登记哨兵·ID 值域非负）
        是方法值类型文本(字符串复制(驻留文本(声明类型ID)))) {
        // 位置词按声明修饰区分（宿主 checkPlacement 位词逐字）：修饰==2=
        //   顶层裸全局（569）→「全局变量」；否则（顶层静态/函数内静态）→
        //   「静态变量」。
        字符串 放置位词 = "静态变量";
        如果 (n.修饰 == 2) { 放置位词 = "全局变量"; }
        表诊断(诊断, "[错误] " + 方法值放置文案1075(放置位词));  // 命名豁免规范编号: 1075=外部既有函数名（定义点在兄弟模块·基线在案·调用点搬移连带）
    }
    布尔 装箱语境位 = 假;
    如果 (n.子起点 < n.子终点 && 声明类型ID > 0 && 是结果类型_ID(声明类型ID)) {  // 静默豁免业务值: ID 存在性判据（0=未登记哨兵·ID 值域非负）
        // #1591：静态声明语境单点（与函数内声明位同口径）
        装箱语境位 = 设声明位语境1591(池, n, 声明类型ID);  // 命名豁免规范编号: 1591=外部既有函数名（定义点在兄弟模块·基线在案·调用点搬移连带）
    }
    // 2051：静态/顶层全局数组初始化列表=个数/维度校验（宿主 checkArrayInit
    //   ListDim 同语义·与局部声明面 546 挂点同函数同文案零分叉——解析放行后
    //   个数超长/维度不齐此前漏检面收口；语句趟+顶层趟双调=双态同覆盖）
    如果 (n.子起点 < n.子终点 && 声明类型ID > 0) {  // 静默豁免业务值: ID 存在性判据（0=未登记哨兵·ID 值域非负）
        节点 初末 = 池.元素(整32(整64(n.子终点) - 1));
        字符串 声明类型文本 = 字符串复制(驻留文本(声明类型ID));
        如果 (初末.类型 == 节点_数组初始化 && 是数组类型文本(声明类型文本)) {
            检查多维数组列表逐维(池, 整32(整64(n.子终点) - 1), 声明类型文本,
                                   符号表, 诊断);
        }
    }
    整64 遍历序 = 整64(n.子起点);
    当 (遍历序 < 整64(n.子终点)) {
        可选<整64> 忽略值 = 检查表达式(池, 整32(遍历序), 符号表, 诊断);
        遍历序++;
    }
    如果 (装箱语境位) { 设装箱语境884(0); }  // 命名豁免规范编号: 884=外部既有函数名（定义点在兄弟模块·基线在案·调用点搬移连带）
}

// 569 d 款（2026-10-14 用户裁决·001 §5.2a·constinit 思路）：顶层裸全局变量
//   （语法层 修饰=2 标记）初始化器仅限常量表达式——防初始化顺序 fiasco。
//   判据（与宿主 cnEvalConstExpr 面对齐·零分叉）：单节点字面量（整/浮/字符串/
//   布尔/字符）∨ 递归常量折叠（整域字面量/负号/五算术/移位 + 常量名标识符·
//   函数 裸全局初值可折叠 与 474 折叠子树值505 同构+常量名分支）∨
//   常量名标识符（表查找种类=符号_常量·全局层三级解析末级含跨模块导入常量）。
//   函数调用/构造调用/运行期表达式=编译错误（挂点=语义检查尾顶层遍历·
//   check 命令即拒·全局符号层可用保证常量已收集）。无初值=零初始化放行。
函数 裸全局初值常量性(向量<节点> 池, 节点 n,
                      向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    如果 (n.修饰 != 2) { 返回; }
    如果 (整64(n.子起点) >= 整64(n.子终点)) { 返回; }
    // 2051：数组初始化列表形态=逐元素常量性校验（多维嵌套递归展开·宿主
    //   cnIsConstArrayInitList 同语义——列表本身不进标量折叠判定，任一元素
    //   非常量=编译期拒同文案）
    //   列表根=初值区间**末节点**（解析数组初始化列表 861 池布局=[元素子树
    //   们..., 元素包装们..., 封口]·与 843 初末取法同构——子起点=首个元素子树
    //   非封口）。列表形态池区间=元素子树+包装+封口多节点（变量源=单节点）
    //   ——条件只看末节点类型不限区间长。
    如果 (整64(n.子终点) > 整64(n.子起点)) {
        节点 初元素根 = 池.元素(整32(整64(n.子终点) - 1));
        如果 (初元素根.类型 == 节点_数组初始化) {
            如果 (!列表全常量(池, 整32(整64(n.子终点) - 1), 符号表, 0)) {
                表诊断(诊断, "[错误] 顶层全局变量 '" +
                             字符串复制(驻留文本(整64(n.文本))) +
                             "' 初始值必须是常量表达式（字面量/常量引用/常量算术——001 §5.2a " +
                             "防初始化顺序问题；运行期初始化请改用 静态 或在函数内赋值）");
            }
            返回;
        }
    }
    // 单节点形态：字面量直过；常量名引用按种类判
    如果 (整64(n.子终点) - 整64(n.子起点) == 1) {
        节点 折叠值 = 池.元素(整32(n.子起点));
        如果 (折叠值.类型 == 节点_整数字面量 || 折叠值.类型 == 节点_浮点字面量 ||
             折叠值.类型 == 节点_字符串字面量 || 折叠值.类型 == 节点_布尔字面量 ||
             折叠值.类型 == 节点_字符字面量) { 返回; }
        可选<整64> 折叠种类查 = 表查找种类(符号表, 整64(折叠值.文本));
        如果 (折叠值.类型 == 节点_标识符) {
            如果 (折叠种类查.有值) {
                整64 折叠种类 = 折叠种类查.值;
                如果 (折叠种类 == 符号_常量) { 返回; }
            }
        }
    }
    // 递归折叠可判（整域：字面量/常量名/负号/五算术/移位）
    整64 折折叠值 = 0;
    如果 (裸全局初值可折叠(池, 整32(整64(n.子终点) - 1), 符号表, 折折叠值, 0, 真)) { 返回; }
    表诊断(诊断, "[错误] 顶层全局变量 '" + 字符串复制(驻留文本(整64(n.文本))) +
                 "' 初始值必须是常量表达式（字面量/常量引用/常量算术——001 §5.2a " +
                 "防初始化顺序问题；运行期初始化请改用 静态 或在函数内赋值）");
}

// 2051：数组初始化列表全元素常量性递归判定（宿主 cnFoldArrayInitListTexts
//   同语义零分叉）——元素根=嵌套列表→递归；字面量/常量名/常量算术→
//   裸全局初值可折叠 单元素判定；其余（调用/运行期）=假。
函数 列表全常量(向量<节点> 池, 整32 列表索引,
                   向量<映射<整64, 符号>>& 符号表, 整32 深度) -> 布尔 {
    如果 (深度 > 64 || 列表索引 <= 0 || 列表索引 >= 整32(池.大小())) { 返回 假; }  // 静默豁免业务值: 递归深度安全阀（下界由递归结构保证·非业务区间枚举面）
    节点 列表节点 = 池.元素(列表索引);
    如果 (列表节点.类型 != 节点_数组初始化) { 返回 假; }
    // 812 两遍法收集顶层包装（池区间=元素子树+包装交替·线性扫会撞元素子树
    //   节点——与 语义检查初始化数组.cn 同一单一实现·禁闭眼重写）
    向量<整64> 顶层包装们 = 收集顶层包装们(池, 整64(列表节点.子起点),
                                                整64(列表节点.子终点));
    整64 遍序 = 0;
    当 (遍序 < 顶层包装们.大小()) {
        节点 元素包装 = 池.元素(整32(顶层包装们.元素(整32(遍序))));
        整64 元素根索引 = 整64(元素包装.子终点) - 1;
        节点 元素根 = 池.元素(整32(元素根索引));
        布尔 元素是列表 = (元素根.类型 == 节点_数组初始化);
        如果 (元素是列表) {
            // 嵌套列表：递归下一维
            如果 (!列表全常量(池, 整32(元素根索引), 符号表, 深度 + 1)) {  // 静默豁免业务值: 否定回答=不可折叠/未登记业务结果（调用方分流注入/守卫通道·非静默默认值继续）
                返回 假;
            }
        }
        如果 (!元素是列表) {
            // 标量元素：单元素常量折叠判定（569 既有递归·字面量/常量名/算术）
            整64 元素值 = 0;
            如果 (!裸全局初值可折叠(池, 整32(元素根索引), 符号表,
                                        元素值, 深度 + 1, 真)) {
                返回 假;
            }
        }
        遍序++;
    }
    返回 真;
}

// 569：初始化器递归常量折叠判定（474 折叠子树值505 同构+常量名标识符分支——
//   505 只认纯字面量子树，`系数 * 2 + 1` 常量名参与算术形态由本函数承载；
//   后缀序契约同 505：负号操作数根=自身索引-1、二元右根=自身-1·左根=附加-1）
函数 裸全局初值可折叠(向量<节点> 池, 整32 根索引,
                      向量<映射<整64, 符号>>& 符号表, 整64& 值, 整32 深度,
                      布尔 纯负链) -> 布尔 {
    如果 (深度 > 64 || 根索引 <= 0 || 根索引 >= 整32(池.大小())) { 返回 假; }  // 静默豁免业务值: 递归深度安全阀（下界由递归结构保证·非业务区间枚举面）
    节点 折叠根节点 = 池.元素(根索引);
    // 叶：整数字面量（取常量下标值 单点解析·含巨字面量保护——505 同源）
    如果 (折叠根节点.类型 == 节点_整数字面量) {
        返回 取常量下标值(池, 根索引, 根索引 + 1, 值);
    }
    // 叶：常量名标识符（表查找种类 三级解析末级·跨模块导入常量可判）
    如果 (折叠根节点.类型 == 节点_标识符) {
        可选<整64> 根种类查 = 表查找种类(符号表, 整64(折叠根节点.文本));
        // miss（原 -1 哨兵）≠ 符号_常量 → 非常量叶（显式默认）
        布尔 根是常量 = 假;
        如果 (根种类查.有值) { 根是常量 = 根种类查.值 == 符号_常量; }
        如果 (!根种类查.有值 || !根是常量) { 返回 假; }
        // 常量值=类型ID 记 名ID 惯例（收集常量声明 953 口径）——值文本经
        // IR 常量表，语义期只判「是常量」即放行（值正确性由 IR 折叠保证）
        值 = 1;
        返回 真;
    }
    // 一元负：操作数根=自身索引-1（子终点=自身索引·解析契约；同 505）
    如果 (折叠根节点.类型 == 节点_负号) {
        整64 折叠操作数 = 0;
        如果 (折叠根节点.子起点 <= 0 || 折叠根节点.子终点 != 根索引 ||  // 静默豁免业务值: 搬移既有面（锚随代码搬移·原文件基线放行·2051 拆分连带）
             !裸全局初值可折叠(池, 根索引 - 1, 符号表, 折叠操作数, 深度 + 1, 纯负链)) {
            // 790/1016（569 采样轮 H1 对齐·探针实锚）：int64 最小界特例——子叶
            //   magnitude 恰 2^63 时递归单节点窗按 int64 正上界承载失败（宿主
            //   文本保真放行）。把 [操作数, 负号] 两节点窗交 取常量下标值 负号
            //   通道单点判定（790 十进制 9223372036854775808；1016 扩全进制
            //   hex 8000000000000000／oct 1+21 零／bin 1+63 零→INT64_MIN——十六
            //   进制裸全局 -0x8000000000000000 原误拒 rc=1 实锚）。单一真源=
            //   不在此重复文本比对（防两处判据分叉）。
            如果 (取常量下标值(池, 根索引 - 1, 根索引 + 1, 值)) { 返回 真; }
            // 1016（三轮审查 P1-1）：128 槽负号巨字面量（-0xFFFFFFFFFFFFFFFF
            //   等）常量性放行——仅限**纯负号链**（初始化器根=负号链起点；
            //   负号递归继承标志、二元操作数递归清除）。二元表达式内的负号
            //   子节点回父提交行为=拒（-0xFFFFFFFFFFFFFFFF - 1 宿主 1/v2 曾
            //   误放行 0）；-(-0xFFFFFFFFFFFFFFFF) 纯负链=放行（宿主 0）。
            如果 (纯负链 && 负号巨字面量常量1016(池, 整32(根索引 - 1))) {  // 命名豁免规范编号: 1016=外部既有函数名（定义点在兄弟模块·基线在案·调用点搬移连带）
                值 = 0;
                返回 真;
            }
            返回 假;
        }
        值 = 位模式取负474(折叠操作数);  // 命名豁免规范编号: 474=外部既有函数名（定义点=协议常量包·基线在案·调用点搬移连带）
        返回 真;
    }
    // 普通二元（子终点恒 0 与短路区分）：右子树根=自身-1、左子树根=附加-1（同 505）
    如果 (折叠根节点.类型 == 节点_二元运算 && 折叠根节点.子终点 == 0) {
        字符串 折叠操作符 = 字符串复制(驻留文本(整64(折叠根节点.文本)));
        布尔 是折叠符 = 字符串比较(折叠操作符, "+") || 字符串比较(折叠操作符, "-") ||
                        字符串比较(折叠操作符, "*") || 字符串比较(折叠操作符, "/") ||
                        字符串比较(折叠操作符, "%") || 字符串比较(折叠操作符, "<<") ||
                        字符串比较(折叠操作符, ">>");
        如果 (!是折叠符) { 返回 假; }  // 静默豁免业务值: 否定回答=不可折叠/未登记业务结果（调用方分流注入/守卫通道·非静默默认值继续）
        整64 左折叠值 = 0;
        整64 右折叠值 = 0;
        如果 (折叠根节点.附加 <= 0 || 折叠根节点.附加 >= 整64(根索引)) { 返回 假; }
        如果 (!裸全局初值可折叠(池, 整32(折叠根节点.附加) - 1, 符号表, 左折叠值,
                                深度 + 1, 假)) { 返回 假; }
        如果 (!裸全局初值可折叠(池, 根索引 - 1, 符号表, 右折叠值, 深度 + 1, 假)) { 返回 假; }  // 静默豁免业务值: 否定回答=不可折叠/未登记业务结果（调用方分流注入/守卫通道·非静默默认值继续）
        返回 折叠二元应用505(折叠操作符, 左折叠值, 右折叠值, 值);  // 命名豁免规范编号: 505=外部既有函数名（定义点在兄弟模块·基线在案·调用点搬移连带）
    }
    返回 假;
}
