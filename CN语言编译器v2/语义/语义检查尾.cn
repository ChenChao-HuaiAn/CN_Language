// 语义检查尾（357 重构F2 自 语义检查.cn 纯机械搬移·函数体逐字保留·零逻辑变化）

导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（原 导入 语法分析，目录包名）
导入 IR;         // 容器/结果 合成名判定 + 节点_*/键位移 常量（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 借出检查;    // 第七十七轮 A21：借出视图生命周期检查（函数级调用）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

函数 检查选择(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    节点 选择节点 = 池.元素(节点索引);
    // 选择值表达式区间
    整64 值i = 整64(选择节点.文本);
    当 (值i < 整64(选择节点.附加)) {
        整64 忽略s = 检查表达式(池, 整32(值i), 符号表, 诊断);
        如果 (忽略s == -1) { }
        值i++;
    }
    // 情况段：值表达式 + 体块（新作用域·检查块 递归）
    // 657-a（02_control 阻塞面真根因·机制级）：**类型过滤=节点_情况标签**——
    //   情况段区间 [子起点,子终点) 含情况值表达式/体语句/体块/标签全部节点
    //   （解析层子起点=吃 `{` 后池位置·值与体语句在标签前入池·413-a 设计如此，
    //   生成层 生成语句.cn 两处消费点均有同款过滤）——原实现无过滤把区间内
    //   任意「子起≠0」节点当情况节点：如果/当节点字段 [文本,附加)=[条件区+真块]
    //   被整体当「值表达式区间」在**外层作用域**检查（嵌套块局部声明伪报
    //   「未声明标识符」·探针 p2/p2b 实锤·02_control 第 7 段正中）。
    // 982 转移集分支合流（宿主 980 visitSwitchStmt 同构）：情况 支互斥——各支
    //   从入口态出发（标记不跨支泄漏）·终态 may 并集；有 默认 支=必走恰好一支
    //   →合流=支终态并集；无 默认=可能零支执行→入口态∪支终态（保守 may）。
    整64 转移基线sw = 转移快照压();
    整64 转移合并sw = 转移快照压();   // 空段=支终态累积区（最顶层·段吸安全）
    布尔 有默认sw = 假;
    整64 况预sw = 整64(选择节点.子起点);
    当 (况预sw < 整64(选择节点.子终点)) {
        节点 情况预sw = 池.元素(整32(况预sw));
        如果 (情况预sw.类型 == 节点_情况标签 && 情况预sw.子起点 == 0) { 有默认sw = 真; }
        况预sw++;
    }
    整64 况i = 整64(选择节点.子起点);
    当 (况i < 整64(选择节点.子终点)) {
        节点 情况节点 = 池.元素(整32(况i));
        如果 (情况节点.类型 == 节点_情况标签) {
            // 情况值表达式区间（默认=空值区间 [0,0) 自然空转）
            如果 (情况节点.子起点 != 0) {
                整64 况值i = 整64(情况节点.文本);
                当 (况值i < 整64(情况节点.附加)) {
                    // 958（002·63/66 族）：情况位裸枚举成员名（情况 红:）——
                    //   宿主 C-4 按选择条件枚举类型定向解析；v2 简化为裸名
                    //   直查枚举成员表（单枚举场景等价·跨枚举同名冲突=诚实
                    //   边界登记§2.216）——命中则当常量放行不报未声明
                    节点 况值节点958 = 池.元素(整32(况值i));
                    布尔 裸枚举958 = 假;
                    如果 (况值节点958.类型 == 节点_标识符 &&
                         查枚举成员裸名值958(整64(况值节点958.文本)) >= 0) {
                        裸枚举958 = 真;
                    }
                    如果 (!裸枚举958) {
                        整64 忽略c = 检查表达式(池, 整32(况值i), 符号表, 诊断);
                        如果 (忽略c == -1) { }
                    }
                    况值i++;
                }
            }
            转移恢复到(符号表, 转移基线sw);
            检查块(池, 整32(情况节点.子起点), 符号表, 诊断);
            转移段吸(转移合并sw);
        }
        况i++;
    }
    // 982：有 默认=必走恰好一支→恢复=支终态并集；无 默认=入口态∪支终态
    如果 (有默认sw) {
        转移恢复到(符号表, 转移合并sw);
    } 否则 {
        转移恢复到(符号表, 转移基线sw);
        转移并入(符号表, 转移合并sw);
    }
    转移弹栈清(转移基线sw);
}

// 检查如果语句：条件表达式 + 真块（新作用域）+ 否则链（否则 如果 递归）
// 1028（#045 切片1·规则3 检查状态机·宿主 checkResultMember/isChecked 同构）：
//   纯 `X.正常` 条件 → 真块内 X.值 合法/紧邻 否则 块内 X.错误 合法——打标/
//   清标夹真块与否则块检查（宿主 visitIfStmt 进打离清同口径）。内联 && 组合
//   形态不跟踪（宿主 231 同界）；嵌套块继承标记（宿主同款·v2 树 601 嵌套
//   固化形态存量已核）。形态存量零自举风险：宿主规则3 已启用+全量绿=树内
//   形态已预筛。
静态 映射<整64, 整64> 结果已查标记们;   // 变量名ID -> 类别ID（驻留("正常")/驻留("错误")）

函数 标记结果已查(整64 名ID, 整64 类别ID) -> 空类型 {
    如果 (名ID == 0) { 返回; }
    结果<空类型, 整32> 设 = 结果已查标记们.设置(名ID, 类别ID);
    如果 (!设.正常) { 运行时错误(4); }
}

函数 清除结果已查(整64 名ID) -> 空类型 {
    如果 (名ID == 0) { 返回; }
    布尔 删 = 结果已查标记们.删除(名ID);   // 映射.删除 返回 布尔（键不在=假·无害）
    如果 (删) { }
}

// 查已查类别（0=无标记；驻留("正常")/驻留("错误")）
函数 查结果已查(整64 名ID) -> 整64 {
    如果 (名ID == 0) { 返回 0; }
    结果<整64, 整32> 查 = 结果已查标记们.获取(名ID);
    如果 (查.正常) { 返回 查.值; }
    返回 0;
}

// 045b（丙案·2026-10-05·宿主 trackIfCheck/574-a/objectVarName 守卫族同构）：
//   条件守卫形态识别（只读结构·不检查表达式）——三形态：
//   ①末节点=成员(X.正常/X.有值·对象=标识符) 纯守卫
//   ②末节点=逻辑非 且操作数末=①（!X.正常 取反守卫）
//   ③末节点=短路 && 且左操作数末=①或②（X.正常 && RHS / !X.正常 && RHS）
//   出参：守卫名ID（0=未识别）、类别ID（正常/有值）、取反（0/1）、短路（0/1）。
//   不安全=指针出参下标写（检查语句 同款先例·零运行期检查边界）。
不安全 函数 识别条件守卫单(向量<节点> 池, 整32 节点索引, 整64* 名ID, 整64* 类别ID, 整64* 取反) -> 布尔 {
    节点 n = 池.元素(节点索引);
    如果 (n.类型 == 节点_成员 && n.子起点 > 0 &&
         整64(n.子起点) < 池.大小()) {
        节点 对象 = 池.元素(整32(n.子起点));
        如果 (对象.类型 == 节点_标识符) {
            整64 成员名 = 整64(n.文本);
            如果 (成员名 == 整64(驻留("正常"))) {
                名ID[0] = 整64(对象.文本); 类别ID[0] = 驻留("正常"); 取反[0] = 0;
                返回 真;
            }
            如果 (成员名 == 整64(驻留("有值"))) {
                名ID[0] = 整64(对象.文本); 类别ID[0] = 驻留("有值"); 取反[0] = 0;
                返回 真;
            }
        }
        返回 假;
    }
    如果 (n.类型 == 节点_逻辑非 && n.子终点 > n.子起点 &&
         n.子起点 > 0 && 整64(n.子终点) <= 池.大小()) {
        // 逻辑非：[子起点, 子终点) 为操作数区间——操作数末=子终点-1
        布尔 内 = 识别条件守卫单(池, 整32(n.子终点 - 1), 名ID, 类别ID, 取反);
        如果 (内) { 取反[0] = 1; }
        返回 内;
    }
    返回 假;
}

// 守卫识别入口（条件末节点）：纯守卫/取反守卫/短路守卫（&& 左守卫·574-a）
不安全 函数 识别条件守卫(向量<节点> 池, 整64 条件终点, 整64* 名ID, 整64* 类别ID,
                  整64* 取反, 整64* 短路) -> 布尔 {
    名ID[0] = 0; 类别ID[0] = 0; 取反[0] = 0; 短路[0] = 0;
    如果 (条件终点 <= 0) { 返回 假; }
    节点 末 = 池.元素(整32(条件终点 - 1));
    // 短路 &&（574-a）：子起点=左操作数起点、附加=右操作数起点——左末=附加-1
    如果 (末.类型 == 节点_二元运算 && 整64(末.文本) == 整64(驻留("&&")) &&
         末.附加 > 末.子起点 && 末.附加 > 0) {
        布尔 左 = 识别条件守卫单(池, 整32(末.附加 - 1), 名ID, 类别ID, 取反);
        如果 (左) { 短路[0] = 1; 返回 真; }
        返回 假;
    }
    返回 识别条件守卫单(池, 整32(条件终点 - 1), 名ID, 类别ID, 取反);
}

// 守卫打标类别推导（宿主 trackIfCheck/574-a 语义表·045b）：
//   真语境标（0=无标）：结果正常非取反=正常/取反=错误；可选非取反=有值/取反=无；
//   短路款=同真语境标（宿主 574-a kind 传导右侧与 then）。
//   否则语境标（0=无标）：结果正常非取反=错误/取反=正常；可选非取反=无/取反=有值；
//   短路款=无标（宿主 574-a else 不打标）。
函数 守卫真语境标(整64 类别ID, 整64 取反, 整64 短路) -> 整64 {
    如果 (类别ID == 整64(驻留("正常"))) {
        如果 (取反 != 0) { 返回 驻留("错误"); }
        返回 驻留("正常");
    }
    如果 (类别ID == 整64(驻留("有值")) && 取反 == 0) {
        返回 驻留("有值");
    }
    返回 0;   // 可选取反款=真分支无成员可访问（宿主同款）；短路旗不影响类别
}

函数 守卫否则语境标(整64 类别ID, 整64 取反, 整64 短路) -> 整64 {
    如果 (短路 != 0) { 返回 0; }
    如果 (类别ID == 整64(驻留("正常"))) {
        如果 (取反 != 0) { 返回 驻留("正常"); }
        返回 驻留("错误");
    }
    如果 (类别ID == 整64(驻留("有值")) && 取反 != 0) {
        返回 驻留("有值");
    }
    返回 0;
}

函数 检查如果(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    节点 如果节点 = 池.元素(节点索引);
    设当前诊断行(如果节点.行);   // 045b：本语句级诊断锚行（规则2/规则3 行号准确）
    // 节点字段：文本=条件起点，子起点=条件终点，附加=真块索引，子终点=否则索引
    整64 条件起点 = 整64(如果节点.文本);
    整64 条件终点 = 整64(如果节点.子起点);
    // 045b（丙案）：守卫识别先行（宿主 trackIfCheck 时序同构）——打标后条件区
    //   与真块同在标记语境内检查（短路右侧 .值/真块内 .值/.错误 依赖此序；
    //   原时序=条件区先查后打标=条件位 .值 恒 miss）。守卫成员读取（.正常/.有值）
    //   本身即检查（检查点不拦），标只服务 .值/.错误 访问。
    整64 守卫名 = 0;
    整64 守卫类别 = 0;
    整64 守卫取反 = 0;
    整64 守卫短路 = 0;
    布尔 有守卫 = 识别条件守卫(池, 条件终点, &守卫名, &守卫类别, &守卫取反, &守卫短路);
    整64 真语境标 = 0;
    如果 (有守卫) { 真语境标 = 守卫真语境标(守卫类别, 守卫取反, 守卫短路); }
    如果 (真语境标 != 0) { 标记结果已查(守卫名, 真语境标); }
    整64 i = 条件起点;
    当 (i < 条件终点) {
        整64 忽略 = 检查表达式(池, 整32(i), 符号表, 诊断);
        如果 (忽略 == -1) { }
        i++;
    }
    // 329-a（D38 批2·341）：条件严格布尔检查——宿主 t06/t07/t08 实测整/浮条件
    //   均拒（C 风格非零真不适用 CN）；比较/短路二元与 逻辑非/布尔字面量/布尔
    //   类型放行；检不出形态放行=诚实边界。
    如果 (条件终点 > 条件起点) {
        检查条件布尔(池, 整32(条件终点 - 1), "如果", 符号表, 诊断);
    }
    // 010（def-init）：分支状态传播——基线压栈→真支→快照→恢复基线→否则支→
    //   并集归并（must analysis·宿主 defInitCheckIf 同构）；无否则=恢复进入态
    // 636-a 重构：快照走静态备份区+层号（原 向量<整64> 按值传参=v2 句柄
    //   语义下实参悬垂 UAF·cn_self fix_s 段错误根因——详 语义检查初始化.cn 头）
    整64 状态基线i = 状态压栈();
    // 982 转移集分支合流（宿主 980 scopeMoved_ 同构）：真支从入口态出发
    整64 转移基线m = 转移快照压();
    检查块(池, 整32(如果节点.附加), 符号表, 诊断);
    如果 (真语境标 != 0) { 清除结果已查(守卫名); }
    整64 真支后i = 状态压栈();
    // 982：真支终态快照+恢复入口态（标记不泄漏给否则支——886 假阳性根治）
    整64 转移真支后m = 转移快照压();
    转移恢复到(符号表, 转移基线m);
    // 否则链：子终点=否则节点索引（0=无；嵌套 否则 如果 亦为 节点_如果语句）
    整64 否则索引 = 如果节点.子终点;
    如果 (否则索引 != 0) {
        节点 否则节点 = 池.元素(整32(否则索引));
        // 045b（丙案）：否则语境标（宿主 trackIfCheck else 分支同构——嵌套
        //   否则 如果 支亦在标语境内递归：宿主 markChecked 后 checkStmt
        //   (elseBranch)，elseBranch=IfStmt 时嵌套条件/块同享错误标）
        整64 否则语境标 = 0;
        如果 (有守卫) { 否则语境标 = 守卫否则语境标(守卫类别, 守卫取反, 守卫短路); }
        如果 (否则语境标 != 0) { 标记结果已查(守卫名, 否则语境标); }
        如果 (否则节点.类型 == 节点_如果语句) {
            检查如果(池, 整32(否则索引), 符号表, 诊断);
        } 否则 {
            检查块(池, 整32(否则索引), 符号表, 诊断);
        }
        如果 (否则语境标 != 0) { 清除结果已查(守卫名); }
        // 010：终止支豁免+并集归并（宿主 stmtGuaranteesReturn 同构）——
        //   终止支的出口状态不参与汇合约束（路径不可达）
        布尔 真支终止i = 状态必然返回(池, 整32(如果节点.附加));
        布尔 否则终止i = 状态必然返回(池, 整32(否则索引));
        如果 (真支终止i && 否则终止i) {
            状态恢复到(状态基线i);
        } 否则 如果 (否则终止i) {
            状态恢复到(真支后i);
        } 否则 如果 (!真支终止i) {
            状态归并到(真支后i);
        }
        // 真支终止且否则未终止：静态表当前=否则支后 ✓ 无操作
        // 982 转移集同构三分支（may 合流：任一路径转移即转移·当前=否则后活集）
        如果 (真支终止i && 否则终止i) {
            转移恢复到(符号表, 转移基线m);
        } 否则 如果 (否则终止i) {
            转移恢复到(符号表, 转移真支后m);
        } 否则 如果 (!真支终止i) {
            转移并入(符号表, 转移真支后m);
        }
        // 真支终止且否则未终止：转移集当前=否则支后 ✓ 无操作
    } 否则 {
        // 045b（丙案·001 §07 规则2）：检查 结果.正常 后未处理错误分支 → 警告
        //   （宿主 trackIfCheck Warning 同构——stderr 不进诊断计数=编译继续；
        //   仅纯守卫正常款非取反·短路/取反/可选款无此警告·宿主同款）
        如果 (有守卫 && 守卫短路 == 0 && 守卫取反 == 0 &&
             守卫类别 == 整64(驻留("正常"))) {
            IO::打印到错误("[警告] 行 " + 整数转字符串(整64(取当前诊断行())) +
                           ": 检查 结果.正常 后未处理错误分支（缺少 否则 { 处理 结果.错误 }）");
        }
    }
    // 982：无否则分支=真支已恢复入口态 ✓（与 def-init「置位不外溢」同口径）
    转移弹栈清(转移基线m);
    状态弹栈清(状态基线i);   // 636-a：本如果快照全弃（嵌套残留同截兜底）
}

// 检查当语句：条件表达式 + 循环体块（新作用域）
函数 检查当(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    节点 当节点 = 池.元素(节点索引);
    // 节点字段：文本=条件起点，子起点=条件终点，附加=体块索引
    整64 条件起点 = 整64(当节点.文本);
    整64 条件终点 = 整64(当节点.子起点);
    整64 i = 条件起点;
    当 (i < 条件终点) {
        整64 忽略 = 检查表达式(池, 整32(i), 符号表, 诊断);
        如果 (忽略 == -1) { }
        i++;
    }
    // 329-a（D38 批2·341）：当条件严格布尔检查（宿主 t07 实测·与 如果 同款）
    如果 (条件终点 > 条件起点) {
        检查条件布尔(池, 整32(条件终点 - 1), "当", 符号表, 诊断);
    }
    // 010（def-init）：循环体状态不外溢（可能 0 次+回边保守）——636-a 压栈形态
    整64 当基线 = 状态压栈();
    检查块(池, 整32(当节点.附加), 符号表, 诊断);
    状态恢复到(当基线);
    状态弹栈清(当基线);   // 636-a：快照收尾
}

// 357-a（D39）：三段式循环检查——init 段语句（循环头作用域：声明随循环）、
//   cond 表达式+严格布尔、step 表达式、体块（新作用域递归）。节点字段：
//   文本=init 起点、子起点=cond 起点、子终点=step 起点、附加=体块索引
//   （step 包装=附加-1 的 节点_表达式语句）。
函数 检查循环(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    // 循环头作用域（init 声明随循环）
    表压入(符号表);
    节点 循环节点 = 池.元素(节点索引);
    // init 段：语句根逐条（声明登记/赋值/表达式）
    整64 i = 整64(循环节点.文本);
    当 (i < 整64(循环节点.子起点)) {
        节点 子 = 池.元素(整32(i));
        如果 (子.类型 == 节点_变量声明 || 子.类型 == 节点_赋值 || 子.类型 == 节点_自增 ||
             子.类型 == 节点_自减 || 子.类型 == 节点_表达式语句 ||
             子.类型 == 节点_返回语句 || 子.类型 == 节点_中断语句 || 子.类型 == 节点_继续语句) {
            检查语句(池, 整32(i), 符号表, 诊断);
        }
        i++;
    }
    // cond 段：表达式检查+严格布尔
    i = 整64(循环节点.子起点);
    当 (i < 整64(循环节点.子终点)) {
        整64 忽略 = 检查表达式(池, 整32(i), 符号表, 诊断);
        如果 (忽略 == -1) { }
        i++;
    }
    如果 (循环节点.子终点 > 循环节点.子起点) {
        检查条件布尔(池, 整32(循环节点.子终点 - 1), "循环", 符号表, 诊断);
    }
    // step 段：语句根/表达式逐节点检查（区间 [子终点, 体块节点.子起点)——
    //   块节点在体子语句后追加·step 终点须读块节点字段）
    节点 循环体块 = 池.元素(整32(循环节点.附加));
    i = 整64(循环节点.子终点);
    当 (i < 整64(循环体块.子起点)) {
        节点 步进节点 = 池.元素(整32(i));
        如果 (步进节点.类型 == 节点_自增 || 步进节点.类型 == 节点_自减 ||
             步进节点.类型 == 节点_赋值 || 步进节点.类型 == 节点_表达式语句) {
            检查语句(池, 整32(i), 符号表, 诊断);
        } 否则 {
            整64 忽略 = 检查表达式(池, 整32(i), 符号表, 诊断);
            如果 (忽略 == -1) { }
        }
        i++;
    }
    // 体块（新作用域递归）——010（def-init）：循环体状态不外溢——636-a 压栈形态
    整64 循环基线 = 状态压栈();
    检查块(池, 整32(循环节点.附加), 符号表, 诊断);
    状态恢复到(循环基线);
    状态弹栈清(循环基线);   // 636-a：快照收尾
    表弹出(符号表);
}

// 函数参数登记（第七十八轮 类支持 R3 提取：检查函数/检查方法 两类作用域单元
//   共用）——参数类型归一 + 类型引用诊断 + 指针/引用参数收集 + 符号注册。
//   自 检查函数 机械搬移（行为零变化）。
函数 登记函数参数们(向量<节点> 池, 整32 函数节点, 向量<映射<整64, 符号>>& 符号表,
                     向量<字符串>& 诊断) -> 空类型 {
    节点 函数体 = 池.元素(函数节点);
    整64 i = 整64(函数体.子起点);
    当 (i < 整64(函数体.子终点)) {
        节点 参数 = 池.元素(整32(i));
        如果 (参数.类型 == 节点_参数) {
            // ③ 第二波（方案A）：参数 类型ID 同样归一为类型名ID（统一符号约定）
            整64 参数类型ID = 整64(参数.附加);
            如果 (参数类型ID >= 0 && 参数类型ID < 池.大小()) {
                节点 参数类型节点值 = 池.元素(整32(参数类型ID));
                如果 (参数类型节点值.类型 == 节点_类型) {
                    参数类型ID = 整64(参数类型节点值.文本);
                    // 477-a（D10 波2）：重放环境映射——T 参数→实参类型（体内
                    //   源 的运算/传递落真实类型）
                    如果 (泛型重放环境.大小() > 0) {
                        整64 映射参数477 = 查重放环境(参数类型ID);
                        如果 (映射参数477 != 0) { 参数类型ID = 映射参数477; }
                    }
                    // plans/018 类型分桶：参数类型存在性/公开性/歧义诊断（fail fast）
                    检查类型引用(符号表, 诊断, 参数类型ID);
                    // ③ 第三波：指针参数登记（附加=指针层数 1..255；引用 >=256 不入）
                    如果 (参数类型节点值.附加 >= 1 && 参数类型节点值.附加 < 256) {
                        登记语义指针变量(整64(参数.文本), 参数类型ID);
                    }
                    // 087b（#087 余量·宿主 82984e4bbe 同构）：数组形参——语义
                    //   指针表登记**元素类型**（94-a 局部数组同款：数组名退化为
                    //   元素指针。下标检查 94-a 数组感知分支经 符号表数组全文
                    //   类型判定（表注册已登记参数类型全文）→114 编译期越界/115
                    //   常量下标免费复用；无此登记=查语义指针变量 miss→落普通
                    //   类型分支→「下标对象须为字符串或指针」误拒（p1004_02
                    //   v2 面实录——宿主支持/v2 拒=功能分叉，零分叉红线对齐）。
                    如果 (参数类型节点值.附加 == 0) {
                        字符串 参数文本087b = 字符串复制(驻留文本(参数类型ID));
                        如果 (是数组类型文本(参数文本087b)) {
                            字符串 元素087b = 数组元素文本(参数文本087b);
                            如果 (字符串长度(元素087b) > 0) {
                                登记语义指针变量(整64(参数.文本),
                                                 驻留(元素087b));
                            }
                        }
                    }
                    // plans/019 阶段2：引用参数收集（附加==256）
                    如果 (参数类型节点值.附加 == 256) {
                        结果<空类型, 整32> 加引用参数 = 当前函数引用参数们.追加(整64(参数.文本));
                        如果 (!加引用参数.正常) { 运行时错误(4); }
                    }
                    // plans/019 阶段3：常量（只读）引用参数收集（附加==257——
                    //   解析参数 常量 前缀改标）
                    如果 (参数类型节点值.附加 == 257) {
                        结果<空类型, 整32> 加常量引用 = 当前函数常量引用们.追加(整64(参数.文本));
                        如果 (!加常量引用.正常) { 运行时错误(4); }
                    }
                }
            }
            整64 忽略 = 表注册(符号表, 整64(参数.文本), 参数类型ID, 符号_参数, 0);
            如果 (忽略 == 0) { }
        }
        i++;
    }
}

// 检查函数：函数作用域（参数 + 函数体）
不安全 函数 检查函数(向量<节点> 池, 整32 函数节点, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    清空语义指针变量表();  // ③ 第三波：函数级生命周期
    清空恒空表();          // 188-a（D6）：函数级恒空判定表同款（函数间互不污染）
    状态清空表();          // 010（def-init）：初始化状态表函数级清空（参数=已初始化）
    转移活跃清空();        // 982/985：转移活跃集镜像函数级清空（跨函数残留污染同名变量分支合流·9 假阳性根因）
    表压入(符号表);
    节点 函数体 = 池.元素(函数节点);
    // 477-a（D10 波2）：重放环境映射——T 返回类型→实参类型（返回比对落真实
    //   类型·p2' 实弹=「返回 "文本"; vs T=整32」编译期拒绝）；非重放路径环境
    //   恒空=直通。
    整64 返回类型ID477 = 整64(函数体.附加);
    如果 (泛型重放环境.大小() > 0) {
        整64 映射返回477 = 查重放环境(返回类型ID477);
        如果 (映射返回477 != 0) { 返回类型ID477 = 映射返回477; }
    }
    当前函数返回类型 = 返回类型ID477;  // 55-c：返回面混合符号检查取类型用
    当前函数不安全 = (函数体.修饰 % 2 == 1);   // 153-a：不安全修饰（位 0·9 类挂点豁免·575-a 位掩码兼容）
    设当前语义函数名(整64(函数体.文本));   // 070 波H：友元豁免判定上下文
    清空当前引用参数();
    登记函数参数们(池, 函数节点, 符号表, 诊断);
    如果 (整64(函数体.子终点) < 池.大小()) {
        检查块(池, 函数体.子终点, 符号表, 诊断);
    }
    // 188-a（D6 B11 变量常量传播）：函数体检查收尾统一判定（恒空指针使用点报硬
    //   错误）——须在体块检查之后（全函数视角的不动点判定）
    判定恒空报错(诊断);
    // 第七十七轮（A21，plans/020 矩阵 A21 格靶子）：借出视图生命周期检查——
    //   字符串元素容器借出视图（元素/读取/栈顶/队首/头部元素/读取头部/读取尾部/
    //   获取）在容器失效点/容器先亡之后仍被使用=悬垂（NLL 顺序近似；宿主
    //   semantic_borrowview.cpp 同款——移植纪律 10 两侧同缺一次修全）。
    //   在体块检查后调用（独立节点扫描，不依赖符号表时刻状态）。
    检查借出视图生命周期(池, 函数节点, 符号表, 诊断);
    当前函数返回类型 = 0 - 1;  // 55-c：函数检查结束复位（防跨函数污染）
    当前函数不安全 = 假;        // 153-a：修饰标志复位（防跨函数污染）
    清空当前引用参数();
    表弹出(符号表);
    设当前语义函数名(0);
}

// ==================== 主流程 ====================
// 输入节点池+程序根；输出诊断列表；返回 错误数
// 单文件 = 主模块形态包装（键基=纯名、无导入——行为与分桶前逐字节一致；
//   主.cn 负测自检序列沿用本入口）。快照参数传空平铺（标量向量局部构造——
//   成熟路径；嵌套容器/临时值追加禁用，lessons 15 枚同族）
函数 语义分析(向量<节点> 池, 整32 程序节点, 向量<字符串>& 诊断) -> 整64 {
    向量<整32> 单节点们 = 向量<整32>();
    结果<空类型, 整32> 加n = 单节点们.追加(程序节点);
    如果 (!加n.正常) { 运行时错误(4); }
    向量<字符串> 单路径们 = 向量<字符串>();
    结果<空类型, 整32> 加p = 单路径们.追加("主");
    如果 (!加p.正常) { 运行时错误(4); }
    向量<整64> 空平铺 = 向量<整64>();
    向量<整64> 空边1 = 向量<整64>();
    向量<整64> 空公开 = 向量<整64>();
    // 边界向量与程序节点们平行（每文件一项=该文件在总表中的起始偏移）——
    //   单文件形态须配对传入（切片段 边界们.元素(j) 防越界）
    结果<空类型, 整32> 加b1 = 空边1.追加(0);
    如果 (!加b1.正常) { 运行时错误(4); }
    返回 语义分析多文件(池, 单节点们, 单路径们, 空平铺, 空边1, 空公开, 诊断);
}

// ==================== 主流程（多文件 P6h + 模块分桶 plans/018 第 3 层） ====================
// 多源文件：程序节点们 = 各文件 程序 节点索引（加载器按依赖先解析的顺序收集）；
//   模块路径们 = 每文件模块路径；导入项平铺总表/导入模块总表 = 全部文件 ②③
//   快照拼接（边界们[f]=文件 f 起始偏移，段=[边界[f], 边界[f+1] 或 总表尾)）；
//   公开平铺总表 = 全部文件 公开: 标签快照拼接（交替 [声明节点索引, 1]——
//   节点索引全池唯一，无需边界）。
// 第一趟：全部文件 声明收集（链接键分桶登记+模块成员索引+可见性）；
// 第二趟：逐文件 构建文件导入上下文（② 导入目标+E0255+③ glob 清单）后检查
//   函数体（三级解析）。返回 诊断数（含查找链路诊断缓冲合入）。
函数 语义分析多文件(向量<节点> 池, 向量<整32> 程序节点们,
                    向量<字符串>& 模块路径们,
                    向量<整64>& 导入项平铺总表, 向量<整64>& 导入项边界们,
                    向量<整64>& 公开平铺总表,
                    向量<字符串>& 诊断) -> 整64 {
    向量<映射<整64, 符号>> 符号表 = 向量<映射<整64, 符号>>();
    表压入(符号表);  // 全局作用域（全部文件 函数/结构体 声明）
    清空调用决议();   // plans/018 第 4 层：调用决议表任务级生命周期
    清空模块解析表(); // 模块成员索引/导入上下文/三级缓存 任务级生命周期
    清空函数签名();  // 呈报③方案A：函数签名表任务级生命周期（入口清空）
    清空重放检查状态();  // 470-a（D10 v2 面）：已重放函数实例表任务级生命周期
    // 公开表构建（平铺 -> 映射点查：声明收集 按节点索引查可见性）
    映射<整64, 整64> 公开表 = 映射<整64, 整64>();
    整64 oi = 0;
    当 (oi + 1 < 公开平铺总表.大小()) {
        结果<空类型, 整32> 设公 = 公开表.设置(公开平铺总表.元素(oi), 1);
        如果 (!设公.正常) { 运行时错误(4); }
        oi += 2;
    }
    整64 i = 0;
    当 (i < 程序节点们.大小()) {
        声明收集(池, 程序节点们.元素(整32(i)), 符号表, 诊断,
                 模块路径们.元素(整32(i)), 公开表);
        i++;
    }
    // ③ 合并全局可见的遍历范围=加载树全部模块 ID（stdlib 不在成员索引天然 miss）。
    //   模块集合去重（plans/018 v2self 锚定轮根治，宿主 findModule 模块表唯一化对齐）：
    //   模块路径们 是文件级快照（每文件一条）——目录包根与撞名成员共享模块路径
    //   （候选1b 包根本模块路径=模块名，成员 代码生成.cn 挂载名同为「代码生成」；
    //   货舱解析 同款），重复条目使 ③ 遍历对同一模块双计数：同签名第二命中
    //   参串标==首参串标 恒真 -> 同名纯名调用假报 E0659 歧义（来源们=自拼接
    //   「货舱解析/货舱解析」，v2self 实测）。映射 O(1) 查重=模块集合语义归一。
    向量<整64> 全部模块ID们 = 向量<整64>();
    映射<整64, 整64> 已见模块集合 = 映射<整64, 整64>();
    整64 mi2 = 0;
    当 (mi2 < 模块路径们.大小()) {
        整64 模块IDg = 驻留(模块路径们.元素(整32(mi2)));
        结果<整64, 整32> 查见g = 已见模块集合.获取(模块IDg);
        如果 (!查见g.正常) {
            结果<空类型, 整32> 加g2 = 全部模块ID们.追加(模块IDg);
            如果 (!加g2.正常) { 运行时错误(4); }
            结果<空类型, 整32> 设见g = 已见模块集合.设置(模块IDg, 1);
            如果 (!设见g.正常) { 运行时错误(4); }
        }
        mi2++;
    }
    整64 j = 0;
    当 (j < 程序节点们.大小()) {
        // 每文件检查前：从总表切本文件 ② 段（局部标量向量）+构建导入上下文
        //   （E0255/私有/存在性诊断仅此一处）
        整64 平铺起 = 导入项边界们.元素(整32(j));
        整64 平铺终 = 导入项平铺总表.大小();
        如果 (j + 1 < 导入项边界们.大小()) { 平铺终 = 导入项边界们.元素(整32(j + 1)); }
        向量<整64> 本平铺段 = 向量<整64>();
        整64 si = 平铺起;
        当 (si < 平铺终) {
            结果<空类型, 整32> 加s = 本平铺段.追加(导入项平铺总表.元素(整32(si)));
            如果 (!加s.正常) { 运行时错误(4); }
            si++;
        }
        // 984：953 旧注入段已删（表注册(符号表, 纯名) 键域与三级键基查询不通=
        //   未生效死代码）——调试模式 收集期注入见 语义分析.cn 声明收集尾（984）。
                构建文件导入上下文(模块路径们.元素(整32(j)), 本平铺段, 全部模块ID们, 诊断, 假);
        节点 程序 = 池.元素(程序节点们.元素(整32(j)));
        整64 k = 整64(程序.子起点);
        当 (k < 整64(程序.子终点)) {
            节点 声明 = 池.元素(整32(k));
            // 887-a（070·G-N·537 C 段）：**顶层静态声明初值检查**——顶层遍历原只
            //   处理 函数/类（静态/常量不检查）→ 顶层静态的结果/可选构造器初值无
            //   装箱标注（IR「构造器装箱类型语境未知」·插桩+causal 确认）。
            如果 (声明.类型 == 节点_静态声明) {
                检查静态声明初值884(池, 声明, 符号表, 诊断);
            }
            如果 (声明.类型 == 节点_函数) {
                // plans/018 类型分桶：返回类型诊断（声明.附加=返回类型名ID）
                检查类型引用(符号表, 诊断, 整64(声明.附加));
                // 417-a（D42 波 3）：泛型函数体检查延后——基类 AST 的 T 表达式位
                //   无真实类型（rustc 同构=实例化后按克隆体检查·418 轮挂接）；
                //   签名登记（收集阶段）不受影响。
                如果 (查泛型基类参数序(整64(声明.文本)) == 0) {
                    检查函数(池, 整32(k), 符号表, 诊断);
                }
            }
            如果 (声明.类型 == 节点_类) {
                // 第七十八轮（2026-09-12）：类方法体检查——第三类函数级作用域
                //   单元（字段裸名解析 + 参数登记 + 借出检查挂载，见 语义检查类）
                // 417-a（D42 波 3）：泛型基类方法体检查延后（同上·实例克隆体为
                //   真实类型载体——波 2 生成链已按克隆体产出）
                如果 (查泛型基类参数序(整64(声明.文本)) == 0) {
                    检查类方法们(池, 整32(k), 符号表, 诊断);
                }
            }
            k++;
        }
        j++;
    }
    // 470-a（D10 v2 面·泛型函数实例体重放语义检查）：417-a「检查延后」欠账
    //   根治——实例体获得与非泛型体同级检查（未声明调用/返回类型误用编译期
    //   拒绝·此前静默到链接期爆/产物垃圾）。放 表弹出 前=全局符号层可用；
    //   诊断直达（check 期即拒·rustc instantiate+check 同构）。
    重放检查泛型函数实例(池, 程序节点们, 符号表, 诊断);
    表弹出(符号表);  // 释放全局作用域
    // 查找链路诊断缓冲合入（三级歧义 E0659——查找函数无诊断参数，缓冲聚合）
    整64 bi = 0;
    当 (bi < 取语义诊断数()) {
        表诊断(诊断, 取语义诊断(bi));
        bi++;
    }
    清空语义诊断缓冲();
    // 339-a（D38 批3a·304/372/374）：入口函数签名检查（宿主矩阵 z01/z02 定规·
    //   自包含现场扫描=零静态写·避 安全区边界 传染）
    检查入口函数签名(池, 程序节点们, 诊断);
// 157-a（plans/023 §十 步骤 5 收口）：诊断无分级——列表全量=语义错误数
//   （154-a 的「观察期警告不计入」排除已随收口删除：安全区边界=硬错误，
//   任何残留命中都必须计数并中止，观察期语义已结束）。
返回 诊断.大小();
}

// 339-a：结果<T,E> 退出码合法性（合成名 结果$T$E——$ 分割取 T/E 段·均须整数族
//   （退出码截断语义·344 wrapper 对齐）；格式异常=假（拒）
函数 结果退出码合法(字符串 合成名) -> 布尔 {
    整64 长 = 字符串长度(合成名);
    整64 第一 = 0 - 1;
    整64 第二 = 0 - 1;
    整64 i = 0;
    当 (i < 长) {
        如果 (((整64(合成名[i]) & 255) == 36)) {
            如果 (第一 == 0 - 1) { 第一 = i; } 否则 如果 (第二 == 0 - 1) { 第二 = i; 中断; }
        }
        i++;
    }
    如果 (第一 == 0 - 1 || 第二 == 0 - 1) { 返回 假; }
    字符串 t段 = 字符串子串(合成名, 第一 + 1, 第二 - 第一 - 1);
    字符串 e段 = 字符串子串(合成名, 第二 + 1, 长 - 第二 - 1);
    返回 是转换整数族文本(t段) && 是转换整数族文本(e段);
}

// 339-a（D38 批3a·304/372/374）：入口函数签名检查（自包含现场扫描——静态写
//   须 不安全 函数=会沿收集链传染，故聚合点直接扫 顶层声明区）。规则=宿主矩阵
//   实测：①无 主 → 拒（304·宿主「未定义入口函数 主」对齐）；②主 参数非空 →
//   拒（372·入口约定无参·v2 编译期拒=优于宿主链接期）；③主 返回白名单=整32 ∨
//   结果<T,E>（T/E 均整数族·wrapper 退出码语义 344 对齐·z01 整64 拒/z02 过；
//   374 结果<字符串,整32> 拒）。多模块同名 主 取首个=诚实边界（主模块单一惯例）。
函数 检查入口函数签名(向量<节点> 池, 向量<整32> 程序节点们, 向量<字符串>& 诊断) -> 空类型 {
    布尔 主存在 = 假;
    字符串 主参数串 = "";
    整64 主返回 = 0;
    整64 文件序 = 0;
    当 (文件序 < 程序节点们.大小()) {
        整32 程序节点 = 程序节点们.元素(文件序);
        如果 (程序节点 >= 0 && 程序节点 < 整32(池.大小())) {
            节点 程序 = 池.元素(程序节点);
            整64 k = 整64(程序.子起点);
            当 (k < 整64(程序.子终点)) {
                节点 声明 = 池.元素(整32(k));
                如果 (声明.类型 == 节点_函数 && 整64(声明.文本) == 驻留("主") && !主存在) {
                    主存在 = 真;
                    主参数串 = 字符串复制(函数参数串(池, 整32(k)));
                    主返回 = 整64(声明.附加);
                }
                k++;
            }
        }
        文件序++;
    }
    如果 (!主存在) {
        表诊断(诊断, "[错误] 未定义入口函数 主");
        返回;
    }
    如果 (字符串长度(主参数串) > 0) {
        表诊断(诊断, "[错误] 入口函数 主 不能带参数（入口约定无参）");
    }
    布尔 主返回合法 = 主返回 == 驻留("整32");
    如果 (!主返回合法 && 主返回 > 0) {
        字符串 主返回文本 = 字符串复制(驻留文本(主返回));
        如果 (是结果类型(主返回文本) && 结果退出码合法(主返回文本)) {
            主返回合法 = 真;
        }
    }
    如果 (!主返回合法) {
        表诊断(诊断, "[错误] 入口 ABI 仅支持 整32 与 结果<T, E>——退出码=正常取 .值/错误取 .错误 码");
    }
}


// ==================== 470-a（D10 v2 面·泛型函数实例体重放语义检查） ====================
// 417-a「检查延后」欠账根治（D10）：泛型函数基类体在语义阶段从未被检查
//   （延后分支）——体内未声明调用/返回类型误用静默过→链接期爆或产物垃圾
//   （双侧同族实弹：非泛型同形态编译期拒绝〔p0 探针〕·泛型静默——检查缺口
//   非泛型专属语义）。宿主 317-a 重放=IR 生成阶段注记刷新（诊断快照回滚·
//   build 期）；本侧=语义阶段重放·诊断直达（check 期即拒·rustc typeck
//   instantiate+check 一体同构）。
// 重放语境=T 豁免（零环境映射）：类型参数名放行（语义分析 检查类型引用）+
//   返回比对拿 T 原文——抓 与 T 无关错误（未声明调用/标识符/结构性）与
//   返回字面量 vs T 误用；T 映射实参后可见的错误（T 值成员调用等）=波 2
//   单态化面（诚实边界·登记 plans/021）。
// 收集口径=模块区间扫 节点_调用 被调标识符（对齐 IR类 收集泛型实例·区间=
//   解析序平铺全段）；去重=实例合成名 ID 已重放表；构造调用 callee（类实
//   例合成名）剥基名无 节点_函数 命中自然跳过（类方法版=登记边界）。

静态 映射<整64, 整64> 已重放函数实例表;
静态 整64 重放豁免安全区 = 0;   // 470-a：重放语境 安全区边界 豁免标志
静态 映射<整64, 整64> 泛型重放环境;  // 477-a（D10 波2）：参数名ID→实参类型文本ID

不安全 函数 清空重放检查状态() -> 空类型 {
    已重放函数实例表.清空();
    重放豁免安全区 = 0;
    泛型重放环境.清空();
}

// 477-a：环境查映射（0=非环境键·非重放路径环境恒空=零开销直通）
函数 查重放环境(整64 类型名ID) -> 整64 {
    结果<整64, 整32> 查e = 泛型重放环境.获取(类型名ID);
    如果 (查e.正常) { 返回 查e.值; }
    返回 0;
}

函数 取重放豁免安全区() -> 布尔 {
    返回 重放豁免安全区 == 1;
}

不安全 函数 重放检查泛型函数实例(向量<节点> 池, 向量<整32> 程序节点们,
                        向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    // ① 基函数表（平行向量：基名ID / 节点索引）——顶层 节点_函数 且 名∈参数序表
    向量<整64> 基名表 = 向量<整64>();
    向量<整32> 基索引表 = 向量<整32>();
    整64 f = 0;
    当 (f < 程序节点们.大小()) {
        节点 程序声明 = 池.元素(程序节点们.元素(整32(f)));
        整64 位置 = 整64(程序声明.子起点);
        整64 终点 = 整64(程序声明.子终点);
        当 (位置 < 终点) {
            节点 n = 池.元素(整32(位置));
            如果 (n.类型 == 节点_函数 && 查泛型基类参数序(整64(n.文本)) != 0) {
                结果<空类型, 整32> 加b = 基名表.追加(整64(n.文本));
                如果 (!加b.正常) { 运行时错误(4); }
                结果<空类型, 整32> 加d = 基索引表.追加(整32(位置));
                如果 (!加d.正常) { 运行时错误(4); }
            }
            位置++;
        }
        f++;
    }
    如果 (基名表.大小() == 0) { 返回; }
    // ② 全池扫调用点（体内子树节点同在池·顶层区间只含顶层声明）→实例合成名
    //   →去重→对基类节点重放 检查函数
    整64 位置m = 0;
    当 (位置m < 池.大小()) {
        {
            节点 c = 池.元素(整32(位置m));
            如果 (c.类型 == 节点_调用 && c.子起点 > 0) {
                节点 被调 = 池.元素(整32(c.子起点));
                如果 (被调.类型 == 节点_标识符) {
                    字符串 被调文本 = 字符串复制(驻留文本(整64(被调.文本)));
                    字符串 基名 = 剥实例基名(被调文本);
                    如果 (!字符串比较(基名, 被调文本)) {
                        // 含 '$'（实例合成名·非裸名调用）
                        整64 基名ID = 整64(驻留(基名));
                        整64 bi = 0;
                        当 (bi < 基名表.大小()) {
                            如果 (基名ID == 基名表.元素(整32(bi))) {
                                整64 实例ID = 整64(被调.文本);
                                结果<整64, 整32> 查重 = 已重放函数实例表.获取(实例ID);
                                如果 (!查重.正常) {
                                    // 首见实例：登记去重表+对基类节点重放检查
                                    //   （T* 形态安全区豁免=静态不可判定·波2 收口）
                                    结果<空类型, 整32> 加r = 已重放函数实例表.设置(实例ID, 1);
                                    如果 (!加r.正常) { 运行时错误(4); }
                                    // 477-a（D10 波2）：环境构建——参数序表拆段×
                                    //   实参段逐对映射（T→整32 等·464-a 递归拆段复用）
                                    整64 参数序ID477 = 查泛型基类参数序(基名ID);
                                    字符串 参数串477 = 字符串复制(驻留文本(参数序ID477));
                                    向量<整64> 参数名们477 = 向量<整64>();
                                    整64 段起477 = 0;
                                    整64 cc477 = 0;
                                    当 (cc477 <= 字符串长度(参数串477)) {
                                        如果 (cc477 == 字符串长度(参数串477) ||
                                             ((整64(参数串477[整32(cc477)]) & 255) == 44)) {
                                            如果 (cc477 > 段起477) {
                                                结果<空类型, 整32> 加n477 = 参数名们477.追加(整64(驻留(字符串子串(参数串477, 整32(段起477), 整32(cc477 - 段起477)))));
                                                如果 (!加n477.正常) { 运行时错误(4); }
                                            }
                                            段起477 = cc477 + 1;
                                        }
                                        cc477++;
                                    }
                                    向量<整64> 实参们477 = 向量<整64>();
                                    剥实例参数段(被调文本, 实参们477);
                                    整64 对477 = 0;
                                    当 (对477 < 参数名们477.大小() && 对477 < 实参们477.大小()) {
                                        结果<空类型, 整32> 设e477 = 泛型重放环境.设置(参数名们477.元素(整32(对477)), 实参们477.元素(整32(对477)));
                                        如果 (!设e477.正常) { 运行时错误(4); }
                                        对477++;
                                    }
                                    重放豁免安全区 = 1;
                                    检查函数(池, 基索引表.元素(整32(bi)), 符号表, 诊断);
                                    重放豁免安全区 = 0;
                                    泛型重放环境.清空();   // 477-a：环境随实例重放结束复位
                                }
                                中断;
                            }
                            bi++;
                        }
                    }
                }
            }
            位置m++;
        }
    }
}
