// CN 自举编译器 v2 · 语义检查构造器（#1591 新增）
// 职责：内置构造器 正常/错误/某些 的目标语境与载荷兼容判定族。
//   884-a 装箱语境映射单点（自 语义检查表达式中.cn 机械搬移·零语义变化）：
//     类型ID 经映射承载（键 0）——安全函数亦可设置（884-a 安全区边界先例）。
//   71-a/826 语境语义：返回位/声明位/静态声明位/赋值位 由检查方设目标类型，
//     区间检查后恢复；构造器检查读取并写回调用节点.文本（#1872 迁槽原驻子终点，IR 特判直读同步）。
//     #1591：赋值位（标识符/字段/数组元素/下标链）语境与恢复单点、
//     载荷兼容检查（宿主 #1588 canConvertType 判据边界·逐字对齐）。
// 消费=语义检查表达式中（检查构造器调用/递归下推）、语义检查赋值（赋值位语境）、
//   语义检查中/语句（返回位/声明位/静态声明位语境设取）。
// 依赖=语法/IR/协议常量 + 语义检查推导（推导成员类型ID）+ 语义检查转换推导
//   （推导源类型ID静默）+ 语义检查表达式尾（是转换整数族文本）+ 语义检查实参转换
//   （数值源实参矩阵非法=宿主 types::canConvert 标量矩阵同构）。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（目录包名）
导入 IR;         // 容器/结果 合成名判定（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:   // 全文件公开（语境/载荷判定族供包内兄弟模块与跨包消费方经合并全局池解析）

// ==================== 884-a 装箱语境映射（自 语义检查表达式中.cn 迁入） ====================
静态 映射<整64, 整64> 装箱语境映射;

// 1637 存在性可选化配套：类型ID=0 是历史「复位语境」写法（0 不再兼任「无语境」）
//   ——0 入参改删键，正类型ID 照设；调用点零改动、读侧无值语义同效。
不安全 函数 设装箱语境884(整64 类型ID) -> 空类型 {
    如果 (类型ID == 0) {
        装箱语境映射.删除(0);
        返回;
    }
    结果<空类型, 整32> 设884 = 装箱语境映射.设置(0, 类型ID);
    如果 (!设884.正常) { 运行时错误(4); }
}

// 1637 存在性可选化：有值=当前装箱语境类型ID（恒 >0）；无值=未设语境（查了、
//   没有这个实体——0 哨兵退场；原 正常(0) 误传风险面随可选显形）
函数 取装箱语境884() -> 可选<整64> {
    结果<整64, 整32> 取884 = 装箱语境映射.获取(0);
    如果 (取884.正常) { 返回 某些(取884.值); }
    返回 无;
}


// ==================== 826 语境设置辅助（自 语义检查表达式中.cn 迁入） ====================
// 826（067-003）：装箱语境设置辅助——静态变量写须在 不安全 函数内（安全区边界
//   检查）；递归下推的语境保存/恢复经此单点。
不安全 函数 设置装箱语境(整64 语境ID) -> 空类型 {
    设装箱语境884(语境ID);
}

// ==================== #1591 内置构造器目标载荷兼容判定族 ====================
// 根因（#1591 缺陷 b）：v2 内置构造器只按实参自然类型/语境标注，从不检查
//   「实参类型能否转换为目标载荷类型」——`可选<字符串> 甲 = 某些(7)` /
//   结构体异型载荷 / `结果<整32,字符串> 果 = 错误(7)` 等宿主硬错误被放行
//   （宿主 #1588 semantic_call_result_ctor.cpp calibrateCtorPayload 同面已修）。
// 判据边界=宿主 canConvertType（**非** canConvertWithLiteral——字面量值域
//   豁免不属本面）：同型/合成名归一 → 结果/可选逐载荷递归 → 结构体同型
//   （值深拷边界）/用户类同型（值切片拒）/类→接口 → 枚举↔整数 →
//   字符*/字符串互通 → 数值标量矩阵（数值源实参矩阵非法 单点复用）→
//   指针/空类型*。
// 实参类型推导=本层已检查产物（嵌套构造器用其已标注目标或自然类型；其余
//   表达式走字面量/结构体构造/标识符/成员/调用/负号可靠面）——推导不出=
//   宿主 argType「未知」同口径不复检（诚实边界；不是取默认值继续判定）。

// 类型判定：文本形态之「持有型」结果/可选——排除数组与指针/引用后缀。
//   v2 是结果类型 为前缀判定（"结果<...>*" 亦真），宿主 isResultType/
//   isOptionalType 见后缀即假（canConvertType 后缀口径注释为证）；构造器
//   目标与载荷递归须用持有型判定，防指针槽按合成体整体赋值（静默越界）。
函数 是持有型结果文本1591(字符串 文本) -> 布尔 {
    布尔 持有 = 是结果类型(文本);
    布尔 是数组 = 是数组类型文本(文本);
    整64 长 = 字符串长度(文本);
    布尔 有尾 = 长 != 0;
    整64 尾 = 0;
    如果 (有尾) { 尾 = 整64(文本[整32(长 - 1)]) & 255; }
    布尔 指针形 = 尾 == 42 || 尾 == 38;
    返回 持有 && !是数组 && !指针形;
}

函数 是持有型可选文本1591(字符串 文本) -> 布尔 {
    布尔 持有 = 是持有型结果文本1591(文本);
    布尔 可选族 = 是可选类型(文本);
    返回 持有 && 可选族;
}

// 结果族（严格 结果，不含 可选）——是结果类型 两族混合，族判定须先分家。
函数 是结果族文本1591(字符串 文本) -> 布尔 {
    布尔 持有结果 = 是持有型结果文本1591(文本);
    布尔 持有可选 = 是持有型可选文本1591(文本);
    返回 持有结果 && !持有可选;
}

// 内置构造器名闭集（001 §5.4 编译器预置三名·用户不可重定义）
函数 是内置构造器名1591(字符串 名) -> 布尔 {
    返回 字符串比较(名, "正常") || 字符串比较(名, "错误") ||
           字符串比较(名, "某些");
}

// 类型文本归一为 $ 形态（< 与 , → $；> 丢弃；空格丢弃）——尖括号源文本与
//   合成名同域比较（宿主 canonicalizeSyntheticArgText / genericClassInstanceName
//   同构：结果/可选/容器/泛型类实例两态归一）。
函数 归一化类型文本1591(字符串 名) -> 字符串 {
    字符串 出 = "";
    整64 i = 0;
    当 (i < 字符串长度(名)) {
        整64 字节 = 整64(名[整32(i)]) & 255;
        如果 (字节 == 60 || 字节 == 44) { 出 = 出 + "$"; }
        如果 (字节 == 62 || 字节 == 32) { }
        如果 (字节 != 60 && 字节 != 44 && 字节 != 62 && 字节 != 32) {
            出 = 出 + 字符串子串(名, 整32(i), 1);
        }
        i++;
    }
    返回 出;
}

// 类型实参们（$ 形态·元数感知）——IR 取实例实参们 单点（结果 2 参/可选 1 参/
//   嵌套实参整段还原）。先归一再切分，尖括号源文本两态同吃。
函数 类型实参们1591(字符串 名) -> 向量<字符串> {
    字符串 归一 = 归一化类型文本1591(名);
    返回 取实例实参们(归一);
}

// 任意指针文本（尾 '*'）
函数 是任意指针文本1591(字符串 文本) -> 布尔 {
    整64 长 = 字符串长度(文本);
    布尔 有尾 = 长 != 0;
    整64 尾 = 0;
    如果 (有尾) { 尾 = 整64(文本[整32(长 - 1)]) & 255; }
    返回 尾 == 42;
}

// 载荷类型可转换（宿主 canConvertType 判据边界·#1588 逐字同源）：
//   真=可隐式转换。结果/可选递归为本函数自递归（同文件禁止互递归后置定义：
//   570 轮「同文件后置定义失效」实录）。
函数 载荷可转换1591(字符串 源文本, 字符串 目标文本) -> 布尔 {
    如果 (字符串比较(源文本, 目标文本)) { 返回 真; }
    如果 (字符串比较(归一化类型文本1591(源文本), 归一化类型文本1591(目标文本))) {
        返回 真;
    }
    // ---- 结果/可选逐载荷递归（模板段：同族才可转）----
    布尔 源结果 = 是持有型结果文本1591(源文本);
    布尔 目标结果 = 是持有型结果文本1591(目标文本);
    如果 (源结果 && 目标结果) {
        向量<字符串> 源参 = 类型实参们1591(源文本);
        向量<字符串> 目标参 = 类型实参们1591(目标文本);
        布尔 源可选 = 是持有型可选文本1591(源文本);
        布尔 目标可选 = 是持有型可选文本1591(目标文本);
        布尔 可转 = 假;
        如果 (源可选 && 目标可选) {
            如果 (源参.大小() == 1 && 目标参.大小() == 1) {
                可转 = 载荷可转换1591(源参.元素(0), 目标参.元素(0));
            }
        } 否则 如果 (!源可选 && !目标可选 &&
                   源参.大小() == 2 && 目标参.大小() == 2) {
            布尔 首 = 载荷可转换1591(源参.元素(0), 目标参.元素(0));
            布尔 次 = 载荷可转换1591(源参.元素(1), 目标参.元素(1));
            可转 = 首 && 次;
        }
        返回 可转;
    }
    如果 (源结果 || 目标结果) {
        // 空值常量子（空类型*）→ 可选<T>（001 §07-三；宿主同条）
        布尔 源零值 = 字符串比较(源文本, "空类型*");
        布尔 目标可选 = 是持有型可选文本1591(目标文本);
        布尔 零值视可选 = 源零值 && 目标可选;
        如果 (零值视可选) { 返回 真; }
        返回 假;
    }
    // ---- 结构体：值形态须同型（同型已在上方归一命中；异型=深拷边界拒）----
    //   1637：有值=是结构体（键基ID 恒 >0·逐点等价 !=0）
    布尔 源结构 = 查结构体类型(驻留(源文本)).有值;
    布尔 目标结构 = 查结构体类型(驻留(目标文本)).有值;
    如果 (源结构 || 目标结构) { 返回 假; }
    // ---- 用户类：值形态同型（已命中）；类→接口（宿主接口段）----
    布尔 源类 = 是用户类_ID(驻留(源文本));
    布尔 目标类 = 是用户类_ID(驻留(目标文本));
    如果 (源类 || 目标类) {
        布尔 目标接口 = 是接口名ID(驻留(目标文本));
        布尔 上转 = 源类 && 目标接口 &&
                    类实现接口沿链(驻留(源文本), 驻留(目标文本));
        如果 (上转) { 返回 真; }
        返回 假;
    }
    // ---- 枚举：枚举↔整数双向（C 风格整32 常量源·宿主 canConvert 同条）----
    布尔 源枚 = 是枚举名(驻留(源文本));
    布尔 目标枚 = 是枚举名(驻留(目标文本));
    如果 (源枚 || 目标枚) {
        如果 (源枚 && 目标枚) { 返回 假; }   // 同型已命中；异枚举不可转
        如果 (源枚) { 返回 是转换整数族文本(目标文本); }
        返回 是转换整数族文本(源文本);
    }
    // ---- 字符串/字符* 双向互通（宿主 types::canConvert 明文条）----
    布尔 源串 = 字符串比较(源文本, "字符串");
    布尔 目标串 = 字符串比较(目标文本, "字符串");
    布尔 源串指针 = 字符串比较(源文本, "字符*");
    布尔 目标串指针 = 字符串比较(目标文本, "字符*");
    如果 (源串指针 && 目标串) { 返回 真; }
    如果 (源串 && 目标串指针) { 返回 真; }
    // ---- 布尔/字符串仅同型（同型已命中）----
    如果 (字符串比较(源文本, "布尔") || 字符串比较(目标文本, "布尔")) { 返回 假; }
    如果 (源串 || 目标串) { 返回 假; }
    // ---- 字符与整数互通（宿主 types::canConvert 字符条）----
    如果 (字符串比较(源文本, "字符")) { 返回 是转换整数族文本(目标文本); }
    如果 (字符串比较(目标文本, "字符")) { 返回 是转换整数族文本(源文本); }
    // ---- 空类型* ↔ 任意指针（宿主指针段）----
    如果 (字符串比较(源文本, "空类型*") && 是任意指针文本1591(目标文本)) { 返回 真; }
    如果 (字符串比较(目标文本, "空类型*") && 是任意指针文本1591(源文本)) { 返回 真; }
    如果 (字符串比较(源文本, "空类型") || 字符串比较(目标文本, "空类型")) { 返回 假; }
    // ---- 数组 → 指针（同元素·宿主退化条）----
    如果 (是数组类型文本(源文本) && 是任意指针文本1591(目标文本)) {
        可选<字符串> 元素查 = 数组元素文本(源文本);
        字符串 指针基 = 字符串子串(目标文本, 0, 整32(字符串长度(目标文本) - 1));
        布尔 同元素 = 假;
        如果 (元素查.有值) {
            同元素 = 字符串比较(字符串复制(元素查.值), 指针基);
        }
        返回 同元素;
    }
    // ---- 数值标量矩阵（宿主 types::canConvert 同构·数值源实参矩阵非法 单点）----
    返回 !数值源实参矩阵非法(源文本, 目标文本);
}

// 目标载荷（宿主 CtorTargetInfo 同构）：构造器族与目标族匹配才返回值。
//   正常/某些 → T；错误 → E；族不匹配/形态不可解析（参差）→ 无（不校准）。
函数 构造器目标载荷1591(字符串 构造器名, 字符串 目标文本) -> 可选<字符串> {
    布尔 可选目标 = 是持有型可选文本1591(目标文本);
    如果 (可选目标 && 字符串比较(构造器名, "某些")) {
        向量<字符串> 实参们 = 类型实参们1591(目标文本);
        如果 (实参们.大小() == 1) { 返回 某些(字符串复制(实参们.元素(0))); }
    }
    布尔 结果目标 = 是结果族文本1591(目标文本);
    布尔 结果构造名 = 字符串比较(构造器名, "正常") || 字符串比较(构造器名, "错误");
    如果 (结果目标 && 结果构造名) {
        向量<字符串> 实参们 = 类型实参们1591(目标文本);
        如果 (实参们.大小() == 2) {
            如果 (字符串比较(构造器名, "错误")) {
                返回 某些(字符串复制(实参们.元素(1)));
            }
            返回 某些(字符串复制(实参们.元素(0)));
        }
    }
    返回 无;
}

// 目标族可定且与构造器族不符（宿主 ctorTargetInfoOf matched=false → 自然
//   类型 → 外层通用盒类型转换检查同拒）。v2 无外层盒类型通用转换检查，
//   故在构造器位直接拒并给可行动诊断（正常/错误 须用于 结果，某些 须用于 可选）。
函数 构造器族不符1591(字符串 构造器名, 字符串 目标文本) -> 布尔 {
    布尔 不符 = 假;
    如果 (是持有型可选文本1591(目标文本)) {
        向量<字符串> 实参们 = 类型实参们1591(目标文本);
        布尔 某些名 = 字符串比较(构造器名, "某些");
        不符 = 实参们.大小() == 1 && !某些名;
    } 否则 如果 (是结果族文本1591(目标文本)) {
        向量<字符串> 实参们 = 类型实参们1591(目标文本);
        布尔 族名 = 字符串比较(构造器名, "正常") ||
                    字符串比较(构造器名, "错误");
        不符 = 实参们.大小() == 2 && !族名;
    }
    返回 不符;
}

// 表达式自然类型（宿主 checkExpr 返回值同口径·零目标语境）：
//   0/无值=推导不出（诚实边界）。覆盖字面量（后缀定级/浮点 f 分型/负号递归）/
//   结构体构造（类型=结构体名）/成员（推导成员类型ID）/内置构造器（递归合成
//   可选$T / 结果$T$整32 / 结果$整32$E——宿主 deriveCtorResultType 无目标分支
//   逐字同构：未知实参按 整32、正常() 无参=空类型）/其余经 推导源类型ID静默
//   （标识符/用户类构造/普通函数调用/二元/负号可靠面）。
函数 表达式自然类型ID1591(向量<节点> 池, 整32 节点索引,
                       向量<映射<整64, 符号>>& 符号表) -> 可选<整64> {
    如果 (节点索引 < 0 || 节点索引 >= 整32(池.大小())) { 返回 无; }
    节点 n = 池.元素(节点索引);
    如果 (n.类型 == 节点_整数字面量) {
        // #1770：附加==1=空指针字面量 无（解析表达式.cn 153-a 约定：文本=数字零
        //   +附加=1 两态标记）——宿主 checkExpr 对空指针字面量给 空类型*
        //   （载荷可转换 空值常量→可选<T> 载荷同条·001 §07-三）。修前一律
        //   整32：嵌套声明 某些(无) 载荷检查误报「'整32' 无法转换为
        //   '可选$整32'」（宿主绿·v2 红 单侧拒分叉）；单层 某些(无)→非可选
        //   载荷反向偷放行（宿主拒）。
        如果 (n.附加 == 1) { 返回 某些(驻留("空类型*")); }
        整64 后缀ID = 字面量后缀类型ID(字符串复制(驻留文本(整64(n.文本))));
        如果 (后缀ID != 0) { 返回 某些(后缀ID); }
        返回 某些(驻留("整32"));
    }
    如果 (n.类型 == 节点_浮点字面量) {
        字符串 字面 = 字符串复制(驻留文本(整64(n.文本)));
        整64 长 = 字符串长度(字面);
        布尔 有尾 = 长 != 0;
        整64 尾 = 0;
        如果 (有尾) { 尾 = 整64(字面[整32(长 - 1)]) & 255; }
        如果 (尾 == 102) { 返回 某些(驻留("浮32")); }   // f 后缀=浮32
        返回 某些(驻留("浮64"));
    }
    如果 (n.类型 == 节点_字符串字面量) { 返回 某些(驻留("字符串")); }
    如果 (n.类型 == 节点_布尔字面量) { 返回 某些(驻留("布尔")); }
    如果 (n.类型 == 节点_字符字面量) { 返回 某些(驻留("字符")); }
    如果 (n.类型 == 节点_结构体构造) {
        如果 (整64(n.文本) != 0) { 返回 某些(整64(n.文本)); }
        返回 无;
    }
    如果 (n.类型 == 节点_负号 && n.子终点 != n.子起点) {
        返回 表达式自然类型ID1591(池, 整32(n.子终点) - 1, 符号表);
    }
    如果 (n.类型 == 节点_成员) {
        向量<字符串> 静默 = 向量<字符串>();
        返回 推导成员类型ID(池, 节点索引, 符号表, 静默);
    }
    // #1591：指针/数组标识符——符号表登记=剥星基名（指针/数组名退化登记），
    //   宿主 checkExpr 给真实指针文本；按 指针变量表 + 层数表 重建（层数表
    //   miss=两表不一致=编译器内部缺陷，登记显形后按最低层 1 维持文本）。
    如果 (n.类型 == 节点_标识符) {
        可选<整64> 指针查 = 查语义指针变量(整64(n.文本));
        如果 (指针查.有值) {
            字符串 指针文本1591 = 字符串复制(驻留文本(指针查.值));
            整64 层数1591 = 1;
            可选<整64> 层数查1591 = 查语义指针层数(整64(n.文本));
            如果 (层数查1591.有值) { 层数1591 = 层数查1591.值; }
            如果 (!层数查1591.有值) {
                登记内部未登记("指针层数表与指针变量表登记不一致（1591 构造器实参类型）",
                               字符串复制(驻留文本(整64(n.文本))), 0);
            }
            整64 加星1591 = 0;
            当 (加星1591 < 层数1591) {
                指针文本1591 = 指针文本1591 + "*";
                加星1591++;
            }
            返回 某些(驻留(指针文本1591));
        }
    }
    如果 (n.类型 == 节点_调用 && n.子起点 != 0 &&
        整64(n.子起点) < 整64(池.大小())) {
        节点 被调 = 池.元素(整32(n.子起点));
        如果 (被调.类型 == 节点_标识符) {
            字符串 内名 = 字符串复制(驻留文本(整64(被调.文本)));
            如果 (是内置构造器名1591(内名)) {
                字符串 载荷文本 = 字符串复制("整32");   // 宿主 argType 未知同口径
                如果 (n.附加 == 0) { 载荷文本 = 字符串复制("空类型"); }
                如果 (n.附加 == 1) {
                    可选<整64> 载荷查 = 表达式自然类型ID1591(池, 节点索引 - 1, 符号表);
                    如果 (载荷查.有值) {
                        载荷文本 = 字符串复制(驻留文本(载荷查.值));
                    }
                }
                如果 (字符串比较(内名, "某些")) {
                    返回 某些(驻留("可选$" + 载荷文本));
                }
                如果 (字符串比较(内名, "正常")) {
                    返回 某些(驻留("结果$" + 载荷文本 + "$整32"));
                }
                返回 某些(驻留("结果$整32$" + 载荷文本));
            }
        }
    }
    返回 推导源类型ID静默(池, 节点索引, 符号表);
}

// #1591 修复：本节点是否位于「某个外层调用的实参区」——后缀池布局
//   [被调][实参们…][调用节点]：向前找最近的调用节点（同层兄弟调用的被调
//   在自身之后，其 子起点 > 本索引，跳过），命中条件 子起点 < 本索引 且
//   调用节点索引 > 本索引。命中=本构造器的目标语境归外层表达式（构造器实参
//   →外层 pushdown 按载荷语境重查；普通调用实参→调用实参检查按形参语境/
//   自然推导），平铺遍历不得把外层声明/赋值目标直接套在本层（#1591 预验
//   543/766 三级嵌套与 537 容器方法实参误报根因）。
//   扫描窗=32 节点（单表达式实参区上界；超出=按非实参处理=存量行为）。
函数 是调用实参1591(向量<节点> 池, 整32 节点索引) -> 布尔 {
    整32 上界1591 = 节点索引 + 32;
    如果 (上界1591 > 整32(池.大小())) { 上界1591 = 整32(池.大小()); }
    整32 j = 节点索引 + 1;
    当 (j < 上界1591) {
        节点 候 = 池.元素(j);
        如果 (候.类型 == 节点_调用 && 候.子起点 != 0 &&
            整64(候.子起点) < 整64(节点索引)) {
            返回 真;
        }
        j++;
    }
    返回 假;
}

// 外层调用的被调是否为内置构造器（是调用实参1591 的配套判定）：
//   真=本节点是嵌套构造器实参（目标语境由外层构造器 pushdown 按载荷重查，
//   平铺通道延后）；假=普通调用/方法调用的实参（按形参期望 894/自然类型标注）。
函数 外层调用构造器1591(向量<节点> 池, 整32 节点索引) -> 布尔 {
    整32 上界1591 = 节点索引 + 32;
    如果 (上界1591 > 整32(池.大小())) { 上界1591 = 整32(池.大小()); }
    整32 j = 节点索引 + 1;
    当 (j < 上界1591) {
        节点 候 = 池.元素(j);
        如果 (候.类型 == 节点_调用 && 候.子起点 != 0 &&
            整64(候.子起点) < 整64(节点索引)) {
            节点 被调1591 = 池.元素(整32(候.子起点));
            如果 (被调1591.类型 == 节点_标识符) {
                返回 是内置构造器名1591(字符串复制(
                    驻留文本(整64(被调1591.文本))));
            }
            返回 假;
        }
        j++;
    }
    返回 假;
}

// 构造器实参类型（宿主 checkExpr(实参) 返回类型等价物）：
//   内层构造器——外层目标载荷族匹配其构造器族 ⇒ 递归下推已把它标注为该
//   载荷（文本=载荷类型ID·#1872 迁槽原驻子终点），取标注；否则取自然类型
//   （宿主无目标/族不匹配时 checkExpr 的自然推导同口径）。其余表达式走
//   表达式自然类型ID1591。
函数 构造器实参类型ID1591(向量<节点> 池, 整32 实参根索引,
                        字符串 外层载荷文本,
                        向量<映射<整64, 符号>>& 符号表) -> 可选<整64> {
    如果 (实参根索引 < 0 || 实参根索引 >= 整32(池.大小())) { 返回 无; }
    节点 实参 = 池.元素(实参根索引);
    如果 (实参.类型 == 节点_调用 && 实参.子起点 != 0 &&
        整64(实参.子起点) < 整64(池.大小())) {
        节点 被调 = 池.元素(整32(实参.子起点));
        如果 (被调.类型 == 节点_标识符) {
            字符串 内名 = 字符串复制(驻留文本(整64(被调.文本)));
            如果 (是内置构造器名1591(内名)) {
                可选<字符串> 内载荷查 = 构造器目标载荷1591(内名, 外层载荷文本);
                // #1872 注解迁槽：标注读 文本（原读 子终点——协议落地后
                //   子终点=参数段末恒非零，误判「已标注」致嵌套构造器载荷
                //   族匹配失效·1531/1608 实录）
                布尔 采用标注 = 内载荷查.有值 && 实参.文本 != 0;
                如果 (采用标注) { 返回 某些(整64(实参.文本)); }
                返回 表达式自然类型ID1591(池, 实参根索引, 符号表);
            }
        }
    }
    返回 表达式自然类型ID1591(池, 实参根索引, 符号表);
}

// 构造器载荷兼容检查主入口（检查构造器调用 挂点·返回 真=通过/假=已诊断）：
//   ①族不符（目标族可定且构造器族不匹配）→ 可行动诊断 + 假；
//   ②载荷失配（实参类型不可转换为目标载荷）→ 宿主 #1588 文案逐字 + 假；
//   ③实参类型推导不出/无实参 → 不复检（宿主 argType 未知同口径）。
不安全 函数 检查构造器载荷1591(向量<节点> 池, 整32 实参根索引,
                            字符串 构造器名, 整64 目标类型ID,
                            向量<映射<整64, 符号>>& 符号表,
                            向量<字符串>& 诊断) -> 布尔 {
    布尔 通过 = 真;
    如果 (目标类型ID != 0) {
        字符串 目标文本 = 字符串复制(驻留文本(目标类型ID));
        可选<字符串> 载荷查 = 构造器目标载荷1591(构造器名, 目标文本);
        如果 (载荷查.有值) {
            字符串 载荷 = 字符串复制(载荷查.值);
            // #1591 修复（1013）：模板态泛型形参载荷（结果<T,E> 的 T）——单态化前
            //   无具体类型，宿主同口径放行（是泛型参数名）；载荷可转换矩阵不得
            //   按具体类型判（否则 泛型函数体内 正常(值) 误报载荷不可转）。
            如果 (是泛型参数名(驻留(载荷))) { 返回 通过; }
            可选<整64> 实参类型查 = 构造器实参类型ID1591(
                池, 实参根索引, 载荷, 符号表);
            如果 (实参类型查.有值) {
                字符串 实参文本 = 字符串复制(驻留文本(实参类型查.值));
                // 模板态实参（泛型形参 T）同放行（与载荷侧同一条）
                如果 (是泛型参数名(驻留(实参文本))) { 返回 通过; }
                布尔 可转 = 载荷可转换1591(实参文本, 载荷);
                如果 (!可转) {
                    整32 保存行 = 取当前诊断行();
                    如果 (实参根索引 >= 0 && 实参根索引 < 整32(池.大小())) {
                        设当前诊断行(池.元素(实参根索引).行);
                    }
                    表诊断(诊断, "内置构造器 '" + 构造器名 + "' 实参无法将 '" +
                                 实参文本 + "' 隐式转换为目标 '" + 目标文本 +
                                 "' 的载荷类型 '" + 载荷 + "'");
                    设当前诊断行(保存行);
                    通过 = 假;
                }
            }
        } 否则 如果 (!载荷查.有值) {
            布尔 族不符 = 构造器族不符1591(构造器名, 目标文本);
            如果 (族不符) {
                表诊断(诊断, "[错误] 内置构造器 '" + 构造器名 +
                              "' 不能用于目标 '" + 目标文本 +
                              "'（正常/错误 须用于 结果，某些 须用于 可选）");
                通过 = 假;
            }
        }
    }
    返回 通过;
}

// 声明目标持有型判定（#1591·声明位/静态声明位 语境守卫单点）：
//   声明语句节点 n.附加=类型节点池下标；类型节点附加==0（无指针/引用层）且
//   归一后类型文本非数组 → 持有型盒目标。指针/引用声明符号表登记=剥星基名
//   （结果类型前缀会误命中），宿主 canConvertType 后缀口径同拒；原裸设语境
//   会放行并让 IR 把合成体整体写进指针/数组槽（静默越界）。
函数 声明类型持有1591(向量<节点> 池, 节点 n, 整64 类型ID) -> 布尔 {
    布尔 持有 = 假;
    如果 (n.附加 >= 0 && n.附加 < 池.大小()) {
        节点 类型节点1591 = 池.元素(整32(n.附加));
        如果 (类型节点1591.类型 == 节点_类型 && 类型节点1591.附加 == 0) {
            持有 = !是数组类型文本(字符串复制(驻留文本(类型ID)));
        }
    }
    返回 持有;
}

// 声明位语境设置（#1591·声明语句/静态声明 共用单点）：
//   持有型盒目标 → 语境=声明类型；数组 + 初始化列表 → 语境=**元素类型**
//   （宿主 semantic_decl.cpp InitListExpr 元素循环 push elemType 同款；
//   数组本身不是盒目标，但元素位构造器须按元素类型校准/载荷检查）。
//   返回 真=已设语境（调用方区间检查后 设装箱语境884(0) 复位）。
不安全 函数 设声明位语境1591(向量<节点> 池, 节点 n, 整64 类型ID) -> 布尔 {
    布尔 设了 = 假;
    如果 (类型ID != 0) {
        布尔 持有 = 声明类型持有1591(池, n, 类型ID);
        如果 (持有) {
            设装箱语境884(类型ID);
            设了 = 真;
        } 否则 如果 (!持有 && n.子终点 > n.子起点) {
            字符串 声明文本1591 = 字符串复制(驻留文本(类型ID));
            如果 (是数组类型文本(声明文本1591)) {
                节点 初值末1591 = 池.元素(整32(n.子终点) - 1);
                如果 (初值末1591.类型 == 节点_数组初始化) {
                    // #1769：语境=**基元素**类型（数组基元素文本 剥全部维度——
                    //   原剥首维对多维列表落「结果<..>[2]」带维度尾缀中间文本，
                    //   是持有型结果文本1591 判定 miss → 语境漏设 → 元素位
                    //   正常(1) 误拒「须用于 结果/可选 语境」（1607 基元素
                    //   口径同源教训·宿主 ctorTargetStack 递归内层=基元素
                    //   同构）。一维剥首维==基元素=零变化）
                    可选<字符串> 元素查1591 = 数组基元素文本(声明文本1591);
                    如果 (元素查1591.有值) {
                        字符串 元素文本1591 = 字符串复制(元素查1591.值);
                        如果 (是持有型结果文本1591(元素文本1591)) {
                            设装箱语境884(驻留(元素文本1591));
                            设了 = 真;
                        }
                    }
                }
            }
        }
    }
    返回 设了;
}

// ==================== #1591 赋值位构造器语境 ====================
// 根因（#1591 缺陷 a）：v2 构造器语境只覆盖 返回位/声明位/静态声明位（71-a）
//   与 下标/成员赋值位（884-a/234/571），**标识符简单赋值位**（`乙 = 某些(7)`）
//   无语境 → 误报「须用于 结果/可选 语境」（宿主赋值位支持）。且原 884-a
//   成员位设语境后**不复位**（下标位复位为 0 而非旧值）——语境泄漏到后续
//   语句。本族=赋值位语境统一设置/恢复（标识符/字段/数组元素/下标链），
//   与声明位/返回位/实参位同口径；嵌套赋值经旧值保存恢复不串扰。

// 解引用左值所指类型（#1666·`*针 = 某些(…)`）：
//   宿主 checkUnaryCallAssignTarget（Deref→checkExpr(target)=所指类型）同口径。
//   操作数=标识符：语义指针变量表命中（94-a）→基元素类型 ID；多层指针按
//   指针层数表还原 N-1 星（多级解引用结果非持有型盒，尾星由调用方持有判定
//   拒绝——绝不给指针值设盒语境）。
//   操作数=复合形态（成员链指针字段）：#1681 根修后恢复（2026-10-27）——
//   左值目标类型ID1591 推导字段类型剥一层星；非指针/不可推导=不设语境
//   （构造器按既有「须用于语境」拒绝，宁拒不放行保持）。
//   无值=不可推导（不设语境，构造器按既有「须用于语境」拒绝，非静默放行）。
函数 解引用目标类型1591(向量<节点> 池, 节点 末,
                      向量<映射<整64, 符号>>& 符号表) -> 可选<整64> {
    如果 (末.子终点 <= 0 || 整64(末.子终点) > 池.大小()) { 返回 无; }
    // 一元前缀节点子区间=[操作数首节点, 本节点)——操作数末节点=子终点-1
    //   （`*(甲.槽)` 首节点=甲，末节点=成员；443 取地址分支同口径）
    整32 操作数索引1591 = 末.子终点 - 1;
    节点 操作数 = 池.元素(操作数索引1591);
    如果 (操作数.类型 != 节点_标识符) {
        // #1666 边界恢复（#1681 根修后放行·2026-10-27）：复合操作数（成员链
        //   指针字段 `*(架.针)`）——原「宁拒不放行」因 #1681 读/写两侧把
        //   「指向结果/可选的指针字段」误判合成体（IR 目标地址错位/写丢静默
        //   错值）。#1681 根修（读侧 658①+写侧 658① 尾星让位）后本支恢复：
        //   所指类型=左值目标类型ID1591（成员链字段类型全形态·与赋值位同源）
        //   剥一层星——`可选<整64>*` → `可选<整64>`；非指针（尾无星/空文本）
        //   =不设语境（构造器按既有「须用于语境」拒绝·宁拒不放行保持）。
        可选<整64> 复合查1681 = 左值目标类型ID1591(池, 操作数索引1591, 符号表);
        如果 (!复合查1681.有值) { 返回 无; }
        字符串 复合文1681 = 字符串复制(驻留文本(复合查1681.值));
        整64 长c1681 = 字符串长度(复合文1681);
        如果 (长c1681 == 0 ||
             (整64(复合文1681[整32(长c1681 - 1)]) & 255) != 42) { 返回 无; }
        字符串 剥星文1681 = 字符串子串(复合文1681, 0, 整32(长c1681 - 1));
        如果 (字符串长度(剥星文1681) == 0) { 返回 无; }
        返回 某些(驻留(剥星文1681));
    }
    可选<整64> 基查 = 查语义指针变量(整64(操作数.文本));
    如果 (!基查.有值) { 返回 无; }
    整64 层数 = 指针层数补星1039(整64(操作数.文本));
    布尔 多层 = 层数 != 1;
    如果 (多层) {
        字符串 基文本1591 = 字符串复制(驻留文本(基查.值));
        返回 某些(驻留(指针文本补星1039(基文本1591, 层数 - 1)));
    }
    返回 某些(基查.值);
}

// 赋值左值目标类型（#1591/#1666）：标识符=符号表类型（类静态字段回退）；
//   成员=自身.字段/推导成员类型ID/结构体·类字段回退/对象类型递归（成员 of
//   数组元素·解引用链）；下标=指针元素表优先、否则递归对象类型取数组元素或
//   指针所指（嵌套下标链/字段数组元素/字段指针元素同吃）；解引用=所指类型
//   （标识符操作数=语义指针变量表·复合操作数=本函数递归剥星——#1681 根修
//   后恢复·2026-10-27）。
//   无值=不可推导（不设语境 → 构造器按既有「须用于语境」拒绝，非静默放行）。
函数 左值目标类型ID1591(向量<节点> 池, 整32 左值末索引,
                       向量<映射<整64, 符号>>& 符号表) -> 可选<整64> {
    如果 (左值末索引 < 0 || 左值末索引 >= 整32(池.大小())) { 返回 无; }
    节点 末 = 池.元素(左值末索引);
    如果 (末.类型 == 节点_标识符) {
        可选<整64> 变量查 = 表查找类型ID(符号表, 整64(末.文本));
        如果 (变量查.有值) { 返回 某些(变量查.值); }
        // 1007/434 同款回退：类内裸名静态字段 / 类名::字段 限定写
        // 1637：可选显式分流——无值=非类上下文（跳过本回退·原传 0 必 miss 等价）
        可选<整64> 当前类查 = 取当前检查类ID();
        如果 (当前类查.有值) {
            结果<整64, 整32> 类静查 = 查类静态字段类型(当前类查.值, 整64(末.文本));
            如果 (类静查.正常) { 返回 某些(类静查.值); }
        }
        结果<整64, 整32> 限定查 = 查限定名静态字段类型(整64(末.文本));
        如果 (限定查.正常) { 返回 某些(限定查.值); }
        返回 无;
    }
    如果 (末.类型 == 节点_成员) {
        // ①自身.字段（当前类字段表）；②推导成员类型ID（父链递归）
        如果 (末.子起点 != 0) {
            节点 对象 = 池.元素(整32(末.子起点));
            如果 (对象.类型 == 节点_标识符 &&
                字符串比较(字符串复制(驻留文本(整64(对象.文本))), "自身") &&
                读借出检查类() != 0) {
                可选<整64> 自身字段查 = 查字段类型ID(读借出检查类(), 整64(末.文本));
                如果 (自身字段查.有值) { 返回 某些(自身字段查.值); }
            }
        }
        向量<字符串> 静默 = 向量<字符串>();
        可选<整64> 推导查 = 推导成员类型ID(池, 左值末索引, 符号表, 静默);
        如果 (推导查.有值) { 返回 某些(推导查.值); }
        // ③234/571 回退：对象=标识符（结构体直查 / 变量声明类型=类名）
        如果 (末.子起点 != 0) {
            节点 对象2 = 池.元素(整32(末.子起点));
            如果 (对象2.类型 == 节点_标识符) {
                // 1637：可选显式分流——无值=非结构体（键基 保持 0·
                //   符号表类型回退与 !=0 门契约不变）
                整64 键基 = 0;
                可选<整64> 键基查 = 查结构体类型(整64(对象2.文本));
                如果 (键基查.有值) { 键基 = 键基查.值; }
                如果 (键基 == 0) {
                    可选<整64> 对象类型查 = 表查找类型ID(符号表, 整64(对象2.文本));
                    如果 (对象类型查.有值) { 键基 = 对象类型查.值; }
                }
                如果 (键基 != 0) {
                    可选<整64> 字段查 = 查字段类型ID(键基, 整64(末.文本));
                    如果 (字段查.有值) { 返回 某些(字段查.值); }
                }
            }
        }
        // ④#1666：对象类型递归（成员 of 数组元素/解引用链——`组[0].选` /
        //   `(*针).选` 形态：推导成员类型ID 面外时的字段位白名单补齐；
        //   宿主 checkExpr(target) 全形态自然类型同口径）
        如果 (末.子起点 != 0) {
            可选<整64> 链对象查 = 左值目标类型ID1591(池, 整32(末.子起点), 符号表);
            如果 (链对象查.有值) {
                可选<整64> 链字段查 = 查字段类型ID(链对象查.值, 整64(末.文本));
                如果 (链字段查.有值) { 返回 某些(链字段查.值); }
            }
        }
        返回 无;
    }
    如果 (末.类型 == 节点_解引用) {
        // #1666：解引用赋值位（`*针 = 某些(…)`）——宿主 Deref 左值同口径
        返回 解引用目标类型1591(池, 末, 符号表);
    }
    如果 (末.类型 == 节点_下标 && 末.子起点 != 0) {
        节点 下标对象 = 池.元素(整32(末.子起点));
        // 裸指针/数组名：语义指针变量表=元素类型ID（94-a/615 同表）
        如果 (下标对象.类型 == 节点_标识符) {
            可选<整64> 指针查 = 查语义指针变量(整64(下标对象.文本));
            如果 (指针查.有值) { 返回 某些(指针查.值); }
        }
        // 数组（嵌套下标递归/字段数组元素同吃）
        可选<整64> 对象类型查 = 左值目标类型ID1591(池, 整32(末.子起点), 符号表);
        如果 (对象类型查.有值) {
            字符串 对象文本 = 字符串复制(驻留文本(对象类型查.值));
            如果 (是数组类型文本(对象文本)) {
                可选<字符串> 元素查 = 数组元素文本(对象文本);
                如果 (元素查.有值) {
                    字符串 元素文本 = 字符串复制(元素查.值);
                    如果 (字符串长度(元素文本) != 0) {
                        返回 某些(驻留(元素文本));
                    }
                }
            }
            // #1666：字段指针元素（`甲.针[1]`）——对象类型=指针文本时剥一层
            //   尾星=元素类型（宿主 checkExpr(IndexExpr) 自然类型同口径）
            整64 下标星数1591 = 尾星数615(对象文本);
            如果 (下标星数1591 != 0) {
                字符串 下标元素文本1591 = 字符串子串(
                    对象文本, 0, 整32(字符串长度(对象文本) - 1));
                如果 (字符串长度(下标元素文本1591) != 0) {
                    返回 某些(驻留(下标元素文本1591));
                }
            }
        }
        返回 无;
    }
    返回 无;
}

// 赋值位语境设置（#1591·检查赋值语句 右值区间检查前调用）：
//   按左值目标类型（标识符/字段/数组元素/下标链）为 结果/可选 时设装箱语境，
//   返回**旧语境**供调用方检查后恢复（嵌套/异常路径不泄漏语境）。
//   指针变量直写（目标=剥星基名）与数组整体写排除——持有型判定见上。
不安全 函数 设赋值位语境1591(向量<节点> 池, 整32 节点索引,
                          向量<映射<整64, 符号>>& 符号表) -> 整64 {
    // 1637：可选显式分流——旧语境无值落 0（返回侧恢复 设装箱语境884(0)=删键
    //   复位·往返协议等价）
    整64 旧语境 = 0;
    可选<整64> 旧语境查 = 取装箱语境884();
    如果 (旧语境查.有值) { 旧语境 = 旧语境查.值; }
    整64 目标ID = 0;
    布尔 有目标 = 假;
    如果 (节点索引 < 0 || 节点索引 >= 整32(池.大小())) { 返回 旧语境; }
    节点 n = 池.元素(节点索引);
    如果 (n.文本 != 0) {
        // 指针直写：符号表登记=剥星基名（结果类型前缀会误命中），显式排除
        可选<整64> 指针查 = 查语义指针变量(整64(n.文本));
        如果 (!指针查.有值) {
            // 标识符左值：符号表类型（1007/434 同款类静态字段回退）
            可选<整64> 直查 = 表查找类型ID(符号表, 整64(n.文本));
            如果 (直查.有值) { 目标ID = 直查.值; 有目标 = 真; }
            如果 (!直查.有值) {
                // 1637：可选显式分流——无值=非类上下文（跳过本回退·原传 0 必 miss 等价）
                可选<整64> 当前类查 = 取当前检查类ID();
                如果 (当前类查.有值) {
                    结果<整64, 整32> 类静查 = 查类静态字段类型(
                        当前类查.值, 整64(n.文本));
                    如果 (类静查.正常) { 目标ID = 类静查.值; 有目标 = 真; }
                }
                结果<整64, 整32> 限定查 = 查限定名静态字段类型(整64(n.文本));
                如果 (限定查.正常) { 目标ID = 限定查.值; 有目标 = 真; }
            }
        }
    } 否则 如果 (n.子起点 != 0) {
        可选<整64> 末查 = 左值目标类型ID1591(池, 整32(n.子起点) - 1, 符号表);
        如果 (末查.有值) { 目标ID = 末查.值; 有目标 = 真; }
    }
    如果 (有目标) {
        字符串 目标文本 = 字符串复制(驻留文本(目标ID));
        // 1666（2026-10-26·#1591 缺陷 b·v2 自举红灯根治）：持有判定补**可选族**
        //   ——原只调 是持有型结果文本1591（=是结果类型·对 可选<...> 恒假）→
        //   可选变量赋值位语境永不设置→`出ID = 某些(基ID)` 报「无语境」误报
        //   （借用实参登记750.cn:103·v2 自举编译红·host 同形态绿实证）。
        //   语境 ID=可选 目标类型（与 结果 同构消费——构造器载荷下推同参）。
        布尔 持有结果 = 是持有型结果文本1591(目标文本);
        布尔 持有可选 = 是持有型可选文本1591(目标文本);
        如果 (持有可选) { 设装箱语境884(目标ID); }
        如果 (持有结果 && !持有可选) { 设装箱语境884(目标ID); }
    }
    返回 旧语境;
}

// 赋值位语境恢复（#1591）：无条件恢复旧语境（旧值 0=清空），调用方在
//   右值区间检查完成后调用——异常/嵌套/提前分支均不泄漏。
不安全 函数 恢复赋值位语境1591(整64 旧语境) -> 空类型 {
    设装箱语境884(旧语境);
}

