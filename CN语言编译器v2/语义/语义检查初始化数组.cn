// 语义检查初始化数组（#1769 轮：声明面数组初始化列表检查族——自 语义检查语句.cn
//   搬出+多维嵌套递归扩展。先拆再加纪律：该文件 994 行贴冻结线，本文件承接
//   多维新逻辑并提炼两遍法收集为包内单一实现）。
//
// #1769（2026-10-31 用户批甲案·二维嵌套初始化列表 {{...}}）：
//   ①嵌套大括号初始化列表（整32[2][2] 表 = { { 1, 2 }, { 3, 4 } }）——元素本身
//     可为初始化列表（嵌套深度=数组维度），结果<..>/类/容器元素形态按元素类型
//     递归展开；②缺格补「类型默认态」（1473 已批甲案·检查面放行·IR 面补齐）；
//   ③维度不齐（内层元素个数>该维声明长度）=编译期拒·逐维同文案；④拉平禁入
//   ——一维清单塞多维数组=编译期拒（堵静默重排）。诊断文案与宿主逐字一致。
//   立法条文=plans/001 §3.5（随本任务分支落盘〔通告〕）。

导入 容器::向量;
导入 语法;       // 节点_* 常量
导入 协议常量;
导入 IR;         // 是数组类型文本/数组元素文本/数组长度文本（数组工具）

公开:   // 全文件公开（供 语义检查语句.cn 消费）

// 812 两遍法（2026-10-26·自 语义检查语句.cn 顶层包装收集段机械搬移提炼·零行为
//   变更）：**只数直接子层**——解析不变量（解析数组初始化列表 86）=池布局
//   [元素子树...][包装]（包装紧随其子树追加·包装.子起点=其子树起点·
//   包装.子终点=包装自身池索引）。线性扫会把嵌套子树的内层包装也数进
//   （结构体字面量字段 `班级{成绩={..}}` 61 行72 实锤）。顶层判定（两遍法）：
//   包装 P 是顶层 ⟺ P 的池索引不被任何其他包装的 (子起点, 子终点) 开区间
//   覆盖（P_in 的索引 ∈ 外层 P1 的区间=它嵌在 P1 的子树里）。宿主
//   visitVarDecl InitListExpr 数直接子层同构；返回=顶层包装池索引们（自左
//   到右·收集序=池序）。
函数 收集顶层包装们(向量<节点> 池, 整64 扫描起c, 整64 扫描终c) -> 向量<整64> {
    向量<整64> 包装们c = 向量<整64>();   // 顶层包装池索引（原三元组平铺简化：判定仅需索引）
    整64 集扫c = 扫描起c;
    当 (集扫c < 扫描终c) {
        节点 包装c = 池.元素(整32(集扫c));
        如果 (包装c.类型 == 节点_数组元素 &&
             包装c.子终点 > 包装c.子起点) {
            // 内层判定：本包装索引 ∈ 任何其他包装的 (子起点, 子终点) 开区间
            布尔 是内层c = 假;
            整64 比包c = 扫描起c;
            当 (比包c < 扫描终c) {
                节点 比节点c = 池.元素(整32(比包c));
                如果 (比包c != 集扫c &&
                     比节点c.类型 == 节点_数组元素 &&
                     比节点c.子终点 > 比节点c.子起点 &&
                     集扫c > 整64(比节点c.子起点) &&
                     集扫c < 整64(比节点c.子终点)) {
                    是内层c = 真;
                    中断;
                }
                比包c++;
            }
            如果 (!是内层c) {
                结果<空类型, 整32> 加顶c = 包装们c.追加(集扫c);
                如果 (!加顶c.正常) { 运行时错误(4); }
            }
        }
        集扫c++;
    }
    返回 包装们c;
}

// #1769：多维数组初始化列表递归检查。
//   初始化节点索引=节点_数组初始化 池索引；层数组类型文本=当前层**数组类型**
//   （顶层 整32[2][2] / 内层 整32[2]）。每层裁定：①元素类型是数组：顶层元素
//   根=嵌套列表→递归下一维；根=表达式→拉平禁入拒。②元素类型非数组：根=
//   嵌套列表→嵌塞一维拒；否则标量元素（切片 869/隐式转换检查·原 812 逐字）。
//   ③层尾元素个数超界拒（847 文案逐字·多维内层同文案）。缺格（个数<层长）=
//   合法放行（补类型默认态·1473 甲案）。
函数 检查多维数组列表逐维(向量<节点> 池, 整32 初始化节点索引w,
                            字符串 层数组类型文本w,
                            向量<映射<整64, 符号>>& 符号表,
                            向量<字符串>& 诊断) -> 空类型 {
    节点 初始化节点w = 池.元素(初始化节点索引w);
    可选<字符串> 元素文本查w = 数组元素文本(层数组类型文本w);
    如果 (!元素文本查w.有值) {
        // 调用方保证层数组类型文本为数组（isArray 守卫）——无值=内部缺陷显形
        表诊断(诊断, "[错误] 内部错误: 数组元素类型缺失（'" +
                      字符串复制(层数组类型文本w) + "' 应为数组类型）");
        返回;
    }
    字符串 元素文本w = 字符串复制(元素文本查w.值);
    整64 层长w = 数组长度文本(层数组类型文本w);
    布尔 元素类型是数组w = 是数组类型文本(元素文本w);
    整64 驻留元素类型w = 驻留(元素文本w);
    向量<整64> 顶层们w = 收集顶层包装们(池, 整64(初始化节点w.子起点),
                                              整64(初始化节点w.子终点));
    整64 遍顶w = 0;
    当 (遍顶w < 顶层们w.大小()) {
        整64 包装索引w = 顶层们w.元素(整32(遍顶w));
        节点 包装w = 池.元素(整32(包装索引w));
        整64 根索引w = 整64(包装w.子终点) - 1;
        节点 根w = 池.元素(整32(根索引w));
        布尔 根是列表w = 根w.类型 == 节点_数组初始化;
        如果 (元素类型是数组w && !根是列表w) {
            // 拉平禁入（静默重排拒绝·诊断指路嵌套写法·宿主同文案）
            表诊断(诊断, "[错误] 数组维度不匹配: 元素须为嵌套初始化列表 { ... }（声明元素类型 '" +
                          字符串复制(元素文本w) +
                          "' 仍为数组——拉平写法禁入，请按维度嵌套）");
        } 否则 如果 (!元素类型是数组w && 根是列表w) {
            // 嵌套列表塞一维数组（维度过深·宿主同文案）
            表诊断(诊断, "[错误] 数组维度不匹配: 元素不接受嵌套初始化列表 { ... }（声明元素类型 '" +
                          字符串复制(元素文本w) + "' 非数组）");
        } 否则 如果 (元素类型是数组w && 根是列表w) {
            // 嵌套合法：递归下一维（内层元素类型文本=元素文本w）
            检查多维数组列表逐维(池, 整32(根索引w), 字符串复制(元素文本w),
                                   符号表, 诊断);
        } 否则 如果 (!元素类型是数组w && !根是列表w) {
            // 标量元素：切片/隐式转换检查（原 812 顶层元素判定逐字·源末=根）
            整32 源末w = 整32(根索引w);
            整64 源类型x = 推导类源类型(池, 源末w, 符号表);
            布尔 切片元素x = 是切片形态(源类型x, 驻留元素类型w);
            // else 新规机械合规：切片真=已报（互斥分派 否则如果 显式枚举）
            如果 (切片元素x) {
                检查切片拒绝(源类型x, 驻留元素类型w, 诊断);
            }
            如果 (!切片元素x &&
                  !隐式转换合法(池, 源末w, 驻留元素类型w, 符号表)) {
                表诊断(诊断, "[错误] 数组元素无法将 '" +
                              推导源类型文本(池, 源末w, 符号表, 元素文本w) +
                              "' 隐式转换为 '" + 字符串复制(元素文本w) + "'");
            }
        }
        遍顶w++;
    }
    // 逐维超界（847 一维锚文案逐字·多维内层同文案·双侧一致）
    如果 (层长w > 0 && 顶层们w.大小() > 层长w) {   // 静默豁免业务值: 层长0=零长数组（811 立法无禁令·塞元素不报超界）——847 文案逐字锚同款守卫（宿主 checkArrayInitListDim 同步态）
        表诊断(诊断, "[错误] 数组初始化元素个数 " + 整数转字符串(顶层们w.大小()) +
                      " 超过数组长度 " + 整数转字符串(层长w));
    }
    返回;
}

// 475-a（D46 残余收口·#1769 轮自 语义检查语句.cn 机械搬移·零行为变更）：
//   声明初始化位构造名裸名拒绝——`结果<...> r = 正常;`（p9 探针实锤·宿主拒/
//   v2 曾静默）——474-a 返回语句位同族扩展（语句级单点·零 callee 混淆：
//   `正常(5)`=节点_调用不入判定）。59 行放行=callee/裸名共用路径**实测定案
//   维持不动**（24 族 callee 位回归实证）；赋值位/实参位=诚实边界继续登记
//   （赋值节点左值区间结构·独立轮）。集合={正常,错误}：「某些」裸名=可选
//   枚举值语义·宿主放行先例（24 族实证）。
函数 检查构造名裸名(向量<节点> 池, 节点 n, 向量<字符串>& 诊断) -> 空类型 {
    如果 (n.子终点 > n.子起点) {
        节点 初值末r = 池.元素(n.子终点 - 1);
        如果 (初值末r.类型 == 节点_标识符) {
            字符串 裸名文本r = 字符串复制(驻留文本(整64(初值末r.文本)));
            如果 (字符串比较(裸名文本r, "正常") || 字符串比较(裸名文本r, "错误")) {
                表诊断(诊断, "[错误] 构造名裸名须带参调用: " + 裸名文本r +
                            "（ 正常(值) / 错误(码) ）");
            }
        }
    }
    返回;
}
