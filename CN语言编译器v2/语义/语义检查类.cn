// CN 自举编译器 v2 · 类方法体语义检查（第七十八轮，2026-09-12）
// 职责：类方法体的函数级检查单元（第三类作用域单元，与 检查函数 同构）——
//   字段裸名解析登记 + 参数登记 + 体块检查 + 借出视图生命周期检查挂载
//   （77-a 扩展③ v2 侧收口：方法体=新的函数级扫描单元）。
// 字段解析协议（第一版）：方法体内字段名裸标识符（读/写）在语义层登记为
//   符号_变量（字段类型），IR 层经 当前方法上下文（生成类.cn）发射 this+偏移；
//   遮蔽语义=参数/局部优先（表注册 先登记胜出——登记序：参数＞字段，局部在
//   内层作用域天然优先；与 Rust 名解析同序）。
// 依赖经合并全局池（同包兄弟符号：表注册/检查块/登记函数参数们——与 语义检查.cn
//   不导入 语义分析 同款结构；显式导入仅限跨包模块）。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_* 常量
导入 IR;         // 节点_* 常量（IR常量 单一归属）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 借出检查;    // 检查借出视图生命周期（方法体挂载点）

公开:

// 字段登记：遍历类区间 节点_类字段 → 方法作用域符号注册（字段名 -> 字段类型名ID）。
//   字段类型取 字段节点.附加（类型节点索引）→ 类型节点.文本。
函数 登记类字段符号(向量<节点> 池, 整32 类节点索引,
                    向量<映射<整64, 符号>>& 符号表) -> 空类型 {
    // 234（2026-10-06·91303）：继承链字段注入——最基类先注入（子层同名后注入
    //   覆盖=遮蔽正确）；基类节点索引经 IR类 类节点索引表 沿链定位。
    节点 类节点r = 池.元素(类节点索引);
    整64 基名z = 查类基名(整64(类节点r.文本));
    如果 (基名z != 0) {
        可选<整64> 基索引查z = 查类池索引234(基名z);
        如果 (基索引查z.有值) { 登记类字段符号(池, 整32(基索引查z.值), 符号表); }
    }
    节点 类节点 = 池.元素(类节点索引);
    整64 位置 = 整64(类节点.子起点);
    当 (位置 < 整64(类节点.子终点)) {
        节点 成员 = 池.元素(整32(位置));
        如果 (成员.类型 == 节点_类字段) {
            整64 字段类型ID = 0;
            如果 (成员.附加 >= 0 && 成员.附加 < 整64(池.大小())) {
                节点 类型节点v = 池.元素(整32(成员.附加));
                // 947（002·30 族根治）：类型节点=剥星基名+附加=指针层（解析类型
                //   约定·双轨坑 B）——注册前重建完整指针文本（整64*），否则
                //   下标对象判定读到「整64」误拒「须为字符串或指针」；引用位
                //   （×256）不参与指针 '*' 形态
                字符串 完整类型947 = 字符串复制(驻留文本(整64(类型节点v.文本)));
                整64 层947 = 类型节点v.附加;
                如果 (层947 >= 256) { 层947 = 层947 - 256; }
                // 实测字段指针层 ≤1（容器/类字段单层·多级指针字段罕见）——
                // 单层直拼；多层保守回退基名（登记后续轮扩）
                如果 (层947 == 1) {
                    完整类型947 = 完整类型947 + "*";
                    字段类型ID = 驻留(完整类型947);
                } 否则 {
                    // 954（红灯治理·382）：非指针字段（层 0·字符串等）保持基名
                    //   注册——948 保守版漏 else 致字段类型ID=0（表查找 miss→
                    //   「下标对象须为字符串或指针」误拒·云端 382 实锤）
                    字段类型ID = 整64(类型节点v.文本);
                }
            }
            整64 忽略 = 表注册(符号表, 整64(成员.文本), 字段类型ID, 符号_变量, 0);
            如果 (忽略 == 0) { }
        }
        位置++;
    }
}

// 检查方法（类方法体）：作用域压入 -> 返回类型（0=构造/析构 -> 空类型） ->
//   参数登记（先）/字段登记（后——同名遮蔽=参数优先） -> 体块检查 ->
//   借出视图生命周期检查挂载 -> 弹出。
函数 检查方法(向量<节点> 池, 整32 方法节点索引, 整32 类节点索引,
               向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    清空语义指针变量表();
    清空已报成员节点926();   // 926：成员访问节点级去重标（方法体=独立函数级单元）
    清空解引用事件1471();  // 1471：安全区解引用事件表（方法体=独立函数级单元·同款）
    清空恒空表();   // 188-a（D6 B11 变量常量传播）：方法体=独立函数级单元（同款清表）
    表压入(符号表);
    节点 方法体 = 池.元素(方法节点索引);
    整64 返回类型ID = 整64(方法体.附加);
    如果 (返回类型ID == 0) { 返回类型ID = 驻留("空类型"); }
    设当前函数返回类型(返回类型ID);
    设当前函数不安全(方法体.修饰 % 2 == 1);   // 156-a：类方法修饰（位 0=不安全·9 类挂点豁免·575-a 位掩码兼容）
    // 936（002·299 根治①）：常量位判定须剥高位——修饰布局=位0不安全(1)+位1常量(2)
    //   +位2+段可见性(4×段)：公开(可见性1)+常量 → 修饰=6 → 原「/2==1」得 3≠1 误判
    //   非常量（私有(0)+常量=2 才命中=仅 私有: 段被拦·公开: 段全放行——299 实锤）
    设当前方法常量((方法体.修饰 / 2) % 2 == 1);     // 575-a（T100·299）：常量成员函数上下文（位 1=常量）
    清空当前引用参数();
    登记函数参数们(池, 方法节点索引, 符号表, 诊断);
    登记类字段符号(池, 类节点索引, 符号表);
    // 「自身」登记（方法体 this 引用——宿主 自身 参数名同款；类型=类名 ID，
    //   支持 自身.方法() 形态）
    整64 忽略自 = 表注册(符号表, 驻留("自身"), 整64(池.元素(类节点索引).文本),
                        符号_变量, 0);
    如果 (忽略自 == 0) { }
    // 328（2026-10-09·002·21 实测）：「父类」登记（基类限定调用·规格06·
    //   C++ Base::method 同款）——类型=基类名ID（父类.方法() 的成员检查按
    //   基类走）；无基类不登记=保持「未声明标识符: 父类」拒绝（宿主同语义）。
    整64 基名p328 = 查类基名(整64(池.元素(类节点索引).文本));
    如果 (基名p328 != 0) {
        整64 忽略父328 = 表注册(符号表, 驻留("父类"), 基名p328, 符号_变量, 0);
        如果 (忽略父328 == 0) { }
    }
    // 936（002·299 根治②）：类上下文槽提前到方法体语句检查前——检查赋值语句 的
    //   常量写成员检查读 读借出检查类()（原仅在借出检查段设置=语句期恒 0·第二
    //   因子恒假）；提前后语句期字段裸名解析同享类上下文（340-j「字段裸名与局部
    //   标识符同语义」口径一致化）
    设置借出检查类(整64(池.元素(类节点索引).文本));
    如果 (整64(方法体.子终点) < 池.大小()) {
        检查块(池, 方法体.子终点, 符号表, 诊断);
    }
    // 188-a（D6 B11 变量常量传播）：方法体检查收尾统一判定（恒空指针使用点报
    //   硬错误）——体块检查之后（全方法视角的不动点判定）
    判定恒空报错(诊断);
    // 1471：显式解引用段事件表收尾单点报文（方法体=独立函数级单元·同款）
    判报解引用事件1471(诊断);
    // 借出视图生命周期检查（A21 检查器的方法体扫描单元；宿主 checkClassMethods
    //   挂点同款——移植纪律 10 两侧同缺一次修全）。类上下文设置使字段裸名
    //   （`表.元素(0)` 的接收者=字段）参与接收者类型解析（借出检查 字段回退）
    设置借出检查类(整64(池.元素(类节点索引).文本));
    检查借出视图生命周期(池, 方法节点索引, 符号表, 诊断);
    设置借出检查类(0);
    设当前函数返回类型(0 - 1);
    设当前函数不安全(假);                     // 156-a：复位（防跨方法污染）
    设当前方法常量(假);                       // 575-a：常量上下文复位
    清空当前引用参数();
    表弹出(符号表);
}

// 检查类的全部方法（语义分析多文件 第二趟遍历点：节点_类 -> 本函数）
函数 检查类方法们(向量<节点> 池, 整32 类节点索引,
                   向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    节点 类节点 = 池.元素(类节点索引);
    // 340-j（50_class_private 实证）：当前检查类ID 槽——类方法体内「自身.私有
    //   字段」=合法（宿主绿）·成员访问可见性设防豁免同类（设/清成对）
    设当前检查类ID(整64(类节点.文本));
    整64 位置 = 整64(类节点.子起点);
    当 (位置 < 整64(类节点.子终点)) {
        节点 成员 = 池.元素(整32(位置));
        如果 (成员.类型 == 节点_方法) {
            检查方法(池, 整32(位置), 类节点索引, 符号表, 诊断);
        }
        位置++;
    }
    设当前检查类ID(0);
}

// 618（001 §4.4 字符串下标语义·T48/112 甲·910/596 同族收口·与宿主
//   currentIncDecOperand_ 身份比较同构）：字符串下标统一结果出口——本下标
//   节点=自增/自减直接写目标（894-a 自增表达式位登记的状态身份命中）→
//   语义层编译期显式拒绝（字符串为不可变拥有型，下标只读；原形态落 IR 层
//   「下标左值对象未支持」非语义专诊断·宿主落 #648 内部错误/静默落码）；
//   其余语境返回 整8（T48 字节读）。诊断正文与宿主逐字对齐（双侧同文）。
//   B1（#1360 结果化）：返回 结果<整64, 整32>——正常(类型ID)=合法；
//   错误(1)=已诊断拒绝（诊断同上，调用方分流不透传诊断）。
函数 字符串下标结果618(整32 节点索引, 向量<字符串>& 诊断) -> 结果<整64, 整32> {
    如果 (状态读自增写目标下标618() == 整64(节点索引)) {
        表诊断(诊断, "[错误] 字符串下标只读，不可自增/自减——字符串为不可变拥有型，原地修改请用 字符 数组或不安全区指针（112 甲）");
        返回 错误(1);
    }
    返回 正常(驻留("整8"));
}

// 259（2026-10-07·#259 静态数组·冻结线 242 迁移）：检查下标表达式 自 语义检查表达式.cn
//   机械搬移（纯搬运零行为变更·下标白名单族归属；语义检查表达式.cn 禁净增）。
// 下标表达式检查（③ 第二/三波：字符串[i] 逐字节 / 指针对象 p[i] 按元素宽度）——
//   对象白名单外的形态显式拒绝（半实现纪律：错误放行=静默垃圾地址）。
函数 检查下标表达式(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
// ③ 第二波（2026-09-03）：字符串[i] 逐字节访问（宿主 A-1 对齐：步进 1、
//   结果类型 字符）。对象白名单=字符串标识符（局部/参数）/字符串成员字段；
// ③ 第三波：指针对象 p[i]（宿主 ir_expr.cpp:1555 对齐——p[i] ≡ *(p+i)
//   步进按所指元素大小，元素类型=所指类型）。其余对象形态（字面量/调用/
//   解引用/容器/结构体/指针字段…）显式拒绝——半实现纪律：未覆盖形态
//   错误放行=静默错误代码（IR 层按指针值+步进生成，非白名单对象必产
//   垃圾地址）。
如果 (n.子起点 > 0) {
    节点 对象节点x = 池.元素(整32(n.子起点));
    // 188-a（D6·plans/023 B11 变量常量传播）：`无[i]` 字面量形态（对象=无 标记）
    //   ——编译期常量空指针下标访问 硬错误（原实现只报「下标对象形态未支持」间接错误）
    如果 (对象节点x.类型 == 节点_整数字面量 && 对象节点x.附加 == 1) {
        表诊断(诊断, "[错误] 编译期常量空指针下标访问（确定性错误；plans/023 B11）");
        返回 -1;
    }
    如果 (对象节点x.类型 == 节点_标识符) {
        // 069 乙（829 轮·用户裁决）：字符*（借用字符串视图）不支持下标（宿主对齐——
        //   原静默错值根除：视图落指针路径与 UTF-8 字节语义错位；Rust &str 同款
        //   不提供下标·须显式 字符串复制 转拥有）
        可选<整64> 对象字符星查 = 表查找类型ID(符号表, 整64(对象节点x.文本));
        如果 (对象字符星查.有值 && 对象字符星查.值 == 驻留("字符*")) {
            表诊断(诊断, "[错误] 字符*（借用字符串视图）不支持下标访问——请先 字符串复制(...) 转为拥有字符串");
            返回 -1;
        }
        // 指针对象先行（指针变量表命中即返回所指类型；与符号表字符串
        //   判定无交集——指针登记以类型节点指针层数为准，互不误伤）。
        //   所指类型白名单（IR 加载宽度覆盖面）外的显式拒绝。
        可选<整64> 查指针x查 = 查语义指针变量(整64(对象节点x.文本));
        如果 (查指针x查.有值) {
            整64 查指针x = 查指针x查.值;
            // 188-a（D6 B11 变量常量传播）：恒空候选使用点登记（面=下标访问）
            登记恒空使用点(整64(对象节点x.文本), 整64(取当前诊断行()), 3);
            // 94-a（2026-09-13 第九十四轮）：数组对象（登记=元素类型）——元素类型
            //   不受指针下标白名单限制（宿主数组元素任意类型：浮点/结构体/字符串
            //   均可；元素地址=基址+i×元素步进，加载宽度=元素宽度码）。判定=
            //   声明类型文本是数组（元素类型登记与指针登记同表，据声明文本区分）。
            布尔 数组对象x94 = 假;
            整64 对象声明类型x = 0;
            可选<整64> 对象声明类型x查 = 表查找类型ID(符号表, 整64(对象节点x.文本));
            // 原 >=0 判定：miss（原 -1）不进；登记值 0 进入后数组判定为假——同判
            如果 (对象声明类型x查.有值) { 对象声明类型x = 对象声明类型x查.值; }
            如果 (对象声明类型x查.有值 && 是数组类型文本_ID(对象声明类型x)) {
                数组对象x94 = 真;
            }
            如果 (数组对象x94) {
                // 115（918 轮）：**常量下标单次取值**（取常量下标值——语义检查
                //   初始化 单点 helper：十进制/0x/负号·文本驻留取值——附加 字段
                //   被 无 标记 153-a 复用恒 0 不可作值源；原 def-init 恒按
                //   表[0] 键判=漏报〔表[k] 未初始化读放行〕+误报噪音〔越界读
                //   连带误报未初始化〕、写点置位错键——三消费点单点修复）。
                整64 常量下标值115 = 0 - 1;
                布尔 是常量下标115 = 假;
                如果 (n.子终点 > n.子起点 + 1) {
                    是常量下标115 = 取常量下标值(池, 整32(n.子起点 + 1), 整32(n.子终点), 常量下标值115);
                }
                // 114（912 轮·001 §1.1a① 分层安全第一层立法义务）：字面量下标 ×
                //   静态数组长度——编译期能证明的必须在编译期拦（原放行到运行期
                //   错误码 2 才拦；宿主 visitIndexExpr 同款）。读写共用本检查
                //   （赋值目标语境同拦）；不安全函数内同拦（编译期确定性错误
                //   无条件）；常量传播面（变量持有常量初值）属后续常量折叠波。
                整64 长度114 = 数组长度文本(驻留文本(对象声明类型x));
                // 728w（001 §1.1a① 文本级判域）：超整64 承载下标文本（19 位 ≥2^63
                //   /≥20 位/进制超承载）——值级检查承载外，文本级可证越界补拦
                //   （宿主 visitIndexExpr 同轮对齐·双侧同拒闭环）
                如果 (越界超域文本拦728(池, 整32(n.子起点 + 1), 整32(n.子终点), 长度114, 诊断)) { 返回 -1; }
                如果 (长度114 > 0 && 是常量下标115 &&
                     (常量下标值115 < 0 || 常量下标值115 >= 长度114)) {
                    表诊断(诊断, "[错误] 编译期下标越界：常量下标 " + 整数转字符串(常量下标值115) +
                        " 超出数组长度 " + 整数转字符串(长度114) +
                        "（001 §1.1a①——编译期能证必须编译期拦；运行期越界检查错误码 2 保留兜底）");
                    返回 -1;
                }
                // 010（def-init）：数组元素读判定（常量下标精确/非常量保守；
                //   赋值目标语境抑制）。115：负值键不存在=永不命中已初始化键
