// CN 自举编译器 v2 · 类方法体语义检查（第七十八轮，2026-09-12）
// 职责：类方法体的函数级检查单元（第三类作用域单元，与 检查函数 同构）——
//   字段裸名解析登记 + 参数登记 + 体块检查 + 借出视图生命周期检查挂载
//   （77-a 扩展③ v2 侧收口：方法体=新的函数级扫描单元）。
// 字段解析协议（第一版）：方法体内字段名裸标识符（读/写）在语义层登记为
//   符号_变量（字段类型），IR 层经 当前方法上下文（生成类.cn）发射 this+偏移；
//   遮蔽语义=参数/局部优先（表注册 先登记胜出——登记序：参数＞字段，局部在
//   内层作用域天然优先；与 Rust 名解析同序）。
// 依赖经合并全局池（同包兄弟符号：表注册/检查块/登记函数参数们——与 语义检查.cn
//   不导入 语义分析 同款结构；显式导入仅限跨包模块）。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_* 常量
导入 IR;         // 节点_* 常量（IR常量 单一归属）
导入 借出检查;    // 检查借出视图生命周期（方法体挂载点）

公开:

// 字段登记：遍历类区间 节点_类字段 → 方法作用域符号注册（字段名 -> 字段类型名ID）。
//   字段类型取 字段节点.附加（类型节点索引）→ 类型节点.文本。
函数 登记类字段符号(向量<节点> 池, 整32 类节点索引,
                    向量<映射<整64, 符号>> 符号表) -> 空类型 {
    节点 类节点 = 池.元素(类节点索引);
    整64 位置 = 整64(类节点.子起点);
    当 (位置 < 整64(类节点.子终点)) {
        节点 成员 = 池.元素(整32(位置));
        如果 (成员.类型 == 节点_类字段) {
            整64 字段类型ID = 0;
            如果 (成员.附加 >= 0 && 成员.附加 < 整64(池.大小())) {
                节点 类型节点v = 池.元素(整32(成员.附加));
                字段类型ID = 整64(类型节点v.文本);
            }
            整64 忽略 = 表注册(符号表, 整64(成员.文本), 字段类型ID, 符号_变量, 0);
            如果 (忽略 == 0) { }
        }
        位置++;
    }
}

// 检查方法（类方法体）：作用域压入 -> 返回类型（0=构造/析构 -> 空类型） ->
//   参数登记（先）/字段登记（后——同名遮蔽=参数优先） -> 体块检查 ->
//   借出视图生命周期检查挂载 -> 弹出。
函数 检查方法(向量<节点> 池, 整32 方法节点索引, 整32 类节点索引,
               向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 空类型 {
    清空语义指针变量表();
    清空恒空表();   // 188-a（D6 B11 变量常量传播）：方法体=独立函数级单元（同款清表）
    表压入(符号表);
    节点 方法体 = 池.元素(方法节点索引);
    整64 返回类型ID = 整64(方法体.附加);
    如果 (返回类型ID == 0) { 返回类型ID = 驻留("空类型"); }
    设当前函数返回类型(返回类型ID);
    设当前函数不安全(方法体.修饰 == 1);   // 156-a：类方法修饰（9 类挂点豁免）
    清空当前引用参数();
    登记函数参数们(池, 方法节点索引, 符号表, 诊断);
    登记类字段符号(池, 类节点索引, 符号表);
    // 「自身」登记（方法体 this 引用——宿主 自身 参数名同款；类型=类名 ID，
    //   支持 自身.方法() 形态）
    整64 忽略自 = 表注册(符号表, 驻留("自身"), 整64(池.元素(类节点索引).文本),
                        符号_变量, 0);
    如果 (忽略自 == 0) { }
    如果 (整64(方法体.子终点) < 池.大小()) {
        检查块(池, 方法体.子终点, 符号表, 诊断);
    }
    // 188-a（D6 B11 变量常量传播）：方法体检查收尾统一判定（恒空指针使用点报
    //   硬错误）——体块检查之后（全方法视角的不动点判定）
    判定恒空报错(诊断);
    // 借出视图生命周期检查（A21 检查器的方法体扫描单元；宿主 checkClassMethods
    //   挂点同款——移植纪律 10 两侧同缺一次修全）。类上下文设置使字段裸名
    //   （`表.元素(0)` 的接收者=字段）参与接收者类型解析（借出检查 字段回退）
    设置借出检查类(整64(池.元素(类节点索引).文本));
    检查借出视图生命周期(池, 方法节点索引, 符号表, 诊断);
    设置借出检查类(0);
    设当前函数返回类型(0 - 1);
    设当前函数不安全(假);                     // 156-a：复位（防跨方法污染）
    清空当前引用参数();
    表弹出(符号表);
}

// 检查类的全部方法（语义分析多文件 第二趟遍历点：节点_类 -> 本函数）
函数 检查类方法们(向量<节点> 池, 整32 类节点索引,
                   向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 空类型 {
    节点 类节点 = 池.元素(类节点索引);
    整64 位置 = 整64(类节点.子起点);
    当 (位置 < 整64(类节点.子终点)) {
        节点 成员 = 池.元素(整32(位置));
        如果 (成员.类型 == 节点_方法) {
            检查方法(池, 整32(位置), 类节点索引, 符号表, 诊断);
        }
        位置++;
    }
}
