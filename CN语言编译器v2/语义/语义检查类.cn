    // 596（2026-10-13·244 接续·859 实锤形态同族）：字符串字面量就地下标
    //   （"ABCDE"[i]）读=字节视图，同字符串变量口径（T48 裁决甲：UTF-8 字节
    //   索引·结果 整8；001 §4.5 优先级13 后缀 () [] 同级可链）。原落白名单
    //   外拒=与宿主分叉（宿主 596 同轮 IR 层 i8 字节视图+运行期越界检查放行；
    //   v2 生成下标访问 字符串路径同防线）。写形态由 族②检查下标左值形态
    //   独立拒绝（对象=字面量非标识符/成员→「下标左值赋值未支持」·双侧同拒）
    //   不受本分支影响。
    如果 (对象节点x.类型 == 节点_字符串字面量) {
        // B1（#1360 结果化）：正常=类型ID；错误(1)=已诊断拒绝→原 -1 出口
        结果<整64, 整32> 字串果618e = 字符串下标结果618(节点索引, 诊断);
        如果 (字串果618e.正常) {
            整64 字串型618e = 字串果618e.值;
            返回 字串型618e;
        } 否则 {
            返回 -1;
        }
    }
    表诊断(诊断, "[错误] 下标对象形态未支持（须字符串变量/字符串字段/指针变量）");
    返回 -1;
}
返回 -1;
    返回 -1;
}

// ==================== 279：指针下标白名单（自 语义分析.cn 机械搬移·纯搬运；279 扩面随体） ====================
// ③ 第三波：指针下标所指类型白名单（IR 指针加载宽度分支覆盖面）：整系/正系/
//   布尔/字符/字符串；浮点（v2 指针加载无浮点分支）/结构体/容器/结果（元素
//   语义须返回地址而非加载值）显式拒绝——半实现纪律：未覆盖形态不放行。
函数 指针下标所指合法(字符串 名) -> 布尔 {
    // 279：扩结构体/类/枚举/128（宿主 p[i] 放行·npok+越界通道既有仍安全；
    //   原只认标量/字符串=09 学生* 索引 v2 拒宿主放行分叉）。
    返回 字符串比较(名, "整8") || 字符串比较(名, "整16") ||
           字符串比较(名, "整32") || 字符串比较(名, "整64") ||
           字符串比较(名, "正8") || 字符串比较(名, "正16") ||
           字符串比较(名, "正32") || 字符串比较(名, "正64") ||
           字符串比较(名, "布尔") || 字符串比较(名, "字符") ||
           字符串比较(名, "字符串") ||
           字符串比较(名, "整128") || 字符串比较(名, "正128") ||
           查结构体大小(驻留(名)) != 0 || 是用户类(名) ||
           是枚举名(驻留(名));
}

