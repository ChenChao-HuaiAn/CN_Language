// 语义检查中（357 重构F2 自 语义检查.cn 纯机械搬移·函数体逐字保留·零逻辑变化；
//   767 拆分：二元/三元运算检查族 341 行迁 语义检查运算.cn——997 行贴死 1000
//   冻结线先拆再加·推导族/497 字面量域/检查块/检查遍历894 留守本文件）

导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（原 导入 语法分析，目录包名）
导入 IR;         // 容器/结果 合成名判定 + 节点_*/键位移 常量（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 借出检查;    // 第七十七轮 A21：借出视图生命周期检查（函数级调用）
导入 语义检查逃逸;   // 435：lambda 引用捕获逃逸检查（返回/赋值/实参/声明位·包内兄弟）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// ==================== 497 推断声明无后缀字面量真值域定宽（双侧零分叉） ====================
// 十进制数字文本是否超上界（位数+字典序·宿主 types::textExceedsInt64 同构）：
//   位数多于上界位数必超；少则必不超；相等逐位字典序比较（恰等=不超）。
函数 十进制文本超上界(字符串 文本, 整64 位数, 字符串 上界) -> 布尔 {
    整64 长 = 字符串长度(文本);
    如果 (长 != 位数) { 返回 长 > 位数; }
    整64 k = 0;
    当 (k < 位数) {
        整64 a = 整64(文本[k]) & 255;
        整64 b = 整64(上界[k]) & 255;
        如果 (a > b) { 返回 真; }
        如果 (a < b) { 返回 假; }
        k++;
    }
    返回 假;
}

// 497：无后缀纯十进制整数字面量真值域改判（宿主
//   SemanticAnalyzer::inferredLiteralWidthType 同构·001 规范 218「无后缀大
//   字面量提升链」+规范 048 §5.2 类型推断）——超 整32 正域且 整64 域内→整64；
//   超 整64 域且 整128 域内→整128（负形态负界容 -2^127）。原语义面恒整32→
//   推断声明落 32 位槽静默截断（99999999999999999999 出 1661992959 实锤）。
//   返回 驻留类型名ID；0=不改判（整32 域内既有契约不动/非纯十进制〔0x 前缀·
//   L/U 后缀=用户显式位宽意图·001 未立法面〕/超整128 域〔宿主
//   visitIntegerLiteral 超界诊断面对齐〕）。
函数 推断字面量域ID(字符串 文本, 布尔 负形) -> 整64 {
    整64 长度 = 字符串长度(文本);
    如果 (长度 <= 0 || 长度 > 39) { 返回 0; }
    整64 i = 0;
    当 (i < 长度) {
        整64 c = 整64(文本[i]) & 255;
        如果 (c < 48 || c > 57) { 返回 0; }   // 非纯十进制（后缀/进制前缀）不改判
        i++;
    }
    如果 (!十进制文本超上界(文本, 10, "2147483647")) { 返回 0; }
    如果 (!十进制文本超上界(文本, 19, "9223372036854775807")) { 返回 驻留("整64"); }
    如果 (长度 < 39) { 返回 驻留("整128"); }
    // 39 位：与界串逐位比——负形负界 |−2^127|·正形正界 2^127−1（恰等=域内）
    字符串 限串128 = 负形 ? "170141183460469231731687303715884105728"
                        : "170141183460469231731687303715884105727";
    如果 (十进制文本超上界(文本, 39, 限串128)) { 返回 0; }
    返回 驻留("整128");
}

// ==================== 46-c 推断声明类型推导（2026-09-10 第四十九轮） ====================
// 推断声明的类型权威推导（单点；IR 层经 推断声明类型表 查表消费）：
//   表达式类型ID——区间末节点=表达式根（线性化约定，检查表达式 二元/三元
//   同款技巧）：成员/二元走专用推导（检查表达式 对两者恒 整64/-1 半实现，
//   推断声明不可静默降级——成员误推整64 会让结构体值截断进 8 字节槽=46-a
//   家族静默错误代码）；其余（字面量/标识符/调用/下标/三元）经 检查表达式
//   既有精确推导。-1=不可推导（调用方可见诊断，语义错误即中止兜底）。
函数 表达式类型ID(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    如果 (n.类型 == 节点_成员) { 返回 推导成员类型ID(池, 节点索引, 符号表, 诊断); }
    如果 (n.类型 == 节点_二元运算) { 返回 推导二元类型ID(池, 节点索引, 符号表, 诊断); }
    // 497：推断声明整数字面量真值域定宽（含一元负号形态·宿主同构）——
    //   检查表达式 对字面量恒整32（既有契约不动），此处推断声明专用面按
    //   文本真值域改判（推断字面量域ID：0=不改判落原路径）。
    如果 (n.类型 == 节点_整数字面量) {
        整64 域ID497 = 推断字面量域ID(驻留文本(整64(n.文本)), 假);
        如果 (域ID497 > 0) { 返回 域ID497; }
    }
    如果 (n.类型 == 节点_负号 && n.子终点 > n.子起点) {
        节点 操作数497 = 池.元素(整32(n.子终点) - 1);
        如果 (操作数497.类型 == 节点_整数字面量) {
            整64 域ID497 = 推断字面量域ID(驻留文本(整64(操作数497.文本)), 真);
            如果 (域ID497 > 0) { 返回 域ID497; }
        }
    }
    // 414（#414·宿主 checkUnaryOperatorOverload 同构）：单目 - ! ~ 操作数为类
    //   实例且命中「运算符X」（0 右参）→ 返回重载方法返回类型。P0-3 起位非
    //   不再解析期脱糖（树中恢复 节点_位非）。未命中回退=宿主内置产物面：
    //   负号/位非→操作数类型、逻辑非→布尔（检不出 -1 落下方既有路径）。
    如果 (n.类型 == 节点_负号 || n.类型 == 节点_逻辑非 || n.类型 == 节点_位非) {
        整64 一元ID414 = 一元重载返回ID(池, 节点索引, 符号表);
        如果 (一元ID414 > 0) { 返回 一元ID414; }
        如果 (n.类型 == 节点_逻辑非) { 返回 驻留("布尔"); }
        如果 (n.子终点 > n.子起点 && n.子终点 <= 整32(池.大小())) {
            向量<字符串> 静默U414 = 向量<字符串>();
            整64 操作数ID414 = 表达式类型ID(池, 整32(n.子终点) - 1, 符号表, 静默U414);
            如果 (操作数ID414 > 0) { 返回 操作数ID414; }
        }
    }
    // 951（002·B 类推断面·183/484 族）：结构体构造字面量（名{ 字段 = 值 }）
    //   ——类型=结构体名自身（节点_结构体构造.文本=结构体名 ID·解析层 84-a）
    如果 (n.类型 == 节点_结构体构造) { 返回 整64(n.文本); }
    返回 检查表达式(池, 节点索引, 符号表, 诊断);
}

// 成员读类型推导（46-a 家族同源机制，同构 IR生成 解析成员链结构体ID 范本——
//   父链三形态：标识符（变量结构体表 键基直查>1；标量/容器走符号表类型名归一）/
//   成员（递归）/调用（返回类型名归一））。返回字段类型名ID；-1=不可推导。
函数 推导成员类型ID(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 整64 {
    节点 m = 池.元素(节点索引);
    整64 父键基 = 0;
    如果 (m.子起点 >= 0 && m.子起点 < 池.大小()) {
        节点 对象m = 池.元素(整32(m.子起点));
        如果 (对象m.类型 == 节点_标识符) {
            // 变量结构体表：值>1=键基（结构体对象直查）；1=结构体名标记/
            //   0/-1=非结构体——标量/容器走符号表类型名（字符串字段等非
            //   结构体成员经 查结构体类型 归一 miss=-1 可见）
            整64 键v = 查变量结构体键(整64(对象m.文本));
            如果 (键v > 1) {
                父键基 = 键v;
            } 否则 {
                整64 对象类型ID = 检查标识符表达式(池, 整32(m.子起点), 符号表, 诊断);
                如果 (对象类型ID > 0) { 父键基 = 查结构体类型(对象类型ID); }
            }
            // 154-a（B9 v2 挂点）：**裸指针成员访问**（p.字段——CN 的 . 自动解引用
            //   一级；与宿主 B9 同族）。判定=指针变量表命中；字符串语义（字符*/
            //   字符串）在宿主经 isStringSemanticType 豁免——v2 树已全量迁移
            //   （不安全 修饰），存量零警告；用户侧从严（波 6 与宿主统一）。
            整64 查指针m = 查语义指针变量(整64(对象m.文本));
            如果 (查指针m >= 0) {
                错误不安全边界(诊断, "指针成员访问", "指针成员访问（p.字段）");
            }
        } 否则 如果 (对象m.类型 == 节点_成员) {
            整64 父字段ID = 推导成员类型ID(池, 整32(m.子起点), 符号表, 诊断);
            如果 (父字段ID > 0) { 父键基 = 查结构体类型(父字段ID); }
        } 否则 如果 (对象m.类型 == 节点_调用) {
            整64 返回类型ID = 检查调用表达式(池, 整32(m.子起点), 符号表, 诊断);
            如果 (返回类型ID > 0) { 父键基 = 查结构体类型(返回类型ID); }
        }
    }
    如果 (父键基 <= 0) { 返回 -1; }
    整64 字段ID = 查字段类型ID(父键基, 整64(m.文本));
    如果 (字段ID == 0) {
        // 951（002·B 类·104 族）：成员=类**方法引用**（对象.方法 作值——字段
        //   表 miss 后按类方法表回退：父链结构体名→查类节点→扫 节点_方法
        //   命中名→返回方法返回类型 ID（节点_方法.附加）；实例方法引用是
        //   函数指针形态（宿主 funcFirstSigKey 同族）
        整64 类节点951 = 查类节点索引(父键基);
        如果 (类节点951 >= 0 && 类节点951 < 池.大小()) {
            节点 类值951 = 池.元素(整32(类节点951));
            整64 扫951 = 整64(类值951.子起点);
            当 (扫951 < 整64(类值951.子终点)) {
                节点 成员m951 = 池.元素(整32(扫951));
                如果 (成员m951.类型 == 节点_方法 &&
                     整64(成员m951.文本) == 整64(m.文本) &&
                     成员m951.附加 > 0) {
                    返回 整64(成员m951.附加);
                }
                扫951++;
            }
        }
        返回 -1;
    }
    返回 字段ID;
}

// 二元运算类型推导（左右操作数区间末节点递归+同族可合并取左——检查表达式
//   二元节点布局约定：附加=右操作数起点、左末=附加-1、右末=本索引-1〔469〕）。
//   任一侧不可推导/跨族=整体 -1（绝不静默降级整64——推断声明类型错误是
//   静默错误代码温床）。返回操作数类型名ID；-1=不可推导。
函数 推导二元类型ID(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    // 414（#414 运算符重载·宿主 checkClassOperatorOverload 同构）：重载决议
    //   顺序②——左操作数为用户类且沿链命中「运算符X」→ 返回重载方法返回类型
    //   （先于内置合并推导；未命中 -1 落回下方既有推导=顺序③守卫兜底）
    整64 重载ID414 = 二元重载返回ID(池, 节点索引, 符号表);
    如果 (重载ID414 > 0) { 返回 重载ID414; }
    // 469（450 同族第四轮·左末口径统一 子起点-1→附加-1）：全构建形态契约=
    //   附加=右操作数起点→左操作数**末端**=附加-1（970/425/418/450 同口径；
    //   复合赋值/自增自减合成二元 子起点=左值副本起点 错位面·详注=450 面）。
    如果 (n.附加 <= 0 || n.附加 > 整32(池.大小())) { 返回 -1; }
    整64 左ID = 表达式类型ID(池, 整32(n.附加 - 1), 符号表, 诊断);
    整64 右ID = 表达式类型ID(池, 整32(节点索引 - 1), 符号表, 诊断);
    // 155-a A1 挂点原位于此（推导二元类型ID）——157-a 实测失效（表达式类型ID
    //   对指针变量返 -1）已移除；A1 判定统一下沉 检查表达式 二元分支
    //   （查语义指针变量 判定，声明/赋值/表达式全路径覆盖）。
    如果 (左ID <= 0 || 右ID <= 0) { 返回 -1; }
    如果 (!类型可合并(左ID, 右ID)) { 返回 -1; }
    返回 左ID;
}

不安全 函数 检查语句(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    节点 n = 池.元素(节点索引);
    // 103-a（D2）：设当前诊断行=语句根行（解析块 单点回填；0=未知→表诊断
    //   不带行号，存量兼容）——语义诊断自此带源码行号（对齐语法层（行=）格式）
    设当前诊断行(n.行);
    如果 (n.类型 == 节点_返回语句) {
        // 71-a：返回位装箱语境——当前函数返回类型为 结果/可选 时设置（构造器
        //   正常/错误/某些 的类型推导依据；区间检查后复位）
        布尔 返回位语境71 = 假;
        如果 (n.子终点 > n.子起点 && 当前函数返回类型 >= 0) {
            如果 (是结果类型_ID(当前函数返回类型)) {
                设装箱语境884(当前函数返回类型);
                返回位语境71 = 真;
            }
        }
        // 474-a（D46）：结果/可选构造名裸名拒绝——`返回 正常;` 裸标识符形态。
        //   71-a 的被调标识符放行=调用位 callee 专属（语义检查表达式 59）·裸名
        //   位经同一路径静默过→生成层产物垃圾（p8 探针双侧实锤：宿主 check
        //   rc=1 拒绝〔函数指针转换形态〕·v2 rc=0 静默）——构造须带参调用
        //   正常(值)/错误(码)/某些(值)。仅返回语句位单点（表达式位裸名=同族
        //   残余·021 D46 行登记）；`返回 正常(5);`=节点_调用 不入此判定不误伤。
        如果 (n.子终点 > n.子起点) {
            节点 返回表达式474 = 池.元素(整32(n.子终点 - 1));
            如果 (返回表达式474.类型 == 节点_标识符) {
                字符串 裸名文本474 = 字符串复制(驻留文本(整64(返回表达式474.文本)));
                如果 (字符串比较(裸名文本474, "正常") || 字符串比较(裸名文本474, "错误") ||
                     字符串比较(裸名文本474, "某些")) {
                    表诊断(诊断, "[错误] 构造名裸名须带参调用: " + 裸名文本474 +
                                "（ 正常(值) / 错误(码) / 某些(值) ）");
                }
            }
        }
        整64 i = 整64(n.子起点);
        当 (i < 整64(n.子终点)) {
            整64 忽略 = 检查表达式(池, 整32(i), 符号表, 诊断);
            如果 (忽略 == -1) { }
            i++;
        }
        如果 (返回位语境71) { 设装箱语境884(0); }   // 71-a：语境复位
        // 55-c 方案A（2026-09-10 第五十六轮 用户裁决）：返回面混合符号拒绝——
        //   返回类型（当前函数返回类型名ID）与返回值表达式类型「变量间」跨符号
        //   拒绝；字面量豁免（检查混合符号赋值，语义检查表达式 模块）。
        //   顶层静态声明初始化不经 返回语句；无返回值（子终点==子起点）跳过。
        如果 (n.子终点 > n.子起点 && 当前函数返回类型 >= 0) {
            检查混合符号赋值(池, 当前函数返回类型, n.子终点 - 1, 符号表, 诊断);
        }
        // 329-a（D38 批2·305/350）：返回面标量隐式转换检查——隐式转换仅宽化
        //   （字符串→整32 t11/布尔→整32 t12/整64→整32 窄化 t13 拒；整→浮/整→整
        //   宽化放行）。结果/可选/容器/类结构体目标=装箱与拷贝构造语义在
        //   隐式转换合法 内跳过；指针/引用返回类型文本非标量亦跳过（103 面管辖）。
        如果 (n.子终点 > n.子起点 && 当前函数返回类型 >= 0) {
            检查标量隐式转换(池, 整32(n.子终点 - 1), 当前函数返回类型, 符号表, 诊断, 真);
        }
        // 413-b（审查 P1-2）：返回面「类→接口」隐式转换检查（宿主 visitReturnStmt
        //   canConvertType 接口段同构·声明/赋值面同文本）——当前函数返回类型=
        //   接口 且 返回表达式可静默推导为用户类 → 须 类实现接口沿链。
        如果 (n.子终点 > n.子起点 && 当前函数返回类型 > 0 &&
             是接口名ID(当前函数返回类型)) {
            整64 返源ID413 = 推导源类型ID静默(池, 整32(n.子终点 - 1), 符号表);
            如果 (返源ID413 > 0 && 是用户类_ID(返源ID413) &&
                 !类实现接口沿链(返源ID413, 当前函数返回类型)) {
                // 文本与宿主返回面对齐（带「返回类型」段——p4 探针实测锚）
                表诊断(诊断, "[错误] 无法将 '" + 驻留文本(返源ID413) +
                              "' 隐式转换为返回类型 '" +
                              驻留文本(当前函数返回类型) + "'");
            }
        }
        // 373（v17 六族对齐批·001 §07§一B）：返回类型=结果/可选 时——返回表达式
        //   须显式 某些()/正常()/错误() 包装或同为盒子类型；裸标量编译期拒绝
        //   （宿主 visitReturnStmt·canConvertType 同构·文案逐字对齐。v2 修前
        //   放行且产物 0xC0000005——c359 run_err 实证=双目标②安全面违反）。
        //   推导经 表达式类型ID（传播节点已有拆包类型精确推导·检查错误传播
        //   表达式 524 返回 T）；推导 -1=检不出跳过（诚实边界·推导源类型ID
        //   静默 同纪律）；二次推导诊断吞弃（609-a 惯例·静默缓冲）。包装调用
        //   豁免（71-a 构造名）先于推导——`返回 某些(x);` 形态零推导依赖。
        如果 (n.子终点 > n.子起点 && 当前函数返回类型 >= 0 &&
             是结果类型_ID(当前函数返回类型)) {
            节点 末端373 = 池.元素(整32(n.子终点 - 1));
            布尔 包装373 = 假;
            如果 (末端373.类型 == 节点_调用 && 末端373.子起点 >= 0 &&
                 末端373.子起点 < 整32(池.大小())) {
                节点 被调373 = 池.元素(末端373.子起点);
                如果 (被调373.类型 == 节点_标识符) {
                    字符串 被调文本373 = 字符串复制(驻留文本(整64(被调373.文本)));
                    如果 (字符串比较(被调文本373, "正常") || 字符串比较(被调文本373, "错误") ||
                         字符串比较(被调文本373, "某些")) {
                        包装373 = 真;
                    }
                }
            }
            // 458 云端红根治：构造名**裸名**形态（`返回 正常;`）已由 474-a 单点
            //   执法（本分支早段）——本执法不再叠加返回位转换错（裸名推导=整64
            //   占位→多报破坏诊断数契约·458 负测期望 2 错实锤）。
            如果 (末端373.类型 == 节点_标识符) {
                字符串 裸名文本373 = 字符串复制(驻留文本(整64(末端373.文本)));
                如果 (字符串比较(裸名文本373, "正常") || 字符串比较(裸名文本373, "错误") ||
                     字符串比较(裸名文本373, "某些")) {
                    包装373 = 真;
                }
            }
            如果 (!包装373) {
                // 60/588 云端红根治：`返回 无;` 到 **可选** 函数=合法空值返回
                //   （宿主实测放行·无=153-a 空字面量标记 附加==1）；结果 函数
                //   宿主拒（空类型*→结果不可转·tmp_none 探针实测）=同拒对齐。
                布尔 是无字面373 = 末端373.类型 == 节点_整数字面量 && 末端373.附加 == 1;
                如果 (!(是无字面373 && 是可选类型_ID(当前函数返回类型))) {
                    向量<字符串> 静默诊断373 = 向量<字符串>();
                    整64 源类型373 = 表达式类型ID(池, 整32(n.子终点 - 1), 符号表, 静默诊断373);
                    如果 (源类型373 > 0 && 源类型373 != 当前函数返回类型) {
                        // 源文本对齐宿主：无→结果 面 宿主报 空类型*（非 整32）
                        字符串 源文本373 = 字符串复制(驻留文本(源类型373));
                        如果 (是无字面373) { 源文本373 = "空类型*"; }
                        表诊断(诊断, "[错误] 无法将 '" + 源文本373 +
                                    "' 隐式转换为返回类型 '" +
                                    字符串复制(驻留文本(当前函数返回类型)) + "'");
                    }
                }
            }
        }
        // 210-a（2026-09-15 第两百一十轮，D1 行数整改）：返回面借用检查两段迁族——
        //   检查返回借用A2（阶段4' A2 拥有契约）+检查返回局部地址（阶段2 悬垂拒绝），
        //   守卫（返回类型字符串/指针引用 + 有返回值）随族走——纯检查零行为变更。
        检查返回借用A2(池, n, 符号表, 诊断);
        检查返回局部地址(池, n, 符号表, 诊断);
        // 435：lambda 引用捕获逃逸——返回位检查（值含 [&] 非空捕获 lambda/
        //   传播表变量=逃逸拒绝·不安全 函数 豁免；宿主 checkReturn 同构，
        //   实现=语义检查逃逸.cn）
        检查返回位lambda逃逸(池, n, 符号表, 诊断, 引用lambda变量们);  // 486：主表
        返回;
    }
    // 884-a（070·G-N·537 B/C 前置）：**静态声明初值检查**——原静态声明初值无
    //   语义检查（仅 收集静态声明 登记符号）→ 结果/可选 构造器初值无装箱标注
    //   （IR「构造器装箱类型语境未知」·537 静态局部/顶层静态两段实锤）。
    // 324 甲案（2026-10-09 用户批）：函数内静态无初值拒绝（001 豁免面删「静态（零初始化）」·E0381 对齐·顶层静态放行不变·修饰=1=865-a 函数内标记）
    如果 (n.类型 == 节点_静态声明 && n.修饰 == 1 && 整64(n.子起点) >= 整64(n.子终点)) { 表诊断(诊断, "[错误] 静态变量 '" + 合成名基名(驻留文本(整64(n.文本))) + "' 未初始化，不能读取（无初值·#324）"); }
    如果 (n.类型 == 节点_静态声明) { 检查静态声明初值884(池, n, 符号表, 诊断); }
    如果 (n.类型 == 节点_变量声明) {
        检查变量声明语句(池, 节点索引, 符号表, 诊断);
        返回;
    }
    如果 (n.类型 == 节点_赋值) {
        检查赋值语句(池, 节点索引, 符号表, 诊断);
        返回;
    }
    如果 (n.类型 == 节点_自增) {
        整64 目标类型 = 表查找类型ID(符号表, 整64(n.文本));
        // 070 波G：类内静态字段裸名回退（同 标识符表达式 口径）
        如果 (目标类型 == -1 && 查当前检查类ID() != 0 &&
             查类静态字段类型(查当前检查类ID(), 整64(n.文本)) != 0) {
            目标类型 = 查类静态字段类型(查当前检查类ID(), 整64(n.文本));
        }
        // 434（类名::静态字段 限定写·#284 ::矩阵第五态）：限定复合名回退——
        //   宿主 `类名::字段++` 经 UnaryExpr ++ 左值通道放行（434 探针 inc 实锤），
        //   v2 复合文本取 查限定名静态字段类型 单点分派（IR 发射自增自减
        //   查限定名静态序号 同源）
        如果 (目标类型 == -1) {
            整64 限增434 = 查限定名静态字段类型(整64(n.文本));
            如果 (限增434 > 0) { 目标类型 = 限增434; }
        }
        // 188-a（D6 B11 变量常量传播）：自增=隐式非空写入 → 恒空判定失格
        登记恒空失格(整64(n.文本));
        // 480（473 p9·001 §747 表第 8 行整族执法）：可变静态变量写 自增形态
        //   ——顶层静态（原漏网·x 探针）与函数内静态局部（合成名）同受约束；
        //   不安全 函数内豁免（错误不安全边界 内建）。宿主 checkIncDecUnary 同构。
        如果 (是全局静态名(整64(n.文本)) || 是静态局部名(整64(n.文本))) {
            错误不安全边界(诊断, "静态变量写", "静态变量自增自减");
        }
        如果 (目标类型 == -1) {
            表诊断(诊断, "[错误] 自增目标未声明: " + 驻留文本(整64(n.文本)));
        }
        // 缺陷②同族（2026-09-03 用户裁决立案）：自增是隐式赋值——常量不可自增
        //   （宿主 visitUnaryExpr ++/-- 常量拒绝对齐；v2 解析器仅支持 ++标识符/
        //   标识符++，结构性无歧义，仅需常量检查）
        如果 (表查找种类(符号表, 整64(n.文本)) == 符号_常量) {
            表诊断(诊断, "[错误] 不能对常量自增（常量初始化后不可修改）: " +
                          驻留文本(整64(n.文本)));
        }
        返回;
    }
    // 簇③根治·自减全链 C1（2026-09-04 用户裁决）：与 节点_自增 完全对称——
    //   未声明诊断 + 常量拒绝（自减同为隐式赋值）
    如果 (n.类型 == 节点_自减) {
        整64 目标类型减 = 表查找类型ID(符号表, 整64(n.文本));
        // 446：类内裸名静态回退（自增 070 波G 同构·原缺位误拒「自减目标未声明」）
        如果 (目标类型减 == -1 && 查当前检查类ID() != 0 && 查类静态字段类型(查当前检查类ID(), 整64(n.文本)) != 0) {
            目标类型减 = 查类静态字段类型(查当前检查类ID(), 整64(n.文本));
        }
        // 434：限定复合名回退（节点_自增 同款单点分派——`类名::字段--` 宿主放行）
        整64 限减434 = 查限定名静态字段类型(整64(n.文本));
        如果 (限减434 > 0) { 目标类型减 = 限减434; }
        // 188-a（D6 B11 变量常量传播）：自减=隐式非空写入 → 恒空判定失格
        登记恒空失格(整64(n.文本));
        // 480（同 节点_自增 挂点）：静态写 自减形态（顶层静态/函数内静态局部·
        //   001 §747 表第 8 行整族执法）；不安全 函数内豁免。
        如果 (是全局静态名(整64(n.文本)) || 是静态局部名(整64(n.文本))) {
            错误不安全边界(诊断, "静态变量写", "静态变量自增自减");
        }
        如果 (目标类型减 == -1) {
            表诊断(诊断, "[错误] 自减目标未声明: " + 驻留文本(整64(n.文本)));
        }
        如果 (表查找种类(符号表, 整64(n.文本)) == 符号_常量) {
            表诊断(诊断, "[错误] 不能对常量自减（常量初始化后不可修改）: " +
                          驻留文本(整64(n.文本)));
        }
        返回;
    }
    如果 (n.类型 == 节点_中断语句 || n.类型 == 节点_继续语句) {
        返回;
    }
    // 609-a（T100·003 123 规则1 对齐宿主 checkResultDiscard·规范07 四）：
    //   结果<T,E> 返回值被丢弃未检查 -> 错误（表达式语句根区间末端=调用形态，
    //   如 `字典.设置(3,300);`）。赋值/声明接收不入本判定=宿主同口径（变量
    //   随后可检查·未检查访问 .值 由规则3 面拦截）；普通表达式（结果.正常
    //   读取）非调用节点不拦。类型经静默诊断缓冲推导（174 教训惯例）。
    //   stdlib 容器方法面：通用推导对池外类（stdlib 类不在编译池）整64 兜底
    //   ——604-a 只覆盖池内用户类——被调=成员 且对象类型=$ 合成名 时经
    //   IR签名 签名表回退（键=合成名基名(接收者).方法名.实参数·n.附加·
    //   IR 层同款·确保签名已加载 幂等）；返回原文（泛型替换前 `结果<空类型,整32>`
    //   形态）以 结果</可选< 前缀判定（是结果类型 只认 $ 合成名·原文不适用
    //   ——精确实例化文本由 IR 层 查方法签名 替换既有）。回退面收窄于本
    //   判定单点（原文类型 ID 不进通用推导——防声明位隐式转换误伤）。
    如果 (n.类型 == 节点_表达式语句 && n.子终点 > n.子起点) {
        节点 表达式语句末609 = 池.元素(整32(n.子终点 - 1));
        如果 (表达式语句末609.类型 == 节点_调用 &&
             !是副作用内置被调(池, 整32(n.子终点 - 1))) {
            向量<字符串> 静默r1 = 向量<字符串>();
            整64 语句末类型609 = 表达式类型ID(池, 整32(n.子终点 - 1), 符号表, 静默r1);
            布尔 是结果609 = 语句末类型609 > 0 &&
                          是结果类型_ID(语句末类型609);
            如果 (!是结果609 && 表达式语句末609.子起点 > 0) {
                节点 被调r1 = 池.元素(整32(表达式语句末609.子起点));
                如果 (被调r1.类型 == 节点_成员 && 被调r1.子起点 > 0) {
                    节点 对象r1 = 池.元素(整32(被调r1.子起点));
                    如果 (对象r1.类型 == 节点_标识符) {
                        整64 对象类型r1 = 表查找类型ID(符号表, 整64(对象r1.文本));
                        如果 (对象类型r1 > 0) {
                            字符串 基名r1 = 合成名基名(字符串复制(驻留文本(对象类型r1)));
                            如果 (字符串长度(基名r1) > 0 &&
                                 整64(表达式语句末609.附加) > 0) {
                                确保签名已加载();
                                整64 键r1 = 驻留(基名r1 + "." +
                                              字符串复制(驻留文本(整64(被调r1.文本))) +
                                              "." + 整数转字符串(整64(表达式语句末609.附加)));
                                整64 查返r1 = 查签名返回(键r1);
                                如果 (查返r1 >= 0) {
                                    字符串 返原文r1 = 字符串复制(驻留文本(查返r1));
                                    如果 (字符串长度(返原文r1) >= 7 &&
                                         (字符串比较(字符串子串(返原文r1, 0, 7), "结果<") ||
                                          字符串比较(字符串子串(返原文r1, 0, 7), "可选<"))) {
                                        是结果609 = 真;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            如果 (是结果609) {
                表诊断(诊断, "[错误] 结果<正常,错误> 返回值被丢弃未检查（须用 结果.正常 检查后处理两个分支）");
            }
        }
    }
    // 一元（逻辑非/负号/取地址/解引用）裸节点分支已删除（缺陷②分诊根治）：
    //   检查块 现仅派发语句根节点——裸一元节点的操作数由所属语句根的区间检查
    //   统一覆盖（原分支=块级裸派发兜底，双重处理/前向引用误报根源）
    // P6c：成员偏移标注（通用表达式区间）
    整64 标4 = 标注成员偏移(池, n.子起点, n.子终点, 符号表, 诊断);
    如果 (标4 == -1) { }
    整64 i = 整64(n.子起点);
    当 (i < 整64(n.子终点)) {
        整64 忽略 = 检查表达式(池, 整32(i), 符号表, 诊断);
        如果 (忽略 == -1) { }
        i++;
    }
}

// 检查块（新作用域：压入/弹出）
// ③ 第二波根治（2026-09-03）：父层区间原始遍历会先处理嵌套块（当体/如果体/裸块）
//   的语句、随后控制节点递归再处理一遍——嵌套声明泄漏注册到父层作用域（块级遮蔽
//   检查被自注册误触发，126/127 无真实遮蔽也误报；符号作用域语义错误）。修复：
//   预收集全部嵌套体块区间，主循环跳过——嵌套语句只在递归作用域内处理一次。
函数 检查块(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    表压入(符号表);
    节点 块 = 池.元素(节点索引);
    向量<整64> 跳过区间们 = 向量<整64>();
    整64 预扫i = 整64(块.子起点);
    当 (预扫i < 整64(块.子终点)) {
        节点 预节点 = 池.元素(整32(预扫i));
        如果 (预节点.类型 == 节点_块) {
            // 裸块：语句区间 [块.子起点, 块节点自身)——块节点由主循环派发递归
            登记跳过区间(跳过区间们, 整64(预节点.子起点), 预扫i);
        } 否则 如果 (预节点.类型 == 节点_当语句) {
            // 当：体块@附加，区间 [体块.子起点, 体块节点]（含体块节点——检查当 递归）
            节点 当体块 = 池.元素(预节点.附加);
            登记跳过区间(跳过区间们, 整64(当体块.子起点), 整64(预节点.附加) + 1);
        } 否则 如果 (预节点.类型 == 节点_遍历语句) {
            // 894-a（070·G-N 特性波3·61/97）：遍历——**迭代对象区+体块全跳过**
            //   [遍历.文本, 遍历索引)（生成层同款区间）：迭代变量登记发生在
            //   检查遍历 内·外层先查体内必报「未声明」——循环的 [循环+1, 附加+1)
            //   空区间靠「幂等双查」救场（无前向登记依赖）·遍历不适用
            登记跳过区间(跳过区间们, 整64(预节点.文本), 预扫i);
        } 否则 如果 (预节点.类型 == 节点_循环语句) {
            // 357-a（D39）：三段式循环——前置段（init/cond/step/step包装，
            //   区间 [循环节点+1, 体块索引)）与体块节点@附加，区间
            //   [循环节点+1, 附加+1)（不含循环节点本身——主循环派发 检查循环）
            登记跳过区间(跳过区间们, 整64(预扫i) + 1, 整64(预节点.附加) + 1);
        } 否则 如果 (预节点.类型 == 节点_如果语句) {
            // 如果：真块@附加，区间 [真块.子起点, 真块节点]（含——检查如果 递归）；
            //   条件表达式区间不跳（检查如果/主循环双查幂等无害）
            节点 真块 = 池.元素(预节点.附加);
            登记跳过区间(跳过区间们, 整64(真块.子起点), 整64(预节点.附加) + 1);
            // 1028（#045 切片1·规则3）：否则链同样由 检查如果 递归处理——主循环
            //   按池序会先独立派发 否则块/嵌套 否则 如果（其池序先于外层如果节点
            //   节点·原未登记跳过），流敏感标记未打即查=误报（m263 实录：否则块内
            //   嵌套如果条件 .错误 双查首遍 miss）。对既有幂等检查=双查归单查等价。
            //   ★链遍历纪律：否则块=链尾（块无 否则·子终点=块内区间终≠链——原
            //   用 块.子终点 续链=回指成环·跳过区间无限追加→cn_realloc 4G 拒绝
            //   实录）；仅 嵌套 否则 如果 以其 子终点 续链。
            整64 否则链i = 整64(预节点.子终点);
            当 (否则链i != 0 && 否则链i < 池.大小()) {
                节点 链节点c = 池.元素(整32(否则链i));
                如果 (链节点c.类型 == 节点_块) {
                    // 否则块：语句区间+块节点自身全由 检查如果 递归——链尾
                    登记跳过区间(跳过区间们, 整64(链节点c.子起点), 否则链i + 1);
                    中断;
                } 否则 如果 (链节点c.类型 == 节点_如果语句) {
                    // 嵌套 否则 如果：条件起(文本)至节点自身由递归处理·续链
                    登记跳过区间(跳过区间们, 整64(链节点c.文本), 否则链i + 1);
                    否则链i = 整64(链节点c.子终点);
                } 否则 {
                    中断;
                }
            }
        } 否则 如果 (预节点.类型 == 节点_选择语句) {
            // 045b（丙案·2026-10-05）：选择语句情况段 [子起点, 子终点) 全量登记
            //   跳过——解析层池序=值区+情况段全部先于选择语句根入池，主循环按
            //   池序会先撞上情况段内的体块节点/体语句根（检查选择 尚未派发）
            //   →嵌套作用域外独立派发=流敏感标记未打即查+同错双报（选择体语
            //   句被 检查选择 递归+主循环二次派发）。体块节点与体语句根全在
            //   [子起点, 子终点) 内——含情况值表达式节点（非语句根·跳过无行
            //   为差）。宿主 AST 单遍天然无此面（visitSwitchStmt 递归一次）。
            登记跳过区间(跳过区间们, 整64(预节点.子起点), 整64(预节点.子终点));
        }
        预扫i++;
    }
    整64 i = 整64(块.子起点);
    当 (i < 整64(块.子终点)) {
        // 跳过嵌套体块区间（其语句由递归作用域处理）
        布尔 在跳过 = 假;
        整64 跳i = 0;
        当 (跳i < 跳过区间们.大小()) {
            如果 (i >= 跳过区间们.元素(跳i) && i < 跳过区间们.元素(跳i + 1)) {
                在跳过 = 真;
                中断;
            }
            跳i += 2;
        }
        如果 (在跳过) { i++; 继续; }
        节点 子 = 池.元素(整32(i));
        // 语句根节点才派发（缺陷②分诊根治，2026-09-03）：块区间线性包含各语句
        //   的全部内部节点（RHS 裸标识符/一元/成员…先于语句根入池）——原实现逐
        //   节点派发使裸一元节点（取地址/解引用/负号/逻辑非）在**声明根注册名
        //   字之前**先查操作数区间：自引用/前向引用误报「未声明」+ 同一错误双
        //   诊断（&q 前向引用探针实证报两次）。裸节点一律由所属语句根的区间
        //   检查统一覆盖（每节点恰在其作用域访问一次，rustc 对齐）
        如果 (子.类型 == 节点_块 || 子.类型 == 节点_如果语句 || 子.类型 == 节点_当语句 ||
             子.类型 == 节点_循环语句 || 子.类型 == 节点_选择语句 ||
             子.类型 == 节点_静态声明 || 子.类型 == 节点_变量声明 || 子.类型 == 节点_赋值 || 子.类型 == 节点_自增 ||
             子.类型 == 节点_自减 ||
             子.类型 == 节点_返回语句 || 子.类型 == 节点_表达式语句 ||
             子.类型 == 节点_中断语句 || 子.类型 == 节点_继续语句 ||
             子.类型 == 节点_遍历语句) {
            如果 (子.类型 == 节点_块) {
                检查块(池, 整32(i), 符号表, 诊断);
            } 否则 如果 (子.类型 == 节点_如果语句) {
                检查如果(池, 整32(i), 符号表, 诊断);
            } 否则 如果 (子.类型 == 节点_当语句) {
                检查当(池, 整32(i), 符号表, 诊断);
            } 否则 如果 (子.类型 == 节点_循环语句) {
                检查循环(池, 整32(i), 符号表, 诊断);
            } 否则 如果 (子.类型 == 节点_遍历语句) {
                检查遍历894(池, 整32(i), 符号表, 诊断);
            } 否则 如果 (子.类型 == 节点_选择语句) {
                检查选择(池, 整32(i), 符号表, 诊断);
            } 否则 {
                检查语句(池, 整32(i), 符号表, 诊断);
            }
        }
        i++;
    }
    表弹出(符号表);
    状态出块清理(符号表.大小());  // 010（def-init）：出块清理该层未初始化键
}

// 894-a 检查遍历语句 自本文件机械搬移至 语义检查遍历.cn（812 拆分：本文件
//   997 行撞 900 警戒线·「先拆再加」纪律——搬移含 812 成员/下标形态迭代对象
//   精确类型推导接入，见该文件）。

// 413-a（D44 正体收口）：检查选择语句——值表达式区间 + 各情况值表达式 + 体块。
//   节点字段：文本=值起点、附加=值终点、子起点=第一情况索引、子终点=情况段终点；
//   情况标签：文本/附加=值区间（默认=[0,0)）、子起点=体块索引、子终点=字符串标记。
//   诚实边界：情况值常量性未限定（规范 755 口径=常量——v2 现接受表达式·生成期
//   自然支持整型表达式比较；与宿主「编译期常量」口径的收窄面登记待定项）。
