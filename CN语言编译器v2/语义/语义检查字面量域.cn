// CN 自举编译器 v2 · 语义组件·整字面量值域判定族（558 拆分·535 薄壳化）
// 职责：整字面量入域判定（节点级薄壳）与推断面值域自洽检查 + 535 静态槽
//   字面量值域检查——判定核心（十进制文本级判域+进制前缀值级判域+整数后缀
//   剥离）535 轮下沉中立层 IR字面量域.cn（跨层共性：语法层类静态字段与语义层
//   转换检查双消费·语法→语义直接依赖违 334 层序）；本文件保留节点级提取
//   薄壳与语义诊断层，行为零变化（判定单一真源）。
//   依赖=协议常量（节点_*/符号）与字符串/字节值 内建；消费=语义检查表达式尾
//   （隐式转换合法 三通道）与 语义检查语句/尾（推断面与 535 静态槽挂点）。
//   640 恢复（2026-10-16）：535 链（fb0306281）未集成 develop（收口 sha 记录
//   异常），本任务按 535 语义重建——本文件内容照 535 版逐字保留·728s 等
//   其后追加段原样不动。

导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（目录包名）
导入 IR;         // 容器/结果 合成名判定 + 535 字面量域判定族（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）
// 590（2026-10-16）：负号链至字面量判定（多重负号形态「-(-字面量)」以上）——
//   与 是整数字面量末端（单层「-字面量」）互补：末端为负号时沿操作数根
//   （子终点-1 契约）迭代下钻，要求每层均为负号、链尾为整数字面量，且链深≥2
//   （深 0=单层形态由 是整数字面量末端 既有面覆盖，不重复）。消费=隐式转换
//   合法 负号分支与实参面字面量分支入口（链形态落值域判定而非 740 推导）。
//   守卫=深度上限 64 防病态环；子终点区间校验防越界。
函数 负号链至字面量(向量<节点> 池, 整32 末端索引) -> 布尔 {
    如果 (末端索引 < 0 || 末端索引 >= 整32(池.大小())) { 返回 假; }
    节点 游c = 池.元素(末端索引);
    如果 (游c.类型 != 节点_负号) { 返回 假; }
    整64 深c = 0;
    当 (深c < 64 && 游c.类型 == 节点_负号 &&
         游c.子终点 > 0 && 游c.子终点 <= 整32(池.大小())) {
        节点 操作数c = 池.元素(整32(游c.子终点) - 1);
        如果 (操作数c.类型 == 节点_整数字面量) { 返回 深c >= 1; }
        如果 (操作数c.类型 != 节点_负号) { 返回 假; }
        游c = 操作数c;
        深c++;
    }
    返回 假;
}

// 1016（审查 P2-1）：负号 + 整数字面量 的 128 负界常量判定（569 常量性面
//   ——下沉件防 语义检查语句.cn 冻结线再涨）。取常量下标值 承载面=有符号
//   整64；569 只判常量性（值域由 535/919 判域通道承担），操作数字面量十进制
//   化后 magnitude ≤2^127（整128 负界）即常量表达式放行——宿主
//   cnEvalConstExpr 字面量文本保真通道同口径（fold 失败仍原文放行）。
//   实测锚：整128 裸全局 -0xFFFFFFFFFFFFFFFF 原 rc=1 误拒 vs 宿主放行值正确。
函数 负号巨字面量常量1016(向量<节点> 池, 整32 子索引) -> 布尔 {
    // 静默豁免闭集穷举: 池索引越界守卫（显式假哨兵·非业务默认值）
    如果 (子索引 < 0 || 子索引 >= 整32(池.大小())) { 返回 假; }
    节点 子1016 = 池.元素(子索引);
    // 静默豁免业务值: 非整数字面量形态=非本判据面（判定否定分支·显式假哨兵）
    如果 (子1016.类型 != 节点_整数字面量) { 返回 假; }
    整64 十进1016 = 字面量十进制文本(
        字符串复制(驻留文本(整64(子1016.文本))));
    // 静默豁免上游已诊断: 十进制化失败=词法已拒形态（显式哨兵 0）
    如果 (十进1016 == 0) { 返回 假; }
    返回 数文本不超上界(字符串复制(驻留文本(十进1016)),
                        "170141183460469231731687303715884105728");
}

// 565 轮（T36 v2 面）→ 558 扩面（506甲·2026-10-13 用户裁决）→ 558 修复（审查
//   P1-1·零分叉）：整字面量值域判定——宿主 T36·319-a「域内字面量保留豁免、
//   域外拒绝」同口径，558 起受检矩阵补齐 整32/整64/正64（原「目标不检（宿主
//   实测定案）」随 506甲 废止：同型亦查域·Rust E0308 同款）。受检矩阵与值域
//   （文本级判定·宿主 intLiteralFitsType 十进制文本路径一致）：整8 [-128,127]／
//   正8 [0,255]／整16 [-32768,32767]／正16 [0,65535]／正32 [0,4294967295]／
//   整32 [-2147483648,2147483647]／整64 [-2^63,2^63-1]／正64 [0,2^64-1]。
//   负号+字面量形态（节点_负号·子起点=操作数）按数学负值判（-2147483648=
//   整32::MIN 域内合法·存量零翻转）。
//   558 修复前：「全数字扫描遇非数字即放行」对进制前缀（0x/0b/0o）与整数后缀
//   （L/U）字面量误判「检不出放行」——宿主分别走值级判域（拒）与剥后缀文本级
//   判域（拒）=两处分叉；修复后同构补齐（进制前缀→进制字面量值级入域·后缀
//   剥离→文本级判域·宿主 decimalDigitsOf 同款剥法）。
函数 整字面量入域(节点 源末, 向量<节点> 池, 字符串 目标文本, 布尔 负号) -> 布尔 {
    整64 字面名IDl = 0;
    布尔 终负号l = 负号;
    如果 (源末.类型 == 节点_整数字面量) {
        字面名IDl = 整64(源末.文本);
    } 否则 如果 (源末.类型 == 节点_负号 && 负号 &&
                源末.子终点 > 0 && 源末.子终点 <= 整32(池.大小())) {
        // 590（2026-10-16·多重负号左操作数漏检根治）：负号链迭代下钻至底层
        //   字面量——修前单步取 子起点 元素（负号节点区间起点在嵌套负号链=
        //   底层字面量本身），把「-(-2147483648)」按**单层**负号判域
        //   （值误取 -2^31 域内放行=运行静默错值）；链化后逐层翻转符号
        //   （层数奇偶=数学值符号：第 1 层已由 负号 初值计入，第 2 层起每
        //   深入一层翻转），再按数学值判域——宿主解析期双重负号折叠为正
        //   字面量后走同一值域门槛（558）语义等价。
        节点 游l = 源末;
        整64 深l = 0;
        当 (深l < 64 && 游l.类型 == 节点_负号 &&
             游l.子终点 > 0 && 游l.子终点 <= 整32(池.大小())) {
            节点 操作数l = 池.元素(整32(游l.子终点) - 1);
            如果 (操作数l.类型 == 节点_整数字面量) {
                字面名IDl = 整64(操作数l.文本);
                中断;
            }
            如果 (操作数l.类型 != 节点_负号) { 中断; }
            终负号l = !终负号l;   // 深入下一层负号：符号翻转（奇偶累计）
            游l = 操作数l;
            深l++;
        }
    }
    如果 (字面名IDl == 0) { 返回 真; }   // 非字面量/形态不合=检不出放行
    返回 字面量文本入域(字符串复制(驻留文本(字面名IDl)), 目标文本, 终负号l);
}

// 558（506甲）→ 638（甲案·2026-10-14 用户裁决「一种语言不该有歧义」）：
//   推断面字面量值域检查（检查推断声明语句 挂点·宿主 visitVarDecl 推断分支
//   同构·558 拆分起函数体在 语义检查字面量域=与 整字面量入域 同族内聚·
//   语义检查语句.cn 冻结线负担卸载）——推断类型=字面量恒定级整32（检查表达式
//   对整字面量恒返整32·原 497 提升改判随甲案废止·宿主同构），值超恒定级域
//  （含超 int64 巨字面量）一律编译期拒+引导显式写类型（整64 甲 = 值;·Rust
//   `let x = 2147483649;` E0308 同款）；负号形态按负值判（-2147483648=
//   整32::MIN 域内合法·855 锚不翻转）。
函数 检查推断面字面量值域(向量<节点> 池, 整32 初值末索引, 整64 推断ID,
                       向量<字符串>& 诊断) -> 空类型 {
    如果 (推断ID <= 0 || 初值末索引 < 0 || 初值末索引 >= 整32(池.大小())) { 返回; }
    节点 初值末 = 池.元素(初值末索引);
    布尔 负形 = 初值末.类型 == 节点_负号;
    字符串 推断文本 = 字符串复制(驻留文本(推断ID));
    // 919-final（2026-10-18 用户裁决「字面量单点判域·Rust 口径」）：区间
    //   子树扫描先于形态分派——推断声明初值（含变量/嵌套/三元）内任一整数
    //   字面量超推断类型域 → 拒（`变量 甲 = 19位 + 变;` 修前放行到运行期
    //   窄化，新口径=编译期拒）。
    如果 (区间含超域字面量919(池, 初值末索引, 推断文本)) {
        表诊断(诊断, "[错误] 无法将 '" + 推断文本 + "' 隐式转换为 '" +
                      推断文本 + "'（推断声明无后缀字面量恒定级 整32·值超域）——请显式写类型承接（整64/整128 甲 = 值;）");
        返回;
    }
    如果 (初值末.类型 != 节点_整数字面量 && !负形) {
        // 919（超承载字面量参与表达式求值双侧静默分叉根治·640 侦察副产品）：
        //   常量表达式初值（全字面量算术）——文本级大数安全求值后按推断恒定级
        //   判域（与字面量面同诊断；静默错值面=`变量 甲 = 99999999999999999999+0;`
        //   修正前宿主 1661992959 vs v2 -1076103128 双侧静默分叉）；非常量形态/
        //   承载内值维持既有链（638 推断通道适用面不动）。
        整64 常量出919p = 0;
        如果 (!常量末至十进制919(池, 初值末索引, 常量出919p)) { 返回; }
        布尔 拒919p = 常量出919p == 0;
        如果 (!拒919p) {
            字符串 常量值919p = 字符串复制(驻留文本(常量出919p));
            字符串 常量数919p = "";
            布尔 常负919p = 拆符号919(常量值919p, 常量数919p);
            常量数919p = 规范919(常量数919p);
            布尔 承载内919p = 数文本不超上界(常量数919p, "9223372036854775807");
            如果 (常负919p) { 承载内919p = 数文本不超上界(常量数919p, "9223372036854775808"); }
            如果 (!承载内919p) {
                拒919p = !字面量文本入域(常量数919p, 推断文本, 常负919p);
            }
        }
        如果 (拒919p) {
            表诊断(诊断, "[错误] 无法将 '" + 推断文本 + "' 隐式转换为 '" +
                          推断文本 + "'（推断声明无后缀字面量恒定级 整32·值超域）——请显式写类型承接（整64/整128 甲 = 值;）");
        }
        返回;
    }
    如果 (!整字面量入域(初值末, 池, 推断文本, 负形)) {
        表诊断(诊断, "[错误] 无法将 '" + 推断文本 + "' 隐式转换为 '" +
                      推断文本 + "'（推断声明无后缀字面量恒定级 整32·值超域）——请显式写类型承接（整64/整128 甲 = 值;）");
    }
}

// 756（2026-10-18 用户裁决·枚举值域门槛「枚举成员值超 i32 域双侧一致编译期
//   拒」·506/535/638 超域字面量立法族同款）：枚举成员常量末端判定——源末=
//   节点_成员 且基名=枚举名（生成枚举成员常量 IR 分发同款识别：字段访问
//   s.e 的对象为变量名不命中）。仅形态判定（值由调用方查枚举成员值 取）。
函数 是枚举成员常量末端756(向量<节点> 池, 整32 末端索引) -> 布尔 {
    如果 (末端索引 < 0 || 末端索引 >= 整32(池.大小())) { 返回 假; }
    节点 末端756 = 池.元素(末端索引);
    如果 (末端756.类型 != 节点_成员) { 返回 假; }
    // 静默豁免业务值: 子起点越界=非枚举成员常量形态（形态判定否定业务分支·非查询 miss 默认值）
    如果 (末端756.子起点 < 0 || 末端756.子起点 >= 整32(池.大小())) { 返回 假; }
    节点 基名756 = 池.元素(整32(末端756.子起点));
    如果 (基名756.类型 != 节点_标识符) { 返回 假; }
    返回 是枚举名(整64(基名756.文本));
}

// 756：枚举槽常量入域判定（判据单点·宿主 intLiteralFitsType 枚举扩展同口径）——
//   目标=枚举类型时按整32 存储域判（枚举按整32存储）；源形态：整数字面量/
//   负号形态经 整字面量入域（"整32" 域复用·文本级/回绕既有链）；枚举成员常量
//   （枚举名.成员）按成员值判 i32 域（查枚举成员值 -1=未命中——IR 侧 miss 亦
//   直存 -1·域内⇒放行，见 生成枚举成员常量）；其余形态（表达式/标识符/调用等
//   非直存常量）放行。目标非枚举恒真（非本判据面）。
//   消费=检查标量隐式转换（声明/赋值/返回三面共用·声明面含函数内静态）与
//   检查静态槽字面量值域535（函数内静态/顶层静态两趟）。
函数 枚举槽常量入域756(向量<节点> 池, 整32 源末索引, 布尔 目标枚举) -> 布尔 {
    // 静默豁免业务值: 目标非枚举=非本判据面（判据边界业务值·恒真放行）
    如果 (!目标枚举) { 返回 真; }
    // 静默豁免业务值: 源末索引越界防御（判据面外放行·诚实边界）
    如果 (源末索引 < 0 || 源末索引 >= 整32(池.大小())) { 返回 真; }
    节点 源末756 = 池.元素(源末索引);
    如果 (源末756.类型 == 节点_整数字面量 || 源末756.类型 == 节点_负号) {
        返回 整字面量入域(源末756, 池, "整32", 源末756.类型 == 节点_负号);
    }
    如果 (是枚举成员常量末端756(池, 源末索引)) {
        节点 基756 = 池.元素(整32(源末756.子起点));
        整64 值756 = 查枚举成员值(整64(基756.文本), 整64(源末756.文本));
        返回 值756 >= 0 - 2147483647 - 1 && 值756 <= 2147483647;
    }
    返回 真;
}

// 535 批乙（2026-10-14 用户裁决·001 §静态成员域限制补句）：静态槽超域
//   字面量直存编译期拒——初值恰为字面量直存形态（含一元负号）时按声明类型
//   值域判定（判定=整字面量入域 薄壳·核心单一真源 IR字面量域）。独立函数
//   承载（不并入 884：884 被顶层趟【语义检查尾】与语句趟【语义检查中】各调
//   一次——含非幂等诊断的检查并入会双报；本函数由两调用点各挂一次，函数内
//   静态【语句趟·修饰=1】与顶层静态【顶层趟·修饰=0】单跑）。类静态字段在
//   语法层 解析类静态字段初值 同构执法（同调 IR字面量域·字面量文本入域）。
//   初值区间形态（v2 池序）：正字面量=[字面量]（1 节点）；负号字面量=
//   [字面量, 负号]（2 节点）——取区间末节点判定。域内初值零行为变化；
//   非字面量直存形态（表达式/调用）不属本检查面。
//   756（2026-10-18 用户裁决·枚举值域门槛）：枚举槽类型分支——初值为超 i32 域
//   常量（枚举成员常量/字面量直存）拒（枚举槽常量入域756 单点·函数内静态与
//   顶层静态两趟同覆盖）。
不安全 函数 检查静态槽字面量值域535(向量<节点> 池, 节点 n, 向量<字符串>& 诊断) -> 空类型 {
    如果 (n.附加 < 0 || 整64(n.附加) >= 整64(池.大小())) { 返回; }
    节点 类型节点535 = 池.元素(整32(n.附加));
    整64 类型ID535 = 整64(类型节点535.文本);
    如果 (类型ID535 <= 0) { 返回; }
    如果 (整64(n.子终点) <= 整64(n.子起点) ||
        整64(n.子终点) > 整64(池.大小())) { 返回; }
    节点 初值末535 = 池.元素(整32(整64(n.子终点) - 1));
    布尔 负形535 = 初值末535.类型 == 节点_负号;
    // 919-final（2026-10-18 用户裁决「字面量单点判域·Rust 口径」）：区间
    //   子树扫描先于形态分派（含枚举槽类型）——含变量/嵌套/三元等任意初值形态内
    //   任一超 64 位承载字面量超声明类型域 → 拒（边界2/3：19位+变量拒、`20位%7`
    //   拒；128 承接形态域内放行零误伤）；与既有字面量/表达式链双轨判据同结论。
    如果 (区间含超域字面量919(池, 整32(整64(n.子终点) - 1), 字符串复制(驻留文本(类型ID535)))) {
        表诊断(诊断, "[错误] 静态变量 '" + 合成名基名(驻留文本(整64(n.文本))) +
                    "' 的初始字面量超出 '" + 驻留文本(类型ID535) +
                    "' 值域——静态槽加载期直存须为值域内字面量（001 §静态成员·535）；如确需位模式截断请显式转换（如 " +
                    驻留文本(类型ID535) + "(表达式)）");
        返回;
    }
    // 756（2026-10-18 用户裁决·枚举值域门槛）：枚举槽 i32 域——枚举槽类型走
    //   枚举槽常量入域756 单点（字面量按"整32"域复用/枚举成员常量按成员值判）；
    //   非直存常量形态（表达式/调用）放行（与宿主 intLiteralFitsType 枚举槽
    //   分支同口径——非本判据面）。非枚举槽面零行为变化（919 通道/639 叠加
    //   原样保留下行）。
    如果 (是枚举名(类型ID535)) {
        布尔 入域756s = 枚举槽常量入域756(池, 整32(整64(n.子终点) - 1), 真);
        如果 (!入域756s) {
            表诊断(诊断, "[错误] 静态变量 '" + 合成名基名(驻留文本(整64(n.文本))) +
                        "' 的初始字面量超出 '" + 驻留文本(类型ID535) +
                        "' 值域——静态槽加载期直存须为值域内字面量（001 §静态成员·535）；如确需位模式截断请显式转换（如 " +
                        驻留文本(类型ID535) + "(表达式)）");
        }
        // 静默豁免业务值: 枚举槽判域收尾返回（756 分支判定完成·非查询 miss 默认值）
        返回;
    }
    如果 (初值末535.类型 != 节点_整数字面量 && !负形535) {
        // 919（超承载字面量参与表达式求值双侧静默分叉根治·640 侦察副产品）：
        //   常量表达式初值（全字面量算术 + - * / %·一元 ±负号链）——文本级
        //   大数安全求值后按声明类型域判定（复用 字面量文本入域 家族单点·
        //   诊断与 640 字面量面逐字同款）；静默错值面=`静态 整32 槽 =
        //   99999999999999999999+0;` 修正前 v2 静默 1661992959 直存（宿主
        //   同形静默 5/1661992959 双侧错值分叉）。承载内值维持既有链
        //   （guard/入口注入运行期求值面不属本检查）。
        整64 常量出919s = 0;
        如果 (!常量末至十进制919(池, 整32(整64(n.子终点) - 1), 常量出919s)) { 返回; }
        布尔 拒919s = 常量出919s == 0;
        如果 (!拒919s) {
            字符串 常量值919s = 字符串复制(驻留文本(常量出919s));
            字符串 常量数919s = "";
            布尔 常负919s = 拆符号919(常量值919s, 常量数919s);
            常量数919s = 规范919(常量数919s);
            布尔 承载内919s = 数文本不超上界(常量数919s, "9223372036854775807");
            如果 (常负919s) { 承载内919s = 数文本不超上界(常量数919s, "9223372036854775808"); }
            如果 (!承载内919s) {
                布尔 入域919s = 字面量文本入域(常量数919s, 字符串复制(驻留文本(类型ID535)), 常负919s);
                如果 (入域919s) {
                    入域919s = 字面量文本入域128_640(常量数919s, 字符串复制(驻留文本(类型ID535)), 常负919s);
                }
                拒919s = !入域919s;
            }
        }
        如果 (拒919s) {
            表诊断(诊断, "[错误] 静态变量 '" + 合成名基名(驻留文本(整64(n.文本))) +
                        "' 的初始字面量超出 '" + 驻留文本(类型ID535) +
                        "' 值域——静态槽加载期直存须为值域内字面量（001 §静态成员·535）；如确需位模式截断请显式转换（如 " +
                        驻留文本(类型ID535) + "(表达式)）");
        }
        返回;
    }
    布尔 入域535b = 整字面量入域(初值末535, 池, 字符串复制(驻留文本(类型ID535)), 负形535);
    如果 (入域535b) {
        // 640（2026-10-16）：128 槽文本域叠加（535 原版对 128 目标恒真——
        //   超承载文本可超 2^127；判定核心=IR字面量域 字面量文本入域128_640）。
        //   文本提取=节点形态（正字面量/负号字面量两形态·535 前置守卫已限）。
        字符串 文本535 = "";
        如果 (初值末535.类型 == 节点_整数字面量) {
            文本535 = 字符串复制(驻留文本(整64(初值末535.文本)));
        } 否则 如果 (初值末535.子起点 >= 0 &&
                     整64(初值末535.子起点) < 整64(池.大小())) {
            节点 负子535 = 池.元素(整32(初值末535.子起点));
            如果 (负子535.类型 == 节点_整数字面量) {
                文本535 = 字符串复制(驻留文本(整64(负子535.文本)));
            }
        }
        如果 (字符串长度(文本535) > 0) {
            入域535b = 字面量文本入域128_640(文本535, 字符串复制(驻留文本(类型ID535)), 负形535);
        }
    }
    如果 (!入域535b) {
        表诊断(诊断, "[错误] 静态变量 '" + 合成名基名(驻留文本(整64(n.文本))) +
                    "' 的初始字面量超出 '" + 驻留文本(类型ID535) +
                    "' 值域——静态槽加载期直存须为值域内字面量（001 §静态成员·535）；如确需位模式截断请显式转换（如 " +
                    驻留文本(类型ID535) + "(表达式)）");
    }
}

// 728s：整数字面量「定级类型」=后缀类型 ∪ 整32 恒定级——检查表达式 字面量
//   分支单点消费（宿主 visitIntegerLiteral 经 literalTypeOf+空串回退同构）。
//   无后缀/非法组合=整32（与修复前 return 驻留("整32") 逐字节兼容——无后缀
//   面零行为变化）；无后缀超域面由 检查推断面字面量值域 编译期拒（638 甲案
//   起原 497 真值域改判链已废止·表达式类型ID 无后缀恒整32 恒定级）。
函数 字面量整型类型ID(字符串 字面文本) -> 整64 {
    整64 后缀ID = 字面量后缀类型ID(字面文本);
    如果 (后缀ID > 0) { 返回 后缀ID; }
    返回 驻留("整32");
}

// ==================== 728s 对称化：无后缀非负字面量随另一侧（宿主同构） ====================
// 728s 对称化（2026-10-15 用户裁决批乙·#728s「宿主字面量二元算式结果类型
//   『顺序敏感』（1+2U 拒/1U+2 放行）是否对称化」→ 批乙：对称化·Rust 真对齐）：
//   无后缀非负整数字面量末端判定（随侧触发形态）——节点=整数字面量、文本首
//   字符非 '-'（323 解析期负号折叠把 `-1` 存为 raw="-1" 字面量；负号形态
//   不随侧：无符号域不承载负值·Rust 同口径 `-1 + 2U` 维持混合符号拒绝）、
//   后缀类型ID==0（无 L/U/LL/UL/ULL 定级；含 0xFF 尾 F 不在后缀集合=无后缀，
//   与宿主 literalTypeOf 空串回退口径一致）。「无」=空指针字面量（153-a
//   附加==1）排除。消费=推导二元类型ID（结果类型推导）与 溢出面域类型474
//   （域预演）双点——宿主 isUnsuffixedIntLiteral728 +
//   unifyUnsuffixedLiteralOperand728 逐字同构。
函数 是无后缀非负字面量末端(向量<节点> 池, 整32 末端索引) -> 布尔 {
    // 静默豁免业务值: 索引越界=非本形态否定（随侧判定业务分支·非查询 miss 默认值）
    如果 (末端索引 < 0 || 末端索引 >= 整32(池.大小())) { 返回 假; }
    节点 末728 = 池.元素(末端索引);
    如果 (末728.类型 != 节点_整数字面量) { 返回 假; }
    如果 (末728.附加 == 1) { 返回 假; }
    字符串 文本728 = 字符串复制(驻留文本(整64(末728.文本)));
    如果 (字符串长度(文本728) > 0 && (整64(文本728[0]) & 255) == 45) { 返回 假; }
    返回 字面量后缀类型ID(文本728) == 0;
}
