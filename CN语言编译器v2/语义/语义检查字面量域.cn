// CN 自举编译器 v2 · 语义组件·整字面量值域判定族（558 拆分·先拆再加纪律）
// 职责：整字面量入域判定（文本级十进制判域+进制前缀值级判域+整数后缀剥离）
//   与推断面值域自洽检查——558/506甲 函数族自 语义检查表达式尾 机械搬移
//   （冻结线 242：该文件拆分前禁止更坏；445 拆 语义检查限定调用 先例同款）。
//   依赖=协议常量（节点_*/符号）与字符串/字节值 内建·消费=语义检查表达式尾
//   （隐式转换合法 三通道）与 语义检查语句（检查推断声明语句 挂点）。
//   声明序：包.cn 中置于 消费者 之前（依赖先解析）。

导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（目录包名）
导入 IR;         // 容器/结果 合成名判定（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 558（506甲）：十进制数字文本归一（去前导零·保留至少一位）——文本级判域
//   前置（超 int64 承载的 19~20 位文本不受整64 解析限制·宿主
//   intLiteralFitsType 文本级判定同构）
函数 数文本去前导零(字符串 数字文本) -> 字符串 {
    整64 长z = 字符串长度(数字文本);
    整64 起z = 0;
    当 (起z < 长z - 1 && 字节值(数字文本, 起z) == 48) { 起z++; }
    返回 字符串子串(数字文本, 起z, 长z - 起z);
}

// 558（506甲）：无符号十进制数字文本 ≤ 上界文本（长度优先·等长逐字节比·
//   大数安全——整64 解析承载面彻底退出判域路径）
函数 数文本不超上界(字符串 数字文本, 字符串 上界文本) -> 布尔 {
    字符串 值t = 数文本去前导零(数字文本);
    字符串 界t = 数文本去前导零(上界文本);
    整64 长值 = 字符串长度(值t);
    整64 长界 = 字符串长度(界t);
    如果 (长值 != 长界) { 返回 长值 < 长界; }
    整64 k = 0;
    当 (k < 长值) {
        整64 字节值a = 字节值(值t, k);
        整64 字节值b = 字节值(界t, k);
        如果 (字节值a != 字节值b) { 返回 字节值a < 字节值b; }
        k++;
    }
    返回 真;
}

// 558 修复（审查 P1-1·零分叉）：进制前缀字面量值级判域——宿主
//   intLiteralFitsType 十进制文本拦截后回退值级 fits 路径同构：进制文本解析
//   为整64 值（stoll 同款：超 int64 正上界=溢出回 0），再按目标域判定。
//   承载内十六进制超域（`整32 甲=0x1FFFFFFFF`）宿主拒·v2 修复前「见 x 放行」
//   =分叉，此处补齐；超承载十六进制（stoll 抛异常回 0→域内放行）双侧同放行
//   维持一致（诚实边界·其 IR 物化 0 面随 #547 收口，此处不为它扩拦）。
//   负号形态按数学负值判（宿主值级 fits lambda 同构）；正N 目标按无符号域
//   解释（宿主 fitsU 同款·负号恒拒）。
函数 进制字面量值级入域(字符串 文本h, 字符串 目标文本, 布尔 负号) -> 布尔 {
    // 前缀定进制（宿主 parseIntValue 同款：0x/0X/0b/0B/0o/0O·调用方已拦·防御复判）
    整64 进位h = 10;
    整64 起h = 0;
    如果 (字符串长度(文本h) > 2 && 字节值(文本h, 0) == 48) {
        整64 次h = 字节值(文本h, 1);
        如果 (次h == 120 || 次h == 88) { 进位h = 16; 起h = 2; }
        否则 如果 (次h == 98 || 次h == 66) { 进位h = 2; 起h = 2; }
        否则 如果 (次h == 111 || 次h == 79) { 进位h = 8; 起h = 2; }
    }
    整64 累h = 0;
    整64 ih = 起h;
    当 (ih < 字符串长度(文本h)) {
        整64 数h = 字节值(文本h, ih);
        如果 (数h >= 48 && 数h <= 57) { 数h = 数h - 48; }
        否则 如果 (数h >= 97 && 数h <= 102) { 数h = 数h - 87; }
        否则 如果 (数h >= 65 && 数h <= 70) { 数h = 数h - 55; }
        否则 如果 (数h == 76 || 数h == 108 || 数h == 85 || 数h == 117) { 中断; }   // L/U 后缀自断
        否则 { 返回 真; }   // 非法字符=检不出放行（防御·词法不可达面）
        如果 (数h >= 进位h) { 返回 真; }   // 进制外数字=检不出放行（防御）
        如果 (累h > (9223372036854775807 - 数h) / 进位h) {
            累h = 0;   // 超 int64 正上界=stoll 抛异常回 0 同款（超承载=域内放行·#547 面）
            中断;
        }
        累h = 累h * 进位h + 数h;
        ih++;
    }
    如果 (负号) { 累h = 0 - 累h; }
    // 值级域表（宿主 fits/fitsU 同款·与文本级受检矩阵一一对应）
    如果 (字符串比较(目标文本, "整8")) { 返回 累h >= -128 && 累h <= 127; }
    如果 (字符串比较(目标文本, "正8")) { 返回 !负号 && 累h <= 255; }
    如果 (字符串比较(目标文本, "整16")) { 返回 累h >= -32768 && 累h <= 32767; }
    如果 (字符串比较(目标文本, "正16")) { 返回 !负号 && 累h <= 65535; }
    如果 (字符串比较(目标文本, "整32")) { 返回 累h >= -2147483648 && 累h <= 2147483647; }
    如果 (字符串比较(目标文本, "正32")) { 返回 !负号 && 累h <= 4294967295; }
    如果 (字符串比较(目标文本, "整64")) {
        返回 累h >= -9223372036854775807 - 1 && 累h <= 9223372036854775807;
    }
    如果 (字符串比较(目标文本, "正64")) {
        // 值已回 0 承载（≤2^63-1）恒 ≤ 2^64-1·宿主 fitsU(2^64-1) 同构——仅负号面拒
        返回 !负号;
    }
    返回 真;   // 整128/正128/未知目标：域宽于字面量承载，恒适
}

// 565 轮（T36 v2 面）→ 558 扩面（506甲·2026-10-13 用户裁决）→ 558 修复（审查
//   P1-1·零分叉）：整字面量值域判定——宿主 T36·319-a「域内字面量保留豁免、
//   域外拒绝」同口径，558 起受检矩阵补齐 整32/整64/正64（原「目标不检（宿主
//   实测定案）」随 506甲 废止：同型亦查域·Rust E0308 同款）。受检矩阵与值域
//   （文本级判定·宿主 intLiteralFitsType 十进制文本路径一致）：整8 [-128,127]／
//   正8 [0,255]／整16 [-32768,32767]／正16 [0,65535]／正32 [0,4294967295]／
//   整32 [-2147483648,2147483647]／整64 [-2^63,2^63-1]／正64 [0,2^64-1]。
//   负号+字面量形态（节点_负号·子起点=操作数）按数学负值判（-2147483648=
//   整32::MIN 域内合法·存量零翻转）。
//   558 修复前：「全数字扫描遇非数字即放行」对进制前缀（0x/0b/0o）与整数后缀
//   （L/U）字面量误判「检不出放行」——宿主分别走值级判域（拒）与剥后缀文本级
//   判域（拒）=两处分叉；修复后同构补齐（进制前缀→进制字面量值级入域·后缀
//   剥离→文本级判域·宿主 decimalDigitsOf 同款剥法）。
函数 整字面量入域(节点 源末, 向量<节点> 池, 字符串 目标文本, 布尔 负号) -> 布尔 {
    整64 字面名IDl = 0;
    如果 (源末.类型 == 节点_整数字面量) {
        字面名IDl = 整64(源末.文本);
    } 否则 如果 (源末.类型 == 节点_负号 && 负号 &&
                源末.子起点 >= 0 && 源末.子起点 < 整32(池.大小())) {
        节点 操作数l = 池.元素(源末.子起点);
        如果 (操作数l.类型 == 节点_整数字面量) {
            字面名IDl = 整64(操作数l.文本);
        }
    }
    如果 (字面名IDl == 0) { 返回 真; }   // 非字面量/形态不合=检不出放行
    字符串 文本l = 字符串复制(驻留文本(字面名IDl));
    整64 长l = 字符串长度(文本l);
    如果 (长l == 0) { 返回 真; }
    // 558 修复：进制前缀面（0x/0X/0b/0B/0o/0O·宿主 decimalDigitsOf 前缀拦截
    //   同款 size>2 门槛）→ 值级判域（承载内十六进制超域拒·超承载同放行维持）
    如果 (长l > 2 && 字节值(文本l, 0) == 48) {
        整64 次l = 字节值(文本l, 1);
        如果 (次l == 120 || 次l == 88 || 次l == 98 || 次l == 66 ||
             次l == 111 || 次l == 79) {
            返回 进制字面量值级入域(文本l, 目标文本, 负号);
        }
    }
    // 558 修复：整数后缀剥离（宿主 decimalDigitsOf 同款自尾剥 L/l/U/u/F/f·
    //   非前缀面 F/f 可剥）——带后缀十进制超域（99999999999999999999L→整64）
    //   宿主拒·v2 修复前「见 L 放行」=分叉；v2 词法整数形态仅消费 L/U（f/F
    //   浮点形态专属·不可达面），防御同剥与宿主同构。剥空=词法不可达退化形态
    //   →后续全数字扫描零通过按「检不出放行」对齐宿主回退值级 0 放行。
    当 (长l > 0) {
        整64 尾l = 字节值(文本l, 长l - 1);
        如果 (尾l == 76 || 尾l == 108 || 尾l == 85 || 尾l == 117 ||
             尾l == 70 || 尾l == 102) {
            长l--;
        } 否则 { 中断; }
    }
    文本l = 字符串子串(文本l, 0, 长l);
    整64 扫i = 0;
    当 (扫i < 长l) {
        整64 字节s = 字节值(文本l, 扫i);
        如果 (字节s < 48 || 字节s > 57) { 返回 真; }   // 非纯十进制=检不出放行
        扫i++;
    }
    如果 (字符串比较(目标文本, "整8")) {
        布尔 入域a558 = 数文本不超上界(文本l, "127");
        如果 (负号) { 入域a558 = 数文本不超上界(文本l, "128"); }
        返回 入域a558;
    }
    如果 (字符串比较(目标文本, "正8")) { 返回 !负号 && 数文本不超上界(文本l, "255"); }
    如果 (字符串比较(目标文本, "整16")) {
        布尔 入域b558 = 数文本不超上界(文本l, "32767");
        如果 (负号) { 入域b558 = 数文本不超上界(文本l, "32768"); }
        返回 入域b558;
    }
    如果 (字符串比较(目标文本, "正16")) { 返回 !负号 && 数文本不超上界(文本l, "65535"); }
    如果 (字符串比较(目标文本, "正32")) { 返回 !负号 && 数文本不超上界(文本l, "4294967295"); }
    如果 (字符串比较(目标文本, "整32")) {
        布尔 入域c558 = 数文本不超上界(文本l, "2147483647");
        如果 (负号) { 入域c558 = 数文本不超上界(文本l, "2147483648"); }
        返回 入域c558;
    }
    如果 (字符串比较(目标文本, "整64")) {
        布尔 入域d558 = 数文本不超上界(文本l, "9223372036854775807");
        如果 (负号) { 入域d558 = 数文本不超上界(文本l, "9223372036854775808"); }
        返回 入域d558;
    }
    如果 (字符串比较(目标文本, "正64")) { 返回 !负号 && 数文本不超上界(文本l, "18446744073709551615"); }
    返回 真;   // 整128/正128：域宽于任何整64 承载内文本，恒适
}

// 558（506甲）→ 638（甲案·2026-10-14 用户裁决「一种语言不该有歧义」）：
//   推断面字面量值域检查（检查推断声明语句 挂点·宿主 visitVarDecl 推断分支
//   同构·558 拆分起函数体在 语义检查字面量域=与 整字面量入域 同族内聚·
//   语义检查语句.cn 冻结线负担卸载）——推断类型=字面量恒定级整32（检查表达式
//   对整字面量恒返整32·原 497 提升改判随甲案废止·宿主同构），值超恒定级域
//  （含超 int64 巨字面量）一律编译期拒+引导显式写类型（整64 甲 = 值;·Rust
//   `let x = 2147483649;` E0308 同款）；负号形态按负值判（-2147483648=
//   整32::MIN 域内合法·855 锚不翻转）。
函数 检查推断面字面量值域(向量<节点> 池, 整32 初值末索引, 整64 推断ID,
                       向量<字符串>& 诊断) -> 空类型 {
    如果 (推断ID <= 0 || 初值末索引 < 0 || 初值末索引 >= 整32(池.大小())) { 返回; }
    节点 初值末 = 池.元素(初值末索引);
    布尔 负形 = 初值末.类型 == 节点_负号;
    如果 (初值末.类型 != 节点_整数字面量 && !负形) { 返回; }
    字符串 推断文本 = 字符串复制(驻留文本(推断ID));
    如果 (!整字面量入域(初值末, 池, 推断文本, 负形)) {
        表诊断(诊断, "[错误] 无法将 '" + 推断文本 + "' 隐式转换为 '" +
                      推断文本 + "'（推断声明无后缀字面量恒定级 整32·值超域）——请显式写类型承接（整64/整128 甲 = 值;）");
    }
}

// ==================== 728s：整数字面量后缀定级（宿主 literalTypeOf 同构） ====================
// 现象（582 轮侦察备案·728s 立案）：v2 检查表达式 对 节点_整数字面量 恒返
//   驻留("整32") 不吸收 L/U 后缀——`正32 丙 = 1U + 2U;` 二元结果类型被推
//   整32 → 赋值面混合符号误拒（宿主 literalTypeOf 后缀定级放行=零分叉违例）；
//   同根伴生 745（推断声明带后缀字面量误拒·p1/p4/p5 形态）。
// 本函数=后缀定级单点：后缀集合与宿主 type_system.cpp literalTypeOf 精确同构
//   （L→整64／LL→整128／U→正32／UL→正64／ULL→正128；大小写不敏感·保序前插
//   大写化）；返回**类型名ID**（符号/秩合并判定需区分有符号/无符号与 128 族
//   ——位宽版 字面量后缀位宽474 不带符号职责正交·两者并存不合并）。无后缀与
//   非法组合返回 0=调用方维持既有契约（字面量恒定级整32／497 真值域改判链／
//   值域分派；宿主 literalTypeOf 空串→visitIntegerLiteral 防御回退整32 同口径）。
//   0x/0b/0o 进制前缀无碍（F 不属后缀字符集·收集即断；0xFUL 的 UL 正常收集）。
函数 字面量后缀类型ID(字符串 字面文本) -> 整64 {
    字符串 后缀 = "";
    整64 尾 = 字符串长度(字面文本);
    当 (尾 > 0) {
        整64 字节 = 整64(字面文本[尾 - 1]) & 255;
        如果 (字节 == 76 || 字节 == 108) {          // 'L'/'l'
            后缀 = 字符串复制("L" + 后缀);
        } 否则 如果 (字节 == 85 || 字节 == 117) {   // 'U'/'u'
            后缀 = 字符串复制("U" + 后缀);
        } 否则 {
            中断;
        }
        尾 = 尾 - 1;
    }
    如果 (字符串比较(后缀, "L")) { 返回 驻留("整64"); }
    如果 (字符串比较(后缀, "LL")) { 返回 驻留("整128"); }
    如果 (字符串比较(后缀, "U")) { 返回 驻留("正32"); }
    如果 (字符串比较(后缀, "UL")) { 返回 驻留("正64"); }
    如果 (字符串比较(后缀, "ULL")) { 返回 驻留("正128"); }
    返回 0;   // 无后缀（整32 恒定级契约）与非法组合（宿主回退整32 同口径）
}

// 728s：整数字面量「定级类型」=后缀类型 ∪ 整32 恒定级——检查表达式 字面量
//   分支单点消费（宿主 visitIntegerLiteral 经 literalTypeOf+空串回退同构）。
//   无后缀/非法组合=整32（与修复前 return 驻留("整32") 逐字节兼容——无后缀
//   面零行为变化）；无后缀超域面由 检查推断面字面量值域 编译期拒（638 甲案
//   起原 497 真值域改判链已废止·表达式类型ID 无后缀恒整32 恒定级）。
函数 字面量整型类型ID(字符串 字面文本) -> 整64 {
    整64 后缀ID = 字面量后缀类型ID(字面文本);
    如果 (后缀ID > 0) { 返回 后缀ID; }
    返回 驻留("整32");
}

// ==================== 728s 对称化：无后缀非负字面量随另一侧（宿主同构） ====================
// 728s 对称化（2026-10-15 用户裁决批乙·#728s「宿主字面量二元算式结果类型
//   『顺序敏感』（1+2U 拒/1U+2 放行）是否对称化」→ 批乙：对称化·Rust 真对齐）：
//   无后缀非负整数字面量末端判定（随侧触发形态）——节点=整数字面量、文本首
//   字符非 '-'（323 解析期负号折叠把 `-1` 存为 raw="-1" 字面量；负号形态
//   不随侧：无符号域不承载负值·Rust 同口径 `-1 + 2U` 维持混合符号拒绝）、
//   后缀类型ID==0（无 L/U/LL/UL/ULL 定级；含 0xFF 尾 F 不在后缀集合=无后缀，
//   与宿主 literalTypeOf 空串回退口径一致）。「无」=空指针字面量（153-a
//   附加==1）排除。消费=推导二元类型ID（结果类型推导）与 溢出面域类型474
//   （域预演）双点——宿主 isUnsuffixedIntLiteral728 +
//   unifyUnsuffixedLiteralOperand728 逐字同构。
函数 是无后缀非负字面量末端(向量<节点> 池, 整32 末端索引) -> 布尔 {
    如果 (末端索引 < 0 || 末端索引 >= 整32(池.大小())) { 返回 假; }
    节点 末728 = 池.元素(末端索引);
    如果 (末728.类型 != 节点_整数字面量) { 返回 假; }
    如果 (末728.附加 == 1) { 返回 假; }
    字符串 文本728 = 字符串复制(驻留文本(整64(末728.文本)));
    如果 (字符串长度(文本728) > 0 && (整64(文本728[0]) & 255) == 45) { 返回 假; }
    返回 字面量后缀类型ID(文本728) == 0;
}
