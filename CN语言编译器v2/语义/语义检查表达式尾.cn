// 语义检查表达式尾（357 重构F2 自 语义检查表达式.cn 纯机械搬移·函数体逐字保留·零逻辑变化）

导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（目录包名）
导入 IR;         // 容器/结果 合成名判定（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）


// ==================== 混合符号二元运算拒绝（2026-09-10 第五十一轮 方案A） ====================
// 规范 plans/001 §3.7（2026-09-10 用户裁决方案A，Rust 对齐）：有符号（整N）与
//   无符号（正M）的「变量间」比较/算术/位运算编译期拒绝，须显式 类型名(表达式)
//   构造转换——隐式宽化在混合符号下静默改变值语义（探针实证 target/p50x64l/
//   mixed_cmp：正64(2^63) vs 整64(-1) 比较值域反转；正32 vs 整64 负值形态宿主
//   rc=9 / v2 rc=11 / 数学真值 13 双侧分叉）。字面量豁免（含 -1 形态）——按
//   另一侧类型参与（Rust 字面量推断惯例，191「大 > 100」锚保留）。类型推导 -1
//   （成员/嵌套二元等半实现面）跳过=检不出，随 v2 语义类型推导完善收口（与
//   字符串比较拒绝检查同款诚实边界）。

// 整数族类型ID 判定（整8~整128/正8~正128）——混合符号检查用
函数 是整数族类型ID(整64 类型ID) -> 布尔 {
    字符串 t = 字符串复制(驻留文本(类型ID));
    返回 字符串比较(t, "整8") || 字符串比较(t, "整16") || 字符串比较(t, "整32") ||
          字符串比较(t, "整64") || 字符串比较(t, "整128") ||
          字符串比较(t, "正8") || 字符串比较(t, "正16") || 字符串比较(t, "正32") ||
          字符串比较(t, "正64") || 字符串比较(t, "正128");
}

// 无符号类型ID 判定（正8~正128）——混合符号检查用
函数 是无符号类型ID(整64 类型ID) -> 布尔 {
    字符串 t = 字符串复制(驻留文本(类型ID));
    返回 字符串比较(t, "正8") || 字符串比较(t, "正16") || 字符串比较(t, "正32") ||
          字符串比较(t, "正64") || 字符串比较(t, "正128");
}

// 操作数末端节点是否整数字面量形态（整数字面量，或 负号 作用于整数字面量
//   如 -1——区间末=表达式根惯例；负号操作数根=其 子终点-1）
函数 是整数字面量末端(向量<节点> 池, 整32 末端索引) -> 布尔 {
    如果 (末端索引 < 0 || 末端索引 >= 整32(池.大小())) { 返回 假; }
    节点 末端 = 池.元素(末端索引);
    如果 (末端.类型 == 节点_整数字面量) { 返回 真; }
    如果 (末端.类型 == 节点_负号 && 末端.子终点 > 0) {
        节点 操作数根 = 池.元素(整32(末端.子终点 - 1));
        返回 操作数根.类型 == 节点_整数字面量;
    }
    返回 假;
}

// 混合符号二元运算检查（宿主 semantic_expr.cpp visitBinaryExpr 同构）：
//   左右类型均可推导且均为整数族、符号相异、双侧均非字面量形态时诊断拒绝。
//   比较/算术/位运算共用；左末端=附加-1、右末端=本节点索引-1（调用侧约定
//   〔484 对齐 450/469 同口径·原 子起点-1 旧口径已收口〕）。
//   类型经 表达式类型ID 推导族 + 静默诊断缓冲——检查表达式 有诊断副作用非幂等，
//   操作数已由语句根区间线性遍历权威检查（174 教训：二次递归=未声明重复报），
//   本处推导产生的诊断一律吞弃，仅取类型值；-1（不可推导）跳过=检不出诚实边界。
函数 检查混合符号二元(向量<节点> 池, 整32 左末端索引, 整32 右末端索引,
                    向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    向量<字符串> 静默诊断 = 向量<字符串>();
    可选<整64> 左类型查 = 表达式类型ID(池, 左末端索引, 符号表, 静默诊断);
    可选<整64> 右类型查 = 表达式类型ID(池, 右末端索引, 符号表, 静默诊断);
    整64 左类型 = 0;
    如果 (左类型查.有值) { 左类型 = 左类型查.值; }
    整64 右类型 = 0;
    如果 (右类型查.有值) { 右类型 = 右类型查.值; }
    // 880 批5：无值=不可推导（原 -1/0 miss 同面）——检不出跳过=诚实边界
    布尔 左类型有效 = 左类型 > 0;
    布尔 右类型有效 = 右类型 > 0;
    如果 (!左类型有效 || !右类型有效) { 返回; }
    如果 (!是整数族类型ID(左类型) || !是整数族类型ID(右类型)) { 返回; }
    如果 (是无符号类型ID(左类型) == 是无符号类型ID(右类型)) { 返回; }
    如果 (是整数字面量末端(池, 左末端索引) || 是整数字面量末端(池, 右末端索引)) { 返回; }
    表诊断(诊断, "[错误] 混合符号二元运算禁止：'" + 驻留文本(左类型) + "' 与 '" +
           驻留文本(右类型) + "' —— 须显式转换（如 整64(表达式)/正64(表达式)）；字面量豁免（Rust 对齐，2026-09-10 方案A）");
}


// 混合符号赋值检查（55-c 方案A，2026-09-10 第五十六轮 用户裁决，Rust E0308 对齐，
//   宿主 canConvert 跨符号拒绝+canConvertWithLiteral 字面量豁免同构）：赋值
//   初始化/赋值/返回面的「变量间」混合符号隐式转换拒绝（§3.7 条文扩展——
//   第五十一轮只拦二元运算面）。左类型=赋值目标类型名ID（声明类型/左值类型/
//   函数返回类型，调用方已知——节点_函数.附加/表查找类型ID/推导成员类型ID）；
//   右末端=值表达式末端节点索引（区间末惯例）。右值类型经 表达式类型ID 推导族
//   +静默诊断缓冲（174 教训：二次推导诊断吞弃，语句根线性遍历=权威诊断点）；
//   右值为整数字面量形态（含 -1）豁免——字面量按目标类型参与（Rust 推断惯例，
//   `正64 大 = 9223372036854775808` 等初始化形态保留）；左类型非整数族/引用
//   后缀名/右类型不可推导/-1 时跳过=检不出诚实边界（随 v2 类型推导完善收口）。
函数 检查混合符号赋值(向量<节点> 池, 整64 左类型名ID, 整32 右末端索引,
                    向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    如果 (!是整数族类型ID(左类型名ID)) { 返回; }
    // 取地址右值跳过（&x 产物为指针，类型推导兜底 整64 与真整64 不可区分——
    //   指针赋值面（正8* q = &p.窄 等）不属整数混合符号语义）
    如果 (右末端索引 >= 0 && 右末端索引 < 整32(池.大小()) &&
         池.元素(右末端索引).类型 == 节点_取地址) { 返回; }
    向量<字符串> 静默诊断 = 向量<字符串>();
    可选<整64> 右类型查 = 表达式类型ID(池, 右末端索引, 符号表, 静默诊断);
    整64 右类型 = 0;
    如果 (右类型查.有值) { 右类型 = 右类型查.值; }
    // 880 批5：无值=不可推导（原 -1/0 miss 同面）——检不出跳过=诚实边界
    布尔 右类型有效 = 右类型 > 0;
    如果 (!右类型有效) { 返回; }
    如果 (!是整数族类型ID(右类型)) { 返回; }
    如果 (是无符号类型ID(左类型名ID) == 是无符号类型ID(右类型)) { 返回; }
    如果 (是整数字面量末端(池, 右末端索引)) { 返回; }
    表诊断(诊断, "[错误] 混合符号赋值禁止：'" + 驻留文本(左类型名ID) + "' 与 '" +
           驻留文本(右类型) + "' —— 须显式转换（如 整64(表达式)/正64(表达式)）；字面量豁免（Rust 对齐，2026-09-10 方案A）");
}

// ==================== D38 批2 v2 负测防线语义层（329-a·2026-09-18） ====================
// 43 形态宿主行为矩阵实测对齐（target/p320a/d38b2_matrix*.py 三轮·宿主 check 逐
//   形态实跑）：隐式转换仅宽化放行/浮字面量按 f 后缀分型/布尔与字符串源仅同型/
//   目标=字符特殊放行/复合赋值面不拦（宿主 w19 放行）/条件严格布尔（整数也拒）/
//   显式转换布尔目标仅收布尔源。源类型推导走 静默诊断缓冲（本文件 665 同款惯例
//   ——174 教训：二次推导诊断吞弃）。

// 整数族文本（布尔/字符不属本族——族判定与 类型可合并 的整数族〔含布尔字符〕
//   刻意区分：转换规则里布尔目标与字符目标各有专门条款）
函数 是转换整数族文本(字符串 t) -> 布尔 {
    返回 字符串比较(t, "整8") || 字符串比较(t, "整16") ||
          字符串比较(t, "整32") || 字符串比较(t, "整64") ||
          字符串比较(t, "正8") || 字符串比较(t, "正16") ||
          字符串比较(t, "正32") || 字符串比较(t, "正64") ||
          // 340-m（153 实证）：整128/正128 缺席致显式转换误拒
          字符串比较(t, "整128") || 字符串比较(t, "正128");
}

// 浮点族文本
函数 是转换浮点族文本(字符串 t) -> 布尔 {
    返回 字符串比较(t, "浮32") || 字符串比较(t, "浮64");
}

// 同族宽窄比较位宽：整族/字符=1/2/4/8；浮32=4、浮64=8（跨族不使用）
函数 转换类型位宽(字符串 t) -> 整64 {
    如果 (字符串比较(t, "整8") || 字符串比较(t, "正8") || 字符串比较(t, "字符")) { 返回 1; }
    如果 (字符串比较(t, "整16") || 字符串比较(t, "正16")) { 返回 2; }
    如果 (字符串比较(t, "整32") || 字符串比较(t, "正32") || 字符串比较(t, "浮32")) { 返回 4; }
    如果 (字符串比较(t, "整128") || 字符串比较(t, "正128")) { 返回 16; }
    返回 8;   // 整64/正64/浮64
}

// 740 拆分：推导源类型ID静默/推导源类型文本/二元操作数类型ID/推导二元结果类型ID
//   → 语义检查转换推导.cn（本文件 870 行近 900 冻结警戒线·740 扩口先拆再加
//   纪律·86/443 拆分先例同构；740 同轮在推导族内补算术/位二元与一元负号
//   结果推导=窄化分叉根治面）。

// 788（2026-10-15·宿主 canConvert 3c 条逐字同构·方案C 2026-08-14 立法）：128→64
//   同符号窄化特例——整128->整64 / 正128->正64 隐式放行。修前推导族对带 LL/ULL
//   字面量恒 0 豁免标记（结果恒整32）掩盖本缺口；788 后缀定级接入后
//   `0-9223372036854775807LL` 推整128（宿主 t8「无法将 '整128'…」文案同判·推导
//   无误）→ 转换白名单查无此条=410_布尔短路汇合矩阵 预验红显形（宿主
//   t1/t5/t10 二元表达式放行 vs v2 拒）。跨符号组合（整128->正64）不在特例=
//   随混合符号面拒（宿主 b 条同构）；字面量直赋形态不落本特例面——字面量分支
//   值域门槛先行（t9 `9223372036854775808LL`→整64 双侧同拒已对齐）。
函数 是128收窄64特例788(字符串 源文本788, 字符串 目标文本788) -> 布尔 {
    返回 (字符串比较(源文本788, "整128") && 字符串比较(目标文本788, "整64")) ||
         (字符串比较(源文本788, "正128") && 字符串比较(目标文本788, "正64"));
}

// 隐式转换合法性核心判定（宿主 semantic 隐式转换矩阵同构·43 形态实测）：
//   真=放行；假=调用方须诊断。目标非内置标量（容器/结果/类/结构体合成名）=
//   拷贝/构造语义不做标量检查；目标/源不可推导=检不出诚实边界放行。
函数 隐式转换合法(向量<节点> 池, 整32 源末索引, 整64 目标类型ID,
                 向量<映射<整64, 符号>>& 符号表) -> 布尔 {
    如果 (目标类型ID <= 0) { 返回 真; }
    字符串 目标文本 = 字符串复制(驻留文本(目标类型ID));
    布尔 目标整数 = 是转换整数族文本(目标文本);
    布尔 目标浮点 = 是转换浮点族文本(目标文本);
    布尔 目标字符 = 字符串比较(目标文本, "字符");
    布尔 目标布尔 = 字符串比较(目标文本, "布尔");
    布尔 目标字符串 = 字符串比较(目标文本, "字符串");
    如果 (!(目标整数 || 目标浮点 || 目标字符 || 目标布尔 || 目标字符串)) { 返回 真; }
    如果 (源末索引 < 0 || 源末索引 >= 整32(池.大小())) { 返回 真; }
    节点 源末 = 池.元素(源末索引);
    // 字面量形态（节点类型直判——检查表达式 对整字面量恒返整32 无后缀信息）
    如果 (源末.类型 == 节点_整数字面量) {
        // 565 轮（T36 v2 面·宿主 319-a 统一严格同口径）：整字面量→窄宽目标
        //   值域检查——域内放行/域外拒（g1 整16=40000 / g5 正8=300 / h6
        //   正32=5000000000 宿主拒·v2 曾放行）；整32/整64/正64 目标不检
        //   （h1/h5 宿主任意字面量放行+运行回绕实测定案）。浮目标维持适配
        //   放行（w01/w06/w15/w12）；→布尔 拒（w28）不变。
        //   1160 审查修复 P0-1：字符目标改走 整32 存储域判（甲案）——域内放行
        //   （1114112/-2147483648）、超域拒（2147483648/-2147483649/20 位）。
        如果 ((目标整数 || 目标字符) &&
            !整字面量入域(源末, 池, 目标文本, 假)) {
            返回 假;
        }
        返回 目标整数 || 目标浮点 || 目标字符;
    }
    如果 (源末.类型 == 节点_负号) {
        // 565 轮（T36 v2 面·负号+字面量形态）：`整8 甲=-200` / `正8 甲=-1`
        //   （g9/g10 宿主拒·v2 曾放行）——负号节点 子起点=操作数表达式·操
        //   作数为整字面量时按负值入域判定。→浮/字符适配放行维持。
        // 740（2026-10-14）：操作数非字面量（`整8 甲 = -乙32变量`）修前「检
        //   不出放行」=静默截断分叉（宿主拒「无法将 '整32' 隐式转换为 '整8'」
        //   ·U 探针实录）——推导负号结果类型（转换推导族 740 负号分支·可靠
        //   面）后按位宽判定；推导不出（调用/成员操作数）=既有诚实边界放行。
        如果 (目标整数) {
            // 590（2026-10-16）：多重负号链至字面量（-(-2147483648) 以上）走
            //   值域判定通道（整字面量入域 已链化·层数奇偶定符号）——修前
            //   链形态落 740 推导（负号操作数=负号 → -1）放行=运行静默错值；
            //   宿主解析期双重负号折叠为正字面量后同走值域门槛=零分叉。
            如果 (!是整数字面量末端(池, 源末索引) &&
                 !负号链至字面量(池, 源末索引)) {
                可选<整64> 负源740查 = 推导源类型ID静默(池, 源末索引, 符号表);
                整64 负源740 = 0 - 1;
                如果 (负源740查.有值) { 负源740 = 负源740查.值; }
                如果 (负源740 <= 0) { 返回 真; }
                字符串 负源文本740 = 字符串复制(驻留文本(负源740));
                如果 (是转换整数族文本(负源文本740)) {
                    // 788：128→64 特例同构（与下方表达式分支同款·宿主 visitUnary
                    //   Expr 负号结果经同一 canConvert 白名单）
                    如果 (是128收窄64特例788(负源文本740, 目标文本)) { 返回 真; }
                    返回 转换类型位宽(负源文本740) <= 转换类型位宽(目标文本);
                }
                返回 真;   // 非整数负源（罕见）=诚实边界放行
            }
            返回 整字面量入域(源末, 池, 目标文本, 真);
        }
        // 1160 审查修复 P0-1：字符=整32 存储域（甲案·1137 第三轮 P0-3 同口径）
        //   ——负号字面量/负号链形态同走值域判（1114112/-2147483648 放行·
        //   -2147483649 拒）；非字面量操作数（-变量）维持既有整32→字符位模式
        //   互通放行（宿主 canConvert 同口径·非本任务收窄面）。
        如果 (目标字符 &&
            (是整数字面量末端(池, 源末索引) ||
             负号链至字面量(池, 源末索引))) {
            返回 整字面量入域(源末, 池, 目标文本, 真);
        }
        返回 目标整数 || 目标浮点 || 目标字符;
    }
    如果 (源末.类型 == 节点_浮点字面量) {
        // 浮字面量按文本尾 f 分浮32/浮64（w11 `1.5f`→浮32 过 vs w05 `1.5`→浮32 拒）
        字符串 字面文本 = 字符串复制(驻留文本(整64(源末.文本)));
        整64 文本长 = 字符串长度(字面文本);
        如果 (文本长 > 1 && ((整64(字面文本[文本长 - 1]) & 255) == 102)) {
            返回 目标浮点;   // 浮32字面量→浮32/浮64（w11）
        }
        返回 字符串比较(目标文本, "浮64");   // 浮64字面量仅浮64（w05 窄浮拒）
    }
    如果 (源末.类型 == 节点_布尔字面量) { 返回 目标布尔; }   // t12 真→整32 拒
    如果 (源末.类型 == 节点_字符串字面量) { 返回 目标字符串; }   // t11
    如果 (源末.类型 == 节点_字符字面量) { 返回 目标整数 || 目标浮点 || 目标字符; }
    // 919-final（2026-10-18 用户裁决「字面量单点判域·Rust 口径」）：区间
    //   子树扫描——表达式（含变量/嵌套/三元）内任一整数字面量数学值超目标
    //   类型域 → 拒（单点判域·结果域内不豁免·与表达式含不含变量无关；
    //   声明/赋值/返回/实参/元素五消费面随本单点统一对齐）；先于下方求值面
    //   （求值面仅剩「字面量全在域内但常量结果超承载」面承接）。
    如果 (目标整数) {
        如果 (区间含超域字面量919(池, 源末索引, 目标文本)) { 返回 假; }
    }
    // 919（超承载字面量参与表达式求值双侧静默分叉根治·640 侦察副产品）：
    //   常量整数表达式（全字面量算术 + - * / %·一元 ±负号链）文本级大数安全
    //   求值值域检查——与字面量形态同判据（字面量文本入域·判定单一真源）。
    //   启用条件=求值结果超 int64 承载（解析/折叠链〔折叠文本转值1029 位模式
    //   累加474〕对超承载字面量静默回绕的静默错值面：`静态 整32 槽 =
    //   99999999999999999999+0` v2 修正前 1661992959 静默错值）；承载内值
    //   维持既有推导链（位宽判定/同型放行）不动——防双判。求值哨兵 0=超
    //   u128 域（沿 910 空串口径）→ 一切整型目标超域拒。
    如果 (目标整数) {
        整64 常量出919 = 0;
        如果 (常量末至十进制919(池, 源末索引, 常量出919)) {
            如果 (常量出919 == 0) { 返回 假; }
            字符串 常量值919 = 字符串复制(驻留文本(常量出919));
            字符串 常量数919 = "";
            布尔 常负919 = 拆符号919(常量值919, 常量数919);
            常量数919 = 规范919(常量数919);
            布尔 承载内919 = 数文本不超上界(常量数919, "9223372036854775807");
            如果 (常负919) { 承载内919 = 数文本不超上界(常量数919, "9223372036854775808"); }
            如果 (!承载内919) {
                如果 (!字面量文本入域(常量数919, 目标文本, 常负919)) { 返回 假; }
                返回 真;   // 超承载但目标域内（如 正128 巨字面量）——放行
            }
        }
    }
    // 变量/表达式形态：源类型经静默推导
    可选<整64> 源类型ID查 = 推导源类型ID静默(池, 源末索引, 符号表);
    整64 源类型ID = 0 - 1;
    如果 (源类型ID查.有值) { 源类型ID = 源类型ID查.值; }
    如果 (源类型ID <= 0) { 返回 真; }   // 检不出放行（诚实边界·55-c 同款）
    字符串 源文本 = 字符串复制(驻留文本(源类型ID));
    如果 (字符串比较(源文本, 目标文本)) { 返回 真; }   // 同型
    // 411 同构（宿主 semantic_expr srcNumeric=isNumeric||isEnumType 同款·43 用例
    //   云端误伤根治）：源=枚举（411 批枚举成员推导收口后 推导源类型ID静默 出
    //   枚举名）=C 风格整32 常量源（IR 枚举表 418-a）——转换语境按数值源放行；
    //   算术语境仍由 算术总守卫 拒（两语境分立=宿主同模型）。
    如果 (是枚举名(源类型ID)) { 返回 目标整数 || 目标浮点 || 目标字符; }
    如果 (字符串比较(源文本, "布尔") || 字符串比较(源文本, "字符串")) { 返回 假; }
    布尔 源整数 = 是转换整数族文本(源文本) || 字符串比较(源文本, "字符");
    布尔 源浮点 = 是转换浮点族文本(源文本);
    如果 (!(源整数 || 源浮点)) { 返回 假; }   // 结构体/类/容器源→标量目标拒
    如果 (源整数 && 目标字符) { 返回 真; }   // w29 整变量→字符放行（宿主实测）
    如果 (源整数 && 目标整数) {
        // 788：128→64 同符号窄化特例先行（宿主 canConvert 3c 条·是128收窄64
        //   特例788 头注）——位宽判定前放行整128/正128→整64/正64
        如果 (是128收窄64特例788(源文本, 目标文本)) { 返回 真; }
        返回 转换类型位宽(源文本) <= 转换类型位宽(目标文本);
    }
    如果 (源整数 && 目标浮点) { 返回 真; }   // 整→浮宽化（t14/w15/w23）
    如果 (源浮点 && 目标浮点) { 返回 转换类型位宽(源文本) <= 转换类型位宽(目标文本); }
    返回 假;   // 浮→整（t18/t23/w27）、其余跨族
}

// 标量隐式转换检查（声明初始化/赋值/返回 三面共用·D38 批2 350+305）：
//   不合法即诊断。语境措辞：声明/赋值面="隐式转换为 '目标'"（宿主 350 原文）、
//   返回面="隐式转换为返回类型 '目标'"（宿主 305 原文）。
// 609-a：带状态副作用内置（转移/复制/释放）调用排除——静默类型推导二次到达
//   检查转移调用 会**提前触发已转移标记**（非诊断类状态副作用·静默诊断缓冲
//   防不住·196_v2 全量实锤「变量已转移」双报）——此类调用一律不参与静默
//   类型推导；其返回类型（实参类型·指针/字符串/容器）永非 空类型/结果——
//   425/规则1/声明位三面排除均零漏判。
函数 是副作用内置被调(向量<节点> 池, 整32 调用节点索引) -> 布尔 {
    如果 (调用节点索引 < 0 || 调用节点索引 >= 整32(池.大小())) { 返回 假; }
    节点 c609 = 池.元素(调用节点索引);
    如果 (c609.类型 != 节点_调用 || c609.子起点 <= 0) { 返回 假; }
    如果 (c609.子起点 >= 池.大小()) { 返回 假; }
    节点 被调609 = 池.元素(整32(c609.子起点));
    整64 名609 = 0;
    如果 (被调609.类型 == 节点_标识符 || 被调609.类型 == 节点_成员) {
        名609 = 整64(被调609.文本);
    }
    如果 (名609 == 0) { 返回 假; }
    字符串 名文本609 = 字符串复制(驻留文本(名609));
    返回 字符串比较(名文本609, "转移") || 字符串比较(名文本609, "复制") ||
          字符串比较(名文本609, "释放");
}

函数 检查标量隐式转换(向量<节点> 池, 整32 源末索引, 整64 目标类型ID,
                    向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断,
                    布尔 返回面) -> 空类型 {
    如果 (目标类型ID <= 0) { 返回; }
    字符串 目标文本 = 字符串复制(驻留文本(目标类型ID));
    // 609-a（T100·425 同族·声明/赋值/返回三面）：空类型调用结果赋给非空
    //   类型目标拒绝（宿主 canConvert 拒绝同构·425 声明位探针实证缺口）。
    //   源末端=调用 且精确推导=空类型 才拦（签名表显式 -> 空类型；604-a
    //   方法省略返回类型的兜底空类型不涉=v2 树方法省略形态零扫描实证）。
    //   源类型经静默诊断缓冲（174 教训惯例）；命中后早退——既有链对调用
    //   源 -1 放行会落占位文案垃圾诊断（推导源类型文本 回退目标文本）。
    如果 (源末索引 >= 0 && 源末索引 < 整32(池.大小()) &&
         池.元素(源末索引).类型 == 节点_调用 &&
         !是副作用内置被调(池, 源末索引)) {
        向量<字符串> 静默空609 = 向量<字符串>();
        可选<整64> 空源查609 = 表达式类型ID(池, 源末索引, 符号表, 静默空609);
        整64 空源609 = 0;
        如果 (空源查609.有值) { 空源609 = 空源查609.值; }
        如果 (空源609 == 驻留("空类型")) {
            如果 (返回面) {
                表诊断(诊断, "[错误] 无法将 '空类型' 隐式转换为返回类型 '" + 目标文本 + "'");
            } 否则 {
                表诊断(诊断, "[错误] 无法将 '空类型' 隐式转换为 '" + 目标文本 + "'");
            }
            返回;
        }
    }
    // 824（040 摘取）：源类型=泛型参数（模板态 T 等·实例化时替换为实参类型）
    //   → 放行（宿主模板态同款；99/40 的 `T→元素类型` 误报实证——泛型函数
    //   体内 数组元素=T 的赋值/声明在模板态检查时 T 尚未替换）
    可选<整64> 源类型ID824查 = 推导源类型ID静默(池, 源末索引, 符号表);
    整64 源类型ID824 = 0 - 1;
    如果 (源类型ID824查.有值) { 源类型ID824 = 源类型ID824查.值; }
    如果 (源类型ID824 > 0 && 是泛型参数名(源类型ID824)) { 返回; }
    // 756（2026-10-18 用户裁决·枚举值域门槛）：枚举槽 i32 域——初值/赋值/返回
    //   值为超 i32 域常量（枚举成员常量直存/整数字面量直存）编译期拒；枚举按
    //   整32 存储（成员值域=整64）。判据=枚举槽常量入域756（语义检查字面量域.cn
    //   单点·宿主 intLiteralFitsType 枚举扩展同口径）；文案对齐本函数通用链
    //   （返回面同款措辞·宿主同名面文案对应）。
    如果 (!枚举槽常量入域756(池, 源末索引, 是枚举名(目标类型ID))) {
        如果 (返回面) {
            表诊断(诊断, "[错误] 无法将 '" + 推导源类型文本(池, 源末索引, 符号表, 目标文本) +
                          "' 隐式转换为返回类型 '" + 目标文本 + "'");
        } 否则 {
            表诊断(诊断, "[错误] 无法将 '" + 推导源类型文本(池, 源末索引, 符号表, 目标文本) +
                          "' 隐式转换为 '" + 目标文本 + "'");
        }
        返回;
    }
    如果 (!隐式转换合法(池, 源末索引, 目标类型ID, 符号表)) {
        如果 (返回面) {
            表诊断(诊断, "[错误] 无法将 '" + 推导源类型文本(池, 源末索引, 符号表, 目标文本) +
                          "' 隐式转换为返回类型 '" + 目标文本 + "'");
        } 否则 {
            表诊断(诊断, "[错误] 无法将 '" + 推导源类型文本(池, 源末索引, 符号表, 目标文本) +
                          "' 隐式转换为 '" + 目标文本 + "'");
        }
    }
}

// 740 拆分：推导源类型文本 → 语义检查转换推导.cn（先拆再加纪律·同轮指路）。


// 341/443：如果/当/循环/三元 条件严格布尔检查（宿主 t06/t07/t08 实测——整/浮
//   条件均拒·C 风格非零真不适用 CN）。布尔判定零副作用：比较/短路二元（op 文本）、
//   逻辑非、布尔字面量直判；标识符 表查找类型ID（443：函数名先行=函数指针文本
//   ——表查找给出返回类型·值位口径不可用）；调用 查函数返回类型；其余形态=
//   检不出放行（诚实边界）。
//   关键字前缀=宿主 checkCondition ctx 逐字口径（调用方带引号：'如果'/'当'/'循环'；
//   三元表达式 无引号——宿主 visitTernaryExpr ctx="三元表达式"）。
函数 检查条件布尔(向量<节点> 池, 整32 条件末索引, 字符串 关键字前缀,
                向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    如果 (条件末索引 < 0 || 条件末索引 >= 整32(池.大小())) { 返回; }
    节点 n = 池.元素(条件末索引);
    布尔 条件合法 = 假;
    字符串 实际文本 = "";
    如果 (n.类型 == 节点_二元运算) {
        字符串 op文本 = 字符串复制(驻留文本(整64(n.文本)));
        条件合法 = 字符串比较(op文本, "==") || 字符串比较(op文本, "!=") ||
                  字符串比较(op文本, "<") || 字符串比较(op文本, ">") ||
                  字符串比较(op文本, "<=") || 字符串比较(op文本, ">=") ||
                  字符串比较(op文本, "&&") || 字符串比较(op文本, "||");
        如果 (条件合法) {
            实际文本 = "布尔";
        } 否则 {
            // 算术二元作条件：实际类型按 推导二元类型ID（左右同族取左·静默
            //   缓冲吞弃二次诊断=174 教训；推导失败回退「未知」）
            向量<字符串> 静默缓冲443 = 向量<字符串>();
            可选<整64> 二元类型443查 = 推导二元类型ID(池, 条件末索引, 符号表, 静默缓冲443);
            如果 (二元类型443查.有值) {
                实际文本 = 字符串复制(驻留文本(二元类型443查.值));
            } 否则 {
                实际文本 = "未知";
            }
        }
    } 否则 如果 (n.类型 == 节点_逻辑非) {
        条件合法 = 真;
        实际文本 = "布尔表达式";
    } 否则 如果 (n.类型 == 节点_布尔字面量) {
        条件合法 = 真;
        实际文本 = "布尔";
    } 否则 如果 (n.类型 == 节点_整数字面量) {
        实际文本 = "整32";
    } 否则 如果 (n.类型 == 节点_浮点字面量) {
        实际文本 = "浮64";
    } 否则 如果 (n.类型 == 节点_字符串字面量) {
        实际文本 = "字符串";
    } 否则 如果 (n.类型 == 节点_字符字面量) {
        实际文本 = "字符";   // 443：宿主条件对字符字面量同拒（'字符'）
    } 否则 如果 (n.类型 == 节点_标识符) {
        // 443：函数名作值先行（函数指针文本——表查找给出返回类型·值位口径
        //   不可用；宿主 checkExpr 对函数名标识符 checkFunctionNameValue 同构）
        字符串 函数名值443 = 函数名指针文本(符号表, 整64(n.文本));
        布尔 有函数名值443 = 字符串长度(函数名值443) > 0;
        如果 (有函数名值443) {
            实际文本 = 函数名值443;
        }
        // 非函数名面（独立分支替代原裸 否则——else 降格为非法输入拦截分支）
        如果 (!有函数名值443) {
            整64 类型ID = 0;
            可选<整64> 类型ID查 = 表查找类型ID(符号表, 整64(n.文本));
            // miss 保持 0（下方 >0 判定与原 -1 哨兵同假·880 批5）
            如果 (类型ID查.有值) { 类型ID = 类型ID查.值; }
            条件合法 = 类型ID == 驻留("布尔");
            如果 (类型ID > 0) { 实际文本 = 字符串复制(驻留文本(类型ID)); } 否则 { 条件合法 = 真; }
        }
    } 否则 如果 (n.类型 == 节点_调用 && n.子起点 > 0) {
        节点 被调 = 池.元素(整32(n.子起点));
        如果 (被调.类型 == 节点_标识符) {
            // 443：用户函数返回类型经签名表推导（原 查函数返回类型=IR 期表·
            //   语义期空表恒 miss 放行=「调用返回值作条件」分叉；宿主 checkExpr
            //   对调用给出函数返回类型）
            字符串 调用返回文本443 = 调用返回类型文本443(符号表, 整64(被调.文本));
            如果 (字符串长度(调用返回文本443) > 0) {
                条件合法 = 字符串比较(调用返回文本443, "布尔");
                实际文本 = 调用返回文本443;
            } 否则 {
                // 553（#443 呈报分叉②·443 核验轮实证）：内置函数返回类型补查
                //   ——用户签名表 miss 后查 内置条件返回文本553（数据源=IR 层
                //   内置函数返回类型ID + 宿主空类型面覆盖·实现=语义检查443.cn）。
                //   宿主 checkExpr 对内置调用给出 semantic_builtins 注册返回类型
                //   （`如果(字符串查找(a,b))` 拒「实际为 '整64'」·静默错值：
                //   原 v2 两表皆 miss=非布尔内置作条件放行）——补查后同拒同文。
                字符串 内置文本553 = 内置条件返回文本553(整64(被调.文本));
                如果 (字符串长度(内置文本553) > 0) {
                    条件合法 = 字符串比较(内置文本553, "布尔");
                    实际文本 = 内置文本553;
                } 否则 {
                    条件合法 = 真;   // 返回类型不可推导=放行（诚实边界）
                }
            }
        } 否则 {
            条件合法 = 真;
        }
    } 否则 如果 (n.类型 == 节点_成员) {
        // 443：成员读类型静默推导（宿主 checkExpr 对成员给出字段类型）——
        //   推导成员类型ID 带诊断出参，传静默缓冲吞弃（174 教训·零诊断副作用）
        向量<字符串> 静默缓冲443 = 向量<字符串>();
        可选<整64> 成员类型443查 = 推导成员类型ID(池, 条件末索引, 符号表, 静默缓冲443);
        如果 (成员类型443查.有值) {
            条件合法 = 成员类型443查.值 == 驻留("布尔");
            实际文本 = 字符串复制(驻留文本(成员类型443查.值));
        } 否则 {
            条件合法 = 真;   // 推导失败=放行（诚实边界）
        }
    } 否则 {
        条件合法 = 真;   // 三元/下标等=检不出放行（诚实边界）
    }
    如果 (!条件合法 && 字符串长度(实际文本) > 0) {
        表诊断(诊断, "[错误] " + 关键字前缀 + "条件必须为布尔类型，实际为 '" + 实际文本 + "'");
    }
}


// 343：显式转换 类型(x) 实参类型检查（检查调用表达式 类型名白名单分支挂点·
//   单实参形态）。规则=宿主矩阵实测：布尔目标仅收布尔源（t28 布尔(1) 拒）；
//   字符串源拒（t26）；结构体/类源拒（t24/t25）；数值↔数值（含窄化 w03/w13）
//   与 布尔→数值（t27）与 整→字符（t29）放行；源不可推导放行。
//   实参末位经 查调用实参末位 表（调用节点 子终点 解析期恒 0=空闲位，
//   不能作区间末——解析调用后缀 实参末位表 同款）。
函数 检查显式转换实参(向量<节点> 池, 节点 n, 整32 调用节点索引, 字符串 被调文本,
                    向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    如果 (n.附加 != 1) { 返回; }
    整64 实参末位 = 0 - 1;
    可选<整64> 实参末位查 = 查调用实参末位(整64(调用节点索引), 0);
    // miss（原 -1 哨兵）同走「不可判」放行（诚实边界）——原判定逐字保留
    如果 (实参末位查.有值) { 实参末位 = 实参末位查.值; }
    如果 (实参末位 < 0 || 实参末位 >= 整64(池.大小())) { 返回; }
    整32 实参末索引 = 整32(实参末位);
    整64 目标ID = 驻留(被调文本);
    字符串 实际文本 = 推导源类型文本(池, 实参末索引, 符号表, 被调文本);
    布尔 放行 = 假;
    如果 (字符串比较(被调文本, "布尔")) {
        // 布尔目标仅收布尔源（t28 布尔(1) 拒）——字面量直判（推导不可靠面外
        //   仍可精确判定的形态）；调用/标识符源走推导（-1 放行=诚实边界）
        节点 实参末 = 池.元素(实参末索引);
        如果 (实参末.类型 == 节点_布尔字面量) {
            放行 = 真;
        } 否则 如果 (实参末.类型 == 节点_整数字面量 ||
                    实参末.类型 == 节点_浮点字面量 ||
                    实参末.类型 == 节点_字符串字面量 ||
                    实参末.类型 == 节点_字符字面量) {
            放行 = 假;
        }
        布尔 布尔源走推导514 = 实参末.类型 != 节点_布尔字面量 &&
                                实参末.类型 != 节点_整数字面量 &&
                                实参末.类型 != 节点_浮点字面量 &&
                                实参末.类型 != 节点_字符串字面量 &&
                                实参末.类型 != 节点_字符字面量;
        如果 (布尔源走推导514) {
            可选<整64> 源ID查 = 推导源类型ID静默(池, 实参末索引, 符号表);
            整64 源ID = 0 - 1;
            如果 (源ID查.有值) { 源ID = 源ID查.值; }
            放行 = 源ID == 驻留("布尔") || 源ID <= 0;
        }
    }
    如果 (!字符串比较(被调文本, "布尔")) {
        // 数值/字符/字符串目标：源须为数值族/布尔/字符（字符串目标仅收字符串源）
        节点 实参末 = 池.元素(实参末索引);
        布尔 源是标量值 = 假;
        如果 (实参末.类型 == 节点_整数字面量 || 实参末.类型 == 节点_浮点字面量 ||
             实参末.类型 == 节点_布尔字面量 || 实参末.类型 == 节点_字符字面量) {
            源是标量值 = 真;
        } 否则 如果 (实参末.类型 == 节点_字符串字面量) {
            源是标量值 = 假;   // 字符串字面量→数值拒（t26）
        }
        布尔 标量源走推导514 = 实参末.类型 != 节点_整数字面量 &&
                                实参末.类型 != 节点_浮点字面量 &&
                                实参末.类型 != 节点_布尔字面量 &&
                                实参末.类型 != 节点_字符字面量 &&
                                实参末.类型 != 节点_字符串字面量;
        如果 (标量源走推导514) {
            可选<整64> 源ID查 = 推导源类型ID静默(池, 实参末索引, 符号表);
            整64 源ID = 0 - 1;
            如果 (源ID查.有值) { 源ID = 源ID查.值; }
            如果 (源ID <= 0) {
                源是标量值 = 真;   // 检不出放行（诚实边界）
            } 否则 {
                字符串 源文本 = 字符串复制(驻留文本(源ID));
                源是标量值 = 是转换整数族文本(源文本) || 是转换浮点族文本(源文本) ||
                            字符串比较(源文本, "字符") || 字符串比较(源文本, "布尔") ||
                            字符串比较(源文本, "字符串") ||
                            // 418（002 收口杂项正测族）：指针源=标量族（整64(指针)
                            //   解包·spec 04-一C 指针↔整数同权·16_function_extra
                            //   行59 实录「无法将 '指针' 显式转换为 '整64'」）
                            字符串比较(源文本, "指针") ||
                            // 418-a（D40 细分）：枚举类型源=标量族（C 风格枚举值域整32）
                            是枚举名(驻留(源文本));
                // 源=字符串 且 目标=字符串：同型构造放行；源=字符串 且 目标=数值：
                //   宿主 t26 拒——本分支 源是标量值=真 会放行，特判收紧
                如果 (字符串比较(源文本, "字符串") && !字符串比较(被调文本, "字符串")) {
                    源是标量值 = 假;
                }
            }
        }
        放行 = 源是标量值;
    }
    如果 (!放行) {
        表诊断(诊断, "[错误] 无法将 '" + 实际文本 + "' 显式转换为 '" + 被调文本 + "'");
    }
}

// 067-003 第 10 面辅助：合成名首实参（首个 '$' 后全部·IR签名.cn 同款语义·
//   本地零依赖副本——语义层未导入 IR 包）。'$'=36 字节。
函数 本文件合成名首实参(字符串 名) -> 字符串 {
    整64 位 = -1;
    整64 i = 0;
    当 (i < 字符串长度(名)) {
        如果 ((整64(名[i]) & 255) == 36) { 位 = i; 中断; }
        i++;
    }
    如果 (位 < 0) { 返回 ""; }
    返回 字符串子串(名, 位 + 1, 字符串长度(名) - 位 - 1);
}

// ==================== 415（wt415·658 面）：泛型实参隐式推导 ====================

// 基函数形参类型序列（参数区间逐 节点_参数·指针层/引用层自 附加 还原尾缀：
//   1..255=星·256=引用符——克隆体形参类型表 同构）
// 762 根治：参数终点**正扫判定**——原「子终点节点的子起点」取邻接声明起点，
//   体非空布局（单语句体不入块直接续排·t6 布局）下 子终点=函数全子区间尾，
//   邻接节点=下一顶层声明 → 参数区间被扩进全部体语句（判别3 实锤：体空绿/
//   体有 返回 值; 即红——形参位数错→推导改写静默放弃=泛型隐式调用链失效）。
//   正扫=自 子起点 连续 节点_类型/节点_参数 对推进，遇首个其它节点（体语句
//   起点）停——570 分支 函数末形参类型ID570 同款判定（同构降合并冲突）。
//   （762 实测注记：当前解析器块根后置布局下旧判定与正扫等价——本改为布局
//   无关鲁棒形式·等价变换零行为变更；894-a 子终点-1 直取在体非空时真失效，
//   同轮正扫根治见 语义检查表达式.cn。）
函数 基函数形参类型们(向量<节点> 池, 整32 基函数索引, 向量<字符串>& 类型出) -> 空类型 {
    节点 基声明415 = 池.元素(基函数索引);
    整64 参数位置415 = 整64(基声明415.子起点);
    当 (参数位置415 < 整64(基声明415.子终点) && 参数位置415 < 整64(池.大小())) {
        节点 参数415 = 池.元素(整32(参数位置415));
        // 正扫停机：参数区间外节点（体语句/下一段布局）——参数节点与类型节点
        //   交错排列（参数.附加=类型节点索引·类型节点在子区间内），两形态均属
        //   参数段；其余类型=体语句起点
        如果 (参数415.类型 != 节点_参数 && 参数415.类型 != 节点_类型) { 中断; }
        如果 (参数415.类型 == 节点_参数 && 参数415.附加 >= 0 && 参数415.附加 < 池.大小()) {
            节点 类型节点415 = 池.元素(整32(参数415.附加));
            字符串 类型文本415 = 字符串复制(驻留文本(整64(类型节点415.文本)));
            整64 星415 = 整64(类型节点415.附加);
            当 (星415 >= 1 && 星415 <= 255) {
                类型文本415 = 字符串复制(类型文本415 + "*");
                星415--;
            }
            如果 (整64(类型节点415.附加) == 256) {
                类型文本415 = 字符串复制(类型文本415 + "&");
            }
            结果<空类型, 整32> 加型415 = 类型出.追加(类型文本415);
            如果 (!加型415.正常) { 运行时错误(4); }
        }
        参数位置415++;
    }
}

// 泛型实参隐式推导改写（宿主 303 inferGenericArgs+rewriteGenericFuncCall 场景②
//   同构）：裸名调用命中泛型函数参数序表（最小(3, 7)/线性查找(值, 4, 30)）→
//   逐位推导类型实参→被调文本改写为实例合成名（名$实参）→IR 收集/克隆/签名/
//   决议全链复用显式 <> 通路（419-a/470-a/实例化函数注册 零改动）。推导规则=
//   宿主 303 逐参数对齐：形参类型剥 */& 后缀恰为类型参数→该位从实参推导（实参
//   剥同后缀须匹配·数组实参剥 [N] 尾缀加 * 退化=001 数组名作实参同口径）；固定
//   类型位不参与；同一类型参数多位一致才成。可靠面=实参根为标识符/字面量
//   （宿主 checkExpr 全形态=既有，v2 扩面随类型推导完善同步收口）；任一位不可
//   靠/冲突/未约束→不改写返回 0（走原链=现状）——1030 细化：实参全可靠而形态
//   失配/冲突/未约束=返回 -1（推导失败·调用点报诊断，对齐宿主「未声明的标识符」
//   诚实拒绝面；原静默放行致 IR 按基函数形参造符号链接 undefined）。返回=
//   实例返回类型 ID（基函数返回类型文本 T 替换后驻留）。
函数 推导改写泛型隐式调用(向量<节点> 池, 整32 节点索引,
                    向量<映射<整64, 符号>>& 符号表) -> 整64 {
    // 415-r（多实例污染防线·p5 实录）：470-a 重放语境禁改写——重放=实例体
    //   检查（AST 只读纪律），基体为多实例共享，重放期改写即污染（两倍$整32
    //   重放把基体 恒等(值) 改写为 恒等$整32 → 两倍$整64 克隆体错调）。
    //   嵌套面由 IR 克隆体推导（推导克隆嵌套实例）按实例独立接管。
    如果 (取重放豁免安全区()) { 返回 0; }
    节点 n415 = 池.元素(节点索引);
    整64 调用起点415 = 整64(n415.子起点);
    如果 (调用起点415 <= 0) { 返回 0; }
    节点 被调415 = 池.元素(整32(调用起点415));
    如果 (被调415.类型 != 节点_标识符) { 返回 0; }
    字符串 被调文本415 = 字符串复制(驻留文本(整64(被调415.文本)));
    字符串 基名415 = 剥实例基名(被调文本415);
    // 显式形态（名$实参 合成名·419-a 既有通路）不重复处理
    如果 (字符串长度(基名415) == 0 || !字符串比较(基名415, 被调文本415)) { 返回 0; }
    // 限定名剥前缀（解析层簇② B1 裸名导入绑定产物 核心::最小——参数序表键=
    //   纯名·基函数定位与改写文本同用纯名·与 659 显式解析合成名纯名形态同构：
    //   模块归属由 IR 克隆体签名键基表达，非名字前缀。415-r（P2）：IR 版单一函数）
    字符串 纯名415 = 限定名纯名(被调文本415);
    整64 纯名ID415 = 整64(驻留(纯名415));
    整64 参数序ID415 = 查泛型基类参数序(纯名ID415);
    如果 (参数序ID415 == 0) { 返回 0; }
    向量<整64> 参数名们415 = 向量<整64>();
    泛型参数序拆段(参数序ID415, 参数名们415);   // 415-r（P2）：IR 版单一函数
    整64 实参数415 = 整64(n415.附加);
    如果 (实参数415 == 0) { 返回 0; }
    // 基函数定位（全池扫 节点_函数·894-a 同款——同名唯一·体函数命中）
    整32 基函数索引415 = 0 - 1;
    {
        整64 扫f415 = 0;
        当 (扫f415 < 整64(池.大小())) {
            节点 函f415 = 池.元素(整32(扫f415));
            如果 (函f415.类型 == 节点_函数 &&
                 整64(函f415.文本) == 纯名ID415 &&
                 函f415.子起点 < 函f415.子终点) {
                基函数索引415 = 整32(扫f415);
                中断;
            }
            扫f415++;
        }
    }
    如果 (基函数索引415 == 0 - 1) { 返回 0; }
    向量<字符串> 形参类型们415 = 向量<字符串>();
    基函数形参类型们(池, 基函数索引415, 形参类型们415);
    // 形参位数=实参数（宿主 303 逐形参位对齐口径——类型参数名数独立：
    //   最小(T,T)=1 类型参数×2 形参位，同参多位一致性在逐位推导内查）
    如果 (形参类型们415.大小() != 实参数415) { 返回 0; }
    // 逐位推导（推导值平行表·空=未约束）
    向量<字符串> 推导们415 = 向量<字符串>();
    {
        整64 名i415 = 0;
        当 (名i415 < 参数名们415.大小()) {
            结果<空类型, 整32> 加空415 = 推导们415.追加("");
            如果 (!加空415.正常) { 运行时错误(4); }
            名i415++;
        }
    }
    整64 位415 = 0;
    当 (位415 < 实参数415) {
        字符串 形参类型415 = "";
        如果 (位415 < 形参类型们415.大小()) { 形参类型415 = 形参类型们415.元素(整32(位415)); }
        字符串 形参基415 = 字符串复制(形参类型415);
        字符串 形参尾415 = "";
        当 (字符串长度(形参基415) > 0) {
            整64 尾码415 = 整64(形参基415[整32(字符串长度(形参基415) - 1)]) & 255;
            如果 (尾码415 == 42 || 尾码415 == 38) {
                // 1005（2026-10-18·宿主 generics.cpp 同构）：引用后缀 '&' 不
                //   入尾——实参为左值时类型文本无 '&'（交换(a,b) 的 a 类型=
                //   整32），入尾致尾匹配恒败=隐式推导对 T& 位失效；左值性/
                //   引用绑定校验归主参数检查。混合形态 T*&：'*' 仍入尾。
                如果 (尾码415 == 42) {
                    形参尾415 = 字符串复制("*" + 形参尾415);
                }
                形参基415 = 字符串子串(形参基415, 0, 整32(字符串长度(形参基415) - 1));
            } 否则 { 中断; }
        }
        // 实参类型（可靠面：标识符/字面量）
        整64 实参末415 = 0 - 1;
        可选<整64> 实参末415查 = 查调用实参末位(整64(节点索引), 位415);
        // miss（原 -1 哨兵）同走「不可判」返回 0——原判定逐字保留
        如果 (实参末415查.有值) { 实参末415 = 实参末415查.值; }
        如果 (实参末415 < 0 || 实参末415 >= 整64(池.大小())) { 返回 0; }
        节点 实参根415 = 池.元素(整32(实参末415));
        字符串 实参类型415 = "";
        如果 (实参根415.类型 == 节点_标识符) {
            整64 实参类型ID415 = 0;
            可选<整64> 实参类型ID415查 = 表查找类型ID(符号表, 整64(实参根415.文本));
            // miss 保持 0（下方 >0 判定与原 -1 哨兵同假·880 批5）
            如果 (实参类型ID415查.有值) { 实参类型ID415 = 实参类型ID415查.值; }
            如果 (实参类型ID415 > 0) {
                实参类型415 = 字符串复制(驻留文本(实参类型ID415));
                // 217 同款：指针变量=符号类型 ID 基名·层在语义指针变量表补星
                可选<整64> 指针查415 = 查语义指针变量(整64(实参根415.文本));
                // 独立布尔先行（调用形态在本句完成语义检查/决议登记——避免条件
                //   链内 可选.有值 使后续调用操作数漏检致返回类型未登记）
                布尔 实参非数组415 = !是数组类型文本(实参类型415);
                布尔 实参非空415 = 字符串长度(实参类型415) > 0;
                如果 (指针查415.有值 &&
                    实参非数组415 &&
                    实参非空415 &&
                    !字符串比较(字符串子串(实参类型415, 整32(字符串长度(实参类型415) - 1), 1), "*")) {
                    实参类型415 = 字符串复制(实参类型415 + "*");
                }
            }
        } 否则 如果 (实参根415.类型 == 节点_整数字面量) {
            实参类型415 = "整32";
        } 否则 如果 (实参根415.类型 == 节点_浮点字面量) {
            实参类型415 = "浮64";
        } 否则 如果 (实参根415.类型 == 节点_字符串字面量) {
            实参类型415 = "字符串";
        } 否则 如果 (实参根415.类型 == 节点_调用) {
            // 570（106 H3 函数支路清偿·本段姊妹面）：实参=内置构造器调用
            //   （某些/正常/错误）→ 自然类型推导（构造器自然类型570 单一实现·
            //   宿主 303 checkExpr 全形态对照的构造器面清偿）。原不可靠面放弃
            //   → 不改写 → 泛型函数实参位构造器（包装(某些(5))）实例缺席=
            //   链接期未定义符号（935 用例 LNK2019 实录）。仍不可靠=落下方
            //   空判维持原放弃。
            整64 构造自然415 = 构造器自然类型570(池, 整32(实参末415), 符号表);
            如果 (构造自然415 > 0) {
                实参类型415 = 字符串复制(驻留文本(构造自然415));
            }
        } 否则 如果 (实参根415.类型 == 节点_成员 || 实参根415.类型 == 节点_下标 ||
                    实参根415.类型 == 节点_二元运算 || 实参根415.类型 == 节点_负号 ||
                    实参根415.类型 == 节点_逻辑非 || 实参根415.类型 == 节点_位非) {
            // 1030（1017 采样轮探针 p19 同族·不可靠实参面清偿）：成员/下标/
            //   一元/二元形态经 表达式类型ID 兜底推导（宿主 303 checkExpr 全
            //   形态对照——原放弃面致 IR 按基函数形参造符号链接 undefined：
            //   成员实参 交换(h.值,h.副)/下标实参 交换(表[0],表[2])/值参
            //   取大(a+1,7) 三探针实录）。诊断副作用经静默缓冲吞弃（174 教训·
            //   443 成员条件推导同款）；推不出（<=0）=保留原放弃落下方空判
            //   返回 0（诚实边界）。清单收口=已实测宿主支持且 IR 面已通
            //   （成员/下标取址非泛型对照双侧绿·i2/l 探针）的形态——其余
            //   （一般调用/取地址等）维持原链防无据扩面。
            向量<字符串> 静默415 = 向量<字符串>();
            可选<整64> 兜底查415 = 表达式类型ID(池, 整32(实参末415), 符号表, 静默415);
            // 880 批5：结果化两态分流（有值=类型 ID / 无值=推不出·落下方空判）
            如果 (兜底查415.有值) {
                实参类型415 = 字符串复制(驻留文本(兜底查415.值));
            }
        }
        如果 (字符串长度(实参类型415) == 0) { 返回 0; }
        // 415-r（P1-2 配套）：模板态信号放弃——实参类型=泛型参数名（T/K/V 等
        //   未绑定实参·泛型基函数体内形态）不改写：基体为多实例共享，改写即
        //   污染（两倍$整64 克隆体错调 恒等$整32 形态）；嵌套面由 IR 克隆体
        //   推导（推导克隆嵌套实例）按实例独立接管
        如果 (是泛型参数名(整64(驻留(实参类型415)))) { 返回 0; }
        // 数组实参退化（宿主 303 同款：剥 [N] 尾缀 加 *）
        如果 (是数组类型文本(实参类型415)) {
            可选<字符串> 元素查415 = 数组元素文本(实参类型415);
            如果 (元素查415.有值) {
                字符串 元素415 = 字符串复制(元素查415.值);
                实参类型415 = 字符串复制(元素415 + "*");
            }
        }
        // 位匹配（形参基=类型参数名→推导；固定位不参与推导）
        整64 位约束415 = 0;
        整64 名k415 = 0;
        当 (名k415 < 参数名们415.大小()) {
            字符串 参数名k415 = 字符串复制(驻留文本(参数名们415.元素(整32(名k415))));
            如果 (字符串比较(形参基415, 参数名k415)) {
                位约束415 = 1;
                整64 尾长415 = 字符串长度(形参尾415);
                如果 (字符串长度(实参类型415) < 尾长415) { 返回 0 - 1; }   // 1030：实参可靠但尾长不足=可靠面推导失败
                如果 (尾长415 > 0 &&
                     !字符串比较(字符串子串(实参类型415,
                        整32(字符串长度(实参类型415) - 尾长415), 整32(尾长415)), 形参尾415)) {
                    返回 0 - 1;   // 实参形态与参数位不匹配（T* 位收非指针）——1030 可靠面失败
                }
                字符串 推导值415 = 字符串子串(实参类型415, 0,
                    整32(字符串长度(实参类型415) - 尾长415));
                如果 (字符串长度(推导们415.元素(整32(名k415))) > 0) {
                    如果 (!字符串比较(推导们415.元素(整32(名k415)), 推导值415)) {
                        返回 0 - 1;   // 同一类型参数多位置推导冲突——1030 可靠面失败
                    }
                } 否则 {
                    结果<空类型, 整32> 设推415 = 推导们415.设置(整32(名k415), 推导值415);
                    如果 (!设推415.正常) { 运行时错误(4); }
                }
                中断;
            }
            名k415++;
        }
        // 415-r（P1-5·宿主 303 对齐）：函数指针固定位不参与推导=整体推导失败
        //   保守拒绝（宿主 !boundHere && isFunctionPtr → return false 同构——
        //   放行会让其余位推满即改写=函数指针位类型失配静默通过）
        // 1030：实参可靠而函数指针位无法推导=可靠面失败（-1·调用点报诊断）
        如果 (位约束415 == 0 && 是函数指针类型文本(形参类型415)) { 返回 0 - 1; }
        位415++;
    }
    // 全部类型参数须被约束（宿主同款）
    {
        整64 名c415 = 0;
        当 (名c415 < 参数名们415.大小()) {
            // 1030：实参可靠而类型参数未被任何位约束=可靠面失败（-1）
            如果 (字符串长度(推导们415.元素(整32(名c415))) == 0) { 返回 0 - 1; }
            名c415++;
        }
    }
    // 合成实例名（多实参 '$' 连接）+改写被调文本（纯名形态·659 显式同构）
    字符串 实例文本415 = 纯名415;
    {
        整64 段j415 = 0;
        当 (段j415 < 推导们415.大小()) {
            实例文本415 = 字符串复制(实例文本415 + "$" +
                          字符串复制(推导们415.元素(整32(段j415))));
            段j415++;
        }
    }
    被调415.文本 = 整32(驻留(实例文本415));
    结果<空类型, 整32> 设被调415 = 池.设置(调用起点415, 被调415);
    如果 (!设被调415.正常) { 运行时错误(4); }
    // 实例返回类型：基函数返回类型文本 T→推导值替换（返回位指针层已并文本）
    节点 基声明415 = 池.元素(基函数索引415);
    如果 (整64(基声明415.附加) <= 0) {
        // 648：miss 不可静默——基函数已定位而返回类型标注缺失（附加<=0·110 案
        //   同构静默整32 面）；显形经 IR 包收集表（登记处出诊断行·主收尾统一
        //   中止），原整32 兜底保留（中止前路径）
        登记内部未登记("泛型隐式推导基函数无返回标注", 纯名415, 整64(取当前诊断行()));
        返回 驻留("整32");
    }
    字符串 返回文本415 = 字符串复制(驻留文本(整64(基声明415.附加)));
    向量<整64> 推导ID们415 = 向量<整64>();
    {
        整64 段k415 = 0;
        当 (段k415 < 推导们415.大小()) {
            结果<空类型, 整32> 加推415 = 推导ID们415.追加(
                整64(驻留(推导们415.元素(整32(段k415)))));
            如果 (!加推415.正常) { 运行时错误(4); }
            段k415++;
        }
    }
    字符串 替换后415 = 替换实例类型文本(返回文本415, 参数名们415, 推导ID们415);
    返回 驻留(替换后415);
}

// 413-b（审查 P1-2）：实参传参面「类→接口」隐式转换检查（宿主
//   checkCallExpr 实参 canConvertType 接口段同构·声明/赋值/返回面同文本）。
//   被调=裸标识符函数名 → 全池扫 节点_函数（894-a 末形参先例同款·CN 无重载
//   命中即止）逐形参剥星基名=接口时，对应实参（查调用实参末位 定位·推导
//   源类型ID静默 可靠面=构造调用/标识符）推导为用户类 → 须 类实现接口沿链。
//   方法调用面（对象.方法）实参暂随 v2 逐参类型诚实边界（成员形参签名面
//   后续轮统一收口）。
函数 检查接口形参实参转换(向量<节点> 池, 整32 节点索引,
                        向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    节点 调用n = 池.元素(节点索引);
    如果 (调用n.类型 != 节点_调用 || 调用n.子起点 <= 0 || 调用n.附加 < 1) { 返回; }
    节点 被调k = 池.元素(整32(调用n.子起点));
    如果 (被调k.类型 != 节点_标识符) { 返回; }
    整64 扫k = 0;
    当 (扫k < 整64(池.大小())) {
        节点 函k = 池.元素(整32(扫k));
        如果 (函k.类型 == 节点_函数 && 字符串比较(驻留文本(整64(函k.文本)), 驻留文本(整64(被调k.文本)))) {
            // 413-b 布局实录：函数节点 子起点=参数**类型节点区**起点（类型节点
            //   先于参数节点连续排布·413g 逐槽实证 槽12=类型/槽13=参数）——
            //   形参序只按 节点_参数 计数（类型槽跳过不计），形位k 逐槽推进。
            整64 形序k = 0;
            整64 形位k = 整64(函k.子起点);
            当 (形位k < 整64(函k.子终点)) {
                节点 形参k = 池.元素(整32(形位k));
                如果 (形参k.类型 == 节点_参数 && 形参k.附加 >= 0 &&
                     形参k.附加 < 整64(池.大小())) {
                    如果 (形序k >= 整64(调用n.附加)) { 中断; }   // 形参多于实参=止
                    节点 形类型k = 池.元素(整32(形参k.附加));
                    字符串 形文本k = 字符串复制(驻留文本(整64(形类型k.文本)));
                    整64 剥星位k = 字符串长度(形文本k);
                    // 剥尾 '*' 形态（指针形参 形状*——星层在类型节点附加·
                    //   参数串形态含尾星兜底）
                    当 (剥星位k > 0 &&
                         ((整64(形文本k[整32(剥星位k - 1)]) & 255) == 42)) {
                        剥星位k--;
                    }
                    字符串 形基名k = 字符串子串(形文本k, 0, 整32(剥星位k));
                    整64 形接口IDk = 驻留(形基名k);
                    如果 (是接口名ID(形接口IDk)) {
                        整64 实末k = 0 - 1;
                        可选<整64> 实末k查 = 查调用实参末位(节点索引, 形序k);
                        // miss（原 -1 哨兵）同假——原 >=0 判定逐字保留
                        如果 (实末k查.有值) { 实末k = 实末k查.值; }
                        如果 (实末k >= 0 && 实末k < 整64(池.大小())) {
                            可选<整64> 实IDk查 = 推导源类型ID静默(池, 整32(实末k), 符号表);
                            整64 实IDk = 0 - 1;
                            如果 (实IDk查.有值) { 实IDk = 实IDk查.值; }
                            如果 (实IDk > 0 && 是用户类_ID(实IDk) &&
                                 !类实现接口沿链(实IDk, 形接口IDk)) {
                                表诊断(诊断, "[错误] 无法将 '" + 驻留文本(实IDk) +
                                              "' 隐式转换为 '" + 驻留文本(形接口IDk) + "'");
                            }
                        }
                    }
                    形序k++;   // 形参序只按 节点_参数 递进（类型槽不计）
                }
                形位k++;
            }
            中断;   // 同名函数唯一（CN 无重载）——命中即止
        }
        扫k++;
    }
}

// ==================== 474（运行期整数溢出·回绕逃生门） ====================
// 回绕三件套调用类型检查实现迁 语义检查溢出474.cn（L2 冻结线同族聚合·纯移动
//   零语义）——本文件留薄委托（调用点=语义检查表达式 调用检查位·合并池解析）
函数 回绕调用返回类型474(向量<节点> 池, 整32 节点索引,
                    向量<映射<整64, 符号>>& 符号表) -> 整64 {
    返回 回绕调用返回类型实现474(池, 节点索引, 符号表);
}

