// 语义检查选择（1160 拆分：检查选择 自 语义检查尾.cn 机械搬移 + 情况标签
//   条件类型域判/承载判/重复检测扩展——语义检查尾.cn 929 行已越 900 警戒线，
//   「先拆再加」纪律落点；函数体原逻辑逐字保留，新增段标注 1160）
// 职责：选择语句语义检查——条件表达式 + 各情况值表达式 + 体块 + 1160 标签面：
//   ①整数标签按**条件表达式类型域**判承载（对标宿主 1137 visitSwitchStmt +
//     types::decTextFitsTypeDomain 单点；超域=编译期拒·用户令 #1076 口径）；
//   ②超 整128/正128 语言承载族的标签=编译期拒（对标宿主 parser
//     normalizeCaseIntText 的 integerLiteralRuntimeType 段）；
//   ③整数标签按归一十进制文本去重（-0→0·与宿主 P1-2 同口径），字符/枚举
//     按值去重（宿主 seenValues 共享命名空间同口径）。
//   1193（枚举跨类型情况标签收口·1137 审查派生）：
//   ④裸枚举成员名标签按**条件枚举类型定向解析**（规范 03 §3.4·宿主 C-4 同口径）——
//     条件非枚举报「裸成员名仅用于枚举选择」·条件枚举无该成员报「枚举 'X' 无成员
//     'Y'」·命中值登记 IR情况标签 裸名标签值表（生成层定向取值，替换全局裸名表
//     958 的跨枚举同名覆盖）；⑤字符串情况值/条件类型互斥与字符串去重（规范 C-4
//     一致性约束：字符串情况值仅用于字符串选择，反之整型/枚举值不可用于字符串
//     选择；同值重复编译报错）。
//   判定单点=IR情况标签.cn（归一文本/承载判域/条件域判定），本文件零域表。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（原 导入 语法分析，目录包名）
导入 IR;         // 容器/结果 合成名判定 + 节点_*/键位移 常量（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 1193：情况标签原文（诊断显示用）——宿主 CaseLabel.rawValue 同口径重构：
//   单节点=节点原文（整数/字符/裸标识符/字符串内容）；两节点限定枚举
//   `基名.成员`=基名 + "." + 成员名；其余复合表达式形态无源文本回填通道
//   （诚实边界：按「表达式」显示——该形态本属既有宽松面，另案收口）。
函数 情况标签原文1193(向量<节点> 池, 整64 起, 整64 终) -> 字符串 {
    如果 (终 - 起 == 1) {
        节点 单1193 = 池.元素(整32(起));
        返回 字符串复制(驻留文本(整64(单1193.文本)));
    }
    如果 (终 - 起 == 2) {
        节点 末1193 = 池.元素(整32(终) - 1);
        节点 基1193 = 池.元素(整32(起));
        如果 (末1193.类型 == 节点_成员 && 基1193.类型 == 节点_标识符) {
            返回 字符串复制(驻留文本(整64(基1193.文本))) + "." +
                   字符串复制(驻留文本(整64(末1193.文本)));
        }
    }
    返回 字符串复制("表达式");
}

// 413-a（D44 正体收口）：检查选择语句——值表达式区间 + 各情况值表达式 + 体块。
//   节点字段：文本=值起点、附加=值终点、子起点=第一情况索引、子终点=情况段终点；
//   情况标签：文本/附加=值区间（默认=[0,0)）、子起点=体块索引、子终点=字符串标记。
// 1160 收窄：可归一为常量整数的标签（字面量/±负号/全字面量折叠）已按条件
//   类型域编译期判承载；任意表达式标签的常量性仍为诚实边界（规范 755 口径=
//   常量——v2 现接受表达式·生成期按值码正确比较）。
函数 检查选择(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    节点 选择节点 = 池.元素(节点索引);
    // 选择值表达式区间
    整64 值i = 整64(选择节点.文本);
    当 (值i < 整64(选择节点.附加)) {
        整64 忽略s = 检查表达式(池, 整32(值i), 符号表, 诊断);
        如果 (忽略s == -1) { }
        值i++;
    }
    // 1160：条件表达式类型推导（域判基准=条件类型；枚举归并整32）——
    //   静默诊断向量=类型不可推导的推导期诊断不二次上报（条件区间上方已
    //   逐节点检查；推导 miss 时条件域文本为空串=跳过域判，非静默默认值）。
    整64 条件类型ID1160 = 0 - 1;
    如果 (整64(选择节点.附加) > 整64(选择节点.文本)) {
        向量<字符串> 静默条件类型1160 = 向量<字符串>();
        条件类型ID1160 = 表达式类型ID(池, 整32(整64(选择节点.附加) - 1),
                                     符号表, 静默条件类型1160);
    }
    字符串 条件类型文本1160 = "";
    字符串 条件域文本1160 = "";
    如果 (条件类型ID1160 > 0 && 条件类型ID1160 <= 2147483647) {
        条件类型文本1160 = 字符串复制(驻留文本(条件类型ID1160));
        条件域文本1160 = 情况标签条件域文本(条件类型ID1160, 条件类型文本1160);
    }
    // 1160：已见情况值（整数按归一文本·字符/枚举按值——共用「值:」命名
    //   空间，与宿主 seenValues 单集合去重同口径；字符串标签既有面不扩）
    向量<字符串> 已见值键1160 = 向量<字符串>();
    // 1193：字符串情况值去重（解码后内容为键——宿主 seenStrings 单集合同口径；
    //   与整数/枚举值去重空间分离，宿主同款）
    向量<字符串> 已见字符串1193 = 向量<字符串>();
    // 1193：条件是否字符串（宿主 condIsString 同构；规范 03 §3.4 一致性约束）
    布尔 条件是字符串1193 = 字符串比较(条件类型文本1160, "字符串");
    // 情况段：值表达式 + 体块（新作用域·检查块 递归）
    // 657-a（02_control 阻塞面真根因·机制级）：**类型过滤=节点_情况标签**——
    //   情况段区间 [子起点,子终点) 含情况值表达式/体语句/体块/标签全部节点
    //   （解析层子起点=吃 `{` 后池位置·值与体语句在标签前入池·413-a 设计如此，
    //   生成层 生成语句.cn 两处消费点均有同款过滤）——原实现无过滤把区间内
    //   任意「子起≠0」节点当情况节点：如果/当节点字段 [文本,附加)=[条件区+真块]
    //   被整体当「值表达式区间」在**外层作用域**检查（嵌套块局部声明伪报
    //   「未声明标识符」·探针 p2/p2b 实锤·02_control 第 7 段正中）。
    // 982 转移集分支合流（宿主 980 visitSwitchStmt 同构）：情况 支互斥——各支
    //   从入口态出发（标记不跨支泄漏）·终态 may 并集；有 默认 支=必走恰好一支
    //   →合流=支终态并集；无 默认=可能零支执行→入口态∪支终态（保守 may）。
    整64 转移基线sw = 转移快照压();
    整64 转移合并sw = 转移快照压();   // 空段=支终态累积区（最顶层·段吸安全）
    布尔 有默认sw = 假;
    整64 况预sw = 整64(选择节点.子起点);
    当 (况预sw < 整64(选择节点.子终点)) {
        节点 情况预sw = 池.元素(整32(况预sw));
        如果 (情况预sw.类型 == 节点_情况标签 && 情况预sw.子起点 == 0) { 有默认sw = 真; }
        况预sw++;
    }
    整64 况i = 整64(选择节点.子起点);
    当 (况i < 整64(选择节点.子终点)) {
        节点 情况节点 = 池.元素(整32(况i));
        如果 (情况节点.类型 == 节点_情况标签) {
            // 情况值表达式区间（默认=空值区间 [0,0) 自然空转）
            如果 (情况节点.子起点 != 0) {
                // 1193（枚举/字符串跨类型情况标签收口）：标签形态判定——
                //   单节点区间=字面量/裸标识符形态（限定枚举为两节点）；
                //   字符串标签=单节点 节点_字符串字面量。规范 03 §3.4 C-4：
                //   字符串情况值仅用于字符串选择，反之整型/枚举情况值不可用于
                //   字符串选择；裸枚举成员名仅用于枚举选择（成员须存在于条件
                //   枚举类型）。宿主 visitSwitchStmt/parseCaseValue 同口径。
                布尔 标签单节点1193 = (整64(情况节点.附加) - 整64(情况节点.文本) == 1);
                节点 标签首1193 = 池.元素(整32(情况节点.文本));
                布尔 标签字符串1193 = 标签单节点1193 && 标签首1193.类型 == 节点_字符串字面量;
                布尔 标签裸名1193 = 标签单节点1193 && 标签首1193.类型 == 节点_标识符;
                布尔 条件枚举1193 = 条件类型ID1160 > 0 &&
                                     条件类型ID1160 <= 2147483647 &&
                                     是枚举名(条件类型ID1160);
                // 1193：裸名生效面——条件为枚举=一切单标识符标签按裸名（宿主
                //   parseCaseValue 对裸标识符无条件置 isEnumMember 同口径）；条件
                //   非枚举=仅**枚举成员名**按裸名（该名是某枚举成员→裸成员名不得
                //   用于非枚举选择·规范 03 §3.4），其余裸标识符=变量/常量表达式
                //   标签（1406_v2 X1/X2 既有豁免宽面·本任务不扩大拒绝）
                布尔 裸名生效1193 = 标签裸名1193 &&
                                    (条件枚举1193 ||
                                     查枚举成员裸名值958(整64(标签首1193.文本)) != 0 - 1);
                如果 (标签字符串1193) {
                    // 字符串情况值 vs 条件类型互斥 + 字符串去重（宿主 seenStrings 同口径）
                    布尔 重复串1193 = 假;
                    如果 (!条件是字符串1193) {
                        表诊断(诊断, "[错误] 字符串情况值 '\"" +
                                    字符串复制(驻留文本(整64(标签首1193.文本))) +
                                    "\"' 仅可用于字符串选择（选择 条件须为 字符串 类型）");
                    } 否则 如果 (条件是字符串1193) {
                        字符串 串键1193 = 字符串复制(驻留文本(整64(标签首1193.文本)));
                        整64 见s1193 = 0;
                        当 (见s1193 < 已见字符串1193.大小()) {
                            如果 (字符串比较(已见字符串1193.元素(整32(见s1193)), 串键1193)) {
                                重复串1193 = 真;
                                中断;
                            }
                            见s1193++;
                        }
                        如果 (重复串1193) {
                            表诊断(诊断, "[错误] 选择语句中情况值 '\"" + 串键1193 + "\"' 重复");
                        } 否则 如果 (!重复串1193) {
                            结果<空类型, 整32> 记s1193 = 已见字符串1193.追加(串键1193);
                            如果 (!记s1193.正常) { 运行时错误(4); }
                        }
                    }
                }
                // 1193：非字符串标签 + 字符串条件=编译期拒（规范 C-4 反向条·
                //   宿主 condIsString 段同文案；字符串标签自身不叠加；默认分支
                //   空值区间 [0,0) 非标签值，排除）
                如果 (!标签字符串1193 && 条件是字符串1193 &&
                     整64(情况节点.附加) > 整64(情况节点.文本)) {
                    表诊断(诊断, "[错误] 字符串选择的情况值须为字符串字面量（实际为 '" +
                                情况标签原文1193(池, 整64(情况节点.文本),
                                                整64(情况节点.附加)) + "'）");
                }
                // 1160 审查修复 P1-1：纯常量标签（字面量/负号链/全字面量折叠）
                //   先经 情况标签归一文本 求值——成功即**跳过通用 检查表达式**
                //   （整32 常量折叠 (2147483647+1) 在 整64/整128 条件下是合法
                //   标签，通用溢出检查会误拒；承载/条件域由下方单点判）。归一
                //   失败（标识符/成员/字符串等）才走既有逐节点检查。
                整64 归一ID1160 = 0;
                布尔 整数标签1160 = 情况标签归一文本(池, 整32(情况节点.文本),
                                                    整32(情况节点.附加), 归一ID1160);
                如果 (!整数标签1160) {
                    // 1193：裸名生效时不走通用 检查表达式（裸标识符非变量/函数名
                    //   时会被误报未声明；定向解析/诊断见下方「单值形态」段）；
                    //   非裸名标识符（变量/常量表达式标签）维持既有检查通道
                    如果 (!裸名生效1193) {
                        整64 况值i = 整64(情况节点.文本);
                        当 (况值i < 整64(情况节点.附加)) {
                            整64 忽略c = 检查表达式(池, 整32(况值i), 符号表, 诊断);
                            如果 (忽略c == -1) { }
                            况值i++;
                        }
                    }
                }
                // 1160（审查修复轮）：情况标签值提取三形态——整数归一文本 /
                //   字符码点值 / 枚举成员值（裸名与限定 颜色.成员）：
                //   ①承载判域按宿主 parseCaseIntLabel 第二轮定稿（操作数逐字面量
                //     后缀族：负号+U 族=超域；非负 U 族=正128 2^128-1；其余=整128
                //     ±2^127；折叠结果任一非负 U 操作数=正128 无符号域）；
                //   ②条件域判=宿主 checkSwitchCaseLabel1137（字符/枚举归并整32·
                //     甲案；枚举成员值同受判）；
                //   ③去重键统一=值文本（整数/字符/裸枚举/限定枚举同空间·宿主
                //     seenTexts 单集合同口径）。
                布尔 承载错1160 = 假;
                字符串 值文本1160 = "";
                字符串 显示值1160 = "";
                如果 (整数标签1160) {
                    整64 承载态1160 = 情况标签承载状态1160(
                        池, 整32(情况节点.文本), 整32(情况节点.附加));
                    // 1160 显式哨兵: 承载态=0/1/2 三态显式枚举（1=超整128·2=超正128）
                    如果 (承载态1160 == 1) {
                        表诊断(诊断, "[错误] 整数字面量超出整128（2^127-1）范围");
                        承载错1160 = 真;
                    }
                    // 1160 显式哨兵: 承载态=0/1/2 三态显式枚举（2=超正128 族）
                    如果 (承载态1160 == 2) {
                        表诊断(诊断, "[错误] 整数字面量超出正128（2^128-1）范围");
                        承载错1160 = 真;
                    }
                    // 1160 显式哨兵: 承载态=0 域内且归一文本非超 u128 哨兵才取值文本
                    如果 (!承载错1160 && 归一ID1160 != 0) {
                        值文本1160 = 规范带符919(字符串复制(驻留文本(归一ID1160)));
                        显示值1160 = 值文本1160;
                    }
                }
                // 单值字符/枚举形态（多值分组由解析层拆标签·每标签单值；
                //   限定枚举 颜色.成员=区间 [基名标识符, 成员节点] 两节点——
                //   形态判定看**末节点**，基名经 成员节点.子起点 定位）
                如果 (!整数标签1160 && 整64(情况节点.附加) > 整64(情况节点.文本)) {
                    整64 末值1160 = 整64(情况节点.附加) - 1;
                    节点 单值1160 = 池.元素(整32(末值1160));
                    如果 (单值1160.类型 == 节点_字符字面量) {
                        值文本1160 = 字符串复制(驻留文本(整64(单值1160.文本)));
                        // 1160：字符标签诊断显示=码点文本（宿主 rawValue 为引号形态·
                        //   无源文本回填通道——差异登记见报告）
                        显示值1160 = 值文本1160;
                    }
                    // 1193：裸枚举成员名——条件须为枚举（规范 03 §3.4 一致性约束
                    //   「裸枚举成员名仅用于枚举选择」），成员须存在于**条件枚举
                    //   类型**（宿主 visitSwitchStmt enumValueOf(condType) 同口径）；
                    //   命中即登记生成层定向值表（IR情况标签 1193 表），条件非枚举/
                    //   成员不存在=编译期拒（原全局裸名表 958 命中即放行=宽松面）
                    如果 (裸名生效1193) {
                        字符串 裸名文本1193 = 字符串复制(驻留文本(整64(标签首1193.文本)));
                        如果 (条件枚举1193) {
                            整64 裸成员值1193 = 查枚举成员值(条件类型ID1160,
                                                          整64(标签首1193.文本));
                            // 1193 显式哨兵: 成员值=-1=条件枚举无该成员（查表 miss 显式哨兵）
                            如果 (裸成员值1193 != 0 - 1) {
                                值文本1160 = 整数转字符串(裸成员值1193);
                                显示值1160 = 裸名文本1193;
                                登记裸名标签值1193(整64(况i), 裸成员值1193);
                            } 否则 如果 (裸成员值1193 == 0 - 1) {
                                表诊断(诊断, "[错误] 枚举 '" + 条件类型文本1160 +
                                             "' 无成员 '" + 裸名文本1193 + "'");
                            }
                        } 否则 如果 (!条件枚举1193) {
                            表诊断(诊断, "[错误] 情况标签 '" + 裸名文本1193 +
                                         "' 须为整型/字符常量（裸成员名仅用于枚举选择）");
                        }
                    }
                    // 1160（审查修复 P1-1）：限定枚举标签 颜色.成员——去重键=成员值，
                    //   域判同受（宿主 checkSwitchCaseLabel1137 回填 value 同口径）
                    如果 (单值1160.类型 == 节点_成员 &&
                         单值1160.子起点 >= 0 &&
                         单值1160.子起点 < 整32(池.大小())) {
                        节点 基1160 = 池.元素(整32(单值1160.子起点));
                        如果 (基1160.类型 == 节点_标识符 &&
                             是枚举名(整64(基1160.文本))) {
                            整64 枚值1160m = 查枚举成员值(
                                整64(基1160.文本), 整64(单值1160.文本));
                            // 1160 显式哨兵: 枚值≠-1=限定枚举成员命中（查表 miss=-1 显式哨兵）
                            如果 (枚值1160m != 0 - 1) {
                                值文本1160 = 整数转字符串(枚值1160m);
                                显示值1160 = 字符串复制(
                                    驻留文本(整64(基1160.文本))) + "." +
                                    字符串复制(驻留文本(整64(单值1160.文本)));
                            }
                        }
                    }
                }
                // ②条件类型域（对标宿主 checkSwitchCaseLabel1137·#1076 口径）：
                //   字符/枚举归并整32 甲案（审查修复 P0-C）；超域=编译期拒
                如果 (!承载错1160 && 字符串长度(值文本1160) != 0 &&
                     字符串长度(条件域文本1160) != 0) {
                    如果 (!情况标签在条件域内(值文本1160, 条件域文本1160)) {
                        表诊断(诊断, "[错误] 情况标签 '" + 值文本1160 +
                                     "' 超出条件类型 '" + 条件类型文本1160 +
                                     "' 的表示范围");
                    }
                }
                // ③重复检测：统一值文本键（整数/字符/裸枚举/限定枚举同空间——
                //   宿主 P1-1 单集合口径；承载超域标签已诊断不再入表）
                如果 (!承载错1160 && 字符串长度(值文本1160) != 0) {
                    字符串 去重键1160 = "值:" + 值文本1160;
                    布尔 重复1160 = 假;
                    整64 见i1160 = 0;
                    当 (见i1160 < 已见值键1160.大小()) {
                        如果 (字符串比较(已见值键1160.元素(整32(见i1160)), 去重键1160)) {
                            重复1160 = 真;
                            中断;
                        }
                        见i1160++;
                    }
                    如果 (重复1160) {
                        表诊断(诊断, "[错误] 选择语句中情况值 '" +
                                     显示值1160 + "' 重复");
                    } 否则 如果 (!重复1160) {
                        结果<空类型, 整32> 记键1160 = 已见值键1160.追加(去重键1160);
                        如果 (!记键1160.正常) { 运行时错误(4); }
                    }
                }

            }
            转移恢复到(符号表, 转移基线sw);
            检查块(池, 整32(情况节点.子起点), 符号表, 诊断);
            转移段吸(转移合并sw);
        }
        况i++;
    }
    // 982：有 默认=必走恰好一支→恢复=支终态并集；无 默认=入口态∪支终态
    如果 (有默认sw) {
        转移恢复到(符号表, 转移合并sw);
    } 否则 如果 (!有默认sw) {
        转移恢复到(符号表, 转移基线sw);
        转移并入(符号表, 转移合并sw);
    }
    转移弹栈清(转移基线sw);
}
