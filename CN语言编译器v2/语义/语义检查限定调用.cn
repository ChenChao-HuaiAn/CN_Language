// 语义检查限定调用（445 重构 自 语义检查表达式尾.cn 纯机械搬移·函数体逐字保留·零逻辑变化）
// 职责：调用检查的签名键回退+模块限定调用两通道——「先拆再加」纪律执行
//   （语义检查表达式尾.cn 原 970 行已在 900 警戒线·#445 新增类静态方法分派
//   39 行即破 1000 红线，按 356/357 重构先例拆出本模块）。
// 445（#445 类名::静态方法() 直接调用）：检查限定调用 模块成员 miss 分支补
//   类静态方法分派（实参数编译期检查对齐宿主族C4 文案）。

导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（目录包名）
导入 IR;         // 容器/结果 合成名判定（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

函数 检查签名键回退(向量<节点> 池, 节点 n, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断, 整64 被调名) -> 整64 {
        整64 调键基 = 三级键基查找(符号表, 被调名, 整64(n.附加));
        如果 (调键基 >= 0) {
            整64 查调签数 = 查函数签名个数(调键基);
            如果 (查调签数 >= 0) {
                如果 (查调签数 > 0) {
                    整64 查调签串 = 查函数签名参数串(调键基 * 键位移);
                    如果 (查调签串 >= 0) {
                        整64 调签键 = 函数签名键(调键基, 驻留文本(查调签串));
                        整64 调签类型 = 全局层查类型(符号表, 调签键);
                        如果 (调签类型 != -1) {
                            登记调用决议(符号表, 被调名, 整64(节点索引));
                            // plans/019 阶段3b：调用借用纪律（回退段——键基精确）
                            检查调用借用纪律(池, 节点索引, 调键基, 符号表, 诊断);
                            返回 调签类型;
                        }
                    }
                }
            }
        }
    // 203-a：未决议路径显式 -1 哨兵（原落空语义=主函数继续内置/限定/未声明链）
    返回 -1;
}

// plans/018 第 4 层：用户模块限定调用 m::x（限定调用恒明确、不参与遮蔽，
//   规格 5.9.7）——B1 改写产物与显式限定同形态；模块已加载即可用（宿主呈报
//   一B「限定调用按已加载放行」对齐），但符号须存在且（跨模块时）公开；
//   stdlib 前面内置表已兜底，此处仅用户模块。
// 返回：-2=非限定形态（调用方报未声明函数）；否则=类型ID（含 -1 已诊断）。
函数 检查限定调用(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    整64 调用起点 = 整64(n.子起点);
    如果 (调用起点 <= 0) { 返回 -2; }
    节点 被调节点 = 池.元素(整32(调用起点));
    如果 (被调节点.类型 != 节点_标识符) { 返回 -2; }
    字符串 被调文本 = 字符串复制(驻留文本(整64(被调节点.文本)));
字符串 限定模块s = "";
字符串 限定符号s = "";
如果 (拆限定名(被调文本, 限定模块s, 限定符号s) == 1 &&
     (!是标准库模块名(限定模块s) ||
      查模块成员键基含转发1011(驻留(限定模块s), 驻留(限定符号s)).正常)) {
    // 932：本地同名模块优先——成员索引命中=本地文件符号（本地声明收集注册；
    //   stdlib 文件不注册→miss 走内置兜底原行为·572 IO::打印 实证）
    整64 限源ID = 驻留(限定模块s);
    整64 限符ID = 驻留(限定符号s);
    整64 限键基 = 0;
    结果<整64, 整32> 查限 = 查模块成员键基含转发1011(限源ID, 限符ID);
    如果 (查限.正常) {
        限键基 = 查限.值;
    } 否则 {
        // 445（#445 类名::静态方法() 直接调用·::矩阵）：模块成员索引 miss 后查
        //   类静态方法——计数器::获取总数() 直接调用位（限定模块段=类名·限定
        //   符号段=静态方法名）。宿主 collectQualifiedCallInfo isTypeName 分流
        //   + 族C4 checkStaticMethodCall 同通道（:: 与点号同语义·静态分派无
        //   this）；v2 发射=IR 层 070 波G IR_函数地址 + T69 间接调用（静态方法
        //   定义侧无 this 槽·ABI 恒匹配）。实参数编译期检查对齐宿主族C4 文案
        //   「静态方法 'X' 期望 N 个实参，实际提供 M 个」（参数串=逗号连接类型
        //   文本·空串=无参）。
        如果 (是用户类(限定模块s) &&
             是类静态方法(整64(驻留(限定模块s)), 整64(驻留(限定符号s)))) {
            整64 期望数445 = 0;
            整64 参数串ID445 = 查类方法参数串(整64(驻留(限定模块s)),
                                            整64(驻留(限定符号s)));
            // 空串参数串的驻留 ID 恒非 0——须对**文本长度**判定（ID!=0 判定
            //   会把无参方法误数成 1 参·首版探针实录）
            如果 (参数串ID445 != 0 &&
                 字符串长度(字符串复制(驻留文本(参数串ID445))) > 0) {
                字符串 参数串445 = 字符串复制(驻留文本(参数串ID445));
                期望数445 = 1;
                整64 扫p445 = 0;
                当 (扫p445 < 字符串长度(参数串445)) {
                    如果 ((整64(参数串445[整32(扫p445)]) & 255) == 44) {
                        期望数445++;
                    }
                    扫p445++;
                }
            }
            如果 (整64(n.附加) != 期望数445) {
                表诊断(诊断, "[错误] 静态方法 '" + 限定符号s + "' 期望 " +
                              整数转字符串(期望数445) + " 个实参，实际提供 " +
                              整数转字符串(整64(n.附加)) + " 个");
            }
            // 返回类型=类方法返回表（沿链）——miss 时 -1 哨兵（类型推导诚实
            //   边界·与 1007 值形态同判据；诊断已表的实参数错位不再雪上加霜）
            整64 静返445 = 查类方法返回(整64(驻留(限定模块s)),
                                      整64(驻留(限定符号s)));
            如果 (静返445 > 0) { 返回 静返445; }
            返回 -1;
        }
        表诊断(诊断, "[错误] 未声明的标识符: " + 被调文本 +
                      "（模块 " + 限定模块s + " 无符号 " + 限定符号s + "）");
        返回 -1;
    }
    布尔 限自模块 = 字符串比较(限定模块s, 驻留文本(当前模块路径ID));
    如果 (!限自模块) {
        整64 查限公 = 查模块成员公开(限源ID, 限符ID);
        如果 (查限公 < 0) {
            表诊断(诊断, "[错误] 符号 '" + 限定符号s + "' 为模块 '" +
                          限定模块s + "' 私有（未以 公开: 标注），不可限定调用（规格08 5.9.3）");
            返回 -1;
        }
    }
    // 候选数提取（结果 流敏感检查惯例）
    整64 限候选数 = 0;
    整64 查限数 = 查函数签名个数(限键基);
    如果 (查限数 >= 0) {
        限候选数 = 查限数;
    }
    如果 (限候选数 > 0) {
        调用决议登记(整64(节点索引), 限键基);
    }
    // 返回类型：签名表首个候选（重载精确决议在 IR 层）或符号表键基条目
    整64 限类型 = -1;
    如果 (限候选数 > 0) {
        整64 查限串 = 查函数签名参数串(限键基 * 键位移);
        如果 (查限串 >= 0) {
            限类型 = 全局层查类型(符号表, 函数签名键(限键基, 驻留文本(查限串)));
        }
    }
    如果 (限类型 == -1) {
        限类型 = 全局层查类型(符号表, 限键基);
    }
    返回 限类型;
}
    返回 -2;
}
