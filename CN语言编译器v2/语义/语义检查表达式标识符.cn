// 语义检查表达式标识符（648 拆分自 语义检查表达式.cn 纯机械搬移·函数体逐字保留·零逻辑变化）
// 职责：标识符检查族——检查标识符表达式（符号表直查/合成名/类型名/内置名/签名回退/未声明诊断）
//   + 检查限定标识符（模块限定解析+公强制）。消费=语义检查/语义检查中/语义检查表达式。

导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/键位移 常量（目录包名）
导入 IR;         // 容器/结果 合成名判定（目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// 标识符表达式检查（自 检查表达式 标识符分支机械搬移）：符号表直查 →
//   容器/结果合成名 → 类型名白名单 → 内置函数名 → 用户模块限定名 →
//   签名表同名候选回退 → 未声明诊断。
函数 检查标识符表达式(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    // 070 波B（1022）：lambda 合成函数名豁免（入口前置——表查找 miss 后的
    //   长链各分支会先吞 ?前缀名·插桩定位后确认放此最前）
    字符串 名文本预 = 字符串复制(驻留文本(整64(n.文本)));
    如果 (字符串长度(名文本预) > 0 && (整64(名文本预[0]) & 255) == 63) {
        可选<整64> lambda类型预查 = lambda合成类型(整64(n.文本), 池, 符号表, 诊断);
        如果 (lambda类型预查.有值) { 返回 lambda类型预查.值; }
        返回 -1;
    }
可选<整64> 找到类型查 = 表查找类型ID(符号表, 整64(n.文本));
如果 (找到类型查.有值) {
    整64 找到类型 = 找到类型查.值;
    // plans/019 阶段1（2026-09-10）：已转移变量使用拒绝（E0382 对标）——读值
    //   根拦截点（表达式/实参/返回/操作数经此；转移调用实参的首次检查先于
    //   调用节点标记=线性顺序天然不误报）
    如果 (表查已转移(符号表, 整64(n.文本)) > 0) {
        表诊断(诊断, "[错误] 变量已转移，不能继续使用（显式转移后源变量禁用）: " +
                      驻留文本(整64(n.文本)));
    }
    // 010（def-init）：标量未初始化读判定（E0381 同位挂点）。数组名/结构体名
    //   裸引用不在判定面（数组元素读由 检查下标表达式 精确判；结构体成员读由
    //   成员分支变量键判）——宿主语义对齐·窄面诚实边界见 语义检查初始化.cn 头。
    //   （426：本判定为粗筛——登记点豁免后键不存在·查读 miss 自放行）
    如果 (状态是值类型(找到类型) && !状态读赋值目标中()) {
        如果 (数组长度文本(驻留文本(找到类型)) <= 0 && 查结构体类型(找到类型) == 0) {
            状态查读变量(符号表, 整64(n.文本), 诊断);
        }
    }
    返回 找到类型;
}
// P7b（2026-09-01）：容器/结果 合成名（向量$整64/结果$空类型$整32）合法——
//   构造调用 向量<整64>() 的被调标识符（语法层已合成 $ 实例名）。
如果 (是容器类(驻留文本(整64(n.文本))) || 是结果类型(驻留文本(整64(n.文本)))) {
    返回 整64(n.文本);
}

// P6g（2026-08-30）：类型名（整32/整64/浮64/布尔/字符串）作标识符合法——
//   类型转换 整32(x) 的被调标识符；不作为函数/变量时报未声明。
字符串 名文本 = 字符串复制(驻留文本(整64(n.文本)));
如果 (字符串比较(名文本, "整32") || 字符串比较(名文本, "整64") ||
     字符串比较(名文本, "浮32") || 字符串比较(名文本, "浮64") ||
     字符串比较(名文本, "布尔") || 字符串比较(名文本, "字符") ||
     字符串比较(名文本, "字符串") || 字符串比较(名文本, "正32") ||
     字符串比较(名文本, "正64") || 字符串比较(名文本, "整8") ||
     字符串比较(名文本, "整16") || 字符串比较(名文本, "正8") ||
     字符串比较(名文本, "正16") ||
     // 967（002·053 复工）：128 位类型名（整128(1) 转换被调/类型大小(整128)
     //   实参位）——原缺席报「未声明标识符: 整128」（306/409/419/57 四例）
     字符串比较(名文本, "整128") || 字符串比较(名文本, "正128") ||
     // 418（002 收口杂项正测族）：指针 类型名（指针(整数) 转换被调位）——
     //   原缺席报「未声明标识符/函数: 指针」（16_function_extra 行58 实录·
     //   宿主 spec 04-一C 指针↔整数转换同权）
     字符串比较(名文本, "指针")) {
    返回 整64(n.文本);
}
// ③ 第一波（2026-09-03）：内置函数名作标识符合法（调用的被调标识符子节点
//   先经此处检查）；类型大小 编译期折叠（返回 整64）。
如果 (内置函数返回类型ID(名文本) != 0) { 返回 内置函数返回类型ID(名文本); }
如果 (字符串比较(名文本, "类型大小")) { 返回 驻留("整64"); }
// plans/019 阶段1：显式转移 转移(变量) 的被调标识符合法（调用节点特判检查；
//   此处仅放行名字——返回类型占位不被消费）
如果 (字符串比较(名文本, "转移")) { 返回 驻留("整64"); }
// 206-c（波 4·plans/020 第七十二节）：复制(表达式) 泛型克隆内置的被调标识符
//   合法（调用节点特判检查；此处仅放行名字——返回类型占位不被消费，转移 同款）
如果 (字符串比较(名文本, "复制")) { 返回 驻留("整64"); }
// 71-a（2026-09-11 方案A 用户裁决）：内置构造器 正常/错误/某些 的被调标识符
//   合法（调用节点构造器分支特判检查+装箱语境推导；此处仅放行名字——
//   返回类型占位不被消费，转移 同款）。
//   475-a 实测定案：本路径同时服务 callee 位与裸名位（无语境可分·24 族
//   callee 位回归实证）——**59 行维持放行不动**；裸名拒绝=语句级单点
//   （474-a 返回语句位+本 475-a 声明初始化/赋值位·语义检查.cn）。
如果 (字符串比较(名文本, "正常") || 字符串比较(名文本, "错误") ||
     字符串比较(名文本, "某些")) { 返回 驻留("整64"); }
    整64 限标识类型 = 检查限定标识符(池, 节点索引, 符号表, 诊断);
    如果 (限标识类型 != -2) {
        返回 限标识类型;
    }
// 呈报③方案A（2026-09-06）：函数登记键=签名键（名#参数串）——纯名查不到
//   合法函数，按签名表同名候选回退（返回类型取首个候选；精确决议在 IR 层）
//   plans/018 第 3 层：回退键基化（非主模块函数键=模块$名——三级决议）；
//   签名键直查全局层（复合键不经三级）
// 648 归档：同名候选「返回类型取首个候选」=恢复路径非 miss——CN 无重载（规范），
//   同键基多候选仅两态：跨文件同名共存防御域（IR 容器签名 943·候选>1 才拼
//   #参数串）与重定义非法面（语义层声明收集诊断）；此处簿记取首个候选后，
//   调用由 IR 层 统一链接键（键基#参数串）精确决议消费，失真不被终态消费。
整64 标识键基 = 三级键基查找(符号表, 整64(n.文本), 0 - 1);
如果 (标识键基 >= 0) {
    结果<整64, 整32> 查标识签数 = 查函数签名个数(标识键基);
    如果 (查标识签数.正常) {
        // 命中即有候选（计数登记恒 ≥1·.正常 即原 >0 判定）
        结果<整64, 整32> 查标识签串 = 查函数签名参数串(标识键基 * 键位移);
        如果 (查标识签串.正常) {
            整64 标识签键 = 函数签名键(标识键基, 驻留文本(查标识签串.值));
            可选<整64> 标识签类型查 = 全局层查类型(符号表, 标识签键);
            如果 (标识签类型查.有值) { 返回 标识签类型查.值; }
        }
    }
}
// -2 = 使用点歧义（E0659 已在三级决议内经缓冲诊断）——不再重复报未声明
如果 (标识键基 != -2) {
    // 418-a（D40 细分）：枚举名裸标识符（成员链基名 颜色.绿/类型位 颜色 c）——
    //   枚举表命中=合法·值域=整32（C 风格枚举）
    如果 (是枚举名(整64(n.文本))) { 返回 整64(驻留("整32")); }
    // 1017（171 转批·缺陷二配套）：类型文本形态豁免——类型大小(类型) 实参节点
    //   （解析层 1017 特判入池·文本=「整32*」「整64[5]」「点」等类型文本）先于
    //   调用节点被线性遍历检查。**位置=限定名/签名回退/枚举之后**：导入符号的
    //   模块私有可见性检查（83_v2 负测 5 诊断）不得被截胡（首版放 标识符检查
    //   前段·语法层导入展开的合成限定名被 类型名宽度 查表命中→吞「私有不可
    //   限定调用」诊断 5→4 全量实证）——走到此处=非导入符号非函数非枚举，
    //   类型名宽度>0（基本/指针/数组文本/结构体/结果/容器 单点判定链）即
    //   类型文本形态→放行返回 整64（类型大小 折叠返回类型·967 在调用位改写
    //   字面量）。宽度 0=落下方既有未声明链（负例照报；与宿主「类型大小:
    //   未声明类型」诊断文案分叉=既有挂账面非本轮扩面）。
    如果 (类型名宽度(整64(n.文本)) > 0) { 返回 驻留("整64"); }
    // 464-a（T70 面⑥）：stdlib 模块名根（源码级加载的 stdlib 内部实现调内置
    //   成员，如 IO.cn 行 44 `IO.打印到错误(消息)`——根=内置模块名 IO）——
    //   模块名根放行（类型占位 -1 不被消费；成员决议=IR 内置表·生产态
    //   stdlib 源码不编译=零触发·对齐「内置走限定名直调」设计注释）。
    如果 (是标准库模块名(名文本)) { 返回 -1; }
    // 419-a（D42 波 3）：泛型函数实例合成名（名$实参）——基名命中参数序表放行
    如果 (字符串长度(剥实例基名(名文本)) > 0 &&
         !字符串比较(剥实例基名(名文本), 名文本) &&
         查泛型基类参数序(驻留(剥实例基名(名文本))) != 0) {
        返回 -1;
    }
    // 070 波B（1022 深度机·任务 #070）：lambda 合成函数名豁免——?前缀名=
    //   解析层脱糖合成的匿名函数 ?lambdaN（池尾合成·不进程序声明区间=签名表
    //   无条目）→ 类型=函数指针<返回>(参数…)（宿主 visitLambdaExpr lastType_
    //   同形态）。返回类型无标注（合成节点类型位=0）时扫体单一 返回 表达式
    //   推导（宿主 lambdaInferMode_ 同语义）并写回池（IR 生成合成函数时消费）。
    如果 (字符串长度(名文本) > 0 && (整64(名文本[0]) & 255) == 63) {
        可选<整64> lambda类型查 = lambda合成类型(整64(n.文本), 池, 符号表, 诊断);
        如果 (lambda类型查.有值) { 返回 lambda类型查.值; }
        返回 -1;
    }
    // 070 波G（1026）：类内静态字段裸名——当前类方法体上下文的静态字段 →
    //   类型=静态类型们[静态序号]（IR 层 生成标识符加载 同判据静态槽读）
    {
        整64 当前类g = 查当前检查类ID();
        如果 (当前类g != 0) {
            结果<整64, 整32> 类型直g = 查类静态字段类型(当前类g, 整64(n.文本));
            如果 (类型直g.正常) { 返回 类型直g.值; } 否则 {
            }
        }
    }
    // 474（运行期整数溢出·回绕逃生门）：回绕加/减/乘 三件套裸名放行——
    //   后缀流线性遍历先查标识符后查调用节点，此处返回 -1 占位（未知类型），
    //   调用位合法性与返回类型由 调用检查 474 分派（回绕调用返回类型474）接管。
    如果 (字符串比较(名文本, "回绕加") || 字符串比较(名文本, "回绕减") ||
         字符串比较(名文本, "回绕乘")) {
        返回 -1;
    }
    表诊断(诊断, "[错误] 未声明标识符: " + 名文本);
}
返回 -1;
}

//   模块限定（成员索引+公开强制）——限定调用恒明确不参与遮蔽，规格 5.9.7
// 返回：-2=非限定形态（调用方继续走签名表回退）；否则=类型ID（含 -1 已诊断）。
函数 检查限定标识符(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    字符串 名文本 = 字符串复制(驻留文本(整64(n.文本)));
字符串 标限模块s = "";
字符串 标限符号s = "";
如果 (拆限定名(名文本, 标限模块s, 标限符号s) == 1 &&
     是用户类_ID(驻留(标限模块s)) &&
     是类静态方法(驻留(标限模块s), 驻留(标限符号s))) {
    // 070 波G 余波（1026）：类名::静态方法 限定引用（98 形态·应用(计算器::
    //   双倍静态, 5)）——类型=方法返回类型（IR 层 限定 FuncAddr 方法符号）
    整64 返回类st = 查类方法返回(驻留(标限模块s), 驻留(标限符号s));
    如果 (返回类st > 0) { 返回 返回类st; }
    // 648：miss 不可静默——是类静态方法 判定已真而 查类方法返回 miss=两表
    //   不一致的内部缺陷面；显形经 IR 包收集表（登记处出诊断行·主收尾统一
    //   中止）后保留原整32 兜底（中止前路径）
    登记内部未登记("类静态方法返回类型查询 miss", 标限模块s + "::" + 标限符号s,
                   整64(取当前诊断行()));
    返回 驻留("整32");
}
// 434（类名::静态字段 限定读·#284 ::矩阵第五态）：类静态方法判定后补字段位
//   ——宿主 `类名::字段` 与 `类名.字段` 同通道折叠 MemberExpr（语义/IR 零
//   分叉·292/561 点号锚），v2 限定复合名在此回退取 查类静态字段类型（共用
//   判定 查限定名静态字段类型 单点分派·IR 读位 查限定名静态序号 同源对齐）。
//   类型 0（非类静态字段）落下方模块路径判定=既有诊断不变。
{
    结果<整64, 整32> 字段类查434 = 查限定名静态字段类型(整64(n.文本));
    如果 (字段类查434.正常) { 返回 字段类查434.值; } 否则 {
    }
}
布尔 是限定751 = 拆限定名(名文本, 标限模块s, 标限符号s) == 1;
布尔 转发命中751 = 假;
如果 (是限定751) {
    结果<整64, 整32> 查转751 = 查模块成员键基含转发1011(驻留(标限模块s), 驻留(标限符号s));
    转发命中751 = 查转751.正常;
}
如果 (是限定751 && (!是标准库模块名(标限模块s) || 转发命中751)) {
    // 932：本地同名模块优先（成员索引命中判本地——同 检查限定调用 口径）
    整64 标源ID = 驻留(标限模块s);
    整64 标符ID = 驻留(标限符号s);
    整64 标键基 = 0;
    结果<整64, 整32> 查标限 = 查模块成员键基含转发1011(标源ID, 标符ID);
    如果 (查标限.正常) {
        标键基 = 查标限.值;
    } 否则 {
        // 1007（98 静态方法作值·P3-23）：模块索引 miss 后查类静态方法——
        //   计算器::双倍静态 值形态（限定模块段=类名·限定符号段=静态方法名）
        //   → 放行（类型 -1·IR 层 IR_函数地址 发射；宿主静态分发 FuncAddr 同构）
        如果 (是用户类(标限模块s) &&
             是类静态方法(整64(驻留(标限模块s)), 整64(驻留(标限符号s)))) {
            返回 -1;
        }
        表诊断(诊断, "[错误] 未声明的标识符: " + 名文本 +
                      "（模块 " + 标限模块s + " 无符号 " + 标限符号s + "）");
        返回 -1;
    }
    布尔 标自模块 = 字符串比较(标限模块s, 驻留文本(当前模块路径ID));
    如果 (!标自模块) {
        结果<整64, 整32> 查标公 = 查模块成员公开(标源ID, 标符ID);
        // #1506：公开表查询三态——正常(0/1)=私有/公开合法面；错误=成员索引
        //   在册而两表登记不一致（编译器内部缺陷），不得当用户语义错误报。
        整64 查标公值 = 0;
        如果 (查标公.正常) { 查标公值 = 查标公.值; }
        如果 (!查标公.正常) {
            表诊断(诊断, "[内部错误] 模块成员公开表与成员索引不一致：'" +
                         标限模块s + "::" + 标限符号s + "'（#1506·登记缺失）");
            返回 0 - 1;
        }
        如果 (查标公值 == 0) {
            表诊断(诊断, "[错误] 符号 '" + 标限符号s + "' 为模块 '" + 标限模块s +
                          "' 私有（未以 公开: 标注），不可限定调用（规格08 5.9.3）");
            返回 -1;
        }
    }
    // 返回类型：签名表首个候选（重载精确决议在 IR 层）或符号表键基条目
    //   （候选数提取——结果 流敏感检查惯例）
    整64 标类型 = -1;
    整64 标候选数 = 0;
    可选<整64> 标类型查 = 无;
    结果<整64, 整32> 查标数 = 查函数签名个数(标键基);
    如果 (查标数.正常) {
        标候选数 = 查标数.值;
    }
    如果 (标候选数 > 0) {
        结果<整64, 整32> 查标串 = 查函数签名参数串(标键基 * 键位移);
        如果 (查标串.正常) {
            标类型查 = 全局层查类型(符号表, 函数签名键(标键基, 驻留文本(查标串.值)));
        }
    }
    如果 (!标类型查.有值) {
        标类型查 = 全局层查类型(符号表, 标键基);
    }
    如果 (标类型查.有值) { 标类型 = 标类型查.值; }
    返回 标类型;
}
    返回 -2;
}
