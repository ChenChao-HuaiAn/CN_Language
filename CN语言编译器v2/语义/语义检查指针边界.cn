// CN 自举编译器 v2 · 语义检查·指针边界族（1610 拆分：自 语义检查运算.cn
//   机械搬移·函数体逐字保留·零逻辑变化——该文件 999 行贴死 1000 冻结线，
//   1610 须新增位/逻辑混写类型域执法代码，「先拆再加」纪律·767 拆分同款）
// 职责：指针成员访问安全区边界族——926/615 判定与 1175 声明链类型文本三辅助
//   + 1311 回绕内置整数操作数守卫三辅助 + 1471 显式解引用读边界（状态族/事件
//   表/收尾判报/写位判派）+ 组合入口 检查指针边界926与1471（语义检查.cn
//   检查成员访问表达式 单点调用）。同包跨模块经合并全局池解析。

导入 容器::向量;
导入 映射集合;
导入 语法;       // 节点_*/成员方法标记 常量（目录包名）
导入 IR;         // 结果 合成名（事件表登记面）
导入 协议常量;   // 驻留/驻留文本（中立层）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

// ==================== 926/615：指针成员访问安全区边界判定（外移） ====================
// 926（宿主 semantic_expr_access.cpp visitMemberExpr B9 同构·154-a v2 挂点自
//   推断面迁主面）：**指针成员访问安全区边界**——. 左侧（显式解引用抵销后的
//   层数 N-k）仍是指针（>=1）→ 非 不安全 函数内报（错误不安全边界 内建豁免）。
//   宿主判定=isDerefAccess(对象指针) ∧ 非赋值目标（assignmentTargetDepth_==0）
//   ∧ 非字符串语义 ∧ 非 自身.字段——本面逐条同构：①N-k>=1（k=链区间显式解引用
//   段数；`(*p).x` 抵销后非指针=宿主放行面）②写目标链（赋值左值区间 926）
//   不报（宿主 depth>0 抑制）③字符*（字符串视图·N-k==1 且基名=字符）豁免
//   （宿主 isStringSemanticType）④数组名（符号类型文本数组形态=宿主
//   isPointer(数组文本)=假）排除⑤自身 不入指针层数表天然 N=0 放行（宿主
//   thisMemberAccess 等价）。多级（N-k>=2）在同门内续报（宿主 B9+多级双报
//   同序——修前 v2 单报=诊断面分叉同轮收口）。数据源=615 层数表/显解层数
//   单点复用。节点级去重（标记成员检查926）：894-a 自增表达式双重遍历
//   （表达式语句外层区间遍历+检查自增表达式区间618 内层遍历）会重复到达同一
//   节点——宿主单遍=1 诊断（r12 实录 v2 曾 2 条）；首次门=「已报即跳过」，
//   双报形态（pp.x++）首遍 B9+多级、重复遍零报，与宿主单遍双诊断同口径。
//   诚实边界：对象=成员/下标/调用链形态（层数表仅标识符键）不在本面——与 615
//   多级拦截同口径（该形态宿主语义诊断/v2 [ir2] 双拒面，非放行分叉）。
// 实现外移（语义检查.cn 撞 1000 冻结线·「先拆再加」纪律·767 拆分同款）：
//   归属=本文件指针边界族（A1 指针算术挂点同文件）。n=成员节点（诊断文案取
//   n.文本）；对象615/显解层数615=调用方链区间扫描结果。
// 1175（安全区对齐）：类型文本尾连续 '*' 层数（0=非指针；引用 '&' 不计）。
//   消费=检查指针成员边界926 链对象面——成员字段真类型（含星）判层；
//   双边界=0..255（指针层上限，超出=畸形文本按 0 层不报，交既有类型诊断）。
函数 尾星层数1175(字符串 文本1175x) -> 整64 {
    整64 长1175x = 字符串长度(文本1175x);
    整64 星1175x = 0;
    当 (星1175x < 长1175x) {
        整64 位1175x = 整64(文本1175x[整32(长1175x - 1 - 星1175x)]) & 255;
        如果 (位1175x != 42) { 中断; }
        星1175x++;
    }
    返回 星1175x;
}

// 1175（安全区对齐·声明链类型文本）：按**声明**解析链节点类型文本（含尾星）——
//   标识符: 符号表类型文本；成员: 父链文本 → 基名（剥 '$'/'<' 实例实参）→
//   先结构体字段表（非泛型/已登记）后类声明扫描（泛型基类=语义期实例布局未
//   登记·语法期字段类型节点 附加 低 8 位=指针层）。非声明链（调用/下标/一元
//   等）返回空串=不适用本回退（交既有边界）；空串/0 层=不可判定不报告。
函数 链类型文本1175(向量<节点> 池, 整32 节点索引,
                    向量<映射<整64, 符号>>& 符号表) -> 字符串 {
    节点 链节点1175 = 池.元素(节点索引);
    如果 (链节点1175.类型 == 节点_标识符) {
        整64 类型ID = 0;
        可选<整64> 类型ID查 = 表查找类型ID(符号表, 整64(链节点1175.文本));
        如果 (类型ID查.有值) { 类型ID = 类型ID查.值; }
        // 原 <=0 判定：miss 与登记值 0 同走「不适用」空串（880 批5 显式保留）
        如果 (!类型ID查.有值 || 类型ID == 0) {
            返回 "";
        }
        返回 字符串复制(驻留文本(类型ID));
    }
    //   =不适用，非业务默认值）。
    如果 (链节点1175.类型 != 节点_成员) { 返回 ""; }
    整64 父索引 = 整64(链节点1175.子起点);
    如果 (父索引 < 0 || 父索引 >= 整64(池.大小())) { 返回 ""; }
    字符串 父文 = 链类型文本1175(池, 整32(父索引), 符号表);
    如果 (字符串长度(父文) == 0) { 返回 ""; }
    // 基名=首个 '$'（实例合成）或 '<'（模板文本）之前。
    整64 切 = 0 - 1;
    整64 扫i = 0;
    当 (扫i < 字符串长度(父文)) {
        整64 位i = 整64(父文[整32(扫i)]) & 255;
        布尔 是切点 = 位i == 36 || 位i == 60;
        如果 (切 == 0 - 1 && 是切点) { 切 = 扫i; }
        扫i++;
    }
    字符串 基文 = 父文;
    如果 (切 > 0) { 基文 = 字符串子串(父文, 0, 整32(切)); }
    整64 基ID = 驻留(基文); 可选<整64> 字段ID查 = 查字段类型ID(基ID, 整64(链节点1175.文本));
    如果 (字段ID查.有值) { 整64 字段ID = 字段ID查.值;
        返回 字符串复制(驻留文本(字段ID)); }
    可选<整64> 类索引查 = 查类节点索引(基ID);
    如果 (!类索引查.有值) {
        返回 "";
    }
    整64 类索引 = 类索引查.值;
    节点 类值 = 池.元素(整32(类索引));
    整64 扫 = 整64(类值.子起点);
    当 (扫 < 整64(类值.子终点)) {
        节点 声明 = 池.元素(整32(扫));
        布尔 命中字段 = 声明.类型 == 节点_类字段 &&
                        整64(声明.文本) == 整64(链节点1175.文本) &&
                        声明.附加 > 0 &&
                        整64(声明.附加) < 整64(池.大小());
        如果 (命中字段) {
            节点 类型节点 = 池.元素(整32(声明.附加));
            整64 星层 = 整64(类型节点.附加) & 255;   // 低 8 位=指针层
            字符串 文 = 字符串复制(驻留文本(整64(类型节点.文本))); 整64 星i = 0;
            当 (星i < 星层) {
                文 = 文 + "*";
                星i++;
            }
            返回 文;
        }
        扫++;
    }
    返回 "";
}

// 1175（安全区对齐·链对象指针层）：对象成员（甲.下 的 .下）**声明类型**的
//   指针层数（0=非指针/不可判定）。消费=检查指针成员边界926 链对象面；
//   语义阶段在 IR 实例化之前（语义检查→IR 生成），实例布局/字段类型表尚未
//   登记——查字段类型ID(节点$整32,下) 恒 miss，故回退语法期声明（链类型
//   文本1175 递归：标识符→结构体字段表→泛型基类字段声明扫描）。
函数 链成员指针层1175(向量<节点> 池, 整32 对象成员索引,
                     向量<映射<整64, 符号>>& 符号表, 字符串& 基名出) -> 整64 {
    节点 成员 = 池.元素(对象成员索引);
    如果 (成员.类型 != 节点_成员) { 返回 0; }
    字符串 对象文 = 链类型文本1175(池, 对象成员索引, 符号表);
    如果 (字符串长度(对象文) == 0) { 返回 0; }
    整64 星层 = 尾星层数1175(对象文);
    如果 (星层 >= 1 && 星层 <= 255) {
        基名出 = 剥尾星615(对象文);
    }
    返回 星层;
}

函数 检查指针成员边界926(向量<节点> 池, 整32 节点索引, 节点 n,
                   节点 对象615, 整64 显解层数615,
                   向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    整64 层数615 = 0;   // 0=非指针（显式语义值·不再用 -1 哨兵参与层数运算·#1507）
    // 1175（安全区对齐·926 链对象扩面）：对象=**成员链**（甲.下.值 的 .下）——
    //   原函数对非标识符对象直接返回：1175 前该形态由 IR 链断兜底拒绝（宿主
    //   语义诊断/v2 [ir2] 双拒）；1175 打通泛型实例链后 v2 会静默放行安全函数
    //   内的指针成员访问（g02e 探针：宿主拒/v2 运行空指针错码 3=安全裂缝）。
    //   扩面=对象成员经 推导成员类型ID 取真类型文本，尾连续 '*' 层数入判定；
    //   引用/值/数组形态 0 层不报告（与标识符面同口径；静默诊断向量吸收
    //   推断过程诊断，防与主检查面双报）。
    字符串 基名链926 = ""; 布尔 链对象926 = 假; 布尔 局部指针命中615 = 假;
    如果 (对象615.类型 == 节点_标识符) {
        // #1507：可选结果分流——无值=非指针变量（合法面·层数保持 0·原 -1
        //   哨兵不再作为数值参与下方 <2/差分判定）。
        可选<整64> 层查615 = 查语义指针层数(整64(对象615.文本));
        如果 (层查615.有值) {
            层数615 = 层查615.值;
            局部指针命中615 = 真;
        }
        // 615：静态（顶层/函数内）多级指针——指针层数表（函数级生命周期）
        //   miss/单级时回退静态表（模块级累积·收集静态声明 单点登记；
        //   修 639 后顶层 `点** g;` 放行而 g.x 若不回退=漏拦放行）
        // 926：回退**只增不减**——原无条件覆盖把局部单级指针的 1 覆盖为
        //   静态表 miss 的 -1 → B9（N-k>=1）对局部单级指针整体漏拦
        //   （r1 探针实录）。层静 > 层数 才采纳（局部 1 保持·静态多级补齐）。
        // 882 登记制（门禁四面对照注记）：本函数各阈值为语义阈值判定（层数差分/
        //   表命中/形态判定），非缺省取值类静默面；比较式统一归入命名布尔
        //   （条件外显·另一端各有显式处置：不报告=放行面·见各分支）。
        布尔 需静态回退615 = !局部指针命中615 || 层数615 < 2;
        如果 (需静态回退615) {
            可选<整64> 层静615查 = 查静态指针层数615(整64(对象615.文本));
            布尔 层静命中615 = 层静615查.有值; 整64 层静615 = 0;
            如果 (层静615查.有值) { 层静615 = 层静615查.值; }
            布尔 层静更高615 = 层静命中615 && 层静615 > 层数615;
            如果 (层静更高615) { 层数615 = 层静615; }
        }
    } 否则 如果 (对象615.类型 == 节点_成员 &&
                  整64(n.子起点) < 池.大小()) {
        向量<字符串> 静默926 = 向量<字符串>(); 可选<整64> 对象类型926查 = 推导成员类型ID(池, 整32(n.子起点), 符号表, 静默926); 整64 对象类型926 = 0;
        如果 (对象类型926查.有值) { 对象类型926 = 对象类型926查.值; }
        如果 (对象类型926 > 0) {
            字符串 对象文926 = 字符串复制(驻留文本(对象类型926)); 整64 星926 = 尾星层数1175(对象文926);
            如果 (星926 >= 1 && 星926 <= 255) {
                层数615 = 星926;
                基名链926 = 剥尾星615(对象文926);
                链对象926 = 真;
            }
        }
        // 泛型实例面回退（语义阶段实例布局未登记→推导 miss）：按基类声明字段
        //   类型节点的指针层判定（链成员指针层1175·语法期声明单一数据源）。
        如果 (!链对象926) {
            字符串 基名回926 = ""; 整64 回退层926 = 链成员指针层1175(池, 整32(n.子起点), 符号表, 基名回926);
            如果 (回退层926 >= 1 && 回退层926 <= 255) {
                层数615 = 回退层926;
                基名链926 = 基名回926;
                链对象926 = 真;
            }
        }
    }
    整64 差层615 = 层数615 - 显解层数615;   // N-k：. 左侧剩余指针层数
    布尔 报告指针访问926 = 差层615 >= 1;    // B9 条件（左侧仍是指针）
    布尔 报告多级615 = 差层615 >= 2;        // 615 多级拦截条件
    // 926 红修（云端 linux-x86_64 预验 fbe6f0e537：105 接口参数多态/106 接口
    //   去虚拟化 v2 误拦）：**方法调用形态（附加=成员方法标记 -2）单级跳过**
    //   ——「对象.方法()」在宿主 AST 走 semantic_call_member 方法分派（类/接口
    //   单级指针/值对象均成功分派），**不经 visitMemberExpr**（B9/多级不触发·
    //   105/106 宿主 rc=0 + 插桩实测 `图形.面积()`/`cp.取()` 零 visit 行）。
    //   但**多级指针对象的方法调用**（`cpp.取()`——对象仍多级）宿主分派失败
    //   回落 visitMemberExpr → 照报 B9+多级（m3 探针双侧实录）。v2 判定=
    //   方法调用形态仅多级（分派失败面）进入报告；单级跳过（成功分派面）。
    //   字段访问不受影响（附加=字段偏移）。
    布尔 方法调用形态926 = n.附加 == 成员方法标记;
    如果 (方法调用形态926 && !报告多级615) { 返回; }
    如果 (报告指针访问926 && 标记成员检查926(整64(节点索引))) {
        字符串 基名926 = 基名链926; 整64 全型926 = 0; 布尔 表型可用926 = 假;
        如果 (!链对象926) {
            可选<整64> 基名ID926查 = 查语义指针变量(整64(对象615.文本));
            如果 (基名ID926查.有值) {
                基名926 = 剥尾星615(字符串复制(驻留文本(基名ID926查.值)));
            }
            可选<整64> 全型926查 = 表查找类型ID(符号表, 整64(对象615.文本));
            // miss 保持 0（下方 >0 判定与原 -1 哨兵同假·880 批5）
            如果 (全型926查.有值) { 全型926 = 全型926查.值; }
            表型可用926 = 全型926 > 0;
            布尔 无基名926 = 字符串长度(基名926) == 0;
            如果 (无基名926 && 表型可用926) {
                基名926 = 剥尾星615(字符串复制(驻留文本(全型926)));
            }
        }
        布尔 单级左侧926 = 差层615 == 1; 布尔 字符视图926 = 单级左侧926 && 字符串比较(基名926, "字符"); 布尔 数组名926 = 假;
        如果 (表型可用926) {
            数组名926 = 是数组类型文本(字符串复制(驻留文本(全型926)));
        }
        布尔 非写目标926 = !状态在赋值左值区间926(节点索引);
        如果 (!字符视图926 && !数组名926 && 非写目标926) {
            错误不安全边界(诊断, "指针成员访问", "指针成员访问（p.字段）");
        }
        // 615：拦截条件=N-k>=2（. 左侧层数仍多级——与宿主「自动解引用仅
        //   一级」判定同构；显式解引用段 k 已从链区间核出）
        如果 (报告多级615) {
            字符串 基名615 = 基名链926;
            如果 (!链对象926) {
                可选<整64> 基名ID615查 = 查语义指针变量(整64(对象615.文本));
                如果 (基名ID615查.有值) {
                    基名615 = 剥尾星615(字符串复制(驻留文本(基名ID615查.值)));
                }
                布尔 无基名615 = 字符串长度(基名615) == 0;
                如果 (无基名615) {
                    整64 表型615 = 0; 可选<整64> 表型615查 = 表查找类型ID(符号表, 整64(对象615.文本));
                    // miss 保持 0（下方 >0 判定与原 -1 哨兵同假·880 批5）
                    如果 (表型615查.有值) { 表型615 = 表型615查.值; }
                    布尔 表型615可用 = 表型615 > 0;
                    如果 (表型615可用) {
                        基名615 = 剥尾星615(字符串复制(驻留文本(表型615)));
                    }
                }
            }
            字符串 星串615 = ""; 整64 星i615 = 0;
            // 615：诊断类型文本=«. 左侧类型»（N-k 星——宿主 objectType 同源；
            //   直访 k=0 时=N 星逐字同构 p615c「点**」锚）
            当 (星i615 < 差层615) {
                星串615 = 星串615 + "*";
                星i615++;
            }
            表诊断(诊断, "多级指针 '" + 基名615 + 星串615 +
                        "' 不自动解引用：请显式 * 解引用一级后再访问成员 '" +
                        字符串复制(驻留文本(整64(n.文本))) + "'");
        }
    }
}

// ==================== 1311 P1-1：回绕内置整数操作数守卫 ====================
// 宿主 checkWrapBuiltinCall 同文案：回绕加/减/乘 两侧 checkExpr 后要求整数
//   （isInteger 秩>0）；字符串/布尔/浮点/指针/容器等非整数实参拒绝。
//   v2 修前只查实参数=2，字符串实参放行后运行期 C0000005、布尔按 0/1、浮点
//   按位模式回绕=与宿主拒绝面分叉。0=推导 miss 不在此误报（由
//   回绕调用返回类型实现474 登记中止——P2-1 禁静默取对侧）。
// 指针实参文本（""=非指针/非标识符）——宿主 checkExpr 指针变量返回带星
//   文本（整32*），isInteger 拒；v2 符号表类型=基类型（秩>0）会误放行，
//   故按 基名+层数星 构造文本供守卫双侧一致拒绝（诊断文案同构）。
函数 回绕指针类型文本474(向量<节点> 池, 整32 节点索引, 整64 实参序,
                    向量<映射<整64, 符号>>& 符号表) -> 字符串 {
    整64 末474p = 0 - 1; 可选<整64> 末474p查 = 查调用实参末位(整64(节点索引), 实参序);
    // miss（原 -1 哨兵）同走「非指针」空串——原判定逐字保留
    如果 (末474p查.有值) { 末474p = 末474p查.值; }
    布尔 末有效474p = 末474p >= 0 && 末474p < 整64(池.大小());
    如果 (末有效474p) {
        节点 根474p = 池.元素(整32(末474p));
        如果 (根474p.类型 == 节点_标识符) {
            可选<整64> 指针查474p = 查语义指针变量(整64(根474p.文本));
            如果 (指针查474p.有值) {
                整64 基ID474p = 0; 字符串 针文474p = ""; 可选<整64> 基ID474p查 = 表查找类型ID(符号表, 整64(根474p.文本));
                // miss 保持 0（下方 >0 判定与原 -1 哨兵同假·880 批5）
                如果 (基ID474p查.有值) { 基ID474p = 基ID474p查.值; }
                布尔 基有效474p = 基ID474p > 0;
                如果 (基有效474p) { 针文474p = 字符串复制(驻留文本(基ID474p)); }
                // #1507：层数表可选分流——指针变量表已命中而层数表无值=两表
                //   登记不一致（编译器内部缺陷·配对不变量见 查语义指针层数）；
                //   显式保守取最低层数 1 维持诊断文本，并登记内部未登记显形，
                //   不再静默兜底（原 !层有效 → 1 的静默默认已废除）。
                整64 层474p = 0; 可选<整64> 层474p查 = 查语义指针层数(整64(根474p.文本));
                如果 (层474p查.有值) { 层474p = 层474p查.值; }
                布尔 层有效474p = 层474p >= 1;
                如果 (!层有效474p) {
                    登记内部未登记("指针层数表与指针变量表登记不一致（回绕指针类型文本）",
                                   字符串复制(驻留文本(整64(根474p.文本))), 0);
                    层474p = 1;
                }
                整64 星i474p = 0;
                当 (星i474p < 层474p) {
                    针文474p = 针文474p + "*";
                    星i474p++;
                }
                返回 针文474p;
            }
        }
    }
    返回 "";
}

// 比较/逻辑二元表达式实参=布尔（宿主 checkExpr 同口径；语义 推导二元类型ID
//   为推断声明域、比较面不返回布尔，故守卫侧单点识别）。
函数 回绕末端比较布尔474(向量<节点> 池, 整32 节点索引, 整64 实参序) -> 布尔 {
    整64 末474c = 0 - 1; 可选<整64> 末474c查 = 查调用实参末位(整64(节点索引), 实参序);
    // miss（原 -1 哨兵）同走「非布尔二元」——原判定逐字保留
    如果 (末474c查.有值) { 末474c = 末474c查.值; }
    布尔 末有效474c = 末474c >= 0 && 末474c < 整64(池.大小());
    布尔 是布474c = 假;
    如果 (末有效474c) {
        节点 根474c = 池.元素(整32(末474c));
        如果 (根474c.类型 == 节点_二元运算) {
            字符串 op474c = 字符串复制(驻留文本(整64(根474c.文本)));
            是布474c = 字符串比较(op474c, "==") || 字符串比较(op474c, "!=") ||
                字符串比较(op474c, "<") || 字符串比较(op474c, "<=") ||
                字符串比较(op474c, ">") || 字符串比较(op474c, ">=") ||
                字符串比较(op474c, "&&") || 字符串比较(op474c, "||");
        }
    }
    返回 是布474c;
}

函数 检查回绕整数实参474(向量<节点> 池, 整32 节点索引,
                    向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 布尔 {
    整64 左类474g = 0; 可选<整64> 左类474g查 = 回绕实参侧类型474(池, 节点索引, 符号表, 0); 如果 (左类474g查.有值) { 左类474g = 左类474g查.值; }
    整64 右类474g = 0; 可选<整64> 右类474g查 = 回绕实参侧类型474(池, 节点索引, 符号表, 1); 如果 (右类474g查.有值) { 右类474g = 右类474g查.值; }
    字符串 左针474g = 回绕指针类型文本474(池, 节点索引, 0, 符号表); 字符串 右针474g = 回绕指针类型文本474(池, 节点索引, 1, 符号表);
    布尔 左布474g = 回绕末端比较布尔474(池, 节点索引, 0); 布尔 右布474g = 回绕末端比较布尔474(池, 节点索引, 1);
    布尔 左是针474g = 字符串长度(左针474g) > 0; 布尔 右是针474g = 字符串长度(右针474g) > 0;
    布尔 左有型474g = 左类474g > 0; 布尔 右有型474g = 右类474g > 0;
    布尔 左知474g = 左有型474g || 左布474g || 左是针474g; 布尔 右知474g = 右有型474g || 右布474g || 右是针474g;
    如果 (左知474g && 右知474g) {
        整64 左秩474g = 整数族类型秩474(左类474g);
        整64 右秩474g = 整数族类型秩474(右类474g);
        如果 (左是针474g || 左布474g) { 左秩474g = 0; }
        如果 (右是针474g || 右布474g) { 右秩474g = 0; }
        布尔 非整数474g = 左秩474g == 0 || 右秩474g == 0;
        如果 (非整数474g) {
            字符串 左文474g = "未知";
            字符串 右文474g = "未知";
            如果 (左有型474g) { 左文474g = 字符串复制(驻留文本(左类474g)); }
            如果 (右有型474g) { 右文474g = 字符串复制(驻留文本(右类474g)); }
            如果 (左是针474g) { 左文474g = 字符串复制(左针474g); }
            如果 (右是针474g) { 右文474g = 字符串复制(右针474g); }
            如果 (左布474g) { 左文474g = "布尔"; }
            如果 (右布474g) { 右文474g = "布尔"; }
            表诊断(诊断, "[错误] 回绕内置要求整数操作数，实际为 '" +
                         左文474g + "' 与 '" + 右文474g + "'");
            返回 假;
        }
    }
    返回 真;
}

// ==================== 1471（安全区对齐·#1471 组合形态执法缺口） ====================
// 缺陷（采样轮 #1467 命中·探针矩阵 a~p 双侧实录）：871-a 解析归一把 `(*p).x`
//   的外层解引用节点**哨兵化**（成员对象改指根标识符·链区间留哨兵计显解层
//   数）——76-a 解引用读挂点（只认存活 节点_解引用·单级形态恰是被哨兵化的
//   那个）与 926 指针成员访问判定（差层=N-k=1-1=0）双 miss → 安全区
//   `(*pb).名()` v2 放行 rc=0·宿主拒「[安全区边界] 裸指针解引用读应在 不安全
//   函数 内（指针解引用（*p））」（零分叉红线）。修复=组合挂点：成员节点链
//   区间显解层数>=1 且对象标识符层数>=1 且读位 → 按宿主 checkDerefUnary B6
//   同文报。写位分派对齐宿主（位判派见下）。
// 状态族（检查赋值语句 同步置位/恢复·与 926 区间同生命周期同惯例）：
//   赋值左值末索引（n.子起点-1·恒不随复合扩区间变；-1=无复合左值）+
//   自增合成标记（右值末二元 子终点==2·894-a 脱糖）。
静态 整32 状态赋值左值末1471 = 0 - 1;
静态 布尔 状态赋值自增合成1471 = 假;
// 止快照（=926 区间止·检查赋值语句 置位时同步写入）：判派函数取值用——
//   跨模块无参访问器（状态读赋值止926）自举解析不达（1471 构建实录未声明），
//   快照单点写（赋值.cn 置/恢复两处）避免跨模块读。
静态 整32 状态赋值止快照1471 = 0 - 1;

函数 状态读赋值左值末1471() -> 整32 {
    返回 状态赋值左值末1471;
}

不安全 函数 状态置赋值左值末1471(整32 值1471s) -> 空类型 {
    状态赋值左值末1471 = 值1471s;
}

函数 状态读赋值自增合成1471() -> 布尔 {
    返回 状态赋值自增合成1471;
}

不安全 函数 状态置赋值自增合成1471(布尔 值1471s) -> 空类型 {
    状态赋值自增合成1471 = 值1471s;
}

函数 状态读赋值止快照1471() -> 整32 {
    返回 状态赋值止快照1471;
}

不安全 函数 状态置赋值止快照1471(整32 值1471s) -> 空类型 {
    状态赋值止快照1471 = 值1471s;
}

// 1471 **事件表**（安全区解引用段·节点级去重·函数级收尾单点报文）：显式解
//   引用节点会被**多通道重复到达**——静默副本通道先行（声明初始化类型校验的
//   静默遍历·其 push 的诊断被丢弃）+ 894-a 自增双重遍历（表达式语句外层区间
//   遍历+检查自增表达式区间618 内层遍历）——到达即报文会双报/漏报（t1/l/m
//   探针实证）。故 76-a（存活解引用节点面）与 1471（哨兵化显解段·成员挂点）
//   两挂点到达时**只登记**（键=节点索引·首登真·行号/写位固化入表），检查
//   函数/检查方法 **收尾**（判定恒空报错 同址·全函数视角）判报解引用事件1471
//   单点报文（诊断行回写=行号固化对齐宿主行锚）——报文通道恒为收尾主诊断
//   向量=副本通道天然免疫；同节点多到达被键去重天然免疫。条数语义=每个显式
//   解引用段 1 条（宿主 checkDerefUnary B6/B7 逐段单报对齐）。
静态 向量<整64> 事件解引用节点1471;
静态 向量<整64> 事件解引用行1471;
静态 向量<整64> 事件解引用位1471;   // 0=读（宿主 B6）1=写直写（宿主 B7）

// 登记（返回真=首登事件入表；假=重复到达跳过）——行号固化（收尾报文行锚）
不安全 函数 登记解引用事件1471(整64 节点索引, 整64 行1471e, 整64 位1471e) -> 布尔 {
    整64 i1471e = 0;
    当 (i1471e < 事件解引用节点1471.大小()) {
        如果 (事件解引用节点1471.元素(整32(i1471e)) == 节点索引) { 返回 假; }
        i1471e++;
    }
    结果<空类型, 整32> 加节1471 = 事件解引用节点1471.追加(节点索引);
    如果 (!加节1471.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加行1471 = 事件解引用行1471.追加(行1471e);
    如果 (!加行1471.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加位1471 = 事件解引用位1471.追加(位1471e);
    如果 (!加位1471.正常) { 运行时错误(4); }
    返回 真;
}

// 收尾单点报文（检查函数/检查方法 函数体检查收尾调用·判定恒空报错 同址同
//   视角——当前函数不安全/重放豁免由 错误不安全边界 收尾时判定=同面豁免）。
//   报序=**行号升序稳定排序**（同行保持登记序·稳定冒泡·事件量=函数内显式
//   解引用段数恒小）——体块检查即时报的诊断（指针算术/静态写等）在向量前段
//   依源序在先·事件报按行插序对齐宿主源序（265_v2 探针矩阵：读 13/写 14 须
//   排在算术 15 之前=宿主输出序）。
不安全 函数 判报解引用事件1471(向量<字符串>& 诊断) -> 空类型 {
    整64 数1471p = 事件解引用节点1471.大小();
    整64 a1471p = 0;
    当 (a1471p < 数1471p) {
        整64 b1471p = 0;
        当 (b1471p < 数1471p - 1 - a1471p) {
            布尔 需换1471p = 事件解引用行1471.元素(整32(b1471p)) >
                           事件解引用行1471.元素(整32(b1471p + 1));
            如果 (需换1471p) {
                整64 节t = 事件解引用节点1471.元素(整32(b1471p));
                整64 行t = 事件解引用行1471.元素(整32(b1471p));
                整64 位t = 事件解引用位1471.元素(整32(b1471p));
                结果<空类型, 整32> 设节 = 事件解引用节点1471.设置(
                    整32(b1471p), 事件解引用节点1471.元素(整32(b1471p + 1)));
                结果<空类型, 整32> 设行 = 事件解引用行1471.设置(
                    整32(b1471p), 事件解引用行1471.元素(整32(b1471p + 1)));
                结果<空类型, 整32> 设位 = 事件解引用位1471.设置(
                    整32(b1471p), 事件解引用位1471.元素(整32(b1471p + 1)));
                结果<空类型, 整32> 设节2 = 事件解引用节点1471.设置(
                    整32(b1471p + 1), 节t);
                结果<空类型, 整32> 设行2 = 事件解引用行1471.设置(
                    整32(b1471p + 1), 行t);
                结果<空类型, 整32> 设位2 = 事件解引用位1471.设置(
                    整32(b1471p + 1), 位t);
                如果 (!设节.正常 || !设行.正常 || !设位.正常 ||
                     !设节2.正常 || !设行2.正常 || !设位2.正常) { 运行时错误(4); }
            }
            b1471p++;
        }
        a1471p++;
    }
    整64 i1471p = 0;
    当 (i1471p < 事件解引用节点1471.大小()) {
        设当前诊断行(整32(事件解引用行1471.元素(i1471p)));
        如果 (事件解引用位1471.元素(i1471p) == 1) {
            错误不安全边界(诊断, "裸指针解引用写",
                           "指针解引用写（*p = x）");
        } 否则 {
            错误不安全边界(诊断, "裸指针解引用读",
                           "指针解引用（*p）");
        }
        i1471p++;
    }
    清空解引用事件1471();
}

不安全 函数 清空解引用事件1471() -> 空类型 {
    事件解引用节点1471.清空();
    事件解引用行1471.清空();
    事件解引用位1471.清空();
}

// 1471 写位判派（宿主 assignmentTargetDepth_ 抑制语义的 v2 落点·三态）：
//   0=读位（报「裸指针解引用读」）；1=赋值左值末解引用直写（76-a 面报
//   「裸指针解引用写」=宿主 B7 checkUnaryCallAssignTarget）；2=写目标链中/
//   复合赋值副本链/自增合成副本链（宿主 depth>0 抑制面·静默——宿主 AST
//   单份 target 无副本=等价抑制口径）。单点供 76-a（存活解引用节点）与
//   1471（哨兵化显解段·成员挂点）共用。
// 882 门禁注记：三态=写位差分判定（区间命中/链末身份/合成标记），无缺省
//   取值继续编译的静默面；2 态=显式抑制语义（宿主同面静默·非漏判）。
函数 解引用写位判派1471(整32 节点索引) -> 整32 {
    如果 (!状态在赋值左值区间926(节点索引)) {
        // 区间外：自增合成副本链（宿主 AST 无副本面·静默）；其余=读位
        布尔 自增中1471 = 状态读赋值自增合成1471();
        整32 止值1471 = 状态读赋值止快照1471();
        布尔 止有效1471 = 止值1471 >= 0;
        布尔 越止1471 = 节点索引 > 止值1471;
        如果 (自增中1471 && 止有效1471 && 越止1471) { 返回 2; }
        返回 0;
    }
    布尔 自增首份1471 = 状态读赋值自增合成1471();
    如果 (自增首份1471) { 返回 0; }   // 自增第一份链=宿主 IncDec 操作数 depth=0 读面照报
    布尔 链末直写1471 = 节点索引 == 状态读赋值左值末1471();
    如果 (链末直写1471) { 返回 1; }   // 左值末解引用直写=宿主 B7 面
    返回 2;   // 左值链中/复合赋值扩区间副本=宿主 assignmentTargetDepth_ 抑制
}

// 1471 组合读挂点：显式解引用段（哨兵化/存活合计 k>=1）安全区执法——
//   76-a 对存活解引用节点报·本函数对**被哨兵化的那段显式解引用**报（单级
//   组合形态 `(*p).x` 的解引用恰被 871-a 哨兵化=唯一报点；多级 `(**q).x`
//   内层存活走 76-a·本函数补外层=条数与宿主 B6 逐层报一致）。判定条件与
//   宿主 checkDerefUnary 逐条对齐：操作数是指针（层数表+静态回退=926 同源）·
//   读位·非字符* 字符串视图（isStringSemanticType 豁免）·节点级去重。
//   对象=成员/调用/下标链折叠形态=层数表界外诚实边界（926/615 同口径·该
//   形态两侧各有既有拒面非放行分叉）。
函数 检查显式解引用读边界1471(整32 节点索引, 节点 对象615, 整64 显解层数615,
                   向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    布尔 有显解1471 = 显解层数615 >= 1;
    如果 (!有显解1471) { 返回; }   // 无显式解引用段（纯 p.x 自动面=926 管辖）
    布尔 对象标识符1471 = 对象615.类型 == 节点_标识符;
    如果 (!对象标识符1471) { 返回; }   // 复合基=层数表界外（926/615 同口径诚实边界）
    可选<整64> 层查1471 = 查语义指针层数(整64(对象615.文本));
    // 未登记=0 层（非指针；原 -1 同落 <2/>=1 两判定分支，逐点等价）
    整64 层1471 = 0;
    // 926 同款静态回退（只增不减）：顶层静态/函数内静态指针在静态层数表
    布尔 需静态回退1471 = 真;
    如果 (层查1471.有值) {
        层1471 = 层查1471.值;
        需静态回退1471 = 层1471 < 2;
    }
    如果 (需静态回退1471) {
        可选<整64> 层静查1471 = 查静态指针层数615(整64(对象615.文本));
        如果 (层静查1471.有值) {
            整64 层静1471 = 层静查1471.值;
            如果 (层静1471 > 层1471) { 层1471 = 层静1471; }
        }
    }
    布尔 操作数指针1471 = 层1471 >= 1;
    如果 (!操作数指针1471) { 返回; }   // 操作数非指针=既有类型检查面管辖
    整32 位1471 = 解引用写位判派1471(节点索引);
    布尔 读位1471 = 位1471 == 0;
    如果 (!读位1471) { 返回; }   // 写直写=B7 由 76-a 面单报；链中/副本=宿主抑制
    布尔 字符视图1471 = 假;
    如果 (层1471 == 1) {
        // 字符串语义豁免=符号表声明类型（宿主 isStringSemanticType 同源·209
        //   同款——指针表所指=数组元素类型≠声明基名·见 76-a 面同注）
        // 882 门禁清偿：表查找契约命名布尔（>0=已登记·<=0 未登记=不豁免交
        //   既有报面·另一端显式）——926 指针表命中同款
        可选<整64> 声明基查1471 = 表查找类型ID(符号表, 整64(对象615.文本));
        布尔 声明基有效1471 = 声明基查1471.有值;
        如果 (声明基查1471.有值) {
            整64 声明基1471 = 声明基查1471.值;
            字符视图1471 = 字符串比较(
                剥尾星615(字符串复制(驻留文本(声明基1471))), "字符");
        }
    }
    如果 (字符视图1471) { 返回; }   // 宿主 isStringSemanticType 字符串视图豁免
    // 事件表登记（节点级去重·收尾单点报文——多通道重复到达免疫·见事件表注）
    登记解引用事件1471(整64(节点索引), 整64(取当前诊断行()), 0);
}

// 926+1471 组合入口（语义检查.cn 检查成员访问表达式 单点调用·语义检查.cn
//   已超 900 行警戒线——改名接线 1 行·判定体全留本文件指针边界族）。
函数 检查指针边界926与1471(向量<节点> 池, 整32 节点索引, 节点 n,
                   节点 对象615, 整64 显解层数615,
                   向量<映射<整64, 符号>>& 符号表, 向量<字符串>& 诊断) -> 空类型 {
    检查指针成员边界926(池, 节点索引, n, 对象615, 显解层数615, 符号表, 诊断);
    检查显式解引用读边界1471(节点索引, 对象615, 显解层数615, 符号表, 诊断);
}
