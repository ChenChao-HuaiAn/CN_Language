// CN 自举编译器 v2 · 语义检查初始化（010 def-init 同构，2026-09-23）
// 职责：局部值类型变量初始化状态跟踪（def-init·Rust E0381 对照·零运行时成本）
//   ——与宿主 semantic_definit.cpp 同构：裸声明登记未初始化键、写点置位、
//   读点拒绝；控制流传播（如果=两支交集归并·循环体不外溢·return 终止支豁免）。
// 范围口径（611-a 存量盘点实证）：登记面=局部纯值类型（标量/数组/结构体）；
//   拥有型（类/容器/字符串/结果/可选=入口零初始化/默认构造防御）、指针/引用、
//   静态（零初始化）、函数参数 豁免。数组=元素级键（常量下标精确/非常量下标
//   写=整体置位·读=前缀保守拒）；结构体=变量级键（写字段=整体置位·诚实边界：
//   字段级精确跟踪随结构体字段表预登记设施轮对齐——存量零形态实量）。
// 键编码（整64 乘除模分层·零位运算依赖）：键=((层*P)+名ID)*P+后缀，P=1000000007。
//   可逆拆解：层=键/P/P、名ID=(键/P)%P、后缀=键%P（名ID/后缀 均 <P——驻留池与
//   常量下标域远小于此界）。后缀：标量/结构体=0；a[i] 常量=1+下标；非常量下标
//   =999999999（整体置位/保守读前缀的哨兵）。键=纯整数运算（性能第一）。
导入 容器::向量;
导入 映射集合;
导入 语法;       // 查结构体类型（目录包名）
导入 IR;         // 数组长度文本（目录包名）

公开:   // 全文件公开（状态族供 检查族 消费）

静态 向量<整64> 未初始化键们;

// 赋值目标语境（写语句区间遍历会重入左值下标/标识符检查——读判定抑制）
静态 布尔 状态赋值目标中 = 假;

函数 状态读赋值目标中() -> 布尔 {
    返回 状态赋值目标中;
}

// 置位 setter（静态写=不安全 函数内——安全区边界 157-a；调用侧不受限·
//   登记恒空失格 同款先例）
不安全 函数 状态置赋值目标中(布尔 值) -> 空类型 {
    状态赋值目标中 = 值;
}

// 清空状态表（函数级生命周期——检查函数入口调用；参数=已初始化不登记）
函数 状态清空表() -> 空类型 {
    未初始化键们.清空();
}

// 追加键（规则1：向量操作返回值必须检查——错误码 4 内部错误）
函数 状态加键(整64 键) -> 空类型 {
    结果<空类型, 整32> 加 = 未初始化键们.追加(键);
    如果 (!加.正常) { 运行时错误(4); }
}

// 删位（规则1 同款）
函数 状态删位(整32 索引) -> 空类型 {
    结果<空类型, 整32> 删 = 未初始化键们.删除(索引);
    如果 (!删.正常) { 运行时错误(4); }
}

// ---- 键构造 ----

// 值类型判定（类型文本）：标量 14 型 / 数组（含 [长度]）/ 结构体（变量级跟踪）。
//   类/容器/字符串/结果/可选（拥有型）与指针/引用=假（豁免面）。
函数 状态是值类型(整64 类型ID) -> 布尔 {
    字符串 文本 = 字符串复制(驻留文本(类型ID));
    // 指针（尾 *）豁免
    整64 长度 = 字符串长度(文本);
    如果 (长度 > 0) {
        字符串 尾 = 字符串子串(文本, 长度 - 1, 1);
        如果 (字符串比较(尾, "*")) { 返回 假; }
        如果 (字符串比较(尾, "&")) { 返回 假; }
    }
    // 拥有型豁免：字符串/结果/可选/容器（合成名）
    如果 (字符串比较(文本, "字符串")) { 返回 假; }
    如果 (是结果类型(文本)) { 返回 假; }  // 基名白名单含 结果/可选
    如果 (是容器类(文本)) { 返回 假; }
    // 数组（长度文本 提取成功=数组）
    如果 (数组长度文本(文本) > 0) { 返回 真; }
    // 标量 14 型
    如果 (字符串比较(文本, "整8")) { 返回 真; }
    如果 (字符串比较(文本, "整16")) { 返回 真; }
    如果 (字符串比较(文本, "整32")) { 返回 真; }
    如果 (字符串比较(文本, "整64")) { 返回 真; }
    如果 (字符串比较(文本, "整128")) { 返回 真; }
    如果 (字符串比较(文本, "正8")) { 返回 真; }
    如果 (字符串比较(文本, "正16")) { 返回 真; }
    如果 (字符串比较(文本, "正32")) { 返回 真; }
    如果 (字符串比较(文本, "正64")) { 返回 真; }
    如果 (字符串比较(文本, "布尔")) { 返回 真; }
    如果 (字符串比较(文本, "字符")) { 返回 真; }
    // 结构体豁免：局部结构体裸声明=编译器入口零初始化注入（257 形二实锤·
    //   两侧既有防御）——字段读有定义行为，不入登记面（与拥有型同通道）
    如果 (查结构体类型(类型ID) != 0) { 返回 假; }
    返回 假;
}

// 数组元素类型（经 长度文本 剥 [N] 后缀）——宿主 types::arrayElemOf 同构
函数 状态数组元素类型(字符串 类型文本) -> 整64 {
    // 文本形态 "基[N]"：找末尾 '[' 截断
    整64 长度 = 字符串长度(类型文本);
    整64 i = 长度;
    当 (i > 0) {
        i--;
        字符串 位 = 字符串子串(类型文本, i, 1);
        如果 (字符串比较(位, "[")) {
            字符串 基 = 字符串子串(类型文本, 0, i);
            返回 驻留(基);
        }
    }
    返回 0;
}

// 声明作用域层（从内向外查名——宿主 defInitLookupDepth 同构；-1=未声明）
函数 状态声明层(向量<映射<整64, 符号>> 符号表, 整64 名ID) -> 整64 {
    整64 i = 符号表.大小();
    当 (i > 0) {
        i--;
        结果<符号, 整32> 查 = 符号表.元素(整32(i)).获取(名ID);
        如果 (查.正常) { 返回 i; }
    }
    返回 0 - 1;
}

// 键构造：((层*P)+名ID)*P+后缀（P=1000000007·纯整数运算）
函数 状态构造键(整64 层, 整64 名ID, 整64 后缀) -> 整64 {
    返回 ((层 * 1000000007) + 名ID) * 1000000007 + 后缀;
}

// 同 (层,名) 判定：后缀域除外（删前缀/非常量读共用）
函数 状态同名键(整64 层, 整64 名ID) -> 整64 {
    返回 ((层 * 1000000007) + 名ID) * 1000000007;
}

// 表查键（线性）
函数 状态查键(整64 键) -> 布尔 {
    整64 i = 0;
    当 (i < 未初始化键们.大小()) {
        如果 (未初始化键们.元素(整32(i)) == 键) { 返回 真; }
        i++;
    }
    返回 假;
}

// 表删键（保留序压缩）
函数 状态删键(整64 键) -> 空类型 {
    整64 i = 0;
    当 (i < 未初始化键们.大小()) {
        如果 (未初始化键们.元素(整32(i)) == 键) {
            状态删位(整32(i));
            返回;
        }
        i++;
    }
}

// 表删前缀（深度+名 全部后缀键——整体写置位；宿主前缀删除同构）
函数 状态删前缀(整64 层, 整64 名ID) -> 空类型 {
    整64 基 = 状态同名键(层, 名ID);
    整64 i = 0;
    当 (i < 未初始化键们.大小()) {
        整64 键 = 未初始化键们.元素(整32(i));
        // 同 (层,名)：键-基 的差=后缀 且 后缀<P（同层同名）
        如果 (键 >= 基 && 键 - 基 < 1000000007) {
            状态删位(整32(i));
        } 否则 {
            i++;
        }
    }
}

// 裸声明登记（检查变量声明语句 挂点）：值类型按形态展开叶子键
函数 状态登记声明(向量<映射<整64, 符号>> 符号表, 整64 名ID, 整64 类型ID) -> 空类型 {
    如果 (!状态是值类型(类型ID)) { 返回; }
    整64 层 = 状态声明层(符号表, 名ID);
    如果 (层 < 0) { 返回; }
    字符串 类型文本 = 字符串复制(驻留文本(类型ID));
    整64 长度n = 数组长度文本(类型文本);
    如果 (长度n > 0) {
        // 数组：元素级键（a[0..N-1]；后缀=1+下标）
        整64 元素类型 = 状态数组元素类型(类型文本);
        字符串 元素文本 = 字符串复制(驻留文本(元素类型));
        整64 元素字节 = 字符串长度(元素文本);
        整64 i = 0;
        当 (i < 长度n) {
            整64 键 = 状态构造键(层, 名ID, 1 + i);
            如果 (!状态查键(键)) { 状态加键(键); }
            i++;
            如果 (元素字节 == 0) { i = 长度n; }
        }
        返回;
    }
    // 标量/结构体：单键（后缀 0）
    整64 键0 = 状态构造键(层, 名ID, 0);
    如果 (!状态查键(键0)) { 状态加键(键0); }
}

// 读判定（标量/结构体变量级）
函数 状态查读变量(向量<映射<整64, 符号>> 符号表, 整64 名ID, 向量<字符串> 诊断) -> 空类型 {
    整64 层 = 状态声明层(符号表, 名ID);
    如果 (层 < 0) { 返回; }
    如果 (状态查键(状态构造键(层, 名ID, 0))) {
        表诊断(诊断, "[错误] 变量 '" + 驻留文本(名ID) +
                      "' 未初始化，不能读取（声明后须先赋值——Rust E0381 对照编译期拒绝）");
    }
}

// 读判定（数组元素）：常量下标=精确键；非常量下标=任一元素键（保守拒）
函数 状态查读下标(向量<映射<整64, 符号>> 符号表, 整64 名ID, 整64 常量下标,
                  向量<字符串> 诊断) -> 空类型 {
    整64 层 = 状态声明层(符号表, 名ID);
    如果 (层 < 0) { 返回; }
    如果 (常量下标 >= 0) {
        如果 (状态查键(状态构造键(层, 名ID, 1 + 常量下标))) {
            表诊断(诊断, "[错误] 变量 '" + 驻留文本(名ID) +
                          "[下标]' 未初始化，不能读取（声明后须先赋值）");
        }
        返回;
    }
    // 非常量下标：任一元素键在表=拒（保守）
    整64 基 = 状态同名键(层, 名ID);
    整64 i = 0;
    当 (i < 未初始化键们.大小()) {
        整64 键 = 未初始化键们.元素(整32(i));
        整64 后缀 = 键 - 基;
        如果 (键 >= 基 && 后缀 < 1000000007 && 后缀 >= 1 && 后缀 != 999999999) {
            表诊断(诊断, "[错误] 变量 '" + 驻留文本(名ID) +
                          "[…]' 可能未初始化，不能读取（非常量下标按保守判定）");
            返回;
        }
        i++;
    }
}

// 写置位（标识符整体/结构体字段写=整体置位；非常量下标写=整体置位）
函数 状态写置位(向量<映射<整64, 符号>> 符号表, 整64 名ID) -> 空类型 {
    整64 层 = 状态声明层(符号表, 名ID);
    如果 (层 < 0) { 返回; }
    状态删前缀(层, 名ID);
}

// 写置位（常量下标精确）
函数 状态写置位下标(向量<映射<整64, 符号>> 符号表, 整64 名ID, 整64 常量下标) -> 空类型 {
    整64 层 = 状态声明层(符号表, 名ID);
    如果 (层 < 0) { 返回; }
    如果 (常量下标 >= 0) {
        状态删键(状态构造键(层, 名ID, 1 + 常量下标));
        返回;
    }
    状态删前缀(层, 名ID);
}

// 链式左值基底解析（宿主 defInitPlaceOf 同构）：沿成员/下标链向下找基底
//   标识符；首下标=链中首个下标的常量值（-1=非常量/无下标；见下标=1 表示
//   链中出现过下标）。返回 1=成功；0=不可解析（调用返回/解引用基底）。
函数 状态链基底(向量<节点> 池, 整32 索引, 整64& 名ID, 整64& 首下标, 整32& 见下标) -> 整32 {
    整32 当前 = 索引;
    见下标 = 0;
    首下标 = 0 - 1;
    名ID = 0;
    整64 守卫 = 0;
    当 (守卫 < 64) {
        守卫++;
        节点 n = 池.元素(当前);
        如果 (n.类型 == 节点_标识符) {
            名ID = 整64(n.文本);
            返回 1;
        }
        如果 (n.类型 == 节点_成员) {
            如果 (n.子起点 <= 0) { 返回 0; }
            当前 = 整32(n.子起点);
        } 否则 如果 (n.类型 == 节点_下标) {
            如果 (n.子起点 <= 0) { 返回 0; }
            如果 (见下标 == 0) {
                见下标 = 1;
                如果 (n.子终点 > n.子起点 + 1) {
                    节点 下标n = 池.元素(整32(n.子起点 + 1));
                    如果 (下标n.类型 == 节点_整数字面量) { 首下标 = 下标n.附加; }
                }
            }
            当前 = 整32(n.子起点);
        } 否则 {
            返回 0;
        }
    }
    返回 0;
}

// 数组名作实参=地址逃逸（出参惯用法）——保守整体置位（宿主同口径）
函数 状态实参置位(向量<映射<整64, 符号>> 符号表, 整64 名ID) -> 空类型 {
    状态写置位(符号表, 名ID);
}

// 标识符置位包装（取地址语境=初始化通道——整体置位；未声明静默）
函数 状态置位标识符(向量<映射<整64, 符号>> 符号表, 整64 名ID) -> 空类型 {
    状态写置位(符号表, 名ID);
}

// 出块清理：层 >= 出块后符号表大小 的键全删（键按层单调；宿主同构）
函数 状态出块清理(整64 出块后大小) -> 空类型 {
    整64 界 = 出块后大小 * 1000000007 * 1000000007;
    整64 i = 0;
    当 (i < 未初始化键们.大小()) {
        如果 (未初始化键们.元素(整32(i)) >= 界) {
            状态删位(整32(i));
        } 否则 {
            i++;
        }
    }
}

// ---- 控制流传播 ----

// 克隆当前表（堆新向量——分支基线/真支快照）
函数 状态克隆() -> 向量<整64> {
    向量<整64> 副本 = 向量<整64>();
    整64 i = 0;
    当 (i < 未初始化键们.大小()) {
        结果<空类型, 整32> 加c = 副本.追加(未初始化键们.元素(整32(i)));
        如果 (!加c.正常) { 运行时错误(4); }
        i++;
    }
    返回 副本;
}

// 恢复（基线拷回静态表）
函数 状态恢复(向量<整64> 基线) -> 空类型 {
    未初始化键们.清空();
    整64 i = 0;
    当 (i < 基线.大小()) {
        状态加键(基线.元素(整32(i)));
        i++;
    }
}

// 并集归并（def-init=must analysis·宿主同构）：静态表 ∪ 支后快照——
//   已初始化须所有路径都初始化，未初始化集汇合=并集
函数 状态并集归并(向量<整64> 支后) -> 空类型 {
    整64 i = 0;
    当 (i < 支后.大小()) {
        整64 键 = 支后.元素(整32(i));
        如果 (!状态查键(键)) { 状态加键(键); }
        i++;
    }
}

// 语句必然以 返回 结束判定（宿主 stmtGuaranteesReturn 同构·终止支豁免用）：
//   返回语句=真；块=末语句必然返回；如果=两支存在且都必然返回。
函数 状态必然返回(向量<节点> 池, 整32 节点索引) -> 布尔 {
    节点 n = 池.元素(节点索引);
    如果 (n.类型 == 节点_返回语句) { 返回 真; }
    如果 (n.类型 == 节点_块) {
        如果 (n.子终点 > n.子起点) {
            返回 状态必然返回(池, 整32(n.子终点 - 1));
        }
        返回 假;
    }
    如果 (n.类型 == 节点_如果语句) {
        整64 否则索引t = n.子终点;
        如果 (否则索引t == 0 || n.附加 <= 0) { 返回 假; }
        布尔 真支t = 状态必然返回(池, 整32(n.附加));
        布尔 否则支t = 状态必然返回(池, 整32(否则索引t));
        返回 真支t && 否则支t;
    }
    返回 假;
}

// 循环体传播：基线克隆→体检查→恢复（体可能 0 次+回边保守）
函数 状态循环体基线() -> 向量<整64> {
    返回 状态克隆();
}
函数 状态循环体恢复(向量<整64> 基线) -> 空类型 {
    状态恢复(基线);
}
