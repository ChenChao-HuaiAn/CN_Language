// CN 自举编译器 v2 · 整程序级预编译缓存（任务 1272·宿主 #1156 对偶）
// 职责：对「完整编译输入闭包」做汇编产物级缓存——输入全哈希命中后直接复用汇编
//   文本与该次编译的全部 stderr 诊断/进度文本，跳过语义/IR/优化/代码生成。
// 缓存键完备性（任一遗漏=静默错产物，故逐项入键）：
//   1. 缓存键格式版本（键组成本身变化须递增）
//   2. v2 编译器自身身份（可执行文件内容 128 位摘要 + 路径）——源码/构建任何
//      变化必失效，免人工版本号维护
//   3. 拓扑序全模块闭包：模块路径 + 文件路径 + 源内容 128 位摘要 + moduleDir +
//      包根标记 + 入口标记（源内容含 stdlib/导入闭包全部文件）
//   4. 编译选项：目标平台 + 优化级别（--verbose 显式旁路缓存）
//   5. 排序后的宏集合（-D 与货舱 [特性] 已并入）
//   6. 货舱 [依赖] 名+版本清单
// 显式旁路：CN_NO_V2_PROGRAM_CACHE=1 逃生门；--verbose/check/ir/验证类命令；
//   CN_V2_PROGRAM_CACHE_VERIFY=1 命中仍完整重编译并逐字节比对。
// 存放：<cwd>/target/cache/v2program/<签名>.cnvpc（target 已 gitignore）；
//   CN_V2_PROGRAM_CACHE_DIR 覆盖；tmp+rename 原子写；损坏/版本不符显形回退。
// 诊断重放：编译期 stderr 经运行时 __cn_diag_capture_* 原样捕获入条目，命中时
//   逐字节重放（含 [p6h] 进度行）——三态 stderr 完全一致。
// 内存/所有权：所有入容器的字符串显式 字符串复制 落堆；查询失败一律 结果/布尔
//   显式分流（#1239 禁哨兵）；文件 <=1000 行、函数 <=100 行。
导入 容器::向量;
导入 文件::打开文件;
导入 文件::写入文件;
导入 文件::文件存在;
导入 文件::关闭文件;

公开:

// 编译器自身身份（可执行文件内容摘要；GetModuleFileNameW//proc/self/exe）。
//   探针只做一次；路径不入键（内容哈希即身份，避免 argv[0] 歧义）。
静态 整64 身份已探 = 0;
静态 整64 身份可用 = 0;
静态 整64 身份甲 = 0;
静态 整64 身份乙 = 0;

// 缓存目录（启动时解析一次；环境读取错误=禁用缓存，不静默落默认目录）
静态 整64 缓存目录已定 = 0;
静态 字符串 缓存目录值 = "";

// 货舱头/原文摘要（[货舱] 名称+版本 + 原文 128 位摘要；扫描阶段记录）
静态 字符串 货舱包名键 = "";
静态 字符串 货舱包版键 = "";
静态 字符串 货舱原文摘要键 = "";
静态 字符串 货舱文件路径键 = "";

// 拓扑序模块闭包（平行平铺——嵌套容器静态值禁用，lessons 15 枚同族）
静态 向量<字符串> 闭包路径们;
静态 向量<字符串> 闭包目录们;
静态 向量<字符串> 闭包模块们;
静态 向量<字符串> 闭包摘要们;
静态 向量<整64> 闭包包根们;
静态 向量<整64> 闭包入口们;
静态 向量<整64> 闭包记录开启表;

// 键输入集合（宏/货舱依赖）
静态 向量<字符串> 宏名们;
静态 向量<字符串> 依赖名们;

// 统计计数（进程粒度）
静态 整64 统计命中 = 0;
静态 整64 统计首建 = 0;
静态 整64 统计失效 = 0;
静态 整64 统计损坏 = 0;
静态 整64 统计写入 = 0;
静态 整64 统计写失败 = 0;
静态 整64 统计验证不符 = 0;
静态 整64 临时文件序号 = 0;

// 运行时支撑原语（FFI·src/runtime：file_api/system_api/input_api）
外部 函数 __cn_file_digest_utf8(字符串 路径, 整64* 甲, 整64* 乙) -> 整32
外部 函数 __cn_file_rename_replace_utf8(字符串 旧路径, 字符串 新路径) -> 整32
外部 函数 __cn_dir_ensure_utf8(字符串 路径) -> 整32
外部 函数 __cn_getenv_utf8(字符串 名, 字符** 出) -> 整32
外部 函数 __cn_diag_capture_begin(整32 模式) -> 空类型
外部 函数 __cn_diag_capture_take(字符** 出) -> 整32
外部 函数 __cn_diag_capture_end() -> 空类型
外部 函数 __cn_str_hash128(字符串 文本, 整64* 甲, 整64* 乙) -> 整32
外部 函数 __cn_file_read_all_utf8(字符串 路径, 字符** 出, 正64* 长度) -> 整32
外部 函数 __cn_exe_identity(整64* 甲, 整64* 乙) -> 整32
外部 函数 __cn_process_id() -> 整64
外部 函数 __cn_file_delete_utf8(字符串 路径) -> 整32
外部 函数 __cn_intern_truncate(正64 保留数) -> 空类型

// 缓存条目形态（命中时两段文本原样复用）
结构体 程序缓存条目 {
    字符串 汇编文本;
    字符串 警告文本;
}

// ==================== 基础工具 ====================

函数 缓存字节值(字符串 文本, 整64 位置) -> 整64 {
    返回 整64(文本[整32(位置)]) & 255;
}

// FNV-1a 128（双 64 位通道；非加密用途——缓存指纹/完整性）。
//   1272：算法落在运行时 C++（__cn_str_hash128）——汇编产物可达数十 MB，
//   CN 逐字节循环在自举 -O0 产物下不可接受（实测 32MB 逾 30 分钟）。
不安全 函数 缓存哈希128(字符串 文本, 整64& 甲, 整64& 乙) -> 空类型 {
    整64 甲值 = 0;
    整64 乙值 = 0;
    整32 状态 = __cn_str_hash128(文本, &甲值, &乙值);
    // 运行时契约：合法非空指针永不失败；非零=内部错误，显式中止（不静默兜底）
    如果 (状态 != 0) { 运行时错误(4); }
    甲 = 甲值;
    乙 = 乙值;
}

// 源内容 128 位摘要（闭包单元键字段；与缓存载荷校验同算法）
不安全 函数 源内容摘要128(字符串 文本, 整64& 甲, 整64& 乙) -> 空类型 {
    缓存哈希128(文本, 甲, 乙);
}

// 64 位十六进制（16 位小写）；位模式按无符号 nibble 输出
函数 缓存十六进制64(整64 值) -> 字符串 {
    整64 构建 = 字符串构建器::新建();
    整64 序 = 15;
    当 (序 >= 0) {
        整64 半字节 = (值 >> (序 * 4)) & 15;
        如果 (半字节 >= 0 && 半字节 <= 9) {
            字符串构建器::追加字节(构建, 48 + 半字节);
        } 否则 如果 (半字节 >= 10 && 半字节 <= 15) {
            字符串构建器::追加字节(构建, 87 + 半字节);
        }
        序--;
    }
    返回 字符串构建器::完成(构建);
}

// 十六进制 nibble：0-15；非法返回 无值（880 批5 结果化）
函数 缓存半字节(整64 字节) -> 可选<整64> {
    如果 (字节 >= 48 && 字节 <= 57) { 返回 某些(字节 - 48); }
    如果 (字节 >= 97 && 字节 <= 102) { 返回 某些(字节 - 87); }
    如果 (字节 >= 65 && 字节 <= 70) { 返回 某些(字节 - 55); }
    返回 无;
}

// 严格 16 位十六进制解析（长度/字符非法=假）
函数 缓存解析十六进制64(字符串 文本, 整64& 值) -> 布尔 {
    如果 (字符串长度(文本) != 16) { 返回 假; }
    整64 acc = 0;
    整64 i = 0;
    当 (i < 16) {
        可选<整64> 半查 = 缓存半字节(缓存字节值(文本, i));
        // 无值（原 -1 哨兵）与越界同走「非法字符」假——原判据逐位等价
        如果 (半查.有值) {
            整64 半值 = 半查.值;
            如果 (半值 >= 0 && 半值 <= 15) {
                acc = (acc << 4) | 半值;
            } 否则 {
                返回 假;
            }
        } 否则 {
            返回 假;
        }
        i++;
    }
    值 = acc;
    返回 真;
}

// 键字段规范化：长度前缀 + 冒号 + 原文（文件名/模块名不含 NUL，无歧义）
函数 缓存追加字段(整64 构建, 字符串 值) -> 空类型 {
    字符串构建器::追加(构建, 整数转字符串(字符串长度(值)));
    字符串构建器::追加(构建, ":");
    字符串构建器::追加(构建, 值);
    字符串构建器::追加(构建, "\n");
}

不安全 函数 缓存追加串(向量<字符串>& 表, 字符串 值) -> 空类型 {
    结果<空类型, 整32> 加 = 表.追加(字符串复制(值));
    如果 (!加.正常) { 运行时错误(4); }
}

// 宏/依赖字典序排序（插入排序；键与搬移值均显式复制，防浅共享双释放）
不安全 函数 缓存排序字符串们(向量<字符串>& 表) -> 空类型 {
    整64 n = 表.大小();
    整64 i = 1;
    当 (i < n) {
        字符串 键 = 字符串复制(表.元素(i));
        整64 j = i;
        当 (j > 0 && 字符串字典序(表.元素(j - 1), 键) > 0) {
            结果<空类型, 整32> 移 = 表.设置(j, 字符串复制(表.元素(j - 1)));
            如果 (!移.正常) { 运行时错误(4); }
            j--;
        }
        结果<空类型, 整32> 放 = 表.设置(j, 键);
        如果 (!放.正常) { 运行时错误(4); }
        i++;
    }
}

// 驻留表回退到基线（闭包扫描副作用清除——完整编译驻留序列与无缓存单遍一致）
不安全 函数 程序缓存截断驻留(整64 保留数) -> 空类型 {
    __cn_intern_truncate(正64(保留数));
}

// 公开整文件读取（命中路径读回 asm 产物/主流程读回落盘文本）：状态通道，
//   正常=拥有文本（空文件=空串），错误码=运行时读取失败分类。
不安全 函数 读整文件文本(字符串 路径) -> 结果<字符串, 整32> {
    字符* 缓冲 = 无;
    正64 长度 = 0;
    整32 状态 = __cn_file_read_all_utf8(路径, &缓冲, &长度);
    如果 (状态 != 0 || 缓冲 == 无) { 返回 错误(状态); }
    字符串 文本 = 字符串复制(缓冲);
    字符串释放(缓冲);
    返回 正常(文本);
}

// 整段写文件 + 短写显形（fwrite 语义；返回错误=调用方告警，编译不受影响）
函数 缓存写文本文件(字符串 路径, 字符串 内容) -> 结果<空类型, 整32> {
    结果<空类型*, 整32> 打开 = 打开文件(路径, 2);
    如果 (!打开.正常) { 返回 错误(1); }
    结果<整64, 整32> 写 = 写入文件(打开.值, 内容);
    如果 (!写.正常) {
        关闭文件(打开.值);
        返回 错误(2);
    }
    整64 期望 = 字符串长度(内容);
    关闭文件(打开.值);
    如果 (写.值 != 期望) { 返回 错误(3); }
    返回 正常();
}

// ==================== 环境与旁路 ====================

// 环境读取（状态通道）：正常=存在（拥有副本）；错误(1)=未设置；错误(2)=转换/参数错误。
//   否定回答≠错误（#1239 边界）——调用方按未设置分流，不静默取默认值。
不安全 函数 缓存环境(字符串 名) -> 结果<字符串, 整32> {
    字符* 视图 = 无;
    整32 状态 = __cn_getenv_utf8(名, &视图);
    如果 (状态 == 1) { 返回 错误(1); }
    如果 (状态 != 0 || 视图 == 无) { 返回 错误(2); }
    返回 正常(字符串复制(视图));
}

// 布尔环境开关（非空且非 "0"）；读取失败=关（显式安全侧，非业务默认值）
不安全 函数 缓存开关(字符串 名) -> 布尔 {
    结果<字符串, 整32> 值 = 缓存环境(名);
    布尔 开 = 假;
    如果 (值.正常) {
        开 = !字符串比较(值.值, "") && !字符串比较(值.值, "0");
    }
    否则 {
    }
    返回 开;
}

不安全 函数 缓存统计开启() -> 布尔 {
    返回 缓存开关("CN_V2_PROGRAM_CACHE_STATS");
}

不安全 函数 缓存验证开启() -> 布尔 {
    返回 缓存开关("CN_V2_PROGRAM_CACHE_VERIFY");
}

不安全 函数 缓存被环境关闭() -> 布尔 {
    结果<字符串, 整32> 值 = 缓存环境("CN_NO_V2_PROGRAM_CACHE");
    布尔 关闭 = 假;
    如果 (值.正常) {
        关闭 = 字符串长度(值.值) > 0 && !字符串比较(值.值, "0");
    } 否则 如果 (!值.正常) {
        如果 (值.错误 == 1) {
            关闭 = 假;   // 未设置=不关闭
        } 否则 如果 (值.错误 != 1) {
            IO::打印到错误("提示: [程序缓存] 开关环境变量读取失败，按禁用处理\n");
            关闭 = 真;   // 读取失败=fail-closed（关闭缓存）
        }
    }
    返回 关闭;
}

// 命令行参数是否含 目标（系统::参数=字符* 借用，按字符串比较消费）
函数 缓存参数含(字符串 目标) -> 布尔 {
    整64 序 = 0;
    当 (序 < 系统::参数个数()) {
        字符* 文本 = 系统::参数(序);
        如果 (文本 != 无) {
            如果 (字符串比较(文本, 目标)) { 返回 真; }
        }
        序++;
    }
    返回 假;
}

// check/ir/验证类命令与 --verbose 显式旁路（命中会跳过其需要的阶段/输出）
函数 缓存命令旁路() -> 布尔 {
    如果 (缓存参数含("--verbose")) { 返回 真; }
    如果 (缓存参数含("--check")) { 返回 真; }
    如果 (缓存参数含("--ir")) { 返回 真; }
    如果 (缓存参数含("--验证-ir")) { 返回 真; }
    返回 假;
}

// 缓存目录：CN_V2_PROGRAM_CACHE_DIR 覆盖；默认 cwd 下 target/cache/v2program
//   （E2E/基准的 v2p 工作目录均有 target/，与宿主 <项目根>/target/cache/program 同构）。
//   读取失败=显式禁用缓存（返回 假），不静默改落默认目录。
不安全 函数 解析缓存目录() -> 布尔 {
    如果 (缓存目录已定 == 1) { 返回 真; }
    结果<字符串, 整32> 覆盖 = 缓存环境("CN_V2_PROGRAM_CACHE_DIR");
    如果 (覆盖.正常) {
        如果 (!字符串比较(覆盖.值, "")) {
            缓存目录值 = 字符串复制(覆盖.值);
        } 否则 如果 (字符串比较(覆盖.值, "")) {
            缓存目录值 = "target/cache/v2program";
        }
    } 否则 如果 (!覆盖.正常) {
        如果 (覆盖.错误 == 1) {
            缓存目录值 = "target/cache/v2program";
        } 否则 {
            IO::打印到错误("提示: [程序缓存] 缓存目录环境变量读取失败，程序级缓存禁用\n");
            返回 假;
        }
    }
    缓存目录已定 = 1;
    返回 真;
}

函数 缓存目录() -> 字符串 {
    返回 字符串复制(缓存目录值);
}

// ==================== 编译器自身身份 ====================

不安全 函数 缓存探针身份() -> 空类型 {
    如果 (身份已探 == 1) { 返回; }
    身份已探 = 1;
    整64 甲 = 0;
    整64 乙 = 0;
    // 平台 API 直接定位自身（GetModuleFileNameW//proc/self/exe）——不经
    //   argv[0]（POSIX 裸名经 PATH + cwd 同名文件会摘要错对象）。
    整32 状态 = __cn_exe_identity(&甲, &乙);
    如果 (状态 != 0) {
        身份可用 = 0;
        返回;
    }
    身份甲 = 甲;
    身份乙 = 乙;
    身份可用 = 1;
}

// 身份不可得：显式告警一次并禁用缓存（不以人工版本号冒充身份）
不安全 函数 缓存告警身份一次() -> 空类型 {
    如果 (身份可用 == 0) {
        IO::打印到错误("提示: [程序缓存] 无法读取编译器自身身份（argv[0]），" +
                       "程序级缓存禁用（直连编译）\n");
    }
}

// 缓存是否启用：入口存在 + 未关闭 + 非旁路命令 + 身份可读。
//   探针失败=显式禁用（告警一次），绝不静默以默认身份继续。
不安全 函数 程序缓存可用(字符串 入口路径) -> 布尔 {
    如果 (字符串长度(入口路径) == 0) { 返回 假; }
    如果 (缓存被环境关闭()) { 返回 假; }
    如果 (缓存命令旁路()) { 返回 假; }
    布尔 目录可用 = 解析缓存目录();
    缓存探针身份();
    如果 (身份可用 == 0) {
        缓存告警身份一次();
    }
    布尔 入口存在 = 文件存在(入口路径);
    如果 (入口存在 && 身份可用 == 1 && 目录可用) { 返回 真; }
    返回 假;
}

// ==================== 闭包记录（扫描阶段调用） ====================

不安全 函数 清空程序缓存记录() -> 空类型 {
    闭包路径们.清空();
    闭包目录们.清空();
    闭包模块们.清空();
    闭包摘要们.清空();
    宏名们.清空();
    依赖名们.清空();
    货舱包名键 = "";
    货舱包版键 = "";
    货舱原文摘要键 = "";
    货舱文件路径键 = "";
    闭包包根们.清空();
    闭包入口们.清空();
    闭包记录开启表.清空();
}

不安全 函数 设程序缓存记录开启(整64 开) -> 空类型 {
    闭包记录开启表.清空();
    如果 (开 != 0) {
        结果<空类型, 整32> 加 = 闭包记录开启表.追加(1);
        如果 (!加.正常) { 运行时错误(4); }
    }
}

函数 程序缓存记录开启() -> 布尔 { 返回 闭包记录开启表.大小() > 0; }

不安全 函数 记录程序缓存宏名(字符串 名) -> 空类型 {
    如果 (!程序缓存记录开启()) { 返回; }
    缓存追加串(宏名们, 名);
}

不安全 函数 记录程序缓存依赖(字符串 名, 字符串 版本) -> 空类型 {
    如果 (!程序缓存记录开启()) { 返回; }
    缓存追加串(依赖名们, 名 + "=" + 版本);
}

// 记录一个模块单元（拓扑序：依赖先记录）。摘要=源内容 128 位。
不安全 函数 记录程序缓存模块(字符串 路径, 字符串 目录, 字符串 模块路径,
                           整64 摘要甲, 整64 摘要乙, 整64 是包根, 整64 是入口) -> 空类型 {
    如果 (!程序缓存记录开启()) { 返回; }
    缓存追加串(闭包路径们, 路径);
    缓存追加串(闭包目录们, 目录);
    缓存追加串(闭包模块们, 模块路径);
    缓存追加串(闭包摘要们, 缓存十六进制64(摘要甲) + 缓存十六进制64(摘要乙));
    结果<空类型, 整32> 加根 = 闭包包根们.追加(是包根);
    如果 (!加根.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加入 = 闭包入口们.追加(是入口);
    如果 (!加入.正常) { 运行时错误(4); }
}

// 货舱头记录（扫描阶段）：[货舱] 名称/版本 + 原文 128 位摘要 + 路径全部入键。
//   命中会重放旧 stderr 的「[p6b] 货舱.toml 已加载: 名 v版」——不覆盖即错重放。
不安全 函数 记录程序缓存货舱头(字符串 包名, 字符串 包版, 字符串 原文,
                              字符串 文件路径) -> 空类型 {
    如果 (!程序缓存记录开启()) { 返回; }
    货舱包名键 = 字符串复制(包名);
    货舱包版键 = 字符串复制(包版);
    货舱文件路径键 = 字符串复制(文件路径);
    整64 甲 = 0;
    整64 乙 = 0;
    缓存哈希128(原文, 甲, 乙);
    货舱原文摘要键 = 缓存十六进制64(甲) + 缓存十六进制64(乙);
}

// TOCTOU 复核（写缓存前）：逐单元重读源文件 + 货舱.toml 重算摘要，与扫描记录
//   比对；任一不一致=编译期间输入已变，本次不写缓存（避免键/产物错配）。
不安全 函数 程序缓存闭包仍一致() -> 布尔 {
    整64 i = 0;
    当 (i < 闭包路径们.大小()) {
        字符串 源 = 读源文件(闭包路径们.元素(i));
        整64 甲 = 0;
        整64 乙 = 0;
        源内容摘要128(源, 甲, 乙);
        如果 (!字符串比较(缓存十六进制64(甲) + 缓存十六进制64(乙),
                          闭包摘要们.元素(i))) {
            返回 假;
        }
        i++;
    }
    // 与扫描同源：扫描用 读源文件（末行缺换行会补换行符）记录原文摘要；
    //   TOCTOU 必须用同一归一化读取（原始字节读取会对无末换行文件永久判变）。
    字符串 原文 = 读源文件(货舱文件路径键);
    整64 甲2 = 0;
    整64 乙2 = 0;
    缓存哈希128(原文, 甲2, 乙2);
    返回 字符串比较(缓存十六进制64(甲2) + 缓存十六进制64(乙2), 货舱原文摘要键);
}

// ==================== 键计算 ====================

// 计算程序级缓存键；返回 假=身份不可得/无闭包记录（缓存禁用·调用方直连编译）。
不安全 函数 计算程序缓存键(字符串 目标平台, 整64 优化级别, 整64& 甲, 整64& 乙) -> 布尔 {
    如果 (身份可用 == 0 || 闭包路径们.大小() == 0) { 返回 假; }
    缓存排序字符串们(宏名们);
    缓存排序字符串们(依赖名们);
    整64 构建 = 字符串构建器::新建();
    缓存追加字段(构建, "CNV2-PROGRAM-CACHE-KEY-2");
    缓存追加字段(构建, 缓存十六进制64(身份甲) + 缓存十六进制64(身份乙));
    缓存追加字段(构建, 目标平台);
    缓存追加字段(构建, 整数转字符串(优化级别));
    缓存追加字段(构建, 整数转字符串(宏名们.大小()));
    整64 mi = 0;
    当 (mi < 宏名们.大小()) {
        缓存追加字段(构建, 宏名们.元素(mi));
        mi++;
    }
    缓存追加字段(构建, 整数转字符串(依赖名们.大小()));
    整64 di = 0;
    当 (di < 依赖名们.大小()) {
        缓存追加字段(构建, 依赖名们.元素(di));
        di++;
    }
    缓存追加字段(构建, 货舱包名键);
    缓存追加字段(构建, 货舱包版键);
    缓存追加字段(构建, 货舱原文摘要键);
    缓存追加字段(构建, 货舱文件路径键);
    缓存追加字段(构建, 整数转字符串(闭包路径们.大小()));
    整64 ui = 0;
    当 (ui < 闭包路径们.大小()) {
        缓存追加字段(构建, 闭包路径们.元素(ui));
        缓存追加字段(构建, 闭包目录们.元素(ui));
        缓存追加字段(构建, 闭包模块们.元素(ui));
        缓存追加字段(构建, 闭包摘要们.元素(ui));
        缓存追加字段(构建, 整数转字符串(闭包包根们.元素(ui)));
        缓存追加字段(构建, 整数转字符串(闭包入口们.元素(ui)));
        ui++;
    }
    字符串 规范 = 字符串构建器::完成(构建);
    缓存哈希128(规范, 甲, 乙);
    返回 真;
}

// 条目文件名=入口+选项+宏/依赖签名的 128 位键（完整输入键存文件头；
//   同一入口同选项的旧版本原地覆盖，磁盘不按输入版本累积）。
不安全 函数 程序缓存条目路径(字符串 入口路径, 字符串 目标平台, 整64 优化级别) -> 字符串 {
    整64 构建 = 字符串构建器::新建();
    缓存追加字段(构建, 入口路径);
    缓存追加字段(构建, 目标平台);
    缓存追加字段(构建, 整数转字符串(优化级别));
    整64 mi = 0;
    当 (mi < 宏名们.大小()) {
        缓存追加字段(构建, 宏名们.元素(mi));
        mi++;
    }
    整64 di = 0;
    当 (di < 依赖名们.大小()) {
        缓存追加字段(构建, 依赖名们.元素(di));
        di++;
    }
    整64 甲 = 0;
    整64 乙 = 0;
    缓存哈希128(字符串构建器::完成(构建), 甲, 乙);
    // 编译器身份（内容摘要 16 hex）并入文件名：v2p/cn_self 交替编译同一入口
    //   各自保留条目，互不判陈旧（磁盘约 2 份/编译器身份，可接受）。
    返回 缓存目录() + "/" + 缓存十六进制64(甲) + 缓存十六进制64(乙) +
           "-" + 缓存十六进制64(身份甲) + ".cnvpc";
}

// ==================== 统计 ====================

不安全 函数 记录程序缓存统计(整64 类别) -> 空类型 {
    如果 (类别 == 0) { 统计命中++; }
    否则 如果 (类别 == 1) { 统计首建++; }
    否则 如果 (类别 == 2) { 统计失效++; }
    否则 如果 (类别 == 3) { 统计损坏++; }
    否则 如果 (类别 == 4) { 统计写入++; }
    否则 如果 (类别 == 5) { 统计写失败++; }
    否则 如果 (类别 == 6) { 统计验证不符++; }
}

函数 打印程序缓存统计() -> 空类型 {
    如果 (!缓存统计开启()) { 返回; }
    IO::打印到错误("[程序缓存] 命中=" + 整数转字符串(统计命中) +
                   " 首建=" + 整数转字符串(统计首建) +
                   " 失效重建=" + 整数转字符串(统计失效) +
                   " 损坏回退=" + 整数转字符串(统计损坏) +
                   " 写入=" + 整数转字符串(统计写入) +
                   " 写失败=" + 整数转字符串(统计写失败) +
                   " 验证不符=" + 整数转字符串(统计验证不符) + "\n");
}

// ==================== 条目读取 ====================

// 取下一行（内容[起..换行)）；返回 假=无换行/越界
函数 缓存取下一行(字符串 内容, 整64 起, 字符串& 行, 整64& 行终) -> 布尔 {
    整64 n = 字符串长度(内容);
    整64 i = 起;
    当 (i < n) {
        如果 (缓存字节值(内容, i) == 10) {
            行 = 字符串子串(内容, 起, i - 起);
            行终 = i + 1;
            返回 真;
        }
        i++;
    }
    返回 假;
}

函数 缓存损坏告警(字符串 原因, 字符串 文件) -> 空类型 {
    记录程序缓存统计(3);
    IO::打印到错误("警告: [程序缓存] 缓存条目无效（" + 原因 +
                   "），回退完整编译: " + 文件 + "\n");
}

// 读取条目：正常=命中（条目已填充）；错误(1)=无条目/键不符（普通未命中）；
//   错误(2)=损坏（已显形）。长度/校验/结构任一不符=损坏分支，绝不静默沿用。
不安全 函数 读取程序缓存条目(字符串 条目文件, 整64 键甲, 整64 键乙,
                         程序缓存条目& 条目) -> 结果<空类型, 整32> {
    // 出参先归零（失败路径调用方析构不得触碰未初始化句柄）
    条目.汇编文本 = "";
    条目.警告文本 = "";
    如果 (!文件存在(条目文件)) {
        记录程序缓存统计(1);
        返回 错误(1);
    }
    结果<字符串, 整32> 读 = 读整文件文本(条目文件);
    如果 (!读.正常) {
        缓存损坏告警("文件不可读", 条目文件);
        返回 错误(2);
    }
    字符串 内容 = 字符串复制(读.值);
    如果 (字符串长度(内容) == 0) {
        缓存损坏告警("文件为空", 条目文件);
        返回 错误(2);
    }
    整64 游标 = 0;
    字符串 魔数 = "";
    如果 (!缓存取下一行(内容, 0, 魔数, 游标) || !字符串比较(魔数, "CNV2PC02")) {
        缓存损坏告警("魔数不符（格式版本变化）", 条目文件);
        返回 错误(2);
    }
    字符串 键甲行 = "";
    字符串 键乙行 = "";
    字符串 长甲行 = "";
    字符串 长乙行 = "";
    字符串 校甲行 = "";
    字符串 校乙行 = "";
    如果 (!缓存取下一行(内容, 游标, 键甲行, 游标) ||
        !缓存取下一行(内容, 游标, 键乙行, 游标) ||
        !缓存取下一行(内容, 游标, 长甲行, 游标) ||
        !缓存取下一行(内容, 游标, 长乙行, 游标) ||
        !缓存取下一行(内容, 游标, 校甲行, 游标) ||
        !缓存取下一行(内容, 游标, 校乙行, 游标)) {
        缓存损坏告警("头部不完整", 条目文件);
        返回 错误(2);
    }
    整64 存甲 = 0;
    整64 存乙 = 0;
    整64 校甲 = 0;
    整64 校乙 = 0;
    如果 (!缓存解析十六进制64(键甲行, 存甲) || !缓存解析十六进制64(键乙行, 存乙) ||
        !缓存解析十六进制64(校甲行, 校甲) || !缓存解析十六进制64(校乙行, 校乙)) {
        缓存损坏告警("头部十六进制字段非法", 条目文件);
        返回 错误(2);
    }
    如果 (存甲 != 键甲 || 存乙 != 键乙) {
        // 陈旧=正常重建；提示仅在统计通道输出（默认 stderr 保持确定性）
        记录程序缓存统计(2);
        如果 (缓存统计开启()) {
            IO::打印到错误("提示: [程序缓存] 缓存键不符（输入/选项/编译器已变化），" +
                           "回退完整编译: " + 条目文件 + "\n");
        }
        返回 错误(1);
    }
    整32 长甲ok = 0;
    整32 长乙ok = 0;
    整64 汇编长 = 解析::转整数(长甲行, &长甲ok);
    整64 警告长 = 解析::转整数(长乙行, &长乙ok);
    如果 (长甲ok == 0 || 长乙ok == 0 || 汇编长 <= 0 || 警告长 < 0 ||
        汇编长 > 4611686018427387904 || 警告长 > 4611686018427387904 - 汇编长) {
        缓存损坏告警("载荷长度非法", 条目文件);
        返回 错误(2);
    }
    整64 内容长 = 字符串长度(内容);
    整64 载荷长 = 汇编长 + 警告长;
    如果 (游标 > 内容长 || 载荷长 > 内容长 - 游标) {
        缓存损坏告警("载荷截断", 条目文件);
        返回 错误(2);
    }
    // 尾部固定 1 字节换行（写侧恒补）：长度必须精确，防追加垃圾静默接受
    如果 (内容长 - 游标 - 载荷长 != 1) {
        缓存损坏告警("载荷长度不符", 条目文件);
        返回 错误(2);
    }
    字符串 载荷 = 字符串子串(内容, 游标, 载荷长);
    整64 实甲 = 0;
    整64 实乙 = 0;
    // 校验域含分片长度行（长甲行+换行+长乙行+换行+载荷）：长度篡改亦被覆盖
    缓存哈希128(长甲行 + "\n" + 长乙行 + "\n" + 载荷, 实甲, 实乙);
    如果 (实甲 != 校甲 || 实乙 != 校乙) {
        缓存损坏告警("载荷校验和不符", 条目文件);
        返回 错误(2);
    }
    条目.汇编文本 = 字符串子串(内容, 游标, 汇编长);
    条目.警告文本 = 字符串子串(内容, 游标 + 汇编长, 警告长);
    记录程序缓存统计(0);
    返回 正常();
}

// ==================== 条目写入 ====================

// 成功编译后原子写入（tmp+rename）：条目=头部 + 汇编文本 + 警告文本 + 尾部换行。
//   写失败不阻断编译（返回错误由调用方告警）。
不安全 函数 写入程序缓存条目(字符串 条目文件, 整64 键甲, 整64 键乙,
                           字符串 汇编文本, 字符串 警告文本) -> 结果<空类型, 整32> {
    字符串 目录 = 缓存目录();
    如果 (__cn_dir_ensure_utf8(目录) != 0) {
        记录程序缓存统计(5);
        返回 错误(1);
    }
    字符串 长甲行 = 整数转字符串(字符串长度(汇编文本));
    字符串 长乙行 = 整数转字符串(字符串长度(警告文本));
    整64 校验甲 = 0;
    整64 校验乙 = 0;
    // 校验域含分片长度行，长度篡改同样被覆盖（读取端同式重建）
    缓存哈希128(长甲行 + "\n" + 长乙行 + "\n" + 汇编文本 + 警告文本,
                校验甲, 校验乙);
    整64 构建 = 字符串构建器::新建();
    字符串构建器::追加(构建, "CNV2PC02\n");
    字符串构建器::追加(构建, 缓存十六进制64(键甲) + "\n");
    字符串构建器::追加(构建, 缓存十六进制64(键乙) + "\n");
    字符串构建器::追加(构建, 长甲行 + "\n");
    字符串构建器::追加(构建, 长乙行 + "\n");
    字符串构建器::追加(构建, 缓存十六进制64(校验甲) + "\n");
    字符串构建器::追加(构建, 缓存十六进制64(校验乙) + "\n");
    字符串构建器::追加(构建, 汇编文本);
    字符串构建器::追加(构建, 警告文本);
    字符串构建器::追加(构建, "\n");
    字符串 载荷 = 字符串构建器::完成(构建);
    // tmp 名含 PID + 进程内序号（对齐宿主 #1213）：并发编译器互不覆盖半截文件
    临时文件序号++;
    字符串 临时文件 = 条目文件 + ".tmp." + 整数转字符串(__cn_process_id()) +
                       "." + 整数转字符串(临时文件序号);
    结果<空类型, 整32> 写 = 缓存写文本文件(临时文件, 载荷);
    如果 (!写.正常) {
        记录程序缓存统计(5);
        __cn_file_delete_utf8(临时文件);
        返回 错误(2);
    }
    如果 (__cn_file_rename_replace_utf8(临时文件, 条目文件) != 0) {
        记录程序缓存统计(5);
        __cn_file_delete_utf8(临时文件);
        返回 错误(3);
    }
    记录程序缓存统计(4);
    返回 正常();
}

// 命中路径落盘汇编文本（返回 错误=调用方退出 1，与 写asm文件 失败纪律同族）
函数 写缓存汇编文本(字符串 文本, 字符串 路径) -> 结果<空类型, 整32> {
    返回 缓存写文本文件(路径, 文本);
}

// ==================== 诊断捕获包装 ====================

不安全 函数 程序缓存捕获开始(整64 模式) -> 空类型 {
    __cn_diag_capture_begin(整32(模式));
}

不安全 函数 程序缓存捕获取走() -> 结果<字符串, 整32> {
    字符* 缓冲 = 无;
    整32 状态 = __cn_diag_capture_take(&缓冲);
    如果 (状态 != 0 || 缓冲 == 无) { 返回 错误(状态); }
    字符串 文本 = 字符串复制(缓冲);
    字符串释放(缓冲);
    返回 正常(文本);
}

不安全 函数 程序缓存捕获结束() -> 空类型 {
    __cn_diag_capture_end();
}
