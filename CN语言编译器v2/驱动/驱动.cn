// CN 自举编译器 v2 · 驱动组件（1108 拆分轮自主.cn 机械搬移，2026-10-19）
// 职责：多文件驱动辅助（P6h，2026-08-31）——标准库模块判定/源文件读取/
//   路径工具族（分隔符归一/目录提取/主干提取/双斜杠折叠）。函数体逐字保留
//   搬移前原文（主.cn 65~206 段·零语义改动，键基/mangling 影响面=v2p 自身
//   内部链接，整体重编自洽；用例/运行时不引用本组件符号）。
// 依赖：只消费 stdlib 文件模块与内建字符串族（字符串构建器=内建限定名直调
//   全局注册无需导入）——零 CN 包依赖（check_layer_deps CN_ALLOW["驱动"]=∅）。
导入 文件::打开文件;
导入 文件::读取文件行;
导入 文件::关闭文件;
公开:
// 标准库模块名（宿主提供编译产物，不加载 .cn 文件）——420-a：守卫维持
//   （stdlib 源码级加载的 IR 生成段缺口清单已实测〔类型大小 K/V 表达式位
//   48+字段偏移 72+装箱语境 12·plans/025 §2.70〕=421-a 攻坚面；枚举/泛型
//   函数/函数单态化前置已齐）。
函数 是标准库模块(字符串 名) -> 布尔 {
    // 335 重构B 转正定性：P7b 借链机制依赖本判定返回 假——stdlib 源码级并入
    //   v2p 产物（容器/结果 等方法实现落 v2p.obj）供 79 链 cn_self 借链
    //   （run_e2e 829「链接 v2p.obj——容器符号供给」）；返回 真=跳过 stdlib
    //   源码加载→借链断供 79 链 LNK1120（2026-10-09 实测）。
    //   原「TEMP 634-a 撤守卫实验态（禁止提交·收工还原）」注释过时销毁。
    返回 假;
}

// 读源文件全文（打开模式 1=读 + 读取文件行 拼接）；失败返回 空串
函数 读源文件(字符串 路径) -> 字符串 {
    // 872（074 波2）：逐行拼接 O(L²)→字符串构建器 O(L)（Rust String::push_str 同款）
    整64 构建读 = 字符串构建器::新建();
    结果<空类型*, 整32> 打开 = 打开文件(路径, 1);
    如果 (打开.正常) {
        当 (真) {
            结果<字符串, 整32> 行 = 文件::读取文件行(打开.值);
            如果 (行.正常) {
                // 缺陷③根治（2026-09-04 用户裁决 C1）：读取文件行 契约=含换行（fgets 语义）——
                //   原拼接再补换行致每行双换行、词法行号翻倍（146 用例 行=2n+1 实证）；
                //   行尾已有换行直接拼接，无（文件末行）才补
                整64 行长 = 字符串长度(行.值);
                如果 (行长 > 0 && 字节值(行.值, 行长 - 1) == 10) {
                    字符串构建器::追加(构建读, 行.值);
                } 否则 {
                    字符串构建器::追加(构建读, 行.值);
                    字符串构建器::追加(构建读, "\n");
                }
            } 否则 {
                中断;  // EOF/错误
            }
        }
        关闭文件(打开.值);
    }
    返回 字符串构建器::完成(构建读);
}

// 路径分隔符归一（2026-09-09 用户裁决，Rust std::path 分隔符等价同构，lessons
//   权重6「路径身份判定必须归一分隔符」）：win 反斜杠 argv 形态与 v2 内部构造的
//   正斜杠路径文本失配=包上下文恢复失配/已加载去重失效双载歧义 183 错（第四十一
//   轮挂账③）。入口单点归一 '\'->'/'，下游全部字符串路径身份自然一致（v2 内部
//   构造路径已统一 '/'）。快路径无反斜杠原样返回（linux 常态零分配零拷贝）。
函数 归一路径分隔符(字符串 路径) -> 字符串 {
    整64 长 = 字符串长度(路径);
    整64 i = 0;
    当 (i < 长) {
        如果 ((整64(路径[i]) & 255) == 92) { 中断; }   // '\\'
        i++;
    }
    如果 (i >= 长) { 返回 字符串复制(路径); }
    // 872（074 波2）：逐字节拼接 O(L²)→字符串构建器 O(L)（追加字节免子串分配）
    整64 构建归 = 字符串构建器::新建();
    字符串构建器::追加(构建归, 字符串子串(路径, 0, i));
    当 (i < 长) {
        如果 ((整64(路径[i]) & 255) == 92) {
            字符串构建器::追加字节(构建归, 47);
        } 否则 {
            字符串构建器::追加字节(构建归, 整64(路径[i]) & 255);
        }
        i++;
    }
    返回 字符串构建器::完成(构建归);
}

// 取路径的目录部分（最后一个 / 或 \ 之前；无分隔符返回 空串）
函数 路径目录(字符串 路径) -> 字符串 {
    整64 长 = 字符串长度(路径);
    整64 最后斜杠 = -1;
    整64 i = 0;
    当 (i < 长) {
        整64 字节 = 整64(路径[i]) & 255;
        如果 (字节 == 47 || 字节 == 92) { 最后斜杠 = i; }  // '/' '\'
        i++;
    }
    如果 (最后斜杠 < 0) { 返回 ""; }
    返回 字符串子串(路径, 0, 最后斜杠);
}

// 取文件主干名（最后 '/' 后、最后 '.' 前；无 '.' 取到尾）——父挂子加载路径用
函数 取文件主干(字符串 路径) -> 字符串 {
    整64 起点 = 0;
    整64 i = 整64(字符串长度(路径) - 1);
    当 (i >= 0) {
        整64 字节 = 整64(路径[i]) & 255;
        如果 (字节 == 47 || 字节 == 92) { 起点 = i + 1; i = -1; }  // 命中分隔符后停
        i--;
    }
    字符串 文件名 = 字符串子串(路径, 起点, 字符串长度(路径) - 起点);
    整64 点位 = -1;
    整64 j = 整64(字符串长度(文件名) - 1);
    当 (j >= 0) {
        整64 字节2 = 整64(文件名[j]) & 255;
        如果 (字节2 == 46) { 点位 = j; j = -1; }  // '.'=46
        j--;
    }
    如果 (点位 > 0) { 返回 字符串子串(文件名, 0, 点位); }
    返回 文件名;
}

// 340-f：路径规范化（双斜杠折叠）——递归候选拼接可产生 `x//y` 形态，
//   同一物理文件多键=已加载 去重/循环判定失准（自举树 24 误伤实证）。
函数 折叠双斜杠(字符串 路径) -> 字符串 {
    // 872（074 波2）：逐字符拼接 O(L²)→字符串构建器 O(L)（字节比较免子串分配）
    整64 构建出 = 字符串构建器::新建();
    整64 i = 0;
    整64 长 = 字符串长度(路径);
    整64 前斜杠 = 0;
    当 (i < 长) {
        整64 c = 整64(路径[i]) & 255;
        如果 (c == 47) {
            如果 (前斜杠 == 0) { 字符串构建器::追加字节(构建出, c); }
            前斜杠 = 1;
        } 否则 {
            字符串构建器::追加字节(构建出, c);
            前斜杠 = 0;
        }
        i++;
    }
    返回 字符串构建器::完成(构建出);
}
