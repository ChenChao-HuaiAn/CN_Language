// CN 自举编译器 v2：跨组件共享协议常量（簇①根治·A2 方案，2026-09-04 用户裁决）
// 职责：IR 操作码（IR_*）/IR 类型码（T_*）/AST 节点类型（节点_*）/字段分桶键位移
//   /跨组件函数级类型权威表（当前函数变量类型）的**单一归属**。
//
// 根治背景（语法分析.cn 冒烟簇①，35+14 错）：
//   原 T_*/IR_* 常量与 当前函数变量类型 定义在 IR生成.cn 顶层、节点_*/键位移 定义在
//   语法分析.cn 顶层，而 IR容器.cn（容器方法 IR 发射）大量引用两者——但 IR生成.cn
//   已 导入 IR容器、语法分析.cn 已 导入 IR容器（P7b 成员预标注），反向导入即循环
//   依赖，不可导。主链全绿依赖 P6h「全文件声明收集→全局符号表合并」的宽松模型
//   掩盖（IR生成/语法分析 恰在链上）；冒烟链（语法分析.cn 入口仅 4 文件）暴露。
//   本文件无依赖（纯常量+一张静态表），全部引用方显式 导入 IR常量——依赖图
//   单向无环，规范 08「导入可见」对齐（协议常量统一 公开:）。
//
// 迁移纪律：组件源码引用这些常量一律经 导入 IR常量；新增共享协议常量（新的操作码/
//   节点类型/类型码）在本文件追加，禁止散落各组件顶层（防再次漂移出引用面）。

导入 容器::向量;
导入 映射集合;

公开:

// ==================== IR 操作码（对标 C++ 编译器 ir.hpp Opcode） ====================
常量 IR_常量整数 = 1;
常量 IR_常量浮点 = 2;
常量 IR_常量字符串 = 3;
常量 IR_常量布尔 = 4;
常量 IR_加 = 10;
常量 IR_减 = 11;
常量 IR_乘 = 12;
常量 IR_除 = 13;
常量 IR_取余 = 14;
常量 IR_位与 = 15;
常量 IR_位或 = 16;
常量 IR_位异或 = 17;
常量 IR_相等 = 20;
常量 IR_不等 = 21;
常量 IR_小于 = 22;
常量 IR_大于 = 23;
常量 IR_小于等于 = 24;
常量 IR_大于等于 = 25;
常量 IR_逻辑非 = 30;
常量 IR_负 = 31;         // 一元负（P6b：操作数1=源寄存器，目标=结果）
常量 IR_加载 = 40;       // 变量槽 -> 寄存器（操作数1=槽索引，结果=寄存器）
常量 IR_存储 = 41;       // 寄存器 -> 变量槽（操作数1=值，附加=槽索引）
常量 IR_分配 = 42;       // 登记变量槽（Alloca；附加=槽索引）
常量 IR_取地址 = 43;     // 变量槽地址（附加=槽索引）
常量 IR_指针加载 = 44;   // 经指针值加载（操作数1=地址）
常量 IR_指针存储 = 45;   // 经指针值存储（操作数1=地址，操作数2=值）
常量 IR_字段地址 = 46;   // 结构体字段地址（操作数1=基址，附加=字段偏移）
常量 IR_标签 = 49;       // 块标签（P6b；附加=块ID，代码生成输出 bbN:）
常量 IR_跳转 = 50;       // 无条件跳转（附加=目标块ID）
常量 IR_条件跳转 = 51;   // 条件跳转（操作数1=条件寄存器，操作数2=真块，操作数3=假块）
常量 IR_调用 = 52;       // 函数调用（操作数1=this/返回缓冲，操作数2..=实参，附加=函数符号）
常量 IR_返回 = 53;       // 返回（操作数1=返回值寄存器，可为0）
常量 IR_类型转换 = 54;   // 类型转换 类型(expr)（操作数1=源寄存器，附加=目标类型码）
// P7b（2026-09-01）容器支持新增操作码——宿主对象模型对齐（ir_oop_call 契约）
常量 IR_分配对象 = 60;   // NewObject：目标=对象指针寄存器，类型=对象字节数，附加=类名ID
常量 IR_结构体拷贝 = 61; // CopyStruct：操作数1=源地址，操作数2=目标地址，类型=字节数
常量 IR_删除对象 = 62;   // DeleteObject：操作数1=对象指针寄存器，附加=类名ID（空安全跳过）
常量 IR_调用参数化 = 63; // 调用收尾：操作数1=总参数位数（含 retbuf/this，供代码生成
                        //   计算栈参数区），类型=retbuf 序号（0=无），附加=完整符号ID，
                        //   目标=返回寄存器（0=丢弃）。实参装载由前导 IR_调用实参 指令完成
常量 IR_调用实参 = 64;   // 调用实参装载：操作数1=实参寄存器，类型=参数位号（0 起：
                        //   retbuf 占 0 时后移；<4 走 rcx/rdx/r8/r9，>=4 走栈参数区）
                        //   ——任意实参数支持（7 组件源码 8 参函数，③ 前置）
// ②c C/D（2026-09-02）新增操作码——静态槽与按引用语义
常量 IR_静态加载 = 65;   // 静态槽读：附加=静态序号，目标=寄存器（.data _cn_gstatic_N）
常量 IR_静态存储 = 66;   // 静态槽写：操作数1=值寄存器，附加=静态序号（入口构造存指针/标量）

// ==================== IR 类型码 ====================
常量 T_未知 = 0;
常量 T_整32 = 1;
常量 T_整64 = 2;
常量 T_浮32 = 3;
常量 T_浮64 = 4;
常量 T_布尔 = 5;
常量 T_字符串 = 6;
常量 T_指针 = 7;
常量 T_空类型 = 8;
常量 T_对象 = 9;        // P7b：容器类对象（8 字节指针槽，堆对象）
常量 T_整8 = 10;        // ②b B5：窄宽指针加载/存储标注（1 字节）
常量 T_整16 = 11;       // ②b B5：窄宽指针加载/存储标注（2 字节）
常量 T_字符 = 12;       // ②b B5：窄宽指针加载/存储标注（1 字节）
常量 T_字节 = 13;       // ③ 第二波：字符串下标专用加载标注（1 字节符号扩展——
                       //   宿主 A-1 对齐：LoadPtr i8 双后端 movsx/ldrsb；
                       //   与 B5 字段 T_字符 零扩展模型互不影响）

// ==================== AST 节点类型（原 语法分析.cn 顶层，协议常量单一归属） ====================
常量 节点_整数字面量 = 11;
常量 节点_浮点字面量 = 12;
常量 节点_字符串字面量 = 13;
常量 节点_标识符 = 10;
常量 节点_程序 = 1;
常量 节点_函数 = 2;
常量 节点_参数 = 3;
常量 节点_块 = 4;
常量 节点_变量声明 = 5;
常量 节点_返回语句 = 6;
常量 节点_表达式语句 = 7;
常量 节点_如果语句 = 8;
常量 节点_当语句 = 9;
常量 节点_结构体 = 21;
常量 节点_类型 = 22;
// P6b 控制流新增节点（2026-08-30）
常量 节点_赋值 = 23;        // 赋值语句/表达式：子起点=左值，子终点=右值表达式
常量 节点_自增 = 24;        // 自增语句（++ 变量）：附加=目标变量名ID
常量 节点_逻辑非 = 25;      // 前缀 ! 一元：子起点=操作数表达式
常量 节点_负号 = 26;        // 前缀 - 一元：子起点=操作数表达式
常量 节点_中断语句 = 27;    // 中断
常量 节点_继续语句 = 28;    // 继续
// P6c 指针/字段访问新增节点（2026-08-30）
常量 节点_取地址 = 29;      // & 取地址：子起点=操作数表达式
常量 节点_解引用 = 30;      // * 解引用：子起点=操作数表达式
// P7a 顶层常量声明（2026-09-01）：常量 名 = 表达式（类型推断，规范 5.2）
常量 节点_常量声明 = 31;    // 文本=名ID，子区间=初始化表达式（IR 层折叠为字面量内联）
// ②c C 顶层静态声明（2026-09-02，规范 03-一）：静态 类型 名 [= 表达式]
常量 节点_静态声明 = 32;
// ③ 第六波（2026-09-03）：三元条件运算（规范 01b 5.8，优先级 1.5）。节点字段：
//   子起点=条件段起点、文本=真值段起点、附加=假值段起点、子终点=段末+1（三段连续）
常量 节点_三元运算 = 33;
// 灰色点①根治（2026-09-04）：布尔字面量 真/假 独立节点（文本=1/0）——类型推导 布尔
常量 节点_布尔字面量 = 34;
// 簇③根治·自减全链 C1（2026-09-04 用户裁决）：自减语句节点与 节点_自增 对称
//   （文本=目标变量名ID）
常量 节点_自减 = 35;

// ==================== 字段偏移分桶键位移（P6e） ====================
// 键 = 结构体名ID * 键位移 + 字段名ID（单映射，无嵌套依赖）；成员访问经 变量结构体表
//   （语法分析.cn）推导对象所属结构体。键位移 = 2^20：字段名 ID 远小于 1048576
//   （字符串驻留 ID 递增小整数），无碰撞。引用面：语法分析/语义分析/IR生成/IR容器。
常量 键位移 = 1048576;

// ==================== 跨组件函数级类型权威表（原 IR生成.cn:236，A2 下沉） ====================
// 键=变量名ID -> 值=类型名ID。IR生成（参数/局部登记）写入、IR生成 与 IR容器
//   （成员访问推导）读取；任务开始时清空（IR生成.cn 入口）。经 IR常量 单一归属后
//   双向引用合法（IR容器 导入本文件，无循环）。
静态 映射<整64, 整64> 当前函数变量类型;
