// CN 自举编译器 v2：结构化词法器（自举重建 P2，2026-08-25）
// 性能最优架构（对标 rustc/LLVM）第一层：输出结构化 Token 数组，非字符串行。
// 设计：Token {类型码, 文本ID, 行}，文本经 驻留() 得 Symbol ID（O(1) 比较、内容只存一份），
//       单遍字节扫描，标识符/数字/字符串只切一次子串->驻留->ID，零字符串行分配。
导入 容器::向量;

公开:

// ==================== 词法错误计数（280-a T5 v2 拒绝面·2026-09-17） ====================
// \u{} 三态（空转义/超码点/代理区）编译期拒绝的诊断通道：字符码点 三态返回
//   负值 -> 分词主循环 字符字面量分派处 判负 -> 本计数 +1 + 诊断行（带行号）->
//   主.cn 编译文件 解析后聚合进 语法错误数（既有「语法错误数>0 中止」守卫承担
//   编译中止）。跨文件残留=编译文件 出口聚合后清零（对齐 导入项们 取走清空惯例）。
静态 整64 词法错误计数 = 0;

不安全 函数 词法错误加一() -> 空类型 {
    词法错误计数 = 词法错误计数 + 1;
}

函数 取词法错误数() -> 整64 {
    返回 词法错误计数;
}

不安全 函数 清零词法错误数() -> 空类型 {
    词法错误计数 = 0;
}

// ==================== Token 类型码（顶层常量） ====================
常量 令牌_文件结束 = 0;
常量 令牌_标识符 = 1;
常量 令牌_整数字面量 = 2;
常量 令牌_浮点字面量 = 3;
常量 令牌_字符串字面量 = 4;
常量 令牌_字符字面量 = 5;
常量 令牌_关键字 = 6;
常量 令牌_运算符 = 7;
常量 令牌_分隔符 = 8;
常量 令牌_未知 = 9;

// ==================== 结构化 Token ====================
结构体 Token {
    整32 类型;   // 令牌_* 类型码（2026-08-30 复核：宿主整32字段结构体布局/按值传参/向量容器全链路
                //   已验证正确——原 3×整64 是历史规避，现改回标准 4 字节字段）
    整32 文本;   // 字符串驻留 ID（Symbol；0=空）
    整32 行;     // 源行号
}

// ==================== 字节/追加辅助 ====================
函数 字节值(字符串 源码, 整64 位置) -> 整64 {
    // 2026-09-09 ④重做：& 255 位掩码（原 +256 条件修正）——有符号字节读
    //   零扩展惯用式，逐位等价
    返回 整64(源码[位置]) & 255;
}
函数 列表追加(向量<Token> 列表, Token 值) -> 空类型 {
    结果<空类型, 整32> 加 = 列表.追加(值);
    如果 (!加.正常) {
        运行时错误(4);
    }
}
函数 整32追加(向量<整32> 列表, 整32 值) -> 空类型 {
    结果<空类型, 整32> 加 = 列表.追加(值);
    如果 (!加.正常) {
        运行时错误(4);
    }
}

// ==================== 字节分类 ====================
// ==================== 类型布局自检（ABI 调试用） ====================
// 类型大小(结构体) 求得该结构体实例字节数（C++ 版 类型大小 内置）
函数 令牌字节大小() -> 整64 {
    返回 类型大小(Token);
}
函数 是数字字节(整64 字节) -> 布尔 {
    返回 字节 >= 48 && 字节 <= 57;
}
函数 是字母字节(整64 字节) -> 布尔 {
    如果 (字节 >= 128) { 返回 真; }
    返回 (字节 >= 97 && 字节 <= 122) || (字节 >= 65 && 字节 <= 90) || 字节 == 95;
}

// ==================== T21 标识符区段化（311-a=306-b 波次2 v2 侧同构·2026-09-17） ====================
// 「中文」限定=汉字区段（对齐宿主 isIdentifierStartChar/ContChar·方案甲）：
//   CJK 统一表意 19968~40959 + 扩展A 13312~19903 + 扩展B 131072~173791；
//   拒绝全角形式拉丁/中文标点/假名/谚文等非表意字符入标识符。
//   单点口径纪律（306-a OOM 事故教训）：主分发与收集循环共用本判定，
//   续字节（128~191）永不单独判定——按 UTF-8 序列整体推进。
函数 是汉字码点(整64 码点) -> 布尔 {
    返回 (码点 >= 19968 && 码点 <= 40959) ||
           (码点 >= 13312 && 码点 <= 19903) ||
           (码点 >= 131072 && 码点 <= 173791);
}

// T21：源码位置原地解码 UTF-8 首码点（零分配；与 字符码点 多字节分支同构）。
函数 位置码点(字符串 源码, 整64 位置, 整64 长度) -> 整64 {
    整64 b0 = 字节值(源码, 位置);
    如果 (b0 < 128) { 返回 b0; }
    整64 剩余 = 长度 - 位置;
    如果 (b0 >= 240 && 剩余 >= 4) {
        返回 ((b0 & 7) * 262144) + ((字节值(源码, 位置 + 1) & 63) * 4096) +
               ((字节值(源码, 位置 + 2) & 63) * 64) + (字节值(源码, 位置 + 3) & 63);
    }
    如果 (b0 >= 224 && 剩余 >= 3) {
        返回 ((b0 & 15) * 4096) + ((字节值(源码, 位置 + 1) & 63) * 64) +
               (字节值(源码, 位置 + 2) & 63);
    }
    如果 (b0 >= 192 && 剩余 >= 2) {
        返回 ((b0 & 31) * 64) + (字节值(源码, 位置 + 1) & 63);
    }
    返回 b0;
}

// T21：UTF-8 序列长（按首字节；主/收集循环按序列整体推进）。
函数 序列长(整64 首字节) -> 整64 {
    如果 (首字节 >= 240) { 返回 4; }
    如果 (首字节 >= 224) { 返回 3; }
    如果 (首字节 >= 192) { 返回 2; }
    返回 1;
}

// T21：标识符起始判定（单点口径）：ASCII 字母/_ 或 汉字区段码点。
//   原实现「字节 >= 128 全放行」=字符集过宽（行59/60 立案·T21 宿主侧已修）。
函数 是标识符起始(字符串 源码, 整64 位置, 整64 长度) -> 布尔 {
    整64 b = 字节值(源码, 位置);
    如果 ((b >= 97 && b <= 122) || (b >= 65 && b <= 90) || b == 95) { 返回 真; }
    如果 (b >= 128) { 返回 是汉字码点(位置码点(源码, 位置, 长度)); }
    返回 假;
}

函数 是十六进制字节(整64 字节) -> 布尔 {
    返回 是数字字节(字节) || (字节 >= 97 && 字节 <= 102) || (字节 >= 65 && 字节 <= 70);
}

// ==================== 关键字 ID 表（预驻留） ====================
函数 关键字ID表(向量<整32> 表) -> 空类型 {
    整32追加(表, 整32(驻留("如果")));
    整32追加(表, 整32(驻留("否则")));
    整32追加(表, 整32(驻留("当")));
    整32追加(表, 整32(驻留("循环")));
    整32追加(表, 整32(驻留("返回")));
    整32追加(表, 整32(驻留("中断")));
    整32追加(表, 整32(驻留("继续")));
    整32追加(表, 整32(驻留("选择")));
    整32追加(表, 整32(驻留("情况")));
    整32追加(表, 整32(驻留("默认")));
    整32追加(表, 整32(驻留("函数")));
    整32追加(表, 整32(驻留("变量")));
    整32追加(表, 整32(驻留("导入")));
    整32追加(表, 整32(驻留("类")));
    整32追加(表, 整32(驻留("接口")));
    整32追加(表, 整32(驻留("结构体")));
    整32追加(表, 整32(驻留("枚举")));
    整32追加(表, 整32(驻留("联合体")));
    整32追加(表, 整32(驻留("真")));
    整32追加(表, 整32(驻留("假")));
    整32追加(表, 整32(驻留("无")));
    // plans/019 阶段4 第二批（2026-09-10）：安全区边界关键字——v2 语法层
    //   放行 不安全 函数 修饰（语义零处理=观察期 v2 不查边界，仅自举可解析）
    整32追加(表, 整32(驻留("不安全")));
    // 162-a 关键字体系收口（plans/024 §十）：公开/私有/静态/常量/模块/作为
    //   六词移出关键字表（上下文化）——词法层一律产 令牌_标识符，语法层识别点
    //   改 是词()（标识符类别+文本判定）；宿主 keywordTable 同轮删 14 词同构。
}

// 关键字判断：预驻留表线性查（表很小 25 项）
函数 是关键字ID(整32 id, 向量<整32> 表) -> 布尔 {
    整64 i = 0;
    当 (i < 表.大小()) {
        如果 (表.元素(i) == id) { 返回 真; }
        i++;
    }
    返回 假;
}

// ==================== 主扫描：分词 ====================
// 单遍扫描源码 -> 输出 向量<Token>；文本全部驻留为 ID，无字符串行分配
函数 分词(字符串 源码, 向量<Token> 输出) -> 空类型 {
    向量<整32> 关键字表 = 向量<整32>();
    关键字ID表(关键字表);
    整64 位置 = 0;
    整64 行号 = 1;
    整64 长度 = 字符串长度(源码);
    当 (位置 < 长度) {
        整64 字节 = 字节值(源码, 位置);
        // ---- T21（311-a）：UTF-8 BOM（EF BB BF）容忍跳过——文件首字节序标记
        //      非程序内容（对齐宿主「BOM 容忍=口径」·面台账行 60；旧版经
        //      c>=0x80 放行被吞入标识符=事实容忍·区段化后须显式跳过）----
        如果 (字节 == 239 && 位置 + 2 < 长度 &&
             字节值(源码, 位置 + 1) == 187 && 字节值(源码, 位置 + 2) == 191) {
            位置 += 3;
            继续;
        }
        // ---- 空白/换行 ----
        如果 (字节 == 10) { 位置++; 行号++; 继续; }
        如果 (字节 == 32 || 字节 == 9 || 字节 == 13) { 位置++; 继续; }
        // ---- 注释：// 与 /* */ ----
        如果 (字节 == 47 && 位置 + 1 < 长度 && 字节值(源码, 位置 + 1) == 47) {
            位置 += 2;
            当 (位置 < 长度 && 字节值(源码, 位置) != 10) { 位置++; }
            继续;
        }
        如果 (字节 == 47 && 位置 + 1 < 长度 && 字节值(源码, 位置 + 1) == 42) {
            位置 += 2;
            当 (位置 + 1 < 长度 && !(字节值(源码, 位置) == 42 && 字节值(源码, 位置 + 1) == 47)) {
                如果 (字节值(源码, 位置) == 10) { 行号++; }
                位置++;
            }
            如果 (位置 + 1 < 长度) { 位置 += 2; }
            继续;
        }
        // ---- 字符串字面量 "..." ----
        如果 (字节 == 34) {
            位置 = 分词字符串(源码, 位置, 长度, 行号, 输出);
            继续;
        }
        // ---- 字符字面量 ---
        如果 (字节 == 39) {
            整64 起点 = 位置;
            位置++;
            布尔 闭合 = 假;
            当 (位置 < 长度 && 字节值(源码, 位置) != 10) {
                如果 (字节值(源码, 位置) == 39) { 位置++; 闭合 = 真; 中断; }
                如果 (字节值(源码, 位置) == 92 && 位置 + 1 < 长度) { 位置 += 2; 继续; }
                位置++;
            }
            Token tk;
            tk.类型 = 整32(令牌_字符字面量);
            // P7b：剥两端引号（同字符串字面量）
            整64 内容长c = 位置 - 起点 - 1;
            如果 (闭合) { 内容长c = 内容长c - 1; }
            // 95-a（2026-09-13 第九十五轮）：字符字面量 -> **Unicode 码点数字文本**
            //   （规范 01b 三：字符=4 字节 Unicode 标量值；'A'->65 / '中'->20013 /
            //   '\n'->10 / '\u{4E2D}'->20013）——解析/IR 层按整数字面量形态消费
            //   （IR_常量整数 + T_字符），零新 IR/后端设施。
            字符串 内容c = 字符串子串(源码, 起点 + 1, 内容长c);
            // 280-a（T5 v2 拒绝面）：\u{} 三态负值 -> 诊断行 + 词法错误计数 +
            //   FFFD 降级继续（编译中止由主.cn 聚合守卫承担——[parse] 前词法
            //   诊断行独立前置）
            整64 码点c = 字符码点(内容c);
            如果 (码点c < 0) {
                IO::打印到错误("[词法] 行 " + 整数转字符串(行号) +
                               ": 无效的Unicode转义：码点非法（空转义/超码点 U+10FFFF/代理区）\n");
                词法错误加一();
                码点c = 65533;
            }
            tk.文本 = 整32(驻留(整数转字符串(码点c)));
            tk.行 = 整32(行号);
            列表追加(输出, tk);
            继续;
        }
        // ---- 数字字面量 ----
        // ---- 数字字面量 ----
        如果 (是数字字节(字节)) {
            位置 = 分词数字(源码, 位置, 长度, 行号, 输出);
            继续;
        }
        // ---- T21 区段外非 ASCII：词法层拒绝（诊断+计数+按 UTF-8 序列整体跳过，
        //      防碎成多个垃圾 token 下漏语法层——全角拉丁/中文标点/假名等）----
        如果 (字节 >= 128 && !是汉字码点(位置码点(源码, 位置, 长度))) {
            IO::打印到错误("[词法] 行 " + 整数转字符串(行号) +
                ": 标识符区段外字符（T21：仅 CJK 统一表意/扩展A/B 汉字与 ASCII 合法）");
            词法错误加一();
            位置 = 位置 + 序列长(字节);
            继续;
        }
        // ---- 标识符 / 关键字（T21 区段口径：主分发与收集循环共用单点判定） ----
        如果 (是标识符起始(源码, 位置, 长度)) {
            整64 起点 = 位置;
            位置 = 位置 + 序列长(字节值(源码, 位置));
            当 (位置 < 长度) {
                整64 bc = 字节值(源码, 位置);
                如果 (bc < 128) {
                    如果 (!((bc >= 97 && bc <= 122) || (bc >= 65 && bc <= 90) ||
                            bc == 95 || 是数字字节(bc))) { 中断; }
                    位置++;
                } 否则 {
                    // T21：非 ASCII 续入仅汉字区段合法；按序列整体推进
                    如果 (!是汉字码点(位置码点(源码, 位置, 长度))) { 中断; }
                    位置 = 位置 + 序列长(bc);
                }
            }
            整32 id = 整32(驻留(字符串子串(源码, 起点, 位置 - 起点)));
            Token tk;
            tk.类型 = 整32(是关键字ID(id, 关键字表) ? 令牌_关键字 : 令牌_标识符);
            tk.文本 = id;
            tk.行 = 整32(行号);
            列表追加(输出, tk);
            继续;
        }
        // ---- 运算符/分隔符：最长匹配（P6b 控制流需要多字符运算符） ----
        // 双字符优先：== != <= >= && || ++ += -= *= /= %= -> ::（规范 01b 运算符表；
        //   复合赋值五形态 2026-09-03 方案A 裁决补齐——原只有 +=，其余以 - = 双
        //   token 进入解析静默断路）
        // 单字符兜底：+ - * / % < > = ! & | ( ) { } [ ] , . : ; ?（? 三元条件——
        //   ③ 第六波起参与解析；任何未匹配字节兜底切单字符运算符，? 自此可见）
        // 注释：字符 ':' 单独出现时（如 情况 1:）落单字符 ':'；
        //       '->'/'::' 双字符组合必须在 ':' 单字符判断之前匹配。
        位置 = 分词运算符(源码, 位置, 长度, 行号, 输出);
    }
    // 文件结束标记
    Token eof;
    eof.类型 = 整32(令牌_文件结束);
    eof.文本 = 0;
    eof.行 = 整32(行号);
    列表追加(输出, eof);
}

// ==================== 分词分支函数（R3 拆分，2026-09-08 自 分词 机械搬移） ====================
// 各分支收 源码/位置/长度/行号/输出，扫描一种 token 后返回新位置（行号只增不减——
//   字面量/运算符分支不跨行，行号原样传回由主干持有）。输出 向量 按值传（浅共享，
//   追加对调用方可见——关键字ID表 同款先例）。
// 95-a：十六进制字符值（'0'-'9'/'a'-'f'/'A'-'F' -> 0..15；其余 -1）
函数 十六进制值(整64 字节) -> 整64 {
    如果 (字节 >= 48 && 字节 <= 57) { 返回 字节 - 48; }
    如果 (字节 >= 97 && 字节 <= 102) { 返回 字节 - 87; }
    如果 (字节 >= 65 && 字节 <= 70) { 返回 字节 - 55; }
    返回 0 - 1;
}

// 95-a：字符字面量内容 -> Unicode 码点（0=空/非法）。
//   形态（规范 01b 三）：普通字符（ASCII 单字节 / UTF-8 多字节——'中'=0x4E2D）/
//   转义序列（\n=10 \t=9 \r=13 \0=0 \\ \' \"；未知转义取后继字符原样=宿主
//   decodeEscapes 同款）/ Unicode 转义 \u{XXXX}（十六进制标量值，Rust 同语法）。
函数 字符码点(字符串 内容) -> 整64 {
    整64 长 = 字符串长度(内容);
    如果 (长 == 0) { 返回 0; }
    整64 b0 = 整64(内容[0]) & 255;
    如果 (b0 == 92 && 长 >= 2) {
        整64 b1 = 整64(内容[1]) & 255;
        如果 (b1 == 110) { 返回 10; }
        如果 (b1 == 116) { 返回 9; }
        如果 (b1 == 114) { 返回 13; }
        如果 (b1 == 48) { 返回 0; }
        如果 (b1 == 92) { 返回 92; }
        如果 (b1 == 39) { 返回 39; }
        如果 (b1 == 34) { 返回 34; }
        如果 (b1 == 117) {
            // 278-a 立三态校验；280-a（2026-09-17）改负值返回（-3=超限/-4=代理区/
            //   -5=空转义）——诊断通道在位（词法错误计数+分派处诊断行+主.cn
            //   聚合中止守卫），拒绝语义对齐宿主词法（278-a 的 FFFD 归一退役）。
            整64 值u = 0;
            整64 有数字u = 0;
            整64 iu = 2;
            当 (iu < 长) {
                整64 字节u = 整64(内容[iu]) & 255;
                如果 (字节u == 125) { 中断; }
                整64 数u = 十六进制值(字节u);
                如果 (数u >= 0 && 数u < 16) {
                    值u = 值u * 16 + 数u;
                    有数字u = 1;
                }
                iu++;
            }
            如果 (有数字u == 0) { 返回 -5; }
            如果 (值u > 1114111) { 返回 -3; }
            如果 (值u >= 55296 && 值u <= 57343) { 返回 -4; }
            返回 值u;
        }
        返回 b1;
    }
    如果 (b0 < 128) { 返回 b0; }
    如果 (b0 >= 192 && b0 < 224 && 长 >= 2) {
        整64 c1 = 整64(内容[1]) & 255;
        返回 ((b0 & 31) * 64) + (c1 & 63);
    }
    如果 (b0 >= 224 && b0 < 240 && 长 >= 3) {
        整64 c1 = 整64(内容[1]) & 255;
        整64 c2 = 整64(内容[2]) & 255;
        返回 ((b0 & 15) * 4096) + ((c1 & 63) * 64) + (c2 & 63);
    }
    如果 (b0 >= 240 && 长 >= 4) {
        整64 c1 = 整64(内容[1]) & 255;
        整64 c2 = 整64(内容[2]) & 255;
        整64 c3 = 整64(内容[3]) & 255;
        返回 ((b0 & 7) * 262144) + ((c1 & 63) * 4096) + ((c2 & 63) * 64) + (c3 & 63);
    }
    返回 b0;
}

// 96-a：Unicode 码点 -> UTF-8 字节串（宿主 appendUtf8 同口径：1/2/3/4 字节）。
//   字节构造经 runtime `字符转字符串`（__cn_str_from_char，值 0-255 单字节串）
//   逐字节拼接——v2 无字节级字符串构造原语，此法为最小实现（宿主 C++ 直接
//   追加字节；语义等价：UTF-8 编码规则同表）。
函数 码点转UTF8(整64 码点) -> 字符串 {
    如果 (码点 < 128) {
        返回 字符转字符串(码点);
    }
    如果 (码点 < 2048) {
        返回 字符转字符串(192 + (码点 / 64)) +
               字符转字符串(128 + (码点 % 64));
    }
    如果 (码点 < 65536) {
        返回 字符转字符串(224 + (码点 / 4096)) +
               字符转字符串(128 + ((码点 / 64) % 64)) +
               字符转字符串(128 + (码点 % 64));
    }
    返回 字符转字符串(240 + (码点 / 262144)) +
           字符转字符串(128 + ((码点 / 4096) % 64)) +
           字符转字符串(128 + ((码点 / 64) % 64)) +
           字符转字符串(128 + (码点 % 64));
}

// 字符串字面量 "..."：含转义实时反转义（缺陷C根治——\n\t\r\0 及未知转义；
//   快路径无转义单次子串，慢路径逐字节构建）。
函数 分词字符串(字符串 源码, 整64 位置, 整64 长度, 整64 行号, 向量<Token> 输出) -> 整64 {
        整64 起点 = 位置;
        位置++;
        布尔 闭合 = 假;
        当 (位置 < 长度 && 字节值(源码, 位置) != 10) {
            如果 (字节值(源码, 位置) == 34) { 位置++; 闭合 = 真; 中断; }
            如果 (字节值(源码, 位置) == 92 && 位置 + 1 < 长度) { 位置 += 2; 继续; }
            位置++;
        }
        Token tk;
        tk.类型 = 整32(令牌_字符串字面量);
        整64 内容终 = 位置;
        如果 (闭合) { 内容终 = 内容终 - 1; }
        // 缺陷C根治（2026-09-02）：转义实时反转义（对齐宿主 decodeEscapes：
        //   \n=10 \t=9 \r=13 \0=NUL；\" \' \\ 及未知转义取后继字符原样;
        //   （未知保留反斜杠前缀——C 语义，宿主同款）；\u{XXXX} 暂不解码
        //   （v2 无字节级字符串构造能力，③ 前特性补齐轮对齐））。
        //   快路径：无转义（绝大多数）单次子串——性能与原实现一致；
        //   慢路径逐字节构建（控制字符经本文件内转义字面量取得——
        //   宿主编译期已解码为真实字节，自举时 v2 自身（已修复）同样解码，自洽）。
        布尔 含转义 = 假;
        整64 探 = 起点 + 1;
        当 (探 < 内容终) {
            如果 (字节值(源码, 探) == 92) { 含转义 = 真; 中断; }
            探++;
        }
        如果 (!含转义) {
            tk.文本 = 整32(驻留(字符串子串(源码, 起点 + 1, 内容终 - 起点 - 1)));
        } 否则 {
            字符串 内容 = "";
            整64 j = 起点 + 1;
            当 (j < 内容终) {
                整64 字节c = 字节值(源码, j);
                如果 (字节c == 92 && j + 1 < 内容终) {
                    整64 后 = 字节值(源码, j + 1);
                    // 96-a（2026-09-13 第九十六轮 C10）：`\u{XXXX}` Unicode 码点转义
                    //   解码（宿主 decodeEscapes `\u` 分支 + appendUtf8 同口径；
                    //   规范 01b 四字符串字面量）。十六进制解析 -> UTF-8 编码经
                    //   runtime __cn_str_from_char 逐字节拼接（0-255 单字节）。
                    //   非法形态（缺 '{' / 无十六进制位）保留反斜杠原样（宿主同款）。
                    如果 (后 == 117) {
                        整64 值u = 0;
                        布尔 有值u = 假;
                        布尔 有花括号u = 假;
                        整64 k = j + 2;
                        如果 (k < 内容终 && 字节值(源码, k) == 123) {
                            k++;
                            有花括号u = 真;
                            当 (k < 内容终 && 字节值(源码, k) != 125) {
                                整64 数u = 十六进制值(字节值(源码, k));
                                如果 (数u >= 0 && 数u < 16) {
                                    值u = 值u * 16 + 数u;
                                    有值u = 真;
                                }
                                k++;
                            }
                            如果 (k < 内容终 && 字节值(源码, k) == 125) { k++; }
                        }
                        如果 (有值u) {
                            // 281-a（T5 字符串面余项·2026-09-17）：超码点/代理区
                            //   诊断拒绝（词法错误计数复用 280-a 通道·FFFD 降级）
                            如果 (值u > 1114111 || (值u >= 55296 && 值u <= 57343)) {
                                IO::打印到错误("[词法] 行 " + 整数转字符串(行号) +
                                               ": 无效的Unicode转义：码点非法（超码点 U+10FFFF/代理区）\n");
                                词法错误加一();
                                内容 = 内容 + 码点转UTF8(65533);
                            } 否则 {
                                内容 = 内容 + 码点转UTF8(值u);
                            }
                            j = k;
                            继续;
                        }
                        如果 (有花括号u) {
                            // 281-a：空转义（\u{} 有花括号无有效 hex）诊断拒绝
                            IO::打印到错误("[词法] 行 " + 整数转字符串(行号) +
                                           ": 无效的Unicode转义：空转义（须为 Unicode 码点）\n");
                            词法错误加一();
                            内容 = 内容 + 码点转UTF8(65533);
                            j = k;
                            继续;
                        }
                        // 裸 \u（无花括号）：保持保留反斜杠旧语义（非三态面·
                        //   宿主 decodeEscapes 孤立 \u 保留行为对齐）
                        内容 = 内容 + 字符串子串(源码, j, 1);
                        j++;
                        继续;
                    }
                    // 278-a 补齐已知转义表（宿主 decodeEscapes case 全集对齐）：
                    //   \" \\ \' 三形态原由「丢反斜杠取后继」歪打正着覆盖
                    //   （\"→" 碰巧同果），未知转义保留反斜杠后缺口暴露——
                    //   79_v2 固定点 .note.GNU-stack 行分叉实锤
                    如果 (后 == 34) { 内容 = 内容 + 字符转字符串(34); }
                    否则 如果 (后 == 92) { 内容 = 内容 + 字符转字符串(92); }
                    否则 如果 (后 == 39) { 内容 = 内容 + 字符转字符串(39); }
                    否则 如果 (后 == 110) { 内容 = 内容 + 字符串子串("\n", 0, 1); }
                    否则 如果 (后 == 116) { 内容 = 内容 + 字符串子串("\t", 0, 1); }
                    否则 如果 (后 == 114) { 内容 = 内容 + 字符串子串("\r", 0, 1); }
                    否则 如果 (后 == 48) { 内容 = 内容 + 字符串子串("\0", 0, 1); }
                    否则 {
                        // 278-a（T5 连带）：未知转义保留反斜杠原样（"\d"→"\d"
                        //   2 字节）——原实现丢反斜杠只取后继字符，与本函数头注
                        //   「未知保留反斜杠前缀——C 语义，宿主同款」不符（宿主
                        //   decodeEscapes default 分支保留原样）；256 形五实测对齐
                        内容 = 内容 + 字符串子串(源码, j, 2);
                    }
                    j += 2;
                    继续;
                }
                内容 = 内容 + 字符串子串(源码, j, 1);
                j++;
            }
            tk.文本 = 整32(驻留(内容));
        }
        tk.行 = 整32(行号);
        列表追加(输出, tk);
    返回 位置;
}

// 数字字面量：0x 十六进制 / 0b 二进制 / 0o 八进制 / 十进制 + 可选小数/指数/
//   L U 后缀（浮点判定=小数点或指数）。
函数 分词数字(字符串 源码, 整64 位置, 整64 长度, 整64 行号, 向量<Token> 输出) -> 整64 {
    整64 字节 = 字节值(源码, 位置);
    整64 起点 = 位置;
        布尔 浮点 = 假;
        如果 (字节 == 48 && 位置 + 1 < 长度) {
            整64 次 = 字节值(源码, 位置 + 1);
            如果 (次 == 120 || 次 == 88) { 位置 += 2; 当 (位置 < 长度 && 是十六进制字节(字节值(源码, 位置))) { 位置++; } }
            否则 如果 (次 == 98 || 次 == 66) { 位置 += 2; 当 (位置 < 长度 && (字节值(源码, 位置) == 48 || 字节值(源码, 位置) == 49)) { 位置++; } }
            否则 如果 (次 == 111 || 次 == 79) { 位置 += 2; 当 (位置 < 长度 && 字节值(源码, 位置) >= 48 && 字节值(源码, 位置) <= 55) { 位置++; } }
            否则 { 当 (位置 < 长度 && 是数字字节(字节值(源码, 位置))) { 位置++; } }
        } 否则 {
            当 (位置 < 长度 && 是数字字节(字节值(源码, 位置))) { 位置++; }
        }
        如果 (位置 + 1 < 长度 && 字节值(源码, 位置) == 46 && 是数字字节(字节值(源码, 位置 + 1))) {
            浮点 = 真;
            位置 += 2;
            当 (位置 < 长度 && 是数字字节(字节值(源码, 位置))) { 位置++; }
        }
        如果 (位置 < 长度 && (字节值(源码, 位置) == 101 || 字节值(源码, 位置) == 69)) {
            浮点 = 真;
            位置++;
            如果 (位置 < 长度 && (字节值(源码, 位置) == 43 || 字节值(源码, 位置) == 45)) { 位置++; }
            当 (位置 < 长度 && 是数字字节(字节值(源码, 位置))) { 位置++; }
        }
        当 (位置 < 长度) {
            整64 后缀 = 字节值(源码, 位置);
            如果 (后缀 == 76 || 后缀 == 108 || 后缀 == 85 || 后缀 == 117) { 位置++; } 否则 { 中断; }
        }
        Token tk;
        tk.类型 = 整32(浮点 ? 令牌_浮点字面量 : 令牌_整数字面量);
        tk.文本 = 整32(驻留(字符串子串(源码, 起点, 位置 - 起点)));
        tk.行 = 整32(行号);
        列表追加(输出, tk);
    返回 位置;
}

// 运算符/分隔符：三字符（<<= >>=，位复合赋值 2026-09-09）/双字符（== != <= >=
//   && || ++ -- += -= *= /= %= -> :: << >> &= |= ^=——位运算五算子 2026-09-09，
//   规范 01b§5.4）最长匹配优先，未命中切单字符（& | ^ ~ 单字符兜底可见——
//   & 取地址/按位与上下文区分，^ ~ 位运算新可见）。
//   嵌套泛型闭合 '>>'（词法合并单 token）：泛型闭合位置/解析类型文本 按 2 层
//   闭合消费（宿主 H3 同构）——类型位扫描升级与本表同步。
函数 分词运算符(字符串 源码, 整64 位置, 整64 长度, 整64 行号, 向量<Token> 输出) -> 整64 {
    整64 字节 = 字节值(源码, 位置);
    整64 起点 = 位置;
    整64 取长度 = 1;
    如果 (位置 + 2 < 长度) {
        整64 三字节 = 字节值(源码, 位置 + 2);
        如果 (字节 == 60 && 字节值(源码, 位置 + 1) == 60 && 三字节 == 61) { 取长度 = 3; }  // <<=
        否则 如果 (字节 == 62 && 字节值(源码, 位置 + 1) == 62 && 三字节 == 61) { 取长度 = 3; } // >>=
    }
    如果 (取长度 == 1 && 位置 + 1 < 长度) {
        整64 次字节 = 字节值(源码, 位置 + 1);
        如果 (字节 == 61 && 次字节 == 61) { 取长度 = 2; }              // ==
        否则 如果 (字节 == 33 && 次字节 == 61) { 取长度 = 2; }         // !=
        否则 如果 (字节 == 60 && 次字节 == 61) { 取长度 = 2; }         // <=
        否则 如果 (字节 == 62 && 次字节 == 61) { 取长度 = 2; }         // >=
        否则 如果 (字节 == 38 && 次字节 == 38) { 取长度 = 2; }         // &&
        否则 如果 (字节 == 124 && 次字节 == 124) { 取长度 = 2; }       // ||
        否则 如果 (字节 == 43 && 次字节 == 43) { 取长度 = 2; }         // ++
        否则 如果 (字节 == 45 && 次字节 == 45) { 取长度 = 2; }         // --（自减全链 C1：规范 03 语句级 -- 合法；原独缺致 i-- 切双 - 粘连下行）
        否则 如果 (字节 == 43 && 次字节 == 61) { 取长度 = 2; }         // +=
        否则 如果 (字节 == 45 && 次字节 == 61) { 取长度 = 2; }         // -=
        否则 如果 (字节 == 42 && 次字节 == 61) { 取长度 = 2; }         // *=
        否则 如果 (字节 == 47 && 次字节 == 61) { 取长度 = 2; }         // /=
        否则 如果 (字节 == 37 && 次字节 == 61) { 取长度 = 2; }         // %=
        否则 如果 (字节 == 45 && 次字节 == 62) { 取长度 = 2; }         // ->
        否则 如果 (字节 == 58 && 次字节 == 58) { 取长度 = 2; }         // ::
        否则 如果 (字节 == 60 && 次字节 == 60) { 取长度 = 2; }         // <<（位运算 2026-09-09）
        否则 如果 (字节 == 62 && 次字节 == 62) { 取长度 = 2; }         // >>（位运算 2026-09-09；嵌套泛型闭合见 泛型闭合位置）
        否则 如果 (字节 == 38 && 次字节 == 61) { 取长度 = 2; }         // &=
        否则 如果 (字节 == 124 && 次字节 == 61) { 取长度 = 2; }        // |=
        否则 如果 (字节 == 94 && 次字节 == 61) { 取长度 = 2; }         // ^=
    }
    位置 = 位置 + 取长度;
    Token tk;
    tk.类型 = 整32(令牌_运算符);
    tk.文本 = 整32(驻留(字符串子串(源码, 起点, 取长度)));
    tk.行 = 整32(行号);
    列表追加(输出, tk);
    返回 位置;
}
