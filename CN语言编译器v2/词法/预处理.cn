// ==================== 词法预处理：条件编译裁剪（546-a D12·规范 4.7 v2 侧补齐） ====================
// 宿主 src/cn_compiler/lexer/preprocessor.cpp 同构移植（2026-09-16 B2 方案甲规范化的
//   词法层裁剪模型）。要点：
//   1. 逐行扫描源码，识别行首（允许前导空白）'#' 起始的指令行：
//      #定义 宏名 / #如果定义(宏名)〔与空白形式等价〕 / #否则 / #结束如果
//   2. 条件栈（父活/分支已取/活）支持嵌套；父层不活跃时内层 #定义 不生效、
//      内层 #如果定义 恒不激活（C 语义）。
//   3. 被裁剪分支：整行替换为空白但保留换行符——行号与原始源码完全一致，
//      且不产生任何 token（内含语法错误不诊断）。
//   4. 宏=无值旗标：注入宏们=命令行 -D（全局态·跨文件共享）；定义宏们=源内
//      #定义（per-file 局部·对齐宿主 Preprocessor 每文件实例语义）。
//   5. 诊断三态（未知指令/缺宏名/未闭合）=词法错误计数同款全局态模式
//      （诊断行+计数，主.cn 编译文件 聚合守卫中止·不产 IR/asm）。
// 1272 审查 P2 登记豁免：-D argv 解析（扫描定义旗标）暂置词法包（与注入宏状态
//   同文件；迁驱动层会引入驱动→词法的跨层依赖，违背 334 冻结线）。
// 单文件 <=1000 行、单函数 <=100 行约束。

导入 容器::向量;

公开:   // 全文件公开（子模块符号供主流程 经合并全局池解析——532-a 拆分先例同构）


// ==================== 结构体 ====================
结构体 条件帧 {
    布尔 父活;      // 进入本层时外层是否活跃
    布尔 分支已取;  // 本层是否已有分支被选中（#否则 只在未取时可选）
    布尔 活;        // 本层当前分支是否活跃
}

// ==================== 诊断计数（词法错误计数同款全局态） ====================
静态 整64 预处理错误计数 = 0;

不安全 函数 预处理错误加一() -> 空类型 {
    预处理错误计数 = 预处理错误计数 + 1;
}

函数 取预处理错误数() -> 整64 {
    返回 预处理错误计数;
}

不安全 函数 清零预处理错误数() -> 空类型 {
    预处理错误计数 = 0;
}

// ==================== 注入宏（CLI -D·全局态跨文件共享） ====================
// 驻留表截断不变量（1272 P1-5）：注入宏 map/名表持有 intern ID；驻留截断后
//   必须立即 重置注入宏们() 并以字符串快照重建（主.cn 清空程序缓存后残留表）。
// 键=宏名驻留 ID，值=1。主.cn 启动段解析 -D 后经 设注入宏 登记；
// 预处理裁剪 全程只读（跨 主文件/包.cn/导入文件 共享——宿主 macros_ 同语义）。
静态 映射<整64, 整64> 注入宏们;
// 1272：注入宏名平铺（映射无枚举接口——缓存键的 -D/货舱特性集合数据源）
静态 向量<字符串> 注入宏名们;

不安全 函数 设注入宏(整64 宏ID) -> 空类型 {
    结果<空类型, 整32> 设 = 注入宏们.设置(宏ID, 1);
    如果 (!设.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加名 = 注入宏名们.追加(字符串复制(驻留文本(宏ID)));
    如果 (!加名.正常) { 运行时错误(4); }
}

// 清空注入宏（1272：闭包扫描后配合驻留截断——以字符串快照重建同名 ID）
不安全 函数 重置注入宏们() -> 空类型 {
    注入宏们.清空();
    注入宏名们.清空();
}

// 取注入宏名快照（-D + 货舱 [特性]；显式复制落堆，调用方 RAII）
不安全 函数 取注入宏名们() -> 向量<字符串> {
    向量<字符串> 出 = 向量<字符串>();
    整64 i = 0;
    当 (i < 注入宏名们.大小()) {
        结果<空类型, 整32> 加 = 出.追加(字符串复制(注入宏名们.元素(i)));
        如果 (!加.正常) { 运行时错误(4); }
        i++;
    }
    返回 出;
}

// ==================== 指令判定辅助 ====================
// 行首（允许前导空白缩进）是否为 '#'（35）——指令行判定与宿主同口径：
// 行中任意位置的 # 不触发（含字符串字面量内的 #），仅行首缩进后紧邻 #。
函数 是预处理指令行(字符串 源码, 整64 行起, 整64 行终) -> 布尔 {
    整64 p = 行起;
    当 (p < 行终 && (字节值(源码, p) == 32 || 字节值(源码, p) == 9)) { p++; }
    返回 p < 行终 && 字节值(源码, p) == 35;
}

// 指令类型码：1=如果定义 2=结束如果 3=定义 4=否则 0=未知
// 指令体=# 之后的整行内容；按 UTF-8 字节长度前缀比较（先长后短防前缀截断）：
//   "如果定义"=12 字节、"结束如果"=12 字节、"定义"=6 字节、"否则"=6 字节。
// 参串 经 引用参数 回写（关键字之后的剩余内容）。
函数 判定指令(字符串 指令体, 字符串& 参串) -> 整32 {
    整64 p = 0;
    整64 n = 字符串长度(指令体);
    当 (p < n && (字节值(指令体, p) == 32 || 字节值(指令体, p) == 9)) { p++; }
    整64 关键字起 = p;
    // 长关键字先判：如果定义 / 结束如果（12 字节）
    如果 (n >= 关键字起 + 12 && 字符串比较(字符串子串(指令体, 关键字起, 12), "如果定义")) {
        参串 = 字符串子串(指令体, 关键字起 + 12, n - 关键字起 - 12);
        返回 1;
    }
    如果 (n >= 关键字起 + 12 && 字符串比较(字符串子串(指令体, 关键字起, 12), "结束如果")) {
        参串 = 字符串子串(指令体, 关键字起 + 12, n - 关键字起 - 12);
        返回 2;
    }
    如果 (n >= 关键字起 + 6 && 字符串比较(字符串子串(指令体, 关键字起, 6), "定义")) {
        参串 = 字符串子串(指令体, 关键字起 + 6, n - 关键字起 - 6);
        返回 3;
    }
    如果 (n >= 关键字起 + 6 && 字符串比较(字符串子串(指令体, 关键字起, 6), "否则")) {
        参串 = 字符串子串(指令体, 关键字起 + 6, n - 关键字起 - 6);
        返回 4;
    }
    返回 0;
}

// 提取宏名：#如果定义(宏名) / #如果定义 宏名 / #定义 宏名
// 括号形式：'(' 后跳过空白至 ')'（缺 ')' 报错）；宏名=空白/括号/换行 终止的
// 连续段（\r 处理 CRLF 源）。空宏名报错。返回空串=错误已报。
函数 提取宏名(字符串 参串, 整64 行号) -> 字符串 {
    整64 p = 0;
    整64 n = 字符串长度(参串);
    当 (p < n && (字节值(参串, p) == 32 || 字节值(参串, p) == 9)) { p++; }
    整64 名起 = p;
    如果 (p < n && 字节值(参串, p) == 40) {  // '('
        p++;
        当 (p < n && (字节值(参串, p) == 32 || 字节值(参串, p) == 9)) { p++; }
        名起 = p;
        整64 闭 = p;
        当 (闭 < n && 字节值(参串, 闭) != 41) {  // ')'
            闭++;
        }
        如果 (闭 >= n) {
            IO::打印到错误("[预处理] 行 " + 整数转字符串(行号) +
                          ": 条件编译指令缺少 ')'（应形如 #如果定义(宏名)）\n");
            预处理错误加一();
            返回 "";
        }
        n = 闭;  // 宏名终止于 ')'
    }
    整64 名终 = 名起;
    当 (名终 < n) {
        整64 c = 字节值(参串, 名终);
        如果 (c == 32 || c == 9 || c == 13 || c == 10 || c == 40 || c == 41) { 中断; }
        名终++;
    }
    如果 (名终 == 名起) {
        IO::打印到错误("[预处理] 行 " + 整数转字符串(行号) +
                      ": 条件编译指令缺少宏名\n");
        预处理错误加一();
        返回 "";
    }
    返回 字符串子串(参串, 名起, 名终 - 名起);
}

// 宏是否已定义：注入宏（-D）∪ 源内定义宏
函数 宏已定义(字符串 宏名, 映射<整64, 整64>& 定义宏们) -> 布尔 {
    整64 宏ID = 驻留(宏名);
    结果<整64, 整32> 查注入 = 注入宏们.获取(宏ID);
    如果 (查注入.正常) { 返回 真; } 否则 { }
    结果<整64, 整32> 查定义 = 定义宏们.获取(宏ID);
    返回 查定义.正常;
}

// 处理指令行：更新条件栈/定义宏们/活跃态（宿主 handleDirectiveLine 同构）
不安全 函数 处理指令行(字符串 指令体, 整64 行号, 向量<条件帧>& 条件栈,
                      映射<整64, 整64>& 定义宏们, 布尔& 活跃) -> 空类型 {
    字符串 参串 = "";
    整32 指令 = 判定指令(指令体, 参串);
    如果 (指令 == 3) {  // #定义
        // 仅父层活跃时定义宏；被裁剪分支内 #定义 不生效（C 语义）
        如果 (活跃) {
            字符串 宏名 = 提取宏名(参串, 行号);
            如果 (字符串长度(宏名) > 0) {
                结果<空类型, 整32> 设 = 定义宏们.设置(驻留(宏名), 1);
                如果 (!设.正常) { 运行时错误(4); }
            }
        }
    } 否则 如果 (指令 == 1) {  // #如果定义
        布尔 父活 = 活跃;
        布尔 定 = 父活 && 宏已定义(提取宏名(参串, 行号), 定义宏们);
        条件帧 帧;
        帧.父活 = 父活;
        帧.分支已取 = 定;
        帧.活 = 父活 && 定;
        结果<空类型, 整32> 追 = 条件栈.追加(帧);
        如果 (!追.正常) { 运行时错误(4); }
        活跃 = 父活 && 定;
    } 否则 如果 (指令 == 4) {  // #否则
        如果 (条件栈.大小() == 0) {
            IO::打印到错误("[预处理] 行 " + 整数转字符串(行号) +
                          ": #否则 前缺少 #如果定义\n");
            预处理错误加一();
            返回;
        }
        条件帧 尾帧 = 条件栈.元素(条件栈.大小() - 1);
        如果 (尾帧.父活 && !尾帧.分支已取) {
            尾帧.分支已取 = 真;
            尾帧.活 = 真;
            活跃 = 真;
        } 否则 {
            活跃 = 假;
        }
        结果<空类型, 整32> 设尾 = 条件栈.设置(条件栈.大小() - 1, 尾帧);
        如果 (!设尾.正常) { 运行时错误(4); }
    } 否则 如果 (指令 == 2) {  // #结束如果
        如果 (条件栈.大小() == 0) {
            IO::打印到错误("[预处理] 行 " + 整数转字符串(行号) +
                          ": #结束如果 前缺少 #如果定义\n");
            预处理错误加一();
            返回;
        }
        结果<空类型, 整32> 删 = 条件栈.删除(条件栈.大小() - 1);
        如果 (!删.正常) { 运行时错误(4); }
        // 恢复父层活跃状态（嵌套块结束后回到外层分支上下文）
        如果 (条件栈.大小() == 0) {
            活跃 = 真;
        } 否则 {
            条件帧 外层 = 条件栈.元素(条件栈.大小() - 1);
            活跃 = 外层.活;
        }
    } 否则 {  // 未知指令（含 #包含 等不支持形态——规范 4.7 能力边界）
        IO::打印到错误("[预处理] 行 " + 整数转字符串(行号) +
                      ": 未知预处理指令: " + 字符串复制(指令体) + "\n");
        预处理错误加一();
    }
}

// 被裁剪行的空白替换串（保留行宽·保换行由主循环负责）
函数 空白串(整64 个数) -> 字符串 {
    字符串 空串 = "";
    整64 i = 0;
    当 (i < 个数) {
        空串 = 空串 + " ";
        i++;
    }
    返回 空串;
}

// 快速判定：源码是否含预处理指令行（零分配·字节级逐行扫描）。
//   v2 自举树与绝大多数用户源码零 # 指令——据此走快路径直通（见 主入口），
//   裁剪重建的字符串拼接成本与 arena 中间串留存对零指令文件归零（546-a 实测：
//   无快路径时全树编译 arena 峰值破 4GB RLIMIT——std::bad_alloc；有快路径后
//   零指令文件零额外分配，性能与内存双回旧基线）。
函数 源码含预处理指令(字符串 源码) -> 布尔 {
    整64 总长 = 字符串长度(源码);
    整64 行起 = 0;
    当 (行起 < 总长) {
        整64 行终 = 行起;
        当 (行终 < 总长 && 字节值(源码, 行终) != 10) { 行终++; }
        如果 (是预处理指令行(源码, 行起, 行终)) { 返回 真; }
        行起 = 行终 + 1;
    }
    返回 假;
}

// ==================== 主入口：按条件编译指令裁剪源码（保留行号与换行） ====================
// 返回裁剪后源码：指令行→空行（保换行）；活跃行→原文；被裁行→等宽空白。
// per-file 语义：条件栈与源内定义宏为本函数局部（宿主 Preprocessor 每文件
// 实例同构）；注入宏们（-D）为跨文件全局态。
不安全 函数 预处理裁剪(字符串 源码) -> 字符串 {
    // 快路径（零成本抽象）：无指令文件=裁剪恒等变换→原样直通，零拷贝零分配。
    //   含指令文件（如 24 用例·行数小）才走逐行重建慢路径。
    // 无指令文件=裁剪恒等变换→显式拷贝直通（O(n) 单次分配；安全区契约=
    //   返回拥有串须落堆——检查器推荐路径·较逐行重建省去全部中间串）
    如果 (!源码含预处理指令(源码)) { 返回 字符串复制(源码); }
    字符串 输出 = "";
    整64 总长 = 字符串长度(源码);
    向量<条件帧> 条件栈 = 向量<条件帧>();
    映射<整64, 整64> 定义宏们 = 映射<整64, 整64>();
    布尔 活跃 = 真;
    整64 行号 = 1;
    整64 行起 = 0;
    当 (行起 < 总长) {
        // 行尾定位（不含换行符；\r 留在行内容——CRLF 由宏名终止集与原样保留消化）
        整64 行终 = 行起;
        当 (行终 < 总长 && 字节值(源码, 行终) != 10) { 行终++; }
        如果 (是预处理指令行(源码, 行起, 行终)) {
            // 指令行：消费不产 token——输出空行保行号；'#' 后内容交指令处理
            整64 井位 = 行起;
            当 (字节值(源码, 井位) != 35) { 井位++; }
            字符串 指令体 = 字符串子串(源码, 井位 + 1, 行终 - 井位 - 1);
            处理指令行(指令体, 行号, 条件栈, 定义宏们, 活跃);
            输出 = 输出 + "\n";
        } 否则 {
            如果 (活跃) {
                输出 = 输出 + 字符串子串(源码, 行起, 行终 - 行起);
            } 否则 {
                输出 = 输出 + 空白串(行终 - 行起);
            }
            输出 = 输出 + "\n";
        }
        行号++;
        行起 = 行终 + 1;
    }
    // 未闭合条件块：报错（位置=文件末·宿主同口径）
    如果 (条件栈.大小() > 0) {
        IO::打印到错误("[预处理] 行 " + 整数转字符串(行号) +
                      ": #如果定义 缺少匹配的 #结束如果\n");
        预处理错误加一();
    }
        返回 输出;
}

// -D 注入宏旗标扫描（1272 自主.cn 机械搬移·546-a D12·宿主 cn_main -D 同构：
//   `-D 宏名` 空格分隔两参数·可多次）：命中即 驻留 登记 注入宏们（预处理全局态）。
//   形态=`-D` 后跟宏名参数；缺宏名参数=诊断+返回 假（调用方退出 1——宿主
//   「选项 -D 缺少宏名参数」同款拒绝语义）；非 -D 参数忽略（各安其位）。
函数 扫描定义旗标() -> 布尔 {
    整64 序 = 1;
    当 (序 < 系统::参数个数()) {
        字符* 参数文本 = 系统::参数(序);
        如果 (参数文本 != 无) {
            字符串 值 = 字符串复制(参数文本);   // 借用→显式复制（A2 收紧）
            如果 (字符串比较(值, "-D")) {
                如果 (序 + 1 >= 系统::参数个数()) {
                    IO::打印到错误("错误: 选项 -D 缺少宏名参数\n");
                    返回 假;
                }
                字符* 宏文本 = 系统::参数(序 + 1);
                如果 (宏文本 == 无) {
                    IO::打印到错误("错误: 选项 -D 缺少宏名参数\n");
                    返回 假;
                }
                设注入宏(驻留(字符串复制(宏文本)));
                序++;
            }
        }
        序++;
    }
    返回 真;
}
