// 代码生成ARM64窥孔（任务 1319·v2 侧·2026-10-25）
// 职责：linux-arm64 函数段发射后的行级窥孔——1157 固定帧槽转发 + 1243 大偏移
//   间接寻址整体消除（宿主 src/cn_compiler/codegen/peephole_slot_arm64.cpp 同源判据）。
//
// 产物形态（本后端 v2 GAS 发射族，见 代码生成ARM64.cn 读槽/写槽/槽地址）：
//   直寻：str/ldr x9, [x29, #-8]（负向 ldur/stur imm9、正向 ldr/str imm12）
//   间接：sub x13, x29, #600 / str x9, [x13] / sub x13, x29, #600 / ldr x9, [x13]
//         |off|>4095 时物化块=movz/movk 链 + sub/add x13, x29, x13（块长 2..5 行）。
//         地址临时寄存器恒 x13（槽地址硬编码·宿主同约定）。
//
// 规则一·固定帧槽转发（1157）：相邻（中间仅注释/空行）store→load 同槽对，且
//   槽偏移在整个函数段中恰好出现两次（=本对两行）时：
//     · 同寄存器同族且均 64 位 → 两行全删；
//     · 否则 → 删 store、load 改写为寄存器搬运（读宽≤存宽；符号/零扩展取
//       sxtb/sxth/uxth/uxtb、浮点 fmov、整数 mov）。
// 安全判据（缺一不可）：
//   ① 两行之间只有注释/空行（无指令——无中间值改写）；
//   ② 槽全段恰好两处——不能用「本对之后无出现」：循环回边可从后文跳回前文再读槽
//      （行号=代码位置非执行序）；任意路径执行 load 必先经 store；
//   ③ 读宽 ≤ 存宽（存窄读宽时 load 高位来自槽内残留，寄存器搬运不可复现）；
//   ④ 整数/浮点族不得混；
//   ⑤ 解析失败一律跳过（该行原样保留，不参与消除）。
//   32 位整数同槽同宽对（需高位零证明）不在本产物族：本后端写槽只发 x/d/s 三形
//   （无 w 形写槽），故无该形态；s 宽 32 浮点因 LDR Sd 清高位语义不可用空改写
//   复现，保 fmov 改写（宿主 fullDeleteArm 同判据）。
//
// 规则二·大偏移间接寻址（1243）：|off|>255 时 x13 物化块 + store + 逐行同文物化块
//   + load 四段整体消除：
//     · 全删 = 同寄存器同族且存读均 64 位；否则 load 改写为寄存器搬运；
//     · 两块 + store 删除（块①在 store 前、块②在 store 后，两块之间允许注释/空行）。
// 安全判据（缺一不可·显式拒绝，不满足即原样保留）：
//   ① 两块文本逐行相同（同输入 x29、纯 movz/movk/sub/add 立即数 ⇒ 同地址）；
//   ② 该 x29±N 偏移在全函数段的「x29 相对引用」中恰好出现 2 次（=两块）——
//      无其它读写/取址（含不同寄存器物化同址、直接 [x29,#N]）；
//   ③ 尾部无残留依赖：删除后 x13 旧值不得被读——从本对之后线性扫描，任何 x13
//      读取（movk 读改写/自引用尾/内存访问）之前必须出现完整定义（movz 或
//      x29±立即数）；标签行=新入口重置定义态（两态 safe0/safe1 逆序预计算 O(n)）；
//   ④ store 源/load 目的不得是地址寄存器（否则删除物化块后读到无定义值）；
//   ⑤ 宽度/浮点判据与固定帧槽同规则（读宽≤存宽·跨族拒绝）。
//
// 段登记与压缩（照 代码生成X64Linux尾.cn 1158 模式）：全部函数生成完成后一次性
//   统计/标记，最后全模块 O(总行数) 压缩（生成期以 输出.大小() 命名的标签依赖
//   行号全局唯一，段内即时压缩会撞名）。
// 门控：恒开（与 代码生成X64Linux窥孔.cn 同口径：v2 发射即最终产物·无宿主
//   regAlloc 开关；宿主 -O2 面同构）。
// 通用行扫描/向量辅助见 代码生成窥孔文本.cn（1319 外提·两后端窥孔共用）。
// 1319 体量拆分：大偏移间接寻址面（物化块解析/x13 安全表/间接标记/段调度）
//   在 代码生成ARM64窥孔间接.cn——本文件只含通用解析与固定帧槽面，
//   不引用后者（加载顺序：本文件 → 代码生成ARM64窥孔间接.cn → 代码生成ARM64尾.cn）。
导入 容器::向量;
导入 协议常量;   // 位模式合成474/位模式取负474（物化块偏移组合·检查安全）

公开:

// 槽访问解析结果（解析成功时逐字段填写；失败时调用方不读）
结构体 ARM窥孔槽访问 {
    整64 槽键;      // 直寻偏移；间接形态恒 0（不参与比较·由 间接 分流）
    整64 寄存器号;  // 0..31
    整64 寄存器形;  // 0=x 1=w 2=d 3=s
    整64 宽;        // 8/16/32/64
    布尔 浮点;
    布尔 符号扩展;
    布尔 零扩展;
    布尔 间接;      // 基址 x13（大偏移间接寻址）
}

// ==================== 寄存器名解析/生成 ====================

// AArch64 寄存器 token -> 形（0=x 1=w 2=d 3=s）/编号（0..31）；识别失败返回 假
//   形字符闭集 x/w/d/s；编号两位内（x31 上限）。
函数 ARM窥孔寄存器形号(字符串 行, 整64 起, 整64 终, 整64& 形, 整64& 号) -> 布尔 {
    整64 净终 = 终;
    当 (净终 > 起) {
        整64 尾字节 = 整64(行[净终 - 1]);
        布尔 尾空白 = (尾字节 == 32 || 尾字节 == 9 || 尾字节 == 13);
        如果 (尾空白) { 净终--; }
        如果 (尾空白 == 假) { 中断; }
    }
    整64 长 = 净终 - 起;
    布尔 长度合法 = (长 >= 2 && 长 <= 3);
    如果 (长度合法 == 假) { 返回 假; }
    整64 首字节 = 整64(行[起]);
    整64 形值 = 0;
    布尔 形成 = 假;
    如果 (首字节 == 120) { 形值 = 0; 形成 = 真; }
    如果 (首字节 == 119) { 形值 = 1; 形成 = 真; }
    如果 (首字节 == 100) { 形值 = 2; 形成 = 真; }
    如果 (首字节 == 115) { 形值 = 3; 形成 = 真; }
    如果 (形成 == 假) { 返回 假; }
    整64 号值 = 0;
    整64 i = 起 + 1;
    当 (i < 净终) {
        整64 d = 整64(行[i]);
        布尔 数字 = (d >= 48 && d <= 57);
        如果 (数字 == 假) { 返回 假; }
        号值 = 号值 * 10 + (d - 48);
        i++;
    }
    布尔 号合法 = (号值 >= 0 && 号值 <= 31);
    如果 (号合法 == 假) { 返回 假; }
    形 = 形值;
    号 = 号值;
    返回 真;
}

// 形/编号 -> 寄存器名（调用方保证 形∈0..3 / 号∈0..31；越界=内部契约破坏显形）
函数 ARM窥孔寄存器名(整64 形, 整64 号) -> 字符串 {
    字符串 前缀 = "";
    如果 (形 == 0) { 前缀 = "x"; }
    否则 如果 (形 == 1) { 前缀 = "w"; }
    否则 如果 (形 == 2) { 前缀 = "d"; }
    否则 如果 (形 == 3) { 前缀 = "s"; }
    布尔 形合法 = (形 >= 0 && 形 <= 3);
    布尔 号合法 = (号 >= 0 && 号 <= 31);
    如果 (形合法 == 假 || 号合法 == 假) { 运行时错误(4); }
    返回 前缀 + 整数转字符串(号);
}

// 行内是否出现寄存器 token（前后边界非标识符字符）——x13 依赖扫描用
函数 ARM窥孔含寄存器(字符串 行, 字符串 名) -> 布尔 {
    整64 行长 = 字符串长度(行);
    整64 名长 = 字符串长度(名);
    整64 位置 = 0;
    当 (位置 + 名长 <= 行长) {
        布尔 同位 = 窥孔子串比较(行, 位置, 名);
        如果 (同位) {
            布尔 左好 = (位置 == 0);
            如果 (左好 == 假) {
                整64 左字节 = 整64(行[位置 - 1]);
                布尔 左标 = (左字节 >= 48 && 左字节 <= 57) ||
                            (左字节 >= 65 && 左字节 <= 90) ||
                            (左字节 >= 97 && 左字节 <= 122) ||
                            (左字节 == 95);
                如果 (左标 == 假) { 左好 = 真; }
            }
            布尔 右好 = 真;
            整64 右位 = 位置 + 名长;
            如果 (右位 < 行长) {
                整64 右字节 = 整64(行[右位]);
                布尔 右标 = (右字节 >= 48 && 右字节 <= 57) ||
                            (右字节 >= 65 && 右字节 <= 90) ||
                            (右字节 >= 97 && 右字节 <= 122) ||
                            (右字节 == 95);
                如果 (右标) { 右好 = 假; }
            }
            如果 (左好 && 右好) { 返回 真; }
        }
        位置++;
    }
    返回 假;
}

// ==================== 槽 token 解析 ====================

// 解析行内槽 token（起=“[" 索引）：[x29] / [x29, #±N] / [x13]（宿主无空格形态同接受）
//   返回 槽键（直寻偏移）、间接标志、槽右括号索引。形态不符返回 假。
//   间接形态不接受偏移（本产物族 x13 访问恒 [x13]，带偏移即非本形态）。
函数 ARM窥孔解析槽(字符串 行, 整64 起, 整64& 槽键, 布尔& 间接, 整64& 右) -> 布尔 {
    槽键 = 0;
    间接 = 假;
    右 = 0;
    布尔 直基 = 窥孔子串比较(行, 起, "[x29");
    布尔 间基 = 窥孔子串比较(行, 起, "[x13");
    如果 (直基 == 假 && 间基 == 假) { 返回 假; }
    整64 基尾 = 起 + 4;
    可选<整64> 右查 = 窥孔找字符(行, ']', 基尾);
    整64 右位 = 0;
    如果 (右查.有值) { 右位 = 右查.值; }
    如果 (右查.有值 == 假) { 返回 假; }
    如果 (间基) {
        如果 (右位 != 基尾) { 返回 假; }
        间接 = 真;
        右 = 右位;
        返回 真;
    }
    如果 (右位 == 基尾) {
        右 = 右位;
        返回 真;
    }
    整64 位 = 窥孔跳空白(行, 基尾);
    如果 (位 >= 右位) { 返回 假; }
    如果 (整64(行[位]) != 44) { 返回 假; }
    位 = 窥孔跳空白(行, 位 + 1);
    如果 (位 >= 右位) { 返回 假; }
    如果 (整64(行[位]) != 35) { 返回 假; }
    位++;
    位 = 窥孔跳空白(行, 位);
    布尔 负 = 假;
    如果 (位 < 右位) {
        布尔 负号 = (整64(行[位]) == 45);
        如果 (负号) { 负 = 真; 位++; }
    }
    整64 值 = 0;
    布尔 有数 = 假;
    当 (位 < 右位) {
        整64 d = 整64(行[位]);
        布尔 数字 = (d >= 48 && d <= 57);
        如果 (数字 == 假) { 返回 假; }
        值 = 值 * 10 + (d - 48);
        布尔 未超界 = (值 >= 0 && 值 <= 100000000000000000);
        如果 (未超界 == 假) { 返回 假; }
        有数 = 真;
        位++;
    }
    如果 (有数 == 假) { 返回 假; }
    如果 (负) { 槽键 = 0 - 值; }
    否则 如果 (负 == 假) { 槽键 = 值; }
    右 = 右位;
    返回 真;
}

// ==================== 访存行解析（str 族 / ldr 族共用单点） ====================

// 解析访存行：存=真 -> str/strb/strh；存=假 -> ldr/ldrb/ldrh/ldrsb/ldrsh
//   reg, [x29, #±N] / [x13]；宽度/浮点/扩展语义按助记符族与寄存器形分派。
//   族码：0=普通（str/ldr） 1=b（8 位） 2=h（16 位） 3=sb（8 位符号） 4=sh（16 位符号）
函数 ARM窥孔解析访存行(字符串 行, 布尔 存, ARM窥孔槽访问& 访问) -> 布尔 {
    访问.槽键 = 0; 访问.寄存器号 = 0; 访问.寄存器形 = 0; 访问.宽 = 0;
    访问.浮点 = 假; 访问.符号扩展 = 假; 访问.零扩展 = 假; 访问.间接 = 假;
    整64 长 = 字符串长度(行);
    整64 起 = 窥孔跳空白(行, 0);
    整64 名终 = 窥孔记号终(行, 起);
    整64 名长 = 名终 - 起;
    整64 族 = 0;
    布尔 助记成 = 假;
    如果 (存 && 名长 == 3 && 窥孔区间比较(行, 起, 名终, "str")) { 助记成 = 真; 族 = 0; }
    否则 如果 (存 && 名长 == 4 && 窥孔区间比较(行, 起, 名终, "strb")) { 助记成 = 真; 族 = 1; }
    否则 如果 (存 && 名长 == 4 && 窥孔区间比较(行, 起, 名终, "strh")) { 助记成 = 真; 族 = 2; }
    否则 如果 (存 == 假 && 名长 == 3 && 窥孔区间比较(行, 起, 名终, "ldr")) { 助记成 = 真; 族 = 0; }
    否则 如果 (存 == 假 && 名长 == 4 && 窥孔区间比较(行, 起, 名终, "ldrb")) { 助记成 = 真; 族 = 1; }
    否则 如果 (存 == 假 && 名长 == 4 && 窥孔区间比较(行, 起, 名终, "ldrh")) { 助记成 = 真; 族 = 2; }
    否则 如果 (存 == 假 && 名长 == 5 && 窥孔区间比较(行, 起, 名终, "ldrsb")) { 助记成 = 真; 族 = 3; }
    否则 如果 (存 == 假 && 名长 == 5 && 窥孔区间比较(行, 起, 名终, "ldrsh")) { 助记成 = 真; 族 = 4; }
    否则 如果 (助记成 == 假) { 返回 假; }
    整64 位置 = 窥孔跳空白(行, 名终);
    可选<整64> 逗查 = 窥孔找字符(行, ',', 位置);
    整64 逗 = 0;
    如果 (逗查.有值) { 逗 = 逗查.值; }
    如果 (逗查.有值 == 假) { 返回 假; }
    整64 形 = 0;
    整64 号 = 0;
    布尔 寄存器成 = ARM窥孔寄存器形号(行, 位置, 逗, 形, 号);
    如果 (寄存器成 == 假) { 返回 假; }
    整64 宽 = 0;
    布尔 浮点 = 假;
    布尔 符号 = 假;
    布尔 零 = 假;
    如果 (族 == 0) {
        布尔 是64 = (形 == 0 || 形 == 2);
        布尔 是32 = (形 == 1 || 形 == 3);
        如果 (是64) { 宽 = 64; }
        否则 如果 (是32) { 宽 = 32; }
        布尔 浮点形 = (形 == 2 || 形 == 3);
        如果 (浮点形) { 浮点 = 真; }
    }
    否则 如果 (族 == 1 && 形 == 1) { 宽 = 8; 零 = (存 == 假); }
    否则 如果 (族 == 1 && 形 != 1) { 返回 假; }
    否则 如果 (族 == 2 && 形 == 1) { 宽 = 16; 零 = (存 == 假); }
    否则 如果 (族 == 2 && 形 != 1) { 返回 假; }
    否则 如果 (族 == 3 && (形 == 0 || 形 == 1)) { 宽 = 8; 符号 = 真; }
    否则 如果 (族 == 3 && (形 == 2 || 形 == 3)) { 返回 假; }
    否则 如果 (族 == 4 && (形 == 0 || 形 == 1)) { 宽 = 16; 符号 = 真; }
    否则 如果 (族 == 4 && (形 == 2 || 形 == 3)) { 返回 假; }
    整64 槽起 = 窥孔跳空白(行, 逗 + 1);
    整64 槽键 = 0;
    布尔 间接 = 假;
    整64 右 = 0;
    布尔 槽成 = ARM窥孔解析槽(行, 槽起, 槽键, 间接, 右);
    如果 (槽成 == 假) { 返回 假; }
    整64 尾 = 窥孔跳空白(行, 右 + 1);
    如果 (尾 != 长) { 返回 假; }
    访问.槽键 = 槽键;
    访问.寄存器号 = 号;
    访问.寄存器形 = 形;
    访问.宽 = 宽;
    访问.浮点 = 浮点;
    访问.符号扩展 = 符号;
    访问.零扩展 = 零;
    访问.间接 = 间接;
    返回 真;
}

// 注释/空行判定（配对可跨过的无执行语义行；v2 产物每 IR 指令前有 // op=N 注释）
函数 ARM窥孔是注释或空(字符串 行) -> 布尔 {
    整64 长 = 字符串长度(行);
    整64 起 = 窥孔跳空白(行, 0);
    如果 (起 >= 长) { 返回 真; }
    布尔 双斜 = 窥孔子串比较(行, 起, "//");
    布尔 分号 = 窥孔子串比较(行, 起, ";");
    布尔 块注 = 窥孔子串比较(行, 起, "/*") || 窥孔子串比较(行, 起, "*");
    返回 双斜 || 分号 || 块注;
}

// 标签行判定（跳空白后末字符 ':'）——尾部安全表的新入口重置点
函数 ARM窥孔是标签(字符串 行) -> 布尔 {
    整64 长 = 字符串长度(行);
    整64 起 = 窥孔跳空白(行, 0);
    如果 (起 >= 长) { 返回 假; }
    如果 (整64(行[长 - 1]) != 58) { 返回 假; }
    返回 真;
}

// ==================== 改写与全删判据 ====================

// 全删判据：同寄存器同族且存读均 64 位（宿主 fullDeleteArm 逐条同构）
//   s/d 宽 32 浮点不全删：LDR Sd 清零寄存器高位的语义无法用空改写复现，保 fmov。
函数 ARM窥孔可全删(ARM窥孔槽访问 存, ARM窥孔槽访问 载) -> 布尔 {
    布尔 同号 = (存.寄存器号 == 载.寄存器号);
    布尔 同族 = (存.浮点 == 载.浮点);
    布尔 均64 = (存.宽 == 64 && 载.宽 == 64);
    返回 同号 && 同族 && 均64;
}

// 改写 load 行为从 store 源寄存器取值的寄存器搬运（调用方保证 读宽≤存宽）
//   源形态按读宽取：64=x/d，8/16/32=w/s（宿主 rewriteArmLoad 逐条同构）
函数 ARM窥孔改写装载行(ARM窥孔槽访问 存, ARM窥孔槽访问 载) -> 字符串 {
    整64 源形 = 0;
    如果 (载.浮点) {
        如果 (载.宽 == 64) { 源形 = 2; }
        否则 如果 (载.宽 == 32) { 源形 = 3; }
        否则 如果 (载.宽 == 0) { 运行时错误(4); }
    }
    否则 如果 (载.浮点 == 假) {
        如果 (载.宽 == 64) { 源形 = 0; }
        否则 如果 (载.宽 == 32 || 载.宽 == 16 || 载.宽 == 8) { 源形 = 1; }
        否则 如果 (载.宽 == 0) { 运行时错误(4); }
    }
    字符串 源名 = ARM窥孔寄存器名(源形, 存.寄存器号);
    字符串 目的名 = ARM窥孔寄存器名(载.寄存器形, 载.寄存器号);
    如果 (载.符号扩展) {
        字符串 助记 = "sxth";
        如果 (载.宽 == 8) { 助记 = "sxtb"; }
        返回 "    " + 助记 + " " + 目的名 + ", " + 源名;
    }
    如果 (载.零扩展) {
        字符串 助记2 = "uxth";
        如果 (载.宽 == 8) { 助记2 = "uxtb"; }
        返回 "    " + 助记2 + " " + 目的名 + ", " + 源名;
    }
    如果 (载.浮点) { 返回 "    fmov " + 目的名 + ", " + 源名; }
    返回 "    mov " + 目的名 + ", " + 源名;
}

// ==================== 地址物化块解析（大偏移间接寻址面） ====================

// 操作数提取：从 起 取第 序 个逗号分隔操作数（0 基），去两侧空白。
//   返回区间 [出起, 出终)；操作数不足返回 假。
函数 ARM窥孔操作数(字符串 行, 整64 起, 整64 序, 整64& 出起, 整64& 出终) -> 布尔 {
    出起 = 0;
    出终 = 0;
    整64 长 = 字符串长度(行);
    整64 位 = 起;
    整64 序i = 0;
    当 (序i <= 序) {
        整64 记号起 = 窥孔跳空白(行, 位);
        如果 (记号起 >= 长) { 返回 假; }
        可选<整64> 逗查 = 窥孔找字符(行, ',', 记号起);
        整64 记号终 = 长;
        如果 (逗查.有值) { 记号终 = 逗查.值; }
        整64 净终 = 记号终;
        当 (净终 > 记号起) {
            整64 尾字节 = 整64(行[净终 - 1]);
            布尔 尾空白 = (尾字节 == 32 || 尾字节 == 9 || 尾字节 == 13);
            如果 (尾空白) { 净终--; }
            如果 (尾空白 == 假) { 中断; }
        }
        如果 (序i == 序) { 出起 = 记号起; 出终 = 净终; 返回 真; }
        如果 (逗查.有值 == 假) { 返回 假; }
        位 = 记号终 + 1;
        序i++;
    }
    返回 假;
}

// 立即数 token "#<digits>"（可选 '-'；构造器发射非负）-> 数值；形态不符返回 假
函数 ARM窥孔立即数值(字符串 行, 整64 起, 整64 终, 整64& 值) -> 布尔 {
    值 = 0;
    布尔 域合法 = (起 >= 0 && 起 <= 终 && 终 <= 字符串长度(行));
    如果 (域合法 == 假) { 返回 假; }
    如果 (起 >= 终) { 返回 假; }
    如果 (整64(行[起]) != 35) { 返回 假; }
    整64 位 = 起 + 1;
    布尔 负 = 假;
    如果 (位 < 终) {
        布尔 负号 = (整64(行[位]) == 45);
        如果 (负号) { 负 = 真; 位++; }
    }
    整64 数 = 0;
    布尔 有数 = 假;
    当 (位 < 终) {
        整64 d = 整64(行[位]);
        布尔 数字 = (d >= 48 && d <= 57);
        如果 (数字 == 假) { 返回 假; }
        数 = 数 * 10 + (d - 48);
        布尔 未超界 = (数 >= 0 && 数 <= 100000000000000000);
        如果 (未超界 == 假) { 返回 假; }
        有数 = 真;
        位++;
    }
    如果 (有数 == 假) { 返回 假; }
    如果 (负) { 值 = 0 - 数; }
    否则 如果 (负 == 假) { 值 = 数; }
    返回 真;
}

// 移位 token "lsl #S"（S 闭集 0/16/32/48——movz/movk 片位）；形态不符返回 假
函数 ARM窥孔移位值(字符串 行, 整64 起, 整64 终, 整64& 移位) -> 布尔 {
    移位 = 0;
    整64 长 = 终 - 起;
    布尔 长度合法 = (长 >= 5 && 长 <= 8);
    如果 (长度合法 == 假) { 返回 假; }
    布尔 前缀 = 窥孔区间比较(行, 起, 起 + 4, "lsl ");
    如果 (前缀 == 假) { 返回 假; }
    如果 (整64(行[起 + 4]) != 35) { 返回 假; }
    整64 数 = 0;
    布尔 有数 = 假;
    整64 位 = 起 + 5;
    当 (位 < 终) {
        整64 d = 整64(行[位]);
        布尔 数字 = (d >= 48 && d <= 57);
        如果 (数字 == 假) { 返回 假; }
        数 = 数 * 10 + (d - 48);
        有数 = 真;
        位++;
    }
    如果 (有数 == 假) { 返回 假; }
    布尔 枚举内 = (数 == 0 || 数 == 16 || 数 == 32 || 数 == 48);
    如果 (枚举内 == 假) { 返回 假; }
    移位 = 数;
    返回 真;
}


// 槽键在全段出现次数是否恰为 2（=本对两行·槽死判定严格口径）
函数 ARM窥孔槽仅两处(映射<整64, 整64> 计数, 整64 键) -> 布尔 {
    布尔 有 = 计数.包含(键);
    如果 (有 == 假) { 返回 假; }
    结果<整64, 整32> 查 = 计数.获取(键);
    如果 (查.正常) { 返回 查.值 == 2; }
    运行时错误(4);
    返回 假;
}

// ==================== 固定帧槽对标记 ====================

// 固定帧槽相邻 store→load 对标记（动作 1=删除 / 2=改写）
不安全 函数 ARM窥孔标记直寻对(向量<字符串> 输出, 整64 段起, 整64 段终,
                              映射<整64, 整64> 计数, 向量<整64>& 动作,
                              向量<字符串>& 改行) -> 空类型 {
    整64 q = 段起;
    当 (q + 1 < 段终) {
        字符串 首行 = 输出.元素(整32(q));
        ARM窥孔槽访问 存;
        布尔 存成 = ARM窥孔解析访存行(首行, 真, 存);
        布尔 命中 = 假;
        如果 (存成 && 存.间接 == 假) {
            整64 次 = q + 1;
            布尔 扫尾 = 真;
            当 (次 < 段终 && 扫尾) {
                布尔 注释 = ARM窥孔是注释或空(输出.元素(整32(次)));
                如果 (注释) { 次++; }
                如果 (注释 == 假) { 扫尾 = 假; }
            }
            如果 (次 < 段终) {
                ARM窥孔槽访问 载;
                布尔 载成 = ARM窥孔解析访存行(输出.元素(整32(次)), 假, 载);
                布尔 同槽 = (存.槽键 == 载.槽键);
                布尔 同族 = (存.浮点 == 载.浮点);
                布尔 宽可达 = (载.宽 >= 8 && 载.宽 <= 存.宽);
                布尔 间接同 = (载.间接 == 存.间接);
                布尔 槽死 = ARM窥孔槽仅两处(计数, 存.槽键);
                布尔 全部 = 载成 && 同槽 && 同族 && 宽可达 && 间接同 && 槽死;
                如果 (全部) {
                    命中 = 真;
                    窥孔设整(动作, q, 1);
                    布尔 全删 = ARM窥孔可全删(存, 载);
                    如果 (全删) {
                        窥孔设整(动作, 次, 1);
                    }
                    否则 如果 (全删 == 假) {
                        窥孔设整(动作, 次, 2);
                        窥孔设串(改行, 次, ARM窥孔改写装载行(存, 载));
                    }
                }
            }
        }
        如果 (命中) { q = q + 2; }
        否则 如果 (命中 == 假) { q++; }
    }
}

