// 代码生成ARM64中（357 重构F2 自 代码生成ARM64.cn 纯机械搬移·函数体逐字保留·零逻辑变化）

导入 容器::向量;
导入 IR;           // IR 指令/程序IR/类型码/驻留文本/析构符号（原 IR生成+IR容器+IR常量 合并）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 代码生成;     // 后端共用决策层（原 代码生成共用；同包包名幂等加载）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

函数 编码移位ARM64(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    // 46-f 第五十轮：>> 无符号（T_正32/正64）=lsr（逻辑）；有符号=asr（算术）
    字符串 移指令 = "lsl";
    如果 (指令.操作码 == IR_右移) {
        如果 (指令.类型 == T_正32 || 指令.类型 == T_正64) { 移指令 = "lsr"; }
        否则 { 移指令 = "asr"; }
    }
    读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
    读槽(输出, "x10", 寄存器槽偏移(指令.操作数2));
    // 265-a 波A（规范 01b§5.4）：移位量显式按操作数位宽取模——32 位类型
    //   and x10, x10, #31（x9 形式=mod 64≠32 位语义）；结果按类型截断
    如果 (指令.类型 == T_整32 || 指令.类型 == T_正32) {
        加行(输出, "    and x10, x10, #31");
    } 否则 {
        加行(输出, "    and x10, x10, #63");
    }
    加行(输出, "    " + 移指令 + " x9, x9, x10");
    如果 (指令.类型 == T_整32) {
        加行(输出, "    sxtw x9, w9");
    } 否则 如果 (指令.类型 == T_正32) {
        加行(输出, "    uxtw x9, w9");
    }
    写槽(输出, "x9", 寄存器槽偏移(指令.目标));
    返回 真;
}

函数 编码算术ARM64(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    布尔 是浮点算术a = (指令.类型 == T_浮32 || 指令.类型 == T_浮64);
    如果 (是浮点算术a && (指令.操作码 == IR_加 || 指令.操作码 == IR_减 ||
                        指令.操作码 == IR_乘 || 指令.操作码 == IR_除)) {
        返回 编码浮点四则ARM64(指令, 输出);
    }
    如果 (指令.操作码 == IR_加) { 返回 编码加法ARM64(指令, 输出); }
    如果 (指令.操作码 == IR_减) { 返回 编码减法ARM64(指令, 输出); }
    如果 (指令.操作码 == IR_乘) { 返回 编码乘法ARM64(指令, 输出); }
    如果 (指令.操作码 == IR_除 || 指令.操作码 == IR_取余) { 返回 编码除余ARM64(指令, 输出); }
    // 位运算（2026-09-09 规范 01b§5.4）：and/orr/eor 单指令；移位 lsl/asr 寄存器
    //   形式——265-a 波A：移位量已显式按类型位宽取模（原「x=64 取模=规范语义」
    //   前提错误）；>> 有符号=算术 asr / 无符号=lsr（46-f）
    如果 (指令.操作码 == IR_位与 || 指令.操作码 == IR_位或 || 指令.操作码 == IR_位异或) { 返回 编码位运算ARM64(指令, 输出); }
    如果 (指令.操作码 == IR_左移 || 指令.操作码 == IR_右移) { 返回 编码移位ARM64(指令, 输出); }
    返回 假;
}

// 比较与一元组：cmp+cset 六比较 / 逻辑非 / 一元负；91-a 增浮点分派。
函数 编码比较一元ARM64(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    // 91-a：浮点比较——fcmp + cset（eq/ne/mi/ls/gt/ge——宿主 arm64 后端同映射，
    //   NaN 时全假除 != 真，IEEE ordered 语义天然正确；x86 两后端经 H1 修复对齐）。
    布尔 是浮点比较a = (指令.类型 == T_浮32 || 指令.类型 == T_浮64);
    如果 (是浮点比较a && (指令.操作码 == IR_相等 || 指令.操作码 == IR_不等 ||
                        指令.操作码 == IR_小于 || 指令.操作码 == IR_大于 ||
                        指令.操作码 == IR_小于等于 || 指令.操作码 == IR_大于等于)) {
        字符串 前缀a = (指令.类型 == T_浮64) ? "d" : "s";
        字符串 条件a = "eq";
        如果 (指令.操作码 == IR_不等) { 条件a = "ne"; }
        否则 如果 (指令.操作码 == IR_小于) { 条件a = "mi"; }
        否则 如果 (指令.操作码 == IR_大于) { 条件a = "gt"; }
        否则 如果 (指令.操作码 == IR_小于等于) { 条件a = "ls"; }
        否则 如果 (指令.操作码 == IR_大于等于) { 条件a = "ge"; }
        读槽(输出, 前缀a + "0", 寄存器槽偏移(指令.操作数1));
        读槽(输出, 前缀a + "1", 寄存器槽偏移(指令.操作数2));
        加行(输出, "    fcmp " + 前缀a + "0, " + 前缀a + "1");
        加行(输出, "    cset x9, " + 条件a);
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_相等 || 指令.操作码 == IR_不等 ||
        指令.操作码 == IR_小于 || 指令.操作码 == IR_大于 ||
        指令.操作码 == IR_小于等于 || 指令.操作码 == IR_大于等于) {
        // 比较：cmp + cset（win64 setcc 的 ARM64 等价）。46-f 第五十轮：无符号
        //   操作数（T_正32/正64）用无符号条件码 lo/hi/ls/hs（2^63>100 按
        //   负数 gt 判假=静默错误）
        整64 无符号 = (指令.类型 == T_正32 || 指令.类型 == T_正64) ? 1 : 0;
        字符串 条件 = "eq";
        如果 (指令.操作码 == IR_不等) { 条件 = "ne"; }
        否则 如果 (指令.操作码 == IR_小于) { 条件 = 无符号 == 1 ? "lo" : "lt"; }
        否则 如果 (指令.操作码 == IR_大于) { 条件 = 无符号 == 1 ? "hi" : "gt"; }
        否则 如果 (指令.操作码 == IR_小于等于) { 条件 = 无符号 == 1 ? "ls" : "le"; }
        否则 如果 (指令.操作码 == IR_大于等于) { 条件 = 无符号 == 1 ? "hs" : "ge"; }
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
        读槽(输出, "x10", 寄存器槽偏移(指令.操作数2));
        加行(输出, "    cmp x9, x10");
        加行(输出, "    cset x9, " + 条件);
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_逻辑非) {
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
        加行(输出, "    cmp x9, #0");
        加行(输出, "    cset x9, eq");
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_负) {
        // 91-a：浮点取负=fneg（±0/NaN 与 IEEE negate 一致）；整数 neg 原路径
        如果 (指令.类型 == T_浮32 || 指令.类型 == T_浮64) {
            字符串 前缀a = (指令.类型 == T_浮64) ? "d" : "s";
            读槽(输出, 前缀a + "0", 寄存器槽偏移(指令.操作数1));
            加行(输出, "    fneg " + 前缀a + "0, " + 前缀a + "0");
            写槽(输出, 前缀a + "0", 寄存器槽偏移(指令.目标));
            返回 真;
        }
        // 353-a（T60）：整数 32 位域分派——ldr w9/neg w9 32 位取负（w 寄存器
        //   写零扩高 32）+sxtw 符号回填；8/16 位低段恒同沿 64 位路径。
        //   T_正32 低 32 位同 neg32 模 2^32（消费方按码窄读，高位无关）。
        如果 (指令.类型 == T_整32 || 指令.类型 == T_正32) {
            读槽(输出, "w9", 寄存器槽偏移(指令.操作数1));
            加行(输出, "    neg w9, w9");
            加行(输出, "    sxtw x9, w9");
            写槽(输出, "x9", 寄存器槽偏移(指令.目标));
            返回 真;
        }
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
        加行(输出, "    neg x9, x9");
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    返回 假;
}

// 类型转换组：sxtw/sxtb/sxth 符号扩展 + uxtb/uxth 零扩展（灰色点④+缺陷零容忍收口）。
//   T_正64（方案甲 2026-09-10 第五十一轮）=64 位源直拷：读槽/写槽本就 x 寄存器
//   64 位全读全写，无扩展指令直通（同宽位模式重解释，2^63 转 i64 = -2^63；
//   x64 双后端 mov 全读对称）——宽扩展指令链无 T_正64 分支即直通，此处注释固化。
函数 编码类型转换ARM64(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    如果 (指令.操作码 == IR_类型转换) {
        // 91-a（2026-09-13 第九十一轮）：浮点转换分派（源码=操作数2，目标码=
        //   类型字段）——浮->浮（fcvt 宽化/窄化；同码直拷）、整->浮（scvtf 有符号；
        //   正N 经 uxtb/uxth/uxtw 零扩展后 ucvtf——ARM64 原生无符号转换）、
        //   浮->整（fcvtzs 向零截断；正32 目标 w9 写清高 32=零扩展）。
        整64 源码c = 指令.操作数2;
        布尔 源浮c = (源码c == T_浮32 || 源码c == T_浮64);
        布尔 目标浮c = (指令.类型 == T_浮32 || 指令.类型 == T_浮64);
        如果 (源浮c || 目标浮c) {
            如果 (源浮c && 目标浮c) {
                如果 (源码c == 指令.类型) {
                    读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
                    写槽(输出, "x9", 寄存器槽偏移(指令.目标));
                } 否则 如果 (源码c == T_浮32) {
                    读槽(输出, "s0", 寄存器槽偏移(指令.操作数1));
                    加行(输出, "    fcvt d0, s0");
                    写槽(输出, "d0", 寄存器槽偏移(指令.目标));
                } 否则 {
                    读槽(输出, "d0", 寄存器槽偏移(指令.操作数1));
                    加行(输出, "    fcvt s0, d0");
                    写槽(输出, "s0", 寄存器槽偏移(指令.目标));
                }
                返回 真;
            }
            如果 (目标浮c) {
                字符串 前缀a = (指令.类型 == T_浮64) ? "d" : "s";
                读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
                如果 (源码c == T_整32) {
                    加行(输出, "    sxtw x9, w9");
                } 否则 如果 (源码c == T_正32) {
                    加行(输出, "    uxtw x9, w9");
                } 否则 如果 (源码c == T_整8) {
                    加行(输出, "    sxtb x9, w9");
                } 否则 如果 (源码c == T_整16) {
                    加行(输出, "    sxth x9, w9");
                } 否则 如果 (源码c == T_正8) {
                    加行(输出, "    uxtb x9, w9");
                } 否则 如果 (源码c == T_正16) {
                    加行(输出, "    uxth x9, w9");
                }
                布尔 无符号a = (源码c == T_正32 || 源码c == T_正64 ||
                              源码c == T_正8 || 源码c == T_正16);
                如果 (无符号a) {
                    加行(输出, "    ucvtf " + 前缀a + "0, x9");
                } 否则 {
                    加行(输出, "    scvtf " + 前缀a + "0, x9");
                }
                写槽(输出, 前缀a + "0", 寄存器槽偏移(指令.目标));
                返回 真;
            }
            字符串 前缀a = (源码c == T_浮64) ? "d" : "s";
            读槽(输出, 前缀a + "0", 寄存器槽偏移(指令.操作数1));
            如果 (指令.类型 == T_正32) {
                加行(输出, "    fcvtzs w9, " + 前缀a + "0");
            } 否则 {
                加行(输出, "    fcvtzs x9, " + 前缀a + "0");
            }
            写槽(输出, "x9", 寄存器槽偏移(指令.目标));
            返回 真;
        }
        // 292（波J 49c6d405 win 同构对齐）：128 位句柄源/未登记源·整64 目标=低 64 直拷显式化（行为同原兜底透传·防兜底改动破坏 128 源面）
        如果 (指令.操作数2 == T_整128 || 指令.操作数2 == T_正128 || (指令.操作数2 == 0 && 指令.类型 == T_整64)) {
            读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
            写槽(输出, "x9", 寄存器槽偏移(指令.目标));
            返回 真;
        }
        // 整64 -> 整32 截断+符号扩展（sxtw）；其余按源类型各自扩展（292 勘误：原"win64 同款语义"失实——win 兜底=movsxd dword 32 位读截断·本侧=64 位读透传·两后端兜底本不一致勿互引）
        // 灰色点④根治（2026-09-04）：窄宽目标 整8/整16——sxtb/sxth 低 8/16 位
        //   符号扩展（整8(300)=44 截断语义；win 侧 mov al/movsx 同款，双侧对称）
        // 分派面（第五十五轮标注）：正8/正16 变量源经 类型码() 归一登记 T_整64，
        //   方案甲源分派改标 T_正64→无分支命中=直通 64 位拷贝（读槽/写槽 x 寄存器
        //   全读全写）——正确性=64 位槽零扩展写入保证高位干净；结构体字段层经
        //   类型宽度码() T_整8/16 窄宽读回（uxtb/uxth 对称 movzx）独立正确
        //   （E2E 194 双侧锚定）
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
        如果 (指令.类型 == T_整32) {
            加行(输出, "    sxtw x9, w9");
        } 否则 如果 (指令.类型 == T_正32) {
            // 46-f 第五十轮：正32 零扩展读回（uxtw 对称 movzx）
            加行(输出, "    uxtw x9, w9");
        } 否则 如果 (指令.类型 == T_整8) {
            加行(输出, "    sxtb x9, w9");
        } 否则 如果 (指令.类型 == T_整16) {
            加行(输出, "    sxth x9, w9");
        } 否则 如果 (指令.类型 == T_正8) {
            // 2026-09-04 缺陷零容忍收口：无符号窄宽零扩展（win movzx 对称）
            加行(输出, "    uxtb w9, w9");
        } 否则 如果 (指令.类型 == T_正16) {
            加行(输出, "    uxth w9, w9");
        }
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    返回 假;
}

// 访存组：返回（x0）/ 取地址（槽地址）/ 指针加载（ldrsb/ldrb/ldrh/ldr 宽度分级）/
//   指针存储（strb/strh/str 宽度分级——126 段① OOM 根治）。
函数 编码访存ARM64(IR指令 指令, 整64 最大寄存器, 向量<字符串> 输出) -> 布尔 {
    如果 (指令.操作码 == IR_返回) {
        // 返回值 -> x0 / d0（91-a：类型字段=返回类型码——浮点值返回走 d0/s0，
        //   AAPCS64 浮点返回寄存器；0=无返回值；epilogue 在函数尾块统一）
        如果 (指令.操作数1 != 0) {
            如果 (指令.类型 == T_浮32) {
                读槽(输出, "s0", 寄存器槽偏移(指令.操作数1));
            } 否则 如果 (指令.类型 == T_浮64) {
                读槽(输出, "d0", 寄存器槽偏移(指令.操作数1));
            } 否则 {
                读槽(输出, "x0", 寄存器槽偏移(指令.操作数1));
            }
        } 否则 {
            加行(输出, "    movz x0, #0");
        }
        返回 真;
    }
    如果 (指令.操作码 == IR_取地址) {
        槽地址(输出, "x9", 变量槽偏移(指令.操作数1, 最大寄存器));
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_指针加载) {
        // 经指针加载；字段宽度（②b B5）：布尔/整8/字符 1 字节、整16 2、整32 4、
        //   默认 8——w 寄存器写零扩展高位（ldrb/ldrh/ldr w 天然零扩展）
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
        // 907（任务 093·宿主 emitPtrLoadStore 同构）：空指针解引用检查（错误码 3）
        //   ——351-a 除零样板同约定：movz x0 / bl / ret 占位（终止进程不返回）
        整64 空指针序n = 输出.大小();
        加行(输出, "    cbnz x9, " + 空指针跳过标签(空指针序n));
        加行(输出, "    movz x0, #3");
        加行(输出, "    bl __cn_runtime_error");
        加行(输出, "    ret");
        加行(输出, 空指针跳过标签(空指针序n) + ":");
        如果 (指令.类型 == T_字节 || 指令.类型 == T_整8) {
            // 347-a（T33 残余根治）：字符串[i]（A-1）+ **有符号整8**——符号扩展
            加行(输出, "    ldrsb x9, [x9]");
        } 否则 如果 (指令.类型 == T_布尔 || 指令.类型 == T_正8) {
            加行(输出, "    ldrb w9, [x9]");
        } 否则 如果 (指令.类型 == T_字符) {
            // 979（002·306·95-a）：字符=4 字节 Unicode 标量值——ldr w 零扩展
            //   （码点正值域），原 ldrb 截断高 3 字节
            加行(输出, "    ldr w9, [x9]");
        } 否则 如果 (指令.类型 == T_整16) {
            // 347-a：整16 有符号——符号扩展（原零扩展 → 负值读回错值）
            加行(输出, "    ldrsh x9, [x9]");
        } 否则 如果 (指令.类型 == T_正16) {
            加行(输出, "    ldrh w9, [x9]");
        } 否则 如果 (指令.类型 == T_整32 || 指令.类型 == T_正32) {
            // T_正32（46-f）：ldr w 天然零扩展
            // 266-a 波B：T_整32（有符号）ldrsw 符号扩展
            如果 (指令.类型 == T_整32) {
                加行(输出, "    ldrsw x9, [x9]");
            } 否则 {
                加行(输出, "    ldr w9, [x9]");
            }
        } 否则 {
            加行(输出, "    ldr x9, [x9]");
        }
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_指针存储) {
        // 经指针存储；字段宽度（②b B5）：旧固定 8 字节写越界清零相邻槽（126 段①
        //   当循环死循环 -> 堆 OOM 根因）——按 指令.类型 宽度发射；0/默认 8 字节
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
        // 907（任务 093·宿主 emitPtrLoadStore 同构）：空指针解引用检查（错误码 3）
        整64 空指针序s = 输出.大小();
        加行(输出, "    cbnz x9, " + 空指针跳过标签(空指针序s));
        加行(输出, "    movz x0, #3");
        加行(输出, "    bl __cn_runtime_error");
        加行(输出, "    ret");
        加行(输出, 空指针跳过标签(空指针序s) + ":");
        读槽(输出, "x10", 寄存器槽偏移(指令.操作数2));
        如果 (指令.类型 == T_布尔 || 指令.类型 == T_整8 ||
             指令.类型 == T_正8) {
            // 347-a（同族旁路穷尽）：正8 原落默认 8 字节写=过写越界
            加行(输出, "    strb w10, [x9]");
        } 否则 如果 (指令.类型 == T_字符) {
            // 979（002·306·95-a）：字符=4 字节槽——str w 全宽写（与 类型大小
            //   与对齐 4/4 布局一致·原 strb 留 3 字节脏尾）
            加行(输出, "    str w10, [x9]");
        } 否则 如果 (指令.类型 == T_整16 || 指令.类型 == T_正16) {
            // 347-a：正16 原落默认 8 字节写=过写越界
            加行(输出, "    strh w10, [x9]");
        } 否则 如果 (指令.类型 == T_整32 || 指令.类型 == T_正32) {
            // T_正32（46-f）：str w 天然截断（wrapping mod 2^32）
            加行(输出, "    str w10, [x9]");
        } 否则 {
            加行(输出, "    str x10, [x9]");
        }
        返回 真;
    }
    返回 假;
}

// 控制流组：字段地址（#立即数<=4095 否则经 x13）/ 块标签 / b / cbnz+b。
函数 编码控制流ARM64(IR指令 指令, 整64 函数序号, 向量<字符串> 输出) -> 布尔 {
    如果 (指令.操作码 == IR_串字段地址) {
        // 1009（云端红治理）：串字段地址=判空豁免**独立分支**（win 版同构）——
        //   原实现嵌在 IR_字段地址 分支判空块之后：空串句柄 0 踩 cbnz/bl
        //   __cn_runtime_error(3)（094 空安全破坏·X64Linux 同病已修）；并修正
        //   原块误用 寄存器槽()（x86 式 [rbp-N] 文本）→ARM64 惯例 读槽/写槽；
        //   补大立即数（>4095）x13 中转（原块漏）。串句柄 0=空串合法（991 立法）。
        读槽(输出, "x10", 寄存器槽偏移(指令.操作数1));
        如果 (指令.附加 != 0) {
            如果 (指令.附加 <= 4095) {
                加行(输出, "    add x10, x10, #" + 整数转字符串(指令.附加));
            } 否则 {
                装载立即数(输出, "x13", 指令.附加);
                加行(输出, "    add x10, x10, x13");
            }
        }
        写槽(输出, "x10", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_字段地址) {
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
        // 907（任务 093·宿主 emitFieldAddr 同构）：空指针检查（错误码 3）——
        //   基址零时字段地址无意义（后续访存必崩），与宿主同点拦截
        整64 空指针序f = 输出.大小();
        加行(输出, "    cbnz x9, " + 空指针跳过标签(空指针序f));
        加行(输出, "    movz x0, #3");
        加行(输出, "    bl __cn_runtime_error");
        加行(输出, "    ret");
        加行(输出, 空指针跳过标签(空指针序f) + ":");
        如果 (指令.附加 != 0) {
            如果 (指令.附加 <= 4095) {
                加行(输出, "    add x9, x9, #" + 整数转字符串(指令.附加));
            } 否则 {
                装载立即数(输出, "x10", 指令.附加);
                加行(输出, "    add x9, x9, x10");
            }
        }
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_标签) {
        加行(输出, 块标签(函数序号, 指令.附加) + ":");
        返回 真;
    }
    如果 (指令.操作码 == IR_跳转) {
        加行(输出, "    b " + 块标签(函数序号, 指令.附加));
        返回 真;
    }
    如果 (指令.操作码 == IR_条件跳转) {
        // 条件寄存器 非零 -> 真块（cbnz）；否则假块
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
        加行(输出, "    cbnz x9, " + 块标签(函数序号, 指令.操作数2));
        加行(输出, "    b " + 块标签(函数序号, 指令.操作数3));
        返回 真;
    }
    返回 假;
}

// 对象与调用组：分配对象（bl __cn_object_new）/ 结构体拷贝（8 字节字循环+字节尾巴）/
//   删除对象（cbz 空安全+析构+释放）/ 调用参数化（位<8 寄存器 x0-x7、>=8 栈区，
//   栈实参先经 x9 中转装载）。
函数 编码分配对象ARM64(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
        // NewObject：x0=大小 -> __cn_object_new -> x0（AAPCS64 无影子空间）
        装载立即数(输出, "x0", 指令.类型);
        加行(输出, "    bl __cn_object_new");
        // 234：有虚类分配即装 vptr（构造/默认构造/无构造统一单点）
        //   399 根治（2026-10-10）：引用侧补 符号修饰ARM64——中文类名经 hex 转义后
        //   与定义侧（代码生成ARM64尾 虚表数据段）同形态，两侧对称方可链接配对
        //   （此前裸名 UTF-8 原样 vs 定义 hex 转义=undefined reference 实录：
        //   arm64 真机 10-09 六连红同根因·交叉实例首轮全量 365/431/616 复现）
        如果 (类虚槽总数(指令.附加) > 0) {
            加行(输出, "    adrp x1, " + 符号修饰ARM64(类虚表符号(驻留文本(指令.附加))));
            加行(输出, "    add x1, x1, :lo12:" + 符号修饰ARM64(类虚表符号(驻留文本(指令.附加))));
            加行(输出, "    str x1, [x0]");
        }
        写槽(输出, "x0", 寄存器槽偏移(指令.目标));
        返回 真;
    返回 真;
}

函数 编码结构体拷贝ARM64(IR指令 指令, 整64 函数序号, 向量<字符串> 输出) -> 布尔 {
        // CopyStruct：x9=目标地址 x10=源地址 x11=剩余字节；8 字节字循环 + 字节尾巴
        //   （ARM64 无 rep movsb；后索引寻址 [xn], #8/#1 逐块搬运）
        字符串 循环标签 = 拷贝标签(函数序号, 输出.大小());
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数2));
        读槽(输出, "x10", 寄存器槽偏移(指令.操作数1));
        装载立即数(输出, "x11", 指令.类型);
        加行(输出, 循环标签 + ":");
        加行(输出, "    cmp x11, #8");
        加行(输出, "    b.lt " + 循环标签 + "t");
        加行(输出, "    ldr x12, [x10], #8");
        加行(输出, "    str x12, [x9], #8");
        加行(输出, "    sub x11, x11, #8");
        加行(输出, "    b " + 循环标签);
        加行(输出, 循环标签 + "t:");
        加行(输出, "    cbz x11, " + 循环标签 + "d");
        加行(输出, "    ldrb w12, [x10], #1");
        加行(输出, "    strb w12, [x9], #1");
        加行(输出, "    sub x11, x11, #1");
        加行(输出, "    b " + 循环标签 + "t");
        加行(输出, 循环标签 + "d:");
        返回 真;
    返回 真;
}

