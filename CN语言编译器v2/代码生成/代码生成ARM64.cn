// CN 自举编译器 v2：结构化代码生成器——Linux ARM64 GAS 后端（阶段A，2026-09-02）
// IR 指令数组 -> AArch64 GAS 汇编文本行（GNU as），对齐宿主 arm64 后端 ABI/指令选择：
//   - 虚拟寄存器 r -> [x29, #-8*r-8]（宿主 regSlotOffset 同式；与 win64 [rbp-8r-8] 布局一致）；
//   - 变量槽 s -> [x29, #-8*(最大寄存器+s)-8]（寄存器槽区之下，同 win64 布局）；
//   - 函数框架（宿主 emitPrologue/emitEpilogue 同款）：
//     stp x29, x30, [sp, #-16]! / mov x29, sp / sub sp, sp, #帧大小（16 对齐）…
//     add sp, sp, #帧大小 / ldp x29, x30, [sp], #16 / ret；
//   - AAPCS64：前 8 参数 x0~x7、第 9 起调用方 [sp+8k] / 被调方 [x29, #16+8k]；
//     retbuf（结果<T,E> 返回）占 x0——IR 位号约定（retbuf=0 / this=1 / 实参从 2 起）
//     恰与 AAPCS64 寄存器编号一致，位号即 xN；
//   - 立即数：movz/movk 16 位分片（宿主 emitMovImm 同款——无字面量池距离风险）；
//   - 标准库/运行时符号经 符号修饰（与宿主 nameMangle 一致，双后端共用）bl 直调；
//     链接复用宿主编排（as 汇编 + g++ -no-pie 链接运行时 .o）。
// 支持的 IR 子集与 win64 后端（代码生成.cn）一一对应；浮点/位运算 IR 尚未发射，
//   两后端保持同等缺口（后续阶段统一补齐）。
// 栈槽直接寻址域（宿主 stackMemText 同策略）：
//   负向 ldur/stur imm9（-256..255）；正向 ldr/str imm12 缩放（0..32760）；
//   域外经 x13 计算地址（x13 为地址临时，宿主同款约定）。
导入 容器::向量;
导入 IR;           // IR 指令/程序IR/类型码/驻留文本/析构符号（原 IR生成+IR容器+IR常量 合并）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 代码生成;     // 后端共用决策层（原 代码生成共用；同包包名幂等加载）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

公开:

// ==================== 基础助手 ====================

// GAS 符号安全字符判定（宿主 nameMangle 同款：字母/数字/._$；
//   ? @ # 等为 GAS 特殊字符——@ 是注释符，MASM 修饰名不可直接用于 GAS）
函数 是GAS安全(字符串 名) -> 布尔 {
    整64 i = 0;
    当 (i < 字符串长度(名)) {
        整64 字节 = 整64(名[i]) & 255;
        布尔 安全 = 假;
        如果 (字节 >= 48 && 字节 <= 57) { 安全 = 真; }
        如果 (字节 >= 65 && 字节 <= 90) { 安全 = 真; }
        如果 (字节 >= 97 && 字节 <= 122) { 安全 = 真; }
        如果 (字节 == 95 || 字节 == 46 || 字节 == 36) { 安全 = 真; }
        如果 (!安全) { 返回 假; }
        i++;
    }
    返回 真;
}

// GAS 符号修饰（对标宿主 arm64 nameMangle，与 MASM 路径同签名体系）：
//   主->cn_main（运行时入口）；__cn_ 原样；纯 ASCII 无参->原样；其余->"_"+基名 UTF-8 逐字节十六进制+每参数段"_"+类型编码（复用 代码生成.cn 编码表）。
函数 符号修饰ARM64(字符串 名) -> 字符串 {
    如果 (字符串比较(名, "主")) { 返回 "cn_main"; }
    如果 (字符串长度(名) >= 5 && 字符串比较(字符串子串(名, 0, 5), "__cn_")) { 返回 字符串复制(名); }
    整64 井号位置 = 字节位置(名, 35, 0);
    字符串 基名 = 名;
    字符串 参数串 = "";
    如果 (井号位置 >= 0) {
        基名 = 字符串子串(名, 0, 井号位置);
        参数串 = 字符串子串(名, 井号位置 + 1, 字符串长度(名) - 井号位置 - 1);
    }
    如果 (是GAS安全(基名) && 字符串长度(参数串) == 0) { 返回 字符串复制(名); }
    字符串 修饰 = "_";
    整64 j = 0;
    当 (j < 字符串长度(基名)) {
        整64 字节 = 整64(基名[j]) & 255;
        修饰 = 修饰 + 字节十六进制(字节);
        j++;
    }
    // 参数段：空参数串不拼（分割参数串("") 会产出 1 个空段 -> _T 假后缀，实测踩坑）
    如果 (字符串长度(参数串) > 0) {
        向量<字符串> 段们 = 分割参数串(参数串);
        整64 k = 0;
        当 (k < 段们.大小()) {
            修饰 = 修饰 + "_" + 类型编码(段们.元素(k));
            k++;
        }
    }
    返回 修饰;
}

// 追加一行（失败即运行时错误 4，与 代码生成.cn 惯例一致）
函数 加行(向量<字符串> 输出, 字符串 行) -> 空类型 {
    结果<空类型, 整32> 加 = 输出.追加(行);
    如果 (!加.正常) { 运行时错误(4); }
}

// 整数字面量位模式解析已上移共用层（字面量位模式，2026-09-09 第四十一轮）：
//   原 解析数值 只认十进制——0x/0b/0o 前缀被静默解析为 0 的潜伏缺陷随共用层
//   单点根治（十进制文本行为逐点等价）

// 取 64 位值的第 片位 个 16 位片（片位 0 起；移位+掩码=位模式语义，宿主 emitMovImm
//   (value>>shift)&0xFFFF 严格同构——52-a 根治（2026-09-10 第五十三轮，用户裁决方案A）：
//   原 无移位运算时代 除法/取模 实现对负值保号出负片，2^63（唯一 bit63 置位位模式）
//   经负值补码分支得 movk #负数 越 GNU as 无符号 16 位域；算术右移+掩码对任意
//   整64 位模式正确（掩码截低 16 位，符号填充位不落入片内）
函数 取片(整64 值, 整64 片位) -> 整64 {
    返回 (值 >> (片位 * 16)) & 65535;
}

// movz/movk 立即数装载（宿主 emitMovImm 同款）：movz 首片恒发（零扩展清高位），
//   其后非零片 movk lsl（零片跳过——movz 已清零）
函数 装载立即数(向量<字符串> 输出, 字符串 寄存器, 整64 值) -> 空类型 {
    加行(输出, "    movz " + 寄存器 + ", #" + 整数转字符串(取片(值, 0)));
    如果 (取片(值, 1) != 0) {
        加行(输出, "    movk " + 寄存器 + ", #" + 整数转字符串(取片(值, 1)) + ", lsl #16");
    }
    如果 (取片(值, 2) != 0) {
        加行(输出, "    movk " + 寄存器 + ", #" + 整数转字符串(取片(值, 2)) + ", lsl #32");
    }
    如果 (取片(值, 3) != 0) {
        加行(输出, "    movk " + 寄存器 + ", #" + 整数转字符串(取片(值, 3)) + ", lsl #48");
    }
}

// ==================== 栈槽访问（偏移共用层，发射本层） ====================

// 槽地址：寄存器 = x29 + 偏移（|偏移| <= 4095 单条 add/sub；否则 movz/movk 再算）
函数 槽地址(向量<字符串> 输出, 字符串 寄存器, 整64 偏移) -> 空类型 {
    如果 (偏移 < 0) {
        整64 绝对值 = 0 - 偏移;
        如果 (绝对值 <= 4095) {
            加行(输出, "    sub " + 寄存器 + ", x29, #" + 整数转字符串(绝对值));
            返回;
        }
        装载立即数(输出, 寄存器, 绝对值);
        加行(输出, "    sub " + 寄存器 + ", x29, " + 寄存器);
        返回;
    }
    如果 (偏移 <= 4095) {
        加行(输出, "    add " + 寄存器 + ", x29, #" + 整数转字符串(偏移));
        返回;
    }
    装载立即数(输出, 寄存器, 偏移);
    加行(输出, "    add " + 寄存器 + ", x29, " + 寄存器);
}

// 读槽：寄存器 <- [x29 + 偏移]（直接寻址域外经 x13）
函数 读槽(向量<字符串> 输出, 字符串 寄存器, 整64 偏移) -> 空类型 {
    如果 (偏移 >= -256 && 偏移 <= 32760) {
        加行(输出, "    ldr " + 寄存器 + ", [x29, #" + 整数转字符串(偏移) + "]");
        返回;
    }
    槽地址(输出, "x13", 偏移);
    加行(输出, "    ldr " + 寄存器 + ", [x13]");
}

// 写槽：[x29 + 偏移] <- 寄存器（直接寻址域外经 x13）
函数 写槽(向量<字符串> 输出, 字符串 寄存器, 整64 偏移) -> 空类型 {
    如果 (偏移 >= -256 && 偏移 <= 32760) {
        加行(输出, "    str " + 寄存器 + ", [x29, #" + 整数转字符串(偏移) + "]");
        返回;
    }
    槽地址(输出, "x13", 偏移);
    加行(输出, "    str " + 寄存器 + ", [x13]");
}

// 110-a（2026-09-13 家机 win-x64）：结构体按值参数拷贝单点（源指针已在 x9）——
//   prologue 寄存器路径与栈参数路径共用（防两路分叉；x10=目标槽地址推进、
//   x11=剩余字节、x12=数据）。
函数 发射参数拷贝ARM64(向量<字符串> 输出, 整64 参数槽, 整64 最大寄存器,
                        整64 拷贝字节, 整64 函数序号) -> 空类型 {
    槽地址(输出, "x10", 变量槽偏移(参数槽, 最大寄存器));
    装载立即数(输出, "x11", 拷贝字节);
    字符串 参数拷贝标签 = 拷贝标签(函数序号, 输出.大小());
    加行(输出, 参数拷贝标签 + ":");
    加行(输出, "    cmp x11, #8");
    加行(输出, "    b.lt " + 参数拷贝标签 + "t");
    加行(输出, "    ldr x12, [x9], #8");
    加行(输出, "    str x12, [x10], #8");
    加行(输出, "    sub x11, x11, #8");
    加行(输出, "    b " + 参数拷贝标签);
    加行(输出, 参数拷贝标签 + "t:");
    加行(输出, "    cbz x11, " + 参数拷贝标签 + "d");
    加行(输出, "    ldrb w12, [x9], #1");
    加行(输出, "    strb w12, [x10], #1");
    加行(输出, "    sub x11, x11, #1");
    加行(输出, "    b " + 参数拷贝标签 + "t");
    加行(输出, 参数拷贝标签 + "d:");
}

// ==================== 单指令生成 ====================
// 生成一条 IR 指令的 GAS 文本到 输出（对齐 代码生成.cn 生成指令 的逐操作码结构）。
// 槽基数（retbuf 地址计算）、retbuf槽数（②b B6 基槽决策）与 函数序号（标签唯一化）入参；实参们=前导 IR_调用实参 声明性指令序列（IR_调用参数化 统一展开）。
函数 生成指令ARM64(IR指令 指令, 整64 最大寄存器, 整64 槽基数, 整64 retbuf槽数,
                   整64 函数序号, 向量<IR指令> 实参们, 向量<字符串> 输出) -> 空类型 {
    加行(输出, "    // op=" + 整数转字符串(指令.操作码));
    如果 (编码数据移动ARM64(指令, 最大寄存器, 输出)) { 返回; }
    如果 (编码算术ARM64(指令, 输出)) { 返回; }
    如果 (编码比较一元ARM64(指令, 输出)) { 返回; }
    如果 (编码类型转换ARM64(指令, 输出)) { 返回; }
    如果 (编码访存ARM64(指令, 最大寄存器, 输出)) { 返回; }
    如果 (编码控制流ARM64(指令, 函数序号, 输出)) { 返回; }
    如果 (编码对象调用ARM64(指令, 最大寄存器, 槽基数, retbuf槽数, 函数序号, 实参们, 输出)) { 返回; }
    如果 (编码静态ARM64(指令, 输出)) { 返回; }
    // IR_分配 等：prologue 预留帧，此处 no-op（win64 同款）
}

// ==================== 指令编码函数组（R4，2026-09-08 自 生成指令ARM64 机械搬移） ====================
// 每函数收同款上下文返回 布尔=该操作码是否由本组处理（真=已发射）——分组与
//   win64 后端（代码生成.cn）同构。

// 数据移动组：常量整数（负值 neg）/常量字符串（adrp+add）/槽加载/槽存储。
函数 编码数据移动ARM64(IR指令 指令, 整64 最大寄存器, 向量<字符串> 输出) -> 布尔 {
    如果 (指令.操作码 == IR_常量整数) {
        // 常量整数：操作数1 = Symbol ID（文本，经共用层位模式解析——进制前缀/
        //   类型后缀剥离）；负值补码位模式（绝对值装载 + neg）
        整64 值 = 字面量位模式(驻留文本(指令.操作数1));
        如果 (值 < 0) {
            装载立即数(输出, "x9", 0 - 值);
            加行(输出, "    neg x9, x9");
        } 否则 {
            装载立即数(输出, "x9", 值);
        }
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_常量浮点) {
        // 浮点常量（89-a）：.data floatData_<文本ID>（.double 文本直通）——
        //   adrp+add 取址 + ldr 8 字节装载（宿主 ConstFloat 同款语义）
        加行(输出, "    adrp x9, floatData_" + 整数转字符串(指令.操作数1));
        加行(输出, "    add x9, x9, :lo12:floatData_" + 整数转字符串(指令.操作数1));
        加行(输出, "    ldr x9, [x9]");
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_常量字符串) {
        // 字符串常量：adrp+add 取 .data 数据标签地址（-no-pie 链接；宿主同款）
        加行(输出, "    adrp x9, strData_" + 整数转字符串(指令.操作数1));
        加行(输出, "    add x9, x9, :lo12:strData_" + 整数转字符串(指令.操作数1));
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_加载) {
        读槽(输出, "x9", 变量槽偏移(指令.操作数1, 最大寄存器));
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_存储) {
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
        写槽(输出, "x9", 变量槽偏移(指令.附加, 最大寄存器));
        返回 真;
    }
    返回 假;
}

// 算术组：加/减/乘/除（sdiv）/取余（sdiv+msub——宿主无专用 rem 同式）。
// 520-a（D1 行数滚动·纯机械拆分零行为变更）：编码算术ARM64 166 行→主分派器+七子函数·逻辑逐字迁移注释逐字保留·等价红线=新旧 v2p 交叉编译 asm 逐字节 md5 一致（/tmp/p520 双对拍）。
函数 编码浮点四则ARM64(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    // 91-a（2026-09-13 第九十一轮）：浮点算术（指令.类型=T_浮32/T_浮64）——
    //   NEON 标量 fadd/fsub/fmul/fdiv（浮64 用 dN、浮32 用 sN；读槽/写槽
    //   辅助直接复用——ldr d0, [x29,#off] 与整数同构）。取余 % 不在浮点面内。
    字符串 前缀a = (指令.类型 == T_浮64) ? "d" : "s";
    字符串 运算a = "fadd";
    如果 (指令.操作码 == IR_减) { 运算a = "fsub"; }
    否则 如果 (指令.操作码 == IR_乘) { 运算a = "fmul"; }
    否则 如果 (指令.操作码 == IR_除) { 运算a = "fdiv"; }
    读槽(输出, 前缀a + "0", 寄存器槽偏移(指令.操作数1));
    读槽(输出, 前缀a + "1", 寄存器槽偏移(指令.操作数2));
    加行(输出, "    " + 运算a + " " + 前缀a + "0, " + 前缀a + "0, " + 前缀a + "1");
    写槽(输出, 前缀a + "0", 寄存器槽偏移(指令.目标));
    返回 真;
}
函数 编码加法ARM64(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
    读槽(输出, "x10", 寄存器槽偏移(指令.操作数2));
    加行(输出, "    add x9, x9, x10");
    // 264-a D34 波1：32 位类型出口截断（整32 sxtw 符号扩展/正32 uxtw 清高）
    如果 (指令.类型 == T_整32) {
        加行(输出, "    sxtw x9, w9");
    } 否则 如果 (指令.类型 == T_正32) {
        加行(输出, "    uxtw x9, w9");
    }
    写槽(输出, "x9", 寄存器槽偏移(指令.目标));
    返回 真;
}
函数 编码减法ARM64(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
    读槽(输出, "x10", 寄存器槽偏移(指令.操作数2));
    加行(输出, "    sub x9, x9, x10");
    // 264-a D34 波1：32 位类型出口截断（整32 sxtw 符号扩展/正32 uxtw 清高）
    如果 (指令.类型 == T_整32) {
        加行(输出, "    sxtw x9, w9");
    } 否则 如果 (指令.类型 == T_正32) {
        加行(输出, "    uxtw x9, w9");
    }
    写槽(输出, "x9", 寄存器槽偏移(指令.目标));
    返回 真;
}
函数 编码乘法ARM64(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
    读槽(输出, "x10", 寄存器槽偏移(指令.操作数2));
    加行(输出, "    mul x9, x9, x10");
    // 264-a D34 波1：32 位类型出口截断（整32 sxtw 符号扩展/正32 uxtw 清高）
    如果 (指令.类型 == T_整32) {
        加行(输出, "    sxtw x9, w9");
    } 否则 如果 (指令.类型 == T_正32) {
        加行(输出, "    uxtw x9, w9");
    }
    写槽(输出, "x9", 寄存器槽偏移(指令.目标));
    返回 真;
}
函数 编码除余ARM64(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    // 351-a（T27 v2 侧同构·阶段二·423 SIGFPE 三后端闭环）：①除零检查（错误码 1=
    //   错误码.除零——ARM sdiv/udiv 除零返回 0=静默错值，须显式拦截对齐宿主/x64l）；
    //   ②**有符号 INT_MIN/-1 溢出免特判（ARM 架构定义·DDI 0487）**：SDIV 溢出
    //   （INT_MIN/-1）商=被除数（INT_MIN 回绕）、w 寄存器 32 位算术天然 2^32 回绕
    //   → x/-1≡-x、x%-1≡0 与 x64l/win 的运行时特判结果逐值一致（B12 甲语义三后端
    //   对称）；③**32 位位宽分派**（w 寄存器——64 位域算 32 位除法会把 INT32_MIN/-1
    //   算成 2147483648，w 版硬件直接回绕=-2147483648=宿主 cdq+idiv r9d 同值）+
    //   出口 sxtw/uxtw 回填（264-a D34 波1 惯例）。错误调用形态=既有 IR 通道同约定
    //   （351-a p1 探针取证：movz x0,#1 / bl / ret 占位——__cn_runtime_error 终止
    //   进程不返回，ret 为防穿越占位）。余数=商 sdiv 后 msub（宿主无专用 rem 同式·
    //   46-f 第五十轮）。
    整64 保护序a = 输出.大小();
    布尔 除法有符号a = !(指令.类型 == T_正32 || 指令.类型 == T_正64);
    读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
    读槽(输出, "x10", 寄存器槽偏移(指令.操作数2));
    // ① 除零检查：槽值已符号/零扩展（32 位 0 扩展后仍 0）→ cbnz x10 即可
    加行(输出, "    cbnz x10, " + 除零跳过标签(保护序a));
    加行(输出, "    movz x0, #1");
    加行(输出, "    bl __cn_runtime_error");
    加行(输出, "    ret");
    加行(输出, 除零跳过标签(保护序a) + ":");
    // ② 主体（除=商进 x9；余=sdiv 后 msub）——32 位走 w 寄存器（位宽分派）
    如果 (指令.类型 == T_整32 || 指令.类型 == T_正32) {
        如果 (指令.操作码 == IR_除) {
            如果 (除法有符号a) {
                加行(输出, "    sdiv w9, w9, w10");
            } 否则 {
                加行(输出, "    udiv w9, w9, w10");
            }
        } 否则 {
            如果 (除法有符号a) {
                加行(输出, "    sdiv w11, w9, w10");
            } 否则 {
                加行(输出, "    udiv w11, w9, w10");
            }
            加行(输出, "    msub w9, w11, w10, w9");
        }
        // 出口回填（264-a 惯例）：整32 sxtw 符号扩展 / 正32 uxtw 清高
        如果 (除法有符号a) {
            加行(输出, "    sxtw x9, w9");
        } 否则 {
            加行(输出, "    uxtw x9, w9");
        }
    } 否则 {
        如果 (指令.操作码 == IR_除) {
            如果 (除法有符号a) {
                加行(输出, "    sdiv x9, x9, x10");
            } 否则 {
                加行(输出, "    udiv x9, x9, x10");
            }
        } 否则 {
            如果 (除法有符号a) {
                加行(输出, "    sdiv x11, x9, x10");
            } 否则 {
                加行(输出, "    udiv x11, x9, x10");
            }
            加行(输出, "    msub x9, x11, x10, x9");
        }
    }
    写槽(输出, "x9", 寄存器槽偏移(指令.目标));
    返回 真;
}
函数 编码位运算ARM64(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    字符串 位指令 = "and";
    如果 (指令.操作码 == IR_位或) { 位指令 = "orr"; }
    如果 (指令.操作码 == IR_位异或) { 位指令 = "eor"; }
    读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
    读槽(输出, "x10", 寄存器槽偏移(指令.操作数2));
    加行(输出, "    " + 位指令 + " x9, x9, x10");
    // 264-a D34 波1：32 位类型出口截断（整32 sxtw 符号扩展/正32 uxtw 清高）
    如果 (指令.类型 == T_整32) {
        加行(输出, "    sxtw x9, w9");
    } 否则 如果 (指令.类型 == T_正32) {
        加行(输出, "    uxtw x9, w9");
    }
    写槽(输出, "x9", 寄存器槽偏移(指令.目标));
    返回 真;
}
