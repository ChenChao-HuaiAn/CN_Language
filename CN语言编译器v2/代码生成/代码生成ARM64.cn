// CN 自举编译器 v2：结构化代码生成器——Linux ARM64 GAS 后端（阶段A，2026-09-02）
// IR 指令数组 -> AArch64 GAS 汇编文本行（GNU as），对齐宿主 arm64 后端 ABI/指令选择：
//   - 虚拟寄存器 r -> [x29, #-8*r-8]（宿主 regSlotOffset 同式；与 win64 [rbp-8r-8] 布局一致）；
//   - 变量槽 s -> [x29, #-8*(最大寄存器+s)-8]（寄存器槽区之下，同 win64 布局）；
//   - 函数框架（宿主 emitPrologue/emitEpilogue 同款）：
//     stp x29, x30, [sp, #-16]! / mov x29, sp / sub sp, sp, #帧大小（16 对齐）…
//     add sp, sp, #帧大小 / ldp x29, x30, [sp], #16 / ret；
//   - AAPCS64：前 8 参数 x0~x7、第 9 起调用方 [sp+8k] / 被调方 [x29, #16+8k]；
//     retbuf（结果<T,E> 返回）占 x0——IR 位号约定（retbuf=0 / this=1 / 实参从 2 起）
//     恰与 AAPCS64 寄存器编号一致，位号即 xN；
//   - 立即数：movz/movk 16 位分片（宿主 emitMovImm 同款——无字面量池距离风险）；
//   - 标准库/运行时符号经 符号修饰（与宿主 nameMangle 一致，双后端共用）bl 直调；
//     链接复用宿主编排（as 汇编 + g++ -no-pie 链接运行时 .o）。
// 支持的 IR 子集与 win64 后端（代码生成.cn）一一对应；浮点/位运算 IR 尚未发射，
//   两后端保持同等缺口（后续阶段统一补齐）。
// 栈槽直接寻址域（宿主 stackMemText 同策略）：
//   负向 ldur/stur imm9（-256..255）；正向 ldr/str imm12 缩放（0..32760）；
//   域外经 x13 计算地址（x13 为地址临时，宿主同款约定）。
导入 容器::向量;
导入 IR;           // IR 指令/程序IR/类型码/驻留文本/析构符号（原 IR生成+IR容器+IR常量 合并）
导入 代码生成;     // 后端共用决策层（原 代码生成共用；同包包名幂等加载）

公开:

// ==================== 基础助手 ====================

// GAS 符号安全字符判定（宿主 nameMangle 同款：字母/数字/._$；
//   ? @ # 等为 GAS 特殊字符——@ 是注释符，MASM 修饰名不可直接用于 GAS）
函数 是GAS安全(字符串 名) -> 布尔 {
    整64 i = 0;
    当 (i < 字符串长度(名)) {
        整64 字节 = 整64(名[i]) & 255;
        布尔 安全 = 假;
        如果 (字节 >= 48 && 字节 <= 57) { 安全 = 真; }
        如果 (字节 >= 65 && 字节 <= 90) { 安全 = 真; }
        如果 (字节 >= 97 && 字节 <= 122) { 安全 = 真; }
        如果 (字节 == 95 || 字节 == 46 || 字节 == 36) { 安全 = 真; }
        如果 (!安全) { 返回 假; }
        i++;
    }
    返回 真;
}

// GAS 符号修饰（对标宿主 arm64 nameMangle，与 MASM 路径同签名体系）：
//   主 -> cn_main（运行时入口）；__cn_ 原样；纯 ASCII 无参 -> 原样；
//   其余 -> "_" + 基名 UTF-8 逐字节十六进制 + 每参数段 "_"+类型编码
//   （类型编码复用 代码生成.cn——两后端编码表一致）。
函数 符号修饰ARM64(字符串 名) -> 字符串 {
    如果 (字符串比较(名, "主")) { 返回 "cn_main"; }
    如果 (字符串长度(名) >= 5 && 字符串比较(字符串子串(名, 0, 5), "__cn_")) { 返回 字符串复制(名); }
    整64 井号位置 = 字节位置(名, 35, 0);
    字符串 基名 = 名;
    字符串 参数串 = "";
    如果 (井号位置 >= 0) {
        基名 = 字符串子串(名, 0, 井号位置);
        参数串 = 字符串子串(名, 井号位置 + 1, 字符串长度(名) - 井号位置 - 1);
    }
    如果 (是GAS安全(基名) && 字符串长度(参数串) == 0) { 返回 字符串复制(名); }
    字符串 修饰 = "_";
    整64 j = 0;
    当 (j < 字符串长度(基名)) {
        整64 字节 = 整64(基名[j]) & 255;
        修饰 = 修饰 + 字节十六进制(字节);
        j++;
    }
    // 参数段：空参数串不拼（分割参数串("") 会产出 1 个空段 -> _T 假后缀，实测踩坑）
    如果 (字符串长度(参数串) > 0) {
        向量<字符串> 段们 = 分割参数串(参数串);
        整64 k = 0;
        当 (k < 段们.大小()) {
            修饰 = 修饰 + "_" + 类型编码(段们.元素(k));
            k++;
        }
    }
    返回 修饰;
}

// 追加一行（失败即运行时错误 4，与 代码生成.cn 惯例一致）
函数 加行(向量<字符串> 输出, 字符串 行) -> 空类型 {
    结果<空类型, 整32> 加 = 输出.追加(行);
    如果 (!加.正常) { 运行时错误(4); }
}

// 整数字面量位模式解析已上移共用层（字面量位模式，2026-09-09 第四十一轮）：
//   原 解析数值 只认十进制——0x/0b/0o 前缀被静默解析为 0 的潜伏缺陷随共用层
//   单点根治（十进制文本行为逐点等价）

// 取 64 位值的第 片位 个 16 位片（片位 0 起；移位+掩码=位模式语义，宿主 emitMovImm
//   (value>>shift)&0xFFFF 严格同构——52-a 根治（2026-09-10 第五十三轮，用户裁决方案A）：
//   原 无移位运算时代 除法/取模 实现对负值保号出负片，2^63（唯一 bit63 置位位模式）
//   经负值补码分支得 movk #负数 越 GNU as 无符号 16 位域；算术右移+掩码对任意
//   整64 位模式正确（掩码截低 16 位，符号填充位不落入片内）
函数 取片(整64 值, 整64 片位) -> 整64 {
    返回 (值 >> (片位 * 16)) & 65535;
}

// movz/movk 立即数装载（宿主 emitMovImm 同款）：movz 首片恒发（零扩展清高位），
//   其后非零片 movk lsl（零片跳过——movz 已清零）
函数 装载立即数(向量<字符串> 输出, 字符串 寄存器, 整64 值) -> 空类型 {
    加行(输出, "    movz " + 寄存器 + ", #" + 整数转字符串(取片(值, 0)));
    如果 (取片(值, 1) != 0) {
        加行(输出, "    movk " + 寄存器 + ", #" + 整数转字符串(取片(值, 1)) + ", lsl #16");
    }
    如果 (取片(值, 2) != 0) {
        加行(输出, "    movk " + 寄存器 + ", #" + 整数转字符串(取片(值, 2)) + ", lsl #32");
    }
    如果 (取片(值, 3) != 0) {
        加行(输出, "    movk " + 寄存器 + ", #" + 整数转字符串(取片(值, 3)) + ", lsl #48");
    }
}

// ==================== 栈槽访问（偏移共用层，发射本层） ====================

// 槽地址：寄存器 = x29 + 偏移（|偏移| <= 4095 单条 add/sub；否则 movz/movk 再算）
函数 槽地址(向量<字符串> 输出, 字符串 寄存器, 整64 偏移) -> 空类型 {
    如果 (偏移 < 0) {
        整64 绝对值 = 0 - 偏移;
        如果 (绝对值 <= 4095) {
            加行(输出, "    sub " + 寄存器 + ", x29, #" + 整数转字符串(绝对值));
            返回;
        }
        装载立即数(输出, 寄存器, 绝对值);
        加行(输出, "    sub " + 寄存器 + ", x29, " + 寄存器);
        返回;
    }
    如果 (偏移 <= 4095) {
        加行(输出, "    add " + 寄存器 + ", x29, #" + 整数转字符串(偏移));
        返回;
    }
    装载立即数(输出, 寄存器, 偏移);
    加行(输出, "    add " + 寄存器 + ", x29, " + 寄存器);
}

// 读槽：寄存器 <- [x29 + 偏移]（直接寻址域外经 x13）
函数 读槽(向量<字符串> 输出, 字符串 寄存器, 整64 偏移) -> 空类型 {
    如果 (偏移 >= -256 && 偏移 <= 32760) {
        加行(输出, "    ldr " + 寄存器 + ", [x29, #" + 整数转字符串(偏移) + "]");
        返回;
    }
    槽地址(输出, "x13", 偏移);
    加行(输出, "    ldr " + 寄存器 + ", [x13]");
}

// 写槽：[x29 + 偏移] <- 寄存器（直接寻址域外经 x13）
函数 写槽(向量<字符串> 输出, 字符串 寄存器, 整64 偏移) -> 空类型 {
    如果 (偏移 >= -256 && 偏移 <= 32760) {
        加行(输出, "    str " + 寄存器 + ", [x29, #" + 整数转字符串(偏移) + "]");
        返回;
    }
    槽地址(输出, "x13", 偏移);
    加行(输出, "    str " + 寄存器 + ", [x13]");
}

// 110-a（2026-09-13 家机 win-x64）：结构体按值参数拷贝单点（源指针已在 x9）——
//   prologue 寄存器路径与栈参数路径共用（防两路分叉；x10=目标槽地址推进、
//   x11=剩余字节、x12=数据）。
函数 发射参数拷贝ARM64(向量<字符串> 输出, 整64 参数槽, 整64 最大寄存器,
                        整64 拷贝字节, 整64 函数序号) -> 空类型 {
    槽地址(输出, "x10", 变量槽偏移(参数槽, 最大寄存器));
    装载立即数(输出, "x11", 拷贝字节);
    字符串 参数拷贝标签 = 拷贝标签(函数序号, 输出.大小());
    加行(输出, 参数拷贝标签 + ":");
    加行(输出, "    cmp x11, #8");
    加行(输出, "    b.lt " + 参数拷贝标签 + "t");
    加行(输出, "    ldr x12, [x9], #8");
    加行(输出, "    str x12, [x10], #8");
    加行(输出, "    sub x11, x11, #8");
    加行(输出, "    b " + 参数拷贝标签);
    加行(输出, 参数拷贝标签 + "t:");
    加行(输出, "    cbz x11, " + 参数拷贝标签 + "d");
    加行(输出, "    ldrb w12, [x9], #1");
    加行(输出, "    strb w12, [x10], #1");
    加行(输出, "    sub x11, x11, #1");
    加行(输出, "    b " + 参数拷贝标签 + "t");
    加行(输出, 参数拷贝标签 + "d:");
}

// ==================== 单指令生成 ====================
// 生成一条 IR 指令的 GAS 文本到 输出（对齐 代码生成.cn 生成指令 的逐操作码结构）。
// 槽基数（retbuf 地址计算）、retbuf槽数（②b B6 基槽决策）与 函数序号（标签唯一化）
//   入参；实参们=前导 IR_调用实参 声明性指令序列（IR_调用参数化 统一展开）。
函数 生成指令ARM64(IR指令 指令, 整64 最大寄存器, 整64 槽基数, 整64 retbuf槽数,
                   整64 函数序号, 向量<IR指令> 实参们, 向量<字符串> 输出) -> 空类型 {
    加行(输出, "    // op=" + 整数转字符串(指令.操作码));
    如果 (编码数据移动ARM64(指令, 最大寄存器, 输出)) { 返回; }
    如果 (编码算术ARM64(指令, 输出)) { 返回; }
    如果 (编码比较一元ARM64(指令, 输出)) { 返回; }
    如果 (编码类型转换ARM64(指令, 输出)) { 返回; }
    如果 (编码访存ARM64(指令, 最大寄存器, 输出)) { 返回; }
    如果 (编码控制流ARM64(指令, 函数序号, 输出)) { 返回; }
    如果 (编码对象调用ARM64(指令, 最大寄存器, 槽基数, retbuf槽数, 函数序号, 实参们, 输出)) { 返回; }
    如果 (编码静态ARM64(指令, 输出)) { 返回; }
    // IR_分配 等：prologue 预留帧，此处 no-op（win64 同款）
}

// ==================== 指令编码函数组（R4，2026-09-08 自 生成指令ARM64 机械搬移） ====================
// 每函数收同款上下文返回 布尔=该操作码是否由本组处理（真=已发射）——分组与
//   win64 后端（代码生成.cn）同构。

// 数据移动组：常量整数（负值 neg）/常量字符串（adrp+add）/槽加载/槽存储。
函数 编码数据移动ARM64(IR指令 指令, 整64 最大寄存器, 向量<字符串> 输出) -> 布尔 {
    如果 (指令.操作码 == IR_常量整数) {
        // 常量整数：操作数1 = Symbol ID（文本，经共用层位模式解析——进制前缀/
        //   类型后缀剥离）；负值补码位模式（绝对值装载 + neg）
        整64 值 = 字面量位模式(驻留文本(指令.操作数1));
        如果 (值 < 0) {
            装载立即数(输出, "x9", 0 - 值);
            加行(输出, "    neg x9, x9");
        } 否则 {
            装载立即数(输出, "x9", 值);
        }
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_常量浮点) {
        // 浮点常量（89-a）：.data floatData_<文本ID>（.double 文本直通）——
        //   adrp+add 取址 + ldr 8 字节装载（宿主 ConstFloat 同款语义）
        加行(输出, "    adrp x9, floatData_" + 整数转字符串(指令.操作数1));
        加行(输出, "    add x9, x9, :lo12:floatData_" + 整数转字符串(指令.操作数1));
        加行(输出, "    ldr x9, [x9]");
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_常量字符串) {
        // 字符串常量：adrp+add 取 .data 数据标签地址（-no-pie 链接；宿主同款）
        加行(输出, "    adrp x9, strData_" + 整数转字符串(指令.操作数1));
        加行(输出, "    add x9, x9, :lo12:strData_" + 整数转字符串(指令.操作数1));
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_加载) {
        读槽(输出, "x9", 变量槽偏移(指令.操作数1, 最大寄存器));
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_存储) {
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
        写槽(输出, "x9", 变量槽偏移(指令.附加, 最大寄存器));
        返回 真;
    }
    返回 假;
}

// 算术组：加/减/乘/除（sdiv）/取余（sdiv+msub——宿主无专用 rem 同式）。
函数 编码算术ARM64(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    // 91-a（2026-09-13 第九十一轮）：浮点算术（指令.类型=T_浮32/T_浮64）——
    //   NEON 标量 fadd/fsub/fmul/fdiv（浮64 用 dN、浮32 用 sN；读槽/写槽
    //   辅助直接复用——ldr d0, [x29,#off] 与整数同构）。取余 % 不在浮点面内。
    布尔 是浮点算术a = (指令.类型 == T_浮32 || 指令.类型 == T_浮64);
    如果 (是浮点算术a && (指令.操作码 == IR_加 || 指令.操作码 == IR_减 ||
                        指令.操作码 == IR_乘 || 指令.操作码 == IR_除)) {
        字符串 前缀a = (指令.类型 == T_浮64) ? "d" : "s";
        字符串 运算a = "fadd";
        如果 (指令.操作码 == IR_减) { 运算a = "fsub"; }
        否则 如果 (指令.操作码 == IR_乘) { 运算a = "fmul"; }
        否则 如果 (指令.操作码 == IR_除) { 运算a = "fdiv"; }
        读槽(输出, 前缀a + "0", 寄存器槽偏移(指令.操作数1));
        读槽(输出, 前缀a + "1", 寄存器槽偏移(指令.操作数2));
        加行(输出, "    " + 运算a + " " + 前缀a + "0, " + 前缀a + "0, " + 前缀a + "1");
        写槽(输出, 前缀a + "0", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_加) {
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
        读槽(输出, "x10", 寄存器槽偏移(指令.操作数2));
        加行(输出, "    add x9, x9, x10");
        // 264-a D34 波1：32 位类型出口截断（整32 sxtw 符号扩展/正32 uxtw 清高）
        如果 (指令.类型 == T_整32) {
            加行(输出, "    sxtw x9, w9");
        } 否则 如果 (指令.类型 == T_正32) {
            加行(输出, "    uxtw x9, w9");
        }
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_减) {
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
        读槽(输出, "x10", 寄存器槽偏移(指令.操作数2));
        加行(输出, "    sub x9, x9, x10");
        // 264-a D34 波1：32 位类型出口截断（整32 sxtw 符号扩展/正32 uxtw 清高）
        如果 (指令.类型 == T_整32) {
            加行(输出, "    sxtw x9, w9");
        } 否则 如果 (指令.类型 == T_正32) {
            加行(输出, "    uxtw x9, w9");
        }
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_乘) {
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
        读槽(输出, "x10", 寄存器槽偏移(指令.操作数2));
        加行(输出, "    mul x9, x9, x10");
        // 264-a D34 波1：32 位类型出口截断（整32 sxtw 符号扩展/正32 uxtw 清高）
        如果 (指令.类型 == T_整32) {
            加行(输出, "    sxtw x9, w9");
        } 否则 如果 (指令.类型 == T_正32) {
            加行(输出, "    uxtw x9, w9");
        }
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_除) {
        // 46-f 第五十轮：无符号（指令.类型=T_正32/正64）udiv；有符号 sdiv
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
        读槽(输出, "x10", 寄存器槽偏移(指令.操作数2));
        如果 (指令.类型 == T_正32 || 指令.类型 == T_正64) {
            加行(输出, "    udiv x9, x9, x10");
        } 否则 {
            加行(输出, "    sdiv x9, x9, x10");
        }
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_取余) {
        // 余数 = a - b * (a / b)：sdiv/udiv（46-f 第五十轮按类型分派）后 msub
        //   （宿主无专用 rem 指令，同式）
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
        读槽(输出, "x10", 寄存器槽偏移(指令.操作数2));
        如果 (指令.类型 == T_正32 || 指令.类型 == T_正64) {
            加行(输出, "    udiv x11, x9, x10");
        } 否则 {
            加行(输出, "    sdiv x11, x9, x10");
        }
        加行(输出, "    msub x9, x11, x10, x9");
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    // 位运算（2026-09-09 规范 01b§5.4）：and/orr/eor 单指令；移位 lsl/asr 寄存器
    //   形式——265-a 波A：移位量已显式按类型位宽取模（原「x=64 取模=规范语义」
    //   前提错误）；>> 有符号=算术 asr / 无符号=lsr（46-f）
    如果 (指令.操作码 == IR_位与 || 指令.操作码 == IR_位或 || 指令.操作码 == IR_位异或) {
        字符串 位指令 = "and";
        如果 (指令.操作码 == IR_位或) { 位指令 = "orr"; }
        如果 (指令.操作码 == IR_位异或) { 位指令 = "eor"; }
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
        读槽(输出, "x10", 寄存器槽偏移(指令.操作数2));
        加行(输出, "    " + 位指令 + " x9, x9, x10");
        // 264-a D34 波1：32 位类型出口截断（整32 sxtw 符号扩展/正32 uxtw 清高）
        如果 (指令.类型 == T_整32) {
            加行(输出, "    sxtw x9, w9");
        } 否则 如果 (指令.类型 == T_正32) {
            加行(输出, "    uxtw x9, w9");
        }
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_左移 || 指令.操作码 == IR_右移) {
        // 46-f 第五十轮：>> 无符号（T_正32/正64）=lsr（逻辑）；有符号=asr（算术）
        字符串 移指令 = "lsl";
        如果 (指令.操作码 == IR_右移) {
            如果 (指令.类型 == T_正32 || 指令.类型 == T_正64) { 移指令 = "lsr"; }
            否则 { 移指令 = "asr"; }
        }
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
        读槽(输出, "x10", 寄存器槽偏移(指令.操作数2));
        // 265-a 波A（规范 01b§5.4）：移位量显式按操作数位宽取模——32 位类型
        //   and x10, x10, #31（x9 形式=mod 64≠32 位语义）；结果按类型截断
        如果 (指令.类型 == T_整32 || 指令.类型 == T_正32) {
            加行(输出, "    and x10, x10, #31");
        } 否则 {
            加行(输出, "    and x10, x10, #63");
        }
        加行(输出, "    " + 移指令 + " x9, x9, x10");
        如果 (指令.类型 == T_整32) {
            加行(输出, "    sxtw x9, w9");
        } 否则 如果 (指令.类型 == T_正32) {
            加行(输出, "    uxtw x9, w9");
        }
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    返回 假;
}

// 比较与一元组：cmp+cset 六比较 / 逻辑非 / 一元负；91-a 增浮点分派。
函数 编码比较一元ARM64(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    // 91-a：浮点比较——fcmp + cset（eq/ne/mi/ls/gt/ge——宿主 arm64 后端同映射，
    //   NaN 时全假除 != 真，IEEE ordered 语义天然正确；x86 两后端经 H1 修复对齐）。
    布尔 是浮点比较a = (指令.类型 == T_浮32 || 指令.类型 == T_浮64);
    如果 (是浮点比较a && (指令.操作码 == IR_相等 || 指令.操作码 == IR_不等 ||
                        指令.操作码 == IR_小于 || 指令.操作码 == IR_大于 ||
                        指令.操作码 == IR_小于等于 || 指令.操作码 == IR_大于等于)) {
        字符串 前缀a = (指令.类型 == T_浮64) ? "d" : "s";
        字符串 条件a = "eq";
        如果 (指令.操作码 == IR_不等) { 条件a = "ne"; }
        否则 如果 (指令.操作码 == IR_小于) { 条件a = "mi"; }
        否则 如果 (指令.操作码 == IR_大于) { 条件a = "gt"; }
        否则 如果 (指令.操作码 == IR_小于等于) { 条件a = "ls"; }
        否则 如果 (指令.操作码 == IR_大于等于) { 条件a = "ge"; }
        读槽(输出, 前缀a + "0", 寄存器槽偏移(指令.操作数1));
        读槽(输出, 前缀a + "1", 寄存器槽偏移(指令.操作数2));
        加行(输出, "    fcmp " + 前缀a + "0, " + 前缀a + "1");
        加行(输出, "    cset x9, " + 条件a);
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_相等 || 指令.操作码 == IR_不等 ||
        指令.操作码 == IR_小于 || 指令.操作码 == IR_大于 ||
        指令.操作码 == IR_小于等于 || 指令.操作码 == IR_大于等于) {
        // 比较：cmp + cset（win64 setcc 的 ARM64 等价）。46-f 第五十轮：无符号
        //   操作数（T_正32/正64）用无符号条件码 lo/hi/ls/hs（2^63>100 按
        //   负数 gt 判假=静默错误）
        整64 无符号 = (指令.类型 == T_正32 || 指令.类型 == T_正64) ? 1 : 0;
        字符串 条件 = "eq";
        如果 (指令.操作码 == IR_不等) { 条件 = "ne"; }
        否则 如果 (指令.操作码 == IR_小于) { 条件 = 无符号 == 1 ? "lo" : "lt"; }
        否则 如果 (指令.操作码 == IR_大于) { 条件 = 无符号 == 1 ? "hi" : "gt"; }
        否则 如果 (指令.操作码 == IR_小于等于) { 条件 = 无符号 == 1 ? "ls" : "le"; }
        否则 如果 (指令.操作码 == IR_大于等于) { 条件 = 无符号 == 1 ? "hs" : "ge"; }
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
        读槽(输出, "x10", 寄存器槽偏移(指令.操作数2));
        加行(输出, "    cmp x9, x10");
        加行(输出, "    cset x9, " + 条件);
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_逻辑非) {
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
        加行(输出, "    cmp x9, #0");
        加行(输出, "    cset x9, eq");
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_负) {
        // 91-a：浮点取负=fneg（±0/NaN 与 IEEE negate 一致）；整数 neg 原路径
        如果 (指令.类型 == T_浮32 || 指令.类型 == T_浮64) {
            字符串 前缀a = (指令.类型 == T_浮64) ? "d" : "s";
            读槽(输出, 前缀a + "0", 寄存器槽偏移(指令.操作数1));
            加行(输出, "    fneg " + 前缀a + "0, " + 前缀a + "0");
            写槽(输出, 前缀a + "0", 寄存器槽偏移(指令.目标));
            返回 真;
        }
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
        加行(输出, "    neg x9, x9");
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    返回 假;
}

// 类型转换组：sxtw/sxtb/sxth 符号扩展 + uxtb/uxth 零扩展（灰色点④+缺陷零容忍收口）。
//   T_正64（方案甲 2026-09-10 第五十一轮）=64 位源直拷：读槽/写槽本就 x 寄存器
//   64 位全读全写，无扩展指令直通（同宽位模式重解释，2^63 转 i64 = -2^63；
//   x64 双后端 mov 全读对称）——宽扩展指令链无 T_正64 分支即直通，此处注释固化。
函数 编码类型转换ARM64(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    如果 (指令.操作码 == IR_类型转换) {
        // 91-a（2026-09-13 第九十一轮）：浮点转换分派（源码=操作数2，目标码=
        //   类型字段）——浮->浮（fcvt 宽化/窄化；同码直拷）、整->浮（scvtf 有符号；
        //   正N 经 uxtb/uxth/uxtw 零扩展后 ucvtf——ARM64 原生无符号转换）、
        //   浮->整（fcvtzs 向零截断；正32 目标 w9 写清高 32=零扩展）。
        整64 源码c = 指令.操作数2;
        布尔 源浮c = (源码c == T_浮32 || 源码c == T_浮64);
        布尔 目标浮c = (指令.类型 == T_浮32 || 指令.类型 == T_浮64);
        如果 (源浮c || 目标浮c) {
            如果 (源浮c && 目标浮c) {
                如果 (源码c == 指令.类型) {
                    读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
                    写槽(输出, "x9", 寄存器槽偏移(指令.目标));
                } 否则 如果 (源码c == T_浮32) {
                    读槽(输出, "s0", 寄存器槽偏移(指令.操作数1));
                    加行(输出, "    fcvt d0, s0");
                    写槽(输出, "d0", 寄存器槽偏移(指令.目标));
                } 否则 {
                    读槽(输出, "d0", 寄存器槽偏移(指令.操作数1));
                    加行(输出, "    fcvt s0, d0");
                    写槽(输出, "s0", 寄存器槽偏移(指令.目标));
                }
                返回 真;
            }
            如果 (目标浮c) {
                字符串 前缀a = (指令.类型 == T_浮64) ? "d" : "s";
                读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
                如果 (源码c == T_整32) {
                    加行(输出, "    sxtw x9, w9");
                } 否则 如果 (源码c == T_正32) {
                    加行(输出, "    uxtw x9, w9");
                } 否则 如果 (源码c == T_整8) {
                    加行(输出, "    sxtb x9, w9");
                } 否则 如果 (源码c == T_整16) {
                    加行(输出, "    sxth x9, w9");
                } 否则 如果 (源码c == T_正8) {
                    加行(输出, "    uxtb x9, w9");
                } 否则 如果 (源码c == T_正16) {
                    加行(输出, "    uxth x9, w9");
                }
                布尔 无符号a = (源码c == T_正32 || 源码c == T_正64 ||
                              源码c == T_正8 || 源码c == T_正16);
                如果 (无符号a) {
                    加行(输出, "    ucvtf " + 前缀a + "0, x9");
                } 否则 {
                    加行(输出, "    scvtf " + 前缀a + "0, x9");
                }
                写槽(输出, 前缀a + "0", 寄存器槽偏移(指令.目标));
                返回 真;
            }
            字符串 前缀a = (源码c == T_浮64) ? "d" : "s";
            读槽(输出, 前缀a + "0", 寄存器槽偏移(指令.操作数1));
            如果 (指令.类型 == T_正32) {
                加行(输出, "    fcvtzs w9, " + 前缀a + "0");
            } 否则 {
                加行(输出, "    fcvtzs x9, " + 前缀a + "0");
            }
            写槽(输出, "x9", 寄存器槽偏移(指令.目标));
            返回 真;
        }
        // 整64 -> 整32 截断+符号扩展（sxtw）；其余按 整64 槽透传（win64 同款语义）
        // 灰色点④根治（2026-09-04）：窄宽目标 整8/整16——sxtb/sxth 低 8/16 位
        //   符号扩展（整8(300)=44 截断语义；win 侧 mov al/movsx 同款，双侧对称）
        // 分派面（第五十五轮标注）：正8/正16 变量源经 类型码() 归一登记 T_整64，
        //   方案甲源分派改标 T_正64→无分支命中=直通 64 位拷贝（读槽/写槽 x 寄存器
        //   全读全写）——正确性=64 位槽零扩展写入保证高位干净；结构体字段层经
        //   类型宽度码() T_整8/16 窄宽读回（uxtb/uxth 对称 movzx）独立正确
        //   （E2E 194 双侧锚定）
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
        如果 (指令.类型 == T_整32) {
            加行(输出, "    sxtw x9, w9");
        } 否则 如果 (指令.类型 == T_正32) {
            // 46-f 第五十轮：正32 零扩展读回（uxtw 对称 movzx）
            加行(输出, "    uxtw x9, w9");
        } 否则 如果 (指令.类型 == T_整8) {
            加行(输出, "    sxtb x9, w9");
        } 否则 如果 (指令.类型 == T_整16) {
            加行(输出, "    sxth x9, w9");
        } 否则 如果 (指令.类型 == T_正8) {
            // 2026-09-04 缺陷零容忍收口：无符号窄宽零扩展（win movzx 对称）
            加行(输出, "    uxtb w9, w9");
        } 否则 如果 (指令.类型 == T_正16) {
            加行(输出, "    uxth w9, w9");
        }
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    返回 假;
}

// 访存组：返回（x0）/ 取地址（槽地址）/ 指针加载（ldrsb/ldrb/ldrh/ldr 宽度分级）/
//   指针存储（strb/strh/str 宽度分级——126 段① OOM 根治）。
函数 编码访存ARM64(IR指令 指令, 整64 最大寄存器, 向量<字符串> 输出) -> 布尔 {
    如果 (指令.操作码 == IR_返回) {
        // 返回值 -> x0 / d0（91-a：类型字段=返回类型码——浮点值返回走 d0/s0，
        //   AAPCS64 浮点返回寄存器；0=无返回值；epilogue 在函数尾块统一）
        如果 (指令.操作数1 != 0) {
            如果 (指令.类型 == T_浮32) {
                读槽(输出, "s0", 寄存器槽偏移(指令.操作数1));
            } 否则 如果 (指令.类型 == T_浮64) {
                读槽(输出, "d0", 寄存器槽偏移(指令.操作数1));
            } 否则 {
                读槽(输出, "x0", 寄存器槽偏移(指令.操作数1));
            }
        } 否则 {
            加行(输出, "    movz x0, #0");
        }
        返回 真;
    }
    如果 (指令.操作码 == IR_取地址) {
        槽地址(输出, "x9", 变量槽偏移(指令.操作数1, 最大寄存器));
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_指针加载) {
        // 经指针加载；字段宽度（②b B5）：布尔/整8/字符 1 字节、整16 2、整32 4、
        //   默认 8——w 寄存器写零扩展高位（ldrb/ldrh/ldr w 天然零扩展）
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
        如果 (指令.类型 == T_字节 || 指令.类型 == T_整8) {
            // 347-a（T33 残余根治）：字符串[i]（A-1）+ **有符号整8**——符号扩展
            加行(输出, "    ldrsb x9, [x9]");
        } 否则 如果 (指令.类型 == T_布尔 || 指令.类型 == T_字符 || 指令.类型 == T_正8) {
            加行(输出, "    ldrb w9, [x9]");
        } 否则 如果 (指令.类型 == T_整16) {
            // 347-a：整16 有符号——符号扩展（原零扩展 → 负值读回错值）
            加行(输出, "    ldrsh x9, [x9]");
        } 否则 如果 (指令.类型 == T_正16) {
            加行(输出, "    ldrh w9, [x9]");
        } 否则 如果 (指令.类型 == T_整32 || 指令.类型 == T_正32) {
            // T_正32（46-f）：ldr w 天然零扩展
            // 266-a 波B：T_整32（有符号）ldrsw 符号扩展
            如果 (指令.类型 == T_整32) {
                加行(输出, "    ldrsw x9, [x9]");
            } 否则 {
                加行(输出, "    ldr w9, [x9]");
            }
        } 否则 {
            加行(输出, "    ldr x9, [x9]");
        }
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_指针存储) {
        // 经指针存储；字段宽度（②b B5）：旧固定 8 字节写越界清零相邻槽（126 段①
        //   当循环死循环 -> 堆 OOM 根因）——按 指令.类型 宽度发射；0/默认 8 字节
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
        读槽(输出, "x10", 寄存器槽偏移(指令.操作数2));
        如果 (指令.类型 == T_布尔 || 指令.类型 == T_整8 || 指令.类型 == T_字符 ||
             指令.类型 == T_正8) {
            // 347-a（同族旁路穷尽）：正8 原落默认 8 字节写=过写越界
            加行(输出, "    strb w10, [x9]");
        } 否则 如果 (指令.类型 == T_整16 || 指令.类型 == T_正16) {
            // 347-a：正16 原落默认 8 字节写=过写越界
            加行(输出, "    strh w10, [x9]");
        } 否则 如果 (指令.类型 == T_整32 || 指令.类型 == T_正32) {
            // T_正32（46-f）：str w 天然截断（wrapping mod 2^32）
            加行(输出, "    str w10, [x9]");
        } 否则 {
            加行(输出, "    str x10, [x9]");
        }
        返回 真;
    }
    返回 假;
}

// 控制流组：字段地址（#立即数<=4095 否则经 x13）/ 块标签 / b / cbnz+b。
函数 编码控制流ARM64(IR指令 指令, 整64 函数序号, 向量<字符串> 输出) -> 布尔 {
    如果 (指令.操作码 == IR_字段地址) {
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
        如果 (指令.附加 != 0) {
            如果 (指令.附加 <= 4095) {
                加行(输出, "    add x9, x9, #" + 整数转字符串(指令.附加));
            } 否则 {
                装载立即数(输出, "x10", 指令.附加);
                加行(输出, "    add x9, x9, x10");
            }
        }
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_标签) {
        加行(输出, 块标签(函数序号, 指令.附加) + ":");
        返回 真;
    }
    如果 (指令.操作码 == IR_跳转) {
        加行(输出, "    b " + 块标签(函数序号, 指令.附加));
        返回 真;
    }
    如果 (指令.操作码 == IR_条件跳转) {
        // 条件寄存器 非零 -> 真块（cbnz）；否则假块
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
        加行(输出, "    cbnz x9, " + 块标签(函数序号, 指令.操作数2));
        加行(输出, "    b " + 块标签(函数序号, 指令.操作数3));
        返回 真;
    }
    返回 假;
}

// 对象与调用组：分配对象（bl __cn_object_new）/ 结构体拷贝（8 字节字循环+字节尾巴）/
//   删除对象（cbz 空安全+析构+释放）/ 调用参数化（位<8 寄存器 x0-x7、>=8 栈区，
//   栈实参先经 x9 中转装载）。
函数 编码对象调用ARM64(IR指令 指令, 整64 最大寄存器, 整64 槽基数, 整64 retbuf槽数, 整64 函数序号,
                       向量<IR指令> 实参们, 向量<字符串> 输出) -> 布尔 {
    如果 (指令.操作码 == IR_分配对象) {
        // NewObject：x0=大小 -> __cn_object_new -> x0（AAPCS64 无影子空间）
        装载立即数(输出, "x0", 指令.类型);
        加行(输出, "    bl __cn_object_new");
        写槽(输出, "x0", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_结构体拷贝) {
        // CopyStruct：x9=目标地址 x10=源地址 x11=剩余字节；8 字节字循环 + 字节尾巴
        //   （ARM64 无 rep movsb；后索引寻址 [xn], #8/#1 逐块搬运）
        字符串 循环标签 = 拷贝标签(函数序号, 输出.大小());
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数2));
        读槽(输出, "x10", 寄存器槽偏移(指令.操作数1));
        装载立即数(输出, "x11", 指令.类型);
        加行(输出, 循环标签 + ":");
        加行(输出, "    cmp x11, #8");
        加行(输出, "    b.lt " + 循环标签 + "t");
        加行(输出, "    ldr x12, [x10], #8");
        加行(输出, "    str x12, [x9], #8");
        加行(输出, "    sub x11, x11, #8");
        加行(输出, "    b " + 循环标签);
        加行(输出, 循环标签 + "t:");
        加行(输出, "    cbz x11, " + 循环标签 + "d");
        加行(输出, "    ldrb w12, [x10], #1");
        加行(输出, "    strb w12, [x9], #1");
        加行(输出, "    sub x11, x11, #1");
        加行(输出, "    b " + 循环标签 + "t");
        加行(输出, 循环标签 + "d:");
        返回 真;
    }
    如果 (指令.操作码 == IR_删除对象) {
        // DeleteObject：空安全（cbz）+ ~类(this) + __cn_object_delete(this)
        字符串 标签 = 对象删除标签(函数序号, 指令.目标);
        字符串 析构名 = 符号修饰ARM64(析构符号(驻留文本(指令.附加)));
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
        加行(输出, "    cbz x9, " + 标签);
        加行(输出, "    mov x0, x9");
        加行(输出, "    bl " + 析构名);
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
        加行(输出, "    mov x0, x9");
        加行(输出, "    bl __cn_object_delete");
        加行(输出, 标签 + ":");
        返回 真;
    }
    如果 (指令.操作码 == IR_调用参数化) {
        // 调用统一展开（用户裁决项3 参数区）：总位数=操作数1（含 retbuf/this）。
        // 91-a（2026-09-13 第九十一轮）：AAPCS64 双计数参数分配（共用层
        //   分配参数位置 单点：整型 8 / 浮点 8 独立计数）——整型类 x0-x7、
        //   浮点类 d0-d7（浮32 s0-s7）；各自溢出按声明序共享栈参数区
        //   [sp, #栈位号*8]（被调方 [x29, #16+栈位号*8]，无影子空间）。返回：
        //   浮点码（操作数2）-> d0 装载，其余 -> x0。栈区 16 对齐，bl 前
        //   sp 恒 16 对齐（帧对齐 + 对齐栈区）。
        整64 总位数 = 指令.操作数1;
        向量<整64> 实参码们 = 向量<整64>();
        整64 码i0 = 0;
        当 (码i0 < 实参们.大小()) {
            结果<空类型, 整32> 加码0 = 实参码们.追加(实参们.元素(码i0).操作数2);
            如果 (!加码0.正常) { 运行时错误(4); }
            码i0++;
        }
        向量<整64> 类们 = 向量<整64>();
        向量<整64> 号们 = 向量<整64>();
        分配参数位置(实参码们, 8, 8, 指令.类型 != 0, 类们, 号们);
        整64 栈游标 = 0;
        整64 栈i0 = 0;
        当 (栈i0 < 类们.大小()) {
            如果 (类们.元素(栈i0) == 2) { 栈游标++; }
            栈i0++;
        }
        整64 栈区 = 栈游标 * 8;
        如果 (栈区 % 16 != 0) { 栈区 = 栈区 + 8; }
        如果 (栈区 > 0) {
            如果 (栈区 <= 4095) {
                加行(输出, "    sub sp, sp, #" + 整数转字符串(栈区));
            } 否则 {
                装载立即数(输出, "x13", 栈区);
                加行(输出, "    sub sp, sp, x13");
            }
        }
        // retbuf（位 0）：x0 = 返回缓冲槽地址（②b B6：基槽=槽基数+retbuf槽数，
        //   序号恒 1 共享单缓冲——按真实返回字节数定尺寸）
        如果 (指令.类型 != 0) {
            槽地址(输出, "x0", 变量槽偏移(retbuf基槽(槽基数, retbuf槽数), 最大寄存器));
        }
        // 栈实参先装载（经 x9/d0 中转，不扰 x0-x7）
        整64 a = 0;
        当 (a < 实参们.大小()) {
            IR指令 实参 = 实参们.元素(a);
            如果 (类们.元素(a) == 2) {
                字符串 偏移a = 整数转字符串(号们.元素(a) * 8);
                如果 (实参.操作数2 == T_浮32 || 实参.操作数2 == T_浮64) {
                    字符串 前缀a = (实参.操作数2 == T_浮64) ? "d" : "s";
                    读槽(输出, 前缀a + "0", 寄存器槽偏移(实参.操作数1));
                    加行(输出, "    str " + 前缀a + "0, [sp, #" + 偏移a + "]");
                } 否则 {
                    读槽(输出, "x9", 寄存器槽偏移(实参.操作数1));
                    加行(输出, "    str x9, [sp, #" + 偏移a + "]");
                }
            }
            a++;
        }
        // 寄存器实参（整型类 x0-x7 / 浮点类 d0-d7——分配表分派）
        整64 b = 0;
        当 (b < 实参们.大小()) {
            IR指令 实参2 = 实参们.元素(b);
            整64 类b = 类们.元素(b);
            如果 (类b == 0) {
                读槽(输出, "x" + 整数转字符串(号们.元素(b)), 寄存器槽偏移(实参2.操作数1));
            } 否则 如果 (类b == 1) {
                字符串 前缀b = (实参2.操作数2 == T_浮64) ? "d" : "s";
                读槽(输出, 前缀b + 整数转字符串(号们.元素(b)), 寄存器槽偏移(实参2.操作数1));
            }
            b++;
        }
        加行(输出, "    bl " + 符号修饰ARM64(驻留文本(指令.附加)));
        如果 (栈区 > 0) {
            如果 (栈区 <= 4095) {
                加行(输出, "    add sp, sp, #" + 整数转字符串(栈区));
            } 否则 {
                装载立即数(输出, "x13", 栈区);
                加行(输出, "    add sp, sp, x13");
            }
        }
        如果 (指令.目标 != 0) {
            如果 (指令.操作数2 == T_浮32) {
                写槽(输出, "s0", 寄存器槽偏移(指令.目标));
            } 否则 如果 (指令.操作数2 == T_浮64) {
                写槽(输出, "d0", 寄存器槽偏移(指令.目标));
            } 否则 {
                // 111-a：≤32 位返回类型高位规范化（AAPCS64 窄返回值只在 w0 有效——
                //   w0 写入清 x0 高 32 位，但低 32 位内高位仍可能非零；**低 32 位是
                //   权威值**，扩展方式与 v2 内部表示一致：整32=有符号（类型转换生成
                //   sxtw 符号扩展，零扩展会破坏负值语义）；正32=零扩展；布尔=0/1 零扩展。
                //   对齐 Rust/LLVM signext/zeroext——与 win/X64L 同款纪律，三后端同治。
                整64 返回码n = 指令.操作数2;
                如果 (返回码n == T_布尔) {
                    加行(输出, "    uxtb w0, w0");
                }
                如果 (返回码n == T_整32) {
                    加行(输出, "    sxtw x0, w0");
                }
                如果 (返回码n == T_正32) {
                    加行(输出, "    mov w0, w0");
                }
                写槽(输出, "x0", 寄存器槽偏移(指令.目标));
            }
        }
        返回 真;
    }
    返回 假;
}

// 静态组：静态槽读/地址/写（adrp+:lo12: 重定位）。
函数 编码静态ARM64(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    如果 (指令.操作码 == IR_静态加载) {
        // ②c C：静态槽读——adrp+ldr :lo12: 重定位（-no-pie；宿主 strData 同款模式）
        加行(输出, "    adrp x9, " + 静态槽标签(指令.附加));
        加行(输出, "    ldr x9, [x9, :lo12:" + 静态槽标签(指令.附加) + "]");
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_静态地址) {
        // 静态槽地址（adrp+add）——拷贝构造源 T& 传静态容器左值地址
        加行(输出, "    adrp x9, " + 静态槽标签(指令.附加));
        加行(输出, "    add x9, x9, :lo12:" + 静态槽标签(指令.附加));
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_静态存储) {
        // ②c C：静态槽写——adrp x9 + str（值经 x10 中转）
        读槽(输出, "x10", 寄存器槽偏移(指令.操作数1));
        加行(输出, "    adrp x9, " + 静态槽标签(指令.附加));
        加行(输出, "    str x10, [x9, :lo12:" + 静态槽标签(指令.附加) + "]");
        返回 真;
    }
    返回 假;
}


// ==================== 函数生成 ====================
// 生成单函数完整 GAS：.globl/.type/标签 / prologue / 参数装载 / 指令 / epilogue。
// 帧大小 = (最大寄存器 + 最大槽) * 8 + 8，16 对齐（win64 同式——x29 锚定槽区）。
函数 生成函数ARM64(函数IR 函数信息, 整64 函数序号, 向量<字符串> 输出) -> 空类型 {
    整64 最大寄存器 = 0;
    整64 最大槽 = 0;
    整64 槽基数 = 0;
    扫描函数(函数信息, &最大寄存器, &最大槽, &槽基数);
    整64 retbuf槽数 = retbuf槽位数(函数信息);    // ②b B6：与 扫描函数 同一决策
    整64 帧大小 = 计算帧大小(最大寄存器, 最大槽);
    字符串 函数名 = 符号修饰ARM64(驻留文本(整64(函数信息.名字)));
    加行(输出, ".globl " + 函数名);
    加行(输出, ".type " + 函数名 + ", %function");
    加行(输出, 函数名 + ":");
    加行(输出, "    stp x29, x30, [sp, #-16]!");
    加行(输出, "    mov x29, sp");
    如果 (帧大小 <= 4095) {
        加行(输出, "    sub sp, sp, #" + 整数转字符串(帧大小));
    } 否则 {
        装载立即数(输出, "x13", 帧大小);
        加行(输出, "    sub sp, sp, x13");
    }
    // AAPCS64 参数装载（②b B8 按声明序：参数槽序们/参数拷贝字节们）——标量：
    //   前 8 位 x0~x7 直存，第 9 位起 [x29, #16+(位-8)*8]（宿主同式）；结构体按值：
    //   入参为指针（B3 调用方约定）-> x9 取指针、x10=目标基槽地址，字循环拷贝
    //   真实字节入槽（IR_结构体拷贝 同款循环——基址槽=最大槽号=最低地址，向上写）
    // 用户函数返回结构体（2026-09-04，E2E 148，win 侧对称）：位 0（x0）=调用方
    //   传入的 retbuf 指针——存槽 1（生成函数 已保留）；声明参数位号整体 +1。
    布尔 返回结构体 = 函数信息.返回结构体ID != 0 || 函数信息.返回结果名ID != 0;   // 71-a：结果/可选 返回同款 retbuf ABI
    如果 (返回结构体) {
        写槽(输出, "x0", 变量槽偏移(1, 最大寄存器));
    }
    // 91-a（2026-09-13 第九十一轮）：AAPCS64 双计数参数装载（共用层 分配参数位置
    //   单点）——整型类 x0-x7（8）；浮点类 d0-d7（浮32 s0-s7；独立计数）；
    //   各自溢出按声明序共享栈参区 [x29, #16+栈位号*8]。
    向量<整64> 类们p = 向量<整64>();
    向量<整64> 号们p = 向量<整64>();
    分配参数位置(函数信息.参数类型们, 8, 8, 返回结构体, 类们p, 号们p);
    整64 参数序 = 0;
    当 (参数序 < 函数信息.参数槽序们.大小()) {
        整64 参数槽 = 函数信息.参数槽序们.元素(参数序);
        整64 拷贝字节 = 函数信息.参数拷贝字节们.元素(参数序);
        整64 类p = 0;
        整64 号p = 0;
        如果 (参数序 < 类们p.大小()) {
            类p = 类们p.元素(参数序);
            号p = 号们p.元素(参数序);
        }
        整64 参类p = 0;
        如果 (参数序 < 函数信息.参数类型们.大小()) {
            参类p = 函数信息.参数类型们.元素(参数序);
        }
        如果 (类p == 1) {
            字符串 前缀p = (参类p == T_浮64) ? "d" : "s";
            写槽(输出, 前缀p + 整数转字符串(号p), 变量槽偏移(参数槽, 最大寄存器));
        } 否则 如果 (类p == 2) {
            如果 (拷贝字节 > 0) {
                // 110-a：结构体按值栈参数（B3 约定=指针传入，调用方写指针）——
                //   从栈位取源指针后拷贝入槽（寄存器路径同款）。原实现落下方
                //   标量路径只存 8 字节指针 → 被调方按内联数据访问 → 数据错
                //   （E2E 158_v2 分歧面③ win 侧实证；AAPCS64 ≥9 结构体参数才触发）。
                读槽(输出, "x9", 16 + 号p * 8);
                发射参数拷贝ARM64(输出, 参数槽, 最大寄存器, 拷贝字节, 函数序号);
            } 否则 如果 (参类p == T_浮32 || 参类p == T_浮64) {
                字符串 前缀p = (参类p == T_浮64) ? "d" : "s";
                读槽(输出, 前缀p + "0", 16 + 号p * 8);
                写槽(输出, 前缀p + "0", 变量槽偏移(参数槽, 最大寄存器));
            } 否则 {
                读槽(输出, "x9", 16 + 号p * 8);
                写槽(输出, "x9", 变量槽偏移(参数槽, 最大寄存器));
            }
        } 否则 如果 (拷贝字节 == 0) {
            写槽(输出, "x" + 整数转字符串(号p), 变量槽偏移(参数槽, 最大寄存器));
        } 否则 {
            加行(输出, "    mov x9, x" + 整数转字符串(号p));
            发射参数拷贝ARM64(输出, 参数槽, 最大寄存器, 拷贝字节, 函数序号);
        }
        参数序++;
    }
    // 指令主循环（IR_调用实参 为声明性指令：收集，IR_调用参数化 统一展开）
    向量<IR指令> 调用实参们 = 向量<IR指令>();
    整64 i = 0;
    当 (i < 函数信息.指令.大小()) {
        IR指令 指令 = 函数信息.指令.元素(i);
        如果 (指令.操作码 == IR_调用实参) {
            结果<空类型, 整32> 加实 = 调用实参们.追加(指令);
            如果 (!加实.正常) { 运行时错误(4); }
        } 否则 {
            生成指令ARM64(指令, 最大寄存器, 槽基数, retbuf槽数, 函数序号, 调用实参们, 输出);
            如果 (指令.操作码 == IR_调用参数化) {
                调用实参们.清空();
            }
        }
        i++;
    }
    // epilogue（宿主 emitEpilogue 同款）
    如果 (帧大小 <= 4095) {
        加行(输出, "    add sp, sp, #" + 整数转字符串(帧大小));
    } 否则 {
        装载立即数(输出, "x13", 帧大小);
        加行(输出, "    add sp, sp, x13");
    }
    加行(输出, "    ldp x29, x30, [sp], #16");
    加行(输出, "    ret");
    加行(输出, "");
}

// ==================== 程序入口 ====================
// 程序IR -> GAS 行列表。.text 函数区 + .data 字符串常量（去重；宿主 .data 同款）
//   + .note.GNU-stack（现代 binutils 可执行栈告警/错误防护，宿主同款收尾）。
// GAS 无需 EXTERN 声明（未定义符号默认外部；win64 路径 ml64 需要）。
函数 代码生成ARM64(程序IR 程序) -> 向量<字符串> {
    向量<字符串> 输出 = 向量<字符串>();
    加行(输出, "// 由 v2 代码生成ARM64 生成（linux-arm64 / GNU as / AAPCS64）");
    加行(输出, ".text");
    整64 f = 0;
    当 (f < 程序.函数们.大小()) {
        生成函数ARM64(程序.函数们.元素(f), f, 输出);
        f++;
    }
    // 字符串常量数据段（共用层收集去重；.byte 十进制字节 + 0 终止）
    向量<整64> 常量ID们 = 收集字符串常量(程序);
    整64 s2 = 0;
    当 (s2 < 常量ID们.大小()) {
        字符串 文本 = 字符串复制(驻留文本(常量ID们.元素(s2)));
        加行(输出, ".data");
        加行(输出, "strData_" + 整数转字符串(常量ID们.元素(s2)) + ":");
        字符串 字节行 = "    .byte";
        整64 b = 0;
        当 (b < 字符串长度(文本)) {
            整64 字节 = 整64(文本[b]) & 255;
            字节行 = 字节行 + " " + 整数转字符串(字节) + ",";
            b++;
        }
        加行(输出, 字节行 + " 0");
        s2++;
    }
    // 浮点常量数据段（89-a）：.align 3（AArch64 GAS .align N=2^N——8 字节对齐，
    //   对齐理由同静态槽节：LO12 重定位 addend 必须 8 对齐）
    向量<整64> 浮点ID们 = 收集浮点常量(程序);
    整64 fd = 0;
    当 (fd < 浮点ID们.大小()) {
        加行(输出, ".data");
        加行(输出, ".align 3");
        加行(输出, "floatData_" + 整数转字符串(浮点ID们.元素(fd)) + ":");
        加行(输出, "    .double " + 浮点文本净(浮点ID们.元素(fd)));
        fd++;
    }
    // ②c C：静态槽数据段（.data 可写；标量静态直存折叠初始值，容器静态 0——
    //   入口 NewObject+构造注入指针）
    //   .align 3（2026-09-07）：静态槽 8 对齐——槽区紧跟任意长度字符串 .byte
    //   之后，本地标签引用被 GAS 折叠成 .data+偏移，64 位 ldr/str 的 LO12
    //   重定位要求 addend 8 对齐，非对齐即链接截断失败（v2self 锚定轮实证；
    //   Rust/LLVM 对照：对齐=发射期布局契约，绝不靠链接器宽容）
    如果 (程序.静态数 > 0) {
        加行(输出, ".data");
        加行(输出, ".align 3");
        整64 g = 0;
        当 (g < 程序.静态数) {
            字符串 初始值 = "0";
            如果 (g < 程序.静态初始值们.大小()) {
                初始值 = 字符串复制(驻留文本(程序.静态初始值们.元素(g)));
            }
            加行(输出, 静态槽标签(g) + ":");
            // 87-a（2026-09-12 第八十七轮）：结构体静态槽按类型尺寸分配（原恒
            //   `.quad`=8 字节 → 整体拷贝越界写相邻 .data 符号）。8 字节取整
            //   保证后续槽对齐不变式（arm64 非对齐访存=SIGBUS 陷阱）。
            整64 静大小m = 查结构体大小(取静态类型(g));
            如果 (静大小m > 8) {
                整64 静槽数m = (静大小m + 7) / 8;
                加行(输出, "    .zero " + 整数转字符串((静大小m + 7) / 8 * 8));
            } 否则 {
                加行(输出, "    .quad " + 初始值);
            }
            g++;
        }
    }
    加行(输出, ".section .note.GNU-stack,\"\",@progbits");
    返回 输出;
}
