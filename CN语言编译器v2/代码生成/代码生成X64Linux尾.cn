// 代码生成X64Linux尾（357 重构F2 自 代码生成X64Linux.cn 纯机械搬移·函数体逐字保留·零逻辑变化）

导入 容器::向量;
导入 IR;           // IR 指令/程序IR/类型码/驻留文本/析构符号（原 IR生成+IR容器+IR常量 合并）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 代码生成;     // 后端共用决策层（原 代码生成共用；同包包名幂等加载）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

函数 编码对象调用X64L(IR指令 指令, 整64 最大寄存器, 整64 槽基数, 整64 retbuf槽数, 整64 函数序号,
                      向量<IR指令> 实参们, 向量<字符串> 输出) -> 布尔 {
    如果 (指令.操作码 == IR_分配对象) {
        // NewObject：rdi=大小 -> __cn_object_new -> rax（SysV 第 1 整型参数位）
        加行X64L(输出, "    mov rdi, " + 整数转字符串(指令.类型));
        加行X64L(输出, "    call __cn_object_new");
        // 234：有虚类分配即装 vptr（构造/默认构造/无构造统一单点——C++ 同序）
        如果 (类虚槽总数(指令.附加) > 0) {
            加行X64L(输出, "    lea rdx, [rip+" +
                符号修饰X64L(类虚表符号(驻留文本(指令.附加))) + "]");
            加行X64L(输出, "    mov qword ptr [rax], rdx");
        }
        加行X64L(输出, "    mov " + 槽文本X64L(寄存器槽偏移(指令.目标)) + ", rax");
        返回 真;
    }
    如果 (指令.操作码 == IR_结构体拷贝) {
        // CopyStruct：rdi=目标地址 rsi=源地址 rcx=字节数；rep movsb——执行期合法
        //   （活跃值全落栈槽，caller-saved 破坏安全；win 版同款。与 prologue 参数
        //   拷贝的区别：彼时参数寄存器尚有未装载值，必须 r10/r11 展开式）
        加行X64L(输出, "    mov rdi, " + 槽文本X64L(寄存器槽偏移(指令.操作数2)));
        加行X64L(输出, "    mov rsi, " + 槽文本X64L(寄存器槽偏移(指令.操作数1)));
        加行X64L(输出, "    mov rcx, " + 整数转字符串(指令.类型));
        加行X64L(输出, "    rep movsb");
        返回 真;
    }
    如果 (指令.操作码 == IR_删除对象) {
        // DeleteObject：空安全（test/je）+ ~类(this) + __cn_object_delete(this)
        字符串 标签 = 对象删除标签(函数序号, 指令.目标);
        字符串 析构名 = 符号修饰X64L(析构符号(驻留文本(指令.附加)));
        加行X64L(输出, "    mov r10, " + 槽文本X64L(寄存器槽偏移(指令.操作数1)));
        加行X64L(输出, "    test r10, r10");
        加行X64L(输出, "    je " + 标签);
        加行X64L(输出, "    mov rdi, r10");
        加行X64L(输出, "    call " + 析构名);
        加行X64L(输出, "    mov r10, " + 槽文本X64L(寄存器槽偏移(指令.操作数1)));
        加行X64L(输出, "    mov rdi, r10");
        加行X64L(输出, "    call __cn_object_delete");
        加行X64L(输出, 标签 + ":");
        返回 真;
    }
    如果 (指令.操作码 == IR_间接调用) {
        // T69（480-a 深度机）：函数指针间接调用——SysV 实参装载与直接调用同构
        //   （无 retbuf/this 前导位），call 目标=指针寄存器 r11（装载晚于实参
        //   防覆盖；宿主 linux_x64_instructions.cpp emitCall 间接分支同款）。
        向量<整64> 实参码们480 = 向量<整64>();
        整64 码i480 = 0;
        当 (码i480 < 实参们.大小()) {
            结果<空类型, 整32> 加码480 = 实参码们480.追加(实参们.元素(码i480).操作数2);
            如果 (!加码480.正常) { 运行时错误(4); }
            码i480++;
        }
        向量<整64> 类们480 = 向量<整64>();
        向量<整64> 号们480 = 向量<整64>();
        分配参数位置(实参码们480, 6, 8, 假, 类们480, 号们480);
        整64 栈游标480 = 0;
        整64 栈i480 = 0;
        当 (栈i480 < 类们480.大小()) {
            如果 (类们480.元素(栈i480) == 2) { 栈游标480++; }
            栈i480++;
        }
        整64 栈区480 = 栈游标480 * 8;
        如果 (栈区480 % 16 != 0) { 栈区480 = 栈区480 + 8; }
        如果 (栈区480 > 0) {
            加行X64L(输出, "    sub rsp, " + 整数转字符串(栈区480));
        }
        编码X64L实参装载(实参们, 类们480, 号们480, 输出);
        加行X64L(输出, "    mov r11, " + 槽文本X64L(寄存器槽偏移(指令.附加)));
        // 040（001 §5.8 子案 A·2026-10-05 用户裁决）：空调用判零——零值 →
        //   运行时错误(3) 空指针解引用（SysV 错误码走 rdi·907 同款不返回）
        整64 空指针序f480 = 输出.大小();
        加行X64L(输出, "    test r11, r11");
        加行X64L(输出, "    jnz " + 空指针跳过标签(空指针序f480));
        加行X64L(输出, "    mov rdi, 3");
        加行X64L(输出, "    call __cn_runtime_error");
        加行X64L(输出, "    ret");
        加行X64L(输出, 空指针跳过标签(空指针序f480) + ":");
        加行X64L(输出, "    call r11");
        如果 (栈区480 > 0) {
            加行X64L(输出, "    add rsp, " + 整数转字符串(栈区480));
        }
        编码X64L返回装载(指令, 输出);
        返回 真;
    }
    如果 (指令.操作码 == IR_调用参数化) {
        // 调用统一展开（用户裁决项3 参数区）：总位数=操作数1（含 retbuf/this）。
        // 91-a（2026-09-13 第九十一轮）：SysV 双计数参数分配（共用层
        //   分配参数位置 单点：整型 6 / 浮点 8 独立计数，宿主 emitParamSetup
        //   三计数器同构）——整型类 rdi..r9、浮点类 xmm0-xmm7，各自溢出按声明序
        //   共享调用方栈参数区 [rsp+8k]（被调方 [rbp+16+8k]）。返回：浮点码
        //   （操作数2）-> xmm0 装载，其余 -> rax。栈区 16 对齐（帧 16 对齐 ->
        //   call 前 rsp≡0，SysV 纪律）。实参们 顺序=声明序（IR 层发射序契约）。
        整64 总位数 = 指令.操作数1;
        向量<整64> 实参码们 = 向量<整64>();
        整64 码i0 = 0;
        当 (码i0 < 实参们.大小()) {
            结果<空类型, 整32> 加码0 = 实参码们.追加(实参们.元素(码i0).操作数2);
            如果 (!加码0.正常) { 运行时错误(4); }
            码i0++;
        }
        向量<整64> 类们 = 向量<整64>();    // 与 实参们 同下标：0=整型寄存器/1=浮点寄存器/2=栈
        向量<整64> 号们 = 向量<整64>();    // 寄存器序号 或 栈位号
        分配参数位置(实参码们, 6, 8, 指令.类型 != 0, 类们, 号们);
        整64 栈游标 = 0;
        整64 栈i0 = 0;
        当 (栈i0 < 类们.大小()) {
            如果 (类们.元素(栈i0) == 2) { 栈游标++; }
            栈i0++;
        }
        整64 栈区 = 栈游标 * 8;
        如果 (栈区 % 16 != 0) { 栈区 = 栈区 + 8; }
        如果 (栈区 > 0) {
            加行X64L(输出, "    sub rsp, " + 整数转字符串(栈区));
        }
        // retbuf（位 0）：lea rdi（②b B6：基槽=槽基数+retbuf槽数，序号恒 1 共享
        //   单缓冲——按真实返回字节数定尺寸；SysV 隐藏返回指针位）
        如果 (指令.类型 != 0) {
            加行X64L(输出, "    lea rdi, " +
                槽文本X64L(变量槽偏移(retbuf基槽(槽基数, retbuf槽数), 最大寄存器)));
        }
        // 221-a（2026-09-16 第两百二十一轮，D1 行数整改）：栈/寄存器实参装载迁
        //   编码X64L实参装载；返回装载+111-a 高位规范化迁 编码X64L返回装载
        //   （220-a Win 版同构复用第二例）。
        编码X64L实参装载(实参们, 类们, 号们, 输出);
        // 070-②（830-a）：SysV x64 varargs ABI——AL=SSE 寄存器使用数（同 Win 口径）
        如果 (是变参内置符号(驻留文本(指令.附加))) {
            整64 al计数l = 0;
            整64 alil = 0;
            当 (alil < 类们.大小()) {
                如果 (类们.元素(alil) == 1) { al计数l++; }
                alil++;
            }
            加行X64L(输出, "    mov al, " + 整数转字符串(al计数l));
        }
        如果 (指令.附加 < 0) {
            // 234（2026-10-06·91303）：虚调用——附加=-槽-1；vptr=[this]·
            //   call [rax+槽*8]。标量/空返回虚方法 this=位0=rdi（聚合+虚=IR 层
            //   挂账·发射用户类方法调用 诊断）。栈区对齐沿用上方 sub。
            加行X64L(输出, "    mov rax, qword ptr [rdi]");
            加行X64L(输出, "    call qword ptr [rax + " +
                整数转字符串((0 - 指令.附加 - 1) * 8) + "]");
        } 否则 {
            加行X64L(输出, "    call " + 符号修饰X64L(驻留文本(指令.附加)));
        }
        如果 (栈区 > 0) {
            加行X64L(输出, "    add rsp, " + 整数转字符串(栈区));
        }
        编码X64L返回装载(指令, 输出);
        返回 真;
    }
    返回 假;
}


// 221-a：族①a X64L 实参装载——栈实参先装载（r10/xmm0 中转，sub rsp 之后
//   [rsp+8k] 写入）+寄存器实参（整型 rdi..r9 / 浮点 xmm0..xmm7 分派）。
函数 编码X64L实参装载(向量<IR指令>& 实参们, 向量<整64>& 类们, 向量<整64>& 号们, 向量<字符串> 输出) -> 空类型 {
        // 栈实参先装载（r10/xmm0 中转，sub rsp 之后 [rsp+8k] 写入）
        整64 a = 0;
        当 (a < 实参们.大小()) {
            IR指令 实参 = 实参们.元素(a);
            如果 (类们.元素(a) == 2) {
                字符串 偏移a = 整数转字符串(号们.元素(a) * 8);
                如果 (实参.操作数2 == T_浮32 || 实参.操作数2 == T_浮64) {
                    字符串 后a = (实参.操作数2 == T_浮64) ? "sd" : "ss";
                    字符串 宽a = (实参.操作数2 == T_浮64) ? "qword ptr " : "dword ptr ";
                    加行X64L(输出, "    mov" + 后a + " xmm0, " +
                        槽文本X64L(寄存器槽偏移(实参.操作数1)));
                    加行X64L(输出, "    mov" + 后a + " " + 宽a + "[rsp+" + 偏移a + "], xmm0");
                } 否则 {
                    加行X64L(输出, "    mov r10, " +
                        槽文本X64L(寄存器槽偏移(实参.操作数1)));
                    加行X64L(输出, "    mov qword ptr [rsp+" + 偏移a + "], r10");
                }
            }
            a++;
        }
        // 寄存器实参（整型类 rdi..r9 / 浮点类 xmm0..xmm7——游标分配表分派）
        整64 b = 0;
        当 (b < 实参们.大小()) {
            IR指令 实参2 = 实参们.元素(b);
            整64 类b = 类们.元素(b);
            如果 (类b == 0) {
                加行X64L(输出, "    mov " + 参数寄存器名X64L(号们.元素(b)) + ", " +
                    槽文本X64L(寄存器槽偏移(实参2.操作数1)));
            } 否则 如果 (类b == 1) {
                字符串 后b = (实参2.操作数2 == T_浮64) ? "sd" : "ss";
                字符串 宽b = (实参2.操作数2 == T_浮64) ? "qword ptr " : "dword ptr ";
                加行X64L(输出, "    mov" + 后b + " xmm" + 整数转字符串(号们.元素(b)) +
                    ", " + 宽b + 槽文本X64L(寄存器槽偏移(实参2.操作数1)));
            }
            b++;
        }
}

// 221-a：族①b X64L 返回装载——浮点返回码（操作数2）-> xmm0 装载，其余 -> rax；
//   111-a ≤32 位返回类型高位规范化（与 win 侧同款纪律，三后端同治）。
函数 编码X64L返回装载(IR指令 指令, 向量<字符串> 输出) -> 空类型 {
        如果 (指令.目标 != 0) {
            // 返回装载：浮点返回码（IR_调用参数化.操作数2）-> xmm0；其余 -> rax
            如果 (指令.操作数2 == T_浮32) {
                加行X64L(输出, "    movss dword ptr " +
                    槽文本X64L(寄存器槽偏移(指令.目标)) + ", xmm0");
            } 否则 如果 (指令.操作数2 == T_浮64) {
                加行X64L(输出, "    movsd qword ptr " +
                    槽文本X64L(寄存器槽偏移(指令.目标)) + ", xmm0");
            } 否则 {
                // 111-a：≤32 位返回类型高位规范化（SysV x64 ABI 同 win64——窄返回值
                //   高位未定义；**低 32 位是权威值**，扩展方式与 v2 内部表示一致：
                //   整32=有符号（类型转换生成 movsxd 符号扩展，零扩展会破坏负值语义）；
                //   正32=零扩展；布尔=0/1 零扩展。各 1 条指令，性能代价≈0；
                //   对齐 Rust/LLVM signext/zeroext ——与 win 侧同款纪律，三后端同治。
                整64 返回码n = 指令.操作数2;
                如果 (返回码n == T_布尔) {
                    加行X64L(输出, "    movzx eax, al");
                }
                如果 (返回码n == T_整32) {
                    加行X64L(输出, "    movsxd rax, eax");
                }
                如果 (返回码n == T_正32) {
                    加行X64L(输出, "    mov eax, eax");
                }
                加行X64L(输出, "    mov " + 槽文本X64L(寄存器槽偏移(指令.目标)) + ", rax");
            }
        }
}


// 静态组：静态槽读/地址/写（mov/lea rip 相对——.data 可写）。
函数 编码静态X64L(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    如果 (指令.操作码 == IR_静态加载) {
        // ②c C：静态槽读——mov rip 相对（-no-pie；.data 可写）
        加行X64L(输出, "    mov r10, qword ptr [rip+" + 静态槽标签(指令.附加) + "]");
        加行X64L(输出, "    mov " + 槽文本X64L(寄存器槽偏移(指令.目标)) + ", r10");
        返回 真;
    }
    如果 (指令.操作码 == IR_静态地址) {
        // 静态槽地址（lea）——拷贝构造源 T& 传静态容器左值地址
        加行X64L(输出, "    lea r10, qword ptr [rip+" + 静态槽标签(指令.附加) + "]");
        加行X64L(输出, "    mov " + 槽文本X64L(寄存器槽偏移(指令.目标)) + ", r10");
        返回 真;
    }
    如果 (指令.操作码 == IR_静态存储) {
        // ②c C：静态槽写（操作数1=值寄存器）
        加行X64L(输出, "    mov r10, " + 槽文本X64L(寄存器槽偏移(指令.操作数1)));
        加行X64L(输出, "    mov qword ptr [rip+" + 静态槽标签(指令.附加) + "], r10");
        返回 真;
    }
    如果 (指令.操作码 == IR_函数地址) {
        // T69（480-a 深度机）：取函数符号地址（RIP 相对 lea——-no-pie 与
        //   静态槽地址同款；宿主 linux_x64_instructions.cpp FuncAddr 分支同源）
        加行X64L(输出, "    lea r10, " + 符号修饰X64L(驻留文本(指令.附加)) + "[rip]");
        加行X64L(输出, "    mov " + 槽文本X64L(寄存器槽偏移(指令.目标)) + ", r10");
        返回 真;
    }
    返回 假;
}


// ==================== 函数生成 ====================
// 生成单函数完整 GAS：.globl/.type/标签 / prologue / 参数装载 / 指令 / epilogue。
// 无 push rbx（v2 retbuf 为帧内栈槽 + IR 层显式拷贝——与宿主形态A差异，见文件头）；
// 对齐链：入口≡8 -> push rbp≡0 -> sub 16对齐帧≡0 -> call 前≡0。
函数 生成函数X64L(函数IR 函数信息, 整64 函数序号, 向量<字符串> 输出) -> 空类型 {
    整64 最大寄存器 = 0;
    整64 最大槽 = 0;
    整64 槽基数 = 0;
    扫描函数(函数信息, &最大寄存器, &最大槽, &槽基数);
    整64 retbuf槽数 = retbuf槽位数(函数信息);    // ②b B6：与 扫描函数 同一决策
    整64 帧大小 = 计算帧大小(最大寄存器, 最大槽);
    字符串 函数名 = 符号修饰X64L(驻留文本(整64(函数信息.名字)));
    加行X64L(输出, ".globl " + 函数名);
    加行X64L(输出, ".type " + 函数名 + ", @function");
    加行X64L(输出, 函数名 + ":");
    加行X64L(输出, "    push rbp");
    加行X64L(输出, "    mov rbp, rsp");
    加行X64L(输出, "    sub rsp, " + 整数转字符串(帧大小));
    // SysV 参数装载（②b B8 按声明序：参数槽序们/参数拷贝字节们）——标量：
    //   前 6 位 rdi,rsi,rdx,rcx,r8,r9 直存，第 7 位起 [rbp+16+8k]（r10 中转）；
    //   结构体按值：入参为指针（B3 调用方约定）——r10=指针、r11=数据，逐 8 字节
    //   展开 + 字节尾巴（宿主 emitParamSetup 修复后同款；**禁 rep movsb/rcx 计数**：
    //   rsi=位1/rcx=位3 在本参数之后装载的参数仍占寄存器，残留覆盖=第十八轮宿主
    //   缺陷同款——数据临时必须取参数寄存器集合 rdi,rsi,rdx,rcx,r8,r9 之外）。
    // 用户函数返回结构体（2026-09-04，E2E 148）：位 0（rdi）=调用方传入的
    //   retbuf 指针——存槽 1（生成函数 已保留）；声明参数位号整体 +1。
    布尔 返回结构体 = 函数信息.返回结构体ID != 0 || 函数信息.返回结果名ID != 0 ||
        函数信息.返回128位 != 0 ||   // 71-a：结果/可选·810（053）：128 位标量返回同款 retbuf ABI
        函数信息.返回数组字节 != 0;   // 087b：数组返回 sret 第四形态（槽 1=retbuf 指针存 rdi）
    如果 (返回结构体) {
        加行X64L(输出, "    mov " + 槽文本X64L(变量槽偏移(1, 最大寄存器)) + ", rdi");
    }
    // 91-a（2026-09-13 第九十一轮）：SysV 双计数参数装载（共用层 分配参数位置
    //   单点，与 win/ARM64 序言同构）——整型类 rdi..r9（6，retbuf 占位 0 计入）；
    //   浮点类 xmm0-xmm7（8，独立计数）；溢出按声明序共享栈参区
    //   [rbp+16+栈位号*8]。结构体按值参数=指针（整型类，逐字展开入槽）。
    向量<整64> 类们p = 向量<整64>();
    向量<整64> 号们p = 向量<整64>();
    分配参数位置(函数信息.参数类型们, 6, 8, 返回结构体, 类们p, 号们p);
    整64 参数序 = 0;
    当 (参数序 < 函数信息.参数槽序们.大小()) {
        整64 参数槽 = 函数信息.参数槽序们.元素(参数序);
        整64 拷贝字节 = 函数信息.参数拷贝字节们.元素(参数序);
        整64 类p = 0;
        整64 号p = 0;
        如果 (参数序 < 类们p.大小()) {
            类p = 类们p.元素(参数序);
            号p = 号们p.元素(参数序);
        }
        整64 参类p = 0;
        如果 (参数序 < 函数信息.参数类型们.大小()) {
            参类p = 函数信息.参数类型们.元素(参数序);
        }
        如果 (类p == 1) {
            字符串 后p = (参类p == T_浮64) ? "sd" : "ss";
            加行X64L(输出, "    mov" + 后p + " " +
                槽文本X64L(变量槽偏移(参数槽, 最大寄存器)) + ", xmm" +
                整数转字符串(号p));
        } 否则 如果 (类p == 2) {
            如果 (拷贝字节 > 0) {
                // 110-a：结构体按值栈参数（B3 约定=指针传入，调用方写指针）——
                //   从栈位取源指针后逐字拷贝入槽（寄存器路径同款）。原实现落下方
                //   标量路径只存 8 字节指针 → 被调方按内联数据访问 → 数据错
                //   （E2E 158_v2 分歧面③ win 侧实证；SysV ≥7 结构体参数才触发）。
                加行X64L(输出, "    mov r10, [rbp+" +
                    整数转字符串(16 + 号p * 8) + "]");
                发射参数拷贝X64L(输出, 参数槽, 最大寄存器, 拷贝字节);
            } 否则 如果 (参类p == T_浮32 || 参类p == T_浮64) {
                字符串 后p = (参类p == T_浮64) ? "sd" : "ss";
                字符串 宽p = (参类p == T_浮64) ? "qword ptr " : "dword ptr ";
                加行X64L(输出, "    mov" + 后p + " xmm0, " + 宽p + "[rbp+" +
                    整数转字符串(16 + 号p * 8) + "]");
                加行X64L(输出, "    mov" + 后p + " " +
                    槽文本X64L(变量槽偏移(参数槽, 最大寄存器)) + ", xmm0");
            } 否则 {
                加行X64L(输出, "    mov r10, [rbp+" +
                    整数转字符串(16 + 号p * 8) + "]");
                加行X64L(输出, "    mov " + 槽文本X64L(变量槽偏移(参数槽, 最大寄存器)) + ", r10");
            }
        } 否则 如果 (拷贝字节 == 0) {
            加行X64L(输出, "    mov " + 槽文本X64L(变量槽偏移(参数槽, 最大寄存器)) +
                ", " + 参数寄存器名X64L(号p));
        } 否则 {
            // 源指针 -> r10（整型寄存器）；目标参数槽 -> 逐字展开（单点助手）
            加行X64L(输出, "    mov r10, " + 参数寄存器名X64L(号p));
            发射参数拷贝X64L(输出, 参数槽, 最大寄存器, 拷贝字节);
        }
        参数序++;
    }
    // 指令主循环（IR_调用实参 为声明性指令：收集，IR_调用参数化 统一展开）
    向量<IR指令> 调用实参们 = 向量<IR指令>();
    整64 i = 0;
    当 (i < 函数信息.指令.大小()) {
        IR指令 指令 = 函数信息.指令.元素(i);
        如果 (指令.操作码 == IR_调用实参) {
            结果<空类型, 整32> 加实 = 调用实参们.追加(指令);
            如果 (!加实.正常) { 运行时错误(4); }
        } 否则 {
            生成指令X64L(指令, 最大寄存器, 槽基数, retbuf槽数, 函数序号, 调用实参们, 输出);
            // T69（480-a）：间接调用同款消费前导 IR_调用实参 序列
            如果 (指令.操作码 == IR_调用参数化 || 指令.操作码 == IR_间接调用) {
                调用实参们.清空();
            }
        }
        i++;
    }
    // epilogue（返回 指令 已 mov rax；尾块统一出口）
    加行X64L(输出, "    mov rsp, rbp");
    加行X64L(输出, "    pop rbp");
    加行X64L(输出, "    ret");
    加行X64L(输出, "");
}

// ==================== 程序入口 ====================
// 程序IR -> GAS 行列表。.intel_syntax 头 + .text 函数区 + .data 字符串常量（去重）
//   + .data 静态槽 + .note.GNU-stack 收尾。GAS 无需 EXTERN（未定义符号默认外部）。
函数 代码生成X64Linux(程序IR 程序) -> 向量<字符串> {
    向量<字符串> 输出 = 向量<字符串>();
    加行X64L(输出, "// 由 v2 代码生成X64Linux 生成（linux-x86_64 / GNU as / System V AMD64）");
    加行X64L(输出, ".intel_syntax noprefix");
    加行X64L(输出, ".text");
    整64 f = 0;
    当 (f < 程序.函数们.大小()) {
        生成函数X64L(程序.函数们.元素(f), f, 输出);
        f++;
    }
    // 234：类 vtable 数据段（.data·每有虚类 槽序 .quad 方法符号——分配对象
    //   vptr 写与 虚调用间接 call 同符号式）
    整64 vq = 0;
    当 (vq < 有虚类清单数()) {
        整64 类名IDv = 有虚类清单取(vq);
        字符串 类文本v = 字符串复制(驻留文本(类名IDv));
        加行X64L(输出, ".data");
        加行X64L(输出, ".balign 8");
        加行X64L(输出, 符号修饰X64L(类虚表符号(类文本v)) + ":");
        整64 槽v = 0;
        当 (槽v < 类虚槽总数(类名IDv)) {
            整64 方法名IDv = 查虚槽方法名(类名IDv, 槽v);
            字符串 方法名v = 字符串复制(驻留文本(方法名IDv)); 字符串 参数串v = 字符串复制(驻留文本(查类方法参数串(类名IDv, 方法名IDv)));
            字符串 定义类名v332 = 虚槽定义类名(类名IDv, 槽v);
            加行X64L(输出, "    .quad " +
                符号修饰X64L(方法符号(定义类名v332, 方法名v, 参数串v)));
            槽v++;
        }
        vq++;
    }
    // 字符串常量数据段（共用层收集去重；.byte 十进制字节 + 0 终止）
    向量<整64> 常量ID们 = 收集字符串常量(程序);
    整64 s2 = 0;
    当 (s2 < 常量ID们.大小()) {
        字符串 文本 = 字符串复制(驻留文本(常量ID们.元素(s2)));
        加行X64L(输出, ".data");
        加行X64L(输出, "strData_" + 整数转字符串(常量ID们.元素(s2)) + ":");
        字符串 字节行 = "    .byte";
        整64 b = 0;
        当 (b < 字符串长度(文本)) {
            整64 字节 = 整64(文本[b]) & 255;
            字节行 = 字节行 + " " + 整数转字符串(字节) + ",";
            b++;
        }
        加行X64L(输出, 字节行 + " 0");
        s2++;
    }
    // 浮点常量数据段（89-a；8 对齐保证 8 字节装载——x86 GAS .align N=对齐到 N 字节）
    向量<整64> 浮点ID们 = 收集浮点常量(程序);
    整64 fd = 0;
    当 (fd < 浮点ID们.大小()) {
        加行X64L(输出, ".data");
        加行X64L(输出, ".align 8");
        加行X64L(输出, "floatData_" + 整数转字符串(浮点ID们.元素(fd)) + ":");
        加行X64L(输出, "    .double " + 浮点文本净(浮点ID们.元素(fd)));
        fd++;
    }
    // ②c C：静态槽数据段（.data 可写；标量静态直存折叠初始值，容器静态 0——
    //   入口 NewObject+构造注入指针）
    如果 (程序.静态数 > 0) {
        加行X64L(输出, ".data");
        // 87-a：静态槽 8 对齐（字符串常量池 .byte 长度任意——非对齐 i64 访存
        //   在严格平台为 UB、x64 为性能损失；x86 GAS .align N=对齐到 N 字节）
        加行X64L(输出, ".align 8");
        整64 g = 0;
        当 (g < 程序.静态数) {
            字符串 初始值 = "0";
            如果 (g < 程序.静态初始值们.大小()) {
                初始值 = 字符串复制(驻留文本(程序.静态初始值们.元素(g)));
            }
            加行X64L(输出, 静态槽标签(g) + ":");
            // 87-a（2026-09-12 第八十七轮）：结构体静态槽按类型尺寸分配
            //   （原恒 `.quad`=8 字节 → 结构体整体拷贝 16/24… 字节**越界写相邻
            //   .data 符号**，静默内存破坏；读取第二字段落到他人数据）。
            //   8 字节取整保证后续槽对齐不变式；标量/容器指针槽恒 8 字节。
            整64 静大小a = 查结构体大小(取静态类型(g));
            // 701-a 波W（三后端同步）：128 位静态槽双 quad（GAS 用 0x 前缀·
            //   与 MASM h 后缀分平台）——原走 else 单 .quad 超限
            字符串 静类型文本a = 字符串复制(驻留文本(取静态类型(g)));
            如果 (字符串比较(静类型文本a, "整128") || 字符串比较(静类型文本a, "正128")) {
                整64 静低128a = 0;
                整64 静高128a = 0;
                如果 (解析128位初值文本(初始值, 静低128a, 静高128a)) {
                    加行X64L(输出, "    .quad 0x" + 位模式十六进制(静低128a) +
                            ", 0x" + 位模式十六进制(静高128a));
                } 否则 {
                    加行X64L(输出, "    .quad 0, 0    /* 128 位初值非法或超范围: " + 初始值 + " */");
                }
            } 否则 如果 (静大小a > 8) {
                整64 静槽数a = (静大小a + 7) / 8;
                字符串 静行a = "    .quad 0";
                整64 静填a = 1;
                当 (静填a < 静槽数a) {
                    静行a = 静行a + ", 0";
                    静填a++;
                }
                加行X64L(输出, 静行a);
            } 否则 {
                加行X64L(输出, "    .quad " + 初始值);
            }
            g++;
        }
    }
    加行X64L(输出, ".section .note.GNU-stack,\"\",@progbits");
    返回 输出;
}
