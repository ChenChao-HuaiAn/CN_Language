// 代码生成ARM64窥孔间接（任务 1319·v2 侧·2026-10-25）
// 职责：linux-arm64 大偏移间接寻址（1243）面——x13 地址物化块识别、四段整体
//   消除（块①+store+块②+load）、x13 尾部两态安全表、x29 相对偏移计数、段调度
//   与全模块一次性压缩入口。
// 依赖：代码生成窥孔文本.cn（通用行扫描/向量辅助）+ 代码生成ARM64窥孔.cn
//   （寄存器/槽/访存行解析、改写、全删判据、操作数/立即数/移位解析、行内直槽）；
//   后者不反向依赖本文件（包内加载顺序：主窥孔 → 本文件 → ARM64 尾）。
// 安全判据（逐条对齐宿主 peephole_slot_arm64.cpp 1243）：
//   ① 两块文本逐行相同（同输入 x29、纯 movz/movk/sub/add 立即数 ⇒ 同地址）；
//   ② 该 x29±N 偏移在全函数段「x29 相对引用」中恰好出现 2 次（=两块）；
//   ③ 删除点后 x13 先定义后读（两态 safe0/safe1 逆序表·标签=入口重置未定义）；
//   ④ store 源/load 目的不得是地址寄存器 x13；
//   ⑤ 同槽/同族/读宽≤存宽（与固定帧槽同规则）。
// 门控：恒开（与 代码生成X64Linux窥孔.cn 同口径）。
导入 容器::向量;
导入 协议常量;   // 位模式合成474/位模式取负474（物化块偏移组合·检查安全）

公开:

// 地址物化行解析：类别 0=非物化 1=MovzHead 2=MovkPart 3=ImmTail 4=SelfTail
//   ImmTail=sub/add xR,x29,#N（偏移立即数·单行块）；SelfTail=sub/add xR,x29,xR
函数 ARM窥孔物化行(字符串 行, 整64& 类别, 字符串& 寄存器, 整64& 立即数,
                   整64& 移位, 布尔& 是减) -> 布尔 {
    类别 = 0; 寄存器 = ""; 立即数 = 0; 移位 = 0; 是减 = 假;
    整64 长 = 字符串长度(行);
    整64 起 = 窥孔跳空白(行, 0);
    如果 (起 >= 长) { 返回 假; }
    整64 名终 = 窥孔记号终(行, 起);
    整64 名长 = 名终 - 起;
    布尔 是movz = (名长 == 4) && 窥孔区间比较(行, 起, 名终, "movz");
    布尔 是movk = (名长 == 4) && 窥孔区间比较(行, 起, 名终, "movk");
    布尔 是sub = (名长 == 3) && 窥孔区间比较(行, 起, 名终, "sub");
    布尔 是add = (名长 == 3) && 窥孔区间比较(行, 起, 名终, "add");
    布尔 是运算 = 是sub || 是add;
    如果 (是movz == 假 && 是movk == 假 && 是运算 == 假) { 返回 假; }
    整64 操作起 = 窥孔跳空白(行, 名终);
    整64 零起 = 0;
    整64 零终 = 0;
    布尔 有零 = ARM窥孔操作数(行, 操作起, 0, 零起, 零终);
    如果 (有零 == 假) { 返回 假; }
    整64 形 = 0;
    整64 号 = 0;
    布尔 寄存器成 = ARM窥孔寄存器形号(行, 零起, 零终, 形, 号);
    如果 (寄存器成 == 假) { 返回 假; }
    如果 (形 != 0) { 返回 假; }
    寄存器 = ARM窥孔寄存器名(形, 号);
    如果 (是运算) {
        整64 一起 = 0;
        整64 一终 = 0;
        整64 二起 = 0;
        整64 二终 = 0;
        布尔 有一 = ARM窥孔操作数(行, 操作起, 1, 一起, 一终);
        布尔 有二 = ARM窥孔操作数(行, 操作起, 2, 二起, 二终);
        如果 (有一 == 假 || 有二 == 假) { 返回 假; }
        布尔 基址 = 窥孔区间比较(行, 一起, 一终, "x29");
        如果 (基址 == 假) { 返回 假; }
        是减 = 是sub;
        整64 立即值 = 0;
        布尔 是立即 = ARM窥孔立即数值(行, 二起, 二终, 立即值);
        如果 (是立即) {
            立即数 = 立即值;
            类别 = 3;
            返回 真;
        }
        布尔 自引用 = 窥孔区间比较(行, 二起, 二终, 寄存器);
        如果 (自引用) {
            类别 = 4;
            返回 真;
        }
        返回 假;
    }
    如果 (是movz) {
        整64 一起2 = 0;
        整64 一终2 = 0;
        布尔 有一2 = ARM窥孔操作数(行, 操作起, 1, 一起2, 一终2);
        如果 (有一2 == 假) { 返回 假; }
        整64 立即值2 = 0;
        布尔 是立即2 = ARM窥孔立即数值(行, 一起2, 一终2, 立即值2);
        如果 (是立即2 == 假) { 返回 假; }
        立即数 = 立即值2;
        类别 = 1;
        整64 二起2 = 0;
        整64 二终2 = 0;
        布尔 有二2 = ARM窥孔操作数(行, 操作起, 2, 二起2, 二终2);
        如果 (有二2) {
            整64 移位值 = 0;
            布尔 移位成 = ARM窥孔移位值(行, 二起2, 二终2, 移位值);
            如果 (移位成 == 假) { 返回 假; }
            移位 = 移位值;
        }
        返回 真;
    }
    // movk：三操作数（寄存器, 立即数, lsl #S）
    整64 一起3 = 0;
    整64 一终3 = 0;
    整64 二起3 = 0;
    整64 二终3 = 0;
    布尔 有一3 = ARM窥孔操作数(行, 操作起, 1, 一起3, 一终3);
    布尔 有二3 = ARM窥孔操作数(行, 操作起, 2, 二起3, 二终3);
    如果 (有一3 == 假 || 有二3 == 假) { 返回 假; }
    整64 立即值3 = 0;
    布尔 是立即3 = ARM窥孔立即数值(行, 一起3, 一终3, 立即值3);
    如果 (是立即3 == 假) { 返回 假; }
    整64 移位值3 = 0;
    布尔 移位成3 = ARM窥孔移位值(行, 二起3, 二终3, 移位值3);
    如果 (移位成3 == 假) { 返回 假; }
    立即数 = 立即值3;
    移位 = 移位值3;
    类别 = 2;
    返回 真;
}

// 片段累加（检查安全位模式组合）：movz/movk 16 位片 -> (高32, 低32)
//   片位 0/16 入低 32 位、32/48 入高 32 位——立即数 ≤ 0xFFFF 时 <<16 不溢出 i64。
不安全 函数 ARM窥孔累加片段(整64 立即数, 整64 移位, 整64& 高, 整64& 低) -> 空类型 {
    布尔 低位片 = (移位 == 0 || 移位 == 16);
    布尔 高位片 = (移位 == 32 || 移位 == 48);
    如果 (低位片) {
        整64 移小 = 移位;
        低 = 低 | (立即数 << 移小);
        返回;
    }
    如果 (高位片) {
        整64 移小2 = 移位 - 32;
        高 = 高 | (立即数 << 移小2);
        返回;
    }
    运行时错误(4);
}

// 从 end（不含）向前跳过注释/空行后识别物化块（块①：store 前）
//   输出 开始/长/偏移（x29 相对）。块尾 Single=ImmTail / SelfTail 两种。
不安全 函数 ARM窥孔找块前(向量<字符串> 输出, 整64 段起, 整64 端,
                          整64& 开始, 整64& 长, 整64& 偏移) -> 空类型 {
    开始 = 0;
    长 = 0;
    偏移 = 0;
    整64 尾 = 端;
    布尔 扫尾 = 真;
    当 (尾 > 段起 && 扫尾) {
        整64 试 = 尾 - 1;
        布尔 注释 = ARM窥孔是注释或空(输出.元素(整32(试)));
        如果 (注释) { 尾 = 试; }
        如果 (注释 == 假) { 扫尾 = 假; }
    }
    如果 (尾 <= 段起) { 返回; }
    整64 尾位 = 尾 - 1;
    整64 类别 = 0;
    字符串 寄存器 = "";
    整64 立即数 = 0;
    整64 移位 = 0;
    布尔 是减 = 假;
    布尔 物化 = ARM窥孔物化行(输出.元素(整32(尾位)), 类别, 寄存器, 立即数, 移位, 是减);
    如果 (物化 == 假) { 返回; }
    布尔 地址寄存器 = 字符串比较(寄存器, "x13");
    如果 (地址寄存器 == 假) { 返回; }
    如果 (类别 == 3) {
        开始 = 尾位;
        长 = 1;
        偏移 = 立即数;
        如果 (是减) { 偏移 = 0 - 立即数; }
        返回;
    }
    如果 (类别 != 4) { 返回; }
    整64 头 = 段起;
    布尔 有头 = 假;
    整64 k = 尾位;
    布尔 收链 = 真;
    当 (k > 段起 && 收链) {
        k--;
        整64 类别k = 0;
        字符串 寄存器k = "";
        整64 立即数k = 0;
        整64 移位k = 0;
        布尔 减k = 假;
        布尔 物k = ARM窥孔物化行(输出.元素(整32(k)), 类别k, 寄存器k, 立即数k, 移位k, 减k);
        布尔 同寄存器 = 物k && 字符串比较(寄存器k, 寄存器);
        如果 (同寄存器 && 类别k == 2) { 收链 = 真; }
        否则 如果 (同寄存器 && 类别k == 1) { 头 = k; 有头 = 真; 收链 = 假; }
        否则 如果 (物k == 假) { 收链 = 假; }
        否则 如果 (物k && 同寄存器 == 假) { 收链 = 假; }
        否则 如果 (同寄存器 && (类别k == 3 || 类别k == 4)) { 收链 = 假; }
    }
    如果 (有头 == 假) { 返回; }
    整64 高 = 0;
    整64 低 = 0;
    整64 h = 头;
    布尔 组合成 = 真;
    当 (h < 尾位) {
        整64 类别h = 0;
        字符串 寄存器h = "";
        整64 立即数h = 0;
        整64 移位h = 0;
        布尔 减h = 假;
        布尔 物h = ARM窥孔物化行(输出.元素(整32(h)), 类别h, 寄存器h, 立即数h, 移位h, 减h);
        布尔 链内 = 物h && 字符串比较(寄存器h, 寄存器) && (类别h == 1 || 类别h == 2);
        如果 (链内 == 假) { 组合成 = 假; 中断; }
        ARM窥孔累加片段(立即数h, 移位h, 高, 低);
        h++;
    }
    如果 (组合成 == 假) { 返回; }
    整64 合成 = 位模式合成474(高, 低);
    偏移 = 合成;
    如果 (是减) { 偏移 = 位模式取负474(合成); }
    开始 = 头;
    长 = 尾位 + 1 - 头;
}

// 从 起（非注释行）正向识别物化块（块②）——输出 长/偏移；形态不符返回 假
不安全 函数 ARM窥孔识块正向(向量<字符串> 输出, 整64 起, 整64 段终,
                            整64& 长, 整64& 偏移) -> 布尔 {
    长 = 0;
    偏移 = 0;
    如果 (起 >= 段终) { 返回 假; }
    整64 类别 = 0;
    字符串 寄存器 = "";
    整64 立即数 = 0;
    整64 移位 = 0;
    布尔 是减 = 假;
    布尔 物化 = ARM窥孔物化行(输出.元素(整32(起)), 类别, 寄存器, 立即数, 移位, 是减);
    布尔 地址寄存器 = 字符串比较(寄存器, "x13");
    如果 (物化 == 假 || 地址寄存器 == 假) { 返回 假; }
    如果 (类别 == 3) {
        长 = 1;
        偏移 = 立即数;
        如果 (是减) { 偏移 = 0 - 立即数; }
        返回 真;
    }
    如果 (类别 != 1) { 返回 假; }
    整64 高 = 0;
    整64 低 = 0;
    ARM窥孔累加片段(立即数, 移位, 高, 低);
    整64 k = 起 + 1;
    布尔 扫尾 = 真;
    布尔 成 = 假;
    当 (k < 段终 && 扫尾) {
        整64 类别k = 0;
        字符串 寄存器k = "";
        整64 立即数k = 0;
        整64 移位k = 0;
        布尔 减k = 假;
        布尔 物k = ARM窥孔物化行(输出.元素(整32(k)), 类别k, 寄存器k, 立即数k, 移位k, 减k);
        布尔 同地址 = 物k && 字符串比较(寄存器k, "x13");
        如果 (同地址 && 类别k == 2) {
            ARM窥孔累加片段(立即数k, 移位k, 高, 低);
            k++;
        }
        否则 如果 (同地址 && 类别k == 4) {
            整64 合成 = 位模式合成474(高, 低);
            偏移 = 合成;
            如果 (减k) { 偏移 = 位模式取负474(合成); }
            长 = k + 1 - 起;
            成 = 真;
            扫尾 = 假;
        }
        否则 如果 (物k == 假 || 同地址 == 假 || 类别k == 1 || 类别k == 3) {
            扫尾 = 假;
        }
    }
    返回 成;
}

// sub/add <dst>, <src>, x13（dst/src 均非 x13）：只读 x13 形态——发射器
//   「sub sp, sp, x13」栈调整与「sub reg, x29, x13」大偏移地址计算；读后 x13 不变。
函数 ARM窥孔是纯x13读(字符串 行) -> 布尔 {
    整64 起 = 窥孔跳空白(行, 0);
    整64 名终 = 窥孔记号终(行, 起);
    布尔 是减 = (名终 - 起 == 3) && 窥孔区间比较(行, 起, 名终, "sub");
    布尔 是加 = (名终 - 起 == 3) && 窥孔区间比较(行, 起, 名终, "add");
    如果 (是减 == 假 && 是加 == 假) { 返回 假; }
    整64 操作起 = 窥孔跳空白(行, 名终);
    整64 零起 = 0;
    整64 零终 = 0;
    整64 一起 = 0;
    整64 一终 = 0;
    整64 二起 = 0;
    整64 二终 = 0;
    布尔 有零 = ARM窥孔操作数(行, 操作起, 0, 零起, 零终);
    布尔 有一 = ARM窥孔操作数(行, 操作起, 1, 一起, 一终);
    布尔 有二 = ARM窥孔操作数(行, 操作起, 2, 二起, 二终);
    如果 (有零 == 假 || 有一 == 假 || 有二 == 假) { 返回 假; }
    布尔 三x13 = 窥孔区间比较(行, 二起, 二终, "x13");
    如果 (三x13 == 假) { 返回 假; }
    布尔 零x13 = 窥孔区间比较(行, 零起, 零终, "x13");
    布尔 一x13 = 窥孔区间比较(行, 一起, 一终, "x13");
    返回 (零x13 == 假 && 一x13 == 假);
}
// ==================== x13 尾部两态安全表 ====================

// 行对 x13 的效果码：
//   0=无 x13 引用（继承） 1=纯定义（进入后已定义） 2=读（进入未定义即不安全）
//   3=标签（可被跳转命中·重置为未定义） 4=其它引用（保守拒绝）
函数 ARM窥孔x13效果(字符串 行) -> 整64 {
    如果 (ARM窥孔是标签(行)) { 返回 3; }
    布尔 含 = ARM窥孔含寄存器(行, "x13");
    如果 (含 == 假) { 返回 0; }
    整64 类别 = 0;
    字符串 寄存器 = "";
    整64 立即数 = 0;
    整64 移位 = 0;
    布尔 是减 = 假;
    布尔 物化 = ARM窥孔物化行(行, 类别, 寄存器, 立即数, 移位, 是减);
    布尔 物化x13 = 物化 && 字符串比较(寄存器, "x13");
    如果 (物化x13 && (类别 == 1 || 类别 == 3)) { 返回 1; }
    如果 (物化x13 && (类别 == 2 || 类别 == 4)) { 返回 2; }
    ARM窥孔槽访问 存访问;
    ARM窥孔槽访问 载访问;
    布尔 存成 = ARM窥孔解析访存行(行, 真, 存访问);
    布尔 载成 = ARM窥孔解析访存行(行, 假, 载访问);
    布尔 存间接 = 存成 && 存访问.间接;
    布尔 载间接 = 载成 && 载访问.间接;
    如果 (存间接 || 载间接) { 返回 2; }
    如果 (ARM窥孔是纯x13读(行)) { 返回 2; }
    返回 4;
}

// 尾部安全表（逆序 O(n)）：表0[k]=从第 k 行起、进入时 x13 未定义仍安全；
//   表1[k]=进入时已定义仍安全。标签行=新入口重置未定义（两态都取表0[k+1]）。
不安全 函数 ARM窥孔尾部安全(向量<字符串> 输出, 整64 段起, 整64 段终,
                            向量<整64>& 安全0) -> 空类型 {
    整64 行数 = 段终 - 段起;
    向量<整64> 表0 = 向量<整64>();
    向量<整64> 表1 = 向量<整64>();
    整64 初始化 = 0;
    当 (初始化 < 行数 + 1) {
        窥孔压整(表0, 1);
        窥孔压整(表1, 1);
        初始化++;
    }
    整64 idx = 行数;
    当 (idx > 0) {
        idx--;
        字符串 行 = 输出.元素(整32(段起 + idx));
        整64 效果 = ARM窥孔x13效果(行);
        如果 (效果 == 0) {
            窥孔设整(表0, idx, 表0.元素(整32(idx + 1)));
            窥孔设整(表1, idx, 表1.元素(整32(idx + 1)));
        }
        否则 如果 (效果 == 1) {
            窥孔设整(表0, idx, 表1.元素(整32(idx + 1)));
            窥孔设整(表1, idx, 表1.元素(整32(idx + 1)));
        }
        否则 如果 (效果 == 2) {
            窥孔设整(表0, idx, 0);
            窥孔设整(表1, idx, 表1.元素(整32(idx + 1)));
        }
        否则 如果 (效果 == 3) {
            窥孔设整(表0, idx, 表0.元素(整32(idx + 1)));
            窥孔设整(表1, idx, 表0.元素(整32(idx + 1)));
        }
        否则 如果 (效果 == 4) {
            窥孔设整(表0, idx, 0);
            窥孔设整(表1, idx, 0);
        }
    }
    当 (安全0.大小() > 0) {
        结果<空类型, 整32> 删 = 安全0.删除(安全0.大小() - 1);
        如果 (删.正常 == 假) { 运行时错误(4); }
    }
    整64 k = 0;
    当 (k < 行数 + 1) {
        窥孔压整(安全0, 表0.元素(整32(k)));
        k++;
    }
}

// ==================== 槽出现次数统计 ====================

// 计数 +1（映射获取/设置失败=内部契约破坏显形）
不安全 函数 ARM窥孔计数加一(映射<整64, 整64>& 计数, 整64 键) -> 空类型 {
    整64 旧 = 0;
    布尔 有 = 计数.包含(键);
    如果 (有) {
        结果<整64, 整32> 查 = 计数.获取(键);
        如果 (查.正常) { 旧 = 查.值; }
        否则 如果 (查.正常 == 假) { 运行时错误(4); }
    }
    结果<空类型, 整32> 设 = 计数.设置(键, 旧 + 1);
    如果 (设.正常 == 假) { 运行时错误(4); }
}

// 行内全部直寻 [x29...] 槽计数（固定帧槽口径·只数直寻 token）
不安全 函数 ARM窥孔行内直槽(字符串 行, 映射<整64, 整64>& 计数) -> 空类型 {
    整64 行长 = 字符串长度(行);
    整64 位置 = 0;
    当 (位置 < 行长) {
        可选<整64> 命中查 = 窥孔查子串(行, "[x29", 位置);
        整64 命中 = 0;
        如果 (命中查.有值) { 命中 = 命中查.值; }
        如果 (命中查.有值 == 假) { 返回; }
        整64 键 = 0;
        布尔 间接 = 假;
        整64 右 = 0;
        布尔 槽成 = ARM窥孔解析槽(行, 命中, 键, 间接, 右);
        如果 (槽成 && 间接 == 假) {
            ARM窥孔计数加一(计数, 键);
            位置 = 右 + 1;
        }
        否则 如果 (槽成 == 假 || 间接) { 位置 = 命中 + 4; }
    }
}

// 段内直寻槽统计（固定帧槽 pass 数据源）
不安全 函数 ARM窥孔统计直寻槽(向量<字符串> 输出, 整64 段起, 整64 段终,
                              映射<整64, 整64>& 计数) -> 空类型 {
    整64 行i = 段起;
    当 (行i < 段终) {
        ARM窥孔行内直槽(输出.元素(整32(行i)), 计数);
        行i++;
    }
}

// 段内 x29 相对偏移统计（大偏移 pass 数据源）：直寻 token + 物化块尾/链
//   （任意目标寄存器——同偏移=同栈槽，帧布局唯一）。
不安全 函数 ARM窥孔统计相对槽(向量<字符串> 输出, 整64 段起, 整64 段终,
                              映射<整64, 整64>& 计数) -> 空类型 {
    整64 行i = 段起;
    字符串 待定寄存器 = "";
    整64 待定高 = 0;
    整64 待定低 = 0;
    布尔 有待定 = 假;
    当 (行i < 段终) {
        字符串 行 = 输出.元素(整32(行i));
        整64 类别 = 0;
        字符串 寄存器 = "";
        整64 立即数 = 0;
        整64 移位 = 0;
        布尔 是减 = 假;
        布尔 物化 = ARM窥孔物化行(行, 类别, 寄存器, 立即数, 移位, 是减);
        如果 (物化) {
            如果 (类别 == 1) {
                待定寄存器 = 寄存器;
                待定高 = 0;
                待定低 = 0;
                ARM窥孔累加片段(立即数, 移位, 待定高, 待定低);
                有待定 = 真;
            }
            否则 如果 (类别 == 2) {
                布尔 同链 = 有待定 && 字符串比较(寄存器, 待定寄存器);
                如果 (同链) { ARM窥孔累加片段(立即数, 移位, 待定高, 待定低); }
                如果 (同链 == 假) { 有待定 = 假; }
            }
            否则 如果 (类别 == 3) {
                整64 键 = 立即数;
                如果 (是减) { 键 = 0 - 立即数; }
                ARM窥孔计数加一(计数, 键);
                有待定 = 假;
            }
            否则 如果 (类别 == 4) {
                布尔 同链2 = 有待定 && 字符串比较(寄存器, 待定寄存器);
                如果 (同链2) {
                    整64 合成 = 位模式合成474(待定高, 待定低);
                    整64 键2 = 合成;
                    如果 (是减) { 键2 = 位模式取负474(合成); }
                    ARM窥孔计数加一(计数, 键2);
                }
                有待定 = 假;
            }
        }
        否则 如果 (物化 == 假) {
            有待定 = 假;
            ARM窥孔行内直槽(行, 计数);
        }
        行i++;
    }
}

// 大偏移间接对标记（块①+store+块②+load 整体消除）
不安全 函数 ARM窥孔标记间接对(向量<字符串> 输出, 整64 段起, 整64 段终,
                              映射<整64, 整64> 计数, 向量<整64> 安全0,
                              向量<整64>& 动作, 向量<字符串>& 改行) -> 空类型 {
    整64 i = 段起;
    当 (i + 2 < 段终) {
        字符串 首行 = 输出.元素(整32(i));
        ARM窥孔槽访问 存;
        布尔 存成 = ARM窥孔解析访存行(首行, 真, 存);
        布尔 命中 = 假;
        如果 (存成 && 存.间接) {
            整64 块1起 = 0;
            整64 块1长 = 0;
            整64 块1偏 = 0;
            ARM窥孔找块前(输出, 段起, i, 块1起, 块1长, 块1偏);
            布尔 有块1 = (块1长 >= 1 && 块1长 <= 5);
            整64 次 = i + 1;
            布尔 扫尾 = 真;
            当 (次 < 段终 && 扫尾) {
                布尔 注释 = ARM窥孔是注释或空(输出.元素(整32(次)));
                如果 (注释) { 次++; }
                如果 (注释 == 假) { 扫尾 = 假; }
            }
            整64 块2长 = 0;
            整64 块2偏 = 0;
            布尔 有块2 = ARM窥孔识块正向(输出, 次, 段终, 块2长, 块2偏);
            布尔 同形 = 有块1 && 有块2 && (块1长 == 块2长) && (块1偏 == 块2偏);
            布尔 同文 = 同形;
            如果 (同形) {
                整64 b = 0;
                当 (b < 块1长 && 同文) {
                    布尔 同 = 字符串比较(输出.元素(整32(块1起 + b)),
                                        输出.元素(整32(次 + b)));
                    如果 (同 == 假) { 同文 = 假; }
                    b++;
                }
            }
            整64 载位 = 次 + 块2长;
            布尔 有载 = (同文 && 载位 < 段终);
            如果 (有载) {
                ARM窥孔槽访问 载;
                布尔 载成 = ARM窥孔解析访存行(输出.元素(整32(载位)), 假, 载);
                布尔 同槽 = (存.槽键 == 载.槽键);
                布尔 同族 = (存.浮点 == 载.浮点);
                布尔 宽可达 = (载.宽 >= 8 && 载.宽 <= 存.宽);
                布尔 间接同 = 载.间接;
                布尔 源地址 = (存.浮点 == 假 && 存.寄存器号 == 13);
                布尔 目地址 = (载.浮点 == 假 && 载.寄存器号 == 13);
                布尔 计数二 = ARM窥孔槽仅两处(计数, 块1偏);
                布尔 尾部安 = (安全0.元素(整32(载位 + 1 - 段起)) == 1);
                布尔 全部 = 载成 && 同槽 && 同族 && 宽可达 && 间接同 &&
                            源地址 == 假 && 目地址 == 假 && 计数二 && 尾部安;
                如果 (全部) {
                    命中 = 真;
                    整64 b1 = 0;
                    当 (b1 < 块1长) {
                        窥孔设整(动作, 块1起 + b1, 1);
                        b1++;
                    }
                    整64 b2 = 0;
                    当 (b2 < 块2长) {
                        窥孔设整(动作, 次 + b2, 1);
                        b2++;
                    }
                    窥孔设整(动作, i, 1);
                    布尔 全删 = ARM窥孔可全删(存, 载);
                    如果 (全删) {
                        窥孔设整(动作, 载位, 1);
                    }
                    否则 如果 (全删 == 假) {
                        窥孔设整(动作, 载位, 2);
                        窥孔设串(改行, 载位, ARM窥孔改写装载行(存, 载));
                    }
                }
            }
        }
        如果 (命中) { i = i + 1; }
        否则 如果 (命中 == 假) { i++; }
    }
}

// 单段处理：直寻统计/标记 → 间接统计/标记（两 pass 均在未压缩行号上完成；
//   两 pass 攻击面互斥——直寻 [x29] 与间接 [x13] 不同基址，槽死/计数口径
//   与宿主两遍顺序扫描等价）。
不安全 函数 ARM窥孔处理段(向量<字符串> 输出, 整64 段起, 整64 段终,
                         向量<整64>& 动作, 向量<字符串>& 改行) -> 空类型 {
    映射<整64, 整64> 直寻计数 = 映射<整64, 整64>();
    ARM窥孔统计直寻槽(输出, 段起, 段终, 直寻计数);
    映射<整64, 整64> 相对计数 = 映射<整64, 整64>();
    ARM窥孔统计相对槽(输出, 段起, 段终, 相对计数);
    向量<整64> 安全0 = 向量<整64>();
    ARM窥孔尾部安全(输出, 段起, 段终, 安全0);
    ARM窥孔标记直寻对(输出, 段起, 段终, 直寻计数, 动作, 改行);
    ARM窥孔标记间接对(输出, 段起, 段终, 相对计数, 安全0, 动作, 改行);
}

// 主入口：全模块槽转发消除（全部函数生成完成后一次性调用）——
//   段统计在未压缩行号上完成（生成期以 输出.大小() 命名的标签依赖行号全局
//   唯一，段内即时压缩会使后续函数行号回退=标签撞名）；标记完成后对全向量做
//   一次 O(总行数) 压缩（写<=读恒成立），末尾删多余行。
不安全 函数 窥孔槽转发全模块ARM(向量<字符串> 输出, 向量<整64> 段起们,
                             向量<整64> 段终们) -> 空类型 {
    整64 总行数 = 输出.大小();
    布尔 范围合法 = (段起们.大小() == 段终们.大小() && 段起们.大小() <= 总行数);
    如果 (范围合法 == 假) { 运行时错误(4); }
    向量<整64> 动作 = 向量<整64>();
    向量<字符串> 改行 = 向量<字符串>();
    整64 初始化 = 0;
    当 (初始化 < 总行数) {
        窥孔压整(动作, 0);
        窥孔压串(改行, "");
        初始化++;
    }
    整64 段i = 0;
    当 (段i < 段起们.大小()) {
        整64 段起 = 段起们.元素(整32(段i));
        整64 段终 = 段终们.元素(整32(段i));
        布尔 段合法 = (段起 >= 0 && 段起 <= 段终 && 段终 <= 总行数);
        如果 (段合法 == 假) { 运行时错误(4); }
        ARM窥孔处理段(输出, 段起, 段终, 动作, 改行);
        段i++;
    }
    整64 读 = 0;
    整64 写 = 0;
    当 (读 < 总行数) {
        整64 动 = 动作.元素(整32(读));
        如果 (动 == 1) {
            读++;
        }
        否则 如果 (动 == 2) {
            窥孔设串(输出, 写, 改行.元素(整32(读)));
            写++;
            读++;
        }
        否则 如果 (动 == 0) {
            如果 (读 != 写) {
                窥孔设串(输出, 写, 输出.元素(整32(读)));
            }
            写++;
            读++;
        }
        否则 如果 (动 == 3) {
            运行时错误(4);
        }
    }
    当 (输出.大小() > 写) {
        结果<空类型, 整32> 删 = 输出.删除(输出.大小() - 1);
        如果 (删.正常 == 假) { 运行时错误(4); }
    }
}
