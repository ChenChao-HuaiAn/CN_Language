// CN 自举编译器 v2 · 汇编落盘（1272 自主.cn 机械搬移，函数体逐字保留）
// 职责：asm 行列表 -> 文件（双后端共用；[cg1] 诊断对齐既有格式——进度行受
//   详细诊断开关（R2），失败行=错误路径不受开关）。
// 1108（miss 不可静默·2026-10-14 用户令）：写失败上抛返回 1，调用方须检查
//   退出 1（宿主 cn_main.cpp「无法写入汇编文件」同款拒绝语义，rc=0 不再
//   假绿）。三静默终态全显形：①打开失败（目录不可写/不存在/权限）；②写入
//   文件 错误态；③短写——__cn_file_write 返回实际写入字节数（fwrite 语义
//   永不返回负值，stdlib 写入文件 的 错误态 通道恒不触发），磁盘满/短写只能
//   按期望字节（UTF-8 字节数+换行 1 字节）全量比对显形。失败后关闭句柄；
//   半截产物不删除（与宿主 ofstream 行为同构，rc=1 已拒绝下游消费）。
导入 容器::向量;
导入 文件::打开文件;
导入 文件::写入文件;
导入 文件::关闭文件;
导入 协议常量;

公开:

函数 写asm文件(向量<字符串>& asm行, 字符串 路径) -> 整32 {
    如果 (详细诊断开启()) {
        IO::打印到错误("[cg1] asm 行数=" + 整数转字符串(asm行.大小()) + "\n");
    }
    // 1272 P2：一次性落盘——字符串构建器拼全文后单次写入（替代 1.7M 行逐行
    //   fwrite；内存峰值约 asm 文本一份，换 I/O 调用次数数量级下降）。
    整64 构建 = 字符串构建器::新建();
    整64 a = 0;
    当 (a < asm行.大小()) {
        字符串构建器::追加(构建, asm行.元素(a));
        字符串构建器::追加(构建, "\n");
        a++;
    }
    字符串 全文 = 字符串构建器::完成(构建);
    结果<空类型*, 整32> 写文件句柄 = 打开文件(路径, 2);
    如果 (!写文件句柄.正常) {
        IO::打印到错误("[cg1] asm 写文件失败: " + 路径 + "\n");
        返回 1;
    }
    整64 期望字节 = 字符串长度(全文);
    结果<整64, 整32> 写 = 写入文件(写文件句柄.值, 全文);
    如果 (!写.正常) {
        关闭文件(写文件句柄.值);
        IO::打印到错误("[cg1] asm 写入失败: " + 路径 + "\n");
        返回 1;
    }
    关闭文件(写文件句柄.值);
    如果 (写.值 != 期望字节) {
        IO::打印到错误("[cg1] asm 写入短写（磁盘满?）: " + 路径 + "\n");
        返回 1;
    }
    如果 (详细诊断开启()) {
        IO::打印到错误("[cg1] asm 已写 " + 路径 + "\n");
    }
    返回 0;
}
