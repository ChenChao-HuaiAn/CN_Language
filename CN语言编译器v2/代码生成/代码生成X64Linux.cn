// CN 自举编译器 v2：结构化代码生成器——Linux x86_64 GAS 后端（plans/017，2026-09-05）
// IR 指令数组 -> x86_64 GAS 汇编文本行（GNU as，.intel_syntax noprefix），
// 对齐宿主 linux_x64 后端（src/cn_compiler/codegen/linux_x64/，plans/016）ABI/指令选择：
//   - System V AMD64：整型参数 rdi,rsi,rdx,rcx,r8,r9（6 个）第 7 起栈
//     [rbp+16+8k]（返回地址8+saved rbp8 锚定，无影子空间）；标量返回 rax；
//   - IR 位号约定（retbuf=0 / this=1 / 实参从 2 起）：位号恰为 SysV 整型参数序号——
//     位 0(retbuf) 落 rdi=隐藏返回指针位、位 1(this) 落 rsi（形态A契约：IR 层预插
//     operands[0] 原样传递自然落 rdi，与宿主 linux_x64/win/arm64 三后端一致）；
//   - 栈槽模型（后端架构方案1 共用决策）：虚拟寄存器 r -> [rbp-8r-8]、
//     变量槽 s -> [rbp-8*(最大寄存器+s)-8]；x86_64 disp32 全范围一条指令直寻，
//     无 ARM64 的 imm9/imm12 域限制（x13 间接寻址机制整体不需要）；
//   - 函数框架：push rbp / mov rbp,rsp / sub rsp,帧（16 对齐，共用层 计算帧大小）；
//     对齐链：入口 rsp≡8 -> push rbp ≡0 -> sub 16对齐帧 ≡0 -> 调用点栈区（16 对齐）
//     -> call 前 rsp≡0（SysV 纪律，无需 push rbx——retbuf 为帧内栈槽，与宿主差异：
//     宿主形态A隐藏缓冲经 rbx 跨体保存，v2 为 IR 层显式拷贝指令+帧内 retbuf 槽）；
//   - 数据临时纪律（lessons 权重 9.5，2026-09-05 第十八轮）：**禁止使用 rdi,rsi,rdx,
//     rcx,r8,r9 当数据临时**（SysV 6 个参数寄存器全集）——一律 r10/r11；prologue
//     结构体按值参数拷贝 = r10 源指针 + r11 数据逐 8 字节展开（宿主 emitParamSetup
//     修复后同款；win 版 rep movsb 方案依赖 rcx=位0 恒先处理，SysV 下 rsi=位1/rcx=位3
//     会被残留覆盖——**不能直译 win 寄存器角色**）；执行期 rep movsb（结构体拷贝）
//     合法（活跃值全落栈槽，caller-saved 任意破坏安全）；
//   - 除/余：cqo+idiv r11（有符号 128 位被除数正确语义；**不可用 xor rdx,rdx+idiv**——
//     负被除数时 rdx:rax 位模式变 128 位正数，商溢出触发 #DE。宿主 linux_x64 同款 cqo；
//     v2 win 发射器既有 xor rdx,rdx 形态对负数除法有潜伏缺陷，已呈报待家机修复）；
//   - 符号地址装载：lea r10, [rip+sym]（-no-pie 与 PIE 均合法，宿主同款）；
//   - 支持的 IR 子集与 win64/arm64 发射器一一对应；浮点/位运算/i128 IR 尚未发射，
//     三发射器保持同等缺口（后续阶段统一补齐）。
导入 容器::向量;
导入 IR;           // IR 指令/程序IR/类型码/驻留文本/析构符号（原 IR生成+IR容器+IR常量 合并）
导入 代码生成;     // 后端共用决策层（原 代码生成共用；同包包名幂等加载）

公开:

// ==================== 基础助手 ====================

// 追加一行（失败即运行时错误 4；带 X64L 后缀防与 代码生成ARM64 加行 符号冲突）
函数 加行X64L(向量<字符串> 输出, 字符串 行) -> 空类型 {
    结果<空类型, 整32> 加 = 输出.追加(行);
    如果 (!加.正常) { 运行时错误(4); }
}

// GAS 符号安全字符判定（字母/数字/._$；? @ # 等 GAS 特殊字符须修饰）
函数 是GAS安全X64L(字符串 名) -> 布尔 {
    整64 i = 0;
    当 (i < 字符串长度(名)) {
        整64 字节 = 整64(名[i]) & 255;
        布尔 安全 = 假;
        如果 (字节 >= 48 && 字节 <= 57) { 安全 = 真; }
        如果 (字节 >= 65 && 字节 <= 90) { 安全 = 真; }
        如果 (字节 >= 97 && 字节 <= 122) { 安全 = 真; }
        如果 (字节 == 95 || 字节 == 46 || 字节 == 36) { 安全 = 真; }
        如果 (!安全) { 返回 假; }
        i++;
    }
    返回 真;
}

// GAS 符号修饰（对标宿主 linux_x64 nameMangle，与 ARM64 路径同签名体系）：
//   主 -> cn_main（运行时入口）；__cn_ 原样；纯 ASCII 无参 -> 原样；
//   其余 -> "_" + 基名 UTF-8 逐字节十六进制 + 每参数段 "_"+类型编码
//   （类型编码复用共用层——三后端编码表一致）。
函数 符号修饰X64L(字符串 名) -> 字符串 {
    如果 (字符串比较(名, "主")) { 返回 "cn_main"; }
    如果 (字符串长度(名) >= 5 && 字符串比较(字符串子串(名, 0, 5), "__cn_")) { 返回 字符串复制(名); }
    整64 井号位置 = 字节位置(名, 35, 0);
    字符串 基名 = 名;
    字符串 参数串 = "";
    如果 (井号位置 >= 0) {
        基名 = 字符串子串(名, 0, 井号位置);
        参数串 = 字符串子串(名, 井号位置 + 1, 字符串长度(名) - 井号位置 - 1);
    }
    如果 (是GAS安全X64L(基名) && 字符串长度(参数串) == 0) { 返回 字符串复制(名); }
    字符串 修饰 = "_";
    整64 j = 0;
    当 (j < 字符串长度(基名)) {
        整64 字节 = 整64(基名[j]) & 255;
        修饰 = 修饰 + 字节十六进制(字节);
        j++;
    }
    // 参数段：空参数串不拼（分割参数串("") 会产出 1 个空段 -> 假后缀，ARM64 实测踩坑）
    如果 (字符串长度(参数串) > 0) {
        向量<字符串> 段们 = 分割参数串(参数串);
        整64 k = 0;
        当 (k < 段们.大小()) {
            修饰 = 修饰 + "_" + 类型编码(段们.元素(k));
            k++;
        }
    }
    返回 修饰;
}

// 整数字面量位模式解析已上移共用层（字面量位模式，2026-09-09 第四十一轮）：
//   原 解析十进制X64L 只认十进制——0x/0b/0o 前缀被静默解析为 0 的潜伏缺陷
//   随共用层单点根治（十进制文本行为逐点等价）

// 立即数装载：imm32 符号扩展范围（-2147483648..2147483647）内单条 mov
//   （GAS 自动 imm32 符号扩展到 64 位，含负数文本）；域外 movabs imm64。
函数 装载立即数X64L(向量<字符串> 输出, 字符串 寄存器, 整64 值) -> 空类型 {
    如果 (值 <= 2147483647 && 值 >= 0 - 2147483648) {
        加行X64L(输出, "    mov " + 寄存器 + ", " + 整数转字符串(值));
        返回;
    }
    加行X64L(输出, "    movabs " + 寄存器 + ", " + 整数转字符串(值));
}

// ==================== 栈槽访问（x86_64 disp32 直寻，无域限制） ====================

// 槽偏移 -> 内存操作数文本（负=[rbp-N] 槽区 / 正=[rbp+N] 被调方栈参区 / 0=[rbp]）
函数 槽文本X64L(整64 偏移) -> 字符串 {
    如果 (偏移 < 0) {
        返回 "[rbp-" + 整数转字符串(0 - 偏移) + "]";
    }
    如果 (偏移 > 0) {
        返回 "[rbp+" + 整数转字符串(偏移) + "]";
    }
    返回 "[rbp]";
}

// 变量槽文本（含 字节加 修正——结构体参数逐字拷贝按字推进目标槽）
函数 变量槽文本X64L(整64 槽, 整64 最大寄存器, 整64 字节加) -> 字符串 {
    返回 槽文本X64L(变量槽偏移(槽, 最大寄存器) + 字节加);
}

// 110-a（2026-09-13 家机 win-x64）：结构体按值参数拷贝单点（源指针已在 r10）——
//   prologue 寄存器路径与栈参数路径共用（防两路分叉；数据临时 r11 不占参数寄存器）。
函数 发射参数拷贝X64L(向量<字符串> 输出, 整64 参数槽, 整64 最大寄存器, 整64 拷贝字节) -> 空类型 {
    整64 字 = 0;
    当 (字 < 拷贝字节 / 8) {
        加行X64L(输出, "    mov r11, qword ptr [r10+" + 整数转字符串(字 * 8) + "]");
        加行X64L(输出, "    mov qword ptr " +
            变量槽文本X64L(参数槽, 最大寄存器, 字 * 8) + ", r11");
        字++;
    }
    整64 尾 = 拷贝字节 % 8;
    整64 尾基 = (拷贝字节 / 8) * 8;
    整64 尾字 = 0;
    当 (尾字 < 尾) {
        加行X64L(输出, "    mov r11b, byte ptr [r10+" +
            整数转字符串(尾基 + 尾字) + "]");
        加行X64L(输出, "    mov byte ptr " +
            变量槽文本X64L(参数槽, 最大寄存器, 尾基 + 尾字) + ", r11b");
        尾字++;
    }
}

// SysV 第 位号 个整型参数（0 起）的传递寄存器：rdi,rsi,rdx,rcx,r8,r9
函数 参数寄存器名X64L(整64 位) -> 字符串 {
    如果 (位 == 0) { 返回 "rdi"; }
    如果 (位 == 1) { 返回 "rsi"; }
    如果 (位 == 2) { 返回 "rdx"; }
    如果 (位 == 3) { 返回 "rcx"; }
    如果 (位 == 4) { 返回 "r8"; }
    返回 "r9";
}

// ==================== 单指令生成 ====================
// 生成一条 IR 指令的 GAS 文本到 输出（对齐 代码生成.cn/代码生成ARM64.cn 的
//   逐操作码结构；同等 IR 子集）。数据临时一律 r10/r11（参数寄存器纪律）。
函数 生成指令X64L(IR指令 指令, 整64 最大寄存器, 整64 槽基数, 整64 retbuf槽数,
                  整64 函数序号, 向量<IR指令> 实参们, 向量<字符串> 输出) -> 空类型 {
    加行X64L(输出, "    // op=" + 整数转字符串(指令.操作码));
    如果 (编码数据移动X64L(指令, 最大寄存器, 输出)) { 返回; }
    如果 (编码算术X64L(指令, 输出)) { 返回; }
    如果 (编码比较一元X64L(指令, 输出)) { 返回; }
    如果 (编码类型转换X64L(指令, 函数序号, 输出)) { 返回; }
    如果 (编码访存X64L(指令, 最大寄存器, 输出)) { 返回; }
    如果 (编码控制流X64L(指令, 函数序号, 输出)) { 返回; }
    如果 (编码对象调用X64L(指令, 最大寄存器, 槽基数, retbuf槽数, 函数序号, 实参们, 输出)) { 返回; }
    如果 (编码静态X64L(指令, 输出)) { 返回; }
    // IR_分配 等：prologue 预留帧，此处 no-op（win64 同款）
}

// ==================== 指令编码函数组（R4，2026-09-08 自 生成指令X64L 机械搬移） ====================
// 每函数收同款上下文返回 布尔=该操作码是否由本组处理（真=已发射）——分组与
//   win64/ARM64 后端同构。

// 数据移动组：常量整数/常量字符串（lea rip 相对）/槽加载/槽存储。
函数 编码数据移动X64L(IR指令 指令, 整64 最大寄存器, 向量<字符串> 输出) -> 布尔 {
    如果 (指令.操作码 == IR_常量整数) {
        // 常量整数：操作数1 = Symbol ID（文本，经共用层位模式解析——进制前缀/
        //   类型后缀剥离）；负值按补码位模式 mov/movabs 接受
        整64 值 = 字面量位模式(驻留文本(指令.操作数1));
        装载立即数X64L(输出, "r10", 值);
        加行X64L(输出, "    mov " + 槽文本X64L(寄存器槽偏移(指令.目标)) + ", r10");
        返回 真;
    }
    如果 (指令.操作码 == IR_常量浮点) {
        // 浮点常量（89-a）：.data floatData_<文本ID>（.double 文本直通——IEEE754
        //   位模式由汇编器解析）——lea 取址 + 8 字节装载（宿主 ConstFloat 同款语义）
        加行X64L(输出, "    lea r10, [rip+floatData_" + 整数转字符串(指令.操作数1) + "]");
        加行X64L(输出, "    mov r10, [r10]");
        加行X64L(输出, "    mov " + 槽文本X64L(寄存器槽偏移(指令.目标)) + ", r10");
        返回 真;
    }
    如果 (指令.操作码 == IR_常量字符串) {
        // 字符串常量：lea rip 相对取 .data 数据标签地址（宿主 loadSymbolAddress 同款）
        加行X64L(输出, "    lea r10, [rip+strData_" + 整数转字符串(指令.操作数1) + "]");
        加行X64L(输出, "    mov " + 槽文本X64L(寄存器槽偏移(指令.目标)) + ", r10");
        返回 真;
    }
    如果 (指令.操作码 == IR_加载) {
        加行X64L(输出, "    mov r10, " + 槽文本X64L(变量槽偏移(指令.操作数1, 最大寄存器)));
        加行X64L(输出, "    mov " + 槽文本X64L(寄存器槽偏移(指令.目标)) + ", r10");
        返回 真;
    }
    如果 (指令.操作码 == IR_存储) {
        加行X64L(输出, "    mov r10, " + 槽文本X64L(寄存器槽偏移(指令.操作数1)));
        加行X64L(输出, "    mov " + 槽文本X64L(变量槽偏移(指令.附加, 最大寄存器)) + ", r10");
        返回 真;
    }
    返回 假;
}

// 算术组：加/减/乘（imul 双操作数——plans/016 教训①）/除+取余（cqo+idiv，
//   禁 xor rdx,rdx——负被除数 #DE，商 rax 余 rdx）。
函数 编码算术X64L(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    // 91-a（2026-09-13 第九十一轮）：浮点算术（指令.类型=T_浮32/T_浮64）——
    //   SSE 标量指令（addsd/subsd/mulsd/divsd；浮32 用 ss 族 4 字节）。
    //   槽模型不变：位模式经 xmm0/xmm1 中转（movsd 装载 / 运算 / movsd 回写）。
    //   取余 % 不在浮点面内（宿主语义层拒绝「'%'取余运算要求整数操作数」）。
    布尔 是浮点算术 = (指令.类型 == T_浮32 || 指令.类型 == T_浮64);
    如果 (是浮点算术 && (指令.操作码 == IR_加 || 指令.操作码 == IR_减 ||
                       指令.操作码 == IR_乘 || 指令.操作码 == IR_除)) {
        字符串 后缀f = (指令.类型 == T_浮64) ? "sd" : "ss";
        字符串 运算f = "add";
        如果 (指令.操作码 == IR_减) { 运算f = "sub"; }
        否则 如果 (指令.操作码 == IR_乘) { 运算f = "mul"; }
        否则 如果 (指令.操作码 == IR_除) { 运算f = "div"; }
        加行X64L(输出, "    mov" + 后缀f + " xmm0, " +
            槽文本X64L(寄存器槽偏移(指令.操作数1)));
        加行X64L(输出, "    mov" + 后缀f + " xmm1, " +
            槽文本X64L(寄存器槽偏移(指令.操作数2)));
        加行X64L(输出, "    " + 运算f + 后缀f + " xmm0, xmm1");
        加行X64L(输出, "    mov" + 后缀f + " " +
            槽文本X64L(寄存器槽偏移(指令.目标)) + ", xmm0");
        返回 真;
    }
    如果 (指令.操作码 == IR_加) {
        加行X64L(输出, "    mov r10, " + 槽文本X64L(寄存器槽偏移(指令.操作数1)));
        加行X64L(输出, "    mov r11, " + 槽文本X64L(寄存器槽偏移(指令.操作数2)));
        加行X64L(输出, "    add r10, r11");
        // 264-a D34 波1：32 位类型出口截断（整32 movsxd/正32 清高）
        如果 (指令.类型 == T_整32) {
            加行X64L(输出, "    movsxd r10, r10d");
        } 否则 如果 (指令.类型 == T_正32) {
            加行X64L(输出, "    mov r10d, r10d");
        }
        加行X64L(输出, "    mov " + 槽文本X64L(寄存器槽偏移(指令.目标)) + ", r10");
        返回 真;
    }
    如果 (指令.操作码 == IR_减) {
        加行X64L(输出, "    mov r10, " + 槽文本X64L(寄存器槽偏移(指令.操作数1)));
        加行X64L(输出, "    mov r11, " + 槽文本X64L(寄存器槽偏移(指令.操作数2)));
        加行X64L(输出, "    sub r10, r11");
        // 264-a D34 波1：32 位类型出口截断（整32 movsxd/正32 清高）
        如果 (指令.类型 == T_整32) {
            加行X64L(输出, "    movsxd r10, r10d");
        } 否则 如果 (指令.类型 == T_正32) {
            加行X64L(输出, "    mov r10d, r10d");
        }
        加行X64L(输出, "    mov " + 槽文本X64L(寄存器槽偏移(指令.目标)) + ", r10");
        返回 真;
    }
    如果 (指令.操作码 == IR_乘) {
        // x86_64 无 imul r64,r64,r64 三寄存器形式（plans/016 教训①）——双操作数
        加行X64L(输出, "    mov r10, " + 槽文本X64L(寄存器槽偏移(指令.操作数1)));
        加行X64L(输出, "    mov r11, " + 槽文本X64L(寄存器槽偏移(指令.操作数2)));
        加行X64L(输出, "    imul r10, r11");
        // 264-a D34 波1：32 位类型出口截断（整32 movsxd/正32 清高）
        如果 (指令.类型 == T_整32) {
            加行X64L(输出, "    movsxd r10, r10d");
        } 否则 如果 (指令.类型 == T_正32) {
            加行X64L(输出, "    mov r10d, r10d");
        }
        加行X64L(输出, "    mov " + 槽文本X64L(寄存器槽偏移(指令.目标)) + ", r10");
        返回 真;
    }
    如果 (指令.操作码 == IR_除 || 指令.操作码 == IR_取余) {
        // 除/余：有符号 cqo+idiv r11（rdx:rax=128 位被除数，负数语义正确——
        //   禁 xor rdx,rdx+idiv：负被除数位模式变 128 位正数，商溢出 #DE）；
        //   无符号（指令.类型=T_正32/正64，46-f 第五十轮）xor edx,edx+div；
        //   商 rax、余 rdx
        加行X64L(输出, "    mov r10, " + 槽文本X64L(寄存器槽偏移(指令.操作数1)));
        加行X64L(输出, "    mov r11, " + 槽文本X64L(寄存器槽偏移(指令.操作数2)));
        加行X64L(输出, "    mov rax, r10");
        如果 (指令.类型 == T_正32 || 指令.类型 == T_正64) {
            加行X64L(输出, "    xor edx, edx");
            加行X64L(输出, "    div r11");
        } 否则 {
            加行X64L(输出, "    cqo");
            加行X64L(输出, "    idiv r11");
        }
        如果 (指令.操作码 == IR_除) {
            加行X64L(输出, "    mov " + 槽文本X64L(寄存器槽偏移(指令.目标)) + ", rax");
        } 否则 {
            加行X64L(输出, "    mov " + 槽文本X64L(寄存器槽偏移(指令.目标)) + ", rdx");
        }
        返回 真;
    }
    // 位运算（2026-09-09 规范 01b§5.4）：and/or/xor 单指令；移位量经 cl（x86 规定），
    //   265-a 波A：移位量已显式按类型位宽取模（原「硬件 64 位取模=规范语义」前提错误）
    如果 (指令.操作码 == IR_位与 || 指令.操作码 == IR_位或 || 指令.操作码 == IR_位异或) {
        字符串 位指令 = "and";
        如果 (指令.操作码 == IR_位或) { 位指令 = "or"; }
        如果 (指令.操作码 == IR_位异或) { 位指令 = "xor"; }
        加行X64L(输出, "    mov r10, " + 槽文本X64L(寄存器槽偏移(指令.操作数1)));
        加行X64L(输出, "    mov r11, " + 槽文本X64L(寄存器槽偏移(指令.操作数2)));
        加行X64L(输出, "    " + 位指令 + " r10, r11");
        // 264-a D34 波1：32 位类型出口截断（整32 movsxd/正32 清高）
        如果 (指令.类型 == T_整32) {
            加行X64L(输出, "    movsxd r10, r10d");
        } 否则 如果 (指令.类型 == T_正32) {
            加行X64L(输出, "    mov r10d, r10d");
        }
        加行X64L(输出, "    mov " + 槽文本X64L(寄存器槽偏移(指令.目标)) + ", r10");
        返回 真;
    }
    如果 (指令.操作码 == IR_左移 || 指令.操作码 == IR_右移) {
        // >> 有符号=算术 sar；无符号（T_正32/正64，46-f 第五十轮）=逻辑 shr
        //   （2^64-1>>1 须=2^63-1 非 -1）
        字符串 移指令 = "shl";
        如果 (指令.操作码 == IR_右移) {
            如果 (指令.类型 == T_正32 || 指令.类型 == T_正64) { 移指令 = "shr"; }
            否则 { 移指令 = "sar"; }
        }
        加行X64L(输出, "    mov r10, " + 槽文本X64L(寄存器槽偏移(指令.操作数1)));
        加行X64L(输出, "    mov rcx, " + 槽文本X64L(寄存器槽偏移(指令.操作数2)));
        // 265-a 波A（规范 01b§5.4）：移位量显式按操作数位宽取模（178 同根）
        如果 (指令.类型 == T_整32 || 指令.类型 == T_正32) {
            加行X64L(输出, "    and ecx, 31");
        } 否则 {
            加行X64L(输出, "    and ecx, 63");
        }
        加行X64L(输出, "    " + 移指令 + " r10, cl");
        如果 (指令.类型 == T_整32) {
            加行X64L(输出, "    movsxd r10, r10d");
        } 否则 如果 (指令.类型 == T_正32) {
            加行X64L(输出, "    mov r10d, r10d");
        }
        加行X64L(输出, "    mov " + 槽文本X64L(寄存器槽偏移(指令.目标)) + ", r10");
        返回 真;
    }
    返回 假;
}

// 比较与一元组：cmp+setcc 六比较 / 逻辑非（test+sete）/ 一元负（neg）；
// 91-a 增浮点分派（ucomisd + NaN 安全 setcc / btc 符号位翻转）。
函数 编码比较一元X64L(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    // 91-a（2026-09-13 第九十一轮）：浮点比较（指令.类型=T_浮32/T_浮64）——
    //   ucomisd/ucomiss + NaN 安全 setcc（与宿主 H1 修复同款 IEEE ordered 语义）：
    //   < / <= 交换操作数走 seta/setae（NaN 时 CF=1 自然判假）；== / != 加
    //   setnp/setp 组合（ucomisd NaN 时 ZF=PF=1，原 setcc 直配会判
    //   「NaN==NaN 真 / NaN!=NaN 假」——非 IEEE）。
    布尔 是浮点比较 = (指令.类型 == T_浮32 || 指令.类型 == T_浮64);
    如果 (是浮点比较 && (指令.操作码 == IR_相等 || 指令.操作码 == IR_不等 ||
                       指令.操作码 == IR_小于 || 指令.操作码 == IR_大于 ||
                       指令.操作码 == IR_小于等于 || 指令.操作码 == IR_大于等于)) {
        字符串 后缀c = (指令.类型 == T_浮64) ? "sd" : "ss";
        字符串 比较c = (指令.类型 == T_浮64) ? "ucomisd" : "ucomiss";
        字符串 左槽c = 槽文本X64L(寄存器槽偏移(指令.操作数1));
        字符串 右槽c = 槽文本X64L(寄存器槽偏移(指令.操作数2));
        布尔 交换c = (指令.操作码 == IR_小于 || 指令.操作码 == IR_小于等于);
        如果 (交换c) {
            加行X64L(输出, "    mov" + 后缀c + " xmm0, " + 右槽c);
            加行X64L(输出, "    mov" + 后缀c + " xmm1, " + 左槽c);
        } 否则 {
            加行X64L(输出, "    mov" + 后缀c + " xmm0, " + 左槽c);
            加行X64L(输出, "    mov" + 后缀c + " xmm1, " + 右槽c);
        }
        加行X64L(输出, "    " + 比较c + " xmm0, xmm1");
        如果 (指令.操作码 == IR_相等) {
            加行X64L(输出, "    sete al");
            加行X64L(输出, "    setnp r11b");
            加行X64L(输出, "    and al, r11b");
        } 否则 如果 (指令.操作码 == IR_不等) {
            加行X64L(输出, "    setne al");
            加行X64L(输出, "    setp r11b");
            加行X64L(输出, "    or al, r11b");
        } 否则 如果 (指令.操作码 == IR_小于) {
            加行X64L(输出, "    seta al");    // 交换后 < = 右>左
        } 否则 如果 (指令.操作码 == IR_小于等于) {
            加行X64L(输出, "    setae al");   // 交换后 <= = 右>=左
        } 否则 如果 (指令.操作码 == IR_大于) {
            加行X64L(输出, "    seta al");    // 左>右（NaN 假）
        } 否则 {
            加行X64L(输出, "    setae al");   // 左>=右（NaN 假）
        }
        加行X64L(输出, "    movzx r10d, al");
        加行X64L(输出, "    mov " + 槽文本X64L(寄存器槽偏移(指令.目标)) + ", r10");
        返回 真;
    }
    如果 (指令.操作码 == IR_相等 || 指令.操作码 == IR_不等 ||
        指令.操作码 == IR_小于 || 指令.操作码 == IR_大于 ||
        指令.操作码 == IR_小于等于 || 指令.操作码 == IR_大于等于) {
        // 比较：cmp + setcc（al 载体）+ movzx（win x64 setcc 同映射）。
        //   46-f 第五十轮：无符号操作数（T_正32/正64）用无符号条件码
        //   setb/seta/setbe/setae（2^63>100 按 -2^63>100 判假=静默错误）
        整64 无符号 = (指令.类型 == T_正32 || 指令.类型 == T_正64) ? 1 : 0;
        字符串 设置指令 = "sete";
        如果 (指令.操作码 == IR_不等) { 设置指令 = "setne"; }
        否则 如果 (指令.操作码 == IR_小于) { 设置指令 = 无符号 == 1 ? "setb" : "setl"; }
        否则 如果 (指令.操作码 == IR_大于) { 设置指令 = 无符号 == 1 ? "seta" : "setg"; }
        否则 如果 (指令.操作码 == IR_小于等于) { 设置指令 = 无符号 == 1 ? "setbe" : "setle"; }
        否则 如果 (指令.操作码 == IR_大于等于) { 设置指令 = 无符号 == 1 ? "setae" : "setge"; }
        加行X64L(输出, "    mov r10, " + 槽文本X64L(寄存器槽偏移(指令.操作数1)));
        加行X64L(输出, "    cmp r10, " + 槽文本X64L(寄存器槽偏移(指令.操作数2)));
        加行X64L(输出, "    " + 设置指令 + " al");
        加行X64L(输出, "    movzx r10d, al");
        加行X64L(输出, "    mov " + 槽文本X64L(寄存器槽偏移(指令.目标)) + ", r10");
        返回 真;
    }
    如果 (指令.操作码 == IR_逻辑非) {
        加行X64L(输出, "    mov r10, " + 槽文本X64L(寄存器槽偏移(指令.操作数1)));
        加行X64L(输出, "    test r10, r10");
        加行X64L(输出, "    sete al");
        加行X64L(输出, "    movzx r10d, al");
        加行X64L(输出, "    mov " + 槽文本X64L(寄存器槽偏移(指令.目标)) + ", r10");
        返回 真;
    }
    如果 (指令.操作码 == IR_负) {
        // 91-a：浮点取负=符号位翻转（btc——±0/NaN 语义与 IEEE negate 一致；
        //   浮64 位 63 / 浮32 位 31；整数走 neg 原路径）
        如果 (指令.类型 == T_浮32 || 指令.类型 == T_浮64) {
            整64 符号位c = (指令.类型 == T_浮64) ? 63 : 31;
            加行X64L(输出, "    mov r10, " + 槽文本X64L(寄存器槽偏移(指令.操作数1)));
            加行X64L(输出, "    btc r10, " + 整数转字符串(符号位c));
            加行X64L(输出, "    mov " + 槽文本X64L(寄存器槽偏移(指令.目标)) + ", r10");
            返回 真;
        }
        加行X64L(输出, "    mov r10, " + 槽文本X64L(寄存器槽偏移(指令.操作数1)));
        加行X64L(输出, "    neg r10");
        加行X64L(输出, "    mov " + 槽文本X64L(寄存器槽偏移(指令.目标)) + ", r10");
        返回 真;
    }
    返回 假;
}

// 类型转换组：窄读+符号/零扩展（GAS Intel 内存操作数尺寸须显式 ptr）。
函数 编码类型转换X64L(IR指令 指令, 整64 函数序号, 向量<字符串> 输出) -> 布尔 {
    如果 (指令.操作码 == IR_类型转换) {
        // 216-a（2026-09-16 第两百一十六轮，D1 行数整改）：浮点转换段（四组合）迁
        //   编码浮点转换X64L——真=已处理，假=非浮点（落下方整数原路径，行为零变化）。
        如果 (编码浮点转换X64L(指令, 函数序号, 输出)) { 返回 真; }
        // 类型转换：窄读 + 符号/零扩展（win x64 同款语义；GAS Intel 内存操作数
        //   尺寸须显式 ptr——mov r10d/dword ptr 读低 32 清高 32）
        // 方案甲（2026-09-10 第五十一轮）：T_正64=64 位源直拷（同宽位模式重解释，
        //   Rust as 对齐——2^63 转 i64 = -2^63；源槽 8 字节全读，无扩展无截断；
        //   原落 movsxd dword 兜底=低 32 截断，193_v2 立案）
        字符串 源槽 = 槽文本X64L(寄存器槽偏移(指令.操作数1));
        如果 (指令.类型 == T_正64) {
            加行X64L(输出, "    mov r10, qword ptr " + 源槽);
        } 否则 如果 (指令.类型 == T_整32) {
            加行X64L(输出, "    mov r10d, dword ptr " + 源槽);
            加行X64L(输出, "    movsxd r10, r10d");
        } 否则 如果 (指令.类型 == T_正32) {
            // 46-f 第五十轮：正32 零扩展读回（4000000000 位模式原值非符号负）
            加行X64L(输出, "    mov r10d, dword ptr " + 源槽);
        } 否则 如果 (指令.类型 == T_整8) {
            加行X64L(输出, "    movsx r10, byte ptr " + 源槽);
        } 否则 如果 (指令.类型 == T_整16) {
            加行X64L(输出, "    movsx r10, word ptr " + 源槽);
        } 否则 如果 (指令.类型 == T_正8) {
            // 2026-09-04 收口：无符号窄宽零扩展（正8(200)=200）
            加行X64L(输出, "    movzx r10, byte ptr " + 源槽);
        } 否则 如果 (指令.类型 == T_正16) {
            加行X64L(输出, "    movzx r10, word ptr " + 源槽);
        } 否则 {
            // 整64/其他：movsxd 符号扩展（32 位源已由 IR 层按 64 位槽存）。
            //   分派面（第五十五轮标注）：正8/正16 源经 类型码() 归一登记 T_整64，
            //   方案甲源分派已改标 T_正64 直拷不经此兜底；真兜底形态=源登记
            //   T_整32（符号扩展=整32 既有语义）或未登记——均符号扩展正确
            加行X64L(输出, "    movsxd r10, dword ptr " + 源槽);
        }
        加行X64L(输出, "    mov " + 槽文本X64L(寄存器槽偏移(指令.目标)) + ", r10");
        返回 真;
    }
    返回 假;
}


// 216-a（2026-09-16 第两百一十六轮，D1 行数整改）：浮点转换段——91-a 四组合：
//   ① 浮->浮（cvtss2sd 宽化 / cvtsd2ss 窄化；同码位模式直拷）
//   ② 整->浮（cvtsi2sd/ss；正64 无符号经符号位分支修正——SSE 无 u64->double
//      直转，Rust u64 as f64 同款算法）
//   ③ 浮->整（cvttsd2si/ss2si 向零截断，Rust as 截断同款）
//   ④ 源 0/整型 且 目标整型 -> 整数原路径（返回 假=调用方落整数段）。
//   真=已处理浮点转换；假=非浮点。
函数 编码浮点转换X64L(IR指令 指令, 整64 函数序号, 向量<字符串> 输出) -> 布尔 {
        // 91-a（2026-09-13 第九十一轮）：浮点转换分派——源码=操作数2（新增）、
        //   目标码=类型字段。四组合：
        //   ① 浮->浮（cvtss2sd 宽化 / cvtsd2ss 窄化；同码位模式直拷）
        //   ② 整->浮（cvtsi2sd/ss；正32 零扩展读已保序；正64 无符号经
        //      符号位分支修正——SSE 无 u64->double 直转，Rust u64 as f64 同款算法）
        //   ③ 浮->整（cvttsd2si/ss2si 向零截断，Rust as 截断同款）
        //   ④ 源 0/整型 且 目标整型 -> 下方整数原路径（行为零变化）
        整64 源码c = 指令.操作数2;
        布尔 源浮c = (源码c == T_浮32 || 源码c == T_浮64);
        布尔 目标浮c = (指令.类型 == T_浮32 || 指令.类型 == T_浮64);
        如果 (源浮c || 目标浮c) {
            字符串 源槽c = 槽文本X64L(寄存器槽偏移(指令.操作数1));
            字符串 目标槽c = 槽文本X64L(寄存器槽偏移(指令.目标));
            如果 (源浮c && 目标浮c) {
                如果 (源码c == 指令.类型) {
                    加行X64L(输出, "    mov r10, qword ptr " + 源槽c);
                    加行X64L(输出, "    mov " + 目标槽c + ", r10");
                } 否则 如果 (源码c == T_浮32) {
                    加行X64L(输出, "    movss xmm0, dword ptr " + 源槽c);
                    加行X64L(输出, "    cvtss2sd xmm0, xmm0");
                    加行X64L(输出, "    movsd " + 目标槽c + ", xmm0");
                } 否则 {
                    加行X64L(输出, "    movsd xmm0, qword ptr " + 源槽c);
                    加行X64L(输出, "    cvtsd2ss xmm0, xmm0");
                    加行X64L(输出, "    movss dword ptr " + 目标槽c + ", xmm0");
                }
                返回 真;
            }
            如果 (目标浮c) {
                // 整 -> 浮：按源码读法装载 r10（无符号 64 位走分支修正）
                字符串 浮后缀i = (指令.类型 == T_浮64) ? "sd" : "ss";
                如果 (源码c == T_整32) {
                    加行X64L(输出, "    mov r10d, dword ptr " + 源槽c);
                    加行X64L(输出, "    movsxd r10, r10d");
                } 否则 如果 (源码c == T_整8) {
                    加行X64L(输出, "    movsx r10, byte ptr " + 源槽c);
                } 否则 如果 (源码c == T_整16) {
                    加行X64L(输出, "    movsx r10, word ptr " + 源槽c);
                } 否则 如果 (源码c == T_正8) {
                    加行X64L(输出, "    movzx r10, byte ptr " + 源槽c);
                } 否则 如果 (源码c == T_正16) {
                    加行X64L(输出, "    movzx r10, word ptr " + 源槽c);
                } 否则 如果 (源码c == T_正32) {
                    加行X64L(输出, "    mov r10d, dword ptr " + 源槽c);
                } 否则 {
                    // 整64/正64/未登记：8 字节直读
                    加行X64L(输出, "    mov r10, qword ptr " + 源槽c);
                }
                如果 (源码c == T_正64) {
                    // 无符号 64 位 -> 浮点：符号位分支（u >= 2^63 经 (x>>1)|(x&1)
                    //   折半再 ×2——Rust u64 as f64 同款；正64 值 < 2^63 走直转）
                    字符串 标签i = ".Lcvtu" + 整数转字符串(函数序号) + "_" +
                                 整数转字符串(指令.目标);
                    加行X64L(输出, "    test r10, r10");
                    加行X64L(输出, "    jns " + 标签i);
                    加行X64L(输出, "    mov r11, r10");
                    加行X64L(输出, "    shr r11, 1");
                    加行X64L(输出, "    and r10d, 1");
                    加行X64L(输出, "    or r11, r10");
                    加行X64L(输出, "    cvtsi2" + 浮后缀i + " xmm0, r11");
                    加行X64L(输出, "    add" + 浮后缀i + " xmm0, xmm0");
                    加行X64L(输出, "    mov" + 浮后缀i + " " + 目标槽c + ", xmm0");
                    加行X64L(输出, "    jmp " + 标签i + "_d");
                    加行X64L(输出, 标签i + ":");
                    加行X64L(输出, "    cvtsi2" + 浮后缀i + " xmm0, r10");
                    加行X64L(输出, "    mov" + 浮后缀i + " " + 目标槽c + ", xmm0");
                    加行X64L(输出, 标签i + "_d:");
                } 否则 {
                    加行X64L(输出, "    cvtsi2" + 浮后缀i + " xmm0, r10");
                    加行X64L(输出, "    mov" + 浮后缀i + " " + 目标槽c + ", xmm0");
                }
                返回 真;
            }
            // 浮 -> 整：cvttsd2si/ss2si（向零截断）；目标 32 位走 32 位结果寄存器
            //   （r10d 写清高 32=零扩展，与整32 值语义一致）
            如果 (源码c == T_浮64) {
                加行X64L(输出, "    movsd xmm0, qword ptr " + 源槽c);
            } 否则 {
                加行X64L(输出, "    movss xmm0, dword ptr " + 源槽c);
            }
            字符串 截断指令i = (源码c == T_浮64) ? "cvttsd2si" : "cvttss2si";
            如果 (指令.类型 == T_正32) {
                加行X64L(输出, "    " + 截断指令i + " r10d, xmm0");   // 正32：32 位零扩展
            } 否则 {
                加行X64L(输出, "    " + 截断指令i + " r10, xmm0");    // 整32/整64：64 位符号扩展
            }
            加行X64L(输出, "    mov " + 目标槽c + ", r10");
            返回 真;
        }
    返回 假;
}


// 访存组：返回（rax）/ 取地址（lea）/ 指针加载（movsx/movzx 宽度分级）/
//   指针存储（宽度分级——126 段① OOM 根治）。
函数 编码访存X64L(IR指令 指令, 整64 最大寄存器, 向量<字符串> 输出) -> 布尔 {
    如果 (指令.操作码 == IR_返回) {
        // 返回值 -> rax / xmm0（91-a：类型字段=返回类型码——语义浮点值返回走
        //   xmm0，SysV 浮点返回寄存器；整型/指针/retbuf 地址走 rax。
        //   0=无返回值；epilogue 在函数尾块统一）
        如果 (指令.操作数1 != 0) {
            如果 (指令.类型 == T_浮32) {
                加行X64L(输出, "    movss xmm0, dword ptr " +
                    槽文本X64L(寄存器槽偏移(指令.操作数1)));
            } 否则 如果 (指令.类型 == T_浮64) {
                加行X64L(输出, "    movsd xmm0, qword ptr " +
                    槽文本X64L(寄存器槽偏移(指令.操作数1)));
            } 否则 {
                加行X64L(输出, "    mov rax, " + 槽文本X64L(寄存器槽偏移(指令.操作数1)));
            }
        } 否则 {
            加行X64L(输出, "    xor rax, rax");
        }
        返回 真;
    }
    如果 (指令.操作码 == IR_取地址) {
        加行X64L(输出, "    lea r10, " + 槽文本X64L(变量槽偏移(指令.操作数1, 最大寄存器)));
        加行X64L(输出, "    mov " + 槽文本X64L(寄存器槽偏移(指令.目标)) + ", r10");
        返回 真;
    }
    如果 (指令.操作码 == IR_指针加载) {
        // 经指针加载；字段宽度（②b B5）：T_字节 符号扩展（字符串下标 A-1）、
        //   布尔/整8/字符 1 字节零扩展、整16 2、整32 4（mov r10d 清高 32）、默认 8
        加行X64L(输出, "    mov r10, " + 槽文本X64L(寄存器槽偏移(指令.操作数1)));
        如果 (指令.类型 == T_字节) {
            加行X64L(输出, "    movsx r10, byte ptr [r10]");
        } 否则 如果 (指令.类型 == T_布尔 || 指令.类型 == T_整8 || 指令.类型 == T_字符) {
            加行X64L(输出, "    movzx r10, byte ptr [r10]");
        } 否则 如果 (指令.类型 == T_整16) {
            加行X64L(输出, "    movzx r10, word ptr [r10]");
        } 否则 如果 (指令.类型 == T_整32 || 指令.类型 == T_正32) {
            // T_正32（46-f）：mov r10d 清高 32=天然零扩展（4000000000 读回原值）
            加行X64L(输出, "    mov r10d, dword ptr [r10]");
        } 否则 {
            加行X64L(输出, "    mov r10, qword ptr [r10]");
        }
        加行X64L(输出, "    mov " + 槽文本X64L(寄存器槽偏移(指令.目标)) + ", r10");
        返回 真;
    }
    如果 (指令.操作码 == IR_指针存储) {
        // 经指针存储；字段宽度（②b B5：旧固定 8 字节写越界清零相邻槽教训）
        加行X64L(输出, "    mov r10, " + 槽文本X64L(寄存器槽偏移(指令.操作数1)));
        加行X64L(输出, "    mov r11, " + 槽文本X64L(寄存器槽偏移(指令.操作数2)));
        如果 (指令.类型 == T_布尔 || 指令.类型 == T_整8 || 指令.类型 == T_字符) {
            加行X64L(输出, "    mov byte ptr [r10], r11b");
        } 否则 如果 (指令.类型 == T_整16) {
            加行X64L(输出, "    mov word ptr [r10], r11w");
        } 否则 如果 (指令.类型 == T_整32 || 指令.类型 == T_正32) {
            // T_正32（46-f）：dword 写天然截断（wrapping mod 2^32）
            加行X64L(输出, "    mov dword ptr [r10], r11d");
        } 否则 {
            加行X64L(输出, "    mov qword ptr [r10], r11");
        }
        返回 真;
    }
    返回 假;
}

// 控制流组：字段地址 / 块标签 / jmp / test+jnz+jmp。
函数 编码控制流X64L(IR指令 指令, 整64 函数序号, 向量<字符串> 输出) -> 布尔 {
    如果 (指令.操作码 == IR_字段地址) {
        加行X64L(输出, "    mov r10, " + 槽文本X64L(寄存器槽偏移(指令.操作数1)));
        如果 (指令.附加 != 0) {
            加行X64L(输出, "    add r10, " + 整数转字符串(指令.附加));
        }
        加行X64L(输出, "    mov " + 槽文本X64L(寄存器槽偏移(指令.目标)) + ", r10");
        返回 真;
    }
    如果 (指令.操作码 == IR_标签) {
        加行X64L(输出, 块标签(函数序号, 指令.附加) + ":");
        返回 真;
    }
    如果 (指令.操作码 == IR_跳转) {
        加行X64L(输出, "    jmp " + 块标签(函数序号, 指令.附加));
        返回 真;
    }
    如果 (指令.操作码 == IR_条件跳转) {
        // 条件寄存器 非零 -> 真块；否则假块（test+setcc 同族零/符号位纪律）
        加行X64L(输出, "    mov r10, " + 槽文本X64L(寄存器槽偏移(指令.操作数1)));
        加行X64L(输出, "    test r10, r10");
        加行X64L(输出, "    jnz " + 块标签(函数序号, 指令.操作数2));
        加行X64L(输出, "    jmp " + 块标签(函数序号, 指令.操作数3));
        返回 真;
    }
    返回 假;
}

// 对象与调用组：分配对象（SysV rdi）/ 结构体拷贝（rep movsb 执行期合法）/
//   删除对象（空安全+析构+释放）/ 调用参数化（位<6 rdi..r9、>=6 栈区 [rsp+8k]，
//   栈实参先经 r10 中转）。
函数 编码对象调用X64L(IR指令 指令, 整64 最大寄存器, 整64 槽基数, 整64 retbuf槽数, 整64 函数序号,
                      向量<IR指令> 实参们, 向量<字符串> 输出) -> 布尔 {
    如果 (指令.操作码 == IR_分配对象) {
        // NewObject：rdi=大小 -> __cn_object_new -> rax（SysV 第 1 整型参数位）
        加行X64L(输出, "    mov rdi, " + 整数转字符串(指令.类型));
        加行X64L(输出, "    call __cn_object_new");
        加行X64L(输出, "    mov " + 槽文本X64L(寄存器槽偏移(指令.目标)) + ", rax");
        返回 真;
    }
    如果 (指令.操作码 == IR_结构体拷贝) {
        // CopyStruct：rdi=目标地址 rsi=源地址 rcx=字节数；rep movsb——执行期合法
        //   （活跃值全落栈槽，caller-saved 破坏安全；win 版同款。与 prologue 参数
        //   拷贝的区别：彼时参数寄存器尚有未装载值，必须 r10/r11 展开式）
        加行X64L(输出, "    mov rdi, " + 槽文本X64L(寄存器槽偏移(指令.操作数2)));
        加行X64L(输出, "    mov rsi, " + 槽文本X64L(寄存器槽偏移(指令.操作数1)));
        加行X64L(输出, "    mov rcx, " + 整数转字符串(指令.类型));
        加行X64L(输出, "    rep movsb");
        返回 真;
    }
    如果 (指令.操作码 == IR_删除对象) {
        // DeleteObject：空安全（test/je）+ ~类(this) + __cn_object_delete(this)
        字符串 标签 = 对象删除标签(函数序号, 指令.目标);
        字符串 析构名 = 符号修饰X64L(析构符号(驻留文本(指令.附加)));
        加行X64L(输出, "    mov r10, " + 槽文本X64L(寄存器槽偏移(指令.操作数1)));
        加行X64L(输出, "    test r10, r10");
        加行X64L(输出, "    je " + 标签);
        加行X64L(输出, "    mov rdi, r10");
        加行X64L(输出, "    call " + 析构名);
        加行X64L(输出, "    mov r10, " + 槽文本X64L(寄存器槽偏移(指令.操作数1)));
        加行X64L(输出, "    mov rdi, r10");
        加行X64L(输出, "    call __cn_object_delete");
        加行X64L(输出, 标签 + ":");
        返回 真;
    }
    如果 (指令.操作码 == IR_调用参数化) {
        // 调用统一展开（用户裁决项3 参数区）：总位数=操作数1（含 retbuf/this）。
        // 91-a（2026-09-13 第九十一轮）：SysV 双计数参数分配（共用层
        //   分配参数位置 单点：整型 6 / 浮点 8 独立计数，宿主 emitParamSetup
        //   三计数器同构）——整型类 rdi..r9、浮点类 xmm0-xmm7，各自溢出按声明序
        //   共享调用方栈参数区 [rsp+8k]（被调方 [rbp+16+8k]）。返回：浮点码
        //   （操作数2）-> xmm0 装载，其余 -> rax。栈区 16 对齐（帧 16 对齐 ->
        //   call 前 rsp≡0，SysV 纪律）。实参们 顺序=声明序（IR 层发射序契约）。
        整64 总位数 = 指令.操作数1;
        向量<整64> 实参码们 = 向量<整64>();
        整64 码i0 = 0;
        当 (码i0 < 实参们.大小()) {
            结果<空类型, 整32> 加码0 = 实参码们.追加(实参们.元素(码i0).操作数2);
            如果 (!加码0.正常) { 运行时错误(4); }
            码i0++;
        }
        向量<整64> 类们 = 向量<整64>();    // 与 实参们 同下标：0=整型寄存器/1=浮点寄存器/2=栈
        向量<整64> 号们 = 向量<整64>();    // 寄存器序号 或 栈位号
        分配参数位置(实参码们, 6, 8, 指令.类型 != 0, 类们, 号们);
        整64 栈游标 = 0;
        整64 栈i0 = 0;
        当 (栈i0 < 类们.大小()) {
            如果 (类们.元素(栈i0) == 2) { 栈游标++; }
            栈i0++;
        }
        整64 栈区 = 栈游标 * 8;
        如果 (栈区 % 16 != 0) { 栈区 = 栈区 + 8; }
        如果 (栈区 > 0) {
            加行X64L(输出, "    sub rsp, " + 整数转字符串(栈区));
        }
        // retbuf（位 0）：lea rdi（②b B6：基槽=槽基数+retbuf槽数，序号恒 1 共享
        //   单缓冲——按真实返回字节数定尺寸；SysV 隐藏返回指针位）
        如果 (指令.类型 != 0) {
            加行X64L(输出, "    lea rdi, " +
                槽文本X64L(变量槽偏移(retbuf基槽(槽基数, retbuf槽数), 最大寄存器)));
        }
        // 221-a（2026-09-16 第两百二十一轮，D1 行数整改）：栈/寄存器实参装载迁
        //   编码X64L实参装载；返回装载+111-a 高位规范化迁 编码X64L返回装载
        //   （220-a Win 版同构复用第二例）。
        编码X64L实参装载(实参们, 类们, 号们, 输出);
        加行X64L(输出, "    call " + 符号修饰X64L(驻留文本(指令.附加)));
        如果 (栈区 > 0) {
            加行X64L(输出, "    add rsp, " + 整数转字符串(栈区));
        }
        编码X64L返回装载(指令, 输出);
        返回 真;
    }
    返回 假;
}


// 221-a：族①a X64L 实参装载——栈实参先装载（r10/xmm0 中转，sub rsp 之后
//   [rsp+8k] 写入）+寄存器实参（整型 rdi..r9 / 浮点 xmm0..xmm7 分派）。
函数 编码X64L实参装载(向量<IR指令>& 实参们, 向量<整64>& 类们, 向量<整64>& 号们, 向量<字符串> 输出) -> 空类型 {
        // 栈实参先装载（r10/xmm0 中转，sub rsp 之后 [rsp+8k] 写入）
        整64 a = 0;
        当 (a < 实参们.大小()) {
            IR指令 实参 = 实参们.元素(a);
            如果 (类们.元素(a) == 2) {
                字符串 偏移a = 整数转字符串(号们.元素(a) * 8);
                如果 (实参.操作数2 == T_浮32 || 实参.操作数2 == T_浮64) {
                    字符串 后a = (实参.操作数2 == T_浮64) ? "sd" : "ss";
                    字符串 宽a = (实参.操作数2 == T_浮64) ? "qword ptr " : "dword ptr ";
                    加行X64L(输出, "    mov" + 后a + " xmm0, " +
                        槽文本X64L(寄存器槽偏移(实参.操作数1)));
                    加行X64L(输出, "    mov" + 后a + " " + 宽a + "[rsp+" + 偏移a + "], xmm0");
                } 否则 {
                    加行X64L(输出, "    mov r10, " +
                        槽文本X64L(寄存器槽偏移(实参.操作数1)));
                    加行X64L(输出, "    mov qword ptr [rsp+" + 偏移a + "], r10");
                }
            }
            a++;
        }
        // 寄存器实参（整型类 rdi..r9 / 浮点类 xmm0..xmm7——游标分配表分派）
        整64 b = 0;
        当 (b < 实参们.大小()) {
            IR指令 实参2 = 实参们.元素(b);
            整64 类b = 类们.元素(b);
            如果 (类b == 0) {
                加行X64L(输出, "    mov " + 参数寄存器名X64L(号们.元素(b)) + ", " +
                    槽文本X64L(寄存器槽偏移(实参2.操作数1)));
            } 否则 如果 (类b == 1) {
                字符串 后b = (实参2.操作数2 == T_浮64) ? "sd" : "ss";
                字符串 宽b = (实参2.操作数2 == T_浮64) ? "qword ptr " : "dword ptr ";
                加行X64L(输出, "    mov" + 后b + " xmm" + 整数转字符串(号们.元素(b)) +
                    ", " + 宽b + 槽文本X64L(寄存器槽偏移(实参2.操作数1)));
            }
            b++;
        }
}

// 221-a：族①b X64L 返回装载——浮点返回码（操作数2）-> xmm0 装载，其余 -> rax；
//   111-a ≤32 位返回类型高位规范化（与 win 侧同款纪律，三后端同治）。
函数 编码X64L返回装载(IR指令 指令, 向量<字符串> 输出) -> 空类型 {
        如果 (指令.目标 != 0) {
            // 返回装载：浮点返回码（IR_调用参数化.操作数2）-> xmm0；其余 -> rax
            如果 (指令.操作数2 == T_浮32) {
                加行X64L(输出, "    movss dword ptr " +
                    槽文本X64L(寄存器槽偏移(指令.目标)) + ", xmm0");
            } 否则 如果 (指令.操作数2 == T_浮64) {
                加行X64L(输出, "    movsd qword ptr " +
                    槽文本X64L(寄存器槽偏移(指令.目标)) + ", xmm0");
            } 否则 {
                // 111-a：≤32 位返回类型高位规范化（SysV x64 ABI 同 win64——窄返回值
                //   高位未定义；**低 32 位是权威值**，扩展方式与 v2 内部表示一致：
                //   整32=有符号（类型转换生成 movsxd 符号扩展，零扩展会破坏负值语义）；
                //   正32=零扩展；布尔=0/1 零扩展。各 1 条指令，性能代价≈0；
                //   对齐 Rust/LLVM signext/zeroext ——与 win 侧同款纪律，三后端同治。
                整64 返回码n = 指令.操作数2;
                如果 (返回码n == T_布尔) {
                    加行X64L(输出, "    movzx eax, al");
                }
                如果 (返回码n == T_整32) {
                    加行X64L(输出, "    movsxd rax, eax");
                }
                如果 (返回码n == T_正32) {
                    加行X64L(输出, "    mov eax, eax");
                }
                加行X64L(输出, "    mov " + 槽文本X64L(寄存器槽偏移(指令.目标)) + ", rax");
            }
        }
}


// 静态组：静态槽读/地址/写（mov/lea rip 相对——.data 可写）。
函数 编码静态X64L(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    如果 (指令.操作码 == IR_静态加载) {
        // ②c C：静态槽读——mov rip 相对（-no-pie；.data 可写）
        加行X64L(输出, "    mov r10, qword ptr [rip+" + 静态槽标签(指令.附加) + "]");
        加行X64L(输出, "    mov " + 槽文本X64L(寄存器槽偏移(指令.目标)) + ", r10");
        返回 真;
    }
    如果 (指令.操作码 == IR_静态地址) {
        // 静态槽地址（lea）——拷贝构造源 T& 传静态容器左值地址
        加行X64L(输出, "    lea r10, qword ptr [rip+" + 静态槽标签(指令.附加) + "]");
        加行X64L(输出, "    mov " + 槽文本X64L(寄存器槽偏移(指令.目标)) + ", r10");
        返回 真;
    }
    如果 (指令.操作码 == IR_静态存储) {
        // ②c C：静态槽写（操作数1=值寄存器）
        加行X64L(输出, "    mov r10, " + 槽文本X64L(寄存器槽偏移(指令.操作数1)));
        加行X64L(输出, "    mov qword ptr [rip+" + 静态槽标签(指令.附加) + "], r10");
        返回 真;
    }
    返回 假;
}


// ==================== 函数生成 ====================
// 生成单函数完整 GAS：.globl/.type/标签 / prologue / 参数装载 / 指令 / epilogue。
// 无 push rbx（v2 retbuf 为帧内栈槽 + IR 层显式拷贝——与宿主形态A差异，见文件头）；
// 对齐链：入口≡8 -> push rbp≡0 -> sub 16对齐帧≡0 -> call 前≡0。
函数 生成函数X64L(函数IR 函数信息, 整64 函数序号, 向量<字符串> 输出) -> 空类型 {
    整64 最大寄存器 = 0;
    整64 最大槽 = 0;
    整64 槽基数 = 0;
    扫描函数(函数信息, &最大寄存器, &最大槽, &槽基数);
    整64 retbuf槽数 = retbuf槽位数(函数信息);    // ②b B6：与 扫描函数 同一决策
    整64 帧大小 = 计算帧大小(最大寄存器, 最大槽);
    字符串 函数名 = 符号修饰X64L(驻留文本(整64(函数信息.名字)));
    加行X64L(输出, ".globl " + 函数名);
    加行X64L(输出, ".type " + 函数名 + ", @function");
    加行X64L(输出, 函数名 + ":");
    加行X64L(输出, "    push rbp");
    加行X64L(输出, "    mov rbp, rsp");
    加行X64L(输出, "    sub rsp, " + 整数转字符串(帧大小));
    // SysV 参数装载（②b B8 按声明序：参数槽序们/参数拷贝字节们）——标量：
    //   前 6 位 rdi,rsi,rdx,rcx,r8,r9 直存，第 7 位起 [rbp+16+8k]（r10 中转）；
    //   结构体按值：入参为指针（B3 调用方约定）——r10=指针、r11=数据，逐 8 字节
    //   展开 + 字节尾巴（宿主 emitParamSetup 修复后同款；**禁 rep movsb/rcx 计数**：
    //   rsi=位1/rcx=位3 在本参数之后装载的参数仍占寄存器，残留覆盖=第十八轮宿主
    //   缺陷同款——数据临时必须取参数寄存器集合 rdi,rsi,rdx,rcx,r8,r9 之外）。
    // 用户函数返回结构体（2026-09-04，E2E 148）：位 0（rdi）=调用方传入的
    //   retbuf 指针——存槽 1（生成函数 已保留）；声明参数位号整体 +1。
    布尔 返回结构体 = 函数信息.返回结构体ID != 0 || 函数信息.返回结果名ID != 0;   // 71-a：结果/可选 返回同款 retbuf ABI
    如果 (返回结构体) {
        加行X64L(输出, "    mov " + 槽文本X64L(变量槽偏移(1, 最大寄存器)) + ", rdi");
    }
    // 91-a（2026-09-13 第九十一轮）：SysV 双计数参数装载（共用层 分配参数位置
    //   单点，与 win/ARM64 序言同构）——整型类 rdi..r9（6，retbuf 占位 0 计入）；
    //   浮点类 xmm0-xmm7（8，独立计数）；溢出按声明序共享栈参区
    //   [rbp+16+栈位号*8]。结构体按值参数=指针（整型类，逐字展开入槽）。
    向量<整64> 类们p = 向量<整64>();
    向量<整64> 号们p = 向量<整64>();
    分配参数位置(函数信息.参数类型们, 6, 8, 返回结构体, 类们p, 号们p);
    整64 参数序 = 0;
    当 (参数序 < 函数信息.参数槽序们.大小()) {
        整64 参数槽 = 函数信息.参数槽序们.元素(参数序);
        整64 拷贝字节 = 函数信息.参数拷贝字节们.元素(参数序);
        整64 类p = 0;
        整64 号p = 0;
        如果 (参数序 < 类们p.大小()) {
            类p = 类们p.元素(参数序);
            号p = 号们p.元素(参数序);
        }
        整64 参类p = 0;
        如果 (参数序 < 函数信息.参数类型们.大小()) {
            参类p = 函数信息.参数类型们.元素(参数序);
        }
        如果 (类p == 1) {
            字符串 后p = (参类p == T_浮64) ? "sd" : "ss";
            加行X64L(输出, "    mov" + 后p + " " +
                槽文本X64L(变量槽偏移(参数槽, 最大寄存器)) + ", xmm" +
                整数转字符串(号p));
        } 否则 如果 (类p == 2) {
            如果 (拷贝字节 > 0) {
                // 110-a：结构体按值栈参数（B3 约定=指针传入，调用方写指针）——
                //   从栈位取源指针后逐字拷贝入槽（寄存器路径同款）。原实现落下方
                //   标量路径只存 8 字节指针 → 被调方按内联数据访问 → 数据错
                //   （E2E 158_v2 分歧面③ win 侧实证；SysV ≥7 结构体参数才触发）。
                加行X64L(输出, "    mov r10, [rbp+" +
                    整数转字符串(16 + 号p * 8) + "]");
                发射参数拷贝X64L(输出, 参数槽, 最大寄存器, 拷贝字节);
            } 否则 如果 (参类p == T_浮32 || 参类p == T_浮64) {
                字符串 后p = (参类p == T_浮64) ? "sd" : "ss";
                字符串 宽p = (参类p == T_浮64) ? "qword ptr " : "dword ptr ";
                加行X64L(输出, "    mov" + 后p + " xmm0, " + 宽p + "[rbp+" +
                    整数转字符串(16 + 号p * 8) + "]");
                加行X64L(输出, "    mov" + 后p + " " +
                    槽文本X64L(变量槽偏移(参数槽, 最大寄存器)) + ", xmm0");
            } 否则 {
                加行X64L(输出, "    mov r10, [rbp+" +
                    整数转字符串(16 + 号p * 8) + "]");
                加行X64L(输出, "    mov " + 槽文本X64L(变量槽偏移(参数槽, 最大寄存器)) + ", r10");
            }
        } 否则 如果 (拷贝字节 == 0) {
            加行X64L(输出, "    mov " + 槽文本X64L(变量槽偏移(参数槽, 最大寄存器)) +
                ", " + 参数寄存器名X64L(号p));
        } 否则 {
            // 源指针 -> r10（整型寄存器）；目标参数槽 -> 逐字展开（单点助手）
            加行X64L(输出, "    mov r10, " + 参数寄存器名X64L(号p));
            发射参数拷贝X64L(输出, 参数槽, 最大寄存器, 拷贝字节);
        }
        参数序++;
    }
    // 指令主循环（IR_调用实参 为声明性指令：收集，IR_调用参数化 统一展开）
    向量<IR指令> 调用实参们 = 向量<IR指令>();
    整64 i = 0;
    当 (i < 函数信息.指令.大小()) {
        IR指令 指令 = 函数信息.指令.元素(i);
        如果 (指令.操作码 == IR_调用实参) {
            结果<空类型, 整32> 加实 = 调用实参们.追加(指令);
            如果 (!加实.正常) { 运行时错误(4); }
        } 否则 {
            生成指令X64L(指令, 最大寄存器, 槽基数, retbuf槽数, 函数序号, 调用实参们, 输出);
            如果 (指令.操作码 == IR_调用参数化) {
                调用实参们.清空();
            }
        }
        i++;
    }
    // epilogue（返回 指令 已 mov rax；尾块统一出口）
    加行X64L(输出, "    mov rsp, rbp");
    加行X64L(输出, "    pop rbp");
    加行X64L(输出, "    ret");
    加行X64L(输出, "");
}

// ==================== 程序入口 ====================
// 程序IR -> GAS 行列表。.intel_syntax 头 + .text 函数区 + .data 字符串常量（去重）
//   + .data 静态槽 + .note.GNU-stack 收尾。GAS 无需 EXTERN（未定义符号默认外部）。
函数 代码生成X64Linux(程序IR 程序) -> 向量<字符串> {
    向量<字符串> 输出 = 向量<字符串>();
    加行X64L(输出, "// 由 v2 代码生成X64Linux 生成（linux-x86_64 / GNU as / System V AMD64）");
    加行X64L(输出, ".intel_syntax noprefix");
    加行X64L(输出, ".text");
    整64 f = 0;
    当 (f < 程序.函数们.大小()) {
        生成函数X64L(程序.函数们.元素(f), f, 输出);
        f++;
    }
    // 字符串常量数据段（共用层收集去重；.byte 十进制字节 + 0 终止）
    向量<整64> 常量ID们 = 收集字符串常量(程序);
    整64 s2 = 0;
    当 (s2 < 常量ID们.大小()) {
        字符串 文本 = 字符串复制(驻留文本(常量ID们.元素(s2)));
        加行X64L(输出, ".data");
        加行X64L(输出, "strData_" + 整数转字符串(常量ID们.元素(s2)) + ":");
        字符串 字节行 = "    .byte";
        整64 b = 0;
        当 (b < 字符串长度(文本)) {
            整64 字节 = 整64(文本[b]) & 255;
            字节行 = 字节行 + " " + 整数转字符串(字节) + ",";
            b++;
        }
        加行X64L(输出, 字节行 + " 0");
        s2++;
    }
    // 浮点常量数据段（89-a；8 对齐保证 8 字节装载——x86 GAS .align N=对齐到 N 字节）
    向量<整64> 浮点ID们 = 收集浮点常量(程序);
    整64 fd = 0;
    当 (fd < 浮点ID们.大小()) {
        加行X64L(输出, ".data");
        加行X64L(输出, ".align 8");
        加行X64L(输出, "floatData_" + 整数转字符串(浮点ID们.元素(fd)) + ":");
        加行X64L(输出, "    .double " + 浮点文本净(浮点ID们.元素(fd)));
        fd++;
    }
    // ②c C：静态槽数据段（.data 可写；标量静态直存折叠初始值，容器静态 0——
    //   入口 NewObject+构造注入指针）
    如果 (程序.静态数 > 0) {
        加行X64L(输出, ".data");
        // 87-a：静态槽 8 对齐（字符串常量池 .byte 长度任意——非对齐 i64 访存
        //   在严格平台为 UB、x64 为性能损失；x86 GAS .align N=对齐到 N 字节）
        加行X64L(输出, ".align 8");
        整64 g = 0;
        当 (g < 程序.静态数) {
            字符串 初始值 = "0";
            如果 (g < 程序.静态初始值们.大小()) {
                初始值 = 字符串复制(驻留文本(程序.静态初始值们.元素(g)));
            }
            加行X64L(输出, 静态槽标签(g) + ":");
            // 87-a（2026-09-12 第八十七轮）：结构体静态槽按类型尺寸分配
            //   （原恒 `.quad`=8 字节 → 结构体整体拷贝 16/24… 字节**越界写相邻
            //   .data 符号**，静默内存破坏；读取第二字段落到他人数据）。
            //   8 字节取整保证后续槽对齐不变式；标量/容器指针槽恒 8 字节。
            整64 静大小a = 查结构体大小(取静态类型(g));
            如果 (静大小a > 8) {
                整64 静槽数a = (静大小a + 7) / 8;
                字符串 静行a = "    .quad 0";
                整64 静填a = 1;
                当 (静填a < 静槽数a) {
                    静行a = 静行a + ", 0";
                    静填a++;
                }
                加行X64L(输出, 静行a);
            } 否则 {
                加行X64L(输出, "    .quad " + 初始值);
            }
            g++;
        }
    }
    加行X64L(输出, ".section .note.GNU-stack,\"\",@progbits");
    返回 输出;
}
