// CN 自举编译器 v2：结构化代码生成器——win-x64 MASM 后端（自举重建 P6，2026-08-25）
// 后端架构方案1（用户裁决 2026-09-02）：本文件只保留"平台发射"——助记符/寄存器名/
//   MASM 符号修饰/段指令；帧扫描、槽偏移、调用编址、标签唯一化、字符串收集等
//   平台无关决策统一在 代码生成共用.cn（双后端单点维护，第三平台只需纯发射器）。
// 平台发射约定：
//   - 虚拟寄存器 r -> [rbp-8r-8]；变量槽 s -> [rbp-8*(最大寄存器+s)-8]；
//   - 函数框架：PROC 名 PROC / push rbp / mov rbp,rsp / sub rsp,帧大小 /
//     指令 / mov rsp,rbp / pop rbp / ret / 名 ENDP；
//   - Win x64 参数装载：前 4 参数 rcx/rdx/r8/r9 -> 参数槽；标量返回 rax；
//     位<4 走 rcx/rdx/r8/r9、影子空间 32、被调方 [rbp+48+(位-4)*8]。

导入 容器::向量;
导入 IR;           // IR 指令/容器判定/操作码（原 IR生成+IR容器+IR常量 合并目录包名）
导入 代码生成;     // 后端共用决策层（原 代码生成共用；同包包名幂等加载）

公开:


// ==================== 指令编码函数组（R4，2026-09-08 自 生成指令 机械搬移） ====================
// 每函数收同款上下文返回 布尔=该操作码是否由本组处理（真=已发射）。

// 数据移动组：常量整数/常量字符串/槽加载/槽存储。
函数 编码数据移动Win(IR指令 指令, 整64 最大寄存器, 向量<字符串> 输出) -> 布尔 {
    如果 (指令.操作码 == IR_常量整数) {
        // 常量整数：操作数1 = Symbol ID（文本），mov 目标槽, 值（MASM 归一）
        字符串 值 = 常量立即数文本(驻留文本(指令.操作数1));
        结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 值);
        结果<空类型, 整32> 加2 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
        返回 真;
    }
    如果 (指令.操作码 == IR_常量浮点) {
        // 浮点常量（89-a）：floatData_<文本ID>（REAL8 文本直通）——lea 取址 +
        //   8 字节装载（宿主 ConstFloat 同款语义；win 侧实物验证=跨机轮）
        结果<空类型, 整32> 加f0 = 输出.追加("    lea rax, floatData_" + 整数转字符串(指令.操作数1));
        结果<空类型, 整32> 加f1 = 输出.追加("    mov rax, [rax]");
        结果<空类型, 整32> 加f2 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
        返回 真;
    }
    如果 (指令.操作码 == IR_常量字符串) {
        // P7b 字符串常量：lea 目标, strData_<文本ID>；数据行以 DAT 前缀混入输出，
        //   代码生成 末尾后处理重排到全部函数之后（.code 段内 db 数据定义）
        结果<空类型, 整32> 加s0 = 输出.追加("    lea rax, strData_" + 整数转字符串(指令.操作数1));
        结果<空类型, 整32> 加s1 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
        返回 真;
    }
    如果 (指令.操作码 == IR_加载) {
        // Load 变量槽 -> 寄存器
        结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 变量槽(指令.操作数1, 最大寄存器));
        结果<空类型, 整32> 加2 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
        返回 真;
    }
    如果 (指令.操作码 == IR_存储) {
        // Store 寄存器 -> 变量槽（操作数1=值寄存器，附加=槽）
        结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1));
        结果<空类型, 整32> 加2 = 输出.追加("    mov " + 变量槽(指令.附加, 最大寄存器) + ", rax");
        返回 真;
    }
    返回 假;
}

// 算术组：加/减/乘/除/取余（除/取余 cqo 符号扩展——2026-09-06 #DE 根治）。
// 530-a（D1 行数滚动·纯机械拆分零行为变更·2026-09-20）：编码算术Win 206 行 →
//   分派器+七子函数——逻辑逐字迁移注释逐字保留（行号切片+边界断言）。
//   等价红线=新旧 v2p 交叉编译同一输入 win-x64 asm 文本逐字节 md5 一致（/tmp/p530 双对拍）。
函数 编码浮点四则Win(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    // 91-a（2026-09-13 第九十一轮）：浮点算术（指令.类型=T_浮32/T_浮64）——
    //   SSE 标量指令（addsd/subsd/mulsd/divsd；浮32 用 ss 族，MASM 内存操作数
    //   须显式 dword ptr）；取余 % 不在浮点面内（宿主语义层拒绝浮点操作数）。
    字符串 后缀w = (指令.类型 == T_浮64) ? "sd" : "ss";
    字符串 左w = 寄存器槽(指令.操作数1);
    字符串 右w = 寄存器槽(指令.操作数2);
    字符串 目w = 寄存器槽(指令.目标);
    如果 (指令.类型 == T_浮32) {
        左w = "dword ptr " + 左w;
        右w = "dword ptr " + 右w;
        目w = "dword ptr " + 目w;
    } 否则 如果 (指令.类型 == T_浮64) {
        // 109-a：MASM 浮64 内存操作数须 qword ptr size 说明符
        //   （缺 → A2070；91-a 增浮点分派同批漏点）。
        左w = "qword ptr " + 左w;
        右w = "qword ptr " + 右w;
        目w = "qword ptr " + 目w;
    }
    字符串 运算w = "add";
    如果 (指令.操作码 == IR_减) { 运算w = "sub"; }
    否则 如果 (指令.操作码 == IR_乘) { 运算w = "mul"; }
    否则 如果 (指令.操作码 == IR_除) { 运算w = "div"; }
    结果<空类型, 整32> 加f1 = 输出.追加("    mov" + 后缀w + " xmm0, " + 左w);
    结果<空类型, 整32> 加f2 = 输出.追加("    mov" + 后缀w + " xmm1, " + 右w);
    结果<空类型, 整32> 加f3 = 输出.追加("    " + 运算w + 后缀w + " xmm0, xmm1");
    结果<空类型, 整32> 加f4 = 输出.追加("    mov" + 后缀w + " " + 目w + ", xmm0");
    返回 真;
}
函数 编码加法Win(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1));
    结果<空类型, 整32> 加2 = 输出.追加("    add rax, " + 寄存器槽(指令.操作数2));
    // 264-a D34 波1：32 位类型出口截断（整32 movsxd 符号扩展回填/
    //   正32 清高）——64 位直算不回绕=正32+正32 溢出面错误（191 实锤）
    如果 (指令.类型 == T_整32) {
        结果<空类型, 整32> 加3t = 输出.追加("    movsxd rax, eax");
    } 否则 如果 (指令.类型 == T_正32) {
        结果<空类型, 整32> 加3u = 输出.追加("    mov eax, eax");
    }
    结果<空类型, 整32> 加3 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
    返回 真;
}
函数 编码减法Win(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1));
    结果<空类型, 整32> 加2 = 输出.追加("    sub rax, " + 寄存器槽(指令.操作数2));
    // 264-a D34 波1：32 位类型出口截断（整32 movsxd 符号扩展回填/
    //   正32 清高）——64 位直算不回绕=正32+正32 溢出面错误（191 实锤）
    如果 (指令.类型 == T_整32) {
        结果<空类型, 整32> 加3t = 输出.追加("    movsxd rax, eax");
    } 否则 如果 (指令.类型 == T_正32) {
        结果<空类型, 整32> 加3u = 输出.追加("    mov eax, eax");
    }
    结果<空类型, 整32> 加3 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
    返回 真;
}
函数 编码乘法Win(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1));
    结果<空类型, 整32> 加2 = 输出.追加("    imul rax, " + 寄存器槽(指令.操作数2));
    // 264-a D34 波1：32 位类型出口截断（整32 movsxd 符号扩展回填/
    //   正32 清高）——64 位直算不回绕=正32+正32 溢出面错误（191 实锤）
    如果 (指令.类型 == T_整32) {
        结果<空类型, 整32> 加3t = 输出.追加("    movsxd rax, eax");
    } 否则 如果 (指令.类型 == T_正32) {
        结果<空类型, 整32> 加3u = 输出.追加("    mov eax, eax");
    }
    结果<空类型, 整32> 加3 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
    返回 真;
}
函数 编码除余Win(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    // 351-a（T27 v2 侧同构·阶段二·423 SIGFPE 三后端闭环）：与 X64Linux 350-a 版
    //   逐行同构——①除零检查（test/jnz + 错误码 1=错误码.除零）；②有符号
    //   INT_MIN/-1 溢出保护（x86 idiv 溢出抛 #DE → 两补码统一回绕：x/-1≡-x
    //   〔neg·INT_MIN→INT_MIN〕·x%-1≡0——宿主 319-a 双保护同构）；③32 位位宽
    //   分派（装载 movsxd/0扩展 + cdq/xor + idiv/div r11d + 结局 movsxd/mov·
    //   对齐宿主 cdq+idiv r9d）。win 调用约定差异（351-a p1 探针取证=既有 IR
    //   通道错误调用同款）：首参 **rcx** + shadow space（sub/add rsp,32）；
    //   EXTERN 由 收集EXTERN符号 自动声明（call 行扫描·P7b 机制）。
    布尔 是32位w = (指令.类型 == T_整32 || 指令.类型 == T_正32);
    布尔 除法有符号w = !(指令.类型 == T_正32 || 指令.类型 == T_正64);
    整64 保护序w = 输出.大小();
    如果 (是32位w) {
        如果 (除法有符号w) {
            结果<空类型, 整32> 加d1 = 输出.追加("    movsxd r10, dword ptr " + 寄存器槽(指令.操作数1));
            结果<空类型, 整32> 加d2 = 输出.追加("    movsxd r11, dword ptr " + 寄存器槽(指令.操作数2));
        } 否则 {
            结果<空类型, 整32> 加d3 = 输出.追加("    mov r10d, dword ptr " + 寄存器槽(指令.操作数1));
            结果<空类型, 整32> 加d4 = 输出.追加("    mov r11d, dword ptr " + 寄存器槽(指令.操作数2));
        }
    } 否则 {
        结果<空类型, 整32> 加d5 = 输出.追加("    mov r10, " + 寄存器槽(指令.操作数1));
        结果<空类型, 整32> 加d6 = 输出.追加("    mov r11, " + 寄存器槽(指令.操作数2));
    }
    结果<空类型, 整32> 加d7 = 输出.追加("    test r11, r11");
    结果<空类型, 整32> 加d8 = 输出.追加("    jne " + 除零跳过标签(保护序w));
    结果<空类型, 整32> 加d9 = 输出.追加("    sub rsp, 32");
    结果<空类型, 整32> 加d10 = 输出.追加("    mov rcx, 1");
    结果<空类型, 整32> 加d11 = 输出.追加("    call __cn_runtime_error");
    结果<空类型, 整32> 加d12 = 输出.追加("    add rsp, 32");
    结果<空类型, 整32> 加d13 = 输出.追加("    ret");
    结果<空类型, 整32> 加d14 = 输出.追加(除零跳过标签(保护序w) + ":");
    如果 (除法有符号w) {
        结果<空类型, 整32> 加d15 = 输出.追加("    cmp r11, -1");
        结果<空类型, 整32> 加d16 = 输出.追加("    jne " + 除安全标签(保护序w));
        如果 (指令.操作码 == IR_除) {
            结果<空类型, 整32> 加d17 = 输出.追加("    neg r10");
            如果 (是32位w) {
                结果<空类型, 整32> 加d18 = 输出.追加("    movsxd r10, r10d");
            }
        } 否则 {
            结果<空类型, 整32> 加d19 = 输出.追加("    mov r10, 0");
        }
        结果<空类型, 整32> 加d20 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", r10");
        结果<空类型, 整32> 加d21 = 输出.追加("    jmp " + 除结束标签(保护序w));
        结果<空类型, 整32> 加d22 = 输出.追加(除安全标签(保护序w) + ":");
    }
    如果 (是32位w) {
        结果<空类型, 整32> 加d23 = 输出.追加("    mov eax, r10d");
        如果 (除法有符号w) {
            结果<空类型, 整32> 加d24 = 输出.追加("    cdq");
            结果<空类型, 整32> 加d25 = 输出.追加("    idiv r11d");
        } 否则 {
            结果<空类型, 整32> 加d26 = 输出.追加("    xor edx, edx");
            结果<空类型, 整32> 加d27 = 输出.追加("    div r11d");
        }
        如果 (指令.操作码 == IR_除) {
            如果 (除法有符号w) {
                结果<空类型, 整32> 加d28 = 输出.追加("    movsxd r10, eax");
            } 否则 {
                结果<空类型, 整32> 加d29 = 输出.追加("    mov r10d, eax");
            }
        } 否则 {
            如果 (除法有符号w) {
                结果<空类型, 整32> 加d30 = 输出.追加("    movsxd r10, edx");
            } 否则 {
                结果<空类型, 整32> 加d31 = 输出.追加("    mov r10d, edx");
            }
        }
        结果<空类型, 整32> 加d32 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", r10");
    } 否则 {
        结果<空类型, 整32> 加d33 = 输出.追加("    mov rax, r10");
        如果 (除法有符号w) {
            结果<空类型, 整32> 加d34 = 输出.追加("    cqo");
            结果<空类型, 整32> 加d35 = 输出.追加("    idiv r11");
        } 否则 {
            结果<空类型, 整32> 加d36 = 输出.追加("    xor edx, edx");
            结果<空类型, 整32> 加d37 = 输出.追加("    div r11");
        }
        如果 (指令.操作码 == IR_除) {
            结果<空类型, 整32> 加d38 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
        } 否则 {
            结果<空类型, 整32> 加d39 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rdx");
        }
    }
    如果 (除法有符号w) {
        结果<空类型, 整32> 加d40 = 输出.追加(除结束标签(保护序w) + ":");
    }
    返回 真;
}
函数 编码位运算Win(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    字符串 位指令 = "and";
    如果 (指令.操作码 == IR_位或) { 位指令 = "or"; }
    如果 (指令.操作码 == IR_位异或) { 位指令 = "xor"; }
    结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1));
    结果<空类型, 整32> 加2 = 输出.追加("    " + 位指令 + " rax, " + 寄存器槽(指令.操作数2));
    // 264-a D34 波1：32 位类型出口截断（同算术族）
    如果 (指令.类型 == T_整32) {
        结果<空类型, 整32> 加3t = 输出.追加("    movsxd rax, eax");
    } 否则 如果 (指令.类型 == T_正32) {
        结果<空类型, 整32> 加3u = 输出.追加("    mov eax, eax");
    }
    结果<空类型, 整32> 加3 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
    返回 真;
}
函数 编码移位Win(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    // >> 有符号=算术 sar；无符号（T_正32/正64，46-f 第五十轮）=逻辑 shr
    //   （2^64-1>>1 须=2^63-1 非 -1）；左操作数 rax、移位量 cl
    字符串 移指令 = "shl";
    如果 (指令.操作码 == IR_右移) {
        如果 (指令.类型 == T_正32 || 指令.类型 == T_正64) { 移指令 = "shr"; }
        否则 { 移指令 = "sar"; }
    }
    结果<空类型, 整32> 移1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1));
    结果<空类型, 整32> 移2 = 输出.追加("    mov rcx, " + 寄存器槽(指令.操作数2));
    // 265-a 波A（规范 01b§5.4）：移位量显式按操作数位宽取模——32 位类型
    //   mod 32（x86 64 位操作数硬件 mod 64≠规范语义·178 实锤 5<<33）；64 位 mod 63
    如果 (指令.类型 == T_整32 || 指令.类型 == T_正32) {
        结果<空类型, 整32> 移2m = 输出.追加("    and ecx, 31");
    } 否则 {
        结果<空类型, 整32> 移2m6 = 输出.追加("    and ecx, 63");
    }
    结果<空类型, 整32> 移3 = 输出.追加("    " + 移指令 + " rax, cl");
    如果 (指令.类型 == T_整32) {
        结果<空类型, 整32> 移3t = 输出.追加("    movsxd rax, eax");
    } 否则 如果 (指令.类型 == T_正32) {
        结果<空类型, 整32> 移3t = 输出.追加("    mov eax, eax");
    }
    结果<空类型, 整32> 移4 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
    返回 真;
}

函数 编码算术Win(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    布尔 是浮点算术w = (指令.类型 == T_浮32 || 指令.类型 == T_浮64);
    如果 (是浮点算术w && (指令.操作码 == IR_加 || 指令.操作码 == IR_减 ||
                        指令.操作码 == IR_乘 || 指令.操作码 == IR_除)) {
        返回 编码浮点四则Win(指令, 输出);
    }
    如果 (指令.操作码 == IR_加) { 返回 编码加法Win(指令, 输出); }
    如果 (指令.操作码 == IR_减) { 返回 编码减法Win(指令, 输出); }
    如果 (指令.操作码 == IR_乘) { 返回 编码乘法Win(指令, 输出); }
    如果 (指令.操作码 == IR_除 || 指令.操作码 == IR_取余) { 返回 编码除余Win(指令, 输出); }
    // 位运算（2026-09-09 规范 01b§5.4）：and/or/xor 单指令；移位量经 cl（x86 规定），
    //   265-a 波A：移位量已显式按类型位宽取模（原「硬件 64 位取模=规范语义」前提错误）
    如果 (指令.操作码 == IR_位与 || 指令.操作码 == IR_位或 || 指令.操作码 == IR_位异或) { 返回 编码位运算Win(指令, 输出); }
    如果 (指令.操作码 == IR_左移 || 指令.操作码 == IR_右移) { 返回 编码移位Win(指令, 输出); }
    返回 假;
}

// 比较与一元组：setcc 六比较 / 逻辑非 / 一元负；91-a 增浮点分派。
函数 编码比较一元Win(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    // 91-a：浮点比较（NaN 安全 IEEE ordered 语义，与宿主 H1 修复/linux 后端
    //   同款）——< / <= 交换操作数走 seta/setae；== / != 加 setnp/setp 组合。
    布尔 是浮点比较w = (指令.类型 == T_浮32 || 指令.类型 == T_浮64);
    如果 (是浮点比较w && (指令.操作码 == IR_相等 || 指令.操作码 == IR_不等 ||
                        指令.操作码 == IR_小于 || 指令.操作码 == IR_大于 ||
                        指令.操作码 == IR_小于等于 || 指令.操作码 == IR_大于等于)) {
        字符串 后缀w = (指令.类型 == T_浮64) ? "sd" : "ss";
        字符串 比较w = (指令.类型 == T_浮64) ? "ucomisd" : "ucomiss";
        字符串 左槽w = 寄存器槽(指令.操作数1);
        字符串 右槽w = 寄存器槽(指令.操作数2);
        如果 (指令.类型 == T_浮32) {
            左槽w = "dword ptr " + 左槽w;
            右槽w = "dword ptr " + 右槽w;
        } 否则 如果 (指令.类型 == T_浮64) {
            // 109-a（2026-09-13 家机 win-x64 跨机轮）：MASM movsd 缺 size 说明符
            //   歧义——ml64 优先解析为字符串指令 → A2070（invalid instruction
            //   operands；实测 `movsd xmm0, [mem]` 报错、`movsd xmm0, qword ptr [mem]`
            //   合法）。91-a 增浮点比较分派时仅浮32 加 dword ptr，浮64 漏加 →
            //   E2E 246（静态浮64 比较）win 侧 ml64 汇编失败（linux GAS 语法无需
            //   说明符故不显）；与前方 movsd/movss 装载点同款纪律。
            左槽w = "qword ptr " + 左槽w;
            右槽w = "qword ptr " + 右槽w;
        }
        布尔 交换w = (指令.操作码 == IR_小于 || 指令.操作码 == IR_小于等于);
        如果 (交换w) {
            结果<空类型, 整32> 加lw1 = 输出.追加("    mov" + 后缀w + " xmm0, " + 右槽w);
            结果<空类型, 整32> 加lw2 = 输出.追加("    mov" + 后缀w + " xmm1, " + 左槽w);
        } 否则 {
            结果<空类型, 整32> 加lw3 = 输出.追加("    mov" + 后缀w + " xmm0, " + 左槽w);
            结果<空类型, 整32> 加lw4 = 输出.追加("    mov" + 后缀w + " xmm1, " + 右槽w);
        }
        结果<空类型, 整32> 加lw5 = 输出.追加("    " + 比较w + " xmm0, xmm1");
        如果 (指令.操作码 == IR_相等) {
            结果<空类型, 整32> 加lw6 = 输出.追加("    sete al");
            结果<空类型, 整32> 加lw7 = 输出.追加("    setnp cl");
            结果<空类型, 整32> 加lw8 = 输出.追加("    and al, cl");
        } 否则 如果 (指令.操作码 == IR_不等) {
            结果<空类型, 整32> 加lw9 = 输出.追加("    setne al");
            结果<空类型, 整32> 加lw10 = 输出.追加("    setp cl");
            结果<空类型, 整32> 加lw11 = 输出.追加("    or al, cl");
        } 否则 如果 (指令.操作码 == IR_小于) {
            结果<空类型, 整32> 加lw12 = 输出.追加("    seta al");    // 交换后 < = 右>左
        } 否则 如果 (指令.操作码 == IR_小于等于) {
            结果<空类型, 整32> 加lw13 = 输出.追加("    setae al");   // 交换后 <= = 右>=左
        } 否则 如果 (指令.操作码 == IR_大于) {
            结果<空类型, 整32> 加lw14 = 输出.追加("    seta al");
        } 否则 {
            结果<空类型, 整32> 加lw15 = 输出.追加("    setae al");
        }
        结果<空类型, 整32> 加lw16 = 输出.追加("    movzx eax, al");
        结果<空类型, 整32> 加lw17 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
        返回 真;
    }
    如果 (指令.操作码 == IR_相等 || 指令.操作码 == IR_不等 ||
        指令.操作码 == IR_小于 || 指令.操作码 == IR_大于 ||
        指令.操作码 == IR_小于等于 || 指令.操作码 == IR_大于等于) {
        // 比较：cmp 左, 右；setcc al；movzx 目标。46-f 第五十轮：无符号操作数
        //   （T_正32/正64）用无符号条件码 setb/seta/setbe/setae（2^63>100 按
        //   -2^63>100 判假=静默错误）
        整64 无符号 = (指令.类型 == T_正32 || 指令.类型 == T_正64) ? 1 : 0;
        字符串 设置指令 = "sete";
        如果 (指令.操作码 == IR_不等) { 设置指令 = "setne"; }
        否则 如果 (指令.操作码 == IR_小于) { 设置指令 = 无符号 == 1 ? "setb" : "setl"; }
        否则 如果 (指令.操作码 == IR_大于) { 设置指令 = 无符号 == 1 ? "seta" : "setg"; }
        否则 如果 (指令.操作码 == IR_小于等于) { 设置指令 = 无符号 == 1 ? "setbe" : "setle"; }
        否则 如果 (指令.操作码 == IR_大于等于) { 设置指令 = 无符号 == 1 ? "setae" : "setge"; }
        结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1));
        结果<空类型, 整32> 加2 = 输出.追加("    cmp rax, " + 寄存器槽(指令.操作数2));
        结果<空类型, 整32> 加3 = 输出.追加("    " + 设置指令 + " al");
        结果<空类型, 整32> 加4 = 输出.追加("    movzx eax, al");
        结果<空类型, 整32> 加5 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
        返回 真;
    }
    如果 (指令.操作码 == IR_逻辑非) {
        // 逻辑非：先装载到 rax 再 cmp 0（栈槽直接 cmp 立即数时 MASM 无法推断
        // 操作数尺寸，A2070；对齐本文件比较运算的先装载惯例）
        结果<空类型, 整32> 加0 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1));
        结果<空类型, 整32> 加1 = 输出.追加("    cmp rax, 0");
        结果<空类型, 整32> 加2 = 输出.追加("    sete al");
        结果<空类型, 整32> 加3 = 输出.追加("    movzx eax, al");
        结果<空类型, 整32> 加4 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
        返回 真;
    }
    如果 (指令.操作码 == IR_负) {
        // 91-a：浮点取负=符号位翻转（btc——±0/NaN 语义与 IEEE negate 一致；
        //   浮64 位 63 / 浮32 位 31；整数走 neg 原路径）
        如果 (指令.类型 == T_浮32 || 指令.类型 == T_浮64) {
            整64 符号位w = (指令.类型 == T_浮64) ? 63 : 31;
            结果<空类型, 整32> 加n1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1));
            结果<空类型, 整32> 加n2 = 输出.追加("    btc rax, " + 整数转字符串(符号位w));
            结果<空类型, 整32> 加n3 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
            返回 真;
        }
        // 353-a（T60）：整数 32 位域分派——neg eax 32 位取负（eax 写零扩高 32）
        //   +movsxd 符号回填，防 64 位 neg 高半脏值随槽扩散；8/16 位低段恒同
        //   沿 64 位路径（消费方窄读扩展）。T_正32 低 32 位同 neg32 模 2^32。
        如果 (指令.类型 == T_整32 || 指令.类型 == T_正32) {
            结果<空类型, 整32> 加w1 = 输出.追加("    mov eax, dword ptr " + 寄存器槽(指令.操作数1));
            结果<空类型, 整32> 加w2 = 输出.追加("    neg eax");
            结果<空类型, 整32> 加w3 = 输出.追加("    movsxd rax, eax");
            结果<空类型, 整32> 加w4 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
            返回 真;
        }
        结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1));
        结果<空类型, 整32> 加2 = 输出.追加("    neg rax");
        结果<空类型, 整32> 加3 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
        返回 真;
    }
    返回 假;
}

// 类型转换组：整32 截断 / 整8/整16 movsx 窄读 / 正8/正16 movzx 零扩展
//   （灰色点④+缺陷零容忍收口）/ 整64 movsxd（dword ptr 尺寸前缀——A2070）。
函数 编码类型转换Win(IR指令 指令, 整64 函数序号, 向量<字符串> 输出) -> 布尔 {
        // 214-a（2026-09-15 第两百一十四轮，D1 行数整改）：浮点转换段（浮↔浮/整→浮
        //   〔正64 符号位分支修正〕/浮→整 向零截断）迁 编码浮点转换Win——真=已处理，
        //   假=非浮点（落下方整数段）。
    如果 (指令.操作码 == IR_类型转换) {
        如果 (编码浮点转换Win(指令, 函数序号, 输出)) { 返回 真; }
        字符串 源槽 = 寄存器槽(指令.操作数1);
        // 方案甲（2026-09-10 第五十一轮）：T_正64=64 位源直拷（同宽位模式重解释，
        //   Rust as 对齐——2^63 转 i64 = -2^63；mov rax 全 64 读，无扩展无截断；
        //   原落 movsxd dword 兜底=低 32 截断，193_v2 立案）
        如果 (指令.类型 == T_正64) {
            结果<空类型, 整32> 加z0 = 输出.追加("    mov rax, " + 源槽);
        } 否则 如果 (指令.类型 == T_整32) {
            结果<空类型, 整32> 加1 = 输出.追加("    mov eax, " + 源槽);
            结果<空类型, 整32> 加2 = 输出.追加("    movsxd rax, eax");
        } 否则 如果 (指令.类型 == T_正32) {
            // 46-f 第五十轮：正32 零扩展读回（mov eax 清高 32——原值非符号负）
            结果<空类型, 整32> 加1 = 输出.追加("    mov eax, " + 源槽);
        } 否则 如果 (指令.类型 == T_整8) {
            结果<空类型, 整32> 加n1 = 输出.追加("    mov al, byte ptr " + 源槽);
            结果<空类型, 整32> 加n2 = 输出.追加("    movsx rax, al");
        } 否则 如果 (指令.类型 == T_整16) {
            结果<空类型, 整32> 加n3 = 输出.追加("    mov ax, word ptr " + 源槽);
            结果<空类型, 整32> 加n4 = 输出.追加("    movsx rax, ax");
        } 否则 如果 (指令.类型 == T_正8) {
            // 2026-09-04 缺陷零容忍收口：无符号窄宽零扩展（正8(200)=200）
            结果<空类型, 整32> 加u1 = 输出.追加("    mov al, byte ptr " + 源槽);
            结果<空类型, 整32> 加u2 = 输出.追加("    movzx rax, al");
        } 否则 如果 (指令.类型 == T_正16) {
            结果<空类型, 整32> 加u3 = 输出.追加("    mov ax, word ptr " + 源槽);
            结果<空类型, 整32> 加u4 = 输出.追加("    movzx rax, ax");
        } 否则 {
            // 整64/其他：movsxd 符号扩展（32 位源已由 IR 层按 整64 槽存）。
            //   源为内存槽时必须带 dword ptr——MASM 的 movsxd 无尺寸前缀无法
            //   判定操作数大小（A2070；129 用例 win 侧首跑实锤，GAS 侧无此歧义）。
            //   分派面（第五十五轮标注）：正8/正16 源经 类型码() 归一登记 T_整64，
            //   方案甲源分派已改标 T_正64 直拷不经此兜底；真兜底形态=源登记
            //   T_整32（符号扩展=整32 既有语义）或未登记——均符号扩展正确
            结果<空类型, 整32> 加3 = 输出.追加("    movsxd rax, dword ptr " + 源槽);
        }
        结果<空类型, 整32> 加4 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
        返回 真;
    }
    返回 假;
}


        // P6g（2026-08-30）：类型转换 类型(expr)——目标类型码在 指令.类型，
        //   源值在 指令.操作数1 槽。整64 -> 整32：截断（mov eax 低32位 + movsxd 符号扩展）；
        //   整32 -> 整64：movsxd（符号扩展）。
        // 91-a（2026-09-13 第九十一轮）：浮点转换分派（源码=操作数2，目标码=类型字段）
        //   ——浮->浮（cvtss2sd/cvtsd2ss/同码直拷）、整->浮（cvtsi2sd/ss；正64
        //   无符号经符号位分支修正，cvtu_ 标签=函数序号_目标唯一）、浮->整
        //   （cvttsd2si/ss2si 向零截断）。MASM 浮点内存操作数尺寸：浮32 显式
        //   dword ptr（movss 配 qword 报 A2070）。
// 214-a（2026-09-15 第两百一十四轮，D1 行数整改）：浮点转换段——浮↔浮（cvtss2sd/
//   cvtsd2ss/同码直拷）、整→浮（cvtsi2sd/ss；正64 无符号经符号位分支修正，cvtu_ 标签
//   =函数序号_目标唯一）、浮→整（cvttsd2si/ss2si 向零截断）。MASM 浮点内存操作数尺寸：
//   浮32 显式 dword ptr（movss 配 qword 报 A2070）；110-a 浮64 存回 qword ptr。
//   真=已处理浮点转换；假=非浮点（调用方落整数转换段）。
函数 编码浮点转换Win(IR指令 指令, 整64 函数序号, 向量<字符串> 输出) -> 布尔 {
        整64 源码c = 指令.操作数2;
        布尔 源浮c = (源码c == T_浮32 || 源码c == T_浮64);
        布尔 目标浮c = (指令.类型 == T_浮32 || 指令.类型 == T_浮64);
        如果 (源浮c || 目标浮c) {
            字符串 源槽c = 寄存器槽(指令.操作数1);
            字符串 目标槽c = 寄存器槽(指令.目标);
            如果 (源浮c && 目标浮c) {
                如果 (源码c == 指令.类型) {
                    结果<空类型, 整32> 加c01 = 输出.追加("    mov rax, qword ptr " + 源槽c);
                    结果<空类型, 整32> 加c02 = 输出.追加("    mov " + 目标槽c + ", rax");
                } 否则 如果 (源码c == T_浮32) {
                    结果<空类型, 整32> 加c03 = 输出.追加("    movss xmm0, dword ptr " + 源槽c);
                    结果<空类型, 整32> 加c04 = 输出.追加("    cvtss2sd xmm0, xmm0");
                    结果<空类型, 整32> 加c05 = 输出.追加("    movsd qword ptr " + 目标槽c + ", xmm0");
                } 否则 {
                    结果<空类型, 整32> 加c06 = 输出.追加("    movsd xmm0, qword ptr " + 源槽c);
                    结果<空类型, 整32> 加c07 = 输出.追加("    cvtsd2ss xmm0, xmm0");
                    结果<空类型, 整32> 加c08 = 输出.追加("    movss dword ptr " + 目标槽c + ", xmm0");
                }
                返回 真;
            }
            如果 (目标浮c) {
                字符串 浮后缀i = (指令.类型 == T_浮64) ? "sd" : "ss";
                // 110-a：浮64 存回槽须 qword ptr（MASM movsd 内存操作数歧义 → A2070）。
                字符串 浮宽i = (指令.类型 == T_浮64) ? "qword ptr " : "dword ptr ";
                如果 (源码c == T_整32) {
                    结果<空类型, 整32> 加i1 = 输出.追加("    mov eax, dword ptr " + 源槽c);
                    结果<空类型, 整32> 加i2 = 输出.追加("    movsxd rax, eax");
                } 否则 如果 (源码c == T_整8) {
                    结果<空类型, 整32> 加i3 = 输出.追加("    mov al, byte ptr " + 源槽c);
                    结果<空类型, 整32> 加i4 = 输出.追加("    movsx rax, al");
                } 否则 如果 (源码c == T_整16) {
                    结果<空类型, 整32> 加i5 = 输出.追加("    mov ax, word ptr " + 源槽c);
                    结果<空类型, 整32> 加i6 = 输出.追加("    movsx rax, ax");
                } 否则 如果 (源码c == T_正8) {
                    结果<空类型, 整32> 加i7 = 输出.追加("    mov al, byte ptr " + 源槽c);
                    结果<空类型, 整32> 加i8 = 输出.追加("    movzx rax, al");
                } 否则 如果 (源码c == T_正16) {
                    结果<空类型, 整32> 加i9 = 输出.追加("    mov ax, word ptr " + 源槽c);
                    结果<空类型, 整32> 加i10 = 输出.追加("    movzx rax, ax");
                } 否则 如果 (源码c == T_正32) {
                    结果<空类型, 整32> 加i11 = 输出.追加("    mov eax, dword ptr " + 源槽c);
                } 否则 {
                    结果<空类型, 整32> 加i12 = 输出.追加("    mov rax, qword ptr " + 源槽c);
                }
                如果 (源码c == T_正64) {
                    字符串 标签i = "cvtu_" + 整数转字符串(函数序号) + "_" +
                                 整数转字符串(指令.目标);
                    结果<空类型, 整32> 加u1 = 输出.追加("    test rax, rax");
                    结果<空类型, 整32> 加u2 = 输出.追加("    jns " + 标签i);
                    结果<空类型, 整32> 加u3 = 输出.追加("    mov rcx, rax");
                    结果<空类型, 整32> 加u4 = 输出.追加("    shr rcx, 1");
                    结果<空类型, 整32> 加u5 = 输出.追加("    and eax, 1");
                    结果<空类型, 整32> 加u6 = 输出.追加("    or rcx, rax");
                    结果<空类型, 整32> 加u7 = 输出.追加("    cvtsi2" + 浮后缀i + " xmm0, rcx");
                    结果<空类型, 整32> 加u8 = 输出.追加("    add" + 浮后缀i + " xmm0, xmm0");
                    结果<空类型, 整32> 加u9 = 输出.追加("    mov" + 浮后缀i + " " + 浮宽i + 目标槽c + ", xmm0");
                    结果<空类型, 整32> 加u10 = 输出.追加("    jmp " + 标签i + "_d");
                    结果<空类型, 整32> 加u11 = 输出.追加(标签i + ":");
                    结果<空类型, 整32> 加u12 = 输出.追加("    cvtsi2" + 浮后缀i + " xmm0, rax");
                    结果<空类型, 整32> 加u13 = 输出.追加("    mov" + 浮后缀i + " " + 浮宽i + 目标槽c + ", xmm0");
                    结果<空类型, 整32> 加u14 = 输出.追加(标签i + "_d:");
                } 否则 {
                    结果<空类型, 整32> 加i13 = 输出.追加("    cvtsi2" + 浮后缀i + " xmm0, rax");
                    结果<空类型, 整32> 加i14 = 输出.追加("    mov" + 浮后缀i + " " + 浮宽i + 目标槽c + ", xmm0");
                }
                返回 真;
            }
            如果 (源码c == T_浮64) {
                结果<空类型, 整32> 加t1 = 输出.追加("    movsd xmm0, qword ptr " + 源槽c);
            } 否则 {
                结果<空类型, 整32> 加t2 = 输出.追加("    movss xmm0, dword ptr " + 源槽c);
            }
            字符串 截断指令i = (源码c == T_浮64) ? "cvttsd2si" : "cvttss2si";
            如果 (指令.类型 == T_正32) {
                结果<空类型, 整32> 加t3 = 输出.追加("    " + 截断指令i + " eax, xmm0");
            } 否则 {
                结果<空类型, 整32> 加t4 = 输出.追加("    " + 截断指令i + " rax, xmm0");
            }
            结果<空类型, 整32> 加t5 = 输出.追加("    mov " + 目标槽c + ", rax");
            返回 真;
    }
    返回 假;
}


// 访存组：返回 / 取地址（lea）/ 指针加载（宽度分级 movsx/movzx——②b B5+③第二波）/
//   指针存储（宽度分级——126 段① OOM 根治）。
函数 编码访存Win(IR指令 指令, 整64 最大寄存器, 向量<字符串> 输出) -> 布尔 {
    如果 (指令.操作码 == IR_返回) {
        // 返回：mov rax / xmm0（91-a：类型字段=返回类型码——浮点值返回走 xmm0，
        //   Win x64 浮点返回寄存器；0=无返回值）
        如果 (指令.操作数1 != 0) {
            如果 (指令.类型 == T_浮32) {
                结果<空类型, 整32> 加rf1 = 输出.追加("    movss xmm0, dword ptr " +
                    寄存器槽(指令.操作数1));
            } 否则 如果 (指令.类型 == T_浮64) {
                结果<空类型, 整32> 加rf2 = 输出.追加("    movsd xmm0, qword ptr " +
                    寄存器槽(指令.操作数1));
            } 否则 {
                结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1));
            }
        } 否则 {
            结果<空类型, 整32> 加1 = 输出.追加("    xor rax, rax");
        }
        返回 真;
    }
    如果 (指令.操作码 == IR_取地址) {
        // 取地址：lea 目标, 变量槽（操作数1=槽）
        结果<空类型, 整32> 加1 = 输出.追加("    lea rax, " + 变量槽(指令.操作数1, 最大寄存器));
        结果<空类型, 整32> 加2 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
        返回 真;
    }
    如果 (指令.操作码 == IR_指针加载) {
        // 经指针加载：mov rax, [rax]（操作数1=地址寄存器）
        // 字段宽度（②b B5）：布尔/整8/字符 1 字节、整16 2、整32 4、默认 8——
        //   窄读 + movzx 零扩展（防高位垃圾）；32 位 mov eax 天然零扩展
        结果<空类型, 整32> 加0 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1));
        如果 (指令.类型 == T_字节 || 指令.类型 == T_整8) {
            // 347-a（T33 残余根治）：字符串[i]（A-1）+ **有符号整8**——符号扩展
            结果<空类型, 整32> 加字 = 输出.追加("    movsx rax, byte ptr [rax]");
        } 否则 如果 (指令.类型 == T_布尔 || 指令.类型 == T_字符 || 指令.类型 == T_正8) {
            结果<空类型, 整32> 加布 = 输出.追加("    movzx rax, byte ptr [rax]");
        } 否则 如果 (指令.类型 == T_整16) {
            // 347-a：整16 有符号——符号扩展（原零扩展 → 负值读回错值）
            结果<空类型, 整32> 加16 = 输出.追加("    movsx rax, word ptr [rax]");
        } 否则 如果 (指令.类型 == T_正16) {
            结果<空类型, 整32> 加16u = 输出.追加("    movzx rax, word ptr [rax]");
        } 否则 如果 (指令.类型 == T_整32 || 指令.类型 == T_正32) {
            // T_正32（46-f）：mov eax 清高 32=天然零扩展
            // 266-a 波B：T_整32（有符号）movsxd 符号扩展——负值解引用语义
            如果 (指令.类型 == T_整32) {
                结果<空类型, 整32> 加32s = 输出.追加("    movsxd rax, dword ptr [rax]");
            } 否则 {
                结果<空类型, 整32> 加32u = 输出.追加("    mov eax, [rax]");
            }
        } 否则 {
            结果<空类型, 整32> 加1 = 输出.追加("    mov rax, [rax]");
        }
        结果<空类型, 整32> 加3 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
        返回 真;
    }
    如果 (指令.操作码 == IR_指针存储) {
        // 经指针存储：mov [地址], 值（操作数1=地址寄存器，操作数2=值寄存器）
        // 字段宽度（②b B5）：旧固定 8 字节写越界清零相邻槽（126 段① OOM 根因）
        //   ——按 指令.类型 宽度发射子寄存器；0/默认 8 字节（旧 IR 兼容）
        结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1));
        结果<空类型, 整32> 加2 = 输出.追加("    mov rcx, " + 寄存器槽(指令.操作数2));
        如果 (指令.类型 == T_布尔 || 指令.类型 == T_整8 || 指令.类型 == T_字符 ||
             指令.类型 == T_正8) {
            // 347-a（同族旁路穷尽）：正8 原落默认 8 字节写=过写越界
            结果<空类型, 整32> 加窄8 = 输出.追加("    mov byte ptr [rax], cl");
        } 否则 如果 (指令.类型 == T_整16 || 指令.类型 == T_正16) {
            // 347-a：正16 原落默认 8 字节写=过写越界
            结果<空类型, 整32> 加窄16 = 输出.追加("    mov word ptr [rax], cx");
        } 否则 如果 (指令.类型 == T_整32 || 指令.类型 == T_正32) {
            // T_正32（46-f）：dword 写天然截断（wrapping mod 2^32）
            结果<空类型, 整32> 加窄32 = 输出.追加("    mov dword ptr [rax], ecx");
        } 否则 {
            结果<空类型, 整32> 加3 = 输出.追加("    mov [rax], rcx");
        }
        返回 真;
    }
    返回 假;
}

// 控制流组：字段地址 / 块标签 / 无条件跳转 / 条件跳转（test+jnz/jmp）。
函数 编码控制流Win(IR指令 指令, 整64 函数序号, 向量<字符串> 输出) -> 布尔 {
    如果 (指令.操作码 == IR_字段地址) {
        // 字段地址：lea 目标, [基址+偏移]（操作数1=基址寄存器，附加=偏移字节）
        结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1));
        如果 (指令.附加 != 0) {
            结果<空类型, 整32> 加2 = 输出.追加("    add rax, " + 整数转字符串(指令.附加));
        }
        结果<空类型, 整32> 加3 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
        返回 真;
    }
    如果 (指令.操作码 == IR_标签) {
        // 块标签：bb<函数序号>_<块ID>:（共用层唯一化策略，P6b 控制流）
        结果<空类型, 整32> 加1 = 输出.追加(块标签(函数序号, 指令.附加) + ":");
        返回 真;
    }
    如果 (指令.操作码 == IR_跳转) {
        // 无条件跳转
        结果<空类型, 整32> 加1 = 输出.追加("    jmp " + 块标签(函数序号, 指令.附加));
        返回 真;
    }
    如果 (指令.操作码 == IR_条件跳转) {
        // 条件跳转：mov eax, 条件寄存器；test eax,eax；jnz 真块；jmp 假块
        // 条件寄存器 = 操作数1
        结果<空类型, 整32> 加1 = 输出.追加("    mov eax, " + 寄存器槽(指令.操作数1));
        结果<空类型, 整32> 加2 = 输出.追加("    test eax, eax");
        结果<空类型, 整32> 加3 = 输出.追加("    jnz " + 块标签(函数序号, 指令.操作数2));
        结果<空类型, 整32> 加4 = 输出.追加("    jmp " + 块标签(函数序号, 指令.操作数3));
        返回 真;
    }
    返回 假;
}

// 对象与调用组：分配对象（NewObject）/ 结构体拷贝（rep movsb）/ 删除对象（空安全+
//   析构+释放）/ 调用参数化（参数区模式——影子空间+栈参，retbuf 位0 lea）。
函数 编码对象调用Win(IR指令 指令, 整64 最大寄存器, 整64 槽基数, 整64 retbuf槽数, 整64 函数序号,
                     向量<IR指令>& 实参们, 向量<字符串> 输出) -> 布尔 {
    如果 (指令.操作码 == IR_分配对象) {
        // P7b NewObject：mov rcx,大小 / call __cn_object_new -> 目标寄存器
        //   （对标宿主 x64_codegen_oop.cpp 100-141；容器无虚表——无虚表指针写入）
        结果<空类型, 整32> 加o1 = 输出.追加("    mov rcx, " + 整数转字符串(指令.类型));
        结果<空类型, 整32> 加o2 = 输出.追加("    sub rsp, 32");
        结果<空类型, 整32> 加o3 = 输出.追加("    call __cn_object_new");
        结果<空类型, 整32> 加o4 = 输出.追加("    add rsp, 32");
        结果<空类型, 整32> 加o5 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
        返回 真;
    }
    如果 (指令.操作码 == IR_结构体拷贝) {
        // P7b CopyStruct：rdi=目标地址 rsi=源地址 rcx=字节数；rep movsb
        //   （对标宿主 CopyStruct——v2 生成代码不占用 rdi/rsi，安全）
        结果<空类型, 整32> 加c1 = 输出.追加("    mov rdi, " + 寄存器槽(指令.操作数2));
        结果<空类型, 整32> 加c2 = 输出.追加("    mov rsi, " + 寄存器槽(指令.操作数1));
        结果<空类型, 整32> 加c3 = 输出.追加("    mov rcx, " + 整数转字符串(指令.类型));
        结果<空类型, 整32> 加c4 = 输出.追加("    rep movsb");
        返回 真;
    }
    如果 (指令.操作码 == IR_删除对象) {
        // P7b DeleteObject：空安全（test/je）+ ~类(this) + __cn_object_delete(this)
        //   （对标宿主 x64_codegen_oop.cpp 151-187；目标=标签唯一序号）
        字符串 标签 = 对象删除标签(函数序号, 指令.目标);
        字符串 析构名 = 符号修饰(析构符号(驻留文本(指令.附加)));
        结果<空类型, 整32> 加d1 = 输出.追加("    mov rcx, " + 寄存器槽(指令.操作数1));
        结果<空类型, 整32> 加d2 = 输出.追加("    test rcx, rcx");
        结果<空类型, 整32> 加d3 = 输出.追加("    je " + 标签);
        结果<空类型, 整32> 加d4 = 输出.追加("    sub rsp, 32");
        结果<空类型, 整32> 加d5 = 输出.追加("    call " + 析构名);
        结果<空类型, 整32> 加d6 = 输出.追加("    add rsp, 32");
        结果<空类型, 整32> 加d7 = 输出.追加("    mov rcx, " + 寄存器槽(指令.操作数1));
        结果<空类型, 整32> 加d8 = 输出.追加("    sub rsp, 32");
        结果<空类型, 整32> 加d9 = 输出.追加("    call __cn_object_delete");
        结果<空类型, 整32> 加d10 = 输出.追加("    add rsp, 32");
        结果<空类型, 整32> 加d11 = 输出.追加(标签 + ":");
        返回 真;
    }
    如果 (指令.操作码 == IR_调用参数化) {
        // 调用统一展开（用户裁决项3 参数区）：实参们=前导 IR_调用实参 指令序列
        //   （声明性，由 生成函数 主循环收集传入）。
        // 91-a（2026-09-13 第九十一轮）：Win64 双计数参数分配（共用层
        //   分配参数位置 单点：整型 4 / 浮点 4 独立计数，宿主 emitParamSetup
        //   同构）——整型类 rcx/rdx/r8/r9、浮点类 xmm0-xmm3，各自溢出按声明序
        //   共享栈参数区（[rsp+32+8k] 写入——影子空间 32；被调方
        //   [rbp+48+(栈位号)*8]）。16 对齐（sub/add 32+栈区）。
        整64 总位数 = 指令.操作数1;
        向量<整64> 实参码们 = 向量<整64>();
        整64 码i0 = 0;
        当 (码i0 < 实参们.大小()) {
            结果<空类型, 整32> 加码0 = 实参码们.追加(实参们.元素(码i0).操作数2);
            如果 (!加码0.正常) { 运行时错误(4); }
            码i0++;
        }
        向量<整64> 类们 = 向量<整64>();
        向量<整64> 号们 = 向量<整64>();
        分配参数位置(实参码们, 4, 4, 指令.类型 != 0, 类们, 号们);
        整64 栈游标 = 0;
        整64 栈i0 = 0;
        当 (栈i0 < 类们.大小()) {
            如果 (类们.元素(栈i0) == 2) { 栈游标++; }
            栈i0++;
        }
        整64 栈区 = 栈游标 * 8;
        如果 (栈区 % 16 != 0) { 栈区 = 栈区 + 8; }
        结果<空类型, 整32> 加sub = 输出.追加("    sub rsp, " + 整数转字符串(32 + 栈区));
        // retbuf（位 0）：lea rcx（②b B6：基槽=槽基数+retbuf槽数，序号恒 1 共享
        //   单缓冲——按真实返回字节数定尺寸）
        如果 (指令.类型 != 0) {
            整64 retbuf基槽v = retbuf基槽(槽基数, retbuf槽数);
            结果<空类型, 整32> 加p0 = 输出.追加("    lea rcx, " + 变量槽(retbuf基槽v, 最大寄存器));
        }
        // 220-a（2026-09-16 第两百二十轮，D1 行数整改）：栈/寄存器实参装载迁
        //   编码Win实参装载；返回装载+111-a 高位规范化迁 编码Win返回装载。
        编码Win实参装载(实参们, 类们, 号们, 输出);
        字符串 被调名c = 符号修饰(驻留文本(指令.附加));
        结果<空类型, 整32> 加s2c = 输出.追加("    call " + 被调名c);
        结果<空类型, 整32> 加add = 输出.追加("    add rsp, " + 整数转字符串(32 + 栈区));
        编码Win返回装载(指令, 输出);
        返回 真;
    }
    返回 假;
}


// 220-a：族①a Win 实参装载——栈实参先装载（rax/xmm0 中转，[rsp+32+8k] 写入；
//   110-a 浮64 qword ptr）+寄存器实参（整型 rcx/rdx/r8/r9 / 浮点 xmm0-xmm3 分派）。
函数 编码Win实参装载(向量<IR指令>& 实参们, 向量<整64>& 类们, 向量<整64>& 号们, 向量<字符串> 输出) -> 空类型 {
        // 栈实参先装载（rax/xmm0 中转，sub rsp 之后 [rsp+32+8k] 写入）
        整64 a = 0;
        当 (a < 实参们.大小()) {
            IR指令 实参 = 实参们.元素(a);
            如果 (类们.元素(a) == 2) {
                字符串 偏移a = 整数转字符串(32 + 号们.元素(a) * 8);
                如果 (实参.操作数2 == T_浮32 || 实参.操作数2 == T_浮64) {
                    字符串 后a = (实参.操作数2 == T_浮64) ? "sd" : "ss";
                    // 110-a：浮64 须 qword ptr（109-a 调用方装载段漏点；A2070）。
                    字符串 宽a = (实参.操作数2 == T_浮64) ? "qword ptr " : "dword ptr ";
                    结果<空类型, 整32> 加sa1 = 输出.追加("    mov" + 后a + " xmm0, " +
                        宽a + 寄存器槽(实参.操作数1));
                    结果<空类型, 整32> 加sa2 = 输出.追加("    mov" + 后a + " " +
                        宽a + "[rsp+" + 偏移a + "], xmm0");
                } 否则 {
                    结果<空类型, 整32> 加t1 = 输出.追加("    mov rax, " +
                        寄存器槽(实参.操作数1));
                    结果<空类型, 整32> 加t2 = 输出.追加("    mov [rsp+" + 偏移a + "], rax");
                }
            }
            a++;
        }
        // 寄存器实参（整型类 rcx/rdx/r8/r9 / 浮点类 xmm0-xmm3——分配表分派）
        整64 b = 0;
        当 (b < 实参们.大小()) {
            IR指令 实参2 = 实参们.元素(b);
            整64 类b = 类们.元素(b);
            如果 (类b == 0) {
                结果<空类型, 整32> 加r = 输出.追加("    mov " + 参数寄存器名(号们.元素(b)) +
                    ", " + 寄存器槽(实参2.操作数1));
            } 否则 如果 (类b == 1) {
                字符串 后b = (实参2.操作数2 == T_浮64) ? "sd" : "ss";
                // 110-a：浮64 须 qword ptr（109-a 调用方装载段漏点；A2070）。
                字符串 宽b = (实参2.操作数2 == T_浮64) ? "qword ptr " : "dword ptr ";
                结果<空类型, 整32> 加rb = 输出.追加("    mov" + 后b + " xmm" +
                    整数转字符串(号们.元素(b)) + ", " + 宽b + 寄存器槽(实参2.操作数1));
            }
            b++;
        }
}

// 220-a：族①b Win 返回装载——浮点返回码 xmm0 / 其余 rax；111-a ≤32 位返回类型
//   高位规范化（布尔 movzx/整32 movsxd 符号扩展/正32 mov eax 零扩展——对齐
//   Rust/LLVM signext/zeroext 语义，三后端同治）。
函数 编码Win返回装载(IR指令 指令, 向量<字符串> 输出) -> 空类型 {
        如果 (指令.目标 != 0) {
            // 返回装载：浮点返回码（IR_调用参数化.操作数2）-> xmm0；其余 -> rax
            如果 (指令.操作数2 == T_浮32) {
                结果<空类型, 整32> 加rv1 = 输出.追加("    movss dword ptr " +
                    寄存器槽(指令.目标) + ", xmm0");
            } 否则 如果 (指令.操作数2 == T_浮64) {
                结果<空类型, 整32> 加rv2 = 输出.追加("    movsd qword ptr " +
                    寄存器槽(指令.目标) + ", xmm0");
            } 否则 {
                // 111-a：≤32 位返回类型高位规范化（x64 ABI 只保证窄返回值低位有效——
                //   高位未定义；宿主 win 后端已按 widthFor 装载但第三方/未来 cl.exe
                //   运行时 obj 仍不可信）。**低 32 位是权威值**，扩展方式须与 v2
                //   内部表示一致：整32=有符号（类型转换生成 movsxd 符号扩展——零扩展
                //   会把 -1 变成 4294967295 破坏语义，锚定链实证退化）；正32=零扩展；
                //   布尔=0/1 零扩展。各 1 条指令（寄存器重命名零延迟，性能代价≈0）。
                //   对齐 Rust/LLVM signext/zeroext 语义——三后端同治。
                整64 返回码n = 指令.操作数2;
                如果 (返回码n == T_布尔) {
                    结果<空类型, 整32> 加rw0 = 输出.追加("    movzx eax, al");
                }
                如果 (返回码n == T_整32) {
                    结果<空类型, 整32> 加rw1 = 输出.追加("    movsxd rax, eax");
                }
                如果 (返回码n == T_正32) {
                    结果<空类型, 整32> 加rw2 = 输出.追加("    mov eax, eax");
                }
                结果<空类型, 整32> 加s4c = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
            }
        }
}


// 静态组：静态槽读/地址/写（.data _cn_gstatic_N）。
函数 编码静态Win(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    如果 (指令.操作码 == IR_静态加载) {
        // ②c C：静态槽读（.data _cn_gstatic_N）——mov rax, qword ptr 标签
        结果<空类型, 整32> 加静1 = 输出.追加("    mov rax, qword ptr " + 静态槽标签(指令.附加));
        结果<空类型, 整32> 加静2 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
        返回 真;
    }
    如果 (指令.操作码 == IR_静态地址) {
        // 静态槽地址（.data 槽标签地址）——拷贝构造源 T& 传静态容器左值地址
        结果<空类型, 整32> 加静址1 = 输出.追加("    lea rax, qword ptr " + 静态槽标签(指令.附加));
        结果<空类型, 整32> 加静址2 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
        返回 真;
    }
    如果 (指令.操作码 == IR_静态存储) {
        // ②c C：静态槽写（操作数1=值寄存器）——mov qword ptr 标签, rcx
        结果<空类型, 整32> 加静3 = 输出.追加("    mov rcx, " + 寄存器槽(指令.操作数1));
        结果<空类型, 整32> 加静4 = 输出.追加("    mov qword ptr " + 静态槽标签(指令.附加) + ", rcx");
        返回 真;
    }
    返回 假;
}


// ==================== 函数生成 ====================
// 生成单函数的完整 asm：PROC / prologue / 参数装载 / 指令 / epilogue。
// 帧大小 = (最大寄存器 + 最大槽) * 8，对齐 16。
函数 生成函数(函数IR 函数信息, 整64 函数序号, 向量<字符串> 输出) -> 空类型 {
    整64 最大寄存器 = 0;
    整64 最大槽 = 0;
    整64 槽基数 = 0;
    扫描函数(函数信息, &最大寄存器, &最大槽, &槽基数);
    整64 retbuf槽数 = retbuf槽位数(函数信息);    // ②b B6：与 扫描函数 同一决策
    整64 帧大小 = 计算帧大小(最大寄存器, 最大槽);
    // D37（325-a·波次7）：大帧栈探测——Windows guard 页机制下 `sub rsp, N`
    //   （N>4KB）一次性越过未提交页→0xC0000005；MSVC 惯例三段式 call __chkstk
    //   按 4KB 页探测（契约：只 touch 页·**不改 rsp**·返回后 rax 保持——随后
    //   自行 sub rsp, rax）。__chkstk 破坏 rcx/rdx/r8/r9 → 整型参数寄存器须在
    //   入口预存调用方影子空间（[rsp+8..+40]·Win64 ABI 已提交归被调方使用·
    //   调用侧 v2 已分配 32 字节），chkstk 完成后从 [rbp+16..+40] 读回。
    //   浮点 xmm0-3 不在 volatile 集合（直读保持）。宿主 x64_codegen 蓝本同源。
    布尔 大帧 = 帧大小 > 4096;
    布尔 返回结构体 = 函数信息.返回结构体ID != 0 || 函数信息.返回结果名ID != 0;   // 71-a：结果/可选 返回同款 retbuf ABI
    布尔 用影子参 = 大帧 && (函数信息.参数槽序们.大小() > 0 || 返回结构体);
    // PROC 头（中文符号经 nameMangle 修饰为 ASCII，MASM 可汇编）
    字符串 函数名 = 符号修饰(驻留文本(整64(函数信息.名字)));
    结果<空类型, 整32> 加1 = 输出.追加(函数名 + " PROC");
    如果 (用影子参) {
        // 大帧整型参数寄存器预存影子空间（须在 push rbp 前——入口 [rsp+8..+40]）
        结果<空类型, 整32> 加sp1 = 输出.追加("    mov [rsp+8], rcx");
        结果<空类型, 整32> 加sp2 = 输出.追加("    mov [rsp+16], rdx");
        结果<空类型, 整32> 加sp3 = 输出.追加("    mov [rsp+24], r8");
        结果<空类型, 整32> 加sp4 = 输出.追加("    mov [rsp+32], r9");
    }
    结果<空类型, 整32> 加2 = 输出.追加("    push rbp");
    结果<空类型, 整32> 加3 = 输出.追加("    mov rbp, rsp");
    如果 (大帧) {
        结果<空类型, 整32> 加4a = 输出.追加("    mov rax, " + 整数转字符串(帧大小));
        结果<空类型, 整32> 加4b = 输出.追加("    call __chkstk");
        结果<空类型, 整32> 加4c = 输出.追加("    sub rsp, rax");
    } 否则 {
        结果<空类型, 整32> 加4 = 输出.追加("    sub rsp, " + 整数转字符串(帧大小));
    }
    // Win x64 参数装载（②b B8 按声明序：参数槽序们/参数拷贝字节们）——标量：
    //   槽 1.. 从 rcx/rdx/r8/r9；参数 5+ 栈参区 [rbp+48+(位-4)*8]（rbp 锚定）。
    //   结构体按值：入参为指针（B3 调用方约定）-> rsi 取指针、lea rdi 目标基槽，
    //   rep movsb 拷贝真实字节入槽（IR_结构体拷贝 同款；按声明序处理，先存的
    //   参数值不受 rep movsb 清 rcx 影响——结构体指针先移走再 rep）
    生成函数参数装载(函数信息, 最大寄存器, 用影子参, 返回结构体, 输出);
    // 指令（IR_调用实参 为声明性指令：此处收集，IR_调用参数化 统一展开装载）
    向量<IR指令> 调用实参们 = 向量<IR指令>();
    整64 i = 0;
    当 (i < 函数信息.指令.大小()) {
        IR指令 指令 = 函数信息.指令.元素(i);
        如果 (指令.操作码 == IR_调用实参) {
            结果<空类型, 整32> 加实 = 调用实参们.追加(指令);
            如果 (!加实.正常) { 运行时错误(4); }
        } 否则 {
            生成指令(指令, 最大寄存器, 槽基数, retbuf槽数, 函数序号, 调用实参们, 输出);
            如果 (指令.操作码 == IR_调用参数化) {
                调用实参们.清空();
            }
        }
        i++;
    }
    // epilogue：返回 指令 已 mov rax；此处统一 ret
    结果<空类型, 整32> 加6 = 输出.追加("    mov rsp, rbp");
    结果<空类型, 整32> 加7 = 输出.追加("    pop rbp");
    结果<空类型, 整32> 加8 = 输出.追加("    ret");
    结果<空类型, 整32> 加9 = 输出.追加(函数名 + " ENDP");
    结果<空类型, 整32> 加10 = 输出.追加("");
}

// 564-a（D1 滚动）：Win64 参数装载（原 生成函数 内联块整块迁移·逻辑逐字迁移
//   注释逐字保留·纯机械零行为变更）——retbuf 槽 + 双计数参数装载循环。
函数 生成函数参数装载(函数IR 函数信息, 整64 最大寄存器, 布尔 用影子参,
                      布尔 返回结构体, 向量<字符串> 输出) -> 空类型 {
    // 用户函数返回结构体（2026-09-04，E2E 148）：位 0（rcx）=调用方传入的
    //   retbuf 指针——存槽 1（生成函数 已保留）；声明参数位号整体 +1。
    如果 (返回结构体) {
        如果 (用影子参) {
            // D37：大帧 retbuf 指针改从影子空间读（rcx 已被 __chkstk 破坏）
            结果<空类型, 整32> 加ret0 = 输出.追加("    mov rax, [rbp+16]");
            结果<空类型, 整32> 加ret1 = 输出.追加("    mov " + 变量槽(1, 最大寄存器) + ", rax");
        } 否则 {
            结果<空类型, 整32> 加ret0 = 输出.追加("    mov " + 变量槽(1, 最大寄存器) + ", rcx");
        }
    }
    // 91-a（2026-09-13 第九十一轮）：Win64 双计数参数装载（共用层 分配参数位置
    //   单点）——整型类 rcx/rdx/r8/r9（4）；浮点类 xmm0-xmm3（4，独立计数）；
    //   各自溢出按声明序共享栈参区 [rbp+48+栈位号*8]。浮点参数直存
    //   movsd/movss（浮32 显式 dword ptr）。结构体按值：入参为指针 ->
    //   rsi 取指针、lea rdi 目标基槽、rep movsb（IR_结构体拷贝 同款——
    //   rep 破坏 rcx 但结构体指针已先移走，且 win 参数寄存器不含 rsi/rdi）。
    向量<整64> 类们p = 向量<整64>();
    向量<整64> 号们p = 向量<整64>();
    分配参数位置(函数信息.参数类型们, 4, 4, 返回结构体, 类们p, 号们p);
    整64 参数序 = 0;
    当 (参数序 < 函数信息.参数槽序们.大小()) {
        整64 参数槽 = 函数信息.参数槽序们.元素(参数序);
        整64 拷贝字节 = 函数信息.参数拷贝字节们.元素(参数序);
        整64 类p = 0;
        整64 号p = 0;
        如果 (参数序 < 类们p.大小()) {
            类p = 类们p.元素(参数序);
            号p = 号们p.元素(参数序);
        }
        整64 参类p = 0;
        如果 (参数序 < 函数信息.参数类型们.大小()) {
            参类p = 函数信息.参数类型们.元素(参数序);
        }
        如果 (类p == 1) {
            字符串 后p = (参类p == T_浮64) ? "sd" : "ss";
            // 109-a：浮64 槽须 qword ptr（缺 → A2070；91-a 增浮点分派同批漏点）。
            字符串 宽p1 = (参类p == T_浮64) ? "qword ptr " : "dword ptr ";
            结果<空类型, 整32> 加fp = 输出.追加("    mov" + 后p + " " + 宽p1 +
                变量槽(参数槽, 最大寄存器) + ", xmm" + 整数转字符串(号p));
        } 否则 如果 (类p == 2) {
            如果 (拷贝字节 > 0) {
                // 110-a（2026-09-13 家机 win-x64）：结构体按值栈参数（B3 约定=
                //   指针传入）——从栈位取源指针 + rep movsb 拷贝入槽（寄存器路径
                //   同款）。原实现落下方标量路径只存 8 字节指针 → 被调方按内联
                //   数据访问 → E2E 158_v2 分歧面③（六点和）rc=14。
                结果<空类型, 整32> 加pc1 = 输出.追加("    mov rsi, [rbp+" +
                    整数转字符串(48 + 号p * 8) + "]");
                结果<空类型, 整32> 加pc2 = 输出.追加("    lea rdi, " +
                    变量槽(参数槽, 最大寄存器));
                结果<空类型, 整32> 加pc3 = 输出.追加("    mov rcx, " +
                    整数转字符串(拷贝字节));
                结果<空类型, 整32> 加pc4 = 输出.追加("    rep movsb");
            } 否则 如果 (参类p == T_浮32 || 参类p == T_浮64) {
                字符串 后p = (参类p == T_浮64) ? "sd" : "ss";
                字符串 宽p = (参类p == T_浮64) ? "qword ptr " : "dword ptr ";
                结果<空类型, 整32> 加sp1 = 输出.追加("    mov" + 后p + " xmm0, " +
                    宽p + "[rbp+" + 整数转字符串(48 + 号p * 8) + "]");
                结果<空类型, 整32> 加sp2 = 输出.追加("    mov" + 后p + " " +
                    宽p + 变量槽(参数槽, 最大寄存器) + ", xmm0");
            } 否则 {
                结果<空类型, 整32> 加sp3 = 输出.追加("    mov rax, [rbp+" +
                    整数转字符串(48 + 号p * 8) + "]");
                结果<空类型, 整32> 加sp4 = 输出.追加("    mov " + 变量槽(参数槽, 最大寄存器) + ", rax");
            }
        } 否则 如果 (拷贝字节 == 0) {
            如果 (用影子参) {
                // D37：大帧整型参数改从影子空间读（[rbp+16+位*8]·rcx/rdx/r8/r9 已存）
                结果<空类型, 整32> 加参s1 = 输出.追加("    mov r10, [rbp+" +
                    整数转字符串(16 + 号p * 8) + "]");
                结果<空类型, 整32> 加参 = 输出.追加("    mov " +
                    变量槽(参数槽, 最大寄存器) + ", r10");
            } 否则 {
                结果<空类型, 整32> 加参 = 输出.追加("    mov " + 变量槽(参数槽, 最大寄存器) +
                    ", " + 参数寄存器名(号p));
            }
        } 否则 {
            如果 (用影子参) {
                结果<空类型, 整32> 加源s = 输出.追加("    mov rsi, [rbp+" +
                    整数转字符串(16 + 号p * 8) + "]");
            } 否则 {
                结果<空类型, 整32> 加源 = 输出.追加("    mov rsi, " + 参数寄存器名(号p));
            }
            结果<空类型, 整32> 加目 = 输出.追加("    lea rdi, " + 变量槽(参数槽, 最大寄存器));
            结果<空类型, 整32> 加数 = 输出.追加("    mov rcx, " + 整数转字符串(拷贝字节));
            结果<空类型, 整32> 加rep = 输出.追加("    rep movsb");
        }
        参数序++;
    }
}

// ==================== 程序入口 ====================
// 程序IR -> asm 行列表（每个函数一个 PROC）。
// P7b：末尾补 EXTERN 声明——扫描 call 行提取被调符号，非本 asm PROC 定义者
//   （运行时 __cn_* / 宿主 obj 的容器方法）声明 EXTERN（宿主 codegen 同款；
//   无 EXTERN 则 ml64 A2006 undefined symbol——P7b 冒烟实测踩坑）。
函数 代码生成(程序IR 程序) -> 向量<字符串> {
    向量<字符串> 输出 = 向量<字符串>();
    结果<空类型, 整32> 头1 = 输出.追加("; 由 v2 代码生成（P6）生成");
    结果<空类型, 整32> 段 = 输出.追加(".code");
    整64 f = 0;
    当 (f < 程序.函数们.大小()) {
        生成函数(程序.函数们.元素(f), f, 输出);
        f++;
    }
    // ---- P7b EXTERN 收集 ----
    // 223-a（2026-09-16 第两百二十三轮，D1 行数整改）：后处理四段迁族——
    //   收集EXTERN符号/发射字符串常量数据/发射浮点常量数据/发射静态槽数据段。
    收集EXTERN符号(程序, 输出);
    发射字符串常量数据(程序, 输出);
    发射浮点常量数据(程序, 输出);
    发射静态槽数据段(程序, 输出);
    结果<空类型, 整32> 尾 = 输出.追加("END");
    返回 输出;
}

// 223-a：族① EXTERN 收集——本 asm PROC 定义集 + call 行被调符号（非本地且未
//   登记 -> 追加 EXTERN 行）。
函数 收集EXTERN符号(程序IR 程序, 向量<字符串> 输出) -> 空类型 {
    // 本 asm PROC 定义集（行尾 " PROC"）
    映射<整64, 整64> 本地符号 = 映射<整64, 整64>();
    整64 i = 0;
    当 (i < 输出.大小()) {
        字符串 行 = 输出.元素(i);
        如果 (字符串长度(行) > 5 &&
             字符串比较(字符串子串(行, 字符串长度(行) - 5, 5), " PROC")) {
            结果<空类型, 整32> 加本 = 本地符号.设置(驻留(字符串子串(行, 0, 字符串长度(行) - 5)), 1);
            如果 (!加本.正常) { 运行时错误(4); }
        }
        i++;
    }
    // 501-a（T69 lea 行 EXTERN 收集口径修正）：本单元**数据标签**预登记——
    //   字符串/浮点常量池与静态槽由本 asm 自己发射（发射字符串常量数据/
    //   发射浮点常量数据/发射静态槽数据段），但发射时机在本收集之后，故须
    //   由 IR 侧先行登记：否则 编码数据移动Win 的 `lea rax, strData_<ID>` /
    //   `lea rax, floatData_<ID>` 被误判为跨单元引用 → 既发 EXTERN 又发本地
    //   db/REAL8 定义 → ml64 `A2005 symbol redefinition`（win 侧 174 例 v2
    //   用例实测；GAS 双后端不发 EXTERN 故 linux 绿=跨平台分叉根因）。
    登记本地数据标签(程序, 本地符号);
    // call 行（前缀 "    call "）的被调符号——非本地且未登记 -> EXTERN
    映射<整64, 整64> 已外部 = 映射<整64, 整64>();
    i = 0;
    当 (i < 输出.大小()) {
        字符串 行2 = 输出.元素(i);
        如果 (字符串长度(行2) > 9 &&
             字符串比较(字符串子串(行2, 0, 9), "    call ")) {
            字符串 符号 = 字符串子串(行2, 9, 字符串长度(行2) - 9);
            // 518-b（家机 501 回签残余·真红 7 例根因）：**call 行被调=寄存器**形态
            //   （T69 间接调用 `call r11`）——须走 是裸符号操作数 同款判据（寄存器
            //   形态 → 非符号 → 不收 EXTERN）；原此路径未经该判据 → 产物
            //   `EXTERN r11:PROC` → ml64 A2008（七例实证）。
            如果 (是裸符号操作数(符号)) {
            整64 符号ID = 驻留(符号);
            结果<整64, 整32> 查本地 = 本地符号.获取(符号ID);
            结果<整64, 整32> 查外部 = 已外部.获取(符号ID);
            如果 (!查本地.正常 && !查外部.正常) {
                结果<空类型, 整32> 加外 = 已外部.设置(符号ID, 1);
                如果 (!加外.正常) { 运行时错误(4); }
                结果<空类型, 整32> 加行 = 输出.追加("EXTERN " + 符号 + ":PROC");
                如果 (!加行.正常) { 运行时错误(4); }
            }
            }
        }
        i++;
    }
    // T69（480-a）：函数地址 lea 行（前缀 "    lea rax, "）的裸符号——跨模块/
    //   运行时函数取地址须 EXTERN。501-a 收窄：仅**裸符号操作数**参与（内存
    //   操作数 `[rbp-N]`＝编码访存Win IR_取地址形态、尺寸限定 `qword/dword ptr`
    //   ＝静态槽地址形态均非符号引用——前者曾产出 `EXTERN [rbp-16]:PROC` 语法
    //   垃圾、后者曾产出静态槽自言自语的 EXTERN）。
    i = 0;
    当 (i < 输出.大小()) {
        字符串 行3 = 输出.元素(i);
        如果 (字符串长度(行3) > 13 &&
             字符串比较(字符串子串(行3, 0, 13), "    lea rax, ")) {
            字符串 符号3 = 字符串子串(行3, 13, 字符串长度(行3) - 13);
            如果 (是裸符号操作数(符号3)) {
                整64 符号ID3 = 驻留(符号3);
                结果<整64, 整32> 查本地3 = 本地符号.获取(符号ID3);
                结果<整64, 整32> 查外部3 = 已外部.获取(符号ID3);
                如果 (!查本地3.正常 && !查外部3.正常) {
                    结果<空类型, 整32> 加外3 = 已外部.设置(符号ID3, 1);
                    如果 (!加外3.正常) { 运行时错误(4); }
                    结果<空类型, 整32> 加行3 = 输出.追加("EXTERN " + 符号3 + ":PROC");
                    如果 (!加行3.正常) { 运行时错误(4); }
                }
            }
        }
        i++;
    }
}

// 501-a：lea 操作数是否**裸符号**——符号名在本 asm 命名空间内不含空白（尺寸
//   限定 `qword ptr X` 含空白）也不含 `[`（内存操作数 `[rbp-N]`）。只有裸符号
//   才可能是跨单元引用；其余形态一律不参与 EXTERN 收集（防语法垃圾行）。
函数 是裸符号操作数(字符串 操作数) -> 布尔 {
    整64 长 = 字符串长度(操作数);
    如果 (长 == 0) { 返回 假; }
    如果 ((整64(操作数[0]) & 255) == 91) { 返回 假; }
    整64 i = 0;
    当 (i < 长) {
        整64 字节 = 整64(操作数[i]) & 255;
        如果 (字节 == 32 || 字节 == 9) { 返回 假; }
        i++;
    }
    // 518-b（家机 501 回签残余·真红 7 例）：**寄存器操作数排除**——T69 间接调用
    //   `mov r11,[rbp-N]` + `call r11` 中 `call r11` 的被调是**寄存器**（非符号），
    //   原判据（无空白/非 `[`）放行 → 产物尾部 `EXTERN r11:PROC` → ml64 A2008
    //   syntax error（03_function/09_integration/318/40_generic_funptr/487/489/99
    //   七例实证）。Rust 对照=Operand::Reg/Sym **类型化分派**：文本层补同义判据。
    //   判定（免字符串等值比较——CN 字符串不支持 ==）：长度 2~4 ∧ 首字符 ∈ {r,e}
    //   ∧ 全字符 ∈ [a-z0-9] ⇒ 寄存器形态（rax/r11d/eax/xmm 不匹配因 x 非 r/e）。
    如果 (长 >= 2 && 长 <= 4) {
        整64 首字节 = 整64(操作数[0]) & 255;
        如果 (首字节 == 114 || 首字节 == 101) {
            布尔 全合 = 真;
            整64 ci = 1;
            当 (ci < 长) {
                整64 c = 整64(操作数[ci]) & 255;
                布尔 数字或小写 = (c >= 48 && c <= 57) || (c >= 97 && c <= 122);
                如果 (!数字或小写) { 全合 = 假; 中断; }
                ci++;
            }
            如果 (全合) { 返回 假; }
        }
    }
    返回 真;
}

// 501-a：本单元数据标签预登记（本地符号集补充）——字符串/浮点常量池与静态槽
//   标签由本 asm 发射（发射字符串常量数据/发射浮点常量数据/发射静态槽数据段），
//   但发射时机在 EXTERN 收集之后，故须由 IR 侧先行登记，否则被误判为外部符号
//   （win ml64 A2005 符号重定义·174 例实测）。
函数 登记本地数据标签(程序IR 程序, 映射<整64, 整64>& 本地符号) -> 空类型 {
    向量<整64> 串ID们 = 收集字符串常量(程序);
    整64 i = 0;
    当 (i < 串ID们.大小()) {
        结果<空类型, 整32> 加串 = 本地符号.设置(
            驻留("strData_" + 整数转字符串(串ID们.元素(i))), 1);
        如果 (!加串.正常) { 运行时错误(4); }
        i++;
    }
    向量<整64> 浮ID们 = 收集浮点常量(程序);
    i = 0;
    当 (i < 浮ID们.大小()) {
        结果<空类型, 整32> 加浮 = 本地符号.设置(
            驻留("floatData_" + 整数转字符串(浮ID们.元素(i))), 1);
        如果 (!加浮.正常) { 运行时错误(4); }
        i++;
    }
    i = 0;
    当 (i < 程序.静态数) {
        结果<空类型, 整32> 加静 = 本地符号.设置(驻留(静态槽标签(i)), 1);
        如果 (!加静.正常) { 运行时错误(4); }
        i++;
    }
}

// 223-a：族② 字符串常量数据发射——共用层 收集字符串常量（去重）+MASM db 48 值
//   分段续行（A2042 上限·129 用例实测）+行尾悬挂逗号剥离。
函数 发射字符串常量数据(程序IR 程序, 向量<字符串> 输出) -> 空类型 {
    // P7b：字符串常量数据行——共用层 收集字符串常量（去重，首次出现顺序），
    //   在函数区之后发射 .code 段内数据定义（strData_<文本ID> db 字节...,0）。
    //   注意不可把行指针从别的向量搬进 输出（向量<字符串> 元素为拥有式——
    //   源向量 RAII 析构会释放字符串，浅拷贝指针悬垂 -> asm 乱码，实测踩坑）。
    //   ③ 第三波（缺陷⑤）：MASM db 单语句操作数上限 48（49+ A2042 statement
    //   too complex，隔离二分实测；129 用例 53 字节中文字面量首踩——GAS 侧
    //   .byte 无此限制故单位机未测出）——超长字面量按 48 值分段续行 db。
    向量<整64> 常量ID们 = 收集字符串常量(程序);
    整64 s = 0;
    当 (s < 常量ID们.大小()) {
        字符串 文本 = 字符串复制(驻留文本(常量ID们.元素(s)));
        字符串 数据行 = "strData_" + 整数转字符串(常量ID们.元素(s)) + " db";
        整64 段内数 = 0;
        整64 b = 0;
        当 (b < 字符串长度(文本)) {
            整64 字节 = 整64(文本[b]) & 255;
            数据行 = 数据行 + " " + 整数转字符串(字节) + ",";
            段内数++;
            如果 (段内数 == 48) {
                // 满段先发（续行 db 接续同一段数据定义，实测合法）——行尾
                //   逗号须剥离：悬挂逗号=不完整操作数（A2042，隔离实测铁证）
                结果<空类型, 整32> 加段行 = 输出.追加(
                    字符串子串(数据行, 0, 字符串长度(数据行) - 1));
                如果 (!加段行.正常) { 运行时错误(4); }
                数据行 = "    db";
                段内数 = 0;
            }
            b++;
        }
        结果<空类型, 整32> 加数行 = 输出.追加(数据行 + " 0");
        如果 (!加数行.正常) { 运行时错误(4); }
        s++;
    }
}

// 223-a：族③ 浮点常量数据发射（89-a）——floatData_<文本ID> REAL8 <净文本>
//   （ALIGN 8 保证 8 字节装载——win 侧实物验证=跨机轮）。
函数 发射浮点常量数据(程序IR 程序, 向量<字符串> 输出) -> 空类型 {
    // 浮点常量数据行（89-a）：floatData_<文本ID> REAL8 <净文本>（MASM 浮点数据
    //   定义；ALIGN 8 保证 8 字节装载——win 侧实物验证=跨机轮）
    向量<整64> 浮点ID们w = 收集浮点常量(程序);
    整64 fdw = 0;
    当 (fdw < 浮点ID们w.大小()) {
        结果<空类型, 整32> 加浮对 = 输出.追加("ALIGN 8");
        如果 (!加浮对.正常) { 运行时错误(4); }
        结果<空类型, 整32> 加浮行 = 输出.追加(
            "floatData_" + 整数转字符串(浮点ID们w.元素(fdw)) + " REAL8 " +
            浮点文本净(浮点ID们w.元素(fdw)));
        如果 (!加浮行.正常) { 运行时错误(4); }
        fdw++;
    }
}

// 223-a：族④ 静态槽数据段（②c C）——.data 可写+87-a 静态槽 8 对齐+结构体静态槽
//   按类型尺寸多槽分配（原恒 dq 8 字节越界写相邻符号·87-a 根治）。
函数 发射静态槽数据段(程序IR 程序, 向量<字符串> 输出) -> 空类型 {
    // ②c C：静态槽数据段（.data 可写——入口构造写指针/运行期写回；标量静态
    //   直存折叠初始值文本，容器静态 0（入口 NewObject+构造注入指针））
    如果 (程序.静态数 > 0) {
        结果<空类型, 整32> 静段 = 输出.追加(".data");
        如果 (!静段.正常) { 运行时错误(4); }
        // 87-a：静态槽 8 对齐（字符串常量池 db 长度任意）
        结果<空类型, 整32> 静对 = 输出.追加("ALIGN 8");
        如果 (!静对.正常) { 运行时错误(4); }
        整64 g = 0;
        当 (g < 程序.静态数) {
            字符串 初始值 = "0";
            如果 (g < 程序.静态初始值们.大小()) {
                初始值 = 字符串复制(驻留文本(程序.静态初始值们.元素(g)));
            }
            // 87-a（2026-09-12 第八十七轮）：结构体静态槽按类型尺寸分配（原恒
            //   `dq 初始值`=8 字节 → 整体拷贝 16/24… 字节越界写相邻 .data 符号；
            //   读取第二字段落到他人数据）。8 字节取整保证后续槽对齐不变式。
            整64 静大小w = 查结构体大小(取静态类型(g));
            // T46（467-a 宿主对齐·701-a）：128 位标量静态槽**双 quad** 发射——
            //   原走单槽 `dq 初始值` 分支，128 位字面量超 64 位容量 → ml64
            //   A2071（initializer magnitude too large）。低 64 位在前（与双槽
            //   内存布局同序）；解析失败/超界 = 零双槽 + asm 注释披露（禁静默）。
            字符串 静类型文本 = 字符串复制(驻留文本(取静态类型(g)));
            如果 (字符串比较(静类型文本, "整128") || 字符串比较(静类型文本, "正128")) {
                整64 静低128 = 0;
                整64 静高128 = 0;
                如果 (解析128位初值文本(初始值, 静低128, 静高128)) {
                    // MASM 十六进制=后缀形态（`0x` 前缀报 A2206 missing operator）：
                    //   前导 0 保证数字开头 + 16 位补零 hex + h 后缀
                    结果<空类型, 整32> 静槽128 = 输出.追加(
                        静态槽标签(g) + " dq 0" + 位模式十六进制(静低128) +
                        "h, 0" + 位模式十六进制(静高128) + "h");
                    如果 (!静槽128.正常) { 运行时错误(4); }
                } 否则 {
                    结果<空类型, 整32> 静槽零128 = 输出.追加(
                        静态槽标签(g) + " dq 0, 0    ; 128 位初值非法或超范围: " + 初始值);
                    如果 (!静槽零128.正常) { 运行时错误(4); }
                }
            } 否则 如果 (静大小w > 8) {
                整64 静槽数w = (静大小w + 7) / 8;
                字符串 静行w = " dq 0";
                整64 静填w = 1;
                当 (静填w < 静槽数w) {
                    静行w = 静行w + ", 0";
                    静填w++;
                }
                结果<空类型, 整32> 静槽w = 输出.追加(静态槽标签(g) + 静行w);
                如果 (!静槽w.正常) { 运行时错误(4); }
            } 否则 {
                结果<空类型, 整32> 静槽 = 输出.追加(静态槽标签(g) + " dq " + 初始值);
                如果 (!静槽.正常) { 运行时错误(4); }
            }
            g++;
        }
    }
}

