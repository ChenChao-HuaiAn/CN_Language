// CN 自举编译器 v2：结构化代码生成器——win-x64 MASM 后端（自举重建 P6，2026-08-25）
// 后端架构方案1（用户裁决 2026-09-02）：本文件只保留"平台发射"——助记符/寄存器名/
//   MASM 符号修饰/段指令；帧扫描、槽偏移、调用编址、标签唯一化、字符串收集等
//   平台无关决策统一在 代码生成共用.cn（双后端单点维护，第三平台只需纯发射器）。
// 平台发射约定：
//   - 虚拟寄存器 r -> [rbp-8r-8]；变量槽 s -> [rbp-8*(最大寄存器+s)-8]；
//   - 函数框架：PROC 名 PROC / push rbp / mov rbp,rsp / sub rsp,帧大小 /
//     指令 / mov rsp,rbp / pop rbp / ret / 名 ENDP；
//   - Win x64 参数装载：前 4 参数 rcx/rdx/r8/r9 -> 参数槽；标量返回 rax；
//     位<4 走 rcx/rdx/r8/r9、影子空间 32、被调方 [rbp+48+(位-4)*8]。
公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）


导入 容器::向量;
导入 IR;           // IR 指令/容器判定/操作码（原 IR生成+IR容器+IR常量 合并目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 代码生成;     // 后端共用决策层（原 代码生成共用；同包包名幂等加载）

公开:


// ==================== 指令编码函数组（R4，2026-09-08 自 生成指令 机械搬移） ====================
// 每函数收同款上下文返回 布尔=该操作码是否由本组处理（真=已发射）。

// 数据移动组：常量整数/常量字符串/槽加载/槽存储。
函数 编码数据移动Win(IR指令 指令, 整64 最大寄存器, 向量<字符串> 输出) -> 布尔 {
    如果 (指令.操作码 == IR_常量整数) {
        // 常量整数：操作数1 = Symbol ID（文本），mov 目标槽, 值（MASM 归一）
        字符串 值 = 常量立即数文本(驻留文本(指令.操作数1));
        结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 值);
        结果<空类型, 整32> 加2 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
        返回 真;
    }
    如果 (指令.操作码 == IR_常量浮点) {
        // 浮点常量（89-a）：floatData_<文本ID>（REAL8 文本直通）——lea 取址 +
        //   8 字节装载（宿主 ConstFloat 同款语义；win 侧实物验证=跨机轮）
        结果<空类型, 整32> 加f0 = 输出.追加("    lea rax, floatData_" + 整数转字符串(指令.操作数1));
        结果<空类型, 整32> 加f1 = 输出.追加("    mov rax, [rax]");
        结果<空类型, 整32> 加f2 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
        返回 真;
    }
    如果 (指令.操作码 == IR_常量字符串) {
        // P7b 字符串常量：lea 目标, strData_<文本ID>；数据行以 DAT 前缀混入输出，
        //   代码生成 末尾后处理重排到全部函数之后（.code 段内 db 数据定义）
        结果<空类型, 整32> 加s0 = 输出.追加("    lea rax, strData_" + 整数转字符串(指令.操作数1));
        结果<空类型, 整32> 加s1 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
        返回 真;
    }
    如果 (指令.操作码 == IR_加载) {
        // Load 变量槽 -> 寄存器
        结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 变量槽(指令.操作数1, 最大寄存器));
        结果<空类型, 整32> 加2 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
        返回 真;
    }
    如果 (指令.操作码 == IR_存储) {
        // Store 寄存器 -> 变量槽（操作数1=值寄存器，附加=槽）
        结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1));
        结果<空类型, 整32> 加2 = 输出.追加("    mov " + 变量槽(指令.附加, 最大寄存器) + ", rax");
        返回 真;
    }
    返回 假;
}

// 算术组：加/减/乘/除/取余（除/取余 cqo 符号扩展——2026-09-06 #DE 根治）。
// 530-a（D1 行数滚动·纯机械拆分零行为变更·2026-09-20）：编码算术Win 206 行 →
//   分派器+七子函数——逻辑逐字迁移注释逐字保留（行号切片+边界断言）。
//   等价红线=新旧 v2p 交叉编译同一输入 win-x64 asm 文本逐字节 md5 一致（/tmp/p530 双对拍）。
函数 编码浮点四则Win(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    // 91-a（2026-09-13 第九十一轮）：浮点算术（指令.类型=T_浮32/T_浮64）——
    //   SSE 标量指令（addsd/subsd/mulsd/divsd；浮32 用 ss 族，MASM 内存操作数
    //   须显式 dword ptr）；取余 % 不在浮点面内（宿主语义层拒绝浮点操作数）。
    字符串 后缀w = (指令.类型 == T_浮64) ? "sd" : "ss";
    字符串 左w = 寄存器槽(指令.操作数1);
    字符串 右w = 寄存器槽(指令.操作数2);
    字符串 目w = 寄存器槽(指令.目标);
    如果 (指令.类型 == T_浮32) {
        左w = "dword ptr " + 左w;
        右w = "dword ptr " + 右w;
        目w = "dword ptr " + 目w;
    } 否则 如果 (指令.类型 == T_浮64) {
        // 109-a：MASM 浮64 内存操作数须 qword ptr size 说明符
        //   （缺 → A2070；91-a 增浮点分派同批漏点）。
        左w = "qword ptr " + 左w;
        右w = "qword ptr " + 右w;
        目w = "qword ptr " + 目w;
    }
    字符串 运算w = "add";
    如果 (指令.操作码 == IR_减) { 运算w = "sub"; }
    否则 如果 (指令.操作码 == IR_乘) { 运算w = "mul"; }
    否则 如果 (指令.操作码 == IR_除) { 运算w = "div"; }
    结果<空类型, 整32> 加f1 = 输出.追加("    mov" + 后缀w + " xmm0, " + 左w);
    结果<空类型, 整32> 加f2 = 输出.追加("    mov" + 后缀w + " xmm1, " + 右w);
    结果<空类型, 整32> 加f3 = 输出.追加("    " + 运算w + 后缀w + " xmm0, xmm1");
    结果<空类型, 整32> 加f4 = 输出.追加("    mov" + 后缀w + " " + 目w + ", xmm0");
    返回 真;
}
函数 编码加法Win(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1));
    结果<空类型, 整32> 加2 = 输出.追加("    add rax, " + 寄存器槽(指令.操作数2));
    // 264-a D34 波1：32 位类型出口截断（整32 movsxd 符号扩展回填/
    //   正32 清高）——64 位直算不回绕=正32+正32 溢出面错误（191 实锤）
    如果 (指令.类型 == T_整32) {
        结果<空类型, 整32> 加3t = 输出.追加("    movsxd rax, eax");
    } 否则 如果 (指令.类型 == T_正32) {
        结果<空类型, 整32> 加3u = 输出.追加("    mov eax, eax");
    }
    结果<空类型, 整32> 加3 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
    返回 真;
}
函数 编码减法Win(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1));
    结果<空类型, 整32> 加2 = 输出.追加("    sub rax, " + 寄存器槽(指令.操作数2));
    // 264-a D34 波1：32 位类型出口截断（整32 movsxd 符号扩展回填/
    //   正32 清高）——64 位直算不回绕=正32+正32 溢出面错误（191 实锤）
    如果 (指令.类型 == T_整32) {
        结果<空类型, 整32> 加3t = 输出.追加("    movsxd rax, eax");
    } 否则 如果 (指令.类型 == T_正32) {
        结果<空类型, 整32> 加3u = 输出.追加("    mov eax, eax");
    }
    结果<空类型, 整32> 加3 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
    返回 真;
}
函数 编码乘法Win(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1));
    结果<空类型, 整32> 加2 = 输出.追加("    imul rax, " + 寄存器槽(指令.操作数2));
    // 264-a D34 波1：32 位类型出口截断（整32 movsxd 符号扩展回填/
    //   正32 清高）——64 位直算不回绕=正32+正32 溢出面错误（191 实锤）
    如果 (指令.类型 == T_整32) {
        结果<空类型, 整32> 加3t = 输出.追加("    movsxd rax, eax");
    } 否则 如果 (指令.类型 == T_正32) {
        结果<空类型, 整32> 加3u = 输出.追加("    mov eax, eax");
    }
    结果<空类型, 整32> 加3 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
    返回 真;
}
函数 编码除余Win(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    // 351-a（T27 v2 侧同构·阶段二·423 SIGFPE 三后端闭环）：与 X64Linux 350-a 版
    //   逐行同构——①除零检查（test/jnz + 错误码 1=错误码.除零）；②有符号
    //   INT_MIN/-1 溢出保护（x86 idiv 溢出抛 #DE → 两补码统一回绕：x/-1≡-x
    //   〔neg·INT_MIN→INT_MIN〕·x%-1≡0——宿主 319-a 双保护同构）；③32 位位宽
    //   分派（装载 movsxd/0扩展 + cdq/xor + idiv/div r11d + 结局 movsxd/mov·
    //   对齐宿主 cdq+idiv r9d）。win 调用约定差异（351-a p1 探针取证=既有 IR
    //   通道错误调用同款）：首参 **rcx** + shadow space（sub/add rsp,32）；
    //   EXTERN 由 收集EXTERN符号 自动声明（call 行扫描·P7b 机制）。
    布尔 是32位w = (指令.类型 == T_整32 || 指令.类型 == T_正32);
    布尔 除法有符号w = !(指令.类型 == T_正32 || 指令.类型 == T_正64);
    整64 保护序w = 输出.大小();
    如果 (是32位w) {
        如果 (除法有符号w) {
            结果<空类型, 整32> 加d1 = 输出.追加("    movsxd r10, dword ptr " + 寄存器槽(指令.操作数1));
            结果<空类型, 整32> 加d2 = 输出.追加("    movsxd r11, dword ptr " + 寄存器槽(指令.操作数2));
        } 否则 {
            结果<空类型, 整32> 加d3 = 输出.追加("    mov r10d, dword ptr " + 寄存器槽(指令.操作数1));
            结果<空类型, 整32> 加d4 = 输出.追加("    mov r11d, dword ptr " + 寄存器槽(指令.操作数2));
        }
    } 否则 {
        结果<空类型, 整32> 加d5 = 输出.追加("    mov r10, " + 寄存器槽(指令.操作数1));
        结果<空类型, 整32> 加d6 = 输出.追加("    mov r11, " + 寄存器槽(指令.操作数2));
    }
    结果<空类型, 整32> 加d7 = 输出.追加("    test r11, r11");
    结果<空类型, 整32> 加d8 = 输出.追加("    jne " + 除零跳过标签(保护序w));
    结果<空类型, 整32> 加d9 = 输出.追加("    sub rsp, 32");
    结果<空类型, 整32> 加d10 = 输出.追加("    mov rcx, 1");
    结果<空类型, 整32> 加d11 = 输出.追加("    call __cn_runtime_error");
    结果<空类型, 整32> 加d12 = 输出.追加("    add rsp, 32");
    结果<空类型, 整32> 加d13 = 输出.追加("    ret");
    结果<空类型, 整32> 加d14 = 输出.追加(除零跳过标签(保护序w) + ":");
    如果 (除法有符号w) {
        结果<空类型, 整32> 加d15 = 输出.追加("    cmp r11, -1");
        结果<空类型, 整32> 加d16 = 输出.追加("    jne " + 除安全标签(保护序w));
        如果 (指令.操作码 == IR_除) {
            结果<空类型, 整32> 加d17 = 输出.追加("    neg r10");
            如果 (是32位w) {
                结果<空类型, 整32> 加d18 = 输出.追加("    movsxd r10, r10d");
            }
        } 否则 {
            结果<空类型, 整32> 加d19 = 输出.追加("    mov r10, 0");
        }
        结果<空类型, 整32> 加d20 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", r10");
        结果<空类型, 整32> 加d21 = 输出.追加("    jmp " + 除结束标签(保护序w));
        结果<空类型, 整32> 加d22 = 输出.追加(除安全标签(保护序w) + ":");
    }
    如果 (是32位w) {
        结果<空类型, 整32> 加d23 = 输出.追加("    mov eax, r10d");
        如果 (除法有符号w) {
            结果<空类型, 整32> 加d24 = 输出.追加("    cdq");
            结果<空类型, 整32> 加d25 = 输出.追加("    idiv r11d");
        } 否则 {
            结果<空类型, 整32> 加d26 = 输出.追加("    xor edx, edx");
            结果<空类型, 整32> 加d27 = 输出.追加("    div r11d");
        }
        如果 (指令.操作码 == IR_除) {
            如果 (除法有符号w) {
                结果<空类型, 整32> 加d28 = 输出.追加("    movsxd r10, eax");
            } 否则 {
                结果<空类型, 整32> 加d29 = 输出.追加("    mov r10d, eax");
            }
        } 否则 {
            如果 (除法有符号w) {
                结果<空类型, 整32> 加d30 = 输出.追加("    movsxd r10, edx");
            } 否则 {
                结果<空类型, 整32> 加d31 = 输出.追加("    mov r10d, edx");
            }
        }
        结果<空类型, 整32> 加d32 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", r10");
    } 否则 {
        结果<空类型, 整32> 加d33 = 输出.追加("    mov rax, r10");
        如果 (除法有符号w) {
            结果<空类型, 整32> 加d34 = 输出.追加("    cqo");
            结果<空类型, 整32> 加d35 = 输出.追加("    idiv r11");
        } 否则 {
            结果<空类型, 整32> 加d36 = 输出.追加("    xor edx, edx");
            结果<空类型, 整32> 加d37 = 输出.追加("    div r11");
        }
        如果 (指令.操作码 == IR_除) {
            结果<空类型, 整32> 加d38 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
        } 否则 {
            结果<空类型, 整32> 加d39 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rdx");
        }
    }
    如果 (除法有符号w) {
        结果<空类型, 整32> 加d40 = 输出.追加(除结束标签(保护序w) + ":");
    }
    返回 真;
}
函数 编码位运算Win(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    字符串 位指令 = "and";
    如果 (指令.操作码 == IR_位或) { 位指令 = "or"; }
    如果 (指令.操作码 == IR_位异或) { 位指令 = "xor"; }
    结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1));
    结果<空类型, 整32> 加2 = 输出.追加("    " + 位指令 + " rax, " + 寄存器槽(指令.操作数2));
    // 264-a D34 波1：32 位类型出口截断（同算术族）
    如果 (指令.类型 == T_整32) {
        结果<空类型, 整32> 加3t = 输出.追加("    movsxd rax, eax");
    } 否则 如果 (指令.类型 == T_正32) {
        结果<空类型, 整32> 加3u = 输出.追加("    mov eax, eax");
    }
    结果<空类型, 整32> 加3 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
    返回 真;
}
函数 编码移位Win(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    // >> 有符号=算术 sar；无符号（T_正32/正64，46-f 第五十轮）=逻辑 shr
    //   （2^64-1>>1 须=2^63-1 非 -1）；左操作数 rax、移位量 cl
    字符串 移指令 = "shl";
    如果 (指令.操作码 == IR_右移) {
        如果 (指令.类型 == T_正32 || 指令.类型 == T_正64) { 移指令 = "shr"; }
        否则 { 移指令 = "sar"; }
    }
    结果<空类型, 整32> 移1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1));
    结果<空类型, 整32> 移2 = 输出.追加("    mov rcx, " + 寄存器槽(指令.操作数2));
    // 265-a 波A（规范 01b§5.4）：移位量显式按操作数位宽取模——32 位类型
    //   mod 32（x86 64 位操作数硬件 mod 64≠规范语义·178 实锤 5<<33）；64 位 mod 63
    如果 (指令.类型 == T_整32 || 指令.类型 == T_正32) {
        结果<空类型, 整32> 移2m = 输出.追加("    and ecx, 31");
    } 否则 {
        结果<空类型, 整32> 移2m6 = 输出.追加("    and ecx, 63");
    }
    结果<空类型, 整32> 移3 = 输出.追加("    " + 移指令 + " rax, cl");
    如果 (指令.类型 == T_整32) {
        结果<空类型, 整32> 移3t = 输出.追加("    movsxd rax, eax");
    } 否则 如果 (指令.类型 == T_正32) {
        结果<空类型, 整32> 移3t = 输出.追加("    mov eax, eax");
    }
    结果<空类型, 整32> 移4 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
    返回 真;
}

函数 编码算术Win(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    布尔 是浮点算术w = (指令.类型 == T_浮32 || 指令.类型 == T_浮64);
    如果 (是浮点算术w && (指令.操作码 == IR_加 || 指令.操作码 == IR_减 ||
                        指令.操作码 == IR_乘 || 指令.操作码 == IR_除)) {
        返回 编码浮点四则Win(指令, 输出);
    }
    如果 (指令.操作码 == IR_加) { 返回 编码加法Win(指令, 输出); }
    如果 (指令.操作码 == IR_减) { 返回 编码减法Win(指令, 输出); }
    如果 (指令.操作码 == IR_乘) { 返回 编码乘法Win(指令, 输出); }
    如果 (指令.操作码 == IR_除 || 指令.操作码 == IR_取余) { 返回 编码除余Win(指令, 输出); }
    // 位运算（2026-09-09 规范 01b§5.4）：and/or/xor 单指令；移位量经 cl（x86 规定），
    //   265-a 波A：移位量已显式按类型位宽取模（原「硬件 64 位取模=规范语义」前提错误）
    如果 (指令.操作码 == IR_位与 || 指令.操作码 == IR_位或 || 指令.操作码 == IR_位异或) { 返回 编码位运算Win(指令, 输出); }
    如果 (指令.操作码 == IR_左移 || 指令.操作码 == IR_右移) { 返回 编码移位Win(指令, 输出); }
    返回 假;
}

// 比较与一元组：setcc 六比较 / 逻辑非 / 一元负；91-a 增浮点分派。
函数 编码比较一元Win(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    // 91-a：浮点比较（NaN 安全 IEEE ordered 语义，与宿主 H1 修复/linux 后端
    //   同款）——< / <= 交换操作数走 seta/setae；== / != 加 setnp/setp 组合。
    布尔 是浮点比较w = (指令.类型 == T_浮32 || 指令.类型 == T_浮64);
    如果 (是浮点比较w && (指令.操作码 == IR_相等 || 指令.操作码 == IR_不等 ||
                        指令.操作码 == IR_小于 || 指令.操作码 == IR_大于 ||
                        指令.操作码 == IR_小于等于 || 指令.操作码 == IR_大于等于)) {
        字符串 后缀w = (指令.类型 == T_浮64) ? "sd" : "ss";
        字符串 比较w = (指令.类型 == T_浮64) ? "ucomisd" : "ucomiss";
        字符串 左槽w = 寄存器槽(指令.操作数1);
        字符串 右槽w = 寄存器槽(指令.操作数2);
        如果 (指令.类型 == T_浮32) {
            左槽w = "dword ptr " + 左槽w;
            右槽w = "dword ptr " + 右槽w;
        } 否则 如果 (指令.类型 == T_浮64) {
            // 109-a（2026-09-13 家机 win-x64 跨机轮）：MASM movsd 缺 size 说明符
            //   歧义——ml64 优先解析为字符串指令 → A2070（invalid instruction
            //   operands；实测 `movsd xmm0, [mem]` 报错、`movsd xmm0, qword ptr [mem]`
            //   合法）。91-a 增浮点比较分派时仅浮32 加 dword ptr，浮64 漏加 →
            //   E2E 246（静态浮64 比较）win 侧 ml64 汇编失败（linux GAS 语法无需
            //   说明符故不显）；与前方 movsd/movss 装载点同款纪律。
            左槽w = "qword ptr " + 左槽w;
            右槽w = "qword ptr " + 右槽w;
        }
        布尔 交换w = (指令.操作码 == IR_小于 || 指令.操作码 == IR_小于等于);
        如果 (交换w) {
            结果<空类型, 整32> 加lw1 = 输出.追加("    mov" + 后缀w + " xmm0, " + 右槽w);
            结果<空类型, 整32> 加lw2 = 输出.追加("    mov" + 后缀w + " xmm1, " + 左槽w);
        } 否则 {
            结果<空类型, 整32> 加lw3 = 输出.追加("    mov" + 后缀w + " xmm0, " + 左槽w);
            结果<空类型, 整32> 加lw4 = 输出.追加("    mov" + 后缀w + " xmm1, " + 右槽w);
        }
        结果<空类型, 整32> 加lw5 = 输出.追加("    " + 比较w + " xmm0, xmm1");
        如果 (指令.操作码 == IR_相等) {
            结果<空类型, 整32> 加lw6 = 输出.追加("    sete al");
            结果<空类型, 整32> 加lw7 = 输出.追加("    setnp cl");
            结果<空类型, 整32> 加lw8 = 输出.追加("    and al, cl");
        } 否则 如果 (指令.操作码 == IR_不等) {
            结果<空类型, 整32> 加lw9 = 输出.追加("    setne al");
            结果<空类型, 整32> 加lw10 = 输出.追加("    setp cl");
            结果<空类型, 整32> 加lw11 = 输出.追加("    or al, cl");
        } 否则 如果 (指令.操作码 == IR_小于) {
            结果<空类型, 整32> 加lw12 = 输出.追加("    seta al");    // 交换后 < = 右>左
        } 否则 如果 (指令.操作码 == IR_小于等于) {
            结果<空类型, 整32> 加lw13 = 输出.追加("    setae al");   // 交换后 <= = 右>=左
        } 否则 如果 (指令.操作码 == IR_大于) {
            结果<空类型, 整32> 加lw14 = 输出.追加("    seta al");
        } 否则 {
            结果<空类型, 整32> 加lw15 = 输出.追加("    setae al");
        }
        结果<空类型, 整32> 加lw16 = 输出.追加("    movzx eax, al");
        结果<空类型, 整32> 加lw17 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
        返回 真;
    }
    如果 (指令.操作码 == IR_相等 || 指令.操作码 == IR_不等 ||
        指令.操作码 == IR_小于 || 指令.操作码 == IR_大于 ||
        指令.操作码 == IR_小于等于 || 指令.操作码 == IR_大于等于) {
        // 比较：cmp 左, 右；setcc al；movzx 目标。46-f 第五十轮：无符号操作数
        //   （T_正32/正64）用无符号条件码 setb/seta/setbe/setae（2^63>100 按
        //   -2^63>100 判假=静默错误）
        整64 无符号 = (指令.类型 == T_正32 || 指令.类型 == T_正64) ? 1 : 0;
        字符串 设置指令 = "sete";
        如果 (指令.操作码 == IR_不等) { 设置指令 = "setne"; }
        否则 如果 (指令.操作码 == IR_小于) { 设置指令 = 无符号 == 1 ? "setb" : "setl"; }
        否则 如果 (指令.操作码 == IR_大于) { 设置指令 = 无符号 == 1 ? "seta" : "setg"; }
        否则 如果 (指令.操作码 == IR_小于等于) { 设置指令 = 无符号 == 1 ? "setbe" : "setle"; }
        否则 如果 (指令.操作码 == IR_大于等于) { 设置指令 = 无符号 == 1 ? "setae" : "setge"; }
        结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1));
        结果<空类型, 整32> 加2 = 输出.追加("    cmp rax, " + 寄存器槽(指令.操作数2));
        结果<空类型, 整32> 加3 = 输出.追加("    " + 设置指令 + " al");
        结果<空类型, 整32> 加4 = 输出.追加("    movzx eax, al");
        结果<空类型, 整32> 加5 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
        返回 真;
    }
    如果 (指令.操作码 == IR_逻辑非) {
        // 逻辑非：先装载到 rax 再 cmp 0（栈槽直接 cmp 立即数时 MASM 无法推断
        // 操作数尺寸，A2070；对齐本文件比较运算的先装载惯例）
        结果<空类型, 整32> 加0 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1));
        结果<空类型, 整32> 加1 = 输出.追加("    cmp rax, 0");
        结果<空类型, 整32> 加2 = 输出.追加("    sete al");
        结果<空类型, 整32> 加3 = 输出.追加("    movzx eax, al");
        结果<空类型, 整32> 加4 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
        返回 真;
    }
    如果 (指令.操作码 == IR_负) {
        // 91-a：浮点取负=符号位翻转（btc——±0/NaN 语义与 IEEE negate 一致；
        //   浮64 位 63 / 浮32 位 31；整数走 neg 原路径）
        如果 (指令.类型 == T_浮32 || 指令.类型 == T_浮64) {
            整64 符号位w = (指令.类型 == T_浮64) ? 63 : 31;
            结果<空类型, 整32> 加n1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1));
            结果<空类型, 整32> 加n2 = 输出.追加("    btc rax, " + 整数转字符串(符号位w));
            结果<空类型, 整32> 加n3 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
            返回 真;
        }
        // 353-a（T60）：整数 32 位域分派——neg eax 32 位取负（eax 写零扩高 32）
        //   +movsxd 符号回填，防 64 位 neg 高半脏值随槽扩散；8/16 位低段恒同
        //   沿 64 位路径（消费方窄读扩展）。T_正32 低 32 位同 neg32 模 2^32。
        如果 (指令.类型 == T_整32 || 指令.类型 == T_正32) {
            结果<空类型, 整32> 加w1 = 输出.追加("    mov eax, dword ptr " + 寄存器槽(指令.操作数1));
            结果<空类型, 整32> 加w2 = 输出.追加("    neg eax");
            结果<空类型, 整32> 加w3 = 输出.追加("    movsxd rax, eax");
            结果<空类型, 整32> 加w4 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
            返回 真;
        }
        结果<空类型, 整32> 加1 = 输出.追加("    mov rax, " + 寄存器槽(指令.操作数1));
        结果<空类型, 整32> 加2 = 输出.追加("    neg rax");
        结果<空类型, 整32> 加3 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
        返回 真;
    }
    返回 假;
}

// 类型转换组：整32 截断 / 整8/整16 movsx 窄读 / 正8/正16 movzx 零扩展
//   （灰色点④+缺陷零容忍收口）/ 整64 movsxd（dword ptr 尺寸前缀——A2070）。
函数 编码类型转换Win(IR指令 指令, 整64 函数序号, 向量<字符串> 输出) -> 布尔 {
        // 214-a（2026-09-15 第两百一十四轮，D1 行数整改）：浮点转换段（浮↔浮/整→浮
        //   〔正64 符号位分支修正〕/浮→整 向零截断）迁 编码浮点转换Win——真=已处理，
        //   假=非浮点（落下方整数段）。
    如果 (指令.操作码 == IR_类型转换) {
        如果 (编码浮点转换Win(指令, 函数序号, 输出)) { 返回 真; }
        字符串 源槽 = 寄存器槽(指令.操作数1);
        // 292（070 波J 49c6d405 win 后端同构·2026-10-08）：**128 位句柄源**——低
        //   64 位直拷（整128→整64 取低半·Rust as 截断同款·001 §255 降宽取低位）
        //   ——原落 movsxd dword 兜底=32 位读截断（432 win 面 1099511627777/78
        //   输出 1/2 实录·波J 1026 只落 X64Linux·三后端写集漏核）
        如果 (指令.操作数2 == T_整128 || 指令.操作数2 == T_正128) {
            结果<空类型, 整32> 加a0 = 输出.追加("    mov rax, qword ptr " + 源槽);
        } 否则 如果 (指令.操作数2 == 0 && 指令.类型 == T_整64) {
            // 未登记源=整数类兜底——**64 位槽直拷**（写入路径保证高位干净·555
            //   轮 T_正64 同款论证·波J linux 侧同构分支）
            结果<空类型, 整32> 加a1 = 输出.追加("    mov rax, qword ptr " + 源槽);
        } 否则 如果 (指令.类型 == T_正64) {
            // 方案甲（2026-09-10 第五十一轮）：T_正64=64 位源直拷（同宽位模式重解释，
            //   Rust as 对齐——2^63 转 i64 = -2^63；mov rax 全 64 读，无扩展无截断；
            //   原落 movsxd dword 兜底=低 32 截断，193_v2 立案）
            结果<空类型, 整32> 加z0 = 输出.追加("    mov rax, " + 源槽);
        } 否则 如果 (指令.类型 == T_整32) {
            结果<空类型, 整32> 加1 = 输出.追加("    mov eax, " + 源槽);
            结果<空类型, 整32> 加2 = 输出.追加("    movsxd rax, eax");
        } 否则 如果 (指令.类型 == T_正32) {
            // 46-f 第五十轮：正32 零扩展读回（mov eax 清高 32——原值非符号负）
            结果<空类型, 整32> 加1 = 输出.追加("    mov eax, " + 源槽);
        } 否则 如果 (指令.类型 == T_整8) {
            结果<空类型, 整32> 加n1 = 输出.追加("    mov al, byte ptr " + 源槽);
            结果<空类型, 整32> 加n2 = 输出.追加("    movsx rax, al");
        } 否则 如果 (指令.类型 == T_整16) {
            结果<空类型, 整32> 加n3 = 输出.追加("    mov ax, word ptr " + 源槽);
            结果<空类型, 整32> 加n4 = 输出.追加("    movsx rax, ax");
        } 否则 如果 (指令.类型 == T_正8) {
            // 2026-09-04 缺陷零容忍收口：无符号窄宽零扩展（正8(200)=200）
            结果<空类型, 整32> 加u1 = 输出.追加("    mov al, byte ptr " + 源槽);
            结果<空类型, 整32> 加u2 = 输出.追加("    movzx rax, al");
        } 否则 如果 (指令.类型 == T_正16) {
            结果<空类型, 整32> 加u3 = 输出.追加("    mov ax, word ptr " + 源槽);
            结果<空类型, 整32> 加u4 = 输出.追加("    movzx rax, ax");
        } 否则 {
            // 整64/其他：movsxd 符号扩展（32 位源已由 IR 层按 整64 槽存）。
            //   源为内存槽时必须带 dword ptr——MASM 的 movsxd 无尺寸前缀无法
            //   判定操作数大小（A2070；129 用例 win 侧首跑实锤，GAS 侧无此歧义）。
            //   分派面（第五十五轮标注）：正8/正16 源经 类型码() 归一登记 T_整64，
            //   方案甲源分派已改标 T_正64 直拷不经此兜底；真兜底形态=源登记
            //   T_整32（符号扩展=整32 既有语义）或未登记——均符号扩展正确
            结果<空类型, 整32> 加3 = 输出.追加("    movsxd rax, dword ptr " + 源槽);
        }
        结果<空类型, 整32> 加4 = 输出.追加("    mov " + 寄存器槽(指令.目标) + ", rax");
        返回 真;
    }
    返回 假;
}


        // P6g（2026-08-30）：类型转换 类型(expr)——目标类型码在 指令.类型，
        //   源值在 指令.操作数1 槽。整64 -> 整32：截断（mov eax 低32位 + movsxd 符号扩展）；
        //   整32 -> 整64：movsxd（符号扩展）。
        // 91-a（2026-09-13 第九十一轮）：浮点转换分派（源码=操作数2，目标码=类型字段）
        //   ——浮->浮（cvtss2sd/cvtsd2ss/同码直拷）、整->浮（cvtsi2sd/ss；正64
        //   无符号经符号位分支修正，cvtu_ 标签=函数序号_目标唯一）、浮->整
        //   （cvttsd2si/ss2si 向零截断）。MASM 浮点内存操作数尺寸：浮32 显式
        //   dword ptr（movss 配 qword 报 A2070）。
// 214-a（2026-09-15 第两百一十四轮，D1 行数整改）：浮点转换段——浮↔浮（cvtss2sd/
//   cvtsd2ss/同码直拷）、整→浮（cvtsi2sd/ss；正64 无符号经符号位分支修正，cvtu_ 标签
//   =函数序号_目标唯一）、浮→整（cvttsd2si/ss2si 向零截断）。MASM 浮点内存操作数尺寸：
//   浮32 显式 dword ptr（movss 配 qword 报 A2070）；110-a 浮64 存回 qword ptr。
//   真=已处理浮点转换；假=非浮点（调用方落整数转换段）。
