// 代码生成ARM64尾（357 重构F2 自 代码生成ARM64.cn 纯机械搬移·函数体逐字保留·零逻辑变化）

导入 容器::向量;
导入 IR;           // IR 指令/程序IR/类型码/驻留文本/析构符号（原 IR生成+IR容器+IR常量 合并）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 代码生成;     // 后端共用决策层（原 代码生成共用；同包包名幂等加载）

公开:   // 全文件公开（子模块符号供包内兄弟模块与跨包消费方经合并全局池解析）

函数 编码删除对象ARM64(IR指令 指令, 整64 函数序号, 向量<字符串> 输出) -> 布尔 {
        // DeleteObject：空安全（cbz）+ ~类(this) + __cn_object_delete(this)
        字符串 标签 = 对象删除标签(函数序号, 指令.目标);
        字符串 析构名 = 符号修饰ARM64(析构符号(驻留文本(指令.附加)));
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
        加行(输出, "    cbz x9, " + 标签);
        加行(输出, "    mov x0, x9");
        加行(输出, "    bl " + 析构名);
        读槽(输出, "x9", 寄存器槽偏移(指令.操作数1));
        加行(输出, "    mov x0, x9");
        加行(输出, "    bl __cn_object_delete");
        加行(输出, 标签 + ":");
        返回 真;
    返回 真;
}

函数 编码调用装载栈实参ARM64(向量<IR指令> 实参们, 向量<整64> 类们, 向量<整64> 号们, 向量<字符串> 输出) -> 布尔 {
        // 栈实参先装载（经 x9/d0 中转，不扰 x0-x7）
        整64 a = 0;
        当 (a < 实参们.大小()) {
            IR指令 实参 = 实参们.元素(a);
            如果 (类们.元素(a) == 2) {
                字符串 偏移a = 整数转字符串(号们.元素(a) * 8);
                如果 (实参.操作数2 == T_浮32 || 实参.操作数2 == T_浮64) {
                    字符串 前缀a = (实参.操作数2 == T_浮64) ? "d" : "s";
                    读槽(输出, 前缀a + "0", 寄存器槽偏移(实参.操作数1));
                    加行(输出, "    str " + 前缀a + "0, [sp, #" + 偏移a + "]");
                } 否则 {
                    读槽(输出, "x9", 寄存器槽偏移(实参.操作数1));
                    加行(输出, "    str x9, [sp, #" + 偏移a + "]");
                }
            }
            a++;
        }
    返回 真;
}

函数 编码调用装载结果ARM64(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
            如果 (指令.操作数2 == T_浮32) {
                写槽(输出, "s0", 寄存器槽偏移(指令.目标));
            } 否则 如果 (指令.操作数2 == T_浮64) {
                写槽(输出, "d0", 寄存器槽偏移(指令.目标));
            } 否则 {
                // 111-a：≤32 位返回类型高位规范化（AAPCS64 窄返回值只在 w0 有效——
                //   w0 写入清 x0 高 32 位，但低 32 位内高位仍可能非零；**低 32 位是
                //   权威值**，扩展方式与 v2 内部表示一致：整32=有符号（类型转换生成
                //   sxtw 符号扩展，零扩展会破坏负值语义）；正32=零扩展；布尔=0/1 零扩展。
                //   对齐 Rust/LLVM signext/zeroext——与 win/X64L 同款纪律，三后端同治。
                整64 返回码n = 指令.操作数2;
                如果 (返回码n == T_布尔) {
                    加行(输出, "    uxtb w0, w0");
                }
                如果 (返回码n == T_整32) {
                    加行(输出, "    sxtw x0, w0");
                }
                如果 (返回码n == T_正32) {
                    加行(输出, "    mov w0, w0");
                }
                写槽(输出, "x0", 寄存器槽偏移(指令.目标));
            }
    返回 真;
}

函数 编码对象调用ARM64(IR指令 指令, 整64 最大寄存器, 整64 槽基数, 整64 retbuf槽数, 整64 函数序号,
                       向量<IR指令> 实参们, 向量<字符串> 输出) -> 布尔 {
    如果 (指令.操作码 == IR_分配对象) { 返回 编码分配对象ARM64(指令, 输出); }
    如果 (指令.操作码 == IR_结构体拷贝) { 返回 编码结构体拷贝ARM64(指令, 函数序号, 输出); }
    如果 (指令.操作码 == IR_删除对象) { 返回 编码删除对象ARM64(指令, 函数序号, 输出); }
    如果 (指令.操作码 == IR_调用参数化) {
            // 调用统一展开（用户裁决项3 参数区）：总位数=操作数1（含 retbuf/this）。
            // 91-a（2026-09-13 第九十一轮）：AAPCS64 双计数参数分配（共用层
            //   分配参数位置 单点：整型 8 / 浮点 8 独立计数）——整型类 x0-x7、
            //   浮点类 d0-d7（浮32 s0-s7）；各自溢出按声明序共享栈参数区
            //   [sp, #栈位号*8]（被调方 [x29, #16+栈位号*8]，无影子空间）。返回：
            //   浮点码（操作数2）-> d0 装载，其余 -> x0。栈区 16 对齐，bl 前
            //   sp 恒 16 对齐（帧对齐 + 对齐栈区）。
            整64 总位数 = 指令.操作数1;
            向量<整64> 实参码们 = 向量<整64>();
            整64 码i0 = 0;
            当 (码i0 < 实参们.大小()) {
                结果<空类型, 整32> 加码0 = 实参码们.追加(实参们.元素(码i0).操作数2);
                如果 (!加码0.正常) { 运行时错误(4); }
                码i0++;
            }
            向量<整64> 类们 = 向量<整64>();
            向量<整64> 号们 = 向量<整64>();
            分配参数位置(实参码们, 8, 8, 指令.类型 != 0, 类们, 号们);
            整64 栈游标 = 0;
            整64 栈i0 = 0;
            当 (栈i0 < 类们.大小()) {
                如果 (类们.元素(栈i0) == 2) { 栈游标++; }
                栈i0++;
            }
            整64 栈区 = 栈游标 * 8;
            如果 (栈区 % 16 != 0) { 栈区 = 栈区 + 8; }
            如果 (栈区 > 0) {
                如果 (栈区 <= 4095) {
                    加行(输出, "    sub sp, sp, #" + 整数转字符串(栈区));
                } 否则 {
                    装载立即数(输出, "x13", 栈区);
                    加行(输出, "    sub sp, sp, x13");
                }
            }
            // retbuf（位 0）：x0 = 返回缓冲槽地址（②b B6：基槽=槽基数+retbuf槽数，
            //   序号恒 1 共享单缓冲——按真实返回字节数定尺寸）
            如果 (指令.类型 != 0) {
                槽地址(输出, "x0", 变量槽偏移(retbuf基槽(槽基数, retbuf槽数), 最大寄存器));
            }
        编码调用装载栈实参ARM64(实参们, 类们, 号们, 输出);
            // 寄存器实参（整型类 x0-x7 / 浮点类 d0-d7——分配表分派）
            整64 b = 0;
            当 (b < 实参们.大小()) {
                IR指令 实参2 = 实参们.元素(b);
                整64 类b = 类们.元素(b);
                如果 (类b == 0) {
                    读槽(输出, "x" + 整数转字符串(号们.元素(b)), 寄存器槽偏移(实参2.操作数1));
                } 否则 如果 (类b == 1) {
                    字符串 前缀b = (实参2.操作数2 == T_浮64) ? "d" : "s";
                    读槽(输出, 前缀b + 整数转字符串(号们.元素(b)), 寄存器槽偏移(实参2.操作数1));
                }
                b++;
            }
            如果 (指令.附加 < 0) {
                // 234 虚调用：附加=-槽-1；vptr=[x0]（标量/空返回·this=位0）
                加行(输出, "    ldr x16, [x0]");
                加行(输出, "    ldr x16, [x16, #" + 整数转字符串((0 - 指令.附加 - 1) * 8) + "]");
                加行(输出, "    blr x16");
            } 否则 {
                加行(输出, "    bl " + 符号修饰ARM64(驻留文本(指令.附加)));
            }
            如果 (栈区 > 0) {
                如果 (栈区 <= 4095) {
                    加行(输出, "    add sp, sp, #" + 整数转字符串(栈区));
                } 否则 {
                    装载立即数(输出, "x13", 栈区);
                    加行(输出, "    add sp, sp, x13");
                }
            }
        如果 (指令.目标 != 0) { 编码调用装载结果ARM64(指令, 输出); }
        返回 真;
    }
    如果 (指令.操作码 == IR_间接调用) {
        // T69（480-a 深度机）：函数指针间接调用——AAPCS64 实参装载与直接调用
        //   同构（无 retbuf 前导位），blr 目标=指针寄存器 x16（IP0；装载晚于
        //   实参防覆盖；宿主 arm64_instructions.cpp emitCall 间接分支同款）。
        向量<整64> 实参码们480 = 向量<整64>();
        整64 码i480 = 0;
        当 (码i480 < 实参们.大小()) {
            结果<空类型, 整32> 加码480 = 实参码们480.追加(实参们.元素(码i480).操作数2);
            如果 (!加码480.正常) { 运行时错误(4); }
            码i480++;
        }
        向量<整64> 类们480 = 向量<整64>();
        向量<整64> 号们480 = 向量<整64>();
        分配参数位置(实参码们480, 8, 8, 假, 类们480, 号们480);
        整64 栈游标480 = 0;
        整64 栈i480 = 0;
        当 (栈i480 < 类们480.大小()) {
            如果 (类们480.元素(栈i480) == 2) { 栈游标480++; }
            栈i480++;
        }
        整64 栈区480 = 栈游标480 * 8;
        如果 (栈区480 % 16 != 0) { 栈区480 = 栈区480 + 8; }
        如果 (栈区480 > 0) {
            如果 (栈区480 <= 4095) {
                加行(输出, "    sub sp, sp, #" + 整数转字符串(栈区480));
            } 否则 {
                装载立即数(输出, "x13", 栈区480);
                加行(输出, "    sub sp, sp, x13");
            }
        }
        // 栈实参先装载（经 x9/d0 中转，不扰 x0-x7）
        整64 a480 = 0;
        当 (a480 < 实参们.大小()) {
            IR指令 实参480 = 实参们.元素(a480);
            如果 (类们480.元素(a480) == 2) {
                字符串 偏移480 = 整数转字符串(号们480.元素(a480) * 8);
                如果 (实参480.操作数2 == T_浮32 || 实参480.操作数2 == T_浮64) {
                    字符串 前缀p480 = (实参480.操作数2 == T_浮64) ? "d" : "s";
                    读槽(输出, 前缀p480 + "0", 寄存器槽偏移(实参480.操作数1));
                    加行(输出, "    str " + 前缀p480 + "0, [sp, #" + 偏移480 + "]");
                } 否则 {
                    读槽(输出, "x9", 寄存器槽偏移(实参480.操作数1));
                    加行(输出, "    str x9, [sp, #" + 偏移480 + "]");
                }
            }
            a480++;
        }
        // 寄存器实参（整型类 x0-x7 / 浮点类 d0-d7——分配表分派）
        整64 b480 = 0;
        当 (b480 < 实参们.大小()) {
            IR指令 实参2b480 = 实参们.元素(b480);
            整64 类b480 = 类们480.元素(b480);
            如果 (类b480 == 0) {
                读槽(输出, "x" + 整数转字符串(号们480.元素(b480)), 寄存器槽偏移(实参2b480.操作数1));
            } 否则 如果 (类b480 == 1) {
                字符串 前缀b480 = (实参2b480.操作数2 == T_浮64) ? "d" : "s";
                读槽(输出, 前缀b480 + 整数转字符串(号们480.元素(b480)), 寄存器槽偏移(实参2b480.操作数1));
            }
            b480++;
        }
        读槽(输出, "x16", 寄存器槽偏移(指令.附加));
        // 040（001 §5.8 子案 A·2026-10-05 用户裁决）：空调用判零——零值 →
        //   运行时错误(3) 空指针解引用（错误码走 x0·907 同款不返回）
        整64 空指针序f480 = 输出.大小();
        加行(输出, "    cbnz x16, " + 空指针跳过标签(空指针序f480));
        加行(输出, "    movz x0, #3");
        加行(输出, "    bl __cn_runtime_error");
        加行(输出, "    ret");
        加行(输出, 空指针跳过标签(空指针序f480) + ":");
        加行(输出, "    blr x16");
        如果 (栈区480 > 0) {
            加行(输出, "    add sp, sp, #" + 整数转字符串(栈区480));
        }
        如果 (指令.目标 != 0) {
            如果 (指令.操作数2 == T_浮32) {
                写槽(输出, "s0", 寄存器槽偏移(指令.目标));
            } 否则 如果 (指令.操作数2 == T_浮64) {
                写槽(输出, "d0", 寄存器槽偏移(指令.目标));
            } 否则 {
                整64 返回码n480 = 指令.操作数2;
                如果 (返回码n480 == T_布尔) {
                    加行(输出, "    uxtb w0, w0");
                }
                如果 (返回码n480 == T_整32) {
                    加行(输出, "    sxtw x0, w0");
                }
                如果 (返回码n480 == T_正32) {
                    加行(输出, "    mov w0, w0");
                }
                写槽(输出, "x0", 寄存器槽偏移(指令.目标));
            }
        }
        返回 真;
    }    返回 假;
}

// 静态组：静态槽读/地址/写（adrp+:lo12: 重定位）。
函数 编码静态ARM64(IR指令 指令, 向量<字符串> 输出) -> 布尔 {
    如果 (指令.操作码 == IR_静态加载) {
        // ②c C：静态槽读——adrp+ldr :lo12: 重定位（-no-pie；宿主 strData 同款模式）
        加行(输出, "    adrp x9, " + 静态槽标签(指令.附加));
        加行(输出, "    ldr x9, [x9, :lo12:" + 静态槽标签(指令.附加) + "]");
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_静态地址) {
        // 静态槽地址（adrp+add）——拷贝构造源 T& 传静态容器左值地址
        加行(输出, "    adrp x9, " + 静态槽标签(指令.附加));
        加行(输出, "    add x9, x9, :lo12:" + 静态槽标签(指令.附加));
        写槽(输出, "x9", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    如果 (指令.操作码 == IR_静态存储) {
        // ②c C：静态槽写——adrp x9 + str（值经 x10 中转）
        读槽(输出, "x10", 寄存器槽偏移(指令.操作数1));
        加行(输出, "    adrp x9, " + 静态槽标签(指令.附加));
        加行(输出, "    str x10, [x9, :lo12:" + 静态槽标签(指令.附加) + "]");
        返回 真;
    }
    如果 (指令.操作码 == IR_函数地址) {
        // T69（480-a 深度机）：取函数符号地址（adrp + add :lo12: 双指令——
        //   与静态槽地址同款寻址；宿主 arm64_instructions.cpp FuncAddr 同源）
        字符串 函数符480 = 符号修饰ARM64(驻留文本(指令.附加));
        加行(输出, "    adrp x10, " + 函数符480);
        加行(输出, "    add x10, x10, :lo12:" + 函数符480);
        写槽(输出, "x10", 寄存器槽偏移(指令.目标));
        返回 真;
    }
    返回 假;
}


// ==================== 函数生成 ====================
// 生成单函数完整 GAS：.globl/.type/标签 / prologue / 参数装载 / 指令 / epilogue。
// 帧大小 = (最大寄存器 + 最大槽) * 8 + 8，16 对齐（win64 同式——x29 锚定槽区）。
函数 生成函数ARM64(函数IR 函数信息, 整64 函数序号, 向量<字符串> 输出) -> 空类型 {
    整64 最大寄存器 = 0;
    整64 最大槽 = 0;
    整64 槽基数 = 0;
    扫描函数(函数信息, &最大寄存器, &最大槽, &槽基数);
    整64 retbuf槽数 = retbuf槽位数(函数信息);    // ②b B6：与 扫描函数 同一决策
    整64 帧大小 = 计算帧大小(最大寄存器, 最大槽);
    字符串 函数名 = 符号修饰ARM64(驻留文本(整64(函数信息.名字)));
    加行(输出, ".globl " + 函数名);
    加行(输出, ".type " + 函数名 + ", %function");
    加行(输出, 函数名 + ":");
    加行(输出, "    stp x29, x30, [sp, #-16]!");
    加行(输出, "    mov x29, sp");
    如果 (帧大小 <= 4095) {
        加行(输出, "    sub sp, sp, #" + 整数转字符串(帧大小));
    } 否则 {
        装载立即数(输出, "x13", 帧大小);
        加行(输出, "    sub sp, sp, x13");
    }
    // AAPCS64 参数装载（②b B8 按声明序：参数槽序们/参数拷贝字节们）——标量：
    //   前 8 位 x0~x7 直存，第 9 位起 [x29, #16+(位-8)*8]（宿主同式）；结构体按值：
    //   入参为指针（B3 调用方约定）-> x9 取指针、x10=目标基槽地址，字循环拷贝
    //   真实字节入槽（IR_结构体拷贝 同款循环——基址槽=最大槽号=最低地址，向上写）
    // 用户函数返回结构体（2026-09-04，E2E 148，win 侧对称）：位 0（x0）=调用方
    //   传入的 retbuf 指针——存槽 1（生成函数 已保留）；声明参数位号整体 +1。
    布尔 返回结构体 = 函数信息.返回结构体ID != 0 || 函数信息.返回结果名ID != 0 ||
        函数信息.返回128位 != 0 ||   // 71-a：结果/可选·810（053）：128 位标量返回同款 retbuf ABI
        函数信息.返回数组字节 != 0;   // 087b：数组返回 sret 第四形态（槽 1=retbuf 指针存 x0）
    如果 (返回结构体) {
        写槽(输出, "x0", 变量槽偏移(1, 最大寄存器));
    }
    // 91-a（2026-09-13 第九十一轮）：AAPCS64 双计数参数装载（共用层 分配参数位置
    //   单点）——整型类 x0-x7（8）；浮点类 d0-d7（浮32 s0-s7；独立计数）；
    //   各自溢出按声明序共享栈参区 [x29, #16+栈位号*8]。
    向量<整64> 类们p = 向量<整64>();
    向量<整64> 号们p = 向量<整64>();
    分配参数位置(函数信息.参数类型们, 8, 8, 返回结构体, 类们p, 号们p);
    整64 参数序 = 0;
    当 (参数序 < 函数信息.参数槽序们.大小()) {
        整64 参数槽 = 函数信息.参数槽序们.元素(参数序);
        整64 拷贝字节 = 函数信息.参数拷贝字节们.元素(参数序);
        整64 类p = 0;
        整64 号p = 0;
        如果 (参数序 < 类们p.大小()) {
            类p = 类们p.元素(参数序);
            号p = 号们p.元素(参数序);
        }
        整64 参类p = 0;
        如果 (参数序 < 函数信息.参数类型们.大小()) {
            参类p = 函数信息.参数类型们.元素(参数序);
        }
        如果 (类p == 1) {
            字符串 前缀p = (参类p == T_浮64) ? "d" : "s";
            写槽(输出, 前缀p + 整数转字符串(号p), 变量槽偏移(参数槽, 最大寄存器));
        } 否则 如果 (类p == 2) {
            如果 (拷贝字节 > 0) {
                // 110-a：结构体按值栈参数（B3 约定=指针传入，调用方写指针）——
                //   从栈位取源指针后拷贝入槽（寄存器路径同款）。原实现落下方
                //   标量路径只存 8 字节指针 → 被调方按内联数据访问 → 数据错
                //   （E2E 158_v2 分歧面③ win 侧实证；AAPCS64 ≥9 结构体参数才触发）。
                读槽(输出, "x9", 16 + 号p * 8);
                发射参数拷贝ARM64(输出, 参数槽, 最大寄存器, 拷贝字节, 函数序号);
            } 否则 如果 (参类p == T_浮32 || 参类p == T_浮64) {
                字符串 前缀p = (参类p == T_浮64) ? "d" : "s";
                读槽(输出, 前缀p + "0", 16 + 号p * 8);
                写槽(输出, 前缀p + "0", 变量槽偏移(参数槽, 最大寄存器));
            } 否则 {
                读槽(输出, "x9", 16 + 号p * 8);
                写槽(输出, "x9", 变量槽偏移(参数槽, 最大寄存器));
            }
        } 否则 如果 (拷贝字节 == 0) {
            写槽(输出, "x" + 整数转字符串(号p), 变量槽偏移(参数槽, 最大寄存器));
        } 否则 {
            加行(输出, "    mov x9, x" + 整数转字符串(号p));
            发射参数拷贝ARM64(输出, 参数槽, 最大寄存器, 拷贝字节, 函数序号);
        }
        参数序++;
    }
    // 指令主循环（IR_调用实参 为声明性指令：收集，IR_调用参数化 统一展开）
    向量<IR指令> 调用实参们 = 向量<IR指令>();
    整64 i = 0;
    当 (i < 函数信息.指令.大小()) {
        IR指令 指令 = 函数信息.指令.元素(i);
        如果 (指令.操作码 == IR_调用实参) {
            结果<空类型, 整32> 加实 = 调用实参们.追加(指令);
            如果 (!加实.正常) { 运行时错误(4); }
        } 否则 {
            生成指令ARM64(指令, 最大寄存器, 槽基数, retbuf槽数, 函数序号, 调用实参们, 输出);
            // T69（480-a）：间接调用同款消费前导 IR_调用实参 序列
            如果 (指令.操作码 == IR_调用参数化 || 指令.操作码 == IR_间接调用) {
                调用实参们.清空();
            }
        }
        i++;
    }
    // epilogue（宿主 emitEpilogue 同款）
    如果 (帧大小 <= 4095) {
        加行(输出, "    add sp, sp, #" + 整数转字符串(帧大小));
    } 否则 {
        装载立即数(输出, "x13", 帧大小);
        加行(输出, "    add sp, sp, x13");
    }
    加行(输出, "    ldp x29, x30, [sp], #16");
    加行(输出, "    ret");
    加行(输出, "");
}

// ==================== 程序入口 ====================
// 程序IR -> GAS 行列表。.text 函数区 + .data 字符串常量（去重；宿主 .data 同款）+ .note.GNU-stack（现代 binutils 可执行栈告警/错误防护，宿主同款收尾）。
// GAS 无需 EXTERN 声明（未定义符号默认外部；win64 路径 ml64 需要）。
函数 代码生成ARM64(程序IR 程序) -> 向量<字符串> {
    向量<字符串> 输出 = 向量<字符串>();
    加行(输出, "// 由 v2 代码生成ARM64 生成（linux-arm64 / GNU as / AAPCS64）");
    加行(输出, ".text");
    整64 f = 0;
    当 (f < 程序.函数们.大小()) {
        生成函数ARM64(程序.函数们.元素(f), f, 输出);
        f++;
    }
    // 字符串常量数据段（共用层收集去重；.byte 十进制字节 + 0 终止）
    向量<整64> 常量ID们 = 收集字符串常量(程序);
    整64 s2 = 0;
    当 (s2 < 常量ID们.大小()) {
        字符串 文本 = 字符串复制(驻留文本(常量ID们.元素(s2)));
        加行(输出, ".data");
        加行(输出, "strData_" + 整数转字符串(常量ID们.元素(s2)) + ":");
        字符串 字节行 = "    .byte";
        整64 b = 0;
        当 (b < 字符串长度(文本)) {
            整64 字节 = 整64(文本[b]) & 255;
            字节行 = 字节行 + " " + 整数转字符串(字节) + ",";
            b++;
        }
        加行(输出, 字节行 + " 0");
        s2++;
    }
    // 浮点常量数据段（89-a）：.align 3（AArch64 GAS .align N=2^N——8 字节对齐，
    //   对齐理由同静态槽节：LO12 重定位 addend 必须 8 对齐）
    向量<整64> 浮点ID们 = 收集浮点常量(程序);
    整64 fd = 0;
    当 (fd < 浮点ID们.大小()) {
        加行(输出, ".data");
        加行(输出, ".align 3");
        加行(输出, "floatData_" + 整数转字符串(浮点ID们.元素(fd)) + ":");
        加行(输出, "    .double " + 浮点文本净(浮点ID们.元素(fd)));
        fd++;
    }
    // ②c C：静态槽数据段（.data 可写；标量静态直存折叠初始值，容器静态 0——
    //   入口 NewObject+构造注入指针）
    //   .align 3（2026-09-07）：静态槽 8 对齐——槽区紧跟任意长度字符串 .byte
    //   之后，本地标签引用被 GAS 折叠成 .data+偏移，64 位 ldr/str 的 LO12
    //   重定位要求 addend 8 对齐，非对齐即链接截断失败（v2self 锚定轮实证；
    //   Rust/LLVM 对照：对齐=发射期布局契约，绝不靠链接器宽容）
    如果 (程序.静态数 > 0) {
        加行(输出, ".data");
        加行(输出, ".align 3");
        整64 g = 0;
        当 (g < 程序.静态数) {
            字符串 初始值 = "0";
            如果 (g < 程序.静态初始值们.大小()) {
                初始值 = 字符串复制(驻留文本(程序.静态初始值们.元素(g)));
            }
            加行(输出, 静态槽标签(g) + ":");
            // 87-a（2026-09-12 第八十七轮）：结构体静态槽按类型尺寸分配（原恒
            //   `.quad`=8 字节 → 整体拷贝越界写相邻 .data 符号）。8 字节取整
            //   保证后续槽对齐不变式（arm64 非对齐访存=SIGBUS 陷阱）。
            整64 静大小m = 查结构体大小(取静态类型(g));
            // 701-a 波W（三后端同步）：128 位静态槽双 quad（GAS）
            字符串 静类型文本m = 字符串复制(驻留文本(取静态类型(g)));
            如果 (字符串比较(静类型文本m, "整128") || 字符串比较(静类型文本m, "正128")) {
                整64 静低128m = 0;
                整64 静高128m = 0;
                如果 (解析128位初值文本(初始值, 静低128m, 静高128m)) {
                    加行(输出, "    .quad 0x" + 位模式十六进制(静低128m) +
                         ", 0x" + 位模式十六进制(静高128m));
                } 否则 {
                    加行(输出, "    .quad 0, 0    /* 128 位初值非法或超范围: " + 初始值 + " */");
                }
            } 否则 如果 (静大小m > 8) {
                整64 静槽数m = (静大小m + 7) / 8;
                加行(输出, "    .zero " + 整数转字符串((静大小m + 7) / 8 * 8));
            } 否则 {
                加行(输出, "    .quad " + 初始值);
            }
            g++;
        }
    }
    // 234：类 vtable 数据段（.data·.xword 方法符号——vptr 写/间接 blr 同符号式）
    整64 vq = 0;
    当 (vq < 有虚类清单数()) {
        整64 类名IDv = 有虚类清单取(vq);
        字符串 类文本v = 字符串复制(驻留文本(类名IDv));
        加行(输出, ".data");
        加行(输出, ".balign 8");
        加行(输出, 符号修饰ARM64(类虚表符号(类文本v)) + ":");
        整64 槽v = 0;
        当 (槽v < 类虚槽总数(类名IDv)) {
            整64 方法名IDv = 查虚槽方法名(类名IDv, 槽v);
            字符串 方法名v = 字符串复制(驻留文本(方法名IDv)); 字符串 参数串v = 字符串复制(驻留文本(查类方法参数串(类名IDv, 方法名IDv)));
            字符串 定义类名v332 = 虚槽定义类名(类名IDv, 槽v);
            加行(输出, "    .xword " +
                符号修饰ARM64(方法符号(定义类名v332, 方法名v, 参数串v)));
            槽v++;
        }
        vq++;
    }
    加行(输出, ".section .note.GNU-stack,\"\",@progbits");
    返回 输出;
}
