// 代码生成X64Linux窥孔（任务 1158·v2 侧·2026-10-19；1319 通用文本辅助外提）
// 职责：X64Linux 函数段发射后的行级窥孔——消除「槽死相邻 store→load 转发」。
// 规则与安全条件（宿主 1144 波2 src/cn_compiler/codegen/peephole_slot.cpp 同源）：
//   命中 = 相邻（中间仅注释/空行）的
//     store: mov [宽度 ptr] [rbp±N], rX   （浮点 movsd/movss [宽度 ptr] [rbp±N], xmmN）
//     load : mov/movsx/movzx/movsd/movss rY, [宽度 ptr] [rbp±N]
//   同槽对，且槽 token 在整个函数段中恰好出现两次（=本对两行）时：
//     · 同寄存器且同宽（整数 64 位 / 同宽浮点）→ 两行全删；
//     · 否则 → 删 store 行、load 行改写为从 store 源寄存器取值的寄存器搬运
//       （读宽 ≤ 存宽；movsx/movzx 目的保持 64 位名、源取低 W1 位形态）。
// 安全条件（缺一不可）：
//   ① 两行之间只有注释/空行（无指令——无中间值改写）；
//   ② 槽 token 全段恰好两处——不能用「本对之后无出现」：循环回边可从后文跳回
//      前文再读槽（行号=代码位置非执行序）；任意路径执行 load 必先经 store。
//   ③ 读宽 ≤ 存宽（存窄读宽时 load 高位来自槽内残留，寄存器搬运不可复现）。
//   ④ 整数/浮点族不得混；前缀宽度与寄存器宽度必须一致。
//   ⑤ 解析失败一律跳过（保守——该行原样保留，不参与消除）。
// 门控：恒开（v2 无优化档位概念·发射即最终产物；宿主 -O2 口径对齐）。
// 1319：行内字符扫描/向量薄封装等方言无关辅助已外提到 代码生成窥孔文本.cn
//   （与 代码生成ARM64窥孔.cn 共用·函数名/语义逐字不变）。
导入 容器::向量;

公开:

// 槽访问解析结果（解析函数成功时逐字段填写；失败时内容未定义、调用方不读）
结构体 窥孔槽访问 {
    整64 槽键;      // 槽偏移键：[rbp-N] -> -N；[rbp+N] -> +N；[rbp] -> 0
    整64 寄存器序;  // 整数 rax..r15=0..15；xmmN=100+N
    整64 宽;        // 8/16/32/64（浮点按助记符：movsd=64/movss=32）
    布尔 浮点;
    布尔 符号扩展;
    布尔 零扩展;
}

// ==================== 寄存器名解析/生成 ====================

// 整数寄存器名 -> 序号（0..15）/宽度（8/16/32/64）；识别失败返回假
//   静态表覆盖 GAS Intel 全整数寄存器名；解析失败=该行不参与消除（原样保留）
函数 窥孔整数寄存器(字符串 名, 整64& 序, 整64& 宽) -> 布尔 {
    整64 长 = 字符串长度(名);
    如果 (长 == 2) {
        如果 (字符串比较(名, "ax")) { 序 = 0; 宽 = 16; 返回 真; }
        如果 (字符串比较(名, "al")) { 序 = 0; 宽 = 8; 返回 真; }
        如果 (字符串比较(名, "bx")) { 序 = 1; 宽 = 16; 返回 真; }
        如果 (字符串比较(名, "bl")) { 序 = 1; 宽 = 8; 返回 真; }
        如果 (字符串比较(名, "cx")) { 序 = 2; 宽 = 16; 返回 真; }
        如果 (字符串比较(名, "cl")) { 序 = 2; 宽 = 8; 返回 真; }
        如果 (字符串比较(名, "dx")) { 序 = 3; 宽 = 16; 返回 真; }
        如果 (字符串比较(名, "dl")) { 序 = 3; 宽 = 8; 返回 真; }
        如果 (字符串比较(名, "si")) { 序 = 4; 宽 = 16; 返回 真; }
        如果 (字符串比较(名, "di")) { 序 = 5; 宽 = 16; 返回 真; }
        如果 (字符串比较(名, "bp")) { 序 = 6; 宽 = 16; 返回 真; }
        如果 (字符串比较(名, "sp")) { 序 = 7; 宽 = 16; 返回 真; }
        如果 (字符串比较(名, "r8")) { 序 = 8; 宽 = 64; 返回 真; }
        如果 (字符串比较(名, "r9")) { 序 = 9; 宽 = 64; 返回 真; }
        返回 假;
    }
    如果 (长 == 3) {
        如果 (字符串比较(名, "rax")) { 序 = 0; 宽 = 64; 返回 真; }
        如果 (字符串比较(名, "rbx")) { 序 = 1; 宽 = 64; 返回 真; }
        如果 (字符串比较(名, "rcx")) { 序 = 2; 宽 = 64; 返回 真; }
        如果 (字符串比较(名, "rdx")) { 序 = 3; 宽 = 64; 返回 真; }
        如果 (字符串比较(名, "rsi")) { 序 = 4; 宽 = 64; 返回 真; }
        如果 (字符串比较(名, "rdi")) { 序 = 5; 宽 = 64; 返回 真; }
        如果 (字符串比较(名, "rbp")) { 序 = 6; 宽 = 64; 返回 真; }
        如果 (字符串比较(名, "rsp")) { 序 = 7; 宽 = 64; 返回 真; }
        如果 (字符串比较(名, "eax")) { 序 = 0; 宽 = 32; 返回 真; }
        如果 (字符串比较(名, "ebx")) { 序 = 1; 宽 = 32; 返回 真; }
        如果 (字符串比较(名, "ecx")) { 序 = 2; 宽 = 32; 返回 真; }
        如果 (字符串比较(名, "edx")) { 序 = 3; 宽 = 32; 返回 真; }
        如果 (字符串比较(名, "esi")) { 序 = 4; 宽 = 32; 返回 真; }
        如果 (字符串比较(名, "edi")) { 序 = 5; 宽 = 32; 返回 真; }
        如果 (字符串比较(名, "ebp")) { 序 = 6; 宽 = 32; 返回 真; }
        如果 (字符串比较(名, "esp")) { 序 = 7; 宽 = 32; 返回 真; }
        如果 (字符串比较(名, "sil")) { 序 = 4; 宽 = 8; 返回 真; }
        如果 (字符串比较(名, "dil")) { 序 = 5; 宽 = 8; 返回 真; }
        如果 (字符串比较(名, "bpl")) { 序 = 6; 宽 = 8; 返回 真; }
        如果 (字符串比较(名, "spl")) { 序 = 7; 宽 = 8; 返回 真; }
        如果 (字符串比较(名, "r10")) { 序 = 10; 宽 = 64; 返回 真; }
        如果 (字符串比较(名, "r11")) { 序 = 11; 宽 = 64; 返回 真; }
        如果 (字符串比较(名, "r12")) { 序 = 12; 宽 = 64; 返回 真; }
        如果 (字符串比较(名, "r13")) { 序 = 13; 宽 = 64; 返回 真; }
        如果 (字符串比较(名, "r14")) { 序 = 14; 宽 = 64; 返回 真; }
        如果 (字符串比较(名, "r15")) { 序 = 15; 宽 = 64; 返回 真; }
        如果 (字符串比较(名, "r8d")) { 序 = 8; 宽 = 32; 返回 真; }
        如果 (字符串比较(名, "r9d")) { 序 = 9; 宽 = 32; 返回 真; }
        如果 (字符串比较(名, "r8w")) { 序 = 8; 宽 = 16; 返回 真; }
        如果 (字符串比较(名, "r9w")) { 序 = 9; 宽 = 16; 返回 真; }
        如果 (字符串比较(名, "r8b")) { 序 = 8; 宽 = 8; 返回 真; }
        如果 (字符串比较(名, "r9b")) { 序 = 9; 宽 = 8; 返回 真; }
        返回 假;
    }
    如果 (长 == 4) {
        如果 (字符串比较(名, "r10d")) { 序 = 10; 宽 = 32; 返回 真; }
        如果 (字符串比较(名, "r11d")) { 序 = 11; 宽 = 32; 返回 真; }
        如果 (字符串比较(名, "r12d")) { 序 = 12; 宽 = 32; 返回 真; }
        如果 (字符串比较(名, "r13d")) { 序 = 13; 宽 = 32; 返回 真; }
        如果 (字符串比较(名, "r14d")) { 序 = 14; 宽 = 32; 返回 真; }
        如果 (字符串比较(名, "r15d")) { 序 = 15; 宽 = 32; 返回 真; }
        如果 (字符串比较(名, "r10w")) { 序 = 10; 宽 = 16; 返回 真; }
        如果 (字符串比较(名, "r11w")) { 序 = 11; 宽 = 16; 返回 真; }
        如果 (字符串比较(名, "r12w")) { 序 = 12; 宽 = 16; 返回 真; }
        如果 (字符串比较(名, "r13w")) { 序 = 13; 宽 = 16; 返回 真; }
        如果 (字符串比较(名, "r14w")) { 序 = 14; 宽 = 16; 返回 真; }
        如果 (字符串比较(名, "r15w")) { 序 = 15; 宽 = 16; 返回 真; }
        如果 (字符串比较(名, "r10b")) { 序 = 10; 宽 = 8; 返回 真; }
        如果 (字符串比较(名, "r11b")) { 序 = 11; 宽 = 8; 返回 真; }
        如果 (字符串比较(名, "r12b")) { 序 = 12; 宽 = 8; 返回 真; }
        如果 (字符串比较(名, "r13b")) { 序 = 13; 宽 = 8; 返回 真; }
        如果 (字符串比较(名, "r14b")) { 序 = 14; 宽 = 8; 返回 真; }
        如果 (字符串比较(名, "r15b")) { 序 = 15; 宽 = 8; 返回 真; }
        返回 假;
    }
    返回 假;
}

// 浮点寄存器名 xmmN -> 序号（100+N）；非 xmm 返回 无值（880 批5 结果化）
函数 窥孔浮点寄存器(字符串 名) -> 可选<整64> {
    整64 长 = 字符串长度(名);
    布尔 前缀成 = 窥孔子串比较(名, 0, "xmm");
    如果 (!前缀成) { 返回 无; }
    布尔 长度合法 = (长 == 4 || 长 == 5);
    如果 (!长度合法) { 返回 无; }
    整64 序 = 0;
    整64 i = 3;
    当 (i < 长) {
        整64 c = 整64(名[i]);
        布尔 数字 = (c >= 48 && c <= 57);
        如果 (!数字) { 返回 无; }
        序 = 序 * 10 + (c - 48);
        i++;
    }
    布尔 序合法 = (序 >= 0 && 序 <= 15);
    如果 (!序合法) { 返回 无; }
    返回 某些(100 + 序);
}

// 整数寄存器序号+宽度 -> 名称（用于改写行；调用方保证 序∈0..15/宽∈{8,16,32,64}）
函数 窥孔整数名(整64 序, 整64 宽) -> 字符串 {
    如果 (序 == 0) {
        如果 (宽 == 64) { 返回 "rax"; }
        否则 如果 (宽 == 32) { 返回 "eax"; }
        否则 如果 (宽 == 16) { 返回 "ax"; }
        否则 如果 (宽 == 8) { 返回 "al"; }
    } 否则 如果 (序 == 1) {
        如果 (宽 == 64) { 返回 "rbx"; }
        否则 如果 (宽 == 32) { 返回 "ebx"; }
        否则 如果 (宽 == 16) { 返回 "bx"; }
        否则 如果 (宽 == 8) { 返回 "bl"; }
    } 否则 如果 (序 == 2) {
        如果 (宽 == 64) { 返回 "rcx"; }
        否则 如果 (宽 == 32) { 返回 "ecx"; }
        否则 如果 (宽 == 16) { 返回 "cx"; }
        否则 如果 (宽 == 8) { 返回 "cl"; }
    } 否则 如果 (序 == 3) {
        如果 (宽 == 64) { 返回 "rdx"; }
        否则 如果 (宽 == 32) { 返回 "edx"; }
        否则 如果 (宽 == 16) { 返回 "dx"; }
        否则 如果 (宽 == 8) { 返回 "dl"; }
    } 否则 如果 (序 == 4) {
        如果 (宽 == 64) { 返回 "rsi"; }
        否则 如果 (宽 == 32) { 返回 "esi"; }
        否则 如果 (宽 == 16) { 返回 "si"; }
        否则 如果 (宽 == 8) { 返回 "sil"; }
    } 否则 如果 (序 == 5) {
        如果 (宽 == 64) { 返回 "rdi"; }
        否则 如果 (宽 == 32) { 返回 "edi"; }
        否则 如果 (宽 == 16) { 返回 "di"; }
        否则 如果 (宽 == 8) { 返回 "dil"; }
    } 否则 如果 (序 == 6) {
        如果 (宽 == 64) { 返回 "rbp"; }
        否则 如果 (宽 == 32) { 返回 "ebp"; }
        否则 如果 (宽 == 16) { 返回 "bp"; }
        否则 如果 (宽 == 8) { 返回 "bpl"; }
    } 否则 如果 (序 == 7) {
        如果 (宽 == 64) { 返回 "rsp"; }
        否则 如果 (宽 == 32) { 返回 "esp"; }
        否则 如果 (宽 == 16) { 返回 "sp"; }
        否则 如果 (宽 == 8) { 返回 "spl"; }
    } 否则 如果 (序 >= 8 && 序 <= 15) {
        字符串 号 = 整数转字符串(序);
        如果 (宽 == 64) { 返回 "r" + 号; }
        否则 如果 (宽 == 32) { 返回 "r" + 号 + "d"; }
        否则 如果 (宽 == 16) { 返回 "r" + 号 + "w"; }
        否则 如果 (宽 == 8) { 返回 "r" + 号 + "b"; }
    }
    // 内部缺陷显形：调用方契约=解析器输出闭集（序 0..15 / 宽 8/16/32/64）
    运行时错误(4);
    返回 "";
}

// 浮点寄存器序号 -> 名称（xmmN；调用方保证 序∈100..115）
函数 窥孔浮点名(整64 序) -> 字符串 {
    布尔 序合法 = (序 >= 100 && 序 <= 115);
    如果 (!序合法) { 运行时错误(4); }
    返回 "xmm" + 整数转字符串(序 - 100);
}

// ==================== 槽 token 解析 ====================

// 解析行内槽 token（起=“[" 索引，槽终=“]” 索引）为偏移键
//   [rbp-N] -> -N；[rbp+N] -> +N；[rbp] -> 0；其余形态返回假（不参与消除）
函数 窥孔解析槽键(字符串 行, 整64 起, 整64 槽终, 整64& 键) -> 布尔 {
    如果 (槽终 == 起 + 4) { 键 = 0; 返回 真; }   // "[rbp]"
    布尔 有偏移 = (槽终 > 起 + 4);
    如果 (!有偏移) { 返回 假; }
    整64 号 = 整64(行[起 + 4]);
    布尔 负 = (号 == 45);   // '-'
    布尔 正 = (号 == 43);   // '+'
    如果 (!负 && !正) { 返回 假; }
    整64 数起 = 起 + 5;
    布尔 数域合法 = (数起 >= 0 && 数起 < 槽终);
    如果 (!数域合法) { 返回 假; }
    整64 值 = 0;
    整64 i = 数起;
    当 (i < 槽终) {
        整64 d = 整64(行[i]);
        布尔 数字 = (d >= 48 && d <= 57);
        如果 (!数字) { 返回 假; }
        值 = 值 * 10 + (d - 48);
        i++;
    }
    如果 (负) { 键 = 0 - 值; }
    如果 (正) { 键 = 值; }
    返回 真;
}

// 解析宽度前缀（"qword ptr " 等），返回宽度（0=无前缀）；命中时推进 位置
函数 窥孔宽度前缀(字符串 行, 整64 起, 整64& 位置) -> 整64 {
    如果 (窥孔子串比较(行, 起, "qword ptr ")) { 位置 = 起 + 10; 返回 64; }
    如果 (窥孔子串比较(行, 起, "dword ptr ")) { 位置 = 起 + 10; 返回 32; }
    如果 (窥孔子串比较(行, 起, "word ptr ")) { 位置 = 起 + 9; 返回 16; }
    如果 (窥孔子串比较(行, 起, "byte ptr ")) { 位置 = 起 + 9; 返回 8; }
    位置 = 起;
    返回 0;
}

// 解析一行内的槽 token 段（起=“[” 索引），返回槽右括号索引（无值=失败）
//   880 批5：-1 哨兵→可选<整64>（公共透传节点随 窥孔找字符 结果化）
函数 窥孔槽右界(字符串 行, 整64 起) -> 可选<整64> {
    返回 窥孔找字符(行, ']', 起 + 4);
}

// 填充访问结构体的公共字段（槽键）；失败返回假
函数 窥孔填槽(字符串 行, 整64 槽起, 窥孔槽访问& 访问) -> 布尔 {
    可选<整64> 右查 = 窥孔槽右界(行, 槽起);
    如果 (!右查.有值) { 返回 假; }
    整64 右 = 右查.值;
    整64 键 = 0;
    如果 (!窥孔解析槽键(行, 槽起, 右, 键)) { 返回 假; }
    访问.槽键 = 键;
    返回 真;
}

// ==================== store/load 行解析 ====================

// 解析 store 行：mov [宽度 ptr] [rbp±N], reg（浮点 movsd/movss [宽度 ptr] [rbp±N], xmmN）
//   宽度规则（宿主同源）：无前缀时=寄存器宽；有前缀时须与寄存器宽一致；
//   浮点助记符宽度（movsd=64/movss=32）须与前缀（若有）一致。
函数 窥孔解析储存行(字符串 行, 窥孔槽访问& 访问) -> 布尔 {
    访问.槽键 = 0; 访问.寄存器序 = 0; 访问.宽 = 0;
    访问.浮点 = 假; 访问.符号扩展 = 假; 访问.零扩展 = 假;
    整64 长 = 字符串长度(行);
    整64 起 = 窥孔跳空白(行, 0);
    整64 名终 = 窥孔记号终(行, 起);
    整64 名长 = 名终 - 起;
    布尔 是mov = (名长 == 3) && 窥孔子串比较(行, 起, "mov");
    布尔 是sd = (名长 == 5) && 窥孔子串比较(行, 起, "movsd");
    布尔 是ss = (名长 == 5) && 窥孔子串比较(行, 起, "movss");
    布尔 助记合法 = 是mov || 是sd || 是ss;
    如果 (!助记合法) { 返回 假; }
    布尔 浮点助记 = 是sd || 是ss;
    整64 助记宽 = 0;
    如果 (是sd) { 助记宽 = 64; }
    如果 (是ss) { 助记宽 = 32; }
    整64 位置 = 窥孔跳空白(行, 名终);
    整64 槽起 = 位置;
    整64 前缀宽 = 窥孔宽度前缀(行, 位置, 槽起);
    布尔 槽头成 = 窥孔子串比较(行, 槽起, "[rbp");
    如果 (!槽头成) { 返回 假; }
    如果 (!窥孔填槽(行, 槽起, 访问)) { 返回 假; }
    // 填槽成功已证明槽右界命中（同函数内同起点的无值=不可达，显式拒绝不静默）
    可选<整64> 槽终查 = 窥孔槽右界(行, 槽起);
    如果 (!槽终查.有值) { 返回 假; }
    整64 槽终 = 槽终查.值;
    整64 尾 = 窥孔跳空白(行, 槽终 + 1);
    布尔 逗号成 = (尾 < 长) && 整64(行[尾]) == 44;
    如果 (!逗号成) { 返回 假; }
    尾 = 窥孔跳空白(行, 尾 + 1);
    整64 尾终 = 窥孔记号终(行, 尾);
    布尔 尾合法 = (尾终 == 长 && 尾 < 长);
    如果 (!尾合法) { 返回 假; }
    字符串 寄存器名 = 字符串子串(行, 尾, 尾终 - 尾);
    整64 序 = 0;
    整64 宽 = 0;
    布尔 整数成 = 窥孔整数寄存器(寄存器名, 序, 宽);
    整64 浮点序 = 0 - 1;
    可选<整64> 浮点序查 = 窥孔浮点寄存器(寄存器名);
    // 无值（原 -1 哨兵）与 0..99 同假——原 100..115 判定逐字保留
    如果 (浮点序查.有值) { 浮点序 = 浮点序查.值; }
    布尔 浮点成 = (浮点序 >= 100 && 浮点序 <= 115);
    布尔 寄存器成 = 整数成 || 浮点成;
    如果 (!寄存器成) { 返回 假; }
    如果 (浮点助记 && !浮点成) { 返回 假; }
    如果 (!浮点助记 && !整数成) { 返回 假; }
    如果 (浮点助记) {
        如果 (前缀宽 != 0 && 前缀宽 != 助记宽) { 返回 假; }
        访问.寄存器序 = 浮点序;
        访问.宽 = 助记宽;
        访问.浮点 = 真;
        返回 真;
    }
    如果 (前缀宽 != 0 && 前缀宽 != 宽) { 返回 假; }
    访问.寄存器序 = 序;
    访问.宽 = 宽;
    访问.浮点 = 假;
    返回 真;
}

// 解析 load 行：mov/movsx/movzx/movsd/movss dst, [宽度 ptr] [rbp±N]
//   宽度规则（宿主同源）：
//     movsx/movzx：前缀宽须 8/16 且目的寄存器宽须 64；无前缀=识别失败；
//     mov：无前缀时=寄存器宽，有前缀时须一致；
//     movsd/movss：助记宽须与前缀（若有）一致，目的须浮点寄存器。
函数 窥孔解析装载行(字符串 行, 窥孔槽访问& 访问) -> 布尔 {
    访问.槽键 = 0; 访问.寄存器序 = 0; 访问.宽 = 0;
    访问.浮点 = 假; 访问.符号扩展 = 假; 访问.零扩展 = 假;
    整64 长 = 字符串长度(行);
    整64 起 = 窥孔跳空白(行, 0);
    整64 名终 = 窥孔记号终(行, 起);
    布尔 是mov = 窥孔子串比较(行, 起, "mov") && (名终 - 起 == 3);
    布尔 是sx = 窥孔子串比较(行, 起, "movsx") && (名终 - 起 == 5);
    布尔 是zx = 窥孔子串比较(行, 起, "movzx") && (名终 - 起 == 5);
    布尔 是sd = 窥孔子串比较(行, 起, "movsd") && (名终 - 起 == 5);
    布尔 是ss = 窥孔子串比较(行, 起, "movss") && (名终 - 起 == 5);
    布尔 助记合法 = 是mov || 是sx || 是zx || 是sd || 是ss;
    如果 (!助记合法) { 返回 假; }
    布尔 浮点助记 = 是sd || 是ss;
    整64 助记宽 = 0;
    如果 (是sd) { 助记宽 = 64; }
    如果 (是ss) { 助记宽 = 32; }
    整64 位置 = 窥孔跳空白(行, 名终);
    可选<整64> 逗查 = 窥孔找字符(行, ',', 位置);
    如果 (!逗查.有值) { 返回 假; }
    整64 逗 = 逗查.值;
    字符串 目标名 = 字符串子串(行, 位置, 逗 - 位置);
    布尔 目标有空白 = 窥孔含空白(目标名);
    如果 (目标有空白) { 返回 假; }
    整64 目标序 = 0;
    整64 目标宽 = 0;
    布尔 目标整数成 = 窥孔整数寄存器(目标名, 目标序, 目标宽);
    整64 目标浮点序 = 0 - 1;
    可选<整64> 目标浮点序查 = 窥孔浮点寄存器(目标名);
    // 无值（原 -1 哨兵）与 0..99 同假——原 100..115 判定逐字保留
    如果 (目标浮点序查.有值) { 目标浮点序 = 目标浮点序查.值; }
    布尔 目标浮点成 = (目标浮点序 >= 100 && 目标浮点序 <= 115);
    布尔 目标成 = 目标整数成 || 目标浮点成;
    如果 (!目标成) { 返回 假; }
    如果 (浮点助记 && !目标浮点成) { 返回 假; }
    如果 (!浮点助记 && !目标整数成) { 返回 假; }
    整64 槽起 = 窥孔跳空白(行, 逗 + 1);
    整64 前缀宽 = 窥孔宽度前缀(行, 槽起, 槽起);
    布尔 槽头成 = 窥孔子串比较(行, 槽起, "[rbp");
    如果 (!槽头成) { 返回 假; }
    如果 (!窥孔填槽(行, 槽起, 访问)) { 返回 假; }
    // 填槽成功已证明槽右界命中（同函数内同起点的无值=不可达，显式拒绝不静默）
    可选<整64> 槽终查 = 窥孔槽右界(行, 槽起);
    如果 (!槽终查.有值) { 返回 假; }
    整64 槽终 = 槽终查.值;
    整64 尾 = 窥孔跳空白(行, 槽终 + 1);
    布尔 尾净 = (尾 == 长);
    如果 (!尾净) { 返回 假; }
    如果 (浮点助记) {
        如果 (前缀宽 != 0 && 前缀宽 != 助记宽) { 返回 假; }
        访问.寄存器序 = 目标浮点序;
        访问.宽 = 助记宽;
        访问.浮点 = 真;
        返回 真;
    }
    如果 (是sx || 是zx) {
        布尔 前缀合法 = (前缀宽 == 8 || 前缀宽 == 16);
        如果 (!前缀合法) { 返回 假; }
        如果 (目标宽 != 64) { 返回 假; }
        访问.寄存器序 = 目标序;
        访问.宽 = 前缀宽;
        访问.浮点 = 假;
        访问.符号扩展 = 是sx;
        访问.零扩展 = 是zx;
        返回 真;
    }
    如果 (前缀宽 != 0 && 前缀宽 != 目标宽) { 返回 假; }
    访问.寄存器序 = 目标序;
    访问.宽 = 目标宽;
    访问.浮点 = 假;
    返回 真;
}

// 注释/空行判定（窥孔配对可跨过的无执行语义行）
函数 窥孔是注释或空(字符串 行) -> 布尔 {
    整64 起 = 窥孔跳空白(行, 0);
    整64 长 = 字符串长度(行);
    如果 (起 == 长) { 返回 真; }
    布尔 双斜 = 窥孔子串比较(行, 起, "//");
    布尔 分号 = 窥孔子串比较(行, 起, ";");
    布尔 块注 = 窥孔子串比较(行, 起, "/*") || 窥孔子串比较(行, 起, "*");
    返回 双斜 || 分号 || 块注;
}

// ==================== 消除与改写 ====================

// 改写 load 行为从 store 源寄存器取值的寄存器搬运（调用方保证 读宽≤存宽）
函数 窥孔改写装载行(窥孔槽访问 存, 窥孔槽访问 载) -> 字符串 {
    如果 (载.符号扩展 || 载.零扩展) {
        字符串 助记 = "movzx";
        如果 (载.符号扩展) { 助记 = "movsx"; }
        返回 "    " + 助记 + " " + 窥孔整数名(载.寄存器序, 64) + ", " +
               窥孔整数名(存.寄存器序, 载.宽);
    }
    如果 (载.浮点) {
        字符串 助记浮 = "movss";
        如果 (载.宽 == 64) { 助记浮 = "movsd"; }
        返回 "    " + 助记浮 + " " + 窥孔浮点名(载.寄存器序) + ", " +
               窥孔浮点名(存.寄存器序);
    }
    返回 "    mov " + 窥孔整数名(载.寄存器序, 载.宽) + ", " +
           窥孔整数名(存.寄存器序, 载.宽);
}

// 全删判定：同寄存器且同宽（整数 64 位 / 同宽浮点）——删除后寄存器值即 load 语义
函数 窥孔可全删(窥孔槽访问 存, 窥孔槽访问 载) -> 布尔 {
    布尔 同序 = (存.寄存器序 == 载.寄存器序);
    如果 (!同序) { 返回 假; }
    如果 (存.浮点) { 返回 载.宽 == 存.宽; }
    返回 (载.宽 == 64 && 存.宽 == 64);
}

// 槽键在统计表中的出现次数是否恰为 2（非法/未命中=假——保守不消除）
函数 窥孔槽仅两处(映射<整64, 整64>& 计数, 整64 键) -> 布尔 {
    如果 (!计数.包含(键)) { 返回 假; }
    结果<整64, 整32> 查 = 计数.获取(键);
    如果 (查.正常) { 返回 查.值 == 2; } 否则 {
    }
    // 包含为真后获取必成——失败=映射实现契约破坏（内部缺陷显形）
    运行时错误(4);
    返回 假;
}

// 统计函数段内槽出现次数（键=偏移·任何形式（读/写/取址/注释提及）一律计入——
//   宿主保守口径；无法解析的槽形态跳过——不会与候选对槽键相同）
不安全 函数 窥孔统计槽(向量<字符串> 输出, 整64 段起, 整64 段终,
                     映射<整64, 整64>& 计数) -> 空类型 {
    整64 行i = 段起;
    当 (行i < 段终) {
        字符串 行 = 输出.元素(整32(行i));
        整64 行长 = 字符串长度(行);
        整64 位置 = 0;
        当 (位置 < 行长) {
            可选<整64> 命中查 = 窥孔查子串(行, "[rbp", 位置);
            整64 命中 = 0;
            如果 (命中查.有值) { 命中 = 命中查.值; }
            如果 (!命中查.有值) { 中断; }
            可选<整64> 右查 = 窥孔槽右界(行, 命中);
            整64 右 = 0;
            如果 (右查.有值) { 右 = 右查.值; }
            // #1582：右界无值=该锚点之后本行再无 ']'——续扫后续锚点而非中断
            //   本行（不留「每行至多一个执行槽」隐性前提；当前找字符实现下续扫
            //   与中断统计等价，右界口径若收紧形态校验则中断会漏计同键后文槽
            //   →「槽仅两处」误判→误删 store）。
            如果 (!右查.有值) { 位置 = 命中 + 4; 继续; }
            整64 键 = 0;
            布尔 键成 = 窥孔解析槽键(行, 命中, 右, 键);
            如果 (键成) {
                整64 旧 = 0;
                如果 (计数.包含(键)) {
                    结果<整64, 整32> 查 = 计数.获取(键);
                    如果 (查.正常) { 旧 = 查.值; }
                    否则 如果 (!查.正常) { 运行时错误(4); }
                }
                结果<空类型, 整32> 设 = 计数.设置(键, 旧 + 1);
                如果 (!设.正常) { 运行时错误(4); }
            }
            位置 = 右 + 1;
        }
        行i++;
    }
}

// 向量追加/设置辅助已外提 代码生成窥孔文本.cn（1319）。

// 单段处理：槽统计 + 相邻 store→load 对标记（动作/改行=全局行号索引·
//   本段行区间 [段起,段终) 内只读扫描，写入全局动作表）。
不安全 函数 窥孔处理段X64L(向量<字符串> 输出, 整64 段起, 整64 段终,
                    向量<整64>& 动作, 向量<字符串>& 改行) -> 空类型 {
    映射<整64, 整64> 计数 = 映射<整64, 整64>();
    窥孔统计槽(输出, 段起, 段终, 计数);
    整64 q = 段起;
    当 (q + 1 < 段终) {
        字符串 首行 = 输出.元素(整32(q));
        窥孔槽访问 存;
        布尔 存成 = 窥孔解析储存行(首行, 存);
        布尔 命中 = 假;
        整64 次 = q + 1;
        如果 (存成) {
            当 (次 < 段终) {
                字符串 候选 = 输出.元素(整32(次));
                布尔 可跨 = 窥孔是注释或空(候选);
                如果 (可跨) { 次++; }
                如果 (!可跨) { 中断; }
            }
            如果 (次 < 段终) {
                窥孔槽访问 载;
                布尔 载成 = 窥孔解析装载行(输出.元素(整32(次)), 载);
                布尔 同槽 = (存.槽键 == 载.槽键);
                布尔 同族 = (存.浮点 == 载.浮点);
                布尔 宽可达 = (载.宽 >= 8 && 载.宽 <= 存.宽);
                布尔 槽死 = 窥孔槽仅两处(计数, 存.槽键);
                布尔 全部满足 = 载成 && 同槽 && 同族 && 宽可达 && 槽死;
                如果 (全部满足) {
                    命中 = 真;
                    窥孔设整(动作, q, 1);
                    布尔 全删 = 窥孔可全删(存, 载);
                    如果 (全删) {
                        窥孔设整(动作, 次, 1);
                    } 否则 如果 (!全删) {
                        窥孔设整(动作, 次, 2);
                        窥孔设串(改行, 次, 窥孔改写装载行(存, 载));
                    }
                }
            }
        }
        如果 (命中) { q = 次 + 1; }
        否则 如果 (!命中) { q++; }
    }
}

// 主入口：全模块函数段槽转发消除（全部函数生成完成后一次性调用）——
//   段统计在未压缩行号上完成（生成期以 输出.大小() 命名的标签 npok_*/opok_*/
//   err_* 依赖行号全局唯一，段内即时压缩会使后续函数行号回退=标签撞名）；
//   标记完成后对全向量做一次 O(总行数) 压缩（写<=读恒成立），末尾删多余行。
不安全 函数 窥孔槽转发全模块X64L(向量<字符串> 输出, 向量<整64> 段起们,
                         向量<整64> 段终们) -> 空类型 {
    整64 总行数 = 输出.大小();
    布尔 范围合法 = (段起们.大小() == 段终们.大小() && 段起们.大小() <= 总行数);
    如果 (!范围合法) { 运行时错误(4); }
    向量<整64> 动作 = 向量<整64>();   // 0=保留 1=删除 2=改写
    向量<字符串> 改行 = 向量<字符串>();
    整64 初始化 = 0;
    当 (初始化 < 总行数) {
        窥孔压整(动作, 0);
        窥孔压串(改行, "");
        初始化++;
    }
    整64 段i = 0;
    当 (段i < 段起们.大小()) {
        整64 段起 = 段起们.元素(整32(段i));
        整64 段终 = 段终们.元素(整32(段i));
        布尔 段合法 = (段起 >= 0 && 段起 <= 段终 && 段终 <= 总行数);
        如果 (!段合法) { 运行时错误(4); }
        窥孔处理段X64L(输出, 段起, 段终, 动作, 改行);
        段i++;
    }
    // 全局压缩：动作=保留/改写直接写回，末尾多余行逐个删除
    整64 读 = 0;
    整64 写 = 0;
    当 (读 < 总行数) {
        整64 动 = 动作.元素(整32(读));
        如果 (动 == 1) {
            读++;
        } 否则 如果 (动 == 2) {
            窥孔设串(输出, 写, 改行.元素(整32(读)));
            写++;
            读++;
        } 否则 如果 (动 == 0) {
            如果 (读 != 写) {
                窥孔设串(输出, 写, 输出.元素(整32(读)));
            }
            写++;
            读++;
        } 否则 {
            运行时错误(4);
        }
    }
    当 (输出.大小() > 写) {
        结果<空类型, 整32> 删 = 输出.删除(输出.大小() - 1);
        如果 (!删.正常) { 运行时错误(4); }
    }
}
