// 代码生成窥孔文本（任务 1319·v2 侧·2026-10-25）
// 职责：行级窥孔共用文本辅助（后端方言无关）——空白/记号/子串扫描与向量
//   追加/设置薄封装。自 代码生成X64Linux窥孔.cn 机械搬移（1158 原文逐字保留），
//   X64Linux 与 ARM64 两套窥孔共用（重复归纳·第三处出现前提炼）。
// 设计：全部扫描逐字符无分配（窥孔跑在整模块汇编文本上·分配开销直接计入
//   编译器自身性能）；改写行拼接只发生在命中的少量行。
// 解析失败一律返回 假/无值——调用方按「不参与消除·原样保留」分流（不是静默
//   默认值：该行不优化即语义不变）。
导入 容器::向量;

公开:

// 跳过行内空白（空格=32 / 制表=9），返回首个非空白索引
函数 窥孔跳空白(字符串 行, 整64 起) -> 整64 {
    整64 长 = 字符串长度(行);
    整64 i = 起;
    当 (i < 长) {
        整64 c = 整64(行[i]);
        布尔 是空白 = (c == 32 || c == 9);
        如果 (是空白) { i++; }
        如果 (!是空白) { 返回 i; }
    }
    返回 长;
}

// 从 起 扫描到空白/行尾，返回记号结束索引
函数 窥孔记号终(字符串 行, 整64 起) -> 整64 {
    整64 长 = 字符串长度(行);
    整64 i = 起;
    当 (i < 长) {
        整64 c = 整64(行[i]);
        布尔 是空白 = (c == 32 || c == 9);
        如果 (是空白) { 返回 i; }
        i++;
    }
    返回 长;
}

// 行内子串比较（不分配）：行[起, 起+目标长) == 目标
函数 窥孔子串比较(字符串 行, 整64 起, 字符串 目标) -> 布尔 {
    整64 行长度 = 字符串长度(行);
    整64 目标长 = 字符串长度(目标);
    布尔 范围合法 = (起 >= 0 && 起 + 目标长 <= 行长度);
    如果 (范围合法 == 假) { 返回 假; }
    整64 i = 0;
    当 (i < 目标长) {
        布尔 同 = 整64(行[起 + i]) == 整64(目标[i]);
        如果 (同 == 假) { 返回 假; }
        i++;
    }
    返回 真;
}

// 行内区间比较（不分配）：行[起, 终) == 目标（长度必须相等）
函数 窥孔区间比较(字符串 行, 整64 起, 整64 终, 字符串 目标) -> 布尔 {
    整64 行长度 = 字符串长度(行);
    整64 目标长 = 字符串长度(目标);
    布尔 长度同 = (终 - 起 == 目标长);
    如果 (长度同 == 假) { 返回 假; }
    布尔 域合法 = (起 >= 0 && 终 <= 行长度);
    如果 (域合法 == 假) { 返回 假; }
    整64 i = 0;
    当 (i < 目标长) {
        布尔 同 = 整64(行[起 + i]) == 整64(目标[i]);
        如果 (同 == 假) { 返回 假; }
        i++;
    }
    返回 真;
}

// 从 起 找字符 目标（码点比较），返回索引；未命中返回 无值（880 批5 结果化）
函数 窥孔找字符(字符串 行, 字符 目标, 整64 起) -> 可选<整64> {
    整64 长 = 字符串长度(行);
    整64 目标码 = 整64(目标);
    整64 i = 起;
    当 (i < 长) {
        如果 (整64(行[i]) == 目标码) { 返回 某些(i); }
        i++;
    }
    返回 无;
}

// 从 起 找子串 目标（逐字符比较），返回索引；未命中返回 无值（880 批5 结果化）
函数 窥孔查子串(字符串 行, 字符串 目标, 整64 起) -> 可选<整64> {
    整64 行长度 = 字符串长度(行);
    整64 目标长 = 字符串长度(目标);
    布尔 目标空 = (目标长 >= 0 && 目标长 <= 0);
    如果 (目标空) { 返回 无; }
    整64 i = 起;
    当 (i + 目标长 <= 行长度) {
        如果 (窥孔子串比较(行, i, 目标)) { 返回 某些(i); }
        i++;
    }
    返回 无;
}

// 文本内是否含空白（目标寄存器记号约束：不得含空格/制表）
函数 窥孔含空白(字符串 文本) -> 布尔 {
    整64 长 = 字符串长度(文本);
    整64 i = 0;
    当 (i < 长) {
        整64 c = 整64(文本[i]);
        布尔 是空白 = (c == 32 || c == 9);
        如果 (是空白) { 返回 真; }
        i++;
    }
    返回 假;
}

// 向量追加辅助（错误一律内部错误显形——与既有发射族同款）
不安全 函数 窥孔压整(向量<整64>& 目标, 整64 值) -> 空类型 {
    结果<空类型, 整32> 加 = 目标.追加(值);
    如果 (!加.正常) { 运行时错误(4); }
}

不安全 函数 窥孔压串(向量<字符串>& 目标, 字符串 值) -> 空类型 {
    结果<空类型, 整32> 加 = 目标.追加(值);
    如果 (!加.正常) { 运行时错误(4); }
}

不安全 函数 窥孔设整(向量<整64>& 目标, 整64 位置, 整64 值) -> 空类型 {
    结果<空类型, 整32> 设 = 目标.设置(整32(位置), 值);
    如果 (!设.正常) { 运行时错误(4); }
}

不安全 函数 窥孔设串(向量<字符串>& 目标, 整64 位置, 字符串 值) -> 空类型 {
    结果<空类型, 整32> 设 = 目标.设置(整32(位置), 值);
    如果 (!设.正常) { 运行时错误(4); }
}
