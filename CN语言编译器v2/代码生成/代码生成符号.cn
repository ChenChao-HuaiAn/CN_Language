// CN 自举编译器 v2：结构化代码生成器——win-x64 MASM 后端（自举重建 P6，2026-08-25）
// 后端架构方案1（用户裁决 2026-09-02）：本文件只保留"平台发射"——助记符/寄存器名/
//   MASM 符号修饰/段指令；帧扫描、槽偏移、调用编址、标签唯一化、字符串收集等
//   平台无关决策统一在 代码生成共用.cn（双后端单点维护，第三平台只需纯发射器）。
// 平台发射约定：
//   - 虚拟寄存器 r -> [rbp-8r-8]；变量槽 s -> [rbp-8*(最大寄存器+s)-8]；
//   - 函数框架：PROC 名 PROC / push rbp / mov rbp,rsp / sub rsp,帧大小 /
//     指令 / mov rsp,rbp / pop rbp / ret / 名 ENDP；
//   - Win x64 参数装载：前 4 参数 rcx/rdx/r8/r9 -> 参数槽；标量返回 rax；
//     位<4 走 rcx/rdx/r8/r9、影子空间 32、被调方 [rbp+48+(位-4)*8]。

导入 容器::向量;
导入 IR;           // IR 指令/容器判定/操作码（原 IR生成+IR容器+IR常量 合并目录包名）
导入 协议常量;   // 335 重构B：协议常量独立包
导入 代码生成;     // 后端共用决策层（原 代码生成共用；同包包名幂等加载）

公开:
// D1 行数整改 121-a：自 代码生成.cn 按族拆出——符号修饰族（符号修饰 + 超长收缩 + 符号修饰实现 + 常量立即数文本 + 寄存器槽 + 变量槽 + 参数寄存器名 + 生成指令）（纯重构零行为变更）

// ==================== 符号修饰（MASM，对标 C++ nameMangle） ====================

// 对外单点（宿主 nameMangle -> shortenLongSymbol 同构包裹，2026-09-09 第四十一
//   轮）：先完整修饰再超长收缩——PROC/ENDP/call/EXTERN/虚表/静态全部引用
//   经本函数，收缩一致性单点保证
函数 符号修饰(字符串 名) -> 字符串 {
    返回 超长收缩(符号修饰实现(名));
}

// 超长符号收缩（宿主 shortenLongSymbol 逐字节同构，2026-09-09 第四十一轮）：
//   MASM 247 标识符硬上限（A2043 失效形态=PROC 配对崩坏→A2005 雪崩，lessons
//   第四十轮权重10——宿主同轮根治，v2 侧探针实证 319 字符符号 ml64 rc=1）。
//   >200 收缩为「头段180$L<原长>H<FNV-1a64 十六位大写hex>」：内容哈希含参数串
//   （重载不冲突）+嵌入原长（碰撞面 2^-64）+头段保留包名/模块路径 hex 头供
//   人工归类（LLVM/rustc 超长 mangle 内容哈希截断同构）；短符号原样零扰动
//   （与宿主产物逐字节对拍基线，探针黄金值 EFF9F723240DB1BE 锚定）。
//   2026-09-09 ④重做：原生位运算 (h ^ b) * prime（int64 位模式 XOR/imul wrap
//   与 uint64 逐位一致）——替代无位运算时代的 字节异或/低八位/高五十六位/
//   异或一字节 四函数纯算术模拟（40+ 行负数位模式手工推理=缺陷面，性能：每
//   字节 8 次迭代除余循环 → 2 条单指令）。种子/素数原值不变=黄金值锚定保持。
//   526（78/79 win 面红根治）：乘数步改 **回绕乘 知情回绕通道**——FNV 步乘
//   按设计 mod 2^64 回绕，474/481 立法后安全域裸乘被插溢出检查（附加=类型码），
//   v2 编译自身时遇 >200 超长符号（v2 树全量 mangled 名超限常见：win 专属
//   超长收缩路径）即错误码 8 自中止（本机 8 分钟全树复现+gdb 回溯=超长收缩
//   栈帧·最小复现=单长名函数文件秒级中止）。回绕乘=474 显式回绕三件套·
//   两补码逐位等价（种子/素数/黄金值锚定不变·宿主 shortenLongSymbol 对拍面）。
函数 超长收缩(字符串 修饰名) -> 字符串 {
    整64 长度 = 字符串长度(修饰名);
    如果 (长度 <= 200) { 返回 字符串复制(修饰名); }
    整64 h = 1469598103934665603;    // FNV-1a 64 offset basis（原值锚定，见上）
    整64 i = 0;
    当 (i < 长度) {
        h = 回绕乘(h ^ (整64(修饰名[i]) & 255), 1099511628211);
        i++;
    }
    返回 字符串子串(修饰名, 0, 180) + "$L" + 整数转字符串(长度) + "H" + 位模式十六进制(h);
}

函数 符号修饰实现(字符串 名) -> 字符串 {
    // P6h（2026-08-31）：入口符号对齐宿主——主 -> cn_main（extern "C"，
    //   宿主运行时 entry 经 __cn_cache_argv 后调用；与 C++ 版 x64_codegen
    //   symbolName 一致），其余符号走 nameMangle（中文 -> ?XX@@Y）。
    // P7b（2026-09-01）：对齐宿主完整 nameMangle——'#' 切分参数串（',' 分割），
    //   base 逐字节 hex（'$'->24），"@@" + "Y" + Σ类型编码 + "@Z"（无参无 @Z）；
    //   __cn_ 前缀原样（extern "C" 运行时）。类方法符号（向量$整64$追加#整64）
    //   由此与宿主编译 obj 完全一致（rustc 预编译 std 链接模式）。
    如果 (字符串比较(名, "主")) { 返回 "cn_main"; }
    如果 (字符串长度(名) >= 5 && 字符串比较(字符串子串(名, 0, 5), "__cn_")) { 返回 字符串复制(名); }
    // '#'(35) 切分：基名 + 参数串
    整64 井号位置 = 0 - 1;
    可选<整64> 井号位置查 = 字节位置(名, 35, 0);
    // miss（原 -1 哨兵）=无 '#' 切分——下方原 >=0 判定逐字保留
    如果 (井号位置查.有值) { 井号位置 = 井号位置查.值; }
    字符串 基名 = 名;
    字符串 参数串 = "";
    如果 (井号位置 >= 0) {
        基名 = 字符串子串(名, 0, 井号位置);
        参数串 = 字符串子串(名, 井号位置 + 1, 字符串长度(名) - 井号位置 - 1);
    }
    // 936（与宿主 x64 修复后判据对齐·v2 三后端零分叉）：MASM 标识符安全
    //   字符集=字母/数字/_/./$（同 是GAS安全 口径）——原判定仅查非 ASCII：
    //   `V$~V`（ASCII 类名析构符号·无参数）直通 → ml64 非法符号
    //   （1045 v2 侧 ml64 rc=1 实录）；宿主 x64 修复后与 linux/arm64/GAS
    //   路径同款字符集判定。
    布尔 需修饰 = 假;
    整64 i = 0;
    当 (i < 字符串长度(基名)) {
        整64 字节 = 整64(基名[i]) & 255;
        布尔 安全 = 假;
        如果 (字节 >= 48 && 字节 <= 57) { 安全 = 真; }
        如果 (字节 >= 65 && 字节 <= 90) { 安全 = 真; }
        如果 (字节 >= 97 && 字节 <= 122) { 安全 = 真; }
        如果 (字节 == 95 || 字节 == 46 || 字节 == 36) { 安全 = 真; }
        如果 (!安全) { 需修饰 = 真; 中断; }
        i++;
    }
    如果 (!需修饰 && 字符串长度(参数串) == 0) { 返回 字符串复制(名); }
    字符串 修饰 = "?";
    整64 j = 0;
    当 (j < 字符串长度(基名)) {
        整64 字节 = 整64(基名[j]) & 255;
        修饰 = 修饰 + 字节十六进制(字节);
        j++;
    }
    如果 (字符串长度(参数串) == 0) { 返回 修饰 + "@@Y"; }
    修饰 = 修饰 + "@@Y";
    向量<字符串> 段们 = 分割参数串(参数串);
    // 713（708-e）：参数段剥尾 & ——调用侧签名键的实参类型文本带 &（引用形参
    //   传递），克隆体定义侧签名不带 → 修饰名差一个 A（@@YA_T vs @@Y_T·fix_p.asm
    //   656926 EXTERN vs 22300 PROC 实锤 LNK2019）。引用透明：实例身份/修饰名
    //   不含引用修饰（宿主供给 v2p.obj 实测=无 A 形态·三方对齐）。段k=拥有副本
    //   （元素 借出视图经 设置 失效后使用会被借出检查拒绝）。
    整64 k = 0;
    当 (k < 段们.大小()) {
        字符串 段k = 字符串复制(段们.元素(k));
        整64 长k = 字符串长度(段k);
        布尔 剥改k = 假;
        当 (长k > 1 && ((整64(段k[整32(长k - 1)]) & 255) == 38)) {
            段k = 字符串子串(段k, 0, 整32(长k - 1));
            长k--;
            剥改k = 真;
        }
        如果 (剥改k) {
            结果<空类型, 整32> 设k = 段们.设置(k, 段k);
            如果 (!设k.正常) { 运行时错误(4); }
        }
        修饰 = 修饰 + 类型编码(段k);
        k++;
    }
    返回 修饰 + "@Z";
}

// ==================== 栈槽地址文本（共用偏移 -> MASM 文本） ====================
// MASM 立即数归一（宿主 x64_instructions 常量发射同构，2026-09-09 第四十一轮）：
//   v2 IR 常量文本=源码字面量原样，win 此前直发——带 L 后缀文本触发 ml64
//   A2206、超 32 位十进制触发截断符号扩展（组件对拍 30/30 的 v2 源码恰无大
//   字面量故不可见）。归一：真/假->1/0；进制前缀/类型后缀经共用层 字面量位模式
//   剥离；值 ∈ [-2^31,2^31) 按十进制；否则「数字开头+h」十六进制（MASM 不认
//   0x 前缀 A2206、首字符 A-F 补 0 A2085）
函数 常量立即数文本(字符串 文本) -> 字符串 {
    如果 (字符串比较(文本, "真")) { 返回 "1"; }
    如果 (字符串比较(文本, "假")) { 返回 "0"; }
    整64 值 = 字面量位模式(文本);
    如果 (值 >= 0 - 2147483648 && 值 <= 2147483647) {
        返回 整数转字符串(值);
    }
    字符串 十六 = 位模式十六进制(值);
    整64 首 = 0;
    当 (首 < 15 && 整64(十六[首]) == 48) { 首++; }
    十六 = 字符串子串(十六, 首, 16 - 首);
    如果 (整64(十六[0]) >= 65 && 整64(十六[0]) <= 70) { 十六 = "0" + 十六; }
    返回 十六 + "h";
}

// 虚拟寄存器 r -> [rbp-8*r-8]
函数 寄存器槽(整64 寄存器) -> 字符串 {
    // 992（171 根治·fail-fast）：非法槽号（<=0）守卫——槽号 0/-1 发射 [rbp]/[rbp+8]
    //   =踩保存的 rbp/返回地址（栈元数据区·「栈返回地址写坏跳入无辜函数」征兆的
    //   唯一写通道）——生成层槽号计算 miss（查表 miss=-1 泄漏）在此显式中止并
    //   报寄存器号（溯源生成侧指令）。
    如果 (寄存器 <= 0) {
        IO::打印到错误("[992守卫] 非法寄存器槽号: " + 整数转字符串(寄存器) + "（发射中止）");
        运行时错误(6);
    }
    返回 "[rbp-" + 整数转字符串(0 - 寄存器槽偏移(寄存器)) + "]";
}
// 变量槽 s（参数+局部）-> [rbp-8*(最大寄存器+s)-8]（寄存器区之上）
函数 变量槽(整64 槽, 整64 最大寄存器) -> 字符串 {
    返回 "[rbp-" + 整数转字符串(0 - 变量槽偏移(槽, 最大寄存器)) + "]";
}

// Win x64 参数寄存器名（P7b 调用装载用）：位 0..3 = rcx/rdx/r8/r9
函数 参数寄存器名(整64 位) -> 字符串 {
    如果 (位 == 0) { 返回 "rcx"; }
    如果 (位 == 1) { 返回 "rdx"; }
    如果 (位 == 2) { 返回 "r8"; }
    返回 "r9";
}

// ==================== 单指令生成 ====================
// 生成一条 IR 指令的 MASM 文本到 输出。
// P7b：槽基数（retbuf 地址计算）与 函数序号（MASM 全局标签唯一化）入参；
// ②b B6：retbuf槽数（基槽决策）入参。
函数 生成指令(IR指令 指令, 整64 最大寄存器, 整64 槽基数, 整64 retbuf槽数, 整64 函数序号,
              向量<IR指令>& 实参们, 向量<字符串> 输出) -> 空类型 {
    结果<空类型, 整32> 加行 = 输出.追加("    ; op=" + 整数转字符串(指令.操作码));
    如果 (编码数据移动Win(指令, 最大寄存器, 输出)) { 返回; }
    如果 (编码算术Win(指令, 输出)) { 返回; }
    如果 (编码比较一元Win(指令, 输出)) { 返回; }
    如果 (编码类型转换Win(指令, 函数序号, 输出)) { 返回; }
    如果 (编码访存Win(指令, 最大寄存器, 输出)) { 返回; }
    如果 (编码控制流Win(指令, 函数序号, 输出)) { 返回; }
    如果 (编码对象调用Win(指令, 最大寄存器, 槽基数, retbuf槽数, 函数序号, 实参们, 输出)) { 返回; }
    如果 (编码静态Win(指令, 输出)) { 返回; }
    // 1146（miss 不可静默·宿主 x64_instructions T11 面② 331-a 同构）：未接入
    //   编码组的操作码原落此静默 no-op=漏发射零诊断（宿主 384 实弹：静默跳过
    //   →产出缺指令错误汇编→读未初始化栈三症状）。现对齐宿主「未支持操作码」
    //   内部错误显形：IR_分配=唯一合法 no-op（变量槽登记无机器指令·帧大小由
    //   扫描函数 按 附加 预留——宿主 Alloca 显式 case return 同款）显式豁免；
    //   其余一律 登记内部未登记（收集-收尾·代码生成入口 返回前守卫硬中止）。
    如果 (指令.操作码 == IR_分配) { 返回; }   // 静默豁免<业务值>: 分配无机器指令·帧已预留（宿主 Alloca 同款合法 no-op）
    登记内部未登记("win后端·未支持操作码", 整数转字符串(指令.操作码), 0);
}
