// CN 自举编译器 v2：代码生成共用决策层（后端架构方案1，用户裁决 2026-09-02）
// 职责：双后端（代码生成.cn=win-x64 MASM / 代码生成ARM64.cn=linux-arm64 GAS）的
//   平台无关"决策"单点维护——符号修饰工具、帧扫描、槽偏移模型、调用编址、
//   字符串常量收集、标签唯一化。平台文件只保留"发射"（助记符/寄存器名/段指令/
//   平台符号修饰）。收益（双目标准绳）：
//   ① 性能：决策逻辑单点，未来指令选择/调度优化一处生效双平台；
//   ② 安全：ABI 决策（帧/栈参数/retbuf 位号）单点，杜绝双份漂移导致的静默
//     ABI 错配（内存安全事故级缺陷）。
// 设计约束：v2-CN 尚无接口/虚函数/函数指针（③ 前特性），无法做 C++ 式后端
//   抽象基座——本层以"纯函数决策库"形态提供（对标宿主 codegen 公共辅助 +
//   backend_factory 分工，自举后可演进为接口形态）。
导入 容器::向量;
导入 IR;          // IR 指令/程序IR/函数IR/操作码（原 IR生成+IR常量 合并目录包名）

公开:

// ==================== 符号修饰工具（双后端共用） ====================

// ---- 整数字面量位模式解析（三后端共用单点，2026-09-09 第四十一轮） ----
// v2 词法把整数字面量原样存文本（含 0x/0b/0o 进制前缀与 L/LL/U/UL/ULL 类型
//   后缀）；此前 linux/arm64 本地解析只认十进制（0x 前缀静默解析为 0 的潜伏
//   缺陷）、win 直发文本（ml64 A2206）。归一为 uint64 位模式（int64 模式存，
//   乘加溢出 wrap=模 2^64，与宿主 parser 进制解析+stoull 截断位模式逐位一致）。

// 数字/字母字节 -> 数值（'0'-'9'/'A'-'F'/'a'-'f'，其余 -1）
函数 十六进制数值(整64 字节) -> 整64 {
    如果 (字节 >= 48 && 字节 <= 57) { 返回 字节 - 48; }
    如果 (字节 >= 65 && 字节 <= 70) { 返回 字节 - 55; }
    如果 (字节 >= 97 && 字节 <= 102) { 返回 字节 - 87; }
    返回 0 - 1;
}

// [起点,) 按基数无符号累加（遇非本进制字节停——类型后缀 L/U 自断）；
//   整64 乘加溢出 wrap=模 2^64，位模式与宿主 stoull 截断一致。
//   2026-09-09 ④重做：字节读 & 255 位掩码（原 +256 条件修正）
函数 解析无符号(字符串 文本, 整64 基数, 整64 起点) -> 整64 {
    整64 值 = 0;
    整64 i = 起点;
    整64 长度 = 字符串长度(文本);
    当 (i < 长度) {
        整64 字节 = 整64(文本[i]) & 255;
        整64 数 = 十六进制数值(字节);
        如果 (数 < 0 || 数 >= 基数) { 中断; }
        值 = 值 * 基数 + 数;
        i++;
    }
    返回 值;
}

// 字面量文本 -> uint64 位模式（int64 存）：支持前缀 0x/0X/0b/0B/0o/0O、
//   首位负号（补码 wrap）、后缀 L/LL/U/UL/ULL（宿主 parser 进制解析同面）。
//   2026-09-09 ④重做：字节读 & 255 位掩码
函数 字面量位模式(字符串 文本) -> 整64 {
    整64 起 = 0;
    整64 符号 = 1;
    如果 (字符串长度(文本) > 0 && (整64(文本[0]) & 255) == 45) {
        起 = 1;
        符号 = 0 - 1;
    }
    整64 基数 = 10;
    整64 数字起 = 起;
    如果 (字符串长度(文本) > 起 + 1 && (整64(文本[起]) & 255) == 48) {
        整64 前缀 = 整64(文本[起 + 1]) & 255;
        如果 (前缀 == 120 || 前缀 == 88) { 基数 = 16; 数字起 = 起 + 2; }
        否则 如果 (前缀 == 98 || 前缀 == 66) { 基数 = 2; 数字起 = 起 + 2; }
        否则 如果 (前缀 == 111 || 前缀 == 79) { 基数 = 8; 数字起 = 起 + 2; }
    }
    返回 符号 * 解析无符号(文本, 基数, 数字起);
}

// uint64 位模式（int64 任意）-> 16 位大写 hex 补零（宿主 %016llX 同构）。
//   2026-09-09 ④重做：原生移位——>> 为算术移位，位模式提取恒配合 & 15 清
//   符号扩展位（「算术移位 + 掩码」= 逻辑移位惯用式，逐位等价）——原实现
//   以 高低 32 位拆入非负域 + / % 逐半字节（h<0 两分支 C 除向零修正）模拟
函数 位模式十六进制(整64 h) -> 字符串 {
    字符串 文 = "";
    整64 移 = 60;    // 最高半字节位号
    当 (移 >= 0) {
        文 = 文 + 十六进制位((h >> 移) & 15);
        移 = 移 - 4;
    }
    返回 文;
}

函数 十六进制位(整64 值) -> 字符串 {
    如果 (值 <= 9) { 返回 整数转字符串(值); }
    如果 (值 == 10) { 返回 "A"; }
    如果 (值 == 11) { 返回 "B"; }
    如果 (值 == 12) { 返回 "C"; }
    如果 (值 == 13) { 返回 "D"; }
    如果 (值 == 14) { 返回 "E"; }
    返回 "F";
}

函数 字节十六进制(整64 字节) -> 字符串 {
    返回 十六进制位((字节 >> 4) & 15) + 十六进制位(字节 & 15);
}

// 查找字节位置（找不到 -1）
函数 字节位置(字符串 名, 整64 目标字节, 整64 起点) -> 整64 {
    整64 i = 起点;
    当 (i < 字符串长度(名)) {
        整64 字节 = 整64(名[i]) & 255;
        如果 (字节 == 目标字节) { 返回 i; }
        i++;
    }
    返回 -1;
}

// 参数串分割（','=44）-> 段列表（注意：空串会产出 1 个空段——调用方须先判空）
函数 分割参数串(字符串 参数串) -> 向量<字符串> {
    向量<字符串> 段们 = 向量<字符串>();
    整64 起点 = 0;
    整64 i = 0;
    当 (i <= 字符串长度(参数串)) {
        布尔 是边界 = i == 字符串长度(参数串);
        如果 (!是边界) {
            整64 字节 = 整64(参数串[i]) & 255;
            如果 (字节 == 44) { 是边界 = 真; }
        }
        如果 (是边界) {
            结果<空类型, 整32> 加段 = 段们.追加(字符串子串(参数串, 起点, i - 起点));
            如果 (!加段.正常) { 运行时错误(4); }
            起点 = i + 1;
        }
        i++;
    }
    返回 段们;
}

// 类型编码（对标宿主 mangleTypeCode：双后端编码表一致）
函数 类型编码(字符串 类型文本) -> 字符串 {
    整64 长 = 字符串长度(类型文本);
    如果 (长 > 0) {
        整64 末字节 = 整64(类型文本[长 - 1]) & 255;
        // '&'(38) 引用后缀 -> "A"+递归（sigKey 引用参数区分按值/按引用）
        如果 (末字节 == 38) {
            返回 "A" + 类型编码(字符串子串(类型文本, 0, 长 - 1));
        }
        // '*'(42) 指针后缀 -> "PE"+所指编码
        如果 (末字节 == 42) {
            返回 "PE" + 类型编码(字符串子串(类型文本, 0, 长 - 1));
        }
    }
    如果 (字符串比较(类型文本, "整8")) { 返回 "C"; }
    如果 (字符串比较(类型文本, "正8")) { 返回 "E"; }
    如果 (字符串比较(类型文本, "整16")) { 返回 "F"; }
    如果 (字符串比较(类型文本, "正16")) { 返回 "G"; }
    如果 (字符串比较(类型文本, "整32")) { 返回 "H"; }
    如果 (字符串比较(类型文本, "正32")) { 返回 "I"; }
    如果 (字符串比较(类型文本, "整64")) { 返回 "J"; }
    如果 (字符串比较(类型文本, "正64")) { 返回 "K"; }
    如果 (字符串比较(类型文本, "整128")) { 返回 "_M"; }
    如果 (字符串比较(类型文本, "正128")) { 返回 "_O"; }
    如果 (字符串比较(类型文本, "浮32")) { 返回 "M"; }
    如果 (字符串比较(类型文本, "浮64")) { 返回 "N"; }
    如果 (字符串比较(类型文本, "布尔")) { 返回 "_N"; }
    如果 (字符串比较(类型文本, "字符")) { 返回 "D"; }
    如果 (字符串比较(类型文本, "空类型")) { 返回 "X"; }
    如果 (字符串比较(类型文本, "字符串")) { 返回 "PAX"; }
    // 其余（结构体/类实例名）-> "_T" + 整个类型名逐字节 hex
    字符串 编码 = "_T";
    整64 j = 0;
    当 (j < 字符串长度(类型文本)) {
        整64 字节 = 整64(类型文本[j]) & 255;
        编码 = 编码 + 字节十六进制(字节);
        j++;
    }
    返回 编码;
}

// ==================== 帧扫描与槽模型（双后端共用） ====================

// 统计函数最大寄存器 ID 与最大变量槽（prologue 预留帧大小）。
// 槽基数出参（变量槽区大小——retbuf 区在其上追加）。
不安全 函数 扫描函数(函数IR 函数信息, 整64* 最大寄存器, 整64* 最大槽, 整64* 槽基数) -> 空类型 {
    整64 i = 0;
    当 (i < 函数信息.指令.大小()) {
        IR指令 指令 = 函数信息.指令.元素(i);
        如果 (指令.目标 > 最大寄存器[0]) { 最大寄存器[0] = 指令.目标; }
        // 常量指令的操作数1 是 Symbol ID（非寄存器），不参与统计
        如果 (指令.操作码 != IR_常量整数 && 指令.操作码 != IR_常量浮点 &&
             指令.操作码 != IR_常量字符串 && 指令.操作码 != IR_常量布尔) {
            如果 (指令.操作数1 > 最大寄存器[0]) { 最大寄存器[0] = 指令.操作数1; }
            如果 (指令.操作数2 > 最大寄存器[0]) { 最大寄存器[0] = 指令.操作数2; }
            如果 (指令.操作数3 > 最大寄存器[0]) { 最大寄存器[0] = 指令.操作数3; }
        }
        如果 (指令.操作码 == IR_分配) {
            // 变量槽登记：附加 = 槽索引
            如果 (指令.附加 > 最大槽[0]) { 最大槽[0] = 指令.附加; }
        }
        i++;
    }
    // 参数槽：②b B8——多槽结构体参数打破「槽数=参数数」，按声明序基槽取最大值
    整64 p = 0;
    当 (p < 函数信息.参数槽序们.大小()) {
        如果 (函数信息.参数槽序们.元素(p) > 最大槽[0]) { 最大槽[0] = 函数信息.参数槽序们.元素(p); }
        p++;
    }
    // retbuf 区追加在变量槽区之上（②b B6：按本函数最大返回字节数定尺寸——旧固定
    //   2 槽=16 字节对 ≥17 字节结构体返回越界踩顶变量槽；共享单 retbuf 序号 1——
    //   IR生成 retbuf序号 常量约定，线性 IR 即时消费故复用安全）
    槽基数[0] = 最大槽[0];
    最大槽[0] = 最大槽[0] + retbuf槽位数(函数信息);
}

// retbuf 槽数（②b B6）：最小 16 字节（结果空 12/结果值 12~16），向上按 8 字节槽
//   取整——扫描函数（帧尺寸）与 生成函数（基槽地址）共用同一决策，杜绝漂移
函数 retbuf槽位数(函数IR 函数信息) -> 整64 {
    整64 字节数 = 函数信息.retbuf字节数;
    如果 (字节数 < 16) { 字节数 = 16; }
    返回 (字节数 + 7) / 8;
}

// 帧大小 = (最大寄存器 + 最大槽) * 8 + 8，16 字节对齐（锚定寄存器 rbp/x29 向下）
函数 计算帧大小(整64 最大寄存器, 整64 最大槽) -> 整64 {
    整64 帧大小 = (最大寄存器 + 最大槽) * 8 + 8;
    整64 对齐 = 帧大小 % 16;
    如果 (对齐 != 0) { 帧大小 = 帧大小 + (16 - 对齐); }
    返回 帧大小;
}

// 虚拟寄存器槽偏移：r -> -(8r+8)（锚定寄存器向下；win64 [rbp-8r-8] / arm64 [x29,#-8r-8] 同式）
函数 寄存器槽偏移(整64 寄存器) -> 整64 {
    返回 0 - (8 * 寄存器 + 8);
}

// 变量槽偏移：s -> -(8*(最大寄存器+s)+8)（寄存器槽区之下）
函数 变量槽偏移(整64 槽, 整64 最大寄存器) -> 整64 {
    返回 0 - (8 * (最大寄存器 + 槽) + 8);
}

// retbuf 基槽（②b B6）：槽基数 + retbuf槽数（缓冲基址=本区最低地址，向上覆盖
//   retbuf槽数 个槽——不再固定 2 槽；序号恒 1 共享单缓冲，槽数由 扫描函数 传入）
函数 retbuf基槽(整64 槽基数, 整64 retbuf槽数) -> 整64 {
    返回 槽基数 + retbuf槽数;
}

// ==================== 调用编址（双后端共用，平台参数化） ====================
// 位号约定（IR 层）：retbuf=0（仅 结果 返回调用）、this=1（方法调用）、实参从 2 起。
//   win-x64：位<4 走 rcx/rdx/r8/r9、影子空间 32、被调方 [rbp+48+(位-4)*8]；
//   arm64（AAPCS64）：位<8 走 x0~x7、无影子空间、被调方 [x29,#16+(位-8)*8]。
//   位号恰与 AAPCS64 寄存器编号一致；win64 位号经 参数寄存器名 表映射。

// 调用方栈参数区大小（16 对齐；不含 win64 影子空间——由平台发射器附加）
函数 调用栈区大小(整64 总位数, 整64 寄存器数) -> 整64 {
    整64 栈区 = 0;
    如果 (总位数 > 寄存器数) {
        栈区 = (总位数 - 寄存器数) * 8;
        如果 (栈区 % 16 != 0) { 栈区 = 栈区 + (16 - 栈区 % 16); }
    }
    返回 栈区;
}

// 91-a（2026-09-13 第九十一轮）：参数位置分配表（平台无关决策，三后端共用）——
//   整型类与浮点类**独立计数**（对齐宿主 emitParamSetup intIdx/floatIdx/
//   stackIdx 三计数器）：整型寄存器数（SysV 6 / win 4 / arm64 8）、浮点寄存器数
//   （SysV 8 / win 4 / arm64 8）；各自溢出按参数声明序共享栈参数区（栈位号从 0
//   起递增）。输入 类型码们 按声明序（调用点=实参类型码序列；序言=参数类型们）。
//   有retbuf=true 时整型游标自 1 起（retbuf/隐藏返回指针占位 0——rdi/rcx/x0）。
//   输出 类们（0=整型寄存器 / 1=浮点寄存器 / 2=栈）与 号们（寄存器序号或栈位号）
//   与输入同下标。
函数 分配参数位置(向量<整64> 类型码们, 整64 整数寄存器数, 整64 浮点寄存器数,
                  布尔 有retbuf, 向量<整64>& 类们, 向量<整64>& 号们) -> 空类型 {
    类们.清空();
    号们.清空();
    整64 整数游标 = 0;
    如果 (有retbuf) { 整数游标 = 1; }
    整64 浮点游标 = 0;
    整64 栈游标 = 0;
    整64 i = 0;
    当 (i < 类型码们.大小()) {
        整64 码 = 类型码们.元素(i);
        布尔 是浮 = (码 == T_浮32 || 码 == T_浮64);
        如果 (是浮 && 浮点游标 < 浮点寄存器数) {
            结果<空类型, 整32> 加1 = 类们.追加(1);
            如果 (!加1.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加2 = 号们.追加(浮点游标);
            如果 (!加2.正常) { 运行时错误(4); }
            浮点游标++;
        } 否则 如果 (是浮) {
            结果<空类型, 整32> 加3 = 类们.追加(2);
            如果 (!加3.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加4 = 号们.追加(栈游标);
            如果 (!加4.正常) { 运行时错误(4); }
            栈游标++;
        } 否则 如果 (整数游标 < 整数寄存器数) {
            结果<空类型, 整32> 加5 = 类们.追加(0);
            如果 (!加5.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加6 = 号们.追加(整数游标);
            如果 (!加6.正常) { 运行时错误(4); }
            整数游标++;
        } 否则 {
            结果<空类型, 整32> 加7 = 类们.追加(2);
            如果 (!加7.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加8 = 号们.追加(栈游标);
            如果 (!加8.正常) { 运行时错误(4); }
            栈游标++;
        }
        i++;
    }
}

// 位号是否走栈参数区
函数 位号是栈参(整64 位号, 整64 寄存器数) -> 布尔 {
    返回 位号 >= 寄存器数;
}

// 调用方栈参数写入偏移：基偏移 + (位号-寄存器数)*8
//   win64 基偏移=32（影子空间，rsp 锚定）；arm64 基偏移=0（sp 锚定）
函数 调用方栈参偏移(整64 位号, 整64 寄存器数, 整64 基偏移) -> 整64 {
    返回 基偏移 + (位号 - 寄存器数) * 8;
}

// 被调方栈参数读取偏移（锚定寄存器正向）：锚定基 + (位号-寄存器数)*8
//   win64 锚定基=48（[rbp+48+8k]，跳过保存 rbp+返回地址+影子空间）；
//   arm64 锚定基=16（[x29,#16+8k]，跳过保存 x29/x30）
函数 被调方栈参偏移(整64 位号, 整64 寄存器数, 整64 锚定基) -> 整64 {
    返回 锚定基 + (位号 - 寄存器数) * 8;
}

// ==================== 标签唯一化（双后端统一策略） ====================
// 块标签：bb<函数序号>_<块ID>——全局唯一（GAS 无作用域；MASM 虽有 PROC 作用域，
//   统一前缀消除双后端策略分叉——后端架构方案1，2026-09-02）
函数 块标签(整64 函数序号, 整64 块ID) -> 字符串 {
    返回 "bb" + 整数转字符串(函数序号) + "_" + 整数转字符串(块ID);
}

// 结构体拷贝循环标签（唯一序号由调用方给——如 输出.大小()）
函数 拷贝标签(整64 函数序号, 整64 序号) -> 字符串 {
    返回 "cpcy_" + 整数转字符串(函数序号) + "_" + 整数转字符串(序号);
}

// 删除对象空安全跳转标签
函数 对象删除标签(整64 函数序号, 整64 目标) -> 字符串 {
    返回 "objdel_" + 整数转字符串(函数序号) + "_" + 整数转字符串(目标);
}

// 350-a（T27 v2 侧同构·B12 甲）：除法保护跳转标签——除零检查 + 有符号 INT_MIN/-1
//   溢出保护（x86 idiv 溢出抛 #DE → v2 产物 SIGFPE·423 实证）。序号取**输出行号**
//   （调用点 输出.大小()：单函数内单调·且后端 asm 为全模块单文件输出 → 全局唯一；
//   免跨函数计数器状态传递——编码算术X64L 无函数序号参数，行号方案免改其签名）。
函数 除零跳过标签(整64 序号) -> 字符串 {
    返回 "divok_" + 整数转字符串(序号);
}

函数 除安全标签(整64 序号) -> 字符串 {
    返回 "divsf_" + 整数转字符串(序号);
}

函数 除结束标签(整64 序号) -> 字符串 {
    返回 "diven_" + 整数转字符串(序号);
}

// 静态槽标签（②c C，2026-09-02）：_cn_gstatic_<序号>——ASCII 按序号命名
//   （任意代码页安全、MASM 247 符号限制无虞；静态为本编译单元内部存储，
//   无宿主互操作——不需对齐宿主 nameMangle）
函数 静态槽标签(整64 序号) -> 字符串 {
    返回 "_cn_gstatic_" + 整数转字符串(序号);
}

// ==================== 字符串常量收集（双后端共用） ====================
// 收集程序 IR 中全部 IR_常量字符串 的文本 ID（去重，保持首次出现顺序）
函数 收集字符串常量(程序IR 程序) -> 向量<整64> {
    向量<整64> 们 = 向量<整64>();
    映射<整64, 整64> 已发 = 映射<整64, 整64>();
    整64 f = 0;
    当 (f < 程序.函数们.大小()) {
        函数IR 扫函数 = 程序.函数们.元素(f);
        整64 i = 0;
        当 (i < 扫函数.指令.大小()) {
            IR指令 扫指令 = 扫函数.指令.元素(i);
            如果 (扫指令.操作码 == IR_常量字符串) {
                结果<整64, 整32> 查已发 = 已发.获取(扫指令.操作数1);
                如果 (!查已发.正常) {
                    结果<空类型, 整32> 登记发 = 已发.设置(扫指令.操作数1, 1);
                    如果 (!登记发.正常) { 运行时错误(4); }
                    结果<空类型, 整32> 加ID = 们.追加(扫指令.操作数1);
                    如果 (!加ID.正常) { 运行时错误(4); }
                }
            }
            i++;
        }
        f++;
    }
    返回 们;
}

// ==================== 浮点常量（89-a，2026-09-12 第八十九轮） ====================
// 浮点字面量文本净化：剥 L/l/U/u 尾缀（词法保留原文含后缀——整数路径经
//   字面量位模式 自断；浮点发射 .double/REAL8 前须净化，GAS/MASM 均不认
//   "3.5L"）。无后缀文本原样返回（零分配分支）。
函数 浮点文本净(整64 文本ID) -> 字符串 {
    字符串 原 = 字符串复制(驻留文本(文本ID));
    整64 长 = 字符串长度(原);
    当 (长 > 0) {
        整64 尾 = 整64(原[长 - 1]) & 255;
        // 338-a（T56）：f/F 后缀同剥（词法 338-a 起浮点吞尾缀入文本·净文本
        //   .double 直通——语义按浮32 分型在语义层·值经浮64 位模式+转换链）
        如果 (尾 == 76 || 尾 == 108 || 尾 == 85 || 尾 == 117 || 尾 == 102 || 尾 == 70) { 长 = 长 - 1; } 否则 { 中断; }
    }
    返回 字符串子串(原, 0, 长);
}

// 收集程序 IR 中全部 IR_常量浮点 的文本 ID（去重，保持首次出现顺序）——
//   照 收集字符串常量 同构；数据段 floatData_<文本ID>: .double <净文本>。
//   两种常量分开收集/分标签（strData_/floatData_）——文本表语义不同不可混池。
函数 收集浮点常量(程序IR 程序) -> 向量<整64> {
    向量<整64> 们 = 向量<整64>();
    映射<整64, 整64> 已发 = 映射<整64, 整64>();
    整64 f = 0;
    当 (f < 程序.函数们.大小()) {
        函数IR 扫函数 = 程序.函数们.元素(f);
        整64 i = 0;
        当 (i < 扫函数.指令.大小()) {
            IR指令 扫指令 = 扫函数.指令.元素(i);
            如果 (扫指令.操作码 == IR_常量浮点) {
                结果<整64, 整32> 查已发 = 已发.获取(扫指令.操作数1);
                如果 (!查已发.正常) {
                    结果<空类型, 整32> 登记发 = 已发.设置(扫指令.操作数1, 1);
                    如果 (!登记发.正常) { 运行时错误(4); }
                    结果<空类型, 整32> 加ID = 们.追加(扫指令.操作数1);
                    如果 (!加ID.正常) { 运行时错误(4); }
                }
            }
            i++;
        }
        f++;
    }
    返回 们;
}
