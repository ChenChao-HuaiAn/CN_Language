// CN 自举编译器 v2：结构化语义分析器（自举重建 P4 重做，2026-08-25，第6版）
// 符号表 = 向量<映射<整64, 符号>> 真嵌套作用域栈——每层独立 O(1) 哈希映射。
// 相比第5版「单映射 + 每符号深度 + 延迟删除」：弹出真正移除该层符号（查找
// 无深度遮蔽检查、无残留符号），对标 rustc/LLVM 作用域栈。
// 依赖（宿主根治）：H8-5 容器持有类对象所有权——向量 追加 类元素深拷贝独立、
// 绑定元素为非拥有式视图（不触发 RAII 双释放）；Feature 2 完整版 向量 删除/
// ~向量 自动销毁有析构类元素（编译器级注入，弹出无需显式 释放内部数组()）。
导入 容器::向量
导入 映射集合
导入 语法分析
导入 IR容器    // P7b：容器/结果 合成名合法性判定（构造调用被调标识符）

公开:

常量 符号_变量 = 1
常量 符号_参数 = 2
常量 符号_函数 = 3
常量 符号_结构体 = 4
常量 符号_常量 = 5     // P7a：顶层常量（类型按字面量记 整64；值内联在 IR 层完成）

结构体 符号 {
    整64 名ID
    整64 类型ID
    整64 种类
    整64 附加
}

// 压入作用域：追加一个空映射（追加 深拷贝独立——H8-5 容器持有类对象）
函数 表压入(向量<映射<整64, 符号>> 符号表) -> 空类型 {
    映射<整64, 符号> 层 = 映射<整64, 符号>()
    结果<空类型, 整32> 加 = 符号表.追加(层)
    如果 (!加.正常) { 运行时错误(4) }
}

// 弹出作用域：删除 自动销毁顶层映射元素（Feature 2 完整版——向量 删除 对
//   有析构类元素自动调用析构 ~映射 释放内部数组；真删除无残留遮蔽）
函数 表弹出(向量<映射<整64, 符号>> 符号表) -> 空类型 {
    如果 (符号表.大小() == 0) { 返回 }
    结果<空类型, 整32> 删 = 符号表.删除(符号表.大小() - 1)
    如果 (!删.正常) { 运行时错误(4) }
}

// 注册符号：同作用域重名 -> 0；否则设置（O(1) 哈希）
函数 表注册(向量<映射<整64, 符号>> 符号表, 整64 名ID, 整64 类型ID, 整64 种类, 整64 附加) -> 整64 {
    如果 (符号表.大小() == 0) { 返回 0 }
    映射<整64, 符号> 顶层 = 符号表.元素(符号表.大小() - 1)
    结果<符号, 整32> 已有 = 顶层.获取(名ID)
    如果 (已有.正常) { 返回 0 }
    符号 s
    s.名ID = 名ID
    s.类型ID = 类型ID
    s.种类 = 种类
    s.附加 = 附加
    结果<空类型, 整32> 加 = 顶层.设置(名ID, s)
    如果 (!加.正常) { 返回 0 }
    返回 1
}

// 查找符号：从栈顶向下（内层遮蔽外层）；返回类型ID（-1=未找到）
函数 表查找类型ID(向量<映射<整64, 符号>> 符号表, 整64 名ID) -> 整64 {
    整64 i = 符号表.大小()
    当 (i > 0) {
        i--
        映射<整64, 符号> 层 = 符号表.元素(i)
        结果<符号, 整32> 查 = 层.获取(名ID)
        如果 (查.正常) {
            符号 找到 = 查.值
            返回 找到.类型ID
        }
    }
    返回 -1
}

// 诊断记录
函数 表诊断(向量<字符串> 诊断, 字符串 消息) -> 空类型 {
    结果<空类型, 整32> 加 = 诊断.追加(消息)
    如果 (!加.正常) { 运行时错误(4) }
}
// ==================== 声明收集（第一趟：函数/结构体签名） ====================
函数 声明收集(向量<节点> 池, 整32 程序节点, 向量<映射<整64, 符号>> 符号表) -> 空类型 {
    节点 程序 = 池.元素(程序节点)
    整64 i = 整64(程序.子起点)
    当 (i < 整64(程序.子终点)) {
        节点 声明 = 池.元素(整32(i))
        如果 (声明.类型 == 节点_函数) {
            整64 忽略 = 表注册(符号表, 整64(声明.文本), 整64(声明.附加), 符号_函数, 0)
            如果 (忽略 == 0) { }
        }
        如果 (声明.类型 == 节点_结构体) {
            整64 忽略2 = 表注册(符号表, 整64(声明.文本), 0, 符号_结构体, 0)
            如果 (忽略2 == 0) { }
        }
        如果 (声明.类型 == 节点_常量声明) {
            // P7a：顶层常量登记（类型ID 记 整64 名ID——v2 整数字面量统一按 整64）；
            //   多文件两趟结构下第一趟全文件收集，跨文件常量引用天然可见
            整64 忽略3 = 表注册(符号表, 整64(声明.文本), 驻留("整64"), 符号_常量, 0)
            如果 (忽略3 == 0) { }
        }
        i++
    }
}

// ==================== 成员访问偏移标注（P6c） ====================
// 后缀栈遍历表达式区间 [起点, 终点)：标识符/字面量压类型；节点_成员 弹对象类型
//   查结构体字段偏移并写入节点.附加（IR 生成直接用）；节点_取地址/解引用 弹压类型。
// 返回 0=成功；-1=失败（类型未知/字段不存在）。
函数 标注成员偏移(向量<节点> 池, 整32 起点, 整32 终点,
                   向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 整64 {
    向量<整64> 类型栈 = 向量<整64>()
    整32 位置 = 起点
    当 (位置 < 终点) {
        节点 n = 池.元素(位置)
        如果 (n.类型 == 节点_标识符) {
            整64 类型ID = 表查找类型ID(符号表, 整64(n.文本))
            如果 (类型ID == -1) { 返回 -1 }
            结果<空类型, 整32> 加 = 类型栈.追加(类型ID)
            如果 (!加.正常) { 运行时错误(4) }
        } 否则 如果 (n.类型 == 节点_整数字面量) {
            结果<空类型, 整32> 加 = 类型栈.追加(驻留("整32"))
            如果 (!加.正常) { 运行时错误(4) }
        } 否则 如果 (n.类型 == 节点_浮点字面量) {
            结果<空类型, 整32> 加 = 类型栈.追加(驻留("浮64"))
            如果 (!加.正常) { 运行时错误(4) }
        } 否则 如果 (n.类型 == 节点_字符串字面量) {
            结果<空类型, 整32> 加 = 类型栈.追加(驻留("字符串"))
            如果 (!加.正常) { 运行时错误(4) }
        } 否则 如果 (n.类型 == 节点_成员) {
            // 成员访问：偏移已由语法层写入 n.附加；字段类型暂按 整64
            结果<空类型, 整32> 加2 = 类型栈.追加(驻留("整64"))
            如果 (!加2.正常) { 运行时错误(4) }
        } 否则 如果 (n.类型 == 节点_取地址) {
            // & 对象：类型不变（地址即 整64 槽）
            结果<空类型, 整32> 加3 = 类型栈.追加(驻留("整64"))
            如果 (!加3.正常) { 运行时错误(4) }
        } 否则 如果 (n.类型 == 节点_解引用) {
            // * 指针：弹指针 -> 压 整64（暂标量）
            如果 (类型栈.大小() >= 1) {
                结果<空类型, 整32> 删2 = 类型栈.删除(类型栈.大小() - 1)
                如果 (!删2.正常) { 运行时错误(4) }
            }
            结果<空类型, 整32> 加4 = 类型栈.追加(驻留("整64"))
            如果 (!加4.正常) { 运行时错误(4) }
        } 否则 如果 (n.类型 == 节点_二元运算 || n.类型 == 节点_调用) {
            // 二元：弹2压1；调用：弹实参+被调，压 整64（暂）
            如果 (n.类型 == 节点_二元运算) {
                如果 (类型栈.大小() >= 2) {
                    结果<空类型, 整32> 删3 = 类型栈.删除(类型栈.大小() - 1)
                    如果 (!删3.正常) { 运行时错误(4) }
                    结果<空类型, 整32> 删4 = 类型栈.删除(类型栈.大小() - 1)
                    如果 (!删4.正常) { 运行时错误(4) }
                }
            } 否则 {
                整64 弹数 = n.附加 + 1  // 实参 + 被调
                当 (弹数 > 0 && 类型栈.大小() > 0) {
                    结果<空类型, 整32> 删5 = 类型栈.删除(类型栈.大小() - 1)
                    如果 (!删5.正常) { 运行时错误(4) }
                    弹数--
                }
            }
            结果<空类型, 整32> 加5 = 类型栈.追加(驻留("整64"))
            如果 (!加5.正常) { 运行时错误(4) }
        }
        位置++
    }
    返回 0
}

// 检查表达式：返回类型ID（-1=未知）；未声明标识符 -> 诊断
函数 检查表达式(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 整64 {
    节点 n = 池.元素(节点索引)
    如果 (n.类型 == 节点_整数字面量) { 返回 驻留("整32") }
    如果 (n.类型 == 节点_浮点字面量) { 返回 驻留("浮64") }
    如果 (n.类型 == 节点_字符串字面量) { 返回 驻留("字符串") }
    如果 (n.类型 == 节点_标识符) {
        整64 找到类型 = 表查找类型ID(符号表, 整64(n.文本))
        如果 (找到类型 != -1) {
            返回 找到类型
        }
        // P7b（2026-09-01）：容器/结果 合成名（向量$整64/结果$空类型$整32）合法——
        //   构造调用 向量<整64>() 的被调标识符（语法层已合成 $ 实例名）。
        如果 (是容器类(驻留文本(整64(n.文本))) || 是结果类型(驻留文本(整64(n.文本)))) {
            返回 整64(n.文本)
        }
        // P6g（2026-08-30）：类型名（整32/整64/浮64/布尔/字符串）作标识符合法——
        //   类型转换 整32(x) 的被调标识符；不作为函数/变量时报未声明。
        字符串 名文本 = 驻留文本(整64(n.文本))
        如果 (字符串比较(名文本, "整32") || 字符串比较(名文本, "整64") ||
             字符串比较(名文本, "浮32") || 字符串比较(名文本, "浮64") ||
             字符串比较(名文本, "布尔") || 字符串比较(名文本, "字符") ||
             字符串比较(名文本, "字符串") || 字符串比较(名文本, "正32") ||
             字符串比较(名文本, "正64") || 字符串比较(名文本, "整8") ||
             字符串比较(名文本, "整16") || 字符串比较(名文本, "正8") ||
             字符串比较(名文本, "正16")) {
            返回 整64(n.文本)
        }
        表诊断(诊断, "[错误] 未声明标识符: " + 名文本)
        返回 -1
    }
    如果 (n.类型 == 节点_成员) {
        // 成员访问：偏移已标注到附加；字段类型暂 整64
        返回 驻留("整64")
    }
    如果 (n.类型 == 节点_取地址 || n.类型 == 节点_解引用) {
        返回 驻留("整64")
    }
    如果 (n.类型 == 节点_调用) {
        // P6g（2026-08-30）：调用/类型转换——被调标识符节点索引在 子起点
        //   （语法层后缀链记录）。若其文本是类型名（整32/整64/浮64/布尔/字符串）
        //   -> 类型转换；否则函数调用，查符号表返回类型（符号_函数 附加=返回类型ID）。
        整64 调用起点 = 整64(n.子起点)
        如果 (调用起点 > 0) {
            节点 被调节点 = 池.元素(整32(调用起点))
            如果 (被调节点.类型 == 节点_标识符) {
                整64 被调名 = 整64(被调节点.文本)
                字符串 被调文本 = 驻留文本(被调名)
                // P7b：容器类构造调用（向量<整64>() 语法层已合成 向量$整64 被调标识符）
                //   合法——返回类型暂按 整64（对象指针）兜底
                如果 (是容器类(被调文本)) {
                    返回 驻留("整64")
                }
                如果 (字符串比较(被调文本, "整32") || 字符串比较(被调文本, "整64") ||
                     字符串比较(被调文本, "浮32") || 字符串比较(被调文本, "浮64") ||
                     字符串比较(被调文本, "布尔") || 字符串比较(被调文本, "字符") ||
                     字符串比较(被调文本, "字符串") || 字符串比较(被调文本, "正32") ||
                     字符串比较(被调文本, "正64")) {
                    返回 被调名
                }
                // 函数调用：查符号表（符号_函数 附加=返回类型ID）
                整64 找到类型 = 表查找类型ID(符号表, 被调名)
                如果 (找到类型 != -1) { 返回 找到类型 }
                表诊断(诊断, "[错误] 未声明函数: " + 被调文本)
                返回 -1
            }
        }
        // 无被调信息：整64 兜底
        返回 驻留("整64")
    }
    返回 -1
}

// 检查语句
函数 检查语句(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 空类型 {
    节点 n = 池.元素(节点索引)
    如果 (n.类型 == 节点_返回语句) {
        整64 i = 整64(n.子起点)
        当 (i < 整64(n.子终点)) {
            整64 忽略 = 检查表达式(池, 整32(i), 符号表, 诊断)
            如果 (忽略 == -1) { }
            i++
        }
        返回
    }
    如果 (n.类型 == 节点_变量声明) {
        整64 类型ID = 整64(n.附加)
        // 块级作用域析构防护（用户裁决项2 配套）：嵌套块同名容器变量遮蔽——
        //   v2 局部槽同名合槽（预扫），遮蔽会泄漏/双释，P7c 完整块上下文前不支持
        如果 (符号表.大小() >= 3) {  // 全局+函数 之外还有块层（嵌套块内）
            字符串 声明类型文本 = 驻留文本(类型ID)
            如果 (是容器类(声明类型文本)) {
                整64 层 = 符号表.大小() - 2   // 跳过当前块层，从外层块向上查
                当 (层 >= 2) {
                    映射<整64, 符号> 外层 = 符号表.元素(层)
                    结果<符号, 整32> 外层查 = 外层.获取(整64(n.文本))
                    如果 (外层查.正常) {
                        表诊断(诊断, "[错误] 嵌套块同名容器变量遮蔽暂不支持（P7c 前置）: " +
                                      驻留文本(整64(n.文本)))
                        中断
                    }
                    层--
                }
            }
        }
        整64 忽略 = 表注册(符号表, 整64(n.文本), 类型ID, 符号_变量, 0)
        如果 (忽略 == 0) { }
        // P6c：成员偏移标注
        整64 标1 = 标注成员偏移(池, n.子起点, n.子终点, 符号表, 诊断)
        如果 (标1 == -1) { }
        整64 i = 整64(n.子起点)
        当 (i < 整64(n.子终点)) {
            整64 忽略2 = 检查表达式(池, 整32(i), 符号表, 诊断)
            如果 (忽略2 == -1) { }
            i++
        }
        返回
    }
    如果 (n.类型 == 节点_赋值) {
        // 左值（标识符）须已声明；右值表达式检查；解引用左值（文本=0）跳过左名检查
        如果 (n.文本 != 0) {
            整64 左类型 = 表查找类型ID(符号表, 整64(n.文本))
            如果 (左类型 == -1) {
                表诊断(诊断, "[错误] 赋值目标未声明: " + 驻留文本(整64(n.文本)))
            }
        }
        // P6c：成员偏移标注（解引用左值：区间 [附加, 子终点) 含左值表达式）
        整64 标注起点 = n.文本 != 0 ? n.子起点 : 整32(n.附加)
        整64 标2 = 标注成员偏移(池, 整32(标注起点), n.子终点, 符号表, 诊断)
        如果 (标2 == -1) { }
        整64 i = 整64(标注起点)
        当 (i < 整64(n.子终点)) {
            整64 忽略2 = 检查表达式(池, 整32(i), 符号表, 诊断)
            如果 (忽略2 == -1) { }
            i++
        }
        返回
    }
    如果 (n.类型 == 节点_自增) {
        整64 目标类型 = 表查找类型ID(符号表, 整64(n.文本))
        如果 (目标类型 == -1) {
            表诊断(诊断, "[错误] 自增目标未声明: " + 驻留文本(整64(n.文本)))
        }
        返回
    }
    如果 (n.类型 == 节点_逻辑非 || n.类型 == 节点_负号 ||
         n.类型 == 节点_取地址 || n.类型 == 节点_解引用) {
        // 一元：检查操作数表达式（子区间 [子起点, 子终点)）
        整64 标3 = 标注成员偏移(池, n.子起点, n.子终点, 符号表, 诊断)
        如果 (标3 == -1) { }
        整64 i = 整64(n.子起点)
        当 (i < 整64(n.子终点)) {
            整64 忽略2 = 检查表达式(池, 整32(i), 符号表, 诊断)
            如果 (忽略2 == -1) { }
            i++
        }
        返回
    }
    如果 (n.类型 == 节点_中断语句 || n.类型 == 节点_继续语句) {
        返回
    }
    // P6c：成员偏移标注（通用表达式区间）
    整64 标4 = 标注成员偏移(池, n.子起点, n.子终点, 符号表, 诊断)
    如果 (标4 == -1) { }
    整64 i = 整64(n.子起点)
    当 (i < 整64(n.子终点)) {
        整64 忽略 = 检查表达式(池, 整32(i), 符号表, 诊断)
        如果 (忽略 == -1) { }
        i++
    }
}

// 检查块（新作用域：压入/弹出）
函数 检查块(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 空类型 {
    表压入(符号表)
    节点 块 = 池.元素(节点索引)
    整64 i = 整64(块.子起点)
    当 (i < 整64(块.子终点)) {
        节点 子 = 池.元素(整32(i))
        如果 (子.类型 == 节点_块) {
            检查块(池, 整32(i), 符号表, 诊断)
        } 否则 如果 (子.类型 == 节点_如果语句) {
            检查如果(池, 整32(i), 符号表, 诊断)
        } 否则 如果 (子.类型 == 节点_当语句) {
            检查当(池, 整32(i), 符号表, 诊断)
        } 否则 {
            检查语句(池, 整32(i), 符号表, 诊断)
        }
        i++
    }
    表弹出(符号表)
}

// 检查如果语句：条件表达式 + 真块（新作用域）+ 否则链（否则 如果 递归）
函数 检查如果(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 空类型 {
    节点 如果节点 = 池.元素(节点索引)
    // 节点字段：文本=条件起点，子起点=条件终点，附加=真块索引，子终点=否则索引
    整64 条件起点 = 整64(如果节点.文本)
    整64 条件终点 = 整64(如果节点.子起点)
    整64 i = 条件起点
    当 (i < 条件终点) {
        整64 忽略 = 检查表达式(池, 整32(i), 符号表, 诊断)
        如果 (忽略 == -1) { }
        i++
    }
    // 真块：附加=真块节点索引
    检查块(池, 整32(如果节点.附加), 符号表, 诊断)
    // 否则链：子终点=否则节点索引（0=无；嵌套 否则 如果 亦为 节点_如果语句）
    整64 否则索引 = 如果节点.子终点
    如果 (否则索引 != 0) {
        节点 否则节点 = 池.元素(整32(否则索引))
        如果 (否则节点.类型 == 节点_如果语句) {
            检查如果(池, 整32(否则索引), 符号表, 诊断)
        } 否则 {
            检查块(池, 整32(否则索引), 符号表, 诊断)
        }
    }
}

// 检查当语句：条件表达式 + 循环体块（新作用域）
函数 检查当(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 空类型 {
    节点 当节点 = 池.元素(节点索引)
    // 节点字段：文本=条件起点，子起点=条件终点，附加=体块索引
    整64 条件起点 = 整64(当节点.文本)
    整64 条件终点 = 整64(当节点.子起点)
    整64 i = 条件起点
    当 (i < 条件终点) {
        整64 忽略 = 检查表达式(池, 整32(i), 符号表, 诊断)
        如果 (忽略 == -1) { }
        i++
    }
    检查块(池, 整32(当节点.附加), 符号表, 诊断)
}

// 检查函数：函数作用域（参数 + 函数体）
函数 检查函数(向量<节点> 池, 整32 函数节点, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 空类型 {
    表压入(符号表)
    节点 函数体 = 池.元素(函数节点)
    整64 i = 整64(函数体.子起点)
    当 (i < 整64(函数体.子终点)) {
        节点 参数 = 池.元素(整32(i))
        如果 (参数.类型 == 节点_参数) {
            整64 忽略 = 表注册(符号表, 整64(参数.文本), 整64(参数.附加), 符号_参数, 0)
            如果 (忽略 == 0) { }
        }
        i++
    }
    如果 (整64(函数体.子终点) < 池.大小()) {
        检查块(池, 函数体.子终点, 符号表, 诊断)
    }
    表弹出(符号表)
}

// ==================== 主流程 ====================
// 输入节点池+程序根；输出诊断列表；返回 错误数
函数 语义分析(向量<节点> 池, 整32 程序节点, 向量<字符串> 诊断) -> 整64 {
    向量<映射<整64, 符号>> 符号表 = 向量<映射<整64, 符号>>()
    表压入(符号表)  // 全局作用域（函数/结构体声明）
    声明收集(池, 程序节点, 符号表)
    节点 程序 = 池.元素(程序节点)
    整64 i = 整64(程序.子起点)
    当 (i < 整64(程序.子终点)) {
        节点 声明 = 池.元素(整32(i))
        如果 (声明.类型 == 节点_函数) {
            检查函数(池, 整32(i), 符号表, 诊断)
        }
        i++
    }
    表弹出(符号表)  // 释放全局作用域
    返回 整64(诊断.大小())
}

// ==================== 主流程（多文件 P6h） ====================
// 多源文件：程序节点们 = 各文件 程序 节点索引（加载器按依赖先解析的顺序收集）。
// 第一趟：全部文件 声明收集（函数/结构体 合并进同一全局符号表——跨文件调用
//   与结构体可见）；第二趟：逐文件 检查函数体。返回 诊断数。
函数 语义分析多文件(向量<节点> 池, 向量<整32> 程序节点们, 向量<字符串> 诊断) -> 整64 {
    向量<映射<整64, 符号>> 符号表 = 向量<映射<整64, 符号>>()
    表压入(符号表)  // 全局作用域（全部文件 函数/结构体 声明）
    整64 i = 0
    当 (i < 程序节点们.大小()) {
        声明收集(池, 程序节点们.元素(整32(i)), 符号表)
        i++
    }
    整64 j = 0
    当 (j < 程序节点们.大小()) {
        节点 程序 = 池.元素(程序节点们.元素(整32(j)))
        整64 k = 整64(程序.子起点)
        当 (k < 整64(程序.子终点)) {
            节点 声明 = 池.元素(整32(k))
            如果 (声明.类型 == 节点_函数) {
                检查函数(池, 整32(k), 符号表, 诊断)
            }
            k++
        }
        j++
    }
    表弹出(符号表)  // 释放全局作用域
    返回 整64(诊断.大小())
}
