// CN 自举编译器 v2：结构化语义分析器（自举重建 P4 重做，2026-08-25，第6版）
// 符号表 = 向量<映射<整64, 符号>> 真嵌套作用域栈——每层独立 O(1) 哈希映射。
// 相比第5版「单映射 + 每符号深度 + 延迟删除」：弹出真正移除该层符号（查找
// 无深度遮蔽检查、无残留符号），对标 rustc/LLVM 作用域栈。
// 依赖（宿主根治）：H8-5 容器持有类对象所有权——向量 追加 类元素深拷贝独立、
// 绑定元素为非拥有式视图（不触发 RAII 双释放）；Feature 2 完整版 向量 删除/
// ~向量 自动销毁有析构类元素（编译器级注入，弹出无需显式 释放内部数组()）。
导入 容器::向量;
导入 映射集合;
导入 语法分析;
导入 IR容器;    // P7b：容器/结果 合成名合法性判定（构造调用被调标识符）
导入 IR常量;    // 簇①根治·A2：节点_*/键位移 常量（语句根派发/字段分桶键）

公开:

常量 符号_变量 = 1;
常量 符号_参数 = 2;
常量 符号_函数 = 3;
常量 符号_结构体 = 4;
常量 符号_常量 = 5;     // P7a：顶层常量（类型按字面量记 整64；值内联在 IR 层完成）

结构体 符号 {
    整64 名ID;
    整64 类型ID;
    整64 种类;
    整64 附加;
}

// ==================== 模块分桶（plans/018 P6b 第 3 层，2026-09-07） ====================
// 名称解析三级模型（plans/001 §5.9.7，Rust item > named use > glob 对齐）：
//   ① 本模块显式声明（模块成员键基们）＞ ② 显式导入（文件导入键基们，构建期
//   解析+可见性/E0255 检查）＞ ③ 通配（导入模块路径们 遍历，公开成员、使用点
//   歧义 E0659）。①遮蔽③ 合法；①×② / ②×② 同名=编译错误。
// 全局符号表键升级为「键基」（IR容器.键基合成：主模块=纯名、其余=模块$名）——
//   跨模块同名同签名合法共存（原「先收集文件赢」静默/硬错误 面根治）；单文件
//   与主模块形态键=纯名，行为逐字节不变（v2self 产物对拍硬基准）。
// 静态上下文为「当前检查文件」维度：语义分析多文件 第二趟逐文件由
//   构建文件导入上下文 重设；三级决议结果缓存（三级键基缓存们）同窗口生命周期。
静态 映射<整64, 整64> 模块成员键基们;   // 模块路径ID*键位移+名ID -> 键基ID
静态 映射<整64, 整64> 模块成员公开们;   // 同键 -> 1=公开（公开: 标签；缺省私有）
静态 映射<整64, 整64> 文件导入键基们;   // 绑定名ID -> 键基ID（② 构建期解析产物）
静态 向量<整64> 已加载模块ID们;         // ③ 合并全局可见的遍历范围=加载树全部模块（宿主事实标准对齐）
静态 整64 当前模块路径ID = 0;           // 当前检查文件的模块路径 驻留 ID
静态 映射<整64, 整64> 三级键基缓存们;   // 名ID -> 键基ID / -1 未命中 / -2 歧义（文件级）
静态 向量<字符串> 语义诊断缓冲;         // 查找链路歧义诊断缓冲（主流程末尾合入）

// 诊断缓冲追加（查找函数无诊断参数——歧义诊断经缓冲在 语义分析多文件 末尾
//   合入主诊断表，错误计数不漏）
函数 缓冲诊断(字符串 消息) -> 空类型 {
    结果<空类型, 整32> 加 = 语义诊断缓冲.追加(消息);
    如果 (!加.正常) { 运行时错误(4); }
}

// 成员索引键：模块路径ID*键位移+名ID（键位移 复用 IR常量 复合键惯例）
// （是标准库模块名/拆限定名 下沉 IR容器 中立层——IR 生成消费，避免 ir→frontend
//   反向依赖；两函数属通用符号设施）
函数 模块成员键(整64 模块ID, 整64 名ID) -> 整64 {
    返回 模块ID * 键位移 + 名ID;
}

// 三级键基决议（缓存版）：返回 键基ID / -1 未命中 / -2 歧义（首次经诊断缓冲
//   报 E0659，缓存后同名重复使用不再重复报）。实参数 >= 0 时③多命中按签名
//   个数消歧（宿主签名决议对齐：同名不同签名=重载共存合法，实参数可辨则选
//   其桶；实参数 <0=非调用裸名，同签名多模块才真歧义）。消费点：表查找类型ID/
//   表查找种类 的全局层、检查表达式 标识符与调用的签名回退、调用决议登记。
函数 三级键基查找(向量<映射<整64, 符号>> 符号表, 整64 名ID, 整64 实参数) -> 整64 {
    结果<整64, 整32> 查缓存 = 三级键基缓存们.获取(名ID);
    如果 (查缓存.正常) { 返回 查缓存.值; }
    整64 结果键基 = -1;
    // ① 本模块（成员索引=声明收集 登记）
    结果<整64, 整32> 查一 = 模块成员键基们.获取(模块成员键(当前模块路径ID, 名ID));
    如果 (查一.正常) {
        结果键基 = 查一.值;
    } 否则 {
        // ② 显式导入（构建文件导入上下文 解析：可见性/E0255 已在该处诊断）
        结果<整64, 整32> 查二 = 文件导入键基们.获取(名ID);
        如果 (查二.正常) {
            结果键基 = 查二.值;
        } 否则 {
            // ③ 合并全局可见（宿主事实标准对齐——加载树全部模块的公开符号，
            //   传递依赖可见：IR生成 用 IR签名 的 段首 经 IR容器 传递加载实证）。
            //   同名多命中按签名消歧：同签名多模块=真歧义 E0659（决议失败绝不
            //   静默）；不同签名=重载共存（实参数可辨选其桶，否则首候选——跨桶
            //   重载部分支持，诚实边界随 plans/018 注记）
            整64 候选键基 = -1;
            整64 首参串标 = -1;
            整64 真歧义 = 0;
            整64 命中数 = 0;
            字符串 来源们 = "";
            整64 g = 0;
            当 (g < 已加载模块ID们.大小()) {
                整64 m = 已加载模块ID们.元素(g);
                如果 (m != 当前模块路径ID) {
                    结果<整64, 整32> 查g = 模块成员键基们.获取(模块成员键(m, 名ID));
                    如果 (查g.正常) {
                        整64 键基g = 查g.值;   // 正向分支内提取（宿主 结果 流敏感检查惯例）
                        结果<整64, 整32> 查公 = 模块成员公开们.获取(模块成员键(m, 名ID));
                        如果 (查公.正常) {
                            // 该桶首个签名候选的参数串（签名消歧键；非函数=-1）
                            整64 参串标 = -1;
                            结果<整64, 整32> 查数g = 函数签名个数们.获取(键基g);
                            如果 (查数g.正常) {
                                如果 (查数g.值 > 0) {
                                    结果<整64, 整32> 查串g = 函数签名参数串们.获取(键基g * 键位移);
                                    如果 (查串g.正常) { 参串标 = 查串g.值; }
                                }
                            }
                            如果 (命中数 == 0) {
                                命中数 = 1;
                                候选键基 = 键基g;
                                首参串标 = 参串标;
                                来源们 = 驻留文本(m);
                            } 否则 如果 (参串标 == 首参串标) {
                                // 同签名多模块=真歧义（且已锁定首候选可能不唯一）
                                真歧义 = 1;
                                来源们 = 来源们 + "/" + 驻留文本(m);
                            } 否则 {
                                // 不同签名=重载共存：实参数可辨则按参数个数选桶
                                如果 (实参数 >= 0) {
                                    整64 选桶 = 按实参数选桶(名ID, 实参数);
                                    如果 (选桶 >= 0) { 候选键基 = 选桶; }
                                }
                            }
                        }
                    }
                }
                g++;
            }
            如果 (真歧义 == 1) {
                缓冲诊断("[错误] 符号歧义: " + 驻留文本(名ID) + "（来自 " +
                              来源们 + "——须以 模块::符号 限定消歧，规格08-三）");
                结果键基 = -2;
            } 否则 {
                结果键基 = 候选键基;
            }
        }
    }
    结果<空类型, 整32> 设缓存 = 三级键基缓存们.设置(名ID, 结果键基);
    如果 (!设缓存.正常) { 运行时错误(4); }
    返回 结果键基;
}

// ③多命中不同签名的桶选择：按「签名候选参数个数=实参数」过滤各命中桶，
//   唯一匹配返回其键基；无/多匹配返回 -1（调用方保留首候选）。签名候选经
//   函数签名表（键基维度）逐桶查询；参数个数=逗号数+1 真数（决议函数符号 同款）
函数 按实参数选桶(整64 名ID, 整64 实参数) -> 整64 {
    整64 选中 = -1;
    整64 匹配数 = 0;
    整64 g = 0;
    当 (g < 已加载模块ID们.大小()) {
        整64 m = 已加载模块ID们.元素(g);
        如果 (m != 当前模块路径ID) {
            结果<整64, 整32> 查g = 模块成员键基们.获取(模块成员键(m, 名ID));
            如果 (查g.正常) {
                结果<整64, 整32> 查公 = 模块成员公开们.获取(模块成员键(m, 名ID));
                如果 (查公.正常) {
                    整64 桶键基 = 查g.值;   // 正向分支内提取（宿主 结果 流敏感检查惯例）
                    结果<整64, 整32> 查数 = 函数签名个数们.获取(桶键基);
                    如果 (查数.正常) {
                        整64 k = 0;
                        当 (k < 查数.值) {
                            结果<整64, 整32> 查串 = 函数签名参数串们.获取(桶键基 * 键位移 + k);
                            如果 (查串.正常) {
                                字符串 参数串文本 = 驻留文本(查串.值);
                                整64 参数个数 = 0;
                                如果 (字符串长度(参数串文本) > 0) {
                                    参数个数 = 1;
                                    整64 ci = 0;
                                    当 (ci < 字符串长度(参数串文本)) {
                                        整64 cb = 整64(参数串文本[ci]);
                                        如果 (cb < 0) { cb = cb + 256; }
                                        如果 (cb == 44) { 参数个数++; }
                                        ci++;
                                    }
                                }
                                如果 (参数个数 == 实参数) {
                                    匹配数++;
                                    如果 (匹配数 == 1) { 选中 = 桶键基; }
                                }
                            }
                            k++;
                        }
                    }
                }
            }
        }
        g++;
    }
    如果 (匹配数 == 1) { 返回 选中; }
    返回 0 - 1;
}

// 清空模块解析表（语义分析/语义分析多文件 入口——任务级生命周期惯例）
函数 清空模块解析表() -> 空类型 {
    模块成员键基们.清空();
    模块成员公开们.清空();
    文件导入键基们.清空();
    已加载模块ID们 = 向量<整64>();
    三级键基缓存们.清空();
    语义诊断缓冲 = 向量<字符串>();
    当前模块路径ID = 0;
}

// 登记调用点决议键基（语义驱动 IR——plans/018 第 4 层）：三级决议命中且该
//   键基下有签名候选（=用户函数，非类型转换/构造/内置）时，把键基写入
//   调用决议键基们（IR容器 静态表，键=调用节点池索引）。IR 层 决议函数符号
//   据此锁定候选模块桶后重载决议——IR 不重复名称解析、无反向依赖。
函数 登记调用决议(向量<映射<整64, 符号>> 符号表, 整64 名ID, 整64 调用节点索引) -> 空类型 {
    整64 键基r = 三级键基查找(符号表, 名ID, 0 - 1);
    如果 (键基r < 0) { 返回; }
    结果<整64, 整32> 查数r = 函数签名个数们.获取(键基r);
    如果 (查数r.正常) {
        如果 (查数r.值 > 0) {
            调用决议登记(调用节点索引, 键基r);
        }
    }
}

// 全局层直查类型ID（签名键/键基等复合键专用——不经三级解析；签名键含 '#'
//   非纯名，三级成员索引按纯名登记，直查全局层才是其正确消费形态）
函数 全局层查类型(向量<映射<整64, 符号>> 符号表, 整64 键) -> 整64 {
    如果 (符号表.大小() == 0) { 返回 -1; }
    映射<整64, 符号> 全局层 = 符号表.元素(0);
    结果<符号, 整32> 查 = 全局层.获取(键);
    如果 (查.正常) {
        符号 找到s = 查.值;   // 逐步提取（链式成员 查.值.类型ID 踩 v2 成员链
        返回 找到s.类型ID;    //   字段偏移半实现边界——[ir2] 拒发，非链式惯例）
    }
    返回 -1;
}

// ③ 第三波（2026-09-03）：指针变量表——名ID -> 所指元素类型名ID。参数/局部
//   声明时按类型节点 附加=指针层数 1..255 登记（与 引用>=256 互斥）；下标
//   白名单与左值放行判定用。检查函数 开头清空（函数级生命周期——跨函数
//   同名不串；块级遮蔽同 变量结构体表 约定的既有边界）。顶层静态无初始化
//   ——宿主 P3-8 指针槽模型入口自动构造。
静态 映射<整64, 整64> 指针变量表;

// ③ 第三波：指针下标所指类型白名单（IR 指针加载宽度分支覆盖面）：整系/正系/
//   布尔/字符/字符串；浮点（v2 指针加载无浮点分支）/结构体/容器/结果（元素
//   语义须返回地址而非加载值）显式拒绝——半实现纪律：未覆盖形态不放行。
函数 指针下标所指合法(字符串 名) -> 布尔 {
    返回 字符串比较(名, "整8") || 字符串比较(名, "整16") ||
           字符串比较(名, "整32") || 字符串比较(名, "整64") ||
           字符串比较(名, "正8") || 字符串比较(名, "正16") ||
           字符串比较(名, "正32") || 字符串比较(名, "正64") ||
           字符串比较(名, "布尔") || 字符串比较(名, "字符") ||
           字符串比较(名, "字符串");
}

// 引用返回调用判定（2026-09-04 缺陷零容忍收口，宿主 P3-18 对齐）：调用节点
//   的被调为标识符且符号表返回类型名尾 '&'（-> 整64&）——该调用结果=被引用
//   左值地址，可作赋值目标/复合赋值/引用初始化绑定。
函数 是引用返回调用(向量<节点> 池, 整32 调用节点索引, 向量<映射<整64, 符号>> 符号表) -> 布尔 {
    节点 调用节点 = 池.元素(调用节点索引);
    如果 (调用节点.类型 != 节点_调用 || 调用节点.子起点 <= 0) { 返回 假; }
    节点 被调r = 池.元素(整32(调用节点.子起点));
    如果 (被调r.类型 != 节点_标识符) { 返回 假; }
    整64 返回类型IDr = 表查找类型ID(符号表, 整64(被调r.文本));
    如果 (返回类型IDr == -1) { 返回 假; }
    字符串 返回名r = 驻留文本(返回类型IDr);
    如果 (字符串长度(返回名r) == 0) { 返回 假; }
    返回 字符串比较(字符串子串(返回名r, 字符串长度(返回名r) - 1, 1), "&");
}

// 压入作用域：追加一个空映射（追加 深拷贝独立——H8-5 容器持有类对象）
函数 表压入(向量<映射<整64, 符号>> 符号表) -> 空类型 {
    映射<整64, 符号> 层 = 映射<整64, 符号>();
    结果<空类型, 整32> 加 = 符号表.追加(层);
    如果 (!加.正常) { 运行时错误(4); }
}

// 弹出作用域：删除 自动销毁顶层映射元素（Feature 2 完整版——向量 删除 对
//   有析构类元素自动调用析构 ~映射 释放内部数组；真删除无残留遮蔽）
函数 表弹出(向量<映射<整64, 符号>> 符号表) -> 空类型 {
    如果 (符号表.大小() == 0) { 返回; }
    结果<空类型, 整32> 删 = 符号表.删除(符号表.大小() - 1);
    如果 (!删.正常) { 运行时错误(4); }
}

// 注册符号：同作用域重名 -> 0；否则设置（O(1) 哈希）
函数 表注册(向量<映射<整64, 符号>> 符号表, 整64 名ID, 整64 类型ID, 整64 种类, 整64 附加) -> 整64 {
    如果 (符号表.大小() == 0) { 返回 0; }
    映射<整64, 符号> 顶层 = 符号表.元素(符号表.大小() - 1);
    结果<符号, 整32> 已有 = 顶层.获取(名ID);
    如果 (已有.正常) { 返回 0; }
    符号 s;
    s.名ID = 名ID;
    s.类型ID = 类型ID;
    s.种类 = 种类;
    s.附加 = 附加;
    结果<空类型, 整32> 加 = 顶层.设置(名ID, s);
    如果 (!加.正常) { 返回 0; }
    返回 1;
}

// 查找符号：从栈顶向下（内层遮蔽外层）；返回类型ID（-1=未找到）
// plans/018 第 3 层：全局层（栈底 i==0）查询升级三级解析——① 本模块 ② 显式
//   导入 ③ 通配（歧义 E0659 在 三级键基查找 内经诊断缓冲报告）；局部层（i>0）
//   纯名键路径不变（性能与行为零差）。主模块键基=纯名——单文件行为逐字节不变。
函数 表查找类型ID(向量<映射<整64, 符号>> 符号表, 整64 名ID) -> 整64 {
    整64 i = 符号表.大小();
    当 (i > 1) {
        i--;
        映射<整64, 符号> 层 = 符号表.元素(i);
        结果<符号, 整32> 查 = 层.获取(名ID);
        如果 (查.正常) {
            符号 找到 = 查.值;
            返回 找到.类型ID;
        }
    }
    如果 (i == 1) {
        整64 键基t = 三级键基查找(符号表, 名ID, 0 - 1);
        如果 (键基t >= 0) {
            映射<整64, 符号> 全局层 = 符号表.元素(0);
            结果<符号, 整32> 查键 = 全局层.获取(键基t);
            如果 (查键.正常) {
                符号 找到键 = 查键.值;
                返回 找到键.类型ID;
            }
        }
    }
    返回 -1;
}

// 查找符号种类：从栈顶向下（内层遮蔽外层）；返回 种类（-1=未找到）
// 缺陷②（2026-09-03 用户裁决立案）：赋值/自增目标常量判定用——局部变量遮蔽
//   外层常量按内层解析（种类=变量，放行），与 表查找类型ID 同走查序保证一致。
// plans/018 第 3 层：全局层同升三级解析（顶层常量分桶后经 ①②③ 决议）。
函数 表查找种类(向量<映射<整64, 符号>> 符号表, 整64 名ID) -> 整64 {
    整64 i = 符号表.大小();
    当 (i > 1) {
        i--;
        映射<整64, 符号> 层 = 符号表.元素(i);
        结果<符号, 整32> 查 = 层.获取(名ID);
        如果 (查.正常) {
            符号 找到 = 查.值;
            返回 找到.种类;
        }
    }
    如果 (i == 1) {
        整64 键基z = 三级键基查找(符号表, 名ID, 0 - 1);
        如果 (键基z >= 0) {
            映射<整64, 符号> 全局层 = 符号表.元素(0);
            结果<符号, 整32> 查键 = 全局层.获取(键基z);
            如果 (查键.正常) {
                符号 找到键 = 查键.值;
                返回 找到键.种类;
            }
        }
    }
    返回 -1;
}

// ==================== 类型引用三级解析与诊断（plans/018 类型/常量分桶，2026-09-08） ====================
// 宿主 A-2 类型 crate 分桶 + E0659 对齐：变量/参数/返回类型的结构体类型引用
//   三级解析（① 本模块 ＞ ② 显式导入 ＞ ③ 合并全局公开候选），存在性/私有/
//   歧义 fail fast 诊断——此前类型引用零检查（未声明结构体静默 8 字节兜底，
//   跨模块同名布局串桶静默错位，探针实测 sret ABI 级错乱）。
// 与 三级键基查找 的差异：③ 段不做函数签名表过滤（类型键基不在签名表——
//   结构体/常量/函数成员统一候选）；①② 段同构（成员索引/文件导入表 符号维度通用）。
函数 是基础类型文本(字符串 名) -> 布尔 {
    返回 字符串比较(名, "整8") || 字符串比较(名, "整16") ||
          字符串比较(名, "整32") || 字符串比较(名, "整64") ||
          字符串比较(名, "整128") || 字符串比较(名, "正8") ||
          字符串比较(名, "正16") || 字符串比较(名, "正32") ||
          字符串比较(名, "正64") || 字符串比较(名, "布尔") ||
          字符串比较(名, "字符") || 字符串比较(名, "字符串") ||
          字符串比较(名, "浮32") || 字符串比较(名, "浮64") ||
          字符串比较(名, "空类型") || 字符串比较(名, "指针") ||
          字符串比较(名, "自动");
}

// 类型键基三级查找：返回 键基ID / -1 未命中 / -2 歧义（宿主 E0659 同款三维度）
函数 类型键基查找(整64 名ID) -> 整64 {
    结果<整64, 整32> 查一 = 模块成员键基们.获取(模块成员键(当前模块路径ID, 名ID));
    如果 (查一.正常) { 返回 查一.值; }
    结果<整64, 整32> 查二 = 文件导入键基们.获取(名ID);
    如果 (查二.正常) { 返回 查二.值; }
    整64 候选键基t = -1;
    整64 候选数t = 0;
    整64 g = 0;
    当 (g < 已加载模块ID们.大小()) {
        整64 m = 已加载模块ID们.元素(g);
        如果 (m != 当前模块路径ID) {
            结果<整64, 整32> 查g = 模块成员键基们.获取(模块成员键(m, 名ID));
            如果 (查g.正常) {
                整64 键基g = 查g.值;   // 正向分支内提取（宿主 结果 流敏感惯例）
                结果<整64, 整32> 查公开g = 模块成员公开们.获取(模块成员键(m, 名ID));
                整64 公开g = 0;
                如果 (查公开g.正常) { 公开g = 查公开g.值; }
                如果 (公开g == 1) {
                    如果 (候选数t == 0) { 候选键基t = 键基g; }
                    候选数t = 候选数t + 1;
                }
            }
        }
        g++;
    }
    如果 (候选数t > 1) { 返回 0 - 2; }
    返回 候选键基t;
}

// 检查一个类型引用（类型文本ID）：内置/容器合成名（含 '$'）放行；限定文本
//   拆分直查成员索引；纯名三级。诊断：未声明的类型 / 类型是私有的 /
//   在多个模块中定义（宿主同款消息形态）。
函数 检查类型引用(向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断, 整64 类型文本ID) -> 空类型 {
    字符串 文本x = 驻留文本(类型文本ID);
    整64 长x = 字符串长度(文本x);
    如果 (长x == 0) { 返回; }
    // 引用/指针后缀剥离（E2E 150 误报根治）：裸类型引用/泛型实参位消费 '&'
    //   并入合成名（"整64&"）——剥尾部 '&'/'*' 后再判（指针层语义在节点附加，
    //   文本后缀仅合成名实参位形态；剥空=纯后缀异常形态放行）
    当 (长x > 0) {
        字符串 尾 = 字符串子串(文本x, 整32(长x - 1), 1);
        如果 (字符串比较(尾, "&") || 字符串比较(尾, "*")) {
            文本x = 字符串子串(文本x, 0, 整32(长x - 1));
            长x = 长x - 1;
        } 否则 {
            中断;
        }
    }
    如果 (长x == 0) { 返回; }
    如果 (是基础类型文本(文本x)) { 返回; }
    // 容器/结果 $ 合成名（向量$整64）泛型实参已扁平化，非用户结构体引用
    整64 含合成符 = 0;
    整64 ci = 0;
    当 (ci < 长x) {
        如果 (字符串比较(字符串子串(文本x, 整32(ci), 1), "$")) { 含合成符 = 1; }
        ci++;
    }
    如果 (含合成符 == 1) { 返回; }
    字符串 模块x = "";
    字符串 符号x = "";
    如果 (拆限定名(文本x, 模块x, 符号x) == 1) {
        如果 (是标准库模块名(模块x)) { 返回; }
        整64 来源模块x = 驻留(模块x);
        整64 符号名x = 驻留(符号x);
        结果<整64, 整32> 查成员x = 模块成员键基们.获取(模块成员键(来源模块x, 符号名x));
        如果 (!查成员x.正常) {
            表诊断(诊断, "[错误] 未声明的类型: " + 文本x);
            返回;
        }
        结果<整64, 整32> 查公开x = 模块成员公开们.获取(模块成员键(来源模块x, 符号名x));
        整64 公开x = 0;
        如果 (查公开x.正常) { 公开x = 查公开x.值; }
        如果 (公开x == 0 && 来源模块x != 当前模块路径ID) {
            表诊断(诊断, "[错误] 类型 '" + 符号x + "' 是私有的（模块 " + 模块x + "）");
        }
        返回;
    }
    整64 键基t = 类型键基查找(类型文本ID);
    如果 (键基t == 0 - 2) {
        表诊断(诊断, "[错误] 类型 '" + 文本x + "' 在多个模块中定义（调用存在歧义）");
        返回;
    }
    如果 (键基t < 0) {
        表诊断(诊断, "[错误] 未声明的类型: " + 文本x);
        返回;
    }
    // 命中：校验符号种类确为结构体（防类型位误引用函数/常量名）
    如果 (符号表.大小() > 0) {
        映射<整64, 符号> 全局层t = 符号表.元素(0);
        结果<符号, 整32> 查符号t = 全局层t.获取(键基t);
        如果 (查符号t.正常) {
            符号 找到t = 查符号t.值;
            如果 (找到t.种类 != 符号_结构体) {
                表诊断(诊断, "[错误] 未声明的类型: " + 文本x);
            }
        } 否则 {
            表诊断(诊断, "[错误] 未声明的类型: " + 文本x);
        }
    }
}

// ==================== 文件导入上下文构建（plans/018 第 3 层） ====================
// 每文件检查/生成前调用：设 当前模块路径ID、构建 ② 显式导入目标表（键基）、
//   ③ glob 模块路径列表；E0255 同款冲突检查（①×② 本地定义与显式导入同名、
//   ②×② 多次显式导入同名——宿主 checkImportLocalConflicts 语义对齐：
//   同源重复导入幂等合法、自导入豁免、私有符号导入拒绝）。轻量=真：跳过
//   E0255 与私有诊断（IR 生成阶段复用——诊断仅语义阶段一份）。
函数 构建文件导入上下文(字符串 模块路径, 向量<整64> 导入项平铺, 向量<整64> 全部模块ID们,
                        向量<字符串> 诊断, 布尔 轻量) -> 空类型 {
    当前模块路径ID = 驻留(模块路径);
    文件导入键基们.清空();
    已加载模块ID们 = 向量<整64>();
    三级键基缓存们.清空();
    // ---- ② 显式导入解析（平铺 = 交替 [绑定名ID, 限定名ID, ...]）----
    整64 p = 0;
    当 (p + 1 < 导入项平铺.大小()) {
        整64 绑定名 = 导入项平铺.元素(p);
        整64 限定名ID = 导入项平铺.元素(p + 1);
        p += 2;
        字符串 模块路径s = "";
        字符串 符号名s = "";
        如果 (拆限定名(驻留文本(限定名ID), 模块路径s, 符号名s) == 0) {
            // 单段（无 ::）= 模块整体导入形态（③ 层，语法层不进 导入项们）——
            //   防御：不构成绑定
            继续;
        }
        // 自导入豁免（宿主 B 裁决：来源首段 == 归属模块——不引入新绑定名，
        //   本地定义恒 ① 优先，仅启用限定自引用）
        如果 (字符串比较(模块路径s, 模块路径)) { 继续; }
        // stdlib 来源：符号不在 v2 加载树——B1 已改写限定名走内置表，不登记
        //   （键基 miss → 三级 miss → 内置兜底，行为不变）
        如果 (是标准库模块名(模块路径s)) { 继续; }
        整64 来源模块ID = 驻留(模块路径s);
        整64 符号名ID = 驻留(符号名s);
        // 可见性 + 存在性（宿主 3.6：跨模块引用只认公开成员；fail fast——
        //   导入不存在的符号=编译错误，绝不静默空绑定）。
        //   结果 流敏感检查惯例：正向分支内提取 .值 到局部变量
        整64 成员键基b = 0;
        结果<整64, 整32> 查成员 = 模块成员键基们.获取(模块成员键(来源模块ID, 符号名ID));
        如果 (查成员.正常) {
            成员键基b = 查成员.值;
        } 否则 {
            如果 (!轻量) {
                表诊断(诊断, "[错误] 导入的符号不存在: " + 模块路径s + "::" + 符号名s);
            }
            继续;
        }
        结果<整64, 整32> 查公开 = 模块成员公开们.获取(模块成员键(来源模块ID, 符号名ID));
        如果 (!查公开.正常) {
            如果 (!轻量) {
                表诊断(诊断, "[错误] 符号 '" + 符号名s + "' 为模块 '" + 模块路径s +
                              "' 私有（未以 公开: 标注），不可导入（规格08 5.9.3）");
            }
            继续;
        }
        // ①×②：与本地定义同名 = 编译错误（宿主 E0255 对齐——按纯名维度，
        //   不分种类；签名不同的重载族同名同判）
        结果<整64, 整32> 查本地 = 模块成员键基们.获取(模块成员键(当前模块路径ID, 绑定名));
        如果 (查本地.正常) {
            如果 (!轻量) {
                表诊断(诊断, "[错误] 导入与本地定义同名: " + 驻留文本(绑定名) +
                              "（导入自 " + 模块路径s + "——E0255，改名或删其一）");
            }
            继续;
        }
        // ②×②：不同来源的同名显式导入 = 编译错误；同源重复导入幂等合法
        结果<整64, 整32> 查已绑 = 文件导入键基们.获取(绑定名);
        如果 (查已绑.正常) {
            整64 已绑键基 = 查已绑.值;
            如果 (已绑键基 != 成员键基b && !轻量) {
                表诊断(诊断, "[错误] 多次显式导入同名: " + 驻留文本(绑定名) +
                              "（规格08-三 名称解析）");
            }
            继续;
        }
        结果<空类型, 整32> 设绑定 = 文件导入键基们.设置(绑定名, 成员键基b);
        如果 (!设绑定.正常) { 运行时错误(4); }
    }
    // ---- ③ 合并全局可见：全部已加载模块 ID 登记（stdlib 不在成员索引天然
    //    miss；歧义在三级决议使用点判定）----
    已加载模块ID们 = 全部模块ID们;
}

// 诊断记录
函数 表诊断(向量<字符串> 诊断, 字符串 消息) -> 空类型 {
    结果<空类型, 整32> 加 = 诊断.追加(消息);
    如果 (!加.正常) { 运行时错误(4); }
}
// ==================== 声明收集（第一趟：函数/结构体签名） ====================
// 呈报③方案A（2026-09-06）：函数登记键=签名键 名#参数串（宿主 signatureKey
//   对齐）——同名不同参数串=重载共存（多键）；同名同参数串=重定义诊断
//   （原纯名键注册失败被静默吞：`如果 (忽略 == 0) { }`——静默覆盖家族）。
//   同步登记函数签名表（语义层未声明检查回退用；IR生成入口清空重收集=权威）。
//   双键补登记（2026-09-06 用户裁决方案A）：纯名键同名唯一时补——既有纯名
//   查函数消费点（是引用返回调用 等）零回归（E2E 150 解锁暴露回归根因）。
函数 声明收集(向量<节点> 池, 整32 程序节点, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断,
              字符串 模块路径, 映射<整64, 整64>& 公开表) -> 空类型 {
    整64 本模块ID = 驻留(模块路径);
    节点 程序 = 池.元素(程序节点);
    整64 i = 整64(程序.子起点);
    当 (i < 整64(程序.子终点)) {
        节点 声明 = 池.元素(整32(i));
        // 可见性（plans/018 第 3 层：公开: 标签块——语法层 顶层公开们 快照；
        //   缺省私有。符号.附加=1 公开——跨模块 ②②③ 解析只认公开成员）
        整64 是否公开 = 0;
        结果<整64, 整32> 查公开 = 公开表.获取(整64(i));
        如果 (查公开.正常) { 是否公开 = 1; }
        如果 (声明.类型 == 节点_函数) {
            字符串 参数串 = 函数参数串(池, 整32(i));
            // plans/018 第 3/4 层：登记键升级为链接键（键基#参数串）——键基=
            //   主模块纯名（行为不变）/其余 模块$名（跨模块同名合法共存）
            整64 键基i = 键基合成(模块路径, 整64(声明.文本));
            登记函数签名K(池, 整32(i), 键基i);
            整64 签名键 = 函数签名键(键基i, 参数串);
            整64 忽略 = 表注册(符号表, 签名键, 整64(声明.附加), 符号_函数, 是否公开);
            如果 (忽略 == 0) {
                // 同模块同签名重复=重定义（跨模块同名键不同——不再误报）
                表诊断(诊断, "[错误] 函数重定义: " + 模块路径 + "::" +
                              驻留文本(整64(声明.文本)) + "(" + 参数串 + ")");
            }
            // 模块成员索引（三级解析 ①③ 数据源；纯名维度——重载族共享条目，
            //   值=首登记键基）
            结果<空类型, 整32> 设成员 = 模块成员键基们.设置(
                模块成员键(本模块ID, 整64(声明.文本)), 键基i);
            如果 (!设成员.正常) { 运行时错误(4); }
            如果 (是否公开 == 1) {
                结果<空类型, 整32> 设公开 = 模块成员公开们.设置(
                    模块成员键(本模块ID, 整64(声明.文本)), 1);
                如果 (!设公开.正常) { 运行时错误(4); }
            }
            // 双键登记（2026-09-06 缺陷零容忍）：纯名键——仅主模块（键基=纯名，
            //   行为不变）。非主模块纯名查找经三级解析（①成员索引）覆盖，不再
            //   平铺（平铺=跨模块同名遮蔽/先收集赢 的旧静默语义，已废止）。
            如果 (是主模块路径(模块路径)) {
                结果<整64, 整32> 查纯名候选 = 函数签名个数们.获取(键基i);
                如果 (查纯名候选.正常) {
                    如果 (查纯名候选.值 == 1) {
                        整64 纯名忽略 = 表注册(符号表, 键基i, 整64(声明.附加), 符号_函数, 是否公开);
                        如果 (纯名忽略 == 0) { }
                    }
                }
            }
        }
        如果 (声明.类型 == 节点_结构体) {
            整64 键基s = 键基合成(模块路径, 整64(声明.文本));
            整64 忽略2 = 表注册(符号表, 键基s, 0, 符号_结构体, 是否公开);
            如果 (忽略2 == 0) { }
            结果<空类型, 整32> 设成员s = 模块成员键基们.设置(
                模块成员键(本模块ID, 整64(声明.文本)), 键基s);
            如果 (!设成员s.正常) { 运行时错误(4); }
            如果 (是否公开 == 1) {
                结果<空类型, 整32> 设公开s = 模块成员公开们.设置(
                    模块成员键(本模块ID, 整64(声明.文本)), 1);
                如果 (!设公开s.正常) { 运行时错误(4); }
            }
        }
        如果 (声明.类型 == 节点_常量声明) {
            // P7a：顶层常量登记（类型ID 记 整64 名ID——v2 整数字面量统一按 整64）；
            //   多文件两趟结构下第一趟全文件收集——分桶后跨模块常量引用经
            //   三级解析（②③ 须公开；① 同模块直查）
            整64 键基c = 键基合成(模块路径, 整64(声明.文本));
            整64 忽略3 = 表注册(符号表, 键基c, 驻留("整64"), 符号_常量, 是否公开);
            如果 (忽略3 == 0) { }
            结果<空类型, 整32> 设成员c = 模块成员键基们.设置(
                模块成员键(本模块ID, 整64(声明.文本)), 键基c);
            如果 (!设成员c.正常) { 运行时错误(4); }
            如果 (是否公开 == 1) {
                结果<空类型, 整32> 设公开c = 模块成员公开们.设置(
                    模块成员键(本模块ID, 整64(声明.文本)), 1);
                如果 (!设公开c.正常) { 运行时错误(4); }
            }
        }
        如果 (声明.类型 == 节点_静态声明) {
            // ②c C：顶层静态登记（符号_变量，全局作用域——跨函数标识符解析；
            //   类型ID 取声明附加的类型节点文本）
            整64 静态类型ID = 驻留("整64");
            // 守卫 >= 0（池索引 0 合法——IR生成 同款 lessons）：首静态声明的类型
            //   节点恰在池 0 时原 > 0 漏登记，类型退回 整64 默认
            如果 (声明.附加 >= 0 && 声明.附加 < 池.大小()) {
                节点 类型节点 = 池.元素(整32(声明.附加));
                静态类型ID = 整64(类型节点.文本);
            }
            整64 键基st = 键基合成(模块路径, 整64(声明.文本));
            整64 忽略4 = 表注册(符号表, 键基st, 静态类型ID, 符号_变量, 是否公开);
            如果 (忽略4 == 0) { }
            结果<空类型, 整32> 设成员st = 模块成员键基们.设置(
                模块成员键(本模块ID, 整64(声明.文本)), 键基st);
            如果 (!设成员st.正常) { 运行时错误(4); }
            如果 (是否公开 == 1) {
                结果<空类型, 整32> 设公开st = 模块成员公开们.设置(
                    模块成员键(本模块ID, 整64(声明.文本)), 1);
                如果 (!设公开st.正常) { 运行时错误(4); }
            }
        }
        i++;
    }
}

// ==================== 成员访问偏移标注（P6c） ====================
// 后缀栈遍历表达式区间 [起点, 终点)：标识符/字面量压类型；节点_成员 弹对象类型
//   查结构体字段偏移并写入节点.附加（IR 生成直接用）；节点_取地址/解引用 弹压类型。
// 返回 0=成功；-1=失败（类型未知/字段不存在）。
函数 标注成员偏移(向量<节点> 池, 整32 起点, 整32 终点,
                   向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 整64 {
    向量<整64> 类型栈 = 向量<整64>();
    整32 位置 = 起点;
    当 (位置 < 终点) {
        节点 n = 池.元素(位置);
        如果 (n.类型 == 节点_标识符) {
            整64 类型ID = 表查找类型ID(符号表, 整64(n.文本));
            如果 (类型ID == -1) { 返回 -1; }
            结果<空类型, 整32> 加 = 类型栈.追加(类型ID);
            如果 (!加.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_整数字面量) {
            结果<空类型, 整32> 加 = 类型栈.追加(驻留("整32"));
            如果 (!加.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_布尔字面量) {
            // 灰色点①根治（2026-09-04）：真/假 独立节点——类型栈压 布尔
            结果<空类型, 整32> 加布 = 类型栈.追加(驻留("布尔"));
            如果 (!加布.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_浮点字面量) {
            结果<空类型, 整32> 加 = 类型栈.追加(驻留("浮64"));
            如果 (!加.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_字符串字面量) {
            结果<空类型, 整32> 加 = 类型栈.追加(驻留("字符串"));
            如果 (!加.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_成员) {
            // 成员访问：偏移已由语法层写入 n.附加；字段类型暂按 整64
            结果<空类型, 整32> 加2 = 类型栈.追加(驻留("整64"));
            如果 (!加2.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_取地址) {
            // & 对象：类型不变（地址即 整64 槽）
            结果<空类型, 整32> 加3 = 类型栈.追加(驻留("整64"));
            如果 (!加3.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_解引用) {
            // * 指针：弹指针 -> 压 整64（暂标量）
            如果 (类型栈.大小() >= 1) {
                结果<空类型, 整32> 删2 = 类型栈.删除(类型栈.大小() - 1);
                如果 (!删2.正常) { 运行时错误(4); }
            }
            结果<空类型, 整32> 加4 = 类型栈.追加(驻留("整64"));
            如果 (!加4.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_二元运算 || n.类型 == 节点_调用 || n.类型 == 节点_下标) {
            // 二元/下标：弹2压1；调用：弹实参+被调，压 整64（暂）
            如果 (n.类型 == 节点_二元运算 || n.类型 == 节点_下标) {
                如果 (类型栈.大小() >= 2) {
                    结果<空类型, 整32> 删3 = 类型栈.删除(类型栈.大小() - 1);
                    如果 (!删3.正常) { 运行时错误(4); }
                    结果<空类型, 整32> 删4 = 类型栈.删除(类型栈.大小() - 1);
                    如果 (!删4.正常) { 运行时错误(4); }
                }
            } 否则 {
                整64 弹数 = n.附加 + 1;  // 实参 + 被调
                当 (弹数 > 0 && 类型栈.大小() > 0) {
                    结果<空类型, 整32> 删5 = 类型栈.删除(类型栈.大小() - 1);
                    如果 (!删5.正常) { 运行时错误(4); }
                    弹数--;
                }
            }
            结果<空类型, 整32> 加5 = 类型栈.追加(驻留("整64"));
            如果 (!加5.正常) { 运行时错误(4); }
        }
        位置++;
    }
    返回 0;
}

// ③ 第六波（2026-09-03）：三元两分支类型可合并判定——同ID 或同类数值族宽化
//   （整数族：整8/16/32/64、正8/16/32/64、布尔、字符 互通——真/假=1/0 字面量
//   语义、字符=零扩展整数，槽统一 8 字节 Load 整64 无损；浮点族：浮32/64 互通）。
//   跨类（整 vs 浮：位模式不同 / 字符串 vs 整数：指针槽 vs 数值槽）拒绝——
//   Rust if 表达式同款纪律（无隐式跨类转换）
函数 类型可合并(整64 类型A, 整64 类型B) -> 布尔 {
    如果 (类型A == 类型B) { 返回 真; }
    字符串 名A = 驻留文本(类型A);
    字符串 名B = 驻留文本(类型B);
    布尔 A整数 = 字符串比较(名A, "整8") || 字符串比较(名A, "整16") ||
                  字符串比较(名A, "整32") || 字符串比较(名A, "整64") ||
                  字符串比较(名A, "正8") || 字符串比较(名A, "正16") ||
                  字符串比较(名A, "正32") || 字符串比较(名A, "正64") ||
                  字符串比较(名A, "布尔") || 字符串比较(名A, "字符");
    布尔 B整数 = 字符串比较(名B, "整8") || 字符串比较(名B, "整16") ||
                  字符串比较(名B, "整32") || 字符串比较(名B, "整64") ||
                  字符串比较(名B, "正8") || 字符串比较(名B, "正16") ||
                  字符串比较(名B, "正32") || 字符串比较(名B, "正64") ||
                  字符串比较(名B, "布尔") || 字符串比较(名B, "字符");
    如果 (A整数 && B整数) { 返回 真; }
    布尔 A浮点 = 字符串比较(名A, "浮32") || 字符串比较(名A, "浮64");
    布尔 B浮点 = 字符串比较(名B, "浮32") || 字符串比较(名B, "浮64");
    如果 (A浮点 && B浮点) { 返回 真; }
    返回 假;
}

// 检查表达式：返回类型ID（-1=未知）；未声明标识符 -> 诊断
函数 检查表达式(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 整64 {
    节点 n = 池.元素(节点索引);
    如果 (n.类型 == 节点_整数字面量) { 返回 驻留("整32"); }
    // 灰色点①根治（2026-09-04）：真/假 独立节点——类型推导 布尔（三元分支
    //   类型可合并判定 布尔∈整数族 互通不变）
    如果 (n.类型 == 节点_布尔字面量) { 返回 驻留("布尔"); }
    如果 (n.类型 == 节点_浮点字面量) { 返回 驻留("浮64"); }
    如果 (n.类型 == 节点_字符串字面量) { 返回 驻留("字符串"); }
    如果 (n.类型 == 节点_标识符) {
        整64 找到类型 = 表查找类型ID(符号表, 整64(n.文本));
        如果 (找到类型 != -1) {
            返回 找到类型;
        }
        // P7b（2026-09-01）：容器/结果 合成名（向量$整64/结果$空类型$整32）合法——
        //   构造调用 向量<整64>() 的被调标识符（语法层已合成 $ 实例名）。
        如果 (是容器类(驻留文本(整64(n.文本))) || 是结果类型(驻留文本(整64(n.文本)))) {
            返回 整64(n.文本);
        }
        // P6g（2026-08-30）：类型名（整32/整64/浮64/布尔/字符串）作标识符合法——
        //   类型转换 整32(x) 的被调标识符；不作为函数/变量时报未声明。
        字符串 名文本 = 驻留文本(整64(n.文本));
        如果 (字符串比较(名文本, "整32") || 字符串比较(名文本, "整64") ||
             字符串比较(名文本, "浮32") || 字符串比较(名文本, "浮64") ||
             字符串比较(名文本, "布尔") || 字符串比较(名文本, "字符") ||
             字符串比较(名文本, "字符串") || 字符串比较(名文本, "正32") ||
             字符串比较(名文本, "正64") || 字符串比较(名文本, "整8") ||
             字符串比较(名文本, "整16") || 字符串比较(名文本, "正8") ||
             字符串比较(名文本, "正16")) {
            返回 整64(n.文本);
        }
        // ③ 第一波（2026-09-03）：内置函数名作标识符合法（调用的被调标识符子节点
        //   先经此处检查）；类型大小 编译期折叠（返回 整64）。
        如果 (内置函数返回类型ID(名文本) != 0) { 返回 内置函数返回类型ID(名文本); }
        如果 (字符串比较(名文本, "类型大小")) { 返回 驻留("整64"); }
        // plans/018 第 3 层：限定合成名（工具库::版本）——语句根区间线性检查会
        //   把调用被调标识符当裸标识符送达本分支（检查块 语句根派发惯例：每节点
        //   恰在其作用域访问一次）。stdlib 限定已由上方内置表命中；此处解析用户
        //   模块限定（成员索引+公开强制）——限定调用恒明确不参与遮蔽，规格 5.9.7
        字符串 标限模块s = "";
        字符串 标限符号s = "";
        如果 (拆限定名(名文本, 标限模块s, 标限符号s) == 1 &&
             !是标准库模块名(标限模块s)) {
            整64 标源ID = 驻留(标限模块s);
            整64 标符ID = 驻留(标限符号s);
            整64 标键基 = 0;
            结果<整64, 整32> 查标限 = 模块成员键基们.获取(模块成员键(标源ID, 标符ID));
            如果 (查标限.正常) {
                标键基 = 查标限.值;
            } 否则 {
                表诊断(诊断, "[错误] 未声明的标识符: " + 名文本 +
                              "（模块 " + 标限模块s + " 无符号 " + 标限符号s + "）");
                返回 -1;
            }
            布尔 标自模块 = 字符串比较(标限模块s, 驻留文本(当前模块路径ID));
            如果 (!标自模块) {
                结果<整64, 整32> 查标公 = 模块成员公开们.获取(模块成员键(标源ID, 标符ID));
                如果 (!查标公.正常) {
                    表诊断(诊断, "[错误] 符号 '" + 标限符号s + "' 为模块 '" + 标限模块s +
                                  "' 私有（未以 公开: 标注），不可限定调用（规格08 5.9.3）");
                    返回 -1;
                }
            }
            // 返回类型：签名表首个候选（重载精确决议在 IR 层）或符号表键基条目
            //   （候选数提取——结果 流敏感检查惯例）
            整64 标类型 = -1;
            整64 标候选数 = 0;
            结果<整64, 整32> 查标数 = 函数签名个数们.获取(标键基);
            如果 (查标数.正常) {
                标候选数 = 查标数.值;
            }
            如果 (标候选数 > 0) {
                结果<整64, 整32> 查标串 = 函数签名参数串们.获取(标键基 * 键位移);
                如果 (查标串.正常) {
                    标类型 = 全局层查类型(符号表, 函数签名键(标键基, 驻留文本(查标串.值)));
                }
            }
            如果 (标类型 == -1) {
                标类型 = 全局层查类型(符号表, 标键基);
            }
            返回 标类型;
        }
        // 呈报③方案A（2026-09-06）：函数登记键=签名键（名#参数串）——纯名查不到
        //   合法函数，按签名表同名候选回退（返回类型取首个候选；精确决议在 IR 层）
        //   plans/018 第 3 层：回退键基化（非主模块函数键=模块$名——三级决议）；
        //   签名键直查全局层（复合键不经三级）
        整64 标识键基 = 三级键基查找(符号表, 整64(n.文本), 0 - 1);
        如果 (标识键基 >= 0) {
            结果<整64, 整32> 查标识签数 = 函数签名个数们.获取(标识键基);
            如果 (查标识签数.正常) {
                如果 (查标识签数.值 > 0) {
                    结果<整64, 整32> 查标识签串 = 函数签名参数串们.获取(标识键基 * 键位移);
                    如果 (查标识签串.正常) {
                        整64 标识签键 = 函数签名键(标识键基, 驻留文本(查标识签串.值));
                        整64 标识签类型 = 全局层查类型(符号表, 标识签键);
                        如果 (标识签类型 != -1) { 返回 标识签类型; }
                    }
                }
            }
        }
        // -2 = 使用点歧义（E0659 已在三级决议内经缓冲诊断）——不再重复报未声明
        如果 (标识键基 != -2) {
            表诊断(诊断, "[错误] 未声明标识符: " + 名文本);
        }
        返回 -1;
    }
    如果 (n.类型 == 节点_成员) {
        // 成员访问：偏移已标注到附加；字段类型暂 整64
        返回 驻留("整64");
    }
    如果 (n.类型 == 节点_下标) {
        // ③ 第二波（2026-09-03）：字符串[i] 逐字节访问（宿主 A-1 对齐：步进 1、
        //   结果类型 字符）。对象白名单=字符串标识符（局部/参数）/字符串成员字段；
        // ③ 第三波：指针对象 p[i]（宿主 ir_expr.cpp:1555 对齐——p[i] ≡ *(p+i)
        //   步进按所指元素大小，元素类型=所指类型）。其余对象形态（字面量/调用/
        //   解引用/容器/结构体/指针字段…）显式拒绝——半实现纪律：未覆盖形态
        //   错误放行=静默错误代码（IR 层按指针值+步进生成，非白名单对象必产
        //   垃圾地址）。
        如果 (n.子起点 > 0) {
            节点 对象节点x = 池.元素(整32(n.子起点));
            如果 (对象节点x.类型 == 节点_标识符) {
                // 指针对象先行（指针变量表命中即返回所指类型；与符号表字符串
                //   判定无交集——指针登记以类型节点指针层数为准，互不误伤）。
                //   所指类型白名单（IR 加载宽度覆盖面）外的显式拒绝。
                结果<整64, 整32> 查指针x = 指针变量表.获取(整64(对象节点x.文本));
                如果 (查指针x.正常) {
                    字符串 所指文本x = 驻留文本(查指针x.值);
                    如果 (!指针下标所指合法(所指文本x)) {
                        表诊断(诊断, "[错误] 指针下标所指类型未支持（须标量/字符串）: " + 所指文本x);
                        返回 -1;
                    }
                    返回 查指针x.值;
                }
                整64 对象类型x = 表查找类型ID(符号表, 整64(对象节点x.文本));
                如果 (对象类型x == 驻留("字符串")) { 返回 驻留("字符"); }
                如果 (对象类型x != -1) {
                    表诊断(诊断, "[错误] 下标对象须为字符串或指针: " + 驻留文本(整64(对象节点x.文本)));
                }
                // -1=未声明：对象标识符节点自身检查已诊断（语句层线性遍历先到）
                返回 -1;
            }
            如果 (对象节点x.类型 == 节点_成员) {
                // 成员对象：经 变量结构体表 推导对象结构体 -> 字段类型（字符串字段才可下标）
                如果 (对象节点x.子起点 > 0) {
                    节点 成员对象x = 池.元素(整32(对象节点x.子起点));
                    如果 (成员对象x.类型 == 节点_标识符) {
                        结果<整64, 整32> 查结构体x = 变量结构体表.获取(整64(成员对象x.文本));
                        如果 (查结构体x.正常) {
                            // 值=结构体名ID（1=结构体名标记，非对象结构体）
                            如果 (查结构体x.值 != 1) {
                                整64 字段类型x = 查字段类型ID(查结构体x.值, 整64(对象节点x.文本));
                                如果 (字段类型x == 驻留("字符串")) { 返回 驻留("字符"); }
                                如果 (字段类型x != 0) {
                                    表诊断(诊断, "[错误] 下标对象须为字符串或指针: ." + 驻留文本(整64(对象节点x.文本)));
                                }
                            }
                        }
                    }
                }
                返回 -1;
            }
            表诊断(诊断, "[错误] 下标对象形态未支持（须字符串变量/字符串字段/指针变量）");
            返回 -1;
        }
        返回 -1;
    }
    如果 (n.类型 == 节点_取地址 || n.类型 == 节点_解引用) {
        返回 驻留("整64");
    }
    如果 (n.类型 == 节点_调用) {
        // P6g（2026-08-30）：调用/类型转换——被调标识符节点索引在 子起点
        //   （语法层后缀链记录）。若其文本是类型名（整32/整64/浮64/布尔/字符串）
        //   -> 类型转换；否则函数调用，查符号表返回类型（符号_函数 附加=返回类型ID）。
        整64 调用起点 = 整64(n.子起点);
        如果 (调用起点 > 0) {
            节点 被调节点 = 池.元素(整32(调用起点));
            如果 (被调节点.类型 == 节点_标识符) {
                整64 被调名 = 整64(被调节点.文本);
                字符串 被调文本 = 驻留文本(被调名);
                // P7b：容器类构造调用（向量<整64>() 语法层已合成 向量$整64 被调标识符）
                //   合法——返回类型暂按 整64（对象指针）兜底
                如果 (是容器类(被调文本)) {
                    返回 驻留("整64");
                }
                // 灰色点④根治（2026-09-04 用户裁决立案·缺陷零容忍）：强转类型名
                //   白名单补 整8/整16（宿主窄宽强转已支持——整8(300)=44；原白名单
                //   九名缺失时落「未声明函数: 整8」）。
                //   2026-09-04 缺陷零容忍收口：正8/正16 补入（原「显式拒绝」系
                //   无符号语义缺位搁置——违反尽善尽美；现 IR 层 T_正8/T_正16
                //   零扩展标注+双后端 movzx/uxtb 落地，正8(200)=200 语义正确）
                如果 (字符串比较(被调文本, "整32") || 字符串比较(被调文本, "整64") ||
                     字符串比较(被调文本, "浮32") || 字符串比较(被调文本, "浮64") ||
                     字符串比较(被调文本, "布尔") || 字符串比较(被调文本, "字符") ||
                     字符串比较(被调文本, "字符串") || 字符串比较(被调文本, "正32") ||
                     字符串比较(被调文本, "正64") || 字符串比较(被调文本, "整8") ||
                     字符串比较(被调文本, "整16") || 字符串比较(被调文本, "正8") ||
                     字符串比较(被调文本, "正16")) {
                    返回 被调名;
                }
                // 函数调用：查符号表（符号_函数 附加=返回类型ID）
                // plans/018 第 3 层：表查找类型ID 内部已三级化（①②③）——命中
                //   用户函数时把决议键基写入 调用决议键基们（语义驱动 IR：第 4 层
                //   决议函数符号 据此锁定候选模块桶，宿主 resolvedSignature 同构）
                整64 找到类型 = 表查找类型ID(符号表, 被调名);
                如果 (找到类型 != -1) {
                    登记调用决议(符号表, 被调名, 整64(节点索引));
                    返回 找到类型;
                }
                // 呈报③方案A（2026-09-06）：签名键改造后纯名查不到——按签名表
                //   同名候选回退（返回类型取首个候选；精确决议在 IR 层）
                //   plans/018 第 3 层：回退键基化（三级决议）；签名键直查全局层
                整64 调键基 = 三级键基查找(符号表, 被调名, 整64(n.附加));
                如果 (调键基 >= 0) {
                    结果<整64, 整32> 查调签数 = 函数签名个数们.获取(调键基);
                    如果 (查调签数.正常) {
                        如果 (查调签数.值 > 0) {
                            结果<整64, 整32> 查调签串 = 函数签名参数串们.获取(调键基 * 键位移);
                            如果 (查调签串.正常) {
                                整64 调签键 = 函数签名键(调键基, 驻留文本(查调签串.值));
                                整64 调签类型 = 全局层查类型(符号表, 调签键);
                                如果 (调签类型 != -1) {
                                    登记调用决议(符号表, 被调名, 整64(节点索引));
                                    返回 调签类型;
                                }
                            }
                        }
                    }
                }
                // ③ 第一波（2026-09-03）：内置函数调用（驻留/字符串族/运行时错误——
                //   IR 层映射 ASCII 运行时符号直调）；类型大小(类型) 编译期折叠 -> 整64
                整64 内置返回 = 内置函数返回类型ID(被调文本);
                如果 (内置返回 != 0) { 返回 内置返回; }
                如果 (字符串比较(被调文本, "类型大小")) { 返回 驻留("整64"); }
                // plans/018 第 4 层：用户模块限定调用 m::x（限定调用恒明确、不参与
                //   遮蔽，规格 5.9.7）——B1 改写产物与显式限定同形态；模块已加载即
                //   可用（宿主呈报一B「限定调用按已加载放行」对齐），但符号须存在
                //   且（跨模块时）公开；stdlib 前面内置表已兜底，此处仅用户模块
                字符串 限定模块s = "";
                字符串 限定符号s = "";
                如果 (拆限定名(被调文本, 限定模块s, 限定符号s) == 1 &&
                     !是标准库模块名(限定模块s)) {
                    整64 限源ID = 驻留(限定模块s);
                    整64 限符ID = 驻留(限定符号s);
                    整64 限键基 = 0;
                    结果<整64, 整32> 查限 = 模块成员键基们.获取(模块成员键(限源ID, 限符ID));
                    如果 (查限.正常) {
                        限键基 = 查限.值;
                    } 否则 {
                        表诊断(诊断, "[错误] 未声明的标识符: " + 被调文本 +
                                      "（模块 " + 限定模块s + " 无符号 " + 限定符号s + "）");
                        返回 -1;
                    }
                    布尔 限自模块 = 字符串比较(限定模块s, 驻留文本(当前模块路径ID));
                    如果 (!限自模块) {
                        结果<整64, 整32> 查限公 = 模块成员公开们.获取(模块成员键(限源ID, 限符ID));
                        如果 (!查限公.正常) {
                            表诊断(诊断, "[错误] 符号 '" + 限定符号s + "' 为模块 '" +
                                          限定模块s + "' 私有（未以 公开: 标注），不可限定调用（规格08 5.9.3）");
                            返回 -1;
                        }
                    }
                    // 候选数提取（结果 流敏感检查惯例）
                    整64 限候选数 = 0;
                    结果<整64, 整32> 查限数 = 函数签名个数们.获取(限键基);
                    如果 (查限数.正常) {
                        限候选数 = 查限数.值;
                    }
                    如果 (限候选数 > 0) {
                        调用决议登记(整64(节点索引), 限键基);
                    }
                    // 返回类型：签名表首个候选（重载精确决议在 IR 层）或符号表键基条目
                    整64 限类型 = -1;
                    如果 (限候选数 > 0) {
                        结果<整64, 整32> 查限串 = 函数签名参数串们.获取(限键基 * 键位移);
                        如果 (查限串.正常) {
                            限类型 = 全局层查类型(符号表, 函数签名键(限键基, 驻留文本(查限串.值)));
                        }
                    }
                    如果 (限类型 == -1) {
                        限类型 = 全局层查类型(符号表, 限键基);
                    }
                    返回 限类型;
                }
                // -2 = 使用点歧义（E0659 已在三级决议内经缓冲诊断）——不重复报
                如果 (三级键基查找(符号表, 被调名, 0 - 1) != -2) {
                    表诊断(诊断, "[错误] 未声明函数: " + 被调文本);
                }
                返回 -1;
            }
        }
        // 无被调信息：整64 兜底
        返回 驻留("整64");
    }
    如果 (n.类型 == 节点_二元运算) {
        // 灰色点②方案A（2026-09-04 用户裁决）：字符串比较运算符显式拒绝——
        //   规范 plans/001 Task 2.8（比较运算符仅整型/浮点变体，字符串不参与
        //   运算符比较；等价能力 字符串比较（相等）/字符串字典序（全序））。
        //   原按指针地址放行=同内容异地址 ==/!= 恒假（拼接产物静默陷阱）。
        //   操作数类型经区间末端节点递归推导（三元同款技巧）：普通/短路二元
        //   统一 子起点=右操作数起点、附加=左操作数起点——左末=子起点-1、
        //   右末=本节点索引-1。字面量/标识符形态可靠推导；拼接产物/成员字段
        //   推导 -1/整64 兜底=检不出（v2 类型推导既有半实现面，诚实边界——
        //   随 v2 语义类型推导完善收口，宿主侧已全形态覆盖）。返回 -1（比较
        //   产物类型不参与下游推导；三元末端为二元时原亦 -1 跳过，无回归）
        字符串 op文本 = 驻留文本(整64(n.文本));
        布尔 是比较符 = 字符串比较(op文本, "==") || 字符串比较(op文本, "!=") ||
                       字符串比较(op文本, "<") || 字符串比较(op文本, ">") ||
                       字符串比较(op文本, "<=") || 字符串比较(op文本, ">=");
        如果 (是比较符 && n.子起点 > 0) {
            整64 左类型比 = 检查表达式(池, 整32(n.子起点 - 1), 符号表, 诊断);
            整64 右类型比 = 检查表达式(池, 整32(节点索引 - 1), 符号表, 诊断);
            如果 (左类型比 == 驻留("字符串") && 右类型比 == 驻留("字符串")) {
                表诊断(诊断, "[错误] 字符串不支持 ==/!=/</> 比较运算符（按地址比较而非内容）——相等用 字符串比较(a,b)，全序用 字符串字典序(a,b)");
            }
        }
        返回 -1;
    }
    如果 (n.类型 == 节点_三元运算) {
        // ③ 第六波：三元两分支类型一致性——段末端节点递归推导（真值末端=附加-1、
        //   假值末端=子终点-1）；未知(-1)任一侧跳过（级联防）。条件段类型不强制
        //   （条件跳转按非零判——同 如果/当 惯例）；三段标识符检查由语句根区间
        //   线性遍历覆盖（同二元惯例）。返回真值类型（IR 汇合槽按真分支类型读）
        整64 真类型 = 检查表达式(池, 整32(n.附加 - 1), 符号表, 诊断);
        整64 假类型 = 检查表达式(池, 整32(n.子终点 - 1), 符号表, 诊断);
        如果 (真类型 != -1 && 假类型 != -1) {
            如果 (!类型可合并(真类型, 假类型)) {
                表诊断(诊断, "[错误] 三元两分支类型不一致: " + 驻留文本(真类型) +
                       " 与 " + 驻留文本(假类型));
            }
        }
        如果 (真类型 != -1) { 返回 真类型; }
        返回 假类型;
    }
    返回 -1;
}
函数 检查语句(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 空类型 {
    节点 n = 池.元素(节点索引);
    如果 (n.类型 == 节点_返回语句) {
        整64 i = 整64(n.子起点);
        当 (i < 整64(n.子终点)) {
            整64 忽略 = 检查表达式(池, 整32(i), 符号表, 诊断);
            如果 (忽略 == -1) { }
            i++;
        }
        返回;
    }
    如果 (n.类型 == 节点_变量声明) {
        // ③ 第二波（方案A）：符号 类型ID 统一为类型名ID——原存类型节点索引，与
        //   顶层静态/常量/函数的名ID 约定不一致（消费端无从分辨，下标对象白名单
        //   判定须按名ID 比较）；顺带根治块级遮蔽检查 驻留文本(节点索引) 取错文本
        整64 类型ID = 整64(n.附加);
        // 守卫用 >=0：池索引 0 是合法类型节点位（>0 会漏归一首个声明——实测
        //   变体 a 裸块容器因此按节点索引 0 查 驻留文本 取垃圾文本）
        如果 (类型ID >= 0 && 类型ID < 池.大小()) {
            节点 类型节点值 = 池.元素(整32(类型ID));
            如果 (类型节点值.类型 == 节点_类型) {
                类型ID = 整64(类型节点值.文本);
                // plans/018 类型分桶：变量类型存在性/公开性/歧义诊断（fail fast）
                检查类型引用(符号表, 诊断, 类型ID);
                // ③ 第三波：指针局部登记（同参数约定：附加=指针层数 1..255）
                如果 (类型节点值.附加 >= 1 && 类型节点值.附加 < 256) {
                    结果<空类型, 整32> 设指针局部 = 指针变量表.设置(整64(n.文本), 类型ID);
                    如果 (!设指针局部.正常) { 运行时错误(4); }
                }
                // 引用局部纪律（2026-09-04，IR生成.cn 冒烟 96 错根治配套）：
                //   C++ 同款——必须初始化 + 初始化须为可绑定左值形态（标识符/
                //   成员/解引用/下标（指针下标 p[i]——IR 生成左值地址 已支持）/
                //   引用返回调用（取值(p)——宿主 P3-18 白名单对齐）——绑定右值=
                //   普通调用结果/二元运算/字面量拒绝，防空引用与静默错误代码。
                如果 (类型节点值.附加 == 256) {
                    如果 (n.子起点 >= n.子终点) {
                        表诊断(诊断, "[错误] 引用声明必须初始化（绑定既有对象）: " +
                                      驻留文本(整64(n.文本)));
                    } 否则 {
                        节点 初始化末y = 池.元素(n.子终点 - 1);
                        布尔 初始化是引用调用 = 假;
                        如果 (初始化末y.类型 == 节点_调用) {
                            初始化是引用调用 = 是引用返回调用(池, n.子终点 - 1, 符号表);
                        }
                        如果 (初始化末y.类型 != 节点_标识符 && 初始化末y.类型 != 节点_成员 &&
                             初始化末y.类型 != 节点_解引用 && 初始化末y.类型 != 节点_下标 &&
                             !初始化是引用调用) {
                            表诊断(诊断, "[错误] 引用初始化必须是可绑定左值（变量/成员/下标/解引用/引用返回调用）: " +
                                          驻留文本(整64(n.文本)));
                        }
                    }
                }
            }
        }
        // 块级作用域析构防护（用户裁决项2 配套）：嵌套块同名容器变量遮蔽——
        //   v2 局部槽同名合槽（预扫），遮蔽会泄漏/双释，P7c 完整块上下文前不支持
        如果 (符号表.大小() >= 3) {  // 全局+函数 之外还有块层（嵌套块内）
            字符串 声明类型文本 = 驻留文本(类型ID);
            如果 (是容器类(声明类型文本)) {
                整64 层 = 符号表.大小() - 2;   // 跳过当前块层，从外层块向上查
                当 (层 >= 2) {
                    映射<整64, 符号> 外层 = 符号表.元素(层);
                    结果<符号, 整32> 外层查 = 外层.获取(整64(n.文本));
                    如果 (外层查.正常) {
                        表诊断(诊断, "[错误] 嵌套块同名容器变量遮蔽暂不支持（P7c 前置）: " +
                                      驻留文本(整64(n.文本)));
                        中断;
                    }
                    层--;
                }
            }
        }
        整64 忽略 = 表注册(符号表, 整64(n.文本), 类型ID, 符号_变量, 0);
        如果 (忽略 == 0) { }
        // 簇⑤根治（2026-09-04，E2E 144 探针矩阵揪出·132 半实现纪律）：结果/容器
        //   类型声明的**字面量**初始化（= 无 / = "串" / = 123——探针 P2 运行期
        //   SIGSEGV：IR 按结构体拷贝瞎发射、字面量槽越界读+垃圾解引用；宿主同款
        //   源码显式拒绝）显式拒绝。诚实边界：非调用非字面量形态（容器标识符
        //   拷贝 = 导入模块们 / 内置直调 = 打开文件(...))仍放行——拷贝的 IR 支持
        //   由 IR 层 [ir2] 诊断可见化（P7c）、直调契约错位属 B1a 裁决边界
        //   （plans/014 灰色点，stdlib 并入专项收口），运行期错位不新增静默面。
        字符串 声明文本5 = 驻留文本(类型ID);
        如果 ((是结果类型(声明文本5) || 是容器类(声明文本5)) &&
             n.子起点 > 0 && n.子终点 > n.子起点) {
            节点 初始化末 = 池.元素(n.子终点 - 1);
            如果 (初始化末.类型 == 节点_整数字面量 || 初始化末.类型 == 节点_浮点字面量 ||
                 初始化末.类型 == 节点_字符串字面量 || 初始化末.类型 == 节点_布尔字面量) {
                表诊断(诊断, "[错误] 结果/容器类型不支持字面量初始化（须为构造/方法/"
                              + "函数调用或同类型拷贝）: " + 驻留文本(整64(n.文本)));
            }
        }
        // P6c：成员偏移标注
        整64 标1 = 标注成员偏移(池, n.子起点, n.子终点, 符号表, 诊断);
        如果 (标1 == -1) { }
        整64 i = 整64(n.子起点);
        当 (i < 整64(n.子终点)) {
            整64 忽略2 = 检查表达式(池, 整32(i), 符号表, 诊断);
            如果 (忽略2 == -1) { }
            i++;
        }
        返回;
    }
    如果 (n.类型 == 节点_赋值) {
        // 左值（标识符）须已声明；右值表达式检查；解引用左值（文本=0）跳过左名检查
        如果 (n.文本 != 0) {
            整64 左类型 = 表查找类型ID(符号表, 整64(n.文本));
            如果 (左类型 == -1) {
                表诊断(诊断, "[错误] 赋值目标未声明: " + 驻留文本(整64(n.文本)));
            }
            // 缺陷②（2026-09-03 用户裁决立案）：常量初始化后不可修改（[03] 规范
            //   语义；宿主 isConstVarName 对齐）——顶层常量经 声明收集 登记为
            //   符号_常量，内层同名变量遮蔽时 表查找种类 命中内层=放行
            如果 (表查找种类(符号表, 整64(n.文本)) == 符号_常量) {
                表诊断(诊断, "[错误] 不能给常量赋值（常量初始化后不可修改）: " +
                              驻留文本(整64(n.文本)));
            }
        }
        如果 (n.文本 == 0 && n.子起点 > 0) {
            // ③ 第二波：下标左值赋值（s[0] = x / s[0] += x）显式拒绝——字符串下标
            //   只读（宿主 A-1 语义）；IR 左值地址生成无下标分支，错误放行=静默
            //   错误代码（写错地址）。半实现纪律：未覆盖形态显式拒绝。
            // ③ 第三波：指针对象下标左值放行（位置[0] = 位置[0] + 1 出参写回、
            //   p[i] = v 写透形态——宿主 ir_expr.cpp:981~1003 对齐：地址计算+
            //   StorePtr，目标类型=所指元素类型）。
            节点 左值末 = 池.元素(n.子起点 - 1);
            如果 (左值末.类型 == 节点_下标) {
                布尔 是指针下标左值 = 假;
                如果 (左值末.子起点 > 0) {
                    节点 下标对象左 = 池.元素(整32(左值末.子起点));
                    如果 (下标对象左.类型 == 节点_标识符) {
                        结果<整64, 整32> 查左指针 = 指针变量表.获取(整64(下标对象左.文本));
                        如果 (查左指针.正常) { 是指针下标左值 = 真; }
                    }
                }
                如果 (!是指针下标左值) {
                    表诊断(诊断, "[错误] 下标左值赋值未支持（字符串下标只读）");
                }
            }
            // 缺陷②（2026-09-03 用户裁决立案）：可写左值白名单——非下标形态须为
            //   标识符（复合赋值合成形态 名+=值）/成员/解引用 之一；其余（二元
            //   运算结果/字面量/负号/逻辑非/取地址/调用/嵌套赋值…）硬错误
            //   （Rust E0070 同款）。语法分析.cn 解析语句 兜底分支「任意表达式+`=`」
            //   都造赋值节点=本检查主战场——原检查缺失时 a+1=7 / 5=a 静默放行，
            //   IR 按左值地址生成存储=写垃圾地址（半实现纪律：未覆盖形态不放行）
            如果 (左值末.类型 != 节点_下标) {
                如果 (左值末.类型 == 节点_标识符) {
                    // 复合赋值标识符形态：常量同拒（与 文本!=0 简单赋值分支同款）
                    如果 (表查找种类(符号表, 整64(左值末.文本)) == 符号_常量) {
                        表诊断(诊断, "[错误] 不能给常量赋值（常量初始化后不可修改）: " +
                                      驻留文本(整64(左值末.文本)));
                    }
                } 否则 如果 (左值末.类型 == 节点_调用) {
                    // 2026-09-04 缺陷零容忍收口：引用返回调用作赋值目标（宿主
                    //   P3-18 对齐：取值(p) = 42 / += 8——调用结果=被引用左值
                    //   地址）；非引用返回调用仍硬拒（普通调用返回右值）
                    如果 (!是引用返回调用(池, 整32(n.子起点 - 1), 符号表)) {
                        表诊断(诊断, "[错误] 赋值目标必须是可写左值（变量/成员/下标/解引用/引用返回调用）");
                    }
                } 否则 如果 (左值末.类型 != 节点_成员 && 左值末.类型 != 节点_解引用) {
                    表诊断(诊断, "[错误] 赋值目标必须是可写左值（变量/成员/下标/解引用）");
                }
            }
            // ③ 第二波（用户裁决 2026-09-03）：复合赋值非数值操作数显式拒绝——
            //   宿主判定对齐（实测：字符串/布尔/字符 += 均报「复合赋值要求数值
            //   操作数」，整系/浮点系通过；显式 名 = 名 + "乙" 拼接赋值合法不受
            //   影响——合成二元节点 子终点=1 标记区分，读右值末节点）。左值类型
            //   白名单=数值。
            如果 (n.附加 > 0) {
                节点 右值末c = 池.元素(n.子终点 - 1);
                如果 (右值末c.类型 == 节点_二元运算 && 右值末c.子终点 == 1) {
                    // 左值类型取左值区间**末**节点：变量=标识符；成员链（名片.计数）
                    //   =成员节点（取首节点会把对象结构体当操作数类型误拒）
                    整64 左值类型IDc = -1;
                    如果 (左值末.类型 == 节点_标识符) {
                        左值类型IDc = 表查找类型ID(符号表, 整64(左值末.文本));
                    } 否则 如果 (左值末.类型 == 节点_下标 && 左值末.子起点 > 0) {
                        // ③ 第三波：下标左值（p[0] += 1）——操作数类型=所指元素
                        //   类型（指针变量表；非指针已上方拒绝，此处防御 -1 放行）
                        节点 下标对象c = 池.元素(整32(左值末.子起点));
                        如果 (下标对象c.类型 == 节点_标识符) {
                            结果<整64, 整32> 查复指 = 指针变量表.获取(整64(下标对象c.文本));
                            如果 (查复指.正常) { 左值类型IDc = 查复指.值; }
                        }
                    } 否则 如果 (左值末.类型 == 节点_成员 && 左值末.子起点 > 0) {
                        // 成员左值：字段类型（名片.计数 += 2 —— 计数 整64 合法）
                        节点 成员对象c = 池.元素(整32(左值末.子起点));
                        如果 (成员对象c.类型 == 节点_标识符) {
                            结果<整64, 整32> 查结构体c = 变量结构体表.获取(整64(成员对象c.文本));
                            如果 (查结构体c.正常) {
                                如果 (查结构体c.值 != 1) {
                                    左值类型IDc = 查字段类型ID(查结构体c.值, 整64(左值末.文本));
                                }
                            }
                        }
                    }
                    如果 (左值类型IDc > 0) {
                        字符串 左类型文本c = 驻留文本(左值类型IDc);
                        布尔 是数值c = 字符串比较(左类型文本c, "整32") || 字符串比较(左类型文本c, "整64") ||
                                       字符串比较(左类型文本c, "整8") || 字符串比较(左类型文本c, "整16") ||
                                       字符串比较(左类型文本c, "正8") || 字符串比较(左类型文本c, "正16") ||
                                       字符串比较(左类型文本c, "正32") || 字符串比较(左类型文本c, "正64") ||
                                       字符串比较(左类型文本c, "浮32") || 字符串比较(左类型文本c, "浮64");
                        如果 (!是数值c) {
                            表诊断(诊断, "[错误] 复合赋值要求数值操作数: " + 左类型文本c);
                        }
                    }
                }
            }
        }
        // P6c：成员偏移标注（解引用左值：区间 [附加, 子终点) 含左值表达式）
        整64 标注起点 = n.文本 != 0 ? n.子起点 : 整32(n.附加);
        整64 标2 = 标注成员偏移(池, 整32(标注起点), n.子终点, 符号表, 诊断);
        如果 (标2 == -1) { }
        整64 i = 整64(标注起点);
        当 (i < 整64(n.子终点)) {
            整64 忽略2 = 检查表达式(池, 整32(i), 符号表, 诊断);
            如果 (忽略2 == -1) { }
            i++;
        }
        返回;
    }
    如果 (n.类型 == 节点_自增) {
        整64 目标类型 = 表查找类型ID(符号表, 整64(n.文本));
        如果 (目标类型 == -1) {
            表诊断(诊断, "[错误] 自增目标未声明: " + 驻留文本(整64(n.文本)));
        }
        // 缺陷②同族（2026-09-03 用户裁决立案）：自增是隐式赋值——常量不可自增
        //   （宿主 visitUnaryExpr ++/-- 常量拒绝对齐；v2 解析器仅支持 ++标识符/
        //   标识符++，结构性无歧义，仅需常量检查）
        如果 (表查找种类(符号表, 整64(n.文本)) == 符号_常量) {
            表诊断(诊断, "[错误] 不能对常量自增（常量初始化后不可修改）: " +
                          驻留文本(整64(n.文本)));
        }
        返回;
    }
    // 簇③根治·自减全链 C1（2026-09-04 用户裁决）：与 节点_自增 完全对称——
    //   未声明诊断 + 常量拒绝（自减同为隐式赋值）
    如果 (n.类型 == 节点_自减) {
        整64 目标类型减 = 表查找类型ID(符号表, 整64(n.文本));
        如果 (目标类型减 == -1) {
            表诊断(诊断, "[错误] 自减目标未声明: " + 驻留文本(整64(n.文本)));
        }
        如果 (表查找种类(符号表, 整64(n.文本)) == 符号_常量) {
            表诊断(诊断, "[错误] 不能对常量自减（常量初始化后不可修改）: " +
                          驻留文本(整64(n.文本)));
        }
        返回;
    }
    如果 (n.类型 == 节点_中断语句 || n.类型 == 节点_继续语句) {
        返回;
    }
    // 一元（逻辑非/负号/取地址/解引用）裸节点分支已删除（缺陷②分诊根治）：
    //   检查块 现仅派发语句根节点——裸一元节点的操作数由所属语句根的区间检查
    //   统一覆盖（原分支=块级裸派发兜底，双重处理/前向引用误报根源）
    // P6c：成员偏移标注（通用表达式区间）
    整64 标4 = 标注成员偏移(池, n.子起点, n.子终点, 符号表, 诊断);
    如果 (标4 == -1) { }
    整64 i = 整64(n.子起点);
    当 (i < 整64(n.子终点)) {
        整64 忽略 = 检查表达式(池, 整32(i), 符号表, 诊断);
        如果 (忽略 == -1) { }
        i++;
    }
}

// 区间登记辅助（③ 第二波根治 检查块 双重处理）：偶数位=起点/奇数位=终点（不含）
函数 登记跳过区间(向量<整64>& 区间们, 整64 起, 整64 终) -> 空类型 {
    结果<空类型, 整32> 加a = 区间们.追加(起);
    如果 (!加a.正常) { 运行时错误(4); }
    结果<空类型, 整32> 加b = 区间们.追加(终);
    如果 (!加b.正常) { 运行时错误(4); }
}

// 检查块（新作用域：压入/弹出）
// ③ 第二波根治（2026-09-03）：父层区间原始遍历会先处理嵌套块（当体/如果体/裸块）
//   的语句、随后控制节点递归再处理一遍——嵌套声明泄漏注册到父层作用域（块级遮蔽
//   检查被自注册误触发，126/127 无真实遮蔽也误报；符号作用域语义错误）。修复：
//   预收集全部嵌套体块区间，主循环跳过——嵌套语句只在递归作用域内处理一次。
函数 检查块(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 空类型 {
    表压入(符号表);
    节点 块 = 池.元素(节点索引);
    向量<整64> 跳过区间们 = 向量<整64>();
    整64 预扫i = 整64(块.子起点);
    当 (预扫i < 整64(块.子终点)) {
        节点 预节点 = 池.元素(整32(预扫i));
        如果 (预节点.类型 == 节点_块) {
            // 裸块：语句区间 [块.子起点, 块节点自身)——块节点由主循环派发递归
            登记跳过区间(跳过区间们, 整64(预节点.子起点), 预扫i);
        } 否则 如果 (预节点.类型 == 节点_当语句) {
            // 当：体块@附加，区间 [体块.子起点, 体块节点]（含体块节点——检查当 递归）
            节点 当体块 = 池.元素(预节点.附加);
            登记跳过区间(跳过区间们, 整64(当体块.子起点), 整64(预节点.附加) + 1);
        } 否则 如果 (预节点.类型 == 节点_如果语句) {
            // 如果：真块@附加，区间 [真块.子起点, 真块节点]（含——检查如果 递归）；
            //   否则链节点（块/如果）在区间内会被预扫另行收集（否则块按裸块、否则
            //   如果按本分支），条件表达式区间不跳（检查如果/主循环双查幂等无害）
            节点 真块 = 池.元素(预节点.附加);
            登记跳过区间(跳过区间们, 整64(真块.子起点), 整64(预节点.附加) + 1);
        }
        预扫i++;
    }
    整64 i = 整64(块.子起点);
    当 (i < 整64(块.子终点)) {
        // 跳过嵌套体块区间（其语句由递归作用域处理）
        布尔 在跳过 = 假;
        整64 跳i = 0;
        当 (跳i < 跳过区间们.大小()) {
            如果 (i >= 跳过区间们.元素(跳i) && i < 跳过区间们.元素(跳i + 1)) {
                在跳过 = 真;
                中断;
            }
            跳i += 2;
        }
        如果 (在跳过) { i++; 继续; }
        节点 子 = 池.元素(整32(i));
        // 语句根节点才派发（缺陷②分诊根治，2026-09-03）：块区间线性包含各语句
        //   的全部内部节点（RHS 裸标识符/一元/成员…先于语句根入池）——原实现逐
        //   节点派发使裸一元节点（取地址/解引用/负号/逻辑非）在**声明根注册名
        //   字之前**先查操作数区间：自引用/前向引用误报「未声明」+ 同一错误双
        //   诊断（&q 前向引用探针实证报两次）。裸节点一律由所属语句根的区间
        //   检查统一覆盖（每节点恰在其作用域访问一次，rustc 对齐）
        如果 (子.类型 == 节点_块 || 子.类型 == 节点_如果语句 || 子.类型 == 节点_当语句 ||
             子.类型 == 节点_变量声明 || 子.类型 == 节点_赋值 || 子.类型 == 节点_自增 ||
             子.类型 == 节点_自减 ||
             子.类型 == 节点_返回语句 || 子.类型 == 节点_表达式语句 ||
             子.类型 == 节点_中断语句 || 子.类型 == 节点_继续语句) {
            如果 (子.类型 == 节点_块) {
                检查块(池, 整32(i), 符号表, 诊断);
            } 否则 如果 (子.类型 == 节点_如果语句) {
                检查如果(池, 整32(i), 符号表, 诊断);
            } 否则 如果 (子.类型 == 节点_当语句) {
                检查当(池, 整32(i), 符号表, 诊断);
            } 否则 {
                检查语句(池, 整32(i), 符号表, 诊断);
            }
        }
        i++;
    }
    表弹出(符号表);
}

// 检查如果语句：条件表达式 + 真块（新作用域）+ 否则链（否则 如果 递归）
函数 检查如果(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 空类型 {
    节点 如果节点 = 池.元素(节点索引);
    // 节点字段：文本=条件起点，子起点=条件终点，附加=真块索引，子终点=否则索引
    整64 条件起点 = 整64(如果节点.文本);
    整64 条件终点 = 整64(如果节点.子起点);
    整64 i = 条件起点;
    当 (i < 条件终点) {
        整64 忽略 = 检查表达式(池, 整32(i), 符号表, 诊断);
        如果 (忽略 == -1) { }
        i++;
    }
    // 真块：附加=真块节点索引
    检查块(池, 整32(如果节点.附加), 符号表, 诊断);
    // 否则链：子终点=否则节点索引（0=无；嵌套 否则 如果 亦为 节点_如果语句）
    整64 否则索引 = 如果节点.子终点;
    如果 (否则索引 != 0) {
        节点 否则节点 = 池.元素(整32(否则索引));
        如果 (否则节点.类型 == 节点_如果语句) {
            检查如果(池, 整32(否则索引), 符号表, 诊断);
        } 否则 {
            检查块(池, 整32(否则索引), 符号表, 诊断);
        }
    }
}

// 检查当语句：条件表达式 + 循环体块（新作用域）
函数 检查当(向量<节点> 池, 整32 节点索引, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 空类型 {
    节点 当节点 = 池.元素(节点索引);
    // 节点字段：文本=条件起点，子起点=条件终点，附加=体块索引
    整64 条件起点 = 整64(当节点.文本);
    整64 条件终点 = 整64(当节点.子起点);
    整64 i = 条件起点;
    当 (i < 条件终点) {
        整64 忽略 = 检查表达式(池, 整32(i), 符号表, 诊断);
        如果 (忽略 == -1) { }
        i++;
    }
    检查块(池, 整32(当节点.附加), 符号表, 诊断);
}

// 检查函数：函数作用域（参数 + 函数体）
函数 检查函数(向量<节点> 池, 整32 函数节点, 向量<映射<整64, 符号>> 符号表, 向量<字符串> 诊断) -> 空类型 {
    指针变量表.清空();  // ③ 第三波：函数级生命周期
    表压入(符号表);
    节点 函数体 = 池.元素(函数节点);
    整64 i = 整64(函数体.子起点);
    当 (i < 整64(函数体.子终点)) {
        节点 参数 = 池.元素(整32(i));
        如果 (参数.类型 == 节点_参数) {
            // ③ 第二波（方案A）：参数 类型ID 同样归一为类型名ID（统一符号约定）
            整64 参数类型ID = 整64(参数.附加);
            如果 (参数类型ID >= 0 && 参数类型ID < 池.大小()) {
                节点 参数类型节点值 = 池.元素(整32(参数类型ID));
                如果 (参数类型节点值.类型 == 节点_类型) {
                    参数类型ID = 整64(参数类型节点值.文本);
                    // plans/018 类型分桶：参数类型存在性/公开性/歧义诊断（fail fast）
                    检查类型引用(符号表, 诊断, 参数类型ID);
                    // ③ 第三波：指针参数登记（附加=指针层数 1..255；引用 >=256 不入）
                    如果 (参数类型节点值.附加 >= 1 && 参数类型节点值.附加 < 256) {
                        结果<空类型, 整32> 设指针参数 = 指针变量表.设置(整64(参数.文本), 参数类型ID);
                        如果 (!设指针参数.正常) { 运行时错误(4); }
                    }
                }
            }
            整64 忽略 = 表注册(符号表, 整64(参数.文本), 参数类型ID, 符号_参数, 0);
            如果 (忽略 == 0) { }
        }
        i++;
    }
    如果 (整64(函数体.子终点) < 池.大小()) {
        检查块(池, 函数体.子终点, 符号表, 诊断);
    }
    表弹出(符号表);
}

// ==================== 主流程 ====================
// 输入节点池+程序根；输出诊断列表；返回 错误数
// 单文件 = 主模块形态包装（键基=纯名、无导入——行为与分桶前逐字节一致；
//   主.cn 负测自检序列沿用本入口）。快照参数传空平铺（标量向量局部构造——
//   成熟路径；嵌套容器/临时值追加禁用，lessons 15 枚同族）
函数 语义分析(向量<节点> 池, 整32 程序节点, 向量<字符串> 诊断) -> 整64 {
    向量<整32> 单节点们 = 向量<整32>();
    结果<空类型, 整32> 加n = 单节点们.追加(程序节点);
    如果 (!加n.正常) { 运行时错误(4); }
    向量<字符串> 单路径们 = 向量<字符串>();
    结果<空类型, 整32> 加p = 单路径们.追加("主");
    如果 (!加p.正常) { 运行时错误(4); }
    向量<整64> 空平铺 = 向量<整64>();
    向量<整64> 空边1 = 向量<整64>();
    向量<整64> 空公开 = 向量<整64>();
    // 边界向量与程序节点们平行（每文件一项=该文件在总表中的起始偏移）——
    //   单文件形态须配对传入（切片段 边界们.元素(j) 防越界）
    结果<空类型, 整32> 加b1 = 空边1.追加(0);
    如果 (!加b1.正常) { 运行时错误(4); }
    返回 语义分析多文件(池, 单节点们, 单路径们, 空平铺, 空边1, 空公开, 诊断);
}

// ==================== 主流程（多文件 P6h + 模块分桶 plans/018 第 3 层） ====================
// 多源文件：程序节点们 = 各文件 程序 节点索引（加载器按依赖先解析的顺序收集）；
//   模块路径们 = 每文件模块路径；导入项平铺总表/导入模块总表 = 全部文件 ②③
//   快照拼接（边界们[f]=文件 f 起始偏移，段=[边界[f], 边界[f+1] 或 总表尾)）；
//   公开平铺总表 = 全部文件 公开: 标签快照拼接（交替 [声明节点索引, 1]——
//   节点索引全池唯一，无需边界）。
// 第一趟：全部文件 声明收集（链接键分桶登记+模块成员索引+可见性）；
// 第二趟：逐文件 构建文件导入上下文（② 导入目标+E0255+③ glob 清单）后检查
//   函数体（三级解析）。返回 诊断数（含查找链路诊断缓冲合入）。
函数 语义分析多文件(向量<节点> 池, 向量<整32> 程序节点们,
                    向量<字符串>& 模块路径们,
                    向量<整64>& 导入项平铺总表, 向量<整64>& 导入项边界们,
                    向量<整64>& 公开平铺总表,
                    向量<字符串> 诊断) -> 整64 {
    向量<映射<整64, 符号>> 符号表 = 向量<映射<整64, 符号>>();
    表压入(符号表);  // 全局作用域（全部文件 函数/结构体 声明）
    清空调用决议();   // plans/018 第 4 层：调用决议表任务级生命周期
    清空模块解析表(); // 模块成员索引/导入上下文/三级缓存 任务级生命周期
    清空函数签名();  // 呈报③方案A：函数签名表任务级生命周期（入口清空）
    // 公开表构建（平铺 -> 映射点查：声明收集 按节点索引查可见性）
    映射<整64, 整64> 公开表 = 映射<整64, 整64>();
    整64 oi = 0;
    当 (oi + 1 < 公开平铺总表.大小()) {
        结果<空类型, 整32> 设公 = 公开表.设置(公开平铺总表.元素(oi), 1);
        如果 (!设公.正常) { 运行时错误(4); }
        oi += 2;
    }
    整64 i = 0;
    当 (i < 程序节点们.大小()) {
        声明收集(池, 程序节点们.元素(整32(i)), 符号表, 诊断,
                 模块路径们.元素(整32(i)), 公开表);
        i++;
    }
    // ③ 合并全局可见的遍历范围=加载树全部模块 ID（stdlib 不在成员索引天然 miss）
    向量<整64> 全部模块ID们 = 向量<整64>();
    整64 mi2 = 0;
    当 (mi2 < 模块路径们.大小()) {
        结果<空类型, 整32> 加g2 = 全部模块ID们.追加(驻留(模块路径们.元素(整32(mi2))));
        如果 (!加g2.正常) { 运行时错误(4); }
        mi2++;
    }
    整64 j = 0;
    当 (j < 程序节点们.大小()) {
        // 每文件检查前：从总表切本文件 ② 段（局部标量向量）+构建导入上下文
        //   （E0255/私有/存在性诊断仅此一处）
        整64 平铺起 = 导入项边界们.元素(整32(j));
        整64 平铺终 = 导入项平铺总表.大小();
        如果 (j + 1 < 导入项边界们.大小()) { 平铺终 = 导入项边界们.元素(整32(j + 1)); }
        向量<整64> 本平铺段 = 向量<整64>();
        整64 si = 平铺起;
        当 (si < 平铺终) {
            结果<空类型, 整32> 加s = 本平铺段.追加(导入项平铺总表.元素(整32(si)));
            如果 (!加s.正常) { 运行时错误(4); }
            si++;
        }
        构建文件导入上下文(模块路径们.元素(整32(j)), 本平铺段, 全部模块ID们, 诊断, 假);
        节点 程序 = 池.元素(程序节点们.元素(整32(j)));
        整64 k = 整64(程序.子起点);
        当 (k < 整64(程序.子终点)) {
            节点 声明 = 池.元素(整32(k));
            如果 (声明.类型 == 节点_函数) {
                // plans/018 类型分桶：返回类型诊断（声明.附加=返回类型名ID）
                检查类型引用(符号表, 诊断, 整64(声明.附加));
                检查函数(池, 整32(k), 符号表, 诊断);
            }
            k++;
        }
        j++;
    }
    表弹出(符号表);  // 释放全局作用域
    // 查找链路诊断缓冲合入（三级歧义 E0659——查找函数无诊断参数，缓冲聚合）
    整64 bi = 0;
    当 (bi < 语义诊断缓冲.大小()) {
        表诊断(诊断, 语义诊断缓冲.元素(bi));
        bi++;
    }
    语义诊断缓冲 = 向量<字符串>();
    返回 整64(诊断.大小());
}
