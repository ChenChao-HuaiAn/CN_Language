// CN 自举编译器 v2：结构化语义分析器（自举重建 P4，2026-08-25，第4版）
// 符号表 = 参数直传 向量<符号>（每符号带 深度），作用域=深度管理。
// 规避宿主缺陷：结构体字段的泛型容器方法在非入口模块失败；向量需经函数参数传递。
导入 容器::向量
导入 语法分析

公开:

常量 符号_变量 = 1
常量 符号_参数 = 2
常量 符号_函数 = 3
常量 符号_结构体 = 4

结构体 符号 {
    整64 名ID
    整64 类型ID
    整64 种类
    整64 附加
    整64 深度
}

函数 建符号(整64 名ID, 整64 类型ID, 整64 种类, 整64 附加) -> 符号 {
    符号 s
    s.名ID = 名ID
    s.类型ID = 类型ID
    s.种类 = 种类
    s.附加 = 附加
    s.深度 = 0
    返回 s
}

// 压入作用域：深度++
函数 表压入(整64 深度) -> 整64 {
    返回 深度 + 1
}
// 弹出作用域（平行数组版）：过滤保留 深度<=新深度 的符号（重建 4 表）
函数 深度表弹出(向量<整64> 名表, 向量<整64> 类型表, 向量<整64> 种类表, 向量<整64> 深度表, 整64 深度) -> 整64 {
    整64 新深度 = 0
    如果 (深度 > 0) { 新深度 = 深度 - 1 }
    向量<整64> 保留名 = 向量<整64>()
    向量<整64> 保留类型 = 向量<整64>()
    向量<整64> 保留种类 = 向量<整64>()
    整64 i = 0
    当 (i < 深度表.大小()) {
        如果 (深度表.元素(i) <= 新深度) {
            结果<空类型, 整32> 加1 = 保留名.追加(名表.元素(i))
            如果 (!加1.正常) { 运行时错误(4) }
            结果<空类型, 整32> 加2 = 保留类型.追加(类型表.元素(i))
            如果 (!加2.正常) { 运行时错误(4) }
            结果<空类型, 整32> 加3 = 保留种类.追加(种类表.元素(i))
            如果 (!加3.正常) { 运行时错误(4) }
        }
        i++
    }
    // 重建
    深度表.清空()
    名表.清空()
    类型表.清空()
    种类表.清空()
    整64 j = 0
    当 (j < 保留名.大小()) {
        结果<空类型, 整32> 加a = 名表.追加(保留名.元素(j))
        如果 (!加a.正常) { 运行时错误(4) }
        结果<空类型, 整32> 加b = 类型表.追加(保留类型.元素(j))
        如果 (!加b.正常) { 运行时错误(4) }
        结果<空类型, 整32> 加c = 种类表.追加(保留种类.元素(j))
        如果 (!加c.正常) { 运行时错误(4) }
        结果<空类型, 整32> 加d = 深度表.追加(新深度)
        如果 (!加d.正常) { 运行时错误(4) }
        j++
    }
    返回 新深度
}

// 弹出作用域：删深度>新深度的符号（重建向量，规避 向量.删除 跨模块结构体崩溃）
函数 表弹出(向量<符号> 符号表, 整64 深度) -> 整64 {
    整64 新深度 = 0
    如果 (深度 > 0) { 新深度 = 深度 - 1 }
    向量<符号> 保留 = 向量<符号>()
    整64 i = 0
    当 (i < 符号表.大小()) {
        符号 s = 符号表.元素(i)
        如果 (s.深度 <= 新深度) {
            结果<空类型, 整32> 加 = 保留.追加(s)
            如果 (!加.正常) { 运行时错误(4) }
        }
        i++
    }
    符号表.清空()
    整64 j = 0
    当 (j < 保留.大小()) {
        结果<空类型, 整32> 加2 = 符号表.追加(保留.元素(j))
        如果 (!加2.正常) { 运行时错误(4) }
        j++
    }
    返回 新深度
}

// 注册符号（平行整64 数组版：名表/类型表/种类表/深度表；1=成功 0=重复）
函数 表注册4(向量<整64> 名表, 向量<整64> 类型表, 向量<整64> 种类表, 向量<整64> 深度表, 整64 深度, 整64 名ID, 整64 类型ID, 整64 种类) -> 整64 {
    整64 i = 0
    当 (i < 名表.大小()) {
        如果 (名表.元素(i) == 名ID && 深度表.元素(i) == 深度) { 返回 0 }
        i++
    }
    结果<空类型, 整32> 加1 = 名表.追加(名ID)
    如果 (!加1.正常) { 返回 0 }
    结果<空类型, 整32> 加2 = 类型表.追加(类型ID)
    如果 (!加2.正常) { 返回 0 }
    结果<空类型, 整32> 加3 = 种类表.追加(种类)
    如果 (!加3.正常) { 返回 0 }
    结果<空类型, 整32> 加4 = 深度表.追加(深度)
    如果 (!加4.正常) { 返回 0 }
    返回 1
}

// 查找（平行数组版）：反向扫描；返回 类型ID（-1=未找到，避免与 0 冲突）
函数 表查找4(向量<整64> 名表, 向量<整64> 类型表, 整64 名ID) -> 整64 {
    整64 i = 名表.大小()
    当 (i > 0) {
        i--
        如果 (名表.元素(i) == 名ID) {
            返回 类型表.元素(i)
        }
    }
    返回 -1
}

// 诊断记录
函数 表诊断(向量<字符串> 诊断, 字符串 消息) -> 空类型 {
    结果<空类型, 整32> 加 = 诊断.追加(消息)
    如果 (!加.正常) { 运行时错误(4) }
}
// ==================== 声明收集（第一趟：函数/结构体签名） ====================
函数 声明收集(向量<节点> 池, 整32 程序节点, 向量<整64> 名表, 向量<整64> 类型表, 向量<整64> 种类表, 向量<整64> 深度表, 整64 深度) -> 空类型 {
    节点 程序 = 池.元素(程序节点)
    整64 i = 整64(程序.子起点)
    当 (i < 整64(程序.子终点)) {
        节点 声明 = 池.元素(整32(i))
        如果 (声明.类型 == 节点_函数) {
            整64 忽略 = 表注册4(名表, 类型表, 种类表, 深度表, 深度, 整64(声明.文本), 整64(声明.附加), 符号_函数)
            如果 (忽略 == 0) { } 
        }
        如果 (声明.类型 == 节点_结构体) {
            整64 忽略2 = 表注册4(名表, 类型表, 种类表, 深度表, 深度, 整64(声明.文本), 0, 符号_结构体)
            如果 (忽略2 == 0) { }
        }
        i++
    }
}

// 检查表达式：返回类型ID（0=未知）；未声明标识符 -> 诊断
函数 检查表达式(向量<节点> 池, 整32 节点索引, 向量<整64> 名表, 向量<整64> 类型表, 向量<字符串> 诊断) -> 整64 {
    节点 n = 池.元素(节点索引)
    如果 (n.类型 == 节点_整数字面量) { 返回 驻留("整32") }
    如果 (n.类型 == 节点_浮点字面量) { 返回 驻留("浮64") }
    如果 (n.类型 == 节点_字符串字面量) { 返回 驻留("字符串") }
    如果 (n.类型 == 节点_标识符) {
        整64 找到类型 = 表查找4(名表, 类型表, 整64(n.文本))
        如果 (找到类型 != -1) {
            返回 找到类型
        }
        表诊断(诊断, "[错误] 未声明标识符: " + 驻留文本(整64(n.文本)))
        返回 0
    }
    如果 (n.类型 == 节点_二元运算) {
        // 简化：二元结果按整32（后续完善操作数类型推导）
        返回 驻留("整32")
    }
    返回 0
}

// 检查语句
函数 检查语句(向量<节点> 池, 整32 节点索引, 向量<整64> 名表, 向量<整64> 类型表, 向量<整64> 种类表, 向量<整64> 深度表, 向量<字符串> 诊断) -> 空类型 {
    节点 n = 池.元素(节点索引)
    如果 (n.类型 == 节点_返回语句) {
        整64 i = 整64(n.子起点)
        当 (i < 整64(n.子终点)) {
            整64 忽略 = 检查表达式(池, 整32(i), 名表, 类型表, 诊断)
            i++
        }
        返回
    }
    如果 (n.类型 == 节点_变量声明) {
        整64 类型ID = 整64(n.附加)
        整64 忽略 = 表注册4(名表, 类型表, 种类表, 深度表, 0, 整64(n.文本), 类型ID, 符号_变量)
        整64 i = 整64(n.子起点)
        当 (i < 整64(n.子终点)) {
            整64 忽略 = 检查表达式(池, 整32(i), 名表, 类型表, 诊断)
            i++
        }
        返回
    }
    如果 (n.类型 == 节点_表达式语句) {
        整64 i = 整64(n.子起点)
        当 (i < 整64(n.子终点)) {
            整64 忽略 = 检查表达式(池, 整32(i), 名表, 类型表, 诊断)
            i++
        }
        返回
    }
}

// 检查块（新作用域）
函数 检查块(向量<节点> 池, 整32 节点索引, 向量<整64> 名表, 向量<整64> 类型表, 向量<整64> 种类表, 向量<整64> 深度表, 向量<字符串> 诊断, 整64 深度) -> 空类型 {
    整64 新深度 = 表压入(深度)
    节点 块 = 池.元素(节点索引)
    整64 i = 整64(块.子起点)
    当 (i < 整64(块.子终点)) {
        节点 子 = 池.元素(整32(i))
        如果 (子.类型 == 节点_块) {
            检查块(池, 整32(i), 名表, 类型表, 种类表, 深度表, 诊断, 新深度)
        } 否则 {
            检查语句(池, 整32(i), 名表, 类型表, 种类表, 深度表, 诊断)
        }
        i++
    }
    新深度 = 深度表弹出(名表, 类型表, 种类表, 深度表, 新深度)
}

// 检查函数
函数 检查函数(向量<节点> 池, 整32 函数节点, 向量<整64> 名表, 向量<整64> 类型表, 向量<整64> 种类表, 向量<整64> 深度表, 向量<字符串> 诊断) -> 空类型 {
    整64 函数深度 = 1
    节点 函数体 = 池.元素(函数节点)
    整64 i = 整64(函数体.子起点)
    当 (i < 整64(函数体.子终点)) {
        节点 参数 = 池.元素(整32(i))
        如果 (参数.类型 == 节点_参数) {
            整64 忽略 = 表注册4(名表, 类型表, 种类表, 深度表, 函数深度, 整64(参数.文本), 整64(参数.附加), 符号_参数)
        }
        i++
    }
    如果 (整64(函数体.子终点) < 池.大小()) {
        检查块(池, 函数体.子终点, 名表, 类型表, 种类表, 深度表, 诊断, 函数深度)
    }
}

// ==================== 主流程 ====================
// 输入节点池+程序根；输出诊断列表；返回 0=通过 非0=错误数
函数 语义分析(向量<节点> 池, 整32 程序节点, 向量<字符串> 诊断) -> 整64 {
    向量<整64> 名表 = 向量<整64>()
    向量<整64> 类型表 = 向量<整64>()
    向量<整64> 种类表 = 向量<整64>()
    向量<整64> 深度表 = 向量<整64>()
    声明收集(池, 程序节点, 名表, 类型表, 种类表, 深度表, 0)
    节点 程序 = 池.元素(程序节点)
    整64 i = 整64(程序.子起点)
    当 (i < 整64(程序.子终点)) {
        节点 声明 = 池.元素(整32(i))
        如果 (声明.类型 == 节点_函数) {
            检查函数(池, 整32(i), 名表, 类型表, 种类表, 深度表, 诊断)
        }
        i++
    }
    返回 整64(诊断.大小())
}
