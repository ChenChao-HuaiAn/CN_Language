// CN 自举编译器 v2：结构化语义分析器（自举重建 P4 重做，2026-08-25，第5版）
// 符号表 = 映射<整64, 符号>（O(1) 哈希，对标 rustc）+ 每符号深度（延迟删除遮蔽）。
// 相比第4版平行数组：消除线性查找 O(n)，符号表哈希 O(1)。
导入 容器::向量
导入 映射集合
导入 语法分析

公开:

常量 符号_变量 = 1
常量 符号_参数 = 2
常量 符号_函数 = 3
常量 符号_结构体 = 4

结构体 符号 {
    整64 名ID
    整64 类型ID
    整64 种类
    整64 附加
    整64 深度
}

函数 建符号(整64 名ID, 整64 类型ID, 整64 种类, 整64 附加) -> 符号 {
    符号 s
    s.名ID = 名ID
    s.类型ID = 类型ID
    s.种类 = 种类
    s.附加 = 附加
    s.深度 = 0
    返回 s
}

// 压入作用域：深度++
函数 表压入(整64 深度) -> 整64 {
    返回 深度 + 1
}

// 弹出作用域：只递减深度（延迟删除——查找时深度>当前深度的符号被遮蔽）
函数 表弹出(整64 深度) -> 整64 {
    整64 新深度 = 0
    如果 (深度 > 0) { 新深度 = 深度 - 1 }
    返回 新深度
}

// 注册符号：同深度重名 -> 0；否则设置（O(1) 哈希）
函数 表注册(映射<整64, 符号> 符号表, 整64 深度, 整64 名ID, 整64 类型ID, 整64 种类, 整64 附加) -> 整64 {
    结果<符号, 整32> 已有 = 符号表.获取(名ID)
    如果 (已有.正常) {
        如果 (已有.值.深度 == 深度) { 返回 0 }
    }
    符号 s = 建符号(名ID, 类型ID, 种类, 附加)
    s.深度 = 深度
    结果<空类型, 整32> 加 = 符号表.设置(名ID, s)
    如果 (!加.正常) { 返回 0 }
    返回 1
}

// 查找符号：返回类型ID（-1=未找到或深度>当前被遮蔽）
函数 表查找类型ID(映射<整64, 符号> 符号表, 整64 名ID, 整64 当前深度) -> 整64 {
    结果<符号, 整32> 查 = 符号表.获取(名ID)
    如果 (查.正常) {
        如果 (查.值.深度 <= 当前深度) {
            返回 查.值.类型ID
        }
    }
    返回 -1
}

// 诊断记录
函数 表诊断(向量<字符串> 诊断, 字符串 消息) -> 空类型 {
    结果<空类型, 整32> 加 = 诊断.追加(消息)
    如果 (!加.正常) { 运行时错误(4) }
}
// ==================== 声明收集（第一趟：函数/结构体签名） ====================
函数 声明收集(向量<节点> 池, 整32 程序节点, 映射<整64, 符号> 符号表, 整64 深度) -> 空类型 {
    节点 程序 = 池.元素(程序节点)
    整64 i = 整64(程序.子起点)
    当 (i < 整64(程序.子终点)) {
        节点 声明 = 池.元素(整32(i))
        如果 (声明.类型 == 节点_函数) {
            整64 忽略 = 表注册(符号表, 深度, 整64(声明.文本), 整64(声明.附加), 符号_函数, 0)
            如果 (忽略 == 0) { }
        }
        如果 (声明.类型 == 节点_结构体) {
            整64 忽略2 = 表注册(符号表, 深度, 整64(声明.文本), 0, 符号_结构体, 0)
            如果 (忽略2 == 0) { }
        }
        i++
    }
}

// 检查表达式：返回类型ID（-1=未知）；未声明标识符 -> 诊断
函数 检查表达式(向量<节点> 池, 整32 节点索引, 映射<整64, 符号> 符号表, 整64 深度, 向量<字符串> 诊断) -> 整64 {
    节点 n = 池.元素(节点索引)
    如果 (n.类型 == 节点_整数字面量) { 返回 驻留("整32") }
    如果 (n.类型 == 节点_浮点字面量) { 返回 驻留("浮64") }
    如果 (n.类型 == 节点_字符串字面量) { 返回 驻留("字符串") }
    如果 (n.类型 == 节点_标识符) {
        整64 找到类型 = 表查找类型ID(符号表, 整64(n.文本), 深度)
        如果 (找到类型 != -1) {
            返回 找到类型
        }
        表诊断(诊断, "[错误] 未声明标识符: " + 驻留文本(整64(n.文本)))
        返回 -1
    }
    返回 -1
}

// 检查语句
函数 检查语句(向量<节点> 池, 整32 节点索引, 映射<整64, 符号> 符号表, 整64 深度, 向量<字符串> 诊断) -> 空类型 {
    节点 n = 池.元素(节点索引)
    如果 (n.类型 == 节点_返回语句) {
        整64 i = 整64(n.子起点)
        当 (i < 整64(n.子终点)) {
            整64 忽略 = 检查表达式(池, 整32(i), 符号表, 深度, 诊断)
            如果 (忽略 == -1) { }
            i++
        }
        返回
    }
    如果 (n.类型 == 节点_变量声明) {
        整64 类型ID = 整64(n.附加)
        整64 忽略 = 表注册(符号表, 深度, 整64(n.文本), 类型ID, 符号_变量, 0)
        如果 (忽略 == 0) { }
        整64 i = 整64(n.子起点)
        当 (i < 整64(n.子终点)) {
            整64 忽略2 = 检查表达式(池, 整32(i), 符号表, 深度, 诊断)
            如果 (忽略2 == -1) { }
            i++
        }
        返回
    }
    整64 i = 整64(n.子起点)
    当 (i < 整64(n.子终点)) {
        整64 忽略 = 检查表达式(池, 整32(i), 符号表, 深度, 诊断)
        如果 (忽略 == -1) { }
        i++
    }
}

// 检查块（新作用域）
函数 检查块(向量<节点> 池, 整32 节点索引, 映射<整64, 符号> 符号表, 整64 深度, 向量<字符串> 诊断) -> 空类型 {
    整64 新深度 = 表压入(深度)
    节点 块 = 池.元素(节点索引)
    整64 i = 整64(块.子起点)
    当 (i < 整64(块.子终点)) {
        节点 子 = 池.元素(整32(i))
        如果 (子.类型 == 节点_块) {
            检查块(池, 整32(i), 符号表, 新深度, 诊断)
        } 否则 {
            检查语句(池, 整32(i), 符号表, 新深度, 诊断)
        }
        i++
    }
    新深度 = 表弹出(新深度)
}

// 检查函数
函数 检查函数(向量<节点> 池, 整32 函数节点, 映射<整64, 符号> 符号表, 向量<字符串> 诊断) -> 空类型 {
    整64 函数深度 = 1
    节点 函数体 = 池.元素(函数节点)
    整64 i = 整64(函数体.子起点)
    当 (i < 整64(函数体.子终点)) {
        节点 参数 = 池.元素(整32(i))
        如果 (参数.类型 == 节点_参数) {
            整64 忽略 = 表注册(符号表, 函数深度, 整64(参数.文本), 整64(参数.附加), 符号_参数, 0)
            如果 (忽略 == 0) { }
        }
        i++
    }
    如果 (整64(函数体.子终点) < 池.大小()) {
        检查块(池, 函数体.子终点, 符号表, 函数深度, 诊断)
    }
}

// ==================== 主流程 ====================
// 输入节点池+程序根；输出诊断列表；返回 错误数
函数 语义分析(向量<节点> 池, 整32 程序节点, 向量<字符串> 诊断) -> 整64 {
    映射<整64, 符号> 符号表 = 映射<整64, 符号>()
    声明收集(池, 程序节点, 符号表, 0)
    节点 程序 = 池.元素(程序节点)
    整64 i = 整64(程序.子起点)
    当 (i < 整64(程序.子终点)) {
        节点 声明 = 池.元素(整32(i))
        如果 (声明.类型 == 节点_函数) {
            检查函数(池, 整32(i), 符号表, 诊断)
        }
        i++
    }
    返回 整64(诊断.大小())
}
