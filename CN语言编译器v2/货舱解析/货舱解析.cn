// CN 自举编译器 v2：货舱.toml 解析器（plans/018 P6b 工作流3-6，2026-09-07）
// 规范：specs/09 二（包与依赖）/宿主 cargo_parser 对齐——纯 CN TOML 子集实现
//   （用户裁决：货舱.toml 纳入 v2 范围，v2 须实现纯 CN 解析器）。
// 语法子集（宽容解析，未知节/键忽略）：
//   [货舱]         —— 包元数据节：名称 = "值" / 版本 = "值"
//   [依赖]         —— 依赖节：<依赖名> = "版本"；版本 "内置" = 编译器 stdlib，
//                     其他 = 本地路径查找（依赖/<名>/<名>.cn 或 /包.cn）
//   # 注释         —— 整行注释与行内注释（引号外 # 截断该行有效部分）
//   空白            —— 键/值/节名首尾空白剥离；空行跳过
// 数据结构：货舱依赖（名称/版本）与 货舱配置（包名称/包版本/依赖向量）。
// 边界：字符串值仅支持双引号形式（TOML 基本字符串）；单引号/多行字符串不支持
//   （货舱.toml 元数据场景不需要——与宿主 cargo_parser 同口径）。

导入 容器::向量;

公开:

// 单个依赖声明：名称 = "版本"
结构体 货舱依赖 {
    字符串 名称;
    字符串 版本;
}

// 解析结果形态：[货舱] 包名称/包版本（字符串& 输出）+ [依赖] 向量<货舱依赖>
//   （plans/018 实施注记：原拟 货舱配置 结构体聚合——含容器字段结构体的裸声明
//   不触发容器构造（依赖们 句柄未初始化即 追加=悬垂写，探针实测静默退出），
//   改平铺 向量 引用参数走成熟容器构造路径 货舱配置 = 向量<货舱依赖>()；

// 剥离字符串首尾空白（空格 32 / \t 9 / \r 13 / \n 10）
函数 货舱去空白(字符串 词) -> 字符串 {
    整64 起 = 0;
    整64 尾 = 字符串长度(词);
    当 (起 < 尾) {
        整64 字节 = 整64(词[起]);
        如果 (字节 < 0) { 字节 = 字节 + 256; }
        如果 (字节 == 32 || 字节 == 9 || 字节 == 13 || 字节 == 10) { 起++; }
        否则 { 中断; }
    }
    当 (尾 > 起) {
        整64 字节2 = 整64(词[尾 - 1]);
        如果 (字节2 < 0) { 字节2 = 字节2 + 256; }
        如果 (字节2 == 32 || 字节2 == 9 || 字节2 == 13 || 字节2 == 10) { 尾--; }
        否则 { 中断; }
    }
    返回 字符串子串(词, 起, 尾 - 起);
}

// 剥离成对双引号（值形态 "..."；无引号原样返回）
函数 货舱剥引号(字符串 词) -> 字符串 {
    整64 n = 字符串长度(词);
    如果 (n >= 2) {
        整64 首 = 整64(词[0]);
        整64 尾c = 整64(词[n - 1]);
        如果 (首 < 0) { 首 = 首 + 256; }
        如果 (尾c < 0) { 尾c = 尾c + 256; }
        如果 (首 == 34 && 尾c == 34) { 返回 字符串子串(词, 1, n - 2); }
    }
    返回 词;
}

// 解析货舱.toml 全文 -> 货舱配置（结果经 & 就地写入）。
// 返回 0=成功；非 0=错误行号（语法硬错误：节头不闭合）。
// 逐行状态机：节头切换当前节；键值对按当前节归位（无节时的键忽略——宽容）。
函数 解析货舱(字符串 内容, 字符串& 包名称, 字符串& 包版本,
              向量<货舱依赖>& 依赖们) -> 整64 {
    整64 i = 0;
    整64 长度 = 字符串长度(内容);
    整64 行号 = 1;
    整64 当前节 = 0;   // 0=无 1=[货舱] 2=[依赖]
    当 (i <= 长度) {
        如果 (i == 长度) { 中断; }
        // ---- 取一行（至 '\n' 或文末；引号外的 '#' 截断有效部分）----
        字符串 行 = "";
        布尔 在引号 = 假;
        当 (i < 长度) {
            整64 字节 = 整64(内容[i]);
            如果 (字节 < 0) { 字节 = 字节 + 256; }
            如果 (字节 == 10) { i++; 中断; }
            如果 (字节 == 34) { 在引号 = !在引号; }
            如果 (字节 == 35 && !在引号) {   // '#'=35：行内注释——丢弃余下行
                当 (i < 长度 && 整64(内容[i]) != 10) { i++; }
                中断;
            }
            行 = 行 + 字符串子串(内容, i, 1);
            i++;
        }
        字符串 有效行 = 货舱去空白(行);
        如果 (字符串长度(有效行) == 0) { 行号++; 继续; }
        // ---- 节头 [名] ----
        整64 首字节 = 整64(有效行[0]);
        如果 (首字节 < 0) { 首字节 = 首字节 + 256; }
        如果 (首字节 == 91) {   // '['=91
            整64 n = 字符串长度(有效行);
            整64 尾字节 = 整64(有效行[n - 1]);
            如果 (尾字节 < 0) { 尾字节 = 尾字节 + 256; }
            如果 (尾字节 != 93) { 返回 行号; }   // ']'=93：节头不闭合=硬错误
            字符串 节名 = 货舱去空白(字符串子串(有效行, 1, n - 2));
            如果 (字符串比较(节名, "货舱")) {
                当前节 = 1;
            } 否则 如果 (字符串比较(节名, "依赖")) {
                当前节 = 2;
            } 否则 {
                当前节 = 0;   // 未知节：宽容忽略其键
            }
            行号++;
            继续;
        }
        // ---- 键值对：键 = "值" ----
        整64 等位 = -1;
        整64 k = 0;
        整64 n2 = 字符串长度(有效行);
        当 (k < n2) {
            整64 字节3 = 整64(有效行[k]);
            如果 (字节3 < 0) { 字节3 = 字节3 + 256; }
            如果 (字节3 == 61) { 等位 = k; 中断; }   // '='=61
            k++;
        }
        如果 (等位 > 0) {
            字符串 键 = 货舱去空白(字符串子串(有效行, 0, 等位));
            字符串 值 = 货舱剥引号(货舱去空白(字符串子串(有效行, 等位 + 1, n2 - 等位 - 1)));
            如果 (当前节 == 1) {
                如果 (字符串比较(键, "名称")) {
                    包名称 = 值;
                } 否则 如果 (字符串比较(键, "版本")) {
                    包版本 = 值;
                }
            } 否则 如果 (当前节 == 2) {
                货舱依赖 项;
                项.名称 = 键;
                项.版本 = 值;
                结果<空类型, 整32> 加 = 依赖们.追加(项);
                如果 (!加.正常) { 运行时错误(4); }
            }
            // 当前节 == 0：未知节的键，宽容忽略
        }
        // 无 '=' 的非节头行：宽容忽略（与宿主 cargo_parser 同口径）
        行号++;
    }
    返回 0;
}

// 按依赖名查找（未找到返回 版本 空串）
函数 货舱查找依赖(向量<货舱依赖>& 依赖们, 字符串 名) -> 字符串 {
    整64 i = 0;
    当 (i < 依赖们.大小()) {
        货舱依赖 项 = 依赖们.元素(i);
        如果 (字符串比较(项.名称, 名)) { 返回 项.版本; }
        i++;
    }
    返回 "";
}
