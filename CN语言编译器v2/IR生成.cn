// CN 自举编译器 v2：结构化 IR 生成器（自举重建 P5，2026-08-25）
// 性能最优架构第三层：AST 节点池（后缀表达式栈）-> 三地址码 IR 指令数组。
// 设计（对标 rustc/LLVM）：
//   - 指令为结构化结构体（操作码/操作数/结果寄存器/类型码/附加），非字符串行。
//   - 寄存器 = 整数 ID（虚拟寄存器，代码生成阶段映射到栈槽）。
//   - 表达式按后缀栈求值：遍历节点池区间，字面量/标识符压栈（生成加载指令），
//     二元/后缀操作符弹栈生成运算指令，结果压栈。
//   - 语句按 子起点/子终点 区间遍历；变量声明分配槽（映射 名ID -> 槽索引）。
// 依赖：P2 词法（Token）/ P3 语法（节点池）/ P4 语义（类型检查）。
// 说明：本组件只生成 IR 指令（不含汇编输出——汇编在 P6 代码生成组件）。

导入 容器::向量
导入 语法分析   // 节点_* 常量（AST 节点类型）

公开:

// ==================== IR 操作码（对标 C++ 编译器 ir.hpp Opcode） ====================
常量 IR_常量整数 = 1
常量 IR_常量浮点 = 2
常量 IR_常量字符串 = 3
常量 IR_常量布尔 = 4
常量 IR_加 = 10
常量 IR_减 = 11
常量 IR_乘 = 12
常量 IR_除 = 13
常量 IR_取余 = 14
常量 IR_位与 = 15
常量 IR_位或 = 16
常量 IR_位异或 = 17
常量 IR_相等 = 20
常量 IR_不等 = 21
常量 IR_小于 = 22
常量 IR_大于 = 23
常量 IR_小于等于 = 24
常量 IR_大于等于 = 25
常量 IR_逻辑非 = 30
常量 IR_负 = 31         // 一元负（P6b：操作数1=源寄存器，目标=结果）
常量 IR_加载 = 40       // 变量槽 -> 寄存器（操作数1=槽索引，结果=寄存器）
常量 IR_存储 = 41       // 寄存器 -> 变量槽（操作数1=值，附加=槽索引）
常量 IR_分配 = 42       // 登记变量槽（Alloca；附加=槽索引）
常量 IR_取地址 = 43     // 变量槽地址（附加=槽索引）
常量 IR_指针加载 = 44   // 经指针值加载（操作数1=地址）
常量 IR_指针存储 = 45   // 经指针值存储（操作数1=地址，操作数2=值）
常量 IR_字段地址 = 46   // 结构体字段地址（操作数1=基址，附加=字段偏移）
常量 IR_标签 = 49       // 块标签（P6b；附加=块ID，代码生成输出 bbN:）
常量 IR_跳转 = 50       // 无条件跳转（附加=目标块ID）
常量 IR_条件跳转 = 51   // 条件跳转（操作数1=条件寄存器，操作数2=真块，操作数3=假块）
常量 IR_调用 = 52       // 函数调用（操作数1=this/返回缓冲，操作数2..=实参，附加=函数符号）
常量 IR_返回 = 53       // 返回（操作数1=返回值寄存器，可为0）

// ==================== IR 类型码 ====================
常量 T_未知 = 0
常量 T_整32 = 1
常量 T_整64 = 2
常量 T_浮32 = 3
常量 T_浮64 = 4
常量 T_布尔 = 5
常量 T_字符串 = 6
常量 T_指针 = 7
常量 T_空类型 = 8

// ==================== 结构化 IR 指令 ====================
// 三地址码形式：操作数（寄存器 ID / 槽索引 / 常量），结果（寄存器 ID），类型码，附加。
结构体 IR指令 {
    整64 操作码
    整64 操作数1
    整64 操作数2
    整64 操作数3
    整64 目标
    整64 类型
    整64 附加
}

// ==================== 函数 IR ====================
// 每个函数：指令数组 + 局部槽表（名ID -> 槽索引）+ 参数槽表 + 返回类型码。
结构体 函数IR {
    向量<IR指令> 指令
    映射<整64, 整64> 局部槽
    映射<整64, 整64> 参数槽
    整64 返回类型
    整32 名字
    整64 块计数        // P6b：块编号计数器（标签随建随取，嵌套安全）
    整64 当前块        // P6b：当前块 ID（跳转目标；初始 0=函数入口块）
    整64 循环出口块    // P6b：最近 当/循环 出口块（中断 跳转目标；0=无）
    整64 循环继续块    // P6b：最近 当/循环 继续块（继续 跳转目标；0=无）
}

// 程序 IR：函数 IR 列表
结构体 程序IR {
    向量<函数IR> 函数们
}

// ==================== 指令追加辅助 ====================
// 引用传递：按值传 向量 会共享数据指针，.追加 扩容释放旧数组 -> 调用方向量悬垂。
函数 IR追加(向量<IR指令>& 列表, IR指令 指令) -> 空类型 {
    结果<空类型, 整32> 加 = 列表.追加(指令)
    如果 (!加.正常) { 运行时错误(4) }
}
函数 建IR指令(整64 操作码, 整64 操作数1, 整64 操作数2, 整64 操作数3,
              整64 目标, 整64 类型, 整64 附加) -> IR指令 {
    IR指令 指令
    指令.操作码 = 操作码
    指令.操作数1 = 操作数1
    指令.操作数2 = 操作数2
    指令.操作数3 = 操作数3
    指令.目标 = 目标
    指令.类型 = 类型
    指令.附加 = 附加
    返回 指令
}

// ==================== 控制流辅助（P6b） ====================
// 新建块：返回唯一块 ID（标签随建随取——嵌套控制流每个标签独立计数）
函数 新块(函数IR& 函数信息) -> 整64 {
    函数信息.块计数 = 函数信息.块计数 + 1
    返回 函数信息.块计数
}

// 发射无条件跳转到目标块
函数 发射跳转(函数IR& 函数信息, 整64 目标块) -> 空类型 {
    IR追加(函数信息.指令, 建IR指令(IR_跳转, 0, 0, 0, 0, 0, 目标块))
}

// 发射条件跳转：条件寄存器 非零 -> 真块；零 -> 假块
函数 发射条件跳转(函数IR& 函数信息, 整64 条件寄存器, 整64 真块, 整64 假块) -> 空类型 {
    IR追加(函数信息.指令, 建IR指令(IR_条件跳转, 条件寄存器, 真块, 假块, 0, 0, 0))
}

// 发射块标签：MASM 需要标号（bbN:）。IR 层只登记块 ID，代码生成按块号输出标签。
函数 发射块标签(函数IR& 函数信息, 整64 块ID) -> 空类型 {
    // 块标签无需 IR 指令——代码生成按 当前块 切换时输出；此辅助仅作文档性登记
    IR追加(函数信息.指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 块ID))
}

// 切换当前块：记录 当前块；代码生成据此输出 bbN: 标签
函数 切换块(函数IR& 函数信息, 整64 块ID) -> 空类型 {
    函数信息.当前块 = 块ID
}

// ==================== 类型名 -> IR 类型码 ====================
// 源码类型名（驻留文本）-> IR 类型码（T_*）。未知返回 T_未知。
函数 类型码(整64 类型名ID) -> 整64 {
    字符串 名 = 驻留文本(类型名ID)
    // CN 字符串 == 是指针比较（非内容）——须用 字符串比较
    如果 (字符串比较(名, "整32")) { 返回 T_整32 }
    如果 (字符串比较(名, "整64")) { 返回 T_整64 }
    如果 (字符串比较(名, "浮32")) { 返回 T_浮32 }
    如果 (字符串比较(名, "浮64")) { 返回 T_浮64 }
    如果 (字符串比较(名, "布尔")) { 返回 T_布尔 }
    如果 (字符串比较(名, "字符串")) { 返回 T_字符串 }
    如果 (字符串比较(名, "空类型")) { 返回 T_空类型 }
    如果 (字符串比较(名, "整8") || 字符串比较(名, "整16") ||
        字符串比较(名, "正8") || 字符串比较(名, "正16") ||
        字符串比较(名, "正32") || 字符串比较(名, "正64") ||
        字符串比较(名, "字符") || 字符串比较(名, "指针") ||
        字符串比较(名, "自动")) { 返回 T_整64 }
    返回 T_未知
}

// ==================== 表达式后缀求值 ====================
// 遍历 池[起点, 终点) 内表达式节点（后缀栈），生成指令到 目标 指令数组。
// 返回表达式结果寄存器 ID（0=无）。
// 栈：表达式寄存器栈（向量<整64>）。
函数 生成表达式(向量<节点> 池, 整32 起点, 整32 终点,
                 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                 向量<IR指令>& 指令, 整64* 寄存器计数, 向量<整64>& 表达式栈) -> 整64 {
    // P6c：预扫描 节点_取地址 子区间（&对象 的子节点不单独生成，避免重复指令）
    向量<整64> 取址区间们 = 向量<整64>()
    整32 预扫 = 起点
    当 (预扫 < 终点) {
        节点 预节点 = 池.元素(预扫)
        如果 (预节点.类型 == 节点_取地址) {
            结果<空类型, 整32> 加区 = 取址区间们.追加(整64(预节点.子起点))
            如果 (!加区.正常) { 运行时错误(4) }
            结果<空类型, 整32> 加区2 = 取址区间们.追加(整64(预节点.子终点))
            如果 (!加区2.正常) { 运行时错误(4) }
        }
        预扫++
    }
    整32 位置 = 起点
    当 (位置 < 终点) {
        // 跳过 取地址 子区间
        布尔 在取址区间 = 假
        整64 取i = 0
        当 (取i < 取址区间们.大小()) {
            整64 区起 = 取址区间们.元素(取i)
            整64 区终 = 取址区间们.元素(取i + 1)
            如果 (整64(位置) >= 区起 && 整64(位置) < 区终) {
                在取址区间 = 真
                位置 = 整32(区终)
                中断
            }
            取i += 2
        }
        如果 (在取址区间) { 继续 }
        节点 n = 池.元素(位置)
        如果 (n.类型 == 节点_整数字面量) {
            // 常量整数：操作数1=Symbol ID（文本），类型=整64
            整64 寄存器 = 寄存器计数[0]
            寄存器计数[0] = 寄存器计数[0] + 1
            IR追加(指令, 建IR指令(IR_常量整数, 整64(n.文本), 0, 0, 寄存器, T_整64, 0))
            结果<空类型, 整32> 加 = 表达式栈.追加(寄存器)
            如果 (!加.正常) { 运行时错误(4) }
        } 否则 如果 (n.类型 == 节点_标识符) {
            // 标识符：参数槽 优先，其次 局部槽；Load 槽 -> 寄存器
            整64 槽 = 0
            结果<整64, 整32> 找参 = 参数槽.获取(整64(n.文本))
            如果 (找参.正常) { 槽 = 找参.值 }
            如果 (槽 == 0) {
                结果<整64, 整32> 找局 = 局部槽.获取(整64(n.文本))
                如果 (找局.正常) { 槽 = 找局.值 }
            }
            如果 (槽 == 0) {
                // 函数名（调用 被调对象）：压 负数符号 到 表达式栈（0-符号ID），
                //   非变量（参数/局部 查无）——语义层已检查未声明
                结果<空类型, 整32> 加函 = 表达式栈.追加(0 - 整64(n.文本))
                如果 (!加函.正常) { 运行时错误(4) }
                位置++
                继续
            }
            整64 寄存器 = 寄存器计数[0]
            寄存器计数[0] = 寄存器计数[0] + 1
            IR追加(指令, 建IR指令(IR_加载, 槽, 0, 0, 寄存器, T_整64, 0))
            结果<空类型, 整32> 加 = 表达式栈.追加(寄存器)
            如果 (!加.正常) { 运行时错误(4) }
        } 否则 如果 (n.类型 == 节点_二元运算) {
            // 弹 2 个操作数，生成运算指令
            整64 右 = 0
            整64 左 = 0
            如果 (表达式栈.大小() >= 2) {
                右 = 表达式栈.元素(表达式栈.大小() - 1)
                结果<空类型, 整32> 删右 = 表达式栈.删除(表达式栈.大小() - 1)
                如果 (!删右.正常) { 运行时错误(4) }
                左 = 表达式栈.元素(表达式栈.大小() - 1)
                结果<空类型, 整32> 删左 = 表达式栈.删除(表达式栈.大小() - 1)
                如果 (!删左.正常) { 运行时错误(4) }
            }
            整64 op = 0
            字符串 op名 = 驻留文本(整64(n.文本))
            // CN 字符串 == 是指针比较（非内容）——须用 字符串比较
            如果 (字符串比较(op名, "+")) { op = IR_加 }
            否则 如果 (字符串比较(op名, "-")) { op = IR_减 }
            否则 如果 (字符串比较(op名, "*")) { op = IR_乘 }
            否则 如果 (字符串比较(op名, "/")) { op = IR_除 }
            否则 如果 (字符串比较(op名, "%")) { op = IR_取余 }
            否则 如果 (字符串比较(op名, "==")) { op = IR_相等 }
            否则 如果 (字符串比较(op名, "!=")) { op = IR_不等 }
            否则 如果 (字符串比较(op名, "<")) { op = IR_小于 }
            否则 如果 (字符串比较(op名, ">")) { op = IR_大于 }
            否则 如果 (字符串比较(op名, "<=")) { op = IR_小于等于 }
            否则 如果 (字符串比较(op名, ">=")) { op = IR_大于等于 }
            否则 如果 (字符串比较(op名, "&&")) { op = IR_相等 }  // 逻辑与（短路未实现，按相等防御）
            否则 如果 (字符串比较(op名, "||")) { op = IR_相等 }
            整64 寄存器 = 寄存器计数[0]
            寄存器计数[0] = 寄存器计数[0] + 1
            IR追加(指令, 建IR指令(op, 左, 右, 0, 寄存器, T_整64, 0))
            结果<空类型, 整32> 加 = 表达式栈.追加(寄存器)
            如果 (!加.正常) { 运行时错误(4) }
        } 否则 如果 (n.类型 == 节点_逻辑非) {
            // 一元逻辑非：生成操作数（子区间）-> IR_逻辑非
            整64 操作数寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                         指令, 寄存器计数, 表达式栈)
            整64 寄存器 = 寄存器计数[0]
            寄存器计数[0] = 寄存器计数[0] + 1
            IR追加(指令, 建IR指令(IR_逻辑非, 操作数寄存器, 0, 0, 寄存器, T_整64, 0))
            结果<空类型, 整32> 加 = 表达式栈.追加(寄存器)
            如果 (!加.正常) { 运行时错误(4) }
        } 否则 如果 (n.类型 == 节点_负号) {
            // 一元负：生成操作数（子区间）-> IR_负
            整64 操作数寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                         指令, 寄存器计数, 表达式栈)
            整64 寄存器 = 寄存器计数[0]
            寄存器计数[0] = 寄存器计数[0] + 1
            IR追加(指令, 建IR指令(IR_负, 操作数寄存器, 0, 0, 寄存器, T_整64, 0))
            结果<空类型, 整32> 加 = 表达式栈.追加(寄存器)
            如果 (!加.正常) { 运行时错误(4) }
        } 否则 如果 (n.类型 == 节点_取地址) {
            // & 左值：子区间节点已被线性遍历（位置值/成员值 残留栈），
            //   生成地址后 弹出残留再压地址（P6c）
            整64 地址寄存器 = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                         指令, 寄存器计数, 表达式栈)
            当 (表达式栈.大小() > 0) {
                结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1)
                如果 (!删栈.正常) { 运行时错误(4) }
            }
            结果<空类型, 整32> 加 = 表达式栈.追加(地址寄存器)
            如果 (!加.正常) { 运行时错误(4) }
        } 否则 如果 (n.类型 == 节点_解引用) {
            // * 指针：生成操作数（地址寄存器）-> IR_指针加载
            整64 地址寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                         指令, 寄存器计数, 表达式栈)
            整64 寄存器 = 寄存器计数[0]
            寄存器计数[0] = 寄存器计数[0] + 1
            IR追加(指令, 建IR指令(IR_指针加载, 地址寄存器, 0, 0, 寄存器, T_整64, 0))
            结果<空类型, 整32> 加 = 表达式栈.追加(寄存器)
            如果 (!加.正常) { 运行时错误(4) }
        } 否则 如果 (n.类型 == 节点_成员) {
            // 对象.字段 / 对象->字段：弹对象地址/基址 -> IR_字段地址（偏移在附加）-> 压地址
            // 对象若是标识符：取槽地址；若是解引用/成员：栈顶即地址
            整64 基址寄存器 = 0
            节点 对象节点 = 池.元素(n.子起点)  // 子起点=对象节点索引（P6c 解析时记录）
            // 无论对象形态，先弹掉表达式栈顶（标识符=Load 值丢弃；解引用/成员=地址复用）
            如果 (表达式栈.大小() >= 1) {
                基址寄存器 = 表达式栈.元素(表达式栈.大小() - 1)
                结果<空类型, 整32> 删 = 表达式栈.删除(表达式栈.大小() - 1)
                如果 (!删.正常) { 运行时错误(4) }
            }
            如果 (对象节点.类型 == 节点_标识符) {
                // 标识符对象：栈顶是 Load 值，需重新取槽地址（结构体存于槽）
                整64 对象槽 = 0
                结果<整64, 整32> 找局 = 局部槽.获取(整64(对象节点.文本))
                如果 (找局.正常) { 对象槽 = 找局.值 }
                如果 (对象槽 == 0) {
                    结果<整64, 整32> 找参 = 参数槽.获取(整64(对象节点.文本))
                    如果 (找参.正常) { 对象槽 = 找参.值 }
                }
                整64 地址寄存器2 = 寄存器计数[0]
                寄存器计数[0] = 寄存器计数[0] + 1
                IR追加(指令, 建IR指令(IR_取地址, 对象槽, 0, 0, 地址寄存器2, T_整64, 0))
                基址寄存器 = 地址寄存器2
            }
            整64 寄存器 = 寄存器计数[0]
            寄存器计数[0] = 寄存器计数[0] + 1
            IR追加(指令, 建IR指令(IR_字段地址, 基址寄存器, 0, 0, 寄存器, T_整64, n.附加))
            // 成员访问作为右值：字段地址 -> 立即取值（压值；赋值左值走专用路径）
            整64 值寄存器 = 寄存器计数[0]
            寄存器计数[0] = 寄存器计数[0] + 1
            IR追加(指令, 建IR指令(IR_指针加载, 寄存器, 0, 0, 值寄存器, T_整64, 0))
            结果<空类型, 整32> 加 = 表达式栈.追加(值寄存器)
            如果 (!加.正常) { 运行时错误(4) }
        } 否则 如果 (n.类型 == 节点_调用) {
            // 函数调用：弹 实参（栈顶=最后一个实参，逆序到 参数1/2/3）+ 被调（负数函数符号）
            整64 实参数 = n.附加
            整64 参数1 = 0
            整64 参数2 = 0
            整64 参数3 = 0
            整64 弹值 = 0
            如果 (实参数 == 3) {
                弹值 = 表达式栈.元素(表达式栈.大小() - 1)
                结果<空类型, 整32> 删3 = 表达式栈.删除(表达式栈.大小() - 1)
                参数3 = 弹值
                弹值 = 表达式栈.元素(表达式栈.大小() - 1)
                结果<空类型, 整32> 删2 = 表达式栈.删除(表达式栈.大小() - 1)
                参数2 = 弹值
                弹值 = 表达式栈.元素(表达式栈.大小() - 1)
                结果<空类型, 整32> 删1 = 表达式栈.删除(表达式栈.大小() - 1)
                参数1 = 弹值
            } 否则 如果 (实参数 == 2) {
                弹值 = 表达式栈.元素(表达式栈.大小() - 1)
                结果<空类型, 整32> 删2 = 表达式栈.删除(表达式栈.大小() - 1)
                参数2 = 弹值
                弹值 = 表达式栈.元素(表达式栈.大小() - 1)
                结果<空类型, 整32> 删1 = 表达式栈.删除(表达式栈.大小() - 1)
                参数1 = 弹值
            } 否则 如果 (实参数 == 1) {
                弹值 = 表达式栈.元素(表达式栈.大小() - 1)
                结果<空类型, 整32> 删1 = 表达式栈.删除(表达式栈.大小() - 1)
                参数1 = 弹值
            }
            整64 被调 = 表达式栈.元素(表达式栈.大小() - 1)
            结果<空类型, 整32> 删被调 = 表达式栈.删除(表达式栈.大小() - 1)
            如果 (被调 >= 0) { 运行时错误(7) }  // 成员调用/非函数名 暂不支持
            整64 函数符号 = 0 - 被调
            整64 寄存器 = 寄存器计数[0]
            寄存器计数[0] = 寄存器计数[0] + 1
            IR追加(指令, 建IR指令(IR_调用, 参数1, 参数2, 参数3, 寄存器, 0, 函数符号))
            结果<空类型, 整32> 加 = 表达式栈.追加(寄存器)
            如果 (!加.正常) { 运行时错误(4) }
        }
        位置++
    }
    如果 (表达式栈.大小() == 0) { 返回 0 }
    返回 表达式栈.元素(表达式栈.大小() - 1)
}

// ==================== 左值地址生成（P6c） ====================
// 生成左值区间 [起点, 终点) 的地址（标识符->槽地址；成员->字段地址；解引用->操作数地址）。
// 不走 生成表达式（成员会取值）；返回地址寄存器（0=失败）。
函数 生成左值地址(向量<节点> 池, 整32 起点, 整32 终点,
                 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                 向量<IR指令>& 指令, 整64* 寄存器计数, 向量<整64>& 表达式栈) -> 整64 {
    // 顺序遍历左值区间：标识符 -> 槽地址；成员 -> 基于当前基址字段地址；
    //   解引用 -> 其操作数（指针值）即地址。
    // 若区间末尾是 解引用 根节点（*指针）：其操作数即地址，前面节点（指针）跳过
    节点 末节点 = 池.元素(终点 - 1)
    如果 (末节点.类型 == 节点_解引用) {
        整64 地址 = 生成表达式(池, 末节点.子起点, 末节点.子终点, 局部槽, 参数槽,
                               指令, 寄存器计数, 表达式栈)
        当 (表达式栈.大小() > 0) {
            结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1)
            如果 (!删栈.正常) { 运行时错误(4) }
        }
        返回 地址
    }
    整64 当前地址 = 0
    整32 位置 = 起点
    当 (位置 < 终点) {
        节点 左 = 池.元素(位置)
        如果 (左.类型 == 节点_标识符) {
            整64 槽 = 0
            结果<整64, 整32> 找局 = 局部槽.获取(整64(左.文本))
            如果 (找局.正常) { 槽 = 找局.值 }
            如果 (槽 == 0) {
                结果<整64, 整32> 找参 = 参数槽.获取(整64(左.文本))
                如果 (找参.正常) { 槽 = 找参.值 }
            }
            整64 寄存器 = 寄存器计数[0]
            寄存器计数[0] = 寄存器计数[0] + 1
            IR追加(指令, 建IR指令(IR_取地址, 槽, 0, 0, 寄存器, T_整64, 0))
            当前地址 = 寄存器
        } 否则 如果 (左.类型 == 节点_成员) {
            整64 寄存器 = 寄存器计数[0]
            寄存器计数[0] = 寄存器计数[0] + 1
            IR追加(指令, 建IR指令(IR_字段地址, 当前地址, 0, 0, 寄存器, T_整64, 左.附加))
            当前地址 = 寄存器
        } 否则 如果 (左.类型 == 节点_解引用) {
            当前地址 = 生成表达式(池, 左.子起点, 左.子终点, 局部槽, 参数槽,
                                   指令, 寄存器计数, 表达式栈)
            当 (表达式栈.大小() > 0) {
                结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1)
                如果 (!删栈.正常) { 运行时错误(4) }
            }
        }
        位置++
    }
    返回 当前地址
}

// ==================== 语句遍历 ====================
// 生成 池[块起点, 块终点) 内语句的 IR。本阶段语句级支持 变量声明/返回/表达式语句/
//   赋值/自增/如果/当/中断/继续（P6b 控制流）。
函数 生成语句(向量<节点> 池, 整32 起点, 整32 终点,
              映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
              函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
              向量<整64>& 表达式栈, 整64 返回类型码) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令
    // 预扫描：收集本块内 控制流语句（如果/当）的体块节点索引——
    //   体语句节点在池中位于控制流语句节点之前（顺序追加），会被本块区间
    //   直接包含；若直接生成会造成「体语句在外层重复生成」。收集后遍历时跳过。
    向量<整64> 体块们 = 向量<整64>()
    整32 扫 = 起点
    当 (扫 < 终点) {
        节点 扫节点 = 池.元素(扫)
        如果 (扫节点.类型 == 节点_如果语句) {
            // 节点字段：附加=真块索引，子终点=否则索引
            结果<空类型, 整32> 加真 = 体块们.追加(整64(扫节点.附加))
            如果 (!加真.正常) { 运行时错误(4) }
            如果 (扫节点.子终点 != 0) {
                节点 否则节点 = 池.元素(整32(扫节点.子终点))
                如果 (否则节点.类型 == 节点_块) {
                    结果<空类型, 整32> 加否 = 体块们.追加(整64(扫节点.子终点))
                    如果 (!加否.正常) { 运行时错误(4) }
                }
            }
        } 否则 如果 (扫节点.类型 == 节点_当语句) {
            结果<空类型, 整32> 加当 = 体块们.追加(整64(扫节点.附加))
            如果 (!加当.正常) { 运行时错误(4) }
        }
        扫++
    }
    整32 位置 = 起点
    当 (位置 < 终点) {
        // 跳过控制流语句的体块（体语句节点在控制流语句节点之前，已被预扫描收集）
        布尔 跳过 = 假
        整64 跳块 = 0
        整64 b = 0
        当 (b < 体块们.大小()) {
            整64 体块索引 = 体块们.元素(b)
            如果 (整64(位置) == 体块索引) {
                跳过 = 真
                跳块 = 体块索引
            } 否则 {
                节点 体块节点 = 池.元素(整32(体块索引))
                如果 (整64(位置) >= 整64(体块节点.子起点) && 整64(位置) < 体块索引) {
                    跳过 = 真
                    跳块 = 体块索引
                }
            }
            b++
        }
        如果 (跳过) {
            位置 = 整32(跳块 + 1)
            继续
        }
        节点 n = 池.元素(位置)
        如果 (n.类型 == 节点_变量声明) {
            // 变量声明：分配槽；若有初值（子起点<子终点），生成初值表达式 + 存储。
            整64 槽 = 槽计数[0]
            槽计数[0] = 槽计数[0] + 1
            结果<空类型, 整32> 设槽 = 局部槽.设置(整64(n.文本), 槽)
            如果 (!设槽.正常) { 运行时错误(4) }
            IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽))
            如果 (n.子起点 < n.子终点) {
                整64 值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                             指令, 寄存器计数, 表达式栈)
                如果 (值寄存器 != 0) {
                    IR追加(指令, 建IR指令(IR_存储, 值寄存器, 0, 0, 0, 0, 槽))
                }
            }
        } 否则 如果 (n.类型 == 节点_返回语句) {
            整64 值寄存器 = 0
            如果 (n.子起点 < n.子终点) {
                值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                       指令, 寄存器计数, 表达式栈)
            }
            IR追加(指令, 建IR指令(IR_返回, 值寄存器, 0, 0, 0, 返回类型码, 0))
        } 否则 如果 (n.类型 == 节点_表达式语句) {
            // 表达式语句：求值（结果丢弃）。子区间为表达式节点。
            如果 (n.子起点 < n.子终点) {
                生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                            指令, 寄存器计数, 表达式栈)
            }
        } 否则 如果 (n.类型 == 节点_赋值) {
            // 赋值：文本=左值名（标识符）；文本=0 时 附加=左值表达式起点（解引用/成员左值）
            如果 (n.文本 != 0) {
                // 标识符左值：槽 <- 右值寄存器
                整64 目标槽 = 0
                结果<整64, 整32> 找槽 = 局部槽.获取(整64(n.文本))
                如果 (找槽.正常) { 目标槽 = 找槽.值 }
                如果 (目标槽 == 0) {
                    结果<整64, 整32> 找参 = 参数槽.获取(整64(n.文本))
                    如果 (找参.正常) { 目标槽 = 找参.值 }
                }
                整64 值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                            指令, 寄存器计数, 表达式栈)
                如果 (值寄存器 != 0 && 目标槽 != 0) {
                    IR追加(指令, 建IR指令(IR_存储, 值寄存器, 0, 0, 0, 0, 目标槽))
                }
                // 清空表达式栈（右值 残留）
                当 (表达式栈.大小() > 0) {
                    结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1)
                    如果 (!删栈.正常) { 运行时错误(4) }
                }
            } 否则 {
                // 成员/解引用左值：手动生成左值地址（不走 生成表达式，避免成员取值）
                整64 地址寄存器 = 生成左值地址(池, 整32(n.附加), n.子起点, 局部槽, 参数槽,
                                            指令, 寄存器计数, 表达式栈)
                整64 值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                           指令, 寄存器计数, 表达式栈)
                如果 (地址寄存器 != 0 && 值寄存器 != 0) {
                    IR追加(指令, 建IR指令(IR_指针存储, 地址寄存器, 值寄存器, 0, 0, 0, 0))
                }
                // 清空表达式栈（右值 残留）
                当 (表达式栈.大小() > 0) {
                    结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1)
                    如果 (!删栈.正常) { 运行时错误(4) }
                }
            }
        } 否则 如果 (n.类型 == 节点_自增) {
            // 自增：Load 槽 +1 -> Store（P6b 语句级）
            整64 目标槽 = 0
            结果<整64, 整32> 找槽 = 局部槽.获取(整64(n.文本))
            如果 (找槽.正常) { 目标槽 = 找槽.值 }
            如果 (目标槽 == 0) {
                结果<整64, 整32> 找参 = 参数槽.获取(整64(n.文本))
                如果 (找参.正常) { 目标槽 = 找参.值 }
            }
            如果 (目标槽 != 0) {
                整64 寄存器1 = 寄存器计数[0]
                寄存器计数[0] = 寄存器计数[0] + 1
                IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 寄存器1, T_整64, 0))
                整64 常量1 = 寄存器计数[0]
                寄存器计数[0] = 寄存器计数[0] + 1
                IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("1")), 0, 0, 常量1, T_整64, 0))
                整64 结果寄存器 = 寄存器计数[0]
                寄存器计数[0] = 寄存器计数[0] + 1
                IR追加(指令, 建IR指令(IR_加, 寄存器1, 常量1, 0, 结果寄存器, T_整64, 0))
                IR追加(指令, 建IR指令(IR_存储, 结果寄存器, 0, 0, 0, 0, 目标槽))
            }
        } 否则 如果 (n.类型 == 节点_如果语句) {
            生成如果(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码)
        } 否则 如果 (n.类型 == 节点_当语句) {
            生成当(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码)
        } 否则 如果 (n.类型 == 节点_中断语句) {
            // 中断：跳转到最近循环出口块（函数信息.循环出口块）
            如果 (函数信息.循环出口块 != 0) {
                发射跳转(函数信息, 函数信息.循环出口块)
            }
        } 否则 如果 (n.类型 == 节点_继续语句) {
            // 继续：跳转到最近循环继续块
            如果 (函数信息.循环继续块 != 0) {
                发射跳转(函数信息, 函数信息.循环继续块)
            }
        }
        位置++
    }
}

// ==================== 块遍历 ====================
// 生成一个块的语句 IR。
函数 生成块(向量<节点> 池, 整32 块节点,
            映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
            函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
            向量<整64>& 表达式栈, 整64 返回类型码) -> 空类型 {
    节点 块 = 池.元素(块节点)
    生成语句(池, 块.子起点, 块.子终点, 局部槽, 参数槽, 函数信息,
             寄存器计数, 槽计数, 表达式栈, 返回类型码)
}

// ==================== 控制流生成（P6b） ====================
// 生成 如果语句：条件寄存器 + 真块/假块 + 汇合块（标签随建随取）
函数 生成如果(向量<节点> 池, 节点 如果节点,
              映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
              函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
              向量<整64>& 表达式栈, 整64 返回类型码) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令
    // 节点字段：文本=条件起点，子起点=条件终点，附加=真块索引，子终点=否则索引
    整64 条件寄存器 = 生成表达式(池, 整32(如果节点.文本), 整32(如果节点.子起点),
                                 局部槽, 参数槽, 指令, 寄存器计数, 表达式栈)
    整64 真块 = 新块(函数信息)
    整64 假块 = 新块(函数信息)
    整64 汇合块 = 新块(函数信息)
    发射条件跳转(函数信息, 条件寄存器, 真块, 假块)
    // 真块
    切换块(函数信息, 真块)
    发射块标签(函数信息, 真块)
    生成块(池, 整32(如果节点.附加), 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码)
    发射跳转(函数信息, 汇合块)
    // 假块（否则链）
    切换块(函数信息, 假块)
    发射块标签(函数信息, 假块)
    整64 否则索引 = 如果节点.子终点
    如果 (否则索引 != 0) {
        节点 否则节点 = 池.元素(整32(否则索引))
        如果 (否则节点.类型 == 节点_如果语句) {
            // 否则 如果：递归生成（不额外发射跳转到汇合——递归内已处理）
            生成如果(池, 否则节点, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码)
        } 否则 {
            生成块(池, 整32(否则索引), 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码)
        }
    }
    发射跳转(函数信息, 汇合块)
    // 汇合块
    切换块(函数信息, 汇合块)
    发射块标签(函数信息, 汇合块)
}

// 生成 当语句：jmp 条件块 -> 条件表达式 -> 条件跳转 体/出口 -> 体 -> jmp 条件块
函数 生成当(向量<节点> 池, 节点 当节点,
            映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
            函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
            向量<整64>& 表达式栈, 整64 返回类型码) -> 空类型 {
    向量<IR指令>& 指令 = 函数信息.指令
    整64 条件块 = 新块(函数信息)
    整64 体块 = 新块(函数信息)
    整64 出口块 = 新块(函数信息)
    // 无条件跳入条件块
    发射跳转(函数信息, 条件块)
    // 条件块
    切换块(函数信息, 条件块)
    发射块标签(函数信息, 条件块)
    // 节点字段：文本=条件起点，附加=体块索引，子起点=条件终点
    整64 条件寄存器 = 生成表达式(池, 整32(当节点.文本), 整32(当节点.子起点),
                                 局部槽, 参数槽, 指令, 寄存器计数, 表达式栈)
    发射条件跳转(函数信息, 条件寄存器, 体块, 出口块)
    // 体块：记录循环上下文（继续->条件块，中断->出口块）
    整64 旧出口 = 函数信息.循环出口块
    整64 旧继续 = 函数信息.循环继续块
    函数信息.循环出口块 = 出口块
    函数信息.循环继续块 = 条件块
    切换块(函数信息, 体块)
    发射块标签(函数信息, 体块)
    生成块(池, 整32(当节点.附加), 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码)
    函数信息.循环出口块 = 旧出口
    函数信息.循环继续块 = 旧继续
    发射跳转(函数信息, 条件块)
    // 出口块
    切换块(函数信息, 出口块)
    发射块标签(函数信息, 出口块)
}

// ==================== 函数遍历 ====================
// 从函数节点生成 函数IR（参数槽 + 局部槽 + 指令）。
函数 生成函数(向量<节点> 池, 整32 函数节点) -> 函数IR {
    函数IR 函数信息
    // 结构体裸声明不调用字段默认构造——容器字段须显式初始化（否则 .追加/.设置 空指针/垃圾）
    函数信息.指令 = 向量<IR指令>()
    函数信息.局部槽 = 映射<整64, 整64>()
    函数信息.参数槽 = 映射<整64, 整64>()
    节点 函数声明 = 池.元素(函数节点)
    函数信息.名字 = 函数声明.文本
    函数信息.返回类型 = 类型码(整64(函数声明.附加))
    函数信息.块计数 = 0      // P6b：块编号从 0（入口块）起
    函数信息.当前块 = 0
    函数信息.循环出口块 = 0
    函数信息.循环继续块 = 0
    整64 寄存器计数 = 1
    整64 槽计数 = 1
    向量<整64> 表达式栈 = 向量<整64>()
    // 参数：函数节点子区间 [子起点, 块.子起点) 为参数节点（块 在 子终点=块索引）；
    //   块 的语句节点（表达式/返回）在 [块.子起点, 块索引)，不能当参数遍历。
    整64 参数起点 = 整64(函数声明.子起点)
    整32 块索引 = 函数声明.子终点
    整64 参数终点 = 参数起点
    如果 (块索引 < 池.大小()) {
        节点 块节点 = 池.元素(块索引)
        参数终点 = 整64(块节点.子起点)
    }
    整64 参数位置 = 参数起点
    当 (参数位置 < 参数终点) {
        节点 参数 = 池.元素(整32(参数位置))
        // 只注册 参数 节点（区间可能含 块语句前的非参数节点）
        如果 (参数.类型 == 节点_参数) {
            整64 槽 = 槽计数
            槽计数++
            结果<空类型, 整32> 设参 = 函数信息.参数槽.设置(整64(参数.文本), 槽)
            如果 (!设参.正常) { 运行时错误(4) }
        }
        参数位置++
    }
    // 函数体：块 在 函数声明.子终点（块索引）
    如果 (块索引 < 池.大小()) {
        生成块(池, 块索引, 函数信息.局部槽, 函数信息.参数槽, 函数信息,
                &寄存器计数, &槽计数, 表达式栈, 函数信息.返回类型)
    }
    返回 函数信息
}

// ==================== 程序遍历 ====================
// 从 程序 节点生成 程序IR（所有函数）。
函数 IR生成(向量<节点> 池, 整32 程序节点) -> 程序IR {
    程序IR 程序
    // 结构体裸声明不调用字段默认构造——容器字段须显式初始化（否则 .追加 空指针/垃圾）
    程序.函数们 = 向量<函数IR>()
    节点 程序声明 = 池.元素(程序节点)
    整64 位置 = 整64(程序声明.子起点)
    整64 终点 = 整64(程序声明.子终点)
    当 (位置 < 终点) {
        节点 声明 = 池.元素(整32(位置))
        如果 (声明.类型 == 节点_函数) {
            函数IR 函数信息 = 生成函数(池, 整32(位置))
            结果<空类型, 整32> 加 = 程序.函数们.追加(函数信息)
            如果 (!加.正常) { 运行时错误(4) }
        }
        位置++
    }
    返回 程序
}
