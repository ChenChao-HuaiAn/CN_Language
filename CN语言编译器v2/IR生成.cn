// CN 自举编译器 v2：结构化 IR 生成器（自举重建 P5，2026-08-25）
// 性能最优架构第三层：AST 节点池（后缀表达式栈）-> 三地址码 IR 指令数组。
// 设计（对标 rustc/LLVM）：
//   - 指令为结构化结构体（操作码/操作数/结果寄存器/类型码/附加），非字符串行。
//   - 寄存器 = 整数 ID（虚拟寄存器，代码生成阶段映射到栈槽）。
//   - 表达式按后缀栈求值：遍历节点池区间，字面量/标识符压栈（生成加载指令），
//     二元/后缀操作符弹栈生成运算指令，结果压栈。
//   - 语句按 子起点/子终点 区间遍历；变量声明分配槽（映射 名ID -> 槽索引）。
// 依赖：P2 词法（Token）/ P3 语法（节点池）/ P4 语义（类型检查）。
// 说明：本组件只生成 IR 指令（不含汇编输出——汇编在 P6 代码生成组件）。

导入 容器::向量;
导入 语法分析;   // Token/AST 解析产物（节点池、结构体 节点）
导入 IR容器;    // P7b：容器类型判定/对象大小/方法签名表/符号合成
导入 IR常量;    // 簇①根治·A2（2026-09-04）：IR_*/T_* 操作码类型码与 当前函数变量类型
               //   单一归属 IR常量.cn（原定义在本文件顶层，IR容器 引用不可导=循环）

公开:

// ==================== 结构化 IR 指令 ====================
// 呈报①A 根治（2026-09-05）：IR指令/函数IR 结构体定义下沉至 IR容器.cn
//   （本文件导入它）——原定义在本文件顶层，IR容器.cn 引用它们而 IR生成 导入
//   IR容器 = 反向引用不可导；主链靠多文件合并全局可见，冒烟子链（IR容器/
//   语法分析/语义分析 入口，链上无本文件）结构体登记缺失 -> 方法对象类型解析
//   查结构体大小 miss =「方法调用的对象类型未知: 元素」误诊（曾误归因
//   IR常量.cn 新增常量对——第十四轮消融的「不触发」系检查面不全/陈旧产物假绿）。
//   此处纯名引用（导入 IR容器 后全局可见）。程序IR 定义保留在本文件
//   （引用方：代码生成族/主——导入链恒含本文件）。

// 程序 IR：函数 IR 列表
结构体 程序IR {
    向量<函数IR> 函数们;
    整64 静态数;              // ②c C：静态槽总数（双后端 .data 发射 _cn_gstatic_N）
    向量<整64> 静态初始值们;  // ②c C：各静态初始值文本ID（容器=0；标量=折叠字面量）
}

// ==================== 控制流辅助（P6b） ====================
// 新建块：返回唯一块 ID（标签随建随取——嵌套控制流每个标签独立计数）
函数 新块(函数IR& 函数信息) -> 整64 {
    函数信息.块计数 = 函数信息.块计数 + 1;
    返回 函数信息.块计数;
}

// 发射无条件跳转到目标块
函数 发射跳转(函数IR& 函数信息, 整64 目标块) -> 空类型 {
    IR追加(函数信息.指令, 建IR指令(IR_跳转, 0, 0, 0, 0, 0, 目标块));
}

// 发射条件跳转：条件寄存器 非零 -> 真块；零 -> 假块
函数 发射条件跳转(函数IR& 函数信息, 整64 条件寄存器, 整64 真块, 整64 假块) -> 空类型 {
    IR追加(函数信息.指令, 建IR指令(IR_条件跳转, 条件寄存器, 真块, 假块, 0, 0, 0));
}

// 发射块标签：MASM 需要标号（bbN:）。IR 层只登记块 ID，代码生成按块号输出标签。
函数 发射块标签(函数IR& 函数信息, 整64 块ID) -> 空类型 {
    // 块标签无需 IR 指令——代码生成按 当前块 切换时输出；此辅助仅作文档性登记
    IR追加(函数信息.指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 块ID));
}

// 切换当前块：记录 当前块；代码生成据此输出 bbN: 标签
函数 切换块(函数IR& 函数信息, 整64 块ID) -> 空类型 {
    函数信息.当前块 = 块ID;
}

// ==================== 成员宽度/链式偏移收口（②b B5，2026-09-02） ====================
// 根治：字段按统一 8 字节读/写——末字段越界清零相邻槽（126 段① i 槽被 子终点
//   8 字节写击穿 -> 当循环死循环 -> 堆 OOM SIGKILL）+ 链式 池.元素(i).字段
//   偏移扁平回退（同名字段跨结构体必错）。宽度/偏移按 结构体名ID*键位移+字段名ID
//   分桶查（IR容器 字段类型表/字段偏移表们）。

// ②b B6：当前函数 retbuf 最大返回字节数（生成表达式 触不到 函数信息——模块级
//   累计；生成函数 入口清零、出口回填 函数信息.retbuf字节数）
静态 整64 当前retbuf字节数 = 0;

// 解析标识符对象的结构体名ID（②c D：函数级变量类型权威表 优先——解析期
//   变量结构体表 跨函数同名异型会串；值=1 是结构体名标记非对象类型）。0=非结构体对象。
函数 解析对象结构体ID(节点 对象节点) -> 整64 {
    如果 (对象节点.类型 != 节点_标识符) { 返回 0; }
    结果<整64, 整32> 查权威 = 当前函数变量类型.获取(整64(对象节点.文本));
    如果 (查权威.正常) {
        如果 (查结构体大小(查权威.值) != 0) { 返回 查权威.值; }
        返回 0;
    }
    返回 查结构体类型(整64(对象节点.文本));
}

// 解析调用对象（池.元素(i).字段 的对象）的返回结构体名ID——经被调方法签名返回
//   文本分桶收口；0=非结构体返回。②c A/B：对象经 解析节点类型ID 统一推导
//   （标识符/成员/调用 递归——函数级权威表优先）。
//   用户函数返回结构体（2026-09-04，E2E 148）：被调为普通标识符（造点(10,20).x
//   链式字段访问）——经 函数返回类型们 查返回类型，结构体即返回其名ID。
函数 解析调用返回结构体(向量<节点> 池, 整32 调用索引) -> 整64 {
    节点 调用节点 = 池.元素(调用索引);
    如果 (调用节点.类型 != 节点_调用 || 调用节点.子起点 <= 0) { 返回 0; }
    节点 被调成员 = 池.元素(整32(调用节点.子起点));
    如果 (被调成员.类型 == 节点_标识符) {
        结果<整64, 整32> 查返回f = 函数返回类型们.获取(整64(被调成员.文本));
        如果 (查返回f.正常) {
            如果 (查结构体大小(查返回f.值) != 0) {
                返回 查返回f.值;
            }
        }
        返回 0;
    }
    如果 (被调成员.类型 != 节点_成员 || 被调成员.附加 != 成员方法标记) { 返回 0; }
    整64 对象类型ID = 解析节点类型ID(池, 整32(被调成员.子起点));
    如果 (对象类型ID == 0) { 返回 0; }
    字符串 类名 = 驻留文本(对象类型ID);
    如果 (!是容器类(类名)) { 返回 0; }
    方法签名 签;
    如果 (!查方法签名(类名, 驻留文本(整64(被调成员.文本)), 调用节点.附加, &签)) { 返回 0; }
    如果 (字符串长度(签.返回文本) == 0) { 返回 0; }
    返回 驻留(签.返回文本);
}

// 取成员节点访问的宽度类型码（标识符对象/调用对象 两形态；默认 T_整64——
//   未登记防御与旧行为一致）
函数 取成员宽度码(向量<节点> 池, 整32 成员索引) -> 整64 {
    节点 m = 池.元素(成员索引);
    如果 (m.类型 != 节点_成员) { 返回 T_整64; }
    节点 对象节点 = 池.元素(整32(m.子起点));
    如果 (对象节点.类型 == 节点_标识符) {
        整64 结构体ID = 解析对象结构体ID(对象节点);
        如果 (结构体ID != 0) { 返回 查字段宽度码(结构体ID, 整64(m.文本)); }
        返回 T_整64;
    }
    如果 (对象节点.类型 == 节点_调用) {
        整64 返回结构体ID = 解析调用返回结构体(池, 整32(m.子起点));
        如果 (返回结构体ID != 0 && 查结构体大小(返回结构体ID) != 0) {
            返回 查字段宽度码(返回结构体ID, 整64(m.文本));
        }
    }
    返回 T_整64;
}

// ③ 第三波：下标左值元素宽度码（p[i] = v 存储宽度）——指针对象经 指针变量
//   类型们 查所指类型 -> 类型宽度码；非指针对象默认 T_整64（语义层已拒，防御）
函数 取下标元素宽度码(向量<节点> 池, 整32 下标索引) -> 整64 {
    节点 s = 池.元素(下标索引);
    如果 (s.类型 == 节点_下标 && s.子起点 > 0) {
        节点 对象节点下 = 池.元素(整32(s.子起点));
        如果 (对象节点下.类型 == 节点_标识符) {
            结果<整64, 整32> 查所指宽 = 指针变量类型们.获取(整64(对象节点下.文本));
            如果 (查所指宽.正常) {
                返回 类型宽度码(驻留文本(查所指宽.值));
            }
        }
    }
    返回 T_整64;
}

// ==================== 函数级变量类型权威表（②c D，2026-09-02） ====================
// 解析期 变量容器表/变量结构体表 为全局按名键——跨函数同名异型（追加表 的参数 t
// 与 主 的局部 桶 t）串类型。本表由 生成函数 按当前函数填充（参数/容器/结果/
// 结构体局部），标识符类型解析先查此表（函数级真相），解析期表退为静态/兜底。
// 簇①根治·A2（2026-09-04）：表本体下沉 IR常量.cn（IR容器 成员推导双向引用，
//   原定义在本文件=不可导循环）；清空/填充/读取仍全在本组件。

// ③ 第一波（2026-09-03，缺陷①②当场根治后升级）：本函数「寄存器号 -> IR 类型码」
// 登记表——登记点：字面量（整数/字符串）/标识符加载（函数级权威表类型）/拼接 + 产物/
// 内置函数返回。消费点：打印 参数分派（print_str/float/bool/int）、拼接 双侧字符串性
// 判定与 隐式转换（from_int/from_float/from_bool）。生成函数 串行——无交叉，入口清空。
// 边界：无符号（正*）在 v2 类型码体系归并 T_整64（类型系统级现状，非本表层）。
静态 映射<整64, 整64> 寄存器类型们;

// ③ 第三波（2026-09-03）：指针变量类型表——名ID -> 所指元素类型名ID（参数/局部
//   类型节点 附加=指针层数 1..255 登记；语义层同款约定）。消费点：下标读分支
//   （步进=元素宽度/LoadPtr 宽度码/结果类型登记）、下标左值地址与赋值存储宽度。
//   生成函数 串行——入口清空（与 语义分析.指针变量表 平行，IR 层独立消费）。
静态 映射<整64, 整64> 指针变量类型们;

// 登记寄存器类型（重复登记=后写覆盖——同一寄存器号本函数内不复用）
函数 登记寄存器类型(整64 寄存器, 整64 码) -> 空类型 {
    结果<空类型, 整32> 设型 = 寄存器类型们.设置(寄存器, 码);
    如果 (!设型.正常) { 运行时错误(4); }
}

// 查询寄存器类型码；0=未登记（未知——按整数兜底处理）
函数 查寄存器类型(整64 寄存器) -> 整64 {
    结果<整64, 整32> 查型 = 寄存器类型们.获取(寄存器);
    如果 (查型.正常) { 返回 查型.值; }
    返回 0;
}

// 数值/布尔 -> 字符串 转换符号（拼接隐式转换用；宿主 ir_call 对齐。
//   未登记/整数一律 from_int；浮32 场景 v2 浮点面未开（③ 后续），先归 float）
函数 转换符号(整64 码) -> 字符串 {
    如果 (码 == T_浮32 || 码 == T_浮64) { 返回 "__cn_str_from_float"; }
    如果 (码 == T_布尔) { 返回 "__cn_str_from_bool"; }
    返回 "__cn_str_from_int";
}

// 标识符类型解析（函数级权威 -> 解析期容器表 -> 解析期结构体表）；
//   返回类型名ID（容器合成名/结构体名/结果名）；0=未知
函数 解析标识符类型ID(整64 名ID) -> 整64 {
    结果<整64, 整32> 查本函数 = 当前函数变量类型.获取(名ID);
    如果 (查本函数.正常) { 返回 查本函数.值; }
    整64 容器ID = 查容器类型(名ID);
    如果 (容器ID != 0) { 返回 容器ID; }
    返回 查结构体类型(名ID);
}

// ==================== 方法调用对象类型统一解析（②c A/B，2026-09-02） ====================
// 后缀链任意节点的类型推导（递归）：标识符（容器变量/结构体变量）、成员
//（基类型为结构体 -> 字段类型）、调用（返回容器/返回结构体）。返回类型名ID；0=未知。
函数 解析节点类型ID(向量<节点> 池, 整32 节点索引) -> 整64 {
    节点 n = 池.元素(节点索引);
    如果 (n.类型 == 节点_标识符) {
        返回 解析标识符类型ID(整64(n.文本));
    }
    如果 (n.类型 == 节点_成员) {
        // 对象.字段：基类型为结构体 -> 分桶字段类型（b.表 -> 向量$整64）
        整64 基类型ID = 解析节点类型ID(池, n.子起点);
        如果 (基类型ID != 0 && 查结构体大小(基类型ID) != 0) {
            返回 查字段类型ID(基类型ID * 键位移 + 整64(n.文本));
        }
        返回 0;
    }
    如果 (n.类型 == 节点_调用) {
        整64 容器返回ID = 解析调用返回容器(池, 节点索引);
        如果 (容器返回ID != 0) { 返回 容器返回ID; }
        返回 解析调用返回结构体(池, 节点索引);
    }
    返回 0;
}

// 方法调用对象类型解析（表.追加 / b.表.追加 / 元素(0).设置 / 词池.元素(0).表.大小）：
//   经 解析节点类型ID 推导对象类型——容器直用；结构体则查方法名对应字段的容器类型。
// 返回容器合成类名ID；0=未知。
函数 解析方法对象类型(向量<节点> 池, 整32 调用索引) -> 整64 {
    节点 调用节点 = 池.元素(调用索引);
    如果 (调用节点.类型 != 节点_调用 || 调用节点.子起点 <= 0) { 返回 0; }
    节点 被调成员 = 池.元素(整32(调用节点.子起点));
    如果 (被调成员.类型 != 节点_成员) { 返回 0; }
    整64 对象类型ID = 解析节点类型ID(池, 整32(被调成员.子起点));
    如果 (对象类型ID != 0) {
        如果 (是容器类(驻留文本(对象类型ID))) { 返回 对象类型ID; }
        如果 (查结构体大小(对象类型ID) != 0) {
            整64 字段类型ID = 查字段类型ID(对象类型ID * 键位移 + 整64(被调成员.文本));
            如果 (字段类型ID != 0 && 是容器类(驻留文本(字段类型ID))) { 返回 字段类型ID; }
        }
    }
    返回 0;
}

// 调用节点的被调方法返回容器类型（②c A：元素(i) 返回映射 等）；0=非容器返回。
//   递归经 解析方法对象类型 解析该调用自身的方法对象。
函数 解析调用返回容器(向量<节点> 池, 整32 调用索引) -> 整64 {
    节点 调用节点 = 池.元素(调用索引);
    如果 (调用节点.类型 != 节点_调用 || 调用节点.子起点 <= 0) { 返回 0; }
    节点 被调成员 = 池.元素(整32(调用节点.子起点));
    如果 (被调成员.类型 != 节点_成员 || 被调成员.附加 != 成员方法标记) { 返回 0; }
    整64 对象类ID = 解析方法对象类型(池, 调用索引);
    如果 (对象类ID == 0) { 返回 0; }
    字符串 类名 = 驻留文本(对象类ID);
    如果 (!是容器类(类名)) { 返回 0; }
    方法签名 签;
    如果 (!查方法签名(类名, 驻留文本(整64(被调成员.文本)), 调用节点.附加, &签)) { 返回 0; }
    如果 (字符串长度(签.返回文本) == 0) { 返回 0; }
    如果 (!是容器类(签.返回文本)) { 返回 0; }
    返回 驻留(签.返回文本);
}

// ==================== 函数实参结构表与实参回扫（②b B3/B8，2026-09-02） ====================
// 普通函数调用的结构体按值实参 -> 传地址（B3 仅覆盖容器方法调用；v2 自身源码
//   IR追加(指令, 建IR指令(...)) 全是此形态，③ 自举必需）。表：函数名ID*键位移+
//   实参序 -> 1（该实参为结构体）。IR生成/IR生成多文件 入口收集（先于全部生成）。
静态 映射<整64, 整64> 函数实参结构们;

// 收集一个 程序 节点区间的全部函数声明的结构体实参位（键 = 函数名ID*键位移+实参序）
函数 收集函数实参结构(向量<节点> 池, 整32 程序节点) -> 空类型 {
    节点 程序 = 池.元素(程序节点);
    整64 位置 = 整64(程序.子起点);
    当 (位置 < 整64(程序.子终点)) {
        节点 声明 = 池.元素(整32(位置));
        如果 (声明.类型 == 节点_函数) {
            // 参数区间 = [函数.子起点, 块.子起点)（块 在 函数.子终点=块索引）
            整64 参数终点 = 整64(声明.子起点);
            如果 (声明.子终点 < 池.大小()) {
                节点 块节点 = 池.元素(声明.子终点);
                参数终点 = 整64(块节点.子起点);
            }
            整64 参数序 = 0;
            整64 参数位置 = 整64(声明.子起点);
            当 (参数位置 < 参数终点) {
                节点 参数 = 池.元素(整32(参数位置));
                如果 (参数.类型 == 节点_参数) {
                    // 守卫用 >= 0（lessons 池索引 0 合法——生成函数 同款）：首函数
                    //   首参数的类型节点恰在池索引 0 时，原 > 0 漏登记——mapref 探针
                    //   实锤（灌 的 映射& 表 引用实参位漏收集→调用方不取址→被调方
                    //   双重解引用读垃圾→映射对象状态坏崩溃）
                    如果 (参数.附加 >= 0 && 参数.附加 < 池.大小()) {
                        节点 参数类型节点 = 池.元素(整32(参数.附加));
                        如果 (查结构体大小(整64(参数类型节点.文本)) != 0) {
                            结果<空类型, 整32> 设结 = 函数实参结构们.设置(
                                整64(声明.文本) * 键位移 + 参数序, 1);
                            如果 (!设结.正常) { 运行时错误(4); }
                        }
                        // ②c D：引用形参（类型节点 附加=引用*256）——调用方传左值地址
                        如果 (参数类型节点.附加 >= 256) {
                            结果<空类型, 整32> 设引 = 函数实参引用们.设置(
                                整64(声明.文本) * 键位移 + 参数序, 1);
                            如果 (!设引.正常) { 运行时错误(4); }
                        }
                    }
                    参数序++;
                }
                参数位置++;
            }
        }
        位置++;
    }
}

// ==================== 用户函数返回类型表（③ 第二波，方案A 登记点补全 2026-09-03） ====================
// ③ 第一波登记点枚举漏「用户函数调用返回」——打印错分派 print_int（打指针值）、
//   拼接漏判/误转 from_int（指针转数字串）静默错误代码（asm 探针实锤；v2 组件
//   代码生成共用.cn:30/104 字节十六进制=符号修饰核心实际在用）。表：函数名ID ->
//   返回类型名ID（节点_函数.附加）。IR生成/IR生成多文件 入口收集（先于全部生成）。
静态 映射<整64, 整64> 函数返回类型们;

// 收集一个 程序 节点区间的全部函数声明的返回类型
函数 收集函数返回类型(向量<节点> 池, 整32 程序节点) -> 空类型 {
    节点 程序 = 池.元素(程序节点);
    整64 位置 = 整64(程序.子起点);
    当 (位置 < 整64(程序.子终点)) {
        节点 声明 = 池.元素(整32(位置));
        如果 (声明.类型 == 节点_函数) {
            结果<空类型, 整32> 设返 = 函数返回类型们.设置(整64(声明.文本),
                                                         整64(声明.附加));
            如果 (!设返.正常) { 运行时错误(4); }
        }
        位置++;
    }
}

// 回扫实参取地址（②b B3/B8 共用）：裸标识符实参的 IR_加载 回扫取源槽改发
//   IR_取地址（宿主 ABI：调用方传指针）；找不到（表达式实参）打印诊断（P7c）
函数 回扫实参取地址(向量<IR指令>& 指令, 向量<整64>& 弹出们, 整64 实i,
                    整64* 寄存器计数) -> 空类型 {
    整64 实reg = 弹出们.元素(弹出们.大小() - 1 - 实i);
    整64 源槽 = 0;
    整64 回 = 指令.大小();
    当 (回 > 0) {
        IR指令 回扫 = 指令.元素(回 - 1);
        如果 (回扫.操作码 == IR_加载 && 回扫.目标 == 实reg) {
            源槽 = 回扫.操作数1;
            中断;
        }
        回--;
    }
    如果 (源槽 != 0) {
        整64 地址reg = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        // 引用局部（2026-09-04 IR生成.cn 冒烟根治）：实参=槽内容（绑定对象
        //   左值地址）——与标识符取槽地址的值语义形态分流
        如果 (槽是引用(源槽)) {
            IR追加(指令, 建IR指令(IR_加载, 源槽, 0, 0, 地址reg, T_整64, 0));
        } 否则 {
            IR追加(指令, 建IR指令(IR_取地址, 源槽, 0, 0, 地址reg, T_整64, 0));
        }
        结果<空类型, 整32> 改实 = 弹出们.设置(弹出们.大小() - 1 - 实i, 地址reg);
        如果 (!改实.正常) { 运行时错误(4); }
        返回;
    }
    // 指针加载形态（引用局部读/成员字段加载，2026-09-04）：发射引用参数读
    //   （IR_加载 槽→L + IR_指针加载 L→对象指针）与容器字段取载
    //   （IR_字段地址 + IR_指针加载）的目标实参，其 IR_指针加载.操作数1
    //   寄存器即「绑定对象/字段的左值地址」——直接复用（零新指令）。
    //   被 127 既有标识符形态不经过此路径（IR_加载.目标==实reg 先命中）。
    整64 回2 = 指令.大小();
    当 (回2 > 0) {
        IR指令 回扫2 = 指令.元素(回2 - 1);
        如果 (回扫2.操作码 == IR_指针加载 && 回扫2.目标 == 实reg) {
            结果<空类型, 整32> 改实2 = 弹出们.设置(弹出们.大小() - 1 - 实i, 回扫2.操作数1);
            如果 (!改实2.正常) { 运行时错误(4); }
            返回;
        }
        回2--;
    }
    // 字段地址形态（2026-09-06 结果载荷结构体根治）：实 reg 来源=IR_字段地址
    //   （查.值 结构体载荷——实参=字段地址本身），直接复用（实reg 已是左值地址）
    整64 回2f = 指令.大小();
    当 (回2f > 0) {
        IR指令 回扫2f = 指令.元素(回2f - 1);
        如果 (回扫2f.操作码 == IR_字段地址 && 回扫2f.目标 == 实reg) {
            返回;
        }
        回2f--;
    }
    // 调用返回形态（2026-09-04，E2E 148）：实 reg 来源=IR_调用参数化——返回
    //   结构体时 rax=retbuf 地址即结构体地址，按值实参恰好要传地址——实参
    //   数值本已正确，直接复用（原「结构体实参须为标识符」诊断对此形态为
    //   误报：v2 自身 IR追加(指令, 建IR指令(...)) 655 条实证）。
    整64 回3 = 指令.大小();
    当 (回3 > 0) {
        IR指令 回扫3 = 指令.元素(回3 - 1);
        如果 (回扫3.操作码 == IR_调用参数化 && 回扫3.目标 == 实reg) {
            返回;   // 实参保持 实reg（结构体地址）
        }
        回3--;
    }
    // 取地址形态（2026-09-04，E2E 148 收尾）：实 reg 来源=IR_取地址（&标识符
    //   实参传引用位——查方法签名(..., &签) 26 处实证）——取地址值即左值地址，
    //   引用位恰好要传左值地址，实参数值本已正确，直接复用（误报根治）。
    整64 回4 = 指令.大小();
    当 (回4 > 0) {
        IR指令 回扫4 = 指令.元素(回4 - 1);
        如果 (回扫4.操作码 == IR_取地址 && 回扫4.目标 == 实reg) {
            返回;
        }
        回4--;
    }
    IR层诊断("结构体实参须为标识符（表达式实参见P7c）");
}

// ==================== 引用参数（②c D，2026-09-02） ====================
// byRef 槽语义（对齐宿主 A-1）：参数槽存调用方左值地址——读取解引用/赋值写回；
//   容器& 双层解引用得对象指针（this 直用）；结构体& 槽内容即结构体基址
//   （成员访问直接复用，跳过 prologue 多槽拷贝）。调用方经 函数实参引用们
//   表驱动回扫取址（B8 同款机制扩展）。
静态 映射<整64, 整64> 函数实参引用们;    // 函数名ID*键位移+实参序 -> 1（该实参为 & 引用）
静态 映射<整64, 整64> 引用参数槽们;      // 槽号 -> 1（本函数该参数为 & 引用形参）
静态 映射<整64, 整64> 引用参数类型们;    // 槽号 -> 类型名ID（读取分流：容器/结构体/标量）

// 槽是否为引用参数
函数 槽是引用(整64 槽) -> 布尔 {
    结果<整64, 整32> 查 = 引用参数槽们.获取(槽);
    返回 查.正常;
}

// 簇③根治·自减全链 C1（2026-09-04 用户裁决）：自增/自减共用发射函数——目标解析链
//   （局部槽→参数槽→静态序号）+ 引用参数经指针读写回（②c D）+ 静态读写对
//   （③ 第六波），运算码按 是自减 分派 IR_加/IR_减。原 节点_自增 分支体平移
//   抽出（行为零变化），节点_自减 对称接入
函数 发射自增自减(向量<IR指令>& 指令, 整64 名ID, 布尔 是自减,
                   映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                   整64* 寄存器计数) -> 空类型 {
    整64 运算码 = IR_加;
    如果 (是自减) { 运算码 = IR_减; }
    整64 目标槽 = 0;
    结果<整64, 整32> 找槽 = 局部槽.获取(名ID);
    如果 (找槽.正常) { 目标槽 = 找槽.值; }
    如果 (目标槽 == 0) {
        结果<整64, 整32> 找参 = 参数槽.获取(名ID);
        如果 (找参.正常) { 目标槽 = 找参.值; }
    }
    如果 (目标槽 == 0) {
        // 静态槽自增/自减：IR_静态加载/静态存储 读写对（②c C 设施）
        结果<整64, 整32> 找静 = 静态序号们.获取(名ID);
        如果 (找静.正常) {
            整64 静值reg = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_静态加载, 0, 0, 0, 静值reg, T_整64, 找静.值));
            整64 静常量1 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("1")), 0, 0, 静常量1, T_整64, 0));
            整64 静结果 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(运算码, 静值reg, 静常量1, 0, 静结果, T_整64, 0));
            IR追加(指令, 建IR指令(IR_静态存储, 静结果, 0, 0, 0, T_整64, 找静.值));
        }
    }
    如果 (目标槽 != 0) {
        整64 寄存器1 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        如果 (槽是引用(目标槽)) {
            // 引用参数：经指针读写回调用方槽
            整64 地址reg2 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 地址reg2, T_整64, 0));
            IR追加(指令, 建IR指令(IR_指针加载, 地址reg2, 0, 0, 寄存器1, T_整64, 0));
            整64 常量1r = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("1")), 0, 0, 常量1r, T_整64, 0));
            整64 结果寄存器r = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(运算码, 寄存器1, 常量1r, 0, 结果寄存器r, T_整64, 0));
            IR追加(指令, 建IR指令(IR_指针存储, 地址reg2, 结果寄存器r, 0, 0, T_整64, 0));
        } 否则 {
            IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 寄存器1, T_整64, 0));
            整64 常量1 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("1")), 0, 0, 常量1, T_整64, 0));
            整64 结果寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(运算码, 寄存器1, 常量1, 0, 结果寄存器, T_整64, 0));
            IR追加(指令, 建IR指令(IR_存储, 结果寄存器, 0, 0, 0, 0, 目标槽));
        }
    }
}

// 引用参数标识符读取发射（压值）：
//   容器&：Load 槽（=&调用方槽）-> 指针加载（=对象指针，方法接收者 this 直用）；
//   结构体&：Load 槽（=调用方结构体基址——成员基址直接复用，不再解引用）；
//   标量&：Load 槽 -> 指针加载（=值）。
函数 发射引用参数读(整64 槽, 向量<IR指令>& 指令, 整64* 寄存器计数,
                     向量<整64>& 表达式栈) -> 空类型 {
    整64 类型ID = 0;
    结果<整64, 整32> 查类型 = 引用参数类型们.获取(槽);
    如果 (查类型.正常) { 类型ID = 查类型.值; }
    整64 地址寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_加载, 槽, 0, 0, 地址寄存器, T_整64, 0));
    字符串 类型文本 = 驻留文本(类型ID);
    如果 (是容器类(类型文本)) {
        整64 对象寄存器 = 寄存器计数[0];
        寄存器计数[0] = 寄存器计数[0] + 1;
        IR追加(指令, 建IR指令(IR_指针加载, 地址寄存器, 0, 0, 对象寄存器, T_对象, 0));
        结果<空类型, 整32> 加容 = 表达式栈.追加(对象寄存器);
        如果 (!加容.正常) { 运行时错误(4); }
        返回;
    }
    如果 (查结构体大小(类型ID) != 0) {
        结果<空类型, 整32> 加结 = 表达式栈.追加(地址寄存器);
        如果 (!加结.正常) { 运行时错误(4); }
        返回;
    }
    整64 值寄存器 = 寄存器计数[0];
    寄存器计数[0] = 寄存器计数[0] + 1;
    IR追加(指令, 建IR指令(IR_指针加载, 地址寄存器, 0, 0, 值寄存器, T_整64, 0));
    结果<空类型, 整32> 加标 = 表达式栈.追加(值寄存器);
    如果 (!加标.正常) { 运行时错误(4); }
}

// 清空引用参数模块表（IR生成/IR生成多文件 入口——任务级生命周期）
函数 清空引用参数表() -> 空类型 {
    函数实参引用们.清空();
    引用参数槽们.清空();
    引用参数类型们.清空();
}

// ==================== 表达式后缀求值 ====================
// 遍历 池[起点, 终点) 内表达式节点（后缀栈），生成指令到 目标 指令数组。
// 返回表达式结果寄存器 ID（0=无）。
// 栈：表达式寄存器栈（向量<整64>）。
// 栈值编码：正数=寄存器；负数 -(名ID)=函数符号；-(1000000+名ID)=成员方法标记（P7b）。
//   方法标记下压着对象值（this=容器槽 Load 值=堆对象指针）。
// 缺陷B根治（2026-09-02）：新增 块计数/槽计数 指针——短路求值（规范 930）需
//   在表达式内建块（条件跳转/标签）与临时槽（两分支值汇合）。mangled 核算：
//   两 整64* 标量参数 +8 字符（约 213 < 247，MASM 符号限制安全）。
函数 生成表达式(向量<节点> 池, 整32 起点, 整32 终点,
                 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                 向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数,
                 向量<整64>& 表达式栈) -> 整64 {
    // P7b：结果返回 retbuf 共享序号（帧尾 16 字节区）——发射顺序=使用顺序，
    //   每次调用后立即消费（接收 CopyStruct / 丢弃），单 retbuf 复用安全
    常量 retbuf序号 = 1;
    // P6c：预扫描 节点_取地址 子区间（&对象 的子节点不单独生成，避免重复指令）。
    //   ③ 第三波根治（130 用例 q[-1] 负下标踩出）：负号/逻辑非/解引用 的操作数
    //   区间同入跳过——前缀一元操作数若由主遍历先压栈、前缀节点再嵌套生成，
    //   栈必多一份残留（下标弹2取到残留当地址 -> 解引用垃圾地址 0xC0000005）
    向量<整64> 取址区间们 = 向量<整64>();
    整32 预扫 = 起点;
    当 (预扫 < 终点) {
        节点 预节点 = 池.元素(预扫);
        如果 (预节点.类型 == 节点_取地址 || 预节点.类型 == 节点_负号 ||
             预节点.类型 == 节点_逻辑非 || 预节点.类型 == 节点_解引用) {
            如果 (预节点.子起点 < 预节点.子终点) {
                结果<空类型, 整32> 加区 = 取址区间们.追加(整64(预节点.子起点));
                如果 (!加区.正常) { 运行时错误(4); }
                结果<空类型, 整32> 加区2 = 取址区间们.追加(整64(预节点.子终点));
                如果 (!加区2.正常) { 运行时错误(4); }
            }
        }
        预扫++;
    }
    // 缺陷B：预扫描 短路运算符（&&/||）操作数区间（语法层标注：附加=右起点，
    //   [子起点, 子终点)=操作数后缀区间）——主遍历跳过，运算符节点处延迟求值。
    向量<整64> 逻辑区间们 = 向量<整64>();
    整32 预扫2 = 起点;
    当 (预扫2 < 终点) {
        节点 预节点2 = 池.元素(预扫2);
        如果 (预节点2.类型 == 节点_二元运算 && 预节点2.子终点 != 0) {
            字符串 预op名 = 驻留文本(整64(预节点2.文本));
            如果 (字符串比较(预op名, "&&") || 字符串比较(预op名, "||")) {
                结果<空类型, 整32> 加逻 = 逻辑区间们.追加(整64(预节点2.子起点));
                如果 (!加逻.正常) { 运行时错误(4); }
                结果<空类型, 整32> 加逻2 = 逻辑区间们.追加(预节点2.附加);
                如果 (!加逻2.正常) { 运行时错误(4); }
                结果<空类型, 整32> 加逻3 = 逻辑区间们.追加(整64(预节点2.子终点));
                如果 (!加逻3.正常) { 运行时错误(4); }
            }
        }
        预扫2++;
    }
    // ③ 第六波（2026-09-03）：预扫描 三元运算 三段区间（[子起点, 子终点) 全跳
    //   ——条件/真值/假值延迟到三元节点处惰性生成：仅选中分支求值，规范 01b 5.8）
    向量<整64> 三元区间们 = 向量<整64>();
    整32 预扫3 = 起点;
    当 (预扫3 < 终点) {
        节点 预节点3 = 池.元素(预扫3);
        如果 (预节点3.类型 == 节点_三元运算) {
            结果<空类型, 整32> 加三 = 三元区间们.追加(整64(预节点3.子起点));
            如果 (!加三.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加三2 = 三元区间们.追加(整64(预节点3.子终点));
            如果 (!加三2.正常) { 运行时错误(4); }
        }
        预扫3++;
    }
    整32 位置 = 起点;
    当 (位置 < 终点) {
        // 跳过 取地址 子区间
        布尔 在取址区间 = 假;
        整64 取i = 0;
        当 (取i < 取址区间们.大小()) {
            整64 区起 = 取址区间们.元素(取i);
            整64 区终 = 取址区间们.元素(取i + 1);
            如果 (整64(位置) >= 区起 && 整64(位置) < 区终) {
                在取址区间 = 真;
                位置 = 整32(区终);
                中断;
            }
            取i += 2;
        }
        如果 (在取址区间) { 继续; }
        // 跳过 短路运算符 操作数区间（左/右操作数延迟到运算符节点处求值）
        布尔 在逻辑区间 = 假;
        整64 逻i = 0;
        当 (逻i < 逻辑区间们.大小()) {
            整64 逻起 = 逻辑区间们.元素(逻i);
            整64 逻终 = 逻辑区间们.元素(逻i + 2);
            如果 (整64(位置) >= 逻起 && 整64(位置) < 逻终) {
                在逻辑区间 = 真;
                位置 = 整32(逻终);
                中断;
            }
            逻i += 3;
        }
        如果 (在逻辑区间) { 继续; }
        // ③ 第六波：跳过 三元 三段区间（条件/真值/假值延迟到三元节点处生成）
        布尔 在三元区间 = 假;
        整64 三i = 0;
        当 (三i < 三元区间们.大小()) {
            整64 三起 = 三元区间们.元素(三i);
            整64 三终 = 三元区间们.元素(三i + 1);
            如果 (整64(位置) >= 三起 && 整64(位置) < 三终) {
                在三元区间 = 真;
                位置 = 整32(三终);
                中断;
            }
            三i += 2;
        }
        如果 (在三元区间) { 继续; }
        节点 n = 池.元素(位置);
        如果 (n.类型 == 节点_整数字面量) {
            // 常量整数：操作数1=Symbol ID（文本），类型=整64
            整64 寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_常量整数, 整64(n.文本), 0, 0, 寄存器, T_整64, 0));
            登记寄存器类型(寄存器, T_整64);
            结果<空类型, 整32> 加 = 表达式栈.追加(寄存器);
            如果 (!加.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_布尔字面量) {
            // 灰色点①根治（2026-09-04）：真/假 独立节点——常量 1/0 登记 T_布尔
            //   （打印分派 __cn_print_bool 输出 真/假、拼接 from_bool 自动分派，
            //   对齐宿主；与比较运算产物 T_布尔 同款消费路径）
            整64 布尔寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_常量整数, 整64(n.文本), 0, 0, 布尔寄存器, T_布尔, 0));
            登记寄存器类型(布尔寄存器, T_布尔);
            结果<空类型, 整32> 加布 = 表达式栈.追加(布尔寄存器);
            如果 (!加布.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_字符串字面量) {
            // P7b 字符串字面量：IR_常量字符串（操作数1=驻留文本ID）——代码生成
            //   发射 .code 段内 strData_<ID> 数据标签地址（容器追加("甲") 等场景）
            整64 字符串寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_常量字符串, 整64(n.文本), 0, 0, 字符串寄存器, T_字符串, 0));
            登记寄存器类型(字符串寄存器, T_字符串);
            结果<空类型, 整32> 加串 = 表达式栈.追加(字符串寄存器);
            如果 (!加串.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_标识符) {
            // 标识符：参数槽 优先，其次 局部槽；Load 槽 -> 寄存器
            整64 槽 = 0;
            结果<整64, 整32> 找参 = 参数槽.获取(整64(n.文本));
            如果 (找参.正常) { 槽 = 找参.值; }
            如果 (槽 == 0) {
                结果<整64, 整32> 找局 = 局部槽.获取(整64(n.文本));
                如果 (找局.正常) { 槽 = 找局.值; }
            }
            如果 (槽 == 0) {
                // P7a：顶层常量——命中则内联 IR_常量整数（操作数1=值文本ID，
                //   代码生成经 驻留文本 还原立即数）。参数/局部未命中才查，
                //   局部变量遮蔽同名常量语义正确。
                结果<整64, 整32> 找常 = 常量表.获取(整64(n.文本));
                如果 (找常.正常) {
                    整64 常寄存器 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_常量整数, 找常.值, 0, 0, 常寄存器, T_整64, 0));
                    结果<空类型, 整32> 加常 = 表达式栈.追加(常寄存器);
                    如果 (!加常.正常) { 运行时错误(4); }
                    位置++;
                    继续;
                }
                // ②c C：顶层静态——命中序号则 IR_静态加载（.data _cn_gstatic_N 槽：
                //   容器=堆对象指针；标量=初始值）。常量/局部/参数之后、函数名兜底之前。
                结果<整64, 整32> 找静 = 静态序号们.获取(整64(n.文本));
                如果 (找静.正常) {
                    整64 静寄存器 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_静态加载, 0, 0, 0, 静寄存器, T_整64, 找静.值));
                    结果<空类型, 整32> 加静 = 表达式栈.追加(静寄存器);
                    如果 (!加静.正常) { 运行时错误(4); }
                    位置++;
                    继续;
                }
                // 函数名（调用 被调对象）：压 负数符号 到 表达式栈（0-符号ID），
                //   非变量（参数/局部 查无）——语义层已检查未声明
                结果<空类型, 整32> 加函 = 表达式栈.追加(0 - 整64(n.文本));
                如果 (!加函.正常) { 运行时错误(4); }
                位置++;
                继续;
            }
            整64 寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            // ②c D：引用参数——按类型分流发射（容器& 双重解引用/结构体& 基址/标量& 解引用）
            如果 (槽是引用(槽)) {
                发射引用参数读(槽, 指令, 寄存器计数, 表达式栈);
                位置++;
                继续;
            }
            IR追加(指令, 建IR指令(IR_加载, 槽, 0, 0, 寄存器, T_整64, 0));
            // ③ 缺陷①根治：变量/参数类型登记（打印分派/拼接转换——字符串/浮点/布尔
            //   全覆盖；经 函数级权威表+类型码，未登记=未知按整数兜底）
            整64 标识类型码 = 类型码(解析标识符类型ID(整64(n.文本)));
            如果 (标识类型码 != T_未知) {
                登记寄存器类型(寄存器, 标识类型码);
            }
            结果<空类型, 整32> 加 = 表达式栈.追加(寄存器);
            如果 (!加.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_二元运算) {
            字符串 op名 = 驻留文本(整64(n.文本));
            // CN 字符串 == 是指针比较（非内容）——须用 字符串比较
            // ---- 缺陷B根治（2026-09-02）：短路求值（规范 930）----
            // && ：a 假 -> 结果=a(0)；a 真 -> 求值 b，结果=b。
            // || ：a 真 -> 结果=a；a 假 -> 求值 b，结果=b。
            // 汇合后经 逻辑非×2 规范化为 0/1（对标 C 语义值）。
            // 右操作数（含副作用/除法/解引用）仅在需要时求值——短路本质。
            // 临时槽汇合两分支的值（IR 无寄存器间传送；槽经 槽计数 分配不冲突）。
            如果 (字符串比较(op名, "&&") || 字符串比较(op名, "||")) {
                整64 左寄存器 = 生成表达式(池, n.子起点, 整32(n.附加), 局部槽, 参数槽,
                                          指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
                整64 临时槽 = 槽计数[0];
                槽计数[0] = 槽计数[0] + 1;
                IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 临时槽));   // 帧登记（扫描函数 据此计帧）
                IR追加(指令, 建IR指令(IR_存储, 左寄存器, 0, 0, 0, 0, 临时槽));
                整64 汇合块 = 块计数[0] + 1;
                块计数[0] = 块计数[0] + 2;
                整64 求值块 = 汇合块 + 1;
                如果 (字符串比较(op名, "&&")) {
                    // && ：a 真 -> 求值 b（假短路，保留 a=0）
                    IR追加(指令, 建IR指令(IR_条件跳转, 左寄存器, 求值块, 汇合块, 0, 0, 0));
                } 否则 {
                    // || ：a 假 -> 求值 b（真短路，保留 a）
                    IR追加(指令, 建IR指令(IR_条件跳转, 左寄存器, 汇合块, 求值块, 0, 0, 0));
                }
                IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 求值块));
                整64 右寄存器 = 生成表达式(池, 整32(n.附加), n.子终点, 局部槽, 参数槽,
                                          指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
                IR追加(指令, 建IR指令(IR_存储, 右寄存器, 0, 0, 0, 0, 临时槽));
                IR追加(指令, 建IR指令(IR_跳转, 0, 0, 0, 0, 0, 汇合块));
                IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 汇合块));
                整64 载入寄存器 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_加载, 临时槽, 0, 0, 载入寄存器, T_整64, 0));
                整64 非寄存器 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_逻辑非, 载入寄存器, 0, 0, 非寄存器, T_整64, 0));
                整64 逻辑结果 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_逻辑非, 非寄存器, 0, 0, 逻辑结果, T_整64, 0));
                登记寄存器类型(逻辑结果, T_布尔);
                结果<空类型, 整32> 加逻 = 表达式栈.追加(逻辑结果);
                如果 (!加逻.正常) { 运行时错误(4); }
                位置++;
                继续;
            }
            // ③ 第一波（2026-09-03，缺陷②根治）：字符串拼接 +（宿主 Task 2.5/2.9 对齐：
            //   __cn_str_concat 左结合、产物为字符串；字符串+数值 双向隐式转换——
            //   数值侧先 __cn_str_from_int/float/bool 再 concat）。判定：左右任一为
            //   字符串（寄存器类型登记表——字面量/标识符加载/拼接产物/内置返回；
            //   右侧补末端节点推导兜底）。
            布尔 拼接加 = 假;
            整64 拼接左码 = 0;
            整64 拼接右码 = 0;
            如果 (字符串比较(op名, "+") && 表达式栈.大小() >= 2) {
                整64 栈右 = 表达式栈.元素(表达式栈.大小() - 1);
                整64 栈左 = 表达式栈.元素(表达式栈.大小() - 2);
                拼接左码 = 查寄存器类型(栈左);
                拼接右码 = 查寄存器类型(栈右);
                如果 (拼接左码 == 0) {
                    // ③ 第二波（方案A）：左侧末端节点推导兜底（与右侧对称）——左末端
                    //   = 附加-1（语法层已标注 附加=右操作数起点，左区间=[子起点,附加)）
                    节点 左末端 = 池.元素(整32(n.附加) - 1);
                    整64 左类型ID = 0;
                    如果 (左末端.类型 == 节点_字符串字面量) {
                        左类型ID = 驻留("字符串");
                    } 否则 {
                        左类型ID = 解析节点类型ID(池, 整32(n.附加) - 1);
                        如果 (左类型ID == 0 && 左末端.类型 == 节点_调用 && 左末端.子起点 > 0) {
                            节点 左被调 = 池.元素(整32(左末端.子起点));
                            如果 (左被调.类型 == 节点_标识符) {
                                左类型ID = 内置函数返回类型ID(驻留文本(整64(左被调.文本)));
                                如果 (左类型ID == 0) {
                                    结果<整64, 整32> 查左返 = 函数返回类型们.获取(整64(左被调.文本));
                                    如果 (查左返.正常) { 左类型ID = 查左返.值; }
                                }
                            }
                        }
                    }
                    拼接左码 = 类型码(左类型ID);
                }
                如果 (拼接右码 == 0) {
                    // 右侧未登记（成员/调用对象等）——末端节点推导兜底
                    节点 右末端 = 池.元素(位置 - 1);
                    整64 右类型ID = 0;
                    如果 (右末端.类型 == 节点_字符串字面量) {
                        右类型ID = 驻留("字符串");
                    } 否则 {
                        右类型ID = 解析节点类型ID(池, 位置 - 1);
                        如果 (右类型ID == 0 && 右末端.类型 == 节点_调用 && 右末端.子起点 > 0) {
                            节点 右被调 = 池.元素(整32(右末端.子起点));
                            如果 (右被调.类型 == 节点_标识符) {
                                右类型ID = 内置函数返回类型ID(驻留文本(整64(右被调.文本)));
                                如果 (右类型ID == 0) {
                                    结果<整64, 整32> 查右返 = 函数返回类型们.获取(整64(右被调.文本));
                                    如果 (查右返.正常) { 右类型ID = 查右返.值; }
                                }
                            }
                        }
                    }
                    拼接右码 = 类型码(右类型ID);
                }
                如果 (拼接左码 == T_字符串 || 拼接右码 == T_字符串) {
                    拼接加 = 真;
                }
            }
            // 弹 2 个操作数，生成运算指令
            整64 右 = 0;
            整64 左 = 0;
            如果 (表达式栈.大小() >= 2) {
                右 = 表达式栈.元素(表达式栈.大小() - 1);
                结果<空类型, 整32> 删右 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删右.正常) { 运行时错误(4); }
                左 = 表达式栈.元素(表达式栈.大小() - 1);
                结果<空类型, 整32> 删左 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删左.正常) { 运行时错误(4); }
            }
            如果 (拼接加) {
                // 数值侧隐式转换（宿主 Task 2.9）：from_int/from_float/from_bool；
                //   未登记类型按整数兜底（v2 组件与常规用面）。转换后双侧均字符串。
                如果 (拼接左码 != T_字符串) {
                    整64 左转 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_调用实参, 左, 0, 0, 0, 0, 0));
                    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 左转, 0,
                                         驻留(转换符号(拼接左码))));
                    登记寄存器类型(左转, T_字符串);
                    左 = 左转;
                }
                如果 (拼接右码 != T_字符串) {
                    整64 右转 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_调用实参, 右, 0, 0, 0, 0, 0));
                    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 右转, 0,
                                         驻留(转换符号(拼接右码))));
                    登记寄存器类型(右转, T_字符串);
                    右 = 右转;
                }
                // __cn_str_concat(左, 右)：裸 ASCII 符号直调（宿主 ABI 权威），
                //   实参位 0/1，产物登记 T_字符串（链式外层判定用）
                整64 拼接寄存器 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_调用实参, 左, 0, 0, 0, 0, 0));
                IR追加(指令, 建IR指令(IR_调用实参, 右, 0, 0, 0, 1, 0));
                IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 拼接寄存器, 0,
                                     驻留("__cn_str_concat")));
                登记寄存器类型(拼接寄存器, T_字符串);
                结果<空类型, 整32> 加拼栈 = 表达式栈.追加(拼接寄存器);
                如果 (!加拼栈.正常) { 运行时错误(4); }
                位置++;
                继续;
            }
            整64 op = 0;
            如果 (字符串比较(op名, "+")) { op = IR_加; }
            否则 如果 (字符串比较(op名, "-")) { op = IR_减; }
            否则 如果 (字符串比较(op名, "*")) { op = IR_乘; }
            否则 如果 (字符串比较(op名, "/")) { op = IR_除; }
            否则 如果 (字符串比较(op名, "%")) { op = IR_取余; }
            否则 如果 (字符串比较(op名, "==")) { op = IR_相等; }
            否则 如果 (字符串比较(op名, "!=")) { op = IR_不等; }
            否则 如果 (字符串比较(op名, "<")) { op = IR_小于; }
            否则 如果 (字符串比较(op名, ">")) { op = IR_大于; }
            否则 如果 (字符串比较(op名, "<=")) { op = IR_小于等于; }
            否则 如果 (字符串比较(op名, ">=")) { op = IR_大于等于; }
            // && / || 已在上方短路分支处理（原 IR_相等 防御语义错误，已删）
            整64 寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(op, 左, 右, 0, 寄存器, T_整64, 0));
            // ③：比较运算产物登记 T_布尔（打印 真/假 与拼接 from_bool 分派用；
            //   算术产物不登记——按整数兜底）
            如果 (op == IR_相等 || op == IR_不等 || op == IR_小于 || op == IR_大于 ||
                 op == IR_小于等于 || op == IR_大于等于) {
                登记寄存器类型(寄存器, T_布尔);
            }
            结果<空类型, 整32> 加 = 表达式栈.追加(寄存器);
            如果 (!加.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_三元运算) {
            // ③ 第六波（2026-09-03）：三元条件（规范 01b 5.8）——惰性求值：条件
            //   跳转分派，仅选中分支求值。复用 125 短路方案：临时槽（IR_分配 帧
            //   登记）汇合两分支值，三块（真/假/汇合）。栈平衡：各段递归后弹到
            //   进入前深度再压汇合结果（一元模式——净 +1，中间残留全清，防
            //   「下标弹2取到残留」同族缺陷）。汇合类型=真分支寄存器登记类型
            //   （语义层已保证两分支可合并；未登记兜底 T_整64——标识符加载同款）
            整64 三元前深度 = 表达式栈.大小();
            整64 条件寄存器 = 生成表达式(池, n.子起点, n.文本, 局部槽, 参数槽,
                                        指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
            当 (表达式栈.大小() > 三元前深度) {
                结果<空类型, 整32> 删条 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删条.正常) { 运行时错误(4); }
            }
            整64 临时槽 = 槽计数[0];
            槽计数[0] = 槽计数[0] + 1;
            IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 临时槽));
            整64 真块 = 块计数[0] + 1;
            整64 假块 = 块计数[0] + 2;
            整64 汇合块 = 块计数[0] + 3;
            块计数[0] = 块计数[0] + 3;
            IR追加(指令, 建IR指令(IR_条件跳转, 条件寄存器, 真块, 假块, 0, 0, 0));
            IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 真块));
            整64 真寄存器 = 生成表达式(池, n.文本, 整32(n.附加), 局部槽, 参数槽,
                                      指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
            当 (表达式栈.大小() > 三元前深度) {
                结果<空类型, 整32> 删真 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删真.正常) { 运行时错误(4); }
            }
            IR追加(指令, 建IR指令(IR_存储, 真寄存器, 0, 0, 0, 0, 临时槽));
            IR追加(指令, 建IR指令(IR_跳转, 0, 0, 0, 0, 0, 汇合块));
            IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 假块));
            整64 假寄存器 = 生成表达式(池, 整32(n.附加), n.子终点, 局部槽, 参数槽,
                                      指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
            当 (表达式栈.大小() > 三元前深度) {
                结果<空类型, 整32> 删假 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删假.正常) { 运行时错误(4); }
            }
            IR追加(指令, 建IR指令(IR_存储, 假寄存器, 0, 0, 0, 0, 临时槽));
            IR追加(指令, 建IR指令(IR_跳转, 0, 0, 0, 0, 0, 汇合块));
            IR追加(指令, 建IR指令(IR_标签, 0, 0, 0, 0, 0, 汇合块));
            整64 汇合类型 = 查寄存器类型(真寄存器);
            如果 (汇合类型 == 0) { 汇合类型 = T_整64; }
            整64 载入寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加载, 临时槽, 0, 0, 载入寄存器, 汇合类型, 0));
            登记寄存器类型(载入寄存器, 汇合类型);
            结果<空类型, 整32> 加汇 = 表达式栈.追加(载入寄存器);
            如果 (!加汇.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_逻辑非) {
            // 一元逻辑非：生成操作数（子区间）-> IR_逻辑非。
            //   ③ 第三波根治：同 负号 分支——弹到进入前深度（操作数线性遍历残留）
            整64 逻辑非前深度 = 表达式栈.大小();
            整64 操作数寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                         指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
            当 (表达式栈.大小() > 逻辑非前深度) {
                结果<空类型, 整32> 删逻 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删逻.正常) { 运行时错误(4); }
            }
            整64 寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_逻辑非, 操作数寄存器, 0, 0, 寄存器, T_整64, 0));
            登记寄存器类型(寄存器, T_布尔);
            结果<空类型, 整32> 加 = 表达式栈.追加(寄存器);
            如果 (!加.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_负号) {
            // 一元负：生成操作数（子区间）-> IR_负。
            //   ③ 第三波根治（130 用例 q[-1] 负下标踩出）：操作数节点已被线性
            //   遍历压栈（残留），嵌套生成再压一份——须弹到进入前深度再压结果，
            //   否则栈多一份残留（下标弹2取到残留当地址 -> 解引用垃圾地址崩）
            整64 负号前深度 = 表达式栈.大小();
            整64 操作数寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                         指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
            当 (表达式栈.大小() > 负号前深度) {
                结果<空类型, 整32> 删负 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删负.正常) { 运行时错误(4); }
            }
            整64 寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_负, 操作数寄存器, 0, 0, 寄存器, T_整64, 0));
            结果<空类型, 整32> 加 = 表达式栈.追加(寄存器);
            如果 (!加.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_取地址) {
            // & 左值：子区间节点已被线性遍历/预扫跳过（位置值/成员值 残留栈），
            //   生成地址后 弹出残留再压地址（P6c）。
            //   ③ 第三波根治（130 用例 f(&x) 调用实参形态踩出）：只弹到进入前
            //   深度——原「清空全栈」会把先序压栈的调用被调负符号/二元左操作数
            //   一并弹掉（被调变 0 -> [ir2] 调用被调对象非函数名）
            整64 取址前深度 = 表达式栈.大小();
            整64 地址寄存器 = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                         指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
            当 (表达式栈.大小() > 取址前深度) {
                结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删栈.正常) { 运行时错误(4); }
            }
            结果<空类型, 整32> 加 = 表达式栈.追加(地址寄存器);
            如果 (!加.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_解引用) {
            // * 指针：生成操作数（地址寄存器）-> IR_指针加载。
            //   ③ 第三波根治：同 负号 分支——弹到进入前深度（操作数线性遍历残留）
            整64 解引用前深度2 = 表达式栈.大小();
            整64 地址寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                         指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
            当 (表达式栈.大小() > 解引用前深度2) {
                结果<空类型, 整32> 删解 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删解.正常) { 运行时错误(4); }
            }
            整64 寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 地址寄存器, 0, 0, 寄存器, T_整64, 0));
            结果<空类型, 整32> 加 = 表达式栈.追加(寄存器);
            如果 (!加.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_成员) {
            // 对象.字段 / 对象->字段：弹对象地址/基址 -> IR_字段地址（偏移在附加）-> 压地址
            // 对象若是标识符：取槽地址；若是解引用/成员：栈顶即地址
        如果 (n.附加 == 成员方法标记) {
            // P7b 方法调用接收者（表.追加(x) 的 表.追加 部分）：弹对象值
            //   （容器变量 Load 值=堆对象指针即 this），压 [this, 方法标记]
            // ②c B：对象为结构体的容器字段（b.表.追加）——接收者=字段槽首 8 字节的
            //   堆对象指针：标识符对象取槽地址/调用对象用结果基址（retbuf/视图地址），
            //   经 字段地址+指针加载 取载（指针槽模型）
            节点 对象节点m = 池.元素(整32(n.子起点));
            整64 字段取载偏移 = -1;
            整64 字段取载基址 = 0;
            如果 (对象节点m.类型 == 节点_标识符) {
                整64 结构体IDm = 解析对象结构体ID(对象节点m);
                如果 (结构体IDm != 0) {
                    整64 桶偏移m = 查字段偏移(结构体IDm * 键位移 + 整64(n.文本));
                    如果 (桶偏移m >= 0) {
                        字段取载偏移 = 桶偏移m;
                        // 标识符对象：取结构体基槽地址（调用方/局部 多槽基址=最大槽号）
                        整64 对象槽m = 0;
                        结果<整64, 整32> 找局m = 局部槽.获取(整64(对象节点m.文本));
                        如果 (找局m.正常) { 对象槽m = 找局m.值; }
                        如果 (对象槽m == 0) {
                            结果<整64, 整32> 找参m = 参数槽.获取(整64(对象节点m.文本));
                            如果 (找参m.正常) { 对象槽m = 找参m.值; }
                        }
                        如果 (对象槽m != 0) {
                            整64 基址reg = 寄存器计数[0];
                            寄存器计数[0] = 寄存器计数[0] + 1;
                            // ②c D：结构体& 引用参数——槽内容即基址（Load 槽），非槽地址
                            如果 (槽是引用(对象槽m)) {
                                IR追加(指令, 建IR指令(IR_加载, 对象槽m, 0, 0, 基址reg, T_整64, 0));
                            } 否则 {
                                IR追加(指令, 建IR指令(IR_取地址, 对象槽m, 0, 0, 基址reg, T_整64, 0));
                            }
                            字段取载基址 = 基址reg;
                        }
                    }
                }
            } 否则 如果 (对象节点m.类型 == 节点_调用) {
                // 调用对象：返回结构体的容器字段（词池.元素(0).表.追加）——
                //   弹出的调用结果寄存器（retbuf/视图地址）即基址
                整64 返回结构体IDm = 解析调用返回结构体(池, 整32(n.子起点));
                如果 (返回结构体IDm != 0 && 查结构体大小(返回结构体IDm) != 0) {
                    整64 桶偏移m2 = 查字段偏移(返回结构体IDm * 键位移 + 整64(n.文本));
                    如果 (桶偏移m2 >= 0) {
                        字段取载偏移 = 桶偏移m2;
                        字段取载基址 = -1;   // 栈顶（弹出的对象值）即基址
                    }
                }
            }
            整64 对象值 = 0;
            如果 (表达式栈.大小() >= 1) {
                对象值 = 表达式栈.元素(表达式栈.大小() - 1);
                结果<空类型, 整32> 删对 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删对.正常) { 运行时错误(4); }
            }
            如果 (字段取载偏移 >= 0 && (字段取载基址 > 0 || 字段取载基址 == -1)) {
                // 字段首 8 字节的堆对象指针 -> this
                整64 基址值 = 对象值;
                如果 (字段取载基址 > 0) { 基址值 = 字段取载基址; }
                整64 字段地址reg = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_字段地址, 基址值, 0, 0, 字段地址reg, T_整64, 字段取载偏移));
                整64 对象指针reg = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_指针加载, 字段地址reg, 0, 0, 对象指针reg, T_对象, 0));
                对象值 = 对象指针reg;
            }
            结果<空类型, 整32> 加对 = 表达式栈.追加(对象值);
            如果 (!加对.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加标 = 表达式栈.追加(0 - (1000000 + 整64(n.文本)));
            如果 (!加标.正常) { 运行时错误(4); }
            位置++;
            继续;
        }
            整64 基址寄存器 = 0;
            节点 对象节点 = 池.元素(n.子起点);  // 子起点=对象节点索引（P6c 解析时记录）
            // P7b：对象是 结果/可选 变量 -> 字段偏移按合成布局（正常@0 布尔宽度；
            //   值/错误@联合偏移 4/8——IR容器.结果值偏移）。对象类型取语法层
            //   预标注（节点.子终点=对象类型ID，语法分析 解析后缀链 登记）
            整64 字段偏移量 = n.附加;
            整64 加载类型 = T_整64;
            整64 成员对象类型ID = 0;
            整64 成员值码 = T_未知;
            如果 (对象节点.类型 == 节点_标识符) {
                成员对象类型ID = 解析标识符类型ID(整64(对象节点.文本));
                // ②b B5：标识符对象为结构体局部/参数 -> 分桶查字段宽度（读写同源根治）
                整64 结构体ID = 解析对象结构体ID(对象节点);
                如果 (结构体ID != 0) {
                    加载类型 = 查字段宽度码(结构体ID, 整64(n.文本));
                    // ③ 第二波（方案A）：字段声明类型码（成员加载值登记用）
                    成员值码 = 类型码(查字段类型ID(结构体ID * 键位移 + 整64(n.文本)));
                }
            } 否则 如果 (对象节点.类型 == 节点_调用) {
                // ②b B5：调用对象（池.元素(i).字段）——方法返回结构体：分桶收口
                //   偏移+宽度（语法层只能扁平回退查偏移——同名字段跨结构体必错）
                整64 返回结构体ID = 解析调用返回结构体(池, 整32(n.子起点));
                如果 (返回结构体ID != 0 && 查结构体大小(返回结构体ID) != 0) {
                    整64 桶偏移 = 查字段偏移(返回结构体ID * 键位移 + 整64(n.文本));
                    如果 (桶偏移 >= 0) { 字段偏移量 = 桶偏移; }
                    加载类型 = 查字段宽度码(返回结构体ID, 整64(n.文本));
                    成员值码 = 类型码(查字段类型ID(返回结构体ID * 键位移 + 整64(n.文本)));
                }
            }
            如果 (字段偏移量 < 0 && 成员对象类型ID != 0) {
                字符串 对象类型文本 = 驻留文本(成员对象类型ID);
                如果 (是结果类型(对象类型文本)) {
                    字符串 成员名文本 = 驻留文本(整64(n.文本));
                    如果 (字符串比较(成员名文本, "正常") || 字符串比较(成员名文本, "有值") ||
                         字符串比较(成员名文本, "是否某些")) {
                        字段偏移量 = 0;
                        加载类型 = T_布尔;
                        成员值码 = T_布尔;
                    } 否则 {
                        字段偏移量 = 结果值偏移(段首(合成名首实参(对象类型文本)));
                        // .值/.错误 载荷类型 = 结果 首实参首段（合成名首实参 返回首 $
                        //   后全部如 "字符串$整32"——须再经 段首 剥离；字符串载荷
                        //   -> T_字符串，打印/拼接消费正确分派。实测踩坑：漏 段首
                        //   则 类型码("字符串$整32")=T_未知 不登记 -> print_int 指针值）
                        成员值码 = 类型码(驻留(段首(合成名首实参(对象类型文本))));
                    }
                }
            }
            // 无论对象形态，先弹掉表达式栈顶（标识符=Load 值丢弃；解引用/成员=地址复用）
            如果 (表达式栈.大小() >= 1) {
                基址寄存器 = 表达式栈.元素(表达式栈.大小() - 1);
                结果<空类型, 整32> 删 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删.正常) { 运行时错误(4); }
            }
            如果 (对象节点.类型 == 节点_标识符) {
                // 标识符对象：栈顶是 Load 值，需重新取槽地址（结构体存于槽）。
                //   ②c D：结构体& 引用参数——槽内容即调用方结构体基址（标识符读取
                //   已按引用参数发射基址），栈顶即基址，不再取槽地址
                整64 对象槽 = 0;
                结果<整64, 整32> 找局 = 局部槽.获取(整64(对象节点.文本));
                如果 (找局.正常) { 对象槽 = 找局.值; }
                如果 (对象槽 == 0) {
                    结果<整64, 整32> 找参 = 参数槽.获取(整64(对象节点.文本));
                    如果 (找参.正常) { 对象槽 = 找参.值; }
                }
                如果 (对象槽 != 0 && 槽是引用(对象槽)) {
                    // 引用参数：弹栈时 基址寄存器 已持有槽内容（=调用方结构体基址）
                } 否则 {
                    整64 地址寄存器2 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_取地址, 对象槽, 0, 0, 地址寄存器2, T_整64, 0));
                    基址寄存器 = 地址寄存器2;
                }
            }
            整64 寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_字段地址, 基址寄存器, 0, 0, 寄存器, T_整64, 字段偏移量));
            // 成员访问作为右值：字段地址 -> 立即取值（压值；赋值左值走专用路径）。
            //   2026-09-06 根治（v2self 表查找类型ID 崩溃）：对象为 结果/可选 且
            //   成员为 值/错误 且载荷=结构体（查.值——符号 32B）——压**字段地址**
            //   不 LoadPtr（原无条件取 8 字节=载荷首字段值当地址，结构体拷贝源=
            //   小整数（47=名ID）-> SIGSEGV；注释 2134 声明的语义至此真正实现）
            布尔 载荷是结构体 = 假;
            如果 (对象节点.类型 == 节点_标识符 && 成员对象类型ID != 0) {
                字符串 对象类型文本2 = 驻留文本(成员对象类型ID);
                如果 (是结果类型(对象类型文本2)) {
                    字符串 成员名文本2 = 驻留文本(整64(n.文本));
                    布尔 是载荷成员 = 真;
                    如果 (字符串比较(成员名文本2, "正常")) { 是载荷成员 = 假; }
                    如果 (字符串比较(成员名文本2, "有值")) { 是载荷成员 = 假; }
                    如果 (字符串比较(成员名文本2, "是否某些")) { 是载荷成员 = 假; }
                    如果 (是载荷成员) {
                        字符串 载荷类型 = 段首(合成名首实参(对象类型文本2));
                        如果 (查结构体大小(驻留(载荷类型)) != 0) {
                            载荷是结构体 = 真;
                        }
                    }
                }
            }
            如果 (载荷是结构体) {
                结果<空类型, 整32> 加m = 表达式栈.追加(寄存器);
                如果 (!加m.正常) { 运行时错误(4); }
                位置++;
                继续;
            }
            整64 值寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 寄存器, 0, 0, 值寄存器, 加载类型, 0));
            // ③ 第二波（方案A）：成员加载值类型登记——字段声明类型/结果载荷类型
            //   （打印分派/拼接判定消费；缺陷①同族根治：字符串字段未登记 ->
            //   print_int 打指针值，asm 探针实锤）
            如果 (成员值码 != T_未知) {
                登记寄存器类型(值寄存器, 成员值码);
            }
            结果<空类型, 整32> 加 = 表达式栈.追加(值寄存器);
            如果 (!加.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_调用) {
            // ---- ③ 第一波：类型大小(类型名) 编译期折叠（规格 02-六B，宿主 A-3
            //      SizeofExpr 同义）——不走运行时调用。实参=单标识符（类型名），
            //      其压栈残留（函数名兜底负符号）弹掉后压常量。
            如果 (n.子起点 > 0 && n.附加 == 1) {
                节点 折叠被调 = 池.元素(整32(n.子起点));
                节点 折叠实参 = 池.元素(整32(n.子起点) + 1);
                如果 (折叠被调.类型 == 节点_标识符 && 折叠实参.类型 == 节点_标识符 &&
                     字符串比较(驻留文本(整64(折叠被调.文本)), "类型大小")) {
                    整64 宽度 = 类型名宽度(整64(折叠实参.文本));
                    如果 (宽度 == 0) {
                        IR层诊断("类型大小: 未知类型 " +
                                      驻留文本(整64(折叠实参.文本)));
                        返回 0;   // IR 层错误即中止纪律：诊断计数后继续收集，主.cn 统一中止
                    }
                    整64 折叠i = 0;
                    // 弹 2 个压栈残留：实参（类型名负符号）+ 被调（类型大小 负符号）
                    //   ——根治栈底残留（原只弹 1 个，靠相对栈顶侥幸无害）
                    当 (折叠i < 2 && 表达式栈.大小() > 0) {
                        结果<空类型, 整32> 删折 = 表达式栈.删除(表达式栈.大小() - 1);
                        如果 (!删折.正常) { 运行时错误(4); }
                        折叠i++;
                    }
                    整64 常量寄存器 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    // IR_常量整数 操作数1=值文本驻留ID（P7a 语义：代码生成经
                    //   驻留文本 还原立即数）——宽度须先转文本再驻留
                    IR追加(指令, 建IR指令(IR_常量整数, 驻留(整数转字符串(宽度)), 0, 0,
                                         常量寄存器, T_整64, 0));
                    结果<空类型, 整32> 加折 = 表达式栈.追加(常量寄存器);
                    如果 (!加折.正常) { 运行时错误(4); }
                    位置++;
                    继续;
                }
            }
            // 函数/方法调用（2026-09-01 用户裁决项3 参数区改造）：弹实参（倒序）入
            //   弹出们，逐个发射 IR_调用实参(64)（位号声明性标注），IR_调用参数化(63)
            //   收尾——任意实参数（7 组件源码 8 参函数）；普通调用与方法调用统一路径。
            整64 实参数 = n.附加;
            向量<整64> 弹出们 = 向量<整64>();
            整64 弹i = 0;
            当 (弹i < 实参数 && 表达式栈.大小() > 0) {
                结果<空类型, 整32> 加弹 = 弹出们.追加(表达式栈.元素(表达式栈.大小() - 1));
                如果 (!加弹.正常) { 运行时错误(4); }
                结果<空类型, 整32> 删弹 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删弹.正常) { 运行时错误(4); }
                弹i++;
            }
            整64 被调 = 0;
            如果 (表达式栈.大小() > 0) {
                被调 = 表达式栈.元素(表达式栈.大小() - 1);
                结果<空类型, 整32> 删被调 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删被调.正常) { 运行时错误(4); }
            }
            // ---- 方法调用：被调是方法标记（-(10^6+方法名ID)），标记下压着 this ----
            如果 (被调 <= -1000000) {
                整64 方法名ID = 0 - 被调 - 1000000;
                整64 this寄存器 = 0;
                如果 (表达式栈.大小() >= 1) {
                    this寄存器 = 表达式栈.元素(表达式栈.大小() - 1);
                    结果<空类型, 整32> 删this = 表达式栈.删除(表达式栈.大小() - 1);
                    如果 (!删this.正常) { 运行时错误(4); }
                }
                字符串 方法名文本 = 驻留文本(方法名ID);
                字符串 类名 = "";
                // ②c A/B：对象类型统一解析（标识符：容器变量/结构体容器字段；
                //   调用：返回容器/返回结构体的容器字段——元素(0).设置/b.表.追加）
                整64 对象类ID2 = 解析方法对象类型(池, 位置);
                如果 (对象类ID2 != 0) {
                    类名 = 驻留文本(对象类ID2);
                }
                如果 (是容器类(类名)) {
                    方法签名 签;
                    如果 (查方法签名(类名, 方法名文本, 实参数, &签)) {
                        // ②b B6：retbuf 按真实返回字节数定帧——累计本函数最大值
                        整64 retbuf字节 = 签名返回字节数(&签);
                        如果 (retbuf字节 > 当前retbuf字节数) { 当前retbuf字节数 = retbuf字节; }
                        整64 符号ID = 驻留(方法符号(类名, 方法名文本, 签.参数串));
                        整64 retbuf = 0;
                        整64 目标寄存器 = 0;
                        整64 实参起始位 = 1;
                        如果 (签.返回形态 == 容器返回_结果空 || 签.返回形态 == 容器返回_结果值 ||
                             签.返回形态 == 容器返回_结构体) {
                            retbuf = retbuf序号;
                            实参起始位 = 2;   // 位0=retbuf、位1=this、实参从位2
                            目标寄存器 = 寄存器计数[0];
                            寄存器计数[0] = 寄存器计数[0] + 1;
                        } 否则 如果 (签.返回形态 == 容器返回_标量) {
                            目标寄存器 = 寄存器计数[0];
                            寄存器计数[0] = 寄存器计数[0] + 1;
                        }
                        IR追加(指令, 建IR指令(IR_调用实参, this寄存器, 0, 0, 0, 实参起始位 - 1, 0));
                        // ②b B3（2026-09-02）：结构体按值实参 -> 传地址（宿主 ABI：
                        //   调用方传指针、被调方拷贝入参/元素存储）。裸标识符实参的
                        //   值装载（IR_加载）回扫取槽改发 IR_取地址（B8 抽出共用辅助）。
                        整64 实i = 0;
                        当 (实i < 弹出们.大小()) {
                            字符串 段文本 = 取参数段(签.参数串, 实i);
                            如果 (查结构体大小(驻留(段文本)) != 0) {
                                回扫实参取地址(指令, 弹出们, 实i, 寄存器计数);
                            }
                            实i++;
                        }
                        发射调用实参们(弹出们, 实参起始位, 指令);
                        IR追加(指令, 建IR指令(IR_调用参数化, 实参起始位 + 实参数, 0, 0,
                                             目标寄存器, retbuf, 符号ID));
                        如果 (目标寄存器 != 0) {
                            // ③ 第二波（方案A）：容器方法标量返回类型登记——签.返回文本
                            //   =替换后返回类型（向量<字符串>.元素(i) -> "字符串"）；
                            //   结果/结构体返回=retbuf 地址不做标量登记（.值/.字段 路径自理）
                            如果 (签.返回形态 == 容器返回_标量) {
                                整64 方法返回码 = 类型码(驻留(签.返回文本));
                                如果 (方法返回码 != T_未知) {
                                    登记寄存器类型(目标寄存器, 方法返回码);
                                }
                            }
                            结果<空类型, 整32> 加法 = 表达式栈.追加(目标寄存器);
                            如果 (!加法.正常) { 运行时错误(4); }
                        }
                        位置++;
                        继续;
                    }
                    IR层诊断("容器方法未收录: " + 类名 + "." + 方法名文本);
                    运行时错误(6);
                }
                IR层诊断("方法调用的对象类型未知: " + 方法名文本);
                运行时错误(6);
            }
            如果 (被调 >= 0) {
                // 非函数名/方法标记（弹到寄存器值）——非法调用形态
                IR层诊断("调用被调对象非函数名/方法");
                运行时错误(6);
            }
            整64 函数符号 = 0 - 被调;
            // ---- ③ 第一波：打印/打印行（复合内置，宿主 ir_call 对齐语义）——逐参按
            //      类型独立调用 __cn_print_str（字符串寄存器集合判定）/__cn_print_int，
            //      打印 尾随 __cn_print_newline（打印行 不加）；void 不压栈。
            //      注意 函数符号 恒为正（标识符兜底压栈 0-ID，此处再取反还原）；
            //      限定名内置（IO::/文件::）经语法层合成限定标识符走本路径。
            字符串 打印名 = 驻留文本(函数符号);
            布尔 是打印换行 = 字符串比较(打印名, "打印");
            如果 (是打印换行 || 字符串比较(打印名, "打印行")) {
                // 弹出们 为倒序弹（栈顶=右参先弹）——正序打印：从尾向头遍历
                整64 打i = 弹出们.大小();
                当 (打i > 0) {
                    整64 打参 = 弹出们.元素(打i - 1);
                    // ③ 缺陷①根治：类型登记表分派（字符串变量/字面量 str、浮点 float、
                    //   布尔 bool（输出 真/假）、未登记/整数 int）
                    整64 打参码 = 查寄存器类型(打参);
                    字符串 打印符号 = "__cn_print_int";
                    如果 (打参码 == T_字符串) {
                        打印符号 = "__cn_print_str";
                    } 否则 如果 (打参码 == T_浮32 || 打参码 == T_浮64) {
                        打印符号 = "__cn_print_float";
                    } 否则 如果 (打参码 == T_布尔) {
                        打印符号 = "__cn_print_bool";
                    }
                    IR追加(指令, 建IR指令(IR_调用实参, 打参, 0, 0, 0, 0, 0));
                    IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0, 驻留(打印符号)));
                    打i--;
                }
                如果 (是打印换行) {
                    IR追加(指令, 建IR指令(IR_调用参数化, 0, 0, 0, 0, 0,
                                         驻留("__cn_print_newline")));
                }
                位置++;
                继续;
            }
            // ---- ③ 第一波：内置函数（驻留/字符串族/运行时错误）——裸 ASCII 运行时
            //      符号直调（宿主 ABI 权威：v2p_linux.s 实查 bl __cn_intern）；
            //      代码生成 __cn_ 前缀直通不修饰。返回标量/指针单槽。
            //      ③ 第五波：限定名内置（IO::/文件::）同表命中——语法层 :: 已合成
            //      限定标识符，此处与纯名内置统一走本路径。
            字符串 内置符号名 = 内置函数符号(打印名);
            如果 (字符串长度(内置符号名) != 0) {
                整64 返回寄存器 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                发射调用实参们(弹出们, 0, 指令);
                IR追加(指令, 建IR指令(IR_调用参数化, 实参数, 0, 0, 返回寄存器, 0,
                                     驻留(内置符号名)));
                // 返回类型登记（字符串/布尔/整64——打印分派与拼接判定消费；
                //   空类型跳过=void 无值语义，对齐用户函数 T_空类型 同款）
                整64 内置返回码 = 类型码(内置函数返回类型ID(打印名));
                如果 (内置返回码 != T_未知 && 内置返回码 != T_空类型) {
                    登记寄存器类型(返回寄存器, 内置返回码);
                }
                结果<空类型, 整32> 加内 = 表达式栈.追加(返回寄存器);
                如果 (!加内.正常) { 运行时错误(4); }
                位置++;
                继续;
            }
            // ---- 类型转换 类型(expr)（被调符号是类型名且单实参）——不走调用 ----
            整64 目标类型 = 类型码(函数符号);
            // 灰色点④根治（2026-09-04）：窄宽强转目标码特判——类型码() 将
            //   整8/整16 归 T_整64（v2 槽模型 8 字节、正8 无符号语义缺位），
            //   但强转须按目标宽度截断（win mov al/movsx、ARM64 sxtb/sxth），
            //   此处改码为窄宽标注；其余类型走 类型码() 原路径零变化
            字符串 强转名 = 驻留文本(函数符号);
            如果 (字符串比较(强转名, "整8")) {
                目标类型 = T_整8;
            } 否则 如果 (字符串比较(强转名, "整16")) {
                目标类型 = T_整16;
            } 否则 如果 (字符串比较(强转名, "正8")) {
                // 2026-09-04 缺陷零容忍收口：无符号窄宽（零扩展 movzx/uxtb——
                //   正8(200)=200；与 整8 符号扩展对称）
                目标类型 = T_正8;
            } 否则 如果 (字符串比较(强转名, "正16")) {
                目标类型 = T_正16;
            }
            如果 (目标类型 != T_未知 && 实参数 == 1) {
                整64 转换寄存器 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_类型转换, 弹出们.元素(0), 0, 0, 转换寄存器, 目标类型, 函数符号));
                结果<空类型, 整32> 加转 = 表达式栈.追加(转换寄存器);
                如果 (!加转.正常) { 运行时错误(4); }
                位置++;
                继续;
            }
            // ---- 构造调用：被调符号是容器类合成名（向量$整64）且无实参 ----
            字符串 被调名 = 驻留文本(函数符号);
            如果 (是容器类(被调名) && 实参数 == 0) {
                整64 obj寄存器 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, obj寄存器,
                                     容器对象大小(被调名), 函数符号));
                IR追加(指令, 建IR指令(IR_调用实参, obj寄存器, 0, 0, 0, 0, 0));
                IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                     驻留(构造符号(被调名))));
                结果<空类型, 整32> 加构 = 表达式栈.追加(obj寄存器);
                如果 (!加构.正常) { 运行时错误(4); }
                位置++;
                继续;
            }
            // ---- 普通函数调用：实参从位 0 起，全部经 64+63（任意参数数） ----
            // ②b B8：结构体按值实参 -> 传地址（函数实参结构们 表驱动——与 B3 容器
            //   方法路径同款回扫；v2 自身 IR追加(指令, 建IR指令(...)) ③ 自举必需）
            // ②c D：& 引用实参 -> 传左值地址（函数实参引用们 表驱动同款回扫）
            整64 实i2 = 0;
            当 (实i2 < 弹出们.大小()) {
                结果<整64, 整32> 查结构实参 = 函数实参结构们.获取(函数符号 * 键位移 + 实i2);
                如果 (查结构实参.正常) {
                    回扫实参取地址(指令, 弹出们, 实i2, 寄存器计数);
                } 否则 {
                    结果<整64, 整32> 查引用实参 = 函数实参引用们.获取(函数符号 * 键位移 + 实i2);
                    如果 (查引用实参.正常) {
                        回扫实参取地址(指令, 弹出们, 实i2, 寄存器计数);
                    }
                }
                实i2++;
            }
            整64 返回寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            // 用户函数返回结构体（2026-09-04，E2E 148）：帧尾共享 retbuf（容器
            //   方法同款 B6 设施）+ 位 0 装载 + 实参起始位 1；rax=结构体地址
            //   （初始化拷贝/链式成员基址/按值实参直用）。retbuf 帧尺寸累计。
            整64 retbuf序号v = 0;
            整64 实参起始位v = 0;
            结果<整64, 整32> 查返回s = 函数返回类型们.获取(函数符号);
            如果 (查返回s.正常) {
                整64 返回结构大小 = 查结构体大小(查返回s.值);
                如果 (返回结构大小 != 0) {
                    如果 (返回结构大小 > 当前retbuf字节数) { 当前retbuf字节数 = 返回结构大小; }
                    retbuf序号v = retbuf序号;
                    实参起始位v = 1;
                }
            }
            发射调用实参们(弹出们, 实参起始位v, 指令);
            IR追加(指令, 建IR指令(IR_调用参数化, 实参起始位v + 实参数, 0, 0,
                                 返回寄存器, retbuf序号v, 函数符号));
            // 引用返回（2026-09-04 缺陷零容忍收口，宿主 P3-18 对齐）：返回寄存器
            //   =被引用左值地址——默认按右值读解引用（IR_指针加载 值）；赋值目标/
            //   复合赋值/引用初始化场景经 生成左值地址 调用分支回扫取地址
            布尔 是引用返回v = 假;
            字符串 返回名v = "";
            如果 (查返回s.正常) {
                返回名v = 驻留文本(查返回s.值);
                如果 (字符串长度(返回名v) > 0 &&
                     字符串比较(字符串子串(返回名v, 字符串长度(返回名v) - 1, 1), "&")) {
                    是引用返回v = 真;
                }
            }
            如果 (是引用返回v) {
                整64 引用值reg = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_指针加载, 返回寄存器, 0, 0, 引用值reg, T_整64, 0));
                // 值类型登记：剥尾 & 后的类型码（打印分派/拼接消费）
                字符串 基类型名 = 字符串子串(返回名v, 0, 字符串长度(返回名v) - 1);
                整64 引用返回码 = 类型码(驻留(基类型名));
                如果 (引用返回码 != T_未知 && 引用返回码 != T_空类型) {
                    登记寄存器类型(引用值reg, 引用返回码);
                }
                结果<空类型, 整32> 加引 = 表达式栈.追加(引用值reg);
                如果 (!加引.正常) { 运行时错误(4); }
                位置++;
                继续;
            }
            // ③ 第二波（方案A）：用户函数返回值类型登记（打印分派/拼接判定消费；
            //   缺陷②同族根治：字符串返回未登记 -> from_int(指针) 静默错误代码，
            //   asm 探针实锤——代码生成共用.cn:30/104 拼接实际在用）
            结果<整64, 整32> 查返回 = 函数返回类型们.获取(函数符号);
            如果 (查返回.正常) {
                整64 返回码 = 类型码(查返回.值);
                如果 (返回码 != T_未知 && 返回码 != T_空类型) {
                    登记寄存器类型(返回寄存器, 返回码);
                }
            }
            结果<空类型, 整32> 加普 = 表达式栈.追加(返回寄存器);
            如果 (!加普.正常) { 运行时错误(4); }
        } 否则 如果 (n.类型 == 节点_下标) {
            // ③ 第二波：字符串[i] 逐字节 O(1) 访问（宿主 A-1 对齐，plans/004）：
            //   UTF-8 字节视图步进 1，LoadPtr i8 有符号扩展（双后端 movsx/ldrsb——
            //   与 C 的 s[i] 一致，65 用例 字节和=-376 实证），越界由调用方按
            //   字符串长度 约束；结果类型 字符（符号扩展字节值按整数消费）。
            //   弹 下标（栈顶）与 对象（字符串指针值——标识符/成员/调用产物均可），
            //   地址 = 对象 + 下标（IR_加 步进 1），IR_指针加载 T_字节（1 字节符号
            //   扩展——独立宽度码，B5 字段 T_字符 零扩展模型互不影响）。
            // ③ 第三波：指针对象 p[i] ≡ *(p + i)（宿主 ir_expr.cpp:1555 对齐）——
            //   步进=所指元素宽度（类型名宽度；步进1 免乘），加载宽度=元素宽度码，
            //   结果登记元素类型码（打印分派/拼接消费）。对象须为指针变量（语义层
            //   白名单保证；未命中走字符串路径——两白名单互斥不误伤）。
            整64 所指ID = 0;
            如果 (n.子起点 > 0) {
                节点 下标对象节点 = 池.元素(整32(n.子起点));
                如果 (下标对象节点.类型 == 节点_标识符) {
                    结果<整64, 整32> 查所指 = 指针变量类型们.获取(整64(下标对象节点.文本));
                    如果 (查所指.正常) { 所指ID = 查所指.值; }
                }
            }
            整64 下标值 = 0;
            如果 (表达式栈.大小() >= 1) {
                下标值 = 表达式栈.元素(表达式栈.大小() - 1);
                结果<空类型, 整32> 删下 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删下.正常) { 运行时错误(4); }
            }
            整64 对象值 = 0;
            如果 (表达式栈.大小() >= 1) {
                对象值 = 表达式栈.元素(表达式栈.大小() - 1);
                结果<空类型, 整32> 删对 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删对.正常) { 运行时错误(4); }
            }
            如果 (所指ID != 0) {
                整64 步进 = 类型名宽度(所指ID);
                整64 缩放值 = 下标值;
                如果 (步进 != 1) {
                    整64 步进常量 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留(整数转字符串(步进))), 0, 0,
                                         步进常量, T_整64, 0));
                    整64 缩放寄存器 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_乘, 下标值, 步进常量, 0, 缩放寄存器, T_整64, 0));
                    缩放值 = 缩放寄存器;
                }
                整64 元素地址 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_加, 对象值, 缩放值, 0, 元素地址, T_整64, 0));
                整64 元素值寄存器 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_指针加载, 元素地址, 0, 0, 元素值寄存器,
                                     类型宽度码(驻留文本(所指ID)), 0));
                登记寄存器类型(元素值寄存器, 类型码(所指ID));
                结果<空类型, 整32> 加元素 = 表达式栈.追加(元素值寄存器);
                如果 (!加元素.正常) { 运行时错误(4); }
                位置++;
                继续;
            }
            整64 下标地址 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_加, 对象值, 下标值, 0, 下标地址, T_整64, 0));
            整64 字节值寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_指针加载, 下标地址, 0, 0, 字节值寄存器, T_字节, 0));
            登记寄存器类型(字节值寄存器, T_整64);
            结果<空类型, 整32> 加字 = 表达式栈.追加(字节值寄存器);
            如果 (!加字.正常) { 运行时错误(4); }
        }
        位置++;
    }
    如果 (表达式栈.大小() == 0) { 返回 0; }
    返回 表达式栈.元素(表达式栈.大小() - 1);
}

// ==================== 左值地址生成（P6c） ====================
// 生成左值区间 [起点, 终点) 的地址（标识符->槽地址；成员->字段地址；解引用->操作数地址）。
// 不走 生成表达式（成员会取值）；返回地址寄存器（0=失败）。
// 块计数/槽计数：短路求值透传（缺陷B，2026-09-02）。
函数 生成左值地址(向量<节点> 池, 整32 起点, 整32 终点,
                 映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
                 向量<IR指令>& 指令, 整64* 寄存器计数, 整64* 块计数, 整64* 槽计数,
                 向量<整64>& 表达式栈) -> 整64 {
    // 顺序遍历左值区间：标识符 -> 槽地址；成员 -> 基于当前基址字段地址；
    //   解引用 -> 其操作数（指针值）即地址。
    // 若区间末尾是 解引用 根节点（*指针）：其操作数即地址，前面节点（指针）跳过
    节点 末节点 = 池.元素(终点 - 1);
    如果 (末节点.类型 == 节点_解引用) {
        // ③ 第三波：只弹到进入前深度（&*p 作调用实参等嵌套形态——清空全栈
        //   会弹掉调用方先序压栈内容，同 取地址 分支根治）
        整64 解引用前深度 = 表达式栈.大小();
        整64 地址 = 生成表达式(池, 末节点.子起点, 末节点.子终点, 局部槽, 参数槽,
                               指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
        当 (表达式栈.大小() > 解引用前深度) {
            结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈.正常) { 运行时错误(4); }
        }
        返回 地址;
    }
    // 引用返回调用左值（2026-09-04 缺陷零容忍收口，宿主 P3-18 对齐）：末节点
    //   =调用（取值(p) = 42 / += 8 / 整64& r = 取值(p)）——调用点默认按右值读
    //   （IR_调用参数化 后 IR_指针加载 值），地址=回扫该 IR_指针加载.操作数1
    //   （即调用返回的左值地址；同 回扫实参取地址 第二遍模式）
    如果 (末节点.类型 == 节点_调用) {
        整64 调用前深度 = 表达式栈.大小();
        整64 值reg = 生成表达式(池, 起点, 终点, 局部槽, 参数槽,
                               指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
        当 (表达式栈.大小() > 调用前深度) {
            结果<空类型, 整32> 删栈c2 = 表达式栈.删除(表达式栈.大小() - 1);
            如果 (!删栈c2.正常) { 运行时错误(4); }
        }
        如果 (值reg != 0) {
            整64 回c = 指令.大小();
            当 (回c > 0) {
                IR指令 回扫c = 指令.元素(回c - 1);
                如果 (回扫c.操作码 == IR_指针加载 && 回扫c.目标 == 值reg) {
                    返回 回扫c.操作数1;
                }
                回c--;
            }
        }
        返回 值reg;
    }
    // ③ 第三波：下标左值（p[i] = v）——指针对象：地址 = 对象槽值 + 下标×步进
    //   （宿主 ir_expr.cpp:981~1003 对齐：lvalueAddress 地址计算 + StorePtr 写入，
    //   写宽度=所指元素宽度码，赋值分支经 取下标元素宽度码 查询）。
    //   非指针对象（字符串下标只读等）语义层已拒——防御报错返回 0。
    如果 (末节点.类型 == 节点_下标 && 末节点.子起点 > 0) {
        节点 下标对象左值 = 池.元素(整32(末节点.子起点));
        如果 (下标对象左值.类型 == 节点_标识符) {
            结果<整64, 整32> 查所指左 = 指针变量类型们.获取(整64(下标对象左值.文本));
            如果 (查所指左.正常) {
                // 对象指针值：槽 Load（局部/参数——指针参数为普通值槽非引用）
                整64 对象槽下 = 0;
                结果<整64, 整32> 找局下 = 局部槽.获取(整64(下标对象左值.文本));
                如果 (找局下.正常) { 对象槽下 = 找局下.值; }
                如果 (对象槽下 == 0) {
                    结果<整64, 整32> 找参下 = 参数槽.获取(整64(下标对象左值.文本));
                    如果 (找参下.正常) { 对象槽下 = 找参下.值; }
                }
                如果 (对象槽下 != 0) {
                    整64 指针值 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_加载, 对象槽下, 0, 0, 指针值, T_整64, 0));
                    // 下标表达式区间 [子起点+1, 子终点)（子起点=对象单节点）；
                    //   只弹到进入前深度（&p[i] 作调用实参等嵌套形态）
                    整64 下标前深度 = 表达式栈.大小();
                    整64 下标值左 = 生成表达式(池, 末节点.子起点 + 1, 末节点.子终点,
                                                局部槽, 参数槽, 指令, 寄存器计数,
                                                块计数, 槽计数, 表达式栈);
                    当 (表达式栈.大小() > 下标前深度) {
                        结果<空类型, 整32> 删栈下 = 表达式栈.删除(表达式栈.大小() - 1);
                        如果 (!删栈下.正常) { 运行时错误(4); }
                    }
                    整64 步进左 = 类型名宽度(查所指左.值);
                    整64 缩放值左 = 下标值左;
                    如果 (步进左 != 1) {
                        整64 步进常量左 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_常量整数,
                                             整64(驻留(整数转字符串(步进左))), 0, 0,
                                             步进常量左, T_整64, 0));
                        整64 缩放寄存器左 = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_乘, 下标值左, 步进常量左, 0,
                                             缩放寄存器左, T_整64, 0));
                        缩放值左 = 缩放寄存器左;
                    }
                    整64 元素地址左 = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    IR追加(指令, 建IR指令(IR_加, 指针值, 缩放值左, 0, 元素地址左, T_整64, 0));
                    返回 元素地址左;
                }
            }
        }
        IR层诊断("下标左值对象未支持（须指针变量）");
        返回 0;
    }
    整64 当前地址 = 0;
    整32 位置 = 起点;
    当 (位置 < 终点) {
        节点 左 = 池.元素(位置);
        如果 (左.类型 == 节点_标识符) {
            整64 槽 = 0;
            结果<整64, 整32> 找局 = 局部槽.获取(整64(左.文本));
            如果 (找局.正常) { 槽 = 找局.值; }
            如果 (槽 == 0) {
                结果<整64, 整32> 找参 = 参数槽.获取(整64(左.文本));
                如果 (找参.正常) { 槽 = 找参.值; }
            }
            整64 寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            如果 (槽是引用(槽)) {
                // ②c D：引用参数——槽内容即左值基址（Load 槽），非槽地址
                IR追加(指令, 建IR指令(IR_加载, 槽, 0, 0, 寄存器, T_整64, 0));
            } 否则 {
                IR追加(指令, 建IR指令(IR_取地址, 槽, 0, 0, 寄存器, T_整64, 0));
            }
            当前地址 = 寄存器;
        } 否则 如果 (左.类型 == 节点_成员) {
            整64 寄存器 = 寄存器计数[0];
            寄存器计数[0] = 寄存器计数[0] + 1;
            IR追加(指令, 建IR指令(IR_字段地址, 当前地址, 0, 0, 寄存器, T_整64, 左.附加));
            当前地址 = 寄存器;
        } 否则 如果 (左.类型 == 节点_解引用) {
            当前地址 = 生成表达式(池, 左.子起点, 左.子终点, 局部槽, 参数槽,
                                   指令, 寄存器计数, 块计数, 槽计数, 表达式栈);
            当 (表达式栈.大小() > 0) {
                结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1);
                如果 (!删栈.正常) { 运行时错误(4); }
            }
        }
        位置++;
    }
    返回 当前地址;
}

// ==================== 语句遍历 ====================
// 取参数串第 段序 段（',' 分隔，0 起；越界返回 空串）——②b 结构体实参判定用
//   （局部实现避免 代码生成共用 导入环：共用层依赖本模块）
函数 取参数段(字符串 参数串, 整64 段序) -> 字符串 {
    整64 起点 = 0;
    整64 段 = 0;
    整64 i = 0;
    当 (i <= 字符串长度(参数串)) {
        布尔 边界 = i == 字符串长度(参数串);
        如果 (!边界) {
            整64 字节 = 整64(参数串[i]);
            如果 (字节 < 0) { 字节 = 字节 + 256; }
            如果 (字节 == 44) { 边界 = 真; }
        }
        如果 (边界) {
            如果 (段 == 段序) {
                返回 字符串子串(参数串, 起点, i - 起点);
            }
            起点 = i + 1;
            段++;
        }
        i++;
    }
    返回 "";
}

// 生成 池[块起点, 块终点) 内语句的 IR。本阶段语句级支持 变量声明/返回/表达式语句/
//   赋值/自增/如果/当/中断/继续（P6b 控制流）。
// 缺陷A根治（2026-09-02）：返回 布尔=本块是否已终止（返回/中断/继续 后跳过
//   剩余语句——不可达代码不再发射，避免后续 返回 覆盖返回值/析构重复发射）。
函数 生成语句(向量<节点> 池, 整32 起点, 整32 终点,
              映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
              函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
              向量<整64>& 表达式栈, 整64 返回类型码) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    // 预扫描：收集本块内 控制流语句（如果/当）的体块节点索引——
    //   体语句节点在池中位于控制流语句节点之前（顺序追加），会被本块区间
    //   直接包含；若直接生成会造成「体语句在外层重复生成」。收集后遍历时跳过。
    向量<整64> 体块们 = 向量<整64>();
    // ②b B4：裸块语句（直接子语句的 节点_块）——内部语句同样先于块节点入池，
    //   须跳过其区间（块节点处经 生成块 递归，作用域基线/块出口析构在内处理）
    向量<整64> 裸块们 = 向量<整64>();
    整32 扫 = 起点;
    当 (扫 < 终点) {
        节点 扫节点 = 池.元素(扫);
        如果 (扫节点.类型 == 节点_如果语句) {
            // 节点字段：附加=真块索引，子终点=否则索引
            结果<空类型, 整32> 加真 = 体块们.追加(整64(扫节点.附加));
            如果 (!加真.正常) { 运行时错误(4); }
            // 根治（2026-09-06，呈报① gdb/dbg 五层下钻闭环）：否则链须整链收集——
            //   原实现仅收集首层体块，「否则如果」的嵌套如果根未被跳过：主遍历
            //   遇内层根先整链生成一遍、外层 生成如果 递归再生成一遍=双重生成
            //   （chain 探针 4 层链实测 7 次生成如果而非 4 次、块重复执行——
            //   v2 IR 自源头坏、历史冒烟「exit=0+语义 0 错」假绿的真相）
            整64 链游 = 扫节点.子终点;
            当 (链游 != 0) {
                节点 链节 = 池.元素(整32(链游));
                如果 (链节.类型 == 节点_如果语句) {
                    结果<空类型, 整32> 加根 = 体块们.追加(链游);
                    如果 (!加根.正常) { 运行时错误(4); }
                    结果<空类型, 整32> 加体 = 体块们.追加(整64(链节.附加));
                    如果 (!加体.正常) { 运行时错误(4); }
                    链游 = 链节.子终点;
                } 否则 {
                    如果 (链节.类型 == 节点_块) {
                        结果<空类型, 整32> 加尾块 = 体块们.追加(链游);
                        如果 (!加尾块.正常) { 运行时错误(4); }
                    }
                    链游 = 0;
                }
            }
        } 否则 如果 (扫节点.类型 == 节点_当语句) {
            结果<空类型, 整32> 加当 = 体块们.追加(整64(扫节点.附加));
            如果 (!加当.正常) { 运行时错误(4); }
        } 否则 如果 (扫节点.类型 == 节点_块) {
            // 排除 如果/当/否则 的体块（体块们 已收集，生成如果/生成当 递归处理
            //   ——体块节点位置晚于控制流语句节点，此刻必已登记）
            布尔 是体块 = 假;
            整64 tb = 0;
            当 (tb < 体块们.大小()) {
                如果 (体块们.元素(tb) == 整64(扫)) { 是体块 = 真; }
                tb++;
            }
            如果 (!是体块) {
                结果<空类型, 整32> 加裸 = 裸块们.追加(整64(扫));
                如果 (!加裸.正常) { 运行时错误(4); }
            }
        }
        扫++;
    }
    整32 位置 = 起点;
    当 (位置 < 终点) {
        // 跳过控制流语句的体块（体语句节点在控制流语句节点之前，已被预扫描收集）
        布尔 跳过 = 假;
        整64 跳块 = 0;
        整64 b = 0;
        当 (b < 体块们.大小()) {
            整64 体块索引 = 体块们.元素(b);
            如果 (整64(位置) == 体块索引) {
                跳过 = 真;
                跳块 = 体块索引;
            } 否则 {
                节点 体块节点 = 池.元素(整32(体块索引));
                如果 (整64(位置) >= 整64(体块节点.子起点) && 整64(位置) < 体块索引) {
                    跳过 = 真;
                    跳块 = 体块索引;
                }
            }
            b++;
        }
        如果 (跳过) {
            位置 = 整32(跳块 + 1);
            继续;
        }
        // ②b B4：跳过裸块内部语句（先于块节点入池；块节点处经 生成块 递归生成）
        布尔 在裸块内 = 假;
        整64 nb = 0;
        当 (nb < 裸块们.大小()) {
            整64 裸块索引 = 裸块们.元素(nb);
            节点 裸块节点 = 池.元素(整32(裸块索引));
            如果 (整64(位置) >= 裸块节点.子起点 && 整64(位置) < 裸块索引) {
                在裸块内 = 真;
            }
            nb++;
        }
        如果 (在裸块内) {
            位置++;
            继续;
        }
        节点 n = 池.元素(位置);
        如果 (n.类型 == 节点_变量声明) {
            节点 类型节点 = 池.元素(整32(n.附加));
            字符串 类型文本 = 驻留文本(整64(类型节点.文本));
            // ③ 第三波：指针局部登记（附加=指针层数 1..255，同参数约定——
            //   整32* p = &t.甲 形态，下标读写步进按所指元素宽度）
            如果 (类型节点.附加 >= 1 && 类型节点.附加 < 256) {
                结果<空类型, 整32> 设指针局部i = 指针变量类型们.设置(
                    整64(n.文本), 整64(类型节点.文本));
                如果 (!设指针局部i.正常) { 运行时错误(4); }
            }
            // 引用局部（泛型引用绑定，2026-09-04 IR生成.cn 冒烟 96 错根治）：
            //   单槽存绑定对象左值地址——与引用参数槽完全同构（读取分流/成员
            //   基址/赋值写回/再传引用实参数据流复用 引用参数槽们/类型们 全套
            //   机制）。绑定=初始化区间按 生成左值地址（成员/标识符——不走
            //   生成表达式，避免成员取值）。不入 RAII 名单：引用不拥有对象
            //   （绑定字段归宿主结构体所有，出口析构=双重释放必错）。
            //   语义层已拒无初始化/非左值形态（防御双保险，此处再守一道）。
            如果 (类型节点.附加 == 256) {
                如果 (n.子起点 >= n.子终点) {
                    IR层诊断("引用声明必须初始化: " + 类型文本);
                }
                整64 槽y = 槽计数[0];
                槽计数[0] = 槽计数[0] + 1;
                结果<空类型, 整32> 设槽y = 局部槽.设置(整64(n.文本), 槽y);
                如果 (!设槽y.正常) { 运行时错误(4); }
                // 容器/结果类型入双表（方法调用对象类型解析——与容器参数同款）
                如果 (是容器类(类型文本) || 是结果类型(类型文本)) {
                    结果<空类型, 整32> 设类y = 函数信息.变量类型.设置(整64(n.文本),
                                                            整64(类型节点.文本));
                    如果 (!设类y.正常) { 运行时错误(4); }
                }
                结果<空类型, 整32> 设权y = 当前函数变量类型.设置(整64(n.文本),
                                                        整64(类型节点.文本));
                如果 (!设权y.正常) { 运行时错误(4); }
                IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽y));
                结果<空类型, 整32> 设引槽y = 引用参数槽们.设置(槽y, 1);
                如果 (!设引槽y.正常) { 运行时错误(4); }
                结果<空类型, 整32> 设引类y = 引用参数类型们.设置(槽y, 整64(类型节点.文本));
                如果 (!设引类y.正常) { 运行时错误(4); }
                如果 (n.子起点 < n.子终点) {
                    整64 绑定地址 = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                                 指令, 寄存器计数, &函数信息.块计数,
                                                 槽计数, 表达式栈);
                    如果 (绑定地址 != 0) {
                        IR追加(指令, 建IR指令(IR_存储, 绑定地址, 0, 0, 0, 0, 槽y));
                    }
                }
                位置++;
                继续;
            }
            // P7b 容器变量：槽已由预扫分配（入口零初始化）；此处 NewObject +
            //   无参构造 + Store（H7 同款：无初始化器也默认构造）；
            //   初值三形态（2026-09-04，IR生成.cn 冒烟 [ir2] 收口）：
            //   ①构造调用（= 向量$T()）——NewObject+构造；
            //   ②函数调用返回（= 取实例实参们(x)）——接收转移：不 NewObject，
            //     被调方构造对象所有权移交本槽（RAII 出口析构恰一次）；
            //   ③标识符拷贝（静态/局部源）——浅共享指针（对齐宿主「按值传 向量
            //     共享数据指针」语义；取走转移惯用法——语法分析.cn 取走导入模块们）
            如果 (是容器类(类型文本)) {
                布尔 是构造调用 = 假;
                布尔 是返回接收 = 假;
                布尔 是标识符拷贝 = 假;
                如果 (n.子起点 < n.子终点) {
                    节点 首节点 = 池.元素(n.子起点);
                    节点 末节点c = 池.元素(n.子终点 - 1);
                    如果 (首节点.类型 == 节点_标识符 && 首节点.文本 == 类型节点.文本 &&
                         末节点c.类型 == 节点_调用) {
                        是构造调用 = 真;
                    } 否则 如果 (末节点c.类型 == 节点_调用) {
                        是返回接收 = 真;
                    } 否则 如果 (末节点c.类型 == 节点_标识符) {
                        是标识符拷贝 = 真;
                    } 否则 {
                        IR层诊断("容器初始化仅支持构造/调用返回/标识符拷贝: " +
                                      类型文本);
                    }
                }
                整64 槽c = 0;
                结果<整64, 整32> 找槽c = 局部槽.获取(整64(n.文本));
                如果 (找槽c.正常) { 槽c = 找槽c.值; }
                如果 (是返回接收) {
                    // 接收转移：调用返回（rax=对象指针）直接入槽
                    整64 返回值reg = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                                 指令, 寄存器计数, &函数信息.块计数,
                                                 槽计数, 表达式栈);
                    如果 (返回值reg != 0 && 槽c != 0) {
                        IR追加(指令, 建IR指令(IR_存储, 返回值reg, 0, 0, 0, 0, 槽c));
                    }
                    当 (表达式栈.大小() > 0) {
                        结果<空类型, 整32> 删栈c = 表达式栈.删除(表达式栈.大小() - 1);
                        如果 (!删栈c.正常) { 运行时错误(4); }
                    }
                    位置++;
                    继续;
                }
                如果 (是标识符拷贝) {
                    // 2026-09-06 根治（宿主对齐·深拷贝构造）：宿主实证（alias 探针
                    //   asm）`映射 B = A` 发射 NewObject+拷贝构造（符号 类$基名#类型，
                    //   独立对象出口析构）；原浅共享 IR_存储 与宿主分叉——源局部+
                    //   接收双析构=double free、写穿共享与宿主深拷贝语义矛盾。
                    //   源指针装载：局部/参数槽 IR_加载、静态 IR_静态加载。
                    节点 源节点 = 池.元素(n.子终点 - 1);
                    整64 源槽c = 0;
                    结果<整64, 整32> 找源局 = 局部槽.获取(整64(源节点.文本));
                    如果 (找源局.正常) { 源槽c = 找源局.值; }
                    如果 (源槽c == 0) {
                        结果<整64, 整32> 找源参 = 参数槽.获取(整64(源节点.文本));
                        如果 (找源参.正常) { 源槽c = 找源参.值; }
                    }
                    整64 源指针reg = 寄存器计数[0];
                    寄存器计数[0] = 寄存器计数[0] + 1;
                    布尔 源已解析 = 真;
                    如果 (源槽c != 0) {
                        // 拷贝构造源=T&（引用位传左值地址——宿主 ABI 实证：被调方
                        //   (%rsi) 解引用取对象指针）；槽是引用（绑定对象）则槽内容
                        //   即左值地址直接加载（回扫实参取地址 引用分支同款）
                        如果 (槽是引用(源槽c)) {
                            IR追加(指令, 建IR指令(IR_加载, 源槽c, 0, 0, 源指针reg, T_对象, 0));
                        } 否则 {
                            IR追加(指令, 建IR指令(IR_取地址, 源槽c, 0, 0, 源指针reg, T_整64, 0));
                        }
                    } 否则 {
                        结果<整64, 整32> 找源静 = 静态序号们.获取(整64(源节点.文本));
                        如果 (找源静.正常) {
                            // 静态容器源（取走惯用法：向量 模块列表 = 导入模块们）：
                            //   拷贝构造 T& 传静态槽左值地址（lea .data 槽）
                            IR追加(指令, 建IR指令(IR_静态地址, 0, 0, 0, 源指针reg,
                                                 T_对象, 找源静.值));
                        } 否则 {
                            源已解析 = 假;
                            IR层诊断("容器拷贝源未解析: " +
                                          驻留文本(整64(源节点.文本)));
                        }
                    }
                    如果 (源已解析) {
                        整64 拷贝objreg = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, 拷贝objreg,
                                             容器对象大小(类型文本),
                                             整64(类型节点.文本)));
                        // this=位0、源=位1（拷贝构造 T& 按引用位传对象指针）
                        IR追加(指令, 建IR指令(IR_调用实参, 拷贝objreg, 0, 0, 0, 0, 0));
                        IR追加(指令, 建IR指令(IR_调用实参, 源指针reg, 0, 0, 0, 1, 0));
                        // 拷贝构造签名=构造(T&)——参数串带 &（asm 符号 _A+类型编码，
                        //   alias.o 宿主实例 _...映射_A_T... 实证对齐）
                        IR追加(指令, 建IR指令(IR_调用参数化, 2, 0, 0, 0, 0,
                                             驻留(方法符号(类型文本,
                                                    合成名基名(类型文本),
                                                    类型文本 + "&"))));
                        如果 (槽c != 0) {
                            IR追加(指令, 建IR指令(IR_存储, 拷贝objreg, 0, 0, 0, 0, 槽c));
                        }
                    }
                    位置++;
                    继续;
                }
                整64 obj寄存器 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_分配对象, 0, 0, 0, obj寄存器,
                                     容器对象大小(类型文本), 整64(类型节点.文本)));
                // 参数区模式（项3）：this 经 IR_调用实参(64) 声明装载，63 只存总位数
                IR追加(指令, 建IR指令(IR_调用实参, obj寄存器, 0, 0, 0, 0, 0));
                IR追加(指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                     驻留(构造符号(类型文本))));
                如果 (槽c != 0) {
                    IR追加(指令, 建IR指令(IR_存储, obj寄存器, 0, 0, 0, 0, 槽c));
                }
                位置++;
                继续;
            }
            // P7b 结果/可选 变量：2 槽内联布局（12/16 字节）+ 变量类型登记；
            //   初值 = 容器方法调用（retbuf 地址）-> IR_结构体拷贝 到本变量槽
            如果 (是结果类型(类型文本)) {
                // 多槽变量数据基址=低地址槽（高槽号）：槽号越大地址越低（8*(R+s)+8），
                //   结果字节从基址向上写——若取低槽号（高地址），写入越界覆盖
                //   槽号更小的相邻变量（表对象指针被污染 -> SIGSEGV，实测踩坑）。
                //   2026-09-06 根治（freg 探针/v2self 表注册 崩溃）：T=结构体时
                //   结果>16 字节（结果<符号>=24/40）——原硬编码 2 槽+基槽 槽r+1，
                //   24 字节拷贝自基槽向上覆盖相邻变量槽（顶层容器槽被清零 ->
                //   后续方法调用 this=null 判空 fail）。按 结果槽位数 逐槽分配，
                //   基槽=最大槽号（低地址）。
                整64 槽r = 槽计数[0];
                整64 结果槽数 = 结果槽位数(类型文本);
                槽计数[0] = 槽计数[0] + 结果槽数;
                结果<空类型, 整32> 设r = 局部槽.设置(整64(n.文本), 槽r + 结果槽数 - 1);
                如果 (!设r.正常) { 运行时错误(4); }
                结果<空类型, 整32> 设类r = 函数信息.变量类型.设置(整64(n.文本), 整64(类型节点.文本));
                如果 (!设类r.正常) { 运行时错误(4); }
                结果<空类型, 整32> 设权r = 当前函数变量类型.设置(整64(n.文本), 整64(类型节点.文本));
                如果 (!设权r.正常) { 运行时错误(4); }
                整64 槽i = 0;
                当 (槽i < 结果槽数) {
                    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽r + 槽i));
                    槽i++;
                }
                如果 (n.子起点 < n.子终点) {
                    // 限定名内置直调初值（2026-09-06 根治，T6 自举首踩）：文件::/IO::
                    //   限定名内置返回裸指针（char*/FILE*，null=EOF/失败）——旧实现
                    //   把返回寄存器当「16 字节结果结构体地址」IR_结构体拷贝（读字符串
                    //   内容当结构体，v2 编译 v2 自身 读源文件 段错误实证）。改合成构造：
                    //   判空 -> 正常@0、指针 -> 值@8（对齐 结果 ABI 防御布局）
                    布尔 限定内置 = 假;
                    节点 首节点 = 池.元素(整32(n.子起点));
                    // 池顺序：调用表达式的被调标识符先入池（P6f 调用节点.子起点=被调
                    //   索引的镜像约定）——变量声明.子起点 即被调标识符（限定名内置
                    //   形态=「标识符(」无成员/后缀前缀）
                    如果 (首节点.类型 == 节点_标识符) {
                        字符串 被调名v = 驻留文本(整64(首节点.文本));
                        // 限定名判定（含 ':'，IO::/文件::）——字节位置 在 代码生成共用.cn
                        //   （IR生成 不导入=依赖环），此处内联首冒号扫描
                        布尔 含冒号 = 假;
                        整64 ci = 0;
                        当 (ci < 字符串长度(被调名v)) {
                            整64 cb = 整64(被调名v[ci]);
                            如果 (cb < 0) { cb = cb + 256; }
                            如果 (cb == 58) { 含冒号 = 真; 中断; }
                            ci++;
                        }
                        如果 (字符串长度(内置函数符号(被调名v)) != 0 && 含冒号) {
                            限定内置 = 真;
                        }
                    }
                    如果 (限定内置) {
                        整64 指针reg = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                                   指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
                        如果 (指针reg != 0) {
                            // 零初始化两槽（值@8=槽r、正常@0=槽r+1——基址槽=大槽号低地址）
                            整64 零reg = 寄存器计数[0];
                            寄存器计数[0] = 寄存器计数[0] + 1;
                            IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("0")), 0, 0, 零reg, T_整64, 0));
                            IR追加(指令, 建IR指令(IR_存储, 零reg, 0, 0, 0, 0, 槽r));
                            IR追加(指令, 建IR指令(IR_存储, 零reg, 0, 0, 0, 0, 槽r + 结果槽数 - 1));
                            // 值槽 = 裸指针
                            IR追加(指令, 建IR指令(IR_存储, 指针reg, 0, 0, 0, 0, 槽r));
                            // 正常槽 = 指针 != 0
                            整64 正常reg = 寄存器计数[0];
                            寄存器计数[0] = 寄存器计数[0] + 1;
                            IR追加(指令, 建IR指令(IR_不等, 指针reg, 零reg, 0, 正常reg, T_布尔, 0));
                            IR追加(指令, 建IR指令(IR_存储, 正常reg, 0, 0, 0, 0, 槽r + 结果槽数 - 1));
                        }
                    } 否则 {
                        整64 源地址 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                                 指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
                        如果 (源地址 != 0) {
                            整64 目标地址 = 寄存器计数[0];
                            寄存器计数[0] = 寄存器计数[0] + 1;
                            IR追加(指令, 建IR指令(IR_取地址, 槽r + 结果槽数 - 1, 0, 0, 目标地址, T_整64, 0));
                            IR追加(指令, 建IR指令(IR_结构体拷贝, 源地址, 目标地址, 0, 0,
                                                 结果大小(类型文本), 0));
                        }
                    }
                    当 (表达式栈.大小() > 0) {
                        结果<空类型, 整32> 删栈r = 表达式栈.删除(表达式栈.大小() - 1);
                        如果 (!删栈r.正常) { 运行时错误(4); }
                    }
                }
                位置++;
                继续;
            }
            // ②b B1（2026-09-02）：结构体局部变量——多槽布局（槽数=ceil(大小/8)，
            //   基址槽=最大槽号=最低地址，多槽向上写不越界）+ 零初始化（安全：
            //   字符串字段垃圾指针析构即崩——对齐宿主类局部入口零初始化防御）。
            //   整体初始化（= 表达式）暂不支持（诊断）；字段赋值走成员路径。
            如果 (查结构体大小(整64(类型节点.文本)) != 0) {
                整64 结构大小 = 查结构体大小(整64(类型节点.文本));
                整64 槽数 = (结构大小 + 7) / 8;
                整64 槽起 = 槽计数[0];
                槽计数[0] = 槽计数[0] + 槽数;
                结果<空类型, 整32> 设槽s = 局部槽.设置(整64(n.文本), 槽起 + 槽数 - 1);
                如果 (!设槽s.正常) { 运行时错误(4); }
                // ②c D：结构体局部入函数级变量类型权威表（成员偏移/宽度/方法对象解析）
                结果<空类型, 整32> 设权s = 当前函数变量类型.设置(整64(n.文本),
                                                            整64(类型节点.文本));
                如果 (!设权s.正常) { 运行时错误(4); }
                整64 z = 0;
                当 (z < 槽数) {
                    IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽起 + z));
                    z++;
                }
                // 零初始化：常量 0 -> 各槽
                整64 零寄存器 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_常量整数, 整64(驻留("0")), 0, 0, 零寄存器, T_整64, 0));
                z = 0;
                当 (z < 槽数) {
                    IR追加(指令, 建IR指令(IR_存储, 零寄存器, 0, 0, 0, 0, 槽起 + z));
                    z++;
                }
                // ②c B：含容器字段的结构体局部——登记 RAII 跟踪（块出口/返回按字段
                //   逆序级联析构：字段地址->指针加载->DeleteObject，空安全）
                //   第 15 枚豁免（2026-09-06，v2self 第 8 层）：初值末节点=调用
                //   （非构造——结构体无构造调用）-> 不登记——sret 浅拷贝自调用方
                //   容器元素（收集字符串常量 实证：函数IR 扫函数 = 程序.函数们.
                //   元素(f) 出口级联析构=free 调用方 程序.函数们[f].指令 数据 ->
                //   后续迭代读/再析构已释放内存 -> invalid free SIGABRT）；宿主
                //   语义=调用返回接收不析构（泄漏对齐现状），与第 9 枚「容器变量
                //   调用返回初值不入 RAII」同款豁免。
                布尔 结构体返回接收 = 假;
                如果 (n.子起点 < n.子终点) {
                    节点 首节点s = 池.元素(n.子起点);
                    节点 末节点s = 池.元素(n.子终点 - 1);
                    如果 (末节点s.类型 == 节点_调用 &&
                        !(首节点s.类型 == 节点_标识符 && 首节点s.文本 == 类型节点.文本)) {
                        结构体返回接收 = 真;
                    }
                }
                如果 (容器字段数(整64(类型节点.文本)) > 0 && !结构体返回接收) {
                    结果<空类型, 整32> 加字段局部 = 函数信息.容器字段局部们.追加(整64(n.文本));
                    如果 (!加字段局部.正常) { 运行时错误(4); }
                    结果<空类型, 整32> 加字段结构体 = 函数信息.容器字段结构体们.追加(整64(类型节点.文本));
                    如果 (!加字段结构体.正常) { 运行时错误(4); }
                }
                如果 (n.子起点 < n.子终点) {
                    // 结构体初始化三形态（2026-09-04 E2E 148 两形态 + 呈报①A 冒烟
                    //   暴露第三形态 2026-09-05——v2 自举刚需）：
                    //   ①调用返回（IR指令 项 = 建IR指令(...)）：rax=结构体地址
                    //     （被调 retbuf）-> IR_结构体拷贝 入本变量基槽；
                    //   ②标识符拷贝（节点 参数类型节点 = 参数——生成函数 参数循环
                    //     实测形态）：源=标识符左值地址（局部/参数基槽）-> 拷贝；
                    //   ③成员字段（符号 找到 = 查.值——结果<T>.值 整体接收，语义分析.cn
                    //     冒烟踩出）：生成表达式 成员分支压字段地址（结果值字段=结构体
                    //     值语义不 LoadPtr）-> 拷贝。字面量等其他形态保持诊断（诚实边界）。
                    节点 初始化末s = 池.元素(n.子终点 - 1);
                    如果 (初始化末s.类型 == 节点_调用 || 初始化末s.类型 == 节点_标识符 ||
                         初始化末s.类型 == 节点_成员) {
                        整64 源地址 = 0;
                        如果 (初始化末s.类型 == 节点_调用 || 初始化末s.类型 == 节点_成员) {
                            源地址 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                                 指令, 寄存器计数, &函数信息.块计数,
                                                 槽计数, 表达式栈);
                        } 否则 {
                            源地址 = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                                   指令, 寄存器计数, &函数信息.块计数,
                                                   槽计数, 表达式栈);
                        }
                        如果 (源地址 != 0) {
                            整64 目标地址 = 寄存器计数[0];
                            寄存器计数[0] = 寄存器计数[0] + 1;
                            IR追加(指令, 建IR指令(IR_取地址, 槽起 + 槽数 - 1, 0, 0,
                                                 目标地址, T_整64, 0));
                            IR追加(指令, 建IR指令(IR_结构体拷贝, 源地址, 目标地址, 0, 0,
                                                 结构大小, 0));
                        }
                        当 (表达式栈.大小() > 0) {
                            结果<空类型, 整32> 删栈s = 表达式栈.删除(表达式栈.大小() - 1);
                            如果 (!删栈s.正常) { 运行时错误(4); }
                        }
                    } 否则 {
                        IR层诊断("结构体整体初始化暂不支持（字段赋值可用）");
                    }
                }
                位置++;
                继续;
            }
            // 变量声明：分配槽；若有初值（子起点<子终点），生成初值表达式 + 存储。
            整64 槽 = 槽计数[0];
            槽计数[0] = 槽计数[0] + 1;
            结果<空类型, 整32> 设槽 = 局部槽.设置(整64(n.文本), 槽);
            如果 (!设槽.正常) { 运行时错误(4); }
            // ③ 缺陷①根治：标量局部（字符串/浮点/布尔/整数）入函数级变量类型
            //   权威表（打印分派/拼接转换经 寄存器类型登记 消费——与容器/结果/
            //   结构体局部同表，权威表自此完整覆盖本函数全部局部）
            结果<空类型, 整32> 设权标 = 当前函数变量类型.设置(整64(n.文本),
                                                        整64(类型节点.文本));
            如果 (!设权标.正常) { 运行时错误(4); }
            IR追加(指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 槽));
            如果 (n.子起点 < n.子终点) {
                整64 值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                             指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
                如果 (值寄存器 != 0) {
                    IR追加(指令, 建IR指令(IR_存储, 值寄存器, 0, 0, 0, 0, 槽));
                }
            }
        } 否则 如果 (n.类型 == 节点_返回语句) {
            整64 值寄存器 = 0;
            布尔 返回结构体值 = 函数信息.返回结构体ID != 0 && n.子起点 < n.子终点;
            // 引用返回（2026-09-04 缺陷零容忍收口，宿主 P3-18 对齐）：返回语句
            //   发射被引用左值地址（rax=左值地址——调用方指针加载读/指针存储写/
            //   引用初始化直接绑定）；非左值形态 IR 层诊断（语义层已白名单，
            //   防御双保险）
            如果 (函数信息.返回引用 == 1 && n.子起点 < n.子终点) {
                值寄存器 = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                         指令, 寄存器计数, &函数信息.块计数,
                                         槽计数, 表达式栈);
                如果 (值寄存器 == 0) {
                    IR层诊断("引用返回须返回左值（变量/成员/下标/解引用）: " +
                              驻留文本(整64(函数信息.名字)));
                }
                当 (表达式栈.大小() > 0) {
                    结果<空类型, 整32> 删栈rv = 表达式栈.删除(表达式栈.大小() - 1);
                    如果 (!删栈rv.正常) { 运行时错误(4); }
                }
                发射容器析构(函数信息, 指令, 寄存器计数, 局部槽, 0);
                IR追加(指令, 建IR指令(IR_返回, 值寄存器, 0, 0, 0, 返回类型码, 0));
                发射跳转(函数信息, 函数信息.函数尾块);
                返回 真;
            }
            如果 (返回结构体值) {
                // 用户函数返回结构体（2026-09-04，E2E 148）：宿主 ABI——值拷入
                //   调用方传入的 retbuf（槽 1 指针）、rax=retbuf。源地址两形态：
                //   末节点=标识符/成员/解引用 -> 生成左值地址（本函数局部基槽）；
                //   末节点=调用 -> 生成表达式（被调 retbuf 地址即结构体地址）
                节点 返回末 = 池.元素(n.子终点 - 1);
                如果 (返回末.类型 == 节点_标识符 || 返回末.类型 == 节点_成员 ||
                     返回末.类型 == 节点_解引用) {
                    值寄存器 = 生成左值地址(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                             指令, 寄存器计数, &函数信息.块计数,
                                             槽计数, 表达式栈);
                } 否则 {
                    值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                           指令, 寄存器计数, &函数信息.块计数,
                                           槽计数, 表达式栈);
                }
                整64 ret指针 = 寄存器计数[0];
                寄存器计数[0] = 寄存器计数[0] + 1;
                IR追加(指令, 建IR指令(IR_加载, 1, 0, 0, ret指针, T_整64, 0));
                IR追加(指令, 建IR指令(IR_结构体拷贝, 值寄存器, ret指针, 0, 0,
                                     查结构体大小(函数信息.返回结构体ID), 0));
                值寄存器 = ret指针;
                当 (表达式栈.大小() > 0) {
                    结果<空类型, 整32> 删栈r = 表达式栈.删除(表达式栈.大小() - 1);
                    如果 (!删栈r.正常) { 运行时错误(4); }
                }
            } 否则 如果 (n.子起点 < n.子终点) {
                值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                       指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
            }
            // P7b RAII：返回前析构本函数容器局部（DeleteObject 空安全——
            //   未执行声明路径槽=0 跳过；宿主 genClassDestructorCalls 同款语义）。
            //   2026-09-06 根治（T6 自举首踩）：返回结构体值时被返回变量跳过
            //   析构——所有权转移（值已浅拷入 retbuf 共享堆指针，析构局部=
            //   retbuf 悬垂，IR生成多文件 返回 程序IR 后 函数们.大小()=垃圾实测）
            //   2026-09-06 第二次根治（retown 探针）：返回**容器**（-> 映射<...>）
            //   同族——原仅 返回结构体值 设跳过名，返回容器标识符仍被析构=
            //   返回悬垂指针（接收方 .获取 崩）。泛化：末节点=标识符即设跳过名
            //   （非容器名不在 容器变量们，无副作用）
            整64 返回转移名ID = 0;
            如果 (n.子终点 > n.子起点) {
                节点 返回末转移 = 池.元素(n.子终点 - 1);
                如果 (返回末转移.类型 == 节点_标识符) {
                    返回转移名ID = 整64(返回末转移.文本);
                }
            }
            发射容器析构(函数信息, 指令, 寄存器计数, 局部槽, 返回转移名ID);
            IR追加(指令, 建IR指令(IR_返回, 值寄存器, 0, 0, 0, 返回类型码, 0));
            // 缺陷A根治：返回 后跳函数尾块（epilogue 唯一）——中途回退不再穿透
            发射跳转(函数信息, 函数信息.函数尾块);
            返回 真;
        } 否则 如果 (n.类型 == 节点_表达式语句) {
            // 表达式语句：求值（结果丢弃）。子区间为表达式节点。
            如果 (n.子起点 < n.子终点) {
                生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                            指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
            }
        } 否则 如果 (n.类型 == 节点_赋值) {
            // 赋值：文本=左值名（标识符）；文本=0 时 附加=左值表达式起点（解引用/成员左值）
            如果 (n.文本 != 0) {
                // 标识符左值：槽 <- 右值寄存器
                整64 目标槽 = 0;
                结果<整64, 整32> 找槽 = 局部槽.获取(整64(n.文本));
                如果 (找槽.正常) { 目标槽 = 找槽.值; }
                如果 (目标槽 == 0) {
                    结果<整64, 整32> 找参 = 参数槽.获取(整64(n.文本));
                    如果 (找参.正常) { 目标槽 = 找参.值; }
                }
                整64 值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                            指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
                // 静态槽赋值（2026-09-06 根治，缺陷零容忍）：目标非局部/参数时查
                //   静态序号表——命中则 IR_静态存储 写回 .data 槽。原实现此处仅认
                //   局部/参数槽，静态目标「目标槽==0」静默丢存储（探针 计数器 =
                //   计数器 + 阶乘(5) 打印恒 0 实证）——防御分支静默降级家族成员，
                //   与 发射自增自减 的静态读写对（②c C）同款设施补齐
                如果 (目标槽 == 0 && 值寄存器 != 0) {
                    结果<整64, 整32> 找静赋 = 静态序号们.获取(整64(n.文本));
                    如果 (找静赋.正常) {
                        IR追加(指令, 建IR指令(IR_静态存储, 值寄存器, 0, 0, 0, T_整64, 找静赋.值));
                    }
                }
                如果 (值寄存器 != 0 && 目标槽 != 0) {                    如果 (槽是引用(目标槽)) {
                        // ②c D：引用参数赋值——Load 槽得调用方左值地址，指针写回
                        整64 地址reg = 寄存器计数[0];
                        寄存器计数[0] = 寄存器计数[0] + 1;
                        IR追加(指令, 建IR指令(IR_加载, 目标槽, 0, 0, 地址reg, T_整64, 0));
                        IR追加(指令, 建IR指令(IR_指针存储, 地址reg, 值寄存器, 0, 0, T_整64, 0));
                    } 否则 {
                        IR追加(指令, 建IR指令(IR_存储, 值寄存器, 0, 0, 0, 0, 目标槽));
                    }
                }
                // 清空表达式栈（右值 残留）
                当 (表达式栈.大小() > 0) {
                    结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1);
                    如果 (!删栈.正常) { 运行时错误(4); }
                }
            } 否则 {
                // 成员/解引用左值：手动生成左值地址（不走 生成表达式，避免成员取值）
                // ②b B5：成员左值按字段宽度存储（类型码入 指令.类型——旧固定 8 字节
                //   写越界清零相邻槽，126 段① OOM 根因；解引用左值保持默认 8 字节）
                整64 存储宽度 = T_整64;
                节点 左末 = 池.元素(n.子起点 - 1);
                如果 (左末.类型 == 节点_成员) {
                    存储宽度 = 取成员宽度码(池, n.子起点 - 1);
                } 否则 如果 (左末.类型 == 节点_下标) {
                    // ③ 第三波：下标左值写宽度=所指元素宽度（整32* p[0]=v 写 4 字节，
                    //   8 字节写越界踩相邻元素——同 B5 成员窄宽教训）
                    存储宽度 = 取下标元素宽度码(池, n.子起点 - 1);
                }
                整64 地址寄存器 = 生成左值地址(池, 整32(n.附加), n.子起点, 局部槽, 参数槽,
                                            指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
                整64 值寄存器 = 生成表达式(池, n.子起点, n.子终点, 局部槽, 参数槽,
                                           指令, 寄存器计数, &函数信息.块计数, 槽计数, 表达式栈);
                如果 (地址寄存器 != 0 && 值寄存器 != 0) {
                    IR追加(指令, 建IR指令(IR_指针存储, 地址寄存器, 值寄存器, 0, 0, 存储宽度, 0));
                }
                // 清空表达式栈（右值 残留）
                当 (表达式栈.大小() > 0) {
                    结果<空类型, 整32> 删栈 = 表达式栈.删除(表达式栈.大小() - 1);
                    如果 (!删栈.正常) { 运行时错误(4); }
                }
            }
        } 否则 如果 (n.类型 == 节点_自增) {
            // 自增：Load 槽 +1 -> Store（P6b 语句级）；②c D：引用参数经指针读写回；
            //   ③ 第六波：静态槽读写对——分支体抽入 发射自增自减（C1 自减对称共用）
            发射自增自减(指令, 整64(n.文本), 假, 局部槽, 参数槽, 寄存器计数);
        } 否则 如果 (n.类型 == 节点_自减) {
            // 簇③根治·自减全链 C1（2026-09-04 用户裁决）：与自增对称（IR_减 1）
            发射自增自减(指令, 整64(n.文本), 真, 局部槽, 参数槽, 寄存器计数);
        } 否则 如果 (n.类型 == 节点_块) {
            // ②b B4：裸块语句——递归生成（作用域基线/块出口析构 由 生成块 统一处理，
            //   块内容器/资源结构体局部 块结束即释放）
            生成块(池, 位置, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
        } 否则 如果 (n.类型 == 节点_如果语句) {
            布尔 如果终止 = 生成如果(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
            如果 (如果终止) { 返回 真; }
        } 否则 如果 (n.类型 == 节点_当语句) {
            布尔 当终止 = 生成当(池, n, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
            如果 (当终止) { 返回 真; }
        } 否则 如果 (n.类型 == 节点_中断语句) {
            // 中断：跳转到最近循环出口块（函数信息.循环出口块）
            如果 (函数信息.循环出口块 != 0) {
                发射跳转(函数信息, 函数信息.循环出口块);
                返回 真;   // 块终止：跳过本块剩余语句（不可达）
            }
        } 否则 如果 (n.类型 == 节点_继续语句) {
            // 继续：跳转到最近循环继续块
            如果 (函数信息.循环继续块 != 0) {
                发射跳转(函数信息, 函数信息.循环继续块);
                返回 真;   // 块终止：跳过本块剩余语句（不可达）
            }
        }
        位置++;
    }
    返回 假;
}

// ==================== 块遍历 ====================
// 生成一个块的语句 IR。返回 布尔=块是否已终止（缺陷A：终止感知）。
函数 生成块(向量<节点> 池, 整32 块节点,
            映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
            函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
            向量<整64>& 表达式栈, 整64 返回类型码) -> 布尔 {
    节点 块 = 池.元素(块节点);
    // 块级作用域析构（用户裁决项2）：入口记录 容器变量们 基线，出口对本块
    //   新增容器发 RAII 析构并截断列表——块结束即释放（安全目标：及时、
    //   作用域精确）；返回语句仍析构全部（跨块跳出兜底，晚析构无害）。
    //   嵌套块同名容器由语义层拒绝（预扫同名合槽，遮蔽会泄漏/双释——P7c 前不支持）。
    //   ②c B：含容器字段结构体局部同款（字段基线 截断）。
    整64 作用域基线 = 函数信息.容器变量们.大小();
    整64 字段作用域基线 = 函数信息.容器字段局部们.大小();
    布尔 已终止 = 生成语句(池, 块.子起点, 块.子终点, 局部槽, 参数槽, 函数信息,
                          寄存器计数, 槽计数, 表达式栈, 返回类型码);
    // 出口：析构本块新增容器（逆序——后声明先析构），并从列表截断。
    //   已终止（返回/中断/继续 已跳出）时不发射——控制流不可达，且 返回 已析构全部。
    如果 (!已终止) {
        块出口析构(函数信息, 局部槽, 寄存器计数, 作用域基线, 字段作用域基线);
    }
    返回 已终止;
}

// ==================== 控制流生成（P6b） ====================
// 生成 如果语句：条件寄存器 + 真块/假块 + 汇合块（标签随建随取）。
// 返回 布尔=两分支是否都已终止（缺陷A：终止分支不发汇合跳转——不可达）。
函数 生成如果(向量<节点> 池, 节点 如果节点,
              映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
              函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
              向量<整64>& 表达式栈, 整64 返回类型码) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    // 节点字段：文本=条件起点，子起点=条件终点，附加=真块索引，子终点=否则索引
    整64 条件寄存器 = 生成表达式(池, 整32(如果节点.文本), 整32(如果节点.子起点),
                                 局部槽, 参数槽, 指令, 寄存器计数, &函数信息.块计数,
                                 槽计数, 表达式栈);
    整64 真块 = 新块(函数信息);
    整64 假块 = 新块(函数信息);
    整64 汇合块 = 新块(函数信息);
    发射条件跳转(函数信息, 条件寄存器, 真块, 假块);
    // 真块
    切换块(函数信息, 真块);
    发射块标签(函数信息, 真块);
    布尔 真终止 = 生成块(池, 整32(如果节点.附加), 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
    如果 (!真终止) {
        发射跳转(函数信息, 汇合块);
    }
    // 假块（否则链）
    切换块(函数信息, 假块);
    发射块标签(函数信息, 假块);
    布尔 假终止 = 假;
    整64 否则索引 = 如果节点.子终点;
    如果 (否则索引 != 0) {
        节点 否则节点 = 池.元素(整32(否则索引));
        如果 (否则节点.类型 == 节点_如果语句) {
            // 否则 如果：递归生成（不额外发射跳转到汇合——递归内已处理）
            假终止 = 生成如果(池, 否则节点, 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
        } 否则 {
            假终止 = 生成块(池, 整32(否则索引), 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
        }
    }
    如果 (!假终止) {
        发射跳转(函数信息, 汇合块);
    }
    // 汇合块
    切换块(函数信息, 汇合块);
    发射块标签(函数信息, 汇合块);
    返回 真终止 && 假终止;
}

// 生成 当语句：jmp 条件块 -> 条件表达式 -> 条件跳转 体/出口 -> 体 -> jmp 条件块
// 返回 布尔=假（循环出口恒可达——条件假路径；体终止只省略回边）
函数 生成当(向量<节点> 池, 节点 当节点,
            映射<整64, 整64>& 局部槽, 映射<整64, 整64>& 参数槽,
            函数IR& 函数信息, 整64* 寄存器计数, 整64* 槽计数,
            向量<整64>& 表达式栈, 整64 返回类型码) -> 布尔 {
    向量<IR指令>& 指令 = 函数信息.指令;
    整64 条件块 = 新块(函数信息);
    整64 体块 = 新块(函数信息);
    整64 出口块 = 新块(函数信息);
    // 无条件跳入条件块
    发射跳转(函数信息, 条件块);
    // 条件块
    切换块(函数信息, 条件块);
    发射块标签(函数信息, 条件块);
    // 节点字段：文本=条件起点，附加=体块索引，子起点=条件终点
    整64 条件寄存器 = 生成表达式(池, 整32(当节点.文本), 整32(当节点.子起点),
                                 局部槽, 参数槽, 指令, 寄存器计数, &函数信息.块计数,
                                 槽计数, 表达式栈);
    发射条件跳转(函数信息, 条件寄存器, 体块, 出口块);
    // 体块：记录循环上下文（继续->条件块，中断->出口块）
    整64 旧出口 = 函数信息.循环出口块;
    整64 旧继续 = 函数信息.循环继续块;
    函数信息.循环出口块 = 出口块;
    函数信息.循环继续块 = 条件块;
    切换块(函数信息, 体块);
    发射块标签(函数信息, 体块);
    布尔 体终止 = 生成块(池, 整32(当节点.附加), 局部槽, 参数槽, 函数信息, 寄存器计数, 槽计数, 表达式栈, 返回类型码);
    函数信息.循环出口块 = 旧出口;
    函数信息.循环继续块 = 旧继续;
    如果 (!体终止) {
        发射跳转(函数信息, 条件块);
    }
    // 出口块
    切换块(函数信息, 出口块);
    发射块标签(函数信息, 出口块);
    返回 假;
}

// ==================== 函数遍历 ====================
// 从函数节点生成 函数IR（参数槽 + 局部槽 + 指令）。
函数 生成函数(向量<节点> 池, 整32 函数节点) -> 函数IR {
    函数IR 函数信息;
    // 结构体裸声明不调用字段默认构造——容器字段须显式初始化（否则 .追加/.设置 空指针/垃圾）
    函数信息.指令 = 向量<IR指令>();
    函数信息.局部槽 = 映射<整64, 整64>();
    函数信息.参数槽 = 映射<整64, 整64>();
    函数信息.变量类型 = 映射<整64, 整64>();
    函数信息.容器变量们 = 向量<整64>();
    函数信息.容器字段局部们 = 向量<整64>();
    函数信息.容器字段结构体们 = 向量<整64>();
    函数信息.参数槽序们 = 向量<整64>();
    函数信息.参数拷贝字节们 = 向量<整64>();
    // ②c D：引用参数槽表/函数级变量类型权威表 按函数重置（生成函数 串行——无交叉）
    引用参数槽们.清空();
    引用参数类型们.清空();
    当前函数变量类型.清空();
    寄存器类型们.清空();
    指针变量类型们.清空();  // ③ 第三波：函数级生命周期（同权威表）
    节点 函数声明 = 池.元素(函数节点);
    函数信息.名字 = 函数声明.文本;
    函数信息.返回类型 = 类型码(整64(函数声明.附加));
    // 引用返回（2026-09-04 缺陷零容忍收口，宿主 P3-18 对齐）：返回类型名尾 '&'
    //   （-> 整64&，语法层已并入）——返回语句按左值地址发射
    字符串 返回类型名r = 驻留文本(整64(函数声明.附加));
    如果 (字符串长度(返回类型名r) > 0 &&
         字符串比较(字符串子串(返回类型名r, 字符串长度(返回类型名r) - 1, 1), "&")) {
        函数信息.返回引用 = 1;
    }
    // 用户函数返回结构体（2026-09-04，E2E 148）：被调方槽 1 保留（调用方传入的
    //   retbuf 指针——prologue 位0 rcx 存入；IR_分配 附加=1 占位使帧扫描计入）
    如果 (查结构体大小(整64(函数声明.附加)) != 0) {
        函数信息.返回结构体ID = 整64(函数声明.附加);
        IR追加(函数信息.指令, 建IR指令(IR_分配, 0, 0, 0, 0, 0, 1));
    }
    函数信息.块计数 = 0;      // P6b：块编号从 0（入口块）起
    函数信息.当前块 = 0;
    函数信息.循环出口块 = 0;
    函数信息.循环继续块 = 0;
    函数信息.函数尾块 = 新块(函数信息);  // 缺陷A：尾块先建（体中 IR_返回 可引用）；标签末尾发射
    当前retbuf字节数 = 0;    // ②b B6：本函数 retbuf 尺寸累计清零（生成表达式 累计）
    整64 寄存器计数 = 1;
    整64 槽计数 = 1;
    如果 (函数信息.返回结构体ID != 0) { 槽计数 = 2; }   // 槽 1=retbuf 指针保留
    向量<整64> 表达式栈 = 向量<整64>();
    // 参数：函数节点子区间 [子起点, 块.子起点) 为参数节点（块 在 子终点=块索引）；
    //   块 的语句节点（表达式/返回）在 [块.子起点, 块索引)，不能当参数遍历。
    整64 参数起点 = 整64(函数声明.子起点);
    整32 块索引 = 函数声明.子终点;
    整64 参数终点 = 参数起点;
    如果 (块索引 < 池.大小()) {
        节点 块节点 = 池.元素(块索引);
        参数终点 = 整64(块节点.子起点);
    }
    整64 参数位置 = 参数起点;
    当 (参数位置 < 参数终点) {
        节点 参数 = 池.元素(整32(参数位置));
        // 只注册 参数 节点（区间可能含 块语句前的非参数节点）
        如果 (参数.类型 == 节点_参数) {
            // ②b B8：结构体按值参数——多槽（槽数=ceil(大小/8)，基址槽=最大槽号=最低
            //   地址，与 B1 局部同约定）；标量单槽。声明序登记 槽序/拷贝字节——
            //   双后端 prologue 据此：标量直存寄存器值；结构体从指针入参拷贝入槽。
            //   ②c D：& 引用参数——槽存调用方左值地址（跳过多槽拷贝：拷贝字节 0、
            //   单槽），登记 引用参数槽们/类型们（读取分流发射）
            整64 拷贝字节 = 0;
            整64 参数槽数 = 1;
            布尔 是引用参数 = 假;
            节点 参数类型节点 = 参数;
            // 守卫用 >= 0（lessons 池索引 0 合法）：首函数首参数的类型节点恰在
            //   池索引 0 时，原 > 0 漏解析——指针登记随之漏（min 探针实锤）
            如果 (参数.附加 >= 0 && 参数.附加 < 池.大小()) {
                节点 参数类型候选 = 池.元素(整32(参数.附加));
                如果 (参数类型候选.类型 == 节点_类型) {
                    参数类型节点 = 参数类型候选;
                    如果 (参数类型节点.附加 >= 256) {
                        是引用参数 = 真;
                    } 否则 {
                        // ③ 第三波：指针参数登记（附加=指针层数 1..255——槽存指针值
                        //   单槽，下标读写按所指元素宽度步进；引用 >=256 不入）
                        如果 (参数类型节点.附加 >= 1) {
                            结果<空类型, 整32> 设指针参数i = 指针变量类型们.设置(
                                整64(参数.文本), 整64(参数类型节点.文本));
                            如果 (!设指针参数i.正常) { 运行时错误(4); }
                        }
                        整64 结构大小 = 查结构体大小(整64(参数类型节点.文本));
                        如果 (结构大小 != 0) {
                            拷贝字节 = 结构大小;
                            参数槽数 = (结构大小 + 7) / 8;
                        }
                    }
                }
            }
            整64 槽 = 槽计数;
            槽计数 = 槽计数 + 参数槽数;
            结果<空类型, 整32> 设参 = 函数信息.参数槽.设置(整64(参数.文本), 槽 + 参数槽数 - 1);
            如果 (!设参.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加槽序 = 函数信息.参数槽序们.追加(槽 + 参数槽数 - 1);
            如果 (!加槽序.正常) { 运行时错误(4); }
            结果<空类型, 整32> 加拷贝 = 函数信息.参数拷贝字节们.追加(拷贝字节);
            如果 (!加拷贝.正常) { 运行时错误(4); }
            如果 (是引用参数) {
                结果<空类型, 整32> 设引槽 = 引用参数槽们.设置(槽 + 参数槽数 - 1, 1);
                如果 (!设引槽.正常) { 运行时错误(4); }
                结果<空类型, 整32> 设引类 = 引用参数类型们.设置(槽 + 参数槽数 - 1,
                                                             整64(参数类型节点.文本));
                如果 (!设引类.正常) { 运行时错误(4); }
            }
            // P7b：容器/结果参数登记类型（方法调用的对象类型解析用）；
            //   容器参数不 RAII 析构（按值传=浅共享指针，被调方不拥有）。
            //   ②c D：全部参数类型入 函数级变量类型权威表（含 结构体 值/引用——
            //   跨函数同名异型根治）。守卫 >= 0：首函数首参数类型节点可恰在池 0
            如果 (参数.附加 >= 0 && 参数.附加 < 池.大小()) {
                字符串 参数类型文本 = 驻留文本(整64(参数类型节点.文本));
                如果 (是容器类(参数类型文本) || 是结果类型(参数类型文本)) {
                    结果<空类型, 整32> 设参类 = 函数信息.变量类型.设置(整64(参数.文本),
                                                            整64(参数类型节点.文本));
                    如果 (!设参类.正常) { 运行时错误(4); }
                    结果<空类型, 整32> 设权类 = 当前函数变量类型.设置(整64(参数.文本),
                                                             整64(参数类型节点.文本));
                    如果 (!设权类.正常) { 运行时错误(4); }
                } 否则 {
                    如果 (查结构体大小(整64(参数类型节点.文本)) != 0) {
                        结果<空类型, 整32> 设权结 = 当前函数变量类型.设置(整64(参数.文本),
                                                                 整64(参数类型节点.文本));
                        如果 (!设权结.正常) { 运行时错误(4); }
                    } 否则 {
                        // ③ 缺陷①根治：标量参数（字符串/浮点/布尔/整数）入权威表
                        //   （与标量局部同——打印分派/拼接转换消费）
                        结果<空类型, 整32> 设权标参 = 当前函数变量类型.设置(整64(参数.文本),
                                                                     整64(参数类型节点.文本));
                        如果 (!设权标参.正常) { 运行时错误(4); }
                    }
                }
            }
        }
        参数位置++;
    }
    // ②c C：入口函数（主）——容器静态初始化注入（P3-8 指针槽：NewObject+构造+
    //   IR_静态存储 存指针进 .data 槽；标量静态初始值已在 .data 直存，跳过）
    如果 (函数声明.文本 == 整32(驻留("主"))) {
        整64 s序 = 0;
        当 (s序 < 静态名们.大小()) {
            整64 静态类型ID = 静态类型们.元素(s序);
            字符串 静态类型文本 = 驻留文本(静态类型ID);
            如果 (是容器类(静态类型文本)) {
                整64 obj寄存器 = 寄存器计数;
                寄存器计数 = 寄存器计数 + 1;
                IR追加(函数信息.指令, 建IR指令(IR_分配对象, 0, 0, 0, obj寄存器,
                                                     容器对象大小(静态类型文本), 静态类型ID));
                IR追加(函数信息.指令, 建IR指令(IR_调用实参, obj寄存器, 0, 0, 0, 0, 0));
                IR追加(函数信息.指令, 建IR指令(IR_调用参数化, 1, 0, 0, 0, 0,
                                                     驻留(构造符号(静态类型文本))));
                IR追加(函数信息.指令, 建IR指令(IR_静态存储, obj寄存器, 0, 0, 0, 0, s序));
            }
            s序++;
        }
    }
    // P7b 预扫容器声明：槽分配+入口零初始化+类型登记（先于函数体生成——
    //   入口零初始化指令位于函数最前）
    如果 (块索引 < 池.大小()) {
        预扫容器声明(池, 块索引, 函数信息, &槽计数, &寄存器计数);
    }
    // 函数体：块 在 函数声明.子终点（块索引）
    如果 (块索引 < 池.大小()) {
        生成块(池, 块索引, 函数信息.局部槽, 函数信息.参数槽, 函数信息,
                &寄存器计数, &槽计数, 表达式栈, 函数信息.返回类型);
    }
    // 缺陷A根治：函数尾块——fall-through 与全部 返回 汇聚于此（epilogue 唯一）。
    //   体末的 跳转 对已 返回 的路径是死代码（无害），对 fall-through 路径必经。
    发射跳转(函数信息, 函数信息.函数尾块);
    切换块(函数信息, 函数信息.函数尾块);
    发射块标签(函数信息, 函数信息.函数尾块);
    函数信息.retbuf字节数 = 当前retbuf字节数;    // ②b B6：回填（扫描函数 据此定 retbuf 帧区）
    返回 函数信息;
}

// ==================== 程序遍历 ====================
// 从 程序 节点生成 程序IR（所有函数）。
函数 IR生成(向量<节点> 池, 整32 程序节点) -> 程序IR {
    程序IR 程序;
    // 结构体裸声明不调用字段默认构造——容器字段须显式初始化（否则 .追加 空指针/垃圾）
    程序.函数们 = 向量<函数IR>();
    程序.静态初始值们 = 向量<整64>();
    程序.静态数 = 0;
    常量表.清空();          // P7a：常量表任务级生命周期（入口清空，幂等）
    收集常量(池, 程序节点);
    函数实参结构们.清空();   // ②b B8：任务级生命周期（入口清空）
    收集函数实参结构(池, 程序节点);
    函数返回类型们.清空();   // ③ 第二波（方案A）：任务级生命周期（入口清空）
    收集函数返回类型(池, 程序节点);
    清空引用参数表();        // ②c D：任务级生命周期
    清空静态表();            // ②c C：任务级生命周期（入口清空，幂等）
    收集静态(池, 程序节点, 程序.静态初始值们);
    程序.静态数 = 静态名们.大小();
    节点 程序声明 = 池.元素(程序节点);
    整64 位置 = 整64(程序声明.子起点);
    整64 终点 = 整64(程序声明.子终点);
    当 (位置 < 终点) {
        节点 声明 = 池.元素(整32(位置));
        如果 (声明.类型 == 节点_函数) {
            函数IR 函数信息 = 生成函数(池, 整32(位置));
            结果<空类型, 整32> 加 = 程序.函数们.追加(函数信息);
            如果 (!加.正常) { 运行时错误(4); }
        }
        位置++;
    }
    返回 程序;
}

// ==================== 程序遍历（多文件 P6h） ====================
// 多源文件：遍历全部 程序 节点的函数声明，合并进同一 程序IR（函数们 顺序 = 文件加载顺序）。
函数 IR生成多文件(向量<节点> 池, 向量<整32> 程序节点们) -> 程序IR {
    程序IR 程序;
    // IR 层错误计数任务级清空（2026-09-04，IR 层错误即中止纪律——主.cn 检查点）
    清空IR层错误计数();
    // 结构体裸声明不调用字段默认构造——容器字段须显式初始化（否则 .追加 空指针/垃圾）
    程序.函数们 = 向量<函数IR>();
    程序.静态初始值们 = 向量<整64>();
    程序.静态数 = 0;
    常量表.清空();          // P7a：常量表任务级生命周期（入口清空；全部文件依次收集）
    函数实参结构们.清空();   // ②b B8：任务级生命周期（全部文件依次收集）
    函数返回类型们.清空();   // ③ 第二波（方案A）：任务级生命周期（全部文件依次收集）
    清空引用参数表();        // ②c D：任务级生命周期
    清空静态表();            // ②c C：任务级生命周期（全部文件依次收集）
    整64 f = 0;
    当 (f < 程序节点们.大小()) {
        收集常量(池, 程序节点们.元素(整32(f)));
        收集函数实参结构(池, 程序节点们.元素(整32(f)));
        收集函数返回类型(池, 程序节点们.元素(整32(f)));
        收集静态(池, 程序节点们.元素(整32(f)), 程序.静态初始值们);
        f++;
    }
    程序.静态数 = 静态名们.大小();
    f = 0;
    当 (f < 程序节点们.大小()) {
        节点 程序声明 = 池.元素(程序节点们.元素(整32(f)));
        整64 位置 = 整64(程序声明.子起点);
        整64 终点 = 整64(程序声明.子终点);
        当 (位置 < 终点) {
            节点 声明 = 池.元素(整32(位置));
            如果 (声明.类型 == 节点_函数) {
                函数IR 函数信息 = 生成函数(池, 整32(位置));
                结果<空类型, 整32> 加 = 程序.函数们.追加(函数信息);
                如果 (!加.正常) { 运行时错误(4); }
            }
            位置++;
        }
        f++;
    }
    返回 程序;
}
