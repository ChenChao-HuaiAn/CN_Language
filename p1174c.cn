类 资源 {
公开:
    函数 资源() { 打印("A"); }
    不安全 函数 ~资源() { 打印("D"); }
}

函数 失败源() -> 结果<整32, 整32> {
    返回 错误(7);
}

函数 层2() -> 结果<整32, 整32> {
    资源 r1;
    整32 v = 失败源()?;
    返回 正常(v);
}

函数 层1() -> 结果<整32, 整32> {
    资源 r2;
    整32 v = 层2()?;
    返回 正常(v);
}

函数 主() -> 整32 {
    打印("B");
    结果<整32, 整32> r = 层1();
    打印("C");
    如果 (!r.正常) { 打印(r.错误); } 否则 { 打印(r.值); }
    返回 0;
}
