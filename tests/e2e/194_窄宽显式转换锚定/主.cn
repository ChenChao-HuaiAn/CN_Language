// E2E 194：窄宽（正8/正16）显式转换→64 位目标 双侧锚定（2026-09-10 第五十五轮
//   观察项②收口）：v2 类型码() 将正8/正16 归一登记 T_整64（窄宽无独立码），
//   方案甲源分派归入 T_正64 64 位直拷——正确性=64 位槽零扩展写入保证高位干净；
//   宿主对称发射 movzx 零扩展。结构体字段层经 类型宽度码() T_整8 窄宽读回
//   （1 字节布局+movzx/uxtb）独立正确。stdout 四锚：31（变量显式转换五形态
//   校验和 1+2+4+8+16）/65535/255/15（字段+指针解引用+传参+宽字段完好
//   校验和 1+2+8+4）。v2 侧同源用例=194_v2。
结构体 包 { 正8 窄; 整64 宽; }
函数 读窄(正8* q) -> 整32 {
    返回 *q;
}
函数 主() -> 整32 {
    正8 小8 = 200;
    正16 小16 = 60000;
    正8 满8 = 255;
    正16 满16 = 65535;
    整32 累计 = 0;
    如果 (整64(小8) == 200) { 累计 = 累计 + 1; }
    如果 (整64(满8) == 255) { 累计 = 累计 + 2; }
    如果 (整64(小16) == 60000) { 累计 = 累计 + 4; }
    如果 (整64(满16) == 65535) { 累计 = 累计 + 8; }
    如果 (正64(满16) == 65535) { 累计 = 累计 + 16; }
    打印(累计);
    打印(整64(满16));
    打印(整64(满8));
    包 p;
    正8 窄值 = 200;
    p.窄 = 窄值;
    p.宽 = 12345;
    整32 累计2 = 0;
    如果 (整64(p.窄) == 200) { 累计2 = 累计2 + 1; }
    正8* q = &p.窄;
    如果 (整64(*q) == 200) { 累计2 = 累计2 + 2; }
    如果 (读窄(&p.窄) == 200) { 累计2 = 累计2 + 8; }
    如果 (p.宽 == 12345) { 累计2 = 累计2 + 4; }
    打印(累计2);
    打印(p.宽);
    返回 0;
}
