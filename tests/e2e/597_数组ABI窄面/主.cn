// E2E 597：数组 ABI 窄面双编译对照（087b 切片 2·#087 余量 v2 面对齐·宿主 82984e4bbe）
//   覆盖 596 未打形态（≤8 字节数组=单槽直存陷阱带 + 方法面）：
//   ① ≤8 字节数组形参（整32[2]=8B——v2 原落 983 兜底「>8」判定外=单槽直存
//     把传入地址当值存槽→读调用方数据/悬垂写穿；宿主塌缩族同病面）
//   ② ≤8 字节数组返回（整32[2]——sret 判定「>8」外落标量 rax 直返=首 4 字节）
//   ③ 方法数组形参（类方法体内 a[i]——宿主 ir_oop/v2 方法面 B8+参数槽配对）
//   ④ 方法数组返回（retbuf 定帧=数组字节·签名返回字节数 折叠分支）
//   ⑤ 声明接收方法数组返回（`整32[2] v = 箱.造对();` 整块拷）
//   退出码 = 五形态折校验和 15（①1+②2+③4+④⑤8 全对）。
//   宿主侧 == 用例期望值；v2 侧 == 宿主侧实测值（等价性判据）。
类 工具箱 {
公开:
    函数 总和两(整32[2] a) -> 整32 {
        返回 a[0] + a[1];
    }
    函数 造对() -> 整32[2] {
        整32[2] r;
        r[0] = 7;
        r[1] = 8;
        返回 r;
    }
}
函数 折半和(整32[2] a) -> 整32 {
    返回 a[0] + a[1];
}
函数 造窄() -> 整32[2] {
    整32[2] r;
    r[0] = 30;
    r[1] = 40;
    返回 r;
}
函数 主() -> 整32 {
    整32 累计 = 0;
    整32[2] 窄表;
    窄表[0] = 3;
    窄表[1] = 4;
    如果 (折半和(窄表) == 7) { 累计 += 1; }
    整32[2] w = 造窄();
    如果 (w[0] == 30 && w[1] == 40) { 累计 += 2; }
    工具箱 箱;
    如果 (箱.总和两(窄表) == 7) { 累计 += 4; }
    整32[2] v = 箱.造对();
    如果 (v[0] == 7 && v[1] == 8) { 累计 += 8; }
    打印("窄=", 折半和(窄表));
    打印("w=", w[0], w[1]);
    打印("法=", 箱.总和两(窄表));
    打印("v=", v[0], v[1]);
    打印("sum=", 累计);
    返回 0;
}
