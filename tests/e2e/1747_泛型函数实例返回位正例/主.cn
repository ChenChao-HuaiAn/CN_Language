// E2E 1747（宿主+v2 双编译正例，2026-11-04 1103 采样轮 #1996）：
//   泛型函数实例返回位 A2 执法不误伤面：
//   ①T=整32/浮64 值返回（返回局部/形参的拥有移出面·无嵌套改写）放行；
//   ②泛型类方法实例体返回 T 来源字段=借出视图设计（Rust Vec::get -> &T 同款·
//     容器 元素/读取 同族），类方法实例豁免保留（放行）；
//   ③字符串显式 字符串复制(...) 落堆=拥有契约成立（放行）。
泛型 <类型 T>
函数 恒等(T v) -> T {
    返回 v;
}

泛型 <类型 T>
类 盒子 {
公开:
    T 值;
    函数 盒子(T 初值) {
        值 = 初值;
    }
    函数 取() -> T {
        返回 值;
    }
}

函数 复制取(字符串 v) -> 字符串 {
    返回 字符串复制(v);
}

函数 主() -> 整32 {
    打印(恒等(3));
    打印(恒等(1.5));
    盒子<字符串> b = 盒子<字符串>("甲");
    打印(b.取());
    打印(复制取("乙"));
    返回 0;
}
