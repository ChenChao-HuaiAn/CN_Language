// E2E 1661 正测 dual（#1769 批文②缺格补类型默认态·1473 已批甲案每层递归）：
//   行缺格+行内缺格双形态——数值=0/字符串=空串态/结果=异常态(读 .正常=假)/
//   类=默认构造(字段默认值注入)。001 §3.5 条文①执法锚。
函数 读果(结果<整32, 整32> 元) -> 整32 {
    如果 (元.正常) { 返回 元.值; } 否则 { 返回 0 - 1; }
}
类 点 {
公开:
    整32 x = 7;
    函数 读x() -> 整32 { 返回 x; }
}
函数 主() -> 整32 {
    // 行内缺格：部[0][1] / 部[0][2] = 0
    整32[2][3] 部 = { { 5 } };
    打印(部[0][0]);
    打印(部[0][1]);
    打印(部[0][2]);
    // 行缺格：全 = 0
    整32[2][2] 行缺 = { { 1 } };
    打印(行缺[1][0]);
    打印(行缺[1][1]);
    // 字符串缺格=空串态
    字符串[2][2] 串缺 = { { "有" } };
    打印(串缺[1][1] + "尾");
    // 结果缺格=异常态
    结果<整32, 整32>[2][2] 果缺 = { { 正常(3) } };
    打印(读果(果缺[0][1]));
    // 类缺格=默认构造（字段默认值 7）
    点[2][2] 点缺 = { { 点() } };
    打印(点缺[1][1].读x());
    返回 0;
}
