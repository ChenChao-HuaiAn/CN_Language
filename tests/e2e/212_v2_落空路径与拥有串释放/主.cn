// E2E 212_v2（2026-09-11 第七十二轮 plans/019 4'-三 F2 根治）：v2 侧函数
//   **落空路径**（体末无 返回 语句——fall-through 直达函数尾块）的 RAII 出口
//   释放。原实现只在 返回 语句路径发射 发射容器析构/发射字符串释放，落空路径
//   完全不释放=拥有串/容器局部随栈帧销毁永久泄漏（探针实证：`函数 落空()
//   { 字符串 甲 = 造串(); }` 的 asm 无 __cn_str_free）。Rust 语义=函数体末尾
//   隐式 drop。修复=体块未终止时在函数尾块前发射出口释放（已终止路径由
//   返回语句路径负责，避免二次释放——首版无条件发射致 210_v2/196_v2 回归）。
//   校验和折位（1/2/4）：落空路径释放 + 返回路径释放并存 + 内容正确。
函数 造串() -> 字符串 {
    返回 字符串复制("拥有串");
}

// ① 落空路径：体末无 返回（fall-through）——须在函数尾块前释放
函数 落空路径() {
    字符串 甲 = 造串();
}

// ② 返回路径：与落空路径并存时互不干扰
函数 返回值路径() -> 字符串 {
    字符串 乙 = 造串();
    返回 乙;
}

// ③ 落空路径 + 循环内声明（非块出口，函数级兜底）
函数 落空循环(整64 轮数) {
    整64 i = 0;
    当 (i < 轮数) {
        字符串 每轮 = 字符串复制("循环体串");
        i++;
    }
}

函数 主() -> 整32 {
    整32 校验 = 0;
    落空路径();
    校验 = 校验 + 1;
    字符串 丙 = 返回值路径();
    如果 (字符串比较(丙, "拥有串")) { 校验 = 校验 + 2; }
    落空循环(3);
    校验 = 校验 + 4;
    返回 校验;
}
