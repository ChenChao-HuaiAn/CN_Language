// 001 §3.9 结构体面·域外类字段访问编译期拒绝（#1943 负形态锁面）：
//   结构体类字段的级联构造只对闭合域（字段类有析构+拷贝构造+默认构造）
//   开放——级联活句柄+memcpy 浅拷共享=双主，域外字段维持零初始化空句柄。
//   访问域外类字段原行为=运行期「运行时错误(错误码3): 空指针解引用」
//  （对拍 n06 双侧一致崩）——本用例锁定编译期显式拒绝（双侧都必须拒）：
//   字段类 内C 无析构/拷贝构造/默认构造=闭合域外，s.里的 访问编译报错。
//   引导：字段类须补全三构造入闭合域，或改用类外层承载。
类 内C {
公开:
    整32 v;
}

结构体 外S {
    内C 里的;
    整32 计;
}

函数 主() -> 整32 {
    外S s;
    s.里的.v = 7;
    打印行(s.里的.v);
    返回 0;
}
