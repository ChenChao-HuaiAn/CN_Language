// 【031 语义更新·#1075】对象.实例方法 求值为绑定方法值（栈上两槽 {this,code}·
//   plans/031 一等公民化·用户 2026-10-18 批）：本用例锁双侧兼容形态——变量
//   绑定位/拷贝链/多对象/直调/自身.方法（107 原地重定义=裸 fnptr 实参拒绝）。
//   「已绑定变量**改绑**后直调」v2 侧未覆盖（过渡期既有缺口·随 v2 对称落地，
//   #1075 报告遗留项）——本用例不含该形态。
// 语义=引用绑定：调用读对象**当前状态**（改态后 205·e2e 104 断言面保持）。
// 覆盖：①直调 ②改态读最新 ③拷贝链直调 ④多对象独立 ⑤绑定位（声明初值）
//   ⑥方法内 自身.方法。
类 计数器 {
公开:
    整32 基数;
    函数 计数器(整32 b) { 基数 = b; }
    函数 双倍(整32 x) -> 整32 { 返回 基数 + x; }
    函数 自身双倍(整32 x) -> 整32 {
        变量 内 = 自身.双倍;
        返回 内(x);
    }
}
函数 主() -> 整32 {
    计数器 对象 = 计数器(100);
    变量 cb = 对象.双倍;
    打印(整32(cb(5)));             // 105（直调）
    对象.基数 = 200;
    打印(整32(cb(5)));             // 205（引用语义：改态读最新）
    变量 g = cb;
    打印(整32(g(3)));              // 203（拷贝链直调）
    计数器 乙 = 计数器(7);
    变量 d = 乙.双倍;
    打印(整32(d(1)));              // 8（多对象独立）
    变量 命 = 对象.双倍;
    打印(整32(命(4)));             // 204（绑定位直调）
    打印(整32(对象.自身双倍(6)));  // 206（自身.方法 形态）
    返回 0;
}
