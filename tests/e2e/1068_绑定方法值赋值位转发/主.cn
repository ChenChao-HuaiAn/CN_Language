// E2E 1068_绑定方法值赋值位转发（#943 修复转正·dual）：实例方法作值（对象.实例方法）
//   在变量绑定位改为 IR 合成**蹦床闭包**（宿主 ensureMethodValueTrap943 / v2 合成
//   方法值蹦床943）——值自带绑定对象指针静态槽，经 fnptr 形参转发/拷贝/跨函数
//   调用安全（修前=裸方法符号丢绑定·转发段错误 rc139·p82d 探针）。
// 语义=引用绑定：调用读对象**当前状态**（改态后 205·e2e 104 断言面保持）。
// 覆盖：①显式 fnptr 声明（本缺陷主探针）②直调不回归 ③推断声明 ④标识符赋值位
//   ⑤拷贝链转发 ⑥多对象独立 ⑦方法内 自身.方法（对象非标识符形态同受益）。
类 计数器 {
公开:
    整32 基数;
    函数 计数器(整32 b) { 基数 = b; }
    函数 双倍(整32 x) -> 整32 { 返回 基数 + x; }
    函数 自身双倍(整32 x) -> 整32 {
        变量 内 = 自身.双倍;
        返回 内(x);
    }
}
函数 应用(整32(*f)(整32), 整32 v) -> 整32 { 返回 f(v); }
函数 主() -> 整32 {
    计数器 对象 = 计数器(100);
    整32(*绑)(整32) = 对象.双倍;
    打印(整32(绑(5)));             // 105（直调不回归）
    打印(整32(应用(绑, 5)));       // 105（转发修复锚·修前 rc139）
    变量 cb = 对象.双倍;
    对象.基数 = 200;
    打印(整32(cb(5)));             // 205（引用语义：改态读最新）
    打印(整32(应用(cb, 5)));       // 205（转发+引用语义）
    变量 g = cb;
    打印(整32(应用(g, 3)));        // 203（拷贝链转发）
    计数器 乙 = 计数器(7);
    变量 d = 乙.双倍;
    打印(整32(应用(d, 1)));        // 8（多对象独立）
    整32(*命)(整32);
    命 = 对象.双倍;
    打印(整32(应用(命, 4)));       // 204（标识符赋值位）
    打印(整32(对象.自身双倍(6)));  // 206（自身.方法 形态）
    返回 0;
}
