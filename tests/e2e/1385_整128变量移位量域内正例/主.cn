// E2E 1385（2026-10-19·任务 #1103「变量移位量域检查」正例矩阵·rc=0 全绿）：
//   域检查零误伤矩阵——①k=0 恒等；②k=63 半界内；③k=64 跨半；④k=100；
//   ⑤k=127 上界（含·域 [0,128) 的最大合法值）；⑥右移同域（k=100→0）；
//   ⑦窄通道（整64）域内移位不误伤（128 检查不得波及窄域）。双编译对照：
//   宿主与 v2 同源同测——输出逐行一致 + rc=0。
函数 主() -> 整32 {
    整128 甲 = 1LL;
    整64 k0 = 0;
    打印(甲 << k0);       // 1（恒等）
    整64 k63 = 63;
    打印(甲 << k63);      // 2^63（半界内）
    整64 k64 = 64;
    打印(甲 << k64);      // 2^64（跨半边界）
    整64 k100 = 100;
    打印(甲 << k100);     // 2^100
    整64 k127 = 127;
    打印(甲 << k127);     // 2^127 位模式=符号位（整128 打印 INT128_MIN 负值·上界含）
    打印(甲 >> k100);     // 0（右移同域）
    整64 窄 = 1;
    整64 窄量 = 40;
    打印(窄 << 窄量);     // 2^40（窄通道域内·零误伤）
    返回 0;
}
