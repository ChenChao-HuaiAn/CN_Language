// 1076（#857·2026-10-17）：结构体指针字段布局与局部槽分配 ABI 零分叉
//   （813h 探针转正·双编译对照同测同期望）
//   修前（v2）：字段布局按剥星基名取宽（`整32* 游标` 按整32 4/4 入布局）——
//   游标偏移 4（宿主 8）、盒大小 8（宿主 16）→局部槽数 1（宿主 2）；
//   b.游标=&池[1] 写 8 字节穿邻槽污染 池[0]=栈地址（813h 实测 128·宿主 7）。
//   修后（v2）：IR布局.指针层宽对齐折算 单点（附加 1..255→8/8）+ 类型大小与对齐
//   指针显式分支——结构体/类/泛型实例克隆三消费点同口径；对齐宿主
//   computeLayout/typeSizeOf/typeAlignOf 指针=8/8（逐字节 ABI 一致）。
//   形态矩阵：①盒在池后声明（813h 穿邻槽原形：池全貌+盒大小+游标读）
//   ②盒在池前声明（1000 同款对照）③混排字段对齐填充（整8/整64/整64*）
//   ④相邻哨兵不污染 ⑤双盒指针写回可见。
结构体 盒 {
    整32 值;
    整32* 游标;
}
结构体 混 {
    整8 标;
    整64 大;
    整64* 指针;
}
不安全 函数 主() -> 整32 {
    // ① 813h 原形：盒 b 声明在 池 数组之后（穿邻槽场景）
    整32[4] 池;
    池[0] = 7; 池[1] = 8; 池[2] = 9; 池[3] = 10;
    盒 b;
    b.值 = 5;
    b.游标 = &池[1];
    打印("盒大小: ", 类型大小(盒));
    打印("池0: ", 池[0]);
    打印("池1: ", 池[1]);
    打印("池2: ", 池[2]);
    打印("池3: ", 池[3]);
    打印("值: ", b.值);
    打印("游标读: ", *b.游标);
    // ② 盒 c 在 池 之前声明（1000 用例同款对照）
    盒 c;
    c.游标 = &池[2];
    打印("c游标读: ", *c.游标);
    打印("池2b: ", 池[2]);
    // ③ 混结构体：整8/整64/整64* 对齐填充（标@0 大@8 指针@16 大小 24）
    混 m;
    m.标 = 3;
    m.大 = 1000;
    整64 单 = 42;
    m.指针 = &单;
    打印("混大小: ", 类型大小(混));
    打印("混标: ", m.标);
    打印("混大: ", m.大);
    打印("混指针读: ", *m.指针);
    // ④ 相邻哨兵完好（指针字段写不穿邻）
    整64 哨 = 12345;
    m.指针 = &哨;
    打印("哨: ", 哨);
    打印("混指针读2: ", *m.指针);
    // ⑤ 双盒指针写回（解引用写后互相可见）
    盒 d;
    d.游标 = &池[3];
    *d.游标 = 88;
    打印("池3b: ", 池[3]);
    打印("d游标读: ", *d.游标);
    返回 0;
}
