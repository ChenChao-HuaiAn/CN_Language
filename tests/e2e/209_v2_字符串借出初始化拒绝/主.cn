// E2E 209（宿主负测，2026-09-11 第六十七轮 plans/019 阶段4' A1 方案A 用户批准）：
//   字符串借出初始化拒绝——下标/成员/解引用初值是借用视图，隐式装入拥有变量
//   =编译器注入 __cn_str_free 行使他人指针的所有权（实测 UAF：s=名单[0] 后重新
//   赋值→free 旧堆串→数组元素悬垂→读取乱码；驻留指针形态被 cn_free_tracked
//   注册表防御静默跳过=语义错位）。三坏形态拒绝 + 三好形态放行（拼接恒堆/
//   显式复制落堆/裸读借用不受影响）。
结构体 条目 {
    字符串 名;
}
函数 主() -> 整32 {
    字符串[3] 名单;
    名单[0] = "甲";
    字符串 s1 = 名单[0];          // 坏1：下标借出
    条目 t;
    t.名 = "乙";
    字符串 s2 = t.名;             // 坏2：成员借出
    字符串* p = &名单[1];
    字符串 s3 = *p;               // 坏3：解引用借出
    返回 0;
}
