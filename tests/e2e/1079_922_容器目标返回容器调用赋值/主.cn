// E2E 1079（2026-10-17 任务922 / 并入 #925）：容器目标 ←「返回容器的调用」
//   赋值——v2 侧 sret 壳栈物化升堆物化（对齐宿主 identifierClassCallProductAssign
//   直收堆句柄·v2 同步声明位 091 堆物化口径）。
//   病面（#922/#925·p629i 矩阵实锤）：向量<字符串> 甲; 甲 = 厂.产(); v2
//   产物=被调方 sret 物化到本帧的容器壳栈地址直存目标槽 → 块出口容器 RAII
//   按堆句柄 free 栈地址=C0000374；同源次生=633 通道先求值 miss 后 472
//   二次求值（被调两次调用+物化①孤儿）。
//   断言面（校验和折位·每形态 1 位·循环 50 次净分配 0+内容断言防假绿）：
//     ① 变量 ← 方法返回容器（甲 = 厂.产()）
//     ② 变量 ← 自由函数返回容器（甲 = 造向量()）
//     ③ 成员容器字段 ← 方法返回容器（盒.槽 = 厂.产()）
//     ④ 变量 ← 容器方法返回容器元素（甲 = 表.元素(0)·值的快照语义）
//     ⑤ 变量 ← 容器构造调用（甲 = 向量<字符串>()）
//     ⑥ 声明位对照（乙 = 厂.产()·091 既有通道防误伤回归）
//     ⑦ 静态容器变量（静态甲 = 厂.产()·静态槽恒拥有）
//     ⑧ 引用参数容器（转(甲, 厂)·引用参数=调用方对象别名 drop 旧值）
//   校验和 = Σ位；全对 = 36（两进制和）；任一形态泄漏/内容错=校验位丢失。
导入 容器::向量;

类 货舱 {
公开:
    向量<字符串> 槽;
    函数 货舱() { 槽 = 向量<字符串>(); }
    函数 ~货舱() { }
    不安全 函数 货舱(货舱& 其他) { 槽 = 其他.槽; }
}

类 主仓 {
公开:
    函数 主仓() { }
    函数 产() -> 向量<字符串> {
        向量<字符串> 临时;
        结果<空类型, 整32> r2 = 临时.追加(字符串复制("新鲜载荷"));
        返回 临时;
    }
}

函数 造向量() -> 向量<字符串> {
    向量<字符串> 临时;
    结果<空类型, 整32> r2 = 临时.追加(字符串复制("自由载荷"));
    返回 临时;
}

静态 向量<字符串> 静态甲 = 向量<字符串>();

不安全 函数 转(向量<字符串>& 甲, 主仓& 厂) {
    甲 = 厂.产();
}

// ① 变量 ← 方法返回容器
函数 形一() -> 整64 {
    整64 前 = 内存::活动分配数();
    主仓 厂;
    整64 轮 = 0;
    当 (轮 < 50) {
        向量<字符串> 甲;
        结果<空类型, 整32> r1 = 甲.追加(字符串复制("旧载荷一"));
        甲 = 厂.产();
        如果 (甲.大小() != 1) { 返回 0; }
        轮++;
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 1;
}

// ② 变量 ← 自由函数返回容器
函数 形二() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 轮 = 0;
    当 (轮 < 50) {
        向量<字符串> 甲;
        结果<空类型, 整32> r1 = 甲.追加(字符串复制("旧载荷二"));
        甲 = 造向量();
        如果 (甲.大小() != 1) { 返回 0; }
        轮++;
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 2;
}

// ③ 成员容器字段 ← 方法返回容器
函数 形三() -> 整64 {
    整64 前 = 内存::活动分配数();
    主仓 厂;
    整64 轮 = 0;
    当 (轮 < 50) {
        货舱 盒;
        结果<空类型, 整32> r1 = 盒.槽.追加(字符串复制("旧载荷三"));
        盒.槽 = 厂.产();
        如果 (盒.槽.大小() != 1) { 返回 0; }
        轮++;
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 4;
}

// ④ 变量 ← 容器方法返回容器元素（表.元素(0) 快照语义）
函数 形四() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 轮 = 0;
    当 (轮 < 50) {
        向量<向量<字符串>> 表;
        向量<字符串> 行;
        结果<空类型, 整32> r2 = 行.追加(字符串复制("元素载荷"));
        结果<空类型, 整32> r3 = 表.追加(行);
        向量<字符串> 甲;
        结果<空类型, 整32> r1 = 甲.追加(字符串复制("旧载荷四"));
        甲 = 表.元素(0);
        如果 (甲.大小() != 1) { 返回 0; }
        轮++;
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 8;
}

// ⑤ 变量 ← 容器构造调用
函数 形五() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 轮 = 0;
    当 (轮 < 50) {
        向量<字符串> 甲;
        结果<空类型, 整32> r1 = 甲.追加(字符串复制("旧载荷五"));
        甲 = 向量<字符串>();
        如果 (甲.大小() != 0) { 返回 0; }
        轮++;
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 16;
}

// ⑥ 声明位对照（091 既有通道·防误伤回归）
函数 形六() -> 整64 {
    整64 前 = 内存::活动分配数();
    主仓 厂;
    整64 轮 = 0;
    当 (轮 < 50) {
        向量<字符串> 乙 = 厂.产();
        如果 (乙.大小() != 1) { 返回 0; }
        轮++;
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 32;
}

// ⑦ 静态容器变量（静态槽恒拥有·终值显式释放后断言净 0）
不安全 函数 形七() -> 整64 {
    整64 前 = 内存::活动分配数();
    主仓 厂;
    整64 轮 = 0;
    当 (轮 < 50) {
        静态甲 = 厂.产();
        如果 (静态甲.大小() != 1) { 返回 0; }
        轮++;
    }
    静态甲 = 向量<字符串>();
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 64;
}

// ⑧ 引用参数容器（引用参数=调用方对象别名·drop 旧值）
函数 形八() -> 整64 {
    整64 前 = 内存::活动分配数();
    主仓 厂;
    整64 轮 = 0;
    当 (轮 < 50) {
        向量<字符串> 甲;
        结果<空类型, 整32> r1 = 甲.追加(字符串复制("旧载荷六"));
        转(甲, 厂);
        如果 (甲.大小() != 1) { 返回 0; }
        轮++;
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 128;
}

函数 主() -> 整32 {
    整64 校验和 = 形一() + 形二() + 形三() + 形四() + 形五() + 形六() + 形七() + 形八();
    如果 (校验和 == 255) {
        打印("容器目标返回容器调用赋值：八形态全通过");
    } 否则 {
        打印("容器目标返回容器调用赋值：失败");
    }
    返回 整32(校验和);
}
