// 任务244 E2E：数组返回值临时下标访问（造表()[i]·001 §4.5 优先级13 后缀同级可链）
// 覆盖：①函数返回数组临时下标读（[0]/[1]/[2] 全元素·元素按类型宽度步进）
//       ②临时下标赋给变量（消费面同值）③方法返回数组临时下标（b.取表()[1]）
//       ④对照：临时落变量再下标（既有正确路径·值须一致）
// 历史：宿主曾 8 字节宽读错值（[0]=10+20*2^32 打包数）；v2 曾语义层编译期拒
//       （下标对象形态未支持）——244 双侧根治后两侧同值。
函数 造表() -> 整32[3] {
    整32[3] 表 = { 10, 20, 30 };
    返回 表;
}

类 盒子 {
公开:
    函数 盒子() {
    }
    函数 取表() -> 整32[3] {
        整32[3] 表 = { 7, 8, 9 };
        返回 表;
    }
}

不安全 函数 主() -> 整32 {
    打印(造表()[0]);
    打印(造表()[1]);
    打印(造表()[2]);
    整32 x = 造表()[1];
    打印(x);
    盒子 b;
    打印(b.取表()[1]);
    整32[3] 表 = 造表();
    打印(表[1]);
    返回 0;
}
