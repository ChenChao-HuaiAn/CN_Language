// 1420：枚举/字符串跨类型情况标签双侧拒绝（1193 负例 dual·预期失败）
// 修前 v2 宽松面：裸名跨枚举放行（全局裸名表命中即当常量）、裸名在非枚举
//   条件下放行（全局裸名表命中）、字符串条件与整型标签互斥缺失（规范 03
//   §3.4 C-4 一致性约束）。修后 v2 与宿主同拒（文案逐字对齐）。
// 逐个锁面：①裸名跨枚举（形状成员用在 颜色 条件）②裸名对整条件
//   ③整数值标签对字符串条件。
枚举 颜色 { 红, 绿, 蓝 }
枚举 形状 { 圆, 方 }

函数 主() -> 整32 {
    颜色 c = 颜色.红;
    选择 (c) {
        情况 圆:
            打印行("跨枚举裸名");
            中断;
        默认:
            打印行("默认");
    }
    整32 n = 0;
    选择 (n) {
        情况 红:
            打印行("裸名对整条件");
            中断;
        默认:
            打印行("默认");
    }
    字符串 s = "1";
    选择 (s) {
        情况 1:
            打印行("整数标签对字符串条件");
            中断;
        默认:
            打印行("默认");
    }
    返回 0;
}
