// E2E 869_单目重载迁延形态（#537 根治锁用例）：单目运算符重载（- ! ~ 节点
//   形态）结果对象作 ①方法调用接收者 ②成员左值写目标——两类「迁延形态」必须
//   与「先存变量再操作」等价、与宿主同值（零分叉）。
//   缺陷实录（507 实施轮呈报·537 立项）：①(-点(5)).取() v2 编译中止
//   「[ir2] 方法调用对象类型未解析: .取」；②(-p).x = 7 v2 编译中止
//   「[ir2] 成员左值字段偏移未知: x」——方法接收者类型推导/左值写偏移兜底
//   未接单目表达式形态（507 同族第三形态扩面·负号/逻辑非/位非 节点类型判定）。
//   根治=v2 三消费点收口 解析单目重载结果类型ID（507 判定扩面·单一事实源）+
//   左值基址分支（重载结果临时对象地址·宿主「写临时对象·原对象不变」同构）。
//   宿主行为基准=exprSrcType UnaryExpr 读 resolvedType 写回（465/507 零分叉）。
类 点 {
公开:
    整32 x;

    函数 点(整32 v) {
        x = v;
    }

    // 单目负号重载：返回 点 类对象（x 取反）
    函数 运算符-() -> 点 {
        点 负 = 点(0 - x);
        返回 负;
    }

    函数 取() -> 整32 {
        返回 x;
    }
}

类 温度 {
公开:
    整32 值;

    函数 温度(整32 v) {
        值 = v;
    }

    // 单目逻辑非重载：返回 温度 类对象（值归零）
    函数 运算符!() -> 温度 {
        温度 归 = 温度(0);
        返回 归;
    }

    函数 读() -> 整32 {
        返回 值;
    }
}

类 掩码 {
公开:
    整32 位;

    函数 掩码(整32 v) {
        位 = v;
    }

    // 单目位非重载：返回 掩码 类对象（255 - 位·P0-3 位非重载语义）
    函数 运算符~() -> 掩码 {
        掩码 反 = 掩码(255 - 位);
        返回 反;
    }

    函数 查() -> 整32 {
        返回 位;
    }
}

函数 主() -> 整32 {
    // ===== 形态①：单目重载结果对象作方法调用接收者（- ! ~ 三类）=====
    打印((-点(5)).取());
    打印((!温度(23)).读());
    打印((~掩码(200)).查());
    // 形态①对照：先存变量再调用（语义必须一致）
    点 a = -点(5);
    打印(a.取());
    // 形态①嵌套单目：重载结果再施重载再调用
    打印((-(-点(5))).取());
    // ===== 形态②：单目重载结果对象作成员左值写目标（写临时·原对象不变）=====
    点 p = 点(3);
    (-p).x = 7;
    打印(p.x);
    打印((-p).x);
    // 形态②构造调用操作数 + 先存变量对照
    (-点(5)).x = 42;
    点 q = -点(5);
    打印(q.x);
    // 形态②参与运算（原对象 p 在两次写临时后仍不变）
    (-点(10)).x = 6;
    (-p).x = 1;
    打印(p.x + (-p).x);
    返回 0;
}
