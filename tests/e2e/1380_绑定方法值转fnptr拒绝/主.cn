// E2E 1380_绑定方法值转fnptr拒绝（031 第 1 期·负例 11·dual）：
//   方法值→裸函数指针全形态拒绝（对象引用无处安放·plans/031 §二·③）——
//   ①显式 fnptr 声明初值 ②fnptr 变量赋值位；#943 旧过渡路径由放行改拒。
类 计数器 {
公开:
    整32 基数;
    函数 计数器(整32 b) { 基数 = b; }
    函数 双倍(整32 x) -> 整32 { 返回 基数 + x; }
}
函数 主() -> 整32 {
    计数器 对象 = 计数器(100);
    整32(*绑)(整32) = 对象.双倍;
    整32(*命)(整32);
    命 = 对象.双倍;
    返回 整32(绑(5) + 命(5));
}
