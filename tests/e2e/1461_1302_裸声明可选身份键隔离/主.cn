// 1461：1302 P0-2 回归锁——多个**裸声明**（无初值）结果/可选 局部的身份键
//   不得共槽：解析器裸声明 子起点/子终点恒 0，身份键须用 声明.附加（类型节点
//   池索引·逐声明唯一）。两个裸 可选<整64> 分别赋 2/3；一个裸 结果<整64,整32> 赋 7。
函数 取甲() -> 可选<整64> {
    返回 某些(2);
}
函数 取乙() -> 可选<整64> {
    返回 某些(3);
}
函数 取丙() -> 结果<整64, 整32> {
    返回 正常(7);
}
函数 主() -> 整32 {
    可选<整64> 甲;
    可选<整64> 乙;
    结果<整64, 整32> 丙;
    甲 = 取甲();
    乙 = 取乙();
    丙 = 取丙();
    整64 a = 0;
    整64 b = 0;
    整64 c = 0;
    如果 (甲.有值) { a = 甲.值; }
    如果 (乙.有值) { b = 乙.值; }
    如果 (丙.正常) { c = 丙.值; }
    打印("甲=" + 整数转字符串(a));
    打印("乙=" + 整数转字符串(b));
    打印("丙=" + 整数转字符串(c));
    如果 (a == 2 && b == 3 && c == 7) { 返回 0; }
    返回 1;
}
