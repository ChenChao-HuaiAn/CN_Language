// E2E 1045_运算符重载返回结构体全消费位（#936 同族根治·dual）：
// 覆盖：运算符重载返回结构体（二元 + / - 与单目 -）的全消费位——宿主与 v2
//   两侧同修前各有缺口（双侧实录）：
//   - 宿主：①emitOperatorOverload 缺形态A retbuf 预插（被调方垃圾 rcx 野写
//     C0000005·p5 实录）②赋值位 assignValueSrcType 不认二元/单目表达式 →
//     落 8 字节标量 Store 只存指针（p9『差 = 甲 - 乙』读出指针低 32 位垃圾·
//     非确定性）③静态目标位同缺 ④成员链对象类型推导 miss（648 内部错误
//     p11『(甲 + 乙).x』）⑤x64 nameMangle 直通判定仅查非 ASCII → ASCII
//     类名单目符号 `W$-` 非法 MASM（A2008·与 linux/arm64 后端判据分叉）。
//   - v2：①结构体初始化位白名单缺二元/单目节点 ②结构体赋值位同缺
//     ③发射用户类方法调用聚合返回直接压共享 retbuf 地址（未物化/未登记
//     结构体返回临时们 → 赋值位消费 miss）④成员链结构体键推导仅单目
//     （537 分支）缺二元对称面（「成员字段偏移未知」实录）。
//   修后双侧同 ABI（形态A retbuf 位 0=rcx + 物化壳 + CopyStruct 物化）。
// 锁面（六消费位）：①初始化位 ②赋值位 ③静态目标位（不安全函数内）
//   ④实参位（结构体形参直传）⑤成员链位（(甲+乙).x）⑥静态方法返回位。
结构体 向量 { 整32 x; 整32 y; }

类 V {
公开:
    整32 x;
    整32 y;
    函数 V(整32 a, 整32 b) { x = a; y = b; }
    函数 运算符+(V 右) -> 向量 {
        向量 r;
        r.x = x + 右.x;
        r.y = y + 右.y;
        返回 r;
    }
    函数 运算符-(V 右) -> 向量 {
        向量 r;
        r.x = x - 右.x;
        r.y = y - 右.y;
        返回 r;
    }
}

静态 向量 静态和;

函数 求和(向量 v) -> 整32 {
    返回 v.x + v.y;
}

类 工具 {
公开:
    静态 函数 差(V 甲, V 乙) -> 向量 {
        返回 甲 - 乙;
    }
}

不安全 函数 静态位测试(V 甲, V 乙) -> 整32 {
    静态和 = 甲 + 乙;
    返回 静态和.x + 静态和.y;
}

函数 主() -> 整32 {
    V 甲 = V(1, 2);
    V 乙 = V(10, 20);
    向量 和 = 甲 + 乙;
    打印("初始化位: ", 和.x + 和.y);
    向量 差;
    差 = 甲 - 乙;
    打印("赋值位: ", 差.x + 差.y);
    打印("静态位: ", 静态位测试(甲, 乙));
    打印("实参位: ", 求和(甲 + 乙));
    打印("成员链: ", (甲 + 乙).x);
    向量 返 = 工具.差(乙, 甲);
    打印("静态方法返回位: ", 返.x + 返.y);
    返回 0;
}
