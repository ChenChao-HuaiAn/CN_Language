// 1722（#1972 dual 正测·同族）：结构体数组元素内的联合体字段写后读取。修前
//   宿主误报 E0381「变量 '组[0].u' 未初始化」（联合体字段单键与字段链写标记
//   粒度错位）；v2 同源放行=分叉。联合体字段任一成员写=该联合体字段初始化。
联合体 值 {
    整32 i;
    整64 l;
}
结构体 槽 {
    整32 标签;
    值 u;
}
不安全 函数 主() -> 整32 {
    槽[2] 组;
    组[0].标签 = 1;
    组[0].u.l = 0;
    组[0].u.i = 7;
    组[1].标签 = 2;
    组[1].u.l = 8;
    打印(组[0].标签);
    打印(组[0].u.i);
    打印(组[1].u.l);
    返回 0;
}
