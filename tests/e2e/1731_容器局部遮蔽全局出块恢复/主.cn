// E2E 1731（#1946 P1 双侧分叉根治·容器块级绑定恢复缺口）：
//   全局容器被块内同名局部容器遮蔽后，出块读该名须恢复指向全局（宿主
//   词法块级作用域语义·001）——修前 v2 局部槽函数级映射+预扫按名合槽，
//   容器局部声明点未做块级绑定登记（1415 机制：引用/类对象/结构体/数组/
//   结果/标量六族皆有·唯容器漏），出块不恢复绑定 → 标识符读命中内层
//   已析构清零槽 → 空指针崩溃 rc=1（宿主 0/0 rc=0 = dual 红证据）。
//   锁面五段：①向量主面（块内 0/出块 0/函数返回后再读 0）
//             ②写入面（不安全 函数内：出块读全局 0 → 追加全局 → 1；
//               同时证明块内写入不写穿全局=遮蔽独立）
//             ③同名异型面（全局 向量<整64> 被块内 向量<整32> 遮蔽·
//               锁类型表随绑定恢复）
//             ④映射面/⑤集合面（预扫容器通道同族形态锁·同一生成路径）。
//   注：局部-局部同名容器遮蔽=语义层 P7c 前置拒绝（既有口径，不在本用例面）；
//       局部-全局同名=合法遮蔽（宿主放行·本用例即其正测锁面）。
导入 容器::向量;
导入 映射集合;

向量<整32> 列;                  // ① 顶层全局容器（被块内局部遮蔽）
向量<整64> 长列;                // ③ 全局 整64 版（被块内 整32 版同名遮蔽）
映射<整64, 整64> 表;            // ④ 顶层全局映射
集合<整64> 集;                  // ⑤ 顶层全局集合

// ① 主面：块内局部遮蔽 → 出块恢复 → 返回后再读全局（大小() 返回整64）
函数 造局部() -> 整64 {
    {
        向量<整32> 列;          // 块内同名局部容器（遮蔽全局）
        打印行(列.大小());      // 指内层 → 0
    }
    // 出块后应指回全局（遮蔽恢复）——修前 v2 命中已析构内层槽=崩溃点
    打印行(列.大小());          // 指全局 → 0
    返回 列.大小();             // 函数返回后全局仍可达 → 0
}

// ② 写入面：出块后全局可写可读（写方法=不安全 函数内合法·926 同口径）
不安全 函数 遮蔽写入面() -> 整64 {
    {
        向量<整32> 列;          // 块内局部遮蔽
        结果<空类型, 整32> 局部写 = 列.追加(7);   // 写的是局部（遮蔽独立）
        如果 (!局部写.正常) { 返回 0 - 1; }
    }
    打印行(列.大小());          // 出块指全局 → 0（块内追加未写穿全局）
    结果<空类型, 整32> 全局写 = 列.追加(9);   // 写全局（不安全 函数内合法）
    如果 (!全局写.正常) { 返回 0 - 1; }
    打印行(列.大小());          // → 1
    返回 列.大小();
}

// ③ 同名异型：局部 整32 版遮蔽全局 整64 版（类型表须随绑定一并恢复）
函数 异型遮蔽面() -> 整64 {
    {
        向量<整32> 长列;        // 块内 整32 版（遮蔽全局 整64 版）
        打印行(长列.大小());    // 指内层 → 0
    }
    打印行(长列.大小());        // 出块恢复整64 全局 → 0
    返回 长列.大小();
}

// ④ 映射面（同族形态锁）
函数 映射遮蔽面() -> 整64 {
    {
        映射<整64, 整64> 表;    // 块内局部遮蔽
        打印行(表.大小());      // 0
    }
    打印行(表.大小());          // 0（出块恢复）
    返回 表.大小();
}

// ⑤ 集合面（同族形态锁）
函数 集合遮蔽面() -> 整64 {
    {
        集合<整64> 集;          // 块内局部遮蔽
        打印行(集.大小());      // 0
    }
    打印行(集.大小());          // 0（出块恢复）
    返回 集.大小();
}

函数 主() -> 整32 {
    打印行(造局部());           // 0 0 + 返回值 0
    打印行(遮蔽写入面());       // 0 1 + 返回值 1
    打印行(异型遮蔽面());       // 0 0 + 返回值 0
    打印行(映射遮蔽面());       // 0 0 + 返回值 0
    打印行(集合遮蔽面());       // 0 0 + 返回值 0
    返回 0;
}
