// H6 宿主缺陷根治 E2E（2026-08-25）：类方法引用参数（盒子& 其他）成员访问——
//   原 IR setupMethodParams 未设 byRef 标志，体内读取把"被引用变量地址"当对象
//   指针用（源.值 读到对象指针而非字段值）。H6 根治后引用参数按 byRef 语义
//   解引用（LoadPtr 得对象指针）。
// 覆盖：
//   1. 泛型类方法引用参数成员访问（从复制(盒子& 源) 深拷贝源数组）
//   2. 非泛型类引用参数成员访问
//   3. 方案A 拷贝构造（函数 盒子(盒子& 其他)）——初始化 乙 = 甲 与 赋值 深拷贝，
//      裸指针字段不共享（避免析构双释放 0xC0000374）
泛型 <类型 T>
类 盒子 {
公开:
    T* 数据
    整64 长度

    函数 盒子() {
        长度 = 0
        数据 = 无
    }

    // 方案A 拷贝构造：引用参数成员访问（H6 场景）
    函数 盒子(盒子& 其他) {
        长度 = 其他.长度
        数据 = 无
        如果 (其他.数据 != 无) {
            数据 = 分配(长度 * 8)
            整64 索引 = 0
            当 (索引 < 长度) {
                数据[索引] = 其他.数据[索引]
                索引++
            }
        }
    }

    函数 ~盒子() {
        如果 (数据 != 无) {
            释放(数据)
        }
    }

    // H6 原始场景：引用参数成员访问（从 源 深拷贝）
    函数 从复制(盒子& 源) {
        如果 (数据 != 无) {
            释放(数据)
        }
        长度 = 源.长度
        数据 = 无
        如果 (源.数据 != 无) {
            数据 = 分配(长度 * 8)
            整64 索引 = 0
            当 (索引 < 长度) {
                数据[索引] = 源.数据[索引]
                索引++
            }
        }
    }

    函数 追加(T 值) {
        数据 = 重新分配(数据, (长度 + 1) * 8)
        数据[长度] = 值
        长度++
    }

    函数 读取(整64 索引) -> T {
        返回 数据[索引]
    }

    函数 大小() -> 整64 {
        返回 长度
    }
}

// 非泛型类引用参数成员访问
类 简单盒 {
公开:
    整64 值
    函数 简单盒() {
        值 = 0
    }
    函数 从复制(简单盒& 源) {
        值 = 源.值
    }
}

函数 主() -> 整32 {
    盒子<整64> a
    a.追加(10)
    a.追加(20)
    a.追加(30)
    打印("a大小: ", a.大小())

    // 1. 泛型类方法引用参数成员访问
    盒子<整64> b
    b.从复制(a)
    打印("b大小: ", b.大小())
    打印("b[0]: ", b.读取(0))
    打印("b[2]: ", b.读取(2))

    // 2. 非泛型类引用参数成员访问
    简单盒 x
    x.值 = 7
    简单盒 y
    y.从复制(x)
    打印("y值: ", y.值)

    // 3a. 拷贝构造（初始化深拷贝）
    盒子<整64> c = a
    打印("c大小: ", c.大小())
    打印("c[1]: ", c.读取(1))

    // 3b. 拷贝构造（赋值深拷贝）
    盒子<整64> d
    d = a
    打印("d大小: ", d.大小())
    打印("d[2]: ", d.读取(2))

    // 独立验证：改 b 不影响 a（深拷贝，数组不共享）
    b.追加(99)
    打印("a大小 仍: ", a.大小())
    打印("b大小 变: ", b.大小())

    返回 0
}
