// E2E 945（2026-10-14·任务 #728u 锁面·P1）：枚举成员负值 MIN 文本——
//   数值文本 9223372036854775808（|整64 最小值|）超 int64 承载：宿主
//   parseIntValue std::stoll 超域抛异常静默回 0（输出 0 错值）；v2
//   数字文本转数值 不安全回绕得 MIN 位模式后，安全区「0 - 值」二次溢出
//   （错误码 8 自举中止·583 扫描 R1a 实证）。修后双侧两补码回绕口径
//   统一（v2 位模式取负474 / 宿主 stoll 回绕取负）：
//   -9223372036854775808 得整64 最小值（MIN 文本合法·常量折叠值=整64）。
// 锁定：MIN 文本编译通过 + 常量形态打印值正确（成员引用/显式 整64 转换）
//   + 自动递增 MIN+1=-(2^63-1) + 19 位 -MAX 文本 + 域内负值/正值健康对照
//   （759 同族零回归面）。
// 双编译对照：宿主+v2p 同源同测——退出码 0 + stdout 逐行全等。
枚举 极值 {
    甲 = -9223372036854775808,   // 整64 最小值（文本 |值|=2^63 超 int64 承载）
    乙,                          // 自动递增 = MIN+1 = -9223372036854775807
}
枚举 边界 {
    甲 = -9223372036854775807,   // -MAX（19 位文本·域内承载）
    乙,                          // -9223372036854775806
}
枚举 常规 {
    甲 = -1,                     // 域内负值健康对照（759 同族）
    乙,
    丙 = -100,
    丁,
}
枚举 正区 {
    甲 = 5,                      // 正值健康对照
    乙 = 9223372036854775807,    // 整64 最大值（域内承载）
}
函数 主() -> 整32 {
    打印(极值.甲);               // -9223372036854775808
    打印(极值.乙);               // -9223372036854775807
    打印(整64(极值.甲));          // -9223372036854775808（显式转换形态）
    打印(边界.甲);               // -9223372036854775807
    打印(边界.乙);               // -9223372036854775806
    打印(常规.甲);               // -1
    打印(常规.乙);               // 0
    打印(常规.丙);               // -100
    打印(常规.丁);               // -99
    打印(正区.甲);               // 5
    打印(正区.乙);               // 9223372036854775807
    返回 0;
}
