// E2E 878（双编译对照·632 销项·544 呈报形态④根治）：声明位右值=引用返回
//   函数调用的「值接收」——货架 甲 = 取货(源)（取货 返回 货架&）：
//   修前（探针矩阵双编译实况）：宿主 rc=134/139 崩——引用返回调用默认
//   lvalue-to-rvalue 解引用产物=源对象指针被兜底 Store 句柄直存：甲与源共享
//   同一堆对象，块出口双方析构同一句柄=free(): invalid pointer/段错误；v2
//   rc=0 但副本为空（调用点默认读值多解一层：对象首字段被当深拷源——
//   甲.记录.大小()=0）。修后（宿主 ir_stmt_decl_init 接管：抑制语境取被引用
//   左值地址+NewObject+拷贝构造深拷；v2 生成类尾 深拷源回扫）双侧同源同值：
//   甲=源的独立深拷副本、源保持拥有、块出口残留==0。
//   四形态（校验和折位·283/719/836 同款断言口径：块出口后 内存::活动分配数()
//   差值==0 且内容正确）：
//     ①引用返回+声明位接收 副本内容正确、残留==0 ……………………………位1
//     ②副本独立性（甲.记录.追加 后 甲=2/源=1·深拷非共享）………………位2
//     ③对照值返回+声明位 货架 乙 = 造货架()（458 面防回归）……………位4
//     ④同源两次取货两接收者互不影响（逐个独立深拷）……………………位8
//   退出码=校验和 15；v2 修前=①副本空/宿主崩 rc=134 双侧红。
导入 容器::向量;
类 货架 {
公开:
    向量<字符串> 记录;
    函数 货架() { 记录 = 向量<字符串>(); }
    函数 ~货架() { }
    不安全 函数 货架(货架& 其他) { 记录 = 其他.记录; }
}
函数 取货(货架& 源) -> 货架& {
    返回 源;
}
函数 造货架() -> 货架 {
    货架 临时;
    结果<空类型, 整32> r = 临时.记录.追加(字符串复制("造一"));
    返回 临时;
}
函数 主() -> 整32 {
    整32 校验 = 0;
    // ① 引用返回+声明位接收（本修核心形态）
    整64 b1 = 内存::活动分配数();
    整64 内1 = 0;
    {
        货架 源;
        结果<空类型, 整32> r1 = 源.记录.追加(字符串复制("取一"));
        货架 甲 = 取货(源);
        内1 = 甲.记录.大小();
    }
    如果 (内1 == 1 && 内存::活动分配数() - b1 == 0) { 校验 = 校验 + 1; }
    // ② 副本独立性：改甲不影响源（深拷非共享）
    整64 b2 = 内存::活动分配数();
    整64 甲2后 = 0;
    整64 源2后 = 0;
    {
        货架 源;
        结果<空类型, 整32> r2 = 源.记录.追加(字符串复制("独一"));
        货架 甲 = 取货(源);
        结果<空类型, 整32> r3 = 甲.记录.追加(字符串复制("独二"));
        甲2后 = 甲.记录.大小();
        源2后 = 源.记录.大小();
    }
    如果 (甲2后 == 2 && 源2后 == 1 && 内存::活动分配数() - b2 == 0) { 校验 = 校验 + 2; }
    // ③ 对照：值返回+声明位（458 面防回归）
    整64 b3 = 内存::活动分配数();
    整64 内3 = 0;
    {
        货架 乙 = 造货架();
        内3 = 乙.记录.大小();
    }
    如果 (内3 == 1 && 内存::活动分配数() - b3 == 0) { 校验 = 校验 + 4; }
    // ④ 同源两次取货两接收者独立（逐个独立深拷）
    整64 b4 = 内存::活动分配数();
    整64 独立性 = 0;
    {
        货架 源;
        结果<空类型, 整32> r4 = 源.记录.追加(字符串复制("双一"));
        货架 甲 = 取货(源);
        货架 乙 = 取货(源);
        结果<空类型, 整32> r5 = 甲.记录.追加(字符串复制("双二"));
        如果 (甲.记录.大小() == 2 && 乙.记录.大小() == 1 && 源.记录.大小() == 1) { 独立性 = 1; }
    }
    如果 (独立性 == 1 && 内存::活动分配数() - b4 == 0) { 校验 = 校验 + 8; }
    打印行("校验=", 校验);
    返回 校验;
}
