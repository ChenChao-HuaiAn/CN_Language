// 任务 123（930·用户裁决甲）：拷贝构造基类链——编译器负责继承部分、用户负责
// 自有字段（结构性根治：用户无法「忘记」拷基类·Rust 手写 Clone 须逐字段构造
// 全结构体的结构性保证同款）。〔基准=019〕第一句（零规则：不需知道基类内部）+
// 第四句（独立副本语义完备）。
// 覆盖形态：①子类用户拷贝构造×基类标量（修前基类字段静默清零 b.x=0）
//   ②多级混合链（祖定制复印+父层无构造字段+子用户体）③边界：基类定制复印×
//   子类隐式复印（修前自有字段清零 b.y=0·findCopyConstructor ownerClass 判据）
//   ④资源字段：基类字符串深拷（__cn_str_copy·析构对称零双释放）
//   ⑤隐式复印回归（无任何用户拷贝构造）
// C++ 对照：g++ 同款程序 b.x=5/b.y=107·t.a=11/t.b=2/t.c=103/b.x=105/b.y=7 全一致
// v2 侧：解析层显式拒绝类继承=既有设计（host-only·002/C24 欠账）
// 打印语义：打印=println（自动换行）

// ---- 形态①④共用：基类含标量+字符串字段 ----
类 动物 {
公开:
    整32 腿数;
    字符串 名字;
    函数 动物() { 腿数 = 4; 名字 = "旺财"; }
}
// 形态①④：子类用户拷贝构造（体只管自有字段）
类 狗 : 动物 {
公开:
    整32 叫次数;
    函数 狗() { 叫次数 = 3; }
    函数 狗(狗& 其他) { 叫次数 = 其他.叫次数 + 100; }
}

// ---- 形态②多级混合：祖定制复印+父层无拷贝构造+子用户体 ----
类 祖 {
公开:
    整32 a;
    函数 祖() { a = 1; }
    函数 祖(祖& 其他) { a = 其他.a + 10; 打印("[祖定制复印]"); }
}
类 父 : 祖 {
公开:
    整32 b;
    函数 父() { b = 2; }
}
类 子 : 父 {
公开:
    整32 c;
    函数 子() { c = 3; }
    函数 子(子& 其他) { c = 其他.c + 100; }
}

// ---- 形态③边界：基类定制复印×子类隐式复印（子类不写拷贝构造） ----
类 基乙 {
公开:
    整32 x;
    函数 基乙() { x = 5; }
    函数 基乙(基乙& 其他) { x = 其他.x + 100; 打印("[基乙定制复印]"); }
}
类 派乙 : 基乙 {
公开:
    整32 y;
    函数 派乙() { y = 7; }
}

// ---- 形态⑤隐式回归：无任何用户拷贝构造 ----
类 基丙 {
公开:
    整32 x;
    函数 基丙() { x = 5; }
}
类 派丙 : 基丙 {
公开:
    整32 y;
    函数 派丙() { y = 7; }
}


函数 主() -> 整32 {
    // 形态①④：用户拷贝构造——基类字段（标量+字符串）由编译器拷
    狗 a = 狗();
    狗 b = a;
    打印("①④: 腿数=", b.腿数, " 名字=", b.名字, " 叫次数=", b.叫次数);

    // 形态②：多级混合链
    子 s = 子();
    子 t = s;
    打印("②: a=", t.a, " b=", t.b, " c=", t.c);

    // 形态③：基类定制复印×子类隐式复印
    派乙 p = 派乙();
    派乙 q = p;
    打印("③: x=", q.x, " y=", q.y);

    // 形态⑤：隐式复印回归（无用户拷贝构造）
    派丙 m = 派丙();
    派丙 n = m;
    打印("⑤: x=", n.x, " y=", n.y);
    返回 0;
}
