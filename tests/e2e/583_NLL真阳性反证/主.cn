// E2E 583（980 轮·任务 007 NLL 真阳性反证矩阵·008 波7·〔基准=019〕第二句）：
//   分支合流改造后真转移形态仍必须拦截（may-moved=Rust E0382 同款）——
//   改造只收紧精度、不放宽拦截面：
//   ①分支内转移后同支再用（真阳性·修复前后均拦）
//   ②真支转移+无否则+合流后使用（may：真支可能执行=拦）
//   ③真支转移+否则支+合流后使用（may：任一路径转移即 moved）
//   ④循环体内转移后使用（循环体外声明·词法/数据流均拦）。
//   期望编译失败.txt 固化诊断子串「已转移」。
函数 甲(整32 节, 字符串 值) -> 整32 {
    字符串 w = "";
    如果 (节 == 1) {
        w = 转移(值);
        打印(值);
    }
    返回 0;
}

函数 乙(布尔 c) -> 整32 {
    字符串 v = "a";
    字符串 w = "";
    如果 (c) { w = 转移(v); }
    打印(v);
    返回 0;
}

函数 丙(布尔 c) -> 整32 {
    字符串 v = "a";
    字符串 w = "";
    如果 (c) { w = 转移(v); } 否则 { 打印("空"); }
    打印(v);
    返回 0;
}

函数 主() -> 整32 {
    字符串 s = "x";
    字符串 t = 转移(s);
    当 (t.大小() > 0) {
        打印(s);
    }
    返回 0;
}
