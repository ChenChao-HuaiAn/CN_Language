// 1399（1137 审查修复 P0-1/P0-2·用户令 #1076）：情况标签超条件类型域=
//   编译期拒绝（字面量超出上下文/目标类型表示范围即拒·Rust pattern 值不可
//   表示同口径；原「恒不匹配」静默语义废止）。
//   非双编译对照（宿主单侧负测）：v2 侧超条件域标签当前放行（比较不命中）——
//   双侧对齐另案（1137 报告已建议立案）；本用例锁宿主拒绝行为。
//   形态：①整64 条件 + 20 位值（999…9）②整32 条件 + 2147483648（i32 上界+1）
//   ③正64 条件 + 18446744073709551616（u64 上界+1）④字符条件 + 2147483648
//   （整32 上界+1·P0-C 甲案：字符条件标签域=整32 存储域，不设独立码点域）。
//   注：承载超域（2^127 等）见 1396（双侧同拒）；本用例面=承载域内但超
//   条件类型表示范围。
函数 主() -> 整32 {
    整64 甲 = 0;
    选择(甲) {
        情况 99999999999999999999:
            中断;
        默认:
            中断;
    }
    整32 乙 = 0;
    选择(乙) {
        情况 2147483648:
            中断;
        默认:
            中断;
    }
    正64 丙 = 0;
    选择(丙) {
        情况 18446744073709551616:
            中断;
        默认:
            中断;
    }
     字符 丁 = 'A';
    选择(丁) {
        情况 2147483648:
            中断;
        默认:
            中断;
    }
    返回 0;
}
