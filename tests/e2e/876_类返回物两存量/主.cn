// E2E 876（双编译对照·544 销项·458 呈报同根异面两存量缺陷）：v2 类返回物
//   两形态——赋值位右值=「返回类对象的调用」+ 声明位右值=「返回类对象的方法
//   调用（成员标记）」。三形态（校验和折位·每形态 值正确且块出口残留==0）：
//     ①赋值位·普通调用 甲 = 造货架()：v2 原落 472-a 调用物化直存——产物=调用
//       物化槽（调用方帧内栈地址）入甲槽 → 块出口按堆句柄释放栈地址
//       （free(): invalid pointer·探针 rc=134）；修后位拷物化接管（821 同款
//       NewObject+结构体拷贝+旧值释放）直存堆句柄。……………位1
//     ②赋值位·方法调用 甲 = 主仓.产()（被调=成员标记·同款接管）…………位2
//     ③声明位·方法调用 货架 乙 = 主仓.产()：v2 原落 发射类拷贝构造初始化 深拷
//       通道——产() 内源壳（连同字段容器数据数组+字符串，+2；壳 calloc 不计数）
//       失去唯一持有者成孤儿 → 残留 2（宿主 0）；修后 458 接管判定扩成员标记
//       形态（是返回类调用_544）→ 位拷物化直存。………………………………位4
//   断言口径（283/719/836 同款）：块出口后 内存::活动分配数() 差值==0 且内容
//   正确 → 置位；宿主/v2 双侧同源同值（退出码 7=全位；v2 修前=①③两态
//   rc≠宿主：① 崩 134/② 泄漏不置位）。
导入 容器::向量;
类 货架 {
公开:
    向量<字符串> 记录;
    函数 货架() { 记录 = 向量<字符串>(); }
    函数 ~货架() { }
    不安全 函数 货架(货架& 其他) { 记录 = 其他.记录; }
    函数 产() -> 货架 {
        货架 临时;
        结果<空类型, 整32> r = 临时.记录.追加(字符串复制("产一"));
        返回 临时;
    }
}
函数 造货架() -> 货架 {
    货架 临时;
    结果<空类型, 整32> r = 临时.记录.追加(字符串复制("造一"));
    返回 临时;
}
函数 主() -> 整32 {
    整32 校验 = 0;
    // ① 赋值位·普通调用 甲 = 造货架()
    整64 b1 = 内存::活动分配数();
    整64 内1 = 0;
    {
        货架 甲;
        甲 = 造货架();
        内1 = 甲.记录.大小();
    }
    如果 (内1 == 1 && 内存::活动分配数() - b1 == 0) { 校验 = 校验 + 1; }
    // ② 赋值位·方法调用 甲 = 主仓.产()
    整64 b2 = 内存::活动分配数();
    整64 内2 = 0;
    {
        货架 主仓;
        货架 甲;
        甲 = 主仓.产();
        内2 = 甲.记录.大小();
    }
    如果 (内2 == 1 && 内存::活动分配数() - b2 == 0) { 校验 = 校验 + 2; }
    // ③ 声明位·方法调用 货架 乙 = 主仓.产()（458 接管扩面·成员标记形态）
    整64 b3 = 内存::活动分配数();
    整64 内3 = 0;
    {
        货架 主仓;
        货架 乙 = 主仓.产();
        内3 = 乙.记录.大小();
    }
    如果 (内3 == 1 && 内存::活动分配数() - b3 == 0) { 校验 = 校验 + 4; }
    返回 校验;
}
