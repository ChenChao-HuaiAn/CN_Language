// E2E 1495_枚举类型名宽度全链对齐（#1393 锁用例·1022 采样轮 m08/m12/m16/m23 形态群）：
//   枚举类型=4 字节——IR布局尾.cn 类型名宽度 缺枚举分支（原 miss 落 查结构体
//   大小=0）与 类型大小与对齐 枚举 4/4 分支（IR布局.cn 279·宿主 enum=int 同款）
//   两表分叉根治：枚举数组元素步进 0（读 0 0 0）/类型大小(枚举) 折叠 0/类方法
//   返回枚举净栈契约违反/枚举数组形参 ABI 垃圾值 全链收敛。同族 #1327/#1129/#1203。
//   断言：步进 0 1 2·类型大小 4=4·方法返回 1·形参求和 3。
枚举 色 { 红, 绿, 蓝 }
函数 求和(色[3] 表) -> 整32 {
    返回 整32(表[0]) + 整32(表[1]) + 整32(表[2]);
}
类 持有 {
公开:
    函数 取() -> 色 { 返回 色.绿; }
}
函数 主() -> 整32 {
    打印(类型大小(色), " ", 类型大小(整32));
    色[3] 表 = {色.红, 色.绿, 色.蓝};
    打印(整32(表[0]), " ", 整32(表[1]), " ", 整32(表[2]));
    打印(求和(表));
    持有 h;
    打印(整32(h.取()));
    返回 0;
}
