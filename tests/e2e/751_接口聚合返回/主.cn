// E2E 751_接口聚合返回（413-b 审查 P0-2 锁定；489 撞号改号让位，原号 716）：接口方法聚合返回（结构体）
//   ——宿主实测绿（x:3 y:4），修前 v2 硬拒「暂不支持」=分叉。
//   覆盖：单一实现（去虚拟化直调 retbuf）/ 多实现（间接分派 retbuf·三后端
//   IR_间接调用 类型位形态）/ 结果通道。
结构体 点 {
    整32 x;
    整32 y;
}
接口 提供点 {
    虚拟 函数 取点() -> 点;
}
接口 提供原点 {
    虚拟 函数 取原点() -> 点;
}
类 坐标 : 提供点 {
公开:
    函数 坐标() { }
    重写 函数 取点() -> 点 {
        返回 点{ x = 3, y = 4 };
    }
}
类 原点器 : 提供原点 {
公开:
    函数 原点器() { }
    重写 函数 取原点() -> 点 {
        返回 点{ x = 0, y = 0 };
    }
}
类 双点 : 提供点 {
公开:
    函数 双点() { }
    重写 函数 取点() -> 点 {
        返回 点{ x = 30, y = 40 };
    }   // 提供点 第二实现——间接分派面
}
函数 主() -> 整32 {
    打印("===== 接口聚合返回 =====");
    坐标 对象 = 坐标();
    提供点 供1 = 对象;
    点 值1 = 供1.取点();                    // 单一实现→直调 retbuf
    打印("直调 x:", 值1.x, " y:", 值1.y);   // 3 4
    双点 对象2 = 双点();
    提供点 供2 = 对象2;
    点 值2 = 供2.取点();                    // 多实现→间接 retbuf
    打印("间接 x:", 值2.x, " y:", 值2.y);   // 30 40
    点 值3 = 供1.取点();                    // 直调再取（链内互扰校验）
    打印("复取 x:", 值3.x, " y:", 值3.y);   // 3 4
    原点器 对象3 = 原点器();
    提供原点 供3 = 对象3;
    点 值4 = 供3.取原点();                  // 另一接口聚合
    打印("另接口 x:", 值4.x, " y:", 值4.y); // 0 0
    打印("===== 完成 =====");
    返回 0;
}
