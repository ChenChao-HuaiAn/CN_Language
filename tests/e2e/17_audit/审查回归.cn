// 审查回归（Debug 审查 Task 2.9/2.10）：覆盖发现并修复的 codegen 运行时 BUG
// 覆盖：
//   1. i128 拼接（值域内）不再 LoadPtr 解引用崩溃（BUG#1）
//   2. 字符串变量 + i128 拼接后指针算术解引用元素类型正确（解引用元素类型 BUG）
//   3. 负浮点常量位模式（-3.75）以字母开头十六进制加前导0（BUG#4）
//   4. 无符号字面量超位宽提升（正32 -> 正64）（BUG#5）
//   5. 浮 -> i128 截断（BUG#6）
//   6. i128 -> i128 同类型转换（BUG#7）
//   7. 布尔 -> 整数 显式转换（BUG#2）
函数 主() -> 整32 {
    // 1. i128 值域内拼接（原 LoadPtr 崩溃）
    整128 小大数 = 1234567890123LL;
    打印("i128拼接: ", "大=" + 小大数);

    // 2. 字符串变量 + i128 拼接 后 指针算术解引用
    字符串 s1 = "a" + 1 + 2;
    打印("左结合: ", s1);
    字符串释放(s1);
    整128 大数 = 123456789012345678901LL;
    打印("超范围拼接: ", "大=" + 大数);
    整32[3] 数据 = {10, 20, 30};
    整32* q = 数据;
    打印("指针算术解引用: ", *(q + 1));

    // 3. 负浮点常量（位模式以 C 开头，需前导 0）
    整128 负转 = 整128(-3.75);
    打印("负浮转i128: ", 负转);

    // 4. 无符号字面量超位宽提升（正32 -> 正64，值域 2^32 ~ 2^63 内验证）
    正64 大无符号 = 5000000000U;
    打印("无符号提升: ", 大无符号);

    // 5. 浮 -> i128 截断
    整128 截断128 = 整128(3.75);
    打印("浮截断i128: ", 截断128);

    // 6. i128 -> i128 同类型（LL 后缀即 i128）
    整128 同型 = 整128(1234567890123456789LL);
    打印("同型转换: ", 同型);

    // 7. 布尔 -> 整数
    打印("真转i32: ", 整32(真));
    打印("假转i64: ", 整64(假));

    // 8. 显式捕获无参 lambda（BUG#3）
    整32 外层 = 100;
    自动 读取 = [外层] { 返回 外层 + 1; };
    打印("显式捕获无参: ", 读取());

    返回 0;
}
