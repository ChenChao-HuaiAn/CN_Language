// 686（#381 四层根治锁用例·2026-10-10 深度机）：类指针字段全家——
//   ①指针字段=形参 写（标量通道 8 字节直存·防 346-a 误发值类深拷链接缺拷贝构造）
//   ②指针字段 自动解引用 方法调用（叶.读值()·防分派剥星缺失静默丢调用返回 0）
//   ③方法体 裸指针字段 链根 二级链（树.键们 形态·防 510-a 漏解引用段错误）
//   ④含指针字段类 析构不释放所指（防级联析构 UAF·valgrind free'd 块铁证家族）
//   ⑤宿主/v2 双侧同测（dual·期望值内嵌）
类 节点N {
公开:
    整64 值;
    函数 节点N() {
        值 = 0;
    }
    函数 读值() -> 整64 {
        返回 值;
    }
    函数 写值(整64 v) -> 空类型 {
        值 = v;
    }
}
类 容器C {
公开:
    整64 头;
    节点N* 挂;          // 指针字段（②③④⑤ 面）
    函数 容器C() {
        头 = 0 - 1;
        挂 = 无;
    }
    不安全 函数 ~容器C() {
    }
    不安全 函数 经挂读() -> 整64 {
        返回 挂.读值();          // ② 裸指针字段 自动解引用方法调用
    }
    不安全 函数 经挂写(整64 v) -> 空类型 {
        挂.写值(v);
    }
}
类 链根 {
公开:
    容器C* 内;           // 类指针字段（③ 面·字段.字段 链）
    函数 链根() {
        内 = 无;
    }
    不安全 函数 ~链根() {
    }
    不安全 函数 读内头() -> 整64 {
        返回 内.头;              // ③ 指针字段 链中间跳 字段读
    }
}
不安全 函数 主() -> 整32 {
    节点N n = 节点N();
    容器C c = 容器C();
    c.挂 = &n;                   // ① 指针字段写=形参同构（取地址）
    c.经挂写(42);
    整64 甲 = c.经挂读();
    n.值 = 7;
    整64 乙 = c.挂.读值();        // ② 变体：表达式位 自动解引用
    链根 r = 链根();
    r.内 = &c;
    整64 丙 = r.读内头();         // ③ 链中间跳
    打印("甲=" + 整数转字符串(甲) + " 乙=" + 整数转字符串(乙) + " 丙=" + 整数转字符串(丙) + "\n");
    返回 0;
}
