// 692 字符串操作面（§1638 行立法：==/!= 内容比较·</<=/>/>= 字典序；§253 拼接隐式转换）
// 期望手算："abc"=="abc" 真；"abc"!="abd" 真；"abc"<"abd" 真；"b">="ab" 真（字典序首字符）
//   拼接链 "n="+5+" b="+真 → "n=5 b=真"（§253：整数/布尔右操作数隐式转字符串）
//   空串 ""=="" 真
函数 主() -> 整32 {
    打印("abc" == "abc" ? 1 : 0);     // 1
    打印("abc" != "abd" ? 1 : 0);     // 1
    打印("abc" < "abd" ? 1 : 0);      // 1
    打印("b" >= "ab" ? 1 : 0);        // 1
    字符串 句 = "n=" + 5 + " b=" + 真;
    打印(句);                          // n=5 b=真
    打印("" == "" ? 1 : 0);           // 1
    返回 0;
}
