// E2E 216_v2（2026-09-11 第七十三轮·73-a 方案A 用户裁决·内存安全回归）：
//   v2 侧**块级作用域 RAII** 与**循环跳出 drop-on-jump** 的运行级防线
//   （宿主 E2E 213 的 v2 对应件）。
//   立案背景（探针 89/90/91 量化实证）：v2 两枚缺陷——
//     ①预扫在函数体生成前一次性登记释放名单，而 生成块 入口取基线（名单大小），
//       基线恒等于名单=块出口析构永远无新增项可释放 → v2 块级 RAII **从未生效**；
//     ②中断/继续 只发跳转、不做 drop-on-jump（宿主 72-a 已实现）。
//   两者叠加：循环体/如果体内声明的拥有串与容器每轮累积（20 万轮循环残留
//   199999，30000 轮 × 14.4KB 探针泄漏上限 411MB → OOM）。
//   修复（方案A）：预扫职责收敛为槽分配+入口零初始化+类型登记，释放名单登记
//   移至生成期（生成变量声明/生成容器局部）；中断/继续 跳出前按最近循环体
//   基线发射释放（编译期名单不截断——同块其他路径仍须各自发射释放）。
//   断言口径：每形态调用前后 内存::活动分配数() 差值恒 0（宿主 213 同款），
//   叠加内容正确性校验（释放未生效=泄漏、释放过度/错位=内容损坏或崩溃）。
//   校验和折位：①1 ②2 ③4 ④8 ⑤16 ⑥32 ⑦64 —— 127=全对。
导入 容器::向量;

// ① 循环体内拥有串 + 继续（跳出路径 drop-on-jump：每轮声明后立即跳出）
函数 继续路径(整64 轮数) -> 整64 {
    整64 i = 0;
    整64 累计 = 0;
    当 (i < 轮数) {
        字符串 每轮 = 字符串复制("继续路径循环体拥有串占位内容甲乙丙丁戊己庚辛");
        累计 = 累计 + 字符串长度(每轮);
        i++;
        继续;
    }
    返回 累计;
}

// ② 循环体内拥有串 + 中断（跳出路径，中断发生在第二轮；首轮自然回边）
函数 中断路径(整64 轮数) -> 整64 {
    整64 轮次 = 0;
    当 (轮次 < 轮数) {
        字符串 每轮 = 字符串复制("中断路径循环体拥有串占位内容甲乙丙丁戊己庚辛");
        如果 (轮次 >= 2) { 中断; }
        轮次++;
    }
    返回 轮次;
}

// ③ 循环体内拥有串 + 自然回边（块出口析构：无跳出语句的基线形态）
函数 自然回边(整64 轮数) -> 整64 {
    整64 i = 0;
    整64 累计 = 0;
    当 (i < 轮数) {
        字符串 每轮 = 字符串复制("自然回边循环体拥有串占位内容甲乙丙丁戊己庚辛");
        累计 = 累计 + 字符串长度(每轮);
        i++;
    }
    返回 累计;
}

// ④ 如果体内拥有串（无跳出的嵌套块——预扫登记失效的最纯粹形态）
函数 如果体(整64 轮数) -> 整64 {
    整64 i = 0;
    当 (i < 轮数) {
        如果 (i >= 0) {
            字符串 体内 = 字符串复制("如果体内拥有串占位内容甲乙丙丁戊己庚辛壬癸");
        }
        i++;
    }
    返回 i;
}

// ⑤ 循环体内容器 + 继续（对象析构同族：释放路径须覆盖容器）
函数 容器跳出(整64 轮数) -> 整64 {
    整64 i = 0;
    当 (i < 轮数) {
        向量<整64> 表 = 向量<整64>();
        结果<空类型, 整32> 加 = 表.追加(i);
        i++;
        继续;
    }
    返回 i;
}

// ⑥ 循环体嵌套块内拥有串（内层块出口与循环基线两层都须正确）
函数 嵌套块(整64 轮数) -> 整64 {
    整64 i = 0;
    当 (i < 轮数) {
        {
            字符串 深块 = 字符串复制("循环内嵌套块拥有串占位内容甲乙丙丁戊己庚辛壬");
        }
        i++;
    }
    返回 i;
}

// ⑦ 循环体内拥有串 + 继续 + 内容校验（释放正确性：跳过后串仍可读，且下轮重新拥有）
函数 内容校验(整64 轮数) -> 整64 {
    整64 i = 0;
    整64 命中 = 0;
    当 (i < 轮数) {
        字符串 每轮 = 字符串复制("内容校验拥有串占位内容甲乙丙丁戊己庚辛壬癸子丑寅");
        如果 (字符串长度(每轮) == 72) { 命中 = 命中 + 1; }
        i++;
        继续;
    }
    返回 命中;
}

函数 主() -> 整32 {
    整32 校验 = 0;
    // ①
    整64 基1 = 内存::活动分配数();
    整64 甲 = 继续路径(20000);
    如果 (甲 == 20000 * 66 && 内存::活动分配数() == 基1) { 校验 = 校验 + 1; }
    // ②
    整64 基2 = 内存::活动分配数();
    整64 乙 = 中断路径(20000);
    如果 (乙 == 2 && 内存::活动分配数() == 基2) { 校验 = 校验 + 2; }
    // ③
    整64 基3 = 内存::活动分配数();
    整64 丙 = 自然回边(20000);
    如果 (丙 == 20000 * 66 && 内存::活动分配数() == 基3) { 校验 = 校验 + 4; }
    // ④
    整64 基4 = 内存::活动分配数();
    整64 丁 = 如果体(20000);
    如果 (丁 == 20000 && 内存::活动分配数() == 基4) { 校验 = 校验 + 8; }
    // ⑤
    整64 基5 = 内存::活动分配数();
    整64 戊 = 容器跳出(20000);
    如果 (戊 == 20000 && 内存::活动分配数() == 基5) { 校验 = 校验 + 16; }
    // ⑥
    整64 基6 = 内存::活动分配数();
    整64 己 = 嵌套块(20000);
    如果 (己 == 20000 && 内存::活动分配数() == 基6) { 校验 = 校验 + 32; }
    // ⑦
    整64 基7 = 内存::活动分配数();
    整64 庚 = 内容校验(5000);
    如果 (庚 == 5000 && 内存::活动分配数() == 基7) { 校验 = 校验 + 64; }
    返回 校验;
}
