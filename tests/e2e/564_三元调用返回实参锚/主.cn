// p263tmp_d（263① 探针·临时不入库）：三元操作数=借用读（真 ? 表.元素(0) : 表.元素(1)）。
//   复合面：三元聚合物化 × 容器方法返回物化临时（元素() 独立槽副本）叠加——
//   两套临时机制嵌套时是否双漏/错值。拆步打印定位：10/20=追加失败 31/32=直读值错位
//   40=三元复合值错（打印实际值）2=绿；1=泄漏。
导入 容器::向量;

结构体 盒子 {
    字符串 名;
    整32 号;
}

函数 挑选号(盒子 输入) -> 整32 {
    返回 输入.号;
}

函数 形探() -> 整64 {
    整64 前 = 内存::活动分配数();
    {
        向量<盒子> 表 = 向量<盒子>();
        结果<空类型, 整32> 加 = 表.追加(盒子{ 名 = 字符串复制("P263D甲"), 号 = 5 });
        如果 (!加.正常) { 返回 10; }
        加 = 表.追加(盒子{ 名 = 字符串复制("P263D乙"), 号 = 6 });
        如果 (!加.正常) { 返回 20; }
        盒子 抄零 = 表.元素(0);
        盒子 抄乙 = 表.元素(1);
        如果 (抄零.号 != 5) { 返回 31; }
        如果 (抄乙.号 != 6) { 返回 32; }
        整32 号 = 挑选号(真 ? 表.元素(0) : 表.元素(1));
        如果 (号 != 5) { 打印(号); 返回 40; }
    }
    如果 (内存::活动分配数() != 前) { 返回 1; }
    返回 2;
}

函数 主() -> 整32 {
    打印(形探());
    返回 0;
}
