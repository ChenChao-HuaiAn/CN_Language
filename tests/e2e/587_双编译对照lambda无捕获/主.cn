// 587_双编译对照lambda无捕获（070 波B·1022 深度机）：无捕获 lambda 全链矩阵
//   规范 plans/001「lambda 表达式」：[捕获](参数) [-> 返回] { 体 }。
//   v2 落地=脱糖合成函数 ?lambdaN + 表达式占位（负占位链→IR_函数地址）+
//   推断变量（函数指针<返回>(参数) 类型文本）+ 间接调用链（T69 480-a 通道）。
//   覆盖：显式返回/单返回推导/无参/多参/整128 参数/实参位直接传递/返回值链。
//   捕获形态（[=]/[&]/[变量]）v2 暂拒绝=欠账登记（021 #070 波B 后续）——
//   宿主支持而 v2 拒绝为真分叉缺口，不作负测用例（禁「双侧都拒」假锚）。
函数 应用(整32(*处理)(整32)) -> 整32 {
    返回 处理(5);
}

函数 主() -> 整32 {
    // 1. 显式返回类型
    变量 加倍 = [](整32 x) -> 整32 { 返回 x * 2; };
    打印(加倍(21));                      // 42

    // 2. 单一返回推导（无 -> 标注）
    变量 平方 = [](整32 x) { 返回 x * x; };
    打印(平方(7));                       // 49

    // 3. 无参 lambda
    变量 说好 = [] { 返回 100; };
    打印(说好());                        // 100

    // 4. 多参
    变量 加 = [](整32 甲, 整32 乙) -> 整32 { 返回 甲 + 乙; };
    打印(加(3, 4));                      // 7

    // 5. 整128 参数 lambda=登记欠账（间接调用点直传寄存器 vs 合成函数序言
    //    指针解引用=ABI 分叉·T53/440 家系残余·021 #070 波B 后续）

    // 6. 实参位直接传递（不经变量）
    整32 经传 = 应用([](整32 x) -> 整32 { 返回 x + 10; });
    打印(经传);                          // 15

    返回 0;
}
