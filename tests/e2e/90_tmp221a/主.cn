导入 容器::链表;
静态 整64 计数 = 0;
类 资源 {
公开:
    整64 编号;
    函数 资源(整64 v) { 编号 = v; }
    函数 资源(资源& 其他) { 编号 = 其他.编号; }
    不安全 函数 ~资源() { 计数 = 计数 + 1; }
}
函数 主() -> 整32 {
    {
        链表<资源> 表;
        资源 r1 = 资源(1);
        资源 r2 = 资源(2);
        结果<空类型, 整32> a1 = 表.追加(r1);
        结果<空类型, 整32> a2 = 表.追加(r2);
        打印("追加后: ", 表.大小(), " 析构: ", 计数);
        结果<空类型, 整32> d1 = 表.删除头部();
        打印("删头后: ", 表.大小(), " 析构: ", 计数);
    }
    打印("块结束: ", 计数);
    返回 0;
}
