// #1581 正例：Unicode 转义合法形态（NUL 码点 0 走正常通道 + 前导零）——
//   字符 '\u{0}'=0（合法 NUL 码点；结果化后 0 只在正常通道）/ '\u{0041}'=65；
//   字符串 "\u{0}"=NUL 截断（#1310）+ "\u{000042}"="B"。
//   同一源码宿主与 v2 各编各跑，退出码须一致（15=1+2+4+8）。
函数 主() -> 整32 {
    字符 零 = '\u{0}';
    字符 甲 = '\u{0041}';
    字符串 空 = "\u{0}";
    字符串 乙 = "\u{000042}";
    整64 校验 = 0;
    如果 (整32(零) == 0) { 校验 += 1; }
    如果 (整32(甲) == 65) { 校验 += 2; }
    如果 (字符串长度(空) == 0) { 校验 += 4; }
    如果 (字符串比较(乙, "B")) { 校验 += 8; }
    打印("校验和=", 校验);
    返回 整32(校验);
}
