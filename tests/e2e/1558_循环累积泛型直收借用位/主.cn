// 1558 循环累积泛型直收借用位（任务 1549·双编译对照）
//   覆盖泛型单态化实例**直收**（接收者=标识符 `盒.取(…)`）两形态：
//   ① 值形参 `盒.取(s)`：模板方法签名判引用位 → 非引用位不抑制（优化=1）；
//   ② 引用形参 `盒.记(槽, s2)`：取地址逃逸 → 抑制累积提升（S2=yWyW）。
//   病：202 标识符分支查类方法表 miss（语义期实例合成名未登记用户类）→ 保守
//   登记全部标识符实参根 → 值形参也抑制（v2 优化=0 宿主=1）。
//   修：泛型模板基类方法签名精确借用位（与成员链接收者同一单点）。
结构体 盒 {
    字符串* 指;
}

泛型 <类型 T>
类 盒器 {
公开:
    T 值;
    函数 盒器() { }
    函数 取(字符串 参) -> 整64 { 返回 字符串长度(参); }
    函数 记(盒& 槽, 字符串& 参) -> 整32 {
        槽.指 = &参;
        返回 0;
    }
}

不安全 函数 写改(盒& 目标, 字符串 段) -> 整32 {
    *目标.指 = *目标.指 + 段;
    返回 0;
}

不安全 函数 主() -> 整32 {
    字符串 s = "";
    盒器<整64> 盒 = 盒器<整64>();
    盒.取(s);
    整64 前 = 内存::总分配次数();
    循环 (整64 k = 0; k < 2048; k++) {
        s = s + "x";
    }
    整64 次 = 内存::总分配次数() - 前;
    打印("长=", 整数转字符串(字符串长度(s)));
    布尔 降 = 次 <= 6;
    如果 (降) { 打印("泛型直收优化=1"); } 否则 如果 (次 > 6) {
        打印("泛型直收优化=0 次=", 整数转字符串(次));
    }
    字符串 s2 = "";
    盒 槽 = 盒{ 指 = 无 };
    盒器<整64> 盒2 = 盒器<整64>();
    盒2.记(槽, s2);
    循环 (整64 j = 0; j < 2; j++) {
        s2 = s2 + "y";
        写改(槽, "W");
    }
    打印("S2=", s2);
    返回 0;
}
