// E2E 889（569 配套·2026-10-14·§747 安全区边界表第 8 条「可变静态/全局变量
//   写」措辞扩展锁面）：安全函数内写可变全局=编译错误（Rust static mut 对照
//   的安全区纪律同构）——赋值/复合赋值/自增自减 三形态同档全拒；读取无限制。
//   同一源码宿主+v2p 都必须编译拒绝（诊断锚=[安全区边界]·双侧同文案）。
//   执法面=两侧静态名集合（宿主 globalStatics_/v2 全局静态名ID们——裸全局
//   与顶层静态同表登记·569 复用通道）。
整32 全局计数 = 5;

函数 违规写() {
    全局计数 = 6;          // 赋值=拒
    全局计数 += 1;         // 复合赋值=拒
    全局计数++;            // 自增=拒
}

函数 主() -> 整32 {
    返回 全局计数;          // 读安全（不写=不触执法面）
}
