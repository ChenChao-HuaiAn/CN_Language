// E2E 1728（字符串组合前缀单引号内容·内容级矩阵）：组合前缀「原始多行」
//   单引号形态与三引号形态的长度+下标字节级断言（禁只验证编译过）。
//   病面：原始多行"P\nQ" 单引号组合形态宿主 IR decodeString 曾按「多行」
//   前缀强制假设三引号，单引号形态落「保留原文」分支把首尾引号吞进内容
//   （宿主 6 字节 vs v2 4 字节分叉实录）——修复后剥壳方式由源码引号形态
//   决定（001 §2.1a 四形态·2026-09-14 关键字审计裁决原文即单引号组合
//   形态；v2 分词 417 同款）。681 四形态矩阵补此盲区（其组合面仅三引号）。
函数 主() -> 整32 {
    // 组合·单引号·raw（病面形态）：\n 两个字符原样（\=92 n=110），无引号混入
    变量 甲 = 原始多行"P\nQ";
    打印("甲长度=", 字符串长度(甲));
    打印("甲0=", 甲[0]);
    打印("甲1=", 甲[1]);
    打印("甲2=", 甲[2]);
    打印("甲3=", 甲[3]);
    // 组合·三引号·raw·跨行+内嵌引号：内容原样（真实换行收录·引号自由）——
    //   丙[3]=第二个双引号字节（说=3字节+引号）·字符串下标=字节索引
    变量 丙 = 原始多行"""说"嗨"
了""";
    打印("丙长度=", 字符串长度(丙));
    打印("丙3=", 丙[3]);
    // 多行·单引号·解码：转义生效（多行前缀遇单引号=降级单行·v2 417 同款）
    变量 丁 = 多行"A\nB";
    打印("丁长度=", 字符串长度(丁));
    // 多行·三引号·解码·跨行
    变量 戊 = 多行"""X
Y""";
    打印("戊长度=", 字符串长度(戊));
    // 原始·单引号·raw（回归护栏）
    变量 己 = 原始"P\nQ";
    打印("己长度=", 字符串长度(己));
    // 普通·单引号·解码（回归护栏）
    变量 庚 = "P\nQ";
    打印("庚长度=", 字符串长度(庚));
    返回 0;
}
