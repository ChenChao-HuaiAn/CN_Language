导入 容器::队列;
静态 整64 计数 = 0;
类 资源 {
公开:
    整64 编号;
    函数 资源(整64 v) { 编号 = v; }
    函数 资源(资源& 其他) { 编号 = 其他.编号; }
    不安全 函数 ~资源() { 计数 = 计数 + 1; }
}
函数 主() -> 整32 {
    打印("[S1] 入口");
    {
        队列<资源> 表;
        资源 q1 = 资源(1);
        资源 q2 = 资源(2);
        资源 q3 = 资源(3);
        打印("[S3] 构造完");
        结果<空类型, 整32> e1 = 表.入队(q1);
        结果<空类型, 整32> e2 = 表.入队(q2);
        结果<空类型, 整32> e3 = 表.入队(q3);
        打印("[S4] 入队完 大小: ", 表.大小());
        结果<资源, 整32> 出 = 表.出队();
        打印("[S5] 出队完 正常: ", 出.正常, " 大小: ", 表.大小());
    }
    打印("[S7] 块出口 计数: ", 计数);
    返回 0;
}
