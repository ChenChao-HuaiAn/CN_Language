// E2E 655（280 轮·结构体载荷结果盒布局守卫锚）：结果<40B 结构体,整32> 盒——
//   预降级趟（第一趟f）即时布局时载荷结构体尚未布局（totalSize=0），载荷
//   typeSizeOf 走「未知防御 8」→ 合成体 totalSize 固化 16 → retbuf→盒
//   CopyStruct 截断、值.后段字段读栈垃圾（t2 探针铁证 f2/f4 垃圾值）。
//   修=载荷真值守卫（computeLayout 特判：载荷未布局不固化·交第一趟b 统一
//   布局重算·幂等守卫不再拦死真值）。断言=三段位字段全对+千轮零泄漏。
//   dual 判据：宿主/v2 双侧编跑同输出（布局单点事实源=读写双口径归一）。
结构体 大载荷 {
    整64 f1;
    整64 f2;
    整64 f3;
    整64 f4;
    整64 f5;
}

函数 造盒(整64 标) -> 结果<大载荷, 整32> {
    大载荷 d;
    d.f1 = 标;
    d.f2 = 标 + 1;
    d.f3 = 0;
    d.f4 = 7;
    d.f5 = 0;
    返回 正常(d);
}

函数 主() -> 整32 {
    整64 前 = 内存::活动分配数();
    整32 i = 0;
    当 (i < 1000) {
        结果<大载荷, 整32> 盒 = 造盒(111);
        如果 (盒.正常) {
            如果 (盒.值.f1 != 111) { 打印(0); 返回 0; }
            如果 (盒.值.f2 != 112) { 打印(0); 返回 0; }
            如果 (盒.值.f4 != 7) { 打印(0); 返回 0; }
        } 否则 {
            打印(0);
            返回 0;
        }
        i++;
    }
    如果 (内存::活动分配数() != 前) { 打印(1); 返回 0; }
    打印(7);
    返回 0;
}
