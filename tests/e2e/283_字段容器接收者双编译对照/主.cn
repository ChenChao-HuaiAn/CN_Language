// E2E 283（双编译对照，2026-09-15 第二百零四轮 204-a·波 3 ⑤ H7/H11 收口销项）：
//   **字段容器接收者**（`甲.记录.追加(值)`——接收容器为类对象的字段容器）入容器位
//   的所有权归一化全来源形态锚定。B35 靶子（78-a 登记「保守复制分支残留」）经
//   波 3 设施（139~143 容器字段三件套 + 180-a 甲通道 + 183-a 用户类字段泛化）
//   事实上收口：字段容器具备完整 drop glue（出口释放/拷贝深拷/preFree）后，
//   拥有契约接管（②调用返回）/真 move（①转移）零残留；值语义（⑤拥有局部=复制、
//   源照常拥有）与驻留（④字面量）同为零残留。
//   断言口径（213/230 同款「门禁替你记得」）：每形态块内 前后 内存::活动分配数()
//   差值（残留）恒为 0 → 折校验和 31=①1+②2+③4+④8+⑤16；宿主/v2 双侧同源同值。
导入 容器::向量;
类 货架 {
公开:
    向量<字符串> 记录;
    函数 货架() { 记录 = 向量<字符串>(); }
    函数 ~货架() { }
}
函数 造串() -> 字符串 {
    返回 字符串复制("返回串");
}
函数 主() -> 整32 {
    整32 校验 = 0;
    // ① 真 move 入字段容器（转移(拥有局部)：句柄直存 + 源槽清零）
    整64 b1 = 内存::活动分配数();
    {
        货架 甲;
        字符串 值 = 字符串复制("数据");
        结果<空类型, 整32> r = 甲.记录.追加(转移(值));
    }
    如果 (内存::活动分配数() - b1 == 0) { 校验 = 校验 + 1; }
    // ② 值语义复制入字段容器（字符串复制=拥有返回接管给追加位）
    整64 b2 = 内存::活动分配数();
    {
        货架 甲;
        结果<空类型, 整32> r = 甲.记录.追加(字符串复制("直填"));
    }
    如果 (内存::活动分配数() - b2 == 0) { 校验 = 校验 + 2; }
    // ③ 调用返回（拥有契约）入字段容器：接管零拷贝
    整64 b3 = 内存::活动分配数();
    {
        货架 甲;
        结果<空类型, 整32> r = 甲.记录.追加(造串());
    }
    如果 (内存::活动分配数() - b3 == 0) { 校验 = 校验 + 4; }
    // ④ 字面量入字段容器：驻留借用（释放侧空安全）
    整64 b4 = 内存::活动分配数();
    {
        货架 甲;
        结果<空类型, 整32> r = 甲.记录.追加("字面量");
    }
    如果 (内存::活动分配数() - b4 == 0) { 校验 = 校验 + 8; }
    // ⑤ 拥有局部入字段容器：值语义复制（源照常拥有并释放）
    整64 b5 = 内存::活动分配数();
    {
        货架 甲;
        字符串 局部 = 字符串复制("局部串");
        结果<空类型, 整32> r = 甲.记录.追加(局部);
    }
    如果 (内存::活动分配数() - b5 == 0) { 校验 = 校验 + 16; }
    返回 校验;
}
