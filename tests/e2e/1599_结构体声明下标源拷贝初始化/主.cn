// E2E 1599（任务 1739）：结构体声明拷贝初始化·源形态矩阵（宿主+v2 双侧同测）
// 缺陷：v2 生成结构体局部 声明初始化源白名单（调用/标识符/成员/三元/结构体
//   构造）缺 节点_下标 → [ir2]「结构体整体初始化暂不支持」误拒；宿主 genExpr
//   对结构体下标读=元素地址（表达式值=地址约定）→ tryGenStructPtrInit 整块拷
//   两侧分叉。根治=白名单补下标形态（与成员第三形态同构：生成表达式 压元素
//   地址 → 发射结构体整体拷贝·深拷口径）。
// 矩阵断言面（已写值源·001 §10.6 打印=末尾自动换行）：
//   ①标识符源 ②调用源 ③下标源（1739 修复面）④成员源（结构体字段）
//   ⑤嵌套成员链下标源（外.路[2]）⑥构造字面量源 ⑦独立副本（改备份不回写源）
// 三元源=86-a 锁面、重载二元=936 锁面、结构体方法=001 §4.4 双侧同拒（不
//   入本矩阵）；未写元素读取面（宿主读 0 / v2 E0381 拒）属 def-init 执法
//   分叉另行呈报，不入本用例。
结构体 点 {
    整32 x;
    整32 y;
}
结构体 外壳 {
    点 内;
    点[3] 路;
}
函数 造点(整32 甲, 整32 乙) -> 点 {
    点 p;
    p.x = 甲;
    p.y = 乙;
    返回 p;
}
函数 主() -> 整32 {
    // ① 标识符源
    点 a = 造点(1, 2);
    点 b = a;
    打印(b.x);
    打印(b.y);
    // ② 调用源
    点 c = 造点(3, 4);
    打印(c.x);
    打印(c.y);
    // ③ 下标源（1739 修复面·已写值源非零拷贝）
    点[3] 路;
    路[1] = 造点(5, 6);
    点 d = 路[1];
    打印(d.x);
    打印(d.y);
    // ④ 成员源（结构体字段=结构体）
    外壳 外;
    外.内 = 造点(7, 8);
    点 e = 外.内;
    打印(e.x);
    打印(e.y);
    // ⑤ 嵌套成员链下标源（同走节点_下标末端）
    外.路[2] = 造点(9, 10);
    点 f = 外.路[2];
    打印(f.x);
    打印(f.y);
    // ⑥ 构造字面量源
    点 g = 点{ x = 11, y = 12 };
    打印(g.x);
    打印(g.y);
    // ⑦ 独立副本（改 备份 不回写 路[1]）
    点 备份2 = 路[1];
    备份2.x = 100;
    打印(路[1].x);
    // ⑧ 循环非常量下标成员写+声明下标源（z5 形态·1739 第三缺锚定：
    //   生成左值地址 主循环曾把下标子表达式 i 当链段→基址=&i+i×8 写穿栈）
    点[3] 环;
    循环 (整32 i = 0; i < 3; i++) {
        环[i].x = i;
        环[i].y = i * i;
    }
    点 快照 = 环[2];
    打印(快照.y);
    点 快照一 = 环[1];
    打印(快照一.x);
    返回 0;
}
