// 812（#497）：推断声明无后缀超宽字面量按真值域定宽——原语义层恒按后缀定级
//（无后缀=整32），超域字面量推断落 32 位槽静默截断（99999999999999999999 出
// 1661992959 残留）。修=推断声明按字面量文本真值域改判（整32 域内→整32·
// int64 域内→整64·超之→整128·001 规范 218 无后缀大字面量提升链+§5.2 类型
// 推断），双侧同构（宿主 inferredLiteralWidthType / v2 推断字面量域ID）。
函数 主() -> 整32 {
    变量 甲 = 3000000000;                  // 超 整32 正域·int64 域内 → 整64
    打印行("甲=", 甲);
    打印("");
    变量 乙 = 9999999999999;               // 13 位·int64 域内 → 整64
    打印行("乙=", 乙);
    打印("");
    变量 丙 = 99999999999999999999;        // 20 位·超 整64 域 → 整128
    打印行("丙=", 丙);
    打印("");
    变量 丁 = -99999999999999999999;       // 一元负号超宽形态 → 整128
    打印行("丁=", 丁);
    打印("");
    变量 戊 = 42;                          // 整32 域内 → 整32（既有契约不动）
    打印行("戊=", 戊);
    打印("");
    返回 0;
}
