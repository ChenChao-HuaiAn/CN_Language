// Task 3.9 类成员增强 E2E 测试
// 覆盖：静态字段（全类共享 + 类名.静态成员 访问 + 类内直接访问）/
//       静态方法（无 this，类名.静态方法 调用）/
//       常量成员函数（只读访问成员）/
//       友元函数（访问私有成员）
// 语法依据（cn-language-spec 06-十/十一/十二）：静态 字段/函数 全类共享（.data 段）；
//   类名.静态成员 访问；常量 函数 承诺不修改成员；友元 函数 可访问私有成员
// 说明：常量成员函数修改成员由语义层报错（单测覆盖），E2E 验证正向行为；
//   友元函数经 账户& 引用参数（规格书06-十二）——引用参数 codegen 支持有限，
//   E2E 用 友元函数 返回布尔（无引用修改）验证授权访问
// 打印语义（用户裁决）：打印=println（自动换行）

类 计数器 {
公开:
    静态 整32 总数 = 0        // 静态字段（全类共享）

    函数 计数器() {
        // 静态字段自增（缺陷5 修复验证）：总数++ 经"读-算-写回"正确计数
        总数++
    }

    静态 函数 获取总数() -> 整32 {
        返回 总数            // 静态方法访问静态字段
    }
}

// 只读包装：常量成员函数（读取私有成员）
类 只读包装 {
私有:
    整32 值
公开:
    函数 只读包装(整32 v) {
        值 = v
    }

    常量 函数 获取() -> 整32 {   // 常量成员：不修改成员
        返回 值
    }

    函数 修改(整32 新值) {
        值 = 新值
    }
}

// 账户 + 友元函数（访问私有余额）
// 说明：友元引用参数（账户&）的成员访问（账.余额）经 A-1（2026-08）引用
//   全链路修复已支持（语义保留 & 签名、IR byRef 解引用、字段读写经引用指针）；
//   指针参数（账户*）与引用参数（账户&）两种形态均验证私有成员授权访问。
类 账户 {
私有:
    整64 余额
公开:
    函数 账户(整64 初始) {
        余额 = 初始
    }

    友元 函数 检查余额(账户* 账)   // 声明友元函数（指针参数）
    友元 函数 取余额(账户& 账)      // 友元函数（引用参数，缺陷5 修复验证）
}

// 友元函数定义：可访问私有 余额（授权访问，不改值）
函数 检查余额(账户* 账) -> 布尔 {
    返回 账.余额 > 0
}

// 友元引用参数（账户&）成员访问（缺陷5 修复验证）
函数 取余额(账户& 账) -> 整64 {
    返回 账.余额
}

函数 主() -> 整32 {
    打印("===== 类成员增强（Task 3.9）=====")

    // ---- 1. 静态字段：全类共享 ----
    计数器 甲 = 计数器()
    计数器 乙 = 计数器()
    计数器 丙 = 计数器()
    打印("共享总数: ", 计数器.总数)        // 3（类名.静态字段 访问）
    打印("静态方法: ", 计数器.获取总数())  // 3（静态方法）

    // 类外修改静态字段
    计数器.总数 = 10
    打印("修改后: ", 计数器.获取总数())    // 10

    // ---- 2. 常量成员函数（读取私有成员）----
    只读包装 包装 = 只读包装(42)
    打印("常量获取: ", 包装.获取())        // 42
    包装.修改(100)
    打印("修改后: ", 包装.获取())          // 100

    // ---- 3. 友元引用参数（账户&）成员访问（缺陷5 修复验证）----
    账户 账户实例 = 账户(500)
    整64 金额 = 取余额(账户实例)
    打印("引用取余额: ", 金额)              // 500

    打印("===== 类成员增强测试完成 =====")
    返回 0
}
