// E2E 364：错误传播运算符 ? 链式边界（规格书 5.4）
// 三层传播链：顶层? -> 中层? -> 底层，正常逐层取 .值；失败沿调用链逐层
// 上抛（短路），最终错误码在调用侧检查锚定。
函数 底层(整32 v) -> 结果<整32, 整32> {
    如果 v < 0 { 返回 错误(6); }
    返回 正常(v * 2);
}

函数 中层(整32 v) -> 结果<整32, 整32> {
    整32 值 = 底层(v)?;
    返回 正常(值 + 1);
}

函数 顶层(整32 v) -> 结果<整32, 整32> {
    整32 值 = 中层(v)?;
    返回 正常(值);
}

函数 主() -> 整32 {
    结果<整32, 整32> 好 = 顶层(5);
    如果 好.正常 {
        打印("链式好: ", 好.值);
    } 否则 { }
    结果<整32, 整32> 坏 = 顶层(-1);
    如果 坏.正常 { } 否则 {
        打印("链式坏: ", 坏.错误);
    }
    返回 0;
}
