// E2E 1610_数组循环填充读取放行（1771·def-init「[] 写置位」链路·双编译对照）：
//   一维/二维数组经循环非常量下标填充后读取=放行（001 §3.9 诚实边界：非常量
//   下标写=该基数整体置位·循环填充惯用法漏报方向放行）。
//   修复前宿主分叉：defInitCheckLoopBody 循环体恢复把体内 [] 写置位一并回滚
//   →循环后常量下标读 E0381 误拒（v2 放行=分叉实录·零分叉铁律违例）。
//   修复=循环体内 [] 写置位记录随循环恢复重应用（写过的基数外溢·漏报方向）；
//   未写键（循环内写 [0] 读 [1] 形态）保持拒绝=保守面不放宽。
//   三维段暂缺：宿主三维数组元素访问运行期崩溃（独立缺陷·#1775 立案）——
//   def-init 语义面同构（[][][] 前缀剥与 [][] 同路），#1775 修复后补三维段。
函数 主() -> 整32 {
    // ① 一维循环填充+常量下标读
    整32[5] 槽;
    循环 (整32 i = 0; i < 5; i = i + 1) { 槽[i] = i * 3; }
    打印(槽[0]);
    打印(槽[4]);
    // ② 同数组非常量下标读（填充后区间扫全删=放行）
    整32 总 = 0;
    循环 (整32 i = 0; i < 5; i = i + 1) { 总 = 总 + 槽[i]; }
    打印(总);
    // ③ 二维双循环填充
    整32[3][4] 矩;
    循环 (整32 i = 0; i < 3; i = i + 1) {
        循环 (整32 j = 0; j < 4; j = j + 1) { 矩[i][j] = i * 10 + j; }
    }
    打印(矩[2][3]);
    打印(矩[0][0]);
    矩[1][2] = 99;
    打印(矩[1][2]);
    返回 0;
}
