// E2E 1727（#1983·宿主+v2 双侧·方法返回串接收位两态释放）：类方法返回
//   「字符串」的调用接收位两态——A2 返回类型契约（宿主 semantic_call_member
//   retOwnedString 写回同构）+ 返回位借用句柄深拷（宿主 ir_stmt.cpp
//   visitReturnStmt retBorrowedString 消费同构·#1571 三态收口）：
//   形态一·拥有串接收（方法体 返回 格式化(...)=新堆串·任务复现主形态）——
//     循环 30 轮接收位差应=0（修前 v2 每轮净漏 1：预扫方法调用形态恒不登记
//     →槽不预分配→生成期污染退出=无人释放）；
//   形态二·容器借出串接收（方法体 返回 容器元素调用=容器内部槽句柄·859
//     JSON 文本() 实锚同款）——返回位须深拷落堆独立副本（直传=借用句柄交给
//     按拥有结算的调用方，free 毁容器槽=859 键名串乱码实录），接收位释放
//     独立副本，容器槽保真（差=0 且内容逐字保真）。
//   断言口径：内存::活动分配数() 循环差=0（净泄漏语义）+长度/内容校验防假绿
//   （长度 1×30=30 与 3 字节 UTF-8「大」兼锁内容正确）；退出码恒 0（行级断言
//   承载）。打印一律先落声明变量（实参位方法调用临时面为 #1984 另案·本例
//   范围=声明接收位）。
导入 JSON::{JSON树, 解析JSON};
类 计数器 {
公开:
    整64 值;
    函数 计数器(整64 v) { 值 = v; }
    函数 文本() -> 字符串 {
        返回 格式化("%d64", 值);
    }
}
函数 主() -> 整32 {
    计数器 r = 计数器(7);
    JSON树 k = JSON树();
    解析JSON(k, "\"大\"");
    整32 i = 0;
    整64 总 = 0;
    // 形态一：拥有串循环接收（修前 v2 差=30·双侧终态=0）
    整64 基 = 内存::活动分配数();
    当 (i < 30) {
        字符串 t = r.文本();
        总 = 总 + 字符串长度(t);
        i = i + 1;
    }
    打印(总);
    打印(内存::活动分配数() - 基);
    // 形态二：容器借出串循环接收（差=0·容器槽保真）
    整64 基2 = 内存::活动分配数();
    i = 0;
    当 (i < 30) {
        字符串 t2 = k.文本(k.根);
        总 = 总 + 字符串长度(t2);
        i = i + 1;
    }
    打印(总);
    打印(内存::活动分配数() - 基2);
    字符串 保真 = k.文本(k.根);
    打印(字符串长度(保真));
    打印(保真);
    返回 0;
}
