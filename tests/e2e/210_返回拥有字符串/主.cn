// E2E 210（宿主正测，2026-09-11 第六十八轮 plans/019 阶段4' A2 方案甲 用户批准）：
//   返回拥有字符串——返回 字符串=拥有契约（调用方登记 RAII 自动释放，根治
//   缺口②用户函数返回堆串泄漏，Rust fn f() -> String 同款）/返回 字符*=
//   借用视图（调用方零拷贝不释放）。六形态运行校验：
//   ①拼接建造返回（堆串移出）②字面量返回（IR 返回位拥有化落堆）③拥有变量
//   返回（移出）④字符* 借用返回（驻留/参数透传零拷贝）⑤调用链拥有转发
//   ⑥字符* 视图消费（比较/拼接即时用）。
//   校验和锚定：六段输出拼接为单行数字串（对齐 208 风格）。
函数 造拼接(整64 n) -> 字符串 {
    字符串 s = "";
    整64 i = 0;
    当 (i < n) { s = s + "a"; i++; }
    返回 s;
}
函数 造字面量() -> 字符串 {
    返回 "字面量";
}
函数 造移出() -> 字符串 {
    字符串 s = 造拼接(3);
    返回 s;
}
函数 借用名(整64 id) -> 字符* {
    返回 驻留文本(id);
}
函数 转发(整64 n) -> 字符串 {
    返回 造拼接(n);                 // 调用链拥有转发（尾部调用直传）
}
函数 主() -> 整32 {
    字符串 a = 造拼接(4);           // 登记 RAII（自动 free——泄漏根治）
    字符串 b = 造字面量();          // 字面量返回位落堆
    字符串 c = 造移出();            // 双层拥有移交
    字符串 d = 转发(2);             // 三层链
    整64 id = 驻留("借用视图");
    字符串 e = 字符串复制(借用名(id));   // 字符* 持有须显式复制
    布尔 f = 字符串比较(借用名(id), "借用视图");  // 字符* 即时比较零拷贝
    打印行(a + "|" + b + "|" + c + "|" + d + "|" + e + "|" + (f ? "1" : "0"));
    返回 0;
}
