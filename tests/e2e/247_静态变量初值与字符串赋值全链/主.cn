// E2E 247（2026-09-12 第八十七轮 87-a，宿主单侧内存断言用例）：
//   **静态标量全形态初值（含字符）+ 静态字符串赋值来源分级 + 重复赋值残留**——
//   87-a 静态变量全链路的宿主侧扩展面；字符静态与浮点打印在 v2 侧为既有语法/
//   打印限制（v2 语法层不识别字符静态声明、打印浮点恒 0.000000——均非 87-a
//   引入，已登记），故本用例为宿主单侧（与 235/245 同款口径）。
//     ① 静态标量初值全形态（整64/整32/整8/布尔/浮64/字符/字符串）
//     ② 静态字符串赋值：字面量（驻留零分配）/ 拥有返回（接管）/ 借用来源（复制）
//     ③ 静态字符串重复赋值 500 轮：残留归零（drop 旧值）+ 内容正确
//     ④ 静态字符串跨函数写读（含搅动后读回）
//     ⑤ 静态结构体成员位赋值（跨函数 + 搅动读出 + 旧字段串 drop）
//     ⑥ 静态字符串自赋值（s = s 先复制后 drop——UAF 防护）
//   校验和折位：①1 ②2 ③4 ④8 ⑤16 ⑥32 —— 63=全对；宿主侧退出码恒 0，
//   校验和经打印行承载（与 220/235/245 同款口径）。
结构体 盒 {
    字符串 名;
    整32 号;
}

静态 整64 标量整 = 11111;
静态 整32 标量窄 = -222;
静态 整8 标量微 = 7;
静态 布尔 标量布 = 真;
静态 浮64 标量浮 = 2.5;
静态 字符 标量符 = 'Z';
静态 字符串 标量串 = "E247静态串初值甲乙丙丁戊己";
静态 盒 甲;

函数 搅动() -> 整64 {
    整64 和 = 0;
    整64 i = 0;
    当 (i < 16) {
        字符串 垃圾 = 字符串复制("E247搅动内存填充占位字符串内容甲乙丙丁戊己庚辛壬癸");
        和 = 和 + 字符串长度(垃圾);
        i++;
    }
    返回 和;
}

// ④ 跨函数写静态字符串（拥有返回接管）
函数 写串(字符串 源) -> 空类型 {
    标量串 = 字符串复制(源);
}

// ⑤ 跨函数写静态结构体成员（成员位赋值）
函数 写名(整32 号) -> 空类型 {
    甲 = 盒{ 名 = 字符串复制("E247甲串改写信道内容甲乙丙丁"), 号 = 号 };
}

// ① 静态标量初值全形态
函数 形一() -> 整64 {
    整64 位 = 0;
    如果 (标量整 == 11111) { 位 = 位 + 1; }
    如果 (标量窄 == -222) { 位 = 位 + 2; }
    如果 (标量微 == 7) { 位 = 位 + 4; }
    如果 (标量布) { 位 = 位 + 8; }
    如果 (标量浮 == 2.5) { 位 = 位 + 16; }
    如果 (标量符 == 'Z') { 位 = 位 + 32; }
    如果 (字符串比较(标量串, "E247静态串初值甲乙丙丁戊己")) { 位 = 位 + 64; }
    如果 (位 == 127) { 返回 1; }
    打印("形一 位=", 位);
    返回 0;
}

// ② 静态字符串赋值来源分级
函数 形二() -> 整64 {
    整64 位 = 0;
    // 字面量：驻留零分配（拍前拍后分配数不变）
    整64 前 = 内存::活动分配数();
    标量串 = "E247字面量串内容甲乙丙丁戊己庚";
    整64 后 = 内存::活动分配数();
    如果 (后 == 前) { 位 = 位 + 1; }
    如果 (字符串比较(标量串, "E247字面量串内容甲乙丙丁戊己庚")) { 位 = 位 + 2; }
    // 拥有返回：接管（净 +1 分配，无复制）
    整64 前2 = 内存::活动分配数();
    标量串 = 字符串复制("E247拥有返回串内容甲乙丙丁戊");
    整64 后2 = 内存::活动分配数();
    如果 (后2 - 前2 == 1) { 位 = 位 + 4; }
    如果 (字符串比较(标量串, "E247拥有返回串内容甲乙丙丁戊")) { 位 = 位 + 8; }
    // 借用来源（局部变量）：复制落堆 + drop 旧值 —— 净分配 0（副本 +1、旧串 −1），
    //   源局部保持拥有（句柄不共享）；块退出 + 搅动后目标仍可读（下方 64 位断言）
    {
        字符串 局部 = 字符串复制("E247借用来源串内容甲乙丙丁戊");
        整64 前3 = 内存::活动分配数();
        标量串 = 局部;
        整64 后3 = 内存::活动分配数();
        如果 (后3 - 前3 == 0) { 位 = 位 + 16; }
        如果 (字符串比较(标量串, "E247借用来源串内容甲乙丙丁戊")) { 位 = 位 + 32; }
    }
    搅动();
    如果 (字符串比较(标量串, "E247借用来源串内容甲乙丙丁戊")) { 位 = 位 + 64; }
    如果 (位 == 127) { 返回 2; }
    打印("形二 位=", 位);
    返回 0;
}

// ③ 静态字符串重复赋值 500 轮：残留归零
函数 形三(整64 轮数) -> 整64 {
    标量串 = 字符串复制("E247预热串内容甲乙丙丁戊己庚");
    整64 前 = 内存::活动分配数();
    整64 i = 0;
    当 (i < 轮数) {
        标量串 = 字符串复制("E247循环串内容甲乙丙丁戊己庚");
        i++;
    }
    整64 后 = 内存::活动分配数();
    如果 (后 != 前) {
        打印("形三 残留=", 后 - 前);
        返回 0;
    }
    如果 (!字符串比较(标量串, "E247循环串内容甲乙丙丁戊己庚")) { 返回 0; }
    返回 4;
}

// ④ 静态字符串跨函数写读
函数 形四() -> 整64 {
    写串("E247跨函数串内容甲乙丙丁戊己庚");
    搅动();
    整64 位 = 0;
    如果 (字符串比较(标量串, "E247跨函数串内容甲乙丙丁戊己庚")) { 位 = 位 + 1; }
    写串("E247跨函数串二次内容甲乙丙丁戊");
    如果 (字符串比较(标量串, "E247跨函数串二次内容甲乙丙丁戊")) { 位 = 位 + 2; }
    如果 (位 == 3) { 返回 8; }
    打印("形四 位=", 位);
    返回 0;
}

// ⑤ 静态结构体成员位赋值（跨函数 + 搅动）+ 旧字段串 drop
函数 形五() -> 整64 {
    写名(501);
    搅动();
    整64 位 = 0;
    如果 (甲.号 == 501) { 位 = 位 + 1; }
    如果 (字符串比较(甲.名, "E247甲串改写信道内容甲乙丙丁")) { 位 = 位 + 2; }
    // 重复写 300 轮：残留归零（旧字段串当场 drop）
    整64 前 = 内存::活动分配数();
    整64 i = 0;
    当 (i < 300) {
        写名(整32(i));
        i++;
    }
    整64 后 = 内存::活动分配数();
    如果 (后 != 前) {
        打印("形五 残留=", 后 - 前);
        返回 0;
    }
    如果 (甲.号 == 299) { 位 = 位 + 4; }
    如果 (位 == 7) { 返回 16; }
    打印("形五 位=", 位);
    返回 0;
}

// ⑥ 静态字符串自赋值（s = s：先复制后 drop，防 UAF）
函数 形六() -> 整64 {
    标量串 = 字符串复制("E247自赋值串内容甲乙丙丁戊己");
    标量串 = 标量串;
    搅动();
    整64 位 = 0;
    如果 (字符串比较(标量串, "E247自赋值串内容甲乙丙丁戊己")) { 位 = 位 + 1; }
    // 间接自赋值（局部持有同一句柄的副本，值语义恒安全）
    字符串 副本 = 字符串复制("E247间接自赋值串内容甲乙丙");
    标量串 = 副本;
    标量串 = 标量串;
    如果 (字符串比较(标量串, "E247间接自赋值串内容甲乙丙")) { 位 = 位 + 2; }
    如果 (位 == 3) { 返回 32; }
    打印("形六 位=", 位);
    返回 0;
}

函数 主() -> 整32 {
    整64 和 = 0;
    和 = 和 + 形一();
    和 = 和 + 形二();
    和 = 和 + 形三(500);
    和 = 和 + 形四();
    和 = 和 + 形五();
    和 = 和 + 形六();
    打印("校验和(期望63)=", 和);
    返回 0;
}
