// 549 嵌套合成体跨函数返回（081 四向段错误族根治转正·880 轮）：
//   根因=宿主 IR 层 resolveResultCtorTargetType 的 returnTypeSrc 优先覆盖
//   规则（治泛型类方法体 AST 共享残留）对嵌套返回类型（可选<结果<..>> 等）
//   函数体内的**内层**构造器（正常(7) 目标=内层 结果<整32,整32>）无条件
//   覆盖成外层类型——标量实参随 valueType=结构体 走 CopyStruct 12B（值
//   寄存器被当源地址解引用=段错误·gdb 实锤 mov (%r9) r9=7）。
//   守卫=①构造器名与返回类型顶层匹配（某些/无↔可选、正常/错误↔结果）
//   ②存储聚合×实参非聚合放弃覆盖（退语义层 resolvedType）。
//   治理前：四向跨函数返回+双层拆包 O0/O3 全段错误
//   （样本 cnsmith_hits/run_err/p0928_08~11·v6/v7 双平台互证）。
//   v2 侧 067-003 语义层标注优先无同构病（双编译对照=双侧全绿锚）。
函数 找甲() -> 可选<结果<整32,整32>> {
    结果<整32,整32> 内 = 正常(7);
    返回 某些(内);
}
函数 找乙() -> 结果<可选<整32>, 整32> {
    可选<整32> 内 = 某些(9);
    返回 正常(内);
}
函数 找丙() -> 可选<可选<整32>> {
    可选<整32> 内 = 某些(11);
    返回 某些(内);
}
函数 找丁() -> 结果<结果<整32,整32>, 整32> {
    结果<整32,整32> 内 = 正常(13);
    返回 正常(内);
}
函数 找戊() -> 可选<可选<可选<整32>>> {
    可选<可选<整32>> 中 = 某些(某些(21));
    返回 某些(中);
}
函数 主() -> 整32 {
    可选<结果<整32,整32>> 甲 = 找甲();
    如果 (甲.有值) {
        结果<整32,整32> 乙 = 甲.值;
        如果 (乙.正常) { 打印行("A_v=", 乙.值); } 否则 { 打印行("A_inner_err"); }
    } 否则 { 打印行("A_outer_none"); }
    结果<可选<整32>, 整32> 丙 = 找乙();
    如果 (丙.正常) {
        可选<整32> 丁 = 丙.值;
        如果 (丁.有值) { 打印行("B_v=", 丁.值); } 否则 { 打印行("B_inner_none"); }
    } 否则 { 打印行("B_outer_err"); }
    可选<可选<整32>> 戊 = 找丙();
    如果 (戊.有值) {
        可选<整32> 己 = 戊.值;
        如果 (己.有值) { 打印行("C_v=", 己.值); } 否则 { 打印行("C_inner_none"); }
    } 否则 { 打印行("C_outer_none"); }
    结果<结果<整32,整32>, 整32> 庚 = 找丁();
    如果 (庚.正常) {
        结果<整32,整32> 辛 = 庚.值;
        如果 (辛.正常) { 打印行("D_v=", 辛.值); } 否则 { 打印行("D_inner_err"); }
    } 否则 { 打印行("D_outer_err"); }
    可选<可选<可选<整32>>> 壬 = 找戊();
    如果 (壬.有值) {
        可选<可选<整32>> 癸 = 壬.值;
        如果 (癸.有值) {
            可选<整32> 子 = 癸.值;
            如果 (子.有值) { 打印行("E_v=", 子.值); } 否则 { 打印行("E_c_none"); }
        } 否则 { 打印行("E_b_none"); }
    } 否则 { 打印行("E_a_none"); }
    返回 0;
}
