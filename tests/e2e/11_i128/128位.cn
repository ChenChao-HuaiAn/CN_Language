// Task 完善A：i128 完整支持 E2E 测试
// 覆盖：
//   1. i128 字面量（LL 后缀强制 i128；超 int64 无后缀自动 i128）
//   2. i128 加法/减法（全128位，含进位/借位）
//   3. i128 乘法（大数，辅助函数 __cn_mul_i128）
//   4. i128 除法/取余（辅助函数 __cn_div_i128 / __cn_mod_i128）
//   5. i128 负数、边界值（2^127-1）
//   6. 正128 无符号（u128）乘法/除法/取余
//   7. i128 比较（>2^63 值域）
//   8. 打印 i128（打印行 多参数展开对 i128 的处理）
// 语法依据（cn-language-spec 02 + 规格书4.3/10.5）：
//   整128 = 16字节，范围 -2^127 ~ 2^127-1；LL 后缀 -> 整128；ULL -> 正128；
//   乘除取余由运行时辅助函数 __cn_mul_i128 等实现（规格书10.5）
// 说明：打印 i128 走 打印行（多参数展开 -> __cn_print_i128），
//       打印行整数 按 i64 截断（仅适用于 值域≤2^63 场景）

函数 主() -> 整32 {
    // ---- 1. i128 字面量与打印 ----
    打印("i128小值: ")
    打印(100LL)                        // 100

    // 超 int64 的无后缀字面量自动提升为 i128
    打印("超64自动i128: ")
    打印(10000000000000000000)         // 10000000000000000000（10^19 > 2^63）

    // ---- 2. i128 加法（含高位进位） ----
    整128 大数1 = 5000000000000000000LL
    整128 大数2 = 5000000000000000000LL
    打印("加法进位: ")
    打印(大数1 + 大数2)                // 10000000000000000000

    // ---- 3. i128 减法（含高位借位） ----
    整128 负数 = 大数2 - 大数1
    打印("减法: ")
    打印(负数)                         // 0

    // ---- 4. i128 乘法（大数，辅助函数） ----
    整128 乘数 = 2000000000LL
    整128 乘数2 = 3000000000LL
    打印("乘法: ")
    打印(乘数 * 乘数2)                 // 6000000000000000000

    // 更大乘法：2^62 * 2^62 = 2^124（128位全范围）
    整128 边界乘1 = 4611686018427387904LL   // 2^62
    整128 边界乘2 = 4611686018427387904LL   // 2^62
    打印("大数乘法: ")
    打印(边界乘1 * 边界乘2)            // 21267647932558653966460912964485513216

    // ---- 5. i128 除法/取余 ----
    整128 被除数 = 10000000000000000000LL
    整128 除数 = 3LL
    打印("除法: ")
    打印(被除数 / 除数)                // 3333333333333333333
    打印("取余: ")
    打印(被除数 % 除数)                // 1

    // ---- 6. i128 负数运算 ----
    整128 负值 = -5000000000000000000LL
    打印("负数: ")
    打印(负值)                         // -5000000000000000000
    打印("负乘: ")
    打印(负值 * 2LL)                   // -10000000000000000000
    打印("负除: ")
    打印(负值 / 2LL)                   // -2500000000000000000

    // ---- 7. 正128 无符号 ----
    正128 u大 = 10000000000000000000ULL
    打印("u128乘法: ")
    打印(u大 * 2ULL)                   // 20000000000000000000
    打印("u128除法: ")
    打印(u大 / 5ULL)                   // 2000000000000000000
    打印("u128取余: ")
    打印(u大 % 3ULL)                   // 1

    // ---- 8. 边界值：2^127-1（最大有符号128位） ----
    整128 最大值 = 170141183460469231731687303715884105727LL
    打印("边界最大值: ")
    打印(最大值)                       // 170141183460469231731687303715884105727
    打印("最大值减1: ")
    打印(最大值 - 1LL)                 // 170141183460469231731687303715884105726

    // ---- 9. i128 比较（>2^63 值域） ----
    整128 比较值 = 9000000000000000000LL
    如果 (比较值 > 8000000000000000000LL) {
        打印("大比较: ")
        打印("真")
    } 否则 {
        打印("大比较: ")
        打印("假")
    }

    返回 0
}
