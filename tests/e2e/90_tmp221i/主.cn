导入 容器::向量;
导入 映射集合;

函数 主() -> 整32 {
    打印("[S1] 入口");
    向量<映射<整64, 整64>> 表 = 向量<映射<整64, 整64>>();
    映射<整64, 整64> 层 = 映射<整64, 整64>();
    结果<空类型, 整32> 加 = 表.追加(层);
    打印("[S2] 追加后: ", 表.大小());
    结果<空类型, 整32> 设 = 表.元素(0).设置(7, 777);
    如果 (设.正常) {
        打印("[S3] 链式设置成功");
    } 否则 {
        打印("[S3] 设置失败");
    }
    结果<整64, 整32> 取 = 表.元素(0).获取(7);
    如果 (取.正常) {
        打印("[S4] 链式获取: ", 取.值);
    } 否则 {
        打印("[S4] 获取失败");
    }
    返回 0;
}
