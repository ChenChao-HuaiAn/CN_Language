// 741（954·2026-10-14）：有析构类按值拷贝须有拷贝构造负测（赋值面四形态）。
//   宿主 class_resolver.cpp:216 方案A 强制规则：有析构类（持有资源）按值
//   拷贝须有显式拷贝构造（深拷贝），否则默认浅拷贝字段级联析构双释放
//   0xC0000374（C++ rule-of-three 同款）。本用例锁赋值面：标识符赋值/
//   成员赋值（728z 探针形态）/转移赋值/转移声明——v2 修前语义层放行→
//   发射拷贝构造调用→链接期 LNK2019（728z 实证）；修后语义层与宿主同拒
//   同文案。声明初始化形态由 112 成对负测锁面。
类 芯片 {
公开:
    整64* 数据;
    函数 芯片() { 数据 = 无; }
    不安全 函数 ~芯片() { 如果 (数据 != 无) { 释放(数据); } }
}
类 外壳 {
公开:
    芯片 芯;
    函数 外壳() { }
    不安全 函数 ~外壳() { }
}
函数 主() -> 整32 {
    芯片 甲 = 芯片();
    芯片 乙 = 甲;
    乙 = 甲;
    外壳 k = 外壳();
    k.芯 = 甲;
    芯片 丙 = 芯片();
    丙 = 转移(甲);
    返回 0;
}
