// E2E 1474 负测（#1310 复审 P0-A/B）：**静态方法内自身静态字段名遮蔽顶层常量**——
//   读点是静态字段槽（未初始化 nullptr），越界检查必须用运行时 strlen（=0）→
//   取(4) 错误码 2。原 938 判据无条件排除字段 + A-3 实例字段判定在静态方法恒假
//   → 落入「其他对象」8 字节步进/无越界检查（垃圾读）。宿主+v2p 双编译。
常量 词 = "ABCDE";
类 盒子 {
公开:
    静态 字符串 词;
    静态 函数 取(整64 i) -> 整32 { 返回 整32(词[i]); }
}
函数 主() -> 整32 {
    盒子.词 = "XY";                // 静态字段赋值（运行期写链·字段长度 2）
    打印(整32(盒子.取(1)));        // 89 = 'Y'（步进 1 + 合法值锚）
    打印(整32(盒子.取(4)));        // 字段长度 2 → 错误码 2
    返回 0;
}
