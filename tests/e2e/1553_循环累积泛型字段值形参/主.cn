// 1553 循环累积泛型字段值形参（任务 1549·双编译性能向）
//   病：成员链接收者借用位750 的精确面仅用户类——泛型单态化实例字段接收者
//   `外.盒.取(s)`（值形参）落整函数保守（语义期实例合成名未登记用户类）；
//   v2 优化=0 而宿主按实例化后方法签名精确判定=1。
//   修：按泛型模板基类方法节点参数借位分析（实例化不改引用位 T/T& 的 & 深度）；
//   模板解析失败维持整函数保守；引用位实参仍登记逃逸（负例=1554）。
//   覆盖两形态：①固定值形参 `字符串`；②模板形参 `T`（实例化 T=字符串·验证
//   「实例化后签名」判据：T 值形参仍非引用位）。
//   负载：循环外 `外.盒.取(槽.名)`/`外.盒.取(s)`/`外T.盒.取泛(s)` + 循环累积 s。
//   预期：长=2048 / 泛型字段优化=1（分配次数≤6·双侧一致）。
结构体 盒 {
    字符串 名
}

泛型 <类型 T>
类 盒子 {
公开:
    T 值;
    函数 盒子() { }
    函数 取(字符串 参) -> 整64 { 返回 字符串长度(参); }
}

类 外层盒 {
公开:
    盒子<整64> 盒;
    函数 外层盒() { }
}

泛型 <类型 T>
类 盒子T {
公开:
    T 值;
    函数 盒子T() { }
    函数 取泛(T 参) -> 整64 { 返回 0; }
}

类 外层盒T {
公开:
    盒子T<字符串> 盒;
    函数 外层盒T() { }
}

不安全 函数 主() -> 整32 {
    字符串 s = "";
    盒 槽 = 盒{ 名 = "abc" };
    外层盒 外 = 外层盒();
    外.盒.取(槽.名);
    外.盒.取(s);
    外层盒T 外T = 外层盒T();
    外T.盒.取泛(s);
    整64 前 = 内存::总分配次数();
    循环 (整64 k = 0; k < 2048; k++) {
        s = s + "x";
    }
    整64 次 = 内存::总分配次数() - 前;
    打印("长=", 整数转字符串(字符串长度(s)));
    布尔 降 = 次 <= 6;
    如果 (降) { 打印("泛型字段优化=1"); } 否则 如果 (次 > 6) {
        打印("泛型字段优化=0 次=", 整数转字符串(次));
    }
    返回 0;
}
