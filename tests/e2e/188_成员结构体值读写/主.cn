// 188：成员结构体作值读写闭环（46-a/46-b 观察项根治，2026-09-09 第四十八轮）
//   A 写        r.左上 = a          （成员结构体作值写——宿主 MemberExpr 目标
//                                    原走标量 StorePtr 只写 8 字节静默数据损坏）
//   B 声明位读  点 t = r.左上       （v2 原把 LoadPtr 取的 8 字节值当源地址
//                                    结构体拷贝 -> 解引用垃圾地址段错误）
//   C 赋值位读  u = r.左上          （v2 原右值限定标识符可见失败）
//   D 成员→成员 r.右下 = r.左上     （宿主同 A 静默损坏）
//   E 成员实参  求和(r.左上)        （既有可用通道=回归锚）
//   L1 链式读   r.左上.x            （v2 46-b：成员链中间跳偏移不可标注）
// 语义依据：Rust place 拷贝同构——结构体赋值=整体按值拷贝（POD Copy）；
//   成员结构体作右值=地址语义（v2 IR 结构体以地址传递的既定约定）。
结构体 点 {
    整32 x
    整32 y
}

结构体 矩形 {
    点 左上
    点 右下
}

函数 求和(点 p) -> 整32 {
    返回 p.x * 10 + p.y;
}

函数 主() -> 整32 {
    矩形 r = 矩形{ 左上 = 点{ x = 11, y = 22 }, 右下 = 点{ x = 0, y = 0 } };
    点 a;
    a.x = 11;
    a.y = 22;
    整32 c = 0;
    r.左上 = a;
    如果 (r.左上.x == 11) { c = c + 1; }
    如果 (r.左上.y == 22) { c = c + 2; }
    点 t = r.左上;
    如果 (t.x == 11 && t.y == 22) { c = c + 4; }
    点 u = 点{ x = 99, y = 99 };
    u = r.左上;
    如果 (u.x == 11 && u.y == 22) { c = c + 8; }
    r.右下 = r.左上;
    如果 (r.右下.x == 11 && r.右下.y == 22) { c = c + 16; }
    整32 s = 求和(r.左上);
    如果 (s == 132) { c = c + 32; }
    打印(r.左上.x);
    打印(r.右下.y);
    打印(c);
    返回 0;
}
