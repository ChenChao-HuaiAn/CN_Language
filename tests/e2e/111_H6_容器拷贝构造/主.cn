// 111_H6 容器拷贝构造 E2E（2026-08-25）：方案A 拷贝构造在 stdlib 容器上
//   的运行验证——此前被 H6（泛型类方法引用参数成员访问失败）阻塞，H6 根治后
//   映射/向量 的拷贝构造（函数 类名(类名& 其他) 深拷贝）可用。
// 覆盖：
//   1. 向量<整64> 拷贝构造（初始化深拷贝：追加后互不影响）
//   2. 映射<整64,整64> 拷贝构造（初始化深拷贝：改副本不影响原表）
导入 容器::向量;
导入 映射集合::映射;

函数 主() -> 整32 {
    // ---- 1. 向量拷贝构造（深拷贝）----
    向量<整64> 甲 = 向量<整64>();
    结果<空类型, 整32> 加1 = 甲.追加(10);
    结果<空类型, 整32> 加2 = 甲.追加(20);
    结果<空类型, 整32> 加3 = 甲.追加(30);
    打印("甲大小: ", 甲.大小());

    向量<整64> 乙 = 甲;
    打印("乙大小: ", 乙.大小());
    打印("乙[0]: ", 乙.元素(0));
    打印("乙[2]: ", 乙.元素(2));

    结果<空类型, 整32> 加4 = 乙.追加(99);
    打印("甲大小 仍: ", 甲.大小());
    打印("乙大小 变: ", 乙.大小());

    // ---- 2. 映射拷贝构造（深拷贝）----
    映射<整64, 整64> 表 = 映射<整64, 整64>();
    结果<空类型, 整32> 设1 = 表.设置(1, 100);
    结果<空类型, 整32> 设2 = 表.设置(2, 200);
    打印("表大小: ", 表.大小());

    映射<整64, 整64> 副本 = 表;
    打印("副本大小: ", 副本.大小());
    结果<整64, 整32> 取1 = 副本.获取(1);
    如果 (取1.正常) {
        打印("副本[1]: ", 取1.值);
    }
    结果<整64, 整32> 取2 = 副本.获取(2);
    如果 (取2.正常) {
        打印("副本[2]: ", 取2.值);
    }

    结果<空类型, 整32> 设3 = 副本.设置(1, 999);
    结果<整64, 整32> 取3 = 表.获取(1);
    如果 (取3.正常) {
        打印("表[1] 仍: ", 取3.值);
    }

    返回 0;
}
