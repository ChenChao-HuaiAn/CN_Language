// E2E 1385（双编译对照·负例·#1922 件4）：lambda（合成体）返回位借用形态——
//   宿主 + v2p 双侧编译拒绝、同文案（A2 拥有契约）。
//   修前 v2 合成体跳过主遍历全量检查（逃逸/显捕/值捕写三遍均不含 A2）：lambda
//   体内 `返回 <字段串借用形态>` 宿主拒 / v2 放行（零分叉）——闭包把借用句柄
//   按拥有返回，调用方/宿主对象析构释放=字段被清空（alloc7 类探针）。
//   plans/001 §5.4 A2「返回位借用形态（参数直传/成员/下标/解引用/字符* 调用/
//   全局静态）编译错误」对合成体同权。
// 覆盖四形态（对应 A2 五形态中 lambda 体可达面）：①成员借出（[&] 捕获对象
//   字段）②下标借出（数组元素）③字符* 调用借用（驻留文本）④全局静态借用。
//   参数直传在 lambda 面宿主放行（lambda 形参=拥有副本）→ 不属拒绝面；
//   正例对照=1766/1763（字符串复制 落堆）。
// 预期失败。
静态 字符串 全局串 = "全局";
类 人 {
公开:
    字符串 名;
    函数 人(字符串 n) { 名 = n; }
}
函数 主() -> 整32 {
    人 甲 = 人("张三");
    变量 闭成员 = [&]() -> 字符串 { 返回 甲.名; };
    字符串[3] 组;
    组[0] = 字符串复制("甲");
    变量 闭下标 = [&]() -> 字符串 { 返回 组[0]; };
    变量 闭字符 = []() -> 字符串 { 返回 驻留文本(驻留("甲")); };
    变量 闭全局 = []() -> 字符串 { 返回 全局串; };
    打印(闭成员());
    打印(闭下标());
    打印(闭字符());
    打印(闭全局());
    返回 0;
}
