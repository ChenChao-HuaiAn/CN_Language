// 646（#263④ 布局 128 双槽 欠账定性探针·070 行「布局 128 双槽」项）：
//   结构体 整128/正128 字段双槽布局矩阵——〔基准=019〕128 位=双槽值语义
//   （053 域·810/814 落地）。覆盖：①结构体混合布局（128+64+128·偏移对齐）
//   ②结构体数组元素 128 字段 ③嵌套结构体 128 载荷 ④容器元素含 128 字段
//   ⑤静态 128 字段读写。校验=值守恒+分配平衡（泄漏零容忍域）。
导入 容器::向量;

结构体 混合布局 {
    整128 大值;
    整64 小值;
    正128 无符值;
}

结构体 嵌套外 {
    混合布局 内层;
    整32 标记;
}

函数 主() -> 整32 {
    // ① 结构体混合布局读写
    混合布局 甲 = 混合布局{ 大值 = 123456789012345, 小值 = 42, 无符值 = 987654321 };
    打印(整64(甲.大值 % 1000));
    打印(甲.小值);
    打印(整64(甲.无符值 % 1000));

    // ② 嵌套结构体 128 载荷
    嵌套外 乙 = 嵌套外{ 内层 = 甲, 标记 = 7 };
    打印(整64(乙.内层.大值 % 1000));
    打印(乙.内层.小值);
    打印(乙.标记);

    // ③ 结构体数组元素 128 字段（下标步进=布局宽度）
    混合布局[3] 组;
    组[0] = 混合布局{ 大值 = 1000000000001, 小值 = 1, 无符值 = 2 };
    组[1] = 混合布局{ 大值 = 2000000000002, 小值 = 3, 无符值 = 4 };
    组[2] = 混合布局{ 大值 = 3000000000003, 小值 = 5, 无符值 = 6 };
    打印(整64(组[0].大值 % 10000));
    打印(组[1].小值);
    打印(整64(组[2].无符值 % 10000));

    // ④ 容器元素含 128 字段（值传参物化面·263① 域交互）
    向量<混合布局> 表 = 向量<混合布局>();
    结果<空类型, 整32> 加 = 表.追加(组[1]);
    如果 (!加.正常) { 返回 9; }
    打印(整64(表.元素(0).大值 % 10000));
    打印(表.元素(0).小值);

    // ⑥ 128 字段算术与比较
    整128 和 = 甲.大值 + 组[1].大值;
    打印(整64(和 % 1000));
    如果 (甲.大值 < 组[2].大值) { 打印(1); } 否则 { 打印(0); }

    返回 0;
}
