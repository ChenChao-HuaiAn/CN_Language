// E2E 843 正测（#549 正测锁用例·dual 双编译对照）：传参面实参转换检查收口
//   不得误伤合法面——各调用形态×合法转换组合全绿：普通函数隐式提升链
//   （整/正系同符号宽化）/字面量豁免（域内+整8 回绕）/字符↔整数/字符*→字符串/
//   引用形参/常量实参/方法调用/构造调用/函数指针调用。
//   与 824 负测成对：三形态非法转换双侧拒，本用例合法转换双侧同编译同运行
//   同输出（断言输出=是）。
常量 常量值 = 100;

函数 吃整64(整64 x) -> 整64 {
    返回 x;
}
函数 吃整128(整128 x) -> 整32 {
    返回 3;
}
函数 吃浮64(浮64 x) -> 整32 {
    返回 3;
}
函数 吃整32(整32 x) -> 整32 {
    返回 x;
}
函数 吃整16(整16 x) -> 整32 {
    返回 3;
}
函数 吃整8(整8 x) -> 整32 {
    返回 3;
}
函数 吃正32(正32 x) -> 整32 {
    返回 3;
}
函数 吃正64(正64 x) -> 整32 {
    返回 3;
}
函数 吃字符串(字符串 s) -> 整32 {
    返回 3;
}
函数 吃字符(字符 c) -> 整32 {
    返回 3;
}
函数 引用参(整32& r) -> 整32 {
    返回 r;
}

类 盒 {
公开:
    整32 值;
    函数 盒(整32 v) {
        值 = v;
    }
    函数 取法(整32 y) -> 整32 {
        返回 值 + y;
    }
}

函数 主() -> 整32 {
    整8 小8 = 5;
    正8 正8小 = 5;
    整16 小16 = 500;
    正16 正16小 = 500;
    整32 中 = 100;
    正32 正小 = 100;
    整64 大 = 100;
    正64 正大 = 100;
    浮32 单浮 = 2.5f;
    浮64 双浮 = 2.5;
    字符 c = 'A';
    字符串 s = "abc";
    字符* cp = "xyz";
    吃整64(小8);        // 整8→整64 同符号宽化链
    吃整64(小16);
    吃整64(中);
    吃整64(c);          // 字符→整数（字符↔整数互通）
    吃整64(大);
    吃整64(常量值);      // 常量实参（v2 常量表宽松口径豁免面）
    吃整128(大);        // 整64→整128 宽化
    吃正64(正8小);      // 正系链 正8→正64
    吃正64(正16小);
    吃正64(正小);
    吃正64(正大);
    吃浮64(单浮);       // 浮32→浮64
    吃浮64(中);         // 整→浮
    吃浮64(小8);
    吃字符串(cp);       // 字符*→字符串
    吃整32(100);        // 字面量同型
    吃整16(300);        // 字面量→整16 域内
    吃整8(200);         // 字面量→整8 回绕豁免（001 §3.7a·canConvertArgNarrow）
    吃正32(7);          // 字面量→正32 混合符号豁免（域内）
    引用参(中);          // 引用形参（目标非标量面）
    吃字符('B');        // 字符字面量
    盒 b = 盒(中);       // 构造调用
    整32 z = b.取法(中); // 方法调用
    整32(*fp)(整32) = 吃整32;
    整32 w = fp(中);    // 函数指针调用
    打印行("矩阵", z + w);
    返回 0;
}
