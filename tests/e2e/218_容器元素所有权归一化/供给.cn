// E2E 218 符号供给（v2 自举链，plans/020 移植纪律）：
//   v2p_linux.o 只含 v2 自身实例化的容器类型——链表<字符串>/栈<字符串>/队列<字符串>
//   的方法符号（构造/头部追加/压入/入队/大小/析构）须由本文件经**宿主真实管线**
//   编译为 .o 参与链接（置于 v2p_linux.o 之前，符号权威）。
//   与 126 用例供给同款机制（②b B5/B7）。
导入 容器::向量;
导入 容器::链表;
导入 容器::栈;
导入 容器::队列;
导入 映射集合;

// 实例化 链表<字符串> 全方法面（头部追加 + 大小 + 析构 RAII）
函数 供给链表() -> 整64 {
    链表<字符串> 表 = 链表<字符串>();
    结果<空类型, 整32> 加 = 表.头部追加("供给链表元素");
    如果 (!加.正常) { 返回 101; }
    如果 (表.大小() != 1) { 返回 102; }
    返回 0;
}

// 实例化 栈<字符串> 全方法面（压入 + 大小 + 析构 RAII）
函数 供给栈() -> 整64 {
    栈<字符串> 表 = 栈<字符串>();
    结果<空类型, 整32> 加 = 表.压入("供给栈元素");
    如果 (!加.正常) { 返回 103; }
    如果 (表.大小() != 1) { 返回 104; }
    返回 0;
}

// 实例化 队列<字符串> 全方法面（入队 + 大小 + 析构 RAII）
函数 供给队列() -> 整64 {
    队列<字符串> 表 = 队列<字符串>();
    结果<空类型, 整32> 加 = 表.入队("供给队列元素");
    如果 (!加.正常) { 返回 105; }
    如果 (表.大小() != 1) { 返回 106; }
    返回 0;
}

// 75-a：映射/嵌套容器符号供给——映射<整64,字符串>（析构/清空/设置 全方法面）
//   与 向量<映射<整64,字符串>>（元素析构链：~向量 注入元素析构 → ~映射）
函数 供给映射() -> 整64 {
    映射<整64, 字符串> 表 = 映射<整64, 字符串>();
    字符串 值 = 字符串复制("供给映射值串内容");
    结果<空类型, 整32> 设 = 表.设置(1, 值);
    如果 (!设.正常) { 返回 107; }
    表.清空();
    返回 0;
}

函数 供给嵌套() -> 整64 {
    向量<映射<整64, 字符串>> 外 = 向量<映射<整64, 字符串>>();
    映射<整64, 字符串> 内 = 映射<整64, 字符串>();
    字符串 值 = 字符串复制("供给嵌套值串内容");
    结果<空类型, 整32> 设 = 内.设置(1, 值);
    如果 (!设.正常) { 返回 108; }
    结果<空类型, 整32> 加 = 外.追加(内);
    如果 (!加.正常) { 返回 109; }
    返回 0;
}

// 宿主编译入口（cn build 需要主函数；链接 muldefs 下 v2asm 在前，cn_main 归 v2 产物）
函数 主() -> 整32 {
    返回 整32(供给链表() + 供给栈() + 供给队列() + 供给映射() + 供给嵌套());
}
