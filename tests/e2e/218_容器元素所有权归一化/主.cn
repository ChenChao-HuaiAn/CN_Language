// E2E 218（2026-09-11 第七十四轮，plans/020 矩阵靶子 #1「入容器编译器级
//   copy/move」立案）：**容器元素所有权全链归一化**。
//   根因（探针 74 A/J/L/N 实证，全部可复现）：容器析构**无条件释放元素串**
//   （__cn_vector_free_strings 由 IR 层注入，假定「元素所有权归容器」），而
//   **入容器位不接管所有权**（实参句柄被浅存）——两侧机制相互矛盾：
//     ① 借用句柄入容器 → 容器析构释放**调用方拥有**的串（跨函数 UAF：
//        探针 L 打印「容器销毁后 本地」输出乱码）；
//     ② 局部拥有串裸标识符入容器 → 源 RAII 释放 + 元素浅共享 = 悬垂
//        （探针 A：3 元素内容全乱码）；
//     ③ 转移(源) 入容器非真 move（源槽未清零，源出口释放移交句柄 =
//        元素悬垂，探针 J 元素内容乱码）；
//     ④ v2 侧容器元素从不释放（v2 无对应机制，防线不对称，探针 G 残留 2）；
//     ⑤ 链表/栈/队列元素串从不释放（宿主只覆盖 向量，探针 N 各残留 1）。
//   修复（方案A，性能第一/安全第二，Rust Vec<String> 对照）：入容器位编译器
//   接管所有权——转移(x)=真 move 零拷贝（Rust push(s) 同款）；标识符（拥有串
//   局部/字符串形参等借用来源）=自动复制落堆（Rust push(s.clone()) 由编译器
//   代写，容器独立拥有）；调用返回（拥有契约）=直接接管零拷贝；字面量=
//   驻留借用（进程生命周期，零开销）。元素释放面补全 向量/链表/栈/队列。
//   断言口径：七形态折校验和（127=全对）——①1 ②2 ③4 ④8 ⑤16 ⑥32（映射
//   值串随析构/清空释放）⑦64（向量<映射<…,字符串>> 嵌套元素析构链释放）；每个形态后
//   经内存搅动制造复用压力（悬垂元素内容必被覆盖，探针 A 手法）。
导入 容器::向量;
导入 映射集合;
导入 容器::链表;
导入 容器::栈;
导入 容器::队列;

// 内存搅动：新分配覆盖「已释放内存」，使悬垂元素内容可观测损坏（探针 A 手法）
函数 搅动() -> 整64 {
    整64 和 = 0;
    整64 i = 0;
    当 (i < 24) {
        字符串 垃圾 = 字符串复制("搅动内存填充占位字符串内容甲乙丙丁戊己庚辛");
        和 = 和 + 字符串长度(垃圾);
        i++;
    }
    返回 和;
}

// ① 借用形态：字符串形参（借用视图）经函数入容器——容器析构不得释放调用方的串
函数 存入(向量<字符串> 表, 字符串 值) -> 空类型 {
    结果<空类型, 整32> 加 = 表.追加(值);
    如果 (!加.正常) { 运行时错误(4); }
}

函数 借用形态() -> 整64 {
    字符串 本地 = 字符串复制("借用形态调用方拥有串内容甲乙丙丁戊己庚辛");
    如果 (1 == 1) {
        向量<字符串> 表 = 向量<字符串>();
        存入(表, 本地);
    }
    整64 消耗 = 搅动();
    如果 (字符串比较(本地, "借用形态调用方拥有串内容甲乙丙丁戊己庚辛")) { 返回 1; }
    返回 0;
}

// ② 收集形态：局部拥有串裸标识符入容器——源函数返回后元素须完好
函数 收集(向量<字符串> 表) -> 空类型 {
    字符串 值 = 字符串复制("收集形态拥有串内容甲乙丙丁戊己庚辛壬癸");
    结果<空类型, 整32> 加 = 表.追加(值);
    如果 (!加.正常) { 运行时错误(4); }
}

函数 收集形态() -> 整64 {
    向量<字符串> 表 = 向量<字符串>();
    收集(表);
    整64 消耗 = 搅动();
    字符串 元素 = 表.元素(0);
    如果 (字符串比较(元素, "收集形态拥有串内容甲乙丙丁戊己庚辛壬癸")) { 返回 1; }
    返回 0;
}

// ③ 转移形态：转移(源) 入容器=真 move（源槽清零，零拷贝，元素独享所有权）
函数 收集转移(向量<字符串> 表) -> 空类型 {
    字符串 值 = 字符串复制("转移形态拥有串内容甲乙丙丁戊己庚辛壬癸子");
    结果<空类型, 整32> 加 = 表.追加(转移(值));
    如果 (!加.正常) { 运行时错误(4); }
}

函数 转移形态() -> 整64 {
    向量<字符串> 表 = 向量<字符串>();
    收集转移(表);
    整64 消耗 = 搅动();
    字符串 元素 = 表.元素(0);
    如果 (字符串比较(元素, "转移形态拥有串内容甲乙丙丁戊己庚辛壬癸子")) { 返回 1; }
    返回 0;
}

// ④ 释放面形态：向量/链表/栈/队列 的元素串须随容器析构逐一释放（残留归零）
函数 释放面形态() -> 整64 {
    整64 前 = 内存::活动分配数();
    如果 (1 == 1) {
        向量<字符串> 向量表 = 向量<字符串>();
        结果<空类型, 整32> 加1 = 向量表.追加(字符串复制("向量元素占位内容甲乙丙丁戊己庚辛"));
        如果 (!加1.正常) { 运行时错误(4); }
        链表<字符串> 链表表 = 链表<字符串>();
        结果<空类型, 整32> 加2 = 链表表.头部追加(字符串复制("链表元素占位内容甲乙丙丁戊己庚辛"));
        如果 (!加2.正常) { 运行时错误(4); }
        栈<字符串> 栈表 = 栈<字符串>();
        结果<空类型, 整32> 加3 = 栈表.压入(字符串复制("栈元素占位内容甲乙丙丁戊己庚辛壬"));
        如果 (!加3.正常) { 运行时错误(4); }
        队列<字符串> 队列表 = 队列<字符串>();
        结果<空类型, 整32> 加4 = 队列表.入队(字符串复制("队列元素占位内容甲乙丙丁戊己庚辛"));
        如果 (!加4.正常) { 运行时错误(4); }
    }
    整64 后 = 内存::活动分配数();
    如果 (后 == 前) { 返回 1; }   // 四种容器元素串随容器析构释放完毕=残留归零
    返回 0;
}

// ⑤ 字面量形态：字面量入容器=驻留借用（进程生命周期，零复制开销，元素可用）
函数 字面量形态() -> 整64 {
    向量<字符串> 表 = 向量<字符串>();
    结果<空类型, 整32> 加 = 表.追加("字面量元素驻留借用甲乙丙丁戊己庚辛");
    如果 (!加.正常) { 运行时错误(4); }
    整64 消耗 = 搅动();
    字符串 元素 = 表.元素(0);
    如果 (字符串比较(元素, "字面量元素驻留借用甲乙丙丁戊己庚辛")) { 返回 1; }
    返回 0;
}

// ⑥ 映射形态（75-a 映射元素释放）：映射<整64,字符串> 的值串随 析构/清空 释放
函数 映射形态() -> 整64 {
    整64 a = 内存::活动分配数();
    如果 (1 == 1) {
        映射<整64, 字符串> 表 = 映射<整64, 字符串>();
        字符串 值 = 字符串复制("映射形态值串内容甲乙丙丁戊己庚辛");
        结果<空类型, 整32> 设 = 表.设置(1, 值);
        如果 (!设.正常) { 返回 0; }
    }
    整64 b = 内存::活动分配数();
    如果 (b != a) { 返回 0; }
    映射<整64, 字符串> 表2 = 映射<整64, 字符串>();
    字符串 值2 = 字符串复制("映射形态清空值串内容甲乙丙丁戊");
    结果<空类型, 整32> 设2 = 表2.设置(2, 值2);
    如果 (!设2.正常) { 返回 0; }
    整64 c = 内存::活动分配数();
    表2.清空();
    如果 (内存::活动分配数() >= c) { 返回 0; }
    返回 1;
}

// ⑦ 嵌套形态（75-a）：向量<映射<整64,字符串>> 元素析构链释放值串
函数 嵌套形态() -> 整64 {
    整64 a = 内存::活动分配数();
    如果 (1 == 1) {
        向量<映射<整64, 字符串>> 外 = 向量<映射<整64, 字符串>>();
        映射<整64, 字符串> 内 = 映射<整64, 字符串>();
        字符串 值 = 字符串复制("嵌套形态值串内容甲乙丙丁戊己庚辛");
        结果<空类型, 整32> 设 = 内.设置(1, 值);
        如果 (!设.正常) { 返回 0; }
        结果<空类型, 整32> 加 = 外.追加(内);
        如果 (!加.正常) { 返回 0; }
    }
    整64 b = 内存::活动分配数();
    如果 (b != a) { 返回 0; }
    返回 1;
}

函数 主() -> 整32 {
    整32 校验 = 0;
    如果 (借用形态() == 1) { 校验 = 校验 + 1; }
    如果 (收集形态() == 1) { 校验 = 校验 + 2; }
    如果 (转移形态() == 1) { 校验 = 校验 + 4; }
    如果 (释放面形态() == 1) { 校验 = 校验 + 8; }
    如果 (字面量形态() == 1) { 校验 = 校验 + 16; }
    如果 (映射形态() == 1) { 校验 = 校验 + 32; }
    如果 (嵌套形态() == 1) { 校验 = 校验 + 64; }
    返回 校验;
}
