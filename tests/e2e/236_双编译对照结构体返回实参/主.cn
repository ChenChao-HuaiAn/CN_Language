// E2E 236（2026-09-12 第八十二轮，plans/020 移植纪律 9 门禁化·第八个对照用例）：
//   **结构体返回值的存放独立性（v2 帧尾共享 retbuf 缺陷回归锚）**——同一份源码经
//   宿主真实管线与 v2 自举链各编译运行，两侧退出码须相等。
//   背景（81-a 探针 P15/P17 实证，82-a 修复）：v2 的 retbuf 是帧尾共享单缓冲——
//   任何「返回值跨越另一次返回调用」的形态都被覆盖：单实参=句柄泄漏、双实参=
//   数据损坏（`取两号(造盒(1),造盒(2))` 宿主 1 / v2 0）。82-a 以「返回物化到独立槽」
//   （LLVM sret 各自分配语义）根治，本用例为该修复的正式门禁。
//   八形态（两侧共有语义面）：
//     ① 单实参（返回作实参）：`取号(造盒(1))`
//     ② 双实参（两个返回值同时活跃）：`取两号(造盒(1), 造盒(2))` ★核心回归锚
//     ③ 两次接收不串扰：`盒子 a = 造盒(3); 盒子 b = 造盒(4);`
//     ④ 返回值跨越另一次返回调用（接收值在其它返回调用之后仍完好）——
//        注：`造盒(5).号`（调用返回的结构体**直接成员访问**）与赋值位接收返回
//        （`盒子 甲; 甲 = 造盒(5);`）均为两侧共同边界/宿主支持但 v2 IR 层不支持
//        （实测），本形态改测「跨越」语义
//     ⑤ 返回作结构体按值实参（跨函数转手）：`传盒(造盒(6))`
//     ⑥ 混合实参（标识符 + 返回）：`取两号(甲, 造盒(2))`
//     ⑦ 循环 20 万轮（每轮接收 + 字段校验）
//     ⑧ 深嵌套：`取号(传盒(造盒(8)))`
//   校验和折位：①1 ②2 ③4 ④8 ⑤16 ⑥32 ⑦64 ⑧128 —— 255=全对。
//   两侧任一形态的返回值存放机制分叉（共享缓冲覆盖/句柄泄漏）→ 该校验位丢失 →
//   退出码变化 → 对照失败。平台守卫=linux 双平台（宿主与 v2 同链；win-x64 v2
//   产物未隔离=家机轮）。本用例不含容器（无供给、不需要借链——纯 retbuf 面）。

结构体 盒子 {
    字符串 名;
    整32 号;
}

函数 造盒(整32 号) -> 盒子 {
    盒子 内 = 盒子{ 名 = 字符串复制("E236占位内容甲乙丙丁戊己庚辛壬癸子丑寅卯"), 号 = 号 };
    返回 内;
}

函数 取号(盒子 箱) -> 整32 {
    返回 箱.号;
}

函数 传盒(盒子 箱) -> 盒子 {
    盒子 出 = 盒子{ 名 = 字符串复制("E236传盒内容甲乙丙丁戊己庚辛壬癸子丑寅"), 号 = 箱.号 };
    返回 出;
}

函数 取两号(盒子 甲, 盒子 乙) -> 整32 {
    如果 (甲.号 == 1 && 乙.号 == 2) { 返回 1; }
    如果 (甲.号 == 21 && 乙.号 == 2) { 返回 21; }
    返回 0;
}

// ① 单实参（返回作实参）
函数 形一() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        如果 (取号(造盒(1)) == 1) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验;
}

// ② 双实参（两个返回值同时活跃——v2 共享 retbuf 覆盖的核心回归锚）
函数 形二() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        如果 (取两号(造盒(1), 造盒(2)) == 1) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 2;
}

// ③ 两次接收不串扰
函数 形三() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        盒子 甲 = 造盒(3);
        盒子 乙 = 造盒(4);
        如果 (甲.号 == 3 && 乙.号 == 4) { 校验 = 1; }
        如果 (!字符串比较(甲.名, "E236占位内容甲乙丙丁戊己庚辛壬癸子丑寅卯")) { 校验 = 0; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 4;
}

// ④ 返回值跨越另一次返回调用（接收值在中间插入了另一次返回调用后仍完好）
函数 形四() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        盒子 甲 = 造盒(51);
        整32 中间 = 取号(造盒(52));
        盒子 乙 = 造盒(53);
        如果 (甲.号 == 51 && 乙.号 == 53 && 中间 == 52) { 校验 = 1; }
        如果 (!字符串比较(甲.名, "E236占位内容甲乙丙丁戊己庚辛壬癸子丑寅卯")) { 校验 = 0; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 8;
}

// ⑤ 返回作结构体按值实参（跨函数转手）
函数 形五() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        盒子 收 = 传盒(造盒(6));
        如果 (收.号 == 6) { 校验 = 1; }
        如果 (!字符串比较(收.名, "E236传盒内容甲乙丙丁戊己庚辛壬癸子丑寅")) { 校验 = 0; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 16;
}

// ⑥ 混合实参（标识符 + 返回）
函数 形六() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        盒子 甲 = 造盒(21);
        如果 (取两号(甲, 造盒(2)) == 21) { 校验 = 1; }
        如果 (甲.号 != 21) { 校验 = 0; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 32;
}

// ⑦ 循环 20 万轮（每轮接收 + 字段校验）
函数 形七(整64 轮数) -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 i = 0;
    当 (i < 轮数) {
        盒子 每轮 = 造盒(70);
        如果 (每轮.号 != 70) { 返回 0; }
        如果 (!字符串比较(每轮.名, "E236占位内容甲乙丙丁戊己庚辛壬癸子丑寅卯")) { 返回 0; }
        i++;
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 64;
}

// ⑧ 深嵌套（返回 → 结构体实参 → 返回 → 标量实参）
函数 形八() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        如果 (取号(传盒(造盒(8))) == 8) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 128;
}

函数 主() -> 整32 {
    整64 和 = 0;
    和 = 和 + 形一();
    和 = 和 + 形二();
    和 = 和 + 形三();
    和 = 和 + 形四();
    和 = 和 + 形五();
    和 = 和 + 形六();
    和 = 和 + 形七(200000);
    和 = 和 + 形八();
    返回 整32(和);
}
