// 188_v2：成员结构体作值读写 v2 闭环（46-a/46-b 观察项根治，2026-09-09 第四十八轮；
//   宿主侧同源用例=188）——v2p 编译本源码 rc=63=六形态校验和全过：
//   A 写 r.左上=a（+1/+2）/ B 声明位读 点 t=r.左上（+4；修复前 LoadPtr 8 字节值
//   当源地址结构体拷贝=解引用垃圾地址段错误 0xC0000005）/ C 赋值位读 u=r.左上
//   （+8；修复前右值限定标识符可见失败）/ D 成员→成员 r.右下=r.左上（+16）/
//   E 成员实参 求和(r.左上)（+32；既有通道回归锚）/ L1 链式读 r.左上.x 经
//   打印通道（修复前「成员字段偏移未知」可见失败=46-b）。
结构体 点 {
    整32 x
    整32 y
}

结构体 矩形 {
    点 左上
    点 右下
}

函数 求和(点 p) -> 整32 {
    返回 p.x * 10 + p.y;
}

函数 主() -> 整32 {
    矩形 r = 矩形{ 左上 = 点{ x = 11, y = 22 }, 右下 = 点{ x = 0, y = 0 } };
    点 a;
    a.x = 11;
    a.y = 22;
    整32 c = 0;
    r.左上 = a;
    如果 (r.左上.x == 11) { c = c + 1; }
    如果 (r.左上.y == 22) { c = c + 2; }
    点 t = r.左上;
    如果 (t.x == 11 && t.y == 22) { c = c + 4; }
    点 u = 点{ x = 99, y = 99 };
    u = r.左上;
    如果 (u.x == 11 && u.y == 22) { c = c + 8; }
    r.右下 = r.左上;
    如果 (r.右下.x == 11 && r.右下.y == 22) { c = c + 16; }
    整32 s = 求和(r.左上);
    如果 (s == 132) { c = c + 32; }
    打印(r.左上.x);
    打印(r.右下.y);
    返回 c;
}
