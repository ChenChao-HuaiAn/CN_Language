// 1378 抽象方法指针虚调分派（1022·1020 采样轮 H1·双编译对照）：抽象（纯虚）方法
//   进虚表——抽象静态类型**指针**调用虚分派正确分派到派生类实现。
//   病根（1020 轮 H1·双侧同病）：宿主 class_resolver assignVtable 过滤只认 虚拟/
//   重写 → 抽象方法缺席虚表 → 抽象静态类型引用/指针调用 classVtableIndex miss →
//   IR 直调纯虚符号（无体无定义）；v2 解析类 抽象 分支不登记类虚槽 → 查虚方法槽
//   miss 直调 → 双侧 LNK2019 / undefined reference（m01/m02/p04/a03 四探针实证）。
//   修后：抽象=占虚槽（派生类有体重写沿链覆盖同槽）+ 纯虚槽 vtable 发射 0
//   （抽象类不可实例化+可实例化类该槽恒被有体重写覆盖=不可达防御·宿主三后端与
//   v2 三后端同构）。
//   面：①接口→抽象类→具体类中间层指针调抽象方法（周长 30）与非抽象重写（面积 75）；
//   ②甲乙丙三级重写经抽象基类指针动态分派（3/5）；③具体类直调对照（3）。
//   注：局部引用变量形态（甲& 参=对; 参.f()）v2 侧运行崩属 #1023（1020 轮 H2）
//   独立病灶，本用例以指针形态锁 1022 面。
接口 形状 {
    虚拟 函数 面积() -> 整64;
}

类 几何 : 形状 {
公开:
    重写 函数 面积() -> 整64 {
        返回 1;
    }
    抽象 函数 周长() -> 整64
}

类 圆 : 几何 {
公开:
    整64 半径;

    函数 圆(整64 r) {
        半径 = r;
    }

    重写 函数 面积() -> 整64 {
        返回 半径 * 半径 * 3;
    }

    重写 函数 周长() -> 整64 {
        返回 半径 * 6;
    }
}

类 甲 {
公开:
    抽象 函数 叫() -> 整64
}

类 乙 : 甲 {
公开:
    重写 函数 叫() -> 整64 {
        返回 3;
    }
}

类 丙 : 乙 {
公开:
    重写 函数 叫() -> 整64 {
        返回 5;
    }
}

函数 主() -> 整32 {
    圆 圆甲 = 圆(5);
    几何* 参 = 圆甲;
    打印("中间层多态面积: ", 参.面积());   // 5*5*3 = 75
    打印("中间层多态周长: ", 参.周长());   // 5*6 = 30（抽象方法虚分派）

    乙 乙对 = 乙();
    丙 丙对 = 丙();
    甲* 针 = 乙对;
    打印("乙对象经抽象指针: ", 针.叫());   // 3
    针 = 丙对;
    打印("丙对象经抽象指针: ", 针.叫());   // 5

    乙 直 = 乙();
    打印("具体类直调: ", 直.叫());        // 3
    返回 0;
}
