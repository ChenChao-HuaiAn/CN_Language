// E2E 74_self_host_ir：自举 Task 7.4——CN IR 生成器（2026-08）
// 输入：CN 源码；内部 分词->解析（AST 行）->IR 生成；输出：简化三地址 IR 行。
// 覆盖：函数头/参数/变量分配/常量/加载/二元运算/调用/返回。
导入 容器::向量;
导入 CN语言编译器::IR生成;

函数 主() -> 整32 {
    字符串 源码 = "函数 双倍(整64 值) -> 整64 {\n    返回 值 * 2;\n}\n函数 主() -> 整32 {\n    整64 数量 = 双倍(21);\n    打印(数量);\n    返回 0;\n}\n";
    向量<字符串> IR行 = IR生成(源码, "测试");
    整64 i = 0;
    当 (i < IR行.大小()) {
        打印(IR行.元素(i));
        i++;
    }
    返回 0;
}
