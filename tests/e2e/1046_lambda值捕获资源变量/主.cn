// E2E 1046_lambda值捕获资源变量（#940 扩面·dual 双编译对照）：
//   直接捕获资源变量（字符串/容器）的值捕获快照=定义处**深拷独立副本**
//   （001 §一D「值捕获快照语义无悬垂面」；#940 修复前裸句柄浅共享），断言面：
//     ① 字符串（字符串复制·堆串）：源重赋值释放旧堆串后闭包读快照=旧串
//        （修复前悬垂=空串）；
//     ② 容器（向量）：源重赋值释放旧容器后闭包读快照=大小 1/元素 42
//        （修复前悬垂=大小 0/元素(0) 越界崩溃）；
//     ③ 标量基线：源改写后闭包读旧值（既有语义零变化）。
//   结构体捕获面=1038（含资源字段结构体）；本用例=变量直捕面。
导入 容器::向量;

函数 主() -> 整32 {
    // ① 字符串值捕获（堆串·源重赋值）
    字符串 s = 字符串复制("甲甲甲甲");
    变量 f = [s]() -> 整32 { 打印(s); 返回 0; };
    s = 字符串复制("乙乙乙乙");
    f();                    // 甲甲甲甲（修复前=空串悬垂）
    // ② 容器值捕获（源重赋值）
    向量<整64> t = 向量<整64>();
    结果<空类型, 整32> 加 = t.追加(42);
    如果 (!加.正常) { 返回 40; }
    变量 g = [t]() -> 整32 { 打印(t.大小()); 返回 整32(t.元素(0)); };
    t = 向量<整64>();
    打印(g());              // 1 / 42（修复前=0/越界崩溃）
    // ③ 标量基线
    整32 k = 5;
    变量 h = [k]() -> 整32 { 打印(k); 返回 0; };
    k = 9;
    h();                    // 5
    返回 0;
}
