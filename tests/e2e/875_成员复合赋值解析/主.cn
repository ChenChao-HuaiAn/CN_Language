// E2E 875（536 正测·dual 双编译对照·断言输出）：成员左值复合赋值语句解析
//   完整性——536 探针「卡.名 += "三"」经根因收口（874：红色源自结构体定义
//   的体后分号，语句本身与 46 形态矩阵全绿无关）后锁「语句形态本身全绿」面：
//   结构体字符串/数值字段 += / 结构体字面量初始化后 += / 嵌套成员链 += /
//   类实例字段 += / 对照（536 备注）：下标左值 += 与标识符左值 +=。
//   语法依据：01b 复合赋值运算符 + 06 类字段访问 + 001 §3.7 第④族
//   「复合赋值 等价展开 甲 = 甲 + X」（86：+= 走 + 拼接同糖通道）。
结构体 卡 {
    字符串 名;
    整32 计数;
}
结构体 内芯 { 字符串 分; }
结构体 外壳 { 内芯 芯; }
类 柜 {
公开:
    字符串 牌;
    函数 柜() { 牌 = "柜"; }
}
函数 主() -> 整32 {
    卡 卡;
    卡.名 = "一";
    卡.名 += "三";
    打印(卡.名);            // 一三（536 探针原形·语句本身合法）
    卡.计数 = 1;
    卡.计数 += 2;
    打印(卡.计数);          // 3
    卡 乙 = 卡{ 名 = "甲", 计数 = 5 };
    乙.名 += "乙";
    打印(乙.名);            // 甲乙
    外壳 壳 = 外壳{ 芯 = 内芯{ 分 = "上" } };
    壳.芯.分 += "下";
    打印(壳.芯.分);         // 上下
    柜 g = 柜();
    g.牌 += "台";
    打印(g.牌);             // 柜台
    字符串[2] 串们;
    串们[0] = "一";
    串们[0] += "二";
    打印(串们[0]);          // 一二（下标左值对照）
    字符串 甲 = "a";
    甲 += "b";
    打印(甲);               // ab（标识符左值对照）
    返回 0;
}
