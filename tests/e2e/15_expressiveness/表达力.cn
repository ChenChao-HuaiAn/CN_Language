// 语言表达力增强（Task 2.9）：三元表达式 / 字符串+数值隐式拼接 / 格式化 / 打印打印行语义
// 覆盖：
//   1. 三元表达式：正反用例、嵌套右结合、数值宽化合并（整32 与 浮64）
//   2. 字符串 + 数值 隐式拼接：整数/浮点/布尔/字符/枚举、多操作数左结合
//   3. 格式化()：%d/%u/%f/%s/%c/%x/%X/%o/%p、拼接产物 字符串释放
//   4. 打印（println 换行）/ 打印行（print 不换行）语义
// 语法依据（cn-language-spec 01b/02）：三元优先级1.5右结合、数值→字符串仅+拼接语境
函数 主() -> 整32 {
    // ---- 1. 三元表达式 ----
    整32 x = 10;
    打印("三元正: ", x > 0 ? "正" : "负");        // 三元正: 正
    打印("三元反: ", x < 0 ? "正" : "负");        // 三元反: 负
    打印("三元数: ", x > 5 ? 100 : 200);          // 三元数: 100
    打印("三元浮: ", x > 5 ? 1.5 : 2.5);          // 三元浮: 1.500000
    打印("嵌套三元: ", x > 0 ? (x > 5 ? "大" : "小") : "非正");  // 嵌套三元: 大
    打印("三元惰性: ", 真 ? 字符串长度("abc") : 字符串长度("abcdefghij"));  // 三元惰性: 3
    // 嵌套右结合：a ? b : c ? d : e = a ? b : (c ? d : e)
    打印("右结合: ", 假 ? "一" : 假 ? "二" : "三");  // 右结合: 三

    // ---- 2. 字符串 + 数值 隐式拼接 ----
    打印("你好，世界" + 123);                      // 你好，世界123
    打印("结果=" + 3.14);                         // 结果=3.140000
    打印("布尔=" + 真);                           // 布尔=真
    打印("布尔=" + 假);                           // 布尔=假
    打印("字符=" + 'A');                          // 字符=A
    打印("多操作数: " + 1 + 2);                   // 多操作数: 12
    打印("混合: " + 1 + " + " + 2.5);             // 混合: 1 + 2.500000
    整64 大数 = 1000000000L;
    打印("整64拼接: " + 大数);                    // 整64拼接: 1000000000
    打印("字符串变量拼接: ", "值" + 42);          // 字符串变量拼接: 值42

    // 拼接产物内存由调用方释放（连接/转换均为动态内存）
    字符串 拼接 = "A" + 1 + 2 + 3;
    打印("拼接产物: ", 拼接);                     // 拼接产物: A123
    字符串释放(拼接);

    // ---- 3. 格式化() ----
    字符串 格1 = 格式化("值%d 浮点%f", 42, 3.14);
    打印("格式化1: ", 格1);                       // 格式化1: 值42 浮点3.140000
    字符串释放(格1);
    字符串 格2 = 格式化("%s 世界", "你好");
    打印("格式化2: ", 格2);                       // 格式化2: 你好 世界
    字符串释放(格2);
    字符串 格3 = 格式化("字符%c 十六%x 大写%X 八%o", 65, 255, 255, 8);
    打印("格式化3: ", 格3);                       // 格式化3: 字符A 十六ff 大写FF 八10
    字符串释放(格3);
    字符串 格4 = 格式化("无符号%u", 4000000000U);
    打印("格式化4: ", 格4);                       // 格式化4: 无符号4000000000
    字符串释放(格4);
    // 注：%p（指针十六进制地址）输出不定，放单元测试（test_format_api.cpp）断言前缀；
    //     此处用 %x 覆盖十六进制小写（%X 大写已在 格3 覆盖）
    字符串 格5 = 格式化("十六%x", 4096);
    打印("格式化5: ", 格5);                       // 格式化5: 十六1000
    字符串释放(格5);

    // ---- 4. 打印 / 打印行 语义 ----
    打印("打印自动换行");
    打印("第二行");                               // 打印 每次自动换行
    打印行("打印行不换行");
    打印行("继续同一行");                          // 打印行 不换行，两段连在一起
    打印("");
    打印("分隔完成");

    返回 0;
}
