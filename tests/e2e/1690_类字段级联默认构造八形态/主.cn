// 001 §3.9 类类型字段级联默认构造·正形态族（#1943 双编译对照锁面）：
//   类实例构造时其类类型字段由编译器自动级联调用默认构造；字段类无用户
//   构造=合成默认构造（仅分配）。七形态各一函数·主函数依序调用：
//   ①类嵌类裸声明写读 ②容器字段裸声明追加 ③用户构造+字段类无构造
//   ④方法内经 this 类字段 ⑤容器字段只读大小 ⑥字段类有构造裸声明
//   ⑦外类有构造裸声明（构造序言级联既有面·保持绿）
导入 容器::向量;

类 内C {
公开:
    整32 v;
}

类 内C2 {
公开:
    整32 v;
    函数 内C2() { v = 5; }
}

类 外C {
公开:
    内C 里的;
    函数 写入(整32 x) { 里的.v = x; }
    函数 读取() -> 整32 { 返回 里的.v; }
}

类 外5 {
公开:
    内C 里的;
    函数 外5() { }
}

类 外3 {
公开:
    内C2 里的;
}

类 外4 {
公开:
    内C2 里的;
    函数 外4() { }
}

类 持列 {
公开:
    向量<整32> 列;
}

函数 形态裸声明写读() -> 整32 {
    外C w;
    w.里的.v = 7;
    打印(w.里的.v);
    返回 0;
}

函数 形态容器字段追加() -> 整32 {
    持列 h;
    结果<空类型, 整32> r = h.列.追加(9);
    打印(h.列.大小());
    返回 0;
}

函数 形态用户构造类字段() -> 整32 {
    外5 w = 外5();
    w.里的.v = 7;
    打印(w.里的.v);
    返回 0;
}

函数 形态方法内访问() -> 整32 {
    外C w;
    w.写入(7);
    打印(w.读取());
    返回 0;
}

函数 形态容器字段只读() -> 整32 {
    持列 h;
    打印(h.列.大小());
    返回 0;
}

函数 形态字段类有构造() -> 整32 {
    外3 w;
    打印(w.里的.v);
    返回 0;
}

函数 形态外类有构造裸声明() -> 整32 {
    外4 w;
    打印(w.里的.v);
    返回 0;
}

函数 主() -> 整32 {
    整32 a = 形态裸声明写读();
    整32 b = 形态容器字段追加();
    整32 c = 形态用户构造类字段();
    整32 d = 形态方法内访问();
    整32 e = 形态容器字段只读();
    整32 f = 形态字段类有构造();
    整32 g = 形态外类有构造裸声明();
    返回 a + b + c + d + e + f + g;
}
