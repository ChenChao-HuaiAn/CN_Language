// 686(#321 收口锁用例·2026-10-10 家机·权料=cnsmith_hits/build_err/c320_b2+c320_w4)：
//   v16 采样命中 A 面——字段类型表剥星三联病根（登记星号规范化/46a 载荷判定/
//   解析成员链剥星·IR布局.cn 字段类型星号规范化 根修）修前两形态 v2 全断：
//   ①互引用指针字段链读 b.q.v 读垃圾值（宿主=1 正确·v2 修前 -673186800）
//   ②链表当循环遍历 v2 裸崩 0xC0000005（宿主 6/5 正确·指针字段被误判
//     「结构体载荷」压地址不取值 → p = p.下一个 存地址非存值）
//   预期：宿主/v2 双侧同输出 1/2/6/5（正测双测·逐行全等）。
//   注：打印=println 换行（001 打印语义用户裁决·权重10.4）——逐行比对用 打印。
结构体 甲 {
    整32 v;
    整32 备用;
}
结构体 乙 {
    整32 w;
    甲* q;
}
结构体 节点 {
    整32 值;
    节点* 下一个;
}
不安全 函数 主() -> 整32 {
    // 形态①：互引用双结构体·指针字段链读（b2）
    甲 a = 甲{ v = 1, 备用 = 0 };
    乙 b = 乙{ w = 2, q = &a };
    打印(b.q.v);
    打印(b.w);
    // 形态②：自引用链表·当循环遍历（w4）
    节点 n1 = 节点{ 值 = 5, 下一个 = 无 };
    节点 n2 = 节点{ 值 = 6, 下一个 = &n1 };
    节点* p = &n2;
    当 (p != 无) {
        打印(p.值);
        p = p.下一个;
    }
    返回 0;
}
