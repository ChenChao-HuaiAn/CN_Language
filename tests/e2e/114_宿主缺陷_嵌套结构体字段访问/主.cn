// 114_宿主缺陷_嵌套结构体字段访问（2026-08-25）：结果<结构体>.值.字段 直接访问
//   ——此前「链式结构体方法返回.直接取字段」宿主缺陷：查.值.名ID 生成 调用 0
//   （不读字段）。本轮根治三个叠加缺陷：
//   ① 结果/可选 局部变量合成结构体未提前降级 -> IR 槽分配 1 槽（应 2+ 槽），
//      CopyStruct 溢出覆盖相邻变量槽（p.x 被写 &p 实测）；
//   ② visitMemberExpr 嵌套成员对象类型推导不识别 结果.值 成员映射 -> 常量 0；
//   ③ handleResultCtor 结构体值 StorePtr 存地址（应 CopyStruct 内联）+ 结构体
//      字段读 LoadPtr（应返回字段地址）；错误() 存 E 而非 T（错误码当地址崩溃）。
// 覆盖：
//   1. 结果<符号,整32>.值.名ID 直接嵌套访问（根治前打印 0/地址）
//   2. 临时变量 查.值 再取字段（对照）
//   3. 错误路径：结果.正常 为假时 .错误 读取错误码（错误() 存 E）
//   4. 正常() 结构体值内联存储（查.值.名ID 读数据非地址）

结构体 符号 {
    整64 名ID
    整64 类型ID
    整64 深度
}

函数 主() -> 整32 {
    符号 s
    s.名ID = 5
    s.类型ID = 101
    s.深度 = 0

    // 1. 直接嵌套访问（根治前打印 0）
    结果<符号, 整32> 查 = 正常(s)
    如果 (查.正常) {
        打印("嵌套[名ID]: ", 查.值.名ID)
        打印("嵌套[类型ID]: ", 查.值.类型ID)
    } 否则 {
        打印("查: 错误分支")
    }

    // 2. 临时变量对照
    结果<符号, 整32> 查2 = 正常(s)
    如果 (查2.正常) {
        符号 取到 = 查2.值
        打印("临时[名ID]: ", 取到.名ID)
    } 否则 {
        打印("查2: 错误分支")
    }

    // 3. 错误路径：错误(7) -> E=整32，.错误 读错误码
    结果<整32, 整32> 坏 = 错误(7)
    如果 (坏.正常) {
        打印("坏: 正常分支")
    } 否则 {
        打印("坏.错误: ", 坏.错误)
    }

    返回 0
}
