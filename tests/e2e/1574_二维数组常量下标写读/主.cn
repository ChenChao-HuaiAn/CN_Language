// 1574（#1676 锁面·宿主正例）：二维数组常量下标写读。
//   修复前宿主 arrayElemOf rfind 剥最后一维——整32[2][3] 元素类型算成 整32[2]，
//   m[1][2] 合法下标被误拦「编译期下标越界：下标 2 超出数组长度 2」。
//   修复后：元素类型=整32[3]、长度口径=第一维。
函数 主() -> 整32 {
    整32[2][3] 矩阵;
    矩阵[0][0] = 1;
    矩阵[1][2] = 6;
    打印(矩阵[0][0]);
    打印(矩阵[1][2]);
    矩阵[0][1] = 2;
    矩阵[0][2] = 3;
    矩阵[1][0] = 4;
    矩阵[1][1] = 5;
    整32 和 = 0;
    循环 (整32 i = 0; i < 2; i++) {
        循环 (整32 j = 0; j < 3; j++) {
            和 = 和 + 矩阵[i][j];
        }
    }
    打印(和);
    返回 0;
}
