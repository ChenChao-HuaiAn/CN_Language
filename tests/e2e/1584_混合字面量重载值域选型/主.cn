// 1584 混合字面量重载值域选型（#1263 根治锁·宿主 semantic_sig conversionLevel）：
//   ①字面量豁免值域判据：4000000000L 数学值超整32 域→整32 重载候选淘汰·唯一选
//     整64 重载（原=两候选 total 相等→误歧义拒绝·合法调用被拒）
//   ②逐参支配：total 相等不再直接歧义（C++ 语义·互不支配才真歧义→1585 负测）
//   ③既有面回归锚：无后缀超域字面量选整64（910 面）/整32 精确 0 级保留（55-c
//     `读值(100)` 传 正32 合法面）/L 后缀选整64/构造器重载同面（#1588 校准族）
函数 加(整32 甲, 整32 乙) -> 整32 {
    返回 甲 + 乙;
}
函数 加(整64 甲, 整64 乙) -> 整64 {
    返回 甲 + 乙;
}
函数 取(整32 甲) -> 整32 {
    返回 甲;
}
函数 取(整64 甲) -> 整64 {
    返回 甲;
}
函数 主() -> 整32 {
    // ①值域淘汰：4000000000L 超整32 域→选整64 重载
    整64 和 = 加(4000000000L, 1);
    打印(和);
    // ②无后缀超域选整64（910 既有面）
    打印(取(3000000000));
    // ③整32 字面量精确 0 级（55-c 合法面保留）
    打印(取(100));
    // ③bL 后缀选整64
    打印(取(1L));
    返回 0;
}
