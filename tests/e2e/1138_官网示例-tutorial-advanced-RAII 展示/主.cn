//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
导入 容器::向量;

函数 主() -> 整32 {
    字符串 s = "堆上";            // 拥有型：分配落堆
    向量<字符串> 表 = 向量<字符串>();
    结果<空类型, 整32> 加 = 表.追加("元素一");
    加 = 表.追加("元素二");
    返回 0;                        // s、表、表内元素全部自动释放
}