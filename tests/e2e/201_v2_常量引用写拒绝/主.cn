// E2E 201（宿主负测，2026-09-10 第五十九轮 plans/019 阶段3）：
//   常量引用只读借用纪律四负形态：①赋值 ②复合赋值 ③传可变引用（只读借出
//   可变拒）④同调用可变×只读互斥（借用互斥第一版：语句级）。
//   期望编译失败.txt 固化诊断子串「只读借用」。
函数 改(整64& 目标) -> 空类型 {
    目标 = 9;
}
函数 混(整64& 可写位, 常量 整64& 只读位) -> 空类型 {
}
函数 坏1(常量 整64& 值) -> 整32 {
    值 = 5;
    返回 0;
}
函数 坏2(常量 整64& 值) -> 整32 {
    值 += 5;
    返回 0;
}
函数 坏3(常量 整64& 值) -> 整32 {
    改(值);
    返回 0;
}
函数 坏4(整64& 甲) -> 整32 {
    混(甲, 甲);
    返回 0;
}
函数 主() -> 整32 {
    返回 0;
}
