//   左值形态根治修复漏检，②`值 += 5`（行=15）v2 侧新增第 4 条诊断·宿主
//   同形态 4 拒对齐（测试升级报备后实施·用户令 881 本机直接实施）。
函数 改(整64& 目标) -> 空类型 {
    目标 = 9;
}
函数 混(整64& 可写位, 常量 整64& 只读位) -> 空类型 {
}
函数 坏1(常量 整64& 值) -> 整32 {
    值 = 5;
    返回 0;
}
函数 坏2(常量 整64& 值) -> 整32 {
    值 += 5;
    返回 0;
}
函数 坏3(常量 整64& 值) -> 整32 {
    改(值);
    返回 0;
}
函数 坏4(整64& 甲) -> 整32 {
    混(甲, 甲);
    返回 0;
}
函数 主() -> 整32 {
    返回 0;
}
