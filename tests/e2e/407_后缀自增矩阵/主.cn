// 407 后缀自增矩阵（297-a·T24 根治守护）：后缀 i++ 表达式值=自增前原值（C 语义），
//   前缀 ++i=新值；写回正确；成员/窄型/语句位全形态。
函数 消费(整32 v) -> 整32
{
    返回 v * 10;
}
结构体 盒子
{
    整32 值;
}
函数 主() -> 整32
{
    整32 i = 3;
    整32 j = i++;
    打印("g01=", j);
    打印("g02=", i);
    整32 k = 5;
    打印("g03=", 消费(k++));
    打印("g04=", k);
    整32 m = 7;
    整32 n = m--;
    打印("g05=", n);
    打印("g06=", m);
    整32 p = 2;
    布尔 c1 = (p++ < 3);
    打印("g07=", c1);
    打印("g08=", p);
    整32 q = 3;
    整32 r = ++q;
    打印("g09=", r);
    整32 u = 9;
    打印("g10=", u++);
    打印("g11=", u);
    整32 w = 0;
    w++;
    w++;
    打印("g12=", w);
    盒子 箱 = 盒子{ 值 = 10 };
    整32 旧 = 箱.值++;
    打印("g13=", 旧);
    打印("g14=", 箱.值);
    整16 s = 5;
    整32 t = s++;
    打印("g15=", t);
    打印("g16=", 整32(s));
    返回 0;
}
