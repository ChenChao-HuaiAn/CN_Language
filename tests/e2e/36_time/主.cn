// 时间库 E2E（Task 6.5，对标 C++ chrono/ctime）
// 覆盖：
//   1. 当前时间戳（时间::当前时间戳 内置直调）：两次调用第二次 ≥ 第一次
//   2. 单调时钟毫秒（时间::单调时钟毫秒 内置直调）：两次调用第二次 ≥ 第一次
//   3. 格式化时间（时间::格式化时间 内置直调）："%Y-%m-%d" 长度=10、分隔符位置、
//      "%Y" 4 位数字年份、非法时间戳失败
// E2E 输出比对是固定文本——时间戳数值不固定，故程序内部断言（递增/长度/分隔符），
//   只输出 真/假 布尔结果（布尔打印为 1/0）与固定标签
// 调用方式：直接调用时间库内置函数（时间::xxx，全局注册、无需导入），
//   由编译器 IR 层映射到运行时 __cn_time/__cn_clock_ms/__cn_time_format
//   ——与 stdlib/时间.cn 模块封装同名（25_math 数学库同模式：E2E 直接验证内置）
// 打印语义（用户裁决）：打印=println（自动换行）
// 注意：格式化时间 返回动态字符串，用完必须 字符串释放；失败返回 nullptr

函数 主() -> 整32 {
    打印("===== 时间库（Task 6.5）=====");

    // ==================== 1. 当前时间戳（秒级，递增） ====================
    整64 戳1 = 时间::当前时间戳();
    整64 戳2 = 时间::当前时间戳();
    打印("时间戳合理: ", 戳2 >= 戳1);       // 1（第二次 ≥ 第一次）
    打印("时间戳大于0: ", 戳1 > 0);         // 1（Unix 纪元后）

    // ==================== 2. 单调时钟毫秒（递增） ====================
    整64 毫1 = 时间::单调时钟毫秒();
    整64 毫2 = 时间::单调时钟毫秒();
    打印("时钟毫秒合理: ", 毫2 >= 毫1);     // 1

    // ==================== 3. 格式化时间 ====================
    // "%Y-%m-%d" → "2026-08-14" 形态：长度=10、第4/7位是 '-'
    字符串 日期 = 时间::格式化时间(戳1, "%Y-%m-%d");
    如果 (日期 != 无) {
        布尔 长度对 = 字符串长度(日期) == 10;
        // 字符串比较运算符（==）规格书未定义——用 字符串比较 内置（相等返回 真）
        字符串 分隔符1 = 字符串子串(日期, 4, 1);
        字符串 分隔符2 = 字符串子串(日期, 7, 1);
        布尔 分隔对 = 字符串比较(分隔符1, "-") && 字符串比较(分隔符2, "-");
        打印("日期长度=10: ", 长度对);       // 1
        打印("日期分隔符: ", 分隔对);         // 1
        // 日期内容随运行日期变化（E2E 固定文本比对不能打印实际值）
        字符串释放(分隔符1);
        字符串释放(分隔符2);
        字符串释放(日期);
    } 否则 {
        打印("格式化时间失败");
    }

    // "%Y" → 4 位数字年份（内容随年份变化，只断言长度）
    字符串 年 = 时间::格式化时间(戳1, "%Y");
    如果 (年 != 无) {
        打印("年份长度=4: ", 字符串长度(年) == 4);  // 1
        字符串释放(年);
    } 否则 {
        打印("格式化年份失败");
    }

    // 非法时间戳（负数）→ nullptr → 失败
    字符串 非法 = 时间::格式化时间(-1, "%Y");
    如果 (非法 != 无) {
        打印("非法时间戳处理: ", 非法);
        字符串释放(非法);
    } 否则 {
        打印("非法时间戳失败");              // 失败
    }

    打印("===== 时间库测试完成 =====");
    返回 0;
}
