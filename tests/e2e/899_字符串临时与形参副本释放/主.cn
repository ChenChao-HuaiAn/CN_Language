// E2E 899（616+617 伞批·字符串临时生命周期泄漏族根治·内存安全回归）：
//   断言口径：每形态调用前后 内存::活动分配数() 差值（残留）恒为 0——
//   ① #616 消耗形参（prologue 深拷副本）出口释放：重赋值/字符串释放/类方法/转移 四形态；
//   ② #617 打印族/格式化/谓词族 变参通道拥有临时串调用方结算（拼接链中间临时同点归零）。
//   v2 成对=899_v2_（同一源码 v2 自举链各编各跑·双侧零分叉锁）。

函数 消耗形参(字符串 s) -> 空类型 {
    s = 字符串复制("形参内重赋值新串");
    打印行("消耗形参改为:", s);
}

函数 释放形参(字符串 s) -> 空类型 {
    字符串释放(s);
}

类 工具 {
公开:
    函数 工具() { }
    函数 消耗方法(字符串 s) -> 空类型 {
        s = 字符串复制("方法内重赋值");
        打印行("方法收到改后:", s);
    }
}

函数 主() -> 整32 {
    // ① #616 消耗形参重赋值：副本出口释放+调用方变量完好
    字符串 片甲 = 字符串复制("甲乙丙丁戊己庚辛");
    整64 m0 = 内存::活动分配数();
    消耗形参(片甲);
    打印("① 消耗形参重赋值 残留:", 内存::活动分配数() - m0);
    打印行("片甲仍可用:", 片甲);

    // ② #616 字符串释放(形参)：消耗标记后释放只作用于自身副本
    字符串 片乙 = 字符串复制("子丑寅卯辰巳午未");
    整64 n0 = 内存::活动分配数();
    释放形参(片乙);
    打印("② 字符串释放形参 残留:", 内存::活动分配数() - n0);
    打印行("片乙仍可用:", 片乙);
    字符串释放(片乙);

    // ③ #616 类方法消耗形参：同①（方法面）
    工具 t = 工具();
    字符串 片丙 = 字符串复制("申酉戌亥");
    整64 p0 = 内存::活动分配数();
    t.消耗方法(片丙);
    打印("③ 类方法消耗形参 残留:", 内存::活动分配数() - p0);
    打印行("片丙仍可用:", 片丙);
    字符串释放(片丙);

    // ④ #616 转移(形参)：副本移交后出口空安全
    字符串 片丁 = 字符串复制("甲子乙丑");
    整64 q0 = 内存::活动分配数();
    消耗形参转移(片丁);
    打印("④ 转移形参 残留:", 内存::活动分配数() - q0);
    字符串释放(片丁);

    // ⑤ #617 打印顶层 整数转字符串 临时
    整64 r0 = 内存::活动分配数();
    打印("x=", 整数转字符串(42));
    打印("⑤ 打印转字符串临时 残留:", 内存::活动分配数() - r0);

    // ⑥ #617 打印行 拼接链（中间临时+顶层临时同点归零）
    整64 s0 = 内存::活动分配数();
    打印行("拼接前缀=" + 片甲 + "=后缀");
    打印("⑥ 打印拼接链临时 残留:", 内存::活动分配数() - s0);

    // ⑦ #617 格式化 作打印实参临时
    整64 t0 = 内存::活动分配数();
    打印("⑦ 值=", 格式化("值={0}尾", 7));
    打印("⑦ 打印格式化临时 残留:", 内存::活动分配数() - t0);

    // ⑧ #617 谓词族实参临时（字符串包含）
    字符串 文本 = 字符串复制("目标串内容在这里");
    整64 u0 = 内存::活动分配数();
    如果 (字符串包含(文本, 整数转字符串(5))) {
        打印行("包含命中");
    }
    打印("⑧ 谓词族实参临时 残留:", 内存::活动分配数() - u0);

    // ⑨ #617 累积：打印临时连做 3 次
    整64 v0 = 内存::活动分配数();
    打印("v1=", 整数转字符串(1));
    打印("v2=", 整数转字符串(2));
    打印("v3=", 整数转字符串(3));
    打印("⑨ 打印临时连做3次 残留:", 内存::活动分配数() - v0);

    // ⑩ 对照：拼接结果赋变量+手动释放=健康基线
    整64 x0 = 内存::活动分配数();
    字符串 对照 = "对照" + 片甲;
    打印行("对照变量:", 对照);
    字符串释放(对照);
    打印("⑩ 手动释放对照 残留:", 内存::活动分配数() - x0);

    // ⑪ #617 用户函数返回串临时直入打印（对齐补锁：返回=所有权移交调用方，
    //   打印完成后调用方释放——宿主 funcReturnTypeOf 与 v2 函数返回类型们
    //   双侧同判，残留恒 0）
    整64 w0 = 内存::活动分配数();
    打印行("⑪值=", 造串617(7));
    打印("⑪ 用户函数返回串临时 残留:", 内存::活动分配数() - w0);

    字符串释放(文本);
    字符串释放(片甲);
    返回 0;
}

函数 消耗形参转移(字符串 s) -> 空类型 {
    字符串 接收 = 转移(s);
    打印行("转移接收:", 接收);
    字符串释放(接收);
}

函数 造串617(整32 n) -> 字符串 {
    返回 "用户串" + 整数转字符串(n);
}
