// E2E 1406（#1962 执法三·装箱接管 miss 探针·单侧 v2 通道·修前红修后绿）：
//   引用返回类调用（仓.元素引用(0) -> 载物&）作盒载荷实参
//   （结果<载物,整32> = 正常(...)）——
//   修前：IR 层 是引用返回调用（生成表达式装箱 类载荷例外面/盒载荷所有权
//     盒返回载荷拥有/初值移交临时 三消费族）两源 walk miss 容器内置方法 →
//     「实参是调用临时」误真 → 按无主临时句柄直移交（盒=唯一拥有者·临时无
//     析构面假设不成立——实参=容器槽有主借用 place）→ 内块出口 盒亡 free
//     源槽对象 → 块外 查证.名 悬垂读（内容垃圾→源稳假）+ 仓 析构再 free
//     源槽 double-free → rc≠0/校验≠3 红；
//   修后：登记面查表命中「载物&」尾 '&' → 引用返回调用=借用 place 排除出
//     移交例外面 → 走拷贝构造深拷（源地址回扫·盒=独立副本）→ 盒亡 free 副本
//     无害 → 源槽完好 → rc=0 绿。
// 校验位：位1=盒内副本内容真；位2=盒亡后源槽读值稳定（非悬垂）。
// 宿主侧同面（正常(容器.元素引用()) 装箱）实录 C0000005 崩（宿主
//   isRefReturnCall 对容器内置方法同 miss·双侧对称缺陷）——宿主侧另案，
//   本用例单侧锁 v2 修复面（v2闭环 通道）。
导入 容器::向量;
类 载物 {
公开:
    字符串 名;
    函数 载物(字符串 s) {
        名 = s;
    }
    不安全 函数 载物(载物& 其他) {
        名 = 字符串复制(其他.名);
    }
    不安全 函数 ~载物() {
    }
}
函数 主() -> 整32 {
    布尔 盒真 = 假;
    布尔 源稳 = 假;
    {
        向量<载物> 仓 = 向量<载物>();
        结果<空类型, 整32> 追丙 = 仓.追加(载物("盒载物丁"));
        如果 追丙.正常 {
        } 否则 {
            打印(追丙.错误);
        }
        {
            结果<载物, 整32> 盒 = 正常(仓.元素引用(0));
            如果 盒.正常 {
                盒真 = 字符串比较(盒.值.名, "盒载物丁");
            } 否则 {
                打印(盒.错误);
            }
        }
        载物& 查证 = 仓.元素引用(0);
        源稳 = 字符串比较(查证.名, "盒载物丁");
    }
    整32 校验 = 0;
    如果 (盒真) { 校验 = 校验 + 1; }
    如果 (源稳) { 校验 = 校验 + 2; }
    打印("执法三装箱借用面绿");
    返回 校验;
}
