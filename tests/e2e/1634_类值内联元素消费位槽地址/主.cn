// E2E 1634（981/#1744 主案锁面·宿主+v2 双编译）：类值**内联数组元素**的四个
//   消费位——①复制() 类分支（981 崩溃主形态·win 十跑七崩 C0000005）
//   ②类字段赋值（183-a 深拷通道·源=内联元素）③引用形参实参（wrapRefArgs
//   内部引用机制·源=内联元素）④类变量赋值（095 旧值释放通道·源=内联元素·
//   须深拷独立拥有，源重写不波及目标）。根因=类值在槽中的表示=对象指针
//   （句柄），拷贝构造/引用形参 byRef 约定=「槽地址（体内一层 Load 得对象
//   指针）」；数组元素=缓冲内的联结构体（无句柄槽），直传元素地址使体内把
//   元素首字段（数据指针）当对象指针再解引用 → 非确定性越界崩 / 静默错值 /
//   双主堆损坏（C0000374）。修=genClassValueSlotAddress 物化单点（临时槽
//   存元素本体地址，传槽地址）。
导入 容器::向量;

类 盒 {
公开:
    向量<整32> 内容;
    不安全 函数 盒() { }
}

函数 取大小(向量<整32>& 参) -> 整64 {
    返回 参.大小();
}

函数 主() -> 整32 {
    向量<整32>[2] 组;
    向量<整32> 元;
    结果<空类型, 整32> 加1 = 元.追加(7);
    如果 (!加1.正常) { 返回 1; }
    组[0] = 元;
    // ① 复制() 类分支：内联元素深拷独立拥有
    向量<整32> 复 = 复制(组[0]);
    打印(复.大小());
    // ② 类字段赋值 ← 内联元素（183-a 深拷通道）
    盒 甲;
    甲.内容 = 组[0];
    打印(甲.内容.大小());
    // ③ 引用形参实参 ← 内联元素（byRef 槽地址约定）
    打印(取大小(组[0]));
    // ④ 类变量赋值 ← 内联元素：深拷独立拥有（源重写后目标仍 1）
    向量<整32> 拷;
    拷 = 组[0];
    打印(拷.大小());
    向量<整32> 另;
    结果<空类型, 整32> 加2 = 另.追加(9);
    结果<空类型, 整32> 加3 = 另.追加(9);
    如果 (!加2.正常) { 返回 2; }
    如果 (!加3.正常) { 返回 3; }
    组[0] = 另;
    打印(组[0].大小());
    返回 0;
}
