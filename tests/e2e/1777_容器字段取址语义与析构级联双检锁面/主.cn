导入 容器::向量;
导入 映射集合::映射;

// E2E 1777（#1970 内联头两态归一·2058 修复轮·1601 历史翻车位「字段地址」
//   用户层锁面）：容器实例字段取地址通道按基对象两态分流（判据单点=
//   「容器字段是类内联域」）——
//   ①基对象=类（字段=内联域）：&对象.字段=头地址（本体地址·001「字段
//     地址=对象地址」条文）；经址操作写穿同一头（非副本）；
//   ②基对象=结构体（字段=句柄槽）：&条目.表=LoadPtr 解包句柄（壳句柄=
//     堆壳对象地址·与「类变量取地址=解包句柄」条文同构）——槽地址直发
//     =「AddrOf(槽) 二级错位」588-a 形态复发（指针值=槽地址·成员调用
//     this 在句柄槽上跑=段错误·修前实证）；
//   ③引用局部绑定类字段源=物化槽（槽内=头地址·引用槽=物化槽地址·体内
//     一层 LoadPtr 得本体=A-1 契约；头地址直存被再解引用=[头地址]=数据
//     指针当本体）；引用形参消费同契约；
//   ④取址+操作后析构零泄漏不崩；⑤结构体容器字段取址同语义（860-a
//     通道）。
//   析构级联与字段地址双检：1761 锁级联内存锚，本用例锁取址语义面。

类 持表 {
公开:
    向量<整32> 名单;
    整64 序号;
    函数 持表() {
        序号 = 42;
    }
    函数 ~持表() {
    }
}

结构体 记 {
    整64 头;
    向量<整32> 表;
}

不安全 函数 主() -> 整32 {
    整32 校验 = 0;
    // 位1（=1）空容器取址读零头（错址读垃圾）
    {
        持表 对象 = 持表();
        向量<整32>* 址名 = &对象.名单;
        如果 (址名.大小() == 0) { 校验 = 校验 + 1; }
    }
    // 位2（=2）经址追加写穿字段（同一头·非副本）
    {
        持表 对象 = 持表();
        向量<整32>* 址名 = &对象.名单;
        结果<空类型, 整32> 追1 = 址名.追加(7);
        如果 (对象.名单.大小() == 1 && 对象.名单.元素(0) == 7) {
            校验 = 校验 + 2;
        }
    }
    // 位4（=4）字段追加经址可见（反向同一性）
    {
        持表 对象 = 持表();
        向量<整32>* 址名 = &对象.名单;
        结果<空类型, 整32> 追1 = 对象.名单.追加(9);
        如果 (址名.大小() == 1 && 址名.元素(0) == 9) { 校验 = 校验 + 4; }
    }
    // 位8+位16（=24）取址操作后析构零泄漏不崩（1601 翻车位析构级联联检）
    {
        整64 前 = 内存::活动分配数();
        {
            持表 对象 = 持表();
            向量<整32>* 址名 = &对象.名单;
            结果<空类型, 整32> 追1 = 址名.追加(7);
            结果<空类型, 整32> 追2 = 址名.追加(8);
            如果 (址名.大小() == 2 && 对象.序号 == 42) { 校验 = 校验 + 8; }
        }
        整64 后 = 内存::活动分配数();
        如果 (后 == 前) { 校验 = 校验 + 16; }
    }
    // 位32（=32）结构体容器字段取址（句柄槽解包语义）+析构零泄漏
    {
        整64 前 = 内存::活动分配数();
        {
            记 条目 = 记{ 头 = 5, 表 = 向量<整32>() };
            向量<整32>* 址表 = &条目.表;
            结果<空类型, 整32> 追1 = 址表.追加(11);
            如果 (条目.表.大小() == 1 && 条目.表.元素(0) == 11 &&
                 条目.头 == 5) { 校验 = 校验 + 32; }
        }
        整64 后 = 内存::活动分配数();
        如果 (后 == 前) { 校验 = 校验 + 32; }
    }
    打印("校验=", 校验);
    如果 (校验 == 95) { 返回 0; }
    返回 1;
}
