// 官网文档示例 · tutorial-syntax.html · 控制流（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
函数 分级(整32 分) -> 字符串 {
    如果 分 >= 90 {
        返回 "优";
    } 否则 如果 分 >= 60 {
        返回 "及格";
    } 否则 {
        返回 "不及格";
    }
}

函数 主() -> 整32 {
    打印(分级(95), " ", 分级(70), " ", 分级(30));

    整32 i = 0;
    当 i < 3 {                 // 当循环（前测）
        打印行(i, " ");
        i++;
    }
    打印("");

    循环 (整32 j = 10; j >= 0; j -= 5) {   // for 风格
        打印行(j, " ");
    }
    打印("");
    返回 0;
}