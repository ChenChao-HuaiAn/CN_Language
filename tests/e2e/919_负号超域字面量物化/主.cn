// E2E 919（2026-10-14·任务 #728g 锁面·P1）：负号超域字面量物化值域——
//   无后缀字面量标记域恒整32、求值域按值（420 提升链），「一元负号+字面量」经
//   parser 323 解析期折叠为带负号 raw/负值的单一 IntegerLiteral——宿主修前
//   提升链四处判据只判正域（value > 2147483647），负号超下界（< -2147483648）
//   漏提升、恒留整32 标记域：IR 物化按 i32 发常量、codegen 32 位截断回绕
//   （-3000000000 出 1294967296 实锤·v2 同形正确）。修后数学值域判据
//   （types::literalValueExceedsInt32Domain）四面板（IR 物化/推断定宽/回绕
//   实参域/常量溢出预演域）统一——本条锁定全位置行为：声明/推断/赋值/实参/
//   返回/表达式/回绕内置/顶层静态直存 + 域内负锚（-2147483648）与正超域对照
//   （零翻转面）。§3.7a T36 扩面「负号形态按数学负值判域」（506甲）。
// 双编译对照：宿主+v2p 同源同测——退出码 0 + stdout 逐行全等。
函数 取(整64 值) -> 整64 { 返回 值; }
函数 造() -> 整64 { 返回 -3000000000; }

静态 整64 静 = -3000000000;             // 顶层静态 .data 文本直存（按声明宽）

函数 主() -> 整32 {
    // ① 声明位：负号超域各形态（修前 1294967296/2147483647/-705032704/0）
    整64 甲 = -3000000000;
    打印(甲);                             // -3000000000
    整64 乙 = -2147483649;
    打印(乙);                             // -2147483649
    整64 丙 = -5000000000;
    打印(丙);                             // -5000000000
    整64 丁 = -4294967296;
    打印(丁);                             // -4294967296
    // ② 域内负锚（零翻转面·855 同族）与正超域对照（既有正确面）
    整64 戊 = -2147483648;
    打印(戊);                             // -2147483648
    整64 己 = 3000000000;
    打印(己);                             // 3000000000
    整64 庚 = -2147483647;
    打印(庚);                             // -2147483647
    // ③ 推断位（修前误拒「无法将 '整32' 隐式转换为 '整32'」）
    变量 辛 = -3000000000;
    打印(辛);                             // -3000000000
    // ④ 赋值位（修前 1294967296）
    整64 壬 = 0;
    壬 = -3000000000;
    打印(壬);                             // -3000000000
    // ⑤ 实参位 / ⑥ 返回位（修前均 1294967296）
    打印(取(-5000000000));                // -5000000000
    打印(造());                           // -3000000000
    // ⑦ 表达式位（修前 1294967296；修前 -3000000000*2 误报编译期溢出）
    整64 癸 = -3000000000 + 0;
    打印(癸);                             // -3000000000
    整64 子 = -3000000000 * 2;
    打印(子);                             // -6000000000
    整64 丑 = -3000000000 - 3000000000;
    打印(丑);                             // -6000000000
    // ⑧ 回绕内置实参参与域（535 设施·修前 1294967296）
    打印(回绕乘(-3000000000, 1));         // -3000000000
    打印(回绕减(-3000000000, 1));         // -3000000001
    // ⑨ 顶层静态直存读回
    打印(静);                             // -3000000000
    返回 0;
}
