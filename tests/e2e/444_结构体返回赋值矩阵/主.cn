// E2E 444（2026-09-18 第 348 轮·D11 根治门禁）：**结构体返回调用**作右值的整体赋值
//   四目标形态——①标识符 ②成员链 ③数组元素 ④结构体引用参数的成员链
//   （甲方案「源优先序」：先求值源〔可能含条件块〕→ 再算目标地址 → 整体拷贝）。
//   背景：整体赋值通道白名单不含「一般结构体返回调用」→ 落标量 StorePtr 8 字节
//   → 目标首字段=返回值地址、其余字段 0（宿主与 v2 双侧静默错值·探针 p29 铁证）；
//   234-a 曾放开=回退（调用含条件块在目标地址发射后打乱块时序·全量 v2 树 285 失败）。
//   断言=输出逐行 + 退出码 0；宿主/v2 双编译同源同测。
结构体 点 {
    整64 x;
    整64 y;
    整64 z;
}

结构体 盒 {
    点 内;
    整64 标记;
}

函数 造点(整64 基) -> 点 {
    点 p = 点{ x = 基, y = 基 + 1, z = 基 + 2 };
    返回 p;
}

函数 造盒(整64 基) -> 盒 {
    盒 b = 盒{ 内 = 点{ x = 基, y = 基, z = 基 }, 标记 = 基 };
    返回 b;
}

函数 改写成员(盒& 目标, 整64 基) -> 空类型 {
    目标.内 = 造点(基);
    目标.标记 = 基;
}

函数 主() -> 整32 {
    // ① 标识符目标
    点 甲 = 造点(10);
    打印("甲=", 甲.x, " ", 甲.y, " ", 甲.z);
    // ② 成员链目标
    盒 乙 = 盒{ 内 = 点{ x = 0, y = 0, z = 0 }, 标记 = 0 };
    乙.内 = 造点(20);
    打印("乙.内=", 乙.内.x, " ", 乙.内.y, " ", 乙.内.z);
    // ③ 数组元素目标
    点[2] 表;
    表[0] = 点{ x = 0, y = 0, z = 0 };
    表[1] = 造点(30);
    打印("表1=", 表[1].x, " ", 表[1].y, " ", 表[1].z);
    // ④ 结构体引用参数的成员链（跨函数）
    改写成员(乙, 40);
    打印("乙.内=", 乙.内.x, " ", 乙.内.y, " ", 乙.内.z, " 标记=", 乙.标记);
    // ⑤ 整体结构体返回（成员链目标·盒）
    盒 丙 = 造盒(50);
    打印("丙.内=", 丙.内.x, " 丙.标记=", 丙.标记);
    返回 0;
}
