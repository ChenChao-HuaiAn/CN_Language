// 206-c E2E 285：复制(x) 泛型克隆内置四类型分派（双编译对照正测）——
//   ①标量=直通（零新增分配）②字符串=独立落堆（新增分配 1）
//   ③结构体（含串字段）=临时槽+串字段深拷（新增分配 1）
//   ④容器（向量<整64>）=NewObject+拷贝构造（新增分配 1）
//   判据=「复制 调用新增分配数」（内存::活动分配数 差值）+ 值/长度/大小正确性
//   ——两侧实测同值（宿主 0/1/1/1 == v2 0/1/1/1）。
//   退出码=校验和 15（①1+②2+③4+④8 各形态正确置位；0=全失败）。
//   双编译对照：同一源码宿主/v2p 各编各跑，退出码须一致（15）。
//   形态注记：独立块 + 异名变量（v2 容器方法解析对块嵌套形态较严）。
导入 容器::向量;
结构体 盒子 {
    字符串 名;
    整64 值;
}

函数 主() -> 整32 {
    整64 好 = 0;
    // ① 标量直通（值语义天然，零运行时开销）
    {
        整64 甲1 = 5;
        整64 前1 = 内存::活动分配数();
        整64 乙1 = 复制(甲1);
        整64 增1 = 内存::活动分配数() - 前1;
        如果 (增1 == 0) {
            如果 (乙1 == 5) { 好 = 好 + 1; }
        }
    }
    // ② 字符串=__cn_str_copy 落堆独立拥有
    {
        字符串 甲2 = 字符串复制("原串");
        整64 前2 = 内存::活动分配数();
        字符串 乙2 = 复制(甲2);
        整64 增2 = 内存::活动分配数() - 前2;
        如果 (增2 == 1) {
            如果 (字符串长度(乙2) == 字符串长度("原串")) { 好 = 好 + 2; }
        }
    }
    // ③ 结构体（含串字段）：临时槽 + 串字段深拷（源保持拥有）
    {
        盒子 甲3;
        甲3.名 = 字符串复制("盒名");
        甲3.值 = 7;
        整64 前3 = 内存::活动分配数();
        盒子 乙3 = 复制(甲3);
        整64 增3 = 内存::活动分配数() - 前3;
        如果 (增3 == 1) {
            如果 (乙3.值 == 7) { 好 = 好 + 4; }
        }
    }
    // ④ 容器（向量<整64>）=NewObject + 拷贝构造（独立对象）
    {
        向量<整64> 甲4 = 向量<整64>();
        结果<空类型, 整32> 加4 = 甲4.追加(3);
        整64 前4 = 内存::活动分配数();
        向量<整64> 乙4 = 复制(甲4);
        整64 增4 = 内存::活动分配数() - 前4;
        如果 (增4 == 1) {
            如果 (乙4.大小() == 1) { 好 = 好 + 8; }
        }
    }
    返回 整32(好);
}
