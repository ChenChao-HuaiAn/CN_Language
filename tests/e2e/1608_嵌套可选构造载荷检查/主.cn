// E2E 1608_嵌套可选构造载荷检查（#1770 锁面·dual 正例）：嵌套可选/结果构造器
//   载荷全形态绿面——某些(某些(5)) 三层 .值.值 读取链、某些(无) 嵌套载荷
//   （空值常量 → 可选<T> 载荷·001 §07-三）、结果嵌套 正常(正常(5))、
//   传参语境、返回语境。#1770 修前 v2 对 某些(无) 实参（空指针字面量=
//   整数字面量+附加==1）自然类型推导失真为 整32 → 载荷检查单侧误拒
//   （宿主绿·v2 红 分叉）；修后 dual 双绿输出一致。
函数 吃(可选<可选<整32>> 甲) -> 空类型 {
    如果 甲.有值 {
        如果 甲.值.有值 { 打印(甲.值.值); } 否则 { 打印(1); }
    } 否则 { 打印(2); }
}
函数 造() -> 可选<可选<整32>> {
    返回 某些(某些(8));
}
函数 主() -> 整32 {
    可选<可选<整32>> 甲 = 某些(某些(5));
    可选<可选<整32>> 乙 = 某些(无);
    可选<可选<整32>> 丙 = 无;
    如果 甲.有值 {
        如果 甲.值.有值 { 打印(甲.值.值); } 否则 { 打印(1); }
    } 否则 { 打印(2); }
    如果 乙.有值 {
        如果 乙.值.有值 { 打印(乙.值.值); } 否则 { 打印(3); }
    } 否则 { 打印(4); }
    如果 丙.有值 { 打印(9); } 否则 { 打印(5); }
    吃(某些(某些(6)));
    可选<可选<整32>> 丁 = 造();
    如果 丁.有值 {
        如果 丁.值.有值 { 打印(丁.值.值); } 否则 { 打印(7); }
    } 否则 { 打印(8); }
    结果<结果<整32, 整32>, 整32> 果 = 正常(正常(5));
    如果 果.正常 {
        如果 果.值.正常 { 打印(果.值.值); } 否则 { 打印(1); }
    } 否则 { 打印(2); }
    返回 0;
}
