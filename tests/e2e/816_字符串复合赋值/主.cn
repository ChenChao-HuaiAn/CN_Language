// E2E 816（#86 锁用例·dual 正例）：字符串复合赋值 += 拼接一致性——
//   001 §3.7 第④族「复合赋值 等价展开 甲 = 甲 + X」条文 + §3.7 拼接立法
//   （字符串连接 Task 2.5 / 数值→字符串 仅 + 拼接语境 Task 2.9）的合成面：
//   二元 + 已支持的类型组合，+= 必须同支持（糖展开同语义·宿主与 v2 零分叉）。
//   修前双侧同拒「复合赋值要求数值操作数」（宿主 semantic_expr_op
//   checkCompoundAssign isNumeric 白名单 / v2 语义检查语句 检查复合赋值操作数
//   数值白名单）=与二元拼接语义不一致。
//   边界保持：-= 等其余复合符对字符串仍拒；752/753 混合符号执法（数值面）
//   不涉本用例——数值复合赋值走原路径零扰动。
函数 主() -> 整32 {
    // ①串+串字面量（最小复现形态）
    字符串 甲 = "a";
    甲 += "b";
    打印(甲);            // ab
    // ②串+串变量（右值=拥有串标识符）
    字符串 乙 = "x";
    字符串 丙 = "y";
    乙 += 丙;
    打印(乙);            // xy
    // ③串+数值（隐式转字符串拼接·001 §3.7 数值→字符串 仅 + 拼接语境）
    字符串 丁 = "n";
    整32 值 = 42;
    丁 += 值;
    打印(丁);            // n42
    // ④右值=拼接表达式（+ 产物恒堆→free 旧+直存）
    字符串 戊 = "r";
    戊 += "s" + "t";
    打印(戊);            // rst
    // ⑤当循环累积（读旧值写回·RAII 多次拼接零泄漏）
    字符串 己 = "";
    整32 i = 0;
    当 (i < 3) {
        己 += "z";
        i++;
    }
    打印(己);            // zzz
    返回 0;
}
