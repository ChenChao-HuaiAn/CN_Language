结构体 点 { 整64 x; 整64 y; }
类 盒 {
    公开:
    点 内;
    函数 盒() {
        内.x = 0;
        内.y = 0;
    }
    函数 设(点 p) {
        内 = p;
    }
    函数 读() -> 整64 {
        返回 内.x * 100 + 内.y;
    }
}
函数 主() -> 整32 {
    盒 b = 盒();
    点 p;
    p.x = 7;
    p.y = 9;
    b.设(p);
    打印("类字段整体赋值 读=", b.读(), "（期望 709）");
    点 q;
    q.x = 1;
    q.y = 2;
    b.设(q);
    打印("覆盖后 读=", b.读(), "（期望 102）");
    返回 0;
}
