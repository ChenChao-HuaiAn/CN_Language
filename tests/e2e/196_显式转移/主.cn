// E2E 196（宿主正测，2026-09-10 第五十七轮 plans/019 阶段1 · 编译期安全）：
//   显式转移 转移() 内置函数——所有权交接语义正确性。四正形态：
//   ①容器转移（转移后新变量接管追加/大小）②遮蔽（内层同名新声明不受外层
//   已转移影响）③字符串转移（右值接管打印）④指针转移（&取址交接经解引用读）。
//   转移后旧名使用的拒绝形态=197 负测承载（本用例只测正形态零误伤）。
//   主.expected 逐行比对：2 / 1 / 左 / 55。
导入 容器::向量;

函数 主() -> 整32 {
    // ① 容器转移：接 追加(32) 后大小=2（10 已在转移前入）
    向量<整64> 表 = 向量<整64>();
    结果<空类型, 整32> 加1 = 表.追加(10);
    向量<整64> 接 = 转移(表);
    结果<空类型, 整32> 加2 = 接.追加(32);
    打印(接.大小());

    // ② 遮蔽：外层 表 已转移，内层块新声明 表 是新变量
    {
        向量<整64> 表 = 向量<整64>();
        结果<空类型, 整32> 加3 = 表.追加(7);
        打印(表.大小());
    }

    // ③ 字符串转移：乙 接管，打印内容（显式类型——推断声明字符串拷贝打印
    //   分派为宿主独立既有缺陷[probe_f 实证]，与本轮转移无关，另案观察项）
    字符串 甲 = "左";
    字符串 乙 = 转移(甲);
    打印(乙);

    // ④ 指针转移：r 接管 q 的指向，解引用读 55
    整64 基 = 55;
    整64* q = &基;
    整64* r = 转移(q);
    打印(*r);

    返回 0;
}
