// E2E 1372_局部引用变量成员访问（#1023 H2·dual）：局部引用变量（甲& 参 = 对;）
//   绑定槽内容契约=「绑定对象左值地址」（847 模型：读取两层/写回/转发全链）——
//   修复前 v2 绑定位存对象指针、读取按契约两读多解一层：字段读/虚调/直调
//   C0000005、字段写错误码3（1020 采样轮 b02/b03/m03/b05 实录·宿主恒绿对照）。
//   断言输出=是（宿主+v2p 输出逐行同 主.expected）。
// 覆盖：①字段读 ②字段写 ③非虚直调 ④引用再绑 ⑤转发引用形参 ⑥虚分派 ⑦别名重赋。
类 甲 {
公开:
    整32 x;
    函数 甲(整32 v) { x = v; }
    虚拟 函数 取() -> 整32 {
        返回 x;
    }
    函数 翻倍() -> 整32 {
        返回 x * 2;
    }
}
类 乙 : 甲 {
公开:
    函数 乙(整32 v) : 甲(v) { }
    重写 函数 取() -> 整32 {
        返回 x + 100;
    }
}
函数 读(甲& 参) -> 整32 {
    返回 参.x;
}
函数 主() -> 整32 {
    甲 对 = 甲(7);
    甲& 参 = 对;
    打印(参.x);          // 7  字段读
    参.x = 42;             //    字段写
    打印(参.x);          // 42 写后读
    打印(对.x);          // 42 别名可见
    打印(参.翻倍());     // 84 非虚直调
    甲& 参1 = 对;
    甲& 参2 = 参1;
    打印(参2.x);         // 42 引用再绑
    打印(读(参));        // 42 转发引用形参
    乙 对象 = 乙(5);
    甲& 虚参 = 对象;
    打印(虚参.取());     // 105 虚分派
    对 = 甲(60);           //    别名重赋
    打印(参.x);          // 60 别名语义
    打印(参1.x);         // 60 同源别名
    返回 0;
}
