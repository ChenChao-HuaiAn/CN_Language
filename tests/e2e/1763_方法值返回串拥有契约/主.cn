// E2E 1763（双编译对照·正例·#1922 件2）：绑定方法值调用返回拥有字符串——
//   A2 拥有契约登记（宿主 checkMethodValueCall retOwnedString 写回 + v2 预扫
//   字符串槽/声明位/实参位/语句位四消费点同源判定）。
//   修前：方法值调用被调=变量名，函数返回类型表/内置表双 miss → 按非拥有
//   （污染）处理，返回堆串无人接管——声明位/实参位/语句位百轮各净泄 1
//   （alloc6/alloc8 探针·宿主与 v2 同步）。
// 覆盖：①显式类型声明位 100 轮（内容校验和 + 活动分配数差 0）
//   ②实参位（字符串长度(cb(...)) 内建实参临时）100 轮（差 0）
//   ③语句位弃值 100 轮（差 0）④零参/带参两形态返回内容正确（甲/前乙）。
类 乙类 {
公开:
    字符串 名字;
    函数 乙类(字符串 n) { 名字 = n; }
    函数 取名() -> 字符串 { 返回 字符串复制("甲"); }
    函数 带参取名(字符串 前缀) -> 字符串 { 返回 字符串复制(前缀 + 名字); }
}
函数 主() -> 整32 {
    乙类 乙 = 乙类("乙");
    变量 cb0 = 乙.取名;
    变量 cb1 = 乙.带参取名;
    // ① 声明位（显式 字符串 类型·拥有型局部块内 RAII）
    整64 和1 = 0;
    整64 基1 = 内存::活动分配数();
    整64 趟 = 0;
    当 (趟 < 100) {
        字符串 r = cb0();
        和1 = 和1 + 整64(字符串长度(r));
        趟++;
    }
    打印(整32(和1));                       // 100（每轮长度 1）
    打印(内存::活动分配数() - 基1);         // 0
    // ② 实参位（内建实参临时·调用后结算）
    整64 和2 = 0;
    整64 基2 = 内存::活动分配数();
    趟 = 0;
    当 (趟 < 100) {
        和2 = 和2 + 字符串长度(cb1("前"));
        趟++;
    }
    打印(整32(和2));                       // 200（前乙 两字符）
    打印(内存::活动分配数() - 基2);         // 0
    // ③ 语句位弃值
    整64 基3 = 内存::活动分配数();
    趟 = 0;
    当 (趟 < 100) {
        cb0();
        趟++;
    }
    打印(内存::活动分配数() - 基3);         // 0
    返回 0;
}
