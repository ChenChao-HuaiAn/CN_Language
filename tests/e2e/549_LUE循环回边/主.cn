// 874 E2E 549：LUE 循环回边保守 + 循环内重初始化保留（任务 083 防复发门禁）——
//   A 场景（循环体外声明·循环体内「先读取后 复制」）：回边后下一轮仍读源 →
//     **不得消除**（深拷）——修复前 v2 误消除实证（二轮起源槽清零·静默错值）。
//   B 场景（循环体内每轮新声明）：每轮重新初始化 → **允许消除**（分配差 0，
//     值断言不变）——防「一律拒消除」修过头（保留优化面）。
//   退出码 = A 得分(0~3) + B 得分(0~6)×10 = 63（A=3 每轮值完好；B=6 三轮×(增==0 得1 + 值对得1)）。
//   双编译对照：同一源码宿主/v2p 各编各跑，退出码须一致（63）。
函数 主() -> 整32 {
    整32 好 = 0;
    // A：循环体外声明 + 循环体内先读后复制（回边面·不得消除）
    字符串 甲 = 字符串复制("甲");
    整64 轮 = 0;
    当 (轮 < 3) {
        如果 (字符串长度(甲) == 3) { 好 = 好 + 1; }
        字符串 乙 = 复制(甲);
        轮 = 轮 + 1;
    }
    // B：循环体内每轮新声明（允许消除·分配差 0）
    整64 轮2 = 0;
    整32 乙好 = 0;
    当 (轮2 < 3) {
        字符串 丙 = 字符串复制("乙");
        整64 前 = 内存::活动分配数();
        字符串 丁 = 复制(丙);
        整64 增 = 内存::活动分配数() - 前;
        如果 (增 == 0) { 乙好 = 乙好 + 1; }
        如果 (字符串长度(丁) == 3) { 乙好 = 乙好 + 1; }
        轮2 = 轮2 + 1;
    }
    返回 整32(好 + 乙好 * 10);
}
