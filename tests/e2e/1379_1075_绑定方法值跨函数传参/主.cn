// E2E 1379_1075_绑定方法值跨函数传参（031 第 1 期·正例 2·dual）：
//   方法值<类,签名> 类型语法 + 跨函数形参转发——`应用(方法值<计数器,整32(整32)> 回调,
//   整32 v)` 体内 `回调(v)`：绑定对象随值跨函数（宿主两槽值通道 / v2 蹦床通道，
//   行为等价——plans/031 语义：#943 p82d 转发段错误病灶转正）。
// 语义=引用绑定：调用读对象**当前状态**（改态后 205）。
// 覆盖：①直调 ②形参转发 ③改态读最新 ④拷贝链 ⑤多对象独立 ⑥赋值位改绑
//   （#1114 收口面）⑦自身.方法。
类 计数器 {
公开:
    整32 基数;
    函数 计数器(整32 b) { 基数 = b; }
    函数 双倍(整32 x) -> 整32 { 返回 基数 + x; }
    函数 自身双倍(整32 x) -> 整32 {
        变量 内 = 自身.双倍;
        返回 内(x);
    }
}
函数 应用(方法值<计数器, 整32(整32)> 回调, 整32 v) -> 整32 {
    返回 回调(v);
}
函数 主() -> 整32 {
    计数器 对象 = 计数器(100);
    变量 cb = 对象.双倍;
    打印(整32(cb(5)));            // 105（直调）
    打印(整32(应用(cb, 5)));      // 105（形参转发）
    对象.基数 = 200;
    打印(整32(cb(5)));            // 205（改态读最新）
    打印(整32(应用(cb, 5)));      // 205（转发+引用语义）
    变量 g = cb;
    打印(整32(应用(g, 3)));       // 203（拷贝链转发）
    计数器 乙 = 计数器(7);
    变量 d = 乙.双倍;
    打印(整32(应用(d, 1)));       // 8（多对象独立）
    计数器 丙 = 计数器(50);
    cb = 丙.双倍;
    打印(整32(应用(cb, 2)));      // 52（赋值位改绑后转发）
    打印(整32(对象.自身双倍(6))); // 206（自身.方法 形态）
    返回 0;
}
