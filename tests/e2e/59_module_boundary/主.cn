// E2E 59_module_boundary：模块边界 5 项修复（A-5，2026-08）
// 覆盖：
//   1. 花括号项别名跨模块同名歧义（导入 {双倍 作为 X双倍}/{双倍 作为 Y双倍}）
//   2. 父模块名限定调用子模块函数（网络::连接()，moduleFilter 前缀匹配）
//   3. 子目录模块导入父目录模块（网络/传输控制.cn 导入 网络）
//   4. crate 隔离同名函数纯名调用优先当前模块（主::版本 vs 模块X/模块Y 双倍）
//   5. 整路径重命名绑定模块级别名（导入 模块Y 作为 Y别名 -> Y别名::双倍）
导入 模块X::{双倍 作为 X双倍}
导入 模块Y::{双倍 作为 Y双倍}
导入 网络::传输控制::连接
导入 网络
导入 模块Y 作为 Y别名

函数 版本() -> 整64 {
    返回 100
}

函数 主() -> 整32 {
    打印("===== 模块边界修复（A-5）=====")

    // ---- 1. 花括号项别名跨模块同名：各自解析到来源模块 ----
    整64 别名X = X双倍(21)
    整64 别名Y = Y双倍(21)
    打印("X双倍(21): ", 别名X)                    // 42（模块X ×2）
    打印("Y双倍(21): ", 别名Y)                    // 63（模块Y ×3）

    // ---- 2. 父模块名限定调用子模块函数 ----
    整64 连接码 = 网络::连接()
    打印("网络::连接(): ", 连接码)                 // 101（网络计数 1 + 100）

    // ---- 3. 子目录模块导入父目录：子模块调用父模块函数 ----
    整64 子值 = 网络::传输控制::子模块值()
    打印("子模块值(): ", 子值)                     // 1011（父模块函数 11 + 1000）

    // ---- 4. crate 隔离同名函数纯名调用优先当前模块 ----
    整64 版本值 = 版本()
    打印("纯名 版本(): ", 版本值)                  // 100（当前模块，非模块X/Y 双倍）

    // ---- 5. 整路径重命名绑定模块级别名 ----
    整64 别名调用 = Y别名::双倍(10)
    打印("Y别名::双倍(10): ", 别名调用)            // 30（模块Y ×3）

    打印("===== 模块边界测试完成 =====")
    返回 0
}
