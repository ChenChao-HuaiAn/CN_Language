// E2E 210N（宿主负测，2026-09-11 第六十八轮 plans/019 阶段4' A2 方案甲）：
//   返回 字符串=拥有契约 的借用返回拒绝——五坏形态：
//   ①参数直传返回 ②成员借出返回 ③下标借出返回 ④字符* 调用返回（驻留文本）
//   ⑤静态变量返回；另含初始化位/赋值位字符* 隐式收紧（⑥⑦）。
//   调用方按返回类型登记 RAII free——free 借用指针=悬垂/UAF，编译期拒绝。
结构体 条目 {
    字符串 名;
}
静态 字符串 平台 = "主";
函数 坏1参数(字符串 路径) -> 字符串 {
    返回 路径;                     // 坏1：参数借用返回
}
函数 坏2成员(条目 t) -> 字符串 {
    返回 t.名;                     // 坏2：成员借出返回
}
函数 坏3下标(字符串[2] 池) -> 字符串 {
    返回 池[0];                    // 坏3：下标借出返回
}
函数 坏4字符指针() -> 字符串 {
    返回 驻留文本(驻留("x"));       // 坏4：字符* 借用返回
}
函数 坏5静态() -> 字符串 {
    返回 平台;                     // 坏5：静态借用返回
}
函数 主() -> 整32 {
    整64 id = 驻留("v");
    字符串 s = 驻留文本(id);        // 坏6：字符* 隐式初始化收紧
    字符串 s2 = "初值";
    s2 = 驻留文本(id);             // 坏7：字符* 隐式赋值收紧
    返回 0;
}
