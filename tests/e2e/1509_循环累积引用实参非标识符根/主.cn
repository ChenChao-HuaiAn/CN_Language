// 1509 循环累积引用实参非标识符根（750 复审4 P1-3·双编译性能向）
//   病：引用位实参根非标识符（f(obj.field)/f(arr[i])/f(*(&s))）时借用位扫描202
//   不登记根名，消费端「已扫描→逐位 miss→静默放行」=fail-closed 子缺口。
//   修：已扫描值增设「未登记引用位」哨兵（调用级），消费端见哨兵整函数拒绝；
//   宿主侧取地址操作数非标识符同理整函数抑制（双侧同口径）。
//   负载：循环前 `取引用(槽.名)`（引用位根=成员）+ 循环累积 s。
//   预期：长=2048 / 非标识符根优化=0（少优化但正确·双侧一致）。
结构体 盒 {
    字符串 名
}

函数 取引用(字符串& 参) -> 整64 {
    返回 字符串长度(参);
}

不安全 函数 主() -> 整32 {
    字符串 s = "";
    盒 槽 = 盒{ 名 = "abc" };
    取引用(槽.名);
    整64 前 = 内存::总分配次数();
    循环 (整64 k = 0; k < 2048; k++) {
        s = s + "x";
    }
    整64 次 = 内存::总分配次数() - 前;
    打印("长=", 整数转字符串(字符串长度(s)));
    布尔 降 = 次 <= 6;
    如果 (降) { 打印("非标识符根优化=1"); } 否则 如果 (次 > 6) {
        打印("非标识符根优化=0 次=", 整数转字符串(次));
    }
    返回 0;
}
