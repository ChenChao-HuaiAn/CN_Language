// E2E 58_generic_field：跨模块泛型类字段（A-4 修复，2026-08）
// 覆盖：stdlib 容器 向量<整64> 作类字段——类型键统一（模板名 -> 实例化名
//   向量$整64）+ 类字段对象指针读取（方法调用 this 正确）：
//   馆藏 类字段 图书ID表 的 追加/元素/大小 全链路
// 此前边界（52_library 记录）："无法将 '向量$整64' 隐式转换为 '向量<整64>'"
//   + 类字段方法调用 this=字段地址 读到垃圾
导入 容器::向量;

类 馆藏 {
私有:
    向量<整64> 图书ID表;
    整64 数量;
公开:
    函数 馆藏() {
        图书ID表 = 向量<整64>();
        数量 = 0;
    }

    函数 添加(整64 ID) -> 结果<空类型, 整32> {
        结果<空类型, 整32> 追加 = 图书ID表.追加(ID);
        如果 (追加.正常) {
            数量++;
        }
        返回 追加;
    }

    函数 读取(整64 位置) -> 整64 {
        返回 图书ID表.元素(位置);
    }

    函数 大小() -> 整64 {
        返回 数量;
    }
}

函数 主() -> 整32 {
    打印("===== 跨模块泛型类字段（A-4）=====");

    馆藏 库 = 馆藏();
    结果<空类型, 整32> 添加1 = 库.添加(101);
    结果<空类型, 整32> 添加2 = 库.添加(202);
    结果<空类型, 整32> 添加3 = 库.添加(303);
    如果 (添加1.正常 && 添加2.正常 && 添加3.正常) {
        打印("添加全部成功");
    } 否则 {
        打印("添加失败");
    }
    打印("数量: ", 库.大小());
    打印("ID0: ", 库.读取(0));
    打印("ID1: ", 库.读取(1));
    打印("ID2: ", 库.读取(2));

    打印("===== 泛型字段测试完成 =====");
    返回 0;
}
