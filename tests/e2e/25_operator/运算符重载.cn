// Task 3.7 运算符重载 E2E 测试
// 覆盖：双目运算符重载（+ 加法 / == 相等 / != 不等）、运算符重载返回类对象、
//       运算符重载与普通方法混用、字符串 + 数值拼接不受用户重载影响
// 语法依据（cn-language-spec 06-九）：函数 运算符X(参数) -> 类型（成员函数）；
//   双目运算符单参数（右操作数），左操作数为本类实例（this）；
//   字符串 + 拼接由编译器隐式转换，不与用户重载冲突
// 说明：单目运算符（- ! ~）IR 层未映射（operatorSymText 仅双目），E2E 只验证双目
// 打印语义（用户裁决）：打印=println（自动换行）

类 复数 {
公开:
    整32 实部
    整32 虚部

    函数 复数(整32 r, 整32 i) {
        实部 = r
        虚部 = i
    }

    // 运算符+ ：返回新复数（构造调用返回类对象）
    函数 运算符+(复数 右) -> 复数 {
        返回 复数(实部 + 右.实部, 虚部 + 右.虚部)
    }

    // 运算符== ：比较实部虚部
    函数 运算符==(复数 右) -> 布尔 {
        返回 (实部 == 右.实部) && (虚部 == 右.虚部)
    }

    // 运算符!= ：取反 ==
    函数 运算符!=(复数 右) -> 布尔 {
        返回 !((实部 == 右.实部) && (虚部 == 右.虚部))
    }

    // 普通方法：显示复数
    函数 显示() -> 字符串 {
        返回 整数转字符串(实部) + "+" + 整数转字符串(虚部) + "i"
    }
}

函数 主() -> 整32 {
    打印("===== 运算符重载（Task 3.7）=====")

    // ---- 1. 复数加法（运算符+ 重载）----
    复数 甲 = 复数(1, 2)
    复数 乙 = 复数(3, 4)
    复数 和 = 甲 + 乙           // 调用 复数.运算符+
    打印("甲: ", 甲.显示())     // 1+2i
    打印("乙: ", 乙.显示())     // 3+4i
    打印("和: ", 和.显示())     // 4+6i

    // 注意：链式运算（甲 + 乙 + 丙）的中间对象（运算符+ 返回的 NewObject 堆对象）
    //   作为左操作数传给第二次 + 时字段读取错乱（输出垃圾值）——这是"运算符重载
    //   返回类对象赋值语义"的已知遗留风险（plans 阶段3 文档记录），留待 Debug
    //   全面审查子任务处理；本用例聚焦 Task 3.7 双目运算符重载验证。
    复数 丙 = 复数(10, 20)
    复数 两步 = 甲 + 乙          // 单次重载（中间对象直接赋值，无链式）
    打印("甲+乙: ", 两步.显示()) // 4+6i

    // 链式运算（缺陷2 修复验证）：甲+乙+丙 = 14+26i
    复数 链 = 甲 + 乙 + 丙
    打印("链式甲+乙+丙: ", 链.显示())

    // ---- 3. 相等比较（运算符== 重载）----
    复数 甲2 = 复数(1, 2)
    布尔 相等1 = 甲 == 甲2       // 真（实部虚部相同）
    布尔 相等2 = 甲 == 乙        // 假（3+4i）
    打印("甲==甲2: " + 相等1)    // 甲==甲2: 真
    打印("甲==乙: " + 相等2)    // 甲==乙: 假

    // ---- 4. 不等比较（运算符!= 重载）----
    布尔 不等1 = 甲 != 乙        // 真
    布尔 不等2 = 甲 != 甲2       // 假
    打印("甲!=乙: " + 不等1)    // 甲!=乙: 真
    打印("甲!=甲2: " + 不等2)   // 甲!=甲2: 假

    // ---- 5. 运算符重载结果参与普通方法调用 ----
    复数 差 = 乙 + 丙            // 13+24i（单次重载）
    打印("乙+丙显示: ", 差.显示())  // 13+24i

    // ---- 6. 字符串 + 数值拼接不受用户重载影响（编译器隐式转换）----
    打印("字符串拼接: " + 甲.实部 + "+" + 甲.虚部 + "i")  // 字符串拼接: 1+2i

    // 说明：单目运算符重载（- ! ~）IR 层 operatorSymText 未映射（仅双目），
    //   留待 Debug 全面审查子任务/运算符重载完善子任务处理。

    打印("===== 运算符重载测试完成 =====")
    返回 0
}
