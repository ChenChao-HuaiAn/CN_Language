// E2E 68_generic_return：自定义泛型类实例作返回类型（自举前置 A-3b，2026-08）
// 覆盖：向量<字符串> 返回（canConvertType 模板/实例名统一）、返回对象所有权
//   转移（局部析构跳过——双重释放堆损坏 0xC0000374 回归）、调用方接管析构、
//   泛型函数返回容器、嵌套返回（函数返回的函数返回值）
// 语法依据：plans/004 缺口 A-3b + ir_oop_call 返回所有权转移修复
导入 容器::向量

函数 构建词表() -> 向量<字符串> {
    向量<字符串> 表 = 向量<字符串>()
    结果<空类型, 整32> 加 = 表.追加("你好")
    如果 (!加.正常) {
        返回 表
    }
    结果<空类型, 整32> 加2 = 表.追加("世界")
    如果 (!加2.正常) {
        返回 表
    }
    返回 表
}

函数 构建数据() -> 向量<整64> {
    向量<整64> 数据 = 向量<整64>()
    整64 i = 0
    当 (i < 5) {
        结果<空类型, 整32> 加 = 数据.追加(i * 10)
        如果 (!加.正常) {
            返回 数据
        }
        i++
    }
    返回 数据
}

函数 包装构建() -> 向量<字符串> {
    返回 构建词表()
}

函数 主() -> 整32 {
    打印("===== 泛型类实例作返回类型 =====")
    向量<字符串> 表 = 构建词表()
    打印("词表大小:", 表.大小())
    结果<字符串, 整32> 取0 = 表.读取(0)
    如果 (取0.正常) {
        打印("词0:", 取0.值)
    }
    结果<字符串, 整32> 取1 = 表.读取(1)
    如果 (取1.正常) {
        打印("词1:", 取1.值)
    }
    向量<整64> 数据 = 构建数据()
    打印("数据大小:", 数据.大小())
    整64 总和 = 0
    整64 i = 0
    当 (i < 数据.大小()) {
        总和 += 数据.元素(i)
        i++
    }
    打印("数据总和:", 总和)
    向量<字符串> 包装 = 包装构建()
    打印("包装词表大小:", 包装.大小())
    返回 0
}
