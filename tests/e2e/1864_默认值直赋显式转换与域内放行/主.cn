// E2E 1864（#1860 正例锁面·不误伤红线）：域内默认值照旧放行——类字段
//   （整64 0x123 / 整32 100）与函数默认参数（字面量/hex/常量算式 3+4）
//   两面；显式转换 整32(3000000000) 位模式通道不受影响（位模式语义既有
//   立法·局部变量面承载）；回绕函数实参=运行期传参不入默认值通道
//   （自然豁免）。
// 1861（1400 误伤根治·2026-10-31 补锚）：默认值通道负号形态按 #1016 数学
//   负值判域——类字段负号 hex 最小界（-0x8000000000000000 = 整64::MIN·
//   域内）与函数默认参数纯负号链 -(-5U)（数学值 +5）双侧放行锁面（判域
//   面回归即红锚·顺带锁默认参数负号形态值化：-(-5U)→5）；3000000000 族
//   超域拒面不动（1862/1863 负测承担）。
常量 域内 = 100;

类 箱 {
公开:
    整64 大 = 0x123;
    整32 小 = 100;
    整64 负最小槽 = -0x8000000000000000;
}

函数 f(整32 y = 100, 整64 z = 0x123, 整32 w = 3 + 4) -> 整32 {
    返回 y + w + 整32(z);
}

函数 取负负(整64 甲 = -(-5U)) -> 整64 {
    返回 甲;
}

函数 主() -> 整32 {
    箱 b;
    打印(b.大);
    打印(b.小);
    整32 显 = 整32(3000000000);
    打印(显);
    打印(f());
    打印(域内);
    打印(b.负最小槽);
    打印(取负负());
    返回 0;
}
