// E2E 234（2026-09-12 第八十一轮，plans/020 移植纪律 9 门禁化·第七个对照用例）：
//   **容器元素 = 含拥有型串字段结构体**——同一份源码经宿主真实管线与 v2 自举链
//   各编译运行，两侧退出码须相等（runner「双编译对照」编排断言：宿主侧 == 用例
//   期望值 且 v2 侧 == 宿主侧实测值）。
//   覆盖 81-a 修复的全部机制 × 两侧共有语义面：
//     ① 向量<盒子> 追加（局部源结构体）+ 容器析构：源与元素各自释放 + 内容守恒
//     ② 向量<盒子> 两元素 + 删除(0)：元素移动（memcpy + 源槽清零）后内容守恒
//     ③ 向量<盒子> 设置覆盖：覆盖旧元素释放 + 残留归零
//     ④ 向量<盒子> 清空 + 析构：残留归零
//     ⑤ 链表/栈/队列<盒子> + 集合<盒子> 析构：残留归零（链式容器按链游释放）
//     ⑥ 调用返回实参（返回结构体入容器）：返回临时释放 + 残留归零
//     ⑦ 借用来源（形参串）入容器：调用方串完好 + 作用域结束后残留归零
//     ⑧ 循环体 20 万轮：块出口 drop + 内容守恒
//   校验和折位：①1 ②2 ③4 ④8 ⑤16 ⑥32 ⑦64 ⑧128 —— 255=全对。
//   两侧任一形态的所有权机制分叉（元素字段串不释放/移位深拷泄漏/临时泄漏/
//   链式容器平铺析构）→ 该校验位丢失 → 退出码变化 → 对照失败。
//   平台守卫=linux 双平台（宿主与 v2 同链；win-x64 v2 产物未隔离=家机轮）。
导入 容器::向量;
导入 容器::链表;
导入 容器::栈;
导入 容器::队列;
导入 映射集合;

结构体 盒子 {
    字符串 名;
    整32 号;
}

// 内存搅动：新分配覆盖「已释放内存」，使悬垂元素内容可观测损坏
函数 搅动() -> 整64 {
    整64 和 = 0;
    整64 i = 0;
    当 (i < 16) {
        字符串 垃圾 = 字符串复制("搅动内存填充占位字符串内容甲乙丙丁戊己庚辛壬癸");
        和 = 和 + 字符串长度(垃圾);
        i++;
    }
    返回 和;
}

// ① 追加 + 容器析构（源结构体与容器元素各自拥有并释放）
函数 形一() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        向量<盒子> 表 = 向量<盒子>();
        盒子 局 = 盒子{ 名 = 字符串复制("形一占位内容甲乙丙丁戊己庚辛壬癸子丑"), 号 = 1 };
        结果<空类型, 整32> 加 = 表.追加(局);
        如果 (!加.正常) { 返回 0; }
        盒子 读 = 表.元素(0);
        如果 (读.号 == 1 && 字符串比较(读.名, "形一占位内容甲乙丙丁戊己庚辛壬癸子丑")) { 校验 = 1; }
        如果 (!字符串比较(局.名, "形一占位内容甲乙丙丁戊己庚辛壬癸子丑")) { 校验 = 0; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验;
}

// ② 两元素 + 删除(0)（元素移动 + 被移除槽释放）
函数 形二() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        向量<盒子> 表 = 向量<盒子>();
        盒子 甲 = 盒子{ 名 = 字符串复制("形二甲占位内容甲乙丙丁戊己庚辛壬癸"), 号 = 1 };
        盒子 乙 = 盒子{ 名 = 字符串复制("形二乙占位内容甲乙丙丁戊己庚辛壬癸"), 号 = 2 };
        结果<空类型, 整32> 加1 = 表.追加(甲);
        结果<空类型, 整32> 加2 = 表.追加(乙);
        如果 (!加1.正常 || !加2.正常) { 返回 0; }
        结果<空类型, 整32> 删 = 表.删除(0);
        如果 (!删.正常) { 返回 0; }
        盒子 读 = 表.元素(0);
        如果 (读.号 == 2 && 字符串比较(读.名, "形二乙占位内容甲乙丙丁戊己庚辛壬癸")) { 校验 = 1; }
        搅动();
        盒子 读2 = 表.元素(0);
        如果 (!字符串比较(读2.名, "形二乙占位内容甲乙丙丁戊己庚辛壬癸")) { 校验 = 0; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 2;
}

// ③ 设置覆盖（覆盖旧元素释放）
函数 形三() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        向量<盒子> 表 = 向量<盒子>();
        盒子 甲 = 盒子{ 名 = 字符串复制("形三甲占位内容甲乙丙丁戊己庚辛壬癸"), 号 = 1 };
        盒子 乙 = 盒子{ 名 = 字符串复制("形三乙占位内容甲乙丙丁戊己庚辛壬癸"), 号 = 2 };
        结果<空类型, 整32> 加 = 表.追加(甲);
        如果 (!加.正常) { 返回 0; }
        结果<空类型, 整32> 设 = 表.设置(0, 乙);
        如果 (!设.正常) { 返回 0; }
        盒子 读 = 表.元素(0);
        如果 (读.号 == 2 && 字符串比较(读.名, "形三乙占位内容甲乙丙丁戊己庚辛壬癸")) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 4;
}

// ④ 清空 + 容器析构（全量释放）
函数 形四() -> 整64 {
    整64 前 = 内存::活动分配数();
    {
        向量<盒子> 表 = 向量<盒子>();
        盒子 局 = 盒子{ 名 = 字符串复制("形四占位内容甲乙丙丁戊己庚辛壬癸子丑"), 号 = 4 };
        结果<空类型, 整32> 加 = 表.追加(局);
        如果 (!加.正常) { 返回 0; }
        表.清空();
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 8;
}

// ⑤ 链表/栈/队列/集合（链式容器按链游释放在 ~容器 注入）
函数 形五() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        链表<盒子> 链 = 链表<盒子>();
        盒子 甲 = 盒子{ 名 = 字符串复制("形五链表占位内容甲乙丙丁戊己庚辛"), 号 = 1 };
        结果<空类型, 整32> 加1 = 链.头部追加(甲);
        如果 (!加1.正常) { 返回 0; }
        栈<盒子> 栈表 = 栈<盒子>();
        盒子 乙 = 盒子{ 名 = 字符串复制("形五栈占位内容甲乙丙丁戊己庚辛壬"), 号 = 2 };
        结果<空类型, 整32> 加2 = 栈表.压入(乙);
        如果 (!加2.正常) { 返回 0; }
        队列<盒子> 队 = 队列<盒子>();
        盒子 丙 = 盒子{ 名 = 字符串复制("形五队列占位内容甲乙丙丁戊己庚辛"), 号 = 3 };
        结果<空类型, 整32> 加3 = 队.入队(丙);
        如果 (!加3.正常) { 返回 0; }
        集合<盒子> 集 = 集合<盒子>();
        盒子 丁 = 盒子{ 名 = 字符串复制("形五集合占位内容甲乙丙丁戊己庚辛"), 号 = 4 };
        结果<空类型, 整32> 加4 = 集.添加(丁);
        如果 (!加4.正常) { 返回 0; }
        如果 (链.大小() == 1 && 栈表.大小() == 1 && 队.大小() == 1) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 16;
}

// ⑥ 结构体返回接收（被调方返回移出 + 调用方浅拷接管）后再入容器
//   注：**实参位置直接写调用返回**（`表.追加(造盒子(6))`）为 v2 侧缺口（v2 帧尾
//   共享 retbuf × 外层调用覆盖：单实参=句柄泄漏、多实参=数据损坏）——登记下轮
//   专项，宿主侧已修的面见 E2E 235（宿主单侧）。
函数 造盒子(整32 号) -> 盒子 {
    盒子 内 = 盒子{ 名 = 字符串复制("形六占位内容甲乙丙丁戊己庚辛壬癸子丑寅"), 号 = 号 };
    返回 内;
}

函数 形六() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        向量<盒子> 表 = 向量<盒子>();
        盒子 收 = 造盒子(6);
        结果<空类型, 整32> 加 = 表.追加(收);
        如果 (!加.正常) { 返回 0; }
        盒子 读 = 表.元素(0);
        如果 (读.号 == 6 && 字符串比较(读.名, "形六占位内容甲乙丙丁戊己庚辛壬癸子丑寅")) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 32;
}

// ⑦ 借用来源（形参串）入容器：调用方串完好
函数 存入(向量<盒子> 表, 字符串 值) -> 整64 {
    盒子 局 = 盒子{ 名 = 值, 号 = 7 };
    结果<空类型, 整32> 加 = 表.追加(局);
    如果 (!加.正常) { 返回 0; }
    返回 1;
}

函数 形七() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        向量<盒子> 表 = 向量<盒子>();
        字符串 本地 = 字符串复制("形七调用方拥有串内容甲乙丙丁戊己庚辛壬");
        如果 (存入(表, 本地) == 1) { 校验 = 1; }
        盒子 读 = 表.元素(0);
        如果 (!字符串比较(读.名, "形七调用方拥有串内容甲乙丙丁戊己庚辛壬")) { 校验 = 0; }
        搅动();
        如果 (!字符串比较(本地, "形七调用方拥有串内容甲乙丙丁戊己庚辛壬")) { 校验 = 0; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 64;
}

// ⑧ 循环体内结构体（20 万轮块出口 drop + 内容守恒）
函数 形八(整64 轮数) -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 i = 0;
    当 (i < 轮数) {
        盒子 每轮 = 盒子{ 名 = 字符串复制("形八循环体占位内容甲乙丙丁戊己庚辛壬"), 号 = 8 };
        如果 (!字符串比较(每轮.名, "形八循环体占位内容甲乙丙丁戊己庚辛壬")) { 返回 0; }
        i++;
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 128;
}

函数 主() -> 整32 {
    整64 和 = 0;
    和 = 和 + 形一();
    和 = 和 + 形二();
    和 = 和 + 形三();
    和 = 和 + 形四();
    和 = 和 + 形五();
    和 = 和 + 形六();
    和 = 和 + 形七();
    和 = 和 + 形八(200000);
    返回 整32(和);
}
