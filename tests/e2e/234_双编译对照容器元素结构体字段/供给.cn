// E2E 234 符号供给（v2 自举链，plans/020 移植纪律 9）：
//   v2p_linux.o 只含 v2 自身实例化的容器类型——本用例用到的 向量/链表/栈/队列/
//   集合<盒子> 方法符号须由本文件经**宿主真实管线**编译为 .o 参与链接
//   （置于 v2p_linux.o 之前，符号权威；126/218/219/221 同款机制）。
//   盒子 结构体布局以本文件为准（与主.cn 同名声明的布局一致——同名类型单 ABI）。
导入 容器::向量;
导入 容器::链表;
导入 容器::栈;
导入 容器::队列;
导入 映射集合;

结构体 盒子 {
    字符串 名;
    整32 号;
}

// 向量<盒子>：构造/追加/元素/设置/删除/清空/析构（含编译器注入的
//   析构被移除/析构元素/移动元素 挂点方法——由 删除/设置 方法体调用触发实例化）
函数 供给向量() -> 整64 {
    向量<盒子> 表 = 向量<盒子>();
    盒子 局 = 盒子{ 名 = "供给向量占位内容甲乙丙丁", 号 = 1 };
    结果<空类型, 整32> 加 = 表.追加(局);
    如果 (!加.正常) { 返回 101; }
    盒子 读 = 表.元素(0);
    如果 (读.号 != 1) { 返回 102; }
    结果<空类型, 整32> 设 = 表.设置(0, 局);
    如果 (!设.正常) { 返回 103; }
    结果<空类型, 整32> 删 = 表.删除(0);
    如果 (!删.正常) { 返回 104; }
    结果<空类型, 整32> 插 = 表.插入(0, 局);
    如果 (!插.正常) { 返回 105; }
    表.清空();
    返回 0;
}

// 链表<盒子>：构造/头部追加/大小/析构
函数 供给链表() -> 整64 {
    链表<盒子> 表 = 链表<盒子>();
    盒子 局 = 盒子{ 名 = "供给链表占位内容甲乙丙丁", 号 = 2 };
    结果<空类型, 整32> 加 = 表.头部追加(局);
    如果 (!加.正常) { 返回 106; }
    如果 (表.大小() != 1) { 返回 107; }
    返回 0;
}

// 栈<盒子>：构造/压入/大小/析构
函数 供给栈() -> 整64 {
    栈<盒子> 表 = 栈<盒子>();
    盒子 局 = 盒子{ 名 = "供给栈占位内容甲乙丙丁戊", 号 = 3 };
    结果<空类型, 整32> 加 = 表.压入(局);
    如果 (!加.正常) { 返回 108; }
    如果 (表.大小() != 1) { 返回 109; }
    返回 0;
}

// 队列<盒子>：构造/入队/大小/析构
函数 供给队列() -> 整64 {
    队列<盒子> 表 = 队列<盒子>();
    盒子 局 = 盒子{ 名 = "供给队列占位内容甲乙丙丁", 号 = 4 };
    结果<空类型, 整32> 加 = 表.入队(局);
    如果 (!加.正常) { 返回 110; }
    如果 (表.大小() != 1) { 返回 111; }
    返回 0;
}

// 集合<盒子>：构造/添加/析构
函数 供给集合() -> 整64 {
    集合<盒子> 表 = 集合<盒子>();
    盒子 局 = 盒子{ 名 = "供给集合占位内容甲乙丙丁", 号 = 5 };
    结果<空类型, 整32> 加 = 表.添加(局);
    如果 (!加.正常) { 返回 112; }
    如果 (表.大小() != 1) { 返回 113; }
    返回 0;
}

// 宿主编译入口（cn build 需要主函数；链接 muldefs 下 v2asm 在前，cn_main 归 v2 产物）
函数 主() -> 整32 {
    返回 整32(供给向量() + 供给链表() + 供给栈() + 供给队列() + 供给集合());
}
