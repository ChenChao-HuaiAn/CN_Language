// E2E 495：下标目标 = 结构体右值（非调用）整体赋值（505-a T70 B1 二层门禁）
// 缺陷（修复前）：`表[i] = <结构体>` 落「下标左值写宽度」标量通道——只写首 8 字节
//   （①标识符：y 丢·探针 7/0）；②成员链/③结构体字面量/④三元 更把**源地址当元素值**
//   写入（探针 140733637143672/0 静默错值）。生产态即暴露（非撤守卫态专属）。
// 修复：v2 尝试下标结构体整体写 右值形态扩全（标识符/成员链/三元/结构体字面量）——
//   源=place 地址（生成左值地址）/聚合三元地址透传（生成表达式）/字面量物化（生成表达式）
//   → 整体拷贝（深拷=真·元素槽 preFree=真）；对齐宿主 emitStructWholeAssign 全形态。
// 覆盖：四右值形态 + 字符串字段深拷语义（改源不影响副本）+ 重复覆盖（preFree）
//   + 标量元素对照（回归）。
// 断言失败提前返回 101~109；全部通过 打印各值与 返回 0。

结构体 点 {
    整64 x;
    整64 y;
}

结构体 外盒 {
    点 内;
    整64 标记;
}

结构体 具名 {
    字符串 名;
    整64 值;
}

函数 主() -> 整32 {
    点[4] 表;
    点 p;
    p.x = 7;
    p.y = 9;
    外盒 o;
    o.标记 = 5;
    o.内.x = 3;
    o.内.y = 4;
    整64 条 = 1;
    点 q;
    q.x = 11;
    q.y = 12;

    表[0] = p;
    表[1] = o.内;
    表[2] = 点{ x = 5, y = 6 };
    表[3] = (条 != 0 ? p : q);

    如果 (表[0].x != 7 || 表[0].y != 9) { 返回 101; }
    如果 (表[1].x != 3 || 表[1].y != 4) { 返回 102; }
    如果 (表[2].x != 5 || 表[2].y != 6) { 返回 103; }
    如果 (表[3].x != 7 || 表[3].y != 9) { 返回 104; }
    打印("①标识符 ", 表[0].x, "/", 表[0].y);
    打印("②成员链 ", 表[1].x, "/", 表[1].y);
    打印("③字面量 ", 表[2].x, "/", 表[2].y);
    打印("④三元   ", 表[3].x, "/", 表[3].y);

    // 字符串字段深拷：改源不影响副本（元素=独立副本·非共享句柄）
    具名[2] 名表;
    具名 a;
    a.名 = "甲";
    a.值 = 1;
    名表[0] = a;
    a.名 = "改";
    如果 (名表[0].值 != 1) { 返回 105; }
    打印("⑤深拷不变 ", 名表[0].名, "/", 名表[0].值);

    // 重复覆盖（preFree 释放旧串后写新值）
    具名 b;
    b.名 = "乙";
    b.值 = 2;
    名表[0] = b;
    如果 (名表[0].值 != 2) { 返回 106; }
    打印("⑥覆盖 ", 名表[0].名, "/", 名表[0].值);

    // 源仍可用（值语义·非移动）
    如果 (a.值 != 1 || b.值 != 2) { 返回 107; }
    打印("⑦源可用 ", a.值, "/", b.值);

    // 标量元素对照（回归：非结构体元素走原标量通道）
    整64[3] 数表;
    数表[0] = 10;
    数表[1] = 20;
    数表[2] = 30;
    如果 (数表[0] + 数表[1] + 数表[2] != 60) { 返回 108; }
    打印("⑧标量 ", 数表[0], "/", 数表[1], "/", 数表[2]);

    返回 0;
}
