// E2E 1866 负测（预期失败·任务 1960 执法一·2026-11-02）：字符串拼接形态
//   未登记=IR 分派面显形（十二条款①②）。形态：左=字符串语义（IR ptr）但
//   exprSrcType/ptrOperandSrcType 两面均无值（三分支形态·同 1865 判据链）
//   且右侧=数值（拼接）/整128（拼接 128 段）。修前：genStringConcatBinary/
//   genStringConcatI128 判据 miss 静默 return false → 落指针算术分支（撞
//   #648「指针步进源类型未登记 '<空>'」错位文案+步进 8 错值——探针实测）；
//   修后：显形「内部错误: 字符串拼接形态未登记（分派面：拼接[128]·缺形态：
//   exprSrcType 左侧无值）」中止（产物不落盘）。
//   防误伤面（同轮 p4 探针·全绿实证零变更）：普通指针+整数=指针算术合法
//   路径零变更（05_array_pointer 回归教训·真指针变量 lookupSrcType/± 链
//   回溯恒可解析·两面有值即放行原路径）。
函数 主() -> 整32 {
    变量 甲 = 1;
    变量 拼 = (甲 == 1 ? "行" : "停") + 5;
    返回 0;
}

函数 拼128() -> 整32 {
    变量 甲 = 1;
    整128 大 = 999999999999;
    变量 拼 = (甲 == 1 ? "数" : "值") + 大;
    返回 0;
}
