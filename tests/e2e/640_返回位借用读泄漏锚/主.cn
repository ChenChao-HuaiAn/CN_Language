// p263tmp_c（263① 探针·临时不入库）：返回语句位借用读（返回 表.元素(0).号）。
//   候选盲区=生成语句.cn 主循环「返回 真」早退路径跳过 203 语句收口
//   （清理表达式物化临时 不执行）——元素() 物化临时（整盒值副本·含串字段）在
//   返回路径无人回收。外层 1000 轮放大泄漏后断言活动分配数回平。
//   7=绿；1=泄漏；0=校验失败。
导入 容器::向量;

结构体 盒子 {
    字符串 名;
    整32 号;
}

函数 形探() -> 整32 {
    向量<盒子> 表 = 向量<盒子>();
    结果<空类型, 整32> 加 = 表.追加(盒子{ 名 = 字符串复制("P263C串"), 号 = 7 });
    如果 (!加.正常) { 返回 0; }
    返回 表.元素(0).号;
}

函数 主() -> 整32 {
    整64 前 = 内存::活动分配数();
    整32 i = 0;
    当 (i < 1000) {
        整32 号 = 形探();
        如果 (号 != 7) { 打印(0); 返回 0; }
        i++;
    }
    如果 (内存::活动分配数() != 前) { 打印(1); 返回 0; }
    打印(7);
    返回 0;
}
