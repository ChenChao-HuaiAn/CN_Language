// E2E 1596 方法句柄链与默认参数算式 992 守卫（任务 1737·dual）：
//   四形态同源码宿主/v2 各编各跑逐行比对（零分叉门禁）。
//   修前 v2 采样实录（[992守卫] 非法寄存器槽号=发射中止·宿主同源码编译运行绿）：
//   ① z.拿().值()（方法返回类句柄单链）→ 槽号 -79（表达式栈残留外层函数名
//     负占位被当 this）；
//   ② y.拿().拿().值()（三级句柄链）→ 槽号 -81 同族；
//   ③ h.拿().拿().取().v（句柄×结构体混链）→ 槽号 -84 同族；
//   ④ 算()（默认参数常量算式 `整32 a = 1 + 2`）→ 槽号 0（多节点默认表达式
//     补缺求值区间只含根节点·操作数槽=寄存器计数初始 0）。
//   根因三层面（任务 1737）：
//   A-方法面：发射用户类方法调用 对用户类返回取 类型码=T_未知 → 目标寄存器
//     不分配+返回值不压栈 → 表达式栈残留 → 下一跳方法调用弹 this=垃圾槽
//     （修=用户类句柄返回类型码=T_对象·与被调方 rax 标量返回 ABI 对齐）；
//   A-自由函数面：解析调用返回结构体 标识符被调分支只认结构体大小（键1175
//     守卫）→ 用户类返回=无 → [ir2] 方法调用对象类型未解析 误拒
//     （修=用户类返回直返类型 ID·与 1322 方法被调分支对称）；
//   B：解析参数默认值 登记根=表达式末节点索引 + 补默认参数实参 求值区间
//     [根, 根+1) 单节点 → 多节点表达式子树不求值
//     （修=子终点登记区间起点·补缺求值 [区起, 根+1] 全区间）。
类 内层 {
公开:
    函数 值() -> 整32 {
        返回 99;
    }
    函数 取() -> 数据 {
        数据 d;
        d.v = 7;
        返回 d;
    }
}
结构体 数据 {
    整32 v;
}
类 中层 {
公开:
    函数 拿() -> 内层 {
        内层 n;
        返回 n;
    }
}
类 外层 {
公开:
    函数 拿() -> 中层 {
        中层 m;
        返回 m;
    }
}
常量 基 = 5;
函数 算(整32 a = 1 + 2, 整32 b = 基) -> 整32 {
    返回 a + b;
}
函数 造() -> 内层 {
    内层 n;
    返回 n;
}
函数 主() -> 整32 {
    // ① 方法返回类句柄单链（一层句柄链接标量方法）
    中层 z;
    打印行(z.拿().值());
    // ② 三级句柄链（双跳句柄链接标量方法）
    外层 y;
    打印行(y.拿().拿().值());
    // ③ 句柄×结构体混链（句柄链末跳接结构体返回方法+字段读）
    打印行(y.拿().拿().取().v);
    // ④ 默认参数常量算式（多节点表达式 + 常量名单节点双形态）——
    //   语句位调用锁「v2 补缺编译崩溃」修复面（修前 v2 [992守卫] 槽号 0
    //   发射中止）；**值断言不扩展**：宿主缺省实参静默取 0（算()=0/算(10)=10）
    //   vs v2 求值（8/15）=任务 #1395 在案语义面（默认参数求值缺失）——
    //   本任务只修发射崩溃不越界改语义，值断言待 #1395 双侧对齐后回补。
    //   全实参形态（算(10,20)=30）两侧一致=值断言锚。
    算();
    算(10);
    打印行(算(10, 20));
    // ⑤ 自由函数返回类句柄链（同族 A-自由函数面·解析层误拒形态）
    打印行(造().值());
    // ⑥ 绑定中间变量对照锚（修前 v2 即绿·防修过扩）
    内层 t = y.拿().拿();
    打印行(t.值());
    返回 0;
}
