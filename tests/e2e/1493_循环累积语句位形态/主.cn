// 1493 循环累积语句位形态（750 复审返工 P1-1/P1-2·双编译对照）
//   P1-1：v2 语句位判定原整块跳过控制流体块/裸块/选择情况体 → if/裸块/情况体内
//     候选 v2 判非语句位（宿主递归判定通过）→ 双编译分配分叉（2048 轮：
//     宿主 65537 vs v2 67143680）。修复=模拟主遍历时递归进入被跳过块。
//   P1-2：v2 `s += x` 复合赋值首轮解析的孤儿标识符使「单出现」判据误计 2 拒绝
//     （宿主优化/v2 不优化）→ 修复=重析前修剪孤儿。断言=两侧分配次数同降。
//   表达式位字符串赋值（`打印行((g = g + "x"))`）判据⑦=不优化，但 v2 IR 既有
//   「链式赋值表达式左值类型暂限标量/指针（整体值类登记 002 后续波）」不支持
//   字符串——双编译不可达，宿主侧探针实测记录见提交信息未覆盖边界。
// 预期：A 2048 轮 if 内累积长 2048 且次数≤4 / B 裸块 nnn / C 情况体 0 /
//   D 2048 轮 += 长 4096 且次数≤4。

不安全 函数 主() -> 整32 {
    // ① if 内累积（语句位递归）
    整64 前1 = 内存::总分配次数();
    字符串 a = "";
    循环 (整64 k = 0; k < 2048; k++) {
        如果 (k % 2 == 0) { a = a + "ab"; }
    }
    整64 次1 = 内存::总分配次数() - 前1;
    打印("A长=", 整数转字符串(字符串长度(a)));
    布尔 降1 = 次1 <= 4;
    如果 (降1) { 打印("A优化=1"); } 否则 如果 (!降1) {
        打印("A优化=0 次=", 整数转字符串(次1));
    }
    // ② 裸块内累积
    字符串 b = "";
    循环 (整64 k = 0; k < 3; k++) {
        { b = b + "n"; }
    }
    打印("B=", b);
    // ③ 选择情况体内累积（情况体块=跳块递归）
    字符串 c = "";
    循环 (整64 k = 0; k < 3; k++) {
        选择 (k) {
            情况 0: c = c + "0";
            情况 1: { }
            默认: { }
        }
    }
    打印("C=", c);
    // ④ s += x（孤儿修剪后 v2 同优化）
    整64 前4 = 内存::总分配次数();
    字符串 d = "";
    循环 (整64 k = 0; k < 2048; k++) {
        d += "cd";
    }
    整64 次4 = 内存::总分配次数() - 前4;
    打印("D长=", 整数转字符串(字符串长度(d)));
    布尔 降4 = 次4 <= 4;
    如果 (降4) { 打印("D优化=1"); } 否则 如果 (!降4) {
        打印("D优化=0 次=", 整数转字符串(次4));
    }
    返回 0;
}
