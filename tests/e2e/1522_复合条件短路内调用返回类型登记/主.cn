// 1522（#1583 缺陷锁）：复合条件短路（&&/||/三元）内用户函数调用的返回类型登记。
//   根因：宿主 visitIfStmt 的 && 守卫短路路径只「收集」左子树的守卫标记，
//   从不检查左子树——左子树内的用户函数调用漏走 visitCallExpr（resolvedSignature/
//   resolvedType 未登记），IR 生成期查表 miss 报「函数返回类型未登记」内部错误；
//   参数检查/布尔域检查同被跳过（v2 逐节点检查条件区，无此缺陷=宿主单侧红）。
//   本用例覆盖 如果/否则如果/逻辑非/逻辑或/三元条件/当循环/返回语句 七类条件位，
//   并断言守卫标记只向右传导（短路未求值位的 选项.值 访问编译期放行且不执行）。
函数 判定(整64 值) -> 布尔 {
    返回 值 > 10;
}
函数 主() -> 整32 {
    整64 甲 = 42;
    可选<整64> 选项 = 某些(7);
    整32 校验 = 0;
    // ① 三连 &&：守卫在左子树内、调用位亦在左子树内（原缺陷正中形态）
    如果 (选项.有值 && 判定(甲 + 1) && 甲 > 0) {
        校验 = 校验 + 1;
    }
    // ② 括号嵌套：守卫+调用整体作左操作数
    如果 ((选项.有值 && 判定(甲)) && 甲 > 10) {
        校验 = 校验 + 2;
    } 否则 {
        校验 = 校验 + 100;
    }
    // ③ 否则如果 同形态
    如果 (甲 < 0) {
        校验 = 校验 + 1000;
    } 否则 如果 (选项.有值 && 判定(甲) && 甲 >= 0) {
        校验 = 校验 + 4;
    }
    // ④ 逻辑非条件位
    如果 (!(选项.有值 && 判定(甲))) {
        校验 = 校验 + 10000;
    }
    // ⑤ 逻辑或条件位
    如果 (甲 < 0 || (选项.有值 && 判定(甲) && 甲 > 0)) {
        校验 = 校验 + 8;
    }
    // ⑥ 三元条件位
    布尔 态 = (选项.有值 && 判定(甲) && 甲 > 0) ? 真 : 假;
    如果 (态) {
        校验 = 校验 + 16;
    }
    // ⑦ 当循环条件位
    整64 轮 = 0;
    当 (选项.有值 && 判定(甲) && 轮 < 3) {
        轮 = 轮 + 1;
    }
    校验 = 校验 + 整32(轮) * 32;
    // ⑧ 守卫标记传导（两操作数形态·宿主与 v2 守卫识别共同覆盖）：守卫右侧的
    //   选项.值 访问编译期放行。体为 +0 常式，读取结果不进入输出（取值正确性
    //   属 #1585 独立缺陷，不并入本用例断言面）
    如果 (选项.有值 && 选项.值 >= 0) {
        校验 = 校验 + 0;
    }
    // ⑨ 返回语句条件位
    打印("校验=" + 整数转字符串(整64(校验)));
    返回 (选项.有值 && 判定(甲) && 甲 > 0) ? 0 : 1;
}
