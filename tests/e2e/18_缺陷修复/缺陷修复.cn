// 缺陷修复回归（Task 2.9/2.10 Debug 审查后续缺陷）：
//   1. lambda 捕获语义区分：[=] 值捕获快照（定义处复制值）vs [&] 引用捕获（读最新值/写回外部）
//   2. 无符号大值打印：正8~正64 值超 2^63 正确显示正数（%llu 语义，修复前 %lld 打印负数）
// 语法依据（cn-language-spec 04-一D / 02 类型系统）
结构体 点 {
    整32 x;
    整32 y;
}

函数 主() -> 整32 {
    // ---- 1. lambda 值捕获快照（缺陷1：修复前读到最新值 1000 而非快照 101） ----
    整32 值 = 101;
    自动 快照 = [=]() -> 整32 { 返回 值; };    // 值捕获：定义时快照 101
    自动 引用 = [&]() -> 整32 { 返回 值; };    // 引用捕获：读最新值
    值 = 1000;
    打印("lambda值快照: ", 快照());           // 101（快照）
    打印("lambda引用最新: ", 引用());          // 1000（最新）

    // [&] 闭包内修改外部变量（引用语义写回）
    整32 计数 = 10;
    自动 加一 = [&]() { 计数 = 计数 + 1; };
    加一();
    打印("引用修改外部: ", 计数);             // 11

    // [=] 闭包内修改不影响外部（快照独立）
    整32 外部 = 5;
    自动 改值 = [=]() { 外部 = 99; };
    改值();
    打印("值捕获外部不变: ", 外部);           // 5

    // 显式捕获 [变量] 按值快照
    整32 显式 = 7;
    自动 快照显式 = [显式]() -> 整32 { 返回 显式; };
    显式 = 70;
    打印("显式捕获快照: ", 快照显式());        // 7（快照）

    // i128 值捕获快照（双寄存器值，定义处复制；回归 maxRegIdIn 双槽预留）
    整128 大数 = 1234567890123456789LL;
    自动 读大数 = [=]() -> 整128 { 返回 大数; };
    大数 = 999;
    打印("i128值捕获快照: ", 读大数());       // 1234567890123456789

    // 字符串值捕获（指针共享语义，Task 2.8）
    字符串 文本 = "你" + "好";
    自动 读串 = [=]() -> 字符串 { 返回 文本; };
    字符串 串结果 = 读串();
    打印("字符串值捕获: ", 串结果);           // 你好

    // 结构体值捕获快照（复核修复：定义处深拷贝快照，字段访问读快照值）
    点 复点 = 点{ x = 3, y = 4 };
    自动 读复点 = [=]() -> 整32 { 返回 复点.x; };
    复点.x = 300;
    打印("结构体值捕获快照: ", 读复点());       // 3（快照，非 300）

    // 嵌套 lambda 捕获（复核修复：内层捕获变量合并到本层，避免跨函数槽越界）
    整32 嵌套源 = 100;
    自动 嵌套闭包 = [=]() -> 整32 {
        自动 内层 = [=]() -> 整32 { 返回 嵌套源; };
        返回 内层();
    };
    嵌套源 = 999;
    打印("嵌套lambda快照: ", 嵌套闭包());      // 100（快照）

    // ---- 2. 无符号大值打印（缺陷2：修复前 正64 超 2^63 打印负数） ----
    正64 大正64 = 18446744073709551615U;  // 2^64-1
    打印("正64最大: ", 大正64);             // 18446744073709551615（修复前 -1）
    正32 大正32 = 4294967295U;            // 2^32-1
    打印("正32最大: ", 大正32);             // 4294967295
    正64 超大值 = 9000000000000000000U;   // 9e18 > 2^63
    打印("正64超2^63: ", 超大值);           // 9000000000000000000
    正8 大正8 = 正8(255U);                  // 显式截断到正8（值 255 在正8 范围）
    打印("正8最大: ", 大正8);               // 255
    打印("拼接正64: ", "值=" + 超大值);      // 值=9000000000000000000

    返回 0;
}
