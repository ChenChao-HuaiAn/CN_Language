// E2E 1077（2026-10-17 任务 921·629 矩阵 p629j0 实锤）：顶层静态类对象
//   无初值默认构造调用——「静态 货架 全局架」后 全局架.记录.追加 空指针
//   （错误码 3）根治锁面。宿主基准=ir_decl.cpp 顶层静态无初值通道
//   「NewObject + 无参构造（paramTypes.empty 命中则 Call）+ StorePtr」。
//   形态面（五分流逐一对齐宿主）：
//     ① 0 参构造+容器字段：构造体初始化句柄 → 字段链 追加/大小 正常
//       （原 v2 只分配零值对象不调构造 → 记录 句柄 0 → 空指针错误码 3）
//     ② 0 参构造+标量字段：构造体赋值生效（值=9）
//     ③ 带参构造：不调构造（paramTypes 非空·零值对象·值=0）
//     ④ 带默认参数构造：不调构造（声明参数非空·值=0——与宿主同判）
//     ⑤ 无构造器类：零值对象（值=0）
//   校验和折位：①1 ②2 ③4 ④8 ⑤16 —— 31=全对；任一形态分叉=校验位丢失。
//   不借链（容器字段符号由 stdlib 源码级加载并入 v2asm 侧）。
导入 容器::向量;

类 货架 {
公开:
    向量<字符串> 记录;
    函数 货架() { 记录 = 向量<字符串>(); }
    函数 ~货架() { }
}

类 戊 {
公开:
    整64 值;
    函数 戊() { 值 = 9; }
}

类 乙 {
公开:
    整64 值;
    函数 乙(整64 v) { 值 = v; }
}

类 丙 {
公开:
    整64 值;
    函数 丙(整64 v = 7) { 值 = v; }
}

类 丁 {
公开:
    整64 值;
}

静态 货架 全局架;
静态 戊 全局戊;
静态 乙 全局乙;
静态 丙 全局丙;
静态 丁 全局丁;

不安全 函数 装入() -> 整32 {
    结果<空类型, 整32> r = 全局架.记录.追加(字符串复制("顶层静态对象字段链载荷"));
    返回 整32(全局架.记录.大小());
}

函数 主() -> 整32 {
    整32 校验 = 0;
    // ① 0 参构造+容器字段（构造体初始化句柄·字段链调用）
    如果 (装入() == 1) { 校验 = 校验 + 1; }
    // ② 0 参构造+标量字段（构造体赋值）
    如果 (全局戊.值 == 9) { 校验 = 校验 + 2; }
    // ③ 带参构造：不调构造（零值对象）
    如果 (全局乙.值 == 0) { 校验 = 校验 + 4; }
    // ④ 带默认参数构造：不调构造（与宿主 paramTypes.empty 判定同）
    如果 (全局丙.值 == 0) { 校验 = 校验 + 8; }
    // ⑤ 无构造器类：零值对象
    如果 (全局丁.值 == 0) { 校验 = 校验 + 16; }
    打印("校验和=", 校验);
    返回 校验;
}
