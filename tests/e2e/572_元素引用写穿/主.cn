导入 容器::向量;
导入 IO::打印;
// E2E 572（2026-10-01 第 929 轮·任务 118 根治·引用返回方法调用作赋值目标）：
//   v.元素引用(i) = x（829 立法写通道·001 §5.3 三形态正交：元素引用=引用返回
//   零拷贝借用视图·只读/原地写均写穿容器）。修复前宿主语义层方法路径
//   lastExprIsRefReturn_ 硬编码 false（类型 canonical 剥 & 无从判定）——被拒
//   「赋值目标须为可写左值」（样本 p0930_06 同域）；v2 是引用返回调用 只认
//   被调=标识符。断言面：①简单写穿+读回；②复合赋值写穿；③结构体元素字段
//   级写穿（.x=9 不扰相邻字段 y——写宽按字段类型·宿主 memberAssignObjSrcType
//   CallExpr 分支）；④读链回归（右值 lvalue-to-rvalue·聚合直传分叉）；⑤引用
//   绑定联动写回；⑥中位（非 0 下标）写穿；⑦越界写=运行时错误 2（分层②兜底·
//   与 元素 同款 T18）。双编译对照同源断言（宿主+v2 同语义）。
结构体 点 {
    整32 x;
    整32 y;
}
函数 主() -> 整32 {
    // ① 简单写穿 + ⑥ 中位写穿
    向量<整32> 行;
    结果<空类型, 整32> a = 行.追加(1);
    如果 (a.正常) { } 否则 { 返回 1; }
    结果<空类型, 整32> b = 行.追加(2);
    如果 (b.正常) { } 否则 { 返回 1; }
    结果<空类型, 整32> c = 行.追加(3);
    如果 (c.正常) { } 否则 { 返回 1; }
    行.元素引用(0) = 30;
    打印(行.元素(0));
    行.元素引用(2) = 88;
    打印(行.元素(2));
    // ② 复合赋值写穿
    行.元素引用(0) += 5;
    打印(行.元素(0));
    // ③ 结构体元素字段级写穿（x 写穿·y 不扰）
    向量<点> 表;
    点 p1 = 点{ x = 1, y = 2 };
    结果<空类型, 整32> d = 表.追加(p1);
    如果 (d.正常) { } 否则 { 返回 1; }
    表.元素引用(0).x = 9;
    点 读回 = 表.元素(0);
    打印(读回.x);
    打印(读回.y);
    // ④ 读链回归（右值读=解引用值·非地址）
    整32 v = 行.元素引用(1);
    打印(v);
    // ⑤ 引用绑定联动写回
    整32& 别名 = 行.元素引用(1);
    别名 = 100;
    打印(行.元素(1));
    // ⑦ 未选中位不受扰
    打印(行.元素(0));
    返回 0;
}
