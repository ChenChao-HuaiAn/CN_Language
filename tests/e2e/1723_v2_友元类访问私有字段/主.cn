// E2E 1723（任务 2098·v2 面）：spec 001 §1289-1303 友元类形态——「友元 类 名」
//   授予该类全部方法访问本类私有/保护成员（最小授权面=类整体）。修前：
//   宿主全链绿·v2 解析拒「友元 后预期 '函数'」=零分叉缺陷；修后双侧同绿。
//   锁面：读+写私有字段全链值断言（友元类声明于使用类定义之前·无分号形态）。
类 甲类 {
私有:
    整64 秘密;
公开:
    函数 甲类() { 秘密 = 42; }
    友元 类 乙类
}
类 乙类 {
公开:
    函数 读秘密(甲类& 目标) -> 整64 { 返回 目标.秘密; }
    函数 写秘密(甲类& 目标, 整64 值) -> 空类型 { 目标.秘密 = 值; }
}
函数 主() -> 整32 {
    甲类 甲 = 甲类();
    乙类 乙 = 乙类();
    打印行("秘密=", 乙.读秘密(甲));
    乙.写秘密(甲, 99);
    打印行("新秘密=", 乙.读秘密(甲));
    返回 0;
}
