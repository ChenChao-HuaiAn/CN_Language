// 838 正测（双编译对照·与 819 负测对偶）：不安全 函数内写静态变量全形态放行
//   ——001 §747 表第 8 行豁免面（不安全 函数 内合法）。覆盖：函数内静态局部
//   赋值/复合赋值/自增（后缀）/表达式位自增 + 顶层静态 赋值/复合赋值/自增
//   （前缀）；读面维持安全。宿主+v2p 退出码+输出逐行一致（断言输出）。
静态 整32 顶计 = 0;

不安全 函数 推进() -> 整32 {
    静态 整32 计 = 0;
    计 = 计 + 1;      // 函数内静态 赋值
    计 += 2;          // 函数内静态 复合赋值
    计++;             // 函数内静态 自增（后缀）
    顶计 = 7;         // 顶层静态 赋值
    顶计 += 1;        // 顶层静态 复合赋值
    ++顶计;           // 顶层静态 自增（前缀）
    返回 计;
}

不安全 函数 表达式位() -> 整32 {
    静态 整16 s = 1;
    返回 整32(s++);   // 表达式位自增（语句位三挂点之外的第四挂点）
}

函数 主() -> 整32 {
    整32 甲 = 推进();    // 4（0+1+2+1）
    打印(甲);
    整32 乙 = 推进();    // 8（4+1+2+1）
    打印(乙);
    打印(顶计);          // 9（7+1+1）
    整32 丙 = 表达式位(); // 1（后缀自增表达式值=旧值）
    打印(丙);
    返回 0;
}
