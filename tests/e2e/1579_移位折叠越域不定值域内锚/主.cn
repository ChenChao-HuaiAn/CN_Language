// 1579 移位折叠越域不定值域内锚（#1187 收口锁·优化.cn 折叠二元移位分支）：
//   ①域内常量移位折叠照常（编译期定值·-O0 与 -O3 一致·L 后缀整64 域值锚·
//     裸字面量按 1076 判域=整32）
//   ②折叠右移两态锚（负值算术右移符号保持/正64 面域内）
//   ③折叠链（域内移位积参与加法再折叠）
//   越域面多重既有锁：常量移位量超宽=语义层编译期拒（474·1433 六形态/1041/
//   1383 整128/1384 负移位量）；变量移位量运行期越域=错误码 8（474 运行期）。
//   #1187 收口=折叠端检查码不可判定（=0）越域禁折叠（对齐宿主 const_fold 474
//   口径·防未来漏检形态被编译期定值传播固化）——本用例锁收口后合法折叠面零回归。
函数 主() -> 整32 {
    // ①整64 域内左移折叠锚（1L<<62 编译期定值）
    整64 甲 = 1L << 62;
    打印(甲);
    // ①b整32 域内左移折叠锚（3<<30·32 位域定值）
    整32 乙 = 3 << 30;
    打印(乙);
    // ②右移折叠锚（负值算术右移·符号位保持）
    整64 丙 = (0L - 64) >> 3;
    打印(丙);
    // ②b正64 域内右移（变量左·运行期面域内合法）
    正64 丁 = 64;
    正64 戊 = 丁 >> 4;
    打印(戊);
    // ③域内移位参与折叠链（1<<62 + 4 编译期合取）
    整64 己 = (1L << 62) + 4;
    打印(己);
    返回 0;
}
