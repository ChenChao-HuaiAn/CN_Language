// E2E 211_v2（2026-09-11 第七十一轮 plans/019 71-a 方案A 用户裁决）：v2 侧内置
//   构造器 正常()/错误()/某些()（规范 07-五，编译器预置）——v2 此前语义层报
//   「未声明函数」整体缺失，本轮全链补全+装箱 move（Rust Ok/Err/Some 同构）：
//   拥有字符串实参装箱=所有权转交（出口 RAII 跳过释放，防「装箱浅共享×出口
//   释放=悬垂」宿主 70-a 家族）；返回位/赋值位两语境；结果/可选双类型；
//   整32 载荷值@4 四字节读。八形态校验和折位（1/2/4/8/16/32/64/128），
//   退出码 255=全对。
函数 装箱拥有串() -> 结果<字符串, 整32> {
    字符串 行 = 字符串复制("拥有装箱");
    返回 正常(行);            // move：行 转交装箱值，出口不释放
}
函数 整载荷(整32 n) -> 结果<整32, 整32> {
    如果 (n > 0) { 返回 正常(n * 7); }
    返回 错误(3);             // 错误(码)：值@4 存 E
}
函数 可选包装() -> 可选<整64> {
    返回 某些(42);
}
函数 无参正常() -> 结果<空类型, 整32> {
    返回 正常();
}
函数 双段路径(整32 n) -> 结果<整32, 整32> {
    结果<整32, 整32> 内 = 整载荷(n);      // 接收+转发
    返回 内;
}
函数 主() -> 整32 {
    整32 校验 = 0;
    结果<字符串, 整32> 查 = 装箱拥有串();   // ①返回位 move+内容校验（悬垂即错）
    如果 (查.正常) {
        如果 (字符串比较(查.值, "拥有装箱")) { 校验 = 校验 + 1; }
    }
    结果<整32, 整32> 甲 = 整载荷(6);       // ②整32 载荷正常
    如果 (甲.正常 && 甲.值 == 42) { 校验 = 校验 + 2; }
    结果<整32, 整32> 乙 = 整载荷(0 - 1);   // ③错误分支+.错误 读取
    如果 (!乙.正常 && 乙.错误 == 3) { 校验 = 校验 + 4; }
    可选<整64> 选 = 可选包装();             // ④某些()/可选
    如果 (选.有值 && 选.值 == 42) { 校验 = 校验 + 8; }
    结果<空类型, 整32> 空 = 无参正常();     // ⑤无参 正常()
    如果 (空.正常) { 校验 = 校验 + 16; }
    结果<整32, 整32> 赋值位 = 正常(9);      // ⑥赋值位语境
    如果 (赋值位.正常 && 赋值位.值 == 9) { 校验 = 校验 + 32; }
    结果<整32, 整32> 丙 = 双段路径(5);      // ⑦结果变量转发（返回位非构造形态）
    如果 (丙.正常 && 丙.值 == 35) { 校验 = 校验 + 64; }
    结果<字符串, 整32> 再查 = 装箱拥有串(); // ⑧二次装箱（借用退化安全模型）
    如果 (再查.正常) {
        如果 (字符串比较(再查.值, "拥有装箱")) { 校验 = 校验 + 128; }
    }
    返回 校验;
}
