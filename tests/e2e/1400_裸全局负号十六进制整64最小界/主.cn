// E2E 1400（2026-10-19·任务 #1016·790 特例族窄角）：顶层裸全局负号十六进制
//   int64 最小界——`整64 负最小 = -0x8000000000000000;` 宿主文本保真放行且值
//   -2^63；v2 原 569 负号特例只认十进制文本（取常量下标值 hex 累加按 int64
//   正上界承载失败）→误拒「初始值必须是常量表达式」rc=1；修后全进制
//   magnitude 2^63 特例（hex/oct/bin/十进制）+ 负号壳初值数值化（.data 直存
//   `dq -0x...` MASM 拒面），双侧值/诊断/退出码一致。
//   覆盖：-0x8000000000000000（-2^63）/ -0x7FFFFFFFFFFFFFFF（-(2^63-1)）/
//   -0x1 / -0xFF（普通负号 hex）/ -0x8000000000000000L（整型后缀 + 最小界）/
//   （128 槽负号巨字面量·569 常量性通道）/ 整128 -(-0xFFFFFFFFFFFFFFFF)
//   （纯负号链·宿主放行且值 2^64-1：三轮审查 P1-1）/ 整128 三负 -2^127
//   （纯负号链 128 负域·四轮审查 P2②）/ 局部 128 双负/四负/双负巨
//   （嵌套负号链运行期求值·四轮审查 P1-C）；超承载拒绝形态见 1401/1404/1412。
整64 负最小 = -0x8000000000000000;
整64 负次小 = -0x7FFFFFFFFFFFFFFF;
整64 负一 = -0x1;
整64 负小十六 = -0xFF;
整64 负最小后缀 = -0x8000000000000000L;
正64 正二六三 = 0x8000000000000000;
整128 负巨 = -0xFFFFFFFFFFFFFFFF;
整128 双负巨 = -(-0xFFFFFFFFFFFFFFFF);
整128 三负巨 = -(-(-170141183460469231731687303715884105728));
类 盒 {
公开:
    整128 双负U = -(-5U);
    函数 盒() {}
}
不安全 函数 盒值() -> 整128 {
    盒 h = 盒();
    返回 h.双负U;
}
函数 主() -> 整32 {
    打印(负最小);
    打印(负次小);
    打印(负一);
    打印(负小十六);
    打印(负最小后缀);
    打印(正二六三);
    打印(负巨);
    打印(双负巨);
    打印(三负巨);
    整128 局双 = -(-5);
    整128 局四 = -(-(-(-5)));
    整128 局巨 = -(-0xFFFFFFFFFFFFFFFF);
    打印(局双);
    打印(局四);
    打印(局巨);
    整128 局三负 = -(-(-170141183460469231731687303715884105728));
    整128 局赋值 = 0;
    局赋值 = -(-(-170141183460469231731687303715884105728));
    打印(局三负);
    打印(局赋值);
    打印(盒值());
    整64 选值 = -9223372036854775808;
    选择 (选值) {
        情况 -9223372036854775808:
            打印("命中");
            中断;
        默认:
            打印("默认");
            中断;
    }
    如果 (负最小 == -9223372036854775808 && 负次小 == -9223372036854775807 && 负一 == -1) {
        如果 (负小十六 == -255 && 负最小后缀 == -9223372036854775808) {
            如果 (正二六三 != 0) {
                返回 0;
            }
        }
    }
    返回 1;
}
