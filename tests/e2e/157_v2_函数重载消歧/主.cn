导入 计算;

// E2E 157（呈报③方案A：函数重载消歧锚定，2026-09-06）
// 覆盖：① 同文件同名重载——个数不同（2/3 参）+ 个数同类型不同（整32/整64）
//   ② 跨文件同名重载——计算.cn 的 倍数(整32)/倍数(整64) 双版本跨文件调用各自决议
//     （宿主模块语义注记：同名函数分居两文件时纯名调用按当前模块遮蔽——P6b
//     模块系统对齐项，本用例不覆盖该形态；同名双版本同文件共存=两侧行为一致）
// 旧实现缺陷：函数登记键=纯声明名（同名映射覆盖后吞前静默）+ 函数 IR 名=纯名
//   （跨文件同名重载 asm 符号重复定义，第一轮冒烟实测靠源码改名规避）；
//   根治后登记键/IR 名/调用点全链带 #参数串（宿主 signatureKey 对齐），
//   调用点实参精确决议（字面量宽匹配），歧义/失败=编译诊断 fail fast。

// 重载版本 1：2 参 整32 加
函数 总和(整32 a, 整32 b) -> 整32 {
    返回 a + b;
}

// 重载版本 2：3 参 整32 加（个数不同）
函数 总和(整32 a, 整32 b, 整32 c) -> 整32 {
    返回 a + b + c;
}

// 重载版本 3：2 参 整64 减（个数同、类型不同）
函数 总和(整64 a, 整64 b) -> 整64 {
    返回 a - b;
}

函数 主() -> 整32 {
    整32 两参 = 总和(20, 22);       // 字面量实参 -> 精确命中 2 参 整32 版 = 42
    整32 三参 = 总和(1, 2, 3);      // 个数决议 -> 3 参版 = 6
    整64 大 = 30;
    整64 差 = 总和(大, 3);          // 整64 变量+字面量 -> 精确命中 整64 版 = 27
    整32 跨文件32 = 倍数(7);        // 字面量 -> 精确命中 计算.cn 整32 版 = 70
    整64 六 = 6;
    整64 跨文件64 = 倍数(六);       // 整64 变量 -> 精确命中 计算.cn 整64 版 = 600
    打印("重载2参=", 两参);
    打印("重载3参=", 三参);
    打印("整64版=", 差);
    打印("跨文件32=", 跨文件32);
    打印("跨文件64=", 跨文件64);
    返回 0;
}
