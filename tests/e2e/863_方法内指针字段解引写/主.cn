// 863（#594·2026-10-13）：方法内经 this 指针类型字段解引用写目标对象标量字段——
//   JSON解析器.记错() 的 树.错误码=码 全路径写丢根治锁（#351 同族 v2 win 形态·
//   859 轮 859c1~c4 dual 实锤：七形态负例 v2 错误码全 0=写丢·宿主全正确）。
//   根因（IR 铁证）：v2 生成左值地址 → 顺序链标识符地址 字段分支产**字段槽
//   地址**（发射类字段地址=this+偏移），指针类型字段（JSON树* 树）的后续成员
//   段以槽地址续链 → 记错() 生成 字段地址(字段地址(this,0),0) → [this+0]=码
//   把树指针槽本身覆盖（错误码/校验 全路径写丢+树槽被破坏）。修=链根指针
//   字段解引（433-b 下标/435-b 读宽 同族判定·是指针类型文本）+847 中间段
//   剥星（剥尾星基名·带星名 是用户类_ID 直查 miss 同宿主 351 口径）。
//   形态矩阵：
//   ① 裸名链根二级写（隐式 this·主病灶）：树.错误码=码 / 树.校验=码*2
//   ② 显式自身前缀三级写（847 中间段剥星面）：自身.树.错误码=码+100
//   ③ 对照·this 标量字段直写（原健康面·防误伤）：相邻=v
//   ④ stdlib JSON 负例族（859 扩回义务实质承载·含 859 义务清单「未转义
//     控制字符」形态——859 用例本体在 #352 分支未集成·注记由 352 集成轮
//     处理·本用例只承载不代改）：代理对三形态/非十六/未知转义/未转义
//     控制字符/未闭合/尾逗号/缺冒号/尾余/深超 64|65 边界——v2 错误码与
//     宿主逐行一致（修复前全 0）+重置复用链（#365 验收链）
//   ⑤ 正例对照：好路径错误码 0+根索引
导入 JSON::{JSON树, 解析JSON, 重置JSON树, JSONE_好, JSONE_语法, JSONE_深超, JSONE_尾余};

类 目标 {
公开:
    整64 错误码;
    整64 校验;
    函数 目标() {
        错误码 = 0;
        校验 = 0;
    }
}

类 解析器 {
公开:
    目标* 树;
    整64 相邻;
    函数 解析器() {
        树 = 无;
        相邻 = 0;
    }
    // ① 主病灶：裸名 树.字段 = 值（隐式 this 前缀·指针字段二级解引写）
    不安全 函数 记错(整64 码) -> 整64 {
        树.错误码 = 码;
        树.校验 = 码 * 2;
        返回 0 - 1;
    }
    // ② 显式自身前缀（中间段=指针字段·剥星面）：写值错开 100 防与①混淆
    不安全 函数 记错显式(整64 码) -> 整64 {
        自身.树.错误码 = 码 + 100;
        返回 0 - 2;
    }
    // ③ 对照：this 标量字段直写（原健康面——修复不得伤它）
    不安全 函数 记相邻(整64 v) -> 空类型 {
        相邻 = v;
    }
}

不安全 函数 主() -> 整32 {
    // ===== A 段：最小形态矩阵（自含类） =====
    目标 对象 = 目标();
    解析器 器 = 解析器();
    器.树 = &对象;
    打印(器.记错(7));            // -1（返回值）
    打印(对象.错误码);           // 7（修复前 v2=0 写丢）
    打印(对象.校验);             // 14（第二字段同面）
    打印(器.相邻);               // 0（无误写相邻槽）
    打印(器.记错显式(5));        // -2
    打印(对象.错误码);           // 105（显式自身前缀形态）
    器.记相邻(9);
    打印(器.相邻);               // 9（标量直写对照）

    // ===== B 段：stdlib JSON 负例族（记错 全路径·错误码与宿主一致） =====
    JSON树 树 = JSON树();
    解析JSON(树, "\"\\ud83d\"");        // 孤立高代理
    打印(树.错误码);                    // 1 语法
    解析JSON(树, "\"\\ude00\"");        // 孤立低代理
    打印(树.错误码);                    // 1
    解析JSON(树, "\"\\ude00\\ud83d\""); // 代理反序（低前高后·低位孤立）
    打印(树.错误码);                    // 1
    解析JSON(树, "\"\\uZZZZ\"");        // \u 非十六进制
    打印(树.错误码);                    // 1
    解析JSON(树, "\"\\u12\"");          // \u 截断（不足 4 位）
    打印(树.错误码);                    // 1
    解析JSON(树, "\"\\x\"");            // 未知转义
    打印(树.错误码);                    // 1
    // 859 义务清单「未转义控制字符」形态（RFC 8259 §7：字符串内 0x00-0x1F
    //   未转义=语法错）——CN \t 反转义即裸 0x09 入 JSON 串（JSON.cn b<32 判定）
    解析JSON(树, "\"a\tb\"");           // 未转义控制字符
    打印(树.错误码);                    // 1
    解析JSON(树, "\"abc");              // 未闭合字符串
    打印(树.错误码);                    // 1
    解析JSON(树, "{\"a\":1,}");         // 尾逗号
    打印(树.错误码);                    // 1
    解析JSON(树, "{\"a\" 1}");          // 缺冒号
    打印(树.错误码);                    // 1
    解析JSON(树, "123 456");            // 尾余
    打印(树.错误码);                    // 3 尾余
    字符串 深好 = "";
    字符串 深超 = "";
    整64 i = 0;
    当 (i < 64) { 深好 = 深好 + "["; 深超 = 深超 + "["; i = i + 1; }
    深超 = 深超 + "[";
    i = 0;
    当 (i < 64) { 深好 = 深好 + "]"; 深超 = 深超 + "]"; i = i + 1; }
    深超 = 深超 + "]";
    解析JSON(树, 深好);                 // 64 层=上限内
    打印(树.错误码);                    // 0 好
    解析JSON(树, 深超);                 // 65 层=超限
    打印(树.错误码);                    // 2 深超

    // 重置复用链（#365 验收链·重置() 内 标量字段直写+容器清空·错误后复用）
    重置JSON树(树);
    打印(树.错误码);                    // 0（重置回好）
    打印(树.根);                        // -1（空树）

    // ===== C 段：正例对照（好路径） =====
    解析JSON(树, "[1,2,3]");
    打印(树.错误码);                    // 0
    打印(树.根);                        // 0（首节点索引）
    返回 0;
}
