// E2E 66_switch_all_return：选择 全分支返回识别（自举前置 A-2，2026-08）
// 覆盖：枚举分发+返回 无兜底尾语句（bodyGuaranteesReturn 选择 全分支识别）、
//   字符串选择全返回、默认分支必然返回、缺少默认分支仍报错（语义防御）
// 语法依据：plans/004 缺口 A-2 + specs/03 选择语句
枚举 类型名 { 数字, 文本, 布尔值 }

函数 类型转名称(类型名 t) -> 字符串 {
    选择 (t) {
        情况 数字:
            返回 "数字";
        情况 文本:
            返回 "文本";
        情况 布尔值:
            返回 "布尔值";
        默认:
            返回 "未知";
    }
}

函数 命令处理(字符串 命令) -> 整64 {
    选择 (命令) {
        情况 "开始":
            返回 1;
        情况 "停止":
            返回 2;
        情况 "继续", "暂停":
            返回 3;
        默认:
            返回 0;
    }
}

函数 主() -> 整32 {
    打印("===== 选择 全分支返回 =====");
    打印(类型转名称(类型名.数字));
    打印(类型转名称(类型名.文本));
    打印(类型转名称(类型名.布尔值));
    打印("命令开始:", 命令处理("开始"));
    打印("命令停止:", 命令处理("停止"));
    打印("命令继续:", 命令处理("继续"));
    打印("命令未知:", 命令处理("未知"));
    返回 0;
}
