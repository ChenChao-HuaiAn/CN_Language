// E2E 731（2026-10-11·任务 #474「立法+用例先行」）：
//   显式回绕内置函数 回绕加/回绕减/回绕乘 全矩阵（001 §3.7a #474 条文）——
//   变量面回绕语义收缩为显式知情通道后的职责承接用例（502/658/681 原回绕
//   锚的语义等价移交）。①整8 三函数：回绕加(127,1)=-128、回绕减(-128,1)=127、
//   回绕乘(100,100)：10000 mod 256=16；②整16：回绕加(32767,1)=-32768
//   （682 原语义等价锚）、回绕乘(30000,30000)：900000000 低16位 0xE900=
//   59648 → -5888；③整32/整64 上界回绕加 1；④无符号代表：正16
//   回绕加(60000,10000)：70000 mod 65536=4464（502 原锚等价）、正8
//   回绕加(255,1)=0；⑤混合宽度同运算符规则：整8+整16 提升整16 域内
//   127+200=327、整8 与字面量 1 字面量豁免窄域参与；⑥编译期常量实参
//   按回绕语义折叠**不报错**（回绕加(2147483647,1)、回绕乘(30000,30000)
//   常量面——与常量溢出硬错误条文不冲突·显式回绕即知情）。
//   双编译对照：宿主与 v2 同源同测——输出逐行一致 + 退出码一致（0=正常）。
函数 主() -> 整32 {
    // ① 整8 三函数
    整8 甲8 = 127;
    打印(整32(回绕加(甲8, 1)));     // -128（两补码回绕）
    整8 乙8 = -128;
    打印(整32(回绕减(乙8, 1)));     // 127（下溢回绕）
    整8 丙8 = 100;
    打印(整32(回绕乘(丙8, 丙8)));   // 10000 mod 256 = 16
    // ② 整16
    整16 甲16 = 32767;
    打印(整32(回绕加(甲16, 1)));    // -32768（682 原语义等价）
    整16 乙16 = 30000;
    打印(整32(回绕乘(乙16, 乙16))); // 900000000 低16位 → -5888
    // ③ 整32 / 整64 上界回绕
    整32 甲32 = 2147483647;
    打印(回绕加(甲32, 1));          // -2147483648
    整64 甲64 = 9223372036854775807;
    打印(回绕加(甲64, 1));          // -9223372036854775808
    // ④ 无符号代表
    正16 甲U = 60000;
    打印(整32(回绕加(甲U, 10000))); // 70000 mod 65536 = 4464（502 原锚等价）
    正8 乙U = 255;
    打印(整32(回绕加(乙U, 1)));     // 0
    // ⑤ 混合宽度同运算符规则（字面量豁免窄域参与·跨宽度提升较宽侧）
    整16 升16 = 200;
    打印(整32(回绕加(甲8, 升16)));  // 整8+整16 → 提升整16：127+200=327
    // ⑥ 编译期常量折叠面（不报错）
    打印(回绕加(2147483647, 1));    // -2147483648（常量折叠）
    打印(回绕乘(30000, 30000));     // 900000000（两字面量按提升链归 整32 域·域内即原值）
    返回 0;
}
