// 301 守卫增强探针：①&& 右侧守卫传导 ②取反+恒返回→延续正向守卫
导入 容器::向量;

函数 主() -> 整32 {
    向量<整64> 甲 = 向量<整64>();
    向量<整64> 乙 = 向量<整64>();
    结果<空类型, 整32> 加甲 = 甲.追加(10);
    结果<空类型, 整32> 加乙 = 乙.追加(20);

    // 形态①：&& 右侧守卫（此前 then 内访问 乙.值 被拒）
    如果 (甲.大小() > 0 && 乙.大小() > 0) { }
    结果<整64, 整32> 读甲 = 甲.读取(0);
    结果<整64, 整32> 读乙 = 乙.读取(0);
    如果 (读甲.正常 && 读乙.正常) {
        打印(读甲.值 + 读乙.值);          // 30（双守卫传导）
    }

    // 形态②：取反+恒返回 → 延续正向守卫
    结果<整64, 整32> 值 = 甲.读取(0);
    如果 (!值.正常) {
        返回 1;
    }
    打印(值.值);                           // 10（延续守卫）

    // 形态③：三连 &&（右结合递归）
    向量<整64> 丙 = 向量<整64>();
    结果<空类型, 整32> 加丙 = 丙.追加(1);
    结果<整64, 整32> 读丙 = 丙.读取(0);
    结果<整64, 整32> 读甲2 = 甲.读取(0);
    结果<整64, 整32> 读乙2 = 乙.读取(0);
    如果 (读丙.正常 && 读甲2.正常 && 读乙2.正常) {
        打印(读丙.值 + 读甲2.值 + 读乙2.值);   // 31
    }
    返回 0;
}
