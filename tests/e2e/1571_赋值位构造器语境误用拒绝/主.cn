// E2E 1571_赋值位构造器语境误用拒绝（#1666·双编译对照负例）：
//   赋值位构造器语境白名单**补齐后的拒绝面回归锁**——白名单只放行
//   结果/可选 **持有型盒目标**；下列形态目标非盒（标量/指针/多级指针），
//   宿主与 v2 必须同拒（构造器 某些 落 结果/可选 之外的误用不放行）：
//   ①标量标识符赋值位（`整64 数; 数 = 某些(…)`）；
//   ②标量解引用赋值位（`*针 = 某些(…)`，pointee=整64）；
//   ③标量字段 of 数组元素（`组[0].数 = 某些(…)`——成员递归面放行只限盒字段）；
//   ④多级指针解引用（`*外针 = 某些(…)`，*外针 类型=可选<整64>* 指针值非盒）。
//   修前 v2 对 ①②③④ 全拒（因语境恒 0）——但那是「漏设语境」的副作用；
//   语境补齐后须仍拒（防把误用一并放行=白名单放宽过度）。
结构体 盒 {
    整64 数;
}

不安全 函数 主() -> 整32 {
    整64 数 = 5;
    数 = 某些(1);                          // ①标量标识符赋值位

    整64* 针 = &数;
    *针 = 某些(2);                         // ②标量解引用赋值位

    盒[2] 组;
    组[0] = 盒{ 数 = 0 };
    组[1] = 盒{ 数 = 0 };
    组[0].数 = 某些(3);                    // ③标量字段 of 数组元素

    可选<整64>* 内针;
    可选<整64>** 外针 = &内针;
    *外针 = 某些(4);                       // ④多级指针解引用（结果=指针非盒）

    打印(整数转字符串(数));
    返回 0;
}
