// 函数特性增强（Task 2.10）：函数重载 / 默认参数 / 强制类型转换 / lambda 表达式
// 覆盖：
//   1. 函数重载：三版 `加`（整32/浮64/字符串）决议正确；mangling 符号不冲突
//   2. 默认参数：`问候()`（补缺省）/ `问候("张三")`（显式）；右向左连续声明
//   3. 强制类型转换：浮64(3)/4、整32(3.99)、指针↔整数、整32(浮)、浮64(整)
//   4. lambda：[] 无捕获（返回推导 + 调用）、[=] 值捕获、[&] 引用捕获
// 语法依据（cn-language-spec 04-一B/一C/一D/一E，Task 2.10）
函数 加(整32 a, 整32 b) -> 整32 {
    返回 a + b;
}

函数 加(浮64 a, 浮64 b) -> 浮64 {
    返回 a + b;
}

函数 加(字符串 a, 字符串 b) -> 字符串 {
    返回 a + b;
}

// 默认参数：从右向左连续声明；默认值在原型声明中给出（本函数即定义）
函数 问候(字符串 名字 = "世界") -> 字符串 {
    返回 "你好，" + 名字;
}

// 多默认参数（右向左连续）：f(a, b=10, c=20) —— 调用可省略 b/c 或仅 c
函数 求和(整32 a, 整32 b = 10, 整32 c = 20) -> 整32 {
    返回 a + b + c;
}

// 强制类型转换 + lambda 组合场景
函数 主() -> 整32 {
    // ---- 1. 函数重载 ----
    整32 整和 = 加(1, 2);
    打印("重载整32: ", 整和);                    // 重载整32: 3
    浮64 浮和 = 加(1.5, 2.25);
    打印("重载浮64: ", 浮和);                    // 重载浮64: 3.750000
    字符串 串和 = 加("中", "国");
    打印("重载字符串: ", 串和);                  // 重载字符串: 中国
    字符串释放(串和);

    // 重载决议按实参类型匹配：整32 字面量精确命中 整32 版本
    打印("重载整32精确: ", 加(100, 200));        // 重载整32精确: 300

    // ---- 2. 默认参数 ----
    字符串 默1 = 问候();
    打印("默认问候: ", 默1);                     // 默认问候: 你好，世界
    字符串释放(默1);
    字符串 默2 = 问候("张三");
    打印("显式问候: ", 默2);                     // 显式问候: 你好，张三
    字符串释放(默2);
    打印("默认求和1: ", 求和(1));                // 默认求和1: 31
    打印("默认求和2: ", 求和(1, 2));             // 默认求和2: 23
    打印("默认求和3: ", 求和(1, 2, 3));          // 默认求和3: 6

    // ---- 3. 强制类型转换 ----
    浮64 比例 = 浮64(3) / 4;
    打印("转换浮64(3)/4: ", 比例);               // 转换浮64(3)/4: 0.750000
    整32 截断 = 整32(3.99);
    打印("转换整32(3.99): ", 截断);              // 转换整32(3.99): 3
    整64 地址值 = 123456;
    指针 通用指针 = 指针(地址值);
    整64 地址回读 = 整64(通用指针);
    打印("指针↔整数: ", 地址回读);               // 指针↔整数: 123456
    打印("整32转浮: ", 浮64(整32(7)));           // 整32转浮: 7.000000
    打印("字符转整: ", 整32('A'));               // 字符转整: 65
    正64 无符号 = 4000000000U;
    打印("正64转浮: ", 浮64(无符号));            // 正64转浮: 4000000000.000000

    // ---- 4. lambda 表达式 ----
    // [] 无捕获：返回类型推导（单一返回表达式）
    自动 加倍 = [](整32 x) -> 整32 { 返回 x * 2; };
    打印("lambda无捕获: ", 加倍(21));            // lambda无捕获: 42
    // 无返回标注推导：自动 平方 = [](整32 x) { 返回 x * x }
    自动 平方 = [](整32 x) { 返回 x * x; };
    打印("lambda推导返回: ", 平方(9));           // lambda推导返回: 81
    // [=] 值捕获：捕获外层变量
    整32 因子 = 5;
    自动 乘因子 = [=](整32 x) { 返回 x * 因子; };
    打印("lambda值捕获: ", 乘因子(6));           // lambda值捕获: 30
    // [&] 引用捕获：引用外层变量（读取最新值）
    整32 计数 = 10;
    自动 加计数 = [&](整32 x) { 返回 x + 计数; };
    打印("lambda引用捕获: ", 加计数(5));         // lambda引用捕获: 15
    // [变量] 显式捕获
    整32 增量 = 100;
    自动 加增量 = [增量](整32 x) { 返回 x + 增量; };
    打印("lambda显式捕获: ", 加增量(1));         // lambda显式捕获: 101
    // 无参 lambda（返回动态拼接字符串，调用方释放）
    自动 说你好 = [] { 返回 "你好" + "lambda"; };
    字符串 你好结果 = 说你好();
    打印("lambda无参: ", 你好结果);              // lambda无参: 你好lambda
    字符串释放(你好结果);

    返回 0;
}
