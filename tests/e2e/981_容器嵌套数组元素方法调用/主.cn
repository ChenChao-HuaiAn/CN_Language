// E2E 981（747 轮·715 同根嵌套形态锁面）：容器嵌套数组元素方法调用全链——
//   根因=v2 收集泛型实例文本 对数组类型文本（向量$向量$整32[3]）整串收集进
//   泛型实例们→剥实例参数段 把 [3] 吞进实参段（T=向量$整32[3]/整32[3]）→
//   实例化注册 克隆 stdlib 向量类→方法体 结果<T,整32> 单态化为
//   结果<整32[3],整32>→结果载荷字节 三分支全 miss→#648 显形中止
//   （[内部错误] 结果载荷字节 '整32[3]' 未登记·715 win 本地存量红同根）。
//   根治=收集面剥数组后缀（循环剥多维）——泛型实例身份=数组元素类型
//   （宿主 instantiateGeneric 实参取自 AST 结构化字段同语义对齐·零分叉）。
//   锁面：嵌套 向量<向量<整32>>[3] 与单层 向量<整32>[2] 声明+元素赋值+
//   元素方法调用（.大小()）双侧一致输出 1/1。
导入 容器::向量;
函数 主() -> 整32 {
    向量<向量<整32>>[3] 槽;
    向量<向量<整32>> 里;
    向量<整32> 元;
    结果<空类型, 整32> 加1 = 元.追加(7);
    如果 (!加1.正常) { 返回 1; }
    结果<空类型, 整32> 加2 = 里.追加(元);
    如果 (!加2.正常) { 返回 2; }
    槽[0] = 里;
    打印(槽[0].大小());
    向量<整32>[2] 单层;
    向量<整32> v;
    结果<空类型, 整32> 加3 = v.追加(5);
    如果 (!加3.正常) { 返回 3; }
    单层[1] = v;
    打印(单层[1].大小());
    返回 0;
}
