// 1498 循环累积字符星视图（750 复审 P1-4·双编译对照）
//   病：解析层把 `字符*` 合成为类型名「字符*」且指针层=0（解析表达式尾.cn），
//   v2 判定要求 文本=="字符" 且 附加%256>0 永不命中 → 视图局部漏检；宿主单变量
//   canonical=="字符*" 已覆盖，但 `字符*[N]` 视图数组双侧均未登记。
//   后果：视图存在时循环累积被错误优化（视图读 s 得构建器期间旧值/快照）。
//   修：v2 基名判定补 字符* 前缀（含 字符*[N]）；宿主补 视图数组元素=字符*。
// 预期：视图形态 优化=0（不优化·分配次数>4）+ 输出 S=xxxxxxx；数组形态同锁。
//   健康对照：无视图函数 优化=1（优化生效）——防「全禁」假绿。
不安全 函数 视图形态() -> 整32 {
    字符串 s = "";
    字符* 视 = "V";
    整64 前 = 内存::总分配次数();
    循环 (整64 k = 0; k < 8; k++) {
        s = s + "x";
    }
    整64 次 = 内存::总分配次数() - 前;
    打印("S=", s, " 视=", 视);
    布尔 降 = 次 <= 4;
    如果 (降) { 打印("视图优化=1"); } 否则 如果 (次 > 4) { 打印("视图优化=0"); }
    返回 0;
}

不安全 函数 数组形态() -> 整32 {
    字符串 t = "";
    字符*[2] 表 = { "A", "B" };
    整64 前 = 内存::总分配次数();
    循环 (整64 k = 0; k < 8; k++) {
        t = t + "y";
    }
    整64 次 = 内存::总分配次数() - 前;
    打印("T=", t, " 表0=", 表[0]);
    布尔 降 = 次 <= 4;
    如果 (降) { 打印("数组优化=1"); } 否则 如果 (次 > 4) { 打印("数组优化=0"); }
    返回 0;
}

不安全 函数 对照形态() -> 整32 {
    字符串 u = "";
    整64 前 = 内存::总分配次数();
    循环 (整64 k = 0; k < 8; k++) {
        u = u + "z";
    }
    整64 次 = 内存::总分配次数() - 前;
    打印("U=", u);
    布尔 降 = 次 <= 4;
    如果 (降) { 打印("对照优化=1"); } 否则 如果 (次 > 4) { 打印("对照优化=0"); }
    返回 0;
}

不安全 函数 主() -> 整32 {
    视图形态();
    数组形态();
    对照形态();
    返回 0;
}
