// E2E 1016_多级指针声明与显式解引用（615+639 锁用例·2026-10-16；882 回归轮扩展 N=3）
// 锁面：#639——多级指针声明（修复前双侧声明前瞻仅认单星→误当表达式报
//   「未声明的标识符」）；#615——显式 * 解引用后的成员访问=合法面（不得误伤；
//   多级指针直接成员访问的拒绝面=136 负测锁）。
// 001 §4.4：. 自动解引用仅一级（p.字段 ≡ (*p).字段）；多级指针不继续解引用
//   ——显式 * 解引用后访问=合法。层级公式（882 回归轮）：基址=min(k+1, N) 层
//   （k=显式 * 数、N=变量层数）；本用例覆盖 N=2（k=1/2）与 N=3（k=2）读写面。
结构体 点 {
    整32 x;
    整32 y;
}
不安全 函数 主() -> 整32 {
    点 p = 点{ x = 10, y = 20 };
    点* q = &p;
    点** qq = &q;
    点* q2 = *qq;
    打印("x=", q2.x);
    (*qq).x = 30;
    打印("x2=", p.x);
    打印("x3=", (*qq).x);
    点 p3 = 点{ x = 3, y = 4 };
    点* q3 = &p3;
    点** qq3 = &q3;
    点*** qqq3 = &qq3;
    (**qqq3).x = 40;
    打印("x4=", p3.x);
    打印("x5=", (**qqq3).x);
    返回 0;
}
