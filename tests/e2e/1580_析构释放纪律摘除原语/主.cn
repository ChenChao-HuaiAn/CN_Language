// E2E 1580 · #1674 甲案（2026-10-26 用户批·001 §5.6 ①）：摘除(槽) 拥有槽一步
//   「释放旧值+清槽」——对标 C++ smart pointer reset/Rust Option::take 释放侧
//   内建化。覆盖：字符串变量槽/析构体内类字段摘除/级联空槽安全跳过/零泄漏闭环。
类 缓存 {
私有:
    字符串 名字;
    字符串 备注;
公开:
    函数 缓存(字符串 n, 字符串 m) { 名字 = n; 备注 = m; }
    函数 ~缓存() {
        摘除(自身.名字);
        摘除(自身.备注);
        打印("[析构·字段已摘]");
    }
}

函数 主() -> 整32 {
    字符串 s = 字符串复制("你好");
    打印(s);
    摘除(s);
    打印("摘后长度:", 字符串长度(s));
    整64 基线 = 内存::活动分配数();
    {
        缓存 c = 缓存(字符串复制("载荷"), 字符串复制("说明"));
        打印("[使用中]");
    }
    打印("泄漏:", 内存::活动分配数() - 基线);
    返回 0;
}
