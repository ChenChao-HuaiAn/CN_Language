// 1554 循环累积接口泛型字段引用形参（任务 1549·双编译对照负向）
//   病（防回归）：1549 扩展接口/泛型成员链接收者精确面时，若把引用位也当值形参
//   放行 → 循环内经字段指针间接写 s 的写穿被出口 finish 覆盖（错值）；
//   本用例锁「该保守的形态不被放宽」：接口指针字段、泛型实例字段、泛型模板
//   形参 T&（实例化 T=字符串）三形态均为引用位（取地址逃逸），双侧必须抑制
//   累积提升。
//   预期：S1=xZxZ / S2=yWyW / S3=zVzV（两轮：s=x → 写 Z → xZx → 写 Z）。
结构体 盒 {
    字符串* 指
}

接口 记口 {
    虚拟 函数 记(盒& 槽, 字符串& 参) -> 整32;
}

类 记器 : 记口 {
公开:
    函数 记器() { }
    重写 函数 记(盒& 槽, 字符串& 参) -> 整32 {
        槽.指 = &参;
        返回 0;
    }
}

类 持有口 {
公开:
    记口* 口;
    函数 持有口() { 口 = 无; }
}

泛型 <类型 T>
类 盒器 {
公开:
    T 值;
    函数 盒器() { }
    函数 记(盒& 槽, 字符串& 参) -> 整32 {
        槽.指 = &参;
        返回 0;
    }
}

类 外层盒器 {
公开:
    盒器<整64> 盒;
    函数 外层盒器() { }
}

泛型 <类型 T>
类 盒器T {
公开:
    T 值;
    函数 盒器T() { }
    函数 记泛(盒& 槽, T& 参) -> 整32 {
        槽.指 = &参;
        返回 0;
    }
}

类 外层盒器T {
公开:
    盒器T<字符串> 盒;
    函数 外层盒器T() { }
}

不安全 函数 写改(盒& 目标, 字符串 段) -> 整32 {
    *目标.指 = *目标.指 + 段;
    返回 0;
}

不安全 函数 主() -> 整32 {
    字符串 s1 = "";
    盒 槽1 = 盒{ 指 = 无 };
    持有口 外1 = 持有口();
    记器 实1 = 记器();
    外1.口 = 实1;
    外1.口.记(槽1, s1);
    循环 (整64 k = 0; k < 2; k++) {
        s1 = s1 + "x";
        写改(槽1, "Z");
    }
    打印("S1=", s1);
    字符串 s2 = "";
    盒 槽2 = 盒{ 指 = 无 };
    外层盒器 外2 = 外层盒器();
    外2.盒.记(槽2, s2);
    循环 (整64 j = 0; j < 2; j++) {
        s2 = s2 + "y";
        写改(槽2, "W");
    }
    打印("S2=", s2);
    字符串 s3 = "";
    盒 槽3 = 盒{ 指 = 无 };
    外层盒器T 外3 = 外层盒器T();
    外3.盒.记泛(槽3, s3);
    循环 (整64 m = 0; m < 2; m++) {
        s3 = s3 + "z";
        写改(槽3, "V");
    }
    打印("S3=", s3);
    返回 0;
}
