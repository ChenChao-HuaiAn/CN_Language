// E2E 210_v2（2026-09-11 第六十八轮 plans/019 阶段4' A2 方案甲）：v2 侧返回拥有
//   字符串——返回 字符串=拥有契约（调用方按返回类型登记 RAII 释放——白名单∪
//   返回类型契约，Rust fn f() -> String 同款）/返回 字符*=借用（零拷贝不登记）。
//   v2 语法面子集六形态：①拼接建造返回（登记+移出）②字面量返回（返回位拥有化
//   落堆）③拥有变量返回（移出）④字符* 借用返回（驻留文本 透传）⑤调用链拥有
//   转发 ⑥字符* 持有显式复制。校验和折位（1/2/4/8/16/32），退出码 63=全对。
函数 造拼接(整64 n) -> 字符串 {
    字符串 s = "";
    整64 i = 0;
    当 (i < n) { s = s + "a"; i++; }
    返回 s;
}
函数 造字面量() -> 字符串 {
    返回 "字面量";
}
函数 造移出() -> 字符串 {
    字符串 s = 造拼接(3);
    返回 s;
}
函数 借用名(整64 id) -> 字符* {
    返回 驻留文本(id);
}
函数 转发(整64 n) -> 字符串 {
    返回 造拼接(n);
}
函数 主() -> 整32 {
    整32 校验 = 0;
    字符串 a = 造拼接(4);            // 调用初值=返回类型契约登记（RAII 释放）
    如果 (字符串比较(a, "aaaa")) { 校验 = 校验 + 1; }
    字符串 b = 造字面量();           // 字面量返回位 copy 落堆
    如果 (字符串比较(b, "字面量")) { 校验 = 校验 + 2; }
    字符串 c = 造移出();             // 双层拥有移交
    如果 (字符串比较(c, "aaa")) { 校验 = 校验 + 4; }
    字符串 d = 转发(2);              // 三层链
    如果 (字符串比较(d, "aa")) { 校验 = 校验 + 8; }
    整64 id = 驻留("借用视图");
    如果 (字符串比较(借用名(id), "借用视图")) { 校验 = 校验 + 16; }
    字符串 e = 字符串复制(借用名(id));   // 字符* 持有须显式复制
    如果 (字符串比较(e, "借用视图")) { 校验 = 校验 + 32; }
    返回 校验;
}
