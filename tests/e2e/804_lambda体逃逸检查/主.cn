// 804_lambda体逃逸检查（#486·435 体内面收口·dual 负测）
// 435 立法（001「[&] 引用捕获逃逸限制」）检出形态无「lambda 体内」豁免——
//   原实现经 lambda 体上下文跳过实现两侧一致不查（688 立法：v2 合成体结构
//   性跳过语句检查+宿主对齐）。#486 建设 v2 合成体检查面（检查合成体逃逸·
//   lambda合成类型 挂载）+宿主解除短路（传播表快照栈），体内语句的返回/
//   声明/赋值/实参位双侧同查（宁严勿松·零分叉）。
// 负例三形态（同一体内上下文·外层 735/736 已锁面的体内版）：
//   ① 体内实参逃逸：体内 [&] 捕获体内变量的闭包作为实参传出（实参位）；
//   ② 体内返回逃逸（直接）：体内 [&] 捕获体内变量的闭包被返回（返回位）；
//   ③ 体内返回逃逸（传播链）：体内闭包经两个局部变量传播后返回（保守值集）。
// 应放行面（不逃逸·由 706/707/801 既有 dual 锁面承担零误伤锚）：
//   体内 [&] 闭包存体内变量后同帧立即调用（被调位不扫描·合法面）。
// 预期失败：双侧编译拒绝，诊断锚「逃逸当前栈帧」。
函数 消费回调(整32(*回调)()) -> 整32 {
    返回 回调();
}
函数 体内实参逃逸() -> 整32 {
    变量 g = [&]() -> 整32 {
        变量 w = 9;
        返回 消费回调([&]() -> 整32 { 返回 w; });
    };
    返回 g();
}
函数 体内返回逃逸直接() -> 整32 {
    变量 h = [&]() {
        变量 q = 7;
        返回 [&]() -> 整32 { 返回 q; };
    };
    返回 0;
}
函数 体内返回逃逸传播() -> 整32 {
    变量 k = [&]() {
        变量 q2 = 8;
        变量 内 = [&]() -> 整32 { 返回 q2; };
        变量 同 = 内;
        返回 同;
    };
    返回 0;
}
函数 主() -> 整32 {
    返回 0;
}
