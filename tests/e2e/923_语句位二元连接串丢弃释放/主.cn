// E2E 923（2026-10-14·任务 663）：语句位二元连接串丢弃释放——双侧同修回归。
//   立案背景（663 探针双侧实锤）：`"a"+甲;` 独立表达式语句（连接产物被丢弃）
//   每语句净泄 1——645 修复面只覆盖调用返回形态（CallExpr/节点_调用），
//   二元连接产物同为堆串（宿主三路径 ptr+ptr/串+标量/整128 均发射
//   __cn_str_concat；v2 发射字符串拼接 唯一登记 T_字符串）语句位零释放。
//   修复：宿主 visitExprStmt 扩 BinaryExpr 分支（op=加 且 产物 ptr 且
//   定义点溯源 isConcatResultReg 命中 __cn_str_concat → 语句尾 free）；
//   v2 发射语句位弃串释放 扩 节点_二元运算 分支（op 为 + 且 弃值寄存器
//   登记 T_字符串 → 同款 free）——登记点=发射字符串拼接 单点，指针算术
//   （步进糖）与标量算术产物登记整型=天然排除（防双释放/防误伤同 645 守卫带）。
//   断言口径（908 同款）：每形态百轮 内存::活动分配数() 差值恒 0，折位：
//     ①字面量+变量连接=16 ②变量+变量连接=32 ③串+整数隐式拼接=64
//     ④指针算术防误伤对照（不崩+内容不破坏+分配平衡）=128 —— 240=全对。
//   644 面规避：连接实参一律字面量/变量（传参位拥有串临时实参=任务 644
//   另案 907，不入本面）；645 面规避：无调用形态（908 已锁）。

// ① 语句位 字面量+变量 连接（`"a"+甲;` 立案形态）——修复后每轮净泄 0
函数 字面量加变量位() -> 整64 {
    字符串 甲 = "基串内容甲乙丙丁";
    整64 前 = 内存::活动分配数();
    整32 i = 0;
    当 (i < 100) {
        "a" + 甲;
        i += 1;
    }
    返回 内存::活动分配数() - 前;
}

// ② 语句位 变量+变量 连接（双借用操作数·产物为新堆串）
函数 变量加变量位() -> 整64 {
    字符串 甲 = "基串内容甲乙丙丁";
    字符串 乙 = "第二串内容戊己庚辛";
    整64 前 = 内存::活动分配数();
    整32 i = 0;
    当 (i < 100) {
        甲 + 乙;
        i += 1;
    }
    返回 内存::活动分配数() - 前;
}

// ③ 语句位 串+整数 隐式拼接（右操作数经 __cn_str_from_int 转换路径）
函数 串加整数位() -> 整64 {
    字符串 甲 = "基串内容甲乙丙丁";
    整64 前 = 内存::活动分配数();
    整32 i = 0;
    当 (i < 100) {
        甲 + i;
        i += 1;
    }
    返回 内存::活动分配数() - 前;
}

// ④ 防误伤对照：指针算术语句位（产物非堆串·禁入 free 通道——误 free=
//    UB 崩溃/堆损坏；断言=百轮后内容不破坏+分配平衡+不崩）
不安全 函数 指针算术位() -> 整64 {
    整32[4] 元素们;
    元素们[0] = 42;
    元素们[1] = 43;
    整32* p = 元素们;
    整64 前 = 内存::活动分配数();
    整32 i = 0;
    当 (i < 100) {
        p + 1;
        i += 1;
    }
    整64 差 = 内存::活动分配数() - 前;
    如果 (p[0] != 42 || p[1] != 43) { 返回 -1; }
    返回 差;
}

函数 主() -> 整32 {
    整32 和 = 0;
    如果 (字面量加变量位() == 0) { 和 += 16; }
    如果 (变量加变量位() == 0) { 和 += 32; }
    如果 (串加整数位() == 0) { 和 += 64; }
    如果 (指针算术位() == 0) { 和 += 128; }
    打印行(和);
    返回 和;
}
