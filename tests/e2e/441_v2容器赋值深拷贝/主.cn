// E2E 441（2026-09-18 第 346 轮·T57 根治门禁）：v2 容器/用户类对象「赋值语句」
//   深拷贝语义——覆盖三形态：①标识符左值 ②引用参数左值 ③成员链左值。
//   断言=输出逐行（值语义：改副本不影响源）+ 退出码 0；宿主/v2 双编译同源同测
//   （打印型分叉盲区覆盖——本缺陷在 v2 原为「句柄写坏/共享双释放」的崩溃/静默形态，
//   只锚退出码不足以区分）。
//   依据：plans/001 引用参数条（`T&` 实参传左值地址、赋值经指针写回调用方）+
//   宿主 H6（2026-08-25）拷贝构造深拷贝语义（宿主 IR 铁证：新建对象+拷贝构造）；
//   v2 原缺=8 字节句柄浅覆盖 → 赋值后两变量共享同一堆对象、双方 RAII 各自析构。
导入 容器::向量;

结构体 表盒 {
    向量<整64> 项;
}

函数 重填引用(向量<整64>& 目标) -> 空类型 {
    向量<整64> 新表 = 向量<整64>();
    结果<空类型, 整32> 加 = 新表.追加(99);
    如果 (!加.正常) { 运行时错误(4); }
    目标 = 新表;
}

函数 重填字段(表盒& 盒) -> 空类型 {
    向量<整64> 新表 = 向量<整64>();
    结果<空类型, 整32> 加 = 新表.追加(7);
    如果 (!加.正常) { 运行时错误(4); }
    盒.项 = 新表;
}

类 袋子 {
公开:
    整64 计数;
    向量<整64> 装;
    函数 袋子() {
        计数 = 0;
        装 = 向量<整64>();
    }
}

函数 主() -> 整32 {
    // ① 标识符左值：乙 = 甲（深拷贝——改乙不影响甲）
    向量<整64> 甲 = 向量<整64>();
    结果<空类型, 整32> 加1 = 甲.追加(1);
    如果 (!加1.正常) { 运行时错误(4); }
    向量<整64> 乙 = 向量<整64>();
    乙 = 甲;
    打印("A1 乙大小=", 乙.大小());
    结果<空类型, 整32> 加2 = 乙.追加(2);
    如果 (!加2.正常) { 运行时错误(4); }
    打印("A1 甲大小=", 甲.大小());
    打印("A1 乙大小=", 乙.大小());
    // ② 引用参数左值：向量引用参数整体赋值写回调用方
    向量<整64> 丙 = 向量<整64>();
    结果<空类型, 整32> 加3 = 丙.追加(1);
    如果 (!加3.正常) { 运行时错误(4); }
    重填引用(丙);
    打印("A2 丙大小=", 丙.大小());
    打印("A2 丙首=", 丙.元素(0));
    // ③ 成员链左值：结构体引用参数的容器字段整体赋值
    表盒 盒 = 表盒{ 项 = 向量<整64>() };
    重填字段(盒);
    打印("A3 盒大小=", 盒.项.大小());
    打印("A3 盒首=", 盒.项.元素(0));
    // ④ 类对象「成员链左值」标量字段 + 容器字段赋值（类基址=对象指针非槽地址）
    袋子 袋;
    袋.计数 = 5;
    打印("A4 袋计数=", 袋.计数);
    // ⑤ 类对象「引用参数」成员链赋值见 442_v2（v2 闭环）——宿主侧该形态为
    //   plans/020 第五十四节 142-a 已登记欠账（用户类字段泛化回退·正解=波4 复制(x)），
    //   双编译对照暂不可用。
    返回 0;
}
