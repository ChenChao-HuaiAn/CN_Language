// E2E 442（2026-09-18 第 346 轮·T58 门禁）：**类对象「引用参数」的成员链左值赋值**
//   ——对象基址 = Load 槽（对象指针）而非槽地址；引用参数形态=两级（Load 槽得
//   调用方变量地址 → 指针加载得对象指针）。
//   背景：v2 原实现 顺序链标识符地址 尾端对类对象变量落 `IR_取地址`（槽地址）
//   → 成员链左值以「槽地址+字段偏移」写穿栈槽（探针 p13 段错误 rc=139）。
//   宿主侧该形态为 plans/020 第五十四节 142-a 已登记欠账（用户类字段泛化回退·
//   正解=波4 复制(x)），故本用例走 v2 闭环（只跑 v2）。
导入 容器::向量;

类 袋子 {
公开:
    整64 计数;
    向量<整64> 装;
    函数 袋子() {
        计数 = 0;
        装 = 向量<整64>();
    }
}

函数 填袋(袋子& 目标, 整64 值) -> 空类型 {
    目标.计数 = 值;
    向量<整64> 新表 = 向量<整64>();
    结果<空类型, 整32> 加 = 新表.追加(值);
    如果 (!加.正常) { 运行时错误(4); }
    目标.装 = 新表;
}

函数 主() -> 整32 {
    袋子 袋;
    填袋(袋, 9);
    打印("计数=", 袋.计数);
    打印("装大小=", 袋.装.大小());
    打印("装首=", 袋.装.元素(0));
    返回 0;
}
