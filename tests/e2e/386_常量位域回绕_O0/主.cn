// D31 方案C（258-a）回绕语义锚定：超域字面量/常量折叠/传播在 -O3 与 -O0 输出一致
// （386 为同源 -O0 基线；两用例 .expected 逐字节相同=折叠一致性机械锚定）
函数 主() -> 整32 {
    整32 a = 5000000000;
    打印(a);
    打印行(a);
    // 319-a 适配（C18①·§8.4 通告）：常量溢出已改编译期硬错误——本用例
    //   的位域回绕语义改由变量面承载（方案甲设计通道·值不变）
    整32 甲变量 = 2000000000;
    整32 b = 甲变量 + 2000000000;
    打印(b);
    打印行(b);
    整64 c = 9000000000000000000;
    打印(c);
    打印行(c);
    整64 d = c + c;
    打印(d);
    打印行(d);
    正32 e = 4000000000;
    打印(e / 2);
    打印行(e / 2);
    // 319-a 适配（T36·§8.4 通告）：超域字面量窄化已改硬错误——显式转换承载
    //   位模式截断语义（§3.7 降宽=低位截断·值不变）
    整32 g字面 = 40000;
    整16 f = 整16(g字面);
    打印(f);
    打印行(f);
    返回 0;
}
