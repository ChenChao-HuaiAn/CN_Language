// 1408 执法四·件1 修前红探针（六面形态谱）
// 病灶：findReturnExpr880raii 只递归 Block/If——先序首个可达 return 藏于
//   循环/选择体内时被跳过，判据落到白名单面更晚的非标识符 return（构造
//   调用）或搜不到（rv=nullptr）→ 保守豁免 → 接收槽豁免析构=泄 1/轮。
// 面1-4=穷举递归修复面；面5=既有绿对照；面6=构造调用 return 判拥有补面。
导入 容器::向量;

类 货架 {
公开:
    向量<字符串> 记录;
    函数 货架() { 记录 = 向量<字符串>(); }
    函数 ~货架() { }
    不安全 函数 货架(货架& 其他) { 记录 = 其他.记录; }
}

// 面1：当循环体内 return 标识符（先序首位）+ 块尾构造调用 return
函数 造货架当() -> 货架 {
    货架 局部 = 货架();
    结果<空类型, 整32> 加 = 局部.记录.追加("甲");
    当 (真) {
        如果 (!加.正常) {
            返回 局部;
        }
        返回 局部;
    }
    返回 货架();
}

// 面2：循环(三段)体内 return 标识符 + 块尾构造调用 return
函数 造货架循环() -> 货架 {
    货架 局部2 = 货架();
    结果<空类型, 整32> 加2 = 局部2.记录.追加("乙");
    循环 (整32 i = 0; i < 1; i += 1) {
        如果 (!加2.正常) {
            返回 局部2;
        }
        返回 局部2;
    }
    返回 货架();
}

// 面3：遍历体内 return 标识符（容器元素副本）+ 块尾构造调用 return
函数 造货架遍历(向量<货架> 池) -> 货架 {
    遍历 池 中 每个 元素 {
        结果<空类型, 整32> 加3 = 元素.记录.追加("丙");
        如果 (!加3.正常) {
            返回 元素;
        }
        返回 元素;
    }
    返回 货架();
}

// 面4：选择 情况 内 return 标识符（块尾无 return·修前 rv=nullptr 面）
函数 造货架选择(整32 模式) -> 货架 {
    货架 局部3 = 货架();
    结果<空类型, 整32> 加4 = 局部3.记录.追加("丁");
    选择 (模式) {
        情况 1:
            返回 局部3;
        默认:
            返回 局部3;
    }
}

// 面5 对照：If 分支标识符 return（1652 同款形态·修前已绿）
函数 造货架对照() -> 货架 {
    货架 对照局部 = 货架();
    结果<空类型, 整32> 加5 = 对照局部.记录.追加("戊");
    如果 (!加5.正常) {
        返回 对照局部;
    }
    返回 对照局部;
}

// 面6 补面：If 内构造调用 return 首位（错误路径返回新对象·770 口径）
函数 造货架构造返回() -> 货架 {
    货架 备用 = 货架();
    结果<空类型, 整32> 加6 = 备用.记录.追加("己");
    如果 (!加6.正常) {
        返回 货架();
    }
    返回 备用;
}

函数 主() -> 整32 {
    向量<货架> 池 = 向量<货架>();
    结果<空类型, 整32> 追1 = 池.追加(货架());
    如果 (!追1.正常) { 返回 1; }

    整64 基1 = 内存::活动分配数();
    循环 (整32 i = 0; i < 100; i += 1) {
        货架 接收1 = 造货架当();
    }
    打印(整64(内存::活动分配数() - 基1));

    整64 基2 = 内存::活动分配数();
    循环 (整32 i = 0; i < 100; i += 1) {
        货架 接收2 = 造货架循环();
    }
    打印(整64(内存::活动分配数() - 基2));

    整64 基3 = 内存::活动分配数();
    循环 (整32 i = 0; i < 100; i += 1) {
        货架 接收3 = 造货架遍历(池);
    }
    打印(整64(内存::活动分配数() - 基3));

    整64 基4 = 内存::活动分配数();
    循环 (整32 i = 0; i < 100; i += 1) {
        货架 接收4 = 造货架选择(1);
    }
    打印(整64(内存::活动分配数() - 基4));

    整64 基5 = 内存::活动分配数();
    循环 (整32 i = 0; i < 100; i += 1) {
        货架 接收5 = 造货架对照();
    }
    打印(整64(内存::活动分配数() - 基5));

    整64 基6 = 内存::活动分配数();
    循环 (整32 i = 0; i < 100; i += 1) {
        货架 接收6 = 造货架构造返回();
    }
    打印(整64(内存::活动分配数() - 基6));

    返回 0;
}
