// 官网文档示例 · reference/lexical.html · 字面量（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
函数 主() -> 整32 {
    字符 c1 = '甲';             // Unicode 码点（4 字节）
    字符 c2 = '\n';             // 转义
    字符 c3 = '\u{4E2D}';       // Unicode 转义 = '中'
    字符串 普通 = "第一行\n";
    字符串 原样 = 原始"正则^\d+$";     // 反斜杠不转义
    字符串 多行文 = 多行"""第一行
第二行""";                     // 内部仍处理转义
    打印(字符串长度(普通), 字符串长度(原样), 字符串长度(多行文));
    返回 0;
}