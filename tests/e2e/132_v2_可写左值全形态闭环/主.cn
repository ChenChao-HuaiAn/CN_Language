// E2E 132_v2_可写左值全形态闭环（缺陷②根治 v2 侧，用户裁决 2026-09-03）
// 载体：① v2 语义层可写左值白名单（变量[非常量]/成员/指针下标/解引用）全形态
//         不误伤实证——各形态赋值后读回断言，任一退化即失败码退出；
//       ② v2p 尾部负测自检行固化（主.expected 断言「非左值赋值负测通过」
//         「常量赋值负测通过」）——防「宿主拒/v2 收」判定分歧（半实现纪律）。
// 宿主语义权威：visitAssignmentExpr 白名单（标识符[非常量]/下标/解引用*/
//               成员/引用返回调用）+ 常量重赋值拒绝 + ++/-- 左值检查。
// 闭环：v2p 编译 -> 汇编/链接宿主运行时 -> 运行。退出码=0 全过；11~14 失败码。
结构体 点 {
    整64 x
    整64 y
}

函数 主() -> 整32 {
    // ===== 一、变量左值（简单赋值 + 复合赋值 + 自增）=====
    整64 甲 = 10
    甲 = 20
    甲 += 5
    甲++
    如果 (甲 != 26) { 返回 11 }

    // ===== 二、成员左值（p.x = v / p.x += v）=====
    点 p
    p.x = 7
    p.y = 3
    p.x += p.y
    如果 (p.x != 10 || p.y != 3) { 返回 12 }

    // ===== 三、解引用左值（*指针 = v）+ 指针下标左值（指针[0] = v / += v）=====
    // 注：&p.x 后必须加分号——换行≡空格（01a §三），无分号时 &p.x 换行 *指针
    //   粘连成 &(p.x * 指针)（131 用例同族形态，v2 语义层空左值赋值检查拦截）
    整64* 指针 = &p.x;
    *指针 = 100
    如果 (p.x != 100) { 返回 13 }
    指针[0] += 1
    如果 (p.x != 101) { 返回 14 }

    // 运行时人眼审计锚点（退出码断言之外的产物输出）
    打印(甲)                    // 26
    打印(p.x + p.y)             // 104
    打印("可写左值全形态: 全部通过")
    返回 0
}
