// E2E 284（2026-09-15 第二百零六轮 b 206-b·波 4 子轮一）：
//   **复制(表达式) 泛型克隆内置**宿主正测——与 转移(x) 构成显式「复制/移动」
//   双内置（C++ copy/move 对照物；plans/022 §四.5）。五形态：
//     ①字符串（__cn_str_copy 落堆独立拥有）②标量直通（零开销）
//     ③结构体深拷（临时槽+CopyWithFields，块出口残留 0）
//     ④容器深拷（NewObject+拷贝构造，残留 0）
//     ⑤字段容器接收者+复制(拥有调用返回)=接管（零额外拷贝，残留 0——
//       临时归表达式，对临时再 copy 会泄漏原临时，探针迭代实证后修正）。
//   v2 侧边界登记：复制 内置 v2 侧暂不支持（未声明诊断+诊断路径堆损坏
//   新案 206-c 前置专项），284 为宿主正测（v2 对照面随新案修复补）。
导入 容器::向量;
导入 IO::打印;
结构体 盒子 {
    字符串 名;
}
类 货架 {
公开:
    向量<字符串> 记录;
    函数 货架() { 记录 = 向量<字符串>(); }
    函数 ~货架() { }
    不安全 函数 货架(货架& 其他) { 记录 = 其他.记录; }
}
函数 造串() -> 字符串 {
    返回 字符串复制("返回串");
}
函数 主() -> 整32 {
    // ① 字符串复制
    字符串 甲 = 字符串复制("原始串");
    字符串 乙 = 复制(甲);
    打印("① ", 甲, " / ", 乙, " 长度=", 字符串长度(乙));
    // ② 标量直通
    整64 n = 复制(123);
    打印("② ", n);
    // ③ 结构体深拷（独立拥有）
    整64 b = 内存::活动分配数();
    { 盒子 p; p.名 = 字符串复制("盒子名");
      盒子 q = 复制(p);
      打印("③ ", q.名, " 源=", p.名); }
    打印("③ 结构体残留=", 内存::活动分配数() - b);
    // ④ 容器深拷（独立拥有）
    整64 b2 = 内存::活动分配数();
    { 货架 s1; 结果<空类型, 整32> c1 = s1.记录.追加(字符串复制("容器串"));
      货架 s2 = 复制(s1);
      打印("④ 容器大小=", s2.记录.大小()); }
    打印("④ 容器残留=", 内存::活动分配数() - b2);
    // ⑤ 字段容器接收者+复制（波 4 目标形态：stdlib 切换的前置）
    整64 b3 = 内存::活动分配数();
    { 货架 s; 结果<空类型, 整32> r = s.记录.追加(复制(造串())); }
    打印("⑤ 接收者+复制 残留=", 内存::活动分配数() - b3);
    返回 0;
}
