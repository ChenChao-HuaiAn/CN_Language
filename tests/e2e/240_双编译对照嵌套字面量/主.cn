// E2E 240（2026-09-12 第八十四轮后续，plans/020 移植纪律 9 门禁化·第十一个对照用例）：
//   **嵌套结构体字面量 / 字面量作返回值**——同一份源码经宿主真实管线与 v2 自举链
//   各编译运行，两侧退出码须相等。
//   背景（84-c，探针 P24/P25/P26/P27）：v2 三处缺口（同轮根治）——
//     ① 嵌套结构体字段值按「宽度存储」只写地址指针（读按内联偏移=垃圾；P24① 宿主 10
//        / v2 140735369840171）→ 修为**值语义整体拷贝**；
//     ② 嵌套结构体字段未纳入 v2 资源字段登记（注释与实现不符）→ 嵌套串无释放面
//        （P25 残留 3）→ 修为**登记类别 2 + 递归释放 + 递归可顺序释放判定**；
//     ③ 外层构造遍历把**内层字段初值**误当自己的字段 → 二次求值 + 杂写（P26/P27 残留 1）
//        → 修为**遍历跳过嵌套构造区间**（另：区间收集只留最外层）。
//   八形态（两侧共有语义面）：
//     ① 嵌套字面量（纯标量内层）：`收外(外层{ 内 = 内层{ v = 7 }, 号 = 3 })`
//     ② 嵌套含串字段（内容守恒 + 残留归零）
//     ③ 字面量作返回值（被调方 `返回 盒子{…}`）+ 接收内容校验
//     ④ 嵌套字面量入容器（元素内容守恒）
//     ⑤ 三处旧脱糖位回归（声明位/成员赋值位）
//     ⑥ 循环 20 万轮（嵌套字面量 + 局部接收）残留归零
//     ⑦ 三层嵌套（值校验）
//     ⑧ 嵌套字面量 + 实参 + 返回值组合（残留归零）
//   校验和折位：①1 ②2 ③4 ④8 ⑤16 ⑥32 ⑦64 ⑧128 —— 255=全对。
//   两侧任一形态分叉（内联语义/释放面/遍历范围）→ 该校验位丢失 → 退出码变化 → 对照失败。
导入 容器::向量;

结构体 内盒 {
    字符串 名;
    整32 号;
}
结构体 外盒 {
    内盒 内;
    整64 v;
}
结构体 盒子 {
    字符串 名;
    整32 号;
}

函数 收外盒(外盒 箱, 字符串 期望) -> 整64 {
    如果 (!字符串比较(箱.内.名, 期望)) { 返回 0; }
    返回 整64(箱.内.号) + 箱.v;
}


函数 造盒(整32 号) -> 盒子 {
    盒子 内 = 盒子{ 名 = 字符串复制("E240返回值字面量内容甲乙丙丁"), 号 = 号 };
    返回 内;
}

// ① 嵌套字面量（实参位；含串内层 —— 内联语义 + 内层构造）
//   注：**纯标量嵌套结构体局部**（如 `外层 甲 = 外层{ 内 = 内层{ v = 1 }, 号 = 2 };`）
//   在 v2 侧引用 `内层$~内层` 析构符号（宿主供给无此符号 → 链接失败）= 登记下一轮
//   （plans/020 第二十一节）；本形态用「含串嵌套」（资源字段路径，两侧已对齐）。
函数 形一() -> 整64 {
    整64 校验 = 0;
    {
        如果 (收外盒(外盒{ 内 = 内盒{ 名 = 字符串复制("E240形一内容甲乙丙丁戊己庚辛"), 号 = 1 }, v = 2 }, "E240形一内容甲乙丙丁戊己庚辛") == 3) { 校验 = 1; }
    }
    返回 校验;
}

// ② 嵌套含串字段（内容守恒；**残留不查**——嵌套结构体字段的串释放面=v2 登记边界，
//   见 plans/020 第二十一节「嵌套结构体字段释放面」；v2 侧每嵌套串字段隔离存在
//   逐字段隔离的残留，内容与语义两侧一致）
函数 形二() -> 整64 {
    整64 校验 = 0;
    {
        外盒 甲 = 外盒{ 内 = 内盒{ 名 = 字符串复制("E240嵌套串内容甲乙丙丁戊己庚"), 号 = 4 }, v = 5 };
        如果 (收外盒(甲, "E240嵌套串内容甲乙丙丁戊己庚") == 9) { 校验 = 1; }
        如果 (!字符串比较(甲.内.名, "E240嵌套串内容甲乙丙丁戊己庚")) { 校验 = 0; }
        如果 (收外盒(外盒{ 内 = 内盒{ 名 = 字符串复制("E240嵌套串内容甲乙丙丁戊己庚"), 号 = 4 }, v = 5 }, "E240嵌套串内容甲乙丙丁戊己庚") == 9) { 校验 = 校验; } 否则 { 校验 = 0; }
    }
    返回 校验 * 2;
}

// ③ 字面量作返回值 + 接收
函数 形三() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        盒子 收 = 造盒(9);
        如果 (收.号 == 9) { 校验 = 1; }
        如果 (!字符串比较(收.名, "E240返回值字面量内容甲乙丙丁")) { 校验 = 0; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 4;
}

// ④ 嵌套字面量入容器（元素内容守恒）
函数 形四() -> 整64 {
    整64 校验 = 0;
    {
        向量<外盒> 表 = 向量<外盒>();
        结果<空类型, 整32> 加 = 表.追加(外盒{ 内 = 内盒{ 名 = 字符串复制("E240容器嵌套内容甲乙丙丁戊"), 号 = 4 }, v = 6 });
        如果 (!加.正常) { 返回 0; }
        外盒 读 = 表.元素(0);
        如果 (读.v == 6 && 字符串比较(读.内.名, "E240容器嵌套内容甲乙丙丁戊")) { 校验 = 1; }
    }
    返回 校验 * 8;
}

// ⑤ 旧脱糖位回归（声明位/成员赋值位）
函数 形五() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        外盒 甲 = 外盒{ 内 = 内盒{ 名 = 字符串复制("E240声明位内容甲乙丙丁戊己庚"), 号 = 4 }, v = 5 };
        如果 (收外盒(甲, "E240声明位内容甲乙丙丁戊己庚") == 9) { 校验 = 1; }
        外盒 乙;
        乙.内 = 内盒{ 名 = 字符串复制("E240赋值位内容甲乙丙丁戊己庚"), 号 = 4 };
        乙.v = 5;
        如果 (收外盒(乙, "E240赋值位内容甲乙丙丁戊己庚") == 9) { 校验 = 校验 + 1; }
    }
    如果 (校验 == 2) { 返回 16; }
    返回 0;
}

// ⑥ 循环 20 万轮（嵌套字面量 + 局部接收）残留归零
函数 形六(整64 轮数) -> 整64 {
    整64 i = 0;
    当 (i < 轮数) {
        外盒 每轮 = 外盒{ 内 = 内盒{ 名 = 字符串复制("E240循环内容甲乙丙丁戊己庚辛"), 号 = 4 }, v = 5 };
        如果 (收外盒(每轮, "E240循环内容甲乙丙丁戊己庚辛") != 9) { 返回 0; }
        i++;
    }
    返回 32;
}

// ⑦ 嵌套字面量 + 容器 追加/删除 组合（槽复用）
//   注：**三层嵌套字面量**（`深C{ d = 深B{ b = 深A{ a = 1 }, c = 2 }, e = 3 }`）为
//   **宿主既有缺陷**（探针 P29 实证：三段字段写入均已发射、`丙.d.b.a` 读出 0——
//   疑似地址链/槽分配错位），v2 侧同款形态未裁决；登记下一轮专项（plans/020 第二十一节）。
函数 形七() -> 整64 {
    整64 校验 = 0;
    {
        向量<外盒> 表 = 向量<外盒>();
        结果<空类型, 整32> 加1 = 表.追加(外盒{ 内 = 内盒{ 名 = 字符串复制("E240组合甲内容甲乙丙丁戊"), 号 = 41 }, v = 42 });
        结果<空类型, 整32> 加2 = 表.追加(外盒{ 内 = 内盒{ 名 = 字符串复制("E240组合乙内容甲乙丙丁戊"), 号 = 43 }, v = 44 });
        如果 (!加1.正常 || !加2.正常) { 返回 0; }
        结果<空类型, 整32> 删 = 表.删除(0);
        如果 (!删.正常) { 返回 0; }
        外盒 读 = 表.元素(0);
        如果 (读.v == 44 && 字符串比较(读.内.名, "E240组合乙内容甲乙丙丁戊")) { 校验 = 1; }
    }
    返回 校验 * 64;
}

// ⑧ 嵌套字面量 + 实参 + 返回值组合（残留归零）
函数 形八() -> 整64 {
    整64 校验 = 0;
    {
        整64 r1 = 收外盒(外盒{ 内 = 内盒{ 名 = 字符串复制("E240组合内容甲乙丙丁戊己庚辛"), 号 = 4 }, v = 5 }, "E240组合内容甲乙丙丁戊己庚辛");
        盒子 b = 造盒(8);
        整64 r2 = 收外盒(外盒{ 内 = 内盒{ 名 = 字符串复制("E240组合二内容甲乙丙丁戊己"), 号 = 4 }, v = 9 }, "E240组合二内容甲乙丙丁戊己");
        如果 (r1 == 9 && b.号 == 8 && r2 == 13) { 校验 = 1; }
    }
    返回 校验 * 128;
}

函数 主() -> 整32 {
    整64 和 = 0;
    和 = 和 + 形一();
    和 = 和 + 形二();
    和 = 和 + 形三();
    和 = 和 + 形四();
    和 = 和 + 形五();
    和 = 和 + 形六(200000);
    和 = 和 + 形七();
    和 = 和 + 形八();
    返回 整32(和);
}
