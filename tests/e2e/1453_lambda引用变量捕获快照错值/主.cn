// E2E 1453_lambda引用变量捕获快照错值（#1321 锁用例·001 §5.6「lambda 表达式」+§引用参数 A-1）：
//   闭包捕获**引用变量**（引用形参/局部引用 × 标量/结构体/类 × 单层/嵌套 ×
//   [=]快照/[&]引用/[名]显式）固化面——根治前固化段无条件取「别名槽自身地址」：
//   体内读=别名槽内容当值（静默错值）、体内写=毁外层别名槽（v=原值不写穿/类引用
//   写穿段错误）；根治后引用源分流=加载引用槽（被引用左值地址）再固化/解引用快照。
//   断言失败提前返回 131~142；成功路径打印逐项值（退出码 0）。
结构体 点 {
    整32 x;
    整32 y;
}
类 计数器 {
公开:
    整32 n;

    函数 计数器() {
        n = 0;
    }

    函数 计数器(计数器& 其他) {
        n = 其他.n;
    }
}
函数 值捕引用形参(整32& r) -> 整32 {
    变量 f = [=]() -> 整32 { 返回 r + 1; };
    返回 f();                          // 11（快照读引用目标值）
}
函数 引捕局部引用写穿() -> 整32 {
    变量 v = 10;
    整32& r = v;
    变量 f = [&]() -> 整32 { r = 30; 返回 r; };
    f();
    返回 v;                            // 30（别名写穿·非 10）
}
函数 显式捕引用形参(整32& r) -> 整32 {
    变量 f = [r]() -> 整32 { 返回 r + 1; };
    返回 f();                          // 12（显式捕获=值快照语义）
}
函数 引捕引用形参写穿(整32& r) -> 整32 {
    变量 f = [&]() -> 整32 { r = 77; 返回 r; };
    f();
    返回 r;                            // 77（引用捕获形参写穿）
}
函数 值捕结构体引用(点& p) -> 整32 {
    变量 f = [=]() -> 整32 { 返回 p.x + p.y; };
    返回 f();                          // 7（深拷快照从被引用对象基址）
}
函数 引捕结构体引用写穿() -> 整32 {
    变量 p = 点 { x = 3, y = 4 };
    点& r = p;
    变量 f = [&]() -> 整32 { r.x = 40; 返回 r.x; };
    f();
    返回 p.x;                          // 40（别名槽写穿对象字段）
}
函数 值捕类引用(计数器& c) -> 整32 {
    变量 f = [=]() -> 整32 { 返回 c.n; };
    返回 f();                          // 7（拷贝构造源=对象地址）
}
函数 引捕类引用写穿() -> 整32 {
    计数器 c;
    c.n = 7;
    计数器& r = c;
    变量 f = [&]() -> 整32 { r.n = 70; 返回 r.n; };
    f();
    返回 c.n;                          // 70（别名槽写穿对象字段）
}
函数 嵌套引捕局部引用() -> 整32 {
    变量 v = 10;
    整32& r = v;
    变量 外 = [&]() -> 整32 {
        变量 内 = [&]() -> 整32 { r = 50; 返回 r; };
        返回 内();
    };
    外();
    返回 v;                            // 50（嵌套别名写穿）
}
函数 值捕结构体引用逃逸(点& p) -> 整32(*)() {
    变量 f = [=]() -> 整32 { 返回 p.x * 10 + p.y; };
    返回 f;                            // 快照槽固化（蹦床径·值捕获无悬垂面）
}
函数 值捕类引用逃逸(计数器& c) -> 整32(*)() {
    变量 f = [=]() -> 整32 { 返回 c.n * 2; };
    返回 f;                            // 类引用蹦床径（拷贝构造源=对象地址）
}
函数 嵌套值捕引用形参(整32& r) -> 整32 {
    变量 外 = [=]() -> 整32 {
        变量 内 = [=]() -> 整32 { 返回 r + 1; };
        返回 内();
    };
    返回 外();                         // 12（嵌套快照链逐层读引用目标值）
}
函数 主() -> 整32 {
    变量 v = 10;
    如果 (值捕引用形参(v) != 11) { 返回 131; }
    如果 (引捕局部引用写穿() != 30) { 返回 132; }
    如果 (显式捕引用形参(v) != 11) { 返回 133; }
    如果 (引捕引用形参写穿(v) != 77) { 返回 134; }
    如果 (v != 77) { 返回 135; }       // 写穿对 v 可见（引用形参别名）
    v = 10;
    变量 p = 点 { x = 3, y = 4 };
    如果 (值捕结构体引用(p) != 7) { 返回 136; }
    如果 (引捕结构体引用写穿() != 40) { 返回 137; }
    计数器 c;
    c.n = 7;
    如果 (值捕类引用(c) != 7) { 返回 138; }
    如果 (引捕类引用写穿() != 70) { 返回 139; }
    如果 (嵌套引捕局部引用() != 50) { 返回 140; }
    变量 逃 = 值捕结构体引用逃逸(p);
    如果 (逃() != 34) { 返回 141; }    // 蹦床径：快照槽读被引用对象快照
    变量 逃类 = 值捕类引用逃逸(c);
    如果 (逃类() != 14) { 返回 142; }  // 类引用蹦床径（c.n=7 → 14）
    如果 (嵌套值捕引用形参(v) != 11) { 返回 143; }  // 嵌套值捕链（v=10）
    打印(值捕引用形参(v));
    打印(引捕局部引用写穿());
    打印(逃());
    返回 0;
}
