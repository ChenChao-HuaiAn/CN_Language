// E2E 868 接口方法 × 非128引用形参（568·双侧同案根治）
// 现象（552 轮呈报）：接口方法 × 非128引用形参（如 整64&）双侧 SIGSEGV——
//   宿主语义层 checkInterfaceMethodCall 缺 wrapRefArgs（实例/静态/构造三路径
//   均有·接口路径独缺）→ 引用实参按值直传、被调方按地址解引用崩（去虚拟化
//   直调与 B1 间接分派两路径同崩·探针 rc=139）；v2 接口实参表引用位未登记
//   （552 为守零分叉有意不加·同形崩）。
// 修复（判据单一归属）：宿主接口路径补 wrapRefArgs（左值判定+AddressOf
//   包装·与实例/静态/构造/普通函数四路径同构）；v2 收集接口方法实参表补
//   引用位登记（段名尾字节 '&' → 函数实参引用们·432-b 普通函数/容器路径
//   同判据）+ 552 既有接口回扫表驱动自动生效。
// 本用例（dual·两侧同源码编译运行·stdout 逐行比对）：
//   A. 对照面：实例方法直调/基类虚调用/普通函数（整64&·修复前即绿）；
//   B. 单实现（去虚拟化直调路径）× 整32&：读值 + 写穿；
//   C. 多实现（B1 间接分派路径）× 整64&：读值 + 写穿；
//   D. 双引用实参交换（实参序对位·甲值/乙值互写）；
//   E. 左值形态族：成员变量/引用别名/数组元素/静态变量 作引用实参；
//   F. 广义引用类型族：字符串&（读长度+写穿）/类&（对象成员写穿）/
//      结构体&（字段写穿）——宿主 wrapRefArgs 与 v2 引用位登记同覆盖面；
//   G. 交叉校验（写穿后读回·别名链写穿）。
结构体 点 {
    整64 x;
}

类 载 {
公开:
    整64 槽;
    函数 载() { 槽 = 0; }
}

接口 盒 {
    虚拟 函数 取整(整64& 值) -> 整64;
    虚拟 函数 置值(整64& 值) -> 空类型;
    虚拟 函数 交换(整64& 甲值, 整64& 乙值) -> 空类型;
}

接口 单盒 {
    虚拟 函数 取单(整32& 值) -> 整32;
    虚拟 函数 加单(整32& 值) -> 空类型;
}

接口 盒s {
    虚拟 函数 换串(字符串& 值) -> 空类型;
    虚拟 函数 读串(字符串& 值) -> 整64;
}

接口 盒c {
    虚拟 函数 置(载& 对象) -> 空类型;
}

接口 盒p {
    虚拟 函数 移(点& 处) -> 空类型;
}

类 基 {
公开:
    函数 基() {}
    虚拟 函数 取虚(整64& 值) -> 整64 { 返回 值; }
}

类 甲 : 基, 盒, 单盒 {
公开:
    函数 甲() {}
    重写 函数 取虚(整64& 值) -> 整64 { 返回 值 + 1; }
    重写 函数 取整(整64& 值) -> 整64 { 返回 值; }
    重写 函数 置值(整64& 值) -> 空类型 { 值 = 77; }
    重写 函数 交换(整64& 甲值, 整64& 乙值) -> 空类型 { 整64 t = 甲值; 甲值 = 乙值; 乙值 = t; }
    重写 函数 取单(整32& 值) -> 整32 { 返回 值 + 100; }
    重写 函数 加单(整32& 值) -> 空类型 { 值 = 值 + 1; }
}

类 乙 : 盒 {
公开:
    函数 乙() {}
    重写 函数 取整(整64& 值) -> 整64 { 返回 值 + 10; }
    重写 函数 置值(整64& 值) -> 空类型 { 值 = 88; }
    重写 函数 交换(整64& 甲值, 整64& 乙值) -> 空类型 { 整64 t = 甲值; 甲值 = 乙值 + 1; 乙值 = t + 1; }
}

类 甲s : 盒s {
公开:
    函数 甲s() {}
    重写 函数 换串(字符串& 值) -> 空类型 { 值 = "改过"; }
    重写 函数 读串(字符串& 值) -> 整64 { 返回 字符串长度(值); }
}

类 甲c : 盒c {
公开:
    函数 甲c() {}
    重写 函数 置(载& 对象) -> 空类型 { 对象.槽 = 42; }
}

类 甲p : 盒p {
公开:
    函数 甲p() {}
    重写 函数 移(点& 处) -> 空类型 { 处.x = 9; }
}

静态 整64 全局 = 5;

函数 直调取(整64& 值) -> 整64 { 返回 值; }

函数 主() -> 整32 {
    打印("===== 868 接口方法 × 非128引用形参 =====");
    整64 x = 42;
    // A. 对照面：实例方法直调 / 基类虚调用（修复前即绿）
    甲 对 = 甲();
    打印("A 实例直调: ");
    打印(对.取整(x));          // 42
    打印("B 虚调用: ");
    打印(对.取虚(x));          // 43
    // B. 接口单实现（去虚拟化直调路径）× 整32&：读 + 写穿
    单盒 单 = 甲();
    整32 s = 7;
    打印("C 单实现整32读: ");
    打印(单.取单(s));          // 107
    单.加单(s);
    打印("C 写穿后 s: ");
    打印(s);                   // 8
    // C. 接口多实现（B1 间接分派路径）× 整64&：读 + 写穿
    盒 多 = 乙();
    打印("E 多实现读: ");
    打印(多.取整(x));          // 52
    多.置值(x);
    打印("E 写穿后 x: ");
    打印(x);                   // 88
    // D. 双引用实参交换（实参序对位·乙实现：甲值=乙值+1 乙值=原甲值+1）
    x = 10;
    整64 y = 20;
    多.交换(x, y);
    打印("F 交换后 x y: ");
    打印(x);                   // 21
    打印(y);                   // 11
    // E. 左值形态族：成员变量 / 引用别名 / 数组元素 作引用实参
    载 c = 载();
    打印("G 成员实参: ");
    打印(多.取整(c.槽));       // 10
    整64 源 = 5;
    整64& 别名 = 源;
    打印("H 引用别名实参: ");
    打印(多.取整(别名));       // 15
    别名 = 30;
    打印("H 别名写穿: ");
    打印(源);                  // 30
    整64[2] 表;
    表[0] = 3;
    表[1] = 4;
    多.置值(表[1]);
    打印("I 数组元素写穿: ");
    打印(表[1]);               // 88
    // J. 字符串& 接口引用形参：读长度 + 写穿
    盒s 串盒 = 甲s();
    字符串 串 = "原始";
    打印("J 字符串读: ");
    打印(串盒.读串(串));       // 6
    串盒.换串(串);
    打印("J 字符串写穿: ");
    打印(串);                  // 改过
    // K. 类引用形参（对象句柄按引用传·成员写穿）
    盒c 类盒 = 甲c();
    载 物 = 载();
    类盒.置(物);
    打印("K 类引用写穿: ");
    打印(物.槽);               // 42
    // L. 结构体引用形参（字段写穿）
    盒p 体盒 = 甲p();
    点 位;
    位.x = 1;
    体盒.移(位);
    打印("L 结构体引用写穿: ");
    打印(位.x);                // 9
    // M. 静态变量作引用实参（读 + 写穿·静态槽地址形态）
    打印("M 静态读: ");
    打印(多.取整(全局));       // 15
    多.置值(全局);
    打印("M 静态写穿: ");
    打印(全局);                // 88
    // A. 对照面：普通函数引用形参
    打印("D 普通函数: ");
    打印(直调取(x));           // 21
    打印("===== 完成 =====");
    返回 0;
}
