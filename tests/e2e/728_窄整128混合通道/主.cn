// E2E 728（任务 077）：窄整×128 混合通道矩阵——窄整（整8/整16/整32·正8）与
//   整128/正128 的混合算术/复合赋值/比较/直接赋值/显式窄化/拼接。
//   背景（077 探针实测）：①宿主 316-a 窄→128 宽化分支对常量传播后的 8/16 位
//   窄常量源把立即数当内存地址发射（movsx eax, word ptr -300 → ml64 A2070
//   汇编失败）；②v2 同面通道缺口。双侧修复后转 dual 锁用例（ AGENTS §4）。
//   设计：乙/丙段=常量传播窄值面（原双侧红·本任务修复面）；甲/丁段=宿主既有
//   绿面回归锁定；窄值取自函数返回（运行期路径）作对照防折叠假绿。
函数 取16() -> 整16 { 返回 整16(0 - 300); }
函数 取8() -> 整8 { 返回 整8(0 - 3); }

函数 主() -> 整32
{
    // 甲：窄32 变量 × 128（宿主既有绿面）
    整32 小32 = 7;
    整128 宽 = 100;
    整128 和 = 宽 + 小32;
    打印行(和);
    整128 积 = 小32 * 宽;
    打印行(积);
    宽 += 小32;
    打印行(宽);
    如果 (宽 > 小32) { 打印行(1); }
    如果 (小32 < 宽) { 打印行(2); }
    // 乙：窄8/16 常量传播面（原双侧红·本任务修复面）
    整8 小8 = 整8(0 - 3);
    整128 负和 = 宽 + 小8;
    打印行(负和);
    整16 窄16 = 整16(0 - 300);
    整128 提 = 窄16;
    打印行(提);
    整128 差 = 窄16 - 宽;
    打印行(差);
    // 丙：正族 正128 × 正8 常量传播面（原双侧红·本任务修复面）
    正8 无8 = 250;
    正128 无宽 = 5;
    正128 积u = 无宽 * 无8;
    打印行(积u);
    // 丁：运行期窄值对照（非常量传播路径·防折叠假绿）
    整16 运窄 = 取16();
    整128 运提 = 运窄;
    打印行(运提);
    整8 运8 = 取8();
    整128 运和 = 宽 + 运8;
    打印行(运和);
    // 戊：128 → 窄 显式窄化（字面量算术防折叠）
    打印行(整16(0 - 宽));
    // 己：拼接面（窄整与 128 各一）
    打印行("拼" + 小8);
    打印行("拼" + 提);
    返回 0;
}
