// 1310（#1178 锁面·负例·001 §lambda 捕获条〔通告〕）：方法内 [] 空捕获读类
//   字段/调类方法=编译期拒——[] 是「不依赖外部环境」的显式承诺，读/写裸字段
//   名与经 自身 的成员访问（自身.字段/自身.方法()）=隐式 自身（this）依赖=违
//   约（闭包体是独立函数帧、无 自身 绑定=隐式依赖读垃圾值）。修复前宿主内部
//   错误/垃圾值终态、v2 快照源槽 miss 静默错值；修复后双侧编译期一致拒+指路
//   改写（[=]/[&]/显式列字段）。四拒形态：读裸字段/写裸字段/自身.字段/自身.方法。
类 袋 {
    整32 基 = 10;
    函数 内部值() -> 整32 { 返回 基 + 1; }
公开:
    函数 读字段拒() -> 整32 {
        变量 f = []() -> 整32 { 返回 基; };            // 预期失败：[] 读裸字段
        返回 f();
    }
    函数 写字段拒() -> 整32 {
        变量 g = []() -> 整32 { 基 = 5; 返回 0; };     // 预期失败：[] 写裸字段
        返回 g();
    }
    函数 自身字段拒() -> 整32 {
        变量 h = []() -> 整32 { 返回 自身.基; };       // 预期失败：[] 经 自身.字段
        返回 h();
    }
    函数 自身方法拒() -> 整32 {
        变量 k = []() -> 整32 { 返回 自身.内部值(); }; // 预期失败：[] 调 自身.方法
        返回 k();
    }
}
函数 主() -> 整32 {
    袋 b;
    打印行(b.读字段拒());
    打印行(b.写字段拒());
    打印行(b.自身字段拒());
    打印行(b.自身方法拒());
    返回 0;
}
