// 117_Feature2_向量删除中间位置move语义（2026-08-25）：根治移位槽泄漏。
//   问题：向量<T> 删除(位置) 移位 数据[移动]=数据[移动+1]（拷贝构造覆盖活对象 ->
//   旧资源泄漏），且末尾槽 数据[元素数量-1] 移出范围后从未析构。
//   643（630 呈报·C++ erase / Rust Vec::remove 恰一次语义修正）：
//     stdlib 向量 析构元素(索引)（编译器注入辅助：仅 T 为有析构类时展开为
//       删除对象(LoadPtr(数据+索引*步长))；无析构时 no-op）；
//     删除 在移位前对**被删位置**调用一次 自身.析构元素(位置)——其余元素纯
//       移位（移动元素 memcpy）。原「循环内逐轮析构目标槽 + 循环后析构末尾
//       移出槽」对 memcpy 浅移交的元素产生共享句柄二次析构（有资源类元素
//       =堆损坏 C0000374；无资源类=计数虚高）——恰一次修正后已废。
//   全局析构计数验证：每个元素恰好析构一次（无泄漏、无重复析构）——
//   [r1,r2,r3,r4] 连续删 1/1/0/清空：计数 1/2/3/4。

导入 容器::向量;

静态 整64 计数 = 0;

类 资源 {
公开:
    整64 编号;
    函数 资源(整64 v) { 编号 = v; }
    函数 资源(资源& 其他) { 编号 = 其他.编号; }
    不安全 函数 ~资源() { 计数 = 计数 + 1; }
}

函数 主() -> 整32 {
    向量<资源> 表;
    资源 r1 = 资源(1);
    资源 r2 = 资源(2);
    资源 r3 = 资源(3);
    资源 r4 = 资源(4);
    结果<空类型, 整32> a1 = 表.追加(r1);
    结果<空类型, 整32> a2 = 表.追加(r2);
    结果<空类型, 整32> a3 = 表.追加(r3);
    结果<空类型, 整32> a4 = 表.追加(r4);
    打印("追加4: ", 表.大小(), " 计数: ", 计数);   // 4, 0

    // 删除中间(1)：被删 r2 恰一次析构 = 计数 1（r3/r4 纯移位）
    结果<空类型, 整32> d1 = 表.删除(1);
    打印("删除(1)后: ", 表.大小(), " 计数: ", 计数);  // 3, 1

    // 再删除中间(1)：被删 r3 恰一次（总 2）
    结果<空类型, 整32> d2 = 表.删除(1);
    打印("再删除(1): ", 表.大小(), " 计数: ", 计数);  // 2, 2

    // 删除头部(0)：被删 r1 恰一次（总 3）
    结果<空类型, 整32> d3 = 表.删除(0);
    打印("删除(0)后: ", 表.大小(), " 计数: ", 计数);  // 1, 3

    // 清空：剩余 r4 恰一次（总 4）
    表.清空();
    打印("清空后: ", 表.大小(), " 计数: ", 计数);     // 0, 4
    返回 0;
}
