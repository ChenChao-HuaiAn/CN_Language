// 117_Feature2_向量删除中间位置move语义（2026-08-25）：根治移位槽泄漏。
//   问题：向量<T> 删除(位置) 移位 数据[移动]=数据[移动+1]（拷贝构造覆盖活对象 ->
//   旧资源泄漏），且末尾槽 数据[元素数量-1] 移出范围后从未析构。
//   方案（C++ erase 的 move 语义，用「析构-拷贝」模拟）：
//     stdlib 向量 新增 析构元素(索引)（编译器注入辅助：仅 T 为有析构类时展开为
//       Call T$析构 this=数据+索引*步长；无析构时 no-op）；
//     删除 移位循环前 自身.析构元素(移动)（释放目标槽旧资源）+ 循环后
//       自身.析构元素(元素数量-1)（析构末尾源对象）。
//   全局析构计数验证：每个被移除/移出元素恰好析构一次（无泄漏、无重复析构）。

导入 容器::向量;

静态 整64 计数 = 0;

类 资源 {
公开:
    整64 编号;
    函数 资源(整64 v) { 编号 = v; }
    函数 资源(资源& 其他) { 编号 = 其他.编号; }
    函数 ~资源() { 计数 = 计数 + 1; }
}

函数 主() -> 整32 {
    向量<资源> 表;
    资源 r1 = 资源(1);
    资源 r2 = 资源(2);
    资源 r3 = 资源(3);
    资源 r4 = 资源(4);
    结果<空类型, 整32> a1 = 表.追加(r1);
    结果<空类型, 整32> a2 = 表.追加(r2);
    结果<空类型, 整32> a3 = 表.追加(r3);
    结果<空类型, 整32> a4 = 表.追加(r4);
    打印("追加4: ", 表.大小(), " 计数: ", 计数);   // 4, 0

    // 删除中间(1)：析构 r2（被移除）+ r3（移位目标槽）+ r4（末尾源）= 3
    结果<空类型, 整32> d1 = 表.删除(1);
    打印("删除(1)后: ", 表.大小(), " 计数: ", 计数);  // 3, 3

    // 再删除中间(1)：析构 r3' + r4' = 2（总 5）
    结果<空类型, 整32> d2 = 表.删除(1);
    打印("再删除(1): ", 表.大小(), " 计数: ", 计数);  // 2, 5

    // 删除头部(0)：析构 r1 + r4'' = 2（总 7）
    结果<空类型, 整32> d3 = 表.删除(0);
    打印("删除(0)后: ", 表.大小(), " 计数: ", 计数);  // 1, 7

    // 清空：析构剩余 r4''' = 1（总 8）
    表.清空();
    打印("清空后: ", 表.大小(), " 计数: ", 计数);     // 0, 8
    返回 0;
}
