// 调试：确认崩溃发生在 IR生成 还是 代码生成 阶段
导入 容器::向量;
导入 CN语言编译器::IR生成;
导入 CN语言编译器::代码生成;

函数 主() -> 整32 {
    打印("阶段0: 开始");
    字符串 源码 = "函数 双倍(整64 值) -> 整64 {\n    返回 值 * 2;\n}\n函数 主() -> 整32 {\n    整64 数量 = 双倍(21);\n    打印(数量);\n    返回 0;\n}\n";
    打印("阶段1: IR生成前");
    向量<字符串> IR行 = IR生成(源码, "测试");
    打印("阶段2: IR生成后, 行数=", 整数转字符串(IR行.大小()));
    打印("阶段3: 代码生成前");
    向量<字符串> asm行 = 代码生成(IR行);
    打印("阶段4: 代码生成后, 行数=", 整数转字符串(asm行.大小()));
    返回 0;
}
