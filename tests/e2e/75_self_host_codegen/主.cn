// E2E 75_self_host_codegen：自举 Task 7.5 v2——CN 代码生成器（真实 x64 MASM 后端）
// 输入：IR 行（IR 生成器输出）；输出：真实 x64 MASM 文本行（ml64 可汇编）。
// 覆盖：函数头/参数/分配/常量/加载/运算/调用/返回 的 MASM 映射。
// 验证策略：打印 IR 行全文 + ASM 关键特征摘要（.data/.code/EXTERN/PROC/ENDP/END 计数
//   + 首尾行），确认输出为真实 MASM 结构而非伪汇编描述字符串。
导入 容器::向量
导入 CN语言编译器::IR生成
导入 CN语言编译器::代码生成

// 统计 行表 中包含 关键字 的行数
函数 统计包含(向量<字符串> 行表, 字符串 关键字) -> 整64 {
    整64 计数 = 0
    整64 i = 0
    当 (i < 行表.大小()) {
        如果 (字符串查找(行表.元素(i), 关键字) >= 0) {
            计数++
        }
        i++
    }
    返回 计数
}

函数 主() -> 整32 {
    字符串 源码 = "函数 双倍(整64 值) -> 整64 {\n    返回 值 * 2\n}\n函数 主() -> 整32 {\n    整64 数量 = 双倍(21)\n    打印(数量)\n    返回 0\n}\n"
    向量<字符串> IR行 = IR生成(源码, "测试")
    向量<字符串> asm行 = 代码生成(IR行)
    打印("== IR ==")
    整64 i = 0
    当 (i < IR行.大小()) {
        打印(IR行.元素(i))
        i++
    }
    打印("== ASM 摘要 ==")
    打印("总行数=" + 整数转字符串(asm行.大小()))
    打印(".data=" + 整数转字符串(统计包含(asm行, ".data")))
    打印(".code=" + 整数转字符串(统计包含(asm行, ".code")))
    打印("EXTERN=" + 整数转字符串(统计包含(asm行, "EXTERN")))
    打印("PROC=" + 整数转字符串(统计包含(asm行, "PROC")))
    打印("ENDP=" + 整数转字符串(统计包含(asm行, "ENDP")))
    打印("END=" + 整数转字符串(统计包含(asm行, "END")))
    打印("== ASM 首行 ==")
    打印(asm行.元素(0))
    打印("== ASM 末行 ==")
    打印(asm行.元素(asm行.大小() - 1))
    返回 0
}
