// 官网文档示例 · reference/functions.html · 声明（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
// 完整形态
函数 加(整32 a, 整32 b) -> 整32 {
    返回 a + b;
}

// 无返回值：-> 空类型（可省略标注）
函数 打印问候() {
    打印("你好");
}

// 前向声明（原型）：先声明后实现
函数 递归和(整32 n) -> 整32;

函数 主() -> 整32 {
    打印(加(1, 2), " ");
    打印问候();
    打印(递归和(4));
    返回 0;
}

函数 递归和(整32 n) -> 整32 {
    如果 n <= 0 { 返回 0; }
    返回 n + 递归和(n - 1);
}