// E2E 925（2026-10-14·任务 #584）：类静态字段运行期复合移位超宽（静态字段 <<= 变量k）→
//   错误码 8 确定性失败（001 §4.4 移位量超宽 #474 条文·§1.1a②）。
//   结构复核：类字段复合赋值两侧均展开「读旧值→移位→写回」，与变量面同移位
//   检查面（宿主 ir_oop_field.cpp:178 静态字段分支·298 实例分支同构）——
//   本用例把静态面从「结构巧合」升为「用例锁死」：
//   ①静态方法体内静态字段裸名 累计 <<= k5（ir_oop_field.cpp:178 分支）健康 → 32；
//   ②类名::静态字段 限定形态 计数器::累计 <<= k1 域内健康 → 64；
//   ③①同形超宽触发 k=40（≥ 整32 位宽 32）→ 运行时错误(错误码8) 终止 rc=1。
//   （实例字段分支面=姊妹用例 924 锁死。）
//   双编译对照：宿主与 v2 同源同测——输出逐行一致 + 退出码一致（1=溢出终止）。
类 计数器 {
公开:
    静态 整32 累计 = 1;
    函数 计数器() { }
    静态 函数 累计移(整32 k) -> 空类型 {
        累计 <<= k;            // 静态字段裸名复合移位（①③ 面）
    }
}
函数 主() -> 整32 {
    整32 k5 = 5;
    计数器::累计移(k5);
    打印(计数器::累计);            // 32 静态裸字段域内健康（健康对照）
    整32 k1 = 1;
    计数器::累计 <<= k1;
    打印(计数器::累计);            // 64 限定形态域内健康（健康对照）
    整32 大 = 40;
    计数器::累计移(大);            // 40 ≥ 32 运行期复合移位量超宽 → 错误码8 终止
    打印(计数器::累计);
    返回 0;
}
