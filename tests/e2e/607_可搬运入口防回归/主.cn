// 607（027 波2a·E2E 正例·可搬运检查器防回归·linux 云端真线程）：
//   新线程 入口三形态（函数名衰减/函数指针变量）在可搬运检查器下零误伤——
//   函数指针=代码指针恒可搬运（001 §5.8a·040 §5.8 来源封口合法来源），
//   第二实参=无（空类型* 顶层·内置豁免窗口 §5.8a sunset=218）。
//   检查器上线后本形态必须编译放行+计数正确（防误伤面）。
//   win=运行时桩（运行时错误9）——win 本地跳过（run_e2e 平台跳过 win-x64）。
导入 线程::新线程;
导入 线程::并入线程;

静态 整64 计数 = 0;

不安全 函数 累加甲(空类型* 未用) -> 整64 {
    循环(整64 i = 0; i < 5000; i++) {
        计数 = 计数 + 1;
    }
    返回 0;
}

不安全 函数 主() -> 整32 {
    // 形态①：函数名衰减作入口（§5.8 合法来源一）
    结果<空类型*, 整32> 建一 = 新线程(累加甲, 无);
    如果 (建一.正常) { 并入线程(建一.值); } 否则 { 返回 3; }
    // 形态②：同签名函数指针变量作入口（§5.8 合法来源二）
    整64(*入口)(空类型*) = 累加甲;
    结果<空类型*, 整32> 建二 = 新线程(入口, 无);
    如果 (建二.正常) { 并入线程(建二.值); } 否则 { 返回 3; }
    打印行(计数);
    返回 0;
}
