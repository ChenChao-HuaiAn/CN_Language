// Task 3.1 类与继承 E2E 测试
// 覆盖：类定义/实例化/字段访问/方法调用/单继承（成员继承、父类构造调用）/
//       构造析构生命周期/自身与父类关键字/类类型局部变量自动释放
// 语法依据（cn-language-spec 06）：类 名 [: 父类] { 公开:/保护:/私有: ... }；
//   构造 函数 类名(...)、析构 函数 ~类名()；自身 对应 this、父类 对应 父类:: 限定调用；
//   类对象为堆对象（NewObject），变量槽存对象指针
// 打印语义（用户裁决）：打印=println（自动换行）、打印行=print（不换行）
//   方案C（2026-08-14）✅ 已修复：遗留的 打印行整数/打印行浮点 已删除，
//   统一用 打印（变参）表达（打印(42) 输出 "42\n"，与旧 打印行整数(42) 完全等价）

类 动物 {
公开:
    字符串 名称
    整32 年龄

    函数 动物(字符串 名, 整32 岁) {
        名称 = 名
        年龄 = 岁
    }

    // 2026-08-25 方案A 拷贝构造（有析构类按值拷贝须有拷贝构造）：
    //   深拷贝 名称（字符串复制，避免共享），年龄 按值。
    //   副本 = 大象 的按值拷贝走本构造（H6 根治后可用）。
    函数 动物(动物& 其他) {
        名称 = 字符串复制(其他.名称)
        年龄 = 其他.年龄
    }

    函数 描述() -> 字符串 {
        返回 "动物[" + 名称 + ", " + 整数转字符串(年龄) + "岁]"
    }

    函数 ~动物() {
        // 析构函数：验证类类型局部变量自动释放路径（RAII）
        // 仅演示析构调用不崩溃（DeleteObject 经 __cn_object_delete 释放）
    }
}

// 单继承：狗 继承 动物（成员继承 + 父类构造调用）
类 狗 : 动物 {
公开:
    字符串 品种

    函数 狗(字符串 名, 整32 岁, 字符串 种) {
        // 父类构造调用：目前语法层未实现 函数 狗(...) : 动物(...) 初始化列表，
        //   在子类构造体内通过 父类.成员 直接赋值父类字段（冒烟程序同款方式）
        父类.名称 = 名
        父类.年龄 = 岁
        品种 = 种
    }

    函数 完整描述() -> 字符串 {
        返回 名称 + "（" + 品种 + "）" + 整数转字符串(年龄) + "岁"
    }

    函数 修改年龄(整32 新年龄) {
        年龄 = 新年龄          // 方法体内直接访问父类字段（继承并入）
    }
}

函数 主() -> 整32 {
    打印("===== 类与继承（Task 3.1）=====")

    // ---- 1. 类实例化 + 构造调用 ----
    动物 大象 = 动物("大象", 10)
    打印("构造后名称: ", 大象.名称)          // 大象
    打印("构造后年龄: ", 大象.年龄)          // 10

    // ---- 2. 字段写（对象.字段 = 值）----
    大象.年龄 = 12
    打印("改年龄后: ", 大象.年龄)            // 12

    // ---- 3. 方法调用 ----
    打印("方法调用: ", 大象.描述())          // 动物[大象, 12岁]

    // ---- 4. 单继承：子类实例化（父类构造体内赋值）----
    狗 小狗 = 狗("旺财", 3, "金毛")
    打印("子类名称: ", 小狗.名称)            // 旺财（继承父类字段）
    打印("子类品种: ", 小狗.品种)            // 金毛（自身字段）
    打印("子类完整描述: ", 小狗.完整描述())  // 旺财（金毛）3岁

    // ---- 5. 继承方法调用（子类调用父类方法）----
    打印("调用父类方法: ", 小狗.描述())      // 动物[旺财, 3岁]

    // ---- 6. 方法体内修改继承字段 ----
    小狗.修改年龄(4)
    打印("修改后年龄: ", 小狗.年龄)          // 4

    // ---- 7. 自身关键字（类方法体内自身.字段 访问）----
    //  完整描述 方法内使用 名称/品种/年龄 直接字段访问（等效自身.前缀）
    打印("自身字段验证: ", 小狗.完整描述())  // 旺财（金毛）4岁

    // ---- 8. 多实例独立（各对象独立堆分配）----
    狗 二狗 = 狗("小黑", 2, "土狗")
    打印("两实例独立: ", 二狗.名称, " vs ", 小狗.名称)  // 小黑 vs 旺财

    // ---- 9. 类对象赋值深拷贝（缺陷1 修复验证）：独立堆对象，RAII 不重复释放 ----
    动物 副本 = 大象
    打印("副本名称: ", 副本.名称)           // 大象（深拷贝独立对象）
    副本.年龄 = 99
    打印("副本改年龄后: ", 副本.年龄)        // 99
    打印("原象年龄不变: ", 大象.年龄)        // 12（独立对象互不影响）

    打印("===== 类与继承测试完成 =====")
    返回 0
}
