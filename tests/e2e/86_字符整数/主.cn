// E2E 86_字符整数（正面倒）：类型系统 字符.整数 双向隐式/显式转换
// 语法依据：.Agents/skills/cn-language-spec/specs/02-类型系统.md 七、隐式类型转换——
//   表格「字符 | 整数 | 双向 | 字符.整数」；打印（变参）对整型统一 Cast 整64 后打印，
//   故 打印(字符) 输出其数值（Unicode标量），而非字形；字形由 字符转字符串 提供。
// 参考：tests/e2e/04_types/类型.cn 的类型声明写法。
// 覆盖：字符=整数字面量、整数=字符变量、字符与整数算术混合、字符比较、
//       字符转字符串（字形），打印 字符值/数字值 验证转换结果。
函数 主() -> 整32 {
    打印("===== 字符·整数 类型转换 =====");

    // 1. 字符 -> 整数：隐式转换（取 Unicode 标量值）
    字符 c = 'A';
    整32 i = c;
    打印("字符A 的整32值: ");
    打印(i);
    整64 li = c;
    打印("字符A 的整64值: ");
    打印(li);

    // 2. 整数 -> 字符：赋值（整数字面量 66 为 'B'）
    字符 c2 = 66;
    打印("整数66 作为字符的数值: ");
    打印(c2);

    // 3. 字符 与 整数 算术混合（字符提升为整数参与运算）
    打印("字符A + 1: ");
    打印(c + 1);

    // 4. 数字字符与数字对照
    字符 digit = '0';
    打印("字符0 的整32值: ");
    打印(digit);

    // 5. 字符 与 整数 比较
    如果 (i == 65) { 打印("比较: 字符A == 65 成立"); } 否则 { 打印("比较: 不成立"); }
    如果 (c2 == 'B') { 打印("比较: 66 == 字符B 成立"); } 否则 { 打印("比较: 不成立"); }

    // 6. 字符转字符串：字形输出（字符.字符串 单向转换函数族）
    字符串 glyph = 字符转字符串('A');
    打印("字符A 的字形: ");
    打印(glyph);

    打印("===== 字符·整数 转换完成 =====");
    返回 0;
}
