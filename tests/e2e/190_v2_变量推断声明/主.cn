// 190_v2：类型推断声明 v2 闭环（46-c 观察项根治，2026-09-10 第四十九轮；
//   宿主侧同源用例=190）——v2p 编译本源码 rc=255=八形态校验和全过：
//   A 整数字面量→整32（+1；修复前「语句缺少分号」可见失败=46-c 立案形态）/
//   B 字符串字面量→字符串（+2）/ C 标识符拷贝（+4）/ D L 后缀→整64（+8）/
//   E 调用返回→整64（+16）/ F 成员读→结构体（+32，推导成员类型ID+查表
//   回填走生成结构体局部多槽布局）/ G 嵌套成员读→整32（+64）/ H 二元→整32
//   （+128）。
//   实现：解析层「变量」分支（类型节点文本=空串哨兵）+语义层 表达式类型ID
//   推导（字面量/标识符/调用/下标/三元经 检查表达式；成员/二元新推导函数，
//   同构 IR 解析成员链结构体ID 范本）+推断声明类型表（跨层，语义登记 IR 回
//   填）+IR 层查表回填布局分派。
函数 取值() -> 整64 {
    返回 77;
}

结构体 点 {
    整32 x
    整32 y
}

结构体 矩形 {
    点 左上
    点 右下
}

函数 主() -> 整32 {
    变量 a = 41;
    变量 s = "好";
    变量 b = a;
    变量 长 = 42L;
    变量 调 = 取值();
    矩形 r = 矩形{ 左上 = 点{ x = 5, y = 6 }, 右下 = 点{ x = 0, y = 0 } };
    变量 t = r.左上;
    变量 x值 = r.左上.x;
    变量 和 = a + 7;
    整32 c = 0;
    如果 (a == 41) { c = c + 1; }
    如果 (字符串比较(s, "好")) { c = c + 2; }
    如果 (b == 41) { c = c + 4; }
    如果 (长 == 42) { c = c + 8; }
    如果 (调 == 77) { c = c + 16; }
    如果 (t.x == 5 && t.y == 6) { c = c + 32; }
    如果 (x值 == 5) { c = c + 64; }
    如果 (和 == 48) { c = c + 128; }
    返回 c;
}
