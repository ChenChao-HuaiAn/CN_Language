// 1716（#1974·001 §6 继承/虚函数/接口×泛型）：泛型类继承非泛型基类+重写虚分派
//   与泛型类实现双接口，两形态一段锁死。修前分叉实录（2026-11-02 探针 pD2/pD6）：
//   v2 对合法程序产出 ml64 无法汇编的 asm（汇编退出码 1）——泛型实例单态化
//   （实例化注册）不登记实例虚槽/接口实现关系/布局头，模板类虚表漏抑制发射：
//   虚表槽符号=模板裸名方法（容器$名字）无对应 PROC（实例方法符号带实参段
//   容器$整32$名字）→ ml64 A2006 undefined symbol；实例对象 vptr/接口区不装
//   →即使汇编过运行期虚分派也崩。宿主同源程序编译运行全绿（泛型实例=独立
//   ClassInfo·虚表按实例发射·槽符号=实例合成名方法）。本例锁死：①基指针
//   b.名字() 虚分派到实例重写 ②c.名字() 同结果 ③双接口直接成员调用全通。
接口 可取值 {
    虚拟 函数 取值() -> 整32;
}
接口 可显示 {
    虚拟 函数 显示() -> 字符串;
}
类 基 {
公开:
    虚拟 函数 名字() -> 字符串 { 返回 "基"; }
}
泛型 <类型 T>
类 容器 : 基 {
公开:
    T 载;
    函数 容器(T 初) { 载 = 初; }
    重写 函数 名字() -> 字符串 { 返回 "容器"; }
}
泛型 <类型 T>
类 盒子 : 可取值, 可显示 {
公开:
    T 值;
    函数 盒子(T 初) { 值 = 初; }
    重写 函数 取值() -> 整32 { 返回 1; }
    重写 函数 显示() -> 字符串 { 返回 "盒"; }
}
函数 主() -> 整32 {
    // 形态一：泛型类继承非泛型基类+重写+基指针虚分派
    容器<整32> c = 容器<整32>(3);
    基* b = c;
    打印(b.名字());
    打印(c.名字());
    // 形态二：泛型类实现两接口+直接成员调用
    盒子<整32> a = 盒子<整32>(7);
    打印(a.取值());
    打印(a.显示());
    返回 0;
}
