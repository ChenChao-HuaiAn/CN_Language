// E2E 1406（1160）：情况标签归一十进制文本通道——条件类型域内命中回归（双侧）。
//   覆盖宿主旧实现已支持的 i64 域内形态（1140 修复前的 v2 侧分叉面在姊妹用例
//   1406_v2_情况标签条件域命中 锁定）：整64 大值 / 整32 负值 / 括号折叠相消 /
//   多值分组。宿主 1137 语义=条件类型域判承载（本用例全部域内放行·行为不变）。
//   订正历史：1160 分支基于 develop（未含 1137）；128/正64 超 i64 命中形态
//   归 1406_v2（宿主侧 1137 集成后由编排者扩面转 dual）。
函数 主() -> 整32 {
    整64 甲 = 9223372036854775807;
    选择(甲) {
        情况 9223372036854775807: 打印("A1=命中"); 中断;
        默认: 打印("A1=缺省");
    }
    整32 乙 = -5;
    选择(乙) {
        情况 -5: 打印("A2=命中"); 中断;
        默认: 打印("A2=缺省");
    }
    整64 丙 = 0;
    选择(丙) {
        情况 (18446744073709551615-18446744073709551615): 打印("A3=命中"); 中断;
        默认: 打印("A3=缺省");
    }
    整32 丁 = 2;
    选择(丁) {
        情况 1, 2: 打印("A4=命中"); 中断;
        默认: 打印("A4=缺省");
    }
    返回 0;
}
