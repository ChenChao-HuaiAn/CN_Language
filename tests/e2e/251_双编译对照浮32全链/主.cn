// E2E 251：浮32（单精度）语义面全链双编译对照（plans/020 移植纪律 9 第二十个对照用例）
//   92-a（2026-09-13 第九十二轮）：宿主浮32 面缺陷族根治（H2 销项）的门禁件。
//   八形态（两侧共有语义面；浮32 字面量经 浮32(x) 构造——v2 无 1.5f 后缀语法面）。
//   **操作数一律经 折半(浮32(x)) 取运行时值**——O2 常量折叠会把纯字面量算术在编译期
//   折叠成正确值，掩盖 codegen 类型缺陷（92-a 反证 A 首跑实证：形一被折叠未捕获）；
//   经函数调用返回打破折叠传播，形态①~⑧全部落运行时路径：
//     ① 算术四则 + 复合赋值（f32 op f32 单精度运算——原宿主结果类型恒 f64，
//        movss 装载 + addsd 运算把 f32 位模式当 f64 读，值域退化 ~1e-315）
//     ② 混合宽化（f32+整 / f32+f64 → f64：禁止隐式窄化，规范「无损或宽化」；
//        原 v2 单侧浮点取该侧把整型窄化到 f32=有损）
//     ③ 比较六运算 + 一元负号（ucomiss/fcmp 单精度分派）
//     ④ 转换四向（浮32<->浮64 / 整->浮32 / 浮32->整向零截断）
//     ⑤ 参数/返回 ABI（浮32 形参/返回走 xmm 低 32 位——原宿主无条件提升 f64，
//        被调方按 f32 读 double 位模式低 32 位 = 参数恒 0）
//     ⑥ 结构体浮32 字段读改（LoadPtr/StorePtr 宽度分派——原 linux_x64 后端
//        宽度前缀写死 qword 致 movss 非法汇编编译失败）
//     ⑦ 自增/自减（原宿主结果类型硬编码 ptr、v2 恒 T_整64：整数位模式加 1
//        只改 IEEE754 尾数最低位，浮点 ++ 静默失效）
//     ⑧ 大整数混合精度（16777217 形态：窄化/宽化的判别式——窄化侧得 …218.0、
//        宽化侧得 …218.5）
//   退出码 = 八形态折校验和 255（①1+②2+③4+④8+⑤16+⑥32+⑦64+⑧128 全对）。
//   宿主侧 == 用例期望值；v2 侧 == 宿主侧实测值（等价性判据）。
结构体 精度点 { 浮32 x; 浮32 偏; }

函数 折半(浮32 v) -> 浮32 {
    返回 v / 浮32(2.0);
}

函数 混排(浮32 a, 整32 b, 浮64 c) -> 浮64 {
    返回 浮64(a) + 浮64(b) + c;
}

// ① 算术四则 + 复合赋值（f32 op f32 单精度语义）
函数 形一() -> 整64 {
    浮32 甲 = 折半(浮32(3.0));
    浮32 乙 = 折半(浮32(5.0));
    浮32 和 = 甲 + 乙;
    浮32 差 = 乙 - 甲;
    浮32 积 = 甲 * 乙;
    浮32 商 = 乙 / 甲;
    甲 += 乙;
    整64 位 = 0;
    如果 (和 == 浮32(4.0)) { 位 = 位 + 1; }
    如果 (差 == 浮32(1.0)) { 位 = 位 + 1; }
    如果 (积 == 浮32(3.75)) { 位 = 位 + 1; }
    如果 (商 > 浮32(1.666) && 商 < 浮32(1.667)) { 位 = 位 + 1; }
    如果 (甲 == 浮32(4.0)) { 位 = 位 + 1; }
    如果 (位 == 5) { 返回 1; }
    返回 0;
}

// ② 混合运算宽化（整侧升 f64——禁止隐式窄化到 f32）
函数 形二() -> 整64 {
    浮32 甲 = 折半(浮32(3.0));
    整32 整 = 2;
    浮64 丙 = 甲 + 整;
    浮64 丁 = 甲 + 2;
    浮64 戊 = 甲 + 2.0;
    浮64 己 = 2.0 + 甲;
    整64 位 = 0;
    如果 (丙 == 3.5) { 位 = 位 + 1; }
    如果 (丁 == 3.5) { 位 = 位 + 1; }
    如果 (戊 == 3.5) { 位 = 位 + 1; }
    如果 (己 == 3.5) { 位 = 位 + 1; }
    如果 (位 == 4) { 返回 2; }
    返回 0;
}

// ③ 比较六运算 + 一元负号
函数 形三() -> 整64 {
    浮32 甲 = 折半(浮32(7.0));
    浮32 乙 = 折半(浮32(5.0));
    浮32 负 = -甲;
    整64 位 = 0;
    如果 (甲 > 乙) { 位 = 位 + 1; }
    如果 (乙 < 甲) { 位 = 位 + 1; }
    如果 (甲 >= 浮32(3.5)) { 位 = 位 + 1; }
    如果 (甲 <= 浮32(3.5)) { 位 = 位 + 1; }
    如果 (甲 != 乙) { 位 = 位 + 1; }
    如果 (甲 == 浮32(3.5)) { 位 = 位 + 1; }
    如果 (负 == 浮32(-3.5)) { 位 = 位 + 1; }
    如果 (位 == 7) { 返回 4; }
    返回 0;
}

// ④ 转换四向（浮32<->浮64 / 整->浮32 / 浮32->整向零截断）
函数 形四() -> 整64 {
    浮64 双 = 3.5;
    浮32 窄 = 浮32(双);
    浮64 宽 = 浮32(1.5);
    浮32 自整 = 浮32(3);
    整32 截 = 整32(浮32(3.99));
    整32 截负 = 整32(浮32(-3.99));
    整64 位 = 0;
    如果 (窄 == 浮32(3.5)) { 位 = 位 + 1; }
    如果 (宽 == 1.5) { 位 = 位 + 1; }
    如果 (自整 == 浮32(3.0)) { 位 = 位 + 1; }
    如果 (截 == 3) { 位 = 位 + 1; }
    如果 (截负 == -3) { 位 = 位 + 1; }
    如果 (位 == 5) { 返回 8; }
    返回 0;
}

// ⑤ 参数/返回 ABI（浮32 形参/返回经 xmm 低 32 位单精度传递）
函数 形五() -> 整64 {
    浮32 甲 = 浮32(1.5);
    浮32 半 = 折半(甲);
    浮64 混 = 混排(浮32(2.5), 3, 1.25);
    整64 位 = 0;
    如果 (半 == 浮32(0.75)) { 位 = 位 + 1; }
    如果 (混 == 6.75) { 位 = 位 + 1; }
    如果 (位 == 2) { 返回 16; }
    返回 0;
}

// ⑥ 结构体浮32 字段读改（访存宽度分派）
函数 形六() -> 整64 {
    精度点 点;
    点.x = 折半(浮32(7.0));
    点.偏 = 折半(浮32(2.5));
    浮32 合 = 点.x + 点.偏;
    点.x = 点.x + 浮32(0.5);
    整64 位 = 0;
    如果 (合 == 浮32(4.75)) { 位 = 位 + 1; }
    如果 (点.x == 浮32(4.0)) { 位 = 位 + 1; }
    如果 (位 == 2) { 返回 32; }
    返回 0;
}

// ⑦ 自增/自减（浮点目标须走浮点常量 + 浮点运算）
函数 形七() -> 整64 {
    浮32 甲 = 折半(浮32(3.0));
    甲++;
    甲++;
    甲--;
    浮64 乙 = 1.25;
    乙++;
    整64 位 = 0;
    如果 (甲 == 浮32(2.5)) { 位 = 位 + 1; }
    如果 (乙 == 2.25) { 位 = 位 + 1; }
    如果 (位 == 2) { 返回 64; }
    返回 0;
}

// ⑧ 大整数混合精度（16777217 = 2^24+1：f32 尾数位不足以表示——判别式）
函数 形八() -> 整64 {
    浮32 甲 = 折半(浮32(3.0));
    浮64 宽 = 甲 + 16777217;
    整64 位 = 0;
    如果 (宽 == 16777218.5) { 位 = 位 + 1; }
    如果 (宽 > 16777218.0) { 位 = 位 + 1; }
    如果 (位 == 2) { 返回 128; }
    返回 0;
}

函数 主() -> 整32 {
    整64 和 = 0;
    和 = 和 + 形一();
    和 = 和 + 形二();
    和 = 和 + 形三();
    和 = 和 + 形四();
    和 = 和 + 形五();
    和 = 和 + 形六();
    和 = 和 + 形七();
    和 = 和 + 形八();
    打印("校验和(期望255)=" + 和);
    返回 整32(和 % 256);
}
