// 115_Feature2_向量元素自动析构（2026-08-25）：编译器级向量<T> 元素自动析构
//   ——Feature 2 完整版。向量 持有内联类元素（T* 数据），当 T 为有析构类时：
//     删除(位置) 自动析构被移除元素；清空()/~向量() 自动逐元素析构。
//   注入点：emitClassMethod 生成 向量$T 方法体前（injectVectorElemDestroy）——
//     全量循环（idx 槽 0..元素数量，Call T$析构 this=数据+idx*步长）；
//     单元素（守卫 位置<元素数量，析构 数据+位置*步长）。
//   效果：作用域栈 弹出 无需显式 释放内部数组()（113 已验证）；本用例直接验证
//     删除/清空 的析构计数（全局静态计数器 +1/次析构）。

导入 容器::向量;

静态 整64 全局析构计数 = 0;

// 带析构计数器的类：构造不计数，析构 +1
类 资源 {
公开:
    整64 编号;

    函数 资源(整64 编号值) {
        编号 = 编号值;
    }

    函数 资源(资源& 其他) {
        编号 = 其他.编号;
    }

    函数 ~资源() {
        全局析构计数 = 全局析构计数 + 1;
    }
}

函数 主() -> 整32 {
    {
        向量<资源> 资源表 = 向量<资源>();
        资源 r1 = 资源(1);
        资源 r2 = 资源(2);
        资源 r3 = 资源(3);
        结果<空类型, 整32> 加1 = 资源表.追加(r1);
        结果<空类型, 整32> 加2 = 资源表.追加(r2);
        结果<空类型, 整32> 加3 = 资源表.追加(r3);
        打印("追加3 后: ", 资源表.大小());
        打印("析构计数: ", 全局析构计数);

        // 删除(末尾)：自动析构被移除元素（计数 +1）
        结果<空类型, 整32> 删 = 资源表.删除(2);
        打印("删除后大小: ", 资源表.大小());
        打印("删除后析构: ", 全局析构计数);

        // 清空：自动逐元素析构剩余 2 个（计数 +2）
        资源表.清空();
        打印("清空后大小: ", 资源表.大小());
    }
    // 块结束：局部 r1/r2/r3 析构（RAII，不影响 向量 元素计数断言前的值）
    打印("总析构: ", 全局析构计数);
    返回 0;
}
