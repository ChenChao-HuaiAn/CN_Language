// E2E 1424（2026-10-20·任务 #1194）：负号+无符号后缀零值（-0U/-0x0U/
//   -0x0ULL）与有符号负字面量（-5/-5LL）双侧放行正测——宿主负号折叠文本
//   归一值 0/有符号域内=放行（v2 判据 负无符号非零1016 只在「非零」拒）；
//   类实例字段 -5ULL 宿主放行现状保持（双侧值 -5·v2 表达式分析点不遍历
//   类实例字段初值）；类静态字段负号+U 非零拒绝已由 1016 五轮审查立法
//   （1415 dual 负测），本用例类静态取 -0U 零值放行锚（零分叉）。
//   双编译对照（断言输出=是）：同源码双侧编译运行，输出逐行全等。
类 盒 {
公开:
    整64 甲 = -5ULL;
    静态 整64 乙 = -0U;
    函数 取甲() -> 整64 { 返回 甲; }
}
函数 主() -> 整32 {
    整64 零1 = -0U;
    整64 零2 = -0x0U;
    整64 零3 = -0x0ULL;
    整64 负1 = -5LL;
    整64 负2 = -5;
    盒 b;
    打印("零1=", 零1);
    打印("零2=", 零2);
    打印("零3=", 零3);
    打印("负1=", 负1);
    打印("负2=", 负2);
    打印("实例=", b.取甲());
    打印("类静=", 盒.乙);
    如果 (-0U < 1) { 打印("条件=真"); }
    返回 0;
}
