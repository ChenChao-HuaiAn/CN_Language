// E2E 1345_lambda值捕获结构体元素数组深拷独立副本（#1880·dual 双编译对照锁用例）：
//   lambda 值捕获**结构体元素数组**（元素含字符串资源字段）=定义处元素级深拷
//   （结构体元素=位拷+逐元素字段级深拷·与 #940 结构体字段深拷同构的数组版）
//   ——1408 整组位拷=元素内联体复制（标量字段独立·字符串字段句柄共享浅面）。
//   修复后字符串字段=逐元素 __cn_str_copy 独立副本；标量字段=位拷本就独立。
// 期望手算（逐行）：
//   ① 快照读=甲甲甲甲 1 乙乙乙乙（字段级副本·源重赋值后快照读旧值）；
//   ② 读源=丙丙丙丙 99（源独立改写）。
结构体 人 {
    整32 龄;
    字符串 名;
}

函数 主() -> 整32 {
    人[2] 组;
    组[0].龄 = 1;
    组[0].名 = 字符串复制("甲甲甲甲");
    组[1].龄 = 2;
    组[1].名 = 字符串复制("乙乙乙乙");
    变量 读 = [组]() -> 整32 {
        打印(组[0].名);
        打印(组[0].龄);
        打印(组[1].名);
        返回 0;
    };
    组[0].名 = 字符串复制("丙丙丙丙");
    组[0].龄 = 99;
    读();                    // 甲甲甲甲 / 1 / 乙乙乙乙（快照独立）
    打印(组[0].名);          // 丙丙丙丙（源独立）
    打印(组[0].龄);          // 99
    返回 0;
}
