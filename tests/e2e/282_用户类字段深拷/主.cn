// E2E 279（2026-09-15 第一百八十三轮 183-a 探针转正·内存安全回归）：
//   波 3「用户类字段泛化」收官锚定——结构体含**用户自定义类**（有析构∧有拷贝
//   构造）字段的聚合全链：收集面泛化（去四族 head 白名单）+ 类字段位深拷通道
//   （NewObject+拷贝构造〔源槽地址〕+StorePtr，180-a 甲通道同款）+ 聚合自赋值
//   运行时守卫（dst≡src → 拷贝段 no-op，Rust 同 place 赋值同型）。
//   修复前基线实测（180-a 版宿主）：形一/形二/形四残留各 2（浅拷泄漏）、
//   形四单独复跑 0xC0000374（泛化后浅拷共享双释放）、成员位自赋值清空数据。
//   断言口径：每形态调用前后 内存::活动分配数() 差值（残留）恒为 0（213 同款
//   「门禁替你记得」）+ 深拷独立性数据断言（拷贝后修改副本不影响源）。
导入 容器::向量;
导入 IO::打印;

类 盒子 {
公开:
    向量<字符串> 表;
    函数 盒子() { 表 = 向量<字符串>(); }
    函数 ~盒子() { }
    不安全 函数 盒子(盒子& 其他) { 表 = 其他.表; }
}

结构体 壳 { 盒子 内; 整32 号; }

函数 主() -> 整32 {
    // ① 形一：用户类字段赋值＋块出口（泛化出口释放面）
    整64 残留一 = 0;
    {
        整64 b = 内存::活动分配数();
        {
            壳 a;
            a.内 = 盒子();
            结果<空类型, 整32> c = a.内.表.追加(字符串复制("甲一"));
            打印("① 追加后大小: ", a.内.表.大小());
        }
        残留一 = 内存::活动分配数() - b;
    }
    打印("① 块出口残留: ", 残留一);

    // ② 形二：整体拷贝（uD——拷贝构造级联深拷，零共享）
    整64 残留二 = 0;
    {
        整64 b = 内存::活动分配数();
        {
            壳 a;
            a.内 = 盒子();
            结果<空类型, 整32> c = a.内.表.追加(字符串复制("甲二"));
            壳 d = a;
            打印("② 拷贝后大小: ", d.内.表.大小());
            // 深拷独立性：修改副本不影响源
            结果<空类型, 整32> e = d.内.表.追加(字符串复制("乙二"));
            打印("② 源大小: ", a.内.表.大小(), " 副本大小: ", d.内.表.大小());
        }
        残留二 = 内存::活动分配数() - b;
    }
    打印("② 整体拷贝残留: ", 残留二);

    // ③ 形四：字段位赋值（uE——类字段位深拷通道；修复前 0xC0000374）
    整64 残留三 = 0;
    {
        整64 b = 内存::活动分配数();
        {
            壳 a;
            a.内 = 盒子();
            结果<空类型, 整32> c = a.内.表.追加(字符串复制("甲三"));
            壳 d;
            d.内 = a.内;
            结果<空类型, 整32> e = d.内.表.追加(字符串复制("乙三"));
            打印("③ 源大小: ", a.内.表.大小(), " 目标大小: ", d.内.表.大小());
        }
        残留三 = 内存::活动分配数() - b;
    }
    打印("③ 字段位赋值残留: ", 残留三);

    // ④ 成员位自赋值（运行时守卫——修复前清空数据，含串结构体同面 UAF）
    整64 残留四 = 0;
    {
        整64 b = 内存::活动分配数();
        {
            壳 a;
            a.内 = 盒子();
            结果<空类型, 整32> c = a.内.表.追加(字符串复制("甲四"));
            a.内 = a.内;
            打印("④ 自赋值后大小: ", a.内.表.大小());
        }
        残留四 = 内存::活动分配数() - b;
    }
    打印("④ 自赋值残留: ", 残留四);
    返回 0;
}
