// E2E 137（v2 三元条件运算符 `? :`——规范 01b 5.8，优先级 1.5 右结合 惰性求值，
// 2026-09-03 ③ 第六波）：
//   ① 基本真/假分支与语句位置（返回/初始化/赋值右值/如果条件/调用实参）；
//   ② 右结合嵌套 a?b:c?d:e = a?b:(c?d:e)（三形态锚定：真短路/假侧真/假侧假）；
//   ③ 优先级：逻辑或(层1)整段作条件（0||5 真）；三元结果参与二元（汇合后算术）；
//   ④ 惰性求值（短路本质）：仅选中分支求值——副作用计数器双向锚定
//     （真选中假计数不动 / 假选中真计数不动）；除零保护（条件假时 10/除数
//     不得求值——急切求值直接崩溃）；
//   ⑤ 类型类：整数族宽化（整32 字面量 vs 整64 函数返回）；字符串分支（指针槽）；
//     ⑥ 负测拒绝由 v2p 组件侧 主.cn 自检行固化（两分支类型不一致须被语义拒绝）。
// 断言失败提前返回 201~220；全部通过 返回 0。

函数 取较大(整64 a, 整64 b) -> 整64 {
    返回 a > b ? a : b;
}

// 惰性求值副作用计数（静态：顶层变量 CN 不支持，静态槽跨函数可写）
静态 整64 真侧计数 = 0;
静态 整64 假侧计数 = 0;

函数 真侧() -> 整64 {
    真侧计数++;
    返回 11;
}

函数 假侧() -> 整64 {
    假侧计数++;
    返回 22;
}

函数 主() -> 整32 {
    // —— ① 基本形态（返回语句位 / 比较条件 / 初始化位）——
    整64 a = 10;
    整64 b = 3;
    如果 (取较大(a, b) != 10) { 返回 201; }
    如果 (取较大(b, a) != 10) { 返回 202; }
    整64 选中 = a > b ? 100 : 200;
    如果 (选中 != 100) { 返回 203; }
    整64 未选中 = a < b ? 100 : 200;
    如果 (未选中 != 200) { 返回 204; }
    // 赋值右值位
    整64 赋值目标 = 0;
    赋值目标 = a == 10 ? 7 : 8;
    如果 (赋值目标 != 7) { 返回 205; }
    // 调用实参位（三元作 取较大 实参）
    如果 (取较大(a > b ? 5 : 6, 2) != 5) { 返回 206; }
    // —— ② 右结合嵌套：a?b:(c?d:e) ——
    整64 嵌套1 = a > 0 ? 1 : b > 0 ? 5 : 6;      // 真短路：假侧嵌套不求值
    如果 (嵌套1 != 1) { 返回 207; }
    整64 嵌套2 = a < 0 ? 1 : b > 0 ? 5 : 6;      // a 假 -> 假侧 (b>0 真 -> 5)
    如果 (嵌套2 != 5) { 返回 208; }
    整64 嵌套3 = a < 0 ? 1 : b < 0 ? 5 : 6;      // a 假 -> 假侧 (b 假 -> 6)
    如果 (嵌套3 != 6) { 返回 209; }
    // —— ③ 优先级 ——
    // 逻辑或(层1)绑定紧于三元：假||真 整段作条件（真）——若误把 真 当真值则得 1
    整64 优先1 = 假 || 真 ? 7 : 8;
    如果 (优先1 != 7) { 返回 210; }
    // 三元结果参与二元（汇合值再做算术）
    整64 优先2 = (a > b ? 30 : 40) + 2;
    如果 (优先2 != 32) { 返回 211; }
    // —— ④ 惰性求值（副作用双向锚定）——
    整64 惰性1 = 真 ? 真侧() : 假侧();
    如果 (惰性1 != 11) { 返回 212; }
    如果 (真侧计数 != 1) { 返回 213; }
    如果 (假侧计数 != 0) { 返回 214; }          // 假分支不得求值
    整64 惰性2 = 假 ? 真侧() : 假侧();
    如果 (惰性2 != 22) { 返回 215; }
    如果 (真侧计数 != 1) { 返回 216; }          // 真分支不得求值
    如果 (假侧计数 != 1) { 返回 217; }
    // 除零保护：条件假时 10/除数 不求值
    整64 除数 = 0;
    整64 商 = 除数 != 0 ? 10 / 除数 : 0 - 1;
    如果 (商 != 0 - 1) { 返回 218; }
    // —— ⑤ 类型类 ——
    // 整数族宽化：整32 字面量分支 vs 整64 函数返回分支（语义层须放行）
    整64 宽化 = b > 0 ? 3 : 取较大(a, b);
    如果 (宽化 != 3) { 返回 219; }
    // 字符串分支（指针槽汇合；字符串比较 返回布尔直接作条件）
    字符串 词 = b > 0 ? "甲" : "乙";
    如果 (字符串比较(词, "甲")) { } 否则 { 返回 220; }
    // —— ⑥（负测在 v2p 组件侧自检；此处程序级断言全绿）——
    返回 0;
}
