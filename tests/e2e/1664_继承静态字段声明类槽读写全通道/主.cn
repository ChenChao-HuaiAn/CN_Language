// E2E 1664 正测（#1445）：继承静态字段**声明类槽读写全通道**——
//   类内裸名读/写/自增减 + 限定名读/写（基::/子::）+ 类名.字段 读/写全通道
//   落声明类唯一槽（?static_声明类$字段·C++ 静态成员一份存储）。宿主+v2 双编译。
//   此前读/写通道按发射类/显式类名拼符号=独立并入槽，读写跨通道分裂
//   （基::计数=42 后类内裸读仍见旧值）。派生类同名遮蔽面 001 无显式条文不锁。
类 基 {
公开:
    静态 整32 计数 = 7;
    静态 字符串 词;
}
类 子 : 基 {
公开:
    不安全 函数 裸读() -> 整32 { 返回 计数; }
    不安全 函数 裸写(整32 值) -> 空类型 { 计数 = 值; }
    不安全 函数 自增() -> 空类型 { 计数++; }
    不安全 函数 读串位(整64 i) -> 整32 { 返回 整32(词[i]); }
}
函数 主() -> 整32 {
    子::计数 = 99;
    子 物;
    打印(物.裸读());
    物.自增();
    打印(物.裸读());
    基::计数 = 42;
    打印(物.裸读());
    打印(子::计数);
    打印(基.计数);
    打印(子.计数);
    物.裸写(55);
    打印(基::计数);
    基::词 = "XYZ";
    打印(物.读串位(1));
    返回 0;
}
