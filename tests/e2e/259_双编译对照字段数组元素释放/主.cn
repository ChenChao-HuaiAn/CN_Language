// E2E 259：结构体字段数组元素释放 + 元素下标缩放双编译对照
//   （plans/020 移植纪律 9 第二十七个对照用例；99-a 第九十九轮）
//   ①C11：结构体字段数组（`字符串[3] 名`）的字符串元素释放（块出口/函数尾）——
//     97-a 字段数组读写 × 98-a 数组元素释放的合龙；修前双侧同缺。
//   ②**H4 宿主缺陷根治**：字段数组元素步进用 `types::typeSize`（该表无「字符串」
//     返回 0）→ 下标不缩放（`r.名[1]` 读写恒落元素 0；探针 fldmem2「再读0=乙」
//     实证；v2 侧同源正确=宿主单侧分叉）。修复=读侧三处统一 `semantic typeSizeOf`。
//   八形态（两侧共有语义面）：
//     ① 字段数组元素写读（下标 0/1/2——H4 面：≥1 索引必须落对元素）
//     ② 字段数组元素释放（块出口残留归零——C11 面）
//     ③ 元素内容独立性（三名互不覆盖）
//     ④ 非字符串字段数组对照（整32[3] 字段——H4 面 + 无释放）
//     ⑤ 嵌套结构体字段数组（97-a 面：总表.两行[1].分数[2]）
//     ⑥ 字段数组作实参（元素指针退化）
//     ⑦ 函数尾字段数组释放（返回路径）
//     ⑧ 与标量字段混排（r.编号 不受数组字段影响）
//   退出码 = 八形态折校验和 255（①1+②2+③4+④8+⑤16+⑥32+⑦64+⑧128 全对）。
结构体 记录 {
    字符串[3] 名;
    整32 编号;
}

结构体 分数行 {
    整32[3] 分数;
}

结构体 总表 {
    分数行[2] 两行;
}

函数 求和(整32* 表, 整32 个数) -> 整32 {
    整32 和 = 0;
    整32 i = 0;
    当 (i < 个数) {
        和 = 和 + 表[i];
        i++;
    }
    返回 和;
}

// ① 字段数组元素写读（下标 ≥1 的 H4 面）
函数 形一() -> 整64 {
    记录 r;
    r.名[0] = 字符串复制("甲");
    r.名[1] = 字符串复制("乙");
    如果 (字符串比较(r.名[0], "甲") && 字符串比较(r.名[1], "乙")) { 返回 1; }
    返回 0;
}

// ② 字段数组元素释放（块出口残留归零——C11 面）
函数 形二() -> 整64 {
    整64 起 = 内存::活动分配数();
    {
        记录 r;
        r.名[0] = 字符串复制("甲");
        r.名[1] = 字符串复制("乙");
        r.名[2] = 字符串复制("丙");
        如果 (字符串长度(r.名[2]) == 0) { 返回 0; }
    }
    如果 (内存::活动分配数() == 起) { 返回 2; }
    返回 0;
}

// ③ 元素内容独立性（三名互不覆盖——H4 面）
函数 形三() -> 整64 {
    记录 r;
    r.名[0] = 字符串复制("一");
    r.名[1] = 字符串复制("二");
    r.名[2] = 字符串复制("三");
    如果 (字符串比较(r.名[0], "一") && 字符串比较(r.名[1], "二") &&
          字符串比较(r.名[2], "三")) { 返回 4; }
    返回 0;
}

// ④ 非字符串字段数组对照（整32[3] 字段——H4 面 + 无释放）
函数 形四() -> 整64 {
    整64 起 = 内存::活动分配数();
    分数行 f;
    f.分数[0] = 10;
    f.分数[1] = 20;
    f.分数[2] = 30;
    如果 (f.分数[0] == 10 && f.分数[1] == 20 && f.分数[2] == 30 &&
          内存::活动分配数() == 起) { 返回 8; }
    返回 0;
}

// ⑤ 嵌套结构体字段数组（97-a 面）
函数 形五() -> 整64 {
    总表 t;
    t.两行[1].分数[2] = 99;
    t.两行[0].分数[0] = 11;
    如果 (t.两行[1].分数[2] == 99 && t.两行[0].分数[0] == 11) { 返回 16; }
    返回 0;
}

// ⑥ 字段数组作实参（元素指针退化）
函数 形六() -> 整64 {
    分数行 f;
    f.分数[0] = 1;
    f.分数[1] = 2;
    f.分数[2] = 3;
    如果 (求和(f.分数, 3) == 6) { 返回 32; }
    返回 0;
}

// ⑦ 函数尾字段数组释放（返回路径——C11 面）
函数 造记(整64 起) -> 整64 {
    记录 r;
    r.名[0] = 字符串复制("尾甲");
    r.名[1] = 字符串复制("尾乙");
    如果 (字符串长度(r.名[1]) == 0) { 返回 0; }
    返回 内存::活动分配数() - 起;
}
函数 形七() -> 整64 {
    整64 起 = 内存::活动分配数();
    整64 函数内增 = 造记(起);
    如果 (函数内增 != 2) { 返回 0; }
    如果 (内存::活动分配数() == 起) { 返回 64; }
    返回 0;
}

// ⑧ 与标量字段混排
函数 形八() -> 整64 {
    记录 r;
    r.名[1] = 字符串复制("名");
    r.编号 = 42;
    如果 (字符串比较(r.名[1], "名") && r.编号 == 42) { 返回 128; }
    返回 0;
}

函数 主() -> 整32 {
    整64 校验 = 形一() + 形二() + 形三() + 形四() +
                 形五() + 形六() + 形七() + 形八();
    打印("校验和=", 校验);
    返回 整32(校验 % 256);
}
