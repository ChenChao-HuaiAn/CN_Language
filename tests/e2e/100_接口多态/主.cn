// E2E 100_接口多态（P3-19）：接口类型变量 + 运行时多态分派（B1 全局槽位）
// 两实现类经同一接口变量分别命中各自实现；多接口；值/指针形式。
接口 形状 {
    虚拟 函数 面积() -> 整32
}

接口 可缩放 {
    虚拟 函数 缩放(浮64 比例) -> 浮64
}

类 圆 : 形状, 可缩放 {
公开:
    整32 半径
    函数 圆(整32 r) { 半径 = r }
    重写 函数 面积() -> 整32 { 返回 半径 * 半径 * 3 }
    重写 函数 缩放(浮64 比例) -> 浮64 { 返回 半径 * 比例 }
}

类 矩形 : 形状 {
公开:
    整32 宽
    整32 高
    函数 矩形(整32 w, 整32 h) { 宽 = w; 高 = h }
    重写 函数 面积() -> 整32 { 返回 宽 * 高 }
}

函数 主() -> 整32 {
    打印("===== 接口多态（P3-19）=====")
    // ---- 1. 值形式接口变量：两实现类各自命中 ----
    形状 图1 = 圆(5)
    打印("圆面积: ", 图1.面积())           // 75
    形状 图2 = 矩形(4, 6)
    打印("矩形面积: ", 图2.面积())          // 24
    // ---- 2. 多接口对象（形状+可缩放）经两个接口变量调用 ----
    形状 图3 = 圆(3)
    打印("多接口面积: ", 图3.面积())         // 27
    可缩放 缩放对象 = 圆(3)
    浮64 新半径 = 缩放对象.缩放(2.0)
    打印("缩放后半径: ", 新半径)            // 6.000000
    // ---- 3. 指针形式（接口指针 = 类对象指针，直接赋值） ----
    圆 对象 = 圆(4)
    形状* 图4 = 对象
    打印("指针形式: ", 图4.面积())          // 48
    圆 对象2 = 圆(2)
    形状* 图5 = 对象2
    打印("指针多态: ", 图5.面积())          // 12
    打印("===== 完成 =====")
    返回 0
}
