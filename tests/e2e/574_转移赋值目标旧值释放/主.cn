// E2E 574（933 轮·任务 095 残留面转正·宿主正测）：转移赋值目标旧值释放——
//   局部类/局部容器/静态类三形态 + 静态初值构造重载回归锚。
//   修复前：①局部/静态目标 乙 = 转移(甲) 旧对象无人释放（泄漏——类目标
//   ~货物 1 次<应 2·静态 0 次；容器目标 活动分配数 差 0 不回落）；②静态
//   类初值 静态 货物 箱 = 货物("...") 构造重载误选拷贝构造（字符串按
//   货物& 地址契约传入两跳错位 SIGSEGV·findCtorMember 兜底按实参个数
//   无法区分同参个数重载）。
//   修复后：赋值点单发 DeleteObject 旧值（Rust `b = a` move 覆盖前 drop
//   旧值对照·552 同款单发模型）+ 语义层静态初值构造解析（checkCtorCall
//   补挂·与 061-c 同病同治）+ IR 兜底防御（引用形参×不可寻址实参跳过）。
//   〔基准=019〕第二句：转移()=显式放弃拷贝换零拷贝——编译器以赋值点旧值
//   drop 维护所有权唯一（双释放/泄漏结构性根除）。
//   【dual（972 转正·报备待追认）】v2 赋值位转移通道=963（语义放行+IR 句柄直交+
//   旧值删除+源槽清零）；深水一=972 根治（静态类指针槽全链：初值注入误落结构体
//   通道 str_copy 副本覆盖槽+左值链基址 1066 守卫——m574a~e 六探针与宿主逐行
//   一致）；本例 972 转 dual（双编译对照·断言输出）。575（容器字段块收尾泄漏=
//   深水二）/576（v2 实参位转移拒绝）仍 host-only·随各自专项轮转 dual。
导入 容器::向量;
类 货物 {
公开:
    字符串 名称;
    函数 货物(字符串 s) {
        名称 = s;
    }
    不安全 函数 货物(货物& 其他) {
        名称 = 字符串复制(其他.名称);
    }
    不安全 函数 ~货物() {
        打印("~货物");
    }
}
静态 货物 静态箱 = 货物("静旧");
不安全 函数 主() -> 整32 {
    打印(静态箱.名称);
    货物 源 = 货物("静新");
    静态箱 = 转移(源);
    打印(静态箱.名称);
    货物 甲 = 货物("甲");
    货物 乙 = 货物("乙");
    乙 = 转移(甲);
    打印(乙.名称);
    向量<整32> 小;
    结果<空类型, 整32> 加1 = 小.追加(1);
    如果 (!加1.正常) { 返回 1; }
    向量<整32> 大;
    结果<空类型, 整32> 加2 = 大.追加(1);
    如果 (!加2.正常) { 返回 1; }
    结果<空类型, 整32> 加3 = 大.追加(2);
    如果 (!加3.正常) { 返回 1; }
    结果<空类型, 整32> 加4 = 大.追加(3);
    如果 (!加4.正常) { 返回 1; }
    整64 前 = 内存::活动分配数();
    大 = 转移(小);
    整64 后 = 内存::活动分配数();
    如果 (后 < 前) {
        打印("容器旧值已释放");
    }
    打印(大.大小());
    返回 0;
}
