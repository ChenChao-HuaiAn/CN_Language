// E2E 1582（#1443）：表达式子树起点（尾递归转循环+多「如果」汇合+&&短路）——
//   SSA 对「入口块=回边目标」的 Phi 化漏判隐式入口前驱：入口路径消费者读到
//   仅回边块定义的寄存器（垃圾值→池.元素 越界·错误码 2）。修复=入口块存在
//   回边前驱时放弃 Phi 化（D32 同族保守·Load 保留槽语义）。判据：-O3 行为
//   与 -O0 一致（期望=逐行输出 2）。
// #1443 等价探针：表达式子树起点（尾递归+多汇合形态）——SSA 坏化宿主复现
导入 容器::向量;

结构体 节点 {
    整32 类型;
    整32 文本;
    整64 附加;
    整32 子起点;
    整32 子终点;
    整32 行;
    整32 修饰;
}

常量 节点_二元运算 = 15;
常量 节点_调用 = 17;
常量 节点_成员 = 18;
常量 节点_下标 = 19;
常量 节点_负号 = 26;
常量 节点_逻辑非 = 25;
常量 节点_位非 = 27;
常量 节点_取地址 = 28;
常量 节点_解引用 = 29;
常量 节点_自增表达式 = 30;
常量 节点_三元运算 = 31;
常量 节点_错误传播 = 32;

函数 表达式子树起点(向量<节点> 池, 整64 根位置) -> 整64 {
    节点 nd = 池.元素(根位置);
    如果 (nd.类型 == 节点_二元运算) {
        整64 左根位 = nd.附加 - 1;
        布尔 有左 = (左根位 >= 0 && 左根位 < 根位置);
        如果 (有左) { 返回 表达式子树起点(池, 左根位); }
        返回 根位置;
    }
    布尔 是后缀 = (nd.类型 == 节点_调用) || (nd.类型 == 节点_成员) ||
                    (nd.类型 == 节点_下标);
    如果 (是后缀) {
        整64 基位 = nd.子起点;
        布尔 有基 = (基位 >= 0 && 基位 < 根位置);
        如果 (有基) { 返回 表达式子树起点(池, 基位); }
        返回 根位置;
    }
    布尔 是一元 = (nd.类型 == 节点_负号) || (nd.类型 == 节点_逻辑非) ||
                    (nd.类型 == 节点_位非) || (nd.类型 == 节点_取地址) ||
                    (nd.类型 == 节点_解引用) || (nd.类型 == 节点_自增表达式);
    如果 (是一元) {
        整64 子位 = nd.子起点;
        布尔 有子 = (子位 >= 0 && 子位 < 根位置);
        如果 (有子) { 返回 表达式子树起点(池, 子位); }
        返回 根位置;
    }
    布尔 是分支 = (nd.类型 == 节点_三元运算) || (nd.类型 == 节点_错误传播);
    如果 (是分支) {
        整64 子位2 = nd.子起点;
        布尔 有子2 = (子位2 >= 0 && 子位2 <= 根位置);
        如果 (有子2) { 返回 子位2; }
        返回 根位置;
    }
    返回 根位置;
}

函数 主() -> 整32 {
    向量<节点> 池 = 向量<节点>();
    整32 i = 0;
    当 (i < 5) {
        节点 n;
        n.类型 = 0; n.文本 = 0; n.附加 = 0; n.子起点 = 0; n.子终点 = 0; n.行 = 0; n.修饰 = 0;
        结果<空类型, 整32> 追加r = 池.追加(n);
        如果 (!追加r.正常) { 返回 1; }
        i = i + 1;
    }
    // 布局：1=标识符(叶) 2=字符串字面量(叶) 3=二元(+·左根=2) 4=二元(+·左根=3)
    节点 x1 = 池.元素(1); x1.类型 = 10; 结果<空类型, 整32> r1 = 池.设置(1, x1);
    节点 x2 = 池.元素(2); x2.类型 = 13; 结果<空类型, 整32> r2 = 池.设置(2, x2);
    节点 x3 = 池.元素(3); x3.类型 = 15; x3.附加 = 3; 结果<空类型, 整32> r3 = 池.设置(3, x3);
    节点 x4 = 池.元素(4); x4.类型 = 15; x4.附加 = 4; 结果<空类型, 整32> r4 = 池.设置(4, x4);
    整64 r = 表达式子树起点(池, 4);   // 期望 4→左根3→左根1→叶 返回 1
    打印行(r);
    返回 0;
}
