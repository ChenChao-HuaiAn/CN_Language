导入 容器::向量;

// ① T19②：泛型体内嵌套泛型调用（推断式单态化——原裸名 _恒等 链接爆）
泛型 <类型 T> 函数 恒等(T 值) -> T {
    返回 值;
}
泛型 <类型 T> 函数 两倍(T 值) -> T {
    返回 恒等(值);
}

// ② T20①：泛型形参为泛型类实例值传递（原「间接调用 0」段错误）
泛型 <类型 T> 函数 只读大小(向量<T> 容器) -> 整64 {
    返回 容器.大小();
}

// ③ 主通路推断式泛型调用（普通函数体内直接推断）
函数 主() -> 整32 {
    整32 甲 = 恒等(50);
    打印(甲);
    整32 乙 = 两倍<整32>(21);
    打印(乙);
    向量<整32> 容器 = 向量<整32>();
    结果<空类型, 整32> 加 = 容器.追加(7);
    如果 加.正常 { 打印(0); } 否则 { 打印(加.错误); 返回 1; }
    整64 丙 = 只读大小<整32>(容器);
    打印(丙);
    // 健康对照：普通函数向量值形参（84-a/88-a 路径零回归）
    返回 0;
}
