// 官网文档示例 · tutorial-syntax.html · 函数（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
// 重载：同名按参数类型与个数区分（仅返回类型不同不构成重载）
函数 最大(整32 a, 整32 b) -> 整32 { 如果 a > b { 返回 a; } 返回 b; }
函数 最大(浮64 a, 浮64 b) -> 浮64 { 如果 a > b { 返回 a; } 返回 b; }

// 默认参数：从右向左连续声明
函数 问候(字符串 名字 = "世界") -> 空类型 {
    打印("你好，" + 名字);
}

// 引用参数：直写调用方（左值地址传递）
函数 交换(整32& a, 整32& b) -> 空类型 {
    整32 临时 = a;
    a = b;
    b = 临时;
}

// 常量引用参数：只读借用（体内赋值=编译错误）
函数 求和(常量 整64& x, 常量 整64& y) -> 整64 { 返回 x + y; }

函数 主() -> 整32 {
    打印(最大(3, 9), " ", 最大(2.5, 1.8));
    问候();
    问候("张三");
    整32 p = 1;
    整32 q = 2;
    交换(p, q);            // 引用实参：直传左值（不加 &）
    打印(p, q);
    整64 x = 100;
    整64 y = 23;
    打印(求和(x, y));      // 常量引用实参须左值变量
    返回 0;
}