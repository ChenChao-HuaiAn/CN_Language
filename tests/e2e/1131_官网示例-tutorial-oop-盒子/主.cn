// 官网文档示例 · tutorial-oop.html · 泛型类（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
泛型 <类型 T>
类 盒子 {
私有:
    T 内容;
    布尔 有货;
公开:
    函数 盒子(T 初值) {
        内容 = 初值;
        有货 = 真;
    }

    函数 取出() -> T { 返回 内容; }
    函数 空否() -> 布尔 { 返回 !有货; }
}

函数 主() -> 整32 {
    盒子<整64> 数盒 = 盒子<整64>(42);
    盒子<字符串> 文盒 = 盒子<字符串>("礼物");
    打印(数盒.取出(), " ", 文盒.取出());
    返回 0;
}