函数 主() -> 整32 {
    打印(2 + 3 * 4);
    打印((2 + 3) * 4);
    打印(10 - 4 - 3);
    打印(1 + 2 << 3);
    打印(16 >> 2 + 2);
    打印(5 & 3 | 4);
    打印(5 ^ 3 & 1);
    打印(1 | 2 ^ 3);
    如果 (1 + 1 == 2 && 3 > 2) { 打印行("且高于或"); }
    如果 (0 == 1 || 2 >= 2) { 打印行("或最低"); }
    整32 x = 0;
    整32 y = x = 5;
    打印(x + y);
    整32 m = 1;
    整32 r = m > 0 ? 10 : m < 0 ? 20 : 30;
    打印行(r);
    打印(~5 + 1);
    打印(100 / 5 * 2);
    返回 0;
}
