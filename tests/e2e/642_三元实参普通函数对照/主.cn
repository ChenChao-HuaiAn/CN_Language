// p263tmp_a（263① 探针·临时不入库）：三元聚合实参 → 普通函数值形参。
//   权料=旧 070 行抢救「形一 差 2＝三元聚合拷贝临时泄漏〔串+对象两笔〕·修=容器方法
//   调用 三元实参临时释放 flushPendingArgCleanups 同构」——245 形一只覆盖容器方法位，
//   本探针打「普通函数调用位」：三元求值物化的临时聚合（含串字段）是否在调用后回收。
//   2=绿（分配数回平）；1=泄漏；0=校验失败。
结构体 盒子 {
    字符串 名;
    整32 号;
}

函数 挑选号(盒子 输入) -> 整32 {
    返回 输入.号;
}

函数 形探() -> 整64 {
    整64 前 = 内存::活动分配数();
    {
        盒子 甲 = 盒子{ 名 = 字符串复制("P263A甲串占位内容"), 号 = 1 };
        盒子 乙 = 盒子{ 名 = 字符串复制("P263A乙串占位内容"), 号 = 2 };
        整32 号 = 挑选号(真 ? 甲 : 乙);
        如果 (号 != 1) { 返回 0; }
    }
    如果 (内存::活动分配数() != 前) { 返回 1; }
    返回 2;
}

函数 主() -> 整32 {
    打印(形探());
    返回 0;
}
