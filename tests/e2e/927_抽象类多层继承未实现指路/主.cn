// E2E 927 负测（任务728j·诊断指路）：抽象类实例化诊断列出未实现的具体方法名
//   ——多层继承下（父类声明抽象·中间类漏实现·子类被拒）用户一眼看到漏的是哪个
//   方法，不再只报「含未实现抽象方法」。
// 立法：specs/06 §八（抽象成员纯虚声明·含抽象成员的类不可直接实例化）+ 193
//   双侧语义层拦截家族（858/861）之诊断增强。
// 覆盖面：①两个以上未实现名清单（声明序故意乱序=验证字典序排序+顿号连接）
//   ②多层继承中间类漏实现（兽 只实现 叫 → 兽/狗 清单=走、跑）③沿链传播
//   （狗 未声明新实现 → 同清单）④裸声明+构造调用两形态（semantic_decl /
//   semantic_call_ctor 双侧四处报警点全覆盖）。
// 语法依据（cn-language-spec 06 §八）：抽象 函数 名() -> 类型 无实现体；
//   派生类 重写 函数 实现；未实现清单=并入后方法表 无体抽象方法名集合。
// 诊断锚=「不能实例化抽象类 '动物'（未实现抽象方法：叫、走、跑）」（宿主侧
//   锚定·v2 侧 主.expected 逐行固化——两侧文案逐字一致零分叉）。
// 排序口径：UTF-8 字节序=码点序（叫 U+53EB < 走 U+8D70 < 跑 U+8DD1）。
类 动物 {
公开:
    抽象 函数 跑() -> 整64
    抽象 函数 叫() -> 整64
    抽象 函数 走() -> 整64
}

// 中间类：只实现 叫，漏 走/跑——多层继承指路核心场景
类 兽 : 动物 {
公开:
    重写 函数 叫() -> 整64 {
        返回 1;
    }
}

// 子类：无新实现，未实现集沿链传播（走/跑）
类 狗 : 兽 {
}

函数 主() -> 整32 {
    动物 甲;            // 裸声明：未实现=叫、走、跑（三名字·排序+顿号）
    兽 乙;              // 裸声明：未实现=走、跑（中间类漏实现）
    狗 丙;              // 裸声明：未实现=走、跑（沿链传播）
    动物 丁 = 动物();   // 构造调用形态同清单
    返回 0;
}
