// E2E 1081（861·宿主+v2 双侧同构·2026-10-17）：**类字符串字段直赋通道归一化
//   与复合赋值旧值释放**——79-a「字段独立拥有」立法在类字段写入位的补完：
//   ①静态字符串字段直赋（静态方法内裸名/类外 类名.静态字段 = 局部/形参串）——
//     借用来源深拷落堆：字段独立副本（原宿主判据盲区=句柄直存：被调方出口
//     RAII 释放局部后字段悬垂——函数返回后读空；v2 类外形态同族实锤读垃圾）；
//   ②复合赋值 += 重析为二元（语义层 rewriteStringConcatCompoundAssign≡v2 语法层
//     重析）：拼接产物=新堆串直存接管（不复制=防中间串孤儿）+ 旧值当场 drop
//     （静态槽/字段槽长期存活=赋值点唯一 drop 时机）——原双侧净泄（宿主旧值
//     漏释放/v2 拼接产物孤儿）；
//   ③对照：实例裸字段直赋（644-b 已修面）与局部变量位（732 面）不回退。
//   断言口径：内存::活动分配数() 「清零后差值=0」（干净泄漏语义——循环后把目标
//   置字面量：上轮末值随之释放；字面量=驻留零分配）；内容校验防假绿（长度断言）。
//   校验和折位：①a1 ①b2 ①c4 ③8 = 15 全对（打印「①位=15」）；任一残留非 0 →
//   对应行值变化 → 逐行比对即红；退出码恒 0（行级断言承载）。
类 寄存器861 {
公开:
    静态 字符串 静态槽;
    字符串 实例名;
    函数 寄存器861() { }

    静态 函数 装静态甲() -> 空类型 {
        字符串 局部 = 字符串复制("861甲局部串内容甲乙丙丁戊己庚辛");
        静态槽 = 局部;   // ①a 静态裸名直赋（局部串借用）
    }
    静态 函数 装静态乙(字符串 s) -> 空类型 {
        静态槽 = s;      // ①b 静态裸名直赋（形参借用）
    }
    函数 装实例(字符串 s) -> 空类型 {
        实例名 = s;      // ③ 实例裸名直赋（644-b 对照）
    }
    静态 函数 追加静态(字符串 s) -> 空类型 {
        静态槽 += s;     // ②b 静态裸名复合（+守卫：拼接直存+旧值释放）
    }
    函数 追加实例(字符串 s) -> 空类型 {
        实例名 += s;     // ②a 实例裸名复合
    }
}

函数 造串() -> 字符串 {
    返回 字符串复制("861乙形参串内容甲乙丙丁戊己庚辛");
}

函数 写静态成员() -> 空类型 {
    字符串 局部 = 字符串复制("861丙成员写局部串内容甲乙丙丁戊");
    寄存器861.静态槽 = 局部;   // ①c 类外 类名.静态字段直赋（借用来源深拷）
}

函数 追加静态成员(字符串 s) -> 空类型 {
    寄存器861.静态槽 += s;     // ②c 类外 类名.静态字段复合
}

函数 追加成员目标(寄存器861 对象, 字符串 s) -> 空类型 {
    对象.实例名 += s;          // ②d 对象.实例字段复合
}

静态 字符串 顶串;

不安全 函数 追加顶串(字符串 s) -> 空类型 {
    顶串 += s;   // d1 顶层静态变量复合（非类字段·同族结算面）
}

不安全 函数 主() -> 整32 {
    整64 位 = 0;

    // ①a 静态方法内裸名直赋：函数返回后读（局部串已随出口 RAII 释放——
    //   字段独立拥有则内容完好）
    寄存器861.装静态甲();
    打印("①a 读槽=[", 寄存器861.静态槽, "]");
    如果 (字符串比较(寄存器861.静态槽, "861甲局部串内容甲乙丙丁戊己庚辛")) { 位 = 位 + 1; }

    // ①b 静态方法内裸名直赋（形参借用）
    寄存器861.装静态乙(造串());
    打印("①b 读槽=[", 寄存器861.静态槽, "]");
    如果 (字符串比较(寄存器861.静态槽, "861乙形参串内容甲乙丙丁戊己庚辛")) { 位 = 位 + 2; }

    // ①c 类外 类名.静态字段直赋（成员目标通道）
    写静态成员();
    打印("①c 读槽=[", 寄存器861.静态槽, "]");
    如果 (字符串比较(寄存器861.静态槽, "861丙成员写局部串内容甲乙丙丁戊")) { 位 = 位 + 4; }

    // ③ 实例裸名直赋（644-b 对照）
    寄存器861 对象 = 寄存器861();
    对象.装实例(造串());
    打印("③ 读实例=[", 对象.实例名, "]");
    如果 (字符串比较(对象.实例名, "861乙形参串内容甲乙丙丁戊己庚辛")) { 位 = 位 + 8; }
    打印("①位=", 位);

    // ②a 实例裸名复合 += 100 轮：清零后残留=0（每轮 concat 直存+旧值 free）
    对象.装实例("前缀");
    整64 前a = 内存::活动分配数();
    整64 i = 0;
    当 (i < 100) {
        对象.追加实例("后缀串片");
        i++;
    }
    整64 长a = 字符串长度(对象.实例名);
    对象.装实例("尾标");
    打印("②a 实例复合 残留=", 内存::活动分配数() - 前a, " 尾长=", 长a);

    // ②b 静态裸名复合 += 100 轮
    寄存器861.装静态乙("前缀");
    整64 前b = 内存::活动分配数();
    i = 0;
    当 (i < 100) {
        寄存器861.追加静态("后缀串片");
        i++;
    }
    整64 长b = 字符串长度(寄存器861.静态槽);
    寄存器861.装静态乙("尾标");
    打印("②b 静态复合 残留=", 内存::活动分配数() - 前b, " 尾长=", 长b);

    // ②c 类外 类名.静态字段复合 += 100 轮
    寄存器861.装静态乙("前缀");
    整64 前c = 内存::活动分配数();
    i = 0;
    当 (i < 100) {
        追加静态成员("后缀串片");
        i++;
    }
    整64 长c = 字符串长度(寄存器861.静态槽);
    寄存器861.装静态乙("尾标");
    打印("②c 类外静态复合 残留=", 内存::活动分配数() - 前c, " 尾长=", 长c);

    // ②d 对象.实例字段复合 += 100 轮
    对象.装实例("前缀");
    整64 前d = 内存::活动分配数();
    i = 0;
    当 (i < 100) {
        追加成员目标(对象, "后缀串片");
        i++;
    }
    整64 长d = 字符串长度(对象.实例名);
    对象.装实例("尾标");
    打印("②d 对象字段复合 残留=", 内存::活动分配数() - 前d, " 尾长=", 长d);

    // d1 顶层静态变量复合（赋值点=唯一 drop 时机）
    顶串 = "前缀";
    整64 前1 = 内存::活动分配数();
    i = 0;
    当 (i < 100) {
        追加顶串("后缀串片");
        i++;
    }
    整64 长1 = 字符串长度(顶串);
    顶串 = "尾标";
    打印("d1 顶层静态复合 残留=", 内存::活动分配数() - 前1, " 尾长=", 长1);

    // d2 局部变量拼接初值（声明位直存·块出口释放）
    整64 前2 = 内存::活动分配数();
    i = 0;
    当 (i < 100) {
        字符串 局 = 字符串复制("甲") + "乙丙";
        如果 (字符串长度(局) != 9) { 打印行("d2 内容错"); }
        i++;
    }
    打印("d2 局部拼接初值 残留=", 内存::活动分配数() - 前2);

    // d3 局部变量重赋值拼接（赋值位直存+旧值释放）
    字符串 槽 = "预热";
    整64 前3 = 内存::活动分配数();
    i = 0;
    当 (i < 100) {
        槽 = 字符串复制("丙") + "丁戊";
        i++;
    }
    打印("d3 局部重赋值拼接 残留=", 内存::活动分配数() - 前3, " 尾长=", 字符串长度(槽));
    槽 = "尾标";

    返回 0;
}
