// E2E 1727（2026-11-05·任务 2097·1105 探针 d3 实锚）：常量 修饰实例成员
//   初始化器=不可变默认值（001 §2.1a「常量=类成员修饰位」+§5.6 甲案起步面
//   整数/布尔字面量）——构造期注入与 775 普通字段同链。修前宿主解析接受
//   但发射静默丢弃输出 0；v2 解析直接拒「不支持该类成员修饰」。位断言
//   五形态：①构造调用整64 ②整64 二字段 ③布尔真 ④负号字面量 ⑤裸声明。
//   全链值断言（退出码+stdout 双锁）。
类 配置 {
公开:
    常量 整64 秘钥 = 42;
    常量 整64 版本 = 3;
    常量 布尔 开关 = 真;
    常量 整32 负值 = -7;
}
函数 主() -> 整32 {
    配置 甲 = 配置();
    配置 乙;
    整32 和 = 0;
    如果 (甲.秘钥 == 42) { 和 += 1; }
    如果 (甲.版本 == 3) { 和 += 2; }
    如果 (甲.开关 == 真) { 和 += 4; }
    如果 (甲.负值 == 0 - 7) { 和 += 8; }
    如果 (乙.秘钥 == 42) { 和 += 16; }
    打印行(和);
    返回 和;
}
