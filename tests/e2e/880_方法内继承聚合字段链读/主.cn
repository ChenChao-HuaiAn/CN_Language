// 880 方法内继承聚合字段链读（#598 锁面·2026-10-14 dual）
// 立账=589 采样轮（d1 实镜）：子类方法内 直访 父类结构体字段的子标量
//   （返回 位置.x）——v2 IR 层「成员字段偏移未知: .x」编译拒（宿主绿）。
//   根因=解析右值偏移兜底 107 收窄链式中段只认 值/错误 两名（结果/可选
//   合成体），this 语境类字段裸标识符中段（位置）miss。修=兜底扩：对象=
//   节点_标识符 且 当前方法类名ID 命中类字段表（沿继承链同键同表〔234〕）
//   → 字段声明类型作结构体键查三元组（510-a 基址面同前提）。
// 本用例三形态锁面：①继承链（父类聚合字段子标量读+写全链）②本类聚合链
//   （510-a 原形态不回归）③方法内 this 聚合字段链写（写路径同面）。
结构体 点 {
    整32 x;
    整32 y;
}
类 基类 {
公开:
    点 位置;
}
类 子类 : 基类 {
公开:
    函数 取x() -> 整32 {
        返回 位置.x;
    }
    函数 置x(整32 v) -> 空类型 {
        位置.x = v;
    }
}
结构体 内层 {
    整32 a;
    整32 b;
}
类 盒子 {
公开:
    内层 内;
    函数 读y() -> 整32 {
        返回 内.b;
    }
    函数 演示() -> 空类型 {
        内.a = 5;
        内.b = 6;
        内.a = 50;
    }
}
函数 主() -> 整32 {
    子类 子;
    子.位置.x = 21;
    子.位置.y = 22;
    整32 r = 子.取x();
    子.置x(33);
    打印("①=", r, " ", 子.位置.x, " ", 子.位置.y);
    盒子 盒;
    盒.内.a = 4;
    盒.内.b = 5;
    打印("②=", 盒.读y());
    盒.演示();
    打印("③=", 盒.内.a, " ", 盒.内.b);
    返回 0;
}
