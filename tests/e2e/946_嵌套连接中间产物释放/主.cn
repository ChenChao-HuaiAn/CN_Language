// E2E 946（2026-10-14·任务 732）：嵌套连接中间产物释放——双侧同修回归。
//   立案背景（732 探针双侧实锤·663 修转换临时后余半）：`甲+i+乙;`（左结合
//   =(甲+i)+乙）的内层连接产物 R1 为堆串（拥有契约），唯一消费者=外层
//   concat（纯函数·拷贝内容），调用后零引用；663 面只收语句位最终值
//   （visitExprStmt 弃值）与转换临时（from_* 产物），内层产物在两判定面
//   之外=每语句净泄 1（宿主探针：嵌套语句位百轮泄 100·赋值位嵌套叠旧值
//   覆盖共 200）。修复=生成点单点收口（宿主 freeIfConcatTemp 定义点溯源
//   isConcatResultReg·v2 是拼接产物寄存器 指令倒序回查——与 663 转换临时
//   同构·消费点即释放点）；赋值位二元连接产物旧值覆盖=宿主
//   identifierStringOwnAssign 扩 BinaryExpr 分支（free 旧+产物直存接管；
//   v2 发射拥有串赋值 右值拥有判定原已列 节点_二元运算——本轮宿主补齐
//   分叉对齐）。full-expression 语句位临时清单框架（644 推广方向）经评估
//   不引入：嵌套中间产物消费者唯一且确定（AI 裁决留痕·732）。
//   断言口径（923 同款）：每形态百轮 内存::活动分配数() 差值恒 0，折位：
//     ①语句位嵌套 甲+i+乙;=1 ②赋值位嵌套（含内容断言）=2
//     ③三重嵌套 甲+i+乙+j;=4 ④右嵌套+非嵌套赋值位=8
//     ⑤防误伤对照（663 非嵌套回归+指针算术+赋值内容不破坏）=16 —— 31=全对。
//   644/907 面规避：无拥有串调用实参形态；645/908 面规避：无拥有串调用
//   语句位形态；比较位连接产物丢弃=645/663 框架扩展另案（不入本面）。

// ① 语句位嵌套连接（`甲+i+乙;` 立案形态）——修复后每轮净泄 0
函数 语句位嵌套() -> 整64 {
    字符串 甲 = "基串内容甲乙丙丁";
    字符串 乙 = "第二串内容戊己庚辛";
    整64 前 = 内存::活动分配数();
    整32 i = 0;
    当 (i < 100) {
        甲 + i + 乙;
        i += 1;
    }
    返回 内存::活动分配数() - 前;
}

// ② 赋值位嵌套连接（`接 = 甲+i+乙;`——R1 中间产物+旧值覆盖双泄位）
函数 赋值位嵌套() -> 整64 {
    字符串 甲 = "基串内容甲乙丙丁";
    字符串 乙 = "第二串内容戊己庚辛";
    字符串 接 = "初值槽位";
    整64 前 = 内存::活动分配数();
    整32 i = 0;
    当 (i < 100) {
        接 = 甲 + i + 乙;
        i += 1;
    }
    整64 差 = 内存::活动分配数() - 前;
    // 内容断言：i=99 末轮产物接管正确（防 free 旧误伤/内容破坏）
    如果 (接 != "基串内容甲乙丙丁99第二串内容戊己庚辛") { 返回 -1; }
    返回 差;
}

// ③ 三重嵌套（`甲+i+乙+j;` = ((甲+i)+乙)+j——R1/R2 两层中间产物全收）
函数 三重嵌套位() -> 整64 {
    字符串 甲 = "基串内容甲乙丙丁";
    字符串 乙 = "第二串内容戊己庚辛";
    整64 前 = 内存::活动分配数();
    整32 i = 0;
    整32 j = 0;
    当 (i < 100) {
        甲 + i + 乙 + j;
        i += 1;
        j += 2;
    }
    返回 内存::活动分配数() - 前;
}

// ④ 右嵌套语句位 `甲+(乙+j);`（内层产物在右操作数臂）+
//    非嵌套赋值位 `接 = 甲+乙;`（旧值覆盖面独立验证）
函数 右嵌套与非嵌套赋值位() -> 整64 {
    字符串 甲 = "基串内容甲乙丙丁";
    字符串 乙 = "第二串内容戊己庚辛";
    字符串 接 = "初值槽位";
    整64 前 = 内存::活动分配数();
    整32 j = 0;
    当 (j < 100) {
        甲 + (乙 + j);
        j += 1;
    }
    整32 k = 0;
    当 (k < 100) {
        接 = 甲 + 乙;
        k += 1;
    }
    整64 差 = 内存::活动分配数() - 前;
    如果 (接 != "基串内容甲乙丙丁第二串内容戊己庚辛") { 返回 -1; }
    返回 差;
}

// ⑤ 防误伤对照：663 非嵌套语句位回归（变量操作数禁 free）+ 指针算术
//    （产物非堆串·误 free=UB 崩溃/堆损坏）+ 赋值源变量内容不破坏
不安全 函数 防误伤对照位() -> 整64 {
    字符串 甲 = "基串内容甲乙丙丁";
    字符串 乙 = "第二串内容戊己庚辛";
    整64 前 = 内存::活动分配数();
    整32 i = 0;
    当 (i < 100) {
        甲 + 乙;
        i += 1;
    }
    整32[4] 元素们;
    元素们[0] = 42;
    元素们[1] = 43;
    整32* p = 元素们;
    整32 k = 0;
    当 (k < 100) {
        p + 1;
        k += 1;
    }
    整64 差 = 内存::活动分配数() - 前;
    如果 (p[0] != 42 || p[1] != 43) { 返回 -1; }
    如果 (甲 != "基串内容甲乙丙丁" || 乙 != "第二串内容戊己庚辛") { 返回 -1; }
    返回 差;
}

函数 主() -> 整32 {
    整32 和 = 0;
    如果 (语句位嵌套() == 0) { 和 += 1; }
    如果 (赋值位嵌套() == 0) { 和 += 2; }
    如果 (三重嵌套位() == 0) { 和 += 4; }
    如果 (右嵌套与非嵌套赋值位() == 0) { 和 += 8; }
    如果 (防误伤对照位() == 0) { 和 += 16; }
    打印行(和);
    返回 和;
}
