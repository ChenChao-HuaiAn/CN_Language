// E2E 1531_构造器赋值位语境与载荷兼容正例（#1591·双编译对照正例）：
//   ①赋值位（标识符简单赋值）构造器语境——`乙 = 某些(7)` 宿主支持/v2 修前误拒；
//   ②字段位 / 数组元素位 / 嵌套构造器折位校验（可选<可选<整64>> 两层载荷）；
//   ③结果错误侧载荷（字符串）/ 结构体同型载荷（深拷边界正态）；
//   ④结果变量整体覆盖赋值（字符串载荷旧值释放链·原 264 负测行为翻正）。
//   两侧同源码编译运行，stdout 逐行比对（双编译对照.txt 断言输出=是）。
//   载荷宽度选型：字段/数组元素用整32 载荷（宿主合成体字段/数组元素 8 字节
//   载荷布局缺陷面为零件外既有存量——本用例不携该缺陷入正例）；标识符/返回位
//   用整64 载荷（v2 缺陷 a 原报形态）。
结构体 盒 {
    可选<整32> 选;
    可选<可选<整64>> 嵌套;
}

结构体 点 {
    整32 横;
    整32 纵;
}

函数 造旧() -> 结果<字符串, 整32> {
    返回 正常(字符串复制("旧值"));
}

函数 造选() -> 可选<整64> {
    返回 某些(17);   // 返回位构造器语境（既有 71-a 面回归锁）
}

函数 主() -> 整32 {
    可选<整64> 乙;
    乙 = 某些(7);                         // ①赋值位（标识符）
    如果 (乙.有值) { 打印("赋值=" + 整数转字符串(乙.值)); }

    盒 甲盒 = 盒{ 选 = 无, 嵌套 = 无 };
    甲盒.选 = 某些(9);                    // ②字段位
    如果 (甲盒.选.有值) { 打印("字段=" + 整数转字符串(甲盒.选.值)); }

    可选<整32>[2] 组;
    组[0] = 某些(11);                     // ②数组元素位
    组[1] = 某些(12);
    如果 (组[1].有值) { 打印("元素=" + 整数转字符串(组[1].值)); }

    可选<可选<整64>> 嵌套 = 某些(某些(13));   // ②嵌套构造器（声明位）
    如果 (嵌套.有值) {
        如果 (嵌套.值.有值) { 打印("嵌套=" + 整数转字符串(嵌套.值.值)); }
    }

    甲盒.嵌套 = 某些(某些(15));           // ②嵌套构造器（字段位）
    如果 (甲盒.嵌套.有值) {
        如果 (甲盒.嵌套.值.有值) { 打印("字段嵌套=" + 整数转字符串(甲盒.嵌套.值.值)); }
    }

    结果<整32, 字符串> 果 = 错误("坏");   // ③错误侧载荷（字符串）
    如果 (!果.正常) { 打印("错误侧=" + 果.错误); }

    可选<点> 点盒 = 某些(点{ 横 = 3, 纵 = 4 });   // ③结构体同型载荷
    如果 (点盒.有值) { 打印("结构体=" + 整数转字符串(点盒.值.横 + 点盒.值.纵)); }

    结果<字符串, 整32> 串果 = 造旧();     // ④整体覆盖（字符串载荷旧值释放）
    串果 = 正常(字符串复制("新值"));
    如果 (串果.正常) { 打印("覆盖=" + 串果.值); }

    可选<整64> 返盒 = 造选();              // 返回位回归
    如果 (返盒.有值) { 打印("返回=" + 整数转字符串(返盒.值)); }

    返回 0;
}
