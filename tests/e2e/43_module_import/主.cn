// 主入口（Task 6.11 补测：模块导入语法全形式 E2E，规格书08-二）
// 覆盖全部导入语法形式：
//   ① 导入 模块::符号        （模块甲::加：限定调用重写为纯名）
//   ② 导入 模块（整模块）    （导入 模块甲：公开符号纯名访问 + 限定调用）
//   ③ 导入 多级路径          （导入 模块丙::减半：依赖链 主→模块丙→模块乙）
//   ④ 花括号导入             （导入 模块甲::{乘, 最大值}：纯名直调）
//   ⑤ 花括号多符号           （导入 模块甲::{颜色}：多符号逗号分隔）
//   ⑥ 公开符号跨模块可见      （导入后 纯名调用 / 纯名实例化类 / 纯名引用枚举）
//   ⑦ 函数重载跨模块          （模块甲::加 整32/浮64 双签名）
//   ⑧ 泛型函数跨模块          （最大值<整32>/<浮64> 单态化）
//   ⑨ 被导入模块私有依赖闭包  （模块甲::阶乘 递归，纯递归无私有引用）
// 边界说明：
//   - 私有符号导入/不存在符号导入为编译错误，由单测覆盖（run_e2e 不支持预期编译失败）
//   - 顶层「常量」声明编译器不支持（Program 无全局常量存储），不在覆盖范围
// 打印语义（用户裁决）：打印=println（自动换行）

导入 模块甲::加
导入 模块甲
导入 模块甲::{乘, 最大值}
导入 模块甲::{颜色}
导入 模块丙::减半

函数 主() -> 整32 {
    打印("===== 模块导入语法全形式（Task 6.11）=====")

    // ---- ① 导入 模块::符号：限定调用 ----
    整32 和1 = 模块甲::加(10, 32)
    打印("加(10,32): ", 和1)                    // 42

    // ---- ① 重载解析：浮64 版本 ----
    浮64 和2 = 模块甲::加(1.5, 2.5)
    打印("加浮64: ", 和2)                       // 4.000000

    // ---- ② 导入 模块（整模块）：限定调用 + 纯名访问 ----
    整32 积1 = 模块甲::乘(6, 7)
    打印("乘限定: ", 积1)                       // 42
    整32 积2 = 乘(7, 6)
    打印("乘纯名: ", 积2)                       // 42

    // ---- ③ 导入 多级路径（依赖链 主→模块丙→模块乙）----
    整32 半 = 模块丙::减半(43)
    打印("减半(43): ", 半)                      // 42

    // ---- ④ 花括号导入：纯名直调 ----
    整32 积3 = 乘(5, 8)
    打印("从导入乘: ", 积3)                     // 40

    // ---- ⑤ 花括号多符号：泛型函数跨模块单态化 ----
    整32 最大整 = 最大值<整32>(10, 42)
    打印("最大值整32: ", 最大整)                // 42
    浮64 最大浮 = 最大值<浮64>(3.14, 2.71)
    打印("最大值浮64: ", 最大浮)                // 3.140000

    // ---- ⑥ 公开枚举跨模块引用（纯名，导入 模块甲::{颜色} 后引用成员）----
    整32 红值 = 颜色.红
    整32 蓝值 = 颜色.蓝
    打印("颜色.红: ", 红值)                     // 1
    打印("颜色.蓝: ", 蓝值)                     // 3

    // ---- ⑥ 公开类跨模块实例化（构造函数重载 无参/带参，缺陷3 修复验证）----
    计数器 计数1 = 计数器()
    整32 计数1值 = 计数1.当前值()
    打印("计数器无参: ", 计数1值)              // 0
    计数器 计数2 = 计数器(40)
    计数2.增加()
    整32 计数2值 = 计数2.当前值()
    打印("计数器带参+1: ", 计数2值)            // 41

    // ---- ⑥ 被导入模块公开函数纯名调用（整模块导入后）----
    整32 和3 = 加(100, 200)
    打印("加纯名: ", 和3)                       // 300

    // ---- ⑦ 跨模块函数重载：整32 与 浮64 双签名均可用 ----
    整32 重载整 = 加(1, 1)
    浮64 重载浮 = 加(0.5, 0.5)
    打印("重载整32: ", 重载整)                  // 2
    打印("重载浮64: ", 重载浮)                  // 1.000000

    // ---- ⑨ 模块甲 公开函数 阶乘 递归（纯递归，验证公开符号闭包）----
    整32 阶乘5 = 阶乘(5)
    打印("阶乘5: ", 阶乘5)                      // 120

    打印("===== 模块导入语法全形式测试完成 =====")
    返回 0
}
