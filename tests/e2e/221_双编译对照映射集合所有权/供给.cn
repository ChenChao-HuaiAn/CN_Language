// E2E 221 符号供给（v2 自举链，plans/020 移植纪律 9）：
//   v2p_linuxx64.o 只含 v2 自身实例化的容器类型——本用例的 集合<字符串>/
//   映射<整64,字符串>/链表<字符串>/队列<字符串>（含 删除/析构键值/析构值/
//   释放内部数组/清空 等 76-a 新挂点方法）方法符号须由本文件经**宿主真实
//   管线**编译为 .o 参与链接（置于 v2p .o 之前，符号权威）。
//   与 126/218/219 供给同款机制（②b B5/B7）。
导入 容器::向量;
导入 容器::链表;
导入 容器::队列;
导入 映射集合;

// 实例化 向量<字符串> 全方法面（76-a：删除/设置/元素/清空）
函数 供给向量() -> 整64 {
    向量<字符串> 表 = 向量<字符串>();
    结果<空类型, 整32> 加 = 表.追加("供给向量元素");
    如果 (!加.正常) { 返回 110; }
    结果<空类型, 整32> 设 = 表.设置(0, "供给向量新元素");
    如果 (!设.正常) { 返回 111; }
    结果<空类型, 整32> 删 = 表.删除(0);
    如果 (!删.正常) { 返回 112; }
    表.清空();
    如果 (表.大小() != 0) { 返回 113; }
    返回 0;
}

// 实例化 集合<字符串> 全方法面（添加/大小/清空/析构 + 76-a 挂点 析构元素）
函数 供给集合() -> 整64 {
    集合<字符串> 集 = 集合<字符串>();
    结果<空类型, 整32> 加 = 集.添加("供给集合元素");
    如果 (!加.正常) { 返回 101; }
    如果 (集.大小() != 1) { 返回 102; }
    集.清空();
    返回 0;
}

// 实例化 映射<整64,字符串> 全方法面（设置/获取/包含/删除/大小/清空/释放内部数组
//   ——覆盖 76-a 挂点 析构键值/析构值 的符号生成）
函数 供给映射() -> 整64 {
    映射<整64, 字符串> 表 = 映射<整64, 字符串>();
    结果<空类型, 整32> 设 = 表.设置(1, "供给映射值串一");
    如果 (!设.正常) { 返回 103; }
    结果<空类型, 整32> 覆 = 表.设置(1, "供给映射值串二");
    如果 (!覆.正常) { 返回 104; }
    如果 (!表.包含(1)) { 返回 105; }
    布尔 删 = 表.删除(1);
    如果 (!删) { 返回 106; }
    结果<空类型, 整32> 设二 = 表.设置(2, "供给映射值串三");
    如果 (!设二.正常) { 返回 107; }
    表.清空();
    映射<整64, 字符串> 表二 = 映射<整64, 字符串>();
    结果<空类型, 整32> 设三 = 表二.设置(3, "供给映射值串四");
    如果 (!设三.正常) { 返回 108; }
    表二.释放内部数组();
    返回 0;
}

// 实例化 链表<字符串> 全方法面（头部追加/删除头部/删除尾部/清空/大小/析构）
函数 供给链表() -> 整64 {
    链表<字符串> 表 = 链表<字符串>();
    结果<空类型, 整32> 加 = 表.头部追加("供给链表元素");
    如果 (!加.正常) { 返回 109; }
    结果<空类型, 整32> 删头 = 表.删除头部();
    如果 (!删头.正常) { 返回 114; }
    结果<空类型, 整32> 加二 = 表.头部追加("供给链表元素二");
    如果 (!加二.正常) { 返回 115; }
    结果<空类型, 整32> 删尾 = 表.删除尾部();
    如果 (!删尾.正常) { 返回 116; }
    结果<空类型, 整32> 加三 = 表.追加("供给链表元素三");
    如果 (!加三.正常) { 返回 117; }
    表.清空();
    返回 0;
}

// 实例化 队列<字符串> 全方法面（入队/清空/大小/析构）
函数 供给队列() -> 整64 {
    队列<字符串> 表 = 队列<字符串>();
    结果<空类型, 整32> 加 = 表.入队("供给队列元素");
    如果 (!加.正常) { 返回 118; }
    表.清空();
    如果 (表.大小() != 0) { 返回 119; }
    返回 0;
}

// 宿主编译入口（cn build 需要主函数；链接 muldefs 下 v2asm 在前，cn_main 归 v2 产物）
函数 主() -> 整32 {
    返回 整32(供给向量() + 供给集合() + 供给映射() + 供给链表() + 供给队列());
}
