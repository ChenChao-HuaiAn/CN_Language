// E2E 1321（2026-10-18·任务 #919）：超承载字面量参与表达式求值口径收口——正测。
//   （表达式面按 638 甲案提升链归整 128 域求值 + 按目标类型低 N 位截断〔§3.7a ④
//   128→64 表达式源窄化特例〕；修前双侧静默错值分叉：宿主顶层静态读高半
//   （5/0/-6 畸形）vs v2 注入路径存地址句柄碎片〔每次运行不同栈地址〕、折叠
//   器中间值超 int64 自身 474 溢出中止）
//   形态覆盖：①静态槽（顶层/函数内/嵌套）②局部声明③窄槽截断④数组元素
//   ⑤结构体字段（声明位逐字段展开）⑥传参/返回⑦表达式直参 128 域保真
//   ⑧除法/取余/移位（128 域折叠拒→注入）⑨常量单字面量/负号壳保真⑩LL 后缀超承载。
//   双编译对照正测：宿主+v2p 同源同跑输出逐行全等（断言输出=是）。
静态 整64 顶1 = 99999999999999999999 + 0;
静态 整64 顶2 = 9999999999999999999 + 0;
静态 整64 顶3 = 99999999999999999999 + 1;
静态 整64 顶4 = 99999999999999999999 - 1;
静态 整64 顶5 = -99999999999999999999 + 0;
静态 整64 顶6 = 99999999999999999999 * 2;
静态 整64 顶7 = 99999999999999999999 + 99999999999999999999;
静态 正64 顶8 = 99999999999999999999 + 0;
静态 整128 顶9 = 99999999999999999999 + 0;
静态 整64 顶10 = 99999999999999999999 / 2;
静态 整64 顶11 = 99999999999999999999 % 7;
静态 整64 顶12 = 99999999999999999999 >> 3;
静态 整64 顶13 = 9223372036854775808LL + 0;
静态 整64 顶14 = (99999999999999999999 + 0) + 0;
常量 保1 = 99999999999999999999;
常量 保2 = -99999999999999999999;
结构体 块 {
    整64 值;
}
函数 取() -> 整64 {
    返回 99999999999999999999 + 0;
}
函数 收(整64 参) -> 空类型 {
    打印(参);
}
函数 主() -> 整32 {
    整64 变 = 1;
    静态 整64 局1 = 99999999999999999999 + 变;
    整64 局2 = 99999999999999999999 + 0;
    整64 局3 = 99999999999999999999 + 变;
    整64 局4 = 99999999999999999999 / 2;
    整32 局5 = 99999999999999999999 + 0;
    整64[2] 局6 = { 99999999999999999999 + 0, 1 };
    块 局7 = 块{ 值 = 99999999999999999999 + 0 };
    整128 保3 = 保1;
    整128 保4 = 保2;
    打印(顶1);
    打印(顶2);
    打印(顶3);
    打印(顶4);
    打印(顶5);
    打印(顶6);
    打印(顶7);
    打印(顶8);
    打印(顶9);
    打印(顶10);
    打印(顶11);
    打印(顶12);
    打印(顶13);
    打印(顶14);
    打印(局1);
    打印(局2);
    打印(局3);
    打印(局4);
    打印(局5);
    打印(局6[0]);
    打印(局7.值);
    打印(保3);
    打印(保4);
    收(99999999999999999999 + 0);
    打印(取());
    打印(99999999999999999999 + 0);
    返回 0;
}
