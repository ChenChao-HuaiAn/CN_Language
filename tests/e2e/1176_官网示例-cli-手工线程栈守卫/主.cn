外部 函数 cn_install_thread_stack_guard() -> 空类型
外部 函数 pthread_create(整64* 线程号, 空类型* 属性, 空类型(*入口)(空类型*), 空类型* 参数) -> 整32
外部 函数 pthread_join(整64 线程号, 空类型** 返回值) -> 整32

不安全 函数 线程体(空类型* 参数) -> 空类型 {
    cn_install_thread_stack_guard();   // ✱ 手工线程入口显式安装（一次）
    打印("线程运行中");
    返回;
}

不安全 函数 主() -> 整32 {
    整64 线程号 = 0;
    整32 创建 = pthread_create(&线程号, 无, 线程体, 无);
    如果 (创建 != 0) { 返回 2; }
    pthread_join(线程号, 无);
    返回 0;
}