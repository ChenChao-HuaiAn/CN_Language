// 500（559-a·T96 回归锚·m44_01 采样实弹转正）：i128 三元与变量推断全矩阵——
//   T96a=「变量 x=表达式」推断取初始化式类型（原非字面量形态静默兜底整32
//   →i128→i32 截断）；T96b=三元物化槽按语义类型分配（原硬编码 i64 单槽
//   →i128 越槽写读）；T96c=arm64 emitCopy i128 双半搬运（原落入 32 位路径
//   仅搬低半·-O3 SSA 汇合 Copy 实弹）。三缺陷任一回退=本用例 O0 或 O3 红。
// 注意：打印=println 换行语义（反直觉命名·规范口径）。
函数 挑(布尔 条, 整128 甲, 整128 乙) -> 整128 {
    返回 条 ? 甲 : 乙;
}
函数 择版(布尔 条, 整128 甲, 整128 乙) -> 整128 {
    变量 择 = 甲;
    如果 (!条) { 择 = 乙; }
    返回 择;
}
函数 主() -> 整32 {
    整128 甲 = 111111111111;
    整128 乙 = 222222222222;
    整128 局 = 真 ? 甲 : 乙;
    打印("局部三元 = ", 局);
    打印("返回三元真 = ", 挑(真, 甲, 乙));
    打印("返回三元假 = ", 挑(假, 甲, 乙));
    打印("择版真 = ", 择版(真, 甲, 乙));
    打印("择版假 = ", 择版(假, 甲, 乙));
    变量 直推 = 甲;
    打印("变量推断 = ", 直推);
    返回 0;
}
