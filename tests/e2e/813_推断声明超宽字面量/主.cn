// 813（#497 立锁 → #638 甲案翻转·2026-10-14 用户裁决「一种语言不该有歧义
// ——丙的分段有边界解释歧义」）：推断声明无后缀超宽字面量**一律编译期拒**。
//   原 497 真值域提升放行（整32 域内→整32·int64 域内→整64·超之→整128·本目录
//   旧锁面）与 T36 扩面「推断通道拒」条文互斥，随甲案废止：无后缀字面量恒定级
//   =整32，值装不下（含超 int64 巨字面量）一律拒+报错引导显式写类型（整64 甲 =
//   2147483649;·Rust `let x = 2147483649;` E0308 同款）；域内推断（戊=42）与
//   负界恰等（己=-2147483648）不误伤。显式通道正例=904_超宽字面量显式通道。
//   双编译对照负测：宿主与 v2p 同源同拒（诊断锚=双侧同文案子串）。
函数 主() -> 整32 {
    变量 甲 = 3000000000;                  // 中值·超 整32 正域 → 拒
    打印行("甲=", 甲);
    变量 乙 = 9999999999999;               // 13 位·int64 域内 → 拒（原提升整64 废止）
    打印行("乙=", 乙);
    变量 丙 = 99999999999999999999;        // 20 位巨字面量·超 整64 域 → 拒（原提升整128 废止）
    打印行("丙=", 丙);
    变量 丁 = -99999999999999999999;       // 一元负号超宽形态·负值判域超界 → 拒
    打印行("丁=", 丁);
    变量 戊 = 42;                          // 整32 域内 → 正常（既有契约不动）
    打印行("戊=", 戊);
    变量 己 = -2147483648;                 // 负界恰等 → 正常（855 同款锚）
    打印行("己=", 己);
    返回 0;
}
