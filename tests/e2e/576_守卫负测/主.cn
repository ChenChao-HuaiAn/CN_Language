// 301 负例探针：守卫增强不得放进未检查访问
导入 容器::向量;

函数 主() -> 整32 {
    向量<整64> 甲 = 向量<整64>();
    向量<整64> 乙 = 向量<整64>();
    结果<空类型, 整32> 加甲 = 甲.追加(10);
    结果<空类型, 整32> 加乙 = 乙.追加(20);
    结果<整64, 整32> 读甲 = 甲.读取(0);
    结果<整64, 整32> 读乙 = 乙.读取(0);
    如果 (读甲.正常 || 读乙.正常) {     // 或：不构成双守卫
        打印(读乙.值);
    }
    返回 0;
}
