// E2E 1074：字符串驻留（001 §10.3 驻留/驻留文本/驻留计数·进程级驻留表）
//   覆盖：① 同内容同 ID、异内容异 ID、重复驻留幂等
//         ② 驻留文本（ID 反查·借用视图）与 字符串复制（落堆拥有副本）内容一致
//         ③ 驻留计数：新内容 +1、重复驻留不变
//         ④ 驻留表进程级存活：堆副本释放后反查仍有效；内存::释放全部（堆批量回收）
//            后驻留表不释放——同内容仍同 ID、反查文本仍可达
//   双编译对照：宿主与 v2 同源码编译运行，输出逐行一致、退出码一致（0）。
函数 主() -> 整32 {
    打印("===== 字符串驻留 =====");

    // ① 同内容同 ID / 异内容异 ID / 幂等
    整64 甲 = 驻留("token");
    整64 乙 = 驻留("token");
    打印("同内容同 ID: ", 甲 == 乙);                          // 真
    打印("异内容异 ID: ", 甲 != 驻留("令牌"));                // 真
    打印("重复驻留幂等: ", 驻留("token") == 甲);              // 真

    // ② 反查：驻留文本=借用视图；字符串复制=落堆拥有副本
    字符* 视图 = 驻留文本(甲);
    字符串 副本 = 字符串复制(视图);
    打印("反查文本: ", 副本);                                 // token
    打印("视图与副本同内容: ", 字符串比较(视图, 副本));        // 真

    // ③ 计数：新内容增一、重复驻留不变
    整64 计数前 = 驻留计数();
    驻留("新增一");
    打印("新内容计数增: ", 驻留计数() == 计数前 + 1);          // 真
    驻留("新增一");
    打印("重复驻留计数不变: ", 驻留计数() == 计数前 + 1);      // 真

    // ④ 驻留表进程级存活（一）：堆副本释放后，借用视图反查仍有效
    字符串释放(副本);
    打印("释放堆副本后反查: ", 字符串比较(驻留文本(甲), "token"));   // 真

    // ④ 驻留表进程级存活（二）：内存::释放全部 批量回收堆块，驻留表不释放
    内存::释放全部();
    打印("释放全部后同内容同 ID: ", 驻留("token") == 甲);      // 真
    打印("释放全部后反查: ", 驻留文本(甲));                   // token

    打印("===== 字符串驻留测试完成 =====");
    返回 0;
}
