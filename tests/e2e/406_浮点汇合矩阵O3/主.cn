// 406 浮点汇合矩阵O3（297-a·T25 根治守护）：浮点汇合赋值（如果/否则同名单+三元）
//   经 O3 SSA 保守重写（前驱块尾 Copy）后值完整性——修复前 arm64 O3 归零（槽位 32 位截断写）。
函数 主() -> 整32
{
    整32 k = 2;
    布尔 c = 真;
    布尔 d = 假;
    浮64 a = 1.5;
    浮64 b = 2.5;
    // 三元族
    打印("h01=", (c ? 1.5 : 2.5));
    浮64 r0 = c ? 1.5 : 2.5;
    打印("h02=", r0);
    打印("h03=", (d ? 1.5 : 2.5));
    浮64 u = 3.25;
    浮64 v = 4.75;
    打印("h04=", (c ? u : v));
    打印("h06=", ((c ? 1.5 : 2.5) + 1.0));
    打印("h09=", (c ? 2.0 : 3.0) * 2.0);
    // 如果/否则 同名单汇合（修复前归零主形态）
    浮64 r1 = 0.0;
    如果 (k > 1) { r1 = a; } 否则 { r1 = b; }
    打印("k01=", r1);
    浮64 x = 0.0;
    如果 (k > 1) { x = 1.5; } 否则 { x = 2.5; }
    打印("m1=", x);
    浮64 y = 0.0;
    如果 (k > 1) { y = a; } 否则 { y = 2.5; }
    打印("m2=", y);
    // 分支内嵌三元
    浮64 r3 = 0.0;
    如果 (k > 0) { r3 = (k > 1) ? 10.5 : 20.5; } 否则 { r3 = 30.5; }
    打印("k08=", r3);
    // 浮32 汇合（穷尽面）
    浮32 f1 = 0.0f;
    如果 (k > 1) { f1 = 1.5f; } 否则 { f1 = 2.5f; }
    打印("f1=", f1);
    // 数组元素汇合
    浮64[2] arr = { 0.5, 9.5 };
    如果 (k > 1) { arr[0] = a; } 否则 { arr[0] = b; }
    打印("a0=", arr[0]);
    打印("a1=", (c ? arr[0] : arr[1]));
    返回 0;
}
