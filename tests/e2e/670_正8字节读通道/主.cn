// E2E 670_正8字节读通道（#361 清偿轮）：锁「正8 强转=无符号字节直读」行为族
// "名A" = E5 90 8D 41；229/144/141 无符号 vs -27 带符号（T48 立法锚）双面同锁
函数 主() -> 整32 {
    字符串 s = "名A";
    正8 u0 = 正8(s[0]);
    打印(u0);
    整64 w1 = 整64(正8(s[1]));
    打印(w1);
    如果 (正8(s[1]) == 144) { 打印(1); } 否则 { 打印(0); }
    整32 inAscii = 0;
    如果 (正8(s[2]) >= 32 && 正8(s[2]) <= 126) { inAscii = 1; }
    打印(inAscii);
    整32 inAscii2 = 0;
    如果 (正8(s[3]) >= 32 && 正8(s[3]) <= 126) { inAscii2 = 1; }
    打印(inAscii2);
    整8 b = s[0];
    打印(b);
    整64 总和 = 0;
    循环 (整64 k = 0; k < 3; k = k + 1) {
        总和 = 总和 + 整64(正8(s[k]));
    }
    打印(总和);
    字符串 t = 字符转字符串(s[0]) + 字符转字符串(s[1]) + 字符转字符串(s[2]);
    打印(字符串长度(t));
    返回 0;
}
