// E2E 1080（986 根治·954 呈报）：宿主引用返回调用右值消费必须发射被调 Call
//   （副作用保真）+ 返回地址取被调 Call 结果（非 lastExpr_ 最后实参残留）。
//   语义（plans/001 §3.2 引用返回）：调用必被执行；右值消费=按被引用左值解
//   引用读值。v2 侧「先发 IR_调用参数化再引用返回加载」=正确参照（零分叉）。
//   四形态（引用返回对象=参数左值——986 面）：①赋值右值消费（非恒等·返回
//   第一实参）②表达式语句（纯副作用位）③打印实参位嵌套消费（调用+运算）
//   ④恒等参照（返回最后实参——102/1012 同款恒等形态写链巧合正确，本用例
//   补非恒等实锤）。双编译对照=宿主/v2 同源码同 expected。
整32 全局计数 = 0;
整32 全局值 = 40;

不安全 函数 计数加一() {
    全局计数 = 全局计数 + 1;
}

函数 取甲(整32& 甲, 整32& 乙) -> 整32& {
    计数加一();
    打印("被调:取甲");
    返回 甲;
}

函数 取甲静默(整32& 甲, 整32& 乙) -> 整32& {
    计数加一();
    返回 甲;
}

函数 取乙(整32& 甲, 整32& 乙) -> 整32& {
    计数加一();
    打印("被调:取乙");
    返回 乙;
}

函数 主() -> 整32 {
    整32 a = 100;
    整32 b = 7;
    // 形态①：赋值右值消费（返回第一实参=非恒等——修前宿主读最后实参残留 7）
    整32 m = 取甲(a, b);
    打印("形一 m=", m);
    // 形态②：表达式语句（纯副作用位——修前宿主被调 Call 静默不发射）
    取甲(a, b);
    打印("形二 计数=", 全局计数);
    // 形态③：打印实参位嵌套消费（调用+运算——修前宿主读垃圾残留）
    打印("形三 v=", 取甲静默(a, b) + 1);
    打印("形三 计数=", 全局计数);
    // 形态④：恒等参照（返回最后实参·恒等形态）
    整32 w = 取乙(a, b);
    打印("恒等 w=", w);
    打印("总数=", 全局计数);
    返回 0;
}
