// E2E 384（256-a·F1-26 方案 A 锚定）：-O3 下 Phi 降级/使用点重写全链——
//   汇合/循环携带/嵌套/双汇合多形态，-O3 行为须与 -O0 一致（期望=逐行输出）。
函数 取较大(整32 甲, 整32 乙) -> 整32 {
    整32 结果值 = 0;
    如果 (甲 > 乙) {
        结果值 = 甲;
    } 否则 {
        结果值 = 乙;
    }
    返回 结果值;
}

函数 循环携带(整32 上限) -> 整32 {
    整32 累计 = 0;
    整32 i = 0;
    当 (i < 上限) {
        如果 (i % 2 == 0) {
            累计 = 累计 + i;
        } 否则 {
            累计 = 累计 + 1;
        }
        i = i + 1;
    }
    返回 累计;
}

函数 双汇合(整32 甲, 整32 乙) -> 整32 {
    整32 结果值 = 0;
    如果 (甲 > 乙) {
        结果值 = 甲;
    } 否则 {
        结果值 = 乙;
    }
    如果 (结果值 > 10) {
        结果值 = 结果值 - 10;
    }
    返回 结果值;
}

函数 嵌套(整32 值) -> 整32 {
    整32 输出值 = 1;
    如果 (值 > 0) {
        如果 (值 > 10) {
            输出值 = 100;
        } 否则 {
            输出值 = 50;
        }
    } 否则 {
        输出值 = 7;
    }
    返回 输出值;
}

函数 主() -> 整32 {
    打印(取较大(3, 7));
    打印(取较大(20, 9));
    打印(循环携带(10));
    打印(循环携带(7));
    打印(双汇合(15, 3));
    打印(双汇合(4, 20));
    打印(嵌套(20));
    打印(嵌套(5));
    打印(嵌套(-1));
    返回 0;
}
