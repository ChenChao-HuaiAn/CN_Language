// E2E 272（2026-09-14 第一百六十二轮 162-a A5 上下文化正测）：10 词移出保留字表后，
//   原语法形态在固定语法位置仍全部识别（语法与语义零变化；plans/024 §十）。
//   覆盖：类标签（公开:/私有:/保护:）+ 成员修饰（虚拟/重写/常量/静态）+
//   声明前缀（顶层 静态/常量、局部 静态、for-init 常量〔循环不变量形态〕）+
//   参数前缀（常量 只读引用）+ 字面量前缀（原始/多行/组合）。
//   抽象 修饰锚定于 parser 单测（AbstractClass 系）+ 22_interface 接口面；
//   模块声明位由模块用例（164/165）真形态覆盖（本用例单文件不触发模块加载）。
类 动物 {
公开:
    虚拟 函数 说话() -> 空类型 { 打印行("叫"); }
保护:
    整64 血量;
私有:
    整64 秘密;
}

类 犬 : 动物 {
公开:
    重写 函数 说话() -> 空类型 { 打印行("汪汪"); }
    静态 整64 种群计数 = 0;
    常量 函数 名号() -> 整64 { 返回 7; }
}

常量 上限 = 100;
静态 整64 全局计数 = 0;

函数 求和(常量 整64 甲, 常量 整64 乙) -> 整64 {
    返回 甲 + 乙;
}

函数 主() -> 整32 {
    变量 甲 = 原始"A\nB";
    变量 乙 = 多行"""A
B""";
    变量 丙 = 原始多行"C\nD";
    静态 整64 槽 = 0;
    整64 总 = 上限 + 全局计数 + 犬::种群计数 + 槽;
    循环 (常量 上界 = 3; 槽 < 上界; 槽 += 1) { 总 = 总 + 1; }
    犬 g;
    g.说话();
    打印行(求和(1, 2));
    打印行(总);
    返回 0;
}
