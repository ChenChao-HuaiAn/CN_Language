// 1492 循环累积别名逃逸（750 复审返工 P0-1/P0-2/P0-3·双编译对照）
//   判据①新增函数级别名逃逸扫描（宿主 beginAccumScope / v2 准备累积上下文750）：
//   引用声明绑定 s（`字符串& r = s`）/ 取地址 `&s` / 函数内任何 lambda 字面量
//   → 该函数累积提升拒绝。原语义经别名读 s=最新累积值，构建器期间 s 槽保持初值
//   （审查实证错值 5 类 + 头段读别名死循环 1 类）；本用例把三类形态分置独立函数
//   （函数级标志互不干扰）。
// 预期：别名读 [x][xx][xxx] / 指针读 <y><yy><yyy> / 头段别名 U=zzzzz 轮=5 /
//   循环内值捕获 {x}{xx}{xxx} / 循环内引用捕获写穿 S=X / lambda 先于循环
//   1=R 2=RR 3=RRLRLR（P0-1 作用域覆盖面）+ 值捕获快照 ()()()。

不安全 函数 引用形态() -> 整32 {
    字符串 s = "";
    字符串& 别名 = s;
    循环 (整64 k = 0; k < 3; k++) {
        s = s + "x";
        打印行("[", 别名, "]");
    }
    打印("");
    // 头段经别名读 s（P0-2：构建器期间 s 槽不更新=死循环防护）
    字符串 u = "";
    字符串& ur = u;
    整64 轮 = 0;
    当 (字符串长度(ur) < 5) {
        u = u + "z";
        轮 = 轮 + 1;
        如果 (轮 > 100) { 中断; }
    }
    打印("U=", u, " 轮=", 整数转字符串(轮));
    返回 0;
}

不安全 函数 指针形态() -> 整32 {
    字符串 t = "";
    字符串* p = &t;
    循环 (整64 k = 0; k < 3; k++) {
        t = t + "y";
        打印行("<", *p, ">");
    }
    打印("");
    返回 0;
}

不安全 函数 捕获形态() -> 整32 {
    // ③ 循环内 lambda 值捕获（P0-3 审查实证形态：v2 原未拒 → 每轮快照被
    //   构建器期间不更新的 s 槽污染=打印空串；修复后语义=定义处当前值）
    字符串 v = "";
    循环 (整64 k = 0; k < 3; k++) {
        v = v + "x";
        变量 读值 = [=]() { 打印行("{", v, "}"); 返回 0; };
        读值();
    }
    打印("");
    // ④ 循环内 lambda 引用捕获写穿（审查实证形态：优化后出口 finish 覆盖写穿结果
    //   s=aaa；修复后原语义=最后一轮写穿值 X）
    字符串 s = "S";
    循环 (整64 k = 0; k < 3; k++) {
        s = s + "a";
        变量 改 = [&]() { s = "X"; 返回 0; };
        改();
    }
    打印("S=", s);
    返回 0;
}

不安全 函数 lambda先于循环() -> 整32 {
    // P0-1（复审返工）：lambda 先于循环——入口 save/恢复三枚累积状态，否则
    //   lambda 体扫描结果覆盖外层，后续循环误用体内结果=错值（修复前 3=RRLL）。
    字符串 q = "";
    变量 写穿 = [&]() { q = q + "R"; 返回 0; };
    写穿();
    打印("1=", q);
    写穿();
    打印("2=", q);
    循环 (整64 k = 0; k < 2; k++) {
        q = q + "L";
        写穿();
    }
    打印("3=", q);
    // 值捕获 lambda 先于循环（快照=定义处空串，原语义逐轮打印空）
    字符串 v = "";
    变量 读 = [=]() { 打印行("(", v, ")"); 返回 0; };
    循环 (整64 k = 0; k < 3; k++) {
        v = v + "x";
        读();
    }
    打印("");
    返回 0;
}

不安全 函数 主() -> 整32 {
    引用形态();
    指针形态();
    捕获形态();
    lambda先于循环();
    返回 0;
}
