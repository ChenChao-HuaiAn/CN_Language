// CN 语言标准库：随机数模块（F2-33 标准库扩展拆分之一·252-a）
// 公开: 随机数生成器（类）/ 播种扩散（熵源混合便捷函数）
// 算法：xoshiro256++（Vigna 2019·64 位快速非加密伪随机数发生器）
//       + splitmix64 播种扩散（避免全零/近邻种子状态退化）
// 规范对齐（[01b] 位运算语义·T9 方案 D 整数溢出语义）：
//   - `>>` 有符号=算术右移（符号扩展）→ 旋转右半用掩码清除符号扩展：
//     旋转左(值, 位数) = (值 << 位数) | ((值 >> (64 - 位数)) & ((1 << 位数) - 1))
//     （位数=0 时掩码=0、右移量 64 按位宽取模≡0 后被掩码清零 → 自动正确）
//   - 移位量按操作数类型位宽取模（1 << 64 ≡ 1 << 0）
//   - 编译期常量溢出=编译错误 → splitmix64 黄金比例常数 0x9E3779B97F4A7C15
//     以其整64 两补码十进制形式书写（=-7046029254386353131，位模式相同）；
//     变量面加法=两补码回绕（本算法依赖回绕，语义符合）
//   - 非加密用途（统计模拟/游戏/测试数据生成）；密码学用途不保证
// 使用方式（v2.0 导入）：
//   导入 随机数::随机数生成器
//   随机数生成器 生成器 = 随机数生成器(42);   // 固定种子（确定性序列）
//   打印行(生成器.下一个());                  // 整64 全域
//   打印行(生成器.下一个范围(10));            // [0, 上限)
//   打印行(生成器.下一个浮点());              // [0.0, 1.0)
//   导入 随机数::随机播种生成器               // 便捷：时间播种（非确定性）

公开:

类 随机数生成器 {
    整64 状态0;
    整64 状态1;
    整64 状态2;
    整64 状态3;

公开:
    函数 随机数生成器(整64 种子) {
        自身.播种(种子);
    }

    // splitmix64 四轮扩散播种（标准形态：状态黄金常数步进 + 终端混合；
    //   近邻种子经步进+混合后扩散远离，避免全零/近邻状态退化）
    函数 播种(整64 种子) {
        整64 黄金步进 = -7046029254386353131;    // 0x9E3779B97F4A7C15 的整64 两补码
        整64 x = 种子;
        x = x + 黄金步进;
        状态0 = 自身.扩散混合(x);
        x = x + 黄金步进;
        状态1 = 自身.扩散混合(x);
        x = x + 黄金步进;
        状态2 = 自身.扩散混合(x);
        x = x + 黄金步进;
        状态3 = 自身.扩散混合(x);
    }

    // 下一个：xoshiro256++ 输出（整64 全域·含负值=两补码位模式）
    函数 下一个() -> 整64 {
        整64 输出值 = 自身.旋转左(状态0 + 状态3, 17);
        输出值 = 输出值 + 状态0;
        整64 t = 状态1 << 17;
        状态2 = 状态2 ^ 状态0;
        状态3 = 状态3 ^ 状态1;
        状态1 = 状态1 ^ 状态2;
        状态0 = 状态0 ^ 状态3;
        状态2 = 状态2 ^ t;
        状态3 = 自身.旋转左(状态3, 45);
        返回 输出值;
    }

    // 下一个范围：[0, 上限) 均匀整64（先清符号位取 63 位非负再取模）
    // 偏差注明：取模法在 上限 不整除 2^63 时有极轻低值偏差（非加密用途可接受；
    //   拒绝采样精化=后续项）
    函数 下一个范围(整64 上限) -> 整64 {
        整64 值 = 自身.下一个();
        整64 非负 = 值 & 9223372036854775807;    // 0x7FFFFFFFFFFFFFFF 清符号位
        返回 非负 % 上限;
    }

    // 下一个浮点：[0.0, 1.0) 均匀浮64（高 53 位 × 2^-53·IEEE 754 精确）
    函数 下一个浮点() -> 浮64 {
        整64 值 = 自身.下一个();
        整64 尾数 = (值 >> 11) & 9007199254740991;    // 0x000FFFFFFFFFFFFF=2^53-1
        返回 尾数 * 1.0 / 9007199254740992.0;          // 2^53
    }

    // 旋转左：算术右移半段用掩码清符号扩展（[01b] `>>` 有符号=算术右移）
    函数 旋转左(整64 值, 整64 位数) -> 整64 {
        整64 左半 = 值 << 位数;
        整64 右半 = (值 >> (64 - 位数)) & ((1 << 位数) - 1);
        返回 左半 | 右半;
    }

    // 扩散混合：splitmix64 终端函数（z ^= z>>30; z *= C1; z ^= z>>27; z *= C2; z ^= z>>31）
    函数 扩散混合(整64 z) -> 整64 {
        z = z ^ (z >> 30);
        z = z * -4658895280553007687;     // 0xBF58476D1CE4E5B9 的整64 两补码形式
        z = z ^ (z >> 27);
        z = z * -7723592293110705685;     // 0x94D049BB133111EB 的整64 两补码形式
        z = z ^ (z >> 31);
        返回 z;
    }
}

// 播种扩散便捷：熵源混合（调用方：生成器.播种(播种扩散(时间戳))——Rust SeedableRng 同构；
//   熵源建议=时间::当前时间戳() * 质数 + 高分辨率计数，宿主程序按需组合）
函数 播种扩散(整64 熵源) -> 整64 {
    返回 熵源 * 1099511628211 + -7046029254386353131;    // 质数乘+黄金常数回绕扩散
}
