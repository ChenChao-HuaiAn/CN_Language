// 872：寄存器分配直写多族计算锁面用例（369 波1·2026-10-13）
// 覆盖发射器直写接入族：整型乘法（imul 直写）、比较六向+逻辑组合（setcc/movzx
//   结果直写）、指针访存（LoadPtr 结果直写/StorePtr 值直读）、类型转换高频通道
//   （i32↔i64/窄宽扩展/i1 零扩展）、串字段地址（lea 直达）——多活跃变量+跨块
//   活跃压线性扫描分配器（-O2 启用），断言各指令族直写形态下语义不变。
// 双编译对照通道：宿主/v2 两侧输出一致（双侧同构锁·AGENTS 零分叉红线）。

结构体 档案 {
    整64 编号;
    字符串 名称;
}

函数 计算(整64 甲, 整64 乙) -> 整64 {
    整64 和 = 甲 * 3 + 乙;
    整64 差 = 和 - 乙 / 2;
    整64 余 = 差 % 7;
    返回 和 + 差 + 余;
}

// 指针访存族须在 不安全 函数 内（安全区边界 §5.2·裸指针解引用写/指针算术）——
//   函数边界不削弱压分配器意图：函数内仍多活跃变量+跨块活跃。
不安全 函数 指针访存段(整64 活) {
    整64[4] 数组 = { 11, 22, 33, 44 };
    整64* 指 = &数组[0];
    *指 = 111;
    指 = 指 + 2;
    打印(*指);
    *指 = *指 + 活;
    打印(数组[2]);
    打印(数组[0]);
}

函数 主() -> 整32 {
    // ---- 算术族：乘法直写+除余+多活跃链 ----
    // 计算(10,4)：和=34·差=32·余=4 -> 70
    整64 值1 = 计算(10, 4);
    打印(值1);

    // ---- 比较族：六向比较+逻辑组合+跨块活跃 ----
    整64 活 = 100;
    如果 (值1 > 60 && 值1 < 80) {
        活 = 活 + 值1;
    } 否则 {
        活 = 活 - 1;
    }
    打印(活);
    布尔 相等 = 值1 == 70;
    布尔 不等 = 值1 != 70;
    布尔 序比 = 值1 >= 70 && 70 <= 值1;
    如果 (相等) { 打印(1); }
    如果 (不等) { 打印(1); } 否则 { 打印(0); }
    如果 (序比) { 打印(1); }

    // ---- 指针访存族：数组指针 LoadPtr/StorePtr+指针算术（不安全 函数 内） ----
    指针访存段(活);

    // ---- 转换族：i32<->i64/窄宽扩展/i1 零扩展 ----
    整32 窄 = -5;
    整64 宽 = 窄;
    打印(宽);
    整8 微 = 7;
    整64 微宽 = 微;
    打印(微宽);
    整64 布尔宽 = 整64(相等);  // i1→i64 显式转换（零扩展直写通道）
    打印(布尔宽);

    // ---- 串字段地址族：结构体整型字段+字符串字段 ----
    档案 一份;
    一份.编号 = 900;
    一份.名称 = "测试";
    打印(一份.编号);
    打印(一份.名称);
    一份.编号 = 一份.编号 + 45;
    打印(一份.编号);

    // ---- 移位/位运算族（既有直写形态回归面） ----
    整64 移 = 1;
    移 = 移 << 10;
    打印(移);
    整64 位 = 12 & 10;
    打印(位);
    位 = 12 | 10;
    打印(位);
    位 = 12 ^ 10;
    打印(位);

    返回 0;
}
