// E2E 1592（#1683·2026-10-27）：结果/可选 声明初值=三元构造器（双编译对照）
// 病面（修前 v2）：可选<整64> 果 = 选 ? 某些(11) : 某些(22);
//   → v2 [ir2]「合成体初值/赋值源类型无法解析: 可选$整64」（宿主 check/run 通过·
//   存量实证=修复前 v2p 同报，非 #1666 引入）。同类字段位三元（仓.选=条件?某些:某些）
//   修前已通过——IR 对合成体三元双分支按 结果大小 整块搬运的声明位缺口。
// 锁面（位折累加，任一面丢失=对照失败）：
//   ①某些/某些 双分支（真选取真支）…1+2
//   ②假选反向分支（取假支）…4
//   ③结果<T,E> 同理 正常/错误 双分支（受检纪律：否则 分支显式处理）…8+16
//   ④三元字段位对照锚（修前 v2 已通过·防回归）…32
// 形态规避说明：某些/无 双分支（选 ? 某些(33) : 无）=宿主侧类型不一致拒
//   （无 推为 空类型*·已立项另治），本用例不纳入（保持双侧共有多态）。
结构体 持仓 {
    可选<整64> 选;
}
函数 主() -> 整32 {
    整32 累计 = 0;
    布尔 选 = 真;

    // ① 某些/某些 双分支（声明初值=三元构造器·修前 v2 [ir2] 中止面）
    可选<整64> 果 = 选 ? 某些(11) : 某些(22);
    如果 (果.有值) {
        累计 = 累计 + 1;
        如果 (果.值 == 11) { 累计 = 累计 + 2; }
    }

    // ② 假选反向分支（取假支）
    布尔 假选 = 假;
    可选<整64> 空 = 假选 ? 某些(33) : 某些(44);
    如果 (空.有值) {
        如果 (空.值 == 44) { 累计 = 累计 + 4; }
    }

    // ③ 结果<T,E> 同理（受检纪律：正常/错误 两分支都处理）
    结果<整64, 整32> 成 = 选 ? 正常(44) : 错误(5);
    如果 (成.正常) {
        累计 = 累计 + 8;
        如果 (成.值 == 44) { 累计 = 累计 + 16; }
    } 否则 {
        累计 = 累计 + 0;
    }

    // ④ 三元字段位对照锚（修前已通过）
    持仓 仓;
    仓.选 = 选 ? 某些(55) : 某些(66);
    如果 (仓.选.有值) {
        如果 (仓.选.值 == 55) { 累计 = 累计 + 32; }
    }

    打印("累计: ", 累计);
    返回 0;
}
