// 官网文档示例 · reference/index.html · 全貌（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
导入 容器::向量;
导入 核心::{最大};

枚举 状态 { 空, 就绪, 完成 = 100 }

结构体 任务 {
    字符串 名;
    整64 工时;
    状态 态;
}

泛型 <类型 T>
函数 总工时(向量<T>& 表) -> 整64 { 返回 表.大小(); }

类 工程师 {
私有:
    字符串 名字;
公开:
    函数 工程师(字符串 名) { 名字 = 名; }
    函数 报告(整64 完成数) -> 空类型 {
        打印(名字 + " 完成 " + 整数转字符串(完成数) + " 项");
    }
}

函数 主() -> 整32 {
    向量<任务> 板 = 向量<任务>();
    结果<空类型, 整32> 加 = 板.追加(任务{名 = "文档", 工时 = 8, 态 = 状态.完成});
    工程师 张三 = 工程师("张三");
    张三.报告(最大<整64>(板.大小(), 1));
    返回 0;
}