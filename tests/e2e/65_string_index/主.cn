// E2E 65_string_index：字符串[i] 逐字节 O(1) 访问（自举前置 A-1，2026-08）
// 覆盖：UTF-8 字节视图下标、循环逐字节扫描、下标与 整32/整64 转换、越界由
//   调用方按 字符串长度 约束（C 的 s[i] 语义）
// 语法依据：plans/004 缺口 A-1 + specs/02 字符串（UTF-8 字节视图）
函数 主() -> 整32 {
    打印("===== 字符串[i] 逐字节访问 =====")
    字符串 s = "ABC"
    字符 c0 = s[0]
    字符 c1 = s[1]
    字符 c2 = s[2]
    打印("字节0:", 整32(c0))
    打印("字节1:", 整32(c1))
    打印("字节2:", 整32(c2))

    // 逐字节扫描求和（UTF-8 多字节字符 你好 = 6 字节）
    字符串 中文 = "你好"
    整64 总和 = 0
    整64 i = 0
    当 (i < 字符串长度(中文)) {
        总和 += 整64(中文[i])
        i++
    }
    打印("UTF8字节数:", 字符串长度(中文))
    打印("字节和:", 总和)

    // 成员字符串字段下标（结构体）
    记录 名片 = 记录 { 标题 = s }
    字符 t0 = 名片.标题[0]
    打印("字段字节0:", 整32(t0))

    // 与整64 下标混用
    整64 索引 = 2
    打印("整64下标:", 整32(s[索引]))
    返回 0
}
结构体 记录 {
    字符串 标题
}
