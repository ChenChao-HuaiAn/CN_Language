// D25（471-a）：ast_printer 节点触达语料——`cn ast` 打印锚定（结构体声明/
//   构造字面量/数组声明与初始化列表/下标/二元运算/打印调用/返回）。
//   完整形态版（类构造/泛型调用/循环/选择/三元）触发非确定段错误=T71 立案
//   （tests/cnsmith_hits/run_err/t71_组合段错误_复现语料.cn·待根治后扩形态）。
结构体 盒子 {
    整32 值;
}
泛型 <类型 T> 函数 挑(T 源) -> T {
    返回 源;
}
函数 主() -> 整32 {
    变量 盒 = 盒子 { 值 = 42 };
    整32[3] arr = { 1, 2, 3 };
    变量 首项 = 挑<整32>(arr[0]);
    打印(盒.值 + 首项);
    返回 0;
}
