// E2E 721（#439·#276 捕获族残余面收口）：lambda 体内内置函数/类型转换调用
//   不捕获——001「lambda 表达式」捕获语义=只捕获**变量**：打印/打印行 等内置
//   函数与 整64() 等类型转换被调名不是变量非捕获项；体内声明局部变量（声明位
//   与引用位）亦非外层捕获项（宿主 collectLambdaCaptures 在 pushScope 前收集
//   ·lookupVar 只认外层已声明变量=全部天然排除）。
//   428 后残余面实录：v2 token 级隐式收集器把 打印行/整64/体内声明名 误收捕获
//   →「lambda 捕获的变量 '打印行' 未声明」整编译拒绝（440 i128 间接调用族
//   dual 化被此卡）。
// 打印=println 语义（换行）·打印行=print 语义（不换行）——001 Task 2.9。
// 期望：10 / 9 / 30 / 42 / 尾（打印逐行·尾不换行由 打印("") 收行）
函数 主() -> 整32 {
    变量 基数 = 5;
    变量 加倍加 = [=]() -> 整32 {
        整64 倍 = 整64(基数) * 2;      // 转换被调名 整64 不捕获·基数 值捕获
        打印(倍);                       // 内置函数 打印 不捕获·倍 体内声明引用位不捕获
        返回 整32(倍);                  // 转换被调名 整32 同面
    };
    加倍加();                           // 10
    变量 回显 = [&]() -> 整32 {
        打印(整64(基数 + 4));          // [&] 形态·嵌套转换调用
        返回 0;
    };
    回显();                             // 9
    变量 延迟 = []() -> 整32 {
        变量 局部 = 30;                // 体内声明名（声明位+引用位）不捕获
        打印(局部);
        返回 局部;
    };
    延迟();                             // 30
    打印(整64(42));                    // 对照组：体外内置转换调用
    变量 静默 = []() -> 整32 {
        打印行("尾");                   // 打印行（print 语义）同面
        返回 0;
    };
    静默();
    打印("");                           // 收行
    返回 0;
}
