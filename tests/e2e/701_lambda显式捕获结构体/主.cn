// 701_lambda显式捕获结构体（#276 波1·001「lambda 表达式」[变量] 值捕获·结构体快照面）
// 结构体值捕获=定义处深拷快照：定义后修改外部字段，闭包读旧值（宿主
//   __capstruct 临时+CopyStruct 同语义·spec 04-一D 值捕获=捕获时复制）。
结构体 点 {
    整32 x
    整32 y
}

函数 主() -> 整32 {
    变量 p = 点{ x = 1, y = 2 };
    变量 取x = [p]() -> 整32 { 返回 p.x; };
    p.x = 100;
    p.y = 200;
    打印(取x());                      // 1（深拷快照·非 100）
    返回 0;
}
