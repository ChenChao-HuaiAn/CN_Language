// E2E 821（#444 锁用例·双编译对照）：赋值语句面 类对象重载产物——
//   `甲 = 乙 + 丙`（甲=已声明类变量·乙+丙=返回类对象的重载表达式）。
//   背景（414 审查遗留·724c0b68 后提及即立项）：声明初始化面（盒 和 = 乙 + 丙）
//   已修（生成类对象局部 414 分支：产物 NewObject+句柄入槽·340/25/92 已绿）；
//   赋值语句面未覆盖未验证——v2 原落通用 8 字节句柄直存：把聚合返回 retbuf
//   栈临时地址存进变量槽 → 块出口按堆句柄 free 栈地址（free(): invalid size）
//   或字段读经栈地址段错误（探针双侧实证 rc=139）；宿主侧值正确但覆盖旧值时
//   旧对象（连同资源字段）不释放=泄漏（残留 +1·095「覆盖前 drop 旧值」族面
//   未覆盖重载产物右值）。双侧根治后语义：产物句柄接管（产物=被调方
//   NewObject 新对象·无别名）+ 覆盖前旧值释放（Rust drop 语义）。
//   八形态（校验和折位·每形态 残留==0 且内容正确）：
//     ①局部面赋值 甲 = 乙 + 丙（旧值释放）…………………位1
//     ②同变量多次赋值（第二次起逐次旧值释放）……………位2
//     ③自用右值 甲 = 甲 + 乙（先求值后释放·防 UAF）……位4
//     ④静态面 全局甲 = 全局乙 + 全局丙（不安全函数）…位8
//     ⑤容器字段类（向量<字符串>·暴露泄漏/UAF）…………位16
//     ⑥声明面对照 盒 和 = 乙 + 丙（414 面防回归）………位32
//     ⑦单目重载产物赋值 甲 = -乙（UnaryExpr 面）………位64
//     ⑧自赋值防护 甲 = 甲（值语义恒无副作用）…………位128
//   判据：宿主与 v2 输出一致 + 退出码 255=全位 + 无泄漏无崩溃。
导入 容器::向量;
类 盒 {
公开:
    整32 值;
    字符串 名;
    函数 盒(整32 v, 字符串 n) { 值 = v; 名 = n; }
    函数 ~盒() { }
    不安全 函数 盒(盒& 其他) { 值 = 其他.值; 名 = 字符串复制(其他.名); }
    函数 运算符+(盒 右) -> 盒 {
        返回 盒(值 + 右.值, 字符串复制(名));
    }
    函数 运算符-() -> 盒 {
        返回 盒(0 - 值, 字符串复制(名));
    }
}
类 货架 {
公开:
    向量<字符串> 记录;
    函数 货架() { 记录 = 向量<字符串>(); }
    函数 ~货架() { }
    不安全 函数 货架(货架& 其他) { 记录 = 其他.记录; }
    函数 运算符+(货架 右) -> 货架 {
        货架 新 = 货架();
        结果<空类型, 整32> a = 新.记录.追加(字符串复制("合"));
        整32 i = 0;
        当 (i < 右.记录.大小()) {
            结果<空类型, 整32> b = 新.记录.追加(字符串复制(右.记录.元素(i)));
            i++;
        }
        返回 新;
    }
}
静态 盒 全局甲 = 盒(0, 字符串复制("甲"));
静态 盒 全局乙 = 盒(2, 字符串复制("乙"));
静态 盒 全局丙 = 盒(3, 字符串复制("丙"));
// ④ 静态面（静态写在 不安全 函数内·语义纪律）：返回本次赋值净残留
//   （期望 0=运算符+内新串 +1 与旧值释放 -1 相抵；旧值不释放=+1）
不安全 函数 静态面() -> 整64 {
    整64 基 = 内存::活动分配数();
    全局甲 = 全局乙 + 全局丙;
    返回 内存::活动分配数() - 基;
}
函数 主() -> 整32 {
    整32 校验 = 0;
    // ① 局部面赋值（含堆串字段·旧值释放）
    整64 b1 = 内存::活动分配数();
    整32 内1 = 0;
    {
        盒 乙 = 盒(2, 字符串复制("乙"));
        盒 丙 = 盒(3, 字符串复制("丙"));
        盒 甲 = 盒(0, 字符串复制("甲"));
        甲 = 乙 + 丙;
        内1 = 甲.值;
    }
    如果 (内1 == 5 && 内存::活动分配数() - b1 == 0) { 校验 = 校验 + 1; }
    // ②③⑧ 多次赋值 / 自用右值 / 自赋值（同一变量连续覆盖·每步旧值释放）
    整64 b2 = 内存::活动分配数();
    整32 内2 = 0;
    整32 内3 = 0;
    整32 内8 = 0;
    {
        盒 乙 = 盒(2, 字符串复制("乙"));
        盒 丙 = 盒(3, 字符串复制("丙"));
        盒 甲 = 盒(0, 字符串复制("甲"));
        甲 = 乙 + 丙;          // 第一次（5）
        甲 = 丙 + 丙;          // ②第二次（6·第一次产物旧值释放）
        内2 = 甲.值;
        甲 = 甲 + 乙;          // ③自用右值（8·先求值后释放）
        内3 = 甲.值;
        甲 = 甲;               // ⑧自赋值（值语义恒无副作用·甲 仍 8）
        内8 = 甲.值;
    }
    如果 (内2 == 6 && 内存::活动分配数() - b2 == 0) { 校验 = 校验 + 2; }
    如果 (内3 == 8 && 内存::活动分配数() - b2 == 0) { 校验 = 校验 + 4; }
    如果 (内8 == 8 && 内存::活动分配数() - b2 == 0) { 校验 = 校验 + 128; }
    // ⑦ 单目重载产物赋值（UnaryExpr 面）
    整64 b7 = 内存::活动分配数();
    整32 内7 = 0;
    {
        盒 乙 = 盒(2, 字符串复制("乙"));
        盒 甲 = 盒(0, 字符串复制("甲"));
        甲 = -乙;
        内7 = 甲.值;
    }
    如果 (内7 == 0 - 2 && 内存::活动分配数() - b7 == 0) { 校验 = 校验 + 64; }
    // ⑤ 容器字段类（向量<字符串>·赋值面·暴露容器资源泄漏/UAF）
    整64 b5 = 内存::活动分配数();
    整64 内5 = 0;
    {
        货架 乙 = 货架();
        结果<空类型, 整32> r1 = 乙.记录.追加(字符串复制("乙一"));
        货架 甲 = 货架();
        结果<空类型, 整32> r2 = 甲.记录.追加(字符串复制("甲一"));
        甲 = 乙 + 乙;
        内5 = 甲.记录.大小();
    }
    如果 (内5 == 2 && 内存::活动分配数() - b5 == 0) { 校验 = 校验 + 16; }
    // ⑥ 声明面对照（414 面·防回归）
    整64 b6 = 内存::活动分配数();
    整32 内6 = 0;
    {
        盒 乙 = 盒(2, 字符串复制("乙"));
        盒 丙 = 盒(3, 字符串复制("丙"));
        盒 和 = 乙 + 丙;
        内6 = 和.值;
    }
    如果 (内6 == 5 && 内存::活动分配数() - b6 == 0) { 校验 = 校验 + 32; }
    // ④ 静态面（净残留==0 折位）
    整64 残4 = 静态面();
    如果 (残4 == 0) { 校验 = 校验 + 8; }
    打印(内1);
    打印(内2);
    打印(内3);
    打印(内8);
    打印(内7);
    打印(内5);
    打印(内6);
    打印(全局甲.值);
    打印(校验);
    返回 校验;
}
