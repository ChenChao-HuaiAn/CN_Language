// 官网文档示例 · reference/lexical.html · 语句终止（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
结构体 点 {
    整32 x
    整32 y
}                     // 结构体体 } 自终结（不加分号）

函数 主() -> 整32 {
    变量 a = 1; 变量 b = 2;        // 单行多语句
    如果 a == 1 { 变量 t = 5; a = t; }   // 行内块内部同样须分号
    打印("a: ", a, " b: ", b);
    返回 0;
}