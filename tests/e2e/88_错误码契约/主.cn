// E2E 88_错误码契约：验证规格书 07 附录 B 错误码契约（1..8）
// 覆盖：
//  ① 错误码 -> 含义 映射表（规格书附录B：1=除零、2=数组越界、3=空指针解引用、
//     4=内存分配失败、5=文件打开失败、6=无效参数、7=资源未初始化、8=溢出）
//  ② 结果<T,E> 错误码载体：错误(码) -> .错误 精确回读（验证码值契约往返）
//  ③ 边界位宽：错误码以 整32 表示，逐码断言 1..8 全覆盖
// 说明（运行期边界）：
//  - 运行时真正触发陷阱（除零/数组越界/空指针 -> 运行时错误(N)）由运行时层终止进程
//    （io_api.cpp __cn_runtime_error 打印 运行时错误(...) 后 exit(1)），退出码非零，
//    会被运行器判失败；故本正例不触发会终止进程的陷阱，改以 结果<T,E> 错误(码) 载体
//    + 契约映射表 稳定覆盖 1..8 码值；陷阱类触发由单测/运行时层覆盖。

// 错误码 -> 含义 契约表（规格书07 附录B）
函数 错误码含义(整32 码) -> 字符串 {
    选择 (码) {
        情况 1: 返回 "除零错误"
        情况 2: 返回 "数组越界"
        情况 3: 返回 "空指针解引用"
        情况 4: 返回 "内存分配失败"
        情况 5: 返回 "文件打开失败"
        情况 6: 返回 "无效参数"
        情况 7: 返回 "资源未初始化"
        情况 8: 返回 "溢出"
        默认: 返回 "未知错误码"
    }
}

// 通过 结果<T,E> 载体构造指定错误码（错误(码) -> .错误 精确回读）
函数 包装错误(整32 码) -> 结果<整32, 整32> {
    返回 错误(码)
}

函数 覆盖错误码(整32 码) -> 空类型 {
    结果<整32, 整32> 载体 = 包装错误(码)
    如果 (载体.正常) {
        打印("错误码", 码, ": 载体异常（应为错误分支）")
    } 否则 {
        打印("错误码", 码, ": ", 错误码含义(码), "（错误码值=", 载体.错误, "）")
    }
}

函数 主() -> 整32 {
    打印("===== 错误码契约（规格书07 附录B）=====")
    打印("错误码共 8 类：1=除零 2=数组越界 3=空指针 4=内存分配")
    打印("           5=文件打开 6=无效参数 7=资源未初始化 8=溢出")
    打印("----------------------------------------")

    整32 覆盖数 = 0
    整32 码 = 1
    当 (码 <= 8) {
        覆盖错误码(码)
        覆盖数++
        码++
    }

    打印("----------------------------------------")
    打印("契约覆盖统计：共覆盖 ", 覆盖数, " 条错误码")

    // 边界：错误码值往返断言（错误(码).错误 == 码，验证码值契约）
    结果<整32, 整32> 除零 = 包装错误(1)
    结果<整32, 整32> 溢出 = 包装错误(8)
    如果 (除零.正常) {
        打印("除零码往返: 失败")
    } 否则 {
        打印("除零码往返: 错误(1).错误=", 除零.错误, " ✓")
    }
    如果 (溢出.正常) {
        打印("溢出码往返: 失败")
    } 否则 {
        打印("溢出码往返: 错误(8).错误=", 溢出.错误, " ✓")
    }

    打印("===== 错误码契约验证完成 =====")
    返回 0
}
