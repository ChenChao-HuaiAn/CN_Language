// 官网文档示例 · reference/lexical.html · 源文件（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
函数 主() -> 整32 {
    打印("参数个数≥1: ", 系统::参数个数() >= 1);   // 真（argv[0]=可执行文件名）
    字符* 程序名 = 系统::参数(0);
    如果 (程序名 != 无) {
        打印("argv[0]非空: ", 字符串长度(程序名) > 0);  // 真
    }
    字符* 越界 = 系统::参数(99);
    如果 (越界 == 无) {
        打印("越界参数=无");                        // 越界返回 无
    }
    返回 0;
}