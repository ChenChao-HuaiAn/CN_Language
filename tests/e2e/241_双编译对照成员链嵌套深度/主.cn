// E2E 241（2026-09-12 第八十四轮后续，plans/020 移植纪律 9 门禁化·第十二个对照用例）：
//   **成员链嵌套深度（三级及以上）**——同一份源码经宿主真实管线与 v2 自举链各编译
//   运行，两侧退出码须相等。
//   背景（84-d，探针 P29/P30）：**宿主** `visitMemberExpr` 的对象类型推导只手写
//   「一层嵌套」（inner->object 须为标识符）→ 三级链 `丙.d.b.a` 的 objSrcType 退化空
//   → decl==nullptr → **字段读降级常量 0**（静默错行为：三级链读 0、二级/一级正常；
//   数据正确性级）。修复=以既有递归辅助 `memberObjStructType`（成员链任意深度 + 下标
//   + 指针剥离 + 结果/可选映射）在 objSrcType 空时兜底（Rust 对照：rustc 字段访问按
//   base 类型递归解析 field.ty()）。v2 侧类型推导天然递归（本用例两侧锚定）。
//   八形态（两侧共有语义面）：
//     ① 三级链逐字段写读（`丙.d.b.a = 1;` → 读 1）
//     ② 三级嵌套字面量（声明位）
//     ③ 三级嵌套字面量（实参位）
//     ④ 三级链多字段（a/c/e 组合）
//     ⑤ 三级链 + 字符串字段（深 A 层带串）
//     ⑥ 二级/一级对照（回归）
//     ⑦ 循环 20 万轮（三级字面量 + 读）
//     ⑧ 混合（三级 + 二级 + 一级同函数）
//   校验和折位：①1 ②2 ③4 ④8 ⑤16 ⑥32 ⑦64 ⑧128 —— 255=全对。
//   修复前宿主实测 ①②③④⑦⑧ 位丢失（字段读 0）；任一侧退回「一层推导」→ 校验位
//   丢失 → 退出码变化 → 对照失败。平台守卫=linux 双平台。
结构体 深A {
    整64 a;
}
结构体 深B {
    深A b;
    整64 c;
}
结构体 深C {
    深B d;
    整64 e;
}
结构体 串A {
    字符串 名;
}
结构体 串B {
    串A b;
    整64 c;
}
结构体 串C {
    串B d;
    整64 e;
}

函数 收深(深C 箱) -> 整64 {
    返回 箱.d.b.a + 箱.d.c + 箱.e;
}

函数 收串(串C 箱) -> 整64 {
    如果 (!字符串比较(箱.d.b.名, "E241三级串内容甲乙丙丁戊己庚")) { 返回 0; }
    返回 箱.d.c + 箱.e;
}

// ① 三级链逐字段写读
函数 形一() -> 整64 {
    整64 校验 = 0;
    {
        深C 丙;
        丙.d.b.a = 1;
        丙.d.c = 2;
        丙.e = 3;
        如果 (丙.d.b.a == 1 && 丙.d.c == 2 && 丙.e == 3) { 校验 = 1; }
        如果 (收深(丙) == 6) { 校验 = 校验 + 1; }
    }
    如果 (校验 == 2) { 返回 1; }
    返回 0;
}

// ② 三级嵌套字面量（声明位）
函数 形二() -> 整64 {
    整64 校验 = 0;
    {
        深C 丙 = 深C{ d = 深B{ b = 深A{ a = 11 }, c = 22 }, e = 33 };
        如果 (丙.d.b.a == 11 && 丙.d.c == 22 && 丙.e == 33) { 校验 = 1; }
        如果 (收深(丙) == 66) { 校验 = 校验 + 1; }
    }
    如果 (校验 == 2) { 返回 2; }
    返回 0;
}

// ③ 三级嵌套字面量（实参位）
函数 形三() -> 整64 {
    整64 校验 = 0;
    {
        如果 (收深(深C{ d = 深B{ b = 深A{ a = 41 }, c = 42 }, e = 43 }) == 126) { 校验 = 1; }
        深C 丙 = 深C{ d = 深B{ b = 深A{ a = 41 }, c = 42 }, e = 43 };
        如果 (丙.d.b.a == 41) { 校验 = 校验 + 1; }
    }
    如果 (校验 == 2) { 返回 4; }
    返回 0;
}

// ④ 三级链多字段组合
函数 形四() -> 整64 {
    整64 校验 = 0;
    {
        深C 丙;
        丙.d.b.a = 100;
        丙.d.c = 200;
        丙.e = 300;
        如果 (丙.d.c == 200 && 丙.e == 300 && 丙.d.b.a == 100) { 校验 = 1; }
        深C 乙 = 深C{ d = 深B{ b = 深A{ a = 100 }, c = 200 }, e = 300 };
        如果 (收深(乙) == 600) { 校验 = 校验 + 1; }
    }
    如果 (校验 == 2) { 返回 8; }
    返回 0;
}

// ⑤ 三级链 + 字符串字段
函数 形五() -> 整64 {
    整64 校验 = 0;
    {
        串C 丙 = 串C{ d = 串B{ b = 串A{ 名 = 字符串复制("E241三级串内容甲乙丙丁戊己庚") }, c = 5 }, e = 6 };
        如果 (收串(丙) == 11) { 校验 = 1; }
        串C 乙;
        乙.d.b.名 = 字符串复制("E241三级串内容甲乙丙丁戊己庚");
        乙.d.c = 5;
        乙.e = 6;
        如果 (收串(乙) == 11) { 校验 = 校验 + 1; }
    }
    如果 (校验 == 2) { 返回 16; }
    返回 0;
}

// ⑥ 二级/一级对照（回归）
函数 形六() -> 整64 {
    整64 校验 = 0;
    {
        深B 二级 = 深B{ b = 深A{ a = 7 }, c = 8 };
        如果 (二级.b.a == 7 && 二级.c == 8) { 校验 = 1; }
        深A 一级 = 深A{ a = 9 };
        如果 (一级.a == 9) { 校验 = 校验 + 1; }
    }
    如果 (校验 == 2) { 返回 32; }
    返回 0;
}

// ⑦ 循环 20 万轮（三级字面量 + 读）
函数 形七(整64 轮数) -> 整64 {
    整64 i = 0;
    当 (i < 轮数) {
        深C 每轮 = 深C{ d = 深B{ b = 深A{ a = 7 }, c = 8 }, e = 9 };
        如果 (每轮.d.b.a != 7) { 返回 0; }
        如果 (收深(每轮) != 24) { 返回 0; }
        i++;
    }
    返回 64;
}

// ⑧ 混合（三级 + 二级 + 一级同函数）
函数 形八() -> 整64 {
    整64 校验 = 0;
    {
        深C 级三;
        级三.d.b.a = 2;
        级三.d.c = 3;
        级三.e = 4;
        深B 级二;
        级二.b.a = 5;
        级二.c = 6;
        深A 级一;
        级一.a = 7;
        如果 (级三.d.b.a == 2 && 级三.d.c == 3 && 级三.e == 4) { 校验 = 校验 + 1; }
        如果 (级二.b.a == 5 && 级二.c == 6) { 校验 = 校验 + 1; }
        如果 (级一.a == 7) { 校验 = 校验 + 1; }
    }
    如果 (校验 == 3) { 返回 128; }
    返回 0;
}

函数 主() -> 整32 {
    整64 和 = 0;
    和 = 和 + 形一();
    和 = 和 + 形二();
    和 = 和 + 形三();
    和 = 和 + 形四();
    和 = 和 + 形五();
    和 = 和 + 形六();
    和 = 和 + 形七(200000);
    和 = 和 + 形八();
    返回 整32(和);
}
