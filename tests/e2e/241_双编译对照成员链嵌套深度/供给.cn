// E2E 241 符号供给（v2 自举链）：深A/深B/深C + 串A/串B/串C 实例化（含各层局部与
//   成员链读写 → 生成所需符号）
结构体 深A { 整64 a; }
结构体 深B { 深A b; 整64 c; }
结构体 深C { 深B d; 整64 e; }
结构体 串A { 字符串 名; }
结构体 串B { 串A b; 整64 c; }
结构体 串C { 串B d; 整64 e; }

函数 供给深() -> 整64 {
    深A 一级 = 深A{ a = 1 };
    深B 二级 = 深B{ b = 深A{ a = 1 }, c = 2 };
    深C 三级 = 深C{ d = 深B{ b = 深A{ a = 1 }, c = 2 }, e = 3 };
    深C 逐字段;
    逐字段.d.b.a = 1;
    逐字段.d.c = 2;
    逐字段.e = 3;
    返回 一级.a + 二级.b.a + 三级.d.b.a + 逐字段.e;
}

函数 供给串() -> 整64 {
    串A 一级 = 串A{ 名 = 字符串复制("供串一") };
    串B 二级 = 串B{ b = 串A{ 名 = 字符串复制("供串二") }, c = 2 };
    串C 三级 = 串C{ d = 串B{ b = 串A{ 名 = 字符串复制("供串三") }, c = 2 }, e = 3 };
    串C 逐字段;
    逐字段.d.b.名 = 字符串复制("供串四");
    逐字段.d.c = 2;
    逐字段.e = 3;
    返回 字符串长度(一级.名) + 字符串长度(二级.b.名) + 字符串长度(三级.d.b.名) + 字符串长度(逐字段.d.b.名);
}

函数 主() -> 整32 {
    返回 整32(供给深() + 供给串());
}
