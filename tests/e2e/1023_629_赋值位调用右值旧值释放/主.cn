// E2E 1023（2026-10-17 任务629）：赋值位类对象右值旧值释放——
//   「甲 = 返回类对象的调用/构造」覆盖含资源旧值（629 探针矩阵：宿主原
//   残留 +2=泄漏，v2 已释放=对齐方向）。
//   断言面：
//     ① 变量 ← 方法调用（甲 = 仓.产()）
//     ② 变量 ← 构造调用（甲 = 货架()）
//   两形态循环 50 次，分配数差值净 0 断言 + 覆盖后内容断言（防假绿：
//   新值真物化、旧值真释放）。
//   校验和折位：①1 ②2 —— 退出码 3=全对；任一泄漏=差值非 0=校验位丢失。
导入 容器::向量;

类 货架 {
公开:
    向量<字符串> 记录;
    函数 货架() { 记录 = 向量<字符串>(); }
    函数 ~货架() { }
    不安全 函数 货架(货架& 其他) { 记录 = 其他.记录; }
}

类 主仓 {
公开:
    函数 主仓() { }
    函数 产() -> 货架 {
        货架 临时;
        结果<空类型, 整32> r = 临时.记录.追加(字符串复制("覆盖位新资源载荷"));
        返回 临时;
    }
}

// ① 变量位 ← 方法调用（甲 = 仓.产()）
函数 形一() -> 整64 {
    整64 前 = 内存::活动分配数();
    主仓 仓;
    整64 轮 = 0;
    当 (轮 < 50) {
        货架 甲;
        结果<空类型, 整32> r1 = 甲.记录.追加(字符串复制("变量位旧资源载荷"));
        甲 = 仓.产();
        如果 (甲.记录.大小() != 1) { 返回 0; }
        轮++;
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 1;
}

// ② 变量位 ← 构造调用（甲 = 货架()）
函数 形二() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 轮 = 0;
    当 (轮 < 50) {
        货架 甲;
        结果<空类型, 整32> r1 = 甲.记录.追加(字符串复制("构造位旧资源载荷"));
        甲 = 货架();
        如果 (甲.记录.大小() != 0) { 返回 0; }
        轮++;
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 2;
}

函数 主() -> 整32 {
    整64 校验和 = 形一() + 形二();
    如果 (校验和 == 3) {
        打印("赋值位类对象旧值释放：变量位调用/构造全通过");
    } 否则 {
        打印("赋值位类对象旧值释放：失败");
    }
    返回 整32(校验和);
}
