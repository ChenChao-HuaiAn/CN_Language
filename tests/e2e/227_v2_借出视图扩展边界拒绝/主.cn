// E2E 227（2026-09-12 第七十七轮后续，plans/020 矩阵 A21 格扩展）：
//   **借出视图扩展边界拒绝**（宿主负测：期望编译失败，诊断锚「借出视图」）。
//   边界①（调用点同源互斥，跨函数别名窄面）：同一调用中「容器 C」与其借出视图
//   实参并存 → 拒绝。探针 A 实证 UAF：`帮忙改(表, 借出)` 被调函数删除元素后
//   调用方的借出视图读取内容损坏（长度 3 vs 期望 13）——CN 容器形参=借用（共享
//   句柄），编译器无法知道被调者是否修改容器 → 保守拒绝（Rust 借用检查器对
//   `f(&mut v, &v[0])` 同类拒绝）。
//   边界②（成员链接收者）：`架.表.元素(0)` 借出、`架.表.删除(0)` 失效、
//   借出视图再用 = UAF（探针 B 实证：长度 3 vs 期望 13）；容器引用键=
//   基础名.成员路径（`架.表`）。
导入 容器::向量;

// 边界① 形态：借出视图与容器同时作为实参传入
函数 帮忙改(向量<字符串> 表, 字符串 视图) -> 整32 {
    结果<空类型, 整32> 删 = 表.删除(0);
    如果 (!删.正常) { 返回 0; }
    返回 整32(字符串长度(视图));
}

函数 形态一跨函数别名() -> 整32 {
    向量<字符串> 表 = 向量<字符串>();
    结果<空类型, 整32> 加 = 表.追加(字符串复制("形态一元素甲乙丙丁戊己庚辛壬癸"));
    如果 (!加.正常) { 返回 0; }
    字符串 借出 = 表.元素(0);
    返回 帮忙改(表, 借出);
}

// 边界② 形态：成员链接收者（类字段持容器）
类 货架 {
公开:
    向量<字符串> 表;
    函数 货架() {
        表 = 向量<字符串>();
    }
    函数 装(字符串 值) -> 空类型 {
        结果<空类型, 整32> 加 = 表.追加(值);
        如果 (!加.正常) { 运行时错误(4); }
    }
}

函数 形态二成员链() -> 整32 {
    货架 架 = 货架();
    架.装(字符串复制("形态二元素甲乙丙丁戊己庚辛壬癸"));
    字符串 借出 = 架.表.元素(0);
    结果<空类型, 整32> 删 = 架.表.删除(0);
    如果 (!删.正常) { 返回 0; }
    返回 整32(字符串长度(借出));
}

函数 主() -> 整32 {
    返回 形态一跨函数别名() + 形态二成员链();
}
