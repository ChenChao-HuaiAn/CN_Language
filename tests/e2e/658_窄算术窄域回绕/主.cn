// E2E 658（285 轮·窄算术保持窄域+回绕·p1007_05 转正）：001 §3.7a 甲案——
//   同宽窄整数（整8/整16）二元算术（+ - * / %）结果保持操作数宽度·溢出两
//   补码回绕（127+1≡-128·-128-1≡127·32767+1≡-32768）；字面量按另一侧窄
//   类型参与（§3.7 推导面落实）；容器元素窄域（向量<整8> 追加(200) 读回
//   -56）。宿主原「窄算术提升整32+赋回拒绝」修正（修=语义推导面字面量窄
//   参与+实参位窄字面量回绕豁免 canConvertArgNarrow；发射层窄槽回绕零改动
//   ——既有窄槽存回截断 asm 实证）；v2 窄域回绕=零改动锚（五值逐值一致）。
//   T36 保留面：声明位字面量值域检查不动（整16 甲=40000 拒仍在）。
//   ⚠ 自增/复合赋值面不在本用例（001 §3.7a 只盖二元算术五操作符——v2 自
//   增提升整32 vs 宿主回绕=新分叉立 #310·dual 实证 32768 vs -32768）。
导入 容器::向量;

函数 主() -> 整32 {
    整8 a = 127;
    整8 b = a + 1;
    打印("回绕=", b);
    整8 c = -128;
    整8 d = c - 1;
    打印("下溢=", d);
    整16 e = 32767;
    整16 f = e + 1;
    打印("16回绕=", f);
    向量<整8> 窄表 = 向量<整8>();
    结果<空类型, 整32> r1 = 窄表.追加(100);
    结果<空类型, 整32> r2 = 窄表.追加(200);
    打印("窄0=", 窄表.元素(0));
    打印("窄1=", 窄表.元素(1));
    返回 0;
}
