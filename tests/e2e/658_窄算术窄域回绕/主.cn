// E2E 658（285 轮·窄算术保持窄域+回绕·p1007_05 转正）：001 §3.7a 甲案——
//   **#474 立法翻转（2026-10-11 用户裁决乙案：变量面溢出=错误码 8 确定性失败）**：
//   原「同宽窄整数二元算术结果保持操作数宽度·溢出两补码回绕（127+1≡-128·
//   -128-1≡127·32767+1≡-32768）」随 001 §3.7a #474 条文废除——窄域保持窄域
//   （#285）口径不变，溢出处置由回绕改**错误码 8 确定性失败**。
//   原三触发形态处置（单触发点原则）：127+1 整8 加=722 同构锚；32767+1 整16 加
//   触发形态随翻转面移交（回绕值 -32768 等价面=731 回绕加(32767,1)）；本用例保留
//   **-128-1 整8 减下溢**触发收尾（减法窄域下溢无独立新锚·本用例承载）。
//   存续职责=①窄域二元算术**域内**零误伤对照（整8/整16 上界）+②容器元素窄域
//   窄化通路（向量<整8> 追加域外字面量 200 静默窄化读回 -56——窄化转换维持静默
//   截断·#474 不涉及·宿主实测锚）+③整8 减下溢错误码 8 收尾。
//   T36 保留面：声明位字面量值域检查不动（整16 甲=40000 拒仍在·503 锚）。
//   双编译对照：宿主与 v2 同源同测——输出逐行一致 + 退出码一致（1=溢出终止）。
导入 容器::向量;

函数 主() -> 整32 {
    // ① 域内零误伤对照（窄域二元算术·域内上界）
    整8 a = 100;
    整8 b = a + 27;            // 127 整8 域内上界（健康）
    打印("域内=", 整32(b));
    整16 e = 32766;
    整16 f = e + 1;            // 32767 整16 域内上界（健康）
    打印("16域内=", 整32(f));
    // ② 容器元素窄域窄化通路（域外字面量实参静默窄化·非算术溢出）
    向量<整8> 窄表 = 向量<整8>();
    结果<空类型, 整32> r1 = 窄表.追加(100);
    结果<空类型, 整32> r2 = 窄表.追加(200);
    打印("窄0=", 窄表.元素(0));   // 100（域内原值）
    打印("窄1=", 窄表.元素(1));   // -56（200 窄化截断·保留面）
    // ③ 首个溢出形态（原锚第二位）：整8 减下溢 -128-1 → 错误码8 终止
    整8 c = -128;
    整8 d = c - 1;             // → 运行时错误(错误码8): 溢出错误 终止
    打印("下溢=", 整32(d));
    返回 0;
}
