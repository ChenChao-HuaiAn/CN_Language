// E2E 1517_连接链融合生存期交互（任务 1218·2026-10-23·双编译对照锁用例）：
//   #728o（宿主）/ #749（v2）把 `甲+乙+丙+…`（段数≥3）融合为
//   「新建缓冲 -> 逐段追加 -> 完成」一趟构建（宿主 ir_expr_concat.cpp
//   genStringConcatChain / v2 生成表达式连接.cn 生成连接链）。融合改变链上
//   临时串的生存期结构：原逐节路径每「+」产出一个中间串（k 段 = k-1 个中间
//   串），融合路径只有 finish 产物一个拥有串（段拥有临时=调用返回串，追加后
//   即结算释放）。本用例锁「生存期交互」：
//   ①链尾对象析构：段=自由函数调用，函数体内两个局部类对象（构造顺序甲→乙）
//     ——函数出口 LIFO 析构（乙→甲），析构打印序 + 次数 + 段拥有串临时追加后
//     结算（活动分配数 1=终串）由 .expected 与数值断言双层锁死。
//     注：方法调用接收者临时形态（`记号(1).取串()`）在 v2 融合链不结算段拥有
//     串（#1572/#1573），双侧不一致=另行立案，本用例不锁定该缺陷行为。
//   ②链中 lambda 捕获：值捕获快照 / 引用捕获（读最新）/ 引用捕获写穿——链段
//     读到捕获体当时的串内容与拥有性（不悬垂、不双释）。
//     【P1-1 审查返工】lambda `返回 捕获串` 走 A2 返回位借用未复制（#1571 根因）
//     ——返回的是借用视图而非拥有副本，故「次数差」1/1/2 是缺陷耦合值，本用例
//     已删除该三处次数打印/断言，不作为基线（修复 #1571 后本用例不因次数变化
//     转红）。不得改为 字符串复制（会撞 #1578 functor 链段净泄）。
//   ③链实参传入容器暂存（向量<字符串>.追加(链)）——【P1-2 审查返工】只锁
//     拼接曲线差（保守-融合 次数差=1/字节差=3）+ 追加→清空→块出口两段释放
//     降幅（各 1）；「结果串所有权转移给容器元素」的绝对分配数属 #1574 的 v2
//     参数拷贝口径差异，待修复后补 `次融==2` 双侧断言（本用例不放宽/不固化）。
//   ④分配曲线：同长度融合链 vs 保守路径 vs 2 段（原路径）vs 8 段长链 vs
//     数值混链——融合=1 次 tracked 分配（finish 产物·len+1 字节），原路径=
//     k-1 次中间串；数值转换产物 append 后即释（次数/字节/活动数逐值锁定）。
//     保守基线依赖现状「三元不作链最左端点=不融合」（P2-3）：若未来链端点
//     判定纳入三元、融合覆盖扩大，保守基线同步修改。
//   ⑤消费位释放点：语句位丢弃（融合产物 __cn_strbuf_finish 纳入拼接产物判定
//     集）/ 打印实参 / 赋值位——活动分配数差值恒 0（1083/1026 同款口径）。
//     语句位形态同时校验段函数副作用（造串序=12），防整句被消除仍绿（P2-2）。
//   ⑥段临时释放时点（P2-1 审查新增）：段函数求值时的活动分配数探针——
//     融合 观1=0/观2=0（段0/1 先求值后统一 append，段1 求值时无链中临时）；
//     保守 观3=0/观4=1（段2 求值时内层 concat 中间串仍在链）。
//   已知缺陷边界（均不期望红·本用例不锁定其行为）：
//     #1571 字符串返回位借用未复制（字段/捕获串返回=借用句柄）；
//     #1572 原逐节路径 617 判据不认方法调用返回拥有串（保守路径净泄）；
//     #1573 v2 自由函数返回类对象作方法接收者崩溃（retbuf 值语义当句柄）；
//     #1574 v2 容器追加字符串参数深拷且链实参无结算（内存账分叉）；
//     #1575 类临时实参析构缺失（宿主+v2 同源）；
//     #1578 functor 变量被调返回拥有串作链段净泄（宿主+v2 同源·保守不结算）；
//     #1579 functor 变量调用作调用实参：宿主内部错误「返回类型未登记」/v2 正常。
//   断言口径：数值断言=打印 `判 名=1/0` 行（0 行出现即失败计数）+ 内存账
//   逐值打印（.expected 锁死；宿主/v2 任一侧漂移=双编译对照红）。内存查询值
//   一律先落局部再打印/断言（P2-5：防未来打印路径引入 tracked 分配假红）。
//   dual 通道=双编译对照.txt（宿主+v2 同源码各编各跑，退出码+输出逐行一致）；
//   汇编断言.txt 锚定融合真实发生（两侧 __cn_strbuf_new >= 12）。

导入 容器::向量;

静态 整64 失败数_ = 0;
静态 整64 造串序_ = 0;
静态 整64 观基_ = 0;
静态 整64 观阶段_ = 0;
静态 整64 观1_ = 0;
静态 整64 观2_ = 0;
静态 整64 观3_ = 0;
静态 整64 观4_ = 0;

不安全 函数 判(布尔 条件, 字符串 名) {
    如果 (条件) {
        打印("判 ", 名, "=1");
    } 否则 如果 (!条件) {
        打印("判 ", 名, "=0");
        失败数_ = 失败数_ + 1;
    }
}

// ---------- 形态一：链尾对象析构（段函数局部对象 LIFO） ----------
类 记号 {
公开:
    整64 号;
    函数 记号(整64 n) { 号 = n; }
    不安全 函数 ~记号() { 打印("析构", 号); }
}

// 段函数：函数体两个局部类对象（甲先构造、乙后构造）→ 函数出口 LIFO 析构
//   （乙→甲）；返回 "S"+序号=拥有串（返回位拼接产物·调用方接管）。
不安全 函数 段串(整64 n) -> 字符串 {
    记号 甲 = 记号(n);
    记号 乙 = 记号(n + 10);
    打印("段", n);
    返回 "S" + 整数转字符串(n);
}

不安全 函数 形一融合() -> 整32 {
    整64 基 = 内存::活动分配数();
    整64 次0 = 内存::总分配次数();
    字符串 链 = "A" + 段串(1) + 段串(2) + 段串(3);
    整64 次差 = 内存::总分配次数() - 次0;
    整64 活差 = 内存::活动分配数() - 基;
    打印("形一 值=", 链);
    打印("形一 次数差=", 次差);
    打印("形一 活差=", 活差);
    判(字符串比较(链, "AS1S2S3"), "形一 值");
    判(次差 == 7, "形一 次数差");
    判(活差 == 1, "形一 语句位活差");
    字符串释放(链);
    整64 释后活差 = 内存::活动分配数() - 基;
    打印("形一 释后活差=", 释后活差);
    判(释后活差 == 0, "形一 释后归零");
    返回 0;
}

// ---------- 形态二：链中 lambda 捕获 ----------
不安全 函数 形二值捕获() -> 整32 {
    // 值捕获快照：闭包定义处深拷（#940 语义）；源重赋值后链段读旧快照。
    // P1-1：不锁次数差（lambda 返回捕获串=借用未复制·#1571 根因）。
    字符串 源 = 字符串复制("快照");
    变量 取值 = [源]() -> 字符串 { 返回 源; };
    源 = 字符串复制("改后");
    整64 基 = 内存::活动分配数();
    字符串 链 = "P" + "Q" + 取值();
    整64 活差 = 内存::活动分配数() - 基;
    打印("形二值 值=", 链);
    打印("形二值 活差=", 活差);
    判(字符串比较(链, "PQ快照"), "形二值 快照读旧");
    判(活差 == 1, "形二值 语句位活差");
    字符串释放(链);
    整64 释后活差 = 内存::活动分配数() - 基;
    打印("形二值 释后活差=", 释后活差);
    判(释后活差 == 0, "形二值 释后归零");
    返回 0;
}

不安全 函数 形二引用捕获() -> 整32 {
    // 引用捕获：读最新值（706 语义）；链段取到重赋值后的串。
    字符串 引 = 字符串复制("旧");
    变量 取引 = [&]() -> 字符串 { 返回 引; };
    引 = 字符串复制("新");
    整64 基 = 内存::活动分配数();
    字符串 链 = "P" + "Q" + 取引();
    整64 活差 = 内存::活动分配数() - 基;
    打印("形二引 值=", 链);
    打印("形二引 活差=", 活差);
    判(字符串比较(链, "PQ新"), "形二引 读最新");
    判(活差 == 1, "形二引 语句位活差");
    字符串释放(链);
    整64 释后活差 = 内存::活动分配数() - 基;
    打印("形二引 释后活差=", 释后活差);
    判(释后活差 == 0, "形二引 释后归零");
    返回 0;
}

不安全 函数 形二引用写穿() -> 整32 {
    // 引用捕获写穿：lambda 体内重赋捕获串（=2 段拼接=原路径）并返回；
    //   链段读新值。释放点：体内旧值释放、链段取到返回串、结果归链。
    字符串 引 = 字符串复制("旧");
    变量 改 = [&]() -> 字符串 { 引 = 引 + "!"; 返回 引; };
    整64 基 = 内存::活动分配数();
    字符串 链 = "P" + "Q" + 改();
    整64 活差 = 内存::活动分配数() - 基;
    打印("形二写 值=", 链);
    打印("形二写 引=", 引);
    打印("形二写 活差=", 活差);
    判(字符串比较(链, "PQ旧!"), "形二写 值");
    判(字符串比较(引, "旧!"), "形二写 写穿");
    判(活差 == 1, "形二写 语句位活差");
    字符串释放(链);
    整64 释后活差 = 内存::活动分配数() - 基;
    打印("形二写 释后活差=", 释后活差);
    判(释后活差 == 0, "形二写 释后归零");
    返回 0;
}

// ---------- 形态三：链实参传入容器暂存 ----------
不安全 函数 造串(整64 n) -> 字符串 {
    造串序_ = 造串序_ * 10 + n;   // P2-2：段求值副作用（防语句整句消除假绿）
    返回 "临时" + 整数转字符串(n);
}

// 三组容器暂存形态（同函数内依次测量·曲线差值=双侧一致口径）：
//   融合 3 段 / 保守 3 段（三元左端点）/ 临时段 3 段（2 个调用返回串）。
不安全 函数 形三曲线() -> 整32 {
    布尔 真值 = 真;
    整64 基 = 内存::活动分配数();
    // ---- 融合 3 段 ----
    整64 次0 = 内存::总分配次数();
    整64 字0 = 内存::总分配字节();
    整64 次融 = 0;
    整64 字融 = 0;
    整64 活融 = 0;
    整64 活融清 = 0;
    {
        向量<字符串> 表 = 向量<字符串>();
        结果<空类型, 整32> 加 = 表.追加("P" + "Q" + "R");
        次融 = 内存::总分配次数() - 次0;
        字融 = 内存::总分配字节() - 字0;
        活融 = 内存::活动分配数() - 基;
        打印("形三融 大小=", 表.大小());
        打印("形三融 元素=", 表.元素(0));
        判(加.正常, "形三融 追加正常");
        判(表.大小() == 1, "形三融 大小");
        判(字符串比较(表.元素(0), "PQR"), "形三融 元素值");
        表.清空();
        活融清 = 内存::活动分配数() - 基;
    }
    整64 活融外 = 内存::活动分配数() - 基;
    整64 降清 = 活融 - 活融清;
    整64 降外 = 活融清 - 活融外;
    打印("形三融 追加→清空降=", 降清);
    打印("形三融 清空→块外降=", 降外);
    判(降清 == 1, "形三融 元素释放降幅");
    判(降外 == 1, "形三融 数据释放降幅");
    // ---- 保守 3 段（三元左端点 -> 原逐节路径）----
    整64 次1 = 内存::总分配次数();
    整64 字1 = 内存::总分配字节();
    整64 次保 = 0;
    整64 字保 = 0;
    {
        向量<字符串> 表 = 向量<字符串>();
        结果<空类型, 整32> 加 = 表.追加((真值 ? "P" : "X") + "Q" + "R");
        次保 = 内存::总分配次数() - 次1;
        字保 = 内存::总分配字节() - 字1;
        判(加.正常, "形三保 追加正常");
        判(表.大小() == 1, "形三保 大小");
        判(字符串比较(表.元素(0), "PQR"), "形三保 元素值");
        表.清空();
    }
    整64 次差融保 = 次保 - 次融;
    整64 字差融保 = 字保 - 字融;
    打印("形三 保守-融合 次数差=", 次差融保);
    打印("形三 保守-融合 字节差=", 字差融保);
    判(次差融保 == 1, "形三 保守比融合多 1 次（中间串 2-1）");
    判(字差融保 == 3, "形三 保守比融合多 3 字节（3+4-4）");
    // ---- 临时段 3 段（段拥有临时结算 + 容器转移）----
    整64 次2 = 内存::总分配次数();
    整64 次临 = 0;
    整64 活临 = 0;
    整64 活临清 = 0;
    {
        向量<字符串> 表 = 向量<字符串>();
        结果<空类型, 整32> 加 = 表.追加(造串(1) + "+" + 造串(2));
        次临 = 内存::总分配次数() - 次2;
        活临 = 内存::活动分配数() - 基;
        判(加.正常, "形三临 追加正常");
        判(表.大小() == 1, "形三临 大小");
        判(字符串比较(表.元素(0), "临时1+临时2"), "形三临 元素值");
        表.清空();
        活临清 = 内存::活动分配数() - 基;
    }
    整64 活临外 = 内存::活动分配数() - 基;
    整64 次差临融 = 次临 - 次融;
    整64 降临清 = 活临 - 活临清;
    整64 降临外 = 活临清 - 活临外;
    打印("形三临 比融合多分配次数=", 次差临融);
    打印("形三临 追加→清空降=", 降临清);
    打印("形三临 清空→块外降=", 降临外);
    判(次差临融 == 4, "形三临 比融合多 4 次（2×(from_int+concat)）");
    判(降临清 == 1, "形三临 元素释放降幅");
    判(降临外 == 1, "形三临 数据释放降幅");
    返回 0;
}

// ---------- 形态四：分配曲线（融合 vs 保守 vs 2 段） ----------
不安全 函数 形四曲线() -> 整32 {
    布尔 真值 = 真;
    整64 基 = 内存::活动分配数();
    // 融合 4 段（字面量）：finish 一次 tracked 分配（len+1=5 字节）；
    //   缓冲 new/增长为 runtime 直 malloc（不计入 tracked 账）。
    整64 次0 = 内存::总分配次数();
    整64 字0 = 内存::总分配字节();
    字符串 融4 = "P" + "Q" + "R" + "S";
    整64 次差4 = 内存::总分配次数() - 次0;
    整64 字差4 = 内存::总分配字节() - 字0;
    整64 活差4 = 内存::活动分配数() - 基;
    打印("形四融4 值=", 融4);
    打印("形四融4 次数=", 次差4);
    打印("形四融4 字节=", 字差4);
    打印("形四融4 活=", 活差4);
    判(字符串比较(融4, "PQRS"), "形四融4 值");
    判(次差4 == 1, "形四融4 次数");
    判(字差4 == 5, "形四融4 字节");
    判(活差4 == 1, "形四融4 活");
    字符串释放(融4);
    整64 释4 = 内存::活动分配数() - 基;
    打印("形四融4 释后活=", 释4);
    判(释4 == 0, "形四融4 释后归零");
    // 保守 4 段（三元左端点 -> 原逐节）：3 次 concat（3+4+5=12 字节）。
    整64 次1 = 内存::总分配次数();
    整64 字1 = 内存::总分配字节();
    字符串 保4 = (真值 ? "P" : "X") + "Q" + "R" + "S";
    整64 次差保4 = 内存::总分配次数() - 次1;
    整64 字差保4 = 内存::总分配字节() - 字1;
    整64 活差保4 = 内存::活动分配数() - 基;
    打印("形四保4 值=", 保4);
    打印("形四保4 次数=", 次差保4);
    打印("形四保4 字节=", 字差保4);
    打印("形四保4 活=", 活差保4);
    判(字符串比较(保4, "PQRS"), "形四保4 值");
    判(次差保4 == 3, "形四保4 次数");
    判(字差保4 == 12, "形四保4 字节");
    判(活差保4 == 1, "形四保4 活");
    字符串释放(保4);
    整64 释保4 = 内存::活动分配数() - 基;
    打印("形四保4 释后活=", 释保4);
    判(释保4 == 0, "形四保4 释后归零");
    // 2 段（链长<3 -> 原路径一次 concat）。
    整64 次2 = 内存::总分配次数();
    整64 字2 = 内存::总分配字节();
    字符串 两2 = "P" + "Q";
    整64 次差两2 = 内存::总分配次数() - 次2;
    整64 字差两2 = 内存::总分配字节() - 字2;
    打印("形四两2 值=", 两2);
    打印("形四两2 次数=", 次差两2);
    打印("形四两2 字节=", 字差两2);
    判(字符串比较(两2, "PQ"), "形四两2 值");
    判(次差两2 == 1, "形四两2 次数");
    判(字差两2 == 3, "形四两2 字节");
    字符串释放(两2);
    整64 释两2 = 内存::活动分配数() - 基;
    判(释两2 == 0, "形四两2 释后归零");
    // 融合 8 段：仍只 1 次 finish（len+1=9），中间串零累积。
    整64 次3 = 内存::总分配次数();
    整64 字3 = 内存::总分配字节();
    字符串 融8 = "A" + "B" + "C" + "D" + "E" + "F" + "G" + "H";
    整64 次差融8 = 内存::总分配次数() - 次3;
    整64 字差融8 = 内存::总分配字节() - 字3;
    打印("形四融8 值=", 融8);
    打印("形四融8 次数=", 次差融8);
    打印("形四融8 字节=", 字差融8);
    判(字符串比较(融8, "ABCDEFGH"), "形四融8 值");
    判(次差融8 == 1, "形四融8 次数");
    判(字差融8 == 9, "形四融8 字节");
    字符串释放(融8);
    整64 释融8 = 内存::活动分配数() - 基;
    判(释融8 == 0, "形四融8 释后归零");
    // 数值混链 5 段（整+布尔转换产物 append 后即释）：from_int/from_bool
    //   各 1 次 + finish 1 次；字节=产物(3+4)+终串(10)。
    整64 次4 = 内存::总分配次数();
    整64 字4 = 内存::总分配字节();
    字符串 混5 = "n=" + 42 + "|" + 真 + "!";
    整64 次差混5 = 内存::总分配次数() - 次4;
    整64 字差混5 = 内存::总分配字节() - 字4;
    打印("形四混5 值=", 混5);
    打印("形四混5 次数=", 次差混5);
    打印("形四混5 字节=", 字差混5);
    判(字符串比较(混5, "n=42|真!"), "形四混5 值");
    判(次差混5 == 3, "形四混5 次数");
    判(字差混5 == 17, "形四混5 字节");
    字符串释放(混5);
    整64 释混5 = 内存::活动分配数() - 基;
    判(释混5 == 0, "形四混5 释后归零");
    返回 0;
}

// ---------- 形态五：链结果消费位释放点 ----------
不安全 函数 形五消费位() -> 整32 {
    // A 语句位丢弃（融合产物）：语句位拼接产物判定集含 __cn_strbuf_finish
    //   （82c736031）——发射后即释，活动分配数归零；同时校验段求值副作用
    //   （造串序=12），防整句被消除仍绿（P2-2）。
    整64 基 = 内存::活动分配数();
    造串序_ = 0;
    造串(1) + "-" + 造串(2);
    整64 活A = 内存::活动分配数() - 基;
    打印("形五A 语句位活差=", 活A);
    打印("形五A 段序=", 造串序_);
    判(活A == 0, "形五A 语句位归零");
    判(造串序_ == 12, "形五A 两段各求值一次");
    // B 打印实参（融合链结果）：调用发射后实参拥有临时统一结算。
    整64 基2 = 内存::活动分配数();
    打印("形五B 打印=", "x" + "y" + 造串(3));
    整64 活B = 内存::活动分配数() - 基2;
    打印("形五B 打印活差=", 活B);
    判(活B == 0, "形五B 打印位归零");
    // C 打印实参（2 段原路径对照）。
    整64 基3 = 内存::活动分配数();
    打印("形五C 打印=", "x" + 造串(4));
    整64 活C = 内存::活动分配数() - 基3;
    打印("形五C 打印活差=", 活C);
    判(活C == 0, "形五C 打印位归零");
    // D 赋值位（融合结果接管）：旧值释放 + 新值入槽，活动分配数净 0。
    整64 基D = 内存::活动分配数();
    字符串 位 = "旧";
    整64 基4 = 内存::活动分配数();
    位 = "m" + "n" + 造串(5);
    整64 活D = 内存::活动分配数() - 基4;
    打印("形五D 值=", 位);
    打印("形五D 赋值活差=", 活D);
    判(字符串比较(位, "mn临时5"), "形五D 值");
    判(活D == 0, "形五D 赋值位归零");
    字符串释放(位);
    整64 释D = 内存::活动分配数() - 基D;
    打印("形五D 释后活差=", 释D);
    判(释D == 0, "形五D 释后归零");
    返回 0;
}

// ---------- 形态六：段临时释放时点（P2-1 审查新增） ----------
// 段函数求值时的活动分配数探针：观阶段=1（融合）/2（保守），n=1/2 分别记录。
//   融合：段0/1 先求值后统一 append，段1 求值时无链中临时（观1=0）；
//        段1 追加后即释，段2 求值时亦无（观2=0）。
//   保守：段1 求值时无（观3=0）；段1/段2 concat 中间串在链，段2 求值时=1
//        （观4=1）。
不安全 函数 观段(整64 n) -> 字符串 {
    整64 观 = 内存::活动分配数() - 观基_;
    如果 (观阶段_ == 1 && n == 1) { 观1_ = 观; }
    否则 如果 (观阶段_ == 1 && n == 2) { 观2_ = 观; }
    否则 如果 (观阶段_ == 2 && n == 1) { 观3_ = 观; }
    否则 如果 (观阶段_ == 2 && n == 2) { 观4_ = 观; }
    否则 如果 (观阶段_ < 1 || 观阶段_ > 2 || n < 1 || n > 3) { 运行时错误(4); }
    返回 "S" + 整数转字符串(n);
}

不安全 函数 形六段时点() -> 整32 {
    布尔 真值 = 真;
    // 融合 3 段（段1/段2 为探针）
    观1_ = 0;
    观2_ = 0;
    观3_ = 0;
    观4_ = 0;
    观基_ = 内存::活动分配数();
    观阶段_ = 1;
    字符串 融 = "A" + 观段(1) + 观段(2);
    打印("形六融 观1=", 观1_);
    打印("形六融 观2=", 观2_);
    判(字符串比较(融, "AS1S2"), "形六融 值");
    判(观1_ == 0, "形六融 段1 求值时活动分配=0");
    判(观2_ == 0, "形六融 段2 求值时活动分配=0");
    字符串释放(融);
    // 保守 3 段（三元左端点 -> 原逐节；段1/段2 为探针）
    观基_ = 内存::活动分配数();
    观阶段_ = 2;
    字符串 保 = (真值 ? "A" : "X") + 观段(1) + 观段(2);
    打印("形六保 观3=", 观3_);
    打印("形六保 观4=", 观4_);
    判(字符串比较(保, "AS1S2"), "形六保 值");
    判(观3_ == 0, "形六保 段1 求值时活动分配=0");
    判(观4_ == 1, "形六保 段2 求值时活动分配=1（中间串在链）");
    字符串释放(保);
    返回 0;
}

不安全 函数 主() -> 整32 {
    形一融合();
    形二值捕获();
    形二引用捕获();
    形二引用写穿();
    形三曲线();
    形四曲线();
    形五消费位();
    形六段时点();
    如果 (失败数_ == 0) {
        打印("1517 连接链融合生存期交互 全部通过");
        返回 0;
    } 否则 如果 (失败数_ != 0) {
        打印("1517 连接链融合生存期交互 失败数=", 失败数_);
        返回 1;
    }
    返回 1;
}
