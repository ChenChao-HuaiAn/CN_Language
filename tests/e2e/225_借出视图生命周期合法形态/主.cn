// E2E 225（2026-09-12 第七十七轮，plans/020 矩阵 A21 格靶子）：
//   **借出视图生命周期·合法形态**（宿主正测：不得误报——与 223/224 负测对仗的
//   「零误伤」防线，覆盖 NLL 顺序近似的合法性边界）。
//   八形态折校验和（255=①1+②2+③4+④8+⑤16+⑥32+⑦64+⑧128 全对）：
//     ①立即消费（借出不绑定变量，修改点在后）；
//     ②显式 字符串复制 取拥有副本后容器修改（副本独立）；
//     ③借出→消费→容器修改（活跃区间已结束，NLL 正确）；
//     ④借出后容器修改但不使用借出（无悬垂读取）；
//     ⑤非字符串元素容器（向量<整64>）：元素()=值语义深拷贝，非借用面；
//     ⑥结果变量借出后「消费再修改容器」（.值 使用在失效点之前）；
//     ⑦扩容类修改点（追加触发重新分配）后同一借出继续用——字符串句柄指向
//       独立堆块，槽位搬移不使其失效（C++ vector 迭代器失效语义在 CN 收窄为
//       「串释放」事实；探针 77-2 形态②校验位 1 实证内容完好）；
//     ⑧循环内每轮重新借出（每轮消费后再修改，下一轮重建借出）；
//   另含「借出视图变量未被误判为拥有」断言（内存::活动分配数 差值：借出不释放）。
导入 核心::内存;
导入 容器::向量;
导入 IO::打印;

// ① 立即消费
函数 形态一() -> 整64 {
    整64 校验 = 0;
    向量<字符串> 表 = 向量<字符串>();
    结果<空类型, 整32> 加 = 表.追加(字符串复制("形态一元素甲乙丙丁戊己庚辛壬癸"));
    如果 (!加.正常) { 返回 0; }
    如果 (字符串比较(表.元素(0), "形态一元素甲乙丙丁戊己庚辛壬癸")) { 校验 = 校验 + 1; }
    结果<空类型, 整32> 删 = 表.删除(0);
    如果 (!删.正常) { 返回 0; }
    返回 校验;
}

// ② 显式复制（拥有副本）后容器修改
函数 形态二() -> 整64 {
    整64 校验 = 0;
    向量<字符串> 表 = 向量<字符串>();
    结果<空类型, 整32> 加 = 表.追加(字符串复制("形态二元素甲乙丙丁戊己庚辛壬癸"));
    如果 (!加.正常) { 返回 0; }
    字符串 副本 = 字符串复制(表.元素(0));
    结果<空类型, 整32> 删 = 表.删除(0);
    如果 (!删.正常) { 返回 0; }
    如果 (字符串比较(副本, "形态二元素甲乙丙丁戊己庚辛壬癸")) { 校验 = 校验 + 2; }
    返回 校验;
}

// ③ 借出→消费→修改（NLL 活跃区间已结束）
函数 形态三() -> 整64 {
    整64 校验 = 0;
    向量<字符串> 表 = 向量<字符串>();
    结果<空类型, 整32> 加 = 表.追加(字符串复制("形态三元素甲乙丙丁戊己庚辛壬癸"));
    如果 (!加.正常) { 返回 0; }
    字符串 借出 = 表.元素(0);
    如果 (字符串比较(借出, "形态三元素甲乙丙丁戊己庚辛壬癸")) { 校验 = 校验 + 4; }
    结果<空类型, 整32> 删 = 表.删除(0);
    如果 (!删.正常) { 返回 0; }
    返回 校验;
}

// ④ 借出后修改但不使用借出
函数 形态四() -> 整64 {
    整64 校验 = 0;
    向量<字符串> 表 = 向量<字符串>();
    结果<空类型, 整32> 加 = 表.追加(字符串复制("形态四元素甲乙丙丁戊己庚辛壬癸"));
    如果 (!加.正常) { 返回 0; }
    字符串 借出 = 表.元素(0);
    结果<空类型, 整32> 删 = 表.删除(0);
    如果 (!删.正常) { 返回 0; }
    校验 = 校验 + 8;
    返回 校验;
}

// ⑤ 非字符串元素容器（值语义深拷贝，非借用面）
函数 形态五() -> 整64 {
    整64 校验 = 0;
    向量<整64> 表 = 向量<整64>();
    结果<空类型, 整32> 加 = 表.追加(7);
    如果 (!加.正常) { 返回 0; }
    整64 借出值 = 表.元素(0);
    结果<空类型, 整32> 删 = 表.删除(0);
    如果 (!删.正常) { 返回 0; }
    如果 (借出值 == 7) { 校验 = 校验 + 16; }
    返回 校验;
}

// ⑥ 结果变量：消费在失效点之前
函数 形态六() -> 整64 {
    整64 校验 = 0;
    向量<字符串> 表 = 向量<字符串>();
    结果<空类型, 整32> 加 = 表.追加(字符串复制("形态六元素甲乙丙丁戊己庚辛壬癸"));
    如果 (!加.正常) { 返回 0; }
    结果<字符串, 整32> 读 = 表.读取(0);
    如果 (读.正常) {
        如果 (字符串比较(读.值, "形态六元素甲乙丙丁戊己庚辛壬癸")) { 校验 = 校验 + 32; }
    } 否则 {
        返回 0;
    }
    结果<空类型, 整32> 设 = 表.设置(0, 字符串复制("形态六新值甲乙丙丁戊己庚辛壬癸"));
    如果 (!设.正常) { 返回 0; }
    返回 校验;
}

// ⑦ 扩容类修改点后同一借出继续用（字符串句柄独立于容器槽）
函数 形态七() -> 整64 {
    整64 校验 = 0;
    向量<字符串> 表 = 向量<字符串>();
    结果<空类型, 整32> 加 = 表.追加(字符串复制("形态七元素甲乙丙丁戊己庚辛壬癸"));
    如果 (!加.正常) { 返回 0; }
    字符串 借出 = 表.元素(0);
    整64 i = 0;
    当 (i < 6) {
        结果<空类型, 整32> 增 = 表.追加(字符串复制("形态七填充甲"));
        如果 (!增.正常) { 返回 0; }
        i++;
    }
    如果 (字符串比较(借出, "形态七元素甲乙丙丁戊己庚辛壬癸")) { 校验 = 校验 + 64; }
    返回 校验;
}

// ⑧ 循环内每轮重新借出（消费后再修改）
函数 形态八() -> 整64 {
    整64 校验 = 0;
    向量<字符串> 表 = 向量<字符串>();
    结果<空类型, 整32> 加 = 表.追加(字符串复制("形态八元素甲"));
    如果 (!加.正常) { 返回 0; }
    布尔 首次 = 真;
    整64 i = 0;
    当 (i < 3) {
        字符串 行 = 表.元素(i);
        如果 (字符串长度(行) > 0 && 首次) { 校验 = 校验 + 128; 首次 = 假; }
        结果<空类型, 整32> 增 = 表.追加(字符串复制("形态八追加乙"));
        如果 (!增.正常) { 返回 0; }
        i++;
    }
    返回 校验;
}

// ⑨ 借出视图变量未被误判为拥有（内存::活动分配数：容器析构释放元素后归零）
函数 形态九() -> 整64 {
    整64 基准 = 内存::活动分配数();
    如果 (1 == 1) {
        向量<字符串> 表 = 向量<字符串>();
        结果<空类型, 整32> 加 = 表.追加(字符串复制("形态九元素甲乙丙丁戊己庚辛壬癸"));
        如果 (!加.正常) { 返回 0; }
        字符串 借出 = 表.元素(0);
        如果 (字符串长度(借出) > 0) { }
    }
    整64 终 = 内存::活动分配数();
    如果 (终 == 基准) { 返回 1; }
    返回 0;
}

函数 主() -> 整32 {
    整64 校验和 = 0;
    如果 (形态一() == 1) { 校验和 = 校验和 + 1; }
    如果 (形态二() == 2) { 校验和 = 校验和 + 2; }
    如果 (形态三() == 4) { 校验和 = 校验和 + 4; }
    如果 (形态四() == 8) { 校验和 = 校验和 + 8; }
    如果 (形态五() == 16) { 校验和 = 校验和 + 16; }
    如果 (形态六() == 32) { 校验和 = 校验和 + 32; }
    如果 (形态七() == 64) { 校验和 = 校验和 + 64; }
    如果 (形态八() == 128) { 校验和 = 校验和 + 128; }
    如果 (形态九() == 1) { 校验和 = 校验和 + 256; }
    打印("校验和(期望511)=", 校验和);
    返回 0;
}
