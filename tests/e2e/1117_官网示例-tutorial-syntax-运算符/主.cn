// 官网文档示例 · tutorial-syntax.html · 运算符（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
函数 正数(整32 x) -> 布尔 { 返回 x > 0; }

函数 主() -> 整32 {
    整32 a = 7;
    整32 b = 2;
    打印(a + b, a - b, a * b, a / b, a % b);   // 9 5 14 3 1
    打印(a << 1, a >> 1, a & 3, a | 8, a ^ 1); // 14 3 3 15 6
    打印(a > b, a == 7, a != 7, !正数(-1));    // 布尔族
    整32 c = a > b ? a : b;                     // 三元（右结合）
    a += 10;                                    // 复合赋值族 += -= *= /= %=
    a++;                                        // 后缀自增：表达式值=原值
    打印(c, a);
    返回 0;
}