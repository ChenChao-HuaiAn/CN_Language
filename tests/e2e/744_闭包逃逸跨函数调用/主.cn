// 742_闭包逃逸跨函数调用（#485·#435 立法消费面·「[=] 闭包经返回真逃逸后
//   跨函数调用=宿主运行 C0000005」探针实锤形态收口）：
//   宿主面=间接调用返回类型根治——CallIndirect 返回类型原硬编码 i32：整128
//   返回=调用点不传 sret 隐藏指针且按 eax 取值（蹦床按 sret 协议写 rcx 垃圾
//   地址=C0000005）；整64 返回=eax 截断；浮64 返回=eax 垃圾。修复=fnptr
//   声明返回类型逐面贯通（间接调用/推断声明 srcType/结构体返回 sret）。
//   v2 面=128/结构体捕获蹦床否决解除（快照静态槽全尺寸+固化整块拷+还原
//   传址——原旧轨局部快照=逃逸后读已销亡帧）。
// 面1 [=] 值捕获整128·经返回逃逸·跨函数调用（立案形态·期望 246913578024690）
// 面2 [=] 值捕获整64·逃逸（截断面·期望 10000000000）
// 面3 fnptr 返回浮64·逃逸（浮点面·期望 7.000000）
// 面4 结构体值捕获·标量返回·逃逸（快照整块拷面·期望 78）
// 期望：246913578024690 / 10000000000 / 7.000000 / 78 / 42（打印 逐行）
函数 造i128() -> 整128(*)() {
    整128 大值 = 123456789012345;
    变量 取 = [=]() -> 整128 { 返回 大值 * 2; };
    返回 取;
}
函数 造i64() -> 整64(*)() {
    整64 基 = 5000000000;
    变量 取 = [=]() -> 整64 { 返回 基 * 2; };
    返回 取;
}
函数 造浮() -> 浮64(*)() {
    浮64 基 = 3.5;
    变量 取 = [=]() -> 浮64 { 返回 基 * 2; };
    返回 取;
}
结构体 点 { 整32 a 整32 b }
函数 造点() -> 整32(*)() {
    变量 v = 点{ a = 7, b = 8 };
    变量 取 = [=]() -> 整32 { 返回 v.a * 10 + v.b; };
    返回 取;
}
函数 主() -> 整32 {
    变量 取i128 = 造i128();
    打印(取i128());
    变量 取i64 = 造i64();
    打印(取i64());
    变量 取浮 = 造浮();
    打印(取浮());
    变量 取点 = 造点();
    打印(取点());
    变量 s = 42;
    打印(s);
    返回 0;
}
