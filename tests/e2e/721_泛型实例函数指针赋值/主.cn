// 721：泛型实例函数指针赋值面（437·双编译对照）——
//   形态：声明初值位 / 赋值换靶 / 函数名作实参 / 指针变量作实参 /
//         多实参实例 / 间接调用返回值再存储
//   原缺陷（437 根治前）：`加一<整32>` 表达式位漏接落入二元层比较 →
//   IR 层「表达式净栈契约违反(多压)」（421 ⑤行形态）；实例值位引用
//   漏收集 → IR_函数地址 链接 undefined。
泛型 <类型 T> 函数 加一(T 值) -> T {
    返回 值 + 1;
}

泛型 <类型 T> 函数 合并(T 左, T 右) -> T {
    返回 左 * 10 + 右;
}

函数 应用(整32(*处理)(整32), 整32 值) -> 整32 {
    返回 处理(值);
}

函数 主() -> 整32 {
    // 声明初值位：泛型显式实例赋函数指针
    整32(*f)(整32) = 加一<整32>;
    打印(f(41));
    // 多实参实例
    整32(*g)(整32, 整32) = 合并<整32>;
    打印(g(3, 7));
    // 实参位：实例名直接作实参
    打印(应用(加一<整32>, 100));
    // 实参位：指针变量作实参
    打印(应用(f, 200));
    // 间接调用返回值再存储
    整32 存值 = f(9);
    打印(存值);
    // 赋值换靶（同签名实例间重绑）
    整32(*h)(整32) = 加一<整32>;
    h = 加一<整32>;
    打印(h(0));
    返回 0;
}
