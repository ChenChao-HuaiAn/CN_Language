// E2E 258：字符串元素数组释放双编译对照（plans/020 移植纪律 9 第二十六个对照用例）
//   98-a（2026-09-13 第九十八轮 C9）：栈数组**字符串元素释放**（块出口/跳出/函数尾
//   逐元素 __cn_str_free；元素槽释放+清零=幂等模型）——修复前**双侧同缺**
//   （宿主 79-a 靶子面「数组元素残留 2」；Rust `[String; N]` 作用域 drop 语义对齐）。
//   八形态（两侧共有语义面，全部以 内存::活动分配数 差值锚定=两侧同残留判定）：
//     ① 块出口释放（块内声明数组 → 出口残留归零）
//     ② 循环体内声明 + 中断跳出（drop-on-jump → 跳出后残留归零）
//     ③ 函数尾释放（末尾数组 → 返回路径释放；经 ②③ 组合间接验证）
//     ④ 非字符串元素对照（整32 数组不注册释放名单=残留不变）
//     ⑤ 部分初始化数组（元素=字面量借出=污染？——本用例用 字符串复制 白名单拥有）
//     ⑥ 多数组叠加（两个数组独立释放）
//     ⑦ 嵌套索引读（元素访问正确性不受释放影响）
//     ⑧ 元素索引覆盖（首/末元素都释放）
//   退出码 = 八形态折校验和 255（①1+②2+③4+④8+⑤16+⑥32+⑦64+⑧128 全对）。

// ① 块出口释放
函数 形一() -> 整64 {
    整64 起 = 内存::活动分配数();
    {
        字符串[2] 甲 = { 字符串复制("甲1"), 字符串复制("甲2") };
        如果 (字符串长度(甲[0]) == 0) { 返回 0; }
    }
    如果 (内存::活动分配数() == 起) { 返回 1; }
    返回 0;
}

// ② 循环体内声明 + 中断跳出（drop-on-jump）
函数 形二() -> 整64 {
    整64 起 = 内存::活动分配数();
    整32 i = 0;
    当 (i < 3) {
        字符串[1] 环 = { 字符串复制("环") };
        如果 (字符串长度(环[0]) == 0) { 返回 0; }
        中断;
    }
    如果 (内存::活动分配数() == 起) { 返回 2; }
    返回 0;
}

// ③ 嵌套块（内层声明外层观察）
函数 形三() -> 整64 {
    整64 起 = 内存::活动分配数();
    {
        {
            字符串[1] 深 = { 字符串复制("深") };
        }
        如果 (内存::活动分配数() != 起) { 返回 0; }
    }
    如果 (内存::活动分配数() == 起) { 返回 4; }
    返回 0;
}

// ④ 非字符串元素对照（整32 数组不注册=无额外释放）
函数 形四() -> 整64 {
    整64 起 = 内存::活动分配数();
    {
        整32[3] 数 = { 1, 2, 3 };
        如果 (数[2] != 3) { 返回 0; }
    }
    如果 (内存::活动分配数() == 起) { 返回 8; }
    返回 0;
}

// ⑤ 多数组叠加（两个数组独立释放）
函数 形五() -> 整64 {
    整64 起 = 内存::活动分配数();
    {
        字符串[2] 左 = { 字符串复制("左1"), 字符串复制("左2") };
        字符串[3] 右 = { 字符串复制("右1"), 字符串复制("右2"), 字符串复制("右3") };
        如果 (字符串长度(左[1]) == 0 || 字符串长度(右[2]) == 0) { 返回 0; }
    }
    如果 (内存::活动分配数() == 起) { 返回 16; }
    返回 0;
}

// ⑥ 元素内容正确性（释放不影响读）
函数 形六() -> 整64 {
    字符串[2] 表 = { 字符串复制("乙"), 字符串复制("丙") };
    如果 (字符串比较(表[0], "乙") && 字符串比较(表[1], "丙")) { 返回 32; }
    返回 0;
}

// ⑦ 首末元素都释放（长度边界）
函数 形七() -> 整64 {
    整64 起 = 内存::活动分配数();
    {
        字符串[4] 四 = { 字符串复制("1"), 字符串复制("2"), 字符串复制("3"), 字符串复制("4") };
        如果 (字符串长度(四[3]) == 0) { 返回 0; }
    }
    如果 (内存::活动分配数() == 起) { 返回 64; }
    返回 0;
}

// ⑧ 函数尾数组（返回路径释放——经后续调用观察：本函数返回后调用方残留应归零）
函数 造尾(整64 起) -> 整64 {
    字符串[2] 尾 = { 字符串复制("尾1"), 字符串复制("尾2") };
    如果 (字符串长度(尾[1]) == 0) { 返回 0; }
    返回 内存::活动分配数() - 起;
}
函数 形八() -> 整64 {
    整64 起 = 内存::活动分配数();
    整64 函数内增 = 造尾(起);
    如果 (函数内增 != 2) { 返回 0; }
    如果 (内存::活动分配数() == 起) { 返回 128; }
    返回 0;
}

函数 主() -> 整32 {
    整64 校验 = 形一() + 形二() + 形三() + 形四() +
                 形五() + 形六() + 形七() + 形八();
    打印("校验和=", 校验);
    返回 整32(校验 % 256);
}
