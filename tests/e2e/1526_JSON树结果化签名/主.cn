// E2E 1526_JSON树结果化签名（#1587·#1360 哨兵禁令全面化）：
//   stdlib/JSON核心.cn JSON树 两公开 API 签名结果化验收——
//   ① 新节点(整64) -> 结果<整64, 整32>：成功=.正常/.值=新索引（0 合法）；失败=
//      .错误 且 错误码/错误位置/错误字节 状态机照旧写入（原 -1 失败哨兵与索引同域）；
//   ② 接子(整64, 整64) -> 结果<空类型, 整32>：成功=正常()；失败=错误(错误码)
//      （原空类型+仅置错误码=调用方无法感知失败）。
//   覆盖：手工建树走 新节点/接子 成功通道 + 解析器 5 处新节点消费点（解析/遍历/
//   生成往返）+ 错误 JSON 状态机通道不变（语法错/尾余）。
//   断言走 测试框架（JSON+测试框架 双模块同轮 dual·669/939 同构）。
导入 测试框架::{测试器, 运行用例, 断言真, 断言相等整数, 断言相等文本, 测试汇总};
导入 JSON::{JSON树, 解析JSON, 生成JSON, JSONT_数组, JSONT_整数, JSONE_好, JSONE_语法, JSONE_尾余};

// ① 结果化签名成功通道：新节点=正常(新位) 可直接 .值 取索引；接子=正常()。
//   手工建 [7]（数组根 + 整数子 + 数值槽），生成逐字核对。
不安全 函数 用例接子签名(测试器* 器) {
    JSON树 树 = JSON树();
    结果<整64, 整32> 根果 = 树.新节点(JSONT_数组);
    断言真(器, 根果.正常, "新节点数组根成功");
    如果 (根果.正常) {
        整64 根 = 根果.值;
        结果<整64, 整32> 子果 = 树.新节点(JSONT_整数);
        断言真(器, 子果.正常, "新节点整数子成功");
        如果 (子果.正常) {
            整64 子节 = 子果.值;
            结果<空类型, 整32> 设果 = 树.数值们.设置(子节, 7);
            断言真(器, 设果.正常, "数值槽设置成功");
            如果 (设果.正常) {
                结果<空类型, 整32> 接果 = 树.接子(根, 子节);
                断言真(器, 接果.正常, "接子成功通道");
                如果 (接果.正常) {
                    字符串 生 = 生成JSON(树, 根, 0);
                    断言相等文本(器, 生, "[7]", "手工建树生成逐字");
                }
            }
        }
    }
}

// ② 解析（5 处 新节点 消费点）→遍历（子/找键）→生成往返逐字
不安全 函数 用例解析往返(测试器* 器) {
    JSON树 树 = JSON树();
    解析JSON(树, "{\"键\":[1,2],\"名\":\"值\"}");
    断言相等整数(器, 树.错误码, JSONE_好, "解析成功");
    断言相等整数(器, 树.子数(树.根), 2, "根成员数");
    可选<整64> 键查 = 树.找键(树.根, "键");
    断言真(器, 键查.有值, "键命中");
    如果 (键查.有值) {
        整64 键节 = 键查.值;
        断言相等整数(器, 树.子数(键节), 2, "数组元素数");
        可选<整64> 首查 = 树.子(键节, 0);
        断言真(器, 首查.有值, "首元素命中");
        如果 (首查.有值) {
            断言相等整数(器, 树.整值(首查.值), 1, "首元素值");
        }
        可选<整64> 次查 = 树.子(键节, 1);
        如果 (次查.有值) {
            断言相等整数(器, 树.整值(次查.值), 2, "次元素值");
        }
    }
    可选<整64> 名查 = 树.找键(树.根, "名");
    断言真(器, 名查.有值, "名命中");
    如果 (名查.有值) {
        断言相等文本(器, 树.文本(名查.值), "值", "名值");
    }
    断言相等文本(器, 生成JSON(树, 树.根, 0), "{\"键\":[1,2],\"名\":\"值\"}", "紧凑往返逐字");
}

// ③ 负例：错误 JSON 的错误状态机通道不变（语法错/尾余），失败后根复位 -1
不安全 函数 用例错误通道(测试器* 器) {
    JSON树 树 = JSON树();
    解析JSON(树, "{\"键\":}");
    断言相等整数(器, 树.错误码, JSONE_语法, "缺值语法错码");
    断言相等整数(器, 树.根, -1, "失败后根复位");
    解析JSON(树, "[1,2] 垃圾");
    断言相等整数(器, 树.错误码, JSONE_尾余, "尾余错码");
}

不安全 函数 主() -> 整32 {
    测试器 器 = 测试器();
    运行用例(器, "接子签名", 用例接子签名);
    运行用例(器, "解析往返", 用例解析往返);
    运行用例(器, "错误通道", 用例错误通道);
    整64 失败数 = 测试汇总(器);
    打印("汇总返回失败用例数=", 失败数);
    返回 0;
}
