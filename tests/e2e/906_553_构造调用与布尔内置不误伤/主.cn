// 553（#443 呈报分叉不误伤 dual 正例）：合法构造调用与布尔内置条件照常——
//   类名(实参) 构造调用/结构体花括号构造/布尔内置（字符串比较）直接作条件；
//   双侧运行输出逐行一致（v2 补检查不得误伤·443 核验轮两个分叉的回归锚）。
类 点 {
公开:
    整32 x;
    整32 y;
    函数 点(整32 x0, 整32 y0) {
        x = x0;
        y = y0;
    }
}
结构体 盒 {
    整32 v;
}
函数 主() -> 整32 {
    点 甲 = 点(3, 4);
    盒 乙 = 盒{ v = 7 };
    字符串 丙 = "abcd";
    字符串 丁 = "cd";
    整32 合 = 甲.x + 甲.y + 乙.v;
    如果 (字符串比较(丁, 丁)) {
        合 = 合 + 1;
    }
    打印("合=", 合);
    返回 0;
}
