// E2E 1590（#1681·2026-10-27）：结构体「指向结果/可选的指针字段」写读一致 + 复合解引用赋值放行（#1666 解除·双编译对照）
// 病面（修前 v2）：结构体 架{ 可选<整64>* 针; }；甲.针 = 借（借=局部指针变量）
//   后 甲.针 != 借（同形态 整64* 字段正常）——字段类型登记/读取对「可选<...>*」
//   文本星号归一漏，或成员读取把结果族基名当合成体载荷压字段地址；连带
//   *(甲.针)=某些(5) 因 #1681 语义临时拒绝（#1666 宁拒不放行·本轮根修后恢复放行）。
// 锁面（位折累加，任一面丢失=对照失败）：
//   ①指针字段写读一致（甲.针==借）…1
//   ②复合解引用写 *(甲.针)=某些(41) 写穿源可选（#1666 恢复放行锁面）…16
//   ③写不穿邻（字段赋值后哨兵完好）…32
//   ④标量 整64* 字段写读一致+解引用读值对照锚（修前已正常·防回归）…64+128
// 形态规避说明：「可选<整64> 读 = *借」解引用**读**成合成体=宿主侧缺口
//   （LoadPtr 标量读路径无合成体整块拷贝·崩/有值丢失·已立项另治），本用例
//   不纳入（保持双侧共有多态）；#1681 锁面不依赖该形态。
结构体 架 {
    可选<整64>* 针;
    整64 哨兵;
}
结构体 标架 {
    整64* 针;
    整64 哨兵;
}
不安全 函数 主() -> 整32 {
    整32 累计 = 0;
    可选<整64> 盒 = 某些(7);
    可选<整64>* 借 = &盒;
    架 甲;
    甲.哨兵 = 0;

    // ① 指针字段写读一致（修前 v2 错位：甲.针 != 借）
    甲.针 = 借;
    如果 (甲.针 == 借) { 累计 = 累计 + 1; }

    // ② 复合解引用写（#1666 恢复放行锁面）：*(甲.针) = 某些(41) 写穿源可选
    *(甲.针) = 某些(41);
    如果 (盒.有值) {
        如果 (盒.值 == 41) { 累计 = 累计 + 16; }
    }

    // ③ 写不穿邻：哨兵完好
    如果 (甲.哨兵 == 0) { 累计 = 累计 + 32; }

    // ④ 标量指针字段对照锚（修前已正常）
    整64 标 = 5;
    整64* 标借 = &标;
    标架 乙;
    乙.哨兵 = 0;
    乙.针 = 标借;
    如果 (乙.针 == 标借) { 累计 = 累计 + 64; }
    如果 (*(乙.针) == 5) { 累计 = 累计 + 128; }

    打印("累计: ", 累计);
    返回 0;
}
