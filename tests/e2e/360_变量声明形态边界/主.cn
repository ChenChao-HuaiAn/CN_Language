// E2E 360：变量声明（类型前置）形态边界（规格书 5.2）
// 一炉覆盖：静态 显式类型（模块级）/常量 推断（顶层+局部）/变量 推断/
// 显式位宽（整32、正16）/数组声明带初始化列表/循环 init 位声明。
静态 整32 全局计 = 7;
常量 上限 = 100;

函数 主() -> 整32 {
    常量 PI = 3;
    变量 推断值 = PI * 2;
    整32 显式值 = 4;
    正16 窄值 = 5;
    整32[3] 数据 = { 1, 2, 3 };
    循环 (整32 j = 0; j < 3; j++) {
        推断值 = 推断值 + 数据[j];
    }
    打印("合计: ", 推断值 + 显式值 + 全局计);
    打印("窄值: ", 窄值);
    打印("上限: ", 上限);
    返回 0;
}
