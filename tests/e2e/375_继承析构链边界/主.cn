// E2E 375：类继承析构链（规格书 06-三：析构函数内联清理资源后调用父类析构，
//   与 C++ 构造/析构语义一致）——两级+三级链逐级析构（派生先于基类）。
//   D21 根治锚定（248-a）：基类析构曾被跳过（unordered_map 遍历序非确定命中
//   提升符号）——本用例固化全链顺序。
类 甲 {
公开:
    函数 ~甲() { 打印("析构甲"); }
}

类 乙 : 甲 {
公开:
    函数 ~乙() { 打印("析构乙"); }
}

类 丙 : 乙 {
公开:
    函数 ~丙() { 打印("析构丙"); }
}

函数 主() -> 整32 {
    {
        乙 对象乙 = 乙();
    }
    {
        丙 对象丙 = 丙();
    }
    打印("结束");
    返回 0;
}
