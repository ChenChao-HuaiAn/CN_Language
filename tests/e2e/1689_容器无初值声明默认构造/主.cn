// E2E 1689（任务 1924·双侧零分叉）：容器**无初值声明**默认构造锁面——
//   `向量<整32> 甲;` 等无初始化器声明在宿主与 v2 两侧都必须走默认构造
//   （容器() 无参构造 + 空容器状态），且块出口释放后活动分配数净差 0。
//
// 背景（任务 1636 收口呈报 / 任务 1924 复核）：v2 IR 层「容器初始化仅支持
//   构造/调用返回/标识符拷贝/下标元素」诊断只应对**非空初值中的未识别源形态**
//   报出；空初值声明必须显式走默认构造分支（与宿主 ir_stmt_decl 无初始化器
//   分支同款），严禁误入「不支持」诊断。任务 1924 把该分支在分派链中显式化
//   （v2 IR/生成声明中.cn 生成容器局部），本用例锁死运行期语义面。
//
// 覆盖面（同族十一形态）：
//   ①向量<整32> ②向量<字符串> ③映射<整64,整64> ④栈<整32> ⑤队列<整32>
//   ⑥链表<整32> ⑦集合<整32>（七类标准库容器无初值局部声明）
//   ⑧类字段无初值（显式无参构造体外不写该字段） ⑨结构体字段无初值
//   ⑩顶层全局容器无初值（跨函数使用） ⑪块作用域出口释放（活动分配数净差 0）
// 断言口径：各形态首元素/大小正确 + 每形态块出口 内存::活动分配数() 净差 0
//   （全局容器除外——静态生命周期，只断言内容）；退出码 0=全绿。
// 双侧：双编译对照.txt 断言输出=是——同一源码宿主/v2 各编各跑，运行输出
//   逐行 == 主.expected。
导入 容器::向量;
导入 容器::栈;
导入 容器::队列;
导入 容器::链表;
导入 映射集合::映射;
导入 映射集合::集合;

// ⑩顶层全局容器无初值（静态生命周期·默认构造后为空）
向量<整32> 全局列;

// ⑧类字段无初值：构造函数不写该字段——字段默认构造由构造调用前的字段级联
//   注入（v2 注入构造字段级联 / 宿主 emitClassFieldDefaults 同构）承担
类 盒 {
公开:
    向量<整32> 数据;
    函数 盒() { }
}

// ⑨结构体字段无初值：结构体局部默认态级联构造容器字段
结构体 包 {
    向量<整32> 数据;
}

// ①向量<整32> 无初值
不安全 函数 形向量() -> 整32 {
    整64 前 = 内存::活动分配数();
    {
        向量<整32> 甲;
        如果 (甲.大小() != 0) { 返回 1; }
        结果<空类型, 整32> 加一 = 甲.追加(1);
        如果 (!加一.正常) { 返回 2; }
        结果<空类型, 整32> 加二 = 甲.追加(2);
        如果 (!加二.正常) { 返回 3; }
        打印("向量 大小=", 甲.大小(), " 首=", 甲.元素(0), " 尾=", 甲.元素(1));
    }
    整64 差 = 内存::活动分配数() - 前;
    打印("向量 残留=", 差);
    如果 (差 != 0) { 返回 4; }
    返回 0;
}

// ②向量<字符串> 无初值
不安全 函数 形字符串向量() -> 整32 {
    整64 前 = 内存::活动分配数();
    {
        向量<字符串> 乙;
        如果 (乙.大小() != 0) { 返回 1; }
        结果<空类型, 整32> 加 = 乙.追加("甲");
        如果 (!加.正常) { 返回 2; }
        打印("字符串向量 大小=", 乙.大小(), " 首=", 乙.元素(0));
    }
    整64 差 = 内存::活动分配数() - 前;
    打印("字符串向量 残留=", 差);
    如果 (差 != 0) { 返回 3; }
    返回 0;
}

// ③映射<整64,整64> 无初值
不安全 函数 形映射() -> 整32 {
    整64 前 = 内存::活动分配数();
    {
        映射<整64, 整64> 丙;
        如果 (丙.大小() != 0) { 返回 1; }
        结果<空类型, 整32> 设 = 丙.设置(1, 7);
        如果 (!设.正常) { 返回 2; }
        结果<整64, 整32> 取 = 丙.获取(1);
        如果 (!取.正常) { 返回 3; }
        打印("映射 大小=", 丙.大小(), " 值=", 取.值);
    }
    整64 差 = 内存::活动分配数() - 前;
    打印("映射 残留=", 差);
    如果 (差 != 0) { 返回 4; }
    返回 0;
}

// ④栈<整32> 无初值
不安全 函数 形栈() -> 整32 {
    整64 前 = 内存::活动分配数();
    {
        栈<整32> 丁;
        如果 (丁.大小() != 0) { 返回 1; }
        结果<空类型, 整32> 压 = 丁.压入(9);
        如果 (!压.正常) { 返回 2; }
        结果<整32, 整32> 弹 = 丁.弹出();
        如果 (!弹.正常) { 返回 3; }
        打印("栈 大小=", 丁.大小(), " 顶=", 弹.值);
    }
    整64 差 = 内存::活动分配数() - 前;
    打印("栈 残留=", 差);
    如果 (差 != 0) { 返回 4; }
    返回 0;
}

// ⑤队列<整32> 无初值
不安全 函数 形队列() -> 整32 {
    整64 前 = 内存::活动分配数();
    {
        队列<整32> 戊;
        如果 (戊.大小() != 0) { 返回 1; }
        结果<空类型, 整32> 入 = 戊.入队(4);
        如果 (!入.正常) { 返回 2; }
        结果<整32, 整32> 出 = 戊.出队();
        如果 (!出.正常) { 返回 3; }
        打印("队列 大小=", 戊.大小(), " 首=", 出.值);
    }
    整64 差 = 内存::活动分配数() - 前;
    打印("队列 残留=", 差);
    如果 (差 != 0) { 返回 4; }
    返回 0;
}

// ⑥链表<整32> 无初值
不安全 函数 形链表() -> 整32 {
    整64 前 = 内存::活动分配数();
    {
        链表<整32> 己;
        如果 (己.大小() != 0) { 返回 1; }
        结果<空类型, 整32> 加 = 己.追加(6);
        如果 (!加.正常) { 返回 2; }
        打印("链表 大小=", 己.大小());
    }
    整64 差 = 内存::活动分配数() - 前;
    打印("链表 残留=", 差);
    如果 (差 != 0) { 返回 3; }
    返回 0;
}

// ⑦集合<整32> 无初值
不安全 函数 形集合() -> 整32 {
    整64 前 = 内存::活动分配数();
    {
        集合<整32> 庚;
        如果 (庚.大小() != 0) { 返回 1; }
        结果<空类型, 整32> 添 = 庚.添加(8);
        如果 (!添.正常) { 返回 2; }
        打印("集合 大小=", 庚.大小(), " 含=", 庚.包含(8));
    }
    整64 差 = 内存::活动分配数() - 前;
    打印("集合 残留=", 差);
    如果 (差 != 0) { 返回 3; }
    返回 0;
}

// ⑧类字段无初值（显式无参构造不写该字段）
不安全 函数 形类字段() -> 整32 {
    整64 前 = 内存::活动分配数();
    {
        盒 箱;
        如果 (箱.数据.大小() != 0) { 返回 1; }
        结果<空类型, 整32> 加 = 箱.数据.追加(7);
        如果 (!加.正常) { 返回 2; }
        打印("类字段 大小=", 箱.数据.大小(), " 首=", 箱.数据.元素(0));
    }
    整64 差 = 内存::活动分配数() - 前;
    打印("类字段 残留=", 差);
    如果 (差 != 0) { 返回 3; }
    返回 0;
}

// ⑨结构体字段无初值
不安全 函数 形结构体字段() -> 整32 {
    整64 前 = 内存::活动分配数();
    {
        包 袋;
        如果 (袋.数据.大小() != 0) { 返回 1; }
        结果<空类型, 整32> 加 = 袋.数据.追加(3);
        如果 (!加.正常) { 返回 2; }
        打印("结构体字段 大小=", 袋.数据.大小(), " 首=", 袋.数据.元素(0));
    }
    整64 差 = 内存::活动分配数() - 前;
    打印("结构体字段 残留=", 差);
    如果 (差 != 0) { 返回 3; }
    返回 0;
}

// ⑩顶层全局容器无初值（静态生命周期·只断言内容）
不安全 函数 形全局() -> 整32 {
    如果 (全局列.大小() != 0) { 返回 1; }
    结果<空类型, 整32> 加 = 全局列.追加(5);
    如果 (!加.正常) { 返回 2; }
    打印("全局 大小=", 全局列.大小(), " 首=", 全局列.元素(0));
    返回 0;
}

// ⑪块作用域重复进入 + 出口释放（循环体三次声明，活动分配数净差 0）
不安全 函数 形块释放() -> 整32 {
    整64 前 = 内存::活动分配数();
    整64 计 = 0;
    当 (计 < 3) {
        向量<整32> 局部;
        结果<空类型, 整32> 加 = 局部.追加(整32(计));
        如果 (!加.正常) { 返回 1; }
        如果 (局部.大小() != 1) { 返回 2; }
        计++;
    }
    整64 差 = 内存::活动分配数() - 前;
    打印("块释放 残留=", 差);
    如果 (差 != 0) { 返回 3; }
    返回 0;
}

不安全 函数 主() -> 整32 {
    如果 (形向量() != 0) { 返回 101; }
    如果 (形字符串向量() != 0) { 返回 102; }
    如果 (形映射() != 0) { 返回 103; }
    如果 (形栈() != 0) { 返回 104; }
    如果 (形队列() != 0) { 返回 105; }
    如果 (形链表() != 0) { 返回 106; }
    如果 (形集合() != 0) { 返回 107; }
    如果 (形类字段() != 0) { 返回 108; }
    如果 (形结构体字段() != 0) { 返回 109; }
    如果 (形全局() != 0) { 返回 110; }
    如果 (形块释放() != 0) { 返回 111; }
    打印("1689 全绿");
    返回 0;
}
