// 1676（#1899）：基构造初始化列表表达式实参——双侧锁用例。
// 形态：算式实参/函数调用实参/两层继承链各层算式 + 字面量/纯标识符对照
// （原 v2 缺陷=实参非常量表达式时发射中止「[992守卫] 非法寄存器槽号: 0」，
//   宿主全绿——零分叉铁律违例锁面）。
函数 加一(整32 x) -> 整32 {
    返回 x + 1;
}
类 基甲 {
公开:
    整32 甲值;
    函数 基甲(整32 v) { 甲值 = v * 2; }
}
类 派乙 : 基甲 {
公开:
    整32 乙值;
    函数 派乙(整32 v) : 基甲(v + 1) { 乙值 = v * 10; }
}
类 派丙 : 基甲 {
公开:
    整32 丙值;
    函数 派丙(整32 v) : 基甲(加一(v)) { 丙值 = v * 100; }
}
类 派丁 : 基甲 {
公开:
    整32 丁值;
    函数 派丁(整32 v) : 基甲(5) { 丁值 = v; }
}
类 派戊 : 基甲 {
公开:
    整32 戊值;
    函数 派戊(整32 v) : 基甲(v) { 戊值 = v; }
}
类 甲层 : 派乙 {
公开:
    整32 顶值;
    函数 甲层(整32 v) : 派乙(v * 3 + 1) { 顶值 = v; }
}
函数 主() -> 整32 {
    派乙 乙 = 派乙(4);
    打印(乙.甲值);
    打印(乙.乙值);
    派丙 丙 = 派丙(4);
    打印(丙.甲值);
    打印(丙.丙值);
    派丁 丁 = 派丁(7);
    打印(丁.甲值);
    打印(丁.丁值);
    派戊 戊 = 派戊(9);
    打印(戊.甲值);
    打印(戊.戊值);
    甲层 顶 = 甲层(2);
    打印(顶.甲值);
    打印(顶.乙值);
    打印(顶.顶值);
    返回 0;
}
