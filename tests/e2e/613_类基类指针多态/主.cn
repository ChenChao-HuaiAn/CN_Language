// 613(#234·91303 转正·立法 001 §8.6 类→基类指针/引用隐式转换):派生类经
//   基类指针/引用同地址上行转换,虚拟调用按动态类型虚表分派。
//   覆盖:①指针多态+重挂 ②引用多态(函数形参) ③三级链末端分派
//   ④基类方法内 经自身. 虚调用(365 同款·基类引用语义)。
类 形状 {
公开:
    虚拟 函数 面积() -> 整32 { 返回 0; }
    函数 描述() -> 字符串 { 返回 "面积=" + 整数转字符串(自身.面积()); }
}
类 方 : 形状 {
公开:
    整32 边;
    函数 方(整32 b) { 边 = b; }
    重写 函数 面积() -> 整32 { 返回 边 * 边; }
}
类 长 : 形状 {
公开:
    整32 宽;
    整32 高;
    函数 长(整32 w, 整32 h) { 宽 = w; 高 = h; }
    重写 函数 面积() -> 整32 { 返回 宽 * 高; }
}
类 幼长 : 长 {
公开:
    函数 幼长(整32 w, 整32 h) : 长(w, h) { }
    重写 函数 面积() -> 整32 { 返回 宽 * 高 * 2; }
}
函数 印面积(形状& s) -> 整32 { 返回 s.面积(); }
函数 主() -> 整32 {
    方 a = 方(3);
    长 b = 长(4, 5);
    形状* p = a;
    打印(p.面积());
    p = b;
    打印(p.面积());
    打印(印面积(a));
    幼长 c = 幼长(2, 3);
    形状* q = c;
    打印(q.面积());
    打印(q.描述());
    返回 0;
}
