// 320-a 补强（T41 写面完备）：函数内静态局部全写面矩阵——
//   普通赋值/复合赋值（+= -= *= ）/自增自减（后缀/前缀）全形态；
//   原实现只补普通赋值（复合赋值丢运算降级直写、自增自减静默不写回=
//   272 用例 桩+=1 恒 1 死循环实锤）。
函数 计数推进() -> 整32 {
    静态 整32 计 = 0;
    计++;              // 跨调用递增（一次性初始化语义）
    返回 计;
}
函数 主() -> 整32 {
    静态 整32 计 = 0;
    打印行(计);        // 0（.data 直存初值）
    计 = 5;            // 普通赋值
    打印行(计);        // 5
    计 += 3;           // 复合赋值
    打印行(计);        // 8
    计 -= 1;
    打印行(计);        // 7
    计 *= 2;
    打印行(计);        // 14
    计++;              // 后缀自增
    打印行(计);        // 15
    ++计;              // 前缀自增
    打印行(计);        // 16
    计--;              // 后缀自减
    打印行(计);        // 15
    --计;              // 前缀自减
    打印行(计);        // 14
    静态 整64 大 = 100000000000;
    大 += 5;           // 宽度无关（整64 复合赋值）
    打印行(大);        // 100000000005
    打印行(计数推进()); // 1
    打印行(计数推进()); // 2
    打印行(计数推进()); // 3
    循环 (整32 轮 = 0; 轮 < 3; 轮 += 1) {
        计 += 1;       // 循环体复合赋值（272 死循环同型）
    }
    打印行(计);        // 17
    返回 0;
}
