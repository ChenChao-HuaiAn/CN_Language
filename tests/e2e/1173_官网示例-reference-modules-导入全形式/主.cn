// 官网文档示例 · reference/modules.html · 导入（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
导入 容器::*;                       // 通配：模块公开 API 批量引入纯名
导入 数学::{平方根 作为 开方};       // 花括号项内重命名：纯名 开方
导入 数学::*;                       // 通配引入 平方根

函数 主() -> 整32 {
    向量<整64> 表 = 向量<整64>();
    结果<空类型, 整32> 加 = 表.追加(9);
    打印(表.大小(), " ", 开方(4.0), " ", 平方根(9.0));
    返回 0;
}