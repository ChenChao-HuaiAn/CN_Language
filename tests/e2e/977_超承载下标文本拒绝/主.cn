// E2E 977（728w·583 扫描 519 同族）：超整64 承载的常量下标文本拒绝——
//   19 位 ≥2^63（9223372036854775808）/ 负形态绝对量 ≥2^63 在 parser 解析
//   已回绕毒化（宿主 stoll 失真放行到运行期错误码 2；v2 原安全区自插溢出
//   检查中止「错误码 8」）——两侧根治为 §1.1a① 编译期硬错误（文本级判域·
//   对任意静态数组长度可证越界）。双编译对照负测：同一源码宿主+v2p 都必须
//   编译拒绝；诊断锚=「编译期下标越界」（两侧同型文案）。
函数 主() -> 整32 {
    整32[3] 表 = { 1, 2, 3 };
    打印(表[9223372036854775808]);
    打印(表[-9223372036854775808]);
    返回 0;
}
