// E2E 71_self_host_lexer_extra：CN 词法分析器扩展覆盖（自举 Task 7.1，2026-08）
// 覆盖：十六进制 0x / 二进制 0b / 八进制 0o / 整数字面量后缀 LL/U、
//   浮点指数 1.5e10、原始字符串 原始"..."（不处理转义）、多行字符串 多行"""..."""、
//   字符 \u{XXXX} 转义、问号/箭头/双冒号/移位复合赋值运算符
导入 容器::向量
导入 CN语言编译器::词法分析

函数 主() -> 整32 {
    字符串 源码 = "函数 主() -> 整32 {\n    整64 十六 = 0xFF\n    整64 二进 = 0b1010\n    整64 八进 = 0o777\n    整64 大数 = 42LL\n    整64 无符 = 42U\n    浮64 指数 = 1.5e10\n    字符串 路径 = 原始\"C:\\temp\\file\"\n    字符串 文档 = 多行\"\"\"第一行\n第二行\"\"\"\n    字符 中字 = '\\u{4E2D}'\n    整64 结果 = 大数 <<= 2\n    整64 结果2 = 大数 >>= 1\n    自动 指针 = &中字\n    布尔 问号 = 真 ? 假 : 真\n    如果 (结果2 >= 0 && 指针 != 无) {\n        返回 0\n    }\n    返回 1\n}\n"
    向量<字符串> 输出 = 分词(源码)
    整64 i = 0
    当 (i < 输出.大小()) {
        打印(输出.元素(i))
        i++
    }
    返回 0
}
