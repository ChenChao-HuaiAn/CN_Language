// 1504 循环累积成员链引用逃逸（750 复审 P0-A-4·双编译对照）
//   病：检查方法借用纪律202 要求接收者为标识符，成员链接收者（`外.内.记(s)`）
//   被提前 return——引用实参 s 隐式取址未登记逃逸；循环内经指针间接写 s →
//   v2 单侧优化后写穿被出口 finish 覆盖。
//   修：接收者非标识符/类型推导失败 → 保守登记该调用全部标识符实参根
//   （fail-closed：少优化但正确）。
// 预期：S=xZxZ。
类 内层 {
公开:
    字符串* 指;
    函数 内层() { 指 = 无; }
    函数 记(字符串& 参) -> 整32 {
        指 = &参;
        返回 0;
    }
}

类 外层 {
公开:
    内层 内;
    函数 外层() { }
}

不安全 函数 写改(内层& 目标, 字符串 段) -> 整32 {
    *目标.指 = *目标.指 + 段;
    返回 0;
}

不安全 函数 主() -> 整32 {
    字符串 s = "";
    外层 外 = 外层();
    外.内.记(s);
    循环 (整64 k = 0; k < 2; k++) {
        s = s + "x";
        写改(外.内, "Z");
    }
    打印("S=", s);
    返回 0;
}
