// E2E 1640（2026-10-29 任务 1395·P1·〔1022采样轮〕默认参数常量算式与全局常量锁面）：
//   默认值=编译期常量表达式（1+2）/顶层常量名（上限）——宿主原 evalDefaultExpr
//   仅认单字面量（二元/标识符落「语义层已报错补 0」豁免面=静默 0）；v2 侧常量
//   算式发射中止（[992守卫]·后续轮已修）。修后双侧同值。
//   锁面：①函数默认值常量算式 ②函数默认值全局常量 ③类构造默认值常量算式。
//   默认值引用前形参形态不在本面（001 条文空白·另案呈报）。
常量 上限 = 5;

函数 f(整32 a, 整32 x = 1 + 2) -> 整32 {
    返回 a * 100 + x;
}

函数 g(整32 x = 2 + 3) -> 整32 {
    返回 x;
}

函数 h(整32 x = 上限) -> 整32 {
    返回 x;
}

类 仓 {
公开:
    整32 量;
    函数 仓(整32 n = 2 + 3) {
        量 = n;
    }
}

函数 主() -> 整32 {
    打印行(f(1));
    打印行(g());
    打印行(h());
    仓 一 = 仓();
    打印行(一.量);
    仓 二 = 仓(7);
    打印行(二.量);
    返回 0;
}
