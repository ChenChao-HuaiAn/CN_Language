// E2E 1012（双编译对照·633 销项·632 呈报各残面根治）：引用返回族四残面——
//   同一源码宿主/v2 两侧各编各跑，退出码相等（双编译对照配置 退出码=校验和）。
//   四残面（632 呈报·同根至赋值通道）：
//     ①赋值位接收 `甲 = 取货(源)`（取货 返回 货架&·632 同根扩面）…………位1+2
//       位1=深拷副本独立（甲.记录.追加 后 甲=2/源=1·甲=取货(甲) 自赋值安全）
//       且块出口残留==0；位2=重复赋值覆盖前旧值释放（残留==0）。
//     ②成员方法引用返回+声明位 `货架 甲 = 仓.取货()`（体内 返回 库存;）……位4
//     ③引用绑定 `货架& 别名 = 取货(源)`（别名读值正确·绑定槽地址语义）……位8
//     ④a 结构体引用返回接收 `点 甲 = 取点(点源)`…………………………………位16
//     ④b 容器引用返回接收 `向量<整32> 甲 = 取列(列源)`………………………位32
//   修前（探针矩阵双编译实况）：①宿主 C0000374/v2 rc=139 崩；②宿主
//   「变量槽未登记 ''」内部错误/v2 语义误拒「引用返回不能返回局部变量」；
//   ③v2 别名=0（绑定槽错位一层）；④a v2 rc=139；④b 双侧 C0000374。
//   修后：宿主 identifierRefReturnClassCopyAssign/isRefReturnClassValueCall/
//   genRefReturnClassDeepCopy + this 成员左值回落（ir.cpp）；v2 赋值接管
//   引用返回类调用633 + 生成引用局部 hold 槽物化 + 生成结构体/容器局部回扫
//   深拷 + 语义字段豁免（自身层序锚）+ 发射用户类方法调用引用返回指针类。
//   判定口径：283/719/836/878 同款（块出口后 内存::活动分配数 差值==0 且内容正确）。
//   退出码=校验和 63；修前双侧红。
导入 容器::向量;
类 货架 {
公开:
    向量<字符串> 记录;
    函数 货架() { 记录 = 向量<字符串>(); }
    函数 ~货架() { }
    不安全 函数 货架(货架& 其他) { 记录 = 其他.记录; }
}
类 仓 {
公开:
    货架 库存;
    函数 仓() { }
    函数 取货() -> 货架& {
        返回 库存;
    }
}
函数 取货(货架& 源) -> 货架& {
    返回 源;
}
结构体 点 {
    整32 x;
    整32 y;
}
函数 取点(点& 源) -> 点& {
    返回 源;
}
函数 取列(向量<整32>& 源) -> 向量<整32>& {
    返回 源;
}
函数 主() -> 整32 {
    整32 校验 = 0;
    // ① 赋值位深拷 + 副本独立性（改甲不影响源）+ 自赋值安全 + 块出口残留 0
    整64 b1 = 内存::活动分配数();
    整64 甲大 = 0;
    整64 源大 = 0;
    {
        货架 源;
        结果<空类型, 整32> r1 = 源.记录.追加(字符串复制("取一"));
        货架 甲;
        甲 = 取货(源);
        结果<空类型, 整32> r2 = 甲.记录.追加(字符串复制("取二"));
        甲 = 取货(甲);   // 自赋值：深拷自身副本后释放旧值（不得 UAF/双释放）
        甲大 = 甲.记录.大小();
        源大 = 源.记录.大小();
    }
    如果 (甲大 == 2 && 源大 == 1 && 内存::活动分配数() - b1 == 0) { 校验 = 校验 + 1; }
    // ② 重复赋值：覆盖前旧值释放（两次取货接收，块出口残留 0）
    整64 b2 = 内存::活动分配数();
    整64 重大 = 0;
    {
        货架 源;
        结果<空类型, 整32> r3 = 源.记录.追加(字符串复制("重一"));
        货架 甲;
        甲 = 取货(源);
        甲 = 取货(源);
        重大 = 甲.记录.大小();
    }
    如果 (重大 == 1 && 内存::活动分配数() - b2 == 0) { 校验 = 校验 + 2; }
    // ③ 成员方法引用返回+声明位（体内 返回 库存; = this 成员左值）
    整64 方大 = 0;
    {
        仓 仓1;
        结果<空类型, 整32> r4 = 仓1.库存.记录.追加(字符串复制("方一"));
        货架 方 = 仓1.取货();
        方大 = 方.记录.大小();
    }
    如果 (方大 == 1) { 校验 = 校验 + 4; }
    // ④ 引用绑定：别名 = 取货(源)（绑定槽=被引用左值地址·读值正确）
    整64 别名大 = 0;
    {
        货架 源;
        结果<空类型, 整32> r5 = 源.记录.追加(字符串复制("绑一"));
        货架& 别名 = 取货(源);
        别名大 = 别名.记录.大小();
    }
    如果 (别名大 == 1) { 校验 = 校验 + 8; }
    // ⑤ 结构体引用返回接收（位拷本体·字段值正确）
    整32 点x = 0;
    整32 点y = 0;
    {
        点 点源;
        点源.x = 3;
        点源.y = 4;
        点 甲 = 取点(点源);
        点x = 甲.x;
        点y = 甲.y;
    }
    如果 (点x == 3 && 点y == 4) { 校验 = 校验 + 16; }
    // ⑥ 容器引用返回接收（深拷副本·内容正确 + 块出口残留 0）
    整64 b6 = 内存::活动分配数();
    整64 列大 = 0;
    {
        向量<整32> 列源;
        结果<空类型, 整32> r6 = 列源.追加(7);
        向量<整32> 甲列 = 取列(列源);
        列大 = 甲列.大小();
    }
    如果 (列大 == 1 && 内存::活动分配数() - b6 == 0) { 校验 = 校验 + 32; }
    打印行("校验=", 校验);
    返回 校验;
}
