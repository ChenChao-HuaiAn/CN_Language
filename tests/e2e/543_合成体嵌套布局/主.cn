// 543 合成体嵌套布局（067-001 治本转正·826 轮）：双层类拆包/大内层/三层标量/结果嵌套
//   治理前四形态全翻车：p0927_01 双层类 rc=-11/O0=O3 静默错值（外层布局时内层未降级
//   →防御公式 typeSizeOf(T)+1 猜 5B 真实 16B → CopyStruct 截断）；大内层形态栈越界写
//   8B（违双目标②）；三层标量 rc=2；结果嵌套巧合对。修复=ensureLoweredType 递归收口
//   （参数降级先于本体布局）+未降级查询 fail-fast 断言化。
类 盒子 {
    公开:
    整32 值;
    函数 盒子() { 值 = 5; }
    函数 盒子(盒子& 其他) { 值 = 其他.值; }
}

类 大盒 {
    公开:
    整32 甲; 整32 乙; 整32 丙; 整32 丁; 整32 戊;
    函数 大盒() { 甲 = 1; 乙 = 2; 丙 = 3; 丁 = 4; 戊 = 5; }
    函数 大盒(大盒& 其他) {
        甲 = 其他.甲; 乙 = 其他.乙; 丙 = 其他.丙; 丁 = 其他.丁; 戊 = 其他.戊;
    }
}

函数 主() -> 整32 {
    // 形态①：双层类拆包（062 样本本体·p0927_01 同构）
    可选<可选<盒子>> 槽 = 某些(某些(盒子()));
    打印行("S1");
    如果 (槽.有值) {
        打印行("S2");
        可选<盒子> 内 = 槽.值;
        打印行("S3");
        如果 (内.有值) {
            盒子 b = 内.值;
            打印行("S4");
            打印行("t1=", b.值);
        }
    }
    // 形态②：大内层（20B 类·越界写面回归）
    可选<可选<大盒>> 槽2 = 某些(某些(大盒()));
    如果 (槽2.有值) {
        可选<大盒> 内2 = 槽2.值;
        如果 (内2.有值) {
            大盒 d = 内2.值;
            打印行("t2=", d.甲, d.乙, d.丙, d.丁, d.戊);
        }
    }
    // 形态③：三层标量（原 rc=2 有值链断裂）
    可选<可选<可选<整32>>> 槽3 = 某些(某些(某些(7)));
    如果 (槽3.有值) {
        可选<可选<整32>> 中 = 槽3.值;
        如果 (中.有值) {
            可选<整32> 内3 = 中.值;
            如果 (内3.有值) {
                打印行("t3=", 内3.值);
            }
        }
    }
    // 形态④：结果嵌套（巧合对转确定性正确）
    结果<结果<整32, 整32>, 整32> 槽4 = 正常(正常(42));
    如果 (槽4.正常) {
        结果<整32, 整32> 内4 = 槽4.值;
        如果 (内4.正常) {
            打印行("t4=", 内4.值);
        } 否则 {
            打印行("t4=内层错误");
        }
    } 否则 {
        打印行("t4=外层错误");
    }
    返回 0;
}
