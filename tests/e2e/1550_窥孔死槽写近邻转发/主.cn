// E2E 1550：发射后窥孔第二遍（任务 1320）——死槽写消除 + 近邻槽转发
//   槽转发=「Load 结果写回结果槽 → 稍后读回」；死槽写=结果槽此后无读。
// 语义面：本用例只锚定「变换后程序行为不变」——默认档位（-O2）下窥孔实跑，
//   运行输出须与未优化语义一致；变换判据本身由单测
//   tests/unit/codegen/test_peephole_slot*.cpp 正反例逐条锚定。
// 形态覆盖：条件直读后的布尔结果槽（相邻/近邻转发）、字符串实参搬运
//   （call 前 sub rsp 后的近邻 load）、浮点同寄存器槽对（1351 高半证明面）。
函数 较大(整32 甲, 整32 乙) -> 整32 {
    布尔 二 = 甲 > 乙;
    如果 (二) {
        返回 甲;
    }
    返回 乙;
}

函数 判等(整32 甲, 整32 乙) -> 布尔 {
    布尔 同 = 甲 == 乙;
    返回 同;
}

函数 主() -> 整32 {
    打印("较大一=");
    打印(较大(7, 3));
    打印("较大二=");
    打印(较大(2, 8));
    布尔 旗 = 判等(5, 5);
    如果 (旗) {
        打印("相等分支进入");
    }
    如果 (判等(5, 6)) {
        打印("不应进入");
    }
    字符串 名 = "窥孔";
    打印("串=");
    打印(名);
    浮64 甲 = 1.5;
    浮64 乙 = 2.5;
    如果 (甲 == 1.5) {
        打印("浮点相等");
    }
    如果 (乙 == 1.5) {
        打印("不应进入浮点");
    }
    返回 0;
}
