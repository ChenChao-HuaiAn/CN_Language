// E2E 1439（1281 P1 返工·2026-10-21）：窄型回绕算术结果规范化（001 §3.7a）——
//   显式回绕内置 回绕加/回绕减/回绕乘 与窄型移位对 整8/正8/整16/正16 的
//   32 位计算结果必须按声明窄宽 movsx/movzx 回窄域后再进入消费点。修复前
//   宿主 win-x64 O0（无寄存器分配）结果槽存 32 位完整和/积（u8 255+1=256、
//   i8 100+100=200、u8 200<<1=400），直连比较读 32 位 → 判假；linux/arm64
//   与 v2 均正确=宿主 win 单端分叉（1281 P1）。
//   本用例用**变量实参+直接比较**（结果驻留 vreg 后即比较，不经窄变量 Store
//   再窄化），并以 编译选项.txt=-O0 锁定槽目标形态；寄存器目标形态由同轮
//   x64 直写路径判据（同一 normalizeNarrowResult 单点）覆盖。
//   校验位权 1..8192：十四形态全过=16383（任一失败即定位到具体位）。
//   双编译对照：宿主与 v2 同源同测，输出/退出码逐行一致。
函数 主() -> 整32 {
    整32 校验 = 0;
    // ---- 整8（有符号）加/减/乘 ----
    整8 甲 = 100;
    整8 甲一 = 100;
    如果 (回绕加(甲, 甲一) == 整8(-56)) { 校验 = 校验 + 1; }
    整8 乙 = -128;
    整8 乙一 = 1;
    如果 (回绕减(乙, 乙一) == 整8(127)) { 校验 = 校验 + 2; }
    整8 丙 = 100;
    整8 丙一 = 2;
    如果 (回绕乘(丙, 丙一) == 整8(-56)) { 校验 = 校验 + 4; }
    // ---- 正8（无符号）加/减/乘 ----
    正8 丁 = 255;
    正8 丁一 = 1;
    如果 (回绕加(丁, 丁一) == 正8(0)) { 校验 = 校验 + 8; }
    正8 戊 = 0;
    正8 戊一 = 1;
    如果 (回绕减(戊, 戊一) == 正8(255)) { 校验 = 校验 + 16; }
    正8 己 = 200;
    正8 己一 = 2;
    如果 (回绕乘(己, 己一) == 正8(144)) { 校验 = 校验 + 32; }
    // ---- 整16（有符号）加/减/乘 ----
    整16 庚 = 30000;
    整16 庚一 = 30000;
    如果 (回绕加(庚, 庚一) == 整16(-5536)) { 校验 = 校验 + 64; }
    整16 辛 = -32768;
    整16 辛一 = 1;
    如果 (回绕减(辛, 辛一) == 整16(32767)) { 校验 = 校验 + 128; }
    整16 壬 = 300;
    整16 壬一 = 300;
    如果 (回绕乘(壬, 壬一) == 整16(24464)) { 校验 = 校验 + 256; }
    // ---- 正16（无符号）加/减/乘 ----
    正16 癸 = 65535;
    正16 癸一 = 1;
    如果 (回绕加(癸, 癸一) == 正16(0)) { 校验 = 校验 + 512; }
    正16 子 = 0;
    正16 子一 = 1;
    如果 (回绕减(子, 子一) == 正16(65535)) { 校验 = 校验 + 1024; }
    正16 丑 = 60000;
    正16 丑一 = 2;
    如果 (回绕乘(丑, 丑一) == 正16(54464)) { 校验 = 校验 + 2048; }
    // ---- 窄型移位结果按类型宽度截断（同族：移位量域内，结果域按位宽丢弃高位）----
    正8 寅 = 200;
    正8 寅一 = 1;
    如果 ((寅 << 寅一) == 正8(144)) { 校验 = 校验 + 4096; }
    整8 卯 = -100;
    整8 卯一 = 1;
    如果 ((卯 << 卯一) == 整8(56)) { 校验 = 校验 + 8192; }
    打印(校验);
    返回 0;
}
