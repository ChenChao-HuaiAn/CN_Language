// E2E 158_v2_linuxx64_系统V调用约定（plans/017 T4，2026-09-06）
// v2 版 SysV AMD64 ABI 分歧面专项：v2p（v2 自举编译器）--target linux-x86_64
//   产物（X64L 后端 GAS）经 as/g++ 链接运行（v2 闭环 runner 形态）。
// 本用例三平台语义一致（win-x64 / linux-arm64 / linux-x86_64 全量各跑一遍），
//   重点锚定 SysV 特有路径：
//   ① 第 6/7 参数边界——前 6 走 rdi..r9，第 7 走栈（被调方 [rbp+16+8k]）；
//   ② 结构体返回——SysV 隐藏 retbuf 指针 rdi（被调方拷贝 + rax=retbuf 地址）；
//   ③ 结构体按值参数拷贝 × 满 6 整型寄存器位——宿主第十八轮「prologue 拷贝
//     循环临时寄存器误用 r9」缺陷的 v2 侧同款探针（v2 X64L 纪律：拷贝数据
//     临时一律取参数寄存器集合之外的 r10/r11——任一拷贝破坏后位实参即和值错）；
//   ④ 结构体返回 + 7 参数——retbuf 占 rdi 后实参整体后移一位（位 6 实参走栈），
//     宿主 154 同款触发面（栈参数锚定基随隐藏返回指针移位）；
//   ⑤ 递归——栈帧嵌套对齐纪律。
// 断言：返回码 0 = 全过；11~19 失败码逐分歧面定位。
// 结构体 >8 字节走 retbuf（点 = 2×整64 = 16 字节）。

// ===== 分歧面①：7 整型参数（第 7 参数走 SysV 栈参数区）=====
函数 和7(整32 a, 整32 b, 整32 c, 整32 d, 整32 e, 整32 f, 整32 g) -> 整32 {
    返回 a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6 + g * 7;
}

// ===== 分歧面②：结构体返回（SysV 隐藏 retbuf 指针）=====
结构体 点 {
    整64 x;
    整64 y;
}

函数 造点(整64 甲, 整64 乙) -> 点 {
    点 p;
    p.x = 甲;
    p.y = 乙;
    返回 p;
}

// ===== 分歧面③：结构体按值参数 × 满 6 参数位 =====
//   6 个结构体实参占满 rdi..r9（B3 调用方约定：按值结构体=指针传入），
//   被调方 prologue 逐个拷贝（r10 源指针 + r11 数据）——拷贝临时寄存器
//   纪律探针：误用参数寄存器会破坏后位实参
函数 六点和(点 p1, 点 p2, 点 p3, 点 p4, 点 p5, 点 p6) -> 整64 {
    返回 p1.x + p1.y + p2.x + p2.y + p3.x + p3.y + p4.x + p4.y + p5.x + p5.y + p6.x + p6.y;
}

// ===== 分歧面④：结构体返回 + 7 参数（retbuf 占 rdi，第 7 实参走栈）=====
函数 加权点(整64 基, 整64 a, 整64 b, 整64 c, 整64 d, 整64 e, 整64 f) -> 点 {
    点 r;
    r.x = 基 + a + b + c;
    r.y = d + e + f;
    返回 r;
}

// ===== 分歧面⑤：递归（栈帧嵌套）=====
函数 阶乘(整32 n) -> 整64 {
    如果 (n <= 1) {
        返回 1;
    }
    返回 n * 阶乘(n - 1);
}

函数 主() -> 整32 {
    // ①：1+4+9+16+25+36+49 = 140（第 7 实参 7 经栈区正确取到）
    如果 (和7(1, 2, 3, 4, 5, 6, 7) != 140) { 返回 11; }

    // ②：结构体返回 + 字段读（retbuf 内容完整）
    点 q = 造点(3, 4);
    如果 (q.x != 3) { 返回 12; }
    如果 (q.y != 4) { 返回 13; }

    // ③：六点和((1,1)..(6,6)) = 2+4+6+8+10+12 = 42（满 6 位拷贝互不破坏）
    点 a = 造点(1, 1);
    点 b = 造点(2, 2);
    点 c = 造点(3, 3);
    点 d = 造点(4, 4);
    点 e = 造点(5, 5);
    点 f = 造点(6, 6);
    如果 (六点和(a, b, c, d, e, f) != 42) { 返回 14; }

    // ③b：按值实参=嵌套调用（rax=retbuf 地址即按值实参地址，148 同款形态）
    如果 (六点和(造点(1, 1), b, c, d, e, f) != 42) { 返回 15; }

    // ④：基=1 实参 1..6 → x=1+1+2+3=7 y=4+5+6=15（第 7 实参 f=6 走栈）
    点 w = 加权点(1, 1, 2, 3, 4, 5, 6);
    如果 (w.x != 7) { 返回 16; }
    如果 (w.y != 15) { 返回 17; }

    // ⑤：5! = 120
    如果 (阶乘(5) != 120) { 返回 18; }

    // ②b：多次返回独立（retbuf 复用不串扰）
    点 r = 造点(100, 200);
    如果 (r.x + r.y != 300) { 返回 19; }
    如果 (q.x + q.y != 7) { 返回 20; }

    返回 0;
}
