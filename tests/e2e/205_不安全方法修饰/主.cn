// E2E 205（宿主正测，2026-09-10 第六十三轮 plans/019 阶段4 第二层第一批）：
//   类方法 不安全 修饰位+stdlib 裸指针算法 API 迁移锚定——不安全方法内裸
//   操作零警告；安全函数调用（main 调 裸清/排序）=责任上移零警告零行为影响。
//   期望 stdout：5 / 30。
导入 算法::排序整32;
类 持有 {
公开:
    整64* 数据;
    函数 持有() {
        数据 = 分配(8);
    }
    不安全 函数 裸清() {
        释放(数据);
        数据 = 无;
    }
}
函数 主() -> 整32 {
    持有 h = 持有();
    h.裸清();
    打印(5);
    整32[3] 表 = { 3, 1, 2 };
    排序整32(表, 3);
    打印(表[0] + 表[1] + 表[2]);
    返回 0;
}
