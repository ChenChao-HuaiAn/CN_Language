// v2 语义拒绝形态合集（R0 测试面解耦轮 2026-09-08）：承接 原 v2 主.cn 内置
//   负测自检链（源码2~源码13 十二形态）的拒绝能力锚定——自检链删除后，
//   拒绝能力由本负路径用例承接（一个源码多错误形态，语义层全量收集诊断）。
//   预期：v2p 编译失败（退出码非 0）、不产 asm、expected 固化全部 [错误]
//   契约诊断行（对齐 139 语义错误即中止纪律）。
// 形态清单（对应原自检 源码2~源码13）：
//   未声明标识符 / 字符串复合赋值 / 非指针下标 / 字符串下标写 / 非左值赋值 /
//   常量赋值 / 未注册限定名 / 三元分支跨类 / 常量自减 / 未声明自减 /
//   未导入裸调 / 结果字面量初始化
常量 丙 = 5;
常量 丁 = 5;

函数 坏1() -> 整32 { 返回 x + 1; }
函数 坏2(字符串 名) -> 整32 { 名 += 名; 返回 0; }
函数 坏3(整64 数) -> 整32 { 返回 数[0]; }
函数 坏4(字符串 s) -> 整32 { s[0] = 65; 返回 0; }
函数 坏5(整64 a) -> 整32 { a + 1 = 7; 返回 0; }
函数 坏6() -> 整32 { 丙 = 7; 返回 0; }
函数 坏7() -> 整32 { 不存在::打印(1); 返回 0; }
函数 坏8(整64 a) -> 整32 { 字符串 s = a > 0 ? "甲" : a; 返回 0; }
函数 坏9() -> 整32 { 丁--; 返回 0; }
函数 坏10() -> 整32 { 未声明量--; 返回 0; }
函数 坏11() -> 整32 { 打开文件("x.cn", 1); 返回 0; }
函数 坏12() -> 整32 { 结果<空类型, 整32> x = 无; 返回 0; }

函数 主() -> 整32 {
    返回 0;
}
