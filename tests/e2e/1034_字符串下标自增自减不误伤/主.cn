// E2E 1034 正测（任务 618·2026-10-16）：字符串下标自增自减语义拒=**不误伤**
//   回归锚——同一改动后以下合法形态必须照常放行并产出正确结果：
//   ①整数组下标自增 a[0]++ ②整数组变量下标自减 a[i]--
//   ③字符串下标**读**（s[1] 字节读+读值变量自增 c++·读面不受写拒影响）
//   ④结构体字段数组下标自增 t.数[0]++
//   ⑤指针下标自增 p[0]++（不安全 函数内·B7 边界照常）
//   双编译对照正测：同源码两侧各编各跑，运行输出逐行全等（断言输出=是）。
//   金标推导：a=[1,2,3] →a[0]++→[2,2,3] →a[2]--→[2,2,2]；t.数=[10,20]
//   →t.数[0]++→[11,20]；指针自增(&a[0])→a[0]=3 返回 3；
//   和=3+2+2+11+20+3=41。
结构体 表 {
    整32[2] 数;
}

不安全 函数 指针自增(整32* p) -> 整32 {
    p[0]++;
    返回 p[0];
}

函数 主() -> 整32 {
    整32[3] a;
    a[0] = 1;
    a[1] = 2;
    a[2] = 3;
    a[0]++;
    字符串 s = "AB";
    整8 c = s[1];
    c++;
    表 t;
    t.数[0] = 10;
    t.数[1] = 20;
    t.数[0]++;
    整64 i = 2;
    a[i]--;
    整32 v = 指针自增(&a[0]);
    整32 和 = 整32(a[0]) + 整32(a[1]) + 整32(a[2]) + 整32(t.数[0]) + 整32(t.数[1]) + v;
    打印("和=", 和);
    返回 0;
}
