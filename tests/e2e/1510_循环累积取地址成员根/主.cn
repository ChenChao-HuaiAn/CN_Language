// 1510 循环累积取地址成员根（750 复审5 P1-1·双编译性能向）
//   病：显式取地址非标识符（&槽.数）宿主 hasAlias 抑制、v2 未抑制（v2 取地址
//   扫描只处理标识符根）→ 产物不一致（无语义错值）。
//   修：v2 取地址扫描「根非标识符」分支补 累积函数有别名750=真（与宿主同口径）。
//   负载：循环前 `整64* p = &槽.数` + 循环累积 s。
//   预期：长=2048 / 取地址成员优化=0 次=2048（少优化但正确·双侧一致）。
结构体 盒 {
    整64 数;
}

不安全 函数 主() -> 整32 {
    字符串 s = "";
    盒 槽 = 盒{ 数 = 7 };
    整64* 指针 = &槽.数;
    如果 (*指针 < 0) { 返回 1; }
    整64 前 = 内存::总分配次数();
    循环 (整64 k = 0; k < 2048; k++) {
        s = s + "x";
    }
    整64 次 = 内存::总分配次数() - 前;
    打印("长=", 整数转字符串(字符串长度(s)));
    布尔 降 = 次 <= 6;
    如果 (降) { 打印("取地址成员优化=1"); } 否则 如果 (次 > 6) {
        打印("取地址成员优化=0 次=", 整数转字符串(次));
    }
    返回 0;
}
