// 803_删单析构双调（任务 224·2026-10-12）：注入链表 删单（删除头部/删除尾部）
//   的被摘元素析构**恰一次**断言——锁 221 r10（a7186579）根治面：实验甲轮
//   python 替换曾误复制 call ~T 段（删头 0x4d6e+0x4d7f / 删尾 0x5487+0x5498
//   各 call ×2·产物反汇编计数法实锤）→ 删重复段即愈。224 行（删尾 计数 2 应 1）
//   与 222 系同一观察（r9 权料同文字），本用例锁行为防回归。
//   断言面（析构计数逐行锚定）：
//     ① 删头/删尾 各恰 +1（双调=计数跳 2 必红）
//     ② 单元素 删尾（元素数量==1 分支）恰 +1
//     ③ 清空 = 剩余元素全量（不重复计已删元素）
//     ④ 83-a 空闲链槽复用后再删：不重析构旧对象
//     ⑤ ~链表 残余全量恰一次 + 源变量块出口 RAII
//   dual：宿主/v2 双编译逐行比对（析构注入两侧同构=全量双测铁律执行面）。

导入 容器::链表;

静态 整64 计数 = 0;

类 资源 {
公开:
    整64 编号;
    函数 资源(整64 v) { 编号 = v; }
    函数 资源(资源& 其他) { 编号 = 其他.编号; }
    不安全 函数 ~资源() { 计数 = 计数 + 1; }
}

函数 主() -> 整32 {
    // ① 多元素：删头 +1、再删尾 +1（221 r9 双调观察形态·直发版）
    {
        链表<资源> 表;
        资源 r1 = 资源(1);
        资源 r2 = 资源(2);
        结果<空类型, 整32> a1 = 表.追加(r1);
        结果<空类型, 整32> a2 = 表.追加(r2);
        结果<空类型, 整32> d1 = 表.删除头部();   // 恰 +1
        打印("删头后: ", 计数);                  // 1
        结果<空类型, 整32> d2 = 表.删除尾部();   // 恰 +1（双调则 3）
        打印("删尾后: ", 计数);                  // 2
    }
    打印("块一: ", 计数);                        // 4 = 删 2 + r1/r2 块出口
    // ② 单元素 删尾（元素数量==1 分支：头尾索引同槽）
    {
        链表<资源> 表;
        资源 r1 = 资源(1);
        结果<空类型, 整32> a1 = 表.追加(r1);
        结果<空类型, 整32> d1 = 表.删除尾部();   // 恰 +1
        打印("单删尾后: ", 计数);                // 5
    }
    打印("块二: ", 计数);                        // 6
    // ③ 删头后 清空 = 剩余全量（2 个）——与已删元素零重复计
    {
        链表<资源> 表;
        资源 r1 = 资源(1);
        资源 r2 = 资源(2);
        资源 r3 = 资源(3);
        结果<空类型, 整32> a1 = 表.追加(r1);
        结果<空类型, 整32> a2 = 表.追加(r2);
        结果<空类型, 整32> a3 = 表.追加(r3);
        结果<空类型, 整32> d1 = 表.删除头部();   // +1
        打印("三删头后: ", 计数);                // 7
        表.清空();                               // 剩余 2 个全量 +2
        打印("清空后: ", 计数);                  // 9
    }
    打印("块三: ", 计数);                        // 12
    // ④ 83-a 空闲链槽复用：删头→追加（复用槽）→删尾——槽身份换人不重析构
    {
        链表<资源> 表;
        资源 r1 = 资源(1);
        资源 r2 = 资源(2);
        结果<空类型, 整32> a1 = 表.追加(r1);
        结果<空类型, 整32> a2 = 表.追加(r2);
        结果<空类型, 整32> d1 = 表.删除头部();   // +1
        结果<空类型, 整32> a3 = 表.追加(r1);     // 复用被摘槽
        结果<空类型, 整32> d2 = 表.删除尾部();   // 恰 +1（复用槽新对象）
        打印("复用删尾后: ", 计数);              // 14
        表.清空();                               // 剩余 1 个 +1
        打印("复用清空后: ", 计数);              // 15
    }
    打印("块四: ", 计数);                        // 17
    // ⑤ 带残余提前出块：~链表 全量恰一次 + 源变量块出口
    {
        链表<资源> 表;
        资源 r1 = 资源(1);
        资源 r2 = 资源(2);
        结果<空类型, 整32> a1 = 表.追加(r1);
        结果<空类型, 整32> a2 = 表.追加(r2);
        结果<空类型, 整32> d1 = 表.删除头部();   // +1
        打印("五删头后: ", 计数);                // 18
    }                                            // ~链表 +1（残余 1）+ r1/r2 +2
    打印("块五: ", 计数);                        // 21
    返回 0;
}
