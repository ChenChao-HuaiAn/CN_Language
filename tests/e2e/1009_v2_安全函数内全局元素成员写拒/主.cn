// E2E 1009（791 轮·001 §747-8 执法扩面锁面·569 采样 H4 修复锚）：安全函数内
//   「可变全局静态的元素/成员写」=编译错误——写目标为 下标/成员 链且根对象∈
//   可变全局集合（顶层静态/裸全局两半边；静态半边=任务台账 AI 补测实锤同漏），
//   与变量名直写同规则拦截（Rust `static mut` 的元素/字段写同属「访问」——
//   原判定只锁标识符直写三形态=间接目标静默绕过·双侧运行真写实证 rc=6/4/7）。
//   同一源码宿主+v2p **都必须编译拒绝**（诊断锚=[安全区边界]·双侧同文案）。
//   读取无限制；局部链/形参链与 不安全 函数内写不受本执法面约束（探针矩阵
//   另证·本用例只锁负向形态）。
// 预期失败。
整32[4] 表;                     // 裸全局数组（888 ⑧ 形态通道）
静态 整32[4] 静表;              // 顶层静态数组（静态半边）

结构体 点 {
    整32 甲;
    整32 乙;
}
点 原点;                        // 裸全局结构体（569 零值通道）
静态 点 静原点;                 // 顶层静态结构体

函数 违规写() {
    表[0] = 6;                  // 形态① 裸全局 数组元素 赋值
    静表[0] = 7;                // 形态② 顶层静态 数组元素 赋值（静态半边）
    原点.甲 = 4;                // 形态③ 裸全局 结构体成员 赋值
    静原点.甲 = 5;              // 形态④ 顶层静态 结构体成员 赋值（静态半边）
    表[1] += 3;                 // 形态⑤ 元素 复合赋值（读旧值改写）
    静表[1]++;                  // 形态⑥ 元素 自增（隐式写）
}

函数 主() -> 整32 {
    违规写();
    返回 表[0] + 静表[0] + 原点.甲 + 静原点.甲 + 表[1] + 静表[1];  // 读安全
}
