// 800（任务 464）：浮→整128/正128 全宽域对照——|值|≥2^63 域两侧全宽一致
//   缺陷面：v2 浮→128 走 cvttsd2si/fcvtzs 仅 64 位（超域饱和出垃圾），宿主走
//   __cn_f64_to_i128 运行时辅助全宽（#475 饱和化：NaN→0·超域→i128 边界）。
//   覆盖：2^63 边界上下/负域大值/域内截断/NaN/超 2^127 双向饱和/u128 无符号面。
//   注〔528 更新·475 甲案 Rust as 全对齐〕：正128(浮) 已切 __cn_f64_to_u128
//   无符号专用辅助（464 轮呈报面回收·双侧同构）——原「同调有符号辅助」的
//   u128(1e39)/u128(-1e19) 位模式锁行随饱和立法翻转为 u128::MAX/0（测试预期
//   随语义变更更新·非放宽：新值更严格对齐已批规范 plans/001 §3.7b）。
//   浮源一律显式 浮64 声明（推导型 变量 浮点面=独立缺陷另行立案）。
函数 主() -> 整32
{
    浮64 f大 = 1.0e19;
    浮64 f负 = -1.0e19;
    浮64 f界上 = 9223372036854775808.0;
    浮64 f界下 = 9223372036854774784.0;
    浮64 f小 = 1.0e18;
    浮64 f截 = 3.75;
    浮64 f超 = 1.0e39;
    浮64 f负超 = -1.0e39;
    浮64 fNaN = 0.0 / 0.0;
    整128 a = 整128(f大);
    打印行("i128(1e19)=", a);
    打印("");
    整128 b = 整128(f负);
    打印行("i128(-1e19)=", b);
    打印("");
    整128 c = 整128(f界上);
    打印行("i128(2^63)=", c);
    打印("");
    整128 d = 整128(f界下);
    打印行("i128(2^63-1024)=", d);
    打印("");
    整128 e = 整128(f小);
    打印行("i128(1e18)=", e);
    打印("");
    整128 g = 整128(f截);
    打印行("i128(3.75)=", g);
    打印("");
    整128 h = 整128(fNaN);
    打印行("i128(NaN)=", h);
    打印("");
    整128 i = 整128(f超);
    打印行("i128(1e39)=", i);
    打印("");
    整128 j = 整128(f负超);
    打印行("i128(-1e39)=", j);
    打印("");
    正128 p = 正128(f大);
    打印行("u128(1e19)=", p);
    打印("");
    正128 q = 正128(f超);
    打印行("u128(1e39)=", q);
    打印("");
    正128 r = 正128(f负);
    打印行("u128(-1e19)=", r);
    打印("");
    返回 0;
}
