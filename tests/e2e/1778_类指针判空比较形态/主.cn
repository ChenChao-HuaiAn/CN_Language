// E2E 1778（任务 2056·1104 对拍轨实锤锁面）：类指针判空比较形态——
//   ①链表遍历当循环头（游 != 无）②参数判空如果（根 == 无·递归面）
//   ③反向（无 == 游）④类指针 vs 类指针 / 类指针 vs 取址结果（&乙）
//   宿主基线=semantic_expr_binary.cpp 族⑤内置指针路径（isPointerType("节点*")
//   尾星判据=真·指针 vs 指针/空指针放行·指针 vs 非指针非空拒同文案）；
//   v2 修前把类指针变量推导剥星（指针变量表登记所指类型）→ 误入 414 类重载
//   报错面=「运算符 '!=' 与类型 '节点' 不兼容」分叉实锤
//   （tests/cnsmith_hits 归档 20261105_e1/e2/e3·宿主绿 v2 拒）。
//   指针直接布尔语境（如果 (游)）不在本锁面=双侧立法拒（443 严格布尔）。
类 节点 {
公开:
    整32 值;
    节点* 下个;
    节点* 左;
    节点* 右;
    函数 节点(整32 v) { 值 = v; 下个 = 无; 左 = 无; 右 = 无; }
}

// 形态②：参数判空如果（递归基——树节点* 根 == 无 直判）
不安全 函数 中序(节点* 根) -> 空类型 {
    如果 (根 == 无) { 返回; }
    中序(根.左);
    打印(根.值);
    中序(根.右);
}

不安全 函数 判空形态() -> 整32 {
    节点 甲 = 节点(1);
    节点 乙 = 节点(2);
    节点 丙 = 节点(3);
    甲.下个 = &乙;
    乙.下个 = &丙;
    // 形态①：当循环头判空（链表遍历）
    节点* 游 = &甲;
    当 (游 != 无) {
        打印(游.值);
        游 = 游.下个;
    }
    // 形态③：反向判空（循环后 游=无）
    如果 (无 == 游) { 打印(100); }
    // 形态④a：类指针 vs 类指针（非空直判）
    节点* 指乙 = &乙;
    如果 (指乙 != 无) { 打印(200); }
    // 形态④b：类指针 vs 取址结果（宿主 isPointer 双尾星放行）
    如果 (指乙 == &乙) { 打印(300); }
    // 形态②主体：二叉树参数判空递归中序
    节点 根 = 节点(5);
    节点 丁四 = 节点(4);
    节点 己六 = 节点(6);
    根.左 = &丁四;
    根.右 = &己六;
    中序(&根);
    返回 0;
}

函数 主() -> 整32 { 返回 判空形态(); }
