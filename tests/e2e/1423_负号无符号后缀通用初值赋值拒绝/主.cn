// E2E 1423（2026-10-20·任务 #1194）：负号+无符号后缀（-5U/-5ULL/-0xFFU 族）
//   通用初值/赋值/传参/返回/数组初值/条件/整128 目标全形态双侧拒绝负测。
//   宿主 parse 期一元负号折叠进字面量文本（323）→ integerLiteralRuntimeType
//   定级无符号族后负值恒超界→「整数字面量超出正128（2^128-1）范围」；
//   v2 修前仅按数学负值判目标域（-5 在整64 域内）→通用面全放行（零分叉
//   实锚：本用例每形态修前 v2 rc=0）。修后 v2 表达式分析点单点判拒
//   （检查表达式 字面量/负号分支 → 检查表达式负无符号1016·IR层判据
//   负无符号非零1016）；类静态/类实例字段面不动（宿主放行现状保持·1424
//   正测锁值）。双编译对照负测：同源码宿主+v2p 双侧等效拒绝。
函数 取(整64 值) -> 整64 { 返回 值; }
函数 回() -> 整64 { 返回 -5U; }
函数 主() -> 整32 {
    整64 甲 = -5ULL;
    整64 乙 = 0;
    乙 = -5U;
    整64[2] 丙 = {-0xFFU, 0};
    如果 (-5ULL < 0) { 乙 = 1; }
    整128 丁 = -0xFFULL;
    正64 戊 = -5U;
    取(-5U);
    回();
    返回 0;
}
