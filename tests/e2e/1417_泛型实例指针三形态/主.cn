// E2E 1417（1175·泛型实例指针三形态）：泛型类 节点<T> 的自引用指针字段链
//   三类型（整32/整64/字符串）× 三链深（一级/二级/三级）× 访问形态
//   （p.值 / (*p).值 / 甲.下.值）× 位置（局部声明/参数/返回位——自由函数
//   返回泛型实例指针后直接成员访问 / 返回表达式位）。
//   修前 v2 三红：① `节点<整32>* p` 声明前瞻漏判 → 语义层「未声明标识符 p」；
//   ② `(*甲.下).值` 解析期折叠误基址 → 静默读基对象字段（1 应 2/「甲值」应
//   「乙值」）；③ `甲.下.值`/三级链 → [ir2] 成员字段偏移未知（泛型实例字段
//   类型 节点<整32>* 的角括号文本与实例身份 节点$整32 断链）。
//   宿主与 v2 双侧编译运行，退出码 + 输出逐行一致（双编译对照）。
泛型 <类型 T> 类 节点 {
公开:
    T 值;
    节点<T>* 下;
    函数 节点(T v) { 值 = v; 下 = 无; }
}

// 返回位（1175 矩阵轴）：自由函数返回泛型实例指针——调用结果直接成员访问
//   （宿主语义层 类型文本后缀归一同步修复，见 semantic_sig.cpp genericClassInstanceName）。
不安全 函数 透32(节点<整32>* p) -> 节点<整32>* { 返回 p; }
不安全 函数 透64(节点<整64>* p) -> 节点<整64>* { 返回 p; }
不安全 函数 透串(节点<字符串>* p) -> 节点<字符串>* { 返回 p; }

不安全 函数 取32一(节点<整32>* p) -> 整32 { 返回 p.值; }
不安全 函数 取32二(节点<整32>* p) -> 整32 { 返回 (*p).值; }
不安全 函数 取32链(节点<整32>* p) -> 整32 { 返回 p.下.下.值; }

不安全 函数 取64一(节点<整64>* p) -> 整64 { 返回 p.值; }
不安全 函数 取64二(节点<整64>* p) -> 整64 { 返回 (*p).值; }
不安全 函数 取64链(节点<整64>* p) -> 整64 { 返回 p.下.下.值; }

不安全 函数 取串一(节点<字符串>* p) -> 字符串 { 返回 字符串复制(p.值); }
不安全 函数 取串二(节点<字符串>* p) -> 字符串 { 返回 字符串复制((*p).值); }
不安全 函数 取串链(节点<字符串>* p) -> 字符串 { 返回 字符串复制(p.下.下.值); }

不安全 函数 测整32() -> 整32 {
    节点<整32> 甲 = 节点<整32>(1);
    节点<整32> 乙 = 节点<整32>(2);
    节点<整32> 丙 = 节点<整32>(3);
    节点<整32> 丁 = 节点<整32>(4);
    甲.下 = &乙;
    乙.下 = &丙;
    丙.下 = &丁;
    打印(甲.值);
    打印(甲.下.值);
    打印(甲.下.下.值);
    打印(甲.下.下.下.值);
    节点<整32>* p = &甲;
    打印(p.值);
    打印((*p).值);
    打印(p.下.值);
    打印((*p.下).值);
    打印(p.下.下.值);
    打印((*p.下.下).值);
    打印(p.下.下.下.值);
    打印(取32一(&甲));
    打印(取32二(&甲));
    打印(取32链(&甲));
    打印(透32(&甲).值);
    打印((*透32(&甲)).值);
    打印(透32(&甲).下.值);
    打印((*透32(&甲).下).值);
    打印(透32(&甲).下.下.值);
    打印((*透32(&甲).下.下).值);
    返回 0;
}

不安全 函数 测整64() -> 整32 {
    节点<整64> 甲 = 节点<整64>(11);
    节点<整64> 乙 = 节点<整64>(22);
    节点<整64> 丙 = 节点<整64>(33);
    节点<整64> 丁 = 节点<整64>(44);
    甲.下 = &乙;
    乙.下 = &丙;
    丙.下 = &丁;
    打印(甲.值);
    打印(甲.下.值);
    打印(甲.下.下.值);
    打印(甲.下.下.下.值);
    节点<整64>* p = &甲;
    打印(p.值);
    打印((*p).值);
    打印(p.下.值);
    打印((*p.下).值);
    打印(p.下.下.值);
    打印((*p.下.下).值);
    打印(p.下.下.下.值);
    打印(取64一(&甲));
    打印(取64二(&甲));
    打印(取64链(&甲));
    打印(透64(&甲).值);
    打印((*透64(&甲)).值);
    打印(透64(&甲).下.值);
    打印((*透64(&甲).下).值);
    打印(透64(&甲).下.下.值);
    打印((*透64(&甲).下.下).值);
    返回 0;
}

不安全 函数 测字符串() -> 整32 {
    节点<字符串> 甲 = 节点<字符串>(字符串复制("甲值"));
    节点<字符串> 乙 = 节点<字符串>(字符串复制("乙值"));
    节点<字符串> 丙 = 节点<字符串>(字符串复制("丙值"));
    节点<字符串> 丁 = 节点<字符串>(字符串复制("丁值"));
    甲.下 = &乙;
    乙.下 = &丙;
    丙.下 = &丁;
    打印(甲.值);
    打印(甲.下.值);
    打印(甲.下.下.值);
    打印(甲.下.下.下.值);
    节点<字符串>* p = &甲;
    打印(p.值);
    打印((*p).值);
    打印(p.下.值);
    打印((*p.下).值);
    打印(p.下.下.值);
    打印((*p.下.下).值);
    打印(p.下.下.下.值);
    打印(取串一(&甲));
    打印(取串二(&甲));
    打印(取串链(&甲));
    打印(透串(&甲).值);
    打印((*透串(&甲)).值);
    打印(透串(&甲).下.值);
    打印((*透串(&甲).下).值);
    打印(透串(&甲).下.下.值);
    打印((*透串(&甲).下.下).值);
    返回 0;
}

不安全 函数 主() -> 整32 {
    测整32();
    测整64();
    测字符串();
    返回 0;
}
