// E2E 60_error_propagate：错误传播运算符 ?（C-1，2026-08）
// 覆盖：结果<T,E> 正常传播取 .值、错误传播沿调用链返回（Rust ? 语义）、
//   传播后继续表达式运算（x? + 1）、可选<T> 传播（有值/无值）、
//   两层传播（内层? 错误逐层外抛）、错误码类型转换传播（整32 -> 整64）、
//   ? 用于函数调用实参（打印(安全除法(a, b)?)）
// 语法依据：CN语言规范 07（错误处理）+ C-1 后缀 表达式?（结果/可选 取值，
//   失败则构造错误结果并返回——与 C++23 std::expected 传播、Rust ? 同语义）

// 内层函数：返回 结果<整32, 整32>（错误码 1 = 除零）
函数 安全除法(整32 a, 整32 b) -> 结果<整32, 整32> {
    如果 b == 0 {
        返回 错误(1)
    }
    返回 正常(a / b)
}

// 传播层1：安全除法(a, b)? —— 正常时取 .值继续（商），失败直接返回
函数 除法传播(整32 a, 整32 b) -> 结果<整32, 整32> {
    整32 商 = 安全除法(a, b)?
    返回 正常(商)
}

// 传播层2：错误沿两级调用链返回（内层除零 -> 除法传播 -> 除法传播两层 -> 主）
函数 除法传播两层(整32 a, 整32 b) -> 结果<整32, 整32> {
    返回 正常(除法传播(a, b)?)
}

// 传播后继续表达式运算：x? + 1（后缀优先级保证 (x?) + 1）
函数 除法加一(整32 a, 整32 b) -> 结果<整32, 整32> {
    返回 正常(安全除法(a, b)? + 1)
}

// 错误码类型可转换传播：内层 结果<T,整32> 传播到 返回 结果<T,整64>
函数 除法宽错误(整32 a, 整32 b) -> 结果<整32, 整64> {
    返回 正常(安全除法(a, b)?)
}

// ? 用于函数调用实参（打印参数位置）
函数 打印商(整32 a, 整32 b) -> 结果<整32, 整32> {
    打印("1. 正常传播: ", 安全除法(a, b)?)
    返回 正常(0)
}

// 可选<T> 传播：某些(名) / 无
函数 查找名字(整32 编号) -> 可选<字符串> {
    如果 编号 == 1 {
        返回 某些("张三")
    }
    返回 无
}
函数 查找传播(整32 编号) -> 可选<字符串> {
    字符串 名 = 查找名字(编号)?
    返回 某些("问候: " + 名)
}
函数 打印名字(整32 编号) -> 可选<字符串> {
    打印("6. 可选传播: ", 查找名字(编号)?)
    返回 某些("完成")
}

函数 主() -> 整32 {
    打印("===== 错误传播运算符 ?（C-1）=====")

    // 1. ? 在调用实参位置：正常分支取 .值打印
    结果<整32, 整32> 打印结果 = 打印商(10, 2)
    如果 打印结果.正常 {
        打印("1. 检查通过")
    } 否则 {
        打印("1. 意外错误: ", 打印结果.错误)
    }

    // 2. 错误传播：除零错误码沿调用链返回
    结果<整32, 整32> 错误结果 = 除法传播(10, 0)
    如果 错误结果.正常 {
        打印("2. 意外正常")
    } 否则 {
        打印("2. 传播错误码: ", 错误结果.错误)
    }

    // 3. 两层传播：内层错误逐层外抛
    结果<整32, 整32> 两层 = 除法传播两层(10, 0)
    如果 两层.正常 {
        打印("3. 意外正常")
    } 否则 {
        打印("3. 两层传播错误码: ", 两层.错误)
    }

    // 4. 传播后继续运算：(10/2)? + 1 = 6
    结果<整32, 整32> 加一结果 = 除法加一(10, 2)
    如果 加一结果.正常 {
        打印("4. 传播后运算: ", 加一结果.值)
    } 否则 {
        打印("4. 意外错误: ", 加一结果.错误)
    }

    // 5. 错误码类型转换：整32 -> 整64（符号扩展，高位无垃圾）
    结果<整32, 整64> 宽 = 除法宽错误(10, 0)
    如果 宽.正常 {
        打印("5. 意外正常")
    } 否则 {
        打印("5. 宽错误码: ", 宽.错误)
    }

    // 6. 可选<T> 传播：? 在调用实参位置，有值分支
    可选<字符串> 名字结果 = 打印名字(1)
    如果 名字结果.有值 {
        打印("6. 检查通过: ", 名字结果.值)
    } 否则 {
        打印("6. 意外无值")
    }

    // 7. 可选<T> 传播：赋值位置，无值分支（返回 无）
    可选<字符串> 无结果 = 查找传播(3)
    如果 无结果.有值 {
        打印("7. 意外有值")
    } 否则 {
        打印("7. 可选无值传播")
    }

    打印("===== 错误传播测试完成 =====")
    返回 0
}
