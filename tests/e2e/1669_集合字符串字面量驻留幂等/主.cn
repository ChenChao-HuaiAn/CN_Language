// E2E 1669 集合字符串字面量驻留幂等（#1328·2026-10-31 用户批甲案·v2 字面量驻留化）：
//   集合<字符串> 字面量实参走驻留句柄通道（同文本=同 strData_<文本ID> 数据标签
//   →槽字节判定同串同槽）——添加幂等/包含/删除/大小 全操作面两侧一致。
//   病根：v2 归一化入容器实参 684-a 把字面量拥有化复制（__cn_str_copy 落堆），
//   同文本两次添加=两个堆地址→哈希判重失效（大小 3·包含/删除不命中）；宿主
//   normalizeStringValueSource ①字面量=驻留借用直存（幂等）——双侧分叉。
//   修法：v2 恢复字面量驻留直存（对齐宿主①分支）；释放侧 cn_free_tracked 对
//   非在册驻留地址忽略（空安全·runtime mem_api ③）+ 删除单槽释放 同安全。
// 锁面：①添加幂等（甲乙甲→2）②包含命中/未命中 ③删除命中（返回真+大小减+
//   再包含假）④扩容重哈希后幂等仍成立（>6 元素触发桶翻倍）⑤变量串副本身份
//   （堆串/字面量初始化局部 同内容二次添加=+2；原句柄包含/删除不命中——1443
//   六段同款·两侧一致现状锁定）⑥直存元素内容完好（搅动压力后 删除/包含 判等
//   路径读槽内容正确）⑦清空复用后再添加幂等。
导入 映射集合::集合;

函数 主() -> 整32 {
    // ①②③ 添加幂等 + 包含 + 删除（字面量直传）
    集合<字符串> 集 = 集合<字符串>();
    结果<空类型, 整32> 加一 = 集.添加("甲");
    如果 (!加一.正常) { 返回 1; }
    结果<空类型, 整32> 加二 = 集.添加("乙");
    如果 (!加二.正常) { 返回 1; }
    结果<空类型, 整32> 加三 = 集.添加("甲");
    如果 (!加三.正常) { 返回 1; }
    打印行("一大小="); 打印(集.大小());
    打印行("包含甲="); 打印(集.存在("甲"));
    打印行("包含乙="); 打印(集.存在("乙"));
    打印行("包含丙="); 打印(集.存在("丙"));
    布尔 删甲 = 集.删除("甲");
    打印行("删甲返回="); 打印(删甲);
    打印行("删甲后大小="); 打印(集.大小());
    打印行("删甲后包含甲="); 打印(集.存在("甲"));
    打印行("删甲后包含乙="); 打印(集.存在("乙"));
    布尔 删甲再 = 集.删除("甲");
    打印行("再删甲返回="); 打印(删甲再);
    // ④ 扩容重哈希后幂等：8 个不同字面量触发桶翻倍（负载因子 3/4·8 桶→6 元素扩）
    集合<字符串> 扩集 = 集合<字符串>();
    整64 序 = 0;
    当 (序 < 8) {
        字符串 标 = 字符串连接("键字面量", 整数转字符串(序));
        结果<空类型, 整32> 加扩 = 扩集.添加(标);
        如果 (!加扩.正常) { 返回 1; }
        序++;
    }
    // 堆串拼接产物=拥有串：同句柄二次添加=副本身份 +1（见⑤）；字面量面幂等
    //   用独立字面量重复添加验证（重哈希后同文本=同槽）
    结果<空类型, 整32> 加扩九 = 扩集.添加("固定字面量键甲乙丙");
    如果 (!加扩九.正常) { 返回 1; }
    结果<空类型, 整32> 加扩十 = 扩集.添加("固定字面量键甲乙丙");
    如果 (!加扩十.正常) { 返回 1; }
    打印行("扩容后大小="); 打印(扩集.大小());
    打印行("扩容后包含固定="); 打印(扩集.存在("固定字面量键甲乙丙"));
    布尔 删固 = 扩集.删除("固定字面量键甲乙丙");
    打印行("扩容后删固定="); 打印(删固);
    打印行("扩容删后大小="); 打印(扩集.大小());
    // ⑤ 变量串副本身份锁定（双侧一致现状·1443 六段同款）：
    //   堆串（字符串复制产物）入容器=拥有化副本——同句柄二次添加=两个元素，
    //   原句柄包含/删除均不命中（内容相等键请用 字符串映射）
    字符串 堆甲 = 字符串复制("堆串内容甲乙丙丁戊己庚辛");
    集合<字符串> 堆集 = 集合<字符串>();
    结果<空类型, 整32> 堆加一 = 堆集.添加(堆甲);
    如果 (!堆加一.正常) { 返回 1; }
    结果<空类型, 整32> 堆加二 = 堆集.添加(堆甲);
    如果 (!堆加二.正常) { 返回 1; }
    打印行("堆串二次添加后大小="); 打印(堆集.大小());
    打印行("堆串原句柄包含="); 打印(堆集.存在(堆甲));
    布尔 堆删 = 堆集.删除(堆甲);
    打印行("堆串原句柄删除="); 打印(堆删);
    //   字面量初始化局部（借用/拥有语义随初始化面）同内容两变量：逐个添加
    //   =逐个归一化判定（非字面量直传面·与堆串同语义）
    字符串 甲一 = "甲乙丙";
    字符串 甲二 = "甲乙丙";
    集合<字符串> 变集 = 集合<字符串>();
    结果<空类型, 整32> 变加一 = 变集.添加(甲一);
    如果 (!变加一.正常) { 返回 1; }
    结果<空类型, 整32> 变加二 = 变集.添加(甲二);
    如果 (!变加二.正常) { 返回 1; }
    打印行("变量串两加后大小="); 打印(变集.大小());
    // ⑥ 直存元素内容完好：字面量元素在搅动压力后 判等路径（删除/包含）读槽正确
    集合<字符串> 内容集 = 集合<字符串>();
    结果<空类型, 整32> 内一 = 内容集.添加("内容完好性检查字面量甲乙丙丁");
    如果 (!内一.正常) { 返回 1; }
    整64 搅 = 0;
    整64 搅和 = 0;
    当 (搅 < 24) {
        字符串 垃圾 = 字符串复制("搅动内存填充占位字符串内容甲乙丙丁戊己庚辛");
        搅和 = 搅和 + 字符串长度(垃圾);
        搅++;
    }
    打印行("搅后包含="); 打印(内容集.存在("内容完好性检查字面量甲乙丙丁"));
    布尔 内容删 = 内容集.删除("内容完好性检查字面量甲乙丙丁");
    打印行("搅后删除="); 打印(内容删);
    打印行("搅后大小="); 打印(内容集.大小());
    打印行("搅和="); 打印(搅和);
    // ⑦ 清空复用后再添加幂等
    内容集.清空();
    结果<空类型, 整32> 复一 = 内容集.添加("复用字面量丁戊己庚");
    如果 (!复一.正常) { 返回 1; }
    结果<空类型, 整32> 复二 = 内容集.添加("复用字面量丁戊己庚");
    如果 (!复二.正常) { 返回 1; }
    打印行("清空复用后大小="); 打印(内容集.大小());
    返回 0;
}
