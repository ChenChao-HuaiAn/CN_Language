// E2E 734 类窄字段实宽布局与写宽分派双编译对照（463·#370 同域根治）：
//   v2 类字段布局自 8/8 槽（413 保守态）回**实宽**+写侧按字段类型码分派
//   （dword/word/byte·与宿主 computeClassLayout/字段写发射同构）——读写同源
//   对称：布局实宽、写宽≤字段实宽、读侧符号扩展，类尺寸/偏移与宿主一致
//   （内部 ABI 对齐·413 呈报挂账收口）；#370 整32 字段写穿相邻字段自然消解。
// 覆盖：①混排布局（整32/整8/整16/整32/整8）构造位写读回 ②成员写各宽度
//   （含负值符号语义）③写穿邻域守卫（#370 形态：写窄字段不得扰动相邻字段
//   ——旧恒 qword 写会清零相邻槽）④方法内 this 裸字段写与读 ⑤自增表达式
//   位写回窄域 ⑥继承并入侧（基类字段沿链）实宽布局值语义。
类 基量 {
公开:
    整32 宽;
    整8 标;
    函数 基量() { 宽 = 11; 标 = 22; }
    函数 置标(整8 v) { 标 = v; }
    函数 取标() -> 整8 { 返回 标; }
}

类 混排 : 基量 {
公开:
    整16 亮;
    整32 高;
    整8 尾;
    函数 混排() { 亮 = 300; 高 = -7; 尾 = 9; }
    函数 增亮() { 亮++; }   // 方法内裸字段自增（语句位·读写宽分派面）
}

函数 主() -> 整32 {
    混排 r = 混排();
    // ① 构造位写后读回（偏移+读写宽对称）
    打印("构造: ", r.宽, " ", r.标, " ", r.亮, " ", r.高, " ", r.尾);
    // ② 成员写各宽度（含负值符号扩展语义）
    r.宽 = -100;
    r.标 = -5;
    r.亮 = -300;
    r.高 = 123456;
    r.尾 = 127;
    打印("写后: ", r.宽, " ", r.标, " ", r.亮, " ", r.高, " ", r.尾);
    // ③ #370 形态：写 整32 宽 后相邻 标/亮/高 不得受扰
    r.宽 = 77;
    打印("守卫: ", r.宽, " ", r.标, " ", r.亮);
    // ④ 方法内 this 裸字段写 + 方法读
    r.置标(-9);
    打印("方法: ", r.取标(), " ", r.标);
    // ⑤ 自增表达式位写回（窄域）
    r.宽 = r.宽 + 1;
    r.亮 = r.亮 + 1;
    打印("自增: ", r.宽, " ", r.亮);
    // ⑥ 自增/自减读写宽分派（463 修面：表达式位成员链 + 方法内裸字段——
    //   布局实宽下恒 qword 读写踩相邻窄字段）
    r.尾++;
    r.亮--;
    打印("增减: ", r.尾, " ", r.亮);
    r.增亮();
    打印("增亮: ", r.亮);
    返回 0;
}
