// v2 位运算探针：五算子+复合赋值+移位掩码（2026-09-09）
函数 主() -> 整32 {
    整64 与 = 12 & 10;        // 8
    整64 或 = 12 | 10;        // 14
    整64 异或 = 12 ^ 10;      // 6
    整64 左 = 3 << 4;         // 48
    整64 右 = 48 >> 2;        // 12
    整64 掩码 = 1 << 70;      // 70 mod 64 = 6 -> 64（定义掩码语义）
    整64 f = 6;
    f <<= 2;                  // 24
    f |= 1;                   // 25
    f ^= 1;                   // 24
    整64 总 = 与 + 或 + 异或 + 左 + 右 + 掩码 + f;   // 8+14+6+48+12+64+24 = 176
    返回 整32(总);
}
