// E2E 220（2026-09-12 第七十六轮，plans/020 矩阵靶子「映射 删除(键) 释放被删项
//   字符串」+ 同族缺口扫描）：**映射/集合/向量/链表/队列 的「移除-覆盖-清空」
//   路径字符串所有权完备性**（宿主侧，八形态折校验和 255，退出码恒 0）。
//   背景（探针 76 实证，全部可复现）：容器拥有元素所有权（74-a/75-a 模型）下，
//   凡「句柄离开容器」的路径都必须在句柄消失前释放——
//     · 映射 删除(键)：交换式删除覆盖被删槽 → 被删项值串泄漏（探针 76-A/B）；
//     · 映射 设置覆盖已有键：旧值句柄被覆盖丢弃 → 泄漏（76-C）；
//     · 映射 释放内部数组（H8-5 显式销毁路径）：漏注入 → 键/值串泄漏（76-D）；
//     · 集合<T>：元素串原无释放面（析构/清空 泄漏，76-E/S1）；
//     · 向量 删除(位置)（移位浅拷覆盖）/设置覆盖：旧句柄泄漏（76-V1/V2）；
//     · 链表 删除头部/删除尾部（被摘槽出链）/清空（链头归 -1）：泄漏（76-L1~L3）；
//     · 队列 清空：同上（76-Q1）；
//     · 映射入容器位未归一化：借用来源句柄浅存 → 容器析构释放调用方串（UAF，76-F）。
//   修复（76-a，Rust 容器所有权模型对照 + C++ erase/insert_or_assign 就地析构）：
//     · 入容器位归一化扩到 映射（值侧）与 集合——借用来源复制落堆（容器独立拥有）、
//       拥有返回/转移 零拷贝接管（Rust push(s.clone()) / push(s) 同款）；
//     · 移除路径 stdlib 挂点（析构键值/析构值/析构元素——空体，编译器按 K/V/T
//       是否字符串注入）+ 运行时 __cn_map_free_slot / __cn_seq_free_slot；
//     · 清空/析构全量路径扩到 集合（__cn_vector_free_strings 平铺同款）；
//     · 释放后槽清零（幂等不变量——多路径共享槽，与 73-a 双释根治同模型）。
//   断言口径：八形态折校验和（255=①1+②2+③4+④8+⑤16+⑥32+⑦64+⑧128 全对）；
//   每形态经内存搅动制造复用压力（悬垂/双释放即内容损坏或计数异常）。
导入 核心::内存;
导入 容器::向量;
导入 容器::链表;
导入 容器::队列;
导入 映射集合;
导入 IO::打印;

// 内存搅动：新分配覆盖「已释放内存」，使悬垂元素内容可观测损坏（探针 76-F 手法）
函数 搅动() -> 整64 {
    整64 和 = 0;
    整64 i = 0;
    当 (i < 24) {
        字符串 垃圾 = 字符串复制("搅动内存填充占位字符串内容甲乙丙丁戊己庚辛");
        和 = 和 + 字符串长度(垃圾);
        i++;
    }
    返回 和;
}

// ① 映射 删除(键)：交换式删除（位置!=最后）——被删项值串释放 + 剩余元素完好
函数 形态一() -> 整64 {
    整64 校验 = 0;
    如果 (1 == 1) {
        映射<整64, 字符串> 表 = 映射<整64, 字符串>();
        结果<空类型, 整32> 设甲 = 表.设置(1, 字符串复制("形态一甲串内容甲乙丙丁戊己庚辛"));
        如果 (!设甲.正常) { 返回 0; }
        结果<空类型, 整32> 设乙 = 表.设置(2, 字符串复制("形态一乙串内容甲乙丙丁戊己庚辛"));
        如果 (!设乙.正常) { 返回 0; }
        整64 删前 = 内存::活动分配数();
        布尔 删 = 表.删除(1);
        整64 删后 = 内存::活动分配数();
        如果 (删) { 校验 = 校验 + 1; }
        如果 (!表.包含(1)) { 校验 = 校验 + 2; }
        结果<字符串, 整32> 取 = 表.获取(2);
        如果 (取.正常) {
            如果 (字符串比较(取.值, "形态一乙串内容甲乙丙丁戊己庚辛")) { 校验 = 校验 + 4; }
        } 否则 {
            返回 0;
        }
        如果 (表.大小() == 1) { 校验 = 校验 + 8; }
        如果 (删后 == 删前 - 1) { 校验 = 校验 + 16; }   // 被删值串随删除释放
    }
    整64 消耗 = 搅动();
    返回 校验;   // 期望 31
}

// ② 映射 设置覆盖已有键：旧值串随覆盖释放（新值接管与旧值释放相抵）+ 内容=新值
函数 形态二() -> 整64 {
    整64 校验 = 0;
    如果 (1 == 1) {
        映射<整64, 字符串> 表 = 映射<整64, 字符串>();
        结果<空类型, 整32> 设旧 = 表.设置(2, 字符串复制("形态二旧串内容甲乙丙丁戊己庚辛"));
        如果 (!设旧.正常) { 返回 0; }
        整64 覆前 = 内存::活动分配数();
        结果<空类型, 整32> 设新 = 表.设置(2, 字符串复制("形态二新串内容甲乙丙丁戊己庚辛"));
        如果 (!设新.正常) { 返回 0; }
        整64 覆后 = 内存::活动分配数();
        如果 (覆后 == 覆前) { 校验 = 校验 + 1; }
        结果<字符串, 整32> 取 = 表.获取(2);
        如果 (取.正常) {
            如果 (字符串比较(取.值, "形态二新串内容甲乙丙丁戊己庚辛")) { 校验 = 校验 + 2; }
        } 否则 {
            返回 0;
        }
        如果 (表.大小() == 1) { 校验 = 校验 + 4; }
    }
    整64 消耗 = 搅动();
    返回 校验;   // 期望 7
}

// ③ 映射 释放内部数组（H8-5 显式销毁路径）：4 内部数组 + 值串一并释放
函数 形态三() -> 整64 {
    整64 校验 = 0;
    映射<整64, 字符串> 表 = 映射<整64, 字符串>();
    结果<空类型, 整32> 设 = 表.设置(3, 字符串复制("形态三值串内容甲乙丙丁戊己庚辛"));
    如果 (!设.正常) { 返回 0; }
    整64 释前 = 内存::活动分配数();
    表.释放内部数组();
    整64 释后 = 内存::活动分配数();
    如果 (释后 == 释前 - 5) { 校验 = 1; }
    整64 消耗 = 搅动();
    返回 校验;   // 期望 1
}

// ④ 集合<T>：元素串随 析构/清空 释放
函数 形态四() -> 整64 {
    整64 校验 = 0;
    整64 析构前 = 内存::活动分配数();
    如果 (1 == 1) {
        集合<字符串> 集 = 集合<字符串>();
        结果<空类型, 整32> 加 = 集.添加(字符串复制("形态四析构元素串内容甲乙丙丁"));
        如果 (!加.正常) { 返回 0; }
        如果 (集.大小() == 1) { 校验 = 校验 + 1; }
    }
    整64 析构后 = 内存::活动分配数();
    如果 (析构后 == 析构前) { 校验 = 校验 + 2; }   // 元素串 + 数据数组随析构释放
    集合<字符串> 集二 = 集合<字符串>();
    结果<空类型, 整32> 加二 = 集二.添加(字符串复制("形态四清空元素串内容甲乙丙"));
    如果 (!加二.正常) { 返回 0; }
    整64 清前 = 内存::活动分配数();
    集二.清空();
    整64 清后 = 内存::活动分配数();
    如果 (清后 == 清前 - 1) { 校验 = 校验 + 4; }   // 元素串随清空释放
    整64 消耗 = 搅动();
    返回 校验;   // 期望 7
}

// ⑤ 向量 删除(位置) + 设置覆盖：被删/旧元素串释放 + 元素内容守恒
函数 形态五() -> 整64 {
    整64 校验 = 0;
    整64 删除前 = 内存::活动分配数();
    如果 (1 == 1) {
        向量<字符串> 表 = 向量<字符串>();
        结果<空类型, 整32> 加甲 = 表.追加(字符串复制("形态五甲串内容甲乙丙丁戊己庚辛"));
        如果 (!加甲.正常) { 返回 0; }
        结果<空类型, 整32> 加乙 = 表.追加(字符串复制("形态五乙串内容甲乙丙丁戊己庚辛"));
        如果 (!加乙.正常) { 返回 0; }
        整64 删前 = 内存::活动分配数();
        结果<空类型, 整32> 删 = 表.删除(0);
        整64 删后 = 内存::活动分配数();
        如果 (!删.正常) { 返回 0; }
        如果 (删后 == 删前 - 1) { 校验 = 校验 + 1; }
        字符串 元素 = 表.元素(0);
        如果 (字符串比较(元素, "形态五乙串内容甲乙丙丁戊己庚辛")) { 校验 = 校验 + 2; }
    }
    整64 删除后 = 内存::活动分配数();
    如果 (删除后 == 删除前) { 校验 = 校验 + 4; }
    向量<字符串> 表二 = 向量<字符串>();
    结果<空类型, 整32> 加旧 = 表二.追加(字符串复制("形态五旧串内容甲乙丙丁戊己庚辛"));
    如果 (!加旧.正常) { 返回 0; }
    整64 覆前 = 内存::活动分配数();
    结果<空类型, 整32> 设新 = 表二.设置(0, 字符串复制("形态五新串内容甲乙丙丁戊己庚辛"));
    如果 (!设新.正常) { 返回 0; }
    整64 覆后 = 内存::活动分配数();
    如果 (覆后 == 覆前) { 校验 = 校验 + 8; }   // 旧值释放 + 新值接管相抵
    字符串 元素二 = 表二.元素(0);
    如果 (字符串比较(元素二, "形态五新串内容甲乙丙丁戊己庚辛")) { 校验 = 校验 + 16; }
    整64 消耗 = 搅动();
    返回 校验;   // 期望 31
}

// ⑥ 链表 删除头部/删除尾部/清空：被摘槽与清空元素串释放 + 链序守恒
函数 形态六() -> 整64 {
    整64 校验 = 0;
    链表<字符串> 表 = 链表<字符串>();
    结果<空类型, 整32> 加甲 = 表.头部追加(字符串复制("形态六甲串内容甲乙丙丁戊己庚辛"));
    如果 (!加甲.正常) { 返回 0; }
    结果<空类型, 整32> 加乙 = 表.头部追加(字符串复制("形态六乙串内容甲乙丙丁戊己庚辛"));
    如果 (!加乙.正常) { 返回 0; }
    整64 删头前 = 内存::活动分配数();
    结果<空类型, 整32> 删头 = 表.删除头部();
    整64 删头后 = 内存::活动分配数();
    如果 (!删头.正常) { 返回 0; }
    如果 (删头后 == 删头前 - 1) { 校验 = 校验 + 1; }
    如果 (表.大小() == 1) { 校验 = 校验 + 2; }
    结果<字符串, 整32> 读 = 表.读取头部();
    如果 (读.正常) {
        如果 (字符串比较(读.值, "形态六甲串内容甲乙丙丁戊己庚辛")) { 校验 = 校验 + 4; }
    } 否则 {
        返回 0;
    }
    整64 删尾前 = 内存::活动分配数();
    结果<空类型, 整32> 删尾 = 表.删除尾部();
    整64 删尾后 = 内存::活动分配数();
    如果 (!删尾.正常) { 返回 0; }
    如果 (删尾后 == 删尾前 - 1) { 校验 = 校验 + 8; }
    结果<空类型, 整32> 加丙 = 表.头部追加(字符串复制("形态六丙串内容甲乙丙丁戊己庚辛"));
    如果 (!加丙.正常) { 返回 0; }
    结果<空类型, 整32> 加丁 = 表.头部追加(字符串复制("形态六丁串内容甲乙丙丁戊己庚辛"));
    如果 (!加丁.正常) { 返回 0; }
    整64 清前 = 内存::活动分配数();
    表.清空();
    整64 清后 = 内存::活动分配数();
    如果 (清后 == 清前 - 2) { 校验 = 校验 + 16; }   // 清空元素串随清空释放（按链游）
    整64 消耗 = 搅动();
    返回 校验;   // 期望 31
}

// ⑦ 队列 清空：元素串随清空释放（按链游）
函数 形态七() -> 整64 {
    整64 校验 = 0;
    队列<字符串> 表 = 队列<字符串>();
    结果<空类型, 整32> 入甲 = 表.入队(字符串复制("形态七甲串内容甲乙丙丁戊己庚辛"));
    如果 (!入甲.正常) { 返回 0; }
    结果<空类型, 整32> 入乙 = 表.入队(字符串复制("形态七乙串内容甲乙丙丁戊己庚辛"));
    如果 (!入乙.正常) { 返回 0; }
    整64 清前 = 内存::活动分配数();
    表.清空();
    整64 清后 = 内存::活动分配数();
    如果 (清后 == 清前 - 2) { 校验 = 1; }
    整64 消耗 = 搅动();
    返回 校验;   // 期望 1
}

// ⑧ 借用来源入映射（UAF 防护）+ 局部标识符入映射（值语义深拷贝）
函数 存入映射(映射<整64, 字符串> 表, 字符串 形参) -> 空类型 {
    结果<空类型, 整32> 设 = 表.设置(1, 形参);
    如果 (!设.正常) { 运行时错误(4); }
}

函数 形态八() -> 整64 {
    整64 校验 = 0;
    字符串 本地 = 字符串复制("形态八本地串内容甲乙丙丁戊己庚辛");
    如果 (1 == 1) {
        映射<整64, 字符串> 表 = 映射<整64, 字符串>();
        存入映射(表, 本地);
        结果<字符串, 整32> 取 = 表.获取(1);
        如果 (取.正常) {
            如果 (字符串比较(取.值, "形态八本地串内容甲乙丙丁戊己庚辛")) { 校验 = 校验 + 1; }
        } 否则 {
            返回 0;
        }
    }
    整64 消耗 = 搅动();   // 容器析构后搅动：若容器释放了本地串 → 内容损坏
    如果 (字符串比较(本地, "形态八本地串内容甲乙丙丁戊己庚辛")) { 校验 = 校验 + 2; }
    如果 (1 == 1) {
        映射<整64, 字符串> 表二 = 映射<整64, 字符串>();
        字符串 源 = 字符串复制("形态八深拷贝串内容甲乙丙丁戊己庚辛");
        结果<空类型, 整32> 设二 = 表二.设置(2, 源);
        如果 (!设二.正常) { 返回 0; }
        结果<字符串, 整32> 取二 = 表二.获取(2);
        如果 (取二.正常) {
            如果 (字符串比较(取二.值, "形态八深拷贝串内容甲乙丙丁戊己庚辛")) { 校验 = 校验 + 4; }
        } 否则 {
            返回 0;
        }
    }
    整64 消耗二 = 搅动();   // 源已随块出口释放：若容器浅存句柄 → 元素悬垂损坏
    返回 校验;   // 期望 7
}

函数 主() -> 整32 {
    整64 校验和 = 0;
    如果 (形态一() == 31) { 校验和 = 校验和 + 1; }
    如果 (形态二() == 7) { 校验和 = 校验和 + 2; }
    如果 (形态三() == 1) { 校验和 = 校验和 + 4; }
    如果 (形态四() == 7) { 校验和 = 校验和 + 8; }
    如果 (形态五() == 31) { 校验和 = 校验和 + 16; }
    如果 (形态六() == 31) { 校验和 = 校验和 + 32; }
    如果 (形态七() == 1) { 校验和 = 校验和 + 64; }
    如果 (形态八() == 7) { 校验和 = 校验和 + 128; }
    打印("校验和(期望255)=", 校验和);
    返回 0;
}
