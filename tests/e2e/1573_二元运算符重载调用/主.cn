// 1573（#1675 锁面）：类二元运算符重载调用——修复前宿主 0xC0000005 崩溃
//   （this 层级错位：调用方传实例地址单级指针·被调方两级解引用读首字段当指针）。
//   四形态 + 一元负号回归（o4 修复前即绿·防修崩）。
类 复数 {
公开:
    整32 实;
    整32 虚;
    函数 运算符+(复数& o) -> 复数 {
        复数 r;
        r.实 = 实 + o.实;
        r.虚 = 虚 + o.虚;
        返回 r;
    }
}
类 点 {
公开:
    整32 x;
    整32 y;
    函数 运算符==(点& o) -> 布尔 {
        如果 x == o.x && y == o.y {
            返回 真;
        }
        返回 假;
    }
}
类 标量 {
公开:
    整32 值;
    函数 运算符*(标量& o) -> 标量 {
        标量 r;
        r.值 = 值 * o.值;
        返回 r;
    }
}
类 版本 {
公开:
    整32 主号;
    函数 运算符<(版本& o) -> 布尔 {
        如果 主号 < o.主号 {
            返回 真;
        }
        返回 假;
    }
}
类 温度 {
公开:
    整32 度;
    函数 运算符-() -> 温度 {
        温度 r;
        r.度 = -度;
        返回 r;
    }
}
函数 主() -> 整32 {
    复数 a;
    a.实 = 1;
    a.虚 = 2;
    复数 b;
    b.实 = 10;
    b.虚 = 20;
    复数 c = a + b;
    打印(c.实);
    打印(c.虚);
    点 p1;
    p1.x = 1;
    p1.y = 2;
    点 p2;
    p2.x = 1;
    p2.y = 2;
    如果 p1 == p2 { 打印(1); } 否则 { 打印(0); }
    标量 s1;
    s1.值 = 6;
    标量 s2;
    s2.值 = 7;
    标量 s3 = s1 * s2;
    打印(s3.值);
    版本 v1;
    v1.主号 = 3;
    版本 v2;
    v2.主号 = 7;
    如果 v1 < v2 { 打印(1); } 否则 { 打印(0); }
    如果 v2 < v1 { 打印(1); } 否则 { 打印(0); }
    温度 t;
    t.度 = 8;
    温度 负t = -t;
    打印(负t.度);
    返回 0;
}
