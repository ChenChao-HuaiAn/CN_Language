// E2E 256：字符串字面量 \u{XXXX} 解码双编译对照（plans/020 移植纪律 9 第二十四个对照用例）
//   96-a（2026-09-13 第九十六轮 C10）：v2 词法 分词字符串 的转义慢路径原**不解码**
//   `\u{XXXX}`（注释明载「\u{XXXX} 暂不解码」——与 95-a 字符字面量同源边界）；
//   宿主 decodeEscapes 已解码（appendUtf8 同表）——本次对齐。
//   实现：十六进制解析 -> UTF-8 编码（1/2/3/4 字节）经 runtime `字符转字符串`
//   （__cn_str_from_char，0-255 单字节）逐字节拼接（v2 无字节级字符串构造原语）。
//   五形态（两侧共有语义面）：
//     ① 3 字节 BMP 中文（\u{4E2D} = "中"，长度 3）——UTF-8 3 字节编码路径
//     ② ASCII 码点（\u{42} = "B"）与普通字符混排（"A\u{42}C" = "ABC"）
//     ③ 4 字节补充平面（\u{1F600}，长度 4）——4 字节编码路径
//     ④ 2 字节路径（\u{7FF} 等边界码点）+ 多转义串联
//     ⑤ 非法形态（\u{} 无十六进制位）保留反斜杠原样（宿主 decodeEscapes 同款）
//   退出码 = 五形态折校验和 31（①1+②2+③4+④8+⑤16 全对）。
//   宿主侧 == 用例期望值；v2 侧 == 宿主侧实测值（等价性判据）。

// ① 3 字节 BMP 中文
函数 形一() -> 整64 {
    字符串 甲 = "\u{4E2D}";
    如果 (字符串长度(甲) == 3 && 字符串比较(甲, "中")) { 返回 1; }
    返回 0;
}

// ② ASCII 码点 + 混排
函数 形二() -> 整64 {
    字符串 乙 = "A\u{42}C";
    如果 (字符串长度(乙) == 3 && 字符串比较(乙, "ABC")) { 返回 2; }
    返回 0;
}

// ③ 4 字节补充平面
函数 形三() -> 整64 {
    字符串 丙 = "\u{1F600}";
    如果 (字符串长度(丙) == 4) { 返回 4; }
    返回 0;
}

// ④ 2 字节路径边界 + 多转义串联（\u{7F}=1 / \u{80}=2 / \u{7FF}=2 / \u{800}=3）
函数 形四() -> 整64 {
    字符串 丁 = "\u{7F}\u{80}\u{7FF}\u{800}";
    如果 (字符串长度(丁) == 8) { 返回 8; }
    返回 0;
}

// ⑤ 未知转义保留反斜杠（"\d" -> 2 字节 "\d"）——原锚定形态 "\u{}"（空转义
//    保留反斜杠）经 278-a T5 根治后为编译错误（\u{} 三态拒绝），本形态改由
//    未知转义 \d 继续锚定「非法转义保留反斜杠」行为（校验和 31 不变；
//    修改留痕：278-a 提交信息+plans/021 §3-G T5 行·用户排班任务的行为变更伴随）
函数 形五() -> 整64 {
    字符串 戊 = "\d";
    如果 (字符串长度(戊) == 2) { 返回 16; }
    返回 0;
}

函数 主() -> 整32 {
    整64 校验 = 形一() + 形二() + 形三() + 形四() + 形五();
    打印("校验和=", 校验);
    返回 整32(校验 % 256);
}
