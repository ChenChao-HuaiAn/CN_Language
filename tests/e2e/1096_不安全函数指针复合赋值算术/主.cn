// E2E 1096_不安全函数指针复合赋值算术（1038 修复·正例 dual）：不安全函数内
//   指针复合赋值 p += 1 / p -= 1 合法（001 §不安全清单1 明文 p±整数 合法；
//   #488 复合赋值=等价展开同规则、v2 语法层回退重析同构）——修前宿主误拒
//   「复合赋值要求数值操作数，实际为 '整32*' 与 '整32'」vs v2 全放行=分叉；
//   修后宿主糖展开 p = p ± 1 合成二元走普通赋值通道（步进=元素大小）。
//   断言：步进正确且与二元 q = q + 2 同值。期望 stdout：20 / 30 / 10。
不安全 函数 主() -> 整32 {
    整32[5] 表 = {10, 20, 30, 40, 50};
    整32* p = 表;
    p += 1;
    打印(p[0]);
    整32* q = 表;
    q = q + 2;
    打印(q[0]);
    p -= 1;
    打印(p[0]);
    返回 0;
}
