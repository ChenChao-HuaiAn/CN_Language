// 1997 锁用例：泛型函数实参=调用表达式（非泛型上下文）——外层调用点按内层调用
//   返回类型推导类型实参并改写实例合成名（宿主 303 checkExpr 全形态递归推导同构）。
// 病史：内层调用已改写为实例名、外层不改写 → IR 按基函数形参造模板态符号
//   ?恒等@@Y_T@Z（T=泛型参数名）→ 链接 undefined（1103 采样轮 x_y5 实录）。
// 形态覆盖：双重嵌套/三层嵌套/普通函数调用实参/显式实例实参/双参泛型实参位。
// 预期:2.500000 7 3.250000 1.500000 21 3
泛型 <类型 T>
函数 恒等(T v) -> T {
    返回 v;
}

泛型 <类型 T>
函数 最小(T a, T b) -> T {
    如果 (a < b) { 返回 a; }
    返回 b;
}

函数 取浮() -> 浮64 {
    返回 3.25;
}

函数 取整() -> 整32 {
    返回 7;
}

函数 主() -> 整32 {
    打印(恒等(恒等(2.5)));
    打印(恒等(恒等(取整())));
    打印(恒等(取浮()));
    打印(最小(恒等(1.5), 2.0));
    打印(恒等(恒等(恒等(21))));
    打印(最小(恒等(3), 恒等(9)));
    返回 0;
}
