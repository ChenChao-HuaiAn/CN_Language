接口 可打印 {
    虚拟 函数 打印自身() -> 空类型
}
接口 可计数 {
    虚拟 函数 计数() -> 整32
}
类 文档 : 可打印, 可计数 {
公开:
    整32 行数
    函数 文档(整32 甲) { 行数 = 甲; }
    虚拟 函数 打印自身() -> 空类型 {
        打印行("文档内容");
    }
    虚拟 函数 计数() -> 整32 {
        返回 行数;
    }
}
函数 主() -> 整32 {
    文档 甲 = 文档(5);
    甲.打印自身();
    打印行(甲.计数());
    返回 0;
}
