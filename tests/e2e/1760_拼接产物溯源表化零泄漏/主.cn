// E2E 1760（执法四·件2·原 1963 撞号改领）：拼接产物定义点溯源表化（发射单点登记·跨块可查）
//   +纯拼接三元槽登记锁面——修前：纯拼接三元赋值 50 轮泄 51（三元临时槽
//   __ternary$N Store/Load 中转·Load 产物溯源 miss→copy 落堆→槽内拼接
//   产物孤儿）、纯拼接三元入容器 50 轮泄 50（同源）；修后：纯拼接槽（两
//   分支 Store 源皆连接产物=任一路径产物=新堆串唯一拥有者）Load 产物登记
//   →赋值位直存接管/入容器⑥直存→分配守恒。混合来源三元槽（借用分支混入）
//   分支敏感禁盲登记（误释放借用面）→维持保守 copy·第③面锁修前修后同值
//   （斜率 26/50 轮·挂 1963 立项呈报）。第④面=块内赋值既有绿对照。
//   通道形态（云端 1104 片4 红定界后修正）：宿主单侧正测（expected 逐行全等
//   守卫·强度与 D2a 同口径）+ check_dual_coverage 豁免挂案 #1963——v2 探针
//   实测 F' 泄 50/G 锁面 26v0 结构性不可调和，双测（断言输出=是 两侧全等）
//   不可行；v2 对齐轮补 dual 恢复双测并删豁免行。
导入 容器::向量;

函数 主() -> 整32 {
    // G' 纯拼接三元赋值
    整64 g0 = 内存::活动分配数();
    字符串 槽2 = "y";
    循环 (整32 i = 0; i < 50; i += 1) {
        槽2 = (i % 2 == 0) ? (槽2 + "戊") : (槽2 + "己");
    }
    打印(整64(内存::活动分配数() - g0));

    // F' 纯拼接三元入容器（容器块作用域·析构后看泄）
    整64 f0 = 内存::活动分配数();
    如果 (真) {
        向量<字符串> 表 = 向量<字符串>();
        字符串 元 = "y";
        循环 (整32 j = 0; j < 50; j += 1) {
            结果<空类型, 整32> 追 = 表.追加((j % 2 == 0) ? (元 + "丁") : (元 + "丙"));
            如果 (!追.正常) { 返回 1; }
        }
    }
    打印(整64(内存::活动分配数() - f0));

    // G 混合三元赋值（锁面·修前修后同值）
    整64 h0 = 内存::活动分配数();
    字符串 槽3 = "y";
    循环 (整32 k = 0; k < 50; k += 1) {
        槽3 = (k % 2 == 0) ? (槽3 + "庚") : 槽3;
    }
    打印(整64(内存::活动分配数() - h0));

    // 对照：块内赋值（732/861 既有绿面）
    整64 b0 = 内存::活动分配数();
    字符串 槽4 = "x";
    循环 (整32 m = 0; m < 50; m += 1) {
        槽4 = 槽4 + "辛";
    }
    打印(整64(内存::活动分配数() - b0));
    打印("");
    返回 0;
}
