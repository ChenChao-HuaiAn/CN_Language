// 641（021 任务 273·dual 锁定）：返回位 局部结果/可选<类> 盒 移交生命周期——
//   「盒=正常(类值); 返回 盒;」与「弹值=表.弹出(); 返回 弹值;」两形态：
//   句柄随返回值移交调用方（源盒析构解除·v2 946 移出同构）——修前宿主双放
//   （C0000374/retbuf 残骸空指针·探针 p273 实锤）·修后双端一致（析构 2+2·泄漏 0）。
导入 容器::栈;
静态 整64 析构数 = 0;
类 资源 {
公开:
    整64 编号;
    函数 资源(整64 v) { 编号 = v; }
    函数 资源(资源& 其他) { 编号 = 其他.编号; }
    不安全 函数 ~资源() { 析构数 = 析构数 + 1; }
}
不安全 函数 直装() -> 结果<资源, 整32> {
    资源 甲 = 资源(7);
    结果<资源, 整32> 盒 = 正常(甲);
    返回 盒;
}
不安全 函数 弹转() -> 结果<资源, 整32> {
    栈<资源> 表 = 栈<资源>();
    资源 甲 = 资源(7);
    结果<空类型, 整32> 压 = 表.压入(甲);
    如果 (!压.正常) { 返回 错误(错误码.内存); }
    结果<资源, 整32> 弹值 = 表.弹出();
    返回 弹值;
}
不安全 函数 主() -> 整32 {
    整64 前 = 内存::活动分配数();
    {
        结果<资源, 整32> 得 = 直装();
        如果 (得.正常) {
            打印("得编号=", 得.值.编号);
        } 否则 { 返回 1; }
    }
    {
        结果<资源, 整32> 得 = 弹转();
        如果 (得.正常) {
            打印("弹编号=", 得.值.编号);
        } 否则 { 返回 2; }
    }
    打印("析构数=", 析构数);
    打印("泄漏=", 内存::活动分配数() - 前);
    返回 0;
}
