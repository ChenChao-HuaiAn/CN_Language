// 990 临时探针（用后删）：E 复现=类型大小段+点容器段+大数段（983 E 原样）
导入 容器::向量;

结构体 点 {
    整64 x;
    整64 y;
    整64 z;
}

函数 主() -> 整32 {
    打印("整128: ", 类型大小(整128));
    打印("指针: ", 类型大小(整32*));
    向量<点> 点列表 = 向量<点>();
    点 p1 = 点{ x = 1, y = 2, z = 3 };
    结果<空类型, 整32> 追加1 = 点列表.追加(p1);
    点 读0 = 点列表.元素(0);
    打印("点0: ", 读0.x, " ", 读0.y, " ", 读0.z);
    向量<整128> 表 = 向量<整128>();
    结果<空类型, 整32> 大追加1 = 表.追加(100000000000000000000LL);
    打印("大数[0]: ", 表.元素(0));
    打印行("");
    返回 0;
}
