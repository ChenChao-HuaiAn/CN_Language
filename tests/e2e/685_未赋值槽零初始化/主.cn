// 685（021 #344·2026-10-10 单位机修复轮·原立 682 撞 363 清偿批用例号让位改 685）：
//   未赋值函数指针槽零初始化定点兜底（genFnPtrZeroInit）。001 §5.8 子案 A
//   「零值→运行时错误(错误码3)」（2026-10-05 用户裁决）的前提=未赋值槽值
//   确定——裸 fnptr 声明补 Store 0：未赋值调用→判零防线正确触发（负例面
//   归 606·本例锁 正负两态+先声明后赋值健康面）。
//   ★定点面注记：初版曾扩标量/字符串全量零写——自举 M6 固定点实证两跳
//   等价性破坏（零写=宿主行为·v2 源码无对应逻辑→fix_p≢fix_s）——收窄
//   fnptr 定点（v2 源码零 fnptr 声明=两跳零分叉·v2 主文件产物对拍逐字节
//   一致实证）。标量/串读取面由 E0381 编译期拒绝守（既有法·分层防线）。
//   ① 已赋值 fnptr 间接调用健康（判零零误伤）；② 未赋值 fnptr 判零防线
//   触发错误码3（606 同形态正锚·退出码 1）；③ 先声明后赋值路径零写被覆盖。
//   校验和：①1 ③8 —— fnptr 面全对=退出码 0。
函数 健康值(整32 x) -> 整32 { 返回 7; }
不安全 函数 主() -> 整32 {
    整64 校验 = 0;

    // ① 已赋值 fnptr 健康调用
    整32(*好)(整32) = 健康值;
    如果 (好(1) == 7) { 校验 = 校验 + 1; }

    // ③ 先声明后赋值（零写被赋值覆盖·E0381 合法路径）
    整32(*后赋)(整32);
    后赋 = 健康值;
    如果 (后赋(2) == 7) { 校验 = 校验 + 8; }

    打印("校验和="); 打印行(校验);
    如果 (校验 == 9) { 返回 0; }
    返回 1;
}
