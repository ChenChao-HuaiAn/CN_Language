// 685（021 #344·原立 682 撞 363 清偿批用例号让位改 685·2026-10-10 单位机修复轮）：未赋值槽零初始化确定性——
//   标量/字符串/函数指针 无初始化器声明补 Store 0（与 结构体/数组 零初始化
//   兜底族对称·族收尾）。分层防线终态：E0381 编译期拒绝=数值标量读取面
//   （整/浮/布·既有法）；放行面（字符串/函数指针/跨块形态）运行时确定性
//   零值兜底（本例）+判零防线（fnptr 面·606）。001 §5.8 子案 A「零值→
//   运行时错误(错误码3)」前提=未赋值槽值确定。094 空安全：字符串句柄 0=
//   空串天然兼容。
//   ① 未赋值字符串=空串；② 跨块未赋值字符串=空串；③ 字符串零值可参与
//   比较/拼接；④ 先声明后赋值不受零写干扰。校验和位：①1 ②2 ③4 ④8
//   —— 全对=退出码 0。
函数 主() -> 整32 {
    字符串 丁;
    整64 校验 = 0;

    // ① 未赋值字符串=空串（094 空安全）
    打印行("串=["); 打印(丁); 打印行("]");
    如果 (丁 == "") { 校验 = 校验 + 1; }

    // ② 跨块声明零初始化
    如果 (真) {
        字符串 辛;
        打印行("块串=["); 打印(辛); 打印行("]");
        如果 (辛 == "") { 校验 = 校验 + 2; }
    }

    // ③ 字符串零值参与拼接（0 句柄=空串·拼接安全）
    字符串 壬 = 丁 + "尾";
    如果 (壬 == "尾") { 校验 = 校验 + 4; }

    // ④ 先声明后赋值（E0381 合法路径·零写被赋值覆盖）
    字符串 癸;
    癸 = "值";
    如果 (癸 == "值") { 校验 = 校验 + 8; }

    打印行("壬="); 打印行(壬);
    打印行("癸="); 打印行(癸);
    打印行("校验和="); 打印行(校验);

    如果 (校验 == 15) { 返回 0; }
    返回 1;
}
