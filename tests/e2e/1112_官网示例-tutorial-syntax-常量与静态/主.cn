// 官网文档示例 · tutorial-syntax.html · 变量（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
常量 尺寸 = 4;              // 编译期常量：引用处直接替换
静态 整32 访问次数 = 0;     // 全局/类内静态：零初始化，进程生存期

不安全 函数 主() -> 整32 {  // 静态写在不安全域（读取任意处安全）
    整32[尺寸] 表;           // 数组长度=编译期常量表达式
    访问次数 = 访问次数 + 1;
    打印(尺寸, " ", 访问次数);
    返回 0;
}