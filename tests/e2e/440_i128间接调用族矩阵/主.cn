// E2E 440（337-a 补修·T53 家系残余）：i128 字面量实参 × 间接调用（函数指针/闭包）族矩阵
//   背景：函数指针变量/参数的源码类型登记丢失形参列表（登记字面量 `函数指针`）
//   → 间接调用点解析不出 i128 形参 → 字面量实参窄整（i64）直传 → 被调方按
//   i128 指针 ABI 解引用 SIGSEGV（探针 p_fnptr rc=139）；同族闭包调用
//   （对象.方法 绑定 / lambda）展开处亦缺 ABI 定标（探针 f_closure rc=139）。
//   本轮修复：登记位统一取完整规范串（paramSrcTypeOf 单一归属·全部登记点）+
//   间接调用/闭包调用两处按形参宽化（widenI128Args 单一归属）+ 泛型实例体
//   T→实参替换；覆盖形态＝函数指针变量/函数指针参数/类方法内回调/泛型实例体
//   回调/方法作值闭包/lambda 闭包/正128（u128）+ 阴性对照（整32 形参不宽化）。
函数 报告(整128 值) -> 整32 { 打印行(整64(值)); 返回 0; }
函数 应用(整32(*处理)(整128)) -> 整32 { 返回 处理(500000000000); }
泛型 <类型 T> 函数 泛应用(整32(*处理)(T)) -> 整32 { 返回 处理(600000000000); }
函数 窄报告(整32 值) -> 整32 { 打印行(整64(值)); 返回 0; }
函数 正报告(正128 值) -> 整32 { 打印行(整64(值)); 返回 0; }
类 触发者 {
公开:
    整128 存;
    函数 触发者(整128 初值) { 存 = 初值; }
    函数 装填(整128 值) -> 整32 { 存 = 值; 打印行(整64(存)); 返回 0; }
    函数 中转(整32(*处理)(整128)) -> 整32 { 返回 处理(700000000000); }
}
函数 主() -> 整32 {
    整32(*指)(整128) = 报告;
    指(100000000000);
    应用(报告);
    泛应用<整128>(报告);
    触发者 对象 = 触发者(0);
    对象.中转(报告);
    变量 回调 = 对象.装填;
    回调(200000000000);
    变量 匿名 = [](整128 值) -> 整32 { 打印行(整64(值)); 返回 0; };
    匿名(300000000000);
    整32(*窄指)(整32) = 窄报告;
    窄指(42);
    整32(*正指)(正128) = 正报告;
    正指(400000000000);
    返回 0;
}
