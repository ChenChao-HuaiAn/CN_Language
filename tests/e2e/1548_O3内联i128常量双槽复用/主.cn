// 1548（任务 #1447 锁用例）：-O3 内联 i128 常量双槽复用回归锁。
// 缺陷现场（develop 基线）：O3 内联「返回 42」的小函数后，callee 的 i32
//   常量（ConstInt v0）与 caller 的 i128 转换结果撞同一 vreg 号（内联器
//   未对 callee 寄存器重编号——IR 生成器 vreg 是每函数独立命名空间）；
//   CSE 把第二处 i128 常量复用首处 v0 双槽，而 i32 常量物化只写低 4 字节，
//   i128 高半槽读到残留 42 → Linux 实测输出 774763251095801167914
//   （双半均 42；win 依赖残留恰好 42/0 未显形）。
// 根因修=InlinePass 对 callee 全部 vreg 重编号（caller 最大号之上），
//   同一 vreg 不再跨宽度复用；本用例锁四类形态：
//   ① 直返常量（内联 Cast i128 双槽物化）
//   ② 局部接收 + 重复打印（原缺陷形态：CSE 复用双槽 + i32 常量覆盖面）
//   ③ 同一常量返回多调用点（跨调用点 CSE 复用）
//   ④ 双半边界字面量（2^64 / 2^64-1 / -2^63 高半、低半独立非零）
//   ⑤ i32→i128 宽化（正/负符号扩展）
//   ⑥ i128 参数透传 + 64 位表达式宽化
// 期望（逐行）：
//   42/42/42/42/42/123456789012345678901234567890/-42/7/-7/8/
//   42/18446744073709551616/18446744073709551615/-9223372036854775808

函数 常量返回() -> 整128 {
    返回 42;
}

函数 大字面量返回() -> 整128 {
    返回 123456789012345678901234567890;
}

函数 负字面量返回() -> 整128 {
    返回 -42;
}

函数 宽化(整32 值) -> 整128 {
    返回 值;
}

函数 透传(整128 入) -> 整128 {
    返回 入;
}

函数 六四表达(整64 甲, 整64 乙) -> 整128 {
    返回 甲 + 乙;
}

函数 双半上界返回() -> 整128 {
    返回 18446744073709551616;
}

函数 双半全一返回() -> 整128 {
    返回 18446744073709551615;
}

函数 负下界返回() -> 整128 {
    返回 -9223372036854775808;
}

函数 主() -> 整32 {
    // ① 直返常量（内联 Cast 双槽）
    打印(常量返回());
    // ② 局部接收（原缺陷形态：内联常量 + i128 存储按双槽读）
    整128 局部 = 常量返回();
    打印(局部);
    // ③ 重复打印（CSE 双槽复用）
    打印(局部);
    整128 局部二 = 常量返回();
    打印(局部二);
    // ④ 多调用点复用（跨调用点 CSE）
    打印(常量返回());
    // ⑤ 大字面量/负字面量（双半均非零）
    打印(大字面量返回());
    打印(负字面量返回());
    // ⑥ i32→i128 宽化（正/负符号扩展）
    打印(宽化(7));
    打印(宽化(-7));
    // ⑦ 64 位表达式宽化 + i128 参数透传
    打印(六四表达(3, 5));
    打印(透传(局部));
    // ⑧ 双半边界字面量
    打印(双半上界返回());
    打印(双半全一返回());
    打印(负下界返回());
    返回 0;
}
