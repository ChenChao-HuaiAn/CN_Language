// 1572 可选赋值位构造器语境锁定（#1670 核销锚·防回归）：
//   「内置构造器 '某些' 不能用于目标 '结果$整64$整32'」误报族——10-26 核销
//   实证=陈旧 v2p 产物假象（当前源三轮绿：探针/警告源/缓存回归 293 项），
//   本用例锁定当前源正确行为，防检查器语境面回归：
//   ①可选 赋值位 某些(字面量)（mini1666 原形态·1591 赋值位语境+894 回取）
//   ②可选 返回位 某些(变量)（71-a 返回位语境）
//   ③结果 返回位 正常(显式转换)（警告源 main/工具 同形态·3 预期警告域）
//   ④可选 跨函数传回 + 有值/值 读取（载荷值保真）
函数 造值(整64 源) -> 可选<整64> {
    如果 (源 > 0) {
        返回 某些(源);
    }
    返回 无;
}

函数 取果() -> 结果<整64, 整32> {
    返回 正常(整64(3));
}

函数 主() -> 整32 {
    // ①赋值位：分支内 某些(字面量)
    可选<整64> 出ID = 无;
    如果 (真) {
        出ID = 某些(42);
    }
    如果 (出ID.有值) {
        打印("a=", 出ID.值);
    }
    // ①b赋值位覆盖：二次赋值走同语境
    出ID = 某些(7);
    如果 (出ID.有值) {
        打印("b=", 出ID.值);
    }
    // ④跨函数传回（返回位 ② + 载荷保真）
    可选<整64> 拿 = 造值(5);
    如果 (拿.有值) {
        打印("c=", 拿.值);
    }
    可选<整64> 空 = 造值(0 - 1);
    如果 (空.有值) {
        打印("d=", 空.值);
    } 否则 {
        打印("d=无");
    }
    // ③结果 返回位 正常(显式转换)（警告源同形态）
    结果<整64, 整32> 果 = 取果();
    如果 (果.正常) {
        打印("e=", 果.值);
    }
    返回 0;
}
