函数 挑(布尔 条, 整128 甲, 整128 乙) -> 整128 {
    返回 条 ? 甲 : 乙;
}
函数 嵌(布尔 条, 整128 甲, 整128 乙, 整128 丙) -> 整128 {
    返回 条 ? (甲 > 乙 ? 甲 : 乙) : 丙;
}
函数 加一(整128 值) -> 整128 {
    返回 值 + 1;
}
函数 主() -> 整32 {
    整128 甲 = 111111111111;
    整128 乙 = 222222222222;
    // ① 简单三元
    整128 丙 = 真 ? 甲 : 乙;
    打印行("三元 = ", 丙);
    // ② 嵌套三元
    整128 丁 = 嵌(真, 甲, 乙, 333333333333);
    打印行("嵌套 = ", 丁);
    // ③ 三元结果作实参
    打印行("实参 = ", 加一(真 ? 甲 : 乙));
    // ④ 三元结果参与算术
    整128 戊 = (真 ? 甲 : 乙) + 5;
    打印行("算术 = ", 戊);
    // ⑤ 返回位三元（m44_01 形态）
    打印行("返回位 = ", 挑(真, 甲, 乙));
    // ⑥ 双分支 if-else 汇合（含块外隔语句消费·静默错值断言形态）
    整128 己 = 0;
    如果 真 { 己 = 甲; } 否则 { 己 = 乙; }
    打印行("双分支 = ", 己);
    // ⑦ 正128 对照
    正128 庚 = 真 ? 正128(999999) : 正128(888888);
    打印行("正128 = ", 庚);
    返回 0;
}
