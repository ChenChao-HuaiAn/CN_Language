// E2E 172_v2_类型常量分桶：跨模块同名结构体（布局独立）+ 同名常量（值独立）
//   + 限定类型语法（甲::记录 变量声明/跨模块实参——宿主 E2E 56 对齐）。
// 退出码断言：甲版本(100) + 甲端到端(141) + 版本(200) + 主数量(7) + 甲限定读(42)
//   - 589 = 0；任一串桶/错位 → rc≠0。（甲限定读=甲求和(42,99)=141）
导入 甲;

结构体 记录 {
    整32 数量;
}

常量 版本 = 200;

函数 主() -> 整32 {
    打印("甲版本: ", 甲::甲版本());
    打印("主版本: ", 版本);
    打印("甲端到端: ", 甲::甲端到端());
    甲::记录 甲记录 = 甲::造甲(42, 99);
    打印("甲限定读: ", 甲::甲求和(甲记录));
    记录 主记录;
    主记录.数量 = 7;
    打印("主数量: ", 主记录.数量);
    返回 整32(甲::甲版本() + 甲::甲端到端() + 版本 + 主记录.数量 + 甲::甲求和(甲记录) - 589);
}
