// E2E 41_ctor_overload：构造函数重载（Debug 子任务缺陷3修复）
// 背景：语义层 ClassInfo.methods 按方法名（name）索引，同名构造函数
//   （函数 盒子() / 函数 盒子(整64)）互相覆盖——带参覆盖无参，
//   无参调用链接到带参体（读未初始化 rdx 当容量），字段写入垃圾。
// 修复：methods 表按 sigKey（名#参数串）索引，构造函数多版本并存。
// 本用例：类定义 函数 盒子() 和 函数 盒子(整64)，分别实例化验证。
// 注意：CN 构造函数语法 = 函数 类名(...)（函数名等于类名即构造）。

类 盒子 {
    整64 容量

    函数 盒子() {
        容量 = 0
    }

    函数 盒子(整64 初始容量) {
        容量 = 初始容量
    }

    函数 取容量() -> 整64 {
        返回 容量
    }
}

函数 主() -> 整32 {
    盒子 无参盒 = 盒子()
    盒子 带参盒 = 盒子(42)
    打印("无参容量: ", 无参盒.取容量())
    打印("带参容量: ", 带参盒.取容量())
    返回 0
}
