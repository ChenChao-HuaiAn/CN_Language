// 118_宿主缺陷_链式方法调用与类值链式访问（2026-08-25）：根治链式寻址错。
//   两个叠加缺陷：
//   ① 类值链式字段访问：结果<类>.值.字段（查.值.编号）生成 调用 0（不读字段）——
//      exprSrcType 的 MemberExpr 分支不识别 结果/可选 成员映射（值 不是合成结构体
//      直接字段）-> 对象类型推导失败 -> handleClassMemberExpr 未识别类字段访问 ->
//      findStruct(类)=null 防御返回 0（117 开发实测打印 0）。
//   ② 链式方法调用：元素(i).设置()（表.元素(0).设置(1,100)）被降级为通用间接调用
//      （this=0 崩溃 0xC0000005）——exprSrcType 的 CallExpr 分支只处理 IdentifierExpr
//      被调函数，不处理 MemberExpr 被调方法（表.元素(0)）-> 对象类型推导失败 ->
//      handleClassCallExpr 未识别类方法调用。
//   修复：exprSrcType 补 结果/可选 成员映射（.值/.错误/.正常/.有值）+ CallExpr 分支
//   补 对象.方法() 返回类型解析（lookupClassMember）。
//   覆盖：
//   1. 结果<类>.值.字段 直接链式访问（根治前打印 0）
//   2. 向量 元素(i).方法() 链式方法调用（设置/获取）
//   3. 方法返回.取字段 链式（读取(0).值.编号）

导入 容器::向量
导入 映射集合

类 资源 {
公开:
    整64 编号
    函数 资源(整64 v) { 编号 = v }
    函数 资源(资源& 其他) { 编号 = 其他.编号 }
}

函数 主() -> 整32 {
    // 1. 类值链式字段访问（根治前打印 0）
    资源 r = 资源(5)
    结果<资源, 整32> 查 = 正常(r)
    如果 (查.正常) {
        打印("类值链式: ", 查.值.编号)
    } 否则 {
        打印("查错误")
    }

    // 2. 向量 元素(i).方法() 链式方法调用（根治前 this=0 崩溃）
    向量<映射<整64, 整64>> 表 = 向量<映射<整64, 整64>>()
    映射<整64, 整64> 层 = 映射<整64, 整64>()
    结果<空类型, 整32> 加 = 表.追加(层)
    打印("追加后: ", 表.大小())
    结果<空类型, 整32> 设 = 表.元素(0).设置(7, 777)
    如果 (设.正常) {
        打印("链式设置成功")
    } 否则 {
        打印("设置失败")
    }
    结果<整64, 整32> 取 = 表.元素(0).获取(7)
    如果 (取.正常) {
        打印("链式获取: ", 取.值)
    } 否则 {
        打印("获取失败")
    }

    // 3. 方法返回.取字段 链式（向量 读取(0).值.编号）
    向量<资源> 资源表
    资源 r1 = 资源(11)
    资源 r2 = 资源(22)
    结果<空类型, 整32> a1 = 资源表.追加(r1)
    结果<空类型, 整32> a2 = 资源表.追加(r2)
    结果<资源, 整32> 读0 = 资源表.读取(0)
    如果 (读0.正常) {
        打印("读取(0).值.编号: ", 读0.值.编号)
    }
    结果<资源, 整32> 读1 = 资源表.读取(1)
    如果 (读1.正常) {
        打印("读取(1).值.编号: ", 读1.值.编号)
    }
    返回 0
}
