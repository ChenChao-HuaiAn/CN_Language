// 538（810 轮·053 批次 E 探针转正）：128 位算术与比较矩阵——大字面量物化/
//   加法回绕（2^127-1 ×2 mod 2^128=-2）/乘法进位/混合宽度提升/传参/返回/
//   比较混合宽度。双编译对照：宿主内联 add/adc 与 v2 辅助函数
//   __cn_add/sub/mul/cmp_i128·u128 发射形态不同、行为契约逐字一致。
函数 加一(整128 x) -> 整128 {
    返回 x + 1;
}
函数 主() -> 整32 {
    整128 大 = 170141183460469231731687303715884105727;
    打印行(大);
    整128 和 = 大 + 大;
    打印行(和);
    整128 千 = 1000;
    整128 积 = 千 * 千;
    打印行(积);
    整128 基 = 18446744073709551617;
    打印行(加一(基));
    如果 (基 > 100) { 打印行(999); }
    如果 (千 < 基) { 打印行(888); }
    如果 (积 == 1000000) { 打印行(777); }
    返回 0;
}
