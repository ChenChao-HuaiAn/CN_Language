// 191_v2：无符号类型语义 v2 闭环（46-f 观察项根治，2026-09-10 第五十轮，
//   用户裁决方案A；宿主侧同源用例=191）——v2p 编译本源码 rc=127=七面校验和
//   全过：A 无符号除法 udiv/div（+1；修复前 idiv 有符号 2^63/2 出负 rc=12
//   实锤）/ B 逻辑右移 lsr/shr（+2；修复前 sar 算术）/ C 32 位截断 mod 2^32
//   （+4；修复前 64 位全宽 8000000000≠3705032704 rc=13 实锤）/ D 无符号比较
//   hi+seta（+8）/ E 无符号小于为假（+16）/ F u32 max 边界（+32）/ G 除法
//   全精度值（+64）。
//   实现：T_正32=70/T_正64=71 独立类型码（类型码() 归一拆分——寄存器类型/
//   二元指令类型字段传播）+三后端按码分派（div/shr/setb 族、udiv/lsr/lo 族）
//   +正32 存储点 IR_位与 0xFFFFFFFF 截断（对齐宿主 4 字节槽）+访存 32 位
//   零扩展读回分派。
函数 主() -> 整32 {
    正64 大 = 9223372036854775808;
    正32 a = 4000000000;
    正32 和 = a + a;
    正64 半 = 大 / 3;
    正64 移 = 大 >> 1;
    整32 c = 0;
    如果 (大 / 2 == 4611686018427387904) { c = c + 1; }
    如果 (移 == 4611686018427387904) { c = c + 2; }
    如果 (和 == 3705032704) { c = c + 4; }
    如果 (大 > 100) { c = c + 8; }
    如果 (大 < 9223372036854775807) { } 否则 { c = c + 16; }
    如果 (a >= 4294967296) { } 否则 { c = c + 32; }
    如果 (半 == 3074457345618258602) { c = c + 64; }
    返回 c;
}
