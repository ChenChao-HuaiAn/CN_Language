// E2E 1388（#1089·1017 采样轮探针 v07 同族·dual 正例）：非泛型 字符串& 引用
//   交换——与泛型实例同根（字符串引用参数 ABI 通道），修前宿主同崩（错误码3）/
//   v2 同缺值（打印行「乙」缺「甲」）。
//   期望 5 行：白/青/青/白/0（0=两轮交换活动分配净零）。
函数 交换串(字符串& 甲, 字符串& 乙) -> 空类型 {
    字符串 临时 = 甲;
    甲 = 乙;
    乙 = 临时;
}
函数 主() -> 整32 {
    字符串 甲 = "青";
    字符串 乙 = "白";
    交换串(甲, 乙);
    打印(甲);
    打印(乙);
    交换串(甲, 乙);
    打印(甲);
    打印(乙);
    整64 前 = 内存::活动分配数();
    交换串(甲, 乙);
    交换串(甲, 乙);
    整64 后 = 内存::活动分配数();
    打印(后 - 前);
    返回 0;
}
