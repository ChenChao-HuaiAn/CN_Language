// E2E 1462 正测（#1310·2026-10-23）：字符串下标越界检查**编译期已知长度快路径**——
//   下标对象为字符串字面量/顶层字符串常量时，长度=解码后 UTF-8 字节数（编译期常量），
//   越界检查以常量比较替代 __cn_str_len(运行时 strlen)。覆盖形态：
//   ①字面量下标（"XY"[0]/"XY"[1]）②多字节字面量（"甲乙"[0..5]·UTF-8 字节语义）
//   ③顶层字符串常量（词[0]/词[4] 边界 len-1）④常量引用常量（引=词·S2=S）
//   ⑤常量拼接初值（拼="A"+"B"）⑥转义字面量/常量（"a\n中"=5 字节·\n=10）
//   ⑦常量赋变量后下标（变量路径=未知长度→运行时 strlen 原路径，不误伤）
//   ⑧字符串长度内建仍走运行时（快路径只作用于下标越界检查）
//   ⑨实例字段名遮蔽顶层常量（自身字段·审查 P0-1）：读点是字段槽（"XY"），
//     长度必须走运行时 strlen（取(1)=89）
//   ⑩同一表达式快慢混合（字面量快路径 + 变量运行时路径）
//   ⑪嵌入 NUL 字面量前合法读（"a\0b"[0]=97·NUL 后字节不参与编译期长度）。
//   双侧：宿主与 v2p 各编各跑，运行输出逐行全等（断言输出=是）。
//   金标：A=65 B=66 C=67 D=68 E=69 X=88 Y=89 a=97 b=98 c=99；
//         "甲乙"=E7 94 B2 E4 B9 99 → -25 -108 -78 -28 -71 -103；
//         "中"=E4 B8 AD → -28 -72 -83。
常量 词 = "ABCDE";
常量 转义 = "a\n中";
常量 引 = 词;
常量 拼 = "A" + "B";
常量 遮 = "AB";
// ⑨ 实例字段名与顶层常量同名（584-a 同族遮蔽）：方法内 词[i] 读字段槽
类 盒子 {
公开:
    字符串 词;
    函数 盒子() { 词 = "XY"; }
    不安全 函数 取(整64 i) -> 整32 { 返回 整32(词[i]); }
}

函数 主() -> 整32 {
    打印("k0=", 整32(词[0]));
    打印("k4=", 整32(词[4]));
    打印("y1=", 整32(引[1]));
    打印("p0=", 整32(拼[0]));
    打印("p1=", 整32(拼[1]));
    打印("z0=", 整32(转义[0]));
    打印("z1=", 整32(转义[1]));
    打印("z2=", 整32(转义[2]));
    打印("z3=", 整32(转义[3]));
    打印("z4=", 整32(转义[4]));
    打印("l0=", 整32("XY"[0]));
    打印("l1=", 整32("XY"[1]));
    打印("u0=", 整32("甲乙"[0]));
    打印("u1=", 整32("甲乙"[1]));
    打印("u2=", 整32("甲乙"[2]));
    打印("u3=", 整32("甲乙"[3]));
    打印("u4=", 整32("甲乙"[4]));
    打印("u5=", 整32("甲乙"[5]));
    字符串 s = "abc";
    打印("v0=", 整32(s[0]));
    打印("v2=", 整32(s[2]));
    字符串 t = 词;
    打印("t1=", 整32(t[1]));
    // ⑨遮蔽（584-a）：局部变量与常量同名时读点是变量槽（长度不可用常量文本
    //   证明）——快路径必须回落运行时 strlen，不得按常量 "AB" 长度 2 误判。
    字符串 遮 = "XYZW";
    打印("s3=", 整32(遮[3]));
    打印("s0=", 整32(遮[0]));
    // ⑨ 实例字段遮蔽常量：字段值 "XY" 长度 2（不得用同名常量 "ABCDE" 长度 5）
    盒子 盒;
    打印("f1=", 整32(盒.取(1)));
    // ⑩ 同一表达式内快慢混合："XY"[0]=88（编译期长度）+ s[1]=98（运行时 strlen）
    打印("mix=", 整32("XY"[0]) + 整32(s[1]));
    // ⑪ 嵌入 NUL 字面量：NUL 前字节合法读（[0]=97）；越界面见 1470 负测
    打印("n0=", 整32("a\0b"[0]));
    打印("len=", 字符串长度(词), 字符串长度(转义), 字符串长度("甲乙"));
    返回 0;
}
