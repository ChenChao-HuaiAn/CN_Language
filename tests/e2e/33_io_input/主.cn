// IO 输入库 E2E（Task 6.2，规格书10.6 输入 API）
// 覆盖：读取行（整行字符串，不含换行）/ 读取整数（strtoll 整行解析）/
//       读取浮点（strtod 整行解析）/ EOF 语义（无输入返回错误码）
// 调用方式：直接调用 IO 内置函数（IO::读取行 等，全局注册、无需导入），
//   由编译器 IR 层映射到运行时 __cn_read_line/__cn_read_int/__cn_read_float
//   ——与 stdlib/IO.cn 模块封装同名（25_math 数学库同模式：E2E 直接验证内置）
// stdin 注入：run_e2e.py 检测同名 主.input 文件作为标准输入注入
//   本用例输入文件内容：
//     第一行测试
//     42
//     3.14
//   （前三行被 读取行/读取整数/读取浮点 消费；第四行开始 EOF——
//     后续 读取整数 触发 EOF 返回 错误(错误码.文件)，验证 EOF 语义）
// 打印语义（用户裁决）：打印=println（自动换行）
// 注意：读取行 返回动态字符串，用完必须 字符串释放（规避内存泄漏）

函数 主() -> 整32 {
    打印("===== IO 输入库（Task 6.2）=====")

    // ---- 1. 读取行（整行字符串，不含换行）----
    字符串 行 = IO::读取行()
    如果 (行 != 无) {
        打印("读取行: ", 行)
        字符串释放(行)   // 动态分配，用完释放
    } 否则 {
        打印("读取行失败(EOF)")
    }

    // ---- 2. 读取整数（strtoll 整行解析，成功标志输出）----
    整32 整数标志 = 0
    整64 整数值 = IO::读取整数(&整数标志)
    如果 (整数标志 == 1) {
        打印("读取整数: ", 整数值)
    } 否则 {
        打印("读取整数失败")
    }

    // ---- 3. 读取浮点（strtod 整行解析，成功标志输出）----
    整32 浮点标志 = 0
    浮64 浮点值 = IO::读取浮点(&浮点标志)
    如果 (浮点标志 == 1) {
        打印("读取浮点: ", 浮点值)
    } 否则 {
        打印("读取浮点失败")
    }

    // ---- 4. EOF 语义：输入已耗尽，读取整数 触发 EOF 返回成功标志0 ----
    整32 结束标志 = 1
    整64 结束值 = IO::读取整数(&结束标志)
    如果 (结束标志 == 1) {
        打印("EOF读取整数: ", 结束值)
    } 否则 {
        打印("EOF读取整数失败")
    }

    打印("===== IO 输入库测试完成 =====")
    返回 0
}
