// 542（822 轮·053-002 探针转正）：128 位静态写回+复合赋值矩阵——静态 128/正128
//   初值+不安全函数内静态写回（2^64+1·双半写）+复合赋值 += -= *=（回绕/进位）
//   +三元混合宽度（整128 : 整32 字面量·隐式提升）+自增。双编译对照：宿主内联
//   add/adc 与 v2 __cn_add_i128/sub/mul 辅助函数行为逐字一致。
静态 整128 静 = 170141183460469231731687303715884105727;
静态 正128 静无 = 340282366920938463463374607431768211455;
不安全 函数 写入() -> 空类型 {
    静 = 18446744073709551617;
}
// 474 翻转（2026-10-12）：复合赋值矩阵收敛到不安全域（§1.1a④ 零检查·回绕
//   对照价值保留——822 轮「宿主内联 add/adc 与 v2 helper 行为逐字一致」的
//   回绕矩阵原样运行）；安全域溢出触发面由 738_整128溢出检查错误码8 锚定。
不安全 函数 矩阵() -> 空类型 {
    整128 甲 = 170141183460469231731687303715884105727;
    甲 += 1;
    打印行(甲);
    甲 -= 2;
    打印行(甲);
    甲 *= 2;
    打印行(甲);
    布尔 条 = 真;
    整128 三 = 条 ? 甲 : 12345;
    打印行(三);
    整128 乙 = 甲;
    乙++;
    打印行(乙);
}
函数 主() -> 整32 {
    打印行(静);
    写入();
    打印行(静);
    打印行(静无);
    正128 u = 123456789;
    打印行(u >> 100);
    矩阵();
    返回 0;
}
