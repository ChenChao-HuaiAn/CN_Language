// 官网文档示例 · tutorial-safety.html · 结果（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
导入 核心::错误码;

函数 安全除法(整64 a, 整64 b) -> 结果<整64, 整32> {
    如果 (b == 0) {
        返回 错误(错误码.除零);     // 失败路径
    }
    返回 正常(a / b);               // 成功路径
}

函数 主() -> 整32 {
    结果<整64, 整32> 好 = 安全除法(10, 2);
    如果 (好.正常) {
        打印(好.值);                 // 5（仅正常分支可取 .值）
    }
    结果<整64, 整32> 坏 = 安全除法(10, 0);
    如果 (!坏.正常) {
        打印("失败，错误码 ", 坏.错误);
    }
    返回 0;
}