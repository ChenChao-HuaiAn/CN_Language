// 9263tmp_g（263① 边界探针·临时不入库）：返回整盒结构体（返回 表.元素(0);）。
//   返回结构体值分支（retbuf 深拷 85-a 域）+ 元素() 物化临时叠加——探明返回
//   结构体值路径的物化临时是否回收（生成返回结构体值分支 内部无 203 收口）。
//   1000 轮放大。7=绿；1=泄漏；0=值错。
导入 容器::向量;

结构体 盒子 {
    字符串 名;
    整32 号;
}

函数 形探() -> 盒子 {
    向量<盒子> 表 = 向量<盒子>();
    结果<空类型, 整32> 加 = 表.追加(盒子{ 名 = 字符串复制("P263G串"), 号 = 7 });
    如果 (!加.正常) { 盒子 空 = 盒子{ 名 = 字符串复制(""), 号 = 0 }; 返回 空; }
    返回 表.元素(0);
}

函数 主() -> 整32 {
    整64 前 = 内存::活动分配数();
    整32 i = 0;
    当 (i < 1000) {
        盒子 抄 = 形探();
        如果 (抄.号 != 7) { 打印(0); 返回 0; }
        i++;
    }
    如果 (内存::活动分配数() != 前) { 打印(1); 返回 0; }
    打印(7);
    返回 0;
}
