// 741（955·2026-10-14）：有析构类+显式拷贝构造 正例对照——语义强制放行面
//   锁定：有析构类有了显式拷贝构造（函数 类名(类名& 其他) 深拷贝）后，声明
//   初始化拷贝/赋值拷贝均合法（宿主 checkCopyRequiresCtor 拷贝构造存在即
//   放行；v2 741 挂点同判定）。运行验证拷贝独立性（改副本不影响源）与赋值
//   拷贝值正确——邻界面（无拷贝构造须拒）由 112/954 负测锁面。
类 配置 {
公开:
    整64 值;
    函数 配置() { 值 = 0; }
    函数 配置(配置& 其他) { 值 = 其他.值; }
    不安全 函数 ~配置() { }
}
函数 主() -> 整32 {
    配置 甲 = 配置();
    甲.值 = 42;
    配置 乙 = 甲;
    乙.值 = 99;
    打印("甲仍: ", 甲.值);
    打印("乙变: ", 乙.值);
    配置 丙 = 配置();
    丙 = 甲;
    打印("丙拷: ", 丙.值);
    返回 0;
}
