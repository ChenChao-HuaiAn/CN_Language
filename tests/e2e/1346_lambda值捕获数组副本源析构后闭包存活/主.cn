// E2E 1346_lambda值捕获数组副本源析构后闭包存活（#1880·dual 双编译对照锁用例）：
//   **释放时序判别主锁**：lambda 值捕获字符串数组→源数组出块析构（元素串
//   释放面·98-a 局部数组元素释放）→闭包后调——元素级深拷副本独立存活
//   （001 §一D「值捕获快照语义无悬垂面」）。修复前=整组位拷句柄浅共享：
//   源析构释放元素堆串后快照句柄悬垂（宿主探针实录=垃圾串野读输出）。
//   闭包存外层变量跨块存活（变量重赋值 lambda 值=蹦床地址·1663 形态③
//   fnptr 同源值模型）。
// 期望手算（逐行）：
//   ① 块内源在：读=甲甲甲甲 乙乙乙乙（源存活期快照读）；
//   ② 源出块析构后：读=甲甲甲甲 乙乙乙乙（副本独立存活·修复前悬垂垃圾）。
函数 主() -> 整32 {
    变量 读 = [=]() -> 整32 { 返回 0; };
    {
        字符串[2] 组;
        组[0] = 字符串复制("甲甲甲甲");
        组[1] = 字符串复制("乙乙乙乙");
        读 = [组]() -> 整32 { 打印(组[0]); 打印(组[1]); 返回 0; };
        读();                // 甲甲甲甲 / 乙乙乙乙（源存活期）
    }
    读();                    // 甲甲甲甲 / 乙乙乙乙（源析构后·副本独立存活）
    返回 0;
}
