// 语句终止与续行综合演示（cn-language-spec 01a第三节 / 03第零节）
// 覆盖四条规则：
//   规则1：语句无需终止符、分号可选、关键字边界识别
//   规则2：换行≡空格天然续行（括号未闭合跨行结构安全 + 行尾运算符）
//   规则3：单行多语句（显式分号分隔）
//   规则4：空循环体合法；循环头三段分号（唯一强制分号）

函数 双倍(整32 x) -> 整32 {
    返回 x * 2          // 规则1：无分号返回语句
}

函数 主() -> 整32 {
    // ===== 规则1：无终止符 + 可选分号 + 关键字边界 =====
    变量 a = 1           // 无分号变量声明合法
    变量 b = 2;          // 带分号合法（C 习惯）
    变量 x = 1 整32 y = 2   // 无分号关键字边界：整32 触发新声明 y
    打印("可选分号: ", a + b)                // 可选分号: 3
    打印("关键字边界: ", x + y)              // 关键字边界: 3

    // ===== 规则2：续行（换行≡空格） =====
    // 2a. 行尾运算符续行：1 + 换行 2
    变量 s = 1 +
             2
    打印("行尾运算符续行: ", s)              // 行尾运算符续行: 3

    // 2b. 括号未闭合跨行函数调用
    打印("跨行调用: ",
         双倍(
             3
         ))                                  // 跨行调用: 6

    // 2c. 括号未闭合跨行下标
    整32[3] 数据 = { 10, 20, 30 }
    打印("跨行下标: ",
         数据[
             1
         ])                                  // 跨行下标: 20

    // 2d. 括号未闭合跨行表达式分组
    打印("跨行分组: ", (1 +
                         2) * 3)             // 跨行分组: 9

    // ===== 规则3：单行多语句（显式分号） =====
    变量 i = 0; ++i; --i;
    打印("单行多语句: ", i)                 // 单行多语句: 0

    // ===== 规则4：空循环体 + 循环头分号 =====
    变量 次数 = 0
    当 (次数 < 3) { 次数++ }                // 非空循环体
    当 (次数 > 99) { }                      // 空循环体合法（条件为假，不进入，无死循环）
    打印("空循环体后: ", 次数)              // 空循环体后: 3

    变量 和 = 0
    循环 (整32 j = 0; j < 3; j++) {         // 循环头三段分号（唯一强制分号）
        和 = 和 + j
    }
    打印("循环头三段: ", 和)                // 循环头三段: 3

    返回 0                                   // 规则1：无分号返回
}
