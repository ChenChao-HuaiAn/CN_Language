// Task 2.8 字符串系统完善 E2E 测试
// 覆盖：子串/字典序/大小写/前后缀/包含/修剪/反转/数字转字符串/字符转字符串/
//       字符串释放/字符串数组/空字符串/值语义（共享指针）
// 新增运行时 API（规格书10.1 补充标注，Task 2.8）：
//   字符串子串 -> __cn_str_sub、字符串字典序 -> __cn_str_cmp、
//   字符串大写 -> __cn_str_upper、字符串小写 -> __cn_str_lower、
//   字符串前缀 -> __cn_str_starts_with、字符串后缀 -> __cn_str_ends_with、
//   字符串包含 -> __cn_str_contains、字符串修剪 -> __cn_str_trim、
//   字符串反转 -> __cn_str_reverse、字符串从整数 -> __cn_str_from_int、
//   字符串从浮点 -> __cn_str_from_float、字符串从字符 -> __cn_str_from_char、
//   字符串释放 -> __cn_str_free
函数 主() -> 整32 {
    // 1. 子串（字节偏移，UTF-8 按字节）
    字符串 子 = 字符串子串("Hello World", 6, 5)
    打印(子)                                   // World
    字符串释放(子)
    字符串 中 = 字符串子串("你好世界", 3, 3)      // 好（字节3起3字节）
    打印(中)
    字符串释放(中)

    // 2. 字典序比较（<0 / 0 / >0）
    打印行整数(字符串字典序("abc", "abd"))       // -1
    打印行整数(字符串字典序("abc", "abc"))       // 0
    打印行整数(字符串字典序("abd", "abc"))       // 1

    // 3. 大小写（ASCII）
    字符串 上 = 字符串大写("hello")
    打印(上)                                   // HELLO
    字符串释放(上)
    字符串 下 = 字符串小写("WORLD")
    打印(下)                                   // world
    字符串释放(下)

    // 4. 前后缀 / 包含
    如果 (字符串前缀("hello", "he")) { 打印("前缀:真") } 否则 { 打印("前缀:假") }
    如果 (字符串后缀("hello", "lo")) { 打印("后缀:真") } 否则 { 打印("后缀:假") }
    如果 (字符串包含("hello", "ell")) { 打印("包含:真") } 否则 { 打印("包含:假") }

    // 5. 修剪（去首尾空白：空格/制表/换行）
    字符串 剪 = 字符串修剪("  你好  ")
    打印(剪)                                   // 你好
    字符串释放(剪)

    // 6. 反转（按字节反转，UTF-8 安全：不拆多字节字符）
    字符串 反 = 字符串反转("abc")
    打印(反)                                   // cba
    字符串释放(反)
    字符串 反中 = 字符串反转("你好")
    打印(反中)                                 // 好你
    字符串释放(反中)

    // 7. 数字转字符串
    字符串 数 = 字符串从整数(12345)
    打印(数)                                   // 12345
    字符串释放(数)
    字符串 负 = 字符串从整数(-42)
    打印(负)                                   // -42
    字符串释放(负)
    字符串 浮 = 字符串从浮点(3.5)
    打印(浮)                                   // 3.500000
    字符串释放(浮)

    // 8. 字符转字符串（单字节 ASCII）
    字符串 字 = 字符串从字符('A')
    打印(字)                                   // A
    字符串释放(字)

    // 9. 字符串数组（元素为字符串指针）
    字符串[3] 列表
    列表[0] = "一"
    列表[1] = "二"
    列表[2] = "三"
    打印(列表[0])                              // 一
    打印(列表[2])                              // 三
    打印(列表[0] + 列表[1] + 列表[2])          // 一二三

    // 10. 空字符串（长度0、连接、比较）
    字符串 空 = ""
    打印行整数(字符串长度(空))                    // 0
    打印(空 + "x")                             // x
    如果 (字符串比较(空, "")) { 打印("空串相等:真") } 否则 { 打印("空串相等:假") }

    // 11. 值语义（字符串变量为指针，赋值共享不深拷贝；显式深拷贝用 字符串复制）
    字符串 s = "你好"
    字符串 t = s
    打印(s)                                    // 你好
    打印(t)                                    // 你好
    字符串 u = 字符串复制(s)
    打印(u)                                    // 你好
    字符串释放(u)

    // 12. 连接链式（动态分配，末次结果释放）
    字符串 ab = "A" + "B"
    打印(ab)                                   // AB
    字符串释放(ab)

    返回 0
}
