// E2E 129_v2_字符串下标与复合赋值与登记补全（2026-09-03，③ 自举对拍第二波，
//   三项同轮载体：字符串下标 + 复合赋值五形态 + 方案A 类型登记点补全）
// 载体动因：
//   ① v2p 编译 v2 组件（词法分析.cn）IR 崩点=字符串下标 源码[位置]——宿主 A-1
//     语法（plans/004：UTF-8 字节视图步进 1、LoadPtr i8 有符号扩展（双后端
//     movsx/ldrsb，与 C 的 s[i] 一致）、越界由调用方按 字符串长度 约束、结果
//     类型 字符），v2 解析有 [ 分支但子区间信息丢失、语义/IR 两层未实现；
//   ② 复合赋值五形态（用户裁决方案A 一次根治）：原词法层只有 += 单 token 且
//     解析层零分支——+= 不消费 -> 解析块循环保护静默中断 -> 块内后续语句丢弃
//     （词法分析.cn 分词 被截断的假绿冒烟根因，探针实锤）；-= *= /= %= 词法层
//     本轮补齐（原以 - = 双 token 进入同样静默断路）；
//   ③ 方案A 登记点补全（用户裁决）：类型登记表三缺口（成员加载值/用户函数返回/
//     容器方法返回）——打印错分派 print_int（打指针值）与拼接漏判/误转 from_int
//     （指针转数字串）的静默错误代码（asm 探针实锤；代码生成共用.cn:30/104
//     字节十六进制=符号修饰核心、主.cn:60 行.值、IR签名.cn:394 元素(i) 实际在用）。
// 闭环：v2p 编译 -> as -> g++（供给.cn 经宿主管线供给 映射$整64$字符串 符号——
//   v2 组件自身未实例化该类型）-> 运行。退出码=0 全过；11~38 各失败码。
导入 容器::向量;
导入 映射集合::映射;

结构体 记录 {
    字符串 标题;
    整64 计数;
}

// v2 组件 字节值 同款（词法分析.cn:30——符号补偿：负字节 +256 -> 0..255）
函数 字节值(字符串 源码, 整64 位置) -> 整64 {
    整64 值 = 整64(源码[位置]);
    如果 (值 < 0) {
        返回 值 + 256;
    }
    返回 值;
}

// 用户函数返回字符串（方案A 登记点②载体——拼接/打印消费）
函数 取名() -> 字符串 {
    返回 "名";
}

函数 主() -> 整32 {
    // ===== 一、字符串下标（宿主 A-1 语义，65 用例对齐）=====
    // 1. ASCII 基本下标
    字符串 s = "ABC";
    如果 (整32(s[0]) != 65) { 返回 11; }
    如果 (整32(s[1]) != 66) { 返回 12; }
    如果 (整32(s[2]) != 67) { 返回 13; }

    // 2. UTF-8 多字节符号扩展（宿主 C s[i] 语义：字节>=0x80 -> 负值——
    //    "你"=E4 BD A0 -> -28/-67/-96；ldrb 零扩展错值即此处拦截）
    字符串 中文 = "你好";
    如果 (整64(中文[0]) != 0 - 28) { 返回 14; }
    如果 (整64(中文[1]) != 0 - 67) { 返回 15; }
    如果 (整64(中文[2]) != 0 - 96) { 返回 16; }

    // 3. 循环逐字节求和（65 用例同款：字节和 -376；复合赋值 += 形态——
    //    词法分析.cn 位置 += 2 同款）
    整64 总和 = 0;
    整64 i = 0;
    当 (i < 字符串长度(中文)) {
        总和 += 整64(中文[i]);
        i++;
    }
    如果 (总和 != 0 - 376) { 返回 17; }

    // 4. 负值补偿（v2 组件 字节值 同款：+256 -> 228）
    如果 (字节值(中文, 0) != 228) { 返回 18; }
    如果 (字节值(s, 0) != 65) { 返回 19; }

    // 5. 二元表达式下标（代码生成共用.cn:71 类型文本[长-1] 同款）
    如果 (整32(s[3 - 1]) != 67) { 返回 20; }
    整64 长 = 字符串长度(s);
    如果 (整32(s[长 - 1]) != 67) { 返回 21; }

    // 6. 字符串参数下标（字节值 形态；参数权威表登记路径）
    如果 (字节值(s, 2) != 67) { 返回 22; }

    // 7. 结构体字符串字段下标（65 名片.标题[0] 同款）——"题"=E9 A2 98 -> 首字节 -23
    记录 名片;
    名片.标题 = "题";
    如果 (整32(名片.标题[0]) != 0 - 23) { 返回 23; }

    // ===== 二、复合赋值五形态（方案A 裁决：原静默丢句——最小探针 a += 2 后
    //     返回语句消失、sem5 零诊断）=====
    整64 a = 10;
    a += 5;
    如果 (a != 15) { 返回 24; }
    a -= 3;
    如果 (a != 12) { 返回 25; }
    a *= 2;
    如果 (a != 24) { 返回 26; }
    a /= 4;
    如果 (a != 6) { 返回 27; }
    a %= 4;
    如果 (a != 2) { 返回 28; }
    整64 b = 7;
    b += a * 3;
    如果 (b != 13) { 返回 29; }
    // 成员左值复合赋值（回退重析左值；宿主要求数值操作数——字符串 += 宿主拒绝，
    //   v2 语义浅检查不拦，用例按宿主语义用数值字段）
    名片.计数 = 40;
    名片.计数 += 2;
    如果 (名片.计数 != 42) { 返回 30; }
    如果 (!字符串比较(名片.标题, "题")) { 返回 39; }

    // ===== 三、方案A 登记点补全（打印分派/拼接判定）=====
    // 8. 成员字符串打印（缺陷①同族：根治前 print_int 打指针值）
    打印(名片.标题);                        // 期望: 题文
    // 9. 用户函数返回字符串打印（根治前 print_int 打指针值）
    打印(取名());                           // 期望: 名
    // 10. 字面量+用户函数返回拼接（缺陷②同族：根治前 from_int(指针) 转数字串）
    字符串 拼a = "x" + 取名();
    如果 (!字符串比较(拼a, "x名")) { 返回 31; }
    // 11. 用户函数返回+字面量拼接（左侧未登记：根治前裸 add 指针+指针）
    字符串 拼b = 取名() + 取名();
    如果 (!字符串比较(拼b, "名名")) { 返回 32; }
    // 12. 变量+用户函数返回（右侧未登记：根治前 from_int(指针)）
    字符串 前缀 = "n";
    字符串 拼c = 前缀 + 取名();
    如果 (!字符串比较(拼c, "n名")) { 返回 33; }
    // 13. 容器方法返回字符串拼接+打印（主.cn:200/IR签名.cn:394 同款形态）
    向量<字符串> 词表 = 向量<字符串>();
    结果<空类型, 整32> 加词 = 词表.追加("词");
    如果 (!加词.正常) { 返回 34; }
    字符串 拼d = "[" + 词表.元素(0) + "]";
    如果 (!字符串比较(拼d, "[词]")) { 返回 35; }
    打印(词表.元素(0));                     // 期望: 词
    // 14. 结果.值 字符串载荷拼接+打印（主.cn:60 内容+行.值 同款；符号经 供给.cn）
    映射<整64, 字符串> 名表 = 映射<整64, 字符串>();
    结果<空类型, 整32> 设名 = 名表.设置(1, "甲");
    如果 (!设名.正常) { 返回 36; }
    结果<字符串, 整32> 取名2 = 名表.获取(1);
    如果 (取名2.正常) {
        字符串 拼e = 取名2.值 + "!";
        如果 (!字符串比较(拼e, "甲!")) { 返回 38; }
        打印(取名2.值);                     // 期望: 甲
    } 否则 {
        返回 37;
    }

    打印("字符串下标与复合赋值与登记: 全部通过");
    返回 0;
}
