// 320-a（清零波次6·T37+T38+T40+T41·方案甲）：语句表达式语义四正例——
//   T37 选择负值/常量表达式标签分派；T38 同名两循环并存（循环头作用域限定）；
//   T40 字符拼接按 Unicode 码点 UTF-8 编码；T41 静态局部一次性初始化（C 同款）。
函数 步进() -> 整32 {
    静态 整32 计 = 0;
    计 = 计 + 2;
    返回 计;
}
函数 主() -> 整32 {
    // T37：负值/常量表达式标签
    整32 甲 = -1;
    选择 (甲) {
        情况 -1: 打印(100);
        情况 (0-2): 打印(200);
        情况 1, -3: 打印(300);
        默认: 打印(400);
    }
    整32 乙 = 0 - 2;
    选择 (乙) {
        情况 -2: 打印(500);
        默认: 打印(600);
    }
    // T38：同名两循环（循环头变量限于循环体——同名可并存）
    循环 (整32 丙 = 0; 丙 < 2; 丙 = 丙 + 1) { 打印(丙); }
    循环 (整32 丙 = 5; 丙 < 7; 丙 = 丙 + 1) { 打印(丙); }
    // T40：字符拼接码点编码
    打印("字符=" + '好');
    打印("A=" + 'A');
    // T41：静态局部跨调用持久
    打印(步进());
    打印(步进());
    打印(步进());   // 2_4_6
    返回 0;
}
