// 826（任务 442·421 轮审查 P2-2/P2-3）：i128 实参宽化/符号扩展判据族双编译对照。
//   背景（审查微差）：宿主 widenI128Args「排除浮点实参 + 形参数截断 + 按形参 kind」
//   对 v2「不排除浮点 + min 截断 + 按实参类型」——判据微差；实测**真分叉**：
//   宿主间接（函数指针）调用路径无有效形参表 → ①已 128 位实参被
//   (argIs128 && !paramIs128) 误截断 i64（高半丢失 → 再宽化按 i64 符号扩展
//   = 静默错值：fnptr 实参 2^64+1 读出 1）；②浮32 实参对浮32 形参被无条件
//   提升 f64（指32(2.5f) 读出 1.5）。修复=有效形参表统一判据源（直调=语义层
//   形参表 / 间接=callee 源码类型串形参表·v2 签名表驱动同构）+ 构造路径内联
//   副本归并 单一归属 widenI128Args + 去浮点排除（浮点→128 走转换通道）。
//   覆盖：①实参宽度全族 {整8/整16/整32/整64/整128/正8/正16/正32/正64/正128/
//   字符} × 形参 {整128/正128}（正负值与边界值——零扩展 vs 符号扩展判别）；
//   ②调用路径全族（直调/实例方法/静态方法/构造/函数指针/高阶函数指针/lambda
//   闭包/方法作值闭包）；③引用形参位不宽化（466 锚）；④浮32 形参间接调用定标。
//   v2 侧既有欠账（不在本用例面·另案）：128 位**聚合返回** lambda 蹦床 ABI。
函数 吃整128(整128 值) -> 整128 { 返回 值; }
函数 吃正128(正128 值) -> 正128 { 返回 值; }
函数 应用整(整128(*处理)(整128), 整128 值) -> 整128 { 返回 处理(值); }
函数 应用正(正128(*处理)(正128), 正128 值) -> 正128 { 返回 处理(值); }
函数 整报(整128 值) -> 整128 { 返回 值; }
函数 正报(正128 值) -> 正128 { 返回 值; }
函数 吃浮32(浮32 值) -> 浮32 { 返回 值 + 1.5f; }
类 盒 {
公开:
    整128 存整;
    正128 存正;
    函数 盒(正128 初) { 存整 = 0; 存正 = 初; }
    函数 装整(整128 值) -> 整128 { 存整 = 值; 返回 存整; }
    函数 装正(正128 值) -> 正128 { 存正 = 值; 返回 存正; }
    函数 收窄(整128 值) -> 整32 { 存整 = 值; 打印行("乙收窄=", 存整); 打印(""); 返回 0; }
    函数 存标(整128 值) -> 整32 { 存整 = 值; 打印行("丁方=", 存整); 打印(""); 返回 0; }
    静态 函数 整静(整128 值) -> 整128 { 返回 值; }
    静态 函数 正静(正128 值) -> 正128 { 返回 值; }
}
函数 收引用(整128& 值) -> 整32 { 值 = 值 + 1; 打印行("戊内=", 值); 打印(""); 返回 0; }
函数 主() -> 整32 {
    整8 整8负 = 整8(0 - 3);
    整16 整16负 = 整16(0 - 300);
    整32 整32负 = 0 - 1;
    整32 整32下界 = (0 - 2147483647) - 1;
    整64 整64负 = 0 - 1;
    整64 整64下界 = (0 - 9223372036854775807) - 1;
    正8 正8大 = 250;
    正16 正16大 = 60000;
    正32 正32大 = 4000000000;
    正64 正64位63 = 9223372036854775808ULL;
    正64 正64最大 = 18446744073709551615ULL;
    整128 整128负 = 0 - 170141183460469231731687303715884105727;
    整128 整128宽 = 18446744073709551617;
    正128 正128最大 = 340282366920938463463374607431768211455ULL;
    正128 正128宽 = 18446744073709551617ULL;
    字符 字 = 'A';

    // ---- 甲：直调矩阵（实参宽度 × 形参种类·正负值与零/符号扩展判别）----
    打印行("甲整8=", 吃整128(整8负)); 打印("");
    打印行("甲整16=", 吃整128(整16负)); 打印("");
    打印行("甲整32负=", 吃整128(整32负)); 打印("");
    打印行("甲整32下界=", 吃整128(整32下界)); 打印("");
    打印行("甲整64负=", 吃整128(整64负)); 打印("");
    打印行("甲整64下界=", 吃整128(整64下界)); 打印("");
    打印行("甲整128负=", 吃整128(整128负)); 打印("");
    打印行("甲整128宽=", 吃整128(整128宽)); 打印("");
    打印行("甲正8=", 吃正128(正8大)); 打印("");
    打印行("甲正16=", 吃正128(正16大)); 打印("");
    打印行("甲正32=", 吃正128(正32大)); 打印("");
    打印行("甲正64位63=", 吃正128(正64位63)); 打印("");
    打印行("甲正64最大=", 吃正128(正64最大)); 打印("");
    打印行("甲正128最大=", 吃正128(正128最大)); 打印("");
    打印行("甲正128宽=", 吃正128(正128宽)); 打印("");
    打印行("甲字符整=", 吃整128(字)); 打印("");
    打印行("甲字符正=", 吃正128(字)); 打印("");
    打印行("甲字面5=", 吃整128(5)); 打印("");
    打印行("甲字面负=", 吃整128(0 - 1)); 打印("");
    打印行("甲字面正=", 吃正128(4000000000)); 打印("");

    // ---- 乙：实例方法/静态方法/构造 路径 ----
    盒 对象 = 盒(0);
    打印行("乙方整=", 对象.装整(整64负)); 打印("");
    打印行("乙方正=", 对象.装正(正64最大)); 打印("");
    打印行("乙方128=", 对象.装整(整128宽)); 打印("");
    打印行("乙静整=", 盒.整静(整32下界)); 打印("");
    打印行("乙静正=", 盒.正静(正32大)); 打印("");
    打印行("乙静128=", 盒.整静(整128负)); 打印("");
    盒 构造物 = 盒(正128宽);
    打印行("乙构正=", 构造物.存正); 打印("");
    对象.收窄(整32下界);

    // ---- 丙：函数指针 + 高阶函数指针（F1 锁：已 128 位实参不得截断）----
    整128(*整指)(整128) = 整报;
    正128(*正指)(正128) = 正报;
    打印行("丙指窄=", 整指(整64负)); 打印("");
    打印行("丙指128=", 整指(整128宽)); 打印("");
    打印行("丙指128负=", 整指(整128负)); 打印("");
    打印行("丙指正=", 正指(正64位63)); 打印("");
    打印行("丙指正128=", 正指(正128宽)); 打印("");
    打印行("丙高阶窄=", 应用整(整报, 整32负)); 打印("");
    打印行("丙高阶128=", 应用整(整报, 整128宽)); 打印("");
    打印行("丙高阶正=", 应用正(正报, 正64最大)); 打印("");
    打印行("丙高阶正128=", 应用正(正报, 正128最大)); 打印("");
    浮32(*浮指)(浮32) = 吃浮32;
    浮32 浮小 = 2.5f;
    打印行("丙浮32=", 浮指(浮小)); 打印("");

    // ---- 丁：lambda 闭包 / 方法作值闭包（标量返回）× 128 实参 ----
    变量 匿窄 = [](整128 值) -> 整32 { 打印行("丁匿窄=", 值); 打印(""); 返回 0; };
    匿窄(整64负);
    变量 匿宽 = [](整128 值) -> 整32 { 打印行("丁匿宽=", 值); 打印(""); 返回 0; };
    匿宽(整128宽);
    变量 方窄 = 对象.存标;
    方窄(整32下界);
    变量 方宽 = 对象.存标;
    方宽(整128负);

    // ---- 戊：128& 引用形参位不宽化（466 锚：引用实参传左值地址·体内改态可见）----
    打印行("戊引用前=", 整128宽); 打印("");
    收引用(整128宽);
    打印行("戊引用后=", 整128宽); 打印("");
    返回 0;
}
