// E2E 877（dual·630·544 呈报两异常收口）：容器方法返回类元素两形态——
//     ①赋值位·容器接收面 甲 = 表.元素(0)（544 保守排除「接收者=容器」的
//       扩展面）：v2 原产物=调用物化槽（栈地址）经 472-a 直存甲槽 → 块出口
//       按堆句柄释放栈地址（free(): invalid pointer·munmap_chunk 崩溃）——
//       探针 rc=134 实录；修后调用点发射拷贝构造副本（对齐宿主元素() 副本语义
//       ·plans/001 §052 甲快照）→ 产物=堆副本句柄直存+旧值释放。
//     ②声明位·容器元素返回 货架 乙 = 表.元素(0)：v2 原落「发射类拷贝构造
//       初始化」深拷主路径——物化槽内为元素对象**句柄**却被按「对象本体」多
//       一层包装+资源字段深拷误读 → 乙.记录.大小()=0 错值；宿主侧则副本已
//       生成（元素() 返回副本）但「H8-5 容器元素视图」豁免未随副本化收窄 →
//       副本失去释放路径（块出口活性 +2 泄漏）；修后 v2 直存副本句柄、
//       宿主 类类型接收不再豁免析构 → 双侧同值同净。
//   断言口径（283/719/836/876 同款）：每形态 副本值正确（记录.大小()==1）且
//   副本作用域出口后 内存::活动分配数 相对基线差值==0（副本独立拥有且恰好
//   释放一次）→ 置位。①…位1 ②…位2；宿主/v2 双侧同源同值（退出码 3=全位；
//   v2 修前=①崩 134/②错值 0；宿主修前=②副本泄漏 2）。基线取在容器建立后、
//   副本声明前——容器自身生命周期净值不入判据（另案存量面）。
导入 容器::向量;

类 货架 {
公开:
    向量<字符串> 记录;
    函数 货架() { 记录 = 向量<字符串>(); }
    函数 ~货架() { }
    不安全 函数 货架(货架& 其他) { 记录 = 其他.记录; }
}

函数 主() -> 整32 {
    整32 校验 = 0;
    // ① 赋值位·容器接收 甲 = 表.元素(0)（容器方法返回类·赋值通道接管）
    {
        向量<货架> 表;
        货架 造;
        结果<空类型, 整32> r1 = 造.记录.追加(字符串复制("甲"));
        结果<空类型, 整32> a1 = 表.追加(造);
        整64 b1 = 内存::活动分配数();
        整64 内1 = 0;
        {
            货架 甲;
            甲 = 表.元素(0);
            内1 = 甲.记录.大小();
        }
        如果 (内1 == 1 && 内存::活动分配数() - b1 == 0) { 校验 = 校验 + 1; }
    }
    // ② 声明位·容器元素返回 货架 乙 = 表.元素(0)（副本接收·值语义快照）
    {
        向量<货架> 表2;
        货架 造2;
        结果<空类型, 整32> r2 = 造2.记录.追加(字符串复制("乙"));
        结果<空类型, 整32> a2 = 表2.追加(造2);
        整64 b2 = 内存::活动分配数();
        整64 内2 = 0;
        {
            货架 乙 = 表2.元素(0);
            内2 = 乙.记录.大小();
        }
        如果 (内2 == 1 && 内存::活动分配数() - b2 == 0) { 校验 = 校验 + 2; }
    }
    返回 校验;
}
