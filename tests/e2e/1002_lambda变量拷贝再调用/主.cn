// 1002：lambda 变量拷贝再调用（816·655 返工遗留乙·判据扩面锁用例）
// 655 返工在间接调用尾立「funcPtrTypeOfCallee 全域 miss」诊断①，豁免判据=
//   lambdaVarNames_ 留痕集；原留痕只在直接 lambda/方法值初始化位，拷贝形态
//   （变量 f = 取和; f(...)）缺席 oracle——类型串回填链覆盖时行为正确（①误报
//   用例面无实录），类型串缺口时该名即被误判真全域 miss 落①误报。
// 816 修：registerClosureIfNeeded 传递登记——拷贝名与直接初始化同权入留痕集。
// 断言：各拷贝形态编译零诊断+运行输出正确（蹦床通道与快径语义等价）。
// 形态覆盖：①直接拷贝 ②二级拷贝链 ③lambda 体内拷贝 ④fnptr 形参拷贝
//   ⑤485 clear 场景（同函数多 lambda 快径被清后拷贝调用）⑥方法值拷贝。
类 计数器 {
公开:
    整32 值;
    函数 计数器(整32 初值) { 值 = 初值; }
    函数 步进(整32 加数) -> 整32 {
        值 = 值 + 加数;
        返回 值;
    }
}

函数 借调(整32(*回调)(整32)) -> 整32 {
    变量 f = 回调;              // ④形参拷贝
    返回 f(3);
}

函数 主() -> 整32 {
    变量 基数 = 10;
    变量 取和 = [基数](整32 a) -> 整32 { 返回 a + 基数; };
    打印(取和(1));              // 11（快径直调对照）
    变量 f = 取和;              // ①直接拷贝
    打印(f(4));                 // 14
    变量 g = f;                 // ②二级拷贝链
    变量 h = g;
    打印(h(2));                 // 12
    变量 外调 = [取和]() -> 整32 {
        变量 内f = 取和;        // ③lambda 体内拷贝
        返回 内f(6);
    };
    打印(外调());               // 16
    打印(借调(取和));           // 13（lambda 经 fnptr 形参传递再调用）
    变量 取差 = [基数](整32 a) -> 整32 { 返回 a - 基数; };  // ⑤后定义 lambda
    变量 f2 = 取和;             // 快径被 485 clear 纪律影响后的拷贝
    打印(f2(5));                // 15（蹦床通道·留痕判据在场）
    打印(取差(20));             // 10（蹦床通道对照）
    计数器 计 = 计数器(100);
    变量 cb = 计.步进;          // 方法值（原留痕路径对照）
    打印(cb(5));                // 105
    变量 cb2 = cb;              // ⑥方法值拷贝
    打印(cb2(6));               // 111
    返回 0;
}
