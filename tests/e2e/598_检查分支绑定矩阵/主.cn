// E2E 598（2026-10-05 #045b 切片2）：强制检查 分支绑定 15 正形态矩阵——同一源码
//   宿主+v2p 双编译双运行退出码须相等（校验和 32767 -> 退出码 255）。
//   宿主侧锚（045/060 全绿+067-002/574-a 守卫族）=v2 同构目标：丙案双查根治
//   （选择情况段跳过+条件区单遍化）+检查面同构（取反两支互换/短路守卫传导/
//   嵌套否则如果错误标/可选类别兼容）落地后 v2 侧零误报零误拒。
//   15 形态（载体=简单变量名；下标/成员链对象载体=v2 IR/布局层独立边界·不入本矩阵）：
//   ①r.正常 真块取 .值 ②r.正常 否则块取 .错误 ③o.有值 真块取 .值（可选）
//   ④!r.正常 真块取 .错误 ⑤!r.正常 否则块取 .值 ⑥!o.有值 否则块取 .值
//   ⑦r.正常 && r.值==N 短路传导 ⑧!r.正常 && r.错误==N 短路取反（574-a 实录）
//   ⑨真块内嵌套裸块取 .值 ⑩嵌套如果内层条件用外层已查值（263 形态）
//   ⑪真块内 选择 体中取 .值（丙案双查锚）⑫否则链嵌套如果支取 .错误（宿主错误标）
//   ⑬遮蔽声明后重查再取（592 正向版）⑭可选转发声明后检查取值 ⑮嵌套如果新变量内层自用
函数 主() -> 整32 {
    整32 校验 = 0;
    // ① 结果基线
    结果<整32, 整32> 甲 = 正常(1);
    如果 (甲.正常) {
        如果 (甲.值 == 1) { 校验 = 校验 + 1; }
    }
    // ② 否则块取 .错误
    结果<整32, 整32> 乙 = 错误(2);
    如果 (乙.正常) {
        校验 = 校验 + 0;
    } 否则 {
        如果 (乙.错误 == 2) { 校验 = 校验 + 2; }
    }
    // ③ 可选基线
    可选<整32> 丙 = 某些(3);
    如果 (丙.有值) {
        如果 (丙.值 == 3) { 校验 = 校验 + 4; }
    }
    // ④ 取反真块=错误分支
    结果<整32, 整32> 丁 = 错误(4);
    如果 (!丁.正常) {
        如果 (丁.错误 == 4) { 校验 = 校验 + 8; }
    }
    // ⑤ 取反否则块=值分支
    结果<整32, 整32> 戊 = 正常(5);
    如果 (!戊.正常) {
        校验 = 校验 + 0;
    } 否则 {
        如果 (戊.值 == 5) { 校验 = 校验 + 16; }
    }
    // ⑥ 可选取反否则块
    可选<整32> 己 = 某些(6);
    如果 (!己.有值) {
        校验 = 校验 + 0;
    } 否则 {
        如果 (己.值 == 6) { 校验 = 校验 + 32; }
    }
    // ⑦ 短路传导（574-a）：左=检查形态 -> 右侧与真块可取 .值
    结果<整32, 整32> 庚 = 正常(7);
    如果 (庚.正常 && 庚.值 == 7) {
        校验 = 校验 + 64;
    }
    // ⑧ 短路取反（574-a 实录形态）
    结果<整32, 整32> 辛 = 错误(8);
    如果 (!辛.正常 && 辛.错误 == 8) {
        校验 = 校验 + 128;
    }
    // ⑨ 真块内嵌套裸块继承标记
    结果<整32, 整32> 壬 = 正常(9);
    如果 (壬.正常) {
        {
            如果 (壬.值 == 9) { 校验 = 校验 + 256; }
        }
    }
    // ⑩ 嵌套如果：内层条件用外层已查值（263 丁.值 形态）
    可选<整32> 癸 = 某些(10);
    如果 (癸.有值) {
        如果 (癸.值 == 10) { 校验 = 校验 + 512; }
    }
    // ⑪ 选择体中取 .值（真块语境内·丙案双查根治锚）
    结果<整32, 整32> 子 = 正常(11);
    整32 路标 = 1;
    如果 (子.正常) {
        选择 (路标) {
            情况 1: {
                如果 (子.值 == 11) { 校验 = 校验 + 1024; }
            }
        }
    }
    // ⑫ 否则链嵌套如果支取 .错误（宿主对嵌套否则如果亦打错误标）
    结果<整32, 整32> 丑 = 错误(12);
    如果 (丑.正常) {
        校验 = 校验 + 0;
    } 否则 如果 (丑.错误 == 12) {
        校验 = 校验 + 2048;
    }
    // ⑬ 遮蔽声明 kill 后重查再取（592 正向版）
    结果<整32, 整32> 寅 = 正常(13);
    如果 (寅.正常) {
        结果<整32, 整32> 寅 = 正常(14);
        如果 (寅.正常) {
            如果 (寅.值 == 14) { 校验 = 校验 + 4096; }
        }
    }
    // ⑭ 可选转发声明位（263 ⑦形态简化）
    可选<整32> 卯 = 某些(15);
    可选<整32> 辰 = 卯;
    如果 (辰.有值) {
        如果 (辰.值 == 15) { 校验 = 校验 + 8192; }
    }
    // ⑮ 嵌套如果新变量内层自用
    结果<整32, 整32> 巳 = 正常(16);
    如果 (巳.正常) {
        结果<整32, 整32> 午 = 错误(17);
        如果 (!午.正常) {
            如果 (午.错误 == 17) { 校验 = 校验 + 16384; }
        }
    }
    返回 校验;
}
