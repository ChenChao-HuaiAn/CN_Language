// Task 2.5 字符串系统 E2E 测试
// 覆盖：普通/原始/多行/原始多行字符串字面量、字符串变量、字符* 变量、
//       + 连接、字符串↔字符* 转换、字符串 API（长度/比较/查找/复制）、打印行多参数
函数 主() -> 整32 {
    // 1. 普通字符串与转义
    打印("你好")                          // 你好
    打印("带制表\t符")                     // 带制表	符（\t 转义为制表符）

    // 2. 原始字符串（反斜杠不转义，所见即所得）
    打印(原始"路径\dir\file")              // 路径\dir\file（\d 不转义）

    // 3. 多行字符串（内部仍处理 \n \t 转义）
    打印(多行"""第一行\n第二行""")          // 输出两行：第一行 / 第二行

    // 4. 原始多行组合（完全原始，\n 不转义）
    打印(原始多行"""A\nB""")               // A\nB（字面反斜杠 n）

    // 5. 字符串变量声明
    字符串 s = "你好"
    打印(s)                              // 你好

    // 6. 字符* 变量声明（字符串字面量 -> 字符*）
    字符* p = "世界"
    打印(p)                              // 世界

    // 7. 字符串 + 连接
    打印(s + p)                          // 你好世界
    打印("连接" + "字符串")                // 连接字符串

    // 8. 字符串 ↔ 字符* 隐式转换（双向）
    字符串 s2 = p                          // 字符* -> 字符串
    打印(s2)                             // 世界
    字符* p2 = s                           // 字符串 -> 字符*
    打印(p2)                             // 你好

    // 9. 字符串 API：长度（UTF-8 字节数，同 C strlen）
    打印行整数(字符串长度("hello"))          // 5
    打印行整数(字符串长度(s))                // 6（你=3字节 + 好=3字节）

    // 10. 字符串比较（相等返回真，否则假）
    如果 (字符串比较("abc", "abc")) {
        打印("比较相等: 真")
    } 否则 {
        打印("比较相等: 假")
    }
    如果 (字符串比较("abc", "abd")) {
        打印("比较不等: 真")
    } 否则 {
        打印("比较不等: 假")
    }

    // 11. 字符串查找（子串位置，-1 表示未找到）
    打印行整数(字符串查找("hello world", "world"))  // 6
    打印行整数(字符串查找("hello", "xyz"))           // -1

    // 12. 字符串复制（深拷贝）
    字符串 cp = 字符串复制("副本")
    打印(cp)                             // 副本

    // 13. 打印行多参数（格式化为一行输出）
    打印("值:", 42)                       // 值:42
    打印("浮点:", 3.5)                    // 浮点:3.500000
    打印(s, "与", p)                      // 你好与世界

    返回 0
}
