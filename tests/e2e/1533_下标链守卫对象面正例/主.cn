// E2E 1533_下标链守卫对象面正例（#1598·2026-10-25·双编译对照锁用例）：
//   结果/可选 成员访问守卫（plans/001 §5.4 规则3）的**对象面**验收——守卫对象
//   从「标识符」扩至下标/成员链/混合链后，守卫后访问两侧同放行：
//   ① 可选数组 组[0].有值 → 组[0].值 ② && 链右操作数 ③ !X.有值 || X.值
//   ④ 多守卫链 ⑤ 成员链 乙.字段 ⑥ 下标+成员 表[0].字段 ⑦ 深层混合链
//   深[0].被.字段 ⑧ 结果数组 .正常→.值 / 否则 .错误（含未正常分支 .错误）
//   ⑨ 730 延续：取反守卫真支恒返回 → if 之后 .值 可访问（结果/可选两族）
//   ⑩ 指针成员链（不安全函数）：指针.字段.有值 → 指针.字段.值。
//   修复前 v2 守卫检查点只认标识符对象=链形态未守卫放行（宿主拒）且守卫后
//   访问也不打标（两侧判据分裂）；本用例锁「宿主 objectVarName 链键 ≡ v2
//   对象路径键」同构。
结构体 内盒 {
    可选<整32> 字段;
}
结构体 外盒 {
    内盒 被;
}
函数 延续结果() -> 整32 {
    结果<整32, 整32>[1] 组;
    组[0] = 正常(11);
    如果 (!组[0].正常) { 返回 1; }
    打印(组[0].值);
    返回 0;
}
函数 延续可选() -> 整32 {
    可选<整32>[1] 组;
    组[0] = 某些(12);
    如果 (!组[0].有值) { 返回 1; }
    打印(组[0].值);
    返回 0;
}
不安全 函数 指针链() -> 整32 {
    内盒 乙;
    可选<整32> 载荷 = 某些(13);
    乙.字段 = 载荷;
    内盒* 指针 = &乙;
    如果 (指针.字段.有值) { 打印(指针.字段.值); }
    返回 0;
}
函数 主() -> 整32 {
    可选<整32>[2] 组;
    组[0] = 某些(5);
    组[1] = 某些(6);
    如果 (组[0].有值) { 打印(组[0].值); }
    如果 (组[0].有值 && 组[0].值 > 0) { 打印("与链"); }
    如果 (!组[0].有值 || 组[0].值 > 0) { 打印("或反"); }
    如果 (组[0].有值 && 组[1].有值 && 组[0].值 + 组[1].值 > 0) { 打印("多守卫"); }
    可选<整32> 载荷 = 某些(7);
    内盒 乙;
    乙.字段 = 载荷;
    如果 (乙.字段.有值) { 打印(乙.字段.值); }
    内盒[2] 表;
    表[0].字段 = 载荷;
    如果 (表[0].字段.有值) { 打印(表[0].字段.值); }
    外盒[2] 深;
    深[0].被.字段 = 载荷;
    如果 (深[0].被.字段.有值) { 打印(深[0].被.字段.值); }
    结果<整32, 整32>[2] 结组;
    结组[0] = 正常(9);
    结组[1] = 错误(3);
    如果 (结组[0].正常) { 打印(结组[0].值); } 否则 { 打印(结组[0].错误); }
    如果 (结组[1].正常) { 打印(结组[1].值); } 否则 { 打印(结组[1].错误); }
    如果 (延续结果() != 0) { 返回 1; }
    如果 (延续可选() != 0) { 返回 1; }
    如果 (指针链() != 0) { 返回 1; }
    返回 0;
}
