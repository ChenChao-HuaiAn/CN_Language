// E2E 1008（2026-10-16·任务 #759·P2）：枚举成员进制字面量值双编译分叉根治——
//   0x10 原 v2「数字文本转数值」逐字符十进制累加（'x' 被静默跳过）得 10
//   （宿主 16）/ 0b101 得 101（宿主 5）。修后 v2 与宿主 parseEnumMemberValue
//   逐形态对齐（001 §4.3：十进制/0x/0b/0o 前缀 + L/UL 类类型后缀·无下划线）。
// 锁定：三类进制 × 大小写前缀（0X/0B/0O）× 十六进制字母大小写 × 类型后缀
//   （L/U/UL/u）× 负号形态 × 进制成员后自动递增 × 前导零十进制 × 边界/超界
//   （整64 最大值承接；超 2^63-1 宿主 stoll out_of_range 静默 0——v2 同口径）。
// 双编译对照：宿主+v2p 同源同测——退出码 0 + stdout 逐行全等。
枚举 十六 {
    甲 = 0x10,      // 16（原分叉：v2 得 10）
    乙 = 0xff,      // 255（小写十六进制字母）
    丙 = 0XFF,      // 255（大写前缀 0X）
    丁 = 0xAbCd,    // 43981（字母大小写混排）
}
枚举 二进 {
    甲 = 0b101,     // 5（原分叉：v2 得 101）
    乙 = 0B1111,    // 15（大写前缀 0B）
    丙,             // 16（进制成员后自动递增 = 15+1）
}
枚举 八进 {
    甲 = 0o17,      // 15
    乙 = 0O777,     // 511（大写前缀 0O）
}
枚举 后缀 {
    甲 = 0x10L,     // 16（L 后缀）
    乙 = 0x10UL,    // 16（U/L 组合后缀）
    丙 = 0b101u,    // 5（小写 u 后缀）
    丁 = 0o17UL,    // 15（八进制 + 组合后缀）
    戊 = 123L,      // 123（十进制后缀对照面）
}
枚举 前导零 { 甲 = 010 }        // 10（十进制前导零·非八进制）
枚举 负号 {
    甲 = -0x10,     // -16
    乙 = -0b101,    // -5
    丙 = -0o17,     // -15
}
枚举 界 {
    甲 = 0x7FFFFFFFFFFFFFFF,    // 9223372036854775807（整64 最大·域内承接）
    乙 = 0x8000000000000000,    // 0（stoll 正溢出静默 0·宿主口径零分叉）
    丙 = 0xFFFFFFFFFFFFFFFF,    // 0（stoll 正溢出静默 0）
    丁 = 12345678901234567890,  // 0（十进制 20 位·宿主同界归零）
}
函数 主() -> 整32 {
    打印(十六.甲); 打印(十六.乙); 打印(十六.丙); 打印(十六.丁);
    打印(二进.甲); 打印(二进.乙); 打印(二进.丙);
    打印(八进.甲); 打印(八进.乙);
    打印(后缀.甲); 打印(后缀.乙); 打印(后缀.丙); 打印(后缀.丁); 打印(后缀.戊);
    打印(前导零.甲);
    打印(负号.甲); 打印(负号.乙); 打印(负号.丙);
    打印(界.甲); 打印(界.乙); 打印(界.丙); 打印(界.丁);
    返回 0;
}
