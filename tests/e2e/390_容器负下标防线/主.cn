// 390：容器负下标防线（267-a T17+T18 根治锚定）——
//   向量四操作（读取/删除/设置/插入）负值显式拒绝=错误(越界=2)；
//   合法面（尾插/读取/设置/删除/插入）零回归。
导入 容器::向量;

函数 主() -> 整32 {
    向量<整32> v = 向量<整32>();
    结果<空类型, 整32> 追加11 = v.追加(11);
    如果 追加11.正常 {
        打印(0);
    } 否则 {
        打印(追加11.错误);
    }
    结果<空类型, 整32> 追加22 = v.追加(22);
    如果 追加22.正常 {
        打印(0);
    } 否则 {
        打印(追加22.错误);
    }
    // ---- 负下标四操作：全部命中越界错误码 2（打印 2）----
    结果<整32, 整32> 负读 = v.读取(0 - 1);
    如果 负读.正常 {
        打印(负读.值);
    } 否则 {
        打印(负读.错误);
    }
    结果<空类型, 整32> 负删 = v.删除(0 - 1);
    如果 负删.正常 {
        打印(0);
    } 否则 {
        打印(负删.错误);
    }
    // ---- 合法面零回归：负操作被拒后容器完好 ----
    结果<整32, 整32> 读0 = v.读取(0);
    如果 读0.正常 {
        打印(读0.值);
    } 否则 {
        打印(读0.错误);
    }
    结果<整32, 整32> 读1 = v.读取(1);
    如果 读1.正常 {
        打印(读1.值);
    } 否则 {
        打印(读1.错误);
    }
    结果<空类型, 整32> 插1 = v.插入(1, 15);
    如果 插1.正常 {
        打印(0);
    } 否则 {
        打印(插1.错误);
    }
    结果<整32, 整32> 读15 = v.读取(1);
    如果 读15.正常 {
        打印(读15.值);
    } 否则 {
        打印(读15.错误);
    }
    结果<空类型, 整32> 设16 = v.设置(1, 16);
    如果 设16.正常 {
        打印(0);
    } 否则 {
        打印(设16.错误);
    }
    结果<整32, 整32> 读16 = v.读取(1);
    如果 读16.正常 {
        打印(读16.值);
    } 否则 {
        打印(读16.错误);
    }
    结果<空类型, 整32> 删1 = v.删除(1);
    如果 删1.正常 {
        打印(0);
    } 否则 {
        打印(删1.错误);
    }
    结果<整32, 整32> 读尾 = v.读取(1);
    如果 读尾.正常 {
        打印(读尾.值);
    } 否则 {
        打印(读尾.错误);
    }
    打印(v.大小());
    返回 0;
}
