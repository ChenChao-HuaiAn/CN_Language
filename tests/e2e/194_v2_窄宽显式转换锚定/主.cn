// E2E 194_v2：窄宽（正8/正16）显式转换→64 位目标 v2 闭环（2026-09-10 第五十五轮
//   观察项②锚定）：与宿主 194 同源。正8/正16 变量经 类型码() 归一登记 T_整64，
//   方案甲源分派（生成表达式求值.cn）归入 T_正64 64 位直拷；结构体字段层经
//   类型宽度码() T_整8 窄宽读回（1 字节布局+发射层 movzx/uxtb 分支=活代码）。
//   九形态校验和（rc=255=511%256）：变量显式转换五形态（小8→200 +1 / 满8→255
//   +2 / 小16→60000 +4 / 满16→65535 +8 / 正64(满16) +16）+ 字段面四形态
//   （字段读+1 / 指针解引用+2 / 传参解引用+4 / 宽字段完好+8）——
//   返回 累计 + 累计2*32，全对=31+15*32=511→POSIX 退出码 255。
结构体 包 { 正8 窄; 整64 宽; }
函数 读窄(正8* q) -> 整32 {
    返回 *q;
}
函数 主() -> 整32 {
    正8 小8 = 200;
    正16 小16 = 60000;
    正8 满8 = 255;
    正16 满16 = 65535;
    整32 累计 = 0;
    如果 (整64(小8) == 200) { 累计 = 累计 + 1; }
    如果 (整64(满8) == 255) { 累计 = 累计 + 2; }
    如果 (整64(小16) == 60000) { 累计 = 累计 + 4; }
    如果 (整64(满16) == 65535) { 累计 = 累计 + 8; }
    如果 (正64(满16) == 65535) { 累计 = 累计 + 16; }
    包 p;
    正8 窄值 = 200;
    p.窄 = 窄值;
    p.宽 = 12345;
    整32 累计2 = 0;
    如果 (整64(p.窄) == 200) { 累计2 = 累计2 + 1; }
    正8* q = &p.窄;
    如果 (整64(*q) == 200) { 累计2 = 累计2 + 2; }
    如果 (读窄(&p.窄) == 200) { 累计2 = 累计2 + 4; }
    如果 (p.宽 == 12345) { 累计2 = 累计2 + 8; }
    返回 累计 + 累计2 * 32;
}
