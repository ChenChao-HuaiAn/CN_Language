// E2E 934（2026-10-14·#728x 根治锁面·双编译对照）：无拷贝构造用户类**字段**赋值
//   值语义锁——类字段=句柄槽（8 字节指针槽），正确语义=「NewObject + 源本体解句柄
//   + 结构体整体拷贝（rep movsb）+ 新壳句柄写槽」（宿主 728x 修后同款=v2 生成语句
//   赋值 543-d 三发射点：类赋值通道 724/836-a 层② 288/837-a 字段位）。
//   缺陷史：宿主原对无拷贝构造类字段落 emitStructCopyWithFields 按结构体值语义把
//   源对象**内容**整体拷进句柄槽（槽变垃圾内容值+写穿后继字段→读回解引用崩
//   C0000005·探针 fault=0x900000007={a=7,b=9} 内容实锤）；v2 同位原恒发拷贝构造
//   调用=悬空外部 LNK2019。两侧修后=字段独立副本（值语义）·退出码=四形态折校验和
//   15（①1 ②2 ③4 ④8）——任一形态字段槽垃圾/写穿/共享句柄→校验位丢失→对照失败。
//   注：有析构类按值拷贝须显式拷贝构造=语义层强制（宿主 class_resolver 216·
//   2026-08-25 方案A），本用例全形态无析构类（语义层放行面=本缺陷根治面）。
类 芯8 {
公开:
    整32 甲;
    整32 乙;
}

类 芯16 {
公开:
    整32 甲;
    整64 大;
    整32 丙;
}

类 匣8 {
公开:
    整32 前哨;
    芯8 芯;
    整32 后哨;
}

类 匣16 {
公开:
    整32 前哨;
    芯16 芯;
    整32 后哨;
}

函数 主() -> 整32 {
    整32 校验 = 0;
    // ① 基本形态：字段=局部（值拷贝+哨兵完好·槽不再被内容覆盖）
    芯8 局部甲;
    局部甲.甲 = 7;
    局部甲.乙 = 9;
    匣8 匣一;
    匣一.前哨 = 1;
    匣一.后哨 = 2;
    匣一.芯 = 局部甲;
    如果 (匣一.芯.甲 == 7 && 匣一.芯.乙 == 9 &&
          匣一.前哨 == 1 && 匣一.后哨 == 2) { 校验 = 校验 + 1; }
    // ② 深宽类（16 字节>槽宽）：写穿面+源独立性（改源不影响字段副本）
    芯16 局部乙;
    局部乙.甲 = 11;
    局部乙.大 = 99;
    局部乙.丙 = 13;
    匣16 匣二;
    匣二.前哨 = 3;
    匣二.后哨 = 4;
    匣二.芯 = 局部乙;
    局部乙.甲 = 77;
    如果 (匣二.芯.甲 == 11 && 匣二.芯.大 == 99 && 匣二.芯.丙 == 13 &&
          匣二.前哨 == 3 && 匣二.后哨 == 4) { 校验 = 校验 + 2; }
    // ③ 二次赋值覆盖（句柄槽重写·旧壳释放不崩）
    芯16 局部丙;
    局部丙.甲 = 22;
    局部丙.大 = 88;
    局部丙.丙 = 44;
    匣二.芯 = 局部丙;
    如果 (匣二.芯.甲 == 22 && 匣二.芯.大 == 88 && 匣二.芯.丙 == 44 &&
          匣二.前哨 == 3 && 匣二.后哨 == 4) { 校验 = 校验 + 4; }
    // ④ 成员链源（源句柄槽解一层·值语义独立副本）
    匣8 匣三;
    匣三.前哨 = 5;
    匣三.后哨 = 6;
    匣三.芯 = 匣一.芯;
    局部甲.甲 = 55;
    如果 (匣三.芯.甲 == 7 && 匣三.芯.乙 == 9 &&
          匣三.前哨 == 5 && 匣三.后哨 == 6) { 校验 = 校验 + 8; }
    打印("934 校验和: ", 校验);
    返回 校验;
}
