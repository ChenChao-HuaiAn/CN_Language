// E2E 1433（2026-10-20·任务 #1185 负例·1020 采样轮）：移位左操作数词法白名单
//   外六形态常量移位超宽编译期拒——v2 折叠子树类型宽474 词法形态白名单（整数字面量/
//   标识符/负号/位非/二元算术位运算五形态）外形态修前左宽 0 整条跳过放行（v2 rc=0），
//   宿主 checkShiftConstWidth 按语义类型全形态可判（错误码 8 编译期拒）=实测放行
//   分叉（CN-Smith 20261019+20261020 两轮连中三元左操作数同一样本）。六形态：
//   ①三元 ②函数调用 ③下标 ④成员 ⑤方法调用 ⑥算术嵌成员。
// 修=v2 左宽推导主路径切 表达式类型ID（语义期表达式类型权威推导·宿主
//   visitBinaryExpr checkExpr 递归产物 leftType 同位）——成员/二元专用推导、
//   调用/下标/三元经 检查表达式 精确推导，六族全形态闭合；词法白名单（636）/
//   窗口通道（502）降格语义 miss 兜底。六形态双侧同拒（移位量 33 ≥ 整32 位宽）。
//   域内合法面与词法白名单五形态既有锚=852/853/856/857/940/941/1041/1042。
结构体 盒 {
    整32 值;
}

类 箱 {
公开:
    整32 存货;
    函数 取值() -> 整32 { 返回 存货; }
}

函数 取值() -> 整32 {
    返回 7;
}

函数 主() -> 整32 {
    整32 甲 = 3;
    整32 乙 = 5;
    盒 盒一;
    盒一.值 = 6;
    箱 箱一;
    箱一.存货 = 8;
    整32[4] 数组;
    数组[0] = 9;
    整32 丙 = (甲 > 乙 ? 甲 : 乙) >> 33;   // ①三元左操作数·33 ≥ 整32 位宽 → 编译期硬错误
    打印(丙);
    整32 丁 = 取值() >> 33;                // ②函数调用左操作数 → 同拒
    打印(丁);
    整32 戊 = 数组[0] >> 33;               // ③下标左操作数 → 同拒
    打印(戊);
    整32 己 = 盒一.值 >> 33;               // ④成员左操作数 → 同拒
    打印(己);
    整32 庚 = 箱一.取值() >> 33;           // ⑤方法调用左操作数 → 同拒
    打印(庚);
    整32 辛 = (盒一.值 + 1) >> 33;         // ⑥算术嵌成员左操作数 → 同拒
    打印(辛);
    返回 0;
}
