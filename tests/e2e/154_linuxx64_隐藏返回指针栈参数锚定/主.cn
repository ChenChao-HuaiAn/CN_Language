// E2E 154（plans/017 缺陷根治回归锚定）：linux-x86_64 后端 emitParamSetup
// 被调方栈参数锚定基——needHiddenRet（返回结构体）时 prologue 多 push rbx
// （保存隐藏返回指针于 [rbp+8]），真实栈参数自 [rbp+24] 起；旧实现恒用
// [rbp+16] 把「返回地址」当第 7 参数读（v2p 自举编译器「建IR指令」实测：
// 7 参+返回结构体，第 6 参「类型」被返回地址 0x43EAB6 污染、第 7 参错位
// 承接第 6 参值——IR 全链数据损坏，产物 asm 无法汇编）。
// 修复（2026-09-06）：锚定基 = 16 + 8*paramOffset（arm64 侧同构处理
//   =16+16*needHiddenRet，win 无 push rbx 锚恒 48 不受影响）。
// 本用例修复前行为：第 7/8 参数读到返回地址/错位值，断言失败。

结构体 对 {
    整64 值;
    整64 号;
}

// 形态一：返回结构体（needHiddenRet=true → push rbx）+ 8 个整型参数——
//   第 7（g）/8（h）参数走栈：修复前 g 读到返回地址（巨大负值特征）、
//   h 读到 g 的值
函数 建对(整64 a, 整64 b, 整64 c, 整64 d, 整64 e, 整64 f, 整64 g, 整64 h) -> 对 {
    对 r;
    r.值 = a + b * 10 + c * 100 + d * 1000 + e * 10000 + f * 100000 + g * 1000000 + h * 10000000;
    r.号 = h;
    返回 r;
}

// 形态二：无结构体返回（锚 16 恒正确）对照——确保修复未伤常规路径
函数 平凡和(整64 a, 整64 b, 整64 c, 整64 d, 整64 e, 整64 f, 整64 g, 整64 h) -> 整64 {
    返回 a + b * 10 + c * 100 + d * 1000 + e * 10000 + f * 100000 + g * 1000000 + h * 10000000;
}

函数 主() -> 整32 {
    对 p = 建对(1, 2, 3, 4, 5, 6, 7, 8);
    // 1+20+300+4000+50000+600000+7000000+80000000 = 87654321；号=8
    打印(p.值);
    打印(p.号);
    // 平凡路径对照：87654321
    打印(平凡和(1, 2, 3, 4, 5, 6, 7, 8));
    返回 0;
}
