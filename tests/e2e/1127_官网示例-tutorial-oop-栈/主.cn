// 官网文档示例 · tutorial-oop.html · 第一个类（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
类 计数器 {
私有:
    整64 值槽;              // 私有字段：类外不可访问
公开:
    函数 计数器() {         // 构造函数：与类同名
        值槽 = 0;
    }

    函数 自增() -> 空类型 {
        值槽 = 值槽 + 1;
    }

    函数 读值() -> 整64 {
        返回 值槽;
    }
}

函数 主() -> 整32 {
    计数器 c = 计数器();
    c.自增();
    c.自增();
    c.自增();
    打印(c.读值());       // 3
    返回 0;
}