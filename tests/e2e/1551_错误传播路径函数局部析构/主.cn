// E2E 1551（#1174 根治锁用例·2026-10-26）：错误传播 `?` 失败路径的**函数局部
//   析构**——原 err 块写 retbuf 后直 IR_返回（跳过 发射容器析构/发射字符串释放/
//   发射数组串释放全部）=函数内已构造的类局部在错误传播时泄漏（安全目标②
//   泄漏零容忍·e05/e07 探针 v2 缺错误路径的 D2）。
//   修复=函数级统一错误出口（宿主 C++ 统一出口同构）：err 块错误码写帧上
//   专有槽+跳错误出口块；出口块由函数收尾发射 LIFO 出口释放三调+读槽构造
//   retbuf+IR_返回；释放目标=**增量镜像名单**（名单追加点同步·曾见全量·
//   不受块级基线回滚影响）。
// 断言口径：构造/析构/传播序逐字节——B(主起) A(r2构造) A(r1构造) D(r1析构·
//   层2 错误出口) D(r2析构·层1 错误出口) C(主续) 7(错误码传播)。双侧同值。
导入 IO;

类 资源 {
公开:
    函数 资源() { 打印("A"); }
    不安全 函数 ~资源() { 打印("D"); }
}

函数 失败源() -> 结果<整32, 整32> {
    返回 错误(7);
}

函数 层2() -> 结果<整32, 整32> {
    资源 r1;
    整32 v = 失败源()?;
    返回 正常(v);
}

函数 层1() -> 结果<整32, 整32> {
    资源 r2;
    整32 v = 层2()?;
    返回 正常(v);
}

函数 主() -> 整32 {
    打印("B");
    结果<整32, 整32> r = 层1();
    打印("C");
    如果 (!r.正常) { 打印(r.错误); } 否则 { 打印(r.值); }
    返回 0;
}
