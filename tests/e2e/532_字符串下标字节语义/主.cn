// T48 裁决甲（2026-09-20 用户批准）：字符串下标语义=按 UTF-8 字节索引，
//   结果类型 整8（带符号字节值）。规范空白关闭：「字符=Unicode 标量值」（类型
//   系统）与下标取字节不再矛盾——完整字符经 字符转字符串（码点路径）构造。
函数 主() -> 整32 {
    字符串 u = "内存好";        // UTF-8: E5 86 85 E5 AD 98 E5 A5 BD（9 字节）
    打印(u[0]);
    打印(u[1]);
    打印(u[2]);
    打印(u[3]);
    打印(u[8]);
    整8 b = u[4];
    打印(b);
    整32 w = u[5];
    打印(w);
    字符 c = u[6];
    打印(c);
    打印(u[7]);
    字符串 v = 字符转字符串(u[6]) + 字符转字符串(u[7]) + 字符转字符串(u[8]);
    打印(v);
    字符串 a = "A";
    打印(a[0]);
    字符 cc = 0x597D;
    字符串 s2 = "" + cc;
    打印(s2);
    返回 0;
}
