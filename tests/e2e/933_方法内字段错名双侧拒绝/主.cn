// 933（#728h·2026-10-14）：方法内字段链根**错名**双侧拒绝锁——
//   真类型 乙 无 b 字段；残留源 甲【有 b】经跨函数局部登记串桶→语法层
//   成员偏移标注=残留类 b 偏移（非负错值·读路径修复 932 的 miss 面）。
//   权威类型化查 乙.b miss 保持语法层值→648 宽度码显形中止（v2）/宿主
//   语义层「类 '乙' 没有成员 'b'」拒绝——双侧等效拒绝（宿主用户错误·
//   v2 内部错误显形中止·诊断文本统一=T63 后案）。防「拒绝→静默」
//   退化（#648 miss 不可静默立法·728h 实证 p18/p19 同形态）。
类 甲 {
公开:
    整64 b;
    函数 甲() { b = 0; }
}
类 乙 {
公开:
    整64 x;
    函数 乙() { x = 0; }
}
不安全 函数 预备() -> 整32 {
    甲 器 = 甲();
    器.b = 9;
    返回 0;
}
类 丙 {
公开:
    乙* 器;
    函数 丙() { 器 = 无; }
    不安全 函数 读错() -> 整64 {
        返回 器.b;
    }
    不安全 函数 写错(整64 v) -> 空类型 {
        器.b = v;
    }
}
不安全 函数 主() -> 整32 {
    乙 对象 = 乙();
    对象.x = 7;
    丙 壳 = 丙();
    壳.器 = &对象;
    打印(壳.读错());
    壳.写错(99);
    返回 0;
}
