// 128_v2_内置函数与字符串拼接（2026-09-03，③ 自举对拍前置第一波）
// 载体动因：③ v2p 编译 v2 自身组件（词法分析.cn 冒烟）实测踩出——v2 编译器
//   语义层无内置函数白名单（驻留/运行时错误/字符串比较/驻留文本/整数转字符串/
//   字符串长度/字符串子串 共 66 诊断）、无字符串拼接 + 的 __cn_str_concat 展开、
//   无 类型大小(类型) 的编译期常量折叠（规格 02-六B）。
//   本用例立项期 主.expected 置空：走宿主通用路径编译运行（宿主级回归，立项即绿）；
//   v2 三层实现落地后注册 v2 闭环（run_e2e.py v2闭环用例们）并填 v2p 自检期望行。
//   退出码=0 全过；11~26 各内置失败专属码（逐项见行内注释）。
// 覆盖（规格依据）：
//   1. 驻留/驻留文本 往返 + 相同内容同 ID（02-类型系统 五、字符串驻留）
//   2. 字符串长度 UTF-8 字节数（字符串扩展.stdlib 实证）
//   3. 字符串子串(串, 起点, 长度)
//   4. 整数转字符串
//   5. 字符串比较 相等/不等（布尔返回）
//   6. 类型大小 编译期折叠：原始类型（整32=4/整64=8/字符串=8）+ 结构体（点=16）（02-六B）
//   7. 字符串拼接 +：字面量+字面量 / 变量+调用结果（词法分析.cn:170 同款形态）/
//      三元链式（01b：编译器隐式 __cn_str_concat）
//   8. 运行时错误 编译期发射形状（不可达分支，运行不触发——断言 依赖，核心.cn）

结构体 点 {
    整64 x
    整64 y
}

函数 主() -> 整32 {
    // 1. 驻留/驻留文本 往返 + 相同内容同 ID
    整64 词ID = 驻留("词")
    整64 词ID2 = 驻留("词")
    如果 (词ID != 词ID2) { 返回 11 }
    字符串 还原 = 驻留文本(词ID)
    如果 (!字符串比较(还原, "词")) { 返回 12 }

    // 2. 字符串长度（UTF-8 字节数；空串=0）
    如果 (字符串长度("你好") != 6) { 返回 13 }
    如果 (字符串长度("") != 0) { 返回 14 }

    // 3. 字符串子串(串, 起点, 长度)
    字符串 子 = 字符串子串("hello", 1, 3)
    如果 (!字符串比较(子, "ell")) { 返回 15 }

    // 4. 整数转字符串
    字符串 文本42 = 整数转字符串(42)
    如果 (!字符串比较(文本42, "42")) { 返回 16 }

    // 5. 字符串比较 相等/不等
    如果 (!字符串比较("a", "a")) { 返回 17 }
    如果 (字符串比较("a", "b")) { 返回 18 }

    // 6. 类型大小 编译期折叠（原始类型 + 结构体）
    如果 (类型大小(整32) != 4) { 返回 19 }
    如果 (类型大小(整64) != 8) { 返回 20 }
    如果 (类型大小(字符串) != 8) { 返回 21 }
    如果 (类型大小(点) != 16) { 返回 22 }

    // 7. 字符串拼接 +（宿主 __cn_str_concat）
    字符串 拼接1 = "ab" + "cd"
    如果 (!字符串比较(拼接1, "abcd")) { 返回 23 }
    字符串 前缀 = "n"
    前缀 = 前缀 + 字符串子串("\t", 0, 1)   // 变量+调用结果（词法分析.cn:170 同款）
    如果 (字符串长度(前缀) != 2) { 返回 24 }
    字符串 链式 = "x" + 前缀 + "y"          // 三元链式
    如果 (字符串长度(链式) != 4) { 返回 25 }

    // 8. 运行时错误 编译期形状（不可达分支，运行不触发）
    如果 (字符串长度("") != 0) {
        运行时错误(4)
        返回 26
    }

    // 9. 打印分派（缺陷①载体 2026-09-03 当场根治：字符串变量根治前错分派
    //    __cn_print_int 打印指针值；混合参数=字符串变量+字面量+整数）
    打印(还原)
    打印(还原, " ", 词ID)

    // 10. 字符串+数值 双向隐式转换（缺陷②载体：根治前数值位模式被当指针传
    //     __cn_str_concat——静默错误代码；宿主 Task 2.9 对齐 from_int/from_bool）
    字符串 带数 = "v" + 7
    如果 (!字符串比较(带数, "v7")) { 返回 27 }
    字符串 带数2 = 8 + "w"
    如果 (!字符串比较(带数2, "8w")) { 返回 28 }
    字符串 带布 = "b" + (字符串长度("ab") == 2)
    如果 (!字符串比较(带布, "b真")) { 返回 29 }

    打印("内置函数与拼接: 全部通过")
    返回 0
}
