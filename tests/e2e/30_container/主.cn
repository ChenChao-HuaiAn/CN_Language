// 容器库 E2E（Task 6.1，规格书 10.3 容器）
// 覆盖：向量（扩容/读取/插入/删除/设置/越界错误码）/
//       链表（追加/头部追加/删除头部/删除尾部/读取头尾）/
//       栈（压入/弹出/栈顶）/ 队列（入队/出队/队首）
// 模块导入：导入 容器.向量 等（泛型类跨模块单态化实例化，29_core 泛型函数跨模块已打通）
// 说明：结果<T,E> 强制检查（规格书07 规则1：结果返回值必须被检查），
//   每个结果调用均赋值并检查 .正常 分支，否则分支取 .错误 错误码
// 打印语义（用户裁决）：打印=println（自动换行）

导入 容器.向量
导入 容器.链表
导入 容器.栈
导入 容器.队列
导入 容器.错误码

函数 主() -> 整32 {
    打印("===== 容器库（Task 6.1）=====")

    // ==================== 1. 向量<T> ====================
    向量<整32> 数据 = 向量<整32>()
    如果 (数据.为空()) {
        打印("向量初始为空: 是")
    } 否则 {
        打印("向量初始为空: 否")
    }

    // 追加 6 个元素（触发扩容 0 -> 4 -> 8）
    结果<空类型, 整32> 追加结果 = 数据.追加(1)
    如果 (追加结果.正常) {
        追加结果 = 数据.追加(2)
        追加结果 = 数据.追加(3)
        追加结果 = 数据.追加(4)
        追加结果 = 数据.追加(5)
        追加结果 = 数据.追加(6)
    } 否则 {
        打印("向量追加失败: ", 追加结果.错误)
    }
    打印("向量大小: ", 数据.大小())
    打印("向量容量: ", 数据.容量())

    // 读取（正常路径）
    结果<整32, 整32> 读取结果 = 数据.读取(0)
    如果 (读取结果.正常) {
        打印("读取[0]: ", 读取结果.值)
    } 否则 {
        打印("读取[0]失败: ", 读取结果.错误)
    }

    // 读取（越界路径：错误码 2）
    读取结果 = 数据.读取(99)
    如果 (读取结果.正常) {
        打印("读取[99]未报错")
    } 否则 {
        打印("读取[99]越界: ", 读取结果.错误)
    }

    // 插入 + 删除 + 设置
    追加结果 = 数据.插入(0, 99)
    如果 (追加结果.正常) {
        打印("插入后[0]: ", 数据.元素(0))
    } 否则 {
        打印("插入失败: ", 追加结果.错误)
    }
    追加结果 = 数据.删除(0)
    如果 (追加结果.正常) {
        打印("删除后[0]: ", 数据.元素(0))
    } 否则 {
        打印("删除失败: ", 追加结果.错误)
    }
    追加结果 = 数据.设置(0, 7)
    如果 (追加结果.正常) {
        打印("设置后[0]: ", 数据.元素(0))
    } 否则 {
        打印("设置失败: ", 追加结果.错误)
    }

    // ==================== 2. 链表<T> ====================
    链表<整32> 列表 = 链表<整32>()
    追加结果 = 列表.追加(10)
    如果 (追加结果.正常) {
        追加结果 = 列表.追加(20)
        追加结果 = 列表.追加(30)
    } 否则 {
        打印("链表追加失败: ", 追加结果.错误)
    }
    打印("链表大小: ", 列表.大小())
    结果<整32, 整32> 头结果 = 列表.读取头部()
    如果 (头结果.正常) {
        打印("链表头: ", 头结果.值)
    } 否则 {
        打印("链表头失败: ", 头结果.错误)
    }
    结果<整32, 整32> 尾结果 = 列表.读取尾部()
    如果 (尾结果.正常) {
        打印("链表尾: ", 尾结果.值)
    } 否则 {
        打印("链表尾失败: ", 尾结果.错误)
    }

    // 头部追加
    追加结果 = 列表.头部追加(5)
    如果 (追加结果.正常) {
        头结果 = 列表.读取头部()
        如果 (头结果.正常) {
            打印("头部追加后链表头: ", 头结果.值)
        } 否则 {
            打印("头部追加后读头失败: ", 头结果.错误)
        }
    } 否则 {
        打印("头部追加失败: ", 追加结果.错误)
    }
    打印("头部追加后链表大小: ", 列表.大小())

    // 删除头部 + 删除尾部
    追加结果 = 列表.删除头部()
    如果 (追加结果.正常) {
        头结果 = 列表.读取头部()
        如果 (头结果.正常) {
            打印("删除头部后链表头: ", 头结果.值)
        } 否则 {
            打印("删除头部后读头失败: ", 头结果.错误)
        }
    } 否则 {
        打印("删除头部失败: ", 追加结果.错误)
    }
    追加结果 = 列表.删除尾部()
    如果 (追加结果.正常) {
        尾结果 = 列表.读取尾部()
        如果 (尾结果.正常) {
            打印("删除尾部后链表尾: ", 尾结果.值)
        } 否则 {
            打印("删除尾部后读尾失败: ", 尾结果.错误)
        }
    } 否则 {
        打印("删除尾部失败: ", 追加结果.错误)
    }

    // ==================== 3. 栈<T> ====================
    栈<整32> 数据栈 = 栈<整32>()
    追加结果 = 数据栈.压入(1)
    如果 (追加结果.正常) {
        追加结果 = 数据栈.压入(2)
        追加结果 = 数据栈.压入(3)
    } 否则 {
        打印("压入失败: ", 追加结果.错误)
    }
    打印("栈大小: ", 数据栈.大小())
    结果<整32, 整32> 栈顶结果 = 数据栈.栈顶()
    如果 (栈顶结果.正常) {
        打印("栈顶: ", 栈顶结果.值)
    } 否则 {
        打印("栈顶失败: ", 栈顶结果.错误)
    }
    结果<整32, 整32> 弹出结果 = 数据栈.弹出()
    如果 (弹出结果.正常) {
        打印("弹出: ", 弹出结果.值)
    } 否则 {
        打印("弹出失败: ", 弹出结果.错误)
    }
    弹出结果 = 数据栈.弹出()
    如果 (弹出结果.正常) {
        打印("再弹出: ", 弹出结果.值)
    } 否则 {
        打印("再弹出失败: ", 弹出结果.错误)
    }
    打印("弹后栈大小: ", 数据栈.大小())

    // ==================== 4. 队列<T> ====================
    队列<整32> 数据队列 = 队列<整32>()
    追加结果 = 数据队列.入队(5)
    如果 (追加结果.正常) {
        追加结果 = 数据队列.入队(6)
        追加结果 = 数据队列.入队(7)
    } 否则 {
        打印("入队失败: ", 追加结果.错误)
    }
    打印("队列大小: ", 数据队列.大小())
    结果<整32, 整32> 队首结果 = 数据队列.队首()
    如果 (队首结果.正常) {
        打印("队首: ", 队首结果.值)
    } 否则 {
        打印("队首失败: ", 队首结果.错误)
    }
    结果<整32, 整32> 出队结果 = 数据队列.出队()
    如果 (出队结果.正常) {
        打印("出队: ", 出队结果.值)
    } 否则 {
        打印("出队失败: ", 出队结果.错误)
    }
    出队结果 = 数据队列.出队()
    如果 (出队结果.正常) {
        打印("再出队: ", 出队结果.值)
    } 否则 {
        打印("再出队失败: ", 出队结果.错误)
    }
    打印("出队后队列大小: ", 数据队列.大小())

    打印("===== 容器库测试完成 =====")
    返回 0
}
