类 计数器 {
公开:
    静态 整32 总数 = 0
    函数 加一() {
        计数器::总数 += 1;
    }
    静态 函数 取值() -> 整32 {
        返回 计数器::总数;
    }
}
函数 主() -> 整32 {
    计数器::总数 = 42;
    打印行(计数器::总数);
    计数器::总数 += 8;
    打印行(计数器::总数);
    打印行(计数器.总数);
    计数器.总数 = 90;
    打印行(计数器::总数);
    计数器::总数++;
    计数器::总数--;
    打印行(计数器::总数);
    计数器::总数 -= 5;
    打印行(计数器::总数);
    计数器 甲;
    甲.加一();
    甲.加一();
    打印行(计数器::总数);
    打印行(计数器.取值());
    返回 0;
}
