// E2E 1480_1479b_无拷贝构造类引用捕获位拷快照（#1321 重落地轮锁面·1321×1367 交叠盲区·初领 1479 号名错位改号）：
//   无拷贝构造无析构纯数据类 + 引用捕获（[&]/[d] 对引用变量值快照）——位拷分支
//   引用源两跳路径（加载引用槽=被引用变量槽地址→再加载=句柄=对象地址本体·
//   与宿主类读路径同构）。根治前形态谱系：深夜方案误套结构体值语义（普通=
//   取地址=拷出句柄位模式=垃圾·1457 实录）+引用源一跳（=被引用变量槽地址
//   当对象地址·潜在分叉）——本用例锁死两跳正确形态。
//   断言：引用源位拷快照读值（34）+快照独立性（源重赋值后闭包读旧值）。
类 数据包 {
公开:
    整32 a;
    整32 b;
}
函数 主() -> 整32 {
    数据包 d;
    d.a = 3;
    d.b = 4;
    数据包& 引 = d;
    变量 f1 = [&]() -> 整32 { 返回 引.a * 10 + 引.b; };
    变量 f2 = [=]() -> 整32 { 返回 引.a * 10 + 引.b; };
    整32 引用捕获值 = f1();
    整32 值快照值 = f2();
    d.a = 9;
    d.b = 0;
    整32 引用读新 = f1();
    整32 快照仍旧 = f2();
    如果 (引用捕获值 != 34) { 返回 141; }
    如果 (值快照值 != 34) { 返回 142; }
    如果 (引用读新 != 90) { 返回 143; }
    如果 (快照仍旧 != 34) { 返回 144; }
    打印(引用捕获值);
    打印(值快照值);
    打印(引用读新);
    打印(快照仍旧);
    返回 0;
}
