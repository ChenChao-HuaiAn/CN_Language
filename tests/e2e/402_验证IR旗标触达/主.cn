// E2E 402（283-a D25 首步·--验证-ir 旗标触达语料）：
//   编译选项.txt 携带 --验证-ir（规格书9.3 B-4）：优化前后各验证一次 CFG
//   结构不变量（块终止/跳转目标/寄存器 def-before-use），失败即中止编译。
//   本用例以多形态语料（分支/循环/嵌套块/多函数/递归形态）触达验证器
//   校验路径——ir_verify.cpp 覆盖率脱离 0%（250-a 覆盖率首跑数据）。
//   编译期无输出=验证通过（fail-fast 通道：验证失败即编译错误无产物）。
函数 折半(整32 v) -> 整32 {
    返回 v / 2;
}

函数 阶乘(整32 n) -> 整32 {
    如果 (n <= 1) { 返回 1; }
    返回 n * 阶乘(n - 1);
}

函数 主() -> 整32 {
    整32 累计 = 0;
    整32 i = 0;
    当 (i < 10) {
        如果 (i % 2 == 0) {
            累计 = 累计 + 折半(i);
        } 否则 {
            累计 = 累计 + i;
        }
        i = i + 1;
    }
    累计 = 累计 + 阶乘(5);
    打印(累计);
    返回 0;
}
