// E2E 257：结构体字段数组全链双编译对照（plans/020 移植纪律 9 第二十五个对照用例）
//   97-a（2026-09-13 第九十七轮 C8）：v2 结构体字段数组支持（宿主已支持=对齐参照）——
//   修复前 v2 语义层「下标对象须为字符串或指针: .分数」误拒（只认字符串字段）。
//   八形态（两侧共有语义面）：
//     ① 字段数组声明 + 元素写 + 读（r.分数[0] = 11 / 读回）
//     ② 字段数组零初始化（未赋值元素恒 0——结构体局部入口零初始化）
//     ③ 循环动态下标（r.分数[i] 求和）
//     ④ 嵌套结构体字段（总表.两行[0].编号——成员链含下标的字段偏移推导）
//     ⑤ 两层数组字段链（t.两行[1].分数[2]——字段数组元素含字段数组）
//     ⑥ 字段数组元素是结构体的标量字段读写（行[2] 两行 的元素字段）
//     ⑦ 字段数组作实参退化（r.分数 传 整32* 形参=元素指针）
//     ⑧ 字段数组与字段标量混排（r.编号 独立字段不受数组字段影响）
//   退出码 = 八形态折校验和 255（①1+②2+③4+④8+⑤16+⑥32+⑦64+⑧128 全对）。
//   宿主侧 == 用例期望值；v2 侧 == 宿主侧实测值（等价性判据）。
结构体 行 {
    整32[3] 分数;
    整32 编号;
}

结构体 总表 {
    行[2] 两行;
}

函数 求和(整32* 表, 整32 个数) -> 整32 {
    整32 和 = 0;
    整32 i = 0;
    当 (i < 个数) {
        和 = 和 + 表[i];
        i++;
    }
    返回 和;
}

// ① 字段数组元素写 + 读
函数 形一() -> 整64 {
    行 r;
    r.分数[0] = 11;
    如果 (r.分数[0] == 11) { 返回 1; }
    返回 0;
}

// ② 字段数组零初始化
函数 形二() -> 整64 {
    行 r;
    r.分数[1] = 22;
    如果 (r.分数[0] == 0 && r.分数[2] == 0) { 返回 2; }
    返回 0;
}

// ③ 循环动态下标
函数 形三() -> 整64 {
    行 r;
    r.分数[0] = 10;
    r.分数[1] = 20;
    r.分数[2] = 30;
    整32 和 = 0;
    整32 i = 0;
    当 (i < 3) {
        和 = 和 + r.分数[i];
        i++;
    }
    如果 (和 == 60) { 返回 4; }
    返回 0;
}

// ④ 嵌套结构体字段（成员链含下标）
函数 形四() -> 整64 {
    总表 t;
    t.两行[0].编号 = 7;
    t.两行[1].编号 = 9;
    如果 (t.两行[0].编号 == 7 && t.两行[1].编号 == 9) { 返回 8; }
    返回 0;
}

// ⑤ 两层数组字段链
函数 形五() -> 整64 {
    总表 t;
    t.两行[1].分数[2] = 99;
    如果 (t.两行[1].分数[2] == 99) { 返回 16; }
    返回 0;
}

// ⑥ 字段数组元素（结构体）字段读写
函数 形六() -> 整64 {
    总表 t;
    t.两行[0].分数[0] = 5;
    t.两行[0].分数[1] = 6;
    如果 (t.两行[0].分数[0] == 5 && t.两行[0].分数[1] == 6) { 返回 32; }
    返回 0;
}

// ⑦ 字段数组作实参退化（元素指针）
函数 形七() -> 整64 {
    行 r;
    r.分数[0] = 1;
    r.分数[1] = 2;
    r.分数[2] = 3;
    如果 (求和(r.分数, 3) == 6) { 返回 64; }
    返回 0;
}

// ⑧ 字段数组与字段标量混排
函数 形八() -> 整64 {
    行 r;
    r.分数[0] = 100;
    r.编号 = 42;
    如果 (r.分数[0] == 100 && r.编号 == 42) { 返回 128; }
    返回 0;
}

函数 主() -> 整32 {
    整64 校验 = 形一() + 形二() + 形三() + 形四() +
                 形五() + 形六() + 形七() + 形八();
    打印("校验和=", 校验);
    返回 整32(校验 % 256);
}
