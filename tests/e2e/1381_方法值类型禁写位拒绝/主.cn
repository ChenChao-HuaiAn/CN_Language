// E2E 1381_方法值类型禁写位拒绝（031 第 1 期·负例 12·dual）：
//   方法值类型禁写位（第一版保守面·plans/031 §二·④⑤ R2/R3）——函数返回
//   类型位 / 类字段位（容器元素位=宿主语义拒·v2 语法拒，诊断旁路不同不并入）。
类 计数器 {
公开:
    整32 基数;
    函数 计数器(整32 b) { 基数 = b; }
    函数 双倍(整32 x) -> 整32 { 返回 基数 + x; }
}
函数 取(计数器 对象) -> 方法值<计数器, 整32(整32)> {
    返回 对象.双倍;
}
类 帮手 {
公开:
    方法值<计数器, 整32(整32)> 回调;
}
函数 主() -> 整32 { 返回 0; }
