// E2E 255：字符字面量全链双编译对照（plans/020 移植纪律 9 第二十三个对照用例）
//   95-a（2026-09-13 第九十五轮）：①v2 侧补字符字面量全链（词法/解析/IR——原
//   词法已扫描但无码点解码、解析原子缺分支）；②**宿主缺陷 H3 根治**（字符字面量
//   三处消费点同款「去引号取首字节」——ir_decl charLiteralCodeText /
//   ir_expr evalDefaultExpr / ir_expr visitCharLiteral：'\n'=92（反斜杠）、
//   '中'=228（UTF-8 首字节），违反规范 01b 三「字符类型为 4 字节 Unicode 标量值」
//   且与 v2 侧静默分叉）。修复=单一归属 charLiteralCodePoint（转义 + \u{XXXX} +
//   UTF-8 多字节全解码），3 处消费点统一。
//   八形态（两侧共有语义面）：
//     ① ASCII 字符（'A'=65）
//     ② UTF-8 多字节（'中'=0x4E2D=20013）
//     ③ 转义序列（'\n'=10 '\t'=9 '\0'=0）
//     ④ Unicode 转义（'\u{4E2D}'=20013，规范 01b 三 Rust 同语法）
//     ⑤ 字符元素数组（字符[3] = { 'x', 'y', 'z' }，元素宽度 4 字节）
//     ⑥ 字符作实参（形参 字符）
//     ⑦ 静态字符初值（静态 字符 全局符 = 'Z'——87-a 静态面 + C3 v2 静态字符语法）
//     ⑧ 字符算术/比较（'A'+1=66、'A'<'B'）
//   退出码 = 八形态折校验和 255（①1+②2+③4+④8+⑤16+⑥32+⑦64+⑧128 全对）。
//   宿主侧 == 用例期望值；v2 侧 == 宿主侧实测值（等价性判据）。

函数 取码(字符 c) -> 整32 {
    返回 整32(c);
}

// ① ASCII 字符
函数 形一() -> 整64 {
    字符 甲 = 'A';
    如果 (整32(甲) == 65) { 返回 1; }
    返回 0;
}

// ② UTF-8 多字节（Unicode 标量值）
函数 形二() -> 整64 {
    字符 中 = '中';
    如果 (整32(中) == 20013) { 返回 2; }
    返回 0;
}

// ③ 转义序列
函数 形三() -> 整64 {
    字符 换 = '\n';
    字符 制 = '\t';
    字符 空 = '\0';
    如果 (整32(换) == 10 && 整32(制) == 9 && 整32(空) == 0) { 返回 4; }
    返回 0;
}

// ④ Unicode 转义
函数 形四() -> 整64 {
    字符 转 = '\u{4E2D}';
    如果 (整32(转) == 20013) { 返回 8; }
    返回 0;
}

// ⑤ 字符元素数组
函数 形五() -> 整64 {
    字符[3] 表 = { 'x', 'y', 'z' };
    如果 (整32(表[0]) == 120 && 整32(表[1]) == 121 && 整32(表[2]) == 122) {
        返回 16;
    }
    返回 0;
}

// ⑥ 字符作实参
函数 形六() -> 整64 {
    如果 (取码('Q') == 81) { 返回 32; }
    返回 0;
}

// ⑦ 静态字符初值
静态 字符 全局符 = 'Z';

函数 形七() -> 整64 {
    如果 (整32(全局符) == 90) { 返回 64; }
    返回 0;
}

// ⑧ 字符算术/比较
函数 形八() -> 整64 {
    字符 甲 = 'A';
    如果 (甲 < 'B' && 整32(甲) + 1 == 66) { 返回 128; }
    返回 0;
}

函数 主() -> 整32 {
    整64 校验 = 形一() + 形二() + 形三() + 形四() +
                 形五() + 形六() + 形七() + 形八();
    打印("校验和=", 校验);
    返回 整32(校验 % 256);
}
