// E2E 1105_类字段数组下标赋值多形态（#1059 dual·双编译对照）：
//   类字段数组（元素=标量/字符串/结构体/类对象）下标赋值全形态——宿主原
//   indexAssignElemType 成员分支只查 findStruct（结构体表）不覆盖类字段
//   → 648 内部错误误伤（v2 放行=宿主单侧拒绝分叉·1045 t6 探针实录）。
//   七形态（两侧共有语义面）：
//     ① 标量元素字面量写读（b.数据[0] = 42）
//     ② 动态下标循环写（b.数据[i] = i*10）
//     ③ 元素复合赋值（b.数据[1] += 5）
//     ④ 字符串数组字段元素写读（b.名[0] = "阿"）
//     ⑤ 结构体数组字段元素整体赋值（b.两行[0] = r·CopyStruct）
//     ⑥ 类数组字段元素 ← 构造调用产物（b.组[0] = 件(5)·923 元素内联接管）
//     ⑦ 类元素字段链式写读（b.组[0].值 = 7·元素对象位成员面）
//   退出码 = 七形态折校验和 255（1+2+4+8+16+32+64 全对）。
//   宿主侧 == 用例期望值；v2 侧 == 宿主侧实测值（等价性判据）。
结构体 行 {
    整32 分数;
    整32 编号;
}

类 件 {
公开:
    整32 值;
    函数 件() { 值 = 0; }
    函数 件(整32 v) { 值 = v; }
}

类 盒 {
公开:
    整32[3] 数据;
    字符串[2] 名;
    行[2] 两行;
    件[2] 组;
    函数 盒() {
        数据[0] = 0;
        数据[1] = 0;
        数据[2] = 0;
    }
}

// ① 标量元素字面量写读
函数 形一() -> 整64 {
    盒 b;
    b.数据[0] = 42;
    b.数据[1] = 43;
    打印("①数据=", b.数据[0] + b.数据[1]);
    如果 (b.数据[0] == 42 && b.数据[1] == 43 && b.数据[2] == 0) { 返回 1; }
    返回 0;
}

// ② 动态下标循环写
函数 形二() -> 整64 {
    盒 b;
    整32 i = 0;
    当 (i < 3) {
        b.数据[i] = i * 10;
        i = i + 1;
    }
    打印("②循环=", b.数据[0] + b.数据[1] + b.数据[2]);
    如果 (b.数据[0] == 0 && b.数据[1] == 10 && b.数据[2] == 20) { 返回 2; }
    返回 0;
}

// ③ 元素复合赋值
函数 形三() -> 整64 {
    盒 b;
    b.数据[1] = 7;
    b.数据[1] += 5;
    打印("③复合=", b.数据[1]);
    如果 (b.数据[1] == 12) { 返回 4; }
    返回 0;
}

// ④ 字符串数组字段元素写读
函数 形四() -> 整64 {
    盒 b;
    b.名[0] = "阿";
    b.名[1] = "乙";
    打印("④名=", b.名[0], b.名[1]);
    如果 (字符串比较(b.名[0], "阿") && 字符串比较(b.名[1], "乙")) { 返回 8; }
    返回 0;
}

// ⑤ 结构体数组字段元素整体赋值
函数 形五() -> 整64 {
    盒 b;
    行 r;
    r.分数 = 11;
    r.编号 = 22;
    b.两行[0] = r;
    打印("⑤行=", b.两行[0].分数 + b.两行[0].编号);
    如果 (b.两行[0].分数 == 11 && b.两行[0].编号 == 22) { 返回 16; }
    返回 0;
}

// ⑥ 类数组字段元素 ← 构造调用产物
函数 形六() -> 整64 {
    盒 b;
    b.组[0] = 件(5);
    b.组[1] = 件(6);
    打印("⑥组=", b.组[0].值 + b.组[1].值);
    如果 (b.组[0].值 == 5 && b.组[1].值 == 6) { 返回 32; }
    返回 0;
}

// ⑦ 类元素字段链式写读
函数 形七() -> 整64 {
    盒 b;
    b.组[0].值 = 7;
    b.组[1].值 = 8;
    打印("⑦链=", b.组[0].值 + b.组[1].值);
    如果 (b.组[0].值 == 7 && b.组[1].值 == 8) { 返回 64; }
    返回 0;
}

函数 主() -> 整32 {
    整64 校验 = 形一() + 形二() + 形三() + 形四() +
                 形五() + 形六() + 形七();
    打印("校验和=", 校验);
    返回 整32(校验 % 256);
}
