// E2E 1337 正测（#1882）：继承链类外静态字段下标读全链——子.基静态数组字段[i]/
//   子.静态字符串字段[i] 落声明类唯一槽（#1445 沿链解析·001 §静态成员解析顺序·
//   1664/1665 邻近面）；字符串字段下标读=字节视图（T48·整8 符号字节值+越界防线）。
//   基槽预置也走类外下标写通道（1710 同族），读写声明类槽同一符号。
类 基 {
公开:
    静态 整64[2] 表;
    静态 字符串 词;
}
类 子 : 基 {
}
函数 主() -> 整32 {
    基.表[0] = 11;
    基.表[1] = 22;
    基.词 = "XYZ";
    // 继承读：子类名访问基类声明槽（沿链解析·同槽非并入槽）
    打印(子.表[0]);
    打印(子.表[1]);
    // 字符串字段下标读：字节视图（'X'=88 'Z'=90）
    打印(整32(子.词[0]));
    打印(整32(子.词[2]));
    // 同槽互证：基名读=子名读
    打印(基.表[1]);
    返回 0;
}
