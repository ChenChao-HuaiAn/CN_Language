// 801_lambda捕获结构体形态3（457 伞批 460/461/462·四形态 dual 锁面）
// 形态3=[&] 引用捕获结构体（457/460/461）+ [=] 类名静态访问 token 误捕
// （461/462-①）+ 指针捕获层附加（462-②）+ 结构体取地址传递（433 相邻面）。
//   ① [&] 引用捕获结构体读写穿：读最新+体内写字段写穿源；
//   ② [&] 结构体取地址传递：体内改源后结构体作按值实参传递=读最新；
//   ③ [p] 值捕获结构体传参：定义处快照（非最新·433/485 回归锚）；
//   ④ [=] 类名.成员/类名::成员 静态访问：类名/静态成员名非变量不捕获
//      （Rust 同形：路径段不捕获·宿主 AST 级收集同排除）——带用户参数
//      锁「误捕→捕获参数膨胀→实参错位」；
//   ⑤ 指针捕获解引用：值捕获快照 64 位指针值（非 32 位截断）+引用捕获
//      读最新（引用通道全宽读·解引用按所指元素宽度）。
结构体 点 {
    整32 x
    整32 y
}
类 计数器 {
公开:
    静态 整32 总数 = 0
}
函数 取x值(点 q) -> 整32 {
    返回 q.x;
}
不安全 函数 主() -> 整32 {
    // ---- ①② 形态3 主面（[&] 结构体）----
    变量 p = 点{ x = 1, y = 2 };
    变量 读x = [&]() -> 整32 { 返回 p.x; };
    打印(读x());                                  // 1
    p.x = 100;
    打印(读x());                                  // 100（读最新）
    变量 写穿 = [&]() -> 整32 { p.y = 7; 返回 0; };
    写穿();
    打印(p.y);                                    // 7（写穿）
    变量 传址 = [&]() -> 整32 { p.x = 5; 返回 取x值(p); };
    打印(传址());                                 // 5（改源+实参读最新）
    // ---- ③ 值捕获结构体传参（快照语义锚）----
    p.x = 100;
    变量 传快照 = [p]() -> 整32 { 返回 取x值(p); };
    p.x = 999;
    打印(传快照());                               // 100（定义处快照）
    // ---- ④ 461/462-① 类名静态访问不误捕 ----
    计数器::总数 = 42;
    变量 读静 = [=](整32 d) -> 整32 { 返回 计数器::总数 + d; };
    打印(读静(5));                                // 47
    变量 读静2 = [=](整32 d) -> 整32 { 返回 计数器.总数 * d; };
    打印(读静2(2));                               // 84
    // ---- ⑤ 462-② 指针捕获解引用 ----
    变量 v = 5;
    整32* pv = &v;
    变量 值捕指针 = [=]() -> 整32 { 返回 *pv; };
    打印(值捕指针());                             // 5（快照指针解引用）
    v = 50;
    变量 引捕指针 = [&]() -> 整32 { 返回 *pv; };
    打印(引捕指针());                             // 50（读最新）
    返回 0;
}
