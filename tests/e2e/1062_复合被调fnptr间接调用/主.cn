// E2E 1062（927·001 §5.8 间接调用被调=任意 fnptr 表达式锁面）：复合被调
//   造句柄()(3,4)——被调=调用表达式结果（返回函数指针的调用再被调）。语义合法
//   （间接调用被调=任意 fnptr 表达式）——修前宿主报内部错误 655
//   （funcPtrTypeOfCallee 全域 miss）/v2 报 [ir2] 成员字段偏移未知（结构体面），
//   双侧均拒但语义合法形态待补签名解析。
//   本用例锚定三面：①标量返回（整32 ABI）②结构体返回（retbuf 预插——签名
//   解析成功的真验收面）③浮点返回（xmm 装载——签名 miss 时按整型装载错值）。
//   期望：7 / 34 / 4.000000（打印 逐行）。
结构体 点 {
    整32 x;
    整32 y;
}

函数 加(整32 a, 整32 b) -> 整32 { 返回 a + b; }
函数 造句柄() -> 整32(*)(整32, 整32) { 返回 加; }

函数 造点(整32 a, 整32 b) -> 点 {
    变量 p = 点{ x = a, y = b };
    返回 p;
}
函数 造点句柄() -> 点(*)(整32, 整32) { 返回 造点; }

函数 折半(浮64 v) -> 浮64 { 返回 v / 2.0; }
函数 造折半() -> 浮64(*)(浮64) { 返回 折半; }

函数 主() -> 整32 {
    打印(造句柄()(3,4));              // 面① 标量复合被调
    变量 r = 造点句柄()(3,4);          // 面② 结构体返回（retbuf）
    打印(r.x * 10 + r.y);
    打印(造折半()(8.0));              // 面③ 浮点返回（xmm）
    返回 0;
}
