类 台账 {
公开:
    静态 整32 总数 = 0;
    静态 函数 扣减() -> 整32 {
        整32 旧 = 台账.总数--;
        返回 旧;
    }
    函数 实例扣() -> 整32 {
        整32 旧 = 台账.总数--;
        返回 旧;
    }
}
函数 主() -> 整32 {
    台账.总数 = 10;
    整32 甲 = 台账.总数--;
    打印行(甲);
    打印行(台账.总数);
    整32 乙 = --台账.总数;
    打印行(乙);
    打印行(台账.总数);
    打印行(台账.扣减());
    打印行(台账.总数);
    台账.总数--;
    打印行(台账.总数);
    台账 丙;
    打印行(丙.实例扣());
    打印行(台账.总数);
    返回 0;
}
