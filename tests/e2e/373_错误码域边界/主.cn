// E2E 373：错误码约定域边界（规格书 附录B）
// 错误码以 整32 表示，附录B 表 1..8 为运行时约定域（1=除零…8=溢出，
// 码值契约往返由 88 锚定、入口退出码契约由 344 锚定）；本用例锚定域边界：
// 表上界 8 与表外值（0、9——用户自由域）经 结果<T,E> 载体精确往返，
// 错误码本身不做域校验（契约约束语义而非取值范围）。
函数 主() -> 整32 {
    结果<整32, 整32> 零码 = 错误(0);
    结果<整32, 整32> 上界码 = 错误(8);
    结果<整32, 整32> 域外码 = 错误(9);
    如果 零码.正常 { 打印("不应正常"); } 否则 { 打印("零码: ", 零码.错误); }
    如果 上界码.正常 { 打印("不应正常"); } 否则 { 打印("上界码: ", 上界码.错误); }
    如果 域外码.正常 { 打印("不应正常"); } 否则 { 打印("域外码: ", 域外码.错误); }
    返回 0;
}
