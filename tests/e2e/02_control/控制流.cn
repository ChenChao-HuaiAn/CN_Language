// 控制流E2E测试：覆盖 如果/否则/当/循环/选择/中断/继续 全组合
// 注意：本文件为中文名（run_e2e.py 用 *.cn glob 遍历，支持中文文件名）
// 入口函数 主 返回 整32，返回0表示成功

函数 主() -> 整32 {
    // ---- 1. 如果/否则 链 ----
    整数 x = 5
    如果 (x > 10) {
        打印("x>10")
    } 否则 如果 (x > 3) {
        打印("3<x<=10")
    } 否则 {
        打印("x<=3")
    }

    // ---- 2. 当循环 + 继续 ----
    整数 i = 0
    当 (i < 6) {
        i++
        如果 (i == 3) {
            继续        // 跳过3
        }
        如果 (i > 5) {
            中断        // 提前退出
        }
        打印行整数(i)
    }

    // ---- 3. 循环（for风格）+ 中断 ----
    循环 (整32 j = 0; j < 10; j++) {
        如果 (j == 4) {
            中断
        }
        打印行整数(j)
    }

    // ---- 4. 选择语句：每个分支显式中断 ----
    整数 v = 2
    选择(v) {
        情况 1:
            打印("一")
            中断
        情况 2:
            打印("二")
            中断
        情况 3:
            打印("三")
            中断
        默认:
            打印("其他")
    }

    // ---- 5. 选择语句：默认缺省（无匹配不输出） ----
    选择(v) {
        情况 10:
            打印("十")
            中断
        情况 20:
            打印("二十")
            中断
    }

    // ---- 6. 选择语句：字符匹配 ----
    字符 c = 'B'
    选择(c) {
        情况 'A':
            打印("A")
            中断
        情况 'B':
            打印("B")
            中断
        默认:
            打印("其他字符")
    }

    // ---- 7. 嵌套选择：switch 内嵌 if/当 ----
    选择(v) {
        情况 2:
            整数 n = 0
            当 (n < 2) {
                打印("嵌套")
                n++
            }
            中断
        默认:
            打印("默认")
    }

    // ---- 8. 选择语句：fallthrough（无中断贯穿到下一情况） ----
    整数 w = 1
    选择(w) {
        情况 1:
            打印("fall1")
            // 无中断：贯穿到 情况 2
        情况 2:
            打印("fall2")
            中断
        默认:
            打印("fall默认")
    }

    返回 0
}
