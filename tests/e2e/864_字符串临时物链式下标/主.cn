// 864（#596）E2E：字符串临时物链式下标全形态（001 §4.5 优先级13 后缀 () [] 同级可链）
// 覆盖：①方法调用返回串临时物+链式下标（859 轮实锤错位面：常量方法带参·
//         树.文本(节)[1] 曾读得 [0] 值——244 callRetType244 分支根治·本用例锁定）
//       ②临时落变量对照（同值·既有正确路径）③非常量方法+字面返回体
//       ④自由函数返回串临时下标 ⑤字面量串就地链式下标（596 实测新缺口：
//         曾落「其他对象」兜底 stride=8/i64 宽读——[0]=打包宽读错值、
//         [1]=越界读镜像地址·静默错值安全红线）⑥下标结果再运算
// 历史：859 探针实锤「链式[1]=195 应 169」（é 串 C3 A9·[1] 读得 [0]）——
//   244（b5cbc5e6）下标对象=CallExpr 分支含「字符串返回=i8 字节视图」顺带根治；
//   596 轮复测 ①~④⑥ 全正确、⑤字面量形态仍宽读错值 → 宿主 StringLiteral
//   对象归一字符串类型（与 244/字符串变量 A-1 口径同构）根治，v2 对照 dual 锁一致。
// 注：不依赖 stdlib JSON（859 原形态载体）——其构造器 this 字段写=594 在飞面，
//   dual 会假红；自含类定义复刻同形态（常量方法+带参+返回串）。

类 盒 {
公开:
    常量 函数 文本(整64 节) -> 字符串 {
        如果 (节 == 0) {
            返回 "AB" + "CDE";
        }
        返回 "XYZ" + "WV";
    }
}

函数 取串() -> 字符串 {
    返回 "ABCDE";
}

不安全 函数 主() -> 整32 {
    盒 b;
    // ① 方法调用返回串临时物+链式下标（859 实锤形态）
    打印(整64(b.文本(0)[0]));
    打印(整64(b.文本(0)[1]));
    打印(整64(b.文本(0)[4]));
    // ② 存变量对照（同值）
    字符串 s = b.文本(0);
    打印(整64(s[0]));
    打印(整64(s[1]));
    打印(整64(s[4]));
    // ③ 非常量参路径+字面返回体（b.文本(1) 返回 "XYZWV"，[1]=Y）
    打印(整64(b.文本(1)[1]));
    // ④ 自由函数返回串临时下标
    打印(整64(取串()[0]));
    打印(整64(取串()[2]));
    // ⑤ 字面量串就地链式下标（596 修复面）
    打印(整64("ABCDE"[0]));
    打印(整64("ABCDE"[2]));
    打印(整64("ABCDE"[4]));
    // ⑥ 下标结果再运算（66+1）
    打印(整64(b.文本(0)[1]) + 1);
    返回 0;
}
