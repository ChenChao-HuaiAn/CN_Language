// Task 2.7 结构体/枚举/联合体 E2E 测试
// 覆盖：结构体定义/实例化/字段读写（.）、-> 指针成员访问、结构体数组、
//       枚举定义（显式赋值/负数/自动递增）、枚举值引用（枚举名.成员）、
//       选择语句 case 使用枚举值、联合体共享内存
// 语法依据（cn-language-spec 05）：结构体字段换行分隔；实例化 类型{ 字段 = 值 }；
//   枚举成员自动递增/显式赋值/负数；联合体字段共享内存

结构体 点 {
    整32 x;
    整32 y;
}

结构体 矩形 {
    点 左上;
    点 右下;
}

枚举 颜色 {
    红,
    绿,
    蓝,
    自定义 = 100
}

枚举 方向 {
    上 = -1,
    中 = 0,
    下 = 1
}

联合体 数值 {
    整32 整数部分;
    浮64 浮点部分;
}

函数 主() -> 整32 {
    // ---- 1. 结构体定义/实例化（默认字段访问 . ）----
    点 p = 点{ x = 10, y = 20 };
    打印("p.x: ");
    打印(p.x);                    // 10
    打印("p.y: ");
    打印(p.y);                    // 20

    // 字段写
    p.x = 30;
    打印("写后p.x: ");
    打印(p.x);                    // 30

    // ---- 2. 指针成员访问（v2.1 统一 .，自动解引用一级） ----
    点* 指针 = &p;
    打印("指针->x: ");
    打印(指针.x);                 // 30（≡ (*指针).x）
    指针.y = 99;
    打印("指针写后y: ");
    打印(p.y);                    // 99

    // ---- 3. 结构体嵌套（字段为另一个结构体）----
    矩形 r = 矩形{ 左上 = 点{ x = 1, y = 2 }, 右下 = 点{ x = 3, y = 4 } };
    打印("嵌套左上.x: ");
    打印(r.左上.x);               // 1
    打印("嵌套右下.y: ");
    打印(r.右下.y);               // 4

    // ---- 4. 结构体数组 ----
    点[3] 点数组;
    点数组[0] = 点{ x = 5, y = 6 };
    点数组[1] = 点{ x = 7, y = 8 };
    点数组[2] = 点{ x = 9, y = 10 };
    打印("数组[1].x: ");
    打印(点数组[1].x);            // 7
    打印("数组[2].y: ");
    打印(点数组[2].y);            // 10

    // ---- 5. 枚举：自动递增（红=0 绿=1 蓝=2）----
    颜色 c = 颜色.绿;
    打印("枚举绿: ");
    打印(c);                      // 1
    打印("枚举蓝: ");
    打印(颜色.蓝);                // 2

    // 显式赋值（自定义 = 100，后续自动递增）
    打印("枚举自定义: ");
    打印(颜色.自定义);            // 100

    // ---- 6. 枚举负数 ----
    方向 d = 方向.上;
    打印("枚举上: ");
    打印(d);                      // -1
    打印("枚举下: ");
    打印(方向.下);                // 1

    // ---- 7. 选择语句 case 使用枚举值 ----
    打印("选择枚举: ");
    选择 (c) {
        情况 颜色.红:
            打印("红色");
            中断;
        情况 颜色.绿:
            打印("绿色");
            中断;
        情况 颜色.蓝:
            打印("蓝色");
            中断;
        默认:
            打印("其他");
    }

    打印("选择负数枚举: ");
    选择 (d) {
        情况 方向.上:
            打印("上");
            中断;
        情况 方向.中:
            打印("中");
            中断;
        情况 方向.下:
            打印("下");
            中断;
        默认:
            打印("其他");
    }

    // ---- 8. 联合体共享内存 ----
    数值 数值联合;
    数值联合.整数部分 = 42;
    打印("联合体整数: ");
    打印(数值联合.整数部分);      // 42（整32 读取，低4字节 = 42）

    数值联合.浮点部分 = 3.5;
    打印("联合体浮点: ");
    打印(数值联合.整数部分);      // 写浮点后整字段被覆盖（共享内存，值不可预期）
    // 注意：整32 与 浮64 共享内存，写浮点会覆盖整字段（3.5 的 IEEE754 低4字节）

    返回 0;
}
