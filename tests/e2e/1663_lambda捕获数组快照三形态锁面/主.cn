// E2E 1663_lambda捕获数组快照三形态锁面（#1408·2026-10-31·dual 双编译对照锁用例）：
//   lambda 捕获数组三形态根治锁面（1023/1027 采样轮 1610174149/1078739731/r=-11/
//   5416 漂移四实录收敛）——数组=聚合值语义（001 §3.5 数组=值聚合）：
//     形态① [ = ] 值捕获数组=定义处**整组深拷快照**（槽=整组副本·与结构体值
//            捕获同协议 433 设施；修前「槽存退化元素指针」=浅共享+槽当本体
//            错位链：读元素=地址低 32 位当值/越槽垃圾）；
//     形态② [&] 引用捕获数组=持源数组地址读穿/写穿（修前双侧把「存地址的
//            槽」当数组本体：宿主读参数槽=垃圾、v2 引用读多解引用段错误）；
//     形态③ 值捕获数组 lambda 经 fnptr 形参调用=快照稳定（修前 ABI 错位：
//            快照 8 字节指针值传多槽聚合参数·三次重编输出漂移野读）。
//   联想面锁：多维数组捕获（元素=子数组递归同构）、捕获后源修改不影响值捕获
//   快照（值语义·E5）、引用捕获元素写穿源（引用语义·E10）。
// 期望手算（逐行）：
//   ①值捕获读首元素=6；②值捕获读第 3 元素=5（快照全组非首 8 字节）；
//   ③引用捕获读首元素=6（读穿源）；④fnptr 经形参=7+100=107；
//   ⑤fnptr 跨三次调用=107 107 107（快照确定性·修前三重编漂移
//   5416/32767/32766 野读实录）；⑥多维 [1][0]=5（16 字节快照·非 0）；
//   ⑦源改后值捕获=6+8=14（快照独立·非 400）；⑧[&] 元素写穿源=60+7+300
//   =367（写穿面时序：⑦ 已改 表[2]=300·写穿改 表[0]=60）。
函数 应用(整32(*取)()) -> 整32 {
    返回 取();
}

函数 主() -> 整32 {
    // ①+② 值捕获：整组快照·任意元素位读对
    整32[3] 表 = {6, 7, 8};
    变量 读首 = [=]() -> 整32 { 返回 表[0]; };
    打印(读首());                     // 6
    整32[4] 表四 = {1, 2, 5, 6};
    变量 读三 = [=]() -> 整32 { 返回 表四[2]; };
    打印(读三());                     // 5
    // ③ 引用捕获：读穿源
    变量 引读 = [&]() -> 整32 { 返回 表[0]; };
    打印(引读());                     // 6
    // ④+⑤ 形态③：值捕获数组+标量 经 fnptr 形参调用·跨调用稳定
    整32 k = 100;
    变量 取 = [=]() -> 整32 { 返回 表[1] + k; };
    打印(应用(取));                   // 107
    打印(应用(取));                   // 107（跨调用快照稳定）
    打印(应用(取));                   // 107
    // ⑥ 多维数组捕获：子数组元素递归同构
    整32[2][2] 矩;
    矩[0][0] = 1;
    矩[0][1] = 2;
    矩[1][0] = 5;
    矩[1][1] = 6;
    变量 读矩 = [=]() -> 整32 { 返回 矩[1][0]; };
    打印(读矩());                     // 5
    // ⑦ 值语义：捕获后源修改不影响快照
    变量 快照读 = [=]() -> 整32 { 返回 表[0] + 表[2]; };
    表[0] = 100;
    表[2] = 300;
    打印(快照读());                   // 14
    // ⑧ 引用语义：元素写穿源
    变量 写穿 = [&]() -> 整32 {
        表[0] = 60;
        返回 表[0] + 表[1] + 表[2];
    };
    打印(写穿());                     // 367（60+7+300·写穿时序见头注⑧）
    返回 0;
}
