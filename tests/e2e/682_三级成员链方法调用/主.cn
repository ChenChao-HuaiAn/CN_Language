// E2E 682_三级成员链方法调用（#363 清偿轮·2026-10-10）：锁三级成员链方法调用
//   的接收者类型推导通道——修复前「局部.指针字段.指针字段.方法」与
//   「this.指针字段.向量字段.方法」两形态发射 mov r11,0; call r11（方法符号
//   解析 0·运行时错误 3 空指针）；根因=exprSrcType/memberObjStructType 的
//   MemberExpr 分支对链上指针字段中间跳（innerType 带星）不剥指针——
//   classFieldType/findStruct 恒 miss → 第三级对象类型断链。修=两消费点
//   剥星（. 左侧指针自动解引用一级·001 立法·与 v2 321/362 同构）。
//   〔面注〕host-only：v2 侧同形态产物段错误（三级成员链方法调用基址/接收者
//   面独立缺陷·挂 #384）——宿主清偿验收本用例；v2 修复后恢复 dual。
导入 容器::向量;
类 内核 {
公开:
    向量<整64> 表;
    函数 放(整64 v) { 结果<空类型, 整32> 追 = 自身.表.追加(v); }
    函数 大小() -> 整64 { 返回 自身.表.大小(); }
}
类 持有 {
公开:
    内核* 内;
    函数 持有() { 内 = 无; }
    函数 挂(内核* q) { 内 = q; }
    // 三级链形态一：this.指针字段.向量字段.方法（立项原形态）
    不安全 函数 存值(整64 v) { 结果<空类型, 整32> 追 = 自身.内.表.追加(v); }
    // 二级链对照（修复前已健康）：this.指针字段.方法
    函数 存值二级(整64 v) { 自身.内.放(v); }
}
类 根 {
公开:
    持有* 子;
    函数 根() { 子 = 无; }
}
不安全 函数 主() -> 整32 {
    // 形态二：局部.指针字段.指针字段.方法
    内核 k = 内核();
    持有 h = 持有();
    h.内 = &k;
    根 r = 根();
    r.子 = &h;
    r.子.内.放(7);
    打印(r.子.内.大小());
    // 形态一复验（方法体内 this 三级）
    h.存值二级(9);
    打印(h.内.大小());
    h.存值(11);
    打印(h.内.大小());
    返回 0;
}
