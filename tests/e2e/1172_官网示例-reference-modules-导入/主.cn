// 官网文档示例 · reference/modules.html · 导入（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
导入 容器::向量;                    // 单符号（公开符号合并→纯名直用）
导入 容器::{链表, 栈, 队列};        // 多符号花括号
导入 数学::平方根;                  // 限定名亦可省（纯名直用）

函数 主() -> 整32 {
    向量<整64> 表 = 向量<整64>();
    结果<空类型, 整32> 加 = 表.追加(9);
    打印(表.大小(), " ", 平方根(4.0));
    返回 0;
}