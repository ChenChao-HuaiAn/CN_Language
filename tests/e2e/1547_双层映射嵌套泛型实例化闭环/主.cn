// E2E 1547（2026-10-25 任务 1615·P2·〔1025采样轮〕双层容器泛型实例化 LNK1120 锁面）：
//   泛型类作泛型实参（映射<整32, 字符串映射<整32>>）——stdlib 双层容器全链：
//   嵌套声明/构造/设置/获取/正常 装箱/作用域析构。
//   v2 缺陷实录（铁证=主树 target/cnsmith_r1025/v2full/g2）：编译产 asm 无诊断
//   但链接 LNK2019×3 → LNK1120 静默 rc≠0——映射$整32$字符串映射$整32$设置
//   参数修饰丢段 / 字符串映射$字符串映射 构造 / 字符串映射~字符串映射 析构
//   （调用侧实例实参切分白名单缺用户泛型类→嵌套实参被平拆成裸基名→调用/
//   定义符号分叉；定义侧=拆段消费一类型 走泛型声明参数序表恒正确）。
//   逐值锚：分=60·合=120（宿主/v2 双侧同源码·零分叉；成对=1547_v2_）。
//   〔rebase 后基线注记〕宿主侧显式 结果<用户泛型类实例> 声明位归一拒（1023 轮
//   g2 铁证宿主全绿→新基线拒=develop 1591/1609 系回归·另案呈报）；v2 面为
//   本案 LNK1120 主锁。
导入 映射集合::映射;
导入 映射集合::字符串映射;
函数 主() -> 整32 {
    映射<整32, 字符串映射<整32>> 双 = 映射<整32, 字符串映射<整32>>();
    字符串映射<整32> 内 = 字符串映射<整32>();
    结果<空类型, 整32> w = 内.设置("分", 60);
    如果 (!w.正常) { 打印("设内败"); }
    w = 内.设置("合", 120);
    如果 (!w.正常) { 打印("设内2败"); }
    w = 双.设置(1, 内);
    如果 (!w.正常) { 打印("设双败"); }
    结果<字符串映射<整32>, 整32> 外 = 双.获取(1);
    如果 (外.正常) {
        字符串映射<整32> 层 = 外.值;
        结果<整32, 整32> 分 = 层.获取("分");
        如果 (分.正常) { 打印(分.值); } 否则 { 打印("缺分"); }
        结果<整32, 整32> 合 = 层.获取("合");
        如果 (合.正常) { 打印(合.值); } 否则 { 打印("缺合"); }
    } 否则 { 打印("缺外"); }
    返回 0;
}
