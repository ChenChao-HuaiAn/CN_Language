// E2E 1718_lambda值捕获容器元素数组深拷独立副本（#1880·dual 双编译对照锁用例）：
//   lambda 值捕获**容器元素数组**（向量<整64>[2]）=定义处元素级深拷（容器元素
//   =拷贝构造独立副本·#1880）——1408 整组位拷=元素壳数据指针共享（浅共享）：
//   源 设置 覆盖写元素缓冲→快照读穿（修复前读 8807·共享数据缓冲实锤）。
//   修复后快照元素=拷贝构造新壳新缓冲，源设置不影响快照（读 4207）。
//   判据设计：设置=覆盖写不触发 realloc——写穿观察稳定（无容量依赖）。
// 期望手算（逐行）：
//   ① 快照读两元素=42*100+7=4207（快照元素壳独立·源设置(0,88) 不影响）；
//   ② 读源=88（源已改·双向独立）。
导入 容器::向量;

函数 主() -> 整32 {
    向量<整64>[2] 组;
    组[0] = 向量<整64>();
    结果<空类型, 整32> 甲 = 组[0].追加(42);
    如果 (!甲.正常) { 返回 40; }
    组[1] = 向量<整64>();
    结果<空类型, 整32> 乙 = 组[1].追加(7);
    如果 (!乙.正常) { 返回 41; }
    变量 读 = [组]() -> 整32 {
        // 元素读=1046 先例形态（数值转换·容器方法返回类型推导既有口径）
        返回 整32(组[0].元素(0)) * 100 + 整32(组[1].元素(0));
    };
    // 浅共享判别写：源覆盖写元素缓冲（设置 不 realloc·写穿共享数据指针）
    结果<空类型, 整32> 丙 = 组[0].设置(0, 88);
    如果 (!丙.正常) { 返回 42; }
    打印(读());              // 4207（修复前浅共享=8807 写穿实锤）
    // 源侧独立读（1046 先例形态·元素读经数值转换——顶层 结果 声明推导差异
    //   面外既有口径）
    打印(整64(组[0].元素(0)));   // 88（源独立）
    返回 0;
}
