// 698_lambda显式捕获值快照（#276 波1·001「lambda 表达式」四形态+spec 04-一D）
// 显式捕获 [x]：值语义=定义处快照——定义后修改外部变量，闭包读旧值（快照
//   第一证）。体内写值捕获变量随 #1881 快照只读立法=编译期拒（负测锁面迁
//   1670·原「体内赋值落副本」放行面退役——快照副本只读·001 §780 快照只读
//   段）；体内写穿改用 [&] 引用捕获（707 锁面）。
函数 主() -> 整32 {
    变量 x = 10;
    变量 取x = [x]() -> 整32 { 返回 x; };
    x = 99;
    打印(取x());                      // 10（快照·非 99）
    返回 0;
}
