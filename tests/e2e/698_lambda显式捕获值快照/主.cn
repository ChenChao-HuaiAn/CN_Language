// 698_lambda显式捕获值快照（#276 波1·001「lambda 表达式」四形态+spec 04-一D）
// 显式捕获 [x]：值语义=定义处快照——定义后修改外部变量，闭包读旧值；
//   体内对捕获名的赋值落副本，不写穿外部（值语义第二证）。
函数 主() -> 整32 {
    变量 x = 10;
    变量 取x = [x]() -> 整32 { 返回 x; };
    x = 99;
    打印(取x());                      // 10（快照·非 99）

    变量 y = 5;
    变量 改y = [y]() -> 整32 {
        y = y + 1;                    // 写捕获副本
        返回 y;
    };
    打印(改y());                      // 6（副本内自增可见）
    打印(y);                          // 5（外部不受副本写影响）
    返回 0;
}
