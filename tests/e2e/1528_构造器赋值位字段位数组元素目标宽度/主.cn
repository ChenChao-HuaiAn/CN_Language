// E2E 1528（2026-10-25 #1588 修复轮·宿主单侧）：**构造器非声明位目标宽度对齐**——
//   1527 双编译对照覆盖声明/实参/返回位；本位覆盖赋值位/结构体字段位/数组元素位/
//   循环体声明位/嵌套构造器/结构体载荷（v2 侧赋值位语境缺失=已另行立项，本用例
//   为宿主单侧正例；宿主修复面=ctorTargetStack_ 目标校准覆盖全部表达式位）。
//   缺陷背景（#1585 审计）：构造器按实参窄类型发射临时合成体，目标位按宽类型
//   CopyStruct → 高字节栈垃圾（可选<整64> 选项 = 某些(7) 实测 -1）。
//   校验和折位（①1 ②2 ③4 ④8 ⑤16 ⑥32 ⑦64 ⑧128）→ 期望打印 校验=255。
结构体 容器 {
    可选<整64> 选;
}

结构体 盒子 {
    整32 号;
}

函数 取选(可选<整64> 参) -> 整64 {
    整64 果 = 0 - 1;
    如果 (参.有值) {
        如果 (参.值 == 7) { 果 = 7; }
    }
    返回 果;
}

函数 造果(布尔 好) -> 结果<整64, 整32> {
    如果 (好) {
        返回 正常(7);
    }
    返回 错误(1);
}

函数 主() -> 整32 {
    整64 校验 = 0;
    // ① 赋值位：某些(整32 字面量) → 可选<整64>（先某些(1) 后某些(7)）
    可选<整64> 甲 = 某些(1);
    甲 = 某些(7);
    整64 甲果 = 0 - 1;
    如果 (甲.有值) {
        如果 (甲.值 == 7) { 甲果 = 7; }
    }
    如果 (甲果 == 7) { 校验 = 校验 + 1; }
    // ② 结构体字段初始化位：字段 可选<整64> = 某些(7)
    容器 乙 = 容器{ 选 = 某些(7) };
    整64 乙果 = 0 - 1;
    如果 (乙.选.有值) {
        如果 (乙.选.值 == 7) { 乙果 = 7; }
    }
    如果 (乙果 == 7) { 校验 = 校验 + 2; }
    // ③ 数组元素初始化位：可选<整64>[2] = { 某些(7), 某些(8) }
    可选<整64>[2] 丙 = { 某些(7), 某些(8) };
    整64 丙果 = 0 - 1;
    如果 (丙[0].有值) {
        如果 (丙[1].有值) {
            如果 (丙[0].值 == 7) {
                如果 (丙[1].值 == 8) { 丙果 = 1; }
            }
        }
    }
    如果 (丙果 == 1) { 校验 = 校验 + 4; }
    // ④ 嵌套构造器：可选<可选<整32>> 内层按载荷推导（不误用外层目标）
    可选<可选<整32>> 丁 = 某些(某些(7));
    整64 丁果 = 0 - 1;
    如果 (丁.有值) {
        可选<整32> 丁内 = 丁.值;
        如果 (丁内.有值) {
            如果 (丁内.值 == 7) { 丁果 = 7; }
        }
    }
    如果 (丁果 == 7) { 校验 = 校验 + 8; }
    // ⑤ 嵌套构造器：结果<结果<整32,整32>,整32> 正常(正常(7))
    结果<结果<整32, 整32>, 整32> 戊 = 正常(正常(7));
    整64 戊果 = 0 - 1;
    如果 (戊.正常) {
        结果<整32, 整32> 戊内 = 戊.值;
        如果 (戊内.正常) {
            如果 (戊内.值 == 7) { 戊果 = 7; }
        }
    }
    如果 (戊果 == 7) { 校验 = 校验 + 16; }
    // ⑥ 结构体载荷：可选<盒子> 某些(盒子{...})（同型结构体 CopyStruct 面）
    可选<盒子> 己 = 某些(盒子{ 号 = 7 });
    整64 己果 = 0 - 1;
    如果 (己.有值) {
        如果 (己.值.号 == 7) { 己果 = 7; }
    }
    如果 (己果 == 7) { 校验 = 校验 + 32; }
    // ⑦ 循环体声明位（重复构造·栈槽复用）与赋值位 结果<整64,整32>
    整64 和 = 0;
    整64 轮 = 0;
    当 (轮 < 3) {
        可选<整64> 每轮 = 某些(7);
        整64 每轮果 = 0 - 1;
        如果 (每轮.有值) {
            如果 (每轮.值 == 7) { 每轮果 = 7; }
        }
        如果 (每轮果 == 7) { 和 = 和 + 1; }
        轮++;
    }
    结果<整64, 整32> 庚 = 正常(1);
    庚 = 正常(7);
    整64 庚果 = 0 - 1;
    如果 (庚.正常) {
        如果 (庚.值 == 7) { 庚果 = 7; }
    }
    如果 (和 == 3 && 庚果 == 7) { 校验 = 校验 + 64; }
    // ⑧ 返回位：正常/错误双路跨函数接收（整64 载荷结果）
    结果<整64, 整32> 辛 = 造果(真);
    结果<整64, 整32> 壬 = 造果(假);
    整64 辛果 = 0 - 1;
    如果 (辛.正常) {
        如果 (辛.值 == 7) { 辛果 = 7; }
    }
    整64 壬果 = 0 - 1;
    如果 (!壬.正常) {
        如果 (壬.错误 == 1) { 壬果 = 1; }
    }
    如果 (辛果 == 7 && 壬果 == 1 && 取选(某些(7)) == 7) { 校验 = 校验 + 128; }
    打印("校验=" + 整数转字符串(校验));
    返回 0;
}
