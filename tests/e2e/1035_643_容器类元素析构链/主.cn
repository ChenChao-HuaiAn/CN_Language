// E2E 1035（2026-10-17 任务643）：容器类元素析构链（v2 句柄模型错位根治）——
//   向量<类>/链表<类> 的元素=含资源类（向量字段/字符串字段）在
//   ①块出口 ②清空 ③删除(单元素) ④删除中间(移位) ⑤循环跳出 ⑥链表清空
//   ⑦字符串字段元素 七形态残留=0（内存::活动分配数差值断言）+
//   内容正确性断言（大小/防假绿）。
//   630 呈报（追加/清空/删除三路径残留 1）+ 643 修复（句柄模型释放通道）
//   两侧同源跑（双编译对照）：宿主与 v2 全 0 等效锁面。
//   校验和折位：①②③④⑤⑥⑦=1/2/4/8/16/32/64——退出码 127=全对。
导入 容器::向量;
导入 容器::链表;

类 货架 {
公开:
    向量<字符串> 记录;
    函数 货架() { 记录 = 向量<字符串>(); }
    函数 ~货架() { }
    不安全 函数 货架(货架& 其他) { 记录 = 其他.记录; }
}

类 珠宝 {
公开:
    字符串 名字;
    函数 珠宝() { 名字 = 字符串复制("未命名"); }
    函数 ~珠宝() { }
    不安全 函数 珠宝(珠宝& 其他) { 名字 = 字符串复制(其他.名字); }
}

函数 形块出口() -> 整64 {
    整64 前 = 内存::活动分配数();
    {
        向量<货架> 表 = 向量<货架>();
        货架 甲;
        结果<空类型, 整32> r = 甲.记录.追加(字符串复制("块出口载荷"));
        结果<空类型, 整32> 加 = 表.追加(甲);
        如果 (表.大小() != 1) { 返回 0; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 1;
}

函数 形清空() -> 整64 {
    整64 前 = 内存::活动分配数();
    {
        向量<货架> 表 = 向量<货架>();
        货架 甲;
        结果<空类型, 整32> r = 甲.记录.追加(字符串复制("清空载荷"));
        结果<空类型, 整32> 加 = 表.追加(甲);
        表.清空();
        如果 (表.大小() != 0) { 返回 0; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 2;
}

函数 形删除() -> 整64 {
    整64 前 = 内存::活动分配数();
    {
        向量<货架> 表 = 向量<货架>();
        货架 甲;
        结果<空类型, 整32> r = 甲.记录.追加(字符串复制("删除载荷"));
        结果<空类型, 整32> 加 = 表.追加(甲);
        结果<空类型, 整32> 删 = 表.删除(0);
        如果 (表.大小() != 0) { 返回 0; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 4;
}

函数 形删除中间() -> 整64 {
    整64 前 = 内存::活动分配数();
    {
        向量<货架> 表 = 向量<货架>();
        货架 甲;
        结果<空类型, 整32> r1 = 甲.记录.追加(字符串复制("中间一"));
        结果<空类型, 整32> 加1 = 表.追加(甲);
        货架 乙;
        结果<空类型, 整32> r2 = 乙.记录.追加(字符串复制("中间二"));
        结果<空类型, 整32> 加2 = 表.追加(乙);
        货架 丙;
        结果<空类型, 整32> r3 = 丙.记录.追加(字符串复制("中间三"));
        结果<空类型, 整32> 加3 = 表.追加(丙);
        结果<空类型, 整32> 删 = 表.删除(1);
        如果 (表.大小() != 2) { 返回 0; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 8;
}

函数 形跳出() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 轮 = 0;
    当 (轮 < 1) {
        {
            向量<货架> 表 = 向量<货架>();
            货架 甲;
            结果<空类型, 整32> r = 甲.记录.追加(字符串复制("跳出载荷"));
            结果<空类型, 整32> 加 = 表.追加(甲);
            中断;
        }
        轮++;
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 16;
}

函数 形链表() -> 整64 {
    整64 前 = 内存::活动分配数();
    {
        链表<珠宝> 表 = 链表<珠宝>();
        珠宝 甲;
        结果<空类型, 整32> 加 = 表.追加(甲);
        表.清空();
        如果 (表.大小() != 0) { 返回 0; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 32;
}

函数 形串字段元素() -> 整64 {
    整64 前 = 内存::活动分配数();
    {
        向量<珠宝> 表 = 向量<珠宝>();
        珠宝 甲;
        结果<空类型, 整32> 加 = 表.追加(甲);
        如果 (表.大小() != 1) { 返回 0; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 64;
}

函数 主() -> 整32 {
    整64 和 = 形块出口() + 形清空() + 形删除() + 形删除中间() + 形跳出() + 形链表() + 形串字段元素();
    如果 (和 == 127) {
        打印("容器类元素析构链：七形态全通过");
    } 否则 {
        打印("容器类元素析构链：失败");
    }
    返回 整32(和);
}
