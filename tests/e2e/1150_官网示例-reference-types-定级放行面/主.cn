// 官网文档示例 · reference/types.html · 整数（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
函数 主() -> 整32 {
    整8 甲 = 0;
    甲 = 甲 + 1L;            // ③窄伴侣拉窄：放行（=1）
    打印(甲);
    正32 乙 = 0;
    乙 = 1 + 乙;             // ①无后缀随侧：放行（=1）
    打印(乙);
    整32 丙 = 0;
    丙 += 1L;                // 复合赋值字面量豁免：放行（=1）
    打印(丙);
    变量 丁 = 1L + 2;        // 推断声明带 L 字面量：整64（=3）
    打印(丁);
    返回 0;
}