// E2E 443（2026-09-18 第 347 轮·T33 残余根治门禁）：窄宽类型**符号性**矩阵——
//   整8/整16/整32（有符号）负值与 正8/正16（无符号）大值 经
//   局部/结构体字段/数组元素/指针解引用 四路径读写，宿主/v2 双编译同测。
//   依据：宿主语义（有符号窄类型符号扩展读回；无符号零扩展读回）。
//   背景：v2 `类型宽度码` 原把 整8/正8、整16/正16 **归并**（符号性丢失）→
//   字段/数组/指针路径错值（探针 p24：正8 字段 200 读回 -56）；`IR_指针加载`
//   窄宽原零扩展 → 有符号负值错值（探针 p23：整16 字段 -426 读回 65110）。
结构体 窄盒 {
    整8 微;
    整16 短;
    整32 常;
    正8 微正;
    正16 短正;
}

不安全 函数 指针读微(整8* 源) -> 整8 {
    返回 *源;
}

不安全 函数 指针读短(整16* 源) -> 整16 {
    返回 *源;
}

函数 主() -> 整32 {
    整8 微 = -100;
    整16 短 = -426;
    整32 常 = -70000;
    正8 微正 = 200;
    正16 短正 = 60000;
    打印("局部 微=", 微, " 短=", 短, " 常=", 常, " 微正=", 微正, " 短正=", 短正);
    窄盒 盒 = 窄盒{ 微 = 微, 短 = 短, 常 = 常, 微正 = 微正, 短正 = 短正 };
    打印("字段 微=", 盒.微, " 短=", 盒.短, " 常=", 盒.常, " 微正=", 盒.微正, " 短正=", 盒.短正);
    整16[2] 短阵;
    整32[2] 常阵;
    正16[2] 短正阵;
    短阵[0] = 短;
    常阵[0] = 常;
    短正阵[0] = 短正;
    打印("数组 短=", 短阵[0], " 常=", 常阵[0], " 短正=", 短正阵[0]);
    打印("指针 微=", 指针读微(&微), " 短=", 指针读短(&短));
    返回 0;
}
