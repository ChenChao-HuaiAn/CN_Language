// E2E 1405（#1962 执法三·S3 悬垂探针·修前红修后绿）：容器实例引用返回字符串
//   方法（向量$字符串.元素引用 -> T&）直赋赋值位/声明位深拷落堆面——
//   修前：IR 层 是引用返回字符串调用=两源白名单 walk（标识符被调 查函数返回
//     回退/成员被调 查类方法返回），容器内置方法不在通道（容器签名表只有语义
//     层解析调用返回类型文本 认）→ miss=假 → 933 赋值位不深拷 → 副=容器槽串
//     句柄浅拷共享 → 源清空/覆盖后 副 读悬垂（内容垃圾）+ 副 RAII free 悬垂
//     句柄 double-free → 校验≠3 红；
//   修后：调用返回类型登记面单一事实源（语义层 检查调用表达式并登记 收口·
//     容器签名表/容器方法类型表全量覆盖），IR 层取调用返回文 纯查表命中
//     「字符串&」尾 '&' → 赋值位 __cn_str_copy 落堆独立拥有 → 源清空/覆盖后
//     副 内容稳定 + 块出口 活动分配数 残留==0（独立副本 RAII 对称）→ rc=0 绿。
// 校验位：位1=深拷独立（源清空+覆盖后 副 原值）；位2=块出口残留==0
//   （块内活跃=副独立副本+覆盖串两笔分配=深拷正账·块外须全收口）。
导入 容器::向量;
函数 主() -> 整32 {
    整64 基线1 = 内存::活动分配数();
    整32 校验 = 0;
    布尔 独1 = 假;
    布尔 账1 = 假;
    {
        向量<字符串> 源 = 向量<字符串>();
        结果<空类型, 整32> 追甲 = 源.追加("执法三探针甲");
        如果 追甲.正常 {
        } 否则 {
            打印(追甲.错误);
        }
        字符串 副 = 源.元素引用(0);
        源.清空();
        结果<空类型, 整32> 追乙 = 源.追加("覆盖串乙长覆盖串乙长覆盖串乙长覆盖串乙长");
        如果 追乙.正常 {
        } 否则 {
            打印(追乙.错误);
        }
        独1 = 字符串比较(副, "执法三探针甲");
    }
    账1 = 内存::活动分配数() - 基线1 == 0;
    如果 (独1) { 校验 = 校验 + 1; }
    如果 (账1) { 校验 = 校验 + 2; }
    打印("执法三赋值位落堆绿");
    返回 校验;
}
