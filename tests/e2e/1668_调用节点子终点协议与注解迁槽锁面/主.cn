// E2E 1668（任务 1872·2026-10-31 调用节点子终点协议落地+语义期注解迁槽锁面）：
//   协议常量 节点_调用.子终点=参数段末 落地（解析器建调用节点尾参写死 0 根治）
//   +71-a 装箱/复制/泛型期望类型注解自 子终点 迁 文本 槽——激活面全族绿锁。
//   ①声明位构造器（71-a 声明位语境·1591 幂等判据迁文本后照常）
//   ②返回位构造器（检查语句 返回分支语境）
//   ③实参位构造器期望覆盖（894 末形参下推·迁文本写入面）
//   ④泛型函数体内构造器（模板语境注解+泛型实例克隆面——克隆修针走
//     修针兜底回填槽位·子终点=自身索引公式兼容验证）
//   ⑤转移三通道（声明位/赋值位 963 附加==1 判据场景/指针转移）
//   ⑥复制四形态（字符串/标量直通/结构体深拷/容器深拷——206-c 迁文本读面）
//   ⑦不安全函数内 释放(指针) 豁免正态（裸释放执法复活零误伤·负态=265_v2）
导入 容器::向量;

结构体 记录盒 {
    字符串 名;
}

泛型 <类型 T> 函数 造正常(T v) -> 结果<T, 整32> {
    返回 正常(v);
}

函数 收结果(结果<整32, 整32> 入) -> 整32 {
    如果 入.正常 {
        返回 入.值;
    } 否则 {
        返回 0 - 1;
    }
}

不安全 函数 主() -> 整32 {
    // ① 声明位构造器
    结果<整32, 整32> 甲 = 正常(41);
    如果 甲.正常 {
        打印("① ", 甲.值);
    } 否则 {
        打印("① 异常");
    }
    结果<整32, 整32> 乙 = 错误(7);
    如果 !乙.正常 {
        打印("① 错误码 ", 乙.错误);
    } 否则 {
        打印("① 异常");
    }
    // ② 返回位构造器
    结果<整32, 整32> 丙 = 造正常(9);
    如果 丙.正常 {
        打印("② ", 丙.值);
    } 否则 {
        打印("② 异常");
    }
    // ③ 实参位构造器期望覆盖（894：末形参 结果<T,E> 下推）
    整32 丁 = 收结果(正常(15));
    打印("③ ", 丁);
    // ④ 泛型函数体内构造器（模板语境+克隆面）
    结果<整32, 整32> 戊 = 造正常<整32>(6);
    如果 戊.正常 {
        打印("④ ", 戊.值);
    } 否则 {
        打印("④ 异常");
    }
    // ⑤ 转移三通道
    字符串 源串 = "交接";
    字符串 接串 = 转移(源串);
    打印("⑤ ", 接串);
    字符串 目标 = "旧值";
    目标 = 转移(接串);
    打印("⑤ ", 目标);
    整64 基 = 55;
    整64* 指针甲 = &基;
    整64* 指针乙 = 转移(指针甲);
    打印("⑤ ", *指针乙);
    // ⑥ 复制四形态
    字符串 原串 = "复制我";
    字符串 副本 = 复制(原串);
    打印("⑥ ", 原串, " / ", 副本);
    整64 数 = 复制(123);
    打印("⑥ ", 数);
    整64 记0 = 内存::活动分配数();
    {
        记录盒 原;
        原.名 = 字符串复制("盒子名");
        记录盒 记录副本 = 复制(原);
        打印("⑥ ", 记录副本.名, " 源=", 原.名);
    }
    打印("⑥ 结构体残留=", 内存::活动分配数() - 记0);
    整64 记1 = 内存::活动分配数();
    {
        向量<整32> 表 = 向量<整32>();
        结果<空类型, 整32> 加表 = 表.追加(3);
        结果<空类型, 整32> 加表2 = 表.追加(4);
        向量<整32> 表副本 = 复制(表);
        打印("⑥ 容器大小=", 表副本.大小());
    }
    打印("⑥ 容器残留=", 内存::活动分配数() - 记1);
    // ⑦ 不安全函数内释放豁免正态（分配→读→释放 零误伤）
    整64* 堆 = 分配(2 * 类型大小(整64));
    堆[0] = 77;
    打印("⑦ ", 堆[0]);
    释放(堆);
    打印("⑦ 释放后活动=", 内存::活动分配数());
    返回 0;
}
