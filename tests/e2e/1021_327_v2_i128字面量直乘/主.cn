// E2E 1021（2026-10-16·任务 #327 验收对）：LL 字面量直乘——i128 域内不溢出。
//   34359738368LL*34359738368LL=2^70 远小于 2^127（宿主放行「真」）；修前 v2
//   值域内 LL/ULL 字面量不物化 128（寄存器码 T_整64）双侧字面量直乘落 64 位
//   路径按 64 位域误报错误码 8。修后 128 分派双侧 128 族补物化走 i128 辅助。
//   附带同族：LL 双侧加法（2^62+2^62=2^63 超整64 域·i128 域内）；
//   回归对照：小值双侧 LL 乘/单侧 LL 乘（不得误伤）。
//   双编译对照：宿主与 v2 同源同测——输出逐行一致 + 退出码一致。
函数 主() -> 整32 {
    如果 (34359738368LL * 34359738368LL > 0) { 打印("乘真"); } 否则 { 打印("乘假"); }
    如果 (4611686018427387904LL + 4611686018427387904LL > 0) { 打印("加真"); } 否则 { 打印("加假"); }
    如果 (3LL * 4LL == 12) { 打印("小乘对"); } 否则 { 打印("小乘错"); }
    如果 (3LL * 4 == 12) { 打印("单侧对"); } 否则 { 打印("单侧错"); }
    返回 0;
}
