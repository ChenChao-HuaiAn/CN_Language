// E2E 947（728s 宿主+v2 双测）：整数字面量 L/U/UL 后缀定级与二元算式结果类型
// 规范锚=规格书 4.3 后缀映射（宿主 literalTypeOf 同构）+ 728s 对称化裁决
// （2026-10-15 用户裁决批乙·Rust 真对齐）：结果类型=「无后缀字面量随另一侧」
// 定级 + 秩合并（秩高者胜/同秩取左·宿主 commonNumericType 链·两侧同口径）
// ——`1 + 2U` 与 `2U + 1` 双向同结果正32（对称化前左右不对称：1 + 2U 落
// 整32 被混合符号赋值误拒）；**移位（<< >>）除外**（右操作数不参与结果类型·
// 740 推导二元结果类型ID 锚同口径，s6 锁面）。v2 修复前字面量恒整32 →
// `正32 丙 = 1U + 2U;` 全族误报「混合符号赋值禁止」中止（582 轮侦察·728s
// 立案）；本用例=零分叉行为矩阵锚（断言输出=是·双侧同 expected）。
函数 主() -> 整32 {
    正32 丙 = 1U + 2U;            打印("q2=", 丙);        // 正32+正32=正32
    正64 丁 = 1UL + 2UL;          打印("q4=", 丁);        // 正64+正64=正64
    正32 戊 = 1U + 2;             打印("q5=", 戊);        // 无后缀 2 随 1U=正32
    正32 己 = 0U + 1U;            打印("q6=", 己);
    正32 庚 = 2147483647U + 1U;   打印("q6b=", 庚);       // 正32 域内 2147483648
    正64 辛 = 1UL + 2;            打印("q7=", 辛);        // 无后缀 2 随 1UL=正64
    正64 壬 = 1 + 2UL;            打印("a4=", 壬);        // 无后缀 1 随 2UL=正64
    正32 癸 = 2U + 1;             打印("a6=", 癸);
    正32 子 = 5U;                 打印("p10=", 子);
    正32 丑 = 4000000000;         打印("u1=", 丑);        // 存量面哨兵（正32 大值）
    打印("u2=", 18446744073709551615UL);
    打印("q6d=", 2147483647U + 1);
    // 728s 对称化（2026-10-15 用户裁决批乙）：无后缀字面量随另一侧·双向对称——
    正32 甲 = 1 + 2U;             打印("s1=", 甲);        // 无后缀 1 随 2U=正32（原拒）
    正32 乙 = 2 + 1U;             打印("s2=", 乙);        // 无后缀 2 随 1U=正32
    正32 寅 = 1 + 2U + 3;         打印("s3=", 寅);        // 链式同规则
    正32 卯 = 2147483647 + 1U;    打印("s4=", 卯);        // 域=正32（原按整32 误报溢出）
    正32 辰 = 1 | 2U;             打印("s5=", 辰);        // 位运算同规则
    整32 巳 = 1 << 2U;            打印("s6=", 巳);        // 移位**不随侧**：右操作数不参与=整32 恒定级（740 锚同口径）
    正32 变 = 1;
    正32 午 = 1 + 变;             打印("s7=", 午);        // 另一侧=变量同规则
    变量 酉 = 1 + 2U;             打印("s8=", 酉);        // 推断面同规则（定级正32）
    返回 0;
}
