// E2E 947（728s 宿主+v2 双测）：整数字面量 L/U/UL 后缀定级与二元算式结果类型
// 规范锚=规格书 4.3 后缀映射（宿主 literalTypeOf 同构）；结果类型=秩高者胜/
// 同秩取左（宿主 commonNumericType 链·两侧同口径）。v2 修复前字面量恒整32 →
// `正32 丙 = 1U + 2U;` 全族误报「混合符号赋值禁止」中止（582 轮侦察·728s 立案）；
// 本用例=零分叉行为矩阵锚（断言输出=是·双侧同 expected）。
函数 主() -> 整32 {
    正32 丙 = 1U + 2U;            打印("q2=", 丙);        // 正32+正32=正32
    正64 丁 = 1UL + 2UL;          打印("q4=", 丁);        // 正64+正64=正64
    正32 戊 = 1U + 2;             打印("q5=", 戊);        // 正32+整32 同秩取左=正32
    正32 己 = 0U + 1U;            打印("q6=", 己);
    正32 庚 = 2147483647U + 1U;   打印("q6b=", 庚);       // 正32 域内 2147483648
    正64 辛 = 1UL + 2;            打印("q7=", 辛);        // 秩高者胜=正64
    正64 壬 = 1 + 2UL;            打印("a4=", 壬);        // 秩高者胜=正64
    正32 癸 = 2U + 1;             打印("a6=", 癸);
    正32 子 = 5U;                 打印("p10=", 子);
    正32 丑 = 4000000000;         打印("u1=", 丑);        // 存量面哨兵（正32 大值）
    打印("u2=", 18446744073709551615UL);
    打印("q6d=", 2147483647U + 1);
    返回 0;
}
