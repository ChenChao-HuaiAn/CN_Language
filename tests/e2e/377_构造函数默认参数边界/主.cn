// E2E 377：构造函数默认参数（规格书 04-一C 默认参数从右向左连续声明，
//   构造调用按「实参个数+可补全」匹配）——D23 根治锚定（248-a）：
//   ① 少参调用补默认值（父构造经初始化列表拿到 9）；② 显式传满不误补。
类 甲 {
公开:
    整32 值
    函数 甲(整32 n) { 值 = n; }
}

类 乙 : 甲 {
公开:
    函数 乙(整32 n = 9) : 甲(n) { }
}

函数 主() -> 整32 {
    乙 缺省 = 乙();
    打印("缺省: ", 缺省.值);
    乙 显式 = 乙(3);
    打印("显式: ", 显式.值);
    返回 0;
}
