// 1491 循环累积拼接语义（任务 750·双编译对照）
//   覆盖识别判据正反两面（语义逐字节等价）：
//   A 非空初值累积（优化）/ B 循环内读取（判据③ 不优化·原路径）/ C 中断
//   （优化·出口块 finish）/ D 继续（优化·跳过轮不追加）/ E 数值段链（右值链
//   左根非标识符=判据②不优化，表达式内由 728o/749 链融合处理）/ F 当循环
//   （优化）/ G 嵌套循环（外层判据⑤不优化·内层独立优化）/ H 非空初值+数值段
//   （优化）/ I 循环内传参（判据③ 不优化）/ J 循环内数组暂存（右值读 s=判据③
//   不优化）/ K 右值含 s 读取（判据③ 不优化）/ L 零轮循环（优化·输出初值原样）/
//   M 单轮（优化）/ N 初值来自变量（优化）/ O 循环内返回（判据④ 不优化·提前
//   返回语义）/ P 其它变量赋值并存（优化·语句位集合判定）
不安全 函数 提前返回(整64 轮数, 字符串 片段) -> 字符串 {
    字符串 s = "";
    循环 (整64 k = 0; k < 轮数; k++) {
        s = s + 片段;
        如果 (k == 1) {
            返回 s;
        }
    }
    返回 s;
}

不安全 函数 主() -> 整32 {
    字符串 片段 = "ab";
    // A 非空初值
    字符串 a = "HELLO:";
    循环 (整64 k = 0; k < 3; k++) {
        a = a + 片段;
    }
    打印("A=", a);
    // B 循环内读取（不优化·语义正确）
    字符串 b = "";
    循环 (整64 k = 0; k < 3; k++) {
        b = b + 片段;
        打印行("B读=", 整数转字符串(字符串长度(b)), ";");
    }
    打印("");
    // C 中断
    字符串 c = "";
    循环 (整64 k = 0; k < 10; k++) {
        c = c + 片段;
        如果 (k == 2) { 中断; }
    }
    打印("C=", c);
    // D 继续（赋值前跳过）
    字符串 d = "";
    循环 (整64 k = 0; k < 5; k++) {
        如果 (k == 2) { 继续; }
        d = d + 片段;
    }
    打印("D=", d);
    // E 数值段拼接
    字符串 e = "";
    循环 (整64 k = 0; k < 5; k++) {
        e = e + 整数转字符串(k) + ",";
    }
    打印("E=", e);
    // F 当循环
    字符串 f = "";
    整64 j = 0;
    当 (j < 4) {
        f = f + "x";
        j = j + 1;
    }
    打印("F=", f);
    // G 嵌套循环（外层不优化·内层独立）
    字符串 g = "";
    循环 (整64 k = 0; k < 3; k++) {
        循环 (整64 m = 0; m < 2; m++) {
            g = g + "n";
        }
    }
    打印("G=", g);
    // H 非空初值+数值段
    字符串 h = "N";
    循环 (整64 k = 0; k < 4; k++) {
        h = h + 整数转字符串(k);
    }
    打印("H=", h);
    // I 循环内传参（不优化）
    字符串 i = "";
    循环 (整64 k = 0; k < 3; k++) {
        i = i + 片段;
        打印行("[", i, "]");
    }
    打印("");
    // J 循环内容器/数组暂存（不优化·污染面）
    字符串[2] 表 = { "", "" };
    字符串 jj = "";
    循环 (整64 k = 0; k < 3; k++) {
        jj = jj + "z";
        表[0] = 字符串复制(jj);
    }
    打印("J=", jj, " 表0长=", 整数转字符串(字符串长度(表[0])));
    // K 右值含 s（不优化·语义正确）
    字符串 kk = "q";
    循环 (整64 k = 0; k < 3; k++) {
        kk = kk + 字符串复制(kk);
    }
    打印("K=", kk);
    // L 零轮循环
    字符串 l = "初值";
    循环 (整64 k = 0; k < 0; k++) {
        l = l + 片段;
    }
    打印("L=", l);
    // M 单轮
    字符串 m = "";
    循环 (整64 k = 0; k < 1; k++) {
        m = m + 片段;
    }
    打印("M=", m);
    // N 初值来自变量
    字符串 n = 片段;
    循环 (整64 k = 0; k < 3; k++) {
        n = n + "!";
    }
    打印("N=", n);
    // O 循环内返回（不优化·提前返回）
    打印("O=", 提前返回(5, 片段));
    // P 循环体内其它变量赋值并存（语句位集合判定·双侧同构）
    整64 总长 = 0;
    字符串 p = "";
    循环 (整64 k = 0; k < 3; k++) {
        p = p + 片段;
        总长 = 总长 + 1;
    }
    打印("P=", p, " 轮=", 整数转字符串(总长));
    返回 0;
}
