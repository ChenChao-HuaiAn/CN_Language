// E2E 62_ffi：外部 函数 声明（C-3 FFI 最小集，2026-08；905 轮三平台同源改造 2026-09-30）
// 覆盖：无参外部函数（rand）、参数+返回值（strlen/toupper/llabs）、
//   字符串参数传递（CN 字符串 = 托管缓冲指针，与 C char* 布局兼容）、
//   外部函数链接符号 = 函数名本身（C 符号无重载 mangling/模块前缀）、
//   链接库：libc/ucrt（strlen/toupper/rand/llabs）为各平台默认链接库——
//   905 轮按用户令改造为三平台同源真跑（原 GetTickCount64 依赖 kernel32 致
//   linux 两平台跳过；kernel32 链接验证点随改造移除，FFI 核心验证全保留）。
// 语法：外部 函数 名(参数) -> 返回类型（无函数体；符号由链接期库解析）

外部 函数 strlen(字符串 s) -> 整64
外部 函数 toupper(整32 c) -> 整32
外部 函数 rand() -> 整32
外部 函数 llabs(整64 x) -> 整64

不安全 函数 主() -> 整32 {
    打印("===== FFI 外部 函数（C-3）=====");

    // 1. strlen：字节长度（UTF-8 "中文" 2 字 = 6 字节；NUL 结尾兼容）
    打印("长度: ", strlen("中文"));

    // 2. toupper：97('a') -> 65('A')
    打印("大写: ", toupper(97));

    // 3. rand：无参外部函数（C 标准库三平台通用；返回值恒非负）
    打印("随机非负: ", rand() >= 0);

    // 4. llabs：整64 参数+整64 返回（64 位位宽通道·确定性小值）
    //    注：大值（>2^32）整64 外部形参在 arm64 存在 ABI 塌缩缺陷＝任务 110〔原立 107 撞空洞号让位〕
    //    （0929 审计 087 聚合塌缩同族·宿主 codegen 调用发射层）——修复后补强。
    打印("六十四位绝对值: ", llabs(0 - 100));

    // 5. 返回值参与表达式运算（toupper(97) + 1 = 66）
    打印("大写加一: ", toupper(97) + 1);

    打印("===== FFI 测试完成 =====");
    返回 0;
}
