// E2E 866_字符串构建器（#366·2026-10-13）：字符串连接 O(n²) 根治设施验收
//   病根：CN 字符串=不可变 C 串，字符串连接 每次新分配+整串拷贝，拼 k 段均摊
//   O(k²) 字节拷贝（b1 基准 8192×32B 实测锚）；修=字符串构建器（预分配缓冲+
//   追加尾插摊还倍增+终态出串·Rust String::push_str 同款·001 §10.3 立法）。
//   覆盖：
//   ① 内建层（限定名直调·无需导入）：新建/追加/追加字节/完成 全链；
//   ② stdlib 门面层（字符串扩展::字符串构建器* 纯名·含 追加整数 便利函数）；
//   ③ 连接对照：构建器结果 == 朴素字符串连接结果（同源段·显式 字符串比较）；
//   ④ 边界：空串追加、空缓冲出串=空串；
//   ⑤ 大串出串校验（100 段×6B=600）；
//   ⑥ 泄漏断言（内存::活动分配数·216 先例口径）：完成出串=计 1（出串 tracked），
//     子函数退出 RAII 回落差=0；
//   ⑦ 弃置=错误路径中途放弃不取串（不可观测面只验不崩）。
//   dual：宿主+v2 双侧同源码（内建四件套 872 双侧已在·弃置 366 双侧同构补齐）。
导入 字符串扩展::{字符串构建器新建, 字符串构建器追加, 字符串构建器追加整数, 字符串构建器完成, 字符串构建器弃置};

// 出串段：完成出串 RAII 泄漏断言——返回「完成时刻-入口」活动分配数差
//   （应=1：完成出串经 cn_alloc_tracked 计 1；出串随本函数退出 RAII 自动释放）。
//   〔面注〕段内禁打印——打印 的字符串变参临时串存在不释放的既有缺口
//   （非本用例面·另案立项），断言窗口内不得混入无关分配。
函数 出串段() -> 整64 {
    整64 前分配 = 内存::活动分配数();
    整64 句 = 字符串构建器::新建();
    循环 (整64 k = 0; k < 100; k++) {
        字符串构建器::追加(句, "片段");
    }
    字符串 出串 = 字符串构建器::完成(句);
    整64 中分配 = 内存::活动分配数();
    返回 中分配 - 前分配;
}

函数 主() -> 整32 {
    // ① 内建层：追加多段（含中文 UTF-8）+追加字节（33='!'）
    整64 句甲 = 字符串构建器::新建();
    字符串构建器::追加(句甲, "你好，");
    字符串构建器::追加(句甲, "构建器");
    字符串构建器::追加字节(句甲, 33);
    字符串 内建串 = 字符串构建器::完成(句甲);
    打印(内建串);

    // ② stdlib 门面 + 追加整数便利
    整64 句乙 = 字符串构建器新建();
    字符串构建器追加(句乙, "编号=");
    字符串构建器追加整数(句乙, 366);
    字符串 门面串 = 字符串构建器完成(句乙);
    打印(门面串);

    // ③ 连接对照：64 段同源——朴素逐段连接 vs 构建器一次成型
    字符串 片段 = "片段";
    字符串 朴素 = "";
    整64 句丙 = 字符串构建器::新建();
    循环 (整64 k = 0; k < 64; k++) {
        朴素 = 字符串连接(朴素, 片段);
        字符串构建器::追加(句丙, 片段);
    }
    字符串 构建串 = 字符串构建器::完成(句丙);
    如果 (字符串比较(构建串, 朴素)) {
        打印("对照: 相等 长度=", 整数转字符串(字符串长度(构建串)));
    } 否则 {
        打印("对照: 不等");
    }

    // ④ 边界：空串追加（缓冲仍空）→ 出串=空串（长 0）
    整64 句丁 = 字符串构建器::新建();
    字符串构建器::追加(句丁, "");
    字符串构建器::追加(句丁, "");
    字符串 空串 = 字符串构建器::完成(句丁);
    打印("空缓冲长=", 整数转字符串(字符串长度(空串)));

    // ⑤ 大串出串校验：100 段×6 字节（"片段" UTF-8）=600
    整64 句丙二 = 字符串构建器::新建();
    循环 (整64 k = 0; k < 100; k++) {
        字符串构建器::追加(句丙二, 片段);
    }
    字符串 大出串 = 字符串构建器::完成(句丙二);
    打印("出串长=", 整数转字符串(字符串长度(大出串)));

    // ⑥ 泄漏断言：出串计 1（tracked）+函数退出 RAII 回落差=0（216 口径）
    //   断言窗口（基线→回落差）内零打印零传参——打印变参临时/变量传参形参槽
    //   均存在既有缺口（另案立项），不得混入本断言。
    整64 基线 = 内存::活动分配数();
    整64 出串差 = 出串段();
    整64 回落差 = 内存::活动分配数() - 基线;
    打印("出串差=", 整数转字符串(出串差));
    打印("回落差=", 整数转字符串(回落差));

    // ⑦ 弃置：错误路径中途放弃（不取串·句柄一次性）——只验全链不崩
    整64 句戊 = 字符串构建器::新建();
    循环 (整64 k = 0; k < 100; k++) {
        字符串构建器::追加(句戊, 片段);
    }
    字符串构建器::弃置(句戊);
    打印("弃置: 完成");
    返回 0;
}
