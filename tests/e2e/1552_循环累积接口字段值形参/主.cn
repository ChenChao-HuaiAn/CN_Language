// 1552 循环累积接口字段值形参（任务 1549·双编译性能向）
//   病：成员链接收者借用位750 的精确面仅用户类——接口指针字段接收者
//   `外.口.取(s)`（值形参）落整函数保守（引用实参根全登记 → 累积提升被抑制；
//   v2 优化=0 而宿主按 AST 取址包装精确判定=1）。
//   修：接口接收者按接口方法参数串段尾 '&' 解析引用位（复用接口方法引用位
//   扫描750）——值形参不抑制；引用位实参仍登记逃逸（负例=1554）。
//   负载：循环外 `外.口.取(槽.名)`（成员根）+ `外.口.取(s)`（标识符根）+ 循环累积 s。
//   预期：长=2048 / 接口字段优化=1（分配次数≤6·双侧一致）。
结构体 盒 {
    字符串 名;
}

接口 取口 {
    虚拟 函数 取(字符串 参) -> 整64;
}

类 取器 : 取口 {
公开:
    函数 取器() { }
    重写 函数 取(字符串 参) -> 整64 { 返回 字符串长度(参); }
}

类 持有口 {
公开:
    取口* 口;
    函数 持有口() { 口 = 无; }
}

不安全 函数 主() -> 整32 {
    字符串 s = "";
    盒 槽 = 盒{ 名 = "abc" };
    持有口 外 = 持有口();
    取器 实 = 取器();
    外.口 = 实;
    外.口.取(槽.名);
    外.口.取(s);
    整64 前 = 内存::总分配次数();
    循环 (整64 k = 0; k < 2048; k++) {
        s = s + "x";
    }
    整64 次 = 内存::总分配次数() - 前;
    打印("长=", 整数转字符串(字符串长度(s)));
    布尔 降 = 次 <= 6;
    如果 (降) { 打印("接口字段优化=1"); } 否则 如果 (次 > 6) {
        打印("接口字段优化=0 次=", 整数转字符串(次));
    }
    返回 0;
}
