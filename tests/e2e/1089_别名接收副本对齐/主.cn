类 盒 {
公开:
    整32 值;
    函数 取(盒 他) -> 盒 {
        返回 他;
    }
}

类 猫 {
公开:
    函数 猫() {
        打印行(11);
    }
    不安全 函数 猫(猫& 其他) {
        打印行(55);
    }
    不安全 函数 ~猫() {
        打印行(22);
    }
}

函数 抚(猫 宠) -> 猫 {
    返回 宠;
}

函数 造() -> 猫 {
    猫 临时;
    返回 临时;
}

函数 主() -> 整32 {
    盒 甲;
    甲.值 = 4;
    盒 乙 = 甲.取(甲);
    乙.值 = 9;
    打印行(甲.值);
    {
        猫 大;
        猫 小 = 抚(大);
        打印行(33);
    }
    {
        猫 丁 = 造();
        打印行(44);
    }
    打印行(66);
    返回 0;
}
