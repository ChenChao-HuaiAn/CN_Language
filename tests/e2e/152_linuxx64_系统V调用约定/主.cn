// E2E 152（plans/016）：linux-x86_64 后端 SysV AMD64 ABI 分歧面专项
// 覆盖：7 整型参数（超出 rdi~r9 走栈）/ 浮点整型混合参数（独立计数）/
//       结构体返回（隐藏 rdi）/ 浮点返回（xmm0）/ 结构体按值参数 / 递归对齐
// 平台说明：本用例三平台语义一致，重点锚定 SysV 特有路径

// 7 整型参数：前6走 rdi..r9，第7走栈（[rbp+16]）
函数 和7(整32 a, 整32 b, 整32 c, 整32 d, 整32 e, 整32 f, 整32 g) -> 整32 {
    返回 a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6 + g * 7;
}

// 浮点/整型混合参数：SysV 浮点独立计数（x/y 占 xmm 位、n 占 rdi）
函数 混合(浮64 x, 整32 n, 浮64 y) -> 浮64 {
    返回 x * 2.0 + y + 浮64(n);
}

// 浮点返回：xmm0
函数 平均(浮64 a, 浮64 b) -> 浮64 {
    返回 (a + b) / 2.0;
}

// 结构体返回：SysV 隐藏返回指针 rdi，返回 rax
结构体 点 {
    整32 x;
    整32 y;
}

函数 造点(整32 px, 整32 py) -> 点 {
    点 p = 点{ x = px, y = py };
    返回 p;
}

// 结构体按值参数（指针传入 + 被调方拷贝）
函数 点平方和(点 p) -> 整32 {
    返回 p.x * p.x + p.y * p.y;
}

// 递归（栈帧嵌套对齐纪律）
函数 阶乘(整32 n) -> 整64 {
    如果 n <= 1 {
        返回 1;
    }
    返回 n * 阶乘(n - 1);
}

函数 主() -> 整32 {
    // 7 参数（第7参数走 SysV 栈参数）：1+4+9+16+25+36+49 = 140
    打印(和7(1, 2, 3, 4, 5, 6, 7));
    // 混合参数（x=1.5 n=3 y=2.25 -> 1.5*2+2.25+3 = 8.25）
    打印(混合(1.5, 3, 2.25));
    // 浮点返回 xmm0：(2.5+7.5)/2 = 5
    打印(平均(2.5, 7.5));
    // 结构体返回 + 字段读
    点 q = 造点(3, 4);
    打印(q.x);
    打印(q.y);
    // 结构体按值参数：9+16=25
    打印(点平方和(造点(3, 4)));
    // 递归：5! = 120
    打印(阶乘(5));
    返回 0;
}
