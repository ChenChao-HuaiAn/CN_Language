// 1490 循环累积拼接提升（任务 750·b1/b6 累积段口径）
//   负载：`大串 = 大串 + 片段` 8192 轮 × 32 字节 = 256KB 终串。
//   朴素路径每轮新分配+整串拷贝 O(n²)（b1 实测 ≈1.07GB 分配字节）；
//   编译器识别为跨迭代累积 → 构建器（new+append 初值 → 逐段 append →
//   finish 回写 s），分配字节降到 ~终串大小 + 一次完成分配。
//   断言（打印固定文本·跨平台稳定）：终串长=262144 / 分配字节下降=1
//   （阈值 5MB·优化后≈256KB·优化前≈1.07GB）/ 分配次数下降=1（阈值 ≤2）
//   / 耗时合理=1（阈值 5000ms·防退化）。
不安全 函数 主() -> 整32 {
    字符串 片段 = "0123456789abcdef0123456789abcdef";
    整64 字节前 = 内存::总分配字节();
    整64 次数前 = 内存::总分配次数();
    整64 起 = 时间::单调时钟毫秒();
    字符串 大串 = "";
    循环 (整64 k = 0; k < 8192; k++) {
        大串 = 大串 + 片段;
    }
    整64 止 = 时间::单调时钟毫秒();
    整64 字节差 = 内存::总分配字节() - 字节前;
    整64 次数差 = 内存::总分配次数() - 次数前;
    整64 长度 = 字符串长度(大串);
    打印("提升: 终串长=", 整数转字符串(长度));
    布尔 字节降 = 字节差 < 5000000;
    如果 (字节降) {
        打印("提升: 分配字节下降=1");
    } 否则 如果 (!字节降) {
        打印("提升: 分配字节下降=0 实际=", 整数转字符串(字节差));
    }
    布尔 次数降 = 次数差 <= 2;
    如果 (次数降) {
        打印("提升: 分配次数下降=1");
    } 否则 如果 (!次数降) {
        打印("提升: 分配次数下降=0 实际=", 整数转字符串(次数差));
    }
    布尔 耗时合理 = (止 - 起) < 5000;
    如果 (耗时合理) {
        打印("提升: 耗时合理=1");
    } 否则 如果 (!耗时合理) {
        打印("提升: 耗时合理=0 实际=", 整数转字符串(止 - 起));
    }
    返回 0;
}
