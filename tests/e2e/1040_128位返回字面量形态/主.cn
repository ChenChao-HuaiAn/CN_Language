// 1040（任务 #573·551 同族漏网收口）：128 位返回**字面量全形态** dual 正测——
//   同一源码宿主+v2 双侧编译运行、stdout 逐行比对（.expected）。
// 背景：v2「变量 句柄=返回128函数; 句柄()」原报「非法寄存器槽号 -27」已消，
//   残余=「128 直返字面量」运行值垃圾（10141436886806280466338037103080）：
//   生成返回结构体值分支 的 H6「裸无零初始化」分支误命中字面量末节点
//   （拷贝字节=查结构体大小(0)=0 → 槽数 0 → 取地址(槽起-1) 读 retbuf 指针
//   邻区当地址拷 16 字节）；负字面量「返回 -42;」直入 IR_结构体拷贝 读
//   地址 = -42 崩溃（C0000005）。修=H6 排除 128 返回 + 出口 128 规范化
//   （非 128 句柄源经 物化128位操作数 提升·字面量回扫拆半/符号扩展），
//   左值形态（64 位变量/成员等）128 返回时按右值读（防对象宽度盲 16 字节拷）。
// 覆盖面：
//   ①直返域内字面量（42）②直返超64域大字面量（123456789012345678901234567890）
//   ③直返负字面量（-42）④返参（返回 入）⑤变量中转（整128 q=77; 返回 q）
//   ⑥64 位变量到 128 返回（符号提升）⑦64 位表达式到 128 返回（甲+乙）
//   ⑧负复合到 128 返回（-(甲+乙)）⑨fnptr 变量中转调用（原 #573 现象形态）
//   ⑩ 128 局部接收二次打印 ⑪局部经函数透传返回 ⑫结构体 128 成员左值返回
//   （左值分支改右值读回归面——成员 128 句柄通道）
// 期望（打印 逐行）：42/大字面量/-42/99/77/123456789012345/8/-8/42/42/42/
//   123456789012345

结构体 盒 {
    整128 值;
    整64 小;
}

函数 常量返回() -> 整128 {
    返回 42;
}

函数 大字面量返回() -> 整128 {
    返回 123456789012345678901234567890;
}

函数 负字面量返回() -> 整128 {
    返回 -42;
}

函数 入参返回(整128 入) -> 整128 {
    返回 入;
}

函数 变量中转返回() -> 整128 {
    整128 q = 77;
    返回 q;
}

函数 六四变量(整64 六四) -> 整128 {
    返回 六四;
}

函数 六四表达(整64 甲, 整64 乙) -> 整128 {
    返回 甲 + 乙;
}

函数 负复合(整32 甲, 整32 乙) -> 整128 {
    返回 -(甲 + 乙);
}

函数 透传(整128 入) -> 整128 {
    返回 入;
}

函数 成员返回(盒 b) -> 整128 {
    返回 b.值;
}

函数 主() -> 整32 {
    // ① 直返域内字面量
    打印(常量返回());
    // ② 直返超64域大字面量（814 物化句柄路径）
    打印(大字面量返回());
    // ③ 直返负字面量（负号包裹·原崩溃形态）
    打印(负字面量返回());
    // ④ 返参（识别符左值·原既好路径回归）
    打印(入参返回(99));
    // ⑤ 变量中转（128 变量句柄路径回归）
    打印(变量中转返回());
    // ⑥ 64 位变量到 128 返回（出口规范化符号提升）
    打印(六四变量(123456789012345));
    // ⑦ 64 位表达式到 128 返回
    打印(六四表达(3, 5));
    // ⑧ 负复合到 128 返回
    打印(负复合(3, 5));
    // ⑨ fnptr 变量中转调用（原 #573 现象形态）
    变量 句柄 = 常量返回;
    打印(句柄());
    // ⑩ 128 局部接收二次打印
    整128 局部 = 常量返回();
    打印(局部);
    // ⑪ 局部经函数透传返回
    整128 传 = 透传(局部);
    打印(传);
    // ⑫结构体 128 成员左值返回（左值分支改右值读回归面）
    盒 物 = 盒{值 = 123456789012345, 小 = 7};
    打印(成员返回(物));
    返回 0;
}
