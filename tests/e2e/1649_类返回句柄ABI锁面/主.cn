// E2E 1649_v2（任务 1818·丁案 R1 落地 v2 侧锁面）：类返回句柄 ABI——
//   001 §5.3 返回值语义（2026-10-29 用户批丁）：`-> 类名`=值副本（接收方拥有）
//   ——v2 根治 #1784 根因链：类布局曾登记进结构体大小表（本体尺寸=字段累计）
//   →「是结构体大小非零(类)=真」误入 retbuf 本体通道：被调方按本体尺寸
//   （盒<整32>=4B）拷 retbuf（8 字节句柄低 32 位截断）+调用方同判据预插
//   retbuf/按本体尺寸物化 = 1784 三形态错值实录（f2 42988957488/链式
//   274279216/字符串乱码）。修后=类返回 rax=句柄直传（无 sret）+返回位
//   借用来源 NewObject 副本（拷构/字段级深拷·形态谱分流）+拥有局部移交。
//   锁面（校验和折位·退出码=31）：
//   ①小类（整32 字段·4B<8B 截断面）借用来源返回位副本独立（位1）
//   ②容器元素() 值副本·快照语义（位2）
//   ③链式调用 中间产物 .值 读值正确（位4）
//   ④拥有局部返回=移交·实参位临时壳终结（活动分配数净 0）（位8）
//   ⑤形参返回位副本·写穿不可见（位16）
导入 容器::向量;

类 盒 {
公开:
    整32 值;
    函数 盒() { 值 = 0; }
    不安全 函数 盒(盒& 其他) { 值 = 其他.值; }
}

// 借用形态：返回形参（丁案=返回位副本·写穿不可见）
函数 直通(盒 源) -> 盒 {
    返回 源;
}

// 拥有形态：返回局部（句柄移交零拷贝）
函数 造盒(整32 v) -> 盒 {
    盒 b;
    b.值 = v;
    返回 b;
}

类 仓 {
公开:
    函数 取(盒 源) -> 盒 {
        返回 源;
    }
}

函数 消费(盒 按值) -> 整32 {
    返回 按值.值;
}

函数 主() -> 整32 {
    整32 校验 = 0;
    // ① 借用来源返回位副本独立（4B 小类·截断面）：改副本不写穿来源
    {
        盒 源1;
        源1.值 = 42;
        盒 副1 = 直通(源1);
        副1.值 = 7;
        如果 (源1.值 == 42 && 副1.值 == 7) { 校验 = 校验 + 1; }
    }
    // ② 容器元素() 值副本·快照语义
    {
        向量<盒> 表;
        盒 元0;
        元0.值 = 5;
        结果<空类型, 整32> pa = 表.追加(元0);
        盒 读 = 表.元素(0);
        读.值 = 9;
        如果 (表.元素(0).值 == 5 && 读.值 == 9) { 校验 = 校验 + 2; }
    }
    // ③ 链式调用 中间产物读值（1784 f2 链式 274279216 错值面）
    {
        仓 仓1;
        盒 源3;
        源3.值 = 11;
        如果 (仓1.取(源3).值 == 11) { 校验 = 校验 + 4; }
    }
    // ④ 拥有局部返回=移交·实参位临时壳终结（净 0）
    {
        整64 基4 = 内存::活动分配数();
        整32 和4 = 0;
        循环 (整32 i = 0; i < 4; i += 1) {
            和4 += 消费(造盒(i));
        }
        如果 (和4 == 0 + 1 + 2 + 3 && 内存::活动分配数() - 基4 == 0) {
            校验 = 校验 + 8;
        }
    }
    // ⑤ 形参返回位副本·方法面同规
    {
        仓 仓2;
        盒 源5;
        源5.值 = 20;
        盒 副5 = 仓2.取(源5);
        副5.值 = 30;
        如果 (源5.值 == 20 && 副5.值 == 30) { 校验 = 校验 + 16; }
    }
    打印行(校验);
    返回 0;
}
