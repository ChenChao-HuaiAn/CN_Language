// 1370_双编译对照链式容器元素删除身份（2026-10-18 任务 948）：链式容器（链表/队列）
//   用户类元素『对象删除』——删单（删除头部/删除尾部）对象删除通道（LoadPtr+~T+
//   池感知释放）+ 全量析构（清空/~容器）**链游**（头索引→下一索引 游走）双编译对照。
//   病根（643 受阻真因·948 定音）：全量析构原平铺 0..元素数量-1 取 值表[i]——83-a
//   空闲链槽复用后「槽号集合 ≠ 有效元素集合」：已摘槽（含已释放元素句柄）被二次
//   析构、链上存活元素反漏析构；与删单对象删除合并=同句柄二次释放（116 实测
//   rc=0xC0000374 / free(): double free detected）。修后两侧行为一致（宿主
//   ir_oop_container.cpp emitContainerElemWalk 链游分支同构——零分叉）。
//   断言：①链表 追加3+删头+删尾+清空 析构身份序=132（E1→E3→E2）双侧一致；
//   ②队列 入队3+清空 身份序=123（链游序 E1→E2→E3）；
//   ③两形 活动分配数净差=0（元素对象壳+串字段全回收——删单壳释放补齐实证）。
导入 容器::链表;
导入 容器::队列;

静态 整64 监视 = 0;
静态 整64 累计 = 0;

类 资源 {
公开:
    整64 编号;
    字符串 名;
    函数 资源(整64 v) {
        编号 = v;
        名 = 字符串复制("元素载荷甲乙丙");
    }
    函数 资源(资源& 其他) {
        编号 = 其他.编号;
        名 = 字符串复制(其他.名);
    }
    不安全 函数 ~资源() {
        如果 (监视 == 1) {
            累计 = 累计 * 10 + 编号;
        }
    }
}

// ① 链表：追加3 + 删除头部 + 删除尾部 + 清空——身份 132 + 净差 0
不安全 函数 链形() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 序 = 0;
    {
        链表<资源> 表;
        资源 r1 = 资源(1);
        资源 r2 = 资源(2);
        资源 r3 = 资源(3);
        结果<空类型, 整32> a1 = 表.追加(r1);
        结果<空类型, 整32> a2 = 表.追加(r2);
        结果<空类型, 整32> a3 = 表.追加(r3);
        监视 = 1;
        累计 = 0;
        结果<空类型, 整32> d1 = 表.删除头部();
        结果<空类型, 整32> d2 = 表.删除尾部();
        表.清空();
        监视 = 0;
        序 = 累计;
    }
    打印("链表析构序: ", 序);
    返回 内存::活动分配数() - 前;
}

// ② 队列：入队3 + 清空——身份 123 + 净差 0
不安全 函数 队形() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 序 = 0;
    {
        队列<资源> 队;
        资源 q1 = 资源(1);
        资源 q2 = 资源(2);
        资源 q3 = 资源(3);
        结果<空类型, 整32> b1 = 队.入队(q1);
        结果<空类型, 整32> b2 = 队.入队(q2);
        结果<空类型, 整32> b3 = 队.入队(q3);
        监视 = 1;
        累计 = 0;
        队.清空();
        监视 = 0;
        序 = 累计;
    }
    打印("队列析构序: ", 序);
    返回 内存::活动分配数() - 前;
}

不安全 函数 主() -> 整32 {
    整64 链净 = 链形();
    整64 队净 = 队形();
    打印("链净差: ", 链净);
    打印("队净差: ", 队净);
    返回 0;
}
