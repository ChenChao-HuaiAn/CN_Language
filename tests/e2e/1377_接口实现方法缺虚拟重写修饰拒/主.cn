// E2E 1377_接口实现方法缺虚拟重写修饰拒（1024·1020 采样轮 H3 修复负测）：
//   接口实现三查③「须用 虚拟 或 重写 修饰」——实现方法缺两修饰词之任一即拒
//   （规格书 §5.6 接口实现三查；宿主 verifyInterfaceImpl 判据
//   !isVirtual && !isOverride=拒·文案「类 'X' 实现接口方法 'Y' 时须用 虚拟
//   或 重写 修饰」）。
//   修前 v2 侧 方法定义层是虚修饰 恒 fail-open（类节点索引登记挂收集尾=查表
//   恒 miss→兜底返回真）→ 三形态全放行 vs 宿主全拒（1024 实录）。
//   三形态：①有构造+计数体（同本类实现·定义层=自身）/②无构造/③接口两方法
//   其一 虚拟 合格·其二缺修饰（逐方法判定·防合格方法掩盖缺失方法）。
//   预期失败：双侧编译拒绝（诊断锚=须用 虚拟 或 重写 修饰·宿主逐类三诊断）。
接口 问候 {
    虚拟 函数 你好() -> 整32;
}
类 人 : 问候 {
公开:
    整32 次数;
    函数 人() { 次数 = 0; }
    函数 你好() -> 整32 {   // 形态①：缺 虚拟/重写 修饰（同本类实现）
        次数++;
        返回 次数;
    }
}
接口 回声 {
    虚拟 函数 取数() -> 整32;
}
类 盒 : 回声 {
公开:
    函数 取数() -> 整32 { 返回 7; }   // 形态②：缺 虚拟/重写 修饰（无构造）
}
接口 双向 {
    虚拟 函数 加一(整32 甲) -> 整32;
    虚拟 函数 减一(整32 甲) -> 整32;
}
类 计数 : 双向 {
公开:
    虚拟 函数 加一(整32 甲) -> 整32 { 返回 甲 + 1; }   // 合格：虚拟 修饰
    函数 减一(整32 甲) -> 整32 { 返回 甲 - 1; }        // 形态③：缺修饰（逐方法判定）
}
函数 主() -> 整32 {
    人 甲 = 人();
    盒 乙 = 盒();
    计数 丙 = 计数();
    返回 甲.你好() + 乙.取数() + 丙.加一(1) + 丙.减一(1);
}
