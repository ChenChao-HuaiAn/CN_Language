导入 容器::向量;

// 587 容器元素值传参析构（1013 批八转正·79_v2 根治·〔基准=019〕第一句）：
//   容器.元素(i) 按值传参的物化临时（含资源字段结构体）深拷与调用后清理配对。
//   修复前：物化浅壳与容器元素共享底层，调用后 975 实参清理（IR_删除对象）
//   释放共享句柄=毁源——活动分配数失恒（每轮 -1）+ 容器元素 v 对象悬垂。
//   断言三面：①循环前后活动分配数差=0（深拷 NewObject 与清理 delete 配对）
//   ②循环后容器元素 v 内容完好 ③求和正确。打印五行：0 / 100 / 7 / 5 / 157。
结构体 S {
    向量<整64> v;
    整32 n;
}

函数 吃(S 值) -> 整32 {
    如果 (值.v.大小() != 2) { 返回 1000; }
    返回 值.n + 整32(值.v.元素(0)) + 整32(值.v.元素(1));
}

函数 主() -> 整32 {
    向量<S> 容器 = 向量<S>();
    S 甲 = S{ v = 向量<整64>(), n = 42 };
    结果<空类型, 整32> 加甲1 = 甲.v.追加(100);
    如果 (!加甲1.正常) { 返回 99; }
    结果<空类型, 整32> 加甲2 = 甲.v.追加(7);
    如果 (!加甲2.正常) { 返回 99; }
    结果<空类型, 整32> 加1 = 容器.追加(甲);
    如果 (!加1.正常) { 返回 99; }
    S 乙 = S{ v = 向量<整64>(), n = 5 };
    结果<空类型, 整32> 加乙1 = 乙.v.追加(1);
    如果 (!加乙1.正常) { 返回 99; }
    结果<空类型, 整32> 加乙2 = 乙.v.追加(2);
    如果 (!加乙2.正常) { 返回 99; }
    结果<空类型, 整32> 加2 = 容器.追加(乙);
    如果 (!加2.正常) { 返回 99; }
    // ① 循环前后活动分配数差恒 0
    整64 基 = 内存::活动分配数();
    整32 总 = 0;
    整64 i = 0;
    当 (i < 容器.大小()) {
        总 = 总 + 吃(容器.元素(整32(i)));
        i = i + 1;
    }
    整64 差 = 内存::活动分配数() - 基;
    打印(差);
    // ② 循环后容器元素 v 内容完好（修复前 v 对象已被清理释放）
    打印(容器.元素(0).v.元素(0));
    打印(容器.元素(0).v.元素(1));
    // ③ 元素(1) 亦完好 + 求和正确
    打印(容器.元素(1).n);
    打印(总);
    返回 0;
}
