// 694 浮点与整浮转换面（打印浮64=六位小数格式·矩阵同款口径）
// 期望手算：浮32 1.5 + 浮64 2.25 = 3.75 → "3.750000"；7/2 整除=3；7.0/2.0=3.5
//   整64 123456789 经浮64 往返=123456789；0.1+0.2==0.3 假（二进制精度·定义行为）
//   0.1+0.2 > 0.3 真；打印(1.5)="1.500000"
函数 主() -> 整32 {
    浮32 单 = 浮32(1.5);
    浮64 双 = 2.25;
    打印(单 + 双);                 // 3.750000
    打印(7 / 2);                   // 3（整除截断）
    打印(7.0 / 2.0);               // 3.500000
    整64 大 = 123456789;
    浮64 中转 = 大;
    整64 回 = 整64(中转);
    打印(回);                      // 123456789（浮64 精确表示范围内往返）
    打印(0.1 + 0.2 == 0.3 ? 1 : 0);  // 0
    打印(0.1 + 0.2 > 0.3 ? 1 : 0);   // 1
    打印(1.5);                     // 1.500000
    返回 0;
}
