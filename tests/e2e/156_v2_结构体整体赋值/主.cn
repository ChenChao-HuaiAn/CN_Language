// 结构体整体赋值 甲 = 乙（2026-09-06 第18枚根治锚定）
// 覆盖：嵌套块作用域内结构体变量整体赋值——旧实现 IR_加载/IR_存储 单槽 8 字节
//   浅拷（24B 节点只拷首槽 类型+文本，附加 等后续字段原值残留）；根治后
//   IR_结构体拷贝 整体字节拷贝（对齐宿主/Rust POD Copy 语义）
// 形态取自 v2 编译器自身 IR生成.cn 参数收集（参数类型节点 = 参数类型候选——
//   v2self 引用参数槽们 登记全 miss 的原发点）
导入 IO;

结构体 节点 {
    整32 类型;
    整32 文本;
    整64 附加;
}

函数 试拷贝() -> 整64 {
    节点 甲;
    甲.类型 = 22;
    甲.文本 = 7;
    甲.附加 = 256;
    整64 命中 = 0;
    如果 (1 >= 0) {
        如果 (甲.类型 == 22) {
            节点 乙;
            乙.类型 = 21;
            乙.文本 = 9;
            乙.附加 = 99;
            甲 = 乙;   // 整体赋值：三字段须全部拷贝（附加 256->99、类型 22->21）
            如果 (甲.附加 == 99 && 甲.类型 == 21 && 甲.文本 == 9) {
                命中 = 1;
            }
        }
    }
    返回 命中;
}

函数 主() -> 整32 {
    整64 r = 试拷贝();
    打印("整体拷贝=", r);
    返回 0;
}
