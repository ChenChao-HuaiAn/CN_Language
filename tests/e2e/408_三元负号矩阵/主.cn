// 408 三元负号矩阵（297-a·B10 方案甲守护）：同层 ':' 配对前瞻消歧——
//   真值以一元运算开头（a ? -b : c）不再要求加括号；后缀传播（r? + 1）不回归。
函数 取值(结果<整32, 整32> r) -> 结果<整32, 整32>
{
    返回 正常(r? + 1);
}
函数 主() -> 整32
{
    布尔 c = 真;
    布尔 d = 假;
    整32 b = 2;
    整32 cc = 3;
    打印("u1=", (c ? -b : cc));
    打印("u2=", (c ? -1 : 2));
    打印("u3=", (d ? -b : cc));
    打印("u4=", (c ? !d : 真));
    打印("u5=", (c ? (d ? -1 : -2) : -3));
    结果<整32, 整32> 拿 = 取值(正常(41));
    如果 (拿.正常) { 打印("u6=", 拿.值); } 否则 { 打印("u6=错"); }
    返回 0;
}
