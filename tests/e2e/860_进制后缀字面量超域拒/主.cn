// E2E 860（2026-10-13·任务 #558 修复锁面·负例·审查 P1-1 零分叉）：进制前缀
//   与整数后缀字面量超目标域一律编译期拒——修复前 v2 整字面量入域「全数字
//   扫描遇非数字即放行」两处分叉：0x/0b/0o 前缀面见字母放行（宿主
//   decimalDigitsOf 前缀拦截后回退值级 fits 拒——8589934591 在 int64 承载内
//   超 整32 上界）、L/U 后缀面见后缀放行（宿主剥后缀文本级判域拒）；修复后
//   v2 同构补齐（前缀→进制字面量值级入域·后缀→剥后文本级判域·宿主同款
//   剥法），声明/赋值/返回三通道与负号形态全受检。
//   边界维持：超承载十六进制（>2^63-1·如 0x1FFFFFFFFFFFFFFFF）宿主 stoll
//   抛异常回 0 值级放行=v2 溢出回 0 同款同放行（诚实边界·IR 物化 0 面随
//   #547 收口·不在此锁）；带后缀/进制域内放行面由 176/177 正锚锁定。
//   双编译对照负测：宿主与 v2p 同源同拒（诊断锚=双侧同文案子串）。
函数 取乙() -> 整64 {
    返回 99999999999999999999L;    // 返回面：L 后缀 20 位超 整64 上界拒
}
函数 主() -> 整32 {
    整32 甲 = 0x1FFFFFFFF;         // 声明面：十六进制 8589934591 承载内超 整32 拒
    甲 = 0x80000000;               // 赋值面：十六进制 2147483648 超 整32 上界拒
    整8 丙 = 0b100000000;          // 声明面：二进制 256 超 整8 上界拒
    整16 丁 = 0o200000;            // 声明面：八进制 65536 超 整16 上界拒
    整32 戊 = -0x1FFFFFFFF;        // 负号形态：按负值 -8589934591 超 整32 下界拒
    正16 己 = 99999U;              // 声明面：U 后缀剥后 99999 超 正16 上界拒
    整64 庚 = 99999999999999999999L;   // 声明面：L 后缀 20 位超 整64 上界拒
    打印(甲);
    打印(庚);
    返回 0;
}
