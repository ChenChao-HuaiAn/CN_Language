// 228 双编译对照·类支持（第七十八轮，2026-09-12）——移植纪律 9 第五个对照用例。
// 形态（六项折校验和）：①带参构造+字段写+方法调用 ②自身.方法() ③容器字段操作
// ④借出→先 字符串复制 取拥有副本→改容器（借出检查不误报的合法形态）
// ⑤无参构造+循环内方法调用 ⑥字段直读。两侧各编各跑，退出码须一致=31。
导入 容器::向量;

类 账本 {
公开:
    整64 计数;
    向量<字符串> 记录;
    函数 账本(整64 初值) {
        计数 = 初值;
        记录 = 向量<字符串>();
    }
    函数 累加(整64 增量) -> 空类型 {
        计数 = 计数 + 增量;
    }
    函数 加倍() -> 整64 {
        返回 计数 * 2;
    }
    函数 组合() -> 整64 {
        返回 自身.加倍() + 计数;
    }
    函数 读数() -> 整64 {
        返回 计数;
    }
}

类 计数器 {
公开:
    整64 次数;
    函数 计数器() {
        次数 = 0;
    }
    函数 走过() -> 空类型 {
        次数 = 次数 + 1;
    }
    函数 取数() -> 整64 {
        返回 次数;
    }
}

函数 主() -> 整32 {
    整64 累 = 0;
    账本 甲 = 账本(5);
    甲.累加(3);
    如果 (甲.读数() == 8) { 累 = 累 + 1; }
    如果 (甲.组合() == 24) { 累 = 累 + 2; }
    结果<空类型, 整32> 加 = 甲.记录.追加(字符串复制("条目甲乙丙丁"));
    如果 (!加.正常) { 返回 0; }
    如果 (甲.记录.大小() == 1) { 累 = 累 + 4; }
    字符串 副本 = 字符串复制(甲.记录.元素(0));
    结果<空类型, 整32> 删 = 甲.记录.删除(0);
    如果 (!删.正常) { 返回 0; }
    如果 (字符串长度(副本) == 18) { 累 = 累 + 8; }
    计数器 乙 = 计数器();
    整64 i = 0;
    当 (i < 5) {
        乙.走过();
        i = i + 1;
    }
    如果 (乙.取数() == 5) { 累 = 累 + 16; }
    返回 整32(累);
}
