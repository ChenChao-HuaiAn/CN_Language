// E2E 560_复合赋值成员左值（任务 084·v8 采样 m86 族转正·2026-09-30）
// 覆盖：类实例字段 +=（先读旧值再算再写回——原缺陷=丢读取侧静默存右值）、
//   方法体内裸字段复合赋值、结构体字段复合赋值全算子（868/871 已修·回归
//   防护）、嵌套链 a.b.c -=。（静态字段面=561 宿主单侧——v2 静态成员=002 攻族
//   G-B 特性缺口·随其清偿后转 dual）
// 语法依据：01b 复合赋值运算符 + 06 类字段访问 + 10 静态成员
类 柜 {
公开:
    整32 存量
    函数 柜() {
        存量 = 0;
    }
    函数 置初(整32 n) -> 空类型 {
        存量 = n;
    }
    函数 加(整32 n) -> 空类型 {
        存量 += n;      // 方法体内裸字段复合赋值
    }
    函数 报存量() -> 整32 {
        返回 存量;
    }
}
结构体 计数器 {
    整32 值;
}
结构体 内芯 { 整32 分; }
结构体 外壳 { 内芯 芯; }

函数 主() -> 整32 {
    打印("===== 复合赋值成员左值（任务 084）=====");

    柜 c = 柜();
    c.置初(10);
    c.加(5);
    打印("类裸字段加后: ", c.报存量());
    c.存量 += 7;
    打印("类字段加后: ", c.报存量());

    计数器 o = 计数器{ 值 = 10 };
    o.值 += 5;
    打印("结构体加后: ", o.值);
    o.值 -= 3;
    打印("结构体减后: ", o.值);
    o.值 *= 2;
    打印("结构体乘后: ", o.值);
    o.值 /= 4;
    打印("结构体除后: ", o.值);
    o.值 %= 7;
    打印("结构体模后: ", o.值);


    外壳 壳 = 外壳{ 芯 = 内芯{ 分 = 9 } };
    壳.芯.分 -= 2;
    打印("嵌套减后: ", 壳.芯.分);

    打印("===== 完成 =====");
    返回 0;
}
