// 707_lambda引用捕获写穿（#276 波2·001「lambda 表达式」[&] 形态+spec 04-一D）
// 引用捕获 [&]：体内对捕获名的赋值经指针写回外部变量（写穿——与 698 值捕获
//   副本写相反）；后续读取（体内或体外）均见新值。
函数 主() -> 整32 {
    变量 y = 5;
    变量 改y = [&]() -> 整32 {
        y = y + 1;                    // 写穿外部
        返回 y;
    };
    打印(改y());                      // 6（自增可见）
    打印(y);                          // 6（外部被写穿·非 5）
    返回 0;
}
