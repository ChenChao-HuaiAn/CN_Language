// E2E 1736（#1966 指针目标显式判定·dual 负例）：不兼容指针实参→指针形参
//   ——犬* 实参传 猫* 形参（实例方法面）：两所指类无继承关系，宿主拒，
//   v2 修前指针目标诚实边界放行=分叉（同基/派生→基 upcast 合法面由
//   616 正测锁死不误伤）。
//   预期失败:诊断锚「无法将」(宿主/v2 双侧同文案)。
类 猫 {
公开:
    整32 甲;
    函数 猫() { 甲 = 1; }
}
类 犬 {
公开:
    整32 乙;
    函数 犬() { 乙 = 2; }
}
类 猫舍 {
公开:
    函数 收猫(猫* 目标) -> 整32 { 返回 1; }
}
函数 主() -> 整32 {
    犬 旺 = 犬();
    犬* 旺针 = 旺;
    猫舍 舍 = 猫舍();
    返回 舍.收猫(旺针);
}
