// E2E 951（dual 负测·740·2026-10-14）：「整32 表达式赋窄型变量」隐式截断
//   编译期拒绝（§3.7 隐式转换白名单封闭——窄化不在列·T36 仅字面量豁免通道；
//   宿主与 v2 零分叉红线面）。五通道同锚锁面：①赋值位 ②声明位 ③数组元素位
//   ④字段位 ⑤返回位。修前 v2 对全部通道静默截断放行 rc=0 产码（根因=
//   推导源类型ID静默 对算术/位二元恒 -1 诚实边界放行）；本轮 v2 补编译期
//   拒绝（推导二元结果类型ID·#285 同宽窄保持窄域+#481 字面量按另一侧参与·
//   宿主 commonNumericType 同构）。诊断锚=「无法将 '整32' 隐式转换为 '整8'」
//   （双侧逐字一致）。★复合赋值位（甲8 += 乙32）不在本锁面：同符号混宽
//   复合赋值放行系 #488 既定立法现状（拒面限定符号相异·828 ③④ 锁面固化
//   「存回截断」语义族）——展开等价性呈报用户裁决（740 台账行），双侧一致
//   零分叉（宿主 rc=0 ≡ v2 rc=0）。
结构体 体951 {
    整8 槽;
}
函数 出8() -> 整8 {
    整32 乙32 = 12;
    整32 丙32 = 34;
    返回 乙32 + 丙32;         // ⑤ 返回位：算术表达式源
}
函数 主() -> 整32 {
    整32 乙32 = 12;
    整32 丙32 = 34;
    整8 甲8 = 0;
    甲8 = 乙32 + 丙32;        // ① 赋值位：算术表达式源（宿主拒·v2 修前放行）
    整8 丙8 = 乙32 * 丙32;    // ② 声明位：算术表达式源
    整8[2] 组8;
    组8[0] = 乙32 - 丙32;     // ③ 数组元素位：算术表达式源
    体951 器951;
    器951.槽 = 乙32 + 1;      // ④ 字段位：窄+字面量（字面量按整32 侧参与→提升）
    返回 出8();
}
