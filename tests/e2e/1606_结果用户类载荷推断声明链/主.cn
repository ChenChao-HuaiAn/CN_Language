// E2E 1606（#1629·2026-10-28）：**推断声明接收 结果<用户类载荷> 全链**——
//   1547 形态探针实证：宿主侧推断全绿·v2 双形态拒=零分叉缺陷。
//   形态一：`变量 层 = 外.值`（外=结果$T$E 接收后·成员载荷通道）——v2 语义
//   层推导成员类型ID 对合成体载荷 miss=「推断声明初值类型未知」误拒；
//   修=推导成员类型ID 三父链形态（标识符/嵌套链/调用基座）补 结果/可选
//   载荷提取单点（归一结果名+结果可选载荷374 深度切分·宿主 visitMemberExpr
//   结果$ 分支同构）。
//   形态二：`变量 外 = 表.获取(k)`（容器方法链接收）——v2 语义层容器方法
//   返回恒整64 簿记（精确决议在 IR 内置表）→ 推断声明被推整64 → IR 层
//   外.正常 成员偏移未知中止；修=表达式类型ID 调用分支前置 查方法签名
//   精确返回（宿主 visitCall 精确返回同构）。
//   调用基座直连（造().值）双侧 1302 执法一致拒绝=执法面非缺陷面不入锚。
//   逐值锚：容器链/用户函数/双层映射 三场景 正常位+载荷字段校验。
//   双编译对照（宿主+v2p 同源码·零分叉铁律）。
导入 映射集合::映射;
结构体 点 {
    整32 x;
    整32 y;
}

函数 造() -> 结果<点, 整32> {
    点 p = 点{ x = 5, y = 6 };
    返回 正常(p);
}

函数 主() -> 整32 {
    // 形态二 A：容器方法链接收（映射<整32, 点>.获取 → 结果<点, 整32>）
    映射<整32, 点> 表 = 映射<整32, 点>();
    结果<空类型, 整32> 设位 = 表.设置(1, 点{ x = 30, y = 40 });
    如果 (!设位.正常) { 打印("设败"); }
    变量 外 = 表.获取(1);
    如果 (外.正常) {
        // 形态一 A：成员载荷推断（层=点）
        变量 层 = 外.值;
        打印(层.x);
        打印(层.y);
    } 否则 { 打印("缺外"); }
    // 形态二 B：用户函数调用接收
    变量 外乙 = 造();
    如果 (外乙.正常) {
        变量 层乙 = 外乙.值;
        打印(层乙.x);
        打印(层乙.y);
    } 否则 { 打印("缺乙"); }
    // 形态一 B（1547 场景推断化）：双层映射——外丙.值=字符串映射<整32>，
    //   再经 层丙.获取 取整32 载荷（合成体载荷=容器实例形态）
    映射<整32, 字符串映射<整32>> 双 = 映射<整32, 字符串映射<整32>>();
    字符串映射<整32> 内 = 字符串映射<整32>();
    结果<空类型, 整32> w1 = 内.设置("分", 60);
    如果 (!w1.正常) { 打印("设内败"); }
    结果<空类型, 整32> w2 = 双.设置(1, 内);
    如果 (!w2.正常) { 打印("设双败"); }
    变量 外丙 = 双.获取(1);
    如果 (外丙.正常) {
        变量 层丙 = 外丙.值;
        结果<整32, 整32> 分 = 层丙.获取("分");
        如果 (分.正常) { 打印(分.值); } 否则 { 打印("缺分"); }
    } 否则 { 打印("缺丙"); }
    返回 0;
}
