// 553（#443 呈报分叉② dual 负例·预期失败）：内置函数返回值作条件双侧同拒——
//   字符串查找/打印/字符串子串/数学::平方根 内置调用 × 如果/当/三元/循环
//   条件位；宿主「条件必须为布尔类型，实际为 'X'」族（semantic.cpp:383）·
//   v2 语义层补内置返回类型推导（补前用户签名表 miss=非布尔内置作条件放行，
//   运行输出静默错值「找到」）。
函数 主() -> 整32 {
    字符串 甲 = "abcd";
    字符串 乙 = "cd";
    如果 (字符串查找(甲, 乙)) { }                        // 预期失败：实际为 '整64'
    当 (打印("x")) { 中断; }                             // 预期失败：实际为 '空类型'
    整32 丙 = 字符串子串(甲, 0, 1) ? 1 : 2;              // 预期失败：实际为 '字符串'
    循环 (整32 i = 0; 数学::平方根(4.0); i++) { 中断; }  // 预期失败：实际为 '浮64'
    返回 0;
}
