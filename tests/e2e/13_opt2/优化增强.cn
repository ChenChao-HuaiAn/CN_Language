// Task 完善C 优化器增强 E2E 测试
// 覆盖：代数简化（x+0/x*1/x-0/x/1/x*0/x<<0）、块内CSE（相同模式复用）、
//       复写传播（Store->Load转发）、跨块DCE（不可达块删除）、
//       全局值传播（常量Store->Load安全子集）
// 说明：本用例在 -O0/-O1/-O2/-O3 下输出必须完全一致（规格书12.4 优化正确性）
// 语法依据（cn-language-spec）：表达式语句、打印（变参）/打印行、如果/否则

函数 双倍(整32 值) -> 整32 {
    返回 值 * 2;          // 代数简化：x*2 不简化（保守，避免与 x<<1 语义差异），但值*2 保持
}

函数 主() -> 整32 {
    // ---- 1. 代数简化：x+0 / x-0 / x*1 / x/1 / x*0 / x<<0 ----
    变量 x = 42;
    打印("代数简化 x+0: ");
    打印(x + 0);              // 42
    打印("代数简化 x-0: ");
    打印(x - 0);              // 42
    打印("代数简化 x*1: ");
    打印(x * 1);              // 42
    打印("代数简化 x/1: ");
    打印(x / 1);              // 42
    打印("代数简化 x*0: ");
    打印(x * 0);              // 0
    打印("代数简化 x<<0: ");
    打印(x << 0);             // 42
    打印("代数简化 0+x: ");
    打印(0 + x);              // 42（交换律）
    打印("代数简化 1*x: ");
    打印(1 * x);              // 42（交换律）

    // ---- 2. 块内CSE：相同模式复用（x+y 计算两次 -> 复用第一次结果）----
    变量 a = 3;
    变量 b = 4;
    变量 c1 = a + b;
    变量 c2 = a + b;               // CSE：与 c1 相同模式 -> 复用
    打印("CSE a+b: ");
    打印(c1);                 // 7
    打印("CSE a+b(复用): ");
    打印(c2);                 // 7

    // ---- 3. 复写传播：Store->Load 转发（同一块内，中间无其他 Store）----
    变量 源 = 100;
    变量 目标 = 源;                // 复写：目标 槽 = 源 槽的值
    打印("复写传播: ");
    打印(目标);               // 100

    // ---- 4. 跨块DCE：不可达块删除（如果-否则中恒真的分支，假分支不可达）----
    如果 (真) {
        打印("跨块DCE: 真分支存活");
    } 否则 {
        打印("跨块DCE: 假分支不可达");  // -O2 下被删除，-O0 下不执行
    }

    // ---- 5. 全局值传播：常量 Store->Load 转发（跨块安全子集）----
    变量 全 = 7;
    全 = 8;                        // 常量存储
    打印("全局传播: ");
    打印(全);                 // 8

    // ---- 6. 函数调用与代数简化协同 ----
    打印("函数双倍(21): ");
    打印(双倍(21));           // 42

    返回 0;
}
