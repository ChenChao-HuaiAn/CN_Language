// E2E 1055（#944·2026-10-17·P1 安全面）：字符串构建器句柄终态防护正测——
//   合法面零误伤（反态锚）。修法=句柄改「标记|代际|槽号」编码（不透明整64
//   契约不变）+控制块驻进程级代际槽表：完成/弃置=代际推进（旧句柄恒拒·
//   确定性失败），槽重发时代际再增——**新句柄必须照常可用**（本正测锁的
//   就是"防护不误伤复用面"）。
//   覆盖：
//   ① 内建通路（限定名直调·无需导入）：新建-追加-追加字节-完成 全链正常；
//   ② 门面通路（导入 字符串扩展::{...} 转头）：新建-追加-弃置 正常；
//   ③ 槽重发复用：1000 轮 新建-追加-完成——同槽高频重发（代际快速推进）
//     下每轮新句柄照常有效、出串长度正确（防"代际比较误杀新句柄"回归）。
//   双编译对照：宿主+v2 同源同测——输出逐行一致 + 退出码 0 一致。
导入 字符串扩展::{字符串构建器追加, 字符串构建器完成, 字符串构建器弃置};

函数 主() -> 整32 {
    // ① 内建通路：正常完成（"内建"+33='!'）
    整64 句甲 = 字符串构建器::新建();
    字符串构建器::追加(句甲, "内建");
    字符串构建器::追加字节(句甲, 33);
    字符串 甲 = 字符串构建器::完成(句甲);
    打印(甲);

    // ② 门面通路：正常弃置（错误路径中途放弃防泄漏）
    整64 句乙 = 字符串构建器新建();
    字符串构建器追加(句乙, "弃置");
    字符串构建器弃置(句乙);
    打印("弃置:正常");

    // ③ 槽重发复用：1000 轮×"段"(UTF-8 3 字节)=3000——重发通道代际零误伤
    整64 累计 = 0;
    循环 (整64 k = 0; k < 1000; k++) {
        整64 句 = 字符串构建器::新建();
        字符串构建器::追加(句, "段");
        字符串 出 = 字符串构建器::完成(句);
        累计 = 累计 + 字符串长度(出);
    }
    打印("复用累计=", 整数转字符串(累计));
    返回 0;
}
