// E2E 198（宿主负测，2026-09-10 第五十八轮 plans/019 阶段2 · 编译期安全）：
//   引用/指针逃逸检查强化——局部地址流入更长寿命存储=编译期拒绝。六负形态：
//   ①静态变量持局部地址 ②静态指针对象字段持局部地址 ③指针返回直接 &局部
//   ④指针返回「指向局部的局部指针」（p=&x; 返回 p）⑤引用局部（绑局部）值
//   流入静态。合法形态（局部指针= &局部/局部对象字段/局部数组元素/引用局部
//   读写传参）零误伤由单测与 196 回归锚定；静态数组元素位与静态变量同族
//   （单测锚定）。
//   期望编译失败.txt 固化诊断子串「局部变量的地址」。
静态 整64* 槽 = 无;
静态 整64* 槽2 = 无;
结构体 节点 {
    整64* 下一个;
}
静态 节点* 头指针 = 无;

函数 坏1() -> 整32 {
    整64 x = 5;
    槽 = &x;
    返回 0;
}
函数 坏2() -> 整32 {
    整64 x = 5;
    头指针.下一个 = &x;
    返回 0;
}
函数 坏3() -> 整64* {
    整64 x = 5;
    返回 &x;
}
函数 坏4() -> 整64* {
    整64 x = 5;
    整64* p = &x;
    返回 p;
}
函数 坏5() -> 整64& {
    整64 x = 5;
    整64& r = x;
    返回 r;
}
函数 主() -> 整32 {
    返回 0;
}
