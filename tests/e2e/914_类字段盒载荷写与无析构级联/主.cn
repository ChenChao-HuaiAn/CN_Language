// E2E 914（2026-10-14·#658 双侧清偿锁面·dual）：**成员链左值=类对象×合成体
//   字段整体写** + **无析构类字段级联释放** 两残余面（571 轮落台账 658 清偿）。
//   背景：①v2 成员链左值盒载荷写原落「标量宽度通道 8B 写临时槽基址」（asm
//   铁证 mov [甲+24], 临时槽地址）——读链 LoadPtr 双跳侥幸自洽（值对）但字段
//   槽存栈临时地址=悬垂+出口级联释放读 tag 垃圾→载荷泄漏（904 形二三 56≠120
//   实锤）。修=尝试成员合成体整体写（preFree 202-a 单点+IR_结构体拷贝全布局
//   +place 源 __cn_box_field_str_copy 在位深拷·对齐宿主 974）+读侧字段=合成体
//   压字段地址（内联 place 链）+布局可选字段 16B 归一（IR布局 类型大小与对齐）。
//   ②无析构类字段级联缺（宿主同病 差=1）：宿主 emitNoDtorFieldCascade（出口
//   RAII 判空守卫块+返回块终止转移）·v2 合成沿链析构体条件放开+RAII 名单
//   全量化+发射资源字段释放于地址 用户类分支递归（C++ 隐式析构完整语义：
//   无用户析构器≠字段不析构；有析构类不重复注入=勿双释放幂等判据）。
//   分行断言（任一形态分叉即值变化）：
//     形一=成员链左值 结果<字符串,整32> 载荷 错误→正常→错误 重写+分配数归零
//          （8+16+32+64=120·对齐 904 形二三 v2 面）
//     形二=成员链左值 可选<字符串> 字段 某些/覆盖重写/place 源深拷独立/整盒
//          读（局部 = 甲.名称）+分配数归零（1+2+4+8+16+32=63）
//     形三=无析构类 字符串字段出口级联（块出口+return 路径双形态）+嵌套无析构
//          类字段递归（4+8+16+32=60）
//     形四=有析构类对照（用户析构体已级联·出口不双释放→分配数归零=64）
类 资源 {
公开:
    整32 编号;
    可选<字符串> 名称;
    结果<字符串, 整32> 载荷;
    函数 资源(整32 n) { 编号 = n; }
    函数 ~资源() { }
}

类 无析构 {
公开:
    字符串 名;
    函数 无析构() { }
}

类 无析构外壳 {
公开:
    无析构 内件;
    函数 无析构外壳() { }
}

函数 形一() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        资源 甲 = 资源(1);
        甲.载荷 = 错误(7);
        如果 (!甲.载荷.正常) {
            如果 (甲.载荷.错误 == 7) { 校验 = 校验 + 8; }
        }
        甲.载荷 = 正常(字符串复制("修复后正常载荷"));
        如果 甲.载荷.正常 {
            如果 (字符串比较(甲.载荷.值, "修复后正常载荷")) { 校验 = 校验 + 16; }
        }
        甲.载荷 = 错误(9);
        如果 (!甲.载荷.正常) {
            如果 (甲.载荷.错误 == 9) { 校验 = 校验 + 32; }
        }
    }
    如果 (内存::活动分配数() == 前) { 校验 = 校验 + 64; }
    返回 校验;
}

函数 形二() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        资源 甲 = 资源(2);
        甲.名称 = 某些("第一次写入");
        如果 甲.名称.有值 {
            如果 (字符串比较(甲.名称.值, "第一次写入")) { 校验 = 校验 + 1; }
        }
        甲.名称 = 某些("第二次覆盖");
        如果 甲.名称.有值 {
            如果 (字符串比较(甲.名称.值, "第二次覆盖")) { 校验 = 校验 + 2; }
        }
        可选<字符串> 局部 = 某些("局部来源载荷");
        甲.名称 = 局部;
        如果 甲.名称.有值 {
            如果 (字符串比较(甲.名称.值, "局部来源载荷")) { 校验 = 校验 + 4; }
        }
        如果 局部.有值 {
            如果 (字符串比较(局部.值, "局部来源载荷")) { 校验 = 校验 + 8; }
        }
        可选<字符串> 整盒 = 甲.名称;
        如果 整盒.有值 {
            如果 (字符串比较(整盒.值, "局部来源载荷")) { 校验 = 校验 + 16; }
        }
    }
    如果 (内存::活动分配数() == 前) { 校验 = 校验 + 32; }
    返回 校验;
}

函数 形三() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        无析构 乙 = 无析构();
        乙.名 = 字符串复制("堆上字符串");
        如果 (字符串比较(乙.名, "堆上字符串")) { 校验 = 校验 + 4; }
    }
    如果 (内存::活动分配数() == 前) { 校验 = 校验 + 8; }
    {
        无析构外壳 丙 = 无析构外壳();
        丙.内件.名 = 字符串复制("嵌套字段串");
        如果 (字符串比较(丙.内件.名, "嵌套字段串")) { 校验 = 校验 + 16; }
    }
    如果 (内存::活动分配数() == 前) { 校验 = 校验 + 32; }
    返回 校验;
}

函数 形四() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        资源 丁 = 资源(4);
        丁.名称 = 某些("有析构对照");
        如果 丁.名称.有值 {
            如果 (字符串比较(丁.名称.值, "有析构对照")) { 校验 = 校验 + 1; }
        }
        丁.名称 = 某些("覆盖重写");
        如果 丁.名称.有值 {
            如果 (字符串比较(丁.名称.值, "覆盖重写")) { 校验 = 校验 + 2; }
        }
    }
    如果 (内存::活动分配数() == 前) { 校验 = 校验 + 64; }
    返回 校验;
}

函数 主() -> 整32 {
    打印("形一=", 形一(), " 形二=", 形二(), " 形三=", 形三(), " 形四=", 形四());
    返回 0;
}
