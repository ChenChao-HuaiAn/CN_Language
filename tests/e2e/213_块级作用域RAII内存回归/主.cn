// E2E 213（2026-09-11 第七十二轮下半程收尾，72-a 探针转正·内存安全回归）：
//   宿主块级作用域 RAII（用户裁决方案A）的运行级回归锚定——原 探针66 六形态
//   （循环体字符串/循环体容器/如果体/裸块/循环内嵌套块/循环内中断）+ 本轮
//   收尾补强两形态：
//     ⑦ 选择体中断：选择分支不走 genBlock（语句直接生成，无块出口析构）——
//        中断 跳出前按分支基线发射 drop-on-jump，与循环口径对齐；
//     ⑧ 类方法返回路径：emitClassMethod 原为三类函数级生成单元中独漏函数级
//        兜底者——方法体内声明拥有串后中途 返回 绕过块出口析构=泄漏
//        （探针 87 修复前实证残留 1），补 genStringFrees/genClassDestructorCalls。
//   断言口径：每形态调用前后 内存::活动分配数() 差值（残留）恒为 0——
//   「某轮 AI 记得写探针」就此转为「门禁替你记得」。
导入 容器::向量;
导入 IO::打印;

类 工具 {
公开:
    整64 编号;
    函数 工具() { 编号 = 0; }
    // 方法体内声明拥有串后返回其他值——返回路径须经函数级兜底释放
    函数 制造(整32 n) -> 整32 {
        字符串 临时 = 字符串复制("类方法局部串占位内容");
        如果 (n > 0) {
            返回 n;
        }
        返回 0;
    }
}

函数 循环体字符串(整32 轮数) -> 空类型 {
    整32 i = 0;
    当 (i < 轮数) {
        字符串 每轮 = 字符串复制("循环体字符串占位内容");
        i++;
    }
}

函数 循环体容器(整32 轮数) -> 空类型 {
    整32 i = 0;
    当 (i < 轮数) {
        向量<整64> 表 = 向量<整64>();
        结果<空类型, 整32> 加 = 表.追加(i);
        i++;
    }
}

函数 如果体字符串(布尔 进入) -> 空类型 {
    如果 (进入) {
        字符串 体内 = 字符串复制("如果体内字符串");
        打印("  如果体长度:", 字符串长度(体内));
    } 否则 {
        字符串 否则内 = 字符串复制("否则体内字符串");
        打印("  否则长度:", 字符串长度(否则内));
    }
}

函数 裸块字符串() -> 空类型 {
    {
        字符串 裸块内 = 字符串复制("裸块内字符串");
        打印("  裸块长度:", 字符串长度(裸块内));
    }
}

函数 循环体嵌套(整32 轮数) -> 空类型 {
    整32 i = 0;
    当 (i < 轮数) {
        {
            字符串 深块 = 字符串复制("循环内再嵌套块");
            i++;
        }
    }
}

函数 循环内中断(整32 轮数) -> 空类型 {
    整32 i = 0;
    当 (i < 轮数) {
        字符串 中断前 = 字符串复制("中断路径字符串");
        如果 (i >= 1) { 中断; }
        i++;
    }
}

函数 选择体中断() -> 空类型 {
    选择 (1) {
        情况 1:
            字符串 分支串 = 字符串复制("选择分支串占位");
            打印("  分支长度:", 字符串长度(分支串));
            中断;
    }
}

函数 主() -> 整32 {
    整64 b = 内存::活动分配数();
    循环体字符串(4);
    打印("① 循环体字符串(4轮) 残留:", 内存::活动分配数() - b);
    整64 c = 内存::活动分配数();
    循环体容器(4);
    打印("② 循环体容器(4轮) 残留:", 内存::活动分配数() - c);
    整64 d = 内存::活动分配数();
    如果体字符串(真);
    打印("③ 如果体字符串 残留:", 内存::活动分配数() - d);
    整64 e = 内存::活动分配数();
    裸块字符串();
    打印("④ 裸块字符串 残留:", 内存::活动分配数() - e);
    整64 f = 内存::活动分配数();
    循环体嵌套(4);
    打印("⑤ 循环内嵌套块(4轮) 残留:", 内存::活动分配数() - f);
    整64 g = 内存::活动分配数();
    循环内中断(4);
    打印("⑥ 循环内中断路径 残留:", 内存::活动分配数() - g);
    整64 h = 内存::活动分配数();
    选择体中断();
    打印("⑦ 选择体中断路径 残留:", 内存::活动分配数() - h);
    整64 k = 内存::活动分配数();
    {
        工具 t = 工具();
        整32 r = t.制造(7);
        打印("  制造返回:", r);
    }
    打印("⑧ 类方法返回路径 残留:", 内存::活动分配数() - k);
    返回 0;
}
