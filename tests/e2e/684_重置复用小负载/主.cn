// E2E 684_重置复用小负载（#365/#379 清偿轮·2026-10-10）：锁「重置复用+循环内
//   构造」小负载健康面——修复前 365 立项=同树成功解析后走失败路径 SIGSEGV、
//   379=循环内重建第二轮数组越界（大负载 33KB）·当前链实测两形态小负载全绿
//   （365 记错链=363 中间跳剥星+351 写侧剥星顺治）。
//   〔379 回改锁面 2026-10-16〕形态四=**堆串**大文档（字符串连接拼 ≈33KB）+
//   循环内重建三轮（b4 回改验收条款同构）——清偿=396（e25dfa094）：宿主类字符串
//   字段写漏借用归一化→解析器 源 字段析构级联 free 调用方文档串=UAF。关键=文档
//   必须是堆串（连接产生·真 free 面）；字面量实参=静态地址池外（cn_free_tracked
//   忽略）=396 侥幸绿机制（形态一~三用字面量故当年假健康全绿）。
//   〔面注〕大负载（b4 33KB）重置复用第二轮语法错=**385 回归**（83e935d8
//   ①段剥星过宽捕获容器/字符串指针形态·bench 目录不进 E2E 门禁漏网·
//   已立案移交引入者）——385 修复后本用例扩大负载断言。v2 侧同形态链接缺
//   拷贝构造符号=#381 同族·恢复 dual 双挂 381/385。
导入 JSON::{JSON树, 解析JSON, 重置JSON树, JSONE_好};
函数 主() -> 整32 {
    // 形态一：同树 成功→失败→成功（365 立项形态·小负载）
    JSON树 树 = JSON树();
    解析JSON(树, "[1,2]");
    打印(树.错误码);
    解析JSON(树, "[1,2");
    打印(树.错误码);
    解析JSON(树, "[3]");
    打印(树.错误码);
    // 形态二：重置复用三轮（b4 规避形·小负载）
    解析JSON(树, "[4,5]");
    重置JSON树(树);
    解析JSON(树, "[6]");
    打印(树.错误码);
    // 形态三：循环内重建三轮（379 形态·小负载）
    循环 (整64 r = 0; r < 3; r = r + 1) {
        JSON树 树2 = JSON树();
        解析JSON(树2, "[7,8,9]");
        打印(树2.错误码);
    }
    // 形态四：堆串大文档循环内重建三轮（379 回改验收·b4 33KB 同构——文档由
    //   字符串连接产生=堆串真释放面；字面量属静态池外侥幸绿面故必须拼接形态）
    字符串 片 = "{\"键甲\":[true,null,-123456,\"子子子\"],\"键乙\":\"己庚\"},";
    字符串 大文档 = "[";
    循环 (整64 k = 0; k < 600; k = k + 1) {
        大文档 = 字符串连接(大文档, 片);
    }
    大文档 = 字符串连接(大文档, "null]");
    打印(字符串长度(大文档));
    循环 (整64 r = 0; r < 3; r = r + 1) {
        JSON树 树3 = JSON树();
        解析JSON(树3, 大文档);
        打印(树3.错误码);
    }
    返回 0;
}
