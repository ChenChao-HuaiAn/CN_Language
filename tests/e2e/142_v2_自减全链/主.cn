// E2E 142_v2_自减全链（簇③根治·C1，2026-09-04 用户裁决「全链补自减」）：
//   词法双字符表原独缺 --（++/+=/-=/-> 齐）——i-- 切双 - 与下行粘连成
//   i - (-X) = ... 非左值赋值/吞声明（语法分析.cn 冒烟簇③ 11 错同根因；规范
//   03:44/61 语句级 --i; 明文合法、宿主已支持 E2E 134 q.y--）。本轮四层：
//   词法 -- / 语法 节点_自减=35 前后缀 / 语义常量+未声明拒绝（与自增对称）/
//   IR 发射自增自减 共享函数（局部/参数/引用写回/静态四路径，IR_减 1）。
//   v2p 尾部自检（主.expected 固化）：常量自减负测 / 未声明自减负测。
// 闭环：v2p 编译 -> as/g++ 宿主运行时 -> 运行。退出码=0 全过；11~15 失败码。
静态 整64 静态计数 = 10

函数 借减(整64& x) -> 空类型 {
    x--
}

函数 主() -> 整32 {
    // ===== 一、后缀/前缀（v2 语句级同语义：减 1）=====
    整64 a = 5
    a--
    --a
    如果 (a != 3) { 返回 11 }

    // ===== 二、引用参数经指针写回调用方槽（②c D 同款路径）=====
    整64 b = 100
    b--
    借减(b)
    如果 (b != 98) { 返回 12 }

    // ===== 三、静态槽（IR_静态加载/减/静态存储——第六波静态自增对称）=====
    静态计数--
    如果 (静态计数 != 9) { 返回 13 }

    // ===== 四、循环递减（IR签名.cn:517 i-- 同款核心形态——原粘连吞声明的现场）=====
    整64 i = 3
    当 (i > 0) {
        i--
        整64 残留 = i      // 声明紧随自减（簇③「吞声明」形态回归锚点）
    }
    如果 (i != 0) { 返回 14 }

    // ===== 五、自减后拼接表达式（IR签名.cn 泛深-- 后接拼接赋值的现场形态）=====
    字符串 类型文本 = ""
    整64 泛深 = 2
    泛深--
    类型文本 = 类型文本 + ">"
    如果 (泛深 != 1) { 返回 15 }

    // 运行时人眼审计锚点（stdout）
    打印("[142] 自减全链: a=", a, " b=", b, " 静态=", 静态计数, " 泛深=", 泛深)
    返回 0
}
