// E2E 799_单目非构造调用临时对象（#465 根治锁用例）：构造调用临时对象直施单目!
//   与「先存变量再 !」必须等价（92_单目重载 语义基准：运算符! 返回 值==0）。
//   缺陷实录：!温度(0) 曾对临时对象指针发射内置逻辑非（指针非零恒假=输出 假），
//   而 !t 走重载输出 真——根因=宿主 exprSrcType 缺构造调用/UnaryExpr 类型分支
//   （ir_oop.cpp·436 同族「表达式位类型推导缺分支→下游分派 miss」）、v2
//   解析调用返回结构体 缺构造调用分支（IR生成类型.cn·零分叉双侧同修）。
类 温度 {
公开:
    整32 值;

    函数 温度(整32 v) {
        值 = v;
    }

    // 单目取反重载（P2-14·0 右参，左操作数=this）：返回"是否零度"（值 == 0）
    函数 运算符!() -> 布尔 {
        返回 值 == 0;
    }
}

函数 主() -> 整32 {
    // 形态①：构造调用临时对象直施单目 !（实参 0 -> 值==0 -> 真）
    打印(!温度(0));
    // 形态②：先存变量再 !（对照——语义必须与形态①一致）
    温度 t = 温度(0);
    打印(!t);
    // 形态③：构造调用实参非零（值==23 -> 运算符! 得 假）
    打印(!温度(23));
    返回 0;
}
