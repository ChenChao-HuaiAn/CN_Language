// 1678：字符串比较 返回 布尔——布尔上下文放行+布尔变量接收（#1900 对齐锁面·正例）
// 三态锁面：①如果 条件布尔上下文双侧放行 ②返回值赋 布尔 变量双侧一致
//   ③真=相等语义输出一致（001 §字符串比较 等价 a == b 内容比较·布尔通道）。
//   同族非本族面（字符串字典序/字符串查找/字符串长度=整64 族）不在本锁面。
函数 主() -> 整32 {
    字符串 a = "同";
    字符串 b = "同";
    布尔 同 = 字符串比较(a, b);
    打印(同);
    如果 同 {
        打印("相等");
    }
    如果 字符串比较(a, "异") {
        打印("不该出现");
    }
    如果 !同 {
        打印("也不该出现");
    }
    打印("完成");
    返回 0;
}
