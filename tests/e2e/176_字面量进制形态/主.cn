// 176_字面量进制形态：整数字面量位模式全形态锚定（2026-09-09 第四十二轮 单位机，
// 第四十一轮 字面量位模式 共用层根治的自身源码之外探针——lessons 权重10：
// 「凡编译器支持的语法必须有自身源码之外的探针锚定后端发射」）。
// 覆盖：0x/0b/0o 进制前缀 + L/U 类型后缀 + 超 imm32 域十进制 + 2^63-1 边界 +
// 负常量补码。原 arm64/X64L 本地解析只认十进制（0x 前缀静默解析为 0 潜伏缺陷）。
// 断言双保险：打印（末尾换行）逐行比对 + 全部相等判定通过返回 0。
函数 主() -> 整32 {
    整64 甲 = 0xFF;                // 255
    整64 乙 = 0b1010;              // 10
    整64 丙 = 0o777;               // 511
    整64 丁 = 42L;                 // 42
    整64 戊 = 7U;                  // 7
    整64 己 = 36028797018963968;   // 2^55（超 imm32 域十进制）
    整64 庚 = 0x7FFFFFFFFFFFFFFF;  // 2^63-1（int64 正上界）
    整64 辛 = -255;                // 负常量（补码 neg 路径）
    打印(甲);
    打印(乙);
    打印(丙);
    打印(丁);
    打印(戊);
    打印(己);
    打印(庚);
    打印(辛);
    如果 (甲 == 255 && 乙 == 10 && 丙 == 511 && 丁 == 42 && 戊 == 7) {
        如果 (己 == 36028797018963968 && 庚 == 9223372036854775807 && 辛 == 0 - 255) {
            返回 0;
        }
    }
    返回 1;
}
