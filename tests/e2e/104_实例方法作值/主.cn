// E2E 104_实例方法作值（P3-23 收尾）：实例方法绑定 this 作值（D1 闭包变量调用）
// 覆盖：自动 cb = 对象.方法; cb(实参) 可用；对象状态修改后引用捕获读最新；多对象独立。
类 计数器 {
公开:
    整32 基数;
    函数 计数器(整32 b) { 基数 = b; }
    函数 双倍(整32 x) -> 整32 { 返回 基数 + x; }
}
函数 主() -> 整32 {
    打印("===== 实例方法作值（P3-23）=====");
    计数器 对象 = 计数器(100);
    自动 cb = 对象.双倍;
    打印("cb(5): ", cb(5));        // 105
    对象.基数 = 200;
    打印("改态后: ", cb(5));       // 205（引用捕获读最新 this）
    计数器 对象2 = 计数器(7);
    自动 cb2 = 对象2.双倍;
    打印("另一对象: ", cb2(3));    // 10
    打印("===== 完成 =====");
    返回 0;
}
