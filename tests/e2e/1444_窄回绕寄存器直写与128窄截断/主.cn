// E2E 1444（1281 集成审查 P2-1/P2-2）：窄型回绕算术**直写分配寄存器**形态与
//   i128→窄 Cast 全链路（001 §3.7a）——-O2 寄存器分配开启，形参/运行时种子驱动
//   （防常量折叠/内联折叠），覆盖：
//   ① i8/u8/i16/u16 × 回绕加/减/乘：结果 vreg 直连比较，x64 直写路径必须在
//      落位前 movsx/movzx（1439 只锁 -O0 槽路径；本用例锁 -O2 寄存器路径）。
//   ② 窄型移位 i8/u8：结果按类型位宽截断。
//   ③ i128→i8/u8/i16 Cast：槽/寄存器目标均按声明窄宽规范化（P2-3：槽目标
//      原 `mov eax, eax` 空指令已删，指令计数不含该空写）。
//   传参用窄变量（非 cast 实参），v2 结果码推导=窄域，与宿主同源同测。
//   位权 1..65536：十七形态全过=131071（任一失败即定位到具体位）。
//   双编译对照：宿主与 v2 同源同测，输出/退出码逐行一致。
导入 系统::参数个数;

函数 测加8(整8 甲, 整8 乙) -> 布尔 {
    返回 回绕加(甲, 乙) == 整8(-56);
}
函数 测减8(整8 甲, 整8 乙) -> 布尔 {
    返回 回绕减(甲, 乙) == 整8(127);
}
函数 测乘8(整8 甲, 整8 乙) -> 布尔 {
    返回 回绕乘(甲, 乙) == 整8(-56);
}
函数 测加U8(正8 甲, 正8 乙) -> 布尔 {
    返回 回绕加(甲, 乙) == 正8(0);
}
函数 测减U8(正8 甲, 正8 乙) -> 布尔 {
    返回 回绕减(甲, 乙) == 正8(255);
}
函数 测乘U8(正8 甲, 正8 乙) -> 布尔 {
    返回 回绕乘(甲, 乙) == 正8(144);
}
函数 测加16(整16 甲, 整16 乙) -> 布尔 {
    返回 回绕加(甲, 乙) == 整16(-5536);
}
函数 测减16(整16 甲, 整16 乙) -> 布尔 {
    返回 回绕减(甲, 乙) == 整16(32767);
}
函数 测乘16(整16 甲, 整16 乙) -> 布尔 {
    返回 回绕乘(甲, 乙) == 整16(24464);
}
函数 测加U16(正16 甲, 正16 乙) -> 布尔 {
    返回 回绕加(甲, 乙) == 正16(0);
}
函数 测减U16(正16 甲, 正16 乙) -> 布尔 {
    返回 回绕减(甲, 乙) == 正16(65535);
}
函数 测乘U16(正16 甲, 正16 乙) -> 布尔 {
    返回 回绕乘(甲, 乙) == 正16(54464);
}
函数 测移U8(正8 甲, 正8 乙) -> 布尔 {
    返回 (甲 << 乙) == 正8(144);
}
函数 测移8(整8 甲, 整8 乙) -> 布尔 {
    返回 (甲 << 乙) == 整8(56);
}

函数 主() -> 整32 {
    // 运行时种子（参数个数≥1）——所有实参由它派生，编译期不可折叠
    整32 种子 = 参数个数();
    整32 校验 = 0;
    // ---- i8 直写寄存器形态 ----
    整8 甲 = 整8(100 + 种子 - 1);
    整8 乙 = 整8(100 + 种子 - 1);
    如果 (测加8(甲, 乙)) { 校验 = 校验 + 1; }
    整8 丙 = 整8(-128 + 种子 - 1);
    整8 丁 = 整8(种子);
    如果 (测减8(丙, 丁)) { 校验 = 校验 + 2; }
    整8 戊 = 整8(100 + 种子 - 1);
    整8 己 = 整8(2 + 种子 - 1);
    如果 (测乘8(戊, 己)) { 校验 = 校验 + 4; }
    // ---- u8 ----
    正8 庚 = 正8(255 + 种子 - 1);
    正8 辛 = 正8(种子);
    如果 (测加U8(庚, 辛)) { 校验 = 校验 + 8; }
    正8 壬 = 正8(种子 - 1);
    正8 癸 = 正8(种子);
    如果 (测减U8(壬, 癸)) { 校验 = 校验 + 16; }
    正8 子 = 正8(200 + 种子 - 1);
    正8 丑 = 正8(2 + 种子 - 1);
    如果 (测乘U8(子, 丑)) { 校验 = 校验 + 32; }
    // ---- i16 ----
    整16 寅 = 整16(30000 + 种子 - 1);
    整16 卯 = 整16(30000 + 种子 - 1);
    如果 (测加16(寅, 卯)) { 校验 = 校验 + 64; }
    整16 辰 = 整16(-32768 + 种子 - 1);
    整16 巳 = 整16(种子);
    如果 (测减16(辰, 巳)) { 校验 = 校验 + 128; }
    整16 午 = 整16(300 + 种子 - 1);
    整16 未 = 整16(300 + 种子 - 1);
    如果 (测乘16(午, 未)) { 校验 = 校验 + 256; }
    // ---- u16 ----
    正16 申 = 正16(65535 + 种子 - 1);
    正16 酉 = 正16(种子);
    如果 (测加U16(申, 酉)) { 校验 = 校验 + 512; }
    正16 戌 = 正16(种子 - 1);
    正16 亥 = 正16(种子);
    如果 (测减U16(戌, 亥)) { 校验 = 校验 + 1024; }
    正16 天一 = 正16(60000 + 种子 - 1);
    正16 天二 = 正16(2 + 种子 - 1);
    如果 (测乘U16(天一, 天二)) { 校验 = 校验 + 2048; }
    // ---- 窄移位 ----
    正8 天三 = 正8(200 + 种子 - 1);
    正8 天四 = 正8(种子);
    如果 (测移U8(天三, 天四)) { 校验 = 校验 + 4096; }
    整8 天五 = 整8(-100 + 种子 - 1);
    整8 天六 = 整8(种子);
    如果 (测移8(天五, 天六)) { 校验 = 校验 + 8192; }
    // ---- i128 -> 窄 Cast（变量源防折叠）----
    整128 大 = 整128(种子) + 510;      // 511
    整32 位 = 0;
    如果 (整8(大) == 整8(-1)) { 位 = 位 + 16384; }
    如果 (正8(大) == 正8(255)) { 位 = 位 + 32768; }
    如果 (整16(大) == 整16(511)) { 位 = 位 + 65536; }
    校验 = 校验 + 位;
    打印(校验);
    返回 0;
}
