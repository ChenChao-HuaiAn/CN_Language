// 642（#283 收口锚）：无构造类实例化=类类型字段级联默认构造（001 §3.9 甲案）
//   v14 采样 p1007_02 根治：原「仅分配」容器字段悬空→运行期错码3；级联后免手工构造
导入 容器::向量;
类 收集器 {
    向量<整32> 数据;
公开:
    函数 加入(整32 v) {
        结果<空类型, 整32> r = 数据.追加(v);
    }
    常量 函数 计数() -> 整64 { 返回 数据.大小(); }
}
函数 主() -> 整32 {
    收集器 c = 收集器();
    c.加入(10);
    c.加入(20);
    打印("计数=", c.计数());
    返回 0;
}
