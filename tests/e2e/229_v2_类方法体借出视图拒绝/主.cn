导入 容器::向量;

类 货架 {
公开:
    向量<字符串> 表;
    函数 货架() {
        表 = 向量<字符串>();
    }
    函数 装(字符串 值) -> 空类型 {
        结果<空类型, 整32> 加 = 表.追加(值);
        如果 (!加.正常) { 运行时错误(4); }
    }
    函数 坏方法() -> 整32 {
        字符串 借出 = 表.元素(0);
        结果<空类型, 整32> 删 = 表.删除(0);
        如果 (!删.正常) { 返回 0; }
        返回 整32(字符串长度(借出));
    }
}

函数 主() -> 整32 {
    货架 架 = 货架();
    架.装(字符串复制("元素内容甲乙丙丁"));
    返回 架.坏方法();
}
