// 452 泛型实例矩阵（416-a D42 甲案波 2 防线·双编译对照）
// 覆盖：双实例独立（同基类不同实参 互不串槽）/带 T 实参构造/方法调用改字段/
//       T 返回传递/实例计数累加（字段读写全链）
// 退出码校验和 = a.取()(3) + b.取()(20) + a.计数()(2)*100 + b.计数()(1) = 224
泛型 <类型 T>
类 盒子 {
私有:
    T 数据;
    整64 元素数量;
公开:
    不安全 函数 盒子() {
        数据 = 0;
        元素数量 = 0;
    }
    函数 放(T 值) {
        数据 = 值;
        元素数量 = 元素数量 + 1;
    }
    常量 函数 取() -> T {
        返回 数据;
    }
    常量 函数 计数() -> 整64 {
        返回 元素数量;
    }
}

函数 主() -> 整32 {
    盒子<整32> a;
    盒子<整64> b;
    a.放(10);
    b.放(20);
    a.放(3);
    返回 整32(a.取()) + 整32(b.取()) + 整32(a.计数()) * 100 + 整32(b.计数());
}
