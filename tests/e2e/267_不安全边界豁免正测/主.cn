// E2E 267（双编译对照，2026-09-17 第一百五十七轮 157-a）：安全区边界豁免正测
//   ——不安全 函数 内全形态裸操作合法（零诊断）+ 静态变量写在其中合法；
//   收口防过度（不误杀合法不安全函数体）；宿主/v2 两侧退出码一致。
静态 整64 计数 = 0;
不安全 函数 裸写(整64* p) -> 整64 {
    整64* q = p + 1;        // A1 指针算术（不安全函数内合法）
    *q = 7;                 // B7 裸指针解引用写
    q[0] = 9;               // A2 指针下标写
    返回 *q;                // B6 裸指针解引用读
}
不安全 函数 主() -> 整32 {
    整64[2] 基 = { 0, 0 };
    整64 v = 裸写(基);       // 互调（责任上移）
    打印(v);
    计数 = 计数 + 1;         // B10 静态变量写（不安全函数内合法）
    打印(计数);
    返回 0;
}
