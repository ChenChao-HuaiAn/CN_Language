// 1505 循环累积泛型实例引用逃逸（750 复审 P0-A-5·双编译对照）
//   病：泛型实例（克隆类/克隆函数）不在源码区间——模板体内调用的引用实参根名
//   表项索引停留在模板位置，克隆体方法体生成时查表 miss → 引用实参逃逸漏登。
//   修：IR类尾 三个克隆点（主循环/延迟组合/嵌套）按偏移把根名表项重映射到
//   克隆体索引（与 登记克隆体128位形参 同点）；实例调用点接收者类型=实例名
//   （方法节点 miss）由 P0-A-4 保守登记兜底——两层覆盖。
// 预期：S=xZxZ。
结构体 盒 {
    字符串* 指;
}

泛型 <类型 T>
类 仓 {
公开:
    函数 仓() { }
    函数 装(盒& 槽, T& 参) -> 整32 {
        槽.指 = &参;
        返回 0;
    }
}

不安全 函数 写改(盒& 目标, 字符串 段) -> 整32 {
    *目标.指 = *目标.指 + 段;
    返回 0;
}

不安全 函数 主() -> 整32 {
    字符串 s = "";
    盒 槽 = 盒{ 指 = 无 };
    仓<字符串> 仓1 = 仓<字符串>();
    仓1.装(槽, s);
    循环 (整64 k = 0; k < 2; k++) {
        s = s + "x";
        写改(槽, "Z");
    }
    打印("S=", s);
    返回 0;
}
