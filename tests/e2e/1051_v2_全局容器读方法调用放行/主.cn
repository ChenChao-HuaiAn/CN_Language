// E2E 1051（916 轮·001 §747-8 通用全局写执法·正测对照面·与 1050 成对）：
//   全局容器「读方法调用」不误拦（白名单读面：大小/容量/为空/元素/读取/获取/
//   包含）+ 不安全 函数内「写方法调用」合法（豁免面）——同一源码宿主+v2p
//   各编各跑，退出码与运行输出双侧一致（AGENTS §4 双测铁律）。
//   读面累加：大小1+元素6+读取6+获取2+包含1=16。
导入 容器::向量;
导入 映射集合;

向量<整32> 全局向量;            // 裸全局容器（读方法调用面）
映射<整64, 整64> 全局映射;     // 裸全局映射（读方法调用面）
集合<整64> 全局集合;           // 裸全局集合（读方法调用面）

不安全 函数 造数据() {          // 写方法调用（不安全 函数内=合法豁免面）
    结果<空类型, 整32> a = 全局向量.追加(6);
    如果 (!a.正常) { 返回; }
    结果<空类型, 整32> b = 全局映射.设置(1, 2);
    如果 (!b.正常) { 返回; }
    结果<空类型, 整32> c = 全局集合.添加(3);
}

函数 读面() -> 整32 {
    整64 大小值 = 全局向量.大小();
    整64 容量值 = 全局向量.容量();
    布尔 空值 = 全局向量.为空();
    整32 元素值 = 全局向量.元素(0);
    结果<整32, 整32> 读取值 = 全局向量.读取(0);
    结果<整64, 整32> 获取值 = 全局映射.获取(1);
    布尔 包含值 = 全局集合.包含(3);
    整32 累 = 整32(大小值) + 元素值;
    如果 (读取值.正常) { 累 = 累 + 读取值.值; }
    如果 (获取值.正常) { 累 = 累 + 整32(获取值.值); }
    如果 (包含值) { 累 = 累 + 1; }
    返回 累;
}

函数 主() -> 整32 {
    造数据();
    打印行("读面累加");
    打印行(读面());
    返回 读面();
}
