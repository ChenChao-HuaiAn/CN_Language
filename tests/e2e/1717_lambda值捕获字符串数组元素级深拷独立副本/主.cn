// E2E 1717_lambda值捕获字符串数组元素级深拷独立副本（#1880·dual 双编译对照锁用例）：
//   lambda 值捕获**句柄型元素数组**=定义处**元素级递归深拷快照**（#1880·940 结构体
//   深拷先例的数组版）——1408 整组位拷对元素全标量数组正确，元素为句柄型
//   （字符串/容器/类）时位拷只复制句柄=快照与源共享堆壳（浅共享→悬垂/双杀面）。
//   修复后：字符串元素=逐元素 __cn_str_copy 落堆独立副本（嵌套二维递归同构），
//   捕获后源元素重赋值/源出块析构（1720 时序面）不影响快照读。
// 期望手算（逐行）：
//   ① 快照读两元素=甲甲甲甲 乙乙乙乙（元素级副本·独立于源）；
//   ② 源重赋值后读源=丙丙丙丙（源独立改写·快照不受影响的双向独立）；
//   ③ 二维嵌套递归：快照读内层=子一 子二（嵌套数组逐层深拷·递归到底）；
//   ④ 二维源改后快照读=子一 改一？——否：④=源改后快照仍读旧值 子一（独立），
//     尾行读源=改一（源独立）。
函数 主() -> 整32 {
    // ①② 一维字符串元素数组：元素级深拷独立
    字符串[2] 组;
    组[0] = 字符串复制("甲甲甲甲");
    组[1] = 字符串复制("乙乙乙乙");
    变量 读 = [组]() -> 整32 { 打印(组[0]); 打印(组[1]); 返回 0; };
    组[0] = 字符串复制("丙丙丙丙");
    读();                    // 甲甲甲甲 / 乙乙乙乙（快照独立）
    打印(组[0]);             // 丙丙丙丙（源独立）
    // ③④ 二维嵌套数组：递归深拷到底
    字符串[2][2] 矩;
    矩[0][0] = 字符串复制("子一");
    矩[1][1] = 字符串复制("子二");
    变量 读矩 = [矩]() -> 整32 { 打印(矩[0][0]); 打印(矩[1][1]); 返回 0; };
    矩[0][0] = 字符串复制("改一");
    读矩();                  // 子一 / 子二（嵌套快照独立）
    打印(矩[0][0]);          // 改一（源独立）
    返回 0;
}
