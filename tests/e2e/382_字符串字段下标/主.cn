// E2E 382（255-a·D30 根治锚定，2026-09-16）：
//   类方法内「拥有型字符串字段」下标访问=逐字节（1 字节·有符号）——
//   修复前=按 mapType("字符")=i32 四字节打包读（"ax"[0]→30817）+步进错（[1]→越界垃圾）。
//   形态：①字段下标逐字节 ②字段下标与字符字面量比较（T30 连带）
//   ③字段下标参与算术 ④形参下标对照（回归防线）。
公开:

类 持串 {
公开:
    字符串 内容;

    函数 持串(字符串 初值) {
        内容 = 初值;
    }

    函数 读字节(整64 位) -> 整64 {
        返回 整64(内容[位]);
    }

    函数 锚于(整64 位, 字符 锚字) -> 布尔 {
        返回 内容[位] == 锚字;
    }
}

函数 形参读(字符串 源, 整64 位) -> 整64 {
    返回 整64(源[位]);
}

函数 主() -> 整32 {
    持串 甲 = 持串("ax");
    打印(甲.读字节(0));
    打印(甲.读字节(1));
    打印(形参读("ax", 0));
    打印(形参读("ax", 1));
    持串 乙 = 持串("^ab$");
    打印(乙.锚于(0, '^'));
    打印(乙.锚于(3, '$'));
    打印(乙.锚于(1, '^'));
    持串 丙 = 持串("中");
    打印(丙.读字节(0) < 0);
    打印(丙.读字节(1) < 0);
    打印(甲.内容[0]);
    打印(甲.内容[1]);
    返回 0;
}
