// E2E 252（宿主负测，2026-09-13 第九十三轮 93-a）
//   主题：类名/实例 成员静态性不匹配 —— 编译期拒绝（B2 立案缺陷根治）
//   形态矩阵（六形态）：
//     ① 类名.实例方法()   ② 类名.实例字段（读）   ③ 类名.实例字段（写）
//     ④ 实例.静态方法()   ⑤ 实例.静态字段         ⑥ 接口名.方法()
//   修复前：①③⑤⑥ 运行期段错误（IR 生成 NULL 间接调用 / this 错位）；
//           ②④ 静默错误（读 this 首 8 字节恒 0 / 写不生效）。
//   纪律依据：规范 06-十「类外访问用 类名.静态成员」（静态成员须经类名）；
//     Rust 对标（E0061 实例方法须经实例调用 / E0599 关联成员不经实例访问）。
//   B2 缺陷面（plans/019 立案）：原「类静态成员+析构写静态成员运行期崩溃」，
//     本轮探针二分定位真根因=类名.实例方法() 形态漏检（与静态成员无关）。
类 盒子 {
公开:
    整64 值;
    静态 整64 计数 = 0;
    函数 盒子(整64 v) {
        值 = v;
    }
    函数 读值() -> 整64 {
        返回 值;
    }
    静态 函数 取计数() -> 整64 {
        返回 计数;
    }
}

接口 形状 {
    函数 面积() -> 整64;
}

类 方形 : 形状 {
公开:
    整64 边;
    函数 方形(整64 s) {
        边 = s;
    }
    重写 函数 面积() -> 整64 {
        返回 边 * 边;
    }
}

函数 主() -> 整32 {
    盒子 甲 = 盒子(7);
    方形 乙 = 方形(3);
    整64 甲读值 = 盒子.读值();          // ① 类名.实例方法()
    整64 甲字段 = 盒子.值;              // ② 类名.实例字段（读）
    盒子.值 = 1;                        // ③ 类名.实例字段（写）
    整64 计数读 = 甲.取计数();          // ④ 实例.静态方法()
    整64 计数直读 = 甲.计数;            // ⑤ 实例.静态字段
    整64 面积读 = 形状.面积();          // ⑥ 接口名.方法()
    返回 0;
}
