// 731_闭包高阶两面（#432·#276 波3·001「lambda 表达式」+spec 04-一D/四）
// 面1 lambda 作函数返回值：值捕获 [=] 快照随闭包逃逸栈帧（悬垂零容忍）。
// 面2 lambda 直接作实参传入函数形参（函数指针形参位）。
函数 造加倍() -> 整32(*)(整32) {
    变量 基 = 2;
    变量 加倍 = [=](整32 x) -> 整32 { 返回 x * 基; };
    返回 加倍;
}
函数 应用(整32(*f)(整32), 整32 v) -> 整32 {
    返回 f(v);
}
函数 主() -> 整32 {
    变量 f = 造加倍();
    打印(f(21));                       // 42（基快照=2 随闭包走）
    变量 基 = 10;
    打印(应用([=](整32 x) -> 整32 { 返回 x + 基; }, 5));   // 15
    返回 0;
}
