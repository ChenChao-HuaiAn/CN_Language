// 833（任务 550）：浮32 → 整128/正128 显式转换——按源浮宽读取（f32 须先 cvtss2sd
//   再进运行时辅助）。缺陷面（442 轮实证）：浮32 源按 f64 读位模式——3.75f 的
//   32 位模式被当 f64 解释（≈4e-310 非规格化数）→ 截断恒 0；对照 浮64 通道正确。
//   宿主编译器三后端（win x64 / linux x64 / arm64）与 v2 同族修复，同一 .expected 双测。
// 值域口径（464/475 地面）：域内向零截断；NaN→0；≥2^127→i128::MAX；
//   <-2^127→i128::MIN。正128 目标沿用 800 锁定现状（有符号辅助·位模式对齐——
//   u128 专用辅助已备未接=464 呈报面，本用例不扩面）：负值=补码位模式
//   （-3.75→2^128-3、-2^63→2^128-2^63），两侧实测同值锁定。
// 期望手算：3.75f→3、-3.75f→-3、0.5f→0；2^63/2^64 为 2 的幂（f32/f64 均精确
//   可表示）→ 全宽正确值（原缺陷面：f32 读位模式后 0）；NaN→0；
//   3.0e38f（f32 最大有限 3.4e38 内·≥2^127）→ i128::MAX；-3.0e38f→i128::MIN。
函数 主() -> 整32
{
    浮32 甲 = 浮32(3.75);
    整128 a = 整128(甲);
    打印行("i128(f32 3.75)=", a);
    打印("");
    浮32 乙 = 浮32(-3.75);
    整128 b = 整128(乙);
    打印行("i128(f32 -3.75)=", b);
    打印("");
    浮32 丙 = 浮32(0.5);
    整128 c = 整128(丙);
    打印行("i128(f32 0.5)=", c);
    打印("");
    浮32 界上 = 浮32(9223372036854775808.0);
    整128 d = 整128(界上);
    打印行("i128(f32 2^63)=", d);
    打印("");
    浮32 界下 = 浮32(-9223372036854775808.0);
    整128 e = 整128(界下);
    打印行("i128(f32 -2^63)=", e);
    打印("");
    浮32 超64 = 浮32(18446744073709551616.0);
    整128 f = 整128(超64);
    打印行("i128(f32 2^64)=", f);
    打印("");
    浮32 非数 = 浮32(0.0 / 0.0);
    整128 g = 整128(非数);
    打印行("i128(f32 NaN)=", g);
    打印("");
    浮32 超域 = 浮32(3.0e38);
    整128 h = 整128(超域);
    打印行("i128(f32 3e38)=", h);
    打印("");
    浮32 负超域 = 浮32(-3.0e38);
    整128 i = 整128(负超域);
    打印行("i128(f32 -3e38)=", i);
    打印("");
    正128 p = 正128(甲);
    打印行("u128(f32 3.75)=", p);
    打印("");
    正128 q = 正128(界上);
    打印行("u128(f32 2^63)=", q);
    打印("");
    正128 r = 正128(乙);
    打印行("u128(f32 -3.75)=", r);
    打印("");
    正128 s = 正128(界下);
    打印行("u128(f32 -2^63)=", s);
    打印("");
    返回 0;
}
