// E2E 457（2026-09-19 第 434 轮·T65 424 死循环根治+C-4 多值情况标签）：
//   规范 03 §270-271（C-4）：情况值, {",", 情况值}——「等价多个连续标签」。
//   ①数值多值 ②字符多值（三值）③字符串多值（__cn_str_eq 路径）④默认回退
//   ⑤单值回归（存量形态零扰动）。双编译对照：宿主/v2 同源同测。
//   反证：原版 v2p 对 `情况 1, 2:` 死循环（424 立案·失控 34 分钟）。
函数 主() -> 整32 {
    // ① 数值多值（命中第二值）
    选择 (2) {
        情况 1, 2: 打印(100);
        情况 3: 打印(200);
        默认: 打印(900);
    }
    // ② 字符多值（三值·命中第二值）
    选择 ('b') {
        情况 'a', 'b', 'c': 打印(300);
        默认: 打印(900);
    }
    // ③ 字符串多值（__cn_str_eq 路径·命中第二值）
    选择 ("乙") {
        情况 "甲", "乙": 打印(400);
        默认: 打印(900);
    }
    // ④ 无命中走默认
    选择 (9) {
        情况 1, 2: 打印(100);
        默认: 打印(900);
    }
    // ⑤ 单值回归（存量形态）
    选择 (3) {
        情况 3: 打印(200);
        默认: 打印(900);
    }
    返回 0;
}
