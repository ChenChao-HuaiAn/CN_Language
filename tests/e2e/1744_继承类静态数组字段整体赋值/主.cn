// E2E 1744 正测（#1979 继承链面）：子类名.父类静态数组字段整体赋值——
//   沿继承链解析静态数组字段（#1445 沿链口径·1882 下标面同源），整块拷
//   落**声明类**唯一槽（基名 与 子名 同槽互证·禁并入子类槽）。
类 基 {
公开:
    静态 整64[3] 传家;
}
类 子 : 基 {
}
函数 主() -> 整32 {
    整64[3] 源;
    源[0] = 5;
    源[1] = 6;
    源[2] = 7;
    子.传家 = 源;
    打印(子.传家[0]);
    打印(子.传家[1]);
    // 声明类槽归一：基名读=子名写（同槽互证）
    打印(基.传家[2]);
    // 基名再赋值·子名读（双向同槽）
    源[0] = 55;
    基.传家 = 源;
    打印(子.传家[0]);
    返回 0;
}
