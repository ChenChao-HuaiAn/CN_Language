导入 容器::链表;
导入 容器::栈;
导入 容器::队列;

外部 函数 __cn_alloc_live() -> 整64;

静态 整64 计数 = 0;
类 资源 {
公开:
    整64 编号;
    函数 资源(整64 v) { 编号 = v; }
    函数 资源(资源& 其他) { 编号 = 其他.编号; }
    不安全 函数 ~资源() { 计数 = 计数 + 1; }
}
不安全 函数 主() -> 整32 {
    打印("[L0] live=", __cn_alloc_live());
    {
        链表<资源> 表;
        资源 r1 = 资源(1);
        资源 r2 = 资源(2);
        结果<空类型, 整32> a1 = 表.追加(r1);
        结果<空类型, 整32> a2 = 表.追加(r2);
        打印("[L1] 链表追加 live=", __cn_alloc_live());
        结果<空类型, 整32> d1 = 表.删除头部();
        打印("[L2] 删头 live=", __cn_alloc_live());
    }
    打印("[L3] 链表块完 live=", __cn_alloc_live());
    {
        栈<资源> 栈表;
        资源 s1 = 资源(1);
        资源 s2 = 资源(2);
        结果<空类型, 整32> p1 = 栈表.压入(s1);
        结果<空类型, 整32> p2 = 栈表.压入(s2);
        打印("[L4] 栈压 live=", __cn_alloc_live());
        结果<资源, 整32> 弹 = 栈表.弹出();
        打印("[L5] 弹出 live=", __cn_alloc_live());
    }
    打印("[L6] 栈块完 live=", __cn_alloc_live());
    {
        队列<资源> 队列表;
        资源 q1 = 资源(1);
        资源 q2 = 资源(2);
        资源 q3 = 资源(3);
        结果<空类型, 整32> e1 = 队列表.入队(q1);
        结果<空类型, 整32> e2 = 队列表.入队(q2);
        结果<空类型, 整32> e3 = 队列表.入队(q3);
        打印("[L7] 队入 live=", __cn_alloc_live());
        结果<资源, 整32> 出 = 队列表.出队();
        打印("[L8] 出队 live=", __cn_alloc_live());
        队列表.清空();
        打印("[L9] 清空 live=", __cn_alloc_live());
    }
    打印("[L10] 队块完 live=", __cn_alloc_live());
    返回 0;
}
