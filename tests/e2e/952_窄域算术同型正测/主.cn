// E2E 952（dual 正测·740·2026-10-14）：窄域算术同型放行面（§3.7a #285 同宽窄
//   算术保持窄域 + #481 字面量按另一侧类型参与 + 复合赋值字面量豁免）——740
//   收紧窄化面的**不误伤对照**：本用例全形态宿主/v2 双侧必须放行且算术值
//   一致（退出码=75 双侧断言）。修前 v2 靠「推导 -1 放行」侥幸同绿；740 后
//   靠立法口径推导（同宽窄→窄域/字面量按另一侧）继续同绿=零误伤锁面。
//   75 = 11+6+4+20+14+20（丙8/丁8/戊8/己8/甲8终/庚）；移位量须窄变量窄值
//   （移位字面量右恒定级整32=窄化拒面·AD 锚；5<<6 超 整8 域=错误码8 面）。
函数 主() -> 整32 {
    整8 甲8 = 5;
    整8 乙8 = 6;
    整8 移2 = 2;
    整8 丙8 = 甲8 + 乙8;      // 11（#285 同宽窄算术保持窄域·赋同型）
    整8 丁8 = 甲8 + 1;        // 6（#481 字面量按另一侧参与）
    整8 戊8 = 甲8 & 乙8;      // 4（窄窄位与保持窄域）
    整8 己8 = 甲8 << 移2;     // 20（窄窄移位保持窄域）
    甲8 += 乙8;               // 甲8=11（复合赋值同型）
    甲8 += 3;                 // 甲8=14（复合赋值字面量豁免）
    整32 庚 = 甲8 + 乙8;      // 20（窄窄算术→宽化赋整32）
    返回 丙8 + 丁8 + 戊8 + 己8 + 甲8 + 庚;   // 11+6+4+20+14+20 = 75
}
