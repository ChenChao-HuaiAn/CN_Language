// 681（021 #351·原立 671 撞 373 批预告占用让位改 681·2026-10-10 单位机修复轮）：堆指针对象字段写落位——
//   类指针对象（`节点* 头 = 分配(...); 头.字段 = v`）写侧剥星根治。
//   根因：handleClassMemberLvalue 不剥指针（读侧 588-a 已修写侧旁路漏网）
//   → 落 memberGenericAssign → findStruct 只查结构体不查类 =null →
//   FieldAddr 丢失 → StorePtr 以对象基址为目标地址 → 写全落 [对象+0]
//   首字段互相覆盖（348 轮铁证：头.下个=临时 指针值落首字段类别位·目标
//   位恒零）。全平台 IR 层缺陷（x86_64/win 同 IR——此前无堆链形态测试面
//   故绿）。本用例=形态矩阵+链式搭链（#352 JSON 树根基）锁边：
//   ① 堆对象标量字段写/读（类别/值 槽独立）
//   ② 堆对象指针类型字段写/读（下个=临时·指针值落对槽）
//   ③ 链式搭链遍历（头→甲→乙·#352 链式树根基形态）
//   ④ 复合赋值 读改写（p.计数 += 1·#350 同根复测面）
//   ⑤ 栈对象同写法对照（健康面锚定）
//   ⑥ 方法内 自身 字段读改写（健康面锚定）
//   校验和位：①1 ②2 ③4 ④8 ⑤16 ⑥32 —— 全对=退出码 0。
类 节点 {
公开:
    整64 类别;
    节点* 下个;
    整64 值;
    整64 计数;
    函数 计数加一() -> 空类型 {
        自身.计数 = 自身.计数 + 1;
    }
}

不安全 函数 主() -> 整32 {
    整64 校验 = 0;

    // ①② 堆对象标量/指针字段写
    节点* 头 = 分配(类型大小(节点));
    节点* 临时 = 分配(类型大小(节点));
    头.类别 = 7;
    头.值 = 99;
    头.下个 = 临时;
    如果 (头.类别 == 7 && 头.值 == 99) { 校验 = 校验 + 1; }
    如果 (头.下个 == 临时) { 校验 = 校验 + 2; }

    // ③ 链式搭链：头→甲→乙 遍历（#352 JSON 链式树根基）
    节点* 甲 = 分配(类型大小(节点));
    节点* 乙 = 分配(类型大小(节点));
    甲.类别 = 21;
    乙.类别 = 22;
    头.下个 = 甲;
    甲.下个 = 乙;
    乙.下个 = 分配(类型大小(节点));   // 尾哨兵（防悬垂·2 安全）
    乙.下个.类别 = 0;   // 390 修正（2026-10-10 家机报备）：分配=malloc 语义不保证清零
                        //   （001 L1589·win 堆复用脏内存实测哨兵.类别=21673912513855488
                        //   三取一脏）——原依赖「新分配恰零」=用例未定义行为假设，
                        //   linux 新页侥幸绿·win 必然偶发红；显式置零方合立法
    整64 遍历 = 0;
    节点* 游 = 头;
    当 (游.类别 != 0) {
        遍历 = 遍历 * 100 + 游.类别;
        游 = 游.下个;
    }
    如果 (遍历 == 72122) { 校验 = 校验 + 4; }

    // ④ 复合赋值读改写（#350 同根复测面）
    头.计数 = 40;
    头.计数 += 1;
    头.计数 += 1;
    如果 (头.计数 == 42) { 校验 = 校验 + 8; }

    // ⑤ 栈对象同写法对照
    节点 栈头 = 节点();
    节点* 栈指 = 分配(类型大小(节点));
    栈头.类别 = 7;
    栈头.值 = 99;
    栈头.下个 = 栈指;
    如果 (栈头.类别 == 7 && 栈头.值 == 99 && 栈头.下个 == 栈指) { 校验 = 校验 + 16; }

    // ⑥ 方法内 自身 字段读改写（健康面锚定）
    头.计数 = 5;
    头.计数加一();
    如果 (头.计数 == 6) { 校验 = 校验 + 32; }

    // 诊断输出（修好后打印实际值供对拍·expected 固化）
    打印("堆:类别="); 打印行(头.类别);
    打印("堆:值="); 打印行(头.值);
    打印("堆:计数="); 打印行(头.计数);
    打印("链遍历="); 打印行(遍历);
    打印("校验和="); 打印行(校验);

    如果 (校验 == 63) { 返回 0; }
    返回 1;
}
