// E2E 1048：结果/可选 合成体作结构体字段布局全链（#920 修复锁面·双编译对照）
// 病面（修前宿主·799/920 探针实录）：结构体含 结果<结构体,E> 字段时字段尺寸被
//   固化为 12（typeSizeOf 在合成体「已注册未布局」窗口读到 totalSize=0 →
//   「结果最小 12」Task 6.1 防御值被 computeLayout 字段循环固化，layoutComputed
//   置位后不再重算）——v2/真值 16（盒4 载荷 8 圆整）/24（盒16 载荷 16）；
//   12 布局 + 16/24 字节 CopyStruct = 越界写相邻字段（内存安全红线）。
// 锁面（布局值直接对照·类型大小打印·双侧逐值一致）：
//   ①结果<盒4,整32> 字段结构体=16   ②结果<盒16,整32> 字段结构体=24
//   ③可选<盒4> 字段结构体=16        ④嵌套结构体字段=结果链=16
//   ⑤结果<盒4,整32>[2] 数组字段=32（元素 16 步长面＝合成体尺寸真值）
//   ⑥哨兵4：结果字段 16 + 整32 = 24 ⑦哨兵16：结果字段 24 + 整64 = 32（偏移链面）
//   ⑧普通结构体数组字段（盒4[2] 域）=8（元素尺寸真值面）
// 修复前宿主值（红·2026-10-17 实测）：包4=12 包16=12 可选包=16 嵌套外=12
//   数组字段=24 哨兵4=16 哨兵16=24；修复后宿主 == v2 逐值一致
//   （本用例双编译对照以两侧一致为判据；修前 12 vs v2 16/24 即分叉实录）。
// 形态规避说明：前向引用（依赖结构体声明在使用者之后）为 v2 侧未支持面
//   （结果<前向结构体> → v2p 内部错误「结果载荷字节未登记」；普通结构体数组
//   字段前向引用 → v2 元素尺寸防御 8 错值 16）——v2 时机族缺陷已立项，本用例
//   不纳入（保持双侧共有多态）；宿主侧倒挂锁面见配对用例 1049。
结构体 盒4 {
    整32 甲;
}
结构体 包数组 {
    盒4[2] 域;
}
结构体 盒16 {
    整64 甲;
    整64 乙;
}
结构体 包装4 {
    结果<盒4, 整32> 值槽;
}
结构体 包装16 {
    结果<盒16, 整32> 值槽;
}
结构体 可包装 {
    可选<盒4> 值槽;
}
结构体 嵌套内 {
    结果<盒4, 整32> 槽;
}
结构体 嵌套外 {
    嵌套内 域;
}
结构体 数组字段 {
    结果<盒4, 整32>[2] 槽们;
}
结构体 哨兵4 {
    结果<盒4, 整32> 值槽;
    整32 哨兵;
}
结构体 哨兵16 {
    结果<盒16, 整32> 值槽;
    整64 哨兵;
}

函数 主() -> 整32 {
    打印("包4:", 类型大小(包装4));
    打印("包16:", 类型大小(包装16));
    打印("可选包:", 类型大小(可包装));
    打印("嵌套外:", 类型大小(嵌套外));
    打印("数组字段:", 类型大小(数组字段));
    打印("哨兵4:", 类型大小(哨兵4));
    打印("哨兵16:", 类型大小(哨兵16));
    打印("包数组:", 类型大小(包数组));
    返回 0;
}
