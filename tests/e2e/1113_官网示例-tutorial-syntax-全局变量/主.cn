// 官网文档示例 · tutorial-syntax.html · 变量（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
整32 全局计数 = 5;             // 裸全局：默认外部可见
整32 零值槽;                   // 无初始化器 = 零初始化（.bss）
静态 整32 私密槽 = 1;          // 顶层静态：文件私有

不安全 函数 累加() {
    全局计数 += 3;             // 全局写须在 不安全 函数 内
    零值槽 = 7;
}

函数 主() -> 整32 {
    累加();
    打印(全局计数, " ", 零值槽, " ", 私密槽);
    返回 0;
}