// 主入口（第 7 层：44_crate_isolate 命名空间隔离 E2E，规格书08-一/09-四）
// v2.0 核心价值验证：两模块（模块X.cn / 模块Y.cn）定义**同名同签名**
//   `函数 双倍(整64) -> 整64`，在 crate 隔离下互不冲突（v1.0 全局平铺会报重复定义）。
// 覆盖：
//   ① 路径导入符号：导入 模块X::双倍 / 导入 模块Y::双倍（限定调用各自解析）
//   ② 整模块导入 + 限定调用：导入 模块X / 导入 模块Y 后 模块名::双倍
//   ③ 同输入区分验证：X 返回 ×2、Y 返回 ×3（证明解析到正确模块）
// 编译器边界（2026-08-15 实测）：花括号项别名（导入 模块Y::{双倍 作为 Y双倍}）
//   在**跨模块同名**场景下重写回原符号名后未设置 moduleFilter，resolveOverload
//   对 模块X$双倍 与 模块Y$双倍 歧义报错。本用例聚焦「限定调用隔离」主题，
//   别名纯名调用留待编译器完善（单测 UseImportRenameConflictLastWins 覆盖单模块别名）。
// 打印语义（用户裁决）：打印=println（自动换行）

导入 模块X::双倍;
导入 模块X;
导入 模块Y;

函数 主() -> 整32 {
    打印("===== crate 命名空间隔离（第 7 层）=====");

    // ---- ① 路径导入符号：限定调用（crate 隔离各自解析）----
    整64 值X = 模块X::双倍(21);
    打印("模块X::双倍(21): ", 值X);                // 42（×2）
    整64 值Y = 模块Y::双倍(14);
    打印("模块Y::双倍(14): ", 值Y);                // 42（×3）

    // ---- ② 同模块内两种导入形式结果一致 ----
    整64 值X2 = 模块X::双倍(50);
    打印("模块X::双倍(50): ", 值X2);               // 100
    整64 值Y2 = 模块Y::双倍(50);
    打印("模块Y::双倍(50): ", 值Y2);               // 150

    // ---- ③ 整模块导入后限定调用 ----
    整64 值X4 = 模块X::双倍(5);
    整64 值Y4 = 模块Y::双倍(5);
    打印("模块X::双倍(5): ", 值X4);                // 10
    打印("模块Y::双倍(5): ", 值Y4);                // 15

    // ---- ④ 区分验证：同一输入两模块结果不同（证明解析到正确模块）----
    打印("双倍同输入 X/Y: ", 模块X::双倍(7), " / ", 模块Y::双倍(7));  // 14 / 21

    打印("===== crate 命名空间隔离测试完成 =====");
    返回 0;
}
