// 869(#234 禁止类切片 v2 侧残余面补齐·题述形态②):赋值面派生类值 →
//   基类值左值(标识符/下标/成员全左值形态)——值拷贝切片本体。
//   预期失败:诊断锚「禁止类切片」(宿主/v2 双侧同文案)。
类 形状 {
公开:
    虚拟 函数 面积() -> 整32 { 返回 0; }
}
类 方 : 形状 {
公开:
    整32 边;
    函数 方(整32 b) { 边 = b; }
    重写 函数 面积() -> 整32 { 返回 边 * 边; }
}
类 盒 {
公开:
    形状 槽;
    函数 盒() { }
}
函数 主() -> 整32 {
    方 a = 方(3);
    形状 s = 形状();
    s = a;
    形状[2] 数组甲;
    数组甲[0] = 形状();
    数组甲[0] = a;
    盒 h = 盒();
    h.槽 = a;
    打印(s.面积());
    打印(数组甲[0].面积());
    打印(h.槽.面积());
    返回 0;
}
