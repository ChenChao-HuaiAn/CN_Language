// 9263tmp_e（263① 边界对照·临时不入库）：挑选号(表.元素(0)) 调用直传（无三元）。
//   预期绿（E2E 148 调用返回形态回扫路径）——验证 d 探针错值系「三元汇合」独有，
//   非容器方法返回实参装配本身缺陷。2=绿；1=泄漏；0=值错。
导入 容器::向量;

结构体 盒子 {
    字符串 名;
    整32 号;
}

函数 挑选号(盒子 输入) -> 整32 {
    返回 输入.号;
}

函数 形探() -> 整64 {
    整64 前 = 内存::活动分配数();
    {
        向量<盒子> 表 = 向量<盒子>();
        结果<空类型, 整32> 加 = 表.追加(盒子{ 名 = 字符串复制("P263E甲"), 号 = 5 });
        如果 (!加.正常) { 返回 10; }
        整32 号 = 挑选号(表.元素(0));
        如果 (号 != 5) { 打印(号); 返回 40; }
    }
    如果 (内存::活动分配数() != 前) { 返回 1; }
    返回 2;
}

函数 主() -> 整32 {
    打印(形探());
    返回 0;
}
