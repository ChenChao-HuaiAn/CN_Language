// E2E 904（#638 甲案配套正例·2026-10-14 用户裁决「推断通道一律拒」·显式通道
//   照常）：推断通道超域=拒（813/903 锁面），显式写类型=完备通道——整64/整128
//   目标承载超 整32 域值照常（001 §3.7a 提升链适用面=表达式求值与显式目标
//   类型场景·638 收窄条文）；域内推断（戊/己）不误伤；显式 整64 算术正常。
//   双编译对照正测：宿主+v2p 同源同跑同输出（零分叉门禁）。
函数 主() -> 整32 {
    整64 甲 = 3000000000;                  // 显式 整64：中值照常
    打印行("甲=", 甲);
    打印("");
    整128 丙 = 99999999999999999999;       // 显式 整128：巨字面量照常
    打印行("丙=", 丙);
    打印("");
    整64 丁 = -9223372036854775808;        // 显式 整64 负界恰等：照常
    打印行("丁=", 丁);
    打印("");
    变量 戊 = 42;                          // 推断域内：恒定级整32 装得下
    打印行("戊=", 戊);
    打印("");
    变量 己 = -2147483648;                 // 推断负界恰等：负值判域域内（855 锚）
    打印行("己=", 己);
    打印("");
    甲 = 甲 + 1;                           // 显式 整64 算术照常
    打印行("甲+1=", 甲);
    打印("");
    返回 0;
}
