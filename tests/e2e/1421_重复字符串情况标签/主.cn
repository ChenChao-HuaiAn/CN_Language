// E2E 1421_重复字符串情况标签（1172）：字符串情况标签重复=编译期拒（宿主面）。
//   覆盖同组重复/跨组重复/字符串与非字符串标签双向互斥（规范 03 C-4 一致性约束）；
//   v2 面成对=1421_v2_重复字符串情况标签。
函数 重复甲() -> 整32 {
    字符串 词 = "A";
    选择 (词) {
        情况 "A":
            打印("甲一");
            中断;
        情况 "A":
            打印("甲二");
            中断;
        默认:
            打印("甲默认");
    }
    返回 0;
}

函数 重复乙() -> 整32 {
    字符串 词 = "B";
    选择 (词) {
        情况 "B", "B":
            打印("乙一");
            中断;
        默认:
            打印("乙默认");
    }
    返回 0;
}

函数 互斥甲() -> 整32 {
    字符串 词 = "A";
    选择 (词) {
        情况 1:
            打印("互甲");
            中断;
        默认:
            打印("互甲默认");
    }
    返回 0;
}

函数 互斥乙() -> 整32 {
    整32 值 = 1;
    选择 (值) {
        情况 "E":
            打印("互乙");
            中断;
        默认:
            打印("互乙默认");
    }
    返回 0;
}

函数 主() -> 整32 {
    返回 0;
}
