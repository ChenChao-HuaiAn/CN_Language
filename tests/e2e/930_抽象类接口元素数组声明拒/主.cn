// E2E 930 负测（任务593·193 数组形态漏网根治）
// 立法：specs/06 §八「抽象 声明纯虚函数（类似 C++ 的 = 0），含抽象成员的类
//   不可直接实例化」+接口同族（specs/06 §六）——「抽象类名[N] 数组名」值
//   形态=元素逐个默认构造实例化，同在射程。193 已拦裸声明/构造调用两形态，
//   本件=其数组形态收口：isClassType/isInterfaceType 精确名查表不含数组
//   后缀致「图形[3]」恒 miss。
// 缺陷史（修前实锤）：宿主七形态全静默放行（完整链产 exe·运行期虚表残缺/
//   纯虚调用未定义=安全隐患）；v2 抽象数组被 IR 宽度表偶然兜住（「数组类型
//   元素/长度未知」诊断错位）、接口数组 rc=0 静默放行=分叉双向实锤。
//   修后=双侧语义层领域正确拒绝，诊断文案逐字一致（[错误] 前缀=v2 惯例），
//   注明数组形态：不能实例化抽象类/接口 'X'（…·数组 'X[N]' 元素为值形态
//   默认构造）。
// 九形态：①全局静态 ②自由函数形参 ③自由函数返回 ④局部声明（抽象类）
//   ⑤类字段 ⑥类静态字段 ⑦类方法形参 ⑧类方法返回 ⑨接口元素数组局部声明。
//   诊断锚=「不能实例化」（双侧九条公共子串）。
类 图形 {
公开:
    抽象 函数 面积() -> 整64
}

接口 可叫 {
    函数 叫() -> 空类型
}

静态 图形[2] 全局槽;

函数 吃(图形[3] 组) -> 整32 {
    返回 0;
}

函数 吐() -> 图形[2] {
    图形[2] 局;
    返回 局;
}

类 工具 {
公开:
    图形[2] 成员;
    静态 图形[2] 槽;
    函数 转(图形[3] 组) -> 整32 {
        返回 0;
    }
    函数 造() -> 图形[2] {
        返回 造();
    }
}

函数 主() -> 整32 {
    可叫[2] 表;
    返回 0;
}
