// 数组与指针E2E测试（Task 2.4）
// 覆盖：数组声明/初始化/下标读写、部分初始化补零、指针取地址/解引用/算术/遍历、
//       数组名退化、指针比较、空指针、空类型*转换
// 注意：数组语法为 类型[长度] 名（规格书3.5）；指针语法为 类型* 名
// 越界(错误码2)/空指针解引用(错误码3)验证见 越界.cn / 空指针.cn（冒烟验证）

函数 主() -> 整32 {
    // ---- 1. 数组声明与初始化 ----
    整32[5] 数据 = { 1, 2, 3, 4, 5 }
    打印("数组[2]: ")
    打印行整数(数据[2])          // 3

    // 部分初始化补零（C语义）
    整32[4] 部分 = { 7, 8 }
    打印("部分初始化[2]: ")
    打印行整数(部分[2])          // 0

    // 下标写
    数据[0] = 100
    打印("写后[0]: ")
    打印行整数(数据[0])          // 100

    // 下标变量表达式
    整32 i = 4
    打印("下标变量[4]: ")
    打印行整数(数据[i])          // 5

    // ---- 2. 指针取地址/解引用 ----
    整32 x = 42
    整32* p = &x;
    打印("解引用: ")
    打印行整数(*p);              // 42
    *p = 99;
    打印("解引用写: ")
    打印行整数(x)                // 99

    // ---- 3. 指针算术与遍历 ----
    整32[3] 数据3 = { 10, 20, 30 }
    整32* q = &数据3[0]
    q = q + 1
    打印("指针+1: ")
    打印行整数(*q)               // 20
    q = q - 1
    打印("指针-1: ")
    打印行整数(*q)               // 10
    q++
    打印("q++: ")
    打印行整数(*q)               // 20
    q--
    打印("q--: ")
    打印行整数(*q)               // 10

    // 数组名退化（数组名 -> 指向首元素的指针）
    整32* r = 数据3
    打印("数组退化: ")
    打印行整数(*r)               // 10

    // 指针比较
    整32* s = &数据3[2]
    打印("指针比较: ")
    如果 (r < s) {
        打印("r < s")
    } 否则 {
        打印("r >= s")
    }

    // ---- 4. 空指针 ----
    整32* n = 无
    打印("空指针比较: ")
    如果 (n == 无) {
        打印("是空指针")
    } 否则 {
        打印("非空指针")
    }

    // 空类型* 与任意指针双向转换（规格书3.7）
    空类型* vp = 无
    整32* t = vp                 // 空类型* -> 整32*（隐式）
    打印("空类型*转换: ")
    如果 (t == 无) {
        打印("转换后为空")
    }

    返回 0
}
