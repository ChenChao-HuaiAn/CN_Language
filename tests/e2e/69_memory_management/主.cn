// E2E 69_memory_management：内存管理（自举前置 C-1/C-3，2026-08）
// 覆盖：
//   C-3 分配计数泄漏检测：内存::活动分配数/总分配次数——容器创建-析构
//     自动释放（DeleteObject RAII）、字符串 子串-释放 后计数回落基线；
//   C-1 进程竞技场：内存::竞技场分配/竞技场重置/竞技场活动字节——
//     一次性进程模式（编译器长生命周期数据，整块释放杜绝泄漏/双重释放）
// 语法依据：plans/004 C 组 + 规格书10.2 内存管理扩展
导入 容器::向量;

函数 容器生命周期测试() -> 整64 {
    整64 基线 = 内存::活动分配数();
    向量<整64> 数据 = 向量<整64>();
    整64 i = 0;
    当 (i < 50) {
        结果<空类型, 整32> 加 = 数据.追加(i * 2);
        如果 (!加.正常) {
            返回 -1;
        }
        i++;
    }
    整64 使用中 = 内存::活动分配数() - 基线;
    返回 使用中;  // 1（向量内部数组；函数返回时析构自动释放）
}

函数 字符串释放测试() -> 整64 {
    整64 基线 = 内存::活动分配数();
    字符串 s = "你好世界CN编译器";
    字符串 子 = 字符串子串(s, 2, 4);
    整64 使用中 = 内存::活动分配数() - 基线;
    字符串释放(子);
    整64 释放后 = 内存::活动分配数() - 基线;
    返回 使用中 * 100 + 释放后;  // 使用中=1（子串动态分配）、释放后=0
}

函数 主() -> 整32 {
    打印("===== 内存管理（分配计数 + 进程竞技场）=====");
    整64 基线 = 内存::活动分配数();
    打印("启动基线活动分配:", 基线);
    整64 总次数0 = 内存::总分配次数();
    打印("启动总分配:", 总次数0);

    // C-3 容器 RAII：函数内 50 次追加 + 返回时析构 -> 计数回落
    整64 使用中 = 容器生命周期测试();
    打印("容器使用中分配:", 使用中);
    整64 容器后 = 内存::活动分配数();
    打印("容器析构后活动:", 容器后);
    如果 (容器后 == 基线) {
        打印("容器自动释放: 通过");
    } 否则 {
        打印("容器自动释放: 失败");
    }

    // C-3 字符串释放：子串动态分配 + 手动释放 -> 计数回落
    整64 串测 = 字符串释放测试();
    打印("字符串测试(使用中*100+释放后):", 串测);
    整64 串后 = 内存::活动分配数();
    如果 (串后 == 基线) {
        打印("字符串释放: 通过");
    } 否则 {
        打印("字符串释放: 失败");
    }

    // C-1 进程竞技场：bump 分配 + 整块重置
    空类型* 表1 = 内存::竞技场分配(1024);
    空类型* 表2 = 内存::竞技场分配(2048);
    整64 字节1 = 内存::竞技场活动字节();
    打印("竞技场分配后字节:", 字节1);
    如果 (表1 != 无 && 表2 != 无 && 字节1 >= 3072) {
        打印("竞技场分配: 通过");
    } 否则 {
        打印("竞技场分配: 失败");
    }
    内存::竞技场重置();
    整64 字节2 = 内存::竞技场活动字节();
    打印("竞技场重置后字节:", 字节2);
    如果 (字节2 == 0) {
        打印("竞技场重置: 通过");
    } 否则 {
        打印("竞技场重置: 失败");
    }

    // 全量检查：活动分配数回落启动基线（无泄漏）
    整64 最终 = 内存::活动分配数();
    打印("最终活动分配:", 最终);
    如果 (最终 == 基线) {
        打印("无泄漏检查: 通过");
    } 否则 {
        打印("无泄漏检查: 失败");
    }
    整64 总次数1 = 内存::总分配次数();
    打印("最终总分配:", 总次数1);
    如果 (总次数1 >= 总次数0 + 2) {
        打印("分配计数累计: 通过");
    } 否则 {
        打印("分配计数累计: 失败");
    }
    打印("===== 内存管理测试完成 =====");
    返回 0;
}
