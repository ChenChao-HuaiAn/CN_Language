// 官网文档示例 · reference/errors.html · 传播（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
导入 核心::错误码;
导入 字符串扩展::字符串转整数;

函数 解析正数(字符串 文) -> 结果<整64, 整32> {
    结果<整64, 整32> 值 = 字符串转整数(文);
    如果 (值.正常) {
        如果 (值.值 <= 0) {          // 已检查分支内取 .值
            返回 错误(错误码.参数);
        }
        返回 正常(值.值);
    }
    返回 错误(错误码.参数);            // 转发解析失败
}

函数 主() -> 整32 {
    结果<整64, 整32> a = 解析正数("42");
    如果 (a.正常) { 打印(a.值); }
    结果<整64, 整32> b = 解析正数("-3");
    如果 (!b.正常) { 打印("拒绝"); }
    返回 0;
}