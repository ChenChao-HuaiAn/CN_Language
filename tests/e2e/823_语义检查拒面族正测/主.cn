// E2E 823（#443/#539 正测锁用例·dual 双编译对照）：语义检查拒面族合法用法
//   仍全绿——一元负号（整/浮）/逻辑非（布尔）/位非（整数）/三元布尔条件/
//   打印各合法类型（字符串/整/浮/布尔/字符/枚举）/单目重载命中形态。
//   与 822 负测成对：拒绝面收口不得误伤合法面（防「误伤既有用例」回归）。
类 单减 {
公开:
    整32 值;

    函数 单减(整32 v) {
        值 = v;
    }

    // 单目取负重载（0 右参）：-s 走重载（合法·非内置面）
    函数 运算符-() -> 单减 {
        返回 单减(0 - 值);
    }
}

枚举 色 { 红, 绿 }

函数 主() -> 整32 {
    整32 a = 5;
    整32 b = -a;
    浮64 c = 5.5;
    浮64 d = -c;
    布尔 e = 真;
    布尔 g = !e;
    整32 h = ~a;
    整32 i = e ? b : h;
    单减 s = 单减(3);
    单减 t = -s;
    色 k = 色.红;
    打印行("数值", b, d, g, h, i);
    打印行("字符", 'A');
    打印行("枚举", k);
    打印行("重载", t.值);
    返回 0;
}
