// E2E 1410（双编译对照·正例·#2088）：函数体内显式 方法值<类,签名> 局部声明
//   位=合法持有位（031 R3 局部变量/形参放行·宿主 checkPlacement 同构）。
//   修前：v2 顶层趟全池扫描的 031 放置拒绝挂点漏「真顶层」守卫（体区间排除），
//   函数体内显式方法值声明被误报「全局变量声明位」拒绝（宿主放行 rc=0=
//   零分叉违例·#2025 方法值三元交叉形态探针发现）；修后挂守卫双侧对齐，
//   真顶层全局方法值声明仍双侧同拒（负例面快验在案）。
// 兼锚 #2025×#1922 交叉形态：方法值调用作三元分支根——`字符串 产出 =
//   条件 ? cb() : 已有串;` cb 分支=A2 拥有契约（#1922 件2 判定单点·
//   三元分支旗值经 串临时拥有性判定→是方法值变量拥有串返回）；已有串
//   分支=借用视图（标志 0·零释放）。修前面：方法值调用返回堆串无人接管
//   （净泄）或借用分支被误 free（源串清空）。
// 验证：①显式声明+直调内容正确 ②声明位混合 50 轮分配差 0
//   ③打印位混合 50 轮差 0 ④借用分支执行后源字段内容不变
//   ⑤实参位混合 50 轮差 0 ⑥反转条件（cb 在假分支）差 0。
类 工厂 {
公开:
    字符串 件名;
    函数 工厂(字符串 n) { 件名 = n; }
    函数 造串() -> 字符串 { 返回 字符串复制(件名 + "造"); }
}
函数 主() -> 整32 {
    工厂 厂 = 工厂("甲");
    方法值<工厂, 字符串()> cb = 厂.造串;
    字符串 已有串 = "常量串";
    // ① 声明位混合三元（真/假分支交替·各 25 轮）
    打印("A");
    整64 基A = 内存::活动分配数();
    整64 i = 0;
    整64 趟A = 0;
    当 (趟A < 50) {
        布尔 条件 = (趟A % 2 == 0);
        字符串 产出 = 条件 ? cb() : 已有串;
        i = i + 整64(字符串长度(产出));
        趟A++;
    }
    打印(整32(i));
    打印(内存::活动分配数() - 基A);
    // ② 借用分支执行后源变量内容不变（误释放探针）
    打印(已有串);
    // ③ 打印位混合三元
    打印("B");
    整64 基B = 内存::活动分配数();
    i = 0;
    当 (i < 50) {
        布尔 条件 = (i % 2 == 1);
        打印(条件 ? cb() : 已有串);
        i++;
    }
    打印(内存::活动分配数() - 基B);
    // ④ 实参位混合三元
    打印("C");
    整64 基C = 内存::活动分配数();
    整64 和 = 0;
    i = 0;
    当 (i < 50) {
        布尔 条件 = (i % 2 == 0);
        和 = 和 + 整64(字符串长度(条件 ? cb() : 已有串));
        i++;
    }
    打印(整32(和));
    打印(内存::活动分配数() - 基C);
    // ⑤ 反转条件（cb 在假分支·已有串在真分支）
    打印("D");
    整64 基D = 内存::活动分配数();
    i = 0;
    整64 趟D = 0;
    当 (趟D < 50) {
        布尔 条件 = (趟D % 2 == 0);
        字符串 产出 = 条件 ? 已有串 : cb();
        i = i + 整64(字符串长度(产出));
        趟D++;
    }
    打印(内存::活动分配数() - 基D);
    打印(已有串);
    返回 0;
}
