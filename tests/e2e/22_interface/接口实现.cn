// Task 3.3 接口与实现 E2E 测试
// 覆盖：接口定义（只含虚拟函数签名无实现）/类实现接口（类 名 : 接口）/
//       实现类重写接口方法/通过接口约束的泛型验证接口实现（编译期检查）/
//       多实现类同一接口各自实现
// 语法依据（cn-language-spec 06-六）：接口 名 { 虚拟 函数 签名... }（无实现体）；
//   类 圆形 : 可绘制 { ... }（冒号后为接口名）；接口方法须用 虚拟/重写 修饰
// 说明：接口附加 vtable（规格书06-五 预留）未实现，接口类型变量调用暂不支持；
//   本用例通过"类实例虚调用"验证接口实现全链路（类虚表含接口方法槽位）
// 打印语义（用户裁决）：打印=println（自动换行）

接口 可绘制 {
    虚拟 函数 绘制() -> 字符串
}

接口 可缩放 {
    虚拟 函数 缩放(浮64 比例) -> 浮64
}

// 圆形 实现两个接口：绘制 + 缩放
类 圆形 : 可绘制, 可缩放 {
公开:
    浮64 半径

    函数 圆形(浮64 r) {
        半径 = r
    }

    重写 函数 绘制() -> 字符串 {
        返回 "圆形(半径=" + 字符串从浮点(半径) + ")"
    }

    重写 函数 缩放(浮64 比例) -> 浮64 {
        半径 = 半径 * 比例
        返回 半径
    }
}

// 矩形 实现 可绘制
类 矩形 : 可绘制 {
公开:
    浮64 宽
    浮64 高

    函数 矩形(浮64 w, 浮64 h) {
        宽 = w
        高 = h
    }

    重写 函数 绘制() -> 字符串 {
        返回 "矩形(" + 字符串从浮点(宽) + "x" + 字符串从浮点(高) + ")"
    }
}

函数 主() -> 整32 {
    打印("===== 接口与实现（Task 3.3）=====")

    // ---- 1. 类实现接口：类实例虚调用接口方法（经类虚表分派）----
    圆形 圆 = 圆形(5.0)
    打印("圆形绘制: ", 圆.绘制())        // 圆形(半径=5.000000)
    矩形 方 = 矩形(3.0, 4.0)
    打印("矩形绘制: ", 方.绘制())        // 矩形(3.000000x4.000000)

    // ---- 2. 类实现多接口：缩放 接口方法 ----
    浮64 新半径 = 圆.缩放(2.0)
    打印("缩放后半径: ", 新半径)          // 10.000000
    打印("缩放后绘制: ", 圆.绘制())      // 圆形(半径=10.000000)

    // ---- 3. 同一接口多个实现类（各自实现）----
    打印("多实现对比: ", 圆.绘制(), " vs ", 方.绘制())
    //  圆形(半径=10.000000) vs 矩形(3.000000x4.000000)

    // ---- 4. 继承的接口实现（子类继承父类实现的接口方法）----
    //  圆形 实现了 可绘制/可缩放；其方法经类虚表分派。
    //  说明：接口类型变量（可绘制* 图形 = &圆; 图形.绘制()）依赖接口附加 vtable
    //    （规格书06-五 预留），当前编译器未实现——E2E 用类实例直接虚调用覆盖接口
    //    实现链路；泛型函数调用（展示<圆形>）单态化注册亦未接入，一并留待
    //    Debug 全面审查子任务/接口 vtable 完善子任务处理。

    打印("===== 接口与实现测试完成 =====")
    返回 0
}
