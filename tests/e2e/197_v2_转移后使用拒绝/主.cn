// E2E 197_v2（v2 负路径闭环，2026-09-10 第五十七轮 plans/019 阶段1）：
//   已转移变量使用拒绝五形态（指针/字符串版，适配 v2 第一版支持面；与宿主
//   197 同主题）：读值（*q）/赋值目标（q = r）/传参（消(q)）/返回（返回 q）/
//   标量误转移（转移(a) 复制语义）。v2 语义诊断+中止（195_v2 同款负路径）。
函数 消(整64* p) -> 整64 {
    返回 0;
}
函数 还回() -> 整64 {
    整64 基 = 5;
    整64* q = &基;
    整64* r = 转移(q);
    返回 整64(q);
}
不安全 函数 主() -> 整32 {
    整64 基 = 5;
    整64* q = &基;
    整64* r = 转移(q);
    整64 v = *q;
    q = r;
    消(q);
    整32 a = 5;
    整32 b = 转移(a);
    返回 0;
}
