// E2E 579（960 轮·131 甲' 转正）：字符串映射<V>——字符串键映射能力补齐。
//   背景：泛型 映射<K,V> 键消费链（== 相等+桶索引 整64(键) 位模式）对字符串键
//   实例化即拒（131·泛形态收口随 166 == 立法轮）——本类=过渡止血：键固定
//   字符串·FNV-1a 逐字节散列+字符串比较 相等·桶+链与泛型版同构。
//   76-a 注入（kStr 按 键数组 字段类型判定+~字符串映射 析构名匹配）随本类扩。
//   判据：功能七项+拷贝构造独立+V=字符串 值形态+双形态零泄漏+泛型版同场对照。
//   〔基准=019〕第三句：完备访问通道并行提供（字符串键映射=必需能力）。
导入 映射集合;
不安全 函数 主() -> 整32 {
    // ---- 一、功能面：增删查改+覆盖+扩容重哈希（15 键触发两轮翻倍）----
    字符串映射<整32> 表 = 字符串映射<整32>();
    结果<空类型, 整32> s1 = 表.设置("甲", 1);
    结果<空类型, 整32> s2 = 表.设置("乙", 2);
    结果<空类型, 整32> s3 = 表.设置("丙", 3);
    结果<整32, 整32> g1 = 表.获取("乙");
    如果 (g1.正常) { 打印(g1.值); } 否则 { 打印("获取乙失败"); 返回 1; }
    如果 (表.包含("丙")) { 打印("包含丙"); }
    如果 (!表.包含("戊")) { 打印("不含戊"); }
    结果<空类型, 整32> s4 = 表.设置("乙", 22);
    结果<整32, 整32> g2 = 表.获取("乙");
    如果 (g2.正常 && g2.值 == 22) { 打印("覆盖22"); }
    结果<空类型, 整32> a1 = 表.设置("k01", 101);
    结果<空类型, 整32> a2 = 表.设置("k02", 102);
    结果<空类型, 整32> a3 = 表.设置("k03", 103);
    结果<空类型, 整32> a4 = 表.设置("k04", 104);
    结果<空类型, 整32> a5 = 表.设置("k05", 105);
    结果<空类型, 整32> a6 = 表.设置("k06", 106);
    结果<空类型, 整32> a7 = 表.设置("k07", 107);
    结果<空类型, 整32> a8 = 表.设置("k08", 108);
    结果<空类型, 整32> a9 = 表.设置("k09", 109);
    结果<空类型, 整32> a10 = 表.设置("k10", 110);
    结果<空类型, 整32> a11 = 表.设置("k11", 111);
    结果<空类型, 整32> a12 = 表.设置("k12", 112);
    布尔 d1 = 表.删除("k05");
    如果 (d1 && !表.包含("k05")) { 打印("删中段k05生效"); }
    结果<整32, 整32> g3 = 表.获取("乙");
    如果 (g3.正常 && g3.值 == 22) { 打印("删后乙仍在"); }
    结果<整32, 整32> g4 = 表.获取("k12");
    如果 (g4.正常 && g4.值 == 112) { 打印("末尾k12仍在"); }
    结果<整32, 整32> g5 = 表.获取("k04");
    如果 (g5.正常 && g5.值 == 104) { 打印("k05邻位k04仍在"); }
    如果 (表.包含("甲")) { 打印("扩容后甲仍在"); }
    布尔 d2 = 表.删除("甲");
    如果 (!d2) { 打印("重复删假错"); } 否则 { 打印("重复删假"); }

    // ---- 二、拷贝构造独立（键深拷·改副本不影响原表）----
    字符串映射<整32> 副本 = 表;
    布尔 d3 = 副本.删除("乙");
    如果 (!表.包含("乙")) { 打印("拷贝独立性错"); } 否则 { 打印("拷贝独立"); }

    // ---- 三、V=字符串 值形态 + 值链/覆盖 ----
    字符串映射<字符串> 名册 = 字符串映射<字符串>();
    结果<空类型, 整32> n1 = 名册.设置("甲", "甲的内容串很长");
    结果<空类型, 整32> n2 = 名册.设置("乙", "乙的内容串也很长");
    结果<字符串, 整32> 取名 = 名册.获取("乙");
    如果 (取名.正常 && 字符串比较(取名.值, "乙的内容串也很长")) { 打印("字符串值链对"); }
    结果<空类型, 整32> 覆 = 名册.设置("甲", "甲的新内容更长一些");
    结果<字符串, 整32> 取2 = 名册.获取("甲");
    如果 (取2.正常 && 字符串比较(取2.值, "甲的新内容更长一些")) { 打印("字符串覆盖对"); }

    // ---- 四、双形态零泄漏（析构注入验收：76-a kStr 字段判定+~字符串映射 匹配）----
    整64 前 = 内存::活动分配数();
    {
        字符串映射<整32> 泄表 = 字符串映射<整32>();
        结果<空类型, 整32> p1 = 泄表.设置("甲乙丙丁", 1);
        结果<空类型, 整32> p2 = 泄表.设置("戊己庚辛", 2);
        字符串映射<整32> 泄副 = 泄表;
        字符串映射<字符串> 泄名 = 字符串映射<字符串>();
        结果<空类型, 整32> p3 = 泄名.设置("键", "值串内容很长很长");
    }
    整64 后 = 内存::活动分配数();
    如果 (前 == 后) { 打印("双形态零泄漏"); } 否则 { 打印("泄漏差: ", 后 - 前); }

    // ---- 五、泛型版同场对照（零回归锚）----
    映射<整64, 整32> 对照 = 映射<整64, 整32>();
    结果<空类型, 整32> c1 = 对照.设置(7, 70);
    结果<整32, 整32> c2 = 对照.获取(7);
    如果 (c2.正常 && c2.值 == 70) { 打印("泛型对照对"); }
    返回 0;
}
