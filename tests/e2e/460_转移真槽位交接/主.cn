// E2E 460_转移真槽位交接（459-a·plans/022 波 4 首件 206-d）：
//   转移(x) 真槽位交接四形态矩阵——①声明初始化位·字符串 ②实参位·字符串
//   ③声明初始化位·容器 ④实参位·容器（459-a 解锁：kind 2 表达式位放行）。
//   断言口径：接收位值正确 + 每形态分配增量恒为 0（真槽位交接零拷贝——
//   内存::总分配次数() 差值）+ moved-from 再用=编译期拒绝（197 族锚已有）。
//   实现面：语义层 kind 2 表达式位放行（semantic_call.cpp）+IR 转移展开源槽
//   清零（ir_call.cpp·Store 0——与声明位 ir_stmt_decl 浅交接分派同构）。
导入 容器::向量;
导入 IO::打印;
函数 吃字符串(字符串 s) -> 整64 { 返回 字符串长度(s); }
函数 吃向量(向量<整32> v) -> 整64 { 返回 v.大小(); }
函数 主() -> 整32 {
    // ① 声明初始化位·字符串：句柄直拷+源槽清零（零分配）
    字符串 s1 = 字符串复制("甲乙丙丁");
    整64 a0 = 内存::总分配次数();
    字符串 s2 = 转移(s1);
    整64 a1 = 内存::总分配次数();
    打印(s2);
    打印(a1 - a0);
    // ② 实参位·字符串：句柄移交被调方+源槽清零（零分配）
    字符串 t1 = 字符串复制("甲乙丙丁戊");
    整64 b0 = 内存::总分配次数();
    整64 n = 吃字符串(转移(t1));
    整64 b1 = 内存::总分配次数();
    打印(n);
    打印(b1 - b0);
    // ③ 声明初始化位·容器：浅交接分派（零分配·ir_stmt_decl 既有+459-a 同构）
    向量<整32> a = 向量<整32>();
    结果<空类型, 整32> r1 = a.追加(11);
    结果<空类型, 整32> r2 = a.追加(22);
    结果<空类型, 整32> r3 = a.追加(33);
    整64 c0 = 内存::总分配次数();
    向量<整32> b = 转移(a);
    整64 c1 = 内存::总分配次数();
    打印(b.大小());
    打印(c1 - c0);
    // ④ 实参位·容器（459-a 解锁）：句柄移交+源槽清零（零分配）
    向量<整32> v = 向量<整32>();
    结果<空类型, 整32> q1 = v.追加(11);
    结果<空类型, 整32> q2 = v.追加(22);
    整64 d0 = 内存::总分配次数();
    整64 m = 吃向量(转移(v));
    整64 d1 = 内存::总分配次数();
    打印(m);
    打印(d1 - d0);
    返回 0;
}
