// 186：v2 构造字面量赋值位闭环（观察项③，Rust 同构：目标 place 逐字段写）——
//   p = 点{...} 标识符目标 / r.右下 = 点{...} 成员目标 / 声明位嵌套构造下钻展平；
//   穷举纪律与声明位同源单一助手（缺字段负测见 187）。
//   验证通道=成员实参（成员作值读系 v2 既有边界，见 HANDOFF 观察项）。
结构体 点 {
    整32 x
    整32 y
}
结构体 矩形 {
    点 左上
    点 右下
}
函数 求和(点 p) -> 整32 {
    返回 p.x * 10 + p.y;
}
函数 主() -> 整32 {
    点 p;
    p = 点{ x = 7, y = 9 };
    整32 s1 = p.x + p.y;
    矩形 r = 矩形{ 左上 = 点{ x = 1, y = 2 }, 右下 = 点{ x = 3, y = 4 } };
    r.右下 = 点{ x = 5, y = 6 };
    整32 s2 = 求和(r.左上);
    整32 s3 = 求和(r.右下);
    返回 s1 + s2 + s3;
}
