公开:
// 671 模块内两件：JSON树 同构面（标量+多向量+构造器析构）+ 持指针字段的解析器
//   形态（字段=类类型·方法内经裸类指针字段写字段=362 触发形态最小化）
导入 容器::向量;
类 数据树 {
公开:
    整64 根;
    整64 错误码;
    向量<整64> 类型们;
    向量<字符串> 文本们;
    函数 数据树() {
        根 = 0 - 1;
        错误码 = 0;
        类型们 = 向量<整64>();
        文本们 = 向量<字符串>();
    }
    不安全 函数 ~数据树() {
    }
    函数 重置(整64 码) {
        根 = 0 - 1;
        错误码 = 码;
    }
}
类 树解析器 {
公开:
    字符串 源;
    整64 位;
    数据树* 树;
    函数 树解析器() {
        源 = "";
        位 = 0;
        树 = 无;
    }
    不安全 函数 ~树解析器() {
    }
    // 362 形态锚：方法内经 类指针字段（裸名）写 所指类字段——
    //   修复前=「成员左值字段偏移未知: 错误码」中止代码生成
    不安全 函数 记错(整64 码) -> 整64 {
        树.错误码 = 码;
        树.根 = 0 - 1;
        返回 0 - 1;
    }
}
