// 官网文档示例 · reference/types.html · 转换（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
函数 主() -> 整32 {
    正64 位模式 = 正64(整32(-1));     // 符号扩展 → 2^64-1
    整64 重解释 = 整64(位模式);       // 位模式重解释（全 1 位模式）
    整32 截断 = 整32(3.99);
    打印(位模式 == 18446744073709551615, " ", 截断);
    打印(重解释 == 0 - 1);            // 全 1 位模式 = -1
    返回 0;
}