// E2E 907（2026-10-14 任务644·P1·传参位拥有串临时实参——收下句柄面）：
//   「调用(造串())」形态——用户函数传参位的拥有串临时实参，须在调用发射后
//   收下句柄（__cn_str_free）。此前双侧同漏（宿主/v2 探针⑩实锤）：每调用
//   净泄 1。本用例=泄漏量化的运行级防线（230/216 同款断言口径）。
//   断言面：
//     ① 非消耗形参（只读借用·零拷贝直传）——循环 100 次调用位临时净泄 0
//     ② 消耗形参（体内重赋值=ownedConsumed·入口深拷独立副本）——同断言
//     ③ 混合实参错位面（串临时居首+整数实参随后）——释放对应正确不串位
//   内容校验防假绿：串真分配、真传递、真释放（分配数差值+内容双断言）。
//   语义边界（与 102 甲案「消耗形参 prologue 深拷」互洽）：临时生命周期至
//   完整表达式尾（C++ full-expression 同规）——被调方外存借用句柄=借用违约，
//   非本释放面义务（泄漏与悬垂不可兼得时以 090「默认=值副本」立法为准绳）。
//   校验和折位：①1 ②2 ③4 —— 退出码 7=全对；任一形态泄漏=差值非 0=该校
//   验位丢失=退出码变化=对照失败。

// 临时串源（每次调用新分配——内容校验保证分配真实发生）
函数 造串() -> 字符串 {
    返回 字符串复制("传参位临时串占位内容甲乙丙丁戊己庚辛");
}

// ① 非消耗形参：只读借用（体内零赋值零转移=零拷贝直传）
函数 吃串只读(字符串 s) -> 整64 {
    如果 (字符串比较(s, "传参位临时串占位内容甲乙丙丁戊己庚辛")) { 返回 1; }
    返回 0;
}
函数 形一() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    整64 i = 0;
    当 (i < 100) {
        校验 = 校验 + 吃串只读(造串());
        i++;
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 != 100) { 返回 0; }
    返回 1;
}

// ② 消耗形参：体内重赋值触发 ownedConsumed（入口 prologue 深拷独立副本）
函数 吃串消耗(字符串 s) -> 整64 {
    s = 字符串复制("消耗形参重赋值占位内容");
    如果 (字符串比较(s, "消耗形参重赋值占位内容")) { 返回 1; }
    返回 0;
}
函数 形二() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    整64 i = 0;
    当 (i < 100) {
        校验 = 校验 + 吃串消耗(造串());
        i++;
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 != 100) { 返回 0; }
    返回 2;
}

// ③ 混合实参错位面：串临时居首+整数实参随后（倒序弹参对应正确性——
//   释放挂错槽=整数寄存器被 free 或串漏释放，校验即崩/即红）
函数 吃两个(字符串 s, 整64 n) -> 整64 {
    如果 (字符串比较(s, "传参位临时串占位内容甲乙丙丁戊己庚辛") && n == 7) { 返回 1; }
    返回 0;
}
函数 形三() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    整64 i = 0;
    当 (i < 100) {
        校验 = 校验 + 吃两个(造串(), 7);
        i++;
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 != 100) { 返回 0; }
    返回 4;
}

函数 主() -> 整32 {
    整64 和 = 0;
    和 = 和 + 形一();
    和 = 和 + 形二();
    和 = 和 + 形三();
    返回 整32(和);
}
