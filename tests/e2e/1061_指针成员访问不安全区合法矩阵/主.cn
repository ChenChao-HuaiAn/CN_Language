// E2E 1061（926 正例·不安全区合法矩阵锁面）：不安全 函数内指针成员访问全形态
//   合法（B9 豁免）——读/写/复合写/后缀自增/显式单解引用/显式一级解引用多级指针。
//   与 1060 负例成对（同一安全区边界判定的放行面锚）：宿主 assignmentTargetDepth_
//   抑制（写形态不报）与显式解引用 N-k 差分（(*p) 抵销后非指针）在双侧一致。
//   期望：61（打印 逐行）。
结构体 点 {
    整32 x;
    整32 y;
}

不安全 函数 矩阵() -> 整32 {
    点 值 = 点{ x = 1, y = 2 };
    点* p = &值;
    点** pp = &p;
    整32 累计 = 0;
    累计 = 累计 + p.x;          // 读（1）
    p.y = 20;                   // 成员写
    累计 = 累计 + 值.y;          // 20 → 21
    p.x += 5;                   // 复合写（p.x=6）
    累计 = 累计 + p.x;          // 6 → 27
    p.x++;                      // 后缀自增（p.x=7）
    累计 = 累计 + p.x;          // 7 → 34
    累计 = 累计 + (*p).y;        // 显式单解引用读（20） → 54
    累计 = 累计 + (*pp).x;       // 显式一级解引用·左侧非多级（7） → 61
    返回 累计;
}

函数 主() -> 整32 {
    打印(矩阵());
    返回 0;
}
