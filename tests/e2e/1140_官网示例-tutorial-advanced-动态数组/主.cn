// 官网文档示例 · tutorial-advanced.html · 手动内存（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
不安全 函数 主() -> 整32 {   // 手动内存=不安全域
    整64* 表 = 分配(4 * 类型大小(整64));   // 4 个整64 槽
    循环 (整64 i = 0; i < 4; i++) { 表[i] = (i + 1) * 100; }
    空类型* 更大块 = 重新分配(表, 8 * 类型大小(整64));
    整64* 大表 = 更大块;                     // 旧值保留
    打印(大表[0], " ", 大表[3]);
    释放(大表);
    返回 0;
}