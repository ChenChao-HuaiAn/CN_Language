// 879 嵌套链字段写窄域分派（#597 锁面·2026-10-14 dual）
// 立账=589 采样轮（分支 ad39fb3b）：宿主 memberAssignObjSrcType 漂移副本缺
//   MemberExpr 分支 → 嵌套成员链（盒.芯.里.a / 局.里.a）写 targetType 落默认
//   i64 → StorePtr 恒 8B 宽写覆盖相邻字段（asm 铁证 mov [rax],rcx vs 一级
//   窄写 ecx·整8/整16 窄域破坏面更大）。修=memberAssignObjSrcType 整体委托
//   memberObjStructType 单一实现（+Deref 分支搬入）——写宽度按字段类型精确
//   分派（byte/word/dword ptr）。本用例四形态锁面：
//   ① 类字段嵌套链二次写（首写邻字段须存活）②局部变量嵌套链 ③窄域整8/整16
//   ④下标元素嵌套链（方形.顶点[0].x）。v2 侧全形态本就对（对照绿）。
结构体 内层 {
    整32 a;
    整32 b;
}
结构体 外层 {
    内层 里;
}
类 盒子 {
公开:
    外层 芯;
}
结构体 窄组 {
    整8 小;
    整8 中;
    整16 大;
}
结构体 坐标 {
    整32 x;
    整32 y;
}
结构体 方形 {
    坐标[2] 顶点;
    整32 标记;
}
函数 主() -> 整32 {
    // ① 类字段嵌套链二次写
    盒子 盒;
    盒.芯.里.a = 5;
    盒.芯.里.b = 6;
    盒.芯.里.a = 50;
    如果 (盒.芯.里.a != 50 || 盒.芯.里.b != 6) { 返回 1; }
    // ② 局部变量嵌套链
    外层 局;
    局.里.a = 5;
    局.里.b = 6;
    局.里.a = 51;
    如果 (局.里.a != 51 || 局.里.b != 6) { 返回 2; }
    // ③ 窄域整8/整16（邻域字节不得被清）
    盒子 窄盒;
    窄盒.芯.里.a = 0;
    窄组 窄;
    窄.小 = 7;
    窄.中 = 8;
    窄.大 = 999;
    窄.小 = 77;
    如果 (窄.小 != 77 || 窄.中 != 8 || 窄.大 != 999) { 返回 3; }
    // ④ 下标元素嵌套链（数组字段元素的字段·二次写）
    方形 局方;
    局方.顶点[0].x = 5;
    局方.顶点[0].y = 6;
    局方.顶点[1].x = 7;
    局方.标记 = 9;
    局方.顶点[0].x = 55;
    如果 (局方.顶点[0].x != 55 || 局方.顶点[0].y != 6 ||
         局方.顶点[1].x != 7 || 局方.标记 != 9) { 返回 4; }
    打印("①=", 盒.芯.里.a, " ", 盒.芯.里.b);
    打印("②=", 局.里.a, " ", 局.里.b);
    打印("③=", 窄.小, " ", 窄.中, " ", 窄.大);
    打印("④=", 局方.顶点[0].x, " ", 局方.顶点[0].y, " ", 局方.顶点[1].x, " ", 局方.标记);
    返回 0;
}
