// E2E 1700（#1950·2026-11-01）：类字段级联释放警告双编译对照锁面——
//   #1943 修后宿主对「字段类有析构 ∧ 外层类无析构」发级联释放警告
//   （semantic checkClassMethods 缺陷3 警告面·001 §5.6 #1674 三法则强制
//   提醒通道），v2 无此警告=诊断面分叉。本轮 v2 补齐（检查级联释放警告·
//   语义期沿链节点附加版），本用例锁双侧：
//   触发形态族：A 直连触发 / E 沿链（字段类自身无析构+基类有析构）/
//   F 多字段只报首个 / G 容器字段（实例合成名 向量$字符串·v2 剥基名等价）/
//   I 继承字段（基P 声明→派Q 沿 fieldOrder 并入重复警告·同字段行）；
//   不触发形态族：B 外层有析构 / C 字段类无析构 / D 指针字段 /
//   H 手动释放<T> 字段（#1674 乙案用户接管）。
//   警告=非错误不阻断编译——退出码=各形态值校验和（触发/不触发形态的
//   构造与字段读写全部正确才算绿·任一侧警告误伤为错误=退出码变红）。
//   v2 警告文案经 .expected 锚行逐字锁定（v2p stderr·dual 编译日志对拍）。
导入 容器::向量;

类 内C {
公开:
    整32 v;
    函数 内C() { v = 7; }
    函数 ~内C() { }
}

类 无D {
公开:
    整32 v;
    函数 无D() { v = 1; }
}

类 基A {
公开:
    函数 ~基A() { }
}

类 派B : 基A {
公开:
    整32 v;
    函数 派B() { v = 3; }
}

类 内E {
公开:
    整32 v;
    函数 内E() { v = 5; }
    函数 ~内E() { }
}

// A 触发：外层无析构+字段类有析构
类 外A {
公开:
    内C 里的;
}

// B 不触发：外层有析构
类 外B {
公开:
    内C 里的;
    函数 ~外B() { }
}

// C 不触发：字段类无析构
类 外C {
公开:
    无D 里的;
}

// D 不触发：指针字段（非类值拥有）
类 外D {
公开:
    内C* 里的;
}

// E 触发（沿链）：字段类自身无析构+基类有析构
类 外E {
公开:
    派B 里的;
}

// F 触发（多字段只报首个）
类 外F {
公开:
    内C 甲;
    内E 乙;
}

// G 触发（容器字段·实例合成名）
类 外G {
公开:
    向量<字符串> 表;
}

// H 不触发：手动释放<T>（用户接管释放权）
类 外H {
公开:
    手动释放<内C> 里的;
}

// I 触发（继承字段·基P 与 派Q 各一条·同字段行）
类 基P {
公开:
    内C 里的;
}

类 派Q : 基P {
公开:
}

函数 主() -> 整32 {
    外A a;
    外B b;
    外C c;
    外D d;
    外E e;
    外F f;
    外G g;
    外H h;
    基P p;
    派Q q;
    结果<空类型, 整32> 追加r = g.表.追加("载荷");
    如果 (!追加r.正常) { 返回 0; }
    // 注：q.里的（派Q 继承字段）不读——宿主「派生类继承类字段的合成构造
    //   级联」运行面缺口（#1950 轮探针实录·另行立项）；本用例锁其警告面
    //   （编译期·派Q 警告照发），运行面不触碰该字段。
    整32 和 = a.里的.v + b.里的.v + c.里的.v;
    和 = 和 + e.里的.v + f.甲.v + f.乙.v;
    和 = 和 + 整32(g.表.大小() * 100);
    和 = 和 + p.里的.v;
    返回 和;
}
