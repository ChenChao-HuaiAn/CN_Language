// E2E 265（宿主负测，2026-09-17 第一百五十七轮 157-a plans/023 §十 步骤 5 收口）：
//   安全区边界硬错误——安全函数内裸操作=编译失败（观察期结束；Rust E0133 同构：
//   非 unsafe 上下文做 unsafe 操作=编译期拒绝）。覆盖 B6/B7/A1/A3/B10/A5 六类，
//   期望诊断子串 [安全区边界]（期望编译失败.txt）。
联合体 数值 {
    整32 甲;
    浮64 乙;
}
静态 整64 计数 = 0;
函数 主() -> 整32 {
    整64 x = 5;
    整64* p = &x;
    整64 v = *p;           // B6 裸指针解引用读
    *p = 7;                // B7 裸指针解引用写
    p = p + 1;             // A1 指针算术
    数值 u;
    u.甲 = 3;              // A3 联合体字段访问
    计数 = 计数 + 1;       // B10 静态变量写
    释放(p);               // A5 裸释放
    打印(v);
    返回 0;
}
