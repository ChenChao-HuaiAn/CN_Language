导入 容器::向量
导入 文件::打开文件
导入 文件::读取文件行
导入 文件::关闭文件
导入 文件::写入文件
导入 CN语言编译器::IR生成
导入 CN语言编译器::代码生成

函数 读全部(空类型* 句柄) -> 字符串 {
    字符串 全部 = ""
    结果<字符串, 整32> 行结果 = 读取文件行(句柄)
    当 (真) {
        如果 (行结果.正常) {
            全部 = 全部 + 行结果.值
        } 否则 {
            中断
        }
        行结果 = 读取文件行(句柄)
    }
    返回 全部
}

// 编译单个模块：读源码 -> IR生成 -> 代码生成 -> 写 asm 文件
// 输出路径由参数指定（E2E 79 闭环：第一次/第二次产物分目录落盘）
函数 编译模块(字符串 源码路径, 字符串 模块名, 字符串 输出路径) -> 整32 {
    结果<空类型*, 整32> 打开结果 = 打开文件(源码路径, 1)
    如果 (打开结果.正常) {
        字符串 源码 = 读全部(打开结果.值)
        关闭文件(打开结果.值)
        向量<字符串> IR行 = IR生成(源码, 模块名)
        向量<字符串> asm行 = 代码生成(IR行)
        结果<空类型*, 整32> 写结果 = 打开文件(输出路径, 2)
        如果 (写结果.正常) {
            整64 i = 0
            当 (i < asm行.大小()) {
                结果<整64, 整32> 写 = 写入文件(写结果.值, asm行.元素(i) + "\n")
                如果 (写.正常) {
                    i++
                } 否则 {
                    打印("写入失败")
                    返回 1
                }
            }
            关闭文件(写结果.值)
            打印("完成:" + 模块名)
            返回 0
        }
        打印("写打开失败:" + 输出路径)
        返回 1
    }
    打印("打开失败:" + 源码路径)
    返回 1
}

// 主入口：编译 5 个组件源码到指定输出目录（由命令行参数 argv[1] 指定）
// 默认输出到 target/audit2/（与 78 用例一致）
函数 主() -> 整32 {
    字符串 输出目录 = "target/audit2/"
    编译模块("CN语言编译器/词法分析.cn", "词法分析", 输出目录 + "词法分析_链.asm")
    编译模块("CN语言编译器/语法分析.cn", "语法分析", 输出目录 + "语法分析_链.asm")
    编译模块("CN语言编译器/语义分析.cn", "语义分析", 输出目录 + "语义分析_链.asm")
    编译模块("CN语言编译器/IR生成.cn", "IR生成", 输出目录 + "IR生成_链.asm")
    编译模块("CN语言编译器/代码生成.cn", "代码生成", 输出目录 + "代码生成_链.asm")
    返回 0
}
