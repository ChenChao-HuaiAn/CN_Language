// E2E 753（#488 锁用例·正测 dual·752 对偶）：混合符号复合赋值的合法
//   通道 + 零扰动面——①显式转换改写（甲 += 正32(乙)·诊断指路形态）；
//   ②字面量豁免（甲 += 1·191 锚同款；一元负号负字面量对正族目标会撞
//   474 运行期溢出检查=另一立法面·不在本用例锁面）；③同符号
//   混合宽度宽化（整32 += 整64 / 正32 += 正64——混合符号只拦符号相异）。
//   双侧同绿锁：宿主补拦后放行面不被误伤（w19 放行面中合法部分的回归锚）。
函数 主() -> 整32 {
    // ①显式转换改写：正32 甲 += 整64 乙 → 甲 += 正32(乙)（乙取域内正值——
    //   显式转换=位模式重解释，负值形态正32(-1)=4294967295 会撞 474 溢出
    //   检查错误码 8，属另一立法面；本用例只锁改写通道合法性）
    正32 甲 = 5;
    整64 乙 = 7;
    甲 += 正32(乙);
    甲 += 1;
    // ③同符号混合宽度宽化：整32 += 整64（有符号族内）/ 正32 += 正64（无符号族内）
    整32 和 = 100;
    整64 宽 = 27;
    和 += 宽;
    正32 无甲 = 10;
    正64 无宽 = 20;
    无甲 += 无宽;
    // 同型复合赋值零扰动（正8 += 正8 窄域字面量）
    正8 窄 = 100;
    正8 增 = 27;
    窄 += 增;
    打印(甲);
    打印(和);
    打印(无甲);
    打印(窄);
    返回 0;
}
