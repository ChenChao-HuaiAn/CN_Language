// E2E 249（2026-09-12 第八十九轮 89-a，plans/020 移植纪律 9 门禁化·第十八个对照用例）：
//   **浮点字面量全链路（值装载/相等比较/实参/返回/三元/短路/静态初值/循环稳定）**——
//   同一份源码经宿主真实管线与 v2 自举链各编译运行，两侧退出码须相等。
//   背景（88-b 净栈契约出口校验探针实证）：v2 IR 层 节点_浮点字面量 无任何发射
//   分派——① 表达式位被**静默跳过**：二元弹栈判定退化（操作数缺失 → 左右均取
//   寄存器 0 → `cmp x,x` 恒真，宿主的 3.5==2.5 拒绝分支在 v2 侧恒进入）；
//   ② 净栈 +2 契约违反（88-b 出口校验当场诊断 `[ir2] 表达式净栈契约违反(多压)`）；
//   ③ 静态浮点初值注入落空（87-a 注入经 生成表达式 求值——.data 恒 0 且无入口
//   写回）。89-a 根治：IR 层主循环分派 + 生成字面量 浮点分支（IR_常量浮点）+
//   三后端 .double/REAL8 文本直通（IEEE754 由汇编器解析，编译期零开销）。
//   八形态（两侧共有语义面；浮点仅相等/不等——算术运算、大小比较与打印为 v2
//   既有边界不在面内）：
//     ① 静态浮点初值 + 相等比较（真向进入/假向不进入，双向锚定）
//     ② 局部浮点变量 + 字面量比较（真/假双向）
//     ③ 浮点字面量作实参（判等(3.5, 3.5) 真 / (3.5, 2.5) 假）
//     ④ 浮点字面量作返回值（函数体 返回 3.5——调用侧比较）
//     ⑤ 三元分支选浮点字面量（真 ? 3.5 : 2.5 + 与变量比较）
//     ⑥ 短路右操作数中的浮点比较（标 && 局 == 3.5）
//     ⑦ 字面量在左操作数位（3.5 == 3.5 真 / 2.5 == 3.5 假）
//     ⑧ 循环 2000 轮字面量比较（位模式装载稳定性）
//   校验和折位：①1 ②2 ③4 ④8 ⑤16 ⑥32 ⑦64 ⑧128 —— 255=全对。
//   平台守卫=linux 双平台（宿主与 v2 同链；win-x64 v2 产物未隔离=家机轮）。
导入 容器::向量;

静态 浮64 静甲 = 3.5;

函数 判等(浮64 值, 浮64 期) -> 布尔 {
    返回 值 == 期;
}

函数 取浮() -> 浮64 {
    返回 3.5;
}

// ① 静态浮点初值 + 相等比较（真/假双向）
函数 形一() -> 整64 {
    整64 位 = 0;
    如果 (静甲 == 3.5) { 位 = 位 + 1; }
    如果 (静甲 == 2.5) { 位 = 位 + 128; }
    如果 (位 == 1) { 返回 1; }
    返回 0;
}

// ② 局部浮点变量 + 字面量比较（真/假双向）
函数 形二() -> 整64 {
    浮64 局 = 3.5;
    整64 位 = 0;
    如果 (局 == 3.5) { 位 = 位 + 1; }
    如果 (局 == 2.5) { 位 = 位 + 128; }
    如果 (位 == 1) { 返回 2; }
    返回 0;
}

// ③ 浮点字面量作实参
函数 形三() -> 整64 {
    整64 位 = 0;
    如果 (判等(3.5, 3.5)) { 位 = 位 + 1; }
    如果 (判等(3.5, 2.5)) { 位 = 位 + 128; }
    如果 (位 == 1) { 返回 4; }
    返回 0;
}

// ④ 浮点字面量作返回值
函数 形四() -> 整64 {
    如果 (取浮() == 3.5) { 返回 8; }
    返回 0;
}

// ⑤ 三元分支选浮点字面量
函数 形五() -> 整64 {
    浮64 局 = 3.5;
    浮64 值 = 真 ? 3.5 : 2.5;
    整64 位 = 0;
    如果 (值 == 3.5) { 位 = 位 + 1; }
    如果 (局 == 值) { 位 = 位 + 1; }
    如果 (值 == 2.5) { 位 = 位 + 128; }
    如果 (位 == 2) { 返回 16; }
    返回 0;
}

// ⑥ 短路右操作数中的浮点比较
函数 形六(布尔 标) -> 整64 {
    浮64 局 = 3.5;
    如果 (标 && 局 == 3.5) { 返回 32; }
    返回 0;
}

// ⑦ 字面量在左操作数位
函数 形七() -> 整64 {
    整64 位 = 0;
    如果 (3.5 == 3.5) { 位 = 位 + 1; }
    如果 (2.5 == 3.5) { 位 = 位 + 128; }
    如果 (位 == 1) { 返回 64; }
    返回 0;
}

// ⑧ 循环 2000 轮字面量比较
函数 形八(整64 轮数) -> 整64 {
    整64 中 = 0;
    整64 i = 0;
    当 (i < 轮数) {
        如果 (3.5 == 3.5) { 中 = 中 + 1; }
        i = i + 1;
    }
    如果 (中 == 轮数) { 返回 128; }
    返回 0;
}

函数 主() -> 整32 {
    整64 和 = 0;
    和 = 和 + 形一();
    和 = 和 + 形二();
    和 = 和 + 形三();
    和 = 和 + 形四();
    和 = 和 + 形五();
    和 = 和 + 形六(真);
    和 = 和 + 形七();
    和 = 和 + 形八(2000);
    打印("校验和(期望255)=", 和);
    返回 整32(和 % 256);
}
