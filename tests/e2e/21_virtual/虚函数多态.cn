// Task 3.2 虚函数与多态 E2E 测试
// 覆盖：虚拟 函数 声明/重写 函数 覆盖/虚调用动态分派（对象实际类型决定实现）/
//       父类.方法() 显式调用父类实现/多级继承虚表继承
// 语法依据（cn-language-spec 06-四）：虚拟 声明多态函数（vtable 分发）、
//   重写 显式标注子类覆盖（编译期校验签名匹配）；调用虚函数经 vtable 间接跳转
// 打印语义（用户裁决）：打印=println（自动换行）

类 动物 {
公开:
    字符串 名称;

    函数 动物(字符串 名) {
        名称 = 名;
    }

    虚拟 函数 叫声() -> 字符串 {
        返回 "...";
    }

    // 表演 方法体内调用虚函数 叫声()：经 this 虚表动态分派——
    //   子类对象调用 表演() 时，叫声() 分派到子类实现（多态核心演示）
    函数 表演() -> 字符串 {
        返回 名称 + "表演: " + 自身.叫声();
    }
}

类 狗 : 动物 {
公开:
    函数 狗(字符串 名) {
        父类.名称 = 名;
    }

    重写 函数 叫声() -> 字符串 {
        // 父类.方法()：静态限定调用父类实现（非虚分派）
        返回 父类.叫声() + "汪汪";
    }
}

类 猫 : 动物 {
公开:
    函数 猫(字符串 名) {
        父类.名称 = 名;
    }

    重写 函数 叫声() -> 字符串 {
        返回 "喵喵";
    }
}

// 多级继承：导盲犬 继承 狗（虚表沿继承链传递：导盲犬 无自身重写时虚表继承 狗.叫声）
类 导盲犬 : 狗 {
公开:
    函数 导盲犬(字符串 名) {
        父类.名称 = 名;
    }

    函数 引路() -> 字符串 {
        返回 名称 + "正在引路";
    }
}

函数 主() -> 整32 {
    打印("===== 虚函数与多态（Task 3.2）=====");

    // ---- 1. 子类对象直接虚调用（经对象虚表分派到子类实现）----
    狗 小狗 = 狗("旺财");
    打印("狗叫声: ", 小狗.叫声());           // 父类.叫声() + "汪汪" = "...汪汪"
    猫 小猫 = 猫("咪咪");
    打印("猫叫声: ", 小猫.叫声());           // 喵喵

    // ---- 2. 多态核心：父类方法体内虚调用动态分派 ----
    //  表演() 定义在 动物，方法体内 自身.叫声() 虚调用——
    //  小狗.表演() 分派到 狗.叫声()，小猫.表演() 分派到 猫.叫声()
    打印("狗表演: ", 小狗.表演());           // 旺财表演: ...汪汪
    打印("猫表演: ", 小猫.表演());           // 咪咪表演: 喵喵

    // ---- 3. 父类.方法() 静态限定调用（非虚分派）----
    //  狗.叫声() 内部 父类.叫声() 直接调用 动物.叫声()（不进入虚表）
    打印("父类限定: ", 小狗.叫声());         // ...汪汪

    // ---- 4. 多级继承：导盲犬 继承 狗，未重写 叫声() -> 虚表继承 狗.叫声 ----
    导盲犬 阿黄 = 导盲犬("阿黄");
    打印("导盲犬叫声: ", 阿黄.叫声());       // ...汪汪（继承 狗 的重写）
    打印("导盲犬引路: ", 阿黄.引路());       // 阿黄正在引路
    打印("导盲犬表演: ", 阿黄.表演());       // 阿黄表演: ...汪汪（虚表继承链分派）

    // ---- 5. 三种动物虚调用结果对比（动态分派一致性）----
    打印("动物虚表: ", 小狗.叫声(), " / ", 小猫.叫声(), " / ", 阿黄.叫声());
    //  ...汪汪 / 喵喵 / ...汪汪

    // 注意：类对象为堆指针，变量赋值共享同一对象（无拷贝构造语义），
    //   RAII 自动释放会对共享对象重复释放导致堆损坏——本用例避免类变量互赋值，
    //   聚焦 Task 3.2 虚函数多态验证（编译器已知语义局限留待 Debug 审查子任务）。

    打印("===== 虚函数与多态测试完成 =====");
    返回 0;
}
