// 主入口（Task 3.6 模块系统 E2E，规格书08-四：主.cn 为入口）
// 覆盖：导入 模块::符号 / 导入 模块::{名1, 名2} / 公开符号跨模块可见 /
//       模块限定调用（数学::函数()）/ 私有符号不跨模块（内部辅助 仅模块内）
// 说明：私有符号跨模块访问（数学::内部辅助）由语义层报错（单测覆盖），
//   E2E 只验证公开符号正向链路。
// 打印语义（用户裁决）：打印=println（自动换行）

导入 数学::平方根
导入 数学::{双倍, 三倍}

函数 主() -> 整32 {
    打印("===== 模块系统（Task 3.6）=====")

    // ---- 1. 导入 模块::符号：模块限定调用 ----
    浮64 根 = 数学::平方根(16.0)
    打印("平方根: ", 根)                    // 16.000000

    // ---- 2. 花括号导入：直接调用 ----
    整32 加倍 = 双倍(21)
    打印("双倍: ", 加倍)                    // 42

    // ---- 3. 多符号花括号导入 + 限定调用混用 ----
    浮64 根2 = 数学::平方根(9.0)
    整32 加2 = 双倍(双倍(3))                // 12
    打印("组合: ", 根2, " ", 加2)          // 9.000000 12

    // ---- 4. 公开函数体引用私有符号（缺陷4 修复验证）：三倍 内部调用 内部辅助 ----
    整32 三倍结果 = 三倍(10)
    打印("三倍: ", 三倍结果)               // 30（私有依赖闭包合并）

    打印("===== 模块系统测试完成 =====")
    返回 0
}
