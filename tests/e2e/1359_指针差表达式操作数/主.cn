// E2E 1359_指针差表达式操作数（1064·#1040 派生缺口正例 dual）：001 §5.3 清单 #1
//   同型指针差的操作数扩展——表达式操作数（(p+1)/(p+n) 等 ± 链·丢星族收口）与
//   标识符对同判：不安全函数内同型放行·结果=有符号整64 元素个数=(地址差)/元素宽。
//   覆盖：整32* 链双向差 + 表达式×变量混合 + 嵌套链 + 数组名退化 + 整8* 单位宽
//   边界 + 结构体* 总大小步进 + 赋值位整64 + 函数返回位 + 差结果参与算式。
//   期望 stdout：1 / -1 / 3 / 2 / 0 / -1 / 1 / -1 / 11 / 1 / 5 / 4 / 3 / -1。
不安全 函数 求长度(整32* 首, 整32* 尾) -> 整64 {
    返回 (尾 + 1) - 首;
}
结构体 盒子 {
    整64 甲;
    整64 乙;
}
不安全 函数 主() -> 整32 {
    整32[5] 表 = {10, 20, 30, 40, 50};
    整32* p = &表[0];
    整32* q = &表[2];
    打印((p + 1) - p);
    打印(p - (p + 1));
    打印((p + 3) - p);
    打印(((p + 1) + 1) - p);
    打印((p + 1) - (p + 1));
    打印((p + 1) - q);
    打印((表 + 1) - 表);
    整32 n = 2;
    打印(((p + 1) - n) - p);
    打印(((p + 1) - p) + 10);
    整64 甲 = (p + 1) - p;
    打印(甲);
    打印(求长度(p, &表[4]));
    整8[5] 字节表 = {1, 2, 3, 4, 5};
    整8* b = &字节表[0];
    打印((b + 4) - b);
    盒子[4] 盒表 = { 盒子{ 甲 = 1, 乙 = 1 }, 盒子{ 甲 = 2, 乙 = 2 },
                    盒子{ 甲 = 3, 乙 = 3 }, 盒子{ 甲 = 4, 乙 = 4 } };
    盒子* h = &盒表[0];
    打印((h + 3) - h);
    打印(h - (h + 1));
    返回 0;
}
