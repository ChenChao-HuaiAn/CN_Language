// 546（857 轮·任务 072 x64l 面收口）：窄整（整8/整16）→整128 转换全语境
//   背景：emitCast「整数扩展（i8/i16/u8/u16 源）」分支不检查 to 提前 return——
//   窄8/16→i128 被截胡只发 64 位低半，高半槽从未发射=未初始化栈垃圾
//   （实测 -3 物化成 -3×2^64·O0/O3 同病·静默错值违双目标②）。修复=128 目标
//   两分支（同类型双槽复制+普通整数→128）整体前置（特例先于通例）。
//   覆盖：局部/静态/字段/实参返回/显式转换/槽复用干扰/负值判定。
//   ★ v2 欠账（C24 域·857 轮立）：v2p 对 128 位声明初值窄型表达式编译期拒绝
//   （「须为整数字面量或 128 位表达式」·诚实拒绝非错值）——本用例暂为宿主侧，
//   v2 窄→128 通道实现后转双测对照（见 021 §三 欠账行）。
//   折叠免疫设计（对齐 545）：静态变量中转构造运行期值。
静态 整8 负三 = 整8(0 - 3);
静态 整16 负三百 = 整16(0 - 300);

结构体 盒
{
    整128 大;
}

函数 吃128(整128 入) -> 整128 { 返回 入; }

函数 主() -> 整32
{
    整128 a = 负三;
    打印行("局8=", a);
    打印("");
    整128 b = 负三百;
    打印行("局16=", b);
    打印("");
    静态 整128 静甲 = 负三;
    打印行("静8=", 静甲);
    打印("");
    盒 h = 盒{ 大 = 负三百 };
    打印行("字段16=", h.大);
    打印("");
    打印行("实参8=", 吃128(负三));
    打印("");
    整128 显甲 = 整128(负三百);
    打印行("显式16=", 显甲);
    打印("");
    整128 干扰 = 123456789012345;
    整128 干扰后 = 负三;
    打印行("干扰后8=", 干扰后);
    打印("");
    打印行("干扰自身=", 干扰);
    打印("");
    如果 (b < 0) { 打印行("判定=真"); } 否则 { 打印行("判定=假"); }
    打印("");
    返回 0;
}
