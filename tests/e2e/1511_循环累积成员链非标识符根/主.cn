// 1511 循环累积成员链非标识符根（750 复审5 P1-2·双编译性能向）
//   病：成员链保守路径 + 非标识符引用根（外.内.记(槽.名)）——宿主抑制、v2 优化
//   （v2 哨兵只覆盖 借用位扫描202 已知引用位；成员链接收者走保守登记但其
//   实参根=成员节点未置哨兵）。
//   修：登记标识符实参根们750 对 节点_成员/节点_下标/节点_解引用 实参置未登记
//   哨兵（消费端整函数拒绝·与宿主取地址非标识符 hasAlias 同口径）。
//   负载：循环前 `外.内.记(槽.名)` + 循环累积 s。
//   预期：长=2048 / 成员链根优化=0 次=2048（双侧一致）。
结构体 盒 {
    字符串 名;
}

类 内层 {
公开:
    函数 内层() { }
    函数 记(字符串& 参) -> 整64 { 返回 字符串长度(参); }
}

类 外层 {
公开:
    内层 内;
    函数 外层() { }
}

不安全 函数 主() -> 整32 {
    字符串 s = "";
    盒 槽 = 盒{ 名 = "abc" };
    外层 外 = 外层();
    外.内.记(槽.名);
    整64 前 = 内存::总分配次数();
    循环 (整64 k = 0; k < 2048; k++) {
        s = s + "x";
    }
    整64 次 = 内存::总分配次数() - 前;
    打印("长=", 整数转字符串(字符串长度(s)));
    布尔 降 = 次 <= 6;
    如果 (降) { 打印("成员链根优化=1"); } 否则 如果 (次 > 6) {
        打印("成员链根优化=0 次=", 整数转字符串(次));
    }
    返回 0;
}
