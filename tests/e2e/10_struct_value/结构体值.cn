// Task 完善A：结构体按值传参/返回 与 结构体整体赋值 E2E 测试
// 覆盖：
//   1. 小结构体（≤8字节：2×整32）按值传参/返回（寄存器传递）
//   2. 大结构体（>8字节）按值传参/返回（调用方栈上分配+传指针 / 返回缓冲）
//   3. 结构体整体赋值（b = a；含数组字段结构体；链式赋值；修改后重新赋值）
//   4. 结构体数组元素作为参数
// 语法依据（cn-language-spec 05 + 规格书8.1 Win x64 调用约定）：
//   结构体按值传参/返回，≤8字节走寄存器、>8字节调用方栈分配传指针（规格书8.1）

结构体 点对 {
    整32 x;
    整32 y;
}

结构体 学生 {
    整32 学号;
    整32 成绩;
    整32 班级;
}

结构体 班级 {
    整32 编号;
    整32[3] 分数;
}

// 小结构体（8字节）按值传参：返回修改后的副本
函数 移动(点对 起点, 整32 dx, 整32 dy) -> 点对 {
    返回 点对{ x = 起点.x + dx, y = 起点.y + dy };
}

// 大结构体（12字节）按值传参 + 返回：成绩加 5
函数 加分(学生 入) -> 学生 {
    学生 出 = 入;
    出.成绩 = 出.成绩 + 5;
    返回 出;
}

// 结构体数组元素作为参数（下标访问实参）
函数 取学号(学生 入) -> 整32 {
    返回 入.学号;
}

// 含数组字段的结构体整体赋值（拷贝整个结构体，含数组字段）
函数 翻倍(班级 入) -> 班级 {
    班级 出 = 入;
    出.分数[0] = 出.分数[0] * 2;
    出.分数[1] = 出.分数[1] * 2;
    出.分数[2] = 出.分数[2] * 2;
    返回 出;
}

函数 主() -> 整32 {
    // ---- 1. 小结构体按值传参/返回（寄存器） ----
    点对 原 = 点对{ x = 1, y = 2 };
    打印("小结构体传参: ");
    点对 移后 = 移动(原, 10, 20);
    打印("移后.x: ");
    打印(移后.x);                  // 11
    打印("移后.y: ");
    打印(移后.y);                  // 22
    // 按值传递不修改原对象
    打印("原.x: ");
    打印(原.x);                    // 1

    // ---- 2. 大结构体按值传参/返回（栈分配+指针） ----
    学生 张三 = 学生{ 学号 = 1, 成绩 = 80, 班级 = 3 };
    打印("大结构体传参: ");
    学生 张三加 = 加分(张三);
    打印("加后成绩: ");
    打印(张三加.成绩);            // 85
    打印("原成绩: ");
    打印(张三.成绩);              // 80（按值传递，原对象不变）

    // ---- 3. 结构体数组元素作为参数 ----
    学生[2] 名单;
    名单[0] = 学生{ 学号 = 7, 成绩 = 60, 班级 = 1 };
    名单[1] = 学生{ 学号 = 9, 成绩 = 70, 班级 = 2 };
    打印("数组元素参数: ");
    打印(取学号(名单[0]));        // 7
    打印(取学号(名单[1]));        // 9

    // ---- 4. 结构体整体赋值（b = a 整体拷贝） ----
    点对 a = 点对{ x = 100, y = 200 };
    点对 b = a;                           // 声明并整体赋值
    打印("整体赋值b.x: ");
    打印(b.x);                     // 100
    打印("整体赋值b.y: ");
    打印(b.y);                     // 200
    // 修改 a 不影响 b（拷贝语义）
    a.x = 999;
    打印("改a后b.x: ");
    打印(b.x);                     // 100（b 是独立副本）

    // ---- 5. 含数组字段结构体整体赋值 ----
    班级 一班 = 班级{ 编号 = 1, 分数 = { 80, 90, 70 } };
    班级 一班副本 = 一班;                 // 整体赋值拷贝数组字段
    打印("含数组拷贝[1]: ");
    打印(一班副本.分数[1]);        // 90
    一班副本.分数[1] = 0;
    打印("改副本后原[1]: ");
    打印(一班.分数[1]);            // 90（原对象数组不受影响）
    打印("改副本后副[1]: ");
    打印(一班副本.分数[1]);        // 0

    // ---- 6. 链式赋值（b = a; c = b） ----
    点对 c = a;                           // a.x=999, a.y=200
    点对 d = c;
    打印("链式d.x: ");
    打印(d.x);                     // 999
    打印("链式d.y: ");
    打印(d.y);                     // 200

    // ---- 7. 大结构体返回（含数组字段） ----
    班级 翻倍一班 = 翻倍(一班);
    打印("翻倍[0]: ");
    打印(翻倍一班.分数[0]);        // 160
    打印("翻倍[1]: ");
    打印(翻倍一班.分数[1]);        // 180
    打印("翻倍[2]: ");
    打印(翻倍一班.分数[2]);        // 140

    // ---- 8. 结构体整体赋值后修改再重新赋值 ----
    点对 e = 点对{ x = 1, y = 1 };
    点对 f = e;
    e.x = 50;
    f = e;                               // 重新整体赋值
    打印("重新赋值f.x: ");
    打印(f.x);                     // 50
    打印("重新赋值f.y: ");
    打印(f.y);                     // 1

    返回 0;
}
