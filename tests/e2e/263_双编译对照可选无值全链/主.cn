// E2E 263（2026-09-13 第一百零七轮 107-a，plans/020 移植纪律 9 门禁化·第三十一个对照用例）：
//   **可选/结果 无值全链（H6 根治门禁）**——同一份源码经宿主真实管线与 v2 自举链
//   各编译运行，两侧退出码须相等。
//   背景（107-a 探针 d5f/d5j/d5f_min 实证）：v2 语法层把关键字「无」解析为
//   节点_整数字面量（值 0）→ 返回位原走「生成表达式」路径把 0 当结构体地址 →
//   IR_结构体拷贝 自 NULL 读 16 字节 → 段错误（rc=139；宿主 ✓ / v2 ✗ 双侧分叉）。
//   修复=返回位/声明位裸「无」零初始化（结果/可选 空值零值结构体物化，复用数组
//   局部零初始化设施），两侧与宿主同构（宿主对 `返回 0`/`可选<整64> r = 0`
//   报「无法隐式转换」实证无歧义——合法源码该位字面量只可能是「无」）。
//   八形态折位：①可选<字符串> 返回 无 ②可选<整64> 返回 无 ③声明位 可选 = 无
//   ④有值分支（某些）读值 ⑤结果 错误分支读错误码 ⑥结果 正常分支读值
//   ⑦转发（函数内 可选 局部 = 调用返回）⑧残留归零（块级析构后 内存::活动分配数）。
//   两侧任一退回「0 当地址」→ 段错误 → 退出码变化 → 失败（门禁对 H6 敏感）。
函数 造无串() -> 可选<字符串> {
    返回 无;
}
函数 造无整() -> 可选<整64> {
    返回 无;
}
函数 造某些() -> 可选<字符串> {
    返回 某些(字符串复制("E263有值载荷内容甲乙丙丁"));
}
函数 造错误() -> 结果<字符串, 整32> {
    返回 错误(5);
}
函数 造正常() -> 结果<字符串, 整32> {
    返回 正常(字符串复制("E263正常载荷内容"));
}
函数 转发无() -> 可选<字符串> {
    可选<字符串> 内 = 造无串();
    返回 内;
}
函数 主() -> 整32 {
    整32 校验 = 0;
    可选<字符串> 甲 = 造无串();
    如果 (!甲.有值) {
        校验 = 校验 + 1;
    } 否则 {
        打印("形一异常");
    }
    可选<整64> 乙 = 造无整();
    如果 (!乙.有值) {
        校验 = 校验 + 2;
    } 否则 {
        打印("形二异常");
    }
    可选<字符串> 丙 = 无;
    如果 (!丙.有值) {
        校验 = 校验 + 4;
    } 否则 {
        打印("形三异常");
    }
    可选<字符串> 丁 = 造某些();
    如果 (丁.有值) {
        如果 (字符串长度(丁.值) > 0) { 校验 = 校验 + 8; }
    } 否则 {
        打印("形四异常");
    }
    结果<字符串, 整32> 戊 = 造错误();
    如果 (戊.正常) {
        打印("形五异常");
    } 否则 {
        如果 (戊.错误 == 5) { 校验 = 校验 + 16; }
    }
    结果<字符串, 整32> 己 = 造正常();
    如果 (己.正常) {
        如果 (字符串长度(己.值) > 0) { 校验 = 校验 + 32; }
    } 否则 {
        打印("形六异常");
    }
    可选<字符串> 庚 = 转发无();
    如果 (!庚.有值) {
        校验 = 校验 + 64;
    } 否则 {
        打印("形七异常");
    }
    整64 起 = 内存::活动分配数();
    {
        结果<字符串, 整32> 辛 = 造正常();
        可选<字符串> 壬 = 造某些();
        如果 (辛.正常 && 壬.有值) { }
    }
    如果 (内存::活动分配数() == 起) {
        校验 = 校验 + 128;
    } 否则 {
        打印("形八异常");
    }
    返回 校验;
}
