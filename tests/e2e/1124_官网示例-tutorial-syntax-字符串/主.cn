// 官网文档示例 · tutorial-syntax.html · 字符串（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
函数 主() -> 整32 {
    字符串 名 = "CN 语言";
    打印(字符串长度(名));            // 9（UTF-8 字节：CN=2+空格1+语言=6）
    字符串 拼接 = "你好, " + 名 + "!" + 1;
    打印(拼接);                       // 你好, CN 语言!1
    打印(字符串包含(名, "语言"));     // 真
    打印(字符串子串(名, 3, 6));       // 语言（字节切片）
    打印(名[0]);                      // 67（'C' 的 UTF-8 首字节）
    打印(字符串大写("cn"));           // CN
    返回 0;
}