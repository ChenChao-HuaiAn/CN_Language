// 1391（1137）：选择 情况 标签超整64 承载=恒不匹配（双侧一致面）+ 域内标签回归。
//   修复前（毒化链）：parseIntValue std::stoll 对超承载文本溢出静默回 0——
//   `情况 99999999999999999999:` 被毒化成「情况 0」：检查通过、产物比较常量
//   0、甲=0 误命中（1137 双编译对照实证：宿主退出码 11 vs v2 22 分叉）。
//   修复后（文本级判域 resolveCaseIntText·910 族单点）：先文本归一判 i64 域、
//   域内才取值；超 i64 域=恒不匹配（CaseLabel.unmatchable·IR 判断块直接跳
//   下一判断），与 v2 生成期 128 承载比较实测「不命中」行为对齐（本用例锁
//   双侧一致面）。
//   覆盖：①20 位十进制 1e20 超承载不命中 ②2^63（19 位）超承载不命中
//   ③16 位 hex（0xFFFFFFFFFFFFFFFF）超承载不命中（进制形态同判）
//   ④域内正标签命中回归 ⑤域内负标签（-5）命中回归（320-a 负字面形态）。
//   边界面另案（v2 侧缺陷·1137 立项）：负号+超承载幅度字面量（-2^63 数学域内）
//   与超承载操作数括号折叠相消——v2 情况值通道比较失败（不命中），宿主已
//   正确承载（MIN/相消 0 命中），双侧对齐挂 v2 侧任务。
//   姊妹用例：1396（超 u128 域标签拒绝负测）、1397（超承载常量除数除零定性）；本用例 1395 由 1391 改号（领号名带号前缀配对错位·1137 处置）。
//   双编译对照（断言输出=是）：两侧同源码各编各跑，stdout 与退出码须一致。
函数 主() -> 整32 {
    整64 甲 = 0;
    选择(甲) {
        情况 99999999999999999999:
            打印("①误命中");
            返回 1;
        默认:
            打印("①缺省OK");
    }
    选择(甲) {
        情况 9223372036854775808:
            打印("②误命中");
            返回 2;
        默认:
            打印("②缺省OK");
    }
    选择(甲) {
        情况 0xFFFFFFFFFFFFFFFF:
            打印("③hex误命中");
            返回 3;
        默认:
            打印("③缺省OK");
    }
    {
        整64 丙 = 3;
        选择(丙) {
            情况 3:
                打印("④正命中");
                中断;
            默认:
                打印("④正未命中");
                返回 4;
        }
    }
    {
        整64 丁 = -5;
        选择(丁) {
            情况 -5:
                打印("⑤负命中");
                中断;
            默认:
                打印("⑤负未命中");
                返回 5;
        }
    }
    返回 0;
}
