// 1395（1137 审查修复）：选择 情况 标签——条件类型域内命中回归（双侧一致面）。
//   （目录名沿用首轮台账名「选择超域标签恒不匹配」；1137 审查修复后内容=域内
//   命中面——超承载标签现为编译期拒，见 1396 承载负测与 1399 条件域负测。）
//   P0-1/P0-2（用户令 #1076）：情况标签值须在**条件类型表示范围**内（超域=
//   编译期拒·宿主负测见 1399）；域内标签按归一十进制文本发射比较。
//   覆盖：①整64 域内大值 9223372036854775807 命中 ②整32 小标签命中
//   ③负标签 -5 命中 ④零标签命中 ⑤多值分组命中。
//   姊妹：1396（承载超域拒·双侧）、1397（除零定性）、1398/1399（超 i64 标签
//   与条件域维度·宿主单侧——v2 侧整128 条件比较缺陷 P1-1 另案）。
//   双编译对照（断言输出=是）：两侧同源码各编各跑，stdout 与退出码须一致。
函数 主() -> 整32 {
    {
        整64 甲 = 9223372036854775807;
        选择(甲) {
            情况 9223372036854775807:
                打印("①命中");
                中断;
            默认:
                打印("①未命中");
                返回 1;
        }
    }
    {
        整32 乙 = 3;
        选择(乙) {
            情况 3:
                打印("②命中");
                中断;
            默认:
                打印("②未命中");
                返回 2;
        }
    }
    {
        整64 丙 = -5;
        选择(丙) {
            情况 -5:
                打印("③命中");
                中断;
            默认:
                打印("③未命中");
                返回 3;
        }
    }
    {
        整64 丁 = 0;
        选择(丁) {
            情况 0:
                打印("④命中");
                中断;
            默认:
                打印("④未命中");
                返回 4;
        }
    }
    {
        整64 戊 = 2;
        选择(戊) {
            情况 1, 2, 3:
                打印("⑤命中");
                中断;
            默认:
                打印("⑤未命中");
                返回 5;
        }
    }
    返回 0;
}
