// 官网文档示例 · tutorial-oop.html · 静态成员（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
类 实例计数器 {
公开:
    静态 整64 总数 = 0;      // 全类共享一份

    函数 实例计数器() {
        总数 = 总数 + 1;
    }

    常量 函数 编号() -> 整64 { 返回 1; }   // 常量成员函数
}

函数 主() -> 整32 {
    实例计数器 a = 实例计数器();
    实例计数器 b = 实例计数器();
    打印(实例计数器.总数);     // 2（经类名访问）
    打印(a.编号());
    返回 0;
}