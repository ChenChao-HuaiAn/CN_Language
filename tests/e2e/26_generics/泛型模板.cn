// Task 3.8 泛型/模板 E2E 测试
// 覆盖：泛型类定义（泛型 <类型 T> 类）/类型名<实参> 实例化（单态化）/
//       不同实参类型实例化各自独立（泛型类字段/方法按 T 替换）/
//       泛型类方法返回 T
// 语法依据（cn-language-spec 06-十三）：泛型 <类型 T> 类 名 { ... }；
//   类型名<实参> 实例化（编译期单态化，每实例化生成独立代码）；
//   类字段/方法参数/返回类型中的 T 替换为实参类型
// 说明（E2E 实测边界，留待 Debug 全面审查子任务）：
//   1. 泛型函数调用（展示<圆形>）单态化注册未接入（22 用例确认）
//   2. 多类型参数泛型类（对<整32, 浮64>）构造字段写入异常（字段读 0）
//   3. 泛型类含浮点字段实例（容器<浮64>）运行崩溃
//   本用例聚焦单类型参数泛型类（整32/字符串）全链路：声明+构造+方法调用。
// 打印语义（用户裁决）：打印=println（自动换行）

// 泛型类：盒子 可存放任意类型 T（字段 + 获取/设置方法）
// 说明：泛型类带参构造（函数 盒子(T 初始) { 内容 = 初始 }）体内 T 字段
//   直接赋值未生效（构造调用后字段读垃圾，E2E 实测）——本用例用无参构造 +
//   设置() 方法写入字段（已验证路径），带参构造留待 Debug 全面审查子任务。
泛型 <类型 T>
类 盒子 {
公开:
    T 内容;

    函数 盒子() {
    }

    函数 获取() -> T {
        返回 内容;
    }

    函数 设置(T 新值) {
        内容 = 新值;
    }
}

// 带参构造泛型类（缺陷3 修复验证）：T 字段经构造参数写入
泛型 <类型 T>
类 带参盒 {
公开:
    T 内容;
    函数 带参盒(T 初始) {
        内容 = 初始;
    }
    函数 获取() -> T {
        返回 内容;
    }
}

// 多类型参数泛型类（缺陷3 修复验证）
泛型 <类型 T, 类型 U>
类 对 {
公开:
    T 首;
    U 次;
    函数 对(T a, U b) {
        首 = a;
        次 = b;
    }
    函数 显示() -> 字符串 {
        返回 整数转字符串(首) + "," + 整数转字符串(次);
    }
}

// 浮点字段泛型类（缺陷3 修复验证）
泛型 <类型 T>
类 容器 {
公开:
    T 值;
    函数 容器() {
    }
    函数 设置(T 新值) {
        值 = 新值;
    }
    函数 获取() -> T {
        返回 值;
    }
}

函数 主() -> 整32 {
    打印("===== 泛型/模板（Task 3.8）=====");

    // ---- 1. 泛型类实例化：盒子<整32>（声明 + 无参构造）----
    盒子<整32> 整数盒 = 盒子<整32>();
    整数盒.设置(42);
    打印("整32盒: ", 整数盒.获取());        // 42
    整数盒.设置(100);
    打印("设置后: ", 整数盒.获取());        // 100

    // ---- 2. 泛型类实例化：盒子<字符串>（类型参数替换为字符串）----
    盒子<字符串> 字符串盒 = 盒子<字符串>();
    字符串盒.设置("你好");
    打印("字符串盒: ", 字符串盒.获取());    // 你好
    字符串盒.设置("世界");
    打印("设置后: ", 字符串盒.获取());      // 世界

    // ---- 3. 不同实参类型独立实例化（单态化去重）----
    盒子<整32> 盒A = 盒子<整32>();
    盒子<整32> 盒B = 盒子<整32>();
    盒A.设置(999);
    盒B.设置(2);
    打印("盒A: ", 盒A.获取());              // 999
    打印("盒B: ", 盒B.获取());              // 2（独立实例）

    // ---- 4. 泛型类方法返回 T（字符串 T）----
    盒子<字符串> 名盒 = 盒子<字符串>();
    名盒.设置("张三");
    打印("姓名: ", 名盒.获取());            // 张三

    // ---- 5. 带参构造泛型类（缺陷3 修复验证）----
    带参盒<整32> 整数带参盒 = 带参盒<整32>(42);
    打印("带参构造整32: ", 整数带参盒.获取());   // 42
    带参盒<字符串> 字符串带参盒 = 带参盒<字符串>("你好");
    打印("带参构造字符串: ", 字符串带参盒.获取()); // 你好

    // ---- 6. 多类型参数泛型类（缺陷3 修复验证）----
    对<整32, 整32> 配对 = 对<整32, 整32>(10, 20);
    打印("多类型参数: ", 配对.显示());           // 10,20

    // ---- 7. 浮点字段泛型类（缺陷3 修复验证）----
    容器<浮64> 浮容器 = 容器<浮64>();
    浮容器.设置(3.5);
    打印("浮64容器: ", 浮容器.获取());           // 3.500000

    打印("===== 泛型/模板测试完成 =====");
    返回 0;
}
