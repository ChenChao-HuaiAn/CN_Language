// 1465（#1415 P1）：**终止块出口释放名单截断**（聚合局部冷路径）——块以 返回
//   终止时旧实现跳过块出口析构且**不截断编译期释放名单**：本块声明的类对象/
//   含串结构体/字符串元素数组/类元素数组残留条目被带入外层/后续返回路径的
//   资源析构，未执行声明路径（另一分支）槽为栈残值 → 释放垃圾/堆损坏
//   （修复前 v2 类对象形态实测 C0000374/退出码 127）。修法=终止块出口只截断
//   名单不发射代码（终止语句自身已全量析构），零运行期税一刀覆盖四族。
// 同名重绑定：外层 整64 甲=42 + 条件块内 结果<整64,整32> 甲=求()——出块后
//   **直接读** 甲 必须=42（块级类型恢复：函数信息.变量类型/镜像随块清单出栈
//   恢复；修复前 v2 读垃圾值，宿主=42）。
// 双侧同源跑（宿主 206-c 入口零初始化面行为不变+v2 名单截断对齐）：输出逐行
//   一致；冷（触=0）/热（触>0）两次调用覆盖「未执行声明路径」与「返回路径」。
// 附带回归锁（213⑦ 同族）：选择体内声明 + 中断（跳出选择）——选择体块以中断
//   终止时块出口析构不发射，中断点按选择体基线 drop-on-jump 释放（修复前靠
//   名单残留由外层路径代释放：未执行 case 路径释放栈垃圾/名单截断后泄漏）。
// 聚合局部块级绑定恢复锁面：外层标量 甲=42 + 条件块内同名 类对象/含串结构体/
//   字符串数组/引用局部——出块后直接读 甲 恒 42（修复前 v2 三族读出内层槽
//   垃圾：类 549755965776 / 结构体 549756021576 / 数组 549768394136 实录）。
类 盒1465 {
公开:
    字符串 名;
    整64 值;
    函数 盒1465(字符串 n) {
        名 = n;
        值 = 7;
    }
    函数 ~盒1465() { }
    不安全 函数 盒1465(盒1465& 其他) {
        名 = 字符串复制(其他.名);
        值 = 其他.值;
    }
}

结构体 串盒1465 {
    字符串 名;
    整64 值;
}

函数 求1465() -> 结果<整64, 整32> {
    返回 正常(7);
}

函数 取类1465(整64 触) -> 整64 {
    整64 旁 = 42;
    如果 (触 > 0) {
        盒1465 甲 = 盒1465("类甲载荷");
        返回 甲.值;
    }
    返回 旁;
}

函数 取构1465(整64 触) -> 整64 {
    整64 旁 = 42;
    如果 (触 > 0) {
        串盒1465 甲 = 串盒1465{ 名 = 字符串复制("构甲载荷"), 值 = 7 };
        返回 甲.值;
    }
    返回 旁;
}

函数 取串数组1465(整64 触) -> 整64 {
    整64 旁 = 42;
    如果 (触 > 0) {
        字符串[2] 甲 = { 字符串复制("串组甲载荷"), 字符串复制("串组乙载荷") };
        返回 2;
    }
    返回 旁;
}

函数 取类数组1465(整64 触) -> 整64 {
    整64 旁 = 42;
    如果 (触 > 0) {
        盒1465[2] 甲;
        盒1465 乙 = 盒1465("数甲载荷");
        甲[0] = 乙;
        盒1465 丙 = 盒1465("数乙载荷");
        甲[1] = 丙;
        返回 2;
    }
    返回 旁;
}

函数 碰1465(整64 触) -> 整64 {
    整64 甲 = 42;
    如果 (触 > 0) {
        结果<整64, 整32> 甲 = 求1465();
        如果 (甲.正常) { 整64 影 = 甲.值; }
    }
    返回 甲;
}

// 选择体内声明 + 中断（跳出选择）：中断点按选择体基线 drop-on-jump——
//   选择体块以中断终止时块出口析构不发射（终止块），资源须在中断点释放；
//   同函数另一 case 未执行路径不释放未初始化槽（名单截断）。宿主 213⑦ 同面。
函数 选择中断1465() -> 整64 {
    整64 前 = 内存::活动分配数();
    选择 (1) {
        情况 1:
            字符串 分支串1465 = 字符串复制("选择分支串占位");
            打印("选择长度=" + 整数转字符串(字符串长度(分支串1465)));
            中断;
    }
    整64 后 = 内存::活动分配数();
    打印("选择残留=" + 整数转字符串(后 - 前));
    返回 1;
}

// 聚合局部同名遮蔽（外层标量 甲=42 + 条件块内同名聚合局部）：出块后直接读
//   甲 必须=42（块级绑定恢复：局部槽 + 函数信息.变量类型 + 镜像随块清单出栈
//   恢复）。修复前 v2 类/结构体/数组三族读出内层槽垃圾（宿主 42 恒等）。
函数 类遮1465(整64 触) -> 整64 {
    整64 甲 = 42;
    如果 (触 > 0) {
        盒1465 甲 = 盒1465("遮蔽类载荷");
        整64 用 = 甲.值;
    }
    返回 甲;
}

函数 构遮1465(整64 触) -> 整64 {
    整64 甲 = 42;
    如果 (触 > 0) {
        串盒1465 甲 = 串盒1465{ 名 = 字符串复制("遮蔽构载荷"), 值 = 7 };
        整64 用 = 甲.值;
    }
    返回 甲;
}

函数 组遮1465(整64 触) -> 整64 {
    整64 甲 = 42;
    如果 (触 > 0) {
        字符串[2] 甲 = { 字符串复制("遮组甲载荷"), 字符串复制("遮组乙载荷") };
    }
    返回 甲;
}

// 引用局部同名遮蔽（同单点登记·引用槽不拥有不入名单）：出块后读外层 42。
函数 引遮1465(整64 触) -> 整64 {
    整64 甲 = 42;
    如果 (触 > 0) {
        整64 乙 = 7;
        整64& 甲 = 乙;
        整64 用 = 甲;
    }
    返回 甲;
}

函数 污染栈1465() -> 整64 {
    字符串 s = 字符串复制("污染栈帧内容甲乙丙丁戊己庚辛壬癸子丑寅卯");
    整64 v = 字符串长度(s);
    返回 v;
}

不安全 函数 主() -> 整32 {
    整64 污 = 污染栈1465();
    整64 类热 = 取类1465(1);
    整64 类冷 = 取类1465(0);
    整64 构热 = 取构1465(1);
    整64 构冷 = 取构1465(0);
    整64 串热 = 取串数组1465(1);
    整64 串冷 = 取串数组1465(0);
    整64 类组热 = 取类数组1465(1);
    整64 类组冷 = 取类数组1465(0);
    整64 碰热 = 碰1465(1);
    整64 碰冷 = 碰1465(0);
    整64 选中 = 选择中断1465();
    整64 类遮热 = 类遮1465(1);
    整64 类遮冷 = 类遮1465(0);
    整64 构遮热 = 构遮1465(1);
    整64 构遮冷 = 构遮1465(0);
    整64 组遮热 = 组遮1465(1);
    整64 组遮冷 = 组遮1465(0);
    整64 引遮热 = 引遮1465(1);
    整64 引遮冷 = 引遮1465(0);
    打印("类热=" + 整数转字符串(类热));
    打印("类冷=" + 整数转字符串(类冷));
    打印("构热=" + 整数转字符串(构热));
    打印("构冷=" + 整数转字符串(构冷));
    打印("串热=" + 整数转字符串(串热));
    打印("串冷=" + 整数转字符串(串冷));
    打印("类组热=" + 整数转字符串(类组热));
    打印("类组冷=" + 整数转字符串(类组冷));
    打印("碰热=" + 整数转字符串(碰热));
    打印("碰冷=" + 整数转字符串(碰冷));
    打印("类遮热=" + 整数转字符串(类遮热));
    打印("类遮冷=" + 整数转字符串(类遮冷));
    打印("构遮热=" + 整数转字符串(构遮热));
    打印("构遮冷=" + 整数转字符串(构遮冷));
    打印("组遮热=" + 整数转字符串(组遮热));
    打印("组遮冷=" + 整数转字符串(组遮冷));
    打印("引遮热=" + 整数转字符串(引遮热));
    打印("引遮冷=" + 整数转字符串(引遮冷));
    如果 (污 <= 0) { 返回 9; }
    如果 (选中 == 1 &&
         类遮热 == 42 && 类遮冷 == 42 && 构遮热 == 42 && 构遮冷 == 42 &&
         组遮热 == 42 && 组遮冷 == 42 && 引遮热 == 42 && 引遮冷 == 42 &&
         类热 == 7 && 类冷 == 42 && 构热 == 7 && 构冷 == 42 &&
         串热 == 2 && 串冷 == 42 && 类组热 == 2 && 类组冷 == 42 &&
         碰热 == 42 && 碰冷 == 42) {
        返回 0;
    }
    返回 1;
}
