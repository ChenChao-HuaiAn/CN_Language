导入 容器::向量;

结构体 三布 {
    布尔 a;
    布尔 b;
    布尔 c;
}

函数 读帧(三布 f) -> 整32 {
    如果 (f.b) { 返回 1; } 否则 { 返回 0; }
}

函数 主() -> 整32 {
    // ---- 1. 读侧：c=真 落在 b 的宽读窗口内（偏移+1 起 4/8 字节） ----
    三布 x;
    x.a = 假;
    x.b = 假;
    x.c = 真;
    如果 (x.b) { 打印("R1: b=真(错读)"); } 否则 { 打印("R1: b=假(正确)"); }
    // ---- 2. 写侧：全真 → b=假 → c/a 应保真 ----
    x.a = 真;
    x.b = 真;
    x.c = 真;
    x.b = 假;
    如果 (x.c) { 打印("R2: c=真(正确)"); } 否则 { 打印("R2: c=假(错写破坏)"); }
    如果 (x.a) { 打印("R3: a=真(正确)"); } 否则 { 打印("R3: a=假(错写破坏)"); }
    // ---- 3. 值传参通道 ----
    整32 r = 读帧(x);
    如果 (r == 0) { 打印("R4: 传参b=假(正确)"); } 否则 { 打印("R4: 传参b=真(错读)"); }
    // ---- 4. 容器往返通道 ----
    向量<三布> 栈 = 向量<三布>();
    结果<空类型, 整32> 追 = 栈.追加(x);
    三布 取回 = 栈.元素(栈.大小() - 1);
    如果 (取回.c) { 打印("R5: 取回c=真(正确)"); } 否则 { 打印("R5: 取回c=假(错拷)"); }
    如果 (取回.b) { 打印("R6: 取回b=真(错拷)"); } 否则 { 打印("R6: 取回b=假(正确)"); }
    返回 0;
}
