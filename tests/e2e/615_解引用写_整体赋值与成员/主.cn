// v12 m10f 拆分：解引用整体赋值+成员自动解引用写（二级指针面另立）
结构体 三字 { 整32 甲; 整32 乙; 整32 丙; }
不安全 函数 主() -> 整32 {
    三字 结 = 三字{ 甲 = 1, 乙 = 2, 丙 = 3 };
    三字* 指 = &结;
    指.乙 = 22;
    打印(结.甲);
    打印(结.乙);
    打印(结.丙);
    三字 源 = 三字{ 甲 = 7, 乙 = 8, 丙 = 9 };
    *指 = 源;
    打印(结.甲);
    打印(结.乙);
    打印(结.丙);
    返回 0;
}
