// 官网文档示例 · tutorial-syntax.html · 函数（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
泛型 <类型 T>
函数 交换泛型(T& a, T& b) -> 空类型 {
    T 临时 = a;
    a = b;
    b = 临时;
}

函数 主() -> 整32 {
    整32 甲 = 1;
    整32 乙 = 2;
    交换泛型<整32>(甲, 乙);      // 显式<类型>；引用实参直传（不加 &）
    打印(甲, 乙);
    返回 0;
}