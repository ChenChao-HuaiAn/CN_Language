// E2E 579（959 轮·转移位余二转正）：六位置终收——①目标=数组元素整块搬迁
//   （槽[0]=转移(甲)·元素=类容器 24B 内联体·CopyStruct 堆本体+对象壳裸
//   free+源槽清零）；②源=成员（乙=转移(h.桶)·句柄加载+成员槽清零=所有
//   权交接·宿主所有者出口对清零成员空安全跳过）。〔基准=019〕第二句：
//   转移()=显式放弃拷贝换零拷贝。六位置（声明/实参/赋值/静态/数组元素/
//   成员源）至此全通——返回位实证健康（557 系）。
导入 容器::向量;
结构体 持有 { 向量<整32> 桶; }
函数 主() -> 整32 {
    整64 基线 = 内存::活动分配数();
    {
        // ① 目标=数组元素
        向量<整32> 甲;
        结果<空类型, 整32> 加1 = 甲.追加(5);
        如果 (!加1.正常) { 返回 1; }
        向量<整32>[3] 槽;
        整64 前 = 内存::总分配次数();
        槽[0] = 转移(甲);
        整64 后 = 内存::总分配次数();
        如果 (后 - 前 == 0) { 打印("元素搬迁零拷"); }
        打印(槽[0].大小());
        // ② 源=成员
        持有 h;
        结果<空类型, 整32> 加2 = h.桶.追加(7);
        如果 (!加2.正常) { 返回 1; }
        结果<空类型, 整32> 加3 = h.桶.追加(8);
        如果 (!加3.正常) { 返回 1; }
        向量<整32> 乙;
        整64 前2 = 内存::总分配次数();
        乙 = 转移(h.桶);
        整64 后2 = 内存::总分配次数();
        如果 (后2 - 前2 == 0) { 打印("成员源零拷"); }
        打印(乙.大小());
    }
    整64 收尾 = 内存::活动分配数();
    如果 (收尾 == 基线) { 打印("双侧无泄漏"); }
    返回 0;
}
