// v12 m10e：解引用写宽度矩阵（整8/整16/整32/整64/结构体字段邻域破坏检查）
结构体 对 { 整32 甲; 整32 乙; }
不安全 函数 主() -> 整32 {
    整8[3] 窄 = {1, 2, 3};
    整8* 窄指 = &窄[0];
    *窄指 = 9;
    打印(窄[0]);
    打印(窄[1]);
    打印(窄[2]);
    整16[3] 中 = {100, 200, 300};
    整16* 中指 = &中[0];
    *中指 = 111;
    打印(中[0]);
    打印(中[1]);
    打印(中[2]);
    整64[3] 宽 = {1000, 2000, 3000};
    整64* 宽指 = &宽[0];
    *宽指 = 999;
    打印(宽[0]);
    打印(宽[1]);
    打印(宽[2]);
    对 结 = 对{ 甲 = 5, 乙 = 6 };
    对* 结指 = &结;
    (*结指).甲 = 55;
    打印(结.甲);
    打印(结.乙);
    返回 0;
}
