// 1726（#1975·001 §6 接口实现×泛型）：泛型类实例 → 接口类型隐式转换（值/指针
//   形态）+接口变量多态分派。修前双侧分叉实录（2026-11-02 探针 pD1/pD1b）：
//   宿主误拒「无法将 '盒子$整32' 隐式转换为 '可取值'」——实例化（第一趟e 泛型
//   注册）早于接口注册（第一趟d·架构次序），实例 ClassInfo 缺 resolveClass 同构
//   的接口重分类（接口名滞留 baseName·interfaces 空）→ 接口转换判定/实现验证/
//   分派区合成全 miss；v2 语义放行但产物链接期缺符号（放行坏程序=更坏·静默）。
//   非泛型同形态双侧全绿（1716/100 系同构）。本例锁死：①值形态转换+多态分派
//   （两实现共存·抑制去虚拟化·强制接口分派区槽间接路径）②指针形态 ③直接成员
//   调用对照。
接口 可取值 {
    虚拟 函数 取值() -> 整32;
}
类 盒甲 : 可取值 {
公开:
    函数 盒甲() {}
    重写 函数 取值() -> 整32 { 返回 2; }
}
泛型 <类型 T>
类 盒子 : 可取值 {
公开:
    T 值;
    函数 盒子(T 初) { 值 = 初; }
    重写 函数 取值() -> 整32 { 返回 1; }
}
函数 主() -> 整32 {
    盒甲 甲 = 盒甲();
    盒子<整32> a = 盒子<整32>(7);
    // 形态一：值形态转换+多态分派（两实现共存·接口分派区槽间接路径）
    可取值 i1 = 甲;
    可取值 i2 = a;
    打印(i1.取值());
    打印(i2.取值());
    // 形态二：指针形态转换
    可取值* i3 = &a;
    打印(i3.取值());
    // 形态三：直接成员调用对照
    打印(a.取值());
    打印(a.值);
    返回 0;
}
