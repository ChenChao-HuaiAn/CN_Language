// E2E 580（962 轮·166 立法转正）：字符串六比较运算符——==/!= 内容比较+
//   四序字典序（等价 字符串比较/字符串字典序·001 §比较语义修订版）+判空保留
//   （s != 无 走指针通道）+显式函数并行验证。
//   【host-only 登记（962 实测）】v2 侧同构随 v2 扩面轮。
//   〔基准=019〕第一句：默认路径零规则。
函数 主() -> 整32 {
    字符串 a = "abc";
    字符串 b = "abc";
    字符串 c = "abd";
    如果 (a == b) { 打印("内容相等对"); } 否则 { 打印("内容相等错"); 返回 1; }
    如果 (a != c) { 打印("不等对"); } 否则 { 打印("不等错"); 返回 1; }
    如果 (a < c) { 打印("字典序小于对"); } 否则 { 打印("字典序小于错"); 返回 1; }
    如果 (c > a) { 打印("字典序大于对"); } 否则 { 打印("字典序大于错"); 返回 1; }
    如果 (a <= b) { 打印("小于等于对"); } 否则 { 打印("小于等于错"); 返回 1; }
    如果 (c >= c) { 打印("大于等于对"); } 否则 { 打印("大于等于错"); 返回 1; }
    字符串 拼 = "a" + "b" + "c";
    如果 (拼 == a) { 打印("拼接产物相等对"); } 否则 { 打印("拼接产物相等错"); 返回 1; }
    如果 (a != 无) { 打印("判空保留对"); } 否则 { 打印("判空保留错"); 返回 1; }
    布尔 显式 = 字符串比较(a, b);
    如果 (显式 && a == b) { 打印("显式函数并行对"); } 否则 { 打印("显式函数并行错"); 返回 1; }
    返回 0;
}
