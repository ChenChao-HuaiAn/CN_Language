// 1390（1100/1101·2026-10-19·#1018 采样轮 D2/D3）：v2 整128 位运算两病——
//   ① 常量移位（LL/ULL 后缀字面量左操作数·856 不物化纪律呈 64 位寄存器码）
//      落 64 位通道 x86 掩码（and ecx,63）静默错值：修复前 1LL<<64 出 1
//      （应 2^64）、1LL<<100 出 2^36（应 2^100）；运行期变量左走 128 通道恒对。
//   ② 128 族位非（~0LL/~255LL/~变量）把值句柄当标量异或 = 畸形指针解引用
//      C0000005（~255L/~255 窄型不受影响）。
//   形态吸收 target/cnsmith_r1018 min/m02.cn + m05.cn（含运行期函数边界
//   形态——两病共同解剖点=128 判定按物理寄存器码而非源码后缀定级）。
//   双编译对照正测：宿主 + v2 同源码各编各跑，退出码与输出逐行全等。
函数 移位(整128 基数, 整128 量) -> 整128 {
    返回 基数 << 量;
}

函数 取反(整128 甲) -> 整128 {
    返回 ~甲;
}

函数 主() -> 整32 {
    整128 值 = 1LL;
    整128 量0 = 0LL;
    整128 量63 = 63LL;
    整128 量64 = 64LL;
    整128 量100 = 100LL;
    整128 量127 = 127LL;
    打印("常量<<0=", 1LL << 0);
    打印("常量<<63=", 1LL << 63);
    打印("常量<<64=", 1LL << 64);
    打印("常量<<100=", 1LL << 100);
    打印("常量<<127=", 1LL << 127);
    打印("无符号<<127=", 1ULL << 127);
    打印("变量<<0=", 移位(值, 量0));
    打印("变量<<63=", 移位(值, 量63));
    打印("变量<<64=", 移位(值, 量64));
    打印("变量<<100=", 移位(值, 量100));
    打印("变量<<127=", 移位(值, 量127));
    打印("~0LL=", ~0LL);
    打印("~255LL=", ~255LL);
    打印("~0ULL=", ~0ULL);
    打印("~变量=", ~值);
    打印("~参变量=", 取反(值));
    打印("~255L=", ~255L);
    打印("~255=", ~255);
    返回 0;
}
