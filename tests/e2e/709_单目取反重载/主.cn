// 709（414 审查 P0-3·E2E 正例）：单目取反 运算符~ 重载+内置 ~ 回归
//   语法依据（plans/001 §4.6）：~ ∈ 可重载集合（单目 0 个右参数）。v2 修前
//   表达式位 ~x 解析期脱糖为 x^(0-1)，类「运算符~」定义侧放行、使用侧必拒
//   =自相矛盾分叉。修后：类命中走重载（0 - 值 - 1 = -11）；整数 ~x 走 IR 层
//   内置展开 x^(0-1)（= -6·原脱糖语义逐位保持）。
类 计量 {
公开:
    整32 值;
    函数 计量(整32 甲) { 值 = 甲; }
    函数 运算符~() -> 计量 {
        返回 计量(0 - 值 - 1);
    }
}
函数 主() -> 整32 {
    计量 甲 = 计量(10);
    计量 反 = ~甲;          // 重载版：0 - 10 - 1 = -11
    打印(反.值);
    整32 x = 5;
    打印(~x);               // 内置版：5 ^ (0-1) = -6（打印=println 自动换行）
    返回 0;
}
