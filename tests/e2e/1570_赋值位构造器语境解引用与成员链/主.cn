// E2E 1570_赋值位构造器语境解引用与成员链（#1666·双编译对照正例）：
//   赋值位构造器语境的**形态白名单补齐**（#1591 只覆盖 标识符简单赋值/
//   字段/数组元素/下标链，本轮补宿主已支持而 v2 漏设语境的形态）：
//   ①解引用左值（标识符指针 `*针 = 某些(…)`）——宿主 checkUnaryCallAssignTarget
//     Deref→checkExpr(target)=所指类型同口径；
//   ②成员 of 数组元素（`表[0].箱 = 某些(…)`）——对象类型递归取字段；
//   ③标识符/字段/数组元素 既有形态回归（#1591 面不回归）。
//   修前 ①② v2 均误报「构造器 某些 须用于 结果/可选 语境」（宿主同形态绿）。
//   载荷宽度选型同 1531：标识符/解引用用 整64，字段/数组元素用 整32
//   （宿主合成体字段/数组元素 8 字节载荷布局缺陷面为存量，不携入本用例）。
//   未入本用例的相邻形态（各自台账）：
//     ·复合解引用 `*(架.针) = …`——v2 结构体「指向结果/可选的指针字段」
//       成员读写既有缺陷（#1681），语义层宁拒不放行；
//     ·指针字段下标 `架.针[i] = …`——v2 产物正确/宿主静默不写（#1680）；
//     ·`可选<T>* 针` 声明指针层不再误入生成结果局部（#1666 IR 配套，本用例
//       ①的声明位即其覆盖面）。
结构体 架 {
    可选<整64>* 针;
    可选<整32> 箱;
}

结构体 内 {
    可选<整32> 箱;
}

不安全 函数 主() -> 整32 {
    可选<整64> 甲;
    可选<整64>* 针甲 = &甲;
    *针甲 = 某些(9);                       // ①解引用（标识符指针）

    内[2] 表;
    表[0] = 内{ 箱 = 无 };
    表[1] = 内{ 箱 = 无 };
    表[0].箱 = 某些(7);                    // ②成员 of 数组元素

    可选<整64> 丙;
    丙 = 某些(21);                         // ③回归：标识符简单赋值位
    架 架甲 = 架{ 针 = &丙, 箱 = 无 };
    架甲.箱 = 某些(23);                    // ③回归：字段位

    可选<整32>[2] 组;
    组[1] = 某些(25);                      // ③回归：数组元素位
    // 观测面（#1705 规避）：v2 对本用例语句组合把「打印」误作函数名取地址
    //   （IR_函数地址 op=72·内置查表 miss 链接期显形·#1705 在案），暂以返回值
    //   编码锁定值正确性：五形态值求和 9+7+21+23+25=85；任一「无值/错值」即偏离。
    //   #1705 修复后恢复打印观测面。
    整32 校验 = 0;
    如果 (甲.有值 && 甲.值 == 9) { 校验 = 校验 + 1; }
    如果 (表[0].箱.有值 && 表[0].箱.值 == 7) { 校验 = 校验 + 1; }
    如果 (丙.有值 && 丙.值 == 21) { 校验 = 校验 + 1; }
    如果 (架甲.箱.有值 && 架甲.箱.值 == 23) { 校验 = 校验 + 1; }
    如果 (组[1].有值 && 组[1].值 == 25) { 校验 = 校验 + 1; }
    如果 (校验 == 5) { 返回 0; }
    返回 1;
}
