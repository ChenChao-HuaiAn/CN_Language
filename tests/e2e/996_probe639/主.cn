// 649-a 波 B 验证探针（113 同构最小形态）
导入 容器::向量;
导入 映射集合;

结构体 符号 {
    整64 名ID;
    整64 类型ID;
    整64 种类;
    整64 附加;
}

类 持有 {
公开:
    向量<映射<整64, 符号>> 表们;
    函数 持有() {
        表们 = 向量<映射<整64, 符号>>();
    }
    函数 ~持有() {
    }
}

函数 消费(持有 h) -> 整32 {
    结果<空类型, 整32> 加层 = h.表们.追加(映射<整64, 符号>());
    如果 (!加层.正常) { 返回 1; }
    映射<整64, 符号> 层 = h.表们.元素(0);
    符号 s;
    s.名ID = 7;
    s.类型ID = 700;
    s.种类 = 1;
    s.附加 = 0;
    结果<空类型, 整32> 设 = 层.设置(7, s);
    如果 (!设.正常) { 返回 2; }
    结果<符号, 整32> 取 = 层.获取(7);
    如果 (取.正常) {
        符号 got = 取.值;
        打印("层内7: ", got.类型ID);
    }
    整64 n = h.表们.大小();
    返回 整32(n);
}

函数 主() -> 整32 {
    持有 a = 持有();
    整32 n = 消费(a);
    打印("n: ", n);
    返回 0;
}
