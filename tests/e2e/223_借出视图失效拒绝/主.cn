// E2E 223（2026-09-12 第七十七轮，plans/020 矩阵 A21 格靶子「借出视图 × 容器移除」）：
//   **借出视图失效拒绝**（宿主负测：期望编译失败，诊断锚「容器失效点」）。
//   语义：字符串元素容器的借出方法（元素/读取/栈顶/队首/头部元素/读取头部/
//   读取尾部/获取）返回容器内元素句柄的**浅拷**=借出视图；容器失效方法
//   （删除/设置/清空/弹出/出队/删除头部/删除尾部/释放内部数组）使该元素
//   释放/移出后，借出视图悬垂（探针 77 实证六形态内容损坏：①向量元素×删除
//   ③向量读取×覆盖 ④栈顶×弹出 ⑤队首×出队 ⑥链表头元素×删头 ⑦映射获取×删除）。
//   判据 = NLL 顺序近似（Rust 非词法生命周期：引用活跃区间=绑定→最后使用），
//   失效点落在区间内即拒绝——本用例六形态须全部被拒（一条不得漏）。
//   Rust 对照：`let x = &v[0]; v.remove(0); use(x);` 被借用检查器拒绝（E0502）；
//   CN 无借用类型 → 靠「方法名清单 + 来源登记」达成同一拦截。
导入 容器::向量;
导入 容器::链表;
导入 容器::栈;
导入 容器::队列;
导入 映射集合;

// ① 向量 元素 × 删除（被移除槽释放）
函数 形态一() -> 整32 {
    向量<字符串> 表 = 向量<字符串>();
    结果<空类型, 整32> 加 = 表.追加(字符串复制("形态一元素甲乙丙丁戊己庚辛壬癸"));
    如果 (!加.正常) { 运行时错误(4); }
    字符串 借出 = 表.元素(0);
    结果<空类型, 整32> 删 = 表.删除(0);
    如果 (!删.正常) { 运行时错误(4); }
    返回 整32(字符串长度(借出));
}

// ② 向量 读取（结果形态）× 设置覆盖（唯一持有者槽释放）
函数 形态二() -> 整32 {
    向量<字符串> 表 = 向量<字符串>();
    结果<空类型, 整32> 加 = 表.追加(字符串复制("形态二元素甲乙丙丁戊己庚辛壬癸"));
    如果 (!加.正常) { 运行时错误(4); }
    结果<字符串, 整32> 读 = 表.读取(0);
    如果 (!读.正常) { 运行时错误(4); }
    结果<空类型, 整32> 设 = 表.设置(0, 字符串复制("形态二新值甲乙丙丁戊己庚辛壬癸"));
    如果 (!设.正常) { 运行时错误(4); }
    如果 (读.正常) {
        返回 整32(字符串长度(读.值));
    }
    返回 0;
}

// ③ 栈顶 × 弹出（所有权移交调用方——双持有句柄）
函数 形态三() -> 整32 {
    栈<字符串> 表 = 栈<字符串>();
    结果<空类型, 整32> 压 = 表.压入(字符串复制("形态三元素甲乙丙丁戊己庚辛壬癸"));
    如果 (!压.正常) { 运行时错误(4); }
    结果<字符串, 整32> 顶 = 表.栈顶();
    如果 (!顶.正常) { 运行时错误(4); }
    结果<字符串, 整32> 出 = 表.弹出();
    如果 (!出.正常) { 运行时错误(4); }
    如果 (顶.正常) {
        返回 整32(字符串长度(顶.值));
    }
    返回 0;
}

// ④ 队首 × 出队（同上）
函数 形态四() -> 整32 {
    队列<字符串> 表 = 队列<字符串>();
    结果<空类型, 整32> 入 = 表.入队(字符串复制("形态四元素甲乙丙丁戊己庚辛壬癸"));
    如果 (!入.正常) { 运行时错误(4); }
    结果<字符串, 整32> 首 = 表.队首();
    如果 (!首.正常) { 运行时错误(4); }
    结果<字符串, 整32> 出 = 表.出队();
    如果 (!出.正常) { 运行时错误(4); }
    如果 (首.正常) {
        返回 整32(字符串长度(首.值));
    }
    返回 0;
}

// ⑤ 链表 头部元素 × 删除头部（被摘槽释放）
函数 形态五() -> 整32 {
    链表<字符串> 表 = 链表<字符串>();
    结果<空类型, 整32> 加 = 表.头部追加(字符串复制("形态五元素甲乙丙丁戊己庚辛壬癸"));
    如果 (!加.正常) { 运行时错误(4); }
    字符串 借出 = 表.头部元素();
    结果<空类型, 整32> 删 = 表.删除头部();
    如果 (!删.正常) { 运行时错误(4); }
    返回 整32(字符串长度(借出));
}

// ⑥ 映射 获取 × 删除（交换式删除释放被删项值串）
函数 形态六() -> 整32 {
    映射<整64, 字符串> 表 = 映射<整64, 字符串>();
    结果<空类型, 整32> 设 = 表.设置(6, 字符串复制("形态六值甲乙丙丁戊己庚辛壬癸"));
    如果 (!设.正常) { 运行时错误(4); }
    结果<字符串, 整32> 取 = 表.获取(6);
    如果 (!取.正常) { 运行时错误(4); }
    布尔 删 = 表.删除(6);
    如果 (!删) { 运行时错误(4); }
    如果 (取.正常) {
        返回 整32(字符串长度(取.值));
    }
    返回 0;
}

函数 主() -> 整32 {
    返回 形态一() + 形态二() + 形态三() + 形态四() + 形态五() + 形态六();
}
