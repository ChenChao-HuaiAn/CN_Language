// E2E 447（2026-09-18 第 353 轮·T60 根治门禁）：一元负号整数面产物类型码随
//   操作数（原恒 T_整64 且不登记）——`-1` 抬公共提升进 64 位域致 `a32/-1`
//   =2147483648 vs 宿主 32 位域回绕 -2147483648（p3 探针实锤）。修复后负号
//   产物码=操作数码+整数面登记（布尔/字符/未登记兜底 T_整64 不变）。
//   矩阵：①32 位域回绕（÷/-1·%/-1·负号本体 -a32）②普通负值除余 ③负号产物
//   再运算（提升规则不变性：+/*/%）④64 位域对照 ⑤正32 混合（同宽混升整64
//   语义不变）⑥32 位乘法面。双编译对照：宿主/v2 同源同测逐行一致。
// #474 翻转（2026-10-12）：MIN/-1 与 MIN 取负从回绕改错误码 8（728/729 承载）。
//   T60 类型码矩阵的回绕值锚收敛到 不安全 函数（§1.1a④·类型码行为与安全域
//   一致——豁免仅豁检查不豁推导）；主函数尾部补安全域 MIN/-1 触发锚收尾。
不安全 函数 回绕锚474() -> 空类型 {
    整32 a32u = -2147483648;
    打印(a32u / -1);
    打印(-a32u);
    整64 a64u = -9223372036854775808;
    打印(a64u / -1);
}
函数 主() -> 整32 {
    // ① 32 位域（%-1 面·#474 保留余零）
    整32 a32 = -2147483648;
    打印(a32 % -1);
    // ② 普通负值除余（32 位域语义对照）
    整32 b = -7;
    打印(b / -1);
    打印(b % -1);
    打印(b / -2);
    打印(b % -2);
    // ③ 负号产物再运算（提升规则不变性）
    打印(-1 + 1);
    打印(-1 * 5);
    打印(-7 % 3);
    // ⑤ 正32 混合（#474 翻转：原 正32+(-1) 靠无符号回绕巧合得 9 的路径已
    //   改错误码 8——显式提升整64 承载同一验证点：负号产物码随操作数域）
    正32 u = 10;
    打印(整64(u) + -1);
    // ⑥ 32 位乘法面（32 位域回绕=赋值截断同值）
    整32 c = 100000;
    打印(c * -1);
    // 回绕值锚（#474 豁免域·T60 类型码矩阵本体）
    回绕锚474();
    // 安全域 MIN/-1 触发锚（#474：错误码 8 收尾）
    打印(a32 / -1);
    返回 0;
}
