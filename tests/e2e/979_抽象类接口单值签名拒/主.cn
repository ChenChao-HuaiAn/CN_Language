// E2E 979 负测（任务746·593 同族单值形态收口·双编译对照）
// 立法：specs/06 §八「含抽象成员的类不可直接实例化」——按值形参/按值返回/
//   字段/静态存储=按值复制实例化面（C++ cannot declare parameter to be of
//   abstract type 同款）。接口面裁定（105 回归红实证）：接口单值形参/返回=
//   A1 同地址语义引用句柄传递不实例化（specs/06 §六·plans/006 P3-19 C2
//   立法面 105_接口参数多态 锁面）=放行不入本例；接口字段/静态字段/顶层
//   静态=无实参绑定来源的未绑定引用面（193 接口裸声明拒同构）仍拦。
// 缺陷史：193 拦裸声明、593 拦元素数组——「单值」签名/成员/静态存储形态
//   双侧恒静默放行（修前探针 rc=0 实锤：宿主静默产 exe=运行期虚表残缺/纯虚
//   调用未定义）。双侧语义层领域正确拒绝（同文案同阶段 rc=1 不产 asm）。
// 八挂点：①函数单值形参 ②函数单值返回（引用拷贝形态·隔离 413 构造调用
//   检查=纯净签名面）③原型声明单值形参 ④类方法单值形参+返回 ⑤类字段
//   ⑥类静态字段 ⑦顶层静态 ⑧接口字段/类静态字段/顶层静态接口三面（拦接口
//   =真 面·抽象三面由 ①②④⑤⑥⑦ 覆盖）。
//   诊断锚=「不能实例化」（双侧诊断公共子串·宿主侧锚定）。
//   指针/引用形态不实例化不拦=193 口径（正测边界见 980）。
类 形状 {
公开:
    抽象 函数 面积() -> 整64
}

接口 可叫 {
    函数 叫() -> 空类型;
}

// 形态⑦：顶层静态单值（宿主 registerGlobalConstsAndStatics 746 挂点·
//   顶层静态不走 visitVarDecl=193/593 挂点恒 miss·宿主补齐后与 v2
//   收集静态声明 593 挂点对位同构）
静态 形状 顶层槽;

// 形态⑧c：顶层静态接口（无实参绑定来源=未绑定引用面·拦接口=真）
静态 可叫 顶层接口槽;

类 仓库 {
公开:
    // 形态⑤：类字段单值（实例布局成员复制构造）
    形状 货;
    // 形态⑥：类静态字段单值（静态存储期对象复制构造）
    静态 形状 静态槽;
    // 形态⑧a：类字段接口（未绑定引用面·拦接口=真）
    可叫 接口货;
    // 形态④a：类方法单值形参
    函数 存(形状 对象) -> 空类型 {
        返回;
    }
    // 形态④b：类方法单值返回（引用拷贝形态·不现构造调用）
    函数 取(形状& 引用) -> 形状 {
        返回 引用;
    }
}

// 形态①：函数单值形参
函数 吃(形状 对象) -> 空类型 {
    返回;
}

// 形态②：函数单值返回（引用拷贝形态·不现构造调用）
函数 吐(形状& 引用) -> 形状 {
    返回 引用;
}

// 形态③：原型声明单值形参（无体·声明面即实例化承诺面·checkFunctionBody
//   body 判定前挂点同覆盖）
函数 吃原型(形状 对象) -> 空类型

函数 主() -> 整32 {
    返回 0;
}
