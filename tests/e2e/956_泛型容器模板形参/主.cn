// 956 泛型容器模板形参（738·双编译对照）
// 覆盖：泛型函数形参=容器模板含类型参数（001 §5.6 泛型章·编译期单态化自然面·
//       C++ template<typename T> void f(std::vector<T>) 对照合法）：
//   ①形参=向量<T>（取元素返回 T）②形参=可选<T> ③形参=结果<T,整32>（载荷全宽）
//   ④返回=向量<T> ⑤泛型类方法形参=可选<T>
// 738 修复锚：v2 收集函数实参结构 对泛型模板态本体跳过 ABI 登记（形参含
//   可选<T>/结果<T,E> 时 结果载荷字节("T") 三链必炸=修复前 v2 拒因）
导入 容器::向量;

// ①形参=向量<T>：容器模板形参·取元素返回 T
泛型 <类型 T>
函数 首元素(向量<T> 表) -> T {
    返回 表.元素(0);
}

// ②形参=可选<T>
泛型 <类型 T>
函数 取或默认(可选<T> 盒, T 备用) -> T {
    如果 (盒.有值) {
        返回 盒.值;
    }
    返回 备用;
}

// ③形参=结果<T, 整32>（载荷全宽读·结果<整64,·> 16 字节面）
泛型 <类型 T>
函数 取或零(结果<T, 整32> 盒) -> T {
    如果 (盒.正常) {
        返回 盒.值;
    } 否则 {
        返回 0;
    }
}

// ④返回=向量<T>
泛型 <类型 T>
函数 造表(T 首值) -> 向量<T> {
    向量<T> 表 = 向量<T>();
    结果<空类型, 整32> 加 = 表.追加(首值);
    如果 加.正常 { 打印(0); } 否则 { 返回 表; }
    返回 表;
}

// ⑤泛型类方法形参=可选<T>
泛型 <类型 T>
类 盒架 {
私有:
    T 内容;
公开:
    不安全 函数 盒架() {
        内容 = 0;
    }
    函数 存(可选<T> 盒) {
        如果 (盒.有值) {
            内容 = 盒.值;
        }
    }
    常量 函数 取() -> T {
        返回 内容;
    }
}

函数 主() -> 整32 {
    向量<整32> 表 = 造表<整32>(6);
    整32 和 = 首元素<整32>(表);
    可选<整32> 盒 = 某些(5);
    和 = 和 + 取或默认<整32>(盒, 9);
    结果<整64, 整32> 宽 = 正常(100);
    和 = 和 + 整32(取或零<整64>(宽));
    盒架<整32> 架;
    可选<整32> 架盒 = 某些(20);
    架.存(架盒);
    和 = 和 + 架.取();
    返回 和;   // 6+5+100+20=131
}
