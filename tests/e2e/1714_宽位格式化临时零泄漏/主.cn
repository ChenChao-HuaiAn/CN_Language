// 1714（#1971）：宽位格式化占位符转串临时零泄漏——%d64/%u64/%d128/%u128 合成
//   转字符串调用产物随格式化调用结算释放（活动分配数差=0·五形态逐项断言：
//   打印位/单次赋值位/循环赋值位/默认参数位/%d128 循环位）。
//   类方法返回位形态另案（v2 方法返回接收位净漏·按 #1571 返回形态判据精修）。
//   修前每调用净漏 1 堆分配（合成临时误登记 AST 形态结算通道·整型实参判据必
//   不命中=永跳过释放），v2 侧同源零泄漏=宿主分叉缺陷——本例双侧锁死。
//   口径：单次赋值位差=1 是活着的最终串合法持有；其余形态块内临时差=0。
函数 缺省串(整64 v = 7000000000) -> 字符串 {
    返回 格式化("%d64", v);
}
函数 主() -> 整32 {
    整32 i = 0;
    整64 总 = 0;
    // 形态一·打印位：格式化结果直进打印（消费毕即释·修前每轮漏 1）
    整64 基 = 内存::活动分配数();
    i = 0;
    当 (i < 5) {
        整64 v = i;
        v = v * 1000000000;
        打印(格式化("甲%d64乙", v));
        i = i + 1;
    }
    打印(内存::活动分配数() - 基);
    // 形态二·单次赋值位：差=1=活着的 s 合法持有（修前=2）
    基 = 内存::活动分配数();
    正64 满 = 18446744073709551615;
    字符串 s = 格式化("%u64", 满);
    打印(字符串长度(s));
    打印(内存::活动分配数() - 基);
    // 形态三·循环赋值位：块内临时 50 轮随轮释放（修前漏 50）
    基 = 内存::活动分配数();
    i = 0;
    当 (i < 50) {
        整64 v = i;
        v = v * 100000000000;
        字符串 s3 = 格式化("%d64", v);
        总 = 总 + 字符串长度(s3);
        i = i + 1;
    }
    打印(总);
    打印(内存::活动分配数() - 基);
    // 形态四·默认参数位：块内 30 轮（修前漏 30）
    基 = 内存::活动分配数();
    i = 0;
    当 (i < 30) {
        字符串 d = 缺省串();
        总 = 总 + 字符串长度(d);
        i = i + 1;
    }
    打印(总);
    打印(内存::活动分配数() - 基);
    // 形态五·%d128 循环位：块内 40 轮（修前漏 40）
    整128 大 = 123456789012345678;
    基 = 内存::活动分配数();
    i = 0;
    当 (i < 40) {
        字符串 s128 = 格式化("%d128", 大);
        总 = 总 + 字符串长度(s128);
        i = i + 1;
    }
    打印(总);
    打印(内存::活动分配数() - 基);
    返回 0;
}
