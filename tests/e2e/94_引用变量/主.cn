// E2E 94_引用变量（P3-18）：变量 整32& r = x —— r 是 x 的别名
// 读写经引用解引用：r = 20 修改 x；读取 r 取 x 当前值。
函数 主() -> 整32 {
    打印("===== 引用变量声明（P3-18）=====");
    整32 x = 10;
    整32& r = x;
    打印("x 初始: ", x);          // 10
    r = 20;
    打印("r 赋值后 x: ", x);      // 20
    整32 读取 = r;
    打印("读取 r: ", 读取);        // 20
    打印("===== 完成 =====");
    返回 0;
}
