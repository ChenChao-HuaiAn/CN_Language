// 932（#728h·2026-10-14）：方法内字段链根成员**读**偏移权威覆盖锁——
//   病灶（728h 探针实证·任务第一步实测）：语法层「变量结构体表」跨函数
//   同名局部变量残留串桶（成员访问对象推导命中残留类→节点_成员.附加=
//   非负错值），IR 读路径原「右值偏移兜底仅 附加<0 触发」被短路→静默读错
//   偏移（探针 p14b：v2 读 [对象+0]=7 vs 宿主 42·rc=0 零诊断；p14g 甲型
//   残留 b@16→读越界=0）。写路径同形态由 594-b（链根字段所指类·类型化>
//   猜值）已覆盖——本用例锁读路径对称修复。
//   修（生成表达式字段.解析字段三元组 标识符分支）：权威结构体（解析对象
//   结构体ID=函数级变量类型遮蔽感知〔局部/参数＞类字段登记〕＋解析类字段
//   类型登记）命中即以 查字段偏移 覆盖；miss 保持语法层值（错名面由 648
//   宽度码显形中止兜底——负测 933 锁「错名双侧拒绝」）。
//   段A 残留串桶读（修复面·修前 7）；段B 偏移放大 16 残留学（修前 0）；
//   段C 隔离（写对/读对分离）；段D 裸名写+三级链写（594-b 已覆盖面·防
//   误伤）；段E 无残留基线/同名异类正例；段F 内嵌对象读（值字段同面）。
类 甲 {
公开:
    整64 b;                 // 残留登记用（b@0——修前被静默猜此偏移）
    函数 甲() { b = 0; }
}
类 庚 {
公开:
    整64 p;
    整64 q;
    整64 b;                 // b@16——偏移放大学（修前读 [对象+16] 越界）
    函数 庚() { p = 0; q = 0; b = 0; }
}
类 乙 {
公开:
    整64 x;
    整64 b;                 // 真类型：x@0·b@8
    函数 乙() { x = 0; b = 0; }
}
// 残留登记（解析期「变量结构体表」跨函数保留——局部 器→甲·器庚→庚；
//   函数不被调用亦发生：残留=解析期现象非运行期）
不安全 函数 预备() -> 整32 {
    甲 器 = 甲();
    器.b = 9;
    庚 器庚 = 庚();
    器庚.b = 9;
    返回 0;
}
类 丙 {
公开:
    乙* 器;
    乙* 器庚;
    函数 丙() { 器 = 无; 器庚 = 无; }
    不安全 函数 读() -> 整64 {
        返回 器.b;
    }
    不安全 函数 读庚() -> 整64 {
        返回 器庚.b;
    }
    不安全 函数 写(整64 v) -> 空类型 {
        器.b = v;
    }
    不安全 函数 写三级(整64 v) -> 空类型 {
        自身.器.b = v;
    }
}
类 丁 {
公开:
    乙 内嵌;
    函数 丁() { 内嵌 = 乙(); }
    不安全 函数 读内() -> 整64 {
        返回 内嵌.b;
    }
}
不安全 函数 主() -> 整32 {
    // ===== 段A：残留串桶读（修复面·修前 7）=====
    乙 对A = 乙();
    对A.x = 7;
    对A.b = 42;
    丙 壳A = 丙();
    壳A.器 = &对A;
    打印(壳A.读());              // 42（修前 7=读 [对A+0] 静默错值）

    // ===== 段B：偏移放大（庚型残留 b@16·修前读越界 0）=====
    乙 对B = 乙();
    对B.x = 7;
    对B.b = 56;
    丙 壳B = 丙();
    壳B.器庚 = &对B;
    打印(壳B.读庚());            // 56（修前 0=读 [对B+16] 越界）

    // ===== 段C：隔离——写对/读对分离（写路径 594-b 已覆盖）=====
    乙 对C = 乙();
    对C.x = 7;
    对C.b = 42;
    丙 壳C = 丙();
    壳C.器 = &对C;
    打印(对C.x);                 // 7
    打印(对C.b);                 // 42
    打印(壳C.读());              // 42
    壳C.写(99);
    打印(对C.x);                 // 7（写不误伤 x）
    打印(对C.b);                 // 99（写对 b）

    // ===== 段D：对照——裸名写/三级链写（594-b 覆盖面·防误伤）=====
    乙 对D = 乙();
    对D.x = 7;
    丙 壳D = 丙();
    壳D.器 = &对D;
    壳D.写(42);                  // 裸名写
    打印(对D.x);                 // 7
    打印(对D.b);                 // 42
    丙 壳E = 丙();
    壳E.器 = &对D;
    壳E.写三级(77);              // 三级链写（自身.器.b）
    打印(对D.b);                 // 77

    // ===== 段E：无残留基线·同名异类正例（权威覆盖正确性）=====
    乙 对E = 乙();
    对E.x = 7;
    对E.b = 33;
    丙 壳F = 丙();
    壳F.器 = &对E;
    打印(壳F.读());              // 33

    // ===== 段F：内嵌对象读（值字段同面·对照）=====
    丁 壳G = 丁();
    打印(壳G.读内());            // 0（内嵌默认构造）
    返回 0;
}
