// E2E 1367（2026-10-18·任务 #1073）：128 域常量折叠放行面保真（正测·dual）。
//   超承载字面量（超 int64 承载·128 承载内）参与常量/静态/局部算式——编译期
//   折叠与运行期物化值保真：001 §3.7a「宽于 int64 承载不检查」（无符号与
//   整128 结果域宽于 int64 预演承载的面不检查·不误报）+ 919 单点判域
//   「128 上下文承载内→合法放行」。修前实锚：`常量 甲 = 20位+0` 双侧同拒
//   （宿主 cnEvalConstExpr 折叠失败/v2 收集常量拒折叠）；`静态 整128 甲 =
//   20位*2` v2 编译进程自身 474 溢出中止；常量单字面量宿主 ml64 A2084
//   （mov rax,20位文本）/v2 低 64 位静默截断——本用例锁全修复面。
//   形态覆盖：常量（+0/加1/乘2/抵消/负号壳/嵌套/常量引用）+ 顶层静态
//   （整128 加1/乘2、正128 加0、嵌套）+ 函数内静态（守卫 852 面·乘2）+
//   局部整128。
//   双编译对照正测：宿主+v2p 同源同跑输出逐行全等（断言输出=是）。
常量 甲 = 99999999999999999999 + 0;
常量 乙 = 99999999999999999999 + 1;
常量 丙 = 99999999999999999999 * 2;
常量 丁 = 99999999999999999999 - 99999999999999999999;
常量 戊 = 0 - 99999999999999999999;
常量 己 = (99999999999999999999 + 1) * 2;
常量 庚 = 甲 + 1;

静态 整128 静甲 = 99999999999999999999 + 1;
静态 整128 静乙 = 99999999999999999999 * 2;
静态 正128 静丙 = 99999999999999999999 + 0;
静态 整128 静丁 = (99999999999999999999 + 1) * 2;

函数 主() -> 整32 {
    打印(甲);
    打印(乙);
    打印(丙);
    打印(丁);
    打印(戊);
    打印(己);
    打印(庚);
    打印(静甲);
    打印(静乙);
    打印(静丙);
    打印(静丁);
    整128 局 = 99999999999999999999 + 1;
    打印(局);
    静态 整128 函静 = 99999999999999999999 * 2;
    打印(函静);
    返回 0;
}
