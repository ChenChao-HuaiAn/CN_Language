// E2E 1682_闭包变量被调串链段结算（任务 1578·2026-10-30·双编译对照锁用例）
// 面：#1578「lambda/functor 变量被调返回拥有型字符串作链段净泄 1」——
//   连接链融合（3 段）与逐节保守（2 段）两条路径的段拥有临时结算，以及
//   「返回借用句柄不得释放」的反向锚定。
//   判据：段结算按**所有权归属**而非调用形态——lambda 体返回形态在定义处登记
//   （捕获名返回=1571 返回位自动复制成拥有副本；形参透传/成员读=借用），
//   函数指针变量按声明返回段（精确 "字符串"）。借用串被误释=源串悬垂
//   （#1696 同族），故本用例对每个借用形态都断言源串内容不变。
// 数值口径（内存::活动分配数差值·每形态独立干净基线）：
//   拥有形态：链后活差 1（只剩终串·段临时已结算）/ 释后 0；
//             漏结算=2/1（#1578 缺陷基线）。
//   借用形态：链后活差 1（终串 1 枚·段=借用不结算）/ 释后 0；
//             误释借用=0（链后即少 1 枚）。
//   所有数值先落局部再打印（P2-5：防打印路径自有分配污染基线）。
静态 整64 失败数_ = 0;

不安全 函数 判(布尔 条件, 字符串 名) {
    如果 (条件) {
        打印("判 ", 名, "=1");
    } 否则 如果 (!条件) {
        打印("判 ", 名, "=0");
        失败数_ = 失败数_ + 1;
    }
}

// 自由函数对照（返回位拼接产物=拥有串·A2 契约既有面）
不安全 函数 造串(字符串 尾) -> 字符串 {
    返回 "S" + 尾;
}

// ---------- 形态一：lambda 返回拥有串（字符串复制） ----------
不安全 函数 形一拥有串() -> 整32 {
    变量 取 = [&]() -> 字符串 { 返回 字符串复制("取"); };
    // ①3 段融合链
    整64 基 = 内存::活动分配数();
    字符串 链 = "A" + "B" + 取();
    整64 活差 = 内存::活动分配数() - 基;
    打印("形一 链=", 链);
    打印("形一 融合活差=", 活差);
    判(字符串比较(链, "AB取"), "形一 融合值");
    判(活差 == 1, "形一 融合链段结算（活差 1）");
    字符串释放(链);
    整64 释后 = 内存::活动分配数() - 基;
    打印("形一 融合释后=", 释后);
    判(释后 == 0, "形一 融合释后归零");
    // ②2 段保守链（右段=闭包调用返回拥有串）
    基 = 内存::活动分配数();
    字符串 短 = "A" + 取();
    整64 活差2 = 内存::活动分配数() - 基;
    打印("形一 短=", 短);
    打印("形一 保守活差=", 活差2);
    判(字符串比较(短, "A取"), "形一 保守值");
    判(活差2 == 1, "形一 保守链段结算（活差 1）");
    字符串释放(短);
    整64 释后2 = 内存::活动分配数() - 基;
    打印("形一 保守释后=", 释后2);
    判(释后2 == 0, "形一 保守释后归零");
    // ③打印实参位（消费位结算）
    基 = 内存::活动分配数();
    打印("形一 打印=", "P" + "Q" + 取());
    整64 活差3 = 内存::活动分配数() - 基;
    打印("形一 打印活差=", 活差3);
    判(活差3 == 0, "形一 打印位结算（活差 0）");
    返回 0;
}

// ---------- 形态二：函数指针变量（自由函数目标） ----------
不安全 函数 形二函数指针() -> 整32 {
    字符串(*句柄)(字符串) = 造串;
    整64 基 = 内存::活动分配数();
    字符串 链 = "A" + "B" + 句柄("尾");
    整64 活差 = 内存::活动分配数() - 基;
    打印("形二 链=", 链);
    打印("形二 活差=", 活差);
    判(字符串比较(链, "ABS尾"), "形二 值");
    判(活差 == 1, "形二 段结算（活差 1）");
    字符串释放(链);
    整64 释后 = 内存::活动分配数() - 基;
    打印("形二 释后=", 释后);
    判(释后 == 0, "形二 释后归零");
    返回 0;
}

// ---------- 形态三：lambda 体返回形态族 ----------
不安全 函数 形三体形态() -> 整32 {
    // ③a 捕获名返回：返回位已复制成拥有副本（1571）→ 段须结算
    字符串 快照 = 字符串复制("快照");
    变量 取捕 = [快照]() -> 字符串 { 返回 快照; };
    整64 基 = 内存::活动分配数();
    字符串 链捕 = "A" + "B" + 取捕();
    整64 活差捕 = 内存::活动分配数() - 基;
    打印("形三 捕获链=", 链捕, " 快照=", 快照);
    打印("形三 捕获活差=", 活差捕);
    判(字符串比较(链捕, "AB快照"), "形三 捕获值");
    判(字符串比较(快照, "快照"), "形三 捕获快照不被搬空");
    判(活差捕 == 1, "形三 捕获副本段结算（活差 1）");
    字符串释放(链捕);
    整64 释后捕 = 内存::活动分配数() - 基;
    打印("形三 捕获释后=", 释后捕);
    判(释后捕 == 0, "形三 捕获释后归零");
    // ③b 形参透传返回（借用句柄）：段**不得**结算，源串须存活
    字符串 源 = 字符串复制("源串");
    变量 取参 = [&](字符串 p) -> 字符串 { 返回 p; };
    基 = 内存::活动分配数();
    字符串 链参 = "A" + "B" + 取参(源);
    整64 活差参 = 内存::活动分配数() - 基;
    打印("形三 形参链=", 链参, " 源=", 源);
    打印("形三 形参活差=", 活差参);
    判(字符串比较(链参, "AB源串"), "形三 形参值");
    判(字符串比较(源, "源串"), "形三 形参借用不被误释");
    判(活差参 == 1, "形三 形参借用不结算（活差 1）");
    字符串释放(链参);
    // 释后归零 = 只有源串存活（源串已计入基线·链产物释放后基线不变）
    整64 释后参 = 内存::活动分配数() - 基;
    打印("形三 形参释后=", 释后参);
    判(释后参 == 0, "形三 形参释后归零（源串未被动）");
    字符串释放(源);
    // ③c 局部变量移出：拥有串，段须结算
    变量 取局 = [&]() -> 字符串 { 字符串 局 = 字符串复制("局"); 返回 局; };
    基 = 内存::活动分配数();
    字符串 链局 = "A" + "B" + 取局();
    整64 活差局 = 内存::活动分配数() - 基;
    打印("形三 局部链=", 链局);
    打印("形三 局部活差=", 活差局);
    判(字符串比较(链局, "AB局"), "形三 局部值");
    判(活差局 == 1, "形三 局部移出段结算（活差 1）");
    字符串释放(链局);
    整64 释后局 = 内存::活动分配数() - 基;
    打印("形三 局部释后=", 释后局);
    判(释后局 == 0, "形三 局部释后归零");
    // ③d 字面量返回（返回位自动复制）：拥有串，段须结算
    变量 取文 = [&]() -> 字符串 { 返回 "文"; };
    基 = 内存::活动分配数();
    字符串 链文 = "A" + "B" + 取文();
    整64 活差文 = 内存::活动分配数() - 基;
    打印("形三 字面链=", 链文);
    打印("形三 字面活差=", 活差文);
    判(字符串比较(链文, "AB文"), "形三 字面值");
    判(活差文 == 1, "形三 字面返回段结算（活差 1）");
    字符串释放(链文);
    整64 释后文 = 内存::活动分配数() - 基;
    打印("形三 字面释后=", 释后文);
    判(释后文 == 0, "形三 字面释后归零");
    返回 0;
}

// ---------- 形态四：自由函数对照（既有面不回归） ----------
不安全 函数 形四对照() -> 整32 {
    整64 基 = 内存::活动分配数();
    字符串 链 = "A" + "B" + 造串("尾");
    整64 活差 = 内存::活动分配数() - 基;
    打印("形四 链=", 链);
    打印("形四 活差=", 活差);
    判(字符串比较(链, "ABS尾"), "形四 值");
    判(活差 == 1, "形四 段结算（活差 1）");
    字符串释放(链);
    整64 释后 = 内存::活动分配数() - 基;
    打印("形四 释后=", 释后);
    判(释后 == 0, "形四 释后归零");
    返回 0;
}

不安全 函数 主() -> 整32 {
    形一拥有串();
    形二函数指针();
    形三体形态();
    形四对照();
    如果 (失败数_ == 0) {
        打印("1682 闭包变量被调串链段结算 全部通过");
        返回 0;
    } 否则 如果 (失败数_ != 0) {
        打印("1682 闭包变量被调串链段结算 失败数=", 失败数_);
        返回 1;
    }
    返回 1;
}
