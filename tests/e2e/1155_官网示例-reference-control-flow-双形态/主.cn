// 官网文档示例 · reference/control-flow.html · 条件（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
函数 分级(整32 分) -> 字符串 {
    如果 分 >= 90 { 返回 "优"; }          // 裸条件（括号可选）
    如果 (分 >= 60) { 返回 "及格"; }      // 带括号（同合法）
    返回 "不及格";
}

函数 主() -> 整32 {
    打印(分级(95), " ", 分级(70), " ", 分级(30));
    返回 0;
}