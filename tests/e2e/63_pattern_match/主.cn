// E2E 63_pattern_match：模式匹配增强（C-4，2026-08）
// 覆盖：字符串选择（情况 "字面量"）、多值情况标签（情况 1, 2:）、
//   裸枚举成员名（情况 红:，按 选择 条件枚举类型定向解析）、
//   限定枚举成员（情况 颜色.蓝:）、字符串选择 + 多值组合、默认分支
// 语法依据：C-4 选择 增强（值匹配；对标 Rust match）——
//   选择 表达式须为 整数/字符/字符串/枚举；情况 值为 常量/字符串/枚举成员；
//   分支以 中断 结束（C fallthrough 语义，多值标签的前序标签体为空自动落入组）

枚举 颜色 {
    红,
    绿,
    蓝,
    自定义 = 100
}

函数 主() -> 整32 {
    打印("===== 模式匹配增强（C-4）=====")

    // 1. 字符串选择：匹配分支
    字符串 命令 = "开始"
    选择 (命令) {
        情况 "开始":
            打印("命令: 开始")
            中断
        情况 "停止":
            打印("命令: 停止")
            中断
        默认:
            打印("命令: 未知")
    }

    // 2. 字符串选择：默认分支
    字符串 命令2 = "暂停"
    选择 (命令2) {
        情况 "开始":
            打印("命令2: 开始")
            中断
        情况 "停止":
            打印("命令2: 停止")
            中断
        默认:
            打印("命令2: 未知")
    }

    // 3. 多值情况标签（整数分组）
    整32 级别 = 2
    选择 (级别) {
        情况 0, 1:
            打印("低级别")
            中断
        情况 2, 3:
            打印("中级别")
            中断
        默认:
            打印("高级别")
    }

    // 4. 裸枚举成员名（类型定向解析）
    颜色 c = 颜色.蓝
    选择 (c) {
        情况 红:
            打印("红色")
            中断
        情况 绿:
            打印("绿色")
            中断
        情况 蓝:
            打印("蓝色")
            中断
        默认:
            打印("未知色")
    }

    // 5. 限定枚举成员 + 多值组合
    颜色 c2 = 颜色.自定义
    选择 (c2) {
        情况 颜色.红, 颜色.绿:
            打印("基础色")
            中断
        情况 颜色.自定义:
            打印("自定义色")
            中断
        默认:
            打印("其他色")
    }

    // 6. 字符串选择 + 多值分组
    字符串 键 = "甲"
    选择 (键) {
        情况 "甲", "乙":
            打印("键: 甲乙组")
            中断
        情况 "丙":
            打印("键: 丙")
            中断
        默认:
            打印("键: 其他")
    }

    打印("===== 模式匹配测试完成 =====")
    返回 0
}
