导入 容器::向量;
导入 容器::{链表, 栈, 队列};

函数 主() -> 整32 {
链表<整64> 列 = 链表<整64>();
结果<空类型, 整32> 加 = 列.追加(11);
加 = 列.追加(22);
结果<整64, 整32> 头 = 列.读取头部();
如果 (头.正常) { 打印(头.值); }
结果<整64, 整32> 尾 = 列.读取尾部();
如果 (尾.正常) { 打印(尾.值); }
    返回 0;
}
