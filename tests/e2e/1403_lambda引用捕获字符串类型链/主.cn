// 1403_lambda引用捕获字符串类型链（1121·1089 邻近形态扫描 p07l 转正·双编译对照）
// 病（v2 单侧）：lambda 体内捕获名读取走 引用参数读——值寄存器类型登记原落
//   T_整64（引用参数值码 只精化浮64）→ 体内 打印行(捕获名) 分派 __cn_print_int
//   打指针值（探针 p07l v2 `4252239新` vs 宿主 `新新`）；拼接/比较同走整数路径。
// 修法：引用参数值码 补 字符串→T_字符串（与普通字符串局部/值形参读取同码；
//   写通道经 引用参数存储码 不受影响）——IR生成尾.cn。
// 覆盖扩展面：引用捕获体内打印/写穿/拼接/比较、值捕获快照、引用捕获结构体
//   字段字符串、值捕获结构体深拷、引用捕获串传入 字符串& 形参、体内拷贝独立。
// 注：打印=尾随换行、打印行=不换行（双侧既有口径，990 等用例印证）。
结构体 盒 {
    字符串 名;
    整32 号;
}

函数 读串(字符串& 参) -> 整32 {
    打印(参);
    参 = 参 + "!";
    返回 0;
}

函数 主() -> 整32 {
    // ① 引用捕获字符串：体内打印（打印行 不换行）+ 写穿 + 外层读新值
    字符串 甲 = "甲初";
    变量 改 = [&]() { 甲 = "新"; 打印行(甲); 打印("体"); 返回 0; };
    改();
    打印(甲);

    // ② 引用捕获字符串参与拼接（体内新串+写穿拼接）
    字符串 乙 = "乙";
    变量 拼 = [&]() { 字符串 丙 = 乙 + "丙"; 打印(丙); 乙 = 乙 + "尾"; 返回 0; };
    拼();
    打印(乙);

    // ③ 引用捕获字符串比较（读数语义：体内改前不等、改后相等）
    字符串 丁 = "左";
    变量 比 = [&]() {
        如果 (丁 == "右") { 打印("相等"); } 否则 { 打印("不等"); }
        丁 = "右";
        返回 0;
    };
    比();
    变量 比2 = [&]() {
        如果 (丁 == "右") { 打印("相等"); } 否则 { 打印("不等"); }
        返回 0;
    };
    比2();

    // ④ 值捕获 [=] 字符串=定义处快照（定义后外层改值，体内读旧值）
    字符串 戊 = "戊初";
    变量 取 = [=]() { 打印(戊); 返回 0; };
    戊 = "外改";
    取();
    打印(戊);

    // ⑤ 引用捕获结构体字段字符串：体内读旧值、写字段、外层读新值
    变量 盒1 = 盒{ 名 = "旧名", 号 = 1 };
    变量 改盒 = [&]() {
        打印(盒1.名);
        盒1.名 = "新名";
        打印(盒1.名);
        返回 0;
    };
    改盒();
    打印(盒1.名);

    // ⑥ 值捕获结构体含字符串字段=深拷快照（外层改字段，体内读旧值）
    变量 盒2 = 盒{ 名 = "原名", 号 = 2 };
    变量 拷 = [=]() { 打印(盒2.名); 返回 0; };
    盒2.名 = "外名";
    拷();
    打印(盒2.名);

    // ⑦ 引用捕获字符串传入 字符串& 形参（形参体内打印同为字符串分派+写穿）
    字符串 己 = "己";
    变量 传 = [&]() { 读串(己); 返回 0; };
    传();
    打印(己);

    // ⑧ 体内拷贝独立：体内 字符串 镜 = 引用捕获名（深拷）后改捕获名，镜读旧值
    字符串 庚 = "庚旧";
    变量 独 = [&]() {
        字符串 镜 = 庚;
        庚 = "庚新";
        打印(镜);
        打印(庚);
        返回 0;
    };
    独();
    打印(庚);
    返回 0;
}
