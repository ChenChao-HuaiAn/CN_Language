// 449：整数/小数 内置别名矩阵（399-a D43 落地锚定·规范 3.1 默认类型别名）
//   形态=变量/参数/返回/结构体字段/数组元素（泛型+别名归 D42 域另行）
//   双编译对照：宿主+v2 同测；断言输出=是
函数 加一(整数 v) -> 整数 {
    返回 v + 1;
}
结构体 盒 {
    整数 值;
}
函数 主() -> 整32 {
    整数 a = 10;
    小数 圆周 = 3.5;
    整数 b = 加一(a);
    盒 bx;
    bx.值 = 30;
    整数[3] 数组;
    数组[0] = 40;
    打印行(b);
    打印行(bx.值);
    打印行(数组[0]);
    打印行(a);
    打印行(圆周);
    返回 0;
}
