类 货物 {
公开:
    字符串 名称;
    整64 量;
    函数 货物(字符串 s) {
        名称 = s;
        量 = 7;
    }
    不安全 函数 货物(货物& 其他) {
        名称 = 字符串复制(其他.名称);
        量 = 其他.量;
    }
    不安全 函数 ~货物() {
    }
}
静态 货物 无初值箱;
函数 主() -> 整32 {
    打印("A1");
    打印行(字符串长度(无初值箱.名称));
    打印("A2");
    打印行(无初值箱.量);
    返回 0;
}
