// E2E 153（plans/016 缺陷根治回归锚定）：linux-x86_64 后端 emitParamSetup
// 参数拷贝临时寄存器冲突——结构体按值/i128 参数拷贝原用 r9 当数据临时，
// 而 r9 是 SysV 第 6 整型参数寄存器：该参数位于第 6 位之前且函数整型参数
// 满 6 个时，未保存的第 6 参数被拷贝残留值覆盖（v2p 自举编译器「生成如果」
// 函数实测：参数 6「指令引用」被覆盖为节点池容量 41，作指针解引用段错误
// exit 139）。
// 修复（2026-09-05 用户裁决方案A）：数据临时改 r11——prologue 参数装载阶段
//   r11 无任何职责（仅虚调用间接跳转使用，发生在函数体执行期），与 ARM64
//   的 x10/x11/x12 拷贝模式同构；win x64 的 rsi/rdi/rcx 不在 win 参数寄存器
//   集合（rcx,rdx,r8,r9）内，结构性安全，不受影响。
// 本用例修复前行为：第 6 参数读到拷贝残留值，断言失败（回滚测试锚定有效）。

结构体 大块 {
    整64 甲;
    整64 乙;
    整64 丙;
}

// 形态一（v2p「生成如果」同构）：a=rdi，p=rsi（结构体按值 3 字拷贝），
//   b=rdx，c=rcx，d=r8，e=r9（第 6 整型参数位——缺陷时被拷贝残留覆盖）
函数 消费(整64 a, 大块 p, 整64 b, 整64 c, 整64 d, 整64 e) -> 整64 {
    返回 a * 100000 + p.甲 + p.乙 + p.丙 + b * 10 + c * 100 + d * 1000 + e;
}

// 形态二（i128 同族分支）：a=rdi，m=rsi（i128 双槽地址指针拷贝），
//   b=rdx，c=rcx，d=r8，e=r9
函数 和六(整64 a, 整128 m, 整64 b, 整64 c, 整64 d, 整64 e) -> 整64 {
    返回 a * 100000 + 整64(m) + b * 10 + c * 100 + d * 1000 + e;
}

函数 主() -> 整32 {
    大块 k = 大块{ 甲 = 1, 乙 = 2, 丙 = 3 };
    // 7*100000 + (1+2+3) + 4*10 + 5*100 + 6*1000 + 8 = 706554
    打印(消费(7, k, 4, 5, 6, 8));
    // 7*100000 + 9 + 4*10 + 5*100 + 6*1000 + 8 = 706557
    打印(和六(7, 9LL, 4, 5, 6, 8));
    返回 0;
}
