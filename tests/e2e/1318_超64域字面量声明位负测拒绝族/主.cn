// E2E 1318（2026-10-18·任务 #910）：超 64 域字面量声明位口径收口——负测
//   （超域拒绝族双侧同拒）。收集 910 修复前宿主/v2 行为分裂的超域形态
//   （巨额立即数汇编失败/静默截断错值/位模式回绕异态/垃圾值），修后按
//   001 §3.7a 值域门槛先行（T36/#506甲/558/788⑤——字面量直赋通道先查目标
//   类型值域、超域一律编译期拒绝）双侧统一拒绝：
//   ①整64 = 0x8000000000000000（2^63 超整64 正域；910 前宿主 A2022/v2 放行）
//   ②整64 = 0xFFFFFFFFFFFFFFFF（u64 全宽超整64；910 前宿主静默截断/v2 放行）
//   ③整64 = 0x8000000000000001（2^63+1）
//   ④整64 = 0x10000000000000000（2^64 超 u64）
//   ⑤整64 = 0x8000000000000000ULL（ULL 定级正128 直赋超目标域·788⑤）
//   ⑥正64 = -0x8000000000000000（负值不入无符号域）
//   ⑦整64 = -0x8000000000000001（-2^63-1 超整64 负域；910 前宿主静默 0）
//   ⑧整32 = 0x8000000000000000（超整32；910 前宿主 IR 不变量内部错/v2 垃圾值）
//   ⑨变量 壬 = 0x8000000000000000（推断通道值超域·638 甲案）
//   ⑩返回 0x8000000000000000（返回通道值域；910 前宿主 A2022）
//   双编译对照负测：宿主+v2p 双侧等效拒绝（诊断锚=隐式转换值域拒）。
函数 出() -> 整64 {
    返回 0x8000000000000000;
}
函数 主() -> 整32 {
    整64 甲 = 0x8000000000000000;
    整64 乙 = 0xFFFFFFFFFFFFFFFF;
    整64 丙 = 0x8000000000000001;
    整64 丁 = 0x10000000000000000;
    整64 戊 = 0x8000000000000000ULL;
    正64 己 = -0x8000000000000000;
    整64 庚 = -0x8000000000000001;
    整32 辛 = 0x8000000000000000;
    变量 壬 = 0x8000000000000000;
    打印(出());
    返回 0;
}
