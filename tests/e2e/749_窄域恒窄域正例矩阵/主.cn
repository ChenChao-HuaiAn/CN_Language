// E2E 749（2026-10-12·任务 #481 B 案·正例矩阵·rc=0 全绿）：
//   ①混合宽度提升较宽侧（整64+整16→整64 域·30100）不报；②显式升宽
//   整64(甲)+甲=60000（§1.1a③ 完备通道）；③显式回绕 回绕加(甲,甲)=-5536
//   （474 知情通道）；④域内窄域 甲+1=30001≤32767 合法不报（B 案字面量
//   按整16 参与·域内面）；⑤域内乘 100*100=10000；⑥显式升宽乘
//   甲*整32(2)=60000（混宽提升整32 域·域内合法）。双编译对照：宿主与
//   v2 同源同测·输出逐行一致+rc=0。
函数 主() -> 整32 {
    整16 甲 = 30000;
    整64 总64 = 100;
    总64 = 总64 + 甲;        // 混合宽度提升整64 域
    打印(总64);              // 30100
    整64 大 = 整64(甲) + 甲; // 显式升宽
    打印(大);                // 60000
    整16 环 = 回绕加(甲, 甲);
    打印(整32(环));          // -5536（60000 回绕）
    整32 和 = 甲 + 1;        // 域内窄域（30001 ≤ 32767）
    打印(和);                // 30001
    整16 丙 = 100;
    整32 积 = 丙 * 100;
    打印(积);                // 10000
    整32 乘32 = 甲 * 整32(2);
    打印(乘32);              // 60000（整32 域内）
    返回 0;
}
