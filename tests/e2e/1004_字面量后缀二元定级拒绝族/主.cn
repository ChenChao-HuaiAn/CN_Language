// E2E 1004（788 锁用例·负测 dual·2026-10-15）：整数字面量**后缀定级**接入
//   v2 转换推导族后的拒绝面（宿主 literalTypeOf 定级参与同构·745 轮 q1~q16
//   探针矩阵实证面）。修前 v2 推导族对带 L/LL/U 后缀字面量恒 0 豁免标记/
//   整32 文案——算术二元恒放行静默截断（q1 `甲=3000000000L+0` 宿主拒 vs v2
//   放行）+直赋/守卫/返回面文案错位。三分法（788）：
//   ①无后缀非负→豁免标记随另一侧（既有）；
//   ②窄伴侣+字面量→285 拉窄放行（1005 正测面）；
//   ③带后缀定级参与→本用例拒绝面（四通道：赋值/声明初始化/返回/守卫）。
//   双侧同拒锁：宿主与 v2 诊断逐字一致（除 195/824 既有架构差异面外）。
函数 出() -> 整32 {
    返回 1L + 0;              // 返回通道：整64→返回类型 整32 拒
}
函数 主() -> 整32 {
    变量 甲 = 0;
    甲 = 3000000000L + 0;     // q1 主形态：1L 定级整64+0 豁免随侧=整64 拒
    整32 乙 = 0;
    乙 = 乙 + 1L;             // q2：整32 伴侣不豁免（1L 定级整64 拒）
    甲 = 1L + 2;              // q6：双字面量 L+无后缀（2 随 1L=整64 拒）
    甲 = 1L + 2L;             // q8：双带后缀（整64+整64=整64 拒）
    甲 = 1L * 2;              // 乘法同面
    甲 = 1L & 2;              // q10：位面（无 285·整64 拒）
    甲 = 1L << 2;             // 移位面带 L（整64 拒）
    整32 丙 = 1L + 0;         // 声明初始化通道
    甲 = 1LL + 0;             // LL→整128 拒
    甲 = 3000000000L;         // 直赋带 L（整64→整32 拒）
    整32 丁 = 3000000000;     // 无后缀超域（整32 恒定级·值域拒）
    如果 (1L + 0) {           // 守卫通道：非布尔拒
        返回 1;
    }
    返回 出();
}
