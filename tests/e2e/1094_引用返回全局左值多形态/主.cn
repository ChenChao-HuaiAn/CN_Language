// E2E 1094（1036 根治·986 衍生呈报·dual 双侧）：v2 引用返回非参数全局左值——
//   返址=全局变量 .data 符号地址（对齐宿主 genIdentifierLvalue 87-a isGlobalStatic）
//   + 解引用读宽=被引用类型精确码（窄槽不越读相邻字段——对齐宿主
//   emitRefReturnDeref mapType(剥&类型) 读宽）。
//   病面（v2 单侧·986 衍生呈报）：返回 全局值; 返址=lea [rbp-哨兵槽] 栈地址
//   （镜像槽写入块不可达·v2asm 实锤死代码）→ 调用方解引用读栈垃圾
//   （改正前实录：读=0/写丢/盒值=25769803781 邻字段拼接 vs 宿主 40/100/5）。
//   多形态：①读（赋值右值消费）②写（调用作赋值目标·写穿全局）③链式
//   （引用返回调用=引用返回调用）④嵌套（打印实参位·调用+运算）⑤引用绑定
//   别名写穿 ⑥全局结构体字段（窄读锚：值 5 不得拼接邻字段 6）⑦形参对照
//   （既有正确面·1012/1080 族不回归）⑧被调副作用计数。
整32 全局值 = 40;
整32 全局乙 = 7;
整32 全局计数 = 0;

结构体 盒子 {
    整32 值;
    整32 另;
}

盒子 全局盒;

不安全 函数 取全局() -> 整32& {
    全局计数 = 全局计数 + 1;
    返回 全局值;
}

不安全 函数 取乙() -> 整32& {
    全局计数 = 全局计数 + 1;
    返回 全局乙;
}

函数 取盒值() -> 整32& {
    返回 全局盒.值;
}

函数 取参(整32& 甲) -> 整32& {
    返回 甲;
}

不安全 函数 初始化盒() {
    全局盒.值 = 5;
    全局盒.另 = 6;
}

函数 主() -> 整32 {
    初始化盒();
    // ①读（赋值右值消费）——修前 v2 读栈垃圾 0
    整32 m = 取全局();
    打印("形一 读=", m);
    // ②写（调用作赋值目标）——修前 v2 写丢（全局=40 原值）
    取全局() = 100;
    打印("形二 写后=", 全局值);
    // ③链式（引用返回调用=引用返回调用）
    取全局() = 取乙();
    打印("形三 链式=", 全局值);
    // ④嵌套（打印实参位·调用+运算）
    打印("形四 嵌套=", 取乙() + 1);
    // ⑤引用绑定别名写穿
    整32& 别名 = 取乙();
    别名 = 33;
    打印("形五 别名写=", 全局乙);
    // ⑥全局结构体字段（窄读锚：值=5，修前 v2 读出 0x00000006_00000005）
    打印("形六 盒值=", 取盒值());
    取盒值() = 99;
    打印("形七 盒写后=", 全局盒.值);
    // ⑦形参对照（既有正确面·不回归）
    整32 a = 77;
    打印("形八 参=", 取参(a));
    // ⑧被调副作用计数
    打印("计数=", 全局计数);
    返回 0;
}
