// E2E 1496_转移入容器源壳释放对齐（#966 锁用例·923 派生）：
//   表.追加(转移(甲)) 与 表.追加(甲)（拷贝对照）稳态活动分配数一致=转移源壳
//   零孤儿。根治前：转移展开句柄交接+源槽清零（459-a）后源壳无人释放——
//   深拷独立拥有（630）语义下源=孤儿·每调用泄 1 壳（斜率 3 vs 拷贝 2 实录）。
//   修复=入容器位 转移(类源) 登记 pendingArgCleanups（"966壳$" 打标）·追加
//   调用发射完成后 flush DeleteObject 级联（662 接收者临时析构同款序列·
//   判空+无析构类字段级联+壳释放）。相对断言（两容器稳态差=0）避开绝对
//   常驻数脆弱面。
//   断言：对照容器与转移容器大小 10/10·活动分配数差=0。
导入 容器::向量;

类 货品 {
公开:
    向量<字符串> 记录;
    函数 货品() { 记录 = 向量<字符串>(); }
    函数 ~货品() { }
    不安全 函数 货品(货品& 其他) { 记录 = 其他.记录; }
}
函数 主() -> 整32 {
    向量<货品> 表转移;
    整64 基 = 内存::活动分配数();
    循环 (整32 i = 0; i < 10; i += 1) {
        货品 甲;
        结果<空类型, 整32> 加1 = 甲.记录.追加("件");
        如果 (!加1.正常) { 返回 1; } 否则 { }
        结果<空类型, 整32> 加2 = 表转移.追加(转移(甲));
        如果 (!加2.正常) { 返回 2; } 否则 { }
    }
    整64 转移后 = 内存::活动分配数() - 基;
    向量<货品> 表对照;
    循环 (整32 i = 0; i < 10; i += 1) {
        货品 乙;
        结果<空类型, 整32> 加3 = 乙.记录.追加("件");
        如果 (!加3.正常) { 返回 3; } 否则 { }
        结果<空类型, 整32> 加4 = 表对照.追加(乙);
        如果 (!加4.正常) { 返回 4; } 否则 { }
    }
    整64 对照后 = 内存::活动分配数() - 转移后;
    打印(表转移.大小());
    打印(表对照.大小());
    打印(转移后 - 对照后);
    如果 (表转移.大小() != 10) { 返回 5; }
    如果 (表对照.大小() != 10) { 返回 6; }
    如果 (转移后 != 对照后) { 返回 7; }
    返回 0;
}
