// E2E 1496_转移入容器源壳释放对齐（#966+#1501 锁用例·923 派生）：
//   表.追加(转移(甲)) 与 表.追加(甲)（拷贝对照）稳态活动分配数一致=转移源壳
//   零孤儿（#966）；表.追加(w.造())（方法调用返回类临时入容器位）与拷贝对照
//   稳态一致=临时壳零孤儿（#1501）。根治前：转移源壳每调用泄 1（斜率 3 vs 2
//   实录）·v2 临时壳每调用泄 1（1496 dual v2 侧返回 7 实录）。
//   修复=入容器位实参登记（宿主 genTransferClassArgWithCleanup966+v2 转移壳
//   临时们/1501 方法返回类临时同表）→调用发射后 IR_删除对象 整壳析构。
//   相对断言（各形态 vs 拷贝对照稳态差=0）避开绝对常驻数脆弱面。
导入 容器::向量;

类 货品 {
公开:
    向量<字符串> 记录;
    函数 货品() { 记录 = 向量<字符串>(); }
    函数 ~货品() { }
    不安全 函数 货品(货品& 其他) { 记录 = 其他.记录; }
}
类 工场 {
公开:
    函数 造() -> 货品 {
        货品 p;
        结果<空类型, 整32> 加 = p.记录.追加("件");
        如果 (!加.正常) { 返回 p; } 否则 { }
        返回 p;
    }
}
函数 主() -> 整32 {
    工场 w;
    向量<货品> 表转移;
    整64 基 = 内存::活动分配数();
    循环 (整32 i = 0; i < 10; i += 1) {
        货品 甲;
        结果<空类型, 整32> 加1 = 甲.记录.追加("件");
        如果 (!加1.正常) { 返回 1; } 否则 { }
        结果<空类型, 整32> 加2 = 表转移.追加(转移(甲));
        如果 (!加2.正常) { 返回 2; } 否则 { }
    }
    整64 转移后 = 内存::活动分配数() - 基;
    向量<货品> 表对照;
    循环 (整32 i = 0; i < 10; i += 1) {
        货品 乙;
        结果<空类型, 整32> 加3 = 乙.记录.追加("件");
        如果 (!加3.正常) { 返回 3; } 否则 { }
        结果<空类型, 整32> 加4 = 表对照.追加(乙);
        如果 (!加4.正常) { 返回 4; } 否则 { }
    }
    整64 对照后 = 内存::活动分配数() - 转移后;
    向量<货品> 表Tmp;
    循环 (整32 i = 0; i < 10; i += 1) {
        结果<空类型, 整32> 加5 = 表Tmp.追加(w.造());
        如果 (!加5.正常) { 返回 8; } 否则 { }
    }
    整64 临时后 = 内存::活动分配数() - 对照后;
    向量<货品> 表对照2;
    循环 (整32 i = 0; i < 10; i += 1) {
        货品 丙;
        结果<空类型, 整32> 加6 = 丙.记录.追加("件");
        如果 (!加6.正常) { 返回 9; } 否则 { }
        结果<空类型, 整32> 加7 = 表对照2.追加(丙);
        如果 (!加7.正常) { 返回 10; } 否则 { }
    }
    整64 对照2后 = 内存::活动分配数() - 临时后;
    打印(表转移.大小());
    打印(表对照.大小());
    打印(转移后 - 对照后);
    打印(表Tmp.大小());
    打印(临时后 - 对照2后);
    如果 (表转移.大小() != 10) { 返回 5; }
    如果 (表对照.大小() != 10) { 返回 6; }
    如果 (转移后 != 对照后) { 返回 7; }
    如果 (表Tmp.大小() != 10) { 返回 11; }
    如果 (临时后 != 对照2后) { 返回 12; }
    返回 0;
}
