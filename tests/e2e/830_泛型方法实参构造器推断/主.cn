// 830 泛型方法实参位构造器推断（106·890 残余形态·2026-10-13）
// 立账=106 立案（v9 采样·基线 e36f1f4e9）：「泛型方法实参位构造器推断失败」——
//   宿主 表.追加(无) 报「无法将 '空类型*' 隐式转换为 '可选$整32'」形态。
// 覆盖四面（宿主+v2p 双编译对照）：
//   ① 泛型类实例方法 实参位「某些(5)」——890 覆盖标注的泛型方法面清偿
//      （v2 原缺：无语境成员面构造器回取 → 「须用于 结果/可选 语境」误拒）+
//      方法内聚合字段整体写/读回（v2 508-a 合成体字段值拷）
//   ② 非泛型类方法 实参位构造器（裸语句）
//   ③ 容器实例方法 条件位构造器 + 实参=「无」（空可选装箱）
//   ④ 泛型类方法 实参=「无」——宿主空指针常量→$ 形态可选转换豁免 +
//      v2 形参结构位登记（源地址契约）配套
导入 容器::向量;

泛型 <类型 T>
类 盒子 {
公开:
    T 值槽;
    函数 放(T 值) {
        值槽 = 值;
    }
    函数 取() -> T {
        返回 值槽;
    }
}

类 平盒 {
公开:
    可选<整32> 值槽;
    函数 放(可选<整32> 值) {
        值槽 = 值;
    }
}

函数 主() -> 整32 {
    // ① 泛型类实例方法 实参位构造器 + 读回
    盒子<可选<整32>> 盒;
    盒.放(某些(5));
    可选<整32> r1 = 盒.取();
    如果 (r1.有值) {
        打印行("①=", r1.值);
    } 否则 { 返回 1; }
    // ② 非泛型类方法 实参位构造器（裸语句）
    平盒 甲;
    甲.放(某些(6));
    // ③ 容器实例方法 条件位构造器 + 实参=无（空可选）
    向量<可选<整32>> 表 = 向量<可选<整32>>();
    如果 (表.追加(某些(7)).正常) {
        可选<整32> e1 = 表.元素(0);
        如果 (e1.有值) {
            打印行("③=", e1.值);
        } 否则 { 返回 3; }
    } 否则 { 返回 4; }
    如果 (表.追加(无).正常) {
        可选<整32> e2 = 表.元素(1);
        如果 (e2.有值) { 返回 5; }
    } 否则 { 返回 6; }
    // ④ 泛型类方法 实参=无（空可选写读）
    盒子<可选<整32>> 空盒;
    空盒.放(无);
    可选<整32> r4 = 空盒.取();
    如果 (r4.有值) { 返回 7; }
    打印行("④=空");
    返回 0;
}
