// E2E 1073：手动内存·复制内存/置零内存（001 §10.2 内存管理 API 对）
//   覆盖：① 复制内存 按字节复制（memcpy 语义：全量复制 + 只复制前 N 字节的边界）
//         ② 置零内存 按字节清零（memset 0：全块清零 + 前缀部分清零）
//         ③ 与 分配/释放 组合 + 内存::活动分配数 收支平衡（不泄漏）
//   双编译对照：宿主与 v2 同源码编译运行，输出逐行一致、退出码一致（0）。
不安全 函数 主() -> 整32 {
    整64 基线 = 内存::活动分配数();
    打印("===== 手动内存：复制内存/置零内存 =====");

    // ① 整64 槽：先全块置零 → 部分复制（只前两槽）→ 全量复制
    整64* 源 = 分配(3 * 类型大小(整64));
    源[0] = 11;
    源[1] = 22;
    源[2] = 33;
    整64* 目标 = 分配(3 * 类型大小(整64));
    置零内存(目标, 3 * 类型大小(整64));
    打印("置零后: ", 目标[0], " ", 目标[1], " ", 目标[2]);          // 0 0 0
    复制内存(目标, 源, 2 * 类型大小(整64));                          // 只复制前 2 槽
    打印("部分复制: ", 目标[0], " ", 目标[1], " ", 目标[2]);        // 11 22 0
    复制内存(目标, 源, 3 * 类型大小(整64));                          // 全量覆盖
    打印("全量复制: ", 目标[0], " ", 目标[1], " ", 目标[2]);        // 11 22 33

    // ② 字节粒度：计数单位是字节（非元素）——部分复制/部分清零的边界面
    整8* 源串 = 分配(4);
    源串[0] = 9;
    源串[1] = 8;
    源串[2] = 7;
    源串[3] = 6;
    整8* 目标串 = 分配(4);
    置零内存(目标串, 4);
    复制内存(目标串, 源串, 2);                                       // 只复制 2 字节
    打印("字节级复制: ", 目标串[0], " ", 目标串[1], " ", 目标串[2], " ", 目标串[3]);
    置零内存(目标串, 3);                                             // 前缀 3 字节归零
    打印("字节级置零: ", 目标串[0], " ", 目标串[1], " ", 目标串[2], " ", 目标串[3]);

    // ③ 与 分配/释放 组合：分配即计、释放即减，活动分配数回落基线（无泄漏）
    整64* 甲 = 分配(2 * 类型大小(整64));
    整64* 乙 = 分配(2 * 类型大小(整64));
    复制内存(乙, 甲, 2 * 类型大小(整64));
    置零内存(甲, 2 * 类型大小(整64));
    释放(乙);
    释放(甲);
    释放(目标串);
    释放(源串);
    释放(目标);
    释放(源);
    打印("分配/释放收支平衡: ", 内存::活动分配数() == 基线);         // 真

    打印("===== 手动内存测试完成 =====");
    返回 0;
}
