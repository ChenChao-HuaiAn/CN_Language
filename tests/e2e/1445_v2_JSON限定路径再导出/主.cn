// E2E 1445_v2：JSON 模块拆分后限定路径再导出（#751 P1-1·v2 语义面独占）
//   锁定：模块已加载后 ①JSON::JSON树 限定类型可用（类变量声明+成员访问）；
//   ②JSON::JSONE_好 / JSON::JSONT_对象 限定常量可用（编译期折叠读值正确）。
//   v2 1011 再导出转发表下沉至限定类型/常量查询（语义检查类型引用 + IR 查常量值）。
//   宿主语言层不支持限定类型/常量读取（把 JSON 当普通标识符·非拆分缺陷面），
//   故本面走 v2 闭环；宿主侧导入面由 1445 锁定。
导入 JSON::{JSON树};

函数 主() -> 整32 {
    JSON::JSON树 树;
    整64 甲 = JSON::JSONE_好;
    整64 乙 = JSON::JSONT_对象;
    如果 (甲 != 0 || 乙 != 7) {
        打印("常量=", 甲, "/", 乙);
        返回 1;
    }
    树.根 = 5;
    如果 (树.根 != 5) {
        打印("根=", 树.根);
        返回 2;
    }
    打印("v2限定: 常量=", 甲, "/", 乙, " 根=", 树.根);
    返回 0;
}
