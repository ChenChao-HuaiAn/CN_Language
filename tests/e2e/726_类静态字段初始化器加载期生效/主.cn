// 726（468·甲案翻案锁面）：类静态字段声明初始化器=加载期生效（001 §静态成员）
//   三形态一致性（顶层/类内/函数内全生效·宿主 v2 双侧）+支持面锁（十进制/十六
//   进制/一元负号/布尔）+读写链锚（赋值覆盖初值·区分「槽坏」与「初值
//   不生效」）。修前实证：宿主类内恒 0（收集→注册面丢弃→emitOopGlobals 写死
//   dq 0 全链缺失）·v2 原生单 token 直存=分叉 7057/7757。
类 柜 {
公开:
    静态 整32 总数 = 7
    静态 整32 负数 = -5
    静态 整64 大值 = 0x10
    静态 布尔 开关 = 真
    静态 布尔 关闭 = 假
    函数 柜() { }
}
静态 整32 顶层值 = 7;
函数 主() -> 整32 {
    打印(顶层值);              // 7（顶层形态·现状生效锚）
    打印(柜.总数);             // 7（类内形态·本任务翻案面）
    打印(柜.负数);             // -5（一元负号直存）
    打印(柜.大值);             // 16（十六进制字面量→规范十进制）
    如果 (柜.开关) { 打印(1); } 否则 { 打印(0); }   // 1（布尔直存=真）
    如果 (柜.关闭) { 打印(9); } 否则 { 打印(8); }   // 8（布尔直存=假）
    柜.总数 = 5;                 // 读写链锚：赋值覆盖加载期初值
    打印(柜.总数);             // 5
    静态 整32 函数内值 = 7;
    打印(函数内值);            // 7（函数内形态·现状生效锚）
    返回 0;
}
