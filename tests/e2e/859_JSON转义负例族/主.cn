// 859（#352）：stdlib JSON 转义族纵深 E2E——与 669 分工（669=正例主干往返自测；
//   本用例=转义/整数保真/生成转义纵深）。覆盖：
//   ① RFC 8259 短转义全集 \" \\ \/ \b \f \n \r \t 解码+生成再生（\/ 解码后生成 /）；
//   ② \uXXXX 四档（1 字节 A / 2 字节 é / 3 字节 你 / 代理对合成 4 字节 😀=F0 9F 98 80
//     逐字节值断言·高字节经 正8 无符号直读——001 §字符串下标符号扩展语义）；
//   ③ 整数标志往返保真（2^53+1 双精度丢精度数·整64 上界——解析/整值/生成三面逐字）；
//   ④ 生成侧转义（控制字符→\u00XX 再生·非 ASCII UTF-8 直通）。
//   〔缩形注记·扩回义务〕负例族（代理对三形态/\u 非十六/未知转义/未闭合/未转义控制
//   字符/尾逗号/缺冒号/深超 64|65 边界/重置复用 #365 验收链）已实现并宿主全绿
//   （临时二分用例 859tmpb/c+859c1~c4 实证），但 v2 侧 记错() 全路径写丢（方法内经
//   this 指针字段解引用写标量不生效·#351 同族 v2 win 形态·**已立 #594**）——负例断言
//   v2 全放行错误码=0，dual 无法绿。**#594 清偿轮扩回负例族入本用例**（二分用例
//   现象/根因/复现全文见 #594 台账行）。另：宿主 方法返回串临时物链式下标错位
//   （[1] 读得 [0] 值）已立 #596——本用例下标读一律先落局部变量（写法规避·根治待 596）。
//   断言走 测试框架（同 669 showcase：JSON+测试框架 双模块同轮 dual）。
导入 测试框架::{测试器, 运行用例, 断言真, 断言相等整数, 断言相等文本, 测试汇总};
导入 JSON::{JSON树, 解析JSON, 生成JSON, 重置JSON树, JSONE_好, JSONE_语法, JSONE_深超};

// ① 短转义全集：解码+生成再生逐字比对（\/ 解码后生成 /——RFC 允许不转义）
不安全 函数 用例短转义再生(测试器* 器) {
    JSON树 树 = JSON树();
    解析JSON(树, "\"a\\\"b\\\\c\\/d\\be\\ff\\ng\\rh\\ti\"");
    断言相等整数(器, 树.错误码, JSONE_好, "短转义解析成功");
    字符串 值 = 树.文本(树.根);
    断言相等整数(器, 字符串长度(值), 17, "短转义解码长度17");
    // 关键字节抽样（\"\\\/\b 四种+尾字节——ASCII<128 无符号扩展歧义）
    断言相等整数(器, 整64(值[1]), 34, "解码引号");
    断言相等整数(器, 整64(值[3]), 92, "解码反斜杠");
    断言相等整数(器, 整64(值[5]), 47, "解码斜杠");
    断言相等整数(器, 整64(值[7]), 8, "解码退格");
    断言相等整数(器, 整64(值[16]), 105, "尾字节i");
    // 生成再生：\/ 还原为 /（其余短转义原样转义回）
    字符串 再生 = 生成JSON(树, 树.根, 0);
    断言相等文本(器, 再生, "\"a\\\"b\\\\c/d\\be\\ff\\ng\\rh\\ti\"", "短转义再生逐字");
}

// ② \u 四档：1/2/3 字节+代理对合成 4 字节，逐字节值断言
不安全 函数 用例u转义四档(测试器* 器) {
    JSON树 树 = JSON树();
    解析JSON(树, "\"\\u0041\"");
    断言相等整数(器, 树.错误码, JSONE_好, "u一字节解析");
    断言相等整数(器, 字符串长度(树.文本(树.根)), 1, "u一字节长度");
    字符串 值一 = 树.文本(树.根);
    断言相等整数(器, 整64(值一[0]), 65, "u一字节A");
    解析JSON(树, "\"\\u00e9\"");
    断言相等整数(器, 树.错误码, JSONE_好, "u二字节解析");
    断言相等整数(器, 字符串长度(树.文本(树.根)), 2, "u二字节长度");
    字符串 值二 = 树.文本(树.根);
    断言相等整数(器, 整64(正8(值二[0])), 195, "u二字节首C3");
    断言相等整数(器, 整64(正8(值二[1])), 169, "u二字节次A9");
    解析JSON(树, "\"\\u4f60\"");
    断言相等整数(器, 树.错误码, JSONE_好, "u三字节解析");
    断言相等整数(器, 字符串长度(树.文本(树.根)), 3, "u三字节长度");
    字符串 值三 = 树.文本(树.根);
    断言相等整数(器, 整64(正8(值三[0])), 228, "u三字节首E4");
    断言相等整数(器, 整64(正8(值三[1])), 189, "u三字节次BD");
    断言相等整数(器, 整64(正8(值三[2])), 160, "u三字节末A0");
    解析JSON(树, "\"\\ud83d\\ude00\"");
    断言相等整数(器, 树.错误码, JSONE_好, "代理对解析");
    断言相等整数(器, 字符串长度(树.文本(树.根)), 4, "代理对四字节");
    字符串 值四 = 树.文本(树.根);
    断言相等整数(器, 整64(正8(值四[0])), 240, "代理对F0");
    断言相等整数(器, 整64(正8(值四[1])), 159, "代理对9F");
    断言相等整数(器, 整64(正8(值四[2])), 152, "代理对98");
    断言相等整数(器, 整64(正8(值四[3])), 128, "代理对80");
}

// ③ 整数标志往返保真：2^53+1（双精度丢精度数）逐字保真·整64 上界/负界
不安全 函数 用例整数保真(测试器* 器) {
    JSON树 树 = JSON树();
    解析JSON(树, "{\"大\":9007199254740993}");
    断言相等整数(器, 树.错误码, JSONE_好, "大整数解析");
    断言相等整数(器, 树.整值(树.找键(树.根, "大")), 9007199254740993, "大整数整值");
    断言相等文本(器, 生成JSON(树, 树.根, 0), "{\"大\":9007199254740993}", "大整数生成保真");
    解析JSON(树, "{\"上\":9223372036854775807}");
    断言相等整数(器, 树.错误码, JSONE_好, "上界解析");
    断言相等整数(器, 树.整值(树.找键(树.根, "上")), 9223372036854775807, "上界整值");
    断言相等文本(器, 生成JSON(树, 树.根, 0), "{\"上\":9223372036854775807}", "上界生成保真");
    解析JSON(树, "{\"负\":-9223372036854775807}");
    断言相等整数(器, 树.错误码, JSONE_好, "负界解析");
    断言相等整数(器, 树.整值(树.找键(树.根, "负")), -9223372036854775807, "负界整值");
    断言相等文本(器, 生成JSON(树, 树.根, 0), "{\"负\":-9223372036854775807}", "负界生成保真");
}

// ④ 生成侧转义：控制字符→\u00XX 再生·非 ASCII UTF-8 直通
不安全 函数 用例生成转义(测试器* 器) {
    JSON树 树 = JSON树();
    解析JSON(树, "\"\\u0001\\u001f\"");
    断言相等整数(器, 树.错误码, JSONE_好, "控字符解析");
    断言相等文本(器, 生成JSON(树, 树.根, 0), "\"\\u0001\\u001f\"", "控字符再生u00XX");
    解析JSON(树, "\"甲乙\"");
    断言相等整数(器, 树.错误码, JSONE_好, "直通解析");
    // 非 ASCII 源直进→生成原样直通（不经 \u 转义）
    断言相等文本(器, 生成JSON(树, 树.根, 0), "\"甲乙\"", "UTF8直通再生");
    // 重置JSON树 导入面冒烟（#365 修复面正例侧·失败链负例随 #594 扩回）
    解析JSON(树, "{\"甲\":1}");
    断言相等整数(器, 树.错误码, JSONE_好, "重置前成功");
    重置JSON树(树);
    解析JSON(树, "[1,2]");
    断言相等整数(器, 树.错误码, JSONE_好, "重置后再成功");
    断言相等整数(器, 树.子数(树.根), 2, "重置后结构");
}

不安全 函数 主() -> 整32 {
    测试器 器 = 测试器();
    运行用例(器, "短转义再生", 用例短转义再生);
    运行用例(器, "u转义四档", 用例u转义四档);
    运行用例(器, "整数保真", 用例整数保真);
    运行用例(器, "生成转义", 用例生成转义);
    整64 失败数 = 测试汇总(器);
    打印("汇总返回失败用例数=", 失败数);
    返回 0;
}
