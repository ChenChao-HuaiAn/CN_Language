// E2E 1657（#1873·2026-10-31）：窄型复合位赋值发射锁（&= |= ^=）——
//   #1869 采样轮实录：陈旧宿主二进制（1159 步2 之前构建）对 整8/整16/正8
//   复合位赋值发射 `movzx ecx, [rbp-32]`（movzx 内存操作数缺 byte/word ptr
//   尺寸前缀）→ ml64 A2070 invalid instruction operands。现源码该面已经
//   1159/1281/1427 三轮根治（emitIntBinary 窄域双操作数统一走
//   emitNarrowOperandTo32 三分：常量 mov 直载/寄存器窄宽名/内存带尺寸
//   前缀），三后端全绿——本用例以**参数传入（不可折叠）**形态锁死该面，
//   防寄存器分配/常量折叠掩盖下坏形态回归（立即数与常量形态走不了内存
//   加载路径，锁不住病根）。
//   校验=位权累加（任一形态错值即定位到具体位）：九形态全对=511。
//   双编译对照：宿主与 v2 同源同测，输出/退出码逐行一致。
函数 八与(整8 甲, 整8 乙) -> 整32 { 甲 &= 乙; 返回 整32(甲); }
函数 八或(整8 甲, 整8 乙) -> 整32 { 甲 |= 乙; 返回 整32(甲); }
函数 八异(整8 甲, 整8 乙) -> 整32 { 甲 ^= 乙; 返回 整32(甲); }
函数 十六与(整16 甲, 整16 乙) -> 整32 { 甲 &= 乙; 返回 整32(甲); }
函数 十六或(整16 甲, 整16 乙) -> 整32 { 甲 |= 乙; 返回 整32(甲); }
函数 十六异(整16 甲, 整16 乙) -> 整32 { 甲 ^= 乙; 返回 整32(甲); }
函数 正八与(正8 甲, 正8 乙) -> 整32 { 甲 &= 乙; 返回 整32(甲); }
函数 正八或(正8 甲, 正8 乙) -> 整32 { 甲 |= 乙; 返回 整32(甲); }
函数 正八异(正8 甲, 正8 乙) -> 整32 { 甲 ^= 乙; 返回 整32(甲); }
函数 主() -> 整32 {
    整32 校验 = 0;
    // ---- 整8：12(1100) 与 10(1010)、或、异或 ----
    如果 (八与(12, 10) == 8)  { 校验 = 校验 + 1; }
    如果 (八或(12, 10) == 14) { 校验 = 校验 + 2; }
    如果 (八异(12, 10) == 6)  { 校验 = 校验 + 4; }
    // ---- 整16：1000 与 250 ----
    如果 (十六与(1000, 250) == 232)  { 校验 = 校验 + 8; }
    如果 (十六或(1000, 250) == 1018) { 校验 = 校验 + 16; }
    如果 (十六异(1000, 250) == 786)  { 校验 = 校验 + 32; }
    // ---- 正8（无符号域）----
    如果 (正八与(250, 10) == 10)  { 校验 = 校验 + 64; }
    如果 (正八或(250, 5) == 255)  { 校验 = 校验 + 128; }
    如果 (正八异(250, 15) == 245) { 校验 = 校验 + 256; }
    打印(校验);
    返回 0;
}
