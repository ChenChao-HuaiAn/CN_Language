// 628(#250→262 重定 scope·正测·001 §5.8a/§5.8b)：互斥锁<整32>（可搬运载荷）
//   线程上下文全生命周期零拒绝——类型化互斥锁在 新线程 任务体内构造/上锁/
//   解锁/析构（任务独立实例=无别名），主线程同型实例联用，spawn/join 全链
//   正常退出。可搬运谓词负面已由 626/627 双侧锚定（互斥锁<含裸指针>/结果<
//   含裸指针> 拒）。
//   〔262 报备·重定 scope〕原直传形态（新线程(任务, 锁) 类型化实参）属
//   「线程实参泛型化」域——001 §5.8b 明文「另域另立」未落地（互斥锁按值
//   拷贝语义未立法·021 #264），直传在两侧均为非法形态（250 收口批亦注记
//   「需 不安全 函数包装」）；本用例按现行法定盒形态（586 同款·不安全 区
//   顶层 空类型* 豁免窗口）承载验证。可搬运谓词正面的端到端观测随泛型化
//   立法落地后恢复。
//   win=运行时桩（运行时错误9·新线程 spawn）——win 本地跳过（run_e2e
//   平台跳过 win-x64·586/610 同模式）·linux 全量真跑。
导入 线程::新线程;
导入 线程::并入线程;

不安全 函数 任务(空类型* 未用) -> 整64 {
    互斥锁<整32> 任务锁 = 互斥锁<整32>(7);
    任务锁.上锁();
    任务锁.值 = 任务锁.值 + 1;
    任务锁.解锁();
    返回 0;
}

不安全 函数 主() -> 整32 {
    互斥锁<整32> 主锁 = 互斥锁<整32>(40);
    结果<空类型*, 整32> 建 = 新线程(任务, 无);
    空类型* 线程柄 = 无;
    如果 (建.正常) { 线程柄 = 建.值; } 否则 { 返回 3; }
    并入线程(线程柄);
    主锁.上锁();
    主锁.值 = 主锁.值 + 2;
    主锁.解锁();
    打印行(主锁.值);
    返回 0;
}
