// E2E 1569：可选空值赋值与结构体数组字段空元素（#1651/#1652 双编译对照正例）
//   病面（修前实测）：
//     #1651〔双侧〕`无` 赋给 可选 目标——聚合整体赋值通道把 NullLiteral 求值产物
//       （常量 0）当**源地址**，CopyStruct 16 字节从地址 0 读 → C0000005 fault=0；
//       宿主与 v2 同崩（可选<整32>/<整64>/<字符串> 全复现；类构造体内裸字段
//       `选 = 无` 即触发）。
//     #1652〔v2〕结构体字面量数组字段初始化列表含 `无` 元素（{ 无, 某些(x) }）与
//       合成体单字段 `= 无`——v2 同样 16B 从地址 0 整块拷贝崩溃；v2 局部可选
//       变量 `= 无` 另报「合成体初值/赋值源类型无法解析」中止。宿主侧初始化列表
//       空元素已由 #1602 按元素宽度零写。
//   锁面（语义=空载荷「判别位 0 + 载荷零」，覆盖旧载荷按 tag 守卫释放）：
//     ① 类实例 可选<整32>/<整64>/<字符串> 构造体内裸字段 = 无（栈上实例化读回）
//     ② 类实例成员链 对象.字段 = 无（某些→无→某些 重赋；整64 8 字节载荷大值）
//     ③ 结构体字段 单=无 / 单64=无；字段数组 { 无, 某些(9) } 混合；
//        字段数组元素 `乙.组[0] = 某些(11)` / `乙.组[1] = 无` 赋值位
//     ④ 可选<字符串>[2] 字段 初始化列表 { 无, 某些(字符串复制(...)) } 读回
//     ⑤ 局部变量 可选<整32>/<整64>/<字符串> = 无（含重赋）
//     ⑥ 局部数组元素 可选<字符串>[2] = { 某些(串), 无 } + `组串[0] = 无`
//   断言：全部 有值/值/字符串载荷逐行 + 局部块（⑤⑥）活动分配数残留=0。
//   说明：类字段/字段数组的**块退出释放**存量泄漏面（不与本案修复路径相关）
//     不纳入断言——已立项 #1668（宿主）/ #1669（v2）。
类 类甲 {
公开:
    可选<整32> 选32;
    可选<整64> 选64;
    可选<字符串> 选串;
    函数 类甲() { 选32 = 无; 选64 = 无; 选串 = 无; }
    函数 取32() -> 整32 {
        如果 (选32.有值) { 返回 选32.值; }
        返回 -1;
    }
}

结构体 盒 {
    可选<整32> 单;
    可选<整64> 单64;
    可选<整32>[2] 组;
    可选<字符串>[2] 串组;
}

不安全 函数 主() -> 整32 {
    类甲 甲;
    打印("甲取=", 甲.取32());
    打印("甲64有值=", 甲.选64.有值);
    甲.选64 = 某些(8589934603);
    如果 (甲.选64.有值) { 打印("甲64值=", 甲.选64.值); }
    甲.选64 = 无;
    打印("甲64再=", 甲.选64.有值);
    甲.选串 = 某些(字符串复制("类串载荷"));
    如果 (甲.选串.有值) { 打印("甲串=", 甲.选串.值); }
    甲.选串 = 无;
    打印("甲串再=", 甲.选串.有值);

    盒 乙 = 盒{ 单 = 无, 单64 = 无, 组 = { 无, 某些(9) },
               串组 = { 无, 某些(字符串复制("乙字段串")) } };
    打印("乙单=", 乙.单.有值);
    打印("乙单64=", 乙.单64.有值);
    打印("乙0=", 乙.组[0].有值);
    打印("乙1=", 乙.组[1].有值);
    如果 (乙.组[1].有值) { 打印("乙1值=", 乙.组[1].值); }
    打印("乙串0=", 乙.串组[0].有值);
    打印("乙串1=", 乙.串组[1].有值);
    如果 (乙.串组[1].有值) { 打印("乙串1值=", 乙.串组[1].值); }
    乙.组[0] = 某些(11);
    如果 (乙.组[0].有值) { 打印("乙0改=", 乙.组[0].值); }
    乙.组[1] = 无;
    打印("乙1改=", 乙.组[1].有值);
    乙.单 = 某些(13);
    如果 (乙.单.有值) { 打印("乙单改=", 乙.单.值); }
    乙.单 = 无;
    打印("乙单再=", 乙.单.有值);

    整64 前 = 内存::活动分配数();
    {
        可选<整32> 局 = 某些(5);
        局 = 无;
        打印("局=", 局.有值);
        可选<整64> 局64 = 某些(4294967301);
        局64 = 无;
        打印("局64=", 局64.有值);
        可选<字符串> 局串 = 某些(字符串复制("局部串"));
        局串 = 无;
        打印("局串=", 局串.有值);
        可选<字符串>[2] 组串 = { 某些(字符串复制("元素串")), 无 };
        组串[0] = 无;
        打印("组串0=", 组串[0].有值);
        打印("组串1=", 组串[1].有值);
    }
    打印("残留=", 内存::活动分配数() - 前);
    返回 0;
}
