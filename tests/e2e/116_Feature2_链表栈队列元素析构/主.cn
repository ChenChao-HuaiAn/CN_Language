// 116_Feature2_其余容器元素析构（2026-08-25）：链表/栈/队列 元素自动析构——完整版。
//   编译器级注入（injectContainerElemDestroy，Feature 2 泛化）：
//     链表 删除头部/删除尾部/清空、~链表  -> 自动析构被移除/全部元素；
//     栈/队列 弹出/出队（返回元素=所有权转移给调用方）-> 容器不析构·盒亡
//     析构副本（1019 任务 182 RAII 正账——原「不析构」表述系盒无面时代泄漏
//     账误载·v2 946 面早已此账·宿主 182 补面对齐·测试升级报备）；
//     栈/队列 清空、~栈/~队列               -> 自动全量析构。
//   注入点：emitClassMethod 生成 容器$T 方法体前；仅当 T 为有析构类时注入。
//   全局析构计数验证（+1/次析构）。
//   语义更新（2026-09-11 第七十二轮 72-a 用户裁决方案A）：宿主 RAII 由「函数级」
//     升级为「块级作用域」（对齐 v2 块出口析构 / Rust 作用域 drop）——各块的
//     资源局部（r1/r2/r3、s1/s2、q1/q2/q3 及各容器局部）在**块出口**即析构
//     （原为函数返回前，故原期望的块内打印看不到这些计数）。现期望值=块出口
//     累积口径（链表块结束 6 = 容器操作 3 + r1/r2/r3 3；队列块结束 11）。
//   948 加固（2026-10-18·测试升级报备）：**被析构元素身份断言**——原仅计数
//     （+1/次）对「析构了哪个元素」盲：v2 全量析构平铺取槽（0..数量-1）缺陷
//     期，删头/删尾后清空会二次析构已摘槽元素、链上存活元素反漏析构——计数
//     巧合相同（1+1+1）而身份错位（宿主 E1→E3→E2 vs v2 E1→E3→E1）。现析构
//     器在 监视 窗口内按 累计=累计*10+编号 累积身份序：链表段 132（E1,E3,E2·
//     链游=头索引→下一索引）、队列清空段 23（E2,E3·出队后剩余链元素）——
//     身份错位/错槽/二次析构即红（948 全量链游修复的回归锚）。

导入 容器::链表;
导入 容器::栈;
导入 容器::队列;

静态 整64 计数 = 0;
静态 整64 监视 = 0;
静态 整64 累计 = 0;

类 资源 {
公开:
    整64 编号;
    函数 资源(整64 v) { 编号 = v; }
    函数 资源(资源& 其他) { 编号 = 其他.编号; }
    不安全 函数 ~资源() {
        计数 = 计数 + 1;
        如果 (监视 == 1) {
            累计 = 累计 * 10 + 编号;
        }
    }
}

不安全 函数 主() -> 整32 {
    // 链表：删除头部/删除尾部/清空 自动析构被移除元素（身份序 1→3→2）
    {
        链表<资源> 表;
        资源 r1 = 资源(1);
        资源 r2 = 资源(2);
        资源 r3 = 资源(3);
        结果<空类型, 整32> a1 = 表.追加(r1);
        结果<空类型, 整32> a2 = 表.追加(r2);
        结果<空类型, 整32> a3 = 表.追加(r3);
        打印("链表 大小: ", 表.大小());
        监视 = 1;
        累计 = 0;
        结果<空类型, 整32> d1 = 表.删除头部();   // 析构被移除元素 +1（E1）
        打印("删头后: ", 表.大小(), " 析构: ", 计数);
        结果<空类型, 整32> d2 = 表.删除尾部();   // +1（E3）
        打印("删尾后: ", 表.大小(), " 析构: ", 计数);
        表.清空();                               // +1（E2·链游剩余链元素）
        监视 = 0;
        打印("清空后: ", 表.大小(), " 析构: ", 计数);
        打印("链表析构序: ", 累计);              // 132 = E1→E3→E2
    }
    打印("链表块结束: ", 计数);  // r1/r2/r3 块出口已析构（块级 RAII）：3+3=6

    // 栈：弹出 返回元素（所有权转移），不析构
    {
        栈<资源> 栈表;
        资源 s1 = 资源(1);
        资源 s2 = 资源(2);
        结果<空类型, 整32> p1 = 栈表.压入(s1);
        结果<空类型, 整32> p2 = 栈表.压入(s2);
        结果<资源, 整32> 弹 = 栈表.弹出();
        打印("栈弹出后大小: ", 栈表.大小(), " 析构: ", 计数);
    }

    // 队列：出队 返回元素（所有权转移给盒）·盒亡析构（182 正账）；清空 自动析构剩余
    {
        队列<资源> 队列表;
        资源 q1 = 资源(1);
        资源 q2 = 资源(2);
        资源 q3 = 资源(3);
        结果<空类型, 整32> qa1 = 队列表.入队(q1);
        结果<空类型, 整32> qa2 = 队列表.入队(q2);
        结果<空类型, 整32> qa3 = 队列表.入队(q3);
        结果<资源, 整32> 出 = 队列表.出队();
        打印("队弹出后: ", 队列表.大小(), " 析构: ", 计数);
        监视 = 1;
        累计 = 0;
        队列表.清空();                          // 析构剩余 2 个 +2（E2,E3·链游）
        监视 = 0;
        打印("队清空后: ", 队列表.大小(), " 析构: ", 计数);
        打印("队列清空序: ", 累计);              // 23 = E2→E3
    }
    返回 0;
}
