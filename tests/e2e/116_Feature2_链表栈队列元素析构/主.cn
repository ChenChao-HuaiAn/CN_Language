// 116_Feature2_其余容器元素析构（2026-08-25）：链表/栈/队列 元素自动析构——完整版。
//   编译器级注入（injectContainerElemDestroy，Feature 2 泛化）：
//     链表 删除头部/删除尾部/清空、~链表  -> 自动析构被移除/全部元素；
//     栈/队列 弹出/出队（返回元素=所有权转移给调用方）-> 不析构；
//     栈/队列 清空、~栈/~队列               -> 自动全量析构。
//   注入点：emitClassMethod 生成 容器$T 方法体前；仅当 T 为有析构类时注入。
//   全局析构计数验证（+1/次析构）。

导入 容器::链表
导入 容器::栈
导入 容器::队列

静态 整64 计数 = 0

类 资源 {
公开:
    整64 编号
    函数 资源(整64 v) { 编号 = v }
    函数 资源(资源& 其他) { 编号 = 其他.编号 }
    函数 ~资源() { 计数 = 计数 + 1 }
}

函数 主() -> 整32 {
    // 链表：删除头部/删除尾部/清空 自动析构被移除元素
    {
        链表<资源> 表
        资源 r1 = 资源(1)
        资源 r2 = 资源(2)
        资源 r3 = 资源(3)
        结果<空类型, 整32> a1 = 表.追加(r1)
        结果<空类型, 整32> a2 = 表.追加(r2)
        结果<空类型, 整32> a3 = 表.追加(r3)
        打印("链表 大小: ", 表.大小())
        结果<空类型, 整32> d1 = 表.删除头部()   // 析构被移除元素 +1
        打印("删头后: ", 表.大小(), " 析构: ", 计数)
        结果<空类型, 整32> d2 = 表.删除尾部()   // +1
        打印("删尾后: ", 表.大小(), " 析构: ", 计数)
        表.清空()                               // +1
        打印("清空后: ", 表.大小(), " 析构: ", 计数)
    }
    打印("链表块结束: ", 计数)  // r1/r2/r3 主返回才析构（函数级 RAII）

    // 栈：弹出 返回元素（所有权转移），不析构
    {
        栈<资源> 栈表
        资源 s1 = 资源(1)
        资源 s2 = 资源(2)
        结果<空类型, 整32> p1 = 栈表.压入(s1)
        结果<空类型, 整32> p2 = 栈表.压入(s2)
        结果<资源, 整32> 弹 = 栈表.弹出()
        打印("栈弹出后大小: ", 栈表.大小(), " 析构: ", 计数)
    }

    // 队列：出队 返回元素（所有权转移），不析构；清空 自动析构
    {
        队列<资源> 队列表
        资源 q1 = 资源(1)
        资源 q2 = 资源(2)
        资源 q3 = 资源(3)
        结果<空类型, 整32> qa1 = 队列表.入队(q1)
        结果<空类型, 整32> qa2 = 队列表.入队(q2)
        结果<空类型, 整32> qa3 = 队列表.入队(q3)
        结果<资源, 整32> 出 = 队列表.出队()
        打印("队弹出后: ", 队列表.大小(), " 析构: ", 计数)
        队列表.清空()                          // 析构剩余 2 个 +2
        打印("队清空后: ", 队列表.大小(), " 析构: ", 计数)
    }
    返回 0
}
