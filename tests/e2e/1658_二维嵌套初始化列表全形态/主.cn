// E2E 1658 正测 dual（#1769·2026-10-31 用户批甲案）：二维嵌套初始化列表
//   {{...}} 全形态全链——①标量二维嵌套 ②缺格补零 ③三维嵌套 ④结果元素
//   形态（1607 金标准 {{ 正常(1), 正常(2) }, { 正常(3), 正常(4) }}）⑤可选
//   元素（缺格=无值）⑥字符串元素（缺格=空串态）⑦类元素（显式构造+缺格=
//   默认构造·字段默认值注入）。001 §3.5 多维嵌套条文执法锚。
//   宿主=semantic_decl_init.cpp 递归+ir_decl_array.cpp 递归展开；v2=语义检查
//   初始化数组.cn+生成声明数组.cn 同构零分叉。
函数 读果(结果<整32, 整32> 元) -> 整32 {
    如果 (元.正常) { 返回 元.值; } 否则 { 返回 0 - 1; }
}
函数 读值(可选<整32> 元) -> 整32 {
    如果 (元.有值) { 返回 元.值; }
    返回 0 - 1;
}
类 箱 {
公开:
    整32 值 = 42;
    函数 读() -> 整32 { 返回 值; }
}
函数 主() -> 整32 {
    // ① 标量二维嵌套+缺格补零
    整32[2][2] 表 = { { 1, 2 }, { 3, 4 } };
    打印(表[0][0]);
    打印(表[1][1]);
    整32[2][3] 部 = { { 1 }, { 4, 5 } };
    打印(部[0][2]);
    打印(部[1][0]);
    // ② 三维嵌套
    整32[2][2][2] 立 = { { { 1, 2 }, { 3, 4 } }, { { 5, 6 }, { 7, 8 } } };
    打印(立[1][0][1]);
    整32[2][2][2] 立缺 = { { { 1 } } };
    打印(立缺[1][1][1]);
    // ③ 结果元素形态·缺格=异常态
    结果<整32, 整32>[2][2] 网 = { { 正常(1), 正常(2) }, { 正常(3), 正常(4) } };
    打印(读果(网[0][1]));
    结果<整32, 整32>[2][2] 果缺 = { { 正常(9) } };
    打印(读果(果缺[1][1]));
    // ④ 可选元素·缺格=无值
    可选<整32>[2][2] 选 = { { 某些(7) } };
    打印(读值(选[0][0]));
    打印(读值(选[1][0]));
    // ⑤ 字符串元素·缺格=空串态
    字符串[2][2] 串 = { { "甲", "乙" } };
    打印(串[0][0] + 串[1][1] + "尾");
    // ⑥ 类元素·显式构造+缺格=默认构造(字段默认值)
    箱[2][2] 箱网 = { { 箱() } };
    打印(箱网[0][0].读());
    打印(箱网[0][1].读());
    打印(箱网[1][1].读());
    返回 0;
}
