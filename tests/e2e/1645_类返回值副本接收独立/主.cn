// E2E 1645（2026-10-30 任务 1817·丁案 R1 落地锁面）：类返回值副本接收独立——
//   001 §5.3 返回值语义 R1（-> 类 = 值副本·接收方独立拥有）：函数返回类实例
//   后，接收方与来源对象此后互不影响（字段写不写穿、析构不共壳）。
//   历史缺陷（修前实录 rc=134）：宿主「调用返回源」接收=句柄直存/接管（与
//   来源共享同一堆壳）——字段写写穿来源、双方 RAII 析构同一堆=double free。
//   修=声明位（tryGenClassCopyInit 源形态扩 CallExpr·拷构/字段级深拷）+
//   赋值位（identifierClassCallProductAssign 接管改副本构造）；借出视图
//   访问器族（元素/获取等·630 产物已拥有副本）保持接管=排除双拷。
//   锁面：①声明位副本独立 ②赋值位副本独立（修前形态② 写穿=8）。
类 内 {
    公开:
    整32 值;
    函数 取() -> 整32 { 返回 值; }
}

类 外 {
    公开:
    内 值;
    函数 取() -> 内 { 返回 值; }
}

函数 主() -> 整32 {
    外 w;
    内 n = 内();
    n.值 = 42;
    w.值 = n;

    // 形态① 声明初始化·调用返回源——副本独立（修前共享：m1.值=7 写穿 w）
    内 m1 = w.取();
    m1.值 = 7;
    打印行(w.值.值);
    打印行(m1.取());

    // 形态② 赋值位·调用返回源——副本独立（修前共享：m2.值=8 写穿 w）
    内 m2 = 内();
    m2 = w.取();
    m2.值 = 8;
    打印行(w.值.值);
    打印行(m2.取());
    返回 0;
}
