// 〔1479/965 锁用例〕类返回对象拥有性甄别机制——实参位/语句位「调用返回类对象
// 临时」按拥有性谱系分流释放：拥有（返回局部/新建）=语句尾整壳析构；借用（返回
// 形参/全局·引用返回）=不释放（误释=删调用方对象）。修复前宿主实证：实参位
// 消费(仓1.造货架()) 每调用泄 1（活动分配数 1..8 线性）；语句位每语句泄 1。
// 修复后两侧同期望（宿主=甄别登记 DeleteObject 级联；v2 方法面=栈物化通道天然
// 净 0）。〔自由函数返回类面的 v2 侧泄漏=另案〕
导入 容器::向量;

类 货品 {
公开:
    向量<字符串> 记录;
    函数 货品() { 记录 = 向量<字符串>(); }
    函数 ~货品() { }
    不安全 函数 货品(货品& 其他) { 记录 = 其他.记录; }
}

// 借用形态（自由函数面）：返回形参=写穿别名——实参位临时禁释放
函数 还货(货品 源) -> 货品 {
    返回 源;
}

类 主仓 {
公开:
    // 拥有形态（方法面）：返回局部=句柄移交——实参位/语句位临时须释放
    函数 造货() -> 货品 {
        货品 p;
        结果<空类型, 整32> 加 = p.记录.追加("货品");
        如果 (!加.正常) { 返回 p; } 否则 { }
        返回 p;
    }
    // 借用形态（方法面）：返回形参
    函数 直通(货品 源) -> 货品 {
        返回 源;
    }
}

函数 消费(货品 按值) -> 整32 {
    返回 整32(按值.记录.大小());
}

函数 主() -> 整32 {
    主仓 仓1;
    整32 和 = 0;
    // ①方法面拥有（965 主形态）：4 轮每调分配后即释放 → 活动恒 0
    循环 (整32 i = 0; i < 4; i += 1) {
        和 += 消费(仓1.造货());
    }
    打印(内存::活动分配数());          // 0
    // ②自由函数借用（返回形参）：临时=调用方对象句柄不释放 → 对象完好
    货品 甲;
    结果<空类型, 整32> 加2 = 甲.记录.追加("甲串");
    如果 (!加2.正常) { 返回 1; } 否则 { }
    和 += 消费(还货(甲));
    打印(甲.记录.大小());              // 1（未被误释）
    // ③方法面借用：同②
    和 += 消费(仓1.直通(甲));
    打印(甲.记录.大小());              // 1
    // 退出码校验和（dual 双侧对照面）：活断言编码——任一形态行为漂移即非 0。
    // 〔活动分配数断言/打印不在本用例：借用面实参位 v2 泄 1（1538 族·宿主
    //   1479 已净）——宿主侧活动数曲线由 1514 锁（宿主专属用例）〕
    整32 码 = 0;
    如果 (甲.记录.大小() != 1) { 码 += 10; } 否则 { }
    如果 (和 != 6) { 码 += 1; } 否则 { }
    // ④声明位接收（880 判据不回归）：接收槽登记·出口回收
    货品 丙 = 仓1.造货();
    打印(丙.记录.大小());              // 1
    打印(和);                          // 4+1+1=6
    返回 码;
}
