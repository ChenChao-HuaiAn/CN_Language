// E2E 133_v2_限定名内置IO与文件（③ 自举对拍第五波，2026-09-03）
// 载体动因：v2 组件 IR签名.cn/主.cn 的 I/O 命脉 = 限定名内置 IO::打印到错误 +
//   文件::打开文件/读取文件行/写入文件/关闭文件/文件大小/文件存在（宿主
//   ir_call.cpp:217~235 映射 __cn_print_err/__cn_file_*；语义层限定名全局注册、
//   无需导入实现）。v2 语法层 :: 此前与 ./-> 同走成员分支——IO 崩成「未声明
//   标识符: IO」+ 成员方法标记误路由（「容器方法未收录」运行时错误 6）。
//   同轮补齐：真/假/无 字面量（词法关键字表已有、解析层零分支——谓词含 真/假
//   的源码必截断；无=空指针，宿主「指针只能与指针或空指针比较」边界实测锚定）。
//   裸内置契约：打开/读取文件行 返回裸指针（失败/EOF=无）——stdlib 包装层
//   结果<> 形态属模块导入链路（v2p 不链接 stdlib，为后续自举链路）。
// v2 本轮：语法 :: 合成限定名（标识符::标识符:( → 池尾原地改写）+ 真/假/无
//   复用整数字面量；语义 限定名经内置返回类型表自动放行（零改动）；IR 内置
//   双表扩 11 限定名 + 空类型返回跳过登记；代码生成零改动。
// 闭环：v2p 编译 -> ml64/link 宿主运行时（file_api/input_api .obj 提供实现）->
//   运行。退出码=0 全过；11~28 失败码。
函数 主() -> 整32 {
    // ===== 一、IO::打印到错误（stderr 诊断通道，v2 组件全量在用；拼接=from_int 链路）=====
    IO::打印到错误("[133] IO 通道就绪\n");
    IO::打印到错误("[133] 拼接: " + 整数转字符串(7 + 8) + "\n");

    // ===== 二、文件写入→关闭（写入文件 返回写入字节数；\n 词法实时反转义）=====
    字符串 路径 = "target/audit2/133_io_probe.txt";
    空类型* 写句柄 = 文件::打开文件(路径, 2);   // 模式 2=写（截断）
    如果 (写句柄 == 无) { 返回 11; }
    整64 写入数量 = 文件::写入文件(写句柄, "甲乙丙\n丁戊\n");
    如果 (写入数量 != 17) { 返回 12; }          // UTF-8：5 汉字*3 + 换行*2 = 17
    文件::关闭文件(写句柄);

    // ===== 三、逐行读取（读取文件行=IR签名.cn:67 同款核心形态；EOF=无 判空）=====
    空类型* 句柄 = 文件::打开文件(路径, 1);     // 模式 1=读
    如果 (句柄 == 无) { 返回 13; }
    字符串 行1 = 文件::读取文件行(句柄);
    如果 (行1 == 无) { 返回 14; }
    如果 (!字符串比较(行1, "甲乙丙\n")) { 返回 15; }   // 内容比较（v2 二元==是指针语义）
    字符串 行2 = 文件::读取文件行(句柄);
    如果 (行2 == 无) { 返回 16; }
    如果 (!字符串比较(行2, "丁戊\n")) { 返回 17; }
    字符串 行3 = 文件::读取文件行(句柄);
    如果 (行3 != 无) { 返回 18; }               // EOF 须为 无
    整64 大小 = 文件::文件大小(句柄);
    如果 (大小 != 17) { 返回 19; }
    文件::关闭文件(句柄);

    // ===== 四、文件存在 / 打开不存在（负路径）=====
    如果 (!文件::文件存在(路径)) { 返回 20; }
    如果 (文件::文件存在("target/audit2/133_不存在.txt")) { 返回 21; }
    空类型* 坏句柄 = 文件::打开文件("target/audit2/133_不存在.txt", 1);
    如果 (坏句柄 != 无) { 返回 22; }

    // ===== 五、追加模式（3）+ 再读回验证 =====
    空类型* 追加句柄 = 文件::打开文件(路径, 3);
    如果 (追加句柄 == 无) { 返回 23; }
    整64 追加数量 = 文件::写入文件(追加句柄, "己\n");
    如果 (追加数量 != 4) { 返回 24; }          // 己(3)+\n(1);
    文件::关闭文件(追加句柄);
    空类型* 再读句柄 = 文件::打开文件(路径, 1);
    如果 (再读句柄 == 无) { 返回 25; }
    字符串 追加行 = 文件::读取文件行(再读句柄);
    如果 (追加行 == 无 || !字符串比较(追加行, "甲乙丙\n")) { 返回 26; }
    文件::关闭文件(再读句柄);

    // ===== 六、真/假/无 字面量回归锚点（谓词形态——词法分析.cn 冒烟必经路径）=====
    布尔 标志 = 真;
    如果 (!标志) { 返回 27; }
    如果 (假) { 返回 28; }

    // 运行时人眼审计锚点（stdout；expected 子串匹配在 v2p 自检侧）
    打印("[133] 限定名IO文件: 全部通过");
    返回 0;
}
