// E2E 1083（#905 领号·双编译对照）：内置串产物实参临时释放——返回字符串的
//   内置调用产物作为实参/消费位时的临时句柄收口·双侧零分叉守护。
//   背景（905 定责轮·644-c 判定面同族根治）：返回字符串内置的登记/结算判定
//   原为硬编码白名单（644 段 8 项/617 面 14 项），漏 X转字符串族/格式化/
//   字符串构建器::完成/IO::读取行/文件::读取文件行/时间::格式化时间；且
//   「打印与内置调用」路径对非只读消费族内置（构建器::追加等）的实参无
//   flush 出口=644 哨兵死表项。三处修复=v2 判定统一走 内置函数返回类型ID
//   权威表 + 打印与内置路径补 清理调用实参临时（宿主 genArgValueWithCleanup/
//   flushPendingArgCleanups 全内置族同判）。
//   七形态（每形态 残留==0 且内容正确·任一泄漏/分叉即红）：
//     ①声明面构造 盒(0, 整数转字符串(42))
//     ②赋值面 甲 = 乙 + 丙（全内置造串·3 构造收口）
//     ③入容器位 A2 接管 追加(整数转字符串(42))（防双释放/UAF）
//     ④X转字符串族四转（整数/浮点/布尔/正数）
//     ⑤字段写入面 甲.名 = 整数转字符串(99)
//     ⑥只读消费族 字符串长度(整数转字符串(7))
//     ⑦构建器::完成×打印行 + 追加实参副本（非只读族 flush 面）
//   判据：宿主与 v2 输出逐行一致（断言输出=是）。
导入 容器::向量;
类 盒 {
公开:
    整32 值;
    字符串 名;
    函数 盒(整32 v, 字符串 n) { 值 = v; 名 = n; }
    函数 ~盒() { }
    不安全 函数 盒(盒& 其他) { 值 = 其他.值; 名 = 字符串复制(其他.名); }
    函数 运算符+(盒 右) -> 盒 {
        返回 盒(值 + 右.值, 字符串复制(名));
    }
}
函数 主() -> 整32 {
    // 形态A：声明面构造 盒(0, 整数转字符串(42))
    整64 bA = 内存::活动分配数();
    整64 名A = 0;
    {
        盒 甲 = 盒(0, 整数转字符串(42));
        名A = 字符串长度(甲.名);
    }
    打印(名A);
    打印(内存::活动分配数() - bA);
    // 形态B：赋值面 甲 = 乙 + 丙（12/20/30 造串）
    整64 bB = 内存::活动分配数();
    整32 值B = 0;
    {
        盒 乙 = 盒(12, 整数转字符串(120));
        盒 丙 = 盒(8, 整数转字符串(80));
        盒 甲 = 盒(0, 整数转字符串(0));
        甲 = 乙 + 丙;
        值B = 甲.值;
    }
    打印(值B);
    打印(内存::活动分配数() - bB);
    // 形态C：入容器位 A2 接管 追加(整数转字符串(42))
    整64 bC = 内存::活动分配数();
    整64 大小C = 0;
    {
        向量<字符串> 记录 = 向量<字符串>();
        结果<空类型, 整32> rC = 记录.追加(整数转字符串(42));
        大小C = 记录.大小();
        大小C = 大小C + 字符串长度(记录.元素(0));
    }
    打印(大小C);
    打印(内存::活动分配数() - bC);
    // 形态D：X转字符串族覆盖（整数/浮点/布尔/正数 四转）
    整64 bD = 内存::活动分配数();
    整64 名D = 0;
    {
        盒 甲 = 盒(0, 整数转字符串(1));
        盒 乙 = 盒(0, 浮点转字符串(1.5));
        盒 丙 = 盒(0, 布尔转字符串(真));
        盒 丁 = 盒(0, 正数转字符串(5));
        名D = 字符串长度(甲.名) + 字符串长度(乙.名) + 字符串长度(丙.名) + 字符串长度(丁.名);
    }
    打印(名D);
    打印(内存::活动分配数() - bD);
    // 形态E：字段写入面 甲.名 = 整数转字符串(99)
    整64 bE = 内存::活动分配数();
    整64 名E = 0;
    {
        盒 甲 = 盒(0, 字符串复制("x"));
        甲.名 = 整数转字符串(99);
        名E = 字符串长度(甲.名);
    }
    打印(名E);
    打印(内存::活动分配数() - bE);
    // 形态F：只读消费族（617 结算面）字符串长度(整数转字符串(7))
    整64 bF = 内存::活动分配数();
    整64 长F = 0;
    {
        长F = 字符串长度(整数转字符串(7));
    }
    打印(长F);
    打印(内存::活动分配数() - bF);
    // 形态G：617 只读消费族 × 构建器::完成 打印行(字符串构建器::完成(乙))
    整64 bG = 内存::活动分配数();
    {
        整64 乙 = 字符串构建器::新建();
        字符串构建器::追加(乙, 字符串复制("ab"));
        打印行(字符串构建器::完成(乙));
    }
    打印(内存::活动分配数() - bG);
    返回 0;
}
