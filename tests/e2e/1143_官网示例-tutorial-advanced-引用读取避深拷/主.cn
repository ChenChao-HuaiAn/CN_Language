//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
导入 容器::向量;

函数 主() -> 整32 {
    向量<整64> 表 = 向量<整64>();
    循环 (整64 i = 0; i < 100; i++) { 结果<空类型, 整32> 加 = 表.追加(i); }
    整64 和 = 0;
    循环 (整64 i = 0; i < 100; i++) {
        和 = 和 + 表.元素(i);          // 副本读取（标量无拷贝负担）
    }
    表.元素引用(0) = 999;              // 引用写穿（不安全域·零拷贝）
    打印(和, " ", 表.元素(0));
    返回 0;
}