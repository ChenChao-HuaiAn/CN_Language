// 官网文档示例 · tutorial-oop.html · 构造析构（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
类 日志 {
私有:
    字符串 名字;
公开:
    函数 日志(字符串 名) {
        名字 = 名;
        打印("[开] ", 名字);
    }

    函数 ~日志() {          // 析构：作用域结束自动调用
        打印("[关] ", 名字);
    }

    函数 写(字符串 消息) {
        打印("[写] ", 消息);
    }
}

函数 主() -> 整32 {
    日志 l = 日志("主日志");
    l.写("程序运行中");
    返回 0;                 // l 的析构在这里自动触发
}