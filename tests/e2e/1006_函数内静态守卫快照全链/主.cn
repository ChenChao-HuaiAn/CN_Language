// 1006（852 正例 dual·2026-10-16）：函数内静态初值引用局部名——守卫快照初始化双侧全链。
// 病（843 呈报·852 根治）：①静态标量=局部名 v2 语义「未声明标识符」误拒（宿主绿 42）
//   ②静态数组=局部数组 宿主走标量通道 Cast 截断基址只写 4 字节（乙[0]=地址低位·余垃圾）、
//   v2 函数内静态数组下标读「下标对象须为字符串或指针」全拒。
// 语义=001 §5.2a + 665 先例：首调经过声明点快照初始化（guard 一次性）·再调不重初始化。
//   计次=665 既有面回归锚（静态写 不安全 执法 480·声明初值非写不受限·998 同）。
不安全 函数 计次() -> 整32 {
    静态 整32 次 = 0;
    次 = 次 + 1;
    返回 次;
}
函数 标量快照(整32 轮) -> 整32 {
    整32 源 = 轮 * 10;
    静态 整32 甲 = 源;
    返回 甲;
}
函数 数组快照(整32 轮) -> 整32 {
    整32[3] 源;
    源[0] = 轮;
    源[1] = 轮 + 1;
    源[2] = 轮 + 2;
    静态 整32[3] 乙 = 源;
    返回 乙[0] * 100 + 乙[1] * 10 + 乙[2];
}
函数 主() -> 整32 {
    打印行(计次());
    打印行(计次());
    打印行(计次());
    打印行(标量快照(1));
    打印行(标量快照(2));
    打印行(标量快照(3));
    打印行(数组快照(1));
    打印行(数组快照(5));
    打印行(数组快照(9));
    返回 0;
}
