// 数学库 E2E（Task 6.3，规格书10.5 数学库）
// 覆盖：8 个数学库内置函数（数学::平方根/幂/正弦/余弦/正切/绝对值/向上取整/向下取整）
//   ——内置函数全局注册（无需导入即可调用），由编译器 IR 层映射到运行时
//   __cn_sqrt/__cn_pow/__cn_sin/__cn_cos/__cn_tan/__cn_fabs/__cn_ceil/__cn_floor
// 验证值：
//   平方根(9.0)=3.0、幂(2.0,3.0)=8.0、正弦(0)=0、余弦(0)=1、
//   正切(0)=0、绝对值(-5.5)=5.5、向上取整(3.2)=4.0、向下取整(3.8)=3.0
// 打印浮点默认 %f 6 位小数（expected 文件按此匹配）
// 说明：stdlib/数学.cn 为 CN 层标准库模块（公开同名函数封装）；本 E2E 直接验证
//   内置函数端到端（避免模块函数体内 数学::xxx 与内置限定名递归冲突——
//   模块函数与同名内置共存时以用户模块函数优先，见 stdlib/数学.cn 头注释）

函数 主() -> 整32 {
    打印("===== 数学库（Task 6.3）=====")

    // ---- 1. 平方根 ----
    浮64 根1 = 数学::平方根(9.0)
    打印("平方根(9.0): ", 根1)          // 3.000000

    // ---- 2. 幂 ----
    浮64 幂1 = 数学::幂(2.0, 3.0)
    打印("幂(2.0,3.0): ", 幂1)          // 8.000000

    // ---- 3. 三角函数（弧度制）----
    浮64 正弦0 = 数学::正弦(0.0)
    打印("正弦(0): ", 正弦0)            // 0.000000

    浮64 余弦0 = 数学::余弦(0.0)
    打印("余弦(0): ", 余弦0)            // 1.000000

    浮64 正切0 = 数学::正切(0.0)
    打印("正切(0): ", 正切0)            // 0.000000

    // ---- 4. 绝对值 ----
    浮64 绝对值1 = 数学::绝对值(-5.5)
    打印("绝对值(-5.5): ", 绝对值1)    // 5.500000

    // ---- 5. 向上取整 / 向下取整 ----
    浮64 上取整 = 数学::向上取整(3.2)
    打印("向上取整(3.2): ", 上取整)    // 4.000000

    浮64 下取整 = 数学::向下取整(3.8)
    打印("向下取整(3.8): ", 下取整)    // 3.000000

    // ---- 6. 组合运算（链式调用）----
    浮64 组合 = 数学::平方根(数学::幂(3.0, 2.0))
    打印("平方根(幂(3,2)): ", 组合)    // 3.000000

    浮64 绝对组合 = 数学::绝对值(数学::向下取整(-3.2))
    打印("绝对值(向下取整(-3.2)): ", 绝对组合)  // 4.000000

    打印("===== 数学库测试完成 =====")
    返回 0
}
