// E2E 719（双编译对照，438 销项·423 族 284 形态④⑤遗留泄漏面）：类字段容器
//   赋值/复制声明位的「在册回收」——四形态 块出口残留==0 + 内容正确 折校验和：
//     ①直拷贝构造声明位（货架 乙 = 甲：拷贝构造 this=新壳·源保持拥有）…位1
//     ②复制内置声明位 LUE 态（乙 = 复制(甲)·源后向无读=move 接管零拷贝）…位2
//     ③复制内置声明位 非 LUE 态（源后向有读=独立深拷·源照常拥有）………位4
//     ④赋值步（乙 = 甲：已声明对象整体赋值·旧值 preFree+深拷）…………位8
//   修前面（438 探针矩阵实证·宿主全净 0/v2 复制声明位残留 +2）：发射类拷贝
//   构造初始化把右值 复制(…) 的堆句柄产物当源再 NewObject+拷贝构造深拷——
//   LUE 态源槽已清零（所有权移交）→ 源原壳/字段容器/元素成孤儿（块出口仅
//   回收深拷一方·活分配数 +2=原数据数组+原字符串）；非 LUE 态=双重深拷+
//   临时壳孤儿。修后（生成类尾）：右值=复制(…) → 句柄接管直存（LUE 态=
//   move 接管宿主对齐·非 LUE 态消双重拷贝），四形态双侧净 0。
//   断言口径（283 同款「门禁替你记得」）：每形态 块出口后 内存::活动分配数()
//   差值==0 且内容正确 → 校验和 15=①1+②2+③4+④8；宿主/v2 双侧同源同值。
导入 容器::向量;
类 货架 {
公开:
    向量<字符串> 记录;
    函数 货架() { 记录 = 向量<字符串>(); }
    函数 ~货架() { }
    不安全 函数 货架(货架& 其他) { 记录 = 其他.记录; }
}
函数 主() -> 整32 {
    整32 校验 = 0;
    // ① 直拷贝构造声明位（拷贝构造体内 字段容器赋值=深拷·块出口各回各家）
    整64 b1 = 内存::活动分配数();
    整64 内1 = 0;
    {
        货架 甲;
        结果<空类型, 整32> r1 = 甲.记录.追加(字符串复制("甲一"));
        货架 乙 = 甲;
        内1 = 乙.记录.大小();
    }
    如果 (内1 == 1 && 内存::活动分配数() - b1 == 0) { 校验 = 校验 + 1; }
    // ② 复制内置声明位 LUE 态（源后向无读→句柄接管·零拷贝零残留）
    整64 b2 = 内存::活动分配数();
    整64 内2 = 0;
    {
        货架 甲;
        结果<空类型, 整32> r2 = 甲.记录.追加(字符串复制("甲二"));
        货架 乙 = 复制(甲);
        内2 = 乙.记录.大小();
    }
    如果 (内2 == 1 && 内存::活动分配数() - b2 == 0) { 校验 = 校验 + 2; }
    // ③ 复制内置声明位 非 LUE 态（源后向有读→独立深拷·源乙皆净）
    整64 b3 = 内存::活动分配数();
    整64 内3 = 0;
    整64 内3源 = 0;
    {
        货架 甲;
        结果<空类型, 整32> r3 = 甲.记录.追加(字符串复制("甲三"));
        货架 乙 = 复制(甲);
        内3 = 乙.记录.大小();
        内3源 = 甲.记录.大小();
    }
    如果 (内3 == 1 && 内3源 == 1 && 内存::活动分配数() - b3 == 0) { 校验 = 校验 + 4; }
    // ④ 赋值步（已声明对象整体赋值：旧值释放+深拷）
    整64 b4 = 内存::活动分配数();
    整64 内4 = 0;
    {
        货架 甲;
        结果<空类型, 整32> r4 = 甲.记录.追加(字符串复制("甲四"));
        货架 乙;
        乙 = 甲;
        内4 = 乙.记录.大小();
    }
    如果 (内4 == 1 && 内存::活动分配数() - b4 == 0) { 校验 = 校验 + 8; }
    返回 校验;
}
