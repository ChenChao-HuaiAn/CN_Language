// E2E 1799（#1962 执法三·泛型克隆登记搬运锁面·修前红修后绿）：泛型类克隆体
//   （列持$字符串）体内调用节点（首引用 方法体 源.元素引用(0)）=新池索引——
//   克隆器遍 1 须同步搬运调用返回类型登记（返回文本经 替换实例类型文本
//   T→实参替换·基体模板期登记「T&」→克隆体「字符串&」）。搬运缺失=修后 IR
//   层 取调用返回文 纯查表查无 → 648 登记显形中止（rc≠0 红）。
//   修前伤害面同探针 1868：返回位 933（返回 项.元素引用(0);）两源 walk miss
//   容器内置方法 → 直传容器槽借用句柄 → 调用方按拥有结算 free 毁容器槽
//   （859 同款）→ 副 悬垂 → 断言 rc=1 红；修后查表命中 → 返回位深拷落堆 →
//   副 独立副本 → 源槽覆盖后内容稳定 → rc=3 绿。
// 校验位（全语义断言·宿主泛型类字段级联释放缺口〔编译警告点名〕致内存账位
//   两侧不可比——账面锁由 1868 非泛型形态承载）：位1=深拷独立（源槽覆盖后
//   副 原值）；位2=二次深拷（新槽 首引用 副本=新值·且 副 原值不受扰）。
导入 容器::向量;
泛型 <类型 T>
类 列持 {公开:
    向量<T> 项;
    函数 列持() {
    }
    不安全 函数 ~列持() {
    }
    函数 放(T v) -> 布尔 {
        结果<空类型, 整32> 追 = 项.追加(v);
        如果 追.正常 {
            返回 真;
        } 否则 {
            返回 假;
        }
    }
    函数 首引用() -> T& {
        返回 项.元素引用(0);
    }
}
函数 主() -> 整32 {
    整32 校验 = 0;
    布尔 独1 = 假;
    布尔 双拷2 = 假;
    {
        列持<字符串> 持;
        布尔 放甲 = 持.放("泛型克隆庚");
        字符串 副 = 持.首引用();
        布尔 覆盖 = 持.放("覆盖辛长串覆盖辛长串覆盖辛长串覆盖辛长串");
        独1 = 放甲 && 覆盖 && 字符串比较(副, "泛型克隆庚");
        字符串 副2 = 持.首引用();
        双拷2 = 字符串比较(副2, "泛型克隆庚") &&
               字符串比较(副, "泛型克隆庚");
    }
    如果 (独1) { 校验 = 校验 + 1; }
    如果 (双拷2) { 校验 = 校验 + 2; }
    打印("执法三克隆搬运绿");
    返回 校验;
}
