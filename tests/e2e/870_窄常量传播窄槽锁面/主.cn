// E2E 870（2026-10-13·任务 #545 锁面）：窄常量传播+窄槽载入组合面 win 发射健壮性——
//   777 病行（O1 复写传播 op1=-128 常量 → 发射 movsx eax,byte ptr -128 立即数
//   当内存地址 → ml64 A2070 汇编失败·505 回归面实锤）已被 500 守卫收口（op1
//   常量 mov 直载再运算）；#545 收口同族残面=Load 窄槽载入面（mem.cpp Load
//   i8/i16、u8/u16）补同款 isConstant 守卫（与 500 Store 面防御同理由：当前
//   replaceUses 白名单不涉 Load·防御未来 pass 演化）。
//   本用例锁三面：①整8/整16 下界负常量经复写传播进窄算术（守卫直载形态·
//   守卫回退即 ml64 拒=红）；②窄槽 Load→Store 中转回读（窄槽载入面）；③
//   整8 减下溢错误码 8 收尾（777 同构·锁守卫面运行语义不变）。
//   双编译对照：宿主与 v2 同源同测——输出逐行一致 + 退出码一致（1=溢出终止）。
函数 主() -> 整32 {
    // ① 整8 下界负常量传播面（777 同形态·域内运算对照）
    整8 c = -128;
    整8 d = c + 100;           // -28 整8 域内（op1=-128 常量传播触发面）
    打印("加=", 整32(d));
    // ② 整16 下界负常量传播面
    整16 e = -32768;
    整16 f = e + 1;            // -32767 整16 域内（op1=-32768 常量传播触发面）
    打印("16加=", 整32(f));
    // ③ 窄槽载入面：Load→Store 中转回读（#545 Load 守卫面）
    整8 m = d;
    打印("槽=", 整32(m));
    // ④ 整8 减下溢错误码 8 收尾（777 同构·守卫面运行语义不变）
    整8 下溢 = -128;
    整8 结 = 下溢 - 1;         // → 运行时错误(错误码8): 溢出错误 终止
    打印(整32(结));
    返回 0;
}
