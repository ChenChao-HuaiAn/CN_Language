// 1409（1137 第三轮审查 P0-2）：字符情况标签非 ASCII/转义码点——单测双端一致。
//   修复前 parser 取引号内首字节（'中'=0xE4=228），与 v2 码点语义（20013）及
//   IR 物化（charLiteralCodePoint 全解码）分叉——宿主不命中。
//   修复后：parser 字符分支统一调 charLiteralCodePoint（model 中立层单点·
//   转义/unicode 花括号/直书 UTF-8 全解码）——'中' 与 '\u{4E2D}' 码点均为
//   20013，两标签命中。
//   双编译对照（断言输出=是）：两侧同源码各编各跑，stdout 与退出码须一致。
函数 主() -> 整32 {
    字符 甲 = '中';
    选择(甲) {
        情况 '中':
            打印("①命中-中");
            中断;
        默认:
            打印("①未命中-中");
            返回 1;
    }
    选择(甲) {
        情况 '\u{4E2D}':
            打印("②命中-转义");
            中断;
        默认:
            打印("②未命中-转义");
            返回 2;
    }
    返回 0;
}
