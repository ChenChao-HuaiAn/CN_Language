// E2E 1675 浮32实参传浮64形参宽化四面（#1888 锁面·#1887 普通函数面同族后续）：
//   #1396 ③宽化通道决议层放行（实参段匹配级 浮32→浮64=级1）后，发射层四面
//   原缺数值转换=浮32 位模式直传浮64 形参槽（movss 4 字节装载·被调 movsd
//   全宽读位模式=垃圾≈0）。双侧同病（#1887 零分叉备案）双侧同修：
//   v2=函数实参浮码们 表登记+发射浮点实参宽化（方法/构造/基构造委托/接口/
//      方法引用闭包五挂点）+宽化函数指针浮点实参（fnptr/lambda 签名段判定）；
//   宿主=calibrateCallArgsByParams（widenI128Args 扩面改名·i128 定标+浮32
//      提升单一归属：方法三路径/构造/接口/lambda 闭包/基构造委托 P3-20）。
//   修前实锚（win-x64 双侧）：袋(3.5f)=0.000000 / t.置(1.5f)=0.000000 /
//   工具.三倍(2.0f)=0.000000 / 指(1.25f) 宿主 2.5 对 v2 0.000000（唯一
//   分叉面）/ 偶(2.5f)=0.000000 / 缩放(1.5f)=8.000002 错值 / 基(v)=0.000000。
//   锁用例=六形态真值断言（构造/实例方法/静态方法/函数指针/lambda/接口/基
//   构造委托——1.5 系真值不归零）+浮32 形参精确面回归锚（形参 浮32 不误提升）。
函数 加倍(浮64 x) -> 浮64 { 返回 x * 2; }
函数 单精(浮32 x) -> 浮64 { 返回 x * 1.0; }
类 袋 {
公开:
    浮64 值;
    函数 袋(浮64 v) { 值 = v; }
    函数 读() -> 浮64 { 返回 值; }
    函数 置(浮64 v) { 值 = v; }
}
类 工具 {
公开:
    静态 函数 三倍(浮64 x) -> 浮64 { 返回 x * 3; }
}
接口 可缩放 {
    虚拟 函数 缩放(浮64 比例) -> 浮64;
}
类 方形 : 可缩放 {
公开:
    浮64 边;
    函数 方形(浮64 b) { 边 = b; }
    重写 函数 缩放(浮64 比例) -> 浮64 { 返回 边 * 边 * 比例; }
}
类 基 {
公开:
    浮64 基值;
    函数 基(浮64 v) { 基值 = v; }
}
类 派 : 基 {
公开:
    函数 派(浮64 v) : 基(v) { }
    函数 读() -> 浮64 { 返回 基值; }
}
函数 主() -> 整32 {
    // ①构造面：浮32 字面量实参传浮64 构造形参（修前 0.000000）
    袋 t = 袋(3.5f);
    打印(t.读());
    // ②实例方法面：t.置(1.5f)（修前 0.000000）
    t.置(1.5f);
    打印(t.读());
    // ③静态方法面：工具.三倍(2.0f)（修前 0.000000）
    打印(工具.三倍(2.0f));
    // ④函数指针面：指(1.25f)（修前 v2 归零·宿主对=唯一分叉面）
    浮64(*指)(浮64) = 加倍;
    打印(指(1.25f));
    // ⑤lambda 面：偶(2.5f)（修前 0.000000）
    变量 偶 = [](浮64 甲) -> 浮64 { 返回 甲 * 2; };
    打印(偶(2.5f));
    // ⑥接口方法面：缩放(1.5f)（修前错值 8.000002）
    可缩放 s = 方形(2.0);
    打印(s.缩放(1.5f));
    // ⑦基类构造委托面：基(v) 列表浮32 实参（修前 0.000000）
    派 d = 派(1.5f);
    打印(d.读());
    // ⑧回归锚：形参 浮32 精确面不误提升（442 判据分派既有契约）
    打印(单精(1.5f));
    返回 0;
}
