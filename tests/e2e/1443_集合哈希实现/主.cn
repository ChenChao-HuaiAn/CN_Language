// E2E 1443 集合哈希实现（#1211·2026-10-21）：
//   stdlib/映射集合.cn 的 集合<T> 由线性表（包含 O(n) 扫描）改为哈希桶+链
//   （与 映射<K,V> 同构·复用 散列桶序号 单一散列实现）——平均 O(1) 增删查。
// 覆盖：幂等添加 / 负数键 / 大键（整64 极值）/ 20000 键扩容重哈希 + 删除后查询 /
//   清空复用 / 整32（4 字节槽路径）/ 浮64 / 结构体（槽字节位模式·>8 字节 FNV 折叠）/
//   字符串键（句柄身份边界）/ 复杂度断言（80000 次操作 < 1000ms——线性表 O(n²)
//   同负载为秒级，哈希 O(1) 为毫秒级）。
// 键判据=元素槽字节（散列与相等同源）：整数=值、结构体=槽字节全等、字符串=句柄身份
//   （内容键映射请用 字符串映射<V>·见 770_字符串键映射）。两侧（宿主+v2）同源断言。
导入 映射集合::集合;
导入 时间;

结构体 点 {
    整64 横;
    整64 纵;
}

函数 主() -> 整32 {
    打印("===== 集合哈希实现（#1211）=====");

    // ==================== 一、基本语义：幂等/负数键/大键 ====================
    集合<整64> 表 = 集合<整64>();
    结果<空类型, 整32> 设 = 表.添加(7);
    如果 (!设.正常) { 打印("添加失败"); 返回 1; }
    设 = 表.添加(7);                       // 幂等：重复添加不增员
    如果 (!设.正常) { 打印("幂等添加失败"); 返回 1; }
    打印("幂等后大小: ", 表.大小());
    设 = 表.添加(-5);
    如果 (!设.正常) { 打印("负数键添加失败"); 返回 1; }
    设 = 表.添加(-9223372036854775807);
    设 = 表.添加(9223372036854775807);
    如果 (表.包含(-5) && 表.包含(-9223372036854775807) &&
        表.包含(9223372036854775807)) {
        打印("负数/大键包含: 真");
    } 否则 {
        打印("负数/大键包含: 假");
    }
    布尔 删负 = 表.删除(-5);
    如果 (删负 && !表.包含(-5)) {
        打印("负数键删除: 真");
    } 否则 {
        打印("负数键删除: 假");
    }
    布尔 删无 = 表.删除(-999);             // 不存在→假（语义与哈希化前一致）
    如果 (!删无) {
        打印("删除不存在: 假");
    } 否则 {
        打印("删除不存在: 真");
    }
    打印("基本要素后大小: ", 表.大小());

    // ==================== 二、20000 键：扩容重哈希 + 删除后查询 + 复杂度 ====================
    集合<整64> 大 = 集合<整64>();
    整64 起 = 时间::单调时钟毫秒();
    整64 i = 0;
    当 (i < 20000) {
        结果<空类型, 整32> 加 = 大.添加(i);
        如果 (!加.正常) {
            打印("大集合添加失败: ", i);
            返回 1;
        }
        i++;
    }
    打印("扩容后大小: ", 大.大小());
    整64 命中 = 0;
    i = 0;
    当 (i < 20000) {
        如果 (大.包含(i)) {
            命中++;
        }
        i++;
    }
    整64 漏中 = 0;                          // 不存在的键（i+20000）应全部未命中
    i = 0;
    当 (i < 20000) {
        如果 (大.包含(i + 20000)) {
            漏中++;
        }
        i++;
    }
    整64 删成 = 0;
    i = 0;
    当 (i < 20000) {
        如果 (大.删除(i)) {
            删成++;
        }
        i++;
    }
    整64 止 = 时间::单调时钟毫秒();
    打印("命中=", 命中, " 漏中=", 漏中, " 删除=", 删成);
    打印("删空后大小: ", 大.大小());

    // 删除后重新添加（交换删除后的链完整性）
    结果<空类型, 整32> 重加 = 大.添加(19999);
    如果 (重加.正常 && 大.包含(19999) && !大.包含(19998) && 大.大小() == 1) {
        打印("删后重加: 真");
    } 否则 {
        打印("删后重加: 假");
    }
    大.清空();
    如果 (大.为空() && !大.包含(19999)) {
        打印("清空后: 真");
    } 否则 {
        打印("清空后: 假");
    }
    结果<空类型, 整32> 清后加 = 大.添加(42);   // 清空后桶链复用
    如果 (清后加.正常 && 大.包含(42) && 大.大小() == 1) {
        打印("清空后复用: 真");
    } 否则 {
        打印("清空后复用: 假");
    }
    // 复杂度断言：80000 次操作（增/命中查/漏检查/删）< 1000ms
    //   线性表同负载 O(n²)=秒级；哈希平均 O(1)=毫秒级（阈值防 CI 抖动）
    如果 (止 - 起 < 1000) {
        打印("复杂度: 通过");
    } 否则 {
        打印("复杂度: 失败");
    }

    // ==================== 三、整32（4 字节槽组装路径） ====================
    集合<整32> 小 = 集合<整32>();
    结果<空类型, 整32> 小加 = 小.添加(12345);
    如果 (!小加.正常) { 打印("整32添加失败"); 返回 1; }
    小加 = 小.添加(-12345);
    如果 (小.包含(12345) && 小.包含(-12345) && 小.大小() == 2) {
        打印("整32键: 真");
    } 否则 {
        打印("整32键: 假");
    }
    布尔 小删 = 小.删除(12345);
    如果 (小删 && !小.包含(12345) && 小.包含(-12345)) {
        打印("整32删除: 真");
    } 否则 {
        打印("整32删除: 假");
    }

    // ==================== 四、浮64（8 字节槽路径·常规值） ====================
    集合<浮64> 浮集 = 集合<浮64>();
    结果<空类型, 整32> 浮加 = 浮集.添加(1.5);
    如果 (!浮加.正常) { 打印("浮64添加失败"); 返回 1; }
    浮加 = 浮集.添加(-2.25);
    如果 (浮集.包含(1.5) && 浮集.包含(-2.25) && !浮集.包含(3.0)) {
        打印("浮64键: 真");
    } 否则 {
        打印("浮64键: 假");
    }
    布尔 浮删 = 浮集.删除(1.5);
    如果 (浮删 && !浮集.包含(1.5)) {
        打印("浮64删除: 真");
    } 否则 {
        打印("浮64删除: 假");
    }

    // ==================== 五、结构体（>8 字节·槽字节全等·删除交换链） ====================
    集合<点> 点集 = 集合<点>();
    点 甲 = 点{ 横 = 3, 纵 = 4 };
    点 乙 = 点{ 横 = 3, 纵 = 4 };
    点 丙 = 点{ 横 = 3, 纵 = 5 };
    结果<空类型, 整32> 点加甲 = 点集.添加(甲);
    如果 (!点加甲.正常) { 打印("结构体添加失败"); 返回 1; }
    如果 (点集.包含(乙)) {
        打印("结构体同值包含: 真");
    } 否则 {
        打印("结构体同值包含: 假");
    }
    如果 (!点集.包含(丙)) {
        打印("结构体异值不包含: 真");
    } 否则 {
        打印("结构体异值不包含: 假");
    }
    结果<空类型, 整32> 点加乙 = 点集.添加(乙);   // 同值幂等
    如果 (点加乙.正常 && 点集.大小() == 1) {
        打印("结构体幂等大小: 1");
    } 否则 {
        打印("结构体幂等大小: 非1");
    }
    结果<空类型, 整32> 点加丙 = 点集.添加(丙);
    如果 (点加丙.正常 && 点集.大小() == 2) {
        打印("结构体异值加入: 2");
    } 否则 {
        打印("结构体异值加入: 非2");
    }
    布尔 点删 = 点集.删除(甲);
    如果 (点删 && !点集.包含(乙) && 点集.包含(丙) && 点集.大小() == 1) {
        打印("结构体删除交换: 真");
    } 否则 {
        打印("结构体删除交换: 假");
    }

    // ==================== 六、字符串键（句柄身份边界） ====================
    //   集合<字符串> 的键判据=元素槽 8 字节位模式（句柄身份）；借用来源入容器
    //   按所有权模型归一化复制 → 调用方原句柄不等于容器内副本（哈希化前后
    //   一致的现状语义）。内容相等键请用 字符串映射<V>（FNV-1a 逐字节+字符串比较）。
    字符串 串甲 = 字符串复制("集合字符串键甲乙丙");
    集合<字符串> 串集 = 集合<字符串>();
    结果<空类型, 整32> 串加 = 串集.添加(串甲);
    如果 (串加.正常 && 串集.大小() == 1) {
        打印("字符串键添加: 1");
    } 否则 {
        打印("字符串键添加: 非1");
    }
    布尔 串删 = 串集.删除(串甲);          // 身份不匹配 → 假（与哈希化前一致）
    如果 (!串删) {
        打印("字符串键删除: 假");
    } 否则 {
        打印("字符串键删除: 真");
    }
    串集.清空();
    如果 (串集.为空()) {
        打印("字符串键清空: 真");
    } 否则 {
        打印("字符串键清空: 假");
    }

    打印("===== 集合哈希实现测试完成 =====");
    返回 0;
}
