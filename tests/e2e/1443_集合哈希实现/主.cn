// E2E 1443 集合哈希实现（#1211·2026-10-21）：
//   stdlib/映射集合.cn 的 集合<T> 由线性表（包含 O(n) 扫描）改为哈希桶+链
//   （与 映射<K,V> 同构·复用 散列桶序号 单一散列实现）——平均 O(1) 增删查。
// 覆盖：幂等添加 / 负数键 / 大键（整64 极值 + MIN）/ 20000 键扩容重哈希 + 删除后
//   查询 / 清空复用 / 惰性构造 / 732 零初始化全局添加 / 整8/整16/整32/布尔 /
//   浮64 常规值与 ±0/NaN 位模式 / padded 结构体（含 padding 判等）/ 含串结构体 /
//   字符串键（堆串=拥有化副本，双侧一致；字面量仅锁双侧一致的首次添加——
//   二次添加/查询的宿主-v2 分叉见看板 #1328）/ 复杂度断言（80000 次操作 <1000ms）。
// 键判据=元素槽字节（散列与相等同源）：整数/布尔=值（集合<枚举> 宿主可用但 v2
//   类型大小(枚举) 在泛型实例内未知=双侧分叉，见报告；本用例不锁定）；结构体=槽字节全等
//   （含 padding，未初始化 padding 参与判等）；字符串=句柄身份（堆串入容器为拥有化
//   副本→原句柄不可反查；内容键用 字符串映射）；浮点 ±0/NaN=位模式（不等同于 ==）；
//   集合<字符> 当前不支持。宿主+v2 同源断言（双编译对照）。
导入 映射集合::集合;
导入 时间;

结构体 点 {
    整64 横;
    整64 纵;
}

// padded 结构体（>8 字节·padding 参与位模式判等）
结构体 窄点 {
    整8 甲;
    整64 乙;
}

结构体 中点 {
    整32 甲;
    整64 乙;
}

// 含拥有型串字段的结构体
结构体 盒 {
    字符串 名;
    整64 号;
}

// 732 零初始化全局集合（构造器未执行路径→添加 时惰性分配）
集合<整64> 全局集;

不安全 函数 主() -> 整32 {
    打印("===== 集合哈希实现（#1211）=====");

    // ==================== 一、基本语义：幂等/负数键/大键 ====================
    集合<整64> 表 = 集合<整64>();
    结果<空类型, 整32> 设 = 表.添加(7);
    如果 (!设.正常) { 打印("添加失败"); 返回 1; }
    设 = 表.添加(7);                       // 幂等：重复添加不增员
    如果 (!设.正常) { 打印("幂等添加失败"); 返回 1; }
    打印("幂等后大小: ", 表.大小());
    设 = 表.添加(-5);
    如果 (!设.正常) { 打印("负数键添加失败"); 返回 1; }
    设 = 表.添加(-9223372036854775807);
    设 = 表.添加(9223372036854775807);
    如果 (表.包含(-5) && 表.包含(-9223372036854775807) &&
        表.包含(9223372036854775807)) {
        打印("负数/大键包含: 真");
    } 否则 {
        打印("负数/大键包含: 假");
    }
    布尔 删负 = 表.删除(-5);
    如果 (删负 && !表.包含(-5)) {
        打印("负数键删除: 真");
    } 否则 {
        打印("负数键删除: 假");
    }
    布尔 删无 = 表.删除(-999);             // 不存在→假（语义与哈希化前一致）
    如果 (!删无) {
        打印("删除不存在: 假");
    } 否则 {
        打印("删除不存在: 真");
    }
    打印("基本要素后大小: ", 表.大小());

    // ==================== 二、20000 键：扩容重哈希 + 删除后查询 + 复杂度 ====================
    集合<整64> 大 = 集合<整64>();
    整64 起 = 时间::单调时钟毫秒();
    整64 i = 0;
    当 (i < 20000) {
        结果<空类型, 整32> 加 = 大.添加(i);
        如果 (!加.正常) {
            打印("大集合添加失败: ", i);
            返回 1;
        }
        i++;
    }
    打印("扩容后大小: ", 大.大小());
    整64 命中 = 0;
    i = 0;
    当 (i < 20000) {
        如果 (大.包含(i)) {
            命中++;
        }
        i++;
    }
    整64 漏中 = 0;                          // 不存在的键（i+20000）应全部未命中
    i = 0;
    当 (i < 20000) {
        如果 (大.包含(i + 20000)) {
            漏中++;
        }
        i++;
    }
    整64 删成 = 0;
    i = 0;
    当 (i < 20000) {
        如果 (大.删除(i)) {
            删成++;
        }
        i++;
    }
    整64 止 = 时间::单调时钟毫秒();
    打印("命中=", 命中, " 漏中=", 漏中, " 删除=", 删成);
    打印("删空后大小: ", 大.大小());

    // 删除后重新添加（交换删除后的链完整性）
    结果<空类型, 整32> 重加 = 大.添加(19999);
    如果 (重加.正常 && 大.包含(19999) && !大.包含(19998) && 大.大小() == 1) {
        打印("删后重加: 真");
    } 否则 {
        打印("删后重加: 假");
    }
    大.清空();
    如果 (大.为空() && !大.包含(19999)) {
        打印("清空后: 真");
    } 否则 {
        打印("清空后: 假");
    }
    结果<空类型, 整32> 清后加 = 大.添加(42);   // 清空后桶链复用
    如果 (清后加.正常 && 大.包含(42) && 大.大小() == 1) {
        打印("清空后复用: 真");
    } 否则 {
        打印("清空后复用: 假");
    }
    // 复杂度断言：80000 次操作（增/命中查/漏检查/删）< 1000ms
    //   线性表同负载 O(n²)=秒级；哈希平均 O(1)=毫秒级（阈值防 CI 抖动）
    如果 (止 - 起 < 1000) {
        打印("复杂度: 通过");
    } 否则 {
        打印("复杂度: 失败");
    }

    // ==================== 三、整32（4 字节槽组装路径） ====================
    集合<整32> 小 = 集合<整32>();
    结果<空类型, 整32> 小加 = 小.添加(12345);
    如果 (!小加.正常) { 打印("整32添加失败"); 返回 1; }
    小加 = 小.添加(-12345);
    如果 (小.包含(12345) && 小.包含(-12345) && 小.大小() == 2) {
        打印("整32键: 真");
    } 否则 {
        打印("整32键: 假");
    }
    布尔 小删 = 小.删除(12345);
    如果 (小删 && !小.包含(12345) && 小.包含(-12345)) {
        打印("整32删除: 真");
    } 否则 {
        打印("整32删除: 假");
    }

    // ==================== 四、浮64（8 字节槽路径·常规值） ====================
    集合<浮64> 浮集 = 集合<浮64>();
    结果<空类型, 整32> 浮加 = 浮集.添加(1.5);
    如果 (!浮加.正常) { 打印("浮64添加失败"); 返回 1; }
    浮加 = 浮集.添加(-2.25);
    如果 (浮集.包含(1.5) && 浮集.包含(-2.25) && !浮集.包含(3.0)) {
        打印("浮64键: 真");
    } 否则 {
        打印("浮64键: 假");
    }
    布尔 浮删 = 浮集.删除(1.5);
    如果 (浮删 && !浮集.包含(1.5)) {
        打印("浮64删除: 真");
    } 否则 {
        打印("浮64删除: 假");
    }

    // ==================== 五、结构体（>8 字节·槽字节全等·删除交换链） ====================
    集合<点> 点集 = 集合<点>();
    点 甲 = 点{ 横 = 3, 纵 = 4 };
    点 乙 = 点{ 横 = 3, 纵 = 4 };
    点 丙 = 点{ 横 = 3, 纵 = 5 };
    结果<空类型, 整32> 点加甲 = 点集.添加(甲);
    如果 (!点加甲.正常) { 打印("结构体添加失败"); 返回 1; }
    如果 (点集.包含(乙)) {
        打印("结构体同值包含: 真");
    } 否则 {
        打印("结构体同值包含: 假");
    }
    如果 (!点集.包含(丙)) {
        打印("结构体异值不包含: 真");
    } 否则 {
        打印("结构体异值不包含: 假");
    }
    结果<空类型, 整32> 点加乙 = 点集.添加(乙);   // 同值幂等
    如果 (点加乙.正常 && 点集.大小() == 1) {
        打印("结构体幂等大小: 1");
    } 否则 {
        打印("结构体幂等大小: 非1");
    }
    结果<空类型, 整32> 点加丙 = 点集.添加(丙);
    如果 (点加丙.正常 && 点集.大小() == 2) {
        打印("结构体异值加入: 2");
    } 否则 {
        打印("结构体异值加入: 非2");
    }
    布尔 点删 = 点集.删除(甲);
    如果 (点删 && !点集.包含(乙) && 点集.包含(丙) && 点集.大小() == 1) {
        打印("结构体删除交换: 真");
    } 否则 {
        打印("结构体删除交换: 假");
    }

    // ==================== 六、字符串键（句柄身份边界） ====================
    //   键判据=元素槽 8 字节位模式（句柄身份）：
    //   - 驻留字面量：句柄稳定 → 幂等添加/包含/删除均命中；
    //   - 堆串（字符串复制）：借用来源入容器按所有权模型归一化落堆为**拥有化副本**
    //     → 同一句柄二次添加视为两个元素、原句柄包含/删除均不命中（哈希化前后
    //     一致的现状语义；内容键请用 字符串映射<布尔>）。
    字符串 堆甲 = 字符串复制("堆串内容甲乙丙");
    集合<字符串> 堆集 = 集合<字符串>();
    结果<空类型, 整32> 堆加一 = 堆集.添加(堆甲);
    如果 (堆加一.正常 && 堆集.大小() == 1) {
        打印("堆串首次添加: 1");
    } 否则 {
        打印("堆串首次添加: 非1");
    }
    结果<空类型, 整32> 堆加二 = 堆集.添加(堆甲);
    如果 (堆加二.正常 && 堆集.大小() == 2) {
        打印("堆串二次添加: 2");
    } 否则 {
        打印("堆串二次添加: 非2");
    }
    如果 (!堆集.包含(堆甲)) {
        打印("堆串原句柄包含: 假");
    } 否则 {
        打印("堆串原句柄包含: 真");
    }
    布尔 堆删 = 堆集.删除(堆甲);
    如果 (!堆删) {
        打印("堆串原句柄删除: 假");
    } 否则 {
        打印("堆串原句柄删除: 真");
    }
    堆集.清空();
    如果 (堆集.为空()) {
        打印("堆串清空: 真");
    } 否则 {
        打印("堆串清空: 假");
    }
    //   驻留字面量：首次添加两侧一致（大小=1）；但二次添加/按字面量查询的宿主-v2
    //   行为分叉（宿主：驻留句柄稳定→幂等/命中；v2：字面量入容器副本化→不命中），
    //   属字符串归一化面的既有编译器分叉（非本任务引入）——双编译用例只锁定共同面，
    //   分叉已登记看板任务。
    集合<字符串> 字集 = 集合<字符串>();
    结果<空类型, 整32> 字加一 = 字集.添加("字面量串甲乙丙");
    如果 (字加一.正常 && 字集.大小() == 1) {
        打印("字面量首次添加: 1");
    } 否则 {
        打印("字面量首次添加: 非1");
    }

    // ==================== 七、padded 结构体（含 padding 位模式判等） ====================
    //   判等=槽字节全等（含 padding）：**逐字节副本**（结构体赋值）恒相等；
    //   独立字面量即使字段值相同，未初始化 padding 也可能不同——该不稳定面只记录
    //   不锁定（见类头/官网文档「含 padding」说明）。字段值不同→位模式必不同。
    集合<窄点> 窄集 = 集合<窄点>();
    窄点 窄甲 = 窄点{ 甲 = 整8(5), 乙 = 100 };
    窄点 窄乙 = 窄甲;                       // 整体拷贝（含 padding 逐字节一致）
    结果<空类型, 整32> 窄加甲 = 窄集.添加(窄甲);
    如果 (!窄加甲.正常) { 打印("窄点添加失败"); 返回 1; }
    如果 (窄集.包含(窄乙)) {
        打印("窄点副本包含: 真");
    } 否则 {
        打印("窄点副本包含: 假");
    }
    结果<空类型, 整32> 窄加乙 = 窄集.添加(窄乙);   // 位模式全等→幂等
    如果 (窄加乙.正常 && 窄集.大小() == 1) {
        打印("窄点副本幂等: 1");
    } 否则 {
        打印("窄点副本幂等: 非1");
    }
    窄点 窄丙 = 窄点{ 甲 = 整8(6), 乙 = 100 };     // 字段差→必不同
    如果 (!窄集.包含(窄丙)) {
        打印("窄点异值不包含: 真");
    } 否则 {
        打印("窄点异值不包含: 假");
    }
    结果<空类型, 整32> 窄加丙 = 窄集.添加(窄丙);
    如果 (窄加丙.正常 && 窄集.大小() == 2) {
        打印("窄点异值加入: 2");
    } 否则 {
        打印("窄点异值加入: 非2");
    }
    集合<中点> 中集 = 集合<中点>();
    中点 中甲 = 中点{ 甲 = 7, 乙 = 200 };
    中点 中乙 = 中甲;                       // 整体拷贝
    结果<空类型, 整32> 中加甲 = 中集.添加(中甲);
    如果 (!中加甲.正常) { 打印("中点添加失败"); 返回 1; }
    如果 (中集.包含(中乙)) {
        打印("中点副本包含: 真");
    } 否则 {
        打印("中点副本包含: 假");
    }
    结果<空类型, 整32> 中加乙 = 中集.添加(中乙);
    如果 (中加乙.正常 && 中集.大小() == 1) {
        打印("中点副本幂等: 1");
    } 否则 {
        打印("中点副本幂等: 非1");
    }
    中点 中丙 = 中点{ 甲 = 7, 乙 = 201 };
    如果 (!中集.包含(中丙)) {
        打印("中点异值不包含: 真");
    } 否则 {
        打印("中点异值不包含: 假");
    }
    结果<空类型, 整32> 中加丙 = 中集.添加(中丙);
    如果 (中加丙.正常 && 中集.大小() == 2) {
        打印("中点异值加入: 2");
    } 否则 {
        打印("中点异值加入: 非2");
    }
    // 含串结构体：入容器整结构体落堆（串字段拥有化副本）→ 同变量/同内容均不命中
    集合<盒> 盒集 = 集合<盒>();
    盒 盒甲 = 盒{ 名 = 字符串复制("盒内容甲乙丙"), 号 = 9 };
    盒 盒乙 = 盒{ 名 = 字符串复制("盒内容甲乙丙"), 号 = 9 };
    结果<空类型, 整32> 盒加 = 盒集.添加(盒甲);
    如果 (!盒加.正常) { 打印("盒添加失败"); 返回 1; }
    如果 (!盒集.包含(盒甲) && !盒集.包含(盒乙) && 盒集.大小() == 1) {
        打印("含串结构体身份: 真");
    } 否则 {
        打印("含串结构体身份: 假");
    }

    // ==================== 八、窄整/布尔/整64 MIN ====================
    集合<整8> 八集 = 集合<整8>();
    整8 八甲 = 整8(-5);
    整8 八乙 = 整8(-5);
    结果<空类型, 整32> 八加 = 八集.添加(八甲);
    如果 (八加.正常 && 八集.包含(八乙) && 八集.大小() == 1) {
        打印("整8键: 真");
    } 否则 {
        打印("整8键: 假");
    }
    集合<整16> 十六集 = 集合<整16>();
    整16 十六甲 = 整16(-300);
    结果<空类型, 整32> 十六加 = 十六集.添加(十六甲);
    如果 (十六加.正常 && 十六集.包含(整16(-300)) && 十六集.大小() == 1) {
        打印("整16键: 真");
    } 否则 {
        打印("整16键: 假");
    }
    集合<布尔> 布集 = 集合<布尔>();
    结果<空类型, 整32> 布加一 = 布集.添加(真);
    结果<空类型, 整32> 布加二 = 布集.添加(真);
    如果 (布加一.正常 && 布加二.正常 && 布集.包含(真) && !布集.包含(假) &&
        布集.大小() == 1) {
        打印("布尔键: 真");
    } 否则 {
        打印("布尔键: 假");
    }
    集合<整64> 极集 = 集合<整64>();
    整64 最小 = -9223372036854775807 - 1;
    结果<空类型, 整32> 极加 = 极集.添加(最小);
    如果 (极加.正常 && 极集.包含(最小) && 极集.大小() == 1) {
        打印("整64MIN键: 真");
    } 否则 {
        打印("整64MIN键: 假");
    }

    // ==================== 九、浮点 ±0/NaN（位模式判等·不等同于 ==） ====================
    集合<浮64> 零集 = 集合<浮64>();
    结果<空类型, 整32> 零加 = 零集.添加(0.0);
    如果 (零加.正常 && 零集.包含(0.0) && !零集.包含(-0.0) && 零集.大小() == 1) {
        打印("浮点±0位模式: 真");
    } 否则 {
        打印("浮点±0位模式: 假");
    }
    浮64 零 = 0.0;
    浮64 纳 = 零 / 零;
    集合<浮64> 纳集 = 集合<浮64>();
    结果<空类型, 整32> 纳加 = 纳集.添加(纳);
    浮64 纳二 = 零 / 零;
    如果 (纳加.正常 && 纳集.包含(纳二) && 纳集.大小() == 1) {
        打印("NaN同bit: 真");
    } 否则 {
        打印("NaN同bit: 假");
    }

    // ==================== 十、惰性构造 + 732 零初始化全局添加 ====================
    集合<整64> 惰集 = 集合<整64>();
    如果 (惰集.为空() && 惰集.大小() == 0 && !惰集.包含(1)) {
        打印("惰性构造查询: 真");
    } 否则 {
        打印("惰性构造查询: 假");
    }
    结果<空类型, 整32> 惰加 = 惰集.添加(1);
    如果 (惰加.正常 && 惰集.包含(1) && 惰集.大小() == 1) {
        打印("惰性构造后添加: 真");
    } 否则 {
        打印("惰性构造后添加: 假");
    }
    结果<空类型, 整32> 全局加 = 全局集.添加(321);
    如果 (全局加.正常 && 全局集.包含(321) && 全局集.大小() == 1) {
        打印("732零初始化添加: 真");
    } 否则 {
        打印("732零初始化添加: 假");
    }

    打印("===== 集合哈希实现测试完成 =====");
    返回 0;
}
