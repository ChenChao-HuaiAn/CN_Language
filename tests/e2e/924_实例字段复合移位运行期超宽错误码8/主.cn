// E2E 924（2026-10-14·任务 #584）：类实例字段运行期复合移位超宽（字段 <<= 变量k）→
//   错误码 8 确定性失败（001 §4.4 移位量超宽 #474 条文·§1.1a②）。
//   结构复核：类字段复合赋值两侧均展开「读旧值→移位→写回」，与变量面同移位
//   检查面（宿主 ir_oop_field.cpp:298 实例裸字段分支·178 静态分支同构）——
//   本用例把实例面从「结构巧合」升为「用例锁死」：
//   ①对象.字段形态 乙.值 <<= k5（memberGenericAssign 面）域内健康 → 32；
//   ②方法体内实例字段裸名形态 值 <<= k5（ir_oop_field.cpp:298 分支）健康 → 32；
//   ③②同形超宽触发 k=40（≥ 整32 位宽 32）→ 运行时错误(错误码8) 终止 rc=1。
//   （静态字段分支面=姊妹用例 925 锁死。）
//   双编译对照：宿主与 v2 同源同测——输出逐行一致 + 退出码一致（1=溢出终止）。
类 盒子 {
公开:
    整32 值;
    函数 盒子() { 值 = 1; }
    函数 实例移(整32 k) -> 空类型 {
        值 <<= k;              // 实例字段裸名复合移位（②③ 面）
    }
}
函数 主() -> 整32 {
    盒子 甲 = 盒子();
    整32 k5 = 5;
    甲.实例移(k5);
    打印(甲.值);               // 32 实例裸字段域内健康（健康对照）
    盒子 乙 = 盒子();
    乙.值 <<= k5;
    打印(乙.值);               // 32 对象.字段域内健康（健康对照）
    整32 大 = 40;
    甲.实例移(大);             // 40 ≥ 32 运行期复合移位量超宽 → 错误码8 终止
    打印(甲.值);
    返回 0;
}
