// E2E 92_单目运算符重载（P2-14）：类 运算符-（0 参数，单目负号）/ 运算符!（布尔取反）
// 语法依据（cn-language-spec 06-九）：函数 运算符X(参数) -> 类型（成员函数）；
//   单目运算符 0 个右参数（左操作数=this）。此前语义/IR 未映射单目（e2e 25 仅双目）。
类 温度 {
公开:
    整32 值;

    函数 温度(整32 v) {
        值 = v;
    }

    // 单目负号：返回相反温度对象
    函数 运算符-() -> 温度 {
        返回 温度(-值);
    }

    // 单目取反：返回"是否为零度"
    函数 运算符!() -> 布尔 {
        返回 值 == 0;
    }

    函数 显示() -> 字符串 {
        返回 整数转字符串(值);
    }
}

函数 主() -> 整32 {
    打印("===== 单目运算符重载（P2-14）=====");
    温度 正 = 温度(23);
    温度 负 = -正;
    打印("正: ", 正.显示());       // 23
    打印("-正: ", 负.显示());       // -23
    温度 零 = 温度(0);
    布尔 非零 = !零;
    布尔 非正 = !正;
    如果 (非零) { 打印("!零: 真"); } 否则 { 打印("!零: 假"); }
    如果 (非正) { 打印("!正: 真"); } 否则 { 打印("!正: 假"); }
    打印("===== 完成 =====");
    返回 0;
}
