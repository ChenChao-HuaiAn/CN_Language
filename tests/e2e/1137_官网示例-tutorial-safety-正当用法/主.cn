// 官网文档示例 · tutorial-safety.html · 借出视图（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
导入 容器::向量;

函数 主() -> 整32 {
    向量<字符串> 表 = 向量<字符串>();
    结果<空类型, 整32> 加 = 表.追加(字符串复制("快照"));
    如果 (!加.正常) { 返回 1; }
    字符串 借出 = 表.元素(0);
    打印(字符串比较(借出, "快照"));   // 消费在容器修改之前：合法
    结果<空类型, 整32> 增 = 表.追加(字符串复制("更多"));
    如果 (!增.正常) { 返回 1; }
    打印(字符串长度(借出));          // 追加=扩容：字符串句柄独立于容器槽，不失效
    返回 0;
}