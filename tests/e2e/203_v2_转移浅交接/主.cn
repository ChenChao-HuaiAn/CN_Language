// E2E 203_v2（v2 正路径闭环，2026-09-10 第六十一轮 plans/019 阶段3b）：
//   v2 放开容器声明位转移（豁免模型浅交接：调用特判=实参值压栈+按值 Store
//   =句柄拷贝+调用初值 RAII 豁免，零 IR 改动）。容器浅交接校验和：
//   转移前追加(10) → 转移 → 接管者追加(32) → 大小=2 +1 / 元素(0)=10 +2 /
//   元素(1)=32 +4 → 全对 rc=7。
导入 容器::向量;
函数 主() -> 整32 {
    向量<整64> 表 = 向量<整64>();
    结果<空类型, 整32> 加1 = 表.追加(10);
    向量<整64> 接 = 转移(表);
    结果<空类型, 整32> 加2 = 接.追加(32);
    整64 累计 = 0;
    如果 (接.大小() == 2) { 累计 = 累计 + 1; }
    如果 (接.元素(0) == 10) { 累计 = 累计 + 2; }
    如果 (接.元素(1) == 32) { 累计 = 累计 + 4; }
    返回 整32(累计);
}
