// E2E 1787（任务 2060·1104 对拍轨同族第三轮锁面·负测）：函数指针 vs 无 判空
//   直接比较=双侧同拒——宿主族⑤ isPointer 不含函数指针形态（探针 p2060 宿主
//   拒「指针只能与指针或空指针比较，实际为 '函数指针<整32>(整32,整32)' 与
//   '空类型*'」）·v2 修前静默放行=方向反分叉（宿主拒 v2 绿）；修后 v2 比较面
//   函数指针/可选判空收口（语义检查运算.cn 969 块后·2060/2061 判据）同拒同文
//   案。三形态：甲 != 无 / 甲 == 无 / 对称 无 != 甲（宿主对称文案左文本在前）。
//   函数指针判空正规通道=间接调用点判零防线（001 §空调用防线·判空比较非立法
//   语义）。函数指针同型互比放行面=q2060b 双侧绿（行为零变化·1778 族同覆盖）。
函数 加法(整32 a, 整32 b) -> 整32 {
    返回 a + b;
}

函数 主() -> 整32 {
    整32(*甲)(整32, 整32) = 加法;
    如果 (甲 != 无) { 打印(1); } 否则 { 打印(0); }
    如果 (甲 == 无) { 打印(1); } 否则 { 打印(0); }
    如果 (无 != 甲) { 打印(1); } 否则 { 打印(0); }
    返回 0;
}
