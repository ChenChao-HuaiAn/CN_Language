// E2E 1316_不安全函数指针差元素个数（1040 立法·正例 dual）：001 §5.3 清单 #1
//   扩充（2026-10-18 任务 1040 用户批甲）——不安全函数内同型指针差 `尾 - 首`
//   合法·结果=有符号整64「元素个数」=(地址差)/元素大小、尾在首前得负
//   （C ptrdiff 同款·宿主 genPointerArithmetic 双指针分支 / v2 步进糖同构）。
//   覆盖：整32* 双向差 + 函数返回位 + 整8* 步进 1 边界 + 结构体* 总大小步进。
//   期望 stdout：4 / -4 / 4 / 4 / 3。
不安全 函数 求长度(整32* 首, 整32* 尾) -> 整64 {
    返回 尾 - 首;
}
结构体 盒子 {
    整64 甲;
    整64 乙;
}
不安全 函数 主() -> 整32 {
    整32[5] 表 = {10, 20, 30, 40, 50};
    整32* 首 = &表[0];
    整32* 尾 = &表[4];
    打印(尾 - 首);
    打印(首 - 尾);
    打印(求长度(首, 尾));
    整8[5] 字节表 = {1, 2, 3, 4, 5};
    整8* b0 = &字节表[0];
    整8* b4 = &字节表[4];
    打印(b4 - b0);
    盒子[4] 盒表 = { 盒子{ 甲 = 1, 乙 = 1 }, 盒子{ 甲 = 2, 乙 = 2 },
                    盒子{ 甲 = 3, 乙 = 3 }, 盒子{ 甲 = 4, 乙 = 4 } };
    盒子* h0 = &盒表[0];
    盒子* h3 = &盒表[3];
    打印(h3 - h0);
    返回 0;
}
