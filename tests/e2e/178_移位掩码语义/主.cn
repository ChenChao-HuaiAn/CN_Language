// 178：移位掩码语义（2026-09-09 规范化，Rust release 掩码同构）——
//   移位量按操作数类型位宽取模（定义行为，规范01b§5.4）；编译期折叠与
//   运行期发射逐点一致（修复前：整32 运行期走 mod64 与折叠 mod32 分叉、
//   arm64 常量移位量>63 直接汇编报错）；右移有符号=算术/无符号=逻辑。
//   运行期移位量经 字符串长度 造不透明值，防常量折叠走捷径。
函数 主() -> 整32 {
    // 常量移位量溢出（编译期折叠）：1 << 64 ≡ 1 << 0
    整64 a = 1 << 64;
    打印(整数转字符串(a));
    // 整64 运行期移位量溢出：70 mod 64 = 6 -> 64
    整64 n = 字符串长度("1234567") * 10;
    整64 b = 1 << n;
    打印(整数转字符串(b));
    // 整32 运行期移位量溢出（折叠/发射一致性锚）：33 mod 32 = 1 -> 10
    整32 m = 整32(字符串长度("12345678") * 4) + 1;
    整32 c = 5 << m;
    打印(整数转字符串(c));
    // 右移有符号=算术，移位量取模：-16 >> 65 ≡ -16 >> 1 = -8
    整64 d = -16;
    打印(整数转字符串(d >> 65));
    // 右移无符号=逻辑：全一位模式 >> 60 = 15（若误走算术得 -1）
    整32 全一 = ~0;
    正64 大 = 正64(全一);
    打印(整数转字符串(整64(大 >> 60)));
    // 位复合赋值五形态（规范01b§5.5）
    整64 f = 6;
    f <<= 4;
    打印(整数转字符串(f));
    f >>= 2;
    打印(整数转字符串(f));
    f &= 0xFF;
    打印(整数转字符串(f));
    f |= 0x100;
    打印(整数转字符串(f));
    f ^= 0x0F;
    打印(整数转字符串(f));
    返回 0;
}
