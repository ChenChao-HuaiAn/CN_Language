// 官网文档示例 · tutorial-syntax.html · 枚举（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
枚举 颜色 { 红, 绿, 蓝, 自定义 = 100 }
枚举 方向 { 上 = -1, 中 = 0, 下 = 1 }

函数 主() -> 整32 {
    颜色 c = 颜色.蓝;
    方向 d = 方向.上;
    打印(c == 颜色.蓝, " ", 整32(d));   // 真 -1
    选择 (c) {
        情况 红: 打印("红"); 中断;
        情况 蓝: 打印("蓝"); 中断;   // 裸成员名
        默认: 打印("…");
    }
    返回 0;
}