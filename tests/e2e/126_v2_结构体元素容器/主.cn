导入 容器::向量

// E2E 126（v2 ②b 结构体元素容器，2026-09-02 立项——实现到绿时注册运行器）：
//   宿主侧参考形状 = E2E 124（向量<节点> 链式字段取值，方案A）。
//   v2 缺口（HANDOFF ②b，用户裁决一步到位含资源字段结构体）：
//   ① 结构体布局对齐宿主 typeSizeOf（字段按真实大小+自然对齐——节点
//     {整32 类型,整32 文本,整64 附加,整32 子起点,整32 子终点} 偏移 0/4/8/16/20、
//     大小 24 对齐 8；旧 v2 为 8 字节平铺=错误布局）；
//   ② 元素(i) 视图语义：结构体元素返地址（链式 池.元素(i).字段 读/写）；
//   ③ 结构体按值传参 ABI（追加(n)/设置(i,v) 实参深拷贝 rep movsb/字循环）；
//   ④ 深拷贝与析构注入：追加 结构体深拷贝、删除(i) 收缩、含字符串字段结构体
//     的 RAII（作用域退出整体析构）。
//   断言失败提前返回 201~220；全部通过 返回 0。
结构体 节点 {
    整32 类型
    整32 文本
    整64 附加
    整32 子起点
    整32 子终点
}

结构体 词条 {
    整64 编号
    字符串 名字
}

函数 主() -> 整32 {
    // —— ①②③：POD 结构体元素容器（E2E 124 形状）——
    向量<节点> 池 = 向量<节点>()
    整64 i = 0
    当 (i < 20) {
        节点 n
        n.类型 = 整32(i)
        n.文本 = 1
        n.附加 = i
        n.子起点 = 2
        n.子终点 = 3
        结果<空类型, 整32> 加 = 池.追加(n)
        如果 (!加.正常) { 返回 201 }
        i++
    }
    // 链式读：首字段（偏移0）、中字段（偏移8，整64）、末字段
    如果 (池.元素(19).类型 != 19) { 返回 202 }
    如果 (池.元素(19).附加 != 19) { 返回 203 }
    整64 和 = 池.元素(19).附加 + 池.元素(0).子终点
    如果 (和 != 22) { 返回 204 }
    // 设置(i, v) + 读回
    节点 新n
    新n.类型 = 5
    新n.文本 = 5
    新n.附加 = 5
    新n.子起点 = 5
    新n.子终点 = 5
    结果<空类型, 整32> 设 = 池.设置(0, 新n)
    如果 (!设.正常) { 返回 205 }
    如果 (池.元素(0).文本 != 5) { 返回 206 }
    如果 (池.大小() != 20) { 返回 207 }
    // —— ④：含字符串字段结构体（深拷贝 + RAII）——
    {
        向量<词条> 表 = 向量<词条>()
        词条 t1
        t1.编号 = 7
        t1.名字 = "甲"
        结果<空类型, 整32> 加词 = 表.追加(t1)
        如果 (!加词.正常) { 返回 208 }
        如果 (表.大小() != 1) { 返回 209 }
        如果 (表.元素(0).编号 != 7) { 返回 210 }
        // 作用域退出：表 与 t1 整体 RAII 析构（含字符串字段——泄漏零容忍验证）
    }
    // —— ④：删除(i) 中间位置（POD 收缩语义）——
    结果<空类型, 整32> 删 = 池.删除(10)
    如果 (!删.正常) { 返回 211 }
    如果 (池.大小() != 19) { 返回 212 }
    如果 (池.元素(10).类型 != 11) { 返回 213 }
    如果 (池.元素(18).类型 != 19) { 返回 214 }
    返回 0
}
