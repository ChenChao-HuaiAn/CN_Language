// E2E 242（2026-09-12 第八十五轮，plans/020 移植纪律 9 门禁化·第十三个对照用例）：
//   **聚合返回位所有权（借用来源返回）**——同一份源码经宿主真实管线与 v2 自举链
//   各编译运行，两侧退出码须相等。
//   背景（85-a，探针 P38/P40）：返回类型含拥有型串字段（结构体/结果/可选）而返回
//   表达式是**借用来源**（按值形参=调用方 place 的浅拷副本 / 成员链 / 下标 / 解引用
//   / 全局静态）时，原实现只做按位 memcpy → 返回值的串字段句柄与调用方实参 place
//   **共享**；调用方各接收位一律按 owned 处理（声明/赋值=浅拷接管、入容器=元素槽
//   独立），于是调用方释放其持有者后返回值字段悬垂（探针 P38 两侧打印乱码，
//   数据正确性/安全级）。修复=返回位深拷归一化（借用来源 → 独立副本落堆；
//   拥有局部/调用返回/字面量保持零拷贝）。Rust 对照：`-> T` 必须有所有权，
//   借用来源须 clone。
//   交叉验证手法：**跨块读取**（源 place 已退出作用域释放）+ 内存搅动覆盖已释放
//   内存 + 内容逐字节比较 + 残留归零断言——句柄共享时必然读到乱码/丢失校验位。
//   八形态（两侧共有语义面）：
//     ① 返回按值形参（实参=字面量临时，跨块读取）
//     ② 返回按值形参（实参=标识符局部，跨块读取）
//     ③ 返回形参的嵌套成员链（`箱.内盒`）
//     ④ 返回拥有局部的成员链（`局.内盒`）
//     ⑤ 返回指针解引用（`*p`；⑤ 基线段错误 rc=139 修复的回归锚）
//     ⑥ 返回拥有局部（move 对照：所有权移出，零拷贝）
//     ⑦ 返回结构体字面量（fresh 对照）+ 调用返回链（ownRet 对照）
//     ⑧ 循环 5 万轮（每轮返回形参 + 释放）+ 残留归零
//   校验和折位：①1 ②2 ③4 ④8 ⑤16 ⑥32 ⑦64 ⑧128 —— 255=全对。
//   两侧任一退回「按位 memcpy 直传借用来源」→ ①~⑤⑧ 位丢失 → 退出码变化 → 对照失败。
//   平台守卫=linux 双平台（宿主与 v2 同链；win-x64 v2 产物未隔离=家机轮）。
结构体 盒 {
    字符串 名;
    整32 号;
}

结构体 箱 {
    盒 内盒;
    整32 标记;
}

// 内存搅动：新分配覆盖「已释放内存」，使悬垂字段内容可观测损坏
函数 搅动() -> 整64 {
    整64 和 = 0;
    整64 i = 0;
    当 (i < 16) {
        字符串 垃圾 = 字符串复制("E242搅动内存填充占位字符串内容甲乙丙丁戊己庚辛壬癸");
        和 = 和 + 字符串长度(垃圾);
        i++;
    }
    返回 和;
}

// ---- 借用来源返回（85-a 修复面） ----
函数 取形参(盒 参) -> 盒 {
    返回 参;
}

函数 取参内(箱 参) -> 盒 {
    返回 参.内盒;
}

函数 取局内(整32 号) -> 盒 {
    箱 局 = 箱{ 内盒 = 盒{ 名 = 字符串复制("E242形四局部内串甲乙丙丁戊己庚"), 号 = 号 }, 标记 = 1 };
    返回 局.内盒;
}

不安全 函数 取指针(盒* 指) -> 盒 {
    返回 *指;
}

// ---- 拥有来源返回（对照：所有权移出，零拷贝，原路径不变） ----
函数 造局部() -> 盒 {
    盒 局 = 盒{ 名 = 字符串复制("E242形六局部串甲乙丙丁戊己庚辛"), 号 = 6 };
    返回 局;
}

函数 造字面() -> 盒 {
    返回 盒{ 名 = 字符串复制("E242形七字面串甲乙丙丁戊己庚辛"), 号 = 7 };
}

函数 转发(盒 参) -> 盒 {
    返回 取形参(参);   // 调用返回=拥有契约（链式）
}

// ① 返回按值形参（实参=字面量临时）
函数 形一() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        盒 收 = 取形参(盒{ 名 = 字符串复制("E242形一临时串甲乙丙丁戊己庚辛"), 号 = 1 });
        搅动();
        如果 (字符串比较(收.名, "E242形一临时串甲乙丙丁戊己庚辛")) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 1) { 返回 1; }
    返回 0;
}

// ② 返回按值形参（实参=标识符局部；**跨块读取**：源 place 先退出作用域）
//    ——同块读取对句柄共享不敏感（源尚存活），故源置于内层块内、读取在其外
//    （探针 P38 形二同款：修复前在这里读出乱码）。
函数 形二() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        盒 收;
        {
            盒 源 = 盒{ 名 = 字符串复制("E242形二源串甲乙丙丁戊己庚辛"), 号 = 2 };
            收 = 取形参(源);
        }
        搅动();
        如果 (字符串比较(收.名, "E242形二源串甲乙丙丁戊己庚辛")) { 校验 = 1; }
        如果 (收.号 == 2) { 校验 = 校验 + 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 2) { 返回 2; }
    返回 0;
}

// ③ 返回形参的嵌套成员链
函数 形三() -> 整64 {
    整64 校验 = 0;
    {
        盒 收 = 取参内(箱{ 内盒 = 盒{ 名 = 字符串复制("E242形三参内串甲乙丙丁戊己庚"), 号 = 3 }, 标记 = 9 });
        搅动();
        如果 (字符串比较(收.名, "E242形三参内串甲乙丙丁戊己庚")) { 校验 = 1; }
        如果 (收.号 == 3) { 校验 = 校验 + 1; }
    }
    如果 (校验 == 2) { 返回 4; }
    返回 0;
}

// ④ 返回拥有局部的成员链
函数 形四() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        盒 收 = 取局内(4);
        搅动();
        如果 (字符串比较(收.名, "E242形四局部内串甲乙丙丁戊己庚")) { 校验 = 1; }
        如果 (收.号 == 4) { 校验 = 校验 + 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 2) { 返回 8; }
    返回 0;
}

// ⑤ 返回指针解引用（`*p`；⑤ 基线段错误 rc=139 修复的回归锚 + 跨块读取）
函数 形五() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        盒 收;
        {
            盒 源 = 盒{ 名 = 字符串复制("E242形五指针串甲乙丙丁戊己庚辛"), 号 = 5 };
            收 = 取指针(&源);
        }
        搅动();
        如果 (字符串比较(收.名, "E242形五指针串甲乙丙丁戊己庚辛")) { 校验 = 1; }
        如果 (收.号 == 5) { 校验 = 校验 + 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 2) { 返回 16; }
    返回 0;
}

// ⑥ 返回拥有局部（move 对照）
函数 形六() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        盒 收 = 造局部();
        搅动();
        如果 (字符串比较(收.名, "E242形六局部串甲乙丙丁戊己庚辛")) { 校验 = 1; }
        如果 (收.号 == 6) { 校验 = 校验 + 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 2) { 返回 32; }
    返回 0;
}

// ⑦ 返回结构体字面量 + 调用返回链
函数 形七() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        盒 收 = 造字面();
        搅动();
        如果 (字符串比较(收.名, "E242形七字面串甲乙丙丁戊己庚辛")) { 校验 = 1; }
        盒 链 = 转发(盒{ 名 = 字符串复制("E242形七转发串甲乙丙丁戊己庚辛"), 号 = 8 });
        搅动();
        如果 (字符串比较(链.名, "E242形七转发串甲乙丙丁戊己庚辛")) { 校验 = 校验 + 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 2) { 返回 64; }
    返回 0;
}

// ⑧ 循环 5 万轮（每轮借用来源返回 + 释放）
函数 形八(整64 轮数) -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    整64 i = 0;
    当 (i < 轮数) {
        盒 源 = 盒{ 名 = 字符串复制("E242形八循环串甲乙丙丁戊己庚辛"), 号 = 88 };
        盒 收 = 取形参(源);
        如果 (!字符串比较(收.名, "E242形八循环串甲乙丙丁戊己庚辛")) { 校验 = 0; 中断; }
        如果 (收.号 != 88) { 校验 = 0; 中断; }
        校验 = 1;
        i++;
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 1) { 返回 128; }
    返回 0;
}

函数 主() -> 整32 {
    整64 和 = 形一() + 形二() + 形三() + 形四();
    和 = 和 + 形五() + 形六() + 形七() + 形八(50000);
    返回 整32(和);
}
