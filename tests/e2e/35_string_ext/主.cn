// 字符串扩展库 E2E（Task 6.5，对标 C++ std::string 解析能力）
// 覆盖：
//   1. 数值解析（解析::转整数/转浮点/转布尔 内置直调，成功标志经 &整32）：
//      "123" → 123、"-42" → -42、"3.14" → 3.140000、非法 "abc" → 失败
//      "真" → 真、"假" → 假
//   2. 组合函数（字符串扩展.cn 模块公开函数：替换/填充左/填充右/分割）：
//      E2E 复制模块文件到用例目录（主.cn 入口 + 字符串扩展.cn 依赖模块），
//      导入后调用纯名——验证模块函数体 字符串.xxx 内置调用 + 组合逻辑全链路
// 调用方式：内置函数带 "字符串." 前缀（全局注册、无需导入）；模块函数经
//   导入 字符串扩展::替换 使用（29_core 核心库同模式）
// 打印语义（用户裁决）：打印=println（自动换行）；浮点 %f 6 位小数
// 注意：解析失败返回 错误(6)（无效参数）→ E2E 打印 错误码 验证

导入 字符串扩展::替换
导入 字符串扩展::填充左
导入 字符串扩展::填充右
导入 字符串扩展::分割

函数 主() -> 整32 {
    打印("===== 字符串扩展库（Task 6.5）=====")

    // ==================== 1. 字符串转整数 ====================
    整32 标志1 = 0
    整64 整1 = 解析::转整数("123", &标志1)
    如果 (标志1 == 1) {
        打印("转整数(123): ", 整1)          // 123
    } 否则 {
        打印("转整数(123) 失败")
    }

    整32 标志2 = 0
    整64 整2 = 解析::转整数("-42", &标志2)
    如果 (标志2 == 1) {
        打印("转整数(-42): ", 整2)          // -42
    } 否则 {
        打印("转整数(-42) 失败")
    }

    // 非法输入："abc" 不是数字 → 成功标志 0（值归零 0）
    整32 标志3 = 0
    整64 整3 = 解析::转整数("abc", &标志3)
    如果 (标志3 == 1) {
        打印("转整数(abc): ", 整3)
    } 否则 {
        打印("转整数(abc) 失败")            // 失败
    }

    // 前导空格 + 尾部换行（strtoll 允许首尾空白）
    整32 标志4 = 0
    整64 整4 = 解析::转整数("  99  ", &标志4)
    如果 (标志4 == 1) {
        打印("转整数(  99  ): ", 整4)       // 99
    } 否则 {
        打印("转整数(  99  ) 失败")
    }

    // ==================== 2. 字符串转浮点 ====================
    整32 标志5 = 0
    浮64 浮1 = 解析::转浮点("3.14", &标志5)
    如果 (标志5 == 1) {
        打印("转浮点(3.14): ", 浮1)         // 3.140000
    } 否则 {
        打印("转浮点(3.14) 失败")
    }

    整32 标志6 = 0
    浮64 浮2 = 解析::转浮点("-0.5", &标志6)
    如果 (标志6 == 1) {
        打印("转浮点(-0.5): ", 浮2)         // -0.500000
    } 否则 {
        打印("转浮点(-0.5) 失败")
    }

    // ==================== 3. 字符串转布尔 ====================
    整32 标志7 = 0
    整64 布1 = 解析::转布尔("真", &标志7)
    如果 (标志7 == 1) {
        打印("转布尔(真): ", 布1)           // 1
    } 否则 {
        打印("转布尔(真) 失败")
    }

    整32 标志8 = 0
    整64 布2 = 解析::转布尔("假", &标志8)
    如果 (标志8 == 1) {
        打印("转布尔(假): ", 布2)           // 0
    } 否则 {
        打印("转布尔(假) 失败")
    }

    整32 标志9 = 0
    整64 布3 = 解析::转布尔("true", &标志9)
    如果 (标志9 == 1) {
        打印("转布尔(true): ", 布3)         // 1
    } 否则 {
        打印("转布尔(true) 失败")
    }

    // ==================== 4. 替换（模块函数） ====================
    字符串 替换结果 = 替换("hello world", "world", "CN语言")
    打印("替换(world→CN语言): ", 替换结果)   // hello CN语言
    字符串释放(替换结果)

    // 目标不存在 → 返回原样副本
    字符串 替换无 = 替换("hello world", "xyz", "CN语言")
    打印("替换(xyz): ", 替换无)             // hello world
    字符串释放(替换无)

    // 多次出现全部替换
    字符串 替换多 = 替换("a-b-c", "-", "+")
    打印("替换多(a-b-c): ", 替换多)         // a+b+c
    字符串释放(替换多)

    // ==================== 5. 填充左 / 填充右（模块函数） ====================
    字符串 左1 = 填充左("42", 5, '0')
    打印("填充左(42,5,'0'): ", 左1)         // 00042
    字符串释放(左1)

    字符串 右1 = 填充右("42", 5, '*')
    打印("填充右(42,5,'*'): ", 右1)         // 42***
    字符串释放(右1)

    // 已超长度 → 原样
    字符串 左2 = 填充左("12345", 3, '0')
    打印("填充左(超长): ", 左2)             // 12345
    字符串释放(左2)

    // ==================== 6. 分割（模块函数，字符串* 数组） ====================
    字符串[4] 片段
    结果<整64, 整32> 分割结果 = 分割("apple,banana,cherry", ",", 片段, 4)
    如果 (分割结果.正常) {
        打印("分割数量: ", 分割结果.值)      // 3
        打印("分割[0]: ", 片段[0])           // apple
        打印("分割[1]: ", 片段[1])           // banana
        打印("分割[2]: ", 片段[2])           // cherry
        整64 释放索引 = 0
        当 (释放索引 < 分割结果.值) {
            字符串释放(片段[释放索引])
            释放索引++
        }
    } 否则 {
        打印("分割失败 错误码: ", 分割结果.错误)
    }

    // 数组不足 → 错误(6)
    字符串[2] 小片段
    结果<整64, 整32> 溢出结果 = 分割("a,b,c,d", ",", 小片段, 2)
    如果 (溢出结果.正常) {
        打印("分割溢出: ", 溢出结果.值)
    } 否则 {
        打印("分割溢出错误码: ", 溢出结果.错误)  // 6
    }

    打印("===== 字符串扩展库测试完成 =====")
    返回 0
}
