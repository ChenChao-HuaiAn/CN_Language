// E2E 1710 正测（#1882·#1445 第二形态）：类外静态数组字段下标读写全链——
//   类名.静态数组字段[i] 读/写=静态符号基址+元素偏移+越界检查（与 259 顶层
//   静态数组同款语义·001 §静态成员×数组下标组合）。宿主+v2 双编译对照。
//   修前：v2 写侧 IR 显错「下标左值对象未支持」中止、读侧把槽内容当基址；
//   宿主写侧拒（#648 显形）、读侧整64 凑巧/窄元素踩槽——双侧补通道后对齐。
类 配置 {
公开:
    静态 整64[3] 表;
    静态 整32[4] 表32;
}
函数 主() -> 整32 {
    // 写：类外逐元素赋值（本任务修通的写通道）
    配置.表[0] = 10;
    配置.表[1] = 20;
    配置.表[2] = 30;
    // 读：逐元素读回
    打印(配置.表[0]);
    打印(配置.表[1]);
    打印(配置.表[2]);
    // 整32 数组：窄元素步进（宽度查表·非 8 字节默认）
    配置.表32[0] = 7;
    配置.表32[3] = 9;
    配置.表32[1] = 配置.表32[0] + 配置.表32[3];
    打印(配置.表32[1]);
    打印(配置.表32[3]);
    // 下标读作表达式消费
    整64 和 = 配置.表[0] + 配置.表[2];
    打印(和);
    返回 0;
}
