// 606：函数指针空调用判零防线（001 §5.8 子案 A·2026-10-05 用户裁决）
//   健康对照（已赋值 fnptr 直调/回调表已注册槽·判零零误伤）+ 未注册槽触发：
//   零值 → 运行时错误(错误码3): 空指针解引用（093 判空家族同码同文案·§1.1a②
//   确定性失败非脏崩溃；553 空指针判零同范式）
函数 健康值(整32 x) -> 整32 { 返回 7; }
函数 主() -> 整32 {
    整32(*回调)(整32) = 健康值;
    打印(回调(1));
    整32(*表[2])(整32);
    表[0] = 健康值;
    打印(表[0](2));
    // 表[1] 未注册（零值槽）→ 运行期确定性失败
    打印(表[1](3));
    返回 0;
}
