// 695 整数边界与显式转换面（§3.7a 窄域回绕立法·285/377 双批；§布尔=1）
// 期望手算：整64 2^32+1 显式窄化 整32 → 截断=1；整128 1<<70=1180591620717411303424
//   正8 255+1 回绕=0（285 甲案）；整8(-129) 回绕=127（-129 mod 256）
函数 主() -> 整32 {
    整64 大 = 4294967297;
    打印(整32(大));                // 1（截断低 32 位）
    整128 巨 = 1;
    巨 <<= 70;
    打印(巨);                      // 1180591620717411303424
    正8 环 = 255;
    环 += 1;
    打印(环);                      // 0
    整8 窄 = 整8(-129);
    打印(窄);                      // 127
    返回 0;
}
