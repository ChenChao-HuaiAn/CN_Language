// 736_lambda引用捕获实参传出逃逸拒（#435·001「[&] 引用捕获逃逸限制」负测矩阵②·dual）
// [&] 引用捕获闭包作函数实参传出=闭包逃逸定义帧（被调方存储寿命/调用时机
//   均不可证——保守逃逸分析不确定即拒·裁决第 4 条永不静默放行）。
//   被调位不扫描（同帧立即调用/调用闭包持有变量为合法面·706/707 权料）。
// 预期失败：双侧编译拒绝，诊断锚「逃逸当前栈帧」。
函数 消费回调(整32(*回调)()) -> 整32 {
    返回 回调();
}
函数 主() -> 整32 {
    变量 x = 5;
    消费回调([&]() -> 整32 { 返回 x; });
    返回 0;
}
