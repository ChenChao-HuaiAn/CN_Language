// 官网文档示例 · reference/functions.html · 泛型（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
泛型 <类型 T>
函数 首个或默认(T* 表, 整64 长度, T 缺省) -> T {
    如果 长度 > 0 { 返回 表[0]; }
    返回 缺省;
}

函数 主() -> 整32 {
    整32[3] 数 = {5, 6, 7};
    浮64[2] 实 = {1.5, 2.5};
    打印(首个或默认<整32>(数, 3, 0), " ", 首个或默认<浮64>(实, 0, 9.9));
    返回 0;
}