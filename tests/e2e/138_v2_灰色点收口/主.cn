// E2E 138（v2 灰色点①③④根治锚定，2026-09-04 用户裁决·缺陷零容忍立案）：
//   ① 真/假 独立布尔字面量（节点_布尔字面量：IR 登记 T_布尔——拼接 from_bool
//      分派为行为证据：『前缀』+真 == 『前缀真』；原整数 1/0 分叉，打印(真) 输出 1）；
//   ③ 解引用复合赋值 *p op= r 全形态（+= -= *= 与直写 *p = v——原 P6c 分支只认
//      '='，'+= 1' 孤儿 token 触发块中断、后续语句（含 返回）全部丢弃）；
//   ④ 窄宽强转 整8/整16 截断语义（整8(300)=44 / 整16(70000)=4464 / 整8(-1)=-1
//      符号保号——原语义白名单拒『未声明函数: 整8』）。
//   宿主 sanity 同源跑通（退出码 0）——两侧行为一致为本用例验收边界。
// 断言失败 返回 201~210；全部通过 返回 0。

函数 主() -> 整32 {
    // ===== ① 真/假 布尔字面量（类型码 T_布尔 的行为锚定）=====
    字符串 s1 = "前缀" + 真;
    如果 (!字符串比较(s1, "前缀真")) { 返回 201; }
    字符串 s2 = "前缀" + 假;
    如果 (!字符串比较(s2, "前缀假")) { 返回 202; }
    布尔 b = 真;
    如果 (b != 真) { 返回 203; }
    // ===== ③ 解引用复合赋值（+= -= *= 与直写）=====
    整64 v = 5;
    整64* p = &v;
    *p += 1;
    如果 (*p != 6) { 返回 204; }
    *p = 10;
    如果 (*p != 10) { 返回 205; }
    *p -= 3;
    如果 (*p != 7) { 返回 206; }
    *p *= 2;
    如果 (*p != 14) { 返回 207; }
    // ===== ④ 窄宽强转截断（目标宽度截断 + 符号保号）=====
    如果 (整64(整8(300)) != 44) { 返回 208; }
    如果 (整64(整16(70000)) != 4464) { 返回 209; }
    如果 (整64(整8(-1)) != -1) { 返回 210; }
    // 打印 分派展示（stdout 人工审计：真/前缀真——退出码不比对 stdout）
    打印(真);
    打印(s1);
    返回 0;
}
