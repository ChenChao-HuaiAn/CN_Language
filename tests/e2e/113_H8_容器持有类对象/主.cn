// 113_H8 容器持有类对象 E2E（2026-08-25 原版·749-a 重写为当前已实现语义）：
//   向量<映射<整64,符号>> 真嵌套作用域栈——P4 重做（符号表）依赖的宿主能力验证。
// 覆盖（H8-5 容器持有类对象所有权语义·749-a 值语义形态）：
//   1. 映射 设置/获取/大小（O(1) 哈希操作面）
//   2. 向量 追加 类元素（映射）深拷贝独立（追加 深拷·池独立）
//   3. 元素 读取（快照语义·749-a 副本接收）
//   4. 删除 真删除（内部资源释放）
// 注（749-a 重写报备）：原版 压入/注册/查找 使用 容器按值形参（依赖 056 甲
//   in-out 写回语义·未落地·746 定音两代分叉）——本版改 主局部直接操作·
//   传参面能力待 056 甲落地后以新用例恢复。
导入 容器::向量;
导入 映射集合;

结构体 符号 {
    整64 名ID;
    整64 类型ID;
    整64 种类;
    整64 附加;
}

函数 主() -> 整32 {
    映射<整64, 符号> 全局层 = 映射<整64, 符号>();
    打印("初始大小: ", 全局层.大小());

    符号 s1;
    s1.名ID = 1;
    s1.类型ID = 101;
    s1.种类 = 1;
    s1.附加 = 0;
    结果<空类型, 整32> 加1 = 全局层.设置(1, s1);
    打印("设置[1]: ", 加1.正常);

    符号 s2;
    s2.名ID = 2;
    s2.类型ID = 102;
    s2.种类 = 1;
    s2.附加 = 0;
    结果<空类型, 整32> 加2 = 全局层.设置(2, s2);
    打印("设置[2]: ", 加2.正常);
    结果<符号, 整32> 立查 = 全局层.获取(1);
    如果 (立查.正常) {
        符号 找到立 = 立查.值;
        打印("立即[1].类型ID: ", 找到立.类型ID);
    }

    打印("层大小: ", 全局层.大小());

    结果<符号, 整32> 查1 = 全局层.获取(1);
    如果 (查1.正常) {
        符号 找到1 = 查1.值;
        打印("获取[1].类型ID: ", 找到1.类型ID);
    }
    结果<符号, 整32> 查3 = 全局层.获取(3);
    打印("获取[3].正常: ", 查3.正常);

    // 向量 持有 映射 元素（追加 深拷贝独立·H8-5）
    向量<映射<整64, 符号>> 符号表 = 向量<映射<整64, 符号>>();
    结果<空类型, 整32> 压 = 符号表.追加(全局层);
    打印("追加.正常: ", 压.正常);
    打印("向量大小: ", 符号表.大小());

    // 元素 读取（副本/快照语义·两代一致）
    映射<整64, 符号> 顶层 = 符号表.元素(0);
    打印("元素[0].大小: ", 顶层.大小());
    结果<符号, 整32> 查r = 顶层.获取(1);
    如果 (查r.正常) {
        符号 找到r = 查r.值;
        打印("元素[0][1].类型ID: ", 找到r.类型ID);
    }

    // 删除 真删除
    结果<空类型, 整32> 删r = 符号表.删除(0);
    打印("删除.正常: ", 删r.正常);
    打印("删除后向量大小: ", 符号表.大小());

    返回 0;
}
