// 113_H8 容器持有类对象 E2E（2026-08-25）：向量<映射<整64,符号>> 真嵌套作用域栈
//   ——P4 重做（符号表）依赖的宿主能力验证。
// 覆盖（H8-5 容器持有类对象所有权语义）：
//   1. 向量 追加 类元素（映射）深拷贝独立（拷贝构造 this=内联元素地址）
//   2. 绑定元素 = 非拥有式视图（跳过 RAII 析构，无双重释放 0xC0000374）
//   3. 弹出销毁元素资源（释放内部数组 + 删除末尾，真删除无残留遮蔽）
//   4. 遮蔽/恢复（内层符号遮蔽外层，弹出后恢复）+ 查找从栈顶向下
导入 容器::向量;
导入 映射集合;

结构体 符号 {
    整64 名ID;
    整64 类型ID;
    整64 种类;
    整64 附加;
}

// 压入作用域：追加空映射（深拷贝独立）
函数 压入(向量<映射<整64, 符号>> 符号表) -> 空类型 {
    映射<整64, 符号> 层 = 映射<整64, 符号>();
    结果<空类型, 整32> 加 = 符号表.追加(层);
    如果 (!加.正常) { 运行时错误(4); }
}

// 弹出作用域：销毁顶层映射内部资源 + 移除末尾（真删除）
函数 弹出(向量<映射<整64, 符号>> 符号表) -> 空类型 {
    如果 (符号表.大小() == 0) { 返回; }
    映射<整64, 符号> 顶层 = 符号表.元素(符号表.大小() - 1);
    顶层.释放内部数组();
    结果<空类型, 整32> 删 = 符号表.删除(符号表.大小() - 1);
    如果 (!删.正常) { 运行时错误(4); }
}

// 注册符号：同作用域重名 -> 0；否则设置（O(1) 哈希）
函数 注册(向量<映射<整64, 符号>> 符号表, 整64 名ID, 整64 类型ID, 整64 种类) -> 整64 {
    如果 (符号表.大小() == 0) { 返回 0; }
    映射<整64, 符号> 顶层 = 符号表.元素(符号表.大小() - 1);
    结果<符号, 整32> 已有 = 顶层.获取(名ID);
    如果 (已有.正常) { 返回 0; }
    符号 s;
    s.名ID = 名ID;
    s.类型ID = 类型ID;
    s.种类 = 种类;
    s.附加 = 0;
    结果<空类型, 整32> 加 = 顶层.设置(名ID, s);
    如果 (!加.正常) { 返回 0; }
    返回 1;
}

// 查找：从栈顶向下（内层遮蔽外层）；返回类型ID（-1=未找到）
函数 查找(向量<映射<整64, 符号>> 符号表, 整64 名ID) -> 整64 {
    整64 i = 符号表.大小();
    当 (i > 0) {
        i--;
        映射<整64, 符号> 层 = 符号表.元素(i);
        结果<符号, 整32> 查 = 层.获取(名ID);
        如果 (查.正常) {
            符号 找到 = 查.值;
            返回 找到.类型ID;
        }
    }
    返回 -1;
}

函数 主() -> 整32 {
    向量<映射<整64, 符号>> 符号表 = 向量<映射<整64, 符号>>();

    压入(符号表);  // 全局作用域
    注册(符号表, 1, 101, 1);
    注册(符号表, 2, 102, 1);
    打印("全局[1]: ", 查找(符号表, 1));
    打印("全局[2]: ", 查找(符号表, 2));
    打印("全局[3]: ", 查找(符号表, 3));

    压入(符号表);  // 函数作用域（遮蔽 [1]）
    注册(符号表, 1, 202, 2);
    注册(符号表, 3, 303, 3);
    打印("函数[1]: ", 查找(符号表, 1));
    打印("函数[3]: ", 查找(符号表, 3));
    打印("栈大小: ", 符号表.大小());

    压入(符号表);  // 块作用域（再遮蔽）
    注册(符号表, 1, 404, 2);
    打印("块[1]: ", 查找(符号表, 1));
    打印("块大小: ", 符号表.大小());
    弹出(符号表);

    打印("弹出块后[1]: ", 查找(符号表, 1));  // 恢复 202
    弹出(符号表);
    打印("弹出函数后[1]: ", 查找(符号表, 1));  // 恢复 101
    打印("弹出函数后[3]: ", 查找(符号表, 3));  // 303 真删除 -> -1
    弹出(符号表);
    打印("最终大小: ", 符号表.大小());

    返回 0;
}
