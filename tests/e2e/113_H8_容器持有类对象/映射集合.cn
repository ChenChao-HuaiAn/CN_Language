// CN 语言标准库：映射集合模块（Task 6.4，对标 C++ map/set）
// 公开: 错误码（枚举）/ 映射<K,V>（键值对线性表，O(n) 复杂度）/ 集合<T>
// 实现：
//   - 映射：K* 键数组 + V* 值数组 平行存储（线性表），键不存在→追加（扩容翻倍），
//     键已存在→覆盖值；删除→前移；析构释放（RAII）
//   - 集合：独立 T* 数据数组（值唯一，添加幂等），不组合 映射<T,布尔> 字段，
//     规避"嵌套泛型字段 + 结构体返回方法"编译器缺陷（Task 6.1 实测）
// 设计说明（Task 6.4 实测边界）：
//   - 泛型类方法体内"循环遍历第一个泛型字段" ✅ 已修复（2026-08-15 Debug 子任务：
//     IR emitClassMethod 设 genericTypeParams_ + 语义 resolveGenericTypeName 裸参数
//     替换）——循环查找/打印字段下标现可在类方法内直接进行。本模块仍用模块级
//     泛型自由函数组织（模块化设计，非缺陷规避）
//   - 键比较：K 须支持 == 比较（P0 仅数值/字符/枚举键；字符串键需 字符串比较
//     函数，规格书10.3 字符串比较运算符未定义，字符串键留待 P1）
//   - 元素按 8 字节槽存储（64 位平台，整32/浮64/指针均 8 字节槽）
//   - 构造函数重载 ✅ 已支持（2026-08-15）；本模块设计上用无参构造 + 预留()（API 稳定）
公开:
导入 核心::错误码;

// ==================== 泛型自由函数：线性表辅助（循环逻辑放此处，规避类方法循环缺陷） ====================

// 查找键在键数组中的位置（找不到返回 -1）
泛型 <类型 K>
函数 查找键位置(K* 键数组, 整64 长度, K 目标) -> 整64 {
    整64 索引 = 0;
    当 (索引 < 长度) {
        如果 (键数组[索引] == 目标) {
            返回 索引;
        }
        索引++;
    }
    返回 -1;
}

// 查找值在数据数组中的位置（找不到返回 -1）——集合 添加 用
泛型 <类型 T>
函数 查找值位置(T* 数据数组, 整64 长度, T 目标) -> 整64 {
    整64 索引 = 0;
    当 (索引 < 长度) {
        如果 (数据数组[索引] == 目标) {
            返回 索引;
        }
        索引++;
    }
    返回 -1;
}

// 数组元素前移（删除用：位置 起的元素整体左移一位）
泛型 <类型 T>
函数 数组前移(T* 数据数组, 整64 长度, 整64 位置) -> 空类型 {
    整64 移动 = 位置;
    当 (移动 + 1 < 长度) {
        数据数组[移动] = 数据数组[移动 + 1];
        移动++;
    }
}

// ==================== 映射<K,V>（O(1) 哈希表，2026-08 自举前置修复） ====================
// 实现：键数组/值数组 平行存储（同线性版）+ 链数组（同桶链）+ 桶数组（2 的幂）。
//   - 桶索引 = 键的 8 字节位模式 Knuth 乘法散列 & (桶数-1)（负数键安全：位运算无符号语义）
//   - 键比较用 ==（数值/字符/枚举键；字符串键待 字符串[i] 与 泛型决议 修复后支持——P1）
//   - 删除 = 链摘除 + 与数组末元素交换（空洞无引用，正确性由链保证）
//   - 负载因子 3/4：元素数 >= 桶数*3/4 时 桶数翻倍 + 全键重哈希；数组容量翻倍扩容（同线性版）
// 复杂度：设置/获取/包含/删除 期望 O(1)；自举符号表（ID 整型键）规模下毫秒级
泛型 <类型 K, 类型 V>
类 映射 {
私有:
    K* 键数组;
    V* 值数组;
    整64* 链数组;      // 桶链：下一索引（-1=链尾）
    整64* 桶数组;      // 桶头索引（-1=空桶）
    整64 桶数量;       // 2 的幂（1024 起，翻倍扩容）
    整64 元素数量;
    整64 数组容量;
公开:
    函数 映射() {
        键数组 = 无;
        值数组 = 无;
        链数组 = 无;
        桶数量 = 1024;
        桶数组 = 分配(桶数量 * 8);
        整64 桶索引 = 0;
        当 (桶索引 < 桶数量) {
            桶数组[桶索引] = -1;
            桶索引++;
        }
        元素数量 = 0;
        数组容量 = 0;
    }

    函数 ~映射() {
        如果 (键数组 != 无) {
            释放(键数组);
            键数组 = 无;
        }
        如果 (值数组 != 无) {
            释放(值数组);
            值数组 = 无;
        }
        如果 (链数组 != 无) {
            释放(链数组);
            链数组 = 无;
        }
        如果 (桶数组 != 无) {
            释放(桶数组);
            桶数组 = 无;
        }
        元素数量 = 0;
        数组容量 = 0;
    }

    // 2026-08-25 H8-5（容器持有类对象）：释放内部数组——映射作为容器元素
    //   （向量<映射<K,V>> 作用域栈）时由容器负责元素生命周期，弹出/清场前
    //   调用本方法销毁元素资源（析构 ~映射 为 RAII 路径，本方法供显式销毁）。
    //   释放后所有数组置 无，可安全再次使用（重新分配）。
    函数 释放内部数组() {
        如果 (键数组 != 无) {
            释放(键数组);
            键数组 = 无;
        }
        如果 (值数组 != 无) {
            释放(值数组);
            值数组 = 无;
        }
        如果 (链数组 != 无) {
            释放(链数组);
            链数组 = 无;
        }
        如果 (桶数组 != 无) {
            释放(桶数组);
            桶数组 = 无;
        }
        元素数量 = 0;
        数组容量 = 0;
    }

    // 2026-08-25 方案A 拷贝构造：深拷贝全部数组（含裸指针结构体按值拷贝
    //   安全——浅拷贝两个对象析构时双释放 0xC0000374）。
    函数 映射(映射& 其他) {
        桶数量 = 其他.桶数量;
        元素数量 = 其他.元素数量;
        数组容量 = 其他.数组容量;
        桶数组 = 无;
        键数组 = 无;
        值数组 = 无;
        链数组 = 无;
        如果 (其他.桶数组 != 无) {
            桶数组 = 分配(桶数量 * 8);
            整64 桶索引 = 0;
            当 (桶索引 < 桶数量) {
                桶数组[桶索引] = 其他.桶数组[桶索引];
                桶索引++;
            }
        }
        如果 (其他.键数组 != 无) {
            键数组 = 分配(数组容量 * 8);
            整64 键索引 = 0;
            当 (键索引 < 数组容量) {
                键数组[键索引] = 其他.键数组[键索引];
                键索引++;
            }
        }
        如果 (其他.值数组 != 无) {
            值数组 = 分配(数组容量 * 8);
            整64 值索引 = 0;
            当 (值索引 < 数组容量) {
                值数组[值索引] = 其他.值数组[值索引];
                值索引++;
            }
        }
        如果 (其他.链数组 != 无) {
            链数组 = 分配(数组容量 * 8);
            整64 链索引 = 0;
            当 (链索引 < 数组容量) {
                链数组[链索引] = 其他.链数组[链索引];
                链索引++;
            }
        }
    }

    常量 函数 大小() -> 整64 {
        返回 元素数量;
    }

    常量 函数 为空() -> 布尔 {
        返回 元素数量 == 0;
    }

    // ---- 私有辅助（桶索引 + 链查找）----
    函数 桶索引(K 键) -> 整64 {
        整64 位模式 = 整64(键);              // 8 字节槽位模式（数值/枚举/字符）
        整64 散列 = 位模式 * 2654435761;     // Knuth 乘法散列（64 位回绕）
        返回 散列 & (桶数量 - 1);             // 2 的幂掩码（负数安全）
    }

    // 链查找：返回 键位置（找不到 -1），prev 输出链前驱（-1=桶头）
    函数 链查找(K 键, 整64& 前驱) -> 整64 {
        整64 h = 自身.桶索引(键);
        前驱 = -1;
        整64 cur = 桶数组[h];
        当 (cur != -1) {
            如果 (键数组[cur] == 键) {
                返回 cur;
            }
            前驱 = cur;
            cur = 链数组[cur];
        }
        返回 -1;
    }

    // 设置键值：键已存在→覆盖值；不存在→追加（负载/容量不足时扩容）
    函数 设置(K 键, V 值) -> 结果<空类型, 整32> {
        整64 前驱 = -1;
        整64 已有位置 = 自身.链查找(键, 前驱);
        如果 (已有位置 >= 0) {
            值数组[已有位置] = 值;
            返回 正常();
        }
        // 负载扩容：元素数 >= 桶数*3/4 → 桶数翻倍 + 重哈希
        如果 (元素数量 * 4 >= 桶数量 * 3) {
            整64 新桶数 = 桶数量 * 2;
            整64* 新桶 = 分配(新桶数 * 8);
            如果 (新桶 == 无) {
                返回 错误(错误码.内存);
            }
            整64 桶索引 = 0;
            当 (桶索引 < 新桶数) {
                新桶[桶索引] = -1;
                桶索引++;
            }
            释放(桶数组);
            桶数组 = 新桶;
            桶数量 = 新桶数;
            // 重哈希全部键
            整64 重哈希 = 0;
            当 (重哈希 < 元素数量) {
                整64 h = 自身.桶索引(键数组[重哈希]);
                链数组[重哈希] = 桶数组[h];
                桶数组[h] = 重哈希;
                重哈希++;
            }
        }
        // 数组容量不足：翻倍扩容（同线性版）
        如果 (元素数量 >= 数组容量) {
            整64 新容量 = 数组容量 * 2;
            如果 (新容量 == 0) {
                新容量 = 4;
            }
            空类型* 新键数组 = 重新分配(键数组, 新容量 * (类型大小(K) < 8 ? 8 : 类型大小(K)));
            如果 (新键数组 == 无) {
                返回 错误(错误码.内存);
            }
            键数组 = 新键数组;
            空类型* 新值数组 = 重新分配(值数组, 新容量 * (类型大小(V) < 8 ? 8 : 类型大小(V)));
            如果 (新值数组 == 无) {
                返回 错误(错误码.内存);
            }
            值数组 = 新值数组;
            空类型* 新链 = 重新分配(链数组, 新容量 * 8);
            如果 (新链 == 无) {
                返回 错误(错误码.内存);
            }
            链数组 = 新链;
            数组容量 = 新容量;
        }
        // 追加到数组尾部 + 头插桶链
        键数组[元素数量] = 键;
        值数组[元素数量] = 值;
        链数组[元素数量] = 桶数组[自身.桶索引(键)];
        桶数组[自身.桶索引(键)] = 元素数量;
        元素数量++;
        返回 正常();
    }

    // 获取键对应值：找不到→错误码.未初始化(7)
    函数 获取(K 键) -> 结果<V, 整32> {
        整64 前驱 = -1;
        整64 位置 = 自身.链查找(键, 前驱);
        如果 (位置 < 0) {
            返回 错误(错误码.未初始化);
        }
        返回 正常(值数组[位置]);
    }

    // 规格书 4.4「表.包含(键)」：键是否存在
    常量 函数 包含(K 键) -> 布尔 {
        整64 前驱 = -1;
        返回 自身.链查找(键, 前驱) >= 0;
    }

    // 删除键：链摘除 + 与数组末元素交换（空洞无引用）；存在返回真
    函数 删除(K 键) -> 布尔 {
        整64 前驱 = -1;
        整64 位置 = 自身.链查找(键, 前驱);
        如果 (位置 < 0) {
            返回 假;
        }
        // 链摘除
        如果 (前驱 == -1) {
            桶数组[自身.桶索引(键)] = 链数组[位置];
        } 否则 {
            链数组[前驱] = 链数组[位置];
        }
        // 与末元素交换（末元素链指针迁移到 位置）
        整64 最后 = 元素数量 - 1;
        如果 (位置 != 最后) {
            键数组[位置] = 键数组[最后];
            值数组[位置] = 值数组[最后];
            // 更新末元素的桶链引用：链中 last → 位置
            整64 h2 = 自身.桶索引(键数组[位置]);
            整64 cur = 桶数组[h2];
            整64 prev2 = -1;
            当 (cur != -1) {
                如果 (cur == 最后) {
                    如果 (prev2 == -1) {
                        桶数组[h2] = 位置;
                    } 否则 {
                        链数组[prev2] = 位置;
                    }
                    链数组[位置] = 链数组[最后];
                    中断;
                }
                prev2 = cur;
                cur = 链数组[cur];
            }
        }
        元素数量--;
        返回 真;
    }

    函数 清空() {
        整64 桶索引 = 0;
        当 (桶索引 < 桶数量) {
            桶数组[桶索引] = -1;
            桶索引++;
        }
        元素数量 = 0;
    }
}

// ==================== 集合<T>（对标 C++ set，值唯一，添加幂等） ====================
// 实现：独立 T* 数据数组 + 包含检查（不组合 映射<T,布尔> 字段，规避嵌套泛型缺陷）
泛型 <类型 T>
类 集合 {
私有:
    T* 数据数组;
    整64 元素数量;
    整64 数组容量;
公开:
    函数 集合() {
        数据数组 = 无;
        元素数量 = 0;
        数组容量 = 0;
    }

    函数 ~集合() {
        如果 (数据数组 != 无) {
            释放(数据数组);
            数据数组 = 无;
        }
        元素数量 = 0;
        数组容量 = 0;
    }

    常量 函数 大小() -> 整64 {
        返回 元素数量;
    }

    常量 函数 为空() -> 布尔 {
        返回 元素数量 == 0;
    }

    // 添加值：已存在→返回正常(空)（幂等）；不存在→追加（容量不足扩容翻倍）
    函数 添加(T 值) -> 结果<空类型, 整32> {
        整64 已有位置 = 查找值位置<T>(数据数组, 元素数量, 值);
        如果 (已有位置 >= 0) {
            返回 正常();
        }
        如果 (元素数量 >= 数组容量) {
            整64 新容量 = 数组容量 * 2;
            如果 (新容量 == 0) {
                新容量 = 4;
            }
            空类型* 新数据 = 重新分配(数据数组, 新容量 * (类型大小(T) < 8 ? 8 : 类型大小(T)));
            如果 (新数据 == 无) {
                返回 错误(错误码.内存);
            }
            数据数组 = 新数据;
            数组容量 = 新容量;
        }
        数据数组[元素数量] = 值;
        元素数量++;
        返回 正常();
    }

    常量 函数 包含(T 值) -> 布尔 {
        整64 位置 = 查找值位置<T>(数据数组, 元素数量, 值);
        返回 位置 >= 0;
    }

    // 删除值：存在则删除并前移，返回真；否则返回假
    函数 删除(T 值) -> 布尔 {
        整64 位置 = 查找值位置<T>(数据数组, 元素数量, 值);
        如果 (位置 < 0) {
            返回 假;
        }
        数组前移<T>(数据数组, 元素数量, 位置);
        元素数量--;
        返回 真;
    }

    函数 清空() {
        元素数量 = 0;
    }
}
