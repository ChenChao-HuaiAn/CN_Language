// E2E 1039_线程对象赋值析构（#603 销项·dual 双编译对照锁用例）：
//   线程形态对象赋值/析构——821（类对象重载赋值八形态）校验和全系单线程；
//   本用例把「含资源字段（字符串）类对象的构造/赋值（旧值释放）/重载+产物/析构」
//   放到运行时线程（非主线程栈）形态：
//     两线程各 200 轮：构造 甲/乙（堆串字段）→ 重载赋值 甲=盒(新值)（旧值释放）
//     → 重载+产物 丙（块尾析构）→ 累加计数；对象生命周期闭合于互斥锁内
//     （合法互斥用法：分配/析构路径与共享计数同锁串行化——分配器线程安全缺口
//     见下方立案登记，修复后本用例加无锁形态断言）。
//   判据：校验和=161600（单线程 200 轮=80800·手算见下）+ 双侧输出逐行一致。
//   手算：每轮 计数 += 甲.值 + 乙.值 + 丙.值；甲.值=i+2（赋值后）、乙.值=i+1、
//     丙.值=甲.值+乙.值=2i+3 → 每轮 4i+6；Σ_{i=0..199}(4i+6)=4*19900+1200=80800。
//   平台口径：win=运行时线程桩（错误码9·thread_api.cpp win 分支「线程层 win 实现
//   随 027 波 3 提供」）——win 平台跳过（run_e2e 平台跳过表·与 586/929 同口径）；
//   linux 真线程全跑（WSL 本地实证+云端全量）。
//   【缺口登记·已立案】同面未锁形态（探针实录 2026-10-16·本案先行）：
//     · #945（P1）无锁并发分配数据竞争：两线程各自独立对象构造/赋值/析构（互不
//       共享任何对象）=rc=139 段错误——运行时小对象池（mem_api.cpp g_pool：
//       freeHead/carve/dir/live 全局无锁）与 tracked 注册表（unordered_set/map
//       无锁）并发访问竞争（对照：单线程同码 rc=0、两线程整数±锁 rc=0）；
//       修复前对象生命周期闭合于锁内=合法用法。
//     · #946（P2）重载赋值 甲=盒(...)（构造调用产物右值）旧值释放每轮漏 1 分配
//       （主线程 200 轮残留=200·B2 探针；dual 9901 双侧一致=非分叉；与 #542②
//       静态目标同族）——故本用例不做净残留断言；修复后补「净残留 0」断言。
导入 线程::新线程;
导入 线程::并入线程;
导入 线程::互斥锁新建;
导入 线程::互斥锁上锁;
导入 线程::互斥锁解锁;
导入 线程::互斥锁释放;

类 盒 {
公开:
    整32 值;
    字符串 名;
    函数 盒(整32 v, 字符串 n) { 值 = v; 名 = n; }
    函数 ~盒() { }
    不安全 函数 盒(盒& 其他) { 值 = 其他.值; 名 = 字符串复制(其他.名); }
    函数 运算符+(盒 右) -> 盒 {
        返回 盒(值 + 右.值, 字符串复制(名));
    }
}

静态 整64 计数 = 0;
静态 空类型* 锁句柄 = 无;

不安全 函数 工人(空类型* 未用) -> 整64 {
    循环(整32 i = 0; i < 200; i++) {
        互斥锁上锁(锁句柄);
        {
            盒 甲 = 盒(i, 字符串复制("甲"));
            盒 乙 = 盒(i + 1, 字符串复制("乙"));
            甲 = 盒(i + 2, 字符串复制("丙"));     // 赋值位：旧值（甲原值）释放
            盒 丙 = 甲 + 乙;                      // 重载+产物（块尾析构）
            计数 = 计数 + 甲.值 + 乙.值 + 丙.值;
        }
        互斥锁解锁(锁句柄);
    }
    返回 0;
}

不安全 函数 主() -> 整32 {
    锁句柄 = 互斥锁新建();
    结果<空类型*, 整32> 建甲 = 新线程(工人, 无);
    空类型* 线程甲 = 无;
    如果 (建甲.正常) { 线程甲 = 建甲.值; } 否则 { 返回 3; }
    结果<空类型*, 整32> 建乙 = 新线程(工人, 无);
    空类型* 线程乙 = 无;
    如果 (建乙.正常) { 线程乙 = 建乙.值; } 否则 { 返回 4; }
    并入线程(线程甲);
    并入线程(线程乙);
    打印(计数);                        // 161600
    互斥锁释放(锁句柄);
    返回 0;
}
