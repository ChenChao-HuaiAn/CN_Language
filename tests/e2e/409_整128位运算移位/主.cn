// 409（302-a T39 根治回归防线）：整128/正128 位运算与移位全族
//   背景：三后端 dispatch 原缺 i128 分派（Add/Sub/Mul/Div/Mod/比较有）——Shl/Shr/
//   BitAnd/BitOr/BitXor 落 64 位通用路径=低 64 位槽从未被写（读未初始化·T39 采样
//   独家捕获：打印非确定/隔离探针丢低位）。修复=emitInt128Bitwise/Shift 双半专用
//   发射（移位量按位宽 128 取模——plans/001:289 用户裁决条文）。
//   另含 128→窄 Cast 截断（原仅 i64/u64，窄目标读高半槽）。
函数 主() -> 整32 {
    // ---- 位运算（双半独立·大数含高 64 位）----
    整128 大 = 18446744073709551616LL;
    整128 一 = 整128(1);
    打印(大 & 一);
    打印(大 | 一);
    打印(大 ^ 一);
    整128 全 = 大 | (大 - 一);
    打印(全 & 大);
    // ---- 左移常量（k<64 / k>=64 双侧）----
    整128 百 = 整128(100);
    打印(百 << 1);
    打印(百 << 2);
    打印(一 << 31);
    打印(一 << 32);
    打印(一 << 62);
    打印(一 << 63);
    打印(一 << 64);
    打印(一 << 65);
    打印(一 << 127);
    // ---- 右移常量（有符号算术·无符号逻辑）----
    打印(大 >> 1);
    打印(大 >> 32);
    打印(大 >> 64);
    打印(大 >> 65);
    整64 负 = 0 - 8;
    打印(负 >> 1);
    // ---- 移位量 mod 128 语义（130 mod 128 = 2）----
    打印(百 << 130);
    // ---- 变量移位量（大小分路）----
    整32 k1 = 3;
    打印(百 << k1);
    整32 k2 = 70;
    打印(一 << k2);
    整32 k3 = 1;
    打印(大 >> k3);
    // ---- 复合移位 ----
    整128 复 = 整128(8);
    复 <<= 3;
    打印(复);
    复 >>= 2;
    打印(复);
    // ---- 128→窄 Cast（截断取低半）----
    整128 值 = 整128(100);
    打印(整32(值));
    打印(整64(值));
    打印(整16(值));
    返回 0;
}
