// E2E 575（934 轮·任务 078 转正·双编译对照）：结构体 LUE（最后使用消除）——
//   复制(g) 且 g 之后不再使用 → 整块搬迁零拷贝（复槽分配+整块位拷贝+源槽全
//   清零·拥有字段句柄直移=所有权交接）；g 仍被使用 → 深拷照旧（源保持拥有）。
//   〔基准=019〕第四句(a)：对「源在拷贝后不再被使用」的拷贝自动降级为转移。
//   857 限面（仅字符串/容器）→ 078 解除（宿主 genCopyBuiltin 结构体 LUE 分支
//   +v2 生成复制展开结构体LUEmove·两侧同构）。
//   判据：最后使用形态 总分配次数 差=0（零拷贝）；非最后使用=1（串字段深拷）；
//   拥有字段（串+容器）块结束无泄漏+值链完整。
//   【host-only 登记（934 实测）】v2 侧被 **G-ir2/P7c 族既有缺陷**挡住（结构体
//   含容器字段按值传参→被调方读字段空指针·t6 基线〔撤本轮改动〕实锤复现·
//   021 002 逐族攻域在案）——v2 结构体 LUE 分支对标量/字符串字段形态健康
//   （v2 探针 t1=42/t2=105）；待 107/G-ir2 族修复后转 dual。
导入 容器::向量;
结构体 货舱 {
    字符串 标签;
    向量<整32> 箱子;
    整32 编号;
}
函数 校验(货舱 g) -> 整32 {
    整32 累 = g.编号;
    如果 (g.箱子.大小() == 2) { 累 = 累 + 10; }
    布尔 相等 = 字符串比较(g.标签, "甲乙丙丁戊己庚");
    如果 (相等) { 累 = 累 + 100; }
    返回 累;
}
不安全 函数 主() -> 整32 {
    整64 基线 = 内存::活动分配数();
    {
        货舱 g;
        g.标签 = "甲乙丙丁戊己庚";
        结果<空类型, 整32> 加1 = g.箱子.追加(1);
        如果 (!加1.正常) { 返回 1; }
        结果<空类型, 整32> 加2 = g.箱子.追加(2);
        如果 (!加2.正常) { 返回 1; }
        g.编号 = 3;
        // 最后使用：复制(g) 后 g 无任何出现 → LUE 整块搬迁（总分配次数差 0）
        整64 前 = 内存::总分配次数();
        整32 r = 校验(复制(g));
        整64 后 = 内存::总分配次数();
        打印(r);
        打印(后 - 前);
    }
    整64 收尾 = 内存::活动分配数();
    如果 (收尾 == 基线) { 打印("无泄漏"); }
    // 非最后使用：复制(h) 后 h 仍被读 → 深拷（总分配次数差 1）
    {
        货舱 h;
        h.标签 = "乙丙丁戊己庚辛";
        结果<空类型, 整32> 加3 = h.箱子.追加(1);
        如果 (!加3.正常) { 返回 1; }
        结果<空类型, 整32> 加4 = h.箱子.追加(2);
        如果 (!加4.正常) { 返回 1; }
        h.编号 = 4;
        整64 前2 = 内存::总分配次数();
        整32 r2 = 校验(复制(h));
        整64 后2 = 内存::总分配次数();
        如果 (r2 == 14) { 打印("深拷值链正确"); }
        打印(后2 - 前2);
        打印(h.编号);
    }
    整64 收尾2 = 内存::活动分配数();
    如果 (收尾2 == 基线) { 打印("双侧无泄漏"); }
    返回 0;
}
