// E2E 1326（2026-10-18·任务 #1068）：回绕内置实参「字面量参与域」全形态
//   收口——910/1068 提升链单点（宿主 types::integerLiteralRuntimeType /
//   v2 字面量运行期类型1068）双侧锚定：进制（0x）/后缀（L/U/UL/LL/ULL）/
//   负号超承载字面量按数学值域提升（无后缀 超 int32 双域→整64、超 int64
//   双域→整128；正族 超 u32→正64、超 u64→正128）；回绕=显式两补码回绕
//   通道（结果按参与域回绕位模式·域宽按数学值——001 §3.7a 回绕与算术同型
//   规则）。
//   修前分叉实录（双侧矩阵探针·1068 开工取证）：宿主回绕乘(0x8000000000000000,1)
//   语义参与域留整32、IR 按 resolvedType Cast 截断出 0（应 2^63）；v2
//   回绕减(-9223372036854775808,1) 按装载域 128 位回绕出 -9223372036854775809
//   （应 64 位回绕 9223372036854775807）；v2 回绕加(4294967296U,1) 装载
//   T_正32 截断出 1（应 4294967297）；v2 回绕加(9223372036854775807LL,1)
//   按 64 位域回绕出 -9223372036854775808（应 128 域 9223372036854775808）。
//   双编译对照：宿主+v2 同源同测（退出码 0·输出逐行全等）。
函数 主() -> 整32 {
    打印(回绕乘(0x8000000000000000, 1));    // 9223372036854775808（2^63·整128 域）
    打印(回绕加(0xFFFFFFFFFFFFFFFF, 1));    // 18446744073709551616（2^64·整128 域）
    打印(回绕乘(0x10000000000000000, 1));   // 18446744073709551616（进制超承载·整128）
    打印(回绕减(-9223372036854775808, 1));  // 9223372036854775807（-2^63=整64 域回绕）
    打印(回绕减(-0x8000000000000000, 1));   // 9223372036854775807（同值进制形态锚）
    打印(回绕加(-9223372036854775809, 1));  // -9223372036854775808（超 int64→整128）
    打印(回绕乘(0xFFFFFFFFFFFFFFFFUL, 1));  // 18446744073709551615（u64 全宽·正64 域内）
    打印(回绕加(4294967296U, 1));           // 4294967297（U 后缀超 u32→正64）
    打印(回绕加(9223372036854775807LL, 1)); // 9223372036854775808（LL 恒定级整128）
    返回 0;
}
