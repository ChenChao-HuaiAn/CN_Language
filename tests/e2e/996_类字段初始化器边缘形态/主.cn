// E2E 996（2026-10-15·任务 775 配套）：类字段初始化器边缘形态——①带构造类
//   部分字段默认值 ②全默认无构造类 ③派生显式构造（基类层默认值+构造覆盖·
//   退出码 1+2+4+8=15）。
类 纯默 {
公开:
    整32 m = 41;
    函数 取m() -> 整32 { 返回 m; }
}

类 带造 {
公开:
    整32 值 = 7;
    整32 只读 = 21;
    函数 带造() { 值 = 9; }
    函数 取只读() -> 整32 { 返回 只读; }
}

类 基q {
公开:
    整32 x = 11;
    函数 基q() { x = 12; }
    函数 取x() -> 整32 { 返回 x; }
}

类 派q : 基q {
公开:
    整32 y = 22;
    函数 派q() { y = 23; }
    函数 取y() -> 整32 { 返回 y; }
}

函数 主() -> 整32 {
    整32 和 = 0;
    带造 b;
    如果 (b.取只读() == 21) { 和 += 1; }
    纯默 p;
    如果 (p.取m() == 41) { 和 += 2; }
    派q q = 派q();
    如果 (q.取x() == 12) { 和 += 4; }
    如果 (q.取y() == 23) { 和 += 8; }
    返回 和;
}
