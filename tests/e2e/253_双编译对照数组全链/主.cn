// E2E 253：数组全链双编译对照（plans/020 移植纪律 9 第二十一个对照用例）
//   94-a（2026-09-13 第九十四轮）：v2 栈数组全链落地（规格书 3.5 `类型[长度] 名`）
//   的门禁件——同一源码两侧各编各跑，退出码须一致（宿主侧 == 用例期望值）。
//   八形态（两侧共有语义面）：
//     ① 声明 + 初始化列表读（数组 C 布局多槽 + 逐元素 store）
//     ② 部分初始化补零（宿主「部分初始化补零」同构）
//     ③ 下标写（左值路径：基址 + i×元素步进）
//     ④ 循环动态下标求和（运行期索引缩放）
//     ⑤ 数组作实参退化（数组名 = 元素指针，形参 整32*）
//     ⑥ 结构体元素数组成员访问（表[0].x 读写：元素地址 = 基址+i×结构体大小；
//        左值顺序链中间跳下标步进——原缺此分支则索引静默归零）
//     ⑦ 字符串元素数组（元素=指针 8 字节；下标读=借用视图 + 字符串复制拥有化）
//     ⑧ 浮点元素数组（元素宽度 8；下标读改 + 打印浮点分派）
//   安全性：数组下标越界检查（下标 >= 长度 → 运行时错误(2) 数组越界，
//     与宿主 ir.cpp 同码）——负测由同目录 主2.cn 承载（不参与校验和）。
//   退出码 = 八形态折校验和 255（①1+②2+③4+④8+⑤16+⑥32+⑦64+⑧128 全对）。
//   宿主侧 == 用例期望值；v2 侧 == 宿主侧实测值（等价性判据）。
结构体 分数行 {
    整32 语文;
    整32 数学;
}

函数 求和(整32* 表, 整32 个数) -> 整32 {
    整32 和 = 0;
    整32 i = 0;
    当 (i < 个数) {
        和 = 和 + 表[i];
        i++;
    }
    返回 和;
}

// ① 声明 + 初始化列表读
函数 形一() -> 整64 {
    整32[5] 数据 = { 1, 2, 3, 4, 5 };
    如果 (数据[0] == 1 && 数据[4] == 5 && 数据[2] == 3) { 返回 1; }
    返回 0;
}

// ② 部分初始化补零
函数 形二() -> 整64 {
    整32[4] 表 = { 7, 8 };
    如果 (表[0] == 7 && 表[1] == 8 && 表[2] == 0 && 表[3] == 0) { 返回 2; }
    返回 0;
}

// ③ 下标写
函数 形三() -> 整64 {
    整32[3] 表;
    表[0] = 10;
    表[1] = 20;
    表[2] = 30;
    如果 (表[0] == 10 && 表[1] == 20 && 表[2] == 30) { 返回 4; }
    返回 0;
}

// ④ 循环动态下标求和
函数 形四() -> 整64 {
    整32[5] 表 = { 2, 4, 6, 8, 10 };
    整32 和 = 0;
    整32 i = 0;
    当 (i < 5) {
        和 = 和 + 表[i];
        i++;
    }
    如果 (和 == 30) { 返回 8; }
    返回 0;
}

// ⑤ 数组作实参退化（元素指针）
函数 形五() -> 整64 {
    整32[4] 表 = { 3, 5, 7, 9 };
    如果 (求和(表, 4) == 24) { 返回 16; }
    返回 0;
}

// ⑥ 结构体元素数组成员访问（读 + 写）
函数 形六() -> 整64 {
    分数行[2] 行;
    行[0].语文 = 88;
    行[0].数学 = 66;
    行[1].语文 = 77;
    行[1].数学 = 99;
    如果 (行[0].语文 == 88 && 行[0].数学 == 66 &&
          行[1].语文 == 77 && 行[1].数学 == 99) { 返回 32; }
    返回 0;
}

// ⑦ 字符串元素数组（借用视图 + 拥有化复制）
函数 形七() -> 整64 {
    字符串[3] 名 = { "甲", "乙", "丙" };
    字符串 取 = 字符串复制(名[1]);
    如果 (字符串比较(取, "乙") && 字符串长度(名[2]) == 3) { 返回 64; }
    返回 0;
}

// ⑧ 浮点元素数组
函数 形八() -> 整64 {
    浮64[3] 表 = { 1.5, 2.5, 3.5 };
    浮64 和 = 表[0] + 表[2];
    表[1] = 9.5;
    如果 (和 == 浮64(5.0) && 表[1] == 浮64(9.5)) { 返回 128; }
    返回 0;
}

函数 主() -> 整32 {
    整64 校验 = 形一() + 形二() + 形三() + 形四() +
                 形五() + 形六() + 形七() + 形八();
    打印("校验和=", 校验);
    返回 整32(校验 % 256);
}
