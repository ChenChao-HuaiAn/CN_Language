公开:
导入 依赖;
类 盒 {
公开:
    整64 错误码;
    函数 盒() {
        错误码 = 0;
    }
    // #1589 三形态（错误/正常/某些）均以**撞名隐式成员** 错误码 作构造器载荷：
    //   修前「枚举名裸标识符跳过」吞掉字段读 → 弹栈错位 → 构造器走普通调用发
    //   EXTERN（?错误@@Y 等）→ LNK2019；修后 字段绑定优先 = 宿主内联装箱。
    不安全 函数 取值(整64 甲) -> 结果<整64, 整32> {
        如果 (甲 != 0) {
            错误码 = 2;
            返回 错误(整32(错误码));
        }
        返回 正常(甲);
    }
    不安全 函数 取可选(整64 甲) -> 可选<整32> {
        错误码 = 3;
        返回 某些(整32(错误码));
    }
    不安全 函数 取正(整64 甲) -> 结果<整32, 整32> {
        错误码 = 甲;
        返回 正常(整32(错误码));
    }
}
