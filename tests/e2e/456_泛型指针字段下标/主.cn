// 456_泛型指针字段下标：泛型类 T* 字段 下标读写 最小复现（433-b·撤守卫攻坚）
// 旧行为：撤守卫下 追加 内 store 崩溃（r10=0=字段值未写入/重载错位）
泛型 <类型 T>
类 盒堆 {
    T* 槽;
    整64 数量;
    整64 容量;
公开:
    不安全 函数 盒堆() {
        槽 = 无;
        数量 = 0;
        容量 = 0;
    }

    不安全 函数 放入(T 值) {
        如果 (数量 == 容量) {
            整64 新容量 = 容量 * 2;
            如果 (新容量 == 0) {
                新容量 = 4;
            }
            槽 = 分配(新容量 * 8);
            容量 = 新容量;
        }
        槽[数量] = 值;
        数量++;
    }

    常量 函数 取(整64 i) -> T {
        返回 槽[i];
    }
}

函数 主() -> 整32 {
    盒堆<整64> 堆;
    堆.放入(7);
    堆.放入(20);
    返回 堆.取(0) + 堆.取(1);   // 退出码 27
}
