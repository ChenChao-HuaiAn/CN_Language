// E2E 1559_结果异型错误载荷条件释放（#1604·1592 审计）：
//   结果<整32,字符串> 的 E=字符串 错误载荷条件释放/深拷——值/错误 共用联合体
//   槽：正常态错误槽=T 数值载荷（摘句柄 free=UB），仅错误态槽内=字符串句柄。
//   原 ownedStrFieldsOf 只收 T 面：错误载荷漏收（泄漏）或落通用递归被收为
//   无条件字段（正常态把数值当句柄释放=崩）。锁面：正常态析构不崩、错误态
//   释放不双释放、整体赋值深拷独立（值语义）、活动分配数守恒（泄漏锁——
//   字面量=驻留指针 free 无害化，守恒锁面须用 字符串复制 堆串源）。
导入 测试框架::{测试器, 运行用例, 断言真, 断言相等整数, 断言相等文本, 测试汇总};

不安全 函数 造析构错误一次() -> 空类型 {
    // 声明位 字符串复制=拥有串（白名单内建·堆分配）——错误() move 接管（
    //   70-a 扩错误面：源槽清零），函数尾错误槽释放
    结果<整32,字符串> 甲 = 错误(字符串复制("泄漏探针"));
}

不安全 函数 赋值析构错误一对() -> 空类型 {
    结果<整32,字符串> 甲 = 错误(字符串复制("成对"));
    结果<整32,字符串> 乙 = 甲;
    // 声明位整体拷贝深拷：错误载荷须独立副本（值语义）——修前漏深拷=共享
    //   句柄且双方析构漏收 → 泄漏 1；修后 独立副本+各自释放 → 守恒 0
}

不安全 函数 用例正常态不误释放(测试器* 器) {
    结果<整32,字符串> 甲 = 正常(42);
    断言真(器, 甲.正常, "正常态构造");
    如果 (甲.正常) {
        断言相等整数(器, 整64(甲.值), 42, "正常态值载荷");
    }
    // 函数返回=块出口释放：正常态错误槽=数值 42，反相摘句柄须返回空（不崩）
}

不安全 函数 用例错误态释放(测试器* 器) {
    结果<整32,字符串> 甲 = 错误("爆炸");
    断言真(器, !甲.正常, "错误态构造");
    如果 (!甲.正常) {
        断言相等文本(器, 甲.错误, "爆炸", "错误态载荷读取");
    }
    // 函数返回释放错误态载荷（反相条件摘句柄；字面量=驻留指针 free 无害化）
}

不安全 函数 用例错误载荷深拷独立(测试器* 器) {
    结果<整32,字符串> 甲 = 错误(字符串复制("原始"));
    结果<整32,字符串> 乙 = 甲;
    // 整体拷贝深拷：错误载荷须独立副本——修前共享句柄，乙 重新赋值 preFree
    //   释放共享串 → 甲.错误 悬垂（垃圾/崩）
    乙 = 错误("改写");
    如果 (!甲.正常) {
        断言相等文本(器, 甲.错误, "原始", "深拷后源错误载荷独立");
    }
    如果 (!乙.正常) {
        断言相等文本(器, 乙.错误, "改写", "目标错误载荷改写");
    }
}

不安全 函数 用例正常态重赋值不崩(测试器* 器) {
    结果<整32,字符串> 丙 = 正常(7);
    丙 = 错误("污染");
    // 重赋值 preFree：正常态错误槽=数值 7，无条件/正相摘句柄=free(7) 崩——
    //   反相条件（tag 为 0 才摘）正常态必须空安全跳过
    如果 (!丙.正常) {
        断言相等文本(器, 丙.错误, "污染", "重赋值后错误载荷");
    }
    丙 = 正常(9);
    如果 (丙.正常) {
        断言相等整数(器, 整64(丙.值), 9, "再赋正常态值载荷");
    }
}

不安全 函数 用例循环交替构造析构(测试器* 器) {
    整32 序 = 0;
    当 (序 < 8) {
        结果<整32,字符串> 盒 = 正常(序);
        如果 (!盒.正常) {
            盒 = 错误("轮次占位");
        }
        断言真(器, 盒.正常, "循环内正常态");
        序 = 序 + 1;
    }
    // 每轮块出口释放：正常/错误 交替路径的槽复用+清槽幂等
    断言相等整数(器, 整64(序), 8, "循环完成");
}

不安全 函数 用例错误载荷释放守恒(测试器* 器) {
    整64 基线 = 内存::活动分配数();
    造析构错误一次();
    整64 余留 = 内存::活动分配数() - 基线;
    // 泄漏锁：堆串 move 进错误槽+函数尾反相释放——漏收/漏 move 双漏=0 分配
    //   0 释放亦守恒，故本锁与 深拷守恒 锁面互补（本锁防错释放·彼锁防漏收）
    断言相等整数(器, 余留, 0, "错误载荷 move+释放守恒");
}

不安全 函数 用例整体赋值深拷守恒(测试器* 器) {
    整64 基线 = 内存::活动分配数();
    赋值析构错误一对();
    整64 余留 = 内存::活动分配数() - 基线;
    // 泄漏锁：构造 1 分配+声明位深拷 1 分配-析构 2 释放=0——修前漏深拷漏
    //   析构（共享句柄无人释放）=余留 1（红）；修后守恒 0（绿）
    断言相等整数(器, 余留, 0, "整体赋值深拷析构守恒");
}

不安全 函数 主() -> 整32 {
    测试器 器 = 测试器();
    运行用例(器, "正常态不误释放", 用例正常态不误释放);
    运行用例(器, "错误态释放", 用例错误态释放);
    运行用例(器, "错误载荷深拷独立", 用例错误载荷深拷独立);
    运行用例(器, "正常态重赋值不崩", 用例正常态重赋值不崩);
    运行用例(器, "循环交替构造析构", 用例循环交替构造析构);
    运行用例(器, "错误载荷释放守恒", 用例错误载荷释放守恒);
    运行用例(器, "整体赋值深拷守恒", 用例整体赋值深拷守恒);
    返回 整32(测试汇总(器));
}
