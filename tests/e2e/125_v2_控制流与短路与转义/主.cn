导入 容器::向量

// E2E 125（v2 三缺陷根治验证：中途回退穿透 / 短路求值 / 字符串转义，2026-09-02）：
//   缺陷A：IR_返回 后跳函数尾块（epilogue 唯一）——中途 返回 不再穿透到后续
//     语句（旧：控制流落入后续代码，最后的 返回 覆盖返回值，中途返回(5) 得 199）。
//   缺陷B：&& / || 规范 930 短路求值（旧：按 IR_相等 发射——0&&0 误判真；
//     右操作数急切求值——除零右操作数直接崩溃）。结果规范化为 0/1（对标 C 语义）。
//   缺陷C：字符串字面量转义实时反转义 \n \t \r \0 \" \' \\（旧：原样收集
//     两字符）。本用例作编译期回归（词法/strData 字节路径）；内容级运行时断言
//     依赖 内置函数符号映射（③ 前特性），暂以 容器追加 通路覆盖发射路径。
//   断言失败提前返回 201~217；全部通过 返回 0。
函数 中途返回(整64 输入) -> 整64 {
    如果 (输入 == 5) { 返回 101 }
    返回 199
}

函数 循环中途返回(整64 上限) -> 整64 {
    整64 i = 0
    整64 和 = 0
    当 (i < 上限) {
        如果 (i == 3) { 返回 和 }
        和 = 和 + i
        i++
    }
    返回 0 - 1
}

函数 嵌套终止(整64 a) -> 整64 {
    如果 (a > 0) {
        如果 (a > 10) { 返回 1 }
        返回 2
    }
    返回 3
}

函数 主() -> 整32 {
    // —— 缺陷A：函数中途 返回（如果 真块 / 当 循环体 / 嵌套块）——
    如果 (中途返回(5) != 101) { 返回 201 }
    如果 (中途返回(7) != 199) { 返回 202 }
    如果 (循环中途返回(10) != 3) { 返回 203 }
    如果 (嵌套终止(20) != 1) { 返回 204 }
    如果 (嵌套终止(5) != 2) { 返回 205 }
    如果 (嵌套终止(0) != 3) { 返回 206 }
    // —— 缺陷B：短路求值 ——
    整64 零 = 0
    如果 (零 && 零) { 返回 207 }
    整64 x = 零 && 9
    如果 (x != 0) { 返回 208 }
    整64 y = 3 || 零
    如果 (y != 1) { 返回 209 }
    整64 z = 5 && 7
    如果 (z != 1) { 返回 210 }
    // 短路本质：除零右操作数在左为假时不得求值（旧：急切求值直接崩溃）
    整64 除数 = 0
    如果 (除数 != 0 && 10 / 除数 > 2) { 返回 211 }
    // 嵌套与优先级（&& 层2 高于 || 层1；括号子表达式）
    整64 标记 = 0
    如果 (零 || (3 && 4)) { 标记 = 1 } 否则 { 标记 = 2 }
    如果 (标记 != 1) { 返回 212 }
    如果 (零 && 零 || 5) { 标记 = 3 } 否则 { 标记 = 4 }
    如果 (标记 != 3) { 返回 213 }
    如果 (2 > 1 && 3 > 2) { 标记 = 5 } 否则 { 标记 = 6 }
    如果 (标记 != 5) { 返回 214 }
    // —— 缺陷C：转义（编译期回归：词法反转义 + strData 字节发射）——
    向量<字符串> 表 = 向量<字符串>()
    结果<空类型, 整32> 加 = 表.追加("a\nb\tc\"d\\e")
    如果 (!加.正常) { 返回 215 }
    结果<空类型, 整32> 加2 = 表.追加("行1\n行2")
    如果 (!加2.正常) { 返回 216 }
    如果 (表.大小() != 2) { 返回 217 }
    返回 0
}
