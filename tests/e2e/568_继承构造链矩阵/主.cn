// 任务 117：类继承构造链整链缺失根治——正测矩阵（宿主侧·v2 解析层显式
// 拒绝类继承=既有设计，本例挂 021 002/C24 双测欠账）
// 覆盖形态：①单级自动链（子类自写构造·无列表）②多级隐式自动链（全无列表）
//   ③④显式初始化列表（带实参/空参靠父默认参·D23）⑤多级显式全列表
//   （117 乙：ownerClass 误配根治——原中段父构造体整丢）⑥隐式子类（子类
//   不写构造=实例化点补链）⑦中间层无构造（walk-up 跨隐式层）
//   ⑧析构链 LIFO 回归（构造链补全后析构序不变）
// 语义依据：spec 06 §三「与C++同名构造/析构语义一致」——派生构造器无显式
//   初始化列表时自动调用基类默认构造；基类无默认构造=编译期硬错误（567 负测）
// 打印语义：打印=println（自动换行）

// 形态①⑥⑧共用基类
类 动物 {
公开:
    整32 腿数;
    函数 动物() { 腿数 = 4; 打印("[动物构造]"); }
    函数 ~动物() { 打印("[~动物]"); }
}
类 狗 : 动物 {
公开:
    整32 叫次数;
    函数 狗() { 叫次数 = 3; 打印("[狗构造]"); }
    函数 ~狗() { 打印("[~狗]"); }
}
// 形态⑥：子类不写任何构造
类 猫 : 动物 {
公开:
}

// 形态②：三级全无列表（多级隐式自动链）
类 祖甲 {
公开:
    整32 a;
    函数 祖甲() { a = 1; 打印("[祖甲构造]"); }
}
类 父甲 : 祖甲 {
公开:
    整32 b;
    函数 父甲() { b = 2; 打印("[父甲构造]"); }
}
类 子甲 : 父甲 {
公开:
    整32 c;
    函数 子甲() { c = 3; 打印("[子甲构造]"); }
}

// 形态⑤：三级显式全列表（原中段丢失根治）
类 祖乙 {
公开:
    整32 a;
    函数 祖乙(整32 v) { a = v; 打印("[祖乙构造] a=", a); }
}
类 父乙 : 祖乙 {
公开:
    整32 b;
    函数 父乙(整32 v) : 祖乙(v) { b = v * 2; 打印("[父乙构造] b=", b); }
}
类 子乙 : 父乙 {
公开:
    整32 c;
    函数 子乙(整32 v) : 父乙(v) { c = v * 3; 打印("[子乙构造] c=", c); }
}

// 形态③④：显式初始化列表（带实参/空参靠父默认参）
类 命名 {
公开:
    字符串 名;
    函数 命名(字符串 n = "默认名") { 名 = n; 打印("[命名构造] ", 名); }
}
类 呢称 : 命名 {
公开:
    函数 呢称() : 命名() { 打印("[呢称构造]"); }
}

// 形态⑦：中间层无构造（walk-up 跨隐式层）
类 根 {
公开:
    整32 r;
    函数 根() { r = 7; 打印("[根构造]"); }
}
类 茎 : 根 {
公开:
    整32 s;
}
类 叶 : 茎 {
公开:
    函数 叶() { 打印("[叶构造]"); }
}

函数 主() -> 整32 {
    // 形态①⑧：单级自动链 + 析构 LIFO（块作用域触发）
    {
        狗 d = 狗();
        打印("腿数=", d.腿数, " 叫次数=", d.叫次数);
    }
    打印("[狗作用域结束]");

    // 形态⑥：隐式子类（不写构造）
    {
        猫 m = 猫();
        打印("猫腿数=", m.腿数);
    }
    打印("[猫作用域结束]");

    // 形态②：多级隐式自动链
    子甲 s1 = 子甲();
    打印("甲链: a=", s1.a, " b=", s1.b, " c=", s1.c);

    // 形态⑤：多级显式全列表（原中段父构造体丢失根治）
    子乙 s2 = 子乙(5);
    打印("乙链: a=", s2.a, " b=", s2.b, " c=", s2.c);

    // 形态③④：显式列表（空参靠父默认参）
    呢称 n = 呢称();
    打印("名=", n.名);

    // 形态⑦：中间层无构造（walk-up）
    叶 l = 叶();
    打印("walk-up: r=", l.r, " s=", l.s);
    返回 0;
}
