// 1405_引用参数读值类型码全量对齐（1121 审查 P1-1 转正·双编译对照）
// 病（v2 单侧）：引用参数读值（发射引用参数读 -> 引用参数值码）修前只精化
//   浮64/字符串，其余宽类型落 T_整64 兜底：
//   · 正64& 读值按有符号分派——大值 x/2 输出 0（宿主 9223372036854775807）、
//     x>>1 输出 -1（宿主 9223372036854775807）、x>100 误判「不大于100」、
//     打印(x) 输出 -1（宿主 18446744073709551615）；
//   · 字符*& 读值走 __cn_print_int 打指针整数（宿主按借用视图 print_str「指针串」）。
// 修法：引用参数值码 剥尾 '&' 后走**类型码 全量映射**（与 1036 引用返回通道
//   同口径：T_未知/T_空类型 不登记）；已到达类型全等价或修正，未知类型仍
//   落 T_整64 合法终态。写通道（引用参数存储码）不受影响。
// 本用例=同族全谱锚：正64/字符*/整64/正32/浮64/布尔/字符 七形态引用读值。
函数 看正64(正64& x) -> 整32 {
    打印(x / 2);
    打印(x >> 1);
    如果 (x > 100) { 打印("大于100"); } 否则 { 打印("不大于100"); }
    打印(x);
    返回 0;
}

函数 看字符视图(字符*& p) -> 整32 {
    打印(p);
    返回 0;
}

函数 看整64(整64& x) -> 整32 {
    打印(x / 2);
    打印(x > 100);
    返回 0;
}

函数 看正32(正32& x) -> 整32 {
    打印(x / 2);
    打印(x > 100);
    返回 0;
}

函数 看浮64(浮64& f) -> 整32 {
    打印(f);
    返回 0;
}

函数 看布尔(布尔& b) -> 整32 {
    打印(b);
    返回 0;
}

函数 看字符(字符& c) -> 整32 {
    打印(c);
    返回 0;
}

函数 主() -> 整32 {
    // ① 正64& 大值：无符号除法/移位/比较/打印全链
    正64 甲 = 18446744073709551615;
    看正64(甲);

    // ② 字符*& 借用视图：打印走字符串分派（非指针整数）
    字符* 串 = "指针串";
    看字符视图(串);

    // ③ 整64& 有符号对照（既有 T_整64 面零变化）
    整64 乙 = 9000000000;
    看整64(乙);

    // ④ 正32&（读码窄直通·无符号）
    正32 丙 = 4000000000;
    看正32(丙);

    // ⑤ 浮64&（1030 既有精化面回归）
    浮64 丁 = 1.5;
    看浮64(丁);

    // ⑥ 布尔&/字符&（读码窄直通回归）
    布尔 戊 = 真;
    看布尔(戊);
    字符 己 = 'Z';
    看字符(己);
    返回 0;
}
