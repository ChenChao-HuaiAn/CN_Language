// 689 三元与短路求值面（001 §4.5 优先级表·三元右结合/惰性求值；&&优先级3>||优先级2）
// 期望手算：三元右结合 真?1:(假?2:3)=1；假?1:(真?2:3)=2
//   惰性：未选分支自增不执行→计数保持 0；&&短路左假右不执行；||短路左真右不执行
//   §4.5 优先级：&(6)>^(5)>|(4)>&&(3)>||(2)——&& 低于 |（与 C 同）；&& 要求布尔操作数
静态 整32 计数 = 0;

不安全 函数 自增() -> 整32 {
    计数 = 计数 + 1;
    返回 9;
}

不安全 函数 主() -> 整32 {
    打印(真 ? 1 : 假 ? 2 : 3);        // 1（右结合）
    打印(假 ? 1 : 真 ? 2 : 3);        // 2
    打印(真 ? 5 : 自增());             // 5（惰性·自增不执行）
    打印(计数);                        // 0
    布尔 与果 = (1 > 2) && (自增() > 0);  // 短路·右侧不执行
    打印(与果 ? 1 : 0);                // 0
    打印(计数);                        // 0
    布尔 或果 = (3 > 2) || (自增() > 0);  // 短路·右侧不执行
    打印(或果 ? 1 : 0);                // 1
    打印(计数);                        // 0
    打印((1 | 2) == 3 ? 1 : 0);        // 1（位或=3·显式括号）
    打印(计数);                        // 0
    返回 0;
}
