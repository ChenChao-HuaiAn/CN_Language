// E2E 938（2026-10-14·#728z 判性收口锁面·双编译对照）：类静态字段访问全形态锁
//   ——v2 静态存储通道（070 波G 静态写/读分支）+ 728b 读三元组静态守卫
//   （d8be899f 面③：「对象=用户类名且字段=类静态字段」实例三元组整段跳过，
//   静态字段不入实例字段/宽度表——原误入查宽度码=648 miss「字段宽度码·字段
//   未登记」×4 中止·108_H7 存量红根源）的修复面固化，防回退。
//   缺陷史：#728z（543 轮立项）「计数站.静态字段 形态 v2 误走实例字段宽度查询
//   →648 miss 显形中止」——本轮判性：develop 已由 728b 根治（108_H7 PASS+
//   本用例全形态双侧绿实证），728z 零代码改动·锁面交付。
//   退出码=八形态折校验和 255（①1 ②2 ③4 ④8 ⑤16 ⑥32 ⑦64 ⑧128）：
//   任一形态分叉（中止/丢值/共享错槽）→ 校验位丢失 → 对照失败。
//   形态面：①静态写+读 ②窄类型（整32）③复合 +=/-= ④方法内裸名读写
//   ⑤方法内跨类 限定访问 ⑥布尔静态 ⑦多语句序列守恒 ⑧静态初值非零。
类 计数站 {
公开:
    静态 整64 总数 = 100;
    静态 整32 窄数 = 0;
    静态 布尔 旗 = 真;
    函数 自增() -> 空类型 {
        总数 = 总数 + 1;
    }
}

类 工具 {
公开:
    静态 整64 步长 = 10;
    函数 加步() -> 空类型 {
        计数站.总数 = 计数站.总数 + 工具.步长;
    }
}

函数 主() -> 整32 {
    整32 校验 = 0;
    // ① 静态写+读（类名.字段 = 值；初值 100 被覆盖）
    计数站.总数 = 5;
    如果 (计数站.总数 == 5) { 校验 = 校验 + 1; }
    // ② 窄类型静态（整32 静态槽）
    计数站.窄数 = 7;
    如果 (计数站.窄数 == 7) { 校验 = 校验 + 2; }
    // ③ 复合赋值 += / -=（静态目标读-算-写回）
    计数站.总数 = 10;
    计数站.总数 += 5;
    计数站.总数 -= 3;
    如果 (计数站.总数 == 12) { 校验 = 校验 + 4; }
    // ④ 方法内裸名访问本类静态（当前方法类名ID 通道）
    计数站 甲;
    甲.自增();
    甲.自增();
    如果 (计数站.总数 == 14) { 校验 = 校验 + 8; }
    // ⑤ 方法内跨类限定访问（计数站.总数 与 工具.步长 双静态同语句）
    工具 乙;
    乙.加步();
    如果 (计数站.总数 == 24) { 校验 = 校验 + 16; }
    // ⑥ 布尔静态（真初值读取）
    如果 (计数站.旗) { 校验 = 校验 + 32; }
    // ⑦ 多语句序列守恒（连写连读不串槽）
    计数站.总数 = 1;
    计数站.窄数 = 2;
    如果 (计数站.总数 == 1 && 计数站.窄数 == 2) { 校验 = 校验 + 64; }
    // ⑧ 静态初值非零读取（工具.步长=10 声明初值·未被后续写污染）
    如果 (工具.步长 == 10) { 校验 = 校验 + 128; }
    打印("938 校验和: ", 校验);
    返回 校验;
}
