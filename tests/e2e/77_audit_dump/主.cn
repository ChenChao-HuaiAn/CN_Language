导入 容器::向量;
导入 文件::打开文件;
导入 文件::读取文件行;
导入 文件::关闭文件;
导入 CN语言编译器::词法分析;
导入 CN语言编译器::语法分析;
导入 CN语言编译器::语义分析;
导入 CN语言编译器::IR生成;
导入 CN语言编译器::代码生成;

函数 读全部(空类型* 句柄) -> 字符串 {
    字符串 全部 = "";
    结果<字符串, 整32> 行结果 = 读取文件行(句柄);
    当 (真) {
        如果 (行结果.正常) {
            全部 = 全部 + 行结果.值;
        } 否则 {
            中断;
        }
        行结果 = 读取文件行(句柄);
    }
    返回 全部;
}

函数 打印行表(向量<字符串> 行表) -> 空类型 {
    整64 i = 0;
    当 (i < 行表.大小()) {
        打印(行表.元素(i));
        i++;
    }
}

函数 主() -> 整32 {
    结果<空类型*, 整32> 打开结果 = 打开文件("tests/e2e/77_audit_dump/样例.cn", 1);
    如果 (打开结果.正常) {
        字符串 源码 = 读全部(打开结果.值);
        关闭文件(打开结果.值);
        向量<字符串> IR行 = IR生成(源码, "样例");
        打印("== IR ==");
        打印行表(IR行);
        向量<字符串> asm行 = 代码生成(IR行);
        打印("== ASM ==");
        打印行表(asm行);
        返回 0;
    } 否则 {
        打印("打开失败");
        返回 1;
    }
}
