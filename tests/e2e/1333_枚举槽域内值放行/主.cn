// E2E 1333（2026-10-18·任务 #756 正测·dual 输出对照）：枚举槽 i32 域内值全形态
//   放行 + 超 i32 域成员的常量形态/显式承接不回归（728n 闸门两态纪律·945 同源
//   锁面扩展：域内边界值 -2147483648/2147483647 + 静态/字段/赋值/返回面）。
//   判据口径=枚举按整32存储（值域门槛只拦超 i32 域常量直存；域内零翻转）。
枚举 极值 {
    甲 = -2147483648,            // 整32 最小值（i32 域内下边界）
    乙 = 2147483647,             // 整32 最大值（i32 域内上边界）
    丙 = -1,
    丁 = -9223372036854775808,   // 超 i32 域（常量形态专用）
    戊 = 9223372036854775807,    // 超 i32 域
}
结构体 匣 { 极值 槽; 整64 标; }
函数 回丙() -> 极值 {
    返回 极值.丙;
}
函数 主() -> 整32 {
    极值 局部 = 极值.甲;         // 声明初始化（下边界·放行）
    极值 次 = 极值.乙;           // 声明初始化（上边界·放行）
    局部 = 极值.丙;              // 赋值（域内·放行）
    静态 极值 局部静 = 极值.甲;   // 函数内静态（域内·放行）
    匣 盒 = 匣{ 槽 = 极值.甲, 标 = 2 };
    盒.槽 = 极值.丙;             // 字段赋值（域内·放行）
    极值 回 = 回丙();            // 返回面（域内·放行）
    整64 宽 = 极值.丁;           // 超域成员→整64 槽（宽化承接·放行）
    打印(局部);                  // -1（赋值后）
    打印(次);                    // 2147483647
    打印(局部静);                // -2147483648
    打印(盒.槽);                 // -1
    打印(回);                    // -1
    打印(极值.丁);               // -9223372036854775808（945 常量形态·直用放行）
    打印(整64(极值.戊));          // 9223372036854775807（显式转换形态放行）
    打印(宽);                    // -9223372036854775808
    返回 0;
}
