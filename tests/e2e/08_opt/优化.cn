// Task 2.6 优化器 E2E 测试
// 覆盖：常量折叠（整型算术/位运算/比较/浮点）、死代码消除（结果未使用的纯指令）
// 说明：本用例在 -O1 下编译，常量表达式在编译期计算，死代码被删除；
//       输出必须与 -O0 完全一致（规格书12.4 优化正确性）
// 语法依据（cn-language-spec）：表达式语句（结果未使用的表达式）、打印行整数/打印行浮点

函数 主() -> 整32 {
    // ---- 1. 整型算术常量折叠 ----
    打印行("2+3: ")
    打印行整数(2 + 3)              // 5
    打印行("10-4: ")
    打印行整数(10 - 4)             // 6
    打印行("6*7: ")
    打印行整数(6 * 7)              // 42
    打印行("100/5: ")
    打印行整数(100 / 5)            // 20
    打印行("17%5: ")
    打印行整数(17 % 5)             // 2

    // ---- 2. 位运算常量折叠 ----
    打印行("12&10: ")
    打印行整数(12 & 10)            // 8
    打印行("12|10: ")
    打印行整数(12 | 10)            // 14
    打印行("12^10: ")
    打印行整数(12 ^ 10)            // 6
    打印行("1<<4: ")
    打印行整数(1 << 4)             // 16
    打印行("256>>4: ")
    打印行整数(256 >> 4)           // 16

    // ---- 3. 比较常量折叠（条件寄存器挂在块内最后一条指令上，验证折叠后分支正确）----
    如果 (3 < 5) { 打印行("比较3<5: 正确") } 否则 { 打印行("比较3<5: 错误") }
    如果 (7 >= 9) { 打印行("比较7>=9: 错误") } 否则 { 打印行("比较7>=9: 正确") }

    // ---- 4. 浮点常量折叠 ----
    打印行("1.5+2.25: ")
    打印行浮点(1.5 + 2.25)         // 3.750000
    打印行("7.5/2.0: ")
    打印行浮点(7.5 / 2.0)          // 3.750000
    打印行("10.0-3.5: ")
    打印行浮点(10.0 - 3.5)         // 6.500000

    // ---- 5. 死代码消除（结果未使用的表达式，-O1 下删除，输出不变）----
    // 注：表达式语句须以分号结束（CN 语言可选分号；分号避免下一行 '('
    //     被误吸收为函数调用参数）
    变量 x = 100
    变量 y = 200
    x + 1;                         // 结果未使用 -> DCE 删除
    y * 2;                         // 结果未使用 -> DCE 删除
    (x + y) / 2;                   // 结果未使用 -> DCE 删除
    打印行("死代码后: 存活")
    打印行整数(x)                  // 100（x 仍被使用，保留）

    返回 0
}
