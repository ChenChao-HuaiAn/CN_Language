// 319-a（B12 甲·T27 根治）：INT_MIN/-1 与 INT_MIN%-1 全位宽两补码统一回绕——
//   原 x86 idiv 溢出陷阱 SIGFPE 崩溃（O0）与 O3 静默回绕的级别分叉；
//   语义：x/-1 ≡ -x（回绕）、x%-1 ≡ 0；O0=O3 逐字节一致。
函数 主() -> 整32 {
    // 整32
    整32 a32 = -2147483648;
    打印(a32 / -1);
    打印(a32 % -1);
    // 整64（变量面）
    整64 a64 = -9223372036854775808;
    打印(a64 / -1);
    打印(a64 % -1);
    // 普通负值（非 MIN）语义正确性对照
    整32 b32 = -100;
    打印(b32 / -1);
    打印(b32 % -1);
    打印(b32 / 3);
    打印(b32 % 3);
    返回 0;
}
