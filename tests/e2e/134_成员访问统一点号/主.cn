// E2E 134_成员访问统一点号（v2.1 语法规范变更，2026-09-03 用户裁决）
// 变更：废除 -> 成员访问（对齐 Rust/Go 与旧版 Rust 风格 CN）——成员访问统一 "."
//   且指针自动解引用一级（p.字段 ≡ (*p).字段，Go 先例）；多级指针不自动解引用
//   （负测锚定见 136）；残留 -> 为硬错误+迁移提示（负测锚定见 135）。
// 实现契约：语义层 visitMemberExpr 按对象类型置 isDerefAccess（IR 层据此选
//   基址：指针值/对象地址）；写回全形态（赋值/自增/自减/复合赋值）走
//   lvalueAddress 统一路径——d6deb6f「写回半实现形态」教训的全形态锚定。
// 本用例：退出码 0 全过；11~20 失败码。
结构体 点 {
    整32 x
    整32 y
}
结构体 外层 {
    点 内
    整32 标记
}
函数 主() -> 整32 {
    // ===== 一、指针读/写（q.x ≡ (*q).x；写经指针写回原对象）=====
    点 p = 点{ x = 10, y = 20 }
    点* q = &p
    如果 (q.x != 10) { 返回 11 }
    q.x = 30
    如果 (p.x != 30) { 返回 12 }
    // ===== 二、写回全形态：自增/自减/复合赋值 =====
    q.x++
    如果 (q.x != 31 || p.x != 31) { 返回 13 }
    q.y--
    如果 (q.y != 19) { 返回 14 }
    q.x += 5
    如果 (p.x != 36) { 返回 15 }
    // ===== 三、嵌套成员经指针（wq.内.x 双级字段读写）=====
    外层 w = 外层{ 内 = 点{ x = 7, y = 8 }, 标记 = 9 }
    外层* wq = &w
    如果 (wq.内.x != 7) { 返回 16 }
    wq.内.y = 100
    如果 (w.内.y != 100) { 返回 17 }
    wq.标记 = 42
    如果 (w.标记 != 42) { 返回 18 }
    // ===== 四、(*q).x 显式解引用等价形态回归 =====
    如果 ((*q).x != 36) { 返回 19 }
    // ===== 五、值对象 . 访问不变式回归 =====
    如果 (p.y != 19) { 返回 20 }
    打印("[134] 成员访问统一点号: 全部通过")
    返回 0
}
