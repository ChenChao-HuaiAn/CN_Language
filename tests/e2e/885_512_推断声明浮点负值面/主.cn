// 885（#512）：推导型变量浮点负值面——原宿主 IR 层对空 typeName 的推断声明
// 仅 FloatLiteral 有浮点分支，表达式形态（浮点二元/一元负号+浮点字面量）兜底
// 整32 槽=浮点值截断（0.0-x 出 -3、-1.0e19 出 -2147483648 实锤）。修=语义层
// 推断分支回填浮点 typeName（46-c 结构体回填/497 字面量定宽同构·浮点窄面），
// IR srcType/槽型/打印分派全链一致；显式 浮64 同值对照锚定既有正确语义。
// 双侧零分叉：v2 语义推导（检查表达式 浮点字面量恒浮64+推导二元类型ID 取左）
// 与 IR 推断声明类型表回填链既有正确——本用例 dual 锁两侧同真值。
函数 求值() -> 浮64 {
    返回 2.25;
}

函数 主() -> 整32 {
    变量 x = 3.5;                // 字面量直推（既有正确锚）
    打印行("x=", x);
    打印("");
    变量 y = 0.0 - x;            // 浮点二元运算推断（缺陷面①）
    打印行("y=", y);
    打印("");
    变量 d = -1.0e19;            // 一元负号+浮点字面量（缺陷面②）
    打印行("d=", d);
    打印("");
    变量 z = 0.5 * 2.0;          // 浮点乘法（缺陷面③·原整槽碰巧 1 形态错）
    打印行("z=", z);
    打印("");
    变量 w = x;                  // 浮点标识符拷贝推断（同一回填面）
    打印行("w=", w);
    打印("");
    变量 m = 求值();             // 浮点调用返回推断（同一回填面）
    打印行("m=", m);
    打印("");
    变量 t = 假 ? 1.5 : 2.75;    // 三元浮点分支推断（同一回填面）
    打印行("t=", t);
    打印("");
    浮64 e = 0.0 - x;            // 显式声明同值对照（既有正确锚）
    打印行("e=", e);
    打印("");
    返回 0;
}
