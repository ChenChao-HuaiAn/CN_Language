// 935 泛型函数实参位构造器推断（570·2026-10-14）
// 立账=106 呈报 H3 残余面（宿主绿·v2 拒「末形参=泛型参数名 T 不认」）：
//   裸语句 包装(某些(5))——v2 实参位期望回取（894）普通函数支路只认
//   结果/可选 具体类型，泛型参数名 T 不认 → 「构造器 某些 须用于 结果/可选
//   语境」误拒（570 核实轮探针A 实录·develop 4832c35a 106 修复未覆盖本面）。
// 修法=v2 894 函数支路接入 泛型函数实参期望类型570（106 成员支路同款清偿·
//   宿主 checkBuiltinCtorCall 无语境自然推导同构：某些(v)=可选<typeof(v)>·
//   正常/错误 缺省位=整32）+415 隐式推导改写扩构造器实参面（实例缺席=
//   链接期未定义符号 LNK2019 实录根治）+894 参数正扫提取归一（基函数形参
//   类型们 体非空布局区间判定错位·判别3 实锤）。
// 锁四面（宿主+v2p 双编译对照·运行输出锚定防假绿）：
//   ① 裸语句 某些（570 台账原形态·读回经 声明位同型）
//   ② 声明位读回（某些→可选$整32·有值/值）
//   ③ 结果族 正常/错误 实参位（缺省位=整32 同款·返回值经 正常 分支检查）
//   ④ 字符串载荷自然推导（某些("串")→可选$字符串）
泛型 <类型 T>
函数 包装(T 值) -> T {
    返回 值;
}

泛型 <类型 T>
函数 吃结果(T 值) -> T {
    返回 值;
}

函数 主() -> 整32 {
    // ① 裸语句（台账原形态）
    包装(某些(5));
    // ② 声明位读回
    可选<整32> 甲 = 包装(某些(6));
    如果 (甲.有值) {
        打印行("甲=", 甲.值);
    } 否则 { 返回 1; }
    // ③ 结果族实参位（正常 显式位 + 错误 位·返回值均按 结果 分支执法消费）
    结果<整32, 整32> 乙 = 吃结果(正常(7));
    如果 (乙.正常) {
        打印行("乙=", 乙.值);
    } 否则 { 返回 2; }
    结果<整32, 整32> 丁 = 吃结果(错误(9));
    如果 (丁.正常) { 返回 4; } 否则 {
        打印行("丁=", 丁.错误);
    }
    // ④ 字符串载荷
    可选<字符串> 丙 = 包装(某些("串"));
    如果 (丙.有值) {
        打印行("丙=", 丙.值);
    } 否则 { 返回 3; }
    返回 0;
}
