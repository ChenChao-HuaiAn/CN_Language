// E2E 1721（#1933·313 篇反思实测新发现·P1）：结果盒载荷字段整体赋值漏释放
//   （#1884 三面之外的第四条缝）——`盒.值.名称 = 串`（载荷=类·类含字符串字段）
//   每次赋值泄漏 1 个旧串分配。病灶=「结果盒载荷字段赋值位」的发射通道漏了
//   「旧值先释放再覆盖」（对照：普通类对象同款赋值走 handleClassMemberAssign
//   identRecv 分流残留=0 正常）。
//   判据=内存::活动分配数 差值守恒：赋值 N 次（源=落堆串），活动分配数残留
//   必须=0。修前实测：盒段残留 10（每轮泄 1）、可选段同病（累计 20）、
//   结构体嵌套链同判据缺失（累计 30）——修后四段全 0。
//   双侧同源：宿主 memberStringFieldAssign/handleClassMemberAssign 释放判据
//   只认「标识符接收者」，成员链接收者保守跳过；v2 发射成员串字段写入同判据
//   （对象=标识符才真）——同刀扩「链宿主拥有」判定（盒面以盒拥有载荷为条件·
//   借用盒宁漏勿错防双删）。
类 货物 {
公开:
    字符串 名称;
    整64 数;
    函数 货物() {
        名称 = "";
        数 = 0;
    }
    函数 货物(货物& 其他) {
        名称 = 字符串复制(其他.名称);
        数 = 其他.数;
    }
    不安全 函数 ~货物() {
    }
}

结构体 里层 {
    字符串 名;
}

结构体 芯盒 {
    里层 里;
    整64 数;
}

不安全 函数 主() -> 整32 {
    整64 基线 = 内存::活动分配数();
    {
        // 对照面：普通类对象字段赋值（标识符接收者·既有释放分流恒绿）
        货物 对象;
        对象.名称 = 字符串复制("初串甲");
        整32 i = 0;
        当 (i < 10) {
            对象.名称 = 字符串复制("改串乙");
            i = i + 1;
        }
        如果 (!字符串比较(对象.名称, "改串乙")) { 打印("对照值错"); 返回 1; }
    }
    整64 对照差 = 内存::活动分配数() - 基线;
    打印("对照残留=" + 整数转字符串(对照差));
    {
        // 本案面一：结果盒载荷字段赋值（盒.值.名称 = 落堆串 循环覆盖）
        结果<货物, 整32> 盒 = 正常(货物());
        如果 (盒.正常) {
            盒.值.名称 = 字符串复制("初串甲");
            整32 j = 0;
            当 (j < 10) {
                盒.值.名称 = 字符串复制("改串乙");
                j = j + 1;
            }
            如果 (!字符串比较(盒.值.名称, "改串乙")) { 打印("盒值错"); 返回 1; }
        } 否则 {
            打印("盒异常");
            返回 1;
        }
    }
    整64 盒差 = 内存::活动分配数() - 基线;
    打印("盒残留=" + 整数转字符串(盒差));
    {
        // 本案面二：可选盒载荷字段赋值（可.值.名称 = 落堆串 同判据同刀）
        可选<货物> 可 = 某些(货物());
        如果 (可.有值) {
            可.值.名称 = 字符串复制("初串甲");
            整32 m = 0;
            当 (m < 10) {
                可.值.名称 = 字符串复制("改串乙");
                m = m + 1;
            }
            如果 (!字符串比较(可.值.名称, "改串乙")) { 打印("可选值错"); 返回 1; }
        } 否则 {
            打印("可选异常");
            返回 1;
        }
    }
    整64 可差 = 内存::活动分配数() - 基线;
    打印("可选残留=" + 整数转字符串(可差));
    {
        // 同根旁路面：普通结构体嵌套链字段赋值（链宿主=拥有聚合局部·同判据）
        芯盒 c;
        c.里.名 = 字符串复制("初串甲");
        整32 k = 0;
        当 (k < 10) {
            c.里.名 = 字符串复制("改串乙");
            k = k + 1;
        }
        如果 (!字符串比较(c.里.名, "改串乙")) { 打印("嵌套值错"); 返回 1; }
    }
    整64 嵌套差 = 内存::活动分配数() - 基线;
    打印("嵌套残留=" + 整数转字符串(嵌套差));
    返回 0;
}
