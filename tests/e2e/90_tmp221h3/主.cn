导入 容器::栈;
静态 整64 计数 = 0;
类 资源 {
公开:
    整64 编号;
    函数 资源(整64 v) { 编号 = v; }
    函数 资源(资源& 其他) { 编号 = 其他.编号; }
    不安全 函数 ~资源() { 计数 = 计数 + 1; }
}
函数 主() -> 整32 {
    打印("[S1] 入口");
    {
        栈<资源> 栈表;
        资源 s1 = 资源(1);
        资源 s2 = 资源(2);
        打印("[S3] 构造完");
        结果<空类型, 整32> p1 = 栈表.压入(s1);
        结果<空类型, 整32> p2 = 栈表.压入(s2);
        打印("[S4] 压入完 大小: ", 栈表.大小());
        结果<资源, 整32> 弹 = 栈表.弹出();
        打印("[S5] 弹出完 正常: ", 弹.正常, " 大小: ", 栈表.大小());
    }
    打印("[S7] 块出口 计数: ", 计数);
    返回 0;
}
