// Task 阶段2 全链路集成验证 E2E 测试
// 覆盖：一个"学生成绩管理系统"程序，串联阶段2全部7个Task的功能：
//   Task 2.1 控制流：如果/否则/当/循环/选择/情况/默认/中断/继续 组合
//   Task 2.2 函数：函数指针回调/递归/原型前向引用
//   Task 2.3 类型：位宽整数/浮点/后缀字面量/位运算/移位/隐式转换
//   Task 2.4 数组与指针：数组初始化/下标/指针算术/解引用/取地址/空指针判空
//   Task 2.5 字符串：普通/原始/多行/连接/长度/查找/打印行多参数
//   Task 2.7 结构体/枚举/联合体：嵌套/数组/-> 成员访问/枚举case/联合体共享内存
//   Task 2.6 优化器：-O1 常量折叠+DCE 下输出与 -O0 完全一致
// 语法依据（cn-language-spec 02/03/04/05）：结构体字段换行分隔；枚举自动递增；
//   选择 case 枚举值；函数指针 C风格；指针算术按元素大小步进；字符串映射 ptr

// ==================== 类型定义 ====================

// 等级枚举：优秀=0 良好=1 及格=2 不及格=3（自动递增），外加负数成员展示枚举负数
枚举 等级 {
    优秀,
    良好,
    及格,
    不及格,
    缺考 = -1
}

// 学生结构体：名字（字符串）、分数（浮64）、等级（枚举）
// 注意：结构体值传参/返回未实现（阶段2范围外），函数一律用 学生* 指针传参
结构体 学生 {
    字符串 名字
    浮64 分数
    等级 级别
}

// 联合体：同一内存既可按 整64 读也可按 浮64 读（共享内存验证）
联合体 成绩盒 {
    整64 整数形式
    浮64 浮点形式
}

// 函数指针类型：比较两个学生，返回 整32（-1/0/1 语义，供排序回调使用）
// 原型前向引用（Task 2.2）：声明在前，定义在文件末尾
函数 按分数比较(学生* a, 学生* b) -> 整32
函数 索引排序(学生* 名单, 整32* 顺序, 整32 人数, 整32(*比较)(学生*, 学生*))

// ==================== 普通函数 ====================

// 递归求和（Task 2.2 递归）：计算数组前 n 个学生的分数总和
函数 递归分数和(学生* 名单, 整32 n) -> 浮64 {
    如果 (n <= 0) {
        返回 0.0
    }
    返回 递归分数和(名单, n - 1) + (名单 + (n - 1))->分数
}

// 计算数组平均分（用递归求总和 + 循环演示）
函数 计算平均分(学生* 名单, 整32 人数) -> 浮64 {
    返回 递归分数和(名单, 人数) / 整32转浮64(人数)
}

// 整32 -> 浮64 显式转换辅助（演示类型转换链）
函数 整32转浮64(整32 v) -> 浮64 {
    返回 v * 1.0
}

// 根据分数设置等级（选择语句 + 枚举，Task 2.7）
函数 设置等级(学生* s) {
    浮64 分数 = s->分数
    如果 (分数 >= 90.0) {
        s->级别 = 等级.优秀
    } 否则 如果 (分数 >= 75.0) {
        s->级别 = 等级.良好
    } 否则 如果 (分数 >= 60.0) {
        s->级别 = 等级.及格
    } 否则 {
        s->级别 = 等级.不及格
    }
}

// 打印单个学生信息（-> 成员访问 + 枚举case，Task 2.7）
函数 打印学生(学生* s) {
    打印行("  学生: ", s->名字)
    打印行("  分数: ", s->分数)
    选择 (s->级别) {
        情况 等级.优秀:
            打印行("  等级: 优秀")
            中断
        情况 等级.良好:
            打印行("  等级: 良好")
            中断
        情况 等级.及格:
            打印行("  等级: 及格")
            中断
        情况 等级.不及格:
            打印行("  等级: 不及格")
            中断
        默认:
            打印行("  等级: 未知")
    }
}

// ==================== 主函数 ====================

函数 主() -> 整32 {
    打印行("===== 学生成绩管理系统（阶段2集成验证）=====")

    // ---- 1. 结构体数组初始化（Task 2.7 结构体数组 + Task 2.5 字符串字段）----
    学生[5] 名单 = {
        学生{ 名字 = "张三", 分数 = 92.5, 级别 = 等级.优秀 },
        学生{ 名字 = "李四", 分数 = 78.0, 级别 = 等级.良好 },
        学生{ 名字 = "王五", 分数 = 55.5, 级别 = 等级.不及格 },
        学生{ 名字 = "赵六", 分数 = 66.5, 级别 = 等级.及格 },
        学生{ 名字 = "钱七", 分数 = 88.0, 级别 = 等级.良好 }
    }
    整32 人数 = 5

    // ---- 2. 循环遍历 + 指针算术（Task 2.4 指针遍历 + Task 2.1 循环）----
    打印行("---- 原始名单 ----")
    循环 (整32 i = 0; i < 人数; i++) {
        打印学生(&名单[i])
    }

    // ---- 3. 数组名退化 + 指针遍历 + 继续（Task 2.4 + Task 2.1）----
    打印行("---- 指针遍历（跳过索引2）----")
    学生* p = 名单
    整32 索引 = 0
    当 (p < 名单 + 人数) {
        如果 (索引 == 2) {
            索引++
            p++
            继续
        }
        打印行("  第", 索引, "个: ", p->名字)
        索引++
        p++
    }

    // ---- 4. 递归求平均分（Task 2.2 递归 + Task 2.3 浮点运算）----
    打印行("---- 统计 ----")
    打印行("总人数: ", 人数)
    浮64 平均分 = 计算平均分(名单, 人数)
    打印行("平均分: ", 平均分)

    // ---- 5. 函数指针回调做排序（Task 2.2 函数指针，定义见文件末尾）----
    // 说明：结构体整体赋值/拷贝未实现（阶段2范围外），排序采用"索引数组"：
    //       交换索引而非结构体元素，函数指针比较 名单[顺序[i]] 的分数
    打印行("---- 按分数排序（索引数组）----")
    整32[5] 顺序 = { 0, 1, 2, 3, 4 }
    整32(*比较)(学生*, 学生*) = 按分数比较
    索引排序(名单, 顺序, 人数, 比较)
    循环 (整32 j = 0; j < 人数; j++) {
        打印学生(&名单[顺序[j]])
    }

    // ---- 6. 字符串 API（Task 2.5：长度/查找/连接）----
    打印行("---- 字符串 API ----")
    字符串 报告头 = "成绩报告"
    打印行("标题长度: ", 字符串长度(报告头))
    打印行("查找'报告': ", 字符串查找(报告头, "报告"))
    打印行("查找'缺失': ", 字符串查找(报告头, "缺失"))
    // 字符串连接（少量使用，避免多次动态分配）
    字符串 第一行 = 名单[0].名字 + " 是第一名"
    打印行("连接: ", 第一行)

    // ---- 7. 原始/多行字符串（Task 2.5）----
    打印行(原始"原始串: C:\dir\file")
    打印行(多行"""多行: 第1行\n第2行""")

    // ---- 8. 位运算/移位/后缀字面量/隐式转换（Task 2.3）----
    打印行("---- 类型系统 ----")
    整32 掩码 = 0b1100
    整32 数据 = 0b1010
    打印行("位与: ", 掩码 & 数据)
    打印行("位或: ", 掩码 | 数据)
    打印行("位异或: ", 掩码 ^ 数据)
    打印行("位非: ", ~掩码)
    打印行("左移: ", 掩码 << 2)
    打印行("右移: ", 掩码 >> 1)
    整64 大值 = 5000000000L
    正32 无符号 = 4000000000U
    打印行("后缀L: ", 大值)
    打印行("后缀U: ", 无符号)
    浮32 单精度 = 3.5f
    浮64 双精度 = 单精度
    打印行("浮32->浮64: ", 双精度)
    整8 小值 = 100
    整16 中值 = 30000
    打印行("整8+50: ", 小值 + 50)
    打印行("整16-5000: ", 中值 - 5000)

    // ---- 9. 联合体共享内存（Task 2.7）----
    打印行("---- 联合体 ----")
    成绩盒 盒
    盒.整数形式 = 42
    打印行("联合体整64: ", 盒.整数形式)
    盒.浮点形式 = 3.5
    打印行("联合体写浮点后整64: ", 盒.整数形式)

    // ---- 10. 空指针判空（Task 2.4）----
    打印行("---- 空指针 ----")
    学生* 空指针 = 无
    如果 (空指针 == 无) {
        打印行("空指针判空: 正确")
    } 否则 {
        打印行("空指针判空: 错误")
    }

    // ---- 11. 枚举负数 + 选择默认（Task 2.7 + Task 2.1）----
    打印行("---- 枚举负数 ----")
    等级 e = 等级.缺考
    打印行("缺考值: ", e)
    选择 (e) {
        情况 等级.优秀:
            打印行("优")
            中断
        默认:
            打印行("非优秀（默认分支）")
    }

    // ---- 12. 优化器一致性（Task 2.6）：常量表达式在 -O1 下折叠，输出不变 ----
    打印行("---- 常量折叠 ----")
    打印行("折叠 2+3*4: ", 2 + 3 * 4)
    打印行("折叠 100/5: ", 100 / 5)
    打印行("折叠 1.5+2.25: ", 1.5 + 2.25)
    变量 死代码1 = 100
    变量 死代码2 = 200
    死代码1 + 1;       // 结果未使用 -> -O1 DCE 删除
    死代码2 * 2;       // 结果未使用 -> -O1 DCE 删除
    (死代码1 + 死代码2) / 2;   // 结果未使用 -> -O1 DCE 删除
    打印行("DCE后: ", 死代码1, " ", 死代码2)

    打印行("===== 系统报告完成 =====")
    返回 0
}

// ==================== 文件末尾定义（前向引用验证） ====================

// 索引排序（冒泡思想，交换索引而非结构体元素）：函数指针作为回调参数（Task 2.2）
// 结构体整体赋值/拷贝未实现（阶段2范围外），故只交换 顺序 数组里的索引值
函数 索引排序(学生* 名单, 整32* 顺序, 整32 人数, 整32(*比较)(学生*, 学生*)) {
    循环 (整32 i = 0; i < 人数 - 1; i++) {
        循环 (整32 j = 0; j < 人数 - 1 - i; j++) {
            如果 (比较(&名单[顺序[j]], &名单[顺序[j + 1]]) > 0) {
                整32 临时索引 = 顺序[j]
                顺序[j] = 顺序[j + 1]
                顺序[j + 1] = 临时索引
            }
        }
    }
}

// 按分数降序比较（分数高者排前）
函数 按分数比较(学生* a, 学生* b) -> 整32 {
    如果 (a->分数 < b->分数) {
        返回 1
    }
    如果 (a->分数 > b->分数) {
        返回 -1
    }
    返回 0
}
