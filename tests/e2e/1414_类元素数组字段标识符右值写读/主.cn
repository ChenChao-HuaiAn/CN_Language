// E2E 1414（2026-10-19 任务 967·923 派生·595-a 面）：类元素数组「标识符右值」
//   写通道——数组元素=内联对象体（923/1052 模型），写通道须内联构造
//   （this=元素地址·零 NewObject 一跳）；原 961 判据收窄为「局部数组标识符」，
//   类/结构体字段数组目标（甲.表[0]=v）落「NewObject+句柄三步」写进内联体槽
//   → 读侧按本体 [元素+字段偏移] 解=读出堆地址（v2 549770012032 vs 宿主 42）。
//   修=写通道判据改用 推导下标数组长度 非零（数组对象·961-c 步进同源单点）。
//   断言面（逐行输出·双编译对照）：
//     形一 局部 16 字节类数组：标识符/构造右值 + 循环变量下标 → 11/12/21/22/…
//     形二 类字段数组 8 字节类：标识符/构造/成员链右值 + 常量/变量下标 + 自赋值
//     形三 结构体字段数组 8 字节类（标记前置）：同上读写成对
//     形四 结构体数组（标量结构体元素）对照：写后读值
类 盒 {
公开:
    整64 值;
    函数 盒() {
        值 = 0;
    }
    函数 盒(整64 v) {
        值 = v;
    }
    不安全 函数 盒(盒& 其他) {
        值 = 其他.值;
    }
}
类 盒双 {
公开:
    整64 甲;
    整64 乙;
    函数 盒双() {
        甲 = 0;
        乙 = 0;
    }
    函数 盒双(整64 a, 整64 b) {
        甲 = a;
        乙 = b;
    }
    不安全 函数 盒双(盒双& 其他) {
        甲 = 其他.甲;
        乙 = 其他.乙;
    }
}
类 外盒 {
公开:
    盒 内;
    函数 外盒() {
        内 = 盒(0);
    }
}
类 仓 {
公开:
    整64 标记;
    盒[3] 表;
    函数 仓() {
        标记 = 0;
    }
}
结构体 壳 {
    整64 标记;
    盒[3] 组;
}
结构体 点 {
    整64 x;
    整64 y;
}
不安全 函数 主() -> 整32 {
    // 形一：局部数组（16 字节类步进）+ 标识符/构造右值 + 循环变量下标
    盒双[2] 局组;
    盒双 v1 = 盒双(11, 12);
    局组[0] = v1;
    局组[1] = 盒双(21, 22);
    打印(局组[0].甲);
    打印(局组[0].乙);
    打印(局组[1].甲);
    打印(局组[1].乙);
    整64 i = 0;
    当 (i < 2) {
        局组[i] = 盒双(30 + i, 40 + i);
        i++;
    }
    i = 0;
    当 (i < 2) {
        打印(局组[i].甲);
        打印(局组[i].乙);
        i++;
    }
    // 形二：类字段数组（标识符/构造/成员链右值 + 常量/变量下标 + 自赋值）
    仓 c = 仓();
    c.标记 = 5;
    盒 v2 = 盒(42);
    c.表[0] = v2;
    c.表[1] = 盒(7);
    打印(c.表[0].值);
    打印(c.表[1].值);
    打印(c.标记);
    v2.值 = 999;
    打印(c.表[0].值);
    打印(v2.值);
    外盒 o = 外盒();
    o.内 = 盒(77);
    c.表[2] = o.内;
    o.内 = 盒(88);
    打印(c.表[2].值);
    i = 0;
    当 (i < 3) {
        c.表[i] = 盒(100 + i);
        i++;
    }
    i = 0;
    当 (i < 3) {
        打印(c.表[i].值);
        i++;
    }
    c.表[0] = c.表[0];
    打印(c.表[0].值);
    // 形三：结构体字段数组（标记前置；标识符/构造右值）
    壳 s;
    s.标记 = 9;
    盒 v3 = 盒(55);
    s.组[0] = v3;
    s.组[1] = 盒(66);
    打印(s.组[0].值);
    打印(s.组[1].值);
    打印(s.标记);
    // 形四：结构体数组（标量结构体元素）对照
    点[2] 点组;
    点 p;
    p.x = 7;
    p.y = 8;
    点组[0] = p;
    点组[1] = p;
    打印(点组[0].x);
    打印(点组[0].y);
    打印(点组[1].x);
    打印(点组[1].y);
    返回 0;
}
