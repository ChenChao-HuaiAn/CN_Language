// 184：相等(7级)与比较(8级)两级优先级（2026-09-09 第四十六轮锚定）——
//   规范 01b§6：8=比较 < <= > >=，7=相等 == !=（关系更紧，C++ 十三级对齐）。
//   a<b == c<d 必须按 (a<b)==(c<d) 分组；合并单层左结合会得出相反结果
//   （修复前 v2 合并层实测 r1=1/r2=0，与宿主相反——观察项①）。
函数 主() -> 整32 {
    变量 a = 5;
    变量 b = 2;
    变量 c = 3;
    变量 d = 4;
    变量 r1 = a < b == c < d;
    变量 r2 = a < a == c > d;
    变量 r3 = 2 + 3 * 4 == 14;
    变量 r4 = 1 << 2 + 1 == 8;
    变量 e1 = (a < b) == (c < d);
    打印(r1);
    打印(r2);
    打印(r3);
    打印(r4);
    打印(e1);
    返回 0;
}
