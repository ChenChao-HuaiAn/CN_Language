// E2E 578（946 轮·任务 107 盒亡释放转正）：结果盒类值副本盒亡释放（退出码
//   断言形态·v2 闭环口径——v2闭环 把 .expected 作编译日志锚行·打印行必不中）。
//   机制：runtime 辅助 __cn_box_class_delete（tag 判读+句柄摘取+清槽幂等）
//   + v2 出口段直线发射（免切块）+ IR_删除对象 空安全收尾（对齐宿主 939
//   pendingBoxCopies 条件 DeleteObject 语义）。
//   【分叉消除（1018 轮任务 107）】v2 类值装箱统一深拷模型（LUE miss/返回位
//   =NewObject+拷贝构造·源照常析构=宿主 889 同构；LUE 命中=句柄零拷移交+源槽
//   清零——宿主 s 形态输出对齐且无宿主泄漏形态）——两侧析构语义一致·551 已转
//   dual（七行逐行全等）；本例退出码断言维持（深拷下内容与释放正确性不变）。
类 货物 {
公开:
    字符串 名称;
    函数 货物(字符串 s) { 名称 = s; }
    不安全 函数 货物(货物& 其他) { 名称 = 字符串复制(其他.名称); }
    不安全 函数 ~货物() { }
}
不安全 函数 主() -> 整32 {
    货物 g = 货物("甲甲甲甲甲甲甲甲甲甲");
    结果<货物, 整32> r = 正常(g);
    如果 (r.正常) {
        布尔 等 = 字符串比较(r.值.名称, "甲甲甲甲甲甲甲甲甲甲");
        如果 (!等) { 返回 1; }
    } 否则 {
        返回 2;
    }
    返回 0;
}
