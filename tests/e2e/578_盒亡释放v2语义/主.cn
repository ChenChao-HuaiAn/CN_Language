// E2E 578（946 轮·任务 107 盒亡释放转正）：结果盒类值副本盒亡释放（退出码
//   断言形态·v2 闭环口径——v2闭环 把 .expected 作编译日志锚行·打印行必不中）。
//   机制：runtime 辅助 __cn_box_class_delete（tag 判读+句柄摘取+清槽幂等）
//   + v2 出口段直线发射（免切块）+ IR_删除对象 空安全收尾（对齐宿主 939
//   pendingBoxCopies 条件 DeleteObject 语义）。
//   【语义分叉登记（946 实测）】v2 装箱=move（71-a 方案A：源转交不析构）
//   vs 宿主=深拷（889：源保留）——析构打印次数不同（1 vs 2）·故本例析构
//   不打印·断言全走退出码；551 维持 host-only（逐行输出不可对齐）。
类 货物 {
公开:
    字符串 名称;
    函数 货物(字符串 s) { 名称 = s; }
    不安全 函数 货物(货物& 其他) { 名称 = 字符串复制(其他.名称); }
    不安全 函数 ~货物() { }
}
不安全 函数 主() -> 整32 {
    货物 g = 货物("甲甲甲甲甲甲甲甲甲甲");
    结果<货物, 整32> r = 正常(g);
    如果 (r.正常) {
        布尔 等 = 字符串比较(r.值.名称, "甲甲甲甲甲甲甲甲甲甲");
        如果 (!等) { 返回 1; }
    } 否则 {
        返回 2;
    }
    返回 0;
}
