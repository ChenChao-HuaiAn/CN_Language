// E2E 723：引用参数窄族写宽度面双编译对照（449 锁用例）
// 覆盖：浮32&/整8&/整16&/正8&/正16&/字符&/枚举& 七族引用参数
//   `交换(表[0],表[4])` 数组元素形态+枚举 结构体字段/标量形态——
//   修前 v2 写回恒 8 字节过写相邻元素（浮32[3] 表[1] 污染/整8[6] 表[1..3]
//   清零/字符[4] 表[1] 垃圾大数），修后按登记类型名文本映射宽度码
//   （整8→byte/整16→word/字符·枚举·浮32→dword；宿主 mapType 同宽：
//   i8/i16/i32/f32）+浮32 读侧登记寄存器类型（防 浮点宽化存储 把位模式
//   当整数 cvtsi2ss 重转换毁值）。
// 规格依据：04-一F（引用参数=别名·读写语义同被引对象）、001 类型表
//   （字符=4字节 Unicode 标量值·枚举=4字节·浮32=4字节）。
// 双侧等价判据：同一源码宿主与 v2 各编各跑，stdout 逐行全等+退出码 0。
// 注：枚举数组下标步进面（c308a 塌缩）为 308 在案缺陷，本用例字段/标量
//   形态覆盖枚举& 写宽语义，不与其混线。
枚举 颜色 { 红, 绿, 蓝 }

结构体 枚盒 { 颜色 甲; 颜色 乙; }

函数 浮交换(浮32& a, 浮32& b) -> 空类型 { 浮32 t = a; a = b; b = t; }
函数 整8交换(整8& a, 整8& b) -> 空类型 { 整8 t = a; a = b; b = t; }
函数 整16交换(整16& a, 整16& b) -> 空类型 { 整16 t = a; a = b; b = t; }
函数 正8交换(正8& a, 正8& b) -> 空类型 { 正8 t = a; a = b; b = t; }
函数 正16交换(正16& a, 正16& b) -> 空类型 { 正16 t = a; a = b; b = t; }
函数 字符交换(字符& a, 字符& b) -> 空类型 { 字符 t = a; a = b; b = t; }
函数 颜色交换(颜色& a, 颜色& b) -> 空类型 { 颜色 t = a; a = b; b = t; }

函数 主() -> 整32 {
    // ① 浮32[3] {1.5,2.5,3.5} 交换[0][2] → 位判定 7（3.5/2.5/1.5 全对）
    //   浮32 用相等判定折位（打印格式两侧若有差异不干扰判据）
    浮32[3] 浮表;
    浮表[0] = 浮32(1.5);
    浮表[1] = 浮32(2.5);
    浮表[2] = 浮32(3.5);
    浮交换(浮表[0], 浮表[2]);
    整32 f位 = 0;
    如果 (浮表[0] == 浮32(3.5)) { f位 = f位 + 1; }
    如果 (浮表[1] == 浮32(2.5)) { f位 = f位 + 2; }
    如果 (浮表[2] == 浮32(1.5)) { f位 = f位 + 4; }
    打印("浮32位(期望7): ", f位);

    // ② 整8[6] {11,22,33,44,55,66} 交换[0][4] → 55 22 33 44 11 66
    //   （byte 写宽：表[1..3] 必须零污染）
    整8[6] 表8 = { 11, 22, 33, 44, 55, 66 };
    整8交换(表8[0], 表8[4]);
    打印("整8(期望55 22 33 44 11 66): ", 整32(表8[0]), " ", 整32(表8[1]), " ",
         整32(表8[2]), " ", 整32(表8[3]), " ", 整32(表8[4]), " ", 整32(表8[5]));

    // ③ 整16[4] {1111,2222,3333,4444} 交换[0][3] → 4444 2222 3333 1111
    整16[4] 表16 = { 1111, 2222, 3333, 4444 };
    整16交换(表16[0], 表16[3]);
    打印("整16(期望4444 2222 3333 1111): ", 整32(表16[0]), " ", 整32(表16[1]), " ",
         整32(表16[2]), " ", 整32(表16[3]));

    // ④ 正8[6] {201,202,203,204,205,206} 交换[0][4] → 205 202 203 204 201 206
    正8[6] 表u8 = { 201, 202, 203, 204, 205, 206 };
    正8交换(表u8[0], 表u8[4]);
    打印("正8(期望205 202 203 204 201 206): ", 整32(表u8[0]), " ", 整32(表u8[1]), " ",
         整32(表u8[2]), " ", 整32(表u8[3]), " ", 整32(表u8[4]), " ", 整32(表u8[5]));

    // ⑤ 正16[4] {40001,40002,40003,40004} 交换[0][3]
    正16[4] 表u16 = { 40001, 40002, 40003, 40004 };
    正16交换(表u16[0], 表u16[3]);
    打印("正16(期望40004 40002 40003 40001): ", 整32(表u16[0]), " ", 整32(表u16[1]), " ",
         整32(表u16[2]), " ", 整32(表u16[3]));

    // ⑥ 字符[4] {65,66,67,68} 交换[0][3] → 68 66 67 65（字符=4字节 dword 写宽）
    字符[4] 表c = { 65, 66, 67, 68 };
    字符交换(表c[0], 表c[3]);
    打印("字符(期望68 66 67 65): ", 整32(表c[0]), " ", 整32(表c[1]), " ",
         整32(表c[2]), " ", 整32(表c[3]));

    // ⑦ 枚举&：结构体字段形态（字段偏移面）+ 标量形态——枚举=i32 4 字节写
    枚盒 盒e;
    盒e.甲 = 颜色.红;
    盒e.乙 = 颜色.蓝;
    颜色交换(盒e.甲, 盒e.乙);
    打印("枚举字段(期望2 0): ", 整32(盒e.甲), " ", 整32(盒e.乙));
    颜色 c1e = 颜色.红;
    颜色 c2e = 颜色.蓝;
    颜色交换(c1e, c2e);
    打印("枚举标量(期望2 0): ", 整32(c1e), " ", 整32(c2e));

    返回 0;
}
