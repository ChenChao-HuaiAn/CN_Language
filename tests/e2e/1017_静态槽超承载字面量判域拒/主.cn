// E2E 1017（2026-10-16·任务 #640）：静态槽超承载十进制文本字面量判域拒——
//   001 §静态成员域限制（475 批乙立法 2026-10-14 用户裁决·535 实施语义）；
//   640 恢复 535 链（fb0306281 未集成 develop——收口 sha 记录异常）并补
//   v2 三形态判域（顶层静态/函数内静态/类静态字段）+宿主顶层/类静态面。
//   超承载=超目标类型承载域（含超 int64 的 19~20 位十进制文本）；修前分叉
//   实锚（探针 m640b/g·同族 475 m9/m15/m20）：宿主按 32 位截断 -1981284353
//   vs v2 全宽直读 -8446744073709551617；20 位双侧落 ml64 A2071（宿主 build
//   失败/v2p 放行产非法 asm）——判域后源头消灭（双侧编译期拒·诊断同旨）。
//   五形态同文件：顶层 20 位（640 顶层挂点）/类字段 19 位（640 类字段挂点·
//   v2 语法层折叠点）/函数内 19 位（宿主 558 链 + v2 535 语句趟挂点）/
//   128 槽 2^128-1 超 2^127 域（顶层+类字段：宿主差集补齐·v2 535 挂点 128
//   叠加判域）。
//   双编译对照负测：宿主+v2p 双侧等效拒绝（诊断锚=值域）。
静态 整32 巨20 = 99999999999999999999;
静态 整128 巨128 = 340282366920938463463374607431768211455;
类 计 {
公开:
    静态 整32 巨 = 9999999999999999999
    静态 整128 巨128 = 340282366920938463463374607431768211455
    函数 计() {}
}
函数 主() -> 整32 {
    静态 整32 局部巨 = 9999999999999999999;
    打印(巨20);
    打印(巨128);
    打印(计.巨);
    打印(计.巨128);
    打印(局部巨);
    返回 0;
}
