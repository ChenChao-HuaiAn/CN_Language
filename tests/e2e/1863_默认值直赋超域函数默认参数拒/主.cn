// E2E 1863（#1860 四通道同拒锁面·函数默认参数通道）：整32 默认参数
//   超域直赋三形态编译期拒（T36/#506甲·788⑤·本轮新执法——#1814 常量性
//   检查后原放行静默 32 位截断回绕）。①字面量 ②常量算式（3000000000+0
//   ·919 子树字面量域判）③顶层常量名引用（常量本身超目标域同拒）。
//   诊断=#1860 新执法文案（与类字段默认值通道同款）。
常量 大数 = 3000000000;

函数 f(整32 y = 3000000000) -> 整32 {
    返回 y;
}

函数 g(整32 y = 3000000000 + 0) -> 整32 {
    返回 y;
}

函数 h(整32 y = 大数) -> 整32 {
    返回 y;
}

函数 主() -> 整32 {
    打印(f());
    打印(g());
    打印(h());
    返回 0;
}
