// 官网文档示例 · reference/control-flow.html · 循环（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
函数 主() -> 整32 {
    整32 i = 0;
    当 i < 3 {                   // 当：前测循环
        打印行(i, " ");
        i++;
    }
    打印("");
    循环 (整32 j = 10; j > 0; j -= 4) {   // 初始;条件;更新
        打印行(j, " ");
    }
    打印("");
    返回 0;
}