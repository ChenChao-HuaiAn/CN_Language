// E2E 1445：JSON 模块拆分后导入面与限定调用（#751 P1-1/P1-2）
//   ①导入绑定：导入 JSON::{JSON树, JSONE_好, JSONT_对象}（拆后再导出面）；
//   ②P1-2 历史兼容：导入 JSON::{向量}（拆前 JSON.cn 公开段 导入 容器::向量 面）；
//   ③限定调用：JSON::解析JSON（模块已加载后 模块::函数 恒可用）。
导入 JSON::{JSON树, JSONE_好, JSONT_对象, 向量};

函数 主() -> 整32 {
    JSON树 树 = JSON树();
    JSON::解析JSON(树, "{\"甲\":1}");
    如果 (树.错误码 != JSONE_好) {
        打印("错误码=", 树.错误码);
        返回 1;
    }
    如果 (JSONT_对象 != 7) {
        打印("对象常量=", JSONT_对象);
        返回 2;
    }
    向量<整64> 列 = 向量<整64>();
    结果<空类型, 整32> 追 = 列.追加(7);
    如果 (追.正常) {
        // 追加成功：继续（结果类型强制检查）
    } 否则 {
        返回 3;
    }
    打印("导入面: 根=", 树.根, " 子数=", 树.子数(树.根), " 对象=", JSONT_对象, " 向量=", 列.元素(0));
    返回 0;
}
