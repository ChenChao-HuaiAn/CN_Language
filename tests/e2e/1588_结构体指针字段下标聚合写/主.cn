// E2E 1588_结构体指针字段下标聚合写（#1680 dual·双编译对照）：
//   结构体**指针字段**下标左值（架.针[i]）× 聚合值右值——宿主原
//   indexTargetElemSrcType MemberExpr 分支只认数组字段，指针字段落无值
//   → 结构体整体赋值通道（348-a 源优先序 / H8 CopyStruct）全弹 → 聚合
//   右值（可选 变量/构造调用）落兜底 StorePtr 只写 8 字节**临时对象地址**
//   =编译放行、目标元素不变（IR 铁证：指针存储 目标=某(777) 临时槽地址；
//   asm 铁证：修前 mov [rbx],r14 8B 临时地址 / 修后 rep movsb 16B 整块）。
//   v2 写面本已正确（#1666 字段指针元素可写·673 两级寻址）→ 本用例锁定
//   双侧一致的**写面**全形态（双编译对照）。
//   修=宿主 indexTargetElemSrcType 补指针字段 pointee 口径（非类宿主·与
//   indexAssignElemType 既有放行面/v2 97-a 拒绝口径对齐零分叉）。两级寻址
//   （字段槽→指针值→+i×步进）修前已对（标量右值写/读侧全绿探针实证），
//   缺陷唯在「存」环节选型。
//   七形态（退出码=折校验和 127）：
//     ① 整64* 字段×标量字面量写读（回归锚·修前已对）
//     ② 整64* 字段×变量右值+复合赋值（回归锚）
//     ③ 可选<整64>* 字段×变量右值（修前宿主丢写主形态）
//     ④ 可选<整64>* 字段×构造调用右值（348-a 源优先序通道）
//     ⑤ 可选<整64>* 字段×无（1651 空载荷通道·回归锚）
//     ⑥ 嵌套一层 芯.针[i] 标量写（673 两级寻址·回归锚）
//     ⑦ 嵌套一层 芯.槽[i] 可选聚合写（修前同病面）
//   读侧锚：③④⑦ 经池数组元素读回校验（有值/值·双侧一致面）。
//   〔v2 同族残留另案：指针字段下标**读**聚合——成员基座（乙.槽[0]）
//     整体读 tag 对 payload 错 + 裸指针变量（p[0]）语义层拒绝（宿主放行
//     且正确）=双侧分叉，#1680 范围=宿主写发射·读面 v2 侧另案跟进。〕
//   ①~⑦ 校验位=1/2/4/8/16/32/64（全对=127·打印逐位）→ 主 返回 0。
结构体 标架 {
    整64* 数据;
    整64 容量;
}

结构体 选架 {
    可选<整64>* 槽;
    整64 容量;
}

结构体 外壳 {
    标架 芯;
    选架 选芯;
}

// ① 整64* 字段×标量字面量写读
不安全 函数 形一() -> 整64 {
    整64[4] 池 = { 0, 0, 0, 0 };
    标架 甲;
    甲.数据 = &池[0];
    甲.数据[0] = 111;
    甲.数据[2] = 333;
    如果 (池[0] != 111 || 池[2] != 333) { 返回 0; }
    返回 1;
}

// ② 整64* 字段×变量右值+复合赋值
不安全 函数 形二() -> 整64 {
    整64[3] 池 = { 0, 0, 0 };
    标架 甲;
    甲.数据 = &池[0];
    整64 v = 555;
    甲.数据[1] = v;
    甲.数据[1] += 5;
    如果 (池[1] != 560) { 返回 0; }
    返回 2;
}

// ③ 可选<整64>* 字段×变量右值（修前宿主丢写主形态）
不安全 函数 形三() -> 整64 {
    可选<整64>[3] 池;
    选架 乙;
    乙.槽 = &池[0];
    可选<整64> w = 某些(888);
    乙.槽[1] = w;
    如果 (!池[1].有值 || 池[1].值 != 888) { 返回 0; }
    返回 4;
}

// ④ 可选<整64>* 字段×构造调用右值（348-a 源优先序）
不安全 函数 形四() -> 整64 {
    可选<整64>[3] 池;
    选架 乙;
    乙.槽 = &池[0];
    乙.槽[2] = 某些(777);
    如果 (!池[2].有值 || 池[2].值 != 777) { 返回 0; }
    返回 8;
}

// ⑤ 可选<整64>* 字段×无（1651 空载荷通道·回归锚）
不安全 函数 形五() -> 整64 {
    可选<整64>[2] 池;
    选架 乙;
    乙.槽 = &池[0];
    乙.槽[0] = 某些(9);
    乙.槽[0] = 无;
    如果 (池[0].有值) { 返回 0; }
    返回 16;
}

// ⑥ 嵌套一层 芯.数据[i] 标量写（673 两级寻址·回归锚）
不安全 函数 形六() -> 整64 {
    整64[2] 池 = { 0, 0 };
    外壳 外;
    外.芯.数据 = &池[0];
    外.芯.数据[1] = 42;
    如果 (池[1] != 42) { 返回 0; }
    返回 32;
}

// ⑦ 嵌套一层 芯.槽[i] 可选聚合写（修前同病面）
不安全 函数 形七() -> 整64 {
    可选<整64>[2] 池;
    外壳 外;
    外.选芯.槽 = &池[0];
    外.选芯.槽[1] = 某些(64);
    如果 (!池[1].有值 || 池[1].值 != 64) { 返回 0; }
    返回 64;
}

不安全 函数 主() -> 整32 {
    整64 校验 = 形一() + 形二() + 形三() + 形四() + 形五() + 形六() + 形七();
    // ①~⑦ 全对=127（1+2+4+8+16+32+64）
    打印("写侧=", 校验);
    如果 (校验 != 127) { 返回 1; }
    返回 0;
}
