// E2E 1092 符号供给（#1033·2026-10-17）：实例化 向量<浮32> 与 向量<半对>
//   容器方法符号（宿主编译·布局权威）——v2p.obj 只含 v2 自身实例化的类型
//   （浮32 元素容器未用过）。结构体定义与 主.cn 逐字段一致（同符号同布局）。
导入 容器::向量;

结构体 半对 { 浮32 甲; 浮32 乙; }

函数 供给浮表() -> 整64 {
    向量<浮32> 表 = 向量<浮32>();
    结果<空类型, 整32> 加1 = 表.追加(浮32(1.0));
    返回 表.大小();
}

函数 供给半对表() -> 整64 {
    向量<半对> 段 = 向量<半对>();
    半对 e;
    e.甲 = 浮32(1.0);
    e.乙 = 浮32(2.0);
    结果<空类型, 整32> 加e = 段.追加(e);
    半对 取 = 段.元素(0);
    返回 整64(取.甲) + 段.大小();
}

// 宿主编译入口（cn build 需要主函数；链接 muldefs 下 v2asm 在前，cn_main 归 v2 产物）
函数 主() -> 整32 {
    返回 整32(供给浮表() + 供给半对表());
}
