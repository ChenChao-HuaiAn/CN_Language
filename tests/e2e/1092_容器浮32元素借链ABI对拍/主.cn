// E2E 1092（#1033·2026-10-17）：容器元素浮32/含浮32字段结构体双供 ABI 零分叉
//   （dual·借链=是：v2 生成代码 × v2p.obj 宿主编译容器方法——v2 单态化亦自发射
//   容器方法符号（v2asm.obj 靠前胜出），与 v2p.obj/供给.obj 双供同名）。
//   修前实证（产物 asm）：v2 单态化 向量$半对$元素 步进常量=16（宿主 8）——
//   结构体大小 v2=16/宿主=8 传染至容器方法体；运行级靠 v2asm 符号遮蔽自洽
//   （潜隐分叉：符号解析顺序一变即撞）。修后=8（与宿主 typeSizeOf 逐字节
//   一致·零分叉）。向量$浮32 元素步进修前修后均=4（类型大小(T) 折叠走
//   类型名宽度·浮32=4 既有档）——同轮锁定该面不回退。
//   形态：①向量<浮32> 追加/元素/大小 ②向量<半对> 结构体元素追加与字段读
//   （按值传参 + 元素内偏移双交叉）③混合顺序校验。
导入 容器::向量;

结构体 半对 { 浮32 甲; 浮32 乙; }

函数 主() -> 整32 {
    向量<浮32> 表 = 向量<浮32>();
    结果<空类型, 整32> 加1 = 表.追加(浮32(1.5));
    结果<空类型, 整32> 加2 = 表.追加(浮32(2.5));
    结果<空类型, 整32> 加3 = 表.追加(浮32(3.5));
    打印("大小: ", 表.大小());
    打印("0: ", 表.元素(0));
    打印("1: ", 表.元素(1));
    打印("2: ", 表.元素(2));
    向量<半对> 段 = 向量<半对>();
    半对 e0;
    e0.甲 = 浮32(10.5);
    e0.乙 = 浮32(11.5);
    半对 e1;
    e1.甲 = 浮32(12.5);
    e1.乙 = 浮32(13.5);
    结果<空类型, 整32> 加e0 = 段.追加(e0);
    结果<空类型, 整32> 加e1 = 段.追加(e1);
    打印("段大小: ", 段.大小());
    打印("段0甲: ", 段.元素(0).甲);
    打印("段0乙: ", 段.元素(0).乙);
    打印("段1甲: ", 段.元素(1).甲);
    打印("段1乙: ", 段.元素(1).乙);
    返回 0;
}
