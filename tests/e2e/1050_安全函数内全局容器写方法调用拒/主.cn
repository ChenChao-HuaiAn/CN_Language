// E2E 1050（916 轮·001 §747-8 通用全局写执法·方法调用形态·791 派生锁面）：
//   安全函数内「可变全局静态容器 写方法调用」=编译错误——791 只锁 下标/成员
//   赋值链，方法调用形态（非赋值链写法 全局容器.追加(...)/.设置(...)）原静默
//   绕过（双侧运行真写实证·916 台账）。写方法白名单=stdlib/容器.cn+映射集合.cn
//   实际 API 逐一对表（追加/设置/清空/删除/插入/弹出…·宁全勿漏）；读方法
//   （大小/容量/元素/读取/获取/包含…）不拦（1051 正测对照）。
//   同一源码宿主+v2p **都必须编译拒绝**（诊断锚=[安全区边界]·双侧同文案）。
//   局部链/形参链与 不安全 函数内写不受本执法面约束（探针矩阵另证）。
// 预期失败。
导入 容器::向量;
导入 映射集合;

向量<整32> 全局向量;            // 裸全局容器（888 ⑨ 通道）
静态 向量<整32> 静向量;        // 顶层静态容器（静态半边）
映射<整64, 整64> 全局映射;     // 裸全局映射

函数 违规写() {
    结果<空类型, 整32> 加 = 全局向量.追加(1);      // 形态① 写方法调用（裸全局）
    如果 (!加.正常) { 返回; }
    结果<空类型, 整32> 设 = 全局映射.设置(2, 3);    // 形态② 映射写方法
    如果 (!设.正常) { 返回; }
    结果<空类型, 整32> 静加 = 静向量.追加(4);      // 形态③ 顶层静态容器
    如果 (!静加.正常) { 返回; }
    全局向量.清空();                                // 形态④ 无返回写方法
}

函数 主() -> 整32 {
    违规写();
    返回 0;
}
