// E2E 231_v2（2026-09-12 第八十轮·池索引 0 哨兵根治）：v2 内置构造器识别
//   首节点形态回归——入口文件**第一个函数体首条语句**的被调标识符恰落节点池
//   索引 0 时，构造器 正常/错误/某些 必须仍展开为内置装箱（而非退化为普通
//   函数调用 → 未定义符号链接失败）。
//   立案背景（探针 P10/P10b/P20/P21 实证，基线 v2p 复现）：语义层 检查调用
//   表达式 与 IR 层 生成调用 的内置构造器特判守卫为 `子起点 > 0`，而池索引 0
//   是合法节点位——首个叶节点落索引 0 时守卫误判「无被调」→ 构造器静默退化。
//   修复：池索引 0 保留为哨兵（真实节点索引恒 >= 1，Rust NodeId 0 保留同款）。
//   本用例首条语句 `返回 错误(5);` 使 错误 落池索引 0（修复前本用例产物
//   含 `call _错误` 链接失败）；同文件其它形态（正常/某些/声明位/类型大小）
//   为同族回归对照。校验和=①1+②2+③4+④8+⑤16=31。
函数 造错误() -> 结果<字符串, 整32> { 返回 错误(5); }

函数 造正常() -> 结果<字符串, 整32> { 返回 正常("好"); }

函数 造某些() -> 可选<字符串> { 返回 某些("好"); }

函数 主() -> 整32 {
    整32 校验 = 0;
    结果<字符串, 整32> 甲 = 造错误();
    如果 (!甲.正常 && 甲.错误 == 5) { 校验 = 校验 + 1; }
    结果<字符串, 整32> 乙 = 造正常();
    如果 (乙.正常 && 字符串比较(乙.值, "好")) { 校验 = 校验 + 2; }
    可选<字符串> 丙 = 造某些();
    如果 (丙.有值 && 字符串比较(丙.值, "好")) { 校验 = 校验 + 4; }
    结果<字符串, 整32> 丁 = 错误(7);
    如果 (!丁.正常 && 丁.错误 == 7) { 校验 = 校验 + 8; }
    如果 (类型大小(整64) == 8) { 校验 = 校验 + 16; }
    返回 校验;
}
