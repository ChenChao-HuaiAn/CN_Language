导入 容器::向量;
导入 映射集合::映射;

// E2E 127 符号供给（②c B7，2026-09-02；第 14 枚根治配套修订 2026-09-06）：
//   v2 生成代码引用的容器方法符号由本文件经宿主真实管线编译为 .obj 供给
//   （链接置于 v2p.obj 之前——用例自有类型布局权威）。覆盖：
//   向量$映射$整64$整64：A 嵌套容器全方法面（构造/追加/元素(i) 链式设置与获取/
//     大小/RAII 析构）
//   向量$词条：B 结构体值语义——词条按**结构体**供给（与主.cn 声明同种类同
//     布局：编号 8B + 表 向量对象 24B 内联）。第 14 枚（v2self 第 7 层）撤销
//     旧「类形态供给」契约：主.cn 结构体声明 × 供给类实现 = 同名双 ABI，
//     元素() 被调方形态（类=ptr/rax vs 结构体=sret）分叉致 v2 调用方错位
//     （宿主三方 asm 实证：词条=结构体时 元素(0) 发射 rdi=retbuf/rsi=this/
//     rdx=位置 sret 三装载，直编运行 exit=0）。供给改结构体后双方 ABI 一致
//     （对齐 Rust「类型即布局、布局即 ABI」——同名类型禁止双 ABI）。
//     语义：追加=按值浅拷贝（表 向量对象 24B 原样拷贝、数据指针共享）、
//     元素(i)=sret 按值拷贝（读字段经 retbuf）、容器析构不级联结构体元素
//     （对齐宿主现状；悬垂表指针无人访问）。
//   断言值 101 起仅当独立运行时可见；E2E 链接编排下本产物 .obj 仅供给符号，
//   cn_main 归 v2 产物（/FORCE:MULTIPLE + v2asm.obj 在前）。

结构体 词条 {
    整64 编号;
    向量<整64> 表;
}

// A：实例化 向量<映射<整64,整64>> 全方法面（含 元素(i) 链式方法调用）
函数 供给嵌套() -> 整64 {
    向量<映射<整64, 整64>> 层表 = 向量<映射<整64, 整64>>();
    映射<整64, 整64> 层 = 映射<整64, 整64>();
    结果<空类型, 整32> 设 = 层.设置(1, 10);
    如果 (!设.正常) { 返回 101; }
    结果<空类型, 整32> 加 = 层表.追加(层);
    如果 (!加.正常) { 返回 102; }
    结果<空类型, 整32> 链 = 层表.元素(0).设置(2, 20);
    如果 (!链.正常) { 返回 103; }
    如果 (层表.大小() != 1) { 返回 104; }
    整64 和 = 0;
    结果<整64, 整32> 取 = 层表.元素(0).获取(1);
    如果 (取.正常) { 和 = 取.值; }
    如果 (和 != 10) { 返回 105; }
    返回 0;
}

// B：实例化 向量<词条> 全方法面（追加按值拷贝/元素 sret 链式读/大小）
函数 供给词池() -> 整64 {
    向量<词条> 词池 = 向量<词条>();
    词条 w;
    w.编号 = 7;
    w.表 = 向量<整64>();
    结果<空类型, 整32> 加一 = w.表.追加(1);
    如果 (!加一.正常) { 返回 106; }
    结果<空类型, 整32> 加二 = w.表.追加(2);
    如果 (!加二.正常) { 返回 107; }
    结果<空类型, 整32> 加词 = 词池.追加(w);
    如果 (!加词.正常) { 返回 108; }
    如果 (词池.大小() != 1) { 返回 109; }
    如果 (词池.元素(0).编号 != 7) { 返回 110; }
    如果 (词池.元素(0).表.大小() != 2) { 返回 111; }
    返回 0;
}

// 宿主编译入口（cn build 需要主函数；链接 muldefs 下 v2asm 在前，cn_main 归 v2 产物）
函数 主() -> 整32 {
    返回 整32(供给嵌套() + 供给词池());
}
