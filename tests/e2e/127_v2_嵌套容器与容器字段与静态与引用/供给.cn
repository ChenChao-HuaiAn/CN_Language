导入 容器::向量;
导入 映射集合::映射;

// E2E 127 符号供给（②c B7，2026-09-02）：v2 生成代码引用的容器方法符号由本文件
//   经宿主真实管线编译为 .obj 供给（链接置于 v2p.obj 之前——用例自有类型布局
//   权威）。覆盖：
//   向量$映射$整64$整64：A 嵌套容器全方法面（构造/追加/元素(i) 链式设置与获取/
//     大小/RAII 析构）
//   向量$词条：B 拥有式语义——词条按类形态供给（HANDOFF 供给契约：值字段+
//     构造里 表 = 向量<整64>() 初始化+拷贝构造逐元素法+声明空体析构），
//     向量<词条> 追加即获 H8-⑤ 深拷贝与 Feature2 元素析构级联（p7 池元素表=2
//     实证）。主.cn 侧 词条 按结构体声明——同符号同布局（编号 8B + 表 指针槽
//     8B），链接后 v2 产物经本供给获得拥有式行为。
//   断言值 101 起仅当独立运行时可见；E2E 链接编排下本产物 .obj 仅供给符号，
//   cn_main 归 v2 产物（/FORCE:MULTIPLE + v2asm.obj 在前）。

类 词条 {
公开:
    整64 编号;
    向量<整64> 表;

    函数 词条() {
        编号 = 0;
        表 = 向量<整64>();
    }

    // 拷贝构造：逐元素深拷贝（供给契约形状，HANDOFF 模型定案）
    函数 词条(词条& 其他) {
        编号 = 其他.编号;
        表 = 向量<整64>();
        整64 i = 0;
        当 (i < 其他.表.大小()) {
            结果<空类型, 整32> 加 = 表.追加(其他.表.元素(i));
            i++;
        }
    }

    函数 ~词条() { }
}

// A：实例化 向量<映射<整64,整64>> 全方法面（含 元素(i) 链式方法调用）
函数 供给嵌套() -> 整64 {
    向量<映射<整64, 整64>> 层表 = 向量<映射<整64, 整64>>();
    映射<整64, 整64> 层 = 映射<整64, 整64>();
    结果<空类型, 整32> 设 = 层.设置(1, 10);
    如果 (!设.正常) { 返回 101; }
    结果<空类型, 整32> 加 = 层表.追加(层);
    如果 (!加.正常) { 返回 102; }
    结果<空类型, 整32> 链 = 层表.元素(0).设置(2, 20);
    如果 (!链.正常) { 返回 103; }
    如果 (层表.大小() != 1) { 返回 104; }
    整64 和 = 0;
    结果<整64, 整32> 取 = 层表.元素(0).获取(1);
    如果 (取.正常) { 和 = 取.值; }
    如果 (和 != 10) { 返回 105; }
    返回 0;
}

// B：实例化 向量<词条> 全方法面（追加深拷贝/元素链式读/大小/RAII 元素级联）
函数 供给词池() -> 整64 {
    向量<词条> 词池 = 向量<词条>();
    词条 w;
    w.编号 = 7;
    结果<空类型, 整32> 加一 = w.表.追加(1);
    如果 (!加一.正常) { 返回 106; }
    结果<空类型, 整32> 加二 = w.表.追加(2);
    如果 (!加二.正常) { 返回 107; }
    结果<空类型, 整32> 加词 = 词池.追加(w);
    如果 (!加词.正常) { 返回 108; }
    如果 (词池.大小() != 1) { 返回 109; }
    如果 (词池.元素(0).编号 != 7) { 返回 110; }
    如果 (词池.元素(0).表.大小() != 2) { 返回 111; }
    返回 0;
}

// 宿主编译入口（cn build 需要主函数；链接 muldefs 下 v2asm 在前，cn_main 归 v2 产物）
函数 主() -> 整32 {
    返回 整32(供给嵌套() + 供给词池());
}
