导入 容器::向量
导入 映射集合::映射

// E2E 127（v2 ②c 四项一轮收官，2026-09-02 立项——实现到绿时注册 v2 闭环运行器）：
//   A 嵌套容器：向量<映射<整64,整64>> 构造/追加(映射)/元素(i).设置(k,v) 链式方法
//     调用/元素(i).获取(k)/大小（对标宿主 E2E 118；v2 缺口：$ 合成名查容器对象
//     大小表消灭 8 字节兜底、元素(i) 返回容器走 retbuf、CallExpr 方法调用类型
//     推导、追加实参=对象指针直传）
//   B 结构体容器字段（指针槽模型）：裸声明零初始化→字段构造赋值（NewObject+
//     构造+StorePtr）→b.表.追加()/b.表.元素(i) 链式读写→向量<词条>（含容器字段
//     结构体）追加与 元素(0).表 值往返（拥有式深拷贝与元素级联由 供给.cn 类形态
//     供给：H8-⑤ 深拷贝 + Feature2 析构级联，p7 池元素表=2 实证；本文件侧按
//     结构体声明——同符号同布局，断言取深浅两态同值）
//   C 顶层静态容器：静态 向量<整64>/映射<整64,整64> 跨函数累积（E2E 121 形状，
//     P3-8 指针槽；v2 四层缺口：语法节点_静态声明/语义登记/IR 入口注入/双后端
//     .data 发射）
//   D 引用参数：整64& 写回与交换 + 结构体&（字段+容器字段写回，跳过 prologue
//     多槽拷贝）+ 向量<整64>& 追加写回（spec 04-一F；v2 缺口：byRef 槽存地址/
//     读 LoadPtr/写 StorePtr + 调用方实参回扫取址）
//   断言失败提前返回 201 起；全部通过 返回 0。
//   立项期（未注册 v2 闭环）：宿主通用路径回归——全部形状在宿主缺陷簇根治后
//   必须保持绿（主.expected 置空 = 宿主运行无输出且退出 0；②c 落地注册时改写
//   为 v2p 自检行）。
结构体 桶 {
    整64 编号
    向量<整64> 表
}

结构体 词条 {
    整64 编号
    向量<整64> 表
}

静态 向量<整64> 池
静态 映射<整64, 整64> 偏移表

函数 入池(整64 v) -> 整32 {
    结果<空类型, 整32> 加 = 池.追加(v)
    如果 (!加.正常) { 返回 1 }
    返回 0
}

函数 填(整64& 目标, 整64 值) -> 空类型 {
    目标 = 值
}

函数 换(整64& a, 整64& b) -> 空类型 {
    整64 临时 = a
    a = b
    b = 临时
}

函数 补桶(桶& b) -> 空类型 {
    b.编号 = b.编号 + 1
    结果<空类型, 整32> 加 = b.表.追加(99)
}

函数 追加表(向量<整64>& t, 整64 v) -> 空类型 {
    结果<空类型, 整32> 加 = t.追加(v)
}

函数 主() -> 整32 {
    // —— A：嵌套容器 向量<映射<整64,整64>> ——
    向量<映射<整64, 整64>> 层表 = 向量<映射<整64, 整64>>()
    映射<整64, 整64> 层 = 映射<整64, 整64>()
    结果<空类型, 整32> 设层 = 层.设置(1, 10)
    如果 (!设层.正常) { 返回 201 }
    结果<空类型, 整32> 加层 = 层表.追加(层)
    如果 (!加层.正常) { 返回 202 }
    结果<空类型, 整32> 设链 = 层表.元素(0).设置(2, 20)
    如果 (!设链.正常) { 返回 203 }
    如果 (层表.大小() != 1) { 返回 204 }
    整64 甲和 = 0
    结果<整64, 整32> 取甲 = 层表.元素(0).获取(1)
    如果 (取甲.正常) { 甲和 = 取甲.值 } 否则 { 返回 205 }
    结果<整64, 整32> 取乙 = 层表.元素(0).获取(2)
    如果 (取乙.正常) { 甲和 = 甲和 + 取乙.值 } 否则 { 返回 206 }
    如果 (甲和 != 30) { 返回 207 }
    映射<整64, 整64> 层二 = 映射<整64, 整64>()
    结果<空类型, 整32> 设层二 = 层二.设置(3, 33)
    如果 (!设层二.正常) { 返回 208 }
    结果<空类型, 整32> 加层二 = 层表.追加(层二)
    如果 (!加层二.正常) { 返回 209 }
    结果<整64, 整32> 取丙 = 层表.元素(1).获取(3)
    如果 (取丙.正常) {
        如果 (取丙.值 != 33) { 返回 210 }
    } 否则 {
        返回 210
    }
    // —— B：结构体容器字段（指针槽模型）+ 向量<词条> 值往返 ——
    {
        桶 b
        b.编号 = 1
        b.表 = 向量<整64>()
        结果<空类型, 整32> 加桶 = b.表.追加(5)
        如果 (!加桶.正常) { 返回 211 }
        如果 (b.表.大小() != 1) { 返回 212 }
        如果 (b.表.元素(0) != 5) { 返回 213 }
        向量<词条> 词池 = 向量<词条>()
        词条 w
        w.编号 = 7
        w.表 = 向量<整64>()
        结果<空类型, 整32> 加词一 = w.表.追加(1)
        结果<空类型, 整32> 加词二 = w.表.追加(2)
        结果<空类型, 整32> 加词 = 词池.追加(w)
        如果 (!加词.正常) { 返回 214 }
        如果 (词池.大小() != 1) { 返回 215 }
        如果 (词池.元素(0).编号 != 7) { 返回 216 }
        如果 (词池.元素(0).表.大小() != 2) { 返回 217 }
        如果 (词池.元素(0).表.元素(1) != 2) { 返回 218 }
        // 块出口：词池/b/w 级联析构（泄漏零容忍）
    }
    // —— C：顶层静态容器跨函数 ——
    如果 (入池(5) != 0) { 返回 221 }
    如果 (入池(7) != 0) { 返回 222 }
    如果 (池.大小() != 2) { 返回 223 }
    如果 (池.元素(1) != 7) { 返回 224 }
    结果<空类型, 整32> 设偏 = 偏移表.设置(9, 200)
    如果 (!设偏.正常) { 返回 225 }
    // —— D：引用参数写回 ——
    整64 x = 1
    填(x, 42)
    如果 (x != 42) { 返回 231 }
    整64 a = 10
    整64 b = 20
    换(a, b)
    如果 (a != 20 || b != 10) { 返回 232 }
    桶 t
    t.编号 = 1
    t.表 = 向量<整64>()
    补桶(t)
    如果 (t.编号 != 2) { 返回 233 }
    如果 (t.表.大小() != 1 || t.表.元素(0) != 99) { 返回 234 }
    向量<整64> 列 = 向量<整64>()
    追加表(列, 8)
    如果 (列.大小() != 1 || 列.元素(0) != 8) { 返回 235 }
    // —— C 收尾：静态映射读回 ——
    整64 查值 = 0
    结果<整64, 整32> 查 = 偏移表.获取(9)
    如果 (查.正常) { 查值 = 查.值 }
    如果 (查值 != 200) { 返回 226 }
    返回 0
}
