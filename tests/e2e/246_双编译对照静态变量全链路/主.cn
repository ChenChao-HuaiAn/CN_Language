// E2E 246（2026-09-12 第八十七轮 87-a，plans/020 移植纪律 9 门禁化·第十六个对照用例）：
//   **静态变量全链路（槽尺寸/初值/读写/实参/返回/成员位）**——同一份源码经宿主真实
//   管线与 v2 自举链各编译运行，两侧退出码须相等。
//   背景（87-a 探针 P50b 实证）：两侧静态聚合面五类缺陷——
//     ① 宿主 linux_x64/arm64 静态标量初值被无条件忽略（恒 .quad 0）；v2 布尔/
//        浮点/字符串初值折叠失败静默落 0；
//     ② 静态槽恒 8 字节（结构体 16/24… 字节整体写**越界相邻 .data 符号**）；
//     ③ 静态结构体语句位赋值落 8 字节标量写（宿主）/静态槽零写（v2，被降级为
//        函数局部栈槽）；
//     ④ 静态结构体字段读取基址落到无效槽 / 声明位初值零初始化；
//     ⑤ 静态字符串赋值无 drop 旧值（泄漏）+ 借用来源共享句柄。
//   八形态（两侧共有语义面）：
//     ① 静态标量初值（整64/整32/布尔/浮64/字符串 读回）
//     ② 静态结构体声明位初始化（含串字段）
//     ③ 静态结构体语句位赋值（字面量，跨函数写 + 主 读）
//     ④ 静态结构体整体赋值（源=局部变量，源块先退出=跨块）
//     ⑤ 静态结构体作实参（按值传递）
//     ⑥ 返回全局静态结构体（85-a 返回位深拷面）
//     ⑦ 静态结构体成员链嵌套（外层{内盒{名}}声明位 + 成员读）
//     ⑧ 相邻静态数据哨兵完整性 + 循环 2000 轮重复赋值残留归零
//   校验和折位：①1 ②2 ③4 ④8 ⑤16 ⑥32 ⑦64 ⑧128 —— 255=全对。
//   平台守卫=linux 双平台（宿主与 v2 同链；win-x64 v2 产物未隔离=家机轮）。
结构体 盒 {
    字符串 名;
    整32 号;
}
结构体 外 {
    盒 内盒;
    整64 标记;
}

// ⑧ 越界写哨兵：静态结构体前后各放一个静态标量（槽尺寸不足即被破坏）
静态 整64 哨兵前 = 111;
静态 整64 标量整 = 11111;
静态 整32 标量窄 = 222;
静态 布尔 标量布 = 真;
静态 浮64 标量浮 = 3.5;
静态 字符串 标量串 = "E246静态串初值甲乙丙丁戊";
静态 盒 甲 = 盒{ 名 = 字符串复制("E246甲串声明位内容甲乙丙丁"), 号 = 101 };
静态 外 丙 = 外{ 内盒 = 盒{ 名 = 字符串复制("E246丙内串声明位内容甲乙"), 号 = 303 }, 标记 = 9 };
静态 整64 哨兵后 = 222;

函数 搅动() -> 整64 {
    整64 和 = 0;
    整64 i = 0;
    当 (i < 16) {
        字符串 垃圾 = 字符串复制("E246搅动内存填充占位字符串内容甲乙丙丁戊己庚辛壬癸");
        和 = 和 + 字符串长度(垃圾);
        i++;
    }
    返回 和;
}

// ③ 跨函数写静态结构体（字面量右值）
不安全 函数 设甲(整32 号) -> 空类型 {
    甲 = 盒{ 名 = 字符串复制("E246甲串改写信道内容甲乙丙丁"), 号 = 号 };
}

// ⑤ 按值形参接收（结构体实参 ABI=传地址 + 返回位深拷）
函数 取参(盒 参) -> 盒 {
    返回 参;
}

// ⑥ 返回全局静态结构体（借用来源 → 85-a 深拷归一化）
函数 取全局() -> 盒 {
    返回 甲;
}

// ① 静态标量初值
函数 形一() -> 整64 {
    整64 位 = 0;
    如果 (标量整 == 11111) { 位 = 位 + 1; }
    如果 (标量窄 == 222) { 位 = 位 + 2; }
    如果 (标量布) { 位 = 位 + 4; }
    如果 (标量浮 == 3.5) { 位 = 位 + 8; }
    如果 (字符串比较(标量串, "E246静态串初值甲乙丙丁戊")) { 位 = 位 + 16; }
    如果 (位 == 31) { 返回 1; }
    返回 0;
}

// ② 静态结构体声明位初始化
函数 形二() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 位 = 0;
    如果 (甲.号 == 101) { 位 = 位 + 1; }
    如果 (字符串比较(甲.名, "E246甲串声明位内容甲乙丙丁")) { 位 = 位 + 2; }
    // 副本独立（读多次一致性）
    如果 (字符串比较(甲.名, "E246甲串声明位内容甲乙丙丁")) { 位 = 位 + 4; }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (位 == 7) { 返回 2; }
    返回 0;
}

// ③ 语句位赋值（跨函数写 + 主 读）
函数 形三() -> 整64 {
    设甲(202);
    搅动();
    整64 位 = 0;
    如果 (甲.号 == 202) { 位 = 位 + 1; }
    如果 (字符串比较(甲.名, "E246甲串改写信道内容甲乙丙丁")) { 位 = 位 + 2; }
    如果 (位 == 3) { 返回 4; }
    返回 0;
}

// ④ 整体赋值（源=局部变量，源块先退出）
不安全 函数 形四() -> 整64 {
    {
        盒 局 = 盒{ 名 = 字符串复制("E246局串整体赋值内容甲乙丙丁"), 号 = 404 };
        甲 = 局;
    }
    搅动();
    整64 位 = 0;
    如果 (甲.号 == 404) { 位 = 位 + 1; }
    如果 (字符串比较(甲.名, "E246局串整体赋值内容甲乙丙丁")) { 位 = 位 + 2; }
    如果 (位 == 3) { 返回 8; }
    返回 0;
}

// ⑤ 静态结构体作实参（按值）
函数 形五() -> 整64 {
    盒 收 = 取参(甲);
    搅动();
    整64 位 = 0;
    如果 (收.号 == 404) { 位 = 位 + 1; }
    如果 (字符串比较(收.名, "E246局串整体赋值内容甲乙丙丁")) { 位 = 位 + 2; }
    如果 (位 == 3) { 返回 16; }
    返回 0;
}

// ⑥ 返回全局静态结构体（85-a 深拷）
函数 形六() -> 整64 {
    盒 全 = 取全局();
    搅动();
    整64 位 = 0;
    如果 (全.号 == 404) { 位 = 位 + 1; }
    如果 (字符串比较(全.名, "E246局串整体赋值内容甲乙丙丁")) { 位 = 位 + 2; }
    如果 (位 == 3) { 返回 32; }
    返回 0;
}

// ⑦ 静态结构体成员链嵌套（外层 内盒 字段读）
函数 形七() -> 整64 {
    整64 位 = 0;
    如果 (丙.标记 == 9) { 位 = 位 + 1; }
    如果 (丙.内盒.号 == 303) { 位 = 位 + 2; }
    如果 (字符串比较(丙.内盒.名, "E246丙内串声明位内容甲乙")) { 位 = 位 + 4; }
    如果 (位 == 7) { 返回 64; }
    返回 0;
}

// ⑧ 哨兵完整性 + 循环 2000 轮重复赋值残留归零
函数 形八(整64 轮数) -> 整64 {
    设甲(202);
    整64 位 = 0;
    如果 (哨兵前 == 111) { 位 = 位 + 1; }
    如果 (哨兵后 == 222) { 位 = 位 + 2; }
    整64 前 = 内存::活动分配数();
    整64 i = 0;
    当 (i < 轮数) {
        设甲(整32(i));
        i++;
    }
    整64 后 = 内存::活动分配数();
    如果 (后 != 前) { 返回 0; }
    如果 (甲.号 == 整32(轮数 - 1)) { 位 = 位 + 4; }
    如果 (位 == 7) { 返回 128; }
    返回 0;
}

函数 主() -> 整32 {
    整64 和 = 0;
    和 = 和 + 形一();
    和 = 和 + 形二();
    和 = 和 + 形三();
    和 = 和 + 形四();
    和 = 和 + 形五();
    和 = 和 + 形六();
    和 = 和 + 形七();
    和 = 和 + 形八(2000);
    打印("校验和(期望255)=", 和);
    返回 整32(和 % 256);
}
