// E2E 1730（任务 2105·2098 伞批·v2 面）：001 §1289-1303 最小授权越权锁——基类
//   友元类访问**子类自有私有成员**须双侧同拒（授权面=定义类成员：乙类被
//   基类授权访问基类成员，子密 属于 子类 不在授权面）。修前宿主 friendClasses
//   复制越权放行（p4 探针实锤 22）·v2 正确拒=分叉；2105 根修（删复制+
//   checkAccess 定义类友元表）后双侧同拒·诊断定义类口径逐字同构。
// 预期失败。
类 基类 {
私有:
    整64 基密;
公开:
    函数 基类() { 基密 = 11; }
    友元 类 乙类
}
类 子类 : 基类 {
私有:
    整64 子密;
公开:
    函数 子类() { 子密 = 22; }
}
类 乙类 {
公开:
    函数 读子密(子类& 目标) -> 整64 { 返回 目标.子密; }
}
函数 主() -> 整32 {
    子类 子 = 子类();
    乙类 乙 = 乙类();
    打印行(乙.读子密(子));
    返回 0;
}
