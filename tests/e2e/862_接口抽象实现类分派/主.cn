// E2E 862 正测（任务193 审查 P2-2·动态分派运行时锚定）：抽象类入接口实现链。
//   抽象类 几何 实现接口 形状（面积 有体·接口实现完整性满足）+ 含无体抽象成员
//   周长（=几何 为抽象类不可实例化）；具体派生类 圆 补全 周长。
//   859 三个调用静态类型全是具体派生类（走直调），本例以**接口变量**形态
//   （形状 图1 = 圆(5)·100_接口多态 先例）补「接口方法调用发射」路径的运行时
//   锚定：接口实现类含抽象类 → 去虚拟化直调排除 → 间接分派（v2 生成类尾
//   发射接口方法调用 ·宿主 ir_oop_call tryInterfaceMethodCall 同构），最近
//   重写生效（多态保留）。与 858/859/100 分工：858=实例化拒绝面，859=抽象
//   继承链直调面，100=接口多态基线，862=抽象类×接口交汇面。
// 语法依据（cn-language-spec 06 §六接口/§八抽象）：接口 虚拟 函数 签名无体；
//   类 : 接口 以 重写 函数 实现；抽象 函数 无实现体·含抽象成员的类不可实例化。
接口 形状 {
    虚拟 函数 面积() -> 整64;
}

类 几何 : 形状 {
公开:
    重写 函数 面积() -> 整64 { 返回 0; }
    抽象 函数 周长() -> 整64
}

类 圆 : 几何 {
公开:
    整64 半径;

    函数 圆(整64 r) {
        半径 = r;
    }

    重写 函数 面积() -> 整64 {
        返回 半径 * 半径 * 3;
    }

    重写 函数 周长() -> 整64 {
        返回 半径 * 6;
    }
}

函数 主() -> 整32 {
    打印("===== 接口抽象实现类分派（任务193）=====");

    // 接口变量持有具体派生类实例：间接分派·最近重写生效
    形状 图1 = 圆(5);
    打印("圆面积: ", 图1.面积());      // 5*5*3 = 75

    // 具体类直调对照：不受接口链抽象类扰动
    圆 圆直 = 圆(4);
    打印("直调面积: ", 圆直.面积());   // 4*4*3 = 48

    打印("===== 完成 =====");
    返回 0;
}
