// E2E 1557（2026-10-25 任务 1628·P1·1592 系回归锁面）：
//   显式 结果<用户泛型类实例,整32> 声明位初始化——声明类型（尖括号源码形态
//   「字符串映射<整32>」）与泛型方法实例化返回类型（$ 合成名形态「字符串映射$整32」）
//   是同一逻辑类型的两种注册文本形态（声明降级=尖括号实参嵌入结构体名；泛型实例化
//   降级=$ 合成名）。1592（40a63178c·2026-10-25 18:53）载荷同型判定为原始文本比较
//   → 误判异型 → 非标量载荷误报「内部错误: 合成体载荷隐式转换不支持」（双向实证：
//   1023 轮 g2 旧版全绿输出 60；f890b3f2e 基线拒）。
//   〔根修归属〕同根因族宿主面已由 1611（c7232ec9d·d4 链调实锚）进 develop 根治
//   （ir_synthetic_conv 载荷等价判定前 resolveGenericTypeName 物化归一·本件原
//   genericInstanceKey 文本归一方案经冲突合并让位权威修法）；v2 面由 1611 的载荷
//   提取元数感知单点（结果可选载荷元数提取1611·六消费点收口）同轮修复。本件用例
//   在最新 develop 基线实测双侧绿（宿主 60/120·v2 同源码对照绿），锁面价值=声明位
//   +赋值位双消费点（1611 的 1542 锁 .值.方法() 链式消费点·两者互补成族）。
//   逐值锚：分=60·合=120（宿主/v2 双侧同源码·零分叉）。
导入 映射集合::映射;
导入 映射集合::字符串映射;
函数 主() -> 整32 {
    映射<整32, 字符串映射<整32>> 双 = 映射<整32, 字符串映射<整32>>();
    字符串映射<整32> 内 = 字符串映射<整32>();
    结果<空类型, 整32> w = 内.设置("分", 60);
    如果 (!w.正常) { 打印("设内败"); }
    w = 内.设置("合", 120);
    如果 (!w.正常) { 打印("设内2败"); }
    w = 双.设置(1, 内);
    如果 (!w.正常) { 打印("设双败"); }
    结果<字符串映射<整32>, 整32> 外 = 双.获取(1);
    如果 (外.正常) {
        字符串映射<整32> 层 = 外.值;
        结果<整32, 整32> 分 = 层.获取("分");
        如果 (分.正常) { 打印(分.值); } 否则 { 打印("缺分"); }
    } 否则 { 打印("缺外"); }
    外 = 双.获取(1);
    如果 (外.正常) {
        字符串映射<整32> 层2 = 外.值;
        结果<整32, 整32> 合 = 层2.获取("合");
        如果 (合.正常) { 打印(合.值); } 否则 { 打印("缺合"); }
    } 否则 { 打印("缺外2"); }
    返回 0;
}
