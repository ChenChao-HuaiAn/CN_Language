//   前缀字面量 + 边界值 + 跨函数读（修前 .data 恒零占位/半槽写两缺口）。
静态 整128 甲 = 42;
静态 整128 乙 = -5;
静态 整128 丙 = 170141183460469231731687303715884105727;
静态 整128 丁 = -170141183460469231731687303715884105728;
静态 整128 戊 = 0xDEADBEEFCAFEBABE;
静态 整128 己 = 0;
