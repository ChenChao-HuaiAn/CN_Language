// E2E 217（2026-09-11 第七十三轮 plans/020 移植纪律 9 的门禁化）：
//   **同结构双编译器对照**——同一份源码经宿主真实管线与 v2 自举链各编译运行，
//   两侧退出码须相等（runner「双编译对照」编排断言：宿主侧 == 用例期望值 且
//   v2 侧 == 宿主侧实测值）。这是发现「重实现分叉」的门禁：宿主与 v2 是两套
//   独立实现，同一机制两侧各自重写——73-a 实证 v2 块级 RAII 从未生效而 v2
//   用例族全绿（那些用例只断言内容，泄漏不改内容）。
//   覆盖 73-a 修复的两种机制 × 两侧共有语义面：
//     ① 循环体内声明 + 继续（跳出 drop-on-jump）
//     ② 循环体内声明 + 中断（同上，含首轮自然回边）
//     ③ 循环体内声明 + 自然回边（块出口析构）
//     ④ 如果体内声明（嵌套块出口析构）
//     ⑤ 循环体内容器 + 继续（容器析构路径）
//   断言口径与 E2E 213/216_v2 同一模型：每形态调用前后 内存::活动分配数()
//   差值恒 0，折入校验和（127=全对）。两侧任一形态的释放机制失效→该校验位
//   丢失→退出码变化→对照失败（含"晚释放/不释放"这类内容测试抓不到的形态）。
导入 容器::向量;

// ① 继续路径：每轮声明拥有串后立即跳出（跳出前须 drop）
函数 继续路径(整64 轮数) -> 整64 {
    整64 i = 0;
    整64 累计 = 0;
    当 (i < 轮数) {
        字符串 每轮 = 字符串复制("双编译对照·继续路径循环体拥有串占位内容甲乙丙丁");
        累计 = 累计 + 字符串长度(每轮);
        i++;
        继续;
    }
    返回 累计;
}

// ② 中断路径：首轮自然回边，第二轮起 中断 跳出
函数 中断路径(整64 轮数) -> 整64 {
    整64 轮次 = 0;
    当 (轮次 < 轮数) {
        字符串 每轮 = 字符串复制("双编译对照·中断路径循环体拥有串占位内容甲乙丙丁");
        如果 (轮次 >= 2) { 中断; }
        轮次++;
    }
    返回 轮次;
}

// ③ 自然回边：无跳出语句（块出口析构）
函数 自然回边(整64 轮数) -> 整64 {
    整64 i = 0;
    整64 累计 = 0;
    当 (i < 轮数) {
        字符串 每轮 = 字符串复制("双编译对照·自然回边循环体拥有串占位内容甲乙丙丁");
        累计 = 累计 + 字符串长度(每轮);
        i++;
    }
    返回 累计;
}

// ④ 如果体内声明（嵌套块出口析构）
函数 如果体(整64 轮数) -> 整64 {
    整64 i = 0;
    当 (i < 轮数) {
        如果 (i >= 0) {
            字符串 体内 = 字符串复制("双编译对照·如果体内拥有串占位内容甲乙丙丁戊己");
        }
        i++;
    }
    返回 i;
}

// ⑤ 循环体内容器 + 继续（容器析构 + 跳出释放）
函数 容器跳出(整64 轮数) -> 整64 {
    整64 i = 0;
    当 (i < 轮数) {
        向量<整64> 表 = 向量<整64>();
        结果<空类型, 整32> 加 = 表.追加(i);
        i++;
        继续;
    }
    返回 i;
}

函数 主() -> 整32 {
    整32 校验 = 0;
    // ① 跳出 drop-on-jump（字符串）
    整64 基1 = 内存::活动分配数();
    整64 甲 = 继续路径(5000);
    如果 (甲 == 5000 * 71 && 内存::活动分配数() == 基1) { 校验 = 校验 + 1; }
    // ② 中断跳出（含自然回边）
    整64 基2 = 内存::活动分配数();
    整64 乙 = 中断路径(5000);
    如果 (乙 == 2 && 内存::活动分配数() == 基2) { 校验 = 校验 + 2; }
    // ③ 块出口析构（自然回边）
    整64 基3 = 内存::活动分配数();
    整64 丙 = 自然回边(5000);
    如果 (丙 == 5000 * 71 && 内存::活动分配数() == 基3) { 校验 = 校验 + 4; }
    // ④ 嵌套块出口析构（如果体）
    整64 基4 = 内存::活动分配数();
    整64 丁 = 如果体(5000);
    如果 (丁 == 5000 && 内存::活动分配数() == 基4) { 校验 = 校验 + 8; }
    // ⑤ 容器析构 + 跳出
    整64 基5 = 内存::活动分配数();
    整64 戊 = 容器跳出(5000);
    如果 (戊 == 5000 && 内存::活动分配数() == 基5) { 校验 = 校验 + 16; }
    返回 校验;
}
