// E2E 67_generic_param：泛型实例化类型作函数参数（自举前置 A-3a，2026-08）
// 覆盖：向量<字符串>/向量<整64> 参数、参数方法调用、多容器参数、跨模块容器
//   参数（注：字符串键 映射 需泛型类型分派（P1），此处用 整64 键）
// 语法依据：plans/004 缺口 A-3a（parseParamDecl 模板判定 + registerFunction
//   实例符号名统一，与类方法 resolveGenericTypeName 路径一致）
导入 容器::向量;
导入 映射集合::映射;

函数 词频统计(向量<字符串> 词表) -> 整64 {
    返回 词表.大小();
}

函数 总和(向量<整64> 数据) -> 整64 {
    整64 合计 = 0;
    整64 i = 0;
    当 (i < 数据.大小()) {
        合计 += 数据.元素(i);
        i++;
    }
    返回 合计;
}

函数 双表大小(向量<字符串> 甲, 向量<整64> 乙) -> 整64 {
    返回 甲.大小() + 乙.大小();
}

函数 映射查找(映射<整64, 整64> 表, 整64 键) -> 整64 {
    结果<整64, 整32> 取 = 表.获取(键);
    如果 (取.正常) {
        返回 取.值;
    } 否则 {
        返回 -1;
    }
}

函数 主() -> 整32 {
    打印("===== 泛型实例化类型作函数参数 =====");
    向量<字符串> 词表 = 向量<字符串>();
    结果<空类型, 整32> 加1 = 词表.追加("你好");
    结果<空类型, 整32> 加2 = 词表.追加("世界");
    如果 (加1.正常 && 加2.正常) {
        打印("词频统计:", 词频统计(词表));
    }
    向量<整64> 数据 = 向量<整64>();
    结果<空类型, 整32> 加3 = 数据.追加(10);
    结果<空类型, 整32> 加4 = 数据.追加(20);
    结果<空类型, 整32> 加5 = 数据.追加(30);
    如果 (加3.正常 && 加4.正常 && 加5.正常) {
        打印("数据总和:", 总和(数据));
    }
    打印("双表大小:", 双表大小(词表, 数据));
    映射<整64, 整64> 表 = 映射<整64, 整64>();
    结果<空类型, 整32> 设 = 表.设置(100, 7);
    如果 (设.正常) {
        打印("映射查找100:", 映射查找(表, 100));
        打印("映射查找200:", 映射查找(表, 200));
    }
    返回 0;
}
