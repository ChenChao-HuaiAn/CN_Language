// E2E 1386：结构体.合成体字段/数组元素 读写链四形态（#964·920 呈报·双编译对照）
// 病面（修前 v2·探针 pa1~pa5 实录·宿主真值绿）：
//   ①写位 结构体.结果字段=聚合调用（甲.值槽=造4(11)）
//   ②读位 甲.值槽.值.甲 链读 / .值落变量 → v2 崩溃 rc139
//     （多一级解引用：内联载荷被当标量取值再解引用；宿主=[甲基址+8] 直接读）
//   ③数组元素 直元[0]=造4(77) + 元素链读 直元[0].值.甲 → v2 崩溃
//   ④变量.字段与数组元素写位（右值=结果变量）→ v2 崩溃
// 根因（v2 侧三处·判据单点）：
//   ① 解析字段三元组 下标对象回填误用 推导下标元素类型ID（对下标表达式恒 0）
//      → 成员对象类型ID 恒 0 → 结果兜底/载荷结构体判定全 miss；
//   ② 解析结果可选兜底 成员对象类型ID 缺 &（值参数·回填传不回调用方）；
//   ③ 成员载荷是结构体 只认标识符对象（链中间合成体/下标对象形态漏判）；
//   ④ 尝试成员合成体整体写 的 __cn_box_field_str_copy 无条件调用（非字符串
//      载荷把载荷值当字符串指针）。
// 锁面=四形态逐值输出（宿主真值 11/31/77/88/99·双侧逐字一致）+ 哨兵防越界。
结构体 盒4 {
    整32 甲;
}
函数 造4(整32 载荷) -> 结果<盒4, 整32> {
    盒4 盒;
    盒.甲 = 载荷;
    返回 正常(盒);
}
结构体 包装4 {
    结果<盒4, 整32> 值槽;
    整32 哨兵;
}
函数 主() -> 整32 {
    // 形态①：结构体.结果字段 = 聚合调用（写位）
    包装4 甲;
    甲.哨兵 = 99;
    甲.值槽 = 造4(11);
    打印行("哨兵=", 甲.哨兵);
    // 形态②：链读 + .值落变量 + .值落结构体
    如果 (!甲.值槽.正常) { 返回 1; }
    打印行("链=", 甲.值槽.值.甲);
    整32 落 = 甲.值槽.值.甲;
    打印行("落=", 落);
    盒4 盒落 = 甲.值槽.值;
    打印行("盒落=", 盒落.甲);
    // 形态③：数组元素 = 聚合调用（写位）+ 元素链读
    结果<盒4, 整32>[2] 直元;
    直元[0] = 造4(77);
    直元[1] = 造4(88);
    如果 (!直元[0].正常) { 返回 2; }
    如果 (!直元[1].正常) { 返回 3; }
    打印行("x=", 直元[0].值.甲);
    打印行("y=", 直元[1].值.甲);
    // 形态④：变量.字段与数组元素写位（右值=结果变量）
    结果<盒4, 整32> 读 = 造4(31);
    如果 (!读.正常) { 返回 4; }
    包装4 乙;
    乙.值槽 = 读;
    如果 (!乙.值槽.正常) { 返回 5; }
    打印行("字段=", 乙.值槽.值.甲);
    结果<盒4, 整32>[1] 直素;
    直素[0] = 读;
    如果 (!直素[0].正常) { 返回 6; }
    打印行("元素=", 直素[0].值.甲);
    打印行("原=", 读.值.甲);
    返回 0;
}
