// E2E 243（2026-09-12 第八十六轮 86-a，plans/020 移植纪律 9 门禁化·第十四个对照用例）：
//   **三元运算符 × 聚合类型（消费位全链）**——同一份源码经宿主真实管线与 v2 自举链
//   各编译运行，两侧退出码须相等。
//   背景（86-a 复审 P41/P46/P47 实证）：`(条件 ? 甲 : 乙)` 两分支为含拥有型串字段
//   的结构体时，原实现存在三个断点——宿主 `isBorrowedAggregateSource` 判定表
//   default 把三元当「拥有来源」（返回位不深拷 → 悬垂乱码）；宿主各消费位的类型
//   推导（exprSrcType/赋值位/memberObjStructType）与 v2 侧（解析节点类型ID/
//   声明位/赋值位/成员偏移/实参回扫）均缺三元形态（标量 8 字节路径静默损坏 /
//   v2 返回位段错误 rc=139）。修复=三元聚合**地址透传**（选中 place 地址）+
//   各消费位三元形态补全 + T_对象 登记（实参回扫跳过）。
//   交叉验证手法：**跨块读取**（候选源已退出作用域释放）+ 内存搅动 + 内容逐字节
//   比较 + 残留归零断言。
//   七形态（两侧共有语义面；容器插入位=宿主单侧 E2E 245）：
//     ① 赋值位（`收 = (条?甲:乙)` 跨块）② 声明位 ③ 实参+返回位（借用形参）
//     ④ 实参成员链分支  ⑤ 成员位赋值（`乙箱.内盒 = (条?甲:乙)`）
//     ⑥ 嵌套三元  ⑦ 三元成员基（`(条?甲:乙).号`）
//     ⑧ 返回 (条?借用形参:借用形参)（缺陷①原始形态：返回位判定 × 三元）
//   校验和折位：①1 ②2 ③4 ④8 ⑤16 ⑥32 ⑦64 ⑧128 —— 255=全对。
//   两侧任一退回「标量 8 字节路径 / 三元不深拷」→ 对应位丢失 → 退出码变化 → 失败。
//   平台守卫=linux 双平台（宿主与 v2 同链；win-x64 v2 产物未隔离=家机轮）。
结构体 盒 {
    字符串 名;
    整32 号;
}
结构体 箱 {
    盒 内盒;
    整32 标记;
}

函数 搅动() -> 整64 {
    整64 和 = 0;
    整64 i = 0;
    当 (i < 16) {
        字符串 垃圾 = 字符串复制("E243搅动内存填充占位字符串内容甲乙丙丁戊己庚辛壬癸");
        和 = 和 + 字符串长度(垃圾);
        i++;
    }
    返回 和;
}

// ③ 实参 + 返回位（借用形参：返回位深拷由 85-a 面保证）
函数 取盒(盒 参) -> 盒 {
    返回 参;
}

// ① 赋值位（跨块读取）
函数 形一() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        盒 收;
        {
            盒 甲 = 盒{ 名 = 字符串复制("E243形一真串甲甲甲甲甲甲甲甲甲甲"), 号 = 1 };
            盒 乙 = 盒{ 名 = 字符串复制("E243形一假串乙乙乙乙乙乙乙乙乙乙"), 号 = 2 };
            收 = (真 ? 甲 : 乙);
        }
        搅动();
        如果 (字符串比较(收.名, "E243形一真串甲甲甲甲甲甲甲甲甲甲")) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 1) { 返回 1; }
    返回 0;
}

// ② 声明位初始化
函数 形二() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        盒 甲 = 盒{ 名 = 字符串复制("E243形二真串甲甲甲甲甲甲甲甲甲甲"), 号 = 3 };
        盒 乙 = 盒{ 名 = 字符串复制("E243形二假串乙乙乙乙乙乙乙乙乙乙"), 号 = 4 };
        盒 收 = (假 ? 甲 : 乙);
        搅动();
        如果 (字符串比较(收.名, "E243形二假串乙乙乙乙乙乙乙乙乙乙")) { 校验 = 1; }
        如果 (收.号 == 4) { 校验 = 校验 + 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 2) { 返回 2; }
    返回 0;
}

// ③ 实参位 + 返回位（借用形参）
函数 形三() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        盒 收;
        {
            盒 甲 = 盒{ 名 = 字符串复制("E243形三真串甲甲甲甲甲甲甲甲甲甲"), 号 = 5 };
            盒 乙 = 盒{ 名 = 字符串复制("E243形三假串乙乙乙乙乙乙乙乙乙乙"), 号 = 6 };
            收 = 取盒(真 ? 甲 : 乙);
        }
        搅动();
        如果 (字符串比较(收.名, "E243形三真串甲甲甲甲甲甲甲甲甲甲")) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 1) { 返回 4; }
    返回 0;
}

// ④ 实参位（成员链分支）
函数 形四() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        盒 收;
        {
            盒 甲 = 盒{ 名 = 字符串复制("E243形四真串甲甲甲甲甲甲甲甲甲甲"), 号 = 7 };
            盒 乙 = 盒{ 名 = 字符串复制("E243形四假串乙乙乙乙乙乙乙乙乙乙"), 号 = 8 };
            箱 乙箱 = 箱{ 内盒 = 乙, 标记 = 2 };
            收 = 取盒(真 ? 甲 : 乙箱.内盒);
        }
        搅动();
        如果 (字符串比较(收.名, "E243形四真串甲甲甲甲甲甲甲甲甲甲")) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 1) { 返回 8; }
    返回 0;
}

// ⑤ 成员位赋值
函数 形五() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        箱 乙箱;
        {
            盒 甲 = 盒{ 名 = 字符串复制("E243形五真串甲甲甲甲甲甲甲甲甲甲"), 号 = 9 };
            盒 乙 = 盒{ 名 = 字符串复制("E243形五假串乙乙乙乙乙乙乙乙乙乙"), 号 = 10 };
            乙箱 = 箱{ 内盒 = 乙, 标记 = 1 };
            乙箱.内盒 = (真 ? 甲 : 乙);
        }
        搅动();
        如果 (字符串比较(乙箱.内盒.名, "E243形五真串甲甲甲甲甲甲甲甲甲甲")) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 1) { 返回 16; }
    返回 0;
}

// ⑥ 嵌套三元（外层真→内层假→丙）
函数 形六() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        盒 收;
        {
            盒 甲 = 盒{ 名 = 字符串复制("E243形六真串甲甲甲甲甲甲甲甲甲甲"), 号 = 11 };
            盒 乙 = 盒{ 名 = 字符串复制("E243形六串乙乙乙乙乙乙乙乙乙乙乙乙乙"), 号 = 12 };
            盒 丙 = 盒{ 名 = 字符串复制("E243形六串丙丙丙丙丙丙丙丙丙丙丙丙丙"), 号 = 13 };
            收 = (真 ? (假 ? 乙 : 丙) : 甲);
        }
        搅动();
        如果 (字符串比较(收.名, "E243形六串丙丙丙丙丙丙丙丙丙丙丙丙丙")) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 1) { 返回 32; }
    返回 0;
}

// ⑦ 三元成员基（读字段）+ 实参
函数 形七() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        盒 收;
        {
            盒 甲 = 盒{ 名 = 字符串复制("E243形七真串甲甲甲甲甲甲甲甲甲甲"), 号 = 14 };
            盒 乙 = 盒{ 名 = 字符串复制("E243形七假串乙乙乙乙乙乙乙乙乙乙"), 号 = 15 };
            整32 号V = (真 ? 甲 : 乙).号;
            如果 (号V == 14) { 校验 = 校验 + 1; }
            如果 (字符串比较((真 ? 甲 : 乙).名, "E243形七真串甲甲甲甲甲甲甲甲甲甲")) {
                校验 = 校验 + 1;
            }
            收 = 取盒(真 ? 甲 : 乙);
        }
        搅动();
        如果 (字符串比较(收.名, "E243形七真串甲甲甲甲甲甲甲甲甲甲")) { 校验 = 校验 + 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 3) { 返回 64; }
    返回 0;
}

// ⑧ 返回 (条 ? 借用形参 : 借用形参)——缺陷①原始形态（P41/P86）：
//   被调方返回表达式=三元（两分支均为按值形参=借用来源）→ 85-a 返回位判定
//   的 TernaryExpr 递归分支必须命中 → 深拷归一化；否则返回值句柄与调用方
//   place 共享 → 悬垂乱码（宿主）/ 段错误（v2 修复前 rc=139）。
函数 三选(盒 甲, 盒 乙, 布尔 条) -> 盒 {
    返回 (条 ? 甲 : 乙);
}

函数 形八() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        盒 收;
        {
            盒 甲 = 盒{ 名 = 字符串复制("E243形八真串甲甲甲甲甲甲甲甲甲甲"), 号 = 16 };
            盒 乙 = 盒{ 名 = 字符串复制("E243形八假串乙乙乙乙乙乙乙乙乙乙"), 号 = 17 };
            收 = 三选(甲, 乙, 真);
        }
        搅动();
        如果 (字符串比较(收.名, "E243形八真串甲甲甲甲甲甲甲甲甲甲")) { 校验 = 1; }
        如果 (收.号 == 16) { 校验 = 校验 + 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 2) { 返回 128; }
    返回 0;
}

函数 主() -> 整32 {
    整64 和 = 形一() + 形二() + 形三() + 形四();
    和 = 和 + 形五() + 形六() + 形七() + 形八();
    返回 整32(和);
}
