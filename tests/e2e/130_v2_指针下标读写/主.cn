// E2E 130_v2_指针下标读写（③ 自举对拍第三波，2026-09-03）
// 载体动因：v2p 编译 v2 组件（语法分析.cn）冒烟语义崩点=指针出参下标——
//   函数 解析类型文本(向量<Token> 记号, 整64* 位置) 内 位置[0] 读+写十余处
//   （语法分析.cn:652~672：条件比较/调用实参/强转操作数/循环推进/吃符号自增）。
//   宿主语义权威（ir_expr.cpp:1555 指针分支）：p[i] ≡ *(p + i)，步进=所指元素
//   大小（ptrElemStride）；下标左值=地址计算+StorePtr（目标类型=所指元素类型，
//   ir_expr.cpp:981~1003）。v2 本轮四层补齐：语义层指针对象白名单（指针变量表
//   登记：参数/局部 类型节点 附加=指针层数 1..255）+下标左值放行（指针对象）；
//   IR 层 下标读分支（步进=元素宽度/LoadPtr 元素宽度码/结果登记类型码）+
//   左值地址生成下标分支（读对象槽值+下标缩放）+赋值存储宽度=元素宽度码。
// 闭环：v2p 编译 -> ml64/link 宿主运行时 -> 运行。退出码=0 全过；11~26 失败码。
结构体 三元组 {
    整32 甲;
    整32 乙;
    整32 丙;
}

结构体 大三元 {
    整64 甲;
    整64 乙;
    整64 丙;
}
// 注：整8* 步进 1 形态未入本用例——v2 强转白名单（整8/整16 窄宽）为已知
//   边界（语义层显式拒绝，非静默），宿主侧已由 整8(常量) 窄宽存储根治覆盖。

// 出参推进（语法分析.cn:654 位置[0] = 位置[0] + 1 同款形态）
函数 推进(整64* 位置) -> 空类型 {
    位置[0] = 位置[0] + 1;
}

// 出参条件读取（语法分析.cn:652 当前类型(记号, 位置[0]) 条件比较同款）
函数 读取(整64* 位置) -> 整64 {
    如果 (位置[0] == 5) { 返回 位置[0] * 2; }
    返回 位置[0];
}

// 出参循环推进（语法分析.cn:661~670 当(真){...位置[0] = 位置[0] + 1...}
//   泛型实参循环同款：下标条件 + 复合赋值改写 形态）
函数 累计推进(整64* 位置, 整64 上限) -> 整64 {
    整64 次数 = 0;
    当 (位置[0] < 上限) {
        位置[0] += 1;
        次数++;
    }
    返回 次数;
}

// 指针值参数写透（指针参数的 目标[0] = 值——指向结构体字段的指针传值）
函数 写入(整32* 目标, 整32 值) -> 空类型 {
    目标[0] = 值;
}

函数 主() -> 整32 {
    // ===== 一、出参模式（崩点核心：& 取地址传参 + 出参下标读/写）=====
    整64 位置 = 41;
    推进(&位置);
    如果 (位置 != 42) { 返回 11; }
    如果 (读取(&位置) != 42) { 返回 12; }
    位置 = 5;
    如果 (读取(&位置) != 10) { 返回 13; }
    位置 = 0;
    如果 (累计推进(&位置, 4) != 4) { 返回 14; }
    如果 (位置 != 4) { 返回 15; }

    // ===== 二、步进 4（整32 结构体字段指针：真实布局 0/4/8——B1 自然对齐）=====
    三元组 t;
    整32* p = &t.甲;
    p[0] = 11;
    p[1] = 22;
    p[2] = 33;
    如果 (t.甲 != 11 || t.乙 != 22 || t.丙 != 33) { 返回 16; }
    如果 (p[0] + p[1] + p[2] != 66) { 返回 17; }
    // 二元表达式下标（语法分析.cn:658 泛型闭合位置(记号, 位置[0]) 实参同款）
    如果 (p[3 - 1] != 33) { 返回 18; }
    // 负下标（q 指向 丙：q[-1]=乙 / q[-2]=甲——负步进方向，宿主 *(p+i) 语义）
    整32* q = &t.丙;
    如果 (q[0] != 33) { 返回 19; }
    如果 (q[-1] != 22) { 返回 20; }
    如果 (q[-2] != 11) { 返回 21; }
    // 复合赋值（解析层改写 p[1] = p[1] + 5——下标左值复合赋值）
    p[1] += 5;
    如果 (t.乙 != 27) { 返回 22; }
    // 写透函数（指针值参数：目标[0] = 值）
    写入(&t.甲, 77);
    如果 (t.甲 != 77) { 返回 23; }

    // ===== 三、步进 8（整64 字段指针：布局 0/8/16）=====
    大三元 u;
    整64* r = &u.甲;
    r[0] = 100;
    r[1] = 200;
    r[2] = 300;
    如果 (u.甲 + u.乙 + u.丙 != 600) { 返回 24; }
    如果 (r[2] - r[0] != 200) { 返回 25; }

    // ===== 四、下标作强转操作数（语法分析.cn:653 整64(当前ID(记号, 位置[0])) 同款）=====
    如果 (整64(p[0]) != 77) { 返回 26; }
    如果 (整64(r[1]) != 200) { 返回 27; }

    // 运行时人眼审计锚点（退出码断言之外的产物输出）
    打印(位置);          // 4
    打印(p[0]);          // 77
    打印("指针下标读写: 全部通过");
    返回 0;
}
