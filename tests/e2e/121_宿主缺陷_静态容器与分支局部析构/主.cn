导入 容器::向量;
导入 映射集合;

// E2E 121（宿主缺陷回归，2026-09-01，三项根治验收）：
//   缺陷一：无初始化器顶层静态容器（静态 向量/映射 表）——原实现按「有无初始化
//     表达式」分裂两种模型（对象内联 .data vs 指针槽），读取路径 LoadPtr 只对指针
//     模型正确：无初始化静态被读出首 8 字节字段当对象指针，复制/赋值/方法调用全错
//     （实测 运行时错误3 空指针崩溃，v2 组件链 E2E 119 因此从未真正通过）。
//     根治：类静态统一指针槽模型（NewObject+构造+StorePtr 入槽，与局部类变量同构）。
//   缺陷二：分支未执行时类局部（向量 分支局部）被无条件 RAII 析构——声明所在分支
//     未走时槽为未初始化栈垃圾，函数收尾 ~向量 析构野指针（5 行最小复现 100% 崩溃）。
//     根治：类局部槽零初始化 + DeleteObject 空安全跳过（x64/arm64 双后端）。
//   缺陷三：块顶层级中途 返回 被无视——后续死代码照跑且末尾 返回 覆盖返回值
//     （返回 5 实得 7）。根治：块终止后跳过剩余语句。
静态 向量<整32> 模块们;
静态 映射<整64, 整64> 偏移表;

函数 取走() -> 向量<整32> {
    向量<整32> 副本 = 模块们;
    模块们 = 向量<整32>();
    返回 副本;
}

函数 中途返回() -> 整64 {
    整64 a = 1;
    返回 5;
    a = 2;
    返回 7;
}

函数 主() -> 整32 {
    // 缺陷一：静态容器 追加/设置/复制/赋值重置/大小 全链路
    结果<空类型, 整32> 加1 = 模块们.追加(7);
    如果 (!加1.正常) { 返回 1; }
    结果<空类型, 整32> 加2 = 模块们.追加(9);
    如果 (!加2.正常) { 返回 1; }
    结果<空类型, 整32> 设 = 偏移表.设置(9, 200);
    如果 (!设.正常) { 返回 1; }
    向量<整32> 拿到 = 取走();
    如果 (拿到.大小() != 2) { 返回 2; }
    如果 (模块们.大小() != 0) { 返回 3; }
    如果 (偏移表.大小() != 1) { 返回 4; }
    整64 查值 = 0;
    结果<整64, 整32> 查 = 偏移表.获取(9);
    如果 (查.正常) {
        查值 = 查.值;
    } 否则 {
        返回 5;
    }
    如果 (查值 != 200) { 返回 6; }
    // 缺陷二：分支未执行——收尾析构不得触碰未初始化槽（原 100% 崩溃）
    整64 开关 = 1;
    如果 (开关 == 0) {
        向量<整64> 分支局部 = 向量<整64>();
        结果<空类型, 整32> 加3 = 分支局部.追加(1);
        如果 (!加3.正常) { 返回 1; }
    }
    // 缺陷三：中途 返回 生效（死代码不得覆盖返回值）
    如果 (中途返回() != 5) { 返回 7; }
    打印("静态容器复制赋值方法调用全通过");
    打印("分支未执行局部析构安全");
    打印("中途返回生效");
    返回 0;
}
