// E2E 551（任务 102 甲案·2026-09-29 用户裁决·〔基准=019〕·090 丙案「默认=值副本」兑现）：
//   字符串值形参＝独立副本——被调方对形参**重赋值**（消耗①）/**转移()**（消耗②）
//   时，调用方缓冲区必须完好（原缺陷：借用句柄直传+被调方释放旧值＝释放调用方
//   缓冲区，885 实证 132 次重复释放）；**非消耗形参**（只读）直传零拷贝（第四句
//   拷贝消除：字符串无原地写·只读借用别名不可观察）——无观察差异。
//   断言：三函数调用后 甲 内容/长度不变；占位串（同档位不同内容）排除「已释放
//   内存恰未复用」假绿；退出码 0=全对。
函数 重赋层(字符串 名) -> 整64 {
    名 = 名 + "X";                    // 消耗①：标识符左值赋值（触发深拷）
    名 = 名 + "Y";                    // 二次重赋值（多次消耗·旧值释放路径）
    返回 字符串长度(名);
}

函数 移交层(字符串 名) -> 整64 {
    整64 n = 字符串长度(转移(名));    // 消耗②：转移(形参)（触发深拷·源槽清零作用于副本）
    返回 n;
}

函数 调用层(字符串 名) -> 整64 {
    // 本层非消耗（只读）→ 直传零拷贝；内层消耗 → 各自深拷
    返回 重赋层(名) + 移交层(名) + 字符串长度(名);
}

函数 主() -> 整32 {
    字符串 甲 = 字符串复制("甲乙丙丁戊己庚辛甲乙丙丁戊己庚辛");
    整64 前 = 字符串长度(甲);
    整64 内 = 调用层(甲);
    字符串 占位 = 字符串复制("ZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZ");   // 同档位异内容
    打印("前=" + 整数转字符串(前));
    打印("后=" + 甲);
    打印("占=" + 占位);
    打印("内=" + 整数转字符串(内));
    如果 (字符串比较(甲, "甲乙丙丁戊己庚辛甲乙丙丁戊己庚辛") && 前 == 48 && 内 == 146) {
        返回 0;
    }
    返回 1;
}
