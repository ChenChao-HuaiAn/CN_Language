// 1419：枚举情况标签定向解析（1193 正例 dual）
// 锁面：
//   ①同枚举限定标签（颜色.绿）按值匹配；
//   ②裸成员名按**条件枚举类型**定向解析（规范 03 §3.4 一致性约束）；
//   ③整数值标签对枚举条件按整32 值匹配（1137 P0-C 甲案·宿主同口径）；
//   ④跨枚举限定标签按值匹配（规范未禁止归属校验·宿主同口径·零分叉保留）；
//   ⑤裸名定向：形状.红=5 与 颜色.红=0 同名跨枚举——必须取条件枚举（颜色）
//     的 0（修前 v2 全局裸名表被形状.红 覆盖取 5=运行结果分叉）；
//   ⑥限定枚举标签对整条件按值匹配（宿主同口径）。
枚举 颜色 { 红, 绿, 蓝 }
枚举 形状 { 红 = 5, 圆 = 0, 方 }

函数 主() -> 整32 {
    // ① 同枚举限定标签
    颜色 c1 = 颜色.绿;
    选择 (c1) {
        情况 颜色.绿:
            打印("同枚举限定:绿");
            中断;
        默认:
            打印("同枚举限定:默认");
    }
    // ② 裸成员名（条件枚举 颜色 定向解析）
    颜色 c2 = 颜色.蓝;
    选择 (c2) {
        情况 蓝:
            打印("裸名同枚举:蓝");
            中断;
        默认:
            打印("裸名同枚举:默认");
    }
    // ③ 整数值标签对枚举条件（按整32 值匹配）
    颜色 c3 = 颜色.绿;
    选择 (c3) {
        情况 1:
            打印("整数值标签:1");
            中断;
        默认:
            打印("整数值标签:默认");
    }
    // ④ 跨枚举限定标签按值匹配（颜色.红=0 与 形状.圆=0）
    形状 c4 = 形状.圆;
    选择 (c4) {
        情况 颜色.红:
            打印("跨枚举限定:值0");
            中断;
        默认:
            打印("跨枚举限定:默认");
    }
    // ⑤ 裸名定向（同名成员跨枚举：取 颜色.红=0 而非 形状.红=5）
    颜色 c5 = 颜色.红;
    选择 (c5) {
        情况 红:
            打印("裸名定向:颜色红0");
            中断;
        默认:
            打印("裸名定向:默认");
    }
    // ⑥ 限定枚举标签对整条件按值匹配（颜色.蓝=2）
    整32 c6 = 2;
    选择 (c6) {
        情况 颜色.蓝:
            打印("整数条件限定枚举:2");
            中断;
        默认:
            打印("整数条件限定枚举:默认");
    }
    返回 0;
}
