// 535 合成体消费面四亚型（任务 061·804 轮转正·2026-09-27）
// A 合成体数组 / B 静态局部×合成体（guard 首次执行初始化）/
// C 顶层静态×内置构造器初值（动态初始化注入）/ D 容器泛型实参=合成体
// 立账样本=tests/cnsmith_hits/build_err/p0927_03~05（探针矩阵 v3）
// v2 同构缺口：v2 树静态局部 guard/合成体数组面随 C24 逐波清偿（021 §三 C24）
导入 容器::向量;

静态 结果<整32, 整32> 全局缓存 = 正常(9);

函数 取缓存() -> 结果<整32, 整32> {
    静态 结果<整32, 整32> 槽 = 正常(7);
    返回 槽;
}

函数 主() -> 整32 {
    // A：合成体数组声明+下标读写+元素取值
    结果<整32, 整32>[2] 组;
    组[0] = 正常(5);
    组[1] = 错误(42);
    结果<整32, 整32> va = 组[0];
    如果 (va.正常) {
        打印行("A值=", va.值);
    } 否则 { 返回 3; }
    结果<整32, 整32> vb = 组[1];
    如果 (vb.正常) {
        返回 3;
    } 否则 {
        打印行("A错=", vb.错误);
    }
    // B：静态局部合成体（跨调用一次初始化）
    结果<整32, 整32> rb = 取缓存();
    如果 (rb.正常) {
        打印行("B值=", rb.值);
    } 否则 { 返回 4; }
    // C：顶层静态合成体+内置构造器初值
    如果 (全局缓存.正常) {
        打印行("C值=", 全局缓存.值);
    } 否则 { 返回 5; }
    // D：容器泛型实参=合成体（追加/元素/扩容释放链）
    向量<结果<整32, 整32>> 表 = 向量<结果<整32, 整32>>();
    结果<空类型, 整32> 追 = 表.追加(正常(31));
    如果 (追.正常) {
        打印行("D追=正常");
    } 否则 { 返回 6; }
    结果<整32, 整32> 取 = 表.元素(0);
    如果 (取.正常) {
        打印行("D值=", 取.值);
    } 否则 { 返回 7; }
    返回 0;
}
