// E2E 1488（1471 正例·不安全区组合形态合法矩阵锁面）：不安全 函数内
//   (括号解引用+成员访问) 全形态合法（B6/B7 豁免）——组合读/组合字段读/
//   多级组合读/方法调用组合读/组合成员写/组合成员自增/解引用直写。
//   与 1487 负例成对（同一安全区判定的放行面锚）。
//   期望：105 / 9 / 20 / 10 / 8 逐行（打印）。
类 基 { 公开: 整32 v; 函数 名() -> 整32 { 返回 v + 100; } }
类 派 : 基 { 公开: 整32 w; }
结构体 点 {
    整32 x;
    整32 y;
}
不安全 函数 矩阵() -> 整32 {
    派 p = 派();
    p.v = 5;
    基* pb = &p;
    整32 a = (*pb).名();
    打印(a);
    点 值 = 点{ x = 1, y = 2 };
    点* q = &值;
    (*q).x = 9;
    打印(值.x);
    点** qq = &q;
    (**qq).y = 20;
    打印(值.y);
    (*q).x++;
    打印(值.x);
    整32 目标 = 7;
    整32* 目针 = &目标;
    (*目针) = 8;
    打印(目标);
    返回 0;
}
函数 主() -> 整32 {
    矩阵();
    返回 0;
}
