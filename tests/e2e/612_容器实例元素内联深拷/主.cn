导入 容器::向量;
导入 映射集合;

// 612（221 r32 修⑱ 转正）：容器实例元素=内联深拷（001 §5.3 值语义+「容器按
//   元素真实大小分配」条文·宿主同构）——回归锚=修②句柄模型与析构链注入
//   （内联步进）存储模型混一的全族堆破坏（v5/118/j2/79_v2 fix_s C374）。

函数 主() -> 整32 {
    打印("[S1] 入口");
    向量<映射<整64, 整64>> 表 = 向量<映射<整64, 整64>>();
    映射<整64, 整64> 层 = 映射<整64, 整64>();
    结果<空类型, 整32> 加 = 表.追加(层);
    打印("[S2] 追加后: ", 表.大小());
    映射<整64, 整64> 层2 = 映射<整64, 整64>();
    结果<空类型, 整32> 加2 = 表.追加(层2);
    打印("[S3] 二次追加: ", 表.大小());
    {
        向量<映射<整64, 整64>> 内表 = 向量<映射<整64, 整64>>();
        结果<空类型, 整32> 加3 = 内表.追加(层);
        打印("[S4] 块内追加: ", 内表.大小());
    }
    打印("[S5] 块出口后: ", 表.大小());
    返回 0;
}
