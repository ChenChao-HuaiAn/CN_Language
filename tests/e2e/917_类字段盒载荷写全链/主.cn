// E2E 917（原 904 撞号让位改号·2026-10-14·#571 根治锁面·#658 转 dual）：**类字段 盒载荷（可选<字符串>/
//   结果<字符串,整32>）写全链**——字段写路径 装箱/拷贝/布局 的 #280 载荷真值
//   守卫与拥有语义锁面。背景（106 实施轮呈报）：字段写路径 canon=模板文本
//   形态原落收集器通用分支——载荷值位被当**无条件**字符串字段：preFree 无条件
//   free（错误态值位=错误码整数→free(7) 段错误 C0000005 实锤；无值/未初始化态
//   值位=堆垃圾→乱码/崩）+postCopy 无条件 __cn_str_copy 同病。修复=收集器入口
//   双形态归一（模板文本→$合成名·专用分支条件守卫）+条件面 runtime 单调用化。
//   分行断言（四形小计·任一形态分叉即值变化）：形一=1+2+4=7；形二三=8+16+32+64=120；
//   形四五六=1+2+4+8+16+32=63；形八=1+2=3——期望四行 7/120/63/3。
//     ① 可选<字符串> 字段 有值→有值 覆盖重写（旧载荷释放+新内容守恒）
//     ② 结果<字符串,整32> 错误态→正常态 字段重写（守卫跳过错误码释放·修复前
//        free(错误码) 段错误形态）
//     ③ 正常态→错误态 回写（旧载荷释放·错误码读取正确）
//     ④ 方法内 自身.字段 = 某些(...) 写
//     ⑤ 局部变量来源写字段（深拷独立·源保持拥有）
//     ⑥ 多实例隔离（乙 写不伤 甲 载荷）
//     ⑦ 块出口残留归零（内存::活动分配数 断言·drop glue 完整）
//     ⑧ 函数返回写（造有值() → 字段·retbuf 接管）
类 资源 {
公开:
    整32 编号;
    可选<字符串> 名称;
    结果<字符串, 整32> 载荷;
    函数 资源(整32 n) { 编号 = n; }
    函数 ~资源() { }
    函数 置名(字符串 值) {
        自身.名称 = 某些(值);
    }
}

函数 造有值() -> 可选<字符串> {
    返回 某些("函数返回有值载荷");
}

函数 形一() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        资源 甲 = 资源(1);
        甲.名称 = 某些("第一次写入");
        如果 甲.名称.有值 {
            如果 (字符串比较(甲.名称.值, "第一次写入")) { 校验 = 校验 + 1; }
        }
        甲.名称 = 某些("第二次覆盖");
        如果 甲.名称.有值 {
            如果 (字符串比较(甲.名称.值, "第二次覆盖")) { 校验 = 校验 + 2; }
        }
    }
    如果 (内存::活动分配数() == 前) { 校验 = 校验 + 4; }
    返回 校验;
}

// ②③ 错误态↔正常态 双向重写（宿主修复前 ② free(错误码) 段错误）
函数 形二三() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        资源 甲 = 资源(2);
        甲.载荷 = 错误(7);
        如果 (!甲.载荷.正常) {
            如果 (甲.载荷.错误 == 7) { 校验 = 校验 + 8; }
        }
        甲.载荷 = 正常(字符串复制("修复后正常载荷"));
        如果 甲.载荷.正常 {
            如果 (字符串比较(甲.载荷.值, "修复后正常载荷")) { 校验 = 校验 + 16; }
        }
        甲.载荷 = 错误(9);
        如果 (!甲.载荷.正常) {
            如果 (甲.载荷.错误 == 9) { 校验 = 校验 + 32; }
        }
    }
    如果 (内存::活动分配数() == 前) { 校验 = 校验 + 64; }
    返回 校验;
}

// ④⑤⑥ 方法内写 + 局部来源深拷 + 多实例隔离
函数 形四五六() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        资源 甲 = 资源(3);
        甲.置名("方法内写入");
        如果 甲.名称.有值 {
            如果 (字符串比较(甲.名称.值, "方法内写入")) { 校验 = 校验 + 1; }
        }
        可选<字符串> 局部 = 某些("局部来源载荷");
        甲.名称 = 局部;
        如果 甲.名称.有值 {
            如果 (字符串比较(甲.名称.值, "局部来源载荷")) { 校验 = 校验 + 2; }
        }
        如果 局部.有值 {
            如果 (字符串比较(局部.值, "局部来源载荷")) { 校验 = 校验 + 4; }
        }
        资源 乙 = 资源(4);
        乙.名称 = 某些("第二实例独有");
        如果 乙.名称.有值 {
            如果 (字符串比较(乙.名称.值, "第二实例独有")) { 校验 = 校验 + 8; }
        }
        如果 甲.名称.有值 {
            如果 (字符串比较(甲.名称.值, "局部来源载荷")) { 校验 = 校验 + 16; }
        }
    }
    如果 (内存::活动分配数() == 前) { 校验 = 校验 + 32; }
    返回 校验;
}

// ⑧ 函数返回写（retbuf 接管）+ 残留归零
函数 形八() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        资源 甲 = 资源(5);
        甲.名称 = 造有值();
        如果 甲.名称.有值 {
            如果 (字符串比较(甲.名称.值, "函数返回有值载荷")) { 校验 = 1; }
        }
    }
    如果 (内存::活动分配数() == 前) { 校验 = 校验 + 2; }
    返回 校验;
}

函数 主() -> 整32 {
    打印("形一=", 形一(), " 形二三=", 形二三(), " 形四五六=", 形四五六(),
         " 形八=", 形八());
    返回 0;
}
