// E2E 380（252-a·算法面双编译对照）：随机数算法内联（与 stdlib/随机数.cn 同构）
//   ——位运算旋转掩码/两补码回绕/移位取模语义的宿主 vs v2 运行级对齐。
//   类内联形态（223_v2 惯例）：v2 导入类构造初始化判定缺口=D28（登记 plans/021，
//   根治后本用例可升级为 stdlib 导入形态）。

类 随机数生成器 {
    整64 状态0;
    整64 状态1;
    整64 状态2;
    整64 状态3;

公开:
    函数 随机数生成器(整64 种子) {
        自身.播种(种子);
    }

    函数 播种(整64 种子) {
        整64 黄金步进 = -7046029254386353131;
        整64 x = 种子;
        x = x + 黄金步进;
        状态0 = 自身.扩散混合(x);
        x = x + 黄金步进;
        状态1 = 自身.扩散混合(x);
        x = x + 黄金步进;
        状态2 = 自身.扩散混合(x);
        x = x + 黄金步进;
        状态3 = 自身.扩散混合(x);
    }

    函数 下一个() -> 整64 {
        整64 输出值 = 自身.旋转左(状态0 + 状态3, 17);
        输出值 = 输出值 + 状态0;
        整64 t = 状态1 << 17;
        状态2 = 状态2 ^ 状态0;
        状态3 = 状态3 ^ 状态1;
        状态1 = 状态1 ^ 状态2;
        状态0 = 状态0 ^ 状态3;
        状态2 = 状态2 ^ t;
        状态3 = 自身.旋转左(状态3, 45);
        返回 输出值;
    }

    函数 下一个范围(整64 上限) -> 整64 {
        整64 值 = 自身.下一个();
        整64 非负 = 值 & 9223372036854775807;
        返回 非负 % 上限;
    }

    函数 下一个浮点() -> 浮64 {
        整64 值 = 自身.下一个();
        整64 尾数 = (值 >> 11) & 9007199254740991;
        返回 尾数 * 1.0 / 9007199254740992.0;
    }

    函数 旋转左(整64 值, 整64 位数) -> 整64 {
        // 掩码基数须为整64：字面量 1 是整32，1 << 位数 按 32 位宽取模，
        // 位数 >= 32 时掩码错（[01b] 移位量按操作数类型位宽取模）
        整64 掩码基数 = 1;
        整64 左半 = 值 << 位数;
        整64 右半 = (值 >> (64 - 位数)) & ((掩码基数 << 位数) - 1);
        返回 左半 | 右半;
    }

    函数 扩散混合(整64 z) -> 整64 {
        z = z ^ (z >> 30);
        z = z * -4658895280553007687;
        z = z ^ (z >> 27);
        z = z * -7723592293110705685;
        z = z ^ (z >> 31);
        返回 z;
    }
}

函数 播种扩散(整64 熵源) -> 整64 {
    返回 熵源 * 1099511628211 + -7046029254386353131;
}

函数 主() -> 整32 {
    // —— 段1：固定种子 42 确定性序列（首值锚定）——
    随机数生成器 生成器 = 随机数生成器(42);
    整64 首值 = 生成器.下一个();
    整64 第二值 = 生成器.下一个();
    // —— 段2：范围值五次之和（0+1+5+1+6）——
    整64 范围和 = 0;
    整32 序号 = 0;
    当 (序号 < 5) {
        范围和 = 范围和 + 生成器.下一个范围(10);
        序号 = 序号 + 1;
    }
    // —— 段4：种子 7 的 100 次范围(6) 加权校验和 ——
    随机数生成器 生成器乙 = 随机数生成器(7);
    整64 校验和 = 0;
    序号 = 0;
    当 (序号 < 100) {
        校验和 = 校验和 + 生成器乙.下一个范围(6) * (序号 + 1);
        序号 = 序号 + 1;
    }
    // —— 段5：种子 42 的 1000 次下一个 之和（低 16 位）——
    随机数生成器 生成器丙 = 随机数生成器(42);
    整64 总和 = 0;
    序号 = 0;
    当 (序号 < 1000) {
        总和 = 总和 + 生成器丙.下一个();
        序号 = 序号 + 1;
    }
    // —— 段6：重播种可复现（同种子两次序列首值一致）——
    生成器.播种(播种扩散(987654321));
    整64 复现甲 = 生成器.下一个();
    生成器.播种(播种扩散(987654321));
    整64 复现乙 = 生成器.下一个();
    // —— 断言位权合计 31=全过（两侧退出码一致判据·228 惯例）——
    整64 累 = 0;
    如果 (首值 == 5652830896459303956) { 累 = 累 + 1; }
    如果 (第二值 == 3546038017885523995 && 范围和 == 12) { 累 = 累 + 2; }
    如果 (校验和 == 14172) { 累 = 累 + 4; }
    如果 ((总和 & 65535) == 27469) { 累 = 累 + 8; }
    如果 (复现甲 == 复现乙 && 复现甲 != 0) { 累 = 累 + 16; }
    返回 整32(累);
}
