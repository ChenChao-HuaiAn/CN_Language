// E2E 273（2026-09-14 第一百六十二轮 162-a A5/A3 标识符自由正测·双编译对照）：
//   14 个非保留词（10 上下文化词 + 删除词 自动/实现 + 前缀 原始/多行）
//   作变量名/字段名/函数名全部合法（释放命名空间；宿主/v2 双侧一致）。
结构体 盒 {
    整64 静态;
    整64 保护;
    整64 常量;
}

函数 公开() -> 整64 { 返回 1; }
函数 模块() -> 整64 { 返回 2; }
函数 原始() -> 整64 { 返回 3; }

函数 主() -> 整32 {
    整64 保护 = 1;
    整64 虚拟 = 2;
    整64 重写 = 3;
    整64 抽象 = 4;
    整64 私有 = 5;
    整64 作为 = 6;
    整64 实现 = 7;
    整64 自动 = 8;
    整64 多行 = 9;
    盒 b;
    b.静态 = 10;
    b.常量 = 11;
    整64 总 = 保护 + 虚拟 + 重写 + 抽象 + 私有 + 作为 + 实现 + 自动 + 多行;
    总 = 总 + b.静态 + b.常量 + 公开() + 模块() + 原始();
    打印行(总);
    返回 整32(总);   // 返回码=累加值（72）——双编译对照以宿主实测码锚定 v2 侧同值
}
