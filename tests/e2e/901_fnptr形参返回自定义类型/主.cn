// 901_fnptr形参返回自定义类型（#627·#560 同根·双编译对照）——
//   函数指针形参的返回类型为自定义类型名（结构体）：`点(*回调)(整32)`。
//   缺陷（修复前宿主）：parseParamDecl 仅内建类型分支有 fnptr 探测，
//   自定义类型名分支无路径 ->「预期参数名」+「预期 ')'，实际为 '('」+
//   级联「预期顶层声明」（627 最小源）；本用例=独立最小源全链回归。
结构体 点 {
    整32 x;
    整32 y;
}

函数 造点(整32 k) -> 点 {
    返回 点{ x = k, y = k + 1 };
}

函数 处理(点(*回调)(整32)) -> 点 {
    返回 回调(5);
}

函数 求和坐标(点(*取得)(整32), 整32 k) -> 整32 {
    变量 p = 取得(k);
    返回 p.x + p.y;
}

函数 取得造点器() -> 点(*)(整32) {
    变量 f = 造点;
    返回 f;
}

函数 主() -> 整32 {
    // 627 最小源：返回结构体的 fnptr 形参直调
    变量 r = 处理(造点);
    打印(r.x);                         // 5
    打印(r.y);                         // 6
    // fnptr 形参多次调用 + 字段运算
    打印(求和坐标(造点, 10));          // 10 + 11 = 21
    // 返回类型为自定义名的 fnptr 作返回类型（变量中转·731 面1 同构）
    变量 g = 取得造点器();
    变量 s = g(100);
    打印(s.x);                         // 100
    打印(s.y);                         // 101
    返回 0;
}
