// E2E 888（569 甲案·2026-10-14 用户裁决「甲+配套」·001 §5.2a 立法锁面）：
//   顶层裸全局变量声明全链——同一份源码宿主+v2p 各编各跑，退出码须一致。
//   覆盖十形态：①字面量初始化 ②常量算术/常量引用初始化（d 款 constinit
//   语义·防初始化顺序 fiasco）③无初始化器零初始化（.bss）④不安全 函数 内
//   写（赋值/复合赋值/自增——§747 第 8 条「可变静态/全局变量写」执法面）
//   ⑤跨文件访问（e 款：供给.cn 裸全局默认外部可见·无须 公开: 标签）
//   ⑥别名关键字形态（整数=整32）⑦指针形态零初始化（`== 无` 空判锁 .bss
//   零值）⑧数组形态（`整32[4]` 元素写读锁存储面）⑨泛型容器形态（728c 补锁
//   `向量<整32>` 裸全局·声明即构造+追加/大小/元素 全链）⑩静态合成体形态
//   （728c 补锁 `静态 结果<整32,整32>` 零值对象·正常=假语义双侧一致）。
//   前四形态曾双侧分叉：宿主解析层拒「预期顶层声明」/v2 静默吞（asm 无全局
//   符号）——双侧全链补实现。⑨泛型容器缺口（向量$整32$向量 构造符号供给）
//   经 569 接棒修复顺带打通；⑩无初值静态合成体槽 0=空句柄崩（728c 根治：
//   v2 零值对象注入·989 同构）——两形态本用例补锁（t1~t11 探针矩阵实证）。
//   退出码 = 9 + 22 + 8 + 13 + 4 + 6 + 7 + 1 + 6 = 76
//   （①9 ②22 ③⑩8 ⑤13 ⑥4 ⑧13 ⑨7=大小1+元素6）。
导入 供给;
导入 容器::向量;

常量 系数 = 10;
整32 计数 = 5;                 // ① 字面量初始化
整32 算术 = 系数 * 2 + 1;       // ② 常量算术（=21·函数内 ++ 后 22）
整32 零值;                     // ③ 零初始化（函数内写 7·⑩后 8）
整数 别名槽 = 4;               // ⑥ 别名关键字形态（constinit 同 d 款执法）
整32* 槽指针;                  // ⑦ 指针形态零初始化（.bss=空）
整32[4] 表槽;                  // ⑧ 数组形态（元素写读）
向量<整32> 容器槽;             // ⑨ 泛型容器形态（728c 补锁·声明即构造）
静态 结果<整32, 整32> 结果槽;  // ⑩ 静态合成体形态（728c 补锁·零值=正常假）

不安全 函数 累积() {
    计数 += 3;                 // ④ 复合赋值（5→8）
    零值 = 7;                  // ④ 赋值（0→7）
    算术++;                    // ④ 自增（21→22）
    如果 (槽指针 == 无) {       // ⑦ 零初始化空判（8→9）
        计数 = 计数 + 1;
    }
    表槽[0] = 6;               // ⑧ 数组元素写
    表槽[1] = 7;               // ⑧ 数组元素写
    结果<空类型, 整32> 加容器 = 容器槽.追加(6);   // ⑨ 容器追加（构造后写）
    如果 (!加容器.正常) {
        零值 = 98;             // ⑨ 追加失败=异常值（可发现）
    }
}

不安全 函数 校验静态结果槽() {
    如果 (结果槽.正常) {
        零值 = 99;             // ⑩ 零值结果正常=真 → 注入失败（可发现异常值）
    } 否则 {
        零值 = 零值 + 1;       // ⑩ 零值结果正常=假 → 7→8（+1 贡献）
    }
}

函数 主() -> 整32 {
    累积();
    校验静态结果槽();
    返回 计数 + 算术 + 零值 + 库计数 + 别名槽 + 表槽[0] + 表槽[1]
       + 整32(容器槽.大小()) + 容器槽.元素(0);
}
