// E2E 888（569 甲案·2026-10-14 用户裁决「甲+配套」·001 §5.2a 立法锁面）：
//   顶层裸全局变量声明全链——同一份源码宿主+v2p 各编各跑，退出码须一致。
//   覆盖五形态：①字面量初始化 ②常量算术/常量引用初始化（d 款 constinit
//   语义·防初始化顺序 fiasco）③无初始化器零初始化（.bss）④不安全 函数 内
//   写（赋值/复合赋值/自增——§747 第 8 条「可变静态/全局变量写」执法面）
//   ⑤跨文件访问（e 款：供给.cn 裸全局默认外部可见·无须 公开: 标签）。
//   退出码 = 8 + 22 + 7 + 13 = 50（①8 ②22 ③7 ⑤13）。
导入 供给;

常量 系数 = 10;
整32 计数 = 5;                 // ① 字面量初始化
整32 算术 = 系数 * 2 + 1;       // ② 常量算术（=21·函数内 ++ 后 22）
整32 零值;                     // ③ 零初始化（函数内写 7）

不安全 函数 累积() {
    计数 += 3;                 // ④ 复合赋值（5→8）
    零值 = 7;                  // ④ 赋值（0→7）
    算术++;                    // ④ 自增（21→22）
}

函数 主() -> 整32 {
    累积();
    返回 计数 + 算术 + 零值 + 库计数;
}
