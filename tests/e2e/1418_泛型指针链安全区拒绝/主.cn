// E2E 1418（1175 安全区对齐负测）：泛型实例字段指针链于**安全区函数**内=双侧
//   编译拒绝（宿主 visitMemberExpr B9「[安全区边界] 指针成员访问」/ v2 926
//   链对象扩面同文同拒）。修前 v2 因泛型实例链 [ir2] 偏移未知而「碰巧拒绝」，
//   1175 打通链后若 926 不扩面=静默放行（g02e 探针实录：v2 rc=0 运行空指针
//   错码 3=安全裂缝）。两形态=①直接字段指针链 甲.下.值（对象成员父=标识符）；
//   ②嵌套结构体指针链 乙.坐标.下.值（递归声明链解析）——本用例锚定真正的
//   安全区诊断（零分叉）。
// 预期失败。
结构体 点 {
    整32 值;
    点* 下;
}

泛型 <类型 T> 类 节点 {
公开:
    T 值;
    节点<T>* 下;
    函数 节点(T v) { 值 = v; 下 = 无; }
}

泛型 <类型 T> 类 盒子 {
公开:
    T 载荷;
    点 坐标;
    函数 盒子(T v) {
        载荷 = v;
        坐标 = 点{ 值 = 0, 下 = 无 };
    }
}

函数 主() -> 整32 {
    节点<整32> 甲 = 节点<整32>(1);
    打印行(甲.下.值);
    盒子<整32> 乙 = 盒子<整32>(1);
    打印行(乙.坐标.下.值);
    返回 0;
}
