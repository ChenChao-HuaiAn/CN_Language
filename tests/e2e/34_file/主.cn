// 文件库 E2E（Task 6.2，规格书阶段五「文件系统」；对标 C++ fstream）
// 覆盖：打开（写模式2 截断）/ 写入文件（多行中文 UTF-8）/ 关闭 /
//       文件存在=真 / 打开（读模式1）/ 读取文件行（按行读取）/ 文件大小（UTF-8 字节数）
// 调用方式：直接调用文件内置函数（文件.打开文件 等，全局注册、无需导入），
//   由编译器 IR 层映射到运行时 __cn_file_*（file_api.cpp）
//   ——与 stdlib/文件.cn 模块封装同名（25_math 数学库同模式：E2E 直接验证内置）
// 中文路径验证：文件名 测试文件.txt 为 UTF-8 中文，运行时内部 MultiByteToWideChar
//   (CP_UTF8) + _wfopen_s 打开（lessons.md 已验证方案，E2E 端到端验证）
// 测试文件位置：E2E 从项目根目录运行（cwd=项目根），写入 target/ 下临时文件
//   （target/ 已被 .gitignore 忽略，不会污染仓库）
//   写模式 "wb" 自动截断——即使上次遗留文件也能正确覆盖（文件存在 判定不受影响）
// 说明：写入 3 行中文文本（UTF-8：你好=6字节，每行"你好，文件系统！\n"=12字节）
//   文件大小 = 逐行字节数之和（无 BOM 的纯 UTF-8 文本）
// 打印语义（用户裁决）：打印=println（自动换行）；布尔打印为 1/0

函数 主() -> 整32 {
    打印("===== 文件库（Task 6.2）=====")

    字符串 路径 = "target/测试文件.txt"

    // ==================== 1. 写入文件（模式2=写，截断） ====================
    空类型* 写句柄 = 文件.打开文件(路径, 2)
    如果 (写句柄 != 无) {
        整64 写数量 = 文件.写入文件(写句柄, "你好，文件系统！\n第二行测试\n第三行内容\n")
        打印("写入字节数: ", 写数量)
        文件.关闭文件(写句柄)
    } 否则 {
        打印("打开写失败")
    }

    // ==================== 2. 文件存在 ====================
    布尔 存在 = 文件.文件存在(路径)
    打印("文件存在: ", 存在)             // 1

    // ==================== 3. 读取文件（模式1=读）按行读取 ====================
    空类型* 读句柄 = 文件.打开文件(路径, 1)
    如果 (读句柄 != 无) {
        // 按行读取：第一行（含换行，打印显示内容不含换行符本身）
        字符串 第一行 = 文件.读取文件行(读句柄)
        如果 (第一行 != 无) {
            打印("第一行: ", 第一行)
            字符串释放(第一行)
        } 否则 {
            打印("读取第一行失败")
        }

        // 第二行
        字符串 第二行 = 文件.读取文件行(读句柄)
        如果 (第二行 != 无) {
            打印("第二行: ", 第二行)
            字符串释放(第二行)
        } 否则 {
            打印("读取第二行失败")
        }

        // 第三行
        字符串 第三行 = 文件.读取文件行(读句柄)
        如果 (第三行 != 无) {
            打印("第三行: ", 第三行)
            字符串释放(第三行)
        } 否则 {
            打印("读取第三行失败")
        }

        // EOF 后再次读取：返回 nullptr（EOF 语义）
        字符串 第四行 = 文件.读取文件行(读句柄)
        如果 (第四行 != 无) {
            打印("第四行(不应有): ", 第四行)
            字符串释放(第四行)
        } 否则 {
            打印("EOF后读取失败")
        }

        // ==================== 4. 文件大小（UTF-8 字节数） ====================
        整64 大小 = 文件.文件大小(读句柄)
        打印("文件大小: ", 大小)

        文件.关闭文件(读句柄)
    } 否则 {
        打印("打开读失败")
    }

    打印("===== 文件库测试完成 =====")
    返回 0
}
