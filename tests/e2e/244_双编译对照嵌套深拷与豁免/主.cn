// E2E 244（2026-09-12 第八十六轮 86-a，plans/020 移植纪律 9 门禁化·第十五个对照用例）：
//   **嵌套含串结构体的整体拷贝 + 借出豁免的容器类型约束**——同一份源码经宿主真实
//   管线与 v2 自举链各编译运行，两侧退出码须相等。
//   背景（86-a 复审 P42/P44 实证）：
//   ① 84-e 在 v2 `发射串字段深拷` 插入的「查结构体大小>0→跳过」守卫**位于递归分支
//      之前**（另两处正确在后）→ 嵌套含串结构体递归深拷恒不可达 → `箱 乙 = 甲;`
//      整体赋值后搅动读乱码（P42：宿主 RC=1 vs v2 RC=0）；
//   ② 85-a 借出豁免按函数名末段匹配、无容器类型约束 → 用户顶层函数恰名
//      「获取/元素/读取」+ `返回 借用形参` 被误豁免深拷 → 悬垂（P44 两侧乱码）。
//   修复=守卫两处交换（递归在前）+ 豁免加容器类型前置（宿主 currentClass_ 判定 /
//   v2 方法类名85 + 是容器类）。
//   八形态（两侧共有语义面）：
//     ① 嵌套整体赋值（赋值位跨块）② 嵌套声明位 ③ 嵌套成员位赋值
//     ④ 嵌套返回位（借用形参返回）⑤⑥⑦ 用户函数名 获取/元素/读取 返回借用形参
//     ⑧ 循环 5 万轮（获取 + 嵌套赋值 + 搅动）防残留
//   校验和折位：①1 ②2 ③4 ④8 ⑤16 ⑥32 ⑦64 ⑧128 —— 255=全对。
//   平台守卫=linux 双平台（宿主与 v2 同链；win-x64 v2 产物未隔离=家机轮）。
结构体 盒 {
    字符串 名;
    整32 号;
}
结构体 箱 {
    盒 内盒;
    整32 标记;
}

函数 搅动() -> 整64 {
    整64 和 = 0;
    整64 i = 0;
    当 (i < 16) {
        字符串 垃圾 = 字符串复制("E244搅动内存填充占位字符串内容甲乙丙丁戊己庚辛壬癸");
        和 = 和 + 字符串长度(垃圾);
        i++;
    }
    返回 和;
}

// ④ 嵌套返回位（借用形参：返回位深拷归一化 85-a 面 × 嵌套递归 84-e 面）
函数 取箱(箱 参) -> 箱 {
    返回 参;
}

// ⑤⑥⑦ 用户函数名与容器读出接口同名（合法标识符）——豁免约束必须不误伤
//   （86-a：豁免=方法名 ∈ 清单 且 所属类为容器；顶层函数恒不豁免）
函数 获取(盒 参) -> 盒 {
    返回 参;
}
函数 元素(盒 参) -> 盒 {
    返回 参;
}
函数 读取(盒 参) -> 盒 {
    返回 参;
}

// ① 嵌套整体赋值（赋值位，跨块读取）
函数 形一() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        箱 乙;
        {
            箱 甲 = 箱{ 内盒 = 盒{ 名 = 字符串复制("E244形一内串甲甲甲甲甲甲甲甲"), 号 = 1 }, 标记 = 1 };
            乙 = 甲;
        }
        搅动();
        如果 (字符串比较(乙.内盒.名, "E244形一内串甲甲甲甲甲甲甲甲")) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 1) { 返回 1; }
    返回 0;
}

// ② 嵌套声明位初始化（标识符来源）
函数 形二() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        箱 乙;
        {
            箱 甲 = 箱{ 内盒 = 盒{ 名 = 字符串复制("E244形二内串甲甲甲甲甲甲甲甲"), 号 = 2 }, 标记 = 2 };
            乙 = 甲;
            搅动();
            如果 (字符串比较(乙.内盒.名, "E244形二内串甲甲甲甲甲甲甲甲")) { 校验 = 1; }
            如果 (乙.内盒.号 == 2) { 校验 = 校验 + 1; }
        }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 2) { 返回 2; }
    返回 0;
}

// ③ 嵌套成员位赋值（成员链来源）
函数 形三() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        箱 乙箱;
        {
            箱 甲 = 箱{ 内盒 = 盒{ 名 = 字符串复制("E244形三内串甲甲甲甲甲甲甲甲"), 号 = 3 }, 标记 = 3 };
            乙箱 = 箱{ 内盒 = 盒{ 名 = 字符串复制("E244形三旧串乙乙乙乙乙乙乙乙"), 号 = 30 }, 标记 = 4 };
            乙箱.内盒 = 甲.内盒;
        }
        搅动();
        如果 (字符串比较(乙箱.内盒.名, "E244形三内串甲甲甲甲甲甲甲甲")) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 1) { 返回 4; }
    返回 0;
}

// ④ 嵌套返回位（借用形参返回）
函数 形四() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        箱 收;
        {
            箱 甲 = 箱{ 内盒 = 盒{ 名 = 字符串复制("E244形四内串甲甲甲甲甲甲甲甲"), 号 = 4 }, 标记 = 5 };
            收 = 取箱(甲);
        }
        搅动();
        如果 (字符串比较(收.内盒.名, "E244形四内串甲甲甲甲甲甲甲甲")) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 1) { 返回 8; }
    返回 0;
}

// ⑤ 用户函数名「获取」返回借用形参（豁免无误伤）
函数 形五() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        盒 收;
        {
            盒 源 = 盒{ 名 = 字符串复制("E244形五源串甲甲甲甲甲甲甲甲甲甲"), 号 = 5 };
            收 = 获取(源);
        }
        搅动();
        如果 (字符串比较(收.名, "E244形五源串甲甲甲甲甲甲甲甲甲甲")) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 1) { 返回 16; }
    返回 0;
}

// ⑥ 用户函数名「元素」返回借用形参
函数 形六() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        盒 收;
        {
            盒 源 = 盒{ 名 = 字符串复制("E244形六源串甲甲甲甲甲甲甲甲甲甲"), 号 = 6 };
            收 = 元素(源);
        }
        搅动();
        如果 (字符串比较(收.名, "E244形六源串甲甲甲甲甲甲甲甲甲甲")) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 1) { 返回 32; }
    返回 0;
}

// ⑦ 用户函数名「读取」返回借用形参
函数 形七() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        盒 收;
        {
            盒 源 = 盒{ 名 = 字符串复制("E244形七源串甲甲甲甲甲甲甲甲甲甲"), 号 = 7 };
            收 = 读取(源);
        }
        搅动();
        如果 (字符串比较(收.名, "E244形七源串甲甲甲甲甲甲甲甲甲甲")) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 1) { 返回 64; }
    返回 0;
}

// ⑧ 循环 5 万轮（获取 + 嵌套赋值 + 搅动）
函数 形八(整64 轮数) -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    整64 i = 0;
    当 (i < 轮数) {
        盒 源 = 盒{ 名 = 字符串复制("E244形八循环串甲乙丙丁戊己庚辛"), 号 = 88 };
        盒 收 = 获取(源);
        如果 (!字符串比较(收.名, "E244形八循环串甲乙丙丁戊己庚辛")) { 校验 = 0; 中断; }
        箱 甲 = 箱{ 内盒 = 收, 标记 = 9 };
        箱 乙 = 箱{ 内盒 = 盒{ 名 = 字符串复制("E244形八旧串甲乙丙丁"), 号 = 0 }, 标记 = 10 };
        乙 = 甲;
        如果 (!字符串比较(乙.内盒.名, "E244形八循环串甲乙丙丁戊己庚辛")) { 校验 = 0; 中断; }
        校验 = 1;
        i++;
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 1) { 返回 128; }
    返回 0;
}

函数 主() -> 整32 {
    整64 和 = 形一() + 形二() + 形三() + 形四();
    和 = 和 + 形五() + 形六() + 形七() + 形八(50000);
    返回 整32(和);
}
