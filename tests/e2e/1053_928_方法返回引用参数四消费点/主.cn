// E2E 1053（双编译对照·928 销项·633 呈报诚实边界收口）：「方法返回其引用参数
//   作右值」——函数/方法同口径（rax=被引用左值地址·宿主 ABI 对齐）——同一源码
//   宿主/v2 两侧各编各跑，退出码相等（双编译对照配置 退出码=校验和）。
//   形态矩阵（位折·283/719/836 同款断言口径：块出口后 内存::活动分配数()
//   差值==0 且内容正确）：
//     位1   声明位 `货架 甲 = 仓1.取货(源)`（方法·引用参数）副本正确+独立+残留0
//     位2   赋值位 `甲 = 仓1.取货(源)`（方法·引用参数）覆盖前旧值释放+残留0
//     位4   绑定位 `货架& 别名 = 仓1.取货(源)`（方法·引用参数）别名读写穿透
//     位8   容器接收 `向量<整32> 甲列 = 仓1.取列(列源)`（方法·容器引用参数）
//     位16  类内声明位（自身.取货(源) 方法体内接收）
//     位32  类内赋值位（自身.取货(源) 方法体内赋值）
//     位64  对照=自由函数声明位（取货f(源)——878/632 面回归内嵌）
//     位128 对照=自由函数容器接收（取列f(列源)——1012 ④b 面回归内嵌）
//   修前（928 探针双编译实况）：v2 「返回引用参数」方法作右值四消费点全崩
//   （声明位 rc=C0000005 / 赋值位 C0000374；宿主同形态校验=1 正确）——v2
//   生产端「类对象引用参数单段左值地址」多解一层（Load+PtrLoad=对象指针本体·
//   宿主=被引用左值地址），633 分流谓词按「返回字段」形态（槽地址）适配。
//   修后：v2 顺序链标识符地址 单段只 Load（生产端 ABI 对齐）+ 632/633/绑定/
//   容器接收消费点撤 hold 分档统一直用 + 是方法引用返回928 识别补位——
//   校验和 255 双绿（633 分流谓词 是被调成员方法标记633/是类对象引用返回633
//   随前提消失删除=台账 #928「与宿主 ABI 完全对齐时消除该分流」）。
导入 容器::向量;
类 货架 {
公开:
    向量<字符串> 记录;
    函数 货架() { 记录 = 向量<字符串>(); }
    函数 ~货架() { }
    不安全 函数 货架(货架& 其他) { 记录 = 其他.记录; }
}
类 仓 {
公开:
    函数 仓() { }
    // 方法返回其引用参数（928 主形态）
    函数 取货(货架& 源) -> 货架& {
        返回 源;
    }
    // 方法返回其容器引用参数（容器接收形态）
    函数 取列(向量<整32>& 源) -> 向量<整32>& {
        返回 源;
    }
}
类 用货 {
公开:
    函数 用货() { }
    // 类内取货（方法体返回引用参数）
    函数 取货(货架& 源) -> 货架& {
        返回 源;
    }
    // 类内消费：声明位
    函数 消费声明(货架& 源) -> 整64 {
        货架 甲 = 自身.取货(源);
        返回 甲.记录.大小();
    }
    // 类内消费：赋值位
    函数 消费赋值(货架& 源) -> 整64 {
        货架 甲;
        甲 = 自身.取货(源);
        返回 甲.记录.大小();
    }
}
// 对照=自由函数形态（878/1012 既有锁面回归内嵌）
函数 取货f(货架& 源) -> 货架& {
    返回 源;
}
函数 取列f(向量<整32>& 源) -> 向量<整32>& {
    返回 源;
}
函数 主() -> 整32 {
    整32 校验 = 0;
    // 位1：声明位（方法·引用参数）——副本正确+独立+残留0
    整64 b1 = 内存::活动分配数();
    整64 甲大1 = 0;
    整64 源大1 = 0;
    {
        货架 源;
        结果<空类型, 整32> r1 = 源.记录.追加(字符串复制("声一"));
        仓 仓1;
        货架 甲 = 仓1.取货(源);
        结果<空类型, 整32> r2 = 甲.记录.追加(字符串复制("声二"));
        甲大1 = 甲.记录.大小();
        源大1 = 源.记录.大小();
    }
    如果 (甲大1 == 2 && 源大1 == 1 && 内存::活动分配数() - b1 == 0) { 校验 = 校验 + 1; }
    // 位2：赋值位（方法·引用参数）——覆盖旧值释放+残留0
    整64 b2 = 内存::活动分配数();
    整64 赋大 = 0;
    {
        货架 源;
        结果<空类型, 整32> r3 = 源.记录.追加(字符串复制("赋一"));
        仓 仓1;
        货架 甲;
        甲 = 仓1.取货(源);
        甲 = 仓1.取货(源);
        赋大 = 甲.记录.大小();
    }
    如果 (赋大 == 1 && 内存::活动分配数() - b2 == 0) { 校验 = 校验 + 2; }
    // 位4：绑定位（方法·引用参数）——别名读值+写穿透（改别名=改源）
    整64 b4 = 内存::活动分配数();
    整64 别读 = 0;
    整64 源写后 = 0;
    {
        货架 源;
        结果<空类型, 整32> r4 = 源.记录.追加(字符串复制("绑一"));
        仓 仓1;
        货架& 别名 = 仓1.取货(源);
        别读 = 别名.记录.大小();
        结果<空类型, 整32> r5 = 别名.记录.追加(字符串复制("绑二"));
        源写后 = 源.记录.大小();
    }
    如果 (别读 == 1 && 源写后 == 2 && 内存::活动分配数() - b4 == 0) { 校验 = 校验 + 4; }
    // 位8：容器接收（方法·容器引用参数）——深拷副本独立+残留0
    整64 b8 = 内存::活动分配数();
    整64 列大 = 0;
    整64 源列大 = 0;
    {
        向量<整32> 列源;
        结果<空类型, 整32> r6 = 列源.追加(7);
        仓 仓1;
        向量<整32> 甲列 = 仓1.取列(列源);
        结果<空类型, 整32> r7 = 甲列.追加(8);
        列大 = 甲列.大小();
        源列大 = 列源.大小();
    }
    如果 (列大 == 2 && 源列大 == 1 && 内存::活动分配数() - b8 == 0) { 校验 = 校验 + 8; }
    // 位16/32：类内声明位+赋值位（方法体内 自身.取货(源)）
    整64 b16 = 内存::活动分配数();
    整64 类内声 = 0;
    整64 类内赋 = 0;
    整64 源保 = 0;
    {
        货架 源;
        结果<空类型, 整32> r8 = 源.记录.追加(字符串复制("内一"));
        用货 器;
        类内声 = 器.消费声明(源);
        类内赋 = 器.消费赋值(源);
        源保 = 源.记录.大小();
    }
    如果 (类内声 == 1 && 类内赋 == 1 && 源保 == 1 &&
         内存::活动分配数() - b16 == 0) { 校验 = 校验 + 16 + 32; }
    // 位64：对照 自由函数声明位（878 面）
    整64 b64 = 内存::活动分配数();
    整64 函甲 = 0;
    {
        货架 源;
        结果<空类型, 整32> r9 = 源.记录.追加(字符串复制("函一"));
        货架 甲 = 取货f(源);
        函甲 = 甲.记录.大小();
    }
    如果 (函甲 == 1 && 内存::活动分配数() - b64 == 0) { 校验 = 校验 + 64; }
    // 位128：对照 自由函数容器接收（1012 ④b 面）
    整64 b128 = 内存::活动分配数();
    整64 函列 = 0;
    {
        向量<整32> 列源;
        结果<空类型, 整32> r10 = 列源.追加(9);
        向量<整32> 甲列 = 取列f(列源);
        函列 = 甲列.大小();
    }
    如果 (函列 == 1 && 内存::活动分配数() - b128 == 0) { 校验 = 校验 + 128; }
    打印行("校验=", 校验);
    返回 校验;
}
