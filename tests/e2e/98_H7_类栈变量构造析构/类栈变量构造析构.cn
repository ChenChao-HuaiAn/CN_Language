// H7 宿主缺陷根治 E2E（2026-08-25）：类类型栈变量无初始化器声明（类名 变量）
//   此前缺 NewObject + 默认构造调用，变量槽存未初始化地址 -> 空指针解引用
//   （0xC0000409 / 运行时错误3）。泛型实例化（盒子$整64）与非泛型类（简单盒）
//   同样受影响（H7 记录：genVarDecl 对泛型类栈变量缺失 NewObject+构造+析构生成）。
// 修复：genVarDecl 对类类型栈变量无初始化器声明补 NewObject + 本类无参构造调用 +
//   oopVarSrcTypes_ RAII 登记（有析构函数类函数返回前 DeleteObject）。
// 覆盖：
//   1. 泛型类裸声明：构造 + 字段写 + 方法读（H7 原始复现：盒子<整64> a; a.值=7）
//   2. 非泛型类裸声明：同样路径
//   3. 默认构造确实被调用（构造内初始化字段 -> 读取验证）
//   4. 无构造函数的类裸声明 -> 默认构造仅分配（设字段后读取）
//   5. RAII 析构真实执行（泛型+非泛型各一，静态计数器验证，函数返回前 DeleteObject）
// 打印语义（用户裁决）：打印=println（自动换行）

// 析构计数器：静态字段验证 RAII 析构真实执行
类 计数站 {
公开:
    静态 整64 非泛型析构 = 0;
    静态 整64 泛型析构 = 0;
}

// 泛型类裸声明（H7 原始复现：盒子<整64> a; a.值=7）
泛型 <类型 T>
类 盒子 {
公开:
    T 值;

    函数 盒子() {
    }

    函数 获取() -> T {
        返回 值;
    }
}

// 非泛型类裸声明（同样受影响）
类 简单盒 {
公开:
    整64 值;

    函数 简单盒() {
    }

    函数 获取() -> 整64 {
        返回 值;
    }
}

// 默认构造做初始化：验证裸声明确实调用构造
类 计数盒 {
公开:
    整64 值;

    函数 计数盒() {
        值 = 42;
    }

    函数 获取() -> 整64 {
        返回 值;
    }
}

// 无构造函数：默认构造仅分配（malloc 不置零，须手动设字段）
类 裸盒 {
公开:
    整64 值;

    函数 获取() -> 整64 {
        返回 值;
    }
}

// 泛型类带析构：裸声明应登记 RAII，函数返回前 DeleteObject
泛型 <类型 T>
类 资源盒 {
公开:
    T 值;

    函数 资源盒() {
        值 = 0;
    }

    函数 ~资源盒() {
        计数站.泛型析构 = 计数站.泛型析构 + 1;
    }
}

// 非泛型类带析构：同样 RAII
类 资源简盒 {
公开:
    整64 值;

    函数 资源简盒() {
        值 = 0;
    }

    函数 ~资源简盒() {
        计数站.非泛型析构 = 计数站.非泛型析构 + 1;
    }
}

函数 测试析构() {
    资源盒<整64> r;
    r.值 = 9;
    资源简盒 s;
    s.值 = 8;
}

函数 主() -> 整32 {
    盒子<整64> a;
    a.值 = 7;
    打印("泛型裸声明: ", a.获取());

    简单盒 b;
    b.值 = 8;
    打印("非泛型裸声明: ", b.获取());

    计数盒 c;
    打印("默认构造调用: ", c.获取());

    裸盒 d;
    d.值 = 5;
    打印("无构造仅分配: ", d.获取());

    测试析构();
    打印("非泛型析构: ", 计数站.非泛型析构);
    打印("泛型析构: ", 计数站.泛型析构);

    返回 0;
}
