// E2E 1540_结果容器载荷成员链（#1562·零分叉）：
//   结果<容器,E>.值 / 可选<容器>.值 解包后的成员方法调用——载荷为泛型容器时
//   T 的模板文本（向量<整32>）须物化为实例名（向量$整32）再作成员链对象类型，
//   否则宿主「不是结构体/联合体/类类型」误拒、v2「方法调用对象类型未解析」
//   （IR 内部错误）。同一源码宿主+v2 各编各跑对照。
导入 容器::{向量};
导入 测试框架::{测试器, 运行用例, 断言真, 断言相等整数, 测试汇总};

不安全 函数 用例结果容器值(测试器* 器) {
    向量<整32> 源 = 向量<整32>();
    结果<空类型, 整32> 追 = 源.追加(5);
    断言真(器, 追.正常, "容器构造成功");
    结果<向量<整32>, 整32> 盒 = 正常(源);
    如果 (盒.正常) {
        断言相等整数(器, 盒.值.大小(), 1, "结果<容器>.值.大小");
        断言相等整数(器, 盒.值.元素(0), 5, "结果<容器>.值.元素");
    }
}

不安全 函数 用例可选容器值(测试器* 器) {
    向量<整32> 源 = 向量<整32>();
    结果<空类型, 整32> 追 = 源.追加(9);
    断言真(器, 追.正常, "容器构造成功2");
    可选<向量<整32>> 盒 = 某些(源);
    如果 (盒.有值) {
        断言相等整数(器, 盒.值.大小(), 1, "可选<容器>.值.大小");
        断言相等整数(器, 盒.值.元素(0), 9, "可选<容器>.值.元素");
    }
}

不安全 函数 主() -> 整32 {
    测试器 器 = 测试器();
    运行用例(器, "结果容器载荷成员链", 用例结果容器值);
    运行用例(器, "可选容器载荷成员链", 用例可选容器值);
    返回 整32(测试汇总(器));
}
