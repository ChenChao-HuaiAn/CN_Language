// E2E 1054_类名静态方法作值位置矩阵（任务972：806 附记遗留形态之扩展锁面·dual）
// 覆盖：类名.静态方法（**点号**形态）作值——与 040/082 函数指针声明位置全集
//   （字段位/数组元素位/形参位/返回位/全局位）的组合消费形态。本形体分叉
//   （v2 修前 IR 层「[ir2] 成员字段偏移未知: .X」误拒·宿主 P3-23 放行）已由
//   #912 修复并被 1027_点号静态方法作值 锁定（实参位/声明位/调用位/类内嵌套/
//   返回位）；本用例补锁其未覆盖的扩展位置面，防「同一发射点、不同消费位」
//   形态在后续重构中回归（912 单点=生成字段访问分流+发射静态方法引用值）。
// 锁面：①静态方法实参位（接收者=另一静态方法）②实例方法实参位 ③三目分支位
//   ④结构体字段赋值位 ⑤结构体指定初始化位 ⑥函数指针数组元素赋值位
//   ⑦函数指针变量改写位 ⑧类构造实参位 ⑨顶层静态槽初值位 ⑩跨模块点号作值
//   （导入类裸名点号——模块面与同文件面同通道回归锚）。
// 注：001 §5.8 方法作值条文=「静态方法 类名.静态方法 可直接作函数指针值」；
//   实例方法作值封口（806）不回归——本例仅静态方法作值（无 this 绑定）。
导入 工具跨模::工具跨模;

函数 应用(整32(*f)(整32), 整32 v) -> 整32 { 返回 f(v); }

结构体 持有 {
    整32(*槽)(整32)
}

类 计算器 {
公开:
    静态 函数 双倍(整32 x) -> 整32 { 返回 x * 2; }
    静态 函数 加一(整32 x) -> 整32 { 返回 x + 1; }
    静态 函数 转发(整32(*f)(整32), 整32 v) -> 整32 { 返回 f(v); }
    整32 基;
    函数 计算器() { 基 = 100; }
    函数 经实例(整32(*f)(整32), 整32 v) -> 整32 { 返回 f(v); }
}

类 消费 {
公开:
    整32 值;
    函数 消费(整32(*f)(整32)) { 值 = f(3); }
}

静态 整32(*静态回调)(整32) = 计算器.加一;

函数 主() -> 整32 {
    打印("===== 类名静态方法作值位置矩阵（972）=====");
    // ①静态方法实参位（接收者=另一静态方法）
    打印("静态方法实参: ", 计算器.转发(计算器.加一, 5));    // 6
    // ②实例方法实参位
    计算器 实例;
    打印("实例方法实参: ", 实例.经实例(计算器.双倍, 6));    // 12
    // ③三目分支位
    布尔 选双 = 真;
    整32(*句柄)(整32) = 选双 ? 计算器.双倍 : 计算器.加一;
    打印("三目分支: ", 句柄(7));                          // 14
    // ④结构体字段赋值位
    持有 甲;
    甲.槽 = 计算器.加一;
    打印("字段赋值: ", 甲.槽(7));                         // 8
    // ⑤结构体指定初始化位
    持有 乙 = 持有{槽 = 计算器.双倍};
    打印("指定初始化: ", 乙.槽(7));                       // 14
    // ⑥函数指针数组元素赋值位
    整32(*表[2])(整32);
    表[0] = 计算器.双倍;
    表[1] = 计算器.加一;
    打印("数组元素: ", 表[0](7) + 表[1](7));             // 22
    // ⑦函数指针变量改写位（初始位+改写位）
    整32(*改)(整32) = 计算器.双倍;
    改 = 计算器.加一;
    打印("变量改写: ", 改(9));                            // 10
    // ⑧类构造实参位
    消费 丙 = 消费(计算器.双倍);
    打印("构造实参: ", 丙.值);                            // 6
    // ⑨顶层静态槽初值位（入口注入·只读消费）
    打印("静态槽: ", 静态回调(9));                        // 10
    // ⑩跨模块点号作值（导入类裸名——外模块类名点号与同文件同通道）
    打印("跨模块点号: ", 应用(工具跨模.加十, 5));          // 15
    打印("===== 完成 =====");
    返回 0;
}
