// 882（#622·2026-10-14）：显式解引用成员访问偏移族（(*指针).字段）——宿主地址层
//   类型推导根治锁面（memberObjStructType 缺解引用操作数推导 → (*任意指针).非零
//   偏移字段 写落偏移 0/读静默降级 0·p1005 同族·614 仅偏移 0 字段巧合掩盖；
//   类路径 exprSrcType 缺 Deref → (*类指针).字段 写落 [对象+0]）。
//   双编译对照=宿主与 v2 同测同期望（零分叉红线）；plans/001：`q.x ≡ (*q).x`
//   （. 左侧指针自动解引用一级），(*pp).字段 解一层后同此语义。
//   形态矩阵：①二级指针形参 写+读 ②一级指针显式解引用非零偏移 ③显式双解
//   ④复合赋值/自增写回 ⑤类对象（字段写读+方法 this）⑥自动解引用对照锚。
//   类字段形态（(*类字段指针).字段 方法内）v2 基线拒（594 同族·待 594 集成后补锁）。
结构体 乙 { 整32 填充; 整32 字段; }

类 箱 {
公开:
    整32 填充;
    整32 字段;
    函数 箱() { 填充 = 5; 字段 = 6; }
    不安全 函数 加成(整32 v) -> 空类型 { 字段 += v; }
}

不安全 函数 写形参二(乙** pp, 整32 v) -> 空类型 {
    (*pp).字段 = v;
}
不安全 函数 读形参二(乙** pp) -> 整32 {
    返回 (*pp).字段;
}
不安全 函数 写双解(乙** pp, 整32 v) -> 空类型 {
    (**pp).字段 = v;
}
不安全 函数 复合二(乙** pp, 整32 v) -> 空类型 {
    (*pp).字段 += v;
}
不安全 函数 自增二(乙** pp) -> 空类型 {
    (*pp).字段++;
}

不安全 函数 主() -> 整32 {
    // ① 二级指针形参：(*pp).字段 写+读
    乙 甲 = 乙{ 填充 = 11, 字段 = 22 };
    乙* 甲指 = &甲;
    写形参二(&甲指, 99);
    打印(甲.填充);
    打印(甲.字段);
    打印(读形参二(&甲指));

    // ② 一级指针显式解引用（非零偏移字段——614 偏移 0 巧合面外）
    乙 乙1 = 乙{ 填充 = 33, 字段 = 44 };
    乙* 乙指 = &乙1;
    (*乙指).字段 = 55;
    打印(乙1.填充);
    打印(乙1.字段);

    // ③ 显式双解引用
    乙 丙 = 乙{ 填充 = 1, 字段 = 2 };
    乙* 丙指 = &丙;
    写双解(&丙指, 77);
    打印(丙.填充);
    打印(丙.字段);

    // ④ 复合赋值与自增写回
    乙 丁 = 乙{ 填充 = 5, 字段 = 30 };
    乙* 丁指 = &丁;
    复合二(&丁指, 7);
    打印(丁.填充);
    打印(丁.字段);
    自增二(&丁指);
    打印(丁.字段);

    // ⑤ 类对象：(*类指针).字段 写/读 + 方法调用 this
    箱 具 = 箱();
    箱* 具指 = &具;
    (*具指).字段 = 44;
    打印(具.填充);
    打印(具.字段);
    (*具指).加成(6);
    打印(具.字段);
    打印((*具指).字段);

    // ⑥ 自动解引用对照（p.字段 ≡ (*p).字段 等价锚）
    乙 己 = 乙{ 填充 = 12, 字段 = 13 };
    乙* 己指 = &己;
    己指.字段 = 66;
    打印(己.填充);
    打印(己.字段);

    返回 0;
}
