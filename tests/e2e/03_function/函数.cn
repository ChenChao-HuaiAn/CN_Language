// 函数E2E测试：覆盖 函数原型声明（前向引用）/ 递归调用 / 函数指针（声明/赋值/调用）
// 注意：本文件为中文名（run_e2e.py 用 *.cn glob 遍历，支持中文文件名）
// 入口函数 主 返回 整32，返回0表示成功

// ---- 1. 函数原型声明（前向引用）：声明在调用之前，定义在调用之后 ----
函数 计算(整32 n) -> 整32

函数 使用前向() -> 整32 {
    返回 计算(10)   // 调用时 计算 仅有原型声明，定义在文件末尾
}

// ---- 2. 递归调用：阶乘 ----
函数 阶乘(整32 n) -> 整32 {
    如果 (n <= 1) {
        返回 1
    }
    返回 n * 阶乘(n - 1)   // 递归调用自身
}

// ---- 3. 函数指针：声明/赋值/调用（规格书5.8 C风格） ----
函数 加(整32 a, 整32 b) -> 整32 {
    返回 a + b
}

函数 减(整32 a, 整32 b) -> 整32 {
    返回 a - b
}

函数 主() -> 整32 {
    // ---- 1. 前向引用验证：计算 定义在文件末尾，这里调用 ----
    打印行("前向引用: 计算(10)=")
    打印行整数(使用前向())

    // ---- 2. 递归验证：阶乘 ----
    打印行("递归: 阶乘(5)=")
    打印行整数(阶乘(5))

    // ---- 3. 函数指针声明（C风格类型）+ 赋值 + 调用 ----
    整32(*回调)(整32, 整32)
    回调 = 加
    打印行("函数指针: 回调(20, 30)=")
    打印行整数(回调(20, 30))

    // 重新赋值后调用另一个函数
    回调 = 减
    打印行("函数指针: 回调(50, 30)=")
    打印行整数(回调(50, 30))

    // 函数指针作为参数传递
    打印行("函数指针作参数: 执行(回调, 100, 40)=")
    打印行整数(执行(回调, 100, 40))

    返回 0
}

// 定义在调用之后（前向引用依赖原型声明）
函数 计算(整32 n) -> 整32 {
    返回 n * 2
}

// 函数指针作参数：func(整32, 整32) -> 整32
函数 执行(整32(*func)(整32, 整32), 整32 x, 整32 y) -> 整32 {
    返回 func(x, y)
}
