// 集成改号（2026-10-16·任务 306 rebase 收口）：662_打印字符形态 → 1025_打印字符形态
//   ——662 号已被 v16 采样轮 662_静态拥有型跨调用保持 先占（develop 集成在先）；
//   本号改后：服务端领用例号 发号 1025·coverage_map 登记行名同步。
导入 核心::错误码;

函数 主() -> 整32 {
    打印('甲');                      // 字符字面量形态
    打印('中');
    打印('\u{4E2D}');                // \u 转义形态（= '中'）
    字符 字变 = '乙';
    打印(字变);                      // 字符变量形态
    打印(整32('甲'));                // 码点数值形态（显式通道）
    返回 0;
}
