// 539（814 轮·053-001 探针转正）：128 位剩余运算矩阵——移位（小量/≥64/≥128 掩码
//   语义）/位运算（& | ^ 双半独立）/一元负（取反加一）/大字面量泛化（超整64域
//   归整128·实参/初值/减法/无后缀/LL 后缀/负大）。双编译对照：宿主内联
//   shld/shl 分支与 v2 __cn_shl_i128/shr/neg 辅助函数行为契约逐字一致。
函数 收大(整128 x) -> 整128 {
    返回 x;
}
函数 主() -> 整32 {
    整128 甲 = 1000;
    打印行(甲 << 3);
    打印行(甲 >> 3);
    打印行(甲 << 64);
    打印行(甲 << 130);
    打印行(甲 & 255);
    打印行(甲 | 7);
    打印行(甲 ^ 15);
    打印行(-甲);
    整128 大 = 170141183460469231731687303715884105727;
    打印行(大 << 1);
    打印行(-大);
    打印行(大 >> 100);
    打印行(收大(170141183460469231731687303715884105727));
    整128 局2 = 170141183460469231731687303715884105727;
    打印行(局2 - 170141183460469231731687303715884105727);
    打印行(18446744073709551617 + 1);
    打印行(999999999999999999LL + 1);
    打印行(收大(-170141183460469231731687303715884105727));
    返回 0;
}
