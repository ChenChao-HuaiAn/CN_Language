// E2E 1049：结果类型字段布局倒挂声明序（#920 修复宿主锁面·宿主侧单跑）
// 面：依赖结构体声明在使用者之后（前向引用）——宿主修复前布局固化窗口缺陷
//   ①倒挂外：盒4[2] 数组字段=0（元素未布局时 typeSizeOf 0×2 固化；修复后 8）
//   ②倒挂内：结果<盒4,整32> 字段=12（合成体防御值固化；修复后 16）
//   ③倒挂包：嵌套链=12（修复后 16）
// v2 侧为未支持面（①元素尺寸防御 8 错值 16；②③ v2p 内部错误「结果载荷字节
//   未登记」）——v2 时机族缺陷已立项（#920 呈报），本用例宿主侧先行锁定；
//   v2 侧配对用例待 v2 修复后补（1049_v2_…）。
结构体 倒挂外 {
    盒4[2] 域;
}
结构体 倒挂内 {
    结果<盒4, 整32> 槽;
}
结构体 倒挂包 {
    倒挂内 域;
}
结构体 盒4 {
    整32 甲;
}

函数 主() -> 整32 {
    打印("倒挂外:", 类型大小(倒挂外));
    打印("倒挂内:", 类型大小(倒挂内));
    打印("倒挂包:", 类型大小(倒挂包));
    返回 0;
}
