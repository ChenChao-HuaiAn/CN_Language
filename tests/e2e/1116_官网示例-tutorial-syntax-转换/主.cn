// 官网文档示例 · tutorial-syntax.html · 类型转换（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
函数 主() -> 整32 {
    整32 小 = 7;
    整64 大 = 小;                // 宽化：隐式放行
    浮64 比例 = 浮64(小) / 4;    // 显式转浮点 → 1.75
    整32 截断 = 整32(3.99);      // 浮转整：截断 → 3
    正64 位模式 = 正64(整32(-1)); // 升宽：符号扩展 → 2^64-1
    打印(大, " ", 比例, " ", 截断, " ", 位模式 == 18446744073709551615);
    返回 0;
}