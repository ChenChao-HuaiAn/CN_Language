// E2E 235（2026-09-12 第八十一轮，宿主单侧内存断言用例）：
//   **容器元素含串字段结构体的实参形态**——宿主 81-a 修复的两类实参路径（v2 侧
//   对应形态为已登记缺口：帧尾共享 retbuf 覆盖，见 E2E 234 形六 注记与 plans/020
//   第十三节）：
//     ① 调用返回实参入容器（`表.追加(造盒子(6))`）：返回临时字段串释放
//        （genArgValueWithCleanup/flushPendingArgCleanups）+ 内容守恒
//     ② 结构体字面量实参入容器（`表.追加(盒子{...})`）：原方法调用路径物化缺失
//        → 实参地址=空指针段错误（materializeStructInitArg 修复）+ 内容守恒
//     ③ 结构体字面量实参传普通函数（按值参数 ABI）
//     ④ 向量 元素移动（移位）后 删除/设置 路径 + 调用返回实参
//     ⑤ 链表/栈/队列/集合 结构体元素 + 删除/清空 路径（链式容器按链游释放）
//     ⑥ 循环 20 万轮（调用返回实参入容器）块出口 drop
//     ⑦ 借用来源（形参串）与调用返回实参组合
//     ⑧ 结构体字面量传「含串字段形参」的被调函数（被调方字段写入归一化）
//   校验和折位：①1 ②2 ③4 ④8 ⑤16 ⑥32 ⑦64 ⑧128 —— 255=全对；宿主侧退出码恒 0，
//   校验和经打印行承载（与 220 同款口径）。
导入 容器::向量;
导入 容器::链表;
导入 容器::栈;
导入 容器::队列;
导入 映射集合;

结构体 盒子 {
    字符串 名;
    整32 号;
}

函数 搅动() -> 整64 {
    整64 和 = 0;
    整64 i = 0;
    当 (i < 16) {
        字符串 垃圾 = 字符串复制("搅动内存填充占位字符串内容甲乙丙丁戊己庚辛壬癸");
        和 = 和 + 字符串长度(垃圾);
        i++;
    }
    返回 和;
}

函数 造盒子(整32 号) -> 盒子 {
    盒子 内 = 盒子{ 名 = 字符串复制("E235占位内容甲乙丙丁戊己庚辛壬癸子丑寅卯辰"), 号 = 号 };
    返回 内;
}

// ① 调用返回实参入容器
函数 形一() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        向量<盒子> 表 = 向量<盒子>();
        结果<空类型, 整32> 加 = 表.追加(造盒子(1));
        如果 (!加.正常) { 返回 0; }
        盒子 读 = 表.元素(0);
        如果 (读.号 == 1 && 字符串比较(读.名, "E235占位内容甲乙丙丁戊己庚辛壬癸子丑寅卯辰")) { 校验 = 1; }
        搅动();
        盒子 读2 = 表.元素(0);
        如果 (!字符串比较(读2.名, "E235占位内容甲乙丙丁戊己庚辛壬癸子丑寅卯辰")) { 校验 = 0; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验;
}

// ② 结构体字面量实参入容器
函数 形二() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        向量<盒子> 表 = 向量<盒子>();
        结果<空类型, 整32> 加 = 表.追加(盒子{ 名 = 字符串复制("E235字面量内容甲乙丙丁戊己庚辛壬癸子丑"), 号 = 2 });
        如果 (!加.正常) { 返回 0; }
        盒子 读 = 表.元素(0);
        如果 (读.号 == 2 && 字符串比较(读.名, "E235字面量内容甲乙丙丁戊己庚辛壬癸子丑")) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 2;
}

// ③ 结构体字面量实参传普通函数
函数 取号(盒子 箱) -> 整32 {
    返回 箱.号;
}

函数 形三() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        如果 (取号(盒子{ 名 = 字符串复制("E235普通函数内容甲乙丙丁戊己庚辛"), 号 = 3 }) == 3) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 4;
}

// ④ 向量 删除/设置 + 调用返回实参（元素移动路径）
函数 形四() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        向量<盒子> 表 = 向量<盒子>();
        结果<空类型, 整32> 加1 = 表.追加(造盒子(41));
        结果<空类型, 整32> 加2 = 表.追加(造盒子(42));
        如果 (!加1.正常 || !加2.正常) { 返回 0; }
        结果<空类型, 整32> 删 = 表.删除(0);
        如果 (!删.正常) { 返回 0; }
        盒子 读 = 表.元素(0);
        如果 (读.号 == 42) { 校验 = 1; }
        结果<空类型, 整32> 设 = 表.设置(0, 造盒子(43));
        如果 (!设.正常) { 返回 0; }
        盒子 读2 = 表.元素(0);
        如果 (读2.号 != 43) { 校验 = 0; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 8;
}

// ⑤ 链表/栈/队列/集合 结构体元素 + 删除/清空
函数 形五() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        链表<盒子> 链 = 链表<盒子>();
        结果<空类型, 整32> 加1 = 链.头部追加(造盒子(51));
        结果<空类型, 整32> 加2 = 链.头部追加(造盒子(52));
        如果 (!加1.正常 || !加2.正常) { 返回 0; }
        结果<空类型, 整32> 删1 = 链.删除头部();
        如果 (!删1.正常) { 返回 0; }
        结果<盒子, 整32> 头 = 链.读取头部();
        如果 (头.正常) {
            如果 (头.值.号 == 51) { 校验 = 1; }
        } 否则 {
            校验 = 0;
        }
        栈<盒子> 栈表 = 栈<盒子>();
        结果<空类型, 整32> 压 = 栈表.压入(造盒子(53));
        如果 (!压.正常) { 返回 0; }
        队列<盒子> 队 = 队列<盒子>();
        结果<空类型, 整32> 入 = 队.入队(造盒子(54));
        如果 (!入.正常) { 返回 0; }
        集合<盒子> 集 = 集合<盒子>();
        结果<空类型, 整32> 添 = 集.添加(造盒子(55));
        如果 (!添.正常) { 返回 0; }
        布尔 删集 = 集.删除(造盒子(55));
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 16;
}

// ⑥ 循环 20 万轮（调用返回实参入容器）
函数 形六(整64 轮数) -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 i = 0;
    当 (i < 轮数) {
        向量<盒子> 表 = 向量<盒子>();
        结果<空类型, 整32> 加 = 表.追加(造盒子(60));
        如果 (!加.正常) { 返回 0; }
        盒子 读 = 表.元素(0);
        如果 (读.号 != 60) { 返回 0; }
        i++;
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 32;
}

// ⑦ 借用来源（形参串）与调用返回实参组合
函数 存入返回(向量<盒子> 表, 字符串 值) -> 整64 {
    结果<空类型, 整32> 加 = 表.追加(盒子{ 名 = 值, 号 = 70 });
    如果 (!加.正常) { 返回 0; }
    返回 1;
}

函数 形七() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        向量<盒子> 表 = 向量<盒子>();
        字符串 本地 = 字符串复制("E235借用来源内容甲乙丙丁戊己庚辛壬癸");
        结果<空类型, 整32> 加 = 表.追加(造盒子(71));
        如果 (!加.正常) { 返回 0; }
        如果 (存入返回(表, 本地) == 1) { 校验 = 1; }
        搅动();
        如果 (!字符串比较(本地, "E235借用来源内容甲乙丙丁戊己庚辛壬癸")) { 校验 = 0; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 64;
}

// ⑧ 结构体字面量传「含串字段形参」的被调函数（按值参数 ABI + 参数=借用视图读取）
//   注：被调方**写**按值参数字段 = 归一化复制落堆且被调方不释放（参数=借用视图）
//   ——79-a 登记的诚实边界（宁漏勿错），本用例只覆盖读取面（内容守恒）。
函数 查名(盒子 箱, 字符串 期望) -> 整32 {
    如果 (字符串比较(箱.名, 期望)) { 返回 1; }
    返回 0;
}

函数 形八() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        字符串 期望 = 字符串复制("E235参数读取内容甲乙丙丁戊己庚辛壬癸");
        如果 (查名(盒子{ 名 = 字符串复制("E235参数读取内容甲乙丙丁戊己庚辛壬癸"), 号 = 80 }, 期望) == 1) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 128;
}

函数 主() -> 整32 {
    整64 和 = 0;
    和 = 和 + 形一();
    和 = 和 + 形二();
    和 = 和 + 形三();
    和 = 和 + 形四();
    和 = 和 + 形五();
    和 = 和 + 形六(200000);
    和 = 和 + 形七();
    和 = 和 + 形八();
    打印("校验和(期望255)=", 和);
    返回 0;
}
