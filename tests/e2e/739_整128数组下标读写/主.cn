// E2E 739：整128 数组下标读写通道双编译对照（472 锁用例）
// 覆盖：128 位大标量（16 字节双槽）数组元素的下标写/下标读/双元素互不踩/
//   大值高段/句柄赋值（元素→变量→元素）/指针别名读写（同函数+跨函数 整128*
//   形参直传）/静态数组——修前 v2 读通道双重解引用（生成下标访问 8 字节装载
//   值却登记 T_整128，下游按「值=句柄」再解引用→元素值 7 被当地址 fault=07
//   段错误·宿主绿分叉）+整128* 声明/标识符求值误走 128 句柄通道（指针值被
//   物化 2 槽+槽地址语义→p[0] 读到指针值本身·p[1]=13 写进物化临时）。
// 规格依据：3.5（数组下标=基址+i×元素步进·元素宽=类型宽 16）、128 位值
//   通道（值=16 字节槽地址句柄·810 全链约定）。
// 双侧等价判据：同一源码宿主与 v2 各编各跑，stdout 逐行全等+退出码 0。
静态 整128[3] 静表;

不安全 函数 指针低半(整128* p) -> 整64 {
    返回 整64(p[0]);
}

不安全 函数 指针装填(整128* p, 整64 v) -> 整32 {
    p[1] = v;
    返回 0;
}

函数 主() -> 整32 {
    // ① 下标写+读回（步进 16 双槽写·读=元素地址句柄）
    整128[2] 表;
    表[0] = 7;
    表[1] = 9;
    打印("下标写读(期望7 9): ", 整64(表[0]), " ", 整64(表[1]));

    // ② 双元素互不踩（改 [1] 不污染 [0]——16 字节步进不塌缩 8）
    表[1] = 11;
    打印("互不踩(期望7 11): ", 整64(表[0]), " ", 整64(表[1]));

    // ③ 大值（高段位非零域边界·双半写齐）
    表[0] = 999999999999;
    打印("大值(期望999999999999): ", 整64(表[0]));

    // ④ 句柄赋值：元素 → 128 变量（读=地址句柄直通）→ 另一元素（双半拷）
    整128 x = 表[0];
    打印("句柄读(期望999999999999): ", 整64(x));
    表[1] = x;
    打印("句柄写(期望999999999999): ", 整64(表[1]));

    // ⑤ 指针别名（同函数 p[i] + 跨函数 整128* 形参直传·安全区边界）
    整128* p = 表;
    整64 低 = 指针低半(p);
    打印("指针读(期望999999999999): ", 低);
    指针装填(p, 13);
    打印("指针写(期望13): ", 整64(表[1]));

    // ⑥ 静态数组（.data 槽地址语义·三元素互不踩·默认零）
    静表[0] = 17;
    静表[2] = 19;
    打印("静态(期望17 0 19): ", 整64(静表[0]), " ", 整64(静表[1]), " ", 整64(静表[2]));

    返回 0;
}
