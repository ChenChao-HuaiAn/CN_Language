// E2E 197（宿主负测，2026-09-10 第五十七轮 plans/019 阶段1 · 编译期安全）：
//   已转移变量使用拒绝（对标 Rust E0382）。五负形态：
//   ①读值（表.大小()）②赋值目标（表 = ...）③传参（消费(表)）④返回
//   （返回 v2）⑤标量误转移（转移(a)——复制语义拒绝）。
//   期望编译失败.txt 固化诊断子串「已转移，不能继续使用」。
导入 容器::向量;

函数 消费(向量<整64>& 数据) -> 整64 {
    返回 数据.大小();
}

函数 还回() -> 向量<整64> {
    向量<整64> v2 = 向量<整64>();
    向量<整64> u2 = 转移(v2);
    返回 v2;
}

函数 主() -> 整32 {
    向量<整64> 表 = 向量<整64>();
    结果<空类型, 整32> 加1 = 表.追加(10);
    向量<整64> 接 = 转移(表);
    打印行(表.大小());
    表 = 向量<整64>();
    消费(表);
    整32 a = 5;
    整32 b = 转移(a);
    返回 0;
}
