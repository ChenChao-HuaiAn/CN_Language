// E2E 42_generic_field_loop：泛型类方法内循环遍历第一个泛型字段（Debug 子任务缺陷4）
// 背景：双字段（或双类型参数）泛型类方法内 `当(索引<长度){ 字段[索引] }` 运行时损坏
//   （索引≥2 读垃圾值），仅「第一个泛型字段 + 循环」组合损坏；固定下标读取正常。
// 本用例：泛型类 盒子<T> 含 T* 数据 字段，方法内循环遍历（修复验证）。

泛型 <类型 T>
类 盒子 {
    私有:
    T* 数据;
    整64 长度;

    公开:
    函数 盒子(T* 初始数据, 整64 初始长度) {
        数据 = 初始数据;
        长度 = 初始长度;
    }

    // 循环遍历第一个泛型字段（缺陷场景：索引≥2 读垃圾）
    函数 遍历求和() -> T {
        T 总和 = 数据[0];
        整64 索引 = 1;
        当 (索引 < 长度) {
            总和 = 总和 + 数据[索引];
            索引 = 索引 + 1;
        }
        返回 总和;
    }
}

// 打印变参内嵌泛型类字段下标（lessons 记录的第二类损坏场景）：
//   泛型类方法内 打印("元素", 索引, ": ", 数据[索引])——修复后应输出正确值
泛型 <类型 T>
类 打印盒 {
    私有:
    T* 数据;
    整64 长度;

    公开:
    函数 打印盒(T* 初始数据, 整64 初始长度) {
        数据 = 初始数据;
        长度 = 初始长度;
    }

    函数 打印全部() -> 空类型 {
        整64 索引 = 0;
        当 (索引 < 长度) {
            打印("元素", 索引, ": ", 数据[索引]);
            索引 = 索引 + 1;
        }
    }
}

函数 主() -> 整32 {
    整64[6] 数据 = { 10, 20, 30, 40, 50, 60 };
    盒子<整64> 盒 = 盒子<整64>(数据, 6);
    整64 总和 = 盒.遍历求和();
    打印("总和: ", 总和);
    打印盒<整64> 打印盒对象 = 打印盒<整64>(数据, 3);
    打印盒对象.打印全部();
    返回 0;
}
