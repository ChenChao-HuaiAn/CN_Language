// E2E 1487（1471·安全区对齐主面落位锁面）：安全区 **(括号解引用+成员访问)
//   组合形态** 拒绝——(*pb).名() / (*p).x / (**pp).x 组合读=宿主 checkDerefUnary
//   B6「[安全区边界] 裸指针解引用读应在 不安全 函数 内（指针解引用（*p））」
//   （v2 同文同拒）；(*p) = 9 解引用直写=B7「裸指针解引用写」（v2 同文同拒）。
//   修前 v2 对组合读 rc=0 放行=零分叉红线（871-a 解析归一哨兵化解引用节点：
//   76-a 解引用读挂点只认存活 节点_解引用·926 差层=N-k=1-1=0 双 miss——
//   1471 组合挂点+事件表收口）。写目标链中/副本链=宿主 assignmentTargetDepth_
//   抑制面放行（正例面 1488 旁证·b2/i 探针双侧实录）。（探针 1471a/e 同形）
// 预期失败。
类 基 { 公开: 整32 v; 函数 名() -> 整32 { 返回 v + 100; } }
类 派 : 基 { 公开: 整32 w; }
结构体 点 {
    整32 x;
}
函数 主() -> 整32 {
    派 p = 派();
    p.v = 5;
    基* pb = &p;
    整32 a1 = (*pb).名();
    点 值 = 点{ x = 3 };
    点* q = &值;
    点** qq = &q;
    整32 a2 = (**qq).x;
    整32 目标 = 7;
    整32* 目针 = &目标;
    (*目针) = 9;
    打印(a1);
    打印(a2);
    返回 0;
}
