// E2E 939_JSON生成边界族（#728p·2026-10-14）：JSON 生成侧构建器改造验收纵深——
//   366 遗留生成侧同族（原 逐段 字符串连接=每段整串重拷 O(n²)）改 字符串构建器
//   句柄直追加 + 子链遍历一趟（原 子数()+子(节,序) 每序号从链头重走=O(子数²)
//   遍历热点·同轮根治）。覆盖：
//   ① 空壳三态（[] {} 与嵌套空壳·紧凑+美化逐字）；
//   ② 深嵌套 4 层美化缩进逐字；
//   ③ 全控制字符 0x01~0x1f 生成转义形态逐字（\b\t\n\f\r 短形+其余 \u00XX）；
//   ④ 多字节直通（2/3/4 字节·代理对解码后再生逐字）；
//   ⑤ 键序保持（对象成员插入序）。
//   〔拆分注记（#728p）〕生成路径泄漏断言（216 口径）拆至 942_JSON生成泄漏断言
//   （**宿主单侧**绿收口——该断言窗口含 生成JSON/数值转换返回的变量初始化位，
//   v2 侧 A2 返回拥有登记缺口每处漏 1=零分叉，已立 #748；#748 清偿轮 942 加
//   双编译对照.txt 扩 dual）。
//   断言走 测试框架（JSON+测试框架 双模块同轮 dual·669/859 同构）。
导入 测试框架::{测试器, 运行用例, 断言相等整数, 断言相等文本, 测试汇总};
导入 JSON::{JSON树, 解析JSON, 生成JSON, JSONE_好};

// ① 空壳三态+嵌套空壳：紧凑与美化两种缩进逐字
不安全 函数 用例空壳生成(测试器* 器) {
    JSON树 树 = JSON树();
    解析JSON(树, "[[],{},[[]],{\"空\":[]},{\"空对\":{}}]");
    断言相等整数(器, 树.错误码, JSONE_好, "空壳解析");
    断言相等文本(器, 生成JSON(树, 树.根, 0), "[[],{},[[]],{\"空\":[]},{\"空对\":{}}]", "空壳紧凑逐字");
    断言相等文本(器, 生成JSON(树, 树.根, 2), "[\n  [],\n  {},\n  [\n    []\n  ],\n  {\n    \"空\": []\n  },\n  {\n    \"空对\": {}\n  }\n]", "空壳美化逐字");
}

// ② 深嵌套 4 层美化缩进逐字（数组/对象交替）
不安全 函数 用例深嵌套美化(测试器* 器) {
    JSON树 树 = JSON树();
    解析JSON(树, "{\"甲\":{\"乙\":[1,{\"丙\":[]}]}}");
    断言相等整数(器, 树.错误码, JSONE_好, "深嵌套解析");
    断言相等文本(器, 生成JSON(树, 树.根, 0), "{\"甲\":{\"乙\":[1,{\"丙\":[]}]}}", "深嵌套紧凑逐字");
    断言相等文本(器, 生成JSON(树, 树.根, 2), "{\n  \"甲\": {\n    \"乙\": [\n      1,\n      {\n        \"丙\": []\n      }\n    ]\n  }\n}", "深嵌套美化逐字");
}

// ③ 全控制字符 0x01~0x1f：\b\t\n\f\r 走短形·其余 \u00XX（RFC 8259 生成侧转义全集）
不安全 函数 用例控制字符转义(测试器* 器) {
    JSON树 树 = JSON树();
    解析JSON(树, "\"\\u0001\\u0002\\u0003\\u0004\\u0005\\u0006\\u0007\\u0008\\u0009\\u000a\\u000b\\u000c\\u000d\\u000e\\u000f\\u0010\\u0011\\u0012\\u0013\\u0014\\u0015\\u0016\\u0017\\u0018\\u0019\\u001a\\u001b\\u001c\\u001d\\u001e\\u001f\"");
    断言相等整数(器, 树.错误码, JSONE_好, "控制字符解析");
    断言相等文本(器, 生成JSON(树, 树.根, 0), "\"\\u0001\\u0002\\u0003\\u0004\\u0005\\u0006\\u0007\\b\\t\\n\\u000b\\f\\r\\u000e\\u000f\\u0010\\u0011\\u0012\\u0013\\u0014\\u0015\\u0016\\u0017\\u0018\\u0019\\u001a\\u001b\\u001c\\u001d\\u001e\\u001f\"", "控制字符转义全集逐字");
}

// ④ 多字节直通：\u00e9（2 字节 é）/ \u4f60（3 字节 你）/ 代理对（4 字节 😀）
//   解码→生成再生逐字（非 ASCII 不经 \u 转义·原字节直通）
不安全 函数 用例多字节直通(测试器* 器) {
    JSON树 树 = JSON树();
    解析JSON(树, "\"\\u00e9\\u4f60\\ud83d\\ude00\"");
    断言相等整数(器, 树.错误码, JSONE_好, "多字节解析");
    字符串 再生 = 生成JSON(树, 树.根, 0);
    断言相等整数(器, 字符串长度(再生), 11, "再生长=2引号+2+3+4");
    断言相等文本(器, 再生, "\"é你😀\"", "多字节直通逐字");
}

// ⑤ 键序保持：对象成员生成按插入序（平行数组 arena 子链序）
不安全 函数 用例键序保持(测试器* 器) {
    JSON树 树 = JSON树();
    解析JSON(树, "{\"丙\":1,\"甲\":2,\"乙\":3,\"丁\":{\"庚\":4,\"戊\":5}}");
    断言相等整数(器, 树.错误码, JSONE_好, "键序解析");
    断言相等文本(器, 生成JSON(树, 树.根, 0), "{\"丙\":1,\"甲\":2,\"乙\":3,\"丁\":{\"庚\":4,\"戊\":5}}", "键序保持逐字");
}

不安全 函数 主() -> 整32 {
    测试器 器 = 测试器();
    运行用例(器, "空壳生成", 用例空壳生成);
    运行用例(器, "深嵌套美化", 用例深嵌套美化);
    运行用例(器, "控制字符转义", 用例控制字符转义);
    运行用例(器, "多字节直通", 用例多字节直通);
    运行用例(器, "键序保持", 用例键序保持);
    整64 失败数 = 测试汇总(器);
    打印("汇总返回失败用例数=", 失败数);
    返回 0;
}
