// 697(#422·002 收口轮·682 姊妹锁用例):自增/自减窄域写回回绕六路矩阵
//   (整16 域 [-32768,32767]·001 §3.7a)。
// 缺陷:语句位 发射自增自减 四路(引用/局部/静态/类字段)+表达式位 生成自增表达式
//   静态/字段两路——写回前漏 窄宽值规范化。槽模型 8 字节全宽存储,32767+1=32768
//   原样入槽,消费读 32768(宿主窄槽写回截断回绕 -32768)。表达式位局部路 894-a
//   已有规范化(682 锚),其余路同构漏网=319 修复面残留通道。
// 七形态:①语句位·局部(682 同锚)②语句位·静态 ③语句位·引用形参 ④语句位·类字段
//   ⑤表达式位·静态后缀 ⑥表达式位·局部前缀 ⑦表达式位·局部后缀(682 原锚)。
// 期望:全部回绕落 16 位域(前缀压回=规范后新值·后缀压回=旧值)。
类 计数器 {
公开:
    函数 计数器() { }
    整16 计;
    函数 步进() -> 整32 {
        计 = 32767;
        计++;
        返回 整32(计);
    }
}
函数 增一(整16& x) -> 空类型 {
    x++;
}
函数 主() -> 整32 {
    整16 h = 32767;
    h++;
    打印行(整32(h));
    静态 整16 s = 32767;
    s++;
    打印行(整32(s));
    整16 r = 32767;
    增一(r);
    打印行(整32(r));
    计数器 c = 计数器();
    打印行(c.步进());
    静态 整16 s2 = 32767;
    打印行(整32(s2++));
    打印行(整32(s2));
    整16 f = 32767;
    打印行(整32(++f));
    整16 g = 32767;
    打印行(整32(g++));
    打印行(整32(g));
    返回 0;
}
