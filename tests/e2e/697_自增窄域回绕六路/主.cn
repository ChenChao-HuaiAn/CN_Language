// 697(#422·002 收口轮·682 姊妹锁用例):自增/自减窄域写回矩阵（整16 域·001 §3.7a）
// **#474 立法翻转（2026-10-11 用户裁决乙案：变量面溢出=错误码 8 确定性失败）**：
//   原锚「32767++ 六/七路写回回绕 ≡ -32768（写回前漏窄宽值规范化缺陷 422 的
//   修复锁）」随 001 §3.7a 废除——回绕写回语义验证职责移交 731_回绕函数矩阵；
//   自增溢出触发面=725（整32）/682（整16 #474 翻转锁）。
//   本用例存续职责=①七形态窄域写回复原通路**域内**零误伤对照（32766++=32767
//   上界·前缀压回=新值·后缀压回=旧值——通路不因溢出检查误伤）+②语句位·局部
//   路 32767++ 触发错误码 8 收尾（检查与写回规范化同发射面·其余六路同构）。
//   注：本用例 打印行 输出不带换行（expected 连排形态·实测锚定）。
// 七形态:①语句位·局部(682 同锚)②语句位·静态 ③语句位·引用形参 ④语句位·类字段
//   ⑤表达式位·静态后缀 ⑥表达式位·局部前缀 ⑦表达式位·局部后缀(682 原锚)。
// 480 执法适配（§747 表第 8 行整族执法·测试适配报备）：主内函数内静态写
//   （s/s2）须 不安全 函数——主标 不安全；②溢出触发段随迁独立安全函数
//   （§1.1a④ 不安全函数不插溢出检查——错误码 8 终止验证意图须安全函数承载；
//   段语句与执行顺序逐字保持·断言/expected/数据零变更）。
类 计数器 {
公开:
    函数 计数器() { }
    整16 计;
    函数 步进() -> 整32 {
        计 = 32766;
        计++;
        返回 整32(计);
    }
}
函数 增一(整16& x) -> 空类型 {
    x++;
}
// 480 适配迁出段（原 主 尾·②触发形态·语义等价）：溢出检查须安全函数承载。
函数 溢出触发() -> 整32 {
    整16 t = 32767;
    t++;                       // → 运行时错误(错误码8): 溢出错误 终止
    打印行(整32(t));
    返回 0;
}
不安全 函数 主() -> 整32 {
    // ①~⑦ 域内零误伤对照（32766++=32767 上界·七形态全通）
    整16 h = 32766;
    h++;
    打印行(整32(h));           // 32767
    静态 整16 s = 32766;
    s++;
    打印行(整32(s));           // 32767
    整16 r = 32766;
    增一(r);
    打印行(整32(r));           // 32767
    计数器 c = 计数器();
    打印行(c.步进());          // 32767
    静态 整16 s2 = 32766;
    打印行(整32(s2++));        // 32766（后缀表达式值=自增前旧值）
    打印行(整32(s2));          // 32767
    整16 f = 32766;
    打印行(整32(++f));         // 32767（前缀压回新值）
    整16 g = 32766;
    打印行(整32(g++));         // 32766（后缀表达式值=自增前旧值）
    打印行(整32(g));           // 32767
    // ② 触发形态（#474 锚）：语句位·局部 32767++ 溢出 → 错误码8 终止
    //   （480 适配：迁入安全函数 溢出触发·见上注——原位置调用，顺序未变）
    返回 溢出触发();
}
