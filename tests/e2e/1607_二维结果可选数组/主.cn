// E2E 1607（#1459·2026-10-28）：**二维 结果/可选 数组**布局/寻址/释放全链——
//   1415 复审立案形态。探针实锤三缺口：
//   ① v2 步进：合成体数组文本（可选$整32[3]）被 类型名宽度 的 结果/可选
//     判定按 结果大小 劫持=24（真值=元素16×3=48）→ 下标寻址全链错位
//     （写[1][0] 污染 [0][1] 载荷·宿主 typeSizeOf 数组分支先于实例判定=分叉基准）；
//     修=类型名宽度 数组折叠前置（数组语义与元素类型正交·生成声明 416 先例）。
//   ② 双侧释放：二维 结果/可选<字符串> 数组资源载荷块出口释放漏（登记/发射
//     面的 数组元素文本=带维度尾缀中间文本使 资源判定 miss+展开长度=第一维
//     只覆盖每行首元素）——双侧同病双侧修（v2=数组基元素文本+数组总元素数
//     多维展开；宿主=arrayBaseElemOf/arrayTotalElemCount 同构）。
//   ③ 一维回归锚：1466/1478 既有面（残留=0）不回退。
//   注：二维嵌套初始化列表 { {...} } 双侧解析均不支持=语法面缺口另案呈报，
//   不入本锚（禁为改而改）。
导入 核心::内存;

函数 读值(可选<整32> 元) -> 整32 {
    如果 (元.有值) { 返回 元.值; }
    返回 0 - 1;
}

函数 读果(结果<整32, 整32> 元) -> 整32 {
    如果 (元.正常) { 返回 元.值; } 否则 { 返回 0 - 1; }
}

函数 主() -> 整32 {
    // ① 二维结果数组全矩阵写读（步进面·修前 v2 [0][1]/[0][2] 读错位）
    结果<整32, 整32>[2][3] 果网;
    果网[0][0] = 正常(10);
    果网[0][1] = 正常(11);
    果网[0][2] = 正常(12);
    果网[1][0] = 正常(20);
    果网[1][1] = 正常(21);
    果网[1][2] = 正常(22);
    打印(读果(果网[0][0]));
    打印(读果(果网[0][1]));
    打印(读果(果网[0][2]));
    打印(读果(果网[1][0]));
    打印(读果(果网[1][1]));
    打印(读果(果网[1][2]));
    // 未写元素=无值锚（def-init 零初始化面·编译期越界拦外的合法读位）
    结果<整32, 整32>[2][3] 果空网;
    打印(读果(果空网[1][2]));
    // ② 二维可选数组全矩阵写读
    可选<整32>[2][3] 选网;
    选网[0][0] = 某些(10);
    选网[0][1] = 某些(11);
    选网[0][2] = 某些(12);
    选网[1][0] = 某些(20);
    选网[1][1] = 某些(21);
    选网[1][2] = 某些(22);
    打印(读值(选网[0][0]));
    打印(读值(选网[0][1]));
    打印(读值(选网[0][2]));
    打印(读值(选网[1][0]));
    打印(读值(选网[1][1]));
    打印(读值(选网[1][2]));
    可选<整32>[2][3] 选空网;
    打印(读值(选空网[1][2]));
    // ③ 二维 结果<字符串> 释放面（块出口资源载荷回收·残留须=0）
    整64 前 = 内存::活动分配数();
    {
        结果<字符串, 整32>[2][3] 串网;
        串网[0][2] = 正常(字符串复制("载荷甲"));
        串网[1][0] = 正常(字符串复制("载荷乙"));
        如果 (串网[0][2].正常) { 打印(串网[0][2].值); } 否则 { 打印("错a"); }
        如果 (串网[1][0].正常) { 打印(串网[1][0].值); } 否则 { 打印("错b"); }
    }
    整64 中 = 内存::活动分配数();
    打印("二维结果残留=" + 整数转字符串(中 - 前));
    // ④ 二维 可选<字符串> 释放面
    {
        可选<字符串>[2][3] 选串网;
        选串网[0][2] = 某些(字符串复制("载荷丙"));
        选串网[1][0] = 某些(字符串复制("载荷丁"));
        如果 (选串网[0][2].有值) { 打印(选串网[0][2].值); } 否则 { 打印("错c"); }
        如果 (选串网[1][0].有值) { 打印(选串网[1][0].值); } 否则 { 打印("错d"); }
    }
    整64 后 = 内存::活动分配数();
    打印("二维可选残留=" + 整数转字符串(后 - 中));
    // ⑤ 一维回归锚（1466/1478 既有面·残留=0 不回退）
    {
        结果<字符串, 整32>[2] 一维;
        一维[0] = 正常(字符串复制("一维甲"));
        如果 (一维[0].正常) { 打印(一维[0].值); } 否则 { 打印("错e"); }
    }
    整64 尾 = 内存::活动分配数();
    打印("一维残留=" + 整数转字符串(尾 - 后));
    返回 0;
}
