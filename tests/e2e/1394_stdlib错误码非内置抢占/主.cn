// 1394：stdlib 模块函数不被同名内置抢占——结果错误码双侧对照（#1099·1098 采样轮 D1 盲区转正）
// 修前（930 批模块公开函数优先之前）：选择性导入（导入 模块::函数）触发语法层 B1
//   裸名改写成限定名「文件::打开文件」→ 生成打印与内置调用 直查内置表命中
//   __cn_file_open → 按内置发射 + 本地近似结果构造 → 结果错误码静默 0
//   （宿主走 stdlib 包装函数=真实错误码 5/6）。整模块导入（导入 文件;）不中。
// 修后（930 模块公开函数优先）：模块源码进编译集（签名存在）且非自模块时让位
//   模块函数决议——双侧（宿主/v2）同走 stdlib 包装=错误码真实值，零分叉。
// 断言面=可确定错误通道（不存在路径/空句柄/空 stdin EOF/非法时间戳），
//   不含时间值等不可确定输出；宿主侧与 v2 侧输出逐行比对 .expected。
导入 文件::打开文件;
导入 文件::文件大小;
导入 IO::{读取行, 读取整数, 读取浮点};
导入 时间::格式化时间;

函数 主() -> 整32 {
    结果<空类型*, 整32> 打开 = 打开文件("1394_肯定不存在的文件.txt", 1);
    如果 (打开.正常) {
        打印("打开文件意外成功");
        返回 1;
    } 否则 {
        打印("文件错误码 ", 打开.错误);
    }
    结果<整64, 整32> 大小 = 文件大小(无);
    如果 (大小.正常) {
        打印("文件大小意外成功");
        返回 1;
    } 否则 {
        打印("文件大小错误码 ", 大小.错误);
    }
    结果<字符串, 整32> 行 = 读取行();
    如果 (行.正常) {
        打印("读取行意外成功");
        返回 1;
    } 否则 {
        打印("读取行错误码 ", 行.错误);
    }
    结果<整64, 整32> 读整 = 读取整数();
    如果 (读整.正常) {
        打印("读取整数意外成功");
        返回 1;
    } 否则 {
        打印("读取整数错误码 ", 读整.错误);
    }
    结果<浮64, 整32> 读浮 = 读取浮点();
    如果 (读浮.正常) {
        打印("读取浮点意外成功");
        返回 1;
    } 否则 {
        打印("读取浮点错误码 ", 读浮.错误);
    }
    结果<字符串, 整32> 格式化 = 格式化时间(0 - 1, "%Y");
    如果 (格式化.正常) {
        打印("格式化时间意外成功");
        返回 1;
    } 否则 {
        打印("格式化时间错误码 ", 格式化.错误);
    }
    返回 0;
}
