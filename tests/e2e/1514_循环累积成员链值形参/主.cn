// 1514 循环累积成员链值形参（750 复审6 P1-A·双编译性能向）
//   病：P1-2 的成员链保守哨兵无差别置位（成员/下标/解引用实参）——但值形参
//   `外.内.取(槽.名)`/`外.内.取(s)` 不取地址，宿主优化=1 而 v2 优化=0（过度抑制）。
//   修：成员链接收者先按接收者类型+方法签名取引用位，只对引用位实参置哨兵；
//   仅签名解析失败整函数保守。
//   负载：循环外成员链值形参调用（成员/标识符实参各一）+ 循环累积 s。
//   预期：长=2048 / 值形参优化=1（双侧一致）。
结构体 盒 {
    字符串 名;
}

类 内层 {
公开:
    函数 内层() { }
    函数 取(字符串 参) -> 整64 { 返回 字符串长度(参); }
}

类 外层 {
公开:
    内层 内;
    函数 外层() { }
}

不安全 函数 主() -> 整32 {
    字符串 s = "";
    盒 槽 = 盒{ 名 = "abc" };
    外层 外 = 外层();
    外.内.取(槽.名);
    外.内.取(s);
    整64 前 = 内存::总分配次数();
    循环 (整64 k = 0; k < 2048; k++) {
        s = s + "x";
    }
    整64 次 = 内存::总分配次数() - 前;
    打印("长=", 整数转字符串(字符串长度(s)));
    布尔 降 = 次 <= 6;
    如果 (降) { 打印("值形参优化=1"); } 否则 如果 (次 > 6) {
        打印("值形参优化=0 次=", 整数转字符串(次));
    }
    返回 0;
}
