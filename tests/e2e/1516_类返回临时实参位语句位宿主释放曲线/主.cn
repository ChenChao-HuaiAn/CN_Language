// 〔1479/965 宿主锁用例〕类返回对象临时释放曲线（宿主侧·活动分配数逐点断言）：
// 拥有性甄别机制释放面——拥有（方法返回局部/自由函数返回局部/构造/容器元素堆
// 副本）实参位/语句位临时=语句尾整壳析构（DeleteObject 级联）；借用（返回形参/
// 全局·引用返回）不释放。修复前实证：实参位 消费(仓1.造货架()) 每调用泄 1
// （活动分配数 1..8 线性）；语句位 每语句泄 1；借用形态若误释放=删调用方对象。
// 〔本用例为宿主专属释放曲线锁（无 双编译对照.txt）——v2 借用面实参位泄 1=
// 1538 立案在途，对齐后可升级 dual〕
导入 容器::向量;

类 货品 {
公开:
    向量<字符串> 记录;
    函数 货品() { 记录 = 向量<字符串>(); }
    函数 ~货品() { }
    不安全 函数 货品(货品& 其他) { 记录 = 其他.记录; }
}

// 借用形态（自由函数面）：返回形参=写穿别名——实参位临时禁释放
函数 还货(货品 源) -> 货品 {
    返回 源;
}

// 拥有形态（自由函数面）：返回局部=句柄移交——实参位/语句位临时须释放
函数 造2() -> 货品 {
    货品 q;
    结果<空类型, 整32> 加 = q.记录.追加("乙串");
    如果 (!加.正常) { 返回 q; } 否则 { }
    返回 q;
}

类 主仓 {
公开:
    // 拥有形态（方法面）：返回局部
    函数 造货() -> 货品 {
        货品 p;
        结果<空类型, 整32> 加 = p.记录.追加("货品");
        如果 (!加.正常) { 返回 p; } 否则 { }
        返回 p;
    }
    // 借用形态（方法面）：返回形参
    函数 直通(货品 源) -> 货品 {
        返回 源;
    }
}

函数 消费(货品 按值) -> 整32 {
    返回 整32(按值.记录.大小());
}

函数 主() -> 整32 {
    // #1568：win 启动期 __cn_cache_argv 合法分配 2（argv 数组+UTF-8 串，Linux=0）——
    //   全部活动数断言取基线相对增量（原绝对 0/1 仅 Linux 成立=平台脆弱断言）。
    整64 活动基 = 内存::活动分配数();
    主仓 仓1;
    整32 和 = 0;
    // ①方法面拥有（965 主形态）：4 轮每调分配后即释放 → 活动恒 0
    循环 (整32 i = 0; i < 4; i += 1) {
        和 += 消费(仓1.造货());
    }
    打印(内存::活动分配数() - 活动基);          // 0
    // ②自由函数借用（返回形参）：临时=调用方对象句柄不释放 → 对象完好
    货品 甲;
    结果<空类型, 整32> 加2 = 甲.记录.追加("甲串");
    如果 (!加2.正常) { 返回 1; } 否则 { }
    和 += 消费(还货(甲));
    打印(甲.记录.大小());              // 1（未被误释）
    // ③方法面借用：同②
    和 += 消费(仓1.直通(甲));
    打印(甲.记录.大小());              // 1
    // ④自由函数面拥有：实参临时释放 → 活动回到 甲 一份
    和 += 消费(造2());
    打印(内存::活动分配数() - 活动基);          // 1（甲）
    // ⑤语句位丢弃：拥有临时立即析构 → 活动不变
    仓1.造货();
    造2();
    打印(内存::活动分配数() - 活动基);          // 1（仍 甲）
    // ⑥声明位接收（880 判据不回归）：接收槽登记·出口回收
    // （退出码校验和在 丙 声明前——此刻活动=甲 一份；任一释放行为漂移即非 0）
    整32 码 = 0;
    整64 当前活动 = 内存::活动分配数() - 活动基;
    如果 (当前活动 != 1) { 码 += 100; } 否则 { }
    如果 (甲.记录.大小() != 1) { 码 += 10; } 否则 { }
    如果 (和 != 7) { 码 += 1; } 否则 { }
    货品 丙 = 仓1.造货();
    打印(丙.记录.大小());              // 1
    打印(和);                          // 4+1+1+1=7
    返回 码;
}
