// E2E 248（2026-09-12 第八十八轮 88-a，plans/020 移植纪律 9 门禁化·第十七个对照用例）：
//   **短路求值全链路（栈净契约/实参位/惰性求值/区间标注）**——同一份源码经宿主真实
//   管线与 v2 自举链各编译运行，两侧退出码须相等。
//   背景（88-a 探针实证）：v2 侧两处缺陷叠加——
//     ① 语法层 解析二元链 短路节点左起点=池.大小()（左操作数**之后**）→ `a || b`
//        /`a && b` 的左操作数区间 [子起点, 附加) 恒为空：左操作数被主循环平铺求值
//        （多压一项）且短路求值内左递归空区间退化为「取栈顶」侥幸值（赋值位/条件位
//        看似正确=巧合）；
//     ② IR 层 短路求值只压不弹（左 +1/右 +1/结果 +1 = 净 +3）破坏「表达式求值净栈
//        +1」契约 → 弹栈消费（生成调用 弹 实参数+被调 / 打印族同路径）取到残留 →
//        被调错位 `[ir2] 调用被调对象非函数名/方法` + 运行时错误6。
//   宿主同形态恒正确（基准对照）。
//   八形态（两侧共有语义面）：
//     ① 实参位短路（||）：取值(甲, 2, 判(甲) || 标)
//     ② 打印族实参位短路（打印内置弹实参同路径）+ 条件位短路
//     ③ && 实参位（层2 左起点）+ 双实参短路 + 结构体实参复合弹栈
//     ④ 嵌套短路 || × &&（优先级 + 区间标注）
//     ⑤ 惰性求值（右操作数不得执行：副作用计数恒 0）
//     ⑥ 左操作数只求值一次（副作用计数恒 1）
//     ⑦ 短路 × 三元交叉（实参位）
//     ⑧ 循环 2000 轮短路实参位 + 校验和（栈失衡在循环中即时暴露）
//   校验和折位：①1 ②2 ③4 ④8 ⑤16 ⑥32 ⑦64 ⑧128 —— 255=全对。
//   平台守卫=linux 双平台（宿主与 v2 同链；win-x64 v2 产物未隔离=家机轮）。
静态 整64 副作用计 = 0;

结构体 盒 {
    整64 值;
}

函数 判(整64 x) -> 布尔 {
    返回 x > 3;
}

函数 取值(整64 a, 整64 b, 布尔 c) -> 整64 {
    如果 (c) { 返回 a + b; }
    返回 a - b;
}

函数 取值2(布尔 a, 布尔 b) -> 整64 {
    如果 (a && b) { 返回 10; }
    返回 20;
}

函数 取值盒(盒 h, 布尔 c) -> 整64 {
    如果 (c) { 返回 h.值 + 1; }
    返回 h.值 - 1;
}

不安全 函数 副作用真() -> 布尔 {
    副作用计 = 副作用计 + 1;
    返回 真;
}

// ① 实参位短路（||）
函数 形一() -> 整64 {
    布尔 标 = 真;
    整64 甲 = 1;
    整64 果 = 取值(甲, 2, 判(甲) || 标);
    如果 (果 == 3) { 返回 1; }
    返回 0;
}

// ② 打印族实参位短路（内置弹实参同路径）+ 条件位短路
函数 形二() -> 整64 {
    布尔 标 = 真;
    整64 甲 = 1;
    打印("E248形二=", 判(甲) || 标);
    如果 (判(甲) || 标) { 返回 2; }
    返回 0;
}

// ③ && 实参位 + 双实参短路 + 结构体实参复合弹栈
函数 形三() -> 整64 {
    布尔 标 = 真;
    整64 甲 = 4;
    整64 果 = 取值(甲, 2, 判(甲) && 标);
    整64 果2 = 取值2(判(甲) || 标, 标 || 判(甲));
    盒 盒值 = 盒{ 值 = 30 };
    整64 果3 = 取值盒(盒值, 判(甲) || 标);
    如果 (果 == 6 && 果2 == 10 && 果3 == 31) { 返回 4; }
    返回 0;
}

// ④ 嵌套短路 || × &&（优先级 + 区间标注）
函数 形四() -> 整64 {
    布尔 标 = 真;
    整64 甲 = 1;
    布尔 果 = 判(甲) || 标 && 假;
    布尔 果2 = 假 || 标 && 真;
    如果 (!果 && 果2) { 返回 8; }
    返回 0;
}

// ⑤ 惰性求值（右操作数不得执行）
不安全 函数 形五() -> 整64 {
    副作用计 = 0;
    布尔 果 = 真 || 副作用真();
    布尔 果2 = 假 && 副作用真();
    如果 (副作用计 == 0 && 果 && !果2) { 返回 16; }
    返回 0;
}

// ⑥ 左操作数只求值一次
不安全 函数 形六() -> 整64 {
    副作用计 = 0;
    布尔 果 = 副作用真() && 假;
    如果 (副作用计 == 1 && !果) { 返回 32; }
    返回 0;
}

// ⑦ 短路 × 三元交叉（实参位）
函数 形七() -> 整64 {
    布尔 标 = 真;
    整64 甲 = 1;
    整64 果 = 取值(甲, 甲 + 2, (判(甲) || 标) ? 真 : 假);
    如果 (果 == 4) { 返回 64; }
    返回 0;
}

// ⑧ 循环 2000 轮短路实参位 + 校验和
//    i <= 3（4 轮）：判(i)=假 → 假||假=假 → 1-2=-1；i >= 4（1996 轮）：判(i)=真 → 1+2=3
//    和 = 1996*3 - 4 = 5984
函数 形八(整64 轮数) -> 整64 {
    整64 和 = 0;
    整64 i = 0;
    当 (i < 轮数) {
        和 = 和 + 取值(1, 2, 判(i) || 假);
        i = i + 1;
    }
    如果 (和 == 5984) { 返回 128; }
    返回 0;
}

函数 主() -> 整32 {
    整64 和 = 0;
    和 = 和 + 形一();
    和 = 和 + 形二();
    和 = 和 + 形三();
    和 = 和 + 形四();
    和 = 和 + 形五();
    和 = 和 + 形六();
    和 = 和 + 形七();
    和 = 和 + 形八(2000);
    打印("校验和(期望255)=", 和);
    返回 整32(和 % 256);
}
