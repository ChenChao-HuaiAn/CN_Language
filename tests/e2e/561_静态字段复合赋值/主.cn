// E2E 561_静态字段复合赋值（任务 084 转正·宿主单侧）
// 覆盖：静态字段 += （静态方法内裸名/类外 类名.字段）——先读旧值再算再写回。
// ⚠ v2 侧静态成员=002 攻族 G-B「类成员修饰」特性缺口（v2 诚实拒绝「不支持该
//   类成员修饰」）——随 G-B 攻族清偿后本用例转 dual（登记=021 084 销项行）。
// 语法依据：06 第十节 静态成员（静态 整32 字段 = 初值 / 静态 函数 / 类名.字段）
类 台 {
公开:
    静态 整32 总数 = 0
    静态 函数 自增五() -> 空类型 {
        总数 += 5;      // 静态方法内静态字段复合赋值（原丢读取侧）
    }
    静态 函数 报数() -> 整32 {
        返回 总数;
    }
}

函数 主() -> 整32 {
    打印("===== 静态字段复合赋值（任务 084）=====");
    台.自增五();
    打印("静态加五: ", 台.报数());
    台.总数 += 3;                    // 类外静态字段复合赋值（原丢读取侧）
    打印("静态再加三: ", 台.报数());
    台.总数 -= 2;
    打印("静态减二: ", 台.报数());
    打印("===== 完成 =====");
    返回 0;
}
