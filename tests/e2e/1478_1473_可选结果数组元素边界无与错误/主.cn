// 1478（#1415 复审 P0 + P2-1）：可选/结果 **数组元素边界**——双侧同源锁
// ① 无元素（空可选值）：`可选<整32>[2] = { 无, 某些(5) }` / `可选<字符串>[2] =
//    { 无, 某些(字符串复制(..)) }`——无元素须零填充元素槽（tag=0/载荷=0）；
//    修复前宿主与 v2 都把 `无` 的求值产物（标量常量 0）当物化槽地址整块拷贝
//    → 从地址 0 读：C0000005 fault=0（双侧同病·审查 P0）。
// ② 结果数组错误元素（结构体载荷 + E=整32/整64 两个数组）：值位在错误态=错误码
//    整数，载荷串字段释放须带 tag 守卫（宿主原 collectOwnedStrFields 结构体载荷
//    cond=-1 无条件 → free(错误码)/读垃圾；v2 tag 分支内释放=零分叉·审查 P2-1）。
// 断言=元素取值/有值位/错误码 + 块前块后 内存::活动分配数 残留=0（释放正确性）。
结构体 边界盒 {
    字符串 名;
    整64 号;
}

函数 测无整() -> 整64 {
    整64 前 = 内存::活动分配数();
    {
        可选<整32>[2] 组 = { 无, 某些(5) };
        整64 甲 = 组[0].有值 ? 1 : 0;
        整64 乙 = 组[1].有值 ? 1 : 0;
        打印("整甲=" + 整数转字符串(甲));
        打印("整乙=" + 整数转字符串(乙));
        如果 (组[1].有值) { 打印("整值=" + 整数转字符串(组[1].值)); }
    }
    如果 (内存::活动分配数() != 前) { 打印("整残留非零"); 返回 0; }
    返回 1;
}

函数 测无串() -> 整64 {
    整64 前 = 内存::活动分配数();
    {
        可选<字符串>[2] 组 = { 无, 某些(字符串复制("无边界串载荷")) };
        整64 甲 = 组[0].有值 ? 1 : 0;
        整64 乙 = 组[1].有值 ? 1 : 0;
        打印("串甲=" + 整数转字符串(甲));
        打印("串乙=" + 整数转字符串(乙));
        如果 (组[1].有值) {
            如果 (!字符串比较(组[1].值, "无边界串载荷")) { 打印("串值错"); }
        }
    }
    如果 (内存::活动分配数() != 前) { 打印("串残留非零"); 返回 0; }
    返回 1;
}

函数 测错误载荷() -> 整64 {
    整64 前 = 内存::活动分配数();
    {
        结果<边界盒, 整32> 误甲 = 错误(7);
        结果<边界盒, 整64> 误乙 = 错误(9);
        结果<边界盒, 整32>[2] 组甲 = { 正常(边界盒{ 名 = 字符串复制("正常甲载荷"), 号 = 1 }), 误甲 };
        结果<边界盒, 整64>[2] 组乙 = { 正常(边界盒{ 名 = 字符串复制("正常乙载荷"), 号 = 2 }), 误乙 };
        如果 (组甲[0].正常) {
            如果 (!字符串比较(组甲[0].值.名, "正常甲载荷")) { 打印("组甲值错"); }
        } 否则 { 打印("组甲0异常"); }
        如果 (组甲[1].正常) { 打印("x"); } 否则 {
            打印("错甲=" + 整数转字符串(组甲[1].错误));
        }
        如果 (组乙[0].正常) {
            如果 (!字符串比较(组乙[0].值.名, "正常乙载荷")) { 打印("组乙值错"); }
        } 否则 { 打印("组乙0异常"); }
        如果 (组乙[1].正常) { 打印("y"); } 否则 {
            打印("错乙=" + 整数转字符串(组乙[1].错误));
        }
    }
    如果 (内存::活动分配数() != 前) { 打印("错残留非零"); 返回 0; }
    返回 1;
}

不安全 函数 主() -> 整32 {
    整64 甲 = 测无整();
    整64 乙 = 测无串();
    整64 丙 = 测错误载荷();
    如果 (甲 == 1 && 乙 == 1 && 丙 == 1) { 返回 0; }
    返回 1;
}
