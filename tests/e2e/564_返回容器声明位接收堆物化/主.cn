导入 映射集合;
导入 IO::打印;
导入 核心::内存;
// E2E 552（2026-09-30 第 914 轮·任务 091 根治·返回容器声明位接收堆物化）：
//   三判据：①值对（深搅动后 11=独立副本）；②泄漏归零（块尾活动分配数
//   回落=拥有副本被释放）；③退出码 0（析构合法——原豁免=泄漏/原直登记
//   =free sret 栈地址崩，双度实证）。宿主对照同源（RAII 全链基准）。
函数 造表() -> 映射<整32, 整32> {
    映射<整32, 整32> t;
    结果<空类型, 整32> 设 = t.设置(1, 11);
    如果 (设.正常) { } 否则 { }
    返回 t;
}
函数 搅动() -> 空类型 {
    整32 i = 0;
    当 (i < 64) {
        字符串 垃圾 = 字符串复制("搅动内存复用压力载荷数据0123456789ABCDEF");
        i = i + 1;
    }
}
函数 主() -> 整32 {
    整64 基线 = 内存::活动分配数();
    {
        映射<整32, 整32> 表 = 造表();
        搅动();
        结果<整32, 整32> 取 = 表.获取(1);
        如果 (取.正常) { 打印(取.值); } 否则 { 打印(0 - 1); }
    }
    整64 余留 = 内存::活动分配数() - 基线;
    打印(余留);
    返回 0;
}
