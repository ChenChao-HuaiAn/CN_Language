// E2E 1082（2026-10-17 任务 1032·#1032 静态泛型实例字段访问断链根治锁面）：
//   「静态 盒子<整32> 全局盒」后 全局盒.值 读写——v2 原三链全断编译期中止
//   （[ir2] 成员字段偏移未知: .值 / 成员左值字段偏移未知: 值 / 成员宽度码·
//   对象类型未登记），宿主正常。根因=v2 解析对象结构体ID 缺顶层静态表级：
//   泛型实例类型文本「盒子$整32」的实例身份在 IR 收集阶段才登记，语法层
//   解析静态声明 登记 变量结构体表 时 查结构体类型(盒子$整32) 恒 miss →
//   「全局盒」全表无登记 → 字段三元组/左值偏移/宽度码三链全断（普通静态
//   结构体/类不受影响=类名/结构体名在语法层已在表）。修复=补静态表级回退
//   （与 87-a 解析标识符类型ID 同构）。
//   形态面（四形态逐一对齐宿主）：
//     ① 双字段偏移（整32 标记@0 + T 值@4）：写 7/41 读回双对——偏移解析
//       真对（若偏移错读错值/写穿邻字段）
//     ② 异构实例化（盒子<整32> 与 匣子<整64> 并存）：各实例布局独立
//     ③ 静态泛型实例对象方法调用（全局匣.设/读——接收者=静态槽装载句柄）
//     ④ 成员链中段（全局链盒.内.v 结构体字段 + 全局链盒.值）——链中段
//       结构体键递归推导
//   校验和折位：①1+2 ②4 ③8 ④16+32 —— 63=全对；任一形态分叉=校验位丢失。
//   不借链（无容器字段符号依赖）。
泛型 <类型 T>
类 盒子 {
公开:
    整32 标记;
    T 值;
}

泛型 <类型 T>
类 匣子 {
公开:
    T 值;
    函数 设(T v) -> 空类型 { 值 = v; }
    函数 读() -> T { 返回 值; }
}

结构体 内层 {
    整32 v;
}

泛型 <类型 T>
类 链盒 {
公开:
    T 值;
    内层 内;
}

静态 盒子<整32> 全局盒;
静态 匣子<整64> 全局匣;
静态 链盒<整32> 全局链盒;

不安全 函数 主() -> 整32 {
    整32 校验 = 0;
    // ① 双字段偏移（整32 标记@0 + T 值@4）
    全局盒.标记 = 7;
    全局盒.值 = 41;
    如果 (全局盒.标记 == 7) { 校验 = 校验 + 1; }
    如果 (全局盒.值 == 41) { 校验 = 校验 + 2; }
    // ② 异构实例化（匣子<整64> 独立布局）
    全局匣.值 = 整64(500);
    如果 (全局匣.值 == 整64(500)) { 校验 = 校验 + 4; }
    // ③ 静态泛型实例对象方法调用
    全局匣.设(整64(800));
    如果 (全局匣.读() == 整64(800)) { 校验 = 校验 + 8; }
    // ④ 成员链中段（结构体字段 内.v + T 值）
    全局链盒.内.v = 9;
    全局链盒.值 = 3;
    如果 (全局链盒.内.v == 9) { 校验 = 校验 + 16; }
    如果 (全局链盒.值 == 3) { 校验 = 校验 + 32; }
    打印("校验和=", 校验);
    返回 校验;
}
