// E2E 950（2026-10-14·任务 #728v 锁面·dual 正测·583 扫描②修复）：类静态字段
//   19 位 MIN 初值双侧保真——修前实锚：v2p 解析 -9223372036854775808 的数值
//   部分（19 位文本 2^63）末步进位超 INT64_MAX → 安全区溢出检查触发错误码 8
//   （v2p 自举编译器**自身中止**·`累 = 累 * 进制 + 数v` 裸乘加无溢出预判）；
//   宿主同形态 foldClassStaticInit 值级折叠 parseIntValue stoll 超承载回 0 →
//   静默错值 0（同源失真的两条通道）。
//   修后：v2 累加改 474 高/低 32 位分治（位模式累加474/合成474·无溢出面）+负号
//   位模式取负474（-2^63 补码不动点）；宿主十进制形态文本保真折叠
//   （foldDecimalLiteralText·发射层 `dq 文本` mod 2^64 解析——与顶层静态 raw
//   直存通道同构）。双侧同值，双编译对照逐行全等 + 退出码一致。
//   锁面形态：①类字段 MIN（修复主面）②类字段 MAX（19 位正域内上界）③类字段
//   负小数与 0x 十六进制（值级通道零回归·726 既有锁面）④顶层静态 MIN（raw
//   直存既有正确通道对照）⑤函数内静态 MIN（宿主单侧修复面·v2 修前即正确）。
类 极值匣 {
公开:
    静态 整64 最小值 = -9223372036854775808;
    静态 整64 最大值 = 9223372036854775807;
    静态 整64 负小数 = -5;
    静态 整64 大值 = 0x10;
}
静态 整64 顶层最小值 = -9223372036854775808;
函数 主() -> 整32 {
    静态 整64 函数最小值 = -9223372036854775808;
    打印(极值匣.最小值);            // -9223372036854775808（本任务主修复面）
    打印(极值匣.最大值);            // 9223372036854775807（19 位正·域内上界）
    打印(极值匣.负小数);            // -5（一元负号既有形态）
    打印(极值匣.大值);              // 16（十六进制值级规范化通道）
    打印(顶层最小值);               // -9223372036854775808（顶层 raw 直存对照）
    打印(函数最小值);               // -9223372036854775808（函数内静态通道）
    返回 0;
}
