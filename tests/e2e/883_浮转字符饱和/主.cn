// 883（任务 533·475 批甲 2026-10-14 用户裁决）：浮→字符显式转换标量域饱和 dual 门禁
//   plans/001 §3.7c：超域按 Unicode 标量有效域 [0, 0x10FFFF] 钳制、NaN→0、
//   非正值（含 -inf）→0、上超域（含 +inf）→0x10FFFF、域内向零截断；
//   代理区 [0xD800,0xDFFF] 域内透传（实施轮细化决策·001 §3.7c 留痕）。
//   528 浮→整族同构落点（runtime __cn_fXX_to_char 单点：宿主 IR 直发调用通道 +
//   v2 字符目标码发射特判）；宿主+v2 双编译对照同测本 .expected（840 同款配置）。
//   覆盖：①编译期常量形态（字面量直转）②运行期变量形态（浮64 源）③浮32 源
//   ④边界三值（0x10FFFF 上界 / 0x110000 超界 / -0.5 负半域）⑤代理区透传
//   ⑥下游消费（函数返回 字符 / 数组元素赋值）。
函数 取码(浮64 值) -> 字符
{
    返回 字符(值);
}

函数 主() -> 整32
{
    // ===== ① 编译期常量形态（字面量直转） =====
    字符 折超 = 字符(1.0e18);
    打印行("折 字符(1e18)=", 整32(折超));
    打印("");
    字符 折负 = 字符(-5.0);
    打印行("折 字符(-5.0)=", 整32(折负));
    打印("");
    字符 折NaN = 字符(0.0 / 0.0);
    打印行("折 字符(NaN)=", 整32(折NaN));
    打印("");
    字符 折截 = 字符(65.9);
    打印行("折 字符(65.9)=", 整32(折截));
    打印("");

    // ===== ② 运行期变量形态（浮64 源） =====
    浮64 f超上 = 1.0e18;
    浮64 f负18 = -1.0e18;
    浮64 f零 = 0.0;
    浮64 fNaN = f零 / f零;
    浮64 f上界 = 1114111.0;
    浮64 f超界 = 1114112.0;
    浮64 f中 = 65.0;
    浮64 f负半 = -0.5;
    浮64 f半 = 0.5;
    浮64 f代理 = 55296.0;
    字符 超上 = 字符(f超上);
    打印行("字符(1e18)=", 整32(超上));
    打印("");
    字符 负18 = 字符(f负18);
    打印行("字符(-1e18)=", 整32(负18));
    打印("");
    字符 NaNv = 字符(fNaN);
    打印行("字符(NaN)=", 整32(NaNv));
    打印("");
    字符 上界 = 字符(f上界);
    打印行("字符(1114111.0)=", 整32(上界));
    打印("");
    字符 超界 = 字符(f超界);
    打印行("字符(1114112.0)=", 整32(超界));
    打印("");
    字符 中 = 字符(f中);
    打印行("字符(65.0)=", 整32(中));
    打印("");
    字符 负半 = 字符(f负半);
    打印行("字符(-0.5)=", 整32(负半));
    打印("");
    字符 半 = 字符(f半);
    打印行("字符(0.5)=", 整32(半));
    打印("");
    字符 代理 = 字符(f代理);
    打印行("字符(55296.0)=", 整32(代理));
    打印("");

    // ===== ③ 浮32 源面 =====
    浮32 单超 = 浮32(1.0e18);
    浮32 单负 = 浮32(-1.0e18);
    浮32 单零 = 浮32(0.0);
    浮32 单NaN = 单零 / 单零;
    浮32 单超界 = 浮32(1114112.0);
    浮32 单中 = 浮32(3.75);
    字符 超32 = 字符(单超);
    打印行("字符(1e18f)=", 整32(超32));
    打印("");
    字符 负32 = 字符(单负);
    打印行("字符(-1e18f)=", 整32(负32));
    打印("");
    字符 NaN32 = 字符(单NaN);
    打印行("字符(NaNf)=", 整32(NaN32));
    打印("");
    字符 超界32 = 字符(单超界);
    打印行("字符(1114112.0f)=", 整32(超界32));
    打印("");
    字符 中32 = 字符(单中);
    打印行("字符(3.75f)=", 整32(中32));
    打印("");

    // ===== ④ 下游消费（函数返回 字符 / 数组元素赋值） =====
    字符 取1 = 取码(1.0e18);
    打印行("取码(1e18)=", 整32(取1));
    打印("");
    字符 取2 = 取码(65.0);
    打印行("取码(65.0)=", 整32(取2));
    打印("");
    字符[2] 序列;
    序列[0] = 字符(1.5);
    序列[1] = 字符(1.0e18);
    打印行("数组[0]=", 整32(序列[0]));
    打印("");
    打印行("数组[1]=", 整32(序列[1]));
    打印("");
    返回 0;
}
