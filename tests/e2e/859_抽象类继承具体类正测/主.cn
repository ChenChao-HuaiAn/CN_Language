// E2E 859 正测（任务193 防误杀面·与 80_抽象类 分工：80=宿主合法路径正测·
//   859=双编译对照零分叉门禁·v2 抽象面首次入测）。
// 覆盖：抽象基类（抽象 函数 无实现体）-> 具体派生类实现全部抽象成员 ->
//   实例化派生类放行（多态分派）——858 拒绝面不得误杀具体类实例化。
// 语法依据（cn-language-spec 06 §八）：抽象 函数 名(参数) -> 类型 无实现体；
//   派生类 重写 函数 实现；实现全部抽象成员的派生类=具体类可实例化。
类 形状 {
公开:
    抽象 函数 面积() -> 整64
}

类 圆形 : 形状 {
公开:
    整64 半径;

    函数 圆形(整64 r) {
        半径 = r;
    }

    重写 函数 面积() -> 整64 {
        返回 半径 * 半径 * 3;
    }
}

类 矩形 : 形状 {
公开:
    整64 宽;
    整64 高;

    函数 矩形(整64 w, 整64 h) {
        宽 = w;
        高 = h;
    }

    重写 函数 面积() -> 整64 {
        返回 宽 * 高;
    }
}

函数 主() -> 整32 {
    打印("===== 抽象类继承具体类正测（任务193）=====");

    圆形 圆 = 圆形(5);
    打印("圆面积: ", 圆.面积());          // 5*5*3 = 75

    矩形 方 = 矩形(4, 6);
    打印("矩形面积: ", 方.面积());        // 4*6 = 24

    圆形 圆2 = 圆形(10);
    打印("圆2面积: ", 圆2.面积());        // 10*10*3 = 300（多态分派再验证）

    打印("===== 完成 =====");
    返回 0;
}
