// E2E 212（2026-09-11 第七十二轮 plans/019 4'-三 立案根治六枚，方案A）：
//   F1 跨模块拥有契约：函数链接键（模块$名）含 '$' 被误判为泛型单态化产物——
//      凡导入模块（stdlib/用户模块）的函数返回 字符串，调用方一律不登记 RAII
//      =静默永久泄漏。根治=按泛型实例表精确判定（rustc DefId 同款）。
//   F4 赋值位转移真 move：目标 = 转移(源) 原为共享句柄 + 源出口释放=悬垂 UAF
//      （stdlib 字符串扩展::替换 实测乱码）。根治=drop 旧目标+句柄直存+源槽清零。
//   F5 引用参数（T& 出参）拥有串移交：写调用方槽后本函数出口释放源局部=调用方
//      悬垂（v2 树 解析货舱/拆限定名 踩中，E2E 165 回归实证）。根治=Rust
//      `*out = s` move 语义（句柄直写调用方槽+源槽清零）。
//   F6 变参调用 AL 契约：SysV AMD64 要求变参调用点设 AL=向量寄存器个数——CN
//      代码生成从未设置，靠 rax 残留侥幸；前序调用/释放污染 rax 后浮点实参读 0
//      （格式化("¥%.2f", 29.50) 输出 ¥0.00）。根治=调用点按实参统计发 mov eax,N。
//   校验和折位（1/2/4/8/16/32/64/128），255=全对（stdout 校验和断言）。
导入 IO::打印;
导入 字符串扩展::替换;

// F1/F5：跨模块 + 引用参数出参（stdlib 替换 内部即用 缓冲 = 转移(拼接) 形态）
函数 跨模块替换(字符串 原) -> 字符串 {
    返回 替换(原, "旧", "新");
}

// F5：出参写入拥有串（写调用方槽后本函数不得再释放）
函数 取名字(字符串 名, 字符串& 输出) -> 空类型 {
    字符串 缓冲 = 字符串复制(名);
    输出 = 缓冲;
}

// F4：赋值位显式转移（真 move —— 目标接管所有权，源失效）
函数 转移负载() -> 字符串 {
    字符串 源 = 字符串复制("转移内容");
    字符串 目标 = 字符串复制("占位");
    目标 = 转移(源);
    返回 目标;
}

// F6：变参格式化经包装函数（rax 被前序调用污染的场景）
函数 造前缀() -> 字符串 {
    返回 字符串复制("价格 ");
}

函数 格式化价格(浮64 金额) -> 字符串 {
    字符串 前缀 = 造前缀();          // 前序调用破坏 rax
    如果 (字符串长度(前缀) == 0) { 返回 ""; }
    返回 格式化("%s¥%.2f", 前缀, 金额);   // 变参+浮点实参：AL 契约
}

函数 主() -> 整32 {
    整32 校验 = 0;
    // ① F1：跨模块返回拥有串（登记 RAII，内容正确=未悬垂）
    字符串 甲 = 跨模块替换("原旧内容");
    如果 (字符串比较(甲, "原新内容")) { 校验 = 校验 + 1; }
    // ② F5：引用参数出参接收拥有串
    字符串 乙 = "";
    取名字("出参名字", 乙);
    如果 (字符串比较(乙, "出参名字")) { 校验 = 校验 + 2; }
    // ③ F4：赋值位转移（目标为拥有值且内容未悬垂）
    字符串 丙 = 转移负载();
    如果 (字符串比较(丙, "转移内容")) { 校验 = 校验 + 4; }
    // ④ F6：变参 AL（浮点实参不因 rax 污染读 0）
    字符串 丁 = 格式化价格(29.50);
    如果 (字符串比较(丁, "价格 ¥29.50")) { 校验 = 校验 + 8; }
    // ⑤ F1 派生：跨模块串二次使用 + 拼接
    字符串 戊 = 跨模块替换(跨模块替换("旧旧旧"));
    如果 (字符串比较(戊, "新新新")) { 校验 = 校验 + 16; }
    // ⑥ F4 派生：转移后原变量槽已清零（再声明同名新变量不受影响）
    字符串 己 = 转移负载();
    如果 (字符串比较(己, "转移内容")) { 校验 = 校验 + 32; }
    // ⑦ F5 派生：同函数两个出参
    字符串 庚 = "";
    字符串 辛 = "";
    取名字("甲名", 庚);
    取名字("乙名", 辛);
    如果 (字符串比较(庚, "甲名") && 字符串比较(辛, "乙名")) { 校验 = 校验 + 64; }
    // ⑧ F6 派生：整数+浮点混合变参
    字符串 壬 = 格式化("值%d 浮点%f", 42, 3.14);
    如果 (字符串比较(壬, "值42 浮点3.140000")) { 校验 = 校验 + 128; }
    打印("校验和:", 校验);
    返回 0;
}
