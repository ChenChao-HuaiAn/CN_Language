// CN 语言标准库：字符串扩展模块（Task 6.5，对标 C++ std::string 解析能力）
// 公开: 字符串转整数/字符串转浮点/字符串转布尔/替换/填充左/填充右/分割（7 个函数）
// 实现：
//   - 数值解析（转整数/转浮点/转布尔）：调用字符串扩展内置函数（解析::转整数 等，
//     全局注册、无需导入），内置由编译器 IR 层映射到运行时 __cn_str_to_int/
//     __cn_str_to_double/__cn_str_to_bool（string_api.cpp）
//   - 替换/填充左/填充右/分割：用现有 15 个字符串内置（字符串查找/子串/连接/复制/
//     长度/字符转字符串）组合实现，不新增运行时
// 设计说明：
//   - 内置函数名带 "解析::" 前缀（如 解析::转整数；"字符串" 是类型关键字不能作
//     限定名前缀），与本模块公开函数纯名（字符串转整数）不冲突——模块函数走
//     "公开符号合并"，内置走"限定名直调"
//   - 错误处理：解析失败返回 错误(6)（无效参数）；分割数组不足返回 错误(6)
//   - 内存语义（A2 2026-09-11 收尾批）：返回 字符串=拥有——调用方 RAII 自动释放；
//     分割 结果数组元素为调用方持有（逐一 字符串释放——C 风格输出参数边界）
//   - 字符串按 UTF-8 字节处理；替换/分割按字节偏移（与 字符串查找/子串 一致）
//   - 使用方式（v2.0）：导入 字符串扩展::替换 后 替换()，或 导入 字符串扩展::{替换}
公开:
函数 字符串转整数(字符串 输入) -> 结果<整64, 整32> {
    整32 标志 = 0;
    整64 值 = 解析::转整数(输入, &标志);
    如果 (标志 == 0) {
        返回 错误(6);
    }
    返回 正常(值);
}

函数 字符串转浮点(字符串 输入) -> 结果<浮64, 整32> {
    整32 标志 = 0;
    浮64 值 = 解析::转浮点(输入, &标志);
    如果 (标志 == 0) {
        返回 错误(6);
    }
    返回 正常(值);
}

函数 字符串转布尔(字符串 输入) -> 结果<布尔, 整32> {
    整32 标志 = 0;
    整64 值 = 解析::转布尔(输入, &标志);
    如果 (标志 == 0) {
        返回 错误(6);
    }
    返回 正常(值 != 0);
}

// 替换：把 输入 中所有 目标 替换为 替换为
// 实现：循环 字符串查找 + 字符串子串/字符串连接 拼接；目标不存在返回原样副本
// 边界：目标为空串/与替换为相同 → 返回原样副本（避免死循环）；安全计数器防
//   替换为 包含 目标 时无限循环（P0 上限 100 次，E2E 场景足够）
函数 替换(字符串 输入, 字符串 目标, 字符串 替换为) -> 字符串 {
    如果 (字符串长度(目标) == 0) {
        返回 字符串复制(输入);
    }
    字符串 缓冲 = 字符串复制(输入);     // 注意："结果" 是关键字（Kw_Result）不可作变量名
    整64 位置 = 字符串查找(缓冲, 目标);
    整64 安全计数 = 0;
    整64 目标长 = 字符串长度(目标);
    // plans/019 阶段4' 方案A（2026-09-10）：拥有型字符串迁移——手动释放删除
    //   （RAII 接管）+声明外提（循环内声明=同槽迭代覆盖不 free 旧值的模型限制
    //   规避：外提后赋值位=free 旧+直存）+ 缓冲 = 转移(拼接)（零拷贝 move——
    //   标识符直接赋值在方案 A 下为深拷贝）
    字符串 前缀 = "";
    字符串 后缀 = "";
    字符串 中间 = "";
    字符串 拼接 = "";
    当 (位置 >= 0 && 安全计数 < 100) {
        前缀 = 字符串子串(缓冲, 0, 位置);
        整64 后缀起始 = 位置 + 目标长;
        后缀 = 字符串子串(缓冲, 后缀起始, 字符串长度(缓冲) - 后缀起始);
        中间 = 字符串连接(前缀, 替换为);
        拼接 = 字符串连接(中间, 后缀);
        缓冲 = 转移(拼接);
        位置 = 字符串查找(缓冲, 目标);
        安全计数++;
    }
    返回 缓冲;
}

// 填充左：不足目标长度时左侧补 填充 字符
// 实现：先算缺口，循环 字符串连接 补 填充串，再 连接(填充串, 输入)
函数 填充左(字符串 输入, 整64 目标长度, 字符 填充) -> 字符串 {
    整64 需要 = 目标长度 - 字符串长度(输入);
    如果 (需要 <= 0) {
        返回 字符串复制(输入);
    }
    字符串 填充串 = 字符转字符串(填充);
    字符串 缓冲 = 字符串复制(填充串);
    整64 已加 = 1;
    当 (已加 < 需要) {
        字符串 新缓冲 = 字符串连接(缓冲, 填充串);
        缓冲 = 新缓冲;
        已加++;
    }
    字符串 拼接 = 字符串连接(缓冲, 输入);
    返回 拼接;
}

// 填充右：不足目标长度时右侧补 填充 字符
函数 填充右(字符串 输入, 整64 目标长度, 字符 填充) -> 字符串 {
    整64 需要 = 目标长度 - 字符串长度(输入);
    如果 (需要 <= 0) {
        返回 字符串复制(输入);
    }
    字符串 填充串 = 字符转字符串(填充);
    字符串 缓冲 = 字符串复制(输入);
    整64 已加 = 0;
    当 (已加 < 需要) {
        字符串 新缓冲 = 字符串连接(缓冲, 填充串);
        缓冲 = 新缓冲;
        已加++;
    }
    返回 缓冲;
}

// 分割：按 分隔符 切分 输入，结果写入 结果数组（长度 数组长度）
// 返回：实际切分数量（结果<整64,整32>）；数组不足容纳剩余内容 → 错误(6)
// 说明：数组长度须为编译期常量，故用调用方传入的 字符串* 数组（对标 C 风格）；
//   每个结果元素为动态分配字符串，调用方负责逐一 字符串释放()
不安全 函数 分割(字符串 输入, 字符串 分隔符, 字符串* 结果数组, 整64 数组长度) -> 结果<整64, 整32> {
    整64 分隔长 = 字符串长度(分隔符);
    如果 (分隔长 == 0) {
        返回 错误(6);
    }
    字符串 剩余 = 字符串复制(输入);
    整64 数量 = 0;
    布尔 溢出 = 假;
    当 (真) {
        如果 (数量 >= 数组长度) {
            溢出 = 真;
            中断;
        }
        整64 找到 = 字符串查找(剩余, 分隔符);
        如果 (找到 < 0) {
            // 最后一个片段：剩余 全部作为结果
            结果数组[数量] = 字符串复制(剩余);
            数量++;
            中断;
        }
        结果数组[数量] = 字符串子串(剩余, 0, 找到);
        数量++;
        整64 新长 = 字符串长度(剩余) - 找到 - 分隔长;
        字符串 新剩余 = 字符串子串(剩余, 找到 + 分隔长, 新长);
        剩余 = 新剩余;
    }
    如果 (溢出) {
        // 数组已满但仍有内容未切分 → 数组长度不足（调用方须释放已填元素）
        返回 错误(6);
    }
    返回 正常(数量);
}
