// E2E 432（331-a T51）：i128 复合赋值全算符 + 自增自减矩阵（目标=局部变量）
//   背景：复合赋值六路（标识符/成员/静态/指针解引用等）与自增自减公共路径的
//   右值/delta 未宽化 → -O0 发射按未宽化处理 → `+= 字面量` 静默不生效
//   （O1+ 优化层常量折叠掩盖=级别分叉）；修复=widenCompoundRhs 单一归属
//   （128 位目标且右值类型不同时插 转换）。本用例锁定四级 O0/O3 双级别一致。
函数 主() -> 整32 {
    整128 值 = 1000;
    值 += 100;   打印行(整64(值));
    值 -= 50;    打印行(整64(值));
    值 *= 2;     打印行(整64(值));
    值 /= 3;     打印行(整64(值));
    值 %= 101;   打印行(整64(值));
    值 &= 63;    打印行(整64(值));
    值 |= 1;     打印行(整64(值));
    值 ^= 7;     打印行(整64(值));
    值 <<= 2;    打印行(整64(值));
    值 >>= 1;    打印行(整64(值));
    值++;        打印行(整64(值));
    值--;        打印行(整64(值));
    整128 大 = 1099511627776;
    大 += 1;
    打印行(整64(大));
    大++;
    打印行(整64(大));
    返回 0;
}
