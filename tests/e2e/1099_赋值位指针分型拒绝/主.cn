// E2E 1099_赋值位指针分型拒绝（1039 修复·负例 dual）：指针变量目标的赋值
//   仅放行同型指针源（宿主 canConvertType 指针段 / v2 指针分型检查同判）——
//   非指针源（v 整32 变量）与异型指针源（r 整64*）双侧编译拒绝。修前 v2 对
//   非指针源经剥星基名误放行（目标=源=整32 同型假象）=分叉；修后统一拒。
函数 主() -> 整32 {
    整32[3] 表 = {10, 20, 30};
    整32* q = &表[0];
    整32 v = 7;
    q = v;
    整64 x = 1;
    整64* r = &x;
    q = r;
    返回 0;
}
