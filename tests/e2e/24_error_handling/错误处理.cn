// Task 3.5 错误处理 E2E 测试
// 覆盖：结果<T,E> 类型（正常/错误构造、.正常/.值/.错误 检查）、
//       可选<T> 类型（某些/无 构造、.有值/.值 检查）、
//       3 条强制检查规则的合规用法（规则1 结果被检查、规则2 检查后处理两个分支、
//       规则3 访问.值前检查.有值）
// 语法依据（cn-language-spec 07）：结果<正常,错误> + 正常(值)/错误(错误码)；
//   可选<T> + 某些(值)/无；错误码约定附录B（1=除零、2=数组越界、3=空指针、5=文件打开失败）
// 打印语义（用户裁决）：打印=println（自动换行）；布尔经字符串 + 拼接输出 真/假

// 除法：返回 结果<整32, 整32>（正常=商 / 错误码1=除零）
函数 安全除法(整32 a, 整32 b) -> 结果<整32, 整32> {
    如果 b == 0 {
        返回 错误(1);   // 错误码1: 除零错误
    }
    返回 正常(a / b);
}

// 查找：返回 可选<字符串>（某些=找到 / 无=未找到）
函数 查找名字(整32 编号) -> 可选<字符串> {
    如果 编号 == 1 {
        返回 某些("张三");
    }
    如果 编号 == 2 {
        返回 某些("李四");
    }
    返回 无;
}

// 打开配置：返回 结果<字符串, 整32>（错误码5=文件打开失败）
函数 打开配置(字符串 路径) -> 结果<字符串, 整32> {
    // 灰色点②方案A迁移（2026-09-04 用户批准）：原 `路径 == ""` 字符串比较运算符
    //   已显式拒绝（规范 Task 2.8）——改 字符串比较 内容判定（行为等价：空路径
    //   时为真，同样进 错误(5) 分支，.expected 零变化）
    如果 字符串比较(路径, "") {
        返回 错误(5);   // 错误码5: 文件打开失败
    }
    返回 正常("配置内容: " + 路径);
}

函数 主() -> 整32 {
    打印("===== 错误处理（Task 3.5）=====");

    // ---- 1. 结果<T,E>：正常分支（规则1 合规：结果被赋值并检查）----
    结果<整32, 整32> 除结果 = 安全除法(10, 2);
    如果 除结果.正常 {
        打印("10/2 = ", 除结果.值);          // 10/2 = 5
    } 否则 {
        打印("错误码: ", 除结果.错误);
    }

    // ---- 2. 结果<T,E>：错误分支（错误码）----
    结果<整32, 整32> 除零结果 = 安全除法(10, 0);
    如果 除零结果.正常 {
        打印("10/0 = ", 除零结果.值);
    } 否则 {
        打印("除零错误码: ", 除零结果.错误);  // 除零错误码: 1
    }

    // ---- 3. 规则2 合规：检查后处理两个分支（if-else 双分支）----
    结果<整32, 整32> 再除 = 安全除法(20, 4);
    如果 再除.正常 {
        打印("20/4 = ", 再除.值);            // 20/4 = 5
    } 否则 {
        打印("失败: ", 再除.错误);
    }

    // ---- 4. 可选<T>：有值分支（规则3 合规：.值 前检查 .有值）----
    可选<字符串> 找到1 = 查找名字(1);
    如果 找到1.有值 {
        打印("编号1: ", 找到1.值);           // 编号1: 张三
    } 否则 {
        打印("编号1 未找到");
    }

    // ---- 5. 可选<T>：无值分支 ----
    可选<字符串> 找到3 = 查找名字(3);
    如果 找到3.有值 {
        打印("编号3: ", 找到3.值);
    } 否则 {
        打印("编号3 未找到");                 // 编号3 未找到
    }

    // ---- 6. 结果<T,E> 与字符串结合（错误码5=文件打开失败）----
    结果<字符串, 整32> 配置 = 打开配置("config.ini");
    如果 配置.正常 {
        打印("配置: ", 配置.值);             // 配置: 配置内容: config.ini
    } 否则 {
        打印("配置错误码: ", 配置.错误);
    }

    结果<字符串, 整32> 空配置 = 打开配置("");
    如果 空配置.正常 {
        打印("空配置: ", 空配置.值);
    } 否则 {
        打印("空配置错误码: ", 空配置.错误); // 空配置错误码: 5
    }

    // ---- 7. 多个结果组合使用（每个都检查；嵌套 if 避免复合条件边界）----
    结果<整32, 整32> 甲 = 安全除法(100, 5);
    结果<整32, 整32> 乙 = 安全除法(100, 0);
    如果 甲.正常 {
        如果 乙.正常 {
            打印("两数正常: ", 甲.值, " ", 乙.值);
        } 否则 {
            打印("乙失败");                     // 乙失败（乙 除零）
        }
    } 否则 {
        打印("甲失败");
    }

    // 说明：3 条强制检查规则的违规用法（未检查丢弃结果/检查后缺错误分支/
    //   未检查.有值直接访问.值）由语义层报错，单测 test_semantic_error.cpp 覆盖；
    //   本 E2E 只验证合规用法（正向行为）。

    打印("===== 错误处理测试完成 =====");
    返回 0;
}
