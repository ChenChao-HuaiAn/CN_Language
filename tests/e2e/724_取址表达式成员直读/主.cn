// 723：(&数组[下标]).字段 取址表达式成员直读/写 双编译对照（425 遗留①·448 锁用例）
// 形态：UnaryExpr(取地址, 下标) 作成员访问对象——&表[i] 类型=下标元素类型。
// 缺陷实录（宿主）：resolveMemberObjSrcType/memberObjStructType 的 UnaryExpr
//   分支只认解引用形态 → 直读降级常量 0；地址层 FieldAddr 不发射 → 写错址
//   （(&表[0]).y=77 实锤写到偏移 0 覆盖 x）。探针实证后根治，本用例锁形。
// v2.1 统一 `.` 语义：指针自动解引用一级，(&表[i]).字段 ≡ 表[i].字段。

结构体 点 {
    整32 x;
    整32 y;
}

不安全 函数 主() -> 整32 {
    点[3] 表;
    表[0].x = 11; 表[0].y = 12;
    表[1].x = 21; 表[1].y = 22;
    表[2].x = 31; 表[2].y = 32;

    // 一、取址表达式成员直读（缺陷形态：原降级 0）
    打印((&表[1]).x);
    打印((&表[1]).y);
    打印((&表[2]).x);

    // 二、对照形态：变量基座直读（恒绿，防修复误伤）
    打印(表[1].x);

    // 三、写面（地址层 FieldAddr 偏移 4：原写到偏移 0 覆盖 x）
    (&表[0]).y = 77;
    打印(表[0].x);
    打印(表[0].y);

    // 四、指针下标取址形态：(&p[2]).y（p=数组名退化指针）
    点* p = 表;
    打印((&p[2]).y);

    返回 0;
}
