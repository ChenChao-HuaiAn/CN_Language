// 553（#443 呈报分叉① dual 负例·预期失败）：非函数被调双侧同拒——
//   结构体名/变量遮蔽结构体名/类对象变量/字符串变量 圆括号调用形态；
//   宿主「无法调用非函数类型 'X'」族（semantic_call.cpp:251）·v2 语义层补
//   检查（补前 v2 命中即放行，链到链接期 LNK2019「?点@@Y」=非法放行落码）。
结构体 点 {
    整32 x;
    整32 y;
}
类 盒 {
公开:
    整32 v;
    函数 盒() {
        v = 0;
    }
}
函数 主() -> 整32 {
    点(1, 2);          // 预期失败：无法调用非函数类型 '点'
    整32 点 = 5;       // 局部变量遮蔽结构体名（被调类型随遮蔽走）
    点(1, 2);          // 预期失败：无法调用非函数类型 '整32'
    盒 甲 = 盒();
    甲(1, 2);          // 预期失败：无法调用非函数类型 '盒'
    字符串 丙 = "ab";
    丙(1);             // 预期失败：无法调用非函数类型 '字符串'
    返回 0;
}
