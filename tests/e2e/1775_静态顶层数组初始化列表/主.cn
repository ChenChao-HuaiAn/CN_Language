// 2051（CN-Smith 采样轮实锤缺口根治）：静态局部/顶层全局数组初始化列表 { … } 全链放行。
// 病（1104 采样实录）：数组列表仅局部形态支持——静态局部/顶层全局声明走 parseExpr
//   报「预期表达式，实际为 '{'」（解析层缺口非拒绝面：常量列表比 001 §668 变量源
//   整块拷贝初值更弱，同语义放行；1006 已锚变量源守卫快照绿）。
// 语义：
//   ① 顶层全局列表=逐元素常量性校验（d 款 constinit 列表形态·语义层）+.data 直发
//     （C static 数组同款零运行期开销·三后端 data_seg_init 打包）。
//   ② 静态局部常量整数列表=.data 直发（无 guard）。
//   ③ 静态局部数组缺格补零（C 语义对齐·1473 甲案零位默认态）。
//   ④ 列表超长=编译期拒（847 既有诊断锚·语义层个数校验通用面）。
// 覆盖：局部/静态局部/顶层全局三通道列表+静态缺格补零+跨通道下标读写。
整32[3] 全表 = {7, 8, 9};

函数 主() -> 整32 {
    整32[3] 局部表 = {10, 20, 30};
    静态 整32[3] 静表 = {88, 11, 22};
    静态 整32[5] 补零表 = {1, 2};
    整32[2][2] 二维表 = { { 1, 2 }, { 3, 4 } };
    打印行(局部表[0]);
    打印行(局部表[1]);
    打印行(局部表[2]);
    打印行(全表[0]);
    打印行(全表[1]);
    打印行(全表[2]);
    打印行(静表[0]);
    打印行(静表[2]);
    打印行(补零表[0]);
    打印行(补零表[1]);
    打印行(补零表[4]);
    打印行(二维表[1][1]);
    返回 0;
}
