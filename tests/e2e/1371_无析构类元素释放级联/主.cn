// E2E 1371（2026-10-18 任务942·#942 E面清偿）：容器元素=**无用户析构类**
//   （盒{向量<字符串> 记录}·牌{字符串 名}——无 ~盒/无 ~牌）与类数组元素在
//   11 形态泄漏净零断言（内存::活动分配数差值）+ 内容断言：
//   ①块出口 ②清空 ③删除单 ④删除中间(3元素移位) ⑤循环跳出 ⑥提前返回
//   ⑦链表清空 ⑧链表删头 ⑨串字段类元素 ⑩循环3追加清空 ⑪类数组[2]块出口。
//   断言=通过计数（每形态返回 1=通过/0=失败——计数全可辨，防位掩码高位
//   失真）；程序打印「通过=11/11」，双编译对照两侧同源跑+断言输出逐行比对。
//   修复前：宿主/v2 每元素残留 2（三形态 222 双侧对位·E 探针实证）；
//   修复=无用户析构类（含可释放字段）元素释放注入面扩（宿主
//   emitNoDtorFieldCascade 级联通道/v2 判定放宽+合成沿链析构体承载·
//   容器元素/析构元素/出口路径全覆盖；数组载体面双侧同轮）。
导入 容器::向量;
导入 容器::链表;

类 盒 {
公开:
    向量<字符串> 记录;
    函数 盒() { 记录 = 向量<字符串>(); }
    不安全 函数 盒(盒& 其他) { 记录 = 其他.记录; }
}

类 牌 {
公开:
    字符串 名;
    函数 牌() { 名 = 字符串复制("未命名"); }
    不安全 函数 牌(牌& 其他) { 名 = 字符串复制(其他.名); }
}

函数 形块出口() -> 整64 {
    整64 前 = 内存::活动分配数();
    {
        向量<盒> 表 = 向量<盒>();
        盒 甲;
        结果<空类型, 整32> r1 = 甲.记录.追加(字符串复制("出口载荷"));
        结果<空类型, 整32> r2 = 表.追加(甲);
        如果 (表.大小() != 1) { 返回 0; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 1;
}

函数 形清空() -> 整64 {
    整64 前 = 内存::活动分配数();
    {
        向量<盒> 表 = 向量<盒>();
        盒 甲;
        结果<空类型, 整32> r1 = 甲.记录.追加(字符串复制("清空载荷"));
        结果<空类型, 整32> r2 = 表.追加(甲);
        表.清空();
        如果 (表.大小() != 0) { 返回 0; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 1;
}

函数 形删除单() -> 整64 {
    整64 前 = 内存::活动分配数();
    {
        向量<盒> 表 = 向量<盒>();
        盒 甲;
        结果<空类型, 整32> r1 = 甲.记录.追加(字符串复制("删除载荷"));
        结果<空类型, 整32> r2 = 表.追加(甲);
        结果<空类型, 整32> 删 = 表.删除(0);
        如果 (表.大小() != 0) { 返回 0; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 1;
}

函数 形删除中间() -> 整64 {
    整64 前 = 内存::活动分配数();
    {
        向量<盒> 表 = 向量<盒>();
        盒 甲;
        结果<空类型, 整32> r1 = 甲.记录.追加(字符串复制("中间一"));
        结果<空类型, 整32> 加1 = 表.追加(甲);
        盒 乙;
        结果<空类型, 整32> r2 = 乙.记录.追加(字符串复制("中间二"));
        结果<空类型, 整32> 加2 = 表.追加(乙);
        盒 丙;
        结果<空类型, 整32> r3 = 丙.记录.追加(字符串复制("中间三"));
        结果<空类型, 整32> 加3 = 表.追加(丙);
        结果<空类型, 整32> 删 = 表.删除(1);
        如果 (表.大小() != 2) { 返回 0; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 1;
}

函数 形跳出() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 轮 = 0;
    当 (轮 < 1) {
        {
            向量<盒> 表 = 向量<盒>();
            盒 甲;
            结果<空类型, 整32> r1 = 甲.记录.追加(字符串复制("跳出载荷"));
            结果<空类型, 整32> r2 = 表.追加(甲);
            中断;
        }
        轮++;
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 1;
}

函数 提前返回体() -> 整64 {
    向量<盒> 表 = 向量<盒>();
    盒 甲;
    结果<空类型, 整32> r1 = 甲.记录.追加(字符串复制("早返载荷"));
    结果<空类型, 整32> r2 = 表.追加(甲);
    如果 (表.大小() != 1) { 返回 0; }
    返回 1;
}

函数 形提前返回() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 码 = 提前返回体();
    如果 (码 != 1) { 返回 0; }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 1;
}

函数 形链表清空() -> 整64 {
    整64 前 = 内存::活动分配数();
    {
        链表<盒> 表 = 链表<盒>();
        盒 甲;
        结果<空类型, 整32> r1 = 甲.记录.追加(字符串复制("链清一"));
        结果<空类型, 整32> 加1 = 表.追加(甲);
        盒 乙;
        结果<空类型, 整32> r2 = 乙.记录.追加(字符串复制("链清二"));
        结果<空类型, 整32> 加2 = 表.追加(乙);
        表.清空();
        如果 (表.大小() != 0) { 返回 0; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 1;
}

函数 形链表删头() -> 整64 {
    整64 前 = 内存::活动分配数();
    {
        链表<盒> 表 = 链表<盒>();
        盒 甲;
        结果<空类型, 整32> r1 = 甲.记录.追加(字符串复制("链头一"));
        结果<空类型, 整32> 加1 = 表.追加(甲);
        盒 乙;
        结果<空类型, 整32> r2 = 乙.记录.追加(字符串复制("链头二"));
        结果<空类型, 整32> 加2 = 表.追加(乙);
        结果<空类型, 整32> 删 = 表.删除头部();
        如果 (表.大小() != 1) { 返回 0; }
        表.清空();
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 1;
}

函数 形串字段类() -> 整64 {
    整64 前 = 内存::活动分配数();
    {
        向量<牌> 表 = 向量<牌>();
        牌 甲;
        结果<空类型, 整32> 加 = 表.追加(甲);
        结果<空类型, 整32> 删 = 表.删除(0);
        如果 (表.大小() != 0) { 返回 0; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 1;
}

函数 形多元素清空() -> 整64 {
    整64 前 = 内存::活动分配数();
    {
        向量<盒> 表 = 向量<盒>();
        整64 轮 = 0;
        当 (轮 < 3) {
            盒 甲;
            结果<空类型, 整32> r1 = 甲.记录.追加(字符串复制("循环载荷"));
            结果<空类型, 整32> r2 = 表.追加(甲);
            轮++;
        }
        如果 (表.大小() != 3) { 返回 0; }
        表.清空();
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 1;
}

函数 形类数组() -> 整64 {
    整64 前 = 内存::活动分配数();
    {
        盒[2] 区;
        区[0] = 盒();
        区[1] = 盒();
        结果<空类型, 整32> r1 = 区[0].记录.追加(字符串复制("数组一"));
        结果<空类型, 整32> r2 = 区[1].记录.追加(字符串复制("数组二"));
        如果 (区[0].记录.大小() != 1) { 返回 0; }
        如果 (区[1].记录.大小() != 1) { 返回 0; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 1;
}

函数 主() -> 整32 {
    整64 通 = 0;
    如果 (形块出口() != 0) { 通 = 通 + 1; }
    如果 (形清空() != 0) { 通 = 通 + 1; }
    如果 (形删除单() != 0) { 通 = 通 + 1; }
    如果 (形删除中间() != 0) { 通 = 通 + 1; }
    如果 (形跳出() != 0) { 通 = 通 + 1; }
    如果 (形提前返回() != 0) { 通 = 通 + 1; }
    如果 (形链表清空() != 0) { 通 = 通 + 1; }
    如果 (形链表删头() != 0) { 通 = 通 + 1; }
    如果 (形串字段类() != 0) { 通 = 通 + 1; }
    如果 (形多元素清空() != 0) { 通 = 通 + 1; }
    如果 (形类数组() != 0) { 通 = 通 + 1; }
    打印("通过=", 通, "/11");
    返回 整32(通);
}
