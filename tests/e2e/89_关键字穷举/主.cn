// E2E 89_关键字穷举：用 CN 自举词法器 分词 穷举 46 个保留字（规格书 01a 第五节）
// 162-a（2026-09-14，plans/024 §七/§十）：删 自动/实现，原始/多行 与 公开/私有/静态/常量/
// 保护/虚拟/重写/抽象/作为/模块 十词上下文化（非保留字，不入本串）；补 不安全。
// 上下文关键字语法形态由 272（新增）与既有用例（22_interface/104 等）覆盖。
// 构造一个源码字符串，把规范的 46 个保留字各自作为独立记号出现（空格分隔），
// 用 分词 得到 token，逐记号断言「token 类型 == 关键字文本本身」（关键字 token 类型=文本）。
// 分词 输出格式（70_self_host_lexer 实测）：每行为 "类型|文本|行号"；关键字 token 类型==文本。
// 实测：46 个保留字全部以 类型==文本 命中；结尾 文件结束||1 为 EOF 记号（非关键字，不计）。

导入 容器::向量;
导入 CN语言编译器::词法分析::分词;

函数 主() -> 整32 {
    打印("===== 关键字穷举（规格书 01a 第五节，共 46 个）=====");
    // 源码：46 个保留字以空格分隔（各为独立记号）
    字符串 源码 = "如果 否则 当 循环 返回 中断 继续 选择 情况 默认 整数 小数 整8 整16 整32 整64 整128 正8 正16 正32 正64 正128 浮32 浮64 布尔 字符 字符串 空类型 结构体 联合体 枚举 函数 变量 导入 真 假 无 不安全 类 接口 自身 父类 友元 结果 可选 泛型";
    向量<字符串> 记号 = 分词(源码);

    整64 命中数 = 0;
    整64 未命中数 = 0;
    整64 i = 0;
    当 (i < 记号.大小()) {
        字符串 记号串 = 记号.元素(i);
        // 解析 "类型|文本|行号"：类型 = 第一段，文本 = 第二段
        整64 竖线1 = 字符串查找(记号串, "|");
        字符串 类型 = 字符串子串(记号串, 0, 竖线1);
        整64 尾长 = 字符串长度(记号串) - 竖线1 - 1;
        字符串 尾部 = 字符串子串(记号串, 竖线1 + 1, 尾长);
        整64 竖线2 = 字符串查找(尾部, "|");
        字符串 文本 = 字符串子串(尾部, 0, 竖线2);
        // 断言：关键字 token 的类型 == 其文本本身
        如果 (字符串比较(类型, 文本)) {
            命中数++;
            打印("关键字[", 命中数, "]: ", 记号串);
        } 否则 {
            未命中数++;
            打印("非关键字记号: ", 记号串);
        }
        i++;
    }

    打印("----------------------------------------");
    打印("命中关键字数: ", 命中数, " / 未命中(EOF等): ", 未命中数);
    如果 (命中数 == 46) {
        打印("结果：全部 46 个保留字均识别为关键字类型（类型==文本）✓");
    } 否则 {
        打印("结果：关键字穷举不完整（期望 46）");
    }
    打印("===== 关键字穷举验证完成 =====");
    返回 0;
}
