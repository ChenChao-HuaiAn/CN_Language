// E2E 196_v2（v2 正路径闭环，2026-09-10 第五十七轮 plans/019 阶段1）：
//   v2 侧显式转移 潜语义（与宿主 196 同主题、适配 v2 第一版支持面=指针/字符串
//   全位置；容器声明位 v2 随阶段3 浅拷贝对齐——诚实边界）。
//   三正形态校验和：指针转移交接（*r 读 55）+1 / 字符串转移（长度 3 字节）+2 /
//   遮蔽（内层同名新指针声明不受外层已转移影响，读 55）+4 → 全对 返回 7。
函数 主() -> 整32 {
    整64 基 = 55;
    整64* q = &基;
    整64* r = 转移(q);
    字符串 甲 = "左";
    字符串 乙 = 转移(甲);
    整64 累计 = 0;
    如果 (*r == 55) { 累计 = 累计 + 1; }
    如果 (字符串长度(乙) == 3) { 累计 = 累计 + 2; }
    {
        整64* q = &基;
        如果 (*q == 55) { 累计 = 累计 + 4; }
    }
    返回 整32(累计);
}
