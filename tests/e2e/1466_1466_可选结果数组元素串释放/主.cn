// 1466（#1415 P1·点5·v2 闭环用例）：可选/结果 **数组元素串载荷释放**（v2 闭环）——
//   v2 数组元素释放面原仅字符串元素与类/容器元素（发射数组串元素释放 923 分派），
//   可选/结果 元素（内联合成体 tag+载荷）落「非字符串→923（类/容器外早退）」=
//   元素内串载荷块出口/返回路径全漏（探针残留 2/2）。修复=按元素类型分派
//   发射结果数组元素释放1415（元素地址 + 发射结果可选值字段释放于地址 单点，
//   正常/有值守卫内释放串/结构体/类载荷，值槽清零幂等）；登记面生成数组局部
//   归一文本（尖括号/$ 两态）判 结果载荷带资源205。
// 同轮附带（审查实证·同族）：结果/可选 **初始化列表元素**整块拷贝——原
//   查结构体大小(合成体)=0 落标量 IR_指针存储 8 字节（元素寄存器=物化槽地址
//   写入元素槽 → 组[0].值 读垃圾、临时体句柄无人持有=残留 2）。
// 泄漏断言=内存::活动分配数 差值（块前/块后）==0 + 载荷内容/正常位断言。
// 双侧同源（宿主 emitStrArrayElemFreesFor 同轮补齐结果/可选元素逐元素条件释放·
//   宿主数组初始化列表合成体元素整块拷贝·下标赋值双重求值根治）——残留断言
//   0/0 双侧成立，本用例=双编译对照（宿主+v2 同源码同期望）。
函数 可选数组初始化1465() -> 整64 {
    整64 前 = 内存::活动分配数();
    {
        可选<字符串>[2] 组 = { 某些(字符串复制("初组甲载荷")), 某些(字符串复制("初组乙载荷")) };
        如果 (组[0].有值) {
            如果 (!字符串比较(组[0].值, "初组甲载荷")) { 打印("初组0值错"); }
        } 否则 { 打印("初组0无值"); }
        如果 (组[1].有值) {
            如果 (!字符串比较(组[1].值, "初组乙载荷")) { 打印("初组1值错"); }
        } 否则 { 打印("初组1无值"); }
    }
    整64 后 = 内存::活动分配数();
    打印("初始化残留=" + 整数转字符串(后 - 前));
    返回 1;
}

函数 结果数组赋值1465() -> 整64 {
    整64 前 = 内存::活动分配数();
    {
        结果<字符串, 整32>[2] 组;
        组[0] = 正常(字符串复制("赋组甲载荷"));
        组[1] = 正常(字符串复制("赋组乙载荷"));
        如果 (组[0].正常) {
            如果 (!字符串比较(组[0].值, "赋组甲载荷")) { 打印("赋组0值错"); }
        } 否则 { 打印("赋组0异常"); }
        如果 (组[1].正常) {
            如果 (!字符串比较(组[1].值, "赋组乙载荷")) { 打印("赋组1值错"); }
        } 否则 { 打印("赋组1异常"); }
    }
    整64 后 = 内存::活动分配数();
    打印("赋值残留=" + 整数转字符串(后 - 前));
    返回 1;
}

不安全 函数 主() -> 整32 {
    整64 甲 = 可选数组初始化1465();
    整64 乙 = 结果数组赋值1465();
    如果 (甲 == 1 && 乙 == 1) { 返回 0; }
    返回 1;
}
