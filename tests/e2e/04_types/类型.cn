// 类型系统E2E测试（Task 2.3）
// 覆盖：全部位宽整数（整8~整128/正8~正128）、浮32/浮64、后缀字面量（f/L/LL/U/UL/ULL）、
//       隐式转换链、位运算与移位、浮点算术（SSE）、i128 基本运算（加/减/比较）
// 注意：打印（变参）对整型统一 Cast 整64/正64 后打印（整64 有符号、正64 无符号）；
//       浮32 先 Cast 浮64（方案C 2026-08-14：遗留 打印行整数/打印行浮点 已删除）

函数 主() -> 整32 {
    // ---- 1. 位宽整数声明与运算 ----
    整8 a8 = 100
    整16 a16 = 30000
    整32 a32 = 100000
    整64 a64 = 5000000000
    正8 b8 = 200
    正16 b16 = 60000
    正32 b32 = 4000000000U
    正64 b64 = 8000000000UL
    正32 b32s = 123U

    打印("整8 运算: ")
    打印(a8 + 50)          // 150（100+50 在8位范围内）
    打印("整16 运算: ")
    打印(a16 - 5000)       // 25000
    打印("整32 运算: ")
    打印(a32 * 3)          // 300000
    打印("整64 运算: ")
    打印(a64 + 1)          // 5000000001
    打印("正8: ")
    打印(b8 + 50)          // 250
    打印("正16: ")
    打印(b16 + 5000)       // 65000
    打印("正32: ")
    打印(b32 + 1)          // 4000000001
    打印("正64: ")
    打印(b64 + 1)          // 8000000001

    // ---- 2. 后缀字面量 ----
    整64 lv = 123L
    整128 llv = 123LL
    正32 uv = 123U
    正64 ulv = 123UL
    正128 ullv = 123ULL
    浮32 fv = 3.5f

    打印("后缀 L: ")
    打印(lv)
    打印("后缀 LL (低64位): ")
    打印(llv)
    打印("后缀 U: ")
    打印(uv)
    打印("后缀 UL: ")
    打印(ulv)
    打印("后缀 ULL (低64位): ")
    打印(ullv)
    打印("后缀 f: ")
    打印(fv)

    // ---- 3. 隐式转换 ----
    整64 wide = a32
    浮64 fwide = 3.5f
    浮64 fi = a32
    打印("隐式转换 整32->整64: ")
    打印(wide)
    打印("隐式转换 浮32->浮64: ")
    打印(fwide)
    打印("隐式转换 整->浮: ")
    打印(fi)

    // ---- 4. 位运算与移位 ----
    整32 x = 0b1100
    整32 y = 0b1010
    打印("位与: ")
    打印(x & y)      // 8
    打印("位或: ")
    打印(x | y)      // 14
    打印("位异或: ")
    打印(x ^ y)      // 6
    打印("位非: ")
    打印(~x)         // -13
    打印("左移: ")
    打印(x << 2)     // 48
    打印("右移: ")
    打印(x >> 1)     // 6

    // ---- 5. 浮点算术 ----
    浮64 fa = 1.5 + 2.25
    浮64 fb = 5.0 * 2.0
    浮64 fc = 7.5 / 2.0
    浮64 fd = 10.0 - 3.5
    打印("浮点加: ")
    打印(fa)          // 3.750000
    打印("浮点乘: ")
    打印(fb)          // 10.000000
    打印("浮点除: ")
    打印(fc)          // 3.750000
    打印("浮点减: ")
    打印(fd)          // 6.500000

    // ---- 6. i128 基本运算（加减与比较，比较结果为布尔） ----
    整128 i1 = 1000000000LL
    整128 i2 = 2000000000LL
    整128 isum = i1 + i2
    整128 idiff = i2 - i1
    整128 big = 100000000000000000LL
    整128 big2 = big + 1LL

    如果 (isum == 3000000000LL) { 打印("i128 加法正确") } 否则 { 打印("i128 加法错误") }
    如果 (idiff == 1000000000LL) { 打印("i128 减法正确") } 否则 { 打印("i128 减法错误") }
    如果 (big2 == 100000000000000001LL) { 打印("i128 大值运算正确") } 否则 { 打印("i128 大值运算错误") }

    返回 0
}
