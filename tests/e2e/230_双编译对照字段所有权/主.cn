// E2E 230（2026-09-12 第七十九轮，plans/020 移植纪律 9 门禁化·第六个对照用例）：
//   **聚合拥有型字符串字段 drop glue**——同一份源码经宿主真实管线与 v2 自举链
//   各编译运行，两侧退出码须相等（runner「双编译对照」编排断言：宿主侧 == 用例
//   期望值 且 v2 侧 == 宿主侧实测值）。
//   覆盖 79-a 修复的全部机制 × 两侧共有语义面：
//     ① 结构体字符串字段：字面量初始化 + 块出口释放（残留归零 + 内容守恒）
//     ② 整体拷贝深拷：声明位（乙=甲）/赋值位（丙=甲，preFree 幂等）/字段写入
//        归一化（甲.名=字符串复制(乙.名) 白名单调用接管）/结构体自赋值 no-op
//     ③ 结构体返回接收：被调方返回移出（跳过释放）+ 调用方浅拷接管（零拷贝）
//     ④ 装箱正常分支：结果<字符串,整32> 值位=堆串，块出口条件释放
//     ⑤ 装箱错误分支：值位=错误码整数——联合体条件释放（无条件 free 即崩）
//     ⑥ 可选<字符串>：某些/有值 分支释放
//     ⑦ 循环体内结构体（20 万轮）：块出口 drop + 内容守恒
//     ⑧ 装箱返回接收：结果<字符串,E> 跨函数（正常/错误双路）
//   校验和折位：①1 ②2 ③4 ④8 ⑤16 ⑥32 ⑦64 ⑧64×2=128 —— 255=全对。
//   两侧任一形态的所有权机制分叉（不释放/晚释放/双释/深拷缺失→悬垂）→ 该校验位
//   丢失 → 退出码变化 → 对照失败（含"泄漏/悬垂"两类内容测试抓不到的形态）。
//   平台守卫=linux 双平台（宿主与 v2 同链；win-x64 v2 产物未隔离=家机轮）。
结构体 盒子 {
    字符串 名;
    整32 号;
}

// ① 字面量初始化 + 块出口释放 + 内容守恒
函数 形一() -> 整64 {
    整64 前 = 内存::活动分配数();
    {
        盒子 箱 = 盒子{ 名 = 字符串复制("形一结构体字段占位内容甲乙丙丁戊己庚辛"), 号 = 1 };
        如果 (!字符串比较(箱.名, "形一结构体字段占位内容甲乙丙丁戊己庚辛")) { 返回 0; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 1;
}

// ② 整体拷贝深拷（声明 + 赋值 preFree + 字段写入归一化 + 自赋值）
函数 形二() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        盒子 甲 = 盒子{ 名 = 字符串复制("形二整体拷贝源占位内容甲乙丙丁戊己庚辛"), 号 = 2 };
        盒子 乙 = 甲;                       // 声明位深拷
        如果 (字符串比较(甲.名, "形二整体拷贝源占位内容甲乙丙丁戊己庚辛") &&
            字符串比较(乙.名, "形二整体拷贝源占位内容甲乙丙丁戊己庚辛")) { 校验 = 1; }
        乙.号 = 9;
        盒子 丙;                            // 裸声明（零初始化）
        丙 = 甲;                            // 赋值位深拷（preFree 幂等）
        如果 (!字符串比较(丙.名, "形二整体拷贝源占位内容甲乙丙丁戊己庚辛")) { 校验 = 0; }
        甲.名 = 字符串复制(乙.名);          // 字段写入归一化（白名单调用接管）
        如果 (!字符串比较(甲.名, "形二整体拷贝源占位内容甲乙丙丁戊己庚辛")) { 校验 = 0; }
        盒子 丁;
        丁 = 丁;                            // 结构体自赋值 no-op
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 != 1) { 返回 0; }
    返回 2;
}

// ③ 结构体返回接收（浅拷接管）
函数 造盒子() -> 盒子 {
    盒子 内 = 盒子{ 名 = 字符串复制("形三返回接收占位内容甲乙丙丁戊己庚辛壬"), 号 = 3 };
    返回 内;
}

函数 形三() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        盒子 收 = 造盒子();
        如果 (字符串比较(收.名, "形三返回接收占位内容甲乙丙丁戊己庚辛壬")) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 4;
}

// ④ 装箱正常分支（值位=堆串）
函数 形四() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        结果<字符串, 整32> 果 = 正常(字符串复制("形四装箱正常占位内容甲乙丙丁戊己庚辛"));
        如果 (果.正常) {
            如果 (字符串比较(果.值, "形四装箱正常占位内容甲乙丙丁戊己庚辛")) { 校验 = 1; }
        }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 8;
}

// ⑤ 装箱错误分支（联合体条件释放：free(错误码) 即崩）
函数 造错误结果() -> 结果<字符串, 整32> {
    返回 错误(5);
}

函数 形五() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        结果<字符串, 整32> 果 = 造错误结果();
        如果 (果.正常) { 校验 = 0; } 否则 {
            如果 (果.错误 == 5) { 校验 = 1; }
        }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 16;
}

// ⑥ 可选<字符串>：某些 + 无
函数 形六() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        可选<字符串> 有 = 某些(字符串复制("形六可选某些占位内容甲乙丙丁戊己庚辛壬"));
        如果 (有.有值) {
            如果 (字符串比较(有.值, "形六可选某些占位内容甲乙丙丁戊己庚辛壬")) { 校验 = 1; }
        }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 32;
}

// ⑦ 循环体内结构体（块出口 + 内容守恒，20 万轮）
函数 形七(整64 轮数) -> 整64 {
    整64 i = 0;
    整64 前七 = 内存::活动分配数();
    当 (i < 轮数) {
        盒子 每轮 = 盒子{ 名 = 字符串复制("形七循环体结构体占位内容甲乙丙丁戊己庚辛"), 号 = 7 };
        如果 (!字符串比较(每轮.名, "形七循环体结构体占位内容甲乙丙丁戊己庚辛")) {
                返回 0;
        }
        i++;
    }
    返回 64;
}

// ⑧ 装箱返回接收（结果<字符串,E> 跨函数）
函数 造结果(布尔 正常路) -> 结果<字符串, 整32> {
    如果 (正常路) {
        返回 正常(字符串复制("形八装箱返回占位内容甲乙丙丁戊己庚辛壬癸"));
    }
    返回 错误(9);
}

函数 形八() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        结果<字符串, 整32> 甲 = 造结果(真);
        如果 (甲.正常) {
            如果 (字符串比较(甲.值, "形八装箱返回占位内容甲乙丙丁戊己庚辛壬癸")) { 校验 = 1; }
        }
        结果<字符串, 整32> 乙 = 造结果(假);
        如果 (乙.正常) { 校验 = 0; } 否则 {
            如果 (乙.错误 == 9) { 校验 = 校验 + 1; }
        }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 64;
}

函数 主() -> 整32 {
    整64 和 = 0;
    和 = 和 + 形一();
    和 = 和 + 形二();
    和 = 和 + 形三();
    和 = 和 + 形四();
    和 = 和 + 形五();
    和 = 和 + 形六();
    和 = 和 + 形七(200000);
    和 = 和 + 形八();
    返回 整32(和);
}
