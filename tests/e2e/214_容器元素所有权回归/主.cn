// E2E 214（2026-09-11 第七十二轮下半程收尾，72-a 探针转正·容器元素所有权）：
//   「拥有串经函数浅共享入容器=元素悬垂」的运行级回归锚定（原 探针86）——
//   v1 树 列表追加 形态：调用方块内声明的拥有串被容器持有后，源在块出口/
//   函数返回释放 = 容器元素悬垂（76 自举用例产物常量池曾退化为指针值，
//   72-a 块级 RAII 使其立即暴露）。A2 纪律：字符串入容器须显式
//   字符串复制（元素所有权归容器，Rust Vec<String> 同款）。
//   验证口径：收集 3 个经解码新造的拥有串入容器（入容器点显式复制），
//   再以 32 轮新分配搅动制造内存复用压力——若元素悬垂（浅共享+源已释放），
//   搅动后的分配会覆盖已释放内存，元素内容损坏；元素内容完好=不悬垂。
导入 容器::向量;
导入 IO::打印;

函数 列表追加(向量<字符串> 列表, 字符串 值) -> 空类型 {
    // A2 纪律（字符串入容器须显式复制）：此处复制落堆，元素所有权归容器
    结果<空类型, 整32> 加 = 列表.追加(字符串复制(值));
    如果 (!加.正常) {
        运行时错误(4);
    }
}

函数 解码(字符串 原) -> 字符串 {
    字符串 内容 = 字符串子串(原, 1, 字符串长度(原) - 2);
    字符串 累积 = "";
    整64 i = 0;
    当 (i < 字符串长度(内容)) {
        累积 = 累积 + 字符转字符串(内容[i]);
        i++;
    }
    返回 累积;
}

// 收集：拥有串经函数入容器（入容器点显式复制——浅共享即悬垂）
函数 收集(向量<字符串> 表) -> 空类型 {
    整64 i = 0;
    当 (i < 3) {
        字符串 值 = 解码("\"内容\"");
        列表追加(表, 值);
        i++;
    }
}

// 制造内存复用（模拟后续解码分配覆盖已释放内存）
函数 搅动() -> 整64 {
    整64 和 = 0;
    整64 i = 0;
    当 (i < 32) {
        字符串 垃圾 = 字符串复制("搅动内存的填充字符串内容占位");
        和 = 和 + 字符串长度(垃圾);
        i++;
    }
    返回 和;
}

函数 主() -> 整32 {
    向量<字符串> 常量表 = 向量<字符串>();
    收集(常量表);
    整64 消耗 = 搅动();
    打印("大小:", 常量表.大小(), " 搅动:", 消耗);
    整64 i = 0;
    当 (i < 常量表.大小()) {
        打印("  元素", i, ":", 常量表.元素(i));
        i++;
    }
    返回 0;
}
