// E2E 1366 正测（#1979 深拷面）：类外静态字符串元素数组字段整体赋值——
//   整块拷后元素级深拷（#1880 数组元素级深拷设施同判据：字符串元素=
//   __cn_str_copy 落堆独立副本）。静态槽长期存活恒拥有（87-a 同律），
//   浅拷共享源局部数组句柄=源块退出 RAII 释放后目标悬垂——深拷面铁证。
类 例 {
公开:
    静态 字符串[2] 名册;
}
函数 填册() -> 空类型 {
    字符串[2] 源册;
    源册[0] = "甲一";
    源册[1] = "乙二";
    例.名册 = 源册;
    返回;
}
函数 主() -> 整32 {
    填册();
    // 源块已退出（局部数组元素串已释放）——目标须为独立副本
    打印(例.名册[0]);
    打印(例.名册[1]);
    // 同作用域值拷语义：赋值后再改源，目标不变（源元素写=句柄替换）
    字符串[2] 源乙;
    源乙[0] = "丙三";
    源乙[1] = "丁四";
    例.名册 = 源乙;
    源乙[0] = "丙改";
    打印(例.名册[0]);
    打印(例.名册[1]);
    返回 0;
}
