// 官网文档示例 · tutorial-syntax.html · 控制流（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
函数 主() -> 整32 {
    整32[5] 数据 = {10, 20, 30, 40, 50};
    遍历 数据 中 每个 x {        // 数组遍历：x=元素副本
        打印行(x, " ");
    }
    打印("");

    循环 (整32 k = 0; k < 100; k++) {
        如果 k % 2 == 0 { 继续; }   // 跳过偶数
        如果 k > 10 { 中断; }        // 终止循环
        打印行(k, " ");
    }
    打印("");
    返回 0;
}