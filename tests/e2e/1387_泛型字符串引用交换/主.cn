// E2E 1387（#1089·1017 采样轮探针 v07 同族·dual 正例）：泛型 T& 引用交换 ×
//   字符串实例化——字符串引用传递路径双侧病根治锁面：值交换正确（两轮往返）
//   + 交换净零泄漏（内存账）+ 块结束无崩（运行无错误码3/悬垂）。
//   修前病史：①宿主 `甲 = 乙`（源=引用参数）误清源参槽（变量地址丢失）→ 交换
//   第二笔 `乙 = 临时` 经 0 地址写回=空指针解引用（错误码3）；②v2 写回调用方
//   槽后源槽未清（出口 RAII free 已移交句柄=调用方悬垂·打印缺值）+ 目标旧值
//   覆盖无释放（每轮净泄 1 堆串）——双侧各自复现·修后双侧逐字同。
//   期望 5 行：乙/甲/甲/乙/0（0=两轮交换活动分配净零）。
泛型 <类型 T>
函数 交换(T& 甲, T& 乙) -> 空类型 {
    T 临时 = 甲;
    甲 = 乙;
    乙 = 临时;
}
函数 主() -> 整32 {
    字符串 甲 = "甲";
    字符串 乙 = "乙";
    交换(甲, 乙);
    打印(甲);
    打印(乙);
    交换(甲, 乙);
    打印(甲);
    打印(乙);
    整64 前 = 内存::活动分配数();
    交换(甲, 乙);
    交换(甲, 乙);
    整64 后 = 内存::活动分配数();
    打印(后 - 前);
    返回 0;
}
