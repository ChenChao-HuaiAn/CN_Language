// E2E 1437 引用返回绑定成员复合写与方法接收者（任务 1261·1020 采样轮 P0·dual）：
//   自由函数返回 类&（T& 引用返回）绑定引用变量后作**成员写目标**与**方法
//   接收者**——同源码宿主/v2 各编各跑逐行比对（零分叉门禁·类形态=宿主壳
//   模型绿面·结构体真聚合形态宿主 sret 副本写丢=1260 已修面另论）。
//   修前 v2 采样实录（两诊断·归属方法被调链基座形态）：①仓1.取货().件数+=5
//   → [内部错误] 成员宽度码·对象类型未登记 '件数'；②p.取计().加(5) →
//   [ir2] 方法调用对象类型未解析: .加——合法源码被编译期中止（宿主编译放行
//   =分叉红线）。根因：解析调用返回结构体 的方法被调分支只认容器类，用户类
//   方法返回恒 0（1175 返回位只补了自由函数被调分支·方法面对称面漏）——
//   1261 单点补齐（用户类方法返回结构体键1261·复用 调用返回结构体键1175
//   剥尾*/&+泛型归一+大小守卫）。
//   本用例主体=自由函数绑定形态（同族绿面锚·修前 v2 即绿·锁类型解析单点
//   回归）。病面边界（1020 采样轮+1261 实测留痕·不扩展断言）：
//   ①方法引用返回（-> T& { 返回 成员; }）链基座形态：1261 修复后 v2 编译
//     放行，运行双侧红（宿主 错误码3/C0000005·v2 错误码3）=#980（引用返回
//     调用作成员链基座读/写双侧缺陷·独立任务）——dual 断言待 980 集成回补。
//   ②自由函数链式读 取点引用(p).x：宿主绿 / v2 C0000005 = #1274（不扩展）。
//   ③自由函数链式写 取点引用(p).x += 5：宿主静默丢（1260 分支已修面·
//     develop 宿主未含 1260 修复）——待 1260 集成后回补链式写断言。
类 点 {
公开:
    整32 x;
    整32 y;
}
函数 取点引用(点& p) -> 点& {
    返回 p;
}
类 计 {
公开:
    整32 总;
    函数 加(整32 v) {
        总 = 总 + v;
    }
    函数 读() -> 整32 {
        返回 总;
    }
}
函数 取计引用(计& c) -> 计& {
    返回 c;
}
函数 主() -> 整32 {
    // ① 结构体引用返回绑定+成员复合写（m06b 面·写须落原对象）
    点 p = 点();
    p.x = 1;
    p.y = 2;
    点& pr = 取点引用(p);
    pr.x += 5;
    打印(pr.x);
    打印(p.x);
    pr.y = 9;
    打印(p.y);
    // ② 直接绑定对照锚（本就正确·防修过扩）
    点& pr2 = p;
    pr2.x += 1;
    打印(p.x);
    // ③ 类引用返回绑定+方法接收者（m06c 面·方法须作用于原对象）
    计 c = 计();
    计& r = 取计引用(c);
    r.加(5);
    打印(r.读());
    打印(c.总);
    返回 0;
}
