// 1542_结果可选类值链式方法调（2026-10-25·#1611）：结果/可选<泛型类实例> 获取后
//   .值.方法() 链式调用双侧崩——
//   宿主：exprSrcType 的 MemberExpr 分支 结果/可选 载荷映射（118 轮新增）返回
//   载荷类型**文本形态**（字符串映射<整32>），未过泛型实例名物化
//   （resolveGenericInstanceType）；isClassType 按 $ 精确实例名查表恒 miss ->
//   handleClassCallExpr 未命中 -> 误走通用间接调用通道 -> 内部错误
//   （间接调用被调者类型串未解析 655 + 成员所属结构体类型未解析 648）。
//   落变量绿（g2 形态）证明类型信息链上可得，缺的是物化单点——与同文件
//   CallExpr 分支 845、结构体泛型容器字段分支同口径补齐。
//   v2：成员访问链上的方法调用（基=成员表达式而非标识符）对象类型传导缺失，
//   方法符号修饰落未定义引用（LNK1120）。
//   锁定：链式直调四形态逐值输出与落变量基线一致（宿主+v2 同 expected）。
//   覆盖：
//   1. 结果<字符串映射<整32>,整32> = 映射.获取(1) 后 外.值.获取("分") 链式
//   2. 同码落变量基线（层.获取）——两路输出须逐值一致
//   3. 可选<字符串映射<整32>> = 取表() 后 甲.值.获取("键") 链式
//   4. 同码落变量基线——两路输出须逐值一致
导入 映射集合::映射;
导入 映射集合::字符串映射;

函数 取表() -> 可选<字符串映射<整32>> {
    字符串映射<整32> t = 字符串映射<整32>();
    结果<空类型, 整32> w = t.设置("键", 41);
    如果 (!w.正常) { 返回 无; }
    返回 某些(t);
}

函数 主() -> 整32 {
    // 1. 双层映射：结果<类> 载荷链式方法调（根治前宿主内部错误/v2 链接失败）
    映射<整32, 字符串映射<整32>> 双 = 映射<整32, 字符串映射<整32>>();
    字符串映射<整32> 内 = 字符串映射<整32>();
    结果<空类型, 整32> w = 内.设置("分", 60);
    如果 (!w.正常) { 打印("设内败"); }
    w = 双.设置(1, 内);
    如果 (!w.正常) { 打印("设双败"); }
    结果<字符串映射<整32>, 整32> 外 = 双.获取(1);
    如果 (外.正常) {
        结果<整32, 整32> 分 = 外.值.获取("分");
        如果 (分.正常) { 打印(分.值); } 否则 { 打印("缺分"); }
    } 否则 { 打印("缺外"); }
    // 2. 同码落变量基线——链式与落变量两路逐值一致
    如果 (外.正常) {
        字符串映射<整32> 层 = 外.值;
        结果<整32, 整32> 分二 = 层.获取("分");
        如果 (分二.正常) { 打印(分二.值); } 否则 { 打印("缺分二"); }
    } 否则 { 打印("缺外二"); }
    // 3. 可选<类> 载荷链式方法调
    可选<字符串映射<整32>> 甲 = 取表();
    如果 (甲.有值) {
        结果<整32, 整32> 甲值 = 甲.值.获取("键");
        如果 (甲值.正常) { 打印(甲值.值); } 否则 { 打印("缺"); }
    } 否则 { 打印("无表"); }
    // 4. 同码落变量基线
    如果 (甲.有值) {
        字符串映射<整32> 乙 = 甲.值;
        结果<整32, 整32> 乙值 = 乙.获取("键");
        如果 (乙值.正常) { 打印(乙值.值); } 否则 { 打印("缺二"); }
    } 否则 { 打印("无表二"); }
    返回 0;
}
