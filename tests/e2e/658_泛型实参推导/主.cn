导入 核心::{最小, 最大};
导入 算法::线性查找;

函数 主() -> 整32 {
    整32[4] 值;
    值[0] = 10;
    值[1] = 20;
    值[2] = 30;
    值[3] = 40;
    打印(最小(3, 7));
    打印(最大(3, 7));
    // #1360 结果化：线性查找 返回 可选<整64>（裸名隐式推导调用形态不变），
    //   消费以 .有值 分流（否则 如果 显式枚举无值区间·else 新规）
    可选<整64> 查 = 线性查找(值, 4, 30);
    如果 (查.有值) {
        打印(查.值);
    } 否则 如果 (!查.有值) {
        打印("意外无值");
    }
    返回 0;
}
