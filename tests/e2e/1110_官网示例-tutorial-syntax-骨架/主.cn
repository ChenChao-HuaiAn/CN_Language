//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
// 单行注释
/* 块注释，支持嵌套 /* 像这样 */ */

静态 整32 全局计数 = 0;      // 全局静态变量（零初始化）

不安全 函数 主() -> 整32 {    // 静态变量写=不安全操作（进阶篇·安全区边界）
    全局计数 = 全局计数 + 1;
    打印("计数：", 全局计数);
    返回 0;                   // 0 = 成功
}