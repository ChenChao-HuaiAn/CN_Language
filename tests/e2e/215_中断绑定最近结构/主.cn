// E2E 215（2026-09-11 第七十二轮 72-b，用户裁决方案B·C 语义）：中断 绑定
//   **最近进入**的选择或循环（谁近绑谁）——原实现 loopStack_ 恒优先，循环内
//   选择体的 中断 误吞整个循环（探针 88 与 C 对照实测：C 的 break 只跳出
//   switch、循环继续；原实现直接终止循环=静默逻辑错误）。存量代码该形态
//   扫描=0 处（tests/stdlib/v1 树/v2 树全量），迁移零影响。
//   四场景锚定：
//     ① 循环内选择体的 中断=只跳出选择（C 语义核心，5 轮全跑）；
//     ② 嵌套链（外循环→选择→内循环）：内循环里的 中断=绑内循环、选择分支尾的
//        中断=绑选择——enterSeq 序号比较的两种方向；
//     ③ 无循环包裹的选择体 中断=跳出选择（行为不变锚定）；
//     ④ 循环体裸 中断=跳出循环（既有语义回归锚定）。
导入 IO::打印;

函数 场景一() -> 整32 {
    整32 轮 = 0;
    循环 (整32 i = 0; i < 5; i++) {
        选择 (i) {
            情况 1:
                打印("  命中1");
                中断;
            默认:
                打印("  其他:", i);
        }
        打印("本轮收尾 i=", i);
        轮++;
    }
    返回 轮;
}

函数 场景二() -> 整32 {
    整32 计 = 0;
    循环 (整32 i = 0; i < 3; i++) {
        选择 (i) {
            情况 0:
                循环 (整32 j = 0; j < 10; j++) {
                    计++;
                    如果 (j >= 1) { 中断; }
                }
                打印("  内层跳出后计=", 计);
                中断;
            默认:
                打印("  外层其他:", i);
        }
        打印("  外层收尾 i=", i);
    }
    返回 计;
}

函数 场景三() -> 整32 {
    整32 r = 0;
    选择 (2) {
        情况 1:
            r = 10;
            中断;
        情况 2:
            r = 20;
            打印("  场景三命中2");
            中断;
        默认:
            r = 99;
    }
    返回 r;
}

函数 场景四() -> 整32 {
    整32 n = 0;
    循环 (整32 i = 0; i < 100; i++) {
        n++;
        如果 (n >= 3) { 中断; }
    }
    返回 n;
}

函数 主() -> 整32 {
    打印("① 循环内选择体中断=只跳出选择，轮数:", 场景一());
    打印("② 嵌套链（内循环中断绑内循环/分支尾中断绑选择），计:", 场景二());
    打印("③ 无循环选择中断，r=", 场景三());
    打印("④ 循环裸中断，n=", 场景四());
    返回 0;
}
