// E2E 1334（双编译对照·933 销项）：字符串值接收引用返回调用双侧根治——
//   引用返回字符串调用（被调返回 字符串&）作**右值读值消费**的全形态矩阵：
//     ①声明接收=拥有化深拷独立副本（源改名后副不变·块出口残留==0）
//     ②赋值接收=free 旧 + copy 落堆独立（内容真·残留==0）
//     ③返回位（返回 b.读名(); 深拷落堆·跨函数调用方独立拥有·残留==0）
//     ④链式（字符串长度/拼接/内建比较/值形参传参）
//     ⑤比较运算符 ==/!=/<（962 内容比较·"调用"操作数形态）
//     ⑥下标 b.读名()[0]（UTF-8 字节视图·宿主/v2 同码点）
//     ⑦地址语义防回归（1032 面）：字符串& 别名绑定跟随源改名 + 直接写回
//   修前（933 探针实况）：v2 方法调用引用返回不解引用（rax=被引用左值地址被
//   当句柄：副≠源内容·长度=5/拼接=垃圾）；宿主拥有位（声明/赋值/返回）缺
//   深拷（浅拷共享·源改名后悬垂读空）+ 比较面 isStringTypedExpr 不覆盖调用
//   （== 落地址比较恒假·v2 侧语义层对方法调用返回=整64 兜底致比较/下标误拒）。
//   修后双侧同值同账。校验和折位（878/1032 同款口径·块出口 内存::活动分配数()
//   差==0）；退出码=校验和（127）。恒等语义=双侧运行逐行同：
//   宿主/ v2 各编各跑，退出码与打印输出双侧一致（dual 通道锚退出码）。
类 盒 {
公开:
    字符串 名;
    函数 盒() { 名 = 字符串复制("盒名"); }
    函数 读名() -> 字符串& {
        返回 名;
    }
    函数 改名(字符串 新名) -> 空类型 { 名 = 新名; }
}
函数 取局部() -> 字符串 {
    盒 b;
    返回 b.读名();
}
函数 取串(字符串 s) -> 整32 {
    返回 整32(字符串长度(s));
}
不安全 函数 主() -> 整32 {
    整32 校验 = 0;
    // ① 声明接收=深拷副本独立（源改名后副保持原值·残留==0）
    整64 b1 = 内存::活动分配数();
    布尔 内1 = 假;
    布尔 独1 = 假;
    {
        盒 b;
        字符串 副 = b.读名();
        内1 = 字符串比较(副, "盒名");
        b.改名(字符串复制("新盒"));
        独1 = 字符串比较(副, "盒名");
    }
    如果 (内1 && 独1 && 内存::活动分配数() - b1 == 0) { 校验 = 校验 + 1; }
    // ② 赋值接收=free 旧+copy（残留==0）
    整64 b2 = 内存::活动分配数();
    布尔 内2 = 假;
    {
        盒 b;
        字符串 副 = 字符串复制("旧值");
        副 = b.读名();
        内2 = 字符串比较(副, "盒名");
    }
    如果 (内2 && 内存::活动分配数() - b2 == 0) { 校验 = 校验 + 2; }
    // ③ 返回位（跨函数返回 字符串 拥有契约·残留==0）
    整64 b3 = 内存::活动分配数();
    布尔 内3 = 假;
    {
        字符串 返 = 取局部();
        内3 = 字符串比较(返, "盒名");
    }
    如果 (内3 && 内存::活动分配数() - b3 == 0) { 校验 = 校验 + 4; }
    // ④⑤⑥⑦ 链式/比较/下标/地址语义（同块）
    {
        盒 b;
        布尔 链式 = (字符串长度(b.读名()) == 6) &&
                    字符串比较(b.读名() + "后", "盒名后") &&
                    字符串比较(b.读名(), "盒名") &&
                    (取串(b.读名()) == 6);
        如果 (链式) { 校验 = 校验 + 8; }
        布尔 比较 = (b.读名() == "盒名") && (b.读名() != "盒宁") &&
                    (b.读名() < "盒宁");
        如果 (比较) { 校验 = 校验 + 16; }
        字符 首 = b.读名()[0];
        如果 (整32(首) == -25) { 校验 = 校验 + 32; }
        字符串& 别 = b.读名();
        b.改名(字符串复制("新盒"));
        布尔 跟随 = 字符串比较(别, "新盒");
        b.读名() = 字符串复制("写穿");
        如果 (跟随 && 字符串比较(b.读名(), "写穿")) { 校验 = 校验 + 64; }
    }
    打印行("校验=", 校验);
    返回 校验;
}
