// 1503 循环累积静态方法引用逃逸（750 复审 P0-A-3·双编译对照）
//   病：检查方法借用纪律202 对 `是类静态方法` 提前 return——`工具.记(槽,s)` 的
//   引用实参 s 隐式取址未登记逃逸；循环内经字段指针间接写 s → v2 单侧优化后
//   写穿被出口 finish 覆盖（宿主 wrapRefArgs 覆盖故正确）。
//   修：删除该提前 return（静态方法无 this，参数映射天然成立）。
// 预期：S=xZxZ。
结构体 盒 {
    字符串* 指;
}

类 工具 {
公开:
    函数 工具() { }
    静态 函数 记(盒& 槽, 字符串& 参) -> 整32 {
        槽.指 = &参;
        返回 0;
    }
}

不安全 函数 写改(盒& 目标, 字符串 段) -> 整32 {
    *目标.指 = *目标.指 + 段;
    返回 0;
}

不安全 函数 主() -> 整32 {
    字符串 s = "";
    盒 槽 = 盒{ 指 = 无 };
    工具.记(槽, s);
    循环 (整64 k = 0; k < 2; k++) {
        s = s + "x";
        写改(槽, "Z");
    }
    打印("S=", s);
    返回 0;
}
