// 639（021 任务 272·正测锁定）：栈 弹出 字符串/类（带拷贝构造）元素 生命周期 dual 锁——
//   串=值副本语义（泄漏=0）·类=盒亡析构副本（116/182 口径：弹出后析构 0·块尾 2）。
导入 容器::栈;
静态 整64 析构数 = 0;
类 资源 {
公开:
    整64 编号;
    函数 资源(整64 v) { 编号 = v; }
    函数 资源(资源& 其他) { 编号 = 其他.编号; }
    不安全 函数 ~资源() { 析构数 = 析构数 + 1; }
}
不安全 函数 主() -> 整32 {
    整64 前 = 内存::活动分配数();
    {
        栈<字符串> 表 = 栈<字符串>();
        字符串 甲 = 字符串复制("AAAAAAAAAAAAAAAAAAAA");
        结果<空类型, 整32> 压 = 表.压入(甲);
        如果 (压.正常) {
            结果<字符串, 整32> 弹 = 表.弹出();
            如果 (弹.正常) { 打印("串弹值=", 弹.值); } 否则 { 返回 2; }
        } 否则 { 返回 1; }
    }
    {
        栈<资源> 表 = 栈<资源>();
        资源 甲 = 资源(7);
        结果<空类型, 整32> 压 = 表.压入(甲);
        如果 (压.正常) {
            结果<资源, 整32> 弹 = 表.弹出();
            如果 (弹.正常) { 打印("类弹编号=", 弹.值.编号); } 否则 { 返回 4; }
        } 否则 { 返回 3; }
    }
    打印("析构数=", 析构数);
    打印("泄漏=", 内存::活动分配数() - 前);
    返回 0;
}
