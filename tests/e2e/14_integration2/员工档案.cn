// Task 完善集成验证 E2E 测试：员工档案管理系统
// 覆盖：将三个完善子任务的功能串联到生产链路组合使用：
//   完善A：i128 完整支持 + 结构体按值传参/返回 + 结构体整体赋值
//   完善B：字符串 13 API（子串/大写/小写/trim/反转/数字转字符串/字典序等）
//   完善C：优化器增强（代数简化/CSE/复写传播/跨块DCE/全局值传播）
// 组合覆盖点：
//   1. 大结构体（>8B）含 i128 字段 + 字符串字段 + 数组字段：按值传参/返回（隐藏指针）
//   2. 小结构体（8B）按值传参/返回（寄存器）
//   3. 结构体整体赋值（含 i128/字符串/数组字段）+ 整体赋值排序交换数组元素
//   4. i128 大数运算（乘法/除法/取余/负数）+ 打印行多参数含 i128
//   5. 字符串 API 与结构体字段、数组、指针组合（姓名处理）
//   6. 优化器 Pass 在真实程序上 -O0/-O1/-O2/-O3 输出一致（规格书12.4）
// 语法依据（cn-language-spec 02/03/04/05 + 规格书8.1 Win x64 ABI）：
//   结构体按值传参/返回 ≤8B 走寄存器、>8B 调用方栈分配传隐藏指针；
//   i128 双寄存器模型 + 运行时辅助函数；字符串动态分配需 字符串释放

// ==================== 类型定义 ====================

// 大结构体（>8B，总大小48B）：i128 字段 + 字符串字段 + 数组字段
// 布局（C风格对齐）：编号0(4B) + 填充4 -> 姓名8(8B) -> 年薪16(16B) -> 季度奖金32(12B) -> 对齐16 -> 48B
结构体 员工档案 {
    整32 编号
    字符串 姓名
    整128 年薪
    整32[3] 季度奖金
}

// 小结构体（8B）：寄存器传递（Win x64 分类：两个整32 合一 8B 寄存器）
结构体 点对 {
    整32 x
    整32 y
}

// ==================== 结构体按值传参/返回（含 i128 字段） ====================

// 大结构体按值传参：求季度奖金总和（读取数组字段，循环累加）
函数 求总奖金(员工档案 档案) -> 整32 {
    整32 总额 = 0
    循环 (整32 i = 0; i < 3; i++) {
        总额 = 总额 + 档案.季度奖金[i]
    }
    返回 总额
}

// 大结构体按值传参 + 返回：年薪总额 = 年薪 + 总奖金（i128 与 整32 混合运算宽化）
函数 年薪总额(员工档案 档案) -> 整128 {
    整128 总额 = 档案.年薪
    总额 = 总额 + 求总奖金(档案)
    返回 总额
}

// 大结构体按值传参 + 返回结构体：调整年薪（整体赋值 + i128 加法）
函数 调整年薪(员工档案 档案, 整128 增幅) -> 员工档案 {
    员工档案 出 = 档案        // 结构体整体赋值（含 i128/字符串/数组字段）
    出.年薪 = 出.年薪 + 增幅
    返回 出
}

// i128 除法/取余：按月薪拆分（大数运算）
函数 月薪(整128 年薪) -> 整128 {
    返回 年薪 / 12LL
}

函数 年薪取余(整128 年薪) -> 整128 {
    返回 年薪 % 12LL
}

// 小结构体（8B）按值传参/返回：坐标偏移（寄存器传递）
函数 偏移(点对 点, 整32 dx, 整32 dy) -> 点对 {
    返回 点对{ x = 点.x + dx, y = 点.y + dy }
}

// ==================== 字符串 API 与结构体组合 ====================

// 读取结构体字符串字段 + 字符串大写（返回动态内存，调用方负责 字符串释放）
函数 姓名大写(员工档案 档案) -> 字符串 {
    返回 字符串大写(档案.姓名)
}

// 读取结构体字符串字段 + 字符串反转（返回动态内存，调用方负责 字符串释放）
函数 姓名反转(员工档案 档案) -> 字符串 {
    返回 字符串反转(档案.姓名)
}

// ==================== 结构体整体赋值排序（CopyStruct 交换数组元素） ====================

// 冒泡排序：按年薪升序，整体赋值交换数组元素（含 i128/字符串/数组字段的48B结构体）
函数 按年薪排序(员工档案* 名单, 整32 人数) {
    循环 (整32 i = 0; i < 人数 - 1; i++) {
        循环 (整32 j = 0; j < 人数 - 1 - i; j++) {
            如果 (名单[j].年薪 > 名单[j + 1].年薪) {
                员工档案 临时 = 名单[j]
                名单[j] = 名单[j + 1]
                名单[j + 1] = 临时
            }
        }
    }
}

// ==================== 主函数 ====================

函数 主() -> 整32 {
    打印("===== 员工档案管理系统（完善功能集成验证）=====")

    // ---- 1. 结构体数组初始化（i128 字段字面量 + 字符串字段 + 数组字段） ----
    员工档案[3] 员工 = {
        员工档案{ 编号 = 1, 姓名 = "张三", 年薪 = 1200000000000000000LL, 季度奖金 = { 100000, 200000, 300000 } },
        员工档案{ 编号 = 2, 姓名 = "李四", 年薪 = 900000000000000000LL, 季度奖金 = { 50000, 80000, 120000 } },
        员工档案{ 编号 = 3, 姓名 = "王五", 年薪 = 1500000000000000000LL, 季度奖金 = { 200000, 250000, 400000 } }
    }

    // ---- 2. 原始档案打印（打印行多参数含 i128 字段） ----
    打印("---- 原始档案 ----")
    循环 (整32 i = 0; i < 3; i++) {
        打印("员工", 员工[i].编号, ": ", 员工[i].姓名)
        打印("  年薪: ", 员工[i].年薪)
    }

    // ---- 3. 大结构体按值传参（i128 字段 + 数组字段） ----
    打印("---- 按值传参 ----")
    整128 李四总额 = 年薪总额(员工[1])
    打印("李四年薪总额: ", 李四总额)
    整32 李四奖金 = 求总奖金(员工[1])
    打印("李四总奖金: ", 李四奖金)

    // ---- 4. 结构体按值传参 + 返回（i128 运算，不修改原对象） ----
    打印("---- 调整年薪（按值返回）----")
    员工档案 调后 = 调整年薪(员工[0], 250000000000000000LL)
    打印("调后年薪: ", 调后.年薪)
    打印("原年薪: ", 员工[0].年薪)

    // ---- 5. i128 大数运算（除法/取余/负数/乘法） ----
    打印("---- i128 大数运算 ----")
    整128 月薪值 = 月薪(调后.年薪)
    打印("调后月薪: ", 月薪值)
    整128 余值 = 年薪取余(调后.年薪)
    打印("调后取余: ", 余值)
    整128 负补贴 = -5000000000000LL
    打印("负补贴: ", 负补贴)
    打印("负补贴*2: ", 负补贴 * 2LL)
    整128 乘数1 = 2000000000LL
    整128 乘数2 = 3000000000LL
    打印("2000000000*3000000000: ", 乘数1 * 乘数2)

    // ---- 6. 结构体整体赋值（含 i128/字符串/数组字段）+ 修改隔离 ----
    打印("---- 结构体整体赋值 ----")
    员工档案 王五副本 = 员工[2]
    打印("副本年薪: ", 王五副本.年薪)
    王五副本.年薪 = 999999999999999999LL
    王五副本.季度奖金[0] = 1
    打印("改副本后原年薪: ", 员工[2].年薪)
    打印("改副本后原奖金[0]: ", 员工[2].季度奖金[0])

    // ---- 7. 结构体整体赋值排序（CopyStruct 交换 48B 结构体数组元素） ----
    打印("---- 按年薪排序后 ----")
    按年薪排序(员工, 3)
    循环 (整32 k = 0; k < 3; k++) {
        打印("员工", 员工[k].编号, ": ", 员工[k].姓名, " 年薪: ", 员工[k].年薪)
    }

    // ---- 8. 小结构体寄存器传参/返回 ----
    打印("---- 小结构体寄存器传参 ----")
    点对 原 = 点对{ x = 1, y = 2 }
    点对 移后 = 偏移(原, 10, 20)
    打印("移后: ", 移后.x, " ", 移后.y)
    打印("原: ", 原.x, " ", 原.y)

    // ---- 9. 字符串 API 与结构体字段、数组、指针组合（姓名处理） ----
    打印("---- 字符串 API 组合 ----")
    字符串 大写 = 姓名大写(员工[0])
    打印("姓名大写: ", 大写)
    字符串释放(大写)
    字符串 反转 = 姓名反转(员工[0])
    打印("姓名反转: ", 反转)
    字符串释放(反转)
    打印行整数(字符串字典序(员工[0].姓名, 员工[1].姓名))
    打印行整数(字符串字典序(员工[0].姓名, 员工[0].姓名))
    字符串 编号串 = 整数转字符串(员工[0].编号)
    打印("编号转字符串: ", 编号串)
    字符串释放(编号串)
    字符串 剪 = 字符串修剪("  员工名单  ")
    打印("修剪: ", 剪)
    字符串释放(剪)
    字符串 子 = 字符串子串("HelloWorld", 5, 5)
    打印("子串: ", 子)
    字符串释放(子)
    如果 (字符串前缀("hello", "he")) { 打印("前缀:真") } 否则 { 打印("前缀:假") }
    如果 (字符串后缀("hello", "lo")) { 打印("后缀:真") } 否则 { 打印("后缀:假") }
    如果 (字符串包含("hello", "ell")) { 打印("包含:真") } 否则 { 打印("包含:假") }
    字符串 英大 = 字符串大写("hello")
    打印("英文大写: ", 英大)
    字符串释放(英大)
    字符串 英小 = 字符串小写("WORLD")
    打印("英文小写: ", 英小)
    字符串释放(英小)
    字符串 浮串 = 浮点转字符串(3.5)
    打印("浮点转字符串: ", 浮串)
    字符串释放(浮串)
    字符串 字串 = 字符转字符串('A')
    打印("字符转字符串: ", 字串)
    字符串释放(字串)

    // ---- 10. 优化器 Pass 在真实程序上的效果（输出与 -O0 一致） ----
    打印("---- 优化器验证 ----")
    // 块内 CSE：相同模式计算两次 -> 复用第一次结果
    整32 基础 = 100
    整32 cse1 = 基础 * 2 + 1
    整32 cse2 = 基础 * 2 + 1
    打印("CSE: ", cse1, " ", cse2)
    // 跨块 DCE：恒真条件 -> 假分支不可达（-O2 下删除）
    如果 (真) {
        打印("跨块DCE: 真分支存活")
    } 否则 {
        打印("跨块DCE: 假分支不可达")
    }
    // 代数简化：x+0 / x*1 / x*0
    变量 x = 42
    打印("代数简化 x+0: ", x + 0)
    打印("代数简化 x*1: ", x * 1)
    打印("代数简化 x*0: ", x * 0)
    // 复写传播：Store -> Load 转发
    变量 源 = 100
    变量 目标 = 源
    打印("复写传播: ", 目标)
    // 全局值传播：常量 Store -> Load 转发（跨块安全子集）
    变量 全 = 7
    全 = 8
    打印("全局传播: ", 全)
    // 死代码（结果未使用，-O1 起 DCE 删除）
    变量 死1 = 100
    变量 死2 = 200
    死1 + 1;
    死2 * 2;
    打印("DCE后: ", 死1, " ", 死2)

    // ---- 11. 字符串连接链 + API（内存释放验证） ----
    打印("---- 字符串连接链 ----")
    字符串 链 = 员工[0].姓名 + " 年薪 " + 整数转字符串(12345)
    打印("连接链: ", 链)
    字符串释放(链)

    打印("===== 档案系统报告完成 =====")
    返回 0
}
