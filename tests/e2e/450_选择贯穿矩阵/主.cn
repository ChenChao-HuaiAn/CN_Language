// 450 选择贯穿矩阵（413-a D44 正体收口+D45 贯穿恒真根治 防线）
// 覆盖：贯穿恒真防回归（w=2 不匹配 case1）/贯穿直落（无 中断 落下一情况）/
//       中断跳选择出口（最近绑定：当内选择的中断不跳当出口）/默认分支匹配与
//       不匹配两态/字符串情况值/无匹配无默认直落出口
// 413-a 前缺陷形态：v2 选择条件槽未初始化判恒真（贯穿恒真·asm [rbp-8] 无写铁证）
函数 主() -> 整32 {
    // ① 恒真防回归：w=2 只匹配 情况 2（413-a 前 v2 输出「一二」恒真）
    整32 w = 2;
    选择 (w) {
        情况 1:
            打印("一");
            中断;
        情况 2:
            打印("二");
            中断;
    }
    // ② 贯穿直落：v=1 匹配 情况 1（无 中断）落入 情况 2；情况 2 中断跳出
    整32 v = 1;
    选择 (v) {
        情况 1:
            打印("甲一");
        情况 2:
            打印("甲二");
            中断;
        情况 3:
            打印("甲三");
            中断;
    }
    // ③ 默认：a=5 不匹配 → 默认；b=9 不匹配 情况 1 → 默认
    整32 a = 5;
    选择 (a) {
        情况 1:
            打印("乙一");
        默认:
            打印("乙默认");
    }
    // ④ 嵌套最近绑定：当 内 选择 的 中断 跳选择出口（不跳当出口）——
    //    「未中断」每次都打印=中断未误跳 当 出口
    整32 循 = 0;
    当 (循 < 2) {
        选择 (循) {
            情况 0:
                打印("丙零");
                中断;
            情况 1:
                打印("丙一");
                中断;
        }
        打印("未中断");
        循 = 循 + 1;
    }
    // ⑤ 字符串情况值（__cn_str_eq 比较）
    字符串 s = "你好";
    选择 (s) {
        情况 "你好":
            打印("串一");
            中断;
        情况 "世界":
            打印("串二");
            中断;
    }
    返回 0;
}
