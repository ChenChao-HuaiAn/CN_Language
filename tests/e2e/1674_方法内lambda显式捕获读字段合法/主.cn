// 1674（#1178 锁面·正例·001 §lambda 捕获条〔通告〕）：方法内 lambda 捕获类
//   字段合法面四形态——[=] 值捕获（字段值快照）/[&] 引用捕获（读写穿最新）/
//   [字段名] 显式捕获（定义处字段值快照）/[] 空体与读全局（符号直读非环境
//   捕获·C++ 同规）。修复前字段名落 IR 槽 miss=快照槽不登记+调用点实参垃圾；
//   修复后快照源=this 槽+字段地址（值捕获加载字段值·[&] 字段地址直存）。
整32 全局计数 = 100;
类 袋 {
    整32 基 = 10;
公开:
    函数 值捕获读() -> 整32 {
        变量 f = [=]() -> 整32 { 返回 基 + 1; };
        返回 f();                       // 11（值快照 10+1）
    }
    函数 引用捕获写() -> 整32 {
        变量 g = [&]() -> 整32 { 基 = 基 + 5; 返回 基; };
        返回 g();                       // 15（[&] 写穿·基 变 15）
    }
    函数 显式捕获读() -> 整32 {
        变量 h = [基]() -> 整32 { 返回 基 * 2; };
        返回 h();                       // 30（定义处字段值快照=15·非 20）
    }
    函数 空体与全局() -> 整32 {
        变量 k = []() -> 整32 { 返回 7; };          // [] 空体=零环境依赖合法
        变量 m = []() -> 整32 { 返回 全局计数; };   // [] 读全局=符号直读合法
        返回 k() + m() - 7;             // 100
    }
}
函数 主() -> 整32 {
    袋 b;
    打印(b.值捕获读());
    打印(b.引用捕获写());
    打印(b.显式捕获读());
    打印(b.空体与全局());
    打印(全局计数);
    返回 0;
}
