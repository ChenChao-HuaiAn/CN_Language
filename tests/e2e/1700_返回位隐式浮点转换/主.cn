// E2E 1700_返回位隐式浮点转换（001 §3.7 隐式转换·返回位）
// 缺陷背景（1103 采样轮 pR1 根治·#1995）：v2 返回语句位缺隐式浮点转换——
//   `-> 浮64` 函数/方法 返回 整表达式 时，返回槽按浮点 ABI 直读整数位模式，
//   宿主 9.000000 / v2 0.000000（静默错值）。本用例锁定四条返回位形态：
//   ① 接口虚分派（单实现=去虚拟化直调）浮64 返回 整表达式；
//   ② 普通函数 浮64 返回 整变量表达式；
//   ③ 浮32 返回 整字面量（整→浮32）；
//   ④ 浮64 返回 浮32 变量（浮32→浮64 宽化）；
//   ⑤ 方法值蹦床（?mvtrap）浮64 返回通道（返回类型码随声明透传 xmm0）。
//   ⑥ 多实现接口（全局槽位间接分派·无去虚拟化）浮64 返回 整表达式。
// 双编译对照：宿主+v2p 同源码编译运行·stdout 逐行比对 .expected。
接口 可画 {
    虚拟 函数 画() -> 整32;
}

接口 可算 {
    虚拟 函数 面积() -> 浮64;
}

类 方块 : 可画, 可算 {
公开:
    整32 边;
    函数 方块(整32 s) { 边 = s; }
    重写 函数 画() -> 整32 { 返回 边; }
    重写 函数 面积() -> 浮64 { 返回 边 * 边; }
}

接口 可测 {
    虚拟 函数 周界() -> 浮64;
}

类 方形 : 可测 {
公开:
    整32 边长;
    函数 方形(整32 s) { 边长 = s; }
    重写 函数 周界() -> 浮64 { 返回 边长 * 4; }
}

类 矩形 : 可测 {
公开:
    整32 宽;
    整32 高;
    函数 矩形(整32 w, 整32 h) { 宽 = w; 高 = h; }
    重写 函数 周界() -> 浮64 { 返回 (宽 + 高) * 2; }
}

函数 宽返() -> 浮64 {
    整32 甲 = 3;
    返回 甲 * 甲;
}

函数 窄返() -> 浮32 {
    返回 7;
}

函数 升返() -> 浮64 {
    浮32 半 = 1.5f;
    返回 半;
}

// #1995 兜底收口锁面：自增表达式产物原先不登记寄存器类型（「二元算术产物不登记」
//   惯例残留）——现已在本族发射点补登记（登记表=唯一权威，无 T_未知 默认）。
//   浮32 变量自增返回 浮64 须走 cvtss2sd；整32 自增同源走 cvtsi2sd。
函数 浮32后增返() -> 浮64 { 浮32 半 = 1.5f; 返回 半++; }
函数 浮32前增返() -> 浮64 { 浮32 半 = 1.5f; 返回 ++半; }
函数 整32后增返() -> 浮64 { 整32 甲 = 3; 返回 甲++; }

类 量 {
公开:
    浮64 基数;
    函数 量(浮64 b) { 基数 = b; }
    函数 翻倍(整32 x) -> 浮64 { 返回 基数 + x; }
}

函数 主() -> 整32 {
    方块 方 = 方块(3);
    可画 画者 = 方;
    打印(画者.画());
    可算 算者 = 方;
    打印(算者.面积());
    打印(宽返());
    打印(窄返());
    打印(升返());
    量 甲 = 量(100.0);
    变量 cb = 甲.翻倍;
    打印(cb(5));
    可测 方周 = 方形(3);
    打印(方周.周界());
    可测 矩周 = 矩形(4, 6);
    打印(矩周.周界());
    打印(浮32后增返());
    打印(浮32前增返());
    打印(整32后增返());
    返回 0;
}
