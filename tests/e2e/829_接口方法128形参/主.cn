// E2E 829 接口方法 × 128 形参（552·双侧同案根治）
// 现象（442 轮呈报 ab7364aa）：接口方法 × 整128/正128 形参双侧 SIGSEGV——
//   宿主接口路径缺 128 实参定标（窄实参按 i64 值直传·被调 prologue 按双槽
//   地址 rep movsb 解引用崩）；v2 接口路径无实参回扫（同形态崩）。单侧修复
//   反造分叉 → 本任务双侧同案根治（判据单一归属：宿主 widenI128Args /
//   v2 回扫结构体与引用实参 表驱动）。
// 本用例（dual·两侧同源码编译运行·stdout 逐行比对）：
//   A. 单实现（去虚拟化直调路径）× 整128 形参 五实参形态：窄32 变量/
//      窄32 字面量/已128 变量/已128 字面量/128 算术表达式——值断言；
//   B. 单实现 × 正128 形参：窄字面量/已正128 变量；
//   C. 多实现（B1 全局槽位间接分派路径）× 整/正128：甲恒等/乙+1 值断言
//      （双实现类防去虚拟化·间接分派契约锚定）；
//   D. 整128 引用形参（整128& × 已128 变量——实参句柄即左值地址）：
//      直调与间接两路径。
接口 盒 {
    虚拟 函数 取整(整128 值) -> 整128;
    虚拟 函数 取正(正128 值) -> 正128;
    虚拟 函数 取整引用(整128& 值) -> 整128;
}

接口 双盒 {
    虚拟 函数 取整2(整128 值) -> 整128;
    虚拟 函数 取正2(正128 值) -> 正128;
    虚拟 函数 取整引用2(整128& 值) -> 整128;
}

类 甲 : 盒, 双盒 {
公开:
    函数 甲() {}
    重写 函数 取整(整128 值) -> 整128 { 返回 值; }
    重写 函数 取正(正128 值) -> 正128 { 返回 值; }
    重写 函数 取整引用(整128& 值) -> 整128 { 返回 值; }
    重写 函数 取整2(整128 值) -> 整128 { 返回 值; }
    重写 函数 取正2(正128 值) -> 正128 { 返回 值; }
    重写 函数 取整引用2(整128& 值) -> 整128 { 返回 值; }
}

类 乙 : 双盒 {
公开:
    函数 乙() {}
    重写 函数 取整2(整128 值) -> 整128 { 返回 值 + 1LL; }
    重写 函数 取正2(正128 值) -> 正128 { 返回 值 + 1ULL; }
    重写 函数 取整引用2(整128& 值) -> 整128 { 返回 值 + 1LL; }
}

函数 主() -> 整32 {
    打印("===== 829 接口方法 × 128 形参 =====");
    // ---- A. 单实现（去虚拟化直调）× 整128 形参 五实参形态 ----
    盒 单 = 甲();
    整32 窄 = 42;
    整128 大 = 170141183460469231731687303715884105727LL;   // 2^127-1
    整128 中 = 10000000000000000000LL;                        // 10^19
    打印("A1 窄32变量: ");
    打印(单.取整(窄));                        // 42
    打印("A2 窄32字面量: ");
    打印(单.取整(42));                        // 42
    打印("A3 已128变量: ");
    打印(单.取整(大));                        // 2^127-1
    打印("A4 已128字面量: ");
    打印(单.取整(10000000000000000000LL));    // 10^19
    打印("A5 128算术表达式: ");
    打印(单.取整(中 + 1LL));                  // 10^19+1
    // ---- B. 单实现（去虚拟化直调）× 正128 形参 ----
    正128 正大 = 10000000000000000000ULL;     // 10^19
    打印("B1 正128窄字面量: ");
    打印(单.取正(7));                         // 7
    打印("B2 正128已变量: ");
    打印(单.取正(正大));                      // 10^19
    // ---- C. 多实现（间接分派）× 整/正128 ----
    双盒 二乙 = 乙();
    打印("C1 乙整128窄实参: ");
    打印(二乙.取整2(50));                     // 51
    打印("C2 乙整128已变量: ");
    打印(二乙.取整2(中));                     // 10^19+1
    打印("C3 乙正128窄实参: ");
    打印(二乙.取正2(7));                      // 8
    打印("C4 乙正128已变量: ");
    打印(二乙.取正2(正大));                   // 10^19+1
    // ---- D. 整128 引用形参（整128& 已128 变量）----
    打印("D1 直调128&: ");
    打印(单.取整引用(大));                    // 2^127-1
    打印("D2 间接128&: ");
    打印(二乙.取整引用2(中));                 // 10^19+1
    // ---- E. 交叉校验：两接口变量同值断言（防分派错派） ----
    打印("E1 甲直调整: ");
    打印(单.取整(中));                        // 10^19
    打印("E2 乙双盒整: ");
    打印(二乙.取整2(中));                     // 10^19+1
    打印("===== 完成 =====");
    返回 0;
}
