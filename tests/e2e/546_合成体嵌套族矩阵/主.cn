// 546 合成体嵌套族矩阵（067-002 同族清偿）：可选<字符串>/可选<结构体>/结果×可选
//   交叉/四层可选——067-001（宿主布局递归收口）与 067-003（v2 尺寸链同构）的
//   同族扩散面验证。543 = 类载荷主线；本用例 = 非类载荷与交叉形态。
类 盒子 {
    公开:
    整32 值;
    函数 盒子() { 值 = 5; }
    函数 盒子(盒子& 其他) { 值 = 其他.值; }
}

结构体 点 {
    整32 甲;
    整32 乙;
}

函数 主() -> 整32 {
    // ① 可选<可选<字符串>>（字符串载荷=所有权/析构面）
    可选<可选<字符串>> s1 = 某些(某些("嵌套串"));
    如果 (s1.有值) {
        可选<字符串> i1 = s1.值;
        如果 (i1.有值) { 打印行("A=", i1.值); }
    }
    // ② 可选<可选<点>>（POD 结构体载荷=值语义本体面）
    可选<可选<点>> p1 = 某些(某些(点{ 甲 = 7, 乙 = 8 }));
    如果 (p1.有值) {
        可选<点> i2 = p1.值;
        如果 (i2.有值) {
            点 pp = i2.值;
            打印行("B=", pp.甲, pp.乙);
        }
    }
    // ③ 结果<可选<整32>, 整32>（结果包可选）
    结果<可选<整32>, 整32> r1 = 正常(某些(9));
    如果 (r1.正常) {
        可选<整32> i3 = r1.值;
        如果 (i3.有值) { 打印行("C=", i3.值); }
    } 否则 {
        打印行("C=外层错误");
    }
    // ④ 可选<结果<整32, 整32>>（可选包结果）
    可选<结果<整32, 整32>> o1 = 某些(正常(11));
    如果 (o1.有值) {
        结果<整32, 整32> i4 = o1.值;
        如果 (i4.正常) {
            打印行("D=", i4.值);
        } 否则 {
            打印行("D=内层错误");
        }
    }
    // ⑤ 四层可选（链式拆包）
    可选<可选<可选<可选<整32>>>> q1 = 某些(某些(某些(某些(13))));
    如果 (q1.有值) {
        可选<可选<可选<整32>>> j1 = q1.值;
        如果 (j1.有值) {
            可选<可选<整32>> j2 = j1.值;
            如果 (j2.有值) {
                可选<整32> j3 = j2.值;
                如果 (j3.有值) { 打印行("E=", j3.值); }
            }
        }
    }
    // ⑥ 可选<可选<盒子>>（类载荷嵌套·543 同族回归位）
    可选<可选<盒子>> c1 = 某些(某些(盒子()));
    如果 (c1.有值) {
        可选<盒子> k1 = c1.值;
        如果 (k1.有值) {
            盒子 b = k1.值;
            打印行("F=", b.值);
        }
    }
    返回 0;
}
