// 487：函数指针全链矩阵（T69·480-a 深度机）——宿主+v2 双编译对照
//   形态：局部变量位 / 赋值位 / 形参位 / 函数名作实参 / 函数指针变量作实参 /
//         结构体指针签名 / 无参签名 / 间接调用返回值再存储 / 多次换靶
结构体 学生 {
    字符串 名字;
    整32 分数;
}

函数 加一(整32 v) -> 整32 {
    返回 v + 1;
}

函数 减一(整32 v) -> 整32 {
    返回 v - 1;
}

函数 合并(整32 左, 整32 右) -> 整32 {
    返回 左 * 10 + 右;
}

函数 零元() -> 整32 {
    返回 77;
}

不安全 函数 按分数比较(学生* a, 学生* b) -> 整32 {
    如果 (a.分数 > b.分数) { 返回 1; }
    如果 (a.分数 < b.分数) { 返回 -1; }
    返回 0;
}

函数 应用(整32(*处理)(整32), 整32 值) -> 整32 {
    返回 处理(值);
}

函数 转发(整32(*处理)(整32), 整32 值) -> 整32 {
    整32(*本地)(整32) = 处理;
    返回 应用(本地, 值);
}

不安全 函数 排序判定(整32(*比较)(学生*, 学生*), 学生* x, 学生* y) -> 整32 {
    返回 比较(x, y);
}

函数 主() -> 整32 {
    整32(*回调)(整32) = 加一;
    打印(回调(41));
    回调 = 减一;
    打印(回调(41));
    整32(*双参)(整32, 整32) = 合并;
    打印(双参(3, 7));
    整32(*无参)() = 零元;
    打印(无参());
    打印(应用(加一, 100));
    打印(应用(回调, 100));
    打印(转发(加一, 200));
    打印(转发(减一, 300));
    学生 甲;
    甲.分数 = 90;
    学生 乙;
    乙.分数 = 60;
    打印(排序判定(按分数比较, &甲, &乙));
    打印(排序判定(按分数比较, &乙, &甲));
    返回 0;
}
