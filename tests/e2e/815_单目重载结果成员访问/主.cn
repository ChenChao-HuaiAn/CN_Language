// E2E 815_单目重载结果成员访问（#507 根治锁用例）：单目运算符重载（- ! ~）
//   返回用户类对象后直接取成员——必须与「先存变量再取成员」等价。
//   缺陷实录（465 呈报·507 立项）：(-点(5)).x v2 侧编译中止「[ir2] 成员字段
//   偏移未知: .x」——解析右值偏移兜底只认 标识符/成员/三元 三形态，接收者=
//   单目表达式形态 miss；宿主 465 修后同形态已绿（-5）。根治=v2 族③ 补单目
//   重载结果形态（重载感知末端推导·按 负号/逻辑非/位非 节点类型判定，非按
//   表达式文本特判·与宿主 exprSrcType UnaryExpr 读 resolvedType 同构）。
//   六形态断言：直取/存变量对照/参与运算/嵌套单目/逻辑非/位非。
类 点 {
公开:
    整32 x;

    函数 点(整32 v) {
        x = v;
    }

    // 单目负号重载（0 右参·左操作数=this）：返回 点 类对象（x 取反）
    函数 运算符-() -> 点 {
        点 负 = 点(0 - x);
        返回 负;
    }
}

类 温度 {
公开:
    整32 值;

    函数 温度(整32 v) {
        值 = v;
    }

    // 单目逻辑非重载：返回 温度 类对象（值归零）
    函数 运算符!() -> 温度 {
        温度 归 = 温度(0);
        返回 归;
    }
}

类 掩码 {
公开:
    整32 位;

    函数 掩码(整32 v) {
        位 = v;
    }

    // 单目位非重载：返回 掩码 类对象（255 - 位·P0-3 位非重载语义）
    函数 运算符~() -> 掩码 {
        掩码 反 = 掩码(255 - 位);
        返回 反;
    }
}

函数 主() -> 整32 {
    // 形态①：单目负号重载结果直接取成员（-点(5) -> 点{x=-5}）
    打印((-点(5)).x);
    // 形态②：对照——先存变量再取成员（语义必须与形态①一致）
    点 a = -点(5);
    打印(a.x);
    // 形态③：单目重载结果取成员参与运算（-5 + 1 = -4）
    打印((-点(5)).x + 1);
    // 形态④：嵌套单目（重载结果再施重载·-(-点(5)) -> 点{x=5}）
    打印((-(-点(5))).x);
    // 形态⑤：逻辑非重载结果取成员（!温度(23) -> 温度{值=0}）
    打印((!温度(23)).值);
    // 形态⑥：位非重载结果取成员（~掩码(200) -> 掩码{位=55}）
    打印((~掩码(200)).位);
    返回 0;
}
