// E2E 750_接口继承链多态（413-b 审查 P0-1 锁定；489 撞号改号让位，原号 715）：接口实现类集合含继承链并入
//   ——A:I 实现、B:A 重写，B 对象经接口变量调用须动态命中 B 实现（多态保留）。
//   修前 v2 唯一实现误判 → 静态直调 A 实现（宿主 2 / v2 1 分叉实录）。
// 覆盖：两级链（B:A 重写）/ 三级链（C:B 再重写）/ 沿链未重写（沿用父实现）/
//   指针形态接口调用 / 独立实现类多接口并存。
接口 发声 {
    虚拟 函数 名字() -> 整32
}
接口 计数 {
    虚拟 函数 值() -> 整32
}
类 甲 : 发声 {
公开:
    虚拟 函数 名字() -> 整32 { 返回 1; }
}
类 乙 : 甲 {
公开:
    重写 函数 名字() -> 整32 { 返回 2; }   // 沿链重写——多实现并入后须动态命中
}
类 丙 : 乙 {
公开:
    重写 函数 名字() -> 整32 { 返回 3; }   // 三级链再重写
}
类 丁 : 乙 {
公开:
    // 未重写 名字——沿用 乙 实现（继承沿链）
}
类 戊 : 发声, 计数 {
公开:
    虚拟 函数 名字() -> 整32 { 返回 9; }
    虚拟 函数 值() -> 整32 { 返回 90; }
}
函数 主() -> 整32 {
    打印("===== 接口继承链多态 =====");
    乙 对象乙 = 乙();
    发声 声1 = 对象乙;
    打印("乙经接口: ", 声1.名字());          // 2（多态·修前 v2 错出 1）
    丙 对象丙 = 丙();
    发声 声2 = 对象丙;
    打印("丙经接口: ", 声2.名字());          // 3
    丁 对象丁 = 丁();
    发声 声3 = 对象丁;
    打印("丁沿用: ", 声3.名字());            // 2（沿链父实现）
    戊 对象戊 = 戊();
    发声 声4 = 对象戊;
    计数 数1 = 对象戊;
    打印("戊发声: ", 声4.名字());            // 9
    打印("戊计数: ", 数1.值());              // 90
    发声* 声5 = 对象丙;
    打印("指针形态: ", 声5.名字());          // 3
    打印("===== 完成 =====");
    返回 0;
}
