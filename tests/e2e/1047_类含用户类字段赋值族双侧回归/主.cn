// E2E 1047（2026-10-16 任务 914）：类含用户类字段赋值族双侧回归（915-b）。
//   病（362 复验新发现·asm 铁证在案）：
//     ①v2 裸字段←构造调用=508-a 守卫未排用户类→op61 rep movsb 对象内容写进
//       8B 句柄槽（探针 fault=7·RAX=7）；②宿主成员链←标识符=拷贝构造 this 传
//       对象基址（=字段槽地址）而应取槽内容（探针 fault=内容值 0x2A）；
//     ③裸字段←标识符=句柄浅共享双主（源出口 RAII+父析构级联双 DeleteObject=
//       C0000374·双侧）；④裸字段←构造调用多轮=旧壳泄漏（析构数 1<52·双侧）。
//   修（915-b）：句柄语义深拷（新壳+拷贝构造+旧壳释放）+095 覆盖前 drop 旧值
//   补齐——宿主/v2 零分叉（析构计数双侧同为 52+1=53）。
//   断言：值正确性 + 内存::活动分配数差值净 0 + 析构计数平衡；
//   校验和折位：形一 1 形二 2 形三 4 —— 退出码 7=全对。
导入 容器::向量;
导入 IO::打印;

静态 整64 析构数 = 0;

类 内盒 {
公开:
    向量<字符串> 表;
    函数 内盒() { 表 = 向量<字符串>(); }
    不安全 函数 ~内盒() { 析构数 = 析构数 + 1; }
    不安全 函数 内盒(内盒& 其他) { 表 = 其他.表; }
}

类 造者 {
公开:
    整64 申;
    函数 造者() { 申 = 7; }
    函数 产() -> 内盒 {
        内盒 临时 = 内盒();
        结果<空类型, 整32> r = 临时.表.追加(字符串复制("产载荷"));
        返回 临时;
    }
}

类 外盒 {
公开:
    内盒 内;
    函数 外盒() { 内 = 内盒(); }          // 构造内裸字段←构造调用（现象 A 面）
    函数 ~外盒() { }
    函数 换新() { 内 = 内盒(); }           // 裸字段←构造调用（多轮·旧壳释放）
    函数 设局() {                          // 裸字段←标识符（深拷）
        内盒 局 = 内盒();
        结果<空类型, 整32> r = 局.表.追加(字符串复制("局载荷"));
        内 = 局;
    }
}

// 形一：构造调用/成员链←标识符/成员链←方法调用 值正确性（含现象 A/B）
函数 形一() -> 整64 {
    外盒 甲;
    内盒 丙 = 内盒();
    结果<空类型, 整32> r1 = 丙.表.追加(字符串复制("丙载荷"));
    甲.内 = 丙;                 // 成员链←标识符（宿主 this 修复面）
    造者 者;
    甲.内 = 者.产();            // 成员链←方法调用（接管+旧壳释放）
    如果 (甲.内.表.大小() != 1) { 返回 0; }
    如果 (丙.表.大小() != 1) { 返回 0; }   // 源独立拥有（深拷非共享）
    返回 1;
}

// 形二：裸字段←标识符 多轮（深拷独立拥有·活动分配数差值净 0）
函数 形二() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 轮 = 0;
    {
        外盒 盒;
        当 (轮 < 50) {
            盒.设局();
            如果 (盒.内.表.大小() != 1) { 返回 0; }
            轮++;
        }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 2;
}

// 形三：裸字段←构造调用 多轮（旧壳释放·析构计数全平衡）
函数 形三() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 前析 = 析构数;
    整64 轮 = 0;
    {
        外盒 盒;
        当 (轮 < 50) {
            盒.换新();
            轮++;
        }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    // 50 轮：外盒字段内自动默认构造 A0 释放 1 + 构造体赋值对象 A1..A50 释放 50
    //   + 盒析构释放 A51 共 1 = 52（双侧实测同值·句柄语义深拷+覆盖前释放）
    如果 (析构数 - 前析 != 52) { 返回 0; }
    返回 4;
}

函数 主() -> 整32 {
    整64 校验和 = 形一() + 形二() + 形三();
    如果 (校验和 == 7) {
        打印("类含用户类字段赋值族：全通过");
    } 否则 {
        打印("类含用户类字段赋值族：失败 ", 校验和);
    }
    返回 整32(校验和);
}
