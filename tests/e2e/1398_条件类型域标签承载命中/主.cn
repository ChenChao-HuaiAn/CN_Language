// 1398（1137 审查修复 P0-1）：条件类型域维度——超 i64 标签在宽条件域内精确命中。
//   非双编译对照（宿主单侧）：v2 侧整128/正128 条件比较与超 i64 标签比较存在
//   同族缺陷（审查 P1-1：cmp 栈地址·整128 条件所有标签不命中）——双侧对齐
//   另案（1137 报告已建议立案），本用例锁宿主正确行为（#1076 口径 + 归一
//   十进制文本比较常量发射）。
//   覆盖：①正64 条件 + u64max（18446744073709551615）命中
//   ②整128 条件 + 20 位值（99999999999999999999）命中
//   ③正128 条件 + 2^127-1（170141183460469231731687303715884105727）命中
//   ④整128 条件 + 小标签（5）回归命中。
//   姊妹：1399（超条件类型域拒·宿主单侧）、1396（承载超域拒·双侧）、
//   1395（≤64 域内命中·双侧）。
函数 主() -> 整32 {
    {
        正64 甲 = 18446744073709551615;
        选择(甲) {
            情况 18446744073709551615:
                打印("①命中");
                中断;
            默认:
                打印("①未命中");
                返回 1;
        }
    }
    {
        整128 乙 = 99999999999999999999;
        选择(乙) {
            情况 99999999999999999999:
                打印("②命中");
                中断;
            默认:
                打印("②未命中");
                返回 2;
        }
    }
    {
        正128 丙 = 170141183460469231731687303715884105727;
        选择(丙) {
            情况 170141183460469231731687303715884105727:
                打印("③命中");
                中断;
            默认:
                打印("③未命中");
                返回 3;
        }
    }
    {
        整128 丁 = 5;
        选择(丁) {
            情况 5:
                打印("④命中");
                中断;
            默认:
                打印("④未命中");
                返回 4;
        }
    }
    返回 0;
}
