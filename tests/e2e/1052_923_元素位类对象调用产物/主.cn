// E2E 1052（2026-10-17 任务923 派生·629 同族）：元素位 × 类对象调用产物赋值——
//   CN 类元素数组=内联对象体（步进=类布局大小·读取 [元素+字段偏移]）；原
//   「元素 ← 方法/构造/普通函数调用产物」通道缺失：产物堆句柄 8 字节直存
//   内联体首字段（宿主读取把句柄当字段消费=值错/崩、v2 旧值不析构=每次覆盖
//   泄漏 2）。修=内联体接管（产物内容 CopyStruct 进元素 + 旧值析构 + 产物壳
//   裸放）+ 959 转移面旧值析构补齐 + 类数组元素出口释放（返回路径兜底+幂等
//   整对象清零·双编译器同构）。
//   断言面（矩阵四形态·块域口径=出口前后活动分配数差值 0 + 覆盖后内容断言）：
//     形一 数组×方法调用（仓.产()·双元素 ×50 轮）      → 校验位 1
//     形二 数组×构造调用（货架() ×50 轮）               → 校验位 2
//     形三 数组×普通函数调用（造货架() ×50 轮）          → 校验位 4
//     形五 数组×转移（转移(乙) ×50 轮·旧值析构补齐）     → 校验位 8
//   校验和 15=全对（退出码 0·任一形态泄漏=差值非 0=校验位丢失）。
导入 容器::向量;

类 货架 {
公开:
    向量<字符串> 记录;
    函数 货架() { 记录 = 向量<字符串>(); }
    函数 ~货架() { }
    不安全 函数 货架(货架& 其他) { 记录 = 其他.记录; }
}

类 主仓 {
公开:
    函数 主仓() { }
    函数 产() -> 货架 {
        货架 临时;
        结果<空类型, 整32> r = 临时.记录.追加(字符串复制("方法调用位载荷"));
        返回 临时;
    }
}

函数 造货架() -> 货架 {
    货架 临时;
    结果<空类型, 整32> r = 临时.记录.追加(字符串复制("普通函数位载荷"));
    返回 临时;
}

函数 形一() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校 = 0;
    {
        货架[2] 表;
        主仓 仓;
        表[0] = 仓.产();
        表[1] = 仓.产();
        整64 轮 = 0;
        当 (轮 < 50) {
            表[0] = 仓.产();
            表[1] = 仓.产();
            轮++;
        }
        校 = 表[0].记录.大小() + 表[1].记录.大小();
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校 != 2) { 返回 0; }
    返回 1;
}

函数 形二() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校 = 0;
    {
        货架[1] 表;
        表[0] = 货架();
        整64 轮 = 0;
        当 (轮 < 50) {
            表[0] = 货架();
            轮++;
        }
        校 = 表[0].记录.大小();
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校 != 0) { 返回 0; }
    返回 2;
}

函数 形三() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校 = 0;
    {
        货架[1] 表;
        表[0] = 造货架();
        整64 轮 = 0;
        当 (轮 < 50) {
            表[0] = 造货架();
            轮++;
        }
        校 = 表[0].记录.大小();
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校 != 1) { 返回 0; }
    返回 4;
}

函数 形五() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校 = 0;
    {
        货架[1] 表;
        货架 甲;
        结果<空类型, 整32> r0 = 甲.记录.追加(字符串复制("转移首载"));
        表[0] = 转移(甲);
        整64 轮 = 0;
        当 (轮 < 50) {
            货架 乙;
            结果<空类型, 整32> r1 = 乙.记录.追加(字符串复制("转移后续"));
            表[0] = 转移(乙);
            轮++;
        }
        校 = 表[0].记录.大小();
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校 != 1) { 返回 0; }
    返回 8;
}

函数 主() -> 整32 {
    整64 和 = 形一() + 形二() + 形三() + 形五();
    如果 (和 == 15) {
        打印("元素位类对象调用产物写：全通过");
        返回 0;
    }
    打印("元素位类对象调用产物写：失败");
    打印(和);
    返回 1;
}
