// E2E 72_self_host_parser：CN 语法分析器（自举 Task 7.2，2026-08）
// 验证：对代表性 CN 源码（导入/泛型类/结构体/枚举/函数/语句全家族/表达式
//   优先级/类型组合/选择/遍历/三元/强制转换）解析，输出 AST dump 逐行比对
导入 容器::向量;
导入 CN语言编译器::词法分析;
导入 CN语言编译器::语法分析;

函数 主() -> 整32 {
    字符串 源码 = "导入 容器::向量;\n泛型 <类型 T>\n类 容器 {\n公开:\n    函数 容器() {\n        数量 = 0;\n    }\n    函数 追加(T 值) -> 结果<空类型, 整32> {\n        数量++;\n        返回 正常();\n    }\n    常量 函数 大小() -> 整64 {\n        返回 数量;\n    }\n私有:\n    整64 数量;\n}\n结构体 点 {\n    整64 x\n    整64 y\n}\n枚举 颜色 { 红, 绿, 蓝 }\n函数 计算(整64 a, 整64 b) -> 整64 {\n    整64 总和 = a + b * 2;\n    如果 (总和 >= 10 && a != b) {\n        返回 总和 - 1;\n    } 否则 如果 (a < b) {\n        返回 b;\n    } 否则 {\n        返回 0;\n    }\n    当 (总和 > 0) {\n        总和--;\n    }\n    循环 (整64 i = 0; i < 总和; i++) {\n        总和 += i;\n    }\n    选择 (总和) {\n        情况 1, 2:\n            返回 1;\n        情况 3:\n            返回 3;\n        默认:\n            返回 0;\n    }\n    遍历 名单 中 每个 项 {\n        打印(项);\n    }\n    布尔 标志 = 真;\n    字符串 名 = \"测试\";\n    点 p = 点 { x = 1, y = 2 };\n    整64* 指针 = &总和;\n    整64 值 = 三元 ? 1 : 2;\n    返回 整64(值) + 参数;\n}\n";
    向量<字符串> 输出 = 解析(源码);
    整64 i = 0;
    当 (i < 输出.大小()) {
        打印(输出.元素(i));
        i++;
    }
    返回 0;
}
