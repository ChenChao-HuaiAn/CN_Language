// E2E 582（980 轮·任务 007 NLL 分支合流·008 波7·〔基准=019〕第二句）：
//   886 词法假阳性根治正测——分支互斥下转移标记不得跨分支泄漏：
//   真支转移 值 后，互斥的 否则如果/否则 分支读 值 必须编译通过
//   （词法标记版误报「已转移，不能继续使用」；数据流快照-恢复-合流后精确
//   放行——Rust NLL flow 同款·任务 007 跨语句 NLL 活跃区间本体）。
//   附循环内分支互斥形态（货舱解析.cn 115/117 同构·886 轮实证）。
//   v2 同构转 dual：随波7 v2 侧（978 收官后·头注占位）。
函数 走分支(整32 节, 字符串 值) -> 整32 {
    字符串 出 = "";
    字符串 缓存 = "";
    如果 (节 == 1) {
        出 = 转移(值);
        缓存 = 出 + "-甲";
    } 否则 如果 (节 == 2) {
        缓存 = 值 + "-乙";
    } 否则 {
        缓存 = 值 + "-丙";
    }
    打印(缓存);
    返回 0;
}

函数 循环挑值(整32 数) -> 整32 {
    字符串 汇总 = "";
    整32 i = 0;
    当 (i < 数) {
        字符串 轮值 = "轮" + i;
        如果 (i == 0) {
            汇总 = 转移(轮值);
        } 否则 {
            汇总 = 汇总 + 轮值;
        }
        i = i + 1;
    }
    打印(汇总);
    返回 0;
}

函数 消费串(字符串 s) -> 整32 {
    打印(s);
    返回 0;
}

// 981 赋值复活（001 条文⑥·用户裁决甲·Rust assign-to-move 同款）：转移后
//   **纯赋值**=重新初始化（复活），复活后再读合法；二次赋值仍合法。
函数 复活演示() -> 整32 {
    字符串 缓冲 = "第一批";
    消费串(转移(缓冲));
    缓冲 = "第二批";
    消费串(缓冲);
    缓冲 = "第三批";
    打印(缓冲);
    返回 0;
}

函数 主() -> 整32 {
    走分支(1, "值");
    走分支(2, "值");
    走分支(0, "值");
    循环挑值(3);
    复活演示();
    返回 0;
}
