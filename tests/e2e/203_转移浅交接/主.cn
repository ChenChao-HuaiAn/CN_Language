// E2E 203（宿主正测，2026-09-10 第六十一轮 plans/019 阶段3b 性能主项）：
//   转移浅交接——容器/类转移从深拷贝（NewObject+拷贝构造）升级为槽位交接
//   （句柄直拷+源槽清零+源析构空安全跳过）。析构计数锚定：转移恰好析构一次
//   （深拷模型对照=2 次，tp5 探针实证）。期望 stdout：8 / 1 / 结束。
//   计数载体=顶层静态（类静态成员+析构写为独立既有缺陷另案，tp3 实证）。
静态 整64 次数 = 0;
类 计数 {
公开:
    整64 值;
    函数 计数(整64 v) {
        值 = v;
    }
    函数 计数(计数& 其他) {
        值 = 其他.值;
    }
    不安全 函数 ~计数() {
        次数 = 次数 + 1;
    }
}
函数 读次() -> 整64 {
    返回 次数;
}
函数 造移() -> 空类型 {
    计数 甲 = 计数(7);
    计数 乙 = 转移(甲);
    乙.值 = 乙.值 + 1;
    打印(乙.值);
}
函数 主() -> 整32 {
    造移();
    打印(读次());
    打印("结束");
    返回 0;
}
