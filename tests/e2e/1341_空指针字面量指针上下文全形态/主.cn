// 空指针字面量「无」指针上下文全形态正测（#1973 根治锁面·双编译对照）：
//   ①声明初值 整32* p = 无 ②字段写 头.下.下.下 = 无 ③判等 p == 无 / 游 != 无 / n == 无
//   ④二级指针槽写 槽[0] = v（整32** 元素=整32* 8 字节·原 dword 半写高 32 位残留）
//   ⑤多级链中间段指针字段解引（头.下.值 链式写·原中间段漏加载地址错位）
//   ⑥递归传「无」（中序(无) 终止）+ 当循环指针遍历
结构体 节点 {
    整32 值;
    节点* 下;
}
不安全 函数 置指(整32** 槽, 整32* v) -> 空类型 {
    槽[0] = v;
    返回;
}
不安全 函数 中序(节点* n) -> 空类型 {
    如果 (n == 无) { 返回; }
    打印(n.值);
    中序(n.下);
    返回;
}
不安全 函数 主() -> 整32 {
    整32 x = 7;
    整32* p = 无;
    如果 (p == 无) {
        打印(0);
    } 否则 {
        打印(1);
    }
    置指(&p, &x);
    打印(p[0]);
    节点* 头 = 分配(类型大小(节点));
    头.值 = 1;
    头.下 = 分配(类型大小(节点));
    头.下.值 = 2;
    头.下.下 = 分配(类型大小(节点));
    头.下.下.值 = 3;
    头.下.下.下 = 无;
    整32 总 = 0;
    节点* 游 = 头;
    当 (游 != 无) {
        总 = 总 + 游.值;
        游 = 游.下;
    }
    打印(总);
    中序(头);
    释放(头.下.下);
    释放(头.下);
    释放(头);
    返回 0;
}
