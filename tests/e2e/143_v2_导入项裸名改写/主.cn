// E2E 143_v2_导入项裸名改写（簇②根治·B1，2026-09-04 用户裁决+裁决 B1a 边界）：
//   `导入 文件::打开文件` 的项名此前在 v2 语义层零登记——裸调 打开文件(...) 报
//   「未声明函数」（语法分析.cn 冒烟簇② 4 错；主.cn/IR签名.cn 驱动命脉）。B1：
//   语法层 导入项们 登记（项名->限定名，解析程序 入口清空+重扫=权威登记点，
//   防依赖先解析窗口抹掉）+ 调用形成时被调标识符（参数起点-1）命中即改写合成
//   限定名（第五波机制同构）。
//   【B1a 诚实边界（用户裁决）——930 已清偿】宿主语义=导入项绑定 stdlib/文件.cn
//   包装函数（返回 结果<空类型*, 整32>）；v2 旧实现=改写为限定名内置直调（裸指针
//   契约 空类型*）——返回契约分叉。930（930 批修复4·模块函数优先930）：v2 决议
//   对齐宿主「模块公开函数优先」——模块源码进编译集（导入驱动加载）时裸名/限定
//   调用决议 stdlib 包装函数，内置直调让位；本用例同步升级为结果包装契约形态
//   （打开文件→结果.正常/值、写入文件→结果；宿主同语义）。改写机制锚定不变
//   （裸名注册+调用位改写→模块函数决议）。v2p 尾部自检固化「未导入裸调负测」
//   （无导入源码裸调须拒）不受影响。
// 闭环：v2p 编译 -> as/g++ 宿主运行时 -> 运行。退出码=0 全过；11~19 失败码。
导入 文件::打开文件;
导入 文件::写入文件;
导入 文件::关闭文件;
导入 文件::{文件存在};          // 花括号单项形态（B1 同覆盖）

函数 主() -> 整32 {
    // ===== 一、裸调写入→关闭（B1 改写→决议 stdlib 文件.cn 包装·结果包装契约）=====
    字符串 路径 = "target/audit2/143_import_probe.txt";
    结果<空类型*, 整32> 打开写 = 打开文件(路径, 2);   // 裸调（930：模块函数优先）
    如果 (!打开写.正常) { 返回 11; }
    空类型* 写句柄 = 打开写.值;
    结果<整64, 整32> 写入返 = 写入文件(写句柄, "甲乙\n");
    如果 (!写入返.正常) { 返回 12; }
    整64 写入数量 = 写入返.值;
    如果 (写入数量 != 7) { 返回 12; }          // 2 汉字*3 + \n = 7;
    关闭文件(写句柄);

    // ===== 二、裸调读回 + 花括号导入项（文件存在）=====
    结果<空类型*, 整32> 打开读 = 打开文件(路径, 1);
    如果 (!打开读.正常) { 返回 13; }
    空类型* 句柄 = 打开读.值;
    关闭文件(句柄);
    如果 (!文件存在(路径)) { 返回 14; }        // 花括号形态登记同覆盖

    // ===== 三、失败负路径（打开不存在 → 结果.正常=假）=====
    结果<空类型*, 整32> 打开坏 = 打开文件("target/audit2/143_不存在.txt", 1);
    如果 (打开坏.正常) { 返回 15; }
    如果 (文件存在("target/audit2/143_不存在.txt")) { 返回 16; }

    // 运行时人眼审计锚点（stdout）
    打印("[143] 导入项裸调改写: 写入=", 写入数量, " 存在=", 文件存在(路径));
    返回 0;
}
