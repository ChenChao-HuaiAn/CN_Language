类 盒子 {
公开:
    整128 值;
    函数 盒子(整128 初始) { 值 = 初始; }
}
函数 制造(整128 值) -> 整128 {
    返回 值;
}
函数 取低(整128 值) -> 整64 {
    返回 整64(值);
}
函数 主() -> 整32 {
    // ① 字面量实参·i128 返回（m45_01 形态）
    整128 甲 = 制造(123456789012);
    打印行("返回位 = ", 甲);
    // ② 字面量实参·整64 返回（m45_02 形态）
    打印行("对照 = ", 取低(999999));
    // ③ 类构造字面实参（m45_03 形态）
    盒子 乙 = 盒子(123456789012);
    打印行("类构造 = ", 乙.值);
    // ④ 变量实参健康对照（既有 84-a/88-a 路径不回归）
    整128 丙 = 555000444000333;
    打印行("变量 = ", 制造(丙));
    // ⑤ 表达式实参（常量折叠面）
    打印行("表达式 = ", 制造(123456789012 + 1));
    // ⑥ 负值字面量（符号扩展高半 cqo 路径）
    整128 丁 = 制造(0 - 123456789012);
    打印行("负值 = ", 丁);
    返回 0;
}
