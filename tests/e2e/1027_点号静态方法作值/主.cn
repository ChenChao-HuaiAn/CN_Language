// E2E 1027_点号静态方法作值（#912 修复·dual）：
// 覆盖：类名.静态方法（**点号**形态）作值——v2 修前 IR 层「[ir2] 成员字段
//   偏移未知: .X」误拒（把 类名.静态方法 当成员字段访问·v2 反向分叉·
//   宿主 P3-23 放行）。修面=v2 生成字段访问 补「对象=用户类名 + 成员=类静态
//   方法」分流（静态方法引用值=纯函数地址·无 this 绑定；与 :: 限定形态/
//   调用位直调同符号公式）。相邻面 806（实例方法作值封口）不回归：
//   静态方法无 this 绑定=合法作值，宿主 107 负测仅限实例方法。
// 锁面：①实参位（直接传值）②声明位（函数指针变量初值 + 句柄直调 + 中转）
//   ③调用位（点号直调——912-b 顺带根治：原实现把方法调用 retbuf序号 原样传
//   IR → 参数 ABI 错位（被调首参读 retbuf 地址·运行时溢出错误码 8）·修后与
//   宿主静态直调同 ABI；覆盖标量单参/多参/字符串返回）④类内嵌套（静态方法体
//   内作值）⑤返回位（函数返回方法引用值）。:: 限定形态回归锚=98/798 dual 用例族。
// 注：结构体返回直调形态暂不进本用例——宿主侧「结构体返回直调」已暴露独立
//   缺陷（产物运行时 C0000005 不稳定崩·bisect1/4/5/6/10/11 实录，已立案
//   #936）；v2 侧 retbuf 全链修复的聚合面验证见 1036_v2 用例。
函数 应用(整32(*f)(整32), 整32 v) -> 整32 { 返回 f(v); };

类 计算器 {
公开:
    静态 函数 双倍(整32 x) -> 整32 { 返回 x * 2; }
    静态 函数 加一(整32 x) -> 整32 { 返回 x + 1; }
    静态 函数 四倍(整32 x) -> 整32 {
        返回 应用(计算器.双倍, 应用(计算器.双倍, x));
    }
}

类 工厂 {
公开:
    静态 函数 名字() -> 字符串 { 返回 "工厂"; }
    静态 函数 求和(整32 甲, 整32 乙) -> 整32 { 返回 甲 + 乙; }
}

函数 取句柄(布尔 用双倍) -> 整32(*)(整32) {
    如果 (用双倍) { 返回 计算器.双倍; }
    返回 计算器.加一;
}

函数 主() -> 整32 {
    打印("===== 点号静态方法作值（912）=====");
    打印("实参位: ", 应用(计算器.双倍, 5));          // 10
    整32(*句柄)(整32) = 计算器.双倍;                // 声明位
    打印("声明位直调: ", 句柄(5));                  // 10
    打印("声明位中转: ", 应用(句柄, 6));            // 12
    打印("调用位: ", 计算器.双倍(21));              // 42
    打印("类内嵌套: ", 计算器.四倍(3));             // 12
    整32(*返回句柄)(整32) = 取句柄(真);             // 返回位
    打印("返回位: ", 应用(返回句柄, 10));           // 20
    打印("字符串返回: ", 工厂.名字());              // 工厂
    打印("多参标量: ", 工厂.求和(3, 4));            // 7
    打印("===== 完成 =====");
    返回 0;
}
