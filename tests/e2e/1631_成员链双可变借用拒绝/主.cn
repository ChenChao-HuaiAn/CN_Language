// E2E 1631_成员链双可变借用拒绝（#1551 负测锁面·750 P1-A 修复形态）：
//   成员链接收者（对象.内.方法）的双引用实参别名冲突——同一调用中独立变量
//   被可变借用两次=编译期拒（诊断锚「被可变借用两次」·宿主 750 P1-A 修复
//   面与 v2 双侧同报）。1551 备注登记：泛型实例字段成员链形态（宿主拒/v2
//   放）仍开=范围另记 #1524；本件锁普通用户类已修形态防回归。
类 内层 {
公开:
    整64 值;
    函数 内层() { 值 = 0; }
    函数 换(整64& a, 整64& b) { a = 1; b = 2; }
}

类 外壳 {
公开:
    内层 内;
    函数 外壳() { }
}

函数 主() -> 整32 {
    外壳 对象;
    整64 甲 = 5;
    对象.内.换(甲, 甲);
    打印(甲);
    返回 0;
}
