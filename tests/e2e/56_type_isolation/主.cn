// E2E 56_type_isolation：跨模块同名类型/常量隔离（A-2 修复，2026-08）
// 覆盖：
//   1. 甲::记录（整64 标识）与 主::记录（字符串 名称）同名结构体独立共存
//   2. 限定类型语法：甲::记录 r = ...（类型位置 模块名::类型名）
//   3. 常量 版本 按模块解析：甲=100、主=200（裸名引用各自命中本模块常量）
//   4. 跨模块函数调用：甲::创建甲记录/甲::读甲标识（模块限定调用既有机制）
导入 甲;

结构体 记录 {
    字符串 名称;
}

常量 版本 = 200;

函数 模块版本() -> 整64 {
    返回 版本;
}

函数 创建记录(字符串 名称) -> 记录 {
    返回 记录{ 名称 = 名称 };
}

函数 读名称(记录 r) -> 字符串 {
    返回 r.名称;
}

函数 主() -> 整32 {
    打印("===== 类型级 crate 分桶（A-2）=====");

    // 1. 同名常量按模块解析（甲=100 / 主=200）
    打印("甲 版本: ", 甲::甲模块版本());
    打印("主 版本: ", 模块版本());

    // 2. 限定类型 + 跨模块构造/字段访问
    甲::记录 甲记录 = 甲::创建甲记录(42);
    打印("甲记录标识: ", 甲::读甲标识(甲记录));

    // 3. 本模块同名类型独立使用（字符串 名称 字段）
    记录 主记录 = 创建记录("书本");
    打印("主记录名称: ", 读名称(主记录));

    // 4. 两类型互不混淆：各自字段/布局独立（标识 vs 名称）
    打印("===== 类型分桶测试完成 =====");
    返回 0;
}
