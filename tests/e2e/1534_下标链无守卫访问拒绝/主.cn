// E2E 1534_下标链无守卫访问拒绝（#1598·2026-10-25·双编译对照负例）：
//   守卫判据对象面扩展后的**拒绝面**回归锁——未守卫的下标/成员链/混合链
//   .值/.错误 访问宿主与 v2 同拒（plans/001 §5.4 规则3·诊断文案逐字同源）。
//   覆盖形态：①组[0].值 直取 ②守卫键不匹配（组[0] 守卫→组[1].值）
//   ③成员链乙.字段 ④下标+成员表[0].字段 ⑤守卫后重赋值失效 ⑥变量下标
//   ⑦复杂下标（键不可跟踪）⑧调用返回对象 ⑨成员方法调用返回对象
//   ⑩&& 顺序颠倒/右未守卫 ⑪否则支访问 ⑫三元不传导 ⑬深链
//   ⑭结果数组 .值 ⑮指针成员链（不安全函数）。修复前 v2 对链对象一律
//   放行（守卫检查点仅认标识符）=宿主拒/v2 放行分叉。
结构体 内盒 {
    可选<整32> 字段;
}
结构体 外盒 {
    内盒 被;
}
类 取盒 {
公开:
    函数 取() -> 可选<整32> { 返回 某些(1); }
}
函数 取组() -> 可选<整32> { 返回 某些(2); }
不安全 函数 指针面(内盒* 指针) -> 整32 {
    打印(指针.字段.值);
    返回 0;
}
不安全 函数 主() -> 整32 {
    可选<整32>[2] 组;
    组[0] = 某些(5);
    组[1] = 某些(6);
    打印(组[0].值);
    如果 (组[0].有值) { 打印(组[1].值); }
    可选<整32> 载荷 = 某些(7);
    内盒 乙;
    乙.字段 = 载荷;
    打印(乙.字段.值);
    内盒[2] 表;
    表[0].字段 = 载荷;
    打印(表[0].字段.值);
    如果 (组[0].有值) {
        组[0] = 某些(9);
        打印(组[0].值);
    }
    整64 甲 = 0;
    打印(组[甲].值);
    如果 (组[甲 + 1].有值) { 打印(组[甲 + 1].值); }
    如果 (取组().有值) { 打印(取组().值); }
    取盒 器;
    打印(器.取().值);
    如果 (组[0].值 > 0 && 组[0].有值) { 打印("序"); }
    如果 (组[0].有值 && 组[1].值 > 0) { 打印("右"); }
    如果 (组[0].有值) { 打印("有"); } 否则 { 打印(组[0].值); }
    整32 三 = 组[0].有值 ? 组[0].值 : 0;
    打印(三);
    外盒[2] 深;
    深[0].被.字段 = 载荷;
    打印(深[0].被.字段.值);
    结果<整32, 整32>[2] 结组;
    结组[0] = 正常(1);
    打印(结组[0].值);
    如果 (结组[1].正常) { 打印(结组[1].值); } 否则 { 打印(结组[1].错误); }
    内盒 丙;
    丙.字段 = 载荷;
    指针面(&丙);
    返回 0;
}
