// p263tmp_b（263① 探针·临时不入库）：借用读（表.元素(0).名）→ 普通函数字符串实参。
//   权料=旧 070 行抢救「泄漏定位=函数包裹内 校验读 表.元素(0).名〔借用暂存〕主254 铁证
//   差值 1·修=元素借用读暂存释放〔生成表达式字段 访问临时串清理〕」——245 形一的校验读
//   在语句位（如果 条件），本探针打「函数实参位」：元素() 物化临时（整盒值副本·含串）
//   在实参求值后被谁回收。2=绿；1=泄漏；0=校验失败。
导入 容器::向量;

结构体 盒子 {
    字符串 名;
    整32 号;
}

函数 串长度(字符串 文本) -> 整64 {
    返回 字符串长度(文本);
}

函数 形探() -> 整64 {
    整64 前 = 内存::活动分配数();
    {
        向量<盒子> 表 = 向量<盒子>();
        结果<空类型, 整32> 加 = 表.追加(盒子{ 名 = 字符串复制("P263B串"), 号 = 9 });
        如果 (!加.正常) { 返回 0; }
        整64 长 = 串长度(表.元素(0).名);
        如果 (长 != 8) { 打印(长); 返回 0; }
    }
    如果 (内存::活动分配数() != 前) { 返回 1; }
    返回 2;
}

函数 主() -> 整32 {
    打印(形探());
    返回 0;
}
