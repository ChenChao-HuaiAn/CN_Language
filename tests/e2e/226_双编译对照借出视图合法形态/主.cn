// E2E 226（2026-09-12 第七十七轮，plans/020 移植纪律 9 第四个对照用例）：
//   **双编译对照·借出视图合法形态**——同一源码宿主 / v2 两侧各编各跑，
//   **退出码须一致=255**（八形态折校验和；宿主侧锚定用例期望值，v2 侧以
//   宿主实测值为期望）。判据意义：借出视图生命周期检查在两侧落地后，
//   **合法形态零误伤**须两侧同构（宿主 semantic_borrowview.cpp ↔ v2 语义/
//   借出检查.cn）——任一侧过度拦截（含 NLL 活跃区间近似过宽/容器判定过宽）
//   即该校验位丢失、退出码不同 → 对照失败。
//   八形态（与 E2E 225 同源，折入退出码）：
//     ①立即消费（借出不绑定）；②显式复制后容器修改；③借出→消费→修改；
//     ④借出后修改不使用；⑤非字符串元素容器（向量<整64>，值语义非借用面）；
//     ⑥结果变量消费在失效点之前；⑦扩容类修改点（追加）后借出仍有效；
//     ⑧循环内每轮重新借出。校验和 255=①1+②2+③4+④8+⑤16+⑥32+⑦64+⑧128。
导入 容器::向量;

// ① 立即消费
函数 形态一() -> 整64 {
    整64 校验 = 0;
    向量<字符串> 表 = 向量<字符串>();
    结果<空类型, 整32> 加 = 表.追加(字符串复制("形态一元素甲乙丙丁戊己庚辛壬癸"));
    如果 (!加.正常) { 返回 0; }
    如果 (字符串比较(表.元素(0), "形态一元素甲乙丙丁戊己庚辛壬癸")) { 校验 = 校验 + 1; }
    结果<空类型, 整32> 删 = 表.删除(0);
    如果 (!删.正常) { 返回 0; }
    返回 校验;
}

// ② 显式复制（拥有副本）后容器修改
函数 形态二() -> 整64 {
    整64 校验 = 0;
    向量<字符串> 表 = 向量<字符串>();
    结果<空类型, 整32> 加 = 表.追加(字符串复制("形态二元素甲乙丙丁戊己庚辛壬癸"));
    如果 (!加.正常) { 返回 0; }
    字符串 副本 = 字符串复制(表.元素(0));
    结果<空类型, 整32> 删 = 表.删除(0);
    如果 (!删.正常) { 返回 0; }
    如果 (字符串比较(副本, "形态二元素甲乙丙丁戊己庚辛壬癸")) { 校验 = 校验 + 2; }
    返回 校验;
}

// ③ 借出→消费→修改（NLL 活跃区间已结束）
函数 形态三() -> 整64 {
    整64 校验 = 0;
    向量<字符串> 表 = 向量<字符串>();
    结果<空类型, 整32> 加 = 表.追加(字符串复制("形态三元素甲乙丙丁戊己庚辛壬癸"));
    如果 (!加.正常) { 返回 0; }
    字符串 借出 = 表.元素(0);
    如果 (字符串比较(借出, "形态三元素甲乙丙丁戊己庚辛壬癸")) { 校验 = 校验 + 4; }
    结果<空类型, 整32> 删 = 表.删除(0);
    如果 (!删.正常) { 返回 0; }
    返回 校验;
}

// ④ 借出后修改但不使用借出
函数 形态四() -> 整64 {
    整64 校验 = 0;
    向量<字符串> 表 = 向量<字符串>();
    结果<空类型, 整32> 加 = 表.追加(字符串复制("形态四元素甲乙丙丁戊己庚辛壬癸"));
    如果 (!加.正常) { 返回 0; }
    字符串 借出 = 表.元素(0);
    结果<空类型, 整32> 删 = 表.删除(0);
    如果 (!删.正常) { 返回 0; }
    校验 = 校验 + 8;
    返回 校验;
}

// ⑤ 非字符串元素容器（值语义深拷贝，非借用面）
函数 形态五() -> 整64 {
    整64 校验 = 0;
    向量<整64> 表 = 向量<整64>();
    结果<空类型, 整32> 加 = 表.追加(7);
    如果 (!加.正常) { 返回 0; }
    整64 借出值 = 表.元素(0);
    结果<空类型, 整32> 删 = 表.删除(0);
    如果 (!删.正常) { 返回 0; }
    如果 (借出值 == 7) { 校验 = 校验 + 16; }
    返回 校验;
}

// ⑥ 结果变量：消费在失效点之前
函数 形态六() -> 整64 {
    整64 校验 = 0;
    向量<字符串> 表 = 向量<字符串>();
    结果<空类型, 整32> 加 = 表.追加(字符串复制("形态六元素甲乙丙丁戊己庚辛壬癸"));
    如果 (!加.正常) { 返回 0; }
    结果<字符串, 整32> 读 = 表.读取(0);
    如果 (读.正常) {
        如果 (字符串比较(读.值, "形态六元素甲乙丙丁戊己庚辛壬癸")) { 校验 = 校验 + 32; }
    } 否则 {
        返回 0;
    }
    结果<空类型, 整32> 设 = 表.设置(0, 字符串复制("形态六新值甲乙丙丁戊己庚辛壬癸"));
    如果 (!设.正常) { 返回 0; }
    返回 校验;
}

// ⑦ 扩容类修改点后同一借出继续用（字符串句柄独立于容器槽）
函数 形态七() -> 整64 {
    整64 校验 = 0;
    向量<字符串> 表 = 向量<字符串>();
    结果<空类型, 整32> 加 = 表.追加(字符串复制("形态七元素甲乙丙丁戊己庚辛壬癸"));
    如果 (!加.正常) { 返回 0; }
    字符串 借出 = 表.元素(0);
    整64 i = 0;
    当 (i < 6) {
        结果<空类型, 整32> 增 = 表.追加(字符串复制("形态七填充甲"));
        如果 (!增.正常) { 返回 0; }
        i++;
    }
    如果 (字符串比较(借出, "形态七元素甲乙丙丁戊己庚辛壬癸")) { 校验 = 校验 + 64; }
    返回 校验;
}

// ⑧ 循环内每轮重新借出（消费后再修改）
函数 形态八() -> 整64 {
    整64 校验 = 0;
    向量<字符串> 表 = 向量<字符串>();
    结果<空类型, 整32> 加 = 表.追加(字符串复制("形态八元素甲"));
    如果 (!加.正常) { 返回 0; }
    布尔 首次 = 真;
    整64 i = 0;
    当 (i < 3) {
        字符串 行 = 表.元素(i);
        如果 (字符串长度(行) > 0 && 首次) { 校验 = 校验 + 128; 首次 = 假; }
        结果<空类型, 整32> 增 = 表.追加(字符串复制("形态八追加乙"));
        如果 (!增.正常) { 返回 0; }
        i++;
    }
    返回 校验;
}

函数 主() -> 整32 {
    整64 校验和 = 0;
    如果 (形态一() == 1) { 校验和 = 校验和 + 1; }
    如果 (形态二() == 2) { 校验和 = 校验和 + 2; }
    如果 (形态三() == 4) { 校验和 = 校验和 + 4; }
    如果 (形态四() == 8) { 校验和 = 校验和 + 8; }
    如果 (形态五() == 16) { 校验和 = 校验和 + 16; }
    如果 (形态六() == 32) { 校验和 = 校验和 + 32; }
    如果 (形态七() == 64) { 校验和 = 校验和 + 64; }
    如果 (形态八() == 128) { 校验和 = 校验和 + 128; }
    返回 整32(校验和);
}
