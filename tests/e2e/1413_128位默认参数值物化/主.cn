// E2E 1413：#1150 128 位默认参数值物化——默认值须按形参声明类型落位
//   （整128/正128 形参的 <=64 位字面量默认值拆"低64:高64"双半）并物化为
//   虚拟寄存器实参（与显式实参同通道）。修复前 42 按 i32 按值传参，被调方
//   把 42 当 16 字节双槽地址解引用（C0000005）；2^64 及以上字面量因自身
//   类型即 128 位而侥幸正常——本用例横向锁死 0/42/-42/2^63/2^64/大值全矩阵。
函数 整128零(整128 x = 0) -> 整128 { 返回 x; }
函数 整128正(整128 x = 42) -> 整128 { 返回 x; }
函数 整128负(整128 x = -42) -> 整128 { 返回 x; }
函数 整128二的63次(整128 x = 9223372036854775808) -> 整128 { 返回 x; }
函数 整128二的64次(整128 x = 18446744073709551616) -> 整128 { 返回 x; }
函数 整128大值(整128 x = 170141183460469231731687303715884105727) -> 整128 { 返回 x; }

函数 正128零(正128 x = 0) -> 正128 { 返回 x; }
函数 正128正(正128 x = 42) -> 正128 { 返回 x; }
函数 正128二的63次(正128 x = 9223372036854775808) -> 正128 { 返回 x; }
函数 正128二的64次(正128 x = 18446744073709551616) -> 正128 { 返回 x; }
函数 正128大值(正128 x = 170141183460469231731687303715884105727) -> 正128 { 返回 x; }

函数 整64零(整64 x = 0) -> 整64 { 返回 x; }
函数 整64正(整64 x = 42) -> 整64 { 返回 x; }
函数 整64负(整64 x = -42) -> 整64 { 返回 x; }
函数 整64上界(整64 x = 9223372036854775807) -> 整64 { 返回 x; }
// 128→64 落位：-2^63 的原值 2^63 属 128 域（一元负号取负后落 64 位域）
函数 整64下界(整64 x = -9223372036854775808) -> 整64 { 返回 x; }

// 多缺省位（两个 128 位默认值同时补全——原 codegen 常量临时区同址覆盖面）
函数 双缺省(整128 a = 1, 整128 b = 2) -> 整128 { 返回 a * 100 + b; }

函数 主() -> 整32 {
    打印(整128零(), "|", 整128正(), "|", 整128负(), "|",
         整128二的63次(), "|", 整128二的64次(), "|", 整128大值(), "|");
    打印(正128零(), "|", 正128正(), "|", 正128二的63次(), "|",
         正128二的64次(), "|", 正128大值(), "|");
    打印(整64零(), "|", 整64正(), "|", 整64负(), "|", 整64上界(), "|",
         整64下界(), "|");
    打印(双缺省());
    返回 0;
}
