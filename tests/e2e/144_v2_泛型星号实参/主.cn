// E2E 144_v2_泛型星号实参（簇④+簇⑥根治，2026-09-04）
// 簇④（v2 侧）：解析类型文本 递归实参原只析裸名（空类型* 只取 空类型）——星号留
//   token 流使 `结果<空类型*, 整32> 名 = ...` 整条声明错位（冒烟簇② 4 错之一）。
//   根治：实参位消费后缀 * / & 并入合成名（对齐宿主 canonical 保留尾 *）。
// 簇⑥（宿主侧，宿主缺陷优先纪律当场根治）：泛型实例名含实参星号
//   （盒子<整64*> -> 盒子$整64*）时，语义/IR 三处按「尾 * = 对象指针」误剥
//   （visitMemberExpr 成员访问 / semantic_call 方法调用 / ir_oop_call 实例
//   方法）——实例名被剥成 盒子$整64 查类失败「不是结构体/联合体/类类型」；
//   最小复现=泛型类+指针实参 11 行（探针打印实证 varType 全程正确、丢点在
//   消费侧）。修复：原名查类命中即用原名（真指针不命中类表自然入剥分支）。
//   v2p 尾部自检固化「结果字面量初始化负测」（簇⑤拒绝——结果<> = 无 是
//   v2 非法形态，宿主同拒；原 IR 结构体拷贝瞎发射运行期 SIGSEGV 已根治）。
// 闭环：v2p 编译 -> as/g++ 宿主运行时 + 供给（向量$整64* 方法符号宿主实例化，
//   B7）-> 运行。退出码=0 全过；11~15 失败码。
函数 主() -> 整32 {
    // ===== 一、星号泛型容器构造（v2 合成名 向量$整64*——簇④实参位消费）=====
    向量<整64*> 指针们 = 向量<整64*>()

    // ===== 二、指针元素：追加 &数 / 元素(0) 读回解引用 / 写透可见 =====
    整64 数 = 42
    结果<空类型, 整32> 加 = 指针们.追加(&数)
    如果 (!加.正常) { 返回 11 }
    整64* 取出 = 指针们.元素(0)
    如果 (*取出 != 42) { 返回 12 }
    数 = 99
    如果 (*指针们.元素(0) != 99) { 返回 13 }   // 元素存指针——写透

    // ===== 三、多元素 + 大小 =====
    整64 另 = 7
    结果<空类型, 整32> 加2 = 指针们.追加(&另)
    如果 (!加2.正常) { 返回 14 }
    如果 (指针们.大小() != 2) { 返回 15 }

    // ===== 四、无星号对照（回归锚点：原支持形态不受实参位消费影响）=====
    向量<整64> 普通 = 向量<整64>()
    结果<空类型, 整32> 加3 = 普通.追加(5)
    如果 (!加3.正常) { 返回 16 }
    如果 (普通.元素(0) != 5) { 返回 17 }

    // 运行时人眼审计锚点（stdout）
    打印("[144] 星号泛型: *元素0=", *取出, " 大小=", 指针们.大小())
    返回 0
}
