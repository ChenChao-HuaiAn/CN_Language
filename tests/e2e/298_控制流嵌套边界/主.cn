函数 主() -> 整32 {
    整32 计 = 0;
    整32 i = 0;
    循环(i = 0; i < 3; i++) {
        整32 j = 0;
        当(j < 3) {
            如果 (i == j) {
                如果 (j == 2) {
                    选择 (i) {
                        情况 2:
                            计 = 计 + 10;
                            中断;
                        默认:
                            计 = 计 + 1;
                            中断;
                    }
                } 否则 {
                    计 = 计 + 1;
                }
            }
            j = j + 1;
        }
    }
    打印行(计);
    返回 0;
}
