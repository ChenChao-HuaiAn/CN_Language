// E2E 817（双编译对照·458 销项·438 同根扩面）：类对象声明位初始化右值=
//   「返回类对象的普通调用」——货架 甲 = 造货架()：位拷物化接管直存
//   （宿主「类返回=句柄移交」ABI 对齐），块出口在册回收一方、残留==0。
//   修前（458 复现·探针矩阵）：v2 走 发射类拷贝构造初始化 深拷通道，造货架()
//   函数内的源壳（连同字段容器数据数组+字符串，+2；壳 calloc 不计数）失去
//   唯一持有者成孤儿 → 残留 2 ≠ 宿主 0 双测红（校验和不置位：v2 退出码 0 ≠
//   宿主 1）；修后双侧同净（校验和 1·退出码 1）。
//   断言口径（283/719 同款）：块出口后 内存::活动分配数() 差值==0 且内容正确
//   → 校验和 1；宿主/v2 双侧同源同值。
导入 容器::向量;
类 货架 {
公开:
    向量<字符串> 记录;
    函数 货架() { 记录 = 向量<字符串>(); }
    函数 ~货架() { }
    不安全 函数 货架(货架& 其他) { 记录 = 其他.记录; }
}
函数 造货架() -> 货架 {
    货架 临时;
    结果<空类型, 整32> r = 临时.记录.追加(字符串复制("造一"));
    返回 临时;
}
函数 主() -> 整32 {
    整32 校验 = 0;
    整64 b1 = 内存::活动分配数();
    整64 内1 = 0;
    {
        货架 甲 = 造货架();
        内1 = 甲.记录.大小();
    }
    如果 (内1 == 1 && 内存::活动分配数() - b1 == 0) { 校验 = 校验 + 1; }
    返回 校验;
}
