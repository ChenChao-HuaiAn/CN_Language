// 814：结构体返回经 fnptr/蹦床/T69 间接调用的 retbuf 全链（#490·#485 742d 拆面 v2 侧）
//   宿主面已绿（#485 收口：ir_call.cpp 间接调用尾返回类型逐型贯通+结构体形态A
//   retbuf 预插+ir_lambda.cpp 蹦床 structReturn+蹦床转发 retbuf 预插）；
//   本面=v2 侧同构收口——T69 发射间接调用480 结构体返回 retbuf 形态+
//   蹦床 sret 面（槽1 保留+prologue 接收）+转发 retbuf 形态+返回透传。
//   缺陷实录（修前 v2）：retbuf 通道缺失→被调 sret 协议把首实参当隐藏返回
//   指针写→C0000005/错值（742d 同族）。
// 面1 fnptr 工厂返回「点(*)(整32, 整32)」+推断声明间接调用（T69 retbuf 形态）
// 面2 lambda 返回结构体·同帧调用（lambda 值=蹦床地址经 T69）
// 面3 lambda 返回结构体·逃逸跨函数（造闭包返回蹦床+转发 retbuf 全链）
// 期望：3 / 4 / 5 / 6 / 5 / 6 / 11 / 42（打印 逐行）
结构体 点 { 整32 x 整32 y }

函数 造点(整32 a, 整32 b) -> 点 {
    变量 p = 点{ x = a, y = b };
    返回 p;
}

// 面1：结构体返回 fnptr 的工厂（返回类型位匿名 fnptr——局部/形参位自定义
//   类型名 fnptr 声明解析缺口另案，此处走已立法通道）
函数 造点句柄() -> 点(*)(整32, 整32) {
    返回 造点;
}

// 面3：lambda 返回结构体·真逃逸载体（fnptr 返回类型位）
函数 造闭包() -> 点(*)() {
    变量 取 = [=]() -> 点 {
        变量 q = 点{ x = 5, y = 6 };
        返回 q;
    };
    返回 取;
}

函数 主() -> 整32 {
    // 面1：fnptr 间接调用普通结构体返回函数（retbuf 预插形态A）
    变量 句柄 = 造点句柄();
    变量 r1 = 句柄(3, 4);
    打印(r1.x);
    打印(r1.y);
    // 面2：lambda 返回结构体·同帧调用（蹦床归一=T69 间接调用通道）
    变量 g = [=]() -> 点 {
        变量 q = 点{ x = 5, y = 6 };
        返回 q;
    };
    变量 r2 = g();
    打印(r2.x);
    打印(r2.y);
    // 面3：lambda 返回结构体·逃逸跨函数（蹦床 sret+转发 retbuf 全链）
    变量 逃 = 造闭包();
    变量 r3 = 逃();
    打印(r3.x);
    打印(r3.y);
    打印(r3.x + r3.y);
    变量 s = 42;
    打印(s);
    返回 0;
}
