// E2E 1013（799 修复锁面）：结果载荷字节 泛型形参占位豁免 + 豁免族邻形态
//   缺陷实录（7992 探针）：泛型函数体内 结果<T, 整32> 载荷查询在单态化前
//   以形参名到达 → 原 v2p 中止「结果载荷字节 'T' 未登记×1（行0）——静默
//   兜底已废除（#648）」rc=1（宿主 rc=0 绿=零分叉红）；修复=结果载荷字节
//   豁免链补 是泛型参数名（宿主 typeSizeOf「泛型形参：单态化前无具体尺寸
//   （泛型类定义体检查期合法查询）」豁免 8 同款·648 合法查询非 miss）。
//   覆盖三面：①泛型形参 T 模板期查询（本用例核心·修复前红）②实例化重查
//   真值（T=整128 载荷 16 / 盒16 载荷 16——实例宽 8+max 真值）③豁免族邻
//   形态（枚举载荷=是枚举名 8 / 引用载荷=& 结尾 8——787 邻形态核对锁面）。
//   双侧同源码编译运行·退出码+stdout 逐行对照（双编译对照三层断言）。
枚举 色 { 红, 绿 }
结构体 包枚举 { 结果<色, 整32> 载; }
结构体 包引用 { 结果<整32&, 整32> 载; }
结构体 盒16 { 整64 甲; 整64 乙; }

泛型 <类型 T> 函数 包装(T 值) -> 结果<T, 整32> {
    结果<T, 整32> 内 = 正常(值);
    如果 (内.正常) {
        返回 内;
    }
    返回 错误(1);
}

函数 主() -> 整32 {
    打印("枚举包:", 类型大小(包枚举));
    打印("引用包:", 类型大小(包引用));
    整32 计 = 0;
    整128 大 = 1000000000000000000;
    结果<整128, 整32> 盒1 = 包装(大);
    如果 (盒1.正常) {
        整128 取1 = 盒1.值;
        如果 (取1 == 1000000000000000000) { 计 = 计 + 1; }
    }
    盒16 元 = 盒16{ 甲 = 5, 乙 = 6 };
    结果<盒16, 整32> 盒2 = 包装(元);
    如果 (盒2.正常) {
        盒16 取2 = 盒2.值;
        如果 (取2.甲 == 5 && 取2.乙 == 6) { 计 = 计 + 2; }
    }
    结果<整32, 整32> 盒3 = 包装(7);
    如果 (盒3.正常) {
        整32 取3 = 盒3.值;
        如果 (取3 == 7) { 计 = 计 + 4; }
    }
    打印("计:", 计);
    返回 0;
}
