// 映射集合库 E2E（Task 6.4，规格书 4.4 表.包含(键) + 集合）
// 覆盖：映射（设置 3 对键值→大小=3/包含/获取/覆盖已存在键→大小仍3且值更新/
//       删除→包含=假大小-1/获取不存在键→错误码）/ 集合（添加幂等/包含/删除）
// 模块导入：导入 映射集合::映射 / 映射集合::集合 / 映射集合::错误码
// 说明：结果<T,E> 强制检查（规格书07 规则1），每个结果调用赋值并检查 .正常 分支
// 打印语义（用户裁决）：打印=println（自动换行）
// 实测边界（Task 6.4）：
//   - 泛型类方法内循环遍历第一个泛型字段有运行时缺陷，已规避（循环放泛型自由函数）
//   - 打印变参内嵌"泛型类字段下标表达式"损坏——E2E 先存局部变量再打印（下方 取值打印 模式）

导入 映射集合::映射;
导入 映射集合::集合;
导入 映射集合::错误码;

函数 主() -> 整32 {
    打印("===== 映射集合库（Task 6.4）=====");

    // ==================== 1. 映射<K,V>（整32键 → 整32值） ====================
    映射<整32, 整32> 表 = 映射<整32, 整32>();
    如果 (表.为空()) {
        打印("映射初始为空: 是");
    } 否则 {
        打印("映射初始为空: 否");
    }

    // 设置 3 对键值（触发扩容 0 -> 4）
    结果<空类型, 整32> 设置结果 = 表.设置(1, 100);
    如果 (设置结果.正常) {
        设置结果 = 表.设置(2, 200);
        设置结果 = 表.设置(3, 300);
    } 否则 {
        打印("映射设置失败: ", 设置结果.错误);
    }
    打印("映射大小: ", 表.大小());

    // 包含（规格书 4.4 表.包含(键)）
    如果 (表.包含(2)) {
        打印("包含键2: 真");
    } 否则 {
        打印("包含键2: 假");
    }
    如果 (表.包含(99)) {
        打印("包含键99: 真");
    } 否则 {
        打印("包含键99: 假");
    }

    // 获取正确值（先存局部变量再打印，规避打印变参内嵌字段下标缺陷）
    结果<整32, 整32> 获取结果 = 表.获取(1);
    如果 (获取结果.正常) {
        整32 值1 = 获取结果.值;
        打印("获取键1: ", 值1);
    } 否则 {
        打印("获取键1失败: ", 获取结果.错误);
    }
    获取结果 = 表.获取(3);
    如果 (获取结果.正常) {
        整32 值3 = 获取结果.值;
        打印("获取键3: ", 值3);
    } 否则 {
        打印("获取键3失败: ", 获取结果.错误);
    }

    // 覆盖已存在键 → 大小仍 3 且值更新
    设置结果 = 表.设置(2, 222);
    如果 (设置结果.正常) {
        获取结果 = 表.获取(2);
        如果 (获取结果.正常) {
            整32 值2 = 获取结果.值;
            打印("覆盖后键2: ", 值2);
        } 否则 {
            打印("覆盖后读键2失败: ", 获取结果.错误);
        }
    } 否则 {
        打印("覆盖设置失败: ", 设置结果.错误);
    }
    打印("覆盖后大小: ", 表.大小());

    // 获取不存在的键 → 错误码.未初始化(7)
    获取结果 = 表.获取(99);
    如果 (获取结果.正常) {
        打印("获取键99未报错");
    } 否则 {
        打印("获取键99错误码: ", 获取结果.错误);
    }

    // 删除键 1 → 包含=假、大小-1
    布尔 删除结果 = 表.删除(1);
    如果 (删除结果) {
        打印("删除键1: 真");
    } 否则 {
        打印("删除键1: 假");
    }
    如果 (表.包含(1)) {
        打印("删除后包含键1: 真");
    } 否则 {
        打印("删除后包含键1: 假");
    }
    打印("删除后大小: ", 表.大小());

    // 删除不存在的键 → 返回假
    删除结果 = 表.删除(99);
    如果 (删除结果) {
        打印("删除键99: 真");
    } 否则 {
        打印("删除键99: 假");
    }

    // 清空
    表.清空();
    打印("清空后大小: ", 表.大小());

    // ==================== 2. 集合<T>（整32） ====================
    集合<整32> 值集 = 集合<整32>();
    如果 (值集.为空()) {
        打印("集合初始为空: 是");
    } 否则 {
        打印("集合初始为空: 否");
    }

    // 添加 1/2/3、再添加 2（幂等）→ 大小=3
    设置结果 = 值集.添加(1);
    如果 (设置结果.正常) {
        设置结果 = 值集.添加(2);
        设置结果 = 值集.添加(3);
        设置结果 = 值集.添加(2);
    } 否则 {
        打印("集合添加失败: ", 设置结果.错误);
    }
    打印("集合大小: ", 值集.大小());

    // 包含
    如果 (值集.包含(2)) {
        打印("集合包含2: 真");
    } 否则 {
        打印("集合包含2: 假");
    }
    如果 (值集.包含(99)) {
        打印("集合包含99: 真");
    } 否则 {
        打印("集合包含99: 假");
    }

    // 删除 → 大小-1
    删除结果 = 值集.删除(2);
    如果 (删除结果) {
        打印("集合删除2: 真");
    } 否则 {
        打印("集合删除2: 假");
    }
    打印("集合删除后大小: ", 值集.大小());
    如果 (值集.包含(2)) {
        打印("删除后包含2: 真");
    } 否则 {
        打印("删除后包含2: 假");
    }

    // 删除不存在的值 → 返回假
    删除结果 = 值集.删除(99);
    如果 (删除结果) {
        打印("集合删除99: 真");
    } 否则 {
        打印("集合删除99: 假");
    }

    值集.清空();
    打印("集合清空后大小: ", 值集.大小());

    打印("===== 映射集合库测试完成 =====");
    返回 0;
}
