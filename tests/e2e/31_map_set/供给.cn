导入 映射集合::映射;
导入 映射集合::集合;

// 31 符号供给（629-a 006 供给扩容轮·②b B7 扩容至 stdlib 面）：
//   v2p.obj 只实例化过 v2 树自身用过的泛型实例——本用例所需 映射<整32,整32>/
//   集合<整32> 全方法面若 v2 树未覆盖即 LNK2019（006 永久挂账机理）。本文件经
//   宿主真实管线编译为 .o（stdlib 源码级按需实例化——stdlib 面=006 扩容新增
//   覆盖域），链接置于 v2p.obj 之前兜底补符号。方法调用面=主.cn 全集。
//   注：副本 映射集合.cn 已删（漂移清理·629-a），用例与供给同用内置链桶实现。

函数 供给映射链() -> 整64 {
    映射<整32, 整32> 表 = 映射<整32, 整32>();
    结果<空类型, 整32> r = 表.设置(1, 10);
    如果 (r.正常) {
        r = 表.设置(2, 20);
    }
    结果<整32, 整32> g = 表.获取(1);
    如果 (g.正常) {
        r = 表.设置(3, g.值);
    }
    布尔 有无 = 表.包含(1);
    布尔 已删 = 表.删除(3);
    整64 n = 表.大小();
    布尔 空 = 表.为空();
    表.清空();
    如果 (有无 && 已删 && 空) {
        返回 n + 1;
    }
    返回 n;
}

函数 供给集合链() -> 整64 {
    集合<整32> 单 = 集合<整32>();
    结果<空类型, 整32> r = 单.添加(7);
    如果 (r.正常) {
        r = 单.添加(8);
    }
    布尔 有无 = 单.包含(7);
    布尔 已删 = 单.删除(8);
    整64 n = 单.大小();
    布尔 空 = 单.为空();
    单.清空();
    如果 (有无 && 已删 && 空) {
        返回 n + 2;
    }
    返回 n;
}

// 宿主编译入口（cn build 需要主函数；链接 muldefs 下 v2asm 在前，cn_main 归 v2 产物）
函数 主() -> 整32 {
    返回 整32(供给映射链() + 供给集合链());
}
