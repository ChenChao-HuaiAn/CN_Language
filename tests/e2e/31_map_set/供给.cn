// E2E 31 符号供给（002 双测转批·932 轮）：v2 生成代码引用 映射集合 模块泛型
//   实例符号（查找值位置$整32 等）——v2p.obj 只含 v2 树自用实例化，本文件经
//   宿主真实管线编译为 .o 参与链接（置于 v2p.obj 之前·符号与布局权威）。
//   方法面=主.cn 实际调用集（为空/设置/大小/包含/获取/删除/清空/添加）。

导入 映射集合::映射;
导入 映射集合::集合;

函数 供给映射面() -> 整32 {
    映射<整32, 整32> 表 = 映射<整32, 整32>();
    如果 (表.为空()) {
        返回 1;
    }
    结果<空类型, 整32> 设置结果 = 表.设置(1, 100);
    如果 (!设置结果.正常) {
        返回 2;
    }
    设置结果 = 表.设置(2, 200);
    设置结果 = 表.设置(3, 300);
    如果 (表.大小() != 3) {
        返回 3;
    }
    如果 (!表.包含(2)) {
        返回 4;
    }
    结果<整32, 整32> 获取结果 = 表.获取(1);
    如果 (!获取结果.正常) {
        返回 5;
    }
    布尔 删除结果 = 表.删除(2);
    如果 (!删除结果) {
        返回 6;
    }
    表.清空();
    如果 (表.大小() != 0) {
        返回 7;
    }
    返回 0;
}

函数 供给集合面() -> 整32 {
    集合<整32> 值集 = 集合<整32>();
    结果<空类型, 整32> 添加结果 = 值集.添加(10);
    如果 (!添加结果.正常) {
        返回 11;
    }
    添加结果 = 值集.添加(20);
    如果 (!值集.包含(10)) {
        返回 12;
    }
    如果 (值集.大小() != 2) {
        返回 13;
    }
    布尔 删除结果2 = 值集.删除(10);
    如果 (!删除结果2) {
        返回 14;
    }
    值集.清空();
    如果 (值集.大小() != 0) {
        返回 15;
    }
    返回 0;
}

// 宿主编译入口（cn build 需要主函数；链接 muldefs 下 v2asm 在前，cn_main 归 v2 产物）
函数 主() -> 整32 {
    返回 供给映射面() + 供给集合面();
}
