// 190：类型推断声明宿主锚定（46-c 观察项宿主侧 + 本轮宿主缺陷根治，2026-09-10
//   第四十九轮）——规范 03 变量声明形式1：变量 标识符 = 表达式（类型推断）。
//   八形态：整数字面量→整32 / 字符串字面量→字符串 / 标识符拷贝 / L 后缀→整64 /
//   调用返回→整64 / 成员读→结构体（本轮宿主根治：语义层推断回填写回 AST
//   节点 typeName——原仅更新符号表，IR 层落空类型→结构体源单 i32 槽截断）/
//   嵌套成员读→整32 / 二元→整32。v2 侧同源用例=190_v2（rc=255 校验和闭环）。
函数 取值() -> 整64 {
    返回 77;
}

结构体 点 {
    整32 x
    整32 y
}

结构体 矩形 {
    点 左上
    点 右下
}

函数 主() -> 整32 {
    变量 a = 41;
    变量 s = "好";
    变量 b = a;
    变量 长 = 42L;
    变量 调 = 取值();
    矩形 r = 矩形{ 左上 = 点{ x = 5, y = 6 }, 右下 = 点{ x = 0, y = 0 } };
    变量 t = r.左上;
    变量 x值 = r.左上.x;
    变量 和 = a + 7;
    打印(a);
    打印(b);
    打印(长);
    打印(调);
    打印(t.x);
    打印(t.y);
    打印(x值);
    打印(和);
    如果 (字符串比较(s, "好")) {
        打印(1);
    } 否则 {
        打印(0);
    }
    返回 0;
}
