// E2E 805：外部 函数（FFI）整64 大值传参往返（任务 110 锁用例）
// 缺陷史：外部 函数 调用符号=纯名（C 符号无 mangling），IR 层语义查表
//   用纯名 miss 签名 key 回退 i32——三后端返回值恒按 32 位读（eax/w0+
//   符号扩展），>2^32 大值低 32 截断（llabs(4294967297)→1 实录：arm64
//   与 linux x64 运行级同塌·win x64 同构；v2 双后端全读本即正确）。
//   110 根治：miss 回退查签名 key（#435 fnptr 同族先例）。
// 覆盖：整64 FFI 往返 2^32 边界上/下、负大值（符号扩展面）、有符号 64 位
//   极值；FFI 声明=libc llabs（链接库三平台默认，62_ffi 同款先例）。
// 铁律锚点：实参装载通道（mov rdi/mov x0 64 位）本即无病——本用例防的是
//   返回值接收通道位宽塌缩复活。

外部 函数 llabs(整64 x) -> 整64

不安全 函数 主() -> 整32 {
    打印("===== 805 外部函数整64传参 =====");

    // 1. 2^32 边界上（4294967297 = 2^32+1）：塌缩敏感（低 32 位=1）
    整64 上 = 4294967297;
    打印("界上: ", llabs(上));                       // 4294967297

    // 2. 2^32 边界下（4294967295 = 2^32-1）：合法大值对照
    整64 下 = 4294967295;
    打印("界下: ", llabs(下));                       // 4294967295

    // 3. 负大值（-5e9）：符号扩展面（低 32 位=705032704 正数）
    整64 负大 = 0 - 5000000000;
    打印("负大绝对: ", llabs(负大));                 // 5000000000

    // 4. 有符号 64 位极值（2^63-1）：全位宽敏感
    整64 极 = 0 - 9223372036854775807;
    打印("极值绝对: ", llabs(极));                   // 9223372036854775807

    // 5. 返回值参与运算（往返和：4294967297+1=4294967298）
    打印("往返加一: ", llabs(上) + 1);               // 4294967298

    打印("===== 805 完成 =====");
    返回 0;
}
