// 1044_闭包多实例独立快照（#482 修复转正：蹦床闭包同一定义点多实例共享静态槽
//   后写覆盖根治）。面：
//   ① 跨函数多实例（原 p482b）：造(7)/造(107) 两实例共存交叉回读——7/107/7；
//   ② 循环内重赋值外层闭包变量（原 p482）：块外回读新实例——7/107；
//   ③ 拷贝链独立快照（原 p482e）：g=f 后 f 重赋值，g 保持旧实例——7/107；
//   ④ 字面量重赋值（原 p482f）：0/7。
函数 造(整32 数) -> 整32(*)() {
    变量 f = [数]() -> 整32 { 返回 数; };
    返回 f;
}
函数 主() -> 整32 {
    变量 甲 = 造(7);
    变量 乙 = 造(107);
    打印(甲());
    打印(乙());
    打印(甲());
    变量 丙 = [=]() -> 整32 { 返回 0; };
    变量 丁 = [=]() -> 整32 { 返回 0; };
    循环 (整32 i = 0; i < 2; i += 1) {
        如果 (i == 0) { 丙 = 造(7); } 否则 { 丁 = 造(107); }
    }
    打印(丙());
    打印(丁());
    变量 f = 造(7);
    变量 g = f;
    f = 造(107);
    打印(g());
    打印(f());
    变量 h = [=]() -> 整32 { 返回 0; };
    打印(h());
    h = [=]() -> 整32 { 返回 7; };
    打印(h());
    返回 0;
}
