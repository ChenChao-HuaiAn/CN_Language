// E2E 1354（#1030·1017 采样轮探针 p19 同族·dual 正例）：泛型引用形参组合形态族
//   ——T& 双参隐式推导 × 多实例（整32/整64/浮64）+ 成员/下标实参面；
//   「打印」=带换行输出（「打印行」不带换行=既有反直觉现实·教训 #234）。
//   修前病史（本任务四修）：
//   ①宿主误拒「未声明的标识符 '交换'」（1005 前 T& 位推导恒败=规范明文示例被拒）；
//   ②v2 同因实例未发射=链接 undefined（_名_A_T54_A_T54 双实参位零诊断缺符号）；
//   ③v2 浮64 引用读值登记 T_整64（宽度码）→ 下游 浮点宽化存储 当整源
//     cvtsi2sd 错转位模式（浮64 交换读出 4609434218613702656 级垃圾）；
//   ④v2 成员/下标实参推导缺=同名 undefined（宿主合法程序 v2 静默链接败）。
//   期望 stdout 10 行：2/1/4000000000/3000000000/2.500000/1.500000/20/10/7/5。
泛型 <类型 T>
函数 交换(T& 甲, T& 乙) -> 空类型 {
    T 临时 = 甲;
    甲 = 乙;
    乙 = 临时;
}
结构体 盒 {
    整32 值;
    整32 副;
}
函数 主() -> 整32 {
    整32 a = 1;
    整32 b = 2;
    交换(a, b);
    打印(a);
    打印(b);
    整64 c = 3000000000;
    整64 d = 4000000000;
    交换(c, d);
    打印(c);
    打印(d);
    浮64 x = 1.5;
    浮64 y = 2.5;
    交换(x, y);
    打印(x);
    打印(y);
    盒 h;
    h.值 = 10;
    h.副 = 20;
    交换(h.值, h.副);
    打印(h.值);
    打印(h.副);
    整32[3] 表;
    表[0] = 5;
    表[1] = 6;
    表[2] = 7;
    交换(表[0], 表[2]);
    打印(表[0]);
    打印(表[2]);
    返回 0;
}
