// E2E 123（P7b）：v2 容器类型实例化与容器方法调用六步闭环。
// 覆盖：向量<整64> 构造/追加/元素/大小；映射<整64,整64> 设置/获取/清空/大小；
//   结果<T,整32> 接收 + .正常/.值 条件分支（获取未命中走假分支）；
//   向量<字符串> 追加（字符串常量数据段）/大小；RAII 析构（双容器返回前自动释放）。
// 609-a（T100·123 规则1 转批）：设置 返回 结果<空类型,整32>，表达式语句丢弃
//   触发规则1（结果丢弃未检查=错误·宿主 checkResultDiscard/v2 同款）——
//   两处 设置 改接收式（设1/设2），余形态不变。
// 退出码 = 2*10000 + 10*100 + 32 + 300 + 0*10 + 1 = 21333。
导入 容器::向量;
导入 映射集合::映射;

函数 主() -> 整32 {
    向量<整64> 表 = 向量<整64>();
    结果<空类型, 整32> 加1 = 表.追加(10);
    结果<空类型, 整32> 加2 = 表.追加(32);
    映射<整64, 整64> 字典 = 映射<整64, 整64>();
    结果<空类型, 整32> 设1 = 字典.设置(3, 300);
    结果<空类型, 整32> 设2 = 字典.设置(4, 40);
    整64 取和 = 0;
    结果<整64, 整32> 取 = 字典.获取(3);
    如果 (取.正常) { 取和 = 取.值; }
    结果<整64, 整32> 取2 = 字典.获取(99);
    如果 (取2.正常) { 取和 = 取和 + 1000; }
    向量<字符串> 行 = 向量<字符串>();
    结果<空类型, 整32> 加行 = 行.追加("甲");
    字典.清空();
    返回 整32(表.大小() * 10000 + 表.元素(0) * 100 + 表.元素(1) + 取和 +
              字典.大小() * 10 + 行.大小());
}
