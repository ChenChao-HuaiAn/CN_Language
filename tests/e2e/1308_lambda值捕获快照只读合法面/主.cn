// 1308_lambda值捕获快照只读合法面（#1881·快照只读立法零误伤对照·dual 正测）
// 与 1670 负测互补：值捕获快照只读执法不得误伤的合法面全谱：
//   ①[&] 写穿（写穿原变量·条文写穿语义明说） ②读快照（定义后改源不影响快照）
//   ③lambda 参数同名遮蔽写（写参数槽非捕获快照） ④体内声明同名遮蔽写
//   ⑤捕获容器读方法+读快照 ⑥不安全 函数内定义 lambda 写值捕获（435 同款
//   责任上移豁免）
// 预期：双侧编译绿+输出逐行一致。
导入 容器::向量;

类 计数 {
    公开:
        整32 值;
}

// ①[&] 写穿：写穿原变量（外部可见）
函数 写穿面() -> 整32 {
    变量 z = 1;
    变量 h = [&]() -> 整32 {
        z = z + 1;
        返回 z;
    };
    h();
    打印行("写穿=", z);            // 2（写穿原变量）
    返回 z;
}

// ②读快照：定义后改源不影响快照（698 读面同款）
函数 读快照面() -> 整32 {
    变量 x = 10;
    变量 取x = [x]() -> 整32 { 返回 x; };
    x = 99;
    打印行("快照=", 取x());        // 10（快照·非 99）
    返回 0;
}

// ③参数同名遮蔽：写的是参数槽（[w](整32 w)——参数 w 遮蔽外层捕获 w）
函数 参数遮蔽面() -> 整32 {
    变量 w = 100;
    变量 k = [w](整32 w) -> 整32 {
        w = w * 2;
        返回 w;
    };
    打印行("参数遮蔽=", k(3));     // 6（参数槽 3*2）
    打印行("外部w=", w);           // 100（外部不受影响）
    返回 0;
}

// ④体内声明同名遮蔽：写的是体内局部变量
函数 声明遮蔽面() -> 整32 {
    变量 x = 5;
    变量 f = [=]() -> 整32 {
        变量 x = 100;
        x = x + 1;
        返回 x;
    };
    打印行("声明遮蔽=", f());      // 101（体内局部）
    打印行("外部x=", x);           // 5（外部不受影响）
    返回 0;
}

// ⑤捕获容器读方法+读快照（读方法不入写方法白名单=合法）
函数 容器读面() -> 整32 {
    向量<整32> v;
    结果<空类型, 整32> 加r = v.追加(3);
    如果 (加r.正常) {
    } 否则 {
    }
    变量 f2 = [=]() -> 整64 {
        返回 v.大小() + v.元素(0);
    };
    打印行("容器读=", f2());       // 4（大小 1 + 元素 3）
    返回 0;
}

// ⑥不安全 函数内定义 lambda 写值捕获（435 同款责任上移豁免·合法）
不安全 函数 豁免面() -> 整32 {
    变量 q = 5;
    变量 f3 = [=]() -> 整32 {
        q = q + 1;
        返回 q;
    };
    返回 f3();                     // 6（豁免面·写副本快照内自增可见）
}

函数 主() -> 整32 {
    写穿面();
    读快照面();
    参数遮蔽面();
    声明遮蔽面();
    容器读面();
    打印行("豁免=", 豁免面());     // 6
    返回 0;
}
