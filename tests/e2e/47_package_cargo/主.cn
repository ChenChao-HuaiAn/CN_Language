// 主入口（模块系统 v2.0 第 5 层：货舱.toml 依赖管理，规格书09）
// 覆盖：
//   ① 本地依赖：导入 网络库::连接（[依赖] 网络库 = "本地" -> 依赖/网络库/ 子目录）
//   ② 库 crate 根 包.cn：公开 导入 网络::连接 再导出（外部 网络库::连接 可用）
//   ③ 子模块再导出：公开 导入 网络::传输控制::发送（目录层级）
//   ④ 内置依赖：核心 = "内置"（编译器 stdlib 目录兜底）
// 验证：货舱.toml 自动发现（编译入口同目录）——run_e2e 直接编译 主.cn，
//      入口同目录存在 货舱.toml 即自动加载 [依赖] 配置

导入 网络库::连接;
导入 网络库::传输控制::发送;
导入 核心::交换;

函数 主() -> 整32 {
    打印("===== 货舱.toml 依赖管理（第 5 层）=====");

    // ---- ① 本地依赖：网络库 来自 货舱.toml [依赖] ----
    整32 连接码 = 连接();
    打印("连接(): ", 连接码);                    // 42

    // ---- ③ 子模块再导出：网络库::传输控制::发送 ----
    整32 发送码 = 发送();
    打印("发送(): ", 发送码);                    // 99

    // ---- ④ 内置依赖：核心 = "内置"（编译器 stdlib 目录，泛型函数跨 crate 单态化）----
    整32 甲 = 42;
    整32 乙 = 7;
    交换<整32>(&甲, &乙);
    打印("交换后 甲: ", 甲);                    // 7
    打印("交换后 乙: ", 乙);                    // 42

    打印("===== 货舱.toml 依赖管理测试完成 =====");
    返回 0;
}
