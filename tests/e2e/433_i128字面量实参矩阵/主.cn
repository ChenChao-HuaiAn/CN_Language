// E2E 433（331-a·T53 根因修正）：i128 字面量实参 × 调用形态矩阵
//   背景：方法调用路径（实例方法）缺 i128 形参宽化——字面量实参在 IR 中为窄整
//   （i64）按值直传 → 被调方按 i128 指针解引用（i64 值当地址）→ SIGSEGV（实弹
//   run_err/m53_01：向量<整128>.追加(100000000000) rc=139）。普通调用/构造路径
//   已有修复（m45_03），本轮补齐实例方法+虚调用路径（单一归属 widenI128Args）+
//   容器端到端（i128 元素追加/元素/大小）。
//   诚实边界：虚调用路径（`自身.虚方法(字面量)`）同轮同修并以探针实测通过
//   （输出 200000000000）——用例面因「导入 容器 后 自身 成员解析」与安全边界的
//   交互暂不并入本文件，登记后续 E2E 面补。
导入 容器::向量;
函数 普通(整128 值) -> 整32 { 打印行(整64(值)); 返回 0; }
类 持 {
公开:
    整128 存;
    函数 持(整128 初值) { 存 = 初值; }
    函数 取值() -> 整128 { 返回 存; }
    函数 装填(整128 值) -> 整32 { 存 = 值; 打印行(整64(存)); 返回 0; }
}
函数 主() -> 整32 {
    普通(100000000000);
    持 容器 = 持(300000000000);
    打印行(整64(容器.取值()));
    容器.装填(200000000000);
    向量<整128> 表 = 向量<整128>();
    结果<空类型, 整32> 加1 = 表.追加(400000000000);
    打印行(表.大小());
    整128 取0 = 表.元素(0);
    打印行(整64(取0));
    返回 0;
}
