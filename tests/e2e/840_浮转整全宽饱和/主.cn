// 840（任务 528·475 甲案全宽收族）：浮点→整数族全宽饱和截断+NaN→0 dual 门禁
//   plans/001 §3.7b（2026-10-13 用户裁决「Rust as 全对齐」）。覆盖三面：
//   ①编译期常量折叠路径（字面量直转·宿主 foldCast 饱和折叠）
//   ②运行期变量路径（三后端 __cn_fXX_to_YY 饱和辅助族·win/linux/arm64 同语义）
//   ③全宽矩阵：域内向零截断/正超域→MAX/负超域→MIN（无符号→0）/NaN→0
//   宿主+v2 双编译对照同测本 .expected（800 同款配置）；窄宽结果经 整64()
//   显式提升打印（位模式扩展值不变·兼测窄槽写入+窄读扩展链）。
函数 主() -> 整32
{
    // ===== ① 编译期常量折叠路径（字面量直转） =====
    整32 折超 = 整32(1.0e18);
    打印行("折 整32(1e18)=", 折超);
    打印("");
    整32 折截 = 整32(3.99);
    打印行("折 整32(3.99)=", 折截);
    打印("");
    整64 折超64 = 整64(1.0e19);
    打印行("折 整64(1e19)=", 折超64);
    打印("");
    整8 折窄 = 整8(200.5);
    打印行("折 整8(200.5)=", 整64(折窄));
    打印("");
    正16 折无负 = 正16(-100000.0);
    打印行("折 正16(-1e5)=", 整64(折无负));
    打印("");
    整16 折窄16 = 整16(1.0e10);
    打印行("折 整16(1e10)=", 整64(折窄16));
    打印("");
    整32 折除 = 整32(0.0 / 0.0);
    打印行("折 整32(0/0)=", 折除);
    打印("");

    // ===== ② 运行期变量路径（浮64 源·≤64 全宽） =====
    浮64 f18 = 1.0e18;
    浮64 f负18 = -1.0e18;
    浮64 f19 = 1.0e19;
    浮64 f负19 = -1.0e19;
    浮64 f20 = 1.0e20;
    浮64 f39 = 1.0e39;
    浮64 f负39 = -1.0e39;
    浮64 fNaN = 0.0 / 0.0;

    整32 甲 = 整32(f18);
    打印行("整32(1e18)=", 甲);
    打印("");
    整32 乙 = 整32(f负18);
    打印行("整32(-1e18)=", 乙);
    打印("");
    整32 丙 = 整32(fNaN);
    打印行("整32(NaN)=", 丙);
    打印("");
    整64 丁 = 整64(f18);
    打印行("整64(1e18)=", 丁);
    打印("");
    整64 戊 = 整64(f19);
    打印行("整64(1e19)=", 戊);
    打印("");
    整64 己 = 整64(f负19);
    打印行("整64(-1e19)=", 己);
    打印("");
    整64 庚 = 整64(fNaN);
    打印行("整64(NaN)=", 庚);
    打印("");
    正64 辛 = 正64(f19);
    打印行("正64(1e19)=", 辛);
    打印("");
    正64 壬 = 正64(f20);
    打印行("正64(1e20)=", 壬);
    打印("");
    正64 癸 = 正64(fNaN);
    打印行("正64(NaN)=", 癸);
    打印("");
    整8 子 = 整8(f18);
    打印行("整8(1e18)=", 整64(子));
    打印("");
    正8 丑 = 正8(f负18);
    打印行("正8(-1e18)=", 整64(丑));
    打印("");
    正32 卯 = 正32(f18);
    打印行("正32(1e18)=", 卯);
    打印("");

    // ===== 128 面（464 通道同构收族·528 正128 切无符号辅助） =====
    整128 辰 = 整128(f19);
    打印行("整128(1e19)=", 辰);
    打印("");
    整128 巳 = 整128(f39);
    打印行("整128(1e39)=", 巳);
    打印("");
    整128 午 = 整128(f负39);
    打印行("整128(-1e39)=", 午);
    打印("");
    整128 未 = 整128(fNaN);
    打印行("整128(NaN)=", 未);
    打印("");
    正128 申 = 正128(f39);
    打印行("正128(1e39)=", 申);
    打印("");
    正128 酉 = 正128(f负19);
    打印行("正128(-1e19)=", 酉);
    打印("");

    // ===== 浮32 源面（f32 饱和辅助族） =====
    浮32 单大 = 浮32(1.0e10);
    浮32 单小 = 浮32(3.75);
    浮32 单负 = 浮32(-1.0e10);
    整32 戌 = 整32(单大);
    打印行("整32(f32 1e10)=", 戌);
    打印("");
    整16 亥 = 整16(单小);
    打印行("整16(f32 3.75)=", 整64(亥));
    打印("");
    正16 甲一 = 正16(单负);
    打印行("正16(f32 -1e10)=", 整64(甲一));
    打印("");
    返回 0;
}
