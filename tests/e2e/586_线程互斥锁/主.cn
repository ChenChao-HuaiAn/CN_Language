// 996（027 波 1·E2E 正测·linux 云端真线程面）：两线程互斥锁保护计数——
//   静态共享计数+两线程各累加一万次·互斥锁三函数闭环·顺序一致语义。
//   win=运行时桩（运行时错误9·thread_api 桩）——本用例 win 本地跳过
//   （run_e2e 平台跳过 win-x64 "586_线程互斥锁"）·linux 全量真跑。
导入 线程::新线程;
导入 线程::并入线程;
导入 线程::互斥锁新建;
导入 线程::互斥锁上锁;
导入 线程::互斥锁解锁;
导入 线程::互斥锁释放;

静态 空类型* 互斥锁句柄 = 无;
静态 整64 计数 = 0;

函数 累加任务(空类型* 未用) -> 整64 {
    循环(整64 i = 0; i < 10000; i++) {
        互斥锁上锁(互斥锁句柄);
        计数 = 计数 + 1;
        互斥锁解锁(互斥锁句柄);
    }
    返回 0;
}

函数 主() -> 整32 {
    互斥锁句柄 = 互斥锁新建();
    空类型* 线程甲 = 新线程(累加任务, 无);
    空类型* 线程乙 = 新线程(累加任务, 无);
    并入线程(线程甲);
    并入线程(线程乙);
    打印行(计数);
    互斥锁释放(互斥锁句柄);
    返回 0;
}
