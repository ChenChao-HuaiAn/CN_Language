// E2E 942_JSON生成泄漏断言（#728p·2026-10-14·宿主单侧）：JSON 生成路径分配
//   泄漏断言纵深——216 口径（内存::活动分配数）：生成JSON 出串计 1（tracked·
//   RAII 随段退出释放）、段退出后回落差=0（生成路径临时/构建器缓冲全释放）。
//   〔宿主单侧〕本用例窗口含 生成JSON 返回与 整数转字符串/浮点转字符串 的
//   变量初始化位——v2 侧 A2 返回拥有登记缺口每处漏 1（零分叉·已立 #748），
//   故本用例宿主绿收口·v2 面挂 #748；清偿轮加 双编译对照.txt 扩 dual
//   （先例=859 挂 #594 缩形后扩回）。
//   断言走 测试框架（JSON+测试框架 双模块同轮）。
导入 测试框架::{测试器, 运行用例, 断言相等整数, 测试汇总};
导入 JSON::{JSON树, 解析JSON, 生成JSON, JSONE_好};

// 生成出串段：返回「完成时刻-入口」活动分配数差（应=1：出串计 1·生成路径
//   临时（数值转换/构建器缓冲）全释放）
//   〔面注〕段内禁打印——打印 字符串变参临时存在不释放的既有缺口（#617·
//   非本用例面），断言窗口内不得混入无关分配。
不安全 函数 生成出串段(JSON树* 树, 整64 缩进) -> 整64 {
    整64 前分配 = 内存::活动分配数();
    字符串 出 = 生成JSON(树, 树.根, 缩进);
    整64 中分配 = 内存::活动分配数();
    返回 中分配 - 前分配;
}

不安全 函数 用例泄漏断言(测试器* 器) {
    JSON树 树 = JSON树();
    // 含字符串/整数/浮点/嵌套/空壳——生成路径覆盖 整数转字符串/浮点转字符串/
    //   字符串字面转义/子链遍历 全链
    解析JSON(树, "{\"串\":\"值\",\"整\":-9223372036854775807,\"浮\":0.25,\"嵌\":[1,2.5,\"三\",[]],\"空\":{}}");
    断言相等整数(器, 树.错误码, JSONE_好, "泄漏断言树解析");
    // 紧凑与美化两形态窗口各测（出串计 1 + 退出回落 0）
    整64 基线 = 内存::活动分配数();
    整64 出串差 = 生成出串段(树, 0);
    整64 回落差 = 内存::活动分配数() - 基线;
    断言相等整数(器, 出串差, 1, "紧凑生成出串计1");
    断言相等整数(器, 回落差, 0, "紧凑生成后回落差0");
    基线 = 内存::活动分配数();
    出串差 = 生成出串段(树, 2);
    回落差 = 内存::活动分配数() - 基线;
    断言相等整数(器, 出串差, 1, "美化生成出串计1");
    断言相等整数(器, 回落差, 0, "美化生成后回落差0");
}

不安全 函数 主() -> 整32 {
    测试器 器 = 测试器();
    运行用例(器, "泄漏断言", 用例泄漏断言);
    整64 失败数 = 测试汇总(器);
    打印("汇总返回失败用例数=", 失败数);
    返回 0;
}
