// 官网文档示例 · reference/functions.html · 传参（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
类 盒子 {
公开:
    整64 值槽;
    函数 盒子(整64 初) { 值槽 = 初; }
}

结构体 点 {
    整64 x;
}

函数 改标量(整32 v) -> 空类型 { v = 99; }        // 副本
函数 改结构(点 p) -> 空类型 { p.x = 99; }        // 副本
函数 改类(盒子 b) -> 空类型 { b.值槽 = 99; }     // 句柄：写穿！
函数 改引用(整64& v) -> 空类型 { v = 99; }       // 引用：写穿

函数 主() -> 整32 {
    整32 标 = 1;
    点 结构点 = 点{x = 1};
    盒子 对象 = 盒子(1);
    整64 引值 = 1;
    改标量(标);
    改结构(结构点);
    改类(对象);
    改引用(引值);
    打印(标, " ", 结构点.x, " ", 对象.值槽, " ", 引值);
    返回 0;
}