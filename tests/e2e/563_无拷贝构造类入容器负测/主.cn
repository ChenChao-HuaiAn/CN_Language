导入 容器::栈;
类 盒子 {
公开:
    字符串 名;
    整64 号;
    函数 盒子(整64 v) { 号 = v; }
}
不安全 函数 主() -> 整32 {
    {
        栈<盒子> 表 = 栈<盒子>();
        盒子 甲 = 盒子(9);
        甲.名 = 字符串复制("CCCCCCCCCCCCCCCCCCCC");
        结果<空类型, 整32> 压 = 表.压入(甲);
        如果 (!压.正常) { 返回 1; }
        结果<盒子, 整32> 弹 = 表.弹出();
        如果 (弹.正常) { 打印("弹号=", 弹.值.号); }
    }
    返回 0;
}
