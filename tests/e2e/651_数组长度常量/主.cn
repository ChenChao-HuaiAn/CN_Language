// 651（#286 收口锚）：数组长度=编译期常量表达式（001 §3.5 甲案·常量名/常量算术）
//   v14 采样 p1007_06 双侧同拒（96「引用处替换」未含长度位）→双侧折叠收口
常量 尺寸 = 4;
函数 主() -> 整32 {
    整32[尺寸] arr;
    整32[尺寸 * 2 + 1] 矩阵;
    arr[0] = 7;
    arr[尺寸 - 1] = 9;
    矩阵[尺寸 * 2] = 5;
    打印("a0=", arr[0]);
    打印("a3=", arr[3]);
    打印("m8=", 矩阵[8]);
    返回 0;
}
