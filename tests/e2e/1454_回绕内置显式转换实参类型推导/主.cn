// E2E 1454（1311·#1281 返工调查）：回绕内置 回绕加/回绕减/回绕乘 的显式转换/
//   内建/用户函数调用实参类型推导（001 §3.7a「回绕与算术运算符同类型规则」）。
//   现象（v2 单端）：回绕实参为 节点_调用（显式转换 整8(x)/正8(x)…）时
//   回绕实参侧类型474 只链 查函数返回回退（对类型名恒 miss）→双侧双盲 →
//   登记内部未登记并以整64 宽回绕兜底（`回绕加(整8(100),整8(100))` 编译中止）；
//   宿主把 整8(x) 解析为 CastExpr 直接返回目标类型 → 按窄域回绕。
//   修法：v2 语义/IR 两推导点补转换目标类型 + 用户函数/内置返回类型；285 窄域
//   字面量豁免改按字面量形态判定；公共提升改整数族秩（整8≠整32）。
//   本轮返工（P0/P1-2）：IR 结果域同步按秩（禁复用 公共整型提升）；窄变量+
//   128 域字面量在 128 helper 前取低半落常规回绕（宿主 285 窄化）。
//   本用例=宿主+v2 同源同测：30 形态位权 1..536870912 全过=1073741823（任一失败
//   即定位具体位）。断言直接比较不落窄变量存储，宽/窄结果域差异可判。
函数 取八() -> 整8 { 返回 100; }
函数 取三二() -> 整32 { 返回 100; }

函数 主() -> 整32 {
    整32 校验 = 0;
    整8 甲 = 100;
    字符串 长串 = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx";
    // ---- 双显式转换（修前 v2 双盲整64 中止）----
    如果 (回绕加(整8(100), 整8(100)) == 整8(-56)) { 校验 = 校验 + 1; }
    如果 (回绕减(整8(-128), 整8(1)) == 整8(127)) { 校验 = 校验 + 2; }
    如果 (回绕乘(整8(100), 整8(2)) == 整8(-56)) { 校验 = 校验 + 4; }
    // ---- 转换 + 字面量（285 窄域字面量豁免：字面量按窄侧参与）----
    如果 (回绕加(整8(100), 100) == 整8(-56)) { 校验 = 校验 + 8; }
    如果 (回绕减(1, 正8(2)) == 正8(255)) { 校验 = 校验 + 16; }
    // ---- 转换 + 变量（双向）----
    如果 (回绕加(整8(100), 甲) == 整8(-56)) { 校验 = 校验 + 32; }
    如果 (回绕加(甲, 整8(100)) == 整8(-56)) { 校验 = 校验 + 64; }
    // ---- 正8 双转换 ----
    如果 (回绕加(正8(255), 正8(1)) == 正8(0)) { 校验 = 校验 + 128; }
    如果 (回绕乘(正8(200), 正8(2)) == 正8(144)) { 校验 = 校验 + 256; }
    如果 (回绕减(正8(0), 正8(1)) == 正8(255)) { 校验 = 校验 + 512; }
    // ---- 整16/正16 ----
    如果 (回绕加(整16(30000), 整16(30000)) == 整16(-5536)) { 校验 = 校验 + 1024; }
    如果 (回绕乘(正16(60000), 正16(2)) == 正16(54464)) { 校验 = 校验 + 2048; }
    如果 (回绕减(正16(0), 正16(1)) == 正16(65535)) { 校验 = 校验 + 4096; }
    // ---- 用户函数返回类型作实参（双向·语义符号表/IR 签名表）----
    如果 (回绕加(取八(), 整8(100)) == 整8(-56)) { 校验 = 校验 + 8192; }
    如果 (回绕加(整8(100), 取八()) == 整8(-56)) { 校验 = 校验 + 16384; }
    // ---- 宽转换/宽返回 + 窄变量：整数族秩高者胜（整32 域，200 不截断）----
    如果 (回绕加(整32(100), 甲) == 整32(200)) { 校验 = 校验 + 32768; }
    如果 (回绕加(整8(100), 取三二()) == 整32(200)) { 校验 = 校验 + 65536; }
    // ---- 128 → 窄转换 ----
    如果 (回绕加(整8(整128(511)), 整8(1)) == 整8(0)) { 校验 = 校验 + 131072; }
    // ---- 变量 + 字面量（既有形态零回归）----
    如果 (回绕加(甲, 100) == 整8(-56)) { 校验 = 校验 + 262144; }
    // ---- 内建调用返回类型作实参（字符串长度=整64·长度>127：窄化会得 300%256）----
    如果 (回绕加(字符串长度(长串), 整8(100)) == 整64(300)) {
        校验 = 校验 + 524288;
    }
    // ---- 嵌套回绕（内层窄域结果作实参）----
    如果 (回绕加(回绕加(整8(100), 整8(100)), 整8(1)) == 整8(-55)) {
        校验 = 校验 + 1048576;
    }
    // ---- P0 整数族秩：整8+整16 双向（16 位回绕 100+32767=-32669）----
    如果 (回绕加(整8(100), 整16(32767)) == 整16(-32669)) { 校验 = 校验 + 2097152; }
    如果 (回绕加(整16(32767), 整8(100)) == 整16(-32669)) { 校验 = 校验 + 4194304; }
    // ---- P0 整数族秩：整8+整32 双向（32 位溢出 1+2147483647=-2147483648）----
    如果 (回绕加(整8(1), 整32(2147483647)) == 整32(-2147483648)) {
        校验 = 校验 + 8388608;
    }
    如果 (回绕加(整32(2147483647), 整8(1)) == 整32(-2147483648)) {
        校验 = 校验 + 16777216;
    }
    // ---- P0 同秩左优先：整32(-1)+0U 结果整32(-1)（若右胜则 4294967295）----
    如果 (回绕加(整32(-1), 0U) == 整32(-1)) { 校验 = 校验 + 33554432; }
    // ---- P1-2 窄变量+128 域字面量：285 豁免窄化（2^64 低 8 位=0 → 100）----
    如果 (回绕加(甲, 18446744073709551616) == 整8(100)) {
        校验 = 校验 + 67108864;
    }
    如果 (回绕加(18446744073709551616, 甲) == 整8(100)) {
        校验 = 校验 + 134217728;
    }
    // ---- 复审 P1 二元运算实参：内层普通算术语义 resolvedType=整32（同秩左
    //   优先·宿主 wrap 按语义 Cast；宿主自身 IR 取正32 双口径）----
    如果 (回绕加(整32(-1) + 0U, 整8(0)) == 整32(-1)) {
        校验 = 校验 + 268435456;
    }
    如果 (回绕加(整32(-1) + 0U, 整8(0)) < 0) {
        校验 = 校验 + 536870912;
    }
    打印(校验);
    返回 0;
}
