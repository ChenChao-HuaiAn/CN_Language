// E2E 982（787）：结果<T,整32> 载荷宽型全谱锁定（dual·宿主+v2 同源对照）
//   背景：v2 结果载荷字节 豁免表缺 整128/正128（16B 宽型）与 字符（4B·979）——
//   泛型容器（向量<T>.读取/弹出/栈顶 返回 结果<T,整32>）单态化即触达查表
//   miss 中止（57/433 win 双编译对照存量红·648 显形化后显形）。
//   修=①结果载荷字节 补两宽型豁免（整128/正128=固定 16B 值载荷·确权不求值，
//   与 774 数组真求值哲学区分）+字符（4B 圆整 8·与浮32 同档）；
//   ②生成表达式装箱 128 位标量载荷=「值=地址」句柄双半拷（原 IR_指针存储
//   8B 直存把句柄地址当值写进盒内载荷）。宿主零改动（typeSizeOf 合成体
//   8+max(载荷圆整8) 布局本就支持宽型·B/C 节值断言锁定布局与读写全链——
//   布局错位即值损坏，无独立尺寸断言面：宿主 类型大小 参数清单不含合成体）。
导入 容器::向量;
函数 主() -> 整32 {
    // B. 直装盒宽型矩阵（正常 构造+值断言+错误分支处理·打印=行输出）
    结果<整128, 整32> 盒a = 正常(整128(1234567890));
    如果 (盒a.正常) { 打印(整64(盒a.值)); } 否则 { 返回 1; }
    结果<正128, 整32> 盒b = 正常(正128(4000000000));
    如果 (盒b.正常) { 打印(整64(盒b.值)); } 否则 { 返回 2; }
    结果<整64, 整32> 盒c = 正常(整64(-555));
    如果 (盒c.正常) { 打印(盒c.值); } 否则 { 返回 3; }
    结果<正64, 整32> 盒d = 正常(正64(777));
    如果 (盒d.正常) { 打印(盒d.值); } 否则 { 返回 4; }
    结果<浮64, 整32> 盒e = 正常(浮64(2.5));
    如果 (盒e.正常) { 打印(盒e.值); } 否则 { 返回 5; }
    结果<浮32, 整32> 盒f = 正常(浮32(1.25));
    如果 (盒f.正常) { 打印(盒f.值); } 否则 { 返回 6; }
    结果<字符, 整32> 盒g = 正常(字符(65));
    如果 (盒g.正常) { 打印(整64(盒g.值)); } 否则 { 返回 7; }
    结果<布尔, 整32> 盒h = 正常(真);
    如果 (盒h.正常) { 打印(盒h.值); } 否则 { 返回 8; }
    结果<整8, 整32> 盒i = 正常(整8(-3));
    如果 (盒i.正常) { 打印(盒i.值); } 否则 { 返回 9; }
    结果<整16, 整32> 盒j = 正常(整16(-300));
    如果 (盒j.正常) { 打印(盒j.值); } 否则 { 返回 10; }
    结果<整32, 整32> 盒k = 正常(-44);
    如果 (盒k.正常) { 打印(盒k.值); } 否则 { 返回 11; }
    结果<字符串, 整32> 盒l = 正常("你好");
    如果 (盒l.正常) { 打印(盒l.值); } 否则 { 返回 12; }

    // C. 泛型容器读取链：向量<T>.读取 返回 结果<T,整32>——泛型单态化
    //    （向量$整128 实例化类体全方法）即本轮 miss 触发链·值断言收口
    向量<整128> 表 = 向量<整128>();
    结果<空类型, 整32> 加1 = 表.追加(1234567890);
    结果<整128, 整32> 读1 = 表.读取(0);
    如果 (读1.正常) { 打印(整64(读1.值)); } 否则 { 返回 13; }
    向量<正128> 表2 = 向量<正128>();
    结果<空类型, 整32> 加2 = 表2.追加(4000000000);
    结果<正128, 整32> 读2 = 表2.读取(0);
    如果 (读2.正常) { 打印(整64(读2.值)); } 否则 { 返回 14; }
    向量<整64> 表3 = 向量<整64>();
    结果<空类型, 整32> 加3 = 表3.追加(-9);
    结果<整64, 整32> 读3 = 表3.读取(0);
    如果 (读3.正常) { 打印(读3.值); } 否则 { 返回 15; }
    返回 0;
}
