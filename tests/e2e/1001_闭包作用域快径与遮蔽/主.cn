// 1001_闭包作用域快径与遮蔽（815）：闭包关联登记的作用域语义锁。
//   ①同函数多 lambda：后定义不清前登记（720 实录形态——815 前=每组第一个定义
//     的调用退蹦床间接调用，行为等价但快径覆盖收缩）；②块级遮蔽：内层同名
//     lambda 出块随作用域作废，块外恢复外层绑定（815 前=内层登记覆盖污染外层，
//     块外误绑定内层）；③嵌套 lambda（体内定义+体内调用）；④值捕获快照=
//     定义处固化（快径 captureArgs 语义锚）；⑤lambda 体内调用外层闭包变量
//     （蹦床通道兜底·485 体内隔离保持）；⑥跨函数同名 lambda 变量隔离（485
//     函数入口清空保持，误绑定会输出错误值）。
函数 造值() -> 整32 {
    变量 取 = []() -> 整32 { 返回 1; };
    返回 取();
}

函数 主() -> 整32 {
    // ① 同函数多 lambda 交替调用（各绑定各的）
    变量 加一 = [](整32 值) -> 整32 { 返回 值 + 1; };
    变量 加二 = [](整32 值) -> 整32 { 返回 值 + 2; };
    打印(加一(10));                    // 11
    打印(加二(10));                    // 12
    打印(加一(20));                    // 21（815 前：此调用退蹦床通道）

    // ② 块级遮蔽：内层同名 lambda 出块作废，外层绑定恢复
    变量 取 = []() -> 整32 { 返回 1; };
    如果 (真) {
        变量 取 = []() -> 整32 { 返回 2; };
        打印(取());                    // 2（内层绑定）
    }
    打印(取());                        // 1（815 前：误绑定内层输出 2）

    // ③ 嵌套 lambda：体内定义+体内调用+体外调用外层
    变量 外 = []() -> 整32 {
        变量 内 = []() -> 整32 { 返回 7; };
        返回 内();
    };
    打印(外());                        // 7

    // ④ 值捕获快照=定义处固化（多 lambda 共存下快径通道语义锚）
    变量 基 = 100;
    变量 加基 = [=](整32 值) -> 整32 { 返回 值 + 基; };
    打印(加基(1));                     // 101
    基 = 200;
    打印(加基(1));                     // 101（快照不随后续修改变）

    // ⑤ lambda 体内调用外层闭包变量（蹦床通道兜底·行为锁）
    变量 包装 = [=](整32 值) -> 整32 { 返回 加一(值) * 2; };
    打印(包装(10));                    // 22
    打印(加一(1));                     // 2

    // ⑥ 跨函数同名 lambda 变量隔离（本函数绑定不串 造值 的）
    造值();
    变量 取2 = []() -> 整32 { 返回 2; };
    打印(取2());                       // 2
    返回 0;
}
