// 官网文档示例 · tutorial-oop.html · 继承（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
类 动物 {
公开:
    字符串 名称;

    函数 动物(字符串 名) { 名称 = 名; }

    虚拟 函数 叫声() -> 字符串 {
        返回 "…";
    }

    函数 自我介绍() -> 空类型 {
        打印(名称 + " 说：" + 自身.叫声());   // 动态分派到重写
    }
}

类 狗 : 动物 {
公开:
    函数 狗(字符串 名) : 动物(名) {   // 父类构造：初始化列表形态
    }

    重写 函数 叫声() -> 字符串 {
        返回 "汪汪";
    }
}

类 猫 : 动物 {
公开:
    函数 猫(字符串 名) : 动物(名) {
    }

    重写 函数 叫声() -> 字符串 {
        返回 "喵";
    }
}

函数 主() -> 整32 {
    狗 d = 狗("阿黄");
    猫 m = 猫("咪咪");
    d.自我介绍();
    m.自我介绍();
    返回 0;
}