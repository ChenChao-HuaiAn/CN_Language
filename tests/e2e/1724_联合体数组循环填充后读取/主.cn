// 1724（#1972 dual 正测·循环变量下标形态）：循环体内非常量下标写字段（[] 写=
//   整体置位·1771 循环填充惯用法）后循环变量下标读字段。修前宿主在「成员.
//   字段」的数组基对象处误开整体值读判定误报；v2 同源放行=分叉。
联合体 值 {
    整32 i;
    整64 l;
}
不安全 函数 主() -> 整32 {
    值[4] 组;
    变量 k = 0;
    当 (k < 4) {
        组[k].l = 10 + k;
        k = k + 1;
    }
    变量 总和 = 0;
    变量 序 = 0;
    当 (序 < 4) {
        总和 = 总和 + 组[序].i;
        序 = 序 + 1;
    }
    打印(总和);
    返回 0;
}
