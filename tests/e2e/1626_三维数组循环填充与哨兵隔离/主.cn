// E2E 1626_三维数组循环填充与哨兵隔离（1775·P0 安全红线·双编译对照）：
//   三维及以上数组元素访问=运行期正确（修复前宿主三维+读写即错误码 3/段错误：
//   visitIndexExpr「其他对象形式」尾段元素形态判定缺「仍是数组→地址语义」，
//   中间维子数组被 LoadPtr 按值读成标量→外层把标量值当地址=空指针/野地址；
//   #1688 只修了对象=数组名分支，对象=嵌套下标表达式中间层同族遗漏）。
//   锁面=边界精确：四角+中心坐标编码值全对+前后哨兵标量不被写穿+相邻元素
//   不被波及+四维递归剥维闭合（同根面一并锁）。
函数 主() -> 整32 {
    // 哨兵标量：三维数组前后各一（写穿栈=踩哨兵即显形）。值域声明（审查 P2
    //   撞值修正）：2024/222 均不在本用例任何合法编码域（三维填充 0~123、
    //   常量段 999/1、四维 0/1 位模式 0~1111）——原前哨兵 111 与 立[1][1][1]
    //   编码值撞值（向前写穿恰好写 111=哨兵假绿），改域外值堵死假绿通道。
    整32 前 = 2024;
    整32[2][3][4] 立;
    整32 后 = 222;
    // 三重循环全量填充（非常量下标·值=i*100+j*10+k 编码坐标可溯错位）
    循环 (整32 i = 0; i < 2; i = i + 1) {
        循环 (整32 j = 0; j < 3; j = j + 1) {
            循环 (整32 k = 0; k < 4; k = k + 1) {
                立[i][j][k] = i * 100 + j * 10 + k;
            }
        }
    }
    // 四角+中心值全对（错步长/错基址必读出可识别错值）
    打印(立[0][0][0]);
    打印(立[0][2][3]);
    打印(立[1][0][0]);
    打印(立[1][2][3]);
    打印(立[0][1][2]);
    打印(立[1][1][1]);
    // 哨兵不被写穿
    打印(前);
    打印(后);
    // 常量下标混合写读+相邻元素不波及
    立[1][2][3] = 999;
    打印(立[1][2][3]);
    打印(立[0][0][1]);
    // 四维同根闭合（中间层全部=子数组地址语义·递归剥维）
    整32[2][2][2][2] 四;
    循环 (整32 i = 0; i < 2; i = i + 1) {
        循环 (整32 j = 0; j < 2; j = j + 1) {
            循环 (整32 k = 0; k < 2; k = k + 1) {
                循环 (整32 m = 0; m < 2; m = m + 1) {
                    四[i][j][k][m] = i * 1000 + j * 100 + k * 10 + m;
                }
            }
        }
    }
    打印(四[0][0][0][0]);
    打印(四[1][0][1][0]);
    打印(四[1][1][1][1]);
    返回 0;
}
