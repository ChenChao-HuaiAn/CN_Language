// E2E 1332（2026-10-18·任务 #756 负测·dual 预期编译失败）：枚举成员值超 i32 域
//   →双侧编译期拒（2026-10-16 用户网页裁决批乙「值域门槛：枚举成员值超 i32 域
//   双侧一致编译期拒」·506/535/638 超域字面量立法族同款·枚举按整32存储）。
//   八形态同文件：声明初始化/赋值/返回/函数内静态/顶层静态/结构体字段初始化/
//   结构体字段赋值/数组元素赋值——宿主+v2 双侧等效拒绝（负向规范等价性锚定·
//   569-a C25 负测双测通道；诊断文本各自锚定=T63 后案）。
//   修前实录（728u 探针 p1）：枚举变量初始化宿主 i32 槽静默截断 0 / v2 局部槽
//   8 字节完整值——双侧分叉；字段形态双侧一致 4 字节截断（静默错值归零）。
枚举 极值 {
    甲 = -9223372036854775808,   // 整64 最小值（超 i32 域·728u 探针同源）
    乙 = 9223372036854775807,    // 整64 最大值（超 i32 域）
}
结构体 匣 { 极值 槽; 整64 标; }
静态 极值 顶层极 = 极值.甲;
函数 回极() -> 极值 {
    返回 极值.乙;
}
函数 主() -> 整32 {
    极值 局部 = 极值.甲;
    局部 = 极值.乙;
    静态 极值 局部静 = 极值.甲;
    匣 盒 = 匣{ 槽 = 极值.乙, 标 = 1 };
    盒.槽 = 极值.甲;
    极值[2] 表 = { 极值.乙, 极值.乙 };
    表[0] = 极值.甲;
    局部 = 回极();
    打印(顶层极);
    打印(局部静);
    打印(盒.槽);
    打印(表[0]);
    返回 0;
}
