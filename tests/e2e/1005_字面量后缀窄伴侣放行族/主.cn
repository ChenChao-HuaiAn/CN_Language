// E2E 1005（788 锁用例·正测 dual·2026-10-15）：字面量后缀定级三分法之
//   ①②分放行面——①无后缀非负字面量随另一侧（728s 既有·回归锚）+②285 窄域
//   适配（宿主 checkArithmeticBinary 同构·窄伴侣豁免带后缀字面量——q16 实证
//   面：`甲8+1L` 宿主 285 拉窄放行 vs v2 修前 0 豁免放行错类型/纯定级接入
//   误拒整64 双向分叉）+复合赋值豁免（740/828 立法分域）+拼接面（372）。
//   锁运行值双侧逐字一致（p38 探针预演实证 12 形态值全对齐）。
//   〔超窄域值形态（甲8+300 宽算截断 vs 窄算检查）=语义-发射双口径存量面·
//   另案不在本锁面——788 轮呈报立项〕
函数 主() -> 整32 {
    整8 甲 = 0;
    甲 = 甲 + 1L;             // ②285：窄伴侣+带L字面量拉窄放行（q16）
    打印(甲);
    甲 = 1L + 甲;             // ②对称
    打印(甲);
    整16 丙 = 0;
    丙 = 丙 + 2ULL;           // ②窄伴侣+ULL（p28 形态）
    打印(丙);
    正32 乙 = 0;
    乙 = 1 + 乙;              // ①728s 随侧（p14 回归锚）
    打印(乙);
    整32 丁 = 0;
    丁 += 1L;                 // 复合赋值豁免（p17·740/828 分域）
    打印(丁);
    变量 戊 = 1L + 2;         // 推断声明带L（p35·46-c 面 285 不触发）
    打印(戊);
    字符串 己 = "x" + 1L;     // 372 拼接面（p26·带L右数值拼接）
    打印(己);
    正8 庚 = 1;
    庚 = 庚 + 1L;             // ②正8 窄伴侣+L（p31 形态）
    打印(庚);
    甲 = 甲 - 1;              // ②窄+无后缀字面量（域内负值）
    打印(甲);
    正8 壬 = 1;
    变量 壬二 = 200 + 壬;     // ②285 推断声明面（左字面量+右窄变量拉窄·正8）
    打印(壬二);
    整32 癸 = 0;
    癸 = 癸 + 1U;             // ①同秩字面量豁免混合符号（p06 形态）
    打印(癸);
    返回 0;
}
