// E2E 937_连接链融合（#728o·2026-10-14·服务端领号）：一次性连接链
//   `甲+乙+丙+…` 编译期融合为「新建缓冲 -> 逐段追加 -> 完成」一趟构建
//   （复用 #366 runtime 构建器设施·001 §10.3）；本用例锁语义等价铁律——
//   终串逐字节等值 / 段求值顺序与次数不变 / 所有权与逐节连接一致。
//   断言（失败即 rc=1）：
//   ① 3 段链（UTF-8 中文）vs 逐节 2 段链（未达融合阈值=原路径）等值；
//   ② 4/5 段数值混链（整64/浮64/布尔/字符/正64）vs 逐节转换对照等值；
//   ③ 有副作用段左到右各求值恰一次（全局计数 段序_ 编序断言 1234）；
//   ④ 右嵌套子链作段（A+B+(C+D+E)）等值 + 子链拥有临时结算不崩；
//   ⑤ 空串段 / 16 段长链 vs 字符串构建器 手工构建等值（同完成产物契约）；
//   ⑥ 链结果接收/拷贝/RAII 释放路径正常（终态不崩）。
//   dual：宿主+v2 双编译对照（同源码双侧各编各跑·退出码+输出逐行一致）。
静态 整64 段序_ = 0;

// 有副作用段：调用序编码入 段序_（段序_ = 段序_*10 + 值——若求值次数/顺序
//   偏离「左到右各一次」则编序值不为 1234）
不安全 函数 序段(整64 值, 字符串 文本) -> 字符串 {
    段序_ = 段序_ * 10 + 值;
    返回 字符串复制(文本);  // 字符串返回=拥有契约（参数借用须显式落堆）
}

不安全 函数 主() -> 整32 {
    整32 失败 = 0;

    // ① 3 段链（UTF-8 中文）vs 逐节 2 段链对照
    字符串 链3 = "你好，" + "构建" + "器";
    字符串 对3甲 = "你好，" + "构建";
    字符串 对3 = 对3甲 + "器";
    如果 (链3 != 对3) { 打印行("① 3 段链不等价:", 链3); 失败 = 1; }
    字符串 期3 = "你好，构建器";
    如果 (链3 != 期3) { 打印行("① 3 段链期望不等:", 链3); 失败 = 1; }

    // ② 4 段数值混链（融合）vs 逐节 2 段链（原路径转换器同源）
    整64 数64 = 1234567890123;
    浮64 浮值 = 3.5;
    字符串 混链 = "n=" + 数64 + "|f=" + 浮值;
    字符串 混对甲 = "n=" + 数64;
    字符串 混对乙 = 混对甲 + "|f=";
    字符串 混对 = 混对乙 + 浮值;
    如果 (混链 != 混对) { 打印行("② 数值混链不等价:", 混链); 失败 = 1; }

    // ②b 5 段扩展混链（布尔/字符/正64）
    布尔 真值 = 真;
    字符 字 = 'A';
    正64 正值 = 42U;
    字符串 扩链 = "b=" + 真值 + "|c=" + 字 + "|u=" + 正值;
    字符串 扩对甲 = "b=" + 真值;
    字符串 扩对乙 = 扩对甲 + "|c=";
    字符串 扩对丙 = 扩对乙 + 字;
    字符串 扩对丁 = 扩对丙 + "|u=";
    字符串 扩对 = 扩对丁 + 正值;
    如果 (扩链 != 扩对) { 打印行("②b 扩展混链不等价:", 扩链); 失败 = 1; }

    // ③ 有副作用段：求值顺序与次数（4 段链融合，段=调用返回串）
    字符串 序链 = 序段(1, "A") + 序段(2, "B") + 序段(3, "C") + 序段(4, "D");
    字符串 期序 = "ABCD";
    如果 (序链 != 期序) { 打印行("③ 序链值错:", 序链); 失败 = 1; }
    如果 (段序_ != 1234) {
        打印行("③ 求值顺序/次数错:", 整数转字符串(段序_));
        失败 = 1;
    }

    // ④ 右嵌套子链作段：A + B + (C + D + E)——外层 3 段融合，段3=子链结果
    //   （拥有临时·追加后结算释放；释放路径错误=双放/崩溃即暴露）
    字符串 嵌链 = "L1-" + "L2-" + ("C1-" + "C2-" + "C3");
    字符串 期嵌 = "L1-L2-C1-C2-C3";
    如果 (嵌链 != 期嵌) { 打印行("④ 右嵌套子链不等价:", 嵌链); 失败 = 1; }

    // ⑤ 空串段链 vs 逐节对照
    字符串 空链 = "" + "A" + "" + "B" + "";
    字符串 空对甲 = "" + "A";
    字符串 空对乙 = 空对甲 + "";
    字符串 空对丙 = 空对乙 + "B";
    字符串 空对 = 空对丙 + "";
    如果 (空链 != 空对) { 打印行("⑤ 空串段不等价:", 空链); 失败 = 1; }

    // ⑥ 16 段长链 vs 字符串构建器 手工构建（同为完成产物契约）
    字符串 长链 = "a" + "b" + "c" + "d" + "e" + "f" + "g" + "h"
                + "i" + "j" + "k" + "l" + "m" + "n" + "o" + "p";
    整64 句 = 字符串构建器::新建();
    字符串构建器::追加(句, "a");
    字符串构建器::追加(句, "b");
    字符串构建器::追加(句, "c");
    字符串构建器::追加(句, "d");
    字符串构建器::追加(句, "e");
    字符串构建器::追加(句, "f");
    字符串构建器::追加(句, "g");
    字符串构建器::追加(句, "h");
    字符串构建器::追加(句, "i");
    字符串构建器::追加(句, "j");
    字符串构建器::追加(句, "k");
    字符串构建器::追加(句, "l");
    字符串构建器::追加(句, "m");
    字符串构建器::追加(句, "n");
    字符串构建器::追加(句, "o");
    字符串构建器::追加(句, "p");
    字符串 长构 = 字符串构建器::完成(句);
    如果 (长链 != 长构) { 打印行("⑥ 16 段长链 vs 构建器不等价:", 长链); 失败 = 1; }
    字符串 期长 = "abcdefghijklmnop";
    如果 (长链 != 期长) { 打印行("⑥ 16 段长链期望不等:", 长链); 失败 = 1; }

    // ⑦ 链结果接收/拷贝/长度（所有权与 RAII 释放路径）
    字符串 拷贝 = 长链;
    如果 (拷贝 != 期长) { 打印行("⑦ 链结果拷贝不等:", 拷贝); 失败 = 1; }
    如果 (字符串长度(长链) != 16) {
        打印行("⑦ 长链长度错:", 整数转字符串(字符串长度(长链)));
        失败 = 1;
    }

    如果 (失败 == 1) { 返回 1; }
    打印行("937 连接链融合全形态等价通过");
    返回 0;
}
