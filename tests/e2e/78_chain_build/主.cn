导入 容器::向量;
导入 文件::打开文件;
导入 文件::读取文件行;
导入 文件::关闭文件;
导入 文件::写入文件;
导入 CN语言编译器::IR生成;
导入 CN语言编译器::代码生成;

// 内存管理说明：CN字符串是动态分配的原始类型（非类，无RAII析构），
// 字符串拼接（a + b）分配新内存，旧字符串须显式用 字符串释放() 释放。
// 否则大规模编译时内存累积导致OOM（lessons.md 权重8.0）。

函数 读全部(空类型* 句柄) -> 字符串 {
    // 用 字符串复制 创建动态分配的空字符串（非字面量），后续可安全释放
    字符串 全部 = 字符串复制("");
    结果<字符串, 整32> 行结果 = 读取文件行(句柄);
    当 (真) {
        如果 (行结果.正常) {
            字符串 旧全部 = 全部;
            全部 = 全部 + 行结果.值;
            字符串释放(旧全部);
            字符串释放(行结果.值);
        } 否则 {
            中断;
        }
        行结果 = 读取文件行(句柄);
    }
    返回 全部;
}

// 编译单个模块：读源码（门面+子模块合并）-> IR生成 -> 代码生成 -> 写 asm 文件
// B 任务拆分：门面文件调用子模块函数（关键字::查找关键字），须合并子模块
//   源码后统一 IR 生成，保证调用符号与定义符号匹配（模块名$函数名）。
函数 编译模块(字符串 源码路径, 字符串 模块名, 字符串 输出路径,
              向量<字符串> 子模块路径们) -> 整32 {
    结果<空类型*, 整32> 打开结果 = 打开文件(源码路径, 1);
    如果 (打开结果.正常) {
        字符串 源码 = 读全部(打开结果.值);
        关闭文件(打开结果.值);
        // 合并子模块源码（B 任务拆分：词法/关键字.cn 等）
        整64 子索引 = 0;
        当 (子索引 < 子模块路径们.大小()) {
            结果<空类型*, 整32> 子打开 = 打开文件(子模块路径们.元素(子索引), 1);
            如果 (子打开.正常) {
                字符串 子源码 = 读全部(子打开.值);
                关闭文件(子打开.值);
                字符串 旧源码 = 源码;
                源码 = 源码 + "\n" + 子源码;
                字符串释放(旧源码);
                字符串释放(子源码);
            } 否则 {
                打印("子模块打开失败:" + 子模块路径们.元素(子索引));
                返回 1;
            }
            子索引++;
        }
        向量<字符串> IR行 = IR生成(源码, 模块名);
        字符串释放(源码);
        向量<字符串> asm行 = 代码生成(IR行);
        结果<空类型*, 整32> 写结果 = 打开文件(输出路径, 2);
        如果 (写结果.正常) {
            整64 i = 0;
            当 (i < asm行.大小()) {
                结果<整64, 整32> 写 = 写入文件(写结果.值, asm行.元素(i) + "\n");
                如果 (写.正常) {
                    i++;
                } 否则 {
                    打印("写入失败");
                    返回 1;
                }
            }
            关闭文件(写结果.值);
            打印("完成:" + 模块名);
            返回 0;
        } 否则 {
            打印("写打开失败:" + 输出路径);
            返回 1;
        }
    } 否则 {
        打印("打开失败:" + 源码路径);
        返回 1;
    }
}

函数 主() -> 整32 {
    向量<字符串> 词法子模块 = 向量<字符串>();
    结果<空类型, 整32> 加词法1 = 词法子模块.追加("CN语言编译器/词法/关键字.cn");
    如果 (!加词法1.正常) { 返回 1; }
    结果<空类型, 整32> 加词法2 = 词法子模块.追加("CN语言编译器/词法/运算符.cn");
    如果 (!加词法2.正常) { 返回 1; }
    结果<空类型, 整32> 加词法3 = 词法子模块.追加("CN语言编译器/词法/扫描.cn");
    如果 (!加词法3.正常) { 返回 1; }
    编译模块("CN语言编译器/词法分析.cn", "词法分析", "target/audit2/词法分析_链.asm", 词法子模块);
    内存::释放全部();
    向量<字符串> 语法子模块 = 向量<字符串>();
    结果<空类型, 整32> 加语法1 = 语法子模块.追加("CN语言编译器/语法/表达式.cn");
    如果 (!加语法1.正常) { 返回 1; }
    结果<空类型, 整32> 加语法2 = 语法子模块.追加("CN语言编译器/语法/语句.cn");
    如果 (!加语法2.正常) { 返回 1; }
    结果<空类型, 整32> 加语法3 = 语法子模块.追加("CN语言编译器/语法/声明.cn");
    如果 (!加语法3.正常) { 返回 1; }
    结果<空类型, 整32> 加语法4 = 语法子模块.追加("CN语言编译器/语法/顶层.cn");
    如果 (!加语法4.正常) { 返回 1; }
    编译模块("CN语言编译器/语法分析.cn", "语法分析", "target/audit2/语法分析_链.asm", 语法子模块);
    内存::释放全部();
    向量<字符串> 语义子模块 = 向量<字符串>();
    结果<空类型, 整32> 加语义1 = 语义子模块.追加("CN语言编译器/语义/符号表.cn");
    如果 (!加语义1.正常) { 返回 1; }
    结果<空类型, 整32> 加语义2 = 语义子模块.追加("CN语言编译器/语义/内置.cn");
    如果 (!加语义2.正常) { 返回 1; }
    编译模块("CN语言编译器/语义分析.cn", "语义分析", "target/audit2/语义分析_链.asm", 语义子模块);
    内存::释放全部();
    向量<字符串> IR子模块 = 向量<字符串>();
     结果<空类型, 整32> 加IR1 = IR子模块.追加("CN语言编译器/IR生成/IR1.cn");
     如果 (!加IR1.正常) { 返回 1; }
     结果<空类型, 整32> 加IR2 = IR子模块.追加("CN语言编译器/IR生成/IR2.cn");
     如果 (!加IR2.正常) { 返回 1; }
     结果<空类型, 整32> 加IR3 = IR子模块.追加("CN语言编译器/IR生成/IR3.cn");
     如果 (!加IR3.正常) { 返回 1; }
     结果<空类型, 整32> 加IR4 = IR子模块.追加("CN语言编译器/IR生成/IR4.cn");
     如果 (!加IR4.正常) { 返回 1; }
     编译模块("CN语言编译器/IR生成.cn", "IR生成", "target/audit2/IR生成_链.asm", IR子模块);
    内存::释放全部();
    向量<字符串> 代码生成子模块 = 向量<字符串>();
     结果<空类型, 整32> 加后端1 = 代码生成子模块.追加("CN语言编译器/后端接口.cn");
     如果 (!加后端1.正常) { 返回 1; }
     结果<空类型, 整32> 加后端2 = 代码生成子模块.追加("CN语言编译器/后端工厂.cn");
     如果 (!加后端2.正常) { 返回 1; }
     结果<空类型, 整32> 加后端3 = 代码生成子模块.追加("CN语言编译器/IR遍历.cn");
     如果 (!加后端3.正常) { 返回 1; }
     结果<空类型, 整32> 加后端4 = 代码生成子模块.追加("CN语言编译器/x64后端.cn");
     如果 (!加后端4.正常) { 返回 1; }
     结果<空类型, 整32> 加后端5 = 代码生成子模块.追加("CN语言编译器/arm64后端.cn");
     如果 (!加后端5.正常) { 返回 1; }
     编译模块("CN语言编译器/代码生成.cn", "代码生成", "target/audit2/代码生成_链.asm", 代码生成子模块);
    内存::释放全部();
    返回 0;
}