// 〔1833/1513 锁用例〕返回位深拷·借用来源全形态谱（丁案 R1·001 §5.3 返回值语义
// 2026-10-29 裁决）：类返回借用来源=返回位深拷副本（NewObject+拷贝构造 byRef 槽/
// 无拷构=emitOwnedFieldsCopy 字段级深拷），接收方独立拥有。1513 实录：形参面
// 拷构源漏解引（lvalueAddress=槽地址 直装入槽·byRef 契约须槽内=对象句柄）→
// 副本记录恒空（②③返回 0·和=4 应 6）。修复=形态谱分流判据：句柄槽形态
// （形参/全局/静态/裸字段/成员字段）LoadPtr 解引一跳；本体地址形态（下标内联/
// 解引用/三元透传/自身）地址即对象直存。本用例锁全谱×双通道+写穿独立拥有。
导入 容器::向量;

类 货品 {
公开:
    向量<字符串> 记录;
    函数 货品() { 记录 = 向量<字符串>(); }
    函数 ~货品() { }
    不安全 函数 货品(货品& 其他) { 记录 = 其他.记录; }
}

// 无拷构类：走字段级深拷分支（emitOwnedFieldsCopy·571 设施）
类 素货 {
公开:
    向量<字符串> 记录;
    函数 素货() { 记录 = 向量<字符串>(); }
}

静态 货品 静态甲;                        // 句柄槽形态（?gstatic 符号）
静态 素货 静素;

不安全 函数 静灌() -> 空类型 {
    结果<空类型, 整32> 加 = 静态甲.记录.追加("静");
    如果 (!加.正常) { 返回; } 否则 { }
    结果<空类型, 整32> 加2 = 静素.记录.追加("静");
    如果 (!加2.正常) { 返回; } 否则 { }
}
函数 形参源(货品 源) -> 货品 { 返回 源; }
函数 素形参源(素货 源) -> 素货 { 返回 源; }
不安全 函数 静态源() -> 货品 { 返回 静态甲; }
不安全 函数 素静态源() -> 素货 { 返回 静素; }
类 持仓 {
公开:
    货品 货;
    函数 持仓() { 货 = 货品(); }
    函数 ~持仓() { }
    不安全 函数 持仓(持仓& 其他) { 货 = 其他.货; }
    函数 字段源() -> 货品 { 返回 货; }
    不安全 函数 自身源() -> 持仓 { 返回 *自身; }
}
类 素仓 {
公开:
    素货 货;
    函数 素仓() { 货 = 素货(); }
    函数 字段源() -> 素货 { 返回 货; }
    不安全 函数 自身源() -> 素仓 { 返回 *自身; }
}
不安全 函数 解引用源(货品* p) -> 货品 { 返回 *p; }
不安全 函数 素解引用源(素货* p) -> 素货 { 返回 *p; }
函数 三元源(整32 选, 货品 甲, 货品 乙) -> 货品 {
    返回 选 > 0 ? 甲 : 乙;
}
函数 下标源(货品[3]& 列表) -> 货品 { 返回 列表[0]; }
函数 素下标源(素货[2]& 列表) -> 素货 { 返回 列表[0]; }
函数 消费(货品 按值) -> 整32 {
    返回 整32(按值.记录.大小());
}

不安全 函数 主() -> 整32 {
    静灌();
    持仓 仓;
    结果<空类型, 整32> 加2 = 仓.货.记录.追加("仓货");
    如果 (!加2.正常) { 返回 1; } 否则 { }
    素仓 素仓1;
    结果<空类型, 整32> 加3 = 素仓1.货.记录.追加("素仓货");
    如果 (!加3.正常) { 返回 1; } 否则 { }
    货品 甲;
    素货 素甲;
    结果<空类型, 整32> 加4 = 甲.记录.追加("甲");
    结果<空类型, 整32> 加5 = 素甲.记录.追加("素甲");
    如果 (!加4.正常) { 返回 1; } 否则 { }
    如果 (!加5.正常) { 返回 1; } 否则 { }
    货品 乙;
    结果<空类型, 整32> 加6 = 乙.记录.追加("乙");
    如果 (!加6.正常) { 返回 1; } 否则 { }
    货品[3] 数列;
    素货[2] 素数列;
    数列[0] = 乙;
    素数列[0] = 素甲;

    // ── 拷构类通道（NewObject+拷贝构造 byRef 槽）──
    货品 副1 = 形参源(甲);               // 句柄槽·声明位
    打印(副1.记录.大小());               // 1
    打印(消费(形参源(甲)));              // 1 句柄槽·实参位
    货品 副2 = 静态源();                 // 句柄槽·静态符号
    打印(副2.记录.大小());               // 1
    货品 副3 = 仓.字段源();              // 句柄槽·成员字段
    打印(副3.记录.大小());               // 1
    持仓 副4 = 仓.自身源();              // 本体地址·自身解引用
    打印(副4.货.记录.大小());            // 1
    货品* 指甲 = &甲;
    货品 副5 = 解引用源(指甲);           // 本体地址·解引用
    打印(副5.记录.大小());               // 1
    货品 副6 = 三元源(1, 甲, 乙);        // 本体地址·三元透传
    打印(副6.记录.大小());               // 1
    货品 副7 = 下标源(数列);             // 本体地址·内联元素（源=乙·1条）
    打印(副7.记录.大小());               // 1
    // 写穿验证：副本追加不写穿源（R1 核心语义·独立拥有）
    结果<空类型, 整32> 加7 = 副1.记录.追加("副");
    如果 (!加7.正常) { 返回 1; } 否则 { }
    打印(甲.记录.大小());                // 1
    打印(乙.记录.大小());                // 1（下标副本追加前源完好）
    // ── 无拷构类通道（emitOwnedFieldsCopy 字段级深拷）──
    素货 素副1 = 素形参源(素甲);
    打印(素副1.记录.大小());             // 1
    素货 素副2 = 素静态源();
    打印(素副2.记录.大小());             // 1
    素货 素副3 = 素仓1.字段源();
    打印(素副3.记录.大小());             // 1
    素仓 素副4 = 素仓1.自身源();
    打印(素副4.货.记录.大小());          // 1
    素货* 指素甲 = &素甲;
    素货 素副5 = 素解引用源(指素甲);
    打印(素副5.记录.大小());             // 1
    素货 素副7 = 素下标源(素数列);
    打印(素副7.记录.大小());             // 1
    结果<空类型, 整32> 加8 = 素副1.记录.追加("素副");
    如果 (!加8.正常) { 返回 1; } 否则 { }
    打印(素甲.记录.大小());              // 1
    返回 0;
}
