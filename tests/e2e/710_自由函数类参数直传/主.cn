// 710（414 审查 P1-1·E2E 正例）：自由函数类参数句柄直传
//   语法依据（plans/001 §06）：类实例作函数实参=句柄语义（宿主类=指针模型）。
//   v2 修前自由函数类参数按「结构体按值」登记→取地址+prologue 拷类字段宽度
//   字节=截断句柄→被调字段读崩/错值。修后句柄直传（类方法面同款对称）。
类 点 {
公开:
    整32 横;
    整32 纵;
    函数 点(整32 甲, 整32 乙) { 横 = 甲; 纵 = 乙; }
}
函数 求和(点 甲, 点 乙) -> 整32 {
    返回 甲.横 + 甲.纵 + 乙.横 + 乙.纵;
}
函数 主() -> 整32 {
    点 甲 = 点(1, 2);
    点 乙 = 点(10, 20);
    打印行(求和(甲, 乙));      // 1+2+10+20 = 33
    返回 0;
}
