// E2E 206（宿主正测，2026-09-10 第六十四轮 plans/019 阶段4 第二批）：
//   泛型 不安全 函数 修饰语法（泛型 <类型 T> 不安全 函数——第一批 逆序 暴露
//   的「泛型声明后必须跟 函数」规则扩展）+ 单态化调用零警告零行为影响。
//   （stdlib 泛型跨模块导入不可见为既有独立边界——32 用例同款本地化，此处
//   用例内泛型锚定语法。）期望 stdout：3 / 21。
泛型 <类型 T>
不安全 函数 倒排(T* 数组, 整64 长度) -> 空类型 {
    整64 左 = 0;
    整64 右 = 长度 - 1;
    当 (左 < 右) {
        T 临时 = 数组[左];
        数组[左] = 数组[右];
        数组[右] = 临时;
        左++;
        右--;
    }
}
函数 主() -> 整32 {
    整32[3] 表 = { 1, 2, 3 };
    倒排<整32>(表, 3);
    打印(表[0]);
    整64[3] 表2 = { 6, 7, 8 };
    倒排<整64>(表2, 3);
    打印(表2[0] + 表2[1] + 表2[2]);
    返回 0;
}
