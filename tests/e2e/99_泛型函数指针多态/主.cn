// E2E 99_泛型×函数指针多态（P3-21）：同一泛型回调在 整32/浮64 两类型单态化
// 泛型 <类型 T> 函数 排序回调(T* 数组, 整64 长度, 整32(*比较)(T, T))
//   <- T 替换为实参类型（整32/浮64），函数指针参数签名同步单态化（40 只覆盖整32）。
函数 比较整(整32 左, 整32 右) -> 整32 {
    如果 (左 > 右) { 返回 1; }
    如果 (左 < 右) { 返回 -1; }
    返回 0;
}

函数 比较浮(浮64 左, 浮64 右) -> 整32 {
    如果 (左 > 右) { 返回 1; }
    如果 (左 < 右) { 返回 -1; }
    返回 0;
}

泛型 <类型 T> 函数 排序回调(T* 数组, 整64 长度, 整32(*比较)(T, T)) -> 整64 {
    整64 索引 = 0;
    当 (索引 < 长度) {
        整64 内层 = 0;
        当 (内层 < 长度 - 1) {
            如果 (比较(数组[内层], 数组[内层+1]) > 0) {
                T 临时 = 数组[内层];
                数组[内层] = 数组[内层+1];
                数组[内层+1] = 临时;
            }
            内层 = 内层 + 1;
        }
        索引 = 索引 + 1;
    }
    返回 长度;
}

函数 主() -> 整32 {
    打印("===== 泛型×函数指针多态（P3-21）=====");
    整32[5] 整数组 = { 5, 2, 8, 1, 9 };
    整64 整长 = 排序回调<整32>(整数组, 5, 比较整);
    打印("整排序: ", 整数组[0], " ", 整数组[1], " ", 整数组[2], " ", 整数组[3], " ", 整数组[4]);
    打印("整长度: ", 整长);
    浮64[3] 浮数组 = { 2.5, 0.5, 1.5 };
    整64 浮长 = 排序回调<浮64>(浮数组, 3, 比较浮);
    打印("浮排序: ", 浮数组[0], " ", 浮数组[1], " ", 浮数组[2]);
    打印("浮长度: ", 浮长);
    打印("===== 完成 =====");
    返回 0;
}
