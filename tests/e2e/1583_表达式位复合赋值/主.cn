// E2E 1583_表达式位复合赋值（#1619·2026-10-26·正例·双编译对照）：
//   非语句右值位（表达式语境）的复合赋值——宿主 parseExpr=parseAssignment
//   全场含复合赋值（001 §4.5 赋值优先级 1 右结合·表达式值=写入后新值），
//   修前 v2 各表达式位解析停在复合赋值符报「缺少分号/缺少右括号」。
//   1613 的表达式补全面（链尾脱糖 12 表达式位接入：实参/下标/返回/初值族/
//   条件/括号/数组列表元素/选择值）。
//   逐值输出锁死求值序（左到右·赋值表达式值=新值）：
函数 加一(整32 值) -> 整32 {
    返回 值 + 1;
}
函数 取返回位() -> 整32 {
    整32 i = 10;
    返回 i += 1;              // 返回位：i=11·返回值=11
}
函数 主() -> 整32 {
    整32 i = 10;
    整32 r1 = 加一(i -= 1);   // ①实参位：i=9·r1=加一(9)=10
    打印(r1);
    打印(i);
    整32 y = 5;
    整32 a = y *= 2;          // ②初值位直链：y=10·a=10
    打印(a);
    打印(y);
    整32 b = (y *= 2) + 1;    // ③初值位括号：y=20·b=21
    打印(b);
    打印(y);
    整32 r3 = 取返回位();     // ④返回位：r3=11
    打印(r3);
    整32[5] 甲;
    整32 k = 1;
    甲[k += 1] = 7;           // ⑤下标内：k=2·甲[2]=7
    打印(甲[2]);
    打印(k);
    整32 x = 1;
    如果 ((x += 1) > 2) {     // ⑥条件内括号：x=2·2>2 假不进
        打印(99);
    }
    整32 r6 = 加一((i += 1) + 1);   // ⑦嵌套括号实参：i=10·r6=加一(11)=12
    打印(r6);
    打印(i);
    选择(x += 1) {            // ⑧选择值位：x=3·命中情况 3
        情况 3:
            打印(x);
            中断;
        默认:
            打印(0);
    }
    静态 整32 s = y *= 2;     // ⑨静态初值位：y=40·s=40
    打印(s);
    打印(y);
    变量 q = y *= 2;          // ⑩推断初值位：y=80·q=80
    打印(q);
    整32[2] 表 = {i += 1, i += 1};   // ⑪数组列表元素位：i=11,12·左到右
    打印(表[0]);
    打印(表[1]);
    打印(i);
    返回 0;
}
