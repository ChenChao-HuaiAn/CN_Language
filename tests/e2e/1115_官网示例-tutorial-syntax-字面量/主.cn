// 官网文档示例 · tutorial-syntax.html · 基本类型（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
函数 主() -> 整32 {
    整32 十进制 = 42;
    整32 十六进制 = 0xFF;       // 255
    整32 二进制 = 0b1010;       // 10
    整32 八进制 = 0o777;        // 511
    整64 长值 = 100L;           // L 后缀 → 整64
    浮32 单精度 = 1.5f;         // f 后缀 → 浮32
    浮64 科学 = 1.5e10;
    打印(十进制, " ", 十六进制, " ", 二进制, " ", 八进制);
    打印(长值, " ", 单精度, " ", 科学);
    返回 0;
}