// E2E 912（任务 548·2026-10-14·编译期除零常量传播面的正例对照锁·原领 910 撞号改号 554 制度）：
//   锁「548 扩面不误报」——非常量除数/非零常量/重赋值失格/参数遮蔽四形态
//   必须放行且运行正确（运行期除零兜底面由 446 除法保护矩阵锚定不重复）。
//   ①非零顶层常量作除数（恒放行）；②变量常量零初值后被重赋值（保守口径
//   失格放行·188-a B11 同款零假阳性）；③形参遮蔽顶层常量名（584-a 遮蔽
//   生效·折叠通道按变量处理放行）；④非常量形参除数（折叠通道不认变量）。
函数 求(整32 被除, 整32 除) -> 整32 {
    返回 被除 / 除;
}

函数 遮蔽除(整32 被除, 整32 零) -> 整32 {
    // 形参 零 遮蔽下方顶层常量 零（584-a 遮蔽生效）——除零通道须按变量放行
    返回 被除 / 零;
}

常量 非零 = 7;
常量 零 = 0;

函数 主() -> 整32 {
    整32 甲 = 30;
    整32 商1 = 甲 / 非零;        // ① 非零常量：30/7 = 4
    整32 零v = 0;
    零v = 6;                     // ② 重赋值失格：保守放行
    整32 商2 = 甲 / 零v;         //    30/6 = 5
    整32 商3 = 遮蔽除(甲, 6);    // ③ 参数遮蔽：30/6 = 5
    整32 商4 = 求(甲, 3);        // ④ 非常量形参：30/3 = 10
    打印(商1);
    打印(商2);
    打印(商3);
    打印(商4);
    返回 0;
}
