// E2E 1455（1311 返工 P1-1）：回绕内置非整数实参双侧一致拒绝——
//   宿主 checkWrapBuiltinCall 整数守卫文案
//   「回绕内置要求整数操作数，实际为 'X' 与 'Y'」。
//   修前 v2 只查实参数=2，字符串/布尔/浮点/指针实参静默放行（字符串
//   运行时 C0000005、布尔按 0/1、浮点按位模式回绕、指针基类型秩误判），
//   与宿主拒绝面分叉。
//   负测双编译：宿主与 v2 均须编译拒绝；诊断锚三形态逐行固化。
函数 主() -> 整32 {
    打印(回绕加(字符串复制("a"), 字符串复制("b")));
    布尔 甲 = 真;
    布尔 乙 = 假;
    打印(回绕加(甲, 乙));
    浮64 丙 = 1.5;
    浮64 丁 = 2.5;
    打印(回绕加(丙, 丁));
    整32 值 = 7;
    整32* 针 = &值;
    打印(回绕加(针, 1));
    打印(回绕加(整8(1) == 整8(1), 整8(0)));
    返回 0;
}
