// E2E 502_窄宽回绕矩阵（565 轮 T33 残余根治·双编译对照持久门禁）
// 窄宽（整8/整16/正16/整32）值汇回绕：宿主=wrapping 存储参照，v2=窄宽值规范
//   化（复用显式强转同款 IR_类型转换 窄宽目标码）。修复前 v2 全列输出未回绕
//   原值（整8 100+100=200、复合赋值/传参/返回 60000、整32 字面量 4000000000）
//   ——本用例=回绕行为宿主/v2 逐行锚。
类 盒 {
    公开: 整16 值;
    函数 盒() { 值 = 0; }
}
函数 取(整16 输入值) -> 整32 { 返回 整32(输入值); }
函数 取十六() -> 整16 {
    整16 甲 = 整16(30000);
    整16 乙 = 整16(30000);
    返回 甲 + 乙;
}
函数 主() -> 整32 {
    整8 小甲 = 整8(100);
    整8 小乙 = 整8(100);
    整8 小丙 = 小甲 + 小乙;
    打印(小丙);
    整16 大甲 = 整16(30000);
    整16 大乙 = 整16(30000);
    整16 大丙 = 大甲 + 大乙;
    打印(大丙);
    正16 无甲 = 正16(60000);
    正16 无乙 = 正16(10000);
    正16 无丙 = 无甲 + 无乙;
    打印(无丙);
    整16 复甲 = 整16(30000);
    复甲 += 整16(30000);
    打印(复甲);
    打印(取十六());
    打印(取(大甲 + 大乙));
    整16[2] 表;
    表[1] = 大甲 + 大乙;
    打印(表[1]);
    盒 箱 = 盒();
    箱.值 = 大甲 + 大乙;
    打印(箱.值);
    整32 溢甲 = 4000000000;
    打印(溢甲);
    整32 环甲 = 2147483647;
    环甲 = 环甲 + 1;
    打印(环甲);
    返回 0;
}
