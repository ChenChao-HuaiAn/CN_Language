// 1000（#813·2026-10-16）：成员链指针解引用写宽度族锁面（992 读面姊妹篇·双编译对照）
//   修前：v2 解引用写目标宽度=成员链恒兜底 T_整64 8 字节宽写穿邻（生成语句赋值
//   中.cn 解引用左值分支只认标识符操作数·与读侧 992b 38654705672 同族）；宿主
//   655 只修读面（pointerPointeeSrcType）写面 648 显形误伤合法程序（下标/解引用
//   赋值目标元素类型未解析）。修复=v2 解引用所指宽度码813 单点（标识符/成员链/
//   指针算术/一元递归）+宿主 ir_expr_assign 补 MemberExpr 分支——零分叉红线面。
//   形态矩阵：①成员链解引用写（回写整32 槽）②写不穿邻（左右邻槽完好）③复合
//   写回（+=）④解引用位自增（(*p)++ 值语义）⑤字符串窄宽锚不回归。
//   注：盒 声明须在 池 数组之前——v2 结构体局部变量槽分配不按类型大小（与池
//   相邻时写穿·布局 ABI 分叉已立案另治）不影响本用例锁面（解引用写宽度）。
结构体 盒 {
    整32 值;
    整32* 游标;
}
不安全 函数 主() -> 整32 {
    盒 b;
    整32[4] 池;
    池[0] = 7; 池[1] = 8; 池[2] = 9; 池[3] = 10;

    // ① 成员链解引用写：*b.游标 = 77（应整32 4 字节写回 池[1]）
    b.游标 = &池[1];
    *b.游标 = 77;
    打印("写后所指: ", *b.游标);

    // ② 写不穿邻：左右邻槽完好（宽写穿邻=修前病灶）
    打印("左邻: ", 池[0]);
    打印("右邻: ", 池[2]);

    // ③ 复合写回：*b.游标 += 5
    *b.游标 += 5;
    打印("复合后: ", *b.游标);

    // ④ 解引用位自增：(*b.游标)++ 值语义（992 解引用自增成员链形态）
    (*b.游标)++;
    打印("自增后: ", *b.游标);
    打印("池1终: ", 池[1]);

    // ⑤ 标识符解引用写对照锚（修前已正确·防回归）
    整32 单 = 5;
    整32* p = &单;
    *p = 41;
    *p += 1;
    打印("锚: ", 单);
    返回 0;
}
