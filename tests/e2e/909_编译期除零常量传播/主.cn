// E2E 909（任务 548·2026-10-14·编译期除零检查的常量名/变量常量初值传播面）：
//   除/余右操作数编译期已知零的传播形态编译期硬错误——001 §1.1a① 总则
//   「编译期能证明的必须在编译期拦」+「常量传播面（变量持有常量初值作
//   下标/除数）随常量折叠后续波」明文锚定（503 轮 D2 只做字面量/-0/折叠
//   三形态·本件=常量名/变量常量初值后续波）。五形态双侧同拒：
//   ①顶层常量名作除数（常量 零 = 0; 甲/零）——宿主 globalConstValues_
//     语义值表+v2 语义层顶层常量值表（548 新设·修前值内联仅 IR 层）；
//   ②顶层常量名作取余除数（甲%零）；
//   ③变量持有常量零初值且全函数无重赋值（零v = 0; 甲/零v）——双侧
//     零值种子表（188-a B11 恒空判定表机制级同构推广·流不敏感保守）；
//   ④复合赋值字面量除零（甲 /= 0）——503 面缺口补齐（宿主复合赋值通道
//     修前漏·v2 脱糖重析合成二元已拦=修前活动分叉实锤）；
//   ⑤常量名参与折叠零（甲5-甲5）——常量名折叠传播嵌套形态。
//   双编译对照负测：宿主+v2p 双侧同源码都必须编译拒绝·诊断锚「编译期除零」。
常量 零 = 0;
常量 甲5 = 5;

函数 主() -> 整32 {
    整32 甲 = 3;
    整32 形1 = 甲 / 零;        // ① 顶层常量名除数
    整32 形2 = 甲 % 零;        // ② 顶层常量名取余除数
    整32 零v = 0;
    整32 形3 = 甲 / 零v;       // ③ 变量常量零初值（无重赋值）
    整32 形4 = 甲;
    形4 /= 0;                  // ④ 复合赋值字面量除零
    整32 形5 = 甲 / (甲5 - 甲5);  // ⑤ 常量名参与折叠零
    返回 形1 + 形2 + 形3 + 形4 + 形5;
}
