// p364 探针 4：683 候选形态·自由函数指针形参多字段写读（JSON.cn 定根/标错 同构）
导入 容器::向量;
类 JSON树 {
公开:
    整64 根;
    整64 错误码;
    整64 错误位置;
    整64 错误字节;
    向量<整64> 甲;
    向量<整64> 乙;
    向量<整64> 丙;
    向量<整64> 丁;
    向量<整64> 戊;
    向量<整64> 己;
    函数 JSON树() {
        根 = 0 - 1;
        错误码 = 0;
        错误位置 = 0;
        错误字节 = 0;
        甲 = 向量<整64>();
        乙 = 向量<整64>();
        丙 = 向量<整64>();
        丁 = 向量<整64>();
        戊 = 向量<整64>();
        己 = 向量<整64>();
    }
}
不安全 函数 定根直写(JSON树* 树, 整64 节) -> 空类型 {
    树.根 = 节;
}
不安全 函数 标错直写(JSON树* 树, 整64 码, 整64 位, 整64 字节) -> 空类型 {
    树.错误码 = 码;
    树.错误位置 = 位;
    树.错误字节 = 字节;
}
函数 主() -> 整32 {
    JSON树 树 = JSON树();
    定根直写(&树, 5);
    标错直写(&树, 3, 7, 9);
    打印(树.根);
    打印(树.错误码);
    打印(树.错误位置);
    打印(树.错误字节);
    返回 0;
}
