// E2E 1736（#1947·P1 泄漏根治·dual 双编译对照锁面）：lambda 体内裸容器/串声明
//   出口零泄漏——宿主 lambda 合成函数（?lambdaN）此前漏挂函数级 RAII 兜底
//   （genClassDestructorCalls/genStringFrees），体内「返回」终止块路径块出口析构
//   被守卫跳过（ir_stmt.cpp genBlock 已终止分支只截断名单）→ 容器数据缓冲/
//   拥有串每调用泄漏 1（修前宿主探针差=3·v2 合成函数走 生成函数 同管线净差
//   0=分叉）。修后 lambda 合成函数出口与普通函数/类方法完全同构兜底。
//   判据（216 口径）：内存::活动分配数 三次调用窗口差=0（每形态）。
//   形态四=lambda 体内循环每轮容器声明（未终止路径块出口析构既有面回归锁）。
导入 容器::向量;

函数 主() -> 整32 {
    // 形态一：容器声明+追加+返回终止（主病灶·修前每调漏 1 数据缓冲）
    //   体内两个返回块（错误路径 -1/正常路径 大小）均为终止路径=兜底覆盖面。
    变量 看 = []()->整64 {
        向量<整32> 局部;
        结果<空类型, 整32> 追 = 局部.追加(2);
        如果 (!追.正常) { 返回 -1; }
        返回 整64(局部.大小());
    };
    整64 前 = 内存::活动分配数();
    看();
    看();
    看();
    打印(内存::活动分配数() - 前);
    // 形态二：拥有串声明（字面量初始化落堆副本·修前每调漏 1 堆串）
    变量 看乙 = []()->整64 {
        字符串 局部乙 = "你好世界";
        返回 整64(字符串长度(局部乙));
    };
    前 = 内存::活动分配数();
    看乙();
    看乙();
    看乙();
    打印(内存::活动分配数() - 前);
    // 形态三：对照标量（零 RAII 面·双侧基线，排除闭包对象计数干扰）
    变量 看丙 = []()->整64 {
        整64 局部丙 = 7;
        返回 局部丙;
    };
    前 = 内存::活动分配数();
    看丙();
    看丙();
    看丙();
    打印(内存::活动分配数() - 前);
    // 形态四：体内循环每轮容器声明（块出口析构既有面·回归锁）
    变量 看丁 = []()->整64 {
        整64 累 = 0;
        整32 序 = 0;
        当 (序 < 3) {
            向量<整32> 循环局部;
            结果<空类型, 整32> 追二 = 循环局部.追加(序);
            如果 (!追二.正常) { 返回 -2; }
            累 = 累 + 整64(循环局部.大小());
            序 = 序 + 1;
        }
        返回 累;
    };
    前 = 内存::活动分配数();
    整64 值丁 = 看丁();
    打印(内存::活动分配数() - 前);
    打印(值丁);
    返回 0;
}
