// E2E 562_作用域遮蔽恢复（任务 085 转正·v8 采样 m87 族+913 探针 b 同根·2026-09-30）
// 覆盖：循环头同名声明遮蔽出循环恢复（085 原铁证：外层 x=10 实跑=2——
//   v2 生成循环 init 段无作用域边界）、块内同名遮蔽出块恢复（584-a 既有·
//   回归防护）、嵌套遍历同名元素变量遮蔽（913 探针 b：内外层「值」互染
//   100 vs 63——遍历迭代变量作用域=体块）
// 语法依据：03 循环语句三段头 + 块作用域 + C-2 遍历
函数 主() -> 整32 {
    打印("===== 作用域遮蔽恢复（任务 085）=====");

    整32 x = 10;
    循环 (整32 x = 0; x < 3; x += 1) { }
    打印("循环头遮蔽后: ", x);   // 应 10（原缺陷=2）

    整32 y = 100;
    {
        整32 y = 1;
        打印("块内: ", y);       // 应 1
    }
    打印("块外: ", y);           // 应 100

    整32[2] 外 = { 1, 2 };
    整32 计数 = 0;
    遍历 外 中 每个 值 {
        整32[2] 内 = { 10, 20 };
        遍历 内 中 每个 值 {
            计数 += 值;
        }
        计数 += 值;
    }
    打印("计数: ", 计数);        // 应 63（原缺陷=100）

    // 遍历后同名复用（迭代变量出作用域·后续同名声明不冲突）
    整32 值 = 999;
    打印("遍历后同名: ", 值);    // 应 999

    打印("===== 完成 =====");
    返回 0;
}
