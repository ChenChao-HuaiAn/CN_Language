导入 容器::向量;

// E2E 147 符号供给（2026-09-04）：v2 生成代码引用的 向量$项 方法符号
//   （追加/元素/大小 mangle 名）由本文件经宿主真实管线编译为 .obj 供给
//   （链接置于 v2p.obj 之前——②b B7 惯例；v2 组件自身未实例化 项 元素容器）。
//   供给函数本体=宿主侧引用局部同源自证（向量<项>& r = h.表 全链）。
结构体 项 {
    整64 值;
}

结构体 持有者 {
    向量<项> 表;
}

函数 供给引用向量() -> 整64 {
    持有者 h;
    h.表 = 向量<项>();
    向量<项>& r = h.表;
    项 元素;
    元素.值 = 42;
    结果<空类型, 整32> 加 = r.追加(元素);
    如果 (!加.正常) { 返回 101; }
    如果 (r.大小() != 1) { 返回 102; }
    如果 (r.元素(0).值 != 42) { 返回 103; }
    如果 (h.表.元素(0).值 != 42) { 返回 104; }
    返回 0;
}

函数 主() -> 整32 {
    整64 结果值 = 供给引用向量();
    如果 (结果值 != 0) { 返回 整32(结果值); }
    返回 0;
}
