// E2E 147_v2_局部引用声明（2026-09-04，IR生成.cn 冒烟 96 错根因收口）
// 根因：v2 语法层局部变量声明形态检测不识别「泛型类型 & 引用后缀」——
//   `向量<IR指令>& 指令 = 函数信息.指令;` 泛型闭合后是 '&' 非标识符，
//   是泛型声明 返回假 -> 整条声明落入表达式解析成垃圾（裸标识符 向量 报
//   未声明 + 声明名未登记级联 未声明 + '=' 成非左值赋值）——IR生成.cn 冒烟
//   96 错 = 3 处该形态 + 级联（84 指令 + 9 向量 + 3 左值，探针矩阵实证）。
// 根治：是泛型声明 闭合后 '& 标识符' 同认 + 局部声明形态检测补 '&' 后缀；
//   语义层照常注册；IR 层引用局部=绑定（生成左值地址 -> 存槽；槽登记
//   引用参数槽们/类型们——读取分流/成员基址/赋值写回/再传引用实参数据流
//   与引用参数完全同构）。宿主 sanity 先行锚定（同源探针 exit=42）。
// 边界：裸类型引用局部（项& q = p）宿主亦不支持（parser 无该形态）——
//   双侧一致不支持，本轮不引入；如需属宿主先行新特性另立案。
// 闭环：v2p 编译 -> ml64/link + 供给（向量$项 方法符号宿主实例化，B7）-> 运行。
// 退出码=0 全过；11~16 失败码。
导入 容器::向量;

结构体 项 {
    整64 值;
}

结构体 持有者 {
    向量<项> 表;
}

函数 加值(向量<项>& 列表, 整64 值) -> 空类型 {
    项 元素;
    元素.值 = 值;
    结果<空类型, 整32> 加 = 列表.追加(元素);
    如果 (!加.正常) { 运行时错误(4); }
    返回;
}

函数 读首值(向量<项>& 列表) -> 整64 {
    返回 列表.元素(0).值;
}

函数 主() -> 整32 {
    // ===== 一、引用局部声明=结构体容器字段绑定 =====
    持有者 h;
    h.表 = 向量<项>();
    向量<项>& r = h.表;

    // ===== 二、经引用追加（引用局部传引用参数）+ 绑定同一对象验证 =====
    加值(r, 10);
    如果 (r.大小() != 1) { 返回 11; }
    如果 (r.元素(0).值 != 10) { 返回 12; }
    如果 (h.表.元素(0).值 != 10) { 返回 13; }   // 经 h 直读=同一对象

    // ===== 三、对照：字段直传引用参数 + 经引用读新元素 =====
    加值(h.表, 30);
    如果 (h.表.大小() != 2) { 返回 14; }
    如果 (r.元素(1).值 != 30) { 返回 15; }

    // ===== 四、引用局部传引用参数到带返回函数 =====
    如果 (读首值(r) != 10) { 返回 16; }

    返回 0;
}
