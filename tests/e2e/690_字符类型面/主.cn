// 690 字符类型面（979 立法：字符=4 字节·T_字符；§3.7 算术提升）
// 期望手算：'a'+1 提升整数=98；'a'<'b'=真→1；'A'+32='a'=97（ASCII 窄域内安全）
//   字符数组遍历 逐点原值；拼接 "x"+'a' → 字符转字符串
函数 主() -> 整32 {
    字符 甲 = 'a';
    打印(甲 + 1);                 // 98（整32 提升）
    打印(甲 < 'b' ? 1 : 0);       // 1
    字符 大 = 'A';
    打印(大 + 32);                // 97
    字符[3] 表 = { 'x', 'y', 'z' };
    循环 (整32 i = 0; i < 3; i++) {
        打印(表[i] + 0);          // 120/121/122（+0 保整打印）
    }
    返回 0;
}
