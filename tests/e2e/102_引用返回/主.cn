// E2E 102_引用返回（P3-18 收尾）：函数 返回类型 T& —— 返回被引用左值的地址
// 覆盖：引用变量接收（整32& 别名 = 传回(值)）、读、经返回引用写回（传回(值) = 值）、
//       引用变量写（别名 = 值）写回原变量。
函数 传回(整32& x) -> 整32& {
    返回 x;
}
函数 主() -> 整32 {
    打印("===== 引用返回（P3-18）=====");
    整32 值 = 100;
    整32& 别名 = 传回(值);
    打印("绑定读: ", 别名);          // 100
    别名 = 200;
    打印("引用写: ", 值);            // 200
    传回(值) = 300;
    打印("返回引用写: ", 值);         // 300
    打印("===== 完成 =====");
    返回 0;
}
