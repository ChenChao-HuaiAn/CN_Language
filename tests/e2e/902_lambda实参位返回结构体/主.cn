// 902_lambda实参位返回结构体（#560·双编译对照）——
//   lambda 作函数实参且 -> 返回类型为结构体名（551 探针矩阵①②③）。
//   缺陷（修复前宿主）：实参位高阶函数形参 `点(*回调)(整32)` 同 627 根因
//   （parseParamDecl 自定义名分支无 fnptr 探测）——声明即拒，lambda 实参
//   无法到达；修复后全链编译运行。
结构体 点 {
    整32 x;
    整32 y;
}

函数 应用(点(*回调)(整32), 整32 值) -> 点 {
    返回 回调(值);
}

函数 主() -> 整32 {
    // ① 实参位 lambda -> 结构体（体内直接构造）
    变量 a = 应用([=](整32 k) -> 点 { 返回 点{ x = k, y = k + 1 }; }, 5);
    打印(a.x);                         // 5
    打印(a.y);                         // 6
    // ③ 实参位 lambda 体内变量中转
    变量 b = 应用([=](整32 k) -> 点 { 变量 t = 点{ x = k, y = k * 2 }; 返回 t; }, 7);
    打印(b.x);                         // 7
    打印(b.y);                         // 14
    // ② 变量绑定位同形（既有通过面·对照保真）
    变量 造点 = [=](整32 k) -> 点 { 返回 点{ x = k + 1, y = k }; };
    变量 c = 造点(9);
    打印(c.x);                         // 10
    打印(c.y);                         // 9
    返回 0;
}
