// E2E 239（2026-09-12 第八十四轮后续 84-b）：**v2 结构体字面量字段校验**
//   （负测；Rust E0062/E0063 同构纪律，对齐既有脱糖位 解析构造字段赋值们）
//   背景：84-a 新增「结构体字面量作实参」（表达式位 → 新节点 + IR 生成）时未带
//   字段校验——宿主与 v2 旧脱糖位（声明/赋值/成员赋值三位）均有 E0062（重复字段）/
//   E0063（缺字段）同构纪律；本用例固化 v2 表达式位的同款拒绝：
//     ① `盒子{ 名 = …, 名 = … }`（重复字段）→ 编译错误
//     ② `盒子{ 名 = … }`（缺字段 号）→ 编译错误
//   预期：v2p 非零退出 + 不产 target/v2asm.s + 两条诊断锚行（见 主.expected）。
结构体 盒子 {
    字符串 名;
    整32 号;
}

函数 收(盒子 箱) -> 整32 {
    返回 箱.号;
}

函数 主() -> 整32 {
    // ① 重复字段（E0062 同构）
    整32 a = 收(盒子{ 名 = "重复字段内容甲乙丙丁", 名 = "重复字段内容甲乙丙丁", 号 = 1 });
    // ② 缺字段（E0063 同构；缺 号）
    整32 b = 收(盒子{ 名 = "缺字段内容甲乙丙丁戊己" });
    返回 整32(a + b);
}
