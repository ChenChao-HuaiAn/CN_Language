// E2E 95_父类构造初始化列表（P3-20）：函数 子(...) : 父(实参)
// 派生构造执行前先调用父类构造初始化父字段，再执行子类构造体。
类 父 {
公开:
    整32 基础

    函数 父(整32 b) {
        基础 = b
    }
}

类 子 : 父 {
公开:
    整32 额外

    函数 子(整32 b, 整32 e) : 父(b) {
        额外 = e
    }

    函数 总值() -> 整32 {
        返回 基础 + 额外
    }
}

函数 主() -> 整32 {
    打印("===== 父类构造初始化列表（P3-20）=====")
    子 实例 = 子(10, 5)
    打印("总值: ", 实例.总值())   // 15
    打印("===== 完成 =====")
    返回 0
}
