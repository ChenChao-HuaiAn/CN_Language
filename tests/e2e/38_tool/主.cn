// 全链路集成串联 E2E（Task 6.11，规格书阶段五「可开发命令行工具」）
// 工具：学生成绩统计工具 —— 读取 数据文件 → 解析 → 存储 → 统计 → 输出报告
// 覆盖标准库模块：
//   系统.cn    : 参数个数()/参数() 校验命令行（≥3）
//   文件.cn    : 打开文件(模式1读)/读取文件行/关闭文件；写入文件(模式2写)/读回
//   字符串扩展.cn : 分割() 解析每行；解析::转整数() 解析成绩
//   容器.cn    : 向量<整64> 存总分、向量<字符串> 存姓名（8 字节槽，结构体须规避）
//   映射集合.cn: 集合<整64> 总分去重；映射<整64,整64> 总分分布
//   算法.cn    : 排序整64()/最大元素()/二分查找整64()/计数()/线性查找()
//   数学.cn    : 数学::平方根() 计算标准差
//   IO.cn      : IO::打印到错误() 错误输出
//   时间.cn    : 时间::当前时间戳()/时间::格式化时间()（内部断言，输出 真/假）
// 调用方式：内置函数（数学::/文件::/IO::/时间::/系统::/解析::/字符串*）全局注册无需导入；
//   stdlib 模块公开函数/类（分割/向量/集合/映射/排序整64 等）经 导入 使用
//   （模块文件复制到用例目录，29_core/35_string_ext 同模式）
// 数据文件：5 行有效 + 1 行非法（孙七:abc 解析失败跳过）
//   张三 90+80+70=240  李四 85+75+80=240  王五 10+20+25=55
//   赵六 60+60+60=180  周八 95+85+90=270  → 总分 = {240,240,55,180,270}
// 统计预期：平均=197 最高=270(最大元素) 最低=55(排序后首元素) 及格(≥60)=4
//   集合去重=4 {55,180,240,270} 最高分分布=1 二分查找240=2 计数240=2 映射分布(240)=2
//   标准差 = sqrt((55-197)²+(180-197)²+(240-197)²+(240-197)²+(270-197)²)/5
//          = sqrt(20164+289+1849+1849+5329)/5 = sqrt(29480/5) = sqrt(5896) ≈ 76.785415
// 注意（lessons.md 边界）：
//   - 容器.cn 底层数组按 8 字节槽存储（结构体 T 会越界）——向量存 整64/字符串 标量
//   - 结构体姓名字段须 字符串复制() 深拷贝（分割产物释放后不得悬垂）
//   - 向量读取返回浅拷贝指针（结果.值）——打印不得释放（向量析构也不释放字符串元素）
//   - 打印变参内嵌泛型类字段下标会损坏——先存局部变量再打印
//   - 字符串变量 RAII 自动释放（A2 收尾批）；数组元素/装箱字段手动管理面保留；
//     打开的文件用完 关闭文件
//   - 读取文件行 返回含换行符（打印后出现空行，34_file 同现象）
//   - 参数字符串由运行时持有，不得 字符串释放
//   - 结果<T,E> 强制检查：设置() 返回值必须赋值并检查（规格书07 规则1）
//   - 变量名避免类型关键字开头；结果 关键字不可作变量名
//   - 大栈帧崩溃缺陷（Task 6.11 实测）：codegen 栈帧 = 寄存器槽区+变量槽区，
//     打印变参展开产生大量临时寄存器 → 函数栈帧超 8KB 时越过 Windows 栈 guard 页
//     （无 __chkstk 探测）→ 0xC0000005。规避：每个函数拆到 <8KB（少打印/少局部）

导入 容器::向量;
导入 映射集合::集合;
导入 映射集合::映射;
导入 算法::排序整64;
导入 算法::最大元素;
导入 算法::计数;
导入 算法::线性查找;
导入 算法::二分查找整64;
导入 字符串扩展::分割;

// 统计结果（结构体按值返回/传参，10_struct_value 已验证）
结构体 统计结果 {
    整64 平均分;
    整64 最高分;
    整64 最低分;
    整64 及格人数;
    浮64 标准差;
}

// ==================== 统计计算（算法.cn 排序/最大元素 + 数学.cn 平方根） ====================
函数 统计计算(整64* 总分数组, 整64 总人数) -> 统计结果 {
    排序整64(总分数组, 总人数);
    整64 总分和 = 0;
    整64 累加索引 = 0;
    当 (累加索引 < 总人数) {
        总分和 = 总分和 + 总分数组[累加索引];
        累加索引++;
    }
    整64 平均分 = 总分和 / 总人数;
    整64 最高分 = 最大元素<整64>(总分数组, 总人数);
    整64 最低分 = 总分数组[0];
    整64 及格人数 = 0;
    整64 及格索引 = 0;
    当 (及格索引 < 总人数) {
        如果 (总分数组[及格索引] >= 60) {
            及格人数++;
        }
        及格索引++;
    }
    整64 差异和 = 0;
    整64 差索引 = 0;
    当 (差索引 < 总人数) {
        整64 差异 = 总分数组[差索引] - 平均分;
        差异和 = 差异和 + 差异 * 差异;
        差索引++;
    }
    浮64 方差 = 浮64(差异和) / 浮64(总人数);
    浮64 标准差 = 数学::平方根(方差);
    统计结果 统计 = 统计结果{ 平均分 = 平均分, 最高分 = 最高分, 最低分 = 最低分, 及格人数 = 及格人数, 标准差 = 标准差 };
    返回 统计;
}

// ==================== 向量<整64> 总分存储演示（容器.cn） ====================
函数 向量演示(整64* 总分数组, 整64 总人数) -> 空类型 {
    向量<整64> 总分表 = 向量<整64>();
    整64 索引 = 0;
    当 (索引 < 总人数) {
        结果<空类型, 整32> 追加结果 = 总分表.追加(总分数组[索引]);
        索引++;
    }
    打印("向量大小(总分表): ", 总分表.大小());
}

// ==================== 集合<整64> 总分去重演示（映射集合.cn） ====================
函数 集合演示(整64* 总分数组, 整64 总人数) -> 空类型 {
    集合<整64> 总分集 = 集合<整64>();
    整64 索引 = 0;
    当 (索引 < 总人数) {
        结果<空类型, 整32> 集合结果 = 总分集.添加(总分数组[索引]);
        索引++;
    }
    打印("总分去重数: ", 总分集.大小());           // 4
}

// ==================== 映射<整64,整64> 总分分布演示（映射集合.cn） ====================
函数 映射演示(整64* 总分数组, 整64 总人数) -> 空类型 {
    映射<整64, 整64> 分布表 = 映射<整64, 整64>();
    整64 索引 = 0;
    当 (索引 < 总人数) {
        结果<整64, 整32> 已有结果 = 分布表.获取(总分数组[索引]);
        结果<空类型, 整32> 映射结果;
        如果 (已有结果.正常) {
            映射结果 = 分布表.设置(总分数组[索引], 已有结果.值 + 1);
        } 否则 {
            映射结果 = 分布表.设置(总分数组[索引], 1);
        }
        索引++;
    }
    结果<整64, 整32> 分布结果 = 分布表.获取(240);
    如果 (分布结果.正常) {
        打印("映射分布(240): ", 分布结果.值);      // 2
    } 否则 {
        打印("映射分布(240)缺失: ", 分布结果.错误);
    }
}

// ==================== 打印学生列表（姓名 + 总分） ====================
函数 打印列表(字符串* 姓名数组, 整64* 总分数组, 整64 总人数) -> 空类型 {
    整64 打印索引 = 0;
    当 (打印索引 < 总人数) {
        打印(姓名数组[打印索引], ": ", 总分数组[打印索引]);
        打印索引++;
    }
}

// ==================== 打印统计结果 ====================
函数 打印统计(统计结果 统计, 整64* 总分数组, 整64 总人数) -> 空类型 {
    打印("排序后: ", 总分数组[0], 总分数组[1], 总分数组[2], 总分数组[3], 总分数组[4]);
    打印("平均分: ", 统计.平均分);                 // 197
    打印("最高分: ", 统计.最高分);                 // 270
    打印("最低分: ", 统计.最低分);                 // 55
    打印("及格人数(≥60): ", 统计.及格人数);        // 4
    打印("标准差: ", 统计.标准差);                 // 76.785415（%f 6 位小数）
}

// ==================== 算法辅助验证一（算法.cn 计数/二分查找） ====================
函数 算法验证一(整64* 总分数组, 整64 总人数, 整64 最高分) -> 空类型 {
    整64 最高分次数 = 计数<整64>(总分数组, 总人数, 最高分);  // 1
    打印("最高分出现次数: ", 最高分次数);
    整64 查找240 = 二分查找整64(总分数组, 总人数, 240);         // 2
    打印("二分查找240: ", 查找240);
}

// ==================== 算法辅助验证二（算法.cn 线性查找/二分查找） ====================
函数 算法验证二(整64* 总分数组, 整64 总人数) -> 空类型 {
    整64 线性240 = 线性查找<整64>(总分数组, 总人数, 240);
    打印("线性查找240: ", 线性240);
    整64 不存在的 = 二分查找整64(总分数组, 总人数, 999);        // -1
    打印("二分查找999: ", 不存在的);
}

// ==================== 写入输出文件（文件.cn 模式2=写截断 + 整数转字符串） ====================
函数 写报告行(空类型* 句柄, 字符串 行) -> 整32 {
    整64 写入数 = 文件::写入文件(句柄, 行);
    如果 (写入数 < 0) {
        返回 1;
    }
    返回 0;
}

函数 写报告(字符串 输出路径, 统计结果 统计, 整64 总人数) -> 整32 {
    空类型* 写句柄 = 文件::打开文件(输出路径, 2);
    如果 (写句柄 == 无) {
        IO::打印到错误("打开输出文件失败，错误码=5(文件)\n");
        返回 4;
    }
    写报告行(写句柄, "===== 学生成绩统计报告 =====\n");
    写报告行(写句柄, "学生总数: ");
    字符串 人数文本 = 整数转字符串(总人数);
    写报告行(写句柄, 人数文本);
    写报告行(写句柄, "\n平均分: ");
    字符串 平均文本 = 整数转字符串(统计.平均分);
    写报告行(写句柄, 平均文本);
    写报告行(写句柄, "\n最高分: ");
    字符串 最高文本 = 整数转字符串(统计.最高分);
    写报告行(写句柄, 最高文本);
    写报告行(写句柄, "\n最低分: ");
    字符串 最低文本 = 整数转字符串(统计.最低分);
    写报告行(写句柄, 最低文本);
    写报告行(写句柄, "\n及格人数: ");
    字符串 及格文本 = 整数转字符串(统计.及格人数);
    写报告行(写句柄, 及格文本);
    写报告行(写句柄, "\n===== 报告结束 =====\n");
    文件::关闭文件(写句柄);
    返回 0;
}

// ==================== 读回输出文件验证写入成功（文件.cn 模式1=读） ====================
函数 读回报告(字符串 输出路径) -> 整32 {
    空类型* 回读句柄 = 文件::打开文件(输出路径, 1);
    如果 (回读句柄 == 无) {
        IO::打印到错误("读回输出文件失败，错误码=5(文件)\n");
        返回 5;
    }
    打印("===== 输出文件内容（读回验证）=====");
    当 (真) {
        字符串 报告行 = 文件::读取文件行(回读句柄);
        如果 (报告行 == 无) {
            中断;
        }
        打印(报告行);
    }
    文件::关闭文件(回读句柄);
    返回 0;
}

// ==================== 时间戳断言一（时间.cn） ====================
函数 时间断言一() -> 整32 {
    整64 戳1 = 时间::当前时间戳();
    整64 戳2 = 时间::当前时间戳();
    打印("时间戳合理: ", 戳2 >= 戳1);
    打印("时间戳大于0: ", 戳1 > 0);
    字符串 日期 = 时间::格式化时间(戳1, "%Y-%m-%d");
    如果 (日期 != 无) {
        打印("日期长度=10: ", 字符串长度(日期) == 10);
    } 否则 {
        打印("格式化时间失败");
    }
    如果 (日期 != 无) {
    }
    返回 0;
}

// ==================== 时间戳断言二（时间.cn 分隔符） ====================
函数 时间断言二() -> 整32 {
    整64 戳1 = 时间::当前时间戳();
    字符串 日期 = 时间::格式化时间(戳1, "%Y-%m-%d");
    如果 (日期 != 无) {
        字符串 分隔符1 = 字符串子串(日期, 4, 1);
        字符串 分隔符2 = 字符串子串(日期, 7, 1);
        打印("日期分隔符: ", 字符串比较(分隔符1, "-") && 字符串比较(分隔符2, "-"));
    } 否则 {
        打印("格式化时间失败");
    }
    返回 0;
}

// ==================== 解析单行（字符串扩展.cn 分割/转整数 + 深拷贝） ====================
// 说明：返回 1=成功写入 0=跳过（非法格式/解析失败）
函数 解析单行(字符串 行, 整64* 总分数组, 字符串* 姓名数组, 整64 位置) -> 整64 {
    字符串[4] 片段;
    结果<整64, 整32> 分割结果 = 分割(行, ",", 片段, 4);
    整64 成功 = 0;
    如果 (分割结果.正常) {
        如果 (分割结果.值 == 4) {
            整32 标志1 = 0;
            整32 标志2 = 0;
            整32 标志3 = 0;
            整64 成绩一 = 解析::转整数(片段[1], &标志1);
            整64 成绩二 = 解析::转整数(片段[2], &标志2);
            整64 成绩三 = 解析::转整数(片段[3], &标志3);
            如果 (标志1 == 1 && 标志2 == 1 && 标志3 == 1) {
                // 姓名深拷贝（分割产物释放后不得悬垂）；总分 = 三科之和
                字符串 姓名副本 = 字符串复制(片段[0]);
                整64 总分 = 成绩一 + 成绩二 + 成绩三;
                总分数组[位置] = 总分;
                姓名数组[位置] = 姓名副本;
                成功 = 1;
            }
        }
    }
    整64 释放索引 = 0;
    当 (释放索引 < 4) {
        字符串释放(片段[释放索引]);
        释放索引++;
    }
    返回 成功;
}

// ==================== 解析数据文件（文件.cn + 解析单行） ====================
// 返回 有效总人数；打开失败 返回 0
函数 解析数据(字符串 数据路径, 整64* 总分数组, 字符串* 姓名数组, 整64 最大容量) -> 整64 {
    空类型* 读句柄 = 文件::打开文件(数据路径, 1);
    如果 (读句柄 == 无) {
        IO::打印到错误("打开数据文件失败，错误码=5(文件)\n");
        返回 0;
    }
    整64 跳过行数 = 0;
    整64 总人数 = 0;
    当 (真) {
        字符串 行 = 文件::读取文件行(读句柄);
        如果 (行 == 无) {
            中断;    // EOF
        }
        如果 (总人数 < 最大容量) {
            整64 成功 = 解析单行(行, 总分数组, 姓名数组, 总人数);
            如果 (成功 == 1) {
                总人数++;
            } 否则 {
                跳过行数++;
            }
        } 否则 {
            跳过行数++;
        }
    }
    文件::关闭文件(读句柄);
    打印("跳过非法行: ", 跳过行数);
    返回 总人数;
}

// ==================== 释放姓名数组 ====================
函数 释放姓名(字符串* 姓名数组, 整64 总人数) -> 空类型 {
    整64 释放姓名 = 0;
    当 (释放姓名 < 总人数) {
        字符串释放(姓名数组[释放姓名]);
        释放姓名++;
    }
}

// ==================== 工具主体：解析 → 统计 → 输出 ====================
函数 工具主体(字符串 数据路径, 字符串 输出路径) -> 整32 {
    整64[8] 总分数组;
    字符串[8] 姓名数组;
    整64 总人数 = 解析数据(数据路径, 总分数组, 姓名数组, 8);
    如果 (总人数 == 0) {
        IO::打印到错误("数据文件为空或打开失败，错误码=5(文件)\n");
        返回 3;
    }
    打印("学生总数: ", 总人数);
    打印("===== 总分列表（排序前）=====");
    打印列表(姓名数组, 总分数组, 总人数);

    向量演示(总分数组, 总人数);
    集合演示(总分数组, 总人数);
    映射演示(总分数组, 总人数);

    统计结果 统计 = 统计计算(总分数组, 总人数);
    打印统计(统计, 总分数组, 总人数);
    算法验证一(总分数组, 总人数, 统计.最高分);
    算法验证二(总分数组, 总人数);

    时间断言一();
    时间断言二();

    整32 写状态 = 写报告(输出路径, 统计, 总人数);
    如果 (写状态 != 0) {
        返回 写状态;
    }
    整32 读状态 = 读回报告(输出路径);
    如果 (读状态 != 0) {
        返回 读状态;
    }
    释放姓名(姓名数组, 总人数);
    打印("===== 学生成绩统计工具运行完成 =====");
    返回 0;
}

// ==================== 主函数：参数校验 → 调 工具主体 ====================
函数 主() -> 整32 {
    打印("===== 学生成绩统计工具（Task 6.11 全链路集成）=====");
    整64 个数 = 系统::参数个数();
    如果 (个数 < 3) {
        IO::打印到错误("用法: 学生成绩统计工具 数据文件.txt 输出文件.txt\n");
        返回 1;
    }
    // 70-a（2026-09-11 方案A 补完）：系统::参数 已改 字符*（argv=CRT 持有借用）
    //   ——按借用接收判空；传 字符串 形参须显式 复制（A2 收紧）
    字符* 数据路径 = 系统::参数(1);
    字符* 输出路径 = 系统::参数(2);
    如果 (数据路径 == 无 || 输出路径 == 无) {
        IO::打印到错误("参数解析失败\n");
        返回 2;
    }
    打印("数据文件: ", 数据路径);
    打印("输出文件: ", 输出路径);
    整32 状态 = 工具主体(字符串复制(数据路径), 字符串复制(输出路径));
    返回 状态;
}
