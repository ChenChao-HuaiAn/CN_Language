// E2E 929（2026-10-14·任务 #728k「手工线程（绕过运行时创建）备用栈守卫不覆盖」）：
//   476 栈溢出防线（错误码 9·guard page 被动捕获）给「经运行时创建的线程」装了
//   备用栈（thread_api.cpp trampoline 自动调 cn_install_thread_stack_guard）；
//   但用户绕过 CN 运行时、手工 pthread_create 的线程没有备用栈——栈溢出时
//   SIGSEGV 处理器在已耗尽的栈上运行=二次故障（脏崩无输出）。
//   本例验证 728k 公开的显式通道：手工线程入口调用一次
//   cn_install_thread_stack_guard()（FFI 声明·001 §10.2b·runtime.hpp 公开 API）
//   → 该线程栈溢出时输出 运行时错误(错误码9): 栈溢出 确定性终止 rc=1。
//   对照组实录（不装守卫·非确定行为不入期望断言）：同源码去掉安装调用 →
//   rc=139 段错误脏崩、无错误码 9 输出（深度机 2026-10-14 探针实测）。
//   健康对照（反证面）：安全深度 1000 层递归在线程内正常完成并输出 500500
//   ——安装动作（每线程一次）对安全路径零影响，误伤即红。
//   环境适配（E2E runner 对子进程 RLIMIT_STACK=无限 + RLIMIT_AS=8GB）：手工
//   线程栈走 glibc 默认（RLIMIT_STACK 无限时=架构默认栈大小），深度取 1e8
//   稳爆——溢出写 guard page 触发 SIGSEGV（备用栈上判定输出），不依赖压地址。
//   边界如实标注：win-x64 无 pthread（该用例已入 runner 平台跳过表）——win 的
//   手工线程无此缺口（VEH/UEF 进程级过滤器覆盖全部线程·x64 内核受控栈），
//   运行时符号在 win 为空操作（三平台同签名可链接，cross 调用零行为）。
//   双编译对照：宿主与 v2 同源同测——输出逐行一致 + 退出码一致（1=栈溢出终止）。
外部 函数 cn_install_thread_stack_guard() -> 空类型
外部 函数 pthread_create(整64* 线程号, 空类型* 属性, 空类型(*入口)(空类型*), 空类型* 参数) -> 整32
外部 函数 pthread_join(整64 线程号, 空类型** 返回值) -> 整32

函数 递(整64 深度) -> 整64 {
    如果 (深度 <= 0) {
        返回 0;
    }
    返回 深度 + 递(深度 - 1);   // 非尾递归（结果参与相加·不受尾调用优化）
}

不安全 函数 手工线程体(空类型* 参数) -> 空类型 {
    cn_install_thread_stack_guard();   // 728k：手工线程入口显式安装（本次验证点）
    打印(递(1000));          // 500500 安全深度（健康对照·防误伤）
    打印(递(100000000));     // 深递归 → 运行时错误(错误码9): 栈溢出 终止
    返回;
}

不安全 函数 主() -> 整32 {
    打印("===== 929 手工线程栈守卫 =====");
    整64 线程号 = 0;
    整32 创建 = pthread_create(&线程号, 无, 手工线程体, 无);
    如果 (创建 != 0) {   // 创建失败=环境不支持（如实报出·不静默）
        打印("pthread_create 失败:", 创建);
        返回 2;
    }
    pthread_join(线程号, 无);
    返回 0;
}
