// E2E 1563（#1607 同型放行正例锁面）：合成体宽型（整128）载荷**同型**转换
//   保持放行——乙案收紧只拒异型（emitPayloadConv 同型侧 isI128 走聚合拷贝
//   语义完备）。锁面：同型声明位拷贝值保真 + 错误态同型载荷 + 可选 同型。
导入 测试框架::{测试器, 运行用例, 断言真, 断言相等整数, 测试汇总};

不安全 函数 用例同型声明位拷贝(测试器* 器) {
    结果<整128,整32> 甲 = 正常(1180591620717411303424);
    结果<整128,整32> 乙 = 甲;
    如果 (乙.正常) {
        断言真(器, 乙.值 == 1180591620717411303424, "同型拷贝值保真");
    }
    断言真(器, 甲.正常, "源完好（值语义）");
}

不安全 函数 用例错误态同型(测试器* 器) {
    结果<整128,整32> 丙 = 错误(9);
    如果 (!丙.正常) {
        断言相等整数(器, 丙.错误, 9, "错误态同型载荷");
    }
}

不安全 函数 主() -> 整32 {
    测试器 器 = 测试器();
    运行用例(器, "同型声明位拷贝", 用例同型声明位拷贝);
    运行用例(器, "错误态同型", 用例错误态同型);
    返回 整32(测试汇总(器));
}
