// 719_大结构体值捕获（#428·#276 波1.5 收口·001「lambda 表达式」值捕获=快照）
// >8 字节结构体值捕获=定义处**整体深拷快照**（宿主 __capstruct+CopyStruct 同构
//   ·spec 04-一D 捕获时复制）：快照槽=多槽、快照段=结构体赋值通道位拷；标量
//   单槽 Load/Store 只拷首 8 字节（433 挂账残余面）——尾字段读相邻槽垃圾。
// 期望手算：和=1+2+3+4=10；d=4（非 400）；z=3（非 30）；x=1（非 9）；
//   积=5*6*7*8=1680（非 0·q.a 已清零）。
结构体 大点 {
    整32 a;
    整32 b;
    整32 c;
    整32 d;
}

结构体 三维 {
    整32 x;
    整32 y;
    整32 z;
}

函数 主() -> 整32 {
    变量 p = 大点{ a = 1, b = 2, c = 3, d = 4 };
    变量 取和 = [p]() -> 整32 { 返回 p.a + p.b + p.c + p.d; };
    变量 取d = [p]() -> 整32 { 返回 p.d; };
    p.a = 100;
    p.c = 300;
    p.d = 400;
    打印(取和());                     // 10（快照·尾字段 c/d 非垃圾）
    打印(取d());                      // 4（快照·非 400）
    变量 v = 三维{ x = 1, y = 2, z = 3 };
    变量 取z = [v]() -> 整32 { 返回 v.z; };
    变量 取x2 = [=]() -> 整32 { 返回 v.x; };
    v.z = 30;
    v.x = 9;
    打印(取z());                      // 3（12B 跨槽快照·非 30）
    打印(取x2());                     // 1（[=] 形态同通道·非 9）
    变量 q = 大点{ a = 5, b = 6, c = 7, d = 8 };
    变量 取积 = [q]() -> 整32 { 返回 q.a * q.b * q.c * q.d; };
    q.a = 0;
    打印(取积());                     // 1680（独立快照·非 0）
    返回 0;
}
