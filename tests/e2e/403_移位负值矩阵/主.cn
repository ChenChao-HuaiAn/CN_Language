// 403 移位负值矩阵（287-a）：linux_x64 后端 O0 移位发射零扩展污染根治的语义守护。
//   缺陷面=i32 栈槽装载（mov r10d 零扩展）+64 位 sar 符号位丢失
//   （s2026091705：-426>>13 出 524286 应为 -1·M3 采样独家捕获·asm 三件套定案）。
//   **#474 立法翻转（2026-10-11 用户裁决乙案）**：原「移位量 mod 取模语义」条文
//   废除（001 §4.4 #474）——负移位量/超宽移位量运行期=错误码 8、常量移位量超宽=
//   编译期硬错误（732 负测承载）。本用例矩阵改写（**等值改写·期望值逐行不变**）：
//   ①③④⑤ 原负移位量 乙=-5875（mod 32=13）→ 改正值变量移位量 移量=13（变量
//   移位量发射路径守护保留·负值**操作数**面 -426/-300/-100 原样）；⑧ 原大移位量
//   巳=100（mod 32=4）→ 改显式取模 `巳 % 32`（001 条文「确需取模移位者手写显式
//   闭环」·% 运算即显式知情）；②⑥⑦ 常量域内移位量 13/3/19 与正值变量移位量卯
//   原样保留。负移位量触发面（乙 作移位量 → 错误码 8）随移除移交 727 同族
//   （运行期移位量域检查·负量形态补锚见看板 #474 收口呈报）。
//   矩阵面：i32 负值变量/常量移位量 sar、shl 低 32 位免疫、正值零回归对照、
//   i16/i8 movsx 装载免疫、u32 shr 零扩展即值免疫、显式取模移位合法。
函数 主() -> 整32
{
    整32 甲 = -426;
    整32 移量 = 13;
    // ① 核心缺陷面：i32 负值 >> 变量移位量（移量=13 → sar 13 = -1）
    整32 丙 = (甲 >> 移量);
    打印(丙);
    // ② 常量移位量路径对照（编译期掩码·imm 直发）
    整32 丁 = (甲 >> 13);
    打印(丁);
    // ③ shl 免疫面（结果取低 32 位·正值变量移位量）
    整32 戊 = (甲 << 移量);
    打印(戊);
    // ④ 正值对照（修前修后同值 = movsxd 零回归论证面）
    整32 己 = 1000;
    整32 庚 = (己 >> 移量);
    打印(庚);
    // ⑤ i16 免疫面（装载已 movsx 符号扩展）
    整16 辛 = -300;
    整32 壬 = (辛 >> 移量);
    打印(壬);
    // ⑥ i8 免疫面
    整8 癸 = -100;
    整32 子 = (癸 >> 3);
    打印(子);
    // ⑦ u32 shr 免疫面（零扩展即无符号值语义·含缺陷污染值对照）
    正32 丑 = 4294956821;
    正32 寅 = (丑 >> 13);
    打印(寅);
    正32 卯 = 19;
    正32 辰 = (丑 >> 卯);
    打印(辰);
    // ⑧ 显式取模移位合法面（#474 手写显式闭环·100 % 32 = 4 → -426 sar 4 = -27）
    整32 巳 = 100;
    整32 午 = (甲 >> (巳 % 32));
    打印(午);
    // ⑨ 语义判定面（污染值 524286 应为假·规范值 -1 应为真）
    布尔 申 = ((甲 >> 移量) == -1);
    打印(申);
    布尔 酉 = ((甲 >> 移量) == 524286);
    打印(酉);
    返回 0;
}
