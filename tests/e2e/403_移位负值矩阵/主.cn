// 403 移位负值矩阵（287-a）：linux_x64 后端 O0 移位发射零扩展污染根治的语义守护。
//   缺陷面=i32 栈槽装载（mov r10d 零扩展）+64 位 sar 符号位丢失
//   （s2026091705：-426>>13 出 524286 应为 -1·M3 采样独家捕获·asm 三件套定案）。
//   矩阵面：i32 负值变量/常量移位量 sar、shl 低 32 位免疫、正值零回归对照、
//   i16/i8 movsx 装载免疫、u32 shr 零扩展即值免疫、大移位量 mod 取模语义。
函数 主() -> 整32
{
    整32 甲 = -426;
    整32 乙 = -5875;
    // ① 核心缺陷面：i32 负值 >> 变量移位量（-5875 mod 32 = 13 → sar 13 = -1）
    整32 丙 = (甲 >> 乙);
    打印(丙);
    // ② 常量移位量路径对照（编译期掩码·imm 直发）
    整32 丁 = (甲 >> 13);
    打印(丁);
    // ③ shl 免疫面（结果取低 32 位·负移位量同 mod 语义）
    整32 戊 = (甲 << 乙);
    打印(戊);
    // ④ 正值对照（修前修后同值 = movsxd 零回归论证面）
    整32 己 = 1000;
    整32 庚 = (己 >> 乙);
    打印(庚);
    // ⑤ i16 免疫面（装载已 movsx 符号扩展）
    整16 辛 = -300;
    整32 壬 = (辛 >> 乙);
    打印(壬);
    // ⑥ i8 免疫面
    整8 癸 = -100;
    整32 子 = (癸 >> 3);
    打印(子);
    // ⑦ u32 shr 免疫面（零扩展即无符号值语义·含缺陷污染值对照）
    正32 丑 = 4294956821;
    正32 寅 = (丑 >> 13);
    打印(寅);
    正32 卯 = 19;
    正32 辰 = (丑 >> 卯);
    打印(辰);
    // ⑧ 大移位量 mod 取模语义（100 mod 32 = 4 → -426 sar 4 = -27）
    整32 巳 = 100;
    整32 午 = (甲 >> 巳);
    打印(午);
    // ⑨ 语义判定面（污染值 524286 应为假·规范值 -1 应为真）
    布尔 申 = ((甲 >> 乙) == -1);
    打印(申);
    布尔 酉 = ((甲 >> 乙) == 524286);
    打印(酉);
    返回 0;
}
