// 1307_lambda值捕获快照写拒（#1881·001「lambda 表达式」快照只读立法·dual 负测）
// 立法：值捕获（[=]/[变量]/[]）为定义处快照副本（只读）——闭包体内写值捕获
//   变量=写副本不写回外部且不跨调用持久（快照语义完整性破坏+蹦床通道静态槽
//   跨调用持久怪异）→ 编译期拒，诊断指路改用 [&] 引用捕获（写穿原变量）。
//   001 §780 条文随件补写（快照只读段·〔通告〕）。
// 写挂点全谱（每函数一形态·宿主 checkValueCaptureWrite 三挂点+v2 检查合成体
//   值捕写 块树递归 同构同拒；修前双侧静默放行=写副本丢弃·探针实录）：
//   ①[=] 标量赋值写 ②[变量] 显式标量写 ③[=] 复合赋值 ④[=] 自增写
//   ⑤[=] 数组元素写 ⑥[=] 字符串拼接写 ⑦[变量] 类字段写 ⑧[=] 容器写方法
//   ⑨[] 空捕获隐式值捕获写（条文「[] 快照只读」第三层形态·双侧执法面形态
//   0/1/2 同拒）
//   （①~⑨任一漏拒而其余拒=整体仍编译失败=负测绿——形态矩阵在此逐条声明
//   供审计；单形态漏拒的专锁由本用例源注释锚定+呈报矩阵承担）
// 合法面（零误伤锚·不进本负测）：[&] 写穿/读快照/参数遮蔽写/体内声明遮蔽
//   写/容器读方法/不安全 函数内豁免——全谱见 1671 正测。
// 预期失败：双侧编译拒绝，诊断锚「修改值捕获的变量」。
导入 容器::向量;

类 点 {
    公开:
        整32 横;
}

// ①[=] 标量赋值写
函数 甲() -> 整32 {
    变量 x = 5;
    变量 f = [=]() -> 整32 {
        x = x + 1;
        返回 x;
    };
    返回 f();
}

// ②[变量] 显式标量写
函数 乙() -> 整32 {
    变量 y = 10;
    变量 g = [y]() -> 整32 {
        y = y + 1;
        返回 y;
    };
    返回 g();
}

// ③[=] 复合赋值写
函数 丙() -> 整32 {
    变量 n = 7;
    变量 h = [=]() -> 整32 {
        n += 2;
        返回 n;
    };
    返回 h();
}

// ④[=] 自增写
函数 丁() -> 整32 {
    变量 m = 3;
    变量 k = [=]() -> 整32 {
        m++;
        返回 m;
    };
    返回 k();
}

// ⑤[=] 数组元素写
函数 戊() -> 整32 {
    整32[3] arr = {1, 2, 3};
    变量 m2 = [=]() -> 整32 {
        arr[0] = 99;
        返回 arr[0];
    };
    返回 m2();
}

// ⑥[=] 字符串拼接写
函数 己() -> 整32 {
    字符串 s = "甲";
    变量 f2 = [=]() -> 字符串 {
        s = s + "乙";
        返回 s;
    };
    返回 0;
}

// ⑦[变量] 类字段写
函数 庚() -> 整32 {
    点 p;
    p.横 = 7;
    变量 f3 = [p]() -> 整32 {
        p.横 = 99;
        返回 p.横;
    };
    返回 f3();
}

// ⑧[=] 容器写方法调用
函数 辛() -> 整32 {
    向量<整32> v;
    变量 f4 = [=]() -> 整32 {
        v.追加(9);
        返回 0;
    };
    返回 f4();
}

// ⑨[] 空捕获隐式值捕获写（快照只读第三层：[] 体内写外层局部=写隐式快照副本）
函数 壬() -> 整32 {
    变量 t = 42;
    变量 f5 = []() -> 整32 {
        t = t + 1;
        返回 t;
    };
    返回 f5();
}

函数 主() -> 整32 {
    返回 0;
}
