// 708 锁用例（427 转正·打印/打印行 newline IR 数差槽位一致性）：113 现代形态·打印/打印行 密集交错
//   触发器验证——打印 比 打印行 多一条 __cn_print_newline 调用 IR（数差=1/处），
//   交错使用使函数内寄存器排布在两种形态间反复横跳；打印后立即访问容器元素/
//   结构体字段链=槽敏感位置。若发射器存在槽漂移潜伏面，此形态下暴露为
//   输出错位/垃圾值/崩溃。
导入 容器::向量;
导入 映射集合;

结构体 符号 {
    整64 名ID;
    整64 类型ID;
}

函数 主() -> 整32 {
    映射<整64, 符号> 层 = 映射<整64, 符号>();
    打印行("A1");
    符号 s1;
    s1.名ID = 11;
    s1.类型ID = 101;
    结果<空类型, 整32> 加1 = 层.设置(1, s1);
    打印("A2 ", 加1.正常);
    打印行("B1");
    符号 s2;
    s2.名ID = 22;
    s2.类型ID = 202;
    结果<空类型, 整32> 加2 = 层.设置(2, s2);
    打印("B2 ", 加2.正常);
    结果<符号, 整32> 查1 = 层.获取(1);
    如果 (查1.正常) {
        打印("C1 ", 查1.正常);
        打印行("C2 ", 查1.值.类型ID);
    }
    向量<映射<整64, 符号>> 表 = 向量<映射<整64, 符号>>();
    结果<空类型, 整32> 压 = 表.追加(层);
    打印("D1 ", 压.正常);
    打印行("D2 ", 表.大小());
    映射<整64, 符号> 顶层 = 表.元素(0);
    打印("E1 ", 顶层.大小());
    结果<符号, 整32> 查r = 顶层.获取(2);
    如果 (查r.正常) {
        打印行("E2 ", 查r.值.类型ID);
    }
    整64 i = 0;
    当 (i < 表.大小()) {
        映射<整64, 符号> 环 = 表.元素(i);
        打印("F", i);
        打印行(" ", 环.大小());
        i = i + 1;
    }
    结果<空类型, 整32> 删r = 表.删除(0);
    打印("G1 ", 删r.正常);
    打印行("G2 ", 表.大小());
    返回 0;
}
