// 主入口（第 7 层：45_import_syntax 导入语法全形式 E2E，规格书08-三）
// v2.0 导入语法全形式覆盖（对照 43_module_import 的 v1.0 遗留补充：
//   v2.0 新增 作为 重命名 + 通配符 * + 花括号项内重命名）：
//   ① 导入 工具::加         —— 单符号路径导入，限定调用 工具::加（重写为纯名）
//   ② 导入 工具::{乘 作为 乘法} —— 花括号项重命名：纯名 乘法() 调用
//   ③ 导入 工具::{减, 加 作为 加法} —— 花括号多符号 + 项内重命名：纯名 减/加法
//   ④ 导入 工具::*          —— 通配符导入：纯名直调 乘（不限定）
//   ⑤ 导入 工具             —— 整模块导入：限定调用 工具::加 / 工具::获取版本
//   ⑥ 公开常量跨模块：获取版本() 返回顶层公开常量（决策9 验证）
// 注意：整路径重命名（导入 工具 作为 别名）在语义层绑定为"模块级别名"，
//   纯名调用不走符号重写（编译器实现边界），故重命名用花括号项内形式。

导入 工具::加;
导入 工具::{乘 作为 乘法};
导入 工具::{减, 加 作为 加法};
导入 工具::*;
导入 工具;

函数 主() -> 整32 {
    打印("===== 导入语法全形式（第 7 层）=====");

    // ---- ① 单符号路径导入：限定调用 ----
    整64 和1 = 工具::加(10, 32);
    打印("工具::加(10,32): ", 和1);               // 42

    // ---- ② 花括号项重命名：纯名 乘法 ----
    整64 积1 = 乘法(6, 7);
    打印("乘法(6,7): ", 积1);                     // 42

    // ---- ③ 花括号多符号 + 项内重命名：纯名 减 / 加法 ----
    整64 差1 = 减(50, 8);
    打印("减(50,8): ", 差1);                      // 42
    整64 和2 = 加法(20, 22);
    打印("加法(20,22): ", 和2);                   // 42

    // ---- ④ 通配符导入：纯名直调 乘（无需限定）----
    整64 积2 = 乘(5, 8);
    打印("乘纯名(5,8): ", 积2);                   // 40

    // ---- ⑤ 整模块导入：限定调用 ----
    整64 和3 = 工具::加(100, 200);
    打印("工具::加(100,200): ", 和3);             // 300

    // ---- ⑥ 公开常量跨模块（经公开函数体引用）----
    整64 版本值 = 工具::获取版本();
    打印("工具::获取版本(): ", 版本值);           // 100

    // ---- 组合验证 ----
    整64 组合 = 乘法(加法(3, 4), 减(20, 14));
    打印("乘法(加法(3,4), 减(20,14)): ", 组合);   // 42

    打印("===== 导入语法全形式测试完成 =====");
    返回 0;
}
