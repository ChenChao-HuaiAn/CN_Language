// 1460：1302 P0-1 回归锁——同名标量/结构体先声明、结果/可选同名后声明：
//   预扫槽必须按声明身份隔离，不得把重绑定槽当结果基槽清零（指针旁证断言）。
//   另加无关邻变量 邻=42 断言：锁「基槽-(N-1) 伸进邻槽」的完整邻槽面。
结构体 盒 {
    整64 值;
}
函数 求() -> 结果<整64, 整32> {
    返回 正常(7);
}
不安全 函数 标量旁证(整64 触) -> 整64 {
    整64 邻 = 42;
    整64 甲 = 42;
    整64* 针 = &甲;
    如果 (触 > 0) {
        结果<整64, 整32> 甲 = 求();
        如果 (甲.正常) { 整64 影 = 甲.值; }
    }
    打印("标量邻=" + 整数转字符串(邻));
    返回 *针;
}
不安全 函数 结构体旁证(整64 触) -> 整64 {
    整64 邻 = 42;
    盒 甲;
    甲.值 = 42;
    盒* 针 = &甲;
    如果 (触 > 0) {
        结果<整64, 整32> 甲 = 求();
        如果 (甲.正常) { 整64 影 = 甲.值; }
    }
    打印("结构邻=" + 整数转字符串(邻));
    返回 针.值;
}
不安全 函数 主() -> 整32 {
    整64 甲 = 标量旁证(1);
    整64 乙 = 结构体旁证(1);
    打印("标量旁=" + 整数转字符串(甲));
    打印("结构旁=" + 整数转字符串(乙));
    如果 (甲 == 42 && 乙 == 42) { 返回 0; }
    返回 1;
}
