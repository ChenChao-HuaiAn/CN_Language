// E2E 446（2026-09-18 第 351 轮·T27 v2 侧同构阶段二·423 SIGFPE 三后端闭环门禁）：
//   除法/取余保护矩阵——①有符号 INT_MIN/-1 两补码统一回绕（x/-1≡-x〔INT_MIN→
//   INT_MIN〕·x%-1≡0）×整32/整64（x64l/win=运行时特判；arm64=架构级回绕·三后端
//   逐值一致）；②普通负值除余语义（C 对齐：-7/3=-2·-7%3=-1）；③无符号通路
//   （udiv/div 不回归）；④变量除零 → 运行时错误(错误码1)（宿主 319-a 与 v2 351-a
//   同通道同码同文案）。32/64 位除法形态一律用**变量除数**（319-a 编译期常量除零
//   硬错误只对双侧字面量触发；T60 常量类型提升面另立案·不混入本锚定）。
//   双编译对照：宿主与 v2 同源同测——输出逐行一致 + 退出码一致（1=除零终止）。
函数 主() -> 整32 {
    // ① 整32 有符号 INT_MIN/-1（x64l/win=cdq+idiv r11d 前特判；arm64=w 版 sdiv 回绕）
    整32 a32 = -2147483648;
    整32 负一32 = -1;
    打印(a32 / 负一32);
    打印(a32 % 负一32);
    // ② 整64 有符号 INT64_MIN/-1（变量面）
    整64 a64 = -9223372036854775808;
    整64 负一64 = -1;
    打印(a64 / 负一64);
    打印(a64 % 负一64);
    // ③ 普通负值对照（非 MIN·语义正确性）
    整32 b32 = -100;
    打印(b32 / 负一32);
    打印(b32 % 负一32);
    打印(b32 / 3);
    打印(b32 % 3);
    // ④ 无符号通路（正64=udiv/div r11·正32=udiv w/div r11d——保护不误伤）
    正64 u甲 = 100;
    正64 u乙 = 7;
    打印(u甲 / u乙);
    打印(u甲 % u乙);
    正32 u丙 = 200;
    正32 u丁 = 6;
    打印(u丙 / u丁);
    打印(u丙 % u丁);
    // ⑤ 变量除零（末位——触发即终止·rc=1）：整32/整64 共享同一检查发射
    整32 零32 = 0;
    打印(b32 / 零32);
    返回 0;
}
