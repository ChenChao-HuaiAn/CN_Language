// 官网文档示例 · tutorial-syntax.html · 控制流（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
枚举 命令 { 启动, 停止, 查询 }

函数 主() -> 整32 {
    整32 键 = 2;
    选择 (键) {
        情况 0:
            打印("零");
            中断;
        情况 1, 2:            // 多值分组
            打印("一或二");
            中断;
        默认:
            打印("其他");     // 不写 中断 会贯穿下一分支（C 语义）
    }

    字符串 指令 = "开始";
    选择 (指令) {             // 字符串选择
        情况 "开始", "继续":
            打印("执行");
            中断;
        默认:
            打印("未知");
    }

    命令 c = 命令.查询;
    选择 (c) {                // 裸枚举成员（按条件类型定向解析）
        情况 启动:
            打印("启动中");
            中断;
        情况 查询:
            打印("查询中");
            中断;
        默认:
            打印("…");
    }
    返回 0;
}