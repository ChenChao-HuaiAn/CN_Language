// E2E 224（2026-09-12 第七十七轮，plans/020 矩阵 A21 格靶子）：
//   **借出视图「容器先亡」拒绝**（宿主负测：期望编译失败，诊断锚
//   「容器作用域结束后」）。
//   形态：借出视图（赋值形态）转入**外层**变量 → 容器所在块结束（容器析构
//   释放元素）→ 外层继续使用 = 悬垂（探针 77-2 形态G 实证：搅动后内容损坏，
//   校验位 0）。Rust 对照：借用不得比 owner 长寿（生命周期包含关系被静态拒绝）。
//   判据 = 使用发生时容器已不可见（lookupVarId 解析不到原声明即容器已出作用域）。
//   三形态：块内借出→块外使用 / 循环体内容器→循环后使用 / 嵌套块内借出→外层使用。
导入 容器::向量;
导入 容器::链表;

// ① 块内容器 → 借出赋给块外变量 → 块外使用
函数 形态一() -> 整32 {
    字符串 借出 = "";
    如果 (1 == 1) {
        向量<字符串> 表 = 向量<字符串>();
        结果<空类型, 整32> 加 = 表.追加(字符串复制("形态一元素甲乙丙丁戊己庚辛壬癸"));
        如果 (!加.正常) { 运行时错误(4); }
        借出 = 表.元素(0);
    }
    如果 (字符串比较(借出, "形态一元素甲乙丙丁戊己庚辛壬癸")) { 返回 1; }
    返回 0;
}

// ② 循环体内容器 → 借出赋给循环外变量 → 循环后使用
函数 形态二() -> 整32 {
    字符串 借出 = "";
    整64 i = 0;
    当 (i < 2) {
        链表<字符串> 表 = 链表<字符串>();
        结果<空类型, 整32> 加 = 表.头部追加(字符串复制("形态二元素甲乙丙丁戊己庚辛壬癸"));
        如果 (!加.正常) { 运行时错误(4); }
        借出 = 表.头部元素();
        i++;
    }
    返回 整32(字符串长度(借出));
}

// ③ 嵌套块内借出 → 最外层使用
函数 形态三() -> 整32 {
    字符串 借出 = "";
    如果 (1 == 1) {
        如果 (2 == 2) {
            向量<字符串> 表 = 向量<字符串>();
            结果<空类型, 整32> 加 = 表.追加(字符串复制("形态三元素甲乙丙丁戊己庚辛壬癸"));
            如果 (!加.正常) { 运行时错误(4); }
            借出 = 表.元素(0);
        }
    }
    如果 (字符串比较(借出, "形态三元素甲乙丙丁戊己庚辛壬癸")) { 返回 1; }
    返回 0;
}

函数 主() -> 整32 {
    返回 形态一() + 形态二() + 形态三();
}
