导入 容器::向量;
导入 映射集合::映射;

// E2E 1761（#1970 内联头锁面·2026-11-04 用户批准实施）：
//   容器字段布局 指针槽(8/8 句柄)→内联头(向量/栈24B·映射56B·集合48B·链表/队列64B)
//   全链锁面——①构造/方法调用/遍历 ②拷贝构造深拷 ③字段=字段赋值 ④析构级联
//   （**1601 历史翻车位**：析构链统一取内联头地址作 this——671 段错误翻车位
//   专属锁）⑤继承链容器字段（基/派两层头·偏移真值）⑥结构体容器字段
//   ⑦空容器零分配（向量() 头零初始化 ptr=null·构造前后活动分配数差=0）
//   ⑧映射字段设置/获取。校验和折位（每形态 1 位）：全对=255。
导入 映射集合::映射;

类 货舱 {
公开:
    向量<字符串> 槽;
    函数 货舱() { 槽 = 向量<字符串>(); }
    函数 ~货舱() {
    }
    不安全 函数 货舱(货舱& 其他) { 槽 = 其他.槽; }
    不安全 函数 产() -> 向量<字符串> {
        向量<字符串> 临时;
        结果<空类型, 整32> r = 临时.追加(字符串复制("新鲜"));
        返回 临时;
    }
}

结构体 桶 {
    整64 编号;
    向量<整64> 表;
}

类 基座 {
公开:
    向量<整32> 基表;
    函数 ~基座() {
    }
}

类 派生 : 基座 {
公开:
    向量<整32> 派表;
    映射<整32, 整32> 派映射;
    函数 ~派生() {
    }
}

类 深拷类 {
公开:
    向量<整32> 表;
    向量<字符串> 串表;
    函数 深拷类() {
    }
    函数 深拷类(深拷类& 其他) {
        表 = 其他.表;
        串表 = 其他.串表;
    }
    函数 ~深拷类() {
    }
}

类 持表 {
公开:
    向量<整32> 名单;
    映射<整32, 整32> 表;
    整64 序号;
    函数 持表() {
        序号 = 42;
    }
    函数 ~持表() {
    }
}

函数 造串() -> 字符串 {
    返回 字符串复制("载荷");
}

函数 主() -> 整32 {
    整32 校验 = 0;
    // 位1（=1）构造/布局/方法/遍历
    {
        整64 前 = 内存::活动分配数();
        持表 对象 = 持表();
        结果<空类型, 整32> 追1 = 对象.名单.追加(7);
        结果<空类型, 整32> 追2 = 对象.名单.追加(8);
        结果<空类型, 整32> 设1 = 对象.表.设置(1, 100);
        结果<整32, 整32> 取1 = 对象.表.获取(1);
        整32 读0 = 对象.名单.元素(0);
        如果 (类型大小(持表) == 88 && 对象.名单.大小() == 2 &&
             读0 == 7 && 取1.正常 && 取1.值 == 100) {
            校验 = 校验 + 1;
        }
    }
    // 位2（=2）析构级联内存锚（1601 翻车位·出口 ~向量/~映射 数组释放零残留）
    {
        整64 前 = 内存::活动分配数();
        {
            持表 对象 = 持表();
            结果<空类型, 整32> 追1 = 对象.名单.追加(7);
            结果<空类型, 整32> 追串 = 对象.名单.追加(8);
        }
        整64 后 = 内存::活动分配数();
        如果 (后 == 前) { 校验 = 校验 + 2; }
    }
    // 位4（=4）继承链容器字段（基/派两层头真偏移+映射字段）
    {
        整64 前 = 内存::活动分配数();
        {
            派生 d = 派生();
            结果<空类型, 整32> 追基 = d.基表.追加(21);
            结果<空类型, 整32> 追派 = d.派表.追加(22);
            结果<空类型, 整32> 设派 = d.派映射.设置(3, 33);
            结果<整32, 整32> 取派 = d.派映射.获取(3);
            如果 (d.基表.大小() == 1 && d.派表.大小() == 1 &&
                 取派.正常 && 取派.值 == 33) {
                校验 = 校验 + 4;
            }
        }
        整64 后 = 内存::活动分配数();
        如果 (后 != 前) { 校验 = 校验 - 4; }
    }
    // 位8（=8）结构体容器字段+元素视图遍历
    {
        桶 b = 桶{ 编号 = 1, 表 = 向量<整64>() };
        结果<空类型, 整32> 追b = b.表.追加(11);
        整64 和 = 0;
        整64 i = 0;
        当 (i < b.表.大小()) {
            和 = 和 + b.表.元素(i);
            i = i + 1;
        }
        如果 (和 == 11 && b.编号 == 1) { 校验 = 校验 + 8; }
    }
    // 位16（=16）拷贝构造深拷+串元素级联
    {
        整64 前 = 内存::活动分配数();
        {
            深拷类 甲 = 深拷类();
            结果<空类型, 整32> 追甲 = 甲.表.追加(31);
            结果<空类型, 整32> 追串 = 甲.串表.追加(字符串复制("甲串"));
            深拷类 乙 = 深拷类(甲);
            如果 (乙.表.大小() == 1 && 乙.串表.大小() == 1 &&
                 乙.串表.元素(0) == "甲串") {
                校验 = 校验 + 16;
            }
        }
        整64 后 = 内存::活动分配数();
        如果 (后 != 前) { 校验 = 校验 - 16; }
    }
    // 位32（=32）字段=字段赋值（源=内联头地址语义）+源出口析构独立
    {
        整64 前 = 内存::活动分配数();
        {
            深拷类 丙 = 深拷类();
            {
                深拷类 甲2 = 深拷类();
                结果<空类型, 整32> 追2 = 甲2.表.追加(31);
                丙.表 = 甲2.表;
            }
            如果 (丙.表.大小() == 1 && 丙.表.元素(0) == 31) { 校验 = 校验 + 32; }
        }
        整64 后 = 内存::活动分配数();
        如果 (后 != 前) { 校验 = 校验 - 32; }
    }
    // 位64（=64）构造调用/返回调用产物入字段（壳内容拷进内联位+壳释放零残留）
    {
        整64 前 = 内存::活动分配数();
        {
            货舱 盒 = 货舱();
            盒.槽 = 盒.产();
            如果 (盒.槽.大小() == 1 && 盒.槽.元素(0) == "新鲜") { 校验 = 校验 + 64; }
        }
        整64 后 = 内存::活动分配数();
        如果 (后 != 前) { 校验 = 校验 - 64; }
    }
    // 位128（=128）空容器零分配（向量() 头零初始化·无堆分配）
    {
        整64 前 = 内存::活动分配数();
        {
            持表 空 = 持表();
            如果 (空.名单.大小() == 0 && 空.表.大小() == 0) { 校验 = 校验 + 128; }
        }
        整64 后 = 内存::活动分配数();
        如果 (后 != 前) { 校验 = 校验 - 128; }
    }
    打印("校验=", 校验);
    如果 (校验 == 255) { 返回 0; }
    返回 1;
}
