// E2E 1639（任务 1768·1607 轮 #1459 同族）：二维数组**元素资源**块出口释放——
//   ①字符串[2][3]：6 个堆串，块出口须逐个 __cn_str_free；
//   ②向量<字符串>[2][3]：6 个容器元素各持数据数组+堆串，块出口须逐元素
//     析构（~向量 释放数据数组）+ 串元素释放。
//   修前双侧同漏（释放判定面用首层元素文本「字符串[3]」/「向量$字符串[3]」
//   判等 → 全 miss；展开长度=第一维×外层步进=只覆盖每行首元素）。
//   修=基元素判定（数组基元素文本/arrayBaseElemOf 剥全部维度）+ 总元素数
//   展开（各维乘积）+ 基元素步进（一维形态与原行为逐字等价）。
//   断言=块内活动分配数（6/12）→ 块出口归零；两形态 × 校验和=2。
导入 容器::向量;

函数 串二维() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 差内 = 0;
    {
        字符串[2][3] 表;
        整32 i = 0;
        当 (i < 2) {
            整32 j = 0;
            当 (j < 3) {
                表[i][j] = 字符串复制("资源");
                j++;
            }
            i++;
        }
        差内 = 内存::活动分配数() - 前;
    }
    整64 差出 = 内存::活动分配数() - 前;
    打印(差内);
    打印(差出);
    如果 (差出 == 0) { 返回 1; }
    返回 0;
}

函数 类二维() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 差内 = 0;
    {
        向量<字符串>[2][3] 群;
        整32 i = 0;
        当 (i < 2) {
            整32 j = 0;
            当 (j < 3) {
                群[i][j] = 向量<字符串>();
                结果<空类型, 整32> r = 群[i][j].追加(字符串复制("载荷"));
                j++;
            }
            i++;
        }
        差内 = 内存::活动分配数() - 前;
    }
    整64 差出 = 内存::活动分配数() - 前;
    打印(差内);
    打印(差出);
    如果 (差出 == 0) { 返回 1; }
    返回 0;
}

函数 主() -> 整32 {
    整64 校验 = 串二维() + 类二维();
    如果 (校验 == 2) {
        打印("二维数组元素出口零泄漏");
        返回 0;
    }
    打印("二维数组元素出口泄漏");
    返回 1;
}
