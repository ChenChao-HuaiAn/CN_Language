// E2E 208_v2（2026-09-11 第六十七轮 plans/019 阶段4' 第二批）：v2 侧拥有型字符串——
//   预扫白名单登记（字面量/标识符/无初值/八函数）+ 初始化 copy 落堆（__cn_str_copy）
//   + 赋值 free 旧+copy 新（拥有链 drop+move，Rust 语义）/非白名单调用（整数转字符串）
//   污染退出（free 旧后借用直存）+ 返回块与块出口 __cn_str_free 释放 + 返回标识符
//   移出跳过 + 用户函数返回调用初值=借用保守不登记（返回拥有类型区分随第三批 字符*）。
//   行为锚定：七形态各折一位校验和（1/2/4/8/16/32/64），退出码 127=全对。
函数 造句(字符串 头) -> 字符串 {
    字符串 句 = 头 + "!";
    返回 句;
}
函数 主() -> 整32 {
    字符串 a = "你好";
    字符串 b = a;
    b = "世界";
    整32 校验 = 0;
    如果 (字符串比较(a, "你好")) { 校验 = 校验 + 1; }
    如果 (字符串比较(b, "世界")) { 校验 = 校验 + 2; }
    字符串 c = 造句("编译期安全");
    如果 (字符串比较(c, "编译期安全!")) { 校验 = 校验 + 4; }
    如果 (字符串长度(a) == 6) { 校验 = 校验 + 8; }
    字符串 d = 字符串子串(b, 0, 3);
    如果 (字符串比较(d, "世")) { 校验 = 校验 + 16; }
    b = 字符串连接(b, "!");
    如果 (字符串比较(b, "世界!")) { 校验 = 校验 + 32; }
    b = 整数转字符串(42);
    如果 (字符串比较(b, "42")) { 校验 = 校验 + 64; }
    打印(校验);
    返回 校验;
}
