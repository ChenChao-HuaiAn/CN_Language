// E2E 988（2026-10-15·任务 775·用户裁决甲）：类实例字段声明初始化器
//   （默认值）——构造期生效·显式赋值覆盖·双侧同构锁面。
//   六形态折位断言（退出码=63）：①构造体覆盖默认 1 ②带参构造 2 ③布尔默认 4
//   ④负号默认 8 ⑤继承基类层 16 ⑥派生层 32。修复前宿主静默丢弃（应 200 得 0）。
类 盒 {
公开:
    整32 值 = 7;
    布尔 开 = 真;
    整32 负 = -3;
    函数 盒() { 值 = 9; }
    函数 盒(整32 v) { 值 = v; }
    函数 取值() -> 整32 { 返回 值; }
    函数 取开() -> 布尔 { 返回 开; }
    函数 取负() -> 整32 { 返回 负; }
}

类 基 {
公开:
    整32 x = 11;
    函数 取x() -> 整32 { 返回 x; }
}

类 派 : 基 {
公开:
    整32 y = 22;
    函数 取y() -> 整32 { 返回 y; }
}

函数 主() -> 整32 {
    整32 和 = 0;
    盒 a;
    如果 (a.取值() == 9) { 和 += 1; }
    盒 b = 盒(5);
    如果 (b.取值() == 5) { 和 += 2; }
    盒 c = 盒();
    如果 (c.取开() == 真) { 和 += 4; }
    如果 (c.取负() == 0 - 3) { 和 += 8; }
    派 p;
    如果 (p.取x() == 11) { 和 += 16; }
    如果 (p.取y() == 22) { 和 += 32; }
    打印行(和);
    返回 和;
}
