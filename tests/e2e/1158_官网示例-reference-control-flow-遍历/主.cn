// 官网文档示例 · reference/control-flow.html · 遍历（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
导入 容器::向量;

函数 主() -> 整32 {
    整32[3] 数组 = {7, 8, 9};
    遍历 数组 中 每个 x { 打印行(x, " "); }     // 数组：元素副本
    打印("");
    向量<字符串> 表 = 向量<字符串>();
    结果<空类型, 整32> 加 = 表.追加("甲");
    加 = 表.追加("乙");
    遍历 表 中 每个 s { 打印行(s, " "); }        // 类容器：大小()+元素(i)
    打印("");
    返回 0;
}