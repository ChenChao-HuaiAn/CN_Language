// 1672_lambda引用捕获长寿命载体逃逸拒（435·001 §780 逃逸形态枚举锁面·dual 负测）
// 001 §780 逃逸形态枚举「赋给全局变量/对象字段/容器元素等长寿命载体」——435
//   执法实现（宿主 lambda_escape::checkAssign MemberExpr/IndexExpr/非局部标识符
//   分支+v2 检查赋值位lambda逃逸 同构）在案，本用例补 E2E 锁面（修前三形态无
//   负测锁定·执法回退不红）。三形态同拒（每函数一形态）：
//   ①[&] 赋顶层静态 fnptr 载体（全局变量位——与安全区「静态变量写」双锚同报，
//     逃逸锚同命中） ②[&] 经局部变量传播后赋结构体对象字段（长寿命载体）
//   ③[&] 存局部回调表数组元素（数组元素位·001 §5.8 回调表同族）
//   豁免面=不安全 函数内定义（435 条文④责任上移·由 737 锁面承担）。
// 预期失败：双侧编译拒绝，诊断锚「逃逸当前栈帧」。
静态 整32(*槽)() = 无;

结构体 载体 {
    整32(*回调)();
}

// ①静态 fnptr 载体（全局变量位）
函数 全局载体() -> 整32 {
    变量 x = 1;
    槽 = [&]() -> 整32 { 返回 x; };
    返回 0;
}

// ②对象字段（经局部闭包变量传播链——保守值集同查）
函数 字段载体() -> 整32 {
    变量 y = 2;
    变量 闭 = [&]() -> 整32 { 返回 y; };
    载体 载;
    载.回调 = 闭;
    返回 0;
}

// ③局部回调表数组元素
函数 表载体() -> 整32 {
    变量 z = 3;
    整32(*表[2])();
    表[0] = [&]() -> 整32 { 返回 z; };
    返回 0;
}

函数 主() -> 整32 {
    返回 0;
}
