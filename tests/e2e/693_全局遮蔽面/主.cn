// 693 全局初始化与作用域遮蔽面
// 期望手算：全局依赖 全局乙=全局甲*2 初始化序=10；块内遮蔽 x=2 块外恢复 1；
//   循环变量遮蔽外层 i=100 循环后仍 100；参数遮蔽全局 7 vs 全局 70
静态 整32 全局甲 = 5;
静态 整32 全局乙 = 全局甲 * 2;    // 10
静态 整32 全局值 = 70;

函数 带参(整32 全局值) -> 整32 {
    返回 全局值;                   // 参数遮蔽：返回实参 7
}

函数 主() -> 整32 {
    打印(全局乙);                  // 10
    整32 x = 1;
    如果 (真) {
        整32 x = 2;
        打印(x);                   // 2（内层遮蔽）
    }
    打印(x);                       // 1（恢复）
    整32 i = 100;
    循环 (整32 i = 0; i < 2; i++) {
        打印(i);                   // 0/1（循环内层）
    }
    打印(i);                       // 100（外层未动）
    打印(带参(7));                 // 7
    打印(全局值);                  // 70
    返回 0;
}
