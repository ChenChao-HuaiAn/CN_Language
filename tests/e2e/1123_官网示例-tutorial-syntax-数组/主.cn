// 官网文档示例 · tutorial-syntax.html · 数组（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
常量 行数 = 3;

函数 主() -> 整32 {
    整32[5] 表 = {10, 20, 30, 40, 50};   // 聚合初始化
    整32[行数] 零表;                      // 长度=常量表达式
    零表[0] = 7;
    打印(表[0], " ", 表[4], " ", 零表[0]);

    整32[3] 甲 = {1, 2, 3};
    整32[3] 乙 = 甲;                      // 整块值拷贝
    乙[0] = 99;
    打印(甲[0], " ", 乙[0]);              // 1 99（两态独立）

    整32 和 = 0;
    遍历 表 中 每个 x { 和 = 和 + x; }
    打印(和);
    返回 0;
}