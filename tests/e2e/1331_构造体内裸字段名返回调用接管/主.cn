// E2E 1331（2026-10-17 任务 #924·629 探针 p629d 原生形态·dual）：**构造体内/方法内
//   裸字段名 ←「返回类/容器对象的调用」**赋值接管（544b/922m 成员链面同根异面——
//   成员链面 629/922 轮已修，裸字段面漏网）。
//   病面（v2 侧·探针实录）：被调方聚合返回 ABI 把对象本体物化到调用方帧内槽
//   （栈地址）——原落 508-a 整体写（用户类=对象内容写进 8B 句柄槽）/843-a 直存
//   （栈地址入槽）→ 字段槽悬垂：读侧空指针/垃圾值（p924b/d/e 探针 v2 rc=-11/错值/
//   free 崩·宿主绿）。修=544b 同款位拷物化（NewObject 新壳 + 本体→新壳结构体拷贝 +
//   旧壳释放 + 句柄入槽）——与成员面同构、宿主语义（调用产物堆句柄直存）零分叉。
//   形一=构造内裸字段←自由函数返回类调用；形二=构造内裸字段←成员方法返回类调用；
//   形三=构造内容器裸字段←自由函数返回容器调用；形四=方法内裸字段多轮覆盖（旧壳
//   释放+活动分配数净零）；形五=方法内容器裸字段多轮覆盖（活动分配数净零）。
//   校验和折位 1+2+4+8+16=31 → 退出码 31（.expected=运行打印逐行比对）。
导入 容器::向量;

类 内盒 {
公开:
    整64 记录;
    函数 内盒() { 记录 = 42; }
    不安全 函数 内盒(内盒& 其他) { 记录 = 其他.记录; }
}

函数 产盒() -> 内盒 {
    内盒 临时 = 内盒();
    返回 临时;
}

类 造者 {
公开:
    整64 申;
    函数 造者() { 申 = 7; }
    函数 产() -> 内盒 {
        内盒 临时 = 内盒();
        返回 临时;
    }
}

类 盒甲 {
公开:
    内盒 槽;
    函数 盒甲() {
        槽 = 产盒();
    }
    函数 换新() {
        槽 = 产盒();
    }
}

类 盒乙 {
公开:
    内盒 槽;
    函数 盒乙() {
        造者 者 = 造者();
        槽 = 者.产();
    }
}

函数 产架() -> 向量<整64> {
    向量<整64> 临时 = 向量<整64>();
    结果<空类型, 整32> r = 临时.追加(7);
    返回 临时;
}

类 盒丙 {
公开:
    向量<整64> 槽;
    函数 盒丙() {
        槽 = 产架();
    }
    函数 换架() {
        槽 = 产架();
    }
}

// 形一：构造内裸字段←自由函数返回类调用
函数 形一() -> 整64 {
    盒甲 甲 = 盒甲();
    如果 (甲.槽.记录 != 42) { 返回 0; }
    返回 1;
}

// 形二：构造内裸字段←成员方法返回类调用
函数 形二() -> 整64 {
    盒乙 乙 = 盒乙();
    如果 (乙.槽.记录 != 42) { 返回 0; }
    返回 2;
}

// 形三：构造内容器裸字段←自由函数返回容器调用
函数 形三() -> 整64 {
    盒丙 丙 = 盒丙();
    如果 (丙.槽.大小() != 1) { 返回 0; }
    如果 (丙.槽.元素(0) != 7) { 返回 0; }
    返回 4;
}

// 形四：方法内裸字段多轮覆盖——旧壳释放（位拷物化接管）+活动分配数净零
函数 形四() -> 整64 {
    整64 前 = 内存::活动分配数();
    {
        盒甲 甲 = 盒甲();
        如果 (甲.槽.记录 != 42) { 返回 0; }
        整64 轮 = 0;
        当 (轮 < 50) {
            甲.换新();
            轮++;
        }
        如果 (甲.槽.记录 != 42) { 返回 0; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 8;
}

// 形五：方法内容器裸字段多轮覆盖——活动分配数净零
函数 形五() -> 整64 {
    整64 前 = 内存::活动分配数();
    {
        盒丙 丙 = 盒丙();
        整64 轮 = 0;
        当 (轮 < 50) {
            丙.换架();
            如果 (丙.槽.大小() != 1) { 返回 0; }
            轮++;
        }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 16;
}

函数 主() -> 整32 {
    整64 校验和 = 形一() + 形二() + 形三() + 形四() + 形五();
    如果 (校验和 == 31) {
        打印("构造体内裸字段名返回调用接管：全通过");
    } 否则 {
        打印("构造体内裸字段名返回调用接管：失败 ", 校验和);
    }
    返回 整32(校验和);
}
