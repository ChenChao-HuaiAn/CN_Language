// E2E 551（宿主正测·889 轮任务 100 实施转正）：结果/可选 类值装箱释放面——
//   统一深拷模型（〔基准=019〕第 1 句默认值语义：未显式 转移() 不自动 move·
//   热路径零拷由第 4 句 LUE/转移() 承接）。修复前缺陷：类值装箱句柄浅存别名+
//   源 RAII 析构紧随=盒携悬垂句柄跨作用域（p8 IR 铁证：装箱→删除对象→返回
//   悬垂·UAF 碰巧未爆）+盒亡不释放=泄漏。修复：①装箱=NewObject+拷贝构造深拷
//   （盒内恒独立副本）②收集面开合成体类值条件条目（结果联合$ 就地展开+
//   可选外壳值字段注条件）③盒亡条件析构（错误态垃圾句柄免疫）④emitOwned-
//   StrFieldFreesAt 块终止保存/恢复（79-a 返回块追加语境坠落毁栈根治）。
//   v2 侧 P7c 已根治（945 影子键）+盒亡释放已通（946 runtime 辅助）——但
//   【语义分叉（946 实测·各有用户裁决依据）】v2 装箱=move（71-a 方案A：源
//   转交不析构·析构 3 次）vs 宿主=深拷（889：源保留·析构 4 次）——逐行
//   输出不可对齐·本例维持 host-only；v2 语义锚=578（退出码口径）。
//   输出断言：甲 / ~货物 / 甲 / ~货物 / 乙 / ~货物 / ~货物（七行）。
类 货物 {
公开:
    字符串 名称;
    函数 货物(字符串 s) {
        名称 = s;
    }
    不安全 函数 货物(货物& 其他) {
        名称 = 字符串复制(其他.名称);
    }
    不安全 函数 ~货物() {
        打印("~货物");
    }
}
函数 装盒() -> 结果<货物, 整32> {
    货物 g = 货物("甲");
    返回 正常(g);
}
函数 主() -> 整32 {
    // ① 跨函数返回场景（修复前=盒携悬垂句柄 UAF 面）
    结果<货物, 整32> r = 装盒();
    如果 r.正常 {
        打印(r.值.名称);
    } 否则 {
        打印(r.错误);
    }
    // r 盒亡析构（~货物 第 2 次）
    // ② 读出面深拷：改副本不影响盒
    货物 s = 货物("乙");
    可选<货物> o = 某些(s);
    如果 o.有值 {
        货物 c = o.值;
        c.名称 = 字符串复制("丙");
        打印(o.值.名称);
    }
    // s 与 o 盒亡析构（~货物 第 3/4 次）
    返回 0;
}
