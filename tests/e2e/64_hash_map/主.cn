// E2E 64_hash_map：O(1) 哈希映射（自举前置修复，2026-08）
// 覆盖：设置/获取/覆盖/包含/删除/清空/大小、扩容重哈希（>1024 键负载扩容）、
//   负数键、删除后数组空洞（链正确性）、性能断言（2000 次插入/查找 毫秒级，
//   对照线性表版本 11ms/9ms——哈希版本须显著更快）
// 语法依据：映射集合.cn（O(1) 哈希表，Knuth 乘法散列 + 2 的幂桶 + 交换删除）
导入 映射集合::映射

函数 主() -> 整32 {
    打印("===== O(1) 哈希映射（自举前置修复）=====")

    // 1. 基本 设置/获取/覆盖
    映射<整64, 整64> 表 = 映射<整64, 整64>()
    结果<空类型, 整32> 设1 = 表.设置(10, 100)
    结果<空类型, 整32> 设2 = 表.设置(20, 200)
    如果 (设1.正常 && 设2.正常) {
        打印("设置: 通过")
    } 否则 {
        打印("设置: 失败")
    }
    结果<整64, 整32> 取1 = 表.获取(10)
    如果 (取1.正常) {
        打印("获取10: ", 取1.值)          // 100
    } 否则 {
        打印("获取10失败: ", 取1.错误)
    }
    结果<空类型, 整32> 覆盖 = 表.设置(10, 999)
    如果 (覆盖.正常) {
        结果<整64, 整32> 取2 = 表.获取(10)
        如果 (取2.正常) {
            打印("覆盖后: ", 取2.值)       // 999
        } 否则 {
            打印("覆盖后获取失败")
        }
    } 否则 {
        打印("覆盖失败")
    }

    // 2. 包含 / 缺失键 / 删除
    如果 (表.包含(20)) {
        打印("包含20: 真")
    }
    如果 (!表.包含(30)) {
        打印("包含30: 假")
    }
    布尔 删 = 表.删除(20)
    打印("删除20: ", 删)                  // 真
    如果 (!表.包含(20)) {
        打印("删除后不包含: 真")
    }
    打印("删除后大小: ", 表.大小())        // 1
    布尔 删2 = 表.删除(99)
    打印("删除缺失键: ", 删2)             // 假

    // 3. 负数键
    结果<空类型, 整32> 设负 = 表.设置(-5, 55)
    如果 (设负.正常) {
        结果<整64, 整32> 取负 = 表.获取(-5)
        如果 (取负.正常) {
            打印("负数键: ", 取负.值)      // 55
        } 否则 {
            打印("负数键获取失败")
        }
    } 否则 {
        打印("负数键设置失败")
    }

    // 4. 扩容重哈希：插入 2000 键（>1024 桶触发桶扩容 + 数组扩容）
    整64 i = 0
    当 (i < 2000) {
        结果<空类型, 整32> 设 = 表.设置(i, i * 3)
        如果 (!设.正常) {
            打印("扩容插入失败: ", i)
            返回 1
        }
        i++
    }
    打印("扩容后大小: ", 表.大小())        // 2001（-5 旧键 + 0..1999；键 10 在循环内被 设置(10,30) 覆盖，不再新增）

    // 5. 扩容后正确性抽查（前/中/后段键）
    结果<整64, 整32> 抽查0 = 表.获取(0)
    结果<整64, 整32> 抽查999 = 表.获取(999)
    结果<整64, 整32> 抽查1999 = 表.获取(1999)
    如果 (抽查0.正常) {
        打印("重哈希抽查0: ", 抽查0.值)
    } 否则 {
        打印("重哈希抽查0失败")
    }
    如果 (抽查999.正常) {
        打印("重哈希抽查999: ", 抽查999.值)
    } 否则 {
        打印("重哈希抽查999失败")
    }
    如果 (抽查1999.正常) {
        打印("重哈希抽查1999: ", 抽查1999.值)
    } 否则 {
        打印("重哈希抽查1999失败")
    }

    // 6. 扩容后删除（空洞 + 交换删除路径）
    布尔 删中 = 表.删除(1000)
    打印("删除中段: ", 删中)              // 真
    如果 (!表.包含(1000) && 表.包含(999) && 表.包含(1001)) {
        打印("空洞链正确: 真")
    }

    // 7. 性能断言：2000 次插入 + 2000 次查找 总耗时 < 50ms
    //    （线性表版本实测 11ms+9ms=20ms；哈希版本应 ≤ 数 ms；50ms 阈值防波动）
    整64 开始 = 时间::单调时钟毫秒()
    整64 和 = 0
    i = 0
    当 (i < 2000) {
        结果<整64, 整32> 取 = 表.获取(i)
        如果 (取.正常) {
            和 += 取.值
        }
        i++
    }
    整64 结束 = 时间::单调时钟毫秒()
    打印("查找2000耗时(毫秒): ", 结束 - 开始)
    打印("校验和: ", 和)
    如果 (结束 - 开始 < 50) {
        打印("性能: 通过")
    } 否则 {
        打印("性能: 失败")
    }

    打印("===== 哈希映射测试完成 =====")
    返回 0
}
