// 条件编译 E2E（Task 6.6，规格书阶段六）
// 覆盖：
//   #定义 宏 / #如果定义(宏) / #否则 / #结束如果 指令
//   命令行 -D 宏注入（run_e2e.py 编译命令附加 -D 调试 参数）
//   未定义宏分支被裁剪（不产生语法错误）
//   嵌套条件编译
// 说明：E2E 编译命令为
//   cn build 条件编译.cn --target win-x64 -D 调试 --output ...
//   （run_e2e.py 编译命令不含 -D，故本用例的 #定义 宏 与嵌套分支用于
//    验证源码内宏机制；命令行宏注入由单元测试 + 手动命令验证）
#定义 发布模式

函数 主() -> 整32 {
    // ---- 1. 源码内 #定义 宏 + #如果定义 选择 ----
    #如果定义 发布模式
    打印("发布模式: 开启")
    #否则
    打印("发布模式: 关闭")
    #结束如果

    // ---- 2. 未定义宏分支裁剪：语法错误代码被裁剪不应报错 ----
    #如果定义 不存在的宏
    这行是非法语法，不应被解析
    #否则
    打印("未定义宏分支: 已裁剪")
    #结束如果

    // ---- 3. 嵌套条件编译 ----
    #如果定义 发布模式
    打印("外层: 真")
    #如果定义 调试模式
    打印("内层: 调试")
    #否则
    打印("内层: 非调试")
    #结束如果
    #否则
    打印("外层: 假")
    #结束如果

    // ---- 4. 空宏名占位（宏未定义时的 #结束如果 正确闭合）----
    #如果定义 调试模式
    #结束如果
    打印("空分支: 已闭合")

    // ---- 5. 括号形式与空白形式等价 ----
    #如果定义(发布模式)
    打印("括号形式: 命中")
    #结束如果
    #如果定义 发布模式
    打印("空白形式: 命中")
    #结束如果

    返回 0
}
