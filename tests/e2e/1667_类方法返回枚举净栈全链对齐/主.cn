// E2E 1667_类方法返回枚举净栈全链对齐（#1456 锁用例·1473 族③补锁·2026-10-31）：
//   类方法返回枚举全链净栈契约锁面。1473 轮 dual 实证「装.取()->颜色」报
//   「净栈契约违反(多压) 增量=2」中止代码生成（独立立案 #1456）；根因族=
//   类型码()（IR容器签名.cn）查表域缺枚举分支→方法调用链返回类型码 T_未知
//   →发射用户类方法调用 目标寄存器分配/压栈/登记全错位。1393 轮（b5d8a7130）
//   类型码() 补枚举名→T_整32 分支根治（平行面：类型名宽度 1393 同轮·类型
//   宽度码 279 轮·类型大小与对齐 279 轮·静态值码641 回落类型码——枚举面
//   五表全谱对齐），本轮全谱形态探针 dual 实证绿后落锁。
//   断言面（八形态）：声明接收/链式中转/传参消费/内联比较/赋值语句/静态方法/
//   虚方法分派/普通函数返回回归（1473 族面对齐）。宿主侧历来正确（enum=int
//   同款）——本用例双编译对照。
// 语法依据（cn-language-spec）：类方法 返回类型（1002 先例）；虚拟/重写（21
//   先例）；枚举成员 颜色.红；继承 类 派 : 基。

枚举 颜色 {
    红,
    绿,
    蓝
}

类 装 {
公开:
    颜色 值;
    函数 装() { 值 = 颜色.绿; }
    函数 取() -> 颜色 { 返回 值; }
    函数 换(颜色 新值) -> 颜色 { 值 = 新值; 返回 值; }
    静态 函数 默认色() -> 颜色 { 返回 颜色.蓝; }
}

类 套 {
公开:
    装 内;
    函数 套() { }
    函数 中转() -> 颜色 { 返回 自身.内.取(); }
}

类 基 {
公开:
    虚拟 函数 虚取() -> 颜色 { 返回 颜色.红; }
}

类 派 : 基 {
公开:
    重写 函数 虚取() -> 颜色 { 返回 颜色.蓝; }
}

函数 消费(颜色 c) -> 整32 {
    如果 (c == 颜色.红) { 返回 1; }
    如果 (c == 颜色.蓝) { 返回 3; }
    返回 2;
}

// 普通函数返回枚举回归（1473 族④面·数组形参+枚举返回）
函数 取首个(颜色[3] 表) -> 颜色 {
    返回 表[0];
}

不安全 函数 主() -> 整32 {
    装 物 = 装();

    // 形态一：类方法返回枚举——声明接收（1456 立项原形态·中止面）
    颜色 c = 物.取();
    打印("声明:");
    如果 (c == 颜色.绿) { 打印(1); } 否则 { 打印(0); }

    // 形态二：链式方法返回枚举——外层方法体 内调 内层方法（调用链中间产物）
    套 外 = 套();
    颜色 d = 外.中转();
    打印("链式:");
    如果 (d == 颜色.绿) { 打印(1); } 否则 { 打印(0); }

    // 形态三：方法返回枚举作实参传函数（实参类型码/ABI 4 字节槽）
    打印("传参:");
    打印(消费(物.取()));            // 2（绿）

    // 形态四：方法返回枚举内联比较（表达式栈净增 1 契约）
    打印("换:");
    如果 (物.换(颜色.蓝) == 颜色.蓝) { 打印(1); } 否则 { 打印(0); }

    // 形态五：赋值语句接收（非声明·存宽 4 字节）
    颜色 e = 颜色.红;
    e = 物.取();
    打印("赋值:");
    如果 (e == 颜色.蓝) { 打印(1); } 否则 { 打印(0); }

    // 形态六：静态方法返回枚举（无 this 位·普通函数 ABI）
    打印("静态:");
    打印(消费(装.默认色()));        // 3（蓝）

    // 形态七：虚方法返回枚举（基指针动态分派）
    派 p = 派();
    基* bp = &p;
    打印("虚:");
    打印(消费(bp.虚取()));          // 3（派::虚取=蓝）

    // 形态八：普通函数返回枚举回归（1473 族面）
    颜色[3] 表 = { 颜色.红, 颜色.绿, 颜色.蓝 };
    打印("普通:");
    如果 (取首个(表) == 颜色.红) { 打印(1); } 否则 { 打印(0); }

    返回 0;
}
