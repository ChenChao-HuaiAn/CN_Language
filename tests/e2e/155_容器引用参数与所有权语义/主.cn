// 容器引用参数与所有权语义（2026-09-06 第二十一轮根治锚定）
// 覆盖（宿主既有语义锚定；v2 闭环解锁后同用例直测 v2）：
//   A 映射& 引用参数：灌(映射&, n) 循环设置/查(映射&, k) 获取——引用传址双向
//   B 元素视图语义：取 = 表们.元素(0)；取.设置(9,90) ——向量内可见（写共享）
//   C 标识符拷贝=深拷贝：B = A 后 B.设置(2,20)——A 不可见（独立对象）
//   D 函数返回容器接收：造表() 返回 m（转移）——接收方可用
// 语义依据（宿主四探针 asm 实证 2026-09-06）：调用返回接收=视图/转移不析构；
//   标识符拷贝=NewObject+拷贝构造（深拷贝）；元素(i)=内联元素地址（rax 视图）
导入 映射集合;
导入 容器;


函数 灌(映射<整64, 整64>& 表, 整64 n) -> 整64 {
    整64 i = 0;
    当 (i < n) {
        结果<空类型, 整32> 设 = 表.设置(i, i * 10);
        如果 (!设.正常) { 返回 -1; }
        i++;
    }
    返回 0;
}

函数 查(映射<整64, 整64>& 表, 整64 k) -> 整64 {
    结果<整64, 整32> 取 = 表.获取(k);
    如果 (取.正常) { 返回 取.值; }
    返回 -1;
}

函数 造表() -> 映射<整64, 整64> {
    映射<整64, 整64> m = 映射<整64, 整64>();
    结果<空类型, 整32> 设 = m.设置(5, 50);
    如果 (!设.正常) { 返回 m; }
    返回 m;
}

函数 主() -> 整32 {
    // A 引用参数
    映射<整64, 整64> 表 = 映射<整64, 整64>();
    整64 r = 灌(表, 20);
    如果 (r != 0) { 返回 1; }
    整64 和 = 查(表, 3) + 查(表, 7) + 查(表, 29);
    打印("引用和=", 和);

    // B 元素视图（写共享）
    向量<映射<整64, 整64>> 表们 = 向量<映射<整64, 整64>>();
    映射<整64, 整64> 层 = 映射<整64, 整64>();
    结果<空类型, 整32> 设1 = 层.设置(1, 100);
    如果 (!设1.正常) { 返回 2; }
    结果<空类型, 整32> 加 = 表们.追加(层);
    如果 (!加.正常) { 返回 3; }
    映射<整64, 整64> 取 = 表们.元素(表们.大小() - 1);
    结果<空类型, 整32> 设9 = 取.设置(9, 90);
    如果 (!设9.正常) { 返回 4; }
    映射<整64, 整64> 再取 = 表们.元素(0);
    结果<整64, 整32> 查9 = 再取.获取(9);
    如果 (查9.正常) {
        打印("视图写=", 查9.值);
    } 否则 {
        打印("视图写=不可见");
    }

    // C 标识符拷贝=深拷贝（A 不见 B 改）
    映射<整64, 整64> 甲 = 映射<整64, 整64>();
    结果<空类型, 整32> 设甲 = 甲.设置(1, 10);
    如果 (!设甲.正常) { 返回 5; }
    映射<整64, 整64> 乙 = 甲;
    结果<空类型, 整32> 设乙 = 乙.设置(2, 20);
    如果 (!设乙.正常) { 返回 6; }
    结果<整64, 整32> 查甲 = 甲.获取(2);
    如果 (查甲.正常) {
        打印("深拷贝=共享");
    } 否则 {
        打印("深拷贝=独立");
    }

    // D 函数返回容器接收
    映射<整64, 整64> 接 = 造表();
    结果<整64, 整32> 查接 = 接.获取(5);
    如果 (查接.正常) {
        打印("返回接收=", 查接.值);
        返回 0;
    }
    返回 7;
}
