// E2E 1038_lambda值捕获资源结构体（#602 销项·dual 双编译对照锁用例）：
//   含资源字段（字符串/容器）结构体经 lambda 值捕获的快照面——801/701/720 只覆盖
//   纯标量字段结构体，资源字段（句柄字段）快照面此前零覆盖。
//   本用例锁定（当前双侧确定的正确面）：
//     ① 字符串字段（字面量·静态池）：源重赋值后闭包读旧串（快照独立·值捕获=
//        定义处复制）；
//     ② 标量字段：源改写后闭包读旧值（801 纯标量面的资源字段邻接锁）；
//     ③ 净残留 0（快照/源正常析构·无泄漏）。
//   【缺口登记·已立案 #940】同面未锁形态（探针实录 2026-10-16·本案先行）：
//     · 堆串字段（字符串复制）+ 源重赋值：闭包读快照=空串（旧堆串已被源释放·
//       快照句柄悬垂）——违反 001「值捕获快照语义无悬垂面」（§一D·435 立法行）；
//     · 容器字段（向量）+ 源重赋值：闭包读快照=大小 0、元素(0) 越界（旧容器
//       悬垂）；容器字段浅拷共享与 #178a「两侧均非深拷模型」同族；
//     · v2：lambda 体内对捕获结构体的容器字段方法调用（.大小/.元素）
//       = [ir2]「方法调用对象类型未解析」→ v2p 内部错误(6) 崩（编译器自崩面）。
//     修复落地后本用例按登记形态补强断言（勿删登记）。
结构体 盒 {
    整32 值
    字符串 名
}

函数 主() -> 整32 {
    整64 基 = 内存::活动分配数();
    {
        盒 货;
        货.值 = 1;
        货.名 = "甲甲甲甲甲甲甲甲";
        变量 看盒 = [货]() -> 整32 { 打印(货.名); 返回 货.值; };
        货.值 = 100;
        货.名 = "乙乙乙乙乙乙乙乙";
        打印(看盒());          // 甲甲甲甲甲甲甲甲（快照·旧串有效）
    }
    打印(内存::活动分配数() - 基);
    返回 0;
}
