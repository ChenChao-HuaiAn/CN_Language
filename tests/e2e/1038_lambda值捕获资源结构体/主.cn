// E2E 1038_lambda值捕获资源结构体（#602 建·#940 扩·dual 双编译对照锁用例）：
//   含资源字段（字符串/容器）结构体经 lambda 值捕获的快照面——801/701/720 只
//   覆盖纯标量字段结构体，资源字段（句柄字段）快照面本用例覆盖。
//   #940（2026-10-17）修复后（值捕获=定义处**深拷快照**·独立拥有副本·源与
//   快照完全解耦·001 §一D「值捕获快照语义无悬垂面」）断言面：
//     ① 字符串字段（字面量·静态池）：源重赋值后闭包读旧串（快照独立）；
//     ② 标量字段：源改写后闭包读旧值（801 纯标量面的资源字段邻接锁）；
//     ③ 堆串字段（字符串复制）【#940 坏形态转正】：源重赋值释放旧堆串后
//        闭包读快照=旧串（修复前悬垂=空串）；标量同锁；
//     ④ 快照副本持有对账【#940】：活动分配数差=4（①+③ 两块各 2=同帧快径
//        临时+静态槽两份深拷副本·不释放——释放归属=闭包值生命周期缺口
//        〔CN 闭包值=裸函数指针无析构语义〕挂账任务的确定性口径）；
//     ⑤ 容器字段（向量）【#940 坏形态转正·v2 自崩面】：源重赋值释放旧容器后
//        闭包读快照=大小 1/元素 42（修复前悬垂=大小 0/元素(0) 越界崩溃；
//        v2 修复前=「方法调用对象类型未解析」内部错误(6) 崩）；
//        本块不参与 ④ 分配数对账（v2 结构体容器字段非空重赋值释放面有
//        既有差异 1 计数·另案挂账·与 lambda 无涉）。
导入 容器::向量;

结构体 盒 {
    整32 值
    字符串 名
}
结构体 桶 {
    整64 号
    向量<整64> 表
}

函数 主() -> 整32 {
    整64 基 = 内存::活动分配数();
    // ①② 字面量串字段 + 标量字段（#602 原锁定面）
    {
        盒 货;
        货.值 = 1;
        货.名 = "甲甲甲甲甲甲甲甲";
        变量 看盒 = [货]() -> 整32 { 打印(货.名); 返回 货.值; };
        货.值 = 100;
        货.名 = "乙乙乙乙乙乙乙乙";
        打印(看盒());          // 甲甲甲甲甲甲甲甲 / 1（快照·源重赋值不影响）
    }
    // ③ 堆串字段（字符串复制）+ 源重赋值（#940 坏形态转正）
    {
        盒 货2;
        货2.值 = 2;
        货2.名 = 字符串复制("丙丙丙丙丙丙丙丙");
        变量 看盒2 = [货2]() -> 整32 { 打印(货2.名); 返回 货2.值; };
        货2.名 = 字符串复制("丁丁丁丁丁丁丁丁");
        打印(看盒2());         // 丙丙丙丙丙丙丙丙 / 2（修复前=空串悬垂）
    }
    // ④ 快照副本持有对账（两块合计 4=①②+③ 各 2 份深拷副本；源析构后无附加残留）
    打印(内存::活动分配数() - 基);   // 4
    // ⑤ 容器字段（向量）+ 源重赋值（#940 坏形态转正·v2 自崩面）
    {
        桶 b;
        b.号 = 7;
        b.表 = 向量<整64>();
        结果<空类型, 整32> 加 = b.表.追加(42);
        如果 (!加.正常) { 返回 40; }
        变量 看桶 = [b]() -> 整32 {
            如果 (b.表.大小() != 1) { 打印(0 - 1); 返回 9; }
            返回 整32(b.表.元素(0));
        };
        b.表 = 向量<整64>();
        打印(看桶());          // 42（修复前=大小 0/元素(0) 越界崩溃）
    }
    返回 0;
}
