// 706（414 审查 P0-1·E2E 正例）：子类覆盖父类运算符重载=合法
//   语法依据（plans/001 §4.6）：重载决议顺序②按**左操作数静态类型**沿继承链
//   查成员「运算符X」——子类定义同名运算符=覆盖（宿主 collectClassMembers
//   逐类 methods.find 本类表）。v2 修前定义处判重误报「重复定义」并丢子类重写。
//   子类版区分度：右操作数 ×2（10+3*2=16 ≠ 基类 13）。
类 基 {
公开:
    整32 值;
    函数 基(整32 甲) { 值 = 甲; }
    函数 运算符+(基 右) -> 基 {
        返回 基(值 + 右.值);
    }
}
类 子 : 基 {
公开:
    函数 子(整32 甲) : 基(甲) {
        值 = 甲;
    }
    函数 运算符+(子 右) -> 子 {
        返回 子(值 + 右.值 * 2);
    }
}
函数 主() -> 整32 {
    基 甲 = 基(10);
    基 乙 = 基(3);
    基 和 = 甲 + 乙;          // 基类版：13
    子 丙 = 子(10);
    子 丁 = 子(3);
    子 和2 = 丙 + 丁;         // 子类覆盖版：10 + 3*2 = 16
    打印(和.值);
    打印(和2.值);
    返回 0;
}
