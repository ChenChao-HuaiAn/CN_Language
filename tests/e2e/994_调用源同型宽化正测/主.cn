// E2E 994（dual 正测·772·2026-10-15）：调用源推导收紧的**不误伤对照**——
//   同型放行/宽化放行（§3.7 白名单在列）/泛型基函数豁免面放行（返回类型含
//   类型参数·零副作用面不推导·显式实例化后推断声明主路径精确）/推断声明
//   调用源（主路径 415/签名链精确·不经静默面）。退出码=75 双侧断言。
泛型 <类型 T>
函数 首个(T* 数组, 整64 长度) -> T {
    返回 数组[0];
}
函数 出8() -> 整8 {
    返回 7;
}
函数 出32() -> 整32 {
    返回 40;
}
函数 主() -> 整32 {
    整8 同型8 = 出8();         // 同型：整8→整8 放行
    整32 宽化32 = 出8();       // 宽化：整8→整32 白名单在列放行
    整8[3] 数据;
    数据[0] = 5;
    数据[1] = 6;
    数据[2] = 7;
    整8 泛同型 = 首个<整8>(数据, 3);   // 泛型显式实例化：同型放行（豁免面②不误伤）
    变量 推断甲 = 出32();      // 推断声明：主路径精确·放行
    返回 同型8 + 宽化32 + 泛同型 + 推断甲;   // 7+7+5+40=59
}
