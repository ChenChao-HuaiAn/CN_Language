// 1317：结构体字段/类字段/容器元素/解引用 字符串比较=内容比较（001 §比较语义）
//   病（1925 探针实录·宿主侧）：isStringTypedExpr 判据只认 字面量/标识符/
//   连接链/数组元素/调用 五形态——成员访问（结构体字段/类字段/结果载荷）与
//   解引用读值不在判据面 → 比较退化为整值指针比较：字段存的是堆副本
//   （字符串复制/连接产物），与字面量/局部变量异地址 ⇒ `字段 != "同内容"` 恒真、
//   `字段 == "同内容"` 恒假（宿主判「不等」·v2 判「相等」=双侧分叉）。
//   修：宿主 IR 判据统一回落 exprSrcType 源类型推导（成员/解引用/三元全覆盖），
//   字符串×字符串走 __cn_str_eq 内容比较；v2 侧补容器值返回方法（元素(0)）的
//   比较类型归一（原判 整64 误拒合法程序）。双侧同结果。
//   本用例覆盖 7 形态：①字段×字面量 ②字段×局部变量 ③字段×另一结构体同名字段
//   ④类字段三形态 ⑤容器元素×字面量 ⑥指针解引用 ⑦非 ASCII/空串/判空边界
//   + ⑧字段拼接（同一判据另一消费面·`字段 + 串` 原误发射指针算术）。
//   校验和折位：①②③④⑤⑥⑦⑧⑨=1/2/4/8/16/32/64/128/256/512/1024/2048/4096/8192/16384/32768——全对=65535。
导入 容器::向量;

结构体 卡 {
    字符串 内容;
}

类 盒 {
公开:
    字符串 内容;
    函数 盒() { 内容 = 字符串复制("甲"); }
    函数 ~盒() { }
    不安全 函数 盒(盒& 其他) { 内容 = 字符串复制(其他.内容); }
}

不安全 函数 主() -> 整32 {
    整32 校验 = 0;

    // ① 结构体字段 × 字面量（字段内容=堆副本，异地址；防驻留字面量同址巧合）
    卡 甲卡;
    甲卡.内容 = 字符串复制("甲");
    如果 (甲卡.内容 == "甲") { 校验 = 校验 + 1; }
    如果 (甲卡.内容 != "甲") { 校验 = 校验 + 1000; }
    如果 (甲卡.内容 != "乙") { 校验 = 校验 + 2; }

    // ② 结构体字段 × 局部字符串变量（同内容不同对象）
    字符串 局部 = 字符串复制("甲");
    如果 (甲卡.内容 == 局部) { 校验 = 校验 + 4; }

    // ③ 结构体字段 × 另一结构体同名字段
    卡 乙卡;
    乙卡.内容 = 字符串复制("甲");
    如果 (甲卡.内容 == 乙卡.内容) { 校验 = 校验 + 8; }
    乙卡.内容 = 字符串复制("乙");
    如果 (甲卡.内容 != 乙卡.内容) { 校验 = 校验 + 16; }

    // ④ 类字段三形态（×字面量 / ×局部变量 / ×另一对象同名字段）
    盒 甲盒 = 盒();
    如果 (甲盒.内容 == "甲") { 校验 = 校验 + 32; }
    如果 (甲盒.内容 == 局部) { 校验 = 校验 + 64; }
    盒 乙盒 = 盒();
    乙盒.内容 = 字符串复制("乙");
    如果 (甲盒.内容 != 乙盒.内容) { 校验 = 校验 + 128; }

    // ⑤ 容器元素（向量<字符串>.元素(0)·T 值返回）× 字面量/变量
    向量<字符串> 表 = 向量<字符串>();
    结果<空类型, 整32> 加 = 表.追加("甲");
    如果 (表.元素(0) == "甲") { 校验 = 校验 + 256; }
    如果 (表.元素(0) == 局部) { 校验 = 校验 + 512; }

    // ⑥ 指针解引用读值（*针）× 字面量
    字符串 原 = 字符串复制("甲");
    字符串* 针 = &原;
    如果 (*针 == "甲") { 校验 = 校验 + 1024; }

    // ⑦ 边界：非 ASCII（多字节）/ 空串 / 判空（判空走指针通道·空串非空指针）
    甲卡.内容 = 字符串复制("😀");
    如果 (甲卡.内容 == "😀") { 校验 = 校验 + 2048; }
    甲卡.内容 = 字符串复制("");
    如果 (甲卡.内容 == "") { 校验 = 校验 + 4096; }
    如果 (甲卡.内容 == 无) { 校验 = 校验 + 10000; }

    // ⑧ 字段拼接（同一判据另一消费面）+ 拼接结果比较
    甲卡.内容 = 字符串复制("甲");
    字符串 合 = 甲卡.内容 + "乙";
    如果 (合 == "甲乙") { 校验 = 校验 + 8192; }
    字符串 合数 = 甲卡.内容 + 7;
    如果 (合数 == "甲7") { 校验 = 校验 + 16384; }

    // ⑨ 结果载荷（结果<字符串,整32>.值=成员访问同族面）
    结果<字符串, 整32> 果 = 正常("甲");
    如果 (果.正常) {
        如果 (果.值 == "甲") { 校验 = 校验 + 32768; }
    }

    打印(校验);
    返回 0;
}
