// E2E 1745_类对象指针字段下标写双侧闭环（#1991 dual·双编译对照）：
//   宿主 IR 下标写元素类型推导（indexAssignElemType MemberExpr 分支）曾按
//   「类宿主」排除**指针字段**（1059/#1680 时代前提=v2 语义层拒类宿主指针
//   字段下标写）；该前提随 v2 #1666 失效后成了宿主单侧拒——合法程序
//   `a.p[0] = 99`（a=类对象、p=整32* 字段）落 #648 内部错误
//   「下标/解引用赋值目标元素类型未解析」，而结构体同形态（x_x4 面）与
//   v2 同语句均绿=类/结构体形态分叉实锤（#648 显形化本身工作正常：未静默
//   错值，但把合法程序拒了）。
//   修=类/结构体宿主共用字段声明类型推导（memberFieldSrcType 双路径）：
//     ① indexAssignElemType 指针字段分支去宿主类别分流（元素 IR 类型=
//        字段指针 pointee）；
//     ② indexTargetElemSrcType 同款放行——否则指针字段×聚合右值（可选/
//        结果 变量·构造调用）仍落兜底 StorePtr 只写 8 字节临时对象地址
//        （写丢·静默错值），本用例形态⑧即该面判据（修前校验和=127）。
//   八形态（退出码=折校验和 255）：
//     ① 类对象指针字段·字面量写读
//     ② 指针算术下标写 p[1]
//     ③ 复合赋值 p[0] += 5
//     ④ 嵌套类字段链 内.p[i]
//     ⑤ 继承基类指针字段（classFieldType 沿继承链）
//     ⑥ 类指针宿主（持有* 丁 = &甲）
//     ⑦ 类数组字段（回归锚·1059 既有面）
//     ⑧ 类指针字段×可选聚合右值（整体赋值通道·②的另一半）
//   读侧锚：全部经实数组/可选值读回校验（双侧同输出）。
//   〔同族邻面〕构造函数内**裸字段名** p[0]=v 属 v2 侧 #1992 修复面
//     （E2E 1740），本用例只锁对象成员链形态，不与 1740 重叠。
类 持有 {
公开:
    整32* p;
    不安全 函数 持有(整32* 源) { p = 源; }
}

类 内层 {
公开:
    整32* p;
    不安全 函数 内层(整32* 源) { p = 源; }
}

类 外层 {
公开:
    内层 内;
    不安全 函数 外层(整32* 源) { 内 = 内层(源); }
}

类 基架 {
公开:
    整32* 基针;
    不安全 函数 基架(整32* 源) { 基针 = 源; }
}

类 子架 : 基架 {
公开:
    不安全 函数 子架(整32* 源) : 基架(源) { }
}

类 选架 {
公开:
    可选<整64>* 槽;
    不安全 函数 选架(可选<整64>* 源) { 槽 = 源; }
}

类 数组架 {
公开:
    整32[3] 组;
}

不安全 函数 主() -> 整32 {
    整32[4] 池 = { 0, 0, 0, 0 };
    整64 校验 = 0;

    // ① 类对象指针字段·字面量写
    持有 甲 = 持有(&池[0]);
    甲.p[0] = 11;
    如果 (池[0] == 11) { 校验 = 校验 + 1; }

    // ② 指针算术下标写
    甲.p[1] = 22;
    如果 (池[1] == 22) { 校验 = 校验 + 2; }

    // ③ 复合赋值
    甲.p[0] += 5;
    如果 (池[0] == 16) { 校验 = 校验 + 4; }

    // ④ 嵌套类字段链
    外层 乙 = 外层(&池[2]);
    乙.内.p[0] = 44;
    如果 (池[2] == 44) { 校验 = 校验 + 8; }

    // ⑤ 继承基类指针字段
    子架 丙 = 子架(&池[3]);
    丙.基针[0] = 55;
    如果 (池[3] == 55) { 校验 = 校验 + 16; }

    // ⑥ 类指针宿主（对象经指针访问）
    持有* 丁 = &甲;
    丁.p[2] = 66;
    如果 (池[2] == 66) { 校验 = 校验 + 32; }

    // ⑦ 类数组字段（回归锚）
    数组架 戊;
    戊.组[1] = 77;
    如果 (戊.组[1] == 77) { 校验 = 校验 + 64; }

    // ⑧ 类指针字段×可选聚合右值（整体赋值通道）
    可选<整64>[2] 选池;
    选架 己 = 选架(&选池[0]);
    己.槽[0] = 某些(88);
    如果 (选池[0].有值 && 选池[0].值 == 88) { 校验 = 校验 + 128; }

    打印("类指针字段下标写=", 校验);
    如果 (校验 != 255) { 返回 1; }
    返回 0;
}
