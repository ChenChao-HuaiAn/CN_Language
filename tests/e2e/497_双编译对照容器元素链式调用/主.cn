导入 容器::向量;
导入 映射集合::映射;
函数 主() -> 整32 {
    向量<映射<整64, 整64>> 层表 = 向量<映射<整64, 整64>>();
    映射<整64, 整64> 层 = 映射<整64, 整64>();
    结果<空类型, 整32> 设 = 层.设置(1, 10);
    如果 (!设.正常) { 返回 1; }
    结果<空类型, 整32> 加 = 层表.追加(层);
    如果 (!加.正常) { 返回 2; }
    结果<整64, 整32> 取甲 = 层表.元素(0).获取(1);
    如果 (取甲.正常) {
        打印("链式取=", 取甲.值, "（期望 10）");
    } 否则 {
        返回 3;
    }
    返回 0;
}
