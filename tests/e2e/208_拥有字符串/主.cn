// E2E 208（宿主正测，2026-09-10 第六十六轮 plans/019 阶段4' 方案A 第一批）：
//   拥有型字符串——字面量/拷贝初始化落堆（__cn_str_copy）+赋值 free 旧+dup
//   +返回块 RAII 自动释放（__cn_str_free）+返回值移出+转移零拷贝。行为锚定
//   （内容语义不变：打印/长度/比较/拼接全对）。期望 stdout 见 .expected。
函数 造句(字符串 头) -> 字符串 {
    字符串 尾 = "!";
    字符串 句 = 字符串复制(头);
    句 = 字符串连接(句, 尾);
    返回 句;
}
函数 主() -> 整32 {
    字符串 a = "你好";
    字符串 b = a;
    b = "世界";
    打印(a);
    打印(b);
    字符串 c = 造句("编译期安全");
    打印(c);
    字符串 d = 转移(c);
    打印(字符串长度(d));
    如果 (字符串比较(a, "你好")) {
        打印("同");
    } 否则 {
        打印("异");
    }
    返回 0;
}
