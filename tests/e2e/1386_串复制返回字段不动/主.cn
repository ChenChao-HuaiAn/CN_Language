// E2E 1386（双编译对照·正例·#1922 件4 放行面）：方法/闭包返回字段串的合法
//   形态=显式 字符串复制(...) 落堆（A2 指路）——字段内容不动（不被按拥有释放）、
//   块出口释放副本后活动分配数回基线（A2 拥有链完整）。
//   与 1765 负例成对：`返回 字段` 借用形态拒绝，`返回 字符串复制(字段)` 放行
//   =plans/001 §5.4 A2 两合法形态（复制落堆 / 改字符* 借用）的复制面锁面。
类 人 {
公开:
    字符串 名;
    函数 人(字符串 n) { 名 = n; }
    函数 取名() -> 字符串 {
        返回 字符串复制(自身.名);
    }
}
函数 主() -> 整32 {
    人 甲 = 人("张三");
    整64 基 = 内存::活动分配数();
    {
        变量 副本 = 甲.取名();
        打印(副本);                    // 张三
    }
    打印(甲.名);                       // 张三（字段不动——不被副本释放）
    打印(内存::活动分配数() - 基);      // 0
    // 闭包放行面（内容断言）：[&] 捕获 + 显式复制返回=拥有副本
    变量 闭 = [&]() -> 字符串 { 返回 字符串复制(甲.名); };
    打印(闭());                        // 张三
    打印(甲.名);                       // 张三（字段不动）
    返回 0;
}
