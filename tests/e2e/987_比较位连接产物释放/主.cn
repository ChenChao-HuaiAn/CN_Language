// E2E 987（2026-10-15·任务 758）：比较位连接产物释放——双侧同修回归。
//   立案背景（732 收口嵌套中间产物时相邻缺口同族实锤）：`甲+乙 == 丙+丁;`
//   语句的两侧连接产物为堆串（拥有契约），唯一消费者=__cn_str_eq/__cn_str_cmp
//   （纯函数·只读内容），调用后零引用；645/663/732 框架只收语句位最终值
//   （比较结果=布尔不命中断否）、连接生成点内层产物与转换临时，比较位两侧
//   操作数在三判定面之外=每语句净泄 2（百轮泄 200·立案实录）。修复=比较
//   消费点单点收口（宿主 genStringCompareBinary 对 left/right 调
//   freeIfConcatTemp·v2 发射字符串比较 内同构·守卫=定义点溯源拼接产物寄存器
//   ——变量 load/转换临时天然排除防误伤）。
//   断言口径（923/946 同款）：每形态百轮 内存::活动分配数() 差值恒 0，折位：
//     ①== 语句位两侧连接=1 ②< 序比较面=2 ③!= 不等面=4
//     ④防误伤对照（纯变量比较+单侧连接+结果正确性）=8 ⑤嵌套组合=16 —— 31=全对。

// ① == 语句位两侧连接（立案形态 `甲+乙 == 丙+丁;`）——修复后每轮净泄 0
函数 比较语句位() -> 整64 {
    字符串 甲 = "左串内容甲乙丙丁";
    字符串 乙 = "右串内容戊己庚辛";
    整64 前 = 内存::活动分配数();
    整32 i = 0;
    当 (i < 100) {
        甲 + "x" == 乙 + "y";
        i += 1;
    }
    返回 内存::活动分配数() - 前;
}

// ② < 序比较面（__cn_str_cmp 消费同面）
函数 序比较位() -> 整64 {
    字符串 甲 = "左串内容甲乙丙丁";
    字符串 乙 = "右串内容戊己庚辛";
    整64 前 = 内存::活动分配数();
    整32 i = 0;
    当 (i < 100) {
        甲 + "x" < 乙 + "y";
        i += 1;
    }
    返回 内存::活动分配数() - 前;
}

// ③ != 不等面（__cn_str_eq 之上取反·两侧消费同面）
函数 不等比较位() -> 整64 {
    字符串 甲 = "左串内容甲乙丙丁";
    字符串 乙 = "右串内容戊己庚辛";
    整64 前 = 内存::活动分配数();
    整32 i = 0;
    当 (i < 100) {
        甲 + "x" != 乙 + "y";
        i += 1;
    }
    返回 内存::活动分配数() - 前;
}

// ④ 防误伤对照：纯变量比较（无连接产物=不释放）+单侧连接（只释放 concat 侧）
//    +结果正确性断言（释放误伤/内容破坏即非零）
函数 防误伤对照() -> 整64 {
    字符串 甲 = "左串内容甲乙丙丁";
    字符串 乙 = "右串内容戊己庚辛";
    整64 前 = 内存::活动分配数();
    整32 i = 0;
    当 (i < 100) {
        甲 == 乙;
        甲 + "x" == 乙;
        i += 1;
    }
    整64 差 = 内存::活动分配数() - 前;
    如果 (甲 != "左串内容甲乙丙丁") { 返回 -1; }
    如果 (乙 != "右串内容戊己庚辛") { 返回 -1; }
    如果 (甲 + "x" != "左串内容甲乙丙丁x") { 返回 -1; }
    返回 差;
}

// ⑤ 嵌套组合：`甲+i+"x" == 乙+"y"`（左内侧连接+转换临时同面收口）
函数 嵌套组合位() -> 整64 {
    字符串 甲 = "左串内容甲乙丙丁";
    字符串 乙 = "右串内容戊己庚辛";
    整64 前 = 内存::活动分配数();
    整32 i = 0;
    当 (i < 100) {
        甲 + i + "x" == 乙 + "y";
        i += 1;
    }
    返回 内存::活动分配数() - 前;
}

函数 主() -> 整32 {
    整32 和 = 0;
    如果 (比较语句位() == 0) { 和 += 1; }
    如果 (序比较位() == 0) { 和 += 2; }
    如果 (不等比较位() == 0) { 和 += 4; }
    如果 (防误伤对照() == 0) { 和 += 8; }
    如果 (嵌套组合位() == 0) { 和 += 16; }
    打印行(和);
    返回 和;
}
