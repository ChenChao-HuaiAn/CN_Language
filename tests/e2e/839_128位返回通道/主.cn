// 839：128 位返回通道两缺陷（#551·442 呈报）·dual（宿主+v2 双侧运行值一致）
// 缺陷①：聚合返回（整128·16 字节）lambda 蹦床 ABI 缺 sret 槽——490 面 sret
//   判定只有结构体/结果/数组三分支，128 位标量返回不中任何分支→蹦床本体无
//   sret 槽（rcx 装首实参），而调用点（后端 418 判据融合 操作数2=T_整128→
//   retbuf 形态）按签名传 rdi=retbuf/rsi=实参→ABI 错位一档=值错/读亡帧。
//   修法=蹦床 IR 返回类型/序言补 sret 槽（正报函数 810 同构：返回128位置位+
//   槽1 保留+转发 retbuf 形态+返回透传）。
//   面1/2 用高半非零大值：低位小值对「错位/读亡帧」形态可能侥幸绿（帧数据
//   未及覆盖）——高位值错位/亡帧几乎必暴露，锁定力更强。
// 缺陷②：正64 函数直接 返回 18446744073709551615（超 整64 域字面量·814 轮
//   按规范 218 提升链物化为 整128 句柄）→ 返回位=64 位消费点漏挂 隐式窄化
//   到64（声明初值/赋值/实参已挂）→句柄地址直入 IR_返回=垃圾值（经变量中转
//   =声明初值挂点正确）。修法=生成返回语句标量分支补挂点。
// 面1：lambda 返回 整128·同帧调用（蹦床 sret+转发 retbuf 全链）
// 面2：lambda 返回 整128·逃逸跨函数（造闭包返回蹦床）
// 面3：正64 直返超大 ULL 字面量（2^64-1·缺陷②直返通道）
// 面4：对照面——同字面量经 正64 变量中转（814 隐式窄化到64 声明初值挂点·
//   既有正确——442 呈报「经变量中转正确」原形态）
// 面5：收尾
// 期望（打印 逐行）：面1/面2=大值原样、面3/面4=2^64-1 无符号、面5=42

函数 造闭包128() -> 整128(*)() {
    变量 取 = [=]() -> 整128 {
        变量 q = 整128(98765432109876543210987654321);
        返回 q;
    };
    返回 取;
}

函数 直返大字面量() -> 正64 {
    返回 18446744073709551615;
}

函数 主() -> 整32 {
    // 面1：lambda 返回 整128·同帧调用（lambda 值=蹦床地址经 T69 间接调用）
    变量 g = [=]() -> 整128 {
        变量 q = 整128(123456789012345678901234567890);
        返回 q;
    };
    变量 r1 = g();
    打印(r1);
    // 面2：lambda 返回 整128·逃逸跨函数（蹦床 sret+转发 retbuf 全链）
    变量 逃 = 造闭包128();
    变量 r2 = 逃();
    打印(r2);
    // 面3：正64 直返 2^64-1（打印通道 __cn_print_uint 无符号·双侧一致）
    打印(直返大字面量());
    // 面4：对照面——同字面量经 正64 变量中转（814 隐式窄化到64 声明初值挂点）
    正64 中转 = 18446744073709551615;
    打印(中转);
    // 面5：收尾
    变量 s = 42;
    打印(s);
    返回 0;
}
