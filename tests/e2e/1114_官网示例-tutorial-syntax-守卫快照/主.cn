// 官网文档示例 · tutorial-syntax.html · 变量（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
不安全 函数 计次() -> 整32 {
    静态 整32 次 = 0;           // 常量初值：加载期直存
    次 = 次 + 1;                // 静态写=不安全执法面
    返回 次;
}

函数 标量快照(整32 轮) -> 整32 {
    整32 源 = 轮 * 10;
    静态 整32 甲 = 源;          // 非常量初值：首调经过声明点求值快照
    返回 甲;                    // 再调不重初始化
}

函数 主() -> 整32 {
    打印(计次(), " ", 计次(), " ", 计次());
    打印(标量快照(1), " ", 标量快照(2), " ", 标量快照(3));
    返回 0;
}