// 官网文档示例 · reference/control-flow.html · 选择（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
函数 分类(整32 n) -> 字符串 {
    字符串 结果文 = "";
    选择 (n) {
        情况 0:
            结果文 = "零";
        情况 1, 2, 3:            // 多值分组
            结果文 = "小";
            中断;
        默认:
            结果文 = "大";
    }
    返回 结果文;
}

函数 主() -> 整32 {
    打印(分类(0), " ", 分类(2), " ", 分类(9));
    返回 0;
}