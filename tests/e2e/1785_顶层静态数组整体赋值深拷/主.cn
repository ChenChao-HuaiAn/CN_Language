// E2E 1785：顶层静态数组整体赋值深拷（#2065 立法锁·2026-11-05 用户批准）
//   立法：顶层静态数组整体赋值从浅拷改深拷（顶层跟进 #1979 类静态槽深拷——
//   消除「同一整体赋值语法写在顶层是浅拷、写在类字段是深拷」语义不一致；
//   浅拷两侧共享句柄本体=一侧释放另一侧悬垂=安全隐患面）。
//   三断言：
//   ① 标量元素逐格一致（整块拷保真·修前修后同绿对照面——深拷纯标量零义务）
//   ② 字符串元素深拷铁证：整体赋值分配增量==元素数（修前浅拷增量=0 探针实证）
//     + 改源目标不变 + 改目标源不变（双侧独立本体·修前共享=悬垂隐患面）
//   ③ 释放安全：重复整体赋值/源覆盖/退出全链无悬垂崩溃（深拷后各槽独立本体
//     无共享面·静态槽重复覆盖不逐元素 drop=259 同边界）
//   退出码 = ①8 + ②16 + ③32 = 56（全对；校验和模式）
字符串[2] 全局甲;
字符串[2] 全局乙;
整32[3] 全局标甲;
整32[3] 全局标乙;

// ① 标量元素逐格一致（整块拷保真）
不安全 函数 断言一() -> 整64 {
    全局标甲[0] = 10;
    全局标甲[1] = 20;
    全局标甲[2] = 30;
    全局标乙 = 全局标甲;
    全局标甲[1] = 99;
    如果 (全局标乙[0] == 10 && 全局标乙[1] == 20 && 全局标乙[2] == 30) {
        返回 8;
    }
    返回 0;
}

// ② 字符串元素深拷铁证（分配账目+双侧独立）
不安全 函数 断言二() -> 整64 {
    整64 起 = 内存::活动分配数();
    全局甲[0] = 字符串复制("甲零");
    全局甲[1] = 字符串复制("甲壹");
    整64 有源 = 内存::活动分配数();
    全局乙 = 全局甲;
    整64 有目标 = 内存::活动分配数();
    // 深拷铁证：目标元素独立副本=分配增量==2（修前浅拷=0）
    如果 (有目标 - 有源 != 2) { 返回 0; }
    如果 (有源 - 起 != 2) { 返回 0; }
    // 双侧独立：改源目标不变
    全局甲[0] = 字符串复制("改甲");
    如果 (!字符串比较(全局乙[0], "甲零")) { 返回 0; }
    // 双侧独立：改目标源不变
    全局乙[1] = 字符串复制("改乙");
    如果 (!字符串比较(全局甲[1], "甲壹")) { 返回 0; }
    返回 16;
}

// ③ 释放安全（重复整体赋值/源覆盖/退出全链·独立本体无共享悬垂面）
不安全 函数 断言三() -> 整64 {
    // 此时 甲[0]="改甲"（断言二末态）——整体赋值=快照当前值（深拷独立副本）
    全局乙 = 全局甲;
    全局乙 = 全局甲;
    全局甲[0] = 字符串复制("再改");
    // 源覆盖后目标保持赋值时快照（独立本体=无共享悬垂面）
    如果 (!字符串比较(全局乙[0], "改甲")) { 返回 0; }
    如果 (!字符串比较(全局甲[0], "再改")) { 返回 0; }
    返回 32;
}

不安全 函数 主() -> 整32 {
    整64 校验 = 断言一() + 断言二() + 断言三();
    打印("校验=", 校验);
    打印("乙零=", 全局乙[0]);
    打印("甲壹=", 全局甲[1]);
    返回 整32(校验 % 256);
}
