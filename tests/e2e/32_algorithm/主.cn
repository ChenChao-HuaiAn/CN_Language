// 算法库 E2E（Task 6.7，对标 C++ <algorithm>）
// 覆盖：整32数组排序 {5,2,8,1,9,3} → 升序 / 线性查找（找到索引/找不到-1）/
//       二分查找（升序数组查目标）/ 逆序 {1,2,3} → {3,2,1} /
//       变换 ×2 / 计数出现次数 / 最大元素
// 模块导入：导入 算法::排序整32 等（具体类型重载 + 比较内联，规避泛型+函数指针缺陷）
// 实测边界（Task 6.7）：
//   - 泛型函数 + 函数指针回调组合编译器暂不支持（单态化后签名不匹配）——
//     排序/二分 用 整32/整64 具体类型重载；线性查找/计数/最大/逆序 泛型（无函数指针）正常
//   - 静态数组 整32[6] 名退化传参正常
// 打印语义（用户裁决）：打印=println（自动换行）

导入 算法::排序整32;
导入 算法::排序整64;
导入 算法::线性查找;
导入 算法::二分查找整32;
导入 算法::二分查找整64;
导入 算法::逆序;
导入 算法::变换整32;
导入 算法::变换整64;
导入 算法::计数;
导入 算法::最大元素;

函数 主() -> 整32 {
    打印("===== 算法库（Task 6.7）=====");

    // ==================== 1. 排序（整32 冒泡升序） ====================
    整32[6] 数组 = { 5, 2, 8, 1, 9, 3 };
    排序整32(数组, 6);
    打印("排序: ", 数组[0], 数组[1], 数组[2], 数组[3], 数组[4], 数组[5]);

    // ==================== 2. 线性查找（找到索引 / 找不到 -1） ====================
    整64 索引 = 线性查找<整32>(数组, 6, 8);
    打印("线性查找8: ", 索引);
    索引 = 线性查找<整32>(数组, 6, 5);
    打印("线性查找5: ", 索引);
    索引 = 线性查找<整32>(数组, 6, 99);
    打印("线性查找99: ", 索引);

    // ==================== 3. 二分查找（升序数组查目标） ====================
    索引 = 二分查找整32(数组, 6, 8);
    打印("二分查找8: ", 索引);
    索引 = 二分查找整32(数组, 6, 1);
    打印("二分查找1: ", 索引);
    索引 = 二分查找整32(数组, 6, 99);
    打印("二分查找99: ", 索引);

    // ==================== 4. 逆序（{1,2,3} → {3,2,1}） ====================
    整32[3] 三元素 = { 1, 2, 3 };
    逆序<整32>(三元素, 3);
    打印("逆序: ", 三元素[0], 三元素[1], 三元素[2]);

    // ==================== 5. 变换（每个元素 ×2） ====================
    整32[4] 变换数组 = { 1, 2, 3, 4 };
    变换整32(变换数组, 4);
    打印("变换: ", 变换数组[0], 变换数组[1], 变换数组[2], 变换数组[3]);

    // ==================== 6. 计数（统计目标出现次数） ====================
    整32[8] 计数组 = { 1, 2, 2, 3, 2, 4, 2, 5 };
    整64 次数 = 计数<整32>(计数组, 8, 2);
    打印("计数2: ", 次数);
    次数 = 计数<整32>(计数组, 8, 9);
    打印("计数9: ", 次数);

    // ==================== 7. 最大元素 ====================
    整32 最大 = 最大元素<整32>(数组, 6);
    打印("最大元素: ", 最大);

    // ==================== 8. 整64 版本（排序/二分/变换） ====================
    整64[5] 大数组 = { 50, 20, 80, 10, 90 };
    排序整64(大数组, 5);
    打印("排序整64: ", 大数组[0], 大数组[1], 大数组[2], 大数组[3], 大数组[4]);
    索引 = 二分查找整64(大数组, 5, 80);
    打印("二分查找整64 80: ", 索引);
    变换整64(大数组, 5);
    打印("变换整64: ", 大数组[0], 大数组[1], 大数组[2], 大数组[3], 大数组[4]);

    打印("===== 算法库测试完成 =====");
    返回 0;
}
