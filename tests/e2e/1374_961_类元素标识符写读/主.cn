// E2E 1374（2026-10-18 任务 961·914 探针边角·362 复验外溢）：类元素（内联体
//   存储）← 标识符/成员/三元写——局部数组 of 用户类：写后读=值正确（原宿主
//   「无拷贝构造类元素」误入类字段句柄槽通道=NewObject+句柄写进本体槽，读侧
//   按本体字段解=读出堆句柄静默错值；v2 双缺陷：①元素步进=类型名宽度(用户类)
//   =8（应=类布局大小·16 字节类第二元素写落首元素体内覆写）②有拷贝构造类元素
//   写走「NewObject+句柄三步」读侧按本体解=读出堆句柄）+ 元素深拷独立副本 +
//   多元素下标步进。
//   单函数形态（多函数版受 v2 既有 964 族缺陷「字段宽度码·字段未登记」阻塞·
//   修前即崩·已备案 964 面——单函数=当前可执行面）。
//   断言面（逐行输出·双编译对照）：
//     形一 8 字节类（无拷贝构造）标识符写读三连     → 42 / 7 / 42
//     形二 16 字节类双元素步进 + 副本独立           → 11 / 22 / 33 / 44 / 11 / 999
//     形三 有拷贝构造类标识符写读                   → 55 / 66 / 55
//     形四 成员源（字段槽源）+ 写后改源独立         → 77 / 77
//     形五 三元源 + 自赋值 no-op                    → 501 / 502 / 501
类 盒一 {
公开:
    整64 值;
    函数 盒一() {
        值 = 0;
    }
    函数 盒一(整64 v) {
        值 = v;
    }
}

类 盒双 {
公开:
    整64 甲;
    整64 乙;
    函数 盒双() {
        甲 = 0;
        乙 = 0;
    }
    函数 盒双(整64 a, 整64 b) {
        甲 = a;
        乙 = b;
    }
}

类 盒拷 {
公开:
    整64 值;
    函数 盒拷() {
        值 = 0;
    }
    函数 盒拷(整64 v) {
        值 = v;
    }
    不安全 函数 盒拷(盒拷& 其他) {
        值 = 其他.值;
    }
}

类 外盒 {
公开:
    盒一 内;
    函数 外盒() {
        内 = 盒一(0);
    }
}

函数 主() -> 整32 {
    // 形一：8 字节类标识符写读
    盒一[2] 组一;
    盒一 丙一 = 盒一(42);
    组一[0] = 丙一;
    打印(组一[0].值);
    盒一 丁一 = 盒一(7);
    组一[1] = 丁一;
    打印(组一[1].值);
    打印(组一[0].值);
    // 形二：16 字节类双元素步进 + 副本独立
    盒双[2] 组二;
    盒双 丙二 = 盒双(11, 22);
    组二[0] = 丙二;
    盒双 丁二 = 盒双(33, 44);
    组二[1] = 丁二;
    打印(组二[0].甲);
    打印(组二[0].乙);
    打印(组二[1].甲);
    打印(组二[1].乙);
    丙二.甲 = 999;
    打印(组二[0].甲);
    打印(丙二.甲);
    // 形三：有拷贝构造类标识符写读
    盒拷[2] 组三;
    盒拷 丙三 = 盒拷(55);
    组三[0] = 丙三;
    打印(组三[0].值);
    盒拷 丁三 = 盒拷(66);
    组三[1] = 丁三;
    打印(组三[1].值);
    打印(组三[0].值);
    // 形四：成员源（字段槽源）+ 写后改源独立
    盒一[1] 组四;
    外盒 甲四 = 外盒();
    甲四.内 = 盒一(77);
    组四[0] = 甲四.内;
    打印(组四[0].值);
    甲四.内 = 盒一(88);
    打印(组四[0].值);
    // 形五：三元源 + 自赋值 no-op
    盒一[2] 组五;
    盒一 丙五 = 盒一(501);
    盒一 丁五 = 盒一(502);
    布尔 条五 = 真;
    组五[0] = 条五 ? 丙五 : 丁五;
    打印(组五[0].值);
    条五 = 假;
    组五[1] = 条五 ? 丙五 : 丁五;
    打印(组五[1].值);
    组五[0] = 组五[0];
    打印(组五[0].值);
    返回 0;
}
