// E2E 550（dual 负测，2026-09-29 第八十六轮·008 树波 4 任务 094 实施轮）：
//   装箱 move（正常/某些 持字符串标识符实参）后旧名使用拒绝——
//   宿主 IR 层 emitResultCtorValue 70-a 真 move 清源槽＋语义层 markMovedVar
//   （任务 094：根除「装箱后旧名编译不禁用、运行静默读空串」p5 实锤）；
//   v2 已装箱名模型（所有权转交装箱值·出口释放跳过）同语义禁用（检查构造器
//   调用 补 表标记转移）。Rust 对照：Ok(s)/Some(s) 对 String 即 move（E0382）。
//   四负形态：①正常(s) 装箱后读值 ②某些(s) 装箱后读值 ③装箱后传参
//   ④装箱后再转移（再转移=使用已转移变量）。
//   期望编译失败（双侧）：诊断锚=「已转移，不能继续使用」。
函数 消费串(字符串 词) -> 整32 {
    返回 0;
}

函数 主() -> 整32 {
    // ① 正常(s) 装箱后读值（宿主运行实锤=静默空行·修复后编译期拒绝）
    字符串 s = 字符串复制("数据");
    结果<字符串, 整32> r = 正常(s);
    打印(s);

    // ② 某些(s) 装箱后读值
    字符串 o = 字符串复制("可选值");
    可选<字符串> 持 = 某些(o);
    打印(o);

    // ③ 装箱后传参（使用=传参形态）
    字符串 p = 字符串复制("传参值");
    结果<字符串, 整32> r3 = 正常(p);
    消费串(p);

    // ④ 装箱后再转移（再转移=使用已转移变量·与 197 ④ 同族）
    字符串 q = 字符串复制("再转移");
    结果<字符串, 整32> r4 = 正常(q);
    字符串 接 = 转移(q);

    返回 0;
}
