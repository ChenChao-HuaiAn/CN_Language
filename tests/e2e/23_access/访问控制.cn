// Task 3.4 访问控制 E2E 测试
// 覆盖：公开:/保护:/私有: 标签式可见性（块级标签，标签后成员继承可见性）/
//       类外访问公开成员合法/子类访问保护成员合法/私有成员仅类内可访问
// 语法依据（cn-language-spec 06-二）：公开:=所有代码可访问、保护:=自身与子类可访问、
//   私有:=仅自身可访问（友元例外）；标签为块级，直到下一个标签前所有成员继承该可见性
// 说明：E2E 只验证"合法访问路径"（非法访问由语义层报错，单测覆盖）；
//   本用例验证三种标签的正向行为
// 打印语义（用户裁决）：打印=println（自动换行）

类 账户 {
公开:
    字符串 用户名;          // 公开字段：类外可访问

    函数 账户(字符串 名, 整32 初始余额) {
        用户名 = 名;
        余额 = 初始余额;      // 类内访问私有字段（合法）
        密码哈希 = 初始余额 * 7;   // 类内访问私有字段（合法）
    }

    函数 存款(整32 金额) -> 整32 {
        余额 = 余额 + 金额;
        返回 余额;
    }

    函数 显示余额() -> 整32 {
        返回 余额;            // 类内访问保护字段（合法）
    }

保护:
    整32 余额;              // 保护字段：自身与子类可访问

私有:
    整32 密码哈希;          // 私有字段：仅自身可访问
}

// 子类：可访问父类保护成员（余额），不可访问父类私有成员（密码哈希）
类 子账户 : 账户 {
公开:
    函数 子账户(字符串 名, 整32 初始余额) {
        父类.用户名 = 名;
        父类.余额 = 初始余额;   // 子类访问父类保护字段（合法）
    }

    函数 查询余额() -> 整32 {
        返回 余额;            // 子类直接访问继承的保护字段（合法）
    }

    函数 透支检查(整32 限额) -> 布尔 {
        返回 余额 < 限额;      // 子类访问保护字段参与判断（合法）
    }
}

函数 主() -> 整32 {
    打印("===== 访问控制（Task 3.4）=====");

    // ---- 1. 公开字段：类外直接访问/修改 ----
    账户 账户甲 = 账户("张三", 100);
    打印("公开用户名: ", 账户甲.用户名);          // 张三
    账户甲.用户名 = "张三改";
    打印("修改后用户名: ", 账户甲.用户名);        // 张三改

    // ---- 2. 公开方法：类外调用（方法内访问保护/私有成员）----
    打印("存款后余额: ", 账户甲.存款(50));        // 150
    打印("显示余额: ", 账户甲.显示余额());        // 150

    // ---- 3. 保护成员：子类可访问（自身类方法内）----
    子账户 账户乙 = 子账户("李四", 200);
    打印("子类查询余额: ", 账户乙.查询余额());    // 200
    // 布尔输出：字符串拼接 + 布尔 经 __cn_str_from_bool 转 真/假
    //   （打印 多参数直接传布尔走 __cn_format 转 1/0，与 15 用例布尔拼接方式一致）
    布尔 检查结果 = 账户乙.透支检查(300);
    打印("子类透支检查: " + 检查结果);             // 子类透支检查: 真（200 < 300）

    // ---- 4. 保护成员：类内方法修改 ----
    账户甲.存款(25);
    打印("再存款后: ", 账户甲.显示余额());        // 175

    // ---- 5. 私有成员：通过公开方法间接访问（类内合法）----
    //  密码哈希 仅在构造/类内方法中访问；类外无法直接访问（语义层报错，单测覆盖）
    打印("账户甲余额验证: ", 账户甲.显示余额());  // 175

    // 说明：非法访问（类外访问 私有/保护 字段）由语义层 checkAccess 报错，
    //   单测 test_semantic_oop.cpp 覆盖；E2E 只验证合法访问路径（正向行为）。

    打印("===== 访问控制测试完成 =====");
    返回 0;
}
