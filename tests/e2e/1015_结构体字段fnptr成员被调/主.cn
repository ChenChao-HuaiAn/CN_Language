// 1015：结构体字段位函数指针（001 §5.8 甲案声明位全集④）成员被调全链
//   ——#491（742d 面外·宿主已绿的成员被调形态 v2 侧对齐）。修前 v2：
//   ①结构体构造字段初值=函数名 负占位直入 IR_指针存储（992 守卫「非法
//   寄存器槽号 -36」中止）；②T69 发射间接调用480 成员被调签名解析 miss
//   → 结构体返回无 retbuf 预插；③生成方法接收者 040 分支只认局部/参数
//   标识符——静态对象运行时跳伪地址 C0000005、调用返回对象编译期
//   「方法调用对象类型未解析」。
// 面1 局部对象·结构体返回（T69 retbuf 预插+推断声明返回类型推导）
// 面2 局部对象·标量返回
// 面3 字段值先取局部再调用（等价改写）
// 面4 调用返回对象被调（造包裹().fn(...)）
// 面5 静态对象被调（IR_静态地址基址）
// 期望：34 / 4 / 34 / 34 / 34 / 42（打印 逐行）
结构体 点 { 整32 x; 整32 y; }
结构体 包裹 { 点(*fn)(整32, 整32); }
结构体 标量包裹 { 整32(*g)(整32); }

函数 造点(整32 a, 整32 b) -> 点 {
    变量 p = 点{ x = a, y = b };
    返回 p;
}

函数 加一(整32 x) -> 整32 { 返回 x + 1; }

函数 造包裹() -> 包裹 {
    变量 w = 包裹{ fn = 造点 };
    返回 w;
}

静态 包裹 静包裹 = 包裹{ fn = 造点 };

函数 主() -> 整32 {
    变量 w = 包裹{ fn = 造点 };
    变量 r1 = w.fn(3, 4);
    打印(r1.x * 10 + r1.y);
    变量 sw = 标量包裹{ g = 加一 };
    打印(sw.g(3));
    变量 g = w.fn;
    变量 r3 = g(3, 4);
    打印(r3.x * 10 + r3.y);
    变量 r4 = 造包裹().fn(3, 4);
    打印(r4.x * 10 + r4.y);
    变量 r5 = 静包裹.fn(3, 4);
    打印(r5.x * 10 + r5.y);
    变量 s = 42;
    打印(s);
    返回 0;
}
