// E2E 105_接口参数多态（006 P3-19 C2）：接口类型作为函数参数/返回 —— 多实现类经参数多态
// 覆盖：指针参数（多实现命中）、值参数（多实现）、链式传递、成员方法形参、接口值返回（值→值）、
//       继承实现类（子类继承父类的接口实现）经接口参数多态。
接口 形状 { 虚拟 函数 面积() -> 整32 }
类 圆 : 形状 {
公开:
    整32 半径
    函数 圆(整32 r) { 半径 = r }
    重写 函数 面积() -> 整32 { 返回 半径 * 半径 * 3 }
}
类 矩形 : 形状 {
公开:
    整32 宽
    整32 高
    函数 矩形(整32 w, 整32 h) { 宽 = w; 高 = h }
    重写 函数 面积() -> 整32 { 返回 宽 * 高 }
}
类 图形基类 : 形状 {
公开:
    整32 底值
    函数 图形基类(整32 v) { 底值 = v }
    重写 函数 面积() -> 整32 { 返回 底值 }
}
类 方形 : 图形基类 {
公开:
    函数 方形() : 图形基类(9) { }
}

函数 用指针(形状* 图形) -> 整32 { 返回 图形.面积() }
函数 用值(形状 图形) -> 整32 { 返回 图形.面积() }
函数 链式(形状* 图形) -> 整32 {
    形状* 中转 = 图形
    返回 中转.面积()
}
函数 传回值(形状 图形) -> 形状 { 返回 图形 }
类 画布 {
公开:
    函数 画(形状* 图形) -> 整32 { 返回 图形.面积() }
}

函数 主() -> 整32 {
    打印("===== 接口参数多态（C2）=====")
    圆 对象 = 圆(5)
    矩形 对象2 = 矩形(4, 6)
    打印("指针参数-圆: ", 用指针(对象))        // 75
    打印("指针参数-矩形: ", 用指针(对象2))     // 24
    打印("值参数-圆: ", 用值(圆(5)))           // 75
    打印("值参数-矩形: ", 用值(矩形(3, 9)))    // 27
    打印("链式: ", 链式(对象))                 // 75
    形状 回传 = 传回值(圆(5))
    打印("值返回: ", 回传.面积())              // 75
    方形 方 = 方形()
    打印("继承实现: ", 用指针(方))             // 9
    画布 屏 = 画布()
    打印("成员参数: ", 屏.画(对象))            // 75
    打印("===== 完成 =====")
    返回 0
}
