// 1331（#1910·001 §10.6 编译期配对执法·dual 负例·预期失败）：格式化占位符
//   配对违例双侧同拒——七形态：
//   ① 整128 配 %d（截断错值通道·修前实测输出低 32 位 rc=0 静默）
//   ② 正128 配 %u（同族截断通道）
//   ③ 整64 配 %d（64 位专用占位符待立法·过渡期诚实拒绝+指路）
//   ④ 实参无占位符消费（{} 花括号形态主诉·#1910 标题本体）
//   ⑤ 占位符无实参可供（个数不等面）
//   ⑥ 未知占位符 %q
//   ⑦ 格式串非字面量（占位符须编译期静态配对核验）
//   执法=001 §10.6：占位符个数==实参个数+逐位类型匹配，违例一律编译期拒绝
//   （禁静默丢参/截断/运行期崩溃）。
函数 主() -> 整32 {
    整128 大数 = 12345678901234567890123456789;
    正128 满格 = 170141183460469231731687303715884105727;
    整64 宽数 = 4294967297;
    字符串 模板 = "值=%d";

    格式化("甲=%d", 大数);        // 预期失败：整128 请用 %d128
    格式化("乙=%u", 满格);        // 预期失败：正128 请用 %u128
    格式化("丙=%d", 宽数);        // 预期失败：整64 请用 %d64（32 位通道截断）
    格式化("丁={}尾", 大数);      // 预期失败：实参 1 无占位符消费
    格式化("戊=%d %d", 7);        // 预期失败：占位符 2 无实参可供
    格式化("己=%q", 7);           // 预期失败：未知占位符
    格式化(模板, 7);              // 预期失败：格式串须为字符串字面量
    格式化();                     // 预期失败：格式化须提供格式串实参
    返回 0;
}
