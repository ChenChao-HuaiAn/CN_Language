// 1393 回归锁：枚举类型宽度全链（IR布局尾 类型名宽度 补枚举 4 分支）
// 四族病灶（1022 采样轮 m08/m16/m12/m23 实录）：
//   ①枚举数组元素步进=0（读 0 0 0/逐个赋值全 1）②类型大小(枚举) 未知类型中止
//   ③类方法返回枚举（第二层病灶独立立案 #1456·已由 1667 八形态锁面补锁）
//   ④枚举数组形参 ABI 垃圾值
// 根因=类型名宽度 无枚举分支→查结构体大小=0（与 类型大小与对齐 279 枚举 4/4
//   两表分叉）；宿主侧历来正确（enum=int 同款）——本用例双编译对照。
// 语法依据（cn-language-spec 05/07 先例）：枚举成员 颜色.红；数组 类型[N] 名 =
//   {…}；数组形参 (颜色[3] 表)（210 先例）；类方法 返回类型（1002 先例）

枚举 颜色 {
    红,
    绿,
    蓝
}

// 族④+枚举返回值：枚举数组形参（ABI 传 4 字节槽）
函数 取首个(颜色[3] 表) -> 颜色 {
    返回 表[0];
}

不安全 函数 主() -> 整32 {
    // 族①：枚举数组文本初始化 + 下标读（步进须=4；v2 缺陷形态读 0 0 0）
    颜色[3] 表 = { 颜色.红, 颜色.绿, 颜色.蓝 };
    整32 分 = 0;
    如果 (表[0] == 颜色.红) { 分 = 分 + 1; }
    如果 (表[1] == 颜色.绿) { 分 = 分 + 2; }
    如果 (表[2] == 颜色.蓝) { 分 = 分 + 4; }
    打印("表:");
    打印(分);                       // 7（宽度错=步进 0→读串值→分变小）

    // 族①逐个赋值形态（m09：v2 缺陷形态赋值全变 1）
    颜色[2] 表二;
    表二[0] = 颜色.红;
    表二[1] = 颜色.蓝;
    分 = 0;
    如果 (表二[0] == 颜色.红) { 分 = 分 + 1; }
    如果 (表二[1] == 颜色.蓝) { 分 = 分 + 2; }
    打印("表二:");
    打印(分);                       // 3

    // 族②：类型大小(枚举)=4（编译期折叠）
    打印("大小:");
    打印(类型大小(颜色));           // 4

    // 族④：枚举数组形参传递（ABI 4 字节槽）
    分 = 0;
    如果 (取首个(表) == 颜色.红) { 分 = 1; }
    打印("形参首个:");
    打印(分);                       // 1

    返回 0;
}
