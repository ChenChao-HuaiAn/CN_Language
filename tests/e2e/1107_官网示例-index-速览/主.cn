导入 容器::向量;

// 求平方和：函数、循环、容器一次看完
函数 平方和(整64 上限) -> 整64 {
    向量<整64> 表 = 向量<整64>();
    循环 (整64 i = 1; i <= 上限; i++) {
        结果<空类型, 整32> 加 = 表.追加(i * i);   // 返回值必须接收
    }
    整64 总 = 0;
    遍历 表 中 每个 x { 总 = 总 + x; }
    返回 总;
}

函数 主() -> 整32 {
    打印("1~10 平方和 = ", 平方和(10));
    返回 0;
}