// 官网文档示例 · stdlib/string.html · 分割（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
导入 字符串扩展::{字符串转整数, 替换, 分割};

函数 主() -> 整32 {
字符串[8] 段;
结果<整64, 整32> 数量 = 分割("甲,乙,丙", ",", 段, 8);
如果 (数量.正常) {
    整64 i = 0;
    当 (i < 数量.值) {
        打印行(段[i], "|");
        字符串释放(段[i]);      // 逐元素释放
        i++;
    }
    打印("");
}
    返回 0;
}
