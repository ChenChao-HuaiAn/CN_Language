// E2E 576（937 轮·任务 096 转正）：聚合（结构体/数组）转移零拷贝——声明位
//   `盒 b = 转移(a)` 与表达式位 `f(转移(c))` 整块搬迁（CopyStruct 位拷·拥有
//   字段句柄直移=所有权交接）+源槽全清零（源 RAII 空安全跳过）。
//   〔基准=019〕第二句：转移()=显式放弃拷贝换零拷贝——编译器以旧名禁用
//   （moved-from）回报安全保证。
//   修复前：声明位仍走字段级深拷（ir_stmt_decl.cpp 结构体分支先于转移分支
//   命中·总分配 +1）；表达式位仅清首槽（多槽残留）。
//   判据：两形态 总分配次数 差=0（零拷贝）+值链+块收尾无泄漏；数组转移
//   =退化指针传递不清零（清首槽=破坏栈聚合·459-a 既有缺陷连带根治）。
//   【host-only 登记（937 实测）】v2 侧表达式位转移=诚实拒绝「拥有资源类型
//   的转移仅支持声明初始化位」（574 同款·随 008 v2 扩面轮）；v2 声明位转移
//   语义放行·其多槽清零同构随轮 G 统一验证。
结构体 盒 { 字符串 名; 整64 值; }
函数 取(盒 b) -> 整64 { 返回 b.值; }
不安全 函数 主() -> 整32 {
    整64 基线 = 内存::活动分配数();
    {
        盒 a;
        a.名 = "甲乙丙丁戊己庚辛";
        a.值 = 42;
        整64 前 = 内存::总分配次数();
        盒 b = 转移(a);
        整64 后 = 内存::总分配次数();
        打印(后 - 前);
        打印(b.值);
        布尔 等 = 字符串比较(b.名, "甲乙丙丁戊己庚辛");
        如果 (等) { 打印("声明位值链正确"); }
    }
    {
        盒 c;
        c.名 = "子丑寅卯辰巳午未";
        c.值 = 7;
        整64 前2 = 内存::总分配次数();
        整64 r = 取(转移(c));
        整64 后2 = 内存::总分配次数();
        打印(后2 - 前2);
        打印(r);
    }
    // 数组位：退化指针传递·内容不被清零破坏
    整32[3] 组 = { 10, 20, 30 };
    打印(组[0] + 组[1]);
    整64 收尾 = 内存::活动分配数();
    如果 (收尾 == 基线) { 打印("无泄漏"); }
    返回 0;
}
