// 691 递归与静态面（§静态局部·#324 函数内静态须有初值；§740 安全域第8类可变静态写）
// 期望手算：斐波那契(10)=55；静态计数 3 次调用=1/2/3；顶层静态 复合 10+5*2 链=30；
//   递归深度计数=11（fib 树最深链 10→9→…→0 共 11 层）
静态 整32 总账 = 10;

不安全 函数 斐波那契(整32 n) -> 整32 {
    如果 (n < 2) { 返回 n; }
    返回 斐波那契(n - 1) + 斐波那契(n - 2);
}

不安全 函数 下一号() -> 整32 {
    静态 整32 计数 = 0;
    计数 = 计数 + 1;
    返回 计数;
}

不安全 函数 深度(整32 n) -> 整32 {
    静态 整32 最深 = 0;
    如果 (n > 最深) { 最深 = n; }
    如果 (n > 0) { 深度(n - 1); }
    返回 最深;
}

不安全 函数 主() -> 整32 {
    打印(斐波那契(10));      // 55
    打印(下一号());          // 1
    打印(下一号());          // 2
    打印(下一号());          // 3
    总账 += 5;
    总账 *= 2;
    打印(总账);              // 30
    打印(深度(10));          // 10（最深=10）
    返回 0;
}
