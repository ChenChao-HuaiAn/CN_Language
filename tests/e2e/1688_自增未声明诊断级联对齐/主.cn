// E2E 1688_自增未声明诊断级联对齐（任务 1926·dual 负测）
// 锁面：①未声明后缀/前缀自增、自减、循环 step 位——两侧各恰 1 条（宿主原
//   叠「自增/自减要求数值或指针操作数，实际为 '未知'」级联，v2 单条=基线）；
//   ②非数值目标（字符串/结构体）双侧同文案拒绝；③常量自增单条；④非左值
//   自增在语义层拒绝（宿主文案逐字）；⑤复合赋值未声明目标单条（v2 原级联
//   「未声明标识符」双报）。
结构体 点 {
    整32 x;
}
函数 主() -> 整32 {
    未声明甲++;
    ++未声明乙;
    未声明丙--;
    循环 (整32 i = 0; i < 3; k++) { }
    字符串 串 = "abc";
    串++;
    点 对象;
    对象++;
    常量 常 = 1;
    常++;
    整32 甲 = 1;
    整32 乙 = 2;
    (甲 + 乙)++;
    未声明丁 += 1;
    返回 0;
}
