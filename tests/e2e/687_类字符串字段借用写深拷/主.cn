// 687（396/398 根治锁用例）：类字符串字段=借用来源 深拷归一化
//   缺陷形态：handleClassMemberAssign 对「类.字符串字段 = 借用来源（按值形参/
//   成员链/下标）」直拷句柄 + 类析构级联无条件 __cn_str_free(字段) → 函数返回
//   时 free 调用方缓冲 → UAF（b4 基准 gdb 实证：~JSON解析器 free 调用方 33KB
//   文档串，第 2 轮重置复用解析错误码=1；669 字面量实参被 cn_free_tracked 池外
//   忽略=假健康侥幸绿）。修复=写入位 85-a 来源分级复用：借用→__cn_str_copy
//   物化独立副本；拥有来源（调用返回/字面量/转移）保持零拷贝接管。
//   本用例锁三面：①借用形参写→调用方串存活 ②成员链借用写 ③拥有来源写值正确。
导入 测试框架::{测试器, 运行用例, 断言真, 断言相等整数, 断言相等文本, 测试汇总};

类 解析器 {
公开:
    字符串 源;
    整64 源长;
    不安全 函数 ~解析器() {
    }
}

// ① 借用形参→字段写：函数出口 器 析构级联 free 器.源——修复前=free(文本)
不安全 函数 消费形参(字符串 文本) -> 整64 {
    解析器 器 = 解析器();
    器.源 = 文本;
    器.源长 = 字符串长度(文本);
    返回 器.源长;
}

// ② 转移() 拥有移交→字段写：直写接管（豁免侧回归·不冗余拷贝）
不安全 函数 消费转移(字符串 文本) -> 整64 {
    解析器 器 = 解析器();
    器.源 = 转移(文本);
    返回 字符串长度(器.源);
}

// ③ 拥有来源（调用返回串）→字段写：直写接管，值正确即可
不安全 函数 消费拥有() -> 整64 {
    解析器 器 = 解析器();
    器.源 = 字符串连接("拥有串", "五字");
    返回 字符串长度(器.源);
}

不安全 函数 用例借用形参写(测试器* 器2) {
    字符串 文档 = 字符串连接("第一轮文档", "甲乙丙丁");
    整64 期望长 = 字符串长度(文档);
    循环 (整64 r = 1; r <= 3; r++) {
        整64 n = 消费形参(文档);
        断言相等整数(器2, 字符串长度(文档), 期望长, "形参写后调用方串存活");
        断言相等整数(器2, n, 期望长, "形参写字段长正确");
    }
    断言相等文本(器2, 文档, "第一轮文档甲乙丙丁", "三轮后文档逐字节完好");
}

不安全 函数 用例转移写(测试器* 器2) {
    字符串 拥有串 = 字符串连接("移交串", "五字");
    整64 n2 = 消费转移(拥有串);
    断言相等整数(器2, n2, 15, "转移写字段长正确");
}

不安全 函数 用例拥有来源写(测试器* 器2) {
    整64 n3 = 消费拥有();
    断言相等整数(器2, n3, 15, "拥有来源写值正确");
}

不安全 函数 主() -> 整32 {
    测试器 器2 = 测试器();
    运行用例(器2, "借用形参写", 用例借用形参写);
    运行用例(器2, "转移写", 用例转移写);
    运行用例(器2, "拥有来源写", 用例拥有来源写);
    整64 失败数 = 测试汇总(器2);
    打印("汇总返回失败用例数=", 失败数);
    返回 0;
}
