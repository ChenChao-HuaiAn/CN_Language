// 1459：1302 入口零初始化形态/回归 sanity——条件块内 可选<字符串> 局部，
//   **声明块以 返回 终止**，外层继续路径（取<=0）不执行声明；该路径的返回骨架
//   析构不得释放栈上残留（入口零初始化 → 有值=0 跳过）。冷/热两次调用验证确定性。
//   诚实边界：1302 前 v2p 本用例实测亦绿（该形态下栈残留非确定性触发，
//   非「根因必红」锁；根因锁定见 1459 的 op名 串被释放证据与 79_v2 固定点）。
函数 取首(整64 取, 字符串 文本) -> 可选<字符串> {
    如果 (取 > 0) {
        如果 (字符串长度(文本) > 0) { 返回 某些(字符串复制(文本)); }
        返回 无;
    }
    返回 无;
}
函数 试(整64 取, 字符串 文本) -> 整64 {
    整64 旁 = 42;
    如果 (旁 > 0) {
        如果 (取 > 0) {
            可选<字符串> 查 = 取首(取, 文本);
            如果 (查.有值) {
                字符串 影 = 字符串复制(查.值);
                打印(影);
            }
            返回 旁;
        }
        返回 旁;
    }
    返回 1;
}
函数 主() -> 整32 {
    整64 甲 = 试(1, "abc");
    整64 乙 = 试(0, "abc");
    整64 丙 = 试(1, "abcd");
    打印("甲=" + 整数转字符串(甲));
    打印("乙=" + 整数转字符串(乙));
    打印("丙=" + 整数转字符串(丙));
    如果 (甲 == 42 && 乙 == 42 && 丙 == 42) { 返回 0; }
    返回 1;
}
