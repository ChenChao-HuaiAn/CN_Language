// E2E 448（2026-09-18 第 357 轮·D39 根治门禁）：三段式循环 循环 (init; cond;
//   step) { 体 } 全链（规范 plans/001 §3「循环头分号=三段分隔符」）——①基本
//   累加与迭代序列 ②继续→step 语义（C for 同款：continue 先执行 step 再判
//   cond）③中断提前退出 ④init 作用域（循环头声明随循环）⑤空 cond（恒真+
//   中断退出）⑥赋值 step（i = i + 2）⑦嵌套（内外层继续/中断各自目标）⑧
//   当式宽容（循环 (cond) { }=当语句别名）。双编译对照：宿主/v2 同源同测。
函数 主() -> 整32 {
    // ① 基本
    整32 总 = 0;
    循环 (整32 i = 0; i < 5; i++) {
        总 = 总 + i;
    }
    打印(总);
    // ② 继续→step（跳过 3：i++ 仍执行防死循环）
    整32 计 = 0;
    循环 (整32 k = 0; k < 8; k++) {
        如果 (k == 3) {
            继续;
        }
        计 = 计 + k;
    }
    打印(计);
    // ③ 中断
    循环 (整32 m = 0; m < 100; m++) {
        如果 (m == 6) {
            中断;
        }
        打印(m);
    }
    // ④ init 作用域：循环后 i 不可见（用新变量验证循环值不泄漏）
    整32 i = 99;
    打印(i);
    // ⑤ 空 cond（恒真）+ 中断退出
    整32 w = 0;
    循环 (; ; ) {
        w = w + 3;
        如果 (w >= 9) {
            中断;
        }
    }
    打印(w);
    // ⑥ 赋值 step
    循环 (整32 d = 1; d < 10; d = d + 2) {
        打印(d);
    }
    // ⑦ 嵌套（内层中断·外层继续）
    整32 网总 = 0;
    循环 (整32 行 = 0; 行 < 3; 行++) {
        如果 (行 == 1) {
            继续;
        }
        循环 (整32 列 = 0; 列 < 4; 列++) {
            如果 (列 == 2) {
                中断;
            }
            网总 = 网总 + 行 * 10 + 列;
        }
    }
    打印(网总);
    // ⑧ 后缀自减 step（倒序）
    循环 (整32 倒 = 3; 倒 > 0; 倒--) {
        打印(倒);
    }
    返回 0;
}
