// 588-a 探针3：类指针（点*）成员访问支持面盘点——读/写/方法/取字段地址
类 点 {
公开:
    整32 x;
    整32 y;
    函数 点() { x = 0; y = 0; }
    函数 读x() -> 整32 { 返回 x; }
}
不安全 函数 主() -> 整32 {
    点 p1 = 点();
    p1.x = 42;
    p1.y = 7;
    点* p2 = &p1;
    打印行("读 p2.x = ", p2.x);
    打印行("方法 p2.读x = ", p2.读x());
    p2.x = 99;
    打印行("写后 p1.x = ", p1.x);
    返回 0;
}
