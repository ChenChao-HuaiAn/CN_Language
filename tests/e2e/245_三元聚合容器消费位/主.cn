// E2E 245（2026-09-12 第八十六轮 86-a，宿主单侧内存断言用例）：
//   **三元运算符 × 聚合类型的容器消费位**——86-a 三元聚合地址透传（选中 place
//   地址）+ 各消费位三元形态补全的宿主侧扩展面；容器插入位在 v2 侧需供给机制
//   （242/243 惯例=不依赖容器符号），故本用例为宿主单侧（与 235 同款口径）。
//     ① 向量 追加((三元))          ② 向量 插入(0, (三元))
//     ③ 链表 追加((三元))          ④ 栈 压入((三元)) + 弹出读出
//     ⑤ 队列 入队((三元)) + 出队读出
//     ⑥ 链表 头部追加((三元)) + 删除头部（移除路径 × 三元入容器）
//     ⑦ 容器读出（借出视图）→ 三元选择 → 再入容器（豁免 × 三元复合链）
//     ⑧ 循环 5 万轮（三元入容器 + 搅动）块出口 drop
//   校验和折位：①1 ②2 ③4 ④8 ⑤16 ⑥32 ⑦64 ⑧128 —— 255=全对；宿主侧退出码恒 0，
//   校验和经打印行承载（与 220/235 同款口径）。
导入 容器::向量;
导入 容器::链表;
导入 容器::栈;
导入 容器::队列;

结构体 盒子 {
    字符串 名;
    整32 号;
}

函数 搅动() -> 整64 {
    整64 和 = 0;
    整64 i = 0;
    当 (i < 16) {
        字符串 垃圾 = 字符串复制("E245搅动内存填充占位字符串内容甲乙丙丁戊己庚辛壬癸");
        和 = 和 + 字符串长度(垃圾);
        i++;
    }
    返回 和;
}

// ① 向量 追加((三元))
函数 形一() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        向量<盒子> 表 = 向量<盒子>();
        {
            盒子 甲 = 盒子{ 名 = 字符串复制("E245形一真串甲甲甲甲甲甲甲甲甲甲"), 号 = 1 };
            盒子 乙 = 盒子{ 名 = 字符串复制("E245形一假串乙乙乙乙乙乙乙乙乙乙"), 号 = 2 };
            结果<空类型, 整32> 加 = 表.追加(真 ? 甲 : 乙);
            如果 (!加.正常) { 返回 0; }
        }
        搅动();
        如果 (字符串比较(表.元素(0).名, "E245形一真串甲甲甲甲甲甲甲甲甲甲")) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 1) { 返回 1; }
    返回 0;
}

// ② 向量 插入(0, (三元))
函数 形二() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        向量<盒子> 表 = 向量<盒子>();
        {
            盒子 甲 = 盒子{ 名 = 字符串复制("E245形二真串甲甲甲甲甲甲甲甲甲甲"), 号 = 3 };
            盒子 乙 = 盒子{ 名 = 字符串复制("E245形二假串乙乙乙乙乙乙乙乙乙乙"), 号 = 4 };
            结果<空类型, 整32> 插 = 表.插入(0, 假 ? 甲 : 乙);
            如果 (!插.正常) { 返回 0; }
        }
        搅动();
        如果 (字符串比较(表.元素(0).名, "E245形二假串乙乙乙乙乙乙乙乙乙乙")) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 1) { 返回 2; }
    返回 0;
}

// ③ 链表 追加((三元))
函数 形三() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        链表<盒子> 表 = 链表<盒子>();
        {
            盒子 甲 = 盒子{ 名 = 字符串复制("E245形三真串甲甲甲甲甲甲甲甲甲甲"), 号 = 5 };
            盒子 乙 = 盒子{ 名 = 字符串复制("E245形三假串乙乙乙乙乙乙乙乙乙乙"), 号 = 6 };
            结果<空类型, 整32> 加 = 表.追加(真 ? 甲 : 乙);
            如果 (!加.正常) { 返回 0; }
        }
        搅动();
        如果 (字符串比较(表.头部元素().名, "E245形三真串甲甲甲甲甲甲甲甲甲甲")) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 1) { 返回 4; }
    返回 0;
}

// ④ 栈 压入((三元)) + 弹出读出
函数 形四() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        栈<盒子> 表 = 栈<盒子>();
        {
            盒子 甲 = 盒子{ 名 = 字符串复制("E245形四真串甲甲甲甲甲甲甲甲甲甲"), 号 = 7 };
            盒子 乙 = 盒子{ 名 = 字符串复制("E245形四假串乙乙乙乙乙乙乙乙乙乙"), 号 = 8 };
            结果<空类型, 整32> 压 = 表.压入(真 ? 甲 : 乙);
            如果 (!压.正常) { 返回 0; }
        }
        搅动();
        结果<盒子, 整32> 弹 = 表.弹出();
        如果 (弹.正常) {
            如果 (字符串比较(弹.值.名, "E245形四真串甲甲甲甲甲甲甲甲甲甲")) { 校验 = 1; }
        } 否则 {
            校验 = 0;
        }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 1) { 返回 8; }
    返回 0;
}

// ⑤ 队列 入队((三元)) + 出队读出
函数 形五() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        队列<盒子> 表 = 队列<盒子>();
        {
            盒子 甲 = 盒子{ 名 = 字符串复制("E245形五真串甲甲甲甲甲甲甲甲甲甲"), 号 = 9 };
            盒子 乙 = 盒子{ 名 = 字符串复制("E245形五假串乙乙乙乙乙乙乙乙乙乙"), 号 = 10 };
            结果<空类型, 整32> 入 = 表.入队(假 ? 甲 : 乙);
            如果 (!入.正常) { 返回 0; }
        }
        搅动();
        结果<盒子, 整32> 出 = 表.出队();
        如果 (出.正常) {
            如果 (字符串比较(出.值.名, "E245形五假串乙乙乙乙乙乙乙乙乙乙")) { 校验 = 1; }
        } 否则 {
            校验 = 0;
        }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 1) { 返回 16; }
    返回 0;
}

// ⑥ 链表 头部追加((三元)) + 删除头部（移除路径 × 三元入容器）
函数 形六() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        链表<盒子> 表 = 链表<盒子>();
        {
            盒子 甲 = 盒子{ 名 = 字符串复制("E245形六真串甲甲甲甲甲甲甲甲甲甲"), 号 = 11 };
            盒子 乙 = 盒子{ 名 = 字符串复制("E245形六假串乙乙乙乙乙乙乙乙乙乙"), 号 = 12 };
            结果<空类型, 整32> 加 = 表.头部追加(真 ? 甲 : 乙);
            如果 (!加.正常) { 返回 0; }
            如果 (字符串比较(表.头部元素().名, "E245形六真串甲甲甲甲甲甲甲甲甲甲")) { 校验 = 1; }
            结果<空类型, 整32> 删 = 表.删除头部();
            如果 (!删.正常) { 校验 = 0; }
        }
        搅动();
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 1) { 返回 32; }
    返回 0;
}

// ⑦ 容器读出（借出视图）→ 三元选择 → 再入容器
函数 形七() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        向量<盒子> 表 = 向量<盒子>();
        {
            盒子 甲 = 盒子{ 名 = 字符串复制("E245形七真串甲甲甲甲甲甲甲甲甲甲"), 号 = 13 };
            盒子 乙 = 盒子{ 名 = 字符串复制("E245形七假串乙乙乙乙乙乙乙乙乙乙"), 号 = 14 };
            结果<空类型, 整32> 加 = 表.追加(甲);
            如果 (!加.正常) { 返回 0; }
            盒子 读 = 表.元素(0);   // 借出视图 → 深拷接收
            结果<空类型, 整32> 再加 = 表.追加(真 ? 读 : 乙);
            如果 (!再加.正常) { 返回 0; }
        }
        搅动();
        如果 (字符串比较(表.元素(1).名, "E245形七真串甲甲甲甲甲甲甲甲甲甲")) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 1) { 返回 64; }
    返回 0;
}

// ⑧ 循环 5 万轮（三元入容器 + 搅动）
函数 形八(整64 轮数) -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    整64 i = 0;
    当 (i < 轮数) {
        向量<盒子> 表 = 向量<盒子>();
        盒子 甲 = 盒子{ 名 = 字符串复制("E245形八真串甲乙丙丁戊己庚辛壬癸"), 号 = 88 };
        盒子 乙 = 盒子{ 名 = 字符串复制("E245形八假串甲乙丙丁戊己庚辛壬癸"), 号 = 99 };
        结果<空类型, 整32> 加 = 表.追加(真 ? 甲 : 乙);
        如果 (!加.正常) { 校验 = 0; 中断; }
        如果 (!字符串比较(表.元素(0).名, "E245形八真串甲乙丙丁戊己庚辛壬癸")) { 校验 = 0; 中断; }
        校验 = 1;
        i++;
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    如果 (校验 == 1) { 返回 128; }
    返回 0;
}

函数 主() -> 整32 {
    整64 和 = 0;
    和 = 和 + 形一();
    和 = 和 + 形二();
    和 = 和 + 形三();
    和 = 和 + 形四();
    和 = 和 + 形五();
    和 = 和 + 形六();
    和 = 和 + 形七();
    和 = 和 + 形八(50000);
    打印("校验和(期望255)=", 和);
    返回 0;
}
