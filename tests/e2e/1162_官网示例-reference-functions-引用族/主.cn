// 官网文档示例 · reference/functions.html · 传参（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
函数 传回(整32& x) -> 整32& {        // 返回引用：返回被引用左值的地址
    返回 x;
}

函数 主() -> 整32 {
    整32 x = 10;
    整32& r = x;                      // 引用变量：r 是 x 的别名
    r = 20;                           // 经引用写 = 直接改 x
    打印("经引用变量写回: ", x);       // 20
    整32 值 = 100;
    整32& 别名 = 传回(值);             // 接收函数返回的引用
    别名 = 200;
    打印("经返回引用写: ", 值);        // 200
    传回(值) = 300;                    // 返回引用可作赋值目标
    打印("返回引用作赋值目标: ", 值);   // 300
    返回 0;
}