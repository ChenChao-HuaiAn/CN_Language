// T22 根治锚定（288-a）：arm64 逻辑立即数 bitmask 编码器
// 覆盖 and/orr/eor × 非法(#0/#425/#5 散块)/合法(掩码/单bit/交替)/恒等(或0/异0) 常量
// 变量源=防 O3 常量折叠；O3 通道（编译选项.txt）
函数 输入() -> 整32
{
    返回 71;
}

函数 输入64() -> 整64
{
    返回 71;
}

函数 主() -> 整32
{
    整32 甲 = 输入();
    打印(甲 | 425);
    打印(甲 & 425);
    打印(甲 ^ 425);
    打印(甲 | 5);
    打印(甲 & 0);
    打印(甲 | 0);
    打印(甲 ^ 0);
    打印(甲 & 4080);
    打印(甲 ^ 4080);
    打印(甲 | 2139062143);
    整64 乙 = 输入64();
    打印(乙 | 425);
    打印(乙 & 425);
    打印(乙 ^ 65535);
    打印(乙 & 1103568699392);
    打印(乙 | 0);
    返回 0;
}
