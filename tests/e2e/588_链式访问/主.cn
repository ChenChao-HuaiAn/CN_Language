// E2E 588（1014·链式访问根治）：后缀链临时值成员访问双端闭环。
// 覆盖：①结果/可选临时值链——函数返回（条件/括号/赋值/return 位）+容器方法
//   返回（映射.获取(k).normal=1013 续三补丁触发形态）+可选 .有值 检查位；
//   ②自定义结构体临时链——单层（造壳().芯）/两层（造壳().芯.数·条件+赋值位，
//   宿主静默错值根治面）；③变量多级链对照（既有绿形态防回归）。
// 规则 3 边界：.值/.错误 裸链（每调用新临时值·检查不覆盖取值）不进本用例
//   ——宿主语义层拒绝（specs/07 §四）；v2 规则 2/3 语义检查=存量缺口（021 登记）。
// 退出码判据：全部断言通过返回 0；断言失败提前返回 101~112。
导入 映射集合::映射;

结构体 内芯 {
    整32 数;
}

结构体 外壳 {
    内芯 芯;
}

函数 取结果(整32 x) -> 结果<整32, 整32> {
    返回 正常(x);
}

函数 找数(整32 x) -> 可选<整32> {
    如果 (x > 0) {
        返回 某些(x);
    }
    返回 无;
}

函数 造壳() -> 外壳 {
    返回 外壳{ 芯 = 内芯{ 数 = 9 } };
}

函数 判好(整32 x) -> 布尔 {
    返回 取结果(x).正常;
}

函数 主() -> 整32 {
    // ① 函数返回结果临时值链（条件位）
    如果 (!取结果(42).正常) { 返回 101; }
    // ② 容器方法返回结果临时值链（1013 续三补丁触发形态）
    映射<整64, 整64> 字典 = 映射<整64, 整64>();
    结果<空类型, 整32> 设1 = 字典.设置(3, 300);
    如果 (!字典.获取(3).正常) { 返回 102; }
    如果 (字典.获取(99).正常) { 返回 103; }
    // ③ 括号分组形态
    如果 (!(取结果(7)).正常) { 返回 104; }
    // ④ 赋值右侧裸链
    布尔 好 = 取结果(42).正常;
    如果 (!好) { 返回 105; }
    // ⑤ return 表达式裸链
    如果 (!判好(5)) { 返回 106; }
    // ⑥ 可选临时值链（.有值 检查位）
    如果 (!找数(3).有值) { 返回 107; }
    如果 (找数(-1).有值) { 返回 108; }
    // ⑦ 结构体临时链：单层
    内芯 芯 = 造壳().芯;
    如果 (芯.数 != 9) { 返回 109; }
    // ⑧ 结构体临时链：两层（条件位+赋值位·宿主静默错值根治面）
    如果 (造壳().芯.数 != 9) { 返回 110; }
    整32 取数 = 造壳().芯.数;
    如果 (取数 != 9) { 返回 111; }
    // ⑨ 变量多级链对照（既有绿形态）
    外壳 壳 = 造壳();
    如果 (壳.芯.数 != 9) { 返回 112; }
    返回 0;
}
