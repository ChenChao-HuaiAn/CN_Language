// E2E 1406_v2（1160）：情况标签条件类型域承载命中——**v2 侧缺陷根治锁面**。
//   1137 审查在 v2p 实测的六缺陷中的命中面：
//   ①整128 条件 + 小标签（原 cmp 栈地址=恒缺省）②整128 20 位标签
//   ③正128 2^127-1 ④正128 u128max（ULL 后缀·承载族 2^128-1）
//   ⑤正64 u64max（超 i64 标签）⑥整64 负号超 i64 承载幅值（-2^63）
//   ⑦括号折叠相消 (U64MAX-U64MAX) ⑧窄域（整8）/字符码点域内标签
//   ⑨枚举条件（归并整32 域）+ 枚举整数值标签 ⑩128 变量表达式标签。
//   宿主 1137 集成后本用例同源码可转 dual（1398 即宿主单侧面）。
枚举 颜色 {
    红,
    绿,
    蓝
}
函数 主() -> 整32 {
    // ① 整128 小标签
    整128 甲 = 5;
    选择(甲) {
        情况 5: 打印("A1=命中"); 中断;
        默认: 打印("A1=缺省");
    }
    // ② 整128 20 位标签
    整128 乙 = 99999999999999999999;
    选择(乙) {
        情况 99999999999999999999: 打印("A2=命中"); 中断;
        默认: 打印("A2=缺省");
    }
    // ③ 正128 2^127-1
    正128 丙 = 170141183460469231731687303715884105727;
    选择(丙) {
        情况 170141183460469231731687303715884105727: 打印("A3=命中"); 中断;
        默认: 打印("A3=缺省");
    }
    // ④ 正128 u128max（ULL 后缀承载族）
    正128 丁 = 340282366920938463463374607431768211455ULL;
    选择(丁) {
        情况 340282366920938463463374607431768211455ULL: 打印("A4=命中"); 中断;
        默认: 打印("A4=缺省");
    }
    // ⑤ 正64 u64max（超 i64 标签·无符号比较通道）
    正64 戊 = 18446744073709551615;
    选择(戊) {
        情况 18446744073709551615: 打印("A5=命中"); 中断;
        默认: 打印("A5=缺省");
    }
    // ⑥ 整64 负号超 i64 承载幅值（-2^63=整64 最小界）
    整64 己 = -9223372036854775807 - 1;
    选择(己) {
        情况 -9223372036854775808: 打印("A6=命中"); 中断;
        默认: 打印("A6=缺省");
    }
    // ⑦ 括号折叠相消
    整64 庚 = 0;
    选择(庚) {
        情况 (18446744073709551615-18446744073709551615): 打印("A7=命中"); 中断;
        默认: 打印("A7=缺省");
    }
    // ⑧ 整8 窄域/字符码点域内标签
    整8 辛 = 100;
    选择(辛) {
        情况 100: 打印("A8=命中"); 中断;
        默认: 打印("A8=缺省");
    }
    字符 壬 = '中';
    选择(壬) {
        情况 20013: 打印("A9=命中"); 中断;
        默认: 打印("A9=缺省");
    }
    // ⑨ 正128 u128max 第二形态 + 2^127-1 回归（U1/U2）
    正128 癸 = 340282366920938463463374607431768211455ULL;
    选择(癸) {
        情况 340282366920938463463374607431768211455ULL: 打印("U1=命中"); 中断;
        默认: 打印("U1=缺省");
    }
    正128 子 = 170141183460469231731687303715884105727;
    选择(子) {
        情况 170141183460469231731687303715884105727: 打印("U2=命中"); 中断;
        默认: 打印("U2=缺省");
    }
    // ⑩ 窄域/字符域内边界
    整8 丑 = 127;
    选择(丑) {
        情况 127: 打印("N1=命中"); 中断;
        默认: 打印("N1=缺省");
    }
    字符 寅 = 'a';
    选择(寅) {
        情况 1114111: 打印("N2=缺省"); 中断;
        默认: 打印("N2=缺省");
    }
    // ⑪ 枚举条件（归并整32 域）裸成员 + 整数值标签
    颜色 卯 = 颜色.绿;
    选择(卯) {
        情况 绿: 打印("E1=命中"); 中断;
        默认: 打印("E1=缺省");
    }
    颜色 辰 = 颜色.蓝;
    选择(辰) {
        情况 2: 打印("E2=命中"); 中断;
        默认: 打印("E2=缺省");
    }
    // ⑫ 128 条件 + 128 变量表达式标签（双半比较非文本常量通道）
    整128 巳 = 99999999999999999999;
    整128 午 = 99999999999999999999;
    选择(巳) {
        情况 午: 打印("X1=命中"); 中断;
        默认: 打印("X1=缺省");
    }
    整128 未 = 1;
    选择(未) {
        情况 午: 打印("X2=缺省"); 中断;
        默认: 打印("X2=缺省");
    }
    返回 0;
}
