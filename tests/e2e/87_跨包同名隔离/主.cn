// 主入口（跨包同名隔离，规格书09-四 crate 边界/链接隔离）
// 验证：甲库 与 乙库 两个独立本地库 crate 各自定义同名公开函数 双倍，
//  跨 crate 独立命名空间互不冲突（链接符号加 包名$ 前缀隔离，规格书09-四 4.1）。
// 导入以 作为 重命名别名（花括号形式），避免同名纯名歧义，分别调用验证行为独立。
导入 甲库::{双倍 作为 甲库双倍};
导入 乙库::{双倍 作为 乙库双倍};

函数 主() -> 整32 {
    打印("===== 跨包同名隔离（规格书09-四）=====");

    // ---- 同名公开函数：同一输入得到各自 crate 的独立结果（互不冲突）----
    整32 输入 = 6;
    整32 甲结果 = 甲库双倍(输入);
    整32 乙结果 = 乙库双倍(输入);
    打印("甲库双倍(", 输入, ") = ", 甲结果);      // 12（甲库 2x）
    打印("乙库双倍(", 输入, ") = ", 乙结果);      // 18（乙库 3x）

    // ---- 交叉调用验证：结果与调用顺序无关（符号独立）----
    打印("乙库双倍(10) = ", 乙库双倍(10));        // 30
    打印("甲库双倍(10) = ", 甲库双倍(10));        // 20

    // ---- 断言：行为确实来自各自 crate（非串扰）----
    如果 (甲结果 == 12 && 乙结果 == 18) {
        打印("验证通过：两个 双倍 函数各自独立、互不冲突（crate 隔离成立）");
    } 否则 {
        打印("验证失败：同名函数发生串扰");
    }

    打印("===== 跨包同名隔离验证完成 =====");
    返回 0;
}
