// E2E 237 符号供给（v2 自举链，plans/020 移植纪律 9）：实例化
//   链表<整64>/链表<字符串>/队列<整64>/队列<字符串> 全方法面（宿主编译=布局权威，
//   容器对象大小 64 由 v2 `容器对象大小` 表同步）。
导入 容器::链表;
导入 容器::队列;

函数 供给链64() -> 整64 {
    链表<整64> 链 = 链表<整64>();
    结果<空类型, 整32> a1 = 链.追加(1);
    结果<空类型, 整32> a2 = 链.头部追加(2);
    结果<空类型, 整32> d1 = 链.删除头部();
    结果<空类型, 整32> d2 = 链.删除尾部();
    结果<整64, 整32> h = 链.读取头部();
    结果<整64, 整32> t = 链.读取尾部();
    链.清空();
    返回 0;
}

函数 供给队64() -> 整64 {
    队列<整64> 队 = 队列<整64>();
    结果<空类型, 整32> q1 = 队.入队(1);
    结果<整64, 整32> o1 = 队.出队();
    结果<整64, 整32> f = 队.队首();
    队.清空();
    返回 0;
}

函数 供给链串() -> 整64 {
    链表<字符串> 链 = 链表<字符串>();
    结果<空类型, 整32> a1 = 链.追加(字符串复制("供链串一"));
    结果<空类型, 整32> a2 = 链.头部追加(字符串复制("供链串二"));
    结果<空类型, 整32> d1 = 链.删除头部();
    结果<空类型, 整32> d2 = 链.删除尾部();
    结果<字符串, 整32> h = 链.读取头部();
    链.清空();
    返回 0;
}

函数 供给队串() -> 整64 {
    队列<字符串> 队 = 队列<字符串>();
    结果<空类型, 整32> q1 = 队.入队(字符串复制("供队串一"));
    结果<字符串, 整32> o1 = 队.出队();
    结果<字符串, 整32> f = 队.队首();
    队.清空();
    返回 0;
}

函数 主() -> 整32 {
    返回 整32(供给链64() + 供给队64() + 供给链串() + 供给队串());
}
