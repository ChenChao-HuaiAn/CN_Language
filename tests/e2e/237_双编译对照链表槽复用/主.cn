// E2E 237（2026-09-12 第八十三轮，plans/020 移植纪律 9 门禁化·第九个对照用例）：
//   **链表/队列 槽分配与回收（空闲链）**——同一份源码经宿主真实管线与 v2 自举链
//   各编译运行，两侧退出码须相等。
//   背景（83-a，探针 P22 实证）：原实现 `新索引 = 元素数量` 在「删除头部/尾部后
//   追加」时与在链槽冲突（旧尾被覆盖 + next 自环 = **元素丢失**）：队列 入队
//   11/22/33 + 出队 + 入队 44 → 33 丢失（出队序 22/44/44）；链表<字符串> 同款
//   （头部内容错 + 残留 1）。修复=**空闲链复用 + 高水位计数**（`空闲头`/`已用槽数`
//   两字段，容器对象大小 48→64；Rust/C++ list 节点复用同款）。
//   八形态（两侧共有语义面）：
//     ① 链表<整64>：追加 3 + 删除头部 + 追加（槽复用后元素序列完整）
//     ② 队列<整64>：入队 3 + 出队 + 入队（出队序完整）
//     ③ 链表<字符串>：槽复用 + 内容守恒 + 残留归零
//     ④ 队列<字符串>：同款
//     ⑤ 链表 删除尾部 + 复用（槽归还后重分配）
//     ⑥ 链表 头部追加 + 复用
//     ⑦ 循环 20 万轮（入队/出队搅动）残留归零
//     ⑧ 链表 清空 + 复用（清空后槽从 0 重分配）
//   校验和折位：①1 ②2 ③4 ④8 ⑤16 ⑥32 ⑦64 ⑧128 —— 255=全对。
//   两侧任一形态的槽分配机制分叉（槽冲突覆盖/链断/泄漏）→ 该校验位丢失 → 退出码
//   变化 → 对照失败。平台守卫=linux 双平台（宿主与 v2 同链；win-x64 v2 产物未隔离
//   =家机轮）。
导入 容器::链表;
导入 容器::队列;

// ① 链表<整64>：追加 3 + 删除头部 + 追加（槽复用后序列完整）
函数 形一() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        链表<整64> 链 = 链表<整64>();
        结果<空类型, 整32> a1 = 链.追加(11);
        结果<空类型, 整32> a2 = 链.追加(22);
        结果<空类型, 整32> a3 = 链.追加(33);
        结果<空类型, 整32> d1 = 链.删除头部();
        结果<空类型, 整32> a4 = 链.追加(44);
        整64 序 = 0;
        当 (链.大小() > 0) {
            结果<整64, 整32> h = 链.读取头部();
            如果 (h.正常) {
                序 = 序 * 100 + h.值;
            } 否则 {
                校验 = 99;
            }
            结果<空类型, 整32> dd = 链.删除头部();
        }
        如果 (序 == 223344) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验;
}

// ② 队列<整64>：入队 3 + 出队 + 入队（出队序完整）
函数 形二() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        队列<整64> 队 = 队列<整64>();
        结果<空类型, 整32> q1 = 队.入队(11);
        结果<空类型, 整32> q2 = 队.入队(22);
        结果<空类型, 整32> q3 = 队.入队(33);
        结果<整64, 整32> o1 = 队.出队();
        结果<空类型, 整32> q4 = 队.入队(44);
        整64 序 = 0;
        当 (队.大小() > 0) {
            结果<整64, 整32> o = 队.出队();
            如果 (o.正常) {
                序 = 序 * 100 + o.值;
            } 否则 {
                校验 = 99;
            }
        }
        如果 (序 == 223344) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 2;
}

// ③ 链表<字符串>：槽复用 + 内容守恒 + 残留归零
函数 形三() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        链表<字符串> 链 = 链表<字符串>();
        结果<空类型, 整32> s1 = 链.追加(字符串复制("形三甲串内容甲乙丙丁戊"));
        结果<空类型, 整32> s2 = 链.追加(字符串复制("形三乙串内容甲乙丙丁戊"));
        结果<空类型, 整32> sd = 链.删除头部();
        结果<空类型, 整32> s3 = 链.追加(字符串复制("形三丙串内容甲乙丙丁戊"));
        结果<字符串, 整32> sh = 链.读取头部();
        如果 (sh.正常) {
            如果 (字符串比较(sh.值, "形三乙串内容甲乙丙丁戊")) { 校验 = 1; }
        }
        结果<字符串, 整32> st = 链.读取尾部();
        如果 (st.正常) {
            如果 (!字符串比较(st.值, "形三丙串内容甲乙丙丁戊")) { 校验 = 0; }
        }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 4;
}

// ④ 队列<字符串>：槽复用 + 内容守恒 + 残留归零
函数 形四() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        队列<字符串> 队 = 队列<字符串>();
        结果<空类型, 整32> s1 = 队.入队(字符串复制("形四甲串内容甲乙丙丁戊"));
        结果<空类型, 整32> s2 = 队.入队(字符串复制("形四乙串内容甲乙丙丁戊"));
        结果<字符串, 整32> o1 = 队.出队();
        结果<空类型, 整32> s3 = 队.入队(字符串复制("形四丙串内容甲乙丙丁戊"));
        结果<字符串, 整32> f = 队.队首();
        如果 (f.正常) {
            如果 (字符串比较(f.值, "形四乙串内容甲乙丙丁戊")) { 校验 = 1; }
        }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 8;
}

// ⑤ 链表 删除尾部 + 复用（被摘槽归还后重分配）
函数 形五() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        链表<整64> 链 = 链表<整64>();
        结果<空类型, 整32> a1 = 链.追加(51);
        结果<空类型, 整32> a2 = 链.追加(52);
        结果<空类型, 整32> a3 = 链.追加(53);
        结果<空类型, 整32> d1 = 链.删除尾部();
        结果<空类型, 整32> a4 = 链.追加(54);
        整64 序 = 0;
        当 (链.大小() > 0) {
            结果<整64, 整32> h = 链.读取头部();
            如果 (h.正常) {
                序 = 序 * 100 + h.值;
            } 否则 {
                校验 = 99;
            }
            结果<空类型, 整32> dd = 链.删除头部();
        }
        如果 (序 == 515254) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 16;
}

// ⑥ 链表 头部追加 + 复用
函数 形六() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        链表<整64> 链 = 链表<整64>();
