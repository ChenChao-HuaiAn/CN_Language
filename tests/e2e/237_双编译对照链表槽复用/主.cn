        结果<空类型, 整32> a3 = 链.头部追加(63);
        结果<空类型, 整32> d1 = 链.删除头部();
        结果<空类型, 整32> a4 = 链.头部追加(64);
        整64 序 = 0;
        当 (链.大小() > 0) {
            结果<整64, 整32> h = 链.读取头部();
            如果 (h.正常) {
                序 = 序 * 100 + h.值;
            } 否则 {
                校验 = 99;
            }
            结果<空类型, 整32> dd = 链.删除头部();
        }
        如果 (序 == 646261) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 32;
}

// ⑦ 循环 20 万轮（入队/出队搅动）残留归零 + 值守恒
函数 形七(整64 轮数) -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 i = 0;
    当 (i < 轮数) {
        队列<整64> 队 = 队列<整64>();
        结果<空类型, 整32> q1 = 队.入队(i);
        结果<空类型, 整32> q2 = 队.入队(i + 1);
        结果<整64, 整32> o1 = 队.出队();
        如果 (o1.正常) {
            如果 (o1.值 != i) { 返回 0; }
        } 否则 {
            返回 0;
        }
        i++;
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 64;
}

// ⑧ 链表 清空 + 复用（清空后槽从 0 重分配）
函数 形八() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        链表<整64> 链 = 链表<整64>();
        结果<空类型, 整32> a1 = 链.追加(81);
        结果<空类型, 整32> a2 = 链.追加(82);
        链.清空();
        结果<空类型, 整32> a3 = 链.追加(83);
        结果<空类型, 整32> a4 = 链.追加(84);
        整64 序 = 0;
        当 (链.大小() > 0) {
            结果<整64, 整32> h = 链.读取头部();
            如果 (h.正常) {
                序 = 序 * 100 + h.值;
            } 否则 {
                校验 = 99;
            }
            结果<空类型, 整32> dd = 链.删除头部();
        }
        如果 (序 == 8384) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 128;
}

函数 主() -> 整32 {
    整64 和 = 0;
    和 = 和 + 形一();
    和 = 和 + 形二();
    和 = 和 + 形三();
    和 = 和 + 形四();
    和 = 和 + 形五();
    和 = 和 + 形六();
    和 = 和 + 形七(200000);
    和 = 和 + 形八();
    返回 整32(和);
}
