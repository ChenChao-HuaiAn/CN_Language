// D25（471-a）：ast_printer 全节点触达语料——`cn ast` 打印覆盖字面量五类/
//   表达式全族/语句全族/类/泛型/联合体/函数指针等 AST 节点形态。
静态 整32 全局计数 = 7;
类 计数器 {
    公开:
    整32 数;
    函数 计数器() {
        数 = 0;
    }
    函数 取值() -> 整32 {
        返回 数;
    }
}
泛型 <类型 T> 函数 挑(T 源) -> T {
    返回 源;
}
函数 计算(整32 甲, 整32 乙) -> 整32 {
    变量 和 = 甲 + 乙 * 2 - 乙 / 1 % 3;
    和 = 和 & 255 | 16 ^ 8;
    和 = (和 << 1) >> 1;
    如果 (和 > 10 && 和 != 12 || 假) {
        和 = -和;
    } 否则 {
        和 = ~和;
    }
    当 (和 > 0) {
        和 = 和 - 1;
        如果 (和 == 5) { 中断; }
    }
    返回 和;
}
函数 主() -> 整32 {
    变量 计 = 计数器();
    整32[3] arr = {1, 2, 3};
    变量 合计 = 计算(3, 4);
    合计 = 计.取值() + arr[0];
    合计 = 挑<整32>(合计);
    循环 (变量 i = 0; i < 3; i++) {
        合计 = 合计 + i;
    }
    选择 (合计) {
        情况 42:
            合计 = 0;
        默认:
            合计 = 1;
    }
    变量 标签 = 合计 > 5 ? 100 : 200;
    变量 名字 = "测试串";
    打印(标签);
    打印(名字);
    返回 0;
}
