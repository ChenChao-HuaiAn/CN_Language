// E2E 1382（双编译对照·正例·#1922 件1）：派生对象取继承方法作值——v2 方法值
//   推断/IR 方法符号沿基链回退（宿主 lookupClassMemberEx 沿链同源）。
//   修前 v2 报「推断声明初值类型未知」（推导成员类型ID 直扫本类方法表 miss），
//   宿主接受=零分叉；修后类型文本类名=定义类（宿主 mvOwner=方法符号 owner 类
//   同口径），IR 蹦床方法符号按定义类修饰（避免 派生$继承方法 undefined）。
// 覆盖：①带参继承方法值直调 ②零参继承方法值直调 ③基类接收者同一方法值
//   （同一继承方法经派生/基类接收者取值=同一 方法值<定义类,...> 文本）
//   ④方法值调用带实参 ⑤方法值机构零堆分配（栈上者·本面为蹦床地址单槽）。
类 基类 {
公开:
    整32 基数;
    函数 基类(整32 b) { 基数 = b; }
    函数 双倍(整32 x) -> 整32 { 返回 基数 + x; }
    函数 取名() -> 字符串 { 返回 字符串复制("甲"); }
}
类 派生类 : 基类 {
公开:
    函数 派生类(整32 b) : 基类(b) { }
}
函数 主() -> 整32 {
    派生类 派生 = 派生类(100);
    变量 cb = 派生.双倍;              // ① 带参继承方法值
    打印(整32(cb(5)));                //    105
    变量 cb0 = 派生.取名;             // ② 零参继承方法值
    打印(cb0());                      //    甲
    基类 基 = 基类(7);
    变量 cb基 = 基.双倍;              // ③ 基类接收者同一方法值
    打印(整32(cb基(1)));              //    8
    整64 分配基 = 内存::活动分配数();
    {
        变量 内 = 派生.双倍;          // ④ 块内方法值 + 带实参调用
        打印(整32(内(2)));            //    102
    }
    打印(内存::活动分配数() - 分配基);  // ⑤ 0
    返回 0;
}
