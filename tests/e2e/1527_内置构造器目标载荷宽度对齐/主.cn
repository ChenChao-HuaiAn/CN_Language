// E2E 1527（2026-10-25 #1588 修复轮·plans/020 移植纪律 9 双编译对照）：
//   **内置构造器目标载荷宽度对齐**——同一份源码经宿主真实管线与 v2 自举链各编
//   各跑，两侧退出码须相等。缺陷实录（#1585 审计）：`可选<整64> 选项 = 某些(7)`
//   实测 取值=-1——宿主语义层按实参（整32 字面量）推导构造器类型=可选<整32>，
//   IR 层按窄载荷发射临时合成体（flag+4 字节写），声明位按目标宽度 16 字节
//   CopyStruct → 高 32 位栈垃圾。v2 侧正确（64 位写），=宿主单侧分叉。
//   修复=构造器目标类型校准（声明/赋值/返回/实参位）：resolvedType 取目标
//   结果/可选，IR 按目标载荷 Cast 写满宽度。
//   校验和折位（八形态，各 1/2/4/8/16/32/64/128）：
//     ① 声明位 某些(整32 字面量) → 可选<整64>（主缺陷面；另含已正确对照形态
//        某些(整64(7)) / 某些(整64 变量)）
//     ② 赋值位 某些(整32 字面量) → 可选<整64>
//     ③ 实参位 某些(整32 字面量) → 形参 可选<整64>
//     ④ 声明位 正常(整32 字面量) → 结果<整64,整32>
//     ⑤ 声明位 错误(整32 字面量) → 结果<整32,整64>（错误码载荷拓宽）
//     ⑥ 实参位 正常 → 结果<整64,整32> 且 错误 → 结果<整32,整64>
//     ⑦ 可选<字符串> 某些(字符串)
//     ⑧ 返回位 返回 某些(7) → 可选<整64>（跨函数接收）
//   全对=255；任一位丢失=对照失败（高位垃圾/错值即退出码变化）。
//   形态守卫一律语句级（如果(选项.有值){如果(选项.值==7)}），不用短路 .值。
函数 取选(可选<整64> 参) -> 整64 {
    整64 果 = 0 - 1;
    如果 (参.有值) {
        如果 (参.值 == 7) { 果 = 7; }
    }
    返回 果;
}

函数 取果(结果<整64, 整32> 参) -> 整64 {
    整64 果 = 0 - 1;
    如果 (参.正常) {
        如果 (参.值 == 7) { 果 = 7; }
    }
    返回 果;
}

函数 取错(结果<整32, 整64> 参) -> 整64 {
    整64 果 = 0 - 1;
    如果 (!参.正常) {
        如果 (参.错误 == 5) { 果 = 5; }
    }
    返回 果;
}

函数 返某些() -> 可选<整64> {
    返回 某些(7);
}

函数 主() -> 整32 {
    整32 校验 = 0;
    // ① 声明位：整32 字面量载荷 → 目标 可选<整64>（#1588 主缺陷面）；
    //   同组对照：某些(整64(7)) / 某些(整64 变量) 修复前即正确（防回归）
    整64 宽 = 7;
    可选<整64> 甲 = 某些(7);
    可选<整64> 甲二 = 某些(整64(7));
    可选<整64> 甲三 = 某些(宽);
    整64 甲果 = 0 - 1;
    如果 (甲.有值) {
        如果 (甲.值 == 7) { 甲果 = 7; }
    }
    整64 甲二果 = 0 - 1;
    如果 (甲二.有值) {
        如果 (甲二.值 == 7) { 甲二果 = 7; }
    }
    整64 甲三果 = 0 - 1;
    如果 (甲三.有值) {
        如果 (甲三.值 == 7) { 甲三果 = 7; }
    }
    如果 (甲果 == 7 && 甲二果 == 7 && 甲三果 == 7) { 校验 = 校验 + 1; }
    // ② 窄载荷（整8 变量）声明位 → 可选<整64>（跨两档宽度的符号扩展写满）
    整8 窄 = 7;
    可选<整64> 乙 = 某些(窄);
    整64 乙果 = 0 - 1;
    如果 (乙.有值) {
        如果 (乙.值 == 7) { 乙果 = 7; }
    }
    如果 (乙果 == 7) { 校验 = 校验 + 2; }
    // ③ 实参位：某些(整32 字面量) → 形参 可选<整64>
    如果 (取选(某些(7)) == 7) { 校验 = 校验 + 4; }
    // ④ 声明位：正常(整32 字面量) → 结果<整64,整32>（原高位垃圾同族面）
    结果<整64, 整32> 丙 = 正常(7);
    整64 丙果 = 0 - 1;
    如果 (丙.正常) {
        如果 (丙.值 == 7) { 丙果 = 7; }
    }
    如果 (丙果 == 7) { 校验 = 校验 + 8; }
    // ⑤ 声明位：错误(整32 字面量) → 结果<整32,整64>（错误码载荷拓宽）
    结果<整32, 整64> 丁 = 错误(5);
    整64 丁果 = 0 - 1;
    如果 (!丁.正常) {
        如果 (丁.错误 == 5) { 丁果 = 5; }
    }
    如果 (丁果 == 5) { 校验 = 校验 + 16; }
    // ⑥ 实参位：正常/错误 → 宽载荷形参（两条件都成立才置位）
    整64 六甲 = 0 - 1;
    如果 (取果(正常(7)) == 7) { 六甲 = 1; }
    整64 六乙 = 0 - 1;
    如果 (取错(错误(5)) == 5) { 六乙 = 1; }
    如果 (六甲 == 1 && 六乙 == 1) { 校验 = 校验 + 32; }
    // ⑦ 可选<字符串> 某些(字符串)
    可选<字符串> 戊 = 某些(字符串复制("x"));
    整64 戊果 = 0 - 1;
    如果 (戊.有值) {
        如果 (字符串比较(戊.值, "x")) { 戊果 = 1; }
    }
    如果 (戊果 == 1) { 校验 = 校验 + 64; }
    // ⑧ 返回位构造器 → 可选<整64>（跨函数接收）
    如果 (取选(返某些()) == 7) { 校验 = 校验 + 128; }
    返回 校验;
}
