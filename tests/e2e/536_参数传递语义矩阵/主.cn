// 536 参数传递语义矩阵（056 甲·805 轮·双编译对照）
// 覆盖：类对象按值形参=引用写穿 / 结构体按值形参=副本 / 临时实参物化
// 规范：plans/001 §5.3 参数传递语义（056 甲·2026-09-27 落盘）
导入 容器::向量;
导入 映射集合;

类 盒子 {
公开:
    整64 值槽;
    函数 盒子() { 值槽 = 0; }
}

结构体 点 {
    整64 x;
    整64 y;
}

函数 临时读(映射<整64, 整64> 表) -> 整64 {
    结果<整64, 整32> 读 = 表.获取(7);
    如果 (读.正常) {
        返回 读.值;
    }
    返回 0;
}

函数 改盒子(盒子 对象) -> 整64 {
    对象.值槽 = 55;
    返回 对象.值槽;
}

函数 改点(点 p) -> 整64 {
    p.x = 99;
    返回 p.x;
}

函数 主() -> 整32 {
    整64 临时值 = 临时读(映射<整64, 整64>());
    打印("临时实参: ", 临时值);
    盒子 对象 = 盒子();
    整64 函数内 = 改盒子(对象);
    打印("类函数内: ", 函数内);
    打印("类主函数: ", 对象.值槽);
    点 坐标;
    坐标.x = 1;
    坐标.y = 2;
    整64 点函数内 = 改点(坐标);
    打印("结构体函数内: ", 点函数内);
    打印("结构体主函数: ", 坐标.x);
    返回 0;
}
