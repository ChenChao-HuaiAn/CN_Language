// E2E 1026（2026-10-16 任务 662·P1·「表达式位串临时全释放族」余量收口）：
//   ①三元条件释放全消费位（宿主/v2 双侧·E2E 921 十形态的余量扩展）：
//     拼接操作数（真/假/双拥有/融合链段）/ 打印实参 / 内置消费族实参 /
//     用户函数传参 / 语句位丢弃 / 嵌套三元——「潜在拥有」分支拥有性感知
//     条件释放（选中字面量借用分支不得 free）；
//   ②方法链消费位：`造盒(...).长度()` 等「接收者=调用返回类对象」形态——
//     拥有形态（构造新建/函数返回本地移出）在方法调用完成后析构（无析构类
//     走字段级联+对象 free）；借用返回（返回参数=共享对象）不误释放。
//   断言口径=内存::活动分配数() 差值恒 0（216/907/921 同款·每形态前置基线）；
//   退出码=折位（8 位: 1 拼接族/2 打印/4 消费族/8 传参/16 语句位/32 嵌套/
//   64 方法链×2/128 借用负向锚定）=255 全通过；任一形态残留非 0 或内容
//   不符=该位丢失=退出码变化=对照失败。
//   成对=1026_v2_（同一源码 v2 自举链各编各跑·宿主/v2 零分叉锁）。

// 临时串源（每次调用新分配——内容校验保证分配真实发生）
函数 造串(整32 n) -> 字符串 {
    返回 "临时串" + 整数转字符串(整64(n));
}
函数 吃串(字符串 s) -> 整64 {
    返回 字符串长度(s);
}

// 无析构类（字段级联释放面：删除对象=合成析构字段级联+free·658②）
类 串盒 {
公开:
    字符串 内容;
    函数 串盒(字符串 s) { 内容 = s; }
    函数 长度() -> 整64 {
        返回 字符串长度(内容);
    }
}

// 拥有形态：返回构造调用（新建）
函数 造盒(字符串 s) -> 串盒 {
    返回 串盒(s);
}
// 拥有形态：返回本地变量（移出·返回块豁免）
函数 造局盒(字符串 s) -> 串盒 {
    串盒 局 = 串盒(s);
    返回 局;
}
// 借用形态：返回参数（共享对象·不得析构）
函数 取串盒(串盒 p) -> 串盒 {
    返回 p;
}

// ① 三元作拼接右操作数（条件真→真分支拥有）
函数 形一() -> 整64 {
    布尔 条 = 真;
    整64 前 = 内存::活动分配数();
    字符串 s = "前" + (条 ? 造串(1) : "字面量");
    布尔 对 = 字符串比较(s, "前临时串1");
    字符串释放(s);
    如果 (内存::活动分配数() != 前 || !对) { 返回 0; }
    返回 1;
}
// ② 三元作拼接左操作数（条件假→假分支拥有）
函数 形二() -> 整64 {
    布尔 条 = 假;
    整64 前 = 内存::活动分配数();
    字符串 s = (条 ? "字面量" : 造串(2)) + "后";
    布尔 对 = 字符串比较(s, "临时串2后");
    字符串释放(s);
    如果 (内存::活动分配数() != 前 || !对) { 返回 0; }
    返回 1;
}
// ③ 三元双分支均拥有（快径：结果必为堆串）
函数 形三() -> 整64 {
    布尔 条 = 真;
    整64 前 = 内存::活动分配数();
    字符串 s = "前" + (条 ? 造串(3) : 造串(4));
    布尔 对 = 字符串比较(s, "前临时串3");
    字符串释放(s);
    如果 (内存::活动分配数() != 前 || !对) { 返回 0; }
    返回 1;
}
// ⑨ 融合链中段三元（链长 3：宿主融合路径 / v2 逐节路径·同语义）
函数 形九() -> 整64 {
    布尔 条 = 真;
    整64 前 = 内存::活动分配数();
    字符串 s = "前" + "中" + (条 ? 造串(12) : "字面量");
    布尔 对 = 字符串比较(s, "前中临时串12");
    字符串释放(s);
    如果 (内存::活动分配数() != 前 || !对) { 返回 0; }
    返回 1;
}
// ④ 三元作打印实参（打印族消费位）
函数 形四() -> 整64 {
    布尔 条 = 真;
    整64 前 = 内存::活动分配数();
    打印("t:", 条 ? 造串(5) : "字面量");
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 1;
}
// ⑤ 三元作内置消费族实参
函数 形五() -> 整64 {
    布尔 条 = 真;
    整64 前 = 内存::活动分配数();
    整64 L = 字符串长度(条 ? 造串(6) : "字面量");
    如果 (内存::活动分配数() != 前 || L != 10) { 返回 0; }
    返回 1;
}
// ⑥ 三元作用户函数传参位实参
函数 形六() -> 整64 {
    布尔 条 = 真;
    整64 前 = 内存::活动分配数();
    整64 L = 吃串(条 ? 造串(7) : 造串(8));
    如果 (内存::活动分配数() != 前 || L != 10) { 返回 0; }
    返回 1;
}
// ⑦ 三元作独立语句丢弃（语句位·645 面扩展）
函数 形七() -> 整64 {
    布尔 条 = 真;
    整64 前 = 内存::活动分配数();
    (条 ? 造串(9) : "字面量");
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 1;
}
// ⑧ 嵌套三元（递归条件释放）
函数 形八() -> 整64 {
    布尔 条 = 真;
    整64 前 = 内存::活动分配数();
    整64 L = 字符串长度(条 ? (条 ? 造串(10) : "字面量") : 造串(11));
    如果 (内存::活动分配数() != 前 || L != 11) { 返回 0; }
    返回 1;
}
// ⑩ 方法链消费位·构造调用链（新建对象·无析构类字段级联）
函数 形十() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 L = 串盒("abc").长度();
    如果 (内存::活动分配数() != 前 || L != 3) { 返回 0; }
    返回 1;
}
// ⑪ 方法链消费位·函数返回本地移出链
函数 形十一() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 L = 造局盒("甲乙丙丁").长度();
    如果 (内存::活动分配数() != 前 || L != 12) { 返回 0; }
    返回 1;
}
// ⑫ 负向锚定：借用返回（返回参数=共享对象）不误释放——链式调用后原对象
//    内容仍可读（误析构=内容悬垂/崩）
函数 形十二() -> 整64 {
    串盒 甲 = 串盒("保留内容甲乙丙丁");
    整64 对 = 甲.长度();
    整64 链 = 取串盒(甲).长度();
    布尔 存活 = (甲.长度() == 对) && (链 == 对);
    如果 (!存活) { 返回 0; }
    返回 1;
}

函数 主() -> 整32 {
    打印行("===== 1026 三元与方法链消费位释放 =====");
    整32 和 = 0;
    整32 拼接对 = 整32(形一() + 形二() + 形三() + 形九());
    如果 (拼接对 == 4) { 和 = 和 + 1; }
    如果 (形四() == 1) { 和 = 和 + 2; }
    如果 (形五() == 1) { 和 = 和 + 4; }
    如果 (形六() == 1) { 和 = 和 + 8; }
    如果 (形七() == 1) { 和 = 和 + 16; }
    如果 (形八() == 1) { 和 = 和 + 32; }
    如果 (形十() == 1 && 形十一() == 1) { 和 = 和 + 64; }
    如果 (形十二() == 1) { 和 = 和 + 128; }
    如果 (和 != 255) {
        打印行("1026 失败: 折位=", 和);
        返回 整32(和);
    }
    打印行("1026 全形态差值 0 通过");
    返回 0;
}
