// E2E 97_遍历 表达式（P3-24）：遍历 造数据() 中 每个 x —— 迭代对象为函数调用临时值（类容器）
// 设计：非名称式迭代对象先求值为隐藏临时变量，再经 大小()/元素() 遍历（求值一次）。
导入 容器::向量;

函数 造数据() -> 向量<整32> {
    向量<整32> 数据 = 向量<整32>();
    结果<空类型, 整32> 加1 = 数据.追加(10);
    如果 (加1.正常) { } 否则 { 返回 数据; }
    结果<空类型, 整32> 加2 = 数据.追加(20);
    如果 (加2.正常) { } 否则 { 返回 数据; }
    结果<空类型, 整32> 加3 = 数据.追加(30);
    如果 (加3.正常) { } 否则 { 返回 数据; }
    返回 数据;
}

函数 主() -> 整32 {
    打印("===== 遍历 表达式（P3-24）=====");
    整32 总和 = 0;
    遍历 造数据() 中 每个 x {
        打印("x: ", x);
        总和 = 总和 + x;
    }
    打印("总和: ", 总和);   // 60
    打印("===== 完成 =====");
    返回 0;
}
