// E2E 854（2026-10-13·任务 #558 锁面·负例·506甲用户裁决）：同型超域字面量
//   声明/赋值/返回/推断四通道一律编译期拒——无后缀字面量恒定级整32
//   （literalTypeOf 与值大小无关）而值可超域，同型转换短路原零检查放行=
//   编译期静默回绕（c506 探针实锤：运行 -2147483648 位模式回绕）；Rust
//   E0308 同款「同型亦查域」。负号形态按负值判域不在此拒
//   （-2147483648=整32::MIN 域内合法·855 放行对照锚）。
//   双编译对照负测：宿主与 v2p 同源同拒（诊断锚=双侧同文案子串）。
函数 取甲() -> 整32 {
    返回 2147483648;    // 返回面：同型超域拒
}
函数 主() -> 整32 {
    整32 甲 = 2147483648;    // 声明面：同型超域拒
    甲 = 3000000000;         // 赋值面：同型超域拒
    变量 乙 = 2147483649;    // 推断面：字面量值超恒定级（整32）域拒
    打印(甲);
    打印(乙);
    返回 0;
}
