// E2E 986（775 配套·2026-10-14·001 §5.6/§5.7「字段=裸声明」锁面）：
//   类实例字段与结构体字段声明初始化器=双侧编译拒绝（同源双编译对照·
//   诊断锚=[字段声明初始化器未支持]·宿主与 v2p 同文案单诊断）。
//   历史缺陷=宿主接受但 semantic/IR 零消费（静默错值·应 205 得 0）/
//   v2 类字段 3 条连锁误导诊断·结构体字段零诊断静默跳过——乙案双侧
//   对齐根治。类静态字段初始化器=468 立法面（加载期直存）不在本锁。
类 计数器 {
公开:
    整32 基 = 100;
    函数 加倍() -> 整32 {
        返回 基 * 2;
    }
}

结构体 点 {
    整32 x = 5;
}

函数 主() -> 整32 {
    计数器 c;
    点 p;
    打印(c.加倍() + p.x);
    返回 0;
}
