// 010（def-init·plans/021 010·用户裁决甲）：未初始化读放行矩阵（正例）
// 覆盖：先赋后读/分支双支赋值/数组元素先写后读/取地址出参（&结构体=初始化
//       通道·Rust &mut maybe-init 同款）/拥有型裸声明豁免（字符串）/return
//       终止支豁免（一支返回则汇合取另一支）。反例面=534 负测矩阵。
// 双测铁律：宿主+v2p 同测（双编译对照·运行输出逐行比对）。
结构体 签 {
    整32 文本;
}

不安全 函数 填充签(签* 目标) -> 整32 {
    目标.文本 = 42;
    返回 0;
}

函数 主() -> 整32 {
    // ① 先赋后读
    整32 x;
    x = 5;
    打印行(x);
    // ② 分支双支赋值（汇合=两支都初始化）
    整32 y;
    如果 (x > 3) { y = 10; } 否则 { y = 20; }
    打印行(y);
    // ③ 数组元素先写后读（元素级跟踪）
    整32[3] a;
    a[0] = 7;
    a[1] = 8;
    a[2] = a[0] + a[1];
    打印行(a[2]);
    // ④ 取地址出参（&g=可能被写→读字段放行）
    签 g;
    填充签(&g);
    打印行(g.文本);
    // ⑤ 拥有型裸声明豁免（入口零初始化防御）
    字符串 s;
    s = "文本";
    打印行(s);
    // ⑥ return 终止支豁免（否则支返回→真支赋值即定）
    整32 z;
    如果 (y == 10) { z = 1; } 否则 { 返回 1; }
    打印行(z);
    返回 0;
}
