// E2E 1481_类方法体遮蔽字段作用域（#1472·#1467 采样 H07 反转件：v2 对宿主错）：
//   类继承下子类声明与父类字段同名遮蔽字段时，父类方法体内的字段名必须按
//   **声明类作用域**解析（001 OOP 对齐 C++：基::读 内的 v 永远是 基::v，
//   与调用对象静态/动态类型无关）。
// 缺陷根因（宿主双侧）：①语义检查把类字段并入方法作用域按提升目标类
//   （class_resolver_access），遮蔽时基类方法体误绑派生类条目（错类型误拒）；
//   ②IR 字段偏移查询 classFieldOffset 链层父在前遍历恒命中最基层同名条目，
//   与类型查询（lookupClassMember 最派生命中）不一致——遮蔽族读写坍缩同槽
//   （写穿父字段，静默错值）。修复后：偏移=最派生命中条目按布局类累加；
//   方法体直访按方法声明类链解析（classFieldOffsetFrom/fieldScopeClass）。
// 断言面：A 遮蔽读面（基::读 读基::v=0，p.v 写派::v=2）/ B 遮蔽类型不同
//   （浮64 遮蔽不误拒，读面仍整32=0）/ C 方法写面（基::设 写基::v=5，
//   p.v 写派::v=2，双槽互不穿写）。
类 基 {
公开:
    整32 v;
    函数 读() -> 整32 { 返回 v; }
    函数 设(整32 k) { v = k; }
}
类 派 : 基 {
公开:
    整32 v;
}
类 基2 {
公开:
    整32 v;
    函数 读() -> 整32 { 返回 v; }
}
类 派2 : 基2 {
公开:
    浮64 v;
}
函数 主() -> 整32 {
    派 p = 派();
    p.v = 2;
    打印(p.读());          // A：基::读 读 基::v（未写=0），非派::v 的 2
    打印(p.v);             // A：派::v 槽 = 2
    派2 q = 派2();
    q.v = 2.5;
    打印(q.读());          // B：基::读 内 v 类型=基2::v 整32（不误拒）
    打印(q.v);             // B：派2::v 浮64 = 2.5
    派 r = 派();
    r.设(5);
    r.v = 2;
    打印(r.读());          // C：基::设 写 基::v=5，读面=5
    打印(r.v);             // C：派::v=2
    返回 0;
}
