// 960 泛型类显式构造（766·双编译对照）
// 覆盖：泛型类显式构造表达式（类名<实参>(...) 赋值/初始化声明形态·001 §5.6
//       泛型章 编译期单态化——C++ Box<int> b = Box<int>(5); 对照合法）：
//   ①裸声明+无参构造（基线绿面保持）②显式构造表达式（变量 推断声明·本件修复锚）
//   ③显式类型声明+带参显式构造 ④推断声明+带参构造（整64 宽度实例）
//   ⑤同实例多对象独立性（单态化去重·各对象字段独立）
// 766 修复锚：v2 语义层 泛型显式实例调用通道对「基名∈用户类们」的构造形态
//   误走泛型函数基函数扫描（类非函数=必然 miss）→26_generics 行83 基线红；
//   修复=入口先分流泛型类构造（返回实例合成名·对齐 951 构造通道对象指针语义）。

// 无参构造泛型类（形态①②载体）
泛型 <类型 T>
类 无参盒 {
公开:
    T 值;
    函数 无参盒() {
        值 = 0;
    }
    函数 设置(T 新值) {
        值 = 新值;
    }
    函数 取() -> T {
        返回 值;
    }
}

// 带参构造泛型类（形态③④载体）
泛型 <类型 T>
类 盒子 {
公开:
    T 值;
    函数 盒子(T 初始) {
        值 = 初始;
    }
    函数 取() -> T {
        返回 值;
    }
}

函数 主() -> 整32 {
    // 形态①：裸声明（无参构造·基线绿面保持）
    无参盒<整32> 裸盒;
    裸盒.设置(11);
    打印("裸盒=", 裸盒.取());

    // 形态②：显式构造表达式（变量 推断声明·766 修复锚形态）
    变量 甲 = 无参盒<整32>();
    甲.设置(22);
    打印("甲=", 甲.取());

    // 形态③：显式类型声明 + 带参显式构造
    盒子<整32> 乙 = 盒子<整32>(5);
    打印("乙=", 乙.取());

    // 形态④：推断声明 + 带参显式构造（整64 宽度实例）
    变量 丙 = 盒子<整64>(70);
    打印("丙=", 丙.取());

    // 形态⑤：同实例类型多对象独立性（单态化去重·各对象字段独立）
    盒子<整32> 丁 = 盒子<整32>(8);
    盒子<整32> 戊 = 盒子<整32>(900);
    打印("独立=", 戊.取(), ",", 丁.取());
    返回 0;
}
