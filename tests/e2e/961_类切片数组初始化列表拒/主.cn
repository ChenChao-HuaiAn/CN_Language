// 869(#234 禁止类切片 v2 侧残余面补齐·相邻形态):数组初始化列表元素
//   派生类值 → 基类元素类型——逐元素切片。v2 修前 rc=0 放行。
//   预期失败:诊断锚「禁止类切片」(宿主/v2 双侧同文案)。
类 形状 {
公开:
    虚拟 函数 面积() -> 整32 { 返回 0; }
}
类 方 : 形状 {
公开:
    整32 边;
    函数 方(整32 b) { 边 = b; }
    重写 函数 面积() -> 整32 { 返回 边 * 边; }
}
函数 主() -> 整32 {
    方 a = 方(3);
    形状[2] 甲 = { a, 方(4) };
    打印(甲[0].面积());
    返回 0;
}
