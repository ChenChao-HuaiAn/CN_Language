// E2E 590（1024 轮·任务 177 甲案）：裸条件块（无括号条件）双形态合法。
// 背景：parser_expr.cpp 标识符+{ 无类型守卫盲吃=结构体初始化探测，条件尾
//   标识符后跟块 { 被吞（合法程序被拒·p1004_01 实录）；修复=如果/当 条件
//   解析期间置 suppressStructInit_（对齐 遍历 C-2 先例 parser_stmt.cpp:165）。
// 立法：001 §5.5 + spec 03——条件括号可选（双形态合法）；条件表达式内
//   类型名{...} 裸结构体字面量须括号包裹（消歧条文·Rust 同款·负测=591）。
// 覆盖：R1 关系比较收尾（缺陷触发形态）/R2 单标识符最短形态/R3 裸当循环/
//   R4 否则 如果 链式裸条件/R5 防误伤=块内真结构体初始化照常（旗标恢复面·
//   嵌套裸条件尾标识符）/R6 带括号形态对照（既有绿防回归）/
//   R7 带括号条件内实参位字面量照常（括号已显式限界 { 无歧义·不置位·
//   存量 235/238/240/241 同形态·全量门禁实测兜住后补的防误伤锚）。
结构体 点 {
    整32 横;
    整32 纵;
}

函数 取横(点 p) -> 整32 {
    返回 p.横;
}

函数 主() -> 整32 {
    整32 a = 3;
    整32 b = 5;

    // R1 裸如果·关系比较收尾（缺陷触发形态：b 后跟块 {）
    如果 a < b {
        打印("R1: 裸如果比较条件");
    }

    // R2 裸如果·单标识符（最短触发形态）
    布尔 flag = 真;
    如果 flag {
        打印("R2: 裸如果标识符条件");
    }

    // R3 裸当循环
    整32 i = 0;
    整32 总和 = 0;
    当 i < 4 {
        总和 = 总和 + i;
        i++;
    }
    如果 总和 == 6 {
        打印("R3: 裸当循环求和");
    }

    // R4 否则 如果 链式裸条件（递归解析面）
    整32 值 = 7;
    如果 值 < 0 {
        打印("R4: 负");
    } 否则 如果 值 == 7 {
        打印("R4: 链式裸条件");
    } 否则 {
        打印("R4: 其他");
    }

    // R5 防误伤：块内真结构体初始化照常（旗标恢复面）+ 嵌套裸条件尾标识符
    如果 a < b {
        点 p = 点 { 横 = 1, 纵 = 2 };
        整32 合 = p.横 + p.纵;
        如果 合 == 3 {
            打印("R5: 块内结构体初始化");
        }
    }

    // R6 带括号形态对照（既有绿）
    如果 (a < b) {
        打印("R6: 带括号对照");
    }

    // R7 带括号条件内实参位结构体字面量照常（括号限界面·84-a 存量合法形态）
    如果 (取横(点 { 横 = 5, 纵 = 6 }) == 5) {
        打印("R7: 括号内实参字面量");
    }

    返回 0;
}
