// E2E 1538_双编译对照合成体隐式转换（#1592·P1）：
//   结果/可选 隐式转换 结果<A,B> -> 结果<C,D>（A→C 且 B→D 可转）整体赋值/声明初值
//   **值保真**：旧实现按目标大小整块 IR_结构体拷贝——源载荷窄于目标时高位残留
//   （结果<整32,整32> -> 结果<整64,整32> v2 读 708669603847 / 宿主负数零扩展
//   4294967295 实测）。修=逐字段转换：判别位@0 + 按 tag 分支（正常 T1→T2、
//   错误 E1→E2），读按源类型码（有符号 movsxd/零扩展分派）、写按目标类型码。
//   覆盖：声明初值/赋值位/可选/调用返回/整→浮/浮32→浮64/三元/同型整拷零变化；
//   宿主与 v2 同跑本 .expected（零分叉）。
函数 造结果(整32 值) -> 结果<整32, 整32> {
    返回 正常(值);
}

函数 主() -> 整32 {
    结果<整32, 整32> 甲 = 正常(7);
    结果<整64, 整32> 乙 = 甲;
    如果 (乙.正常) {
        打印("正宽=");
        打印行(乙.值);
    }
    结果<整32, 整32> 丙 = 正常(-1);
    结果<整64, 整32> 丁 = 丙;
    如果 (丁.正常) {
        打印("负宽=");
        打印行(丁.值);
    }
    结果<整32, 整32> 戊 = 错误(-5);
    结果<整64, 整32> 己;
    己 = 戊;
    如果 (!己.正常) {
        打印("错宽=");
        打印行(己.错误);
    }
    结果<整32, 整32> 庚 = 错误(-5);
    结果<整32, 整64> 辛 = 庚;
    如果 (!辛.正常) {
        打印("错宽二=");
        打印行(辛.错误);
    }
    可选<整32> 壬 = 某些(9);
    可选<整64> 癸 = 壬;
    如果 (癸.有值) {
        打印("选正=");
        打印行(癸.值);
    }
    可选<整32> 子 = 某些(-11);
    可选<整64> 丑 = 子;
    如果 (丑.有值) {
        打印("选负=");
        打印行(丑.值);
    }
    结果<整64, 整32> 寅 = 造结果(-3);
    如果 (寅.正常) {
        打印("调=");
        打印行(寅.值);
    }
    结果<整32, 整32> 卯 = 正常(-13);
    结果<浮64, 整32> 辰 = 卯;
    如果 (辰.正常) {
        打印("浮=");
        打印行(辰.值);
    }
    结果<浮32, 整32> 巳 = 正常(浮32(1.5));
    结果<浮64, 整32> 午 = 巳;
    如果 (午.正常) {
        打印("浮宽=");
        打印行(午.值);
    }
    结果<整32, 整32> 未 = 正常(-17);
    结果<整32, 整32> 申 = 正常(-19);
    结果<整64, 整32> 酉 = (真 ? 未 : 申);
    如果 (酉.正常) {
        打印("三元=");
        打印行(酉.值);
    }
    结果<整32, 整32> 戌 = 正常(-23);
    结果<整32, 整32> 亥 = 戌;
    如果 (亥.正常) {
        打印("同型=");
        打印行(亥.值);
    }
    返回 0;
}
