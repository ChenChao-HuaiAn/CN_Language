// E2E 656（280 轮·容器内结果盒读链锚）：映射.获取 → 结果<结构体,整32> →
//   值.字段 读链——v2p 语义状态容器（向量<映射<整64,符号>>·符号表三函数）
//   同构面；布局截断时 查.值.类型ID 读错位=「全域已转移/未声明类型误报」
//   根因（t1 探针铁证：f1 对·f2/f4 读 1=tag 邻域垃圾）。与 652 合力锚定
//   载荷真值守卫修复（预降级趟不固化·统一布局趟重算真值）。
导入 映射集合;

结构体 符号 {
    整64 名ID;
    整64 类型ID;
    整64 种类;
    整64 附加;
    整64 已转移;
}

不安全 函数 主() -> 整32 {
    映射<整64, 符号> 层 = 映射<整64, 符号>();
    符号 s;
    s.名ID = 111;
    s.类型ID = 222;
    s.种类 = 0;
    s.附加 = 7;
    s.已转移 = 0;
    结果<空类型, 整32> 写回 = 层.设置(5, s);
    如果 (!写回.正常) { 打印(0); 返回 0; }
    结果<符号, 整32> 盒 = 层.获取(5);
    如果 (盒.正常) {
        如果 (盒.值.名ID != 111) { 打印(0); 返回 0; }
        如果 (盒.值.类型ID != 222) { 打印(0); 返回 0; }
        如果 (盒.值.附加 != 7) { 打印(0); 返回 0; }
    } 否则 {
        打印(0);
        返回 0;
    }
    打印(7);
    返回 0;
}
