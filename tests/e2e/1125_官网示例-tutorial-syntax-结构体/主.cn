// 官网文档示例 · tutorial-syntax.html · 结构体（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
结构体 点 {
    浮64 x;
    浮64 y;
}

结构体 线段 {
    点 起;      // 嵌套结构体字段
    点 止;
}

函数 主() -> 整32 {
    点 a = 点{x = 1.0, y = 2.0};
    点 b = a;               // 整体值拷贝
    b.x = 9.0;
    打印(a.x, " ", b.x);    // 1 9（两态独立）

    线段 线 = 线段{起 = 点{x = 0.0, y = 0.0}, 止 = 点{x = 3.0, y = 4.0}};
    浮64 dx = 线.止.x - 线.起.x;
    浮64 dy = 线.止.y - 线.起.y;
    打印(dx * dx + dy * dy);   // 25（3-4-5 直角三角形）
    返回 0;
}