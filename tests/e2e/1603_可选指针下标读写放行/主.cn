// E2E 1603_可选指针下标读写放行（#1719 读面②·1588 对照续面）：可选/结果 族
//   pointee 的**裸指针变量**下标读写全链——v2 白名单（指针下标所指合法）缺
//   结果/可选 族=一侧拒（语义层「指针下标所指类型未支持」）一侧放（宿主
//   全链正确）分叉根治。修=谓词补 是结果类型（IR容器判定 单一归属·前缀+
//   基名双判覆盖 可选$整64 实例形态）；发射层与成员基座 乙.槽[i] 673 两级
//   寻址同通道（聚合块 16B tag+payload 整块读写·形一佐证）。
//   形态（退出码=折校验和 3）：
//     ① 成员基座（乙.槽[1]）写+整体读（回归锚·673 通道·tag/payload 双校验）
//     ② 裸指针变量（p[1]）写+整体读（本件修面·修前 v2 语义层双拒）
//   读侧锚：v.有值 与 v.值 逐项校验（tag 对 payload 错即运行值炸·双侧一致面）。
结构体 选架 {
    可选<整64>* 槽;
    整64 容量;
}

// ① 成员基座下标读写（回归锚）
不安全 函数 形一() -> 整64 {
    可选<整64>[3] 池;
    选架 乙;
    乙.槽 = &池[0];
    乙.槽[1] = 某些(888);
    可选<整64> v = 乙.槽[1];
    如果 (!v.有值 || v.值 != 888) { 返回 0; }
    // 空载荷位读回（无 形态·tag 面校验）
    乙.槽[2] = 无;
    可选<整64> w = 乙.槽[2];
    如果 (w.有值) { 返回 0; }
    返回 1;
}

// ② 裸指针变量下标读写（本件修面）
不安全 函数 形二() -> 整64 {
    可选<整64>[2] 池;
    可选<整64>* p = &池[0];
    p[1] = 某些(64);
    可选<整64> v = p[1];
    如果 (!v.有值 || v.值 != 64) { 返回 0; }
    p[0] = 无;
    可选<整64> w = p[0];
    如果 (w.有值) { 返回 0; }
    返回 2;
}

不安全 函数 主() -> 整32 {
    整64 校验 = 形一() + 形二();
    // ①+② 全对=3（1+2）
    打印("读侧=", 校验);
    如果 (校验 != 3) { 返回 1; }
    返回 0;
}
