// E2E 577（939 轮·任务 100 泄漏面根治转正）：结果盒类值副本盒亡释放+类串字段清理。
//   修复前：局部 `结果<货物,整32> r=正常(g)` 盒内深拷副本（889 装箱）盒亡零释放
//   （收集面 183-a 拦联合体内类字段·116 双删回退史）=泄漏（p100 差 1）。
//   修复：①实例级登记（pendingBoxCopies——889 深拷分叉登记盒值字段地址·块出口
//   条件 DeleteObject+清槽幂等·函数尾兜底·返回表达式豁免〔盒移交调用方〕·
//   可选盒不登记〔收集面外壳已覆盖·双登记=双删〕）；②类析构尾串字段清理注入
//   （结构体三件套 79-a 对类不对称缺失·p104 定性副本串差 1）。
//   〔基准=019〕第一句值语义深拷：盒内恒独立副本·消亡=对象+串字段+清槽全链。
//   判据：~货物 ×2（g 块尾+盒亡副本）+块收尾活动分配数回落基线（差 0）+值链。
类 货物 {
公开:
    字符串 名称;
    函数 货物(字符串 s) { 名称 = s; }
    不安全 函数 货物(货物& 其他) { 名称 = 字符串复制(其他.名称); }
    不安全 函数 ~货物() { 打印("~货物"); }
}
函数 主() -> 整32 {
    整64 基线 = 内存::活动分配数();
    {
        货物 g = 货物("甲甲甲甲甲甲甲甲甲甲");
        结果<货物, 整32> r = 正常(g);
        如果 (r.正常) {
            打印(r.值.名称);
        } 否则 {
            打印(r.错误);
        }
    }
    整64 收尾 = 内存::活动分配数();
    如果 (收尾 == 基线) { 打印("无泄漏"); }
    // 可选盒对照（收集面既有覆盖·零回归锚）
    {
        货物 s = 货物("乙乙乙乙乙乙乙乙乙乙");
        可选<货物> o = 某些(s);
        如果 (o.有值) { 打印(o.值.名称); }
    }
    整64 收尾2 = 内存::活动分配数();
    如果 (收尾2 == 基线) { 打印("双侧无泄漏"); }
    返回 0;
}
