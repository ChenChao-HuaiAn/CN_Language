// E2E 61_range_for：遍历...中每个 迭代语句（C-2，2026-08）
// 覆盖：数组迭代（值拷贝）、向量<T> 迭代（大小()/元素() 降级）、
//   迭代变量累加、继续 跳过、中断 提前退出、嵌套迭代（二维数组）、
//   结构体字段数组迭代、向量<字符串> 迭代
// 语法依据：C-2（对标 C++ range-for / Python for-in）——
//   遍历 容器 中 每个 元素 { 循环体 }；数组 -> 下标遍历；类容器 -> 大小()/元素(整64)

导入 容器::向量;

结构体 班级 {
    整32[3] 成绩;
}

函数 主() -> 整32 {
    打印("===== 遍历...中每个 迭代语句（C-2）=====");

    // 1. 数组迭代：打印每个元素（值拷贝）
    整32[5] 数据 = { 10, 20, 30, 40, 50 };
    遍历 数据 中 每个 x {
        打印(x);
    }

    // 2. 数组累加
    整32 总和 = 0;
    遍历 数据 中 每个 值 {
        总和 += 值;
    }
    打印("总和: ", 总和);

    // 3. 向量<整32> 迭代
    向量<整32> 数表 = 向量<整32>();
    结果<空类型, 整32> 增1 = 数表.追加(1);
    结果<空类型, 整32> 增2 = 数表.追加(2);
    结果<空类型, 整32> 增3 = 数表.追加(3);
    如果 增1.正常 && 增2.正常 && 增3.正常 {
        遍历 数表 中 每个 v {
            打印("向量: ", v);
        }
    } 否则 {
        打印("向量追加失败");
    }

    // 4. 向量<字符串> 迭代
    向量<字符串> 名字 = 向量<字符串>();
    结果<空类型, 整32> 增4 = 名字.追加("张三");
    结果<空类型, 整32> 增5 = 名字.追加("李四");
    如果 增4.正常 && 增5.正常 {
        遍历 名字 中 每个 名 {
            打印("名字: ", 名);
        }
    } 否则 {
        打印("名字追加失败");
    }

    // 5. 继续：跳过偶数（混合数组）
    整32[5] 混合 = { 1, 2, 3, 4, 5 };
    遍历 混合 中 每个 值 {
        如果 值 % 2 == 0 {
            继续;
        }
        打印("奇数: ", 值);
    }

    // 6. 中断：提前退出
    遍历 数据 中 每个 值 {
        如果 值 > 30 {
            中断;
        }
        打印("直到30: ", 值);
    }

    // 7. 嵌套迭代（结构体数组 -> 字段数组逐元素求和）
    班级[2] 各班 = { 班级{ 成绩 = { 60, 70, 80 } },
                     班级{ 成绩 = { 90, 91, 92 } } };
    整32 全体和 = 0;
    遍历 各班 中 每个 班 {
        遍历 班.成绩 中 每个 成绩 {
            全体和 += 成绩;
        }
    }
    打印("全体和: ", 全体和);

    // 8. 结构体字段数组迭代（成员访问迭代对象）
    班级 班 = 班级{ 成绩 = { 60, 70, 80 } };
    遍历 班.成绩 中 每个 成绩 {
        打印("成绩: ", 成绩);
    }

    打印("===== 遍历...中每个 测试完成 =====");
    返回 0;
}
