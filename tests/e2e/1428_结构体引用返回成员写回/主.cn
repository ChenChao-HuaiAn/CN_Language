// E2E 1428 结构体引用返回成员写回（任务 1260·1020 采样轮 P0）：
//   自由函数返回 结构体&（T&）绑定引用变量后，成员写/复合写/自增/链式写
//   均须落到被引用原对象（引用槽存被引用左值地址·禁 sret 值副本）。
//   根治前宿主：点& pr = 取点引用(p) 按值 sret 收副本缓冲——pr.x = 40 写副本
//   （打印(p.x)=4 不变·打印(pr.x)=40 自洽假绿）。双编译对照：v2 无同病，
//   两侧同源码编译运行逐行比对（宿主与 v2 零分叉门禁）。
结构体 点 {
    整32 x;
    整32 y;
}

函数 取点引用(点& p) -> 点& {
    返回 p;
}

不安全 函数 主() -> 整32 {
    点 p;
    p.x = 4;
    p.y = 9;
    // ① 直接成员写：绑定引用变量后写 x 须落 p（根治前写 sret 副本=4）
    点& pr = 取点引用(p);
    pr.x = 40;
    打印("成员写后p.x: ", p.x);
    打印("绑定读pr.x: ", pr.x);
    // ② 复合赋值：+= 须对原对象读改写（根治前在副本上读改写=45 丢）
    pr.x += 5;
    打印("复合写后p.x: ", p.x);
    // ③ 自增：++ 落原对象（根治前副本 y 9→10 丢）
    pr.y++;
    打印("自增后p.y: ", p.y);
    // ④ 链式：引用返回调用作成员写基座（根治前写 retbuf 临时=77 丢）
    取点引用(p).x = 77;
    打印("链式写后p.x: ", p.x);
    // 对照锚：标识符直接绑定引用（不走调用返回）本就正确，防修过扩
    点& pr2 = p;
    pr2.x = 88;
    打印("对照写后p.x: ", p.x);
    // 链式读锚（1274 回补·宿主 1260 emitRefReturnDeref 同位）：引用返回调用
    //   作成员链读基座——v2 修前无条件 LoadPtr 把聚合首 8 字节（x|y 拼合）当值
    //   读入·后续 .x 解引用 fault=0xA00000058（rc=-11）；修=结构体/数组 pointee
    //   豁免解引用·产物=被引用左值地址直通（成员链从地址+offset 消费）。
    打印("链式读p.x: ", 取点引用(p).x);
    打印("链式读p.y: ", 取点引用(p).y);
    // 链式读传参消费（聚合地址作实参·同豁免产物面）
    打印("总和: ", p.x + p.y);
    返回 0;
}
