导入 容器::向量;
导入 容器::{链表, 栈, 队列};

函数 主() -> 整32 {
向量<整64> 表 = 向量<整64>();
结果<空类型, 整32> 加 = 表.追加(1);
加 = 表.追加(3);
加 = 表.插入(1, 2);      // 在 1 和 3 之间插入 2
遍历 表 中 每个 x { 打印行(x, " "); }
打印("");
    返回 0;
}
