// T12 全矩阵探针：真值×消费位（台12 形态：三元包装/裸布尔/布尔变量/算术嵌入/条件位）
函数 取与(布尔 甲, 布尔 乙) -> 布尔
{
    返回 甲 && 乙;
}
函数 取或(布尔 甲, 布尔 乙) -> 布尔
{
    返回 甲 || 乙;
}
函数 取非(布尔 甲) -> 布尔
{
    返回 !甲;
}
函数 主() -> 整32
{
    布尔 甲 = 真;
    布尔 乙 = 假;
    // ① 布尔变量赋值（值位）
    布尔 P1 = 甲 && 乙;
    布尔 P2 = 真 && 真;
    布尔 P3 = 真 || 假;
    布尔 P4 = !甲;
    // ② 算术嵌入（值位）
    整32 N1 = (甲 && 乙) + 1;
    整32 N2 = (真 && 真) + 2;
    整32 N3 = (甲 || 乙) * 3;
    // ③ 三元包装（值位）
    整32 N4 = (甲 && 乙) ? 7 : 9;
    整32 N5 = (真 && 假) ? 7 : 9;
    // ④ 函数实参传递（布尔形参）
    布尔 P5 = 取与(甲, 乙);
    布尔 P6 = 取与(真, 真);
    布尔 P7 = 取或(真, 假);
    布尔 P8 = 取非(甲);
    // ⑤ 打印值位
    打印(P1);
    打印(P2);
    打印(P3);
    打印(P4);
    打印(P5);
    打印(P6);
    打印(P7);
    打印(P8);
    // ⑥ 条件位（复合）
    如果 (P5 && P6) { 打印(100); }
    如果 (P7 || P8) { 打印(200); }
    如果 (!(P1 && P2)) { 打印(300); }
    // ⑦ 布尔链与嵌套
    布尔 P9 = 甲 && 乙 || 真;
    布尔 P10 = (甲 && (乙 || 真)) && 真;
    打印(P9);
    打印(P10);
    返回 0;
}
