// E2E 936（2026-10-14·任务 #572 锁面·dual 正例）：移位结果窄域位模式对照——
//   001 §3.7a 窄域位模式面（#285 窄算术同族·850 dual 首跑实锤分叉）：窄操作数
//   移位结果按窄域位模式回绕（整8 1<<7 ≡ -128·宿主 emitShift 窄槽存回先例），
//   v2 原 377 尾部回窄与 474 检查码双排除移位=未窄化宽域值（128）分叉，本轮
//   对齐（生成表达式运算通道尾部回窄+检查码窄域双补）。形态矩阵：
//   整8/整16/整64/正8/正16 × 左移/右移 × 正/负初值 + 变量移位量窄域检查
//   （移位量 ≥ 窄位宽 → 错误码 8 终止·474 面·双侧同构）。
//   注：普通赋值形态「存8 = 甲8 << 7」宿主拒（移位结果语义类型=整32·
//   「整32→整8 隐式转换禁」）vs v2 赋值通道静默截断放行=另一分叉面
//   （普通算术同病·非移位特有）另行立案，不入本用例。
//   双编译对照：宿主与 v2 同源同测——输出逐行一致 + 退出码一致（1=错误码8 终止）。
函数 主() -> 整32 {
    // ---- 整8 左移（850 避开面的正面锁）----
    整8 甲8 = 1;
    打印(整32(甲8 << 7));      // -128（窄域回绕·位模式 0x80）
    整8 满8 = -128;
    打印(整32(满8 << 1));      // 0（0x100 截断 8 位）
    // ---- 整8 右移（算术右移·符号扩展）----
    整8 负8 = -1;
    打印(整32(负8 >> 3));      // -1
    打印(整32(满8 >> 7));      // -1
    // ---- 整16 ----
    整16 甲16 = 1;
    打印(整32(甲16 << 15));    // -32768
    整16 满16 = -32768;
    打印(整32(满16 << 1));     // 0（0x10000 截断 16 位）
    整16 负16 = -2;
    打印(整32(负16 >> 1));     // -1
    // ---- 整64（本宽型·语义锚）----
    整64 甲64 = 1;
    打印(甲64 << 63);          // -9223372036854775808
    整64 负64 = -1;
    打印(负64 >> 63);          // -1
    // ---- 正8（无符号窄·左移回绕+逻辑右移）----
    正8 高8 = 200;
    打印(整32(高8 << 1));      // 144（400 截断 8 位）
    打印(整32(高8 >> 2));      // 50（补零）
    正8 满8u = 255;
    打印(整32(满8u << 7));     // 128（32640 截断 8 位）
    // ---- 正16 ----
    正16 高16 = 40000;
    打印(整32(高16 << 1));     // 14464（80000 截断 16 位）
    打印(整32(高16 >> 1));     // 20000
    // ---- 变量移位量窄域检查（474·错误码 8 终止）----
    整8 移量8 = 8;
    打印(整32(甲8 << 移量8));  // → 运行时错误(错误码8): 溢出错误
    返回 0;
}
