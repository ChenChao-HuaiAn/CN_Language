// E2E 124：容器方法返回结构体的链式字段访问（宿主缺陷根治，2026-09-01）
// 缺陷：向量.元素(i).字段 链式读错值（lvalueAddress/memberObjStructType 不认 CallExpr
//   对象 -> 丢字段偏移 -> LoadPtr 读结构体首 8 字节拼合值）；两步写法一直正确。
// 修复：ir.cpp lvalueAddress 与 ir_expr.cpp visitMemberExpr 补 CallExpr 分支
//   （exprSrcType 解析返回类型；base=structReturn 隐藏返回缓冲基址，值即结构体地址）。
// 覆盖：链式读首字段(偏移0)/中字段(偏移8+4对齐)/末字段；嵌套链式算术参与；
//   返回结构体的普通函数 f().字段（同根因路径）；链式方法调用 元素(i).设置() 回归(118)。
// 成功路径逐项打印断言值（退出码 0）；断言失败提前返回 101~107
导入 容器::向量;

结构体 节点 {
    整32 类型;
    整32 文本;
    整64 附加;
    整32 子起点;
    整32 子终点;
}

结构体 点 {
    整64 x;
    整64 y;
}

函数 取点() -> 点 {
    点 p;
    p.x = 7;
    p.y = 9;
    返回 p;
}

函数 主() -> 整32 {
    向量<节点> 池 = 向量<节点>();
    整64 i = 0;
    当 (i < 20) {
        节点 n;
        n.类型 = 整32(i);
        n.文本 = 1;
        n.附加 = i;
        n.子起点 = 2;
        n.子终点 = 3;
        结果<空类型, 整32> 加 = 池.追加(n);
        i++;
    }
    // 链式读：首字段（偏移0）、中字段（偏移8，整64）
    如果 (池.元素(19).类型 != 19) { 返回 101; }
    如果 (池.元素(19).附加 != 19) { 返回 102; }
    // 链式读参与算术 + 末字段
    整64 和 = 池.元素(19).附加 + 池.元素(0).子终点;
    如果 (和 != 22) { 返回 103; }
    // 返回结构体的普通函数链式取字段（同根因路径）
    如果 (取点().x != 7) { 返回 104; }
    如果 (取点().y != 9) { 返回 105; }
    // 向量方法 设置(i, v) + 链式读回（容器方法路径回归）
    节点 新n;
    新n.类型 = 5;
    新n.文本 = 5;
    新n.附加 = 5;
    新n.子起点 = 5;
    新n.子终点 = 5;
    结果<空类型, 整32> 设 = 池.设置(0, 新n);
    如果 (!设.正常) { 返回 106; }
    如果 (池.元素(0).文本 != 5) { 返回 107; }
    打印("链式首字段: ", 池.元素(19).类型);
    打印("链式中字段: ", 池.元素(19).附加);
    打印("链式算术和: ", 和);
    打印("函数链式: ", 取点().x, " ", 取点().y);
    打印("设置后读回: ", 池.元素(0).文本);
    打印("大小: ", 池.大小());
    返回 0;
}
