// 410（304-a T26/B11 波次1 根治守护）：布尔短路值位+分支汇合读槽 -O3 矩阵
//   根因=GlobalValuePass 跨块线性序常量传播在多前驱汇合块失效——
//   未执行分支的常量 Store 覆盖执行分支的寄存器 Store → 汇合 Load 被错误折叠
//   （s2609179001~9003 实弹：假||假 O3 打印真）。根治=汇合块入口清空常量表。
//   B9 面扩散：布尔 ||/&&/三链/嵌套 + 整型 if/else 汇合（执行路径×两侧）。
函数 主() -> 整32 {
    打印("=== 布尔短路值位（汇合后经变量中转）===");
    布尔 甲 = 假;
    布尔 乙 = 假;
    布尔 丙 = 甲 || 乙;
    打印(丙);
    布尔 丁 = 真;
    布尔 戊 = 真;
    布尔 己 = 丁 && 戊;
    打印(己);
    布尔 庚 = 假;
    布尔 辛 = 庚 || 庚 || 庚;
    打印(辛);
    布尔 壬 = 真;
    布尔 癸 = 壬 || 假;
    打印(癸);
    布尔 子 = 假 && 真;
    打印(子);
    打印("=== 汇合值直接消费（无中转）===");
    打印(乙 || 甲);
    打印(丁 && 戊);
    打印("=== 整型分支汇合（执行路径=寄存器 Store 侧·修前折叠未执行侧常量）===");
    整32 t = 7;
    整32 x = 0;
    如果 (t > 3) { x = t; } 否则 { x = 1; }
    打印(x);
    如果 (t < 3) { x = t; } 否则 { x = 1; }
    打印(x);
    整64 大 = 0;
    如果 (t == 7) { 大 = 0 - 9223372036854775807LL; } 否则 { 大 = 5LL; }
    打印(大);
    打印("=== 嵌套汇合（汇合值作条件再汇合）===");
    整32 y = 0;
    如果 (丙) { y = 1; } 否则 { y = 2; }
    打印(y);
    布尔 混 = 丁 && (乙 || 假);
    如果 (混) { 打印("混真"); } 否则 { 打印("混假"); }
    // === i1 已分配寄存器路径（1267 余量·审查 P2-7；本用例 -O2 启用 RA）===
    //   已分配 i1 在寄存器内按 32 位规范承载（低 32 位 0/1、高 32 位清零）：
    //   整64(布尔) 恒 0/1；条件跳转直接 test 物理寄存器、不受高位影响。
    打印("=== i1 已分配路径（整64 规范化+条件跳转）===");
    布尔 比较真 = 3 > 1;
    布尔 比较假 = 3 < 1;
    打印(整64(比较真));
    打印(整64(比较假));
    布尔 非真 = !比较假;
    打印(整64(非真));
    布尔 逻辑与 = 比较真 && 非真;
    打印(整64(逻辑与));
    如果 (逻辑与) { 打印("跳转真"); } 否则 { 打印("跳转假"); }
    如果 (比较假) { 打印("跳转真"); } 否则 { 打印("跳转假"); }
    返回 0;
}
