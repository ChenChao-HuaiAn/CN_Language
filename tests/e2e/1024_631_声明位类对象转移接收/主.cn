// E2E 1024（2026-10-17 任务631）：声明位类对象转移接收——
//   「货架 甲 = 转移(乙)」拥有交接（真 move=句柄直存+源槽清零）；v2 原落
//   深拷通道：转移源壳连同字段资源成孤儿泄漏（残留 +2），宿主 0=对齐方向。
//   断言=循环 50 次分配数净 0 + 内容断言（甲 真接管乙资源）。
//   校验和折位：①1 —— 退出码 1=全对；泄漏=差值非 0=校验位丢失。
导入 容器::向量;

类 货架 {
公开:
    向量<字符串> 记录;
    函数 货架() { 记录 = 向量<字符串>(); }
    函数 ~货架() { }
    不安全 函数 货架(货架& 其他) { 记录 = 其他.记录; }
}

// ① 声明位 ← 转移(标识符)（货架 甲 = 转移(乙)）
函数 形一() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 轮 = 0;
    当 (轮 < 50) {
        货架 乙;
        结果<空类型, 整32> r1 = 乙.记录.追加(字符串复制("转移源资源载荷"));
        货架 甲 = 转移(乙);
        如果 (甲.记录.大小() != 1) { 返回 0; }
        轮++;
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 1;
}

函数 主() -> 整32 {
    整64 校验和 = 形一();
    如果 (校验和 == 1) {
        打印("声明位类对象转移接收：真move零泄漏");
    } 否则 {
        打印("声明位类对象转移接收：失败");
    }
    返回 整32(校验和);
}
