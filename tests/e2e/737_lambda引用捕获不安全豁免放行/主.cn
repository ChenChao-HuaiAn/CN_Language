// 737_lambda引用捕获不安全豁免放行（#435·001「[&] 引用捕获逃逸限制」负测
//   矩阵③·dual 正测）：不安全 函数 体内定义的引用捕获 lambda 免检（裁决乙·
//   责任上移——Rust unsafe 同款哲学·与 001 §1.1a④/不安全 函数 先例同构）：
//   逃逸悬垂的安全责任由程序员自担（审计面=不安全函数清单）。
//   运行断言=同帧定义+调用链输出正确（豁免不改变同帧语义——706/707 权料面）。
// 期望：42 / 7 / 7（打印 逐行·换行语义）
不安全 函数 采样() -> 整32 {
    变量 x = 40;
    变量 f = [&]() -> 整32 { 返回 x + 2; };
    返回 f();
}
函数 主() -> 整32 {
    打印(采样());
    变量 y = 6;
    变量 改y = [&]() -> 整32 {
        y = y + 1;
        返回 y;
    };
    打印(改y());
    打印(y);
    返回 0;
}
