// E2E 1543（1612 子项3）：字符串映射<V>.大小()——API 对称补齐验收。
//   背景：泛型 映射<K,V> 有 大小()（映射集合.cn 200 行）、集合<T> 有，
//   字符串映射 特化类（960 轮两步走第一步）独缺=API 不对称；1612 补齐
//   （常量 只读·返回 元素数量 字段·与泛型版同实现）。
//   判据：大小/设置/获取/包含/删除 全链逐值输出——空表/覆盖设置不增/
//   扩容重哈希守恒/删除生效与未命中/拷贝构造独立/V=字符串 值形态。
//   〔双侧〕宿主+v2p 双编译对照（stdlib 源码级加载·两侧同源同判）。
导入 映射集合;
不安全 函数 主() -> 整32 {
    // ---- 一、空表大小 ----
    字符串映射<整32> 表 = 字符串映射<整32>();
    打印(表.大小());
    // ---- 二、设置三键后大小 ----
    结果<空类型, 整32> s1 = 表.设置("甲", 1);
    如果 (!s1.正常) { 打印("设甲败"); 返回 1; }
    结果<空类型, 整32> s2 = 表.设置("乙", 22);
    如果 (!s2.正常) { 打印("设乙败"); 返回 1; }
    结果<空类型, 整32> s3 = 表.设置("丙", 333);
    如果 (!s3.正常) { 打印("设丙败"); 返回 1; }
    打印(表.大小());
    // ---- 三、获取逐值 ----
    结果<整32, 整32> g1 = 表.获取("甲");
    如果 (g1.正常) { 打印(g1.值); } 否则 { 打印("取甲败"); 返回 1; }
    结果<整32, 整32> g2 = 表.获取("乙");
    如果 (g2.正常) { 打印(g2.值); } 否则 { 打印("取乙败"); 返回 1; }
    结果<整32, 整32> g3 = 表.获取("丙");
    如果 (g3.正常) { 打印(g3.值); } 否则 { 打印("取丙败"); 返回 1; }
    // ---- 四、包含判定 ----
    打印(表.包含("甲"));
    打印(表.包含("丁"));
    // ---- 五、删除生效后大小 ----
    布尔 d1 = 表.删除("乙");
    如果 (d1) { 打印("删乙真"); }
    打印(表.大小());
    // ---- 六、删除不存在的键（大小不变） ----
    布尔 d2 = 表.删除("戊");
    如果 (!d2) { 打印("删戊假"); }
    打印(表.大小());
    // ---- 七、覆盖设置不增大小 ----
    结果<空类型, 整32> s4 = 表.设置("甲", 111);
    如果 (!s4.正常) { 打印("覆设败"); 返回 1; }
    打印(表.大小());
    结果<整32, 整32> g4 = 表.获取("甲");
    如果 (g4.正常) { 打印(g4.值); } 否则 { 打印("取覆败"); 返回 1; }
    // ---- 八、扩容重哈希面（15 键触发两轮翻倍）大小守恒 ----
    结果<空类型, 整32> e01 = 表.设置("k01", 101);
    结果<空类型, 整32> e02 = 表.设置("k02", 102);
    结果<空类型, 整32> e03 = 表.设置("k03", 103);
    结果<空类型, 整32> e04 = 表.设置("k04", 104);
    结果<空类型, 整32> e05 = 表.设置("k05", 105);
    结果<空类型, 整32> e06 = 表.设置("k06", 106);
    结果<空类型, 整32> e07 = 表.设置("k07", 107);
    结果<空类型, 整32> e08 = 表.设置("k08", 108);
    结果<空类型, 整32> e09 = 表.设置("k09", 109);
    结果<空类型, 整32> e10 = 表.设置("k10", 110);
    结果<空类型, 整32> e11 = 表.设置("k11", 111);
    结果<空类型, 整32> e12 = 表.设置("k12", 112);
    结果<空类型, 整32> e13 = 表.设置("k13", 113);
    结果<空类型, 整32> e14 = 表.设置("k14", 114);
    结果<空类型, 整32> e15 = 表.设置("k15", 115);
    如果 (!e15.正常) { 打印("扩容设败"); 返回 1; }
    打印(表.大小());
    布尔 d3 = 表.删除("k05");
    布尔 d4 = 表.删除("k10");
    布尔 d5 = 表.删除("k15");
    如果 (d3 && d4 && d5) { 打印("删三真"); }
    打印(表.大小());
    // ---- 九、拷贝构造独立（副本删不影响原表大小） ----
    字符串映射<整32> 副本 = 表;
    打印(副本.大小());
    布尔 d6 = 副本.删除("甲");
    如果 (d6) { 打印("副本删真"); }
    打印(副本.大小());
    打印(表.大小());
    // ---- 十、V=字符串 值形态 ----
    字符串映射<字符串> 名册 = 字符串映射<字符串>();
    打印(名册.大小());
    结果<空类型, 整32> n1 = 名册.设置("张三", "甲的内容串很长");
    如果 (!n1.正常) { 打印("设张三败"); 返回 1; }
    结果<空类型, 整32> n2 = 名册.设置("李四", "乙的内容串也很长");
    如果 (!n2.正常) { 打印("设李四败"); 返回 1; }
    打印(名册.大小());
    结果<字符串, 整32> 取名 = 名册.获取("李四");
    如果 (取名.正常 && 字符串比较(取名.值, "乙的内容串也很长")) { 打印("字符串值取对"); } 否则 { 打印("取李四败"); 返回 1; }
    返回 0;
}
