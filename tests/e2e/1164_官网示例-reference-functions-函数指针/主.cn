// 官网文档示例 · reference/functions.html · 函数指针与lambda（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
函数 加(整32 a, 整32 b) -> 整32 { 返回 a + b; }
函数 乘(整32 a, 整32 b) -> 整32 { 返回 a * b; }

函数 折叠(整32[3] 表, 整32(*二元)(整32, 整32)) -> 整32 {
    整32 累 = 表[0];
    循环 (整32 i = 1; i < 3; i++) { 累 = 二元(累, 表[i]); }
    返回 累;
}

函数 主() -> 整32 {
    整32[3] 表 = {2, 3, 4};
    打印(折叠(表, 加), " ", 折叠(表, 乘));
    变量 加倍 = [](整32 x) -> 整32 { 返回 x * 2; };   // lambda
    打印(加倍(21));
    返回 0;
}