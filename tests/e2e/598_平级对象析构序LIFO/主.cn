// E2E 598（#197·承接 #105 甲案已裁决·样本 p0930_03 v9 采样 2026-09-30 家机）：
//   同层平级类对象析构序 LIFO——规格 06「与C++同名构造/析构语义一致」
//   ＝构造逆序析构（栈式 RAII：后声明的先销毁）。
//   缺陷：析构两发射路径顺序不一致——函数级兜底 genClassDestructorCalls
//   按 Alloca 声明序正序发射（FIFO）vs 块出口 genBlockExitDestruct
//   （back() 逆序 LIFO）；凡函数层局部类对象经 返回 出函数即走前者=序错。
//   本例四形态全部期望 LIFO：
//     甲=函数层平级 3 对象（主缺陷面·宿主修前实得 D1D2D3）
//     乙=内层块平级对象自然退出（守护块出口 LIFO 路径·修前已对）
//     丙=混合层级（块先退·函数层后退·两路径序不互相污染）
//     丁=条件中途提前 返回（提前退出路径同享函数级兜底）
类 跟踪 {
公开:
    整32 编号;
    函数 跟踪(整32 n) {
        编号 = n;
        打印("C" + 整数转字符串(n));
    }
    函数 ~跟踪() {
        打印("D" + 整数转字符串(编号));
    }
}

函数 形态甲() -> 整32 {
    跟踪 a = 跟踪(1);
    跟踪 b = 跟踪(2);
    跟踪 c = 跟踪(3);
    打印("--甲体");
    返回 0;
}

函数 形态乙() -> 整32 {
    跟踪 g = 跟踪(7);
    {
        跟踪 h = 跟踪(8);
        打印("--乙内");
    }
    打印("--乙尾");
    返回 0;
}

函数 形态丙() -> 整32 {
    跟踪 i = 跟踪(9);
    {
        跟踪 j = 跟踪(10);
        打印("--丙内");
    }
    打印("--丙尾");
    返回 0;
}

函数 形态丁(整32 触发) -> 整32 {
    跟踪 k = 跟踪(11);
    跟踪 m = 跟踪(12);
    如果 (触发 == 1) {
        打印("--丁早退");
        返回 1;
    }
    打印("--丁尾");
    返回 0;
}

函数 主() -> 整32 {
    打印("--甲起");
    整32 r1 = 形态甲();
    打印("--乙起");
    整32 r2 = 形态乙();
    打印("--丙起");
    整32 r3 = 形态丙();
    打印("--丁起");
    整32 r4 = 形态丁(1);
    打印("r=" + 整数转字符串(r1) + 整数转字符串(r2) + 整数转字符串(r3) + 整数转字符串(r4));
    返回 0;
}
