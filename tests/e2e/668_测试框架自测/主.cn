// 668（冻结期生态任务 348·蓝图 plans/030 支柱二）：测试框架.cn 自测——
//   「用 CN 写 CN 的测试工具」自举 showcase：四用例（整数字符串浮点布尔断言
//   全过+一用例双断言故意失败）锁失败行格式/失败用例归并口径/汇总计数。
//   〔注〕框架计数走 测试器 成员方法（形态规避·021 #350 外部指针成员
//   算术读改写静默错值·arm64 宿主探针 p348a 实证）。
导入 测试框架::{测试器, 运行用例, 断言真, 断言假, 断言相等整数, 断言相等文本, 断言相等布尔, 断言不等整数, 断言近似, 测试汇总};

不安全 函数 用例整数(测试器* 器) {
    断言相等整数(器, 1 + 2, 3, "加法基本");
    断言不等整数(器, 1 + 2, 4, "加法不等");
}

不安全 函数 用例文本(测试器* 器) {
    断言相等文本(器, "你好", "你好", "文本相等");
    断言真(器, 字符串长度("你好") == 6, "UTF8 字节长");
    断言假(器, 1 == 2, "假断言");
}

不安全 函数 用例失败示范(测试器* 器) {
    断言真(器, 1 == 2, "故意失败·验证计数");
    断言相等整数(器, 5, 6, "故意失败二");
}

不安全 函数 用例浮点布尔(测试器* 器) {
    断言近似(器, 0.1 + 0.2, 0.3, 0.0000001, "浮点近似");
    断言相等布尔(器, 真, 真, "布尔相等");
}

不安全 函数 主() -> 整32 {
    测试器 器 = 测试器();
    运行用例(器, "整数", 用例整数);
    运行用例(器, "文本", 用例文本);
    运行用例(器, "失败示范", 用例失败示范);
    运行用例(器, "浮点布尔", 用例浮点布尔);
    整64 失败数 = 测试汇总(器);
    打印("汇总返回失败用例数=", 失败数);
    返回 0;
}
