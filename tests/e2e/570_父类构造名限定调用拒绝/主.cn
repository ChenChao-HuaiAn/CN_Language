// 任务 122 乙（928·用户裁决）：父类.构造名() 限定构造调用统一拒绝
// 修前：无参形态 父类.动物() 因 signatureKey 空参=纯名按名查找巧合命中可跑；
//       带参形态 父类.动物(n) 误报「类 '动物' 没有成员 '动物'」——两通道统一为
//       引导性诊断：父类构造须经初始化列表（: 动物(实参)）调用
// 规格锚：specs/06 §七——父类./自身. 限定仅用于方法与字段（2026-10-01 裁决增补）
// v2 侧（907）：父类.构造名() 经实例方法语义检查升级为与宿主同旨的「构造函数
//   不能经成员访问调用——父类构造须经初始化列表」语义诊断（两处各一行·行15/16）
//   + 语义错误中止（退出码 1·不产 asm）——两侧拒绝同旨，v2 期望锚同步（907 前
//   为 [ir2] 用户类无此方法 崩溃式拒绝）。
类 动物 {
公开:
    整32 腿数;
    函数 动物() { 腿数 = 4; }
    函数 动物(整32 n) { 腿数 = n; }
}
类 狗 : 动物 {
公开:
    函数 狗() { 父类.动物(); }
    函数 狗(整32 n) { 父类.动物(n); }
}
函数 主() -> 整32 {
    狗 a = 狗();
    狗 b = 狗(3);
    返回 0;
}
