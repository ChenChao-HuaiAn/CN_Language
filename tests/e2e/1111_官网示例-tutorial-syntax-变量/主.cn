// 官网文档示例 · tutorial-syntax.html · 变量（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
函数 主() -> 整32 {
    整32 甲 = 10;            // 显式类型
    变量 乙 = 20;            // 类型推断（= 整32）
    浮64 单价 = 9.5;
    布尔 通过 = 真;
    字符 等级 = '甲';        // Unicode 字符（4 字节码点）
    甲 = 甲 + 乙;            // 赋值
    打印(甲, " ", 单价, " ", 通过, " ", 等级);   // 字符按字符形态输出
    打印(整32(等级));            // 想看码点：显式 整32(c)
    返回 0;
}