// 探针 v11_08：定长数组作参数与返回（拷贝/塌缩面）
函数 总和(整32[4] a) -> 整32 {
    整32 s = 0;
    整32 i = 0;
    当 i < 4 { s += a[i]; i += 1; }
    返回 s;
}
函数 造表() -> 整32[3] {
    整32[3] r;
    r[0] = 5;
    r[1] = 6;
    r[2] = 7;
    返回 r;
}
函数 主() -> 整32 {
    整32[4] t;
    t[0] = 1;
    t[1] = 2;
    t[2] = 3;
    t[3] = 4;
    打印("sum=", 总和(t));
    整32[3] w = 造表();
    打印("w=", w[0], w[1], w[2]);
    返回 0;
}
