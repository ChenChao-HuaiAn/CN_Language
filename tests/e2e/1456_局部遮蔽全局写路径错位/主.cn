// E2E 1456_局部遮蔽全局写路径错位（#1337/#1338 锁用例·001 §遮蔽语义+§安全区）：
//   普通局部/参数遮蔽全局（顶层静态/裸全局）后的标识符写族——根治前写路径
//   isGlobalStatic 名字直查截胡（六处消费点）：直写/复合赋值/自增自减写全局
//   ?gstatic_ 槽而读走局部槽=读写错位静默错值（M1 打12得7/M4 得9/M5 得10）；
//   成员链写基址同病（M7 打0得5）；安全区「静态变量写」三挂点同判据误拦合法
//   局部写（#1338 编译不过）。根治=六处补局部优先守卫（读路径 85-a 同序）+
//   语义层安全区挂点 hitsNonStaticLocal 豁免（480 静态局部执法保持）。
//   断言失败返回 131~136；成功路径打印逐项值（退出码 0）。
结构体 盒 { 整32 v; }
盒 源盒;
静态 整32 静态顶层 = 5;
整32 裸全局 = 1;
不安全 函数 预热源盒() -> 空类型 {
    源盒.v = 9;   // 全局静态字段写（安全区执法面·不安全函数内合法）
}
函数 主() -> 整32 {
    预热源盒();
    // ① 直写遮蔽（裸全局被局部遮蔽·#1338 误拦解除后合法）
    整32 计数 = 7;
    计数 = 12;
    如果 (计数 != 12) { 返回 131; }
    // ② 复合赋值遮蔽
    整32 总量 = 9;
    总量 += 108;
    如果 (总量 != 117) { 返回 132; }
    // ③ 自增遮蔽
    整32 步进 = 10;
    步进 += 1;
    步进++;
    如果 (步进 != 12) { 返回 133; }
    // ④ 参数遮蔽（形参写=局部·全局不动）
    整32 r = 处理(10);
    如果 (r != 15) { 返回 134; }
    如果 (裸全局 != 1) { 返回 135; }
    // ⑤ 成员链写基址遮蔽（全局结构体被局部遮蔽后 字段写=局部）
    盒 源盒;
    源盒.v = 5;
    盒 目标;
    目标 = 源盒;
    如果 (目标.v != 5) { 返回 136; }
    打印(计数);
    打印(总量);
    打印(步进);
    打印(r);
    打印(目标.v);
    返回 0;
}
函数 处理(整32 全局值) -> 整32 {
    全局值 += 5;
    返回 全局值;
}
