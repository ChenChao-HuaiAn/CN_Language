// E2E 412（306-a 波次2 T4）：字符串下标越界检查——读路径插桩锚定
//   （变量 s[i] 直接下标/成员链 对象.字段[i]）。原实现无任何检查
//   （「越界由调用方约束」=与数组 rc=2 防线不对称·UB 读垃圾）；修后越界
//   走 __cn_runtime_error(2)（与数组同通道·O0=O3 双级别探针实测拦截）。
//   本用例锚定边界内合法读零误伤（插桩不改变合法语义）。
结构体 文档 {
    字符串 标题;
    整32 页数;
}
函数 主() -> 整32 {
    // 路径一：字符串变量直接下标
    字符串 s = "abc";
    打印(s[0]);
    打印(s[2]);
    // 路径二：成员链字符串字段下标
    文档 d;
    d.标题 = "xyz";
    打印(d.标题[1]);
    // 边界恰好：i = 长度-1 合法（越界面= i<0 或 i>=长度）
    打印(d.标题[2]);
    返回 0;
}
