//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
#定义 发布模式

函数 主() -> 整32 {
    // 1. #如果定义 / #否则：源内宏定义生效
    #如果定义 发布模式
    打印("发布模式: 开启");
    #否则
    打印("发布模式: 关闭");
    #结束如果

    // 2. 未定义宏的分支被裁剪——内含非法写法也不诊断
    #如果定义 不存在的宏
    这一段是非法语法：它不产生 token，也不参与解析
    #否则
    打印("未定义宏分支: 已裁剪");
    #结束如果

    // 3. 嵌套两层：父层被裁剪时内层恒假
    #如果定义 发布模式
    #如果定义 调试模式
    打印("内层: 调试");
    #否则
    打印("内层: 非调试");
    #结束如果
    #结束如果

    // 4. 括号形式与空白形式等价
    #如果定义(发布模式)
    打印("括号形式: 命中");
    #结束如果
    返回 0;
}