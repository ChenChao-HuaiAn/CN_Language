// 官网文档示例 · tutorial-oop.html · 运算符重载（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
类 复数 {
公开:
    浮64 实;
    浮64 虚;

    函数 复数(浮64 r, 浮64 i) { 实 = r; 虚 = i; }

    函数 运算符+(复数 右) -> 复数 {
        返回 复数(实 + 右.实, 虚 + 右.虚);
    }

    函数 运算符==(复数 右) -> 布尔 {
        返回 实 == 右.实 && 虚 == 右.虚;
    }
}

函数 主() -> 整32 {
    复数 a = 复数(1.0, 2.0);
    复数 b = 复数(3.0, 4.0);
    复数 c = a + b;          // 调用 运算符+
    打印(c.实, " ", c.虚, " ", a == b, " ", a + b == c);
    返回 0;
}