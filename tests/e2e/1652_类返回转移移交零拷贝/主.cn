// E2E 1652（任务 1820·丁案 R1③ 返回位 move/转移立法锁面·001 §5.3）：
//   「返回位 move/转移」——①返回局部类实例=转移（句柄直传·源不再析构·零拷贝）；
//   ②「返回 转移(局部)」显式转移作返回值=所有权移交，调用返回临时拥有性甄别
//   须归拥有（实参位/语句位登记释放）——修前甄别保守判借用 → 临时不释放，
//   每调用活动分配 +1（双侧同病·本任务根治）。分配次数断言口径（教训 #291：
//   双编译性能断言·优化=0/1+分配次数是唯一能让单侧少优化显形的抓手）。
导入 容器::向量;

类 货品 {
公开:
    向量<字符串> 记录;
    函数 货品() { 记录 = 向量<字符串>(); }
    函数 ~货品() { }
    不安全 函数 货品(货品& 其他) { 记录 = 其他.记录; }
}

// ① 返回局部=隐式转移（R1③）：句柄直传+源析构豁免（宿主 A-3b returnedVars
//   豁免兜底析构；v2 1818 源槽清零空安全跳过）——零拷贝零泄漏。
函数 造甲() -> 货品 {
    货品 甲;
    结果<空类型, 整32> 加 = 甲.记录.追加("甲");
    如果 (!加.正常) { 返回 甲; }
    返回 甲;
}

// ② 返回 转移(局部)=显式转移作返回值（R1③ 转移源）：甄别=拥有——本任务
//   修复面（修前每调用泄 1·探针 p1820 实录）。多返回点形态谱：if 分支返回+
//   落空路径返回（清零/豁免只发生在实际执行路径·互不误伤）。
函数 造乙() -> 货品 {
    货品 乙;
    结果<空类型, 整32> 加 = 乙.记录.追加("乙");
    如果 (!加.正常) { 返回 转移(乙); }
    返回 转移(乙);
}

// 借用形态对照（R1①② 已由 1817/1818 覆盖·回归保护）：返回形参=写穿别名
// → 返回位深拷副本（不触本任务转移面）。
函数 还货(货品 源) -> 货品 {
    返回 源;
}

函数 收(货品 货) -> 整32 {
    返回 整32(货.记录.大小());
}

函数 主() -> 整32 {
    // ① 返回局部转移：4 轮分配增量恒 0（零拷贝·源不二次析构）
    整64 基 = 内存::活动分配数();
    整32 和1 = 0;
    循环 (整32 i = 0; i < 4; i += 1) {
        和1 += 收(造甲());
    }
    打印(和1);                                        // 4（数据正确·转移不破值）
    打印(整64(内存::活动分配数() - 基));               // 0（零拷贝零泄漏）

    // ② 返回 转移(局部)：4 轮分配增量恒 0（修前 +4 线性泄漏·1820 修复锁面）
    整32 和2 = 0;
    循环 (整32 i = 0; i < 4; i += 1) {
        和2 += 收(造乙());
    }
    打印(和2);                                        // 4
    打印(整64(内存::活动分配数() - 基));               // 0

    // ③ 借用来源对照（返回形参=副本·R1②）：接收副本独立·写不穿源
    //   （该形态副本壳的 RAII 释放面=「用户浅拷拷构类」所有权模型深水区·
    //   1820 备案挂账呈报——分配守恒断言不锁，运行值锁接收独立语义）
    整32 和3 = 0;
    循环 (整32 i = 0; i < 4; i += 1) {
        货品 借 = 还货(造甲());
        和3 += 收(借);
    }
    打印(和3);                                        // 4

    // ④ 转移产物接收位：独立持有·字段写不写穿后续调用（活分配绝对值含
    //   收货存活资源=实现细节面·守恒断言由 ①② 循环口径承担）
    货品 收货 = 造乙();
    结果<空类型, 整32> 加丙 = 收货.记录.追加("丙");
    如果 (!加丙.正常) { 返回 1; }
    打印(整32(收货.记录.大小()));                      // 2
    打印(收(造乙()));                                  // 1（新调用不受收货影响）
    返回 0;
}
