导入 容器::向量;

函数 读首元素(常量 向量<整32>& 表) -> 整32 {
    结果<整32, 整32> 甲 = 表.读取(0);
    如果 甲.正常 {
        返回 甲.值;
    } 否则 {
        返回 -1;
    }
}
函数 主() -> 整32 {
    向量<整32> 表 = 向量<整32>();
    结果<空类型, 整32> 追加结果 = 表.追加(77);
    如果 追加结果.正常 {
        打印行(读首元素(表));
    } 否则 {
        打印行("追加失败");
    }
    返回 0;
}
