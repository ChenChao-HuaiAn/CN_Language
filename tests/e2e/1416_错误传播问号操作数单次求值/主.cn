// E2E 1416：错误传播运算符 ? 的操作数单次求值（#1173 宿主双求值根治）
//   语义（plans/001 §5.4 错误传播运算符）：表达式? 的操作数只求值一次——
//   正常 -> 取 .值 继续；失败 -> 构造错误结果并从当前函数返回（Rust ? 同语义）。
//   修复前宿主 visitUnaryExpr 入口与 Propagate 分支各发一次 genExpr：带副作用
//   操作数（调用打印/构造析构）执行两次；v2 恒单次。本用例锁定两侧一致。
// 覆盖形态：
//   ① 赋值位 `整32 值 = 内层(模式)?;`
//   ② 语句位 `内层(模式)?;`
//   ③ 返回位 `返回 正常(内层(模式)? + 5);`
//   ④ 嵌套链 `内层(内层(模式)?)?`（失败时外层不再调用=短路）
//   ⑤ 无副作用操作数对照：变量 `选?`、括号 `(选)?`、三元 `(条件 ? 甲 : 乙)?`
//   ⑥ 可选<T> 传播（某些/无）
//   ⑦ 错误路径短路：? 失败后同一函数后续语句不执行
//   ⑧ 分配计数：操作数调用内类局部 构造/析构 各恰一次（CD 配对·无重复释放）

类 资源 {
公开:
    整32 号;
    函数 资源(整32 v) { 号 = v; 打印("C", 号, ";"); }
    不安全 函数 ~资源() { 打印("D", 号, ";"); }
}

函数 内层(整32 模式) -> 结果<整32, 整32> {
    资源 本 = 资源(模式);
    打印("I", 模式, ";");
    如果 (模式 == 0) {
        返回 错误(9);
    }
    返回 正常(3);
}

函数 赋值位(整32 模式) -> 结果<整32, 整32> {
    整32 值 = 内层(模式)?;
    打印("后续", 模式, ";");
    返回 正常(值 + 1);
}

函数 语句位(整32 模式) -> 结果<整32, 整32> {
    内层(模式)?;
    打印("S", 模式, ";");
    返回 正常(100);
}

函数 返回位(整32 模式) -> 结果<整32, 整32> {
    返回 正常(内层(模式)? + 5);
}

函数 嵌套位(整32 模式) -> 结果<整32, 整32> {
    整32 值 = 内层(内层(模式)?)?;
    返回 正常(值);
}

// 无副作用操作数：变量与括号形态；失败时后续语句不执行（值2 不可达）
函数 纯位(整32 模式) -> 结果<整32, 整32> {
    结果<整32, 整32> 甲 = 正常(7);
    结果<整32, 整32> 乙 = 错误(4);
    结果<整32, 整32> 选 = (模式 == 0 ? 乙 : 甲);
    整32 值 = 选?;
    整32 值2 = (选)?;
    返回 正常(值 + 值2);
}

// 三元表达式直接作 ? 操作数（无调用副作用）
函数 三元位(整32 模式) -> 结果<整32, 整32> {
    结果<整32, 整32> 甲 = 正常(8);
    结果<整32, 整32> 乙 = 错误(6);
    整32 值 = (模式 == 0 ? 乙 : 甲)?;
    返回 正常(值);
}

函数 可选内层(整32 模式) -> 可选<整32> {
    打印("O", 模式, ";");
    如果 (模式 == 0) {
        返回 无;
    }
    返回 某些(4);
}

函数 可选位(整32 模式) -> 可选<整32> {
    整32 值 = 可选内层(模式)?;
    返回 某些(值 + 1);
}

函数 显示(字符串 名, 结果<整32, 整32> r) {
    如果 (r.正常) {
        打印(名, "T", r.值, ";");
    } 否则 {
        打印(名, "F", r.错误, ";");
    }
}

函数 显示可选(字符串 名, 可选<整32> r) {
    如果 (r.有值) {
        打印(名, "T", r.值, ";");
    } 否则 {
        打印(名, "F;");
    }
}

函数 主() -> 整32 {
    显示("赋值", 赋值位(1));
    显示("赋值", 赋值位(0));
    显示("语句", 语句位(1));
    显示("语句", 语句位(0));
    显示("返回", 返回位(1));
    显示("返回", 返回位(0));
    显示("嵌套", 嵌套位(1));
    显示("嵌套", 嵌套位(0));
    显示("纯", 纯位(1));
    显示("纯", 纯位(0));
    显示("三元", 三元位(1));
    显示("三元", 三元位(0));
    显示可选("可选", 可选位(1));
    显示可选("可选", 可选位(0));
    返回 0;
}
