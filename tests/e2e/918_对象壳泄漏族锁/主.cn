// E2E 918（任务 543·对象壳泄漏族根治锁·双编译对照）：459 批甲「临时合流计数」
//   实证暴露的壳泄漏族修复面锁定——每形态 块出口 活动分配数 差值==0 且内容
//   正确置位，退出码=校验和 15。
//   〔检测面注记〕对象壳（__cn_object_new/delete 路径）暂不进 活动分配数 计数
//   （459 评估定案·API 面另案裁决中）——本用例断言口径=容器**数据层**（malloc
//   路径·计数在册）：①构造内字段容器覆盖须漏「级联壳+其数据」双份方可检出，
//   故 形态①③ 用「覆盖有数据旧容器」形态（数据层必漏=门禁替你记得）；壳级
//   断言随计数合流（459 批甲第二步）自动获得壳级检测力。形态④ 无析构类壳释放
//   （宿主 DeleteObject 只 free 不调 ~·v2 类有析构分派三后端同款）同上。
导入 容器::向量;
导入 IO::打印;
类 无架 {
公开:
    整64 编号;
    函数 无架() { 编号 = 0; }
}
类 货架 {
公开:
    向量<字符串> 记录;
    函数 货架() { 记录 = 向量<字符串>(); }
    函数 ~货架() { }
    不安全 函数 货架(货架& 其他) { 记录 = 其他.记录; }
    // ① 成员函数内字段容器赋值覆盖（543 宿主修复面：handleClassFieldAssign/
    //    memberClassFieldAssign 撤 145-a 构造内跳过·v2 生成语句赋值 843-a 同批）
    函数 重置() -> 空类型 {
        记录 = 向量<字符串>();
    }
}
静态 货架 架乙 = 货架();
不安全 函数 静态重置() -> 空类型 {
    架乙.重置();
}
函数 主() -> 整32 {
    整64 校验 = 0;
    // ① 字段容器覆盖有数据旧值×N（宿主 preFree/v2 843-a 数据层锁）
    整64 b1 = 内存::活动分配数();
    {
        货架 甲;
        结果<空类型, 整32> r0 = 甲.记录.追加(字符串复制("占位内容甲"));
        整32 i = 0;
        当 (i < 4) {
            甲.重置();
            i = i + 1;
        }
        打印("① 大小: ", 甲.记录.大小());
    }
    如果 (内存::活动分配数() - b1 == 0) { 校验 = 校验 + 1; }
    // ② 局部对象赋值覆盖×4（719④/095 面·数据层锁）
    整64 b2 = 内存::活动分配数();
    {
        货架 甲2;
        结果<空类型, 整32> r1 = 甲2.记录.追加(字符串复制("占位内容乙"));
        货架 乙2;
        整32 j = 0;
        当 (j < 4) {
            乙2 = 甲2;
            j = j + 1;
        }
        打印("② 大小: ", 乙2.记录.大小());
    }
    如果 (内存::活动分配数() - b2 == 0) { 校验 = 校验 + 2; }
    // ③ 成员链右值字段赋值（v2 836-a 面·数据层锁）
    整64 b3 = 内存::活动分配数();
    {
        货架 源;
        结果<空类型, 整32> r2 = 源.记录.追加(字符串复制("占位内容丙"));
        货架 目;
        目.记录 = 源.记录;
        打印("③ 大小: ", 目.记录.大小(), " 源: ", 源.记录.大小());
    }
    如果 (内存::活动分配数() - b3 == 0) { 校验 = 校验 + 4; }
    // ④ 无析构类对象作用域退出+赋值覆盖（v2 类有析构分派/宿主只 free·壳层）
    整64 b4 = 内存::活动分配数();
    {
        无架 a;
        无架 b;
        b = a;
        打印("④ ok");
    }
    如果 (内存::活动分配数() - b4 == 0) { 校验 = 校验 + 8; }
    返回 整32(校验);
}
