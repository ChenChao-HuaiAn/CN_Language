// 392_浮点恒等转换四形态（274-a T15 残余面根治锚定·双级别目录见 393）
//   形态一：浮64 恒等转换套运行时计算（T15 立案形态——修前双级别 7.000001
//           =恒等 Cast(f64,f64) 误走 cvtsd2ss 单精度舍入+槽残留）
//   形态二：浮32 恒等转换（修前 else 分支把 f32 槽当 double 读再舍入）
//   形态三：真降精度 f64→f32（合法窄化·须保留单精度舍入——家机 272-a 语义面）
//   形态四：整→浮真转换（保留·T14 270-a 已修面哨兵）
函数 取64(浮64 v) -> 浮64 {
    返回 v;
}
函数 取32(浮32 v) -> 浮32 {
    返回 v;
}
函数 主() -> 整32 {
    打印("一=", 浮64(取64(7.0) - 取64(7.0) + 7));
    打印("二=", 浮32(取32(浮32(2.5)) + 浮32(1.0)));
    打印("三=", 浮32(取64(7.5)));
    打印("四=", 浮64(7));
    返回 0;
}
