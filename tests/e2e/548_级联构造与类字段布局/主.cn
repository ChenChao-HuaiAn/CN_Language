// 548 级联构造与类字段布局（058 挂账①②收口转正·860 轮）：
//   挂账①=全局口径：类/结构体的类字段=句柄 8/8（宿主 computeLayout/
//   computeClassLayout/classFieldOffset 三点+v2 解析层两点——布局与运行时
//   内容一致，相邻字段不再覆写句柄高 4 字节）；
//   挂账②=字段级联构造（H7 字段版）：类构造函数序言对「有默认构造」类字段
//   NewObject+默认构造（宿主 injectFieldCascadeConstruct·析构级联对称）；
//   结构体无初始化器声明对闭合域字段（有析构∧有拷贝构造∧有默认构造）级联
//   （=资源字段收集域，拷贝/释放链闭合）。治理前：类版 rc=139 空句柄解引、
//   结构体版 rc=1 空指针解引。
类 内层 {
    公开:
    整32 x;
    函数 内层() { x = 7; }
}
类 外层 {
    公开:
    内层 内;
    整32 y;
    函数 外层() { y = 3; }
}
类 盒子 {
    公开:
    整32 值;
    函数 盒子() { 值 = 5; }
    函数 盒子(盒子& 其他) { 值 = 其他.值; }
    函数 ~盒子() { }
}
结构体 S {
    盒子 b;
    整32 x;
}
函数 主() -> 整32 {
    // 形态①：类含类字段级联构造（治理前 rc=139：o.内=空句柄）
    外层 o;
    打印行("y=", o.y);
    打印行("内.x=", o.内.x);
    // 形态②：类字段布局句柄口径（内@0 8B + y@8——y 不再覆写句柄高 4 字节）
    o.y = 30;
    打印行("改后 内.x=", o.内.x);
    // 形态③：结构体含类字段·闭合域级联（治理前 rc=1：s.b=空句柄）
    S s;
    s.x = 9;
    打印行("s.b.值=", s.b.值);
    打印行("s.x=", s.x);
    // 形态④：结构体拷贝=闭合域深拷（postCopy 指针槽深拷——副本独立）
    S t = s;
    t.x = 90;
    打印行("t.b.值=", t.b.值);
    打印行("t.x=", t.x);
    打印行("源 s.x 仍=", s.x);
    返回 0;
}
