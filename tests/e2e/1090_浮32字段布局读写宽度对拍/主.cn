// E2E 1090（#1033·2026-10-17）：浮32 字段布局/读写宽度零分叉（dual·同测同期望）
//   修前（v2）：类型大小与对齐 / 类型宽度码 缺 浮32 分支（落 T_浮64/未知 8 字节档）
//   ——{浮32;浮32} 类型大小 v2=16（宿主 8·857 探针实证）、字段/数组步进 8 字节、
//   数组 浮32[3] 总大小 24（宿主 12）、混排 {整8;浮32;整64} 大小 24（宿主 16）：
//   布局表（大小/对齐/字段偏移）是局部槽/参数槽/数组步进/深拷公共数据源，一处
//   错全链错。修后：布局 4/4（整32 同档）+ 读写宽度 T_浮32 dword 分派（宿主
//   typeSizeOf/typeAlignOf 浮32=4/4 与 LoadPtr/StorePtr f32 movss 同宽·逐字节
//   零分叉）。
//   形态矩阵：①基本对 大小+字段读写 ②混排对齐填充 ③浮32+整32 混合字段
//   ④嵌套结构体传染 ⑤数组步进+下标读写 ⑥类实例字段 ⑦邻槽哨兵不穿写
//   ⑧负数/半值位模式。两侧各编各跑，运行输出逐行全等（断言输出=是·锚值=宿主实测）。
结构体 半对 { 浮32 甲; 浮32 乙; }
结构体 混排半 { 整8 标; 浮32 半; 整64 大; }
结构体 半尾 { 浮32 半; 整32 尾; }
结构体 嵌套 { 半对 内; 整64 尾; }
类 点子 {
公开:
    浮32 x;
    浮32 y;
    函数 点子() { x = 浮32(0.0); y = 浮32(0.0); }
}

不安全 函数 主() -> 整32 {
    // ① 基本对：大小/字段读写
    打印("半对大小: ", 类型大小(半对));
    半对 a;
    a.甲 = 浮32(1.5);
    a.乙 = 浮32(2.5);
    打印("a甲: ", a.甲);
    打印("a乙: ", a.乙);
    // ② 混排对齐填充（整8@0 浮32@4 整64@8 大小16）
    打印("混排半大小: ", 类型大小(混排半));
    混排半 m;
    m.标 = 7;
    m.半 = 浮32(4.25);
    m.大 = 888;
    打印("m标: ", m.标);
    打印("m半: ", m.半);
    打印("m大: ", m.大);
    // ③ 浮32+整32 混合字段（浮32@0 整32@4 大小8）
    打印("半尾大小: ", 类型大小(半尾));
    半尾 w;
    w.半 = 浮32(3.25);
    w.尾 = 777;
    打印("w半: ", w.半);
    打印("w尾: ", w.尾);
    // ④ 嵌套结构体传染（内@0 尾@8 大小16）
    打印("嵌套大小: ", 类型大小(嵌套));
    嵌套 n;
    n.内.甲 = 浮32(6.5);
    n.内.乙 = 浮32(7.5);
    n.尾 = 999;
    打印("n内甲: ", n.内.甲);
    打印("n内乙: ", n.内.乙);
    打印("n尾: ", n.尾);
    // ⑤ 数组步进（浮32[3] 大小 12）+ 下标读写 + 前后哨兵
    打印("数组大小: ", 类型大小(浮32[3]));
    整64 前哨 = 111;
    浮32[3] 表;
    表[0] = 浮32(0.5);
    表[1] = 浮32(1.5);
    表[2] = 浮32(2.5);
    打印("表0: ", 表[0]);
    打印("表1: ", 表[1]);
    打印("表2: ", 表[2]);
    整64 后哨 = 222;
    打印("前哨: ", 前哨);
    打印("后哨: ", 后哨);
    // ⑥ 类实例字段（x@0 y@4 对象大小8）
    打印("点子大小: ", 类型大小(点子));
    点子 p = 点子();
    p.x = 浮32(8.5);
    p.y = 浮32(9.5);
    打印("p x: ", p.x);
    打印("p y: ", p.y);
    // ⑦ 结构体数组元素步进（半对[2]: 元素8 总16）+ 元素字段读写
    半对[2] 组;
    组[0].甲 = 浮32(10.5);
    组[0].乙 = 浮32(11.5);
    组[1].甲 = 浮32(12.5);
    组[1].乙 = 浮32(13.5);
    打印("组0甲: ", 组[0].甲);
    打印("组0乙: ", 组[0].乙);
    打印("组1甲: ", 组[1].甲);
    打印("组1乙: ", 组[1].乙);
    打印("组大小: ", 类型大小(半对[2]));
    // ⑧ 负数/半值位模式
    半对 f;
    f.甲 = 浮32(-1.5);
    f.乙 = 浮32(0.25);
    打印("f甲: ", f.甲);
    打印("f乙: ", f.乙);
    返回 0;
}
