// E2E 238（2026-09-12 第八十四轮，plans/020 移植纪律 9 门禁化·第十个对照用例）：
//   **结构体字面量作实参**——同一份源码经宿主真实管线与 v2 自举链各编译运行，
//   两侧退出码须相等。
//   背景（84-a，探针 P23）：v2 的结构体字面量原仅「解析期脱糖」（声明/赋值/成员赋值
//   三位），**表达式/实参位解析失败**（`[parse] 语句缺少分号` → 中止不产 asm）。
//   修复=新节点 `节点_结构体构造`/`节点_字段初值`（表达式位的字面量值）+ IR 侧
//   `生成结构体构造`（临时槽 + 零初始化 + 逐字段写，槽地址压栈；槽分配纪律四条与
//   实参清理复用 82-a 机制）。
//   八形态（两侧共有语义面）：
//     ① 普通函数字面量实参（字符串+整数字段内容校验）
//     ② 容器方法字面量实参（元素内容守恒）
//     ③ 混合实参（标识符 + 字面量）
//     ④ 字面量字段值=调用返回（`盒子{ 名 = 字符串复制("…"), 号 = 造号() }`）
//     ⑤ 循环 20 万轮（字面量入容器）+ 残留归零
//     ⑥ 字面量 + 容器 删除/设置（槽复用）组合
//     ⑦ 双字面量实参（`取两盒(盒子{...}, 盒子{...})`）
//     ⑧ 字面量实参块出口残留归零（临时槽串字段清理）
//   校验和折位：①1 ②2 ③4 ④8 ⑤16 ⑥32 ⑦64 ⑧128 —— 255=全对。
//   两侧任一形态的解析/生成机制分叉（解析失败/字段错位/临时槽泄漏）→ 该校验位丢失
//   → 退出码变化 → 对照失败。平台守卫=linux 双平台（宿主与 v2 同链）。
导入 容器::向量;

结构体 盒子 {
    字符串 名;
    整32 号;
}

函数 取号(盒子 箱) -> 整32 {
    返回 箱.号;
}

函数 造号() -> 整32 {
    返回 44;
}

函数 取两号(盒子 甲, 盒子 乙) -> 整64 {
    如果 (甲.号 == 7 && 乙.号 == 8) { 返回 1; }
    返回 0;
}

// ① 普通函数字面量实参
函数 形一() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        盒子 收 = 盒子{ 名 = 字符串复制("形一字面量内容甲乙丙丁戊己"), 号 = 1 };
        如果 (取号(盒子{ 名 = 字符串复制("形一字面量内容甲乙丙丁戊己"), 号 = 1 }) == 1) { 校验 = 1; }
        如果 (!字符串比较(收.名, "形一字面量内容甲乙丙丁戊己")) { 校验 = 0; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验;
}

// ② 容器方法字面量实参（元素内容守恒）
函数 形二() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        向量<盒子> 表 = 向量<盒子>();
        结果<空类型, 整32> 加 = 表.追加(盒子{ 名 = 字符串复制("形二容器字面量内容甲乙丙"), 号 = 2 });
        如果 (!加.正常) { 返回 0; }
        盒子 读 = 表.元素(0);
        如果 (读.号 == 2 && 字符串比较(读.名, "形二容器字面量内容甲乙丙")) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 2;
}

// ③ 混合实参（标识符 + 字面量）
函数 形三() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        盒子 甲 = 盒子{ 名 = 字符串复制("形三甲内容甲乙丙丁戊己庚辛"), 号 = 7 };
        如果 (取两号(甲, 盒子{ 名 = 字符串复制("形三乙内容甲乙丙丁戊己庚辛"), 号 = 8 }) == 1) { 校验 = 1; }
        如果 (甲.号 != 7) { 校验 = 0; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 4;
}

// ④ 字面量字段值=调用返回
函数 形四() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        如果 (取号(盒子{ 名 = 字符串复制("形四字段调用内容甲乙丙丁戊己"), 号 = 造号() }) == 44) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 8;
}

// ⑤ 循环 20 万轮（字面量入容器）+ 残留归零
函数 形五(整64 轮数) -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 i = 0;
    当 (i < 轮数) {
        向量<盒子> 表 = 向量<盒子>();
        结果<空类型, 整32> 加 = 表.追加(盒子{ 名 = 字符串复制("形五循环字面量内容甲乙丙"), 号 = 5 });
        如果 (!加.正常) { 返回 0; }
        盒子 读 = 表.元素(0);
        如果 (读.号 != 5) { 返回 0; }
        i++;
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 16;
}

// ⑥ 字面量 + 容器 删除/设置（槽复用）组合
函数 形六() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        向量<盒子> 表 = 向量<盒子>();
        结果<空类型, 整32> 加1 = 表.追加(盒子{ 名 = 字符串复制("形六甲内容甲乙丙丁戊己庚辛"), 号 = 61 });
        结果<空类型, 整32> 加2 = 表.追加(盒子{ 名 = 字符串复制("形六乙内容甲乙丙丁戊己庚辛"), 号 = 62 });
        如果 (!加1.正常 || !加2.正常) { 返回 0; }
        结果<空类型, 整32> 删 = 表.删除(0);
        如果 (!删.正常) { 返回 0; }
        结果<空类型, 整32> 设 = 表.设置(0, 盒子{ 名 = 字符串复制("形六丙内容甲乙丙丁戊己庚辛"), 号 = 63 });
        如果 (!设.正常) { 返回 0; }
        盒子 读 = 表.元素(0);
        如果 (读.号 == 63) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 32;
}

// ⑦ 双字面量实参
函数 形七() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        如果 (取两号(盒子{ 名 = 字符串复制("形七甲内容甲乙丙丁戊己庚辛"), 号 = 7 },
                    盒子{ 名 = 字符串复制("形七乙内容甲乙丙丁戊己庚辛"), 号 = 8 }) == 1) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 64;
}

// ⑧ 字面量实参块出口残留归零（临时槽串字段清理）
函数 形八() -> 整64 {
    整64 前 = 内存::活动分配数();
    整64 校验 = 0;
    {
        向量<盒子> 表 = 向量<盒子>();
        结果<空类型, 整32> 加 = 表.追加(盒子{ 名 = 字符串复制("形八字面量内容甲乙丙丁戊己"), 号 = 80 });
        如果 (!加.正常) { 返回 0; }
        盒子 读 = 表.元素(0);
        如果 (读.号 == 80) { 校验 = 1; }
    }
    如果 (内存::活动分配数() != 前) { 返回 0; }
    返回 校验 * 128;
}

函数 主() -> 整32 {
    整64 和 = 0;
    和 = 和 + 形一();
    和 = 和 + 形二();
    和 = 和 + 形三();
    和 = 和 + 形四();
    和 = 和 + 形五(200000);
    和 = 和 + 形六();
    和 = 和 + 形七();
    和 = 和 + 形八();
    返回 整32(和);
}
