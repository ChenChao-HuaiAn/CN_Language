// E2E 1650（#1819·1784 丁案实施④·dual）：容器入元素类切片拒绝——
//   派生类值实参经 向量<基>.追加(派实例) 入基类元素槽=值拷贝切片本体
//   （001 §5.3 丁案·多态一律 T& 禁切片·编译期拒+诊断指路 T&）。
//   基 定义拷贝构造（泛型实例化体 复制 合法面——聚焦实参切片诊断本体；
//   无拷构容器入同型元素由 640 锁面）。多态需求=向量<基&>/基* 通道
//   （616 正测·指针/引用形态不误伤）。
//   预期失败:诊断锚「禁止类切片」(宿主/v2 双侧同文案)。
导入 容器::向量;
类 基 {
公开:
    整32 甲;
    函数 基() { 甲 = 1; }
    不安全 函数 基(基& 其他) { 甲 = 其他.甲; }
}
类 派 : 基 {
公开:
    整32 乙;
    函数 派() { 乙 = 2; }
}
不安全 函数 主() -> 整32 {
    向量<基> 表 = 向量<基>();
    派 p = 派();
    结果<空类型, 整32> 压 = 表.追加(p);
    如果 (!压.正常) { 返回 1; }
    返回 0;
}
