// 545（850 轮·任务 072 实施转正）：arm64 整128 负值物化符号扩展（静默错值+控制流污染）
//   背景：arm64 emitCast 整→i128 对 i32 源经 ldr w9 零扩展读回——负值符号位丢失
//   （低半=零扩展错值 + 高半 asr 63 得 0 应 -1 + n<0 判定翻转=控制流污染·违双目标②）；
//   x64l 同位有 movsxd 先例（324-c/287-a）=后端不对称。修复=sxtw x9, w9。
//   形态用静态变量中转构造运行期值（折叠免疫：O2 无全局值传播·物化路径必触发
//   ——O0/O2 同测；原样本常量表达式 0-100 在 O2 被折叠=巧合正确家族·不入门禁）。
//   覆盖：①负表达式→局部 128 ②128 负值判定 ③字段 128 ④实参/返回 128。
//   位宽矩阵 整8/16/32/64 全好（表达式整体在自身位宽域·64 位域免疫）不入本用例。
静态 整32 百 = 100;
静态 整32 七 = 7;
静态 整32 九 = 9;
静态 整32 六 = 6;

结构体 盒
{
    整128 大;
}

函数 吃(整128 入) -> 整128 { 返回 入; }

函数 主() -> 整32
{
    整128 t = 0 - 百;
    打印行("t=", t);
    打印("");
    整32 n = 0 - 七;
    整32 位 = 0;
    如果 (n < 0) { 位 = 1; }
    如果 (t < 0) { 位 = 位 + 2; }
    打印行("位=", 位);
    打印("");
    盒 h = 盒{ 大 = 0 - 九 };
    打印行("字段:", h.大);
    打印("");
    打印行("实参:", 吃(0 - 六));
    打印("");
    返回 0;
}
