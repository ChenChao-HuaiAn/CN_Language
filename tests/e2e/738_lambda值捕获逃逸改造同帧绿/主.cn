// 738_lambda值捕获逃逸改造同帧绿（#435·001「[&] 引用捕获逃逸限制」负测
//   矩阵④⑤·dual 正测）：735 逃逸面改 [=] 值捕获快照后编译绿（值捕获不受
//   逃逸限制·快照语义无悬垂面——001 条文④）；同帧调用输出正确。
//   [变量] 显式捕获同面（720 权料·本例复验 [=] 快照读定义时值）。
// 期望：42 / 60（打印 逐行·换行语义）
函数 采样() -> 整32 {
    变量 x = 40;
    变量 f = [=]() -> 整32 { 返回 x + 2; };
    x = 0;
    返回 f();
}
函数 主() -> 整32 {
    打印(采样());
    变量 基 = 50;
    变量 g = [基]() -> 整32 { 返回 基 + 10; };
    基 = 0;
    打印(g());
    返回 0;
}
