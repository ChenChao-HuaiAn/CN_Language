// 域E 高难（678·#374 转正·原 c359 探针）：结果<可选<整32>,整32> 双层拆包（081 族邻域）
函数 层(整32 x) -> 结果<可选<整32>, 整32> {
    如果 (x < 0) {
        返回 错误(9);
    }
    如果 (x == 0) {
        返回 正常(无);
    }
    返回 正常(某些(x));
}
函数 主() -> 整32 {
    结果<可选<整32>, 整32> r = 层(5);
    如果 (r.正常) {
        如果 (r.值.有值) { 打印行(r.值.值); } 否则 { 打印行(0); }
    } 否则 { 打印行(0 - r.错误); }
    结果<可选<整32>, 整32> a = 层(0);
    如果 (a.正常) {
        如果 (a.值.有值) { 打印行(1); } 否则 { 打印行(0); }
    } 否则 { 打印行(0 - a.错误); }
    结果<可选<整32>, 整32> b = 层(-1);
    如果 (b.正常) { 打印行(100); } 否则 { 打印行(b.错误); }
    返回 0;
}
