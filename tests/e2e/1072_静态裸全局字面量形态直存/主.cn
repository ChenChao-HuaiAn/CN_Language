// E2E 1072（2026-10-17·任务 #790·569 采样轮 H1）：顶层静态/裸全局 整数字面量
//   进制/后缀形态槽直存数值化——0x/0b/0o/L 后缀四形态原以原文透传 .data 直存
//   被三平台汇编器拒绝（win MASM `dq 0xFF` A2206 / `dq 111111111111L` A2048·
//   linux GAS `.quad ...L` 同病）；修后编译期数值化为规范十进制直存。
//   锁面=顶层静态/裸全局（本任务双断点）+ 函数内静态/类静态字段（同通道顺锁）；
//   双编译对照：宿主+v2p 各编各跑输出逐行全等（断言输出=是），断言全等返回 0。
静态 整64 静十六 = 0xFF;                    // 255
静态 整64 静二进 = 0b1010;                  // 10
静态 整64 静八进 = 0o777;                   // 511
静态 整64 静后缀 = 111111111111L;           // 111111111111
静态 整64 静全宽 = 0x7FFFFFFFFFFFFFFF;      // 2^63-1（16 位 hex 全宽）
静态 正64 静全宽64 = 0xFFFFFFFFFFFFFFFF;    // u64 全宽（原值级 stoll 回 0 隐患面）
静态 整128 静百 = 0xFF;                     // 128 槽 ≤u64 值（数值化→128 双 quad 通道）
静态 整64 静最小 = -9223372036854775808;    // int64 最小界（负号边界·双侧放行）
整64 裸十六 = 0xFF;
整64 裸二进 = 0b1010;
整64 裸八进 = 0o777;
整64 裸后缀 = 111111111111L;
整64 裸最小 = -9223372036854775808;         // int64 最小界（790 特例·双侧放行）
整128 裸百 = 0x1FF;
类 计 {
公开:
    静态 整64 十六 = 0x1F;                  // 31
    静态 整64 八进 = 0o17;                  // 15
    函数 计() {}
}
函数 主() -> 整32 {
    静态 整64 局部二进 = 0b101;             // 5
    静态 整64 局部后缀 = 42L;               // 42
    打印(静十六);
    打印(静二进);
    打印(静八进);
    打印(静后缀);
    打印(静全宽);
    打印(静全宽64);
    打印(静百);
    打印(静最小);
    打印(裸十六);
    打印(裸二进);
    打印(裸八进);
    打印(裸后缀);
    打印(裸最小);
    打印(裸百);
    打印(计.十六);
    打印(计.八进);
    打印(局部二进);
    打印(局部后缀);
    如果 (静十六 == 255 && 静二进 == 10 && 静八进 == 511 && 静后缀 == 111111111111L) {
        如果 (静全宽 == 9223372036854775807 && 静全宽64 != 0 && 静百 == 255 && 静最小 == -9223372036854775808) {
            如果 (裸十六 == 255 && 裸二进 == 10 && 裸八进 == 511 && 裸后缀 == 111111111111 && 裸百 == 511) {
                如果 (裸最小 == -9223372036854775808 && 计.十六 == 31 && 计.八进 == 15 && 局部二进 == 5 && 局部后缀 == 42) {
                    返回 0;
                }
            }
        }
    }
    返回 1;
}
