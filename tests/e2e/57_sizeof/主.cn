// E2E 57_sizeof：类型大小内建 + 容器结构体元素槽修复（A-3，2026-08）
// 覆盖：
//   1. 类型大小(整32/浮64/整128/字符串/结构体/数组/限定类型) 编译期求值
//   2. 向量<点>（24 字节结构体）追加/元素/设置/删除——元素槽按结构体大小
//      （此前 8 字节槽硬编码导致结构体元素错位/越界）
//   3. 泛型上下文 类型大小(T)（向量<T> 扩容分配 = 容量 * max(8, 类型大小(T))）
//   4. i128 元素（16 字节槽）
导入 容器::向量;

结构体 点 {
    整64 x;
    整64 y;
    整64 z;
}

函数 主() -> 整32 {
    打印("===== 类型大小与容器槽（A-3）=====");

    // 1. 类型大小编译期求值
    打印("整32: ", 类型大小(整32));
    打印("浮64: ", 类型大小(浮64));
    打印("整128: ", 类型大小(整128));
    打印("字符串: ", 类型大小(字符串));
    打印("点: ", 类型大小(点));
    打印("整64[5]: ", 类型大小(整64[5]));
    打印("指针: ", 类型大小(整32*));

    // 2. 结构体向量（24 字节元素）
    向量<点> 点列表 = 向量<点>();
    点 p1 = 点{ x = 1, y = 2, z = 3 };
    点 p2 = 点{ x = 10, y = 20, z = 30 };
    点 p3 = 点{ x = 100, y = 200, z = 300 };
    结果<空类型, 整32> 追加1 = 点列表.追加(p1);
    结果<空类型, 整32> 追加2 = 点列表.追加(p2);
    结果<空类型, 整32> 追加3 = 点列表.追加(p3);
    点 读0 = 点列表.元素(0);
    点 读1 = 点列表.元素(1);
    点 读2 = 点列表.元素(2);
    打印("点0: ", 读0.x, " ", 读0.y, " ", 读0.z);
    打印("点1: ", 读1.x, " ", 读1.y, " ", 读1.z);
    打印("点2: ", 读2.x, " ", 读2.y, " ", 读2.z);

    // 3. 设置/删除（结构体整体拷贝）
    结果<空类型, 整32> 设置 = 点列表.设置(1, p3);
    点 读设置 = 点列表.元素(1);
    打印("设置后: ", 读设置.x, " ", 读设置.y, " ", 读设置.z);
    结果<空类型, 整32> 删除 = 点列表.删除(0);
    点 读删 = 点列表.元素(0);
    打印("删除后[0]: ", 读删.x, " ", 读删.y, " ", 读删.z);
    打印("数量: ", 点列表.大小());

    // 4. i128 元素（16 字节槽）
    向量<整128> 大数表 = 向量<整128>();
    结果<空类型, 整32> 大追加1 = 大数表.追加(100000000000000000000LL);
    结果<空类型, 整32> 大追加2 = 大数表.追加(200000000000000000000LL);
    打印("大数[0]: ", 大数表.元素(0));
    打印("大数[1]: ", 大数表.元素(1));

    打印("===== 类型大小测试完成 =====");
    返回 0;
}
