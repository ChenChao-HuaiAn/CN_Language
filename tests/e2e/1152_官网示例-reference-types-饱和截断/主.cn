// 官网文档示例 · reference/types.html · 转换（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
函数 主() -> 整32 {
    // 编译期常量形态（字面量直转）
    打印("整32(1.0e18) = ", 整32(1.0e18));        // 正超域 → MAX
    打印("整32(3.99) = ", 整32(3.99));            // 域内 → 向零截断
    打印("整64(1.0e19) = ", 整64(1.0e19));
    // 运行期变量形态（与常量同语义）
    浮64 负超 = -1.0e18;
    浮64 非数 = 0.0 / 0.0;
    打印("整32(-1.0e18) = ", 整32(负超));         // 负超域 → MIN
    打印("整32(NaN) = ", 整32(非数));             // NaN → 0
    打印("正16(-1.0e5) = ", 整64(正16(-100000.0)));   // 无符号负超域 → 0
    打印("正64(1.0e20) = ", 正64(1.0e20));        // 无符号上超域 → MAX
    // 字符目标：Unicode 标量域钳制
    打印("字符(1.0e18) = ", 整32(字符(1.0e18)));      // 上超域 → 0x10FFFF
    打印("字符(-5.0) = ", 整32(字符(-5.0)));          // 非正值 → 0
    打印("字符(65.9) = ", 整32(字符(65.9)));          // 向零截断
    打印("字符(55296.0) = ", 整32(字符(55296.0)));    // 代理区透传
    返回 0;
}