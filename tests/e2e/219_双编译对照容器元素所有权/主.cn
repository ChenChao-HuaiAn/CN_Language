// E2E 219（2026-09-11 第七十四轮，plans/020 移植纪律 9 门禁化·第二个对照用例）：
//   **容器元素所有权归一化**——同一份源码经宿主真实管线与 v2 自举链各编译运行，
//   两侧退出码须相等（runner「双编译对照」编排断言：宿主侧 == 用例期望值 且
//   v2 侧 == 宿主侧实测值）。
//   覆盖 74-a 修复的全部机制 × 两侧共有语义面：
//     ① 借用来源（字符串形参）入容器 —— 容器析构不得释放调用方的串
//     ② 拥有串局部裸标识符入容器 —— 编译器代写深拷贝，容器独立拥有
//     ③ 成员/下标借出视图入容器 —— 借用视图必须复制（不能共享句柄）
//     ④ 容器元素守恒（向量 多次追加 + 搅动后内容完好）
//     ⑤ 四容器元素释放面（向量/链表/栈/队列 析构后残留归零）
//     ⑥ 容器元素读出后容器销毁 —— 借出视图的使范围（既有语义面回归）
//   断言口径与 E2E 218 同一模型：各形态内容校验 + 内存差值折入校验和
//   （63=①1+②2+③4+④8+⑤16+⑥32）。两侧任一形态的所有权机制分叉→该校验位
//   丢失→退出码变化→对照失败（含"泄漏/悬垂/双释放"三类内容测试抓不到的形态）。
//   平台守卫=linux 双平台（宿主与 v2 同链；win-x64 v2 产物未隔离=家机轮）。
导入 容器::向量;
导入 容器::链表;
导入 容器::栈;
导入 容器::队列;

// 内存搅动：新分配覆盖「已释放内存」，使悬垂元素内容可观测损坏
函数 搅动() -> 整64 {
    整64 和 = 0;
    整64 i = 0;
    当 (i < 24) {
        字符串 垃圾 = 字符串复制("搅动内存填充占位字符串内容甲乙丙丁戊己庚辛");
        和 = 和 + 字符串长度(垃圾);
        i++;
    }
    返回 和;
}

// ① 借用来源：字符串形参（借用视图）入容器——容器析构不得释放调用方的串
函数 存入形参(向量<字符串> 表, 字符串 值) -> 空类型 {
    结果<空类型, 整32> 加 = 表.追加(值);
    如果 (!加.正常) { 运行时错误(4); }
}

函数 形态借用() -> 整64 {
    字符串 本地 = 字符串复制("双编译对照·借用来源调用方拥有串内容甲乙丙丁");
    如果 (1 == 1) {
        向量<字符串> 表 = 向量<字符串>();
        存入形参(表, 本地);
    }
    整64 消耗 = 搅动();
    如果 (字符串比较(本地, "双编译对照·借用来源调用方拥有串内容甲乙丙丁")) { 返回 1; }
    返回 0;
}

// ② 拥有串局部裸标识符入容器——容器独立拥有（源照常可用）
函数 收集标识符(向量<字符串> 表) -> 空类型 {
    字符串 值 = 字符串复制("双编译对照·拥有串局部内容甲乙丙丁戊己庚辛");
    结果<空类型, 整32> 加 = 表.追加(值);
    如果 (!加.正常) { 运行时错误(4); }
    如果 (!字符串比较(值, "双编译对照·拥有串局部内容甲乙丙丁戊己庚辛")) { 运行时错误(5); }
}

函数 形态标识符() -> 整64 {
    向量<字符串> 表 = 向量<字符串>();
    收集标识符(表);
    整64 消耗 = 搅动();
    字符串 元素 = 表.元素(0);
    如果 (字符串比较(元素, "双编译对照·拥有串局部内容甲乙丙丁戊己庚辛")) { 返回 1; }
    返回 0;
}

// ③ 成员/下标借出视图入容器——必须复制（共享句柄即随源释放=双释放/悬垂）
函数 形态借出() -> 整64 {
    字符串 来源 = 字符串复制("双编译对照·借出视图来源内容甲乙丙丁戊己庚");
    向量<字符串> 表 = 向量<字符串>();
    结果<空类型, 整32> 加 = 表.追加(来源);
    如果 (!加.正常) { 运行时错误(4); }
    整64 消耗 = 搅动();
    // 源与容器元素各自独立拥有——两侧内容均须完好
    如果 (!字符串比较(来源, "双编译对照·借出视图来源内容甲乙丙丁戊己庚")) { 返回 0; }
    字符串 元素 = 表.元素(0);
    如果 (!字符串比较(元素, "双编译对照·借出视图来源内容甲乙丙丁戊己庚")) { 返回 0; }
    返回 1;
}

// ④ 容器元素守恒：同一容器多次追加 + 搅动后全部元素内容完好
函数 形态守恒() -> 整64 {
    向量<字符串> 表 = 向量<字符串>();
    整64 i = 0;
    当 (i < 3) {
        字符串 值 = 字符串复制("双编译对照·守恒形态元素内容甲乙丙丁戊己庚辛壬");
        结果<空类型, 整32> 加 = 表.追加(值);
        如果 (!加.正常) { 运行时错误(4); }
        i++;
    }
    整64 消耗 = 搅动();
    如果 (表.大小() != 3) { 返回 0; }
    整64 j = 0;
    当 (j < 3) {
        字符串 元素 = 表.元素(j);
        如果 (!字符串比较(元素, "双编译对照·守恒形态元素内容甲乙丙丁戊己庚辛壬")) { 返回 0; }
        j++;
    }
    返回 1;
}

// ⑤ 四容器元素释放面：向量/链表/栈/队列 的元素串随容器析构逐一释放（残留归零）
函数 形态释放面() -> 整64 {
    整64 前 = 内存::活动分配数();
    如果 (1 == 1) {
        向量<字符串> 向量表 = 向量<字符串>();
        结果<空类型, 整32> 加1 = 向量表.追加(字符串复制("双编译对照·向量元素占位内容甲乙丙丁"));
        如果 (!加1.正常) { 运行时错误(4); }
        链表<字符串> 链表表 = 链表<字符串>();
        结果<空类型, 整32> 加2 = 链表表.头部追加(字符串复制("双编译对照·链表元素占位内容甲乙丙丁"));
        如果 (!加2.正常) { 运行时错误(4); }
        栈<字符串> 栈表 = 栈<字符串>();
        结果<空类型, 整32> 加3 = 栈表.压入(字符串复制("双编译对照·栈元素占位内容甲乙丙丁戊"));
        如果 (!加3.正常) { 运行时错误(4); }
        队列<字符串> 队列表 = 队列<字符串>();
        结果<空类型, 整32> 加4 = 队列表.入队(字符串复制("双编译对照·队列元素占位内容甲乙丙丁"));
        如果 (!加4.正常) { 运行时错误(4); }
    }
    整64 后 = 内存::活动分配数();
    如果 (后 == 前) { 返回 1; }
    返回 0;
}

// ⑥ 容器元素读出后容器销毁——借出视图的既有语义面（元素串随容器释放，
//    容器内副本独立拥有；本形态只锚定「容器内元素在容器存活期内恒完好」）
函数 形态读出() -> 整64 {
    向量<字符串> 表 = 向量<字符串>();
    结果<空类型, 整32> 加 = 表.追加(字符串复制("双编译对照·读出形态元素内容甲乙丙丁戊己"));
    如果 (!加.正常) { 运行时错误(4); }
    字符串 元素 = 表.元素(0);
    如果 (字符串比较(元素, "双编译对照·读出形态元素内容甲乙丙丁戊己")) { 返回 1; }
    返回 0;
}

函数 主() -> 整32 {
    整32 校验 = 0;
    如果 (形态借用() == 1) { 校验 = 校验 + 1; }
    如果 (形态标识符() == 1) { 校验 = 校验 + 2; }
    如果 (形态借出() == 1) { 校验 = 校验 + 4; }
    如果 (形态守恒() == 1) { 校验 = 校验 + 8; }
    如果 (形态释放面() == 1) { 校验 = 校验 + 16; }
    如果 (形态读出() == 1) { 校验 = 校验 + 32; }
    返回 校验;
}
