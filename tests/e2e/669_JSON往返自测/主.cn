// 669（冻结期生态任务 348·#352）：stdlib JSON.cn 自测——解析/查询/生成/往返幂等/
//   转义族（\n\u4f60 代理对→UTF-8）/美化缩进/尾余负例。
//   断言走 测试框架（生态互相使用的 showcase：JSON+测试框架 双模块同轮 dual）。
//   〔面注〕深超/未闭合/孤立代理/尾逗号/缺冒号 负例与 重置复用面 随 #365 挂起
//   （复用树失败路径宿主段错误·021 #365），修复轮扩面。
导入 测试框架::{测试器, 运行用例, 断言真, 断言相等整数, 断言相等文本, 测试汇总};
导入 JSON::{JSON树, JSON解析器, 解析JSON, 生成JSON, JSONT_空, JSONT_真, JSONT_整数, JSONT_浮点, JSONT_字符串, JSONT_数组, JSONT_对象, JSONE_好, JSONE_语法, JSONE_深超, JSONE_尾余};

// 样例树建立（对象 7 成员·含两型数字/字面量/嵌套数组/嵌套对象/转义串）
不安全 函数 用例解析查询(测试器* 器) {
    JSON树 树 = JSON树();
    解析JSON(树, "{\"名称\":\"测试\",\"数量\":42,\"比率\":0.25,\"有效\":true,\"备注\":null,\"标签\":[\"甲\",\"乙\"],\"子\":{\"深\":\"值\\n\"}}");
    断言相等整数(器, 树.错误码, JSONE_好, "样例解析成功");
    断言相等整数(器, 树.类型(树.根), JSONT_对象, "根为对象");
    断言相等整数(器, 树.子数(树.根), 7, "根成员数");
    整64 名称节 = 树.找键(树.根, "名称");
    断言相等整数(器, 树.类型(名称节), JSONT_字符串, "名称类型");
    断言相等文本(器, 树.文本(名称节), "测试", "名称值");
    断言相等整数(器, 树.整值(树.找键(树.根, "数量")), 42, "数量整值");
    断言相等整数(器, 树.类型(树.找键(树.根, "数量")), JSONT_整数, "数量类型");
    断言真(器, 树.浮值(树.找键(树.根, "比率")) > 0.249 && 树.浮值(树.找键(树.根, "比率")) < 0.251, "比率浮值");
    断言相等整数(器, 树.类型(树.找键(树.根, "比率")), JSONT_浮点, "比率类型");
    断言相等整数(器, 树.类型(树.找键(树.根, "有效")), JSONT_真, "有效类型");
    断言相等整数(器, 树.类型(树.找键(树.根, "备注")), JSONT_空, "备注类型");
    整64 标签节 = 树.找键(树.根, "标签");
    断言相等整数(器, 树.类型(标签节), JSONT_数组, "标签类型");
    断言相等整数(器, 树.子数(标签节), 2, "标签元素数");
    断言相等文本(器, 树.文本(树.子(标签节, 0)), "甲", "标签首元素");
    断言相等文本(器, 树.文本(树.子(标签节, 1)), "乙", "标签次元素");
    整64 子节 = 树.找键(树.根, "子");
    断言相等整数(器, 树.类型(子节), JSONT_对象, "子类型");
    断言相等整数(器, 字符串长度(树.文本(树.找键(子节, "深"))), 4, "深值含换行4字节");
}

// 转义族：\u 代理对（U+1F600😀→UTF-8 4 字节）+ \u4f60（你→3 字节）+ \t\/
不安全 函数 用例转义(测试器* 器) {
    JSON树 树 = JSON树();
    解析JSON(树, "{\"表情\":\"\\ud83d\\ude00\",\"你\":\"\\u4f60\",\"制表\":\"a\\tb\\/c\"}");
    断言相等整数(器, 树.错误码, JSONE_好, "转义解析成功");
    断言相等整数(器, 字符串长度(树.文本(树.找键(树.根, "表情"))), 4, "代理对成UTF8四字节");
    断言相等整数(器, 字符串长度(树.文本(树.找键(树.根, "你"))), 3, "BMP成UTF8三字节");
    断言相等文本(器, 树.文本(树.找键(树.根, "制表")), "a\tb/c", "控制转义与斜杠");
}

// 生成族：紧凑串逐字比对（数字两型+转义再生）
不安全 函数 用例生成(测试器* 器) {
    JSON树 树 = JSON树();
    解析JSON(树, "{\"数\":42,\"率\":0.25,\"串\":\"a\\n\"}");
    断言相等整数(器, 树.错误码, JSONE_好, "生成用例解析");
    字符串 紧凑 = 生成JSON(树, 树.根, 0);
    断言相等文本(器, 紧凑, "{\"数\":42,\"率\":0.250000,\"串\":\"a\\n\"}", "紧凑生成串");
}

// 长样例解析+结构断言（8 元素·两型数字/字面量/嵌套对象/两层嵌套数组——
//   生成串二次解析的往返比对暂缩：宿主 #113 槽漂移对大局部帧语句序敏感，
//   生成能力由「生成」用例紧凑串逐字比对覆盖，往返全链修复轮恢复）
不安全 函数 用例往返(测试器* 器) {
    JSON树 树甲 = JSON树();
    解析JSON(树甲, "[1,-2,3.5,\"文\",true,null,{\"键\":\"值\"},[[\"深\"]]]");
    断言相等整数(器, 树甲.错误码, JSONE_好, "长样例解析成功");
    断言相等整数(器, 树甲.子数(树甲.根), 8, "根元素数");
    断言相等整数(器, 树甲.整值(树甲.子(树甲.根, 1)), -2, "负整数");
    断言真(器, 树甲.浮值(树甲.子(树甲.根, 2)) > 3.4 && 树甲.浮值(树甲.子(树甲.根, 2)) < 3.6, "浮点");
    断言相等文本(器, 树甲.文本(树甲.子(树甲.根, 3)), "文", "字符串元素");
    断言相等整数(器, 树甲.类型(树甲.子(树甲.根, 4)), JSONT_真, "true 位");
    断言相等整数(器, 树甲.类型(树甲.子(树甲.根, 5)), JSONT_空, "null 位");
    整64 对象节 = 树甲.子(树甲.根, 6);
    断言相等整数(器, 树甲.类型(对象节), JSONT_对象, "嵌套对象");
    断言相等文本(器, 树甲.文本(树甲.找键(对象节, "键")), "值", "嵌套键值");
    整64 深数组 = 树甲.子(树甲.根, 7);
    断言相等整数(器, 树甲.子数(树甲.子(深数组, 0)), 1, "两层嵌套保持");
}

// 美化生成：换行+层进缩进（结构断言：行数与首尾）
不安全 函数 用例美化(测试器* 器) {
    JSON树 树 = JSON树();
    解析JSON(树, "{\"甲\":1}");
    断言相等整数(器, 树.错误码, JSONE_好, "美化用例解析");
    字符串 美化 = 生成JSON(树, 树.根, 2);
    断言相等文本(器, 美化, "{\n  \"甲\": 1\n}", "美化生成串");
}

// 负例族：尾余检出（复用树成功路径）
不安全 函数 用例负例(测试器* 器) {
    JSON树 树 = JSON树();
    解析JSON(树, "[1,2]");
    断言相等整数(器, 树.错误码, JSONE_好, "尾余前解析成功");
    解析JSON(树, "[1,2] 垃圾");
    断言相等整数(器, 树.错误码, JSONE_尾余, "尾余检出");
}

不安全 函数 主() -> 整32 {
    测试器 器 = 测试器();
    运行用例(器, "解析查询", 用例解析查询);
    运行用例(器, "转义", 用例转义);
    运行用例(器, "生成", 用例生成);
    运行用例(器, "往返", 用例往返);
    运行用例(器, "美化", 用例美化);
    运行用例(器, "负例", 用例负例);
    整64 失败数 = 测试汇总(器);
    打印("汇总返回失败用例数=", 失败数);
    返回 0;
}
