// 官网文档示例 · getting-started.html · 第一个实战（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
导入 IO::读取整数;
导入 随机数::随机数生成器;

函数 主() -> 整32 {
    随机数生成器 生成器 = 随机数生成器(20261008);
    整64 答案 = 生成器.下一个范围(100) + 1;   // 1~100
    整32 次数 = 0;
    当 (真) {
        打印("猜一个 1~100 的数：");
        结果<整64, 整32> 输入 = 读取整数();
        如果 (输入.正常) {
            次数++;
            如果 (输入.值 < 答案) {
                打印("小了");
            } 否则 {
                如果 (输入.值 > 答案) {
                    打印("大了");
                } 否则 {
                    打印("猜中了！共 ", 次数, " 次");
                    中断;
                }
            }
        } 否则 {
            打印("输入结束，未猜中。答案是 ", 答案);
            中断;
        }
    }
    返回 0;
}