// E2E 718_接口转换拒绝（413-b 审查 P1-2 负例）：未实现接口的类 → 接口类型
//   隐式转换，声明初始化/赋值/实参传参/接口值返回 四面编译拒绝（宿主
//   canConvertType 全面检查·修前 v2 仅声明初始化面）。
接口 形状 {
    虚拟 函数 面积() -> 整32
}
类 圆 : 形状 {
公开:
    函数 圆() { }
    重写 函数 面积() -> 整32 { 返回 1; }
}
类 无接口对象 {
公开:
    函数 无接口对象() { }
}
函数 用形状(形状 图形) -> 整32 { 返回 图形.面积(); }
函数 造形状() -> 形状 {
    返回 无接口对象();     // 接口值返回面
}
函数 主() -> 整32 {
    形状 图形 = 圆();
    图形 = 无接口对象();          // 赋值面
    整32 甲 = 用形状(无接口对象()); // 实参传参面
    返回 0;
}
