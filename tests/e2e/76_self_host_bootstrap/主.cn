// E2E 76_self_host_bootstrap：自举 Task 7.6——两阶段自举验证（2026-08）
// 阶段1：C++ 版 cn 编译器编译 CN 版组件（E2E 70~75 已覆盖：CN 版组件可运行）
// 阶段2：CN 版组件链（词法->语法->语义->IR->代码生成）编译 CN 组件自身源码
//   （CN语言编译器/词法分析.cn），各阶段产物行数确定性输出比对（= 与 C++ 版
//   期望一致 -> 自举验证通过）。
导入 容器::向量
导入 文件::打开文件
导入 文件::读取文件行
导入 文件::关闭文件
导入 CN语言编译器::词法分析
导入 CN语言编译器::语法分析
导入 CN语言编译器::语义分析
导入 CN语言编译器::IR生成
导入 CN语言编译器::代码生成

// 读取文件全部内容（逐行拼接；EOF 时 读取文件行 返回错误）
函数 读全部(空类型* 句柄) -> 字符串 {
    字符串 全部 = ""
    结果<字符串, 整32> 行结果 = 读取文件行(句柄)
    当 (真) {
        如果 (行结果.正常) {
            全部 = 全部 + 行结果.值
        } 否则 {
            中断
        }
        行结果 = 读取文件行(句柄)
    }
    返回 全部
}

函数 主() -> 整32 {
    // 自举目标：CN 编译器组件自身源码（词法分析器——CN 编译器的一部分）
    结果<空类型*, 整32> 打开结果 = 打开文件("CN语言编译器/词法分析.cn", 1)
    如果 (打开结果.正常) {
        字符串 组件源码 = 读全部(打开结果.值)
        关闭文件(打开结果.值)
        // 阶段2：CN 组件链编译组件源码
        向量<字符串> 记号 = 分词(组件源码)
        向量<字符串> AST行 = 解析(组件源码)
        向量<字符串> 诊断 = 语义检查(组件源码)
        向量<字符串> IR行 = IR生成(组件源码, "词法分析")
        向量<字符串> asm行 = 代码生成(IR行)
        打印("阶段|词法|" + 整数转字符串(记号.大小()))
        打印("阶段|语法|" + 整数转字符串(AST行.大小()))
        打印("阶段|语义|" + 整数转字符串(诊断.大小()))
        打印("阶段|IR|" + 整数转字符串(IR行.大小()))
        打印("阶段|代码生成|" + 整数转字符串(asm行.大小()))
        打印("自举|验证|通过")
        返回 0
    } 否则 {
        打印("自举|读取失败")
        返回 1
    }
}
