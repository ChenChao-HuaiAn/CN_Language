// 核心库 E2E（Task 6.1，规格书10.2 核心工具）
// 覆盖：错误码枚举引用 / 泛型 交换/最小/最大（整32+浮64 多类型实例化）/
//       断言（真条件通过）
// 模块导入：导入 核心::符号 后使用纯名调用（泛型函数 交换<整32> 等，
//   Task 6.1 打通：泛型函数跨模块合并 + 单态化 + IR 函数体生成）
// 说明：断言 假条件会调 运行时错误(6) 终止进程——E2E 只验证真条件通过；
//   假条件终止路径由语义层单测（运行时错误 注册）间接覆盖
// 打印语义（用户裁决）：打印=println（自动换行）

导入 核心::交换;
导入 核心::最小;
导入 核心::最大;
导入 核心::断言;
导入 核心::错误码;

函数 主() -> 整32 {
    打印("===== 核心库（Task 6.1）=====");

    // ---- 1. 错误码枚举（导入后纯名引用）----
    打印("除零: ", 错误码.除零);
    打印("越界: ", 错误码.越界);
    打印("内存: ", 错误码.内存);
    打印("溢出: ", 错误码.溢出);

    // ---- 2. 交换（整32）----
    整32 a = 1;
    整32 b = 2;
    交换<整32>(&a, &b);
    打印("交换整32: ", a, " ", b);         // 2 1

    // ---- 3. 交换（浮64）----
    浮64 x = 3.5;
    浮64 y = 7.5;
    交换<浮64>(&x, &y);
    打印("交换浮64: ", x, " ", y);         // 7.500000 3.500000

    // ---- 4. 最小 / 最大（整32 + 浮64）----
    打印("最小整32: ", 最小<整32>(10, 20));     // 10
    打印("最大整32: ", 最大<整32>(10, 20));     // 20
    打印("最小浮64: ", 最小<浮64>(2.5, 1.5));   // 1.500000
    打印("最大浮64: ", 最大<浮64>(2.5, 1.5));   // 2.500000

    // ---- 5. 断言（真条件通过）----
    断言(真, "不应触发");
    断言(1 < 2, "不应触发");
    打印("断言通过");

    打印("===== 核心库测试完成 =====");
    返回 0;
}
