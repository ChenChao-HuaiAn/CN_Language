// E2E 1365 正测（#1979·#1882 探针派生）：类外静态数组字段整体赋值——
//   类名.静态数组字段 = 同型数组 = 整块拷（元素×长度全部复制·259 顶层静态
//   数组整体赋值同款立法投影·001 §3.5 数组=值聚合）。修前：双侧均只写槽首
//   8 字节且写入值=源数组栈基址（把地址当数据→运行读出垃圾）。宿主+v2 双侧。
类 例 {
公开:
    静态 整64[3] 表;
    静态 整32[4] 表32;
}
函数 主() -> 整32 {
    整64[3] 源甲;
    源甲[0] = 11;
    源甲[1] = 22;
    源甲[2] = 33;
    例.表 = 源甲;
    打印(例.表[0]);
    打印(例.表[1]);
    打印(例.表[2]);
    // 值拷语义：赋值后改源，目标不受影响（地址/句柄共享面甄别）
    源甲[1] = 222;
    打印(例.表[1]);
    // 整32 窄元素：字节数=元素步进×长度（查表·非 8 字节默认）
    整32[4] 源乙;
    源乙[0] = 7;
    源乙[1] = 8;
    源乙[2] = 9;
    源乙[3] = 10;
    例.表32 = 源乙;
    打印(例.表32[0] + 例.表32[1] + 例.表32[2] + 例.表32[3]);
    // 重复整体赋值覆盖（静态槽长期存活·覆盖后读新值）
    源甲[0] = 111;
    例.表 = 源甲;
    打印(例.表[0]);
    打印(例.表[2]);
    返回 0;
}
