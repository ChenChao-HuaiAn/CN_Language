// E2E 195_v2（v2 负路径，2026-09-10 第五十六轮 55-c 方案A 用户裁决·Rust E0308
//   对齐）：与宿主 195 同源。v2 语义检查落地声明/赋值/返回三面混合符号拒绝
//   （检查混合符号赋值，宿主 canConvert+豁免同构）；字面量初始化形态
//   （正32 小 = 4000000000 / 整64 负 = -1 / 整32 值 = 100）豁免不误伤。
//   诚实边界：传参形态 v2 本轮不查（调用 AST 实参边界未显式记录，无法精确
//   对齐形参——随解析层增强另轮），v2 诊断 3 行（返回/声明/赋值）+中止行。
函数 读值(正32 源) -> 整32 {
    返回 整32(源);
}
函数 取值() -> 整64 {
    正32 小 = 4000000000;
    返回 小;
}
函数 主() -> 整32 {
    正32 小 = 4000000000;
    整64 负 = -1;
    整64 甲 = 小;
    负 = 小;
    整32 值 = 100;
    读值(值);
    返回 0;
}
