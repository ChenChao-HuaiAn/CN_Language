// E2E 1037_嵌套三元挑函数（#600 销项·dual 双编译对照锁用例）：
//   嵌套三元形态挑函数指针的整链锁定——`条件1 ? (条件2 ? 函数甲 : 函数乙) : 函数丙`
//   作 fnptr 值：外层三元的真/假分支中「内层三元」自身也是函数名收口位（816 单层
//   三元已覆盖；嵌套=内层三元作为外层三分支之一的嵌套消费位，须同通道收口：外层
//   真分支值=内层三元结果（值位函数名收口 480 通道），外层假分支=函数名直收口）。
//   同族漏网面=三元链短路语义与槽位复用：内层不选分支不得求值/不参与收口；
//   赋值为非声明初始化位（右值三元结果落既有 fnptr 变量槽·覆盖旧值）。
//   本用例 dual 双向锁定：宿主侧与 v2 侧运行 stdout 逐行一致（断言输出=是）：
//     ① 外真·内真 → 选「加一」→ f1(10)=11
//     ② 外真·内假 → 选「加倍」→ f2(10)=20
//     ③ 外假 → 选「三倍」（内层不选）→ f3(10)=30
//     ④ 赋值语句位·外假 → 覆盖旧值选「三倍」→ f4(10)=30
//     ⑤ 三面嵌套（内层假分支再嵌三层）·外真·b>5 → 「加倍」→ f5(10)=20
//   期望输出 11/20/30/30/20（双侧一致基线）。
函数 加一(整32 x) -> 整32 { 返回 x + 1; }
函数 加倍(整32 x) -> 整32 { 返回 x * 2; }
函数 三倍(整32 x) -> 整32 { 返回 x * 3; }

函数 主() -> 整32 {
    整32 a = 1;
    整32 b = 9;
    // ① 声明初始化·嵌套三元（外真·内真）→ 加一
    整32(*f1)(整32) = a > 0 ? (b > 5 ? 加一 : 加倍) : 三倍;
    打印(f1(10));
    // ② 声明初始化·嵌套三元（外真·内假）→ 加倍
    整32(*f2)(整32) = a > 0 ? (b > 100 ? 加一 : 加倍) : 三倍;
    打印(f2(10));
    // ③ 外假 → 三倍（内层不参与挑选）
    整32(*f3)(整32) = a > 9 ? (b > 5 ? 加一 : 加倍) : 三倍;
    打印(f3(10));
    // ④ 赋值语句位（先声明后赋三元结果·覆盖旧值）
    整32(*f4)(整32) = 加一;
    f4 = a > 9 ? (b > 5 ? 加一 : 加倍) : 三倍;
    打印(f4(10));
    // ⑤ 三面嵌套（内层假分支再嵌一层）·外真·b>5 → 加倍
    整32(*f5)(整32) = a > 9 ? 三倍 : (b > 100 ? 加一 : (b > 5 ? 加倍 : 三倍));
    打印(f5(10));
    返回 0;
}
