// 官网文档示例 · reference/functions.html · 函数指针与lambda（任务 1060 同源化：本文件即官网展示内容，
//   经 run_e2e 门禁实测——展示与门禁同一份文件，单一事实源）
函数 造取() -> 整64(*)() {
    整64 基 = 5000000000;
    变量 取 = [=]() -> 整64 { 返回 基 * 2; };
    返回 取;               // 值捕获快照：逃逸定义帧合法
}

函数 主() -> 整32 {
    变量 取 = 造取();
    打印(取());
    返回 0;
}