// 001/spec 06§三 类裸声明基构造链·正形态族（#1948 双编译对照锁面）：
//   派生类无用户构造时裸声明（派类 p;）=隐式默认构造——基类构造链须自动
//   注入（117 三通道判据统一：构造序言/实例化点/裸声明·宿主 emitBaseCtorChain
//   单点；v2 注入裸声明基构造链 对应发射）。修前裸声明通道不发基链=基类
//   构造带副作用（赋值基类字段）时不跑=基类字段未初始化错值（宿主
//   genClassDefaultConstruct 缺基链·v2 生成类对象局部 同构缺口）。
//   三形态各一函数·主函数依序调用：
//   ①基类严格零参构造·派生裸声明（构造标记+字段=构造值）
//   ②基类仅全默认参构造·派生裸声明（D23 缺段补全·构造标记+字段=默认值）
//   ③三层链孙类裸声明（中间层无构造 walk-up·祖构造标记+字段=构造值）
// 打印语义：打印=println（自动换行）

// 形态①：基类严格零参构造（副作用=赋值基类字段）
类 兽 {
公开:
    整32 腿;
    函数 兽() { 腿 = 4; 打印("[兽构造]"); }
}
类 犬 : 兽 {
公开:
}

// 形态②：基类仅全默认参构造（零实参可调·D23 补全 n=2）
类 禽 {
公开:
    整32 翼;
    函数 禽(整32 n = 2) { 翼 = n; 打印("[禽构造]"); }
}
类 雀 : 禽 {
公开:
}

// 形态③：三层链（祖类零参构造·中间层无构造·孙类裸声明 walk-up 跨隐式层）
类 祖石 {
公开:
    整32 层;
    函数 祖石() { 层 = 9; 打印("[祖石构造]"); }
}
类 中石 : 祖石 {
公开:
}
类 孙石 : 中石 {
公开:
}

函数 形态零参基链() -> 整32 {
    犬 d;
    打印(d.腿);
    返回 0;
}

函数 形态全默认参基链() -> 整32 {
    雀 q;
    打印(q.翼);
    返回 0;
}

函数 形态三层链裸声明() -> 整32 {
    孙石 s;
    打印(s.层);
    返回 0;
}

函数 主() -> 整32 {
    形态零参基链();
    形态全默认参基链();
    形态三层链裸声明();
    返回 0;
}
