// E2E 1781（双编译对照·正例·#2025）：**混合来源三元**拥有标志条件释放。
//   修前：三元两分支一拥有（拼接产物）一借用（字段/变量）时，分支敏感禁盲
//   登记=不登记 → 拼接分支产物无人释放（50 轮净泄 1/轮）；统一登记又误释放
//   借用句柄。修后：三元汇合写拥有标志槽（真/假分支各写 1/0·嵌套转抄内层），
//   消费位（打印/声明/赋值/返回/拼接/实参/语句）按标志条件释放。
// 覆盖：①打印位混合 50 轮 ②声明位混合 50 轮 ③赋值位混合 50 轮
//   ④返回位混合 50 轮（-> 字符串 拥有契约）⑤纯借用分支（零释放/不崩溃）
//   ⑥纯拼接分支（两分支皆拥有·分配回落）⑦嵌套三元（标志逐层传递）
//   ⑧静态串赋值位混合 50 轮 ⑨成员串字段赋值位混合 50 轮。
// 每段活动分配数差=0（静态槽恒拥有，差值=1 个存活堆串）；借用来源字段内容
//   不变（无误释放/UAF）。
类 持有 {
公开:
    字符串 名;
    函数 持有(字符串 n) { 名 = n; }
}
静态 字符串 全局串 = "初";
不安全 函数 静态段(持有 甲, 字符串 基s) -> 整64 {
    整64 基S = 内存::活动分配数();
    整64 i = 0;
    当 (i < 50) {
        布尔 条件 = (i % 2 == 0);
        全局串 = 条件 ? (基s + "x") : 甲.名;
        打印(全局串);
        i++;
    }
    返回 内存::活动分配数() - 基S;
}
函数 选三元(布尔 c, 字符串 基s, 字符串 借s) -> 字符串 {
    返回 c ? (基s + "x") : 借s;
}
函数 主() -> 整32 {
    持有 甲 = 持有("甲");
    字符串 基s = "基";
    // ① 打印位混合三元
    打印("A");
    整64 基A = 内存::活动分配数();
    整64 i = 0;
    当 (i < 50) {
        布尔 条件 = (i % 2 == 0);
        打印(条件 ? (基s + "x") : 甲.名);
        i++;
    }
    打印(内存::活动分配数() - 基A);
    打印(甲.名);
    // ② 声明位混合三元（块出口 RAII）
    打印("B");
    整64 基B = 内存::活动分配数();
    i = 0;
    当 (i < 50) {
        布尔 条件 = (i % 2 == 0);
        {
            字符串 局s = 条件 ? (基s + "x") : 甲.名;
            打印(局s);
        }
        i++;
    }
    打印(内存::活动分配数() - 基B);
    打印(甲.名);
    // ③ 赋值位混合三元
    打印("C");
    字符串 赋s = 字符串复制("初");
    整64 基C = 内存::活动分配数();
    i = 0;
    当 (i < 50) {
        布尔 条件 = (i % 2 == 0);
        赋s = 条件 ? (基s + "x") : 甲.名;
        打印(赋s);
        i++;
    }
    打印(内存::活动分配数() - 基C);
    打印(甲.名);
    // ④ 返回位混合三元（-> 字符串 拥有契约）
    打印("D");
    字符串 借s = 字符串复制("借");
    整64 基D = 内存::活动分配数();
    i = 0;
    当 (i < 50) {
        布尔 条件 = (i % 2 == 0);
        变量 返r = 选三元(条件, 基s, 借s);
        打印(返r);
        i++;
    }
    打印(内存::活动分配数() - 基D);
    打印(借s);
    // ⑤ 纯借用分支（字段视图）——零释放、不崩溃
    打印("E");
    持有 乙 = 持有("乙");
    整64 基E = 内存::活动分配数();
    整64 和 = 0;
    i = 0;
    当 (i < 50) {
        布尔 条件 = (i % 2 == 0);
        打印(条件 ? 甲.名 : 乙.名);
        和 = 和 + 整64(字符串长度(条件 ? 甲.名 : 乙.名));
        i++;
    }
    打印(整32(和));
    打印(内存::活动分配数() - 基E);
    打印(甲.名);
    打印(乙.名);
    // ⑥ 纯拼接分支（两分支皆拥有）
    打印("F");
    整64 基F = 内存::活动分配数();
    i = 0;
    当 (i < 50) {
        布尔 条件 = (i % 2 == 0);
        打印(条件 ? (基s + "x") : (基s + "y"));
        i++;
    }
    打印(内存::活动分配数() - 基F);
    // ⑦ 嵌套混合三元（内层拼接/字段·外层复制/内层）
    打印("G");
    整64 基G = 内存::活动分配数();
    i = 0;
    当 (i < 50) {
        布尔 条件 = (i % 2 == 0);
        布尔 内条 = (i % 3 == 0);
        打印(条件 ? (内条 ? (基s + "x") : 甲.名) : 字符串复制("尾"));
        i++;
    }
    打印(内存::活动分配数() - 基G);
    打印(甲.名);
    // ⑧ 静态字符串赋值位混合三元（静态槽恒拥有·差值=1 个存活堆串）
    打印("H");
    打印(整32(静态段(甲, 基s)));
    打印(全局串);
    // ⑨ 成员字符串字段赋值位混合三元
    打印("I");
    持有 仓 = 持有("仓");
    整64 基I = 内存::活动分配数();
    i = 0;
    当 (i < 50) {
        布尔 条件 = (i % 2 == 0);
        仓.名 = 条件 ? (基s + "x") : 甲.名;
        打印(仓.名);
        i++;
    }
    打印(内存::活动分配数() - 基I);
    打印(甲.名);
    打印(仓.名);
    返回 0;
}
