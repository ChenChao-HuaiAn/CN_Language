// 用例 1442：文件库 创建目录（#1138·递归建目录 / 幂等 / 失败显式）
// 覆盖：①多层缺失目录一次递归建齐（甲/乙/丙三层，父目录均不存在）；
//       ②同路径重复创建=正常（mkdir -p 幂等语义，宿主 ensureDirExists 同构）；
//       ③建出的目录真实可用（写入文件后 文件存在=真）；
//       ④失败路径：路径中段是已存在文件 → 必须返回 错误(错误码.文件)
//         （禁静默继续；宿主 CreateDirectory/mkdir 与 v2 同判据）。
// 双侧：宿主 + v2p 同一 .expected（双编译对照.txt）——stdlib 门面与内置
//   文件::创建目录 双端同语义，防 #1138 类分叉复发。
// 产物位置：target/ 下（.gitignore 忽略；重复运行幂等）。
导入 文件::{创建目录, 打开文件, 写入文件, 关闭文件, 文件存在};

函数 主() -> 整32 {
    字符串 根 = "target/e2e1442/甲/乙/丙";
    结果<空类型, 整32> 建 = 创建目录(根);
    如果 (!建.正常) {
        打印("递归创建失败");
        返回 1;
    }
    打印("递归创建成功");

    // 幂等：同路径再建一次仍为正常（目录已存在=成功）
    结果<空类型, 整32> 再建 = 创建目录(根);
    如果 (!再建.正常) {
        打印("重复创建失败");
        返回 2;
    }
    打印("重复创建成功");

    // 目录真实可用：写入文件并核验存在性
    字符串 文件路径 = 根 + "/笔记.txt";
    结果<空类型*, 整32> 写口 = 打开文件(文件路径, 2);
    如果 (!写口.正常) {
        打印("打开写口失败");
        返回 3;
    }
    结果<整64, 整32> 写 = 写入文件(写口.值, "目录自动创建\n");
    关闭文件(写口.值);
    如果 (!写.正常) {
        打印("写入失败");
        返回 4;
    }
    打印("文件存在=", 文件存在(文件路径));

    // 失败路径：中段同名文件挡路 → 创建目录必须显式报错
    字符串 挡路 = "target/e2e1442/挡路.txt";
    结果<空类型*, 整32> 挡路口 = 打开文件(挡路, 2);
    如果 (!挡路口.正常) {
        打印("挡路文件创建失败");
        返回 5;
    }
    关闭文件(挡路口.值);
    结果<空类型, 整32> 非法建 = 创建目录(挡路 + "/子目录");
    如果 (非法建.正常) {
        打印("非法路径未拒绝");
        返回 6;
    }
    打印("中段文件已拒绝");

    返回 0;
}
