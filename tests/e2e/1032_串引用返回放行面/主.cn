// E2E 1032（双编译对照·733 销项）：字符串& 引用返回放行面不误拦——733 的 v2
//   A2 判定扩「字符串&」只拦借出形态；宿主放行的合法形态两侧同放行同运行值：
//     位1：整64& 成员返回读写（150_v2 同族：取点值(p)=100 / r+=8 → p.值==108）
//     位2：字符串& 别名绑定成员方法引用返回（零参方法·733-a 修复面）读值
//     位4：别名写穿（改名后 别 读新值——引用语义非拷贝）
//     位8：拼接返回（返回 x.名 + "后"——宿主/v2 双放行面）
//   修前：位2/4 形态 v2 拒「引用初始化必须是可绑定左值」（零参方法引用
//   返回判定被「实参数>0」门槛挡——同轮发现随 733 修复）。
//   退出码=校验和 15。字符串值接收引用返回调用（字符串 副 = b.读名()）不在
//   本用例面：双侧行为分叉缺陷（v2 地址当句柄坏值/宿主副本非独立）已另立案。
结构体 点 { 整64 值; }
函数 取点值(点& p) -> 整64& {
    返回 p.值;
}
类 盒 {
公开:
    字符串 名;
    函数 盒() { 名 = 字符串复制("盒名"); }
    函数 读名() -> 字符串& {
        返回 名;
    }
    函数 改名(字符串 新名) -> 空类型 { 名 = 新名; }
}
结构体 壳 { 字符串 名; }
函数 拼后(壳& x) -> 字符串 {
    返回 x.名 + "后";
}
不安全 函数 主() -> 整32 {
    整32 校验 = 0;
    // 位1：整64& 成员返回读写
    点 p;
    p.值 = 42;
    取点值(p) = 100;
    整64& r = 取点值(p);
    r += 8;
    如果 (p.值 == 108) { 校验 = 校验 + 1; }
    // 位2/4：类 this 字符串字段引用返回（别名读 / 别名写穿）
    {
        盒 b;
        字符串& 别 = b.读名();
        如果 (字符串比较(别, "盒名")) { 校验 = 校验 + 2; }
        b.改名(字符串复制("新盒"));
        如果 (字符串比较(别, "新盒")) { 校验 = 校验 + 4; }
    }
    // 位8：拼接返回
    {
        壳 x;
        x.名 = 字符串复制("名");
        字符串 s = 拼后(x);
        如果 (字符串比较(s, "名后")) { 校验 = 校验 + 8; }
    }
    返回 校验;
}
