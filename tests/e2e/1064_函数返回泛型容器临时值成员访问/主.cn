// 1064_函数返回泛型容器临时值成员访问（845）：函数返回泛型容器/结果实例的
//   临时值成员访问——造向量().大小()/造向量().元素(0)/造向量().追加(9) 与
//   链式 造点表().元素(0).x、临时映射 获取/设置、结果实例成员。宿主原语义层
//   成员方法调用对象类型推导缺泛型实例物化步行（对象=调用表达式返回
//   canonicalType 形态「向量<整32>」未转 $ 实例名 → 方法表恒 miss →
//   「无法调用非函数类型」；v2 消费同一物化名=全绿）。修复=
//   checkMemberCallCore 物化步行（对齐 visitMemberExpr T95/551-a 先例）+
//   IR exprSrcType 返回物化（对象识别/662 临时析构链消费）。
导入 容器::向量;
导入 映射集合;

结构体 点 { 整64 x; 整64 y; }

函数 造向量() -> 向量<整32> {
    向量<整32> 值 = 向量<整32>();
    结果<空类型, 整32> 追 = 值.追加(42);
    如果 追.正常 { 打印("造向量 ok"); } 否则 { 打印("造向量 错"); 返回 值; }
    返回 值;
}

函数 造映射() -> 映射<整64, 整64> {
    映射<整64, 整64> 表 = 映射<整64, 整64>();
    结果<空类型, 整32> 设 = 表.设置(7, 777);
    如果 设.正常 { 打印("造映射 ok"); } 否则 { 打印("造映射 错"); 返回 表; }
    返回 表;
}

函数 造结果() -> 结果<整32, 整32> {
    返回 正常(31);
}

函数 造点表() -> 向量<点> {
    向量<点> 表 = 向量<点>();
    点 p;
    p.x = 5;
    p.y = 6;
    结果<空类型, 整32> 追 = 表.追加(p);
    如果 追.正常 { 打印("造点表 ok"); } 否则 { 打印("造点表 错"); 返回 表; }
    返回 表;
}

函数 主() -> 整32 {
    // 赋值形态：临时向量大小
    整64 甲 = 造向量().大小();
    打印("甲: ", 甲);
    // 打印形态：临时向量元素
    打印("乙: ", 造向量().元素(0));
    // 映射临时：大小/获取（结果链）
    打印("丙: ", 造映射().大小());
    结果<整64, 整32> 取 = 造映射().获取(7);
    如果 取.正常 { 打印("丁: ", 取.值); } 否则 { 打印("丁错: ", 取.错误); }
    // 映射临时写（设置）
    结果<空类型, 整32> 设2 = 造映射().设置(8, 888);
    如果 设2.正常 { 打印("戊 ok"); } 否则 { 打印("戊错"); }
    // 结果实例成员（临时承接 + 检查分支读值）
    结果<整32, 整32> 己取 = 造结果();
    如果 己取.正常 { 打印("己: ", 己取.值); } 否则 { 打印("己错"); }
    // 结果链：临时映射获取后取 .值
    结果<整64, 整32> 庚取 = 造映射().获取(7);
    如果 庚取.正常 { 打印("庚: ", 庚取.值); } 否则 { 打印("庚错"); }
    // 临时向量写（追加）
    结果<空类型, 整32> 追2 = 造向量().追加(9);
    如果 追2.正常 { 打印("辛 ok"); } 否则 { 打印("辛错"); }
    // 结构体元素链式字段
    打印("壬: ", 造点表().元素(0).x);
    打印("癸: ", 造点表().元素(0).y);
    返回 0;
}
