// E2E 1568_结果可选八字节载荷字段元素位（#1602·双编译对照正例）：
//   宿主合成体（结果/可选）**8 字节载荷**在结构体字段位/数组元素位的写满与读宽。
//   核心四形态（台账 #1602 指定面·载荷值全部 >2^32 或含负值，32 位写/读即错值）：
//     ①可选<整64> 结构体字段位（结构体字面量初始化位 + 赋值位 + 读回）
//     ②可选<整64> 数组元素位（初始化列表位 + 赋值位 + 读回·下标 0/1）
//     ③结果<整64,整32> 结构体字段位（正常侧 整64 大值 + 错误侧 整32·双侧读回）
//     ④结果<整64,整32> 数组元素位（同上·两元素分置正常/错误）
//   附带锁定两面（同族「聚合内联位」）：
//     ⑤#1588 主缺陷面——窄载荷实参（整32 字面量/变量）进 8 字节载荷目标时按
//       目标宽度 Cast 写满（写侧 8 字节），而非按实参自然宽度写 4 字节（旧行为
//       残留高 4 字节栈垃圾=静默错值；1591 探针 f1/f2/f4/f6 实录形态）。
//     ⑥#1602 本轮根治的结构体**数组字段**（元素=合成体/普通结构体）：聚合元素
//       整块写入（字面量构造/标识符深拷/调用返回浅拷接管/字符串载荷）——原实现
//       元素落标量通道写 8 字节地址（静默错值）+ 步进判定顺序倒置误报内部错误。
//   两侧同源码编译运行，stdout 逐行比对（双编译对照.txt 断言输出=是）。
结构体 载体 {
    可选<整64> 选;
    结果<整64, 整32> 果;
}

结构体 组盒 {
    可选<整64>[2] 选组;
    结果<整64, 整32>[2] 果组;
    可选<字符串>[2] 串组;
}

结构体 盒4 {
    整32 号;
}

结构体 普组 {
    盒4[2] 域;
}

函数 取宽(可选<整64> 参) -> 整64 {
    如果 (参.有值) {
        返回 参.值;
    }
    否则 {
        返回 0 - 1;
    }
}

函数 造选() -> 可选<整64> {
    返回 某些(555000000555);
}

函数 造果() -> 结果<整64, 整32> {
    返回 正常(666000000666);
}

函数 造串() -> 可选<字符串> {
    返回 某些(字符串复制("返回串"));
}

函数 主() -> 整32 {
    // ① 可选<整64> 结构体字段位：字面量初始化位 + 赋值位（整32 窄字面量 → 8 字节载荷）
    载体 甲 = 载体{ 选 = 某些(4294967301), 果 = 正常(4294967302) };
    如果 (甲.选.有值) { 打印("字段初始化=" + 整数转字符串(甲.选.值)); }
    否则 { 打印("字段初始化=无值"); }
    甲.选 = 某些(8589934603);
    如果 (甲.选.有值) { 打印("字段赋值=" + 整数转字符串(甲.选.值)); }
    否则 { 打印("字段赋值=无值"); }
    甲.果 = 正常(0 - 8589934604);
    如果 (甲.果.正常) { 打印("字段果正常=" + 整数转字符串(甲.果.值)); }
    否则 { 打印("字段果正常=错误" + 整数转字符串(甲.果.错误)); }

    // ② 可选<整64> 数组元素位：初始化列表位 + 赋值位
    可选<整64>[2] 乙 = { 某些(10737418245), 某些(12884901886) };
    如果 (乙[0].有值) { 打印("元素初始化0=" + 整数转字符串(乙[0].值)); }
    否则 { 打印("元素初始化0=无值"); }
    如果 (乙[1].有值) { 打印("元素初始化1=" + 整数转字符串(乙[1].值)); }
    否则 { 打印("元素初始化1=无值"); }
    乙[1] = 某些(0 - 10737418247);
    如果 (乙[1].有值) { 打印("元素赋值1=" + 整数转字符串(乙[1].值)); }
    否则 { 打印("元素赋值1=无值"); }

    // ③ 结果<整64,整32> 结构体字段位：正常侧 8 字节大值 + 错误侧 4 字节载荷
    甲.果 = 错误(2000000123);
    如果 (甲.果.正常) { 打印("字段果错误=正常" + 整数转字符串(甲.果.值)); }
    否则 { 打印("字段果错误=" + 整数转字符串(甲.果.错误)); }
    甲.果 = 正常(10737418248);
    如果 (甲.果.正常) { 打印("字段果再正常=" + 整数转字符串(甲.果.值)); }
    否则 { 打印("字段果再正常=错误" + 整数转字符串(甲.果.错误)); }

    // ④ 结果<整64,整32> 数组元素位：元素 0=错误侧 / 元素 1=正常侧
    结果<整64, 整32>[2] 丙;
    丙[0] = 错误(2000000124);
    丙[1] = 正常(0 - 10737418249);
    如果 (丙[0].正常) { 打印("元素果0=正常" + 整数转字符串(丙[0].值)); }
    否则 { 打印("元素果0=" + 整数转字符串(丙[0].错误)); }
    如果 (丙[1].正常) { 打印("元素果1=" + 整数转字符串(丙[1].值)); }
    否则 { 打印("元素果1=错误" + 整数转字符串(丙[1].错误)); }

    // ⑤ 跨函数取值：字段/元素位取出的 8 字节载荷经形参传递不截断
    打印("形参传值=" + 整数转字符串(取宽(乙[0])));

    // ⑥ 结构体数组字段（元素=合成体/普通结构体）：聚合元素整块写入
    可选<整64> 变选 = 某些(4294967311);
    组盒 丁 = 组盒{ 选组 = { 变选, 造选() },
                  果组 = { 造果(), 错误(2000000125) },
                  串组 = { 某些(字符串复制("甲串")), 造串() } };
    如果 (丁.选组[0].有值) { 打印("字段元素选0=" + 整数转字符串(丁.选组[0].值)); }
    否则 { 打印("字段元素选0=无值"); }
    如果 (丁.选组[1].有值) { 打印("字段元素选1=" + 整数转字符串(丁.选组[1].值)); }
    否则 { 打印("字段元素选1=无值"); }
    如果 (丁.果组[0].正常) { 打印("字段元素果0=" + 整数转字符串(丁.果组[0].值)); }
    否则 { 打印("字段元素果0=错误" + 整数转字符串(丁.果组[0].错误)); }
    如果 (丁.果组[1].正常) { 打印("字段元素果1=正常"); }
    否则 { 打印("字段元素果1=" + 整数转字符串(丁.果组[1].错误)); }
    如果 (丁.串组[0].有值) { 打印("字段元素串0=" + 丁.串组[0].值); }
    否则 { 打印("字段元素串0=无值"); }
    如果 (丁.串组[1].有值) { 打印("字段元素串1=" + 丁.串组[1].值); }
    如果 (变选.有值) { 打印("深拷源仍可用=" + 整数转字符串(变选.值)); }
    丁.选组[1] = 某些(0 - 4294967312);
    如果 (丁.选组[1].有值) { 打印("字段元素改=" + 整数转字符串(丁.选组[1].值)); }

    盒4 单盒 = 盒4{ 号 = 7 };
    普组 戊 = 普组{ 域 = { 盒4{ 号 = 5 }, 单盒 } };
    打印("普通组0=" + 整数转字符串(戊.域[0].号) + " 普通组1=" + 整数转字符串(戊.域[1].号));
    返回 0;
}
