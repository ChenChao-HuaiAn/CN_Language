// b6 JSON 生成基准（#728p·366 遗留生成侧同族改造验收锚·2026-10-14）
//   负载：8192 段×32B 字符串数组（构建器构造≈287KB·对齐 b1/b5 的 8192 段口径）。
//   生成 3 轮·每轮独立计时（紧凑形态）。stash 对照（本机·3runs×3 轮取中位）：
//   改前（逐段 字符串连接=每段整串重拷 O(n²) + 子(节,序) 每序号链头重走
//   O(子数²)）宿主 864/885/878ms；改后（构建器直追加+子链一趟）13/12/10ms
//   ——约 70 倍（v2 同源码双侧：907/912/885→10/11/9ms 约 90 倍）。
//   判定：rc=0 且 错误码=0+生成长=286729+往返（再解析再生）错误码=0 且相等=1。
//   解析构造在计时外（本负载解析另有画像——接子尾遍历 O(子数²)·非本基准确认面）。
导入 JSON::{JSON树, 解析JSON, 生成JSON, JSONE_好};

不安全 函数 主() -> 整32 {
    字符串 元素 = "0123456789abcdefghijklmnopqrstuv";
    整64 句 = 字符串构建器::新建();
    字符串构建器::追加(句, "{\"块\":[");
    循环 (整64 k = 0; k < 8192; k++) {
        字符串构建器::追加(句, "\"");
        字符串构建器::追加(句, 元素);
        字符串构建器::追加(句, "\"");
        如果 (k < 8191) {
            字符串构建器::追加(句, ",");
        }
    }
    字符串构建器::追加(句, "]}");
    字符串 大文档 = 字符串构建器::完成(句);
    打印("B6 校验: 文档长=", 整数转字符串(字符串长度(大文档)));

    JSON树 树 = JSON树();
    解析JSON(树, 大文档);
    打印("B6 校验: 错误码=", 整数转字符串(树.错误码));
    如果 (树.错误码 != JSONE_好) {
        返回 1;
    }
    循环 (整64 r = 1; r <= 3; r++) {
        整64 起 = 时间::单调时钟毫秒();
        字符串 出 = 生成JSON(树, 树.根, 0);
        整64 止 = 时间::单调时钟毫秒();
        打印("B6 结果: 第", 整数转字符串(r));
        打印("B6 轮: 耗时毫秒=", 整数转字符串(止 - 起));
        如果 (r == 1) {
            打印("B6 校验: 生成长=", 整数转字符串(字符串长度(出)));
            JSON树 树二 = JSON树();
            解析JSON(树二, 出);
            打印("B6 校验: 往返错误码=", 整数转字符串(树二.错误码));
            字符串 再生 = 生成JSON(树二, 树二.根, 0);
            如果 (字符串比较(出, 再生)) {
                打印("B6 校验: 往返相等=1");
            } 否则 {
                打印("B6 校验: 往返相等=0");
                返回 1;
            }
        }
    }
    返回 0;
}
