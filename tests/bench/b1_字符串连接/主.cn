// b1 字符串连接 O(n²) 基准（#366 实测锚·#367 微基准族·2026-10-09）
//   负载：8192 片 × 32 字节 = 256KB 终串——CN 字符串=不可变 C 串，
//   每次连接=新分配+整串拷贝，k 次拼接=O(k²) 字节拷贝量（8192²/2×32≈1GB）。
//   优化后对拍口径：字符串构建器（#366 待批）落地后本数字应降两个数量级。
//   产物判定：rc=0 且「终串长=262144」（防空转假绿·runner 解析 耗时毫秒=）。
//   计时：时间::单调时钟毫秒 限定名内置直调（36_time 先例·计时差值安全）。
//   输出形态：打印=一行+换行（打印行=不换行·坑已录）。
不安全 函数 主() -> 整32 {
    整64 片数 = 8192;
    字符串 片段 = "0123456789abcdef0123456789abcdef";
    整64 起 = 时间::单调时钟毫秒();
    字符串 大串 = "";
    循环 (整64 k = 0; k < 片数; k++) {
        大串 = 字符串连接(大串, 片段);
    }
    整64 止 = 时间::单调时钟毫秒();
    打印("B1 结果: 耗时毫秒=", 整数转字符串(止 - 起));
    打印("B1 校验: 终串长=", 整数转字符串(字符串长度(大串)));
    返回 0;
}
