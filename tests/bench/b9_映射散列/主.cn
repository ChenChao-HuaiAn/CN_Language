// b9 映射散列基准（#1333·2026-10-25·#1211 审查 P2-6 口径固化入库）
//   负载：200000 键 映射<整64,整64> 设置/获取/删除 三阶段分别计时。
//   来源：#1211 审查 P2-6 曾用临时基准确认映射/集合哈希化不退化，但临时程序
//     未入库、不可复跑；本用例把同一口径固化为 tests/bench 常驻用例。
//   校验（防优化消除·确定值）：
//     值 = 键*3+7，取和 = Σ(3i+7), i∈[0,200000) = 60001100000；
//     删除数 = 200000；删除后余量 = 0。
//   优化档：O0/O2 两档由 scripts/bench_stdlib.py 的 用例优化档 驱动
//     （宿主 -O0/-O2；v2 侧同旗标），本文件不含任何档位逻辑。
//   判定：rc=0 且校验行全中；耗时数字只收集不判优（plans/032 噪声带口径：
//     <2% 无结论，跨机不比绝对值，win 无 PMU 仅参考）。
导入 映射集合::映射;
导入 时间;
导入 字符串扩展::整数转字符串;

不安全 函数 主() -> 整32 {
    整64 n = 200000;
    映射<整64, 整64> 表 = 映射<整64, 整64>();

    // ===== 阶段一：设置（键不存在→追加；200k 键触发桶/数组翻倍扩容） =====
    整64 起设 = 时间::单调时钟毫秒();
    整64 i = 0;
    当 (i < n) {
        结果<空类型, 整32> 设 = 表.设置(i, i * 3 + 7);
        如果 (!设.正常) {
            打印("B9 结果: 第1");
            返回 1;
        }
        i++;
    }
    整64 止设 = 时间::单调时钟毫秒();

    // ===== 阶段二：获取（全命中·累加值形成校验和） =====
    整64 取和 = 0;
    i = 0;
    当 (i < n) {
        结果<整64, 整32> 取 = 表.获取(i);
        如果 (!取.正常) {
            打印("B9 结果: 第2");
            返回 1;
        }
        取和 = 取和 + 取.值;
        i++;
    }
    整64 止取 = 时间::单调时钟毫秒();

    // ===== 阶段三：删除（全命中·链摘除+末元素交换） =====
    整64 删除数 = 0;
    i = 0;
    当 (i < n) {
        如果 (表.删除(i)) {
            删除数++;
        }
        i++;
    }
    整64 止删 = 时间::单调时钟毫秒();

    打印("B9 设置: 耗时毫秒=", 整数转字符串(止设 - 起设));
    打印("B9 获取: 耗时毫秒=", 整数转字符串(止取 - 止设));
    打印("B9 删除: 耗时毫秒=", 整数转字符串(止删 - 止取));
    打印("B9 校验: 取和=", 整数转字符串(取和),
         " 删除=", 整数转字符串(删除数),
         " 余量=", 整数转字符串(表.大小()));
    返回 0;
}
