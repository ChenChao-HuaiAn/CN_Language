// b5 字符串构建器基准（#366 验收锚·#367 微基准族·2026-10-13）
//   负载：与 b1 同源——8192 片 × 32 字节 = 256KB 终串；b1=朴素连接（O(k²)
//   对照组·保持不动），本用例=字符串构建器（预分配缓冲+追加尾插摊还倍增+
//   终态出串·一趟 O(L)·001 §10.3 立法）。
//   验收口径（用户批甲）：b1 vs b5 同机同负载对拍——构建器落地后应降两个
//   数量级（b1 8192²/2×32≈1GB 字节拷贝 vs b5≈256KB 尾插+倍增拷贝）。
//   产物判定：rc=0 且「终串长=262144」（防空转假绿·runner 解析 耗时毫秒=）。
//   计时：时间::单调时钟毫秒 限定名内置直调（b1 同款）。
不安全 函数 主() -> 整32 {
    整64 片数 = 8192;
    字符串 片段 = "0123456789abcdef0123456789abcdef";
    整64 起 = 时间::单调时钟毫秒();
    整64 句 = 字符串构建器::新建();
    循环 (整64 k = 0; k < 片数; k++) {
        字符串构建器::追加(句, 片段);
    }
    字符串 大串 = 字符串构建器::完成(句);
    整64 止 = 时间::单调时钟毫秒();
    打印("B5 结果: 耗时毫秒=", 整数转字符串(止 - 起));
    打印("B5 校验: 终串长=", 整数转字符串(字符串长度(大串)));
    返回 0;
}
