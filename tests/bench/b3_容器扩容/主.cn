// b3 容器结构体元素扩容基准（#368 实测锚·#367 微基准族·2026-10-09）
//   负载：向量<块>（块=16×整64=128 字节）追加 20 万次——翻倍扩容 ~18 次重分配，
//   每次扩容=全量逐元素 CopyStruct 深拷（346-a 通道·#368 推断态主体），
//   累计搬家字节量 ≈ 2×终容量 = 51MB（量级锚定用·数字入册后定优化否）。
//   838 深拷四分支终态为现状基线——先实测锚定再定优化（移动语义/预留/arena）。
//   判定：rc=0 且 尾块和=3199984（(200000-1)×16·防优化消除）。
导入 容器::向量;

结构体 块 {
    整64 甲;
    整64 乙;
    整64 丙;
    整64 丁;
    整64 戊;
    整64 己;
    整64 庚;
    整64 辛;
    整64 壬;
    整64 癸;
    整64 子;
    整64 丑;
    整64 寅;
    整64 卯;
    整64 辰;
    整64 巳;
}

不安全 函数 主() -> 整32 {
    整64 次数 = 200000;

    整64 起 = 时间::单调时钟毫秒();
    向量<块> 表 = 向量<块>();
    循环 (整64 k = 0; k < 次数; k++) {
        块 单 = 块{ 甲 = k, 乙 = k, 丙 = k, 丁 = k, 戊 = k, 己 = k, 庚 = k, 辛 = k,
                    壬 = k, 癸 = k, 子 = k, 丑 = k, 寅 = k, 卯 = k, 辰 = k, 巳 = k };
        结果<空类型, 整32> 追 = 表.追加(单);
    }
    整64 止 = 时间::单调时钟毫秒();

    块 尾 = 表.元素(次数 - 1);
    整64 尾块和 = 尾.甲 + 尾.乙 + 尾.丙 + 尾.丁 + 尾.戊 + 尾.己 + 尾.庚 + 尾.辛
                + 尾.壬 + 尾.癸 + 尾.子 + 尾.丑 + 尾.寅 + 尾.卯 + 尾.辰 + 尾.巳;
    打印("B3 结果: 耗时毫秒=", 整数转字符串(止 - 起));
    打印("B3 校验: 尾块和=", 整数转字符串(尾块和));
    返回 0;
}
