// b2 字节扫描两法对比基准（#361 规避成本锚·#367 微基准族·2026-10-09）
//   甲=查表法（JSON.cn 字节值() 同构：字符串查找 memcmp 无符号健康面——#361
//     规避通道）；乙=直读法（整64(字符) 强转——#361 面·宿主 movsxb 符号扩展
//     错值不影响扫描控制流与耗时，数字=现状口径·清偿后复测对拍）。
//   负载：130 字节 ASCII 样本 × 2400 轮全扫（~31 万字节查找量）。
//   判定：rc=0 且两法 校验和=同值（样本纯 ASCII——#361 只影响 ≥0x80 字节，
//   ASCII 面两法同值=强自证；中文样本直读崩已 348 轮实测在案勿混入）。
不安全 函数 主() -> 整32 {
    字符串 样本 = "The quick brown fox jumps over the lazy dog. 0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ abcdefghijklmnopqrstuvwxyz ~!@#$%^&*()_+ ";
    整64 轮数 = 2400;
    整64 样长 = 字符串长度(样本);

    // 甲：查表法（256 表·JSON.cn 字节值 同构——表存 1~255·索引+1=字节值）
    字符串 字节表 = "";
    循环 (整64 k = 1; k < 256; k++) {
        字节表 = 字符串连接(字节表, 字符转字符串(字符(k)));
    }
    整64 起甲 = 时间::单调时钟毫秒();
    整64 和甲 = 0;
    循环 (整64 r = 0; r < 轮数; r++) {
        循环 (整64 k = 0; k < 样长; k++) {
            和甲 = 和甲 + 字符串查找(字节表, 字符转字符串(样本[k])) + 1;
        }
    }
    整64 止甲 = 时间::单调时钟毫秒();

    // 乙：直读法（#361 面·符号扩展错值不影响控制流与耗时）
    整64 起乙 = 时间::单调时钟毫秒();
    整64 和乙 = 0;
    循环 (整64 r = 0; r < 轮数; r++) {
        循环 (整64 k = 0; k < 样长; k++) {
            和乙 = 和乙 + 整64(样本[k]);
        }
    }
    整64 止乙 = 时间::单调时钟毫秒();

    打印("B2 查表: 耗时毫秒=", 整数转字符串(止甲 - 起甲));
    打印("B2 直读: 耗时毫秒=", 整数转字符串(止乙 - 起乙));
    打印("B2 校验: 查表和=", 整数转字符串(和甲));
    打印("B2 校验: 直读和=", 整数转字符串(和乙));
    返回 0;
}
