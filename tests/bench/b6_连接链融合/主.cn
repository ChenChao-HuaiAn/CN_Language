// b6 连接链融合基准（#728o·2026-10-14）：一次性连接链 `甲+乙+丙+…` 融合
//   （编译器改写为「新建缓冲 -> 逐段追加 -> 完成」一趟构建）的性能对拍锚。
//   负载：全部测量段同「8192 片 × 32 字节 = 256KB 总拼接量」口径（b1/b5 同源）：
//   ① 2 段链 ×40960 轮（不融合·原路径对照——链长 < 阈值 3）
//   ② 4 段链 ×20480 轮（融合·边界形态）
//   ③ 8 段链 ×10240 轮（融合）
//   ④ 16 段链 ×5120 轮（融合·长链）
//   ⑤ 循环累积 8192 轮（`大串 = 大串 + 片段` 加号链形态·k=2 每轮不融合=
//      b1 同负载对照：证明融合不改写累积二元形态·数字与 b1 同量级）
//   每段校验和=2621440（81920 片×32B 口径·防空转假绿·runner 解析 耗时毫秒=）。
//   计时：时间::单调时钟毫秒 限定名内置直调（b1 同款）。
不安全 函数 主() -> 整32 {
    字符串 片段 = "0123456789abcdef0123456789abcdef";

    // ① 2 段链（不融合·原路径对照）
    整64 起2 = 时间::单调时钟毫秒();
    整64 字节前2 = 内存::总分配字节();
    整64 次数前2 = 内存::总分配次数();
    整64 和2 = 0;
    循环 (整64 k = 0; k < 40960; k++) {
        字符串 块 = 片段 + 片段;
        和2 = 和2 + 字符串长度(块);
    }
    整64 止2 = 时间::单调时钟毫秒();
    整64 字节差2 = 内存::总分配字节() - 字节前2;
    整64 次数差2 = 内存::总分配次数() - 次数前2;

    // ② 4 段链（融合）
    整64 起4 = 时间::单调时钟毫秒();
    整64 字节前4 = 内存::总分配字节();
    整64 次数前4 = 内存::总分配次数();
    整64 和4 = 0;
    循环 (整64 k = 0; k < 20480; k++) {
        字符串 块 = 片段 + 片段 + 片段 + 片段;
        和4 = 和4 + 字符串长度(块);
    }
    整64 止4 = 时间::单调时钟毫秒();
    整64 字节差4 = 内存::总分配字节() - 字节前4;
    整64 次数差4 = 内存::总分配次数() - 次数前4;

    // ③ 8 段链（融合）
    整64 起8 = 时间::单调时钟毫秒();
    整64 字节前8 = 内存::总分配字节();
    整64 次数前8 = 内存::总分配次数();
    整64 和8 = 0;
    循环 (整64 k = 0; k < 10240; k++) {
        字符串 块 = 片段 + 片段 + 片段 + 片段 + 片段 + 片段 + 片段 + 片段;
        和8 = 和8 + 字符串长度(块);
    }
    整64 止8 = 时间::单调时钟毫秒();
    整64 字节差8 = 内存::总分配字节() - 字节前8;
    整64 次数差8 = 内存::总分配次数() - 次数前8;

    // ④ 16 段链（融合·长链）
    整64 起16 = 时间::单调时钟毫秒();
    整64 字节前16 = 内存::总分配字节();
    整64 次数前16 = 内存::总分配次数();
    整64 和16 = 0;
    循环 (整64 k = 0; k < 5120; k++) {
        字符串 块 = 片段 + 片段 + 片段 + 片段 + 片段 + 片段 + 片段 + 片段
                  + 片段 + 片段 + 片段 + 片段 + 片段 + 片段 + 片段 + 片段;
        和16 = 和16 + 字符串长度(块);
    }
    整64 止16 = 时间::单调时钟毫秒();
    整64 字节差16 = 内存::总分配字节() - 字节前16;
    整64 次数差16 = 内存::总分配次数() - 次数前16;

    // ⑤ 循环累积加号链形态（k=2 每轮——b1 同负载·不融合对照）
    整64 起累 = 时间::单调时钟毫秒();
    整64 字节前累 = 内存::总分配字节();
    整64 次数前累 = 内存::总分配次数();
    字符串 大串 = "";
    循环 (整64 k = 0; k < 8192; k++) {
        大串 = 大串 + 片段;
    }
    整64 止累 = 时间::单调时钟毫秒();
    整64 字节差累 = 内存::总分配字节() - 字节前累;
    整64 次数差累 = 内存::总分配次数() - 次数前累;

    打印("B6 段2 耗时毫秒=", 整数转字符串(止2 - 起2));
    打印("B6 段4 耗时毫秒=", 整数转字符串(止4 - 起4));
    打印("B6 段8 耗时毫秒=", 整数转字符串(止8 - 起8));
    打印("B6 段16 耗时毫秒=", 整数转字符串(止16 - 起16));
    打印("B6 累积 耗时毫秒=", 整数转字符串(止累 - 起累));
    打印("B6 校验: 和2=", 整数转字符串(和2));
    打印("B6 校验: 和4=", 整数转字符串(和4));
    打印("B6 校验: 和8=", 整数转字符串(和8));
    打印("B6 校验: 和16=", 整数转字符串(和16));
    打印("B6 校验: 累积长=", 整数转字符串(字符串长度(大串)));
    打印("B6 字节: 2=", 整数转字符串(字节差2), " 4=", 整数转字符串(字节差4),
         " 8=", 整数转字符串(字节差8), " 16=", 整数转字符串(字节差16),
         " 累=", 整数转字符串(字节差累));
    打印("B6 次数: 2=", 整数转字符串(次数差2), " 4=", 整数转字符串(次数差4),
         " 8=", 整数转字符串(次数差8), " 16=", 整数转字符串(次数差16),
         " 累=", 整数转字符串(次数差累));
    返回 0;
}
