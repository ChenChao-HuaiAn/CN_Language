// b7 容器结构体扩容对照组基准（#368 实测锚定转化·2026-10-19）
//   同负载双组（128B 结构体 × 20 万追加）：
//     ① 无预留——触发 ~17 次翻倍 realloc（0→4→8→…→262144）
//     ② 预留(次数)——零扩容
//   两组耗时差 = 扩容真实成本（#368 实测结论：差在噪声内，扩容走
//   cn_realloc 的原地扩展/mremap，非逐元素 CopyStruct 深拷）。
//   判定：两组尾块和均为 3199984（(200000-1)×16·防优化消除）。
导入 容器::向量;

结构体 块 {
    整64 甲;
    整64 乙;
    整64 丙;
    整64 丁;
    整64 戊;
    整64 己;
    整64 庚;
    整64 辛;
    整64 壬;
    整64 癸;
    整64 子;
    整64 丑;
    整64 寅;
    整64 卯;
    整64 辰;
    整64 巳;
}

不安全 函数 主() -> 整32 {
    整64 次数 = 200000;

    // ===== ① 无预留组（扩容路径） =====
    整64 起无 = 时间::单调时钟毫秒();
    向量<块> 表无 = 向量<块>();
    循环 (整64 k = 0; k < 次数; k++) {
        块 单 = 块{ 甲 = k, 乙 = k, 丙 = k, 丁 = k, 戊 = k, 己 = k, 庚 = k, 辛 = k,
                    壬 = k, 癸 = k, 子 = k, 丑 = k, 寅 = k, 卯 = k, 辰 = k, 巳 = k };
        结果<空类型, 整32> 追无 = 表无.追加(单);
    }
    整64 止无 = 时间::单调时钟毫秒();
    块 尾无 = 表无.元素(次数 - 1);
    整64 验无 = 尾无.甲 + 尾无.乙 + 尾无.丙 + 尾无.丁 + 尾无.戊 + 尾无.己 + 尾无.庚
              + 尾无.辛 + 尾无.壬 + 尾无.癸 + 尾无.子 + 尾无.丑 + 尾无.寅 + 尾无.卯
              + 尾无.辰 + 尾无.巳;
    打印("B7 无预留: 耗时毫秒=", 整数转字符串(止无 - 起无));
    打印("B7 校验: 无预留验=", 整数转字符串(验无));

    // ===== ② 预留组（零扩容） =====
    整64 起预 = 时间::单调时钟毫秒();
    向量<块> 表预 = 向量<块>();
    结果<空类型, 整32> 预 = 表预.预留(次数);
    循环 (整64 k = 0; k < 次数; k++) {
        块 单 = 块{ 甲 = k, 乙 = k, 丙 = k, 丁 = k, 戊 = k, 己 = k, 庚 = k, 辛 = k,
                    壬 = k, 癸 = k, 子 = k, 丑 = k, 寅 = k, 卯 = k, 辰 = k, 巳 = k };
        结果<空类型, 整32> 追预 = 表预.追加(单);
    }
    整64 止预 = 时间::单调时钟毫秒();
    块 尾预 = 表预.元素(次数 - 1);
    整64 验预 = 尾预.甲 + 尾预.乙 + 尾预.丙 + 尾预.丁 + 尾预.戊 + 尾预.己 + 尾预.庚
              + 尾预.辛 + 尾预.壬 + 尾预.癸 + 尾预.子 + 尾预.丑 + 尾预.寅 + 尾预.卯
              + 尾预.辰 + 尾预.巳;
    打印("B7 预留: 耗时毫秒=", 整数转字符串(止预 - 起预));
    打印("B7 校验: 预留验=", 整数转字符串(验预));

    返回 0;
}
