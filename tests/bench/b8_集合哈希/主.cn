// b8 集合哈希增删查基准（#1211·2026-10-21 集合 线性表→哈希桶）
//   负载：20000 键 添加 / 命中查 / 漏检查 / 删除 四段分别计时（同负载口径）。
//   对照：哈希化前（线性表 O(n) 包含扫描）20000 键实测
//     添加 225~351ms / 命中 240~319ms / 漏检 503~548ms / 删除 850~1063ms；
//   哈希版期望四段均毫秒级（数字只收集不判优——优化对拍由人按规程执行）。
//   判定：rc=0 且校验行（命中=20000 漏中=0 删除=20000 余量=0）。
导入 映射集合::集合;
导入 时间;
导入 字符串扩展::整数转字符串;

不安全 函数 主() -> 整32 {
    整64 n = 20000;
    集合<整64> 集 = 集合<整64>();
    整64 起加 = 时间::单调时钟毫秒();
    整64 i = 0;
    当 (i < n) {
        结果<空类型, 整32> 加 = 集.添加(i);
        如果 (!加.正常) {
            打印("B8 结果: 第1");
            返回 1;
        }
        i++;
    }
    整64 止加 = 时间::单调时钟毫秒();
    整64 命中 = 0;
    i = 0;
    当 (i < n) {
        如果 (集.包含(i)) {
            命中++;
        }
        i++;
    }
    整64 止查 = 时间::单调时钟毫秒();
    整64 漏中 = 0;
    i = 0;
    当 (i < n) {
        如果 (集.包含(i + n)) {
            漏中++;
        }
        i++;
    }
    整64 止漏 = 时间::单调时钟毫秒();
    整64 删除数 = 0;
    i = 0;
    当 (i < n) {
        如果 (集.删除(i)) {
            删除数++;
        }
        i++;
    }
    整64 止删 = 时间::单调时钟毫秒();
    打印("B8 添加: 耗时毫秒=", 整数转字符串(止加 - 起加));
    打印("B8 命中: 耗时毫秒=", 整数转字符串(止查 - 止加));
    打印("B8 漏检查: 耗时毫秒=", 整数转字符串(止漏 - 止查));
    打印("B8 删除: 耗时毫秒=", 整数转字符串(止删 - 止漏));
    打印("B8 校验: 命中=", 整数转字符串(命中),
         " 漏中=", 整数转字符串(漏中),
         " 删除=", 整数转字符串(删除数),
         " 余量=", 整数转字符串(集.大小()));
    返回 0;
}
