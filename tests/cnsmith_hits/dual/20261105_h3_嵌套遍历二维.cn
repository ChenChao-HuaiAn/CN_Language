// H3 嵌套遍历（二维数组行列求和）
函数 主() -> 整32 {
    整32[2][3] 矩阵;
    循环 (整32 i = 0; i < 2; i += 1) {
        循环 (整32 j = 0; j < 3; j += 1) {
            矩阵[i][j] = i * 10 + j;
        }
    }
    整32 总 = 0;
    遍历 矩阵 中 每个 一行 {
        遍历 一行 中 每个 v {
            总 = 总 + v;
        }
    }
    打印行("二维总=", 总);
    返回 0;
}
