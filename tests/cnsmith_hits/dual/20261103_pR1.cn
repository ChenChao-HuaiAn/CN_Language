// R1: 一个类实现两接口·同名方法
接口 可画 {
    虚拟 函数 画() -> 整32;
}

接口 可算 {
    虚拟 函数 面积() -> 浮64;
}

类 方块 : 可画, 可算 {
公开:
    整32 边;
    函数 方块(整32 s) { 边 = s; }
    重写 函数 画() -> 整32 { 返回 边; }
    重写 函数 面积() -> 浮64 { 返回 边 * 边; }
}

函数 主() -> 整32 {
    方块 f = 方块(3);
    可画 d = f;
    打印(d.画());
    可算 s = f;
    打印(s.面积());
    返回 0;
}
