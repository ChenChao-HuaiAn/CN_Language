接口 形状 { 虚拟 函数 面积() -> 整32 }
类 圆 : 形状 {
公开:
    整32 半径;
    函数 圆(整32 r) { 半径 = r; }
    虚拟 函数 面积() -> 整32 { 返回 3 * 半径 * 半径; }
}
类 方 : 形状 {
公开:
    整32 边;
    函数 方(整32 a) { 边 = a; }
    虚拟 函数 面积() -> 整32 { 返回 边 * 边; }
}
函数 主() -> 整32 {
    圆 c = 圆(2);
    方 s = 方(3);
    形状* p = c;         // ①类值→接口指针 初始化（v2 认）
    打印(p.面积());
    形状* q = s;         // ②方值→接口指针 初始化（v2 认否）
    打印(q.面积());
    p = q;               // ③接口指针→接口指针 赋值
    打印(p.面积());
    p = s;               // ④类值→接口指针 赋值（宿主认 v2 拒）
    打印(p.面积());
    返回 0;
}
