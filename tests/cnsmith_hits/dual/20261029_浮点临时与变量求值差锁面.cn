函数 主() -> 整32 {
    浮32 f = 0.1f;
    浮32 g = f + f;
    打印((f + f - 0.2f) * 1000000000.0f);    // 差×10^9：0=精确 0.2f
    打印((g - 0.2f) * 1000000000.0f);        // 变量版差
    打印(g * 100.0f);                        // g×100 应=20.000003
    打印(0.2f * 100.0f);                     // 0.2f×100
    打印((0.1f + 0.1f - 0.2f) * 1000000000.0f);  // 全字面量差
    打印((0.2f - g) * 1000000000.0f);        // 反向差
    返回 0;
}
