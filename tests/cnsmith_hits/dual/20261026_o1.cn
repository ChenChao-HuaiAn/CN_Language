// O1 类成员运算符+ 重载（二元加·返回类实例）
类 复数 {
公开:
    整32 实;
    整32 虚;
    函数 运算符+(复数& o) -> 复数 {
        复数 r;
        r.实 = 实 + o.实;
        r.虚 = 虚 + o.虚;
        返回 r;
    }
}
函数 主() -> 整32 {
    复数 a;
    a.实 = 1;
    a.虚 = 2;
    复数 b;
    b.实 = 10;
    b.虚 = 20;
    复数 c = a + b;
    打印行(c.实);
    打印行(c.虚);
    返回 0;
}
