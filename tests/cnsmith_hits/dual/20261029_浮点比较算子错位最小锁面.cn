函数 主() -> 整32 {
    浮32 f = 0.1f;
    打印(f + f - 0.2f == 0.0f);      // ① 差==0 应真
    打印(f + f - 0.2f >= 0.0f);      // ② 差>=0 应真
    打印(f + f - 0.2f <= 0.0f);      // ③ 差<=0 应真
    打印(f + f - 0.2f != 0.0f);      // ④ 差!=0 应假
    打印(f + f - 0.2f > 0.0f);       // ⑤ 差>0 应假
    打印(f + f - 0.2f < 0.0f);       // ⑥ 差<0 应假
    返回 0;
}
