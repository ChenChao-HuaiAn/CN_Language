// A4 可选<可选<整32>> 嵌套构造与双层检查
函数 主() -> 整32 {
    可选<可选<整32>> 甲 = 某些(某些(5));
    可选<可选<整32>> 乙 = 某些(无);
    可选<可选<整32>> 丙 = 无;
    如果 甲.有值 {
        如果 甲.值.有值 { 打印行(甲.值.值); } 否则 { 打印行(1); }
    } 否则 { 打印行(2); }
    如果 乙.有值 {
        如果 乙.值.有值 { 打印行(乙.值.值); } 否则 { 打印行(3); }
    } 否则 { 打印行(4); }
    如果 丙.有值 { 打印行(9); } 否则 { 打印行(5); }
    返回 0;
}
