// C3 友元类：类 B 全方法访问 类 A 私有
类 甲类 {
私有:
    整64 秘密;
公开:
    函数 甲类() { 秘密 = 42; }
    友元 类 乙类
}
类 乙类 {
公开:
    函数 读秘密(甲类& 目标) -> 整64 { 返回 目标.秘密; }
    函数 写秘密(甲类& 目标, 整64 v) -> 空类型 { 目标.秘密 = v; }
}
函数 主() -> 整32 {
    甲类 甲 = 甲类();
    乙类 乙 = 乙类();
    打印行("秘密=", 乙.读秘密(甲));
    乙.写秘密(甲, 99);
    打印行("新秘密=", 乙.读秘密(甲));
    返回 0;
}
