// O2 运算符== 重载（对象相等判定）
类 点 {
公开:
    整32 x;
    整32 y;
    函数 运算符==(点& o) -> 布尔 {
        如果 x == o.x && y == o.y {
            返回 真;
        }
        返回 假;
    }
}
函数 主() -> 整32 {
    点 a;
    a.x = 1;
    a.y = 2;
    点 b;
    b.x = 1;
    b.y = 2;
    如果 a == b { 打印行(1); } 否则 { 打印行(0); }
    返回 0;
}
