// J4 位运算与比较符优先级（C 坑位 甲 & 3 == 3）
函数 主() -> 整32 {
    整32 甲 = 6;
    整32 r1 = 甲 & 3;
    打印行("与3=", r1);
    布尔 r2 = (甲 & 6) == 6;
    如果 (r2) { 打印行("括号判真"); } 否则 { 打印行("括号判假"); }
    布尔 r3 = 甲 & 6 == 6;
    如果 (r3) { 打印行("无括号真"); } 否则 { 打印行("无括号假"); }
    整32 r4 = 甲 | 1 ^ 3;
    打印行("或异或=", r4);
    返回 0;
}
