函数 主() -> 整32 {
    浮32 f = 0.1f;
    打印(f + f == 0.2f);         // ①应真
    浮32 g = f + f;
    打印(g == 0.2f);             // ②变量版应真
    打印(0.1f + 0.1f == 0.2f);   // ③全字面量应真
    打印(f * 2.0f == 0.2f);      // ④乘法版应真
    打印(g == f + f);            // ⑤自洽应真
    打印(g - f == f);            // ⑥减法自洽应真
    返回 0;
}
