    整64 变2 = -86311L;
    整64 变3 = 64777L;
    打印行("变3 = ", 变3);
    整32 变4 = ((-861 * (整32(变3) >> 30)) & 633);
    打印行("变4 = ", 变4);
    整64 变5 = 83163L;
    打印行("变5 = ", 变5);
    整32 变6 = (整32(变3) & ((变4 / 4) / 7));
    整64 变7 = ((((((变6 != 整32(变2)) ? 1 : 0) >= 339) && (((变6 ^ 整32(变5)) - (331 * -937)) <= -924)) ? 1 : 0) % 2);
    打印行("变7 = ", 变7);
    整32 变8 = (((780 == 整32(变3)) ? 1 : 0) * 整32(变3));
    打印行("变8 = ", 变8);
    整64 变9 = 253L;
    打印行("变9 = ", 变9);
    整64 变10 = -64811L;
    整64 变11 = -19973L;
    打印行("变11 = ", 变11);
    变量 变12 = "x" + 变11 + "乙" + 0.5 + "9";
    打印行("变12 = ", 变12);
    整32 变13 = ((934 < 969) ? 1 : 0);
    整64 变14 = 81603L;
    循环 (整32 轮 = 0; 轮 < 3; 轮 += 1) {
        改全1(读全1() + 轮);
        如果 (轮 == 1) {
            打印行("轮1 读全1 = ", 读全1());
