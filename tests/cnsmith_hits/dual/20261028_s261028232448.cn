整32 全1 = 99;
整32 全2 = 31;
函数 读全1() -> 整32 { 返回 全1; }
不安全 函数 改全1(整32 v) -> 空类型 { 全1 = v; }
函数 主() -> 整32 {
    打印行("=== CN-Smith 采样 ===");
    整32 全1 = 236;
