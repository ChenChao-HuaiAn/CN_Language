// O5 运算符< 重载（排序式比较）
类 版本 {
公开:
    整32 主号;
    函数 运算符<(版本& o) -> 布尔 {
        如果 主号 < o.主号 {
            返回 真;
        }
        返回 假;
    }
}
函数 主() -> 整32 {
    版本 a;
    a.主号 = 3;
    版本 b;
    b.主号 = 7;
    如果 a < b { 打印行(1); } 否则 { 打印行(0); }
    如果 b < a { 打印行(1); } 否则 { 打印行(0); }
    返回 0;
}
