// 扩展 D6：泛型类实现两个接口（多接口实现位）
接口 可取值 {
    虚拟 函数 取值() -> 整32;
}
接口 可显示 {
    虚拟 函数 显示() -> 字符串;
}
泛型 <类型 T>
类 盒子 : 可取值, 可显示 {
公开:
    T 值;
    函数 盒子(T 初) { 值 = 初; }
    重写 函数 取值() -> 整32 { 返回 1; }
    重写 函数 显示() -> 字符串 { 返回 "盒"; }
}
函数 主() -> 整32 {
    盒子<整32> a = 盒子<整32>(7);
    打印(a.取值());
    打印(a.显示());
    返回 0;
}
