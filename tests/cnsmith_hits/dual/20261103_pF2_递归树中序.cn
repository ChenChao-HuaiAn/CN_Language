// 探针 F2：二叉树递归中序遍历（空指针=无）
结构体 树节点 {
    整32 v;
    树节点* 左;
    树节点* 右;
}
不安全 函数 中序(树节点* n) -> 空类型 {
    如果 (n == 无) { 返回; }
    中序(n.左);
    打印(n.v);
    中序(n.右);
    返回;
}
不安全 函数 主() -> 整32 {
    树节点* 根 = 分配(类型大小(树节点));
    根.v = 2;
    根.左 = 分配(类型大小(树节点));
    根.左.v = 1;
    根.左.左 = 无;
    根.左.右 = 无;
    根.右 = 分配(类型大小(树节点));
    根.右.v = 3;
    根.右.左 = 无;
    根.右.右 = 无;
    中序(根);
    释放(根.左);
    释放(根.右);
    释放(根);
    返回 0;
}
