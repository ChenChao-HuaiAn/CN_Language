函数 主() -> 整32 {
    整32 a = 3;
    整32 b = 3;
    打印(a + b - 6 == 0);        // ① 整数== 应真
    打印(a == 3);                // ② 变量==字面量
    打印(a + b == 6);            // ③ 临时==字面量
    打印(a - b == 0);            // ④ 临时==0
    打印(a != b);                // ⑤ !=应假
    打印(a < b);                 // ⑥ <应假
    打印(a <= b);                // ⑦ <=应真
    打印(a >= b);                // ⑧ >=应真
    打印(a > b);                 // ⑨ >应假
    整64 c = 3;
    打印(c == 3);                // ⑩ 整64==
    返回 0;
}
