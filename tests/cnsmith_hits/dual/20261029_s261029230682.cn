整32 全1 = 4;
整32 全2 = 63;
整32 全3 = 80;
函数 读全1() -> 整32 { 返回 全1; }
不安全 函数 改全1(整32 v) -> 空类型 { 全1 = v; }
函数 主() -> 整32 {
    打印行("=== CN-Smith 采样 ===");
    整32 全1 = 253;
    打印行("遮蔽局部全1 = ", 全1);
    整64 变1 = 93440L;
    变量 变2 = (变1 > 0) ? 1 : 2.5;
    打印行("变2 = ", 变2);
    整64 变3 = -45756L;
    整64 变4 = 1024L;
    整32 变5 = ((整32(变1) ^ 整32(变4)) - 393);
    打印行("变5 = ", 变5);
    变量 变6 = "x" + 变5 + "." + 变2 + "!";
    打印行("变6 = ", 变6);
    整32 变7 = 168;
    整32 变8 = -484;
    打印行("变8 = ", 变8);
    变量 变9 = 2.5 * 变1;
    打印行("变9 = ", 变9);
    整32 变10 = -110;
    打印行("变10 = ", 变10);
    整64 变11 = -29628L;
    打印行("变11 = ", 变11);
    变量 变12 = (变1 > 0) ? 1 : 2.5;
    打印行("变12 = ", 变12);
    变量 变13 = "v" + 555 + "中" + 1.5 + "end";
    打印行("变13 = ", 变13);
    整64 变14 = 变4;
    循环 (整32 轮 = 0; 轮 < 3; 轮 += 1) {
        改全1(读全1() + 轮);
        如果 (轮 == 1) {
            打印行("轮1 读全1 = ", 读全1());
        } 否则 {
            打印行("轮非1 跳过");
        }
    }
    打印行("done");
    返回 0;
}