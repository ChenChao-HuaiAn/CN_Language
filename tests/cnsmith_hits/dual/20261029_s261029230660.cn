整32 全1 = 29;
函数 读全1() -> 整32 { 返回 全1; }
不安全 函数 改全1(整32 v) -> 空类型 { 全1 = v; }
函数 主() -> 整32 {
    打印行("=== CN-Smith 采样 ===");
    整32 全1 = 238;
    打印行("遮蔽局部全1 = ", 全1);
    变量 变1 = 0.25 * 39;
    打印行("变1 = ", 变1);
    整32 变2 = 257;
    打印行("变2 = ", 变2);
    整32 变3 = ((变2 << 7) | 变2);
    整64 变4 = 整64(变3);
    整32 变5 = -530;
    打印行("变5 = ", 变5);
    整32 变6 = 变3;
    打印行("变6 = ", 变6);
    整32 变7 = 整32(变4);
    打印行("变7 = ", 变7);
    整32 变8 = -739;
    打印行("变8 = ", 变8);
    整64 变9 = -23424L;
    打印行("变9 = ", 变9);
    整32 变10 = ((473 % 6) + ((-755 / 5) / 1));
    打印行("变10 = ", 变10);
    变量 变11 = (变7 > 0) ? 1 : 2.5;
    打印行("变11 = ", 变11);
    整64 变12 = -36596L;
    打印行("变12 = ", 变12);
    变量 变13 = 变8 - 0.25;
    打印行("变13 = ", 变13);
    整64 变14 = -793L;
    打印行("变14 = ", 变14);
    循环 (整32 轮 = 0; 轮 < 3; 轮 += 1) {
        改全1(读全1() + 轮);
        如果 (轮 == 1) {
            打印行("轮1 读全1 = ", 读全1());
        } 否则 {
            打印行("轮非1 跳过");
        }
    }
    打印行("done");
    返回 0;
}