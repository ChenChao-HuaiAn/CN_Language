整32 全1 = 63;
函数 读全1() -> 整32 { 返回 全1; }
不安全 函数 改全1(整32 v) -> 空类型 { 全1 = v; }
函数 主() -> 整32 {
    打印行("=== CN-Smith 采样 ===");
    整32 全1 = 254;
    打印行("遮蔽局部全1 = ", 全1);
    整64 变1 = -26691L;
    整32 变2 = -928;
    打印行("变2 = ", 变2);
    整64 变3 = 变1;
    变量 变4 = "前" + 变3 + "乙" + 0.5 + "end";
    打印行("变4 = ", 变4);
    整32 变5 = 87;
    打印行("变5 = ", 变5);
    整64 变6 = 整64(变5);
    打印行("变6 = ", 变6);
    变量 变7 = 0.25 * 变2;
    打印行("变7 = ", 变7);
    整32 变8 = (((整32(变3) <= 整32(变1)) || (-446 < 357)) ? 1 : 0);
    打印行("变8 = ", 变8);
    整32 变9 = (-963 / 7);
    打印行("变9 = ", 变9);
    变量 变10 = 变9 - 2.5;
    打印行("变10 = ", 变10);
    变量 变11 = "甲" + 变3 + "-" + 0.5 + "end";
    打印行("变11 = ", 变11);
    整64 变12 = 58289L;
    整64 变13 = 变6;
    打印行("变13 = ", 变13);
    整32 变14 = -276;
    循环 (整32 轮 = 0; 轮 < 3; 轮 += 1) {
        改全1(读全1() + 轮);
        如果 (轮 == 1) {
            打印行("轮1 读全1 = ", 读全1());
        } 否则 {
            打印行("轮非1 跳过");
        }
    }
    打印行("done");
    返回 0;
}