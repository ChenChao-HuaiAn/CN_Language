// 探针 p10：浮点边界（负零/精度/混合宽度比较，生成器未覆盖域）
函数 主() -> 整32 {
    浮64 零 = 0.0;
    浮64 负零 = -零;
    打印(负零 == 零);          // true（IEEE 负零相等）
    打印(整32(负零 < 零));     // false

    打印(0.1 + 0.2 == 0.3);    // false（二进制浮点经典）
    浮64 a = 0.1 + 0.2;
    打印(a > 0.3);             // true（0.30000000000000004）

    浮32 f = 0.1f;
    打印(f + f == 0.2f);       // 0.2f 可精确表示比较（0.1f 不精确但和可能等于 0.2f）

    浮64 大 = 1e300;
    打印(大 * 大 > 0);         // inf > 0 = true
    打印(大 * 大 == 大 * 大);  // inf == inf = true

    浮64 负大 = -1e300;
    打印(负大 * 大 < 0);       // -inf < 0 = true

    整64 巨 = 9223372036854775807;
    浮64 转 = 浮64(巨);
    打印(转 > 0.0);            // true

    浮32 半 = 1.5f;
    打印(半 * 2.0f == 3.0f);   // true（精确）
    打印(半 + 0.1);            // 混合宽度提升打浮64
    返回 0;
}
