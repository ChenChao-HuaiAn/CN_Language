    整32 变4 = 779;
    整32 变5 = ((-830 != 517) ? 1 : 0);
    整32 变6 = 整32(变1);
    变量 变7 = "甲" + 变4 + "乙" + 3.5 + "尾";
    打印行("变7 = ", 变7);
