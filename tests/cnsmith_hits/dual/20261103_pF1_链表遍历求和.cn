// 探针 F1：堆分配单链表 构建→遍历求和→逐个释放（空指针=无）
结构体 节点 {
    整32 值;
    节点* 下;
}
不安全 函数 主() -> 整32 {
    节点* 头 = 分配(类型大小(节点));
    头.值 = 1;
    头.下 = 分配(类型大小(节点));
    头.下.值 = 2;
    头.下.下 = 分配(类型大小(节点));
    头.下.下.值 = 4;
    头.下.下.下 = 无;
    节点* p = 头;
    整32 总 = 0;
    当 (p != 无) {
        总 = 总 + p.值;
        p = p.下;
    }
    打印(总);
    释放(头.下.下);
    释放(头.下);
    释放(头);
    返回 0;
}
