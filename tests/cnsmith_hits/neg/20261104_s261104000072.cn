// 族=嵌套构造
函数 主() -> 整32 {
    可选<可选<整32>> 甲 = 某些(某些(5));
    可选<可选<整32>> 乙 = 某些(无);
    可选<可选<整32>> 丙 = 无;
    整32 总 = 0;
    如果 甲.有值 {
        如果 甲.值.有值 { 总 = 甲.值.值; }
    }
    如果 乙.有值 {
        如果 乙.值.有值 { 总 = 总 + 乙.值.无此成员; }
    }
    如果 丙.有值 {
        如果 丙.值.有值 { 总 = 总 + 丙.值.值; }
    }
    打印行(总);
    返回 0;
}
