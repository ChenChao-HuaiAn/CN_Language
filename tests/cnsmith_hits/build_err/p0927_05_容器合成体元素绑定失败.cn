// v3f：向量<结果<类,整32>> 容器元素=合成体（元素槽宽/追加拷贝/元素取回）
导入 容器::向量;

类 盒子 {
    公开:
    整32 值;
    函数 盒子() { 值 = 5; }
    函数 盒子(盒子& 其他) { 值 = 其他.值; }
}

函数 主() -> 整32 {
    向量<结果<盒子, 整32>> 表 = 向量<结果<盒子, 整32>>();
    结果<空类型, 整32> 追 = 表.追加(正常(盒子()));
    如果 (!追.正常) { 返回 1; }
    结果<空类型, 整32> 追2 = 表.追加(错误(42));
    如果 (!追2.正常) { 返回 1; }
    结果<盒子, 整32> 取 = 表.元素(0);
    如果 (取.正常) {
        盒子 b = 取.值;
        打印行("v3f=", b.值);
    } 否则 { 返回 3; }
    结果<盒子, 整32> 取2 = 表.元素(1);
    如果 (!取2.正常) {
        打印行("v3fe=", 取2.错误);
        返回 0;
    }
    返回 2;
}
