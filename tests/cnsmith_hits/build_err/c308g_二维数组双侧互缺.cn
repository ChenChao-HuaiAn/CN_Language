// v15·d3 二维数组 语义面（无初始化器）：声明+逐元素写+读+传参
函数 总和(整32[2][3] m) -> 整32 {
    整32 s = 0;
    循环 (整32 i = 0; i < 2; i++) {
        循环 (整32 j = 0; j < 3; j++) {
            s = s + m[i][j];
        }
    }
    返回 s;
}
函数 主() -> 整32 {
    整32[2][3] 矩阵;
    矩阵[0][0] = 1;
    矩阵[0][1] = 2;
    矩阵[0][2] = 3;
    矩阵[1][0] = 4;
    矩阵[1][1] = 5;
    矩阵[1][2] = 6;
    打印行(矩阵[1][2]);
    打印行(总和(矩阵));
    返回 0;
}
