// v16·b1 结构体数组组链（避开 0 指针与自引用初始化·两分叉另录）
结构体 节点 {
    整32 值;
    节点* 下一个;
}
不安全 函数 主() -> 整32 {
    节点[3] 表 = { 节点{ 值 = 1, 下一个 = 0 }, 节点{ 值 = 2, 下一个 = 0 }, 节点{ 值 = 99, 下一个 = 0 } };
    表[0].下一个 = &表[1];
    表[1].下一个 = &表[2];
    节点* p = &表[0];
    当 (p.值 != 99) {
        打印行(p.值);
        p = p.下一个;
    }
    打印行(p.值);
    返回 0;
}
