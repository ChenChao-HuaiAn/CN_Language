// v3o：函数内 静态 局部 结果<类,整32>（静态局部槽×合成体·87-a 静态全链边缘）
类 盒子 {
    公开:
    整32 值;
    函数 盒子() { 值 = 5; }
    函数 盒子(盒子& 其他) { 值 = 其他.值; }
}

函数 取全局() -> 结果<盒子, 整32> {
    静态 结果<盒子, 整32> 槽 = 正常(盒子());
    返回 槽;
}

函数 主() -> 整32 {
    结果<盒子, 整32> r = 取全局();
    如果 (r.正常) {
        盒子 b = r.值;
        打印行("v3o=", b.值);
        返回 0;
    }
    返回 2;
}
