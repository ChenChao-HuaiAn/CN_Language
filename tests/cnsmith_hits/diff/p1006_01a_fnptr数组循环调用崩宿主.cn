// C 族（235 采样·001 §5.8 函数指针·040 收官邻接面）
// 回调表：数组元素位 fnptr 逐元素赋值+遍历分发累加
函数 加一(整32 x) -> 整32 { 返回 x + 1; }
函数 加倍(整32 x) -> 整32 { 返回 x * 2; }
函数 加三(整32 x) -> 整32 { 返回 x + 3; }

函数 主() -> 整32 {
    整32(*表[3])(整32);
    表[0] = 加一;
    表[1] = 加倍;
    表[2] = 加三;
    整32 累计 = 0;
    整32 i = 0;
    当 i < 3 {
        累计 += 表[i](5);
        i += 1;
    }
    打印(累计);
    返回 0;
}
