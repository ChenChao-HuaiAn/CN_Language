// T99 同族矩阵：位宽（整8/16/32/64 全好·整128 全病）×语境（局部/静态/字段/实参全病·O3 常量折叠路径全对）。
// 整64 对=表达式整体在 64 位域；整128 病=表达式 32 位域求值后 ldr w9 零扩展物化。
结构体 盒
{
    整128 大;
    整64 中;
}
函数 吃(整128 入) -> 整128 { 返回 入; }
函数 主() -> 整32
{
    整64 d = 0 - 5000000000;
    打印行("整64大:", d);
    打印("");
    整128 f = 0 - 100;
    打印行("整128减形:", f);
    打印("");
    静态 整128 g = 0 - 7;
    打印行("静态128:", g);
    打印("");
    盒 h = 盒{ 大 = 0 - 9, 中 = 0 - 8 };
    打印行("字段128:", h.大);
    打印("");
    打印行("实参128:", 吃(0 - 6));
    打印("");
    返回 0;
}
