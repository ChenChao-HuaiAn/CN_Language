// 变体矩阵：各算子+自增——期望 sub=3 mul=8 div=2 inc=9
类 盒四 {
公开:
    整32 值
    函数 盒四(整32 v) { 值 = v; }
}
函数 主() -> 整32 {
    盒四 a = 盒四(5);
    a.值 -= 2;
    打印("sub=", a.值);
    盒四 b = 盒四(4);
    b.值 *= 2;
    打印("mul=", b.值);
    盒四 c = 盒四(9);
    c.值 /= 4;
    打印("div=", c.值);
    盒四 d = 盒四(8);
    d.值++;
    打印("inc=", d.值);
    返回 0;
}
