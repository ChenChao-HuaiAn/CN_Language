// v9_05 生命周期面：类对象按值传参（形参拷贝构造+形参析构·C++ 值语义）
// 期望输出（值副本语义·对照 090 丙裁决目标形态）：
// C7      ← a 构造
// C7      ← 形参 x 拷贝构造
// D7      ← 形参 x 析构
// r=7
// end
// D7      ← a 析构
// 注：若实参/形参共享句柄（缺 C7/D7）=090 已立族形态（登记不重复立案）
类 跟踪 {
公开:
    整32 编号;
    函数 跟踪(整32 n) { 编号 = n; 打印行("C", n); }
    函数 ~跟踪() { 打印行("D", 编号); }
}
函数 消费(跟踪 x) -> 整32 {
    返回 x.编号;
}
函数 主() -> 整32 {
    跟踪 a = 跟踪(7);
    整32 r = 消费(a);
    打印行("r=", r);
    打印行("end");
    返回 0;
}
