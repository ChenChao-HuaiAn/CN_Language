// 任务 072 x64l 同型面运行级复验补形态（2026-09-28 深度机服务轮·样本临时实验件·不入库）
// 072 病灶清单六形态中 p0928_04~06 与 E2E 545 均未覆盖「窄→128 转换」——本探针补全。
// 设计对齐 545 折叠免疫口径：静态变量中转构造运行期值（O0/O3 同测）。
// 预期全对：-3 / -300 / -70000 / -5000000000 / -6 / -3
函数 主() -> 整32
{
    静态 整32 三 = 3;
    静态 整32 三百 = 300;
    静态 整32 七万 = 70000;
    静态 整64 五十亿 = 5000000000;
    整8 a = 整8(三 - 6);
    整16 b = 整16(三百 - 600);
    整32 c = 七万 - 140000;
    整64 d = 五十亿 - 10000000000;
    整128 wa = a;
    打印行("窄8转128:", wa);
    打印("");
    整128 wb = b;
    打印行("窄16转128:", wb);
    打印("");
    整128 wc = c;
    打印行("窄32转128:", wc);
    打印("");
    整128 wd = d;
    打印行("窄64转128:", wd);
    打印("");
    整128 w2 = 整128(b);
    打印行("显式16转128:", w2);
    打印("");
    返回 0;
}
