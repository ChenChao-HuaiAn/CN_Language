// v3b：可选<可选<类>> 双层拆包（058-ⅡA 特判嵌套边缘）
类 盒子 {
    公开:
    整32 值;
    函数 盒子() { 值 = 5; }
    函数 盒子(盒子& 其他) { 值 = 其他.值; }
}

函数 主() -> 整32 {
    可选<可选<盒子>> 槽 = 某些(某些(盒子()));
    如果 (槽.有值) {
        可选<盒子> 内 = 槽.值;
        如果 (内.有值) {
            盒子 b = 内.值;
            打印行("v3b=", b.值);
            返回 0;
        }
    }
    返回 2;
}
