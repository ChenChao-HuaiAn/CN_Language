// v14·p1007_05【分叉面#4·P1】窄类型算术结果类型立法空白：
//   宿主=整8+整8 提升整32→赋回整8 拒（禁窄化隐式·02 §321 自洽）
//   vs v2=窄域回绕全绿（127+1=-128·-128-1=127·整16 同）——两侧各合法立法无明文
导入 容器::向量;
函数 主() -> 整32 {
    整8 a = 127;
    整8 b = a + 1;
    打印("回绕=", b);
    整8 c = -128;
    整8 d = c - 1;
    打印("下溢=", d);
    整16 e = 32767;
    整16 f = e + 1;
    打印("16回绕=", f);
    向量<整8> 窄表 = 向量<整8>();
    结果<空类型, 整32> r1 = 窄表.追加(100);
    结果<空类型, 整32> r2 = 窄表.追加(200);
    打印("窄0=", 窄表.元素(0));
    打印("窄1=", 窄表.元素(1));
    返回 0;
}
