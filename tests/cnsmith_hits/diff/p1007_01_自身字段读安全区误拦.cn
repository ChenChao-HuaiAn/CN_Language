// v14·p1007_01【分叉面#5·P1】类方法内 自身.字段 读：宿主安全区 B9 误拦（Error）
//   vs v2 放行——001 §06 立法明文 自身.字段=this->字段；检查器缺 this 豁免
//   （semantic_expr_access.cpp visitMemberExpr B9·150-a 观察期转正漏豁免）
//   271 关键字化关联回归面（616 只覆盖 自身.方法() 调用形态）
类 计数器 {
    整32 值;
公开:
    函数 计数器() { 自身.值 = 0; }
    函数 加(整32 v) { 自身.值 = 自身.值 + v; }
    常量 函数 读() -> 整32 { 返回 自身.值; }
}
函数 主() -> 整32 {
    计数器 c = 计数器();
    c.加(5);
    打印("值=", c.读());
    返回 0;
}
