// 857 族矩阵探针：窄→128 全源（整8/16/正8/16）×目标符号性（整128/正128）×语境（局部/静态/字段/实参返回/显式转换/判定/槽复用干扰）
// 预期输出逐行：局8+=-3 局16+=-300 局u8+=200 局u16+=60000 静8+=-3 静u16+=60000 字段8+=-300 字段u16正=60000 实8+=-3 实u16正=60000 显16+=-300 显u8无=200 干扰后8+=-3 判16+=真
结构体 盒 { 整128 大; 正128 正槽; }
函数 吃128(整128 入) -> 整128 { 返回 入; }
函数 吃无(正128 入) -> 正128 { 返回 入; }
函数 主() -> 整32
{
    静态 整8 负三 = 整8(0 - 3);
    静态 整16 负三百 = 整16(0 - 300);
    静态 正8 满八 = 200;
    静态 正16 满十六 = 60000;
    整128 a = 负三;
    打印行("局8+", a);
    打印("");
    整128 b = 负三百;
    打印行("局16+", b);
    打印("");
    正128 c = 满八;
    打印行("局u8+", c);
    打印("");
    正128 d = 满十六;
    打印行("局u16+", d);
    打印("");
    静态 整128 静甲 = 负三;
    打印行("静8+", 静甲);
    打印("");
    静态 正128 静乙 = 满十六;
    打印行("静u16+", 静乙);
    打印("");
    盒 h = 盒{ 大 = 负三百, 正槽 = 满十六 };
    打印行("字段8+", h.大);
    打印("");
    打印行("字段u16正", h.正槽);
    打印("");
    打印行("实8+", 吃128(负三));
    打印("");
    打印行("实u16正", 吃无(满十六));
    打印("");
    整128 显甲 = 整128(负三百);
    打印行("显16+", 显甲);
    打印("");
    正128 显乙 = 正128(满八);
    打印行("显u8无", 显乙);
    打印("");
    整128 干扰 = 123456789012345;
    整128 干扰后 = 负三;
    打印行("干扰后8+", 干扰后);
    打印("");
    打印行("干扰自身", 干扰);
    打印("");
    如果 (b < 0) { 打印行("判16+真"); } 否则 { 打印行("判16+假"); }
    打印("");
    返回 0;
}
