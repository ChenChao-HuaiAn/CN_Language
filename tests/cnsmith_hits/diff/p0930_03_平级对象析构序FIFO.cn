// v9_11b 同族二分：同层平级对象析构顺序（3 对象·LIFO vs FIFO 定音）
// 期望（C++ LIFO·规格 06「与C++同名构造/析构语义一致」）：C1C2C3bodyD3D2D1
类 跟踪 {
公开:
    整32 编号;
    函数 跟踪(整32 n) { 编号 = n; 打印行("C", n); }
    函数 ~跟踪() { 打印行("D", 编号); }
}
函数 主() -> 整32 {
    跟踪 a = 跟踪(1);
    跟踪 b = 跟踪(2);
    跟踪 c = 跟踪(3);
    打印行("body");
    返回 0;
}
