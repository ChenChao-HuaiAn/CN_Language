// E 族（235 采样·容器邻接·221 r32 修⑱ 收官邻接面）
// 类含向量字段：对象拷贝构造后各自追加互不干扰（深拷独立性）
导入 容器::向量;

类 持有 {
公开:
    向量<整32> 体;

    不安全 函数 持有() {
        结果<空类型, 整32> 加 = 体.追加(100);
    }
}

函数 主() -> 整32 {
    持有 甲;
    持有 乙 = 甲;
    结果<空类型, 整32> 加乙 = 乙.体.追加(200);
    结果<空类型, 整32> 加甲 = 甲.体.追加(300);
    打印(甲.体.大小());
    打印(乙.体.大小());
    打印(乙.体.元素(1));
    返回 0;
}
