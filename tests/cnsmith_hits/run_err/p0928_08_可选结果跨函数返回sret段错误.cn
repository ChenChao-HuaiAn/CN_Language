// 同族矩阵 A：可选<结果<整32,整32>> 跨函数（=p0928_03 原形态·已知红·对照基准）
函数 找点() -> 可选<结果<整32,整32>> {
    结果<整32,整32> 内 = 正常(7);
    返回 某些(内);
}
函数 主() -> 整32 {
    可选<结果<整32,整32>> 甲 = 找点();
    如果 (甲.有值) {
        结果<整32,整32> 乙 = 甲.值;
        如果 (乙.正常) {
            打印行("A_v=", 乙.值);
        } 否则 {
            打印行("A_inner_err");
        }
    } 否则 {
        打印行("A_outer_none");
    }
    返回 0;
}
