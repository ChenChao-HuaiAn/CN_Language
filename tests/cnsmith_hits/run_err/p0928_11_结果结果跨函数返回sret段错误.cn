// 同族矩阵 D：结果<结果<整32,整32>,整32> 跨函数（嵌套同型·历史未测向）
函数 找点() -> 结果<结果<整32,整32>, 整32> {
    结果<整32,整32> 内 = 正常(13);
    返回 正常(内);
}
函数 主() -> 整32 {
    结果<结果<整32,整32>, 整32> 甲 = 找点();
    如果 (甲.正常) {
        结果<整32,整32> 乙 = 甲.值;
        如果 (乙.正常) {
            打印行("D_v=", 乙.值);
        } 否则 {
            打印行("D_inner_err");
        }
    } 否则 {
        打印行("D_outer_err");
    }
    返回 0;
}
