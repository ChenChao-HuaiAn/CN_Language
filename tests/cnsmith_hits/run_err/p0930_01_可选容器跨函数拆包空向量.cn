// v9_09 容器<合成体>面：可选<向量<整32>> 跨函数返回+拆包（合成体包容器·081 sret 通道反向嵌套兄弟）
// 081 四向=合成体<合成体>；本探针=合成体<容器>（外层合成体含容器句柄字段·同走 sret 通道）
// 期望输出：
// n=2
// a=3
// b=4
导入 容器::向量;
函数 造() -> 可选<向量<整32>> {
    向量<整32> v = 向量<整32>();
    结果<空类型, 整32> r1 = v.追加(3);
    如果 (!r1.正常) { 返回 无; }
    结果<空类型, 整32> r2 = v.追加(4);
    如果 (!r2.正常) { 返回 无; }
    返回 某些(v);
}
函数 主() -> 整32 {
    可选<向量<整32>> o = 造();
    如果 (o.有值) {
        向量<整32> v = o.值;
        打印行("n=", v.大小());
        打印行("a=", v.元素(0));
        打印行("b=", v.元素(1));
    } 否则 {
        打印行("none");
    }
    返回 0;
}
