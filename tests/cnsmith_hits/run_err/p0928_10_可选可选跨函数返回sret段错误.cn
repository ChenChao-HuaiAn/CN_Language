// 同族矩阵 C：可选<可选<整32>> 跨函数（嵌套同型·历史未测向）
函数 找点() -> 可选<可选<整32>> {
    可选<整32> 内 = 某些(11);
    返回 某些(内);
}
函数 主() -> 整32 {
    可选<可选<整32>> 甲 = 找点();
    如果 (甲.有值) {
        可选<整32> 乙 = 甲.值;
        如果 (乙.有值) {
            打印行("C_v=", 乙.值);
        } 否则 {
            打印行("C_inner_none");
        }
    } 否则 {
        打印行("C_outer_none");
    }
    返回 0;
}
