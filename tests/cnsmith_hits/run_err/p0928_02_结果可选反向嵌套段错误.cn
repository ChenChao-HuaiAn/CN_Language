// 062/067 族新形态（2026-09-28 单位机 v5 探针）：结果<可选<T>,E> 反向嵌套——
// 返回 正常(某些(77)) 后双层拆包，O0/O3 均 SIGSEGV(rc=-11)。
// 已知形态 p0927_01=可选<类>拆包（062 主形态）；本形态=结果外壳包裹可选=嵌套方向反转，067-002 矩阵候选。
函数 取值(整32 键) -> 结果<可选<整32>, 整32>
{
    如果 (键 == 1)
    {
        返回 正常(某些(77));
    }
    返回 错误(404);
}
函数 主() -> 整32
{
    结果<可选<整32>, 整32> 甲 = 取值(1);
    如果 (甲.正常)
    {
        可选<整32> 乙 = 甲.值;
        如果 (乙.有值)
        {
            打印行("双层=", 乙.值);
        }
    }
    返回 0;
}
