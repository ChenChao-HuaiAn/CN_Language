// 同族矩阵 B：结果<可选<整32>,整32> 跨函数（=p0928_02 形态·已知红·对照基准）
函数 找点() -> 结果<可选<整32>, 整32> {
    可选<整32> 内 = 某些(9);
    返回 正常(内);
}
函数 主() -> 整32 {
    结果<可选<整32>, 整32> 甲 = 找点();
    如果 (甲.正常) {
        可选<整32> 乙 = 甲.值;
        如果 (乙.有值) {
            打印行("B_v=", 乙.值);
        } 否则 {
            打印行("B_inner_none");
        }
    } 否则 {
        打印行("B_outer_err");
    }
    返回 0;
}
