// #751 泄漏对拍探针（成功+失败 4 形态 × 2000 轮·活动分配数回落差恒 0）
//   口径：内存::活动分配数（tracked 分配计数）——窗口内无打印（#617 打印变参
//   临时缺口不混入）；每轮新建 JSON树 解析后随作用域析构。
导入 JSON::{JSON树, 解析JSON, JSONE_好};

不安全 函数 主() -> 整32 {
    整64 基线 = 内存::活动分配数();
    整64 失败码 = 0;
    循环 (整64 r = 1; r <= 2000; r++) {
        {
            JSON树 树 = JSON树();
            解析JSON(树, "[1,2,3]");
            如果 (树.错误码 != JSONE_好) { 失败码 = 失败码 + 1; }
        }
        {
            JSON树 树 = JSON树();
            解析JSON(树, "[1,2,");
            如果 (树.错误码 != 1) { 失败码 = 失败码 + 1; }
        }
        {
            JSON树 树 = JSON树();
            解析JSON(树, "{\"甲\":\"乙\",\"丙\":[true,null]}");
            如果 (树.错误码 != JSONE_好) { 失败码 = 失败码 + 1; }
        }
        {
            JSON树 树 = JSON树();
            解析JSON(树, "\"未闭");
            如果 (树.错误码 != 1) { 失败码 = 失败码 + 1; }
        }
    }
    整64 回落差 = 内存::活动分配数() - 基线;
    打印("P751leak 回落差=", 整数转字符串(回落差),
          " 失败码=", 整数转字符串(失败码));
    返回 0;
}
