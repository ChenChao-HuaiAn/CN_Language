不安全 函数 测长串(字符串 文档) -> 整32 {
    循环 (整64 r = 1; r <= 3; r++) {
        JSON树 树 = JSON树();
        整64 起 = 时间::单调时钟毫秒();
        解析JSON(树, 文档);
        整64 止 = 时间::单调时钟毫秒();
        打印("P751d 长串: 耗时毫秒=", 整数转字符串(止 - 起));
        如果 (树.错误码 != JSONE_好) { 返回 1; }
    }
    返回 0;
}

不安全 函数 主() -> 整32 {
    整64 句甲 = 字符串构建器::新建();
    字符串构建器::追加(句甲, "{\"块\":[");
    循环 (整64 k = 0; k < 8192; k++) {
        字符串构建器::追加(句甲, "0");
        如果 (k < 8191) { 字符串构建器::追加(句甲, ","); }
    }
    字符串构建器::追加(句甲, "]}");
    字符串 文档数 = 字符串构建器::完成(句甲);

    整64 句大 = 字符串构建器::新建();
    字符串构建器::追加(句大, "{\"块\":[");
    循环 (整64 k = 0; k < 32768; k++) {
        字符串构建器::追加(句大, "0");
        如果 (k < 32767) { 字符串构建器::追加(句大, ","); }
    }
    字符串构建器::追加(句大, "]}");
    字符串 文档大 = 字符串构建器::完成(句大);

    整64 句乙 = 字符串构建器::新建();
    字符串构建器::追加(句乙, "{\"块\":[");
    循环 (整64 k = 0; k < 8192; k++) {
        字符串构建器::追加(句乙, "\"a\"");
        如果 (k < 8191) { 字符串构建器::追加(句乙, ","); }
    }
    字符串构建器::追加(句乙, "]}");
    字符串 文档短 = 字符串构建器::完成(句乙);

    字符串 元素 = "0123456789abcdefghijklmnopqrstuv";
    整64 句丙 = 字符串构建器::新建();
    字符串构建器::追加(句丙, "{\"块\":[");
    循环 (整64 k = 0; k < 8192; k++) {
        字符串构建器::追加(句丙, "\"");
        字符串构建器::追加(句丙, 元素);
        字符串构建器::追加(句丙, "\"");
        如果 (k < 8191) { 字符串构建器::追加(句丙, ","); }
    }
    字符串构建器::追加(句丙, "]}");
    字符串 文档长 = 字符串构建器::完成(句丙);
    打印("P751d 长=", 整数转字符串(字符串长度(文档数)), "/",
          整数转字符串(字符串长度(文档短)), "/",
          整数转字符串(字符串长度(文档长)), "/",
          整数转字符串(字符串长度(文档大)));

    整32 甲 = 测数字(文档数);
    如果 (甲 != 0) { 返回 甲; }
    整32 大甲 = 测数字大(文档大);
    如果 (大甲 != 0) { 返回 大甲; }
    整32 乙 = 测短串(文档短);
    如果 (乙 != 0) { 返回 乙; }
    返回 测长串(文档长);
}
