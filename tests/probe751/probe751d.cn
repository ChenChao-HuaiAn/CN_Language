// #751 性能探针（四负载·每轮独立 JSON树 构造-析构·3 轮取中位）
//   8192 数字（16393B）/ 32768 数字（65537B）/ 8192 短串（1B·32777B）/
//   8192×32B 串（286729B·b6 同款）。用法见 tests/probe751/README.md。
导入 JSON::{JSON树, 解析JSON, JSONE_好};

不安全 函数 测数字(字符串 文档) -> 整32 {
    循环 (整64 r = 1; r <= 3; r++) {
        JSON树 树 = JSON树();
        整64 起 = 时间::单调时钟毫秒();
        解析JSON(树, 文档);
        整64 止 = 时间::单调时钟毫秒();
        打印("P751d 数字: 耗时毫秒=", 整数转字符串(止 - 起));
        如果 (树.错误码 != JSONE_好) { 返回 1; }
        如果 (r == 1) {
            可选<整64> 首 = 树.子(树.根, 0);   // #1523：子 结果化（越界=无）
            如果 (!首.有值) { 返回 2; }
            如果 (树.子数(首.值) != 8192) { 返回 2; }
        }
    }
    返回 0;
}

不安全 函数 测数字大(字符串 文档) -> 整32 {
    循环 (整64 r = 1; r <= 3; r++) {
        JSON树 树 = JSON树();
        整64 起 = 时间::单调时钟毫秒();
        解析JSON(树, 文档);
        整64 止 = 时间::单调时钟毫秒();
        打印("P751d 数字32768: 耗时毫秒=", 整数转字符串(止 - 起));
        如果 (树.错误码 != JSONE_好) { 返回 1; }
        如果 (r == 1) {
            可选<整64> 首 = 树.子(树.根, 0);   // #1523：子 结果化（越界=无）
            如果 (!首.有值) { 返回 2; }
            如果 (树.子数(首.值) != 32768) { 返回 2; }
        }
    }
    返回 0;
}

