// #751 负例对拍探针（20 例·宿主 before/after 输出逐字节一致）
//   用法：见 tests/probe751/README.md（对拍脚本 对拍751.py）。
//   覆盖：空文/截断/未闭串/坏转义/尾余/深超/重复键（两连/三连）/空壳/缺逗号/
//   非法字面/坏数字/负号孤立/小数无位/尾随逗号/嵌套正常/转义正常/空键/大整数。
导入 JSON::{JSON树, 解析JSON, JSONE_好, JSONT_对象};

不安全 函数 测(字符串 名, 字符串 文) -> 空类型 {
    JSON树 树 = JSON树();
    解析JSON(树, 文);
    打印("P751err ", 名,
          " 错误码=", 整数转字符串(树.错误码),
          " 位置=", 整数转字符串(树.错误位置),
          " 字节=", 整数转字符串(树.错误字节),
          " 根=", 整数转字符串(树.根));
    如果 (树.错误码 == JSONE_好 && 树.根 != -1 && 树.类型(树.根) == JSONT_对象) {
        整64 键节 = 树.找键(树.根, "甲");
        打印("P751err ", 名, " 键甲=", 整数转字符串(键节));
        如果 (键节 != -1) {
            打印("P751err ", 名, " 甲值=", 整数转字符串(树.整值(键节)));
        }
    }
}

不安全 函数 主() -> 整32 {
    测("空文", "");
    测("截断数组", "[1,2,");
    测("未闭串", "\"abc");
    测("坏转义", "\"a\\q\"");
    测("尾余", "{}x");
    测("深超", "[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[1]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]");
    测("重复键", "{\"甲\":1,\"甲\":2}");
    测("重复键三连", "{\"甲\":1,\"甲\":2,\"甲\":3}");
    测("空对象", "{}");
    测("空数组", "[]");
    测("缺逗号", "[1 2]");
    测("非法字面", "tru");
    测("坏数字", "01");
    测("负号孤立", "-");
    测("小数无位", "1.");
    测("尾随逗号", "[1,]");
    测("嵌套正常", "{\"甲\":[1,{\"乙\":true}],\"丙\":null}");
    测("转义正常", "\"a\\n\"");
    测("空键", "{\"\":1}");
    测("大整数", "9223372036854775808");
    返回 0;
}
