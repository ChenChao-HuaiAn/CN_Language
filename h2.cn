// v14·p1007_02【分叉面#1·P1】无构造类实例化三态分叉：宿主放行（109 立法「仅分配」）
//   但容器字段悬空→运行期错误码3 空指针引用；v2 编译期拒绝（用户类无构造器+错码6）
//   对照 91413b=显式构造函数内手工构造字段则双绿——合成默认构造不级联字段构造
导入 容器::向量;
类 收集器 {
    向量<整32> 数据;
公开:
    函数 加入(整32 v) {
        结果<空类型, 整32> r = 数据.追加(v);
    }
    常量 函数 计数() -> 整64 { 返回 数据.大小(); }
}
函数 主() -> 整32 {
    收集器 c = 收集器();
    c.加入(10);
    c.加入(20);
    打印("计数=", c.计数());
    返回 0;
}
