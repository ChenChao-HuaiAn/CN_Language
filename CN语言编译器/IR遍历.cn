// 自举后端抽象层：IR 遍历引擎（Task 009 平台抽象层重构 第一步）
// 平台无关的 IR 指令遍历引擎：遍历 IR 行、收集常量、收集外部声明、
// 维护槽表，并把每条指令分发到后端接口（后端接口.cn）的具体实现。
// 本文件不包含任何平台相关汇编细节（寄存器/指令/段名/符号修饰），
// 全部由实现 后端接口 的后端类（如 x64后端.cn / arm64后端.cn）负责。
// 依据：spec 06 OOP 接口定义 + spec 08 模块系统（默认私有）。
导入 容器::向量;
导入 后端接口::后端接口;

公开:

// 代码生成入口：IR 行 + 后端 -> 汇编行列表
// 流程：收集常量（pass 1）-> 汇编（pass 2，经后端接口分发）
函数 IR遍历(向量<字符串> IR行, 后端接口 后端) -> 向量<字符串> {
    向量<字符串> 常量表 = 向量<字符串>();
    收集常量(IR行, 常量表);
    汇编(IR行, 常量表, 后端);
    返回 后端.获取输出();
}

// ==================== 行工具 ====================

// 取 IR 行类型（"|" 前部分；无 "|" 返回整行）
函数 行类型(字符串 行) -> 字符串 {
    整64 位 = 字符串查找(行, "|");
    如果 (位 < 0) {
        返回 字符串复制(行);
    }
    返回 字符串子串(行, 0, 位);
}

// 取 IR 行文本（"|" 后部分；无 "|" 返回空串）
函数 行文本(字符串 行) -> 字符串 {
    整64 位 = 字符串查找(行, "|");
    如果 (位 < 0) {
        返回 "";
    }
    返回 字符串子串(行, 位 + 1, 字符串长度(行) - 位 - 1);
}

// ==================== 列表追加（结果检查） ====================

// 追加字符串到列表，失败时运行时错误
函数 列表追加(向量<字符串> 列表, 字符串 值) -> 空类型 {
    结果<空类型, 整32> 加 = 列表.追加(值);
    如果 (!加.正常) {
        运行时错误(4);
    }
}

// ==================== 文本解析 ====================

// 十进制数字串 -> 整数（重命名避免与后端类方法冲突）
函数 解析数字(字符串 文本) -> 整64 {
    整64 值 = 0;
    整64 i = 0;
    当 (i < 字符串长度(文本)) {
        整64 字节 = 字节值(文本, i);
        如果 (字节 >= 48 && 字节 <= 57) {
            值 = 值 * 10 + 字节 - 48;
        }
        i++;
    }
    返回 值;
}

// 字符串字面量解码（去引号、解转义）
函数 解码(字符串 文本) -> 字符串 {
    整64 长度 = 字符串长度(文本);
    如果 (长度 < 2) {
        返回 "";
    }
    字符串 内容 = 字符串子串(文本, 1, 长度 - 2);
    字符串 累积 = "";
    整64 i = 0;
    当 (i < 字符串长度(内容)) {
        整64 字节 = 字节值(内容, i);
        如果 (字节 == 92 && i + 1 < 字符串长度(内容)) {
            整64 下一 = 字节值(内容, i + 1);
            如果 (下一 == 110) {
                累积 = 累积 + 字符转字符串(10);
            } 否则 如果 (下一 == 116) {
                累积 = 累积 + 字符转字符串(9);
            } 否则 如果 (下一 == 114) {
                累积 = 累积 + 字符转字符串(13);
            } 否则 如果 (下一 == 92) {
                累积 = 累积 + 字符转字符串(92);
            } 否则 如果 (下一 == 34) {
                累积 = 累积 + 字符转字符串(34);
            } 否则 如果 (下一 == 39) {
                累积 = 累积 + 字符转字符串(39);
            } 否则 {
                累积 = 累积 + 字符转字符串(92);
            }
            i = i + 2;
            继续;
        }
        累积 = 累积 + 字符转字符串(字节);
        i++;
    }
    返回 累积;
}

// 字符字面量 'x' / '\u{XXXX}' 的字节值（简化：单字节；重命名避免与后端类方法冲突）
函数 取字符值(字符串 文本) -> 整64 {
    整64 长度 = 字符串长度(文本);
    如果 (长度 >= 3) {
        如果 (字节值(文本, 1) == 92) {
            返回 92;
        }
        返回 字节值(文本, 1);
    }
    返回 0;
}

// 常量表查找（返回序号；未找到返回 -1）
函数 查找序号(向量<字符串> 常量表, 字符串 值) -> 整64 {
    整64 i = 0;
    当 (i < 常量表.大小()) {
        如果 (字符串比较(常量表.元素(i), 值)) {
            返回 i;
        }
        i++;
    }
    返回 -1;
}

// ==================== 常量收集（pass 1） ====================

// 遍历 IR 行收集字符串常量（去重）到常量表
函数 收集常量(向量<字符串> IR行, 向量<字符串> 常量表) -> 空类型 {
    整64 位置 = 0;
    当 (位置 < IR行.大小()) {
        字符串 行 = IR行.元素(位置);
        字符串 类型 = 行类型(行);
        如果 (字符串比较(类型, "字符串")) {
            字符串 值 = 解码(行文本(行));
            如果 (查找序号(常量表, 值) < 0) {
                列表追加(常量表, 值);
            }
        } 否则 如果 (字符串比较(类型, "字面量")) {
            字符串 文本 = 行文本(行);
            如果 (字符串长度(文本) > 0 && 字符串比较(字符串子串(文本, 0, 1), "\"")) {
                字符串 值 = 解码(文本);
                如果 (查找序号(常量表, 值) < 0) {
                    列表追加(常量表, 值);
                }
            }
        }
        位置++;
    }
}

// ==================== 函数定义判断 ====================

// 函数是否已在本模块定义
函数 已定义(向量<字符串> IR行, 字符串 符号) -> 布尔 {
    整64 位置 = 0;
    当 (位置 < IR行.大小()) {
        字符串 行 = IR行.元素(位置);
        如果 (字符串比较(行类型(行), "函数") &&
              字符串比较(行类型(行文本(行)), 符号)) {
            返回 真;
        }
        位置++;
    }
    返回 假;
}

// ==================== 槽表 ====================

// 查槽（"名|槽"；未找到返回 -1）
函数 查槽(向量<字符串> 变量表, 字符串 名) -> 整64 {
    整64 i = 0;
    当 (i < 变量表.大小()) {
        字符串 记录 = 变量表.元素(i);
        如果 (字符串比较(行类型(记录), 名)) {
            返回 解析数字(行文本(记录));
        }
        i++;
    }
    返回 -1;
}

// 是否引用参数
函数 是引用(向量<字符串> 引用表, 字符串 名) -> 布尔 {
    整64 i = 0;
    当 (i < 引用表.大小()) {
        如果 (字符串比较(引用表.元素(i), 名)) {
            返回 真;
        }
        i++;
    }
    返回 假;
}

// ==================== 汇编主流程 ====================

// 汇编主流程：段头 -> 字符串常量 -> 固定外部 -> 外部声明 -> 函数序列 -> 程序结束
函数 汇编(向量<字符串> IR行, 向量<字符串> 常量表, 后端接口 后端) -> 空类型 {
    // ---- 数据段：字符串常量池 ----
    后端.段头("数据");
    整64 i = 0;
    当 (i < 常量表.大小()) {
        后端.发射字符串常量(i, 常量表.元素(i));
        i++;
    }
    后端.段尾();
    // ---- 代码段：固定外部 + 外部声明 + 函数 ----
    后端.段头("代码");
    后端.发射固定外部();
    发射外部声明(IR行, 后端);
    整64 位置 = 0;
    当 (位置 < IR行.大小()) {
        字符串 行 = IR行.元素(位置);
        如果 (字符串比较(行类型(行), "函数")) {
            位置 = 发射函数(IR行, 位置, 常量表, 后端);
        } 否则 {
            位置++;
        }
    }
    后端.段尾();
    后端.程序结束();
}

// ==================== 外部声明收集 ====================

// 遍历 IR 行收集模块外被调函数，经后端接口发射外部声明
函数 发射外部声明(向量<字符串> IR行, 后端接口 后端) -> 空类型 {
    向量<字符串> 已发 = 向量<字符串>();
    整64 位置 = 0;
    当 (位置 < IR行.大小()) {
        字符串 行 = IR行.元素(位置);
        如果 (字符串比较(行类型(行), "调用")) {
            字符串 符号 = 行类型(行文本(行));
            字符串 参数码 = 行文本(行文本(行文本(行文本(行))));
            如果 (!后端.固定外部(符号) && !已定义(IR行, 符号) &&
                 查找序号(已发, 符号) < 0) {
                后端.发射外部声明(符号, 参数码);
                列表追加(已发, 符号);
            }
        }
        位置++;
    }
}

// ==================== 函数发射 ====================

// 发射单个函数：槽表收集 -> 函数头 -> 指令序列 -> 函数尾
函数 发射函数(向量<字符串> IR行, 整64 起始, 向量<字符串> 常量表,
             后端接口 后端) -> 整64 {
    字符串 行 = IR行.元素(起始);
    字符串 符号 = 行类型(行文本(行));
    字符串 参数码 = 行文本(行文本(行文本(行)));
    整64 参数个数 = 解析数字(行类型(行文本(行文本(行))));
    // ---- 槽表收集 ----
    向量<字符串> 变量表 = 向量<字符串>();
    向量<字符串> 引用表 = 向量<字符串>();
    整64 位置 = 起始 + 1;
    当 (位置 < IR行.大小()) {
        字符串 行2 = IR行.元素(位置);
        字符串 类型2 = 行类型(行2);
        如果 (字符串比较(类型2, "函数")) {
            中断;
        }
        如果 (字符串比较(类型2, "参数")) {
            字符串 文本2 = 行文本(行2);
            列表追加(变量表, 行类型(文本2) + "|" + 整数转字符串(变量表.大小()));
            如果 (字符串比较(行文本(文本2), "引用")) {
                列表追加(引用表, 行类型(文本2));
            }
        } 否则 如果 (字符串比较(类型2, "分配")) {
            列表追加(变量表, 行文本(行2) + "|" + 整数转字符串(变量表.大小()));
        }
        位置++;
    }
    整64 槽数 = 变量表.大小();
    // ---- 函数头 ----
    后端.函数头(符号, 参数码, 槽数, 参数个数);
    // ---- 指令序列 ----
    位置 = 起始 + 1;
    当 (位置 < IR行.大小()) {
        字符串 行2 = IR行.元素(位置);
        字符串 类型2 = 行类型(行2);
        如果 (字符串比较(类型2, "函数")) {
            中断;
        }
        如果 (字符串比较(类型2, "参数") || 字符串比较(类型2, "分配")) {
            位置++;
            继续;
        }
        位置 = 发射指令(行2, 位置 + 1, 常量表, 变量表, 引用表, 槽数, 后端);
    }
    // ---- 函数尾 ----
    后端.函数尾(符号, 参数码);
    返回 位置;
}

// ==================== 指令发射（分发器） ====================

// 指令分发器：按 IR 指令类型分发到后端接口方法（≤100 行约束）
函数 发射指令(字符串 行, 整64 位置, 向量<字符串> 常量表,
             向量<字符串> 变量表, 向量<字符串> 引用表, 整64 槽数,
             后端接口 后端) -> 整64 {
    字符串 类型 = 行类型(行);
    字符串 文本 = 行文本(行);
    如果 (字符串比较(类型, "字面量")) {
        如果 (字符串长度(文本) > 0 && 字符串比较(字符串子串(文本, 0, 1), "\"")) {
            // 字符串字面量：登记常量表，发射常量引用
            整64 序号 = 查找序号(常量表, 解码(文本));
            如果 (序号 < 0) {
                列表追加(常量表, 解码(文本));
                序号 = 常量表.大小() - 1;
            }
            后端.发射字符串引用(序号, 槽数);
        } 否则 如果 (字符串长度(文本) > 0 && 字符串比较(字符串子串(文本, 0, 1), "'")) {
            // 字符字面量：平台无关解析为字节值，按数字发射
            后端.发射字面量(整数转字符串(取字符值(文本)), 槽数);
        } 否则 {
            // 真/假/数字字面量
            后端.发射字面量(文本, 槽数);
        }
        返回 位置;
    }
    如果 (字符串比较(类型, "字符串")) {
        整64 序号 = 查找序号(常量表, 解码(文本));
        如果 (序号 < 0) {
            列表追加(常量表, 解码(文本));
            序号 = 常量表.大小() - 1;
        }
        后端.发射字符串引用(序号, 槽数);
        返回 位置;
    }
    如果 (字符串比较(类型, "加载")) {
        后端.发射加载(查槽(变量表, 文本), 是引用(引用表, 文本), 槽数);
        返回 位置;
    }
    如果 (字符串比较(类型, "压址")) {
        后端.发射压址(查槽(变量表, 文本), 槽数);
        返回 位置;
    }
    如果 (字符串比较(类型, "存储")) {
        后端.发射存储(查槽(变量表, 文本), 是引用(引用表, 文本), 槽数);
        返回 位置;
    }
    如果 (字符串比较(类型, "复制结果")) {
        后端.发射复制结果(查槽(变量表, 文本), 槽数);
        返回 位置;
    }
    如果 (字符串比较(类型, "运算")) {
        后端.发射运算(文本, 槽数);
        返回 位置;
    }
    如果 (字符串比较(类型, "加载成员")) {
        后端.发射加载成员(查槽(变量表, 行类型(文本)), 槽数);
        返回 位置;
    }
    如果 (字符串比较(类型, "调用")) {
        字符串 符号 = 行类型(文本);
        字符串 细节 = 行文本(文本);
        字符串 参数数文本 = 行类型(细节);
        字符串 标志 = 行类型(行文本(细节));
        字符串 参数码 = 行文本(行文本(细节));
        整64 参数个数 = 解析数字(参数数文本);
        后端.发射调用(符号, 参数个数, 标志, 参数码, 槽数);
        返回 位置;
    }
    如果 (字符串比较(类型, "返回")) {
        后端.发射返回(槽数);
        返回 位置;
    }
    如果 (字符串比较(类型, "返回空")) {
        后端.发射返回空();
        返回 位置;
    }
    如果 (字符串比较(类型, "递增") || 字符串比较(类型, "递减")) {
        后端.发射递增递减(类型, 查槽(变量表, 文本), 是引用(引用表, 文本), 槽数);
        返回 位置;
    }
    如果 (字符串比较(类型, "标签")) {
        后端.发射标签(文本);
        返回 位置;
    }
    如果 (字符串比较(类型, "跳转")) {
        后端.发射跳转(文本);
        返回 位置;
    }
    如果 (字符串比较(类型, "跳转真")) {
        后端.发射跳转真(文本, 槽数);
        返回 位置;
    }
    如果 (字符串比较(类型, "跳转假")) {
        后端.发射跳转假(文本, 槽数);
        返回 位置;
    }
    返回 位置;
}
