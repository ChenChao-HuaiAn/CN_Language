// 自举 Task 7.1 子模块：词法/运算符（B 任务拆分，2026-08）
// 职责：39 运算符/分隔符贪婪匹配（多字符优先）
// 门面 词法分析.cn 经 `导入 词法::运算符` 引入，调用 `运算符::匹配运算符`
公开:

// 运算符/分隔符匹配（多字符贪婪：<<= >>= 三字符优先，其次 双字符，最后 单字符）
// 返回匹配到的符号文本；非运算符字符返回空串
函数 匹配运算符(字符串 源码, 整64 位置, 整64 长度) -> 字符串 {
    整64 首 = 字节值(源码, 位置)
    整64 次 = 0
    整64 三 = 0
    如果 (位置 + 1 < 长度) {
        次 = 字节值(源码, 位置 + 1)
    }
    如果 (位置 + 2 < 长度) {
        三 = 字节值(源码, 位置 + 2)
    }
    选择 (首) {
        情况 43:  // +
            如果 (次 == 43) { 返回 "++" }
            如果 (次 == 61) { 返回 "+=" }
            返回 "+"
        情况 45:  // -
            如果 (次 == 45) { 返回 "--" }
            如果 (次 == 62) { 返回 "->" }
            如果 (次 == 61) { 返回 "-=" }
            返回 "-"
        情况 42:  // *
            如果 (次 == 61) { 返回 "*=" }
            返回 "*"
        情况 47:  // /
            如果 (次 == 61) { 返回 "/=" }
            返回 "/"
        情况 37:  // %
            如果 (次 == 61) { 返回 "%=" }
            返回 "%"
        情况 60:  // <
            如果 (次 == 60) {
                如果 (三 == 61) { 返回 "<<=" }
                返回 "<<"
            }
            如果 (次 == 61) { 返回 "<=" }
            返回 "<"
        情况 62:  // >
            如果 (次 == 62) {
                如果 (三 == 61) { 返回 ">>=" }
                返回 ">>"
            }
            如果 (次 == 61) { 返回 ">=" }
            返回 ">"
        情况 61:  // =
            如果 (次 == 61) { 返回 "==" }
            返回 "="
        情况 33:  // !
            如果 (次 == 61) { 返回 "!=" }
            返回 "!"
        情况 38:  // &
            如果 (次 == 38) { 返回 "&&" }
            返回 "&"
        情况 124: // |
            如果 (次 == 124) { 返回 "||" }
            返回 "|"
        情况 94:  // ^
            如果 (次 == 61) { 返回 "^=" }
            返回 "^"
        情况 126: // ~
            返回 "~"
        情况 46:  // .
            返回 "."
        情况 58:  // :
            如果 (次 == 58) { 返回 "::" }
            返回 ":"
        情况 40:  // (
            返回 "("
        情况 41:  // )
            返回 ")"
        情况 123: // {
            返回 "{"
        情况 125: // }
            返回 "}"
        情况 91:  // [
            返回 "["
        情况 93:  // ]
            返回 "]"
        情况 59:  // ;
            返回 ";"
        情况 44:  // ,
            返回 ","
        情况 63:  // ?
            返回 "?"
        默认:
            返回 ""
    }
}