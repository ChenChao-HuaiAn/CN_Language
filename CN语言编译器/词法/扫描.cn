// 自举 Task 7.1 子模块：词法/扫描（B 任务拆分，2026-08）
// 职责：数字/字符串/字符字面量扫描 + 字节分类
// 门面 词法分析.cn 经 `导入 词法::扫描` 引入，调用 `扫描::扫描数字` 等
公开:

// 字节分类
函数 是数字(整64 字节) -> 布尔 {
    返回 字节 >= 48 && 字节 <= 57
}
函数 是字母(整64 字节) -> 布尔 {
    如果 (字节 >= 128) {
        返回 真  // UTF-8 中文字符
    }
    返回 (字节 >= 97 && 字节 <= 122) || (字节 >= 65 && 字节 <= 90) || 字节 == 95
}
函数 是十六进制(整64 字节) -> 布尔 {
    返回 是数字(字节) || (字节 >= 97 && 字节 <= 102) || (字节 >= 65 && 字节 <= 70)
}

// 扫描数字字面量：0x 十六进制 / 0b 二进制 / 0o 八进制 / 十进制（含 . 与 e 指数与 LL/U 后缀）
// 文本 输出 字面量原文（含前缀与后缀）；返回新位置
函数 扫描数字(字符串 源码, 整64 位置, 整64 长度, 字符串& 文本) -> 整64 {
    整64 起点 = 位置
    如果 (位置 + 1 < 长度) {
        整64 首 = 字节值(源码, 位置)
        整64 次 = 字节值(源码, 位置 + 1)
        如果 (首 == 48) {
            如果 (次 == 120 || 次 == 88) {  // 0x
                位置 += 2
                当 (位置 < 长度 && 是十六进制(字节值(源码, 位置))) {
                    位置++
                }
                文本 = 字符串子串(源码, 起点, 位置 - 起点)
                返回 位置
            }
            如果 (次 == 98 || 次 == 66) {  // 0b
                位置 += 2
                当 (位置 < 长度 && (字节值(源码, 位置) == 48 || 字节值(源码, 位置) == 49)) {
                    位置++
                }
                文本 = 字符串子串(源码, 起点, 位置 - 起点)
                返回 位置
            }
            如果 (次 == 111 || 次 == 79) {  // 0o
                位置 += 2
                当 (位置 < 长度) {
                    整64 值 = 字节值(源码, 位置)
                    如果 (!(值 >= 48 && 值 <= 55)) {
                        中断
                    }
                    位置++
                }
                文本 = 字符串子串(源码, 起点, 位置 - 起点)
                返回 位置
            }
        }
    }
    当 (位置 < 长度 && 是数字(字节值(源码, 位置))) {
        位置++
    }
    如果 (位置 + 1 < 长度 && 字节值(源码, 位置) == 46 && 是数字(字节值(源码, 位置 + 1))) {
        位置 += 2
        当 (位置 < 长度 && 是数字(字节值(源码, 位置))) {
            位置++
        }
    }
    如果 (位置 < 长度 && (字节值(源码, 位置) == 101 || 字节值(源码, 位置) == 69)) {
        位置++
        如果 (位置 < 长度 && (字节值(源码, 位置) == 43 || 字节值(源码, 位置) == 45)) {
            位置++
        }
        当 (位置 < 长度 && 是数字(字节值(源码, 位置))) {
            位置++
        }
    }
    当 (位置 < 长度) {
        整64 后缀 = 字节值(源码, 位置)
        如果 (后缀 == 76 || 后缀 == 108 || 后缀 == 85 || 后缀 == 117) {
            位置++
        } 否则 {
            中断
        }
    }
    文本 = 字符串子串(源码, 起点, 位置 - 起点)
    返回 位置
}

// 扫描字符串字面量（"..."，含 \\ 转义；原始"" 前缀不处理转义；多行""" 前缀到 """ 结束）
// 输出 token 行；返回新位置。未闭合字符串容错到行尾（不跨行）。
函数 扫描字符串(字符串 源码, 整64 位置, 整64 长度, 布尔 原始前缀, 布尔 多行前缀,
                 向量<字符串> 输出, 整64 行号) -> 整64 {
    整64 起始行 = 行号  // token 行号 = 起始行（多行字符串内部换行只推进外部行号）
    整64 起点 = 位置
    位置++
    布尔 闭合 = 假
    当 (位置 < 长度) {
        整64 字节 = 字节值(源码, 位置)
        如果 (多行前缀) {
            // 多行字符串内部换行合法（到 """ 才结束）；先于 未闭合 检查
            如果 (字节 == 10) {
                行号++
            }
            如果 (字节 == 34 && 位置 + 2 < 长度 &&
                 字节值(源码, 位置 + 1) == 34 && 字节值(源码, 位置 + 2) == 34) {
                位置 += 3
                闭合 = 真
                中断
            }
            位置++
            继续
        }
        如果 (字节 == 10) {
            中断  // 未闭合：容错到行尾（仅非多行字符串）
        }
        如果 (字节 == 34) {
            位置++
            闭合 = 真
            中断
        }
        如果 (字节 == 92 && !原始前缀) {  // \ 转义
            如果 (位置 + 1 < 长度 && 字节值(源码, 位置 + 1) == 117) {  // \u{
                位置 += 2
                当 (位置 < 长度 && 字节值(源码, 位置) != 125) {
                    位置++
                }
                如果 (位置 < 长度) {
                    位置++
                }
                继续
            }
            位置 += 2
            继续
        }
        位置++
    }
    如果 (!闭合) {
        记录(输出, "未知", 字符串子串(源码, 起点, 位置 - 起点), 起始行)
        返回 位置
    }
    记录(输出, "字符串字面量", 字符串子串(源码, 起点, 位置 - 起点), 起始行)
    返回 位置
}

// 扫描字符字面量（'x' 或 '\\u{XXXX}'）；输出 token 行；返回新位置
函数 扫描字符(字符串 源码, 整64 位置, 整64 长度, 向量<字符串> 输出, 整64 行号) -> 整64 {
    整64 起点 = 位置
    位置++
    布尔 闭合 = 假
    当 (位置 < 长度) {
        整64 字节 = 字节值(源码, 位置)
        如果 (字节 == 10) {
            中断
        }
        如果 (字节 == 39) {
            位置++
            闭合 = 真
            中断
        }
        如果 (字节 == 92) {
            如果 (位置 + 1 < 长度 && 字节值(源码, 位置 + 1) == 117) {
                位置 += 2
                当 (位置 < 长度 && 字节值(源码, 位置) != 125) {
                    位置++
                }
                如果 (位置 < 长度) {
                    位置++
                }
                继续
            }
            位置 += 2
            继续
        }
        位置++
    }
    如果 (!闭合) {
        记录(输出, "未知", 字符串子串(源码, 起点, 位置 - 起点), 行号)
        返回 位置
    }
    记录(输出, "字符字面量", 字符串子串(源码, 起点, 位置 - 起点), 行号)
    返回 位置
}