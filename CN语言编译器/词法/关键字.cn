// 自举 Task 7.1 子模块：词法/关键字（B 任务拆分，2026-08）
// 职责：49 个关键字查找（162-a 同步：46 保留字 + 遍历/中/每个 三个 v1 遗留上下文词；
//       删 自动/实现/公开/私有/静态/常量/模块/作为/包/货舱/保护/虚拟/重写/抽象/原始/多行，补 不安全）
// 门面 词法分析.cn 经 `导入 词法::关键字` 引入，调用 `关键字::查找关键字`
公开:

// 关键字查找（49 个，162-a 同步；拆 4 组控制行数）：命中返回关键字文本，否则空串
函数 查找关键字(字符串 文本) -> 字符串 {
    字符串 命中 = 关键字组A(文本);
    如果 (字符串长度(命中) > 0) {
        返回 命中;
    }
    命中 = 关键字组B(文本);
    如果 (字符串长度(命中) > 0) {
        返回 命中;
    }
    命中 = 关键字组C(文本);
    如果 (字符串长度(命中) > 0) {
        返回 命中;
    }
    返回 关键字组D(文本);
}
函数 关键字组A(字符串 文本) -> 字符串 {
    选择 (文本) {
        情况 "如果", "否则", "当", "循环", "返回", "中断", "继续", "选择", "情况", "默认",
              "遍历", "中", "每个":
            返回 字符串复制(文本);
        情况 "函数", "变量", "导入":
            返回 字符串复制(文本);
        默认:
            返回 "";
    }
}
函数 关键字组B(字符串 文本) -> 字符串 {
    选择 (文本) {
        情况 "整数", "小数", "整8", "整16", "整32", "整64", "整128":
            返回 字符串复制(文本);
        情况 "正8", "正16", "正32", "正64", "正128", "浮32", "浮64":
            返回 字符串复制(文本);
        情况 "布尔", "字符", "字符串", "空类型", "结构体", "联合体", "枚举":
            返回 字符串复制(文本);
        默认:
            返回 "";
    }
}
函数 关键字组C(字符串 文本) -> 字符串 {
    选择 (文本) {
        情况 "真", "假", "无":
            返回 字符串复制(文本);
        情况 "类", "接口", "自身", "父类", "友元":
            返回 字符串复制(文本);
        默认:
            返回 "";
    }
}
函数 关键字组D(字符串 文本) -> 字符串 {
    选择 (文本) {
        情况 "结果", "可选", "泛型", "不安全":
            返回 字符串复制(文本);
        默认:
            返回 "";
    }
}