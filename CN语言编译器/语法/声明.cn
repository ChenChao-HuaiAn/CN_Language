// 自举 Task 7.2 子模块：语法/声明（B 任务拆分，2026-08）
// 职责：声明解析（参数列表/函数/结构体/枚举/类/方法）
// 门面 语法分析.cn 经 `导入 语法::声明` 引入，调用 `声明::解析函数声明` 等
// 注：子模块间不写导入（避免 语法->声明->语法 循环依赖），表达式/语句函数
//   经门面导入链合并后全局可见，纯名调用
公开:

函数 解析参数列表(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    如果 (是运算符(记号, 位置, "(")) {
        位置++;
    }
    如果 (是运算符(记号, 位置, ")")) {
        返回 位置 + 1;
    }
    当 (真) {
        整64 名位置 = 位置;
        如果 (是类型起始(记号, 名位置) || 是标识符(记号, 名位置)) {
            名位置++;
        }
        如果 (是运算符(记号, 名位置, "<")) {
            整64 层 = 0;
            当 (名位置 < 记号.大小()) {
                如果 (是运算符(记号, 名位置, "<")) {
                    层++;
                }
                如果 (是运算符(记号, 名位置, ">")) {
                    层--;
                }
                名位置++;
                如果 (层 == 0) {
                    中断;
                }
            }
        }
        当 (真) {
            如果 (是运算符(记号, 名位置, "*") || 是运算符(记号, 名位置, "&")) {
                名位置++;
                继续;
            }
            如果 (是运算符(记号, 名位置, "[")) {
                当 (名位置 < 记号.大小() && !是运算符(记号, 名位置, "]")) {
                    名位置++;
                }
                名位置++;
                继续;
            }
            中断;
        }
        记录(输出, 深度, "参数|" + 当前文本(记号, 名位置));
        位置 = 解析类型(记号, 位置, 深度 + 1, 输出);
        如果 (是标识符(记号, 位置)) {
            位置++;
        }
        如果 (是运算符(记号, 位置, "=")) {
            位置++;
            位置 = 解析表达式(记号, 位置, 深度 + 1, 输出);
        }
        如果 (是运算符(记号, 位置, ",")) {
            位置++;
            继续;
        }
        中断;
    }
    如果 (是运算符(记号, 位置, ")")) {
        位置++;
    }
    返回 位置;
}
函数 解析函数声明(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    位置++;  // 函数
    字符串 名 = 当前文本(记号, 位置);
    位置++;
    整64 参数数 = 参数个数(记号, 位置);
    记录(输出, 深度, "函数|" + 名 + "|参数数=" + 整数转字符串(参数数));
    位置 = 解析参数列表(记号, 位置, 深度 + 1, 输出);
    如果 (是运算符(记号, 位置, "->")) {
        位置++;
        记录(输出, 深度 + 1, "返回类型");
        位置 = 解析类型(记号, 位置, 深度 + 2, 输出);
    }
    如果 (是运算符(记号, 位置, "{")) {
        位置 = 解析语句(记号, 位置, 深度 + 1, 输出);
    }
    返回 位置;
}
函数 解析结构体声明(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出, 布尔 联合) -> 整64 {
    字符串 种类 = "结构体";
    如果 (联合) {
        种类 = "联合体";
    }
    位置++;
    记录(输出, 深度, 种类 + "|" + 当前文本(记号, 位置));
    位置++;
    如果 (是运算符(记号, 位置, "{")) {
        位置++;
    }
    当 (位置 < 记号.大小() && !是运算符(记号, 位置, "}")) {
        记录(输出, 深度 + 1, "字段|" + 当前文本(记号, 位置 + 1));
        位置 = 解析类型(记号, 位置, 深度 + 2, 输出);
        如果 (是标识符(记号, 位置)) {
            位置++;
        }
    }
    如果 (是运算符(记号, 位置, "}")) {
        位置++;
    }
    返回 位置;
}
函数 解析枚举声明(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    位置++;
    记录(输出, 深度, "枚举|" + 当前文本(记号, 位置));
    位置++;
    如果 (是运算符(记号, 位置, "{")) {
        位置++;
    }
    当 (位置 < 记号.大小() && !是运算符(记号, 位置, "}")) {
        记录(输出, 深度 + 1, "枚举成员|" + 当前文本(记号, 位置));
        位置++;
        如果 (是运算符(记号, 位置, "=")) {
            位置 += 2;
        }
        如果 (是运算符(记号, 位置, ",")) {
            位置++;
        }
    }
    如果 (是运算符(记号, 位置, "}")) {
        位置++;
    }
    返回 位置;
}
函数 解析类声明(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    位置++;  // 类
    记录(输出, 深度, "类|" + 当前文本(记号, 位置));
    位置++;
    如果 (是运算符(记号, 位置, "{")) {
        位置++;
    }
    字符串 分区 = "公开";
    当 (位置 < 记号.大小() && !是运算符(记号, 位置, "}")) {
        如果 (是关键字(记号, 位置, "公开") || 是关键字(记号, 位置, "私有") ||
             是关键字(记号, 位置, "保护")) {
            分区 = 当前文本(记号, 位置);
            记录(输出, 深度 + 1, "分区|" + 分区);
            位置++;
            如果 (是运算符(记号, 位置, ":")) {
                位置++;
            }
            继续;
        }
        如果 (是类型起始(记号, 位置)) {
            记录(输出, 深度 + 1, "字段|" + 当前文本(记号, 位置 + 1));
            位置 = 解析类型(记号, 位置, 深度 + 2, 输出);
            如果 (是标识符(记号, 位置)) {
                位置++;
            }
            继续;
        }
        如果 (是关键字(记号, 位置, "函数")) {
            位置 = 解析方法(记号, 位置, 深度 + 1, 输出);
            继续;
        }
        如果 (是关键字(记号, 位置, "常量") || 是关键字(记号, 位置, "虚拟") ||
             是关键字(记号, 位置, "重写") || 是关键字(记号, 位置, "静态")) {
            记录(输出, 深度 + 1, "修饰|" + 当前文本(记号, 位置));
            位置++;
            如果 (是关键字(记号, 位置, "函数")) {
                位置 = 解析方法(记号, 位置, 深度 + 1, 输出);
            }
            继续;
        }
        如果 (是运算符(记号, 位置, "~")) {
            位置++;
            记录(输出, 深度 + 1, "析构|" + 当前文本(记号, 位置));
            位置++;
            位置 = 解析参数列表(记号, 位置, 深度 + 2, 输出);
            如果 (是运算符(记号, 位置, "{")) {
                位置 = 解析语句(记号, 位置, 深度 + 2, 输出);
            }
            继续;
        }
        如果 (是标识符(记号, 位置)) {
            记录(输出, 深度 + 1, "构造|" + 当前文本(记号, 位置));
            位置++;
            位置 = 解析参数列表(记号, 位置, 深度 + 2, 输出);
            如果 (是运算符(记号, 位置, "{")) {
                位置 = 解析语句(记号, 位置, 深度 + 2, 输出);
            }
            继续;
        }
        如果 (是关键字(记号, 位置, "运算符")) {
            记录(输出, 深度 + 1, "运算符|" + 当前文本(记号, 位置 + 1));
            位置 += 2;
            位置 = 解析参数列表(记号, 位置, 深度 + 2, 输出);
            如果 (是运算符(记号, 位置, "{")) {
                位置 = 解析语句(记号, 位置, 深度 + 2, 输出);
            }
            继续;
        }
        位置++;  // 防御
    }
    如果 (是运算符(记号, 位置, "}")) {
        位置++;
    }
    返回 位置;
}
函数 解析方法(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    位置++;  // 函数
    记录(输出, 深度, "方法|" + 当前文本(记号, 位置) + "|参数数=" +
         整数转字符串(参数个数(记号, 位置)));
    位置++;
    位置 = 解析参数列表(记号, 位置, 深度 + 1, 输出);
    如果 (是运算符(记号, 位置, "->")) {
        位置++;
        记录(输出, 深度 + 1, "返回类型");
        位置 = 解析类型(记号, 位置, 深度 + 2, 输出);
    }
    如果 (是运算符(记号, 位置, "{")) {
        位置 = 解析语句(记号, 位置, 深度 + 1, 输出);
    }
    返回 位置;
}