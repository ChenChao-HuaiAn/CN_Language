// 自举 Task 7.2 子模块：语法/顶层（B 任务拆分，2026-08）
// 职责：程序顶层解析（导入/可见性/外部/泛型/函数/结构体/联合体/枚举/类/常量/静态）
// 门面 语法分析.cn 经 `导入 语法::顶层` 引入，调用 `顶层::解析程序`
// 注：子模块间不写导入（避免 语法->顶层->语法 循环依赖），表达式/语句/声明
//   函数经门面导入链合并后全局可见，纯名调用
公开:

函数 解析程序(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    当 (位置 < 记号.大小() && !字符串比较(当前类型(记号, 位置), "文件结束")) {
        如果 (是关键字(记号, 位置, "导入")) {
            位置++
            记录(输出, 深度, "导入|" + 当前文本(记号, 位置))
            位置++
            如果 (是运算符(记号, 位置, "::")) {
                记录(输出, 深度, "导入符号|" + 当前文本(记号, 位置 + 1))
                位置 += 2
            }
            如果 (是关键字(记号, 位置, "作为")) {
                位置 += 2
            }
            继续
        }
        如果 (是关键字(记号, 位置, "公开") || 是关键字(记号, 位置, "私有")) {
            位置++  // 可见性（下一声明吸收）
            继续
        }
        如果 (是关键字(记号, 位置, "外部")) {
            记录(输出, 深度, "外部函数")
            位置++
            如果 (是关键字(记号, 位置, "函数")) {
                位置 = 解析函数声明(记号, 位置, 深度, 输出)
            }
            继续
        }
        如果 (是关键字(记号, 位置, "泛型")) {
            位置++
            整64 参数数 = 0
            如果 (是运算符(记号, 位置, "<")) {
                位置++
                当 (位置 < 记号.大小() && !是运算符(记号, 位置, ">")) {
                    如果 (是标识符(记号, 位置) &&
                        !字符串比较(当前文本(记号, 位置), "类型")) {
                        参数数++
                    }
                    位置++
                }
                如果 (是运算符(记号, 位置, ">")) {
                    位置++
                }
            }
            如果 (是关键字(记号, 位置, "函数")) {
                位置++
                字符串 名 = 当前文本(记号, 位置)
                记录(输出, 深度, "泛型函数|" + 名 + "|参数数=" + 整数转字符串(参数数))
                位置++
                位置 = 解析参数列表(记号, 位置, 深度 + 1, 输出)
                如果 (是运算符(记号, 位置, "->")) {
                    位置++
                    记录(输出, 深度 + 1, "返回类型")
                    位置 = 解析类型(记号, 位置, 深度 + 2, 输出)
                }
                如果 (是运算符(记号, 位置, "{")) {
                    位置 = 解析语句(记号, 位置, 深度 + 1, 输出)
                }
                继续
            }
            如果 (是关键字(记号, 位置, "类")) {
                位置++
                记录(输出, 深度, "泛型类|" + 当前文本(记号, 位置) + "|参数数=" +
                     整数转字符串(参数数))
                位置++
                如果 (是运算符(记号, 位置, "{")) {
                    位置++
                }
                字符串 分区2 = "公开"
                当 (位置 < 记号.大小() && !是运算符(记号, 位置, "}")) {
                    如果 (是关键字(记号, 位置, "公开") || 是关键字(记号, 位置, "私有") ||
                         是关键字(记号, 位置, "保护")) {
                        记录(输出, 深度 + 1, "分区|" + 当前文本(记号, 位置))
                        位置++
                        如果 (是运算符(记号, 位置, ":")) {
                            位置++
                        }
                        继续
                    }
                    如果 (是类型起始(记号, 位置)) {
                        记录(输出, 深度 + 1, "字段|" + 当前文本(记号, 位置 + 1))
                        位置 = 解析类型(记号, 位置, 深度 + 2, 输出)
                        如果 (是标识符(记号, 位置)) {
                            位置++
                        }
                        继续
                    }
                    如果 (是关键字(记号, 位置, "函数")) {
                        位置 = 解析方法(记号, 位置, 深度 + 1, 输出)
                        继续
                    }
                    如果 (是关键字(记号, 位置, "常量") || 是关键字(记号, 位置, "虚拟") ||
                         是关键字(记号, 位置, "重写") || 是关键字(记号, 位置, "静态")) {
                        记录(输出, 深度 + 1, "修饰|" + 当前文本(记号, 位置))
                        位置++
                        如果 (是关键字(记号, 位置, "函数")) {
                            位置 = 解析方法(记号, 位置, 深度 + 1, 输出)
                        }
                        继续
                    }
                    如果 (是标识符(记号, 位置)) {
                        记录(输出, 深度 + 1, "构造|" + 当前文本(记号, 位置))
                        位置++
                        位置 = 解析参数列表(记号, 位置, 深度 + 2, 输出)
                        如果 (是运算符(记号, 位置, "{")) {
                            位置 = 解析语句(记号, 位置, 深度 + 2, 输出)
                        }
                        继续
                    }
                    如果 (是运算符(记号, 位置, "~")) {
                        位置++
                        记录(输出, 深度 + 1, "析构|" + 当前文本(记号, 位置))
                        位置++
                        位置 = 解析参数列表(记号, 位置, 深度 + 2, 输出)
                        如果 (是运算符(记号, 位置, "{")) {
                            位置 = 解析语句(记号, 位置, 深度 + 2, 输出)
                        }
                        继续
                    }
                    如果 (是关键字(记号, 位置, "运算符")) {
                        记录(输出, 深度 + 1, "运算符|" + 当前文本(记号, 位置 + 1))
                        位置 += 2
                        位置 = 解析参数列表(记号, 位置, 深度 + 2, 输出)
                        如果 (是运算符(记号, 位置, "{")) {
                            位置 = 解析语句(记号, 位置, 深度 + 2, 输出)
                        }
                        继续
                    }
                    位置++
                }
                如果 (是运算符(记号, 位置, "}")) {
                    位置++
                }
                继续
            }
            继续
        }
        如果 (是关键字(记号, 位置, "函数")) {
            位置 = 解析函数声明(记号, 位置, 深度, 输出)
            继续
        }
        如果 (是关键字(记号, 位置, "结构体")) {
            位置 = 解析结构体声明(记号, 位置, 深度, 输出, 假)
            继续
        }
        如果 (是关键字(记号, 位置, "联合体")) {
            位置 = 解析结构体声明(记号, 位置, 深度, 输出, 真)
            继续
        }
        如果 (是关键字(记号, 位置, "枚举")) {
            位置 = 解析枚举声明(记号, 位置, 深度, 输出)
            继续
        }
        如果 (是关键字(记号, 位置, "类")) {
            位置 = 解析类声明(记号, 位置, 深度, 输出)
            继续
        }
        如果 (是关键字(记号, 位置, "常量") || 是关键字(记号, 位置, "静态")) {
            记录(输出, 深度, "顶层" + 当前文本(记号, 位置) + "|" + 当前文本(记号, 位置 + 1))
            位置 += 2
            如果 (是运算符(记号, 位置, "=")) {
                位置++
                位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
            }
            继续
        }
        位置++  // 防御：跳过未知声明
    }
    返回 位置
}