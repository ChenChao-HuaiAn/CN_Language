// 自举 Task 7.2 子模块：语法/语句（B 任务拆分，2026-08）
// 职责：语句解析（块/如果/当/循环/选择/返回/跳转/遍历/变量/常量/类型声明）
// 门面 语法分析.cn 经 `导入 语法::语句` 引入，调用 `语句::解析语句`
// 注：子模块间不写导入（避免 语法->语句->语法 循环依赖），表达式函数
//   经门面导入链合并后全局可见，纯名调用（解析表达式/解析类型/是类型起始）
公开:

函数 解析语句(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    如果 (是运算符(记号, 位置, "{")) {
        记录(输出, 深度, "块")
        位置++
        当 (位置 < 记号.大小() && !是运算符(记号, 位置, "}")) {
            位置 = 解析语句(记号, 位置, 深度 + 1, 输出)
        }
        如果 (是运算符(记号, 位置, "}")) {
            位置++
        }
        返回 位置
    }
    如果 (是关键字(记号, 位置, "如果")) {
        记录(输出, 深度, "如果")
        位置++
        如果 (是运算符(记号, 位置, "(")) {
            位置++
            位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
            如果 (是运算符(记号, 位置, ")")) {
                位置++
            }
        }
        位置 = 解析语句(记号, 位置, 深度 + 1, 输出)
        如果 (是关键字(记号, 位置, "否则")) {
            记录(输出, 深度, "否则")
            位置++
            位置 = 解析语句(记号, 位置, 深度 + 1, 输出)
        }
        返回 位置
    }
    如果 (是关键字(记号, 位置, "当")) {
        记录(输出, 深度, "当")
        位置++
        如果 (是运算符(记号, 位置, "(")) {
            位置++
            位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
            如果 (是运算符(记号, 位置, ")")) {
                位置++
            }
        }
        返回 解析语句(记号, 位置, 深度 + 1, 输出)
    }
    如果 (是关键字(记号, 位置, "循环")) {
        记录(输出, 深度, "循环")
        位置++
        如果 (是运算符(记号, 位置, "(")) {
            位置++  // 循环(初始化; 条件; 更新)
            如果 (!是运算符(记号, 位置, ";")) {
                位置 = 解析语句(记号, 位置, 深度 + 1, 输出)
            }
            如果 (是运算符(记号, 位置, ";")) {
                位置++
            }
            如果 (!是运算符(记号, 位置, ";")) {
                位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
            }
            如果 (是运算符(记号, 位置, ";")) {
                位置++
            }
            如果 (!是运算符(记号, 位置, ")")) {
                位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
            }
            如果 (是运算符(记号, 位置, ")")) {
                位置++
            }
        }
        返回 解析语句(记号, 位置, 深度 + 1, 输出)
    }
    如果 (是关键字(记号, 位置, "选择")) {
        记录(输出, 深度, "选择")
        位置++
        如果 (是运算符(记号, 位置, "(")) {
            位置++
            位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
            如果 (是运算符(记号, 位置, ")")) {
                位置++
            }
        }
        如果 (是运算符(记号, 位置, "{")) {
            位置++
        }
        当 (位置 < 记号.大小() && !是运算符(记号, 位置, "}")) {
            如果 (是关键字(记号, 位置, "情况")) {
                位置++
                记录(输出, 深度, "情况|" + 当前文本(记号, 位置))
                位置++
                当 (是运算符(记号, 位置, ",")) {
                    位置++
                    记录(输出, 深度, "情况|" + 当前文本(记号, 位置))
                    位置++
                }
                如果 (是运算符(记号, 位置, ":")) {
                    位置++
                }
                当 (位置 < 记号.大小() && !是关键字(记号, 位置, "情况") &&
                     !是关键字(记号, 位置, "默认") && !是运算符(记号, 位置, "}")) {
                    位置 = 解析语句(记号, 位置, 深度 + 1, 输出)
                }
                继续
            }
            如果 (是关键字(记号, 位置, "默认")) {
                记录(输出, 深度, "默认")
                位置++
                如果 (是运算符(记号, 位置, ":")) {
                    位置++
                }
                当 (位置 < 记号.大小() && !是运算符(记号, 位置, "}")) {
                    位置 = 解析语句(记号, 位置, 深度 + 1, 输出)
                }
                继续
            }
            位置++  // 防御：跳过未知
        }
        如果 (是运算符(记号, 位置, "}")) {
            位置++
        }
        返回 位置
    }
    如果 (是关键字(记号, 位置, "返回")) {
        记录(输出, 深度, "返回")
        位置++
        如果 (!是运算符(记号, 位置, "}") && !是运算符(记号, 位置, ";")) {
            位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
        }
        返回 位置
    }
    如果 (是关键字(记号, 位置, "中断") || 是关键字(记号, 位置, "继续")) {
        记录(输出, 深度, "跳转|" + 当前文本(记号, 位置))
        返回 位置 + 1
    }
    如果 (是关键字(记号, 位置, "遍历")) {
        记录(输出, 深度, "遍历")
        位置++
        位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
        如果 (是关键字(记号, 位置, "中")) {
            位置++
        }
        如果 (是关键字(记号, 位置, "每个")) {
            位置++
        }
        如果 (是标识符(记号, 位置)) {
            记录(输出, 深度 + 1, "循环变量|" + 当前文本(记号, 位置))
            位置++
        }
        返回 解析语句(记号, 位置, 深度 + 1, 输出)
    }
    如果 (是关键字(记号, 位置, "变量")) {
        位置++
        记录(输出, 深度, "变量|" + 当前文本(记号, 位置))
        位置++
        如果 (是运算符(记号, 位置, "=")) {
            位置++
            位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
        }
        返回 位置
    }
    如果 (是关键字(记号, 位置, "常量")) {
        位置++
        记录(输出, 深度, "常量|" + 当前文本(记号, 位置))
        位置++
        如果 (是运算符(记号, 位置, "=")) {
            位置++
            位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
        }
        返回 位置
    }
    如果 (是类型起始(记号, 位置)) {
        整64 名位置 = 位置 + 1
        当 (名位置 < 记号.大小() && !是标识符(记号, 名位置)) {
            名位置++
        }
        记录(输出, 深度, "变量|" + 当前文本(记号, 名位置))
        位置 = 解析类型(记号, 位置, 深度 + 1, 输出)
        如果 (是标识符(记号, 位置)) {
            位置++
        }
        如果 (是运算符(记号, 位置, "=")) {
            位置++
            如果 (是运算符(记号, 位置, "{")) {
                记录(输出, 深度, "初始化列表")
                位置++
                如果 (!是运算符(记号, 位置, "}")) {
                    当 (真) {
                        位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
                        如果 (是运算符(记号, 位置, ",")) {
                            位置++
                            继续
                        }
                        中断
                    }
                }
                如果 (是运算符(记号, 位置, "}")) {
                    位置++
                }
            } 否则 {
                位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
            }
        }
        返回 位置
    }
    位置 = 解析表达式(记号, 位置, 深度, 输出)
    返回 位置
}