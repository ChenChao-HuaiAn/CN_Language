// 自举 Task 7.2：CN 语法分析器（用 CN 重写 C++ 版 parser，2026-08）
// 对标：src/cn_compiler/parser（parser.cpp/parser_expr.cpp/parser_stmt.cpp/parser_oop.cpp）
// 覆盖（规格书 01~08）：
//   程序：导入（模块/::符号）、公开/私有 可见性、泛型 <类型 T,...> 函数/类、
//     函数（重载/默认参数/-> 返回类型/外部）、结构体/联合体/枚举、类
//     （公开:/私有:/保护: 分区、字段/方法/构造/析构/虚拟/重写/静态/常量/运算符）、
//     顶层 常量/静态
//   语句：变量声明（含 自动/数组/初始化列表）、如果/否则如果链、当、循环(;;)、
导入 容器::向量
导入 词法分析::分词
公开:
函数 解析(字符串 源码) -> 向量<字符串> {
    向量<字符串> 输出 = 向量<字符串>()
    向量<字符串> 记号 = 分词(源码)
    记录(输出, 0, "程序")
    整64 位置 = 解析程序(记号, 0, 1, 输出)
    返回 输出
}
函数 记号行位(字符串 记号) -> 整64 {
    整64 i = 字符串长度(记号) - 1
    当 (i >= 0) {
        如果 (字节值(记号, i) == 124) {
            整64 k = i + 1
            布尔 全数字 = 真
            当 (k < 字符串长度(记号)) {
                整64 字节 = 字节值(记号, k)
                如果 (字节 < 48 || 字节 > 57) {
                    全数字 = 假
                }
                k++
            }
            如果 (全数字 && k > i + 1) {
                返回 i
            }
        }
        i--
    }
    返回 -1
}
函数 记号类型(字符串 记号) -> 字符串 {
    整64 行位 = 记号行位(记号)
    如果 (行位 < 0) {
        返回 ""
    }
    字符串 前缀 = 字符串子串(记号, 0, 行位)
    整64 位 = 字符串查找(前缀, "|")
    如果 (位 < 0) {
        返回 前缀
    }
    返回 字符串子串(前缀, 0, 位)
}
函数 记号文本(字符串 记号) -> 字符串 {
    整64 行位 = 记号行位(记号)
    如果 (行位 < 0) {
        返回 ""
    }
    字符串 前缀 = 字符串子串(记号, 0, 行位)
    整64 位 = 字符串查找(前缀, "|")
    如果 (位 < 0) {
        返回 ""
    }
    返回 字符串子串(前缀, 位 + 1, 行位 - 位 - 1)
}
函数 当前类型(向量<字符串> 记号, 整64 位置) -> 字符串 {
    如果 (位置 >= 记号.大小()) {
        返回 "文件结束"
    }
    返回 记号类型(记号.元素(位置))
}
函数 当前文本(向量<字符串> 记号, 整64 位置) -> 字符串 {
    如果 (位置 >= 记号.大小()) {
        返回 ""
    }
    返回 记号文本(记号.元素(位置))
}
函数 是关键字(向量<字符串> 记号, 整64 位置, 字符串 文本) -> 布尔 {
    返回 字符串比较(当前类型(记号, 位置), 文本)
}
函数 是运算符(向量<字符串> 记号, 整64 位置, 字符串 符号) -> 布尔 {
    如果 (字符串比较(当前类型(记号, 位置), 符号)) {
        返回 真
    }
    如果 (字符串比较(当前类型(记号, 位置), "符号") &&
         字符串比较(当前文本(记号, 位置), 符号)) {
        返回 真
    }
    返回 假
}
函数 是标识符(向量<字符串> 记号, 整64 位置) -> 布尔 {
    返回 字符串比较(当前类型(记号, 位置), "标识符")
}
函数 记录(向量<字符串> 输出, 整64 深度, 字符串 节点) -> 空类型 {
    字符串 行 = ""
    整64 i = 0
    当 (i < 深度) {
        行 = 行 + "  "
        i++
    }
    行 = 行 + 节点
    结果<空类型, 整32> 加 = 输出.追加(行)
    如果 (!加.正常) {
        运行时错误(4)
    }
}
函数 解析类型(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    记录(输出, 深度, "类型|" + 当前文本(记号, 位置))
    位置++
    如果 (是运算符(记号, 位置, "<")) {
        位置++
        整64 层 = 1
        当 (位置 < 记号.大小() && 层 > 0) {
            如果 (是运算符(记号, 位置, "<")) {
                层++
            }
            如果 (是运算符(记号, 位置, ">")) {
                层--
            }
            位置++
        }
    }
    当 (真) {
        如果 (是运算符(记号, 位置, "*") || 是运算符(记号, 位置, "&")) {
            记录(输出, 深度, "类型后缀|" + 当前文本(记号, 位置))
            位置++
            继续
        }
        如果 (是运算符(记号, 位置, "[")) {
            记录(输出, 深度, "类型后缀|[" + 当前文本(记号, 位置 + 1) + "]")
            位置 += 2
            如果 (是运算符(记号, 位置, "]")) {
                位置++
            }
            继续
        }
        中断
    }
    返回 位置
}
函数 解析主(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    字符串 类型 = 当前类型(记号, 位置)
    如果 (字符串比较(类型, "整数字面量") || 字符串比较(类型, "浮点字面量") ||
         字符串比较(类型, "字符串字面量") || 字符串比较(类型, "字符字面量")) {
        记录(输出, 深度, "字面量|" + 当前文本(记号, 位置))
        返回 位置 + 1
    }
    如果 (是关键字(记号, 位置, "真") || 是关键字(记号, 位置, "假") ||
         是关键字(记号, 位置, "无")) {
        记录(输出, 深度, "字面量|" + 当前文本(记号, 位置))
        返回 位置 + 1
    }
    如果 (是关键字(记号, 位置, "原始") || 是关键字(记号, 位置, "多行")) {
        记录(输出, 深度, "字面量前缀|" + 当前文本(记号, 位置))
        位置++
        如果 (字符串比较(当前类型(记号, 位置), "字符串字面量")) {
            记录(输出, 深度, "字面量|" + 当前文本(记号, 位置))
            位置++
        }
        返回 位置
    }
    如果 (是运算符(记号, 位置, "(")) {
        位置++
        位置 = 解析表达式(记号, 位置, 深度, 输出)
        如果 (是运算符(记号, 位置, ")")) {
            位置++
        }
        返回 位置
    }
    如果 (是类型关键字(记号, 位置) && 是运算符(记号, 位置 + 1, "(")) {
        记录(输出, 深度, "强制转换|" + 当前文本(记号, 位置))
        位置 += 2
        位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
        如果 (是运算符(记号, 位置, ")")) {
            位置++
        }
        返回 位置
    }
    如果 (是标识符(记号, 位置)) {
        记录(输出, 深度, "标识符|" + 当前文本(记号, 位置))
        返回 位置 + 1
    }
    返回 位置 + 1
}
函数 解析后缀(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    位置 = 解析主(记号, 位置, 深度, 输出)
    当 (真) {
        如果 (是运算符(记号, 位置, "(")) {
            记录(输出, 深度, "调用|参数数=" + 整数转字符串(参数个数(记号, 位置)))
            位置++
            如果 (!是运算符(记号, 位置, ")")) {
                当 (真) {
                    位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
                    如果 (是运算符(记号, 位置, ",")) {
                        位置++
                        继续
                    }
                    中断
                }
            }
            如果 (是运算符(记号, 位置, ")")) {
                位置++
            }
            继续
        }
        如果 (是运算符(记号, 位置, ".") || 是运算符(记号, 位置, "->")) {
            记录(输出, 深度, "成员|" + 当前文本(记号, 位置) + "|" + 当前文本(记号, 位置 + 1))
            位置 += 2
            继续
        }
        如果 (是运算符(记号, 位置, "[")) {
            记录(输出, 深度, "下标")
            位置++
            位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
            如果 (是运算符(记号, 位置, "]")) {
                位置++
            }
            继续
        }
        如果 (是运算符(记号, 位置, "++") || 是运算符(记号, 位置, "--")) {
            记录(输出, 深度, "后缀|" + 当前文本(记号, 位置))
            位置++
            继续
        }
        中断
    }
    返回 位置
}
函数 参数个数(向量<字符串> 记号, 整64 位置) -> 整64 {
    如果 (是运算符(记号, 位置 + 1, ")")) {
        返回 0
    }
    如果 (是运算符(记号, 位置 + 1, "(") && 是运算符(记号, 位置 + 2, ")")) {
        返回 0
    }
    整64 数量 = 0
    整64 内层 = 0
    整64 i = 位置
    当 (i < 记号.大小()) {
        如果 (是运算符(记号, i, "(") || 是运算符(记号, i, "[") ||
             是运算符(记号, i, "{")) {
            内层++
        }
        如果 (是运算符(记号, i, ")") || 是运算符(记号, i, "]") ||
             是运算符(记号, i, "}")) {
            如果 (内层 == 0) {
                返回 数量
            }
            内层--
            如果 (内层 == 0) {
                如果 (数量 == 0) {
                    返回 1
                }
                返回 数量 + 1
            }
        }
        如果 (是运算符(记号, i, ",") && 内层 == 1) {
            数量++
        }
        i++
    }
    返回 数量
}
函数 解析一元(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    如果 (是运算符(记号, 位置, "!") || 是运算符(记号, 位置, "-") ||
         是运算符(记号, 位置, "&") || 是运算符(记号, 位置, "*") ||
         是运算符(记号, 位置, "++") || 是运算符(记号, 位置, "--")) {
        记录(输出, 深度, "一元|" + 当前文本(记号, 位置))
        返回 解析一元(记号, 位置 + 1, 深度 + 1, 输出)
    }
    返回 解析后缀(记号, 位置, 深度, 输出)
}
函数 是层运算符(向量<字符串> 记号, 整64 位置, 整64 层号) -> 布尔 {
    如果 (层号 == 0) {
        返回 是运算符(记号, 位置, "*") || 是运算符(记号, 位置, "/") ||
               是运算符(记号, 位置, "%")
    }
    如果 (层号 == 1) {
        返回 是运算符(记号, 位置, "+") || 是运算符(记号, 位置, "-")
    }
    如果 (层号 == 2) {
        返回 是运算符(记号, 位置, "<<") || 是运算符(记号, 位置, ">>")
    }
    如果 (层号 == 3) {
        返回 是运算符(记号, 位置, "<") || 是运算符(记号, 位置, "<=") ||
               是运算符(记号, 位置, ">") || 是运算符(记号, 位置, ">=")
    }
    如果 (层号 == 4) {
        返回 是运算符(记号, 位置, "==") || 是运算符(记号, 位置, "!=")
    }
    如果 (层号 == 5) { 返回 是运算符(记号, 位置, "&") }
    如果 (层号 == 6) { 返回 是运算符(记号, 位置, "^") }
    如果 (层号 == 7) { 返回 是运算符(记号, 位置, "|") }
    如果 (层号 == 8) { 返回 是运算符(记号, 位置, "&&") }
    返回 是运算符(记号, 位置, "||")
}
函数 解析子层(向量<字符串> 记号, 整64 位置, 整64 深度,
               向量<字符串> 输出, 整64 层号) -> 整64 {
    如果 (层号 <= 0) {
        返回 解析一元(记号, 位置, 深度, 输出)
    }
    返回 解析二元层(记号, 位置, 深度, 输出, 层号 - 1)
}
函数 解析二元层(向量<字符串> 记号, 整64 位置, 整64 深度,
                 向量<字符串> 输出, 整64 层号) -> 整64 {
    位置 = 解析子层(记号, 位置, 深度, 输出, 层号)
    当 (真) {
        如果 (是层运算符(记号, 位置, 层号)) {
            记录(输出, 深度, "二元|" + 当前文本(记号, 位置))
            位置++
            位置 = 解析子层(记号, 位置, 深度 + 1, 输出, 层号)
            继续
        }
        中断
    }
    返回 位置
}
函数 解析赋值(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    位置 = 解析二元层(记号, 位置, 深度, 输出, 9)
    如果 (是运算符(记号, 位置, "=") || 是运算符(记号, 位置, "+=") ||
         是运算符(记号, 位置, "-=") || 是运算符(记号, 位置, "*=") ||
         是运算符(记号, 位置, "/=") || 是运算符(记号, 位置, "%=") ||
         是运算符(记号, 位置, "&=") || 是运算符(记号, 位置, "|=") ||
         是运算符(记号, 位置, "^=") || 是运算符(记号, 位置, "<<=") ||
         是运算符(记号, 位置, ">>=")) {
        记录(输出, 深度, "赋值|" + 当前文本(记号, 位置))
        位置++
        位置 = 解析赋值(记号, 位置, 深度 + 1, 输出)
    }
    返回 位置
}
函数 解析三元(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    位置 = 解析赋值(记号, 位置, 深度, 输出)
    如果 (是运算符(记号, 位置, "?")) {
        记录(输出, 深度, "三元")
        位置++
        位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
        如果 (是运算符(记号, 位置, ":")) {
            位置++
        }
        位置 = 解析三元(记号, 位置, 深度 + 1, 输出)
    }
    返回 位置
}
函数 解析表达式(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    返回 解析三元(记号, 位置, 深度, 输出)
}
函数 是类型起始(向量<字符串> 记号, 整64 位置) -> 布尔 {
    字符串 文本 = 当前文本(记号, 位置)
    如果 (字符串比较(文本, "整8") || 字符串比较(文本, "整16") ||
         字符串比较(文本, "整32") || 字符串比较(文本, "整64") ||
         字符串比较(文本, "整128") || 字符串比较(文本, "正8") ||
         字符串比较(文本, "正16") || 字符串比较(文本, "正32") ||
         字符串比较(文本, "正64") || 字符串比较(文本, "正128") ||
         字符串比较(文本, "浮32") || 字符串比较(文本, "浮64") ||
         字符串比较(文本, "布尔") || 字符串比较(文本, "字符") ||
         字符串比较(文本, "字符串") || 字符串比较(文本, "空类型") ||
         字符串比较(文本, "整数") || 字符串比较(文本, "小数")) {
        返回 真
    }
    如果 (是标识符(记号, 位置) && 位置 + 1 < 记号.大小()) {
        字符串 次 = 当前类型(记号, 位置 + 1)
        如果 (字符串比较(次, "标识符") || 字符串比较(次, "[") ||
             字符串比较(次, "&") || 字符串比较(次, "*")) {
            返回 真
        }
    }
    返回 假
}
函数 是类型关键字(向量<字符串> 记号, 整64 位置) -> 布尔 {
    字符串 文本 = 当前文本(记号, 位置)
    返回 字符串比较(文本, "整8") || 字符串比较(文本, "整16") ||
           字符串比较(文本, "整32") || 字符串比较(文本, "整64") ||
           字符串比较(文本, "整128") || 字符串比较(文本, "正8") ||
           字符串比较(文本, "正16") || 字符串比较(文本, "正32") ||
           字符串比较(文本, "正64") || 字符串比较(文本, "正128") ||
           字符串比较(文本, "浮32") || 字符串比较(文本, "浮64") ||
           字符串比较(文本, "布尔") || 字符串比较(文本, "字符") ||
           字符串比较(文本, "字符串") || 字符串比较(文本, "空类型") ||
           字符串比较(文本, "整数") || 字符串比较(文本, "小数")
}
函数 解析语句(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    如果 (是运算符(记号, 位置, "{")) {
        记录(输出, 深度, "块")
        位置++
        当 (位置 < 记号.大小() && !是运算符(记号, 位置, "}")) {
            位置 = 解析语句(记号, 位置, 深度 + 1, 输出)
        }
        如果 (是运算符(记号, 位置, "}")) {
            位置++
        }
        返回 位置
    }
    如果 (是关键字(记号, 位置, "如果")) {
        记录(输出, 深度, "如果")
        位置++
        如果 (是运算符(记号, 位置, "(")) {
            位置++
            位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
            如果 (是运算符(记号, 位置, ")")) {
                位置++
            }
        }
        位置 = 解析语句(记号, 位置, 深度 + 1, 输出)
        如果 (是关键字(记号, 位置, "否则")) {
            记录(输出, 深度, "否则")
            位置++
            位置 = 解析语句(记号, 位置, 深度 + 1, 输出)
        }
        返回 位置
    }
    如果 (是关键字(记号, 位置, "当")) {
        记录(输出, 深度, "当")
        位置++
        如果 (是运算符(记号, 位置, "(")) {
            位置++
            位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
            如果 (是运算符(记号, 位置, ")")) {
                位置++
            }
        }
        返回 解析语句(记号, 位置, 深度 + 1, 输出)
    }
    如果 (是关键字(记号, 位置, "循环")) {
        记录(输出, 深度, "循环")
        位置++
        如果 (是运算符(记号, 位置, "(")) {
            位置++  // 循环(初始化; 条件; 更新)
            如果 (!是运算符(记号, 位置, ";")) {
                位置 = 解析语句(记号, 位置, 深度 + 1, 输出)
            }
            如果 (是运算符(记号, 位置, ";")) {
                位置++
            }
            如果 (!是运算符(记号, 位置, ";")) {
                位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
            }
            如果 (是运算符(记号, 位置, ";")) {
                位置++
            }
            如果 (!是运算符(记号, 位置, ")")) {
                位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
            }
            如果 (是运算符(记号, 位置, ")")) {
                位置++
            }
        }
        返回 解析语句(记号, 位置, 深度 + 1, 输出)
    }
    如果 (是关键字(记号, 位置, "选择")) {
        记录(输出, 深度, "选择")
        位置++
        如果 (是运算符(记号, 位置, "(")) {
            位置++
            位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
            如果 (是运算符(记号, 位置, ")")) {
                位置++
            }
        }
        如果 (是运算符(记号, 位置, "{")) {
            位置++
        }
        当 (位置 < 记号.大小() && !是运算符(记号, 位置, "}")) {
            如果 (是关键字(记号, 位置, "情况")) {
                位置++
                记录(输出, 深度, "情况|" + 当前文本(记号, 位置))
                位置++
                当 (是运算符(记号, 位置, ",")) {
                    位置++
                    记录(输出, 深度, "情况|" + 当前文本(记号, 位置))
                    位置++
                }
                如果 (是运算符(记号, 位置, ":")) {
                    位置++
                }
                当 (位置 < 记号.大小() && !是关键字(记号, 位置, "情况") &&
                     !是关键字(记号, 位置, "默认") && !是运算符(记号, 位置, "}")) {
                    位置 = 解析语句(记号, 位置, 深度 + 1, 输出)
                }
                继续
            }
            如果 (是关键字(记号, 位置, "默认")) {
                记录(输出, 深度, "默认")
                位置++
                如果 (是运算符(记号, 位置, ":")) {
                    位置++
                }
                当 (位置 < 记号.大小() && !是运算符(记号, 位置, "}")) {
                    位置 = 解析语句(记号, 位置, 深度 + 1, 输出)
                }
                继续
            }
            位置++  // 防御：跳过未知
        }
        如果 (是运算符(记号, 位置, "}")) {
            位置++
        }
        返回 位置
    }
    如果 (是关键字(记号, 位置, "返回")) {
        记录(输出, 深度, "返回")
        位置++
        如果 (!是运算符(记号, 位置, "}") && !是运算符(记号, 位置, ";")) {
            位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
        }
        返回 位置
    }
    如果 (是关键字(记号, 位置, "中断") || 是关键字(记号, 位置, "继续")) {
        记录(输出, 深度, "跳转|" + 当前文本(记号, 位置))
        返回 位置 + 1
    }
    如果 (是关键字(记号, 位置, "遍历")) {
        记录(输出, 深度, "遍历")
        位置++
        位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
        如果 (是关键字(记号, 位置, "中")) {
            位置++
        }
        如果 (是关键字(记号, 位置, "每个")) {
            位置++
        }
        如果 (是标识符(记号, 位置)) {
            记录(输出, 深度 + 1, "循环变量|" + 当前文本(记号, 位置))
            位置++
        }
        返回 解析语句(记号, 位置, 深度 + 1, 输出)
    }
    如果 (是关键字(记号, 位置, "变量")) {
        位置++
        记录(输出, 深度, "变量|" + 当前文本(记号, 位置))
        位置++
        如果 (是运算符(记号, 位置, "=")) {
            位置++
            位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
        }
        返回 位置
    }
    如果 (是关键字(记号, 位置, "常量")) {
        位置++
        记录(输出, 深度, "常量|" + 当前文本(记号, 位置))
        位置++
        如果 (是运算符(记号, 位置, "=")) {
            位置++
            位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
        }
        返回 位置
    }
    如果 (是类型起始(记号, 位置)) {
        整64 名位置 = 位置 + 1
        当 (名位置 < 记号.大小() && !是标识符(记号, 名位置)) {
            名位置++
        }
        记录(输出, 深度, "变量|" + 当前文本(记号, 名位置))
        位置 = 解析类型(记号, 位置, 深度 + 1, 输出)
        如果 (是标识符(记号, 位置)) {
            位置++
        }
        如果 (是运算符(记号, 位置, "=")) {
            位置++
            如果 (是运算符(记号, 位置, "{")) {
                记录(输出, 深度, "初始化列表")
                位置++
                如果 (!是运算符(记号, 位置, "}")) {
                    当 (真) {
                        位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
                        如果 (是运算符(记号, 位置, ",")) {
                            位置++
                            继续
                        }
                        中断
                    }
                }
                如果 (是运算符(记号, 位置, "}")) {
                    位置++
                }
            } 否则 {
                位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
            }
        }
        返回 位置
    }
    位置 = 解析表达式(记号, 位置, 深度, 输出)
    返回 位置
}
函数 解析参数列表(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    如果 (是运算符(记号, 位置, "(")) {
        位置++
    }
    如果 (是运算符(记号, 位置, ")")) {
        返回 位置 + 1
    }
    当 (真) {
        整64 名位置 = 位置
        如果 (是类型起始(记号, 名位置) || 是标识符(记号, 名位置)) {
            名位置++
        }
        如果 (是运算符(记号, 名位置, "<")) {
            整64 层 = 0
            当 (名位置 < 记号.大小()) {
                如果 (是运算符(记号, 名位置, "<")) {
                    层++
                }
                如果 (是运算符(记号, 名位置, ">")) {
                    层--
                }
                名位置++
                如果 (层 == 0) {
                    中断
                }
            }
        }
        当 (真) {
            如果 (是运算符(记号, 名位置, "*") || 是运算符(记号, 名位置, "&")) {
                名位置++
                继续
            }
            如果 (是运算符(记号, 名位置, "[")) {
                当 (名位置 < 记号.大小() && !是运算符(记号, 名位置, "]")) {
                    名位置++
                }
                名位置++
                继续
            }
            中断
        }
        记录(输出, 深度, "参数|" + 当前文本(记号, 名位置))
        位置 = 解析类型(记号, 位置, 深度 + 1, 输出)
        如果 (是标识符(记号, 位置)) {
            位置++
        }
        如果 (是运算符(记号, 位置, "=")) {
            位置++
            位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
        }
        如果 (是运算符(记号, 位置, ",")) {
            位置++
            继续
        }
        中断
    }
    如果 (是运算符(记号, 位置, ")")) {
        位置++
    }
    返回 位置
}
函数 解析函数声明(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    位置++  // 函数
    字符串 名 = 当前文本(记号, 位置)
    位置++
    整64 参数数 = 参数个数(记号, 位置)
    记录(输出, 深度, "函数|" + 名 + "|参数数=" + 整数转字符串(参数数))
    位置 = 解析参数列表(记号, 位置, 深度 + 1, 输出)
    如果 (是运算符(记号, 位置, "->")) {
        位置++
        记录(输出, 深度 + 1, "返回类型")
        位置 = 解析类型(记号, 位置, 深度 + 2, 输出)
    }
    如果 (是运算符(记号, 位置, "{")) {
        位置 = 解析语句(记号, 位置, 深度 + 1, 输出)
    }
    返回 位置
}
函数 解析结构体声明(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出, 布尔 联合) -> 整64 {
    字符串 种类 = "结构体"
    如果 (联合) {
        种类 = "联合体"
    }
    位置++
    记录(输出, 深度, 种类 + "|" + 当前文本(记号, 位置))
    位置++
    如果 (是运算符(记号, 位置, "{")) {
        位置++
    }
    当 (位置 < 记号.大小() && !是运算符(记号, 位置, "}")) {
        记录(输出, 深度 + 1, "字段|" + 当前文本(记号, 位置 + 1))
        位置 = 解析类型(记号, 位置, 深度 + 2, 输出)
        如果 (是标识符(记号, 位置)) {
            位置++
        }
    }
    如果 (是运算符(记号, 位置, "}")) {
        位置++
    }
    返回 位置
}
函数 解析枚举声明(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    位置++
    记录(输出, 深度, "枚举|" + 当前文本(记号, 位置))
    位置++
    如果 (是运算符(记号, 位置, "{")) {
        位置++
    }
    当 (位置 < 记号.大小() && !是运算符(记号, 位置, "}")) {
        记录(输出, 深度 + 1, "枚举成员|" + 当前文本(记号, 位置))
        位置++
        如果 (是运算符(记号, 位置, "=")) {
            位置 += 2
        }
        如果 (是运算符(记号, 位置, ",")) {
            位置++
        }
    }
    如果 (是运算符(记号, 位置, "}")) {
        位置++
    }
    返回 位置
}
函数 解析类声明(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
