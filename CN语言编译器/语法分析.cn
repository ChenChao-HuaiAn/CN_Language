// 自举 Task 7.2：CN 语法分析器（用 CN 重写 C++ 版 parser，2026-08）
// 对标：src/cn_compiler/parser（parser.cpp/parser_expr.cpp/parser_stmt.cpp/parser_oop.cpp）
// 覆盖（规格书 01~08）：
//   程序：导入（模块/::符号）、公开/私有 可见性、泛型 <类型 T,...> 函数/类、
//     函数（重载/默认参数/-> 返回类型/外部）、结构体/联合体/枚举、类
//     （公开:/私有:/保护: 分区、字段/方法/构造/析构/虚拟/重写/静态/常量/运算符）、
//     顶层 常量/静态
//   语句：变量声明（含 自动/数组/初始化列表）、如果/否则如果链、当、循环(;;)、
//     选择/情况（整数/字符串/多值/裸枚举成员）/默认、返回、中断、继续、
//     遍历 容器 中 每个 变量、表达式语句、块
//   表达式：三目 ?:、赋值族（= += -= *= /= %= &= |= ^= <<= >>=）、|| && | ^ &、
//     == != < <= > >=、<< >>、+ -、* / %、一元（! - & * ++ --）、
//     后缀（调用/成员 ./->/下标/++ --）、主（字面量/标识符/括号/强制转换 类型(表达式)/
//     原始""/多行"""）
//   类型：名 | 名<T,...> | T* | T& | T[N]（组合后缀）
// 输出：AST dump（缩进行，节点名|细节），确定性便于逐行比对。
// 注：向量 类按值传参（指针语义共享）；字符串== 按地址比较（用 字符串比较/选择）。
导入 容器::向量
导入 词法分析::分词

公开:

// 解析源码 -> AST dump 行列表
函数 解析(字符串 源码) -> 向量<字符串> {
    向量<字符串> 输出 = 向量<字符串>()
    向量<字符串> 记号 = 分词(源码)
    记录(输出, 0, "程序")
    整64 位置 = 解析程序(记号, 0, 1, 输出)
    返回 输出
}

// ==================== Token 工具 ====================

// 记号 = "类型|文本|行"；取类型段
函数 记号类型(字符串 记号) -> 字符串 {
    整64 位 = 字符串查找(记号, "|")
    如果 (位 < 0) {
        返回 ""
    }
    返回 字符串子串(记号, 0, 位)
}

// 取文本段（类型|文本|行 的第二段）
函数 记号文本(字符串 记号) -> 字符串 {
    整64 位 = 字符串查找(记号, "|")
    如果 (位 < 0) {
        返回 ""
    }
    整64 位2 = 字符串查找(字符串子串(记号, 位 + 1, 字符串长度(记号) - 位 - 1), "|")
    如果 (位2 < 0) {
        返回 ""
    }
    返回 字符串子串(记号, 位 + 1, 位2)
}

// 当前记号类型（越界返回 文件结束）
函数 当前类型(向量<字符串> 记号, 整64 位置) -> 字符串 {
    如果 (位置 >= 记号.大小()) {
        返回 "文件结束"
    }
    返回 记号类型(记号.元素(位置))
}

// 当前记号文本（越界返回 ""）
函数 当前文本(向量<字符串> 记号, 整64 位置) -> 字符串 {
    如果 (位置 >= 记号.大小()) {
        返回 ""
    }
    返回 记号文本(记号.元素(位置))
}

// 当前是否为指定关键字（关键字 token 类型==文本）
函数 是关键字(向量<字符串> 记号, 整64 位置, 字符串 文本) -> 布尔 {
    返回 字符串比较(当前类型(记号, 位置), 文本)
}

// 当前是否为指定运算符/分隔符
函数 是运算符(向量<字符串> 记号, 整64 位置, 字符串 符号) -> 布尔 {
    返回 字符串比较(当前类型(记号, 位置), 符号)
}

// 当前是否为标识符
函数 是标识符(向量<字符串> 记号, 整64 位置) -> 布尔 {
    返回 字符串比较(当前类型(记号, 位置), "标识符")
}

// 输出一行 AST 节点（深度缩进 + 节点文本）
函数 记录(向量<字符串> 输出, 整64 深度, 字符串 节点) -> 空类型 {
    字符串 行 = ""
    整64 i = 0
    当 (i < 深度) {
        行 = 行 + "  "
        i++
    }
    行 = 行 + 节点
    结果<空类型, 整32> 加 = 输出.追加(行)
    如果 (!加.正常) {
        运行时错误(4)
    }
}

// ==================== 类型解析 ====================

// 类型：名 | 名<实参,...> | 后缀 * & [N] 任意组合
// 返回新位置
函数 解析类型(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    记录(输出, 深度, "类型|" + 当前文本(记号, 位置))
    位置++
    // 模板实参 <T,...>（贪婪匹配到 >，含嵌套 < >）
    如果 (是运算符(记号, 位置, "<")) {
        位置++
        整64 层 = 1
        当 (位置 < 记号.大小() && 层 > 0) {
            如果 (是运算符(记号, 位置, "<")) {
                层++
            }
            如果 (是运算符(记号, 位置, ">")) {
                层--
            }
            位置++
        }
    }
    // 组合后缀：* & [N]
    当 (真) {
        如果 (是运算符(记号, 位置, "*") || 是运算符(记号, 位置, "&")) {
            记录(输出, 深度, "类型后缀|" + 当前文本(记号, 位置))
            位置++
            继续
        }
        如果 (是运算符(记号, 位置, "[")) {
            记录(输出, 深度, "类型后缀|[" + 当前文本(记号, 位置 + 1) + "]")
            位置 += 2
            如果 (是运算符(记号, 位置, "]")) {
                位置++
            }
            继续
        }
        中断
    }
    返回 位置
}

// ==================== 表达式解析（优先级逐层） ====================

// 主表达式：字面量/标识符/括号/强制转换/原始与多行字符串前缀
函数 解析主(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    字符串 类型 = 当前类型(记号, 位置)
    如果 (字符串比较(类型, "整数字面量") || 字符串比较(类型, "浮点字面量") ||
         字符串比较(类型, "字符串字面量") || 字符串比较(类型, "字符字面量")) {
        记录(输出, 深度, "字面量|" + 当前文本(记号, 位置))
        返回 位置 + 1
    }
    如果 (是关键字(记号, 位置, "真") || 是关键字(记号, 位置, "假") ||
         是关键字(记号, 位置, "无")) {
        记录(输出, 深度, "字面量|" + 当前文本(记号, 位置))
        返回 位置 + 1
    }
    如果 (是关键字(记号, 位置, "原始") || 是关键字(记号, 位置, "多行")) {
        记录(输出, 深度, "字面量前缀|" + 当前文本(记号, 位置))
        位置++
        如果 (字符串比较(当前类型(记号, 位置), "字符串字面量")) {
            记录(输出, 深度, "字面量|" + 当前文本(记号, 位置))
            位置++
        }
        返回 位置
    }
    如果 (是运算符(记号, 位置, "(")) {
        位置++
        位置 = 解析表达式(记号, 位置, 深度, 输出)
        如果 (是运算符(记号, 位置, ")")) {
            位置++
        }
        返回 位置
    }
    // 强制转换：类型关键字(表达式)（整64(值)、浮64(数)）——2026-08 补齐
    如果 (是类型关键字(记号, 位置) && 是运算符(记号, 位置 + 1, "(")) {
        记录(输出, 深度, "强制转换|" + 当前文本(记号, 位置))
        位置 += 2
        位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
        如果 (是运算符(记号, 位置, ")")) {
            位置++
        }
        返回 位置
    }
    如果 (是标识符(记号, 位置)) {
        记录(输出, 深度, "标识符|" + 当前文本(记号, 位置))
        返回 位置 + 1
    }
    // 其他（未知 token）：跳过（容错）
    返回 位置 + 1
}

// 后缀表达式：调用 ( ) / 成员 . -> / 下标 [ ] / ++ --
函数 解析后缀(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    位置 = 解析主(记号, 位置, 深度, 输出)
    当 (真) {
        如果 (是运算符(记号, 位置, "(")) {
            记录(输出, 深度, "调用|参数数=" + 整数转字符串(参数个数(记号, 位置)))
            位置++
            如果 (!是运算符(记号, 位置, ")")) {
                当 (真) {
                    位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
                    如果 (是运算符(记号, 位置, ",")) {
                        位置++
                        继续
                    }
                    中断
                }
            }
            如果 (是运算符(记号, 位置, ")")) {
                位置++
            }
            继续
        }
        如果 (是运算符(记号, 位置, ".") || 是运算符(记号, 位置, "->")) {
            记录(输出, 深度, "成员|" + 当前文本(记号, 位置) + "|" + 当前文本(记号, 位置 + 1))
            位置 += 2
            继续
        }
        如果 (是运算符(记号, 位置, "[")) {
            记录(输出, 深度, "下标")
            位置++
            位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
            如果 (是运算符(记号, 位置, "]")) {
                位置++
            }
            继续
        }
        如果 (是运算符(记号, 位置, "++") || 是运算符(记号, 位置, "--")) {
            记录(输出, 深度, "后缀|" + 当前文本(记号, 位置))
            位置++
            继续
        }
        中断
    }
    返回 位置
}

// 计算调用实参个数（括号内顶层逗号数+1；空参数返回 0）
// 2026-08 修复：位置指向调用名（非 "("）时 i 从 "(" 起计内层，
//   配对闭括号（内层减到 0）即返回——原实现配对后继续扫描，
//   会误数后续语句中的顶层逗号（构造 容器() 参数数=1 实测）。
//   非空参数在配对完成时返回 逗号数+1（追加(T 值) 参数数=1 实测修复）。
函数 参数个数(向量<字符串> 记号, 整64 位置) -> 整64 {
    // 空参数 ()：位置 指向 "("（位置+1 是 ")"）或 调用名（位置+1 是 "(" 且 位置+2 是 ")"）
    如果 (是运算符(记号, 位置 + 1, ")")) {
        返回 0
    }
    如果 (是运算符(记号, 位置 + 1, "(") && 是运算符(记号, 位置 + 2, ")")) {
        返回 0
    }
    整64 数量 = 0
    整64 内层 = 0
    整64 i = 位置
    当 (i < 记号.大小()) {
        如果 (是运算符(记号, i, "(") || 是运算符(记号, i, "[") ||
             是运算符(记号, i, "{")) {
            内层++
        }
        如果 (是运算符(记号, i, ")") || 是运算符(记号, i, "]") ||
             是运算符(记号, i, "}")) {
            如果 (内层 == 0) {
                返回 数量
            }
            内层--
            如果 (内层 == 0) {
                // 配对完成：空括号（"(" 后紧跟 ")"）返回 0，否则 逗号数+1
                如果 (数量 == 0) {
                    返回 1
                }
                返回 数量 + 1
            }
        }
        // 顶层逗号（内层==1：位置 指向名/括号 时 "(" 均计入内层）
        如果 (是运算符(记号, i, ",") && 内层 == 1) {
            数量++
        }
        i++
    }
    返回 数量
}

// 一元：! - & * ++ --（前缀）
函数 解析一元(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    如果 (是运算符(记号, 位置, "!") || 是运算符(记号, 位置, "-") ||
         是运算符(记号, 位置, "&") || 是运算符(记号, 位置, "*") ||
         是运算符(记号, 位置, "++") || 是运算符(记号, 位置, "--")) {
        记录(输出, 深度, "一元|" + 当前文本(记号, 位置))
        返回 解析一元(记号, 位置 + 1, 深度 + 1, 输出)
    }
    返回 解析后缀(记号, 位置, 深度, 输出)
}

// 乘除取模：* / %
函数 解析乘除(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    位置 = 解析一元(记号, 位置, 深度, 输出)
    当 (真) {
        如果 (是运算符(记号, 位置, "*") || 是运算符(记号, 位置, "/") ||
             是运算符(记号, 位置, "%")) {
            记录(输出, 深度, "二元|" + 当前文本(记号, 位置))
            位置++
            位置 = 解析一元(记号, 位置, 深度 + 1, 输出)
            继续
        }
        中断
    }
    返回 位置
}

// 加减：+ -
函数 解析加减(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    位置 = 解析乘除(记号, 位置, 深度, 输出)
    当 (真) {
        如果 (是运算符(记号, 位置, "+") || 是运算符(记号, 位置, "-")) {
            记录(输出, 深度, "二元|" + 当前文本(记号, 位置))
            位置++
            位置 = 解析乘除(记号, 位置, 深度 + 1, 输出)
            继续
        }
        中断
    }
    返回 位置
}

// 移位：<< >>
函数 解析移位(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    位置 = 解析加减(记号, 位置, 深度, 输出)
    当 (真) {
        如果 (是运算符(记号, 位置, "<<") || 是运算符(记号, 位置, ">>")) {
            记录(输出, 深度, "二元|" + 当前文本(记号, 位置))
            位置++
            位置 = 解析加减(记号, 位置, 深度 + 1, 输出)
            继续
        }
        中断
    }
    返回 位置
}

// 比较：< <= > >=
函数 解析比较(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    位置 = 解析移位(记号, 位置, 深度, 输出)
    当 (真) {
        如果 (是运算符(记号, 位置, "<") || 是运算符(记号, 位置, "<=") ||
             是运算符(记号, 位置, ">") || 是运算符(记号, 位置, ">=")) {
            记录(输出, 深度, "二元|" + 当前文本(记号, 位置))
            位置++
            位置 = 解析移位(记号, 位置, 深度 + 1, 输出)
            继续
        }
        中断
    }
    返回 位置
}

// 相等：== !=
函数 解析相等(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    位置 = 解析比较(记号, 位置, 深度, 输出)
    当 (真) {
        如果 (是运算符(记号, 位置, "==") || 是运算符(记号, 位置, "!=")) {
            记录(输出, 深度, "二元|" + 当前文本(记号, 位置))
            位置++
            位置 = 解析比较(记号, 位置, 深度 + 1, 输出)
            继续
        }
        中断
    }
    返回 位置
}

// 位与：&
函数 解析位与(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    位置 = 解析相等(记号, 位置, 深度, 输出)
    当 (真) {
        如果 (是运算符(记号, 位置, "&")) {
            记录(输出, 深度, "二元|&")
            位置++
            位置 = 解析相等(记号, 位置, 深度 + 1, 输出)
            继续
        }
        中断
    }
    返回 位置
}

// 位异或：^
函数 解析位异或(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    位置 = 解析位与(记号, 位置, 深度, 输出)
    当 (真) {
        如果 (是运算符(记号, 位置, "^")) {
            记录(输出, 深度, "二元|^")
            位置++
            位置 = 解析位与(记号, 位置, 深度 + 1, 输出)
            继续
        }
        中断
    }
    返回 位置
}

// 位或：|
函数 解析位或(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    位置 = 解析位异或(记号, 位置, 深度, 输出)
    当 (真) {
        如果 (是运算符(记号, 位置, "|")) {
            记录(输出, 深度, "二元||")
            位置++
            位置 = 解析位异或(记号, 位置, 深度 + 1, 输出)
            继续
        }
        中断
    }
    返回 位置
}

// 逻辑与：&&
函数 解析逻辑与(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    位置 = 解析位或(记号, 位置, 深度, 输出)
    当 (真) {
        如果 (是运算符(记号, 位置, "&&")) {
            记录(输出, 深度, "二元|&&")
            位置++
            位置 = 解析位或(记号, 位置, 深度 + 1, 输出)
            继续
        }
        中断
    }
    返回 位置
}

// 逻辑或：||
函数 解析逻辑或(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    位置 = 解析逻辑与(记号, 位置, 深度, 输出)
    当 (真) {
        如果 (是运算符(记号, 位置, "||")) {
            记录(输出, 深度, "二元|||")
            位置++
            位置 = 解析逻辑与(记号, 位置, 深度 + 1, 输出)
            继续
        }
        中断
    }
    返回 位置
}

// 赋值：= += -= *= /= %= &= |= ^= <<= >>=（右结合）
函数 解析赋值(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    位置 = 解析逻辑或(记号, 位置, 深度, 输出)
    如果 (是运算符(记号, 位置, "=") || 是运算符(记号, 位置, "+=") ||
         是运算符(记号, 位置, "-=") || 是运算符(记号, 位置, "*=") ||
         是运算符(记号, 位置, "/=") || 是运算符(记号, 位置, "%=") ||
         是运算符(记号, 位置, "&=") || 是运算符(记号, 位置, "|=") ||
         是运算符(记号, 位置, "^=") || 是运算符(记号, 位置, "<<=") ||
         是运算符(记号, 位置, ">>=")) {
        记录(输出, 深度, "赋值|" + 当前文本(记号, 位置))
        位置++
        位置 = 解析赋值(记号, 位置, 深度 + 1, 输出)
    }
    返回 位置
}

// 三元：条件 ? 真值 : 假值
函数 解析三元(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    位置 = 解析赋值(记号, 位置, 深度, 输出)
    如果 (是运算符(记号, 位置, "?")) {
        记录(输出, 深度, "三元")
        位置++
        位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
        如果 (是运算符(记号, 位置, ":")) {
            位置++
        }
        位置 = 解析三元(记号, 位置, 深度 + 1, 输出)
    }
    返回 位置
}

// 表达式入口
函数 解析表达式(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    返回 解析三元(记号, 位置, 深度, 输出)
}

// ==================== 语句解析 ====================

// 类型名集合（用于区分 变量声明 与 表达式；类型关键字 + 已声明类型名）
函数 是类型起始(向量<字符串> 记号, 整64 位置) -> 布尔 {
    字符串 文本 = 当前文本(记号, 位置)
    如果 (字符串比较(文本, "整8") || 字符串比较(文本, "整16") ||
         字符串比较(文本, "整32") || 字符串比较(文本, "整64") ||
         字符串比较(文本, "整128") || 字符串比较(文本, "正8") ||
         字符串比较(文本, "正16") || 字符串比较(文本, "正32") ||
         字符串比较(文本, "正64") || 字符串比较(文本, "正128") ||
         字符串比较(文本, "浮32") || 字符串比较(文本, "浮64") ||
         字符串比较(文本, "布尔") || 字符串比较(文本, "字符") ||
         字符串比较(文本, "字符串") || 字符串比较(文本, "空类型") ||
         字符串比较(文本, "整数") || 字符串比较(文本, "小数")) {
        返回 真
    }
    // 自定义类型名：标识符 后跟 标识符/[/&/*（类型 名称 形态）
    如果 (是标识符(记号, 位置) && 位置 + 1 < 记号.大小()) {
        字符串 次 = 当前类型(记号, 位置 + 1)
        如果 (字符串比较(次, "标识符") || 字符串比较(次, "[") ||
             字符串比较(次, "&") || 字符串比较(次, "*")) {
            返回 真
        }
    }
    返回 假
}

// 当前是否为类型关键字（整8..字符串 等 21 个；强制转换 类型(表达式) 判定用）
函数 是类型关键字(向量<字符串> 记号, 整64 位置) -> 布尔 {
    字符串 文本 = 当前文本(记号, 位置)
    返回 字符串比较(文本, "整8") || 字符串比较(文本, "整16") ||
           字符串比较(文本, "整32") || 字符串比较(文本, "整64") ||
           字符串比较(文本, "整128") || 字符串比较(文本, "正8") ||
           字符串比较(文本, "正16") || 字符串比较(文本, "正32") ||
           字符串比较(文本, "正64") || 字符串比较(文本, "正128") ||
           字符串比较(文本, "浮32") || 字符串比较(文本, "浮64") ||
           字符串比较(文本, "布尔") || 字符串比较(文本, "字符") ||
           字符串比较(文本, "字符串") || 字符串比较(文本, "空类型") ||
           字符串比较(文本, "整数") || 字符串比较(文本, "小数")
}

// 语句分发
函数 解析语句(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    如果 (是运算符(记号, 位置, "{")) {
        记录(输出, 深度, "块")
        位置++
        当 (位置 < 记号.大小() && !是运算符(记号, 位置, "}")) {
            位置 = 解析语句(记号, 位置, 深度 + 1, 输出)
        }
        如果 (是运算符(记号, 位置, "}")) {
            位置++
        }
        返回 位置
    }
    如果 (是关键字(记号, 位置, "如果")) {
        记录(输出, 深度, "如果")
        位置++
        如果 (是运算符(记号, 位置, "(")) {
            位置++
            位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
            如果 (是运算符(记号, 位置, ")")) {
                位置++
            }
        }
        位置 = 解析语句(记号, 位置, 深度 + 1, 输出)
        如果 (是关键字(记号, 位置, "否则")) {
            记录(输出, 深度, "否则")
            位置++
            位置 = 解析语句(记号, 位置, 深度 + 1, 输出)
        }
        返回 位置
    }
    如果 (是关键字(记号, 位置, "当")) {
        记录(输出, 深度, "当")
        位置++
        如果 (是运算符(记号, 位置, "(")) {
            位置++
            位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
            如果 (是运算符(记号, 位置, ")")) {
                位置++
            }
        }
        返回 解析语句(记号, 位置, 深度 + 1, 输出)
    }
    如果 (是关键字(记号, 位置, "循环")) {
        记录(输出, 深度, "循环")
        位置++
        如果 (是运算符(记号, 位置, "(")) {
            位置++  // 循环(初始化; 条件; 更新)
            如果 (!是运算符(记号, 位置, ";")) {
                位置 = 解析语句(记号, 位置, 深度 + 1, 输出)
            }
            如果 (是运算符(记号, 位置, ";")) {
                位置++
            }
            如果 (!是运算符(记号, 位置, ";")) {
                位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
            }
            如果 (是运算符(记号, 位置, ";")) {
                位置++
            }
            如果 (!是运算符(记号, 位置, ")")) {
                位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
            }
            如果 (是运算符(记号, 位置, ")")) {
                位置++
            }
        }
        返回 解析语句(记号, 位置, 深度 + 1, 输出)
    }
    如果 (是关键字(记号, 位置, "选择")) {
        记录(输出, 深度, "选择")
        位置++
        如果 (是运算符(记号, 位置, "(")) {
            位置++
            位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
            如果 (是运算符(记号, 位置, ")")) {
                位置++
            }
        }
        如果 (是运算符(记号, 位置, "{")) {
            位置++
        }
        当 (位置 < 记号.大小() && !是运算符(记号, 位置, "}")) {
            如果 (是关键字(记号, 位置, "情况")) {
                位置++
                记录(输出, 深度, "情况|" + 当前文本(记号, 位置))
                位置++
                当 (是运算符(记号, 位置, ",")) {
                    位置++
                    记录(输出, 深度, "情况|" + 当前文本(记号, 位置))
                    位置++
                }
                如果 (是运算符(记号, 位置, ":")) {
                    位置++
                }
                当 (位置 < 记号.大小() && !是关键字(记号, 位置, "情况") &&
                     !是关键字(记号, 位置, "默认") && !是运算符(记号, 位置, "}")) {
                    位置 = 解析语句(记号, 位置, 深度 + 1, 输出)
                }
                继续
            }
            如果 (是关键字(记号, 位置, "默认")) {
                记录(输出, 深度, "默认")
                位置++
                如果 (是运算符(记号, 位置, ":")) {
                    位置++
                }
                当 (位置 < 记号.大小() && !是运算符(记号, 位置, "}")) {
                    位置 = 解析语句(记号, 位置, 深度 + 1, 输出)
                }
                继续
            }
            位置++  // 防御：跳过未知
        }
        如果 (是运算符(记号, 位置, "}")) {
            位置++
        }
        返回 位置
    }
    如果 (是关键字(记号, 位置, "返回")) {
        记录(输出, 深度, "返回")
        位置++
        如果 (!是运算符(记号, 位置, "}") && !是运算符(记号, 位置, ";")) {
            位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
        }
        返回 位置
    }
    如果 (是关键字(记号, 位置, "中断") || 是关键字(记号, 位置, "继续")) {
        记录(输出, 深度, "跳转|" + 当前文本(记号, 位置))
        返回 位置 + 1
    }
    如果 (是关键字(记号, 位置, "遍历")) {
        记录(输出, 深度, "遍历")
        位置++
        位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
        如果 (是关键字(记号, 位置, "中")) {
            位置++
        }
        如果 (是关键字(记号, 位置, "每个")) {
            位置++
        }
        如果 (是标识符(记号, 位置)) {
            记录(输出, 深度 + 1, "循环变量|" + 当前文本(记号, 位置))
            位置++
        }
        返回 解析语句(记号, 位置, 深度 + 1, 输出)
    }
    如果 (是关键字(记号, 位置, "变量")) {
        位置++
        记录(输出, 深度, "变量|" + 当前文本(记号, 位置))
        位置++
        如果 (是运算符(记号, 位置, "=")) {
            位置++
            位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
        }
        返回 位置
    }
    如果 (是关键字(记号, 位置, "常量")) {
        位置++
        记录(输出, 深度, "常量|" + 当前文本(记号, 位置))
        位置++
        如果 (是运算符(记号, 位置, "=")) {
            位置++
            位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
        }
        返回 位置
    }
    // 类型开头 -> 变量声明（含 初始化列表 { ... }）
    如果 (是类型起始(记号, 位置)) {
        // 2026-08 修复：变量名 = 类型（含后缀 * & [N]）之后的第一个标识符
        //   （原实现取 位置+1，整64* 指针 误记录 "变量|*" 实测）
        整64 名位置 = 位置 + 1
        当 (名位置 < 记号.大小() && !是标识符(记号, 名位置)) {
            名位置++
        }
        记录(输出, 深度, "变量|" + 当前文本(记号, 名位置))
        位置 = 解析类型(记号, 位置, 深度 + 1, 输出)
        如果 (是标识符(记号, 位置)) {
            位置++
        }
        如果 (是运算符(记号, 位置, "=")) {
            位置++
            如果 (是运算符(记号, 位置, "{")) {
                记录(输出, 深度, "初始化列表")
                位置++
                如果 (!是运算符(记号, 位置, "}")) {
                    当 (真) {
                        位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
                        如果 (是运算符(记号, 位置, ",")) {
                            位置++
                            继续
                        }
                        中断
                    }
                }
                如果 (是运算符(记号, 位置, "}")) {
                    位置++
                }
            } 否则 {
                位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
            }
        }
        返回 位置
    }
    // 表达式语句
    位置 = 解析表达式(记号, 位置, 深度, 输出)
    返回 位置
}

// ==================== 声明解析（顶层） ====================

// 参数列表：(类型 名, ...) 含默认值
函数 解析参数列表(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    如果 (是运算符(记号, 位置, "(")) {
        位置++
    }
    如果 (是运算符(记号, 位置, ")")) {
        返回 位置 + 1
    }
    当 (真) {
        记录(输出, 深度, "参数|" + 当前文本(记号, 位置 + 1))
        位置 = 解析类型(记号, 位置, 深度 + 1, 输出)
        如果 (是标识符(记号, 位置)) {
            位置++
        }
        如果 (是运算符(记号, 位置, "=")) {
            位置++
            位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
        }
        如果 (是运算符(记号, 位置, ",")) {
            位置++
            继续
        }
        中断
    }
    如果 (是运算符(记号, 位置, ")")) {
        位置++
    }
    返回 位置
}

// 函数声明：函数 名(参数) -> 返回类型 { 体 }
// 返回 新位置（参数个数由调用方经 参数个数 统计）
函数 解析函数声明(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    位置++  // 函数
    字符串 名 = 当前文本(记号, 位置)
    位置++
    // 参数数
    整64 参数数 = 参数个数(记号, 位置)
    记录(输出, 深度, "函数|" + 名 + "|参数数=" + 整数转字符串(参数数))
    位置 = 解析参数列表(记号, 位置, 深度 + 1, 输出)
    如果 (是运算符(记号, 位置, "->")) {
        位置++
        记录(输出, 深度 + 1, "返回类型")
        位置 = 解析类型(记号, 位置, 深度 + 2, 输出)
    }
    如果 (是运算符(记号, 位置, "{")) {
        位置 = 解析语句(记号, 位置, 深度 + 1, 输出)
    }
    返回 位置
}

// 结构体/联合体声明
函数 解析结构体声明(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出, 布尔 联合) -> 整64 {
    字符串 种类 = "结构体"
    如果 (联合) {
        种类 = "联合体"
    }
    位置++
    记录(输出, 深度, 种类 + "|" + 当前文本(记号, 位置))
    位置++
    如果 (是运算符(记号, 位置, "{")) {
        位置++
    }
    当 (位置 < 记号.大小() && !是运算符(记号, 位置, "}")) {
        记录(输出, 深度 + 1, "字段|" + 当前文本(记号, 位置 + 1))
        位置 = 解析类型(记号, 位置, 深度 + 2, 输出)
        如果 (是标识符(记号, 位置)) {
            位置++
        }
    }
    如果 (是运算符(记号, 位置, "}")) {
        位置++
    }
    返回 位置
}

// 枚举声明：枚举 名 { 成员, 成员 }
函数 解析枚举声明(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    位置++
    记录(输出, 深度, "枚举|" + 当前文本(记号, 位置))
    位置++
    如果 (是运算符(记号, 位置, "{")) {
        位置++
    }
    当 (位置 < 记号.大小() && !是运算符(记号, 位置, "}")) {
        记录(输出, 深度 + 1, "枚举成员|" + 当前文本(记号, 位置))
        位置++
        如果 (是运算符(记号, 位置, "=")) {
            位置 += 2
        }
        如果 (是运算符(记号, 位置, ",")) {
            位置++
        }
    }
    如果 (是运算符(记号, 位置, "}")) {
        位置++
    }
    返回 位置
}

// 类声明：类 名 { 分区: 成员 }
// 分区：公开:/私有:/保护:；成员：字段/方法/构造/析构/虚拟/重写/静态/常量/运算符
函数 解析类声明(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    位置++  // 类
    记录(输出, 深度, "类|" + 当前文本(记号, 位置))
    位置++
    如果 (是运算符(记号, 位置, "{")) {
        位置++
    }
    字符串 分区 = "公开"
    当 (位置 < 记号.大小() && !是运算符(记号, 位置, "}")) {
        如果 (是关键字(记号, 位置, "公开") || 是关键字(记号, 位置, "私有") ||
             是关键字(记号, 位置, "保护")) {
            分区 = 当前文本(记号, 位置)
            记录(输出, 深度 + 1, "分区|" + 分区)
            位置++
            如果 (是运算符(记号, 位置, ":")) {
                位置++
            }
            继续
        }
        // 字段：类型 名（无 ( 后随）
        如果 (是类型起始(记号, 位置)) {
            记录(输出, 深度 + 1, "字段|" + 当前文本(记号, 位置 + 1))
            位置 = 解析类型(记号, 位置, 深度 + 2, 输出)
            如果 (是标识符(记号, 位置)) {
                位置++
            }
            继续
        }
        // 方法/构造/析构：函数 | 常量 函数 | 虚拟 函数 | 重写 函数 | 静态 函数 |
        //   类名( | ~类名( | 运算符
        如果 (是关键字(记号, 位置, "函数")) {
            位置 = 解析方法(记号, 位置, 深度 + 1, 输出)
            继续
        }
        如果 (是关键字(记号, 位置, "常量") || 是关键字(记号, 位置, "虚拟") ||
             是关键字(记号, 位置, "重写") || 是关键字(记号, 位置, "静态")) {
            记录(输出, 深度 + 1, "修饰|" + 当前文本(记号, 位置))
            位置++
            如果 (是关键字(记号, 位置, "函数")) {
                位置 = 解析方法(记号, 位置, 深度 + 1, 输出)
            }
            继续
        }
        如果 (是运算符(记号, 位置, "~")) {
            位置++
            记录(输出, 深度 + 1, "析构|" + 当前文本(记号, 位置))
            位置++
            位置 = 解析参数列表(记号, 位置, 深度 + 2, 输出)
            如果 (是运算符(记号, 位置, "{")) {
                位置 = 解析语句(记号, 位置, 深度 + 2, 输出)
            }
            继续
        }
        // 构造函数：类名( 或 运算符X
        如果 (是标识符(记号, 位置)) {
            记录(输出, 深度 + 1, "构造|" + 当前文本(记号, 位置))
            位置++
            位置 = 解析参数列表(记号, 位置, 深度 + 2, 输出)
            如果 (是运算符(记号, 位置, "{")) {
                位置 = 解析语句(记号, 位置, 深度 + 2, 输出)
            }
            继续
        }
        如果 (是关键字(记号, 位置, "运算符")) {
            记录(输出, 深度 + 1, "运算符|" + 当前文本(记号, 位置 + 1))
            位置 += 2
            位置 = 解析参数列表(记号, 位置, 深度 + 2, 输出)
            如果 (是运算符(记号, 位置, "{")) {
                位置 = 解析语句(记号, 位置, 深度 + 2, 输出)
            }
            继续
        }
        位置++  // 防御
    }
    如果 (是运算符(记号, 位置, "}")) {
        位置++
    }
    返回 位置
}

// 方法：函数 名(参数) -> 类型 { 体 }
函数 解析方法(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    位置++  // 函数
    记录(输出, 深度, "方法|" + 当前文本(记号, 位置) + "|参数数=" +
         整数转字符串(参数个数(记号, 位置)))
    位置++
    位置 = 解析参数列表(记号, 位置, 深度 + 1, 输出)
    如果 (是运算符(记号, 位置, "->")) {
        位置++
        记录(输出, 深度 + 1, "返回类型")
        位置 = 解析类型(记号, 位置, 深度 + 2, 输出)
    }
    如果 (是运算符(记号, 位置, "{")) {
        位置 = 解析语句(记号, 位置, 深度 + 1, 输出)
    }
    返回 位置
}

// 程序：导入/公开/泛型/函数/结构体/联合体/枚举/类/常量/静态/外部
函数 解析程序(向量<字符串> 记号, 整64 位置, 整64 深度, 向量<字符串> 输出) -> 整64 {
    当 (位置 < 记号.大小() && !字符串比较(当前类型(记号, 位置), "文件结束")) {
        如果 (是关键字(记号, 位置, "导入")) {
            位置++
            记录(输出, 深度, "导入|" + 当前文本(记号, 位置))
            位置++
            如果 (是运算符(记号, 位置, "::")) {
                记录(输出, 深度, "导入符号|" + 当前文本(记号, 位置 + 1))
                位置 += 2
            }
            如果 (是关键字(记号, 位置, "作为")) {
                位置 += 2
            }
            继续
        }
        如果 (是关键字(记号, 位置, "公开") || 是关键字(记号, 位置, "私有")) {
            位置++  // 可见性（下一声明吸收）
            继续
        }
        如果 (是关键字(记号, 位置, "外部")) {
            记录(输出, 深度, "外部函数")
            位置++
            如果 (是关键字(记号, 位置, "函数")) {
                位置 = 解析函数声明(记号, 位置, 深度, 输出)
            }
            继续
        }
        如果 (是关键字(记号, 位置, "泛型")) {
            位置++
            整64 参数数 = 0
            如果 (是运算符(记号, 位置, "<")) {
                位置++
                当 (位置 < 记号.大小() && !是运算符(记号, 位置, ">")) {
                    // 2026-08 修复：泛型形参 "类型 T" 中 "类型" 是固定标记
                    //   （非保留字，与 C++ 版 parseGenericDecl 一致），仅计数形参名
                    如果 (是标识符(记号, 位置) &&
                        !字符串比较(当前文本(记号, 位置), "类型")) {
                        参数数++
                    }
                    位置++
                }
                如果 (是运算符(记号, 位置, ">")) {
                    位置++
                }
            }
            // 泛型 函数 / 泛型 类
            如果 (是关键字(记号, 位置, "函数")) {
                位置++
                字符串 名 = 当前文本(记号, 位置)
                记录(输出, 深度, "泛型函数|" + 名 + "|参数数=" + 整数转字符串(参数数))
                位置++
                位置 = 解析参数列表(记号, 位置, 深度 + 1, 输出)
                如果 (是运算符(记号, 位置, "->")) {
                    位置++
                    记录(输出, 深度 + 1, "返回类型")
                    位置 = 解析类型(记号, 位置, 深度 + 2, 输出)
                }
                如果 (是运算符(记号, 位置, "{")) {
                    位置 = 解析语句(记号, 位置, 深度 + 1, 输出)
                }
                继续
            }
            如果 (是关键字(记号, 位置, "类")) {
                位置++
                记录(输出, 深度, "泛型类|" + 当前文本(记号, 位置) + "|参数数=" +
                     整数转字符串(参数数))
                位置++
                如果 (是运算符(记号, 位置, "{")) {
                    位置++
                }
                // 复用类成员解析：临时把 泛型类 当 类 体解析
                字符串 分区2 = "公开"
                当 (位置 < 记号.大小() && !是运算符(记号, 位置, "}")) {
                    如果 (是关键字(记号, 位置, "公开") || 是关键字(记号, 位置, "私有") ||
                         是关键字(记号, 位置, "保护")) {
                        记录(输出, 深度 + 1, "分区|" + 当前文本(记号, 位置))
                        位置++
                        如果 (是运算符(记号, 位置, ":")) {
                            位置++
                        }
                        继续
                    }
                    如果 (是类型起始(记号, 位置)) {
                        记录(输出, 深度 + 1, "字段|" + 当前文本(记号, 位置 + 1))
                        位置 = 解析类型(记号, 位置, 深度 + 2, 输出)
                        如果 (是标识符(记号, 位置)) {
                            位置++
                        }
                        继续
                    }
                    如果 (是关键字(记号, 位置, "函数")) {
                        位置 = 解析方法(记号, 位置, 深度 + 1, 输出)
                        继续
                    }
                    如果 (是关键字(记号, 位置, "常量") || 是关键字(记号, 位置, "虚拟") ||
                         是关键字(记号, 位置, "重写") || 是关键字(记号, 位置, "静态")) {
                        记录(输出, 深度 + 1, "修饰|" + 当前文本(记号, 位置))
                        位置++
                        如果 (是关键字(记号, 位置, "函数")) {
                            位置 = 解析方法(记号, 位置, 深度 + 1, 输出)
                        }
                        继续
                    }
                    如果 (是标识符(记号, 位置)) {
                        记录(输出, 深度 + 1, "构造|" + 当前文本(记号, 位置))
                        位置++
                        位置 = 解析参数列表(记号, 位置, 深度 + 2, 输出)
                        如果 (是运算符(记号, 位置, "{")) {
                            位置 = 解析语句(记号, 位置, 深度 + 2, 输出)
                        }
                        继续
                    }
                    如果 (是运算符(记号, 位置, "~")) {
                        位置++
                        记录(输出, 深度 + 1, "析构|" + 当前文本(记号, 位置))
                        位置++
                        位置 = 解析参数列表(记号, 位置, 深度 + 2, 输出)
                        如果 (是运算符(记号, 位置, "{")) {
                            位置 = 解析语句(记号, 位置, 深度 + 2, 输出)
                        }
                        继续
                    }
                    如果 (是关键字(记号, 位置, "运算符")) {
                        记录(输出, 深度 + 1, "运算符|" + 当前文本(记号, 位置 + 1))
                        位置 += 2
                        位置 = 解析参数列表(记号, 位置, 深度 + 2, 输出)
                        如果 (是运算符(记号, 位置, "{")) {
                            位置 = 解析语句(记号, 位置, 深度 + 2, 输出)
                        }
                        继续
                    }
                    位置++
                }
                如果 (是运算符(记号, 位置, "}")) {
                    位置++
                }
                继续
            }
            继续
        }
        如果 (是关键字(记号, 位置, "函数")) {
            位置 = 解析函数声明(记号, 位置, 深度, 输出)
            继续
        }
        如果 (是关键字(记号, 位置, "结构体")) {
            位置 = 解析结构体声明(记号, 位置, 深度, 输出, 假)
            继续
        }
        如果 (是关键字(记号, 位置, "联合体")) {
            位置 = 解析结构体声明(记号, 位置, 深度, 输出, 真)
            继续
        }
        如果 (是关键字(记号, 位置, "枚举")) {
            位置 = 解析枚举声明(记号, 位置, 深度, 输出)
            继续
        }
        如果 (是关键字(记号, 位置, "类")) {
            位置 = 解析类声明(记号, 位置, 深度, 输出)
            继续
        }
        如果 (是关键字(记号, 位置, "常量") || 是关键字(记号, 位置, "静态")) {
            记录(输出, 深度, "顶层" + 当前文本(记号, 位置) + "|" + 当前文本(记号, 位置 + 1))
            位置 += 2
            如果 (是运算符(记号, 位置, "=")) {
                位置++
                位置 = 解析表达式(记号, 位置, 深度 + 1, 输出)
            }
            继续
        }
        位置++  // 防御：跳过未知声明
    }
    返回 位置
}