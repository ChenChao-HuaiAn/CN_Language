    如果 (是运算符(记号, 位置, "{")) {
        位置++
    }
    字符串 分区 = "公开"
    当 (位置 < 记号.大小() && !是运算符(记号, 位置, "}")) {
        如果 (是关键字(记号, 位置, "公开") || 是关键字(记号, 位置, "私有") ||
             是关键字(记号, 位置, "保护")) {
            分区 = 当前文本(记号, 位置)
            记录(输出, 深度 + 1, "分区|" + 分区)
            位置++
