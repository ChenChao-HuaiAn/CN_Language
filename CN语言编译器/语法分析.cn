// 自举 Task 7.2：CN 语法分析器（用 CN 重写 C++ 版 parser，2026-08）
// B 任务拆分（2026-08）：门面文件——保留 解析 入口 + token 工具，
//   子模块拆分至 语法/表达式.cn（解析类型/主/后缀/一元/二元层/赋值/三元/表达式）、
//   语法/语句.cn（解析语句）、语法/声明.cn（参数列表/函数/结构体/枚举/类/方法）、
//   语法/顶层.cn（解析程序）。
// 对标：src/cn_compiler/parser（parser.cpp/parser_expr.cpp/parser_stmt.cpp/parser_oop.cpp）
// 覆盖（规格书 01~08）：
//   程序：导入（模块/::符号）、公开/私有 可见性、泛型 <类型 T,...> 函数/类、
//     函数（重载/默认参数/-> 返回类型/外部）、结构体/联合体/枚举、类
//     （公开:/私有:/保护: 分区、字段/方法/构造/析构/虚拟/重写/静态/常量/运算符）、
//     顶层 常量/静态
//   语句：变量声明（含 自动/数组/初始化列表）、如果/否则如果链、当、循环(;;)、
导入 容器::向量;
导入 词法分析::分词;
导入 语法::表达式;
导入 语法::语句;
导入 语法::声明;
导入 语法::顶层;

公开:
函数 解析(字符串 源码) -> 向量<字符串> {
    向量<字符串> 输出 = 向量<字符串>();
    向量<字符串> 记号 = 分词(源码);
    记录(输出, 0, "程序");
    整64 位置 = 解析程序(记号, 0, 1, 输出);
    返回 输出;
}
函数 记号行位(字符串 记号) -> 整64 {
    整64 i = 字符串长度(记号) - 1;
    当 (i >= 0) {
        如果 (字节值(记号, i) == 124) {
            整64 k = i + 1;
            布尔 全数字 = 真;
            当 (k < 字符串长度(记号)) {
                整64 字节 = 字节值(记号, k);
                如果 (字节 < 48 || 字节 > 57) {
                    全数字 = 假;
                }
                k++;
            }
            如果 (全数字 && k > i + 1) {
                返回 i;
            }
        }
        i--;
    }
    返回 -1;
}
函数 记号类型(字符串 记号) -> 字符串 {
    整64 行位 = 记号行位(记号);
    如果 (行位 < 0) {
        返回 "";
    }
    字符串 前缀 = 字符串子串(记号, 0, 行位);
    整64 位 = 字符串查找(前缀, "|");
    如果 (位 < 0) {
        返回 前缀;
    }
    返回 字符串子串(前缀, 0, 位);
}
函数 记号文本(字符串 记号) -> 字符串 {
    整64 行位 = 记号行位(记号);
    如果 (行位 < 0) {
        返回 "";
    }
    字符串 前缀 = 字符串子串(记号, 0, 行位);
    整64 位 = 字符串查找(前缀, "|");
    如果 (位 < 0) {
        返回 "";
    }
    返回 字符串子串(前缀, 位 + 1, 行位 - 位 - 1);
}
函数 当前类型(向量<字符串> 记号, 整64 位置) -> 字符串 {
    如果 (位置 >= 记号.大小()) {
        返回 "文件结束";
    }
    返回 记号类型(记号.元素(位置));
}
函数 当前文本(向量<字符串> 记号, 整64 位置) -> 字符串 {
    如果 (位置 >= 记号.大小()) {
        返回 "";
    }
    返回 记号文本(记号.元素(位置));
}
函数 是关键字(向量<字符串> 记号, 整64 位置, 字符串 文本) -> 布尔 {
    返回 字符串比较(当前类型(记号, 位置), 文本);
}
函数 是运算符(向量<字符串> 记号, 整64 位置, 字符串 符号) -> 布尔 {
    如果 (字符串比较(当前类型(记号, 位置), 符号)) {
        返回 真;
    }
    如果 (字符串比较(当前类型(记号, 位置), "符号") &&
         字符串比较(当前文本(记号, 位置), 符号)) {
        返回 真;
    }
    返回 假;
}
函数 是标识符(向量<字符串> 记号, 整64 位置) -> 布尔 {
    返回 字符串比较(当前类型(记号, 位置), "标识符");
}
函数 记录(向量<字符串> 输出, 整64 深度, 字符串 节点) -> 空类型 {
    字符串 行 = "";
    整64 i = 0;
    当 (i < 深度) {
        行 = 行 + "  ";
        i++;
    }
    行 = 行 + 节点;
    // 72-a 迁移（2026-09-11）：字符串入容器须显式复制——行 为块内拥有串，
    //   浅共享入容器后源在块出口释放 = 元素悬垂。
    结果<空类型, 整32> 加 = 输出.追加(字符串复制(行));
    如果 (!加.正常) {
        运行时错误(4);
    }
}
