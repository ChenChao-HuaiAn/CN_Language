// 自举后端抽象层：arm64 后端实现（Task 009 平台抽象层重构 第三步）
// 实现 后端接口（后端接口.cn），输出 Linux ARM64 GAS 汇编（GNU as 可汇编、可链接运行）。
// 本文件镜像 x64后端.cn 的结构，将 x64 MASM 发射逻辑移植为 ARM64 GAS：
//   .data：字符串常量池 LstrN（UTF-8 字节十六进制，0 结尾）
//   .text：.globl 外部声明 + 函数符号标签
//   函数帧：stp x29,x30 / stp x19,xzr / mov x29,sp / sub sp,#F
//     槽区 8B×N、求值栈 512B（[x29-F+x19]）、返回缓冲 16B（结构返回）
//   调用约定：AAPCS64（x0~x7 前8整型参数 + v0~v7 浮点 + 栈参），调用前 sp 16 对齐
//   结构返回（结果<空类型,整32>）：x0=隐藏返回缓冲指针；正常 位于偏移 0（dword）
//   方法调用：向量$字符串$*（追加/元素/大小/删除/设置）符号按 GAS 风格修饰名硬编码
// 依据：spec 06 OOP 接口实现（类 名称 : 接口 { 重写 函数 ... }）
导入 容器::向量;
导入 词法分析::字节值;
导入 后端接口::后端接口;

公开:

// arm64后端 — Linux ARM64 GAS 汇编后端
类 arm64后端 : 后端接口 {
    // ---- 私有字段（默认私有）----
    向量<字符串> 输出行;
    整64 槽数;
    整64 帧大小;

    // ==================== 私有辅助方法 ====================

    // 追加一行到输出（结果检查）
    函数 追加(字符串 行) -> 空类型 {
        // 72-a 迁移（2026-09-11）：字符串入容器须显式复制（元素所有权归容器）
        结果<空类型, 整32> 加 = 输出行.追加(字符串复制(行));
        如果 (!加.正常) {
            运行时错误(4);
        }
    }

    // 字节 -> "0xXX"（GAS 十六进制字节）
    函数 字节十六进制(整64 字节) -> 字符串 {
        字符串 表 = "0123456789ABCDEF";
        返回 "0x" + 字符转字符串(字节值(表, 字节 / 16)) + 字符转字符串(字节值(表, 字节 % 16));
    }

    // 字节 -> "%02X"（原始两位十六进制，符号修饰用）
    函数 字节十六进制2(整64 字节) -> 字符串 {
        字符串 表 = "0123456789ABCDEF";
        返回 字符转字符串(字节值(表, 字节 / 16)) + 字符转字符串(字节值(表, 字节 % 16));
    }

    // 字符串 -> UTF-8 十六进制（GAS 符号修饰 _hex 用）
    函数 UTF8十六进制(字符串 文本) -> 字符串 {
        字符串 累积 = "";
        整64 i = 0;
        当 (i < 字符串长度(文本)) {
            累积 = 累积 + 自身.字节十六进制2(字节值(文本, i));
            i++;
        }
        返回 字符串复制(累积);
    }

    // 字符字面量 'x' / '\u{XXXX}' 的字节值（简化：单字节）
    函数 字符值(字符串 文本) -> 整64 {
        整64 长度 = 字符串长度(文本);
        如果 (长度 >= 3) {
            如果 (字节值(文本, 1) == 92) {
                返回 92;
            }
            返回 字节值(文本, 1);
        }
        返回 0;
    }

    // 数字串 -> 整64（含负号与 0x 十六进制前缀）
    函数 解析整数(字符串 文本) -> 整64 {
        整64 值 = 0;
        整64 符号 = 1;
        整64 起始 = 0;
        如果 (字符串长度(文本) > 0 && 字符串比较(字符串子串(文本, 0, 1), "-")) {
            符号 = -1;
            起始 = 1;
        }
        整64 基数 = 10;
        如果 (字符串长度(文本) >= 起始 + 2 && 字符串比较(字符串子串(文本, 起始, 2), "0x")) {
            基数 = 16;
            起始 = 起始 + 2;
        }
        整64 i = 起始;
        当 (i < 字符串长度(文本)) {
            整64 字节 = 字节值(文本, i);
            整64 数字 = 0;
            如果 (字节 >= 48 && 字节 <= 57) {
                数字 = 字节 - 48;
            } 否则 如果 (字节 >= 97 && 字节 <= 102) {
                数字 = 字节 - 87;
            } 否则 如果 (字节 >= 65 && 字节 <= 70) {
                数字 = 字节 - 55;
            }
            值 = 值 * 基数 + 数字;
            i++;
        }
        如果 (符号 < 0) {
            返回 0 - 值;
        }
        返回 值;
    }

    // 发射 64 位立即数到寄存器（movz/movk 分段，最多 4 条指令）
    函数 发射立即数到寄存器(字符串 寄存器, 整64 值) -> 空类型 {
        整64 首块 = -1;
        整64 位移 = 0;
        当 (位移 < 64) {
            整64 块 = (值 >> 位移) & 0xFFFF;
            如果 (块 != 0) {
                首块 = 位移;
                中断;
            }
            位移 = 位移 + 16;
        }
        如果 (首块 < 0) {
            自身.追加("movz " + 寄存器 + ", #0");
            返回;
        }
        位移 = 0;
        当 (位移 < 64) {
            整64 块 = (值 >> 位移) & 0xFFFF;
            如果 (块 != 0) {
                如果 (位移 == 首块) {
                    如果 (位移 == 0) {
                        自身.追加("movz " + 寄存器 + ", #" + 整数转字符串(块));
                    } 否则 {
                        自身.追加("movz " + 寄存器 + ", #" + 整数转字符串(块) + ", lsl #" + 整数转字符串(位移));
                    }
                } 否则 {
                    自身.追加("movk " + 寄存器 + ", #" + 整数转字符串(块) + ", lsl #" + 整数转字符串(位移));
                }
            }
            位移 = 位移 + 16;
        }
    }

    // 发射立即数到 x0
    函数 发射立即数(整64 值) -> 空类型 {
        自身.发射立即数到寄存器("x0", 值);
    }

    // 发射立即数文本（真/假/字符/数字）到 x0
    函数 发射立即数文本(字符串 文本) -> 空类型 {
        如果 (字符串比较(文本, "真")) {
            自身.发射立即数(1);
            返回;
        }
        如果 (字符串比较(文本, "假")) {
            自身.发射立即数(0);
            返回;
        }
        如果 (字符串长度(文本) > 0 && 字符串比较(字符串子串(文本, 0, 1), "'")) {
            自身.发射立即数(自身.字符值(文本));
            返回;
        }
        自身.发射立即数(自身.解析整数(文本));
    }

    // 求值栈基址：x10 = x29 - 帧大小（帧大小 = 槽数*8 + 544，16 对齐）
    函数 求值栈基址(整64 槽数) -> 空类型 {
        整64 帧 = 槽数 * 8 + 544;
        如果 (帧 % 16 != 0) {
            帧 = 帧 + 8;
        }
        如果 (帧 <= 4095) {
            自身.追加("sub x10, x29, #" + 整数转字符串(帧));
        } 否则 {
            自身.发射立即数到寄存器("x10", 帧);
            自身.追加("sub x10, x29, x10");
        }
    }

    // 返回缓冲地址：x10 = x29 - (8*槽数+40)（结构返回缓冲低 8 字节）
    函数 返回缓冲地址(整64 槽数) -> 空类型 {
        整64 偏移 = 8 * 槽数 + 40;
        如果 (偏移 <= 4095) {
            自身.追加("sub x10, x29, #" + 整数转字符串(偏移));
        } 否则 {
            自身.发射立即数到寄存器("x10", 偏移);
            自身.追加("sub x10, x29, x10");
        }
    }

    // 压栈（es[x19] = [x29-F+x19]；x19 为求值栈指针）
    函数 压栈(整64 槽数) -> 空类型 {
        自身.求值栈基址(槽数);
        自身.追加("str x0, [x10, x19]");
        自身.追加("add x19, x19, #8");
    }

    // 弹到 x0
    函数 弹出x0(整64 槽数) -> 空类型 {
        自身.追加("sub x19, x19, #8");
        自身.求值栈基址(槽数);
        自身.追加("ldr x0, [x10, x19]");
    }

    // 弹到 x1
    函数 弹出x1(整64 槽数) -> 空类型 {
        自身.追加("sub x19, x19, #8");
        自身.求值栈基址(槽数);
        自身.追加("ldr x1, [x10, x19]");
    }

    // 弹到 x2
    函数 弹出x2(整64 槽数) -> 空类型 {
        自身.追加("sub x19, x19, #8");
        自身.求值栈基址(槽数);
        自身.追加("ldr x2, [x10, x19]");
    }

    // 尾声（add sp,#F / ldp x19,xzr / ldp x29,x30 / ret）
    函数 尾声() -> 空类型 {
        如果 (帧大小 > 4095) {
            自身.发射立即数到寄存器("x10", 帧大小);
            自身.追加("add sp, sp, x10");
        } 否则 {
            自身.追加("add sp, sp, #" + 整数转字符串(帧大小));
        }
        自身.追加("ldp x19, xzr, [sp], #16");
        自身.追加("ldp x29, x30, [sp], #16");
        自身.追加("ret");
    }

    // 算术运算（+ - * / %）
    函数 发射运算算术(字符串 符号, 整64 槽数) -> 空类型 {
        自身.弹出x1(槽数);
        自身.弹出x0(槽数);
        如果 (字符串比较(符号, "+")) {
            自身.追加("add x0, x0, x1");
        } 否则 如果 (字符串比较(符号, "-")) {
            自身.追加("sub x0, x0, x1");
        } 否则 如果 (字符串比较(符号, "*")) {
            自身.追加("mul x0, x0, x1");
        } 否则 如果 (字符串比较(符号, "/")) {
            自身.追加("sdiv x0, x0, x1");
        } 否则 {
            自身.追加("sdiv x2, x0, x1");
            自身.追加("msub x0, x2, x1, x0");
        }
        自身.压栈(槽数);
    }

    // 移位运算（<< >>）
    函数 发射运算移位(字符串 符号, 整64 槽数) -> 空类型 {
        自身.弹出x1(槽数);
        自身.弹出x0(槽数);
        如果 (字符串比较(符号, "<<")) {
            自身.追加("lsl x0, x0, x1");
        } 否则 {
            自身.追加("asr x0, x0, x1");
        }
        自身.压栈(槽数);
    }

    // 位运算（& | ^）
    函数 发射运算位(字符串 符号, 整64 槽数) -> 空类型 {
        自身.弹出x1(槽数);
        自身.弹出x0(槽数);
        如果 (字符串比较(符号, "&")) {
            自身.追加("and x0, x0, x1");
        } 否则 如果 (字符串比较(符号, "|")) {
            自身.追加("orr x0, x0, x1");
        } 否则 {
            自身.追加("eor x0, x0, x1");
        }
        自身.压栈(槽数);
    }

    // 比较运算（== != < <= > >=）
    函数 发射运算比较(字符串 符号, 整64 槽数) -> 空类型 {
        自身.弹出x1(槽数);
        自身.弹出x0(槽数);
        自身.追加("cmp x0, x1");
        如果 (字符串比较(符号, "==")) {
            自身.追加("cset x0, eq");
        } 否则 如果 (字符串比较(符号, "!=")) {
            自身.追加("cset x0, ne");
        } 否则 如果 (字符串比较(符号, "<")) {
            自身.追加("cset x0, lt");
        } 否则 如果 (字符串比较(符号, "<=")) {
            自身.追加("cset x0, le");
        } 否则 如果 (字符串比较(符号, ">")) {
            自身.追加("cset x0, gt");
        } 否则 {
            自身.追加("cset x0, ge");
        }
        自身.压栈(槽数);
    }

    // 逻辑/一元/栈运算（&& || 非 取负 取反 下标字节 复制栈顶 弹出）
    函数 发射运算逻辑(字符串 符号, 整64 槽数) -> 空类型 {
        如果 (字符串比较(符号, "&&")) {
            自身.弹出x1(槽数);
            自身.弹出x0(槽数);
            自身.追加("and x0, x0, x1");
            自身.压栈(槽数);
            返回;
        }
        如果 (字符串比较(符号, "||")) {
            自身.弹出x1(槽数);
            自身.弹出x0(槽数);
            自身.追加("orr x0, x0, x1");
            自身.压栈(槽数);
            返回;
        }
        如果 (字符串比较(符号, "非")) {
            自身.弹出x0(槽数);
            自身.追加("cmp x0, #0");
            自身.追加("cset x0, eq");
            自身.压栈(槽数);
            返回;
        }
        如果 (字符串比较(符号, "取负")) {
            自身.弹出x0(槽数);
            自身.追加("neg x0, x0");
            自身.压栈(槽数);
            返回;
        }
        如果 (字符串比较(符号, "取反")) {
            自身.弹出x0(槽数);
            自身.追加("mvn x0, x0");
            自身.压栈(槽数);
            返回;
        }
        如果 (字符串比较(符号, "下标字节")) {
            自身.弹出x1(槽数);
            自身.弹出x0(槽数);
            自身.追加("ldrsb x0, [x0, x1]");
            自身.压栈(槽数);
            返回;
        }
        如果 (字符串比较(符号, "复制栈顶")) {
            自身.求值栈基址(槽数);
            自身.追加("ldr x0, [x10, x19]");
            自身.追加("add x19, x19, #8");
            自身.追加("str x0, [x10, x19]");
            返回;
        }
        如果 (字符串比较(符号, "弹出")) {
            自身.追加("sub x19, x19, #8");
            返回;
        }
    }

    // 赋值族（+= -= *= /= %=）
    函数 发射运算赋值(字符串 符号, 整64 槽数) -> 空类型 {
        自身.弹出x1(槽数);
        自身.弹出x0(槽数);
        如果 (字符串比较(符号, "+=")) {
            自身.追加("add x0, x0, x1");
        } 否则 如果 (字符串比较(符号, "-=")) {
            自身.追加("sub x0, x0, x1");
        } 否则 如果 (字符串比较(符号, "*=")) {
            自身.追加("mul x0, x0, x1");
        } 否则 如果 (字符串比较(符号, "/=")) {
            自身.追加("sdiv x0, x0, x1");
        } 否则 {
            自身.追加("sdiv x2, x0, x1");
            自身.追加("msub x0, x2, x1, x0");
        }
        自身.压栈(槽数);
    }

    // 装载 abi 位置 j 的参数（来源求值栈顶第 e 项；es[x19-8*栈参个数+8*e]）
    函数 发射装载参数(整64 j, 整64 e, 整64 槽数, 整64 栈参个数) -> 空类型 {
        自身.求值栈基址(槽数);
        自身.追加("sub x11, x19, #" + 整数转字符串(8 * 栈参个数 - 8 * e));
        如果 (j < 8) {
            自身.追加("ldr " + 自身.寄存器名(j) + ", [x10, x11]");
        } 否则 {
            自身.追加("ldr x0, [x10, x11]");
            自身.追加("str x0, [sp, #" + 整数转字符串(8 * (j - 8)) + "]");
        }
    }

    // 填充接口分派区（lessons教训，权重16.8）
    // 自举侧后端接口无 NewObject 指令，构造调用（标志"3"）时在 __cn_object_new 后
    // 填充接口分派区。与 C++ ARM64 后端 emitNewObject 对齐：遍历 classInterfaces，
    // 为每个接口计算偏移（8 + 全局槽*8），用 adrp + add 加载接口分派表地址，
    // str 写入对象头部。自举侧无类信息（无 semantic_），无法遍历 ifaceDisp，
    // 此处发射 ARM64 GAS 指令模式注释作为参考，以便将来扩展。
    // ARM64 GAS 接口分派区填充指令模式（参考 C++ 版 arm64_codegen_oop.cpp:111-138）：
    //   对每个接口（ifaceDisp 中的 (全局槽, 方法名) 对）：
    //     adrp x11, 方法符号          // 加载方法符号页地址
    //     add  x11, x11, :lo12:方法符号 // 加上页内偏移
    //     str  x11, [x0, #偏移]       // 写入对象头部（偏移 = 8 + 全局槽*8）
    //   其中 x0 为 __cn_object_new 返回的对象指针，偏移 0 为虚表指针，
    //   偏移 8+ 为接口分派表槽位。
    函数 填充接口分派区(整64 槽数) -> 空类型 {
        自身.追加("// 接口分派区填充（lessons教训：emitNewObject 必须填充接口分派区）");
        自身.追加("// 自举侧无类信息，接口分派区填充需在 C++ 侧实现");
        自身.追加("// ARM64 GAS 指令模式：adrp x11, sym / add x11, x11, :lo12:sym / str x11, [x0, #偏移]");
    }

公开:

    // 构造函数
    函数 arm64后端() {
        输出行 = 向量<字符串>();
        槽数 = 0;
        帧大小 = 0;
    }

    // 析构函数（缺陷3 强制规则 2026-09-02：拥有式字段须声明析构——
    //   编译器注入字段级联析构，释放 输出行 向量及其字符串元素）
    函数 ~arm64后端() { }

    // ---- 平台信息 ----
    重写 函数 目标平台() -> 字符串 {
        返回 "linux-arm64";
    }

    // ---- 段管理 ----
    // 段头：抽象段名（"数据"/"代码"）映射到 GAS 段
    重写 函数 段头(字符串 段名) -> 空类型 {
        如果 (字符串比较(段名, "数据")) {
            自身.追加("// ============================================");
            自身.追加("// CN语言编译器生成代码（自举后端）");
            自身.追加("// 目标平台: linux-arm64");
            自身.追加("// 汇编格式: GNU as (GAS) / AArch64 / AAPCS64");
            自身.追加("// ============================================");
            自身.追加("");
            自身.追加(".data");
        } 否则 {
            自身.追加("");
            自身.追加(".text");
        }
    }

    // 段尾：结束当前段（空行由 段头("代码") 前导空行承担，避免与 函数尾 空行重复）
    重写 函数 段尾() -> 空类型 {
    }

    // 程序结束：GAS 无 END 声明
    重写 函数 程序结束() -> 空类型 {
        自身.追加("// 程序结束（GAS 无 END 声明）");
    }

    // ---- 函数管理 ----
    // 函数头：符号标签、帧建立（stp x29,x30 / stp x19,xzr / mov x29,sp / sub sp,#F）、参数装载
    重写 函数 函数头(字符串 符号, 字符串 参数码, 整64 槽数, 整64 参数个数) -> 空类型 {
        帧大小 = 槽数 * 8 + 544;
        如果 (帧大小 % 16 != 0) {
            帧大小 = 帧大小 + 8;
        }
        自身.追加("// 函数 " + 符号);
        自身.追加(自身.符号修饰(符号, 参数码) + ":");
        自身.追加("stp x29, x30, [sp, #-16]!");
        自身.追加("stp x19, xzr, [sp, #-16]!");
        自身.追加("mov x29, sp");
        如果 (帧大小 > 4095) {
            自身.发射立即数到寄存器("x10", 帧大小);
            自身.追加("sub sp, sp, x10");
        } 否则 {
            自身.追加("sub sp, sp, #" + 整数转字符串(帧大小));
        }
        整64 i = 0;
        当 (i < 参数个数) {
            如果 (i < 8) {
                自身.追加("str " + 自身.寄存器名(i) + ", [x29, #-" + 整数转字符串(8 * (i + 1)) + "]");
            } 否则 {
                自身.追加("ldr x10, [x29, #" + 整数转字符串(32 + 8 * (i - 8)) + "]");
                自身.追加("str x10, [x29, #-" + 整数转字符串(8 * (i + 1)) + "]");
            }
            i++;
        }
        自身.追加("mov x19, #0");
    }

    // 函数尾：兜底尾声 + 空行
    重写 函数 函数尾(字符串 符号, 字符串 参数码) -> 空类型 {
        自身.尾声();
        自身.追加("");
    }

    // ---- 指令发射 ----
    // 字面量：真/假/数字（字符字面量已由 IR 遍历引擎解析为数字）
    重写 函数 发射字面量(字符串 文本, 整64 槽数) -> 空类型 {
        自身.发射立即数文本(文本);
        自身.压栈(槽数);
    }

    // 字符串常量引用：按常量表序号发射（adrp + add 常量地址）
    重写 函数 发射字符串引用(整64 序号, 整64 槽数) -> 空类型 {
        自身.追加("adrp x0, Lstr" + 整数转字符串(序号));
        自身.追加("add x0, x0, :lo12:Lstr" + 整数转字符串(序号));
        自身.压栈(槽数);
    }

    // 变量加载（引用参数解引用）
    重写 函数 发射加载(整64 槽, 布尔 是引用, 整64 槽数) -> 空类型 {
        自身.追加("ldr x0, [x29, #-" + 整数转字符串(8 * (槽 + 1)) + "]");
        如果 (是引用) {
            自身.追加("ldr x0, [x0]");
        }
        自身.压栈(槽数);
    }

    // 引用参数取址（传槽地址）
    重写 函数 发射压址(整64 槽, 整64 槽数) -> 空类型 {
        自身.追加("sub x0, x29, #" + 整数转字符串(8 * (槽 + 1)));
        自身.压栈(槽数);
    }

    // 赋值存储（引用参数解引用写）
    重写 函数 发射存储(整64 槽, 布尔 是引用, 整64 槽数) -> 空类型 {
        自身.弹出x0(槽数);
        如果 (是引用) {
            自身.追加("ldr x1, [x29, #-" + 整数转字符串(8 * (槽 + 1)) + "]");
            自身.追加("str x0, [x1]");
        } 否则 {
            自身.追加("str x0, [x29, #-" + 整数转字符串(8 * (槽 + 1)) + "]");
        }
    }

    // 结构返回结果拷贝（retbuf 16B -> 槽）
    重写 函数 发射复制结果(整64 槽, 整64 槽数) -> 空类型 {
        自身.返回缓冲地址(槽数);
        自身.追加("ldr x0, [x10]");
        自身.追加("str x0, [x29, #-" + 整数转字符串(8 * (槽 + 1)) + "]");
        自身.追加("ldr x0, [x10, #8]");
        自身.追加("str x0, [x29, #-" + 整数转字符串(8 * (槽 + 1) + 8) + "]");
    }

    // 结果.正常 字段读取（dword 归一化）
    重写 函数 发射加载成员(整64 槽, 整64 槽数) -> 空类型 {
        自身.追加("ldr w0, [x29, #-" + 整数转字符串(8 * (槽 + 1)) + "]");
        自身.追加("cmp w0, #0");
        自身.追加("cset x0, ne");
        自身.压栈(槽数);
    }

    // 递增/递减（引用参数解引用）
    重写 函数 发射递增递减(字符串 操作, 整64 槽, 布尔 是引用, 整64 槽数) -> 空类型 {
        如果 (是引用) {
            自身.追加("ldr x1, [x29, #-" + 整数转字符串(8 * (槽 + 1)) + "]");
            自身.追加("ldr x0, [x1]");
            如果 (字符串比较(操作, "递增")) {
                自身.追加("add x0, x0, #1");
            } 否则 {
                自身.追加("sub x0, x0, #1");
            }
            自身.追加("str x0, [x1]");
        } 否则 {
            自身.追加("ldr x0, [x29, #-" + 整数转字符串(8 * (槽 + 1)) + "]");
            如果 (字符串比较(操作, "递增")) {
                自身.追加("add x0, x0, #1");
            } 否则 {
                自身.追加("sub x0, x0, #1");
            }
            自身.追加("str x0, [x29, #-" + 整数转字符串(8 * (槽 + 1)) + "]");
        }
    }

    // 运算（算术/移位/位/比较/逻辑/赋值族）
    重写 函数 发射运算(字符串 符号, 整64 槽数) -> 空类型 {
        如果 (字符串比较(符号, "+") || 字符串比较(符号, "-") ||
             字符串比较(符号, "*") || 字符串比较(符号, "/") ||
             字符串比较(符号, "%")) {
            自身.发射运算算术(符号, 槽数);
            返回;
        }
        如果 (字符串比较(符号, "<<") || 字符串比较(符号, ">>")) {
            自身.发射运算移位(符号, 槽数);
            返回;
        }
        如果 (字符串比较(符号, "&") || 字符串比较(符号, "|") ||
             字符串比较(符号, "^")) {
            自身.发射运算位(符号, 槽数);
            返回;
        }
        如果 (字符串比较(符号, "==") || 字符串比较(符号, "!=") ||
             字符串比较(符号, "<") || 字符串比较(符号, "<=") ||
             字符串比较(符号, ">") || 字符串比较(符号, ">=")) {
            自身.发射运算比较(符号, 槽数);
            返回;
        }
        如果 (字符串比较(符号, "&&") || 字符串比较(符号, "||") ||
             字符串比较(符号, "非") || 字符串比较(符号, "取负") ||
             字符串比较(符号, "取反") || 字符串比较(符号, "下标字节") ||
             字符串比较(符号, "复制栈顶") || 字符串比较(符号, "弹出")) {
            自身.发射运算逻辑(符号, 槽数);
            返回;
        }
        如果 (字符串比较(符号, "+字")) {
            自身.弹出x1(槽数);
            自身.弹出x0(槽数);
            自身.追加("bl __cn_str_concat");
            自身.压栈(槽数);
            返回;
        }
        如果 (字符串比较(符号, "+=") || 字符串比较(符号, "-=") ||
             字符串比较(符号, "*=") || 字符串比较(符号, "/=") ||
             字符串比较(符号, "%=")) {
            自身.发射运算赋值(符号, 槽数);
            返回;
        }
    }

    // 调用（符号|参数数|标志|参数码 已由 IR 遍历引擎解析）
    重写 函数 发射调用(字符串 符号, 整64 参数个数, 字符串 标志, 字符串 参数码,
                    整64 槽数) -> 空类型 {
        // ---- 构造：__cn_object_new(24) + 构造函数（构造为 空类型 返回——
        //   对象须保留 __cn_object_new 的结果，经 返回缓冲槽 中转） ----
        如果 (字符串比较(标志, "3")) {
            自身.追加("mov x0, #24");
            自身.追加("bl __cn_object_new");
            自身.返回缓冲地址(槽数);
            自身.追加("str x0, [x10]");
            自身.填充接口分派区(槽数);
            自身.追加("bl " + 自身.符号修饰("向量$字符串$向量", ""));
            自身.返回缓冲地址(槽数);
            自身.追加("ldr x0, [x10]");
            自身.压栈(槽数);
            返回;
        }
        // ---- ABI 参数数 ----
        整64 abi = 参数个数;
        如果 (字符串比较(标志, "1")) {
            abi = 参数个数 + 1;
        }
        如果 (字符串比较(标志, "2")) {
            abi = 参数个数 + 2;
        }
        整64 栈参 = abi - 8;
        如果 (栈参 < 0) {
            栈参 = 0;
        }
        整64 间距 = 8 * 栈参;
        如果 (间距 % 16 != 0) {
            间距 = 间距 + 8;
        }
        如果 (间距 > 0) {
            如果 (间距 <= 4095) {
                自身.追加("sub sp, sp, #" + 整数转字符串(间距));
            } 否则 {
                自身.发射立即数到寄存器("x10", 间距);
                自身.追加("sub sp, sp, x10");
            }
        }
        // ---- 参数装载（参数为求值栈顶 Nargs 项，x19 相对寻址） ----
        整64 栈参个数 = abi;
        如果 (字符串比较(标志, "2")) {
            栈参个数 = abi - 1;
        }
        整64 j = 0;
        当 (j < abi) {
            如果 (字符串比较(标志, "2")) {
                如果 (j == 0) {
                    自身.返回缓冲地址(槽数);
                    自身.追加("mov x0, x10");
                } 否则 {
                    自身.发射装载参数(j, j - 1, 槽数, 栈参个数);
                }
            } 否则 {
                自身.发射装载参数(j, j, 槽数, 栈参个数);
            }
            j++;
        }
        自身.追加("bl " + 自身.符号修饰(符号, 参数码));
        如果 (间距 > 0) {
            如果 (间距 <= 4095) {
                自身.追加("add sp, sp, #" + 整数转字符串(间距));
            } 否则 {
                自身.发射立即数到寄存器("x10", 间距);
                自身.追加("add sp, sp, x10");
            }
        }
        // ---- 弹出求值栈参数（retbuf 不在栈上） ----
        如果 (栈参个数 > 0) {
            自身.追加("sub x19, x19, #" + 整数转字符串(8 * 栈参个数));
        }
        // ---- 结果 ----
        如果 (字符串比较(标志, "2")) {
            // 结构返回：结果留在返回缓冲（复制结果 指令负责搬运）
        } 否则 {
            自身.压栈(槽数);
        }
    }

    // 返回（弹出返回值 + 尾声）
    重写 函数 发射返回(整64 槽数) -> 空类型 {
        自身.弹出x0(槽数);
        自身.尾声();
    }

    // 返回空（仅尾声）
    重写 函数 发射返回空() -> 空类型 {
        自身.尾声();
    }

    // 标签
    重写 函数 发射标签(字符串 文本) -> 空类型 {
        自身.追加(文本 + ":");
    }

    // 无条件跳转
    重写 函数 发射跳转(字符串 文本) -> 空类型 {
        自身.追加("b " + 文本);
    }

    // 跳转真（弹出 + 测试 + 条件跳转）
    重写 函数 发射跳转真(字符串 文本, 整64 槽数) -> 空类型 {
        自身.弹出x0(槽数);
        自身.追加("cbnz x0, " + 文本);
    }

    // 跳转假（弹出 + 测试 + 条件跳转）
    重写 函数 发射跳转假(字符串 文本, 整64 槽数) -> 空类型 {
        自身.弹出x0(槽数);
        自身.追加("cbz x0, " + 文本);
    }

    // ---- 常量与外部声明 ----
    // 发射 .data 字符串常量（每行 ≤16 字节，0 结尾）
    重写 函数 发射字符串常量(整64 序号, 字符串 文本) -> 空类型 {
        自身.追加("Lstr" + 整数转字符串(序号) + ":");
        整64 i = 0;
        整64 计数 = 0;
        字符串 行 = "    .byte ";
        当 (i < 字符串长度(文本)) {
            如果 (计数 == 16) {
                自身.追加(行);
                行 = "    .byte ";
                计数 = 0;
            }
            如果 (计数 > 0) {
                行 = 行 + ", ";
            }
            行 = 行 + 自身.字节十六进制(字节值(文本, i));
            计数++;
            i++;
        }
        如果 (计数 > 0) {
            自身.追加(行);
        }
        自身.追加("    .byte 0");
    }

    // 发射固定外部符号声明（运行时/内置符号）
    重写 函数 发射固定外部() -> 空类型 {
        自身.追加("// 运行时外部符号（由 cn_runtime 库提供，链接器解析）");
        自身.追加(".globl printLine");
        自身.追加(".globl printNoLine");
        自身.追加(".globl __cn_runtime_error");
        自身.追加(".globl __cn_object_new");
        自身.追加(".globl __cn_object_delete");
        自身.追加(".globl __cn_str_len");
        自身.追加(".globl __cn_str_eq");
        自身.追加(".globl __cn_str_find");
        自身.追加(".globl __cn_str_sub");
        自身.追加(".globl __cn_str_contains");
        自身.追加(".globl __cn_str_concat");
        自身.追加(".globl __cn_str_from_int");
        自身.追加(".globl __cn_str_from_char");
        自身.追加(".globl _E59091E9878F24E5AD97E7ACA6E4B8B224E59091E9878F");
        自身.追加(".globl _E59091E9878F24E5AD97E7ACA6E4B8B224E8BFBDE58AA0_PAX");
        自身.追加(".globl _E59091E9878F24E5AD97E7ACA6E4B8B224E58583E7B4A0_J");
        自身.追加(".globl _E59091E9878F24E5AD97E7ACA6E4B8B224E5A4A7E5B08F");
        自身.追加(".globl _E59091E9878F24E5AD97E7ACA6E4B8B224E588A0E999A4_J");
        自身.追加(".globl _E59091E9878F24E5AD97E7ACA6E4B8B224E8AEBEE7BDAE_JPAX");
        自身.追加("");
    }

    // 发射单个外部符号声明（.globl）
    重写 函数 发射外部声明(字符串 符号, 字符串 参数码) -> 空类型 {
        自身.追加(".globl " + 自身.符号修饰(符号, 参数码));
    }

    // 符号是否固定外部（运行时/内置符号）
    重写 函数 固定外部(字符串 符号) -> 布尔 {
        如果 (字符串比较(符号, "printLine") || 字符串比较(符号, "printNoLine")) {
            返回 真;
        }
        如果 (字符串长度(符号) >= 5 && 字符串比较(字符串子串(符号, 0, 5), "__cn_")) {
            返回 真;
        }
        如果 (字符串长度(符号) >= 3 && 字符串比较(字符串子串(符号, 0, 3), "cn_")) {
            返回 真;
        }
        如果 (字符串长度(符号) >= 6 && 字符串比较(字符串子串(符号, 0, 6), "向量$字符串$")) {
            返回 真;
        }
        返回 假;
    }

    // ---- 符号与寄存器 ----
    // CN 符号 -> GAS 链接符号（_ + UTF-8 十六进制，无 MASM 的 ?..@@Y 装饰）
    重写 函数 符号修饰(字符串 符号, 字符串 参数码) -> 字符串 {
        如果 (字符串比较(符号, "主")) {
            返回 "cn_main";
        }
        // 运行时 / 内置：原样
        如果 (字符串比较(符号, "printLine") || 字符串比较(符号, "printNoLine")) {
            返回 字符串复制(符号);
        }
        如果 (字符串长度(符号) >= 5 && 字符串比较(字符串子串(符号, 0, 5), "__cn_")) {
            返回 字符串复制(符号);
        }
        如果 (字符串长度(符号) >= 3 && 字符串比较(字符串子串(符号, 0, 3), "cn_")) {
            返回 字符串复制(符号);
        }
        // 向量方法：GAS 风格 _ + UTF-8 十六进制（+ _参数码 当有参数）
        如果 (字符串长度(符号) >= 6 && 字符串比较(字符串子串(符号, 0, 6), "向量$字符串$")) {
            如果 (字符串长度(参数码) > 0) {
                返回 "_" + 自身.UTF8十六进制(符号) + "_" + 参数码;
            }
            返回 "_" + 自身.UTF8十六进制(符号);
        }
        // 模块函数：_ + UTF-8 十六进制（+ _参数码 当有参数）
        如果 (字符串长度(参数码) > 0) {
            返回 "_" + 自身.UTF8十六进制(符号) + "_" + 参数码;
        }
        返回 "_" + 自身.UTF8十六进制(符号);
    }

    // 参数寄存器名（索引 0..7 -> x0..x7）
    重写 函数 寄存器名(整64 索引) -> 字符串 {
        如果 (索引 == 0) {
            返回 "x0";
        }
        如果 (索引 == 1) {
            返回 "x1";
        }
        如果 (索引 == 2) {
            返回 "x2";
        }
        如果 (索引 == 3) {
            返回 "x3";
        }
        如果 (索引 == 4) {
            返回 "x4";
        }
        如果 (索引 == 5) {
            返回 "x5";
        }
        如果 (索引 == 6) {
            返回 "x6";
        }
        返回 "x7";
    }

    // ---- 输出 ----
    // 获取后端生成的完整汇编行列表
    重写 函数 获取输出() -> 向量<字符串> {
        返回 输出行;
    }
}
