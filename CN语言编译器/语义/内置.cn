// 自举 Task 7.3 子模块：语义/内置（B 任务拆分，2026-08）
// 职责：内置函数/类型关键字判定 + AST 行工具
// 门面 语义分析.cn 经 `导入 语义::内置` 引入，调用 `内置::是内置函数` 等
公开:

// 取行类型段（去缩进后 "类型|文本" 的 类型）
函数 行类型(字符串 行) -> 字符串 {
    整64 起 = 0
    布尔 空格 = 字符串比较(字符串子串(行, 0, 1), " ")
    当 (起 < 字符串长度(行) && 空格) {
        起++
        空格 = 字符串比较(字符串子串(行, 起, 1), " ")
    }
    整64 位 = 字符串查找(行, "|")
    如果 (位 < 0) {
        返回 字符串子串(行, 起, 字符串长度(行) - 起)
    }
    返回 字符串子串(行, 起, 位 - 起)
}

// 取行文本段（"类型|文本" 的 文本）
函数 行文本(字符串 行) -> 字符串 {
    整64 位 = 字符串查找(行, "|")
    如果 (位 < 0) {
        返回 ""
    }
    返回 字符串子串(行, 位 + 1, 字符串长度(行) - 位 - 1)
}

// 内置函数名（预置符号，使用不报未声明）
函数 是内置函数(字符串 名) -> 布尔 {
    返回 字符串比较(名, "打印") || 字符串比较(名, "打印行") ||
           字符串比较(名, "字符串长度") || 字符串比较(名, "字符串比较") ||
           字符串比较(名, "字符串包含") || 字符串比较(名, "字符串子串") ||
           字符串比较(名, "字符串查找") || 字符串比较(名, "整数转字符串") ||
           字符串比较(名, "字节值") || 字符串比较(名, "正常") ||
           字符串比较(名, "错误") || 字符串比较(名, "某些") ||
           字符串比较(名, "类型大小")
}

// 类型关键字（类型位置不查符号表）
函数 是类型关键字(字符串 名) -> 布尔 {
    返回 字符串比较(名, "整8") || 字符串比较(名, "整16") ||
           字符串比较(名, "整32") || 字符串比较(名, "整64") ||
           字符串比较(名, "整128") || 字符串比较(名, "正8") ||
           字符串比较(名, "正16") || 字符串比较(名, "正32") ||
           字符串比较(名, "正64") || 字符串比较(名, "正128") ||
           字符串比较(名, "浮32") || 字符串比较(名, "浮64") ||
           字符串比较(名, "布尔") || 字符串比较(名, "字符") ||
           字符串比较(名, "字符串") || 字符串比较(名, "空类型") ||
           字符串比较(名, "整数") || 字符串比较(名, "小数") ||
           字符串比较(名, "结果") || 字符串比较(名, "可选") ||
           字符串比较(名, "向量") || 字符串比较(名, "数组") ||
           字符串比较(名, "映射") || 字符串比较(名, "队列") ||
           字符串比较(名, "堆栈") || 字符串比较(名, "集合")
}

// 提取函数参数数（文本 "名|参数数=N" -> N）
函数 函数参数数(字符串 文本) -> 字符串 {
    整64 分隔 = 字符串查找(文本, "参数数=")
    如果 (分隔 < 0) {
        返回 "0"
    }
    返回 字符串子串(文本, 分隔 + 10, 字符串长度(文本) - 分隔 - 10)  // "参数数=" UTF-8 10 字节
}

// 提取函数名（文本 "名|参数数=N" -> 名）
函数 函数名(字符串 文本) -> 字符串 {
    整64 分隔 = 字符串查找(文本, "|参数数=")
    如果 (分隔 < 0) {
        返回 文本
    }
    返回 字符串子串(文本, 0, 分隔)
}