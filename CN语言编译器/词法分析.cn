// 自举 Task 7.1：CN 词法分析器（用 CN 重写 C++ 版 lexer，2026-08）
// 对标：src/cn_compiler/lexer（token.hpp/lexer.cpp）
// 覆盖：标识符（中文/ASCII）、61 个关键字、整数（十进制/0x十六进制/0b二进制/
//   0o八进制+LL/U后缀）、浮点（3.14/1e10）、字符串（含 \\ 转义、原始"" 前缀、
//   多行""" 前缀）、字符、行注释 //、块注释 /* */、39 运算符（多字符贪婪匹配
//   ++ -- -> :: <<= >>= 等）、9 分隔符、行号跟踪。
// 输出：分词(源码) -> 向量<字符串>，每项 "类型|文本|行"（与 C++ 版 cn token
//   输出语义对齐：关键字类型=文本、运算符类型=符号本身、EOF=文件结束）
导入 容器::向量

公开:

// 分词：源码文本 -> token 描述行列表（"类型|文本|行"）
函数 分词(字符串 源码) -> 向量<字符串> {
    向量<字符串> 输出 = 向量<字符串>()
    整64 位置 = 0
    整64 行号 = 1
    整64 长度 = 字符串长度(源码)
    字符串 上一文本 = ""
    当 (位置 < 长度) {
        整64 字节 = 字节值(源码, 位置)
        // ---- 空白/换行 ----
        如果 (字节 == 10) {
            位置++
            行号++
            继续
        }
        如果 (字节 == 32 || 字节 == 9 || 字节 == 13) {
            位置++
            继续
        }
        // ---- 注释：// 行注释、/* 块注释 ----
        如果 (字节 == 47 && 位置 + 1 < 长度 && 字节值(源码, 位置 + 1) == 47) {
            位置 += 2
            当 (位置 < 长度 && 字节值(源码, 位置) != 10) {
                位置++
            }
            继续
        }
        如果 (字节 == 47 && 位置 + 1 < 长度 && 字节值(源码, 位置 + 1) == 42) {
            位置 += 2
            当 (位置 + 1 < 长度 && !(字节值(源码, 位置) == 42 && 字节值(源码, 位置 + 1) == 47)) {
                如果 (字节值(源码, 位置) == 10) {
                    行号++
                }
                位置++
            }
            如果 (位置 + 1 < 长度) {
                位置 += 2
            }
            继续
        }
        // ---- 字符串/字符/原始/多行 前缀 ----
        如果 (字节 == 34) {
            // 注意：CN 字符串 == 按指针地址比较（规格书 10.3 字符串不参与运算符
            //   比较），前缀判定必须用 字符串比较（相等语义）
            布尔 原始前缀 = 字符串比较(上一文本, "原始")
            布尔 多行前缀 = 字符串比较(上一文本, "多行")
            整64 新位置 = 扫描字符串(源码, 位置, 长度, 原始前缀, 多行前缀, 输出, 行号)
            位置 = 新位置
            上一文本 = ""
            继续
        }
        如果 (字节 == 39) {
            整64 新位置2 = 扫描字符(源码, 位置, 长度, 输出, 行号)
            位置 = 新位置2
            上一文本 = ""
            继续
        }
        // ---- 数字字面量 ----
        如果 (是数字(字节)) {
            字符串 文本 = ""
            整64 新位置3 = 扫描数字(源码, 位置, 长度, 文本)
            如果 (字符串包含(文本, ".") || 字符串包含(文本, "e") || 字符串包含(文本, "E")) {
                记录(输出, "浮点字面量", 文本, 行号)
            } 否则 {
                记录(输出, "整数字面量", 文本, 行号)
            }
            位置 = 新位置3
            上一文本 = ""
            继续
        }
        // ---- 标识符 / 关键字 ----
        如果 (是字母(字节)) {
            整64 起点 = 位置
            位置++
            当 (位置 < 长度) {
                整64 继续字节 = 字节值(源码, 位置)
                如果 (!(是字母(继续字节) || 是数字(继续字节))) {
                    中断
                }
                位置++
            }
            字符串 名称 = 字符串子串(源码, 起点, 位置 - 起点)
            字符串 关键字 = 查找关键字(名称)
            如果 (字符串长度(关键字) > 0) {
                记录(输出, 关键字, 关键字, 行号)
            } 否则 {
                记录(输出, "标识符", 名称, 行号)
            }
            上一文本 = 名称
            继续
        }
        // ---- 运算符 / 分隔符 ----
        字符串 符号 = 匹配运算符(源码, 位置, 长度)
        如果 (字符串长度(符号) > 0) {
            记录(输出, 符号, 符号, 行号)
            位置 += 字符串长度(符号)
            上一文本 = ""
            继续
        }
        // ---- 未知字符：跳过（容错） ----
        位置++
        上一文本 = ""
    }
    记录(输出, "文件结束", "", 行号)
    返回 输出
}

// ==================== 内部辅助 ====================

公开:
// 取源码位置的字节值（0..255，UTF-8 字节视图）
函数 字节值(字符串 源码, 整64 位置) -> 整64 {
    整64 值 = 整64(源码[位置])
    如果 (值 < 0) {
        返回 值 + 256
    }
    返回 值
}

公开:
// 追加一行 token 描述（"类型|文本|行"）
// 注：向量 为类对象（指针语义），按值传参即地址拷贝（自举 Task 7.1：泛型容器
//   引用参数 的签名解析尚未对齐，按值等价且无性能损失）
函数 记录(向量<字符串> 输出, 字符串 类型, 字符串 文本, 整64 行号) -> 空类型 {
    // 内部辅助统一 公开（2026-08 自举实测：私有函数调用在跨模块合并后
    //   链接符号缺模块前缀——A-5 纯名解析差异；自举模块为库形态，公开合理）
    结果<空类型, 整32> 加 = 输出.追加(类型 + "|" + 文本 + "|" + 整数转字符串(行号))
    如果 (!加.正常) {
        运行时错误(4)
    }
}

// 字节分类
函数 是数字(整64 字节) -> 布尔 {
    返回 字节 >= 48 && 字节 <= 57
}
函数 是字母(整64 字节) -> 布尔 {
    如果 (字节 >= 128) {
        返回 真  // UTF-8 中文字符
    }
    返回 (字节 >= 97 && 字节 <= 122) || (字节 >= 65 && 字节 <= 90) || 字节 == 95
}
函数 是十六进制(整64 字节) -> 布尔 {
    返回 是数字(字节) || (字节 >= 97 && 字节 <= 102) || (字节 >= 65 && 字节 <= 70)
}

// 关键字查找（61 个，v2.0；拆 4 组控制行数）：命中返回关键字文本，否则空串
函数 查找关键字(字符串 文本) -> 字符串 {
    字符串 命中 = 关键字组A(文本)
    如果 (字符串长度(命中) > 0) {
        返回 命中
    }
    命中 = 关键字组B(文本)
    如果 (字符串长度(命中) > 0) {
        返回 命中
    }
    命中 = 关键字组C(文本)
    如果 (字符串长度(命中) > 0) {
        返回 命中
    }
    返回 关键字组D(文本)
}
函数 关键字组A(字符串 文本) -> 字符串 {
    选择 (文本) {
        情况 "如果", "否则", "当", "循环", "返回", "中断", "继续", "选择", "情况", "默认",
              "遍历", "中", "每个":
            返回 文本
        情况 "函数", "变量", "导入", "公开", "私有", "静态", "自动":
            返回 文本
        默认:
            返回 ""
    }
}
函数 关键字组B(字符串 文本) -> 字符串 {
    选择 (文本) {
        情况 "整数", "小数", "整8", "整16", "整32", "整64", "整128":
            返回 文本
        情况 "正8", "正16", "正32", "正64", "正128", "浮32", "浮64":
            返回 文本
        情况 "布尔", "字符", "字符串", "空类型", "结构体", "联合体", "枚举":
            返回 文本
        默认:
            返回 ""
    }
}
函数 关键字组C(字符串 文本) -> 字符串 {
    选择 (文本) {
        情况 "模块", "作为", "包", "货舱":
            返回 文本
        情况 "真", "假", "无", "常量":
            返回 文本
        情况 "类", "接口", "保护", "虚拟", "重写", "抽象", "实现", "自身", "父类", "友元":
            返回 文本
        默认:
            返回 ""
    }
}
函数 关键字组D(字符串 文本) -> 字符串 {
    选择 (文本) {
        情况 "结果", "可选", "原始", "多行", "泛型":
            返回 文本
        默认:
            返回 ""
    }
}

// 运算符/分隔符匹配（多字符贪婪：<<= >>= 三字符优先，其次 双字符，最后 单字符）
// 返回匹配到的符号文本；非运算符字符返回空串
函数 匹配运算符(字符串 源码, 整64 位置, 整64 长度) -> 字符串 {
    整64 首 = 字节值(源码, 位置)
    整64 次 = 0
    整64 三 = 0
    如果 (位置 + 1 < 长度) {
        次 = 字节值(源码, 位置 + 1)
    }
    如果 (位置 + 2 < 长度) {
        三 = 字节值(源码, 位置 + 2)
    }
    选择 (首) {
        情况 43:  // +
            如果 (次 == 43) { 返回 "++" }
            如果 (次 == 61) { 返回 "+=" }
            返回 "+"
        情况 45:  // -
            如果 (次 == 45) { 返回 "--" }
            如果 (次 == 62) { 返回 "->" }
            如果 (次 == 61) { 返回 "-=" }
            返回 "-"
        情况 42:  // *
            如果 (次 == 61) { 返回 "*=" }
            返回 "*"
        情况 47:  // /
            如果 (次 == 61) { 返回 "/=" }
            返回 "/"
        情况 37:  // %
            如果 (次 == 61) { 返回 "%=" }
            返回 "%"
        情况 60:  // <
            如果 (次 == 60) {
                如果 (三 == 61) { 返回 "<<=" }
                返回 "<<"
            }
            如果 (次 == 61) { 返回 "<=" }
            返回 "<"
        情况 62:  // >
            如果 (次 == 62) {
                如果 (三 == 61) { 返回 ">>=" }
                返回 ">>"
            }
            如果 (次 == 61) { 返回 ">=" }
            返回 ">"
        情况 61:  // =
            如果 (次 == 61) { 返回 "==" }
            返回 "="
        情况 33:  // !
            如果 (次 == 61) { 返回 "!=" }
            返回 "!"
        情况 38:  // &
            如果 (次 == 38) { 返回 "&&" }
            返回 "&"
        情况 124: // |
            如果 (次 == 124) { 返回 "||" }
            返回 "|"
        情况 94:  // ^
            如果 (次 == 61) { 返回 "^=" }
            返回 "^"
        情况 126: // ~
            返回 "~"
        情况 46:  // .
            返回 "."
        情况 58:  // :
            如果 (次 == 58) { 返回 "::" }
            返回 ":"
        情况 40:  // (
            返回 "("
        情况 41:  // )
            返回 ")"
        情况 123: // {
            返回 "{"
        情况 125: // }
            返回 "}"
        情况 91:  // [
            返回 "["
        情况 93:  // ]
            返回 "]"
        情况 59:  // ;
            返回 ";"
        情况 44:  // ,
            返回 ","
        情况 63:  // ?
            返回 "?"
        默认:
            返回 ""
    }
}

// 扫描数字字面量：0x 十六进制 / 0b 二进制 / 0o 八进制 / 十进制（含 . 与 e 指数与 LL/U 后缀）
// 文本 输出 字面量原文（含前缀与后缀）；返回新位置
函数 扫描数字(字符串 源码, 整64 位置, 整64 长度, 字符串& 文本) -> 整64 {
    整64 起点 = 位置
    如果 (位置 + 1 < 长度) {
        整64 首 = 字节值(源码, 位置)
        整64 次 = 字节值(源码, 位置 + 1)
        如果 (首 == 48) {
            如果 (次 == 120 || 次 == 88) {  // 0x
                位置 += 2
                当 (位置 < 长度 && 是十六进制(字节值(源码, 位置))) {
                    位置++
                }
                文本 = 字符串子串(源码, 起点, 位置 - 起点)
                返回 位置
            }
            如果 (次 == 98 || 次 == 66) {  // 0b
                位置 += 2
                当 (位置 < 长度 && (字节值(源码, 位置) == 48 || 字节值(源码, 位置) == 49)) {
                    位置++
                }
                文本 = 字符串子串(源码, 起点, 位置 - 起点)
                返回 位置
            }
            如果 (次 == 111 || 次 == 79) {  // 0o
                位置 += 2
                当 (位置 < 长度) {
                    整64 值 = 字节值(源码, 位置)
                    如果 (!(值 >= 48 && 值 <= 55)) {
                        中断
                    }
                    位置++
                }
                文本 = 字符串子串(源码, 起点, 位置 - 起点)
                返回 位置
            }
        }
    }
    当 (位置 < 长度 && 是数字(字节值(源码, 位置))) {
        位置++
    }
    如果 (位置 + 1 < 长度 && 字节值(源码, 位置) == 46 && 是数字(字节值(源码, 位置 + 1))) {
        位置 += 2
        当 (位置 < 长度 && 是数字(字节值(源码, 位置))) {
            位置++
        }
    }
    如果 (位置 < 长度 && (字节值(源码, 位置) == 101 || 字节值(源码, 位置) == 69)) {
        位置++
        如果 (位置 < 长度 && (字节值(源码, 位置) == 43 || 字节值(源码, 位置) == 45)) {
            位置++
        }
        当 (位置 < 长度 && 是数字(字节值(源码, 位置))) {
            位置++
        }
    }
    当 (位置 < 长度) {
        整64 后缀 = 字节值(源码, 位置)
        如果 (后缀 == 76 || 后缀 == 108 || 后缀 == 85 || 后缀 == 117) {
            位置++
        } 否则 {
            中断
        }
    }
    文本 = 字符串子串(源码, 起点, 位置 - 起点)
    返回 位置
}

// 扫描字符串字面量（"..."，含 \\ 转义；原始"" 前缀不处理转义；多行""" 前缀到 """ 结束）
// 输出 token 行；返回新位置。未闭合字符串容错到行尾（不跨行）。
函数 扫描字符串(字符串 源码, 整64 位置, 整64 长度, 布尔 原始前缀, 布尔 多行前缀,
                 向量<字符串> 输出, 整64 行号) -> 整64 {
    整64 起始行 = 行号  // token 行号 = 起始行（多行字符串内部换行只推进外部行号）
    整64 起点 = 位置
    位置++
    布尔 闭合 = 假
    当 (位置 < 长度) {
        整64 字节 = 字节值(源码, 位置)
        如果 (多行前缀) {
            // 多行字符串内部换行合法（到 """ 才结束）；先于 未闭合 检查
            如果 (字节 == 10) {
                行号++
            }
            如果 (字节 == 34 && 位置 + 2 < 长度 &&
                 字节值(源码, 位置 + 1) == 34 && 字节值(源码, 位置 + 2) == 34) {
                位置 += 3
                闭合 = 真
                中断
            }
            位置++
            继续
        }
        如果 (字节 == 10) {
            中断  // 未闭合：容错到行尾（仅非多行字符串）
        }
        如果 (字节 == 34) {
            位置++
            闭合 = 真
            中断
        }
        如果 (字节 == 92 && !原始前缀) {  // \ 转义
            如果 (位置 + 1 < 长度 && 字节值(源码, 位置 + 1) == 117) {  // \u{
                位置 += 2
                当 (位置 < 长度 && 字节值(源码, 位置) != 125) {
                    位置++
                }
                如果 (位置 < 长度) {
                    位置++
                }
                继续
            }
            位置 += 2
            继续
        }
        位置++
    }
    如果 (!闭合) {
        记录(输出, "未知", 字符串子串(源码, 起点, 位置 - 起点), 起始行)
        返回 位置
    }
    记录(输出, "字符串字面量", 字符串子串(源码, 起点, 位置 - 起点), 起始行)
    返回 位置
}

// 扫描字符字面量（'x' 或 '\\u{XXXX}'）；输出 token 行；返回新位置
函数 扫描字符(字符串 源码, 整64 位置, 整64 长度, 向量<字符串> 输出, 整64 行号) -> 整64 {
    整64 起点 = 位置
    位置++
    布尔 闭合 = 假
    当 (位置 < 长度) {
        整64 字节 = 字节值(源码, 位置)
        如果 (字节 == 10) {
            中断
        }
        如果 (字节 == 39) {
            位置++
            闭合 = 真
            中断
        }
        如果 (字节 == 92) {
            如果 (位置 + 1 < 长度 && 字节值(源码, 位置 + 1) == 117) {
                位置 += 2
                当 (位置 < 长度 && 字节值(源码, 位置) != 125) {
                    位置++
                }
                如果 (位置 < 长度) {
                    位置++
                }
                继续
            }
            位置 += 2
            继续
        }
        位置++
    }
    如果 (!闭合) {
        记录(输出, "未知", 字符串子串(源码, 起点, 位置 - 起点), 行号)
        返回 位置
    }
    记录(输出, "字符字面量", 字符串子串(源码, 起点, 位置 - 起点), 行号)
    返回 位置
}
