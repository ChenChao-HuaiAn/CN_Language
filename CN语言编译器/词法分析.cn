// 自举 Task 7.1：CN 词法分析器（用 CN 重写 C++ 版 lexer，2026-08）
// B 任务拆分（2026-08）：门面文件——保留 分词 入口 + 记录 + 字节值，
//   子模块拆分至 词法/关键字.cn（查找关键字）、词法/运算符.cn（匹配运算符）、
//   词法/扫描.cn（扫描数字/字符串/字符 + 字节分类）。
// 对标：src/cn_compiler/lexer（token.hpp/lexer.cpp）
// 覆盖：标识符（中文/ASCII）、61 个关键字、整数（十进制/0x十六进制/0b二进制/
//   0o八进制+LL/U后缀）、浮点（3.14/1e10）、字符串（含 \\ 转义、原始"" 前缀、
//   多行""" 前缀）、字符、行注释 //、块注释 /* */、39 运算符（多字符贪婪匹配
//   ++ -- -> :: <<= >>= 等）、9 分隔符、行号跟踪。
// 输出：分词(源码) -> 向量<字符串>，每项 "类型|文本|行"（与 C++ 版 cn token
//   输出语义对齐：关键字类型=文本、运算符类型=符号本身、EOF=文件结束）
导入 容器::向量
导入 词法::关键字
导入 词法::运算符
导入 词法::扫描

公开:

// 分词：源码文本 -> token 描述行列表（"类型|文本|行"）
函数 分词(字符串 源码) -> 向量<字符串> {
    向量<字符串> 输出 = 向量<字符串>()
    整64 位置 = 0
    整64 行号 = 1
    整64 长度 = 字符串长度(源码)
    字符串 上一文本 = ""
    当 (位置 < 长度) {
        整64 字节 = 字节值(源码, 位置)
        // ---- 空白/换行 ----
        如果 (字节 == 10) {
            位置++
            行号++
            继续
        }
        如果 (字节 == 32 || 字节 == 9 || 字节 == 13) {
            位置++
            继续
        }
        // ---- 注释：// 行注释、/* 块注释 ----
        如果 (字节 == 47 && 位置 + 1 < 长度 && 字节值(源码, 位置 + 1) == 47) {
            位置 += 2
            当 (位置 < 长度 && 字节值(源码, 位置) != 10) {
                位置++
            }
            继续
        }
        如果 (字节 == 47 && 位置 + 1 < 长度 && 字节值(源码, 位置 + 1) == 42) {
            位置 += 2
            当 (位置 + 1 < 长度 && !(字节值(源码, 位置) == 42 && 字节值(源码, 位置 + 1) == 47)) {
                如果 (字节值(源码, 位置) == 10) {
                    行号++
                }
                位置++
            }
            如果 (位置 + 1 < 长度) {
                位置 += 2
            }
            继续
        }
        // ---- 字符串/字符/原始/多行 前缀 ----
        如果 (字节 == 34) {
            // 注意：CN 字符串 == 按指针地址比较（规格书 10.3 字符串不参与运算符
            //   比较），前缀判定必须用 字符串比较（相等语义）
            布尔 原始前缀 = 字符串比较(上一文本, "原始")
            布尔 多行前缀 = 字符串比较(上一文本, "多行")
            整64 新位置 = 扫描字符串(源码, 位置, 长度, 原始前缀, 多行前缀, 输出, 行号)
            位置 = 新位置
            上一文本 = ""
            继续
        }
        如果 (字节 == 39) {
            整64 新位置2 = 扫描字符(源码, 位置, 长度, 输出, 行号)
            位置 = 新位置2
            上一文本 = ""
            继续
        }
        // ---- 数字字面量 ----
        如果 (是数字(字节)) {
            字符串 文本 = ""
            整64 新位置3 = 扫描数字(源码, 位置, 长度, 文本)
            如果 (字符串包含(文本, ".") || 字符串包含(文本, "e") || 字符串包含(文本, "E")) {
                记录(输出, "浮点字面量", 文本, 行号)
            } 否则 {
                记录(输出, "整数字面量", 文本, 行号)
            }
            位置 = 新位置3
            上一文本 = ""
            继续
        }
        // ---- 标识符 / 关键字 ----
        如果 (是字母(字节)) {
            整64 起点 = 位置
            位置++
            当 (位置 < 长度) {
                整64 继续字节 = 字节值(源码, 位置)
                如果 (!(是字母(继续字节) || 是数字(继续字节))) {
                    中断
                }
                位置++
            }
            字符串 名称 = 字符串子串(源码, 起点, 位置 - 起点)
            字符串 关键字 = 查找关键字(名称)
            如果 (字符串长度(关键字) > 0) {
                记录(输出, 关键字, 关键字, 行号)
            } 否则 {
                记录(输出, "标识符", 名称, 行号)
            }
            上一文本 = 名称
            继续
        }
        // ---- 运算符 / 分隔符 ----
        字符串 符号 = 匹配运算符(源码, 位置, 长度)
        如果 (字符串长度(符号) > 0) {
            // 管道系运算符（| || |=）类型段含 "|"，与 "类型|文本|行" 分隔符歧义
            // （记号类型按首个 | 切分得空串，解析器无法识别）——统一改用 符号 类型
            字符串 类型 = 符号
            如果 (字符串比较(符号, "|") || 字符串比较(符号, "||") ||
                 字符串比较(符号, "|=")) {
                类型 = "符号"
            }
            记录(输出, 类型, 符号, 行号)
            位置 += 字符串长度(符号)
            上一文本 = ""
            继续
        }
        // ---- 未知字符：跳过（容错） ----
        位置++
        上一文本 = ""
    }
    记录(输出, "文件结束", "", 行号)
    返回 输出
}

// ==================== 门面保留辅助 ====================

公开:
// 取源码位置的字节值（0..255，UTF-8 字节视图）
// 注：字节值 被 代码生成.cn 引用（导入 词法分析::字节值），必须保留在门面
函数 字节值(字符串 源码, 整64 位置) -> 整64 {
    整64 值 = 整64(源码[位置])
    如果 (值 < 0) {
        返回 值 + 256
    }
    返回 值
}

公开:
// 追加一行 token 描述（"类型|文本|行"）
// 注：向量 为类对象（指针语义），按值传参即地址拷贝（自举 Task 7.1：泛型容器
//   引用参数 的签名解析尚未对齐，按值等价且无性能损失）
// 注：记录 被 词法/扫描.cn 子模块调用（扫描字符串/扫描字符），须公开
函数 记录(向量<字符串> 输出, 字符串 类型, 字符串 文本, 整64 行号) -> 空类型 {
    // 内部辅助统一 公开（2026-08 自举实测：私有函数调用在跨模块合并后
    //   链接符号缺模块前缀——A-5 纯名解析差异；自举模块为库形态，公开合理）
    结果<空类型, 整32> 加 = 输出.追加(类型 + "|" + 文本 + "|" + 整数转字符串(行号))
    如果 (!加.正常) {
        运行时错误(4)
    }
}
