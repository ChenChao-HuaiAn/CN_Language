// 自举 Task 7.4 v2：CN IR 生成器（分词->解析->三地址 IR，供 代码生成.cn 生成 x64 MASM）
// 行格式：函数|符号|参数数 参数|名[|引用] 分配|名 字面量|值 字符串|原文 加载/压址/存储|名
导入 容器::向量
导入 词法分析::分词
导入 语法分析::解析
公开:
函数 IR生成(字符串 源码, 字符串 模块名) -> 向量<字符串> {
    向量<字符串> 输出 = 向量<字符串>()
    向量<字符串> AST行 = 解析(源码)
    向量<字符串> 签名表 = 向量<字符串>()
    收集签名(AST行, 签名表)
    生成(AST行, 模块名, 签名表, 输出)
    返回 输出
}
函数 行类型(字符串 行) -> 字符串 {
    整64 起 = 0
    布尔 空格 = 字符串比较(字符串子串(行, 0, 1), " ")
    当 (起 < 字符串长度(行) && 空格) {
        起++
        空格 = 字符串比较(字符串子串(行, 起, 1), " ")
    }
    整64 位 = 字符串查找(行, "|")
    如果 (位 < 0) {
        返回 字符串子串(行, 起, 字符串长度(行) - 起)
    }
    返回 字符串子串(行, 起, 位 - 起)
}
函数 行文本(字符串 行) -> 字符串 {
    整64 位 = 字符串查找(行, "|")
    如果 (位 < 0) {
        返回 ""
    }
    返回 字符串子串(行, 位 + 1, 字符串长度(行) - 位 - 1)
}
函数 行深度(字符串 行) -> 整64 {
    整64 起 = 0
    当 (起 < 字符串长度(行) && 字符串比较(字符串子串(行, 起, 1), " ")) {
        起++
    }
    返回 起 / 2
}
函数 列表追加(向量<字符串> 列表, 字符串 值) -> 空类型 {
    结果<空类型, 整32> 加 = 列表.追加(值)
    如果 (!加.正常) {
        运行时错误(4)
    }
}
函数 函数名(字符串 文本) -> 字符串 {
    整64 分隔 = 字符串查找(文本, "|参数数=")
    如果 (分隔 < 0) { 返回 文本 }
    返回 字符串子串(文本, 0, 分隔)
}
函数 参数数(字符串 文本) -> 字符串 {
    整64 分隔 = 字符串查找(文本, "参数数=")
    如果 (分隔 < 0) { 返回 "0" }
    返回 字符串子串(文本, 分隔 + 10, 字符串长度(文本) - 分隔 - 10)
}
函数 解析整数(字符串 文本) -> 整64 {
    整64 值 = 0
    整64 i = 0
    当 (i < 字符串长度(文本)) {
        整64 字节 = 字节值(文本, i)
        如果 (字节 >= 48 && 字节 <= 57) {
            值 = 值 * 10 + 字节 - 48
        }
        i++
    }
    返回 值
}
函数 下一类型(向量<字符串> AST行, 整64 位置) -> 字符串 {
    如果 (位置 < AST行.大小()) {
        返回 行类型(AST行.元素(位置))
    }
    返回 ""
}
函数 下一文本(向量<字符串> AST行, 整64 位置) -> 字符串 {
    如果 (位置 < AST行.大小()) {
        返回 行文本(AST行.元素(位置))
    }
    返回 ""
}
函数 成员名(字符串 文本) -> 字符串 {
    整64 位 = 字符串查找(文本, "|")
    如果 (位 >= 0) {
        返回 字符串子串(文本, 位 + 1, 字符串长度(文本) - 位 - 1)
    }
    如果 (字符串长度(文本) > 1) {
        返回 字符串子串(文本, 1, 字符串长度(文本) - 1)
    }
    返回 文本
}
函数 收集签名(向量<字符串> AST行, 向量<字符串> 签名表) -> 空类型 {
    整64 位置 = 0
    当 (位置 < AST行.大小()) {
        字符串 行 = AST行.元素(位置)
        字符串 类型 = 行类型(行)
        如果 (字符串比较(类型, "函数") || 字符串比较(类型, "方法")) {
            整64 深 = 行深度(行)
            字符串 名 = 函数名(行文本(行))
            字符串 位图 = ""
            字符串 返回码 = "未"
            字符串 参数码 = ""
            整64 j = 位置 + 1
            当 (j < AST行.大小()) {
                字符串 子行 = AST行.元素(j)
                整64 子深 = 行深度(子行)
                如果 (子深 <= 深) {
                    中断
                }
                字符串 子类型 = 行类型(AST行.元素(j))
                如果 (字符串比较(子类型, "参数")) {
                    整64 参数深 = 行深度(AST行.元素(j))
                    布尔 引用 = 假
                    字符串 参数类型名 = "未"
                    整64 k = j + 1
                    当 (k < AST行.大小()) {
                        字符串 子行k = AST行.元素(k)
                        整64 子深k = 行深度(子行k)
                        如果 (子深k <= 参数深) {
                            中断
                        }
                        如果 (字符串比较(行类型(AST行.元素(k)), "类型后缀") &&
                             字符串比较(行文本(AST行.元素(k)), "&")) {
                            引用 = 真
                        }
                        如果 (字符串比较(行类型(AST行.元素(k)), "类型")) {
                            参数类型名 = 行文本(AST行.元素(k))
                        }
                        k++
                    }
                    如果 (引用) { 位图 = 位图 + "1" } 否则 { 位图 = 位图 + "0" }
                    字符串 参码 = 链接类型码(参数类型名)
                    如果 (引用) {
                        参码 = "A" + 参码
                    }
                    参数码 = 参数码 + 参码
                } 否则 如果 (字符串比较(子类型, "返回类型")) {
                    整64 返深 = 行深度(AST行.元素(j))
                    整64 k = j + 1
                    当 (k < AST行.大小()) {
                        字符串 子行r = AST行.元素(k)
                        整64 子深r = 行深度(子行r)
                        如果 (子深r <= 返深) {
                            中断
                        }
                        如果 (字符串比较(行类型(AST行.元素(k)), "类型")) {
                            返回码 = 类型码(行文本(AST行.元素(k)))
                        }
                        k++
                    }
                }
                j++
            }
            列表追加(签名表, 名 + "|" + 位图 + "|" + 返回码 + "|" + 参数码)
        }
        位置++
    }
}
函数 类型码(字符串 类型名) -> 字符串 {
    如果 (字符串比较(类型名, "字符串") || 字符串比较(类型名, "字符*")) {
        返回 "字"
    }
    如果 (字符串比较(类型名, "向量")) {
        返回 "向"
    }
    如果 (字符串比较(类型名, "空类型")) {
        返回 "空"
    }
    返回 "整"
}
函数 链接类型码(字符串 类型名) -> 字符串 {
    如果 (字符串比较(类型名, "空类型")) {
        返回 "X"
    }
    如果 (字符串比较(类型名, "布尔")) {
        返回 "_N"
    }
    如果 (字符串比较(类型名, "字符")) {
        返回 "D"
    }
    如果 (字符串比较(类型名, "整8")) {
        返回 "C"
    }
    如果 (字符串比较(类型名, "正8")) {
        返回 "E"
    }
    如果 (字符串比较(类型名, "整16")) {
        返回 "F"
    }
    如果 (字符串比较(类型名, "正16")) {
        返回 "G"
    }
    如果 (字符串比较(类型名, "整32")) {
        返回 "H"
    }
    如果 (字符串比较(类型名, "正32")) {
        返回 "I"
    }
    如果 (字符串比较(类型名, "整64")) {
        返回 "J"
    }
    如果 (字符串比较(类型名, "正64")) {
        返回 "K"
    }
    如果 (字符串比较(类型名, "整128")) {
        返回 "_M"
    }
    如果 (字符串比较(类型名, "正128")) {
        返回 "_O"
    }
    如果 (字符串比较(类型名, "浮32")) {
        返回 "M"
    }
    如果 (字符串比较(类型名, "浮64")) {
        返回 "N"
    }
    如果 (字符串比较(类型名, "字符串") || 字符串比较(类型名, "字符*")) {
        返回 "PAX"
    }
    如果 (字符串比较(类型名, "空类型*")) {
        返回 "PEX"
    }
    如果 (字符串比较(类型名, "向量")) {
        返回 "_TE59091E9878F24E5AD97E7ACA6E4B8B2"
    }
    如果 (字符串长度(类型名) > 1 &&
         字符串比较(字符串子串(类型名, 字符串长度(类型名) - 1, 1), "*")) {
        返回 "PE" + 链接类型码(字符串子串(类型名, 0, 字符串长度(类型名) - 1))
    }
    返回 ""
}
函数 查找签名(向量<字符串> 签名表, 字符串 名) -> 字符串 {
    整64 i = 0
    当 (i < 签名表.大小()) {
        字符串 记录 = 签名表.元素(i)
        如果 (字符串查找(记录, 名 + "|") == 0) {
            返回 行文本(记录)
        }
        i++
    }
    返回 ""
}
函数 是引用位(字符串 位图, 整64 i) -> 布尔 {
    如果 (i >= 字符串长度(位图)) {
        返回 假
    }
    返回 字节值(位图, i) == 49
}
函数 签名返回码(字符串 签名) -> 字符串 {
    整64 位 = 字符串查找(签名, "|")
    如果 (位 < 0) {
        返回 "未"
    }
    返回 字符串子串(签名, 位 + 1, 字符串长度(签名) - 位 - 1)
}
函数 签名参数码(字符串 签名) -> 字符串 {
    整64 位1 = 字符串查找(签名, "|")
    如果 (位1 < 0) {
        返回 ""
    }
    整64 位2 = 字符串查找(字符串子串(签名, 位1 + 1, 字符串长度(签名) - 位1 - 1), "|")
    如果 (位2 < 0) {
        返回 ""
    }
    返回 字符串子串(签名, 位1 + 位2 + 2, 字符串长度(签名) - 位1 - 位2 - 2)
}
函数 查类型(向量<字符串> 类型表, 字符串 名) -> 字符串 {
    整64 i = 0
    当 (i < 类型表.大小()) {
        字符串 记录 = 类型表.元素(i)
        如果 (字符串查找(记录, 名 + "|") == 0) {
            返回 行文本(记录)
        }
        i++
    }
    返回 "未"
}
函数 记类型(向量<字符串> 类型表, 字符串 名, 字符串 码) -> 空类型 {
    列表追加(类型表, 名 + "|" + 码)
}
函数 类型压入(向量<字符串> 类型栈, 字符串 码) -> 空类型 {
    列表追加(类型栈, 码)
}
函数 类型弹出(向量<字符串> 类型栈) -> 空类型 {
    整64 层数 = 类型栈.大小()
    如果 (层数 > 0) {
        整64 索引 = 层数 - 1
        结果<空类型, 整32> 删 = 类型栈.删除(索引)
        如果 (!删.正常) {
            运行时错误(4)
        }
    }
}
函数 类型栈顶(向量<字符串> 类型栈) -> 字符串 {
    如果 (类型栈.大小() > 0) {
        返回 类型栈.元素(类型栈.大小() - 1)
    }
    返回 "未"
}
函数 调用符号(字符串 名, 字符串 模块名) -> 字符串 {
    如果 (字符串比较(名, "字符串长度")) { 返回 "__cn_str_len" }
    如果 (字符串比较(名, "字符串比较")) { 返回 "__cn_str_eq" }
    如果 (字符串比较(名, "字符串查找")) { 返回 "__cn_str_find" }
    如果 (字符串比较(名, "字符串子串")) { 返回 "__cn_str_sub" }
    如果 (字符串比较(名, "字符串包含")) { 返回 "__cn_str_contains" }
    如果 (字符串比较(名, "整数转字符串")) { 返回 "__cn_str_from_int" }
    如果 (字符串比较(名, "字符转字符串")) { 返回 "__cn_str_from_char" }
    如果 (字符串比较(名, "打印")) { 返回 "printLine" }
    如果 (字符串比较(名, "打印行")) { 返回 "printNoLine" }
    如果 (字符串比较(名, "运行时错误")) { 返回 "__cn_runtime_error" }
    如果 (字符串比较(名, "分词")) { 返回 "词法分析$分词" }
    如果 (字符串比较(名, "解析")) { 返回 "语法分析$解析" }
    如果 (字符串比较(名, "字节值")) { 返回 "词法分析$字节值" }
    返回 模块名 + "$" + 名
}
函数 内置返回码(字符串 名) -> 字符串 {
    如果 (字符串比较(名, "字符串长度")) { 返回 "整" }
    如果 (字符串比较(名, "字符串比较")) { 返回 "整" }
    如果 (字符串比较(名, "字符串查找")) { 返回 "整" }
    如果 (字符串比较(名, "字符串子串")) { 返回 "字" }
    如果 (字符串比较(名, "字符串包含")) { 返回 "整" }
    如果 (字符串比较(名, "整数转字符串")) { 返回 "字" }
    如果 (字符串比较(名, "字符转字符串")) { 返回 "字" }
    如果 (字符串比较(名, "打印")) { 返回 "空" }
    如果 (字符串比较(名, "打印行")) { 返回 "空" }
    如果 (字符串比较(名, "运行时错误")) { 返回 "空" }
    返回 "未"
}
函数 调用返回码(字符串 名, 向量<字符串> 签名表) -> 字符串 {
    字符串 内置 = 内置返回码(名)
    如果 (!字符串比较(内置, "未")) {
        返回 内置
    }
    字符串 签名 = 查找签名(签名表, 名)
    如果 (字符串长度(签名) > 0) {
        返回 签名返回码(签名)
    }
    返回 "未"
}
函数 生成(向量<字符串> AST行, 字符串 模块名, 向量<字符串> 签名表,
          向量<字符串> 输出) -> 空类型 {
    整64 位置 = 0
    当 (位置 < AST行.大小()) {
        字符串 行 = AST行.元素(位置)
        字符串 类型 = 行类型(行)
        如果 (字符串比较(类型, "函数") || 字符串比较(类型, "方法")) {
            整64 深 = 行深度(行)
            向量<字符串> 类型表 = 向量<字符串>()
            向量<字符串> 类型栈 = 向量<字符串>()
            字符串 函数符号 = 函数名(行文本(行))
            字符串 签名行 = 查找签名(签名表, 函数符号)
            字符串 函数参数码 = 签名参数码(签名行)
            如果 (!字符串比较(函数符号, "主")) {
                函数符号 = 模块名 + "$" + 函数符号
            }
            列表追加(输出, "函数|" + 函数符号 + "|" + 参数数(行文本(行)) + "|" + 函数参数码)
            位置++
            位置 = 处理序列(AST行, 位置, 深 + 1, 模块名, 签名表, 类型表, 类型栈,
                           输出, "", "")
            列表追加(输出, "返回空")
        } 否则 {
            位置++
        }
    }
}
函数 处理序列(向量<字符串> AST行, 整64 位置, 整64 深度, 字符串 模块名,
             向量<字符串> 签名表, 向量<字符串> 类型表, 向量<字符串> 类型栈,
             向量<字符串> 输出, 字符串 循环开始, 字符串 循环结束) -> 整64 {
    当 (位置 < AST行.大小()) {
        字符串 子行0 = AST行.元素(位置)
        整64 子深0 = 行深度(子行0)
        如果 (子深0 < 深度) {
            中断
        }
        位置 = 处理节点(AST行, 位置, 子深0, 模块名, 签名表,
                       类型表, 类型栈, 输出, 循环开始, 循环结束)
    }
    返回 位置
}
函数 处理节点(向量<字符串> AST行, 整64 位置, 整64 深, 字符串 模块名,
             向量<字符串> 签名表, 向量<字符串> 类型表, 向量<字符串> 类型栈,
             向量<字符串> 输出, 字符串 循环开始, 字符串 循环结束) -> 整64 {
    字符串 行 = AST行.元素(位置)
    字符串 类型 = 行类型(行)
    字符串 文本 = 行文本(行)
    如果 (字符串比较(类型, "块")) {
        返回 处理序列(AST行, 位置 + 1, 深 + 1, 模块名, 签名表, 类型表, 类型栈,
                    输出, 循环开始, 循环结束)
    }
    如果 (字符串比较(类型, "参数")) {
        返回 处理节点参数(AST行, 位置, 深, 类型表, 输出)
    }
    如果 (字符串比较(类型, "变量")) {
        返回 处理节点变量(AST行, 位置, 深, 模块名, 签名表, 类型表, 类型栈,
                       输出, 循环开始, 循环结束)
    }
    如果 (字符串比较(类型, "返回")) {
        返回 处理节点返回(AST行, 位置, 深, 模块名, 签名表, 类型表, 类型栈,
                       输出, 循环开始, 循环结束)
    }
    如果 (字符串比较(类型, "跳转")) {
        返回 处理节点跳转(位置, 文本, 输出, 循环开始, 循环结束)
    }
    如果 (字符串比较(类型, "如果")) {
        返回 处理节点如果(AST行, 位置, 深, 模块名, 签名表, 类型表, 类型栈,
                       输出, 循环开始, 循环结束)
    }
    如果 (字符串比较(类型, "当")) {
        返回 处理节点当(AST行, 位置, 深, 模块名, 签名表, 类型表, 类型栈,
                     输出, 循环开始, 循环结束)
    }
    如果 (字符串比较(类型, "选择")) {
        返回 处理节点选择(AST行, 位置, 深, 模块名, 签名表, 类型表, 类型栈,
                       输出, 循环开始, 循环结束)
    }
    如果 (字符串比较(类型, "标识符") && 位置 + 1 < AST行.大小()) {
        字符串 下一 = 行类型(AST行.元素(位置 + 1))
        如果 (字符串比较(下一, "二元") && 位置 + 2 < AST行.大小() &&
             字符串比较(行文本(AST行.元素(位置 + 1)), "<") &&
             字符串比较(行类型(AST行.元素(位置 + 2)), "二元") &&
             字符串比较(行文本(AST行.元素(位置 + 2)), ">")) {
            返回 位置 + 3   // 模板工件三重跳过（声明类型名）
        }
        如果 (字符串比较(下一, "赋值")) {
            返回 处理节点赋值(AST行, 位置, 深, 模块名, 签名表, 类型表, 类型栈,
                           输出, 循环开始, 循环结束)
        }
        如果 (字符串比较(下一, "后缀")) {
            返回 处理节点递增(AST行, 位置, 文本, 输出)
        }
    }
    如果 (字符串比较(类型, "二元") && 位置 + 1 < AST行.大小() &&
         字符串比较(文本, "<") && 字符串比较(行类型(AST行.元素(位置 + 1)), "变量")) {
        返回 位置 + 1   // 模板工件：结果<空类型,整32> 加 = ...
    }
    如果 (是表达式节点(AST行, 位置)) {
        位置 = 处理表达式单(AST行, 位置, 深, 模块名, 签名表, 类型表, 类型栈,
                         输出, 循环开始, 循环结束)
        如果 (!末行是结构调用(输出)) {
            列表追加(输出, "运算|弹出")
            类型弹出(类型栈)
        }
        返回 位置
    }
    返回 位置 + 1
}
函数 处理节点参数(向量<字符串> AST行, 整64 位置, 整64 深,
               向量<字符串> 类型表, 向量<字符串> 输出) -> 整64 {
    字符串 文本 = 行文本(AST行.元素(位置))
    布尔 引用 = 假
    字符串 参数类型 = "未"
    整64 j = 位置 + 1
    当 (j < AST行.大小()) {
                字符串 子行 = AST行.元素(j)
                整64 子深 = 行深度(子行)
                如果 (子深 <= 深) {
                    中断
                }
        字符串 子类型 = 行类型(AST行.元素(j))
        如果 (字符串比较(子类型, "类型后缀") && 字符串比较(行文本(AST行.元素(j)), "&")) {
            引用 = 真
        }
        如果 (字符串比较(子类型, "类型")) {
            参数类型 = 类型码(行文本(AST行.元素(j)))
        }
        j++
    }
    记类型(类型表, 文本, 参数类型)
    如果 (引用) {
        列表追加(输出, "参数|" + 文本 + "|引用")
    } 否则 {
        列表追加(输出, "参数|" + 文本)
    }
    返回 位置 + 1
}
函数 处理节点变量(向量<字符串> AST行, 整64 位置, 整64 深, 字符串 模块名,
               向量<字符串> 签名表, 向量<字符串> 类型表, 向量<字符串> 类型栈,
               向量<字符串> 输出, 字符串 循环开始, 字符串 循环结束) -> 整64 {
    字符串 文本 = 行文本(AST行.元素(位置))
    字符串 变量类型 = "未"
    整64 j = 位置 + 1
    当 (j < AST行.大小()) {
                字符串 子行 = AST行.元素(j)
                整64 子深 = 行深度(子行)
                如果 (子深 <= 深) {
                    中断
                }
        字符串 子类型 = 行类型(AST行.元素(j))
        如果 (字符串比较(子类型, "类型")) {
            变量类型 = 类型码(行文本(AST行.元素(j)))
        }
        如果 (!字符串比较(子类型, "类型") && !字符串比较(子类型, "类型后缀")) {
            中断
        }
        j++
    }
    记类型(类型表, 文本, 变量类型)
    列表追加(输出, "分配|" + 文本)
    如果 (j < AST行.大小() && 行深度(AST行.元素(j)) > 深) {
        位置 = 处理表达式(AST行, j, 深, 模块名, 签名表, 类型表, 类型栈,
                       输出, 循环开始, 循环结束)
        如果 (末行是结构调用(输出)) {
            列表追加(输出, "复制结果|" + 文本)
        } 否则 {
            列表追加(输出, "存储|" + 文本)
            类型弹出(类型栈)
        }
    } 否则 {
        位置 = j
    }
    返回 位置
}
函数 处理节点返回(向量<字符串> AST行, 整64 位置, 整64 深, 字符串 模块名,
               向量<字符串> 签名表, 向量<字符串> 类型表, 向量<字符串> 类型栈,
               向量<字符串> 输出, 字符串 循环开始, 字符串 循环结束) -> 整64 {
    如果 (位置 + 1 < AST行.大小() && 行深度(AST行.元素(位置 + 1)) > 深) {
        位置 = 处理表达式(AST行, 位置 + 1, 深, 模块名, 签名表, 类型表,
                       类型栈, 输出, 循环开始, 循环结束)
        列表追加(输出, "返回")
        类型弹出(类型栈)
    } 否则 {
        列表追加(输出, "返回空")
        位置++
    }
    返回 位置
}
函数 处理节点跳转(整64 位置, 字符串 文本, 向量<字符串> 输出,
               字符串 循环开始, 字符串 循环结束) -> 整64 {
    如果 (字符串比较(文本, "中断")) {
        如果 (字符串长度(循环结束) > 0) {
            列表追加(输出, "跳转|" + 循环结束)
        }
    } 否则 {
        如果 (字符串长度(循环开始) > 0) {
            列表追加(输出, "跳转|" + 循环开始)
        }
    }
    返回 位置 + 1
}
函数 处理节点如果(向量<字符串> AST行, 整64 位置, 整64 深, 字符串 模块名,
               向量<字符串> 签名表, 向量<字符串> 类型表, 向量<字符串> 类型栈,
               向量<字符串> 输出, 字符串 循环开始, 字符串 循环结束) -> 整64 {
    字符串 结束标签 = "L" + 整数转字符串(位置) + "e"
    字符串 否则标签 = "L" + 整数转字符串(位置) + "x"
    位置 = 处理表达式(AST行, 位置 + 1, 深, 模块名, 签名表, 类型表, 类型栈,
                   输出, 循环开始, 循环结束)
    列表追加(输出, "跳转假|" + 否则标签)
    类型弹出(类型栈)
    位置 = 处理序列(AST行, 位置, 深 + 1, 模块名, 签名表, 类型表, 类型栈,
                   输出, 循环开始, 循环结束)
    列表追加(输出, "跳转|" + 结束标签)
    列表追加(输出, "标签|" + 否则标签)
    如果 (位置 < AST行.大小()) {
        字符串 子行4 = AST行.元素(位置)
        整64 子深4 = 行深度(子行4)
        如果 (子深4 == 深 && 字符串比较(行类型(子行4), "否则")) {
        位置++
        如果 (位置 < AST行.大小()) {
            字符串 子行5 = AST行.元素(位置)
            整64 子深5 = 行深度(子行5)
            如果 (子深5 == 深 && 字符串比较(行类型(子行5), "如果")) {
            位置 = 处理节点(AST行, 位置, 深, 模块名, 签名表, 类型表, 类型栈,
                         输出, 循环开始, 循环结束)
        } 否则 {
            位置 = 处理序列(AST行, 位置, 深 + 1, 模块名, 签名表, 类型表,
                           类型栈, 输出, 循环开始, 循环结束)
        }
        }
        }
    }
    列表追加(输出, "标签|" + 结束标签)
    返回 位置
}
函数 处理节点当(向量<字符串> AST行, 整64 位置, 整64 深, 字符串 模块名,
             向量<字符串> 签名表, 向量<字符串> 类型表, 向量<字符串> 类型栈,
             向量<字符串> 输出, 字符串 循环开始, 字符串 循环结束) -> 整64 {
    字符串 开始标签 = "L" + 整数转字符串(位置) + "a"
    字符串 结束标签 = "L" + 整数转字符串(位置) + "b"
    列表追加(输出, "标签|" + 开始标签)
    位置 = 处理表达式(AST行, 位置 + 1, 深, 模块名, 签名表, 类型表, 类型栈,
                   输出, 循环开始, 循环结束)
    列表追加(输出, "跳转假|" + 结束标签)
    类型弹出(类型栈)
    位置 = 处理序列(AST行, 位置, 深 + 1, 模块名, 签名表, 类型表, 类型栈,
                   输出, 开始标签, 结束标签)
    列表追加(输出, "跳转|" + 开始标签)
    列表追加(输出, "标签|" + 结束标签)
    返回 位置
}
函数 处理节点选择(向量<字符串> AST行, 整64 位置, 整64 深, 字符串 模块名,
               向量<字符串> 签名表, 向量<字符串> 类型表, 向量<字符串> 类型栈,
               向量<字符串> 输出, 字符串 循环开始, 字符串 循环结束) -> 整64 {
    字符串 名 = "S" + 整数转字符串(位置)
    位置 = 处理表达式(AST行, 位置 + 1, 深, 模块名, 签名表, 类型表, 类型栈,
                   输出, 循环开始, 循环结束)
    整64 体计数 = 0
    整64 后计数 = 0
    字符串 后标签 = ""
    当 (位置 < AST行.大小()) {
        字符串 行2 = AST行.元素(位置)
        如果 (行深度(行2) != 深) {
            中断
        }
        字符串 类型2 = 行类型(行2)
        如果 (字符串比较(类型2, "情况")) {
            位置 = 处理情况(AST行, 位置, 深, 名, 体计数, 后计数, 后标签, 模块名,
                         签名表, 类型表, 类型栈, 输出, 循环开始, 循环结束)
        } 否则 如果 (字符串比较(类型2, "默认")) {
            位置 = 处理默认(AST行, 位置, 深, 名, 后标签, 模块名, 签名表,
                          类型表, 类型栈, 输出, 循环开始, 循环结束)
            中断
        } 否则 {
            中断
        }
    }
    如果 (字符串长度(后标签) > 0) {
        列表追加(输出, "标签|" + 后标签)
    }
    列表追加(输出, "标签|L" + 名 + "z")
    列表追加(输出, "运算|弹出")
    类型弹出(类型栈)
    返回 位置
}
函数 处理情况(向量<字符串> AST行, 整64 位置, 整64 深, 字符串 名,
            整64& 体计数, 整64& 后计数, 字符串& 后标签, 字符串 模块名,
            向量<字符串> 签名表, 向量<字符串> 类型表, 向量<字符串> 类型栈,
            向量<字符串> 输出, 字符串 循环开始, 字符串 循环结束) -> 整64 {
    字符串 文本2 = 行文本(AST行.元素(位置))
    如果 (字符串长度(后标签) > 0) {
        列表追加(输出, "标签|" + 后标签)
        后标签 = ""
    }
    字符串 体标签 = "L" + 名 + "b" + 整数转字符串(体计数)
    列表追加(输出, "运算|复制栈顶")
    类型压入(类型栈, 类型栈顶(类型栈))
    如果 (字符串比较(字符串子串(文本2, 0, 1), "\"")) {
        列表追加(输出, "字符串|" + 文本2)
        类型压入(类型栈, "字")
        列表追加(输出, "调用|__cn_str_eq|2|0")
        类型弹出(类型栈)
        类型弹出(类型栈)
        类型压入(类型栈, "整")
    } 否则 {
        列表追加(输出, "字面量|" + 文本2)
        类型压入(类型栈, "整")
        列表追加(输出, "运算|==")
        类型弹出(类型栈)
        类型弹出(类型栈)
        类型压入(类型栈, "整")
    }
    列表追加(输出, "跳转真|" + 体标签)
    类型弹出(类型栈)
    位置++
    如果 (位置 < AST行.大小()) {
        字符串 子行6 = AST行.元素(位置)
        整64 子深6 = 行深度(子行6)
        如果 (子深6 > 深) {
        后计数++
        列表追加(输出, "跳转|L" + 名 + "h" + 整数转字符串(后计数))
        列表追加(输出, "标签|" + 体标签)
        位置 = 处理序列(AST行, 位置, 深 + 1, 模块名, 签名表, 类型表, 类型栈,
                       输出, 循环开始, 循环结束)
        体计数++
        后标签 = "L" + 名 + "h" + 整数转字符串(后计数)
        }
    }
    返回 位置
}
函数 处理默认(向量<字符串> AST行, 整64 位置, 整64 深, 字符串 名,
            字符串& 后标签, 字符串 模块名, 向量<字符串> 签名表,
            向量<字符串> 类型表, 向量<字符串> 类型栈, 向量<字符串> 输出,
            字符串 循环开始, 字符串 循环结束) -> 整64 {
    如果 (字符串长度(后标签) > 0) {
        列表追加(输出, "标签|" + 后标签)
        后标签 = ""
    }
    列表追加(输出, "标签|L" + 名 + "d")
    位置++
    返回 处理序列(AST行, 位置, 深 + 1, 模块名, 签名表, 类型表, 类型栈,
                 输出, 循环开始, 循环结束)
}
函数 处理节点赋值(向量<字符串> AST行, 整64 位置, 整64 深, 字符串 模块名,
               向量<字符串> 签名表, 向量<字符串> 类型表, 向量<字符串> 类型栈,
               向量<字符串> 输出, 字符串 循环开始, 字符串 循环结束) -> 整64 {
    字符串 文本 = 行文本(AST行.元素(位置))
    字符串 赋值文本 = 行文本(AST行.元素(位置 + 1))
    整64 赋值深 = 行深度(AST行.元素(位置 + 1))
    如果 (字符串比较(赋值文本, "=") && 字符串比较(查类型(类型表, 文本), "未")) {
        列表追加(输出, "分配|" + 文本)
        记类型(类型表, 文本, "向")
    }
    如果 (!字符串比较(赋值文本, "=")) {
        列表追加(输出, "加载|" + 文本)
        类型压入(类型栈, 查类型(类型表, 文本))
    }
    位置 = 位置 + 2
    位置 = 处理表达式(AST行, 位置, 赋值深, 模块名, 签名表, 类型表, 类型栈,
                   输出, 循环开始, 循环结束)
    如果 (字符串比较(赋值文本, "=")) {
        如果 (末行是结构调用(输出)) {
            列表追加(输出, "复制结果|" + 文本)
        } 否则 {
            列表追加(输出, "存储|" + 文本)
            类型弹出(类型栈)
        }
    } 否则 {
        列表追加(输出, "运算|" + 赋值文本)
        类型弹出(类型栈)
        类型弹出(类型栈)
        类型压入(类型栈, "整")
        列表追加(输出, "存储|" + 文本)
        类型弹出(类型栈)
    }
    返回 位置
}
函数 处理节点递增(向量<字符串> AST行, 整64 位置, 字符串 文本,
               向量<字符串> 输出) -> 整64 {
    字符串 后缀文本 = 行文本(AST行.元素(位置 + 1))
    如果 (字符串比较(后缀文本, "++")) {
        列表追加(输出, "递增|" + 文本)
    } 否则 {
        列表追加(输出, "递减|" + 文本)
    }
    返回 位置 + 2
}
函数 是表达式节点(向量<字符串> AST行, 整64 位置) -> 布尔 {
    字符串 行 = AST行.元素(位置)
    字符串 类型 = 行类型(行)
    如果 (字符串比较(类型, "标识符")) {
        字符串 下一 = 下一类型(AST行, 位置 + 1)
        如果 (字符串比较(下一, "赋值") || 字符串比较(下一, "后缀")) {
            返回 假
        }
        返回 真
    }
    如果 (字符串比较(类型, "二元")) {
        如果 (位置 + 1 < AST行.大小() && 字符串比较(行文本(行), "<") &&
             字符串比较(行类型(AST行.元素(位置 + 1)), "变量")) {
            返回 假
        }
        返回 真
    }
    返回 字符串比较(类型, "字面量") || 字符串比较(类型, "一元") ||
          字符串比较(类型, "强制转换") || 字符串比较(类型, "三元")
}
函数 末行是结构调用(向量<字符串> 输出) -> 布尔 {
    如果 (输出.大小() < 1) {
        返回 假
    }
    字符串 行 = 输出.元素(输出.大小() - 1)
    如果 (!字符串比较(行类型(行), "调用")) {
        返回 假
    }
    字符串 细节 = 行文本(行)
    字符串 细节2 = 行文本(细节)
    字符串 细节3 = 行文本(细节2)
    字符串 标志 = 行类型(细节3)
    返回 字符串比较(标志, "2")
}
函数 处理表达式(向量<字符串> AST行, 整64 位置, 整64 深度, 字符串 模块名,
               向量<字符串> 签名表, 向量<字符串> 类型表, 向量<字符串> 类型栈,
               向量<字符串> 输出, 字符串 循环开始, 字符串 循环结束) -> 整64 {
    当 (位置 < AST行.大小()) {
        字符串 子行7 = AST行.元素(位置)
        整64 子深7 = 行深度(子行7)
        如果 (子深7 <= 深度) {
            中断
        }
        如果 (!是表达式节点(AST行, 位置)) {
            中断
        }
        位置 = 处理表达式单(AST行, 位置, 子深7, 模块名,
                          签名表, 类型表, 类型栈, 输出, 循环开始, 循环结束)
    }
    返回 位置
}
函数 处理表达式单(向量<字符串> AST行, 整64 位置, 整64 深, 字符串 模块名,
                 向量<字符串> 签名表, 向量<字符串> 类型表, 向量<字符串> 类型栈,
                 向量<字符串> 输出, 字符串 循环开始, 字符串 循环结束) -> 整64 {
    字符串 行 = AST行.元素(位置)
    字符串 类型 = 行类型(行)
    字符串 文本 = 行文本(行)
    如果 (字符串比较(类型, "标识符")) {
        返回 处理标识符(AST行, 位置, 深, 模块名, 签名表, 类型表, 类型栈,
                      输出, 循环开始, 循环结束)
    }
    如果 (字符串比较(类型, "字面量")) {
        列表追加(输出, "字面量|" + 文本)
        如果 (字符串比较(字符串子串(文本, 0, 1), "\"")) {
            类型压入(类型栈, "字")
        } 否则 {
            类型压入(类型栈, "整")
        }
        返回 位置 + 1
    }
    如果 (字符串比较(类型, "二元")) {
        返回 处理二元节点(AST行, 位置, 深, 模块名, 签名表, 类型表, 类型栈,
                        输出, 循环开始, 循环结束)
    }
    如果 (字符串比较(类型, "一元")) {
        返回 处理一元节点(AST行, 位置, 深, 模块名, 签名表, 类型表, 类型栈,
                        输出, 循环开始, 循环结束)
    }
    如果 (字符串比较(类型, "强制转换")) {
        返回 处理表达式(AST行, 位置 + 1, 深, 模块名, 签名表, 类型表, 类型栈,
                       输出, 循环开始, 循环结束)
    }
    如果 (字符串比较(类型, "三元")) {
        位置 = 处理表达式(AST行, 位置 + 1, 深, 模块名, 签名表, 类型表, 类型栈,
                       输出, 循环开始, 循环结束)
        位置 = 处理表达式(AST行, 位置, 深, 模块名, 签名表, 类型表, 类型栈,
                       输出, 循环开始, 循环结束)
        位置 = 处理表达式(AST行, 位置, 深, 模块名, 签名表, 类型表, 类型栈,
                       输出, 循环开始, 循环结束)
        返回 位置
    }
    返回 位置
}
函数 处理标识符(向量<字符串> AST行, 整64 位置, 整64 深, 字符串 模块名,
              向量<字符串> 签名表, 向量<字符串> 类型表, 向量<字符串> 类型栈,
              向量<字符串> 输出, 字符串 循环开始, 字符串 循环结束) -> 整64 {
    字符串 行 = AST行.元素(位置)
    字符串 文本 = 行文本(行)
    字符串 下一 = 下一类型(AST行, 位置 + 1)
    如果 (字符串比较(下一, "调用")) {
        返回 处理调用(AST行, 位置, 深, 文本, 模块名, 签名表, 类型表,
                     类型栈, 输出, 循环开始, 循环结束)
    }
    如果 (字符串比较(下一, "成员")) {
        返回 处理成员节点(AST行, 位置, 深, 模块名, 签名表, 类型表, 类型栈,
                        输出, 循环开始, 循环结束)
    }
    如果 (字符串比较(下一, "下标")) {
        列表追加(输出, "加载|" + 文本)
        类型压入(类型栈, 查类型(类型表, 文本))
        整64 下标深 = 行深度(AST行.元素(位置 + 1))
        位置 = 处理表达式(AST行, 位置 + 2, 下标深, 模块名, 签名表, 类型表,
                       类型栈, 输出, 循环开始, 循环结束)
        列表追加(输出, "运算|下标字节")
        类型弹出(类型栈)
        类型弹出(类型栈)
        类型压入(类型栈, "整")
        返回 位置
    }
    如果 (字符串比较(下一, "二元")) {
        如果 (字符串比较(下一文本(AST行, 位置 + 1), "<") &&
             字符串比较(下一类型(AST行, 位置 + 2), "二元") &&
             字符串比较(下一文本(AST行, 位置 + 2), ">")) {
            列表追加(输出, "调用|向量$字符串$向量|0|3")
            类型压入(类型栈, "向")
            返回 位置 + 3
        }
    }
    列表追加(输出, "加载|" + 文本)
    类型压入(类型栈, 查类型(类型表, 文本))
    返回 位置 + 1
}
函数 处理成员节点(向量<字符串> AST行, 整64 位置, 整64 深, 字符串 模块名,
                向量<字符串> 签名表, 向量<字符串> 类型表, 向量<字符串> 类型栈,
                向量<字符串> 输出, 字符串 循环开始, 字符串 循环结束) -> 整64 {
    字符串 文本 = 行文本(AST行.元素(位置))
    字符串 成员文本 = 行文本(AST行.元素(位置 + 1))
    // B 任务拆分：模块限定名调用（关键字::查找关键字）——
    // 成员|::|名 行：行文本 = "::|名"（第一个 | 后），文本=模块名
    // 判断 :: 前缀（成员|::|名 的 行文本 以 "::|" 开头）。
    // 符号生成：当前模块名$函数名（忽略调用文本中的模块名）——79 闭环合并
    //   门面+子模块源码后统一 IR 生成，所有函数符号统一为 门面模块名$函数名，
    //   调用与定义符号匹配（子模块函数名在门面内唯一）。
    如果 (字符串长度(成员文本) >= 3 && 字符串比较(字符串子串(成员文本, 0, 3), "::|")) {
        字符串 限定函数名 = 字符串子串(成员文本, 3, 字符串长度(成员文本) - 3)
        字符串 限定名 = 模块名 + "$" + 限定函数名
        如果 (字符串比较(下一类型(AST行, 位置 + 2), "调用")) {
            字符串 参数数文本 = 参数数(行文本(AST行.元素(位置 + 2)))
            字符串 签名 = 查找签名(签名表, 限定函数名)
            整64 调用深3 = 行深度(AST行.元素(位置 + 2))
            位置 = 处理表达式(AST行, 位置 + 3, 调用深3,
                           模块名, 签名表, 类型表, 类型栈, 输出,
                           循环开始, 循环结束)
            字符串 调用参数码 = 签名参数码(签名)
            列表追加(输出, "调用|" + 限定名 + "|" + 参数数文本 + "|0|" + 调用参数码)
            字符串 返回码 = 调用返回码(限定函数名, 签名表)
            整64 参数个数 = 解析整数(参数数文本)
            整64 i = 0
            当 (i < 参数个数) {
                类型弹出(类型栈)
                i++
            }
            类型压入(类型栈, 返回码)
            返回 位置
        }
        列表追加(输出, "加载|" + 限定名)
        类型压入(类型栈, "整")
        返回 位置 + 2
    }
    如果 (字符串比较(下一类型(AST行, 位置 + 2), "调用")) {
        字符串 参数数文本 = 参数数(行文本(AST行.元素(位置 + 2)))
        字符串 方法 = 成员名(成员文本)
        字符串 符号 = "向量$字符串$" + 方法
        字符串 标志 = "1"
        字符串 返回码 = "未"
        如果 (字符串比较(方法, "追加") || 字符串比较(方法, "删除") ||
             字符串比较(方法, "设置")) {
            标志 = "2"
            返回码 = "空"
        } 否则 如果 (字符串比较(方法, "元素")) {
            返回码 = "字"
        } 否则 如果 (字符串比较(方法, "大小")) {
            返回码 = "整"
        } 否则 {
            返回码 = "未"
        }
        列表追加(输出, "加载|" + 文本)
        类型压入(类型栈, 查类型(类型表, 文本))
        整64 调用深2 = 行深度(AST行.元素(位置 + 2))
        位置 = 处理表达式(AST行, 位置 + 3, 调用深2,
                       模块名, 签名表, 类型表, 类型栈, 输出,
                       循环开始, 循环结束)
        列表追加(输出, "调用|" + 符号 + "|" + 参数数文本 + "|" + 标志)
        类型弹出(类型栈)
        整64 参数个数 = 解析整数(参数数文本)
        整64 i = 0
        当 (i < 参数个数) {
            类型弹出(类型栈)
            i++
        }
        如果 (字符串比较(标志, "2")) {
            类型弹出(类型栈)
        } 否则 {
            类型压入(类型栈, 返回码)
        }
        返回 位置
    }
    列表追加(输出, "加载成员|" + 文本 + "|" + 成员名(成员文本))
    类型压入(类型栈, "整")
    返回 位置 + 2
}
函数 处理二元节点(向量<字符串> AST行, 整64 位置, 整64 深, 字符串 模块名,
                向量<字符串> 签名表, 向量<字符串> 类型表, 向量<字符串> 类型栈,
                向量<字符串> 输出, 字符串 循环开始, 字符串 循环结束) -> 整64 {
    字符串 文本 = 行文本(AST行.元素(位置))
    位置 = 处理表达式(AST行, 位置 + 1, 深, 模块名, 签名表, 类型表, 类型栈,
                   输出, 循环开始, 循环结束)
    字符串 右类型 = 类型栈顶(类型栈)
    类型弹出(类型栈)
    字符串 左类型 = 类型栈顶(类型栈)
    类型弹出(类型栈)
    如果 (字符串比较(文本, "+") && (字符串比较(右类型, "字") ||
         字符串比较(左类型, "字"))) {
        列表追加(输出, "运算|+字")
        类型压入(类型栈, "字")
    } 否则 {
        列表追加(输出, "运算|" + 文本)
        类型压入(类型栈, "整")
    }
    返回 位置
}
函数 处理一元节点(向量<字符串> AST行, 整64 位置, 整64 深, 字符串 模块名,
                向量<字符串> 签名表, 向量<字符串> 类型表, 向量<字符串> 类型栈,
                向量<字符串> 输出, 字符串 循环开始, 字符串 循环结束) -> 整64 {
    字符串 文本 = 行文本(AST行.元素(位置))
    位置 = 处理表达式(AST行, 位置 + 1, 深, 模块名, 签名表, 类型表, 类型栈,
                   输出, 循环开始, 循环结束)
    如果 (字符串比较(文本, "!")) {
        列表追加(输出, "运算|非")
    } 否则 如果 (字符串比较(文本, "~")) {
        列表追加(输出, "运算|取反")
    } 否则 {
        列表追加(输出, "运算|取负")
    }
    类型弹出(类型栈)
    类型压入(类型栈, "整")
    返回 位置
}
函数 处理调用(向量<字符串> AST行, 整64 位置, 整64 深, 字符串 名,
             字符串 模块名, 向量<字符串> 签名表, 向量<字符串> 类型表,
             向量<字符串> 类型栈, 向量<字符串> 输出,
             字符串 循环开始, 字符串 循环结束) -> 整64 {
    字符串 参数数文本 = 参数数(行文本(AST行.元素(位置 + 1)))
    整64 参数个数 = 解析整数(参数数文本)
    字符串 符号 = 调用符号(名, 模块名)
    字符串 签名 = 查找签名(签名表, 名)
    整64 调用深 = 行深度(AST行.元素(位置 + 1))
    位置 = 位置 + 2
    整64 起始深度 = 类型栈.大小()
    当 (位置 < AST行.大小() && 行深度(AST行.元素(位置)) > 调用深 &&
         类型栈.大小() < 起始深度 + 参数个数) {
        整64 当前参数 = 类型栈.大小() - 起始深度
        如果 (是引用位(签名, 当前参数) && 位置 < AST行.大小() &&
             字符串比较(行类型(AST行.元素(位置)), "标识符")) {
            列表追加(输出, "压址|" + 行文本(AST行.元素(位置)))
            类型压入(类型栈, "整")
            位置++
        } 否则 {
            整64 参深 = 行深度(AST行.元素(位置))
            位置 = 处理表达式单(AST行, 位置, 参深, 模块名,
                              签名表, 类型表, 类型栈, 输出, 循环开始, 循环结束)
            当 (位置 < AST行.大小() && 行深度(AST行.元素(位置)) > 调用深 &&
                 类型栈.大小() == 起始深度 + 当前参数 + 1) {
                字符串 下一类 = 行类型(AST行.元素(位置))
                如果 (字符串比较(下一类, "二元") || 字符串比较(下一类, "一元") ||
                     字符串比较(下一类, "后缀")) {
                    整64 链深 = 行深度(AST行.元素(位置))
                    位置 = 处理表达式单(AST行, 位置, 链深, 模块名,
                                      签名表, 类型表, 类型栈, 输出,
                                      循环开始, 循环结束)
                } 否则 {
                    中断
                }
            }
        }
    }
    字符串 调用参数码 = ""
    如果 (字符串比较(名, "分词") || 字符串比较(名, "解析")) {
        调用参数码 = "PAX"
    } 否则 如果 (字符串比较(名, "字节值")) {
        调用参数码 = "PAXJ"
    } 否则 {
        调用参数码 = 签名参数码(签名)
    }
    列表追加(输出, "调用|" + 符号 + "|" + 参数数文本 + "|0|" + 调用参数码)
    字符串 返回码 = 调用返回码(名, 签名表)
    整64 j = 0
    当 (j < 参数个数) {
        类型弹出(类型栈)
        j++
    }
    类型压入(类型栈, 返回码)
    返回 位置
}
