// 自举 Task 7.4 v2：CN IR 生成器（门面，B 任务第二阶段拆分，2026-08-18）
// 拆分：IR1(工具)/IR2(签名)/IR3(语句)/IR4(表达式) 4 个子模块（IR生成/目录）
// 合并后声明顺序 = 门面 + IR1 + IR2 + IR3 + IR4（= 原单文件顺序，利于 79 逐字节一致）
模块 IR1;
模块 IR2;
模块 IR3;
模块 IR4;

导入 容器::向量;
导入 词法分析::分词;
导入 语法分析::解析;
导入 IR生成::IR1;
导入 IR生成::IR2;
导入 IR生成::IR3;
导入 IR生成::IR4;

公开:

函数 IR生成(字符串 源码, 字符串 模块名) -> 向量<字符串> {
    向量<字符串> 输出 = 向量<字符串>();
    向量<字符串> AST行 = 解析(源码);
    向量<字符串> 签名表 = 向量<字符串>();
    收集签名(AST行, 签名表);
    生成(AST行, 模块名, 签名表, 输出);
    返回 输出;
}
