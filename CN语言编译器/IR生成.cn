// 自举 Task 7.4：CN IR 生成器（用 CN 重写 C++ 版 ir，2026-08）
// 对标：src/cn_compiler/ir（IRGenerator 核心）
// 输入：CN 源码字符串；内部：分词 -> 语法分析（AST dump 行）-> IR 生成。
// 输出：简化三地址 IR 行（确定性顺序）：
//   函数|名|参数数       函数头
//   指令|参数|名         参数
//   指令|分配|名         变量分配
//   指令|常量|值         字面量
//   指令|加载|名         标识符引用（非调用名）
//   指令|运算|符号       二元/一元/赋值 运算
//   指令|调用|名|参数数  调用（名 = 前一标识符）
//   指令|返回            返回
//   指令|分支|种类       控制流（如果/当/选择/块）
导入 容器::向量
导入 词法分析::分词
导入 语法分析::解析

公开:

// IR 生成入口：源码 -> IR 行列表
函数 IR生成(字符串 源码) -> 向量<字符串> {
    向量<字符串> 输出 = 向量<字符串>()
    向量<字符串> AST行 = 解析(源码)
    生成(AST行, 输出)
    返回 输出
}

// ==================== 行工具 ====================

// 取行类型段（去缩进后 "类型|文本" 的 类型）
函数 行类型(字符串 行) -> 字符串 {
    整64 起 = 0
    布尔 空格 = 字符串比较(字符串子串(行, 0, 1), " ")
    当 (起 < 字符串长度(行) && 空格) {
        起++
        空格 = 字符串比较(字符串子串(行, 起, 1), " ")
    }
    整64 位 = 字符串查找(行, "|")
    如果 (位 < 0) {
        返回 字符串子串(行, 起, 字符串长度(行) - 起)
    }
    返回 字符串子串(行, 起, 位 - 起)
}

// 取行文本段
函数 行文本(字符串 行) -> 字符串 {
    整64 位 = 字符串查找(行, "|")
    如果 (位 < 0) {
        返回 ""
    }
    返回 字符串子串(行, 位 + 1, 字符串长度(行) - 位 - 1)
}

// ==================== 列表追加（结果检查） ====================

函数 列表追加(向量<字符串> 列表, 字符串 值) -> 空类型 {
    结果<空类型, 整32> 加 = 列表.追加(值)
    如果 (!加.正常) {
        运行时错误(4)
    }
}

// ==================== IR 生成主流程 ====================

// 提取函数名（文本 "名|参数数=N" -> 名）
函数 函数名(字符串 文本) -> 字符串 {
    整64 分隔 = 字符串查找(文本, "|参数数=")
    如果 (分隔 < 0) {
        返回 文本
    }
    返回 字符串子串(文本, 0, 分隔)
}

// 提取参数数（文本 "名|参数数=N" -> N）
函数 参数数(字符串 文本) -> 字符串 {
    整64 分隔 = 字符串查找(文本, "参数数=")
    如果 (分隔 < 0) {
        返回 "0"
    }
    返回 字符串子串(文本, 分隔 + 10, 字符串长度(文本) - 分隔 - 10)
}

// 生成：逐行扫描 AST，产出 IR 行
// 规则：标识符 后紧跟 调用（参数数=）-> 调用名（不输出 加载）；否则 -> 加载
函数 生成(向量<字符串> AST行, 向量<字符串> 输出) -> 空类型 {
    整64 位置 = 0
    字符串 前类型 = ""
    当 (位置 < AST行.大小()) {
        字符串 行 = AST行.元素(位置)
        字符串 类型 = 行类型(行)
        字符串 文本 = 行文本(行)
        // ---- 函数头 ----
        如果 (字符串比较(类型, "函数") || 字符串比较(类型, "方法")) {
            列表追加(输出, "函数|" + 函数名(文本) + "|" + 参数数(文本))
            位置++
            继续
        }
        // ---- 参数 ----
        如果 (字符串比较(类型, "参数")) {
            列表追加(输出, "指令|参数|" + 文本)
            位置++
            继续
        }
        // ---- 变量分配 ----
        如果 (字符串比较(类型, "变量")) {
            列表追加(输出, "指令|分配|" + 文本)
            位置++
            继续
        }
        // ---- 字面量 ----
        如果 (字符串比较(类型, "字面量")) {
            列表追加(输出, "指令|常量|" + 文本)
            位置++
            继续
        }
        // ---- 调用 行：已由 标识符 分支合并输出（含调用名），此处跳过 ----
        如果 (字符串比较(类型, "调用")) {
            位置++
            继续
        }
        // ---- 标识符：调用名（后跟 调用）或 加载 ----
        如果 (字符串比较(类型, "标识符")) {
            整64 下一 = 位置 + 1
            字符串 下一类型 = ""
            如果 (下一 < AST行.大小()) {
                下一类型 = 行类型(AST行.元素(下一))
            }
            如果 (字符串比较(下一类型, "调用")) {
                列表追加(输出, "指令|调用|" + 文本 + "|" +
                         参数数(行文本(AST行.元素(下一))))
            } 否则 {
                列表追加(输出, "指令|加载|" + 文本)
            }
            位置++
            继续
        }
        // ---- 运算 ----
        如果 (字符串比较(类型, "二元") || 字符串比较(类型, "一元") ||
             字符串比较(类型, "赋值") || 字符串比较(类型, "后缀")) {
            列表追加(输出, "指令|运算|" + 文本)
            位置++
            继续
        }
        // ---- 返回 ----
        如果 (字符串比较(类型, "返回")) {
            列表追加(输出, "指令|返回")
            位置++
            继续
        }
        // ---- 控制流 ----
        如果 (字符串比较(类型, "如果") || 字符串比较(类型, "当") ||
             字符串比较(类型, "循环") || 字符串比较(类型, "选择") ||
             字符串比较(类型, "块") || 字符串比较(类型, "否则") ||
             字符串比较(类型, "遍历")) {
            列表追加(输出, "指令|分支|" + 类型)
            位置++
            继续
        }
        // 其他（类型/返回类型/分区/字段/枚举成员/修饰/三元/初始化列表 等）：跳过
        位置++
    }
}
