// 自举后端抽象层：x64 后端实现（Task 009 平台抽象层重构 第二步）
// 实现 后端接口（后端接口.cn），输出 Win x64 MASM 汇编（ml64 可汇编、可链接运行）。
// 本文件从 代码生成.cn 提取全部 x64 MASM 特定发射逻辑，保持输出逐字节一致：
//   .data：字符串常量池 @strN（UTF-8 字节十六进制，0 结尾）
//   .code：EXTERN 声明 + 函数 PROC/ENDP
//   函数帧：push r12 / push rbp / mov rbp,rsp / sub rsp,F（>4KB 走 __chkstk）
//     槽区 16B×N、求值栈 64×8B（[rbp-F+r12]）、返回缓冲 16B（结构返回）
//   调用约定：Win x64（rcx/rdx/r8/r9 + 影子空间 + 栈参），调用前 rsp 16 对齐
//   结构返回（结果<空类型,整32>）：rcx=隐藏返回缓冲指针；正常 位于偏移 0（dword）
//   方法调用：向量$字符串$*（追加/元素/大小/删除/设置）符号按 C++ 版修饰名硬编码
// 依据：spec 06 OOP 接口实现（类 名称 : 接口 { 重写 函数 ... }）
导入 容器::向量
导入 词法分析::字节值
导入 后端接口::后端接口

公开:

// x64后端 — Win x64 MASM 汇编后端
类 x64后端 : 后端接口 {
    // ---- 私有字段（默认私有）----
    向量<字符串> 输出行
    整64 槽数

    // ==================== 私有辅助方法 ====================

    // 追加一行到输出（结果检查）
    函数 追加(字符串 行) -> 空类型 {
        结果<空类型, 整32> 加 = 输出行.追加(行)
        如果 (!加.正常) {
            运行时错误(4)
        }
    }

    // 压栈（F = 16*槽数+544；es[i] 位于 [rbp-F+8i]）
    函数 压栈(整64 槽数) -> 空类型 {
        自身.追加("mov [rbp-" + 整数转字符串(槽数 * 16 + 544) + "+r12], rax")
        自身.追加("add r12, 8")
    }

    // 弹到 rax
    函数 弹出rax(整64 槽数) -> 空类型 {
        自身.追加("sub r12, 8")
        自身.追加("mov rax, [rbp-" + 整数转字符串(槽数 * 16 + 544) + "+r12]")
    }

    // 弹到 rdx
    函数 弹出rdx(整64 槽数) -> 空类型 {
        自身.追加("sub r12, 8")
        自身.追加("mov rdx, [rbp-" + 整数转字符串(槽数 * 16 + 544) + "+r12]")
    }

    // 弹到 rcx
    函数 弹出rcx(整64 槽数) -> 空类型 {
        自身.追加("sub r12, 8")
        自身.追加("mov rcx, [rbp-" + 整数转字符串(槽数 * 16 + 544) + "+r12]")
    }

    // 尾声（mov rsp,rbp / pop rbp / pop r12 / ret）
    函数 尾声() -> 空类型 {
        自身.追加("mov rsp, rbp")
        自身.追加("pop rbp")
        自身.追加("pop r12")
        自身.追加("ret")
    }

    // 字节 -> "0XXh"（MASM 十六进制字节）
    函数 字节十六进制(整64 字节) -> 字符串 {
        字符串 表 = "0123456789ABCDEF"
        返回 "0" + 字符转字符串(字节值(表, 字节 / 16)) + 字符转字符串(字节值(表, 字节 % 16)) + "h"
    }

    // 字节 -> "%02X"（原始两位十六进制，符号修饰用）
    函数 字节十六进制2(整64 字节) -> 字符串 {
        字符串 表 = "0123456789ABCDEF"
        返回 字符转字符串(字节值(表, 字节 / 16)) + 字符转字符串(字节值(表, 字节 % 16))
    }

    // 字符串 -> UTF-8 十六进制（符号修饰 ?XX..@@Y 用）
    函数 UTF8十六进制(字符串 文本) -> 字符串 {
        字符串 累积 = ""
        整64 i = 0
        当 (i < 字符串长度(文本)) {
            累积 = 累积 + 自身.字节十六进制2(字节值(文本, i))
            i++
        }
        返回 累积
    }

    // 字符字面量 'x' / '\u{XXXX}' 的字节值（简化：单字节）
    函数 字符值(字符串 文本) -> 整64 {
        整64 长度 = 字符串长度(文本)
        如果 (长度 >= 3) {
            如果 (字节值(文本, 1) == 92) {
                返回 92
            }
            返回 字节值(文本, 1)
        }
        返回 0
    }

    // 算术运算（+ - * / %）
    函数 发射运算算术(字符串 符号, 整64 槽数) -> 空类型 {
        自身.弹出rdx(槽数)
        自身.弹出rax(槽数)
        如果 (字符串比较(符号, "+")) {
            自身.追加("add rax, rdx")
        } 否则 如果 (字符串比较(符号, "-")) {
            自身.追加("sub rax, rdx")
        } 否则 如果 (字符串比较(符号, "*")) {
            自身.追加("imul rax, rdx")
        } 否则 如果 (字符串比较(符号, "/")) {
            自身.追加("cqo")
            自身.追加("idiv rdx")
        } 否则 {
            自身.追加("cqo")
            自身.追加("idiv rdx")
            自身.追加("mov rax, rdx")
        }
        自身.压栈(槽数)
    }

    // 移位运算（<< >>）
    函数 发射运算移位(字符串 符号, 整64 槽数) -> 空类型 {
        自身.弹出rdx(槽数)
        自身.弹出rax(槽数)
        自身.追加("mov rcx, rdx")
        如果 (字符串比较(符号, "<<")) {
            自身.追加("shl rax, cl")
        } 否则 {
            自身.追加("sar rax, cl")
        }
        自身.压栈(槽数)
    }

    // 位运算（& | ^）
    函数 发射运算位(字符串 符号, 整64 槽数) -> 空类型 {
        自身.弹出rdx(槽数)
        自身.弹出rax(槽数)
        如果 (字符串比较(符号, "&")) {
            自身.追加("and rax, rdx")
        } 否则 如果 (字符串比较(符号, "|")) {
            自身.追加("or rax, rdx")
        } 否则 {
            自身.追加("xor rax, rdx")
        }
        自身.压栈(槽数)
    }

    // 比较运算（== != < <= > >=）
    函数 发射运算比较(字符串 符号, 整64 槽数) -> 空类型 {
        自身.弹出rdx(槽数)
        自身.弹出rax(槽数)
        自身.追加("cmp rax, rdx")
        如果 (字符串比较(符号, "==")) {
            自身.追加("sete al")
        } 否则 如果 (字符串比较(符号, "!=")) {
            自身.追加("setne al")
        } 否则 如果 (字符串比较(符号, "<")) {
            自身.追加("setl al")
        } 否则 如果 (字符串比较(符号, "<=")) {
            自身.追加("setle al")
        } 否则 如果 (字符串比较(符号, ">")) {
            自身.追加("setg al")
        } 否则 {
            自身.追加("setge al")
        }
        自身.追加("movzx eax, al")
        自身.压栈(槽数)
    }

    // 逻辑/一元/栈运算（&& || 非 取负 取反 下标字节 复制栈顶 弹出）
    函数 发射运算逻辑(字符串 符号, 整64 槽数) -> 空类型 {
        如果 (字符串比较(符号, "&&")) {
            自身.弹出rdx(槽数)
            自身.弹出rax(槽数)
            自身.追加("and rax, rdx")
            自身.压栈(槽数)
            返回
        }
        如果 (字符串比较(符号, "||")) {
            自身.弹出rdx(槽数)
            自身.弹出rax(槽数)
            自身.追加("or rax, rdx")
            自身.压栈(槽数)
            返回
        }
        如果 (字符串比较(符号, "非")) {
            自身.弹出rax(槽数)
            自身.追加("cmp rax, 0")
            自身.追加("sete al")
            自身.追加("movzx eax, al")
            自身.压栈(槽数)
            返回
        }
        如果 (字符串比较(符号, "取负")) {
            自身.弹出rax(槽数)
            自身.追加("neg rax")
            自身.压栈(槽数)
            返回
        }
        如果 (字符串比较(符号, "取反")) {
            自身.弹出rax(槽数)
            自身.追加("not rax")
            自身.压栈(槽数)
            返回
        }
        如果 (字符串比较(符号, "下标字节")) {
            自身.弹出rdx(槽数)
            自身.弹出rax(槽数)
            自身.追加("movsx rax, byte ptr [rax+rdx]")
            自身.压栈(槽数)
            返回
        }
        如果 (字符串比较(符号, "复制栈顶")) {
            自身.追加("mov rax, [rbp-" + 整数转字符串(槽数 * 16 + 544) + "+r12-8]")
            自身.压栈(槽数)
            返回
        }
        如果 (字符串比较(符号, "弹出")) {
            自身.追加("sub r12, 8")
            返回
        }
    }

    // 赋值族（+= -= *= /= %=）
    函数 发射运算赋值(字符串 符号, 整64 槽数) -> 空类型 {
        自身.弹出rdx(槽数)
        自身.弹出rax(槽数)
        如果 (字符串比较(符号, "+=")) {
            自身.追加("add rax, rdx")
        } 否则 如果 (字符串比较(符号, "-=")) {
            自身.追加("sub rax, rdx")
        } 否则 如果 (字符串比较(符号, "*=")) {
            自身.追加("imul rax, rdx")
        } 否则 如果 (字符串比较(符号, "/=")) {
            自身.追加("cqo")
            自身.追加("idiv rdx")
        } 否则 {
            自身.追加("cqo")
            自身.追加("idiv rdx")
            自身.追加("mov rax, rdx")
        }
        自身.压栈(槽数)
    }

    // 装载 abi 位置 j 的参数（来源求值栈顶第 e 项；位移 = F + 8*Nargs - 8*e）
    函数 发射装载参数(整64 j, 整64 e, 整64 槽数, 整64 栈参个数) -> 空类型 {
        整64 位移 = 槽数 * 16 + 544 + 8 * 栈参个数 - 8 * e
        如果 (j < 4) {
            自身.追加("mov " + 自身.寄存器名(j) + ", [rbp-" + 整数转字符串(位移) + "+r12]")
        } 否则 {
            自身.追加("mov rax, [rbp-" + 整数转字符串(位移) + "+r12]")
            自身.追加("mov [rsp+" + 整数转字符串(32 + 8 * (j - 4)) + "], rax")
        }
    }

公开:

    // 构造函数
    函数 x64后端() {
        输出行 = 向量<字符串>()
        槽数 = 0
    }

    // 析构函数（缺陷3 强制规则 2026-09-02：拥有式字段须声明析构——
    //   编译器注入字段级联析构，释放 输出行 向量及其字符串元素）
    函数 ~x64后端() { }

    // ---- 平台信息 ----
    重写 函数 目标平台() -> 字符串 {
        返回 "win-x64"
    }

    // ---- 段管理 ----
    // 段头：抽象段名（"数据"/"代码"）映射到 MASM 段
    重写 函数 段头(字符串 段名) -> 空类型 {
        如果 (字符串比较(段名, "数据")) {
            自身.追加("; ============================================")
            自身.追加("; CN语言编译器生成代码（Task 7.5 v2 自举后端）")
            自身.追加("; 目标平台: win-x64")
            自身.追加("; 汇编格式: Win x64 MASM")
            自身.追加("; ============================================")
            自身.追加("")
            自身.追加(".data")
        } 否则 {
            自身.追加("")
            自身.追加(".code")
        }
    }

    // 段尾：结束当前段（空行由 段头("代码") 前导空行承担，避免与 函数尾 空行重复）
    重写 函数 段尾() -> 空类型 {
    }

    // 程序结束：发射 MASM END
    重写 函数 程序结束() -> 空类型 {
        自身.追加("END")
    }

    // ---- 函数管理 ----
    // 函数头：PROC 头、帧建立（>4KB 走 __chkstk 三段式栈探测）、参数装载
    重写 函数 函数头(字符串 符号, 字符串 参数码, 整64 槽数, 整64 参数个数) -> 空类型 {
        整64 帧大小 = 槽数 * 16 + 544
        自身.追加("; 函数 " + 符号)
        自身.追加(自身.符号修饰(符号, 参数码) + " PROC")
        自身.追加("push r12")
        自身.追加("push rbp")
        自身.追加("mov rbp, rsp")
        如果 (帧大小 > 4096) {
            自身.追加("mov rax, " + 整数转字符串(帧大小))
            自身.追加("call __chkstk")
            自身.追加("sub rsp, rax")
        } 否则 {
            自身.追加("sub rsp, " + 整数转字符串(帧大小))
        }
        整64 i = 0
        当 (i < 参数个数) {
            如果 (i < 4) {
                自身.追加("mov [rbp-" + 整数转字符串(16 * (i + 1)) + "], " + 自身.寄存器名(i))
            } 否则 {
                自身.追加("mov rax, [rbp+" + 整数转字符串(40 + 8 * (i - 4)) + "]")
                自身.追加("mov [rbp-" + 整数转字符串(16 * (i + 1)) + "], rax")
            }
            i++
        }
        自身.追加("mov r12, 0")
    }

    // 函数尾：兜底尾声 + ENDP
    重写 函数 函数尾(字符串 符号, 字符串 参数码) -> 空类型 {
        自身.尾声()
        自身.追加(自身.符号修饰(符号, 参数码) + " ENDP")
        自身.追加("")
    }

    // ---- 指令发射 ----
    // 字面量：真/假/数字（字符字面量已由 IR 遍历引擎解析为数字）
    重写 函数 发射字面量(字符串 文本, 整64 槽数) -> 空类型 {
        如果 (字符串比较(文本, "真")) {
            自身.追加("mov rax, 1")
        } 否则 如果 (字符串比较(文本, "假")) {
            自身.追加("mov rax, 0")
        } 否则 如果 (字符串长度(文本) > 0 && 字符串比较(字符串子串(文本, 0, 1), "'")) {
            自身.追加("mov rax, " + 整数转字符串(自身.字符值(文本)))
        } 否则 {
            自身.追加("mov rax, " + 文本)
        }
        自身.压栈(槽数)
    }

    // 字符串常量引用：按常量表序号发射（lea 常量地址）
    重写 函数 发射字符串引用(整64 序号, 整64 槽数) -> 空类型 {
        自身.追加("lea rax, @str" + 整数转字符串(序号))
        自身.压栈(槽数)
    }

    // 变量加载（引用参数解引用）
    重写 函数 发射加载(整64 槽, 布尔 是引用, 整64 槽数) -> 空类型 {
        自身.追加("mov rax, [rbp-" + 整数转字符串(16 * (槽 + 1)) + "]")
        如果 (是引用) {
            自身.追加("mov rax, [rax]")
        }
        自身.压栈(槽数)
    }

    // 引用参数取址（传槽地址 lea）
    重写 函数 发射压址(整64 槽, 整64 槽数) -> 空类型 {
        自身.追加("lea rax, [rbp-" + 整数转字符串(16 * (槽 + 1)) + "]")
        自身.压栈(槽数)
    }

    // 赋值存储（引用参数解引用写）
    重写 函数 发射存储(整64 槽, 布尔 是引用, 整64 槽数) -> 空类型 {
        自身.弹出rax(槽数)
        如果 (是引用) {
            自身.追加("mov rcx, [rbp-" + 整数转字符串(16 * (槽 + 1)) + "]")
            自身.追加("mov [rcx], rax")
        } 否则 {
            自身.追加("mov [rbp-" + 整数转字符串(16 * (槽 + 1)) + "], rax")
        }
    }

    // 结构返回结果拷贝（retbuf 16B -> 槽）
    重写 函数 发射复制结果(整64 槽, 整64 槽数) -> 空类型 {
        自身.追加("mov rax, [rbp-" + 整数转字符串(槽数 * 16 + 32) + "]")
        自身.追加("mov [rbp-" + 整数转字符串(16 * (槽 + 1)) + "], rax")
        自身.追加("mov rax, [rbp-" + 整数转字符串(槽数 * 16 + 40) + "]")
        自身.追加("mov [rbp-" + 整数转字符串(16 * (槽 + 1) + 8) + "], rax")
    }

    // 结果.正常 字段读取（dword 归一化：setne——正常 本身 0/1 归一）
    重写 函数 发射加载成员(整64 槽, 整64 槽数) -> 空类型 {
        自身.追加("mov eax, [rbp-" + 整数转字符串(16 * (槽 + 1)) + "]")
        自身.追加("cmp eax, 0")
        自身.追加("setne al")
        自身.追加("movzx eax, al")
        自身.压栈(槽数)
    }

    // 递增/递减（引用参数解引用）
    重写 函数 发射递增递减(字符串 操作, 整64 槽, 布尔 是引用, 整64 槽数) -> 空类型 {
        如果 (是引用) {
            自身.追加("mov rcx, [rbp-" + 整数转字符串(16 * (槽 + 1)) + "]")
            自身.追加("mov rax, [rcx]")
            如果 (字符串比较(操作, "递增")) {
                自身.追加("add rax, 1")
            } 否则 {
                自身.追加("sub rax, 1")
            }
            自身.追加("mov [rcx], rax")
        } 否则 {
            自身.追加("mov rax, [rbp-" + 整数转字符串(16 * (槽 + 1)) + "]")
            如果 (字符串比较(操作, "递增")) {
                自身.追加("add rax, 1")
            } 否则 {
                自身.追加("sub rax, 1")
            }
            自身.追加("mov [rbp-" + 整数转字符串(16 * (槽 + 1)) + "], rax")
        }
    }

    // 运算（算术/移位/位/比较/逻辑/赋值族）
    重写 函数 发射运算(字符串 符号, 整64 槽数) -> 空类型 {
        如果 (字符串比较(符号, "+") || 字符串比较(符号, "-") ||
             字符串比较(符号, "*") || 字符串比较(符号, "/") ||
             字符串比较(符号, "%")) {
            自身.发射运算算术(符号, 槽数)
            返回
        }
        如果 (字符串比较(符号, "<<") || 字符串比较(符号, ">>")) {
            自身.发射运算移位(符号, 槽数)
            返回
        }
        如果 (字符串比较(符号, "&") || 字符串比较(符号, "|") ||
             字符串比较(符号, "^")) {
            自身.发射运算位(符号, 槽数)
            返回
        }
        如果 (字符串比较(符号, "==") || 字符串比较(符号, "!=") ||
             字符串比较(符号, "<") || 字符串比较(符号, "<=") ||
             字符串比较(符号, ">") || 字符串比较(符号, ">=")) {
            自身.发射运算比较(符号, 槽数)
            返回
        }
        如果 (字符串比较(符号, "&&") || 字符串比较(符号, "||") ||
             字符串比较(符号, "非") || 字符串比较(符号, "取负") ||
             字符串比较(符号, "取反") || 字符串比较(符号, "下标字节") ||
             字符串比较(符号, "复制栈顶") || 字符串比较(符号, "弹出")) {
            自身.发射运算逻辑(符号, 槽数)
            返回
        }
        如果 (字符串比较(符号, "+字")) {
            自身.弹出rdx(槽数)
            自身.弹出rcx(槽数)
            自身.追加("sub rsp, 40")
            自身.追加("call __cn_str_concat")
            自身.追加("add rsp, 40")
            自身.压栈(槽数)
            返回
        }
        如果 (字符串比较(符号, "+=") || 字符串比较(符号, "-=") ||
             字符串比较(符号, "*=") || 字符串比较(符号, "/=") ||
             字符串比较(符号, "%=")) {
            自身.发射运算赋值(符号, 槽数)
            返回
        }
    }

    // 调用（符号|参数数|标志|参数码 已由 IR 遍历引擎解析）
    重写 函数 发射调用(字符串 符号, 整64 参数个数, 字符串 标志, 字符串 参数码,
                    整64 槽数) -> 空类型 {
        // ---- 构造：__cn_object_new(24) + 构造函数（构造为 空类型 返回——
        //   对象须保留 __cn_object_new 的结果，经 返回缓冲槽 中转） ----
        如果 (字符串比较(标志, "3")) {
            自身.追加("mov rcx, 24")
            自身.追加("sub rsp, 40")
            自身.追加("call __cn_object_new")
            自身.追加("add rsp, 40")
            自身.追加("mov [rbp-" + 整数转字符串(槽数 * 16 + 32) + "], rax")
            自身.追加("mov rcx, rax")
            自身.追加("sub rsp, 40")
            自身.追加("call " + 自身.符号修饰("向量$字符串$向量", ""))
            自身.追加("add rsp, 40")
            自身.追加("mov rax, [rbp-" + 整数转字符串(槽数 * 16 + 32) + "]")
            自身.压栈(槽数)
            返回
        }
        // ---- ABI 参数数 ----
        整64 abi = 参数个数
        如果 (字符串比较(标志, "1")) {
            abi = 参数个数 + 1
        }
        如果 (字符串比较(标志, "2")) {
            abi = 参数个数 + 2
        }
        整64 栈参 = abi - 4
        如果 (栈参 < 0) {
            栈参 = 0
        }
        整64 间距 = 32 + 8 * 栈参
        // Win x64：调用点 rsp 须 16 对齐（原条件写反：已对齐时 +8 反致错位，
        //   运行时 memcpy/SSE 路径在错位栈上崩 0xC0000005）
        如果 (间距 % 16 == 0) {
            间距 = 间距 + 8
        }
        // 影子空间恒保留（Win x64：调用方须预留 32B，即使无栈参）
        自身.追加("sub rsp, " + 整数转字符串(间距))
        // ---- 参数装载（参数为求值栈顶 Nargs 项，r12 相对寻址） ----
        整64 栈参个数 = abi
        如果 (字符串比较(标志, "2")) {
            栈参个数 = abi - 1
        }
        整64 j = 0
        当 (j < abi) {
            如果 (字符串比较(标志, "2")) {
                如果 (j == 0) {
                    自身.追加("lea rcx, [rbp-" + 整数转字符串(槽数 * 16 + 32) + "]")
                } 否则 {
                    自身.发射装载参数(j, j - 1, 槽数, 栈参个数)
                }
            } 否则 {
                自身.发射装载参数(j, j, 槽数, 栈参个数)
            }
            j++
        }
        自身.追加("call " + 自身.符号修饰(符号, 参数码))
        自身.追加("add rsp, " + 整数转字符串(间距))
        // ---- 弹出求值栈参数（retbuf 不在栈上） ----
        如果 (栈参个数 > 0) {
            自身.追加("sub r12, " + 整数转字符串(8 * 栈参个数))
        }
        // ---- 结果 ----
        如果 (字符串比较(标志, "2")) {
            // 结构返回：结果留在返回缓冲（复制结果 指令负责搬运）
        } 否则 {
            自身.压栈(槽数)
        }
    }

    // 返回（弹出返回值 + 尾声）
    重写 函数 发射返回(整64 槽数) -> 空类型 {
        自身.弹出rax(槽数)
        自身.尾声()
    }

    // 返回空（仅尾声）
    重写 函数 发射返回空() -> 空类型 {
        自身.尾声()
    }

    // 标签
    重写 函数 发射标签(字符串 文本) -> 空类型 {
        自身.追加(文本 + ":")
    }

    // 无条件跳转
    重写 函数 发射跳转(字符串 文本) -> 空类型 {
        自身.追加("jmp " + 文本)
    }

    // 跳转真（弹出 + 测试 + 条件跳转）
    重写 函数 发射跳转真(字符串 文本, 整64 槽数) -> 空类型 {
        自身.弹出rax(槽数)
        自身.追加("test rax, rax")
        自身.追加("jnz " + 文本)
    }

    // 跳转假（弹出 + 测试 + 条件跳转）
    重写 函数 发射跳转假(字符串 文本, 整64 槽数) -> 空类型 {
        自身.弹出rax(槽数)
        自身.追加("test rax, rax")
        自身.追加("jz " + 文本)
    }

    // ---- 常量与外部声明 ----
    // 发射 .data 字符串常量（每行 ≤16 字节，0 结尾）
    重写 函数 发射字符串常量(整64 序号, 字符串 文本) -> 空类型 {
        字符串 行 = "@str" + 整数转字符串(序号) + " db "
        整64 i = 0
        整64 计数 = 0
        当 (i < 字符串长度(文本)) {
            如果 (计数 == 16) {
                自身.追加(行)
                行 = "      db "
                计数 = 0
            }
            如果 (计数 > 0) {
                行 = 行 + ","
            }
            行 = 行 + 自身.字节十六进制(字节值(文本, i))
            计数++
            i++
        }
        如果 (计数 > 0) {
            自身.追加(行)
        } 否则 {
            自身.追加("@str" + 整数转字符串(序号) + " db 0")
            返回
        }
        自身.追加("      db 0")
    }

    // 发射固定外部符号声明（运行时/内置符号）
    重写 函数 发射固定外部() -> 空类型 {
        自身.追加("EXTERN printLine:PROC")
        自身.追加("EXTERN printNoLine:PROC")
        自身.追加("EXTERN __chkstk:PROC")
        自身.追加("EXTERN __cn_runtime_error:PROC")
        自身.追加("EXTERN __cn_object_new:PROC")
        自身.追加("EXTERN __cn_str_len:PROC")
        自身.追加("EXTERN __cn_str_eq:PROC")
        自身.追加("EXTERN __cn_str_find:PROC")
        自身.追加("EXTERN __cn_str_sub:PROC")
        自身.追加("EXTERN __cn_str_contains:PROC")
        自身.追加("EXTERN __cn_str_concat:PROC")
        自身.追加("EXTERN __cn_str_from_int:PROC")
        自身.追加("EXTERN __cn_str_from_char:PROC")
        自身.追加("EXTERN ?E59091E9878F24E5AD97E7ACA6E4B8B224E59091E9878F@@Y:PROC")
        自身.追加("EXTERN ?E59091E9878F24E5AD97E7ACA6E4B8B224E8BFBDE58AA0@@YPAX@Z:PROC")
        自身.追加("EXTERN ?E59091E9878F24E5AD97E7ACA6E4B8B224E58583E7B4A0@@YJ@Z:PROC")
        自身.追加("EXTERN ?E59091E9878F24E5AD97E7ACA6E4B8B224E5A4A7E5B08F@@Y:PROC")
        自身.追加("EXTERN ?E59091E9878F24E5AD97E7ACA6E4B8B224E588A0E999A4@@YJ@Z:PROC")
        自身.追加("EXTERN ?E59091E9878F24E5AD97E7ACA6E4B8B224E8AEBEE7BDAE@@YJPAX@Z:PROC")
        自身.追加("")
    }

    // 发射单个外部符号声明（EXTERN）
    重写 函数 发射外部声明(字符串 符号, 字符串 参数码) -> 空类型 {
        自身.追加("EXTERN " + 自身.符号修饰(符号, 参数码) + ":PROC")
    }

    // 符号是否固定外部（运行时/内置符号）
    重写 函数 固定外部(字符串 符号) -> 布尔 {
        如果 (字符串比较(符号, "printLine") || 字符串比较(符号, "printNoLine")) {
            返回 真
        }
        如果 (字符串长度(符号) >= 5 && 字符串比较(字符串子串(符号, 0, 5), "__cn_")) {
            返回 真
        }
        如果 (字符串长度(符号) >= 3 && 字符串比较(字符串子串(符号, 0, 3), "cn_")) {
            返回 真
        }
        如果 (字符串长度(符号) >= 6 && 字符串比较(字符串子串(符号, 0, 6), "向量$字符串$")) {
            返回 真
        }
        返回 假
    }

    // ---- 符号与寄存器 ----
    // CN 符号 -> MASM 链接符号（参数码: C++ 版 mangling 的参数类型码串，如 PAXJ）
    // 格式与 C++ 版一致：?hex(名)@@Y<参数码>@Z（有参数）；?hex(名)@@Y（无参数）
    重写 函数 符号修饰(字符串 符号, 字符串 参数码) -> 字符串 {
        如果 (字符串比较(符号, "主")) {
            返回 "cn_main"
        }
        // 运行时 / 内置：原样
        如果 (字符串比较(符号, "printLine") || 字符串比较(符号, "printNoLine")) {
            返回 符号
        }
        如果 (字符串长度(符号) >= 5 && 字符串比较(字符串子串(符号, 0, 5), "__cn_")) {
            返回 符号
        }
        如果 (字符串长度(符号) >= 3 && 字符串比较(字符串子串(符号, 0, 3), "cn_")) {
            返回 符号
        }
        // 向量方法：C++ 版修饰名（容器.obj 提供）
        如果 (字符串比较(符号, "向量$字符串$向量")) {
            返回 "?E59091E9878F24E5AD97E7ACA6E4B8B224E59091E9878F@@Y"
        }
        如果 (字符串比较(符号, "向量$字符串$追加")) {
            返回 "?E59091E9878F24E5AD97E7ACA6E4B8B224E8BFBDE58AA0@@YPAX@Z"
        }
        如果 (字符串比较(符号, "向量$字符串$元素")) {
            返回 "?E59091E9878F24E5AD97E7ACA6E4B8B224E58583E7B4A0@@YJ@Z"
        }
        如果 (字符串比较(符号, "向量$字符串$大小")) {
            返回 "?E59091E9878F24E5AD97E7ACA6E4B8B224E5A4A7E5B08F@@Y"
        }
        如果 (字符串比较(符号, "向量$字符串$删除")) {
            返回 "?E59091E9878F24E5AD97E7ACA6E4B8B224E588A0E999A4@@YJ@Z"
        }
        如果 (字符串比较(符号, "向量$字符串$设置")) {
            返回 "?E59091E9878F24E5AD97E7ACA6E4B8B224E8AEBEE7BDAE@@YJPAX@Z"
        }
        // 模块函数：? + UTF-8 十六进制 + @@Y（+ 参数码 + @Z 当有参数）
        如果 (字符串长度(参数码) > 0) {
            返回 "?" + 自身.UTF8十六进制(符号) + "@@Y" + 参数码 + "@Z"
        }
        返回 "?" + 自身.UTF8十六进制(符号) + "@@Y"
    }

    // 参数寄存器名（索引 0..3 -> rcx/rdx/r8/r9）
    重写 函数 寄存器名(整64 索引) -> 字符串 {
        如果 (索引 == 0) {
            返回 "rcx"
        }
        如果 (索引 == 1) {
            返回 "rdx"
        }
        如果 (索引 == 2) {
            返回 "r8"
        }
        返回 "r9"
    }

    // ---- 输出 ----
    // 获取后端生成的完整汇编行列表
    重写 函数 获取输出() -> 向量<字符串> {
        返回 输出行
    }
}
