// 自举 Task 7.3：CN 语义分析器（用 CN 重写 C++ 版 semantic，2026-08）
// B 任务拆分（2026-08）：门面文件——保留 语义检查 入口 + 检查 主流程，
//   子模块拆分至 语义/符号表.cn（符号查找/列表追加）、语义/内置.cn
//   （是内置函数/是类型关键字/行类型/行文本/函数参数数/函数名）。
// 对标：src/cn_compiler/semantic（semantic.cpp 核心检查）
// 输入：CN 源码字符串；内部：分词 -> 语法分析（AST dump 行）-> 语义检查。
// 输出：诊断行列表（确定性顺序）：
//   符号|函数|名|参数数       函数声明登记
//   符号|参数|名               参数登记
//   符号|变量|名               变量登记
//   符号|类型|名|种类          结构体/枚举/类/泛型类 登记
//   错误|重复声明 '名'        同作用域重复
//   错误|未声明的标识符 '名'  表达式使用未声明符号
// 注：内置函数（打印/字符串长度/...）与类型关键字预置，使用不报未声明。
导入 容器::向量
导入 词法分析::分词
导入 语法分析::解析
导入 语义::符号表
导入 语义::内置

公开:

// 语义分析入口：源码 -> 诊断行列表（入口名 语义检查，避免与模块名 语义分析 冲突）
函数 语义检查(字符串 源码) -> 向量<字符串> {
    向量<字符串> 输出 = 向量<字符串>()
    向量<字符串> AST行 = 解析(源码)
    检查(AST行, 输出)
    返回 输出
}

// ==================== 语义检查主流程 ====================

// 主检查：逐行扫描 AST，登记符号 + 报告错误
// 注：辅助函数用 符号表::/内置:: 限定名调用（语义/符号表.cn、语义/内置.cn），
//   避免与 IR生成.cn/代码生成.cn 同名函数（行类型/行文本/列表追加/函数名）纯名歧义
函数 检查(向量<字符串> AST行, 向量<字符串> 输出) -> 空类型 {
    向量<字符串> 符号表 = 向量<字符串>()
    整64 位置 = 0
    当 (位置 < AST行.大小()) {
        字符串 行 = AST行.元素(位置)
        字符串 类型 = 语义::语义::内置::行类型(行)
        字符串 文本 = 语义::语义::内置::行文本(行)
        // ---- 函数/方法声明：登记（含参数数） ----
        如果 (字符串比较(类型, "函数") || 字符串比较(类型, "方法")) {
            // 2026-08 修复：局部变量名避开函数名（函数名(文本) 遮蔽导致
            //   调用被解析为未初始化变量 -> call r11 垃圾地址崩溃）
            字符串 函数名2 = 语义::内置::函数名(文本)
            如果 (!语义::符号表::符号查找(符号表, 函数名2)) {
                语义::符号表::列表追加(输出, "符号|函数|" + 函数名2 + "|" + 语义::内置::函数参数数(文本))
                语义::符号表::列表追加(符号表, "函数|" + 函数名2 + "|" + 语义::内置::函数参数数(文本))
            }
            位置++
            继续
        }
        // ---- 参数登记 ----
        如果 (字符串比较(类型, "参数")) {
            如果 (!语义::符号表::符号查找(符号表, 文本)) {
                语义::符号表::列表追加(输出, "符号|参数|" + 文本)
                语义::符号表::列表追加(符号表, "参数|" + 文本 + "|")
            }
            位置++
            继续
        }
        // ---- 变量声明：查重 + 登记 ----
        如果 (字符串比较(类型, "变量")) {
            如果 (语义::符号表::符号查找(符号表, 文本)) {
                语义::符号表::列表追加(输出, "错误|重复声明 '" + 文本 + "'")
            } 否则 {
                语义::符号表::列表追加(输出, "符号|变量|" + 文本)
                语义::符号表::列表追加(符号表, "变量|" + 文本 + "|")
            }
            位置++
            继续
        }
        // ---- 类型声明登记 ----
        如果 (字符串比较(类型, "结构体") || 字符串比较(类型, "枚举") ||
             字符串比较(类型, "类") || 字符串比较(类型, "泛型类") ||
             字符串比较(类型, "联合体") || 字符串比较(类型, "接口")) {
            如果 (!语义::符号表::符号查找(符号表, 文本)) {
                语义::符号表::列表追加(输出, "符号|类型|" + 文本 + "|" + 类型)
                语义::符号表::列表追加(符号表, "类型|" + 文本 + "|" + 类型)
            }
            位置++
            继续
        }
        // ---- 标识符使用：查符号表 ----
        如果 (字符串比较(类型, "标识符")) {
            如果 (!语义::符号表::符号查找(符号表, 文本) && !语义::内置::是内置函数(文本) &&
                 !语义::内置::是类型关键字(文本) && !字符串比较(文本, "类型") &&
                 !字符串比较(文本, "无")) {
                语义::符号表::列表追加(输出, "错误|未声明的标识符 '" + 文本 + "'")
            }
            位置++
            继续
        }
        位置++
    }
}