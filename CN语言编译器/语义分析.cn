// 自举 Task 7.3：CN 语义分析器（用 CN 重写 C++ 版 semantic，2026-08）
// 对标：src/cn_compiler/semantic（semantic.cpp 核心检查）
// 输入：CN 源码字符串；内部：分词 -> 语法分析（AST dump 行）-> 语义检查。
// 输出：诊断行列表（确定性顺序）：
//   符号|函数|名|参数数       函数声明登记
//   符号|参数|名               参数登记
//   符号|变量|名               变量登记
//   符号|类型|名|种类          结构体/枚举/类/泛型类 登记
//   错误|重复声明 '名'        同作用域重复
//   错误|未声明的标识符 '名'  表达式使用未声明符号
// 注：内置函数（打印/字符串长度/...）与类型关键字预置，使用不报未声明。
导入 容器::向量
导入 词法分析::分词
导入 语法分析::解析

公开:

// 语义分析入口：源码 -> 诊断行列表（入口名 语义检查，避免与模块名 语义分析 冲突）
函数 语义检查(字符串 源码) -> 向量<字符串> {
    向量<字符串> 输出 = 向量<字符串>()
    向量<字符串> AST行 = 解析(源码)
    检查(AST行, 输出)
    返回 输出
}

// ==================== 行工具（AST 行 = 缩进 + 类型|文本） ====================

// 取行类型段（去缩进后 "类型|文本" 的 类型）
函数 行类型(字符串 行) -> 字符串 {
    整64 起 = 0
    布尔 空格 = 字符串比较(字符串子串(行, 0, 1), " ")
    当 (起 < 字符串长度(行) && 空格) {
        起++
        空格 = 字符串比较(字符串子串(行, 起, 1), " ")
    }
    整64 位 = 字符串查找(行, "|")
    如果 (位 < 0) {
        返回 字符串子串(行, 起, 字符串长度(行) - 起)
    }
    返回 字符串子串(行, 起, 位 - 起)
}

// 取行文本段（"类型|文本" 的 文本）
函数 行文本(字符串 行) -> 字符串 {
    整64 位 = 字符串查找(行, "|")
    如果 (位 < 0) {
        返回 ""
    }
    返回 字符串子串(行, 位 + 1, 字符串长度(行) - 位 - 1)
}

// ==================== 符号表（线性查找向量） ====================

// 符号行格式："种类|名|细节"——按 名 查找
函数 符号查找(向量<字符串> 表, 字符串 名) -> 布尔 {
    整64 i = 0
    当 (i < 表.大小()) {
        字符串 行 = 表.元素(i)
        整64 位 = 字符串查找(行, "|")
        如果 (位 > 0) {
            字符串 符号名 = 字符串子串(行, 位 + 1, 字符串长度(行) - 位 - 1)
            整64 位2 = 字符串查找(符号名, "|")
            如果 (位2 > 0) {
                符号名 = 字符串子串(符号名, 0, 位2)
            }
            如果 (字符串比较(符号名, 名)) {
                返回 真
            }
        }
        i++
    }
    返回 假
}

// 列表追加（结果必须检查——追加 返回 结果<空类型,整32>，失败报内存错误）
函数 列表追加(向量<字符串> 列表, 字符串 值) -> 空类型 {
    结果<空类型, 整32> 加 = 列表.追加(值)
    如果 (!加.正常) {
        运行时错误(4)
    }
}

// ==================== 语义检查主流程 ====================

// 内置函数名（预置符号，使用不报未声明）
函数 是内置函数(字符串 名) -> 布尔 {
    返回 字符串比较(名, "打印") || 字符串比较(名, "打印行") ||
           字符串比较(名, "字符串长度") || 字符串比较(名, "字符串比较") ||
           字符串比较(名, "字符串包含") || 字符串比较(名, "字符串子串") ||
           字符串比较(名, "字符串查找") || 字符串比较(名, "整数转字符串") ||
           字符串比较(名, "字节值") || 字符串比较(名, "正常") ||
           字符串比较(名, "错误") || 字符串比较(名, "某些") ||
           字符串比较(名, "类型大小")
}

// 类型关键字（类型位置不查符号表）
函数 是类型关键字(字符串 名) -> 布尔 {
    返回 字符串比较(名, "整8") || 字符串比较(名, "整16") ||
           字符串比较(名, "整32") || 字符串比较(名, "整64") ||
           字符串比较(名, "整128") || 字符串比较(名, "正8") ||
           字符串比较(名, "正16") || 字符串比较(名, "正32") ||
           字符串比较(名, "正64") || 字符串比较(名, "正128") ||
           字符串比较(名, "浮32") || 字符串比较(名, "浮64") ||
           字符串比较(名, "布尔") || 字符串比较(名, "字符") ||
           字符串比较(名, "字符串") || 字符串比较(名, "空类型") ||
           字符串比较(名, "整数") || 字符串比较(名, "小数") ||
           字符串比较(名, "结果") || 字符串比较(名, "可选") ||
           字符串比较(名, "向量") || 字符串比较(名, "数组") ||
           字符串比较(名, "映射") || 字符串比较(名, "队列") ||
           字符串比较(名, "堆栈") || 字符串比较(名, "集合")
}

// 提取函数参数数（文本 "名|参数数=N" -> N）
函数 函数参数数(字符串 文本) -> 字符串 {
    整64 分隔 = 字符串查找(文本, "参数数=")
    如果 (分隔 < 0) {
        返回 "0"
    }
    返回 字符串子串(文本, 分隔 + 10, 字符串长度(文本) - 分隔 - 10)  // "参数数=" UTF-8 10 字节
}

// 提取函数名（文本 "名|参数数=N" -> 名）
函数 函数名(字符串 文本) -> 字符串 {
    整64 分隔 = 字符串查找(文本, "|参数数=")
    如果 (分隔 < 0) {
        返回 文本
    }
    返回 字符串子串(文本, 0, 分隔)
}

// 主检查：逐行扫描 AST，登记符号 + 报告错误
函数 检查(向量<字符串> AST行, 向量<字符串> 输出) -> 空类型 {
    向量<字符串> 符号表 = 向量<字符串>()
    整64 位置 = 0
    当 (位置 < AST行.大小()) {
        字符串 行 = AST行.元素(位置)
        字符串 类型 = 行类型(行)
        字符串 文本 = 行文本(行)
        // ---- 函数/方法声明：登记（含参数数） ----
        如果 (字符串比较(类型, "函数") || 字符串比较(类型, "方法")) {
            // 2026-08 修复：局部变量名避开函数名（函数名(文本) 遮蔽导致
            //   调用被解析为未初始化变量 -> call r11 垃圾地址崩溃）
            字符串 函数名2 = 函数名(文本)
            如果 (!符号查找(符号表, 函数名2)) {
                列表追加(输出, "符号|函数|" + 函数名2 + "|" + 函数参数数(文本))
                列表追加(符号表, "函数|" + 函数名2 + "|" + 函数参数数(文本))
            }
            位置++
            继续
        }
        // ---- 参数登记 ----
        如果 (字符串比较(类型, "参数")) {
            如果 (!符号查找(符号表, 文本)) {
                列表追加(输出, "符号|参数|" + 文本)
                列表追加(符号表, "参数|" + 文本 + "|")
            }
            位置++
            继续
        }
        // ---- 变量声明：查重 + 登记 ----
        如果 (字符串比较(类型, "变量")) {
            如果 (符号查找(符号表, 文本)) {
                列表追加(输出, "错误|重复声明 '" + 文本 + "'")
            } 否则 {
                列表追加(输出, "符号|变量|" + 文本)
                列表追加(符号表, "变量|" + 文本 + "|")
            }
            位置++
            继续
        }
        // ---- 类型声明登记 ----
        如果 (字符串比较(类型, "结构体") || 字符串比较(类型, "枚举") ||
             字符串比较(类型, "类") || 字符串比较(类型, "泛型类") ||
             字符串比较(类型, "联合体") || 字符串比较(类型, "接口")) {
            如果 (!符号查找(符号表, 文本)) {
                列表追加(输出, "符号|类型|" + 文本 + "|" + 类型)
                列表追加(符号表, "类型|" + 文本 + "|" + 类型)
            }
            位置++
            继续
        }
        // ---- 标识符使用：查符号表 ----
        如果 (字符串比较(类型, "标识符")) {
            如果 (!符号查找(符号表, 文本) && !是内置函数(文本) &&
                 !是类型关键字(文本) && !字符串比较(文本, "类型") &&
                 !字符串比较(文本, "无")) {
                列表追加(输出, "错误|未声明的标识符 '" + 文本 + "'")
            }
            位置++
            继续
        }
        位置++
    }
}