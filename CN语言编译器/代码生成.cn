// 自举 Task 7.5 v2（2026-08 完整自举改造）：CN 代码生成器——真实 x64 MASM 后端
// 输入：IR 行（IR 生成器输出）；输出：真实 x64 MASM 文本行（ml64 可汇编、可链接运行）。
// 生成结构：
//   .data：字符串常量池 @strN（UTF-8 字节十六进制，0 结尾）
//   .code：EXTERN 声明 + 函数 PROC/ENDP
//   函数帧：push r12 / push rbp / mov rbp,rsp / sub rsp,F（>4KB 走 __chkstk）
//     槽区 16B×N、求值栈 64×8B（[rbp-F+r12]）、返回缓冲 16B（结构返回）
//   调用约定：Win x64（rcx/rdx/r8/r9 + 影子空间 + 栈参），调用前 rsp 16 对齐
//   结构返回（结果<空类型,整32>）：rcx=隐藏返回缓冲指针；正常 位于偏移 0（dword）
//   方法调用：向量$字符串$*（追加/元素/大小/删除/设置）符号按 C++ 版修饰名硬编码
导入 容器::向量
导入 词法分析::字节值

公开:

// 代码生成入口：IR 行 -> MASM 行列表
函数 代码生成(向量<字符串> IR行) -> 向量<字符串> {
    向量<字符串> 输出 = 向量<字符串>()
    向量<字符串> 常量表 = 向量<字符串>()
    收集常量(IR行, 常量表)
    汇编(IR行, 常量表, 输出)
    返回 输出
}

// ==================== 行工具 ====================

函数 行类型(字符串 行) -> 字符串 {
    整64 位 = 字符串查找(行, "|")
    如果 (位 < 0) {
        返回 行
    }
    返回 字符串子串(行, 0, 位)
}

函数 行文本(字符串 行) -> 字符串 {
    整64 位 = 字符串查找(行, "|")
    如果 (位 < 0) {
        返回 ""
    }
    返回 字符串子串(行, 位 + 1, 字符串长度(行) - 位 - 1)
}

// ==================== 列表追加（结果检查） ====================

函数 列表追加(向量<字符串> 列表, 字符串 值) -> 空类型 {
    结果<空类型, 整32> 加 = 列表.追加(值)
    如果 (!加.正常) {
        运行时错误(4)
    }
}

// ==================== 文本解析 ====================

// 十进制数字串 -> 整数
函数 解析整数(字符串 文本) -> 整64 {
    整64 值 = 0
    整64 i = 0
    当 (i < 字符串长度(文本)) {
        整64 字节 = 字节值(文本, i)
        如果 (字节 >= 48 && 字节 <= 57) {
            值 = 值 * 10 + 字节 - 48
        }
        i++
    }
    返回 值
}

// 字节 -> "0XXh"（MASM 十六进制字节）
函数 字节十六进制(整64 字节) -> 字符串 {
    字符串 表 = "0123456789ABCDEF"
    返回 "0" + 字符转字符串(字节值(表, 字节 / 16)) + 字符转字符串(字节值(表, 字节 % 16)) + "h"
}

// 字节 -> "%02X"（原始两位十六进制，符号修饰用）
函数 字节十六进制2(整64 字节) -> 字符串 {
    字符串 表 = "0123456789ABCDEF"
    返回 字符转字符串(字节值(表, 字节 / 16)) + 字符转字符串(字节值(表, 字节 % 16))
}

// 字符串 -> UTF-8 十六进制（符号修饰 ?XX..@@Y 用）
函数 UTF8十六进制(字符串 文本) -> 字符串 {
    字符串 累积 = ""
    整64 i = 0
    当 (i < 字符串长度(文本)) {
        累积 = 累积 + 字节十六进制2(字节值(文本, i))
        i++
    }
    返回 累积
}

// 字符串字面量解码（去引号、解转义）
函数 解码(字符串 文本) -> 字符串 {
    整64 长度 = 字符串长度(文本)
    如果 (长度 < 2) {
        返回 ""
    }
    字符串 内容 = 字符串子串(文本, 1, 长度 - 2)
    字符串 累积 = ""
    整64 i = 0
    当 (i < 字符串长度(内容)) {
        整64 字节 = 字节值(内容, i)
        如果 (字节 == 92 && i + 1 < 字符串长度(内容)) {
            整64 下一 = 字节值(内容, i + 1)
            如果 (下一 == 110) {
                累积 = 累积 + 字符转字符串(10)
            } 否则 如果 (下一 == 116) {
                累积 = 累积 + 字符转字符串(9)
            } 否则 如果 (下一 == 114) {
                累积 = 累积 + 字符转字符串(13)
            } 否则 如果 (下一 == 92) {
                累积 = 累积 + 字符转字符串(92)
            } 否则 如果 (下一 == 34) {
                累积 = 累积 + 字符转字符串(34)
            } 否则 如果 (下一 == 39) {
                累积 = 累积 + 字符转字符串(39)
            } 否则 {
                累积 = 累积 + 字符转字符串(92)
            }
            i = i + 2
            继续
        }
        累积 = 累积 + 字符转字符串(字节)
        i++
    }
    返回 累积
}

// 字符字面量 'x' / '\u{XXXX}' 的字节值（简化：单字节）
函数 字符值(字符串 文本) -> 整64 {
    整64 长度 = 字符串长度(文本)
    如果 (长度 >= 3) {
        如果 (字节值(文本, 1) == 92) {
            返回 92
        }
        返回 字节值(文本, 1)
    }
    返回 0
}

// 常量表查找（返回序号；未找到返回 -1）
函数 查找序号(向量<字符串> 常量表, 字符串 值) -> 整64 {
    整64 i = 0
    当 (i < 常量表.大小()) {
        如果 (字符串比较(常量表.元素(i), 值)) {
            返回 i
        }
        i++
    }
    返回 -1
}

// ==================== 符号映射 ====================

// CN 符号 -> MASM 链接符号（参数码: C++ 版 mangling 的参数类型码串，如 PAXJ）
// 格式与 C++ 版一致：?hex(名)@@Y<参数码>@Z（有参数）；?hex(名)@@Y（无参数）
函数 汇编符号(字符串 符号, 字符串 参数码) -> 字符串 {
    如果 (字符串比较(符号, "主")) {
        返回 "cn_main"
    }
    // 运行时 / 内置：原样
    如果 (字符串比较(符号, "printLine") || 字符串比较(符号, "printNoLine")) {
        返回 符号
    }
    如果 (字符串长度(符号) >= 5 && 字符串比较(字符串子串(符号, 0, 5), "__cn_")) {
        返回 符号
    }
    如果 (字符串长度(符号) >= 3 && 字符串比较(字符串子串(符号, 0, 3), "cn_")) {
        返回 符号
    }
    // 向量方法：C++ 版修饰名（容器.obj 提供）
    如果 (字符串比较(符号, "向量$字符串$向量")) {
        返回 "?E59091E9878F24E5AD97E7ACA6E4B8B224E59091E9878F@@Y"
    }
    如果 (字符串比较(符号, "向量$字符串$追加")) {
        返回 "?E59091E9878F24E5AD97E7ACA6E4B8B224E8BFBDE58AA0@@YPAX@Z"
    }
    如果 (字符串比较(符号, "向量$字符串$元素")) {
        返回 "?E59091E9878F24E5AD97E7ACA6E4B8B224E58583E7B4A0@@YJ@Z"
    }
    如果 (字符串比较(符号, "向量$字符串$大小")) {
        返回 "?E59091E9878F24E5AD97E7ACA6E4B8B224E5A4A7E5B08F@@Y"
    }
    如果 (字符串比较(符号, "向量$字符串$删除")) {
        返回 "?E59091E9878F24E5AD97E7ACA6E4B8B224E588A0E999A4@@YJ@Z"
    }
    如果 (字符串比较(符号, "向量$字符串$设置")) {
        返回 "?E59091E9878F24E5AD97E7ACA6E4B8B224E8AEBEE7BDAE@@YJPAX@Z"
    }
    // 模块函数：? + UTF-8 十六进制 + @@Y（+ 参数码 + @Z 当有参数）
    如果 (字符串长度(参数码) > 0) {
        返回 "?" + UTF8十六进制(符号) + "@@Y" + 参数码 + "@Z"
    }
    返回 "?" + UTF8十六进制(符号) + "@@Y"
}

// 函数是否已在本模块定义
函数 已定义(向量<字符串> IR行, 字符串 符号) -> 布尔 {
    整64 位置 = 0
    当 (位置 < IR行.大小()) {
        字符串 行 = IR行.元素(位置)
        如果 (字符串比较(行类型(行), "函数") &&
             字符串比较(行类型(行文本(行)), 符号)) {
            返回 真
        }
        位置++
    }
    返回 假
}

// 符号是否固定 EXTERN（运行时/向量方法）
函数 固定外部(字符串 符号) -> 布尔 {
    如果 (字符串比较(符号, "printLine") || 字符串比较(符号, "printNoLine")) {
        返回 真
    }
    如果 (字符串长度(符号) >= 5 && 字符串比较(字符串子串(符号, 0, 5), "__cn_")) {
        返回 真
    }
    如果 (字符串长度(符号) >= 3 && 字符串比较(字符串子串(符号, 0, 3), "cn_")) {
        返回 真
    }
    如果 (字符串长度(符号) >= 6 && 字符串比较(字符串子串(符号, 0, 6), "向量$字符串$")) {
        返回 真
    }
    返回 假
}

// ==================== 常量收集（pass 1） ====================

函数 收集常量(向量<字符串> IR行, 向量<字符串> 常量表) -> 空类型 {
    整64 位置 = 0
    当 (位置 < IR行.大小()) {
        字符串 行 = IR行.元素(位置)
        字符串 类型 = 行类型(行)
        如果 (字符串比较(类型, "字符串")) {
            字符串 值 = 解码(行文本(行))
            如果 (查找序号(常量表, 值) < 0) {
                列表追加(常量表, 值)
            }
        } 否则 如果 (字符串比较(类型, "字面量")) {
            字符串 文本 = 行文本(行)
            如果 (字符串长度(文本) > 0 && 字符串比较(字符串子串(文本, 0, 1), "\"")) {
                字符串 值 = 解码(文本)
                如果 (查找序号(常量表, 值) < 0) {
                    列表追加(常量表, 值)
                }
            }
        }
        位置++
    }
}

// ==================== 汇编主流程 ====================

函数 汇编(向量<字符串> IR行, 向量<字符串> 常量表, 向量<字符串> 输出) -> 空类型 {
    列表追加(输出, "; ============================================")
    列表追加(输出, "; CN语言编译器生成代码（Task 7.5 v2 自举后端）")
    列表追加(输出, "; 目标平台: win-x64")
    列表追加(输出, "; 汇编格式: Win x64 MASM")
    列表追加(输出, "; ============================================")
    列表追加(输出, "")
    // ---- .data ----
    列表追加(输出, ".data")
    整64 i = 0
    当 (i < 常量表.大小()) {
        发射字符串常量(输出, "@str" + 整数转字符串(i), 常量表.元素(i))
        i++
    }
    列表追加(输出, "")
    // ---- .code ----
    列表追加(输出, ".code")
    发射EXTERN(IR行, 输出)
    列表追加(输出, "")
    // ---- 函数 ----
    整64 位置 = 0
    当 (位置 < IR行.大小()) {
        字符串 行 = IR行.元素(位置)
        如果 (字符串比较(行类型(行), "函数")) {
            位置 = 发射函数(IR行, 位置, 常量表, 输出)
        } 否则 {
            位置++
        }
    }
    列表追加(输出, "END")
}

// 发射 .data 字符串常量（每行 ≤16 字节，0 结尾）
函数 发射字符串常量(向量<字符串> 输出, 字符串 标签, 字符串 文本) -> 空类型 {
    字符串 行 = 标签 + " db "
    整64 i = 0
    整64 计数 = 0
    当 (i < 字符串长度(文本)) {
        如果 (计数 == 16) {
            列表追加(输出, 行)
            行 = "      db "
            计数 = 0
        }
        如果 (计数 > 0) {
            行 = 行 + ","
        }
        行 = 行 + 字节十六进制(字节值(文本, i))
        计数++
        i++
    }
    如果 (计数 > 0) {
        列表追加(输出, 行)
    } 否则 {
        列表追加(输出, 标签 + " db 0")
        返回
    }
    列表追加(输出, "      db 0")
}

// 发射 EXTERN 声明：固定运行时 + 模块外被调函数
函数 发射EXTERN(向量<字符串> IR行, 向量<字符串> 输出) -> 空类型 {
    列表追加(输出, "EXTERN printLine:PROC")
    列表追加(输出, "EXTERN printNoLine:PROC")
    列表追加(输出, "EXTERN __chkstk:PROC")
    列表追加(输出, "EXTERN __cn_runtime_error:PROC")
    列表追加(输出, "EXTERN __cn_object_new:PROC")
    列表追加(输出, "EXTERN __cn_str_len:PROC")
    列表追加(输出, "EXTERN __cn_str_eq:PROC")
    列表追加(输出, "EXTERN __cn_str_find:PROC")
    列表追加(输出, "EXTERN __cn_str_sub:PROC")
    列表追加(输出, "EXTERN __cn_str_contains:PROC")
    列表追加(输出, "EXTERN __cn_str_concat:PROC")
    列表追加(输出, "EXTERN __cn_str_from_int:PROC")
    列表追加(输出, "EXTERN __cn_str_from_char:PROC")
    列表追加(输出, "EXTERN ?E59091E9878F24E5AD97E7ACA6E4B8B224E59091E9878F@@Y:PROC")
    列表追加(输出, "EXTERN ?E59091E9878F24E5AD97E7ACA6E4B8B224E8BFBDE58AA0@@YPAX@Z:PROC")
    列表追加(输出, "EXTERN ?E59091E9878F24E5AD97E7ACA6E4B8B224E58583E7B4A0@@YJ@Z:PROC")
    列表追加(输出, "EXTERN ?E59091E9878F24E5AD97E7ACA6E4B8B224E5A4A7E5B08F@@Y:PROC")
    列表追加(输出, "EXTERN ?E59091E9878F24E5AD97E7ACA6E4B8B224E588A0E999A4@@YJ@Z:PROC")
    列表追加(输出, "EXTERN ?E59091E9878F24E5AD97E7ACA6E4B8B224E8AEBEE7BDAE@@YJPAX@Z:PROC")
    // 模块外被调函数（跨模块：词法分析$分词 / 语法分析$解析 等）
    向量<字符串> 已发 = 向量<字符串>()
    整64 位置 = 0
    当 (位置 < IR行.大小()) {
        字符串 行 = IR行.元素(位置)
        如果 (字符串比较(行类型(行), "调用")) {
            字符串 符号 = 行类型(行文本(行))
            字符串 参数码 = 行文本(行文本(行文本(行文本(行))))
            如果 (!固定外部(符号) && !已定义(IR行, 符号) &&
                 查找序号(已发, 符号) < 0) {
                列表追加(输出, "EXTERN " + 汇编符号(符号, 参数码) + ":PROC")
                列表追加(已发, 符号)
            }
        }
        位置++
    }
}

// ==================== 槽表 ====================

// 查槽（"名|槽"；未找到返回 -1）
函数 查槽(向量<字符串> 变量表, 字符串 名) -> 整64 {
    整64 i = 0
    当 (i < 变量表.大小()) {
        字符串 记录 = 变量表.元素(i)
        如果 (字符串比较(行类型(记录), 名)) {
            返回 解析整数(行文本(记录))
        }
        i++
    }
    返回 -1
}

// 是否引用参数
函数 是引用(向量<字符串> 引用表, 字符串 名) -> 布尔 {
    整64 i = 0
    当 (i < 引用表.大小()) {
        如果 (字符串比较(引用表.元素(i), 名)) {
            返回 真
        }
        i++
    }
    返回 假
}

// ==================== 求值栈原语 ====================

// 压栈（F = 16*槽数+544；es[i] 位于 [rbp-F+8i]）
函数 压栈(整64 槽数, 向量<字符串> 输出) -> 空类型 {
    列表追加(输出, "mov [rbp-" + 整数转字符串(槽数 * 16 + 544) + "+r12], rax")
    列表追加(输出, "add r12, 8")
}

// 弹到 rax
函数 弹出rax(整64 槽数, 向量<字符串> 输出) -> 空类型 {
    列表追加(输出, "sub r12, 8")
    列表追加(输出, "mov rax, [rbp-" + 整数转字符串(槽数 * 16 + 544) + "+r12]")
}

// 弹到 rdx
函数 弹出rdx(整64 槽数, 向量<字符串> 输出) -> 空类型 {
    列表追加(输出, "sub r12, 8")
    列表追加(输出, "mov rdx, [rbp-" + 整数转字符串(槽数 * 16 + 544) + "+r12]")
}

// 弹到 rcx
函数 弹出rcx(整64 槽数, 向量<字符串> 输出) -> 空类型 {
    列表追加(输出, "sub r12, 8")
    列表追加(输出, "mov rcx, [rbp-" + 整数转字符串(槽数 * 16 + 544) + "+r12]")
}

// 尾声（mov rsp,rbp / pop rbp / pop r12 / ret）
函数 尾声(向量<字符串> 输出) -> 空类型 {
    列表追加(输出, "mov rsp, rbp")
    列表追加(输出, "pop rbp")
    列表追加(输出, "pop r12")
    列表追加(输出, "ret")
}

// ==================== 函数发射 ====================

函数 发射函数(向量<字符串> IR行, 整64 起始, 向量<字符串> 常量表,
             向量<字符串> 输出) -> 整64 {
    字符串 行 = IR行.元素(起始)
    字符串 符号 = 行类型(行文本(行))
    字符串 参数码 = 行文本(行文本(行文本(行)))
    整64 参数个数 = 解析整数(行类型(行文本(行文本(行))))
    // ---- 槽表收集 ----
    向量<字符串> 变量表 = 向量<字符串>()
    向量<字符串> 引用表 = 向量<字符串>()
    整64 位置 = 起始 + 1
    当 (位置 < IR行.大小()) {
        字符串 行2 = IR行.元素(位置)
        字符串 类型2 = 行类型(行2)
        如果 (字符串比较(类型2, "函数")) {
            中断
        }
        如果 (字符串比较(类型2, "参数")) {
            字符串 文本2 = 行文本(行2)
            列表追加(变量表, 行类型(文本2) + "|" + 整数转字符串(变量表.大小()))
            如果 (字符串比较(行文本(文本2), "引用")) {
                列表追加(引用表, 行类型(文本2))
            }
        } 否则 如果 (字符串比较(类型2, "分配")) {
            列表追加(变量表, 行文本(行2) + "|" + 整数转字符串(变量表.大小()))
        }
        位置++
    }
    整64 槽数 = 变量表.大小()
    整64 帧大小 = 槽数 * 16 + 544
    // ---- PROC 头 ----
    列表追加(输出, "; 函数 " + 符号)
    列表追加(输出, 汇编符号(符号, 参数码) + " PROC")
    列表追加(输出, "push r12")
    列表追加(输出, "push rbp")
    列表追加(输出, "mov rbp, rsp")
    如果 (帧大小 > 4096) {
        列表追加(输出, "mov rax, " + 整数转字符串(帧大小))
        列表追加(输出, "call __chkstk")
        列表追加(输出, "sub rsp, rax")
    } 否则 {
        列表追加(输出, "sub rsp, " + 整数转字符串(帧大小))
    }
    // ---- 参数装载 ----
    整64 i = 0
    当 (i < 参数个数) {
        如果 (i < 4) {
            字符串 寄存器 = "rcx"
            如果 (i == 1) { 寄存器 = "rdx" }
            如果 (i == 2) { 寄存器 = "r8" }
            如果 (i == 3) { 寄存器 = "r9" }
            列表追加(输出, "mov [rbp-" + 整数转字符串(16 * (i + 1)) + "], " + 寄存器)
        } 否则 {
            列表追加(输出, "mov rax, [rbp+" + 整数转字符串(40 + 8 * (i - 4)) + "]")
            列表追加(输出, "mov [rbp-" + 整数转字符串(16 * (i + 1)) + "], rax")
        }
        i++
    }
    列表追加(输出, "mov r12, 0")
    // ---- 指令序列 ----
    位置 = 起始 + 1
    当 (位置 < IR行.大小()) {
        字符串 行2 = IR行.元素(位置)
        字符串 类型2 = 行类型(行2)
        如果 (字符串比较(类型2, "函数")) {
            中断
        }
        如果 (字符串比较(类型2, "参数") || 字符串比较(类型2, "分配")) {
            位置++
            继续
        }
        位置 = 发射指令(行2, 位置 + 1, 常量表, 变量表, 引用表, 槽数, 输出)
    }
    // ---- 回落到函数末尾 ----
    尾声(输出)
    列表追加(输出, 汇编符号(符号, 参数码) + " ENDP")
    列表追加(输出, "")
    返回 位置
}

// ==================== 指令发射 ====================

// ==================== 指令发射（分发器，≤100 行约束） ====================

函数 发射指令(字符串 行, 整64 位置, 向量<字符串> 常量表,
             向量<字符串> 变量表, 向量<字符串> 引用表, 整64 槽数,
             向量<字符串> 输出) -> 整64 {
    字符串 类型 = 行类型(行)
    字符串 文本 = 行文本(行)
    如果 (字符串比较(类型, "字面量")) {
        发射字面量(文本, 常量表, 槽数, 输出)
        返回 位置
    }
    如果 (字符串比较(类型, "字符串")) {
        发射字符串引用(文本, 常量表, 槽数, 输出)
        返回 位置
    }
    如果 (字符串比较(类型, "加载")) {
        发射加载(文本, 变量表, 引用表, 槽数, 输出)
        返回 位置
    }
    如果 (字符串比较(类型, "压址")) {
        发射压址(文本, 变量表, 槽数, 输出)
        返回 位置
    }
    如果 (字符串比较(类型, "存储")) {
        发射存储(文本, 变量表, 引用表, 槽数, 输出)
        返回 位置
    }
    如果 (字符串比较(类型, "复制结果")) {
        发射复制结果(文本, 变量表, 槽数, 输出)
        返回 位置
    }
    如果 (字符串比较(类型, "运算")) {
        发射运算(文本, 槽数, 输出)
        返回 位置
    }
    如果 (字符串比较(类型, "加载成员")) {
        发射加载成员(文本, 变量表, 槽数, 输出)
        返回 位置
    }
    如果 (字符串比较(类型, "调用")) {
        发射调用(文本, 槽数, 输出)
        返回 位置
    }
    如果 (字符串比较(类型, "返回")) {
        弹出rax(槽数, 输出)
        尾声(输出)
        返回 位置
    }
    如果 (字符串比较(类型, "返回空")) {
        尾声(输出)
        返回 位置
    }
    如果 (字符串比较(类型, "递增") || 字符串比较(类型, "递减")) {
        发射递增递减(类型, 文本, 变量表, 引用表, 槽数, 输出)
        返回 位置
    }
    如果 (字符串比较(类型, "标签")) {
        列表追加(输出, 文本 + ":")
        返回 位置
    }
    如果 (字符串比较(类型, "跳转")) {
        列表追加(输出, "jmp " + 文本)
        返回 位置
    }
    如果 (字符串比较(类型, "跳转真")) {
        弹出rax(槽数, 输出)
        列表追加(输出, "test rax, rax")
        列表追加(输出, "jnz " + 文本)
        返回 位置
    }
    如果 (字符串比较(类型, "跳转假")) {
        弹出rax(槽数, 输出)
        列表追加(输出, "test rax, rax")
        列表追加(输出, "jz " + 文本)
        返回 位置
    }
    返回 位置
}

// 字符串常量引用（常量表查找；缺失时补登记）
函数 发射字符串引用(字符串 文本, 向量<字符串> 常量表, 整64 槽数,
                 向量<字符串> 输出) -> 空类型 {
    整64 序号 = 查找序号(常量表, 解码(文本))
    如果 (序号 < 0) {
        列表追加(常量表, 解码(文本))
        序号 = 常量表.大小() - 1
    }
    列表追加(输出, "lea rax, @str" + 整数转字符串(序号))
    压栈(槽数, 输出)
}

// 变量加载（引用参数解引用）
函数 发射加载(字符串 文本, 向量<字符串> 变量表, 向量<字符串> 引用表,
            整64 槽数, 向量<字符串> 输出) -> 空类型 {
    整64 槽 = 查槽(变量表, 文本)
    列表追加(输出, "mov rax, [rbp-" + 整数转字符串(16 * (槽 + 1)) + "]")
    如果 (是引用(引用表, 文本)) {
        列表追加(输出, "mov rax, [rax]")
    }
    压栈(槽数, 输出)
}

// 引用参数取址（传槽地址 lea）
函数 发射压址(字符串 文本, 向量<字符串> 变量表, 整64 槽数,
           向量<字符串> 输出) -> 空类型 {
    整64 槽 = 查槽(变量表, 文本)
    列表追加(输出, "lea rax, [rbp-" + 整数转字符串(16 * (槽 + 1)) + "]")
    压栈(槽数, 输出)
}

// 赋值存储（引用参数解引用写）
函数 发射存储(字符串 文本, 向量<字符串> 变量表, 向量<字符串> 引用表,
            整64 槽数, 向量<字符串> 输出) -> 空类型 {
    整64 槽 = 查槽(变量表, 文本)
    弹出rax(槽数, 输出)
    如果 (是引用(引用表, 文本)) {
        列表追加(输出, "mov rcx, [rbp-" + 整数转字符串(16 * (槽 + 1)) + "]")
        列表追加(输出, "mov [rcx], rax")
    } 否则 {
        列表追加(输出, "mov [rbp-" + 整数转字符串(16 * (槽 + 1)) + "], rax")
    }
}

// 结构返回结果拷贝（retbuf 16B -> 槽）
函数 发射复制结果(字符串 文本, 向量<字符串> 变量表, 整64 槽数,
               向量<字符串> 输出) -> 空类型 {
    整64 槽 = 查槽(变量表, 文本)
    列表追加(输出, "mov rax, [rbp-" + 整数转字符串(槽数 * 16 + 32) + "]")
    列表追加(输出, "mov [rbp-" + 整数转字符串(16 * (槽 + 1)) + "], rax")
    列表追加(输出, "mov rax, [rbp-" + 整数转字符串(槽数 * 16 + 40) + "]")
    列表追加(输出, "mov [rbp-" + 整数转字符串(16 * (槽 + 1) + 8) + "], rax")
}

// 结果.正常 字段读取（dword 归一化：setne——正常 本身 0/1 归一）
函数 发射加载成员(字符串 文本, 向量<字符串> 变量表, 整64 槽数,
               向量<字符串> 输出) -> 空类型 {
    整64 槽 = 查槽(变量表, 行类型(文本))
    列表追加(输出, "mov eax, [rbp-" + 整数转字符串(16 * (槽 + 1)) + "]")
    列表追加(输出, "cmp eax, 0")
    列表追加(输出, "setne al")
    列表追加(输出, "movzx eax, al")
    压栈(槽数, 输出)
}

// 递增/递减（引用参数解引用）
函数 发射递增递减(字符串 类型, 字符串 文本, 向量<字符串> 变量表,
              向量<字符串> 引用表, 整64 槽数, 向量<字符串> 输出) -> 空类型 {
    整64 槽 = 查槽(变量表, 文本)
    如果 (是引用(引用表, 文本)) {
        列表追加(输出, "mov rcx, [rbp-" + 整数转字符串(16 * (槽 + 1)) + "]")
        列表追加(输出, "mov rax, [rcx]")
        如果 (字符串比较(类型, "递增")) {
            列表追加(输出, "add rax, 1")
        } 否则 {
            列表追加(输出, "sub rax, 1")
        }
        列表追加(输出, "mov [rcx], rax")
    } 否则 {
        列表追加(输出, "mov rax, [rbp-" + 整数转字符串(16 * (槽 + 1)) + "]")
        如果 (字符串比较(类型, "递增")) {
            列表追加(输出, "add rax, 1")
        } 否则 {
            列表追加(输出, "sub rax, 1")
        }
        列表追加(输出, "mov [rbp-" + 整数转字符串(16 * (槽 + 1)) + "], rax")
    }
}
// ==================== 字面量发射 ====================

函数 发射字面量(字符串 文本, 向量<字符串> 常量表, 整64 槽数,
             向量<字符串> 输出) -> 空类型 {
    如果 (字符串比较(文本, "真")) {
        列表追加(输出, "mov rax, 1")
    } 否则 如果 (字符串比较(文本, "假")) {
        列表追加(输出, "mov rax, 0")
    } 否则 如果 (字符串长度(文本) > 0 && 字符串比较(字符串子串(文本, 0, 1), "\"")) {
        整64 序号 = 查找序号(常量表, 解码(文本))
        如果 (序号 < 0) {
            列表追加(常量表, 解码(文本))
            序号 = 常量表.大小() - 1
        }
        列表追加(输出, "lea rax, @str" + 整数转字符串(序号))
    } 否则 如果 (字符串长度(文本) > 0 && 字符串比较(字符串子串(文本, 0, 1), "'")) {
        列表追加(输出, "mov rax, " + 整数转字符串(字符值(文本)))
    } 否则 {
        列表追加(输出, "mov rax, " + 文本)
    }
    压栈(槽数, 输出)
}

// ==================== 运算发射 ====================
// ==================== 运算发射（分发器） ====================

函数 发射运算(字符串 符号, 整64 槽数, 向量<字符串> 输出) -> 空类型 {
    如果 (字符串比较(符号, "+") || 字符串比较(符号, "-") ||
         字符串比较(符号, "*") || 字符串比较(符号, "/") ||
         字符串比较(符号, "%")) {
        发射运算算术(符号, 槽数, 输出)
        返回
    }
    如果 (字符串比较(符号, "<<") || 字符串比较(符号, ">>")) {
        发射运算移位(符号, 槽数, 输出)
        返回
    }
    如果 (字符串比较(符号, "&") || 字符串比较(符号, "|") ||
         字符串比较(符号, "^")) {
        发射运算位(符号, 槽数, 输出)
        返回
    }
    如果 (字符串比较(符号, "==") || 字符串比较(符号, "!=") ||
         字符串比较(符号, "<") || 字符串比较(符号, "<=") ||
         字符串比较(符号, ">") || 字符串比较(符号, ">=")) {
        发射运算比较(符号, 槽数, 输出)
        返回
    }
    如果 (字符串比较(符号, "&&") || 字符串比较(符号, "||") ||
         字符串比较(符号, "非") || 字符串比较(符号, "取负") ||
         字符串比较(符号, "取反") || 字符串比较(符号, "下标字节") ||
         字符串比较(符号, "复制栈顶") || 字符串比较(符号, "弹出")) {
        发射运算逻辑(符号, 槽数, 输出)
        返回
    }
    如果 (字符串比较(符号, "+字")) {
        弹出rdx(槽数, 输出)
        弹出rcx(槽数, 输出)
        列表追加(输出, "sub rsp, 40")
        列表追加(输出, "call __cn_str_concat")
        列表追加(输出, "add rsp, 40")
        压栈(槽数, 输出)
        返回
    }
    如果 (字符串比较(符号, "+=") || 字符串比较(符号, "-=") ||
         字符串比较(符号, "*=") || 字符串比较(符号, "/=") ||
         字符串比较(符号, "%=")) {
        发射运算赋值(符号, 槽数, 输出)
        返回
    }
}

// 算术运算（+ - * / %）
函数 发射运算算术(字符串 符号, 整64 槽数, 向量<字符串> 输出) -> 空类型 {
    弹出rdx(槽数, 输出)
    弹出rax(槽数, 输出)
    如果 (字符串比较(符号, "+")) {
        列表追加(输出, "add rax, rdx")
    } 否则 如果 (字符串比较(符号, "-")) {
        列表追加(输出, "sub rax, rdx")
    } 否则 如果 (字符串比较(符号, "*")) {
        列表追加(输出, "imul rax, rdx")
    } 否则 如果 (字符串比较(符号, "/")) {
        列表追加(输出, "cqo")
        列表追加(输出, "idiv rdx")
    } 否则 {
        列表追加(输出, "cqo")
        列表追加(输出, "idiv rdx")
        列表追加(输出, "mov rax, rdx")
    }
    压栈(槽数, 输出)
}

// 移位运算（<< >>）
函数 发射运算移位(字符串 符号, 整64 槽数, 向量<字符串> 输出) -> 空类型 {
    弹出rdx(槽数, 输出)
    弹出rax(槽数, 输出)
    列表追加(输出, "mov rcx, rdx")
    如果 (字符串比较(符号, "<<")) {
        列表追加(输出, "shl rax, cl")
    } 否则 {
        列表追加(输出, "sar rax, cl")
    }
    压栈(槽数, 输出)
}

// 位运算（& | ^）
函数 发射运算位(字符串 符号, 整64 槽数, 向量<字符串> 输出) -> 空类型 {
    弹出rdx(槽数, 输出)
    弹出rax(槽数, 输出)
    如果 (字符串比较(符号, "&")) {
        列表追加(输出, "and rax, rdx")
    } 否则 如果 (字符串比较(符号, "|")) {
        列表追加(输出, "or rax, rdx")
    } 否则 {
        列表追加(输出, "xor rax, rdx")
    }
    压栈(槽数, 输出)
}

// 比较运算（== != < <= > >=）
函数 发射运算比较(字符串 符号, 整64 槽数, 向量<字符串> 输出) -> 空类型 {
    弹出rdx(槽数, 输出)
    弹出rax(槽数, 输出)
    列表追加(输出, "cmp rax, rdx")
    如果 (字符串比较(符号, "==")) {
        列表追加(输出, "sete al")
    } 否则 如果 (字符串比较(符号, "!=")) {
        列表追加(输出, "setne al")
    } 否则 如果 (字符串比较(符号, "<")) {
        列表追加(输出, "setl al")
    } 否则 如果 (字符串比较(符号, "<=")) {
        列表追加(输出, "setle al")
    } 否则 如果 (字符串比较(符号, ">")) {
        列表追加(输出, "setg al")
    } 否则 {
        列表追加(输出, "setge al")
    }
    列表追加(输出, "movzx eax, al")
    压栈(槽数, 输出)
}

// 逻辑/一元/栈运算（&& || 非 取负 取反 下标字节 复制栈顶 弹出）
函数 发射运算逻辑(字符串 符号, 整64 槽数, 向量<字符串> 输出) -> 空类型 {
    如果 (字符串比较(符号, "&&")) {
        弹出rdx(槽数, 输出)
        弹出rax(槽数, 输出)
        列表追加(输出, "and rax, rdx")
        压栈(槽数, 输出)
        返回
    }
    如果 (字符串比较(符号, "||")) {
        弹出rdx(槽数, 输出)
        弹出rax(槽数, 输出)
        列表追加(输出, "or rax, rdx")
        压栈(槽数, 输出)
        返回
    }
    如果 (字符串比较(符号, "非")) {
        弹出rax(槽数, 输出)
        列表追加(输出, "cmp rax, 0")
        列表追加(输出, "sete al")
        列表追加(输出, "movzx eax, al")
        压栈(槽数, 输出)
        返回
    }
    如果 (字符串比较(符号, "取负")) {
        弹出rax(槽数, 输出)
        列表追加(输出, "neg rax")
        压栈(槽数, 输出)
        返回
    }
    如果 (字符串比较(符号, "取反")) {
        弹出rax(槽数, 输出)
        列表追加(输出, "not rax")
        压栈(槽数, 输出)
        返回
    }
    如果 (字符串比较(符号, "下标字节")) {
        弹出rdx(槽数, 输出)
        弹出rax(槽数, 输出)
        列表追加(输出, "movsx rax, byte ptr [rax+rdx]")
        压栈(槽数, 输出)
        返回
    }
    如果 (字符串比较(符号, "复制栈顶")) {
        列表追加(输出, "mov rax, [rbp-" + 整数转字符串(槽数 * 16 + 544) + "+r12-8]")
        压栈(槽数, 输出)
        返回
    }
    如果 (字符串比较(符号, "弹出")) {
        列表追加(输出, "sub r12, 8")
        返回
    }
}

// 赋值族（+= -= *= /= %=）
函数 发射运算赋值(字符串 符号, 整64 槽数, 向量<字符串> 输出) -> 空类型 {
    弹出rdx(槽数, 输出)
    弹出rax(槽数, 输出)
    如果 (字符串比较(符号, "+=")) {
        列表追加(输出, "add rax, rdx")
    } 否则 如果 (字符串比较(符号, "-=")) {
        列表追加(输出, "sub rax, rdx")
    } 否则 如果 (字符串比较(符号, "*=")) {
        列表追加(输出, "imul rax, rdx")
    } 否则 如果 (字符串比较(符号, "/=")) {
        列表追加(输出, "cqo")
        列表追加(输出, "idiv rdx")
    } 否则 {
        列表追加(输出, "cqo")
        列表追加(输出, "idiv rdx")
        列表追加(输出, "mov rax, rdx")
    }
    压栈(槽数, 输出)
}
// ==================== 调用发射 ====================

// 文本 = "符号|参数数|标志"（0=函数 1=方法 2=方法+结构 3=构造）
函数 发射调用(字符串 文本, 整64 槽数, 向量<字符串> 输出) -> 空类型 {
    字符串 符号 = 行类型(文本)
    字符串 细节 = 行文本(文本)
    字符串 参数数文本 = 行类型(细节)
    字符串 标志 = 行类型(行文本(细节))
    字符串 参数码 = 行文本(行文本(细节))
    整64 参数个数 = 解析整数(参数数文本)
    // ---- 构造：__cn_object_new(24) + 构造函数（构造为 空类型 返回——
    //   对象须保留 __cn_object_new 的结果，经 返回缓冲槽 中转） ----
    如果 (字符串比较(标志, "3")) {
        列表追加(输出, "mov rcx, 24")
        列表追加(输出, "sub rsp, 40")
        列表追加(输出, "call __cn_object_new")
        列表追加(输出, "add rsp, 40")
        列表追加(输出, "mov [rbp-" + 整数转字符串(槽数 * 16 + 32) + "], rax")
        列表追加(输出, "mov rcx, rax")
        列表追加(输出, "sub rsp, 40")
        列表追加(输出, "call " + 汇编符号("向量$字符串$向量", ""))
        列表追加(输出, "add rsp, 40")
        列表追加(输出, "mov rax, [rbp-" + 整数转字符串(槽数 * 16 + 32) + "]")
        压栈(槽数, 输出)
        返回
    }
    // ---- ABI 参数数 ----
    整64 abi = 参数个数
    如果 (字符串比较(标志, "1")) {
        abi = 参数个数 + 1
    }
    如果 (字符串比较(标志, "2")) {
        abi = 参数个数 + 2
    }
    整64 栈参 = abi - 4
    如果 (栈参 < 0) {
        栈参 = 0
    }
    整64 间距 = 32 + 8 * 栈参
    // Win x64：调用点 rsp 须 16 对齐（原条件写反：已对齐时 +8 反致错位，
    //   运行时 memcpy/SSE 路径在错位栈上崩 0xC0000005）
    如果 (间距 % 16 == 0) {
        间距 = 间距 + 8
    }
    // 影子空间恒保留（Win x64：调用方须预留 32B，即使无栈参）
    列表追加(输出, "sub rsp, " + 整数转字符串(间距))
    // ---- 参数装载（参数为求值栈顶 Nargs 项，r12 相对寻址） ----
    整64 栈参个数 = abi
    如果 (字符串比较(标志, "2")) {
        栈参个数 = abi - 1
    }
    整64 j = 0
    当 (j < abi) {
        如果 (字符串比较(标志, "2")) {
            如果 (j == 0) {
                列表追加(输出, "lea rcx, [rbp-" + 整数转字符串(槽数 * 16 + 32) + "]")
            } 否则 {
                发射装载参数(j, j - 1, 槽数, 栈参个数, 输出)
            }
        } 否则 {
            发射装载参数(j, j, 槽数, 栈参个数, 输出)
        }
        j++
    }
    列表追加(输出, "call " + 汇编符号(符号, 参数码))
    列表追加(输出, "add rsp, " + 整数转字符串(间距))
    // ---- 弹出求值栈参数（retbuf 不在栈上） ----
    如果 (栈参个数 > 0) {
        列表追加(输出, "sub r12, " + 整数转字符串(8 * 栈参个数))
    }
    // ---- 结果 ----
    如果 (字符串比较(标志, "2")) {
        // 结构返回：结果留在返回缓冲（复制结果 指令负责搬运）
    } 否则 {
        压栈(槽数, 输出)
    }
}

// 装载 abi 位置 j 的参数（来源求值栈顶第 e 项；位移 = F + 8*Nargs - 8*e）
函数 发射装载参数(整64 j, 整64 e, 整64 槽数, 整64 栈参个数,
             向量<字符串> 输出) -> 空类型 {
    整64 位移 = 槽数 * 16 + 544 + 8 * 栈参个数 - 8 * e
    如果 (j < 4) {
        字符串 寄存器 = "rcx"
        如果 (j == 1) { 寄存器 = "rdx" }
        如果 (j == 2) { 寄存器 = "r8" }
        如果 (j == 3) { 寄存器 = "r9" }
        列表追加(输出, "mov " + 寄存器 + ", [rbp-" + 整数转字符串(位移) + "+r12]")
    } 否则 {
        列表追加(输出, "mov rax, [rbp-" + 整数转字符串(位移) + "+r12]")
        列表追加(输出, "mov [rsp+" + 整数转字符串(32 + 8 * (j - 4)) + "], rax")
    }
}