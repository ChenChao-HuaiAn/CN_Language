// 自举 Task 7.5：CN 代码生成器（用 CN 重写 C++ 版 codegen，2026-08）
// 对标：src/cn_compiler/codegen（x64 后端核心映射）
// 输入：IR 行（IR 生成器输出）；输出：简化 x64 伪汇编行（确定性顺序）：
//   段|.code            代码段标记（首个函数前）
//   函数|名              函数标签
//   汇编|参数|名         参数登记（符号表）
//   汇编|分配|名         变量分配（符号表）
//   汇编|mov rax, 值     常量载入
//   汇编|mov rax, [名]   变量加载
//   汇编|运算|符号       算术/逻辑运算
//   汇编|call 名|N       函数调用
//   汇编|ret             返回
//   汇编|分支|种类       控制流标签
导入 容器::向量

公开:

// 代码生成入口：IR 行 -> 伪汇编行
函数 代码生成(向量<字符串> IR行) -> 向量<字符串> {
    向量<字符串> 输出 = 向量<字符串>()
    汇编(IR行, 输出)
    返回 输出
}

// ==================== 行工具 ====================

函数 行类型(字符串 行) -> 字符串 {
    整64 位 = 字符串查找(行, "|")
    如果 (位 < 0) {
        返回 行
    }
    返回 字符串子串(行, 0, 位)
}

函数 行文本(字符串 行) -> 字符串 {
    整64 位 = 字符串查找(行, "|")
    如果 (位 < 0) {
        返回 ""
    }
    返回 字符串子串(行, 位 + 1, 字符串长度(行) - 位 - 1)
}

// ==================== 列表追加 ====================

函数 列表追加(向量<字符串> 列表, 字符串 值) -> 空类型 {
    结果<空类型, 整32> 加 = 列表.追加(值)
    如果 (!加.正常) {
        运行时错误(4)
    }
}

// ==================== 汇编生成主流程 ====================

函数 汇编(向量<字符串> IR行, 向量<字符串> 输出) -> 空类型 {
    整64 位置 = 0
    布尔 已出段 = 假
    当 (位置 < IR行.大小()) {
        字符串 行 = IR行.元素(位置)
        字符串 类型 = 行类型(行)
        字符串 文本 = 行文本(行)
        // ---- 函数头：段标记 + 函数标签 ----
        如果 (字符串比较(类型, "函数")) {
            如果 (!已出段) {
                列表追加(输出, "段|.code")
                已出段 = 真
            }
            列表追加(输出, "函数|" + 文本)
            位置++
            继续
        }
        // ---- 指令行：按子类型映射汇编 ----
        如果 (字符串比较(类型, "指令")) {
            字符串 指令类型 = 行类型(文本)   // "参数|值" -> "参数"
            字符串 指令细节 = 行文本(文本)   // -> "值"
            如果 (字符串比较(指令类型, "参数")) {
                列表追加(输出, "汇编|参数|" + 指令细节)
            } 否则 如果 (字符串比较(指令类型, "分配")) {
                列表追加(输出, "汇编|分配|" + 指令细节)
            } 否则 如果 (字符串比较(指令类型, "常量")) {
                列表追加(输出, "汇编|mov rax, " + 指令细节)
            } 否则 如果 (字符串比较(指令类型, "加载")) {
                列表追加(输出, "汇编|mov rax, [" + 指令细节 + "]")
            } 否则 如果 (字符串比较(指令类型, "运算")) {
                列表追加(输出, "汇编|运算|" + 指令细节)
            } 否则 如果 (字符串比较(指令类型, "调用")) {
                列表追加(输出, "汇编|call " + 指令细节)
            } 否则 如果 (字符串比较(指令类型, "返回")) {
                列表追加(输出, "汇编|ret")
            } 否则 如果 (字符串比较(指令类型, "分支")) {
                列表追加(输出, "汇编|分支|" + 指令细节)
            }
            位置++
            继续
        }
        位置++
    }
}
