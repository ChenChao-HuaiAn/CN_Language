// 自举 Task 7.4 v2 子模块：IR生成/IR3（B 任务第二阶段拆分，2026-08-18）
// 职责：声明/语句 IR 生成（生成/处理序列/处理节点[参数,变量,返回,跳转,如果,当,选择,赋值,递增]/处理情况/处理默认）
// 模块名 IR3（简短唯一：外部模块按 pathStem 取名，跨组件同名冲突取先加载者；
//   且 C++ 端 mangling 符号含 模块名$函数名，长名+多向量参数易超 MASM 标识符上限）
// 门面 IR生成.cn 经 导入 IR生成::IR3 引入，子模块间不写导入，纯名调用（合并后全局可见）
公开:
函数 生成(向量<字符串> AST行, 字符串 模块名, 向量<字符串> 签名表,
          向量<字符串> 输出) -> 空类型 {
    整64 位置 = 0
    当 (位置 < AST行.大小()) {
        字符串 行 = AST行.元素(位置)
        字符串 类型 = IR行类型(行)
        如果 (字符串比较(类型, "函数") || 字符串比较(类型, "方法")) {
            整64 深 = IR行深度(行)
            向量<字符串> 类型表 = 向量<字符串>()
            向量<字符串> 类型栈 = 向量<字符串>()
            字符串 函数符号 = IR函数名(IR行文本(行))
            字符串 签名行 = 查找签名(签名表, 函数符号)
            字符串 函数参数码 = 签名参数码(签名行)
            如果 (!字符串比较(函数符号, "主")) {
                函数符号 = 模块名 + "$" + 函数符号
            }
            IR列表追加(输出, "函数|" + 函数符号 + "|" + IR参数数(IR行文本(行)) + "|" + 函数参数码)
            位置++
            位置 = 处理序列(AST行, 位置, 深 + 1, 模块名, 签名表, 类型表, 类型栈,
                           输出, "", "")
            IR列表追加(输出, "返回空")
        } 否则 {
            位置++
        }
    }
}
函数 处理序列(向量<字符串> AST行, 整64 位置, 整64 深度, 字符串 模块名,
             向量<字符串> 签名表, 向量<字符串> 类型表, 向量<字符串> 类型栈,
             向量<字符串> 输出, 字符串 循环开始, 字符串 循环结束) -> 整64 {
    当 (位置 < AST行.大小()) {
        字符串 子行0 = AST行.元素(位置)
        整64 子深0 = IR行深度(子行0)
        如果 (子深0 < 深度) {
            中断
        }
        位置 = 处理节点(AST行, 位置, 子深0, 模块名, 签名表,
                       类型表, 类型栈, 输出, 循环开始, 循环结束)
    }
    返回 位置
}
函数 处理节点(向量<字符串> AST行, 整64 位置, 整64 深, 字符串 模块名,
             向量<字符串> 签名表, 向量<字符串> 类型表, 向量<字符串> 类型栈,
             向量<字符串> 输出, 字符串 循环开始, 字符串 循环结束) -> 整64 {
    字符串 行 = AST行.元素(位置)
    字符串 类型 = IR行类型(行)
    字符串 文本 = IR行文本(行)
    如果 (字符串比较(类型, "块")) {
        返回 处理序列(AST行, 位置 + 1, 深 + 1, 模块名, 签名表, 类型表, 类型栈,
                    输出, 循环开始, 循环结束)
    }
    如果 (字符串比较(类型, "参数")) {
        返回 处理节点参数(AST行, 位置, 深, 类型表, 输出)
    }
    如果 (字符串比较(类型, "变量")) {
        返回 处理节点变量(AST行, 位置, 深, 模块名, 签名表, 类型表, 类型栈,
                       输出, 循环开始, 循环结束)
    }
    如果 (字符串比较(类型, "返回")) {
        返回 处理节点返回(AST行, 位置, 深, 模块名, 签名表, 类型表, 类型栈,
                       输出, 循环开始, 循环结束)
    }
    如果 (字符串比较(类型, "跳转")) {
        返回 处理节点跳转(位置, 文本, 输出, 循环开始, 循环结束)
    }
    如果 (字符串比较(类型, "如果")) {
        返回 处理节点如果(AST行, 位置, 深, 模块名, 签名表, 类型表, 类型栈,
                       输出, 循环开始, 循环结束)
    }
    如果 (字符串比较(类型, "当")) {
        返回 处理节点当(AST行, 位置, 深, 模块名, 签名表, 类型表, 类型栈,
                     输出, 循环开始, 循环结束)
    }
    如果 (字符串比较(类型, "选择")) {
        返回 处理节点选择(AST行, 位置, 深, 模块名, 签名表, 类型表, 类型栈,
                       输出, 循环开始, 循环结束)
    }
    如果 (字符串比较(类型, "标识符") && 位置 + 1 < AST行.大小()) {
        字符串 下一 = IR行类型(AST行.元素(位置 + 1))
        如果 (字符串比较(下一, "二元") && 位置 + 2 < AST行.大小() &&
             字符串比较(IR行文本(AST行.元素(位置 + 1)), "<") &&
             字符串比较(IR行类型(AST行.元素(位置 + 2)), "二元") &&
             字符串比较(IR行文本(AST行.元素(位置 + 2)), ">")) {
            返回 位置 + 3   // 模板工件三重跳过（声明类型名）
        }
        如果 (字符串比较(下一, "赋值")) {
            返回 处理节点赋值(AST行, 位置, 深, 模块名, 签名表, 类型表, 类型栈,
                           输出, 循环开始, 循环结束)
        }
        如果 (字符串比较(下一, "后缀")) {
            返回 处理节点递增(AST行, 位置, 文本, 输出)
        }
    }
    如果 (字符串比较(类型, "二元") && 位置 + 1 < AST行.大小() &&
         字符串比较(文本, "<") && 字符串比较(IR行类型(AST行.元素(位置 + 1)), "变量")) {
        返回 位置 + 1   // 模板工件：结果<空类型,整32> 加 = ...
    }
    如果 (是表达式节点(AST行, 位置)) {
        位置 = 处理表达式单(AST行, 位置, 深, 模块名, 签名表, 类型表, 类型栈,
                         输出, 循环开始, 循环结束)
        如果 (!末行是结构调用(输出)) {
            IR列表追加(输出, "运算|弹出")
            类型弹出(类型栈)
        }
        返回 位置
    }
    返回 位置 + 1
}
函数 处理节点参数(向量<字符串> AST行, 整64 位置, 整64 深,
               向量<字符串> 类型表, 向量<字符串> 输出) -> 整64 {
    字符串 文本 = IR行文本(AST行.元素(位置))
    布尔 引用 = 假
    字符串 参数类型 = "未"
    整64 j = 位置 + 1
    当 (j < AST行.大小()) {
                字符串 子行 = AST行.元素(j)
                整64 子深 = IR行深度(子行)
                如果 (子深 <= 深) {
                    中断
                }
        字符串 子类型 = IR行类型(AST行.元素(j))
        如果 (字符串比较(子类型, "类型后缀") && 字符串比较(IR行文本(AST行.元素(j)), "&")) {
            引用 = 真
        }
        如果 (字符串比较(子类型, "类型")) {
            参数类型 = 类型码(IR行文本(AST行.元素(j)))
        }
        j++
    }
    记类型(类型表, 文本, 参数类型)
    如果 (引用) {
        IR列表追加(输出, "参数|" + 文本 + "|引用")
    } 否则 {
        IR列表追加(输出, "参数|" + 文本)
    }
    返回 位置 + 1
}
函数 处理节点变量(向量<字符串> AST行, 整64 位置, 整64 深, 字符串 模块名,
               向量<字符串> 签名表, 向量<字符串> 类型表, 向量<字符串> 类型栈,
               向量<字符串> 输出, 字符串 循环开始, 字符串 循环结束) -> 整64 {
    字符串 文本 = IR行文本(AST行.元素(位置))
    字符串 变量类型 = "未"
    整64 j = 位置 + 1
    当 (j < AST行.大小()) {
                字符串 子行 = AST行.元素(j)
                整64 子深 = IR行深度(子行)
                如果 (子深 <= 深) {
                    中断
                }
        字符串 子类型 = IR行类型(AST行.元素(j))
        如果 (字符串比较(子类型, "类型")) {
            变量类型 = 类型码(IR行文本(AST行.元素(j)))
        }
        如果 (!字符串比较(子类型, "类型") && !字符串比较(子类型, "类型后缀")) {
            中断
        }
        j++
    }
    记类型(类型表, 文本, 变量类型)
    IR列表追加(输出, "分配|" + 文本)
    如果 (j < AST行.大小() && IR行深度(AST行.元素(j)) > 深) {
        位置 = 处理表达式(AST行, j, 深, 模块名, 签名表, 类型表, 类型栈,
                       输出, 循环开始, 循环结束)
        如果 (末行是结构调用(输出)) {
            IR列表追加(输出, "复制结果|" + 文本)
        } 否则 {
            IR列表追加(输出, "存储|" + 文本)
            类型弹出(类型栈)
        }
    } 否则 {
        位置 = j
    }
    返回 位置
}
函数 处理节点返回(向量<字符串> AST行, 整64 位置, 整64 深, 字符串 模块名,
               向量<字符串> 签名表, 向量<字符串> 类型表, 向量<字符串> 类型栈,
               向量<字符串> 输出, 字符串 循环开始, 字符串 循环结束) -> 整64 {
    如果 (位置 + 1 < AST行.大小() && IR行深度(AST行.元素(位置 + 1)) > 深) {
        位置 = 处理表达式(AST行, 位置 + 1, 深, 模块名, 签名表, 类型表,
                       类型栈, 输出, 循环开始, 循环结束)
        IR列表追加(输出, "返回")
        类型弹出(类型栈)
    } 否则 {
        IR列表追加(输出, "返回空")
        位置++
    }
    返回 位置
}
函数 处理节点跳转(整64 位置, 字符串 文本, 向量<字符串> 输出,
               字符串 循环开始, 字符串 循环结束) -> 整64 {
    如果 (字符串比较(文本, "中断")) {
        如果 (字符串长度(循环结束) > 0) {
            IR列表追加(输出, "跳转|" + 循环结束)
        }
    } 否则 {
        如果 (字符串长度(循环开始) > 0) {
            IR列表追加(输出, "跳转|" + 循环开始)
        }
    }
    返回 位置 + 1
}
函数 处理节点如果(向量<字符串> AST行, 整64 位置, 整64 深, 字符串 模块名,
               向量<字符串> 签名表, 向量<字符串> 类型表, 向量<字符串> 类型栈,
               向量<字符串> 输出, 字符串 循环开始, 字符串 循环结束) -> 整64 {
    字符串 结束标签 = "L" + 整数转字符串(位置) + "e"
    字符串 否则标签 = "L" + 整数转字符串(位置) + "x"
    位置 = 处理表达式(AST行, 位置 + 1, 深, 模块名, 签名表, 类型表, 类型栈,
                   输出, 循环开始, 循环结束)
    IR列表追加(输出, "跳转假|" + 否则标签)
    类型弹出(类型栈)
    位置 = 处理序列(AST行, 位置, 深 + 1, 模块名, 签名表, 类型表, 类型栈,
                   输出, 循环开始, 循环结束)
    IR列表追加(输出, "跳转|" + 结束标签)
    IR列表追加(输出, "标签|" + 否则标签)
    如果 (位置 < AST行.大小()) {
        字符串 子行4 = AST行.元素(位置)
        整64 子深4 = IR行深度(子行4)
        如果 (子深4 == 深 && 字符串比较(IR行类型(子行4), "否则")) {
        位置++
        如果 (位置 < AST行.大小()) {
            字符串 子行5 = AST行.元素(位置)
            整64 子深5 = IR行深度(子行5)
            如果 (子深5 == 深 && 字符串比较(IR行类型(子行5), "如果")) {
            位置 = 处理节点(AST行, 位置, 深, 模块名, 签名表, 类型表, 类型栈,
                         输出, 循环开始, 循环结束)
        } 否则 {
            位置 = 处理序列(AST行, 位置, 深 + 1, 模块名, 签名表, 类型表,
                           类型栈, 输出, 循环开始, 循环结束)
        }
        }
        }
    }
    IR列表追加(输出, "标签|" + 结束标签)
    返回 位置
}
函数 处理节点当(向量<字符串> AST行, 整64 位置, 整64 深, 字符串 模块名,
             向量<字符串> 签名表, 向量<字符串> 类型表, 向量<字符串> 类型栈,
             向量<字符串> 输出, 字符串 循环开始, 字符串 循环结束) -> 整64 {
    字符串 开始标签 = "L" + 整数转字符串(位置) + "a"
    字符串 结束标签 = "L" + 整数转字符串(位置) + "b"
    IR列表追加(输出, "标签|" + 开始标签)
    位置 = 处理表达式(AST行, 位置 + 1, 深, 模块名, 签名表, 类型表, 类型栈,
                   输出, 循环开始, 循环结束)
    IR列表追加(输出, "跳转假|" + 结束标签)
    类型弹出(类型栈)
    位置 = 处理序列(AST行, 位置, 深 + 1, 模块名, 签名表, 类型表, 类型栈,
                   输出, 开始标签, 结束标签)
    IR列表追加(输出, "跳转|" + 开始标签)
    IR列表追加(输出, "标签|" + 结束标签)
    返回 位置
}
函数 处理节点选择(向量<字符串> AST行, 整64 位置, 整64 深, 字符串 模块名,
               向量<字符串> 签名表, 向量<字符串> 类型表, 向量<字符串> 类型栈,
               向量<字符串> 输出, 字符串 循环开始, 字符串 循环结束) -> 整64 {
    字符串 名 = "S" + 整数转字符串(位置)
    位置 = 处理表达式(AST行, 位置 + 1, 深, 模块名, 签名表, 类型表, 类型栈,
                   输出, 循环开始, 循环结束)
    整64 体计数 = 0
    整64 后计数 = 0
    字符串 后标签 = ""
    当 (位置 < AST行.大小()) {
        字符串 行2 = AST行.元素(位置)
        如果 (IR行深度(行2) != 深) {
            中断
        }
        字符串 类型2 = IR行类型(行2)
        如果 (字符串比较(类型2, "情况")) {
            位置 = 处理情况(AST行, 位置, 深, 名, 体计数, 后计数, 后标签, 模块名,
                         签名表, 类型表, 类型栈, 输出, 循环开始, 循环结束)
        } 否则 如果 (字符串比较(类型2, "默认")) {
            位置 = 处理默认(AST行, 位置, 深, 名, 后标签, 模块名, 签名表,
                          类型表, 类型栈, 输出, 循环开始, 循环结束)
            中断
        } 否则 {
            中断
        }
    }
    如果 (字符串长度(后标签) > 0) {
        IR列表追加(输出, "标签|" + 后标签)
    }
    IR列表追加(输出, "标签|L" + 名 + "z")
    IR列表追加(输出, "运算|弹出")
    类型弹出(类型栈)
    返回 位置
}
函数 处理情况(向量<字符串> AST行, 整64 位置, 整64 深, 字符串 名,
            整64& 体计数, 整64& 后计数, 字符串& 后标签, 字符串 模块名,
            向量<字符串> 签名表, 向量<字符串> 类型表, 向量<字符串> 类型栈,
            向量<字符串> 输出, 字符串 循环开始, 字符串 循环结束) -> 整64 {
    字符串 文本2 = IR行文本(AST行.元素(位置))
    如果 (字符串长度(后标签) > 0) {
        IR列表追加(输出, "标签|" + 后标签)
        后标签 = ""
    }
    字符串 体标签 = "L" + 名 + "b" + 整数转字符串(体计数)
    IR列表追加(输出, "运算|复制栈顶")
    类型压入(类型栈, 类型栈顶(类型栈))
    如果 (字符串比较(字符串子串(文本2, 0, 1), "\"")) {
        IR列表追加(输出, "字符串|" + 文本2)
        类型压入(类型栈, "字")
        IR列表追加(输出, "调用|__cn_str_eq|2|0")
        类型弹出(类型栈)
        类型弹出(类型栈)
        类型压入(类型栈, "整")
    } 否则 {
        IR列表追加(输出, "字面量|" + 文本2)
        类型压入(类型栈, "整")
        IR列表追加(输出, "运算|==")
        类型弹出(类型栈)
        类型弹出(类型栈)
        类型压入(类型栈, "整")
    }
    IR列表追加(输出, "跳转真|" + 体标签)
    类型弹出(类型栈)
    位置++
    如果 (位置 < AST行.大小()) {
        字符串 子行6 = AST行.元素(位置)
        整64 子深6 = IR行深度(子行6)
        如果 (子深6 > 深) {
        后计数++
        IR列表追加(输出, "跳转|L" + 名 + "h" + 整数转字符串(后计数))
        IR列表追加(输出, "标签|" + 体标签)
        位置 = 处理序列(AST行, 位置, 深 + 1, 模块名, 签名表, 类型表, 类型栈,
                       输出, 循环开始, 循环结束)
        体计数++
        后标签 = "L" + 名 + "h" + 整数转字符串(后计数)
        }
    }
    返回 位置
}
函数 处理默认(向量<字符串> AST行, 整64 位置, 整64 深, 字符串 名,
            字符串& 后标签, 字符串 模块名, 向量<字符串> 签名表,
            向量<字符串> 类型表, 向量<字符串> 类型栈, 向量<字符串> 输出,
            字符串 循环开始, 字符串 循环结束) -> 整64 {
    如果 (字符串长度(后标签) > 0) {
        IR列表追加(输出, "标签|" + 后标签)
        后标签 = ""
    }
    IR列表追加(输出, "标签|L" + 名 + "d")
    位置++
    返回 处理序列(AST行, 位置, 深 + 1, 模块名, 签名表, 类型表, 类型栈,
                 输出, 循环开始, 循环结束)
}
函数 处理节点赋值(向量<字符串> AST行, 整64 位置, 整64 深, 字符串 模块名,
               向量<字符串> 签名表, 向量<字符串> 类型表, 向量<字符串> 类型栈,
               向量<字符串> 输出, 字符串 循环开始, 字符串 循环结束) -> 整64 {
    字符串 文本 = IR行文本(AST行.元素(位置))
    字符串 赋值文本 = IR行文本(AST行.元素(位置 + 1))
    整64 赋值深 = IR行深度(AST行.元素(位置 + 1))
    如果 (字符串比较(赋值文本, "=") && 字符串比较(查类型(类型表, 文本), "未")) {
        IR列表追加(输出, "分配|" + 文本)
        记类型(类型表, 文本, "向")
    }
    如果 (!字符串比较(赋值文本, "=")) {
        IR列表追加(输出, "加载|" + 文本)
        类型压入(类型栈, 查类型(类型表, 文本))
    }
    位置 = 位置 + 2
    位置 = 处理表达式(AST行, 位置, 赋值深, 模块名, 签名表, 类型表, 类型栈,
                   输出, 循环开始, 循环结束)
    如果 (字符串比较(赋值文本, "=")) {
        如果 (末行是结构调用(输出)) {
            IR列表追加(输出, "复制结果|" + 文本)
        } 否则 {
            IR列表追加(输出, "存储|" + 文本)
            类型弹出(类型栈)
        }
    } 否则 {
        IR列表追加(输出, "运算|" + 赋值文本)
        类型弹出(类型栈)
        类型弹出(类型栈)
        类型压入(类型栈, "整")
        IR列表追加(输出, "存储|" + 文本)
        类型弹出(类型栈)
    }
    返回 位置
}
函数 处理节点递增(向量<字符串> AST行, 整64 位置, 字符串 文本,
               向量<字符串> 输出) -> 整64 {
    字符串 后缀文本 = IR行文本(AST行.元素(位置 + 1))
    如果 (字符串比较(后缀文本, "++")) {
        IR列表追加(输出, "递增|" + 文本)
    } 否则 {
        IR列表追加(输出, "递减|" + 文本)
    }
    返回 位置 + 2
}