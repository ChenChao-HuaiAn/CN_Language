// 自举 Task 7.4 v2 子模块：IR生成/IR4（B 任务第二阶段拆分，2026-08-18）
// 职责：表达式 IR 生成（是表达式节点/末行是结构调用/处理表达式/处理表达式单/处理标识符/处理成员节点/处理二元/一元/调用）
// 模块名 IR4（简短唯一：外部模块按 pathStem 取名，跨组件同名冲突取先加载者；
//   且 C++ 端 mangling 符号含 模块名$函数名，长名+多向量参数易超 MASM 标识符上限）
// 门面 IR生成.cn 经 导入 IR生成::IR4 引入，子模块间不写导入，纯名调用（合并后全局可见）
公开:
函数 是表达式节点(向量<字符串> AST行, 整64 位置) -> 布尔 {
    字符串 行 = AST行.元素(位置)
    字符串 类型 = IR行类型(行)
    如果 (字符串比较(类型, "标识符")) {
        字符串 下一 = 下一类型(AST行, 位置 + 1)
        如果 (字符串比较(下一, "赋值") || 字符串比较(下一, "后缀")) {
            返回 假
        }
        返回 真
    }
    如果 (字符串比较(类型, "二元")) {
        如果 (位置 + 1 < AST行.大小() && 字符串比较(IR行文本(行), "<") &&
             字符串比较(IR行类型(AST行.元素(位置 + 1)), "变量")) {
            返回 假
        }
        返回 真
    }
    返回 字符串比较(类型, "字面量") || 字符串比较(类型, "一元") ||
          字符串比较(类型, "强制转换") || 字符串比较(类型, "三元")
}
函数 末行是结构调用(向量<字符串> 输出) -> 布尔 {
    如果 (输出.大小() < 1) {
        返回 假
    }
    字符串 行 = 输出.元素(输出.大小() - 1)
    如果 (!字符串比较(IR行类型(行), "调用")) {
        返回 假
    }
    字符串 细节 = IR行文本(行)
    字符串 细节2 = IR行文本(细节)
    字符串 细节3 = IR行文本(细节2)
    字符串 标志 = IR行类型(细节3)
    返回 字符串比较(标志, "2")
}
函数 处理表达式(向量<字符串> AST行, 整64 位置, 整64 深度, 字符串 模块名,
               向量<字符串> 签名表, 向量<字符串> 类型表, 向量<字符串> 类型栈,
               向量<字符串> 输出, 字符串 循环开始, 字符串 循环结束) -> 整64 {
    当 (位置 < AST行.大小()) {
        字符串 子行7 = AST行.元素(位置)
        整64 子深7 = IR行深度(子行7)
        如果 (子深7 <= 深度) {
            中断
        }
        如果 (!是表达式节点(AST行, 位置)) {
            中断
        }
        位置 = 处理表达式单(AST行, 位置, 子深7, 模块名,
                          签名表, 类型表, 类型栈, 输出, 循环开始, 循环结束)
    }
    返回 位置
}
函数 处理表达式单(向量<字符串> AST行, 整64 位置, 整64 深, 字符串 模块名,
                 向量<字符串> 签名表, 向量<字符串> 类型表, 向量<字符串> 类型栈,
                 向量<字符串> 输出, 字符串 循环开始, 字符串 循环结束) -> 整64 {
    字符串 行 = AST行.元素(位置)
    字符串 类型 = IR行类型(行)
    字符串 文本 = IR行文本(行)
    如果 (字符串比较(类型, "标识符")) {
        返回 处理标识符(AST行, 位置, 深, 模块名, 签名表, 类型表, 类型栈,
                      输出, 循环开始, 循环结束)
    }
    如果 (字符串比较(类型, "字面量")) {
        IR列表追加(输出, "字面量|" + 文本)
        如果 (字符串比较(字符串子串(文本, 0, 1), "\"")) {
            类型压入(类型栈, "字")
        } 否则 {
            类型压入(类型栈, "整")
        }
        返回 位置 + 1
    }
    如果 (字符串比较(类型, "二元")) {
        返回 处理二元节点(AST行, 位置, 深, 模块名, 签名表, 类型表, 类型栈,
                        输出, 循环开始, 循环结束)
    }
    如果 (字符串比较(类型, "一元")) {
        返回 处理一元节点(AST行, 位置, 深, 模块名, 签名表, 类型表, 类型栈,
                        输出, 循环开始, 循环结束)
    }
    如果 (字符串比较(类型, "强制转换")) {
        返回 处理表达式(AST行, 位置 + 1, 深, 模块名, 签名表, 类型表, 类型栈,
                       输出, 循环开始, 循环结束)
    }
    如果 (字符串比较(类型, "三元")) {
        位置 = 处理表达式(AST行, 位置 + 1, 深, 模块名, 签名表, 类型表, 类型栈,
                       输出, 循环开始, 循环结束)
        位置 = 处理表达式(AST行, 位置, 深, 模块名, 签名表, 类型表, 类型栈,
                       输出, 循环开始, 循环结束)
        位置 = 处理表达式(AST行, 位置, 深, 模块名, 签名表, 类型表, 类型栈,
                       输出, 循环开始, 循环结束)
        返回 位置
    }
    返回 位置
}
函数 处理标识符(向量<字符串> AST行, 整64 位置, 整64 深, 字符串 模块名,
              向量<字符串> 签名表, 向量<字符串> 类型表, 向量<字符串> 类型栈,
              向量<字符串> 输出, 字符串 循环开始, 字符串 循环结束) -> 整64 {
    字符串 行 = AST行.元素(位置)
    字符串 文本 = IR行文本(行)
    字符串 下一 = 下一类型(AST行, 位置 + 1)
    如果 (字符串比较(下一, "调用")) {
        返回 处理调用(AST行, 位置, 深, 文本, 模块名, 签名表, 类型表,
                     类型栈, 输出, 循环开始, 循环结束)
    }
    如果 (字符串比较(下一, "成员")) {
        返回 处理成员节点(AST行, 位置, 深, 模块名, 签名表, 类型表, 类型栈,
                        输出, 循环开始, 循环结束)
    }
    如果 (字符串比较(下一, "下标")) {
        IR列表追加(输出, "加载|" + 文本)
        类型压入(类型栈, 查类型(类型表, 文本))
        整64 下标深 = IR行深度(AST行.元素(位置 + 1))
        位置 = 处理表达式(AST行, 位置 + 2, 下标深, 模块名, 签名表, 类型表,
                       类型栈, 输出, 循环开始, 循环结束)
        IR列表追加(输出, "运算|下标字节")
        类型弹出(类型栈)
        类型弹出(类型栈)
        类型压入(类型栈, "整")
        返回 位置
    }
    如果 (字符串比较(下一, "二元")) {
        如果 (字符串比较(下一文本(AST行, 位置 + 1), "<") &&
             字符串比较(下一类型(AST行, 位置 + 2), "二元") &&
             字符串比较(下一文本(AST行, 位置 + 2), ">")) {
            IR列表追加(输出, "调用|向量$字符串$向量|0|3")
            类型压入(类型栈, "向")
            返回 位置 + 3
        }
    }
    IR列表追加(输出, "加载|" + 文本)
    类型压入(类型栈, 查类型(类型表, 文本))
    返回 位置 + 1
}
函数 处理成员节点(向量<字符串> AST行, 整64 位置, 整64 深, 字符串 模块名,
                向量<字符串> 签名表, 向量<字符串> 类型表, 向量<字符串> 类型栈,
                向量<字符串> 输出, 字符串 循环开始, 字符串 循环结束) -> 整64 {
    字符串 文本 = IR行文本(AST行.元素(位置))
    字符串 成员文本 = IR行文本(AST行.元素(位置 + 1))
    // B 任务拆分：模块限定名调用（关键字::查找关键字）——
    // 成员|::|名 行：IR行文本 = "::|名"（第一个 | 后），文本=模块名
    // 判断 :: 前缀（成员|::|名 的 IR行文本 以 "::|" 开头）。
    // 符号生成：当前模块名$IR函数名（忽略调用文本中的模块名）——79 闭环合并
    //   门面+子模块源码后统一 IR 生成，所有函数符号统一为 门面模块名$IR函数名，
    //   调用与定义符号匹配（子模块IR函数名在门面内唯一）。
    如果 (字符串长度(成员文本) >= 3 && 字符串比较(字符串子串(成员文本, 0, 3), "::|")) {
        字符串 限定IR函数名 = 字符串子串(成员文本, 3, 字符串长度(成员文本) - 3)
        字符串 限定名 = 模块名 + "$" + 限定IR函数名
        如果 (字符串比较(下一类型(AST行, 位置 + 2), "调用")) {
            字符串 IR参数数文本 = IR参数数(IR行文本(AST行.元素(位置 + 2)))
            字符串 签名 = 查找签名(签名表, 限定IR函数名)
            整64 调用深3 = IR行深度(AST行.元素(位置 + 2))
            位置 = 处理表达式(AST行, 位置 + 3, 调用深3,
                           模块名, 签名表, 类型表, 类型栈, 输出,
                           循环开始, 循环结束)
            字符串 调用参数码 = 签名参数码(签名)
            IR列表追加(输出, "调用|" + 限定名 + "|" + IR参数数文本 + "|0|" + 调用参数码)
            字符串 返回码 = 调用返回码(限定IR函数名, 签名表)
            整64 参数个数 = IR解析整数(IR参数数文本)
            整64 i = 0
            当 (i < 参数个数) {
                类型弹出(类型栈)
                i++
            }
            类型压入(类型栈, 返回码)
            返回 位置
        }
        IR列表追加(输出, "加载|" + 限定名)
        类型压入(类型栈, "整")
        返回 位置 + 2
    }
    如果 (字符串比较(下一类型(AST行, 位置 + 2), "调用")) {
        字符串 IR参数数文本 = IR参数数(IR行文本(AST行.元素(位置 + 2)))
        字符串 方法 = 成员名(成员文本)
        字符串 符号 = "向量$字符串$" + 方法
        字符串 标志 = "1"
        字符串 返回码 = "未"
        如果 (字符串比较(方法, "追加") || 字符串比较(方法, "删除") ||
             字符串比较(方法, "设置")) {
            标志 = "2"
            返回码 = "空"
        } 否则 如果 (字符串比较(方法, "元素")) {
            返回码 = "字"
        } 否则 如果 (字符串比较(方法, "大小")) {
            返回码 = "整"
        } 否则 {
            返回码 = "未"
        }
        IR列表追加(输出, "加载|" + 文本)
        类型压入(类型栈, 查类型(类型表, 文本))
        整64 调用深2 = IR行深度(AST行.元素(位置 + 2))
        位置 = 处理表达式(AST行, 位置 + 3, 调用深2,
                       模块名, 签名表, 类型表, 类型栈, 输出,
                       循环开始, 循环结束)
        IR列表追加(输出, "调用|" + 符号 + "|" + IR参数数文本 + "|" + 标志)
        类型弹出(类型栈)
        整64 参数个数 = IR解析整数(IR参数数文本)
        整64 i = 0
        当 (i < 参数个数) {
            类型弹出(类型栈)
            i++
        }
        如果 (字符串比较(标志, "2")) {
            类型弹出(类型栈)
        } 否则 {
            类型压入(类型栈, 返回码)
        }
        返回 位置
    }
    IR列表追加(输出, "加载成员|" + 文本 + "|" + 成员名(成员文本))
    类型压入(类型栈, "整")
    返回 位置 + 2
}
函数 处理二元节点(向量<字符串> AST行, 整64 位置, 整64 深, 字符串 模块名,
                向量<字符串> 签名表, 向量<字符串> 类型表, 向量<字符串> 类型栈,
                向量<字符串> 输出, 字符串 循环开始, 字符串 循环结束) -> 整64 {
    字符串 文本 = IR行文本(AST行.元素(位置))
    位置 = 处理表达式(AST行, 位置 + 1, 深, 模块名, 签名表, 类型表, 类型栈,
                   输出, 循环开始, 循环结束)
    字符串 右类型 = 类型栈顶(类型栈)
    类型弹出(类型栈)
    字符串 左类型 = 类型栈顶(类型栈)
    类型弹出(类型栈)
    如果 (字符串比较(文本, "+") && (字符串比较(右类型, "字") ||
         字符串比较(左类型, "字"))) {
        IR列表追加(输出, "运算|+字")
        类型压入(类型栈, "字")
    } 否则 {
        IR列表追加(输出, "运算|" + 文本)
        类型压入(类型栈, "整")
    }
    返回 位置
}
函数 处理一元节点(向量<字符串> AST行, 整64 位置, 整64 深, 字符串 模块名,
                向量<字符串> 签名表, 向量<字符串> 类型表, 向量<字符串> 类型栈,
                向量<字符串> 输出, 字符串 循环开始, 字符串 循环结束) -> 整64 {
    字符串 文本 = IR行文本(AST行.元素(位置))
    位置 = 处理表达式(AST行, 位置 + 1, 深, 模块名, 签名表, 类型表, 类型栈,
                   输出, 循环开始, 循环结束)
    如果 (字符串比较(文本, "!")) {
        IR列表追加(输出, "运算|非")
    } 否则 如果 (字符串比较(文本, "~")) {
        IR列表追加(输出, "运算|取反")
    } 否则 {
        IR列表追加(输出, "运算|取负")
    }
    类型弹出(类型栈)
    类型压入(类型栈, "整")
    返回 位置
}
函数 处理调用(向量<字符串> AST行, 整64 位置, 整64 深, 字符串 名,
             字符串 模块名, 向量<字符串> 签名表, 向量<字符串> 类型表,
             向量<字符串> 类型栈, 向量<字符串> 输出,
             字符串 循环开始, 字符串 循环结束) -> 整64 {
    字符串 IR参数数文本 = IR参数数(IR行文本(AST行.元素(位置 + 1)))
    整64 参数个数 = IR解析整数(IR参数数文本)
    字符串 符号 = 调用符号(名, 模块名)
    字符串 签名 = 查找签名(签名表, 名)
    整64 调用深 = IR行深度(AST行.元素(位置 + 1))
    位置 = 位置 + 2
    整64 起始深度 = 类型栈.大小()
    当 (位置 < AST行.大小() && IR行深度(AST行.元素(位置)) > 调用深 &&
         类型栈.大小() < 起始深度 + 参数个数) {
        整64 当前参数 = 类型栈.大小() - 起始深度
        如果 (是引用位(签名, 当前参数) && 位置 < AST行.大小() &&
             字符串比较(IR行类型(AST行.元素(位置)), "标识符")) {
            IR列表追加(输出, "压址|" + IR行文本(AST行.元素(位置)))
            类型压入(类型栈, "整")
            位置++
        } 否则 {
            整64 参深 = IR行深度(AST行.元素(位置))
            位置 = 处理表达式单(AST行, 位置, 参深, 模块名,
                              签名表, 类型表, 类型栈, 输出, 循环开始, 循环结束)
            当 (位置 < AST行.大小() && IR行深度(AST行.元素(位置)) > 调用深 &&
                 类型栈.大小() == 起始深度 + 当前参数 + 1) {
                字符串 下一类 = IR行类型(AST行.元素(位置))
                如果 (字符串比较(下一类, "二元") || 字符串比较(下一类, "一元") ||
                     字符串比较(下一类, "后缀")) {
                    整64 链深 = IR行深度(AST行.元素(位置))
                    位置 = 处理表达式单(AST行, 位置, 链深, 模块名,
                                      签名表, 类型表, 类型栈, 输出,
                                      循环开始, 循环结束)
                } 否则 {
                    中断
                }
            }
        }
    }
    字符串 调用参数码 = ""
    如果 (字符串比较(名, "分词") || 字符串比较(名, "解析")) {
        调用参数码 = "PAX"
    } 否则 如果 (字符串比较(名, "字节值")) {
        调用参数码 = "PAXJ"
    } 否则 {
        调用参数码 = 签名参数码(签名)
    }
    IR列表追加(输出, "调用|" + 符号 + "|" + IR参数数文本 + "|0|" + 调用参数码)
    字符串 返回码 = 调用返回码(名, 签名表)
    整64 j = 0
    当 (j < 参数个数) {
        类型弹出(类型栈)
        j++
    }
    类型压入(类型栈, 返回码)
    返回 位置
}