// 自举 Task 7.4 v2 子模块：IR生成/IR2（B 任务第二阶段拆分，2026-08-18）
// 职责：签名收集与类型码（收集签名/类型码/链接类型码/查找签名/引用位/签名返回码/签名参数码/查类型/记类型/类型栈/调用符号/内置返回码/调用返回码）
// 模块名 IR2（简短唯一：外部模块按 pathStem 取名，跨组件同名冲突取先加载者；
//   且 C++ 端 mangling 符号含 模块名$函数名，长名+多向量参数易超 MASM 标识符上限）
// 门面 IR生成.cn 经 导入 IR生成::IR2 引入，子模块间不写导入，纯名调用（合并后全局可见）
公开:
函数 收集签名(向量<字符串> AST行, 向量<字符串> 签名表) -> 空类型 {
    整64 位置 = 0;
    当 (位置 < AST行.大小()) {
        字符串 行 = AST行.元素(位置);
        字符串 类型 = IR行类型(行);
        如果 (字符串比较(类型, "函数") || 字符串比较(类型, "方法")) {
            整64 深 = IR行深度(行);
            字符串 名 = IR函数名(IR行文本(行));
            字符串 位图 = "";
            字符串 返回码 = "未";
            字符串 参数码 = "";
            整64 j = 位置 + 1;
            当 (j < AST行.大小()) {
                字符串 子行 = AST行.元素(j);
                整64 子深 = IR行深度(子行);
                如果 (子深 <= 深) {
                    中断;
                }
                字符串 子类型 = IR行类型(AST行.元素(j));
                如果 (字符串比较(子类型, "参数")) {
                    整64 参数深 = IR行深度(AST行.元素(j));
                    布尔 引用 = 假;
                    字符串 参数类型名 = "未";
                    整64 k = j + 1;
                    当 (k < AST行.大小()) {
                        字符串 子行k = AST行.元素(k);
                        整64 子深k = IR行深度(子行k);
                        如果 (子深k <= 参数深) {
                            中断;
                        }
                        如果 (字符串比较(IR行类型(AST行.元素(k)), "类型后缀") &&
                             字符串比较(IR行文本(AST行.元素(k)), "&")) {
                            引用 = 真;
                        }
                        如果 (字符串比较(IR行类型(AST行.元素(k)), "类型")) {
                            参数类型名 = IR行文本(AST行.元素(k));
                        }
                        k++;
                    }
                    如果 (引用) { 位图 = 位图 + "1"; } 否则 { 位图 = 位图 + "0"; }
                    字符串 参码 = 链接类型码(参数类型名);
                    如果 (引用) {
                        参码 = "A" + 参码;
                    }
                    参数码 = 参数码 + 参码;
                } 否则 如果 (字符串比较(子类型, "返回类型")) {
                    整64 返深 = IR行深度(AST行.元素(j));
                    整64 k = j + 1;
                    当 (k < AST行.大小()) {
                        字符串 子行r = AST行.元素(k);
                        整64 子深r = IR行深度(子行r);
                        如果 (子深r <= 返深) {
                            中断;
                        }
                        如果 (字符串比较(IR行类型(AST行.元素(k)), "类型")) {
                            返回码 = 类型码(IR行文本(AST行.元素(k)));
                        }
                        k++;
                    }
                }
                j++;
            }
            IR列表追加(签名表, 名 + "|" + 位图 + "|" + 返回码 + "|" + 参数码);
        }
        位置++;
    }
}
函数 类型码(字符串 类型名) -> 字符串 {
    如果 (字符串比较(类型名, "字符串") || 字符串比较(类型名, "字符*")) {
        返回 "字";
    }
    如果 (字符串比较(类型名, "向量")) {
        返回 "向";
    }
    如果 (字符串比较(类型名, "空类型")) {
        返回 "空";
    }
    返回 "整";
}
函数 链接类型码(字符串 类型名) -> 字符串 {
    如果 (字符串比较(类型名, "空类型")) {
        返回 "X";
    }
    如果 (字符串比较(类型名, "布尔")) {
        返回 "_N";
    }
    如果 (字符串比较(类型名, "字符")) {
        返回 "D";
    }
    如果 (字符串比较(类型名, "整8")) {
        返回 "C";
    }
    如果 (字符串比较(类型名, "正8")) {
        返回 "E";
    }
    如果 (字符串比较(类型名, "整16")) {
        返回 "F";
    }
    如果 (字符串比较(类型名, "正16")) {
        返回 "G";
    }
    如果 (字符串比较(类型名, "整32")) {
        返回 "H";
    }
    如果 (字符串比较(类型名, "正32")) {
        返回 "I";
    }
    如果 (字符串比较(类型名, "整64")) {
        返回 "J";
    }
    如果 (字符串比较(类型名, "正64")) {
        返回 "K";
    }
    如果 (字符串比较(类型名, "整128")) {
        返回 "_M";
    }
    如果 (字符串比较(类型名, "正128")) {
        返回 "_O";
    }
    如果 (字符串比较(类型名, "浮32")) {
        返回 "M";
    }
    如果 (字符串比较(类型名, "浮64")) {
        返回 "N";
    }
    如果 (字符串比较(类型名, "字符串") || 字符串比较(类型名, "字符*")) {
        返回 "PAX";
    }
    如果 (字符串比较(类型名, "空类型*")) {
        返回 "PEX";
    }
    如果 (字符串比较(类型名, "向量")) {
        返回 "_TE59091E9878F24E5AD97E7ACA6E4B8B2";
    }
    如果 (字符串长度(类型名) > 1 &&
         字符串比较(字符串子串(类型名, 字符串长度(类型名) - 1, 1), "*")) {
        返回 "PE" + 链接类型码(字符串子串(类型名, 0, 字符串长度(类型名) - 1));
    }
    返回 "";
}
函数 查找签名(向量<字符串> 签名表, 字符串 名) -> 字符串 {
    整64 i = 0;
    当 (i < 签名表.大小()) {
        字符串 记录 = 签名表.元素(i);
        如果 (字符串查找(记录, 名 + "|") == 0) {
            返回 IR行文本(记录);
        }
        i++;
    }
    返回 "";
}
函数 是引用位(字符串 位图, 整64 i) -> 布尔 {
    如果 (i >= 字符串长度(位图)) {
        返回 假;
    }
    返回 字节值(位图, i) == 49;
}
函数 签名返回码(字符串 签名) -> 字符串 {
    整64 位 = 字符串查找(签名, "|");
    如果 (位 < 0) {
        返回 "未";
    }
    返回 字符串子串(签名, 位 + 1, 字符串长度(签名) - 位 - 1);
}
函数 签名参数码(字符串 签名) -> 字符串 {
    整64 位1 = 字符串查找(签名, "|");
    如果 (位1 < 0) {
        返回 "";
    }
    整64 位2 = 字符串查找(字符串子串(签名, 位1 + 1, 字符串长度(签名) - 位1 - 1), "|");
    如果 (位2 < 0) {
        返回 "";
    }
    返回 字符串子串(签名, 位1 + 位2 + 2, 字符串长度(签名) - 位1 - 位2 - 2);
}
函数 查类型(向量<字符串> 类型表, 字符串 名) -> 字符串 {
    整64 i = 0;
    当 (i < 类型表.大小()) {
        字符串 记录 = 类型表.元素(i);
        如果 (字符串查找(记录, 名 + "|") == 0) {
            返回 IR行文本(记录);
        }
        i++;
    }
    返回 "未";
}
函数 记类型(向量<字符串> 类型表, 字符串 名, 字符串 码) -> 空类型 {
    IR列表追加(类型表, 名 + "|" + 码);
}
函数 类型压入(向量<字符串> 类型栈, 字符串 码) -> 空类型 {
    IR列表追加(类型栈, 码);
}
函数 类型弹出(向量<字符串> 类型栈) -> 空类型 {
    整64 层数 = 类型栈.大小();
    如果 (层数 > 0) {
        整64 索引 = 层数 - 1;
        结果<空类型, 整32> 删 = 类型栈.删除(索引);
        如果 (!删.正常) {
            运行时错误(4);
        }
    }
}
函数 类型栈顶(向量<字符串> 类型栈) -> 字符串 {
    如果 (类型栈.大小() > 0) {
        返回 类型栈.元素(类型栈.大小() - 1);
    }
    返回 "未";
}
函数 调用符号(字符串 名, 字符串 模块名) -> 字符串 {
    如果 (字符串比较(名, "字符串长度")) { 返回 "__cn_str_len"; }
    如果 (字符串比较(名, "字符串比较")) { 返回 "__cn_str_eq"; }
    如果 (字符串比较(名, "字符串查找")) { 返回 "__cn_str_find"; }
    如果 (字符串比较(名, "字符串子串")) { 返回 "__cn_str_sub"; }
    如果 (字符串比较(名, "字符串包含")) { 返回 "__cn_str_contains"; }
    如果 (字符串比较(名, "整数转字符串")) { 返回 "__cn_str_from_int"; }
    如果 (字符串比较(名, "字符转字符串")) { 返回 "__cn_str_from_char"; }
    如果 (字符串比较(名, "打印")) { 返回 "printLine"; }
    如果 (字符串比较(名, "打印行")) { 返回 "printNoLine"; }
    如果 (字符串比较(名, "运行时错误")) { 返回 "__cn_runtime_error"; }
    如果 (字符串比较(名, "分词")) { 返回 "词法分析$分词"; }
    如果 (字符串比较(名, "解析")) { 返回 "语法分析$解析"; }
    如果 (字符串比较(名, "字节值")) { 返回 "词法分析$字节值"; }
    返回 模块名 + "$" + 名;
}
函数 内置返回码(字符串 名) -> 字符串 {
    如果 (字符串比较(名, "字符串长度")) { 返回 "整"; }
    如果 (字符串比较(名, "字符串比较")) { 返回 "整"; }
    如果 (字符串比较(名, "字符串查找")) { 返回 "整"; }
    如果 (字符串比较(名, "字符串子串")) { 返回 "字"; }
    如果 (字符串比较(名, "字符串包含")) { 返回 "整"; }
    如果 (字符串比较(名, "整数转字符串")) { 返回 "字"; }
    如果 (字符串比较(名, "字符转字符串")) { 返回 "字"; }
    如果 (字符串比较(名, "打印")) { 返回 "空"; }
    如果 (字符串比较(名, "打印行")) { 返回 "空"; }
    如果 (字符串比较(名, "运行时错误")) { 返回 "空"; }
    返回 "未";
}
函数 调用返回码(字符串 名, 向量<字符串> 签名表) -> 字符串 {
    字符串 内置 = 内置返回码(名);
    如果 (!字符串比较(内置, "未")) {
        返回 内置;
    }
    字符串 签名 = 查找签名(签名表, 名);
    如果 (字符串长度(签名) > 0) {
        返回 签名返回码(签名);
    }
    返回 "未";
}