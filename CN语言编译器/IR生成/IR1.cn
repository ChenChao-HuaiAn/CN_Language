// 自举 Task 7.4 v2 子模块：IR生成/IR1（B 任务第二阶段拆分，2026-08-18）
// 职责：无状态行工具（IR行类型/IR行文本/IR行深度/IR列表追加/IR函数名/IR参数数/IR解析整数/下一类型/下一文本/成员名）
// 模块名 IR1（简短唯一：外部模块按 pathStem 取名，跨组件同名冲突取先加载者；
//   且 C++ 端 mangling 符号含 模块名$函数名，长名+多向量参数易超 MASM 标识符上限）
// 门面 IR生成.cn 经 导入 IR生成::IR1 引入，子模块间不写导入，纯名调用（合并后全局可见）
公开:
函数 IR行类型(字符串 行) -> 字符串 {
    整64 起 = 0;
    布尔 空格 = 字符串比较(字符串子串(行, 0, 1), " ");
    当 (起 < 字符串长度(行) && 空格) {
        起++;
        空格 = 字符串比较(字符串子串(行, 起, 1), " ");
    }
    整64 位 = 字符串查找(行, "|");
    如果 (位 < 0) {
        返回 字符串子串(行, 起, 字符串长度(行) - 起);
    }
    返回 字符串子串(行, 起, 位 - 起);
}
函数 IR行文本(字符串 行) -> 字符串 {
    整64 位 = 字符串查找(行, "|");
    如果 (位 < 0) {
        返回 "";
    }
    返回 字符串子串(行, 位 + 1, 字符串长度(行) - 位 - 1);
}
函数 IR行深度(字符串 行) -> 整64 {
    整64 起 = 0;
    当 (起 < 字符串长度(行) && 字符串比较(字符串子串(行, 起, 1), " ")) {
        起++;
    }
    返回 起 / 2;
}
函数 IR列表追加(向量<字符串> 列表, 字符串 值) -> 空类型 {
    // A2 纪律（字符串入容器须显式复制，2026-09-11 第七十二轮 72-a 迁移）：
    //   原浅共享——调用方块内声明的拥有串被容器持有后，源在块出口/函数返回
    //   释放 = 容器元素悬垂（72-a 块级 RAII 使其立即暴露：76 用例产物常量池
    //   退化为指针值）。此处复制落堆，元素所有权归容器（Rust Vec<String> 同款）。
    结果<空类型, 整32> 加 = 列表.追加(字符串复制(值));
    如果 (!加.正常) {
        运行时错误(4);
    }
}
函数 IR函数名(字符串 文本) -> 字符串 {
    整64 分隔 = 字符串查找(文本, "|参数数=");
    如果 (分隔 < 0) { 返回 字符串复制(文本); }
    返回 字符串子串(文本, 0, 分隔);
}
函数 IR参数数(字符串 文本) -> 字符串 {
    整64 分隔 = 字符串查找(文本, "参数数=");
    如果 (分隔 < 0) { 返回 "0"; }
    返回 字符串子串(文本, 分隔 + 10, 字符串长度(文本) - 分隔 - 10);
}
函数 IR解析整数(字符串 文本) -> 整64 {
    整64 值 = 0;
    整64 i = 0;
    当 (i < 字符串长度(文本)) {
        整64 字节 = 字节值(文本, i);
        如果 (字节 >= 48 && 字节 <= 57) {
            值 = 值 * 10 + 字节 - 48;
        }
        i++;
    }
    返回 值;
}
函数 下一类型(向量<字符串> AST行, 整64 位置) -> 字符串 {
    如果 (位置 < AST行.大小()) {
        返回 IR行类型(AST行.元素(位置));
    }
    返回 "";
}
函数 下一文本(向量<字符串> AST行, 整64 位置) -> 字符串 {
    如果 (位置 < AST行.大小()) {
        返回 IR行文本(AST行.元素(位置));
    }
    返回 "";
}
函数 成员名(字符串 文本) -> 字符串 {
    整64 位 = 字符串查找(文本, "|");
    如果 (位 >= 0) {
        返回 字符串子串(文本, 位 + 1, 字符串长度(文本) - 位 - 1);
    }
    如果 (字符串长度(文本) > 1) {
        返回 字符串子串(文本, 1, 字符串长度(文本) - 1);
    }
    返回 字符串复制(文本);
}