// CN 语言标准库：JSON 生成器（#751 拆分自 JSON.cn·序列化）
//   模块 JSON生成器·公开 生成文本（JSON.cn 的 生成JSON 委托入口）；缩进 0=紧凑。
//   实现：字符串构建器句柄一趟直追加（#728p·全字节形态）；子链一趟遍历
//   （O(子数)·原 子数()+子(节,序) 每序号链头重走已废）。生成输出与拆分前
//   逐字节一致（E2E 669/939/942 与 b6 往返锁定）。
导入 JSON核心::{JSON树, JSONT_空, JSONT_真, JSONT_假, JSONT_整数, JSONT_浮点, JSONT_字符串, JSONT_对象};

私有:
// 字符串值→JSON 字符串字面（引号包裹+转义·追加进 句 构建器）
//   #728p（2026-10-14·366 遗留生成侧同族）：原 逐字符 字符串连接=每字符整串
//   重拷 O(n²) 改 句柄直追加；全字节形态（免 引号串/反斜杠字 临时串构造——
//   与原 字符转字符串(c) 低 8 位直放逐字节等价·UTF-8 ≥0x80 多字节直通·
//   #361 字节语义；转义全集=RFC 8259 §7）
不安全 函数 生成字符串字面到(字符串 值, 整64 句) -> 空类型 {
    字符串构建器::追加字节(句, 34);                 // 开引号 "
    整64 长 = 字符串长度(值);
    循环 (整64 k = 0; k < 长; k++) {
        整64 控位 = 整64(值[k]);
        如果 (控位 == 34) {                          // "
            字符串构建器::追加字节(句, 92);
            字符串构建器::追加字节(句, 34);
        } 否则 {
            如果 (控位 == 92) {                      // \
                字符串构建器::追加字节(句, 92);
                字符串构建器::追加字节(句, 92);
            } 否则 {
                // 控制字符判定（#361 清偿：1~31=ASCII 正值经符号扩展仍为正·
                //   ≥0x80 字节为负值恒不命中=多字节直通）
                如果 (控位 == 8) {
                    字符串构建器::追加字节(句, 92);      // \b
                    字符串构建器::追加字节(句, 98);
                } 否则 {
                    如果 (控位 == 12) {
                        字符串构建器::追加字节(句, 92);      // \f
                        字符串构建器::追加字节(句, 102);
                    } 否则 {
                        如果 (控位 == 10) {
                            字符串构建器::追加字节(句, 92);      // \n
                            字符串构建器::追加字节(句, 110);
                        } 否则 {
                            如果 (控位 == 13) {
                                字符串构建器::追加字节(句, 92);      // \r
                                字符串构建器::追加字节(句, 114);
                            } 否则 {
                                如果 (控位 == 9) {
                                    字符串构建器::追加字节(句, 92);      // \t
                                    字符串构建器::追加字节(句, 116);
                                } 否则 {
                                    如果 (控位 >= 1 && 控位 <= 31) {
                                        // 其它控制字符→\u00XX（控位即字节值）
                                        字符串 十六 = "0123456789abcdef";
                                        字符串构建器::追加字节(句, 92);      // \u00
                                        字符串构建器::追加字节(句, 117);
                                        字符串构建器::追加字节(句, 48);
                                        字符串构建器::追加字节(句, 48);
                                        字符串构建器::追加字节(句, 整64(十六[控位 / 16]));
                                        字符串构建器::追加字节(句, 整64(十六[控位 % 16]));
                                    } 否则 {
                                        字符串构建器::追加字节(句, 控位);      // 原字节直放（含 UTF-8 多字节直通）
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    字符串构建器::追加字节(句, 34);                 // 闭引号 "
}



// 缩进空格串（层×缩进宽·逐空格直追加进 句）
//   #728p：原 先建缩进串再由上层 字符串连接 拼入（每层整串重拷）改直追加
不安全 函数 生成缩进到(整64 层, 整64 宽, 整64 句) -> 空类型 {
    整64 总 = 层 * 宽;
    循环 (整64 k = 0; k < 总; k++) {
        字符串构建器::追加字节(句, 32);
    }
}

// 递归序列化（层=嵌套层·缩进>0 时换行美化）——构建器句柄沿途传递
//   #728p：原 每层返回新串再由上层 字符串连接 拼入（每层整串重拷=嵌套深
//   两层退化）改 句柄直追加（全树一趟 O(L)·366 解析侧同族）
不安全 函数 生成值到(JSON树* 树, 整64 节, 整64 缩进, 整64 层, 整64 句) -> 空类型 {
    整64 类型 = 树.类型(节);
    如果 (类型 == JSONT_空) {
        字符串构建器::追加(句, "null");
        返回;
    }
    // JSON 词 null/true/false（ASCII）
    如果 (类型 == JSONT_假) {
        字符串构建器::追加(句, "false");
        返回;
    }
    如果 (类型 == JSONT_真) {
        字符串构建器::追加(句, "true");
        返回;
    }
    如果 (类型 == JSONT_整数) {
        // 转换结果先落局部变量再传参（变量=拥有 RAII 释放；免「转换临时直传
        //   实参」每处漏 1 的 A2 临时登记缺口——已立案呈报·规避写法清单⑥）
        字符串 整文 = 整数转字符串(树.整值(节));
        字符串构建器::追加(句, 整文);
        返回;
    }
    如果 (类型 == JSONT_浮点) {
        字符串 浮文 = 浮点转字符串(树.浮值(节));
        字符串构建器::追加(句, 浮文);
        返回;
    }
    如果 (类型 == JSONT_字符串) {
        生成字符串字面到(树.文本(节), 句);
        返回;
    }
    // 数组/对象：空壳与带子两态（括号/分隔符全字节形态·免临时串构造）
    布尔 是对象 = 类型 == JSONT_对象;
    整64 括开 = 91;                  // '['
    整64 括闭 = 93;                  // ']'
    如果 (是对象) {
        括开 = 123;                  // '{'
        括闭 = 125;                  // '}'
    }
    // 子链遍历直走 子头们/兄弟们（O(子数) 一趟——原 子数()+子(节,序) 每序号
    //   从链头重走=O(子数²) 遍历热点；宽数组大负载实测锚·#728p 同轮根治）
    整64 游 = 树.子头们.元素(节);
    如果 (游 == -1) {
        字符串构建器::追加字节(句, 括开);
        字符串构建器::追加字节(句, 括闭);
        返回;
    }
    布尔 美化 = 缩进 > 0;
    字符串构建器::追加字节(句, 括开);
    当 (游 != -1) {
        如果 (美化) {
            字符串构建器::追加字节(句, 10);      // \n
            生成缩进到(层 + 1, 缩进, 句);
        }
        如果 (是对象) {
            生成字符串字面到(树.键们.元素(游), 句);
            字符串构建器::追加字节(句, 58);      // ':'
            如果 (美化) {
                字符串构建器::追加字节(句, 32);  // ' '
            }
        }
        生成值到(树, 游, 缩进, 层 + 1, 句);
        游 = 树.兄弟们.元素(游);
        如果 (游 != -1) {
            字符串构建器::追加字节(句, 44);      // ','
        }
    }
    如果 (美化) {
        字符串构建器::追加字节(句, 10);          // \n
        生成缩进到(层, 缩进, 句);
    }
    字符串构建器::追加字节(句, 括闭);
}
公开:
// ---- 生成文本（内部实现·非稳定 API：仅 JSON.cn 的 生成JSON 委托调用；
//      外部请用 JSON::生成JSON。树/根·缩进 0=紧凑 >0=每层空格数；节<0 返回 ""）----
//   #728p：实现改 字符串构建器 一趟直追加（新建→生成值到→完成·出串所有权
//   归调用方）；节<0 早退在 新建 之前=无句柄遗留；本路径无中途出错面，
//   故无 弃置 适用点（366 第五件适用面=错误路径中途放弃）
不安全 函数 生成文本(JSON树* 树, 整64 节, 整64 缩进) -> 字符串 {
    如果 (节 < 0) {
        返回 "";
    }
    整64 句 = 字符串构建器::新建();
    生成值到(树, 节, 缩进, 0, 句);
    返回 字符串构建器::完成(句);
}
