// CN 语言标准库：文件模块（Task 6.2，规格书阶段五「文件系统」；对标 C++ fstream）
// 公开: 打开文件/读取文件/写入文件/读取文件行/文件大小/关闭文件/文件存在（7 个函数）
// 实现：每个函数内部调用文件内置函数（文件::xxx，全局注册、无需导入），
//   内置函数由编译器 IR 层映射到运行时符号 __cn_file_open/__cn_file_read/
//   __cn_file_write/__cn_file_read_line/__cn_file_size/__cn_file_close/
//   __cn_file_exists（file_api.cpp）。
// 设计说明：
//   - 内置函数名带 "文件::" 前缀，与本模块公开函数纯名不冲突（数学库同模式）
//   - 句柄类型：空类型*（void*，C 层 FILE* 转换；打开失败返回 nullptr）
//   - 模式：1=读、2=写（截断）、3=追加；错误处理返回 结果<T,整32>，
//     错误码用 错误码.文件(5)/错误码.参数(6)
//   - 中文路径：运行时内部 MultiByteToWideChar(CP_UTF8) + _wfopen_s 打开
//   - 内存语义（A2 2026-09-11 收尾批）：读取文件行 返回 字符串=拥有——调用方 RAII 自动释放
导入 核心::错误码;
//   - 使用方式（v2.0）：导入 文件::打开文件 后 打开文件()，或 导入 文件::{打开文件}
公开:
函数 打开文件(字符串 路径, 整32 模式) -> 结果<空类型*, 整32> {
    空类型* 句柄 = 文件::打开文件(路径, 模式);
    如果 (句柄 == 无) {
        返回 错误(错误码.文件);
    }
    返回 正常(句柄);
}

函数 读取文件(空类型* 句柄, 字符* 缓冲, 整64 数量) -> 结果<整64, 整32> {
    整64 读取数量 = 文件::读取文件(句柄, 缓冲, 数量);
    如果 (读取数量 < 0) {
        返回 错误(错误码.文件);
    }
    返回 正常(读取数量);
}

函数 写入文件(空类型* 句柄, 字符串 数据) -> 结果<整64, 整32> {
    整64 写入数量 = 文件::写入文件(句柄, 数据);
    如果 (写入数量 < 0) {
        返回 错误(错误码.文件);
    }
    返回 正常(写入数量);
}

函数 读取文件行(空类型* 句柄) -> 结果<字符串, 整32> {
    字符串 行 = 文件::读取文件行(句柄);
    如果 (行 == 无) {
        返回 错误(错误码.文件);
    }
    返回 正常(行);
}

函数 文件大小(空类型* 句柄) -> 结果<整64, 整32> {
    整64 大小 = 文件::文件大小(句柄);
    如果 (大小 < 0) {
        返回 错误(错误码.文件);
    }
    返回 正常(大小);
}

函数 关闭文件(空类型* 句柄) -> 空类型 {
    文件::关闭文件(句柄);
}

函数 文件存在(字符串 路径) -> 布尔 {
    返回 文件::文件存在(路径);
}
