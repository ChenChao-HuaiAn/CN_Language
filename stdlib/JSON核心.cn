// CN 语言标准库：JSON 核心（#751 拆分自 JSON.cn·树定义 + 平行 arena 池操作）
//   JSON 模块拆分（AGENTS §3「先拆再加」·2026-10-21）：本文件=常量+JSON树；
//   JSON解析器.cn=递归下降解析器；JSON生成器.cn=序列化生成器；JSON.cn=公开 API
//   聚合（解析JSON/生成JSON/重置JSON树 + 再导出 JSON树/常量——用户导入面不变）。
// 节点布局（原 JSON.cn 头注）：节点=6 个平行向量的同索引切片（类型们/文本们/
//   数值们/浮值们/子头们/兄弟们），数组/对象 子节点沿 兄弟们 单链遍历
//   （子头们=首子·-1=尾）；容器全平铺在树一层=容器已验证健康面（池形态B/
//   字段向量两探针 dual 绿实证）；计数/索引字段一律 整64（#365 形态规避）。
//   安全性：树=池索引（整64）无指针字段；跨模块一律公开成员访问器。
公开:
导入 容器::向量;

// ---- 节点类型常量 ----
常量 JSONT_空 = 0;
常量 JSONT_假 = 1;
常量 JSONT_真 = 2;
常量 JSONT_整数 = 3;
常量 JSONT_浮点 = 4;
常量 JSONT_字符串 = 5;
常量 JSONT_数组 = 6;
常量 JSONT_对象 = 7;

// ---- 错误码常量 ----
常量 JSONE_好 = 0;
常量 JSONE_语法 = 1;
常量 JSONE_深超 = 2;
常量 JSONE_尾余 = 3;

// ==================== JSON树（平行 arena 池） ====================
类 JSON树 {
公开:
    // 标量前置（v2 布局规避·021 #362：向量字段后的标量成员偏移 v2 未登记——
    //   669 轮 dual 实证「成员字段偏移未知: .错误码」——668 测试器 标量前置形态绿）
    整64 根;                 // -1=空树
    整64 错误码;             // JSONE_ 好=0
    整64 错误位置;           // 错误字节偏移
    整64 错误字节;           // 错误处字节值（源尾=-1）
    向量<整64> 类型们;
    向量<字符串> 文本们;     // 字符串值
    向量<字符串> 键们;       // 对象成员键（与值节点同索引·键/值分离——文本槽专存值）
    向量<整64> 数值们;       // 整数值
    向量<浮64> 浮值们;       // 浮点值
    向量<整64> 子头们;       // 数组/对象=首子索引·标量=-1
    向量<整64> 兄弟们;       // 子链下一索引·-1=尾

    函数 JSON树() {
        根 = -1;
        错误码 = 0;
        错误位置 = 0;
        错误字节 = 0;
        类型们 = 向量<整64>();
        文本们 = 向量<字符串>();
        键们 = 向量<字符串>();
        数值们 = 向量<整64>();
        浮值们 = 向量<浮64>();
        子头们 = 向量<整64>();
        兄弟们 = 向量<整64>();
    }
    不安全 函数 ~JSON树() {
    }

    // 追加新节点（标量/空壳·子头兄弟均 -1）→新索引；分配失败=置错返 -1
    不安全 函数 新节点(整64 类型) -> 整64 {
        整64 新位 = 类型们.大小();
        结果<空类型, 整32> 追甲 = 类型们.追加(类型);
        结果<空类型, 整32> 追乙 = 文本们.追加("");
        结果<空类型, 整32> 追乙二 = 键们.追加("");
        结果<空类型, 整32> 追丙 = 数值们.追加(0);
        结果<空类型, 整32> 追丁 = 浮值们.追加(0.0);
        结果<空类型, 整32> 追戊 = 子头们.追加(-1);
        结果<空类型, 整32> 追己 = 兄弟们.追加(-1);
        如果 (!追甲.正常 || !追乙.正常 || !追乙二.正常 || !追丙.正常 || !追丁.正常 || !追戊.正常 || !追己.正常) {
            错误码 = JSONE_语法;
            错误位置 = -1;
            错误字节 = -1;
            返回 -1;
        }
        返回 新位;
    }

    // 节点类型
    常量 函数 类型(整64 节) -> 整64 {
        返回 类型们.元素(节);
    }

    // 节点文本（字符串值/对象成员键·借用语义随树存活）
    常量 函数 文本(整64 节) -> 字符串 {
        返回 文本们.元素(节);
    }

    // 整数值（JSONT_整数）
    常量 函数 整值(整64 节) -> 整64 {
        返回 数值们.元素(节);
    }

    // 浮点值（JSONT_浮点）
    常量 函数 浮值(整64 节) -> 浮64 {
        返回 浮值们.元素(节);
    }

    // 子节点个数（数组=元素数·对象=成员数）
    常量 函数 子数(整64 节) -> 整64 {
        整64 计数 = 0;
        整64 游 = 子头们.元素(节);
        当 (游 != -1) {
            计数 = 计数 + 1;
            游 = 兄弟们.元素(游);
        }
        返回 计数;
    }

    // 第 序 个子节点（越界=-1）
    常量 函数 子(整64 节, 整64 序) -> 整64 {
        整64 游 = 子头们.元素(节);
        整64 索 = 0;
        当 (游 != -1) {
            如果 (索 == 序) {
                返回 游;
            }
            索 = 索 + 1;
            游 = 兄弟们.元素(游);
        }
        返回 -1;
    }

    // 对象按键查值（命中=值节点索引·未命中=-1；键比较=字符串内容比较）
    常量 函数 找键(整64 对象节, 字符串 键) -> 整64 {
        整64 游 = 子头们.元素(对象节);
        当 (游 != -1) {
            字符串 候 = 键们.元素(游);
            如果 (字符串比较(候, 键)) {
                返回 游;
            }
            游 = 兄弟们.元素(游);
        }
        返回 -1;
    }


    // 尾接子节点（O(1) 通道·#751：调用方持局部链尾索引时用）
    //   父=数组/对象·尾=该父当前链尾（-1=尚无子）·子=新节点索引。
    //   返回新链尾（子节）；设置失败=置错并原样返回 尾（链未推进——错误面与
    //   接子 一致：错误码 JSONE_语法·解析器照旧继续，顶层按既有通道收）。
    //   安全性：尾=池索引（整64）而非指针——向量扩容搬移元素不使索引失效，
    //   无裸指针/无借用视图/无悬垂面（001 §1.1a④ 不触；本优化零不安全新增）。
    不安全 函数 接子到(整64 父, 整64 尾, 整64 子节) -> 整64 {
        如果 (尾 == -1) {
            结果<空类型, 整32> 设果 = 子头们.设置(父, 子节);
            如果 (!设果.正常) {
                错误码 = JSONE_语法;
                返回 尾;
            }
            返回 子节;
        }
        结果<空类型, 整32> 设果 = 兄弟们.设置(尾, 子节);
        如果 (!设果.正常) {
            错误码 = JSONE_语法;
            返回 尾;
        }
        返回 子节;
    }

    // 尾接子节点（父=数组/对象·子=新节点索引·接子链尾）
    //   O(子数) 链尾遍历形态——公开 API 语义/复杂度承诺保持（#751）；解析器
    //   内部已改 接子到 O(1)（每子不再从链头重走=原 O(子数²) 热点）。
    不安全 函数 接子(整64 父, 整64 子节) -> 空类型 {
        如果 (子头们.元素(父) == -1) {
            结果<空类型, 整32> 设果 = 子头们.设置(父, 子节);
            如果 (!设果.正常) {
                错误码 = JSONE_语法;
            }
            返回;
        }
        整64 游 = 子头们.元素(父);
        当 (兄弟们.元素(游) != -1) {
            游 = 兄弟们.元素(游);
        }
        结果<空类型, 整32> 设果 = 兄弟们.设置(游, 子节);
        如果 (!设果.正常) {
            错误码 = JSONE_语法;
        }
    }


    // 清空复用（池三件清零+根复位——池元素为 标量/字符串·容器析构自清）
    不安全 函数 重置() -> 空类型 {
        类型们.清空();
        文本们.清空();
        键们.清空();
        数值们.清空();
        浮值们.清空();
        子头们.清空();
        兄弟们.清空();
        根 = -1;
        错误码 = JSONE_好;
        错误位置 = 0;
        错误字节 = 0;
    }
}
