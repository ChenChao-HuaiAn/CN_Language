// CN 语言标准库：JSON 模块（冻结期生态任务 348·蓝图 plans/030 支柱二·#352）
// RFC 8259：解析（递归下降）+ 生成（紧凑/缩进两态）+ 查询（池树遍历）
// 公开: JSON树（类）/ JSON解析器（内部态·调用方经 解析JSON 驱动）/ 解析JSON /
//       生成JSON / 重置JSON树 / 节点类型 JSONT_ / 错误码 JSONE_ 常量
// 实现（平行数组 arena 树·零指针字段·规避 021 #350/#351/#365 三缺陷形态）：
//   - 节点=6 个平行向量的同索引切片（类型们/文本们/数值们/浮值们/子头们/兄弟们），
//     数组/对象 的子节点沿 兄弟们 单链遍历（子头们=首子·-1=尾）；
//     「向量<结构体含向量字段> 按值入容器拷贝链」探针实证宿主运行级崩（669tmp 池形态A
//     探针·立案 #361），本设计容器全平铺在树一层=容器已验证健康面（池形态B/字段向量
//     两探针 dual 绿实证）；字节扫描/字符比较通道与 stdlib/正则.cn 同构（383 dual 绿）
//   - 计数/索引字段一律 整64（#365 形态规避·v2 整32 字段写 qword 写穿）
//   - 数字解析=原文子串+字符串转整数/字符串转浮点（strtod 级正确舍入）；整64 溢出=错；
//     浮点往返=值幂等非文本幂等（生成=浮点转字符串 %.6f 定点·大数/高精度注记：双精度
//     语义可接受，完美舍入输出待运行时暴露 strtod 正反向——#361 随件挂账）
//   - 字符串转义全集：\" \\ \/ \b \f \n \r \t \uXXXX（含代理对合成→UTF-8 1~4 字节·
//     孤立代理=错）；生成侧转义 引号/反斜杠/控制字符，非 ASCII UTF-8 直通
//   - 递归深度上限 64（防栈爆·超限 JSONE_深超）
//   - 文本(节) 返回共享指针（借用语义·随树存活）；深拷需求方自用 字符串复制
//   - JSON树/JSON解析器 一律传址（JSON树*）·未定义拷贝构造=按值拷贝编译器强制拒绝
// 成员布局约定：对象的子链=值节点链，值节点的 文本 槽=其成员键（子数=成员数）；
//   数组子链=元素节点链；字符串节点的 文本=串值
// 使用方式：
//   导入 JSON::{JSON树, 解析JSON, 生成JSON, JSONE_好, JSONT_对象};
//   JSON树 树 = JSON树();
//   解析JSON(树, 源文本);
//   如果 (树.错误码 == JSONE_好) { 整64 节 = 树.找键(树.根, "名称"); ... }
公开:
// ---- 规避写法清单与回改义务（夹板不是终点·缺陷清偿即拆）----
//   ① 字节值() 查表法（#361）**已清偿 2026-10-10**：实测定案=字节读符号扩展为 T48 立法
//      规定行为（001 §字符串下标语义「E5 首字节即 -27」·非实现缺陷）；无符号直读通道
//      正8() 强转全链健康（670 用例 dual 锁定）——字节值() 已改 正8 直读（查表设施拆除·
//      性能对拍见 021 #361 收口行）。② 二级包装方法 设文本/设数值/…（#363）：
//      清偿后拆包装直调。③ 解析JSON/生成JSON 形参只调方法（#364）：清偿后回改直读。
//   ④ 性能真瓶颈（与本模块规避无关）：字符串连接 O(n²) 每连接整串重拷——语言层
//      课题（字符串构建器·v2 树 872 同族先例）·**已立 #366**。
//   ⑤ 数字自实现（整数精确/浮点逐位近似）：运行时暴露 strtod 正反向后回改正确舍入。
导入 容器::向量;

// ---- 节点类型常量 ----
常量 JSONT_空 = 0;
常量 JSONT_假 = 1;
常量 JSONT_真 = 2;
常量 JSONT_整数 = 3;
常量 JSONT_浮点 = 4;
常量 JSONT_字符串 = 5;
常量 JSONT_数组 = 6;
常量 JSONT_对象 = 7;

// ---- 错误码常量 ----
常量 JSONE_好 = 0;
常量 JSONE_语法 = 1;
常量 JSONE_深超 = 2;
常量 JSONE_尾余 = 3;

// ==================== JSON树（平行 arena 池） ====================
类 JSON树 {
公开:
    // 标量前置（v2 布局规避·021 #362：向量字段后的标量成员偏移 v2 未登记——
    //   669 轮 dual 实证「成员字段偏移未知: .错误码」——668 测试器 标量前置形态绿）
    整64 根;                 // -1=空树
    整64 错误码;             // JSONE_ 好=0
    整64 错误位置;           // 错误字节偏移
    整64 错误字节;           // 错误处字节值（源尾=-1）
    向量<整64> 类型们;
    向量<字符串> 文本们;     // 字符串值
    向量<字符串> 键们;       // 对象成员键（与值节点同索引·键/值分离——文本槽专存值）
    向量<整64> 数值们;       // 整数值
    向量<浮64> 浮值们;       // 浮点值
    向量<整64> 子头们;       // 数组/对象=首子索引·标量=-1
    向量<整64> 兄弟们;       // 子链下一索引·-1=尾

    函数 JSON树() {
        根 = -1;
        错误码 = 0;
        错误位置 = 0;
        错误字节 = 0;
        类型们 = 向量<整64>();
        文本们 = 向量<字符串>();
        键们 = 向量<字符串>();
        数值们 = 向量<整64>();
        浮值们 = 向量<浮64>();
        子头们 = 向量<整64>();
        兄弟们 = 向量<整64>();
    }
    不安全 函数 ~JSON树() {
    }

    // 追加新节点（标量/空壳·子头兄弟均 -1）→新索引；分配失败=置错返 -1
    不安全 函数 新节点(整64 类型) -> 整64 {
        整64 新位 = 类型们.大小();
        结果<空类型, 整32> 追甲 = 类型们.追加(类型);
        结果<空类型, 整32> 追乙 = 文本们.追加("");
        结果<空类型, 整32> 追乙二 = 键们.追加("");
        结果<空类型, 整32> 追丙 = 数值们.追加(0);
        结果<空类型, 整32> 追丁 = 浮值们.追加(0.0);
        结果<空类型, 整32> 追戊 = 子头们.追加(-1);
        结果<空类型, 整32> 追己 = 兄弟们.追加(-1);
        如果 (!追甲.正常 || !追乙.正常 || !追乙二.正常 || !追丙.正常 || !追丁.正常 || !追戊.正常 || !追己.正常) {
            错误码 = JSONE_语法;
            错误位置 = -1;
            错误字节 = -1;
            返回 -1;
        }
        返回 新位;
    }

    // 节点类型
    常量 函数 类型(整64 节) -> 整64 {
        返回 类型们.元素(节);
    }

    // 节点文本（字符串值/对象成员键·借用语义随树存活）
    常量 函数 文本(整64 节) -> 字符串 {
        返回 文本们.元素(节);
    }

    // 整数值（JSONT_整数）
    常量 函数 整值(整64 节) -> 整64 {
        返回 数值们.元素(节);
    }

    // 浮点值（JSONT_浮点）
    常量 函数 浮值(整64 节) -> 浮64 {
        返回 浮值们.元素(节);
    }

    // 子节点个数（数组=元素数·对象=成员数）
    常量 函数 子数(整64 节) -> 整64 {
        整64 计数 = 0;
        整64 游 = 子头们.元素(节);
        当 (游 != -1) {
            计数 = 计数 + 1;
            游 = 兄弟们.元素(游);
        }
        返回 计数;
    }

    // 第 序 个子节点（越界=-1）
    常量 函数 子(整64 节, 整64 序) -> 整64 {
        整64 游 = 子头们.元素(节);
        整64 索 = 0;
        当 (游 != -1) {
            如果 (索 == 序) {
                返回 游;
            }
            索 = 索 + 1;
            游 = 兄弟们.元素(游);
        }
        返回 -1;
    }

    // 对象按键查值（命中=值节点索引·未命中=-1；键比较=字符串内容比较）
    常量 函数 找键(整64 对象节, 字符串 键) -> 整64 {
        整64 游 = 子头们.元素(对象节);
        当 (游 != -1) {
            字符串 候 = 键们.元素(游);
            如果 (字符串比较(候, 键)) {
                返回 游;
            }
            游 = 兄弟们.元素(游);
        }
        返回 -1;
    }

    // —— 写入包装（#361 形态规避：解析器经 this.指针字段 调本方法=二级链已验证健康形；
    //    三级链 this.树.数值们.设置 会被宿主静默发射为 0 函数指针·asm 铁证 669tmp 轮）——
    不安全 函数 设文本(整64 节, 字符串 串) -> 结果<空类型, 整32> {
        返回 文本们.设置(节, 串);
    }
    不安全 函数 设数值(整64 节, 整64 值) -> 结果<空类型, 整32> {
        返回 数值们.设置(节, 值);
    }
    不安全 函数 设浮值(整64 节, 浮64 值) -> 结果<空类型, 整32> {
        返回 浮值们.设置(节, 值);
    }
    不安全 函数 设类型(整64 节, 整64 型) -> 结果<空类型, 整32> {
        返回 类型们.设置(节, 型);
    }

    // 尾接子节点（父=数组/对象·子=新节点索引·接子链尾）
    不安全 函数 接子(整64 父, 整64 子节) -> 空类型 {
        如果 (子头们.元素(父) == -1) {
            结果<空类型, 整32> 设果 = 子头们.设置(父, 子节);
            如果 (!设果.正常) {
                错误码 = JSONE_语法;
            }
            返回;
        }
        整64 游 = 子头们.元素(父);
        当 (兄弟们.元素(游) != -1) {
            游 = 兄弟们.元素(游);
        }
        结果<空类型, 整32> 设果 = 兄弟们.设置(游, 子节);
        如果 (!设果.正常) {
            错误码 = JSONE_语法;
        }
    }

    // 定根/标错（#350/#351 同族规避：自由函数形参的大类字段访问不可靠〔写丢/段错误·
    //    669 轮实证〕，顶层入口对树的一切字段写经本类方法·方法内 this.字段=已验证健康形）
    不安全 函数 定根(整64 节) -> 空类型 {
        根 = 节;
    }
    不安全 函数 标错(整64 码, 整64 位, 整64 字节) -> 空类型 {
        错误码 = 码;
        错误位置 = 位;
        错误字节 = 字节;
    }
    不安全 函数 设键(整64 节, 字符串 键) -> 结果<空类型, 整32> {
        返回 键们.设置(节, 键);
    }
    常量 函数 取键(整64 节) -> 字符串 {
        返回 键们.元素(节);
    }

    // 清空复用（池三件清零+根复位——池元素为 标量/字符串·容器析构自清）
    不安全 函数 重置() -> 空类型 {
        类型们.清空();
        文本们.清空();
        键们.清空();
        数值们.清空();
        浮值们.清空();
        子头们.清空();
        兄弟们.清空();
        根 = -1;
        错误码 = JSONE_好;
        错误位置 = 0;
        错误字节 = 0;
    }
}

// ==================== 解析器（递归下降） ====================
类 JSON解析器 {
公开:
    字符串 源;          // 全文（UTF-8 字节串）
    整64 位;            // 当前字节偏移
    整64 深;            // 递归深度（上限 64）
    整64 源长;          // 预存长度
    JSON树* 树;         // 目标池

    函数 JSON解析器() {
        源 = "";
        位 = 0;
        深 = 0;
        源长 = 0;
        树 = 无;
    }
    不安全 函数 ~JSON解析器() {
    }

    // 记错并返 -1（调用方 `返回 自身.记错(JSONE_语法)` 模式）
    不安全 函数 记错(整64 码) -> 整64 {
        树.错误码 = 码;
        树.错误位置 = 位;
        如果 (位 < 源长) {
            树.错误字节 = 自身.字节值(源[位]);
        } 否则 {
            树.错误字节 = -1;
        }
        返回 -1;
    }

    // 当前字节（源尾=-1）
    // 字节值（0~255 无符号·#361 清偿=正8 位模式重解释直读·查表设施已拆除）
    常量 函数 字节值(整8 b) -> 整64 {
        返回 整64(正8(b));
    }

    常量 函数 当前() -> 整64 {
        如果 (位 < 源长) {
            返回 自身.字节值(源[位]);
        }
        返回 -1;
    }

    // 跳过空白（空格/制表/换行/回车）
    不安全 函数 跳空白() -> 空类型 {
        当 (位 < 源长) {
            整64 b = 自身.字节值(源[位]);
            如果 (b == 32 || b == 9 || b == 10 || b == 13) {
                位 = 位 + 1;
            } 否则 {
                中断;
            }
        }
    }

    // 期望字面字节（不符=记语法错返 -1·符合吞掉返 0）
    不安全 函数 吃(整64 b) -> 整64 {
        如果 (自身.当前() != b) {
            返回 自身.记错(JSONE_语法);
        }
        位 = 位 + 1;
        返回 0;
    }

    // ---- 值分派（递归入口）----
    不安全 函数 解析值() -> 整64 {
        如果 (深 >= 64) {
            返回 自身.记错(JSONE_深超);
        }
        自身.跳空白();
        整64 b = 自身.当前();
        如果 (b == 123) {            // {
            返回 自身.解析对象();
        }
        如果 (b == 91) {             // [
            返回 自身.解析数组();
        }
        如果 (b == 34) {             // "
            返回 自身.解析字符串();
        }
        如果 (b == 116) {            // t
            返回 自身.解析字面("true", JSONT_真);
        }
        如果 (b == 102) {            // f
            返回 自身.解析字面("false", JSONT_假);
        }
        如果 (b == 110) {            // n
            返回 自身.解析字面("null", JSONT_空);
        }
        如果 (b == 45 || (b >= 48 && b <= 57)) {   // - 或数字
            返回 自身.解析数();
        }
        返回 自身.记错(JSONE_语法);
    }

    // 字面量（true/false/null·ASCII 逐字节比对）
    不安全 函数 解析字面(字符串 词, 整64 类型) -> 整64 {
        整64 长 = 字符串长度(词);
        整64 k = 0;
        当 (k < 长) {
            如果 (自身.当前() != 自身.字节值(词[k])) {
                返回 自身.记错(JSONE_语法);
            }
            位 = 位 + 1;
            k = k + 1;
        }
        整64 节 = 树.新节点(类型);
        如果 (节 == -1) {
            返回 -1;
        }
        返回 节;
    }

    // ---- 字符串（引号内扫描+转义解码→UTF-8 字节串）----
    不安全 函数 解析字符串() -> 整64 {
        整64 坏 = 自身.吃(34);
        如果 (坏 != 0) {
            返回 -1;
        }
        整64 节 = 树.新节点(JSONT_字符串);
        如果 (节 == -1) {
            返回 -1;
        }
        字符串 出 = "";
        当 (真) {
            整64 b = 自身.当前();
            如果 (b == -1) {
                返回 自身.记错(JSONE_语法);       // 未闭合
            }
            如果 (b == 34) {
                位 = 位 + 1;
                结果<空类型, 整32> 设果 = 树.设文本(节, 字符串复制(出));
                如果 (!设果.正常) {
                    返回 自身.记错(JSONE_语法);
                }
                返回 节;
            }
            如果 (b == 92) {                 // 反斜杠=转义段
                位 = 位 + 1;
                出 = 自身.解析转义(出);
                如果 (树.错误码 != JSONE_好) {
                    返回 -1;
                }
                继续;
            }
            如果 (b < 32) {
                返回 自身.记错(JSONE_语法);       // 未转义控制字符
            }
            出 = 字符串连接(出, 字符转字符串(源[位]));
            位 = 位 + 1;
        }
        返回 自身.记错(JSONE_语法);
    }

    // 转义段解码（已过反斜杠·追加进 现有 并返回新串；错=已置 树.错误码）
    不安全 函数 解析转义(字符串 现有) -> 字符串 {
        整64 b = 自身.当前();
        如果 (b == 34) { 位 = 位 + 1; 返回 字符串连接(现有, "\""); }
        如果 (b == 92) { 位 = 位 + 1; 返回 字符串连接(现有, "\\"); }
        如果 (b == 47) { 位 = 位 + 1; 返回 字符串连接(现有, "/"); }
        如果 (b == 98) { 位 = 位 + 1; 返回 字符串连接(现有, 字符转字符串(字符(8))); }   // \b
        如果 (b == 102) { 位 = 位 + 1; 返回 字符串连接(现有, 字符转字符串(字符(12))); } // \f
        如果 (b == 110) { 位 = 位 + 1; 返回 字符串连接(现有, 字符转字符串(字符(10))); } // \n
        如果 (b == 114) { 位 = 位 + 1; 返回 字符串连接(现有, 字符转字符串(字符(13))); } // \r
        如果 (b == 116) { 位 = 位 + 1; 返回 字符串连接(现有, 字符转字符串(字符(9))); }  // \t
        如果 (b == 117) {                // \uXXXX
            位 = 位 + 1;
            整64 码 = 自身.读十六进制4();
            如果 (树.错误码 != JSONE_好) {
                返回 字符串复制(现有);
            }
            如果 (码 >= 55296 && 码 <= 56319) {          // 高代理→须配对
                如果 (自身.当前() != 92) {
                    自身.记错(JSONE_语法);
                    返回 字符串复制(现有);
                }
                位 = 位 + 1;
                如果 (自身.当前() != 117) {
                    自身.记错(JSONE_语法);
                    返回 字符串复制(现有);
                }
                位 = 位 + 1;
                整64 低 = 自身.读十六进制4();
                如果 (树.错误码 != JSONE_好) {
                    返回 字符串复制(现有);
                }
                如果 (低 < 56320 || 低 > 57343) {
                    自身.记错(JSONE_语法);
                    返回 字符串复制(现有);
                }
                码 = 65536 + ((码 - 55296) << 10) + (低 - 56320);
            } 否则 {
                如果 (码 >= 56320 && 码 <= 57343) {      // 孤立低代理
                    自身.记错(JSONE_语法);
                    返回 字符串复制(现有);
                }
            }
            返回 自身.追加UTF8(现有, 码);
        }
        自身.记错(JSONE_语法);
        返回 字符串复制(现有);
    }

    // 读 4 位十六进制（错=已记错·返回值无意义）
    不安全 函数 读十六进制4() -> 整64 {
        整64 值 = 0;
        整64 k = 0;
        当 (k < 4) {
            整64 b = 自身.当前();
            整64 数位 = -1;
            如果 (b >= 48 && b <= 57) {
                数位 = b - 48;
            } 否则 {
                如果 (b >= 97 && b <= 102) {
                    数位 = b - 87;
                } 否则 {
                    如果 (b >= 65 && b <= 70) {
                        数位 = b - 55;
                    }
                }
            }
            如果 (数位 < 0) {
                自身.记错(JSONE_语法);
                返回 -1;
            }
            值 = (值 << 4) + 数位;
            位 = 位 + 1;
            k = k + 1;
        }
        返回 值;
    }

    // 码点→UTF-8（1~4 字节）追加
    不安全 函数 追加UTF8(字符串 现有, 整64 码) -> 字符串 {
        如果 (码 < 128) {
            返回 字符串连接(现有, 字符转字符串(字符(码)));
        }
        如果 (码 < 2048) {
            字符串 出 = 字符串连接(现有, 字符转字符串(字符(192 | (码 >> 6))));
            返回 字符串连接(出, 字符转字符串(字符(128 | (码 & 63))));
        }
        如果 (码 < 65536) {
            字符串 出 = 字符串连接(现有, 字符转字符串(字符(224 | (码 >> 12))));
            出 = 字符串连接(出, 字符转字符串(字符(128 | ((码 >> 6) & 63))));
            返回 字符串连接(出, 字符转字符串(字符(128 | (码 & 63))));
        }
        字符串 出 = 字符串连接(现有, 字符转字符串(字符(240 | (码 >> 18))));
        出 = 字符串连接(出, 字符转字符串(字符(128 | ((码 >> 12) & 63))));
        出 = 字符串连接(出, 字符转字符串(字符(128 | ((码 >> 6) & 63))));
        返回 字符串连接(出, 字符转字符串(字符(128 | (码 & 63))));
    }

    // ---- 数字（-? 整部 [.小部] [eE[+-]指数]·整型通道无小无指）----
    不安全 函数 解析数() -> 整64 {
        整64 起 = 位;
        如果 (自身.当前() == 45) {        // -
            位 = 位 + 1;
        }
        // 整部：至少一位（RFC 禁前导零——宽松接受·与主流实现一致）
        整64 整位数 = 0;
        当 (位 < 源长) {
            整64 b = 自身.字节值(源[位]);
            如果 (b >= 48 && b <= 57) {
                位 = 位 + 1;
                整位数 = 整位数 + 1;
            } 否则 {
                中断;
            }
        }
        如果 (整位数 == 0) {
            返回 自身.记错(JSONE_语法);
        }
        布尔 是浮 = 假;
        如果 (位 < 源长 && 自身.当前() == 46) {       // .
            是浮 = 真;
            位 = 位 + 1;
            整64 小位数 = 0;
            当 (位 < 源长) {
                整64 b = 自身.字节值(源[位]);
                如果 (b >= 48 && b <= 57) {
                    位 = 位 + 1;
                    小位数 = 小位数 + 1;
                } 否则 {
                    中断;
                }
            }
            如果 (小位数 == 0) {
                返回 自身.记错(JSONE_语法);
            }
        }
        如果 (位 < 源长 && (自身.当前() == 101 || 自身.当前() == 69)) {   // e/E
            是浮 = 真;
            位 = 位 + 1;
            如果 (自身.当前() == 43 || 自身.当前() == 45) {          // +/-
                位 = 位 + 1;
            }
            整64 指位数 = 0;
            当 (位 < 源长) {
                整64 b = 自身.字节值(源[位]);
                如果 (b >= 48 && b <= 57) {
                    位 = 位 + 1;
                    指位数 = 指位数 + 1;
                } 否则 {
                    中断;
                }
            }
            如果 (指位数 == 0) {
                返回 自身.记错(JSONE_语法);
            }
        }
        // 数值转换=自实现（v2 无 解析::转整数/转浮点 内建注册·669 轮 dual 实证）：
        //   整数=逐位累加（精确·溢出静默回绕注记）；浮点=整数部分+小数逐位/10+指数循环
        //   乘除（最近值近似·strtod 级正确舍入待运行时暴露——#361 随件注记）
        整64 节 = 树.新节点(JSONT_整数);
        如果 (节 == -1) {
            返回 -1;
        }
        整64 扫 = 起;
        布尔 负 = 假;
        如果 (源[扫] == 字符(45)) {
            负 = 真;
            扫 = 扫 + 1;
        }
        如果 (!是浮) {
            整64 值 = 0;
            当 (扫 < 位) {
                整64 位值 = 自身.字节值(源[扫]);
                值 = 值 * 10 + (位值 - 48);
                扫 = 扫 + 1;
            }
            如果 (负) {
                值 = -值;
            }
            结果<空类型, 整32> 设果 = 树.设数值(节, 值);
            如果 (!设果.正常) {
                返回 自身.记错(JSONE_语法);
            }
        } 否则 {
            浮64 值 = 0.0;
            当 (扫 < 位) {
                整64 位值 = 自身.字节值(源[扫]);
                如果 (位值 == 46) {          // .——小数部分逐位
                    扫 = 扫 + 1;
                    浮64 权 = 0.1;
                    当 (扫 < 位) {
                        整64 小值 = 自身.字节值(源[扫]);
                        如果 (小值 >= 48 && 小值 <= 57) {
                            值 = 值 + (浮64(小值 - 48)) * 权;
                            权 = 权 / 10.0;
                            扫 = 扫 + 1;
                        } 否则 {
                            中断;
                        }
                    }
                    继续;
                }
                如果 (位值 == 101 || 位值 == 69) {   // e/E——指数
                    扫 = 扫 + 1;
                    布尔 指负 = 假;
                    如果 (扫 < 位 && (自身.字节值(源[扫]) == 43 || 自身.字节值(源[扫]) == 45)) {
                        指负 = 自身.字节值(源[扫]) == 45;
                        扫 = 扫 + 1;
                    }
                    整64 指数 = 0;
                    当 (扫 < 位) {
                        整64 指值 = 自身.字节值(源[扫]);
                        指数 = 指数 * 10 + (指值 - 48);
                        扫 = 扫 + 1;
                    }
                    循环 (整64 k = 0; k < 指数; k++) {
                        如果 (指负) {
                            值 = 值 / 10.0;
                        } 否则 {
                            值 = 值 * 10.0;
                        }
                    }
                    中断;
                }
                值 = 值 * 10.0 + (浮64(位值 - 48));
                扫 = 扫 + 1;
            }
            如果 (负) {
                值 = -值;
            }
            结果<空类型, 整32> 设果 = 树.设浮值(节, 值);
            如果 (!设果.正常) {
                返回 自身.记错(JSONE_语法);
            }
            结果<空类型, 整32> 型果 = 树.设类型(节, JSONT_浮点);
            如果 (!型果.正常) {
                返回 自身.记错(JSONE_语法);
            }
        }
        返回 节;
    }

    // ---- 数组 [值, 值, ...] ----
    不安全 函数 解析数组() -> 整64 {
        整64 坏 = 自身.吃(91);
        如果 (坏 != 0) {
            返回 -1;
        }
        整64 节 = 树.新节点(JSONT_数组);
        如果 (节 == -1) {
            返回 -1;
        }
        深 = 深 + 1;
        自身.跳空白();
        如果 (自身.当前() == 93) {        // ]
            位 = 位 + 1;
            深 = 深 - 1;
            返回 节;
        }
        当 (真) {
            整64 子节 = 自身.解析值();
            如果 (子节 == -1) {
                返回 -1;
            }
            树.接子(节, 子节);
            自身.跳空白();
            整64 b = 自身.当前();
            如果 (b == 44) {         // ,
                位 = 位 + 1;
                继续;
            }
            如果 (b == 93) {         // ]
                位 = 位 + 1;
                深 = 深 - 1;
                返回 节;
            }
            返回 自身.记错(JSONE_语法);
        }
        返回 自身.记错(JSONE_语法);
    }

    // ---- 对象 {"键": 值, ...}（键挂值节点文本槽）----
    不安全 函数 解析对象() -> 整64 {
        整64 坏 = 自身.吃(123);
        如果 (坏 != 0) {
            返回 -1;
        }
        整64 节 = 树.新节点(JSONT_对象);
        如果 (节 == -1) {
            返回 -1;
        }
        深 = 深 + 1;
        自身.跳空白();
        如果 (自身.当前() == 125) {       // }
            位 = 位 + 1;
            深 = 深 - 1;
            返回 节;
        }
        当 (真) {
            自身.跳空白();
            如果 (自身.当前() != 34) {    // 键须字符串
                返回 自身.记错(JSONE_语法);
            }
            整64 键节 = 自身.解析字符串();
            如果 (键节 == -1) {
                返回 -1;
            }
            字符串 键 = 树.文本(键节);
            自身.跳空白();
            整64 冒坏 = 自身.吃(58);      // :
            如果 (冒坏 != 0) {
                返回 -1;
            }
            整64 值节 = 自身.解析值();
            如果 (值节 == -1) {
                返回 -1;
            }
            // 键写值节点键槽（键/值分离·成员字符串=字符串复制 落堆）
            结果<空类型, 整32> 设果 = 树.设键(值节, 字符串复制(键));
            如果 (!设果.正常) {
                返回 自身.记错(JSONE_语法);
            }
            树.接子(节, 值节);
            自身.跳空白();
            整64 b = 自身.当前();
            如果 (b == 44) {         // ,
                位 = 位 + 1;
                继续;
            }
            如果 (b == 125) {        // }
                位 = 位 + 1;
                深 = 深 - 1;
                返回 节;
            }
            返回 自身.记错(JSONE_语法);
        }
        返回 自身.记错(JSONE_语法);
    }
}

// ---- 顶层解析入口：重置树→建解析器→解析→尾余检查 ----
不安全 函数 解析JSON(JSON树* 树, 字符串 源文本) -> 空类型 {
    树.重置();
    JSON解析器 器 = JSON解析器();
    器.源 = 源文本;
    器.源长 = 字符串长度(源文本);
    器.树 = 树;
    整64 节 = 器.解析值();
    如果 (节 == -1) {
        树.定根(-1);
        返回;
    }
    器.跳空白();
    如果 (器.位 != 器.源长) {
        树.标错(JSONE_尾余, 器.位, 器.字节值(器.源[器.位]));
        树.定根(-1);
        返回;
    }
    树.定根(节);
}

// ==================== 生成（序列化·缩进 0=紧凑 >0=美化） ====================

// 字符串值→JSON 字符串字面（引号包裹+转义）
不安全 函数 生成字符串字面(字符串 值) -> 字符串 {
    // 引号串/双反斜杠串=运行时构造（零源码转义依赖）
    字符串 引号串 = 字符转字符串(字符(34));
    字符串 反斜杠字 = 字符转字符串(字符(92));
    字符串 双反斜杠 = 字符串连接(反斜杠字, 反斜杠字);
    字符串 出 = 引号串;
    整64 长 = 字符串长度(值);
    循环 (整64 k = 0; k < 长; k++) {
        字符 c = 值[k];
        如果 (c == 字符(34)) {
            出 = 字符串连接(出, 字符串连接(反斜杠字, 引号串));
        } 否则 {
            如果 (c == 字符(92)) {
                出 = 字符串连接(出, 双反斜杠);
            } 否则 {
                // 控制字符判定（#361 清偿：1~31=ASCII 正值经符号扩展仍为正·
                //   ≥0x80 字节为负值恒不命中=多字节直通·控制查表设施已拆除）
                整64 控位 = 整64(c);
                如果 (控位 == 8) {
                    出 = 字符串连接(出, 字符串连接(反斜杠字, "b"));
                } 否则 {
                    如果 (控位 == 12) {
                        出 = 字符串连接(出, 字符串连接(反斜杠字, "f"));
                    } 否则 {
                        如果 (控位 == 10) {
                            出 = 字符串连接(出, 字符串连接(反斜杠字, "n"));
                        } 否则 {
                            如果 (控位 == 13) {
                                出 = 字符串连接(出, 字符串连接(反斜杠字, "r"));
                            } 否则 {
                                如果 (控位 == 9) {
                                    出 = 字符串连接(出, 字符串连接(反斜杠字, "t"));
                                } 否则 {
                                    如果 (控位 >= 1 && 控位 <= 31) {
                                        // 其它控制字符→\u00XX（控位即字节值）
                                        字符串 十六 = "0123456789abcdef";
                                        出 = 字符串连接(出, 字符串连接(反斜杠字, "u00"));
                                        出 = 字符串连接(出, 字符转字符串(十六[控位 / 16]));
                                        出 = 字符串连接(出, 字符转字符串(十六[控位 % 16]));
                                    } 否则 {
                                        出 = 字符串连接(出, 字符转字符串(c));   // 含 UTF-8 多字节直通
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    返回 字符串连接(出, 引号串);
}



// 缩进空格串（层×缩进宽）
不安全 函数 生成缩进(整64 层, 整64 宽) -> 字符串 {
    字符串 出 = "";
    整64 总 = 层 * 宽;
    循环 (整64 k = 0; k < 总; k++) {
        出 = 字符串连接(出, " ");
    }
    返回 出;
}

// 递归序列化（层=嵌套层·缩进>0 时换行美化）
不安全 函数 生成值(JSON树* 树, 整64 节, 整64 缩进, 整64 层) -> 字符串 {
    整64 类型 = 树.类型(节);
    如果 (类型 == JSONT_空) {
        返回 "null";
    }
    // JSON 词 null/true/false（ASCII）
    如果 (类型 == JSONT_假) {
        返回 "false";
    }
    如果 (类型 == JSONT_真) {
        返回 "true";
    }
    如果 (类型 == JSONT_整数) {
        返回 整数转字符串(树.整值(节));
    }
    如果 (类型 == JSONT_浮点) {
        返回 浮点转字符串(树.浮值(节));
    }
    如果 (类型 == JSONT_字符串) {
        返回 生成字符串字面(树.文本(节));
    }
    // 数组/对象：空壳与带子两态
    布尔 是对象 = 类型 == JSONT_对象;
    字符串 开括 = "[";
    字符串 闭括 = "]";
    如果 (是对象) {
        开括 = "{";
        闭括 = "}";
    }
    整64 子总数 = 树.子数(节);
    如果 (子总数 == 0) {
        返回 字符串连接(开括, 闭括);
    }
    布尔 美化 = 缩进 > 0;
    字符串 出 = 开括;
    循环 (整64 序 = 0; 序 < 子总数; 序++) {
        整64 子节 = 树.子(节, 序);
        如果 (美化) {
            出 = 字符串连接(出, "\n");
            出 = 字符串连接(出, 生成缩进(层 + 1, 缩进));
        }
        如果 (是对象) {
            出 = 字符串连接(出, 生成字符串字面(树.取键(子节)));
            如果 (美化) {
                出 = 字符串连接(出, ": ");
            } 否则 {
                出 = 字符串连接(出, ":");
            }
        }
        出 = 字符串连接(出, 生成值(树, 子节, 缩进, 层 + 1));
        如果 (序 < 子总数 - 1) {
            出 = 字符串连接(出, ",");
        }
    }
    如果 (美化) {
        出 = 字符串连接(出, "\n");
        出 = 字符串连接(出, 生成缩进(层, 缩进));
    }
    返回 字符串连接(出, 闭括);
}

// ---- 顶层生成入口（树/根·缩进 0=紧凑 >0=每层空格数；根=-1 返回 "空"？——返 "" 且由调用方查 错误码）----
不安全 函数 生成JSON(JSON树* 树, 整64 节, 整64 缩进) -> 字符串 {
    如果 (节 < 0) {
        返回 "";
    }
    返回 生成值(树, 节, 缩进, 0);
}

// ---- 便捷重置（等价 树.重置()·自由函数形态供导入侧统一入口）----
不安全 函数 重置JSON树(JSON树* 树) -> 空类型 {
    树.重置();
}
