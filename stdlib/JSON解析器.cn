// CN 语言标准库：JSON 解析器（#751 拆分自 JSON.cn·递归下降）
//   模块 JSON解析器·公开 类 JSON解析器 + 解析文本（JSON.cn 的 解析JSON 委托入口）。
//   RFC 8259：递归下降；字符串=字符串构建器句柄直追加（#366）；数字=原文子串
//   逐位自实现；递归深度上限 64；错误码常量经 JSON核心 导入。
//   尾接：类私有 接子到（JSON解析器 方法·#751·O(1)·结果类型硬检查+前置校验）。
导入 JSON核心::{JSON树, JSONE_好, JSONE_语法, JSONE_深超, JSONE_尾余, JSONT_空, JSONT_真, JSONT_假, JSONT_整数, JSONT_浮点, JSONT_字符串, JSONT_数组, JSONT_对象};

公开:
// ==================== 解析器（递归下降） ====================
类 JSON解析器 {
私有:
// 尾接子节点（O(1)·#751；唯一调用方=本文件 解析数组/解析对象）
//   #751 审查 P2-1/P2-2 硬化（#1239 哨兵禁令）：返回 结果<整64, 整32>——
//   成功=.值 新链尾；失败=.错误（不检查 .正常 就取 .值=编译期拒绝，结果类型
//   自带执法）。前置校验拒绝误用形态（不静默覆盖/成环/断链）：
//     · 子节<0 / 子节==尾（自环）/ 子节==父（父子自环=自引用节点）；
//     · 尾=-1 但父已有子（覆盖子头→旧链孤儿）；
//     · 尾!=-1 但尾非链尾（断链）。
//   契约：尾必须属于父的子链（正常解析=刚建容器+同链上一子/或-1）；跨链判定
//   需 O(子数) 遍历，不进热路径——跨链形态不在校验面（显式契约），前述前置
//   校验只覆盖自环/覆盖/断链；正常解析流程尾来源唯一=本链上一子（不可达）。
//   错误码收敛：前置校验=错误码.参数；设置失败透传（越界/内存）；调用方统一
//   记错 JSONE_语法 并中止解析（对外错误码面与拆分前一致）。
//   安全性：尾=池索引（整64）非指针——向量扩容搬移元素不使索引失效；
//   无裸指针/无借用视图/无悬垂面（001 §1.1a④ 不触·零不安全新增通道）。
不安全 函数 接子到(JSON树* 池树, 整64 父, 整64 尾, 整64 子节) -> 结果<整64, 整32> {
    如果 (子节 < 0 || 子节 == 尾 || 子节 == 父) {
        返回 错误(错误码.参数);
    }
    如果 (尾 == -1) {
        如果 (池树.子头们.元素(父) != -1) {
            返回 错误(错误码.参数);
        }
        结果<空类型, 整32> 设果 = 池树.子头们.设置(父, 子节);
        如果 (!设果.正常) {
            返回 错误(设果.错误);
        }
        返回 正常(子节);
    }
    如果 (池树.兄弟们.元素(尾) != -1) {
        返回 错误(错误码.参数);
    }
    结果<空类型, 整32> 设果 = 池树.兄弟们.设置(尾, 子节);
    如果 (!设果.正常) {
        返回 错误(设果.错误);
    }
    返回 正常(子节);
}

    // 连续数字段扫描（#751 P2-3：整部/小数/指数三段同构归纳为单一扫描器；
    //   返回位数·位前进到首个非数字）
    不安全 函数 扫描数字段() -> 整64 {
        整64 数 = 0;
        当 (位 < 源长) {
            整64 b = 自身.字节值(源[位]);
            如果 (b >= 48 && b <= 57) {
                位 = 位 + 1;
                数 = 数 + 1;
            } 否则 {
                中断;
            }
        }
        返回 数;
    }

    // 数值转换（#751 P2-3 自 解析数 纯搬移·逐句语义不变）：原文子串→节点值
    //   #1523 B 类：返回 结果<整64, 整32>——成功=正常(节点索引)，失败=错误(错误码)；
    //   新节点/向量设置失败的错误状态机（树.错误码）照旧写入。
    不安全 函数 转换数节点(整64 起, 布尔 是浮) -> 结果<整64, 整32> {
        // 数值转换=自实现（v2 无 解析::转整数/转浮点 内建注册·669 轮 dual 实证）：
        //   整数=逐位累加（精确·溢出静默回绕注记）；浮点=整数部分+小数逐位/10+指数循环
        //   乘除（最近值近似·strtod 级正确舍入待运行时暴露——#361 随件注记）
        结果<整64, 整32> 节果 = 树.新节点(JSONT_整数);
        如果 (!节果.正常) {
            返回 错误(节果.错误);      // 新节点失败已置错误状态（错误值透传）
        }
        整64 节 = 节果.值;
        整64 扫 = 起;
        布尔 负 = 假;
        如果 (源[扫] == 字符(45)) {
            负 = 真;
            扫 = 扫 + 1;
        }
        如果 (!是浮) {
            整64 值 = 0;
            当 (扫 < 位) {
                整64 位值 = 自身.字节值(源[扫]);
                值 = 值 * 10 + (位值 - 48);
                扫 = 扫 + 1;
            }
            如果 (负) {
                值 = -值;
            }
            结果<空类型, 整32> 设果 = 树.数值们.设置(节, 值);
            如果 (!设果.正常) {
                返回 自身.记错(JSONE_语法);
            }
        } 否则 {
            浮64 值 = 0.0;
            当 (扫 < 位) {
                整64 位值 = 自身.字节值(源[扫]);
                如果 (位值 == 46) {          // .——小数部分逐位
                    扫 = 扫 + 1;
                    浮64 权 = 0.1;
                    当 (扫 < 位) {
                        整64 小值 = 自身.字节值(源[扫]);
                        如果 (小值 >= 48 && 小值 <= 57) {
                            值 = 值 + (浮64(小值 - 48)) * 权;
                            权 = 权 / 10.0;
                            扫 = 扫 + 1;
                        } 否则 {
                            中断;
                        }
                    }
                    继续;
                }
                如果 (位值 == 101 || 位值 == 69) {   // e/E——指数
                    扫 = 扫 + 1;
                    布尔 指负 = 假;
                    如果 (扫 < 位 && (自身.字节值(源[扫]) == 43 || 自身.字节值(源[扫]) == 45)) {
                        指负 = 自身.字节值(源[扫]) == 45;
                        扫 = 扫 + 1;
                    }
                    整64 指数 = 0;
                    当 (扫 < 位) {
                        整64 指值 = 自身.字节值(源[扫]);
                        指数 = 指数 * 10 + (指值 - 48);
                        扫 = 扫 + 1;
                    }
                    循环 (整64 k = 0; k < 指数; k++) {
                        如果 (指负) {
                            值 = 值 / 10.0;
                        } 否则 {
                            值 = 值 * 10.0;
                        }
                    }
                    中断;
                }
                值 = 值 * 10.0 + (浮64(位值 - 48));
                扫 = 扫 + 1;
            }
            如果 (负) {
                值 = -值;
            }
            结果<空类型, 整32> 设果 = 树.浮值们.设置(节, 值);
            如果 (!设果.正常) {
                返回 自身.记错(JSONE_语法);
            }
            结果<空类型, 整32> 型果 = 树.类型们.设置(节, JSONT_浮点);
            如果 (!型果.正常) {
                返回 自身.记错(JSONE_语法);
            }
        }
        返回 正常(节);
    }

公开:
    字符串 源;          // 全文（UTF-8 字节串）
    整64 位;            // 当前字节偏移
    整64 深;            // 递归深度（上限 64）
    整64 源长;          // 预存长度
    JSON树* 树;         // 目标池

    函数 JSON解析器() {
        源 = "";
        位 = 0;
        深 = 0;
        源长 = 0;
        树 = 无;
    }
    不安全 函数 ~JSON解析器() {
    }

    // 记错并返失败结果（调用方 `返回 自身.记错(JSONE_语法)` 模式）
    //   #1523 B 类：返回 结果<整64, 整32>——错误码同时写 树.错误码/错误位置/错误字节
    //   状态机（对外 JSON 公开 API 的错误通道不变），错误值供内部消费点透传；
    //   -1 哨兵从解析链返回值中剔除（0 是合法节点索引）。
    //   返回 void 的失败路径用 标错（结果值不可丢弃——宿主/ v2 强制检查）。
    不安全 函数 记错(整64 码) -> 结果<整64, 整32> {
        自身.标错(码);
        返回 错误(整32(码));
    }

    // 仅记录错误状态（空类型返回路径用·如 解析转义 就地失败）
    不安全 函数 标错(整64 码) -> 空类型 {
        树.错误码 = 码;
        树.错误位置 = 位;
        如果 (位 < 源长) {
            树.错误字节 = 自身.字节值(源[位]);
        } 否则 {
            树.错误字节 = -1;
        }
    }

    // 当前字节（源尾=无·#1360 A 类结果化：原 -1 哨兵与合法字节 0 冲突——
    //   0 是合法 NUL 字节，不并入无值）
    // 字节值（0~255 无符号·#361 清偿=正8 位模式重解释直读·查表设施已拆除）
    常量 函数 字节值(整8 b) -> 整64 {
        返回 整64(正8(b));
    }

    常量 函数 当前() -> 可选<整64> {
        如果 (位 < 源长) {
            返回 某些(自身.字节值(源[位]));
        }
        返回 无;
    }

    // 当前字节是否等于 b（源尾=假——布尔判定无「无值并入合法值」歧义；
    //   #1523 配套：避免「取可选→判有值→比值」样板散落全部期望字节判定点）
    常量 函数 是字节(整64 b) -> 布尔 {
        可选<整64> 字 = 自身.当前();
        如果 (字.有值) {
            返回 字.值 == b;
        }
        返回 假;
    }

    // 跳过空白（空格/制表/换行/回车）
    不安全 函数 跳空白() -> 空类型 {
        当 (位 < 源长) {
            整64 b = 自身.字节值(源[位]);
            如果 (b == 32 || b == 9 || b == 10 || b == 13) {
                位 = 位 + 1;
            } 否则 {
                中断;
            }
        }
    }

    // 期望字面字节（不符=记语法错·符合吞掉）
    //   #1523 B 类：返回 结果<空类型, 整32>（原 0/-1 中 0 只是成功标记，失败 -1
    //   与错误状态机双轨）；错误值=已写入 树.错误码 的 JSONE_语法。
    不安全 函数 吃(整64 b) -> 结果<空类型, 整32> {
        如果 (!自身.是字节(b)) {
            自身.标错(JSONE_语法);
            返回 错误(整32(JSONE_语法));
        }
        位 = 位 + 1;
        返回 正常();
    }

    // ---- 值分派（递归入口）----
    //   #1523 B 类：返回 结果<整64, 整32>——成功=正常(节点索引·0 合法)，
    //   失败=错误(错误码)，错误状态机（树.错误码/位置/字节）照旧同步写入。
    不安全 函数 解析值() -> 结果<整64, 整32> {
        如果 (深 >= 64) {
            返回 自身.记错(JSONE_深超);
        }
        自身.跳空白();
        可选<整64> 首 = 自身.当前();
        如果 (!首.有值) {
            返回 自身.记错(JSONE_语法);      // 源尾=空文/截断
        }
        如果 (首.值 == 123) {            // {
            结果<整64, 整32> 果对 = 自身.解析对象();
            返回 果对;
        }
        如果 (首.值 == 91) {             // [
            结果<整64, 整32> 果数 = 自身.解析数组();
            返回 果数;
        }
        如果 (首.值 == 34) {             // "
            结果<整64, 整32> 果串 = 自身.解析字符串();
            返回 果串;
        }
        如果 (首.值 == 116) {            // t
            结果<整64, 整32> 果真 = 自身.解析字面("true", JSONT_真);
            返回 果真;
        }
        如果 (首.值 == 102) {            // f
            结果<整64, 整32> 果假 = 自身.解析字面("false", JSONT_假);
            返回 果假;
        }
        如果 (首.值 == 110) {            // n
            结果<整64, 整32> 果空 = 自身.解析字面("null", JSONT_空);
            返回 果空;
        }
        如果 (首.值 == 45 || (首.值 >= 48 && 首.值 <= 57)) {   // - 或数字
            结果<整64, 整32> 果数 = 自身.解析数();
            返回 果数;
        }
        返回 自身.记错(JSONE_语法);
    }

    // 字面量（true/false/null·ASCII 逐字节比对）
    不安全 函数 解析字面(字符串 词, 整64 类型) -> 结果<整64, 整32> {
        整64 长 = 字符串长度(词);
        整64 k = 0;
        当 (k < 长) {
            如果 (!自身.是字节(自身.字节值(词[k]))) {
                返回 自身.记错(JSONE_语法);
            }
            位 = 位 + 1;
            k = k + 1;
        }
        结果<整64, 整32> 节果 = 树.新节点(类型);
        如果 (!节果.正常) {
            返回 错误(节果.错误);      // 新节点失败已置错误状态（错误值透传）
        }
        整64 节 = 节果.值;
        返回 正常(节);
    }

    // ---- 字符串（引号内扫描+转义解码→UTF-8 字节串）----
    //   #366（2026-10-13）：累积改 字符串构建器（原 逐字符 字符串连接=每字符
    //   整串重拷 O(n²)——348 轮 22KB/26ms=0.85MB/s 主成本实证）；转义/UTF-8
    //   解码两辅助同步改句柄直追加（免「现有→新串」逐段重拷）；出串=完成
    //   直移交（省原 字符串复制 副本一次）；错误路径 弃置 句柄防泄漏。
    不安全 函数 解析字符串() -> 结果<整64, 整32> {
        结果<空类型, 整32> 吃果 = 自身.吃(34);
        如果 (!吃果.正常) {
            返回 错误(吃果.错误);
        }
        结果<整64, 整32> 节果 = 树.新节点(JSONT_字符串);
        如果 (!节果.正常) {
            返回 错误(节果.错误);      // 新节点失败已置错误状态（错误值透传）
        }
        整64 节 = 节果.值;
        整64 句 = 字符串构建器::新建();
        当 (真) {
            可选<整64> 字 = 自身.当前();
            如果 (!字.有值) {
                字符串构建器::弃置(句);
                返回 自身.记错(JSONE_语法);       // 未闭合
            }
            如果 (字.值 == 34) {
                位 = 位 + 1;
                // 完成出串=新分配串直接移交容器（原 字符串复制(出) 副本省一次；
                //   设置 失败路径出串悬置=原副本同构既有面）
                结果<空类型, 整32> 设果 = 树.文本们.设置(节, 字符串构建器::完成(句));
                如果 (!设果.正常) {
                    返回 自身.记错(JSONE_语法);
                }
                返回 正常(节);
            }
            如果 (字.值 == 92) {                 // 反斜杠=转义段
                位 = 位 + 1;
                结果<空类型, 整32> 义果 = 自身.解析转义(句);
                如果 (!义果.正常) {
                    字符串构建器::弃置(句);
                    返回 错误(义果.错误);
                }
                继续;
            }
            如果 (字.值 < 32) {
                字符串构建器::弃置(句);
                返回 自身.记错(JSONE_语法);       // 未转义控制字符
            }
            字符串构建器::追加字节(句, 字.值);    // 取低 8 位=原字节（UTF-8 ≥0x80 直通·#361 立法面）
            位 = 位 + 1;
        }
        字符串构建器::弃置(句);
        返回 自身.记错(JSONE_语法);
    }

    // 转义段解码（已过反斜杠·句柄直追加；句柄由调用方弃置）
    //   #1523 B 类：返回 结果<空类型, 整32>——原「空类型 + 树.错误码 双轨」改为
    //   结果通道直传错误码（状态机仍同步写入，对外错误通道不变）；成功=正常()。
    不安全 函数 解析转义(整64 句) -> 结果<空类型, 整32> {
        可选<整64> 字 = 自身.当前();
        如果 (!字.有值) {
            自身.标错(JSONE_语法);          // 源尾=转义缺体
            返回 错误(整32(JSONE_语法));
        }
        整64 b = 字.值;
        如果 (b == 34) { 位 = 位 + 1; 字符串构建器::追加(句, "\""); 返回 正常(); }
        如果 (b == 92) { 位 = 位 + 1; 字符串构建器::追加(句, "\\"); 返回 正常(); }
        如果 (b == 47) { 位 = 位 + 1; 字符串构建器::追加(句, "/"); 返回 正常(); }
        如果 (b == 98) { 位 = 位 + 1; 字符串构建器::追加字节(句, 8); 返回 正常(); }    // \b
        如果 (b == 102) { 位 = 位 + 1; 字符串构建器::追加字节(句, 12); 返回 正常(); } // \f
        如果 (b == 110) { 位 = 位 + 1; 字符串构建器::追加字节(句, 10); 返回 正常(); } // \n
        如果 (b == 114) { 位 = 位 + 1; 字符串构建器::追加字节(句, 13); 返回 正常(); } // \r
        如果 (b == 116) { 位 = 位 + 1; 字符串构建器::追加字节(句, 9); 返回 正常(); }  // \t
        如果 (b == 117) {                // \uXXXX
            位 = 位 + 1;
            结果<整64, 整32> 码果 = 自身.读十六进制4();
            如果 (!码果.正常) {
                返回 错误(码果.错误);
            }
            整64 码 = 码果.值;
            如果 (码 >= 55296 && 码 <= 56319) {          // 高代理→须配对
                如果 (!自身.是字节(92)) {
                    自身.标错(JSONE_语法);
                    返回 错误(整32(JSONE_语法));
                }
                位 = 位 + 1;
                如果 (!自身.是字节(117)) {
                    自身.标错(JSONE_语法);
                    返回 错误(整32(JSONE_语法));
                }
                位 = 位 + 1;
                结果<整64, 整32> 低果 = 自身.读十六进制4();
                如果 (!低果.正常) {
                    返回 错误(低果.错误);
                }
                整64 低 = 低果.值;
                如果 (低 < 56320 || 低 > 57343) {
                    自身.标错(JSONE_语法);
                    返回 错误(整32(JSONE_语法));
                }
                码 = 65536 + ((码 - 55296) << 10) + (低 - 56320);
            } 否则 {
                如果 (码 >= 56320 && 码 <= 57343) {      // 孤立低代理
                    自身.标错(JSONE_语法);
                    返回 错误(整32(JSONE_语法));
                }
            }
            自身.追加UTF8(句, 码);
            返回 正常();
        }
        自身.标错(JSONE_语法);
        返回 错误(整32(JSONE_语法));
    }

    // 读 4 位十六进制（成功=正常(0..65535·0 合法)）
    //   #1523 B 类：局部 数位=-1 哨兵改为「布尔 有效 + 三分支显式枚举」——0 是合法
    //   数位（'0'），与 miss 分离；返回值改 结果<整64, 整32>（失败=错误(JSONE_语法)），
    //   错误状态机同步写入。
    不安全 函数 读十六进制4() -> 结果<整64, 整32> {
        整64 值 = 0;
        整64 k = 0;
        当 (k < 4) {
            可选<整64> 字 = 自身.当前();
            如果 (!字.有值) {
                自身.标错(JSONE_语法);      // 源尾=不足 4 位
                返回 错误(整32(JSONE_语法));
            }
            整64 b = 字.值;
            整64 数位 = 0;
            布尔 有效 = 假;
            如果 (b >= 48 && b <= 57) {
                数位 = b - 48;
                有效 = 真;
            } 否则 如果 (b >= 97 && b <= 102) {
                数位 = b - 87;
                有效 = 真;
            } 否则 如果 (b >= 65 && b <= 70) {
                数位 = b - 55;
                有效 = 真;
            }
            如果 (!有效) {
                自身.标错(JSONE_语法);
                返回 错误(整32(JSONE_语法));
            }
            值 = (值 << 4) + 数位;
            位 = 位 + 1;
            k = k + 1;
        }
        返回 正常(值);
    }

    // 码点→UTF-8（1~4 字节）追加（#366：句柄直追加·免「现有→新串」重拷）
    不安全 函数 追加UTF8(整64 句, 整64 码) -> 空类型 {
        如果 (码 < 128) {
            字符串构建器::追加字节(句, 码);
            返回;
        }
        如果 (码 < 2048) {
            字符串构建器::追加字节(句, 192 | (码 >> 6));
            字符串构建器::追加字节(句, 128 | (码 & 63));
            返回;
        }
        如果 (码 < 65536) {
            字符串构建器::追加字节(句, 224 | (码 >> 12));
            字符串构建器::追加字节(句, 128 | ((码 >> 6) & 63));
            字符串构建器::追加字节(句, 128 | (码 & 63));
            返回;
        }
        字符串构建器::追加字节(句, 240 | (码 >> 18));
        字符串构建器::追加字节(句, 128 | ((码 >> 12) & 63));
        字符串构建器::追加字节(句, 128 | ((码 >> 6) & 63));
        字符串构建器::追加字节(句, 128 | (码 & 63));
    }

    // ---- 数字（-? 整部 [.小部] [eE[+-]指数]·整型通道无小无指）----
    不安全 函数 解析数() -> 结果<整64, 整32> {
        整64 起 = 位;
        如果 (自身.是字节(45)) {        // -
            位 = 位 + 1;
        }
        // 整部：至少一位（RFC 禁前导零——宽松接受·与主流实现一致）
        如果 (自身.扫描数字段() == 0) {
            返回 自身.记错(JSONE_语法);
        }
        布尔 是浮 = 假;
        如果 (位 < 源长 && 自身.是字节(46)) {       // .
            是浮 = 真;
            位 = 位 + 1;
            如果 (自身.扫描数字段() == 0) {
                返回 自身.记错(JSONE_语法);
            }
        }
        如果 (位 < 源长 && (自身.是字节(101) || 自身.是字节(69))) {   // e/E
            是浮 = 真;
            位 = 位 + 1;
            如果 (自身.是字节(43) || 自身.是字节(45)) {          // +/-
                位 = 位 + 1;
            }
            如果 (自身.扫描数字段() == 0) {
                返回 自身.记错(JSONE_语法);
            }
        }
        // 数值转换段拆出（#751 P2-3·解析数 原 142 行→本函数 <40 行）
        结果<整64, 整32> 转果 = 自身.转换数节点(起, 是浮);
        返回 转果;
    }

    不安全 函数 解析数组() -> 结果<整64, 整32> {
        结果<空类型, 整32> 吃果 = 自身.吃(91);
        如果 (!吃果.正常) {
            返回 错误(吃果.错误);
        }
        结果<整64, 整32> 节果 = 树.新节点(JSONT_数组);
        如果 (!节果.正常) {
            返回 错误(节果.错误);      // 新节点失败已置错误状态（错误值透传）
        }
        整64 节 = 节果.值;
        深 = 深 + 1;
        自身.跳空白();
        如果 (自身.是字节(93)) {        // ]
            位 = 位 + 1;
            深 = 深 - 1;
            返回 正常(节);
        }
        // #751：局部尾索引（O(1) 尾接·原 接子 每子从链头走链尾=O(子数²)）
        整64 尾 = -1;
        当 (真) {
            结果<整64, 整32> 子果 = 自身.解析值();
            如果 (!子果.正常) {
                返回 错误(子果.错误);
            }
            整64 子节 = 子果.值;
            结果<整64, 整32> 接果 = 自身.接子到(树, 节, 尾, 子节);
            如果 (!接果.正常) {
                返回 自身.记错(JSONE_语法);
            }
            尾 = 接果.值;
            自身.跳空白();
            可选<整64> 字 = 自身.当前();
            如果 (字.有值) {
                如果 (字.值 == 44) {         // ,
                    位 = 位 + 1;
                    继续;
                }
                如果 (字.值 == 93) {         // ]
                    位 = 位 + 1;
                    深 = 深 - 1;
                    返回 正常(节);
                }
            }
            返回 自身.记错(JSONE_语法);
        }
        返回 自身.记错(JSONE_语法);
    }

    // ---- 对象 {"键": 值, ...}（键挂值节点文本槽）----
    不安全 函数 解析对象() -> 结果<整64, 整32> {
        结果<空类型, 整32> 吃果 = 自身.吃(123);
        如果 (!吃果.正常) {
            返回 错误(吃果.错误);
        }
        结果<整64, 整32> 节果 = 树.新节点(JSONT_对象);
        如果 (!节果.正常) {
            返回 错误(节果.错误);      // 新节点失败已置错误状态（错误值透传）
        }
        整64 节 = 节果.值;
        深 = 深 + 1;
        自身.跳空白();
        如果 (自身.是字节(125)) {       // }
            位 = 位 + 1;
            深 = 深 - 1;
            返回 正常(节);
        }
        // #751：局部尾索引（O(1) 尾接·原 接子 每子从链头走链尾=O(子数²)）
        整64 尾 = -1;
        当 (真) {
            自身.跳空白();
            如果 (!自身.是字节(34)) {    // 键须字符串
                返回 自身.记错(JSONE_语法);
            }
            结果<整64, 整32> 键果 = 自身.解析字符串();
            如果 (!键果.正常) {
                返回 错误(键果.错误);
            }
            整64 键节 = 键果.值;
            字符串 键 = 树.文本(键节);
            自身.跳空白();
            结果<空类型, 整32> 冒果 = 自身.吃(58);      // :
            如果 (!冒果.正常) {
                返回 错误(冒果.错误);
            }
            结果<整64, 整32> 值果 = 自身.解析值();
            如果 (!值果.正常) {
                返回 错误(值果.错误);
            }
            整64 值节 = 值果.值;
            // 键写值节点键槽（键/值分离·成员字符串=字符串复制 落堆）
            结果<空类型, 整32> 设果 = 树.键们.设置(值节, 字符串复制(键));
            如果 (!设果.正常) {
                返回 自身.记错(JSONE_语法);
            }
            结果<整64, 整32> 接果 = 自身.接子到(树, 节, 尾, 值节);
            如果 (!接果.正常) {
                返回 自身.记错(JSONE_语法);
            }
            尾 = 接果.值;
            自身.跳空白();
            可选<整64> 字 = 自身.当前();
            如果 (字.有值) {
                如果 (字.值 == 44) {         // ,
                    位 = 位 + 1;
                    继续;
                }
                如果 (字.值 == 125) {        // }
                    位 = 位 + 1;
                    深 = 深 - 1;
                    返回 正常(节);
                }
            }
            返回 自身.记错(JSONE_语法);
        }
        返回 自身.记错(JSONE_语法);
    }
}
// ---- 解析文本（内部实现·非稳定 API：仅 JSON.cn 的 解析JSON 委托调用；
//      外部请用 JSON::解析JSON）——重置树→建解析器→解析→尾余检查 ----
不安全 函数 解析文本(JSON树* 树, 字符串 源文本) -> 空类型 {
    树.重置();
    JSON解析器 器 = JSON解析器();
    器.源 = 源文本;
    器.源长 = 字符串长度(源文本);
    器.树 = 树;
    结果<整64, 整32> 节果 = 器.解析值();
    如果 (!节果.正常) {
        树.根 = -1;
        返回;
    }
    器.跳空白();
    如果 (器.位 != 器.源长) {
        树.错误码 = JSONE_尾余;
        树.错误位置 = 器.位;
        树.错误字节 = 器.字节值(器.源[器.位]);
        树.根 = -1;
        返回;
    }
    树.根 = 节果.值;
}
