// CN 语言标准库：JSON 解析器（#751 拆分自 JSON.cn·递归下降）
//   模块 JSON解析器·公开 类 JSON解析器 + 解析文本（JSON.cn 的 解析JSON 委托入口）。
//   RFC 8259：递归下降；字符串=字符串构建器句柄直追加（#366）；数字=原文子串
//   逐位自实现；递归深度上限 64；错误码常量经 JSON核心 导入。
//   尾接：本文件私有 接子到（#751·O(1)·结果类型硬检查+前置校验，见函数头注）。
导入 JSON核心::{JSON树, JSONE_好, JSONE_语法, JSONE_深超, JSONE_尾余, JSONT_空, JSONT_真, JSONT_假, JSONT_整数, JSONT_浮点, JSONT_字符串, JSONT_数组, JSONT_对象};

公开:
// ==================== 解析器（递归下降） ====================
类 JSON解析器 {
公开:
    字符串 源;          // 全文（UTF-8 字节串）
    整64 位;            // 当前字节偏移
    整64 深;            // 递归深度（上限 64）
    整64 源长;          // 预存长度
    JSON树* 树;         // 目标池

    函数 JSON解析器() {
        源 = "";
        位 = 0;
        深 = 0;
        源长 = 0;
        树 = 无;
    }
    不安全 函数 ~JSON解析器() {
    }

    // 记错并返 -1（调用方 `返回 自身.记错(JSONE_语法)` 模式）
    不安全 函数 记错(整64 码) -> 整64 {
        树.错误码 = 码;
        树.错误位置 = 位;
        如果 (位 < 源长) {
            树.错误字节 = 自身.字节值(源[位]);
        } 否则 {
            树.错误字节 = -1;
        }
        返回 -1;
    }

    // 当前字节（源尾=-1）
    // 字节值（0~255 无符号·#361 清偿=正8 位模式重解释直读·查表设施已拆除）
    常量 函数 字节值(整8 b) -> 整64 {
        返回 整64(正8(b));
    }

    常量 函数 当前() -> 整64 {
        如果 (位 < 源长) {
            返回 自身.字节值(源[位]);
        }
        返回 -1;
    }

    // 跳过空白（空格/制表/换行/回车）
    不安全 函数 跳空白() -> 空类型 {
        当 (位 < 源长) {
            整64 b = 自身.字节值(源[位]);
            如果 (b == 32 || b == 9 || b == 10 || b == 13) {
                位 = 位 + 1;
            } 否则 {
                中断;
            }
        }
    }

    // 期望字面字节（不符=记语法错返 -1·符合吞掉返 0）
    不安全 函数 吃(整64 b) -> 整64 {
        如果 (自身.当前() != b) {
            返回 自身.记错(JSONE_语法);
        }
        位 = 位 + 1;
        返回 0;
    }

    // ---- 值分派（递归入口）----
    不安全 函数 解析值() -> 整64 {
        如果 (深 >= 64) {
            返回 自身.记错(JSONE_深超);
        }
        自身.跳空白();
        整64 b = 自身.当前();
        如果 (b == 123) {            // {
            返回 自身.解析对象();
        }
        如果 (b == 91) {             // [
            返回 自身.解析数组();
        }
        如果 (b == 34) {             // "
            返回 自身.解析字符串();
        }
        如果 (b == 116) {            // t
            返回 自身.解析字面("true", JSONT_真);
        }
        如果 (b == 102) {            // f
            返回 自身.解析字面("false", JSONT_假);
        }
        如果 (b == 110) {            // n
            返回 自身.解析字面("null", JSONT_空);
        }
        如果 (b == 45 || (b >= 48 && b <= 57)) {   // - 或数字
            返回 自身.解析数();
        }
        返回 自身.记错(JSONE_语法);
    }

    // 字面量（true/false/null·ASCII 逐字节比对）
    不安全 函数 解析字面(字符串 词, 整64 类型) -> 整64 {
        整64 长 = 字符串长度(词);
        整64 k = 0;
        当 (k < 长) {
            如果 (自身.当前() != 自身.字节值(词[k])) {
                返回 自身.记错(JSONE_语法);
            }
            位 = 位 + 1;
            k = k + 1;
        }
        整64 节 = 树.新节点(类型);
        如果 (节 == -1) {
            返回 -1;
        }
        返回 节;
    }

    // ---- 字符串（引号内扫描+转义解码→UTF-8 字节串）----
    //   #366（2026-10-13）：累积改 字符串构建器（原 逐字符 字符串连接=每字符
    //   整串重拷 O(n²)——348 轮 22KB/26ms=0.85MB/s 主成本实证）；转义/UTF-8
    //   解码两辅助同步改句柄直追加（免「现有→新串」逐段重拷）；出串=完成
    //   直移交（省原 字符串复制 副本一次）；错误路径 弃置 句柄防泄漏。
    不安全 函数 解析字符串() -> 整64 {
        整64 坏 = 自身.吃(34);
        如果 (坏 != 0) {
            返回 -1;
        }
        整64 节 = 树.新节点(JSONT_字符串);
        如果 (节 == -1) {
            返回 -1;
        }
        整64 句 = 字符串构建器::新建();
        当 (真) {
            整64 b = 自身.当前();
            如果 (b == -1) {
                字符串构建器::弃置(句);
                返回 自身.记错(JSONE_语法);       // 未闭合
            }
            如果 (b == 34) {
                位 = 位 + 1;
                // 完成出串=新分配串直接移交容器（原 字符串复制(出) 副本省一次；
                //   设置 失败路径出串悬置=原副本同构既有面）
                结果<空类型, 整32> 设果 = 树.文本们.设置(节, 字符串构建器::完成(句));
                如果 (!设果.正常) {
                    返回 自身.记错(JSONE_语法);
                }
                返回 节;
            }
            如果 (b == 92) {                 // 反斜杠=转义段
                位 = 位 + 1;
                自身.解析转义(句);
                如果 (树.错误码 != JSONE_好) {
                    字符串构建器::弃置(句);
                    返回 -1;
                }
                继续;
            }
            如果 (b < 32) {
                字符串构建器::弃置(句);
                返回 自身.记错(JSONE_语法);       // 未转义控制字符
            }
            字符串构建器::追加字节(句, b);    // 取低 8 位=原字节（UTF-8 ≥0x80 直通·#361 立法面）
            位 = 位 + 1;
        }
        字符串构建器::弃置(句);
        返回 自身.记错(JSONE_语法);
    }

    // 转义段解码（已过反斜杠·句柄直追加；错=已置 树.错误码·句柄由调用方弃置）
    不安全 函数 解析转义(整64 句) -> 空类型 {
        整64 b = 自身.当前();
        如果 (b == 34) { 位 = 位 + 1; 字符串构建器::追加(句, "\""); 返回; }
        如果 (b == 92) { 位 = 位 + 1; 字符串构建器::追加(句, "\\"); 返回; }
        如果 (b == 47) { 位 = 位 + 1; 字符串构建器::追加(句, "/"); 返回; }
        如果 (b == 98) { 位 = 位 + 1; 字符串构建器::追加字节(句, 8); 返回; }    // \b
        如果 (b == 102) { 位 = 位 + 1; 字符串构建器::追加字节(句, 12); 返回; } // \f
        如果 (b == 110) { 位 = 位 + 1; 字符串构建器::追加字节(句, 10); 返回; } // \n
        如果 (b == 114) { 位 = 位 + 1; 字符串构建器::追加字节(句, 13); 返回; } // \r
        如果 (b == 116) { 位 = 位 + 1; 字符串构建器::追加字节(句, 9); 返回; }  // \t
        如果 (b == 117) {                // \uXXXX
            位 = 位 + 1;
            整64 码 = 自身.读十六进制4();
            如果 (树.错误码 != JSONE_好) {
                返回;
            }
            如果 (码 >= 55296 && 码 <= 56319) {          // 高代理→须配对
                如果 (自身.当前() != 92) {
                    自身.记错(JSONE_语法);
                    返回;
                }
                位 = 位 + 1;
                如果 (自身.当前() != 117) {
                    自身.记错(JSONE_语法);
                    返回;
                }
                位 = 位 + 1;
                整64 低 = 自身.读十六进制4();
                如果 (树.错误码 != JSONE_好) {
                    返回;
                }
                如果 (低 < 56320 || 低 > 57343) {
                    自身.记错(JSONE_语法);
                    返回;
                }
                码 = 65536 + ((码 - 55296) << 10) + (低 - 56320);
            } 否则 {
                如果 (码 >= 56320 && 码 <= 57343) {      // 孤立低代理
                    自身.记错(JSONE_语法);
                    返回;
                }
            }
            自身.追加UTF8(句, 码);
            返回;
        }
        自身.记错(JSONE_语法);
    }

    // 读 4 位十六进制（错=已记错·返回值无意义）
    不安全 函数 读十六进制4() -> 整64 {
        整64 值 = 0;
        整64 k = 0;
        当 (k < 4) {
            整64 b = 自身.当前();
            整64 数位 = -1;
            如果 (b >= 48 && b <= 57) {
                数位 = b - 48;
            } 否则 {
                如果 (b >= 97 && b <= 102) {
                    数位 = b - 87;
                } 否则 {
                    如果 (b >= 65 && b <= 70) {
                        数位 = b - 55;
                    }
                }
            }
            如果 (数位 < 0) {
                自身.记错(JSONE_语法);
                返回 -1;
            }
            值 = (值 << 4) + 数位;
            位 = 位 + 1;
            k = k + 1;
        }
        返回 值;
    }

    // 码点→UTF-8（1~4 字节）追加（#366：句柄直追加·免「现有→新串」重拷）
    不安全 函数 追加UTF8(整64 句, 整64 码) -> 空类型 {
        如果 (码 < 128) {
            字符串构建器::追加字节(句, 码);
            返回;
        }
        如果 (码 < 2048) {
            字符串构建器::追加字节(句, 192 | (码 >> 6));
            字符串构建器::追加字节(句, 128 | (码 & 63));
            返回;
        }
        如果 (码 < 65536) {
            字符串构建器::追加字节(句, 224 | (码 >> 12));
            字符串构建器::追加字节(句, 128 | ((码 >> 6) & 63));
            字符串构建器::追加字节(句, 128 | (码 & 63));
            返回;
        }
        字符串构建器::追加字节(句, 240 | (码 >> 18));
        字符串构建器::追加字节(句, 128 | ((码 >> 12) & 63));
        字符串构建器::追加字节(句, 128 | ((码 >> 6) & 63));
        字符串构建器::追加字节(句, 128 | (码 & 63));
    }

    // ---- 数字（-? 整部 [.小部] [eE[+-]指数]·整型通道无小无指）----
    不安全 函数 解析数() -> 整64 {
        整64 起 = 位;
        如果 (自身.当前() == 45) {        // -
            位 = 位 + 1;
        }
        // 整部：至少一位（RFC 禁前导零——宽松接受·与主流实现一致）
        整64 整位数 = 0;
        当 (位 < 源长) {
            整64 b = 自身.字节值(源[位]);
            如果 (b >= 48 && b <= 57) {
                位 = 位 + 1;
                整位数 = 整位数 + 1;
            } 否则 {
                中断;
            }
        }
        如果 (整位数 == 0) {
            返回 自身.记错(JSONE_语法);
        }
        布尔 是浮 = 假;
        如果 (位 < 源长 && 自身.当前() == 46) {       // .
            是浮 = 真;
            位 = 位 + 1;
            整64 小位数 = 0;
            当 (位 < 源长) {
                整64 b = 自身.字节值(源[位]);
                如果 (b >= 48 && b <= 57) {
                    位 = 位 + 1;
                    小位数 = 小位数 + 1;
                } 否则 {
                    中断;
                }
            }
            如果 (小位数 == 0) {
                返回 自身.记错(JSONE_语法);
            }
        }
        如果 (位 < 源长 && (自身.当前() == 101 || 自身.当前() == 69)) {   // e/E
            是浮 = 真;
            位 = 位 + 1;
            如果 (自身.当前() == 43 || 自身.当前() == 45) {          // +/-
                位 = 位 + 1;
            }
            整64 指位数 = 0;
            当 (位 < 源长) {
                整64 b = 自身.字节值(源[位]);
                如果 (b >= 48 && b <= 57) {
                    位 = 位 + 1;
                    指位数 = 指位数 + 1;
                } 否则 {
                    中断;
                }
            }
            如果 (指位数 == 0) {
                返回 自身.记错(JSONE_语法);
            }
        }
        // 数值转换=自实现（v2 无 解析::转整数/转浮点 内建注册·669 轮 dual 实证）：
        //   整数=逐位累加（精确·溢出静默回绕注记）；浮点=整数部分+小数逐位/10+指数循环
        //   乘除（最近值近似·strtod 级正确舍入待运行时暴露——#361 随件注记）
        整64 节 = 树.新节点(JSONT_整数);
        如果 (节 == -1) {
            返回 -1;
        }
        整64 扫 = 起;
        布尔 负 = 假;
        如果 (源[扫] == 字符(45)) {
            负 = 真;
            扫 = 扫 + 1;
        }
        如果 (!是浮) {
            整64 值 = 0;
            当 (扫 < 位) {
                整64 位值 = 自身.字节值(源[扫]);
                值 = 值 * 10 + (位值 - 48);
                扫 = 扫 + 1;
            }
            如果 (负) {
                值 = -值;
            }
            结果<空类型, 整32> 设果 = 树.数值们.设置(节, 值);
            如果 (!设果.正常) {
                返回 自身.记错(JSONE_语法);
            }
        } 否则 {
            浮64 值 = 0.0;
            当 (扫 < 位) {
                整64 位值 = 自身.字节值(源[扫]);
                如果 (位值 == 46) {          // .——小数部分逐位
                    扫 = 扫 + 1;
                    浮64 权 = 0.1;
                    当 (扫 < 位) {
                        整64 小值 = 自身.字节值(源[扫]);
                        如果 (小值 >= 48 && 小值 <= 57) {
                            值 = 值 + (浮64(小值 - 48)) * 权;
                            权 = 权 / 10.0;
                            扫 = 扫 + 1;
                        } 否则 {
                            中断;
                        }
                    }
                    继续;
                }
                如果 (位值 == 101 || 位值 == 69) {   // e/E——指数
                    扫 = 扫 + 1;
                    布尔 指负 = 假;
                    如果 (扫 < 位 && (自身.字节值(源[扫]) == 43 || 自身.字节值(源[扫]) == 45)) {
                        指负 = 自身.字节值(源[扫]) == 45;
                        扫 = 扫 + 1;
                    }
                    整64 指数 = 0;
                    当 (扫 < 位) {
                        整64 指值 = 自身.字节值(源[扫]);
                        指数 = 指数 * 10 + (指值 - 48);
                        扫 = 扫 + 1;
                    }
                    循环 (整64 k = 0; k < 指数; k++) {
                        如果 (指负) {
                            值 = 值 / 10.0;
                        } 否则 {
                            值 = 值 * 10.0;
                        }
                    }
                    中断;
                }
                值 = 值 * 10.0 + (浮64(位值 - 48));
                扫 = 扫 + 1;
            }
            如果 (负) {
                值 = -值;
            }
            结果<空类型, 整32> 设果 = 树.浮值们.设置(节, 值);
            如果 (!设果.正常) {
                返回 自身.记错(JSONE_语法);
            }
            结果<空类型, 整32> 型果 = 树.类型们.设置(节, JSONT_浮点);
            如果 (!型果.正常) {
                返回 自身.记错(JSONE_语法);
            }
        }
        返回 节;
    }

    // ---- 数组 [值, 值, ...] ----
    不安全 函数 解析数组() -> 整64 {
        整64 坏 = 自身.吃(91);
        如果 (坏 != 0) {
            返回 -1;
        }
        整64 节 = 树.新节点(JSONT_数组);
        如果 (节 == -1) {
            返回 -1;
        }
        深 = 深 + 1;
        自身.跳空白();
        如果 (自身.当前() == 93) {        // ]
            位 = 位 + 1;
            深 = 深 - 1;
            返回 节;
        }
        // #751：局部尾索引（O(1) 尾接·原 接子 每子从链头走链尾=O(子数²)）
        整64 尾 = -1;
        当 (真) {
            整64 子节 = 自身.解析值();
            如果 (子节 == -1) {
                返回 -1;
            }
            尾 = 树.接子到(节, 尾, 子节);
            自身.跳空白();
            整64 b = 自身.当前();
            如果 (b == 44) {         // ,
                位 = 位 + 1;
                继续;
            }
            如果 (b == 93) {         // ]
                位 = 位 + 1;
                深 = 深 - 1;
                返回 节;
            }
            返回 自身.记错(JSONE_语法);
        }
        返回 自身.记错(JSONE_语法);
    }

    // ---- 对象 {"键": 值, ...}（键挂值节点文本槽）----
    不安全 函数 解析对象() -> 整64 {
        整64 坏 = 自身.吃(123);
        如果 (坏 != 0) {
            返回 -1;
        }
        整64 节 = 树.新节点(JSONT_对象);
        如果 (节 == -1) {
            返回 -1;
        }
        深 = 深 + 1;
        自身.跳空白();
        如果 (自身.当前() == 125) {       // }
            位 = 位 + 1;
            深 = 深 - 1;
            返回 节;
        }
        // #751：局部尾索引（O(1) 尾接·原 接子 每子从链头走链尾=O(子数²)）
        整64 尾 = -1;
        当 (真) {
            自身.跳空白();
            如果 (自身.当前() != 34) {    // 键须字符串
                返回 自身.记错(JSONE_语法);
            }
            整64 键节 = 自身.解析字符串();
            如果 (键节 == -1) {
                返回 -1;
            }
            字符串 键 = 树.文本(键节);
            自身.跳空白();
            整64 冒坏 = 自身.吃(58);      // :
            如果 (冒坏 != 0) {
                返回 -1;
            }
            整64 值节 = 自身.解析值();
            如果 (值节 == -1) {
                返回 -1;
            }
            // 键写值节点键槽（键/值分离·成员字符串=字符串复制 落堆）
            结果<空类型, 整32> 设果 = 树.键们.设置(值节, 字符串复制(键));
            如果 (!设果.正常) {
                返回 自身.记错(JSONE_语法);
            }
            尾 = 树.接子到(节, 尾, 值节);
            自身.跳空白();
            整64 b = 自身.当前();
            如果 (b == 44) {         // ,
                位 = 位 + 1;
                继续;
            }
            如果 (b == 125) {        // }
                位 = 位 + 1;
                深 = 深 - 1;
                返回 节;
            }
            返回 自身.记错(JSONE_语法);
        }
        返回 自身.记错(JSONE_语法);
    }
}
// ---- 顶层解析入口：重置树→建解析器→解析→尾余检查 ----
不安全 函数 解析文本(JSON树* 树, 字符串 源文本) -> 空类型 {
    树.重置();
    JSON解析器 器 = JSON解析器();
    器.源 = 源文本;
    器.源长 = 字符串长度(源文本);
    器.树 = 树;
    整64 节 = 器.解析值();
    如果 (节 == -1) {
        树.根 = -1;
        返回;
    }
    器.跳空白();
    如果 (器.位 != 器.源长) {
        树.错误码 = JSONE_尾余;
        树.错误位置 = 器.位;
        树.错误字节 = 器.字节值(器.源[器.位]);
        树.根 = -1;
        返回;
    }
    树.根 = 节;
}
