// CN 语言标准库：映射集合模块（Task 6.4，对标 C++ map/set）
// 公开: 错误码（枚举）/ 映射<K,V>（键值对线性表，O(n) 复杂度）/ 集合<T>
// 实现：
//   - 映射：K* 键数组 + V* 值数组 平行存储（线性表），键不存在→追加（扩容翻倍），
//     键已存在→覆盖值；删除→前移；析构释放（RAII）
//   - 集合：独立 T* 数据数组（值唯一，添加幂等），不组合 映射<T,布尔> 字段，
//     规避"嵌套泛型字段 + 结构体返回方法"编译器缺陷（Task 6.1 实测）
// 设计说明（Task 6.4 实测边界）：
//   - 泛型类方法体内"循环遍历第一个泛型字段"有运行时缺陷（Task 6.4 实测：
//     N/P/Y/AC/AG 实验全部复现垃圾值；单字段或循环在泛型自由函数内正常）。
//     规避：循环查找逻辑全部放在模块级 泛型自由函数（参数数组，实测正常），
//     类方法仅委托调用（传字段为实参，固定读取实测正常）
//   - 键比较：K 须支持 == 比较（P0 仅数值/字符/枚举键；字符串键需 字符串比较
//     函数，规格书10.3 字符串比较运算符未定义，字符串键留待 P1）
//   - 元素按 8 字节槽存储（64 位平台，整32/浮64/指针均 8 字节槽）
//   - 构造函数重载规避（Task 6.1）：本模块只用无参构造，预留能力由 预留() 提供
公开:
枚举 错误码 {
    除零 = 1,
    越界 = 2,
    空指针 = 3,
    内存 = 4,
    文件 = 5,
    参数 = 6,
    未初始化 = 7,
    溢出 = 8
}

// ==================== 泛型自由函数：线性表辅助（循环逻辑放此处，规避类方法循环缺陷） ====================

// 查找键在键数组中的位置（找不到返回 -1）
泛型 <类型 K>
函数 查找键位置(K* 键数组, 整64 长度, K 目标) -> 整64 {
    整64 索引 = 0
    当 (索引 < 长度) {
        如果 (键数组[索引] == 目标) {
            返回 索引
        }
        索引++
    }
    返回 -1
}

// 查找值在数据数组中的位置（找不到返回 -1）——集合 添加 用
泛型 <类型 T>
函数 查找值位置(T* 数据数组, 整64 长度, T 目标) -> 整64 {
    整64 索引 = 0
    当 (索引 < 长度) {
        如果 (数据数组[索引] == 目标) {
            返回 索引
        }
        索引++
    }
    返回 -1
}

// 数组元素前移（删除用：位置 起的元素整体左移一位）
泛型 <类型 T>
函数 数组前移(T* 数据数组, 整64 长度, 整64 位置) -> 空类型 {
    整64 移动 = 位置
    当 (移动 + 1 < 长度) {
        数据数组[移动] = 数据数组[移动 + 1]
        移动++
    }
}

// ==================== 映射<K,V>（对标 C++ map，线性表实现，O(n)） ====================
泛型 <类型 K, 类型 V>
类 映射 {
私有:
    K* 键数组
    V* 值数组
    整64 元素数量
    整64 数组容量
公开:
    函数 映射() {
        键数组 = 无
        值数组 = 无
        元素数量 = 0
        数组容量 = 0
    }

    函数 ~映射() {
        如果 (键数组 != 无) {
            释放(键数组)
            键数组 = 无
        }
        如果 (值数组 != 无) {
            释放(值数组)
            值数组 = 无
        }
        元素数量 = 0
        数组容量 = 0
    }

    常量 函数 大小() -> 整64 {
        返回 元素数量
    }

    常量 函数 为空() -> 布尔 {
        返回 元素数量 == 0
    }

    // 设置键值：键已存在→覆盖值；不存在→追加（容量不足扩容翻倍）
    函数 设置(K 键, V 值) -> 结果<空类型, 整32> {
        整64 已有位置 = 查找键位置<K>(键数组, 元素数量, 键)
        如果 (已有位置 >= 0) {
            值数组[已有位置] = 值
            返回 正常()
        }
        如果 (元素数量 >= 数组容量) {
            整64 新容量 = 数组容量 * 2
            如果 (新容量 == 0) {
                新容量 = 4
            }
            空类型* 新键数组 = 重新分配(键数组, 新容量 * 8)
            如果 (新键数组 == 无) {
                返回 错误(错误码.内存)
            }
            键数组 = 新键数组
            空类型* 新值数组 = 重新分配(值数组, 新容量 * 8)
            如果 (新值数组 == 无) {
                返回 错误(错误码.内存)
            }
            值数组 = 新值数组
            数组容量 = 新容量
        }
        键数组[元素数量] = 键
        值数组[元素数量] = 值
        元素数量++
        返回 正常()
    }

    // 获取键对应值：找不到→错误码.未初始化(7)（文档注明：映射未含该键）
    函数 获取(K 键) -> 结果<V, 整32> {
        整64 位置 = 查找键位置<K>(键数组, 元素数量, 键)
        如果 (位置 < 0) {
            返回 错误(错误码.未初始化)
        }
        返回 正常(值数组[位置])
    }

    // 规格书 4.4「表.包含(键)」：键是否存在
    常量 函数 包含(K 键) -> 布尔 {
        整64 位置 = 查找键位置<K>(键数组, 元素数量, 键)
        返回 位置 >= 0
    }

    // 删除键：存在则删除并前移，返回真；否则返回假
    函数 删除(K 键) -> 布尔 {
        整64 位置 = 查找键位置<K>(键数组, 元素数量, 键)
        如果 (位置 < 0) {
            返回 假
        }
        数组前移<K>(键数组, 元素数量, 位置)
        数组前移<V>(值数组, 元素数量, 位置)
        元素数量--
        返回 真
    }

    函数 清空() {
        元素数量 = 0
    }
}

// ==================== 集合<T>（对标 C++ set，值唯一，添加幂等） ====================
// 实现：独立 T* 数据数组 + 包含检查（不组合 映射<T,布尔> 字段，规避嵌套泛型缺陷）
泛型 <类型 T>
类 集合 {
私有:
    T* 数据数组
    整64 元素数量
    整64 数组容量
公开:
    函数 集合() {
        数据数组 = 无
        元素数量 = 0
        数组容量 = 0
    }

    函数 ~集合() {
        如果 (数据数组 != 无) {
            释放(数据数组)
            数据数组 = 无
        }
        元素数量 = 0
        数组容量 = 0
    }

    常量 函数 大小() -> 整64 {
        返回 元素数量
    }

    常量 函数 为空() -> 布尔 {
        返回 元素数量 == 0
    }

    // 添加值：已存在→返回正常(空)（幂等）；不存在→追加（容量不足扩容翻倍）
    函数 添加(T 值) -> 结果<空类型, 整32> {
        整64 已有位置 = 查找值位置<T>(数据数组, 元素数量, 值)
        如果 (已有位置 >= 0) {
            返回 正常()
        }
        如果 (元素数量 >= 数组容量) {
            整64 新容量 = 数组容量 * 2
            如果 (新容量 == 0) {
                新容量 = 4
            }
            空类型* 新数据 = 重新分配(数据数组, 新容量 * 8)
            如果 (新数据 == 无) {
                返回 错误(错误码.内存)
            }
            数据数组 = 新数据
            数组容量 = 新容量
        }
        数据数组[元素数量] = 值
        元素数量++
        返回 正常()
    }

    常量 函数 包含(T 值) -> 布尔 {
        整64 位置 = 查找值位置<T>(数据数组, 元素数量, 值)
        返回 位置 >= 0
    }

    // 删除值：存在则删除并前移，返回真；否则返回假
    函数 删除(T 值) -> 布尔 {
        整64 位置 = 查找值位置<T>(数据数组, 元素数量, 值)
        如果 (位置 < 0) {
            返回 假
        }
        数组前移<T>(数据数组, 元素数量, 位置)
        元素数量--
        返回 真
    }

    函数 清空() {
        元素数量 = 0
    }
}
