// CN 语言标准库：映射集合模块（Task 6.4，对标 C++ map/set）
// 公开: 错误码（枚举）/ 映射<K,V>（哈希表，期望 O(1)）/ 集合<T>（哈希集合，期望 O(1)）
// 实现：
//   - 映射：键/值数组平行存储 + 桶链哈希（Knuth 乘法散列·2 的幂桶·负载因子 3/4），
//     键不存在→追加（扩容翻倍），键已存在→覆盖值；删除→链摘除+末元素交换；
//     析构释放（RAII）
//   - 集合：#1211 起与 映射 同构的桶链哈希（复用 散列桶序号 单一散列实现），
//     只存元素不存值；键判据=元素槽字节（散列与相等同源），见 集合 段头注释
//   - 两容器不组合泛型字段（规避"嵌套泛型字段 + 结构体返回方法"编译器缺陷·
//     Task 6.1 实测）；散列桶序号 为模块级泛型函数（调用方显式 <整64> 实例化，
//     v2 侧模块级非泛型函数在泛型方法体内裸名解析会丢模块前缀）
// 设计说明（Task 6.4 实测边界）：
//   - 泛型类方法体内"循环遍历第一个泛型字段" ✅ 已修复（2026-08-15 Debug 子任务：
//     IR emitClassMethod 设 genericTypeParams_ + 语义 resolveGenericTypeName 裸参数
//     替换）——循环查找/打印字段下标现可在类方法内直接进行。本模块仍用模块级
//     泛型自由函数组织（模块化设计，非缺陷规避）
//   - 键比较：K 须支持 == 比较（P0 仅数值/字符/枚举键；字符串键需 字符串比较
//     函数，规格书10.3 字符串比较运算符未定义，字符串键留待 P1）
//   - 元素按 8 字节槽存储（64 位平台，整32/浮64/指针均 8 字节槽）
//   - 构造函数重载 ✅ 已支持（2026-08-15）；本模块设计上用无参构造 + 预留()（API 稳定）
公开:
导入 核心::错误码;

// ==================== 泛型自由函数：线性表辅助（循环逻辑放此处，规避类方法循环缺陷） ====================

// 查找键在键数组中的位置（找不到返回 -1）
泛型 <类型 K>
函数 查找键位置(K* 键数组, 整64 长度, K 目标) -> 整64 {
    整64 索引 = 0;
    当 (索引 < 长度) {
        如果 (键数组[索引] == 目标) {
            返回 索引;
        }
        索引++;
    }
    返回 -1;
}

// 查找值在数据数组中的位置（找不到返回 -1）——保留的公开辅助（#1211 起 集合
//   内部改用桶链查找，本函数仍公开可用：线性扫描 T 数组的通用构件）
泛型 <类型 T>
函数 查找值位置(T* 数据数组, 整64 长度, T 目标) -> 整64 {
    整64 索引 = 0;
    当 (索引 < 长度) {
        如果 (数据数组[索引] == 目标) {
            返回 索引;
        }
        索引++;
    }
    返回 -1;
}

// 桶序号：Knuth 乘法散列 + 2 的幂掩码（映射/集合 共用的单一散列实现·#1211 抽出）
//   - 位模式 = 8 字节槽位模式（映射=整64(键)；集合=元素槽字节折叠）
//   - 负数安全：回绕乘 + 按位与（无符号语义）
//   - 泛型形参 K：调用方显式 散列桶序号<整64>(...)——v2 侧模块级非泛型函数在泛型
//     方法体内按裸名解析（丢模块前缀→链接未定义），泛型实例化路径符号双侧统一
泛型 <类型 K>
函数 散列桶序号(K 位模式, 整64 桶数量) -> 整64 {
    整64 散列 = 回绕乘(整64(位模式), 2654435761);   // Knuth 乘法散列（64 位回绕·#474 显式回绕）
    返回 散列 & (桶数量 - 1);                     // 2 的幂掩码（负数安全）
}

// 数组元素前移（删除用：位置 起的元素整体左移一位）——81-a：并入 集合 方法
//   （原自由泛型函数 数组前移<T> 无法承载「元素移动」编译器注入挂点：泛型实参 T
//   在自由函数内不参与容器实例化方法体生成）。见 集合.数组前移。

// ==================== 映射<K,V>（O(1) 哈希表，2026-08 自举前置修复） ====================
// 实现：键数组/值数组 平行存储（同线性版）+ 链数组（同桶链）+ 桶数组（2 的幂）。
//   - 桶索引 = 键的 8 字节位模式 Knuth 乘法散列 & (桶数-1)（负数键安全：位运算无符号语义）
//   - 键比较用 ==（数值/字符/枚举键；字符串键待 字符串[i] 与 泛型决议 修复后支持——P1）
//   - 删除 = 链摘除 + 与数组末元素交换（空洞无引用，正确性由链保证）
//   - 负载因子 3/4：元素数 >= 桶数*3/4 时 桶数翻倍 + 全键重哈希；数组容量翻倍扩容（同线性版）
// 复杂度：设置/获取/包含/删除 期望 O(1)；自举符号表（ID 整型键）规模下毫秒级
泛型 <类型 K, 类型 V>
类 映射 {
私有:
    K* 键数组;
    V* 值数组;
    整64* 链数组;      // 桶链：下一索引（-1=链尾）
    整64* 桶数组;      // 桶头索引（-1=空桶）
        整64 桶数量;       // 2 的幂（8 起，负载因子 3/4 触发翻倍扩容）
    整64 元素数量;
    整64 数组容量;
公开:
    不安全 函数 映射() {
        键数组 = 无;
        值数组 = 无;
        链数组 = 无;
        // 829（065 B 账·小初始+按需倍增·Rust HashMap 同款）：原固定 1024 桶=
        //   构造即 8KB 桶数组 + 1024 次清零——全树编译海量映射时为内存主体
        //   （实测 33GB 峰值的主因之一）；改 8 桶起步，既有翻倍扩容承接
        //   大映射（行为不变），小映射分配/清零/碰撞全面更优。
        桶数量 = 8;
        桶数组 = 分配(桶数量 * 8);
        整64 桶索引 = 0;
        当 (桶索引 < 桶数量) {
            桶数组[桶索引] = -1;
            桶索引++;
        }
        元素数量 = 0;
        数组容量 = 0;
    }

    不安全 函数 ~映射() {
        如果 (键数组 != 无) {
            释放(键数组);
            键数组 = 无;
        }
        如果 (值数组 != 无) {
            释放(值数组);
            值数组 = 无;
        }
        如果 (链数组 != 无) {
            释放(链数组);
            链数组 = 无;
        }
        如果 (桶数组 != 无) {
            释放(桶数组);
            桶数组 = 无;
        }
        元素数量 = 0;
        数组容量 = 0;
    }

    // 2026-08-25 H8-5（容器持有类对象）：释放内部数组——映射作为容器元素
    //   （向量<映射<K,V>> 作用域栈）时由容器负责元素生命周期，弹出/清场前
    //   调用本方法销毁元素资源（析构 ~映射 为 RAII 路径，本方法供显式销毁）。
    //   释放后所有数组置 无，可安全再次使用（重新分配）。
    不安全 函数 释放内部数组() {
        如果 (键数组 != 无) {
            释放(键数组);
            键数组 = 无;
        }
        如果 (值数组 != 无) {
            释放(值数组);
            值数组 = 无;
        }
        如果 (链数组 != 无) {
            释放(链数组);
            链数组 = 无;
        }
        如果 (桶数组 != 无) {
            释放(桶数组);
            桶数组 = 无;
        }
        元素数量 = 0;
        数组容量 = 0;
    }

    // 2026-08-25 方案A 拷贝构造：深拷贝全部数组（含裸指针结构体按值拷贝
    //   安全——浅拷贝两个对象析构时双释放 0xC0000374）。
    不安全 函数 映射(映射& 其他) {
        桶数量 = 其他.桶数量;
        元素数量 = 其他.元素数量;
        数组容量 = 其他.数组容量;
        桶数组 = 无;
        键数组 = 无;
        值数组 = 无;
        链数组 = 无;
        如果 (其他.桶数组 != 无) {
            桶数组 = 分配(桶数量 * 8);
            整64 桶索引 = 0;
            当 (桶索引 < 桶数量) {
                桶数组[桶索引] = 其他.桶数组[桶索引];
                桶索引++;
            }
        }
        如果 (其他.键数组 != 无) {
            // 槽大小钳制对齐 设置 扩容路径（缺陷4 2026-09-02 根治，同 向量 拷贝构造）
            键数组 = 分配(数组容量 * (类型大小(K) < 8 ? 8 : 类型大小(K)));
            整64 键索引 = 0;
            当 (键索引 < 元素数量) {
                键数组[键索引] = 复制(其他.键数组[键索引]);
                键索引++;
            }
        }
        如果 (其他.值数组 != 无) {
            // 槽大小钳制对齐 设置 扩容路径（缺陷4 2026-09-02 根治：
            //   v2 组件自用 映射<整64,符号>（符号=32字节）拷贝非空映射即越界）
            值数组 = 分配(数组容量 * (类型大小(V) < 8 ? 8 : 类型大小(V)));
            整64 值索引 = 0;
            当 (值索引 < 元素数量) {
                值数组[值索引] = 复制(其他.值数组[值索引]);
                值索引++;
            }
        }
        如果 (其他.链数组 != 无) {
            链数组 = 分配(数组容量 * 8);
            整64 链索引 = 0;
            当 (链索引 < 数组容量) {
                链数组[链索引] = 其他.链数组[链索引];
                链索引++;
            }
        }
    }

    常量 函数 大小() -> 整64 {
        返回 元素数量;
    }

    常量 函数 为空() -> 布尔 {
        返回 元素数量 == 0;
    }

    // ---- 私有辅助（桶索引 + 链查找）----
    常量 函数 桶索引(K 键) -> 整64 {
        返回 散列桶序号<整64>(整64(键), 桶数量);   // 单一散列实现：散列桶序号（映射/集合共用）
    }

    // 链查找：返回 键位置（找不到 -1），prev 输出链前驱（-1=桶头）
    常量 不安全 函数 链查找(K 键, 整64& 前驱) -> 整64 {
        // 732（708-e·静态映射未构造防御）：静态映射 全局构造器未执行时为
        //   零初始化态（桶数量=0·桶数组=无）——桶索引 掩码 (0-1)=全1 → h=散列
        //   → 桶数组[h] 读 [NULL+h*8] → C0000005（v2p 实测 fault=0x1FD0=h1018*8）。
        //   未构造/空桶防御：视为空映射（找不到）。
        前驱 = -1;
        如果 (桶数量 == 0 || 桶数组 == 无) { 返回 -1; }
        整64 h = 自身.桶索引(键);
        整64 cur = 桶数组[h];
        当 (cur != -1) {
            如果 (键数组[cur] == 键) {
                返回 cur;
            }
            前驱 = cur;
            cur = 链数组[cur];
        }
        返回 -1;
    }

    // ---- 76-a（2026-09-12 第七十六轮）编译器注入挂点 ----
    // 释放「索引」位置的键/值字符串（映射.删除 在链摘除后、与末元素交换**前**
    //   调用——交换把末元素复制到该槽，不先释放即泄漏被删项串）。
    //   空体：编译器在 emitClassMethod 生成 映射$K$V.析构键值 时注入单槽释放
    //   （__cn_map_free_slot + 槽清零，幂等）；K/V 非字符串实例零注入（空调用）。
    函数 析构键值(整64 索引) {
    }

    // 释放「索引」位置的值字符串（映射.设置 覆盖已有键时、写入新值**前**调用；
    //   键保留=仍是有效元素，链/桶继续引用）。空体：编译器注入同款（仅值侧）。
    函数 析构值(整64 索引) {
    }

    // 设置键值：键已存在→覆盖值；不存在→追加（负载/容量不足时扩容）
    不安全 函数 设置(K 键, V 值) -> 结果<空类型, 整32> {
        整64 前驱 = -1;
        整64 已有位置 = 自身.链查找(键, 前驱);
        如果 (已有位置 >= 0) {
            // 76-a：覆盖写前释放旧值字符串（编译器注入单槽释放+槽清零；V 非
            //   字符串实例零注入。键保留——仍是有效元素）
            自身.析构值(已有位置);
            值数组[已有位置] = 值;
            返回 正常();
        }
        // 负载扩容：元素数 >= 桶数*3/4 → 桶数翻倍 + 重哈希
        如果 (元素数量 * 4 >= 桶数量 * 3) {
            整64 新桶数 = 桶数量 * 2;
            整64* 新桶 = 分配(新桶数 * 8);
            如果 (新桶 == 无) {
                返回 错误(错误码.内存);
            }
            整64 桶索引 = 0;
            当 (桶索引 < 新桶数) {
                新桶[桶索引] = -1;
                桶索引++;
            }
            释放(桶数组);
            桶数组 = 新桶;
            桶数量 = 新桶数;
            // 重哈希全部键
            整64 重哈希 = 0;
            当 (重哈希 < 元素数量) {
                整64 h = 自身.桶索引(键数组[重哈希]);
                链数组[重哈希] = 桶数组[h];
                桶数组[h] = 重哈希;
                重哈希++;
            }
        }
        // 数组容量不足：翻倍扩容（同线性版）
        如果 (元素数量 >= 数组容量) {
            整64 新容量 = 数组容量 * 2;
            如果 (新容量 == 0) {
                新容量 = 4;
            }
            空类型* 新键数组 = 重新分配(键数组, 新容量 * (类型大小(K) < 8 ? 8 : 类型大小(K)));
            如果 (新键数组 == 无) {
                返回 错误(错误码.内存);
            }
            键数组 = 新键数组;
            空类型* 新值数组 = 重新分配(值数组, 新容量 * (类型大小(V) < 8 ? 8 : 类型大小(V)));
            如果 (新值数组 == 无) {
                返回 错误(错误码.内存);
            }
            值数组 = 新值数组;
            空类型* 新链 = 重新分配(链数组, 新容量 * 8);
            如果 (新链 == 无) {
                返回 错误(错误码.内存);
            }
            链数组 = 新链;
            数组容量 = 新容量;
        }
        // 追加到数组尾部 + 头插桶链
        键数组[元素数量] = 键;
        值数组[元素数量] = 值;
        链数组[元素数量] = 桶数组[自身.桶索引(键)];
        桶数组[自身.桶索引(键)] = 元素数量;
        元素数量++;
        返回 正常();
    }

    // 获取键对应值：找不到→错误码.未初始化(7)
    不安全 函数 获取(K 键) -> 结果<V, 整32> {
        整64 前驱 = -1;
        整64 位置 = 自身.链查找(键, 前驱);
        如果 (位置 < 0) {
            返回 错误(错误码.未初始化);
        }
        返回 正常(值数组[位置]);
    }

    // 规格书 4.4「表.包含(键)」：键是否存在
    常量 函数 包含(K 键) -> 布尔 {
        整64 前驱 = -1;
        返回 自身.链查找(键, 前驱) >= 0;
    }

    // 删除键：链摘除 + 与数组末元素交换（空洞无引用）；存在返回真
    不安全 函数 删除(K 键) -> 布尔 {
        整64 前驱 = -1;
        整64 位置 = 自身.链查找(键, 前驱);
        如果 (位置 < 0) {
            返回 假;
        }
        // 链摘除
        如果 (前驱 == -1) {
            桶数组[自身.桶索引(键)] = 链数组[位置];
        } 否则 {
            链数组[前驱] = 链数组[位置];
        }
        // 与末元素交换（末元素链指针迁移到 位置）
        // 76-a：交换前释放被删项的键/值字符串（编译器注入单槽释放+槽清零；
        //   被删槽在交换后由末元素接管；K/V 非字符串实例零注入）
        自身.析构键值(位置);
        整64 最后 = 元素数量 - 1;
        如果 (位置 != 最后) {
            键数组[位置] = 键数组[最后];
            值数组[位置] = 值数组[最后];
            // 更新末元素的桶链引用：链中 last → 位置
            整64 h2 = 自身.桶索引(键数组[位置]);
            整64 cur = 桶数组[h2];
            整64 prev2 = -1;
            当 (cur != -1) {
                如果 (cur == 最后) {
                    如果 (prev2 == -1) {
                        桶数组[h2] = 位置;
                    } 否则 {
                        链数组[prev2] = 位置;
                    }
                    链数组[位置] = 链数组[最后];
                    中断;
                }
                prev2 = cur;
                cur = 链数组[cur];
            }
        }
        元素数量--;
        返回 真;
    }

    不安全 函数 清空() {
        整64 桶索引 = 0;
        当 (桶索引 < 桶数量) {
            桶数组[桶索引] = -1;
            桶索引++;
        }
        元素数量 = 0;
    }
}


// ==================== 字符串映射<V>（131 甲'·960 轮·用户裁决两步走第一步） ====================
// 背景：泛型 映射<K,V> 的键消费链（== 相等×2 处 + 桶索引 整64(键) 位模式×3 处）对字符串键
//   实例化即拒——泛型体单态化无「按键类型分派」设施（166 == 立法轮承载泛型形态收口）。
//   本类=过渡止血：键类型固定 字符串，散列走 FNV-1a 逐字节、相等走 字符串比较；
//   行为与 映射<K,V> 同构（桶+链·负载因子 3/4·末元素交换删除）。166 落地后本类
//   回收为 泛型<字符串,V> 别名或废弃（025 §2.217 诚实边界）。
// 键槽宽 8（字符串=句柄·typeSizeOf 8·与 76-a runtime 8B 步进一致）；拷贝构造键深拷走 复制()。
泛型 <类型 V>
类 字符串映射 {
私有:
    字符串* 键数组;
    V* 值数组;
    整64* 链数组;      // 桶链：下一索引（-1=链尾）
    整64* 桶数组;      // 桶头索引（-1=空桶）
    整64 桶数量;       // 2 的幂（8 起，负载因子 3/4 触发翻倍扩容）
    整64 元素数量;
    整64 数组容量;
公开:
    不安全 函数 字符串映射() {
        键数组 = 无;
        值数组 = 无;
        链数组 = 无;
        桶数量 = 8;
        桶数组 = 分配(桶数量 * 8);
        整64 桶初始化 = 0;
        当 (桶初始化 < 桶数量) {
            桶数组[桶初始化] = -1;
            桶初始化++;
        }
        元素数量 = 0;
        数组容量 = 0;
    }

    不安全 函数 ~字符串映射() {
        如果 (键数组 != 无) {
            释放(键数组);
            键数组 = 无;
        }
        如果 (值数组 != 无) {
            释放(值数组);
            值数组 = 无;
        }
        如果 (链数组 != 无) {
            释放(链数组);
            链数组 = 无;
        }
        如果 (桶数组 != 无) {
            释放(桶数组);
            桶数组 = 无;
        }
        元素数量 = 0;
        数组容量 = 0;
    }

    // 76-a 同款注入挂点（空体）：编译器在 emitClassMethod 注入字符串槽释放；
    //   960 轮起注入 kStr 判定按「键数组 字段声明类型=字符串*」生效（机制级小改）。
    函数 析构键值(整64 索引) {
    }

    函数 析构值(整64 索引) {
    }

    // 字符串散列：FNV-1a（32 位乘数 1099511628211 的 64 位回绕变体）——
    //   UTF-8 逐字节（字符串[i]=整8 字节读·T48）+ 整8→整64 扩展（857 通道）。
    常量 不安全 函数 桶索引(字符串 键) -> 整64 {
        整64 h = 1469598103934665603;
        整64 i = 0;
        整64 n = 字符串长度(键);
        当 (i < n) {
            整8 字节 = 键[i];
            整64 w = 整64(字节);
            h = h ^ w;
            h = h * 1099511628211;
            i++;
        }
        返回 h & (桶数量 - 1);
    }

    // 链查找：返回 键位置（找不到 -1），前驱 输出链前驱（-1=桶头）——732 静态
    //   未构造防御同款（零初始化态视为空映射）。
    常量 不安全 函数 链查找(字符串 键, 整64& 前驱) -> 整64 {
        前驱 = -1;
        如果 (桶数量 == 0 || 桶数组 == 无) { 返回 -1; }
        整64 h = 自身.桶索引(键);
        整64 cur = 桶数组[h];
        当 (cur != -1) {
            如果 (字符串比较(键数组[cur], 键)) {
                返回 cur;
            }
            前驱 = cur;
            cur = 链数组[cur];
        }
        返回 -1;
    }

    不安全 函数 设置(字符串 键, V 值) -> 结果<空类型, 整32> {
        整64 前驱 = -1;
        整64 已有位置 = 自身.链查找(键, 前驱);
        如果 (已有位置 >= 0) {
            自身.析构值(已有位置);
            值数组[已有位置] = 值;
            返回 正常();
        }
        // 负载扩容：元素数 >= 桶数*3/4 → 桶数翻倍 + 重哈希
        如果 (元素数量 * 4 >= 桶数量 * 3) {
            整64 新桶数 = 桶数量 * 2;
            整64* 新桶 = 分配(新桶数 * 8);
            如果 (新桶 == 无) {
                返回 错误(错误码.内存);
            }
            整64 桶清零 = 0;
            当 (桶清零 < 新桶数) {
                新桶[桶清零] = -1;
                桶清零++;
            }
            释放(桶数组);
            桶数组 = 新桶;
            桶数量 = 新桶数;
            整64 重哈希 = 0;
            当 (重哈希 < 元素数量) {
                整64 h = 自身.桶索引(键数组[重哈希]);
                链数组[重哈希] = 桶数组[h];
                桶数组[h] = 重哈希;
                重哈希++;
            }
        }
        // 数组容量不足：翻倍扩容（键槽恒 16）
        如果 (元素数量 >= 数组容量) {
            整64 新容量 = 数组容量 * 2;
            如果 (新容量 == 0) {
                新容量 = 4;
            }
            空类型* 新键数组 = 重新分配(键数组, 新容量 * 8);
            如果 (新键数组 == 无) {
                返回 错误(错误码.内存);
            }
            键数组 = 新键数组;
            空类型* 新值数组 = 重新分配(值数组, 新容量 * (类型大小(V) < 8 ? 8 : 类型大小(V)));
            如果 (新值数组 == 无) {
                返回 错误(错误码.内存);
            }
            值数组 = 新值数组;
            空类型* 新链 = 重新分配(链数组, 新容量 * 8);
            如果 (新链 == 无) {
                返回 错误(错误码.内存);
            }
            链数组 = 新链;
            数组容量 = 新容量;
        }
        // 追加到数组尾部 + 头插桶链
        键数组[元素数量] = 键;
        值数组[元素数量] = 值;
        链数组[元素数量] = 桶数组[自身.桶索引(键)];
        桶数组[自身.桶索引(键)] = 元素数量;
        元素数量++;
        返回 正常();
    }

    不安全 函数 获取(字符串 键) -> 结果<V, 整32> {
        整64 前驱 = -1;
        整64 位置 = 自身.链查找(键, 前驱);
        如果 (位置 < 0) {
            返回 错误(错误码.未初始化);
        }
        返回 正常(值数组[位置]);
    }

    常量 函数 包含(字符串 键) -> 布尔 {
        整64 前驱 = -1;
        返回 自身.链查找(键, 前驱) >= 0;
    }

    不安全 函数 删除(字符串 键) -> 布尔 {
        整64 前驱 = -1;
        整64 位置 = 自身.链查找(键, 前驱);
        如果 (位置 < 0) {
            返回 假;
        }
        // 链摘除
        如果 (前驱 == -1) {
            桶数组[自身.桶索引(键)] = 链数组[位置];
        } 否则 {
            链数组[前驱] = 链数组[位置];
        }
        // 与末元素交换（末元素链指针迁移到 位置）
        自身.析构键值(位置);
        整64 最后 = 元素数量 - 1;
        如果 (位置 != 最后) {
            键数组[位置] = 键数组[最后];
            值数组[位置] = 值数组[最后];
            整64 h2 = 自身.桶索引(键数组[位置]);
            整64 cur = 桶数组[h2];
            整64 prev2 = -1;
            当 (cur != -1) {
                如果 (cur == 最后) {
                    如果 (prev2 == -1) {
                        桶数组[h2] = 位置;
                    } 否则 {
                        链数组[prev2] = 位置;
                    }
                    链数组[位置] = 链数组[最后];
                    中断;
                }
                prev2 = cur;
                cur = 链数组[cur];
            }
        }
        元素数量--;
        返回 真;
    }

    不安全 函数 清空() {
        整64 桶清零 = 0;
        当 (桶清零 < 桶数量) {
            桶数组[桶清零] = -1;
            桶清零++;
        }
        元素数量 = 0;
    }

    // 拷贝构造：深拷全部数组（键深拷 复制()=拥有化复制同源；值 复制() 同泛型版）
    不安全 函数 字符串映射(字符串映射& 其他) {
        桶数量 = 其他.桶数量;
        元素数量 = 其他.元素数量;
        数组容量 = 其他.数组容量;
        桶数组 = 无;
        键数组 = 无;
        值数组 = 无;
        链数组 = 无;
        如果 (其他.桶数组 != 无) {
            桶数组 = 分配(桶数量 * 8);
            整64 桶拷 = 0;
            当 (桶拷 < 桶数量) {
                桶数组[桶拷] = 其他.桶数组[桶拷];
                桶拷++;
            }
        }
        如果 (其他.键数组 != 无) {
            键数组 = 分配(数组容量 * 8);
            整64 键索引 = 0;
            当 (键索引 < 元素数量) {
                键数组[键索引] = 复制(其他.键数组[键索引]);
                键索引++;
            }
        }
        如果 (其他.值数组 != 无) {
            值数组 = 分配(数组容量 * (类型大小(V) < 8 ? 8 : 类型大小(V)));
            整64 值索引 = 0;
            当 (值索引 < 元素数量) {
                值数组[值索引] = 复制(其他.值数组[值索引]);
                值索引++;
            }
        }
        如果 (其他.链数组 != 无) {
            链数组 = 分配(数组容量 * 8);
            整64 链拷 = 0;
            当 (链拷 < 数组容量) {
                链数组[链拷] = 其他.链数组[链拷];
                链拷++;
            }
        }
    }

    // H8-5 同款：容器元素生命周期显式销毁口
    不安全 函数 释放内部数组() {
        如果 (键数组 != 无) {
            释放(键数组);
            键数组 = 无;
        }
        如果 (值数组 != 无) {
            释放(值数组);
            值数组 = 无;
        }
        如果 (链数组 != 无) {
            释放(链数组);
            链数组 = 无;
        }
        如果 (桶数组 != 无) {
            释放(桶数组);
            桶数组 = 无;
        }
        元素数量 = 0;
        数组容量 = 0;
    }
}

// ==================== 集合<T>（对标 C++ set，按元素槽字节判等去重） ====================
// 实现（#1211·2026-10-21 哈希化）：与 映射<K,V> 同构的桶链哈希（复用 散列桶序号 单一
//   散列实现），只存元素不存值。
//   - 数据数组（T*，元素紧凑存储）+ 链数组（桶内下一索引）+ 桶数组（桶头索引，2 的幂）
//   - 桶序号 = 元素槽字节折叠成 整64 位模式 → Knuth 乘法散列 & (桶数-1)
//   - 负载因子 3/4：元素数 >= 桶数*3/4 → 桶数翻倍 + 全量重哈希；数组容量翻倍扩容
//   - 删除 = 链摘除 + 与末元素交换（有效元素恒为 [0, 元素数量)，清空/析构注入的
//     平铺释放安全；移动经 移动元素 挂点=memcpy+源槽资源清零）
//   - 构造惰性分配：构造零分配（桶数量=0/桶数组=无），首个 添加 时分配 8 桶
// 键判据（T 无类型分派设施——按元素槽字节判定；散列与相等同源，保证
//   a 相等 b ⇒ 散列(a)==散列(b)）：
//   - 槽大小 == 8：整 8 字节位模式（整64/浮64/指针/类句柄——最常见的零拷贝路径）
//   - 槽大小 <  8：小端逐字节零扩展组装（整8/整16/整32/浮32/布尔；字符不支持）
//   - 槽大小 >  8：FNV-1a 全字节折叠（结构体/结果/大值——避免只读首 8 字节把
//     高位字段差异误并入同一等价类）
//   - 相等 = 槽字节全等（逐字节比较；8 字节槽走整64 比较）
//   诚实边界（语义按现状位模式口径固定，双侧一致）：
//   - 整数/布尔=值相等；**集合<字符> 当前不支持**（字符元素下标/借用视图面编译拒绝）；
//     **集合<枚举> host 可用但 v2 不支持**（类型大小(枚举) 在泛型实例内未知=双侧分叉，
//     见看板 #1327；修复前不得依赖）；
//   - 字符串=句柄身份——驻留字面量可按同一字面量查询/删除（**宿主行为**；v2 副本化后
//     查询/删除均不命中，见看板 #1328）；堆串（字符串复制）入容器经所有权归一化落堆为
//     **拥有化副本**，调用方原句柄不可反查（同一句柄二次添加视为两个元素）；内容相等键请用
//     字符串映射<布尔>（FNV-1a 逐字节 + 字符串比较）；
//   - 结构体/类=槽字节全等（**含 padding**：未初始化 padding 参与判等——同字段值未必相等；
//     真正按字段判等需按 T 注入/编译器支持，见看板 #1331）；
//   - 浮点 ±0/NaN=位模式（**不等同于 ==**：+0.0 与 -0.0 不等、仅**同 bit** NaN 相等。
//     ±0 口径同 Java Double.equals；NaN 比 Java 严格（Java 全部 NaN 相等，本实现
//     不同 bit 的 NaN 不等）；Rust HashSet<f64> 不允许 Eq 的同族边界）。
// 复杂度：添加/包含/删除 平均 O(1)；清空 O(桶数)；析构 O(元素数+3 数组)。
泛型 <类型 T>
类 集合 {
私有:
    T* 数据数组;
    整64* 链数组;      // 桶链：下一索引（-1=链尾）
    整64* 桶数组;      // 桶头索引（-1=空桶）
    整64 桶数量;       // 2 的幂（8 起，负载因子 3/4 触发翻倍扩容；0=未分配）
    整64 元素数量;
    整64 数组容量;
公开:
    函数 集合() {
        数据数组 = 无;
        链数组 = 无;
        // 惰性分配（#1211 返工）：构造零分配——首批元素 添加 时经 732 分支分配
        //   8 桶（消除构造期分配失败的空指针写；构造恢复 安全 签名）
        桶数量 = 0;
        桶数组 = 无;
        元素数量 = 0;
        数组容量 = 0;
    }

    不安全 函数 ~集合() {
        如果 (数据数组 != 无) {
            释放(数据数组);
            数据数组 = 无;
        }
        如果 (链数组 != 无) {
            释放(链数组);
            链数组 = 无;
        }
        如果 (桶数组 != 无) {
            释放(桶数组);
            桶数组 = 无;
        }
        元素数量 = 0;
        数组容量 = 0;
        桶数量 = 0;
    }

    常量 函数 大小() -> 整64 {
        返回 元素数量;
    }

    常量 函数 为空() -> 布尔 {
        返回 元素数量 == 0;
    }

    // ---- 私有辅助（元素槽位模式 + 相等 + 桶序号 + 链查找）----
    // 元素槽位模式提取（散列单一事实源）——T*→整8*/整64* 直转被拒，经空类型* 中转。
    常量 不安全 函数 元素位模式(空类型* 地址) -> 整64 {
        整64 槽大小 = 类型大小(T);
        // 静默豁免闭集穷举: 空类型零宽——类型大小(空类型)==0 为唯一零宽合法类型，
        //   恒 0 号桶（所有元素同槽，链比较仍正确）
        如果 (槽大小 == 0) {
            返回 0;
        }
        // 负槽大小=编译器布局缺陷（不可达）：miss 显形报错，不并入零宽静默
        如果 (槽大小 < 0) {
            运行时错误(错误码.参数);
            返回 0;   // 不可达（运行时错误 终止）——静态返回路径占位
        }
        // 8 字节槽（整64/浮64/指针/类句柄）：零拷贝直读
        如果 (槽大小 == 8) {
            整64* 宽槽 = 地址;
            返回 *宽槽;
        }
        整8* 字节 = 地址;
        // ≤8 字节：小端逐字节零扩展组装（整8 有符号→&255 取无符号字节）
        如果 (槽大小 < 8) {
            整64 位模式 = 0;
            整64 序 = 0;
            当 (序 < 槽大小) {
                位模式 = 位模式 | ((整64(字节[序]) & 255) << (序 * 8));
                序++;
            }
            返回 位模式;
        }
        // >8 字节（结构体/结果/大值）：FNV-1a 全字节折叠（回绕乘=显式回绕通道）
        整64 折叠 = 1469598103934665603;
        整64 序二 = 0;
        当 (序二 < 槽大小) {
            折叠 = 回绕乘(折叠 ^ (整64(字节[序二]) & 255), 1099511628211);
            序二++;
        }
        返回 折叠;
    }

    // 槽字节全等判据（与 元素位模式 同源：字节全等 ⇒ 位模式相等）
    //   - 空类型（槽大小<=0）：循环零次=恒真（与 元素位模式 恒 0 一致）
    常量 不安全 函数 元素相等(空类型* 左, 空类型* 右) -> 布尔 {
        整64 槽大小 = 类型大小(T);
        // 负槽大小=编译器布局缺陷（不可达）：与 元素位模式 同口径显形
        如果 (槽大小 < 0) {
            运行时错误(错误码.参数);
            返回 假;   // 不可达（运行时错误 终止）——静态返回路径占位
        }
        如果 (槽大小 == 8) {
            整64* 左宽 = 左;
            整64* 右宽 = 右;
            返回 *左宽 == *右宽;
        }
        整8* 甲 = 左;
        整8* 乙 = 右;
        整64 序 = 0;
        当 (序 < 槽大小) {
            如果 (甲[序] != 乙[序]) {
                返回 假;
            }
            序++;
        }
        返回 真;
    }

    // 桶序号：元素位模式 → 散列桶序号（映射/集合 共用单一散列实现）
    常量 不安全 函数 桶序号(空类型* 键) -> 整64 {
        返回 散列桶序号<整64>(自身.元素位模式(键), 桶数量);
    }

    // 链查找：返回元素位置（找不到 -1），前驱 输出链前驱（-1=桶头）。
    //   732 静态未构造防御：零初始化态（桶数量=0/桶数组=无）视为空集合。
    常量 不安全 函数 链查找(空类型* 键, 整64& 前驱) -> 整64 {
        前驱 = -1;
        如果 (桶数量 == 0 || 桶数组 == 无) {
            返回 -1;
        }
        整64 游标 = 桶数组[自身.桶序号(键)];
        当 (游标 != -1) {
            如果 (自身.元素相等(&数据数组[游标], 键)) {
                返回 游标;
            }
            前驱 = 游标;
            游标 = 链数组[游标];
        }
        返回 -1;
    }

    // 包含 的不安全委托（取元素地址/读槽字节=不安全面；包含 保持 常量 安全 签名）
    常量 不安全 函数 存在(T 值) -> 布尔 {
        整64 前驱 = -1;
        返回 自身.链查找(&值, 前驱) >= 0;
    }

    // 添加元素：已存在→正常()（幂等）；不存在→追加（负载/容量不足时扩容）
    不安全 函数 添加(T 值) -> 结果<空类型, 整32> {
        // 惰性桶分配（#1211 返工）+ 732 静态未构造防御：构造零分配与全局零初始化态
        //   （桶数量=0/桶数组=无）统一在此按 8 桶起步
        如果 (桶数量 == 0 || 桶数组 == 无) {
            桶数量 = 8;
            桶数组 = 分配(桶数量 * 8);
            如果 (桶数组 == 无) {
                桶数量 = 0;
                返回 错误(错误码.内存);
            }
            整64 桶初始化 = 0;
            当 (桶初始化 < 桶数量) {
                桶数组[桶初始化] = -1;
                桶初始化++;
            }
        }
        整64 前驱 = -1;
        如果 (自身.链查找(&值, 前驱) >= 0) {
            返回 正常();
        }
        // 负载扩容：元素数 >= 桶数*3/4 → 桶数翻倍 + 全量重哈希（与 映射 对齐）
        如果 (元素数量 * 4 >= 桶数量 * 3) {
            整64 新桶数 = 桶数量 * 2;
            整64* 新桶 = 分配(新桶数 * 8);
            如果 (新桶 == 无) {
                返回 错误(错误码.内存);
            }
            整64 桶清零 = 0;
            当 (桶清零 < 新桶数) {
                新桶[桶清零] = -1;
                桶清零++;
            }
            释放(桶数组);
            桶数组 = 新桶;
            桶数量 = 新桶数;
            整64 重哈希 = 0;
            当 (重哈希 < 元素数量) {
                整64 位 = 自身.桶序号(&数据数组[重哈希]);
                链数组[重哈希] = 桶数组[位];
                桶数组[位] = 重哈希;
                重哈希++;
            }
        }
        // 数组容量不足：数据/链同步翻倍（重新分配=位移动，元素所有权不复制）
        如果 (元素数量 >= 数组容量) {
            整64 新容量 = 数组容量 * 2;
            如果 (新容量 == 0) {
                新容量 = 4;
            }
            空类型* 新数据 = 重新分配(数据数组, 新容量 * 类型大小(T));
            如果 (新数据 == 无) {
                返回 错误(错误码.内存);
            }
            数据数组 = 新数据;
            空类型* 新链 = 重新分配(链数组, 新容量 * 8);
            如果 (新链 == 无) {
                返回 错误(错误码.内存);
            }
            链数组 = 新链;
            数组容量 = 新容量;
        }
        // 追加到数组尾部 + 头插桶链
        整64 桶位 = 自身.桶序号(&值);
        数据数组[元素数量] = 值;
        链数组[元素数量] = 桶数组[桶位];
        桶数组[桶位] = 元素数量;
        元素数量++;
        返回 正常();
    }

    常量 函数 包含(T 值) -> 布尔 {
        返回 自身.存在(值);
    }

    // ---- 76-a 编译器注入挂点 ----
    // 释放「被移除槽」元素资源（删除在链摘除后、交换**前**调用——先释放后覆盖）。
    //   空体：编译器注入单槽释放（字符串=__cn_seq_free_slot；含串结构体=单槽字段
    //   释放；槽清零幂等）。
    函数 析构被移除(整64 索引) {
    }

    // ---- 81-a 编译器注入挂点：元素**移动**（同 向量.移动元素）----
    //   编译器按元素类型注入 memcpy + 源槽资源清零；无串字段元素=纯 memcpy。
    //   直接结构体赋值会走 79-a 深拷=多余分配+超范围槽句柄泄漏（探针 P8）。
    不安全 函数 移动元素(整64 目标, 整64 源) {
        // 空体：编译器按元素类型注入移动语义
    }

    // 数组元素前移（位置 起整体左移）——#1211 起 删除 不再使用（哈希=交换式），保留兼容。
    //   **危险**：只移动数据数组、不更新链/桶索引→调用后 包含/删除 失效；勿在哈希集合上调用。
    不安全 函数 数组前移(整64 位置) {
        整64 移动 = 位置;
        当 (移动 + 1 < 元素数量) {
            自身.移动元素(移动, 移动 + 1);
            移动++;
        }
    }

    // 删除元素：链摘除 + 与末元素交换（空洞无引用）；存在返回真
    //   不存在→假（与 #1211 前语义一致）
    不安全 函数 删除(T 值) -> 布尔 {
        整64 前驱 = -1;
        整64 位置 = 自身.链查找(&值, 前驱);
        如果 (位置 < 0) {
            返回 假;
        }
        // 链摘除（先摘再交换：末元素若在同链上经过 位置，摘除后其前驱自然为 前驱）
        整64 桶位 = 自身.桶序号(&值);
        如果 (前驱 == -1) {
            桶数组[桶位] = 链数组[位置];
        } 否则 {
            链数组[前驱] = 链数组[位置];
        }
        // 76-a：交换前释放被删槽资源（编译器注入单槽释放+槽清零）
        自身.析构被移除(位置);
        整64 最后 = 元素数量 - 1;
        如果 (位置 != 最后) {
            // 末元素移到 位置（移动经注入挂点：memcpy + 源槽资源清零）
            自身.移动元素(位置, 最后);
            // 更新末元素的桶链引用：链中 最后 → 位置（先移动再定位=槽内容已就位）
            整64 末桶位 = 自身.桶序号(&数据数组[位置]);
            整64 游标 = 桶数组[末桶位];
            整64 前驱二 = -1;
            布尔 已迁移 = 假;
            当 (游标 != -1) {
                如果 (游标 == 最后) {
                    如果 (前驱二 == -1) {
                        桶数组[末桶位] = 位置;
                    } 否则 {
                        链数组[前驱二] = 位置;
                    }
                    链数组[位置] = 链数组[最后];
                    已迁移 = 真;
                    中断;
                }
                前驱二 = 游标;
                游标 = 链数组[游标];
            }
            // 不可达不变量：末元素必在其桶链上（插入/重哈希/交换删除共同维护）；
            //   未找到=内部结构损坏——显形报错，禁止静默走完
            如果 (!已迁移) {
                运行时错误(错误码.参数);
            }
        }
        元素数量--;
        返回 真;
    }

    不安全 函数 清空() {
        整64 桶清零 = 0;
        当 (桶清零 < 桶数量) {
            桶数组[桶清零] = -1;
            桶清零++;
        }
        元素数量 = 0;
    }
}
