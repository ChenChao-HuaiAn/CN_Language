// CN 语言标准库：测试框架模块（冻结期生态任务 348·蓝图 plans/030 支柱二）
// 公开: 测试器（类）/ 测试开始 / 运行用例 / 断言真 / 断言假 / 断言相等整数 /
//       断言相等文本 / 断言相等布尔 / 断言不等整数 / 断言近似 / 测试汇总
// 实现：
//   - 状态=测试器 实例字段（用例总数/失败用例数/失败断言数/当前用例名），
//     显式传参（首参 测试器*）——零全局状态，Go testing 的 t *testing.T 模式
//   - 断言失败即打印失败行并计数，不终止进程——与 核心.断言 的立即终止差异化：
//     单用例可连续收集多断言失败，一次跑完全部用例（CI 一屏看全貌）
//   - 回调驱动：运行用例(器, 名字, 空类型(*)(测试器*) 函数指针)——测试体是
//     普通函数（首参接 测试器*），用例组织=主函数内顺序 运行用例 调用
//   - 失败用例数口径=用例内至少一条断言失败记 1（运行用例 以进入时失败断言数
//     为基线，体结束后增量即判失败用例）
//   - 测试汇总 返回失败用例数（非零即可直接作进程退出码·CI 友好）
// 设计说明：
//   - 测试器 计数走成员方法（记用例/记失败断言/记失败用例/设用例）——
//     〔形态规避·021 #350〕外部指针成员在算术表达式上下文的读改写存在
//     静默错值缺陷（arm64 宿主实证·探针 p348a），本模块一律方法内读改写，
//     外部只用「直写字面量/快照值」与「读」两类已验证安全形态
//   - 字符串按内置 字符串比较 判等（内容比较·非指针比较）
//   - 断言近似 用绝对容差双向比较（得-望 与 望-得 都不得超容差·规避浮点负差）
//   - 自举 showcase：本模块与 E2E 668 均为「用 CN 写 CN 的测试工具」实证
// 使用方式：导入 测试框架::{测试器, 运行用例, 断言真, 测试汇总} 后直调
公开:
类 测试器 {
公开:
    整64 用例总数;
    整64 失败用例数;
    整64 失败断言数;
    字符串 当前用例;
    函数 测试器() {
        用例总数 = 0;
        失败用例数 = 0;
        失败断言数 = 0;
        当前用例 = "";
    }
    不安全 函数 记用例() { 用例总数 = 用例总数 + 1; }
    不安全 函数 记失败断言() { 失败断言数 = 失败断言数 + 1; }
    不安全 函数 记失败用例() { 失败用例数 = 失败用例数 + 1; }
    不安全 函数 设用例(字符串 名) { 当前用例 = 名; }
}

// 清零全部计数与当前用例名（测试器 可复用跑第二轮）
不安全 函数 测试开始(测试器* 器) -> 空类型 {
    器.用例总数 = 0;
    器.失败用例数 = 0;
    器.失败断言数 = 0;
    器.设用例("");
}

// 运行单个测试用例：记录用例名后执行函数指针体；用例内断言失败不中断
不安全 函数 运行用例(测试器* 器, 字符串 名, 空类型(*体)(测试器*)) -> 空类型 {
    器.设用例(名);
    器.记用例();
    整64 基线 = 器.失败断言数;
    体(器);
    如果 (器.失败断言数 > 基线) {
        器.记失败用例();
    }
}

// 断言条件为真；为假时打印失败行并计数（不终止）
不安全 函数 断言真(测试器* 器, 布尔 条件, 字符串 消息) -> 空类型 {
    如果 (!条件) {
        器.记失败断言();
        打印("失败·用例=", 器.当前用例, "·", 消息);
    }
}

// 断言条件为假；为真时打印失败行并计数（不终止）
不安全 函数 断言假(测试器* 器, 布尔 条件, 字符串 消息) -> 空类型 {
    断言真(器, !条件, 消息);
}

// 断言两整数相等；不等时附 得/望 值便于定位
不安全 函数 断言相等整数(测试器* 器, 整64 得, 整64 望, 字符串 消息) -> 空类型 {
    如果 (得 != 望) {
        器.记失败断言();
        打印("失败·用例=", 器.当前用例, "·", 消息, "·得=", 得, "·望=", 望);
    }
}

// 断言两字符串内容相等（内置 字符串比较·内容比较）
不安全 函数 断言相等文本(测试器* 器, 字符串 得, 字符串 望, 字符串 消息) -> 空类型 {
    如果 (!字符串比较(得, 望)) {
        器.记失败断言();
        打印("失败·用例=", 器.当前用例, "·", 消息, "·得=", 得, "·望=", 望);
    }
}

// 断言两布尔相等
不安全 函数 断言相等布尔(测试器* 器, 布尔 得, 布尔 望, 字符串 消息) -> 空类型 {
    如果 (得 != 望) {
        器.记失败断言();
        打印("失败·用例=", 器.当前用例, "·", 消息);
    }
}

// 断言两整数不等；相等时打印失败行并计数
不安全 函数 断言不等整数(测试器* 器, 整64 得, 整64 望, 字符串 消息) -> 空类型 {
    如果 (得 == 望) {
        器.记失败断言();
        打印("失败·用例=", 器.当前用例, "·", 消息, "·两者皆=", 得);
    }
}

// 断言两浮点数在绝对容差内相等（双向比较·规避浮点负差）
不安全 函数 断言近似(测试器* 器, 浮64 得, 浮64 望, 浮64 容差, 字符串 消息) -> 空类型 {
    如果 (得 - 望 > 容差 || 望 - 得 > 容差) {
        器.记失败断言();
        打印("失败·用例=", 器.当前用例, "·", 消息, "·得=", 得, "·望=", 望);
    }
}

// 打印汇总行并返回失败用例数（可直接作主函数返回值·0=全过）
不安全 函数 测试汇总(测试器* 器) -> 整64 {
    打印("测试汇总·用例=", 器.用例总数, "·失败用例=", 器.失败用例数, "·失败断言=", 器.失败断言数);
    返回 器.失败用例数;
}
