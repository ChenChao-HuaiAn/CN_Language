// CN 语言标准库：容器模块（Task 6.1，对标 C++ vector/list/stack/queue）
// 公开: 错误码（枚举）/ 向量<T>（动态数组）/ 链表<T>（索引链表）/
//       栈<T>（独立动态数组）/ 队列<T>（独立索引链表）
// 实现：
//   - 手动内存：分配/重新分配/释放 内建函数（cn_alloc/cn_realloc/cn_free）
//   - 向量扩容：容量不足翻倍（0 -> 4，之后 ×2）；析构释放底层数组（RAII）
//   - 链表：数组索引模拟链（T* 值表 + 整64* 下一索引，-1 表链尾），
//           规避"类对象链指针"在泛型上下文的类型替换复杂度
//   - 栈/队列：独立基础字段实现（T* 数组 / T* 值表 + 整64* 下一索引），
//           规避"嵌套泛型字段调用结构体返回方法 this 传递错误"编译器缺陷
//           （组合 向量<T>/链表<T> 字段 + 调用结构体返回方法会崩溃 0xC0000374）
// 设计说明（Task 6.1 实测边界）：
//   - 错误码用 枚举（错误 是内置构造器不可重定义），值域与规格书附录B一致
//   - 指针解引用赋值 *p = v 行首歧义（换行≡空格），统一用下标 p[0]（等价 *p）
//   - 元素按 类型大小(T) 字节紧凑存储（缺陷③根治 2026-09-03：数组 C 布局/
//     指针步进/容器分配三处统一；中间态 max(8,大小) 8 字节槽模型已废弃——
//     与「指针步进按元素大小」矛盾，窄元素 T* 下标错位；
//     下一索引表（整64*）按 8 字节不变）
//   - 常量成员函数语法：常量 函数 名() -> 类型（`常量` 在 `函数` 前）
//   - 构造函数重载 ✅ 已支持（2026-08-15 Debug 子任务修复：构造/析构 methods
//     表按 sigKey 多版本共存 + 实参匹配）。本模块设计上用无参构造 + 预留()
//     提供预分配能力（保持 API 稳定，非缺陷规避）。
公开:
导入 核心::错误码;

// ==================== 向量<T>（对标 C++ vector） ====================
泛型 <类型 T>
类 向量 {
私有:
    T* 数据;
    整64 元素数量;
    整64 数组容量;
公开:
    不安全 函数 向量() {
        数据 = 无;
        元素数量 = 0;
        数组容量 = 0;
    }

    不安全 函数 ~向量() {
        如果 (数据 != 无) {
            释放(数据);
            数据 = 无;
        }
        元素数量 = 0;
        数组容量 = 0;
    }

    // 2026-08-25 方案A 拷贝构造：深拷贝数据数组（逐元素按 T 拷贝语义——
    //   T 含裸指针时逐元素走 T 的拷贝构造，避免浅拷贝析构双释放）。
    不安全 函数 向量(向量& 其他) {
        数据 = 无;
        元素数量 = 其他.元素数量;
        数组容量 = 其他.数组容量;
        如果 (其他.数据 != 无 && 数组容量 > 0) {
            // 槽大小钳制对齐 追加 扩容路径（缺陷4 2026-09-02 根治：
            //   原 分配(数组容量*8) 对 >8 字节元素下分配——3×24 字节写进 4×8=32
            //   字节缓冲，堆越界写+越界读损坏，p8 实证 b[2].丙=2 应为 3）
            数据 = 分配(数组容量 * 类型大小(T));
            整64 索引 = 0;
            当 (索引 < 元素数量) {
                数据[索引] = 其他.数据[索引];
                索引++;
            }
        }
    }

    常量 函数 大小() -> 整64 {
        返回 元素数量;
    }

    常量 函数 容量() -> 整64 {
        返回 数组容量;
    }

    常量 函数 为空() -> 布尔 {
        返回 元素数量 == 0;
    }

    不安全 函数 追加(T 值) -> 结果<空类型, 整32> {
        如果 (元素数量 >= 数组容量) {
            整64 新容量 = 数组容量 * 2;
            如果 (新容量 == 0) {
                新容量 = 4;
            }
            // A-3（缺陷③根治 2026-09-03）：元素按 类型大小(T) 紧凑存储——与 IR
            //   指针步进/数组 C 布局统一（原 max(8,大小) 8 字节槽模型与「指针
            //   步进按元素大小」矛盾：窄元素 T* 下标错位，30_container 实证）
            空类型* 新数据 = 重新分配(数据, 新容量 * 类型大小(T));
            如果 (新数据 == 无) {
                返回 错误(错误码.内存);
            }
            数据 = 新数据;
            数组容量 = 新容量;
        }
        数据[元素数量] = 值;
        元素数量++;
        返回 正常();
    }

    不安全 函数 插入(整64 位置, T 值) -> 结果<空类型, 整32> {
        如果 (位置 > 元素数量) {
            返回 错误(错误码.越界);
        }
        如果 (元素数量 >= 数组容量) {
            整64 新容量 = 数组容量 * 2;
            如果 (新容量 == 0) {
                新容量 = 4;
            }
            空类型* 新数据 = 重新分配(数据, 新容量 * 类型大小(T));
            如果 (新数据 == 无) {
                返回 错误(错误码.内存);
            }
            数据 = 新数据;
            数组容量 = 新容量;
        }
        整64 移动 = 元素数量;
        当 (移动 > 位置) {
            数据[移动] = 数据[移动 - 1];
            移动--;
        }
        数据[位置] = 值;
        元素数量++;
        返回 正常();
    }

    // Feature 2 move 语义（2026-08-25）：编译器注入辅助——析构 数据[索引] 元素。
    //   仅 T 为有析构类时展开为 Call T$析构(this=数据+索引*步长)；T 无析构时 no-op。
    //   由 删除 移位循环调用（移位前析构目标槽释放旧资源 + 末尾槽析构），
    //   根治 删除中间位置 的移位槽泄漏（拷贝构造覆盖活对象 + 末尾槽未析构）。
    函数 析构元素(整64 索引) {
        // 空体：编译器在 emitClassMethod 生成 向量$T.析构元素 时注入单元素析构
    }

    // 76-a（2026-09-12 第七十六轮）编译器注入挂点：释放「被移除槽」的字符串。
    //   语义分派（按元素类别，编译期注入）：
    //     · T=字符串：__cn_seq_free_slot（释放 + 槽清零；唯一持有者槽=被移除槽）
    //     · T 有析构类：**不注入**（no-op）——类元素被移除槽的析构由既有
    //       析构元素 调用链（循环首步 析构元素(位置) + 末尾）负责，零行为变化
    //   与 析构元素 互补：析构元素 只服务「有析构类」（移位目标槽/末尾移出槽）；
    //   字符串下标赋值为**浅拷句柄**（移位源槽与有效槽重复引用，释放即悬垂——
    //   探针 76-V1 修复首版实证：析构末尾移出槽致元素内容损坏），故字符串元素
    //   只释放唯一持有者的被移除槽。
    函数 析构被移除(整64 索引) {
        // 空体：T=字符串 时编译器注入单槽释放；有析构类元素零注入
    }

    不安全 函数 删除(整64 位置) -> 结果<空类型, 整32> {
        如果 (位置 >= 元素数量) {
            返回 错误(错误码.越界);
        }
        // 76-a：先释放被移除槽（唯一持有者）——字符串元素在此释放；
        //   有析构类元素 no-op（其析构由下方 析构元素 链完成，与原实现一致）
        自身.析构被移除(位置);
        整64 移动 = 位置;
        当 (移动 + 1 < 元素数量) {
            自身.析构元素(移动);           // 移位前析构目标槽（释放旧资源；移动=位置=被移除元素）
            数据[移动] = 数据[移动 + 1];   // 拷贝构造（深拷贝，无泄漏）
            移动++;
        }
        自身.析构元素(元素数量 - 1);       // 析构末尾源对象（移出范围后）
        元素数量--;
        返回 正常();
    }

    函数 读取(整64 位置) -> 结果<T, 整32> {
        如果 (位置 >= 元素数量) {
            返回 错误(错误码.越界);
        }
        返回 正常(数据[位置]);
    }

    函数 元素(整64 位置) -> T {
        返回 数据[位置];
    }

    不安全 函数 设置(整64 位置, T 值) -> 结果<空类型, 整32> {
        如果 (位置 >= 元素数量) {
            返回 错误(错误码.越界);
        }
        // 76-a：覆盖前释放被移除槽的字符串（唯一持有者=位置槽；T=字符串 注入，
        //   有析构类 no-op——零行为变化；类元素的覆盖旧对象为既有边界）
        自身.析构被移除(位置);
        数据[位置] = 值;
        返回 正常();
    }

    函数 清空() {
        元素数量 = 0;
    }

    函数 预留(整64 容量) -> 结果<空类型, 整32> {
        如果 (容量 <= 数组容量) {
            返回 正常();
        }
        空类型* 新数据 = 重新分配(数据, 容量 * 类型大小(T));
        如果 (新数据 == 无) {
            返回 错误(错误码.内存);
        }
        数据 = 新数据;
        数组容量 = 容量;
        返回 正常();
    }
}

// ==================== 链表<T>（对标 C++ list） ====================
// 实现：数组索引模拟链（值表[i] 存值，下一索引[i] 存下一个下标，-1 表链尾），
//   头索引/尾索引 记录链端点。扩容策略与向量一致（0 -> 4，之后 ×2）。
泛型 <类型 T>
类 链表 {
私有:
    T* 值表;
    整64* 下一索引;
    整64 值容量;
    整64 头索引;
    整64 尾索引;
    整64 元素数量;
公开:
    函数 链表() {
        值表 = 无;
        下一索引 = 无;
        值容量 = 0;
        头索引 = -1;
        尾索引 = -1;
        元素数量 = 0;
    }

    函数 ~链表() {
        如果 (值表 != 无) {
            释放(值表);
            值表 = 无;
        }
        如果 (下一索引 != 无) {
            释放(下一索引);
            下一索引 = 无;
        }
        值容量 = 0;
        头索引 = -1;
        尾索引 = -1;
        元素数量 = 0;
    }

    常量 函数 大小() -> 整64 {
        返回 元素数量;
    }

    常量 函数 为空() -> 布尔 {
        返回 元素数量 == 0;
    }

    不安全 函数 追加(T 值) -> 结果<空类型, 整32> {
        如果 (元素数量 >= 值容量) {
            整64 新容量 = 值容量 * 2;
            如果 (新容量 == 0) {
                新容量 = 4;
            }
            空类型* 新值表 = 重新分配(值表, 新容量 * 类型大小(T));
            如果 (新值表 == 无) {
                返回 错误(错误码.内存);
            }
            值表 = 新值表;
            空类型* 新链 = 重新分配(下一索引, 新容量 * 8);
            如果 (新链 == 无) {
                返回 错误(错误码.内存);
            }
            下一索引 = 新链;
            值容量 = 新容量;
        }
        整64 新索引 = 元素数量;
        值表[新索引] = 值;
        下一索引[新索引] = -1;
        如果 (尾索引 >= 0) {
            下一索引[尾索引] = 新索引;
        } 否则 {
            头索引 = 新索引;
        }
        尾索引 = 新索引;
        元素数量++;
        返回 正常();
    }

    函数 头部追加(T 值) -> 结果<空类型, 整32> {
        如果 (元素数量 >= 值容量) {
            整64 新容量 = 值容量 * 2;
            如果 (新容量 == 0) {
                新容量 = 4;
            }
            空类型* 新值表 = 重新分配(值表, 新容量 * 类型大小(T));
            如果 (新值表 == 无) {
                返回 错误(错误码.内存);
            }
            值表 = 新值表;
            空类型* 新链 = 重新分配(下一索引, 新容量 * 8);
            如果 (新链 == 无) {
                返回 错误(错误码.内存);
            }
            下一索引 = 新链;
            值容量 = 新容量;
        }
        整64 新索引 = 元素数量;
        值表[新索引] = 值;
        下一索引[新索引] = 头索引;
        如果 (元素数量 == 0) {
            尾索引 = 新索引;
        }
        头索引 = 新索引;
        元素数量++;
        返回 正常();
    }

    函数 删除头部() -> 结果<空类型, 整32> {
        如果 (元素数量 == 0) {
            返回 错误(错误码.未初始化);
        }
        整64 旧头 = 头索引;
        头索引 = 下一索引[旧头];
        如果 (元素数量 == 1) {
            尾索引 = -1;
        }
        元素数量--;
        返回 正常();
    }

    函数 删除尾部() -> 结果<空类型, 整32> {
        如果 (元素数量 == 0) {
            返回 错误(错误码.未初始化);
        }
        如果 (元素数量 == 1) {
            头索引 = -1;
            尾索引 = -1;
        } 否则 {
            整64 当前 = 头索引;
            当 (下一索引[当前] != 尾索引) {
                当前 = 下一索引[当前];
            }
            下一索引[当前] = -1;
            尾索引 = 当前;
        }
        元素数量--;
        返回 正常();
    }

    函数 头部元素() -> T {
        返回 值表[头索引];
    }

    函数 读取头部() -> 结果<T, 整32> {
        如果 (元素数量 == 0) {
            返回 错误(错误码.未初始化);
        }
        返回 正常(值表[头索引]);
    }

    函数 读取尾部() -> 结果<T, 整32> {
        如果 (元素数量 == 0) {
            返回 错误(错误码.未初始化);
        }
        返回 正常(值表[尾索引]);
    }

    函数 清空() {
        头索引 = -1;
        尾索引 = -1;
        元素数量 = 0;
    }
}

// ==================== 栈<T>（对标 C++ stack） ====================
// 实现：独立 T* 动态数组（压入=尾部追加，弹出=尾部移除），
//   不组合 向量<T> 字段以规避"嵌套泛型字段 + 结构体返回方法"编译器缺陷。
泛型 <类型 T>
类 栈 {
私有:
    T* 数据;
    整64 元素数量;
    整64 数组容量;
公开:
    函数 栈() {
        数据 = 无;
        元素数量 = 0;
        数组容量 = 0;
    }

    函数 ~栈() {
        如果 (数据 != 无) {
            释放(数据);
            数据 = 无;
        }
        元素数量 = 0;
        数组容量 = 0;
    }

    函数 压入(T 值) -> 结果<空类型, 整32> {
        如果 (元素数量 >= 数组容量) {
            整64 新容量 = 数组容量 * 2;
            如果 (新容量 == 0) {
                新容量 = 4;
            }
            空类型* 新数据 = 重新分配(数据, 新容量 * 类型大小(T));
            如果 (新数据 == 无) {
                返回 错误(错误码.内存);
            }
            数据 = 新数据;
            数组容量 = 新容量;
        }
        数据[元素数量] = 值;
        元素数量++;
        返回 正常();
    }

    函数 弹出() -> 结果<T, 整32> {
        如果 (元素数量 == 0) {
            返回 错误(错误码.未初始化);
        }
        元素数量--;
        返回 正常(数据[元素数量]);
    }

    函数 栈顶() -> 结果<T, 整32> {
        如果 (元素数量 == 0) {
            返回 错误(错误码.未初始化);
        }
        返回 正常(数据[元素数量 - 1]);
    }

    常量 函数 为空() -> 布尔 {
        返回 元素数量 == 0;
    }

    常量 函数 大小() -> 整64 {
        返回 元素数量;
    }
}

// ==================== 队列<T>（对标 C++ queue） ====================
// 实现：独立索引链表（入队=尾部追加，出队=头部移除），
//   不组合 链表<T> 字段以规避"嵌套泛型字段 + 结构体返回方法"编译器缺陷。
泛型 <类型 T>
类 队列 {
私有:
    T* 值表;
    整64* 下一索引;
    整64 值容量;
    整64 头索引;
    整64 尾索引;
    整64 元素数量;
公开:
    函数 队列() {
        值表 = 无;
        下一索引 = 无;
        值容量 = 0;
        头索引 = -1;
        尾索引 = -1;
        元素数量 = 0;
    }

    函数 ~队列() {
        如果 (值表 != 无) {
            释放(值表);
            值表 = 无;
        }
        如果 (下一索引 != 无) {
            释放(下一索引);
            下一索引 = 无;
        }
        值容量 = 0;
        头索引 = -1;
        尾索引 = -1;
        元素数量 = 0;
    }

    常量 函数 大小() -> 整64 {
        返回 元素数量;
    }

    常量 函数 为空() -> 布尔 {
        返回 元素数量 == 0;
    }

    函数 入队(T 值) -> 结果<空类型, 整32> {
        如果 (元素数量 >= 值容量) {
            整64 新容量 = 值容量 * 2;
            如果 (新容量 == 0) {
                新容量 = 4;
            }
            空类型* 新值表 = 重新分配(值表, 新容量 * 类型大小(T));
            如果 (新值表 == 无) {
                返回 错误(错误码.内存);
            }
            值表 = 新值表;
            空类型* 新链 = 重新分配(下一索引, 新容量 * 8);
            如果 (新链 == 无) {
                返回 错误(错误码.内存);
            }
            下一索引 = 新链;
            值容量 = 新容量;
        }
        整64 新索引 = 元素数量;
        值表[新索引] = 值;
        下一索引[新索引] = -1;
        如果 (尾索引 >= 0) {
            下一索引[尾索引] = 新索引;
        } 否则 {
            头索引 = 新索引;
        }
        尾索引 = 新索引;
        元素数量++;
        返回 正常();
    }

    函数 出队() -> 结果<T, 整32> {
        如果 (元素数量 == 0) {
            返回 错误(错误码.未初始化);
        }
        整64 旧头 = 头索引;
        整64 新头 = 下一索引[旧头];
        头索引 = 新头;
        如果 (元素数量 == 1) {
            尾索引 = -1;
        }
        元素数量--;
        返回 正常(值表[旧头]);
    }

    函数 队首() -> 结果<T, 整32> {
        如果 (元素数量 == 0) {
            返回 错误(错误码.未初始化);
        }
        返回 正常(值表[头索引]);
    }

    函数 清空() {
        头索引 = -1;
        尾索引 = -1;
        元素数量 = 0;
    }
}
