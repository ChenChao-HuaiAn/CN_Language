// CN 语言标准库：算法模块（Task 6.7，对标 C++ <algorithm>）
// 公开: 排序（整32/整64 冒泡，比较内联）/ 线性查找（泛型）/ 二分查找（整32/整64）/
//       逆序（泛型）/ 变换（整32/整64）/ 计数（泛型）/ 最大元素（泛型）
// 实现：
//   - 冒泡排序：相邻比较交换（升序），比较逻辑内联 < 运算符
//   - 线性查找/计数/最大元素/逆序：泛型自由函数（T* 参数 + == / < 比较）
// 设计说明（Task 6.7 实测边界）：
//   - 泛型函数 + 函数指针回调（整32(*比较)(T, T)）组合编译器暂不支持
//     （单态化后签名不匹配，Task 6.7 实测 B/C 实验失败）——P0 排序/二分 用
//     具体类型（整32/整64）重载 + 比较内联实现；泛型自由函数（无函数指针）正常
//   - 数组入参：整32[6] 静态数组名退化为 整32* 传参（泛型/具体类型均正常）
//   - 指针解引用赋值 *p = v 行首歧义，统一用下标 p[0]（等价 *p）
//   - 元素按 8 字节槽存储（64 位平台）
//   - 二分查找 前置条件：数组已按升序（本模块 排序 或外部排序）
//   - 返回 -1 表示未找到（线性查找/二分查找）；文档注明

// v2.0 默认私有：本模块全部函数为公开 API，文件顶部显式 公开: 导出
公开:
// ==================== 排序（整32 冒泡，升序，比较内联） ====================
不安全 函数 排序整32(整32* 数组, 整64 长度) -> 空类型 {
    整64 外层 = 0;
    当 (外层 + 1 < 长度) {
        整64 内层 = 0;
        当 (内层 + 1 < 长度 - 外层) {
            如果 (数组[内层] > 数组[内层 + 1]) {
                整32 临时 = 数组[内层];
                数组[内层] = 数组[内层 + 1];
                数组[内层 + 1] = 临时;
            }
            内层++;
        }
        外层++;
    }
}

// ==================== 排序（整64 冒泡，升序，比较内联） ====================
不安全 函数 排序整64(整64* 数组, 整64 长度) -> 空类型 {
    整64 外层 = 0;
    当 (外层 + 1 < 长度) {
        整64 内层 = 0;
        当 (内层 + 1 < 长度 - 外层) {
            如果 (数组[内层] > 数组[内层 + 1]) {
                整64 临时 = 数组[内层];
                数组[内层] = 数组[内层 + 1];
                数组[内层 + 1] = 临时;
            }
            内层++;
        }
        外层++;
    }
}

// ==================== 线性查找（泛型，返回索引或 -1） ====================
泛型 <类型 T>
函数 线性查找(T* 数组, 整64 长度, T 目标) -> 整64 {
    整64 索引 = 0;
    当 (索引 < 长度) {
        如果 (数组[索引] == 目标) {
            返回 索引;
        }
        索引++;
    }
    返回 -1;
}

// ==================== 二分查找（整32，前提：数组已按升序） ====================
函数 二分查找整32(整32* 数组, 整64 长度, 整32 目标) -> 整64 {
    整64 左 = 0;
    整64 右 = 长度 - 1;
    当 (左 <= 右) {
        整64 中 = 左 + (右 - 左) / 2;
        如果 (数组[中] == 目标) {
            返回 中;
        }
        如果 (数组[中] < 目标) {
            左 = 中 + 1;
        } 否则 {
            右 = 中 - 1;
        }
    }
    返回 -1;
}

// ==================== 二分查找（整64，前提：数组已按升序） ====================
函数 二分查找整64(整64* 数组, 整64 长度, 整64 目标) -> 整64 {
    整64 左 = 0;
    整64 右 = 长度 - 1;
    当 (左 <= 右) {
        整64 中 = 左 + (右 - 左) / 2;
        如果 (数组[中] == 目标) {
            返回 中;
        }
        如果 (数组[中] < 目标) {
            左 = 中 + 1;
        } 否则 {
            右 = 中 - 1;
        }
    }
    返回 -1;
}

// ==================== 逆序（泛型，原地反转） ====================
泛型 <类型 T>
不安全 函数 逆序(T* 数组, 整64 长度) -> 空类型 {
    整64 左 = 0;
    整64 右 = 长度 - 1;
    当 (左 < 右) {
        T 临时 = 数组[左];
        数组[左] = 数组[右];
        数组[右] = 临时;
        左++;
        右--;
    }
}

// ==================== 变换（整32，原地：数组[i] = 数组[i] * 2） ====================
不安全 函数 变换整32(整32* 数组, 整64 长度) -> 空类型 {
    整64 索引 = 0;
    当 (索引 < 长度) {
        数组[索引] = 数组[索引] * 2;
        索引++;
    }
}

// ==================== 变换（整64，原地：数组[i] = 数组[i] * 2） ====================
不安全 函数 变换整64(整64* 数组, 整64 长度) -> 空类型 {
    整64 索引 = 0;
    当 (索引 < 长度) {
        数组[索引] = 数组[索引] * 2;
        索引++;
    }
}

// ==================== 计数（泛型，统计目标出现次数） ====================
泛型 <类型 T>
函数 计数(T* 数组, 整64 长度, T 目标) -> 整64 {
    整64 次数 = 0;
    整64 索引 = 0;
    当 (索引 < 长度) {
        如果 (数组[索引] == 目标) {
            次数++;
        }
        索引++;
    }
    返回 次数;
}

// ==================== 最大元素（泛型，返回最大值） ====================
泛型 <类型 T>
函数 最大元素(T* 数组, 整64 长度) -> T {
    T 最大 = 数组[0];
    整64 索引 = 1;
    当 (索引 < 长度) {
        如果 (数组[索引] > 最大) {
            最大 = 数组[索引];
        }
        索引++;
    }
    返回 最大;
}
