导入 容器::向量;

类 货架 {
公开:
    向量<字符串> 记录;
    函数 货架() { 记录 = 向量<字符串>(); }
    函数 ~货架() { }
    不安全 函数 货架(货架& 其他) { 记录 = 其他.记录; }
}

类 主仓 {
公开:
    函数 主仓() { }
    函数 产() -> 货架 {
        货架 临时;
        结果<空类型, 整32> r = 临时.记录.追加(字符串复制("覆盖位新资源载荷"));
        返回 临时;
    }
}

函数 主() -> 整32 {
    整64 前 = 内存::活动分配数();
    主仓 仓;
    整64 轮 = 0;
    当 (轮 < 5) {
        货架 甲;
        结果<空类型, 整32> r1 = 甲.记录.追加(字符串复制("变量位旧资源载荷"));
        甲 = 仓.产();
        如果 (甲.记录.大小() != 1) { 打印("大小错"); 返回 0; }
        打印("轮", 轮, "净=", 内存::活动分配数() - 前);
        轮++;
    }
    返回 0;
}
