导入 容器::向量;
导入 映射集合::映射;
不安全 函数 主() -> 整32 {
    向量<映射<整64, 整64>> 表 = 向量<映射<整64, 整64>>();
    映射<整64, 整64> 层 = 映射<整64, 整64>();
    结果<空类型, 整32> s1 = 层.设置(1, 10);
    如果 (!s1.正常) { 返回 1; }
    结果<空类型, 整32> s2 = 表.追加(层);
    如果 (!s2.正常) { 返回 2; }
    映射<整64, 整64> 副本 = 表.元素(0);
    打印("拿到副本");
    返回 0;
}
