// 面①：元素读副本独立性（746-a 域·追加后声明接收）
导入 容器::向量;
导入 映射集合::映射;
不安全 函数 主() -> 整32 {
    向量<映射<整64, 整64>> 层表 = 向量<映射<整64, 整64>>();
    映射<整64, 整64> 层 = 映射<整64, 整64>();
    结果<空类型, 整32> s1 = 层.设置(1, 10);
    如果 (!s1.正常) { 返回 1; }
    结果<空类型, 整32> s2 = 层表.追加(层);
    如果 (!s2.正常) { 返回 2; }
    映射<整64, 整64> 副本 = 层表.元素(0);
    结果<空类型, 整32> s4 = 副本.设置(7, 70);
    如果 (!s4.正常) { 返回 6; }
    结果<整64, 整32> g7 = 层表.元素(0).获取(7);
    如果 (g7.正常) { 返回 7; }
    打印("面①绿");
    返回 0;
}
