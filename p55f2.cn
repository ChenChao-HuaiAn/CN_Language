// 面②：元素可变方法写穿（790-a 域·不含追加/副本化）
导入 容器::向量;
导入 映射集合::映射;
不安全 函数 主() -> 整32 {
    向量<映射<整64, 整64>> 层表 = 向量<映射<整64, 整64>>();
    映射<整64, 整64> 层 = 映射<整64, 整64>();
    结果<空类型, 整32> s1 = 层.设置(1, 10);
    如果 (!s1.正常) { 返回 1; }
    结果<空类型, 整32> s2 = 层表.追加(层);
    如果 (!s2.正常) { 返回 2; }
    结果<空类型, 整32> s3 = 层表.元素(0).设置(2, 20);
    如果 (!s3.正常) { 返回 3; }
    结果<整64, 整32> g2 = 层表.元素(0).获取(2);
    如果 (g2.正常) {
        如果 (g2.值 != 20) { 返回 5; }
    } 否则 { 返回 4; }
    打印("面②绿");
    返回 0;
}
