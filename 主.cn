导入 容器::向量;
导入 内存;

结构体 盒子 {
    字符串 名;
    整32 号;
}

函数 主() -> 整32 {
    打印行(内存::活动分配数());
    向量<盒子> 表 = 向量<盒子>();
    打印行(内存::活动分配数());
    {
        盒子 甲 = 盒子{ 名 = 字符串复制("真串"), 号 = 1 };
        结果<空类型, 整32> 加 = 表.追加(甲);
        如果 (!加.正常) { 返回 0; }
    }
    打印行(内存::活动分配数());
    打印行(表.元素(0).名);
    返回 0;
}
